					ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктив.АналитикаРасходовОтКорректировки);
					
					ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", ПланыСчетов.Единый.ПроцентныеДоходы05);
					ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктив.АналитикаДоходовОтКорректировки);
				КонецЕсли;
					
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				ПараметрыНачисления.Удалить("ПроверитьПарныеДоходыРасходы");
				
				// разница п/п
				ПараметрыНачисления.Вставить("Сумма",				СтрокаЦенныеБумаги.СуммаПервоначальногоПризнания);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	СтрокаЦенныеБумаги.СуммаПервоначальногоПризнанияВВалютеУчета);
				
				ПараметрыНачисления.Вставить("Содержание",			"Разница первоначального признания");
				ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
				
				ПараметрыНачисления.Вставить("СчетУчета",			УчетныйАктив.СчетУчета);
				
				Если СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияСНачалаГода > 0 Тогда
					ПараметрыНачисления.Вставить("СчетДоходовРасходов", УчетныйАктив.СчетУчетаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктив.АналитикаДоходовПервоначальногоПризнания);
				Иначе
					ПараметрыНачисления.Вставить("СчетДоходовРасходов",	УчетныйАктив.СчетУчетаРасходовОтОпераций);
					ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктив.АналитикаРасходовПервоначальногоПризнания);
				КонецЕсли;
					
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
					
				// индексация номинала
				ПараметрыНачисления.Вставить("Сумма",				СтрокаЦенныеБумаги.СуммаИндексацииНоминала);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	СтрокаЦенныеБумаги.СуммаИндексацииНоминала);
				
				ПараметрыНачисления.Вставить("Содержание",			"Индексация номинала");
				ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала);
				
				Если БалансоваяПереоценкаВВалютеУчета > 0 Тогда
					ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктив.СчетУчетаПереоценкиА);
				Иначе
					ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктив.СчетУчетаПереоценкиП);
				КонецЕсли;
				
				Если СтрокаЦенныеБумаги.ПереоценкаСНачалаГода > 0 Тогда
					ПараметрыНачисления.Вставить("СчетДоходовРасходов", УчетныйАктив.СчетУчетаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктив.АналитикаДоходовОтОпераций);
				Иначе
					ПараметрыНачисления.Вставить("СчетДоходовРасходов",	УчетныйАктив.СчетУчетаРасходовОтОпераций);
					ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктив.АналитикаРасходовОтОпераций);
				КонецЕсли;
					
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
			Иначе
				
				Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					// **************************************** Начисляем НКД ****************************************
					Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона<>0 Тогда
						ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, Аналитика",
							СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета, СтрокаЦенныеБумаги.СуммаПереоценкиКупона, ВалютаУчета, УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, АналитикаКупонНачисленный);
						БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
					КонецЕсли;
					
					// **************************************** Списываем/начисляем премию/дисконт ****************************************
					Если СтрокаЦенныеБумаги.НачальныйДисконт < 0 Тогда // дисконт
						ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, Аналитика, Доход",
							СтрокаЦенныеБумаги.СуммаДисконтаВВалютеУчета, СтрокаЦенныеБумаги.СуммаДисконта, ВалютаУчета, УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, АналитикаДисконта, Истина);
						
						БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
					КонецЕсли;
						
					Если (СтрокаЦенныеБумаги.НачальныеДисконтПремия > 0) И (СтрокаЦенныеБумаги.СуммаПремии < 0) Тогда // премия И премию только списываем!!!
						ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, Аналитика, Доход",
							СтрокаЦенныеБумаги.СуммаПремииВВалютеУчета, СтрокаЦенныеБумаги.СуммаПремии, ВалютаУчета, УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, ПереоценкаПослеВводаНачальныхОстатков, АналитикаПремии, Ложь);
							
						БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
					КонецЕсли;
					
					// **************************************** Списываем/начисляем индексацию номинала ****************************************
					Если СтрокаЦенныеБумаги.СуммаИндексацииНоминала <> 0 Тогда
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка, ПереоценкаПослеВводаНачальныхОстатков",
							"ИндексацияНоминала", СтрокаЦенныеБумаги.СуммаИндексацииНоминала, СтрокаЦенныеБумаги.СуммаИндексацииНоминала, ВалютаУчета,  УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, Неопределено, ПереоценкаПослеВводаНачальныхОстатков);
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
					КонецЕсли;
					
					// **************************************** Списываем/начисляем корректировку по ЭСП ****************************************
					Если СтрокаЦенныеБумаги.СуммаКорректировкиЭСП <> 0
						И (НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке
							ИЛИ НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности
							ИЛИ СтрокаЦенныеБумаги.УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток) Тогда
					
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка, ПереоценкаПослеВводаНачальныхОстатков",
							"КорректировкаЭСП", СтрокаЦенныеБумаги.СуммаКорректировкиЭСП, СтрокаЦенныеБумаги.СуммаКорректировкиЭСПВВалютеУчета, ВалютаУчета,  УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, Неопределено, ПереоценкаПослеВводаНачальныхОстатков);
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
					КонецЕсли;
					
					// **************************************** Списываем/начисляем корректировку ПП ****************************************
					Если СтрокаЦенныеБумаги.СуммаПервоначальногоПризнания <> 0 Тогда
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка, ПереоценкаПослеВводаНачальныхОстатков",
							"РазницаПервоначальногоПризнания", СтрокаЦенныеБумаги.СуммаПервоначальногоПризнания, СтрокаЦенныеБумаги.СуммаПервоначальногоПризнанияВВалютеУчета, ВалютаУчета,  УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, Неопределено, ПереоценкаПослеВводаНачальныхОстатков);
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка, ПереоценкаПослеВводаНачальныхОстатков",
					"Переоценка", СтрокаЦенныеБумаги.СуммаПереоценки, СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета, ВалютаУчета,  УчетныйАктив, СтрокаЦенныеБумаги.ЦеннаяБумага, ВалютаНоминала, Неопределено, ПереоценкаПослеВводаНачальныхОстатков);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Движения.БухПартииЦенныхБумагКПолучению.Записывать Тогда
		Движения.БухПартииЦенныхБумагКПолучению.Записать();
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагКПолучению.УчетныйАктивЕПС
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКПолучению КАК БухПартииЦенныхБумагКПолучению
			|ГДЕ
			|	БухПартииЦенныхБумагКПолучению.Регистратор = &Регистратор
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумагКПолучению.УчетныйАктивЕПС";
		
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если МассивУчетныхАктивов.Найти(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС) = Неопределено Тогда
				МассивУчетныхАктивов.Добавить(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС);
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
	// если отражаются - не закрываем!
	Если НЕ НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Истина, Истина, Неопределено, Отказ);
		
		БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
		
	ИначеЕсли НастройкиУчетаОбщие.СворачиватьПарныеСчетаКорректировокПутемПереброски Тогда
		
		// #473904 - извраты от СНГ
		// СНГ настоял на своей схеме закрытия парных счетов корректировок ЭСП, причем они ведут учет партий на лицевых счетах
		// но они не смогли реализовать учет партий на лицевых счетах счетов 71005/71006
		// поэтому свертку 71005/71006 пришлось сделать отдельно тут
		
		СвернутьПарныеСчетаДоходовРасходовКорректировкиСНГ(ЭтотОбъект, МассивУчетныхАктивов, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры


#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда // блокирующие проверки
		
		// !!! почему так - см. в обработке проведения
		//Если Не РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + " у " + ЭтотОбъект.СчетДоверительногоУправления + " не ведется " + ЭтотОбъект.ВидУчета,,,, Отказ);
		//	Возврат;
		//КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ФормированиеБухгалтерскогоУчета") И НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("КонтрольЗаполнения") 	// это не ФБУ и Контроль заполнения
		И НЕ Документы.ПереоценкаЦенныхБумаг.РазрешенаИнтерактивнаяРаботаСДокументом(ЭтотОбъект) Тогда	// нельзя иначе как через ФБУ
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("С документом разрешено работать только через формирование учета",,,, Отказ);
		Возврат;	
	
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ФормированиеБухгалтерскогоУчета") Тогда
		// запишем в табличную часть данные, полученные по движениям
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЦенныеБумаги") Тогда
			// пришли сюда при отмене проведения из формы документа
		    ЭтотОбъект.ЦенныеБумаги.Загрузить(ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги);
		Иначе
			// сюда пришли не из формы документа и не из ФБУ
			ЦенныеБумагиБезРучнойКорректировки = ЭтотОбъект.ЦенныеБумаги.НайтиСтроки(Новый Структура("РучнаяКорректировка", Ложь));
			Если ЦенныеБумагиБезРучнойКорректировки.Количество() = 0 Тогда
				// получим данные по движениям
				ЭтотОбъект.ЦенныеБумаги.Загрузить(Документы.ПереоценкаЦенныхБумаг.ПолучитьТаблицуЦенныхБумагПоДвижениямДокумента(ЭтотОбъект));
			Иначе
				// ничего не делаем, данные в табличной части уже есть
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура РассчитатьИндексациюНоминалаБУНУ(СтрокаЦенныеБумаги)

	СтрокаПартии = СтрокаЦенныеБумаги.Партия.ЦенныеБумаги.Найти(СтрокаЦенныеБумаги.СтрокаПартии, "СтрокаПартии");
	
	Если ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		ДатаПокупки = СтрокаПартии.ДатаПокупки;
	Иначе
		ДатаПокупки = СтрокаЦенныеБумаги.Партия.Дата;
	КонецЕсли;
	
	ТекущийНоминал = Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ЭтотОбъект.Дата);
	ТекущаяНоминальнаяСтоимость = ТекущийНоминал * СтрокаЦенныеБумаги.Количество;
	
	НачальныйНоминал = Справочники.Облигации.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ДатаПокупки);
	НачальнаяНоминальнаяСтоимость = НачальныйНоминал * СтрокаЦенныеБумаги.Количество;
	
	
	СтрокаЦенныеБумаги.ИндексацияНоминала = ТекущаяНоминальнаяСтоимость - НачальнаяНоминальнаяСтоимость - СтрокаЦенныеБумаги.БалансоваяИндексацияНоминала;

КонецПроцедуры

Процедура ОчиститьДвиженияПоРегистру(ДвиженияРегистра)

	ДвиженияРегистра.Очистить();
	ДвиженияРегистра.Записать();	

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);

	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	СтрокиСРучнойКорректировкой = ЭтотОбъект.ЦенныеБумаги.НайтиСтроки(Новый Структура("РучнаяКорректировка", Истина));
	ЕстьСтрокиСРучнойКорректировкой = (СтрокиСРучнойКорректировкой.Количество() > 0);
	ЕстьЦенныеБумаги = ЭтотОбъект.ДополнительныеСвойства.Свойство("ЦенныеБумаги");
	
	ПерезаполнитьЦенныеБумаги = Истина;
	
	// эта секция Если отрабатывает при проведении не из ФБУ или формы документа
	Если Не ЕстьЦенныеБумаги И Не ЕстьСтрокиСРучнойКорректировкой Тогда
		// либо это старый документ еще до удаления ТЧ, либо это не проведенный документ
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЦенныеБумаги", ЭтотОбъект.ЦенныеБумаги.Выгрузить());
	ИначеЕсли Не ЕстьЦенныеБумаги Тогда 
		// это новый документ, 
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЦенныеБумаги", Документы.ПереоценкаЦенныхБумаг.ПолучитьТаблицуЦенныхБумагПоДвижениямДокумента(ЭтотОбъект));
		ПерезаполнитьЦенныеБумаги = Ложь;
	КонецЕсли; 
	
	ОчиститьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагКПолучению);
	ОчиститьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагКупленныеПоРЕПО);
	ОчиститьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагПроданныеВРепо);
	ОчиститьДвиженияПоРегистру(Движения[УчетныйРегистр]);
	ОчиститьДвиженияПоРегистру(Движения.СтоимостьПереоценки);
	ОчиститьДвиженияПоРегистру(Движения.БухПартииЦенныхБумаг);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// контроль партий
	РазрешенаИнтерактивнаяРаботаСДокументом = Документы.ПереоценкаЦенныхБумаг.РазрешенаИнтерактивнаяРаботаСДокументом(ЭтотОбъект);
	Если РазрешенаИнтерактивнаяРаботаСДокументом // контролируем тут, иначе в ФБУ
		И НЕ Документы.ПереоценкаЦенныхБумаг.СверитьДанныеПереоценкиСОстаткамиПартий(ЭтотОбъект, Запрос)
	Тогда 
	    Возврат;
	КонецЕсли;
	
	ЗаписыватьСтоимостьПереоценки = (ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет); // совершенно нет никакого смысла записывать стоимость переоценки для НУ
	
	// Присоединение Согласия к Нефтегаранту
	// Эта же хрень сделана в проведении ЕПС
	Если ЭтотОбъект.Дата = '2018-12-05 23:59:59' Тогда
	
		Если ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_NPF345" // НПФ НЕФТЕГАРАНТ АО (Согласие ОПС) - РЭМ
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN065" // НПФ НЕФТЕГАРАНТ АО ВР (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN064" // НПФ НЕФТЕГАРАНТ АО ПН  (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN067" // НПФ НЕФТЕГАРАНТ АО РОПС  (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU_RT_PN066" // НПФ НЕФТЕГАРАНТ АО СВ (Согласие-ОПС) - Траст
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.КодСчета = "DU-RPI/UL/66" // НПФ НЕФТЕГАРАНТ АО - РПИ
			Тогда
		
			ЗаписыватьСтоимостьПереоценки = Ложь;
		
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ПереоценкаПередПереводомАктивовВЭволюцию", ЭтотОбъект.Ссылка) = Истина Тогда
		ЗаписыватьСтоимостьПереоценки = Ложь;
	КонецЕсли;
	
	
	Если ЗаписыватьСтоимостьПереоценки Тогда
	
		Движения.СтоимостьПереоценки.Записывать = Истина;

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Дата КАК Период,
			|	&Организация КАК Организация,
			|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	&ВидУчета КАК ВидУчета,
			|	_ЦБ.Рынок КАК Рынок,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаПереоценки) КАК ВидЦеныОценки,
			|	&ЦельРасчета КАК ЦельРасчета,
			|	_ЦБ.Партия КАК Партия,
			|	_ЦБ.СтрокаПартии КАК СтрокаПартии,
			|	_ЦБ.ОценочнаяЦена КАК Цена,
			|	_ЦБ.ОценочнаяСумма КАК Сумма,
			|	_ЦБ.ОценочнаяСуммаВВалютеУчета КАК СуммаВВалютеУчета,
			|	_ЦБ.ОценочнаяЦенаКупона КАК ЦенаКупона,
			|	_ЦБ.ОценочнаяСуммаКупона КАК СуммаКупона,
			|	_ЦБ.ОценочнаяСуммаКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
			|	_ЦБ.Количество КАК Количество,
			|	_ЦБ.ПолеЦены КАК ВидЦены,
			|	_ЦБ.УровеньОценки КАК УровеньОценки,
			|	_ЦБ.ДатаКотировки КАК ДатаЦены,
			|	_ЦБ.ИсточникЦены КАК Источник,
			|	//_ЦБ.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ЛОЖЬ КАК РучнойВвод
			|ИЗ
			|	_ПереоценкаЦенныхБумагЦенныеБумаги КАК _ЦБ
			|
			|УПОРЯДОЧИТЬ ПО
			|	Рынок,
			|	ЦеннаяБумага,
			|	Партия,
			|	СтрокаПартии";
		
		Если НЕ РазрешенаИнтерактивнаяРаботаСДокументом Тогда // не делали контроль - нужно создать таблицу
			
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.Партия КАК Партия,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.Количество КАК Количество,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСумма КАК БалансоваяСумма,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСуммаКупона КАК БалансоваяСуммаКупона,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.Рынок КАК Рынок,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяИндексацияНоминала КАК БалансоваяИндексацияНоминала,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦена КАК ОценочнаяЦена,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСумма КАК ОценочнаяСумма,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаВВалютеУчета КАК ОценочнаяСуммаВВалютеУчета,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупона КАК ОценочнаяСуммаКупона,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета КАК ОценочнаяСуммаКупонаВВалютеУчета,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ПолеЦены КАК ПолеЦены,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.УровеньОценки КАК УровеньОценки,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ДатаКотировки КАК ДатаКотировки,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ДатаКотировкиКупона КАК ДатаКотировкиКупона,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.ИсточникЦены КАК ИсточникЦены,
				|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала
				|ПОМЕСТИТЬ _ПереоценкаЦенныхБумагЦенныеБумаги
				|ИЗ
				|	&ЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Рынок,
				|	УчетныйАктивЕПС,
				|	ЦеннаяБумага,
				|	Партия,
				|	СтрокаПартии
				|;
				|" + Запрос.Текст;
			
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
		Запрос.УстановитьПараметр("ЦельРасчета", БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета));
		
		Движения.СтоимостьПереоценки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	КонецЕсли;
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		
		ОбработкаПроведенияЕПС(Отказ, Режим);
		ЗаполнитьЦенныеБумагиПоДвижениям(ПерезаполнитьЦенныеБумаги, Отказ);
		Возврат;
		
	КонецЕсли;
	
	СведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр, , ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги);
	
	НастройкиУчетаПереоценки = БухгалтерскийУчет.ОпределитьНастройкиУчетаПереоценки(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	НастройкиУчетаИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкиУчетаИндексацииНоминала(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	ПереоцениватьПоПартиям = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		"ПереоцениватьПоПартиям");
		
	// На текущий момент нет настроек учета, которые бы позволили бы управлять формированием движений по партиям
	// и формированием проводок (для страховых партии нужны, а проводки нет). В результате пришлось извращаться:
	// движения по партиям формируются всегда; 
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	АналитикаДоходовОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета,
		"АналитикаДоходовОтПереоценки");		
		
	АналитикаПерекурсовки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ВидУчета, 
		"АналитикаПерекурсовки");
		
	СчетаУчета = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ВидУчета, 
		"СчетУчета");
		
	СчетаУчетаПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ВидУчета, 
		"СчетУчетаПереоценки");
		
	СводныеЦенныеБумаги = ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги.Скопировать();
	//фиксируем суммы на случай формирования одной проводки по нескольким партиям
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценки",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиКупона",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиВВалютеУчета",			Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыПереоценки",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыСтоимости",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиКупонаВВалютеУчета",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыПереоценкиКупона",Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыКупона",			Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("ИндексацияНоминала",					Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	СводныеЦенныеБумаги.Колонки.Добавить("ПроцентныйДоход",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	
	Для Каждого СтрокаЦенныеБумаги Из СводныеЦенныеБумаги Цикл
		
		ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага, Истина);
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
		
		УчитыватьПереоценкуОтдельно      = НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
		УчитыватьПереоценкуОтдельноКупон = НастройкиУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных];
		УчитыватьИндексациюОтдельно 	 = НастройкиУчетаИндексацииНоминала[УчетныйАктив.ИмяПредопределенныхДанных];
		
		
		ДелатьДвиженияПоРегиструБухПартииЦенныхБумаг = 
			СтрокаЦенныеБумаги.ОценочнаяСумма - СтрокаЦенныеБумаги.БалансоваяСумма <> 0
				Или СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона <> 0
				Или СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета <> 0
				Или СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета <> 0
				Или СтрокаЦенныеБумаги.ИндексироватьНоминал;
		
		Если ДелатьДвиженияПоРегиструБухПартииЦенныхБумаг Тогда
		
			СтрокаЦенныеБумаги.СуммаПереоценки = СтрокаЦенныеБумаги.ОценочнаяСумма - СтрокаЦенныеБумаги.БалансоваяСумма;
			Если СтрокаЦенныеБумаги.СуммаПереоценки = 0 Тогда
				БалансоваяСуммаПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета;
			Иначе
				БалансоваяСуммаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСумма, ВалютаНоминала, Организация, Дата, Отказ), 2);
			КонецЕсли;
			КурсоваяРазница = БалансоваяСуммаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
			СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета - КурсоваяРазница;
			Если НЕ УчитыватьПереоценкуОтдельно Тогда
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки = 0;
			Иначе
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.Переоценка, ВалютаНоминала, Организация, Дата, Отказ), 2)
				 - СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
			КонецЕсли;
			СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости = КурсоваяРазница - СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки;
			
			СтрокаЦенныеБумаги.СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			// реальная ситуация по бумаге "Минфин России, 24020RMFS, 1000.00 RUB" в 07.05.2020 - исполнение покупки НКД = 1.28, а в котировках за 07.05.2020 НКД = 1.27
			Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона < 0 Тогда
				СтрокаЦенныеБумаги.СуммаПереоценкиКупона = 0;
			КонецЕсли;
			
			Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
				БалансоваяСтоимостьКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
				Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона = 0 Тогда
					БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
				Иначе
					БалансоваяСуммаКупонаПоТекущемуКурсу = БалансоваяСтоимостьКупонаВВалютеУчета + Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
				Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для налогового учета купон учитывается вместе с переоценкой купона. Серьезно?",,,,);
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = 0;
				Иначе
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2)
					 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
				КонецЕсли;
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона;
				Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
					//купон при покупке погашен, все валим на переоценку купона
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона + СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона;
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;
			Иначе
				Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона = 0 Тогда
					БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
				Иначе
					БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
				Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = 0;
				Иначе
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2)
					 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
				КонецЕсли;
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона;
				Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
					//купон при покупке погашен, все валим на переоценку купона
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона = СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона + СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона;
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;
			КонецЕсли;
			
			//проверка 67-ФЗ
			// перекурсовку тела не проверяем. она всегда на 58-м счете. 
			ПроверяемыеРеквизиты = Новый Массив;
			ПроверяемыеРеквизиты.Добавить("СуммаКурсовойРазницыПереоценки");
			ПроверяемыеРеквизиты.Добавить("СуммаКурсовойРазницыКупона");
			ПроверяемыеРеквизиты.Добавить("СуммаКурсовойРазницыПереоценкиКупона");
			
			Для Каждого РеквизитДляПроверки из ПроверяемыеРеквизиты Цикл 
				СуммаКурсовойРазницы = СтрокаЦенныеБумаги[РеквизитДляПроверки];
				Если РеквизитДляПроверки = "СуммаКурсовойРазницыПереоценки" Тогда 
					СчетДляПроверки = СчетаУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
				ИначеЕсли РеквизитДляПроверки = "СуммаКурсовойРазницыКупона" Тогда
					СчетДляПроверки =  СчетаУчета[УчетныйАктивКупон.ИмяПредопределенныхДанных];
				ИначеЕсли РеквизитДляПроверки = "СуммаКурсовойРазницыПереоценкиКупона" Тогда
					СчетДляПроверки = СчетаУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных]; 
				КонецЕсли;	
				Если СуммаКурсовойРазницы <> 0 
					И БухгалтерскийУчет.КурсоваяРазницаПереоценкиУдовлетворяет67ФЗ(СуммаКурсовойРазницы, ЭтотОбъект.ВидУчета, СчетДляПроверки, ЭтотОбъект.Дата) Тогда		
					СтрокаЦенныеБумаги[РеквизитДляПроверки] = 0;
				КонецЕсли;						
			КонецЦикла;	
						
			СтрокаЦенныеБумаги.ИндексацияНоминала = 0;
			СтрокаЦенныеБумаги.ПроцентныйДоход = 0;
			Если СтрокаЦенныеБумаги.ИндексироватьНоминал И ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				
				Если ЦеннаяБумага.ИндексируемыйНоминал Тогда
					
					РассчитатьИндексациюНоминалаБУНУ(СтрокаЦенныеБумаги);
					
					УчетныйАктивСИндексациейНоминала = УчетныйАктив; //пока это только госы РФ
					
					Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
						
						ИндексацияВся = СтрокаЦенныеБумаги.БалансоваяИндексацияНоминала + СтрокаЦенныеБумаги.ИндексацияНоминала;
						
						СтрокаЦенныеБумаги.СуммаПереоценки = СтрокаЦенныеБумаги.СуммаПереоценки - ИндексацияВся;
						СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета = СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета - ИндексацияВся;
					
					КонецЕсли;

				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаЦенныеБумаги.СуммаПереоценки <>0 ИЛИ  СтрокаЦенныеБумаги.СуммаПереоценкиКупона <> 0 
				Тогда
				Движение = Движения.БухПартииЦенныхБумаг.Добавить();
				
				Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ЦеннаяБумага                 = ЦеннаяБумага;
				Движение.Партия                       = СтрокаЦенныеБумаги.Партия;
				Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
				Движение.Рынок                        = СтрокаЦенныеБумаги.Рынок;
				Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
				Движение.УчетныйАктивЕПС              = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
				
				Если СтрокаЦенныеБумаги.СуммаПереоценки <> 0 Тогда
					Если Не УчитыватьПереоценкуОтдельно Тогда
						Движение.Стоимость  				  = СтрокаЦенныеБумаги.СуммаПереоценки;
						Движение.СтоимостьВВалютеУчета		  = СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета;
						Движение.ПереоценкаВСтоимости 		  = СтрокаЦенныеБумаги.СуммаПереоценки;
					Иначе
						Движение.Переоценка 			= СтрокаЦенныеБумаги.СуммаПереоценки;
						Движение.ПереоценкаВВалютеУчета = СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета;
					КонецЕсли;
				КонецЕсли;
				
				Если СтрокаЦенныеБумаги.ОценочнаяЦена = 0 И Движение.Переоценка <> 0 Тогда	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ВНИМАНИЕ! Ценная бумага " + СтрокаЦенныеБумаги.ЦеннаяБумага + " (" + СтрокаЦенныеБумаги.Партия + "/" + СтрокаЦенныеБумаги.СтрокаПартии + ") переоценена в 0");	
				КонецЕсли;	
				
				Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					Если Не УчитыватьПереоценкуОтдельноКупон Тогда
						Движение.СтоимостьКупона  			 = СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
						Движение.СтоимостьКупонаВВалютеУчета = СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета;
						Движение.ПереоценкаКупонаВСтоимости  = СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
					Иначе
						Движение.ПереоценкаКупона 				= СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
						Движение.ПереоценкаКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			
			Если СтрокаЦенныеБумаги.Перекурсовать И (СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> 0 ИЛИ СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> 0 
				ИЛИ СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> 0 ИЛИ СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> 0) Тогда
				
				Движение = Движения.БухПартииЦенныхБумаг.Добавить();
				
				Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ЦеннаяБумага                 = ЦеннаяБумага;
				Движение.Партия                       = СтрокаЦенныеБумаги.Партия;
				Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
				Движение.Рынок                        = СтрокаЦенныеБумаги.Рынок;
				Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
				Движение.СтоимостьВВалютеУчета		  = СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости;
				Движение.ПереоценкаВВалютеУчета		  = СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки;
				Движение.СтоимостьКупонаВВалютеУчета  = СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона;
				Движение.ПереоценкаКупонаВВалютеУчета = СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона;
				
			КонецЕсли;
			
			Если ПереоцениватьПоПартиям И ВедетсяУчетПоТекущемуВиду Тогда //делаем проводку по каждой строке
				
				ОбращаетсяНаОРЦБ = СведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
				
				ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(СтрокаЦенныеБумаги.Рынок);
				
					
				Если СтрокаЦенныеБумаги.СуммаПереоценки <> 0 Тогда
					
					СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктив,
						ЭтотОбъект.ВидУчета);
						
					СчетУчетаПереоценки = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктив,
						ЭтотОбъект.ВидУчета);
						
					ВалютныйУчет = СчетУчета.Валютный;
					
					
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета, "Переоценка ценной бумаги");
					
					Если СтрокаЦенныеБумаги.СуммаПереоценки > 0 Тогда
					    // дебет
						Если Не УчитыватьПереоценкуОтдельно Тогда
							Проводка.СчетДт = СчетУчета;
						Иначе
							Проводка.СчетДт = СчетУчетаПереоценки;
						КонецЕсли;
						
						Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
						
						Если ВалютныйУчет Тогда
							Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.СуммаПереоценки;
							Проводка.ВалютаДт = ВалютаНоминала;
						КонецЕсли;
						
						// кредит
						Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
						Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктива];
						Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
						Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
						
					Иначе
						Проводка.Сумма = -Проводка.Сумма;
						
						// дебет
						Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктива];
						Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
						Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
						
						Если Не УчитыватьПереоценкуОтдельно Тогда
							Проводка.СчетКт = СчетУчета;
						Иначе
							Проводка.СчетКт = СчетУчетаПереоценки;
						КонецЕсли;
						
						Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
						
						Если ВалютныйУчет Тогда
							Проводка.ВалютнаяСуммаКт = - СтрокаЦенныеБумаги.СуммаПереоценки;
							Проводка.ВалютаКт = ВалютаНоминала;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
					И СтрокаЦенныеБумаги.СуммаПереоценкиКупона <> 0
				Тогда
				
					СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктивКупон,
						ЭтотОбъект.ВидУчета);
						
					СчетУчетаПереоценки = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктивКупон,
						ЭтотОбъект.ВидУчета);
						
					ВалютныйУчет = СчетУчета.Валютный;
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета, "Переоценка купона ценной бумаги");
					
					Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона > 0 Тогда
						// дебет
						Если Не УчитыватьПереоценкуОтдельноКупон Тогда
							Проводка.СчетДт = СчетУчета;
						Иначе
							Проводка.СчетДт = СчетУчетаПереоценки;
						КонецЕсли;
						
						Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
						
						Если ВалютныйУчет Тогда
							Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
							Проводка.ВалютаДт = ВалютаНоминала;
						КонецЕсли;
						
						// кредит
						Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
						Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктиваКупона];
						Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
						Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
						
					Иначе
						Проводка.Сумма = -Проводка.Сумма;
						
						// дебет
						Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктиваКупона];
						Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
						Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
						
						// кредит
						Если Не УчитыватьПереоценкуОтдельноКупон Тогда
							Проводка.СчетКт = СчетУчета;
						Иначе
							Проводка.СчетКт = СчетУчетаПереоценки;
						КонецЕсли;
						
						Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
						
						Если ВалютныйУчет Тогда
							Проводка.ВалютнаяСуммаКт = - СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
							Проводка.ВалютаКт = ВалютаНоминала;
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
				
				Если  СтрокаЦенныеБумаги.Перекурсовать
					И ((СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> Неопределено)
						ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> Неопределено)
						ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> Неопределено)
						ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> Неопределено)) Тогда
				
					ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
						+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
						ЦеннаяБумага, СтрокаЦенныеБумаги.Рынок,
						СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости, СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона, 
						СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки, СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона);
					БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	//проводки по индексации номинала
	
	СтрокиСводныхЦенныхБумаг = СводныеЦенныеБумаги.НайтиСтроки(Новый Структура("ИндексироватьНоминал", Истина));
	
	Если СтрокиСводныхЦенныхБумаг.Количество() > 0 Тогда
		
		УчитыватьИндексациюОтдельно = НастройкиУчетаИндексацииНоминала[УчетныйАктивСИндексациейНоминала.ИмяПредопределенныхДанных];
		
		СчетУчетаИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивСИндексациейНоминала,
			ЭтотОбъект.ВидУчета,
			"СчетУчетаИндексацииНоминалаЗаВремяВладения");
			
		Если СчетУчетаИндексацииНоминала.Валютный Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ВНИМАНИЕ! Начисление индексации номинала облигаций не реализовано для валютных бумаг! Обратитесь к программистам.", ,,,Отказ);	
		КонецЕсли;	
		
		АналитикаДоходовИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивСИндексациейНоминала,
			ЭтотОбъект.ВидУчета,
			"АналитикаДоходовИндексацииНоминала");
			
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ИндексироватьОблигации
			|ИЗ
			|	&ТаблицаЦБ КАК ТаблицаЦБ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НалоговыйУчетОстатки.Субконто1 КАК ЦеннаяБумага,
			|	НалоговыйУчетОстатки.СуммаОстаток КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
			|			&ДоДокумента,
			|			Счет = &Счет97,
			|			&ВидыСубконто,
			|			Субконто1 В
			|					(ВЫБРАТЬ
			|						_ИндексироватьОблигации.ЦеннаяБумага КАК ЦеннаяБумага
			|					ИЗ
			|						_ИндексироватьОблигации КАК _ИндексироватьОблигации)
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НалоговыйУчетОстатки";
		
		Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Счет97", 	 ПланыСчетов.Основной.РасходыБудущихПериодов);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
		ВидыСубконто = Новый Массив;
	    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы);
	    Запрос.УстановитьПараметр("ВидыСубконто", 	ВидыСубконто);	
	    Запрос.УстановитьПараметр("ТаблицаЦБ", 		СводныеЦенныеБумаги.Скопировать(СтрокиСводныхЦенныхБумаг, "ЦеннаяБумага"));	
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", УчетныйРегистр);
		
		ТаблицаНепринимаемойИндексацииНоминалов = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаЦенныеБумаги Из СтрокиСводныхЦенныхБумаг Цикл
			//тут сразу	формируем движения
			Если СтрокаЦенныеБумаги.ИндексацияНоминала <> 0 Тогда
				Движение = Движения.БухПартииЦенныхБумаг.Добавить();
				
				Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
				Движение.Партия                       = СтрокаЦенныеБумаги.Партия;
				Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
				Движение.Рынок                        = СтрокаЦенныеБумаги.Рынок;
				Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
				
				Движение.ИндексацияНоминалаЗаВремяВладения = СтрокаЦенныеБумаги.ИндексацияНоминала;

				Если ПереоцениватьПоПартиям Тогда	//делаем проводку по каждой строке
					
					АналитикаДоходовОтИндексацииНоминала = АналитикаДоходовИндексацииНоминала;
					СчетУчетаИндексацииНоминала = СчетУчетаИндексацииНоминала;
					
					ПараметрыИндексацииНоминала = Новый Структура("ЦеннаяБумага, ИндексацияНоминала, КупонныйДоход, ТаблицаНепринимаемойИндексацииНоминалов",
						СтрокаЦенныеБумаги.ЦеннаяБумага, 
						СтрокаЦенныеБумаги.ИндексацияНоминала,  
						СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона,
						ТаблицаНепринимаемойИндексацииНоминалов);
						
					БухгалтерскийУчет.ДвижениеИндексацииНоминала(ЭтотОбъект,
						ЭтотОбъект.Движения[УчетныйРегистр],
						ПараметрыИндексацииНоминала,
						АналитикаДоходовОтИндексацииНоминала,
						СчетУчетаИндексацииНоминала,
						ОбращаетсяНаОРЦБ,
						Отказ);
				
				КонецЕсли;	
			
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	

	Если Не ПереоцениватьПоПартиям И ВедетсяУчетПоТекущемуВиду Тогда
	
		СводныеЦенныеБумаги.Свернуть("Рынок, ЦеннаяБумага, Перекурсовать, ИндексироватьНоминал", "ОценочнаяСумма, БалансоваяСумма, ОценочнаяСуммаКупона, БалансоваяСуммаКупона,"
		+ " ОценочнаяСуммаВВалютеУчета, БалансоваяСуммаВВалютеУчета, ОценочнаяСуммаКупонаВВалютеУчета, БалансоваяСуммаКупонаВВалютеУчета,"
		+ " Переоценка, ПереоценкаВВалютеУчета, ПереоценкаКупона, ПереоценкаКупонаВВалютеУчета,"
		+ " СуммаПереоценки, СуммаПереоценкиВВалютеУчета, СуммаКурсовойРазницыПереоценки, СуммаКурсовойРазницыСтоимости,"
		+ " СуммаПереоценкиКупона, СуммаПереоценкиКупонаВВалютеУчета, СуммаКурсовойРазницыПереоценкиКупона, СуммаКурсовойРазницыКупона,"
		+ " ИндексацияНоминала");
		
		Для Каждого СтрокаЦенныеБумаги Из СводныеЦенныеБумаги Цикл
			
			ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
			ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
			ОбращаетсяНаОРЦБ = СведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
			
			УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага);
			УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага, Истина);
			ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
			ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
			
			УчитыватьПереоценкуОтдельно      = НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
			УчитыватьПереоценкуОтдельноКупон = НастройкиУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных];
			
			ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(СтрокаЦенныеБумаги.Рынок);
			
			Если СтрокаЦенныеБумаги.СуммаПереоценки <> 0 Тогда
				
				СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					УчетныйАктив,
					ЭтотОбъект.ВидУчета);
					
				СчетУчетаПереоценки = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					УчетныйАктив,
					ЭтотОбъект.ВидУчета);
					
				ВалютныйУчет = СчетУчета.Валютный;
				
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета, "Переоценка ценной бумаги");
				
				Если СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета > 0 Тогда
					// дебет
					Если Не УчитыватьПереоценкуОтдельно Тогда
						Проводка.СчетДт = СчетУчета;
					Иначе
						Проводка.СчетДт = СчетУчетаПереоценки;
					КонецЕсли;
					
					Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.СуммаПереоценки;
						Проводка.ВалютаДт = ВалютаНоминала;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктива];
					Проводка.СубконтоКт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
				Иначе
					Проводка.Сумма = -Проводка.Сумма;
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктива];
					Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
					// кредит
					Если Не УчитыватьПереоценкуОтдельно Тогда
						Проводка.СчетКт = СчетУчета;
					Иначе
						Проводка.СчетКт = СчетУчетаПереоценки;
					КонецЕсли;
					
					Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаКт = - СтрокаЦенныеБумаги.СуммаПереоценки;
						Проводка.ВалютаКт = ВалютаНоминала;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
				И СтрокаЦенныеБумаги.СуммаПереоценкиКупона <> 0
			Тогда
			
				СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					УчетныйАктивКупон,
					ЭтотОбъект.ВидУчета);
					
				СчетУчетаПереоценки = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					УчетныйАктивКупон,
					ЭтотОбъект.ВидУчета);
					
				ВалютныйУчет = СчетУчета.Валютный;
				
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета, "Переоценка купона ценной бумаги");
				
				Если СтрокаЦенныеБумаги.СуммаПереоценкиКупона > 0 Тогда
					// дебет
					Если Не УчитыватьПереоценкуОтдельноКупон Тогда
						Проводка.СчетДт = СчетУчета;
					Иначе
						Проводка.СчетДт = СчетУчетаПереоценки;
					КонецЕсли;
					
					Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
						Проводка.ВалютаДт = ВалютаНоминала;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктиваКупона];
					Проводка.СубконтоКт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
				Иначе
					Проводка.Сумма = -Проводка.Сумма;
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки[ИмяУчетногоАктиваКупона];
					Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
					// кредит
					Если Не УчитыватьПереоценкуОтдельноКупон Тогда
						Проводка.СчетКт = СчетУчета;
					Иначе
						Проводка.СчетКт = СчетУчетаПереоценки;
					КонецЕсли;
					
					Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаКт = - СтрокаЦенныеБумаги.СуммаПереоценкиКупона;
						Проводка.ВалютаКт = ВалютаНоминала;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			Если  СтрокаЦенныеБумаги.Перекурсовать
				И ((СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> Неопределено)
					ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> Неопределено)
					ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> Неопределено)
					ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> Неопределено)) Тогда
					
				ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
					+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
					ЦеннаяБумага, СтрокаЦенныеБумаги.Рынок,
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости, СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона, 
					СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки, СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона);
				БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			КонецЕсли;
			
			Если СтрокаЦенныеБумаги.ИндексироватьНоминал Тогда
				Если СтрокаЦенныеБумаги.ИндексацияНоминала <> 0 Тогда
				
					АналитикаДоходовОтИндексацииНоминала = АналитикаДоходовИндексацииНоминала;
					СчетУчетаИндексацииНоминала = СчетУчетаИндексацииНоминала;
					
					ПараметрыИндексацииНоминала = Новый Структура("ЦеннаяБумага, ИндексацияНоминала, КупонныйДоход, ТаблицаНепринимаемойИндексацииНоминалов",
						СтрокаЦенныеБумаги.ЦеннаяБумага, 
						СтрокаЦенныеБумаги.ИндексацияНоминала,  
						СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона,
						ТаблицаНепринимаемойИндексацииНоминалов);
						
					БухгалтерскийУчет.ДвижениеИндексацииНоминала(ЭтотОбъект,
						ЭтотОбъект.Движения[УчетныйРегистр],
						ПараметрыИндексацииНоминала,
						АналитикаДоходовОтИндексацииНоминала,
						СчетУчетаИндексацииНоминала,
						ОбращаетсяНаОРЦБ,
						Отказ);
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	СформироватьПроводкиПереоценкиПроданныеВРЕПО(ЭтотОбъект, Отказ);
	
	СформироватьПроводкиПереоценкиКупленныеПоРЕПО(ЭтотОбъект, Отказ);
	
	ЗаполнитьЦенныеБумагиПоДвижениям(ПерезаполнитьЦенныеБумаги, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ЗАПОЛНЕНИЕ

Процедура ЗаполнитьЦенныеБумагиКПолучению(Объект, МенеджерВременныхТаблиц = Неопределено, ИмяВремТаблицы = Неопределено, Отказ) 

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     Объект.ВидУчета);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКПолучениюОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКПолучениюОстатки
		|ГДЕ
		|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток = 0";
		
	Первый = Истина;
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Количество");
	
	Для каждого Ресурс Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумагКПолучению.Ресурсы Цикл
		
		Если МассивИсключений.Найти(Ресурс.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Первый Тогда
			ТекстЗапроса = ТекстЗапроса + " 
			|	И НЕ(";
			Первый = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|				И ";
		КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса + "БухПартииЦенныхБумагКПолучениюОстатки." + Ресурс.Имя + "Остаток = 0";
	
	КонецЦикла; 
		
	ТекстЗапроса = ТекстЗапроса + ")";
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение невозможно: по ценной бумаге " + Выборка.ЦеннаяБумага + " обнаружен нулевой остаток. Партия к получению: " + Выборка.Партия + ", строка: " + Выборка.СтрокаПартии, , , , Отказ);
	КонецЦикла; 
	
	Если Отказ Тогда
	    Возврат;
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКПолучениюОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Партия КАК Основание,
		|	БухПартииЦенныхБумагКПолучениюОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦена,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА НоминалыЦенныхБумагСрезПоследних.Номинал = 0
		|						ТОГДА 0
		|					ИНАЧЕ (БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток / НоминалыЦенныхБумагСрезПоследних.Номинал * 100
		|				КОНЕЦ
		|		ИНАЧЕ (БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦенаПроцент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаКупонаОстаток) / БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦенаКупона,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаОстаток КАК БалансоваяСумма,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьКупонаОстаток КАК БалансоваяСуммаКупона,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаОстаток КАК Переоценка,
		|	0 КАК БалансоваяИндексацияНоминала,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагКПолучениюОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимости,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаНаБалансеОстаток КАК ПереоценкаНаБалансе,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаНаБалансеВВалютеУчетаОстаток КАК ПереоценкаНаБалансеВВалютеУчета,
		|	0 КАК БалансовыеДисконтПремия,
		|	0 КАК БалансовыеДисконтПремияВВалютеУчета,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
		|	0 КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяКорректировкаЭСП,
		|	0 КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	0 КАК НачальныеДисконтПремия,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаВВалютеУчетаОстаток КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагКПолучениюОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
		|	0 КАК СуммаРезервовПодОбесценение
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
		|				И НЕ ВЫРАЗИТЬ(Партия КАК Документ.Сделка).РежимБиржевыхТоргов.ОсновнойРежим) КАК БухПартииЦенныхБумагКПолучениюОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";

	Если Объект.ПереоцениватьБумагиКПолучениюПоСделкамТПлюсЗаключеннымВОсновныхРежимахТоргов Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ ВЫРАЗИТЬ(Партия КАК Документ.Сделка).РежимБиржевыхТоргов.ОсновнойРежим", "");
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЗ", "ПОМЕСТИТЬ " + ИмяВремТаблицы + "  ИЗ  ");
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	КонецЕсли;
		
	РезультатЗапроса = Запрос.Выполнить();
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиКПолучениюЕПС(Объект, ПереоценкаПослеВводаНачальныхОстатков, НастройкиУчета, Отказ) 
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов, Истина);	
	ВыполнятьРасчетПоПисьмуЦБ0185316 = НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	
	
	МассивСчетовСНГ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ЭтотОбъект.Дата);
	ЭтоКлиентСНГ = (МассивСчетовСНГ.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	ЭтоКлиентГруппыБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	МассивСчетовВолга = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ЭтотОбъект.Дата);
	ЭтоКлиентВолга = (МассивСчетовВолга.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	ОтражатьПартииНаЛицевыхСчетах = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		"ОтражатьПартииНаЛицевыхСчетах");
	
	НеВыделятьПереоценкуДляБумагОжидаемыхКПолучениюПоСделкамТПлюс = БухгалтерскийУчет.ОпределитьНастройкуУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления,
								"НеВыделятьПереоценкуДляБумагОжидаемыхКПолучениюПоСделкамТПлюс");
		
								
	НастройкиБаланс = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивыЕПС.ЦенныеБумагиОжидаемыеКПолучениюПоСделкамТПлюс,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);

	НастройкиЗаБаланс = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивыЕПС.ЦенныеБумагиОжидаемыеКПолучениюПоСделкамТПлюсЗабалансовыеСчета,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		
	РасчетныеНастройкиУчета = БухгалтерскийУчет.ОпределитьРасчетныеНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
		
	ПериодичностиДатыПереоценки = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(ДатаПереоценки);
		
	// если периодичность заполнена
	ПереоцениватьБаланс = Истина;
	ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс = НастройкиБаланс.ПериодичностьПереоценки;
	Если ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка()
		И ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
	
		ПереоцениватьБаланс = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс, ДатаПереоценки, КалендарьДляСчетаДУ);
		
	КонецЕсли;
	
	ПереоцениватьКупон = Истина;
	ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс = НастройкиЗаБаланс.ПериодичностьНачисленияПроцентныхДоходов;
	Если ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка()
		И ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
	
		ПереоцениватьКупон = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс, ДатаПереоценки, КалендарьДляСчетаДУ);
		
	КонецЕсли;
	
	ПереоцениватьЗабаланс = Истина;
	ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюсГлаваГ = НастройкиЗаБаланс.ПериодичностьПереоценки;
	Если ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюсГлаваГ <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка()
		И ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюсГлаваГ <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		
		ПереоцениватьЗабаланс = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюсГлаваГ, ДатаПереоценки, КалендарьДляСчетаДУ);
		
	КонецЕсли;
	ПереоцениватьЗабалансВДеньОперации = НастройкиЗаБаланс.ПереоцениватьВДеньОперации;
	
	ДокументПереоценка = Новый Структура;
	
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Дата));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
    ДокументПереоценка.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
    ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
    ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета);
    ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", ЭтотОбъект.ВариантРасчетаОценочнойСтоимости);
    ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
    ДокументПереоценка.Вставить("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
    ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Ложь);
	ДокументПереоценка.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументПереоценка.СчетДоверительногоУправления, ДокументПереоценка.Дата));
	ДокументПереоценка.Вставить("РассчитыватьЦены", Ложь);
	ДокументПереоценка.Вставить("ОцениватьПоСправедливойСтоимости", Истина);
	ДокументПереоценка.Вставить("ПереоцениватьБумагиКПолучениюПоСделкамТПлюсЗаключеннымВОсновныхРежимахТоргов", РасчетныеНастройкиУчета.ПереоцениватьБумагиКПолучениюПоСделкамТПлюсЗаключеннымВОсновныхРежимахТоргов);
	
	Отказ = Ложь;
	
	МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	ЗаполнитьЦенныеБумагиКПолучению(ДокументПереоценка, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СообщенияОбОценочнойСтоимости = Неопределено;
	РаботаСПереоценкой.ЗаполнитьКотировки(ДокументПереоценка, МенеджерВременныхТаблиц, СообщенияОбОценочнойСтоимости, Отказ);
	
	Если ВыполнятьРасчетПоПисьмуЦБ0185316 И НЕ ЭтоКлиентСНГ Тогда // #424568 - СНГ не применяет послабленияд для бумаг по Т+
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
			|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.ДатаЦеныКупона КАК ДатаЦеныКупона,
			|	СтоимостьПереоценки.ВалютаКотировкиКупона КАК ВалютаКотировкиКупона,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &Период
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
			|	И СтоимостьПереоценки.ВидЦеныОценки = &ВидЦеныОценки
			|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
			|	И ТИПЗНАЧЕНИЯ(СтоимостьПереоценки.Партия) = ТИП(Документ.Сделка)
			|	И ВЫРАЗИТЬ(СтоимостьПереоценки.Партия КАК Документ.Сделка).ОтложенноеИсполнение";
		
		Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
		Запрос.УстановитьПараметр("ВидЦеныОценки", Перечисления.ВидыЦенОценки.ЦенаОценки);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		СтрокиКУдалению = Новый Массив;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтрокиПереоценки = ДокументПереоценка.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", 
																			ВыборкаДетальныеЗаписи.ЦеннаяБумага,
																			ВыборкаДетальныеЗаписи.Партия,
																			ВыборкаДетальныеЗаписи.СтрокаПартии));
																			
			Инд = 0;
			Для каждого СтрокаПереоценки Из СтрокиПереоценки Цикл
				
				Инд = Инд + 1; //РаботаСПереоценкой.ЗаполнитьКотировки размножает строки
				Если Инд > 1 Тогда
					СтрокиКУдалению.Добавить(СтрокаПереоценки);
					Продолжить;
				КонецЕсли;
				
				СтрокаПереоценки.ОценочнаяСумма = СтрокаПереоценки.Количество * ВыборкаДетальныеЗаписи.Цена;
				СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = СтрокаПереоценки.ОценочнаяСумма;
				СтрокаПереоценки.ОценочнаяСуммаКупона = СтрокаПереоценки.Количество * ВыборкаДетальныеЗаписи.ЦенаКупона;
				СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаПереоценки.ОценочнаяСуммаКупона;
				
				Если ВыборкаДетальныеЗаписи.ВалютаКотировки <> ЭтотОбъект.Организация.ВалютаУчета Тогда
				
					СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
						Новый Структура("ОценочнаяСуммаВВалютеУчета", СтрокаПереоценки.ОценочнаяСумма),
						ВыборкаДетальныеЗаписи.ВалютаКотировки,
						ЭтотОбъект.Организация,
						ВыборкаДетальныеЗаписи.ДатаЦены,
						?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КурсВалютыНоминала), ВыборкаДетальныеЗаписи.КурсВалютыНоминала, Неопределено),
						Отказ).ОценочнаяСуммаВВалютеУчета;
						
				КонецЕсли;
						
				Если ВыборкаДетальныеЗаписи.ВалютаКотировкиКупона <> ЭтотОбъект.Организация.ВалютаУчета Тогда
				
					СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
						Новый Структура("ОценочнаяСуммаКупонаВВалютеУчета", СтрокаПереоценки.ОценочнаяСуммаКупона),
						ВыборкаДетальныеЗаписи.ВалютаКотировкиКупона,
						ЭтотОбъект.Организация,
						ВыборкаДетальныеЗаписи.ДатаЦеныКупона,
						?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КурсВалютыНоминала), ВыборкаДетальныеЗаписи.КурсВалютыНоминала, Неопределено),
						Отказ).ОценочнаяСуммаКупонаВВалютеУчета;
				
				КонецЕсли;

			КонецЦикла;
																			
		КонецЦикла;
		
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ДокументПереоценка.ЦенныеБумаги.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	ИначеЕсли ЭтоКлиентСНГ Тогда // #424568 - СНГ не применяет послабленияд для бумаг по Т+ из-за этого возникает дубляж строк - РаботаСПереоценкой.ЗаполнитьКотировки размножает строки
		
		СтрокиКУдалению = Новый Массив;
		Партии = Новый Массив;
		
		Для Каждого СтрокаЦенныеБумаги Из ДокументПереоценка.ЦенныеБумаги Цикл
		
			Если Партии.Найти(СтрокаЦенныеБумаги.Партия) = Неопределено Тогда
				Партии.Добавить(СтрокаЦенныеБумаги.Партия);
			Иначе
				СтрокиКУдалению.Добавить(СтрокаЦенныеБумаги);
			КонецЕсли;	
		
		КонецЦикла;
		
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ДокументПереоценка.ЦенныеБумаги.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Объект.ПереоцениватьНаОснованииНастроекУчета И НЕ (ЭтоКлиентСНГ И ЭтотОбъект.Дата >= '20220301') Тогда // #432579 - СНГ с 1го марта по другому определяет когда переоценивать, код ниже
		РаботаСПереоценкой.ПрименитьПолитикуУчета(ДокументПереоценка, Ложь, СообщенияОбОценочнойСтоимости, Организация.ВалютаУчета, Отказ);
	КонецЕсли;
	
	КритерийСущественностиОтклоненияСС = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ДатаПереоценки, 
			Организация, 
			СчетДоверительногоУправления, 
			"КритерийСущественностиОтклоненияСС");

	Если ОтражатьПартииНаЛицевыхСчетах Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнениеОбязательствПоСделке.Ссылка КАК Исполнение,
			|	ИсполнениеОбязательствПоСделке.Основание КАК Сделка
			|ИЗ
			|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
			|ГДЕ
			|	ИсполнениеОбязательствПоСделке.Дата МЕЖДУ &ДатаСделки И &ДатаИсполнения
			|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
			|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ИсполнениеОбязательствПоСделке.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаСделки", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("ДатаИсполнения", КонецДня(ЭтотОбъект.Дата) + 86400 * 10); // через новогодние или "президентские" каникулы
		
		ТаблицаИсполнений = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;			
			
	Для Каждого СтрокаПартииКПолучению Из ДокументПереоценка.ЦенныеБумаги Цикл
				
		Если СтрокаПартииКПолучению.БалансоваяСумма = СтрокаПартииКПолучению.ОценочнаяСумма
			И СтрокаПартииКПолучению.БалансоваяСуммаКупона = СтрокаПартииКПолучению.ОценочнаяСуммаКупона Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		Если ЭтоКлиентСНГ И ЭтотОбъект.Дата >= '20220301'	// #432579 - СНГ переоценивает в день сделки или в последний день месяца 
			И НачалоДня(СтрокаПартииКПолучению.Партия.Дата) <> НачалоДня(ЭтотОбъект.Дата) И НЕ ПериодичностиДатыПереоценки.ПериодичностьМесяц Тогда 
			
			Продолжить;
		
		КонецЕсли;
		
		// #455622 - Будущее(и все фонды группы) прислал письмо о том, что по бумагам по АС не переоцениваем ничего: ни купон, ни тело
		// ограничение связано с периодом автоматической отправки в АС (см. модуль сделки #451103)
		Если ЭтоКлиентГруппыБудущее И СтрокаПартииКПолучению.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость	И ЭтотОбъект.Дата > '20221010' Тогда 
			
			Продолжить;
		
		КонецЕсли;
		
		Движение = Неопределено;
		
		Если ПереоцениватьЗабаланс 
			ИЛИ ПереоцениватьЗабалансВДеньОперации
				И НачалоДня(СтрокаПартииКПолучению.Партия.Дата) = НачалоДня(ЭтотОбъект.Дата) Тогда
		
			Сделка = СтрокаПартииКПолучению.Партия;
			Если Сделка.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				Контрагент 				= Сделка.Брокер.ЮрФизЛицо;
			Иначе
				Контрагент 				= Сделка.Контрагент;
			КонецЕсли;
			
			КонтрагентЯвляетсяРезидентом = Справочники.ЮрФизЛица.ЯвляетсяРезидентом(Контрагент, ЭтотОбъект.Организация);
			ВалютаНоминала = СтрокаПартииКПолучению.ЦеннаяБумага.ВалютаНоминала;
			
			Движение = Движения.БухПартииЦенныхБумагКПолучению.Добавить();
			
			Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ЦеннаяБумага                 = СтрокаПартииКПолучению.ЦеннаяБумага;
			Движение.УчетныйАктивЕПС			  = СтрокаПартииКПолучению.УчетныйАктивЕПС;
			Движение.Партия                       = СтрокаПартииКПолучению.Партия;
			Движение.СтрокаПартии                 = СтрокаПартииКПолучению.СтрокаПартии;
			Движение.Рынок                        = СтрокаПартииКПолучению.Рынок;
			Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
			
			ИзменениеТела				= СтрокаПартииКПолучению.ОценочнаяСумма - СтрокаПартииКПолучению.БалансоваяСумма + СтрокаПартииКПолучению.РасходыПриПокупкеВСтоимости;
			ИзменениеТелаВВалютеУчета	= СтрокаПартииКПолучению.ОценочнаяСуммаВВалютеУчета - СтрокаПартииКПолучению.БалансоваяСуммаВВалютеУчета + СтрокаПартииКПолучению.РасходыПриПокупкеВСтоимости;
			Если ПереоцениватьКупон Тогда
				ИзменениеКупона 			= СтрокаПартииКПолучению.ОценочнаяСуммаКупона - СтрокаПартииКПолучению.БалансоваяСуммаКупона;
				ИзменениеКупонаВВалютеУчета	= СтрокаПартииКПолучению.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКПолучению.БалансоваяСуммаКупонаВВалютеУчета;
			Иначе
				ИзменениеКупона 			= 0;
				ИзменениеКупонаВВалютеУчета	= 0;
			КонецЕсли;
			
			Если НеВыделятьПереоценкуДляБумагОжидаемыхКПолучениюПоСделкамТПлюс Тогда
				Движение.Стоимость 					  = ИзменениеТела;
				Движение.СтоимостьВВалютеУчета		  = ИзменениеТелаВВалютеУчета;
				Движение.СтоимостьКупона				= ИзменениеКупона;
				Движение.СтоимостьКупонаВВалютеУчета	= ИзменениеКупонаВВалютеУчета;
			Иначе
				Движение.Переоценка 				  = ИзменениеТела;
				Движение.ПереоценкаВВалютеУчета		  = ИзменениеТелаВВалютеУчета;
				Движение.ПереоценкаКупона				= ИзменениеКупона;
				Движение.ПереоценкаКупонаВВалютеУчета	= ИзменениеКупонаВВалютеУчета;
			КонецЕсли;
			
			Если НастройкиУчета.ВключатьКупонВСтоимостьПриПереоценкеБумагОжидаемыхПоСделкамТПлюс Тогда
				
				ИзменениеТела = ИзменениеТела + ИзменениеКупона;
				ИзменениеТелаВВалютеУчета = ИзменениеТелаВВалютеУчета + ИзменениеКупонаВВалютеУчета;
				
				ИзменениеКупона 			= 0;
				ИзменениеКупонаВВалютеУчета	= 0;
				
			КонецЕсли;
			
			Если ИзменениеТелаВВалютеУчета > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ИзменениеТелаВВалютеУчета, "Переоценка");
				
				// дебет
				Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ01, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ02);
				
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаПартииКПолучению.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = Движение.Партия;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ИзменениеТела;
				Проводка.КоличествоДт = 0;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
			ИначеЕсли ИзменениеТелаВВалютеУчета < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ИзменениеТелаВВалютеУчета, "Переоценка");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
				// кредит
				Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ01, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ02);
				
				Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПартииКПолучению.ЦеннаяБумага;
				Проводка.СубконтоКт.ОснованиеРасчетов = Движение.Партия;
				
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = - ИзменениеТела;
				Проводка.КоличествоКт = 0;
				
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;

			КонецЕсли;
			
			Если ИзменениеКупонаВВалютеУчета > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ИзменениеКупонаВВалютеУчета, "Переоценка купона");
				
				// дебет
				Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ01, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ02);
				
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаПартииКПолучению.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = Движение.Партия;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ИзменениеКупона;
				Проводка.КоличествоДт = 0;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
			ИначеЕсли ИзменениеКупонаВВалютеУчета < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ИзменениеКупонаВВалютеУчета, "Переоценка купона");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
				// кредит
				Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ01, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ02);
				
				Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПартииКПолучению.ЦеннаяБумага;
				Проводка.СубконтоКт.ОснованиеРасчетов = Движение.Партия;
				
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = - ИзменениеКупона;
				Проводка.КоличествоКт = 0;
				
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;

			КонецЕсли;
		
			
		КонецЕсли;
		
		
		Если ПереоцениватьБаланс Тогда
			
			Если ЭтотОбъект.Дата < '20220224' Тогда // по-старому проверяем оклонение цены покупки с учетом начисленной переоценки по балансу
				БалансоваяСуммаДляРасчетаОтклонения = СтрокаПартииКПолучению.БалансоваяСуммаВВалютеУчета - СтрокаПартииКПолучению.ПереоценкаНаБалансе + СтрокаПартииКПолучению.ПереоценкаНаБалансе;
			Иначе // по-новому проверяем оклонение цены покупки без учета чего бы то нибыло
				БалансоваяСуммаДляРасчетаОтклонения = СтрокаПартииКПолучению.БалансоваяСуммаВВалютеУчета - СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета;
			КонецЕсли;

			БалансоваяСуммаДляРасчетаНачисления				= СтрокаПартииКПолучению.БалансоваяСумма			 - СтрокаПартииКПолучению.ПереоценкаНаБалансе			  + СтрокаПартииКПолучению.ПереоценкаНаБалансе;
			БалансоваяСуммаДляРасчетаНачисленияВВалютеУчета = СтрокаПартииКПолучению.БалансоваяСуммаВВалютеУчета - СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета + СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета;
			
			ОтклонениеСС = СтрокаПартииКПолучению.ОценочнаяСуммаВВалютеУчета / БалансоваяСуммаДляРасчетаОтклонения;
			ОтклонениеСС = ?(ОтклонениеСС < 0, -1,1) * ОтклонениеСС;
			
			Если ЭтотОбъект.Дата >= '20220301' Тогда // С 1го марта 2022 года проверяем на строгое больше, до этого проверяли на больше или равно #419446
				ЕстьПревышениеКритерия = (МатематическиеФункции.МодульЧисла(ОтклонениеСС * 100 - 100) > КритерийСущественностиОтклоненияСС);
			Иначе
				ЕстьПревышениеКритерия = (МатематическиеФункции.МодульЧисла(ОтклонениеСС * 100 - 100) >= КритерийСущественностиОтклоненияСС);
			КонецЕсли;
			
			Если СтрокаПартииКПолучению.ПереоценкаНаБалансе <> 0 ИЛИ ЕстьПревышениеКритерия Тогда
				
				Если ЭтотОбъект.Дата < '20220224' ИЛИ ЕстьПревышениеКритерия Тогда // по-старому
					
					ПереоценкаДляБаланса			 = СтрокаПартииКПолучению.ОценочнаяСумма			 - БалансоваяСуммаДляРасчетаНачисления;
					ПереоценкаДляБалансаВВалютеУчета = СтрокаПартииКПолучению.ОценочнаяСуммаВВалютеУчета - БалансоваяСуммаДляРасчетаНачисленияВВалютеУчета;
					
				Иначе // или делаем обратную переоценку если ушло превышение критери
				
					ПереоценкаДляБаланса			 = - БалансоваяСуммаДляРасчетаНачисления;
					ПереоценкаДляБалансаВВалютеУчета = - БалансоваяСуммаДляРасчетаНачисленияВВалютеУчета;
				
				КонецЕсли;
				
				Если ПереоцениватьКупон И НастройкиУчета.ВключатьКупонВСтоимостьПриПереоценкеБумагОжидаемыхПоСделкамТПлюс Тогда
					ПереоценкаДляБаланса			 = ПереоценкаДляБаланса				+ СтрокаПартииКПолучению.ОценочнаяСуммаКупона			  - СтрокаПартииКПолучению.БалансоваяСуммаКупона;
					ПереоценкаДляБалансаВВалютеУчета = ПереоценкаДляБалансаВВалютеУчета + СтрокаПартииКПолучению.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКПолучению.БалансоваяСуммаКупонаВВалютеУчета;
				КонецЕсли;
				
				Движение.ПереоценкаНаБалансе					= ПереоценкаДляБаланса;
				Движение.ПереоценкаНаБалансеВВалютеУчета		= ПереоценкаДляБалансаВВалютеУчета;
				Движение.ПереоценкаСНачалаГода					= ПереоценкаДляБалансаВВалютеУчета;
				Если ПереоценкаДляБаланса > 0 Тогда
					Движение.ПереоценкаСНачалаГодаПоложительная = ПереоценкаДляБалансаВВалютеУчета;
				КонецЕсли;
				
				Если ОтражатьПартииНаЛицевыхСчетах Тогда
										
					СтрокиТаблицыИсполнений = ТаблицаИсполнений.НайтиСтроки(Новый Структура("Сделка",СтрокаПартииКПолучению.Партия));
					Если СтрокиТаблицыИсполнений.Количество() > 0 Тогда
						Исполнение = СтрокиТаблицыИсполнений[0].Исполнение;
					Иначе
						Исполнение = Неопределено;
					КонецЕсли;
					
					ПараметрыНачисления = Новый Структура;
					
					ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
					
					ПараметрыНачисления.Вставить("ЦеннаяБумага",	СтрокаПартииКПолучению.ЦеннаяБумага);
					ПараметрыНачисления.Вставить("ВалютаНоминала",	СтрокаПартииКПолучению.ЦеннаяБумага.ВалютаНоминала);
					ПараметрыНачисления.Вставить("Партия",			Исполнение);
					ПараметрыНачисления.Вставить("СтрокаПартии",	СтрокаПартииКПолучению.СтрокаПартии);
					ПараметрыНачисления.Вставить("Количество",		0);
					
					БалансоваяПереоценка = СтрокаПартииКПолучению.ПереоценкаНаБалансе;
					БалансоваяПереоценкаВВалютеУчета = СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета;
					
					ПараметрыНачисления.Вставить("Сумма",				ПереоценкаДляБаланса);
					ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ПереоценкаДляБалансаВВалютеУчета);
					ПараметрыНачисления.Вставить("СуммаСНачалаГода",	БалансоваяПереоценкаВВалютеУчета + ПереоценкаДляБалансаВВалютеУчета);
					ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
					ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
					
					ПараметрыНачисления.Вставить("Содержание",			"Переоценка");
					ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
					
					ПараметрыНачисления.Вставить("ПроверитьПарные",		"Переоценка");
					
					Если (БалансоваяПереоценкаВВалютеУчета > 0) ИЛИ (БалансоваяПереоценкаВВалютеУчета = 0 И ПереоценкаДляБаланса > 0) Тогда
						ПараметрыНачисления.Вставить("СчетУчета",		СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
						ПараметрыНачисления.Вставить("СчетУчетаПарный",	СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
					Иначе
						ПараметрыНачисления.Вставить("СчетУчета",		СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
						ПараметрыНачисления.Вставить("СчетУчетаПарный",	СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
					КонецЕсли;
					
					Если (БалансоваяПереоценка + ПереоценкаДляБаланса > 0)ИЛИ(БалансоваяПереоценка + ПереоценкаДляБаланса = 0 И ПереоценкаДляБаланса > 0) Тогда
						ПараметрыНачисления.Вставить("СчетДоходовРасходов", СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций);
						ПараметрыНачисления.Вставить("ГФУ",				СтрокаПартииКПолучению.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки);
						
						ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций);
						ПараметрыНачисления.Вставить("ГФУПарный",		СтрокаПартииКПолучению.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки);
					Иначе
						ПараметрыНачисления.Вставить("СчетДоходовРасходов",	СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций);
						ПараметрыНачисления.Вставить("ГФУ",				СтрокаПартииКПолучению.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки);
						
						ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", СтрокаПартииКПолучению.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций);
						ПараметрыНачисления.Вставить("ГФУПарный",		СтрокаПартииКПолучению.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки);
					КонецЕсли;
						
					БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
					
				Иначе
					
					Если ПереоценкаДляБаланса <> 0 Тогда // это переоценка
						
						ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка, ПереоценкаПослеВводаНачальныхОстатков",
							"Переоценка", ПереоценкаДляБаланса, ПереоценкаДляБалансаВВалютеУчета, ЭтотОбъект.Организация.ВалютаУчета,  СтрокаПартииКПолучению.УчетныйАктивЕПС, СтрокаПартииКПолучению.ЦеннаяБумага, ВалютаНоминала, Неопределено, ПереоценкаПослеВводаНачальныхОстатков);
						
						БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
						
					Иначе // это перекурсовка
						
						ПереоценкаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииКПолучению.ПереоценкаНаБалансе, ВалютаНоминала, ЭтотОбъект.Организация, ДатаПереоценки, Отказ), 2);
						
						ПерекурсовкаПереоценкиНаБалансе = ПереоценкаВВалютеУчета - СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета;
						
						Движение.ПереоценкаНаБалансеВВалютеУчета = ПерекурсовкаПереоценкиНаБалансе;
						Движение.ПереоценкаСНачалаГода			 = ПерекурсовкаПереоценкиНаБалансе;
						
						ПараметрыПерекурсовки = Новый Структура;
						
						ПараметрыПерекурсовки.Вставить("ЦеннаяБумага",														СтрокаПартииКПолучению.ЦеннаяБумага);
						ПараметрыПерекурсовки.Вставить("УчетныйАктивЕПС",													СтрокаПартииКПолучению.УчетныйАктивЕПС);
						
						ПараметрыПерекурсовки.Вставить("СтоимостьВВалютеУчета",												0);
						ПараметрыПерекурсовки.Вставить("СтоимостьКупонаВВалютеУчета",										0);
						ПараметрыПерекурсовки.Вставить("ПереоценкаВВалютеУчета",											ПерекурсовкаПереоценкиНаБалансе);
						ПараметрыПерекурсовки.Вставить("ПереоценкаКупонаВВалютеУчета",										0);
						ПараметрыПерекурсовки.Вставить("ДисконтПремияНачисленныйВВалютеУчета",								0);
						ПараметрыПерекурсовки.Вставить("КорректировкаЭСПВВалютеУчета",										0);
						ПараметрыПерекурсовки.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета",	0);
						
						ПараметрыПерекурсовки.Вставить("ДисконтПремияНачисленныйОстаток",									0);
						ПараметрыПерекурсовки.Вставить("ПереоценкаОстаток",													СтрокаПартииКПолучению.ПереоценкаНаБалансе);
						ПараметрыПерекурсовки.Вставить("КорректировкаЭСПОстаток",											0);
						ПараметрыПерекурсовки.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",			0);
						
						ПараметрыПерекурсовки.Вставить("ДисконтНачисленныйВВалютеУчета",									0);
						ПараметрыПерекурсовки.Вставить("ПремияНачисленнаяВВалютеУчета",										0);
						ПараметрыПерекурсовки.Вставить("ПереоценкаПоФиксированномуКурсу",									Ложь);
						
						БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);

						Если ЭтоКлиентВолга Тогда // особая схема
							
							КоэффициентКурсаВалюты = РаботаСВалютами.ПолучитьКоэффициентКурсаВалюты(ВалютаНоминала, ДатаПереоценки, Отказ);
							
							СтоимостьПоТекущемуКурсу = Окр(СтрокаПартииКПолучению.СтоимостьВВалютеУчета / КоэффициентКурсаВалюты, 2);
							
							ПереоценкаДляБаланса			 = СтрокаПартииКПолучению.ОценочнаяСумма			 - СтоимостьПоТекущемуКурсу;
							ПереоценкаДляБалансаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Окр(ПереоценкаДляБаланса, 2), ВалютаНоминала, ЭтотОбъект.Организация, ДатаПереоценки, Отказ), 2);
							//ПереоценкаДляБалансаВВалютеУчета = СтрокаПартииКПолучению.ОценочнаяСуммаВВалютеУчета - СтрокаПартииКПолучению.СтоимостьВВалютеУчета;
							
							ПереоценкаДляБаланса			 = ПереоценкаДляБаланса				- СтрокаПартииКПолучению.ПереоценкаНаБалансе;
							ПереоценкаДляБалансаВВалютеУчета = ПереоценкаДляБалансаВВалютеУчета - СтрокаПартииКПолучению.ПереоценкаНаБалансеВВалютеУчета - ПерекурсовкаПереоценкиНаБалансе;
							
							Если ПереоценкаДляБаланса <> 0 Тогда

								ПараметрыСписания = Новый Структура();
								ПараметрыСписания.Вставить("Показатель", "Переоценка");
								ПараметрыСписания.Вставить("СуммаВал", ПереоценкаДляБаланса);
								ПараметрыСписания.Вставить("СуммаУчета", ПереоценкаДляБалансаВВалютеУчета);
								ПараметрыСписания.Вставить("ВалютаУчета", ЭтотОбъект.Организация.ВалютаУчета);
								ПараметрыСписания.Вставить("УчетныйАктив", СтрокаПартииКПолучению.УчетныйАктивЕПС);
								ПараметрыСписания.Вставить("ЦеннаяБумага", СтрокаПартииКПолучению.ЦеннаяБумага);
								ПараметрыСписания.Вставить("ВалютаНоминала", ВалютаНоминала);
								ПараметрыСписания.Вставить("Сделка", Неопределено);
								ПараметрыСписания.Вставить("ПереоценкаПослеВводаНачальныхОстатков", ПереоценкаПослеВводаНачальныхОстатков);
								
								БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
								
								Движение.ПереоценкаНаБалансе			 = ПереоценкаДляБаланса;
								Движение.ПереоценкаНаБалансеВВалютеУчета = ПереоценкаДляБалансаВВалютеУчета + ПерекурсовкаПереоценкиНаБалансе;
								Движение.ПереоценкаСНачалаГода			 = ПереоценкаДляБалансаВВалютеУчета + ПерекурсовкаПереоценкиНаБалансе;
								
							КонецЕсли;
							
						КонецЕсли;						
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЦенныеБумагиКупленныеПоРЕПО(Объект, МенеджерВременныхТаблиц = Неопределено, ИмяВремТаблицы = Неопределено, Отказ) 

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     Объект.ВидУчета);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|ГДЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток = 0";
		
	Первый = Истина;
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Количество");
	
	Для каждого Ресурс Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Ресурсы Цикл
		
		Если МассивИсключений.Найти(Ресурс.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Первый Тогда
			ТекстЗапроса = ТекстЗапроса + " 
			|	И НЕ(";
			Первый = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|				И ";
		КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса + "БухПартииЦенныхБумагКупленныеПоРЕПООстатки." + Ресурс.Имя + "Остаток = 0";
	
	КонецЦикла; 
		
	ТекстЗапроса = ТекстЗапроса + ")";
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение невозможно: по ценной бумаге " + Выборка.ЦеннаяБумага + " обнаружен нулевой остаток. Партия обратного РЕПО: " + Выборка.Партия + ", строка: " + Выборка.СтрокаПартии, , , , Отказ);
	КонецЦикла; 
	
	Если Отказ Тогда
	    Возврат;
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО) КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Неопределено КАК ТипЗадолженности,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Основание,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦена,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА НоминалыЦенныхБумагСрезПоследних.Номинал = 0
		|						ТОГДА 0
		|					ИНАЧЕ (БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток / НоминалыЦенныхБумагСрезПоследних.Номинал * 100
		|				КОНЕЦ
		|		ИНАЧЕ (БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦенаПроцент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаКупонаОстаток) / БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦенаКупона,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаОстаток КАК БалансоваяСумма,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаОстаток КАК БалансоваяСуммаКупона,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	0 КАК БалансоваяИндексацияНоминала,
		|	0 КАК РасходыПриПокупкеВСтоимости,
		|	0 КАК ПереоценкаНаБалансе,
		|	0 КАК ПереоценкаНаБалансеВВалютеУчета,
		|	0 КАК БалансовыеДисконтПремия,
		|	0 КАК БалансовыеДисконтПремияВВалютеУчета,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
		|	0 КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяКорректировкаЭСП,
		|	0 КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	0 КАК НачальныеДисконтПремия,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаВВалютеУчетаОстаток КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
		|	0 КАК СуммаРезервовПодОбесценение";
		Если МенеджерВременныхТаблиц <> Неопределено Тогда
			Запрос.Текст =Запрос.Текст + "
			|	ПОМЕСТИТЬ "+ИмяВремТаблицы;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст +"
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";

		
		
	РезультатЗапроса = Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПроводкаПоГлавеГ(Сумма, СуммаВВалютеУчета, Аналитика, ЦеннаяБумага, Партия, ВалютаНоминала, Описание)

	Если СуммаВВалютеУчета > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаВВалютеУчета, Описание);
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
		Проводка.ДополнительнаяАналитикаДт = Аналитика;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
		
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		Проводка.СубконтоКт.ОснованиеРасчетов = Партия;
		
		Проводка.ВалютаКт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = Сумма;
			
		Проводка.ДополнительнаяАналитикаКт = Аналитика;
		
	ИначеЕсли СуммаВВалютеУчета < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, - СуммаВВалютеУчета, Описание);
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
		
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов = Партия;
		
		Проводка.ВалютаДт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = - Сумма;
		
		Проводка.ДополнительнаяАналитикаДт = Аналитика;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
		Проводка.ДополнительнаяАналитикаКт = Аналитика;
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиКупленныеПоРЕПОЕПС(Объект, ПереоценкаПослеВводаНачальныхОстатков, ДанныеКурсовЗаЭтотИПредыдущийДень, Отказ) 
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов, Истина);	
	ВыполнятьРасчетПоПисьмуЦБ0185316 = НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	
	
	МассивСчетовСНГ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ЭтотОбъект.Дата);
	ЭтоКлиентСНГ = (МассивСчетовСНГ.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	ЭтоКлиентГруппыБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	ВалютаУчетаОрганизации = ЭтотОбъект.Организация.ВалютаУчета;
	
	//Дата 25.06.24 для хардкода определяется по Задаче #542080, комментарий Дудовой Анны от 01.07.24 в 11:23
	//если большинство с 25.06, то давай дату поставим 25.06.
	ДатаНачалаРасчетовПоПерекурсовкиРЕПО = '20240625'; 
	
	
	НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ = БухгалтерскийУчет.ОпределитьНастройкуУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления,
								"НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ");
								
	АналитикаУНКД = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаННКД = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаСтоимость = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценка = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	
	Если НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ Тогда
		АналитикаТело	= АналитикаСтоимость;
		АналитикаКупон	= АналитикаУНКД;
	Иначе
		АналитикаТело 	= АналитикаПереоценка;
		АналитикаКупон	= АналитикаННКД;
	КонецЕсли;								
								
								
	ДокументПереоценка = Новый Структура;
	
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Дата));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
    ДокументПереоценка.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
    ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
    ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета);
    ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", ЭтотОбъект.ВариантРасчетаОценочнойСтоимости);
    ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
    ДокументПереоценка.Вставить("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
    ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Ложь);
	ДокументПереоценка.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументПереоценка.СчетДоверительногоУправления, ДокументПереоценка.Дата));
	ДокументПереоценка.Вставить("РассчитыватьЦены", Ложь);
	
	Отказ = Ложь;
	
	МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	ЗаполнитьЦенныеБумагиКупленныеПоРЕПО(ДокументПереоценка, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	СообщенияОбОценочнойСтоимости = Неопределено;
	РаботаСПереоценкой.ЗаполнитьКотировки(ДокументПереоценка, МенеджерВременныхТаблиц, СообщенияОбОценочнойСтоимости, Отказ);
	
	Если ВыполнятьРасчетПоПисьмуЦБ0185316 И НЕ ЭтоКлиентСНГ Тогда // #424568 - СНГ не применяет послабленияд для бумаг по РЕПО
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
			|	СтоимостьПереоценки.ВалютаКотировки КАК ВалютаКотировки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.ДатаЦеныКупона КАК ДатаЦеныКупона,
			|	СтоимостьПереоценки.ВалютаКотировкиКупона КАК ВалютаКотировкиКупона,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.Рынок КАК Рынок
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Период = &Период
			|	И СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
			|	И СтоимостьПереоценки.ВидЦеныОценки = &ВидЦеныОценки
			|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
			|	И ТИПЗНАЧЕНИЯ(СтоимостьПереоценки.Партия) = ТИП(Документ.СделкаРЕПО)";
		
		Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
		Запрос.УстановитьПараметр("ВидЦеныОценки", Перечисления.ВидыЦенОценки.ЦенаОценки);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		СтрокиКУдалению = Новый Массив;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтрокиПереоценки = ДокументПереоценка.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", 
																			ВыборкаДетальныеЗаписи.ЦеннаяБумага,
																			ВыборкаДетальныеЗаписи.Партия,
																			ВыборкаДетальныеЗаписи.СтрокаПартии));
																			
			Инд = 0;
			Для каждого СтрокаПереоценки Из СтрокиПереоценки Цикл
				
				Инд = Инд + 1; //РаботаСПереоценкой.ЗаполнитьКотировки размножает строки
				Если Инд > 1 Тогда
					СтрокиКУдалению.Добавить(СтрокаПереоценки);
					Продолжить;
				КонецЕсли;
				
				// к сожалению в сделке зачастую цена неточная, поэтому вылезают копейки - борюсь с ними
				Если ВыборкаДетальныеЗаписи.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ЦенаПриобретения Тогда 
					
					СтрокаПереоценки.ОценочнаяСумма = СтрокаПереоценки.БалансоваяСумма - СтрокаПереоценки.Переоценка;
					СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = СтрокаПереоценки.БалансоваяСуммаВВалютеУчета - СтрокаПереоценки.ПереоценкаВВалютеУчета;
					
				Иначе
					
					СтрокаПереоценки.ОценочнаяСумма = СтрокаПереоценки.Количество * ВыборкаДетальныеЗаписи.Цена;
					СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = СтрокаПереоценки.ОценочнаяСумма;
					
					Если ВыборкаДетальныеЗаписи.ВалютаКотировки <> ВалютаУчетаОрганизации Тогда
					
						СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
							Новый Структура("ОценочнаяСуммаВВалютеУчета", СтрокаПереоценки.ОценочнаяСумма),
							ВыборкаДетальныеЗаписи.ВалютаКотировки,
							ЭтотОбъект.Организация,
							ВыборкаДетальныеЗаписи.ДатаЦены,
							?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КурсВалютыНоминала), ВыборкаДетальныеЗаписи.КурсВалютыНоминала, Неопределено),
							Отказ).ОценочнаяСуммаВВалютеУчета;
							
					КонецЕсли;
					
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
					
					СтрокаПереоценки.ОценочнаяСуммаКупона = СтрокаПереоценки.Количество * ВыборкаДетальныеЗаписи.ЦенаКупона;
					СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаПереоценки.ОценочнаяСуммаКупона;
					
							
					Если ВыборкаДетальныеЗаписи.ВалютаКотировкиКупона <> ВалютаУчетаОрганизации Тогда
					
						СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
							Новый Структура("ОценочнаяСуммаКупонаВВалютеУчета", СтрокаПереоценки.ОценочнаяСуммаКупона),
							ВыборкаДетальныеЗаписи.ВалютаКотировкиКупона,
							ЭтотОбъект.Организация,
							ВыборкаДетальныеЗаписи.ДатаЦеныКупона,
							?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КурсВалютыНоминала), ВыборкаДетальныеЗаписи.КурсВалютыНоминала, Неопределено),
							Отказ).ОценочнаяСуммаКупонаВВалютеУчета;
					
					КонецЕсли;
					
				КонецЕсли;

			КонецЦикла;
																			
		КонецЦикла;
		
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ДокументПереоценка.ЦенныеБумаги.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	ИначеЕсли ЭтоКлиентСНГ Тогда // #424568 - СНГ не применяет послабленияд для бумаг по РЕПО из-за этого возникает дубляж строк - РаботаСПереоценкой.ЗаполнитьКотировки размножает строки
		
		СтрокиКУдалению = Новый Массив;
		Партии = Новый Массив;
		
		Для Каждого СтрокаЦенныеБумаги Из ДокументПереоценка.ЦенныеБумаги Цикл
		
			Если Партии.Найти(СтрокаЦенныеБумаги.Партия) = Неопределено Тогда
				Партии.Добавить(СтрокаЦенныеБумаги.Партия);
			Иначе
				СтрокиКУдалению.Добавить(СтрокаЦенныеБумаги);
			КонецЕсли;	
		
		КонецЦикла;
		
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ДокументПереоценка.ЦенныеБумаги.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	КонецЕсли;

	// т.к. КСУ переоцениваются исключительно тут и более нигде (по ним только РЕПО и бывает)
	// и т.к. они всегда и в любой методике переоцениваются по номиналу
	// то я сделал самое простое - воткнул их оценку сюда
	СтрокиПереоценки = ДокументПереоценка.ЦенныеБумаги.НайтиСтроки(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия));
	Для каждого СтрокаПереоценки Из СтрокиПереоценки Цикл
		
		СтрокаПереоценки.ВалютаКотировки = ВалютаУчетаОрганизации;
		СтрокаПереоценки.ОценочнаяСумма = СтрокаПереоценки.Количество;
		СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = СтрокаПереоценки.Количество;
	
	КонецЦикла;
	
	Если Объект.ПереоцениватьНаОснованииНастроекУчета Тогда
		РаботаСПереоценкой.ПрименитьПолитикуУчета(ДокументПереоценка, Ложь, СообщенияОбОценочнойСтоимости, ВалютаУчетаОрганизации, Отказ);
	КонецЕсли;
	
	Для Каждого СтрокаПартииКупленныеПоРЕПО Из ДокументПереоценка.ЦенныеБумаги Цикл
		
		Если СтрокаПартииКупленныеПоРЕПО.БалансоваяСумма = СтрокаПартииКупленныеПоРЕПО.ОценочнаяСумма
			И СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаВВалютеУчета
			И (СтрокаПартииКупленныеПоРЕПО.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации
				ИЛИ СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупона = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупона
					И СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупонаВВалютеУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		// #379057 - пока затыка, чтобы не делалась переоценка репо по АС, потом вообще закачку АС отключу
		// #ТехДолг
		Если СтрокаПартииКупленныеПоРЕПО.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость Тогда
			Продолжить;
		КонецЕсли;
		
		Сделка = СтрокаПартииКупленныеПоРЕПО.Партия;
		Если Сделка.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			Контрагент 				= Сделка.Брокер.ЮрФизЛицо;
		Иначе
			Контрагент 				= Сделка.Контрагент;
		КонецЕсли;
		
		Движение = Движения.БухПартииЦенныхБумагКупленныеПоРЕПО.Добавить();
		ВалютаНоминала = СтрокаПартииКупленныеПоРЕПО.ЦеннаяБумага.ВалютаНоминала;
		
		Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ЦеннаяБумага                 = СтрокаПартииКупленныеПоРЕПО.ЦеннаяБумага;
		Движение.Партия                       = СтрокаПартииКупленныеПоРЕПО.Партия;
		Движение.СтрокаПартии                 = СтрокаПартииКупленныеПоРЕПО.СтрокаПартии;
		Движение.Рынок                        = СтрокаПартииКупленныеПоРЕПО.Рынок;
		Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
		
		Если СтрокаПартииКупленныеПоРЕПО.ВалютаКотировки <> ВалютаУчетаОрганизации Тогда // пересчитаем оценочную сумму т.к. цена в валюте может быть очень нецелая, а РСП округляет
			
			СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.ОценочнаяЦена * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс * СтрокаПартииКупленныеПоРЕПО.Количество;
			СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.ОценочнаяЦенаКупона * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс * СтрокаПартииКупленныеПоРЕПО.Количество;
			
		КонецЕсли;
		
		ИзменениеТела				= СтрокаПартииКупленныеПоРЕПО.ОценочнаяСумма - СтрокаПартииКупленныеПоРЕПО.БалансоваяСумма;
		ИзменениеТелаВВалютеУчета	= СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаВВалютеУчета; 
		ИзменениеКупона				= СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупона - СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупона;
		ИзменениеКупонаВВалютеУчета	= СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупонаВВалютеУчета; 
		
		Перекурсовать = Истина;
		
		ПерекурсовкаТела = 0;
		ПерекурсовкаПереоценки = 0;
		
		ПерекурсовкаУНКД = 0;
		ПерекурсовкаННКД = 0;
		
		Если НеВыделятьПереоценкуДляБумагПоРЕПОГлаваГ Тогда
			Движение.Стоимость 						= ИзменениеТела;
			Движение.СтоимостьВВалютеУчета			= ИзменениеТелаВВалютеУчета;
			Движение.СтоимостьКупона				= ИзменениеКупона;
			Движение.СтоимостьКупонаВВалютеУчета	= ИзменениеКупонаВВалютеУчета;
		Иначе
			
			Если СтрокаПартииКупленныеПоРЕПО.ВалютаНоминала <> ВалютаУчетаОрганизации Тогда // для валютных бумаг есть перекурсовка, а есть переоценка и это разные вещи!!!
				
				СтрокаДанныеВалюты = ДанныеКурсовЗаЭтотИПредыдущийДень.Найти(СтрокаПартииКупленныеПоРЕПО.ВалютаНоминала, "Валюта");
				Если СтрокаДанныеВалюты <> Неопределено Тогда
					// Дата 01.07.24 определена в задаче #542080 комментарий Дудовой Анны 01.07.24 от 10:37 "Вячеслав, мы в пятницу разговаривали, Вы вроде сказали, что все изменения будут с 01.07 ?"
					Если НЕ СтрокаДанныеВалюты.КурсИзменился И ДатаПереоценки >= '20240701' Тогда
						Перекурсовать = Ложь;
					Иначе
						Перекурсовать = Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если (ЗначениеЗаполнено(ИзменениеТела) ИЛИ ЗначениеЗаполнено(ИзменениеТелаВВалютеУчета)) И Перекурсовать Тогда
					
					Если ДатаПереоценки >= ДатаНачалаРасчетовПоПерекурсовкиРЕПО Тогда
						Стоимость = СтрокаПартииКупленныеПоРЕПО.БалансоваяСумма - СтрокаПартииКупленныеПоРЕПО.Переоценка;
						СтоимостьВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.ПереоценкаВВалютеУчета;
						
						ПерекурсовкаТела = Окр(Стоимость * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс, 2) - СтоимостьВВалютеУчета;
						ПерекурсовкаПереоценки = Окр(СтрокаПартииКупленныеПоРЕПО.Переоценка * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс) - СтрокаПартииКупленныеПоРЕПО.ПереоценкаВВалютеУчета;
					КонецЕсли;	
					
				КонецЕсли;
				
				ИзменениеТелаВВалютеУчета = ИзменениеТелаВВалютеУчета - ПерекурсовкаТела - ПерекурсовкаПереоценки;
				
				Если (ЗначениеЗаполнено(ИзменениеКупона) ИЛИ ЗначениеЗаполнено(ИзменениеКупонаВВалютеУчета)) И Перекурсовать Тогда
					
					Если ДатаПереоценки >= ДатаНачалаРасчетовПоПерекурсовкиРЕПО Тогда
						СтоимостьКупона = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупона - СтрокаПартииКупленныеПоРЕПО.ПереоценкаКупона;
						СтоимостьКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупонаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета;
					
						ПерекурсовкаУНКД = Окр(СтоимостьКупона * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс, 2) - СтоимостьКупонаВВалютеУчета;
						ПерекурсовкаННКД = Окр(СтрокаПартииКупленныеПоРЕПО.ПереоценкаКупона * СтрокаПартииКупленныеПоРЕПО.КурсВалютыНоминалаНаДатуОценкиКурс, 2) - СтрокаПартииКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета;
					КонецЕсли;	
					
				КонецЕсли;
				
				ИзменениеКупонаВВалютеУчета = ИзменениеКупонаВВалютеУчета - ПерекурсовкаУНКД - ПерекурсовкаННКД;
				
			КонецЕсли;
			
			Движение.СтоимостьВВалютеУчета			= ПерекурсовкаТела;
			Движение.Переоценка 					= ИзменениеТела;
			Движение.ПереоценкаВВалютеУчета			= ИзменениеТелаВВалютеУчета + ПерекурсовкаПереоценки;
			
			Движение.СтоимостьКупонаВВалютеУчета	= ПерекурсовкаУНКД;
			Движение.ПереоценкаКупона				= ИзменениеКупона;
			Движение.ПереоценкаКупонаВВалютеУчета	= ИзменениеКупонаВВалютеУчета + ПерекурсовкаННКД;			
			
			// ВОТ ТАК ВОТ!!! это из-за СНГ с расчетным купоном
			Если ИзменениеКупона < 0
				И Сделка.ВалютаОплаты = ВалютаУчетаОрганизации 
				// #584924 для облигаций 29026 и 29027 на новогодние праздники разрешим после расчетного купона уходить в минус. ММВБ ошиблись в котировках, но ничего исправлять не стали.
				И Не (ЭтоКлиентГруппыБудущее И (НачалоДня(ЭтотОбъект.Дата) >= '20250101' И НачалоДня(ЭтотОбъект.Дата) <= '20250110') 
				И (Движение.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29026") Или Движение.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин29027"))) Тогда 
				// условие на запрет применимо только если сделка РЕПО в рублях, для расчетов в валюте такое возможно
				
				Движение.ПереоценкаКупона = 0;
				Движение.ПереоценкаКупонаВВалютеУчета = 0;
				
				ИзменениеКупона				= 0;
				ИзменениеКупонаВВалютеУчета	= 0; 
			КонецЕсли;
			
		КонецЕсли;
		
		// перекурсовка тело
		ПроводкаПоГлавеГ(0, ПерекурсовкаТела, АналитикаСтоимость, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, ?(Перекурсовать,"Перекурсовка стоимости по РЕПО", "Переоценка по РЕПО"));
		// перекурсовка переоценки
		ПроводкаПоГлавеГ(0, ПерекурсовкаПереоценки, АналитикаПереоценка, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, ?(Перекурсовать,"Перекурсовка переоценки по РЕПО", "Переоценка по РЕПО"));
		// собственно переоценка
		ПроводкаПоГлавеГ(ИзменениеТела, ИзменениеТелаВВалютеУчета, АналитикаТело, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, "Переоценка по РЕПО");
		
		Если Движение.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			// перекурсовка УНКД
			ПроводкаПоГлавеГ(0, ПерекурсовкаУНКД, АналитикаУНКД, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, ?(Перекурсовать,"Перекурсовка УНКД по РЕПО", "Переоценка купона по РЕПО"));
			// перекурсовка ННКД
			ПроводкаПоГлавеГ(0, ПерекурсовкаННКД, АналитикаННКД, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, ?(Перекурсовать,"Перекурсовка ННКД по РЕПО", "Переоценка купона по РЕПО"));
			// собственно переоценка
			ПроводкаПоГлавеГ(ИзменениеКупона, ИзменениеКупонаВВалютеУчета, АналитикаКупон, Движение.ЦеннаяБумага, Движение.Партия, ВалютаНоминала, "Переоценка купона по РЕПО");
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиПроданныеВРЕПОЕПС(Объект, ПереоценкаПослеВводаНачальныхОстатков, ДанныеКурсовЗаЭтотИПредыдущийДень, Отказ) 
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;

	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления);
								
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления,
								Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
								Отказ);
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
								ДатаПереоценки,
								ЭтотОбъект.Организация,
								ЭтотОбъект.СчетДоверительногоУправления,
								Справочники.ЦелиРасчета.ЕдиныйПланСчетов,
								Истина);	
	
	ДокументПереоценка = Новый Структура;
	
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Дата));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
    ДокументПереоценка.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
    ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
    ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета);
    ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", ЭтотОбъект.ВариантРасчетаОценочнойСтоимости);
    ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
    ДокументПереоценка.Вставить("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	ДокументПереоценка.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументПереоценка.СчетДоверительногоУправления, ДокументПереоценка.Дата));
    ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Истина);
	ДокументПереоценка.Вставить("РассчитыватьЦены", Истина);
	ДокументПереоценка.Вставить("ТолькоБумагиВРЕПО", Истина);
	
	РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(ДокументПереоценка, , Отказ);    	
	
	Для Каждого СтрокаЦенныеБумаги Из ДокументПереоценка.ЦенныеБумаги Цикл
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			СтрокаЦенныеБумаги.ЦеннаяБумага,
			СтрокаЦенныеБумаги.УчетныйАктивЕПС,
			СтрокаЦенныеБумаги.Партия,
			СтрокаЦенныеБумаги.СтрокаПартии);
								
		ВалютаНоминала = СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала;
		
		Если ВалютаНоминала <> ВалютаУчета Тогда
					
			СтрокаДанныеВалюты = ДанныеКурсовЗаЭтотИПредыдущийДень.Найти(ВалютаНоминала, "Валюта");
			Если СтрокаДанныеВалюты <> Неопределено И НЕ СтрокаДанныеВалюты.КурсИзменился Тогда
				СтрокаЦенныеБумаги.Перекурсовать = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Движение = Движения.БухПартииЦенныхБумагПроданныеВРепо.Добавить();
		//Движение.ВидДвиженияПартий			  = Перечисления.ВидыДвиженийПартий.ПереоценкаИНачислениеПроцентов;
		
		Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.УчетныйАктивЕПС			  = СтрокаЦенныеБумаги.УчетныйАктивЕПС;
		Движение.Партия                       = СтрокаЦенныеБумаги.Партия;
		Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
		Движение.Рынок                        = СтрокаЦенныеБумаги.Рынок;
		Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
		Движение.ПродажаРЕПО                  = СтрокаЦенныеБумаги.ПродажаРЕПО;
		Движение.СтрокаПродажиРЕПО            = 1;
		
		КурсоваяРазница = 0;
		КурсоваяРазницаПереоценки = 0;
		КурсоваяРазницаСтоимости = 0;
		КурсоваяРазницаКупона = 0;
		КурсоваяРазницаПереоценкиКупона = 0;
		КурсоваяРазницаСтоимостиКупона = 0;
		КурсоваяРазницаДисконтПремияНачисленный = 0;
		КурсоваяРазницаКорректировкиЭСП = 0;
		КурсоваяРазницаПервоначальногоПризнания = 0;
		
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
			Движение.ПереоценкаКупона = СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Движение.ПереоценкаКупона = 0 Тогда
					БалансоваяСуммаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
				Иначе
					БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаЦенныеБумаги.БалансоваяСуммаКупона,
						ВалютаНоминала,
						ЭтотОбъект.Организация,
						ДатаПереоценки,
						Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			КонецЕсли;
			Движение.ПереоценкаКупонаВВалютеУчета = 
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
			
				
			Движение.ДисконтПремияНачисленный = СтрокаЦенныеБумаги.ОценочныеДисконтПремия - СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Движение.ДисконтПремияНачисленный = 0 Тогда
					БалансовыеДисконтПремияПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета;
				Иначе
					БалансовыеДисконтПремияПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаЦенныеБумаги.БалансовыеДисконтПремия,
						ВалютаНоминала,
						ЭтотОбъект.Организация,
						ДатаПереоценки,
						Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаДисконтПремияНачисленный = БалансовыеДисконтПремияПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;
			КонецЕсли;
			Движение.ДисконтПремияНачисленныйВВалютеУчета = 
				СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета - СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета - КурсоваяРазницаДисконтПремияНачисленный;
				
				
			Если НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке
					ИЛИ НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности
					ИЛИ Движение.УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток Тогда
				
				Движение.КорректировкаЭСП = СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП - СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
				Если СтрокаЦенныеБумаги.Перекурсовать Тогда
					Если Движение.КорректировкаЭСП = 0 Тогда
						БалансоваяКорректировкаЭСППоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета;
					Иначе
						БалансоваяКорректировкаЭСППоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
							СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП,
							ВалютаНоминала,
							ЭтотОбъект.Организация,
							ДатаПереоценки,
							Отказ), 2);
					КонецЕсли;
					КурсоваяРазницаКорректировкиЭСП = БалансоваяКорректировкаЭСППоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
				КонецЕсли;
				Движение.КорректировкаЭСПВВалютеУчета = 
					СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета - КурсоваяРазницаКорректировкиЭСП;
			
			КонецЕсли;	

			
			Движение.Переоценка = СтрокаЦенныеБумаги.ОценочнаяСумма - СтрокаЦенныеБумаги.БалансоваяСумма
				- (СтрокаЦенныеБумаги.БалансовыеДисконтПремия + Движение.ДисконтПремияНачисленный) 
				- СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
			
				Если Движение.Переоценка = 0 Тогда
					БалансоваяСтоимостьПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета
						- (СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета + Движение.ДисконтПремияНачисленныйВВалютеУчета + КурсоваяРазницаДисконтПремияНачисленный) 
						- СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВвалютеУчета;
				Иначе
					БалансоваяСтоимостьПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаЦенныеБумаги.БалансоваяСумма,
						ВалютаНоминала,
						ЭтотОбъект.Организация,
						ДатаПереоценки,
						Отказ), 2);
				КонецЕсли;
				КурсоваяРазница = БалансоваяСтоимостьПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
			КонецЕсли;
			Движение.ПереоценкаВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета
				- (СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета + Движение.ДисконтПремияНачисленныйВВалютеУчета + КурсоваяРазницаДисконтПремияНачисленный) 
				- СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВвалютеУчета
				- КурсоваяРазница;
				
				
			Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0 Тогда
				    БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета; 
				Иначе
					БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные,
						ВалютаНоминала,
						ЭтотОбъект.Организация,
						ЭтотОбъект.Дата,
						Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаПервоначальногоПризнания = 
					БалансоваяРазницаППНеНаблюдаемыеДанныеПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			КонецЕсли;
			Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = 
				СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета - КурсоваяРазницаПервоначальногоПризнания;
				
		Иначе
				
			Движение.Переоценка = СтрокаЦенныеБумаги.ОценочнаяСумма - СтрокаЦенныеБумаги.БалансоваяСумма;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Движение.Переоценка = 0 Тогда
					БалансоваяСтоимостьПоТекущемуКурсу = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета;
				Иначе
					БалансоваяСтоимостьПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаЦенныеБумаги.БалансоваяСумма,
						ВалютаНоминала,
						ЭтотОбъект.Организация,
						ДатаПереоценки,
						Отказ), 2);
				КонецЕсли;
				КурсоваяРазница = БалансоваяСтоимостьПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
			КонецЕсли;
			
			Движение.ПереоценкаВВалютеУчета = СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета - КурсоваяРазница;
				
		КонецЕсли;
		
		Если СтрокаЦенныеБумаги.Перекурсовать Тогда
			ПереоценкаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СтрокаЦенныеБумаги.Переоценка,
				ВалютаНоминала,
				ЭтотОбъект.Организация,
				ДатаПереоценки,
				Отказ), 2);
			ПереоценкаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СтрокаЦенныеБумаги.ПереоценкаКупона,
				ВалютаНоминала,
				ЭтотОбъект.Организация,
				ДатаПереоценки,
				Отказ), 2);
		Иначе
			ПереоценкаПоТекущемуКурсу = СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
			ПереоценкаКупонаПоТекущемуКурсу = СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
		КонецЕсли;
		КурсоваяРазницаПереоценки = ПереоценкаПоТекущемуКурсу - СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
		КурсоваяРазницаСтоимости = КурсоваяРазница - КурсоваяРазницаПереоценки;
		КурсоваяРазницаПереоценкиКупона = ПереоценкаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
		КурсоваяРазницаСтоимостиКупона = КурсоваяРазницаКупона - КурсоваяРазницаПереоценкиКупона;

		
		Движение.ПереоценкаКупонаСНачалаГода = Движение.ПереоценкаКупонаВВалютеУчета;
		Движение.КорректировкаЭСПСНачалаГода = Движение.КорректировкаЭСПВВалютеУчета;
		Движение.ДисконтПремияНачисленныйСНачалаГода = Движение.ДисконтПремияНачисленныйВВалютеУчета;
		Движение.ПереоценкаСНачалаГода = Движение.ПереоценкаВВалютеУчета;
		Движение.РазницаПервоначальногоПризнанияСНачалаГода = - Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
		
		Если Движение.ПереоценкаВВалютеУчета > 0 Тогда
		    Движение.ПереоценкаСНачалаГодаПоложительная = Движение.ПереоценкаВВалютеУчета + Движение.ИндексацияНоминала;
		КонецЕсли;
		
		УчетныйАктивЕПС_РЕПО = Справочники.УчетныеАктивыЕПС.ПолучитьДанныеУчетногоАктиваЕПСДляБумагВРЕПО(СтрокаЦенныеБумаги.УчетныйАктивЕПС, Отказ);
		
		Если НЕ НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
		
			ПараметрыПроводки = Новый Структура();
			ПараметрыПроводки.Вставить("ВалютаУчета", ВалютаУчета);
			ПараметрыПроводки.Вставить("УчетныйАктив", УчетныйАктивЕПС_РЕПО);
			ПараметрыПроводки.Вставить("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага);
			ПараметрыПроводки.Вставить("ВалютаНоминала", ВалютаНоминала);
			ПараметрыПроводки.Вставить("ПереоценкаПослеВводаНачальныхОстатков", ПереоценкаПослеВводаНачальныхОстатков);
			ПараметрыПроводки.Вставить("Сделка", Неопределено);
			
			Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				Если Движение.ПереоценкаКупона <> 0 Тогда
					ПараметрыПроводки.Вставить("СуммаВал", Движение.ПереоценкаКупона);
					ПараметрыПроводки.Вставить("СуммаУчета", Движение.ПереоценкаКупонаВВалютеУчета);
					ПараметрыПроводки.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
					БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыПроводки, Отказ);
				КонецЕсли;
				
				Если СтрокаЦенныеБумаги.НачальныеДисконтПремия <> 0 Тогда
					
					ПараметрыПроводки.Вставить("СуммаВал", Движение.ДисконтПремияНачисленный);
					ПараметрыПроводки.Вставить("СуммаУчета", Движение.ДисконтПремияНачисленныйВВалютеУчета);
					
					Если СтрокаЦенныеБумаги.НачальныеДисконтПремия < 0 Тогда
						ПараметрыПроводки.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
						ПараметрыПроводки.Вставить("Доход", Истина);
					Иначе					
						ПараметрыПроводки.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
						ПараметрыПроводки.Вставить("Доход", Ложь);
					КонецЕсли;
					
					БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыПроводки, Отказ);
					
				КонецЕсли;
				
				Если Движение.КорректировкаЭСП <> 0 Тогда
					ПараметрыПроводки.Вставить("Показатель", "КорректировкаЭСП");
					ПараметрыПроводки.Вставить("СуммаВал", Движение.КорректировкаЭСП);
					ПараметрыПроводки.Вставить("СуммаУчета", Движение.КорректировкаЭСПВВалютеУчета);
					БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыПроводки, Отказ);
				КонецЕсли;

				Если Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0 Тогда
					ПараметрыПроводки.Вставить("Показатель", "РазницаПервоначальногоПризнания");
					ПараметрыПроводки.Вставить("СуммаВал", Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
					ПараметрыПроводки.Вставить("СуммаУчета", Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
					БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыПроводки, Отказ);
				КонецЕсли;
				
			КонецЕсли;

			Если Движение.Переоценка <> 0 Тогда
				ПараметрыПроводки.Вставить("Показатель", "Переоценка");
				ПараметрыПроводки.Вставить("СуммаВал", Движение.Переоценка);
				ПараметрыПроводки.Вставить("СуммаУчета", Движение.ПереоценкаВВалютеУчета);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыПроводки, Отказ);
			КонецЕсли;
			
		Иначе
		
			ПараметрыНачисления = Новый Структура;
			
			ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчетаЦеннойБумаги);
			
			ПараметрыНачисления.Вставить("ЦеннаяБумага",	СтрокаЦенныеБумаги.ЦеннаяБумага);
			ПараметрыНачисления.Вставить("ВалютаНоминала",	СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала);
			ПараметрыНачисления.Вставить("Партия",			СтрокаЦенныеБумаги.Партия);
			ПараметрыНачисления.Вставить("СтрокаПартии",	СтрокаЦенныеБумаги.СтрокаПартии);
			ПараметрыНачисления.Вставить("Количество",		0);
			
			// дисконт-премия	
			ПараметрыНачисления.Вставить("Сумма",				Движение.ДисконтПремияНачисленный);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	Движение.ДисконтПремияНачисленныйВВалютеУчета);
			
			ПараметрыНачисления.Вставить("СчетУчета",			УчетныйАктивЕПС_РЕПО.СчетУчета);
			Если СтрокаЦенныеБумаги.НачальныеДисконтПремия > 0 Тогда
				ПараметрыНачисления.Вставить("Содержание",			"Списание премии");
				ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы04);
				ПараметрыНачисления.Вставить("ГФУ",					УчетныйАктивЕПС_РЕПО.АналитикаСписанияПремии);
			Иначе
				ПараметрыНачисления.Вставить("Содержание",			"Начисление дисконта");
				ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы01);
				ПараметрыНачисления.Вставить("ГФУ",					УчетныйАктивЕПС_РЕПО.АналитикаПроцентныхДоходов);
			КонецЕсли;
			
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
			// ННКД	
			ПараметрыНачисления.Вставить("Сумма",				Движение.ПереоценкаКупона);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	Движение.ПереоценкаКупонаВВалютеУчета);
			
			ПараметрыНачисления.Вставить("СчетУчета",			УчетныйАктивЕПС_РЕПО.СчетУчета);
			ПараметрыНачисления.Вставить("Содержание",			"Переоценка купона");
			ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
			ПараметрыНачисления.Вставить("ГФУ",					УчетныйАктивЕПС_РЕПО.АналитикаПроцентныхДоходов);
			
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
			// переоценка
			БалансоваяПереоценка = СтрокаЦенныеБумаги.Переоценка;
			БалансоваяПереоценкаВВалютеУчета = СтрокаЦенныеБумаги.ПереоценкаВВалютеУчета;
			
			ПараметрыНачисления.Вставить("Сумма",				Движение.Переоценка);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	Движение.ПереоценкаВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаСНачалаГода",	Движение.ПереоценкаВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
			ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
			
			ПараметрыНачисления.Вставить("Содержание",			"Переоценка");
			ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
			
			ПараметрыНачисления.Вставить("ПроверитьПарные",		"Переоценка");
			
			Если (БалансоваяПереоценкаВВалютеУчета > 0)ИЛИ(БалансоваяПереоценкаВВалютеУчета = 0 И Движение.ПереоценкаВВалютеУчета > 0) Тогда
				ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктивЕПС_РЕПО.СчетУчетаПереоценкиА);
				ПараметрыНачисления.Вставить("СчетУчетаПарный",	УчетныйАктивЕПС_РЕПО.СчетУчетаПереоценкиП);
			Иначе
				ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктивЕПС_РЕПО.СчетУчетаПереоценкиП);
				ПараметрыНачисления.Вставить("СчетУчетаПарный",	УчетныйАктивЕПС_РЕПО.СчетУчетаПереоценкиА);
			КонецЕсли;
			
			Если (БалансоваяПереоценкаВВалютеУчета > 0)ИЛИ(БалансоваяПереоценкаВВалютеУчета = 0 И Движение.ПереоценкаВВалютеУчета > 0) Тогда
				ПараметрыНачисления.Вставить("СчетДоходовРасходов", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктивЕПС_РЕПО));
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаДоходовОтПереоценки);
				
				ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктивЕПС_РЕПО, Ложь));
				ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктивЕПС_РЕПО.АналитикаРасходовОтПереоценки);
			Иначе
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктивЕПС_РЕПО, Ложь));
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаРасходовОтПереоценки);
				
				ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктивЕПС_РЕПО));
				ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктивЕПС_РЕПО.АналитикаДоходовОтПереоценки);
			КонецЕсли;
				
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
			// корректировка ЭСП
			БалансоваяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
			БалансоваяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
			
			ПараметрыНачисления.Вставить("Сумма",				Движение.КорректировкаЭСП);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	Движение.КорректировкаЭСПВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаСНачалаГода",	Движение.КорректировкаЭСПВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяКорректировкаЭСП);
			ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяКорректировкаЭСПВВалютеУчета);
			
			ПараметрыНачисления.Вставить("Содержание",			"Корректировка ЭСП");
			ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка());
			
			ПараметрыНачисления.Вставить("ПроверитьПарные",		"КорректировкаЭСП");
			
			Если (БалансоваяКорректировкаЭСПВВалютеУчета > 0)ИЛИ(БалансоваяКорректировкаЭСПВВалютеУчета = 0 И Движение.КорректировкаЭСПВВалютеУчета > 0) Тогда
				ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктивЕПС_РЕПО.СчетУчетаКорректировокА);
				ПараметрыНачисления.Вставить("СчетУчетаПарный",	УчетныйАктивЕПС_РЕПО.СчетУчетаКорректировокП);
			Иначе
				ПараметрыНачисления.Вставить("СчетУчета",		УчетныйАктивЕПС_РЕПО.СчетУчетаКорректировокП);
				ПараметрыНачисления.Вставить("СчетУчетаПарный",	УчетныйАктивЕПС_РЕПО.СчетУчетаКорректировокА);
			КонецЕсли;
			
			Если (БалансоваяКорректировкаЭСПВВалютеУчета > 0)ИЛИ(БалансоваяКорректировкаЭСПВВалютеУчета = 0 И Движение.КорректировкаЭСПВВалютеУчета > 0) Тогда
				ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы05);
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаДоходовОтКорректировки);
				
				ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	ПланыСчетов.Единый.ПроцентныеДоходы06);
				ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктивЕПС_РЕПО.АналитикаРасходовОтКорректировки);
			Иначе
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы06);
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаРасходовОтКорректировки);
				
				ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", ПланыСчетов.Единый.ПроцентныеДоходы05);
				ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктивЕПС_РЕПО.АналитикаДоходовОтКорректировки);
			КонецЕсли;
				
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
			
			ПараметрыНачисления.Удалить("ПроверитьПарныеДоходыРасходы");
			
			// разница п/п
			ПараметрыНачисления.Вставить("Сумма",				Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
			
			ПараметрыНачисления.Вставить("Содержание",			"Разница первоначального признания");
			ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
			
			ПараметрыНачисления.Вставить("СчетУчета",			УчетныйАктивЕПС_РЕПО.СчетУчета);
			
			Если Движение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета > 0 Тогда
				ПараметрыНачисления.Вставить("СчетДоходовРасходов", УчетныйАктивЕПС_РЕПО.СчетУчетаДоходовОтОпераций);
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаДоходовПервоначальногоПризнания);
			Иначе
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	УчетныйАктивЕПС_РЕПО.СчетУчетаРасходовОтОпераций);
				ПараметрыНачисления.Вставить("ГФУ",				УчетныйАктивЕПС_РЕПО.АналитикаРасходовПервоначальногоПризнания);
			КонецЕсли;
				
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
		КонецЕсли;
			
		Если СтрокаЦенныеБумаги.Перекурсовать И 
			(КурсоваяРазницаПереоценкиКупона <> 0
			ИЛИ КурсоваяРазницаСтоимостиКупона <> 0
			ИЛИ КурсоваяРазницаПереоценки <> 0
			ИЛИ КурсоваяРазницаСтоимости <> 0
			ИЛИ КурсоваяРазницаДисконтПремияНачисленный <> 0
			ИЛИ КурсоваяРазницаКорректировкиЭСП <> 0
			ИЛИ КурсоваяРазницаПервоначальногоПризнания <> 0)
			Тогда
			
			НовоеДвижение = Движения.БухПартииЦенныхБумагПроданныеВРепо.Добавить();
			//НовоеДвижение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.Перекурсовка;
			
			НовоеДвижение.Организация		= ЭтотОбъект.Организация;
			НовоеДвижение.СчетДоверительногоУправления		= ЭтотОбъект.СчетДоверительногоУправления;
			НовоеДвижение.ВидУчета			= ЭтотОбъект.ВидУчета;
			НовоеДвижение.ЦеннаяБумага 		= СтрокаЦенныеБумаги.ЦеннаяБумага;
			НовоеДвижение.УчетныйАктивЕПС 	= СтрокаЦенныеБумаги.УчетныйАктивЕПС;
			НовоеДвижение.Партия 			= СтрокаЦенныеБумаги.Партия;
			НовоеДвижение.СтрокаПартии 		= СтрокаЦенныеБумаги.СтрокаПартии;
			НовоеДвижение.Рынок 			= СтрокаЦенныеБумаги.Рынок;
			НовоеДвижение.ПродажаРЕПО 		= СтрокаЦенныеБумаги.ПродажаРЕПО;
			НовоеДвижение.СтрокаПродажиРЕПО = 1;
			
			НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
			НовоеДвижение.Регистратор 		= ЭтотОбъект.Ссылка;
			НовоеДвижение.Период 			= ЭтотОбъект.Дата;
				
			НовоеДвижение.СтоимостьВВалютеУчета												= КурсоваяРазницаСтоимости;
			НовоеДвижение.СтоимостьКупонаВВалютеУчета										= КурсоваяРазницаСтоимостиКупона;
			НовоеДвижение.ПереоценкаВВалютеУчета											= КурсоваяРазницаПереоценки;
			НовоеДвижение.ПереоценкаКупонаВВалютеУчета										= КурсоваяРазницаПереоценкиКупона;
			НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета								= КурсоваяРазницаДисконтПремияНачисленный;
			НовоеДвижение.КорректировкаЭСПВВалютеУчета										= КурсоваяРазницаКорректировкиЭСП;
			НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета	= КурсоваяРазницаПервоначальногоПризнания;
			НовоеДвижение.КурсовыеРазницыСНачалаГода										= КурсоваяРазницаПереоценкиКупона + КурсоваяРазницаСтоимостиКупона
				+ КурсоваяРазницаПереоценки + КурсоваяРазницаСтоимости 
				+ КурсоваяРазницаДисконтПремияНачисленный + КурсоваяРазницаКорректировкиЭСП + КурсоваяРазницаПервоначальногоПризнания;
				
			// тут будут проводки перекурсовки
			ПараметрыПерекурсовки = Новый Структура;
			
			ПараметрыПерекурсовки.Вставить("ЦеннаяБумага",														СтрокаЦенныеБумаги.ЦеннаяБумага);
			ПараметрыПерекурсовки.Вставить("УчетныйАктивЕПС",													УчетныйАктивЕПС_РЕПО);
			
			ПараметрыПерекурсовки.Вставить("СтоимостьВВалютеУчета",												КурсоваяРазницаСтоимости);
			ПараметрыПерекурсовки.Вставить("СтоимостьКупонаВВалютеУчета",										КурсоваяРазницаСтоимостиКупона);
			ПараметрыПерекурсовки.Вставить("ПереоценкаВВалютеУчета",											КурсоваяРазницаПереоценки);
			ПараметрыПерекурсовки.Вставить("ПереоценкаКупонаВВалютеУчета",										КурсоваяРазницаПереоценкиКупона);
			ПараметрыПерекурсовки.Вставить("ДисконтПремияНачисленныйВВалютеУчета",								КурсоваяРазницаДисконтПремияНачисленный);
			ПараметрыПерекурсовки.Вставить("КорректировкаЭСПВВалютеУчета",										КурсоваяРазницаКорректировкиЭСП);
			ПараметрыПерекурсовки.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета",	КурсоваяРазницаПервоначальногоПризнания);
			
			ПараметрыПерекурсовки.Вставить("ДисконтПремияНачисленныйОстаток",									СтрокаЦенныеБумаги.БалансовыеДисконтПремия);
			ПараметрыПерекурсовки.Вставить("ПереоценкаОстаток",													СтрокаЦенныеБумаги.ПереоценкаНаБалансе);
			ПараметрыПерекурсовки.Вставить("КорректировкаЭСПОстаток",											СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП);
			ПараметрыПерекурсовки.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",			СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные);
			
			Если СтрокаЦенныеБумаги.НачальныеДисконтПремия < 0 Тогда
				КурсоваяРазницаДисконт = КурсоваяРазницаДисконтПремияНачисленный;	
				КурсоваяРазницаПремия = 0;
			Иначе
				КурсоваяРазницаДисконт = 0;	
				КурсоваяРазницаПремия = КурсоваяРазницаДисконтПремияНачисленный;
			КонецЕсли;
			ПараметрыПерекурсовки.Вставить("ДисконтНачисленныйВВалютеУчета",									КурсоваяРазницаДисконт);
			ПараметрыПерекурсовки.Вставить("ПремияНачисленнаяВВалютеУчета",										КурсоваяРазницаПремия);
			
			ПараметрыПерекурсовки.Вставить("ПереоценкаПоФиксированномуКурсу",									Ложь);
			
			Если НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
				
				ПараметрыПерекурсовки.Вставить("ОтражатьПартииНаЛицевыхСчетах",		Истина);
				
				ПараметрыПерекурсовки.Вставить("Партия",		СтрокаЦенныеБумаги.Партия);
				ПараметрыПерекурсовки.Вставить("СтрокаПартии",	СтрокаЦенныеБумаги.СтрокаПартии);
				
			КонецЕсли;
			
			БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);
				
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЦенныеБумагиКПередаче(Объект, МенеджерВременныхТаблиц = Неопределено, ИмяВремТаблицы = Неопределено, Отказ) 

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     Объект.ВидУчета);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Облигации
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Паи
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|	КОНЕЦ КАК Рынок,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК ЦеннаяБумага,
		|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка) КАК Основание,
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка) КАК Партия,
		|	1 КАК СтрокаПартии,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт) КАК Количество,
		|	0 КАК БалансоваяЦена,
		|	0 КАК БалансоваяЦенаПроцент,
		|	0 КАК БалансоваяЦенаКупона,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги)
		|				ТОГДА 0
		|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт
		|		КОНЕЦ) КАК БалансоваяСумма,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный)
		|				ТОГДА 0
		|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт
		|		КОНЕЦ) КАК БалансоваяСуммаКупона,
		|	0 КАК Переоценка,
		|	0 КАК БалансоваяИндексацияНоминала,
		|	0 КАК ПереоценкаКупона,
		|	0 КАК РасходыПриПокупкеВСтоимости,
		|	0 КАК ПереоценкаНаБалансе,
		|	0 КАК ПереоценкаНаБалансеВВалютеУчета,
		|	0 КАК БалансовыеДисконтПремия,
		|	0 КАК БалансовыеДисконтПремияВВалютеУчета,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
		|	0 КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяКорректировкаЭСП,
		|	0 КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	0 КАК НачальныеДисконтПремия,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги)
		|				ТОГДА 0
		|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт
		|		КОНЕЦ) КАК БалансоваяСуммаВВалютеУчета,
		|	СУММА(ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный)
		|				ТОГДА 0
		|			ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт
		|		КОНЕЦ) КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	0 КАК ПереоценкаВВалютеУчета,
		|	0 КАК ПереоценкаКупонаВВалютеУчета,
		|	0 КАК Стоимость,
		|	0 КАК СтоимостьВВалютеУчета,
		|	0 КАК СуммаРезервовПодОбесценение
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.ОбязательстваПоПоставкеЦБ01), ЗНАЧЕНИЕ(ПланСчетов.Единый.ОбязательстваПоПоставкеЦБ02)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто2 ССЫЛКА Справочник.Акции
		|					ИЛИ Субконто2 ССЫЛКА Справочник.Облигации
		|					ИЛИ Субконто2 ССЫЛКА Справочник.Паи)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Облигации
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.Паи
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|	КОНЕЦ,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка),
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка)";
		
		
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ИЗ", "	ПОМЕСТИТЬ " + ИмяВремТаблицы + "
			|ИЗ");
	КонецЕсли;
		
	РезультатЗапроса = Запрос.Выполнить();
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиКПередачеЕПС(Объект, ПереоценкаПослеВводаНачальныхОстатков, НастройкиУчета, Отказ) 
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов, Истина);	
	ВыполнятьРасчетПоПисьмуЦБ0185316 = НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	
	МассивСчетовСНГ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ЭтотОбъект.Дата);
	ЭтоКлиентСНГ = (МассивСчетовСНГ.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
		
	ЭтоКлиентГруппыБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	
	
	НастройкиЗабаланс = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивыЕПС.ЦенныеБумагиОжидаемыеКПередачеПоСделкамТПлюсЗабалансовыеСчета,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);

	ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс = НастройкиЗабаланс.ПериодичностьПереоценки;
	ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс = НастройкиЗабаланс.ПериодичностьНачисленияПроцентныхДоходов;
	
	// если периодичность заполнена
	ПереоцениватьБаланс = Истина;
	Если ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка()
		И ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
	
		ПереоцениватьБаланс = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиБумагОжидаемыхПоСделкамТПлюс, ДатаПереоценки, КалендарьДляСчетаДУ);
		
	КонецЕсли;
	ПереоцениватьВДеньОперации = НастройкиЗабаланс.ПереоцениватьВДеньОперации;
	
	Если НЕ ПереоцениватьБаланс И НЕ ПереоцениватьВДеньОперации Тогда
		Возврат;
	КонецЕсли;	
	
	ПереоцениватьКупон = Истина;
	Если ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка()
		И ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
	
		ПереоцениватьКупон = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиКупоновОжидаемыхПоСделкамТПлюс, ДатаПереоценки, КалендарьДляСчетаДУ);
		
	КонецЕсли;
	
	
	ДокументПереоценка = Новый Структура;
	
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Дата));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
    ДокументПереоценка.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
    ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
    ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета);
    ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", ЭтотОбъект.ВариантРасчетаОценочнойСтоимости);
    ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
    ДокументПереоценка.Вставить("ЦельРасчета", Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
    ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Ложь);
	ДокументПереоценка.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументПереоценка.СчетДоверительногоУправления, ДокументПереоценка.Дата));	
	ДокументПереоценка.Вставить("РассчитыватьЦены", Ложь);
	
	Отказ = Ложь;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьЦенныеБумагиКПередаче(ДокументПереоценка, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	ОцениваемыеБумаги = МенеджерВременныхТаблиц.Таблицы["ТаблицаПартийЦБ"].ПолучитьДанные().Выгрузить();
	
	СообщенияОбОценочнойСтоимости = Неопределено;
	РаботаСПереоценкой.ЗаполнитьКотировки(ДокументПереоценка, МенеджерВременныхТаблиц, СообщенияОбОценочнойСтоимости, Отказ);
	
	Если ЭтоКлиентСНГ // #424568 - СНГ не применяет послабленияд для бумаг по Т+ - сделал отдельный расчет с отключением послабления
		ИЛИ (ЭтоКлиентГруппыБудущее И ЭтотОбъект.Дата >= '20250514') Тогда // будет переделываться, но пока Будущее тоже будет считать так
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",					ЭтотОбъект.Организация);
		ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
		ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
		ПараметрыРасчета.Вставить("Дата", 							КонецДня(ДатаПереоценки));
		НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
		ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий); 	
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 	
		
		РСП = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(РСП, ПараметрыРасчета);
		РСП.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
		РСП.ДополнительныеСвойства.Вставить("ВыполнятьРасчетПоУказаниюЦБ", ЭтоКлиентГруппыБудущее);
		
		РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ОцениваемыеБумаги, "ТипЗадолженности", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		
		РСП.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ОцениваемыеБумаги, Истина);
		ТаблицаСтоимостей = РСП.СтоимостиПереоценки.Выгрузить();
		
	КонецЕсли;
	
	МассивОбработанных = Новый Массив;

	Для Каждого СтрокаПартииКПередаче Из ДокументПереоценка.ЦенныеБумаги Цикл
		
		Если ВыполнятьРасчетПоПисьмуЦБ0185316 И НЕ ЭтоКлиентСНГ // #424568 - СНГ не применяет послабленияд для бумаг по Т+
			И НЕ (ЭтоКлиентГруппыБудущее И ЭтотОбъект.Дата >= '20250514') Тогда // Будущее тоже пока по схеме СНГ работает 
			
			Если МассивОбработанных.Найти(СтрокаПартииКПередаче.Основание) = Неопределено Тогда
				МассивОбработанных.Добавить(СтрокаПартииКПередаче.Основание);
			Иначе
				Продолжить;
			КонецЕсли;
			
			СтрокаПартииКПередаче.ОценочнаяСумма = СтрокаПартииКПередаче.Основание.ЦенныеБумаги.Итог("Сумма");
			СтрокаПартииКПередаче.ОценочнаяСуммаВВалютеУчета = СтрокаПартииКПередаче.ОценочнаяСумма;
			
			Если СтрокаПартииКПередаче.Основание.ВалютаСделки <> ЭтотОбъект.Организация.ВалютаУчета Тогда
			
				СтрокаПартииКПередаче.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
					Новый Структура("ОценочнаяСуммаВВалютеУчета", СтрокаПартииКПередаче.ОценочнаяСумма),
					СтрокаПартииКПередаче.Основание.ВалютаСделки,
					ЭтотОбъект.Организация,
					НачалоДня(СтрокаПартииКПередаче.Основание.Дата),
					?(ЗначениеЗаполнено(СтрокаПартииКПередаче.Основание.КурсОплаты), СтрокаПартииКПередаче.Основание.КурсОплаты, Неопределено),
					Отказ).ОценочнаяСуммаВВалютеУчета;
					
			КонецЕсли;
			
		ИначеЕсли ЭтоКлиентСНГ
			ИЛИ (ЭтоКлиентГруппыБудущее И ЭтотОбъект.Дата >= '20250514') Тогда
			
			СтрокаЦены = ТаблицаСтоимостей.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаПартииКПередаче.ЦеннаяБумага))[0];
			
			СтрокаПартииКПередаче.ОценочнаяСумма = СтрокаПартииКПередаче.Количество * СтрокаЦены.ЦенаКотировки;
			
			СтрокаПартииКПередаче.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
				Новый Структура("ОценочнаяСуммаВВалютеУчета", СтрокаПартииКПередаче.ОценочнаяСумма),
				СтрокаПартииКПередаче.Основание.ВалютаСделки,
				ЭтотОбъект.Организация,
				НачалоДня(СтрокаПартииКПередаче.Основание.Дата),
				?(ЗначениеЗаполнено(СтрокаПартииКПередаче.Основание.КурсОплаты), СтрокаПартииКПередаче.Основание.КурсОплаты, Неопределено),
				Отказ).ОценочнаяСуммаВВалютеУчета;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкиУчета.УчитыватьПогрешностьОкругленияНаПартияхДляЦенныхБумагОжидаемыхКПередачеПоСделкамТСЗабалансовыхСчетов Тогда
		
		НастройкиЦелейРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(
									ЭтотОбъект.Дата,
									ЭтотОбъект.Организация,
									ЭтотОбъект.СчетДоверительногоУправления,
									Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
								
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
									ДатаПереоценки,
									ЭтотОбъект.Организация,
									ЭтотОбъект.СчетДоверительногоУправления,
									Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
									Отказ);

		РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ДокументПереоценка.ЦенныеБумаги, "ОценочнаяСумма", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
									
		РаботаСПереоценкой.РаспределитьПогрешностьОкругленияСтоимостиЦенныхБумагНаПартии(ДокументПереоценка, Справочники.ЦелиРасчета.ЕдиныйПланСчетов, НастройкиЦелейРасчета, НастройкиПоВидуУчета.УчитыватьПогрешностьОкругленияНаПартиях, НастройкиПоВидуУчета.УчитыватьПогрешностьОкругленияНаПартияхВВалютеУчета, Отказ);
		
	КонецЕсли;
	
	Для Каждого СтрокаПартииКПередаче Из ДокументПереоценка.ЦенныеБумаги Цикл
		
		Если СтрокаПартииКПередаче.БалансоваяСумма = СтрокаПартииКПередаче.ОценочнаяСумма
			И СтрокаПартииКПередаче.БалансоваяСуммаКупона = СтрокаПартииКПередаче.ОценочнаяСуммаКупона Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		Сделка = СтрокаПартииКПередаче.Партия;
		Если Сделка.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			Контрагент = Сделка.Брокер.ЮрФизЛицо;
		Иначе
			Контрагент = Сделка.Контрагент;
		КонецЕсли;
		
		Если НЕ ПереоцениватьБаланс И НачалоДня(Сделка.Дата) <> НачалоДня(ЭтотОбъект.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		КонтрагентЯвляетсяРезидентом = Справочники.ЮрФизЛица.ЯвляетсяРезидентом(Контрагент, ЭтотОбъект.Организация);
		ВалютаНоминала = СтрокаПартииКПередаче.ЦеннаяБумага.ВалютаНоминала;
		
		Переоценка  				  = СтрокаПартииКПередаче.ОценочнаяСумма - СтрокаПартииКПередаче.БалансоваяСумма;
		ПереоценкаВВалютеУчета		  = СтрокаПартииКПередаче.ОценочнаяСуммаВВалютеУчета - СтрокаПартииКПередаче.БалансоваяСуммаВВалютеУчета;
		
		ПереоценкаКупона 			 = СтрокаПартииКПередаче.ОценочнаяСуммаКупона - СтрокаПартииКПередаче.БалансоваяСуммаКупона;
		ПереоценкаКупонаВВалютеУчета = СтрокаПартииКПередаче.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКПередаче.БалансоваяСуммаКупонаВВалютеУчета;
		
		Если ПереоцениватьКупон Тогда
			ПереоценкаКупона				= СтрокаПартииКПередаче.ОценочнаяСуммаКупона - СтрокаПартииКПередаче.БалансоваяСуммаКупона;
			ПереоценкаКупонаВВалютеУчета	= СтрокаПартииКПередаче.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКПередаче.БалансоваяСуммаКупонаВВалютеУчета;
		Иначе
			ПереоценкаКупона				= 0;
			ПереоценкаКупонаВВалютеУчета	= 0;
		КонецЕсли;
		
		
		Если НастройкиУчета.ВключатьКупонВСтоимостьПриПереоценкеБумагОжидаемыхПоСделкамТПлюс Тогда
			
			Переоценка = Переоценка + ПереоценкаКупона;
			ПереоценкаВВалютеУчета = ПереоценкаВВалютеУчета + ПереоценкаКупонаВВалютеУчета;
			
			ПереоценкаКупона 			 = 0;
			ПереоценкаКупонаВВалютеУчета = 0;
			
		КонецЕсли;
		
		Если ПереоценкаВВалютеУчета > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ПереоценкаВВалютеУчета, "Переоценка");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			
			// кредит
			Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01);
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПартииКПередаче.ЦеннаяБумага;
			
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = Переоценка;
			Проводка.КоличествоКт = 0;
			
		ИначеЕсли ПереоценкаВВалютеУчета < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ПереоценкаВВалютеУчета, "Переоценка");
			
			// дебет
			Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01);
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаПартииКПередаче.ЦеннаяБумага;
			
			Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
			Проводка.ВалютаДт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт = -Переоценка;
			Проводка.КоличествоДт = 0;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			
		КонецЕсли;
		
		Если НЕ НастройкиУчета.ВключатьКупонВСтоимостьПриПереоценкеБумагОжидаемыхПоСделкамТПлюс Тогда
		
			Если ПереоценкаКупонаВВалютеУчета > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ПереоценкаКупонаВВалютеУчета, "Переоценка");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
				
				// кредит
				Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01);
				Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
				Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПартииКПередаче.ЦеннаяБумага;
				
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = ПереоценкаКупона;
				Проводка.КоличествоКт = 0;
				
			ИначеЕсли ПереоценкаКупонаВВалютеУчета < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ПереоценкаКупонаВВалютеУчета, "Переоценка");
				
				// дебет
				Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01);
				Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаПартииКПередаче.ЦеннаяБумага;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = -ПереоценкаКупона;
				Проводка.КоличествоДт = 0;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиПроданныеВРЕПО(Объект, Отказ) 
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценкиПереданныхВЗалог КАК ПериодичностьПереоценкиПереданныхВЗалог,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВЗалогеВНерабочиеДни КАК ПереоцениватьВЗалогеВНерабочиеДни,
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаПереоценки,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И Организация = &Организация) КАК НастройкиУчетаАктивовСрезПоследних
		|ГДЕ
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценкиПереданныхВЗалог <> ЗНАЧЕНИЕ(Перечисление.ПериодичностьПереоценкиАктивов.ПустаяСсылка)
		|	И НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценкиПереданныхВЗалог <> ЗНАЧЕНИЕ(Перечисление.ПериодичностьПереоценкиАктивов.НеПереоценивать)";
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Выбрать().Следующий() Тогда
		//нет настроек что-то переоценивать в залоге!
		Возврат;
	КонецЕсли;
	
	ДокументПереоценка = Новый Структура;
	
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Дата));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
    ДокументПереоценка.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
    ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
    ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета);
    ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", ЭтотОбъект.ВариантРасчетаОценочнойСтоимости);
    ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
    ДокументПереоценка.Вставить("ЦельРасчета", БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(Объект.ВидУчета));
    ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Ложь);
	ДокументПереоценка.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументПереоценка.СчетДоверительногоУправления, ДокументПереоценка.Дата));
	
	Отказ = Ложь;
	
	МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Документы.ПереоценкаЦенныхБумаг.ЗаполнитьЦенныеБумагиПроданныеВРЕПО(ДокументПереоценка, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	СообщенияОбОценочнойСтоимости = Неопределено;
	РаботаСПереоценкой.ЗаполнитьКотировки(ДокументПереоценка, МенеджерВременныхТаблиц, СообщенияОбОценочнойСтоимости, Отказ);
	
	Если Объект.ПереоцениватьНаОснованииНастроекУчета Тогда
		Документы.ПереоценкаЦенныхБумаг.ПрименитьПолитикуУчетаПереоценкиПроданныеВРЕПО(ДокументПереоценка, Ложь, СообщенияОбОценочнойСтоимости, Организация.ВалютаУчета, Отказ);
	КонецЕсли;
	
	НастройкиУчетаПереоценки = БухгалтерскийУчет.ОпределитьНастройкиУчетаПереоценкиВЗалоге(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	ПереоцениватьПоПартиям = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		"ПереоцениватьПоПартиям");
		
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	СведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата,,УчетныйРегистр,,ДокументПереоценка.ЦенныеБумаги);
	
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиВВалютеУчета");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыПереоценки");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыСтоимости");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаПереоценкиКупонаВВалютеУчета");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыПереоценкиКупона");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("СуммаКурсовойРазницыКупона");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("ИндексацияНоминала");
	ДокументПереоценка.ЦенныеБумаги.Колонки.Добавить("ПроцентныйДоход");
	
	ТаблицаПартииРЕПО = МенеджерВременныхТаблиц.Таблицы.Получить("ТаблицаПартийЦБ").ПолучитьДанные().Выгрузить();
	Для Каждого СтрокаПартииПроданныеВРЕПО Из ДокументПереоценка.ЦенныеБумаги Цикл
		Если СтрокаПартииПроданныеВРЕПО.БалансоваяСумма = СтрокаПартииПроданныеВРЕПО.ОценочнаяСумма
			И (СтрокаПартииПроданныеВРЕПО.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации
				ИЛИ СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупона = СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупона) Тогда
			Продолжить;
		КонецЕсли;
		
		ЦеннаяБумага = СтрокаПартииПроданныеВРЕПО.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаПартииПроданныеВРЕПО.Рынок, ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаПартииПроданныеВРЕПО.Рынок, ЦеннаяБумага, Истина);
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
		
		УчитыватьПереоценкуОтдельно      = НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
		УчитыватьПереоценкуОтдельноКупон = НастройкиУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных];

		
		СтрокиРЕПО = ТаблицаПартииРЕПО.НайтиСтроки(Новый Структура("Партия, СтрокаПартии, Количество", СтрокаПартииПроданныеВРЕПО.Партия, СтрокаПартииПроданныеВРЕПО.СтрокаПартии, СтрокаПартииПроданныеВРЕПО.Количество));
		Если СтрокиРЕПО.Количество()=0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена проданная в РЕПО партия "++" ("++") ",,,,Отказ);
		Иначе
			СтрокаРЕПО = СтрокиРЕПО[0];
		КонецЕсли;
		
		СуммаПереоценки = СтрокаПартииПроданныеВРЕПО.ОценочнаяСумма - СтрокаПартииПроданныеВРЕПО.БалансоваяСумма;
		Если СуммаПереоценки = 0 Тогда
			БалансоваяСуммаПоТекущемуКурсу = СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаВВалютеУчета;
		Иначе
			БалансоваяСуммаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.БалансоваяСумма, ВалютаНоминала, Организация, Дата, Отказ), 2);
		КонецЕсли;
		КурсоваяРазница = БалансоваяСуммаПоТекущемуКурсу - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаВВалютеУчета;
		СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиВВалютеУчета = СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаВВалютеУчета - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаВВалютеУчета - КурсоваяРазница;
		Если НЕ УчитыватьПереоценкуОтдельно Тогда
			СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценки = 0;
		Иначе
			СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценки = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.Переоценка, ВалютаНоминала, Организация, Дата, Отказ), 2)
			 - СтрокаПартииПроданныеВРЕПО.ПереоценкаВВалютеУчета;
		КонецЕсли;

		СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыСтоимости = КурсоваяРазница - СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценки;
		
		
		СуммаПереоценкиКупона 				= СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупона - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупона;
		Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
			БалансоваяСтоимостьКупонаВВалютеУчета = СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупонаВВалютеУчета - СтрокаПартииПроданныеВРЕПО.ПереоценкаКупонаВВалютеУчета;
			Если СуммаПереоценкиКупона = 0 Тогда
				БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупонаВВалютеУчета;
			Иначе
				БалансоваяСуммаКупонаПоТекущемуКурсу = БалансоваяСтоимостьКупонаВВалютеУчета + Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2);
			КонецЕсли;
			КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупонаВВалютеУчета;
			СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
			Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для налогового учета купон проданных в РЕПО бумаг учитывается вместе с переоценкой купона. Серьезно?",,,,);
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = 0;
			Иначе
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2)
				 - СтрокаПартииПроданныеВРЕПО.ПереоценкаКупонаВВалютеУчета;
			КонецЕсли;
			СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона;
			Если СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупона = СтрокаПартииПроданныеВРЕПО.ПереоценкаКупона Тогда 
				//купон при покупке погашен, все валим на переоценку купона
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона + СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона;
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона = 0;
			КонецЕсли;
		Иначе
			Если СуммаПереоценкиКупона = 0 Тогда
				БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупонаВВалютеУчета;
			Иначе
				БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2);
			КонецЕсли;
			КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупонаВВалютеУчета;
			СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаПартииПроданныеВРЕПО.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
			Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = 0;
			Иначе
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаПартииПроданныеВРЕПО.ПереоценкаКупона, ВалютаНоминала, Организация, Дата, Отказ), 2)
				 - СтрокаПартииПроданныеВРЕПО.ПереоценкаКупонаВВалютеУчета;
			КонецЕсли;
			СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона;
			Если СтрокаПартииПроданныеВРЕПО.БалансоваяСуммаКупона = СтрокаПартииПроданныеВРЕПО.ПереоценкаКупона Тогда 
				//купон при покупке погашен, все валим на переоценку купона
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона + СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона;
				СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона = 0;
			КонецЕсли;
		КонецЕсли;
		
		Если СуммаПереоценки <>0 ИЛИ  СуммаПереоценкиКупона <> 0 
			Тогда
			Движение = Движения.БухПартииЦенныхБумагПроданныеВРепо.Добавить();
			
			Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ЦеннаяБумага                 = ЦеннаяБумага;
			Движение.Партия                       = СтрокаПартииПроданныеВРЕПО.Партия;
			Движение.СтрокаПартии                 = СтрокаПартииПроданныеВРЕПО.СтрокаПартии;
			Движение.Рынок                        = СтрокаПартииПроданныеВРЕПО.Рынок;
			Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
			Движение.ПродажаРЕПО				  = СтрокаРЕПО.ПродажаРЕПО;
			Движение.СтрокаПродажиРЕПО			  = СтрокаРЕПО.СтрокаПродажиРЕПО;
			
			Если СуммаПереоценки <> 0 Тогда
				Если Не УчитыватьПереоценкуОтдельно Тогда
					Движение.Стоимость  				  = СуммаПереоценки;
					Движение.СтоимостьВВалютеУчета		  = СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиВВалютеУчета;
					Движение.ПереоценкаВСтоимости 		  = СуммаПереоценки;
				Иначе
					Движение.Переоценка 			= СуммаПереоценки;
					Движение.ПереоценкаВВалютеУчета = СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиВВалютеУчета;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаПартииПроданныеВРЕПО.ОценочнаяЦена = 0 И Движение.Переоценка <> 0 Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ВНИМАНИЕ! Ценная бумага " + СтрокаПартииПроданныеВРЕПО.ЦеннаяБумага + " (" + СтрокаПартииПроданныеВРЕПО.Партия + "/" + СтрокаПартииПроданныеВРЕПО.СтрокаПартии + ") переоценена в 0");	
			КонецЕсли;	
			
			Если СтрокаПартииПроданныеВРЕПО.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				Если Не УчитыватьПереоценкуОтдельноКупон Тогда
					Движение.СтоимостьКупона  			 = СуммаПереоценкиКупона;
					Движение.СтоимостьКупонаВВалютеУчета = СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиКупонаВВалютеУчета;
					Движение.ПереоценкаКупонаВСтоимости  = СуммаПереоценкиКупона;
				Иначе
					Движение.ПереоценкаКупона 				= СуммаПереоценкиКупона;
					Движение.ПереоценкаКупонаВВалютеУчета 	= СтрокаПартииПроданныеВРЕПО.СуммаПереоценкиКупонаВВалютеУчета;
				КонецЕсли;
			КонецЕсли;	
			
			// ВОТ ТАК ВОТ!!! это из-за СНГ с расчетным купоном
			Если Движение.ПереоценкаКупона < 0 Тогда
				Движение.ПереоценкаКупона = 0;
				Движение.ПереоценкаКупонаВВалютеУчета = 0;
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаПартииПроданныеВРЕПО.Перекурсовать И (СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыСтоимости <> 0 ИЛИ СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона <> 0 
			ИЛИ СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценки <> 0 ИЛИ СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона <> 0) Тогда
			
			Движение = Движения.БухПартииЦенныхБумагПроданныеВРепо.Добавить();
			
			Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ЦеннаяБумага                 = ЦеннаяБумага;
			Движение.Партия                       = СтрокаПартииПроданныеВРЕПО.Партия;
			Движение.СтрокаПартии                 = СтрокаПартииПроданныеВРЕПО.СтрокаПартии;
			Движение.Рынок                        = СтрокаПартииПроданныеВРЕПО.Рынок;
			Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
			Движение.СтоимостьВВалютеУчета		  = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыСтоимости;
			Движение.ПереоценкаВВалютеУчета		  = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценки;
			Движение.СтоимостьКупонаВВалютеУчета  = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыКупона;
			Движение.ПереоценкаКупонаВВалютеУчета = СтрокаПартииПроданныеВРЕПО.СуммаКурсовойРазницыПереоценкиКупона;
			Движение.ПродажаРЕПО				  = СтрокаРЕПО.ПродажаРЕПО;
			Движение.СтрокаПродажиРЕПО			  = СтрокаРЕПО.СтрокаПродажиРЕПО;
			
		КонецЕсли;
			
	КонецЦикла;
	
	СводныеЦенныеБумаги = ДокументПереоценка.ЦенныеБумаги;
	
	Если НЕ ПереоцениватьПоПартиям Тогда
		
		СводныеЦенныеБумаги.Свернуть("Рынок, ЦеннаяБумага, Перекурсовать, ИндексироватьНоминал", "ОценочнаяСумма, БалансоваяСумма, ОценочнаяСуммаКупона, БалансоваяСуммаКупона,"
		+ " ОценочнаяСуммаВВалютеУчета, БалансоваяСуммаВВалютеУчета, ОценочнаяСуммаКупонаВВалютеУчета, БалансоваяСуммаКупонаВВалютеУчета,"
		+ " Переоценка, ПереоценкаВВалютеУчета, ПереоценкаКупона, ПереоценкаКупонаВВалютеУчета,"
		+ " СуммаПереоценкиВВалютеУчета, СуммаКурсовойРазницыПереоценки, СуммаКурсовойРазницыСтоимости,"
		+ " СуммаПереоценкиКупонаВВалютеУчета, СуммаКурсовойРазницыПереоценкиКупона, СуммаКурсовойРазницыКупона,"
		+ " ИндексацияНоминала");
		
	КонецЕсли;
	
	Для Каждого СтрокаЦенныеБумаги Из СводныеЦенныеБумаги Цикл
		
		ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаЦенныеБумаги.Рынок, ЦеннаяБумага, Истина);
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
		
		УчитыватьПереоценкуОтдельно      = НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
		УчитыватьПереоценкуОтдельноКупон = НастройкиУчетаПереоценки[УчетныйАктивКупон.ИмяПредопределенныхДанных];
		
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			ЭтотОбъект.ВидУчета);
			
		НастройкиУчетаАктиваКупон = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупон,
			ЭтотОбъект.ВидУчета);
		
		ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(СтрокаЦенныеБумаги.Рынок);
		
		СуммаПереоценки = СтрокаЦенныеБумаги.ОценочнаяСумма - СтрокаЦенныеБумаги.БалансоваяСумма;
		
		Если СуммаПереоценки <> 0 Тогда
			
			СчетУчета = НастройкиУчетаАктива.СчетУчетаВЗалоге;
				
			СчетУчетаПереоценки = НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге;
				
			ВалютныйУчет = СчетУчета.Валютный;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета, "Переоценка ценной бумаги");
			
			Если СуммаПереоценки > 0 Тогда
				// дебет
				Если Не УчитыватьПереоценкуОтдельно Тогда
					Проводка.СчетДт = СчетУчета;
				Иначе
					Проводка.СчетДт = СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаДт = СуммаПереоценки;
					Проводка.ВалютаДт = ВалютаНоминала;
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтПереоценки;
				Проводка.СубконтоКт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
			Иначе
				Проводка.Сумма = -Проводка.Сумма;
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтПереоценки;
				Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				// кредит
				Если Не УчитыватьПереоценкуОтдельно Тогда
					Проводка.СчетКт = СчетУчета;
				Иначе
					Проводка.СчетКт = СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = - СуммаПереоценки;
					Проводка.ВалютаКт = ВалютаНоминала;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
		
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			И СуммаПереоценкиКупона <> 0
		Тогда
		
			СчетУчета = НастройкиУчетаАктиваКупон.СчетУчетаВЗалоге;
				
			СчетУчетаПереоценки = НастройкиУчетаАктиваКупон.СчетУчетаПереоценкиВЗалоге;
				
			ВалютныйУчет = СчетУчета.Валютный;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаПереоценкиКупонаВВалютеУчета, "Переоценка купона ценной бумаги");
			
			Если СуммаПереоценкиКупона > 0 Тогда
				// дебет
				Если Не УчитыватьПереоценкуОтдельноКупон Тогда
					Проводка.СчетДт = СчетУчета;
				Иначе
					Проводка.СчетДт = СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаДт = СуммаПереоценкиКупона;
					Проводка.ВалютаДт = ВалютаНоминала;
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктиваКупон.АналитикаДоходовОтПереоценки;
				Проводка.СубконтоКт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
			Иначе
				Проводка.Сумма = -Проводка.Сумма;
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктиваКупон.АналитикаДоходовОтПереоценки;
				Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаЦенныеБумаги.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				// кредит
				Если Не УчитыватьПереоценкуОтдельноКупон Тогда
					Проводка.СчетКт = СчетУчета;
				Иначе
					Проводка.СчетКт = СчетУчетаПереоценки;
				КонецЕсли;
				
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = - СуммаПереоценкиКупона;
					Проводка.ВалютаКт = ВалютаНоминала;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если  СтрокаЦенныеБумаги.Перекурсовать
			И ((СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости <> Неопределено)
				ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона <> Неопределено)
				ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки <> Неопределено)
				ИЛИ (СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> 0 И СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона <> Неопределено)) Тогда
		
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЦеннаяБумага, СтрокаЦенныеБумаги.Рынок,   
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыСтоимости, СтрокаЦенныеБумаги.СуммаКурсовойРазницыКупона, 
				СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценки, СтрокаЦенныеБумаги.СуммаКурсовойРазницыПереоценкиКупона);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаВЗалоге);
			СчетаУчета.Вставить(УчетныйАктивКупон.ИмяПредопределенныхДанных, НастройкиУчетаАктиваКупон.СчетУчетаВЗалоге);
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге);
			СчетаУчетаПереоценки.Вставить(УчетныйАктивКупон.ИмяПредопределенныхДанных, НастройкиУчетаАктиваКупон.СчетУчетаПереоценкиВЗалоге);
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
			АналитикаПерекурсовки.Вставить(УчетныйАктивКупон.ИмяПредопределенныхДанных, НастройкиУчетаАктиваКупон.АналитикаПерекурсовки);
				
			БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценкиКупленныеПоРЕПО(Объект, Отказ) 
	
	Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.БухгалтерскийУчет
		И ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета) Тогда
		Возврат;
	КонецЕсли;
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток КАК СтоимостьОстаток,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьВВалютеУчетаОстаток КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	ВЫРАЗИТЬ(БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2)) КАК ОценочнаяСуммаВВалютеУчета,
		|	ВЫРАЗИТЬ(БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьКупонаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2)) КАК ОценочнаяСуммаКупонаВВалютеУчета,
		|	ДокументСделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	УсловияСделокРЕПОСрезПоследних.СобственныйКурсОплаты КАК СобственныйКурсОплаты
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|			&ГраницаДня,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага.ВалютаНоминала = КурсыВалют.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК ДокументСделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|					ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия КАК Документ.ПоставкаЦенныхБумаг).Основание = ДокументСделкаРЕПО.Ссылка
		|				КОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия ССЫЛКА Документ.СделкаРЕПО
		|					ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия = ДокументСделкаРЕПО.Ссылка
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ГраницаДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок = УсловияСделокРЕПОСрезПоследних.Рынок
		|			И БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|			И (ДокументСделкаРЕПО.Ссылка = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО)
		|ГДЕ
		|	КурсыВалют.Период = &Период";
	
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("ГраницаДня", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтрокаПартииКупленныеПоРЕПО = РезультатЗапроса.Выбрать();
	
	Пока СтрокаПартииКупленныеПоРЕПО.Следующий() Цикл
		Если СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаВВалютеУчета
			И (СтрокаПартииКупленныеПоРЕПО.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации
				ИЛИ СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупонаВВалютеУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		//#378498: Отключили перекурсовку для рублевых сделок
		Если СтрокаПартииКупленныеПоРЕПО.ВалютаСделки = ВалютаУчета 
			ИЛИ СтрокаПартииКупленныеПоРЕПО.СобственныйКурсОплаты Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.БухПартииЦенныхБумагКупленныеПоРЕПО.Добавить();
		ВалютаНоминала = СтрокаПартииКупленныеПоРЕПО.ВалютаНоминала;
		
		Движение.ВидДвижения                  = ВидДвиженияНакопления.Приход;
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ЦеннаяБумага                 = СтрокаПартииКупленныеПоРЕПО.ЦеннаяБумага;
		Движение.Партия                       = СтрокаПартииКупленныеПоРЕПО.Партия;
		Движение.СтрокаПартии                 = СтрокаПартииКупленныеПоРЕПО.СтрокаПартии;
		Движение.Рынок                        = СтрокаПартииКупленныеПоРЕПО.Рынок;
		Движение.ВидУчета                     = ЭтотОбъект.ВидУчета;
		Движение.СтоимостьВВалютеУчета		  = СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаВВалютеУчета;
		Движение.СтоимостьКупонаВВалютеУчета = СтрокаПартииКупленныеПоРЕПО.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаПартииКупленныеПоРЕПО.БалансоваяСуммаКупонаВВалютеУчета;
		
		Если Движение.СтоимостьВВалютеУчета > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Движение.СтоимостьВВалютеУчета, "Курсовая разница");
			
			// кредит
			Проводка.СчетДт = ПланыСчетов .Основной.ПартииРЕПОПокупкаТело;
			
			Проводка.СубконтоДт.ЦенныеБумаги = Движение.ЦеннаяБумага;
			
			Проводка.ВалютаДт = ВалютаНоминала;
			
		ИначеЕсли Движение.СтоимостьВВалютеУчета < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], - Движение.СтоимостьВВалютеУчета, "Курсовая разница");
			
			// дебет
			Проводка.СчетКт = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Движение.ЦеннаяБумага;
			
			Проводка.ВалютаКт = ВалютаНоминала;
			
		КонецЕсли;
		
		Если Движение.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если Движение.СтоимостьКупонаВВалютеУчета > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Движение.СтоимостьКупонаВВалютеУчета, "Курсовая разница");
				
				// кредит
				Проводка.СчетДт = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				
				Проводка.СубконтоДт.ЦенныеБумаги = Движение.ЦеннаяБумага;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				
			ИначеЕсли Движение.СтоимостьКупонаВВалютеУчета < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], - Движение.СтоимостьКупонаВВалютеУчета, "Курсовая разница");
				
				// дебет
				Проводка.СчетКт = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				
				Проводка.СубконтоКт.ЦенныеБумаги = Движение.ЦеннаяБумага;
				
				Проводка.ВалютаКт = ВалютаНоминала;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет
		И НЕ ЗначениеЗаполнено(ЭтотОбъект.ВариантРасчетаОценочнойСтоимости) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен вариант расчета оценочной стоимости", ЭтотОбъект, "ВариантРасчетаОценочнойСтоимости",, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьДвиженияПоРегистру(ДвиженияРегистра)

	Если ДвиженияРегистра.Количество() > 0 Тогда
		ДвиженияРегистра.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьТЧПоОтличиям()
	
	#Область Поместим_движения_в_МВТ
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Рынок КАК Рынок,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.Переоценка КАК Переоценка,
		|	БухПартииЦенныхБумаг.ПереоценкаВСтоимости КАК ПереоценкаВСтоимости,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ИндексацияНоминала КАК ИндексацияНоминала,
		|	БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения КАК ИндексацияНоминалаЗаВремяВладения,
		|	БухПартииЦенныхБумаг.Стоимость КАК Стоимость,
		|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СтоимостьКупона,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВСтоимости КАК ПереоценкаКупонаВСтоимости,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета
		|ПОМЕСТИТЬ _БухПартииЦенныхБумаг
		|ИЗ
		|	&БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Рынок КАК Рынок,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВСтоимости) КАК ПереоценкаВСтоимости,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминала) КАК ИндексацияНоминала,
		|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения) КАК ИндексацияНоминалаЗаВремяВладения,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВСтоимости) КАК ПереоценкаКупонаВСтоимости,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета
		|ПОМЕСТИТЬ _Движения
		|ИЗ
		|	_БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.Рынок,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Партия КАК Партия,
		|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	СтоимостьПереоценки.Сумма КАК Сумма,
		|	СтоимостьПереоценки.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки
		|ПОМЕСТИТЬ _СтоимостьПереоценки
		|ИЗ
		|	&СтоимостьПереоценки КАК СтоимостьПереоценки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтоимостьПереоценки.Рынок,
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.Партия,
		|	СтоимостьПереоценки.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _БухПартииЦенныхБумаг");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("БухПартииЦенныхБумаг", Движения.БухПартииЦенныхБумаг.Выгрузить());
	Запрос.УстановитьПараметр("СтоимостьПереоценки", Движения.СтоимостьПереоценки.Выгрузить());
	Запрос.Выполнить();
	#КонецОбласти 
	
	ЦенныеБумагиТЗ = ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги;
	
	ТаблицаНовая = Документы.ПереоценкаЦенныхБумаг.ПолучитьТаблицуЦенныхБумагПоДвижениямДокумента(ЭтотОбъект, Ложь, Запрос.МенеджерВременныхТаблиц);
	Отличия = ПолучитьТаблицуОтличий(ЦенныеБумагиТЗ, ТаблицаНовая, Истина);
	
	ЭтотОбъект.ЦенныеБумаги.Очистить();
	
	Если Отличия <> Неопределено Тогда
		
		Для каждого СтрокаОтличия Из Отличия Цикл
			НоваяСтрока = ЭтотОбъект.ЦенныеБумаги.Добавить();
			СтрокаТЗ = ЦенныеБумагиТЗ[СтрокаОтличия.НомерСтроки-1];
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			НоваяСтрока.РучнаяКорректировка = Истина;
		КонецЦикла;		
		
	КонецЕсли; 
	
	ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

Процедура ЗаполнитьЦенныеБумагиПоДвижениям(ПерезаполнитьЦенныеБумаги, Отказ)

 	Если Не ПерезаполнитьЦенныеБумаги Или Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	Если Документы.ПереоценкаЦенныхБумаг.РазрешенаИнтерактивнаяРаботаСДокументом(ЭтотОбъект) Тогда
		ЗаполнитьТЧПоОтличиям();
		
		ЗаписатьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагКПолучению);
		ЗаписатьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагКупленныеПоРЕПО);
		ЗаписатьДвиженияПоРегистру(Движения.БухПартииЦенныхБумагПроданныеВРепо);
		ЗаписатьДвиженияПоРегистру(Движения[РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета)]);
		ЗаписатьДвиженияПоРегистру(Движения.БухПартииЦенныхБумаг);
		ЗаписатьДвиженияПоРегистру(Движения.СтоимостьПереоценки);
	Иначе
		Движения.БухПартииЦенныхБумагКПолучению.Записывать = Истина;
		Движения.БухПартииЦенныхБумагКупленныеПоРЕПО.Записывать = Истина;
		Движения.БухПартииЦенныхБумагПроданныеВРепо.Записывать = Истина;
		Движения[РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета)].Записывать = Истина;
		Движения.БухПартииЦенныхБумаг.Записывать = Истина;
		Движения.СтоимостьПереоценки.Записывать = Истина;

		// а тут поставим блокировку!
		Блокировка = Новый БлокировкаДанных;
		
		ДиапазонБлокировки = Новый Диапазон(НачалоДня(ЭтотОбъект.Дата), КонецДня(ЭтотОбъект.Дата));
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СтоимостьПереоценки");
		ЭлементБлокировки.УстановитьЗначение("Период", ДиапазонБлокировки);
		ЭлементБлокировки.УстановитьЗначение("Организация", ЭтотОбъект.Организация);
		ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировки.УстановитьЗначение("ЦельРасчета", БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета));
		ЭлементБлокировки.УстановитьЗначение("ВидУчета", ЭтотОбъект.ВидУчета);
		ЭлементБлокировки.УстановитьЗначение("ВидЦеныОценки", Перечисления.ВидыЦенОценки.ЦенаПереоценки);

		Блокировка.Заблокировать();
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область КОНТРОЛЬ

Функция КонтрольЗаполнения(ИсточникИсходнойТаблицы, СверяемыеКолонки = "") Экспорт
	
	НачатьТранзакцию();
	
	#Область Очистка_дат_запрета
	
	ДатыЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
	
	ДатыЗапретаРедактирования.Отбор.Организация.Установить(ЭтотОбъект.Организация);
	ДатыЗапретаРедактирования.Отбор.СчетДоверительногоУправления.Установить(ЭтотОбъект.СчетДоверительногоУправления);
	ДатыЗапретаРедактирования.Отбор.ВидУчета.Установить(ЭтотОбъект.ВидУчета);
	
	ДатыЗапретаРедактирования.Записать();
	
	#КонецОбласти 
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("КонтрольЗаполнения");
	ЭтотОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	Попытка
		РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(ЭтотОбъект, , Отказ);
		ТаблицаНовая = ЭтотОбъект.ЦенныеБумаги.Выгрузить();
		ТаблицаНовая.Колонки.Удалить("РучнаяКорректировка");
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ОтменитьТранзакцию();
	
	Если Отказ Тогда
		Возврат ОписаниеОшибки;
	КонецЕсли; 
	
	Отличия = ПолучитьТаблицуОтличий(ИсточникИсходнойТаблицы, ТаблицаНовая,, СверяемыеКолонки);
	
	Если Отличия = Неопределено Тогда
		
		Возврат Новый ТабличныйДокумент;
		
	Иначе
		
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, Отличия, , , , Истина);    
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
		
		Возврат ПараметрыВывода.ДокументРезультат;       
		
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьТаблицуОтличий(ИсточникИсходнойТаблицы, ТаблицаНовая, ИсключитьПроценты = Ложь, СверяемыеКолонки = "")
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумагЦенныеБумаги.Поле
		|ПОМЕСТИТЬ _ТаблицаИсходная
		|ИЗ
		|	&ТаблицаИсходная КАК ПереоценкаЦенныхБумагЦенныеБумаги
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумагЦенныеБумаги.Поле
		|ПОМЕСТИТЬ _ТаблицаНовая
		|ИЗ
		|	&ТаблицаНовая КАК ПереоценкаЦенныхБумагЦенныеБумаги
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	ЕСТЬNULL(_ТаблицаИсходная.НомерСтроки, 0) КАК НомерСтроки,
		|	&Измерения,
		|	&ПрочиеПоля
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_ТаблицаИсходная КАК _ТаблицаИсходная
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ТаблицаНовая КАК _ТаблицаНовая
		|		ПО &Соединения
		|ГДЕ
		|	&Условия";
	
	Если ТипЗнч(ИсточникИсходнойТаблицы) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
			"&ТаблицаИсходная КАК ПереоценкаЦенныхБумагЦенныеБумаги", 
			"Документ.ПереоценкаЦенныхБумаг.ЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
			|ГДЕ
			|	ПереоценкаЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка");
	
	Иначе
		
		Запрос.УстановитьПараметр("ТаблицаИсходная", ИсточникИсходнойТаблицы);
		
	КонецЕсли; 
	
	ВсеКолонки = Новый ТаблицаЗначений;
	ВсеКолонки.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ВсеКолонки.Колонки.Добавить("Измерение", Новый ОписаниеТипов("Булево"));
	
	СтрокаИзмерения = "Рынок,ЦеннаяБумага,Партия,СтрокаПартии";
	
	Измерения = СтрРазделить(СтрокаИзмерения, ",");
	
	Если СверяемыеКолонки <> "" Тогда
		СверяемыеКолонки = СверяемыеКолонки + ", НомерСтроки, "	+ СтрокаИзмерения;
	КонецЕсли;
	
	Для Каждого Колонка Из ТаблицаНовая.Колонки Цикл 
		
		Если Колонка.Имя = "РучнаяКорректировка" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИсключитьПроценты И СтрНайти(Колонка.Имя, "ЦенаПроцент") > 0 Тогда
			// поле из анализа исключаем, т.к. проценты рассчитываются от цен, возможны расхождения из-за округлений
			Продолжить;
		КонецЕсли; 
		
		Если СверяемыеКолонки <> "" И СтрНайти(СверяемыеКолонки, Колонка.Имя) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ВсеКолонки.Добавить();
		НоваяСтрока.Имя       = Колонка.Имя;
		НоваяСтрока.Измерение = Не (Измерения.Найти(Колонка.Имя) = Неопределено);
	КонецЦикла;
	
	// заполняем поля таблиц
	ВсеПоля = ВсеКолонки.ВыгрузитьКолонку("Имя");
	
	Для Инд = 0 По ВсеПоля.ВГраница() Цикл // чтобы запрос в конструкторе открывался
		ВсеПоля[Инд] = "ПереоценкаЦенныхБумагЦенныеБумаги." + ВсеПоля[Инд];
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаЦенныхБумагЦенныеБумаги.Поле", СтрСоединить(ВсеПоля, ", " + Символы.ПС + Символы.Таб)); 
	
	// заполняем измерения и соединения итоговой таблицы
	ПоляИзмерений = "";
	УсловияСоединений = "";
	Для Каждого Измерение Из Измерения Цикл
		ПоляИзмерений = ПоляИзмерений + СтрШаблон("ЕСТЬNULL(_ТаблицаИсходная.%1, _ТаблицаНовая.%1) КАК %1," + Символы.ПС, Измерение);
		УсловияСоединений = УсловияСоединений + СтрШаблон("И _ТаблицаИсходная.%1 = _ТаблицаНовая.%1" + Символы.ПС, Измерение);
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Измерения,", ПоляИзмерений); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Соединения", Сред(УсловияСоединений, 2)); 
	
	// заполняем остальные поля и условия
	ПрочиеПоля = "";
	Условия = "";
	Итоги = "";
	
	Для Каждого Колонка ИЗ ВсеКолонки Цикл
		
		Если Не Колонка.Измерение И Не Колонка.Имя = "НомерСтроки" И Не Колонка.Имя = "РучнаяКорректировка" Тогда
			
			ПрочиеПоля = ПрочиеПоля + 
				СтрШаблон("_ТаблицаИсходная.%1 <> _ТаблицаНовая.%1 КАК %1_ЕстьОтличия," + Символы.ПС, Колонка.Имя) + 
				СтрШаблон("_ТаблицаИсходная.%1 КАК %1_До," + Символы.ПС, Колонка.Имя) + 
				СтрШаблон("_ТаблицаНовая.%1 КАК %1_После," + Символы.ПС, Колонка.Имя);
			
			Условия = Условия + СтрШаблон("ИЛИ (_ТаблицаИсходная.%1 <> _ТаблицаНовая.%1)" + Символы.ПС, Колонка.Имя);
			
			Итоги = Итоги + СтрШаблон("МАКСИМУМ(_ИтоговаяТаблица.%1_ЕстьОтличия) КАК %1_ЕстьОтличия," + Символы.ПС, Колонка.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПрочиеПоля", Лев(ПрочиеПоля, СтрДлина(ПрочиеПоля)-2)); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", Сред(Условия, 4)); 
	
	Запрос.УстановитьПараметр("Ссылка", ИсточникИсходнойТаблицы);
	Запрос.УстановитьПараметр("ТаблицаНовая", ТаблицаНовая);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Первые 1 Рынок ИЗ _ИтоговаяТаблица";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ " + Лев(Итоги, СтрДлина(Итоги)-2) + " ИЗ _ИтоговаяТаблица _ИтоговаяТаблица";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		ПоляТаблицыОтличий = "";
		
		Если Выборка.Следующий() Тогда
			
			Для каждого Колонка Из Результат.Колонки Цикл
				
				Если Выборка[Колонка.Имя] Тогда
					
					ПоляТаблицыОтличий = ПоляТаблицыОтличий + 
						СтрШаблон("_ИтоговаяТаблица.%1 КАК %1," + Символы.ПС, Колонка.Имя) + 
						СтрШаблон("_ИтоговаяТаблица.%1 КАК %1," + Символы.ПС, СтрЗаменить(Колонка.Имя, "_ЕстьОтличия", "_До")) + 
						СтрШаблон("_ИтоговаяТаблица.%1 КАК %1," + Символы.ПС, СтрЗаменить(Колонка.Имя, "_ЕстьОтличия", "_После"));
					
				КонецЕсли; 
				
			КонецЦикла;                   
			
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
			|	_ИтоговаяТаблица.Рынок КАК Рынок,
			|	_ИтоговаяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ИтоговаяТаблица.Партия КАК Партия,
			|	_ИтоговаяТаблица.СтрокаПартии КАК СтрокаПартии,
			|	&ПоляТаблицыОтличий КАК ПоляТаблицыОтличий
			|ИЗ
			|	_ИтоговаяТаблица КАК _ИтоговаяТаблица";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицыОтличий КАК ПоляТаблицыОтличий", Лев(ПоляТаблицыОтличий, СтрДлина(ПоляТаблицыОтличий) - 2));
		
		Отличия = Запрос.Выполнить().Выгрузить();
		
		Возврат Отличия;                          
		
	КонецЕсли; 
	
КонецФункции

#КонецОбласти

Процедура СвернутьПарныеСчетаДоходовРасходовКорректировкиСНГ(ЭтотОбъект, МассивУчетныхАктивов, Отказ)

	Движения.ЕдиныйБухгалтерскийУчет.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы05) КАК СчетП,
		|	ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы06) КАК СчетА,
		|	УчетныеАктивыЕПС.АналитикаДоходовОтКорректировки КАК АналитикаП,
		|	УчетныеАктивыЕПС.АналитикаРасходовОтКорректировки КАК АналитикаА
		|ПОМЕСТИТЬ _ПарныеСчета
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	УчетныеАктивыЕПС.Ссылка В(&МассивУчетныхАктивов)
		|	И УчетныеАктивыЕПС.АналитикаДоходовОтКорректировки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|	И УчетныеАктивыЕПС.АналитикаРасходовОтКорректировки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Аналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			,
		|			&МассивСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПарныеСчета КАК ПарныеСчета
		|		ПО (ПарныеСчета.АналитикаП = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|				ИЛИ ПарныеСчета.АналитикаА = ЕдиныйБухгалтерскийУчетОстатки.Субконто1)
		|			И (ПарныеСчета.СчетП = ЕдиныйБухгалтерскийУчетОстатки.Счет
		|				ИЛИ ПарныеСчета.СчетА = ЕдиныйБухгалтерскийУчетОстатки.Счет)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПарныеСчета.СчетП КАК СчетП,
		|	_ПарныеСчета.СчетА КАК СчетА,
		|	_ПарныеСчета.АналитикаП КАК АналитикаП,
		|	_ПарныеСчета.АналитикаА КАК АналитикаА,
		|	_Остатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	-ЕСТЬNULL(_ОстаткиП.СуммаОстаток, 0) КАК СуммаОстатокП,
		|	ЕСТЬNULL(_ОстаткиА.СуммаОстаток, 0) КАК СуммаОстатокА
		|ИЗ
		|	_ПарныеСчета КАК _ПарныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Остатки КАК _Остатки
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Остатки КАК _ОстаткиА
		|		ПО _ПарныеСчета.СчетА = _ОстаткиА.Счет
		|			И _ПарныеСчета.АналитикаА = _ОстаткиА.Аналитика
		|			И (_Остатки.ЦеннаяБумага = _ОстаткиА.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Остатки КАК _ОстаткиП
		|		ПО _ПарныеСчета.СчетП = _ОстаткиП.Счет
		|			И _ПарныеСчета.АналитикаП = _ОстаткиП.Аналитика
		|			И (_Остатки.ЦеннаяБумага = _ОстаткиП.ЦеннаяБумага)
		|ГДЕ
		|	(ЕСТЬNULL(_ОстаткиП.СуммаОстаток, 0) <> 0
		|				И ЕСТЬNULL(_ОстаткиА.СуммаОстаток, 0) <> 0
		|			ИЛИ ЕСТЬNULL(_ОстаткиП.СуммаОстаток, 0) > 0
		|			ИЛИ ЕСТЬNULL(_ОстаткиА.СуммаОстаток, 0) < 0)";
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("МассивСубконто", МассивСубконто);
	Запрос.УстановитьПараметр("МассивУчетныхАктивов", МассивУчетныхАктивов);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СуммаОстатокА <> 0 И ВыборкаДетальныеЗаписи.СуммаОстатокП <> 0 Тогда
			
			СуммаПроводки = Мин(ВыборкаДетальныеЗаписи.СуммаОстатокА, ВыборкаДетальныеЗаписи.СуммаОстатокП);
			ПроводкаПереброски = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПроводки, "Закрытие парных счетов доходов/расходов от корректировки");
			
			ПроводкаПереброски.СчетДт = ВыборкаДетальныеЗаписи.СчетП;
			ПроводкаПереброски.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			ПроводкаПереброски.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.АналитикаП;
			
			ПроводкаПереброски.СчетКт = ВыборкаДетальныеЗаписи.СчетА;
			ПроводкаПереброски.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			ПроводкаПереброски.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.АналитикаА;
		
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры
