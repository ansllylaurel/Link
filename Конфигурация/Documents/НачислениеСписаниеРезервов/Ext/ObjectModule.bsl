Функция ПолучитьАктивыСДефолтнымРейтингом()
	
	ТаблицаОблигацийВДефолтеХардкодом = Новый ТаблицаЗначений;
	ТаблицаОблигацийВДефолтеХардкодом.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	
	// Строки
	СтрокаТаблицаОблигацийВДефолтеХардкодом = ТаблицаОблигацийВДефолтеХардкодом.Добавить();
	СтрокаТаблицаОблигацийВДефолтеХардкодом.Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаОблигацийВДефолтеХардкодом.Облигация КАК Облигация
		|ПОМЕСТИТЬ _ТаблицаОблигацийВДефолтеХардкодом
		|ИЗ
		|	&ТаблицаОблигацийВДефолтеХардкодом КАК ТаблицаОблигацийВДефолтеХардкодом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&День,
		|			Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Шкала.ДатаПереходаВАрхив > &День) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&День, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|ГДЕ
		|	СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления = 4
		|	И (РейтингиСрезПоследних.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДефолтыПоОблигациямСрезПоследних.Облигация
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|			&День,
		|			ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ИЛИ ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)) КАК ДефолтыПоОблигациямСрезПоследних
		|ГДЕ
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ТаблицаОблигацийВДефолтеХардкодом.Облигация
		|ИЗ
		|	_ТаблицаОблигацийВДефолтеХардкодом КАК _ТаблицаОблигацийВДефолтеХардкодом";
	
	Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ТаблицаОблигацийВДефолтеХардкодом", ТаблицаОблигацийВДефолтеХардкодом);
	
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Субъект");

КонецФункции

