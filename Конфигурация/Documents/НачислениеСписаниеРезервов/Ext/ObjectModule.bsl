		|				ИЛИ ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Договоры).Контрагент = БрокерскиеКомпании.ЮрФизЛицо)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&НКЦ,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства17),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты25),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) В (ТИП(Документ.ПогашениеКупона), ТИП(Документ.ПогашениеЦеннойБумаги))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Контрагент,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК АналитикаРезерва,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3 КАК ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК Сумма
		|ПОМЕСТИТЬ _ОстаткиНачисленныхРезервовПоДивидендам
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами24),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокументаРезервовНеЦБ.Актив КАК Актив,
		|	_ДанныеДокументаРезервовНеЦБ.АналитикаРезерва КАК АналитикаРезерва,
		|	_ДанныеДокументаРезервовНеЦБ.СуммаРезерваПартии КАК СуммаРезерва,
		|	ЕСТЬNULL(_ОстаткиНачисленныхРезервовПоДивидендам.АналитикаРезерва, ЕСТЬNULL(_ОстаткиНачисленныхРезервов.АналитикаРезерва, _ДанныеДокументаРезервовНеЦБ.АналитикаРезерва)) КАК АналитикаРезерваСтарая,
		|	ЕСТЬNULL(_ОстаткиНачисленныхРезервов.Сумма, 0) + ЕСТЬNULL(_ОстаткиНачисленныхРезервовПоДивидендам.Сумма, 0) КАК СуммаРезерваСтарая,
		|	_ДанныеДокументаРезервовНеЦБ.СуммаРезерваПартии + ЕСТЬNULL(_ОстаткиНачисленныхРезервов.Сумма, 0) + ЕСТЬNULL(_ОстаткиНачисленныхРезервовПоДивидендам.Сумма, 0) КАК ДвижениеРезерва
		|ПОМЕСТИТЬ _ДвиженияДляПроводок
		|ИЗ
		|	_ДанныеДокументаРезервовНеЦБ КАК _ДанныеДокументаРезервовНеЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНачисленныхРезервов КАК _ОстаткиНачисленныхРезервов
		|		ПО _ДанныеДокументаРезервовНеЦБ.Актив = _ОстаткиНачисленныхРезервов.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНачисленныхРезервовПоДивидендам КАК _ОстаткиНачисленныхРезервовПоДивидендам
		|		ПО (ВЫРАЗИТЬ(_ДанныеДокументаРезервовНеЦБ.Актив КАК Документ.НачислениеДивидендов).ЦеннаяБумага = _ОстаткиНачисленныхРезервовПоДивидендам.ЦеннаяБумага)";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НКЦ", ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ЭтотОбъект.Дата));

	Запрос.Выполнить();
	
	ДвиженияДляСтадий = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияДляСтадий"].ПолучитьДанные().Выгрузить();
	ДвиженияДляПартий = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияДляПартий"].ПолучитьДанные().Выгрузить();
	ДвиженияДляПроводокПоЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияДляПроводокПоЦБ"].ПолучитьДанные().Выгрузить();
	ДвиженияДляПроводок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияДляПроводок"].ПолучитьДанные().Выгрузить();

	//Если НЕ ЭтотОбъект.ПереходНаМСФО9 Тогда
	//	Для каждого ДвижениеДляСтадий Из ДвиженияДляСтадий Цикл
	//		ЗаполнитьЗначенияСвойств(Движения.СтадииОбесцененияАктивов.Добавить(), ДвижениеДляСтадий);
	//	КонецЦикла;
	//КонецЕсли;
	
	Для каждого ДвижениеДляПартий Из ДвиженияДляПартий Цикл
		ДвижениеПартий = Движения.БухПартииЦенныхБумаг.Добавить();
		ЗаполнитьЗначенияСвойств(ДвижениеПартий, ДвижениеДляПартий);
		ДвижениеПартий.Количество = 0;
	КонецЦикла;
	
	ДвиженияПроводок = ?(НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах, ДвиженияДляПартий, ДвиженияДляПроводокПоЦБ);
	
	Для каждого ДвижениеПроводок Из ДвиженияПроводок Цикл
		
		ЭтоАктивДляПродажи = (ДвижениеПроводок.УчетныйАктивЕПСРодитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи)
								ИЛИ (ДвижениеПроводок.УчетныйАктивЕПСРодитель = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
		
		ДвижениеРезерва = ДвижениеПроводок.СуммаРезервовПодОбесценение;
								
		ДанныеПроводки = Новый Структура();									
		
		ДанныеПроводки.Вставить("ЦеннаяБумага", ДвижениеПроводок.ЦеннаяБумага);
		ДанныеПроводки.Вставить("ЭтоАктивДляПродажи", ЭтоАктивДляПродажи);
		ДанныеПроводки.Вставить("ВалютаУчета", ВалютаУчета);
		ДанныеПроводки.Вставить("СчетУчетаРезервов", ДвижениеПроводок.СчетУчетаРезервов);
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
			ДанныеПроводки.Вставить("Партия", ДвижениеПроводок.Партия);
			ДанныеПроводки.Вставить("СтрокаПартии", ДвижениеПроводок.СтрокаПартии);
		КонецЕсли;
		
		Если ЭтоАктивДляПродажи Тогда
			ДанныеПроводки.Вставить("ГФУ106", БухгалтерскийУчетЕПС.ОпределитьГФУРезервовДляБумагДляПродажиНаСчете106(ДвижениеПроводок.УчетныйАктивЕПС));
		КонецЕсли;
		
		// нужно перебросить со старой аналитики на новую, кроме "для продажи" (у них резервирование отражается на переоценке)
		Если ДвижениеПроводок.АналитикаРезерваСтарая <> ДвижениеПроводок.АналитикаРезерва Тогда
		
			ДанныеПроводки.Вставить("СуммаРезерва", ДвижениеПроводок.СуммаРезерваСтарая);
			ДанныеПроводки.Вставить("АналитикаРезерва", ДвижениеПроводок.АналитикаРезерва);
			ДанныеПроводки.Вставить("АналитикаРезерваСтарая", ДвижениеПроводок.АналитикаРезерваСтарая);
			
			Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
				ДанныеПроводки.Вставить("ВалютаНоминала", ДвижениеПроводок.ВалютаНоминала);
				Если ЭтоАктивДляПродажи Тогда
					ДанныеПроводки.Вставить("СуммаРезерваВВалютеНоминала", ДвижениеПроводок.СуммаРезерваСтараяВВалютеНоминала);
				Иначе
					ДанныеПроводки.Вставить("СуммаРезерваВВалютеНоминала", ДвижениеПроводок.СуммаРезерваСтарая);
				КонецЕсли;
			КонецЕсли;
			
			СформироватьПроводкуПереброскиРезерваМеждуАналитиками(ДанныеПроводки, НастройкиУчета);
			
		КонецЕсли;
		
		ДанныеПроводки.Вставить("СуммаРезерва", ДвижениеРезерва);
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
			ДанныеПроводки.Вставить("ВалютаНоминала", ДвижениеПроводок.ВалютаНоминала);
			Если ЭтоАктивДляПродажи Тогда
				ДанныеПроводки.Вставить("СуммаРезерваВВалютеНоминала", ДвижениеПроводок.СуммаРезервовПодОбесценениеВВалютеНоминала);
			Иначе
				ДанныеПроводки.Вставить("СуммаРезерваВВалютеНоминала", ДвижениеРезерва);
			КонецЕсли;
		КонецЕсли;
		
		Если ДвижениеРезерва > 0 Тогда

			Если ЭтоАктивДляПродажи Тогда
				ДанныеПроводки.Вставить("ГФУ106", БухгалтерскийУчетЕПС.ОпределитьГФУРезервовДляБумагДляПродажиНаСчете106(ДвижениеПроводок.УчетныйАктивЕПС));
			КонецЕсли;
			
			ДанныеПроводки.Вставить("СчетУчетаДоходовРасходов", ПланыСчетов.Единый.НайтиПоКоду(ДвижениеПроводок.НомерСчетаУчетаРасходов));
			ДанныеПроводки.Вставить("АналитикаДоходовРасходов", ДвижениеПроводок.ГФУПриНачислении);
			ДанныеПроводки.Вставить("АналитикаРезерва", ДвижениеПроводок.АналитикаРезерва);	
			
		ИначеЕсли ДвижениеРезерва < 0 Тогда

			Если ЭтоАктивДляПродажи Тогда
				ДанныеПроводки.Вставить("ГФУ106", БухгалтерскийУчетЕПС.ОпределитьГФУРезервовДляБумагДляПродажиНаСчете106(ДвижениеПроводок.УчетныйАктивЕПС, Ложь));
			КонецЕсли;
			
			ДанныеПроводки.Вставить("СчетУчетаДоходовРасходов", ПланыСчетов.Единый.НайтиПоКоду(ДвижениеПроводок.НомерСчетаУчетаДоходов));
			ДанныеПроводки.Вставить("АналитикаДоходовРасходов", ДвижениеПроводок.ГФУПриСписании);
			ДанныеПроводки.Вставить("АналитикаРезерва", ДвижениеПроводок.АналитикаРезерва);	
			
		КонецЕсли;
		
		Если ДвижениеРезерва <> 0 Тогда
			СформироватьПроводкуНачисленияСписанияРезерва(ДанныеПроводки, НастройкиУчета);
		КонецЕсли;
		
	КонецЦикла;
	
	АналитикиНачисленияРезервов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "АналитикаНачисленияРезервов");
	АналитикиСписанияРезервов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "АналитикаСписанияРезервов");
	
	Для Каждого ДвижениеДляПроводок Из ДвиженияДляПроводок Цикл
			
		СчетУчетаРезервов = Неопределено;
		ДополнительнаяАналитикаУчетаРезервов = Неопределено;
		
		МассивСубконто = Новый Массив();
		
		Если ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			
			УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(ДвижениеДляПроводок.Актив, ЭтотОбъект.Дата);
			
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады, ДвижениеДляПроводок.Актив));
			
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
			
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДенежныеСредстваНаРасчетномСчете;
			
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета, ДвижениеДляПроводок.Актив));
			
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.МНО") Тогда
			
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО;
			
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета, ДвижениеДляПроводок.Актив.РасчетныйСчет));
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов, ДвижениеДляПроводок.Актив));
			
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("СправочникСсылка.Биржи")
			ИЛИ ДвижениеДляПроводок.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ") Тогда
			
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДенежныеСредстваУБрокера; // тут пока не понятно, это средства под биржевые депозиты
			
			СчетУчетаРезервов = ПланыСчетов.Единый.СчетаДляКлиринга10;

		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
			
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДенежныеСредстваУБрокера;
			
			МассивСубконто.Добавить(
				Новый Структура("ВидСубконто, ЗначениеСубконто", 
					ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания, 
					БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ДвижениеДляПроводок.Актив, ЭтотОбъект.Дата)));
					
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ПроцентыПоРЕПО;
			
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, ДвижениеДляПроводок.Актив.Контрагент));
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов, ДвижениеДляПроводок.Актив));
			
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.ПогашениеКупона")
			ИЛИ ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда

			ИмяРеквизитаОблигации = ?(ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.ПогашениеКупона"), "Облигация", "ЦеннаяБумага");
			Облигация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДвижениеДляПроводок.Актив, ИмяРеквизитаОблигации);
			ДанныеОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Облигация, "Эмитент, УчетныйАктивЦБРФ");
			
			// если задолженность на счетах 5ХХ то и резервы там же, а задолженность вешается при настройке по купону и частичному телу (амортизации номинала)
			Если НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов 
				И (ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.ПогашениеКупона")
					ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДвижениеДляПроводок.Актив, "ВидПогашения") = Перечисления.ВидыПогашения.ЧастичноеПогашение)
			Тогда
				
				Если ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияРФ;
				ИначеЕсли ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияСубьектовРФ;
				ИначеЕсли ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияКредитныхОрганизаций;
				ИначеЕсли ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов;
				ИначеЕсли ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияБанковНерезидентов;
				ИначеЕсли ДанныеОблигации.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
					УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихНерезидентов;
				КонецЕсли;

				Если ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
					ДополнительнаяАналитикаУчетаРезервов = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РезервПоЗадолженностиПоПогашениюКупона;	
				Иначе	
					ДополнительнаяАналитикаУчетаРезервов = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РезервПоЗадолженностиПоПогашениюТела;
				КонецЕсли;
				
				МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги, Облигация));
				
			Иначе // а иначе на 47425

				УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
				
				Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОблигации.Эмитент, "ЮрФизЛицо");
				
				МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, Контрагент));
				МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов, ДвижениеДляПроводок.Актив));
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
					
			СчетУчетаРезервов = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами24;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
			
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги, ДвижениеДляПроводок.Актив.ЦеннаяБумага));
			МассивСубконто.Добавить(Новый Структура("ВидСубконто, ЗначениеСубконто", ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, ДвижениеДляПроводок.Актив.ЦеннаяБумага.Эмитент.ЮрФизЛицо));
			
		Иначе
			Продолжить;
		КонецЕсли;

		Если СчетУчетаРезервов = Неопределено Тогда
			СчетУчетаРезервов = УчетныйАктив.СчетУчетаРезервов;
		КонецЕсли;
		
		АналитикаНачисленияРезервов = Неопределено;
		Если НЕ АналитикиНачисленияРезервов.Свойство(УчетныйАктив.ИмяПредопределенныхДанных, АналитикаНачисленияРезервов)
			ИЛИ НЕ ЗначениеЗаполнено(АналитикаНачисленияРезервов) Тогда
			
			АналитикаНачисленияРезервов = УчетныйАктив.АналитикаНачисленияРезервов;
		КонецЕсли;
		
		АналитикаСписанияРезервов = Неопределено;
		Если НЕ АналитикиСписанияРезервов.Свойство(УчетныйАктив.ИмяПредопределенныхДанных, АналитикаСписанияРезервов)
			ИЛИ НЕ ЗначениеЗаполнено(АналитикаСписанияРезервов) Тогда
			
			АналитикаСписанияРезервов = УчетныйАктив.АналитикаСписанияРезервов;
		КонецЕсли;

		СчетРасходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаНачисленияРезервов.НомерСчетаБухгалтерскогоУчета);
		СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
		
		// нужно перебросить со старой аналитики на новую
		Если ДвижениеДляПроводок.АналитикаРезерваСтарая <> ДвижениеДляПроводок.АналитикаРезерва
			И ДвижениеДляПроводок.СуммаРезерваСтарая <> 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, -ДвижениеДляПроводок.СуммаРезерваСтарая, "Переброска резерва");	
			
			Проводка.СчетДт							= СчетУчетаРезервов;
			Проводка.СубконтоДт.Резервы				= ДвижениеДляПроводок.АналитикаРезерваСтарая;
			Проводка.ВалютаДт						= ВалютаУчета;
			Проводка.ВалютнаяСуммаДт				= -ДвижениеДляПроводок.СуммаРезерваСтарая;
			
			Проводка.СчетКт							= СчетУчетаРезервов;
			Проводка.СубконтоКт.Резервы				= ДвижениеДляПроводок.АналитикаРезерва;
			Проводка.ВалютаКт						= ВалютаУчета;
			Проводка.ВалютнаяСуммаКт				= -ДвижениеДляПроводок.СуммаРезерваСтарая;
			
			Для каждого СтрокаМассивСубконто Из МассивСубконто Цикл
				Проводка.СубконтоДт[СтрокаМассивСубконто.ВидСубконто] = СтрокаМассивСубконто.ЗначениеСубконто;
				Проводка.СубконтоКт[СтрокаМассивСубконто.ВидСубконто] = СтрокаМассивСубконто.ЗначениеСубконто;
			КонецЦикла;
			
			Если ДополнительнаяАналитикаУчетаРезервов <> Неопределено Тогда
				Проводка.ДополнительнаяАналитикаДт = ДополнительнаяАналитикаУчетаРезервов;
				Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитикаУчетаРезервов;
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ДвижениеДляПроводок.ДвижениеРезерва > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДвижениеДляПроводок.ДвижениеРезерва, "Формирование резерва");	
			
			Если ЭтотОбъект.ПереходНаМСФО9 Тогда
				Проводка.СчетДт												= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры								= ЭтотОбъект.СчетДоверительногоУправления;
			Иначе					
				Проводка.СчетДт												= СчетРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов	= АналитикаНачисленияРезервов;
				Если ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
					Проводка.СубконтоДт.ЦенныеБумаги							= ДвижениеДляПроводок.Актив.ЦеннаяБумага;
				Иначе
					Проводка.СубконтоДт.ЦенныеБумаги							= ДвижениеДляПроводок.Актив;
				КонецЕсли;	
			КонецЕсли;
			
			Проводка.СчетКт							= СчетУчетаРезервов;
			Проводка.СубконтоКт.Резервы				= ДвижениеДляПроводок.АналитикаРезерва;
			Проводка.ВалютаКт						= ВалютаУчета;
			Проводка.ВалютнаяСуммаКт				= ДвижениеДляПроводок.ДвижениеРезерва;

			Для каждого СтрокаМассивСубконто Из МассивСубконто Цикл
				Проводка.СубконтоКт[СтрокаМассивСубконто.ВидСубконто] = СтрокаМассивСубконто.ЗначениеСубконто;
			КонецЦикла;
			
			Если ДополнительнаяАналитикаУчетаРезервов <> Неопределено Тогда
				Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитикаУчетаРезервов;
			КонецЕсли;
			
		ИначеЕсли ДвижениеДляПроводок.ДвижениеРезерва < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, -ДвижениеДляПроводок.ДвижениеРезерва, "Списание резерва");	
			
			Проводка.СчетДт							= СчетУчетаРезервов;
			Проводка.СубконтоДт.Резервы				= ДвижениеДляПроводок.АналитикаРезерва;
			Проводка.ВалютаДт						= ВалютаУчета;
			Проводка.ВалютнаяСуммаДт				= -ДвижениеДляПроводок.ДвижениеРезерва;
			
			Если ЭтотОбъект.ПереходНаМСФО9 Тогда
				Проводка.СчетКт												= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры								= ЭтотОбъект.СчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт												= СчетДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= АналитикаСписанияРезервов;
				Если ТипЗнч(ДвижениеДляПроводок.Актив) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
					Проводка.СубконтоКт.ЦенныеБумаги							= ДвижениеДляПроводок.Актив.ЦеннаяБумага;
				Иначе
					Проводка.СубконтоКт.ЦенныеБумаги							= ДвижениеДляПроводок.Актив;
				КонецЕсли;	
			КонецЕсли;
			
			Для каждого СтрокаМассивСубконто Из МассивСубконто Цикл
				Проводка.СубконтоДт[СтрокаМассивСубконто.ВидСубконто] = СтрокаМассивСубконто.ЗначениеСубконто;
			КонецЦикла;
			
			Если ДополнительнаяАналитикаУчетаРезервов <> Неопределено Тогда
				Проводка.ДополнительнаяАналитикаДт = ДополнительнаяАналитикаУчетаРезервов;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПроведениеПоРегиструЕПС

Процедура СформироватьПроводкуПереброскиРезерваМеждуАналитиками(ДанныеПроводки, НастройкиУчета)

	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДанныеПроводки.СуммаРезерва, "Переброска резерва");	
	
	
	Проводка.СчетДт = ДанныеПроводки.СчетУчетаРезервов;
	
	Проводка.СубконтоДт.ЦенныеБумаги	= ДанныеПроводки.ЦеннаяБумага;
	Проводка.СубконтоДт.Резервы			= ДанныеПроводки.АналитикаРезерваСтарая;
	Проводка.ВалютаДт					= ДанныеПроводки.ВалютаУчета;
	Проводка.ВалютнаяСуммаДт			= ДанныеПроводки.СуммаРезерва;
	
	
	Проводка.СчетКт = ДанныеПроводки.СчетУчетаРезервов;
	
	Проводка.СубконтоКт.ЦенныеБумаги	= ДанныеПроводки.ЦеннаяБумага;
	Проводка.СубконтоКт.Резервы			= ДанныеПроводки.АналитикаРезерва;
	Проводка.ВалютаКт					= ДанныеПроводки.ВалютаУчета;
	Проводка.ВалютнаяСуммаКт			= ДанныеПроводки.СуммаРезерва;
	
	Если ДанныеПроводки.ЭтоАктивДляПродажи Тогда
		
	    Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.ГФУ106;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.ГФУ106;
	
	КонецЕсли;
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		Проводка.Партия					= ДанныеПроводки.Партия;
		Проводка.СтрокаПартии			= ДанныеПроводки.СтрокаПартии;
	
	КонецЕсли;

	Если ДанныеПроводки.Свойство("ВалютаНоминала") И ДанныеПроводки.Свойство("СуммаРезерваВВалютеНоминала") Тогда
	
		Проводка.ВалютаДт					= ДанныеПроводки.ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт			= ДанныеПроводки.СуммаРезерваВВалютеНоминала;
			
		Проводка.ВалютаКт					= ДанныеПроводки.ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт			= ДанныеПроводки.СуммаРезерваВВалютеНоминала;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкуНачисленияСписанияРезерва(ДанныеПроводки, НастройкиУчета)

	Если ДанныеПроводки.СуммаРезерва > 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДанныеПроводки.СуммаРезерва, "Формирование резерва");	
		
		Если ЭтотОбъект.ПереходНаМСФО9 Тогда
			Проводка.СчетДт												= ПланыСчетов.Единый.АктивыВДУ03;
			
			Проводка.СубконтоДт.Договоры								= ЭтотОбъект.СчетДоверительногоУправления;
		Иначе					
			Проводка.СчетДт = ДанныеПроводки.СчетУчетаДоходовРасходов;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.АналитикаДоходовРасходов;
			Проводка.СубконтоДт.ЦенныеБумаги							= ДанныеПроводки.ЦеннаяБумага;
		КонецЕсли;

		
		Проводка.СчетКт = ДанныеПроводки.СчетУчетаРезервов;
		
		Проводка.СубконтоКт.ЦенныеБумаги								= ДанныеПроводки.ЦеннаяБумага;
		Проводка.СубконтоКт.Резервы										= ДанныеПроводки.АналитикаРезерва;
		Если ДанныеПроводки.ЭтоАктивДляПродажи Тогда
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.ГФУ106; // счета 10Х
		КонецЕсли;
		
		Если ДанныеПроводки.Свойство("ВалютаНоминала") И ДанныеПроводки.Свойство("СуммаРезерваВВалютеНоминала") Тогда
			Проводка.ВалютаКт					= ДанныеПроводки.ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт			= ДанныеПроводки.СуммаРезерваВВалютеНоминала;
		Иначе
			Проводка.ВалютаКт			= ДанныеПроводки.ВалютаУчета;
			Проводка.ВалютнаяСуммаКт	= ДанныеПроводки.СуммаРезерва;
		КонецЕсли;
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
		
			Проводка.Партия			= ДанныеПроводки.Партия;
			Проводка.СтрокаПартии	= ДанныеПроводки.СтрокаПартии;
		
		КонецЕсли;
	
	ИначеЕсли ДанныеПроводки.СуммаРезерва < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, -ДанныеПроводки.СуммаРезерва, "Списание резерва");	
		
		
		Проводка.СчетДт = ДанныеПроводки.СчетУчетаРезервов;
		
		Проводка.СубконтоДт.ЦенныеБумаги 								= ДанныеПроводки.ЦеннаяБумага;
		Проводка.СубконтоДт.Резервы										= ДанныеПроводки.АналитикаРезерва; 		
		Если ДанныеПроводки.ЭтоАктивДляПродажи Тогда
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.ГФУ106; // счета 10Х
		КонецЕсли;
		
		Если ДанныеПроводки.Свойство("ВалютаНоминала") И ДанныеПроводки.Свойство("СуммаРезерваВВалютеНоминала") Тогда
			Проводка.ВалютаДт					= ДанныеПроводки.ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт			= -ДанныеПроводки.СуммаРезерваВВалютеНоминала;
		Иначе
			Проводка.ВалютаДт			= ДанныеПроводки.ВалютаУчета;
			Проводка.ВалютнаяСуммаДт	= -ДанныеПроводки.СуммаРезерва;
		КонецЕсли;
		
		Если ЭтотОбъект.ПереходНаМСФО9 Тогда
			Проводка.СчетКт												= ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры								= ЭтотОбъект.СчетДоверительногоУправления;
		Иначе
			Проводка.СчетКт = ДанныеПроводки.СчетУчетаДоходовРасходов;
			
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= ДанныеПроводки.АналитикаДоходовРасходов;
			Проводка.СубконтоКт.ЦенныеБумаги							= ДанныеПроводки.ЦеннаяБумага;
		КонецЕсли;
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
		
			Проводка.Партия			= ДанныеПроводки.Партия;
			Проводка.СтрокаПартии	= ДанныеПроводки.СтрокаПартии;
		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Возврат; // пока нет
		
КонецПроцедуры // ПроведениеПоРегиструБухгалтерии

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ И ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
		РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
	
		РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
		
	ИначеЕсли ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		
		ПроведениеПоРегиструЕПС(Отказ);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	Если ЭтотОбъект.ПереходНаМСФО9 Тогда
		ЭтотОбъект.Дата = НачалоДня(ЭтотОбъект.Дата) + 1;	
	КонецЕсли;

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Для каждого СтрокаПартии Из Партии Цикл
	
		Если Документы.НачислениеСписаниеРезервов.ДопустимыеТипыАктивов().Найти(ТипЗнч(СтрокаПартии.Актив)) = Неопределено Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Начисление/списание резерва по активу " + СокрЛП(СтрокаПартии.Актив) + " не поддерживается", ЭтотОбъект,,, Отказ);
			Возврат;
		
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОБЩИЕ_ПроцедурыФункцииРасчетов

Процедура ЗаполнитьРезервы(Отказ, ДанныеРасчета = Неопределено, ТолькоПоступившиеАктивы = Ложь) Экспорт
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	// Письмо Атомов Ф02-03/54/25 от 14.02.2025, у них начальные остатки не конец 31.12.24, а утро 01.01.25
	Если ЭтотОбъект.ПереходНаМСФО9 И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков <> Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда // резервы на 31.12.24 считаем
		ЭтотОбъект.Дата = ЭтотОбъект.Дата - 24 * 60 * 60;
	КонецЕсли;
	
	Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда
		
		Если НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Эволюция Тогда
			
			ЗаполнитьРезервыЭволюция(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Эволюция2025 Тогда
			
			ЗаполнитьРезервыЭволюция2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Гефест Тогда
			
			ЗаполнитьРезервыГефест(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.СНГ Тогда
			
			ЗаполнитьРезервыСНГ(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Ростех Тогда
			
			ЗаполнитьРезервыРостех(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда
			
			ЗаполнитьРезервыАтомгарант(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Сбербанк Тогда
			
			ЗаполнитьРезервыСбербанк(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ВолгаКапитал Тогда
			
			ЗаполнитьРезервыВолгаКапитал(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Аквилон Тогда
			
			ЗаполнитьРезервыАквилон(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Транснефть Тогда
			
			ЗаполнитьРезервыТранснефть(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Югория Тогда
			
			ЗаполнитьРезервыЮгория(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ХантыМансийский Тогда
			
			// У Ханты-Мансийского нужно ежедневно начислять резервы на остатки по банковским и брокерским счетам
			НастройкиФормированияСЧА 	= РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
			ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств = НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9
				И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФХантыМансийский")
				И НастройкиФормированияСЧА.ПериодичностьНачисленияРезервов <> Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно 
				И КонецДня(ЭтотОбъект.Дата) <> КонецМесяца(ЭтотОбъект.Дата)
				И ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
 
			ЗаполнитьРезервыХантыМансийский(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный Тогда
			
			ЗаполнитьРезервыНациональный(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный2025 Тогда
			
			ЗаполнитьРезервыНациональный2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Гефест2025 Тогда
			
			ЗаполнитьРезервыГефест2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Письмо Атомов Ф02-03/54/25 от 14.02.2025, у них начальные остатки не конец 31.12.24, а утро 01.01.25
	Если ЭтотОбъект.ПереходНаМСФО9 И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков <> Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда // вернем
		ЭтотОбъект.Дата = ЭтотОбъект.Дата + 24 * 60 * 60;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчитатьСтроку(ТекущаяСтрока) Экспорт
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
		
		Отказ = Ложь;
		ДанныеРасчета = Неопределено;
		ТолькоПоступившиеАктивы = Ложь;
		
		Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда
			
			Если НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Эволюция2025 Тогда
				
				ЗаполнитьРезервыЭволюция2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ВолгаКапитал Тогда
				
				ЗаполнитьРезервыВолгаКапитал(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Аквилон Тогда
				
				ЗаполнитьРезервыАквилон(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Транснефть Тогда
				
				ЗаполнитьРезервыТранснефть(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Югория Тогда
				
				ЗаполнитьРезервыЮгория(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ХантыМансийский Тогда
			
				ЗаполнитьРезервыХантыМансийский(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, Ложь, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный Тогда
				
				ЗаполнитьРезервыНациональный(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный2025 Тогда
				
				ЗаполнитьРезервыНациональный2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Гефест2025 Тогда
				
				ЗаполнитьРезервыГефест2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ТекущаяСтрока);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьБумагиПоАСИзОстатковПартий(ТолькоПоступившиеАктивы, ВключаяОФЗ, НастройкиУчета)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	// Письмо Атомов Ф02-03/54/25 от 14.02.2025, у них начальные остатки не конец 31.12.24, а утро 01.01.25
	Если ЭтотОбъект.ПереходНаМСФО9 И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков <> Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.Дата + 24 * 60 * 60));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата + 24 * 60 * 60));
	Иначе
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата));
	КонецЕсли;	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК Эмитент,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДатаПокупки, НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ))) КАК ДатаПокупки,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ОценочныеДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК ОценочнаяКорректировкаЭСП,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК ОценочнаяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ОценочнаяСуммаКупона,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.ЗадолженностьПоПогашениюКупонаВВалютеУчетаОстаток КАК ЗадолженностьПоПогашениюКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ЗадолженностьПоПогашениюТелаВВалютеУчетаОстаток КАК ЗадолженностьПоПогашениюТелаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И Рынок = &Рынок
		|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|				И &КатегорияГосударственная
		|				И (НЕ &ТолькоПоступившиеАктивы
		|					ИЛИ ЦеннаяБумага В (&ОблигацииВДеньОперации)
		|					ИЛИ ТИПЗНАЧЕНИЯ(Партия) <> ТИП(Документ.ВводЦенныхБумаг)
		|						И (Партия.Дата МЕЖДУ &НачалоДня И &КонецДня))) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = РеклассификацияАктивовЕПСПартии.Ссылка.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = РеклассификацияАктивовЕПСПартии.Ссылка.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаАктивовЕПС.СрезПоследних(&КонецДня, ) КАК НастройкиУчетаАктивовЕПССрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.Организация = НастройкиУчетаАктивовЕПССрезПоследних.Организация
		|			И БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления = НастройкиУчетаАктивовЕПССрезПоследних.СчетДоверительногоУправления
		|			И БухПартииЦенныхБумагОстатки.ВидУчета = НастройкиУчетаАктивовЕПССрезПоследних.ВидУчета
		|			И (НастройкиУчетаАктивовЕПССрезПоследних.УчетныйАктив = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС)
		|ГДЕ
		|	(НЕ &ТолькоПоступившиеАктивы
		|			ИЛИ БухПартииЦенныхБумагОстатки.ЦеннаяБумага В (&ОблигацииВДеньОперации)
		|			ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) <> ТИП(Документ.ВводЦенныхБумаг)
		|				И (БухПартииЦенныхБумагОстатки.Партия.Дата МЕЖДУ &НачалоДня И &КонецДня)
		|				И НастройкиУчетаАктивовЕПССрезПоследних.НачислятьРезервОКУПриПервоначальномПризнании)";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	// Письмо Атомов Ф02-03/54/25 от 14.02.2025, у них начальные остатки не конец 31.12.24, а утро 01.01.25
	Если ЭтотОбъект.ПереходНаМСФО9 И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков <> Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата + 24 * 60 * 60); // сдвигали
	ИначеЕсли ЭтотОбъект.ПереходНаМСФО9 И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда
		// И дополнительно письмом Атомов 02-03/10/25 от 18.02.2025 что начальные остатки утром До отражения доходов/расходов за день
		Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата) + 1); 
	Иначе
		Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
	КонецЕсли;
	Запрос.УстановитьПараметр("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации);
	Если ВключаяОФЗ Тогда
		Запрос.УстановитьПараметр("КатегорияГосударственная", ИСТИНА);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КатегорияГосударственная", "ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации).Категория <> &КатегорияГосударственная");
		Запрос.УстановитьПараметр("КатегорияГосударственная", Перечисления.КатегорииОблигаций.Государственная);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТолькоПоступившиеАктивы", ТолькоПоступившиеАктивы);
	
	НачисляемРезервыВДниОперация = (СокрЛП(НастройкиУчета.ОснованияДляПерерасчетаРезервов) <> "");
	Если НачисляемРезервыВДниОперация Тогда
		Запрос.УстановитьПараметр("ОблигацииВДеньОперации", ПолучитьЦенныеБумагиПоКоторымПрошлиОперации(НастройкиУчета.ОснованияДляПерерасчетаРезервов));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ ЦеннаяБумага В (&ОблигацииВДеньОперации)", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ БухПартииЦенныхБумагОстатки.ЦеннаяБумага В (&ОблигацииВДеньОперации)", "");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции 

Функция ПолучитьБумагиПоАСЧерезРасчет(НачалоПериода, ТолькоПоступившиеАктивы, ВключаяОФЗ, НастройкиУчета, Отказ)

	Если РасчетПартий = Неопределено Тогда
		
		РасчетПартий = Обработки.РасчетПартий.Создать();
		РасчетПартий.Организация                  = ЭтотОбъект.Организация;
		РасчетПартий.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		РасчетПартий.ВидУчета                     = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		РасчетПартий.НачалоПериода                = НачалоДня(НачалоПериода) + 86400;
		РасчетПартий.КонецПериода                 = КонецДня(ЭтотОбъект.Дата);
		РасчетПартий.ТаблицаПлановыхОпераций	  = Неопределено;
		РасчетПартий.ВариантРасчета				  = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы;
		
		РасчетПартий.РассчитатьПартии(Отказ, Истина);		
	
	КонецЕсли;
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось динамически рассчитать партий по '" + ЭтотОбъект.СчетДоверительногоУправления + "' за период с " + РасчетПартий.НачалоПериода + " по " + РасчетПартий.КонецПериода,,,, Отказ);
		Возврат Ложь;
	КонецЕсли;

	НачисляемРезервыВДниОперация = (СокрЛП(НастройкиУчета.ОснованияДляПерерасчетаРезервов) <> "");
	Если НачисляемРезервыВДниОперация Тогда
		ОблигацииВДеньОперации = ПолучитьЦенныеБумагиПоКоторымПрошлиОперации(НастройкиУчета.ОснованияДляПерерасчетаРезервов);
	Иначе
		ОблигацииВДеньОперации = Новый Массив();
	КонецЕсли;
	
	НужныеСтроки = Новый Массив();
	
	Для Каждого СтрокаОстатковПартий Из РасчетПартий.КонечныеОстаткиПартий Цикл
		
		Добавить = (СтрокаОстатковПартий.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость 							// только бумаги по АС
					И (ВключаяОФЗ ИЛИ СтрокаОстатковПартий.ЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Государственная)); // берем ОФЗ или не ОФЗ
		
					
		Если Добавить И ТолькоПоступившиеАктивы И ОблигацииВДеньОперации.Найти(СтрокаОстатковПартий.ЦеннаяБумага) = Неопределено Тогда																	// если только поступившие, то:

			НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, СтрокаОстатковПартий.УчетныйАктивЕПС, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
			
			Добавить = (ТипЗнч(СтрокаОстатковПартий.Партия) <> Тип("ДокументСсылка.ВводЦенныхБумаг")                    // не ввод
						И НачалоДня(СтрокаОстатковПартий.Партия.Дата) = НачалоДня(ЭтотОбъект.Дата)) И НастройкиУчетаАктива.НачислятьРезервОКУПриПервоначальномПризнании;					// и пришли сегодня
		
		КонецЕсли;
		
		Если Добавить Тогда
			НужныеСтроки.Добавить(СтрокаОстатковПартий);
		КонецЕсли;
		
	КонецЦикла;
	
	ЦенныеБумаги = РасчетПартий.КонечныеОстаткиПартий.Выгрузить(НужныеСтроки);
	
	МДРеквизитыТЧПереоценки = Метаданные.Документы.ПереоценкаЦенныхБумаг.ТабличныеЧасти.ЦенныеБумаги.Реквизиты;
	
	Для каждого МДРеквизитТЧПереоценки Из МДРеквизитыТЧПереоценки Цикл
		Если ЦенныеБумаги.Колонки.Найти(МДРеквизитТЧПереоценки.Имя) = Неопределено Тогда
			ЦенныеБумаги.Колонки.Добавить(МДРеквизитТЧПереоценки.Имя, МДРеквизитТЧПереоценки.Тип);
		КонецЕсли;
	КонецЦикла;
	
	ЦенныеБумаги.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
	ЦенныеБумаги.Колонки.Добавить("Эмитент", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	
	Инд = 0;
	Для Каждого СтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
		Инд = Инд + 1;
		СтрокаЦенныеБумаги.НомерСтроки = Инд;
		
		СтрокаЦенныеБумаги.СуммаРезервовПодОбесценение = 0;
		СтрокаЦенныеБумаги.ОценочныеДисконтПремия = 0;
		СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = 0;
		СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
		СтрокаЦенныеБумаги.НачальнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная;
		
		СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		СтрокаЦенныеБумаги.БалансовыеДисконтПремия = СтрокаЦенныеБумаги.ДисконтПремияНачисленный;
		СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП = СтрокаЦенныеБумаги.КорректировкаЭСП;

		СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = Справочники.Облигации.ПолучитьКупон(СтрокаЦенныеБумаги.ЦеннаяБумага, НачалоДня(ЭтотОбъект.Дата), ЭтотОбъект.СчетДоверительногоУправления) * СтрокаЦенныеБумаги.Количество;
		
		СтрокаЦенныеБумаги.ДатаПартии = СтрокаЦенныеБумаги.Партия.Дата;

		СтрокаЦенныеБумаги.ИндексироватьНоминал = СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал;
		
		СтрокаЦенныеБумаги.Эмитент = СтрокаЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
		
	КонецЦикла;
	
	БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПДляПереоценки(ЭтотОбъект, ЦенныеБумаги, , Отказ);
	
	ПрименятьПолитикуУчета = Истина;
	
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении																					// для СЧА
		И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Аквилон 									// методика Аквилона
		И Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Дата)) <> НачалоДня(ЭтотОбъект.Дата)			// нерабочий день
		И Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ЭтотОбъект.Дата)) = НачалоДня(ЭтотОбъект.Дата)	// торговый день
	Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
			|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаОперации
			|ИЗ
			|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
			|ГДЕ
			|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) = &ДатаОперации
			|	И ОперацииСЦеннымиБумагами.Организация = &Организация
			|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления";
		
		Запрос.УстановитьПараметр("ДатаОперации", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		ПрименятьПолитикуУчета = Запрос.Выполнить().Пустой(); // были операции -> считаем не применяя политику учета т.к. для целей СЧА, а политика задана для ЕПС
		
	КонецЕсли;
	
	РеформацииБалансов = РегистрыСведений.РеформацииБалансов.ПолучитьДатыРеформацийЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, НачалоДня(ЭтотОбъект.Дата), НачалоДня(ЭтотОбъект.Дата));
	Если РеформацииБалансов.Количество() > 0 Тогда
		ПрименятьПолитикуУчета = Ложь;
	КонецЕсли;
	
	СтруктураДляПримененияПолитикиУчета = Новый Структура("Дата,Организация,СчетДоверительногоУправления,ВидУчета");
	ЗаполнитьЗначенияСвойств(СтруктураДляПримененияПолитикиУчета, ЭтотОбъект, "Дата,Организация,СчетДоверительногоУправления");
	СтруктураДляПримененияПолитикиУчета.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	СтруктураДляПримененияПолитикиУчета.Вставить("ЦенныеБумаги", ЦенныеБумаги);
	
	Если ПрименятьПолитикуУчета Тогда
		РаботаСПереоценкой.ПрименитьПолитикуУчета(СтруктураДляПримененияПолитикиУчета, Ложь,, ЭтотОбъект.Организация.ВалютаУчета, Отказ);	
	КонецЕсли;
	
	Возврат СтруктураДляПримененияПолитикиУчета.ЦенныеБумаги;

КонецФункции

Функция ПолучитьДатуЗапретаРедактированияПартий()

	ЗапросДатыЗапрета = Новый Запрос;
	ЗапросДатыЗапрета.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
		|	И ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)";

	ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);

	Выборка = ЗапросДатыЗапрета.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ДатаЗапретаРедактированияПартий = Выборка.ДатаЗапретаРедактирования;
	Иначе
		ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
	КонецЕсли;

	Возврат ДатаЗапретаРедактированияПартий;

КонецФункции

Процедура ДополнитьАктивыПоАСДаннымиИзСЧА(ЦенныеБумаги, ПараметрыАктивовПоАС, Отказ)
	
	Если ТаблицаАктивовИОбязательств = Неопределено И Не ЭтотОбъект.Ссылка.Пустая() Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВалютаСтроки КАК ВалютаСтроки,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидАктива КАК ВидАктива,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Контрагент КАК Контрагент,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Основание КАК Основание,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
			|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаРынокВВалютеУчета + РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаРезерваВВалютеУчета КАК СуммаРынокВВалютеУчета
			|ИЗ
			|	Документ.РегистрацияСтоимостиАктивов.АктивыНеОтносящиесяКЦеннымБумагам КАК РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
			|		ПО РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Ссылка = РегистрацияСтоимостиАктивов.Ссылка
			|ГДЕ
			|	РегистрацияСтоимостиАктивов.НачислениеСписаниеРезервов = &НачислениеСписаниеРезервов";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("НачислениеСписаниеРезервов", ЭтотОбъект.Ссылка);
		
		ТаблицаАктивовИОбязательств = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если ТаблицаАктивовИОбязательств = Неопределено Тогда
		
		ТекстСообщения = СтрШаблон("Не удалось рассчитать стоимость небумажных активов '%1' за %2",
			ЭтотОбъект.СчетДоверительногоУправления,
			Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат;
		
	КонецЕсли;
	
	// т.к. в СЧА депозиты разбили приходится делать так
	Для Каждого СтрокаАктивовНеЦБ Из ТаблицаАктивовИОбязательств Цикл
		Если СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДепозитныеВклады
			И СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитномуВкладуПроценты Тогда
			СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитномуВкладу;
		КонецЕсли;
	КонецЦикла;
	
	//Колонка для раздельного учета всяких МНО и их %% и прочего что еще потребуется
	ТаблицаАктивовИОбязательств.Колонки.Добавить("РазделительУчета", Новый ОписаниеТипов("Число"));
	
	// МНО для тех, у кого оно учитывается по полной сумме. 
	Если ПараметрыАктивовПоАС.ВМНОУчитыватьВсюСумму Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДенежныеСредстваМНООстатки.МНО КАК МНО,
		|	ДенежныеСредстваМНООстатки.РасчетныйСчет КАК РасчетныйСчет,
		|	ДенежныеСредстваМНООстатки.СуммаОстаток КАК СуммаОстаток,
		|	ДенежныеСредстваМНООстатки.РасчетныйСчет.Валюта КАК Валюта
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваМНООстатки";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// МНО
			НоваяСтрокаАктивовНеЦБ = ТаблицаАктивовИОбязательств.Добавить();
			НоваяСтрокаАктивовНеЦБ.ВалютаСтроки = ВыборкаДетальныеЗаписи.Валюта;
			НоваяСтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность;
			НоваяСтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам;
			НоваяСтрокаАктивовНеЦБ.Основание = Null;
			НоваяСтрокаАктивовНеЦБ.СубъектАналитики = ВыборкаДетальныеЗаписи.МНО;
			НоваяСтрокаАктивовНеЦБ.СуммаРынокВВалютеУчета = ВыборкаДетальныеЗаписи.СуммаОстаток;
			
			Если ПараметрыАктивовПоАС.МНОРаздельныйУчетПроцентовИТела Тогда
				НоваяСтрокаАктивовНеЦБ.РазделительУчета = 1;	
			КонецЕсли;	
			
			// Расчетный счет
			НоваяСтрокаАктивовНеЦБ = ТаблицаАктивовИОбязательств.Добавить();
			НоваяСтрокаАктивовНеЦБ.ВалютаСтроки = ВыборкаДетальныеЗаписи.Валюта;
			НоваяСтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства;
			НоваяСтрокаАктивовНеЦБ.ВидЗадолженности = Null;
			НоваяСтрокаАктивовНеЦБ.Основание = Null;
			НоваяСтрокаАктивовНеЦБ.СубъектАналитики = ВыборкаДетальныеЗаписи.РасчетныйСчет;
			НоваяСтрокаАктивовНеЦБ.СуммаРынокВВалютеУчета = - ВыборкаДетальныеЗаписи.СуммаОстаток;
		КонецЦикла;
		
		
	КонецЕсли;	
	
	ТаблицаАктивовИОбязательств.Свернуть("СубъектАналитики,ВидАктива,Основание,ВидЗадолженности,РазделительУчета", "СуммаРынокВВалютеУчета");
	
	МассивАктивовНеЦБ = Новый Массив();
	
	НастройкиУчетаДепозитныеВкладыПоАС = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	НастройкиУчетаДенежныеСредстваНаРасчетномСчете = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДенежныеСредстваНаРасчетномСчете, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	НастройкиУчетаДенежныеСредстваУБрокера = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДенежныеСредстваУБрокера, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	НастройкиУчетаПроцентыНаМНО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	НастройкиУчетаПроцентыПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ПроцентыПоРЕПО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	Для Каждого СтрокаАктивовНеЦБ Из ТаблицаАктивовИОбязательств Цикл
		
		Пропускаем = Ложь;
		
		Если ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы Или ПараметрыАктивовПоАС.ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств Тогда
			
			Пропускаем = Истина;
			
			Если ПараметрыАктивовПоАС.ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств 
				И (СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства 
				ИЛИ (СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
				И (ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.БрокерскиеКомпании")
					ИЛИ ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.Биржи")))) Тогда
					
				Пропускаем = Ложь;
				
			КонецЕсли;
			
			Если СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДепозитныеВклады // депозиты, открывшиеся в этот день
				И СтрокаАктивовНеЦБ.СубъектАналитики.ДатаРегистрации = НачалоДня(ЭтотОбъект.Дата)
				И НастройкиУчетаДепозитныеВкладыПоАС.НачислятьРезервОКУПриПервоначальномПризнании Тогда
			
				Пропускаем = Ложь;
				
			ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
				И СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО
				И НачалоДня(СтрокаАктивовНеЦБ.Основание.Дата) = НачалоДня(ЭтотОбъект.Дата)
				И НастройкиУчетаПроцентыПоРЕПО.НачислятьРезервОКУПриПервоначальномПризнании Тогда
			
				Пропускаем = Ложь;
				
			ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства 
				И НастройкиУчетаДенежныеСредстваНаРасчетномСчете.НачислятьРезервОКУПриПервоначальномПризнании Тогда
				
			// Пока нет методики как это считать на дату признания, поэтому это задел на будущее. Когда/если она появится.
			// В данный момент установка НачислятьРезервОКУПриПервоначальномПризнании для Денежных средств - запрещена и сюда алгоритм входить не должен.
			//	
			//	Пропускаем = Ложь;
			//	
			ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
				И ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("ДокументСсылка.МНО")
				И НачалоДня(СтрокаАктивовНеЦБ.СубъектАналитики.Дата) = НачалоДня(ЭтотОбъект.Дата)
				И НастройкиУчетаПроцентыНаМНО.НачислятьРезервОКУПриПервоначальномПризнании Тогда
				
				Пропускаем = Ложь;
				
			ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
				И (ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.БрокерскиеКомпании")
					ИЛИ ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.Биржи"))
				И НастройкиУчетаДенежныеСредстваУБрокера.НачислятьРезервОКУПриПервоначальномПризнании Тогда
				
			// Пока нет методики как это считать на дату признания, поэтому это задел на будущее. Когда/если появится.
			// В данный момент установка НачислятьРезервОКУПриПервоначальномПризнании для Денежных средств - запрещена и сюда алгоритм входить не должен.
			//	
			//	Пропускаем = Ложь;
			//	
			
			ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
				И ЗначениеЗаполнено(СтрокаАктивовНеЦБ.Основание)
				И НачалоДня(СтрокаАктивовНеЦБ.Основание.Дата) = НачалоДня(ЭтотОбъект.Дата)
				И (СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
					Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации
					Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции)	Тогда

					Если СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
						Пропускаем = Не (ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПолномуПогашению Или ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов Или ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС);
					Иначе	
			     		Пропускаем = Не (ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов Или ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС);
					КонецЕсли;	

			КонецЕсли;	
		КонецЕсли;
	
		Если СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДенежныеСредства Тогда
			
			Эмитент = СтрокаАктивовНеЦБ.СубъектАналитики.Банк.ЮрФизЛицо;
			ЦеннаяБумага = СтрокаАктивовНеЦБ.СубъектАналитики;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДепозитныеВклады Тогда
			
			Эмитент = СтрокаАктивовНеЦБ.СубъектАналитики.БанковскийСчет.Банк.ЮрФизЛицо;
			ЦеннаяБумага = СтрокаАктивовНеЦБ.СубъектАналитики;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
			И ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("ДокументСсылка.МНО") Тогда
			
			Эмитент = СтрокаАктивовНеЦБ.СубъектАналитики.РасчетныйСчет.Банк.ЮрФизЛицо;
			ЦеннаяБумага = СтрокаАктивовНеЦБ.СубъектАналитики;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
			И (ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.БрокерскиеКомпании")
				ИЛИ ТипЗнч(СтрокаАктивовНеЦБ.СубъектАналитики) = Тип("СправочникСсылка.Биржи")) Тогда
			
			Эмитент = СтрокаАктивовНеЦБ.СубъектАналитики.ЮрФизЛицо;
			ЦеннаяБумага = СтрокаАктивовНеЦБ.СубъектАналитики;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
			И СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
			
			Эмитент = СтрокаАктивовНеЦБ.Основание.Контрагент;
			ЦеннаяБумага = СтрокаАктивовНеЦБ.Основание;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
			И (ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов Или ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС) И (СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
				Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации
				Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции)	Тогда
				
			Если ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда	
				Эмитент = СтрокаАктивовНеЦБ.Основание.Облигация.Эмитент.ЮрФизЛицо;
			ИначеЕсли ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Или ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда	
				Эмитент = СтрокаАктивовНеЦБ.Основание.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
			Иначе
				Продолжить;
			КонецЕсли;	
				
			ЦеннаяБумага = СтрокаАктивовНеЦБ.Основание;
			
		ИначеЕсли СтрокаАктивовНеЦБ.ВидАктива = Перечисления.ВидыАктивов.ДебиторскаяЗадолженность
			И ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПолномуПогашению И (СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона 
			Или СтрокаАктивовНеЦБ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)	Тогда
				
			Если ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда	
				Эмитент = СтрокаАктивовНеЦБ.Основание.Облигация.Эмитент.ЮрФизЛицо;
			ИначеЕсли ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда	
				Эмитент = СтрокаАктивовНеЦБ.Основание.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
			Иначе
				Продолжить;
			КонецЕсли;	
				
			ЦеннаяБумага = СтрокаАктивовНеЦБ.Основание;
			
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивовНеЦБ.ВидЗадолженности) <> Тип("СправочникСсылка.Резервы") Тогда
			МассивАктивовНеЦБ.Добавить(ЦеннаяБумага);
		КонецЕсли;
		
		Если Пропускаем Тогда
			Продолжить;
		КонецЕсли;
		
		Эмитент = ОпределитьГоловнуюОрганизацию(Эмитент);
		
		СтоимостьАктива = СтрокаАктивовНеЦБ.СуммаРынокВВалютеУчета;
		
		Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС Тогда
			КоличествоБумагПоДЗ = 0;
			Если ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
				ЦеннаяБумагаПоДЗ = СтрокаАктивовНеЦБ.Основание.Облигация;	
				КоличествоБумагПоДЗ = СтрокаАктивовНеЦБ.Основание.Количество;
			ИначеЕсли ТипЗнч(СтрокаАктивовНеЦБ.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда	
				Если СтрокаАктивовНеЦБ.Основание.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
					ЦеннаяБумагаПоДЗ = СтрокаАктивовНеЦБ.Основание.ЦеннаяБумага;	
					КоличествоБумагПоДЗ = СтрокаАктивовНеЦБ.Основание.Количество;
				ИначеЕсли СтрокаАктивовНеЦБ.Основание.ВидПогашения = Перечисления.ВидыПогашения.ПолноеПогашение Тогда
					
					ЗапросСписания = Новый Запрос;
					ЗапросСписания.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	НАЧАЛОПЕРИОДА(СписаниеЦеннойБумаги.Дата, ДЕНЬ) КАК ДатаСписания
					|ИЗ
					|	Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
					|ГДЕ
					|	СписаниеЦеннойБумаги.Организация = &Организация
					|	И СписаниеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги = &ПогашениеЦеннойБумаги
					|	И СписаниеЦеннойБумаги.Проведен";
					
					ЗапросСписания.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
					ЗапросСписания.УстановитьПараметр("ПогашениеЦеннойБумаги", СтрокаАктивовНеЦБ.Основание);
					ЗапросСписания.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
					
					РезультатЗапросаСписания = ЗапросСписания.Выполнить();
					
					ВыборкаДетальныеЗаписиСписания = РезультатЗапросаСписания.Выбрать();
					
					Если ВыборкаДетальныеЗаписиСписания.Следующий() Тогда
						Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАСИССсДатыСписания Тогда
							Если ВыборкаДетальныеЗаписиСписания.ДатаСписания > НачалоДня(ЭтотОбъект.Дата) Тогда
								ЦеннаяБумагаПоДЗ = СтрокаАктивовНеЦБ.Основание.ЦеннаяБумага;	
								КоличествоБумагПоДЗ = СтрокаАктивовНеЦБ.Основание.Количество;
							КонецЕсли;	
						Иначе	
							Если ВыборкаДетальныеЗаписиСписания.ДатаСписания >= НачалоДня(ЭтотОбъект.Дата) Тогда
								ЦеннаяБумагаПоДЗ = СтрокаАктивовНеЦБ.Основание.ЦеннаяБумага;	
								КоличествоБумагПоДЗ = СтрокаАктивовНеЦБ.Основание.Количество;
							Иначе
								СтоимостьАктива = 0;	
							КонецЕсли;	
						КонецЕсли;	
					Иначе
						// Списания ЦБ нет, или оно еще не проведено
						СтоимостьАктива = 0;	
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;	
			
			Если КоличествоБумагПоДЗ > 0 Тогда
				
				ИтогоКоличествоЦБПоАС = 0;
				
				ОтборЦБ = Новый Структура();
				ОтборЦБ.Вставить("ЦеннаяБумага", ЦеннаяБумагаПоДЗ);
				СтрокиОтбораЦБПоАС = ЦенныеБумаги.НайтиСтроки(ОтборЦБ);
				
				Для Каждого СтрокаОтбораЦБПоАС Из СтрокиОтбораЦБПоАС Цикл
					ИтогоКоличествоЦБПоАС = ИтогоКоличествоЦБПоАС + СтрокаОтбораЦБПоАС.Количество;
				КонецЦикла;	
				
				Если ИтогоКоличествоЦБПоАС < КоличествоБумагПоДЗ Тогда
					СтоимостьАктива = СтоимостьАктива * ИтогоКоличествоЦБПоАС / КоличествоБумагПоДЗ;	
				КонецЕсли;	
				
			КонецЕсли;
		КонецЕсли;			
		
		СтрокаАктивы = ЦенныеБумаги.Добавить();
		
		СтрокаАктивы.ЦеннаяБумага = ЦеннаяБумага;
		СтрокаАктивы.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
		СтрокаАктивы.Эмитент = Эмитент;
		СтрокаАктивы.Партия = Неопределено;
		СтрокаАктивы.СтрокаПартии = 0;
		СтрокаАктивы.Количество = 0;
		СтрокаАктивы.Стоимость = СтоимостьАктива;
		СтрокаАктивы.ОценочныеДисконтПремия = 0;
		СтрокаАктивы.ОценочнаяКорректировкаЭСП = 0;
		СтрокаАктивы.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
		СтрокаАктивы.ОценочнаяСуммаКупона = 0;
		СтрокаАктивы.СуммаРезервовПодОбесценение = 0;
		СтрокаАктивы.ЗадолженностьПоПогашениюКупонаВВалютеУчета = 0;
		СтрокаАктивы.ЗадолженностьПоПогашениюТелаВВалютеУчета = 0;
		
	КонецЦикла;
	
	// проверим для случаев когда актив ушел в ноль, а резерв еще есть
	// это работало только до 2025 года, но на всякий случай поставлю с 1го августа
	Если ЭтотОбъект.Дата <= '20250801' Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
			|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо
			|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
			|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.БрокерскиеКомпании).ЮрФизЛицо
			|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.Биржи)
			|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.Биржи).ЮрФизЛицо
			|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Документ.МНО)
			|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Документ.МНО).РасчетныйСчет.Банк.ЮрФизЛицо
			|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Документ.СделкаРЕПО)
			|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Документ.СделкаРЕПО).Контрагент
