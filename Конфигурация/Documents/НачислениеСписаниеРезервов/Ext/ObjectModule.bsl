Перем ТаблицаАктивовИОбязательств Экспорт;
Перем РасчетПартий Экспорт;

Функция ПолучитьВариантыПроведения()

	ЕстьАктивыНеЦБ = Ложь;
	ЕстьОблигации = Ложь;
	Для каждого СтрокаПартии Из Партии Цикл
		
		Если ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.ДепозитныеВклады")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.БанковскиеСчета")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.ЮрФизЛица")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.БрокерскиеКомпании")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.Биржи")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("ДокументСсылка.МНО")
			ИЛИ ТипЗнч(СтрокаПартии.Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			ЕстьАктивыНеЦБ = Истина;
		ИначеЕсли ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.Облигации") Тогда
			ЕстьОблигации = Истина;
		КонецЕсли;
		
		Если ЕстьАктивыНеЦБ И ЕстьОблигации Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Новый Структура("ПоАктивамНеЦБ,ПоОблигациям", ЕстьАктивыНеЦБ, ЕстьОблигации);
	
КонецФункции 

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);

	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	ВариантыПроведения = ПолучитьВариантыПроведения();
	
	Если ВариантыПроведения.ПоАктивамНеЦБ Тогда
		
		НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			Отказ);
		
		// лочим все резервы по счету ду так как документ по ререзвам единый
		БлокировкаДанных = Новый БлокировкаДанных;
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.РезервыПредстоящихРасходов");
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		БлокировкаДанных.Заблокировать();
		
		
		Движения.РезервыПредстоящихРасходов.Записывать = Истина;
		
		Движения.РезервыПредстоящихРасходов.Очистить();
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НачислениеСписаниеРезервовПартии.АналитикаРезерва КАК АналитикаРезерва,
			|	СУММА(НачислениеСписаниеРезервовПартии.СуммаРезерваПартии) КАК СуммаРезерва,
			|	НачислениеСписаниеРезервовПартии.Актив КАК Актив
			|ПОМЕСТИТЬ _ДанныеДокумента
			|ИЗ
			|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
			|ГДЕ
			|	НачислениеСписаниеРезервовПартии.Ссылка = &Ссылка
			|	И ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) <> ТИП(Справочник.Облигации)
			|
			|СГРУППИРОВАТЬ ПО
			|	НачислениеСписаниеРезервовПартии.АналитикаРезерва,
			|	НачислениеСписаниеРезервовПартии.Актив
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(РезервыПредстоящихРасходовОстатки.Резерв, ДанныеДокумента.АналитикаРезерва) КАК БалансоваяАналитикаРезерва,
			|	ЕСТЬNULL(РезервыПредстоящихРасходовОстатки.СуммаОстаток, 0) КАК БалансоваяСумма,
			|	ЕСТЬNULL(ДанныеДокумента.АналитикаРезерва, РезервыПредстоящихРасходовОстатки.Резерв) КАК АналитикаРезерва,
			|	ЕСТЬNULL(ДанныеДокумента.СуммаРезерва, 0) КАК Сумма,
			|	ЕСТЬNULL(ДанныеДокумента.Актив, РезервыПредстоящихРасходовОстатки.СубъектАналитики) КАК Актив
			|ИЗ
			|	_ДанныеДокумента КАК ДанныеДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РезервыПредстоящихРасходовОстатки
			|		ПО (РезервыПредстоящихРасходовОстатки.СубъектАналитики = ДанныеДокумента.Актив)";
			
		Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Ссылка",							ЭтотОбъект.Ссылка);
		
		Если НастройкиФормированияСЧА.ПериодичностьНачисленияРезервов = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
			Запрос.Текст = СтрЗаменить(
				Запрос.Текст,
				"ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыПредстоящихРасходов.Остатки",
				"ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыПредстоящихРасходов.Остатки");
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.БалансоваяСумма > ВыборкаДетальныеЗаписи.Сумма Тогда // нужно списать
				
				Движение = Движения.РезервыПредстоящихРасходов.ДобавитьРасход();
				
				Движение.Период							= ЭтотОбъект.Дата;
				
				Движение.Организация					= ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Резерв							= ВыборкаДетальныеЗаписи.БалансоваяАналитикаРезерва;
				Движение.СубъектАналитики				= ВыборкаДетальныеЗаписи.Актив;
				
				Движение.Сумма							= ВыборкаДетальныеЗаписи.БалансоваяСумма - ВыборкаДетальныеЗаписи.Сумма;
				
				Движение.Валюта							= ВалютаУчета;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.БалансоваяСумма < ВыборкаДетальныеЗаписи.Сумма Тогда // нужно начислить
				
				Движение = Движения.РезервыПредстоящихРасходов.ДобавитьПриход();
				
				Движение.Период							= ЭтотОбъект.Дата;
				
				Движение.Организация					= ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Резерв							= ВыборкаДетальныеЗаписи.АналитикаРезерва;
				Движение.СубъектАналитики				= ВыборкаДетальныеЗаписи.Актив;
				
				Движение.Сумма							= ВыборкаДетальныеЗаписи.Сумма - ВыборкаДетальныеЗаписи.БалансоваяСумма;
				
				Движение.Валюта							= ВалютаУчета;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВариантыПроведения.ПоОблигациям Тогда
		
		Движения.ОперацииСЦеннымиБумагами.Записывать   = Истина;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НачислениеСписаниеРезервовПартии.Актив КАК ЦеннаяБумага,
			|	НачислениеСписаниеРезервовПартии.Количество КАК Количество,
			|	НачислениеСписаниеРезервовПартии.СуммаРезерваПартии КАК Сумма,
			|	НачислениеСписаниеРезервовПартии.Ссылка.Организация.ВалютаУчета КАК ВалютаУчета,
			|	ЕСТЬNULL(Облигации.ВалютаНоминала, НачислениеСписаниеРезервовПартии.Ссылка.Организация.ВалютаУчета) КАК ВалютаНоминала,
			|	НАЧАЛОПЕРИОДА(НачислениеСписаниеРезервовПартии.Ссылка.Дата, ДЕНЬ) КАК Период
			|ПОМЕСТИТЬ _ПартииПоАктиву
			|ИЗ
			|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО НачислениеСписаниеРезервовПартии.Актив = Облигации.Ссылка
			|ГДЕ
			|	НачислениеСписаниеРезервовПартии.Ссылка = &Ссылка
			|	И ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) = ТИП(Справочник.Облигации)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПартииПоАктиву.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(_ПартииПоАктиву.Количество) КАК Количество,
			|	СУММА(ВЫБОР
			|			КОГДА _ПартииПоАктиву.ВалютаНоминала = _ПартииПоАктиву.ВалютаУчета
			|				ТОГДА _ПартииПоАктиву.Сумма
			|			ИНАЧЕ ВЫРАЗИТЬ(_ПартииПоАктиву.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(15, 2))
			|		КОНЕЦ) КАК Сумма
			|ПОМЕСТИТЬ _ГруппировкаПартийПоАктиву
			|ИЗ
			|	_ПартииПоАктиву КАК _ПартииПоАктиву
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ПО (_ПартииПоАктиву.ВалютаНоминала <> _ПартииПоАктиву.ВалютаУчета)
			|			И _ПартииПоАктиву.ВалютаНоминала = КурсыВалют.Валюта
			|			И (КурсыВалют.Период = _ПартииПоАктиву.Период)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ПартииПоАктиву.ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НачислениеСписаниеРезервов.Ссылка КАК Операция,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход) КАК ВидДвижения,
			|	НачислениеСписаниеРезервов.Организация КАК Организация,
			|	НачислениеСписаниеРезервов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации) КАК Рынок,
			|	_ГруппировкаПартийПоАктиву.ЦеннаяБумага КАК ЦеннаяБумага,
			|	НачислениеСписаниеРезервов.Дата КАК ДатаПоставки,
			|	_ГруппировкаПартийПоАктиву.Количество КАК Количество,
			|	_ГруппировкаПартийПоАктиву.Сумма КАК Сумма,
			|	0 КАК СуммаКупона,
			|	НачислениеСписаниеРезервов.Дата КАК ДатаОперации,
			|	НачислениеСписаниеРезервов.Организация.ВалютаУчета КАК Валюта,
			|	0 КАК СтрокаПартии,
			|	НачислениеСписаниеРезервов.Дата КАК ДатаПокупки,
			|	НачислениеСписаниеРезервов.Ссылка КАК Регистратор
			|ИЗ
			|	_ГруппировкаПартийПоАктиву КАК _ГруппировкаПартийПоАктиву,
			|	Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
			|ГДЕ
			|	НачислениеСписаниеРезервов.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		Движения.ОперацииСЦеннымиБумагами.Загрузить(Запрос.Выполнить().Выгрузить());
		
		
		Движения.СтадииОбесцененияАктивов.Записывать = НЕ ЭтотОбъект.ПереходНаМСФО9;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	НачислениеСписаниеРезервовПартии.Ссылка.Дата КАК Период,
			|	НачислениеСписаниеРезервовПартии.Ссылка.Организация КАК Организация,
			|	НачислениеСписаниеРезервовПартии.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
			|	ВЫБОР
			|		КОГДА НачислениеСписаниеРезервовПартии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.POCI)
			|			ТОГДА НачислениеСписаниеРезервовПартии.Партия
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК Партия,
			|	ВЫБОР
			|		КОГДА НачислениеСписаниеРезервовПартии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.POCI)
			|			ТОГДА НачислениеСписаниеРезервовПартии.СтрокаПартии
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СтрокаПартии,
			|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения
			|ИЗ
			|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
			|ГДЕ
			|	НачислениеСписаниеРезервовПартии.Ссылка = &Ссылка
			|	И НачислениеСписаниеРезервовПартии.СтадияОбесценения <> ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.ПустаяСсылка)
			|	И ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) = ТИП(Справочник.Облигации)";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		Движения.СтадииОбесцененияАктивов.Загрузить(Запрос.Выполнить().Выгрузить());
		
	КонецЕсли;
		
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(Отказ)
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	//Движения.СтадииОбесцененияАктивов.Записывать = Истина;
	Движения.БухПартииЦенныхБумаг.Записывать = Истина;
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;

	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервовПартии.Ссылка.Дата КАК Период,
		|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
		|	НачислениеСписаниеРезервовПартии.Партия КАК Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии КАК СтрокаПартии,
		|	НачислениеСписаниеРезервовПартии.СуммаРезерваПартии КАК СуммаРезерваПартии,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва КАК АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения,
		|	НачислениеСписаниеРезервовПартии.Ссылка.Организация.ВалютаУчета КАК ВалютаУчета
		|ПОМЕСТИТЬ _ДанныеДокументаРезервов
