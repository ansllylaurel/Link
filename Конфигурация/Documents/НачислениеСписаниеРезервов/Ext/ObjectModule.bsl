	НастройкиУчетаДенежныеСредстваУБрокера = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.УчетныеАктивыЕПС.ДенежныеСредстваУБрокера,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("ВосстанавливатьБрокераПриВыбытии",
		НастройкиУчетаДенежныеСредстваУБрокера.СписыватьРезервОКУНаДатуПрекращенияПризнания
		ИЛИ ПараметрыАктивовПоАС.НеобходимоЗакрыватьБанковскиеБрокерскиеБиржевыеСчета);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОбнулятьСтоимость = Ложь;
		
		Если ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы Тогда
		
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Актив) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
				Если ПараметрыАктивовПоАС.НеобходимоЗакрыватьБанковскиеБрокерскиеБиржевыеСчета Тогда
					ОбнулятьСтоимость = Истина;
				ИначеЕсли НастройкиУчетаДенежныеСредстваНаРасчетномСчете.СписыватьРезервОКУНаДатуПрекращенияПризнания
					И ВыборкаДетальныеЗаписи.Сумма <> 0 Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Актив) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
				Если ПараметрыАктивовПоАС.НеобходимоЗакрыватьБанковскиеБрокерскиеБиржевыеСчета Тогда
					ОбнулятьСтоимость = Истина;
				ИначеЕсли НастройкиУчетаДенежныеСредстваУБрокера.СписыватьРезервОКУНаДатуПрекращенияПризнания
					И ВыборкаДетальныеЗаписи.Сумма <> 0 Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ") Тогда
				Если ПараметрыАктивовПоАС.НеобходимоЗакрыватьБанковскиеБрокерскиеБиржевыеСчета Тогда
					ОбнулятьСтоимость = Истина;
				ИначеЕсли НастройкиУчетаДенежныеСредстваУБрокера.СписыватьРезервОКУНаДатуПрекращенияПризнания
					И ВыборкаДетальныеЗаписи.Сумма <> 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли;

		Эмитент = ОпределитьГоловнуюОрганизацию(ВыборкаДетальныеЗаписи.Эмитент);
		
		СтоимостьАктива = ?(ОбнулятьСтоимость, 0, ВыборкаДетальныеЗаписи.Сумма);
		
		Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС Тогда
			КоличествоБумагПоДЗ = 0;
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Актив) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
				ЦеннаяБумагаПоДЗ = ВыборкаДетальныеЗаписи.Актив.Облигация;	
				КоличествоБумагПоДЗ = ВыборкаДетальныеЗаписи.Актив.Количество;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Актив) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда	
				Если ВыборкаДетальныеЗаписи.Актив.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
					ЦеннаяБумагаПоДЗ = ВыборкаДетальныеЗаписи.Актив.ЦеннаяБумага;	
					КоличествоБумагПоДЗ = ВыборкаДетальныеЗаписи.Актив.Количество;
				ИначеЕсли ВыборкаДетальныеЗаписи.Актив.ВидПогашения = Перечисления.ВидыПогашения.ПолноеПогашение Тогда
					
					ЗапросСписания = Новый Запрос;
					ЗапросСписания.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	НАЧАЛОПЕРИОДА(СписаниеЦеннойБумаги.Дата, ДЕНЬ) КАК ДатаСписания
					|ИЗ
					|	Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
					|ГДЕ
					|	СписаниеЦеннойБумаги.Организация = &Организация
					|	И СписаниеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги = &ПогашениеЦеннойБумаги
					|	И СписаниеЦеннойБумаги.Проведен";
					
					ЗапросСписания.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
					ЗапросСписания.УстановитьПараметр("ПогашениеЦеннойБумаги", ВыборкаДетальныеЗаписи.Актив);
					ЗапросСписания.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
					
					РезультатЗапросаСписания = ЗапросСписания.Выполнить();
					
					ВыборкаДетальныеЗаписиСписания = РезультатЗапросаСписания.Выбрать();
					
					Если ВыборкаДетальныеЗаписиСписания.Следующий() Тогда
						Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАСИССсДатыСписания Тогда
							Если ВыборкаДетальныеЗаписиСписания.ДатаСписания > НачалоДня(ЭтотОбъект.Дата) Тогда
								ЦеннаяБумагаПоДЗ = ВыборкаДетальныеЗаписи.Актив.ЦеннаяБумага;	
								КоличествоБумагПоДЗ = ВыборкаДетальныеЗаписи.Актив.Количество;
							КонецЕсли;	
						Иначе	
							Если ВыборкаДетальныеЗаписиСписания.ДатаСписания >= НачалоДня(ЭтотОбъект.Дата) Тогда
								ЦеннаяБумагаПоДЗ = ВыборкаДетальныеЗаписи.Актив.ЦеннаяБумага;	
								КоличествоБумагПоДЗ = ВыборкаДетальныеЗаписи.Актив.Количество;
							Иначе
								СтоимостьАктива = 0;	
							КонецЕсли;	
						КонецЕсли;	
					Иначе
						// Списания ЦБ нет, или оно еще не проведено
						СтоимостьАктива = 0;	
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;	
			
			Если КоличествоБумагПоДЗ > 0 Тогда
				
				ИтогоКоличествоЦБПоАС = 0;
				
				ОтборЦБ = Новый Структура();
				ОтборЦБ.Вставить("ЦеннаяБумага", ЦеннаяБумагаПоДЗ);
				СтрокиОтбораЦБПоАС = ЦенныеБумаги.НайтиСтроки(ОтборЦБ);
				
				Для Каждого СтрокаОтбораЦБПоАС Из СтрокиОтбораЦБПоАС Цикл
					ИтогоКоличествоЦБПоАС = ИтогоКоличествоЦБПоАС + СтрокаОтбораЦБПоАС.Количество;
				КонецЦикла;	
				
				Если ИтогоКоличествоЦБПоАС < КоличествоБумагПоДЗ Тогда
					СтоимостьАктива = СтоимостьАктива * ИтогоКоличествоЦБПоАС / КоличествоБумагПоДЗ;	
				КонецЕсли;	
				
			КонецЕсли;
		КонецЕсли;			
		
		СтрокаАктивы = ЦенныеБумаги.Добавить();
		
		СтрокаАктивы.ЦеннаяБумага = ВыборкаДетальныеЗаписи.Актив;
		СтрокаАктивы.Эмитент = Эмитент;
		СтрокаАктивы.Стоимость = СтоимостьАктива;
		
		СтрокаАктивы.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
		СтрокаАктивы.Партия = Неопределено;
		СтрокаАктивы.СтрокаПартии = 0;
		СтрокаАктивы.Количество = 0;
		СтрокаАктивы.ОценочныеДисконтПремия = 0;
		СтрокаАктивы.ОценочнаяКорректировкаЭСП = 0;
		СтрокаАктивы.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
		СтрокаАктивы.ОценочнаяСуммаКупона = 0;
		СтрокаАктивы.СуммаРезервовПодОбесценение = 0;
		СтрокаАктивы.ЗадолженностьПоПогашениюКупонаВВалютеУчета = 0;
		СтрокаАктивы.ЗадолженностьПоПогашениюТелаВВалютеУчета = 0;
		
	КонецЦикла;
	
	Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС Тогда
		ТаблицаЗадолженностиПоПогашениюКупонаИЦБ = ЦенныеБумаги.Скопировать(,"ЦеннаяБумага, Эмитент, ЗадолженностьПоПогашениюКупонаВВалютеУчета, ЗадолженностьПоПогашениюТелаВВалютеУчета");	
		ТаблицаЗадолженностиПоПогашениюКупонаИЦБ.Свернуть("ЦеннаяБумага, Эмитент" ,"ЗадолженностьПоПогашениюКупонаВВалютеУчета, ЗадолженностьПоПогашениюТелаВВалютеУчета");
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеКупона).Облигация КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЗадолженностьПоКупонам
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.ПогашениеКупона)) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЗадолженностьПоПогашениюЦБ
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
			|				И ВЫРАЗИТЬ(Основание КАК Документ.ПогашениеЦеннойБумаги).ВидПогашения = ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ЧастичноеПогашение)) КАК ЗадолженностиПоДенежнымСредствамОстатки";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		Запрос.Выполнить();
		ТаблицаЗадолженностиПоДенежнымСредствамКупона = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗадолженностьПоКупонам"].ПолучитьДанные().Выгрузить();		
		ТаблицаЗадолженностиПоДенежнымСредствамЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЗадолженностьПоПогашениюЦБ"].ПолучитьДанные().Выгрузить();		
		
		Для Каждого СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ Из ТаблицаЗадолженностиПоПогашениюКупонаИЦБ Цикл
			Если СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЗадолженностьПоПогашениюКупонаВВалютеУчета > 0 Тогда
				ОтборЦБ = Новый Структура();
				ОтборЦБ.Вставить("ЦеннаяБумага", СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЦеннаяБумага);
				СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам = ТаблицаЗадолженностиПоДенежнымСредствамКупона.НайтиСтроки(ОтборЦБ);
				
				Если СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам.Количество() = 1 Тогда
					СтрокаАктивы = ЦенныеБумаги.Добавить();
					
					СтрокаАктивы.ЦеннаяБумага = СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам[0].Основание;
					СтрокаАктивы.Эмитент = СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.Эмитент;
					СтрокаАктивы.Стоимость = СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЗадолженностьПоПогашениюКупонаВВалютеУчета;
					
					СтрокаАктивы.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
					СтрокаАктивы.Партия = Неопределено;
					СтрокаАктивы.СтрокаПартии = 0;
					СтрокаАктивы.Количество = 0;
					СтрокаАктивы.ОценочныеДисконтПремия = 0;
					СтрокаАктивы.ОценочнаяКорректировкаЭСП = 0;
					СтрокаАктивы.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
					СтрокаАктивы.ОценочнаяСуммаКупона = 0;
					СтрокаАктивы.СуммаРезервовПодОбесценение = 0;
					СтрокаАктивы.ЗадолженностьПоПогашениюКупонаВВалютеУчета = 0;
					СтрокаАктивы.ЗадолженностьПоПогашениюТелаВВалютеУчета = 0;
				Иначе
					ВызватьИсключение "Ошибка определения задолженности по ДЗ НКД " + СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЦеннаяБумага;	
				КонецЕсли;	
			КонецЕсли;	
				
			Если СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЗадолженностьПоПогашениюТелаВВалютеУчета > 0 Тогда
				ОтборЦБ = Новый Структура();
				ОтборЦБ.Вставить("ЦеннаяБумага", СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЦеннаяБумага);
				СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам = ТаблицаЗадолженностиПоДенежнымСредствамЦБ.НайтиСтроки(ОтборЦБ);
				
				Если СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам.Количество() = 1 Тогда
					СтрокаАктивы = ЦенныеБумаги.Добавить();
					
					СтрокаАктивы.ЦеннаяБумага = СтрокиОтбораТаблицаЗадолженностиПоДенежнымСредствам[0].Основание;
					СтрокаАктивы.Эмитент = СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.Эмитент;
					СтрокаАктивы.Стоимость = СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЗадолженностьПоПогашениюТелаВВалютеУчета;
					
					СтрокаАктивы.УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
					СтрокаАктивы.Партия = Неопределено;
					СтрокаАктивы.СтрокаПартии = 0;
					СтрокаАктивы.Количество = 0;
					СтрокаАктивы.ОценочныеДисконтПремия = 0;
					СтрокаАктивы.ОценочнаяКорректировкаЭСП = 0;
					СтрокаАктивы.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
					СтрокаАктивы.ОценочнаяСуммаКупона = 0;
					СтрокаАктивы.СуммаРезервовПодОбесценение = 0;
					СтрокаАктивы.ЗадолженностьПоПогашениюКупонаВВалютеУчета = 0;
					СтрокаАктивы.ЗадолженностьПоПогашениюТелаВВалютеУчета = 0;
				Иначе
					ВызватьИсключение "Ошибка определения задолженности по ДЗ Тела облигации " + СтрокаТаблицыЗадолженностиПоПогашениюКупонаИЦБ.ЦеннаяБумага;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	

	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьЦенныеБумагиПоКоторымПрошлиОперации(ОснованияДляПерерасчетаРезервов)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаЦенныеБумаги.Ссылка.Проведен
		|	И (НЕ СделкаЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|				И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				И &СделкаТ0Покупка
		|			ИЛИ СделкаЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|				И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				И &СделкаТПлюсПокупка
		|			ИЛИ НЕ СделкаЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|				И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|				И &СделкаТ0Продажа
		|			ИЛИ СделкаЦенныеБумаги.Ссылка.ОтложенноеИсполнение
		|				И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|				И &СделкаТПлюсПродажа)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|ГДЕ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Проведен
		|	И (ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				И &ИсполнениеПокупка
		|			ИЛИ ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|				И &ИсполнениеПродажа)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен
		|	И &ВводБумаг
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВыводЦенныхБумагЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ВыводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВыводЦенныхБумагЦенныеБумаги.Ссылка.Проведен
		|	И &ВыводБумаг
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|ГДЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПОЦенныеБумаги.Ссылка.Проведен
		|	И (СделкаРЕПОЦенныеБумаги.Ссылка.ЧастьСделкиРЕПО = 1
		|				И &СделкаРЕПОЧасть1
		|			ИЛИ СделкаРЕПОЦенныеБумаги.Ссылка.ЧастьСделкиРЕПО = 2
		|				И &СделкаРЕПОЧасть2)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПогашениеЦеннойБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|ГДЕ
		|	ПогашениеЦеннойБумаги.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ПогашениеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПогашениеЦеннойБумаги.Проведен
		|	И ПогашениеЦеннойБумаги.ВидПогашения = ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ЧастичноеПогашение)
		|	И &ЧастичноеПогашение
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПогашениеКупона.Облигация
		|ИЗ
		|	Документ.ПогашениеКупона КАК ПогашениеКупона
		|ГДЕ
		|	ПогашениеКупона.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ПогашениеКупона.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И &ПогашениеКупона
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоручениеНаПереоценкуЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ПоручениеНаПереоценку.ЦенныеБумаги КАК ПоручениеНаПереоценкуЦенныеБумаги
		|ГДЕ
		|	ПоручениеНаПереоценкуЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ПоручениеНаПереоценкуЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПоручениеНаПереоценкуЦенныеБумаги.Ссылка.Проведен
		|	И &ПоручениеНаПереоценку";

	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Для каждого ВидОперации Из РегистрыСведений.НастройкиУчетаОбщие.ВидыОперацийОснованийДляРасчетаРезервов() Цикл
		Запрос.УстановитьПараметр(ВидОперации.Значение, СтрНайти(ОснованияДляПерерасчетаРезервов, ВидОперации.Представление) <> 0);
	КонецЦикла;

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
КонецФункции

Функция ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ)
	
	Если ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАСИССсДатыСписания Тогда
		ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС = Истина;	
	КонецЕсли;	

	ЦенныеБумаги = Неопределено;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("АктивыПоАС", ЦенныеБумаги) Тогда
		
		ДатаЗапретаРедактированияПартий = ПолучитьДатуЗапретаРедактированияПартий();
		
		БеремЦБИзОстатковПартий = (ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов
			ИЛИ ЭтотОбъект.ПереходНаМСФО9
			ИЛИ ДатаЗапретаРедактированияПартий >= НачалоДня(ЭтотОбъект.Дата));
			
		Если НачалоДня(ЭтотОбъект.Дата) = '20260309' И ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении И НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Ростех Тогда
			БеремЦБИзОстатковПартий = Истина;	
		КонецЕсли;	
		
		Если БеремЦБИзОстатковПартий Тогда
		
			ЦенныеБумаги = ПолучитьБумагиПоАСИзОстатковПартий(ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы, ПараметрыАктивовПоАС.ВключаяОФЗ, НастройкиУчета);
			
		Иначе

			ЦенныеБумаги = ПолучитьБумагиПоАСЧерезРасчет(ДатаЗапретаРедактированияПартий, ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы, ПараметрыАктивовПоАС.ВключаяОФЗ, НастройкиУчета, Отказ);
			
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось рассчитать процентные показатели по облигациям '" + ЭтотОбъект.СчетДоверительногоУправления + " на " + КонецДня(ЭтотОбъект.Дата),,,, Отказ);
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;		
		
		РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЦенныеБумаги, "ЦеннаяБумага", Метаданные.ОпределяемыеТипы.СубъектыАналитики.Тип); 
		
		Если ПараметрыАктивовПоАС.ДепозитыДляСЧАПоБалансовойСтоимости И ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда 
			
			ОтборДатЗапретаЕПС = РегистрыСведений.ДатыЗапретаРедактирования.СформироватьСтруктуруОтбораДатЗапрета(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ГруппыЗапретаРедактирования.Проводки, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
			
			ЗакрытЕПСЗаПрошлыйДень = РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(НачалоДня(НачалоДня(ЭтотОбъект.Дата) - 1), ОтборДатЗапретаЕПС);
			
			Если ЗакрытЕПСЗаПрошлыйДень Тогда
				ЦенныеБумагиПоДаннымИзСЧА = ЦенныеБумаги.СкопироватьКолонки();
				ЦенныеБумагиПоДаннымИзЕПС = ЦенныеБумаги.СкопироватьКолонки();
				
				// в текущий день необходимо сформировать проводки по ЕСП по РазмещениеКредитногоИнструмента
				// это временно по задаче #599714 фонд требует балансовую стоимость депозита, и для того чтобы её получить необходимы проводки, которых при формировании СЧА ещё может не быть. 
				ЗакрытЕПСЗаТекущийДень = РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(НачалоДня(ЭтотОбъект.Дата), ОтборДатЗапретаЕПС);
				
				Если Не ЗакрытЕПСЗаТекущийДень Тогда
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
						|	ПРЕДСТАВЛЕНИЕ(РазмещениеКредитногоИнструмента.Ссылка) КАК ПредставлениеДокумента
						|ИЗ
						|	Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет
						|		ПО (ЕдиныйБухгалтерскийУчет.Регистратор = РазмещениеКредитногоИнструмента.Ссылка)
						|ГДЕ
						|	РазмещениеКредитногоИнструмента.СчетДоверительногоУправления = &СчетДоверительногоУправления
						|	И РазмещениеКредитногоИнструмента.Проведен
						|	И РазмещениеКредитногоИнструмента.Дата МЕЖДУ &ДатаНачалаДня И &ДатаОкончания
						|	И ЕдиныйБухгалтерскийУчет.НомерСтроки ЕСТЬ NULL
						|	И РазмещениеКредитногоИнструмента.Организация = &Организация";
					
					Запрос.УстановитьПараметр("ДатаНачалаДня", НачалоДня(ЭтотОбъект.Дата));
					Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ЭтотОбъект.Дата));
					Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
					Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
					
					РезультатЗапроса = Запрос.Выполнить();
					
					Если Не РезультатЗапроса.Пустой() Тогда
						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
						
						СписокДокументов = "";
						
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							Если Не ПустаяСтрока(СписокДокументов) Тогда
								СписокДокументов = СписокДокументов + ", ";	
							КонецЕсли;	
							
							СписокДокументов = СписокДокументов + ВыборкаДетальныеЗаписи.ПредставлениеДокумента;
							
						КонецЦикла;	
					
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(ВыборкаДетальныеЗаписи.Количество() = 1, "По документу ", "По документам ") + СписокДокументов + " не сформирован учет по ЕПС." + Символы.ПС + "Расчет резервов для оценки объектов в управлении не возможен.", , , , Отказ);
						Возврат Ложь;
					КонецЕсли;	
					
					Если КонецДня(ЭтотОбъект.Дата) = КонецМесяца(ЭтотОбъект.Дата) Тогда
						
						УстановитьПривилегированныйРежим(Истина);
						
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ПереоценкаКредитныхИнструментов.Ссылка КАК Ссылка
						|ИЗ
						|	Документ.ПереоценкаКредитныхИнструментов КАК ПереоценкаКредитныхИнструментов
						|ГДЕ
						|	ПереоценкаКредитныхИнструментов.Организация = &Организация
						|	И ПереоценкаКредитныхИнструментов.СчетДоверительногоУправления = &СчетДоверительногоУправления
						|	И ПереоценкаКредитныхИнструментов.ВидУчета = &ВидУчета
						|	И ПереоценкаКредитныхИнструментов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
						|	И ПереоценкаКредитныхИнструментов.Проведен";
						
						Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
						Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
						Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
						Запрос.УстановитьПараметр("НачальнаяДата", НачалоДня(ЭтотОбъект.Дата));
						Запрос.УстановитьПараметр("КонечнаяДата", КонецДня(ЭтотОбъект.Дата));
						
						РезультатЗапроса = Запрос.Выполнить();
						
						Если РезультатЗапроса.Пустой() Тогда
							
							ДокументДепозиты = Документы.ПереоценкаКредитныхИнструментов.СоздатьДокумент();
							
							ДокументДепозиты.Дата = КонецДня(ЭтотОбъект.Дата);
							
							ДокументДепозиты.Организация = ЭтотОбъект.Организация;
							ДокументДепозиты.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;    
							ДокументДепозиты.ПереоцениватьНаОснованииНастроекУчета = Ложь;   
							ДокументДепозиты.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
							
							ДокументДепозиты.Ответственный = ЭтотОбъект.Ответственный;
							
							ДокументДепозиты.ЗаполнитьКредитныеИнструменты(Отказ);
							Если Отказ Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не была произведена переоценка кредитных инструментов на конец месяца. Система сообщает: " + ОписаниеОшибки() + + Символы.ПС + "Расчет резервов для оценки объектов в управлении не возможен.", , , , Отказ); 
								Возврат Ложь;
							КонецЕсли;
							ДокументДепозиты.ПрименитьПолитикуУчета();
							
							Если ДокументДепозиты.КредитныеИнструменты.Количество() > 0 Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не была произведена переоценка кредитных инструментов на конец месяца." + Символы.ПС + "Расчет резервов для оценки объектов в управлении не возможен.", , , , Отказ);
								Возврат Ложь;
							КонецЕсли;							
							
						КонецЕсли;
						
						УстановитьПривилегированныйРежим(Ложь);
							
					КонецЕсли;
				КонецЕсли;	
				
				ДополнитьАктивыПоАСДаннымиИзСЧА(ЦенныеБумагиПоДаннымИзСЧА, ПараметрыАктивовПоАС, Отказ);
				ДополнитьАктивыПоАСДаннымиИзЕПС(ЦенныеБумагиПоДаннымИзЕПС, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
				
				УдаляемыеСтроки = Новый Массив;
				Для Каждого СтрокаЦенныеБумагиПоДаннымИзСЧА Из ЦенныеБумагиПоДаннымИзСЧА Цикл 
					Если ТипЗнч(СтрокаЦенныеБумагиПоДаннымИзСЧА.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда 
						УдаляемыеСтроки.Добавить(СтрокаЦенныеБумагиПоДаннымИзСЧА);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл 
					ЦенныеБумагиПоДаннымИзСЧА.Удалить(УдаляемаяСтрока);
				КонецЦикла;
				
				УдаляемыеСтроки.Очистить();
				Для Каждого СтрокаЦенныеБумагиПоДаннымИзЕПС Из ЦенныеБумагиПоДаннымИзЕПС Цикл 
					Если ТипЗнч(СтрокаЦенныеБумагиПоДаннымИзЕПС.ЦеннаяБумага) <> Тип("СправочникСсылка.ДепозитныеВклады") Тогда 
						УдаляемыеСтроки.Добавить(СтрокаЦенныеБумагиПоДаннымИзЕПС);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл 
					ЦенныеБумагиПоДаннымИзЕПС.Удалить(УдаляемаяСтрока);
				КонецЦикла;
				
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ЦенныеБумагиПоДаннымИзСЧА, ЦенныеБумаги);
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ЦенныеБумагиПоДаннымИзЕПС, ЦенныеБумаги);
				
			Иначе 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не рассчитана балансовая стоимость депозитов на " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + ". Необходимо закрыть учет по ЕПС за предыдущий день.", , , , Отказ);
				Возврат Ложь;
			КонецЕсли;	
			
		ИначеЕсли ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
			ДополнитьАктивыПоАСДаннымиИзСЧА(ЦенныеБумаги, ПараметрыАктивовПоАС, Отказ);
		ИначеЕсли ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
			ДополнитьАктивыПоАСДаннымиИзЕПС(ЦенныеБумаги, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
		Иначе
			ВызватьИсключение "Цель расчета не поддерживается";
		КонецЕсли;
		
		Облигация_ДП_Роснфт2P7 = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7");
		Для каждого СтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
			Если СтрокаЦенныеБумаги.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПАО_ММВБ") Тогда
				СтрокаЦенныеБумаги.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
			КонецЕсли;
			Если СтрокаЦенныеБумаги.ЦеннаяБумага = Облигация_ДП_Роснфт2P7 Тогда // уникальная и единственная бумага, есть только в портфеле будущего пн, покупалась давно на АС и по нестандартной схеме
				СтрокаЦенныеБумаги.Стоимость = СтрокаЦенныеБумаги.Стоимость + СтрокаЦенныеБумаги.НачальнаяРазницаППНеНаблюдаемыеДанные;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
	ПроверкаРейтингов = Неопределено;
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроверкаРейтингов", ПроверкаРейтингов) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаPD.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ТаблицаPD.СтрокаРейтинга КАК СтрокаРейтинга,
		|	ТаблицаPD.PD КАК PD,
		|	ТаблицаPD.УровеньРейтинга КАК УровеньРейтинга
