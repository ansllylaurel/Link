		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			// Анна Дудова позвонила и сказала что будем учитывать ЗадолженностьПоПогашениюКупонаВВалютеУчета только для Эволюции 2025 и только на 3й стадии. Остальные это вопрос переговоров
			СтрокаРасчетРезервов.EAD = СтрокаРасчетРезервов.EAD + СтрокаАктивы.ЗадолженностьПоПогашениюКупонаВВалютеУчета;
			
			СтрокаРасчетРезервов.PD = 100; // PDdef – вероятность дефолта, равная 100%
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
			
			ДатыПереходаАктиваНаТретьюСтадию = ПолучитьДатуПереходаАктиваНаТретьюСтадию(СтрокаРасчетРезервов.Актив);
			ДнейНахожденияВТретьейСтадии = Макс((НачалоДня(ЭтотОбъект.Дата) - НачалоДня(ДатыПереходаАктиваНаТретьюСтадию)) / (60 * 60 * 24), 365);
			
			//T – максимальный срок нахождения финансового инструмента на Стадии 3, после которого Фонд создает резерв в размере 100% от балансовой стоимости до учета
			//РОКУ(по умолчанию данный срок равняется 1 году для облигаций, расчётных и брокерских счетов, депозитов и дебиторской задолженности по РЕПО
			//и 3 месяца для прочей дебиторской задолженности),
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 * ДнейНахожденияВТретьейСтадии / 365 + СтрокаРасчетРезервов.LGD * (1 - ДнейНахожденияВТретьейСтадии / 365));
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "EAD * 100% * (T_3_stage)/T+LGD * (1-(T_3_stage)/T) (T_3_stage=" + Строка(ДнейНахожденияВТретьейСтадии) + ")";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_ГЕФЕСТ

Процедура ЗаполнитьРезервыГефест(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета)

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("ГефестШкалаPD");
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ				 = Истина;
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
			
			СтрокаАктивы.PD = 0.1; // профсуждение...
			СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета") 
			И СтрокаАктивы.ЦеннаяБумага.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
			
			СтрокаАктивы.PD = 0.1; // профсуждение...
			СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") 
			И СтрокаАктивы.ЦеннаяБумага.РасчетныйСчет.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
			
			СтрокаАктивы.PD = 0.1; // профсуждение...
			СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
			
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
			
			СтрокаАктивы.PD = 0.1; // по методике Гефеста
			СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
			
		КонецЕсли;
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
		
		СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
		
		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
		СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата, ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления,
				НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			ДатаВыкупа = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата);
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВозврата;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВторойЧастиРЕПО;
		Иначе
			ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 1 * 60 * 60 * 24;
		КонецЕсли;
		
		ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
		
		СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
		СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, Мин(ДнейДоПогашения, 365) / 365));
		
		СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, Мин(ДнейДоПогашения, 365) / 365));
		
		СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
		
		СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (1 - PD / 100)^(min(ДнейДоПогашения, 365)/365))";
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;
		
КонецПроцедуры

Процедура ЗаполнитьРезервыГефест2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("ГефестШкалаPD2025");
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ				 = Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//Вероятность дефолта (PD) Российской Федерации в лице Министерства Финансов приравнивается к верхнеуровневому внутреннему рейтингу ААА.
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	// •	снижение внутреннего рейтинга на 2 и более уровня по сравнению с моментом первоначального признания
	МинимальноеКоличествоПереходов = 2; 
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") 
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
				КонецЦикла;	
				// По денежным средствам на специальных брокерских счетах, открытых в кредитных организациях, в том числе в НКО НКЦ, кредитный рейтинг определяется на основании кредитного рейтинга кредитной организации и НКО НКЦ.	
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
				
				СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
				
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				СтрокаАктивы.PD = ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Дата), СтрокаАктивы.Эмитент, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
				
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета") 
				И СтрокаАктивы.ЦеннаяБумага.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
				
				СтрокаАктивы.PD = 0.1; // профсуждение...
				СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
				
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") 
				И СтрокаАктивы.ЦеннаяБумага.РасчетныйСчет.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
				
				СтрокаАктивы.PD = 0.1; // профсуждение...
				СтрокаАктивы.ЗначениеРейтинга = "Профсуждение";
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// Из таблицы в Приложение № 8 к Правилам определения стоимости чистых активов АО НПФ ПСБ
				
				СтрокаАктивы.PD	= 50;
				
			КонецЕсли;
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
			СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
				// 3. признание дефолта/банкротства
				// 4. для российских объектов рейтинга - ruBB+» по национальной шкале АО «Эксперт РА», либо «BB+(RU)» по национальной шкале АКРА (АО), либо «BB+|ru|» по национальной шкале ООО «НРА», либо «BB+.ru» по национальной шкале ООО «НКР»;
				
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			ИначеЕсли СтрокаАктивы.УровеньРейтинга > 11 И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				//для российских объектов рейтинга - ruBB+» по национальной шкале АО «Эксперт РА», либо «BB+(RU)» по национальной шкале АКРА (АО), либо «BB+|ru|» по национальной шкале ООО «НРА», либо «BB+.ru» по национальной шкале ООО «НКР»;
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				
				// теперь на стадию 2	
			ИначеЕсли СтрокаАктивы.УровеньРейтинга > 10 И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				//•	снижение внутреннего рейтинга ниже уровня ВВВ-.
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// •	снижение внутреннего рейтинга на 2 и более уровня по сравнению с моментом первоначального признания;
				// В зависимости от вида активов опеределяем дату первоначального признания
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата, , ЭтотОбъект.СчетДоверительногоУправления,
				НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
				ДатаВыкупа = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата);
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
				ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВозврата;
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВторойЧастиРЕПО;
			Иначе
				//Приложение № 8
				//к Правилам определения стоимости чистых активов
				//Методика оценки кредитного риска контрагента
				//Для финансовых инструментов сроком погашения «до востребования», а также для задолженности по процентному доходу на остаток по расчетному счету (за исключением задолженности по процентам по соглашениям НСО),
				//срок жизненного цикла (T-t_0) составляет 1 (один) день.
				ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 1 * 60 * 60 * 24;
			КонецЕсли;
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// если срок погашения более 1 (одного) года, то применяется вероятность дефолта (PDi) на 1 (один) год (срок жизненного цикла (T-t_0) составляет 365 дней
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * PD Lifetime";
				
			Иначе
			
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (1 - PD / 100)^(ДнейДоПогашения/365))";
				
			КонецЕсли;	
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			// Размер ожидаемых кредитных убытков рассчитывается за весь срок жизненного цикла 
			
			//Уровень LGD принимается равным 100% по финансовым инструментам, имеющим хотя бы один из признаков значительного увеличения кредитного риска и/или признаков обесценения.
			СтрокаРасчетРезервов.LGD = 1;
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, СтрокаРасчетРезервов.ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, СтрокаРасчетРезервов.ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (1 - PD / 100)^(ДнейДоПогашения/365))";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			//Уровень LGD принимается равным 100% по финансовым инструментам, имеющим хотя бы один из признаков значительного увеличения кредитного риска и/или признаков обесценения.
			СтрокаРасчетРезервов.LGD = 1;
			
			//По банковским депозитам и облигациям, оцениваемым по амортизированной стоимости или справедливой стоимости через прочий совокупный доход
			Если ТипЗнч(СтрокаРасчетРезервов.Актив) = Тип("СправочникСсылка.Облигации") Или ТипЗнч(СтрокаРасчетРезервов.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
				//резерв под ожидаемые кредитные убытки рассчитывается как разницу между амортизированной стоимостью финансового инструмента до корректировки на величину резерва под ожидаемые кредитные убытки 
				//и приведенной стоимостью расчетных будущих денежных потоков, дисконтированных с использованием первоначальной ЭСП
				
			Иначе 
				//По денежным средствам на расчетных счетах (в том числе задолженности по процентному доходу на остаток по расчетному счету, по процентам по соглашениям НСО),
				//денежным средствам на брокерских счетах, дебиторской задолженности по сделкам РЕПО
				
				
			КонецЕсли;
			
			
			//СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365));
			//
			//СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			//СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD)^((T-t)⁄365))";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_РОСТЕХ

Процедура ЗаполнитьРезервыРостех(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета)

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("РостехШкалаPD", Истина);
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	Если ЭтотОбъект.Дата >= '20251203' Тогда // перечитали их правила. Всё же вернее будет так - только на погашения по 502 и 504 счетам. Обратили внимание с 03.12 поэтому с этой даты и меняем
		ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАС	 = Истина;
	Иначе	
		ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	КонецЕсли;	
	Если ЭтотОбъект.Дата >= '20250423' И ЭтотОбъект.Дата <= '20251231' Тогда // в правилах на 2026 год слово "балансовая" убрали.
		ПараметрыАктивовПоАС.ДепозитыДляСЧАПоБалансовойСтоимости			 = Истина;
	КонецЕсли;	
	// Письмо Ушакова ОВ (начальник финансово-инвестиционного отдела нпф) от 050625
	Если ЭтотОбъект.Дата >= '20250604' Тогда
		ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Истина;
	КонецЕсли;	
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыПоАС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивыПоАС.Эмитент КАК Эмитент,
		|	_АктивыПоАС.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_АктивыПоАС.Партия КАК Партия,
		|	_АктивыПоАС.СтрокаПартии КАК СтрокаПартии,
		|	_АктивыПоАС.Количество КАК Количество,
		|	_АктивыПоАС.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	_АктивыПоАС.СтадияОбесценения КАК СтадияОбесценения,
		|	_АктивыПоАС.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_АктивыПоАС.LGD КАК LGD,
		|	_АктивыПоАС.PD КАК PD,
		|	_АктивыПоАС.ПрогнозРейтинга КАК ПрогнозРейтинга,
		|	_АктивыПоАС.УровеньРейтинга КАК УровеньРейтинга,
		|	_АктивыПоАС.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_АктивыПоАС.ВалютаНоминала КАК ВалютаНоминала,
		|	_АктивыПоАС.СтрокаСопоставления КАК СтрокаСопоставления,
		|	_АктивыПоАС.АналитикаРезерва КАК АналитикаРезерва
		|ПОМЕСТИТЬ _АктивыПоАС
		|ИЗ
		|	&АктивыПоАС КАК _АктивыПоАС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыПоАС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_АктивыПоАС.Эмитент КАК Эмитент,
		|	_АктивыПоАС.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_АктивыПоАС.Партия КАК Партия,
		|	_АктивыПоАС.СтрокаПартии КАК СтрокаПартии,
		|	_АктивыПоАС.Количество КАК Количество,
		|	_АктивыПоАС.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	_АктивыПоАС.СтадияОбесценения КАК СтадияОбесценения,
		|	_АктивыПоАС.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_АктивыПоАС.LGD КАК LGD,
		|	_АктивыПоАС.PD КАК PD,
		|	_АктивыПоАС.ПрогнозРейтинга КАК ПрогнозРейтинга,
		|	_АктивыПоАС.УровеньРейтинга КАК УровеньРейтинга,
		|	_АктивыПоАС.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_АктивыПоАС.СтрокаСопоставления КАК СтрокаСопоставления,
		|	_АктивыПоАС.ВалютаНоминала КАК ВалютаНоминала,
		|	_АктивыПоАС.АналитикаРезерва КАК АналитикаРезерва
		|ИЗ
		|	_АктивыПоАС КАК _АктивыПоАС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|				&ДатаРасчета,
		|				ДатаНачалаДействияУсловий <= &ДатаРасчета
		|					И Организация = &Организация) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО _АктивыПоАС.ЦеннаяБумага = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|			И (УсловияКредитныхИнструментовСрезПоследних.Действует)
		|ГДЕ
		|	(УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив ЕСТЬ NULL
		|			ИЛИ УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоСС))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("АктивыПоАС", АктивыПоАС);
	Запрос.УстановитьПараметр("ДатаРасчета", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АктивыПоАС = РезультатЗапроса.Выгрузить();
	
	//#627835. Приравнивать к наивысшему рейтингу по госбумагам в национальной шкале.
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") // Ростех не учитывает РЕПО по своей методике
			И ЭтотОбъект.Дата < '20250101' Тогда  // А с 2025 в задаче #581456 передумали
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
			Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
			И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
			//#627835. Приравнивать к наивысшему рейтингу по госбумагам в национальной шкале.
			Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
				СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
			КонецЦикла;	
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
		
		СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;

		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		
		Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		КонецЕсли;
		
		СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
		СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;
		
		Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда // профсуждение
			СтрокаРасчетРезервов.PDНач = 4.08;
			СтрокаРасчетРезервов.LGDНач = 38.2;	
		ИначеЕсли СтрокаРасчетРезервов.Лицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ЕвразХолдингФинанс")
			И (ТипЗнч(СтрокаРасчетРезервов.Актив) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаРасчетРезервов.Актив) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")) Тогда 
			// Рейтинги поручителя НТМК
			СтрокаРасчетРезервов.PDНач = 0.28;
			СтрокаРасчетРезервов.ЗначениеРейтинга = "AA+(RU)";
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
			// Письмо №02-08/808 от 22 мая 2025 г..
			// срок для определения вероятности дефолта (показатель t) составляет 18 рабочих дней от даты фиксации реестра (в календарных днях)
			ДатаВыкупа = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(СтрокаАктивы.ЦеннаяБумага.ДатаРеестра) + 1, 18);
		Иначе	
			ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);		
		КонецЕсли;	
		
		ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
		
		Если ЭтотОбъект.Дата < '20250213' // Ростехи не хотят пересчитывать январь и просят до 13.2.25 (исключая)  считать ЛЮБЫЕ РЕПО на срок 1 день (был косяк) - с Аней согласовано
			И ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		
			ДнейДоПогашения = 1;
		
		КонецЕсли;
		
		СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
		СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			СтрокаРасчетРезервов.PD = 1;
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			СтрокаРасчетРезервов.PD = 1 - Pow(1 - СтрокаРасчетРезервов.PDНач / 100, Мин(ДнейДоПогашения, 365) / 365);
			
			// в методике от 23.12.2024 с 2025 года:
			// 6.3.1.1 Полученная вероятность дефолта PDt округляется до 2-х знаков после запятой в процентах (до 4-х знаков после запятой в долях).
			// Ростехи не хотят пересчитывать январь и просят применить договоренность с 14.2.25 - согласовано с Аней
			Если ЭтотОбъект.Дата >= '20250214' Тогда
				СтрокаРасчетРезервов.PD = Окр(СтрокаРасчетРезервов.PD, 4);	
			КонецЕсли;	
		КонецЕсли;
		
		Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда // профсуждение
			СтрокаРасчетРезервов.LGD = 100 - СтрокаРасчетРезервов.LGDНач;	
		ИначеЕсли СтрокаРасчетРезервов.PDНач <= 0.05 Тогда
			СтрокаРасчетРезервов.LGD = 100 - 37.2;
		ИначеЕсли СтрокаРасчетРезервов.PDНач <= 0.11 Тогда
			СтрокаРасчетРезервов.LGD = 100 - 35.1;
		ИначеЕсли СтрокаРасчетРезервов.PDНач <= 0.21 Тогда
			СтрокаРасчетРезервов.LGD = 100 - 42.3;
		ИначеЕсли СтрокаРасчетРезервов.PDНач <= 0.80 Тогда
			СтрокаРасчетРезервов.LGD = 100 - 43.2;
		ИначеЕсли СтрокаРасчетРезервов.PDНач <= 3.42 Тогда
			СтрокаРасчетРезервов.LGD = 100 - 37.0;
		Иначе
			СтрокаРасчетРезервов.LGD = 100 - 38.3;
		КонецЕсли;
		
		СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
		Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
				СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
			КонецЕсли;	
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
				СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
			КонецЕсли;	
			СтрокаРасчетРезервов.Профсуждение = Истина;
		КонецЕсли;	
		
		СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
		
		СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
		
		СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (1 - PD / 100)^(min(ДнейДоПогашения, 365)/365))";
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD / 100 * СтрокаРасчетРезервов.PD, 2);	
		Иначе	
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD / 100 * СтрокаРасчетРезервов.PD;
		КонецЕсли;	
		
	КонецЦикла;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;
		
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_АТОМГАРАНТ

Процедура ЗаполнитьРезервыАтомгарант(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета)

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
		
		ТаблицаPD = ПолучитьТаблицуPD("АтомгарантШкалаPD_05_2025", Ложь);
		
		ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов("АтомгарантШкалаPD_05_2025");
		
	Иначе
		
		ТаблицаPD = ПолучитьТаблицуPD("АтомгарантШкалаPD", Ложь);
		
		ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов("АтомгарантШкалаPD");
		
	КонецЕсли;
	
	СопоставлениеВесовПрогнозовИБуквенногоИдентификатора = АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора();
	
	PD_PIT_FLI_НаОсновеРейтингаИПрогноза = АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза();
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.ВМНОУчитыватьВсюСумму								 = Истина;
	ПараметрыАктивовПоАС.УчитыватьPutОферту									 = Истина;
	ПараметрыАктивовПоАС.МНОРаздельныйУчетПроцентовИТела					 = Истина;
	Если НачалоДня(ЭтотОбъект.Дата) < Дата(2025, 05, 28) Тогда
		ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПолномуПогашению 	 = Истина;
	Иначе
		ПараметрыАктивовПоАС.НачислятьРезервНаДЗТолькоПоПогашениюЦБПоАСИССсДатыСписания = Истина;
	КонецЕсли;	
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// По государственным облигациям принимает что рейтинг AAA, сразу же находим это значение и запоминает его
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
    ТаблицаКоличестваПереходовГосударственныхОблигаций = ТаблицаКоличестваПереходов.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		ЭтоГосБумага = Ложь;
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
			Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
			И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
			Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
				СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD; // Тут PD_TTC
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
			КонецЦикла;	
			ЭтоГосБумага = Истина;
			
		ИначеЕсли СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
			
			// профсуждение...
			СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
			Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
				СтрокаАктивы.PD = 0.1304;
			Иначе
				СтрокаАктивы.PD = 0.1397;
			КонецЕсли;	
			СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
			СтрокаАктивы.УровеньРейтинга = 1;
			СтрокаАктивы.СтрокаСопоставления = 1;
			СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";

		ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда // Нет рейтинга у юридического лица (средняя вероятность дефолта для рейтинговых групп 8-16)
			Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
				// Из PD_Standart (01.01.2025).xlsx, закладка PD_PIT_12m, строка 22
				СтрокаАктивы.PD	= 5.3914; // Тут PD_TTC
			Иначе	
				// Из PD_расчет (01.01.2024).xlsx, закладка PD_PIT_12m, строка 23
				СтрокаАктивы.PD	= 5.4876; // Тут PD_TTC
			КонецЕсли;
			
		КонецЕсли;		
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
	
		
		СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;

		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		
		// Прежде всего разберемся со стадией
		// Стадии всего три, и по методике, и по МСФО, в зависимости от стадии сильно разнятся формулы расчетов
		// В методике это описано в разделе 4. ОПРЕДЕЛЕНИЕ СТАДИЙ ОБЕСЦЕНЕНИЯ
		
		// Сначала профсуждения
		Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		// затем проверим на стадию 3 как на самую сильную:
		// 1. рейтинг д
		// 2. есть реструктуризация
		ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
			Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
			Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
			Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Реструктуризация = Истина;
		Иначе
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			// Один из доступных нам критериев перехода на стадию 2, это:
			// "Ухудшение группы кредитного качества контрагента на дату расчета резерва под ОКУ по сравнению с датой первоначального признания"
			// Остальные нам не доступны и могут быть введены только профсуждением
			
			Если ЗначениеЗаполнено(СтрокаАктивы.ДатаПервоначальногоПризнания) Тогда 
				ДатаПП = Макс(СтрокаАктивы.ДатаПервоначальногоПризнания, СтрокаАктивы.ДатаPutОферты); 
			Иначе
				ДатаПП = Неопределено;
			КонецЕсли;	
			
			Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
				УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
				
				// В зависимости от рейтинга при начальном признании определяется минимальное количество переходов для ухудшения качества и перехода на стадию 2
				// Кол-во переходов задано в Таблице 5 методики и сохранено в макете АтомгарантШкалаPD
				Если Не ЭтоГосБумага Тогда
					МинимальноеКоличествоПереходов = ПолучитьМинимальноеКоличествоПереходовАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаКоличестваПереходов);
				Иначе
					Для Каждого СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций Из ТаблицаКоличестваПереходовГосударственныхОблигаций Цикл
						МинимальноеКоличествоПереходов = СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций.МинимальноеКоличествоПереходов;
					КонецЦикла;	
				КонецЕсли;	
				
				Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
					СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
					СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Проверим не был ли переход с бОльших стадий, и нет ли необходимости перевода на стадию наблюдения
		Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Или СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
			СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
				
				Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
					СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
					
					Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
						Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 180 Тогда
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
                        КонецЕсли;
					Иначе
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
					КонецЕсли;	
					
                КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
	
		// Потом определим LGD 
		//Для следующих сегментов:
		//•	денежные средства, размещенные на банковских (расчетных, валютных) счетах в кредитных организациях;
		//•	денежные средства на брокерских счетах;
		//•	денежные средства на депозитах/ денежные средства, размещенные по соглашению о неснижаемом остатке,
		//применяется консервативная предпосылка о невозвратности вложений в данные активы в случае дефолта, и LGD принимается равным 100%.
		//
		//2.	Долговые ценные бумаги
		//2.1.	Контрагент является сувереном	47,0%
		//2.2.	Контрагент не является сувереном	62,4%
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
			
			СтрокаРасчетРезервов.LGD = 1;
			
		ИначеЕсли СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
			
			СтрокаРасчетРезервов.LGD = 0.47;
			
		Иначе	
			
			СтрокаРасчетРезервов.LGD = 0.624;
			
		КонецЕсли;	
		
		СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
		Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
				СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
			КонецЕсли;	
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
				СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
			КонецЕсли;	
			СтрокаРасчетРезервов.Профсуждение = Истина;
		КонецЕсли;	
		
		// А теперь расчеты
		// Сразу определим дату окончания денежного потока по ценной бумаге, она (вернее срок до года или более) потом на каждой стадии будет сильно влиять на способ и даже формулу расчета
		// 7.2.5 для денежных средств 1 день
		// по процентному (купонному) доходу, частичному/ полному погашению эмитентом основного долга по долговым ценным бумагам – 3 дня 
		// по выплате дивидендов по акциям, дохода по депозитарным распискам – 30 дней 
		
		// UPD: С 2026 года все упоминания про рабочие и календарные дни из методики убрали. Путаница ушла. Теперь все только календарные.
		
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")) И НачалоДня(ЭтотОбъект.Дата) >= '20250129' Тогда
			ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 3 * 60 * 60 * 24;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда	
			ДатаВыкупа = НачалоДня(СтрокаАктивы.ЦеннаяБумага.Дата) + 30  * 60 * 60 * 24;
		Иначе	
			ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
		КонецЕсли;	
		
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		
		// В зависимости от стадии, вида актива, срока определяется формула и способ расчета
		// В сроках до года обычно участвует величина так называемая PD_PIT_FLI
		// Она определяется на основании Номера рейтинга агенств из макета АтомгарантШкалаPD (Таблица 5. Соответствие шкал рейтингов различных рейтинговых агентств)
		// И буквенного идентификатора прогноза из макета (АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора) - данный буквенный идентификатор зависит от колва прогнозов (негативный, позитивный)
		// Их строковая конкатенация дает "Идентификатор рейтинг-прогноз" который выглядит как 1A, 2C, 3D и т.д.
		// И по этому идентификатору по макету "АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза" подбирается значение PD_PIT_FLI
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			
			БуквенныйИдентификаторРейтингПрогноз = АтомгарантПолучитьБуквенныйИдентификаторРейтингПрогноза(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, СопоставлениеВесовПрогнозовИБуквенногоИдентификатора);
			Если ЭтоГосБумага Тогда
				Для Каждого СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций Из ТаблицаКоличестваПереходовГосударственныхОблигаций Цикл
					НомерРейтинга = СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций.НомерРейтинга;
				КонецЦикла;	
			Иначе	
				НомерРейтинга = АтомгарантНомерРейтингаАктиваНаДату(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаКоличестваПереходов);
			КонецЕсли;	
			
			Если НомерРейтинга = 20 Тогда
				// Из PD_расчет (01.01.2024).xlsx, закладка PD_PIT_12m, строка 23, столбец PD_PIT_12m

				Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
					СтрокаРасчетРезервов.PD = 1.7650; // Тут PD_PIT_FLI
				Иначе	
					СтрокаРасчетРезервов.PD = 0.5965; // Тут PD_PIT_FLI
				КонецЕсли;

			Иначе
				ИдентификаторРейтингПрогноз = Формат(НомерРейтинга, "ЧЦ=2; ЧДЦ=0; ЧН=0") + БуквенныйИдентификаторРейтингПрогноз;
				
				СтрокиPD_PIT_FLI = PD_PIT_FLI_НаОсновеРейтингаИПрогноза.НайтиСтроки(Новый Структура("ИдентификаторРейтингПрогноз", ИдентификаторРейтингПрогноз));
				
				Если СтрокиPD_PIT_FLI.Количество() = 0 Тогда
					Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
						СтрокаРасчетРезервов.PD = 1.7650; // Тут PD_PIT_FLI
					Иначе	
						СтрокаРасчетРезервов.PD = 0.5965; // Тут PD_PIT_FLI
					КонецЕсли;
				Иначе
					Для Каждого СтрокаPD_PIT_FLI Из СтрокиPD_PIT_FLI Цикл
						СтрокаРасчетРезервов.PD = СтрокаPD_PIT_FLI.PD_PIT_FLI; // Тут PD_PIT_FLI
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			
			Если ДнейДоПогашения >= 365 Тогда
				
				СтрокаРасчетРезервов.КоэффициентРезерва = "PD (PIT_FLI) = " + СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD; // Тут PD_PIT_FLI
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
				
				СтрокаРасчетРезервов.Формула = "EAD * PD/100 * LGD";
				
			Иначе
				
				//7.2.5 Результат расчета 〖PD〗_D выражается в процентах, округляется до 10 знаков после запятой (12 знаков в долевом выражении)
				СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 12) * 100;
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 12) * СтрокаРасчетРезервов.LGD; // Тут PD_PIT_FLI
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
				
				СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
				
			КонецЕсли;	
			
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			
			//Для активов в Стадии 2, со сроком действия не более одного года показатель EAD_i принимается равным валовой балансовой стоимости такого актива на дату расчета резерва под ОКУ.
			
