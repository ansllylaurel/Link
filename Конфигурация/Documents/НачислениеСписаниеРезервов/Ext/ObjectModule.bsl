			СтрокаРасчетРезервов.Формула = "EAD * PD / 100 * LGD * min(ДнейДоПогашения, 365) / 365";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, СтрокаРасчетРезервов.ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, СтрокаРасчетРезервов.ДнейДоПогашения / 365)) * 100;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (PD / 100)^(ДнейДоПогашения/365))";
				
			КонецЕсли;
			
			
			Если НачалоДня(ЭтотОбъект.Дата) >= '20240930' И НачалоДня(ЭтотОбъект.Дата) < '20241031' И СтрокаРасчетРезервов.Актив = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МИБ_003") Тогда 
				//письмо 18758-24-Э от 30.09.24
				//в редакции письма от 01.11.24
				//В нем указана точная PD_lifetime=1.13% на 30.09.24, а по расчету у нас получается 0,011337319
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * 0.0113;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = 0.0113;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				
			ИначеЕсли ЭтотОбъект.Дата >= '20251231' И СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АВТОДОМ1Р2") Тогда //письмо 20625-25-Э от 02.09.2025
				// Эти чудики намудрили и с PD и с офертой. Везде ошибки.
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * 0.2598;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = 0.2598;
