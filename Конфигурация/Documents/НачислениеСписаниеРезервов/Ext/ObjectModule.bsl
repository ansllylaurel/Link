Процедура ЗаполнитьРезервыЭволюция(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета)

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	// подготовим данные для проверки
	БумагиИЭмитентыВДефолте = ПолучитьБумагиИЭмитентыВДефолте();	// Эмитенты30, Эмитенты90, ЭмитентыБольше90, Бумаги30, Бумаги90, БумагиБольше90
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	
	ТаблицаPD = ПолучитьТаблицуPD("ЭволюцияШкалаPD", Истина);
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВнутреннийРейтинг 		 = Истина;
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт")
			ИЛИ СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МИБ_003") Тогда
		
			СтрокаАктивы.PD = 1.55; // профсуждение...
			
		ИначеЕсли СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
			
			СтрокаАктивы.PD = 0.34; // профсуждение...
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета") 
			И СтрокаАктивы.ЦеннаяБумага.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
			
			СтрокаАктивы.PD = 0.34; // профсуждение...
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") 
			И СтрокаАктивы.ЦеннаяБумага.РасчетныйСчет.Банк = ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ") Тогда
			
			СтрокаАктивы.PD = 0.34; // профсуждение...
			
		КонецЕсли;
		
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
		
		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
		СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;
		
		СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
		
		Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда // проверим профсуждения
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Профсуждение = Истина;
			
		// затем проверим на стадию 3 как на самую сильную:
		// 1. внутренний рейтинг ниже В-
		// 2. дефолт длится более 90
		// 3. есть реструктуризация
		ИначеЕсли СтрокаАктивы.PD > 7.17 Тогда															// 1. внутренний рейтинг ниже В-
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		ИначеЕсли БумагиИЭмитентыВДефолте.ЭмитентыБольше90.Найти(СтрокаАктивы.Эмитент) <> Неопределено					// 2. дефолт длится более 90
			ИЛИ БумагиИЭмитентыВДефолте.БумагиБольше90.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.ДлительностьДефолта = "более 90";
		ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 3. есть реструктуризация
			ИЛИ ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Реструктуризация = Истина;
		ИначеЕсли СтрокаАктивы.PD > 2.94 Тогда															// 1. снижение внутреннего рейтинга ниже В+
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		Иначе
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
			
			Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг = Истина;
				УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
				Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньВнутреннегоРейтинга - УровеньРейтингаПП >= 2 Тогда 
					СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
					СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ИНГРАДПАО_003") Тогда
			    ДатаВыкупа = '20231129'; // профсуждение
			Иначе
				НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
					НастройкиУчета,
					СтрокаАктивы.ЦеннаяБумага,
					СтрокаАктивы.УчетныйАктивЕПС,
					СтрокаАктивы.Партия,
					СтрокаАктивы.СтрокаПартии);
				
				Если ЭтотОбъект.Дата < Дата(2024, 9, 30) Тогда
					Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СегежаГрупп_002") Тогда // согласно профсуждению, считаем до оферты эту бумагу
						НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты;
					КонецЕсли;
				ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда // Письмо 18513-24-э от 04.10.2024
					НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты;
				КонецЕсли;	
				
				Если НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
					ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаПогашения;
				Иначе
					ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата, ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления,
						НастройкиУчетаЦеннойБумаги.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчетаЦеннойБумаги.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			ДатаВыкупа = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата);
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВозврата;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВторойЧастиРЕПО;
		Иначе
			ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 7 * 60 * 60 * 24;
		КонецЕсли;
		
		Если ЭтотОбъект.Дата >= '20241031' И СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МИБ_003") Тогда //письмо от 01.11.24
			СтрокаРасчетРезервов.PD = 2.63;
			СтрокаРасчетРезервов.LGD = 1;
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ЭтотОбъект.Дата >= '20240930' И СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МИБ_003") Тогда //письмо 18758-24-Э от 30.09.24
			СтрокаРасчетРезервов.PD = 2;
			СтрокаРасчетРезервов.LGD = 1;
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ЭтотОбъект.Дата >= '20241231' И СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт")
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, КонецДня(ЭтотОбъект.Дата)) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция") Тогда //письмо 320-25-Э от 10.01.2025
			СтрокаРасчетРезервов.PD = 13.05;
			СтрокаРасчетРезервов.LGD = 1;
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;			
			СтрокаРасчетРезервов.Профсуждение = Истина;
			СтрокаРасчетРезервов.ЗначениеРейтинга = "Профсуждение";
		КонецЕсли;	
		
		ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
		
		СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
		СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD * Мин(ДнейДоПогашения, 365) / 365;
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;	
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.Формула = "EAD * PD / 100 * LGD * min(ДнейДоПогашения, 365) / 365";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365));
			
			СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365)) * 100;	
			
			Если НачалоДня(ЭтотОбъект.Дата) >= '20240930' И НачалоДня(ЭтотОбъект.Дата) < '20241031' И СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МИБ_003") Тогда 
				//письмо 18758-24-Э от 30.09.24
				//в редакции письма от 01.11.24
				//В нем указана точная PD_lifetime=1.13% на 30.09.24, а по расчету у нас получается 0,011337319
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * 0.0113;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = 0.0113;	
				
			КонецЕсли;	
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
			СтрокаРасчетРезервов.Формула = "EAD * LGD * (1 - (PD / 100)^(ДнейДоПогашения/365))";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			СтрокаРасчетРезервов.PD = 100; // PDdef – вероятность дефолта, равная 100%
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;	
			
			ДатыПереходаАктиваНаТретьюСтадию = ПолучитьДатуПереходаАктиваНаТретьюСтадию(СтрокаАктивы.ЦеннаяБумага);
			ДнейНахожденияВТретьейСтадии = (НачалоДня(ЭтотОбъект.Дата) - НачалоДня(ДатыПереходаАктиваНаТретьюСтадию)) / (60 * 60 * 24);
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD + (1 - СтрокаРасчетРезервов.LGD) * ДнейНахожденияВТретьейСтадии / 365;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "EAD * LGD + (1 - LGD) * ДнейНаТретьейСтадии / 365 (ДнейНаТретьейСтадии=" + Строка(ДнейНахожденияВТретьейСтадии / 365) + ")";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;
		
КонецПроцедуры

Процедура ЗаполнитьРезервыЭволюция2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	// подготовим данные для проверки
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ТаблицаPD = ПолучитьТаблицуPD("ЭволюцияШкалаPD2025", Ложь);
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы 							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ 										 = Истина;
	ПараметрыАктивовПоАС.ВнутреннийРейтинг 									 = Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			Если СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				
				//2.1.7.	Вероятность дефолта по обязательствам Минфина в рублях принимается равной 0;	
				
				СтрокаАктивы.PD = 0;
				СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
				
			ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// 2.1.8.	В случае невозможности определения ВКР согласно пунктам выше ВКР не определяется,
				// а вероятность дефолта определяется на основании экспертного мнения. 
				
				СтрокаАктивы.PD	= 0;
				
			КонецЕсли;
			
			// письмо, 36738-24-ДБ от 20.12.2024.
			// для прочей дебиторской задолженности по дивидендам, датой первого дня просрочки является:
			// - день, следующий за датой выплаты, определенной решением общего собрания акционеров, или
			// - 61 день со дня принятия решения о выплате дивидендов в случае, если срок выплаты дивидендов решением общего собрания акционеров об их выплате не определен.
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
				// нам доступно только 61 день
				Если НачалоДня(ЭтотОбъект.Дата) < (НачалоДня(СтрокаАктивы.ЦеннаяБумага.ДатаРеестра) + 61 * (60 * 60 * 24)) Тогда
					Продолжить;	
				КонецЕсли;	
			КонецЕсли;
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
			СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда // проверим профсуждения
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				
				// затем проверим на стадию 3 как на самую сильную:
				// 1. внутренний рейтинг D
				// 2. дефолт длится более 90
				// 3. есть реструктуризация
			ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга >= 9 И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда // 1. внутренний рейтинг D
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 3. есть реструктуризация
				ИЛИ ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга > 4 И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда // внутренний кредитный рейтинг ниже BB-														// 1. снижение внутреннего рейтинга ниже BB-
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг = Истина;
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньВнутреннегоРейтинга - УровеньРейтингаПП >= 2 Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ИНГРАДПАО_003") Тогда
					ДатаВыкупа = '20231129'; // профсуждение
				Иначе
					НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
						НастройкиУчета,
						СтрокаАктивы.ЦеннаяБумага,
						СтрокаАктивы.УчетныйАктивЕПС,
						СтрокаАктивы.Партия,
						СтрокаАктивы.СтрокаПартии);
					
					Если ЭтотОбъект.Дата < Дата(2024, 9, 30) Тогда
						Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СегежаГрупп_002") Тогда // согласно профсуждению, считаем до оферты эту бумагу
