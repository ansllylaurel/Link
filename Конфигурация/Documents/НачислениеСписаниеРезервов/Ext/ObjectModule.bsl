		|						КОГДА ТИПЗНАЧЕНИЯ(_АктивыПоАС.ЦеннаяБумага) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|							ТОГДА ВЫРАЗИТЬ(_АктивыПоАС.ЦеннаяБумага КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага = _РейтингиСрезПоследнихАктивов.Субъект
		|						КОГДА ТИПЗНАЧЕНИЯ(_АктивыПоАС.ЦеннаяБумага) = ТИП(Документ.НачислениеДивидендов)
		|							ТОГДА ВЫРАЗИТЬ(_АктивыПоАС.ЦеннаяБумага КАК Документ.НачислениеДивидендов).ЦеннаяБумага = _РейтингиСрезПоследнихАктивов.Субъект
		|					КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихЭмитентов
		|		ПО _АктивыПоАС.Эмитент = _РейтингиСрезПоследнихЭмитентов.Субъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО _АктивыПоАС.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И _АктивыПоАС.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|			И (ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен)
		|			И (НЕ ВводЦенныхБумагЦенныеБумаги.Ссылка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО _АктивыПоАС.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И _АктивыПоАС.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
		|			И (РеклассификацияАктивовЕПСПартии.Ссылка.Проведен)
		|			И (НЕ РеклассификацияАктивовЕПСПартии.Ссылка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияPutОферт КАК _УсловияPutОферт
		|		ПО _АктивыПоАС.ЦеннаяБумага = _УсловияPutОферт.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _АктивыПоАС.ЦеннаяБумага = Облигации.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ТаблицаPD", ТаблицаPD);
		Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("УчитыватьPutОферту", ПараметрыАктивовПоАС.УчитыватьPutОферту);
		Запрос.УстановитьПараметр("ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии", ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии);
		Запрос.УстановитьПараметр("ВалютаУчета", ЭтотОбъект.Организация.ВалютаУчета);
		
		
		Если ПараметрыАктивовПоАС.ВнутреннийРейтинг Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "УровеньРейтинга", "УровеньВнутреннегоРейтинга");
		КонецЕсли;	
		
		Если ПараметрыАктивовПоАС.БратьНаихудшийРейтинг Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ(РейтингиСрезПоследних", "МАКСИМУМ(РейтингиСрезПоследних");
		КонецЕсли;
		
		Если ЭтотОбъект.Дата < '20230531' Тогда
			Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Ложь);
		Иначе
			Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Истина);
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Возврат РезультатЗапроса.Выгрузить();
		
	Иначе
		
		Запрос = Новый Запрос;
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	РейтингиСрезПоследних.Шкала КАК Шкала,
		|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная КАК ШкалаРейтингаЭталонная,
		|	РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга
		|ПОМЕСТИТЬ _Шкалы
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&Период,
		|			РейтинговоеАгентство В (&РейтинговыеАгентства)
		|				И Субъект В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ЦенныеБумаги.Эмитент КАК Эмитент
		|					ИЗ
		|						_ЦенныеБумаги КАК _ЦенныеБумаги
		|					ГДЕ
		|						НЕ _ЦенныеБумаги.Эмитент ЕСТЬ NULL
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ЦенныеБумаги.ЦеннаяБумага
		|					ИЗ
		|						_ЦенныеБумаги КАК _ЦенныеБумаги
		|					ГДЕ
		|						НЕ _ЦенныеБумаги.ЦеннаяБумага ЕСТЬ NULL)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &День)) КАК РейтингиСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&Период, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|ГДЕ
		|	НЕ РейтингиСрезПоследних.ЗначениеРейтинга.РейтингСнят
		|	И (РейтингиСрезПоследних.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Шкалы.Субъект КАК Субъект,
		|	_Шкалы.Шкала КАК Шкала,
		|	_Шкалы.РейтинговоеАгентство КАК РейтинговоеАгентство
		|ИЗ
		|	_Шкалы КАК _Шкалы
		|ГДЕ
		|	_Шкалы.ШкалаРейтингаЭталонная ЕСТЬ NULL";		
		
		РейтинговыеАгентства = Новый Массив;
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.АКРА);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.НКР);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.НРА);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.RAEX);
		
		Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("РейтинговыеАгентства", РейтинговыеАгентства);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		ПоместитьВоВременноеХранилище(РезультатЗапроса, ПроверкаРейтингов);
		
		Отказ = Истина;
		
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета)
	
	АктивыПоАС = Новый ТаблицаЗначений;
	
	АктивыПоАС.Колонки.Добавить("ЦеннаяБумага");
	АктивыПоАС.Колонки.Добавить("Эмитент");
	АктивыПоАС.Колонки.Добавить("УчетныйАктивЕПС");
	АктивыПоАС.Колонки.Добавить("Партия");
	АктивыПоАС.Колонки.Добавить("СтрокаПартии");
	АктивыПоАС.Колонки.Добавить("Количество");
	АктивыПоАС.Колонки.Добавить("СуммаРезервовПодОбесценение");
	АктивыПоАС.Колонки.Добавить("СтадияОбесценения");
	АктивыПоАС.Колонки.Добавить("БалансоваяСтоимость");
	АктивыПоАС.Колонки.Добавить("LGD");
	АктивыПоАС.Колонки.Добавить("PD");
	АктивыПоАС.Колонки.Добавить("ПрогнозРейтинга");
	АктивыПоАС.Колонки.Добавить("УровеньРейтинга");
	АктивыПоАС.Колонки.Добавить("ЗначениеРейтинга");
	АктивыПоАС.Колонки.Добавить("СтрокаСопоставления");
	АктивыПоАС.Колонки.Добавить("АналитикаРезерва");
	АктивыПоАС.Колонки.Добавить("ОценочныеДисконтПремия");
	АктивыПоАС.Колонки.Добавить("ОценочнаяКорректировкаЭСП");
	АктивыПоАС.Колонки.Добавить("ОценочнаяРазницаППНеНаблюдаемыеДанные");
	АктивыПоАС.Колонки.Добавить("ОценочнаяСуммаКупона");
	АктивыПоАС.Колонки.Добавить("НачальнаяРазницаППНеНаблюдаемыеДанные");
	АктивыПоАС.Колонки.Добавить("ЗадолженностьПоПогашениюКупонаВВалютеУчета");
	АктивыПоАС.Колонки.Добавить("ЗадолженностьПоПогашениюТелаВВалютеУчета");
	АктивыПоАС.Колонки.Добавить("УчетныйАктивЕПСРодитель");
	АктивыПоАС.Колонки.Добавить("ДатаПервоначальногоПризнания");
	АктивыПоАС.Колонки.Добавить("ДатаPutОферты");
	АктивыПоАС.Колонки.Добавить("ВалютаНоминала");
	
	СтрокаАктивыПоАС = АктивыПоАС.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаАктивыПоАС, СтрокаПерерасчета); 
	
	СтрокаАктивыПоАС.ЦеннаяБумага = СтрокаПерерасчета.Актив;
	СтрокаАктивыПоАС.БалансоваяСтоимость =	СтрокаПерерасчета.EAD;
	СтрокаАктивыПоАС.ЗадолженностьПоПогашениюКупонаВВалютеУчета = 0;
	СтрокаАктивыПоАС.ЗадолженностьПоПогашениюТелаВВалютеУчета = 0;
	
	Если ТипЗнч(СтрокаАктивыПоАС.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		СтрокаАктивыПоАС.ВалютаНоминала = СтрокаАктивыПоАС.ЦеннаяБумага.ВалютаНоминала;
	Иначе	
		СтрокаАктивыПоАС.ВалютаНоминала = ЭтотОбъект.Организация.ВалютаУчета;
	КонецЕсли;	
	
	Возврат АктивыПоАС;
	
КонецФункции	

Функция ОпределитьГоловнуюОрганизацию(Эмитент)

	Если Справочники.ЮрФизЛица.ПолучитьФункциональныеРоли(Эмитент, "Банки").Количество() = 0 Тогда // не банк
		Возврат Эмитент;
	Иначе
		ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Эмитент, ЭтотОбъект.Дата);
		Если ГоловнаяОрганизация <> Неопределено Тогда
			Возврат ГоловнаяОрганизация;
		Иначе
			Возврат Эмитент;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьДанныеPD(ТаблицаPD, СтрокаРейтинга, ДанныеPD, РейтинговоеАгентство, УровеньРейтинга, УровеньВнутреннегоРейтинга, ДанныеPD2Стадии = Неопределено, ДанныеLGD = Неопределено);

	Если СтрокаРейтинга <> "" Тогда
	
		СтрокаPD = ТаблицаPD.Добавить();
		
		СтрокаPD.РейтинговоеАгентство = РейтинговоеАгентство;
		СтрокаPD.СтрокаРейтинга = СтрокаРейтинга;
		СтрокаPD.УровеньРейтинга = УровеньРейтинга;
		СтрокаPD.УровеньВнутреннегоРейтинга = УровеньВнутреннегоРейтинга;
		СтрокаPD.PD = ДанныеPD;
		
		Если ДанныеPD2Стадии <> Неопределено Тогда
			СтрокаPD.PD2Стадии = ДанныеPD2Стадии;
		КонецЕсли;	
		
		Если ДанныеLGD <> Неопределено Тогда
			СтрокаPD.LGD = ДанныеLGD;
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуPD(ИмяМакета, ИностранныеРейтинги = Ложь, ЕстьPD2Стадии = Ложь, ЕстьLGD = Ложь) Экспорт
	
	ТаблицаPD = Новый ТаблицаЗначений;
	
	ТаблицаPD.Колонки.Добавить("РейтинговоеАгентство",	Новый ОписаниеТипов("СправочникСсылка.РейтинговыеАгентства"));
	ТаблицаPD.Колонки.Добавить("СтрокаРейтинга", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25, ДопустимаяДлина.Переменная)));
	ТаблицаPD.Колонки.Добавить("PD", Новый ОписаниеТипов("Число"));
	ТаблицаPD.Колонки.Добавить("УровеньРейтинга", Новый ОписаниеТипов("Число"));
	ТаблицаPD.Колонки.Добавить("УровеньВнутреннегоРейтинга", Новый ОписаниеТипов("Число"));
	
	Если ЕстьPD2Стадии Тогда
		ТаблицаPD.Колонки.Добавить("PD2Стадии", Новый ОписаниеТипов("Число"));
	КонецЕсли;	
	
	Если ЕстьLGD Тогда
		ТаблицаPD.Колонки.Добавить("LGD", Новый ОписаниеТипов("Число"));
	КонецЕсли;	
	
	МакетТаблицыPD = Документы.НачислениеСписаниеРезервов.ПолучитьМакет(ИмяМакета);
	
	НомСтр = 2;
	НомерУровняВнутреннегоРейтинга = 0;
	СтароеЗначениеPD = "";
	
	СдвигКолонок = ?(ИностранныеРейтинги, 3, 0);
	
	Пока СокрЛП(МакетТаблицыPD.Область(НомСтр, 1).Текст) <> "" Цикл
		
		ДанныеPD = МакетТаблицыPD.Область(НомСтр, 5 + СдвигКолонок).Текст;
		Если СтароеЗначениеPD <> ДанныеPD Тогда
			НомерУровняВнутреннегоРейтинга = НомерУровняВнутреннегоРейтинга + 1;
		КонецЕсли;	
		
		ДанныеPD2Стадии = Неопределено;
		Если ЕстьPD2Стадии Тогда
			ДанныеPD2Стадии = МакетТаблицыPD.Область(НомСтр, 5 + СдвигКолонок + 1).Текст;
		КонецЕсли;	
		
		ДанныеLGD = Неопределено;
		Если ЕстьLGD Тогда
			ДанныеLGD = МакетТаблицыPD.Область(НомСтр, 5 + СдвигКолонок + ?(ЕстьPD2Стадии, 1, 0) + 1).Текст;
		КонецЕсли;	
		
			
		ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 1 + СдвигКолонок).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.АКРА, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
		ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 2 + СдвигКолонок).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.RAEX, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
		ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 3 + СдвигКолонок).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.НКР, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
		ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 4 + СдвигКолонок).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.НРА, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
		
		Если ИностранныеРейтинги Тогда
		
			ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 1).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.StandardAndPoors, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
			ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 2).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.Moodys, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
			ДобавитьДанныеPD(ТаблицаPD, СокрЛП(МакетТаблицыPD.Область(НомСтр, 3).Текст), ДанныеPD, Справочники.РейтинговыеАгентства.FitchRatings, НомСтр - 1, НомерУровняВнутреннегоРейтинга, ДанныеPD2Стадии, ДанныеLGD);
		
		КонецЕсли;
		
		
		НомСтр = НомСтр + 1;
		СтароеЗначениеPD = ДанныеPD;
	
	КонецЦикла;
	
	Возврат ТаблицаPD;
	
КонецФункции

Функция ПолучитьТаблицуРасчетРезервов()
	
	РасчетРезервов = ЭтотОбъект.Партии.ВыгрузитьКолонки();
	
	РасчетРезервов.Колонки.Добавить("Лицо", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	РасчетРезервов.Колонки.Добавить("PDНач", Новый ОписаниеТипов("Число"));
	РасчетРезервов.Колонки.Добавить("LGDНач", Новый ОписаниеТипов("Число"));
	РасчетРезервов.Колонки.Добавить("ДлительностьДефолта", Новый ОписаниеТипов("Строка"));
	РасчетРезервов.Колонки.Добавить("ПадениеРейтингаНа2Стадии", Новый ОписаниеТипов("Булево"));
	РасчетРезервов.Колонки.Добавить("ВалютаНоминала", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Возврат РасчетРезервов;
	
КонецФункции

Функция ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, ЦеннаяБумага, УчетныйАктивЕПС, КоличествоДнейДляДоВостребования = 1, УчитыватьВыходныеИПраздникиДляДатыОкончанияДляДоВостребования = Ложь, СчитатьДоВостребованияВРабочихДнях = Ложь)
	
	ДатаВыкупа = Дата(1,1,1);
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчета, ЦеннаяБумага, УчетныйАктивЕПС);
		Если НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
			ДатаВыкупа = ЦеннаяБумага.ДатаПогашения;
			Если НЕ НастройкиУчетаЦеннойБумаги.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении Тогда
				ПараметрыОферты = Справочники.Облигации.ОбъявленаОбязательнаяДосрочнаяОферта(ЦеннаяБумага, ЭтотОбъект.Дата);
				Если ПараметрыОферты.Объявлена Тогда
					ДатаВыкупа = ПараметрыОферты.ДатаВыкупа;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(ЦеннаяБумага, ЭтотОбъект.Дата, , ЭтотОбъект.СчетДоверительногоУправления,
			НастройкиУчетаЦеннойБумаги.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчетаЦеннойБумаги.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		ДатаВыкупа = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(ЦеннаяБумага, ЭтотОбъект.Дата);
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
		ДатаВыкупа = ЦеннаяБумага.ДатаВозврата;
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		ДатаВыкупа = ЦеннаяБумага.ДатаВторойЧастиРЕПО;
	Иначе
		Если СчитатьДоВостребованияВРабочихДнях Тогда
			// рабочие дни
			ДатаВыкупа = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Дата) + 1, КоличествоДнейДляДоВостребования);
		ИначеЕсли УчитыватьВыходныеИПраздникиДляДатыОкончанияДляДоВостребования Тогда
			// учитываем ближайший праздник или выходной, но далее календарные
			ДатаВыкупа = РаботаСДокументами.СледующийРабочийДень(НачалоДня(ЭтотОбъект.Дата) + (КоличествоДнейДляДоВостребования - 1) * 60 * 60 * 24);
		Иначе
			// календарные дни
			ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + КоличествоДнейДляДоВостребования * 60 * 60 * 24;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ДатаВыкупа;
	
КонецФункции

Функция ПолучитьДанныеРеструктуризаций()

	ДанныеРеструктуризаций = БухгалтерскийУчетЕПС.ПолучитьОблигацииСРеструктуризациейПлатежей(НачалоДня(ЭтотОбъект.Дата));
	ДанныеРеструктуризаций6месяцевНазад = БухгалтерскийУчетЕПС.ПолучитьОблигацииСРеструктуризациейПлатежей(ДобавитьМесяц(НачалоДня(ЭтотОбъект.Дата), -6));
	
	БумагиСРеструктуризацией = ДанныеРеструктуризаций.ВыгрузитьКолонку("Облигация");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(БумагиСРеструктуризацией);
	
	ЭмитентыСРеструктуризацией = ДанныеРеструктуризаций.ВыгрузитьКолонку("Эмитент");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(ЭмитентыСРеструктуризацией);
	
	БумагиСРеструктуризацией6месяцевНазад = ДанныеРеструктуризаций6месяцевНазад.ВыгрузитьКолонку("Облигация");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(БумагиСРеструктуризацией6месяцевНазад);
	
	ЭмитентыСРеструктуризацией6месяцевНазад = ДанныеРеструктуризаций6месяцевНазад.ВыгрузитьКолонку("Эмитент");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(ЭмитентыСРеструктуризацией6месяцевНазад);
	
	Возврат Новый Структура("БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад",
					БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад);

	
КонецФункции

Процедура ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СтрокаРейтинга, МинимальноеКоличествоПереходов, РейтинговоеАгентство, НомерРейтинга);

	Если СтрокаРейтинга <> "" Тогда
	
		СтрокаКоличестваПереходов = ТаблицаКоличестваПереходов.Добавить();
		
		СтрокаКоличестваПереходов.РейтинговоеАгентство = РейтинговоеАгентство;
		СтрокаКоличестваПереходов.СтрокаРейтинга = СтрокаРейтинга;
		СтрокаКоличестваПереходов.МинимальноеКоличествоПереходов = МинимальноеКоличествоПереходов;
		СтрокаКоличестваПереходов.НомерРейтинга = НомерРейтинга;
	
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуКоличестваПереходов(ИмяМакета, ИностранныеРейтинги = Ложь)
	
	ТаблицаКоличестваПереходов = Новый ТаблицаЗначений;
	ТаблицаКоличестваПереходов.Колонки.Добавить("РейтинговоеАгентство",	Новый ОписаниеТипов("СправочникСсылка.РейтинговыеАгентства"));
	ТаблицаКоличестваПереходов.Колонки.Добавить("СтрокаРейтинга", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25, ДопустимаяДлина.Переменная)));
	ТаблицаКоличестваПереходов.Колонки.Добавить("НомерРейтинга", Новый ОписаниеТипов("Число"));
	ТаблицаКоличестваПереходов.Колонки.Добавить("МинимальноеКоличествоПереходов", Новый ОписаниеТипов("Число"));
	
	МакетТаблицы = Документы.НачислениеСписаниеРезервов.ПолучитьМакет(ИмяМакета);
	
	НомСтр = 2;
	
	СдвигКолонок = ?(ИностранныеРейтинги, 3, 0);
	
	Пока СокрЛП(МакетТаблицы.Область(НомСтр, 1).Текст) <> "" Цикл
		
		МинимальноеКоличествоПереходов = МакетТаблицы.Область(НомСтр, 6 + СдвигКолонок).Текст;
		НомерРейтинга = МакетТаблицы.Область(НомСтр, 7 + СдвигКолонок).Текст;
			
		ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 1 + СдвигКолонок).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.АКРА, НомерРейтинга);
		ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 2 + СдвигКолонок).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.RAEX, НомерРейтинга);
		ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 3 + СдвигКолонок).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.НКР, НомерРейтинга);
		ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 4 + СдвигКолонок).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.НРА, НомерРейтинга);
		
		Если ИностранныеРейтинги Тогда
		
			ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 1).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.StandardAndPoors, НомерРейтинга);
			ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 2).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.Moodys, НомерРейтинга);
			ДобавитьДанныеКоличестваПереходов(ТаблицаКоличестваПереходов, СокрЛП(МакетТаблицы.Область(НомСтр, 3).Текст), МинимальноеКоличествоПереходов, Справочники.РейтинговыеАгентства.FitchRatings, НомерРейтинга);
		
		КонецЕсли;
		
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	Возврат ТаблицаКоличестваПереходов;
	
КонецФункции

// Функция реализована на основе РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость
// главное отличие это наличие двух PD (PD_TTC и PD_PIT_FLI) при расчете дисконтированного потока,
// если срок этого денежного потока менее 365 дней то применяется PD_PIT_FLI, а если более то PD_TTC
Функция РассчитатьДисконтированнуюСтоимостьСВероятностьюДефолта(ДенежныйПоток, Количество, СтавкаДисконтирования, ПараметрыОценки = Неопределено, Отказ = Ложь, PD_TTC, PD_PIT_FLI)

	#Область Проверка_и_обработка_входящих_параметров
	
	Если ТипЗнч(ДенежныйПоток) <> Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Некорректное значение параметра денежный поток '%1'", ТипЗнч(ДенежныйПоток)), , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ТочностьДисконтированногоПотока	= Неопределено;
	ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ПустаяСсылка();
	
	Если ТипЗнч(ПараметрыОценки) = Тип("Структура") Тогда
		ПараметрыОценки.Свойство("ТочностьДисконтированногоПотока",	ТочностьДисконтированногоПотока);
		ПараметрыОценки.Свойство("ВариантРасчетаОжидаемыхКредитныхУбытков",	ВариантРасчетаОжидаемыхКредитныхУбытков);
	КонецЕсли;
	
	#КонецОбласти
	
	БудущиеПотоки = ДенежныйПоток.Скопировать(, "Дата, Поток");
	
	БудущиеПотоки.Колонки.Добавить("КоличествоДней",		Новый ОписаниеТипов("Число"));
	БудущиеПотоки.Колонки.Добавить("ДисконтированныйПоток",	Новый ОписаниеТипов("Число"));
	
	Для Каждого Поток Из БудущиеПотоки Цикл
		
		Поток.КоличествоДней = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(Поток.Дата, ЭтотОбъект.Дата);
		
		Если ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Атомгарант Тогда // Атомгарант
			ДисконтированныйПоток = (1 - Pow((1 - ?(Поток.КоличествоДней <= 365, PD_PIT_FLI, PD_TTC)/100), Поток.КоличествоДней/365)) * Поток.Поток / Pow(1 + СтавкаДисконтирования / 100, Поток.КоличествоДней / 365) * Количество;
		ИначеЕсли ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Сбербанк Тогда // Сбербанк	
			PD_t = Окр(1 - Pow((1 - PD_PIT_FLI), Мин(Поток.КоличествоДней / 365, 1)) * Pow((1 - PD_TTC), Макс(0, (Поток.КоличествоДней / 365) - 1)), 10);
			
			Если Поток.КоличествоДней < 365 Тогда
				ДисконтированныйПоток = PD_t * Поток.Поток * Количество;
			Иначе
				ДисконтированныйПоток = PD_t * Поток.Поток / Pow(1 + СтавкаДисконтирования / 100, Поток.КоличествоДней / 365) * Количество;
			КонецЕсли;	
		Иначе
			ДисконтированныйПоток = 0;
		КонецЕсли;
		
		Поток.ДисконтированныйПоток = ?(ТочностьДисконтированногоПотока = Неопределено, ДисконтированныйПоток, Окр(ДисконтированныйПоток, ТочностьДисконтированногоПотока));  
		
	КонецЦикла;
	
	Возврат БудущиеПотоки.Итог("ДисконтированныйПоток");
	
КонецФункции

Функция ПолучитьПредставлениеВидаРезерва(ЦеннаяБумага, Эмитент)
	
	ПредставлениеВидаРезерва = "";
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		
		ПредставлениеВидаРезерва = "Долговые ценные бумаги";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		
		ПредставлениеВидаРезерва = "Депозиты в кредитных организациях";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
		
		ПредставлениеВидаРезерва = "МНО";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		
		ПредставлениеВидаРезерва = "РЕПО";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.БрокерскиеКомпании")	Тогда
		
		ПредставлениеВидаРезерва = "Брокерский счет";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета")	Тогда
		
		ПредставлениеВидаРезерва = "Расчетный счет";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") Или ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Или ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов")	Тогда
		
		ПредставлениеВидаРезерва = "Дебиторская задолженность";
		
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Биржи") Или ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ")	Тогда
		
		ПредставлениеВидаРезерва = "Клиринговый счет";
		
	Иначе
		
		
	КонецЕсли;		
		
	Возврат ПредставлениеВидаРезерва;
	
КонецФункции	

Функция ПолучитьПереченьОбъектов(ВидПеречня, ВнешняяСистема, РодительскийПеречень = Ложь)

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПеречниОбъектовСрезПоследних.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ПеречниОбъектов.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ВидПеречня = &ВидПеречня) КАК ПеречниОбъектовСрезПоследних
		|ГДЕ
		|	ПеречниОбъектовСрезПоследних.Включен";
	
	Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ВидПеречня", ВидПеречня);
	Запрос.УстановитьПараметр("ВнешняяСистема", ВнешняяСистема);
	
	Если РодительскийПеречень Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " ВидПеречня", " ВидПеречня.Родитель");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Объект");

КонецФункции 

Функция ПолучитьПрофсужденияПоСтадиямОбесценения()

	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОценкиСтоимостиЦенныхБумагСрезПоследних.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _Стадии
		|ИЗ
		|	РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних(
		|			&День,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&День, ДЕНЬ)
		|	И ОценкиСтоимостиЦенныхБумагСрезПоследних.СтадияОбесценения <> ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Стадии.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Стадия1
		|ИЗ
		|	_Стадии КАК _Стадии
		|ГДЕ
		|	_Стадии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Стадии.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Стадия2
		|ИЗ
		|	_Стадии КАК _Стадии
		|ГДЕ
		|	_Стадии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия2)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Стадии.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Стадия3
		|ИЗ
		|	_Стадии КАК _Стадии
		|ГДЕ
		|	_Стадии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия3)";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Дата));
	
	Запрос.Выполнить();
	
	Стадия1 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Стадия1"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	Стадия2 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Стадия2"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	Стадия3 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Стадия3"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
	Возврат Новый Структура("Стадия1, Стадия2, Стадия3", Стадия1, Стадия2, Стадия3);

КонецФункции

