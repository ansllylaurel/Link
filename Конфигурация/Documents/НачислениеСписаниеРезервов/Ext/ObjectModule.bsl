				// 2.3.3 t – количество дней до даты погашения ФИ. Для финансовых инструментов «до востребования», не имеющих даты погашения ФИ, коэффициент t принимается равным 7 дням.
				ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 7 * 60 * 60 * 24;
