				// письмо от 09.01.2024: при размещения денежных средств на счетах, открываемых центральным контрагентом для целей клиринга
				// -  внутренний кредитный рейтинг (далее – ВКР) определятся через кредитный рейтинг центрального контрагента АО «НКО НКЦ»
				
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
