						КонецЕсли;
						
					Иначе
						ИдентификаторРейтингПрогноз = Формат(НомерРейтинга, "ЧЦ=2; ЧДЦ=0; ЧН=0") + БуквенныйИдентификаторРейтингПрогноз;
						
						СтрокиPD_PIT_FLI = PD_PIT_FLI_НаОсновеРейтингаИПрогноза.НайтиСтроки(Новый Структура("ИдентификаторРейтингПрогноз", ИдентификаторРейтингПрогноз));
						
						Если СтрокиPD_PIT_FLI.Количество() = 0 Тогда
							Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
								СтрокаРасчетРезервов.PD = 1.7650; // Тут PD_PIT_FLI
							Иначе	
								СтрокаРасчетРезервов.PD = 0.5965; // Тут PD_PIT_FLI
							КонецЕсли;
						Иначе
							Для Каждого СтрокаPD_PIT_FLI Из СтрокиPD_PIT_FLI Цикл
								СтрокаРасчетРезервов.PD = СтрокаPD_PIT_FLI.PD_PIT_FLI; // Тут PD_PIT_FLI
							КонецЦикла;	
						КонецЕсли;	
					КонецЕсли;	
					
					СтрокаРасчетРезервов.КоэффициентРезерва = "PD (PIT_FLI) = " + PD_PIT_FLI;
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;  // Тут PD_PIT_FLI
					
					СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
					
					СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
					
				КонецЕсли;
			Иначе
				ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
				
				СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
				СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
				
				Если ДнейДоПогашения >= 365 Тогда
					
					СтрокаРасчетРезервов.КоэффициентРезерва = "PD (TTC) = " + СтрокаРасчетРезервов.PD;
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения/365)) * СтрокаРасчетРезервов.LGD; //PD_TTC
					
					СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
					
					СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
					
					
				Иначе	
					// До года на 2й стадии тоже берется PD_PIT_FLI а не PD_TTC
					БуквенныйИдентификаторРейтингПрогноз = АтомгарантПолучитьБуквенныйИдентификаторРейтингПрогноза(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, СопоставлениеВесовПрогнозовИБуквенногоИдентификатора);
					Если ЭтоГосБумага Тогда
						Для Каждого СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций Из ТаблицаКоличестваПереходовГосударственныхОблигаций Цикл
							НомерРейтинга = СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций.НомерРейтинга;
						КонецЦикла;	
					Иначе	
						НомерРейтинга = АтомгарантНомерРейтингаАктиваНаДату(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаКоличестваПереходов);
					КонецЕсли;	
					
					Если НомерРейтинга = 20 Тогда
						// Из PD_расчет (01.01.2024).xlsx, закладка PD_PIT_12m, строка 23, столбец PD_PIT_12m
						
						Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
							СтрокаРасчетРезервов.PD = 1.7650; // Тут PD_PIT_FLI
						Иначе	
							СтрокаРасчетРезервов.PD = 0.5965; // Тут PD_PIT_FLI
						КонецЕсли;
						
					Иначе
						ИдентификаторРейтингПрогноз = Формат(НомерРейтинга, "ЧЦ=2; ЧДЦ=0; ЧН=0") + БуквенныйИдентификаторРейтингПрогноз;
						
						СтрокиPD_PIT_FLI = PD_PIT_FLI_НаОсновеРейтингаИПрогноза.НайтиСтроки(Новый Структура("ИдентификаторРейтингПрогноз", ИдентификаторРейтингПрогноз));
						
						Если СтрокиPD_PIT_FLI.Количество() = 0 Тогда
							Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
								СтрокаРасчетРезервов.PD = 1.7650; // Тут PD_PIT_FLI
							Иначе	
								СтрокаРасчетРезервов.PD = 0.5965; // Тут PD_PIT_FLI
							КонецЕсли;
						Иначе
							Для Каждого СтрокаPD_PIT_FLI Из СтрокиPD_PIT_FLI Цикл
								СтрокаРасчетРезервов.PD = СтрокаPD_PIT_FLI.PD_PIT_FLI; // Тут PD_PIT_FLI
							КонецЦикла;	
						КонецЕсли;	
					КонецЕсли;	
					
					СтрокаРасчетРезервов.КоэффициентРезерва = "PD (PIT_FLI) = " + СтрокаРасчетРезервов.PD;
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения/365)) * СтрокаРасчетРезервов.LGD; //PD_PIT_FLI
					
					СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
					
					СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
					
					
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "LGD * EAD";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		Если ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
			РасчетРезервов.Свернуть("Партия, СтрокаПартии, Актив, АналитикаРезерва, СтадияОбесценения, ЗначениеРейтинга, PD, LGD, ДатаПогашения, ДнейДоПогашения, Формула,
			|macro, ВидРезерва, Профсуждение, Реструктуризация, РейтингДефолт, КоэффициентРезерва, Лицо, PDНач, LGDНач, ДлительностьДефолта, ПадениеРейтингаНа2Стадии",
			"СуммаРезерваПартии, Количество, EAD, РучнаяКорректировка");
		КонецЕсли;
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;
		
КонецПроцедуры

// Эта функция нужна для того чтобы получить PD_PIT_FLI
// В макете АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора сохранено соотвествие кол-ва Позитивных, стабильных и негативных прогнозов и соотвествующих этим комбинациям буквенный идентификатор 
Функция АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора()
	
	МакетТаблицы = Документы.НачислениеСписаниеРезервов.ПолучитьМакет("АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора");
	
	СопоставлениеВесовПрогнозовИБуквенногоИдентификатора = Новый ТаблицаЗначений;
	СопоставлениеВесовПрогнозовИБуквенногоИдентификатора.Колонки.Добавить("ЧисловойИдентификаторПрогноза",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3, ДопустимаяДлина.Переменная)));
	СопоставлениеВесовПрогнозовИБуквенногоИдентификатора.Колонки.Добавить("БуквенныйИдентификаторВесовПрогноза", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1, ДопустимаяДлина.Переменная)));
	
	НомСтр = 2;
	
	Пока СокрЛП(МакетТаблицы.Область(НомСтр, 1).Текст) <> "" Цикл
		
		ЧисловойИдентификаторПрогноза = МакетТаблицы.Область(НомСтр, 1).Текст;
		НомерРейтинга = МакетТаблицы.Область(НомСтр, 5).Текст;
		
		НоваяСтрока = СопоставлениеВесовПрогнозовИБуквенногоИдентификатора.Добавить();
		НоваяСтрока.ЧисловойИдентификаторПрогноза = ЧисловойИдентификаторПрогноза;
		НоваяСтрока.БуквенныйИдентификаторВесовПрогноза = НомерРейтинга; 
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	Возврат СопоставлениеВесовПрогнозовИБуквенногоИдентификатора;
	
КонецФункции

// Эта функция нужна для того чтобы получить PD_PIT_FLI
// В макете АтомгарантСопоставлениеВесовПрогнозовИБуквенногоИдентификатора сохранено соотвествие кол-ва Позитивных, стабильных и негативных прогнозов и соотвествующих этим комбинациям буквенный идентификатор 
Функция АтомгарантПолучитьБуквенныйИдентификаторРейтингПрогноза(Субъект, Эмитент, СопоставлениеВесовПрогнозовИБуквенногоИдентификатора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Позитивный)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Позитивный,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Стабильный)
		|					ИЛИ РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Развивающийся)
		|				ТОГДА 1
		|			КОГДА РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НКР)
		|					И РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.НеОпределен)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Стабильный,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Негативный)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Негативный,
		|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство
		|ПОМЕСТИТЬ _РейтингиПоАгенствам
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&ДатаРейтинга,
		|			РейтинговоеАгентство В (ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.АКРА), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НКР), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НРА), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.RAEX))
		|				И Субъект В (&Субъект, &Эмитент)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &ДатаРейтинга)) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&ДатаРейтинга, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &ДатаРейтинга
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &ДатаРейтинга
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.РейтинговоеАгентство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РейтингиПоАгенствам.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиПоАгенствам.Позитивный КАК Позитивный,
		|	ВЫБОР
		|		КОГДА _РейтингиПоАгенствам.Позитивный > 0
		|			ТОГДА 0
		|		ИНАЧЕ _РейтингиПоАгенствам.Стабильный
		|	КОНЕЦ КАК Стабильный,
		|	ВЫБОР
		|		КОГДА _РейтингиПоАгенствам.Позитивный > 0
		|			ТОГДА 0
		|		КОГДА _РейтингиПоАгенствам.Стабильный > 0
		|			ТОГДА 0
		|		ИНАЧЕ _РейтингиПоАгенствам.Негативный
		|	КОНЕЦ КАК Негативный
		|ПОМЕСТИТЬ _ЛучшиеРейтинги
		|ИЗ
		|	_РейтингиПоАгенствам КАК _РейтингиПоАгенствам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(_ЛучшиеРейтинги.Позитивный) КАК Позитивный,
		|	СУММА(_ЛучшиеРейтинги.Стабильный) КАК Стабильный,
		|	СУММА(_ЛучшиеРейтинги.Негативный) КАК Негативный
		|ИЗ
		|	_ЛучшиеРейтинги КАК _ЛучшиеРейтинги";
	
	Запрос.УстановитьПараметр("ДатаРейтинга", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Субъект", Субъект);
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ЧисловойИдентификаторПрогноза = Формат(ВыборкаДетальныеЗаписи.Позитивный, "ЧЦ=1; ЧДЦ=0; ЧН=0") + Формат(ВыборкаДетальныеЗаписи.Стабильный, "ЧЦ=1; ЧДЦ=0; ЧН=0") + Формат(ВыборкаДетальныеЗаписи.Негативный, "ЧЦ=1; ЧДЦ=0; ЧН=0");
		
		БуквенныйИдентификаторВесовПрогноза = СопоставлениеВесовПрогнозовИБуквенногоИдентификатора.НайтиСтроки(Новый Структура("ЧисловойИдентификаторПрогноза", ЧисловойИдентификаторПрогноза));
		
		Если БуквенныйИдентификаторВесовПрогноза.Количество() > 0 Тогда
			Для Каждого СтрокаБуквенныйИдентификаторВесовПрогноза Из БуквенныйИдентификаторВесовПрогноза Цикл
				Возврат СтрокаБуквенныйИдентификаторВесовПрогноза.БуквенныйИдентификаторВесовПрогноза;
			КонецЦикла;	
		Иначе	
			Возврат "K";
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат "K";
	
КонецФункции	

// Эта функция нужна для того чтобы получить PD_PIT_FLI
// В макете АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза сохранено соотвествие кода рейтинга+прогноз значению PD_PIT_FLI
Функция АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза()
	
	Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 05, 01) Тогда
		МакетТаблицы = Документы.НачислениеСписаниеРезервов.ПолучитьМакет("АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза_05_2025");
	Иначе
		МакетТаблицы = Документы.НачислениеСписаниеРезервов.ПолучитьМакет("АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза");
	КонецЕсли;	
	
	АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза = Новый ТаблицаЗначений;
	АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза.Колонки.Добавить("ИдентификаторРейтингПрогноз",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3, ДопустимаяДлина.Переменная)));
	АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза.Колонки.Добавить("PD_PIT_FLI",	Новый ОписаниеТипов("Число"));
	
	НомСтр = 2;
	
	Пока СокрЛП(МакетТаблицы.Область(НомСтр, 1).Текст) <> "" Цикл
		
		ИдентификаторРейтингПрогноз = МакетТаблицы.Область(НомСтр, 1).Текст;
		PD_PIT_FLI = МакетТаблицы.Область(НомСтр, 4).Текст;
		
		НоваяСтрока = АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза.Добавить();
		НоваяСтрока.ИдентификаторРейтингПрогноз = ИдентификаторРейтингПрогноз;
		НоваяСтрока.PD_PIT_FLI = PD_PIT_FLI; 
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;	
	
	Возврат АтомгарантPD_PIT_FLI_НаОсновеРейтингаИПрогноза;
	
КонецФункции	

Функция АтомгарантНомерРейтингаАктиваНаДату(ЦеннаяБумага, Эмитент, ТаблицаКоличестваПереходов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКоличестваПереходов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ТаблицаКоличестваПереходов.СтрокаРейтинга КАК СтрокаРейтинга,
		|	ТаблицаКоличестваПереходов.НомерРейтинга КАК НомерРейтинга,
		|	ТаблицаКоличестваПереходов.МинимальноеКоличествоПереходов КАК МинимальноеКоличествоПереходов
		|ПОМЕСТИТЬ _ТаблицаКоличестваПереходов
		|ИЗ
		|	&ТаблицаКоличестваПереходов КАК ТаблицаКоличестваПереходов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ТаблицаКоличестваПереходов.НомерРейтинга) КАК НомерРейтинга
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&День,
		|			Субъект В (&Эмитент, &ЦеннаяБумага)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &День)) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&День, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаКоличестваПереходов КАК _ТаблицаКоличестваПереходов
		|		ПО РейтингиСрезПоследних.РейтинговоеАгентство = _ТаблицаКоличестваПереходов.РейтинговоеАгентство
		|			И РейтингиСрезПоследних.ЗначениеРейтинга.Наименование = _ТаблицаКоличестваПереходов.СтрокаРейтинга
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("День", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	Запрос.УстановитьПараметр("ТаблицаКоличестваПереходов", ТаблицаКоличестваПереходов);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.НомерРейтинга;
	КонецЕсли;
	
	Возврат 20;

КонецФункции

#КонецОбласти

#Область РЕЗЕРВЫ_СБЕРБАНК

Процедура ЗаполнитьРезервыСбербанк(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета)

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("СбербанкШкалаPD", Истина);
	
	ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов("СбербанкШкалаPD", Истина);
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	//ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD(); // Сбер очень замороченный. Тут так не отделаешься
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы			 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ							 = Истина;
	ПараметрыАктивовПоАС.ВнутреннийРейтинг					 = Истина;
	ПараметрыАктивовПоАС.ВМНОУчитыватьВсюСумму				 = Истина;
	ПараметрыАктивовПоАС.УчитыватьPutОферту					 = Истина;
	ПараметрыАктивовПоАС.МНОРаздельныйУчетПроцентовИТела	 = Истина;
	Если НачалоДня(ЭтотОбъект.Дата) >= '20250429' Тогда
		ПараметрыАктивовПоАС.БратьНаихудшийРейтинг			 = Истина;
	КонецЕсли;	
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
    ТаблицаКоличестваПереходовГосударственныхОблигаций = ТаблицаКоличестваПереходов.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		ЭтоГосБумага = Ложь;
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
			Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
			И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
			Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
				СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD; // Тут PD_TTC
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньВнутреннегоРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
			КонецЦикла;	
			ЭтоГосБумага = Истина;
		ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда // Нет рейтинга
			// Из PСБЕР_Методика ОКУ_20240909_FIN_УК, Приложение 2, последняя строка
			СтрокаАктивы.PD	= 50; //Тут PD_TTC

		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
	
		
		СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;

		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		
		// Сначала разберемся со стадией
		
		// Сначала профсуждения
		Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		// затем проверим на стадию 3 как на самую сильную:
		// 1. рейтинг д
		// 2. есть реструктуризация
		ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
			Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
			Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
			Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Реструктуризация = Истина;
		Иначе
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			Если ЗначениеЗаполнено(СтрокаАктивы.ДатаПервоначальногоПризнания) Тогда 
				ДатаПП = Макс(СтрокаАктивы.ДатаПервоначальногоПризнания, СтрокаАктивы.ДатаPutОферты); 
			Иначе
				ДатаПП = Неопределено;
			КонецЕсли;	
			
			Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг = Истина;
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.БратьНаихудшийРейтинг = ПараметрыАктивовПоАС.БратьНаихудшийРейтинг;
				
				УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
				
				Если Не ЭтоГосБумага Тогда
					МинимальноеКоличествоПереходов = ПолучитьМинимальноеКоличествоПереходовАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаКоличестваПереходов);
				Иначе
					Для Каждого СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций Из ТаблицаКоличестваПереходовГосударственныхОблигаций Цикл
						МинимальноеКоличествоПереходов = СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций.МинимальноеКоличествоПереходов;
					КонецЦикла;	
				КонецЕсли;	
				
				Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньВнутреннегоРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
					СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
					СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
		// Потом определим LGD 
		// •	Обеспеченные финансовые инструменты (в нашем случае РЕПО)
		// Считается по формуле
		// Пока не сделано
		//
		// •	Необеспеченные финансовые инструменты: 
		//	Без внешних рейтингов LGD принимается равным 100%.
		// Средства, размещенные в банках 100%
		// Финансовая дебиторская задолженность
		// Корпоративный контрагент	53,70%
		// Контрагент финансовая организация 	100,00%
		// 3.	Долговые ценные бумаги  
		// 3.1	Эмитент является сувереном	47,00%
		// 3.2	Эмитент не является сувереном 	62,00%


		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			
			СтрокаРасчетРезервов.LGD = 1;
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
			// финансовая организация 	100,00%, корпоративный клиент 53,7
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БрокерскиеКомпании.ЮрФизЛицо КАК ЮрФизЛицо
			|ПОМЕСТИТЬ _ЮрФизЛицо
			|ИЗ
			|	Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
			|ГДЕ
			|	БрокерскиеКомпании.Ссылка = &Объект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ПеречниОбъектовСрезПоследних.Включен КАК Включен
			|ИЗ
			|	РегистрСведений.ПеречниОбъектов.СрезПоследних(
			|			&Период,
			|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
			|				И Объект В
			|					(ВЫБРАТЬ
			|						_ЮрФизЛицо.ЮрФизЛицо
			|					ИЗ
			|						_ЮрФизЛицо КАК _ЮрФизЛицо)
			|				И ВидПеречня В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора))) КАК ПеречниОбъектовСрезПоследних";
			
			Запрос.УстановитьПараметр("Объект", СтрокаАктивы.ЦеннаяБумага);
			Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				СтрокаРасчетРезервов.LGD = 0.537;
			Иначе
				СтрокаРасчетРезервов.LGD = 1;
			КонецЕсли;	
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда	
			Если СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
			
				СтрокаРасчетРезервов.LGD = 0.47;
				
			ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда // Нет рейтинга	
				
				СтрокаРасчетРезервов.LGD = 1;
				
			Иначе
				
				СтрокаРасчетРезервов.LGD = 0.62;
				
			КонецЕсли;	
			
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
			// Сделки обратного РЕПО относятся к обеспеченным инструментам
			// LGD считается по формуле из 2.4.1
			
			PDЭмитент = 0; //!!! пока нет определения то это за PD
			
			СтрокаРасчетРезервов.LGD = СбербанкРасчетLGDОбеспеченногоИнструмента(СтрокаАктивы.ЦеннаяБумага, СтрокаРасчетРезервов.EAD, PDЭмитент, ТаблицаPD, РейтингГосударственныхОблигаций); 
			
		Иначе	
			
			СтрокаРасчетРезервов.LGD = 1;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			// Для финансовых инструментов в дефолте (Этап 3) применяется значение LGD, скорректированное с учётом времени нахождения в дефолте. 
			LGDСтадий1и2 = СтрокаРасчетРезервов.LGD;
			ТМакс = 180; // пункт 2.4.2 методики
			
			ДатыПереходаАктиваНаТретьюСтадию = ПолучитьДатуПереходаАктиваНаТретьюСтадию(СтрокаАктивы.ЦеннаяБумага);
			ТВДефолте = (НачалоДня(ЭтотОбъект.Дата) - ДатыПереходаАктиваНаТретьюСтадию);
			
			СтрокаРасчетРезервов.LGD = ((1 - LGDСтадий1и2) * Мин(ТВДефолте, ТМакс)) / ТМакс + LGDСтадий1и2;
		КонецЕсли;	
		
		// А теперь расчеты
		ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, , Истина);
		
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			
			//〖Provisions〗_(1st stage)=EAD∙PD∙LGD·min(k,1), пункт 2.2.2 методики
			КоэффициентСрокаПогашения = Окр(((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24)) / 365, 4); // В формуле k, и не понятно нужно ли делить в високосный на 366 или 365. во всех прочих формулах стоит четко 365, покам оставим так же
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения; 
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			
			УровеньРейтинга = СтрокаАктивы.УровеньВнутреннегоРейтинга;
			
			PD_PIT = СбербанкПолучитьDP_PIT(СтрокаАктивы.УровеньВнутреннегоРейтинга, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, СтрокаРасчетРезервов.PD, ТаблицаPD);
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
				// Сделки обратного РЕПО относятся к обеспеченным инструментам
				// LGD считается по формуле из 2.4.1
				
				PDЭмитент = PD_PIT; // по результатам сверки выястилось что СБЕР хотят на первой стадии для определения LGD для РЕПО использовать PD_PIT. Ещё раз пересчитаем LGD по полученному выше PD PIT
				
				СтрокаРасчетРезервов.LGD = СбербанкРасчетLGDОбеспеченногоИнструмента(СтрокаАктивы.ЦеннаяБумага, СтрокаРасчетРезервов.EAD, PDЭмитент, ТаблицаPD, РейтингГосударственныхОблигаций); 
				
			КонецЕсли;			
			
			СтрокаРасчетРезервов.КоэффициентРезерва = "PD (PIT_FLI) = " + PD_PIT;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (PD_PIT/ 100) * СтрокаРасчетРезервов.LGD * Мин(КоэффициентСрокаПогашения, 1);
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.Формула = "EAD * PD / 100 * LGD * min(ДнейДоПогашения, 365) / 365";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				
				ЦенныеБумагиДляЦеныПокупки = Новый ТаблицаЗначений;
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("Партия",  Метаданные.ОпределяемыеТипы.Партия.Тип);
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
				ЦенныеБумагиДляЦеныПокупки.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
				
				НоваяСтрокаЦенныеБумагиДляЦеныПокупки = ЦенныеБумагиДляЦеныПокупки.Добавить();
				НоваяСтрокаЦенныеБумагиДляЦеныПокупки.НомерСтроки = 1;
				ЗаполнитьЗначенияСвойств(НоваяСтрокаЦенныеБумагиДляЦеныПокупки,СтрокаАктивы);
				
				
				ТаблицаДатИЦенПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумагиДляЦеныПокупки, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата).Выгрузить();
				
				
				ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;	
				НастройкиЦелиРасчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиЦелиРасчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета);
				
				ПараметрыОценки = Новый Структура;
				ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
				ПараметрыОценки.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата));
				ПараметрыОценки.Вставить("ВариантРасчетаОжидаемыхКредитныхУбытков", Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Сбербанк);
				
				ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ЭтотОбъект.Дата, СтрокаАктивы.ЦеннаяБумага, Отказ);
				ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Истина);
				ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	НастройкиУчета.УчитыватьКупонКОферте);
				ПараметрыДенежногоПотока.Вставить("Дата",				ЭтотОбъект.Дата);
				ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ЭтотОбъект.Дата);
				
				ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаАктивы.ЦеннаяБумага, ПараметрыДенежногоПотока, ЭтотОбъект.Дата, Отказ);
				
				// 〖Provisions〗_(2nd stage)= 〖∑_t^T▒〖〖(PD〗_t∙〗 DCF〗_t∙LGD) п 2.2.3 методики
				СтрокаРасчетРезервов.Формула = "∑(PD/100 * DCF * LGD)";
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = 0;
				
				ДанныеПереоценки = Новый Структура;
				ДанныеПереоценки.Вставить("ДатаПереоценки",												  КонецДня(ЭтотОбъект.Дата));
				ДанныеПереоценки.Вставить("Партия",														  СтрокаАктивы.Партия);
				ДанныеПереоценки.Вставить("СтрокаПартии",												  СтрокаАктивы.СтрокаПартии);
				ДанныеПереоценки.Вставить("БалансовыйДисконт",											  СтрокаАктивы.ОценочныеДисконтПремия);
				ДанныеПереоценки.Вставить("УчетныйАктивЕПС",											  СтрокаАктивы.УчетныйАктивЕПС);
				ДанныеПереоценки.Вставить("Количество",													  СтрокаАктивы.Количество);
				ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона",										  СтрокаАктивы.ОценочнаяСуммаКупона);
				ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаАктивы.ОценочнаяРазницаППНеНаблюдаемыеДанные);
				ДанныеПереоценки.Вставить("СчетДоверительногоУправления", 								  ЭтотОбъект.СчетДоверительногоУправления);
				ДанныеПереоценки.Вставить("Стоимость",													  0);
				
				
				СтрокиПокупки = ТаблицаДатИЦенПокупки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаАктивы.Партия, СтрокаАктивы.СтрокаПартии));
				
				ДанныеПокупки = Новый Структура;
				Если СтрокиПокупки.Количество() > 0 Тогда
					
					СтрокаПокупки = СтрокиПокупки[0];
					
					ДанныеПокупки.Вставить("НачальныйДисконт",												СтрокаПокупки.НачальныйДисконт);
					ДанныеПокупки.Вставить("ДатаПокупки",													СтрокаПокупки.ДатаПокупки);
					ДанныеПокупки.Вставить("ДатаПокупкиНачальная",											СтрокаПокупки.ДатаПокупкиНачальная);
					ДанныеПокупки.Вставить("КорректировкаЭСПНачальная",										СтрокаПокупки.КорректировкаЭСПНачальная);
					ДанныеПокупки.Вставить("ЦенаПокупки",													СтрокаПокупки.ЦенаПокупки);
					ДанныеПокупки.Вставить("ЦенаПокупкиКупона",												СтрокаПокупки.ЦенаКупона);
					ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные",	СтрокаАктивы.НачальнаяРазницаППНеНаблюдаемыеДанные / СтрокаАктивы.Количество);
					ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", 											СтрокаПокупки.ЦенаПокупкиНачальная);
				КонецЕсли;	
				
				
				НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
					НастройкиУчетаОбщие,
					СтрокаАктивы.ЦеннаяБумага,
					СтрокаАктивы.УчетныйАктивЕПС,
					СтрокаАктивы.Партия,
					СтрокаАктивы.СтрокаПартии);
				
				// у клиента не считается ЭСП
				Если НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода <> Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке Тогда
					// по всем, кроме "через прибыль/убыток" считаем Корректировку ЭСП независимо от настроек
					Если СтрокаАктивы.УчетныйАктивЕПСРодитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток Тогда
						НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
					КонецЕсли;
				КонецЕсли;
				
				DP12Mounth = СбербанкПолучитьDP12Mounth(СтрокаРасчетРезервов.PD);
				
				PD_PIT = СбербанкПолучитьDP_PIT(СтрокаАктивы.УровеньВнутреннегоРейтинга, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, СтрокаРасчетРезервов.PD, ТаблицаPD);
				
				СтрокаРасчетРезервов.КоэффициентРезерва = "PD (TTC) = " + СтрокаРасчетРезервов.PD + "; PD (PIT_FLI) = " + PD_PIT;
				
				ДанныеРасчетаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаАктивы.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);				
				
				ПриведеннаяСтоимость = РассчитатьДисконтированнуюСтоимостьСВероятностьюДефолта(ДенежныйПоток, СтрокаАктивы.Количество, ДанныеРасчетаЭСП.ЭСПКорректировка, ПараметрыОценки, Отказ, СтрокаРасчетРезервов.PD, PD_PIT);
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = ПриведеннаяСтоимость * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			Иначе
				
				DP12Mounth = СбербанкПолучитьDP12Mounth(СтрокаРасчетРезервов.PD);
				
				PD_PIT = СбербанкПолучитьDP_PIT(СтрокаАктивы.УровеньВнутреннегоРейтинга, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, СтрокаРасчетРезервов.PD, ТаблицаPD);
				
				PD_t = Окр(1 - Pow((1 - PD_PIT), Мин(ДнейДоПогашения / 365, 1)) * Pow((1 - СтрокаРасчетРезервов.PD), Макс(0, (ДнейДоПогашения / 365) - 1)), 10);
				
				
				Если ДнейДоПогашения < 365 Тогда
					ДисконтированныйПоток = СтрокаРасчетРезервов.EAD;
				Иначе
					СтавкаДисконтирования = 0; //!!! пока не знаю где брать не для облигаций (для облигаций пока взяли ЭСП)
					
					СтрокаРасчетРезервов.КоэффициентРезерва = "PD (TTC) = " + СтрокаРасчетРезервов.PD + "; PD (PIT_FLI) = " + PD_PIT;
					
					ДисконтированныйПоток = PD_t * СтрокаРасчетРезервов.EAD / Pow(1 + СтавкаДисконтирования / 100, ДнейДоПогашения / 365);
				КонецЕсли;	
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = (PD_t / 100) * ДисконтированныйПоток * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
				
				СтрокаРасчетРезервов.Формула = "∑(PD/100 * DCF * LGD)";
				
			КонецЕсли;	
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			
			Если ТВДефолте < ТМакс Тогда
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD ID";
			Иначе
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD;
				
				СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
				
				СтрокаРасчетРезервов.Формула = "EAD";
			КонецЕсли;	
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		Если ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
			РасчетРезервов.Свернуть("Партия, СтрокаПартии, Актив, АналитикаРезерва, СтадияОбесценения, ЗначениеРейтинга, PD, LGD, ДатаПогашения, ДнейДоПогашения, Формула,
			|macro, ВидРезерва, Профсуждение, Реструктуризация, РейтингДефолт, КоэффициентРезерва, Лицо, PDНач, LGDНач, ДлительностьДефолта, ПадениеРейтингаНа2Стадии",
			"СуммаРезерваПартии, Количество, EAD, РучнаяКорректировка");
		КонецЕсли;
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;
		
КонецПроцедуры

Функция СбербанкПолучитьDP12Mounth(PD_TTC = 0)
	
	КорректирующийКоэффициент = 1; // пока так. обещают позже его прислать (для тестирования попросили 1)
	
	Возврат (((PD_TTC)/(1 - PD_TTC))*КорректирующийКоэффициент)/(1 + ((PD_TTC)/(1 - PD_TTC))*КорректирующийКоэффициент);
	
КонецФункции	

Функция СбербанкПолучитьDP_PIT(УровеньРейтинга, ЦеннаяБумага, Эмитент, PD_TTC, ТаблицаPD)
	
	РейтингПрогноз = СбербанкПолучитьРейтингПрогноз(ЦеннаяБумага, Эмитент);
	ИтогоРейтингПрогноз = РейтингПрогноз.Позитивный + РейтингПрогноз.Стабильный + РейтингПрогноз.Негативный;
	
	// Базовый сценарий
	PDБазовый = СбербанкПолучитьDP_PITБазовый(РейтингПрогноз, ИтогоРейтингПрогноз, УровеньРейтинга, PD_TTC, ТаблицаPD);
	
	// Консервативный сценарий
	Отбор = Новый Структура();
	Отбор.Вставить("УровеньВнутреннегоРейтинга", Мин(УровеньРейтинга + 1, 21)); // 22 дефолтный, ограничиваем 21 как в методике
	СтрокиРейтинга = ТаблицаPD.НайтиСтроки(Отбор);	
	
	Для Каждого СтрокаРейтинга Из СтрокиРейтинга Цикл 
		PD_TTC_Консервативный = СтрокаРейтинга.PD;	
	КонецЦикла;	
	
	PDКонсервативный = СбербанкПолучитьDP_PITБазовый(РейтингПрогноз, ИтогоРейтингПрогноз, УровеньРейтинга - 1, PD_TTC_Консервативный, ТаблицаPD);
	
	// Позитивный сценарий
	Отбор = Новый Структура();
	Отбор.Вставить("УровеньВнутреннегоРейтинга", Макс(УровеньРейтинга - 1, 1));
	СтрокиРейтинга = ТаблицаPD.НайтиСтроки(Отбор);	
	
	Для Каждого СтрокаРейтинга Из СтрокиРейтинга Цикл 
		PD_TTC_Позитивный = СтрокаРейтинга.PD;	
	КонецЦикла;	
	
	PDПозитивный = СбербанкПолучитьDP_PITБазовый(РейтингПрогноз, ИтогоРейтингПрогноз, УровеньРейтинга - 1, PD_TTC_Позитивный, ТаблицаPD);
	
	//Для Этапа 1 при расчёте ОКУ используется значение PD PIT (выражается в процентах, округляется до 10 знаков после запятой). 
	Возврат Окр(PDПозитивный*0.15 + PDБазовый*0.7 + PDКонсервативный*0.15, 10); 
	
КонецФункции	

Функция СбербанкПолучитьDP_PITБазовый(РейтингПрогноз, ИтогоРейтингПрогноз, УровеньРейтинга, PD_TTC, ТаблицаPD)
	
	PD_TTC_Позитивный = PD_TTC;
	PD_TTC_Негативный = PD_TTC;
	
	Если РейтингПрогноз.Позитивный > 0 И УровеньРейтинга > 1 Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("УровеньВнутреннегоРейтинга", Макс(УровеньРейтинга - 1, 1));
		СтрокиРейтинга = ТаблицаPD.НайтиСтроки(Отбор);	
		
		Для Каждого СтрокаРейтинга Из СтрокиРейтинга Цикл 
			PD_TTC_Позитивный = СтрокаРейтинга.PD;	
		КонецЦикла;	
	КонецЕсли;	
	
	Если РейтингПрогноз.Негативный > 0 И УровеньРейтинга < 22 Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("УровеньВнутреннегоРейтинга", Мин(УровеньРейтинга + 1, 21)); // 22 дефолтный, ограничиваем 21 как в методике
		СтрокиРейтинга = ТаблицаPD.НайтиСтроки(Отбор);	
		
		Для Каждого СтрокаРейтинга Из СтрокиРейтинга Цикл 
			PD_TTC_Негативный = СтрокаРейтинга.PD;	
		КонецЦикла;	
	КонецЕсли;	
	
	DP12Mounth = СбербанкПолучитьDP12Mounth(PD_TTC);
	DP12Mounth_Позитивный = СбербанкПолучитьDP12Mounth(PD_TTC_Позитивный);
	DP12Mounth_Негативный = СбербанкПолучитьDP12Mounth(PD_TTC_Негативный);
	
	//Результат расчета 〖PD〗_( прогноз_базовый) выражается в процентах, округляется до 10 знаков после запятой. 
	Возврат Окр(РейтингПрогноз.Позитивный/ИтогоРейтингПрогноз*DP12Mounth_Позитивный + РейтингПрогноз.Стабильный/ИтогоРейтингПрогноз*DP12Mounth + РейтингПрогноз.Негативный/ИтогоРейтингПрогноз*DP12Mounth_Негативный, 10);

КонецФункции	

// Сделки обратного РЕПО относятся к обеспеченным инструментам
// LGD считается по формуле из 2.4.1
Функция СбербанкРасчетLGDОбеспеченногоИнструмента(ЦеннаяБумага, EAD, PDЭмитент = 0, ТаблицаPD, РейтингГосударственныхОблигаций)
	
	Если ЗначениеЗаполнено(EAD) Тогда
		
		СправедливаяСтоимостьЦБ = EAD;
		
		Если Не ЗначениеЗаполнено(PDЭмитент) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
			|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
			|	ЕСТЬNULL(УсловияСделокРЕПОСрезПоследних.Количество * (СтоимостьПереоценкиСрезПоследних.Цена + СтоимостьПереоценкиСрезПоследних.ЦенаКупона), &EAD) КАК СправедливаяСтоимостьЦБ
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&Период,
			|			СделкаРЕПО = &СделкаРЕПО
			|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки.СрезПоследних(
			|				&Период,
			|				Партия = НЕОПРЕДЕЛЕНО
			|					И ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)) КАК СтоимостьПереоценкиСрезПоследних
			|		ПО (СтоимостьПереоценкиСрезПоследних.Организация = УсловияСделокРЕПОСрезПоследних.Организация)
			|			И (СтоимостьПереоценкиСрезПоследних.Рынок = УсловияСделокРЕПОСрезПоследних.Рынок)
			|			И (СтоимостьПереоценкиСрезПоследних.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага)
			|			И (СтоимостьПереоценкиСрезПоследних.СчетДоверительногоУправления = УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления)";
			
			Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("СделкаРЕПО", ЦеннаяБумага);
			Запрос.УстановитьПараметр("EAD", EAD);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СправедливаяСтоимостьЦБ = ВыборкаДетальныеЗаписи.СправедливаяСтоимостьЦБ; 
				Если ВыборкаДетальныеЗаписи.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
					Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
						PDЭмитент = СтрокаРейтингГосударственныхОблигаций.PD; // PD_TTC
					КонецЦикла;	
				Иначе	
					ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
					ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = ?(НачалоДня(ЭтотОбъект.Дата) >= '20250429', Истина, Ложь);
					
					PDЭмитент = ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Дата), ВыборкаДетальныеЗаписи.Эмитент, ВыборкаДетальныеЗаписи.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату); // PD_TTC
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// По округлению LGD для Обеспеченных финансовых инструментов в методике ничего не написано но есть письмо от Алексей Бушин где он говорит что 10 знаков. 
		// Т.к. тут не процент а уже готовый коэффициент, то +2 т.е. 12
		Возврат Окр((1 - (Мин(EAD, СправедливаяСтоимостьЦБ)*(1 - PDЭмитент/100)) / EAD), 12);
	Иначе
		Возврат 1;
	КонецЕсли;	
	
КонецФункции			

// Эта функция нужна для того чтобы получить PD_PIT
// 2.3.2.3.	Учёт прогнозной информации в компоненте PD
Функция СбербанкПолучитьРейтингПрогноз(Субъект, Эмитент)
	
	РейтингПрогноз = Новый Структура("Позитивный, Стабильный, Негативный", 0, 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Позитивный)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Позитивный,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Стабильный)
		|					ИЛИ РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Развивающийся)
		|				ТОГДА 1
		|			КОГДА РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НКР)
		|					И РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.НеОпределен)
		|				ТОГДА 1
		|			КОГДА РейтингиСрезПоследних.РейтинговоеАгентство = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.ПустаяСсылка)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Стабильный,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Негативный)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Негативный,
		|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство
		|ПОМЕСТИТЬ _РейтингиПоАгенствам
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&ДатаРейтинга,
		|			РейтинговоеАгентство В (ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.АКРА), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НКР), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.НРА), ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.RAEX))
		|				И Субъект В (&Субъект, &Эмитент)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &ДатаРейтинга)) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&ДатаРейтинга, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &ДатаРейтинга
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &ДатаРейтинга
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.РейтинговоеАгентство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РейтингиПоАгенствам.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиПоАгенствам.Позитивный КАК Позитивный,
		|	ВЫБОР
		|		КОГДА _РейтингиПоАгенствам.Позитивный > 0
		|			ТОГДА 0
		|		ИНАЧЕ _РейтингиПоАгенствам.Стабильный
		|	КОНЕЦ КАК Стабильный,
		|	ВЫБОР
		|		КОГДА _РейтингиПоАгенствам.Позитивный > 0
		|			ТОГДА 0
		|		КОГДА _РейтингиПоАгенствам.Стабильный > 0
		|			ТОГДА 0
		|		ИНАЧЕ _РейтингиПоАгенствам.Негативный
		|	КОНЕЦ КАК Негативный
		|ПОМЕСТИТЬ _ЛучшиеРейтинги
		|ИЗ
		|	_РейтингиПоАгенствам КАК _РейтингиПоАгенствам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(_ЛучшиеРейтинги.Позитивный) КАК Позитивный,
		|	СУММА(_ЛучшиеРейтинги.Стабильный) КАК Стабильный,
		|	СУММА(_ЛучшиеРейтинги.Негативный) КАК Негативный
		|ИЗ
		|	_ЛучшиеРейтинги КАК _ЛучшиеРейтинги";
	
	Запрос.УстановитьПараметр("ДатаРейтинга", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Субъект", Субъект);
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		РейтингПрогноз.Вставить("Позитивный", ВыборкаДетальныеЗаписи.Позитивный);
		РейтингПрогноз.Вставить("Стабильный", ВыборкаДетальныеЗаписи.Стабильный);
		РейтингПрогноз.Вставить("Негативный", ВыборкаДетальныеЗаписи.Негативный);
	КонецЕсли;
	
	Возврат РейтингПрогноз;
	
КонецФункции	

#КонецОбласти

#Область РЕЗЕРВЫ_ВОЛГАКАПИТАЛ

Процедура ЗаполнитьРезервыВолгаКапитал(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ДатаМетодики2025 = '20250801';
	
