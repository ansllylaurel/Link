		|	_ЛучшиеРейтинги.PD,
		|	_ЛучшиеРейтинги.УровеньРейтинга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	РейтингиСрезПоследних.СтрокаСопоставления КАК СтрокаСопоставления,
		|	РейтингиСрезПоследних.PD КАК PD,
		|	РейтингиСрезПоследних.УровеньРейтинга КАК УровеньРейтинга,
		|	МАКСИМУМ(РейтингиСрезПоследних.УровеньПрогнозаРейтинга) КАК УровеньПрогнозаРейтинга
		|ПОМЕСТИТЬ _РейтингиСЛучшимПрогнозом
		|ИЗ
		|	_РейтингиСрезПоследних КАК РейтингиСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.Субъект,
		|	РейтингиСрезПоследних.СтрокаСопоставления,
		|	РейтингиСрезПоследних.PD,
		|	РейтингиСрезПоследних.УровеньРейтинга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЛучшиеРейтинги.Субъект КАК Субъект,
		|	ЛучшиеРейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|	ЛучшиеРейтинги.PD КАК PD,
		|	ЛучшиеРейтинги.УровеньРейтинга КАК УровеньРейтинга,
		|	ВЫБОР
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Негативный)
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 1
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.НеОпределен)
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 2
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Стабильный)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Позитивный)
		|	КОНЕЦ КАК ПрогнозРейтинга,
		|	ЛучшиеРейтинги.СтрокаРейтинга КАК СтрокаРейтинга
		|ПОМЕСТИТЬ _ЛучшиеРейтингиИПрогнозы
		|ИЗ
		|	_ЛучшиеРейтинги КАК ЛучшиеРейтинги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РейтингиСЛучшимПрогнозом КАК РейтингиСЛучшимПрогнозом
		|		ПО ЛучшиеРейтинги.Субъект = РейтингиСЛучшимПрогнозом.Субъект
		|			И ЛучшиеРейтинги.СтрокаСопоставления = РейтингиСЛучшимПрогнозом.СтрокаСопоставления
		|			И ЛучшиеРейтинги.PD = РейтингиСЛучшимПрогнозом.PD
		|			И ЛучшиеРейтинги.УровеньРейтинга = РейтингиСЛучшимПрогнозом.УровеньРейтинга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА 100
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.УровеньРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.УровеньРейтинга
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|	КОНЕЦ КАК УровеньРейтинга
		|ИЗ
		|	_ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихАктивов
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихЭмитентов
		|		ПО (_РейтингиСрезПоследнихЭмитентов.Субъект = &Эмитент
		|				ИЛИ _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL)
		|			И (_РейтингиСрезПоследнихАктивов.Субъект = &ЦеннаяБумага
		|				ИЛИ _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL)
		|ГДЕ
		|	(_РейтингиСрезПоследнихЭмитентов.Субъект = &Эмитент
		|			ИЛИ _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL)
		|	И (_РейтингиСрезПоследнихАктивов.Субъект = &ЦеннаяБумага
		|			ИЛИ _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL)";
		
	Запрос.УстановитьПараметр("День", НачалоДня(ДатаПартии));
	Если ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") И ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.Облигация);	
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда	
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.ЦеннаяБумага);	
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") И ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда	
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.ЦеннаяБумага);	
	Иначе
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	Запрос.УстановитьПараметр("ТаблицаPD", ТаблицаPD);
	
	Если ЭтотОбъект.Дата < '20230531' Тогда
		Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Ложь);
	Иначе
		Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Истина);
	КонецЕсли;
	
	Если ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УровеньРейтинга", "УровеньВнутреннегоРейтинга");
	КонецЕсли;	
	
	Если ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.БратьНаихудшийРейтинг Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ(РейтингиСрезПоследних", "МАКСИМУМ(РейтингиСрезПоследних");
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг Тогда
			Возврат ВыборкаДетальныеЗаписи.УровеньВнутреннегоРейтинга;
		Иначе
			Возврат ВыборкаДетальныеЗаписи.УровеньРейтинга;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат 0;

КонецФункции

// Настройки параметров работы функции ПолучитьPDАктиваНаДату
Функция ПолучитьНастройкиДляPDАктиваНаДату() Экспорт
	
	ПараметрыНастройкиДляPDАктиваНаДату = Новый Структура;
	ПараметрыНастройкиДляPDАктиваНаДату.Вставить("ЕстьPD2Стадии",													Ложь);
	ПараметрыНастройкиДляPDАктиваНаДату.Вставить("ЕстьLGD",															Ложь);
	ПараметрыНастройкиДляPDАктиваНаДату.Вставить("БратьНаихудшийРейтинг",											Ложь);
	ПараметрыНастройкиДляPDАктиваНаДату.Вставить("ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии",	Ложь);
	
	Возврат ПараметрыНастройкиДляPDАктиваНаДату;
	
КонецФункции

Функция ПолучитьPDАктиваНаДату(ДатаПартии, ЦеннаяБумага, Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаPD.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ТаблицаPD.СтрокаРейтинга КАК СтрокаРейтинга,
		|	ТаблицаPD.PD КАК PD,
		|	ТаблицаPD.УровеньРейтинга КАК УровеньРейтинга
		|ПОМЕСТИТЬ _ТаблицаPD
		|ИЗ
		|	&ТаблицаPD КАК ТаблицаPD
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	ВЫБОР
		|		КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Негативный)
		|			ТОГДА 0
		|		КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Стабильный)
		|			ТОГДА 2
		|		КОГДА РейтингиСрезПоследних.ПрогнозРейтинга = ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Позитивный)
		|			ТОГДА 3
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК УровеньПрогнозаРейтинга,
		|	ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления, 5) КАК СтрокаСопоставления,
		|	_ТаблицаPD.PD КАК PD,
		|	_ТаблицаPD.УровеньРейтинга КАК УровеньРейтинга
		|ПОМЕСТИТЬ _РейтингиСрезПоследних
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&День,
		|			(Субъект = &ЦеннаяБумага
		|				ИЛИ Субъект = &Эмитент)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &День)) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&День, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаPD КАК _ТаблицаPD
		|		ПО РейтингиСрезПоследних.РейтинговоеАгентство = _ТаблицаPD.РейтинговоеАгентство
		|			И РейтингиСрезПоследних.ЗначениеРейтинга.Наименование = _ТаблицаPD.СтрокаРейтинга
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	МИНИМУМ(РейтингиСрезПоследних.СтрокаСопоставления) КАК СтрокаСопоставления,
		|	МИНИМУМ(РейтингиСрезПоследних.PD) КАК PD,
		|	МИНИМУМ(РейтингиСрезПоследних.УровеньРейтинга) КАК УровеньРейтинга
		|ПОМЕСТИТЬ _ЛучшиеРейтинги
		|ИЗ
		|	_РейтингиСрезПоследних КАК РейтингиСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.Субъект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	РейтингиСрезПоследних.СтрокаСопоставления КАК СтрокаСопоставления,
		|	РейтингиСрезПоследних.PD КАК PD,
		|	РейтингиСрезПоследних.УровеньРейтинга КАК УровеньРейтинга,
		|	МАКСИМУМ(РейтингиСрезПоследних.УровеньПрогнозаРейтинга) КАК УровеньПрогнозаРейтинга
		|ПОМЕСТИТЬ _РейтингиСЛучшимПрогнозом
		|ИЗ
		|	_РейтингиСрезПоследних КАК РейтингиСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.Субъект,
		|	РейтингиСрезПоследних.СтрокаСопоставления,
		|	РейтингиСрезПоследних.PD,
		|	РейтингиСрезПоследних.УровеньРейтинга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЛучшиеРейтинги.Субъект КАК Субъект,
		|	ЛучшиеРейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|	ЛучшиеРейтинги.PD КАК PD,
		|	ЛучшиеРейтинги.УровеньРейтинга КАК УровеньРейтинга,
		|	ВЫБОР
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Негативный)
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 1
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.НеОпределен)
		|		КОГДА РейтингиСЛучшимПрогнозом.УровеньПрогнозаРейтинга = 2
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Стабильный)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПрогнозыРейтингов.Позитивный)
		|	КОНЕЦ КАК ПрогнозРейтинга
		|ПОМЕСТИТЬ _ЛучшиеРейтингиИПрогнозы
		|ИЗ
		|	_ЛучшиеРейтинги КАК ЛучшиеРейтинги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РейтингиСЛучшимПрогнозом КАК РейтингиСЛучшимПрогнозом
		|		ПО ЛучшиеРейтинги.Субъект = РейтингиСЛучшимПрогнозом.Субъект
		|			И ЛучшиеРейтинги.СтрокаСопоставления = РейтингиСЛучшимПрогнозом.СтрокаСопоставления
		|			И ЛучшиеРейтинги.PD = РейтингиСЛучшимПрогнозом.PD
		|			И ЛучшиеРейтинги.УровеньРейтинга = РейтингиСЛучшимПрогнозом.УровеньРейтинга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА 0
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.PD
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихАктивов.PD
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.PD
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.PD
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.PD
		|	КОНЕЦ КАК PD
		|ИЗ
		|	_ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихАктивов
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихЭмитентов
		|		ПО (_РейтингиСрезПоследнихЭмитентов.Субъект = &Эмитент
		|				ИЛИ _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL)
		|			И (_РейтингиСрезПоследнихАктивов.Субъект = &ЦеннаяБумага
		|				ИЛИ _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL)
		|ГДЕ
		|	(_РейтингиСрезПоследнихЭмитентов.Субъект = &Эмитент
		|			ИЛИ _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL)
		|	И (_РейтингиСрезПоследнихАктивов.Субъект = &ЦеннаяБумага
		|			ИЛИ _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL)";
		
	Запрос.УстановитьПараметр("День", НачалоДня(ДатаПартии));
	Если ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") И ПараметрыНастройкиДляPDАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.Облигация);	
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") И ПараметрыНастройкиДляPDАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда	
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.ЦеннаяБумага);	
	ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") И ПараметрыНастройкиДляPDАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии Тогда	
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага.ЦеннаяБумага);	
	Иначе
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	Запрос.УстановитьПараметр("ТаблицаPD", ТаблицаPD);
	
	Если ЭтотОбъект.Дата < '20230531' Тогда
		Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Ложь);
	Иначе
		Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Истина);
	КонецЕсли;
	
	Если ПараметрыНастройкиДляPDАктиваНаДату.ЕстьPD2Стадии Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "	ТаблицаPD.PD КАК PD", "	ТаблицаPD.PD2Стадии КАК PD")	
	КонецЕсли;	
	
	Если ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "	ТаблицаPD.PD КАК PD", "	ТаблицаPD.LGD КАК PD")	
	КонецЕсли;	
	
	Если ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ(РейтингиСрезПоследних", "МАКСИМУМ(РейтингиСрезПоследних");
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.PD;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция ПолучитьБумагиИЭмитентыВДефолте()

	СтатусыДефолтов = Новый Массив;
	СтатусыДефолтов.Добавить(Перечисления.СтатусыДефолтаПоОблигациям.Дефолт);
	СтатусыДефолтов.Добавить(Перечисления.СтатусыДефолтаПоОблигациям.НеисполнениеОферты);
	СтатусыДефолтов.Добавить(Перечисления.СтатусыДефолтаПоОблигациям.ПросрочкаИсполненияОферты);
	СтатусыДефолтов.Добавить(Перечисления.СтатусыДефолтаПоОблигациям.ТехническийДефолт);
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ДефолтыПоОблигациямСрезПоследних.Облигация КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК Эмитент,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК ЦеннаяБумага,
		|	РАЗНОСТЬДАТ(ДефолтыПоОблигациямСрезПоследних.Период, &День, ДЕНЬ) КАК СрокДефолта
		|ПОМЕСТИТЬ _АктивыВДефолте
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&День, ) КАК ДефолтыПоОблигациямСрезПоследних
		|ГДЕ
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта В(&СтатусыДефолтов)
		|	И РАЗНОСТЬДАТ(ДефолтыПоОблигациямСрезПоследних.Период, &День, ДЕНЬ) >= 15
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _Эмитенты30
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта <= 30
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _Эмитенты90
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта > 30
		|	И _АктивыВДефолте.СрокДефолта <= 90
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _ЭмитентыБольше90
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта > 90
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Бумаги30
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта <= 30
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _Бумаги90
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта > 30
		|	И _АктивыВДефолте.СрокДефолта <= 90
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыВДефолте.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _БумагиБольше90
		|ИЗ
		|	_АктивыВДефолте КАК _АктивыВДефолте
		|ГДЕ
		|	_АктивыВДефолте.СрокДефолта > 90";
	
	Запрос.УстановитьПараметр("День",				НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СтатусыДефолтов",	СтатусыДефолтов);
	
	Запрос.Выполнить();
	
	Эмитенты30 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Эмитенты30"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Эмитент");
	Эмитенты90 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Эмитенты90"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Эмитент");
	ЭмитентыБольше90 = Запрос.МенеджерВременныхТаблиц.Таблицы["_ЭмитентыБольше90"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Эмитент");
	Бумаги30 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Бумаги30"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	Бумаги90 = Запрос.МенеджерВременныхТаблиц.Таблицы["_Бумаги90"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	БумагиБольше90 = Запрос.МенеджерВременныхТаблиц.Таблицы["_БумагиБольше90"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
	Возврат Новый Структура("Эмитенты30, Эмитенты90, ЭмитентыБольше90, Бумаги30, Бумаги90, БумагиБольше90",
					Эмитенты30, Эмитенты90, ЭмитентыБольше90, Бумаги30, Бумаги90, БумагиБольше90);

КонецФункции

Функция ПолучитьМинимальноеКоличествоПереходовАктиваНаДату(ДатаПартии, ЦеннаяБумага, Эмитент, ТаблицаКоличестваПереходов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКоличестваПереходов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ТаблицаКоличестваПереходов.СтрокаРейтинга КАК СтрокаРейтинга,
		|	ТаблицаКоличестваПереходов.НомерРейтинга КАК НомерРейтинга,
		|	ТаблицаКоличестваПереходов.МинимальноеКоличествоПереходов КАК МинимальноеКоличествоПереходов
		|ПОМЕСТИТЬ _ТаблицаКоличестваПереходов
		|ИЗ
		|	&ТаблицаКоличестваПереходов КАК ТаблицаКоличестваПереходов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ТаблицаКоличестваПереходов.МинимальноеКоличествоПереходов) КАК МинимальноеКоличествоПереходов
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&День,
		|			Субъект В (&Эмитент, &ЦеннаяБумага)
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &День)) КАК РейтингиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&День, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаКоличестваПереходов КАК _ТаблицаКоличестваПереходов
		|		ПО РейтингиСрезПоследних.РейтинговоеАгентство = _ТаблицаКоличестваПереходов.РейтинговоеАгентство
		|			И РейтингиСрезПоследних.ЗначениеРейтинга.Наименование = _ТаблицаКоличестваПереходов.СтрокаРейтинга
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &День
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("День", НачалоДня(ДатаПартии));
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Эмитент", Эмитент);
	Запрос.УстановитьПараметр("ТаблицаКоличестваПереходов", ТаблицаКоличестваПереходов);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.МинимальноеКоличествоПереходов;
	КонецЕсли;
	
	Возврат 1;

КонецФункции

Функция ПолучитьТаблицуПредидущихСтадий()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтадииОбесцененияАктивовСрезПоследних.Актив КАК Актив,
		|	СтадииОбесцененияАктивовСрезПоследних.СтадияОбесценения КАК СтадияОбесценения,
		|	СтадииОбесцененияАктивовСрезПоследних.Организация КАК Организация,
		|	СтадииОбесцененияАктивовСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтадииОбесцененияАктивовСрезПоследних.Партия КАК Партия,
		|	СтадииОбесцененияАктивовСрезПоследних.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ТаблицаСтадий
		|ИЗ
		|	РегистрСведений.СтадииОбесцененияАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтадииОбесцененияАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСтадий.Актив КАК Актив,
		|	МАКСИМУМ(СтадииОбесцененияАктивов.Период) КАК Период,
		|	_ТаблицаСтадий.СтадияОбесценения КАК СтадияОбесценения,
		|	_ТаблицаСтадий.Организация КАК Организация,
		|	_ТаблицаСтадий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТаблицаСтадий.Партия КАК Партия,
		|	_ТаблицаСтадий.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ДатаПереходаНаСтадиюНаблюдения
		|ИЗ
		|	_ТаблицаСтадий КАК _ТаблицаСтадий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтадииОбесцененияАктивов КАК СтадииОбесцененияАктивов
		|		ПО _ТаблицаСтадий.Актив = СтадииОбесцененияАктивов.Актив
		|			И _ТаблицаСтадий.Организация = СтадииОбесцененияАктивов.Организация
		|			И _ТаблицаСтадий.СчетДоверительногоУправления = СтадииОбесцененияАктивов.СчетДоверительногоУправления
		|			И _ТаблицаСтадий.Партия = СтадииОбесцененияАктивов.Партия
		|			И _ТаблицаСтадий.СтрокаПартии = СтадииОбесцененияАктивов.СтрокаПартии
		|ГДЕ
		|	(_ТаблицаСтадий.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия2ВРежимеНаблюдения)
		|			ИЛИ _ТаблицаСтадий.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия3ВРежимеНаблюдения)
		|				И _ТаблицаСтадий.СтадияОбесценения <> СтадииОбесцененияАктивов.СтадияОбесценения)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаСтадий.Актив,
		|	_ТаблицаСтадий.СтадияОбесценения,
		|	_ТаблицаСтадий.Организация,
		|	_ТаблицаСтадий.СчетДоверительногоУправления,
		|	_ТаблицаСтадий.Партия,
		|	_ТаблицаСтадий.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСтадий.Актив КАК Актив,
		|	_ТаблицаСтадий.СтадияОбесценения КАК СтадияОбесценения,
		|	_ТаблицаСтадий.Организация КАК Организация,
		|	_ТаблицаСтадий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТаблицаСтадий.Партия КАК Партия,
		|	_ТаблицаСтадий.СтрокаПартии КАК СтрокаПартии,
		|	ЕСТЬNULL(_ДатаПереходаНаСтадиюНаблюдения.Период, НЕОПРЕДЕЛЕНО) КАК ДатаПереходаНаСтадиюОбесценения
		|ИЗ
		|	_ТаблицаСтадий КАК _ТаблицаСтадий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатаПереходаНаСтадиюНаблюдения КАК _ДатаПереходаНаСтадиюНаблюдения
		|		ПО _ТаблицаСтадий.Актив = _ДатаПереходаНаСтадиюНаблюдения.Актив
		|			И _ТаблицаСтадий.Организация = _ДатаПереходаНаСтадиюНаблюдения.Организация
		|			И _ТаблицаСтадий.СчетДоверительногоУправления = _ДатаПереходаНаСтадиюНаблюдения.СчетДоверительногоУправления
		|			И _ТаблицаСтадий.Партия = _ДатаПереходаНаСтадиюНаблюдения.Партия
		|			И _ТаблицаСтадий.СтрокаПартии = _ДатаПереходаНаСтадиюНаблюдения.СтрокаПартии";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ПолучитьСправедливуюСтоимостьБумагРЕПОИСуммуПервойЧасти(СделкиРЕПО, УчитыватьКомиссию = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумагаВРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	УсловияСделокРЕПОСрезПоследних.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокРЕПОСрезПоследних.Сумма КАК Сумма,
		|	УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК СуммаКупона,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.Организация КАК Организация,
		|	УсловияСделокРЕПОСрезПоследних.Рынок КАК Рынок,
		|	УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокРЕПОСрезПоследних.Количество КАК Количество
		|ПОМЕСТИТЬ _УсловияСделокРЕПО
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&Период,
		|			СделкаРЕПО В (&СделкиРЕПО)
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходыПоСделкеОбороты.Сделка КАК Сделка,
		|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(РасходыПоСделкеОбороты.СуммаОборот) КАК Комиссии
		|ПОМЕСТИТЬ _Комиссии
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			,
		|			,
		|			,
		|			Сделка В (&СделкиРЕПО)
		|				И &УчитыватьКомиссию) КАК РасходыПоСделкеОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	РасходыПоСделкеОбороты.Сделка,
		|	РасходыПоСделкеОбороты.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
		|	СтоимостьПереоценки.Организация КАК Организация,
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СтоимостьПереоценкиСрезПоследних
		|ИЗ
		|	_УсловияСделокРЕПО КАК УсловияСделокРЕПОСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ПО (СтоимостьПереоценки.Организация = УсловияСделокРЕПОСрезПоследних.Организация)
		|			И (СтоимостьПереоценки.Рынок = УсловияСделокРЕПОСрезПоследних.Рынок)
		|			И (СтоимостьПереоценки.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага)
		|			И (СтоимостьПереоценки.СчетДоверительногоУправления = УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления)
		|			И (СтоимостьПереоценки.Партия = НЕОПРЕДЕЛЕНО)
		|			И (СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки))
		|			И (НАЧАЛОПЕРИОДА(СтоимостьПереоценки.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумагаВРЕПО КАК ЦеннаяБумагаВРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.Эмитент КАК Эмитент,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценкиСрезПоследних.Цена ЕСТЬ NULL
		|				ИЛИ НАЧАЛОПЕРИОДА(УсловияСделокРЕПОСрезПоследних.ДатаПоставки, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.Сумма + УсловияСделокРЕПОСрезПоследних.СуммаКупона + ЕСТЬNULL(_Комиссии.Комиссии, 0)
		|		ИНАЧЕ УсловияСделокРЕПОСрезПоследних.Количество * (ЕСТЬNULL(СтоимостьПереоценкиСрезПоследних.Цена, 0) + ЕСТЬNULL(СтоимостьПереоценкиСрезПоследних.ЦенаКупона, 0))
		|	КОНЕЦ КАК СправедливаяСтоимостьЦБ,
		|	УсловияСделокРЕПОСрезПоследних.Сумма + УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК СтоимостьПервойЧастиРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК ЦеннаяБумага
		|ИЗ
		|	_УсловияСделокРЕПО КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтоимостьПереоценкиСрезПоследних КАК СтоимостьПереоценкиСрезПоследних
		|		ПО (СтоимостьПереоценкиСрезПоследних.Организация = УсловияСделокРЕПОСрезПоследних.Организация)
		|			И (СтоимостьПереоценкиСрезПоследних.Рынок = УсловияСделокРЕПОСрезПоследних.Рынок)
		|			И (СтоимостьПереоценкиСрезПоследних.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага)
		|			И (СтоимостьПереоценкиСрезПоследних.СчетДоверительногоУправления = УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Комиссии КАК _Комиссии
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = _Комиссии.Сделка
		|			И УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага = _Комиссии.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("УчитыватьКомиссию", УчитыватьКомиссию);
	Запрос.УстановитьПараметр("СделкиРЕПО", СделкиРЕПО);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

