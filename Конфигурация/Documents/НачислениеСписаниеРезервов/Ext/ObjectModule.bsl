		ТаблицаPD = ПолучитьТаблицуPD("ВолгаКапиталШкалаPD", Истина);
		
		ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов("ВолгаКапиталШкалаPD", Истина);
		
		// "Для целей настоящей Методики рейтинги группы G, I признаются преддефолтными;"
		// в нашей таблице шкал PD это номер грейда 7 и ниже или без рейтинга
		УровеньПреддефолтногоРейтинга = 22;
		
	Иначе
		
		ТаблицаPD = ПолучитьТаблицуPD("ВолгаКапиталШкалаPD_08_2025", Истина);
		
		ТаблицаКоличестваПереходов = ПолучитьТаблицуКоличестваПереходов("ВолгаКапиталШкалаPD_08_2025", Истина);
		
		// "Для целей настоящей Методики рейтинги группы G, I признаются преддефолтными;"
		// в нашей таблице шкал PD это номер грейда 7 и ниже или без рейтинга
		УровеньПреддефолтногоРейтинга = 20;
		
	КонецЕсли;	
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.УчитыватьPutОферту									 = Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	Если ЭтотОбъект.Дата < ДатаМетодики2025 Тогда
		ПараметрыАктивовПоАС.ВМНОУчитыватьВсюСумму								 = Истина;
		ПараметрыАктивовПоАС.МНОРаздельныйУчетПроцентовИТела					 = Истина;
	Иначе
		ПараметрыАктивовПоАС.ВМНОУчитыватьВсюСумму								 = Ложь;
		ПараметрыАктивовПоАС.МНОРаздельныйУчетПроцентовИТела					 = Ложь;
	КонецЕсли;	
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	ТаблицаКоличестваПереходовГосударственныхОблигаций = ТаблицаКоличестваПереходов.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
				Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
				КонецЦикла;	
				ЭтоГосБумага = Истина;
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				// Вероятность дефолта PD (1 year PD) для активов без рейтинга определяется, как среднее значение PD (1 year PD) для диапазона от BBB+ до  CCC по рейтинговой шкале Эксперт РА.
				// Из Приложение 1
				Если ЭтотОбъект.Дата < ДатаМетодики2025 Тогда
					СтрокаАктивы.PD	= 16.701;
				Иначе
					СтрокаАктивы.PD	= 17.24;
				КонецЕсли;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			// Стадии всего три, и по методике, и по МСФО, в зависимости от стадии сильно разнятся формулы расчетов
			// В методике это описано в разделе 4. ОПРЕДЕЛЕНИЕ СТАДИЙ ОБЕСЦЕНЕНИЯ
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
				// Преддефолтный уровень рейтинга это G и I По приложение 2.
				// "Для целей настоящей Методики рейтинги группы G, I признаются преддефолтными;"
				// в нашей табличке это номер грейда 7 или без рейтинга
			ИначеЕсли (СтрокаАктивы.УровеньРейтинга >= УровеньПреддефолтногоРейтинга И СтрокаАктивы.УровеньРейтинга <> 100) Или (СтрокаАктивы.УровеньРейтинга = 100) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// Еще один из доступных нам критериев перехода на стадию 2, это:
				// "Ухудшение группы кредитного качества контрагента на дату расчета резерва под ОКУ по сравнению с датой первоначального признания"
				// Остальные нам не доступны и могут быть введены только профсуждением
				
				// В зависимости от вида активов опеределяем дату первоначального признания
				Если ЗначениеЗаполнено(СтрокаАктивы.ДатаПервоначальногоПризнания) Тогда 
					ДатаПП = Макс(СтрокаАктивы.ДатаПервоначальногоПризнания, СтрокаАктивы.ДатаPutОферты); 
				Иначе
					ДатаПП = Неопределено;
				КонецЕсли;	
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					// В зависимости от рейтинга при начальном признании определяется минимальное количество переходов для ухудшения качества и перехода на стадию 2
					// Кол-во переходов задано в Таблице 2 методики и сохранено в макете ВолгаКапиталШкалаPD
					Если Не ЭтоГосБумага Тогда
						МинимальноеКоличествоПереходов = ПолучитьМинимальноеКоличествоПереходовАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаКоличестваПереходов);
					Иначе
						Для Каждого СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций Из ТаблицаКоличестваПереходовГосударственныхОблигаций Цикл
							МинимальноеКоличествоПереходов = СтрокаТаблицаКоличестваПереходовГосударственныхОблигаций.МинимальноеКоличествоПереходов;
						КонецЦикла;	
					КонецЕсли;	
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверим не был ли переход с бОльших стадий, и нет ли необходимости перевода на стадию наблюдения
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
							СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
							// Режим наблюдения на 2й стадии
							Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
								Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
									СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
								КонецЕсли;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;	
						Иначе
							// Режим наблюдения на 3й стадии
							Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
								Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
									СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
								КонецЕсли;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;	
							
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			// Потом определим LGD 
			//Для следующих сегментов:
			//•	денежные средства, размещенные на банковских (расчетных, валютных) счетах в кредитных организациях;
			//•	денежные средства на брокерских счетах;
			//•	денежные средства на депозитах/ денежные средства, размещенные по соглашению о неснижаемом остатке,
			//применяется консервативная предпосылка о невозвратности вложений в данные активы в случае дефолта, и LGD принимается равным 100%.
			//
			
			//В случае отсутствия релевантной информации подтвержденной службой риск-менеджмента Фонда 
			//(например, отчета оценщика или релевантных рыночных оценок стоимости ипотечного покрытия или
			//иных видов обеспечения) ожидаемый уровень потерь в случае наступления дефолта (LGD) принимается равным 100%.		
			//Upd: в письме от 29.11.2024 в ответе фонда на вопросы по поводу LGD ответили следующее:
			//По 1 вопросу – LGD всегда 100% и по РЕПО тоже. Формула (5) – это исключительные случаи – ручная работа.
			//Upd2: в окончательной методике от 23.12.24 добавилось про 5% для РЕПО с ЦК
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
				Если СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ") Тогда
					//8. Для обратного РЕПО с Центральным контрагентом LGD принимается равным 5%.
					СтрокаРасчетРезервов.LGD = 0.05; 
				Иначе
					СтрокаРасчетРезервов.LGD = 1;
				КонецЕсли;
			Иначе
				СтрокаРасчетРезервов.LGD = 1;
			КонецЕсли;	
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			Если СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
				
				// письмо от 23.01.2025 от Бородина Елена Юрьевна <borodina@region.ru>
				// Проговорила с Надеждой Новиковой, берем рейтинг НКО. 
				// Прилагаю письмо от Спецдепа.
				// По поводу БК РЕГИОН:
				// ДС на счете брокера фактически размещены в НКО АО НРД соответственно и рейтинг применяется исходя из этого.
				
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				СтрокаРасчетРезервов.PD = ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Дата), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
				СтрокаРасчетРезервов.Профсуждение = Истина;
				СтрокаРасчетРезервов.ЗначениеРейтинга = "AAA(RU)";
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
			КонецЕсли;
			
			
			// А теперь расчеты
			// Сразу определим дату окончания денежного потока по ценной бумаге
			// 7.2.2. для денежных средств 1 день
			// 7.2.1. дебиторская задолженность по процентному (купонному) доходу, частичному/
			// полному погашению эмитентом основного долга по долговым ценным бумагам – 5
			// календарных дней;
			// • дебиторская задолженность по выплате дивидендов по акциям, дохода по
			// депозитарным распискам – 30 календарных дней;
			// Письмом фонда от 15.04.25 уточнено что 5 и 30 дней это константа от текущей даты расчета резерва, а не от даты образования ДЗ
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
				ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 5 * 60 * 60 * 24;
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов")	Тогда	
				ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 30  * 60 * 60 * 24;
			Иначе	
				ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения; 
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// На первой стадии рассчитывается вероятность дефлота в течении первого года. Поэтому не более 365 дней
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 12);
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 12) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)), 12);
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)), 12) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "EAD * (1-((1-PD/100))^(D/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "LGD * EAD";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			Если ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
				РасчетРезервов.Свернуть("Партия, СтрокаПартии, Актив, АналитикаРезерва, СтадияОбесценения, ЗначениеРейтинга, PD, LGD, ДатаПогашения, ДнейДоПогашения, Формула,
				|macro, ВидРезерва, Профсуждение, Реструктуризация, РейтингДефолт, КоэффициентРезерва, Лицо, PDНач, LGDНач, ДлительностьДефолта, ПадениеРейтингаНа2Стадии",
				"СуммаРезерваПартии, Количество, EAD, РучнаяКорректировка");
			КонецЕсли;
		КонецЕсли;
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_Аквилон

Процедура ЗаполнитьРезервыАквилон(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("АквилонШкалаPD", Истина, Истина, Истина);
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	// 2.2.1 снижение кредитного рейтинга на 2 ступени с момента первоначального признания
	МинимальноеКоличествоПереходов = 2;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
				Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
					// В таблице не LGD, а RR 
					СтрокаАктивы.LGD = 1 - СтрокаРейтингГосударственныхОблигаций.LGD/100;
				КонецЦикла;	
				ЭтоГосБумага = Истина;
				
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БрокерскиеКомпании") И ЭтотОбъект.Дата >= '20250224' Тогда
				//#571995 Надя написала:
				//с 24 числа нужно внести изменения в расчет резерва по ДС у брокера. Контрагента поменять на НКЦ.
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				СтрокаАктивы.PD = ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Дата), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
				СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
				СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
				СтрокаРасчетРезервов.Профсуждение = Истина;
				
				Если ЭтотОбъект.Дата >= '20250623' Тогда // про LGD вспомнили только к 23.06
					ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
					ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
					
					СтрокаАктивы.LGD = 1 - ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
					
					ЭтоГосБумага = Истина;
				КонецЕсли;	
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ вероятность дефолта определяется 
				//как средняя вероятность дефолта на горизонте 1 год для Speculative Grade от агентства Moody’s.
				
				СтрокаАктивы.PD	= 4.08;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			// Стадии всего три, и по методике, и по МСФО, в зависимости от стадии сильно разнятся формулы расчетов
			// В методике это описано в разделе 2.	СТАДИИ КРЕДИТНОГО ОБЕСЦЕНЕНИЯ
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// Еще один из доступных нам критериев перехода на стадию 2, это:
				// "Ухудшение группы кредитного качества контрагента на дату расчета резерва под ОКУ по сравнению с датой первоначального признания"
				// Остальные нам не доступны и могут быть введены только профсуждением
				
				// В зависимости от вида активов опеределяем дату первоначального признания
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверим не был ли переход с бОльших стадий, и нет ли необходимости перевода на стадию наблюдения
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Или СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 180 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			
			//Значение показателя LGD не зависит от стадии обесценения.
			//7.1.	Определение LGD для группы контрагентов РК
			//	Значение показателя уровня потерь определяется по формуле:
			//	LGD = 100% - RR
			//	где RR (recovery rate) – ожидаемый процент возврата
			//	Значения ожидаемого процента возврата (RR) приведены в Приложении 2 к настоящей Методике.
			
			Если Не ЭтоГосБумага Тогда
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
				
				СтрокаРасчетРезервов.LGD = 1 - ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
				
				Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
					//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ ожидаемый процент возврата (RR) определяется для категории
					// Speculative Grade от агентства Moody’s			
					СтрокаРасчетРезервов.LGD = 1 - 0.382;
				КонецЕсли;	
			КонецЕсли;
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			// 6.3 В качестве срока обращения актива t при отсутствии доступной информации о сроке обращения для оценки используется срок 1 день.
			ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			//6.3.1.2.	На горизонте более одного года
			//На горизонте свыше одного года для Стадии 1 значение вероятности дефолта PDt принимается равной вероятности дефолта на горизонте 1 год PD1Y, 
			//определенной в соответствии с п.6.2
			
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				//Округление:
				//6.2.3 Полученная вероятность дефолта PD1Yпр округляется до 2-х знаков после запятой в процентах (до 4-х знаков после запятой в долях) и принимается в качестве вероятности дефолта сроком на 1 год PD1Y
				СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 4);
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)), 4) * СтрокаРасчетРезервов.LGD; // Тут PD_PIT_FLI
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			
			Если ЭтоПолныйРасчет Тогда
				Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
					//Для стадии 2 своё PD
					//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ вероятность дефолта определяется 
					//как средняя вероятность дефолта на горизонте 1 год для Ca от агентства Moody’s.
					
					СтрокаРасчетРезервов.PD	= 35.23;
					
				Иначе
					
					ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
					ПараметрыНастройкиДляPDАктиваНаДату.ЕстьPD2Стадии = Истина;
					
					СтрокаРасчетРезервов.PD	= ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
					
					СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
					Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
						Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
							СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
							СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
						КонецЕсли;	
						СтрокаРасчетРезервов.Профсуждение = Истина;
					КонецЕсли;	
					
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаРасчетРезервов.ДнейДоПогашения <= 365 Тогда
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * PDt * LGD";
			Иначе	
				
				Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
					
					СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
					
					СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
					
				Иначе
					
					СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)), 4);
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * Окр((1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)), 4) * СтрокаРасчетРезервов.LGD; // Тут PD_PIT_FLI
					
					СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
					
				КонецЕсли;
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			//6.1.	Общий порядок определения вероятности дефолта
			//Вероятность дефолта в случае, если контрагент находится в Стадии 3 принимается равной 1 (100%).
			СтрокаРасчетРезервов.PD	= 100 / 100;
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
			
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * PDt * LGD";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_Транснефть

Процедура ЗаполнитьРезервыТранснефть(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("ТранснефтьШкалаPD", Истина, Истина, Истина);
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.ВнутреннийРейтинг									 = Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	ПараметрыАктивовПоАС.БратьНаихудшийРейтинг								 = Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	МинимальноеКоличествоПереходов = 2; // 4.9.1 снижение рейтинга одним или несколькими рейтинговыми агентствами (Эксперт РА, АКРА, НКР, НРА) на более чем 2 ступени согласно таблице 1 Методики;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			// 3.1 в сфере тестирования под обесценение находятся лишь те операции обратного РЕПО, которые проводятся без участия Центрального контрагента 
			// или с участием Центрального контрагента в режиме торгов отличном от режима «РЕПО с ЦК 1 день»
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				Если СтрокаАктивы.ЦеннаяБумага.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					Если ЗначениеЗаполнено(СтрокаАктивы.ЦеннаяБумага.РежимБиржевыхТоргов) Тогда 
						Если Лев(ВРег(СтрокаАктивы.ЦеннаяБумага.РежимБиржевыхТоргов.Код), 3) = "EQR" Тогда
							Продолжить;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная)) Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньВнутреннегоРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
					// В таблице не LGD, а RR 
					СтрокаАктивы.LGD = 1 - СтрокаРейтингГосударственныхОблигаций.LGD/100;
				КонецЦикла;	
				ЭтоГосБумага = Истина;
				
			ИначеЕсли СтрокаАктивы.УровеньВнутреннегоРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// Нет в методике PD для без рейтинга.
				// пока временно 100%
				СтрокаАктивы.PD	= 100;
				
				// У Транснефть этого не написано - поэтому пока закоментировано, но скорее всего будет как в Аквилоне. Поэтому пока сюда подкинем. 
				////При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ вероятность дефолта определяется 
				////как средняя вероятность дефолта на горизонте 1 год для Speculative Grade от агентства Moody’s.
				//
				//СтрокаАктивы.PD	= 4.08;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// Еще один из доступных нам критериев перехода на стадию 2, это:
				// снижение рейтинга одним или несколькими рейтинговыми агентствами (Эксперт РА, АКРА, НКР, НРА) на более чем 2 ступени согласно таблице 1 Методики
				// Остальные нам не доступны и могут быть введены только профсуждением
				
				// В зависимости от вида активов опеределяем дату первоначального признания
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньВнутреннегоРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ВнутреннийРейтинг = Истина;
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.БратьНаихудшийРейтинг = Истина;
					
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньВнутреннегоРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			
			// Проверим не был ли переход с бОльших стадий, и нет ли необходимости перевода на стадию наблюдения
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
							СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
							// Режим наблюдения на 2й стадии
							Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
								Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
									СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
								КонецЕсли;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;	
						Иначе
							// Режим наблюдения на 3й стадии
							Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
								Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
									СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
								КонецЕсли;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;	
							
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			//7.6 LGD = 100% - RR, где RR (recovery rate) - ожидаемый процент возврата.
			Если Не ЭтоГосБумага Тогда
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
				ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = Истина;
				
				СтрокаРасчетРезервов.LGD = 1 - ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
				
				// У Транснефть этого не написано - поэтому пока закоментировано, но скорее всего будет как в Аквилоне. Поэтому пока сюда подкинем. 
				//Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				//	//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ ожидаемый процент возврата (RR) определяется для категории
				//	// Speculative Grade от агентства Moody’s			
				//	СтрокаРасчетРезервов.LGD = 1 - 0.382;
				//КонецЕсли;	
				
			КонецЕсли;	
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			// 7.5 Для расчётных/брокерских счетов, специальных счетов в банках и организациях срок жизни финансового актива определяется как 1 день.
			// С 2026 следующие изменения:
			//Для дебиторской задолженности по процентному (купонному) доходу, частичному/полному погашению эмитентом основного долга по долговым ценным бумагам срок жизни финансового актива определяется как 1 календарный день.
			//Для дебиторской задолженности по дивидендам к получению по ценным бумагам срок жизни финансового актива определяется в соответствии с установленными в документах (решениях) о выплате дивидендов сроками.

			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона") Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")) И НачалоДня(ЭтотОбъект.Дата) >= '20260101' Тогда
				ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 1 * 60 * 60 * 24;
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") И НачалоДня(ЭтотОбъект.Дата) >= '20260101' Тогда	
				ДатаВыкупа = НачалоДня(СтрокаАктивы.ЦеннаяБумага.ДатаОплатыПлановая);
			Иначе	
				ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		
		// С 2026 года упрощенный подход для ДЗ дивидендов и купонов более не применяется
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")) И НачалоДня(ЭтотОбъект.Дата) < '20260101' Тогда
			
			// Письмо Транснефть от 24.02.25	
			// для расчета резерва под ожидаемые кредитные убытки по финансовой дебиторской задолженности 
			// (в том числе по выплате НКД и номинала (полного или частичного) по облигациям российских эмитентов)
			// используется упрощенный подход в соответствии с разделом 9 Методики;	
			СтрокаРасчетРезервов.LGD = 0;
			СтрокаРасчетРезервов.ДнейДоПогашения = 0;
			СтрокаРасчетРезервов.PD = 0;
			
			// По датам пришло уточнение:
			//От Фонда пришло разъяснение:
			//В продолжение телефонного разговора, сообщаем, что в соответствии с пунктом 9.4 Методики оценки обесценения и расчета резерва под ожидаемые кредитные убытки
			//АО «НПФ «Транснефть» просрочка по ДЗ определяется как количество дней с даты ожидаемого исполнения эмитентом/контрагентом обязательств, …, до отчетной даты.
			//Соответственно, в отношении ДЗ по НКД Россетей (4B02-05-65018-D-001P) формирование резерва осуществляется в отчетную дату минус дата возникновения
			// обязательства (т.е. только с 23.01.2025, если НКД не получен).
			
			СтрокаРасчетРезервов.ДатаПогашения = ПолучитьДатуПогашенияЦбИлиКупонаПриУпрощенномПорядке(СтрокаАктивы.ЦеннаяБумага.Дата);
			ДнейПросрочено = (НачалоДня(ЭтотОбъект.Дата) - НачалоДня(СтрокаРасчетРезервов.ДатаПогашения)) / (60 * 60 * 24);
			
			// 9.3
			Если ДнейПросрочено >= 0 И ДнейПросрочено < 90 Тогда
				СтрокаРасчетРезервов.PD = 50;
			ИначеЕсли ДнейПросрочено >= 90 Тогда
				СтрокаРасчетРезервов.PD = 100;
			КонецЕсли;	
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD / 100;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * %";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365); // п7.9 Если срок t более 1 года, то используется оценка вероятности дефолта на 1 год.
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			
			// Получаем PD 2й стадии
			ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
			ПараметрыНастройкиДляPDАктиваНаДату.ЕстьPD2Стадии = Истина;
			ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = Истина;
			
			СтрокаРасчетРезервов.PD	= ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			ДнейДоПогашения = Макс(СтрокаРасчетРезервов.ДнейДоПогашения, 365); // п 7.10 кумулятивная оценка вероятности дефолта эмитента/контрагента с учетом срока жизни актива на момент времени t (но не менее 1 (одного) года)
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			СтрокаРасчетРезервов.PD	= 100; // п. 7.4
			
			СтрокаРасчетРезервов.LGD = 1; // п. 7.8
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD; 
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			Если ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
				РасчетРезервов.Свернуть("Партия, СтрокаПартии, Актив, АналитикаРезерва, СтадияОбесценения, ЗначениеРейтинга, PD, LGD, ДатаПогашения, ДнейДоПогашения, Формула,
				|macro, ВидРезерва, Профсуждение, Реструктуризация, РейтингДефолт, КоэффициентРезерва, Лицо, PDНач, LGDНач, ДлительностьДефолта, ПадениеРейтингаНа2Стадии",
				"СуммаРезерваПартии, Количество, EAD, РучнаяКорректировка");
			КонецЕсли;
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_Югория

Процедура ЗаполнитьРезервыЮгория(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ДатаМетодики2026 = '20260101';
	
	Если ЭтотОбъект.Дата < ДатаМетодики2026 Тогда
		ТаблицаPD = ПолучитьТаблицуPD("ЮгорияШкалаPD");
	Иначе
		ТаблицаPD = ПолучитьТаблицуPD("ЮгорияШкалаPD2026");
	КонецЕсли;	
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы	 							= ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ					 							= Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов		= Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//Приложение № 1 к Порядку резервирования под ожидаемые кредитные убытки
	//Вероятность дефолта (PD) Российской Федерации в лице Министерства Финансов приравнивается к верхнеуровневому внутреннему рейтингу ААА.
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	КредитныеОрганизации = ПолучитьПереченьОбъектов(Справочники.ВидыПеречнейОбъектов.ЦБРФ_КредитныеОрганизации, Справочники.ВнешниеСистемы.ЦБРФ);
	ГосударственныеФинансовыеКорпорации = ПолучитьПереченьОбъектов(Справочники.ВидыПеречнейОбъектов.ЦБРФ_ГосударственныеФинансовыеКорпорации, Справочники.ВнешниеСистемы.ЦБРФ);
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	МинимальноеКоличествоПереходов = 2; // Приложение № 2 к Порядку резервирования под ожидаемые кредитные убытки •	снижение внутреннего рейтинга на 2 и более уровня по сравнению с моментом первоначального признания;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная))
				Или ((ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии")) Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
				КонецЦикла;	
				ЭтоГосБумага = Истина;
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// если нет рейтинга 50% Таблица 1
				
				СтрокаАктивы.PD	= 50;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
				
			ИначеЕсли ЭтотОбъект.Дата < ДатаМетодики2026 И СтрокаАктивы.УровеньРейтинга > 11 И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				// В методике 2026 этот пункт исключили
				//Приложение № 2 к Порядку резервирования под ожидаемые кредитные убытки
				//Признаками обесценения могут являться следующие события:
				//•	для российских объектов рейтинга - гиВВ+  
				// тут с ВВ+ скорее всего ошибка
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				
				
			ИначеЕсли ЭтотОбъект.Дата < ДатаМетодики2026 И СтрокаАктивы.УровеньРейтинга > 10 И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				// В методике 2026 этот пункт исключили
				//Приложение № 2 к Порядку резервирования под ожидаемые кредитные убытки
				//Признаки значительного увеличения кредитного риска
				//•	снижение внутреннего рейтинга ниже уровня ВВВ-.
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// Еще один из доступных нам критериев перехода на стадию 2, это:
				// снижение рейтинга одним или несколькими рейтинговыми агентствами (Эксперт РА, АКРА, НКР, НРА) на более чем 2 ступени согласно таблице 1 Методики
				// Остальные нам не доступны и могут быть введены только профсуждением
				
				// В зависимости от вида активов опеределяем дату первоначального признания
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			//В Методике 2026. Величина LGD для дебиторской задолженности, ожидаемой к получению по второй части сделок РЕПО с ЦК, определяется равной 0%.
			Если ЭтотОбъект.Дата >= ДатаМетодики2026 И ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ") Тогда
				
				СтрокаРасчетРезервов.LGD = 0;
			
			//Уровень потерь в случае дефолта (LGD) зависит от типа эмитента. 
			//- для требований по эмитентам-банкам признается равным 100 %.
			//- для требований по иным эмитентам признается равным 45 %.
			ИначеЕсли КредитныеОрганизации.Найти(СтрокаАктивы.Эмитент) = Неопределено И ГосударственныеФинансовыеКорпорации.Найти(СтрокаАктивы.Эмитент) = Неопределено Тогда // не банк
				СтрокаРасчетРезервов.LGD = 0.45;
			Иначе
				СтрокаРасчетРезервов.LGD = 1;
			КонецЕсли;	
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			// Для финансовых инструментов «до востребования», а также для задолженности по процентному доходу на остаток по расчетному счету (за исключением соглашений НСО)
			// срок жизненного цикла (Т — t0) составляет 1 день.
			ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
			Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")) Тогда
			
			// 03.04.25 в задаче #576145 Татьяна написала что для ДЗ по погашению купонов используем упрощенный подход. В методике это не понятно.
			СтрокаРасчетРезервов.LGD = 0;
			СтрокаРасчетРезервов.ДнейДоПогашения = 0;
			СтрокаРасчетРезервов.PD = 0;
			
			СтрокаРасчетРезервов.ДатаПогашения = ПолучитьДатуПогашенияЦбИлиКупонаПриУпрощенномПорядке(СтрокаАктивы.ЦеннаяБумага.Дата);
			ДнейПросрочено = (НачалоДня(ЭтотОбъект.Дата) - НачалоДня(СтрокаРасчетРезервов.ДатаПогашения)) / (60 * 60 * 24);
			
			// 3.
			Если ДнейПросрочено > 45 И ДнейПросрочено <= 90 Тогда
				СтрокаРасчетРезервов.PD = 50;
			ИначеЕсли ДнейПросрочено > 90 Тогда
				СтрокаРасчетРезервов.PD = 100;
			КонецЕсли;	
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD / 100;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * %";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			// для второй стадии по методике нет различия с первой, но пока оставим ей ветку
			// Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			// и для третьей стадии по методике нет различия с первой, но пока оставим ей ветку вернее там есть что-то очень смешной про "ровняется" на сроке более года, но пока на это забьем. 
			
			// Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * (1- ((1-PD1Y))^(t/365)) * LGD";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_ХантыМансийский

Процедура ЗаполнитьРезервыХантыМансийский(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("ХантыМансийскийШкалаPD");
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	// Письмом 16.01.25 от Максимов Алексей в МНО учитывается и тело и %% 
	// А письмом 75/25 от 20.01.25 опять передумали
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы								 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ												 = Истина;
	ПараметрыАктивовПоАС.ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств	 = ЕжедневноеНачислениеРезервовНаОстаткиДенежныхСредств;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов		 = Истина;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//5.4.	Вероятность дефолта (PD) Российской Федерации в лице Министерства Финансов приравнивается к верхнеуровневому внутреннему рейтингу ААА.
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	// 2.3 снижение внутреннего рейтинга на 2 и более уровня по сравнению с моментом первоначального признания;
	МинимальноеКоличествоПереходов = 2; 
	
	МассивСделокРЕПО = Новый Массив;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			МассивСделокРЕПО.Добавить(СтрокаАктивы.ЦеннаяБумага);	
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаСделокРЕПО = ПолучитьСправедливуюСтоимостьБумагРЕПОИСуммуПервойЧасти(МассивСделокРЕПО);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") 
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
				КонецЦикла;	
				ЭтоГосБумага = Истина;
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// п. 5.3
				СтрокаАктивы.PD	= 50;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
				// 2. признание дефолта/банкротства
				
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
				// теперь на стадию 2	
			ИначеЕсли СтрокаАктивы.УровеньРейтинга > 10 И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				//п. 2.3 снижение внутреннего рейтинга ниже уровня ВВВ-;
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// п. 2.3 снижение внутреннего рейтинга на 2 и более уровня по сравнению с моментом первоначального признания;
				// В зависимости от вида активов опеределяем дату первоначального признания
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// 3.8 В случае восстановления кредитного качества инструментов, отнесенных к Стадии 3, к ним применяется период наблюдения. 
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
						КонецЕсли;	
						
					ИначеЕсли СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							Иначе
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или
				СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
				//6.3 LGD для необеспеченного финансового инструмента на Стадии 3 устанавливается равным 100%.
				СтрокаРасчетРезервов.LGD = 1;
				
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
				
				//6.2.	По сделкам РЕПО и облигациям с обеспечением/облигациям с ипотечным покрытием LGD определяется следующим образом: 
				//При полном покрытии обеспечением LGD = 0%, 
				ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО = Ложь;
				НетДанныхПоСС = Ложь;
				LTV = 0;
				
				ОтборПоСделкамРЕПО = Новый Структура();
				ОтборПоСделкамРЕПО.Вставить("ЦеннаяБумага", СтрокаАктивы.ЦеннаяБумага);
				СтрокиТаблицаСделокРЕПО = ТаблицаСделокРЕПО.НайтиСтроки(ОтборПоСделкамРЕПО);
				Если СтрокиТаблицаСделокРЕПО.Количество() > 0 Тогда
					Для Каждого СтрокаТаблицыСделокРЕПО Из СтрокиТаблицаСделокРЕПО Цикл
						Если СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ >=	СтрокаТаблицыСделокРЕПО.СтоимостьПервойЧастиРЕПО Тогда
							ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО = Истина;	
						ИначеЕсли Не ЗначениеЗаполнено(СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ) Тогда	
							НетДанныхПоСС = Истина;	
						Иначе
							LTV = СтрокаТаблицыСделокРЕПО.СтоимостьПервойЧастиРЕПО/СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ;
						КонецЕсли;
					КонецЦикла;
				Иначе
					НетДанныхПоСС = Истина;	
				КонецЕсли;
				
				//При полном покрытии обеспечением LGD = 0%,
				Если ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО Тогда
					СтрокаРасчетРезервов.LGD = 0;
					//При отсутствии данных о справедливой стоимости ценных бумаг в обеспечении по сделкам РЕПО / стоимости обеспечения или стоимости ипотечного покрытия LGD = 45%	
				ИначеЕсли НетДанныхПоСС Тогда
					СтрокаРасчетРезервов.LGD = 0.45;
					//Иначе по формуле LGD = 1 – 1/LTV, (5)	
				ИначеЕсли ЗначениеЗаполнено(LTV) Тогда
					СтрокаРасчетРезервов.LGD = 1 - 1/LTV;
				Иначе
					СтрокаРасчетРезервов.LGD = 0.45;
				КонецЕсли;	
				
			Иначе	
				//6.1.	Уровень потерь при дефолте (LGD) для необеспеченных несубординированных требований принимается равным 45%,
				//для субординированных требований принимается равным 75%			
				Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
					Если СтрокаАктивы.ЦеннаяБумага.Субординированность Тогда
						СтрокаРасчетРезервов.LGD = 0.75;
					Иначе
						СтрокаРасчетРезервов.LGD = 0.45;
					КонецЕсли;
				Иначе
					СтрокаРасчетРезервов.LGD = 0.45;
				КонецЕсли;	
			КонецЕсли;		
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			//Письмо 75/25 от 20.01.25 (я его увидел только 13.01.26) - для дивидендов 10 рабочих дней
			Если НачалоДня(ЭтотОбъект.Дата) >= '20260101' И ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
				ДатаВыкупа = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(СтрокаАктивы.ЦеннаяБумага.ДатаРеестра + 1), 10);
			Иначе	
				//Для финансовых инструментов «до востребования», не имеющих сроков погашения, коэффициент k принимается равным 7 дням
				ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 7);
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD * Мин(Окр(ДнейДоПогашения / 365, 4) , 1);
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * PD * LGD * min(k,1)";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD)^((T-t)⁄365))";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			
			Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
				
			Иначе
				
				СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365));
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), СтрокаРасчетРезервов.ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
				
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD)^((T-t)⁄365))";
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РЕЗЕРВЫ_Национальный

Процедура ЗаполнитьРезервыНациональный(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	// Таблица заполняется из Сценарии стресс-тестирования финансовой устойчивости негосударственных пенсионных фондов
	// https://www.cbr.ru/rsci/activity_npf/stress_npf/
	Если НачалоДня(ЭтотОбъект.Дата) >= Дата(2025, 03, 31) Тогда
		ТаблицаPD = ПолучитьТаблицуPD("НациональныйШкалаPD20250331");
	Иначе
		ТаблицаPD = ПолучитьТаблицуPD("НациональныйШкалаPD");
	КонецЕсли;
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	Если НачалоДня(ЭтотОбъект.Дата) >= '20250506' Тогда
		// Письмо №05-02-03/5@/01590-Исх от 6 мая 2025 г..
		ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Истина;
	КонецЕсли;	
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	
	// 9.2.2.2	понижение на отчетную дату внешнего кредитного рейтинга на 2 ступени с момента первоначального признания 
	МинимальноеКоличествоПереходов = 2; 
	
	МассивСделокРЕПО = Новый Массив;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			МассивСделокРЕПО.Добавить(СтрокаАктивы.ЦеннаяБумага);	
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаСделокРЕПО = ПолучитьСправедливуюСтоимостьБумагРЕПОИСуммуПервойЧасти(МассивСделокРЕПО);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				//Приложение А
				//Вероятность дефолта PD_12m по государственным ценным бумагам и вероятность дефолта Российской Федерации
				//в лице Министерства финансов Российской Федерации, являющегося гарантом по активу, равна 0,01%.
				
				СтрокаАктивы.PD = 0.01;
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = "Государственные бумаги";
				ЭтоГосБумага = Истина;
				
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				// 9-й номер группы кредитного качества из Сценарии стресс-тестирования финансовой устойчивости негосударственных пенсионных фондов
				// Соответствует вероятности дефолта контрагента в 4-м квартале действующих сценариев стресс-тестирования финансовой устойчивости
				// негосударственных пенсионных фондов, утверждаемых Банком России
				СтрокаАктивы.PD	= 15.91;
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
				// 2. признание дефолта/банкротства
				
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// на вторую стадию кроме профсуждений нам доступно только снижение рейтинга и всё
				// 9.2.2.2	понижение на отчетную дату внешнего кредитного рейтинга на 2 ступени с момента первоначального признания 
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии;
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// 9.5.1	В случае, если на отчетную дату для финансового инструмента перестают действовать критерии, в соответствии с которыми 
			//она ранее была отнесена в Стадию 2 в соответствии с п. 9.2.1 Методики, финансовый инструмент должен быть отнесен в Стадию 1 спустя 90 дней наблюдения
			
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
						КонецЕсли;	
						
					ИначеЕсли СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
			
			// 13.1.1	Для финансовых инструментов, по которым отсутствуют внешние кредитные рейтинги или хотя бы один внешний кредитный определен на 
			// уровне дефолтного (уровень D), а также по таким инструментам отсутствует залог, LGD устанавливается в размере 100%
			Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				СтрокаАктивы.LGD = 1;
				
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				
				СтрокаАктивы.LGD = 1;
				
			Иначе	
				
				// пункт 13.1.2
				СтрокаРасчетРезервов.LGD = 0.65;
				
			КонецЕсли;
			
			// Для РЕПО LGD корректируется на сумму обеспечения
			//13.1.3	для финансовых инструментов, по которым присутствует залог/поручительство/гарантия, уровень потерь при дефолте рассчитывается по следующей формуле
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
				
				НетДанныхПоСС = Ложь;
				
				ОтборПоСделкамРЕПО = Новый Структура();
				ОтборПоСделкамРЕПО.Вставить("ЦеннаяБумага", СтрокаАктивы.ЦеннаяБумага);
				СтрокиТаблицаСделокРЕПО = ТаблицаСделокРЕПО.НайтиСтроки(ОтборПоСделкамРЕПО);
				Если СтрокиТаблицаСделокРЕПО.Количество() > 0 Тогда
					Для Каждого СтрокаТаблицыСделокРЕПО Из СтрокиТаблицаСделокРЕПО Цикл
						Если Не ЗначениеЗаполнено(СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ) Тогда	
							НетДанныхПоСС = Истина;	
						КонецЕсли;
					КонецЦикла;
				Иначе
					НетДанныхПоСС = Истина;	
				КонецЕсли;
				
				// формула не очень понятная в ней берется коэффициент стоимость финансового инструмента под риском дефолта (EAD) за вычетом стоимости обеспечения к стоимость финансового инструмента под риском дефолта (EAD)
				// пока для РЕПО считаем что обеспечение это справедливая стоимость.
				Если НетДанныхПоСС Тогда
					СтрокаРасчетРезервов.LGD = 0;
				ИначеЕсли ЗначениеЗаполнено(СтрокаРасчетРезервов.EAD) Тогда	
					СтрокаРасчетРезервов.LGD = Макс(0, СтрокаРасчетРезервов.LGD * ((СтрокаРасчетРезервов.EAD - СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ) / СтрокаРасчетРезервов.EAD));
				Иначе
					СтрокаРасчетРезервов.LGD = 0;
				КонецЕсли;	
				
			КонецЕсли;	
			
			// Еще есть 13.2	Уровень потерь при дефолте финансового инструмента в Стадии 3 но там какая то дикая формула с ЭСП и пр. 
			// Если такое всё же случится то будем хадкодить. И ставку и формулу под каждый случай. Пока такого у них нет и не было.
			// Письмом 23 апреля 2025 г. №05-02-03/5@/01434-Исх подтвердили 1 день на до востребование, купонному доходу и облигациям.
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
				// Письмо №05-02-03/5@/01590-Исх от 6 мая 2025 г..
				// Плановой датой погашения дебиторской задолженности по выплате дивидендов по акциям является 25 рабочий день с даты закрытия реестра для получения дивидендов
				ДатаВыкупа = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, СтрокаАктивы.ЦеннаяБумага.ДатаРеестра, 25);
			Иначе
				ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС);
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// 12.3.2 Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365));
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * (1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365));
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD12m)^((T)⁄365))";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			// 12.3.4 max(1;n)
			ДнейДоПогашения = Макс(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
			
			СтрокаРасчетРезервов.КоэффициентРезерва = (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365));
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * (1 - Pow((1 - СтрокаРасчетРезервов.PD / 100), ДнейДоПогашения / 365)) * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD)^((T)⁄365))";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			// 12.3.5	Для финансовых инструментов в Стадии 3 величина PD признается равной 100%.
			СтрокаРасчетРезервов.PD	= 100;
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезервыНациональный2025(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета, СтрокаПерерасчета = Неопределено)
	
	ЭтоПолныйРасчет = (СтрокаПерерасчета = Неопределено);
	
	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	ТаблицаPD = ПолучитьТаблицуPD("НациональныйШкалаPD2025", , , Истина);
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ТаблицаПредидущихСтадий = ПолучитьТаблицуПредидущихСтадий();
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы							 = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ											 = Истина;
	ПараметрыАктивовПоАС.НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
	//12.1.3	Для облигационных выпусков и дебиторской задолженности по процентному (купонному) доходу, частичному/ 
	//полному погашению эмитентом основного долга по долговым ценным бумагам учитываются рейтинги эмиссии, при отсутствии рейтингов эмиссии используются рейтинги эмитента данной ценной бумаги.
	ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Истина;
	//12.1.2	При наличии у контрагента/ финансового актива кредитных рейтингов нескольких кредитных агентств выбирается кредитный рейтинг
	//с наименьшим номером группы кредитного качества согласно Таблице 1 Приложения А к настоящей Методике.
	ПараметрыАктивовПоАС.БратьНаихудшийРейтинг = Ложь;
	
	Если ЭтоПолныйРасчет Тогда
		АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Иначе
		АктивыПоАС = ПолучитьАктивыПоАСПерерасчет(СтрокаПерерасчета);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//для  ОФЗ  - PD и LGD соответствуют значениям  для рейтинга "ААА" (первой группы кредитного качества)
	РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
	
	//9.2.1.2	понижение на расчетную дату внешнего кредитного рейтинга на 2 ступени с момента первоначального признания 
	МинимальноеКоличествоПереходов = 2; 
	
	МассивСделокРЕПО = Новый Массив;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			МассивСделокРЕПО.Добавить(СтрокаАктивы.ЦеннаяБумага);	
		КонецЕсли;	
	КонецЦикла;	
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	ВариантРасчетаОценочнойСтоимости = НастройкиОценки.ВариантРасчетаОценочнойСтоимости;
	ПараметрыУчетаКомиссийПоРЕПО = Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыУчетаКомиссийПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, ЭтотОбъект.Дата);
	
	Если ПараметрыУчетаКомиссийПоРЕПО = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ТаблицаСделокРЕПО = ПолучитьСправедливуюСтоимостьБумагРЕПОИСуммуПервойЧасти(МассивСделокРЕПО, ПараметрыУчетаКомиссийПоРЕПО.КомиссияПропорциональноДнямВСоставеСделки = Истина);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		СтрокаПрофсужденияПоPDLGD_PDLifeTime = Ложь;
		
		Если ЭтоПолныйРасчет Тогда
			
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
					СтрокаАктивы.LGD = СтрокаРейтингГосударственныхОблигаций.LGD / 100;
					ЭтоГосБумага = Истина;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
				
				//При отсутствии рейтинга финансового актива/ контрагента вероятность дефолта определяется как средняя вероятность дефолта на горизонте 1 год для Speculative Grade от агентства Moody’s.
				//Приложение А строка 23
				СтрокаАктивы.PD	= 4.08;
			ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО")
				И СтрокаАктивы.ЦеннаяБумага.СделкаСЦентральнымКонтрагентом Тогда
				//Для дебиторской задолженности по операциям обратного репо с центральным контрагентом учитывается рейтинг центрального контрагента в лице НКЦ.
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = Ложь;
				СтрокаАктивы.PD = ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Дата), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
				
			КонецЕсли;		
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
			
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
			
			СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
			
			// Прежде всего разберемся со стадией
			
			// Сначала профсуждения
			Если ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
				СтрокаРасчетРезервов.Профсуждение = Истина;
			ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Профсуждение = Истина;
				// затем проверим на стадию 3 как на самую сильную:
				// 1. рейтинг д
				// 2. есть реструктуризация
				// 2. признание дефолта/банкротства
				
			ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 												// 1. рейтинг D
				Или (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
				Или АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.РейтингДефолт = Истина;
			ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено		// 2. есть реструктуризация
				Или ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено) Тогда			
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
				СтрокаРасчетРезервов.Реструктуризация = Истина;
			Иначе
				СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
				
				// на вторую стадию кроме профсуждений нам доступно только снижение рейтинга и всё
				// 9.2.1.2	понижение на отчетную дату внешнего кредитного рейтинга на 2 ступени с момента первоначального признания 
				ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
				
				Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда 
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
					ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = ПараметрыАктивовПоАС.ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии;
					УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
					
					Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= МинимальноеКоличествоПереходов Тогда 
						СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
						СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// 9.5.1	В случае, если на отчетную дату для финансового инструмента перестают действовать критерии, в соответствии с которыми 
			//она ранее была отнесена в Стадию 2 в соответствии с п. 9.2.1 Методики, финансовый инструмент должен быть отнесен в Стадию 1 спустя 90 дней наблюдения
			
			Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения;
						КонецЕсли;	
						
					ИначеЕсли СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 180 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			ИначеЕсли СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или 
						СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
						
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							Если ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата) < 90 Тогда
								СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
							КонецЕсли;
						Иначе
							СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения;
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
	
			Если Не ЭтоГосБумага Тогда
				ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
				ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
				ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = Ложь;
				
				СтрокаРасчетРезервов.LGD = ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Дата), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
				
				Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
					//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ ожидаемый процент возврата (RR) определяется для категории
					// Speculative Grade от агентства Moody’s			
					СтрокаРасчетРезервов.LGD = 0.618;
				КонецЕсли;	
			КонецЕсли;
			
			// Для РЕПО LGD корректируется на сумму обеспечения
			//13.2	Для финансовых активов, по которым присутствует залог, уровень потерь при дефолте рассчитывается по следующей формуле:
			
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда			
				
				НетДанныхПоСС = Ложь;
				
				ОтборПоСделкамРЕПО = Новый Структура();
				ОтборПоСделкамРЕПО.Вставить("ЦеннаяБумага", СтрокаАктивы.ЦеннаяБумага);
				СтрокиТаблицаСделокРЕПО = ТаблицаСделокРЕПО.НайтиСтроки(ОтборПоСделкамРЕПО);
				Если СтрокиТаблицаСделокРЕПО.Количество() > 0 Тогда
					Для Каждого СтрокаТаблицыСделокРЕПО Из СтрокиТаблицаСделокРЕПО Цикл
						Если Не ЗначениеЗаполнено(СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ) Тогда	
							НетДанныхПоСС = Истина;	
						КонецЕсли;
					КонецЦикла;
				Иначе
					НетДанныхПоСС = Истина;	
				КонецЕсли;
				
				// формула не очень понятная в ней берется коэффициент стоимость финансового инструмента под риском дефолта (EAD) за вычетом стоимости обеспечения к стоимость финансового инструмента под риском дефолта (EAD)
				// пока для РЕПО считаем что обеспечение это справедливая стоимость.
				Если НетДанныхПоСС Тогда
					СтрокаРасчетРезервов.LGD = 0;
				ИначеЕсли ЗначениеЗаполнено(СтрокаРасчетРезервов.EAD) Тогда	
					СтрокаРасчетРезервов.LGD = Макс(0, СтрокаРасчетРезервов.LGD * ((СтрокаРасчетРезервов.EAD - СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ) / СтрокаРасчетРезервов.EAD));
				Иначе
					СтрокаРасчетРезервов.LGD = 0;
				КонецЕсли;	
				
			КонецЕсли;	
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
					СтрокаПрофсужденияПоPDLGD_PDLifeTime = СтрокаПрофсужденияПоPDLGD.PDLifeTime;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
	
			//12.3.3	Срок жизни финансового актива, указанный в Таблице 3
			// Далее в комментариях цифры из этой таблицы
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
				// k = срок в календарных днях до наступления 25 рабочего дня с даты закрытия реестра для получения дивидендов
				ДатаВыкупа = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(СтрокаАктивы.ЦеннаяБумага.ДатаРеестра + 1), 25);
			Иначе
				//Остатки денежных средств на расчетных и брокерских счетах, в том числе неснижаемые остатки, депозиты до востребования	k=1
				//Дебиторская задолженность по выплате процентов, начисленных по депозитам и на остатки на расчетных счетах, если расчетная дата, соответствующая дате выплаты процентов, приходится на нерабочий день	k=1
				//Дебиторская задолженность по накопленному купонному доходу, частичному и полному погашению эмитентом основного долга по долговым ценным бумагам	k=1
				//В случае, если расчетная дата, соответствующая дате погашения финансового актива, является нерабочим днем, срок жизни финансового инструмента k=1.
				ДатаВыкупа = ПолучитьДатуВыкупаЦеннойБумаги(НастройкиУчета, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.УчетныйАктивЕПС, 1);
			КонецЕсли;	
			
			ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
			
			СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
			СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
			
		Иначе
			
			СтрокаРасчетРезервов = СтрокаПерерасчета;
			
		КонецЕсли;	
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			// 12.3.2	 Если срок погашения больше года, то применяется вероятность дефолта на 1 год.
			// Все формулы по определению PD и Коэффициента резерва определяются в пункте 12.3.2
			Если СтрокаРасчетРезервов.ДнейДоПогашения > 365 Тогда
				ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD12m";
				
				//12.3.4	Полученная вероятность дефолта (PD) округляется до 13-ти знаков после запятой в процентах (15 знаков в долевом выражении).
				СтрокаРасчетРезервов.КоэффициентРезерва = Окр(СтрокаРасчетРезервов.PD / 100, 15);
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * Окр(СтрокаРасчетРезервов.PD / 100, 15);
				
			Иначе
				
				Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
					
					СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
					
					СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
					
				Иначе
					
					ДнейДоПогашения = Мин(СтрокаРасчетРезервов.ДнейДоПогашения, 365);
					СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD12m)^((T)⁄365))";
					
					//12.3.4	Полученная вероятность дефолта (PD) округляется до 13-ти знаков после запятой в процентах (15 знаков в долевом выражении).
					СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365)), 15);
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * Окр((1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365)), 15);
					
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2ВРежимеНаблюдения Тогда
			// Все формулы по определению PD и Коэффициента резерва определяются в пункте 12.3.2
			Если СтрокаРасчетРезервов.ДнейДоПогашения > 365 Тогда
				
				Если СтрокаПрофсужденияПоPDLGD_PDLifeTime Тогда  // в профсуждении указан PD LifeTime
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.PD / 100;
					
					СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
					
					СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD Lifetime";
					
				Иначе
					
					ДнейДоПогашения = СтрокаРасчетРезервов.ДнейДоПогашения;
					СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * (1 - (1 - PD12m)^((T)⁄365))";
					
					//12.3.4	Полученная вероятность дефолта (PD) округляется до 13-ти знаков после запятой в процентах (15 знаков в долевом выражении).
					СтрокаРасчетРезервов.КоэффициентРезерва = Окр((1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365)), 15);
					
					СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * Окр((1 - Pow(1 - СтрокаРасчетРезервов.PD / 100, ДнейДоПогашения / 365)), 15);
					
				КонецЕсли;
				
			Иначе
				СтрокаРасчетРезервов.Формула = "ECL = EAD * LGD * PD12m";
				
				//12.3.4	Полученная вероятность дефолта (PD) округляется до 13-ти знаков после запятой в процентах (15 знаков в долевом выражении).
				СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD / 100;
				
				СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.LGD * Окр(СтрокаРасчетРезервов.PD / 100, 15);
				
			КонецЕсли;	
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Или СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3ВРежимеНаблюдения Тогда
			// ECL = EAD * PDdef *  LGDdef	PDdef– вероятность дефолта, равная 100%;
			СтрокаРасчетРезервов.PD	= 100;
			
			СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
			
			//LGDdef – доля потерь при дефолте, рассчитываемая в соответствии с п.13.3 настоящей Методики.
			Если ЭтоПолныйРасчет Тогда
				LGDДоПереходаНа3юСтадию = 100;
				T_3_st = 1;
				
				Отбор = Новый Структура();
				Отбор.Вставить("Актив", СтрокаРасчетРезервов.Актив);
				СтрокиТаблицаПредидущихСтадий = ТаблицаПредидущихСтадий.НайтиСтроки(Отбор);
				Для Каждого СтрокаТаблицаПредидущихСтадий Из СтрокиТаблицаПредидущихСтадий Цикл
					
					Если СтрокаТаблицаПредидущихСтадий.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
						Если ЗначениеЗаполнено(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) Тогда
							T_3_st = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения, ЭтотОбъект.Дата);
							
							ПараметрыНастройкиДляPDАктиваНаДату = ПолучитьНастройкиДляPDАктиваНаДату();
							ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
							ПараметрыНастройкиДляPDАктиваНаДату.БратьНаихудшийРейтинг = Ложь;
							
							LGDДоПереходаНа3юСтадию = ПолучитьPDАктиваНаДату(НачалоДня(НачалоДня(СтрокаТаблицаПредидущихСтадий.ДатаПереходаНаСтадиюОбесценения) - 1), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
							
						КонецЕсли;	
						
					КонецЕсли;
				КонецЦикла;	
				
				СтрокаРасчетРезервов.LGD = Мин(1 - T_3_st/365 + LGDДоПереходаНа3юСтадию * (1 - T_3_st/365), 1);
			КонецЕсли;
			
			СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD / 100 * СтрокаРасчетРезервов.LGD;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.Формула = "ECL = EAD * PDdef *  LGDdef";
			
		КонецЕсли;
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоПолныйРасчет Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = РасчетРезервов.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = РасчетРезервов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
		
		ОтсортироватьРасчетРезервов(РасчетРезервов);
		
		Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
			ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
		КонецЕсли;
		
		ДанныеРасчета = РасчетРезервов;
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти
