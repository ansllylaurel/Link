		|							ИЛИ ТИПЗНАЧЕНИЯ(_АктивыПоАС.ЦеннаяБумага) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|							ИЛИ ТИПЗНАЧЕНИЯ(_АктивыПоАС.ЦеннаяБумага) = ТИП(Документ.НачислениеДивидендов)
