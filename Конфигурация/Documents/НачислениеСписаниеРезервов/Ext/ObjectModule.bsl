Процедура ОтсортироватьРасчетРезервов(РасчетРезервов)
	
	РасчетРезервов.Колонки.Добавить("УровеньДляСортировки", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаРасчетРезервов Из РасчетРезервов Цикл
		Если СтрокаРасчетРезервов.ВидРезерва = "Расчетный счет" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 1;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "Брокерский счет" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 2;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "Клиринговый счет" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 3;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "МНО" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 4;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "Депозиты в кредитных организациях" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 5;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "РЕПО" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 6;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "Дебиторская задолженность" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 7;	
		ИначеЕсли СтрокаРасчетРезервов.ВидРезерва = "Долговые ценные бумаги" Тогда
			СтрокаРасчетРезервов.УровеньДляСортировки = 8;	
		Иначе
			СтрокаРасчетРезервов.УровеньДляСортировки = 9;	
		КонецЕсли;	
	КонецЦикла;	
	
	РасчетРезервов.Сортировать("УровеньДляСортировки Возр, Лицо Возр, Актив Возр, Партия Возр, СтрокаПартии Возр");
	
	РасчетРезервов.Колонки.Удалить("УровеньДляСортировки");
	
КонецПроцедуры	

Функция ПолучитьДатуПогашенияЦбИлиКупонаПриУпрощенномПорядке(Знач ДатаПогашенияЦбИлиКупона)
	ДатаПогашенияЦбИлиКупона = НачалоДня(ДатаПогашенияЦбИлиКупона);
	
	Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ДатаПогашенияЦбИлиКупона) Тогда
		ДатаПогашенияЦбИлиКупона = РаботаСДокументами.СледующийРабочийДень(ДатаПогашенияЦбИлиКупона);	
	КонецЕсли;	
	
	Возврат РаботаСДокументами.СледующийРабочийДень(ДатаПогашенияЦбИлиКупона); 
	
КонецФункции	

Функция ВосстанавливатьРезервПоРасчетнымБрокерскимИКлиринговымСчетам()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПорученияНаПереоценку.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	РегистрСведений.ПорученияНаПереоценку КАК ПорученияНаПереоценку
		|ГДЕ
		|	ПорученияНаПереоценку.Активность
		|	И ПорученияНаПереоценку.Организация = &Организация
		|	И ПорученияНаПереоценку.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПорученияНаПереоценку.ДатаПереоценки = &ДатаПереоценки
		|	И ПорученияНаПереоценку.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И ПорученияНаПереоценку.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивовДляПорученийНаПереоценку.РезервПоРасчетнымБрокерскимИКлиринговымСчетам)";
	
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции
				
#КонецОбласти

#Область РЕЗЕРВЫ_СНГ

Процедура ЗаполнитьРезервыСНГ(Отказ, ДанныеРасчета, ТолькоПоступившиеАктивы, НастройкиУчета) 

	РасчетРезервов = ПолучитьТаблицуРасчетРезервов();
	
	// подготовим данные для проверки
	БумагиИЭмитентыВДефолте = ПолучитьБумагиИЭмитентыВДефолте();	// Эмитенты30, Эмитенты90, ЭмитентыБольше90, Бумаги30, Бумаги90, БумагиБольше90
	
	ДанныеРеструктуризаций = ПолучитьДанныеРеструктуризаций(); // БумагиСРеструктуризацией, ЭмитентыСРеструктуризацией, БумагиСРеструктуризацией6месяцевНазад, ЭмитентыСРеструктуризацией6месяцевНазад
	
	АктивыСДефолтнымРейтингом = ПолучитьАктивыСДефолтнымРейтингом();
	
	ПрофсужденияПоСтадиямОбесценения = ПолучитьПрофсужденияПоСтадиямОбесценения(); // Стадия1, Стадия2, Стадия3
	ПрофсужденияПоPDLGD = ПолучитьПрофсужденияПоPDLGD();
	
	ФинасовыеОрганизации = ПолучитьПереченьОбъектов(Справочники.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора, Справочники.ВнешниеСистемы.ЦБРФ, Истина);
	СистемноЗначимыеКредитныеОрганизации = ПолучитьПереченьОбъектов(Справочники.ВидыПеречнейОбъектов.СистемноЗначимыеКредитныеОрганизацииОтЦБРФ, Справочники.ВнешниеСистемы.МинФин);
	КорпоративныеЭмитентыСУчастиемГосударстваБолее25Процентов = ПолучитьПереченьОбъектов(Справочники.ВидыПеречнейОбъектов.КорпоративныеЭмитентыСУчастиемГосударстваБолее25Процентов, Справочники.ВнешниеСистемы.МинФин);
	
	ДатаМетодики2026 = '20260101';
	
	Если ЭтотОбъект.Дата < ДатаМетодики2026 Тогда
		ТаблицаPD = ПолучитьТаблицуPD("СНГШкалаPD");
	Иначе
		ТаблицаPD = ПолучитьТаблицуPD("СНГШкалаPD2026");
	КонецЕсли;	
	
	ПараметрыАктивовПоАС = ПолучитьНастройкиРасчетаРезервовАктивовПоАСПоУмолчанию();
	ПараметрыАктивовПоАС.ТолькоПоступившиеАктивы = ТолькоПоступившиеАктивы;
	ПараметрыАктивовПоАС.ВключаяОФЗ 			 = Истина;
	ПараметрыАктивовПоАС.НеобходимоЗакрыватьБанковскиеБрокерскиеБиржевыеСчета = (РаботаСДокументами.СледующийРабочийДень(НачалоМесяца(ЭтотОбъект.Дата)-1) = НачалоДня(ЭтотОбъект.Дата)
		ИЛИ ВосстанавливатьРезервПоРасчетнымБрокерскимИКлиринговымСчетам());
	
	АктивыПоАС = ПолучитьАктивыПоАС(ТаблицаPD, ПараметрыАктивовПоАС, НастройкиУчета, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	МассивСделокРЕПО = Новый Массив;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			МассивСделокРЕПО.Добавить(СтрокаАктивы.ЦеннаяБумага);	
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаСделокРЕПО = ПолучитьСправедливуюСтоимостьБумагРЕПОИСуммуПервойЧасти(МассивСделокРЕПО);
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаАктивы Из АктивыПоАС Цикл
		
		ЭтоГосБумага = Ложь;
		ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО = Ложь;
		
		Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
			
			//П.7.1. методики: «Из доступных рейтингов российских агентств выбирается наилучший. 
			//П.7.2: При отсутствии рейтинга российских рейтинговых агентств применяется значение PD, соответствующее рейтингу С.»			
			Если ЭтотОбъект.Дата < ДатаМетодики2026 Тогда
				СтрокаАктивы.PD	= 32.09;
			Иначе
				СтрокаАктивы.PD	= 54.94;
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда

			ОтборПоСделкамРЕПО = Новый Структура();
			ОтборПоСделкамРЕПО.Вставить("ЦеннаяБумага", СтрокаАктивы.ЦеннаяБумага);
			СтрокиТаблицаСделокРЕПО = ТаблицаСделокРЕПО.НайтиСтроки(ОтборПоСделкамРЕПО);
			Если СтрокиТаблицаСделокРЕПО.Количество() > 0 Тогда
				Для Каждого СтрокаТаблицыСделокРЕПО Из СтрокиТаблицаСделокРЕПО Цикл
					Если СтрокаТаблицыСделокРЕПО.СправедливаяСтоимостьЦБ >=	СтрокаТаблицыСделокРЕПО.СтоимостьПервойЧастиРЕПО Тогда
						ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО = Истина;	
					КонецЕсли;
				КонецЦикла;
			Иначе
				ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО = Истина;	
			КонецЕсли;
		КонецЕсли;
		
		// разберемся с LGD. Пункт 8 Таблица № 1
		Если ЭтоРЕПОиССБольшеЧемСтоимостьПервойЧастиРЕПО Тогда
			СтрокаАктивы.LGD = 0;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО")
			И СтрокаАктивы.ЦеннаяБумага.СделкаСЦентральнымКонтрагентом Тогда
			СтрокаАктивы.LGD = 0.4;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И (СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная
				ИЛИ СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Субфедеральная) Тогда
			СтрокаАктивы.LGD = 0.15;
			Если ЭтотОбъект.Дата < ДатаМетодики2026 Тогда
				СтрокаАктивы.PD = 0.13;
			Иначе
				СтрокаАктивы.PD = 0.05;
			КонецЕсли;	
			СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
			ЭтоГосБумага = Истина;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			И СтрокаАктивы.ЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
			СтрокаАктивы.LGD = 0.25;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") 
			И СтрокаАктивы.ЦеннаяБумага.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
			СтрокаАктивы.LGD = 0.4;
		ИначеЕсли СтрокаАктивы.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ") Тогда
			СтрокаАктивы.LGD = 0.4;
		ИначеЕсли СистемноЗначимыеКредитныеОрганизации.Найти(СтрокаАктивы.Эмитент) <> Неопределено Тогда
			СтрокаАктивы.LGD = 0.4;
		ИначеЕсли ФинасовыеОрганизации.Найти(СтрокаАктивы.Эмитент) <> Неопределено Тогда
			СтрокаАктивы.LGD = 1;
		ИначеЕсли КорпоративныеЭмитентыСУчастиемГосударстваБолее25Процентов.Найти(СтрокаАктивы.Эмитент) <> Неопределено Тогда
			СтрокаАктивы.LGD = 0.4;
		Иначе
			СтрокаАктивы.LGD = 0.9;
		КонецЕсли;
		
		Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении // для целей СЧА добавление этих строк будет ниже
			И КонецМесяца(ЭтотОбъект.Дата) <> КонецДня(ЭтотОбъект.Дата) И НачалоДня(ЭтотОбъект.Дата) > '20250101' Тогда
			//2.4	Расчетные, брокерские и клиринговые счета выделяются в отдельный сегмент.
			//По данным сегментам резерв создается ежемесячно, на последний календарный день месяца
			Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.БанковскиеСчета") Или
				ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Биржи") Или
				СтрокаАктивы.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
				
				Продолжить;
				
			КонецЕсли;	
		КонецЕсли;	
		
		СтрокаРасчетРезервов = РасчетРезервов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаАктивы);
		
		СтрокаРасчетРезервов.Актив = СтрокаАктивы.ЦеннаяБумага;
		СтрокаРасчетРезервов.Лицо = СтрокаАктивы.Эмитент;
		
		СтрокаРасчетРезервов.EAD = СтрокаАктивы.БалансоваяСтоимость;
		СтрокаРасчетРезервов.PDНач = СтрокаРасчетРезервов.PD;
		СтрокаРасчетРезервов.LGDНач = СтрокаРасчетРезервов.LGD;

		СтрокаРасчетРезервов.PD = СтрокаРасчетРезервов.PD / 100; // он в %
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.ПустаяСсылка()  					// только поступивший актив проверим на POCI
			И (БумагиИЭмитентыВДефолте.БумагиБольше90.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено					// есть дефолт больше 90 дней по активу
				ИЛИ ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено	// или была реструктуризация по активу
				ИЛИ (АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено							// или дефолтный рейтинг и у эмитента и у бумаги
					И АктивыСДефолтнымРейтингом.Найти(СтрокаАктивы.Эмитент) <> Неопределено))
			Тогда
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.POCI;
		
		КонецЕсли;

		// подготовим массивы дефолтов для проверки
		Если ФинасовыеОрганизации.Найти(СтрокаАктивы.Эмитент) = Неопределено Тогда // нефинансовая организация
			ЭмитентыВДефолтеДляПроверкиСтадии3 = БумагиИЭмитентыВДефолте.ЭмитентыБольше90;
			ЭмитентыВДефолтеДляПроверкиСтадии2 = БумагиИЭмитентыВДефолте.Эмитенты90;
			БумагиВДефолтеДляПроверкиСтадии3 = БумагиИЭмитентыВДефолте.БумагиБольше90;
			БумагиВДефолтеДляПроверкиСтадии2 = БумагиИЭмитентыВДефолте.Бумаги90;
			ЭтоФинансоваяОрганизация = Ложь;
		Иначе // для финансовых жестче
			ЭмитентыВДефолтеДляПроверкиСтадии3 = БумагиИЭмитентыВДефолте.Эмитенты90;
			ЭмитентыВДефолтеДляПроверкиСтадии2 = БумагиИЭмитентыВДефолте.Эмитенты30;
			БумагиВДефолтеДляПроверкиСтадии3 = БумагиИЭмитентыВДефолте.Бумаги90;
			БумагиВДефолтеДляПроверкиСтадии2 = БумагиИЭмитентыВДефолте.Бумаги30;
			ЭтоФинансоваяОрганизация = Истина;
		КонецЕсли;
		
		Если СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.POCI Тогда 
			// ничего: POCI - это навсегда и выхода из этой стадии не предусмотрено
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия1.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда // потом проверим профсуждения
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ПрофсужденияПоСтадиямОбесценения.Стадия3.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено Тогда
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Профсуждение = Истина;
		ИначеЕсли ЭтоГосБумага Тогда	// ГосЦБ всегда ААА
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
		// затем проверим на стадию 3 как на саму сильную:
		// 1. рейтинг д
		// 2. дефолт длится до 90 у финов и более 90 у нефинов
		// 3. есть реструктуризация, но если стадия уже была 3 и с реструктуризации прошло 6 месяцев и по этой бумаге нет дефолта более 90 дней, то стадия 1 или 2
		ИначеЕсли СтрокаАктивы.СтрокаСопоставления = 4 Тогда												// 1. рейтинг д
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.РейтингДефолт = Истина;
		ИначеЕсли БумагиВДефолтеДляПроверкиСтадии2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено 		// 2. дефолт длится до 90 у финов и более 90 у нефинов
				ИЛИ ЭмитентыВДефолтеДляПроверкиСтадии3.Найти(СтрокаАктивы.Эмитент) <> Неопределено Тогда	// проверяем и бумагу и эмитента
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.ДлительностьДефолта = "от 30 у финов и более 90 у нефинов";
		ИначеЕсли (ДанныеРеструктуризаций.БумагиСРеструктуризацией.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено  					// 3. есть реструктуризация
				ИЛИ ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией.Найти(СтрокаАктивы.Эмитент) <> Неопределено)						// по бумаге или эмитенту
			И НЕ (СтрокаАктивы.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3												// но если стадия уже была 3
					И (ДанныеРеструктуризаций.БумагиСРеструктуризацией6месяцевНазад.Найти(СтрокаАктивы.ЦеннаяБумага) = Неопределено		// и с реструктуризации прошло 6 месяцев (6 месяцев назад ее не было)
						ИЛИ ДанныеРеструктуризаций.ЭмитентыСРеструктуризацией6месяцевНазад.Найти(СтрокаАктивы.Эмитент) = Неопределено)	// реструктуризация по эмитенту и дефолту
					И БумагиИЭмитентыВДефолте.БумагиБольше90.Найти(СтрокаАктивы.ЦеннаяБумага) = Неопределено ) Тогда  					// и по этой бумаге нет дефолта более 90 дней , то стадия 1 или 2 (проверяем дальше)
			
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3;
			СтрокаРасчетРезервов.Реструктуризация = Истина;
		// и в конце проверим на стадию 2:
		// 1. дефолт длится до 30 у финов и до 90 у нефинов
		// 2. падение рейтинга на 2 ступени с момента ПП
		ИначеЕсли БумагиВДефолтеДляПроверкиСтадии2.Найти(СтрокаАктивы.ЦеннаяБумага) <> Неопределено  // 1. дефолт длится до 30 у финов и до 90 у нефинов
			ИЛИ ЭмитентыВДефолтеДляПроверкиСтадии2.Найти(СтрокаАктивы.Эмитент) <> Неопределено Тогда // проверяем и бумагу и эмитента
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
			СтрокаРасчетРезервов.ДлительностьДефолта = "до 30 у финов и до 90 у нефинов";
		Иначе

			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			ДатаПП = СтрокаАктивы.ДатаПервоначальногоПризнания; 
			
			Если ДатаПП <> Неопределено И СтрокаАктивы.УровеньРейтинга <> 100 Тогда
				ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату = ПолучитьНастройкиДляУровеньРейтингаАктиваНаДату();
				УровеньРейтингаПП = ПолучитьУровеньРейтингаАктиваНаДату(ДатаПП, СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляУровеньРейтингаАктиваНаДату);
				Если УровеньРейтингаПП <> 0 И СтрокаАктивы.УровеньРейтинга - УровеньРейтингаПП >= 2 Тогда 
					СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2;
					СтрокаРасчетРезервов.ПадениеРейтингаНа2Стадии = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
		Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
				СтрокаРасчетРезервов.PD = СтрокаПрофсужденияПоPDLGD.PD;
			КонецЕсли;	
			Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
				СтрокаРасчетРезервов.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
			КонецЕсли;	
			СтрокаРасчетРезервов.Профсуждение = Истина;
		КонецЕсли;	
		
		Если ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
				НастройкиУчета,
				СтрокаАктивы.ЦеннаяБумага,
				СтрокаАктивы.УчетныйАктивЕПС,
				СтрокаАктивы.Партия,
				СтрокаАктивы.СтрокаПартии);
			Если НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
				ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаПогашения;
			Иначе
				ДатаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата, , ЭтотОбъект.СчетДоверительногоУправления,
					НастройкиУчетаЦеннойБумаги.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчетаЦеннойБумаги.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
			КонецЕсли;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			ДатаВыкупа = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(СтрокаАктивы.ЦеннаяБумага, ЭтотОбъект.Дата);
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВозврата;
		ИначеЕсли ТипЗнч(СтрокаАктивы.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			ДатаВыкупа = СтрокаАктивы.ЦеннаяБумага.ДатаВторойЧастиРЕПО;
		Иначе
			ДатаВыкупа = НачалоДня(ЭтотОбъект.Дата) + 60 * 60 * 24;
		КонецЕсли;
		
		ДнейДоПогашения = Макс((НачалоДня(ДатаВыкупа) - НачалоДня(ЭтотОбъект.Дата)) / (60 * 60 * 24), 0);
		
		СтрокаРасчетРезервов.ДнейДоПогашения = ДнейДоПогашения;
		СтрокаРасчетРезервов.ДатаПогашения = ДатаВыкупа; 
		
		Если СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.POCI Тогда
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеДепозитыОбесцененныеПриПризнании;
			СтрокаРасчетРезервов.PD = 1;
			СтрокаРасчетРезервов.LGD = 1;
			СтрокаРасчетРезервов.macro = 1;
			СтрокаРасчетРезервов.Формула = "ECL = EAD * PD * LGD * macro";
			
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1 Тогда
			
			Если ДнейДоПогашения >= 365 Тогда
				// ничего не делаем PD остается тем же
			ИначеЕсли ДнейДоПогашения <= 30 Тогда
				СтрокаРасчетРезервов.PD = 1 - Pow(1 - СтрокаРасчетРезервов.PD, 1 / 12);
			Иначе
				СтрокаРасчетРезервов.PD = 1 - Pow(1 - СтрокаРасчетРезервов.PD, ДнейДоПогашения / 365);
			КонецЕсли;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			
			СтрокаРасчетРезервов.macro = ОпределитьМакроПрогноз(СтрокаАктивы.ПрогнозРейтинга, ТаблицаPD, СтрокаРасчетРезервов.PD);
			СтрокаРасчетРезервов.Формула = "ECL = EAD * PD_cmlt * LGD * macro";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия2 Тогда
			
			СтрокаРасчетРезервов.PD = 1 - Pow(1 - СтрокаРасчетРезервов.PD, Макс(1, ДнейДоПогашения / 365));
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиУбыткиВесьСрокУвеличилсяРискНеобесцененные;

			СтрокаРасчетРезервов.macro = ОпределитьМакроПрогноз(СтрокаАктивы.ПрогнозРейтинга, ТаблицаPD, СтрокаАктивы.PD);
			СтрокаРасчетРезервов.Формула = "ECL = EAD * Lifetime PD * LGD * macro";
			
		ИначеЕсли СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия3 Тогда
			СтрокаРасчетРезервов.PD = 1; // PDdef – вероятность дефолта, равная 100%
			
			ДатыПереходаАктиваНаТретьюСтадию = ПолучитьДатуПереходаАктиваНаТретьюСтадию(СтрокаАктивы.ЦеннаяБумага);
			СрокНахожденияВТретьейСтадии = (НачалоДня(ЭтотОбъект.Дата) - ДатыПереходаАктиваНаТретьюСтадию) / 365;
			
			СтрокаРасчетРезервов.LGD = СтрокаРасчетРезервов.LGD / (1 - (1 - СтрокаРасчетРезервов.LGD) * (1 - exp(-СрокНахожденияВТретьейСтадии/2)));
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеБумагиОбесцененныеНеобеспеченныеПриПризнании;
			
			СтрокаРасчетРезервов.macro = 1;
			
			СтрокаРасчетРезервов.Формула = "ECL = PDdef * EAD * LGDdef";
			
			
		КонецЕсли;
		
		//сноска 1 на странице 8: PDcmlt рассчитывается с точностью до 15 знаков после запятой
		// т.к. PD в процентах то значит что ставим что до 17	
		СтрокаРасчетРезервов.PD = Окр(СтрокаРасчетРезервов.PD, 17);
		
		СтрокаРасчетРезервов.КоэффициентРезерва = СтрокаРасчетРезервов.PD;
		
		СтрокаРасчетРезервов.СуммаРезерваПартии = СтрокаРасчетРезервов.EAD * СтрокаРасчетРезервов.PD * СтрокаРасчетРезервов.LGD * СтрокаРасчетРезервов.macro;
		
		СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент);
		
		Если СтрокаРасчетРезервов.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаРасчетРезервов.СуммаРезерваПартии = Окр(СтрокаРасчетРезервов.СуммаРезерваПартии, 2);	
		КонецЕсли;	
		
	КонецЦикла;
	
	// А в первый рабочий день месяца согласно пункту 2.4 методики необходимо резервы по р/с, брокерским счетам и клиринговым счетам неоходимо списать.
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении // берем из регистра резервов только для целей СЧА
		И (РаботаСДокументами.СледующийРабочийДень(НачалоМесяца(ЭтотОбъект.Дата) - 1) = НачалоДня(ЭтотОбъект.Дата)
		ИЛИ ВосстанавливатьРезервПоРасчетнымБрокерскимИКлиринговымСчетам()) Тогда
		
		НастройкиУчетаДепозитныеВкладыПоАС = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		НастройкиУчетаДенежныеСредстваНаРасчетномСчете = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДенежныеСредстваНаРасчетномСчете, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		НастройкиУчетаДенежныеСредстваУБрокера = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ДенежныеСредстваУБрокера, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		НастройкиУчетаПроцентыНаМНО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		НастройкиУчетаПроцентыПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивыЕПС.ПроцентыПоРЕПО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.БрокерскиеКомпании).ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.Биржи)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.Биржи).ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Документ.МНО).РасчетныйСчет.Банк.ЮрФизЛицо
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Документ.СделкаРЕПО)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Документ.СделкаРЕПО).Контрагент
		|		КОГДА ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады)
		|			ТОГДА ВЫРАЗИТЬ(РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Эмитент,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
		|	НЕОПРЕДЕЛЕНО КАК Партия,
		|	0 КАК СтрокаПартии,
		|	0 КАК Количество,
		|	0 КАК Стоимость,
		|	0 КАК ОценочныеДисконтПремия,
		|	0 КАК ОценочнаяКорректировкаЭСП,
		|	0 КАК ОценочнаяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК ОценочнаяСуммаКупона,
		|	0 КАК СуммаРезервовПодОбесценение,
		|	0 КАК ЗадолженностьПоПогашениюКупонаВВалютеУчета,
		|	0 КАК ЗадолженностьПоПогашениюТелаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И НЕ(&ПропускатьМНО
		|						И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Документ.МНО))
		|				И НЕ(&ПропускатьДепозит
		|						И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады))
		|				И НЕ(&ПропускатьДенежныеСредстваУБрокера
		|						И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании))
		|				И НЕ(&ПропускатьДенежныеСредстваНаРасчетномСчете
		|						И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Справочник.Биржи))
		|				И НЕ(&ПропускатьДенежныеСредстваНаРасчетномСчете
		|						И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Справочник.БанковскиеСчета))) КАК РезервыПредстоящихРасходовОстатки
		|ГДЕ
		|	(ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
		|			ИЛИ ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.Биржи)
		|			ИЛИ ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании))
		|	И ТИПЗНАЧЕНИЯ(РезервыПредстоящихРасходовОстатки.СубъектАналитики) <> ТИП(Справочник.Облигации)";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ПропускатьМНО", Не НастройкиУчетаПроцентыНаМНО.СписыватьРезервОКУНаДатуПрекращенияПризнания И ТолькоПоступившиеАктивы);
		Запрос.УстановитьПараметр("ПропускатьДепозит", Не НастройкиУчетаДепозитныеВкладыПоАС.СписыватьРезервОКУНаДатуПрекращенияПризнания И ТолькоПоступившиеАктивы);
		Запрос.УстановитьПараметр("ПропускатьДенежныеСредстваУБрокера", Не НастройкиУчетаДенежныеСредстваУБрокера.СписыватьРезервОКУНаДатуПрекращенияПризнания И ТолькоПоступившиеАктивы);
		Запрос.УстановитьПараметр("ПропускатьДенежныеСредстваНаРасчетномСчете", Не НастройкиУчетаДенежныеСредстваНаРасчетномСчете.СписыватьРезервОКУНаДатуПрекращенияПризнания И ТолькоПоступившиеАктивы);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтрокаРасчетРезервов = РасчетРезервов.Добавить();
			
			СтрокаРасчетРезервов.Актив = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			СтрокаРасчетРезервов.Лицо = ВыборкаДетальныеЗаписи.Эмитент;
			
			СтрокаРасчетРезервов.АналитикаРезерва = Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			СтрокаРасчетРезервов.СтадияОбесценения = Перечисления.СтадииОбесценения.Стадия1;
			
			Если СтрокаРасчетРезервов.Лицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПАО_ММВБ") Тогда
				СтрокаРасчетРезервов.Лицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
			КонецЕсли;
			
			СтрокаРасчетРезервов.ВидРезерва = ПолучитьПредставлениеВидаРезерва(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Эмитент);
			
		КонецЦикла;
	КонецЕсли;
	
	ОтсортироватьРасчетРезервов(РасчетРезервов);
	
	Если ДанныеРасчета = Неопределено Тогда // вызывали для заполнения, не для расшифровки
		ЭтотОбъект.Партии.Загрузить(РасчетРезервов);
	КонецЕсли;
	
	ДанныеРасчета = РасчетРезервов;

КонецПроцедуры

Функция ОпределитьМакроПрогноз(ПрогнозРейтинга, ТаблицаPD, PD)

	Нотч = 0;
	Если ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Позитивный Тогда
		Нотч = -1;
	ИначеЕсли ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Позитивный Тогда
		Нотч = +1;
	КонецЕсли;
	
	Если Нотч = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаPD.Количество();
	
	Для Инд = 0 По КоличествоСтрок - 1 Цикл
		
		Если ТаблицаPD[Инд].PD = PD Тогда // нашли наш рейтинг
			
			НомерСтрокиПрогноза = Инд + Нотч; 
			
			Если НомерСтрокиПрогноза < 0 ИЛИ НомерСтрокиПрогноза > КоличествоСтрок - 1 Тогда // ха-ха: рейтинг ААА и прогноз положительный или рейтинг Д и прогноз негативный
				Возврат 1;
			КонецЕсли;
			
			СтрокаПрогноз = ТаблицаPD[НомерСтрокиПрогноза];
			
			Возврат СтрокаПрогноз.PD / PD;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат 1;

КонецФункции

Функция ПолучитьДатуПереходаАктиваНаТретьюСтадию(Актив)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтадииОбесцененияАктивов.Период КАК Период,
		|	СтадииОбесцененияАктивов.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _ВсеСтадии
		|ИЗ
		|	РегистрСведений.СтадииОбесцененияАктивов КАК СтадииОбесцененияАктивов
		|ГДЕ
		|	СтадииОбесцененияАктивов.Организация = &Организация
		|	И СтадииОбесцененияАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтадииОбесцененияАктивов.Актив = &Актив
		|	И СтадииОбесцененияАктивов.Период < &День
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_ВсеСтадии.Период) КАК Период,
		|	_ВсеСтадии1.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _ВсеТретьиСтадии
		|ИЗ
		|	_ВсеСтадии КАК _ВсеСтадии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеСтадии КАК _ВсеСтадии1
		|		ПО _ВсеСтадии.Период < _ВсеСтадии1.Период
		|			И (_ВсеСтадии.СтадияОбесценения = ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия3))
		|			И (_ВсеСтадии1.СтадияОбесценения <> ЗНАЧЕНИЕ(Перечисление.СтадииОбесценения.Стадия3))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеСтадии1.СтадияОбесценения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_ВсеТретьиСтадии.Период) КАК Период
		|ИЗ
		|	_ВсеТретьиСтадии КАК _ВсеТретьиСтадии
		|ГДЕ
		|	_ВсеТретьиСтадии.СтадияОбесценения ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Актив", Актив);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Период = NULL Тогда
			Возврат НачалоДня(ЭтотОбъект.Дата);
		Иначе
			Возврат ВыборкаДетальныеЗаписи.Период;
		КонецЕсли;
	Иначе
		Возврат НачалоДня(ЭтотОбъект.Дата);
	КонецЕсли;

КонецФункции

#КонецОбласти

