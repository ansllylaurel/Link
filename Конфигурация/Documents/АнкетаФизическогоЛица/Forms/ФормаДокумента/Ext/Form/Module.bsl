&НаКлиенте
Процедура ВидУчастникаПриИзменении(Элемент)
	
	НомерУчастникаСтрокой = СтрЗаменить(Элемент.Имя, "ВидУчастника", "");
	НомерУчастникаЧислом  = Число(НомерУчастникаСтрокой);
	
	УстановитьВидимостьРеквизитовУчастников(Элементы, Объект.ПредставителиВыгодоприобретатели[НомерУчастникаЧислом].ВидУчастника, НомерУчастникаСтрокой);
	
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	
КонецПроцедуры

&НаКлиенте
Процедура ЮрФизЛицоУчастникаПриИзменении(Элемент)
	
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьАнкетуУчастника(Элемент)
	
	НомерУчастникаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияПечать") + 1);
	НомерУчастникаЧисло  = Число(НомерУчастникаСтрока);
	
	СтрокаТабЧасти = Объект.ПредставителиВыгодоприобретатели[НомерУчастникаЧисло];
	
	ОткрытьФорму("Обработка.ПечатьАнкетныхДанных.Форма.Форма", Новый Структура("ЮрФизЛицо, ВариантАнкеты, ОснованиеПолномочий", СтрокаТабЧасти.ЮрФизЛицо, СтрокаТабЧасти.ВидУчастника, СтрокаТабЧасти.ОснованиеПолномочий), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РезидентРФПриИзменении(Элемент)
	
	Если Объект.РезидентРФ Тогда
		Объект.НалоговыйРезидентИностранногоГосударства				= Ложь;
		Объект.НалоговыйРезидентИностранногоГосударстваГосударство	= Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НалоговыйРезидентИностранногоГосударстваПриИзменении(Элемент)
	
	Если Объект.НалоговыйРезидентИностранногоГосударства Тогда
		Объект.РезидентРФ = Ложь;
	Иначе
		Объект.НалоговыйРезидентИностранногоГосударстваГосударство = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИностранныйНалогоплательщикПриИзменении(Элемент)
	
	Если НЕ Объект.ИностранныйНалогоплательщик Тогда
		Объект.ИностранныйНалогоплательщикГосударство	= Неопределено;
		Объект.ИностранныйНалогоплательщикОснования		= Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

