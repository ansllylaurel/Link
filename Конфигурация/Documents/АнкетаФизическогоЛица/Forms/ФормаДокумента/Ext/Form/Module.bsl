	Возврат Справочники.БанковскиеСчета.ПолучитьВалютуПоНомеруСчета(НомерСчета);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСчета(Знач НомерСчета, Знач БИК, Знач Организация, Период)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
	|	БанковскиеСчета.Банк.Наименование КАК НаименованиеБанка,
	|	БанковскиеСчета.Ссылка КАК РасчетныйСчет,
	| 	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННПолучателя
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО БанковскиеСчета.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|ГДЕ
	|	БанковскиеСчета.Организация = &Организация
	|	И БанковскиеСчета.НомерСчета = &НомерСчета
	|	И &Код В(БанковскиеСчета.Банк.Код, """")");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчета",  НомерСчета);
	Запрос.УстановитьПараметр("Код",         БИК);
	Запрос.УстановитьПараметр("Период",      Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		РеквизитыСчета = Новый Структура("БИК,КоррСчет,НаименованиеБанка,Валюта,РасчетныйСчет,ИННПолучателя");
		ЗаполнитьЗначенияСвойств(РеквизитыСчета, Выборка);
		
		Возврат РеквизитыСчета;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура НомерСчетаПриИзменении(Элемент)
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("НомерСчета") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	Если Не ПустаяСтрока(ТекущиеДанные.НомерСчета) Тогда
		
		РеквизитыСчета = ПолучитьРеквизитыСчета(ТекущиеДанные.НомерСчета, ТекущиеДанные.БИК, Объект.Организация, Объект.Дата);
		
		Если РеквизитыСчета <> Неопределено Тогда
			
			Если ТекущиеДанные.СозданДокументом Тогда
				ИсключаемыеСвойства = "РасчетныйСчет";
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыСчета,, ИсключаемыеСвойства);
			
		Иначе
			
			Если Не ТекущиеДанные.СозданДокументом Тогда
				ТекущиеДанные.РасчетныйСчет = Неопределено;
			КонецЕсли;
			
			Валюта = ПолучитьВалютуПоНомеруСчета(ТекущиеДанные.НомерСчета);
			
			Если СтрДлина(ТекущиеДанные.НомерСчета) >= 20 и Не ЗначениеЗаполнено(Валюта) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена валюта с кодом " + Сред(ТекущиеДанные.НомерСчета, 6, 3), Объект.Ссылка, "Объект.БанковскиеРеквизиты[" + НомерСтрокиСтрока + "].НомерСчета");	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("НомерСчета") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	Если СистемныеФункции.СсылкаСуществует(ТекущиеДанные.РасчетныйСчет) Тогда
		ОткрытьФорму("Справочник.БанковскиеСчета.ФормаОбъекта", Новый Структура("Ключ", ТекущиеДанные.РасчетныйСчет), Элемент);
	Иначе
		ПоказатьПредупреждение(,"Банковский счет не создан");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьБанковскийСчет(Команда)

	НоваяСтрока = Объект.БанковскиеРеквизиты.Добавить();
	
	НоваяСтрока.ПолучательПлатежа = ПолучитьФИО(Объект);
		
	РазместитьБанковскийСчетНаСервере(НоваяСтрока.НомерСтроки - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьБанковскийСчет(Элемент)
	
	Модифицированность = Истина;
	
	НомерУчастникаСтрока = Сред(Элемент.Имя, СтрДлина("ДекорацияУдаленияСчета") + 1);
	НомерУчастникаЧисло  = Число(НомерУчастникаСтрока);
	
	УдалитьБанковскийСчетНаСервере();
	
	Объект.БанковскиеРеквизиты.Удалить(НомерУчастникаЧисло);
	
КонецПроцедуры

&НаСервере
Процедура РазместитьБанковскийСчетНаСервере(Знач ИндексЭлемента)
	
	НомерУчастникаСтрока = Формат(ИндексЭлемента, "ЧН=0; ЧГ=0");
	
	НоваяГруппа = Элементы.Добавить("ГруппаБанковскийСчет" + НомерУчастникаСтрока, Тип("ГруппаФормы"), Элементы.ГруппаБанковскиеСчета);
	НоваяГруппа.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок            = "Банковский счет";
	НоваяГруппа.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.СквозноеВыравнивание = СквозноеВыравнивание.Использовать;
	НоваяГруппа.ПутьКДаннымЗаголовка = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НомерСчета";
	
	НовыйЭлемент = Элементы.Добавить("ДекорацияУдаленияСчета" + НомерУчастникаСтрока, Тип("ДекорацияФормы"), НоваяГруппа);
	НовыйЭлемент.Подсказка          = "Удалить банковский счет";
	НовыйЭлемент.Вид                = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка           = БиблиотекаКартинок.Удалить;
	НовыйЭлемент.Гиперссылка        = Истина;
	НовыйЭлемент.Доступность        = Не ТолькоПросмотр;
	НовыйЭлемент.ПропускатьПриВводе = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "УдалитьБанковскийСчет");
	
	НоваяПодГруппа = Элементы.Добавить("ГруппаСсылка" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("БИК" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным               = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].БИК";
	НовыйЭлемент.Вид                       = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода            = "БИК";
	НовыйЭлемент.Заголовок                 = "БИК";
	НовыйЭлемент.ПоложениеЗаголовка        = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.РастягиватьПоГоризонтали  = Ложь;
	НовыйЭлемент.Ширина                    = 10;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "БИКПриИзменении");
	
	НовыйЭлемент = Элементы.Добавить("БанковскийСчет" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным				= "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].РасчетныйСчет";
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                  = "Ссылка";
	НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
	НовыйЭлемент.Ширина						= 10;
	НовыйЭлемент.ТолькоПросмотр				= Истина;
	
	НоваяПодГруппа = Элементы.Добавить("ГруппаБанк" + НомерУчастникаСтрока, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяПодГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяПодГруппа.ОтображатьЗаголовок = Ложь;
	НоваяПодГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяПодГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	
	НовыйЭлемент = Элементы.Добавить("НаименованиеБанка" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].НаименованиеБанка";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Наименование банка";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "Банк";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.ПропускатьПриВводе       = Истина;
	НовыйЭлемент.Ширина                   = 30;
	
	НовыйЭлемент = Элементы.Добавить("КоррСчет" + НомерУчастникаСтрока, Тип("ПолеФормы"), НоваяПодГруппа);
	НовыйЭлемент.ПутьКДанным              = "Объект.БанковскиеРеквизиты[" + НомерУчастникаСтрока + "].КоррСчет";
	НовыйЭлемент.Вид                      = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПодсказкаВвода           = "Корреспондентский счет";
	НовыйЭлемент.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок                = "к/с";
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
