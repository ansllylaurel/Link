
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ИндивидуальныйПредприниматель = Не ПустаяСтрока(Объект.ОГРНИП);
	
	НастроитьВидимостьИДоступность(ЭтотОбъект);
	
	ПроверитьКорректностьИНН(ЭтотОбъект);
	ПроверитьКорректностьСНИЛС(ЭтотОбъект);
	ПроверитьКорректностьОГРНИП(ЭтотОбъект);
	
	КоличествоПодчиненных = Элементы.ГруппаУчастники.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаУчастники.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 
		
	Для каждого СтрокаУчастник из Объект.ПредставителиВыгодоприобретатели Цикл
		РазместитьУчастникаНаСервере(СтрокаУчастник.НомерСтроки - 1);
		УстановитьВидимостьРеквизитовУчастников(Элементы, СтрокаУчастник.ВидУчастника, Формат(СтрокаУчастник.НомерСтроки - 1, "ЧН=0; ЧГ="));	
	КонецЦикла;
	
	КоличествоПодчиненных = Элементы.ГруппаБанковскиеСчета.ПодчиненныеЭлементы.Количество();
	Для Сч = 1 По КоличествоПодчиненных Цикл
		Элементы.Удалить(Элементы.ГруппаБанковскиеСчета.ПодчиненныеЭлементы[КоличествоПодчиненных - Сч]);	
	КонецЦикла; 

	Для каждого СтрокаУчастник из Объект.БанковскиеРеквизиты Цикл
		РазместитьБанковскийСчетНаСервере(СтрокаУчастник.НомерСтроки - 1);
	КонецЦикла;
	
	ЭтотОбъект.ТекущееФИО = ПолучитьФИО(Объект);
	ЭтотОбъект.ТекущийИНН = Объект.ИНН;
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ОбоснованиеУровняРиска = ПолучитьСтандартноеОбоснованиеУровняРиска(Объект.ВысокийУровеньРиска);
	КонецЕсли;
	
	ЗаполнитьФИОБенефициарногоВладельцаУстановленногоКомпанией();
	НастроитьОтображениеБенефициарногоВладельцаУстановленногоКомпанией(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ИндивидуальныйПредприниматель Тогда
		Объект.ОГРНИП = "";
		Объект.ДатаВыдачиОГРНИП = "";
		Объект.ОрганВыдавшийОГРНИП = "";
		Объект.АдресОрганаВыдавшегоОГРНИП = "";
		Объект.ВидыДеятельности = "";
		Объект.Лицензии = "";
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ИндивидуальныйПредприниматель Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ОГРНИП) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ОГРНИП", Объект.Ссылка, "ОГРНИП", "Объект", Отказ);	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ДатаВыдачиОГРНИП) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Дата выдачи ОГРНИП", Объект.Ссылка, "ДатаВыдачиОГРНИП", "Объект", Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ОрганВыдавшийОГРНИП) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Орган выдавший ОГРНИП", Объект.Ссылка, "ОрганВыдавшийОГРНИП", "Объект", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстОшибки = "";
	Если НЕ РаботаСКонтактнойИнформациейКлиентСервер.ПроверкаТелефонаДляОповещения(Объект.ТелефонДляОповещения, ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно указан телефон для оповещения: " + ТекстОшибки + " (" + Объект.ТелефонДляОповещения + ")", Объект.Ссылка, "ТелефонДляОповещения", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаФормы

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы		= Форма.Элементы;
	ДанныеОбъекта	= Форма.Объект;
	
	Элементы.НалоговыйРезидентИностранногоГосударстваГосударство.Видимость	= ДанныеОбъекта.НалоговыйРезидентИностранногоГосударства;
	Элементы.ИностранныйНалогоплательщикГосударство.Видимость				= ДанныеОбъекта.ИностранныйНалогоплательщик;
	Элементы.ИностранныйНалогоплательщикОснования.Видимость					= ДанныеОбъекта.ИностранныйНалогоплательщик;
	Элементы.ГруппаДанныеАгента.Видимость									= ДанныеОбъекта.ВидИсточника = ПредопределенноеЗначение("Перечисление.ИсточникиАнкетИЗаявок.Агент");
	
	УстановитьВидимостьОпросников(Форма);
	УстановитьДоступностьРеквизитовИП(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОпросников(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.ЯвляетсяПубличнымДолжностнымЛицомОписание.Видимость = Объект.ЯвляетсяПубличнымДолжностнымЛицом;
	Элементы.ЯвляетсяРодственникомПубличногоДолжностногоЛицаОписание.Видимость = Объект.ЯвляетсяРодственникомПубличногоДолжностногоЛица;
	Элементы.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФОписание.Видимость = Объект.НаличиеСчетаВГосударствахНеВыполняющихРекомендацииФАТФ;
	Элементы.ДеловаяРепутацияОписание.Видимость = Не Объект.ДеловаяРепутацияПоложительная;
	Элементы.ЦельДругоеОписание.Видимость = Объект.ЦельДругое;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитовИП(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.ОГРНИП.Доступность = Форма.ИндивидуальныйПредприниматель;
	Элементы.ДатаВыдачиОГРНИП.Доступность = Форма.ИндивидуальныйПредприниматель;
	Элементы.ОрганВыдавшийОГРНИП.Доступность = Форма.ИндивидуальныйПредприниматель;
	Элементы.АдресОрганаВыдавшегоОГРНИП.Доступность = Форма.ИндивидуальныйПредприниматель;
	Элементы.ВидыДеятельности.Доступность = Форма.ИндивидуальныйПредприниматель;
	Элементы.Лицензии.Доступность = Форма.ИндивидуальныйПредприниматель;
	
	Элементы.ОГРНИП.АвтоОтметкаНезаполненного = Форма.ИндивидуальныйПредприниматель;
	Элементы.ДатаВыдачиОГРНИП.АвтоОтметкаНезаполненного = Форма.ИндивидуальныйПредприниматель;
	Элементы.ОрганВыдавшийОГРНИП.АвтоОтметкаНезаполненного = Форма.ИндивидуальныйПредприниматель;
	Элементы.АдресОрганаВыдавшегоОГРНИП.АвтоОтметкаНезаполненного = Форма.ИндивидуальныйПредприниматель;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовУчастников(Элементы, ВидУчастника, НомерУчастникаСтрока)
	
	Если ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Представитель") Тогда
		ВидимостьРеквизитов = Истина;
	ИначеЕсли ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.Выгодоприобретатель") Тогда
		ВидимостьРеквизитов = Ложь;
	ИначеЕсли ВидУчастника = ПредопределенноеЗначение("Перечисление.ВидыУчастниковАнкет.БенефициарныйВладелец") Тогда
		ВидимостьРеквизитов = Ложь;
	Иначе
		ВидимостьРеквизитов = Ложь;
	КонецЕсли;
		
	Элементы["СтатусПредставителя" + НомерУчастникаСтрока].Видимость = ВидимостьРеквизитов;
	Элементы["ОснованиеПолномочий" + НомерУчастникаСтрока].Видимость = ВидимостьРеквизитов;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьФИО(Объект)
	Возврат Объект.Фамилия + " " + Объект.Имя + ?(ПустаяСтрока(Объект.Отчество), "", " " + Объект.Отчество);
КонецФункции

#КонецОбласти

#Область ПроверкаКорректностиКодов

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКорректностьИНН(Форма, Сообщать = Ложь)
	
	ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьИННФизЛица(Форма.Объект.ИНН);
	ОбработатьРезультатПроверки(Форма, "ИНН", ТекстСообщения, Сообщать);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКорректностьСНИЛС(Форма, Сообщать = Ложь)
	
	ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьСНИЛС(Форма.Объект.СНИЛС);
	ОбработатьРезультатПроверки(Форма, "СНИЛС", ТекстСообщения, Сообщать);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКорректностьОГРНИП(Форма, Сообщать = Ложь)
	
	ТекстСообщения = РаботаСКодамиКлиентСервер.ПроверитьОГРНИП(Форма.Объект.ОГРНИП);
	ОбработатьРезультатПроверки(Форма, "ОГРНИП", ТекстСообщения, Сообщать);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьРезультатПроверки(Форма, Поле, ТекстСообщения, Сообщать)
	
	ПолеКорректен = Поле + "Корректен";
	
	Форма[ПолеКорректен] = Не ЗначениеЗаполнено(ТекстСообщения);
	Если Форма[ПолеКорректен] Тогда
		Форма.Элементы[Поле].Подсказка = "";	
	Иначе
		Форма.Элементы[Поле].Подсказка = ТекстСообщения;
	КонецЕсли;
	
	Если Не Форма[ПолеКорректен] и Сообщать Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Форма.Объект.Ссылка, Поле, "Объект");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийШапки

&НаКлиенте
Процедура ИсточникАнкетыПриИзменении(Элемент)
	
	Если Объект.ВидИсточника = ПредопределенноеЗначение("Перечисление.ИсточникиАнкетИЗаявок.Офис")
		Или Объект.ВидИсточника = ПредопределенноеЗначение("Перечисление.ИсточникиАнкетИЗаявок.Агент") Тогда
		Объект.УпрощеннаяИдентификация = Ложь;
	ИначеЕсли Объект.ВидИсточника = ПредопределенноеЗначение("Перечисление.ИсточникиАнкетИЗаявок.Сайт") Тогда
		Объект.УпрощеннаяИдентификация = Истина;
	КонецЕсли;
	
	Если Объект.ВидИсточника <> ПредопределенноеЗначение("Перечисление.ИсточникиАнкетИЗаявок.Агент") Тогда
		Объект.ФИОАгента		= "";
		Объект.ДолжностьАгента	= "";
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийОсновные

&НаКлиенте
Процедура ИННПриИзменении(Элемент)
	
	ПроверитьКорректностьИНН(ЭтотОбъект, Истина);
	
	Для каждого СтрокаТабЧасти из Объект.БанковскиеРеквизиты Цикл
		Если СтрокаТабЧасти.ИННПолучателя = ТекущийИНН Тогда
			СтрокаТабЧасти.ИННПолучателя = Объект.ИНН;	
		КонецЕсли;
	КонецЦикла;
	
	ЭтотОбъект.ТекущийИНН = Объект.ИНН;

КонецПроцедуры

&НаКлиенте
Процедура СНИЛСПриИзменении(Элемент)
	ПроверитьКорректностьСНИЛС(ЭтотОбъект, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ФамилияПриИзменении(Элемент)
	
	Объект.Фамилия = СокрЛП(Объект.Фамилия);
	ОбновитьПолучателяПлатежа();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяПриИзменении(Элемент)
	
	Объект.Имя = СокрЛП(Объект.Имя);
	ОбновитьПолучателяПлатежа();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчествоПриИзменении(Элемент)
	
	Объект.Отчество = СокрЛП(Объект.Отчество);
	ОбновитьПолучателяПлатежа();
	
КонецПроцедуры

&НаКлиенте
Процедура МестоРожденияПриИзменении(Элемент)
	
	Объект.МестоРождения = СокрЛП(Объект.МестоРождения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолучателяПлатежа()

	НовоеФИО = ПолучитьФИО(Объект);
	
	Для каждого СтрокаТабЧасти из Объект.БанковскиеРеквизиты Цикл
		СтрокаТабЧасти.ПолучательПлатежа = СтрЗаменить(СтрокаТабЧасти.ПолучательПлатежа, ТекущееФИО, НовоеФИО);
	КонецЦикла;
	
	ТекущееФИО = НовоеФИО;

КонецПроцедуры

&НаКлиенте
Процедура ГражданствоПриИзменении(Элемент)
	
	Объект.РезидентРФ = (Объект.Гражданство = ПредопределенноеЗначение("Справочник.СтраныМира.Россия"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДокументы

&НаКлиенте
Процедура СерияУдостоверенияЛичностиПриИзменении(Элемент)
	
	Если Объект.ВидУдостоверенияЛичности = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ") Тогда
		Объект.СерияУдостоверенияЛичности = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Объект.СерияУдостоверенияЛичности);
	Иначе
		Объект.СерияУдостоверенияЛичности = СокрЛП(Объект.СерияУдостоверенияЛичности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерУдостоверенияЛичностиПриИзменении(Элемент)
	
	Если Объект.ВидУдостоверенияЛичности = ПредопределенноеЗначение("Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ") Тогда
		Объект.НомерУдостоверенияЛичности = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Объект.НомерУдостоверенияЛичности);
	Иначе
		Объект.НомерУдостоверенияЛичности = СокрЛП(Объект.НомерУдостоверенияЛичности);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганВыдавшийУдостоверениеЛичностиПриИзменении(Элемент)
	
	Объект.ОрганВыдавшийУдостоверениеЛичности = СокрЛП(Объект.ОрганВыдавшийУдостоверениеЛичности);
	
КонецПроцедуры

&НаКлиенте
Процедура КодОрганаВыдавшегоУдостоверениеЛичностиПриИзменении(Элемент)
	
	Объект.КодОрганаВыдавшегоУдостоверениеЛичности = СокрЛП(Объект.КодОрганаВыдавшегоУдостоверениеЛичности);

КонецПроцедуры

&НаКлиенте
Процедура ИндивидуальныйПредпринимательПриИзменении(Элемент)
	
	УстановитьДоступностьРеквизитовИП(ЭтотОбъект);
	
КонецПроцедуры

