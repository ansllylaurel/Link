#Область ОбработчикиСобытийБанковскиеРеквизиты

&НаСервереБезКонтекста
Функция ПолучитьБанковскиеРеквизиты(БИК, Период)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Банки.Ссылка КАК Банк,
	|	ЕСТЬNULL(РеквизитыБанковСрезПоследних.Наименование, Банки.Наименование) КАК НаименованиеБанка,
	|	ЕСТЬNULL(РеквизитыБанковСрезПоследних.КоррСчет, Банки.КоррСчет) КАК КоррСчет,
	|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННПолучателя
	|ИЗ
	|	Справочник.Банки КАК Банки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыБанков.СрезПоследних(&Период, ) КАК РеквизитыБанковСрезПоследних
	|		ПО (РеквизитыБанковСрезПоследних.Банк = Банки.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО Банки.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|ГДЕ
	|	Банки.Код = &Код
	|	И Банки.ЭтоГруппа = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Код", БИК);
	
	Результат = Новый Структура("Банк, НаименованиеБанка, КоррСчет, ИННПолучателя");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура БИКПриИзменении(Элемент)
	
	НомерСтрокиСтрока = Сред(Элемент.Имя, СтрДлина("БИК") + 1);
	НомерСтрокиЧисло  = Число(НомерСтрокиСтрока);

	ТекущиеДанные = Объект.БанковскиеРеквизиты[НомерСтрокиЧисло];
	
	БанковскиеРеквизиты = ПолучитьБанковскиеРеквизиты(ТекущиеДанные.БИК, Объект.Дата);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, БанковскиеРеквизиты);
	
	Если Не ПустаяСтрока(ТекущиеДанные.БИК) и Не ЗначениеЗаполнено(БанковскиеРеквизиты.Банк) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден банк по БИК " + ТекущиеДанные.БИК, Объект.Ссылка, "Объект.БанковскиеРеквизиты[" + НомерСтрокиСтрока + "].БИК");	
	КонецЕсли;
	
КонецПроцедуры

