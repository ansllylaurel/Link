&НаКлиенте
Процедура КомандаЗаполнитьАдрес(Команда)
	
	СписокВыборка = Новый СписокЗначений;
	
	СписокВыборка.Добавить("АдресРегистрации"		, "Скопировать адрес регистрации");
	СписокВыборка.Добавить("АдресМестаЖительства"	, "Скопировать адрес места жительства");
	СписокВыборка.Добавить("ПочтовыйАдрес"			, "Скопировать почтовый адрес");
	
	ИмяЭлемента = СтрЗаменить(Команда.Имя, "КомандаЗаполнить", "");

	СписокВыборка.Удалить(СписокВыборка.НайтиПоЗначению(ИмяЭлемента));
	
	ВыбранноеЗначение = ЭтаФорма.ВыбратьИзМеню(СписокВыборка, Команда);
	Если ВыбранноеЗначение <> Неопределено Тогда
		Объект[ИмяЭлемента] = Объект[ВыбранноеЗначение.Значение];
		Объект[ИмяЭлемента + "ФИАС"] = Объект[ВыбранноеЗначение.Значение + "ФИАС"];
	КонецЕсли;
	
КонецПроцедуры

