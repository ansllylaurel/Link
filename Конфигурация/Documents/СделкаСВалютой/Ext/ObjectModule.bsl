Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ОтложенноеИсполнение Тогда 
		
		НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		
		СчетУчетаВалюты = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Валюта,
		ЭтотОбъект.Брокер);
		
		СчетУчетаКонтрВалюты = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Контрвалюта,
		ЭтотОбъект.Брокер);
		
		ОстатокНаСчетеВПути = 0;
		
		ПараметрыПереоценкиВалюты = Новый Структура("УчетныйРегистр", УчетныйРегистр);
		ПараметрыПереоценкиВалюты.Вставить("Счет", 		СчетУчетаВалюты);
		ПараметрыПереоценкиВалюты.Вставить("Валюта", 	ЭтотОбъект.Валюта);
		
		ПараметрыПереоценкиКонтрвалюты = Новый Структура("УчетныйРегистр", УчетныйРегистр);
		ПараметрыПереоценкиКонтрвалюты.Вставить("Счет", 	СчетУчетаКонтрВалюты);
		ПараметрыПереоценкиКонтрвалюты.Вставить("Валюта", 	ЭтотОбъект.Контрвалюта);
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			
			// ----------- ПРИХОД -----------
			Если ЭтотОбъект.Валюта = ЭтотОбъект.Организация.ВалютаУчета Тогда
				СуммаОперации = ЭтотОбъект.Сумма;
			Иначе
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаОперации, "Сделка с валютой");
			
			// дебет	
