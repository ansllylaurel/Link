
Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	Если НЕ ЭтотОбъект.ОтложенноеИсполнение Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                       	ЭтотОбъект.Брокер);
		ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                 ЭтотОбъект.МестоХранения);
		
		Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет", ЭтотОбъект.РасчетныйСчетКонтрвалюты);
		ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет", ЭтотОбъект.РасчетныйСчет);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.ТипСделки = Перечисления.ТипыСделокСВалютой.Конверсионная
		И ЗначениеЗаполнено(ЭтотОбъект.Основание)
		И ЭтотОбъект.Основание.ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
		
		// задолженность по д/с
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
		ЭлементБлокировкиДанных.УстановитьЗначение("Основание",        ЭтотОбъект.Основание);
		ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоФорвардуПоставки);
		
	КонецЕсли;
	
	Если БлокировкаДанных.Количество() > 0 Тогда
		БлокировкаДанных.Заблокировать();
	КонецЕсли;
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиДенежныхСредств.Записывать           	= Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать	= Истина;
	Движения.РасходыПоСделке.Записывать						= Истина;
	Движения.УсловияСделокСВалютой.Записывать				= Истина;
	
	Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		РасчетныйСчетОткуда = ЭтотОбъект.РасчетныйСчетКонтрвалюты;
		РасчетныйСчетКуда   = ЭтотОбъект.РасчетныйСчет;
		ВалютаОткуда        = ЭтотОбъект.Контрвалюта;
		ВалютаКуда          = ЭтотОбъект.Валюта;
		СуммаРасхода        = ЭтотОбъект.СуммаКонтрвалюты;
		СуммаПрихода        = ЭтотОбъект.Сумма;
	ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		РасчетныйСчетОткуда = ЭтотОбъект.РасчетныйСчет;
		РасчетныйСчетКуда   = ЭтотОбъект.РасчетныйСчетКонтрвалюты;
		ВалютаОткуда        = ЭтотОбъект.Валюта;
		ВалютаКуда          = ЭтотОбъект.Контрвалюта;
		СуммаРасхода        = ЭтотОбъект.Сумма;
		СуммаПрихода        = ЭтотОбъект.СуммаКонтрвалюты;
	КонецЕсли;
	
	// Задолженности по ДС по форвардным сделкам
	Если ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
		// задолженности по д/с
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Ссылка;
		Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
		Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоФорвардуПоставки;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
		Движение.Валюта                       = ВалютаОткуда;
		Движение.Сумма                        = СуммаРасхода;
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Ссылка;
		Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
		Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоФорвардуПоставки;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
		Движение.Валюта                       = ВалютаКуда;
		Движение.Сумма                        = СуммаПрихода;
		
	ИначеЕсли ТипСделки = Перечисления.ТипыСделокСВалютой.Конверсионная
		И ЗначениеЗаполнено(Основание)
		И Основание.ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
		
		// задолженности по д/с
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
		Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоФорвардуПоставки;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
		Движение.Валюта                       = ВалютаОткуда;
		Движение.Сумма                        = СуммаРасхода;
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
		Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоФорвардуПоставки;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
		Движение.Валюта                       = ВалютаКуда;
		Движение.Сумма                        = СуммаПрихода;
	КонецЕсли;
	
	// Задолженность по комиссии добавляем всегда, но для неотложенного исполнения тут же гасим ее (1F: 184326)
	Если ЭтотОбъект.СуммаКомиссии > 0 Тогда
		
		ЗадолженностьПоКомиссии = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		ЗадолженностьПоКомиссии.Период                       = ЭтотОбъект.Дата;
		ЗадолженностьПоКомиссии.Основание                    = ЭтотОбъект.Ссылка;
		ЗадолженностьПоКомиссии.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
		Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ВидЗадолженностиПоКомиссии = Справочники.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО;
			ЗадолженностьПоКомиссии.ВидЗадолженности = ВидЗадолженностиПоКомиссии;
			ЗадолженностьПоКомиссии.Контрагент       = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
		Иначе
			ВидЗадолженностиПоКомиссии = Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
			ЗадолженностьПоКомиссии.ВидЗадолженности = ВидЗадолженностиПоКомиссии;
			ЗадолженностьПоКомиссии.Контрагент		  = ЭтотОбъект.Брокер.ЮрФизЛицо;
		КонецЕсли; 
		ЗадолженностьПоКомиссии.Организация                  = ЭтотОбъект.Организация;
		ЗадолженностьПоКомиссии.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		ЗадолженностьПоКомиссии.Валюта                       = ЭтотОбъект.ВалютаКомиссии;
		ЗадолженностьПоКомиссии.Сумма                        = ЭтотОбъект.СуммаКомиссии;
		
		
		// комиссия
		Если НЕ ЭтотОбъект.ОтложеннаяОплатаКомиссии Тогда
			Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
			Движение.Период                         = ЭтотОбъект.Дата;
			Движение.Организация                    = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Брокер                         = ЭтотОбъект.Брокер;
			Движение.МестоХранения                  = ЭтотОбъект.МестоХранения;
			Движение.РасчетныйСчет                  = РасчетныйСчетОткуда;
			Движение.Валюта                         = ЭтотОбъект.ВалютаКомиссии;
			Движение.Сумма                          = ЭтотОбъект.СуммаКомиссии;
			Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
			Движение.ВариантДвиженияДенежныхСредств = ВидЗадолженностиПоКомиссии;
			
			// Для неотложенного исполнения гасим задолженность (1F: 184326)
			ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), ЗадолженностьПоКомиссии, , "ВидДвижения");
		КонецЕсли;
		
		//Считаем что торговая комиссия у ПИФ проходит по прочим резервам
		ПрочиеРезервыПИФНачисляетсяВУчете = БухгалтерскийУчет.РезервПИФНачисляетсяВУчете(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.Резервы.ПрочиеВозмещаемыеРасходыУправляющего);
		Если ПрочиеРезервыПИФНачисляетсяВУчете и ЭтотОбъект.СуммаКомиссии>0 Тогда 

			АналитикаКомисии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
				Дата, 
				Организация, 
				СчетДоверительногоУправления,
				ВидЗадолженностиПоКомиссии,
				Перечисления.ВидыУчета.БухгалтерскийУчет,
				"Аналитика");
				
			Если ЗначениеЗаполнено(АналитикаКомисии) Тогда	
					
				РезервПоРасходу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АналитикаКомисии, "Резерв");
				Если ЗначениеЗаполнено(РезервПоРасходу) Тогда		
					Движение = Движения.РезервыПИФ.ДобавитьРасход();
					
					Движение.Период      = ЭтотОбъект.Дата;
					Движение.Организация = ЭтотОбъект.Организация;
					Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
					Движение.Резерв = РезервПоРасходу;
					
					ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
					Если ЭтотОбъект.ВалютаКомиссии <> ВалютаУчета Тогда 
						СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаКомиссии, ЭтотОбъект.ВалютаКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
						Движение.Валюта = ВалютаУчета;
					Иначе
					    СуммаОперации = ЭтотОбъект.СуммаКомиссии;
						Движение.Валюта = ЭтотОбъект.ВалютаКомиссии;
					КонецЕсли;
								
					Движение.Сумма  = СуммаОперации;
										
				КонецЕсли;
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана аналитика торговой комиссии по бухучету! Списание резервов невозможно!", ЭтотОбъект.Ссылка,,, Отказ);
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если Не ОтложенноеИсполнение Тогда
		// остатки д/с
		Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
		Движение.Период                         = ЭтотОбъект.Дата;
		Движение.Организация                    = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Брокер                         = ЭтотОбъект.Брокер;
		Движение.МестоХранения                  = ЭтотОбъект.МестоХранения;
		Движение.РасчетныйСчет                  = РасчетныйСчетОткуда;
		Движение.Валюта                         = ВалютаОткуда;
		Движение.Сумма                          = СуммаРасхода;
		Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
		Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоСделке;
		
		Движение = Движения.ОстаткиДенежныхСредств.ДобавитьПриход();
		Движение.Период                         = ЭтотОбъект.Дата;
		Движение.Организация                    = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Брокер                         = ЭтотОбъект.Брокер;
		Движение.МестоХранения                  = ЭтотОбъект.МестоХранения;
		Движение.РасчетныйСчет                  = РасчетныйСчетКуда;
		Движение.Валюта                         = ВалютаКуда;
		Движение.Сумма                          = СуммаПрихода;
		Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
		Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоСделке;
		
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
		
	Иначе
		
		Если ТипСделки <> Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
			// задолженности по д/с
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоСделке;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
			Движение.Валюта                       = ВалютаОткуда;
			Движение.Сумма                        = СуммаРасхода;
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоСделке;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Контрагент                   = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;
			Движение.Валюта                       = ВалютаКуда;
			Движение.Сумма                        = СуммаПрихода;
		КонецЕсли;
		
	КонецЕсли;
	
	//Расходы по сделке
	Если ЭтотОбъект.СуммаКомиссии > 0 Тогда
		Движение = Движения.РасходыПоСделке.Добавить();
		Движение.Период							= ЭтотОбъект.Дата;
		Движение.Организация					= ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Сделка							= ЭтотОбъект.Ссылка;
		Движение.ВидЗадолженности				= ?(ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок, Справочники.ВидыЗадолженности.ПоБанковскойКомиссии, Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
		Движение.Валюта							= ЭтотОбъект.ВалютаКомиссии;
		Движение.Сумма							= ЭтотОбъект.СуммаКомиссии;
	КонецЕсли;
	
	Движение = Движения.УсловияСделокСВалютой.Добавить();
	Движение.Период 						= ЭтотОбъект.Дата;
	Движение.Организация 					= ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления 	= ЭтотОбъект.СчетДоверительногоУправления;
	Движение.СделкаСВалютой 				= ЭтотОбъект.Ссылка;
	Движение.Отменено 						= Ложь;
	Движение.РасчетныйСчет 					= ЭтотОбъект.РасчетныйСчет;
	Движение.РасчетныйСчетКонтрвалюты 		= ЭтотОбъект.РасчетныйСчетКонтрвалюты;
	Движение.Валюта 						= ЭтотОбъект.Валюта;
	Движение.Контрвалюта 					= ЭтотОбъект.Контрвалюта;
	Движение.Курс 							= ЭтотОбъект.Курс;
	Движение.Сумма 							= ЭтотОбъект.Сумма;
	Движение.СуммаКонтрвалюты 				= ЭтотОбъект.СуммаКонтрвалюты;
	Движение.ДатаИсполнения 				= ЭтотОбъект.ДатаИсполнения;
	
	РегистрыСведений.ПлановыеДатыОплат.СформироватьДвижения(ЭтотОбъект);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Если ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
	
	Если ЭтотОбъект.Валюта <> ВалютаУчета
		И ЭтотОбъект.Контрвалюта <> ВалютаУчета Тогда // Валюта за валюту
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Покупка валюты за валюту не реализована!",ЭтотОбъект.Ссылка,,,Отказ);
		Возврат;
	
	КонецЕсли;
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если ЭтотОбъект.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		Контрагент = ЭтотОбъект.РасчетныйСчет.Банк.ЮрФизЛицо;	
	Иначе
		Контрагент = ЭтотОбъект.Брокер.ЮрФизЛицо;
	КонецЕсли;
	КонтрагентЯвляетсяРезидентом = Справочники.ЮрФизЛица.ЯвляетсяРезидентом(Контрагент, ЭтотОбъект.Организация);	
	
	Если ЭтотОбъект.Валюта = ВалютаУчета Тогда
		
		СуммаСделки = ЭтотОбъект.СуммаКонтрвалюты;
		СуммаСделкиВВалютеУчета = ЭтотОбъект.Сумма;
		СуммаПокрытия = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаКонтрвалюты, ЭтотОбъект.Контрвалюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
	ИначеЕсли ЭтотОбъект.Контрвалюта = ВалютаУчета Тогда
		
		СуммаСделки = ЭтотОбъект.Сумма;
		СуммаСделкиВВалютеУчета = ЭтотОбъект.СуммаКонтрвалюты;
		СуммаПокрытия = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
	КонецЕсли;
	
	Если ЭтотОбъект.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		
		СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
		Если НЕ Справочники.Банки.ЯвляетсяРезидентом(ЭтотОбъект.РасчетныйСчет.Банк, Дата) Тогда
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		
		ВидСубконтоВалюты = ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета;
		СубконтоВалюты = ЭтотОбъект.РасчетныйСчет;
		
		ВидСубконтоКонтрВалюты = ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета;
		СубконтоКонтрВалюты = ЭтотОбъект.РасчетныйСчетКонтрвалюты;
		
	Иначе
		
		СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02;
		
		ВидСубконтоВалюты = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
		СубконтоВалюты = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		
		ВидСубконтоКонтрВалюты = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
		СубконтоКонтрВалюты = СубконтоВалюты;
		
	КонецЕсли;
	
	// комиссия
	Если НЕ ЭтотОбъект.ОтложеннаяОплатаКомиссии И ЭтотОбъект.СуммаКомиссии <> 0 Тогда
		
		СчетРасходов = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
		АналитикаРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("53105");
		
		ГФУ = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
			"Аналитика",
			Ложь);
			
		Если ГФУ <> Неопределено Тогда
			
			Если СокрЛП(ГФУ.НомерСчетаБухгалтерскогоУчета) = "71512" Тогда
			
				СчетРасходов = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
				
				Если ЭтотОбъект.Валюта = ВалютаУчета Тогда
					АналитикаРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(ПланыСчетов.Единый.ДоходыРасходыОтОпераций12, ЭтотОбъект.Контрвалюта, Истина);
				Иначе
					АналитикаРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(ПланыСчетов.Единый.ДоходыРасходыОтОпераций12, ЭтотОбъект.Валюта, Истина);
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;			
		
		СуммаКомиссииВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаКомиссии, ЭтотОбъект.ВалютаКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаКомиссииВВалютеУчета, "Списание комиссии");
		
		Проводка.СчетДт 											= СчетРасходов;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов 	= АналитикаРасходов;
		
		Проводка.СчетКт 									= СчетДС;
		
		Проводка.СубконтоКт[ВидСубконтоВалюты] = СубконтоВалюты;
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
		Иначе
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
		КонецЕсли;
		
		Проводка.ВалютаКт  			= ЭтотОбъект.ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт 	= ЭтотОбъект.СуммаКомиссии;
		
		Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаКомиссииВВалютеУчета, "Закрытие расходов");
			
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
			
			Проводка.СчетКт 											= СчетРасходов;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов 	= АналитикаРасходов;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОтложенноеИсполнение Тогда
		
		Если (ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.Контрвалюта = ВалютаУчета) // купили за рубли валюту
			ИЛИ (ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтотОбъект.Валюта = ВалютаУчета)	// продали за валюту рубли
			Тогда
			
			// Требование по поставке валюты
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиВВалютеУчета, "Отражены требования по поставке ДС");
			
			// дебет
			Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеДС01, ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
			
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
			
			Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.ВалютаДт        = ЭтотОбъект.Валюта;
			Иначе
			    Проводка.ВалютаДт        = ЭтотОбъект.Контрвалюта;
			КонецЕсли;
			Проводка.ВалютнаяСуммаДт = СуммаСделки;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
			
			// Обязательство по поставке рублей
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиВВалютеУчета, "Отражены обязательства по поставке ДС");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			
			// кредит
			Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС01, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС02);
			Проводка.СубконтоКт.ОснованиеРасчетов = Ссылка;
			
			Проводка.ВалютаКт = ВалютаУчета;
			Проводка.ВалютнаяСуммаКт = СуммаСделкиВВалютеУчета;
			
			Если СуммаПокрытия > СуммаСделкиВВалютеУчета Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПокрытия - СуммаСделкиВВалютеУчета, "Отражены требования по поставке ДС");
				
				// дебет
				Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеДС01, ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
				
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					Проводка.ВалютаДт        = ЭтотОбъект.Валюта;
				Иначе
				    Проводка.ВалютаДт        = ЭтотОбъект.Контрвалюта;
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
			ИначеЕсли СуммаПокрытия < СуммаСделкиВВалютеУчета Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиВВалютеУчета - СуммаПокрытия, "Отражены требования по поставке ДС");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
				
				// кредит
				Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеДС01, ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
				
				Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					Проводка.ВалютаКт        = ЭтотОбъект.Валюта;
				Иначе
				    Проводка.ВалютаКт        = ЭтотОбъект.Контрвалюта;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли (ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтотОбъект.Контрвалюта = ВалютаУчета) // продали за рубли валюту
			ИЛИ (ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.Валюта = ВалютаУчета)	// купли за валюту рубли
			Тогда 
			
			// Требование по поставке рублей
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиВВалютеУчета, "Отражены требования по поставке ДС");
			
			// дебет
			Проводка.СчетДт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеДС01, ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
			
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
			
			Проводка.ВалютаДт        = ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = СуммаСделкиВВалютеУчета;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСАктивом;
			
			
			// Обязательство по поставке валюты
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиВВалютеУчета, "Отражены обязательства по поставке ДС");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			
			// кредит
			Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС01, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС02);
			Проводка.СубконтоКт.ОснованиеРасчетов = Ссылка;
			
			Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.ВалютаКт        = ЭтотОбъект.Контрвалюта;
			Иначе
			    Проводка.ВалютаКт        = ЭтотОбъект.Валюта;
			КонецЕсли;
			Проводка.ВалютнаяСуммаКт = СуммаСделки;
			
			Если СуммаПокрытия > СуммаСделкиВВалютеУчета Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПокрытия - СуммаСделкиВВалютеУчета, "Отражены обязательства по поставке ДС");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
				
				// кредит
				Проводка.СчетКт = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС01, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС02);
				Проводка.СубконтоКт.ОснованиеРасчетов = Ссылка;
				
				Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					Проводка.ВалютаКт        = ЭтотОбъект.Контрвалюта;
				Иначе
				    Проводка.ВалютаКт        = ЭтотОбъект.Валюта;
