		КонецЕсли;
		
	КонецЕсли;  // НЕ ОтложенноеИсполнение
	
	//РаботаСРегистрамиБухгалтерии.ЗаполнитьСуммуПроводкиВВалютеУчета(Проводка, Перечисления.ДебетКредит.Дебет, Отказ);
	
	// ТОРГОВАЯ КОМИССИЯ
	Если ЭтотОбъект.СуммаКомиссии <> 0 Тогда
		
		// проводки по торговой комиссии
		СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			УчетныйРегистр,
			"СчетУчета");
			
		АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			УчетныйРегистр,
			"Аналитика");
			
		СуммаТорговойКомиссииВал = ЭтотОбъект.СуммаКомиссии;
		Если ЭтотОбъект.ВалютаКомиссии = ЭтотОбъект.Организация.ВалютаУчета Тогда
			СуммаТорговойКомиссии = ЭтотОбъект.СуммаКомиссии;
		Иначе
			СуммаТорговойКомиссии = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.СуммаКомиссии, ЭтотОбъект.ВалютаКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		КонецЕсли;
		

		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаТорговойКомиссии, "Поступление услуг");
		
		БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
			ЭтотОбъект, 
			Проводка.СчетДт, 
			Проводка.СубконтоДт, 
			ПланыСчетов.Основной.ПрочиеРасходы, 
			АналитикаУслуг); 
		
		ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
		ЕстьСубконтоДоговорыБрокерскогоОбслуживанияПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
		ЕстьСубконтоСделка = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);						
		
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
		
		Проводка.СчетКт = СчетУчетаКомиссии;
		
		Если СчетУчетаКомиссии.Валютный Тогда
			Проводка.ВалютаКт = ЭтотОбъект.ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт = СуммаТорговойКомиссииВал;
		КонецЕсли;
		
		Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
			Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Брокер.ЮрФизЛицо;
		КонецЕсли;
		Если ЕстьСубконтоДоговорыБрокерскогоОбслуживанияПоКомиссии Тогда
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
		КонецЕсли;
		Если ЕстьСубконтоСделка Тогда
			Проводка.СубконтоКт.Сделка = ЭтотОбъект.Ссылка;
		КонецЕсли;
		
		Если Не ЭтотОбъект.ОтложеннаяОплатаКомиссии Тогда
			
			// Оплата комиссии
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаТорговойКомиссии, "Списание торговой комиссии");
			
			Проводка.СчетДт = СчетУчетаКомиссии;
			
			Если СчетУчетаКомиссии.Валютный Тогда
				Проводка.ВалютаДт = ЭтотОбъект.ВалютаКомиссии;
				Проводка.ВалютнаяСуммаДт = СуммаТорговойКомиссииВал;
			КонецЕсли;
			
			Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Брокер.ЮрФизЛицо;
			КонецЕсли;
			Если ЕстьСубконтоДоговорыБрокерскогоОбслуживанияПоКомиссии Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			Если ЕстьСубконтоСделка Тогда
				Проводка.СубконтоДт.Сделка = ЭтотОбъект.Ссылка;
			КонецЕсли;
			
			СчетУчетаОплатыКомиссии = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				ЭтотОбъект.ВалютаКомиссии,
				ЭтотОбъект.Брокер);

			Проводка.СчетКт = СчетУчетаОплатыКомиссии;
			
			Если СчетУчетаОплатыКомиссии.Валютный Тогда
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаКомиссии;
				Проводка.ВалютнаяСуммаКт = СуммаТорговойКомиссииВал;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
				Иначе
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
				КонецЕсли;				
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = ВидДвиженияДенежныхСредств;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	БухгалтерскийУчет.ПереоценитьВалютныеАктивы(ЭтотОбъект,УчетныйРегистр, Перечисления.ВидыУчета[УчетныйРегистр], НастройкиУчетаОбщие, Отказ);
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "НомерСделки, НомерПодтверждения");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ТипСделки = Перечисления.ТипыСделокСВалютой.СвопВтораяЧасть Тогда
		ПроверяемыеРеквизиты.Добавить("Основание");
	КонецЕсли;
	
	Если ЭтотОбъект.ОтложенноеИсполнение Тогда
		ПроверяемыеРеквизиты.Добавить("ДатаИсполнения");
	КонецЕсли;
	
	Если ЭтотОбъект.МестоХранения <> ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок") Тогда
		ПроверяемыеРеквизиты.Добавить("НомерСделки");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЗначениеЗаполнено(ЭтотОбъект.НомерСделки) Тогда
			РаботаСДокументами.ПроверитьУникальностьНомераСделки(ЭтотОбъект, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.НомерСделки) И ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Номер сделки"" заполняется только для биржевых сделок", ЭтотОбъект, "НомерСделки",, Отказ);		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ДатаИсполнения) И (НачалоДня(ЭтотОбъект.Дата) > ЭтотОбъект.ДатаИсполнения) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата исполнения по валютной сделке меньше даты сделки", ЭтотОбъект, "ДатаИсполнения",, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
			И ЭтотОбъект.ТипСделки <> Перечисления.ТипыСделокСВалютой.СвопВтораяЧасть
			И ЭтотОбъект.ТипСделки <> Перечисления.ТипыСделокСВалютой.Конверсионная Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение основания допустимо только для 2-й части свопа или для исполнения форварда", ЭтотОбъект, "ТипСделки",, Отказ);
		КонецЕсли;
		
		ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ДетализацияПоРасчетномуСчету", ДетализацияПоРасчетномуСчету);
		
		Если ДетализацияПоРасчетномуСчету Тогда
			
			Если Не ЗначениеЗаполнено(РасчетныйСчет) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счёт"" не заполнено", ЭтотОбъект, "РасчетныйСчет",, Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(РасчетныйСчетКонтрвалюты) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счёт контрвалюты"" не заполнено", ЭтотОбъект, "РасчетныйСчетКонтрвалюты",, Отказ);
			КонецЕсли;

			Если ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.Валюта Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета отличается от валюты сделки", ЭтотОбъект, "РасчетныйСчет",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.РасчетныйСчетКонтрвалюты.Валюта <> ЭтотОбъект.Контрвалюта Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета контрвалюты отличается от контрвалюты", ЭтотОбъект, "РасчетныйСчетКонтрвалюты",, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтотОбъект.СуммаКомиссии <> 0 Тогда
			Если Не ЗначениеЗаполнено(ВалютаКомиссии) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма комиссии задана, а валюта комиссии не указана", ЭтотОбъект, "ВалютаКомиссии",, Отказ);					
			КонецЕсли;
		КонецЕсли; 
		
		Если НЕ ЭтотОбъект.ОтложенноеИсполнение И ЭтотОбъект.ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для форварда поставочного обязательно отложенное исполнение", ЭтотОбъект, "ОтложенноеИсполнение",, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.ТипСделки = Перечисления.ТипыСделокСВалютой.Конверсионная И ЗначениеЗаполнено(ЭтотОбъект.Основание) Тогда
			
			Если ЭтотОбъект.Основание.ТипСделки <> Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основанием для конверсионной сделки может быть только форвард поставочный", ЭтотОбъект, "Дата",, Отказ);
			КонецЕсли;
				
			Если ЭтотОбъект.Основание.ДатаИсполнения <> НачалоДня(ЭтотОбъект.Дата) 
				//ТехническийДолг - #296253 - Изменения по форварду
				И ЭтотОбъект.Основание.Номер <> "РПИ-180919/65-9" 
				Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа (" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + ") не соответствует дате исполнения форварда (" + Формат(ЭтотОбъект.Основание.ДатаИсполнения, "ДФ=dd.MM.yyyy") + ")", ЭтотОбъект, "Дата",, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтотОбъект.ТипСделки = Перечисления.ТипыСделокСВалютой.СвопВтораяЧасть И ЗначениеЗаполнено(ЭтотОбъект.Основание)
			И ЭтотОбъект.Основание.ТипСделки <> Перечисления.ТипыСделокСВалютой.СвопПерваяЧасть Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основанием для сделки - второй части свопа может быть только сделка - первая часть свопа", ЭтотОбъект, "Дата",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

#КонецОбласти
