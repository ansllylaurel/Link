&НаСервере
Процедура ЗаполнитьЦенныеБумагиИПартииПоДаннымФайлаExcelНаСервере(АдресВоВременномХранилище)

	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	РаботаСЦеннымиБумагами.ЗаполнитьЦенныеБумагиИПартииПоДаннымФайлаExcel(ОбъектДокумента, АдресВоВременномХранилище);
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
	ЗаполнитьНомераСделокНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНомераСделокНаСервере(ДанныеСтроки = Неопределено)
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеСтроки = Неопределено Тогда
		
		// Заполнение всех строк
		ЦенныеБумаги  = Объект.ЦенныеБумаги.Выгрузить( , "ЦеннаяБумага, Партия, СтрокаПартии");
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ЦеннаяБумага) И ЗначениеЗаполнено(ДанныеСтроки.Партия) И ДанныеСтроки.СтрокаПартии > 0 Тогда 		
		
		// Отбор по одной строке
		ЦенныеБумаги  = Объект.ЦенныеБумаги.Выгрузить( , "ЦеннаяБумага, Партия, СтрокаПартии");
		ЦенныеБумаги.Очистить();
		НоваяСтрока = ЦенныеБумаги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
		
	Иначе
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Партия КАК Партия,
		|	ЦенныеБумаги.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|ГДЕ
		|	НЕ(ЦенныеБумаги.Партия В (НЕОПРЕДЕЛЕНО, &ПустыеСсылкиПартий)
		|				И ЦенныеБумаги.СтрокаПартии = 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦенныеБумаги.Партия КАК Партия,
		|	_ЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(_ЦенныеБумаги.Партия КАК Документ.Сделка).НомерСделки, """")
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ВЫРАЗИТЬ(_ЦенныеБумаги.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки, """")
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.Партия) = ТИП(Документ.ВводЦенныхБумаг)
		|			ТОГДА ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.НомерСделки, """")
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
		|			ТОГДА ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.НомерСделки, """")
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерСделки
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО _ЦенныеБумаги.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И _ЦенныеБумаги.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО _ЦенныеБумаги.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И _ЦенныеБумаги.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки"); 		
	
	Запрос.УстановитьПараметр("ЦенныеБумаги",		Объект.ЦенныеБумаги.Выгрузить( , "ЦеннаяБумага, Партия, СтрокаПартии"));
	Запрос.УстановитьПараметр("ПустыеСсылкиПартий",	СистемныеФункции.ПустыеСсылкиСоставногоТипа(Метаданные.ОпределяемыеТипы.Партия.Тип));
	
	ТаблицаСНомерамиСделок = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицыСНомерамиСделок Из ТаблицаСНомерамиСделок Цикл
		
		НайдСтрокиЦБ = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", СтрокаТаблицыСНомерамиСделок.ЦеннаяБумага, СтрокаТаблицыСНомерамиСделок.Партия, СтрокаТаблицыСНомерамиСделок.СтрокаПартии));
		Если НайдСтрокиЦБ.Количество() > 0 Тогда
			НайдСтрокиЦБ[0].НомерСделки = СтрокаТаблицыСНомерамиСделок.НомерСделки;
		КонецЕсли; 
		
	КонецЦикла;
	           	
КонецПроцедуры 

&НаКлиенте
Процедура ЦенныеБумаги1ПартияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	
	Если Не ОчиститьНомерСделки(ТекущиеДанные) Тогда	
		ЗаполнитьНомераСделокНаСервере(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", ТекущиеДанные.ЦеннаяБумага, ТекущиеДанные.Партия, ТекущиеДанные.СтрокаПартии));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОчиститьНомерСделки(ДанныеСтроки)
	
	Если Не (ЗначениеЗаполнено(ДанныеСтроки.ЦеннаяБумага) И ЗначениеЗаполнено(ДанныеСтроки.Партия) И ДанныеСтроки.СтрокаПартии > 0) Тогда 
		Объект.ЦенныеБумаги.НайтиПоИдентификатору(Элементы.ЦенныеБумаги1.ТекущаяСтрока).НомерСделки = "";
		Возврат Истина;
	КонецЕсли;	                                                                                         		
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЦенныеБумаги1СтрокаПартииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	
	Если Не ОчиститьНомерСделки(ТекущиеДанные) Тогда	
		ЗаполнитьНомераСделокНаСервере(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", ТекущиеДанные.ЦеннаяБумага, ТекущиеДанные.Партия, ТекущиеДанные.СтрокаПартии));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

