
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Ключ.Пустая() Тогда
		РаботаСДокументами.ПроверитьВозможностьСозданияПодчиненногоДокументаНаОснованииПоручения(Объект, Отказ);	
	КонецЕсли;
		
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.КорзинаЦенныхБумаг = Истина; // в этом документе всегда вкл. корзина ц/б
	
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();

	ЗаполнитьПодтверждениеОперацииНаСервере();		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперациинаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоЦеннымБумагам",
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, ДепозитарныйСчет"))
	Тогда
		Объект.ДепозитарныйСчет = Неопределено;
	КонецЕсли;
	
	АдресТаблицыСтоимостей = Неопределено;

	Если Объект.ЦенныеБумаги.Количество() > 0 Тогда
		ПересчитатьРыночнуюСтоимость = Вопрос("Пересчитать рыночную стоимость на текущую дату?", РежимДиалогаВопрос.ДаНет);
		Если ПересчитатьРыночнуюСтоимость = КодВозвратаДиалога.Да Тогда
			ПересчитатьРыночнуюСтоимость();
		КонецЕсли;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	АдресТаблицыСтоимостей = Неопределено;

	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
		ЭтаФорма.ТипПередачи = 0;
	КонецЕсли;
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);

	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	Если Объект.Рынок = ЭтаФорма.ТекущийРынок Тогда // ничего менять не нужно
		Возврат;
	КонецЕсли;
	
	// на текущий момент выбор рынка закладных возможен только в сделке
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Закладные")
		И ТипЗнч(Объект.Ссылка) <> Тип("ДокументСсылка.Сделка")
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На текущий момент допускается только покупка закладных");
		Объект.Рынок = ЭтаФорма.ТекущийРынок;
		Возврат;
	КонецЕсли;
	
	Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа  = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	Элементы.ЦенныеБумаги1ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги2ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	
	Если ЭтаФорма.ТекущийРынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ПустаяСсылка") Тогда
		// если выбрана корзина ценных бумаг и добавлены строки корзины,
		// то после подтверждения очистим корзину
		ТребПодтверждение = Не ЭтаФорма.КорзинаЦенныхБумаг Или (ЭтаФорма.КорзинаЦенныхБумаг И Объект.ЦенныеБумаги.Количество() > 0);
		
		Если ТребПодтверждение Тогда
			Если Вопрос("Ценные бумаги и связанные с ними реквизиты будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда // возвращаем всё в зад
				Объект.Рынок = ЭтаФорма.ТекущийРынок;
				Возврат;
			Иначе
				РаботаСКорзинойЦенныхБумагКлиентСервер.ОчиститьРеквизиты(ЭтаФорма, Объект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	ЭтаФорма.ТекущийРынок = Объект.Рынок;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоручениеОчистка(Элемент, СтандартнаяОбработка)
	
	Если Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Поручение, "ПометкаУдаления") Тогда
		Если Вопрос("Пометить на удаление поручение? Документ ввода ценных бумаг будет записан и перепроведен (для проведенных)!", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			СтандартнаяОбработка = Ложь;
			ПометитьНаУдалениеПоручениеНаСервере();
		КонецЕсли;	
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоручениеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Поручение) Тогда
		Если Вопрос("Заполнить документ на основании выбранного поручения?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЗаполнитьДокументНаОснованииПорученияНаСервере();
		КонецЕсли;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПередачиПриИзменении(Элемент)
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ТЧ_ЦЕННЫЕ_БУМАГИ

&НаКлиенте
Процедура ЦенныеБумагиПриИзменении(Элемент)
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦеннаяБумагаПриИзменении(Элемент)
	
	ТаблицаФормы = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.СуммаБУ						= 0;
		ТекущиеДанные.ВалютаКотировки				= Неопределено;
		ТекущиеДанные.ВалютаКотировкиКупона			= Неопределено;
		ТекущиеДанные.ВидЦены						= Неопределено;
		ТекущиеДанные.СуммаРынок					= 0;
		ТекущиеДанные.СуммаКупонаРынок				= 0;
		ТекущиеДанные.СуммаРынокВВалютеУчета		= 0;
		ТекущиеДанные.СуммаКупонаРынокВВалютеУчета	= 0;
	КонецЕсли;
	
	ПересчитатьРыночнуюСтоимость(ТаблицаФормы.ТекущаяСтрока, ТаблицаФормы.Имя);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "Количество", , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиКоличествоПриИзменении(Элемент)
	
	ТаблицаФормы = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "Количество",, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1ЦенаКотировкиПриИзменении(Элемент)

	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, "ЦенныеБумаги1", "ЦенаКотировки", , Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1ЦенаКотировкиКупонаПриИзменении(Элемент)

	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, "ЦенныеБумаги1", "ЦенаКотировкиКупона", , Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаРынокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.СуммаВсегоРынок = ТекущиеДанные.СуммаРынок + ТекущиеДанные.СуммаКупонаРынок;
	
	ВалютаСуммы		= ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаКотировки"]), ТекущиеДанные["ВалютаКотировки"], ТекущиеДанные["ВалютаНоминала"]);
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги1", "СуммаРынок", ВалютаСуммы, Истина);
	
	ТекущиеДанные.СуммаВсегоЗаВычетомРезервов = ТекущиеДанные.СуммаВсегоРынокВВалютеУчета - ТекущиеДанные.СуммаРезервов;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаКупонаРынокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.СуммаВсегоРынок = ТекущиеДанные.СуммаРынок + ТекущиеДанные.СуммаКупонаРынок;

	ВалютаСуммы = ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаКотировкиКупона"]), ТекущиеДанные["ВалютаКотировкиКупона"], ТекущиеДанные["ВалютаНоминала"]);
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги1", "СуммаКупонаРынок", ВалютаСуммы, Истина);
	
	ТекущиеДанные.СуммаВсегоЗаВычетомРезервов = ТекущиеДанные.СуммаВсегоРынокВВалютеУчета - ТекущиеДанные.СуммаРезервов;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаРынокВВалютеУчетаПриИзменении(Элемент)
	
	ПересчитатьСуммуВсегоРынокВВалютеУчета("ЦенныеБумаги1");	

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаКупонаРынокВВалютеУчетаПриИзменении(Элемент)

	ПересчитатьСуммуВсегоРынокВВалютеУчета("ЦенныеБумаги1");	

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоЦеннымБумагам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоЦеннымБумагам(ЭтаФорма,);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнить(Команда)

	Если Объект.ЦенныеБумаги.Количество() > 0
		И Вопрос("После заполнения ранее введенные данные будут утеряны. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, что заведены настройки оценки, и подгружаем файл с оценочной стоимостью, предоставленной клиентом

	ОшибкаРасчетаРыночнойСтоимости = Ложь;	
	
	ЦельРасчета				= ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении");
	НастройкиОценки			= РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета);
	АдресТаблицыСтоимостей	= Неопределено;
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "'", , , , ОшибкаРасчетаРыночнойСтоимости);
		
	ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = ПредопределенноеЗначение("Справочник.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом") Тогда
		
		АдресТаблицыСтоимостей = РаботаСВнешнимиСистемамиКлиентСервер.ВыбратьФайлОценочнойСтоимостиПредоставленнойКлиентом(
			Объект.СчетДоверительногоУправления, Объект.Дата, Ложь, ЭтаФорма.УникальныйИдентификатор);
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
			ОшибкаРасчетаРыночнойСтоимости = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОшибкаРасчетаРыночнойСтоимости Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рыночная стоимость не рассчитана.");		
	КонецЕсли;
	
	// Заполняем стоимость
	
	ЗаполнитьНаСервере(Не ОшибкаРасчетаРыночнойСтоимости);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьРыночнуюСтоимость(Команда)
	
	Если Объект.ЦенныеБумаги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Вопрос("Текущие значения рыночных цен будут изменены на расчетные. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	АдресТаблицыСтоимостей = Неопределено;

	ПересчитатьРыночнуюСтоимость();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьУчетныйАктивЕПС(Команда)
	ЗаполнитьУчетныйАктивЕПСНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифровкаРасчета(Команда)
	
	СтрокаЦенныеБумаги = Элементы.ЦенныеБумаги.ТекущиеДанные;
	
	Если Не ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета доступна только для облигаций");
		Возврат;
	КонецЕсли; 
	
	СписокПартий = ПолучитьСписокПартий(Объект.Ссылка, СтрокаЦенныеБумаги.ЦеннаяБумага);
	
	Если СписокПартий.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет движений по регистру ""Партии ценных бумаг""");
		Возврат;
	КонецЕсли;
	
	ЭлементСпискаПартий =  СписокПартий.ВыбратьЭлемент("Партия");
	
	Если ЭлементСпискаПартий <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
			|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС", 
			Объект.Дата, 
			Объект.Организация, 
			Объект.СчетДоверительногоУправления, 
			ЭлементСпискаПартий.Значение.Количество, 
			ЭлементСпискаПартий.Значение.СуммаКупона, 
			СтрокаЦенныеБумаги.ЦеннаяБумага, 
			ЭлементСпискаПартий.Значение.Партия, 
			ЭлементСпискаПартий.Значение.СтрокаПартии,
			ЭлементСпискаПартий.Значение.УчетныйАктивЕПС);
		ОткрытьФорму("Отчет.РасшифровкаРасчетаАмортизацииДисконтаПремииИКорректировкиПоЭСП.Форма.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗадатьВалютуКотировки(Команда)
	ИмяКорзины		= "ЦенныеБумаги1";
	ТекущиеДанные	= Элементы[ИмяКорзины].ТекущиеДанные;
	
	ВыбраннаяВалюта = ВыбратьВалюту(ТекущиеДанные.ВалютаКотировки, "Валюта котировки");
	Если ВыбраннаяВалюта <> Неопределено Тогда
		ТекущиеДанные.ВалютаКотировки = ВыбраннаяВалюта;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ЦенаКотировки) Тогда 
			РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ИмяКорзины, "ЦенаКотировки", , Истина);
		Иначе
			ПересчетСуммыВВалютеУчета(ИмяКорзины, "СуммаРынок", ВыбраннаяВалюта, Истина);
		КонецЕсли;
		
		ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗадатьВалютуКотировкиКупона(Команда)
	ИмяКорзины		= "ЦенныеБумаги1";
	ТекущиеДанные	= Элементы[ИмяКорзины].ТекущиеДанные;
	
	ВыбраннаяВалюта = ВыбратьВалюту(ТекущиеДанные.ВалютаКотировкиКупона, "Валюта котировки купона");
	Если ВыбраннаяВалюта <> Неопределено Тогда
		ТекущиеДанные.ВалютаКотировкиКупона = ВыбраннаяВалюта;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ЦенаКотировкиКупона) Тогда 
			РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ИмяКорзины, "ЦенаКотировкиКупона", , Истина);
		Иначе
			ПересчетСуммыВВалютеУчета(ИмяКорзины, "СуммаКупонаРынок", ВыбраннаяВалюта, Истина);
		КонецЕсли;
		
		ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифроватьРасчет(Команда)
	
	Отказ = Ложь;	
	
	ТаблицаФормыЦенныеБумаги = Элементы.ЦенныеБумаги1;
	
	ТекущиеДанные = ТаблицаФормыЦенныеБумаги.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущиеДанные.ЦеннаяБумага) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для расшифровки", , , "Объект.ЦенныеБумаги");
		Возврат;
	КонецЕсли;
	
	// Формируем расшифровку расчета
	
	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	ТекущиеДанные.ЦеннаяБумага);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	ПересчитатьРыночнуюСтоимость(ТаблицаФормыЦенныеБумаги.ТекущаяСтрока, , Отказ, РасшифровкаРасчета);
	
	Если ТипЗнч(РасшифровкаРасчета) = Тип("ТабличныйДокумент") Тогда
		РасшифровкаРасчета.Показать("Расчет стоимости '" + Строка(ТекущиеДанные.ЦеннаяБумага) + "'");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьИзФайлаExcel(Команда)
	
	Если Не (ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) 
		И ЗначениеЗаполнено(Объект.Рынок)
		И ЗначениеЗаполнено(Объект.ДепозитарныйСчет)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для загрузки необходимо указать счет доверительного управления, рынок и депозитарный счет");
		Возврат;
	КонецЕсли;
	
	Если Объект.ЦенныеБумаги.Количество() > 0
		И Вопрос("Перед заполнением табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ЦенныеБумаги.Очистить();
		
	АдресВоВременномХранилище = РаботаСВнешнимиСистемамиКлиентСервер.ВыбратьФайлExcelИПоместитьВоВременноеХранилище(ЭтаФорма.УникальныйИдентификатор);
	
	Если АдресВоВременномХранилище <> Неопределено Тогда
		ЗаполнитьЦенныеБумагиИПартииПоДаннымФайлаExcelНаСервере(АдресВоВременномХранилище);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаКлиенте
Функция ТаблицаФормыПоПодчиненномуЭлементу(Элемент)
	
	ТаблицаФормы = Элемент;
	
	Пока ТипЗнч(ТаблицаФормы) <> Тип("ТаблицаФормы") Цикл
		ТаблицаФормы = ТаблицаФормы.Родитель;
	КонецЦикла;
	
	Возврат ТаблицаФормы;
	
КонецФункции

&НаКлиенте
Функция ВыбратьВалюту(Знач ТекущееЗначение, Подсказка = "")
	Если ВвестиЗначение(ТекущееЗначение, Подсказка, Тип("СправочникСсылка.Валюты")) Тогда
		Возврат ТекущееЗначение;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ПересчетСуммыВВалютеУчета(ИмяКорзины = "ЦенныеБумаги", ИмяСуммы, ВалютаСуммы, ПересчитатьРынок = Ложь)
	
	ТекущиеДанные = Элементы[ИмяКорзины].ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные[ИмяСуммы + "ВВалютеУчета"]) Тогда
		Если Вопрос("Пересчитать сумму в валюте учёта?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	ТекущиеДанные[ИмяСуммы + "ВВалютеУчета"] = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТекущиеДанные[ИмяСуммы], ВалютаСуммы, Объект.Организация, Объект.Дата);
	
	Если ПересчитатьРынок Тогда
		ПересчитатьСуммуВсегоРынокВВалютеУчета(ИмяКорзины);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуВсегоРынокВВалютеУчета(ИмяКорзины)

	ТекущиеДанные = Элементы[ИмяКорзины].ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.СуммаВсегоРынокВВалютеУчета = ТекущиеДанные.СуммаРынокВВалютеУчета + ТекущиеДанные.СуммаКупонаРынокВВалютеУчета;
		ТекущиеДанные.СуммаВсегоЗаВычетомРезервов = ТекущиеДанные.СуммаВсегоРынокВВалютеУчета - ТекущиеДанные.СуммаРезервов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы 	  = Форма.Элементы;
	
	Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа  = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ДанныеОбъекта.Рынок);
	Элементы.ЦенныеБумаги1ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги2ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	
	// в зависимости от рынка
	ЭтоРынокОблигаций = (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"));
	
	Элементы.ЦенныеБумагиСписыватьДебиторку.Видимость = ЭтоРынокОблигаций;
	
	Элементы.ЦенныеБумаги1ГруппаКотировкаКупона.Видимость				= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаКупона.Видимость					= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаКупонаВВалютеУчета.Видимость		= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаВсегоРынок.Видимость				= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаВсегоРынокВВалютеУчета.Видимость	= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаВсегоЗаВычетомРезервов.Видимость	= ЭтоРынокОблигаций;
	
	Элементы.ЦенныеБумаги2РезервПодОбесценениеКупонаНачисленный.Видимость = ЭтоРынокОблигаций;
	
	Элементы.ЦенныеБумагиУчетныйАктивЕПС.Видимость = БухгалтерскийУчет.ВедетсяУчетЕПС(ДанныеОбъекта.Дата, ДанныеОбъекта.Организация, ДанныеОбъекта.СчетДоверительногоУправления);
	
	СобственныйСчетДУ = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный"));

	Элементы.ТипПередачи.Видимость = Не СобственныйСчетДУ;
	Элементы.Контрагент.АвтоОтметкаНезаполненного = РаботаСДокументамиКлиентСервер.ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(ДанныеОбъекта);
	Элементы.Контрагент.ТолькоПросмотр = Форма.ТипПередачи < 2 И Не СобственныйСчетДУ;
		
	Элементы.ГруппаЕПС.Видимость = Форма.НеобходимоПоказатьДанныеЕПС;
	
	Элементы.Поручение.Видимость                = Не ЗначениеЗаполнено(Форма.ЗамещениеЦеннымиБумагами);
	Элементы.ЗамещениеЦеннымиБумагами.Видимость = ЗначениеЗаполнено(Форма.ЗамещениеЦеннымиБумагами);		
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьИтоговыеСтроки(Форма)
		
	КорзинаЦенныхБумаг = Форма.Объект.ЦенныеБумаги;
	
	Итоги = Новый Структура("ИтогСуммаВсегоРынок, ИтогСуммаВсегоРынокВВалютеУчета, ИтогСуммаЕПС, ИтогСуммаНУ, ИтогСуммаКупонаЕПС, ИтогСуммаКупонаНУ, ИтогСуммаРезервов, ИтогСуммаВсегоЗаВычетомРезервов",
		КорзинаЦенныхБумаг.Итог("СуммаРынок") + КорзинаЦенныхБумаг.Итог("СуммаКупонаРынок"),
		КорзинаЦенныхБумаг.Итог("СуммаРынокВВалютеУчета") + КорзинаЦенныхБумаг.Итог("СуммаКупонаРынокВВалютеУчета"),
		КорзинаЦенныхБумаг.Итог("СуммаДвиженийЕПС"),
		КорзинаЦенныхБумаг.Итог("СуммаДвиженийНУ"),
		КорзинаЦенныхБумаг.Итог("СуммаДвиженийКупонаЕПС"),
		КорзинаЦенныхБумаг.Итог("СуммаДвиженийКупонаНУ"),
		КорзинаЦенныхБумаг.Итог("СуммаРезервов"),
		КорзинаЦенныхБумаг.Итог("СуммаВсегоЗаВычетомРезервов")
	);
	
	ЗаполнитьЗначенияСвойств(Форма, Итоги); 
	
КонецПроцедуры // ЗаполнитьИтоговыеСтроки

&НаСервере
Функция НеобходимоПоказатьДанныеЕПС()

	ВестиЕдиныйБухгалтерскийУчет = БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ВестиЕдиныйБухгалтерскийУчет");
	Если НЕ ВестиЕдиныйБухгалтерскийУчет Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПереоцениватьАктивыПередВыводом = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "ПереоцениватьАктивыПередВыводом");
	Если НЕ ПереоцениватьАктивыПередВыводом Тогда
		Возврат Ложь;
	КонецЕсли;

	НастройкиСЧА = РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	НастройкиЕПС = РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	Если НастройкиСЧА.ВариантРасчетаОценочнойСтоимости = НастройкиЕПС.ВариантРасчетаОценочнойСтоимости Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеЕПС()

	ЭтаФорма.ДанныеЕПС.Очистить();
	
	ДокументОбъект = Документы.ВыводЦенныхБумаг.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Объект);
	
	ДокументОбъект.ЦенныеБумаги.Загрузить(Объект.ЦенныеБумаги.Выгрузить());
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(ДокументОбъект, "ЦенныеБумаги", Неопределено, Неопределено, Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	Для каждого СтрокаЦенныеБумаги Из ДокументОбъект.ЦенныеБумаги Цикл
	
		СтрокаДанныеЕПС = ЭтаФорма.ДанныеЕПС.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанныеЕПС, СтрокаЦенныеБумаги);
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ТекущийРынок = Объект.Рынок;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыИКотировкиЦенныхБумаг(ЭтаФорма, Объект);
	
	ЗаполнитьСуммыБУНаСервере(Объект);	
	ЗаполнитьНомераСделокНаСервере();
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
	НеобходимоПоказатьДанныеЕПС = НеобходимоПоказатьДанныеЕПС();
	
	Если НеобходимоПоказатьДанныеЕПС Тогда
		ЗаполнитьДанныеЕПС();
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
		ЭтаФорма.ТипПередачи = РаботаСДокументами.ПолучитьТипПередачиДляВводаВыводаАктивов(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.Контрагент);
	КонецЕсли;
	
	ЭтаФорма.ЗамещениеЦеннымиБумагами =
		ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ЗамещениеЦеннымиБумагами", Объект.Ссылка);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ПометитьНаУдалениеПоручениеНаСервере() 
	
	ДанныеОбъекта = ЭтаФорма.Объект;
	Поручение     = ДанныеОбъекта.Поручение.ПолучитьОбъект();
	
	НачатьТранзакцию();
	
	Попытка
		ДанныеОбъекта.Поручение = Неопределено;
		
		Поручение.УстановитьПометкуУдаления(Истина);
		Поручение.Записать();
		
		Если ДанныеОбъекта.Проведен Тогда
			ЭтаФорма.ПриЗаписиПерепроводить = Истина;
		Иначе	
			ЭтаФорма.ПриЗаписиПерепроводить = Ложь;
		КонецЕсли;
		
		Если ЭтаФорма.Записать() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось пометить на удаление поручение " + ДанныеОбъекта.Поручение + "! Система сообщает: " + ОписаниеОшибки());
		
	КонецПопытки;
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДокументНаОснованииПорученияНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектНаСервере.ЗаполнитьНаОснованииПоручения(Объект.Поручение);            
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
		
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры // ЗаполнитьДокументНаОснованииПорученияНаСервере()

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено, ИмяКорзины = "ЦенныеБумаги")
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыИКотировкиЦенныхБумаг(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
	ЗаполнитьСуммыБУНаСервере(Объект, , НомерСтрокиКорзины);	
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ЗаполнитьСуммыБУНаСервере(ДанныеОбъекта, ИмяКорзины = "ЦенныеБумаги", НомерСтрокиКорзины = Неопределено)
	
	Если Не ДанныеОбъекта.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерСтрокиКорзины <> Неопределено Тогда // обновим только указанную строку корзины
		СтрокиЦенныеБумаги = Новый Массив();
		СтрокиЦенныеБумаги.Добавить(ДанныеОбъекта[ИмяКорзины][НомерСтрокиКорзины]);
	Иначе // обновим все строки корзины
		СтрокиЦенныеБумаги = ДанныеОбъекта[ИмяКорзины];
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета + БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета + БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета) КАК Сумма,
		|	БухПартииЦенныхБумаг.ВидУчета КАК ВидУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК СуммаНКД,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценениеКупона) КАК СуммаРезервовПодОбесценениеКупона,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПоСомнительнымДолгам) КАК СуммаРезервовПоСомнительнымДолгам
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.ВидУчета В (ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет), ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидУчета";
	Запрос.УстановитьПараметр("Регистратор", ДанныеОбъекта.Ссылка); 	
	
	СуммыБУ = Запрос.Выполнить().Выгрузить();	
	
	Для Каждого СтрокаЦенныеБумаги Из СтрокиЦенныеБумаги Цикл
		
		СтрокиСуммыБУ = СуммыБУ.НайтиСтроки(Новый Структура("ЦеннаяБумага,ВидУчета", СтрокаЦенныеБумаги.ЦеннаяБумага, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет));
		Если СтрокиСуммыБУ.Количество() > 0 И СтрокаЦенныеБумаги.Количество <> 0 Тогда
			СтрокаЦенныеБумаги.СуммаДвиженийЕПС = СтрокиСуммыБУ[0].Сумма * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			СтрокаЦенныеБумаги.СуммаДвиженийКупонаЕПС = СтрокиСуммыБУ[0].СуммаНКД * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			
			СтрокаЦенныеБумаги.СуммаРезервовПодОбесценение = СтрокиСуммыБУ[0].СуммаРезервовПодОбесценение * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			СтрокаЦенныеБумаги.СуммаРезервовПодОбесценениеКупона = СтрокиСуммыБУ[0].СуммаРезервовПодОбесценениеКупона * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			СтрокаЦенныеБумаги.СуммаРезервовПоСомнительнымДолгам = СтрокиСуммыБУ[0].СуммаРезервовПоСомнительнымДолгам * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			
			СтрокаЦенныеБумаги.СуммаРезервов = -(СтрокаЦенныеБумаги.СуммаРезервовПодОбесценение + СтрокаЦенныеБумаги.СуммаРезервовПодОбесценениеКупона + СтрокаЦенныеБумаги.СуммаРезервовПоСомнительнымДолгам);
			
			СтрокаЦенныеБумаги.СуммаВсегоЗаВычетомРезервов = СтрокаЦенныеБумаги.СуммаВсегоРынокВВалютеУчета - СтрокаЦенныеБумаги.СуммаРезервов;
			
		Иначе	
			СтрокаЦенныеБумаги.СуммаДвиженийЕПС = 0;
			СтрокаЦенныеБумаги.СуммаДвиженийКупонаЕПС = 0;
			
			СтрокаЦенныеБумаги.СуммаРезервовПодОбесценение = 0;
			СтрокаЦенныеБумаги.СуммаРезервовПодОбесценениеКупона = 0;
			СтрокаЦенныеБумаги.СуммаРезервовПоСомнительнымДолгам = 0;
			
			СтрокаЦенныеБумаги.СуммаРезервов = 0;
			
			СтрокаЦенныеБумаги.СуммаВсегоЗаВычетомРезервов = СтрокаЦенныеБумаги.СуммаВсегоРынокВВалютеУчета;
			
		КонецЕсли;
		
		СтрокиСуммыБУ = СуммыБУ.НайтиСтроки(Новый Структура("ЦеннаяБумага,ВидУчета", СтрокаЦенныеБумаги.ЦеннаяБумага, Перечисления.ВидыУчета.НалоговыйУчет));
		Если СтрокиСуммыБУ.Количество() > 0 И СтрокаЦенныеБумаги.Количество <> 0 Тогда
			СтрокаЦенныеБумаги.СуммаДвиженийНУ = СтрокиСуммыБУ[0].Сумма * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
			СтрокаЦенныеБумаги.СуммаДвиженийКупонаНУ = СтрокиСуммыБУ[0].СуммаНКД * (СтрокиСуммыБУ[0].Количество / СтрокаЦенныеБумаги.Количество);
		Иначе	
			СтрокаЦенныеБумаги.СуммаДвиженийНУ = 0;
			СтрокаЦенныеБумаги.СуммаДвиженийКупонаНУ = 0;
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчетныйАктивЕПСНаСервере(Перезаполнять = Ложь)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Отказ = Ложь;
	РаботаСЦеннымиБумагами.ЗаполнитьУчетныеАктивыЕПСИПоместитьВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, 
						Объект.Дата, 
						Объект,
						Объект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, Количество"), "_УчетныеАктивыЕПС", Отказ);
						
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
							
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УчетныеАктивыЕПС.НомерСтроки КАК НомерСтроки,
		|	_УчетныеАктивыЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_УчетныеАктивыЕПС.Партия КАК Партия,
		|	_УчетныеАктивыЕПС.СтрокаПартии КАК СтрокаПартии,
		|	_УчетныеАктивыЕПС.Количество КАК Количество,
		|	_УчетныеАктивыЕПС.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	_УчетныеАктивыЕПС КАК _УчетныеАктивыЕПС";	
	
	Если Перезаполнять Тогда
		Объект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
	Иначе
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект.ЦенныеБумаги[Выборка.НомерСтроки - 1].УчетныйАктивЕПС = Выборка.УчетныйАктивЕПС;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(РассчитатьРыночнуюСтоимость = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 КАК НомерСтроки,
		|	0 КАК Сумма,
		|	0 КАК СуммаКупона,
		|	0 КАК СуммаРынок,
		|	0 КАК СуммаКупонаРынок,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ДепозитарныйСчет = &ДепозитарныйСчет
		|				И Рынок = &Рынок) КАК ОстаткиЦенныхБумагОстатки";
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая));
	Иначе
		Запрос.УстановитьПараметр("Период", Неопределено);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарныйСчет",             Объект.ДепозитарныйСчет);
	Запрос.УстановитьПараметр("Рынок",                        Объект.Рынок);
	
	Объект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());

	Если БухгалтерскийУчет.ВедетсяУчетЕПС(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления) Тогда
		ЗаполнитьУчетныйАктивЕПСНаСервере(Истина);	
	КонецЕсли;
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	Если РассчитатьРыночнуюСтоимость Тогда
		ПересчитатьРыночнуюСтоимостьНаСервере();
	КонецЕсли;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьРыночнуюСтоимость(ИдСтрокиКорзины = Неопределено, ИмяКорзины = "ЦенныеБумаги", Отказ = Ложь, РасшифровкаРасчета = Неопределено)

	// Проверяем, что заведены настройки оценки, и подгружаем файл с оценочной стоимостью, предоставленной клиентом
	
	ОшибкаРасчетаРыночнойСтоимости = Ложь;
	
	ЦельРасчета				= ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении");
	НастройкиОценки			= РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета);
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "'", , , , ОшибкаРасчетаРыночнойСтоимости);
		
	ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = ПредопределенноеЗначение("Справочник.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом") Тогда
		
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
			АдресТаблицыСтоимостей = РаботаСВнешнимиСистемамиКлиентСервер.ВыбратьФайлОценочнойСтоимостиПредоставленнойКлиентом(
				Объект.СчетДоверительногоУправления, Объект.Дата, Ложь, ЭтаФорма.УникальныйИдентификатор);
			Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
				ОшибкаРасчетаРыночнойСтоимости = Истина;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		АдресТаблицыСтоимостей = Неопределено;
		
	КонецЕсли;
	
	Если ОшибкаРасчетаРыночнойСтоимости Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рыночная стоимость не рассчитана.", , , , Отказ);		
		Возврат;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);	
	КонецЕсли;
	
	// Пересчет рыночной стоимости

	ПересчитатьРыночнуюСтоимостьНаСервере(ИдСтрокиКорзины, ИмяКорзины, РасшифровкаРасчета);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРыночнуюСтоимостьНаСервере(ИдСтрокиКорзины = Неопределено, ИмяКорзины = "ЦенныеБумаги", РасшифровкаРасчета = Неопределено)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(Объект, "ЦенныеБумаги", АдресТаблицыСтоимостей, ИдСтрокиКорзины, , , РасшифровкаРасчета);
	
	Если РасшифровкаРасчета = Неопределено Тогда	
	
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины, ИмяКорзины);
		
	Иначе
		
		#Область Формирование_отчета_по_расшифровке_расчета_стоимости_бумаги
		
		Если РасшифровкаРасчета.Операции.Количество() = 0 Тогда
			
			РасшифровкаРасчета = Неопределено;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета стоимости для варианта '" + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости + "' не реализована");	

		Иначе

			Отчет = Новый ТабличныйДокумент;
			
			ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Вариант расчета справедливой стоимости: " + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости, , , Отчет);
			ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
			
			РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
			
			РасшифровкаРасчета = Отчет;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПартий(Регистратор, ЦеннаяБумага)
	
	СписокПартий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагРасходные.Количество КАК Количество,
		|	БухПартииЦенныхБумагРасходные.СтоимостьКупона + БухПартииЦенныхБумагРасходные.ПереоценкаКупона КАК СуммаКупона,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагРасходные
		|		ПО БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагРасходные.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагРасходные.СтрокаПартии
		|			И (БухПартииЦенныхБумагРасходные.Регистратор = &Регистратор)
		|			И (БухПартииЦенныхБумагРасходные.ЦеннаяБумага = &ЦеннаяБумага)
		|			И (БухПартииЦенныхБумагРасходные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|			И (БухПартииЦенныхБумагРасходные.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.СтрокаПартии,
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумагРасходные.Количество,
		|	БухПартииЦенныхБумагРасходные.СтоимостьКупона + БухПартииЦенныхБумагРасходные.ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС";

	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокПартий.Добавить(Новый Структура("Партия, СтрокаПартии, Количество, СуммаКупона, УчетныйАктивЕПС", Выборка.Партия, Выборка.СтрокаПартии, Выборка.Количество, Выборка.СуммаКупона, Выборка.УчетныйАктивЕПС), Строка(Выборка.Партия) + ". Строка партии:" +  Выборка.СтрокаПартии);
	КонецЦикла;
	
	Возврат СписокПартий;
	
КонецФункции	

