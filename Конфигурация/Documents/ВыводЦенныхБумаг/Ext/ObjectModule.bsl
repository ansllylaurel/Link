				ПараметрыНачисления.Вставить("Аналитика",			АналитикаДисконта);
				
				БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				Если НЕ ВыборкаДетальныеЗаписи.ВключатьРасходыПоПокупкеВСтоимость Тогда
					// комиссии по покупке
					ПараметрыНачисления.Вставить("ДоходРасход",		-ВыборкаДетальныеЗаписи.РасходыПриПокупкеСНачалаГода);
					
					ПараметрыНачисления.Вставить("СчетДоходов",		ВыборкаДетальныеЗаписи.СчетУчетаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("СчетРасходов",	ВыборкаДетальныеЗаписи.СчетУчетаРасходовОтОпераций);
					
					ПараметрыНачисления.Вставить("АналитикаДоходов",	ВыборкаДетальныеЗаписи.АналитикаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("АналитикаРасходов",	ВыборкаДетальныеЗаписи.АналитикаРасходовОтОпераций);
					
					Если ТипЗнч(ПараметрыНачисления.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
						ПараметрыНачисления.Вставить("Партия",	ПараметрыНачисления.Партия.Основание);
					КонецЕсли;
					
					БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда // ооочень редкая штука, поэтому вытащил в отдельный запрос
		Если ПроизошлоВосстановлениеРезерва Тогда
			БухгалтерскийУчетЕПС.ЗакрытьДоходыРасходыпоРезервамСПартиямиНаЛицевыхСчетах(ЭтотОбъект);
		КонецЕсли;
		Если БылиВалютныеБумаги Тогда
			ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записать();
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоКурсовымРазницамЦенныхБумагСПартиямиНаЛицевыхСчетах(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
	// Списываем дебиторку по ЦБ и купону
	Если ЭтотОбъект.Дата < ДатаНачалаСписанияДебиторкиПоЦБИКупону() Тогда
		Возврат;
	КонецЕсли;
	
	#Область СписаниеДЗ_по_ЦБ_и_Купону
	
	// Проверяем ценные бумаги с флагом "СписыватьДебиторку"
	Запрос = Новый Запрос;
	
	Если ПоместитьЦенныеБумагиДляСписанияДебиторкиВМенеджерВременныхТаблиц(Запрос) = Ложь Тогда
		//Нет строк с флагом
		Возврат;
	КонецЕсли;
			
