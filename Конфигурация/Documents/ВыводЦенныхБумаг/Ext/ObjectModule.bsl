		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета, "Вывод ценных бумаг");

		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = СчетДоверительногоУправления;
		
		// кредит
		Проводка.СчетКт = УчетныйАктив.СчетУчета;
		Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		Проводка.КоличествоКт = ВыборкаДетальныеЗаписи.Количество;
		Проводка.ВалютаКт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.Сумма;;
		Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
		
		// ПЕРЕОЦЕНКА
		Если ВыборкаДетальныеЗаписи.СуммаПереоценки <> 0 Тогда
			
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"Переоценка", -ВыборкаДетальныеЗаписи.СуммаПереоценки, -ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета, ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВалютаНоминала, Ссылка);
			БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			
		КонецЕсли;
		
		// ***** ИНДЕКСАЦИЯ НОМИНАЛА *****			
		Если ВыборкаДетальныеЗаписи.СуммаИндексацииНоминала <> 0 Тогда 
			
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"ИндексацияНоминала", -ВыборкаДетальныеЗаписи.СуммаИндексацииНоминала, -ВыборкаДетальныеЗаписи.СуммаИндексацииНоминала, ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВалютаНоминала, Ссылка);
			БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
		КонецЕсли;
		
		// КОРРЕКТИРОВКА
		Если ВыборкаДетальныеЗаписи.СуммаКорректировкиЭСП <> 0 Тогда
			
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"КорректировкаЭСП", -ВыборкаДетальныеЗаписи.СуммаКорректировкиЭСП, -ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета, ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВалютаНоминала, Ссылка);
			БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СуммаРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0 Тогда
			
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"РазницаПервоначальногоПризнания", -ВыборкаДетальныеЗаписи.СуммаРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, -ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВалютаНоминала, Ссылка);
			БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);

		КонецЕсли;
		
		// КУПОН ЦЕННОЙ БУМАГИ
		Если ВыборкаДетальныеЗаписи.СуммаКупона <> 0 Тогда
			
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета, "Вывод ценных бумаг");

			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.договоры = СчетДоверительногоУправления;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			Проводка.ВалютаКт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.СуммаКупона;
			Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
			
		КонецЕсли;
		
		// НАЧИСЛЕННЫЙ КУПОН
		Если ВыборкаДетальныеЗаписи.СуммаКупонаНачисленного <> 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СуммаКупонаНачисленного, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета, "Вывод ценных бумаг");

			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = СчетДоверительногоУправления;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
