
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		ЗаполнитьНаОснованииПоручения(ДанныеЗаполнения);		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ЭтотОбъект.Поручение = Неопределено;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Для Каждого СтрокаЦеннойБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
	
		// Заполнение сумм в валюте учета
		Если ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаКупонаРынок) И Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаКупонаРынокВВалютеУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не заполнено поле ""Сумма купона (рынок) в валюте учета"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
				ЭтотОбъект,
				"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧГ=") + "].СуммаКупонаРынокВВалютеУчета",,
				Отказ
			);
		КонецЕсли;
		
	КонецЦикла;

	ЗамещениеЦеннымиБумагами =
		ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ЗамещениеЦеннымиБумагами", ЭтотОбъект.Ссылка);
		
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ЗамещениеЦеннымиБумагами", ЗамещениеЦеннымиБумагами);		
	
	Если (ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет 
			Или (ЭтотОбъект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") И ЭтотОбъект.Дата >= '20230405'))
		И Не ЗначениеЗаполнено(ЗамещениеЦеннымиБумагами)
	Тогда
		ПроверяемыеРеквизиты.Добавить("Поручение");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// Блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) И Не РаботаСДокументами.ПройденаОтложеннаяСверкаСоСпискомНедействительныхПаспортовПриВыводеАктивов(ЭтотОбъект) Тогда
			Отказ = Истина;	
		КонецЕсли;
		
		РаботаСДокументами.ПроверитьДатуИсполненияПоручения(ЭтотОбъект, Отказ);
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ДополнительныеСвойства.ЗамещениеЦеннымиБумагами) Тогда
			
			// Замещение ценной бумаги подразумевает создание связанных через доп. сведения документов
			// ввода и вывода ценных бумаг. Поручение при этом не заполняется
			Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В режиме 'Замещение ценных' бумаг поручение не должно быть заполнено", ЭтотОбъект, "Поручение",, Отказ);
			КонецЕсли;
			
			// Организация и счет д/у в выводе и вводе должны совпадать
			РеквизитыЗамещения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ДополнительныеСвойства.ЗамещениеЦеннымиБумагами, "Организация, СчетДоверительногоУправления");
			
			Если РеквизитыЗамещения.Организация <> ЭтотОбъект.Организация Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В доп. сведении 'Замещение ценных бумаг' указан документ с другой организацией", ЭтотОбъект,,, Отказ);
			КонецЕсли;
			Если РеквизитыЗамещения.СчетДоверительногоУправления <> ЭтотОбъект.СчетДоверительногоУправления Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В доп. сведении 'Замещение ценных бумаг' указан документ с другим счетом д/у", ЭтотОбъект,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		// Вывод по поручению только при выводе всех активов
		Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) И ТипЗнч(ЭтотОбъект.Поручение) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
			И Не ЭтотОбъект.Поручение.ВыводВсехАктивов Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание документа 'Вывод ценных бумаг' на основании документа 'Поручение на вывод денежных средств' возможен только при установке флага 'Вывод всех активов'!", ЭтотОбъект, "Поручение",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Контрагент) И ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизиита [Контрагент]!", ЭтотОбъект, "Контрагент",, Отказ);
		КонецЕсли;

		// Проверка заполнения полей ТЧ
		УчетРыночнойСтоимостиАктивов = (ЭтотОбъект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));	
		
		Для Каждого СтрокаЦеннойБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
	
			// Проверка заполнения рыночной стоимости
			
			Если УчетРыночнойСтоимостиАктивов Тогда 
				
				Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынок) ИЛИ Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынокВВалютеУчета) Тогда
					
					РазрешенаНулеваяСтоимость = СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт
						ИЛИ СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Погашена
						ИЛИ СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ОценочнаяЦена
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Доли;
					
					Если Не РазрешенаНулеваяСтоимость Тогда
					
						Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынок) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
								"Не заполнено поле ""Сумма (рынок)"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
								ЭтотОбъект,
								"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].СуммаРынок",,
								?(СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена, Ложь, Отказ)
							);
						КонецЕсли;				
						
						Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынокВВалютеУчета) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
								"Не заполнено поле ""Сумма (рынок) в валюте учета"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
								ЭтотОбъект,
								"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].СуммаРынокВВалютеУчета",,
								?(СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена, Ложь, Отказ)
							);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЕсли;
			
			// Проверка количества бумаг
			
			Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.Количество) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Не заполнено поле ""Количество"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
					ЭтотОбъект,
					"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].Количество",,
					Отказ
				);
			КонецЕсли;				
			
			Если ЗначениеЗаполнено(СтрокаЦеннойБумаги.УчетныйАктивЕПС)						// указан учетный актив ЕПС
				И НЕ СтрокаЦеннойБумаги.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость	// это актив по СС
				И ЗначениеЗаполнено(СтрокаЦеннойБумаги.Партия) Тогда						// указана партия
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Нельзя заполнять реквизит 'Партия' для бумаг по справедливой стоимости: строка " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
					ЭтотОбъект,
					"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].Партия",,
					Отказ
				);
			КонецЕсли;
			
		КонецЦикла;

		Если Не Отказ Тогда
			Отказ = Не РаботаСДокументами.РазрешенВыводАктивовКонтрагенту(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать                       = Истина;
	Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать                 = Истина;
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать           = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать 		 = Истина;

	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		// остатки ц/б
		Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();
		
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		
		// задолженность по поручению
		Если ЗначениеЗаполнено(ЭтотОбъект.Поручение)
			И НЕ ЭтотОбъект.Поручение.ВыводВсехАктивов Тогда
			Движение = Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Поручение                    = ЭтотОбъект.Поручение;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.Поручение.Валюта;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
						
			// в поручении на вывод ц/б суммы не заполняются
			Движение.Сумма       = 0;
			Движение.СуммаКупона = 0;
		КонецЕсли;
		
		// операции с ц/б
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		
		Движение.Операция                     = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
		Движение.Основание                    = ЭтотОбъект.Поручение;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.ДатаПоставки                 = ЭтотОбъект.Дата;
		Движение.ДатаОперации                 = ЭтотОбъект.Дата;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		Движение.СтрокаПартии				  = СтрокаЦенныеБумаги.НомерСтроки;
		
	КонецЦикла;
	
    // вводы/выводы активов в валюте учета (рыночная стоимость)
    СформироватьДвиженияАктивовВВалютеУчета();               
	
	Движения.Записать();
	
	// Списываем дебиторку по ЦБ и купону
	Если ЭтотОбъект.Дата >= ДатаНачалаСписанияДебиторкиПоЦБИКупону() Тогда
		СписатьДебиторскуюЗадолженностьПоПогашениюЦБИКупона(Отказ); // Внимание! Эта процедура должна быть после СформироватьДвиженияАктивовВВалютеУчета, т.к. в последней движения регистра ввода/вывода активов очищаются
	КонецЕсли;
	
	// проверим отрицательные остатки
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Поручение)
		И ТипЗнч(ЭтотОбъект.Поручение) <> Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
		И НЕ ЭтотОбъект.Поручение.ВыводВсехАктивов Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоЦеннымБумагамПоПоручениям(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	// Вводы/выводы активов в валюте учета (балансовая стоимость)
	
	СформироватьДвиженияАктивовВВалютеУчета();               	
	
	// Проводки
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	АналитикаТела							 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела					 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный				 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный				 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 						 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта						 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаРазницыПервоначальногоПризнания = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
	АналитикаИндексацииНоминала				 = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	АналитикаПросроченнаяЗадолженностьКупона = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок;

	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
		
	Если НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчетаОбщие, Отказ);
		Возврат;
	
	КонецЕсли;
	
	#Область Текст_Основного_Запроса
	
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.КорректировкаЭСП = 0
		|				И БухПартииЦенныхБумаг.ДисконтПремияНачисленный = 0
		|				И БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.Переоценка КАК Переоценка,
		|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток < 0 КАК Дисконт,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК ИндексацияНоминалаОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценениеОстаток
		|ПОМЕСТИТЬ _ОстаткиПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДоДокумента,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ВидУчета = &ВидУчета
		|				И (УчетныйАктивЕПС, ЦеннаяБумага, Партия, СтрокаПартии) В
		|					(ВЫБРАТЬ
		|						_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|						_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|						_ДвиженияПартий.Партия КАК Партия,
		|						_ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
		|					ИЗ
		|						_ДвиженияПартий КАК _ДвиженияПартий)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт КАК Дисконт,
		|	_ДвиженияПартий.Перекурсовка КАК Перекурсовка,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.ДисконтПремияНачисленныйОстаток, 0)) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.ПереоценкаОстаток, 0)) КАК ПереоценкаОстаток,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.ИндексацияНоминалаОстаток, 0)) КАК ИндексацияНоминалаОстаток,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.КорректировкаЭСПОстаток, 0)) КАК КорректировкаЭСПОстаток,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток, 0)) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	СУММА(_ДвиженияПартий.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(_ДвиженияПартий.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.Переоценка) КАК Переоценка,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Резерв,
		|	СУММА(ЕСТЬNULL(_ОстаткиПартий.СуммаРезервовПодОбесценениеОстаток, 0)) КАК СуммаРезервовПодОбесценениеОстаток,
		|	СУММА(_ДвиженияПартий.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартий.УчетныйАктивЕПС
		|			И _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ДвиженияПартий.Партия = _ОстаткиПартий.Партия
		|			И _ДвиженияПартий.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&ДоДокумента,
		|				Счет В
		|					(ВЫБРАТЬ
		|						Справочник.УчетныеАктивыЕПС.СчетУчетаРезервов
		|					ИЗ
		|						Справочник.УчетныеАктивыЕПС),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО _ДвиженияПартий.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияПартий.УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	_ДвиженияПартий.Перекурсовка";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		БухПартииЦенныхБумаг = РезультатЗапроса.Выгрузить();
		
		МассивУчетныхАктивов = Новый Массив;
		
		Для Каждого СтрокаПартии Из БухПартииЦенныхБумаг Цикл
			
			ВалютаНоминала = СтрокаПартии.ЦеннаяБумага.ВалютаНоминала;
			УчетныйАктив = СтрокаПартии.УчетныйАктивЕПС;
			
			Если СтрокаПартии.Перекурсовка Тогда 
				ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
						+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
						+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,"
						+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
					СтрокаПартии.ЦеннаяБумага, УчетныйАктив,
					СтрокаПартии.СтоимостьВВалютеУчета, СтрокаПартии.СтоимостьКупонаВВалютеУчета, СтрокаПартии.ПереоценкаВВалютеУчета, СтрокаПартии.ПереоценкаКупонаВВалютеУчета,
					СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.КорректировкаЭСПВВалютеУчета, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
					СтрокаПартии.ДисконтПремияНачисленныйОстаток,СтрокаПартии.ПереоценкаОстаток,СтрокаПартии.КорректировкаЭСПОстаток,СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
				
				БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);		
				
				Продолжить;
				
			КонецЕсли;
			
			
			Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
				МассивУчетныхАктивов.Добавить(УчетныйАктив);
			КонецЕсли;
			
			Если СтрокаПартии.Переоценка<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"Переоценка", СтрокаПартии.Переоценка, СтрокаПартии.ПереоценкаВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, СтрокаПартии.ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				Продолжить;
			КонецЕсли;
			
			// Дооцениваем купон
			СуммаПереоценкиКупона = СтрокаПартии.ПереоценкаКупона;
			Если СуммаПереоценкиКупона<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Аналитика",
					СтрокаПартии.ПереоценкаКупонаВВалютеУчета, СуммаПереоценкиКупона, ВалютаУчета, УчетныйАктив, СтрокаПартии.ЦеннаяБумага, ВалютаНоминала, АналитикаКупонНачисленный);
				БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			//дооценки перед расходом купона, дисконта и т.п.
			Если СтрокаПартии.ДисконтПремияНачисленный<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
					СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.ДисконтПремияНачисленный, ВалютаУчета, УчетныйАктив, СтрокаПартии.ЦеннаяБумага, ВалютаНоминала);
				ПараметрыНачисления.Вставить("Аналитика", ?(СтрокаПартии.ДисконтПремияНачисленный<0, АналитикаПремии, АналитикаДисконта));
				БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			
			Если СтрокаПартии.КорректировкаЭСП<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"КорректировкаЭСП", СтрокаПартии.КорректировкаЭСП, СтрокаПартии.КорректировкаЭСПВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, СтрокаПартии.ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
				
			КонецЕсли;
			
			Если СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
