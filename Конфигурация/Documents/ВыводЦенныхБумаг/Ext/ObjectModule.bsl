				ПараметрыОплаты.Вставить("СчетУчета",				ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиА);
			Иначе
				ПараметрыОплаты.Вставить("СчетУчета",				ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиП);
			КонецЕсли;
			ПараметрыОплаты.Вставить("Стоимость",					ВыборкаДетальныеЗаписи.Переоценка);
			ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
			
			СформироватьПроводкуСписания(ЭтотОбъект, УчетныйРегистр, ПараметрыОплаты, Отказ);
			
			// Корректировка ЭСП
			ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка());
			Если ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета > 0 Тогда
				ПараметрыОплаты.Вставить("СчетУчета",				ВыборкаДетальныеЗаписи.СчетУчетаКорректировокА);
			Иначе
				ПараметрыОплаты.Вставить("СчетУчета",				ВыборкаДетальныеЗаписи.СчетУчетаКорректировокП);
			КонецЕсли;
			ПараметрыОплаты.Вставить("Стоимость",					ВыборкаДетальныеЗаписи.КорректировкаЭСП);
			ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета);
			
			СформироватьПроводкуСписания(ЭтотОбъект, УчетныйРегистр, ПараметрыОплаты, Отказ);
			
			Если ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценение > 0 Тогда
				
				ПроизошлоВосстановлениеРезерва = Истина;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценение, "Списание резерва");	
				
				Проводка.СчетДт = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаРезервов;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.Резервы	= Справочники.Резервы.РезервОбесценениеУбытки12Месяцев; // техдолг!
				
				Проводка.ВалютаДт			= ВалютаУчета;
				
				Если ЭтоАктивДляПродажи Тогда
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУРезервовДляБумагДляПродажиНаСчете106(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС, Ложь);
					Проводка.ВалютаДт			= ВыборкаДетальныеЗаписи.ВалютаНоминала; // резервы на валютном 106м
