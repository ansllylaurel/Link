		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаДоходовПервоначальногоПризнания КАК АналитикаДоходовПервоначальногоПризнания,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаРасходовПервоначальногоПризнания КАК АналитикаРасходовПервоначальногоПризнания,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт КАК СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт КАК СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт КАК СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Кт КАК СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Кт,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаТребованийПоПоставке КАК СчетУчетаТребованийПоПоставке,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке КАК СчетУчетаОбязательствПоПоставке,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток КАК КорректировкаЭСПВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаПоложительнаяОстаток КАК ПереоценкаСНачалаГодаПоложительнаяОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупкиОстаток
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Рынок = БухПартииЦенныхБумагОстатки.Рынок
		|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетныйАктивЕПС,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии";
	
	Запрос.УстановитьПараметр("Регистратор",					ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",						Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	ПроизошлоВосстановлениеРезерва = Ложь;
	ТекущаяПартия = Неопределено;
	ПерекурсовкаОтраженнаяКакПереоценка = 0;
	БылиВалютныеБумаги = Ложь;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Партия <> ТекущаяПартия Тогда
			ТекущаяПартия = ВыборкаДетальныеЗаписи.Партия;
			ПерекурсовкаОтраженнаяКакПереоценка = 0;
		КонецЕсли;	
		
		ЭтоАктивДляПродажи = (ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
								ИЛИ ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
								
		Если ВалютаУчета <> ВыборкаДетальныеЗаписи.ВалютаНоминала Тогда
			БылиВалютныеБумаги = Истина;
		КонецЕсли;
								
		Если ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			
			Перекурсовка = Ложь;
			Если ВалютаУчета <> ВыборкаДетальныеЗаписи.ВалютаНоминала
				И ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный = 0
				И ВыборкаДетальныеЗаписи.ПереоценкаКупона = 0
				И ВыборкаДетальныеЗаписи.Переоценка = 0 
				И ВыборкаДетальныеЗаписи.КорректировкаЭСП = 0 Тогда
			
				Перекурсовка = Истина;
			
			КонецЕсли;
			
			ПараметрыНачисления = Новый Структура;
			
			ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
			
			ПараметрыНачисления.Вставить("ЦеннаяБумага",	ВыборкаДетальныеЗаписи.ЦеннаяБумага);
			ПараметрыНачисления.Вставить("ВалютаНоминала",	ВыборкаДетальныеЗаписи.ВалютаНоминала);
			ПараметрыНачисления.Вставить("Партия",			ВыборкаДетальныеЗаписи.Партия);
			ПараметрыНачисления.Вставить("СтрокаПартии",	ВыборкаДетальныеЗаписи.СтрокаПартии);
			ПараметрыНачисления.Вставить("Количество",		0);
			
			Если НЕ Перекурсовка Тогда
				
				ПараметрыНачисления.Вставить("ПроверитьПарные",	"");
				
				// дисконт-премия	
				ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчета);
				
				ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.СчетУчета);
				Если ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный < 0 Тогда
					ПараметрыНачисления.Вставить("Содержание",			"Списание премии");
					ПараметрыНачисления.Вставить("Аналитика",			АналитикаПремии);
					ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы04);
					ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.АналитикаСписанияПремии);
				Иначе
					ПараметрыНачисления.Вставить("Содержание",			"Начисление дисконта");
					ПараметрыНачисления.Вставить("Аналитика",			АналитикаДисконта);
					ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы01);
					ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.АналитикаПроцентныхДоходов);
				КонецЕсли;
				
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
					
				// ННКД	
				ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ПереоценкаКупона);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета);
				
				ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.СчетУчета);
				ПараметрыНачисления.Вставить("Содержание",			"Переоценка купона");
				ПараметрыНачисления.Вставить("Аналитика",			АналитикаКупонНачисленный);
				ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
				ПараметрыНачисления.Вставить("ГФУ",				ВыборкаДетальныеЗаписи.АналитикаПроцентныхДоходов);
				
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				// переоценка
				БалансоваяПереоценка = ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
				БалансоваяПереоценкаВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаОстаток;
				
				ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.Переоценка);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
				ПараметрыНачисления.Вставить("СуммаСНачалаГода",	ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаОстаток + ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
				ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
				ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
				
				ПараметрыНачисления.Вставить("Содержание",			"Переоценка");
				ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
				
				ПараметрыНачисления.Вставить("ПроверитьПарные",		"Переоценка");
				
				Если (БалансоваяПереоценкаВВалютеУчета > 0)ИЛИ(БалансоваяПереоценкаВВалютеУчета = 0 И ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета > 0) Тогда
					ПараметрыНачисления.Вставить("СчетУчета",		ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиА);
					ПараметрыНачисления.Вставить("СчетУчетаПарный",	ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиП);
				Иначе
					ПараметрыНачисления.Вставить("СчетУчета",		ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиП);
					ПараметрыНачисления.Вставить("СчетУчетаПарный",	ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиА);
				КонецЕсли;
				
				Если (ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаОстаток > 0)ИЛИ(ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаОстаток = 0 И ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета > 0) Тогда
					ПараметрыНачисления.Вставить("СчетДоходовРасходов", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС));
					ПараметрыНачисления.Вставить("ГФУ",				ВыборкаДетальныеЗаписи.АналитикаДоходовОтПереоценки);
					
					ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС, Ложь));
					ПараметрыНачисления.Вставить("ГФУПарный",		ВыборкаДетальныеЗаписи.АналитикаРасходовОтПереоценки);
				Иначе
					ПараметрыНачисления.Вставить("СчетДоходовРасходов",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС, Ложь));
					ПараметрыНачисления.Вставить("ГФУ",				ВыборкаДетальныеЗаписи.АналитикаРасходовОтПереоценки);
					
					ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС));
					ПараметрыНачисления.Вставить("ГФУПарный",		ВыборкаДетальныеЗаписи.АналитикаДоходовОтПереоценки);
				КонецЕсли;
					
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				// корректировка ЭСП
