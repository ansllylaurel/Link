	ПараметрыВывода.Вставить("СчетВывода",										ПланыСчетов.Единый.АктивыВДУ03);            	
	ПараметрыВывода.Вставить("ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов",	НастройкиУчетаОбщие.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов);
	ПараметрыВывода.Вставить("ВалютаУчета",										ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета")); 

	ДополнительнаяАналитикаДЗПоТелу = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
	
	ВыборкаЦенныеБумаги = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦенныеБумаги.Следующий() Цикл
		
		КоличествоВВыводе = ВыборкаЦенныеБумаги.КоличествоВВыводе;
		ВыборкаДетальныеЗаписи = ВыборкаЦенныеБумаги.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.КоличествоОстаток = 0 Тогда
				Продолжить;
			КонецЕсли;
							
			КоэффициентВывода = КоличествоВВыводе / ВыборкаДетальныеЗаписи.КоличествоОстаток;
						
			ПараметрыВывода.Вставить("СчетУчета",				ВыборкаДетальныеЗаписи.Счет);			
			ПараметрыВывода.Вставить("Аналитика",				ВыборкаДетальныеЗаписи.ДополнительнаяАналитика);
			ПараметрыВывода.Вставить("Содержание",				"Вывод дебиторской задолженности по погашению " + ?(ВыборкаДетальныеЗаписи.ДополнительнаяАналитика = ДополнительнаяАналитикаДЗПоТелу, "ценной бумаги", "купона"));
			ПараметрыВывода.Вставить("Сумма",					Окр(ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток * КоэффициентВывода, 2, 1));
			ПараметрыВывода.Вставить("СуммаВВалютеУчета",		Окр(ВыборкаДетальныеЗаписи.СуммаОстаток * КоэффициентВывода, 2, 1));
			ПараметрыВывода.Вставить("Субконто1",				ВыборкаДетальныеЗаписи.Субконто1);
			ПараметрыВывода.Вставить("Субконто2",				ВыборкаДетальныеЗаписи.Субконто2);  			
			ПараметрыВывода.Вставить("ВалютаОстатка",			ВыборкаДетальныеЗаписи.Валюта);
			ПараметрыВывода.Вставить("ПартииНаЛицевыхСчетах",	Ложь);
			
			СформироватьПроводкуСписанияДебиторскойЗадолженностиЕПС(ЭтотОбъект, УчетныйРегистр, ПараметрыВывода)
						
		КонецЦикла;
	
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	СчетРасчетов = БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Неопределено);
		
	Если Не ЗначениеЗаполнено(СчетРасчетов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить счет расчетов",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ЕстьСубконтоКонтрагенты = (СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
	
	Если ЕстьСубконтоКонтрагенты Тогда
		КонтрагентДляПроводок = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	КонецЕсли;
	
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
	|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
	|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
	|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
	|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
	|	СУММА(БухПартииЦенныхБумаг.СуммаЧастичногоПогашения) КАК СуммаЧастичногоПогашения,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьПокупки) КАК СтоимостьПокупки,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьПокупкиКупона) КАК СтоимостьПокупкиКупона,
	|	СУММА(БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости) КАК РасходыПриПокупкеВСтоимости,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВСтоимости) КАК ПереоценкаВСтоимости,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВСтоимости) КАК ПереоценкаКупонаВСтоимости,
	|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
	|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценениеКупона) КАК СуммаРезервовПодОбесценениеКупона,
	|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПоСомнительнымДолгам) КАК СуммаРезервовПоСомнительнымДолгам,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумаг.Количество = 0
	|				И БухПартииЦенныхБумаг.Стоимость = 0
	|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
	|				И БухПартииЦенныхБумаг.Переоценка = 0
	|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Перекурсовка,
	|	БухПартииЦенныхБумаг.Рынок КАК Рынок
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|ГДЕ
	|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
	|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
	|	БухПартииЦенныхБумаг.ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.ВидДвижения,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумаг.Количество = 0
	|				И БухПартииЦенныхБумаг.Стоимость = 0
	|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
	|				И БухПартииЦенныхБумаг.Переоценка = 0
	|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	БухПартииЦенныхБумаг.Рынок";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЦеннаяБумага = Выборка.ЦеннаяБумага;
		
		Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
			Валюта = ЭтотОбъект.Организация.ВалютаУчета;
		Иначе
			Валюта = ЦеннаяБумага.ВалютаНоминала;
		КонецЕсли;

		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ЦеннаяБумага);
		УчетныйАктивКупона = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ЦеннаяБумага, Истина);

		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);	
			
		НастройкиУчетаКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктивКупона,
			УчетныйРегистр);
			
		ВалютныйУчет = НастройкиУчетаАктива.СчетУчета.Валютный;

		Если Выборка.Перекурсовка Тогда
				
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЦеннаяБумага, Выборка.Рынок,
				Выборка.СтоимостьВВалютеУчета, Выборка.СтоимостьКупонаВВалютеУчета, Выборка.ПереоценкаВВалютеУчета, Выборка.ПереоценкаКупонаВВалютеУчета);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчета);
			СчетаУчета.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчета);
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценки);
			СчетаУчетаПереоценки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчетаПереоценки);
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
			АналитикаПерекурсовки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.АналитикаПерекурсовки);
			
			ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
			
			БухгалтерскийУчет.ДвижениеПерекурсовки(ЭтотОбъект, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // Переоценка купона или тела
			
			Параметры = Новый Структура("УчетныйРегистр,ЦеннаяБумага,ВидСубконтоУчетаЦеннойБумаги,ВалютаНоминала,ОбращаетсяНаОРЦБ,Описание",
									УчетныйРегистр,
									ЦеннаяБумага,
									ВидСубконтоУчетаЦеннойБумаги,
									Валюта,
									СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ,
									"Переоценка");
									
			Если Выборка.СтоимостьВВалютеУчета <> 0 Тогда
			
				Параметры.Вставить("АналитикаДоходовОтПереоценки",	НастройкиУчетаАктива.АналитикаДоходовОтПереоценки);
				Параметры.Вставить("СчетУчета",						НастройкиУчетаАктива.СчетУчета);
				Параметры.Вставить("СуммаВВалютеНоминала",			Выборка.Стоимость);
				Параметры.Вставить("СуммаВВалютеУчета",			 	Выборка.СтоимостьВВалютеУчета);
				Параметры.Вставить("ВалютныйУчет",					НастройкиУчетаАктива.СчетУчета.Валютный);
				
				БухгалтерскийУчет.ДвижениеПереоценки(ЭтотОбъект, Параметры);
				
			КонецЕсли;									
									
			Если Выборка.ПереоценкаВВалютеУчета <> 0 Тогда
			
				Параметры.Вставить("АналитикаДоходовОтПереоценки",	НастройкиУчетаАктива.АналитикаДоходовОтПереоценки);
				Параметры.Вставить("СчетУчета",						НастройкиУчетаАктива.СчетУчетаПереоценки);
				Параметры.Вставить("СуммаВВалютеНоминала",			Выборка.Переоценка);
				Параметры.Вставить("СуммаВВалютеУчета",				Выборка.ПереоценкаВВалютеУчета);
				Параметры.Вставить("ВалютныйУчет",					НастройкиУчетаАктива.СчетУчетаПереоценки.Валютный);
				
				БухгалтерскийУчет.ДвижениеПереоценки(ЭтотОбъект, Параметры);
				
			КонецЕсли;									
									
			Если Выборка.СтоимостьКупонаВВалютеУчета <> 0 Тогда
			
				Параметры.Вставить("АналитикаДоходовОтПереоценки",	НастройкиУчетаКупона.АналитикаДоходовОтПереоценки);
				Параметры.Вставить("СчетУчета",						НастройкиУчетаКупона.СчетУчета);
				Параметры.Вставить("СуммаВВалютеНоминала",		 	Выборка.СтоимостьКупона);
				Параметры.Вставить("СуммаВВалютеУчета",				Выборка.СтоимостьКупонаВВалютеУчета);
				Параметры.Вставить("ВалютныйУчет",					НастройкиУчетаКупона.СчетУчета.Валютный);
				
				БухгалтерскийУчет.ДвижениеПереоценки(ЭтотОбъект, Параметры);
				
			КонецЕсли;									
			
			Если Выборка.ПереоценкаКупонаВВалютеУчета <> 0 Тогда
			
				Параметры.Вставить("АналитикаДоходовОтПереоценки",	НастройкиУчетаКупона.АналитикаДоходовОтПереоценки);
				Параметры.Вставить("СчетУчета",						НастройкиУчетаКупона.СчетУчетаПереоценки);
				Параметры.Вставить("СуммаВВалютеНоминала",			Выборка.ПереоценкаКупона);
				Параметры.Вставить("СуммаВВалютеУчета",				Выборка.ПереоценкаКупонаВВалютеУчета);
				Параметры.Вставить("ВалютныйУчет",					НастройкиУчетаКупона.СчетУчетаПереоценки.Валютный);
				
				БухгалтерскийУчет.ДвижениеПереоценки(ЭтотОбъект, Параметры);
				
			КонецЕсли;									
			
		Иначе
			
			// ТЕЛО
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Вывод ценной бумаги");
			
			// дебет
			Проводка.СчетДт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
			Если ВалютныйУчет Тогда
				Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
				Проводка.ВалютаКт = Валюта;
			КонецЕсли;
			
			
			Если Выборка.ПереоценкаВВалютеУчета <> 0 Тогда
			
				//ПЕРЕОЦЕНКА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаВВалютеУчета, "Вывод ценной бумаги");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;

				// кредит		
				Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.Переоценка;
					Проводка.ВалютаКт = Валюта;
				КонецЕсли;
			
			КонецЕсли;
			
			Если Выборка.СтоимостьКупонаВВалютеУчета <> 0 Тогда
			
				//КУПОН
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьКупонаВВалютеУчета, "Вывод ценной бумаги");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;

				// кредит		
				Проводка.СчетКт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
					Проводка.ВалютаКт = Валюта;
				КонецЕсли;
			
			КонецЕсли;
			
			Если Выборка.ПереоценкаКупонаВВалютеУчета <> 0 Тогда
			
				//КУПОН ПЕРЕОЦЕНКА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаКупонаВВалютеУчета, "Вывод ценной бумаги");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;

				// кредит		
				Проводка.СчетКт = НастройкиУчетаКупона.СчетУчетаПереоценки;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.ПереоценкаКупона;
					Проводка.ВалютаКт = Валюта;
				КонецЕсли;
			
			КонецЕсли;
			
			Если Выборка.СуммаРезервовПодОбесценение <> 0 Тогда
				// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаРезервовПодОбесценение, "Вывод резерва под обесценивание ценной бумаги");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;
				
				// кредит
				СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктив);
				
				Проводка.СчетКт = СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
			КонецЕсли;
			
			Если Выборка.СуммаРезервовПоСомнительнымДолгам <> 0 Тогда
				// РЕЗЕРВ ПОД СОМНИТЕЛЬНЫЕ ДОЛГИ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаРезервовПоСомнительнымДолгам, "Вывод резерва под сомнительные долги по ценной бумаге");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;
				
				// кредит
				СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктив);
				
				Проводка.СчетКт = СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
			КонецЕсли;
			
			Если Выборка.СуммаРезервовПодОбесценениеКупона <> 0 Тогда
				// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА ПОКУПКИ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаРезервовПодОбесценениеКупона, "Вывод резерва под обесценивание купона покупки");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				
				Если ЕстьСубконтоКонтрагенты Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
				КонецЕсли;
				
				// кредит
				СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктивКупона);
				
				Проводка.СчетКт = СчетУчета;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
			КонецЕсли;
			
			//Если Выборка.СуммаРезервовПодОбесценениеКупона <> 0 Тогда
			//	// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА НАЧИСЛЕННОГО
			//	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СуммаРезервовПодОбесценениеКупона, "Вывод резерва под обесценивание купона начисленного");
			//	
			//	// дебет
			//	Проводка.СчетДт = СчетРасчетов;
			//	
			//	Если ЕстьСубконтоКонтрагенты Тогда
			//		Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
			//	КонецЕсли;
			//	
			//	// кредит
			//	СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктивКупона);
			//	
			//	Проводка.СчетКт = СчетУчета;
			//	Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
			//	
			//КонецЕсли;
 		КонецЕсли;
	КонецЦикла;	
	
	// Списываем дебиторку по ЦБ и купону
	Если ЭтотОбъект.Дата < ДатаНачалаСписанияДебиторкиПоЦБИКупону() Тогда
		Возврат;
	КонецЕсли;
	
	#Область СписаниеДЗ_по_ЦБ_и_Купону
	
	// Проверяем ценные бумаги с флагом "СписыватьДебиторку"
	Запрос = Новый Запрос;
	
	Если ПоместитьЦенныеБумагиДляСписанияДебиторкиВМенеджерВременныхТаблиц(Запрос) = Ложь Тогда
		//Нет строк с флагом
		Возврат;
	КонецЕсли;
			
	#Область Текст_Запроса
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(БухПартииЦенныхБумагОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ _ОстаткиПартий
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = &ВидУчета
	|				И ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						_ЦБ_ВывестиДебиторку.ЦеннаяБумага
	|					ИЗ
	|						_ЦБ_ВывестиДебиторку)) КАК БухПартииЦенныхБумагОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК ЦеннаяБумага,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
	|		КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.Векселя)
	|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
	|		КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
	|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
	|		КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.Паи)
	|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
	|	КОНЕЦ КАК Эмитент
	|ПОМЕСТИТЬ _ОстаткиЗадолженности
	|ИЗ
	|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюВекселя), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюИпотечногоСертификатаУчастия), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая))
	|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)) КАК ЗадолженностиПоДенежнымСредствамОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ПериодГраница, ) КАК РеквизитыПИФСрезПоследних
	|		ПО (ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.Паи)
	|					ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухгалтерскийУчетОстатки.Счет КАК Счет,
	|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
	|	БухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
	|	ВЫБОР
	|		КОГДА БухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупона), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупонаЕврооблигации))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВыводКупона,
	|	БухгалтерскийУчетОстатки.Организация КАК Организация,
	|	БухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	БухгалтерскийУчетОстатки.Валюта КАК Валюта,
	|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЕСТЬNULL(БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстаток,
	|	ЕСТЬNULL(_ОстаткиПартий.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	_ОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ЦБ_ВывестиДебиторку.Количество КАК КоличествоВВыводе
	|ИЗ
	|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
	|			&ПериодГраница,
	|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупона), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупонаЕврооблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте)),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиЗадолженности КАК _ОстаткиЗадолженности
	|		ПО (ВЫБОР
	|				КОГДА БухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте))
	|					ТОГДА БухгалтерскийУчетОстатки.Субконто1
	|			КОНЕЦ = _ОстаткиЗадолженности.Эмитент)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
	|		ПО (ВЫБОР
	|				КОГДА БухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупона), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПогашениеКупонаЕврооблигации))
	|					ТОГДА БухгалтерскийУчетОстатки.Субконто1
	|				КОГДА БухгалтерскийУчетОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте))
	|					ТОГДА _ОстаткиЗадолженности.ЦеннаяБумага
	|			КОНЕЦ = _ОстаткиПартий.ЦеннаяБумага)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦБ_ВывестиДебиторку КАК _ЦБ_ВывестиДебиторку
	|		ПО (_ОстаткиПартий.ЦеннаяБумага = _ЦБ_ВывестиДебиторку.ЦеннаяБумага)
	|ГДЕ
	|	ЕСТЬNULL(_ОстаткиПартий.КоличествоОстаток, 0) > 0
	|	И _ОстаткиПартий.ЦеннаяБумага ЕСТЬ НЕ NULL 
	|ИТОГИ
	|	МАКСИМУМ(КоличествоВВыводе)
	|ПО
	|	ЦеннаяБумага";
	
	#КонецОбласти
	
	Если УчетныйРегистр = "НалоговыйУчет" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрБухгалтерии.БухгалтерскийУчет.Остатки", "РегистрБухгалтерии.НалоговыйУчет.Остатки");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПериодГраница", 									Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", 									ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 					ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 										Перечисления.ВидыУчета[УчетныйРегистр]);
	
	ВыборкаЦеннаяБумага = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		КоличествоВВыводе = ВыборкаЦеннаяБумага.КоличествоВВыводе;	
		ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.КоличествоОстаток = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоэффициентВывода = КоличествоВВыводе / ВыборкаДетальныеЗаписи.КоличествоОстаток;
					
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДетальныеЗаписи.СуммаОстаток * КоэффициентВывода, "Вывод дебиторской задолженности по погашению " + ?(ВыборкаДетальныеЗаписи.ВыводКупона, "купона", "ценной бумаги"));
					
			// дебет
			Проводка.СчетДт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоДт.Контрагенты = КонтрагентДляПроводок;
			КонецЕсли;
			
			// кредит				
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.Счет;
			Если ВыборкаДетальныеЗаписи.ВыводКупона Тогда
				Проводка.СубконтоКт.Облигации = ВыборкаДетальныеЗаписи.Субконто1;
				Если ВыборкаДетальныеЗаписи.Счет = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
					Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Субконто2; 
				КонецЕсли	
			Иначе
				Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Субконто1;
			КонецЕсли;
					
			Проводка.ВалютнаяСуммаКт 	= ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток * КоэффициентВывода;
			Проводка.ВалютаКт 			= ВыборкаДетальныеЗаписи.Валюта;

		КонецЦикла;
		
	КонецЦикла;
	
	#КонецОбласти

    // !!! - Временное отключение
    //
    //// вводы/выводы активов в валюте учета (балансовая стоимость)
    //СформироватьДвиженияАктивовВВалютеУчета();               
    //
    // !!! - Временное отключение (конец)
	
КонецПроцедуры

#Область Служебные_и_вспомогательные_функции

Процедура ЗаполнитьНаОснованииПоручения(Основание) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		
		Если НЕ Основание.ВыводВсехАктивов Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание документа 'Вывод ценных бумаг' на основании документа 'Поручение на движение денежных средств' возможен только при установке флага 'Вывод всех активов'!");
			ЭтотОбъект.Поручение = Основание;
			Возврат;
		КонецЕсли;
		
		ЭтотОбъект.ДепозитарныйСчет = Неопределено;
		ЭтотОбъект.ЦенныеБумаги.Очистить();
		ЭтотОбъект.Поручение = Основание;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Основание, "Организация, СчетДоверительногоУправления, Контрагент");
		
		Возврат;
		
	КонецЕсли;
	
	Если Основание.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
		ЭтотОбъект.Поручение = ""; // при заполнении из обработчика ПоручениеПриИзменении 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основанием для вывода ценных бумаг должно быть поручение с видом ""Передача""!");
		Возврат;
	КонецЕсли; 
			
	ЭтотОбъект.Поручение = Основание;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Основание, "Организация, СчетДоверительногоУправления, ДепозитарныйСчет, Рынок, Контрагент");
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
		И Основание.ВыводВсехАктивов Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение табличной части
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям.Остатки(
		|			&Период,
		|			Поручение = &Поручение
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки";
		
	Запрос.УстановитьПараметр("Период",    ?(ЭтотОбъект.ЭтоНовый(), Неопределено, ЭтотОбъект.МоментВремени()));
	Запрос.УстановитьПараметр("Поручение", Основание);
	
	ЭтотОбъект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
		
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(ЭтотОбъект, "ЦенныеБумаги");
	
КонецПроцедуры

Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// остатки ценных бумаг
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("ДепозитарныйСчет",             ЭтотОбъект.ДепозитарныйСчет);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
	
	ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
	ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага", "ЦеннаяБумага");

	// задолженности по поручениям
	Если ЗначениеЗаполнено(ЭтотОбъект.Поручение)
		И НЕ ЭтотОбъект.Поручение.ВыводВсехАктивов Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Поручение",        ЭтотОбъект.Поручение);
		ЭлементБлокировкиДанных.УстановитьЗначение("ТипЗадолженности", Перечисления.ТипыЗадолженности.кредиторская);

		ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага", "ЦеннаяБумага");
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура УстановитьБлокировки_ЗадолженостьПоДС(РезультатЗапроса)
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// Задолженности по денежным средствам
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("ТипЗадолженности",             Перечисления.ТипыЗадолженности.Дебиторская);
	
	ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапроса;
	
	ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ВидЗадолженности", "ВидЗадолженности");
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки_ЗадолженостьПоДС

Процедура СформироватьПроводкуСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ) 

	Если ПараметрыСписания.СтоимостьВВалютеУчета > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыСписания.СтоимостьВВалютеУчета, "Списание себестоимости ценной бумаги(" + Строка(ПараметрыСписания.ДополнительнаяАналитика) +")");
		
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = СчетДоверительногоУправления;
		
		Проводка.СчетКт = ПараметрыСписания.СчетУчета;
		Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
		Проводка.КоличествоКт = ПараметрыСписания.Количество;
		Проводка.ВалютаКт = ПараметрыСписания.ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = ПараметрыСписания.Стоимость;
		Проводка.ДополнительнаяАналитикаКт = ПараметрыСписания.ДополнительнаяАналитика;
		
		Проводка.Партия = ПараметрыСписания.Партия;
		Проводка.СтрокаПартии = ПараметрыСписания.СтрокаПартии;
		
	ИначеЕсли ПараметрыСписания.СтоимостьВВалютеУчета < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -ПараметрыСписания.СтоимостьВВалютеУчета, "Списание себестоимости ценной бумаги(" + Строка(ПараметрыСписания.ДополнительнаяАналитика) +")");
		
		Проводка.СчетДт = ПараметрыСписания.СчетУчета;
		Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
		Проводка.ВалютаДт = ПараметрыСписания.ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = -ПараметрыСписания.Стоимость;
		Проводка.ДополнительнаяАналитикаДт = ПараметрыСписания.ДополнительнаяАналитика;
		
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = СчетДоверительногоУправления;
		
		Проводка.Партия = ПараметрыСписания.Партия;
		Проводка.СтрокаПартии = ПараметрыСписания.СтрокаПартии;
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьПроводкуСписанияДебиторскойЗадолженностиЕПС(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки)

	Если ПараметрыПроводки.Сумма = 0 И ПараметрыПроводки.СуммаВВалютеУчета = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
	
	// Дебет
	Проводка.СчетДт = ПараметрыПроводки.СчетВывода;	
	Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
	
	Если ПараметрыПроводки.СчетВывода.Валютный Тогда
		Проводка.ВалютаДт = ПараметрыПроводки.ВалютаУчета;
		Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.Сумма;
	КонецЕсли;
	
	Если ПараметрыПроводки.ПартииНаЛицевыхСчетах Тогда
		Проводка.Партия = ПараметрыПроводки.Партия;
		Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
	КонецЕсли;
	
	// Кредит
	Если ПараметрыПроводки.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
		
		Проводка.СчетКт = ПараметрыПроводки.СчетУчета;
		
		Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.Субконто1;
		
		Проводка.ВалютаКт = ПараметрыПроводки.ВалютаОстатка;
		Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.Сумма;
		
		Проводка.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;
		
	Иначе
		
		Проводка.СчетКт = ПараметрыПроводки.СчетУчета;
		
		Проводка.СубконтоКт.Контрагенты = ПараметрыПроводки.Субконто1;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыПроводки.Субконто2;
		
		Проводка.ВалютаКт  = ПараметрыПроводки.ВалютаОстатка;
		Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.Сумма;
					
		Проводка.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура СформироватьДвиженияАктивовВВалютеУчета()
	
	// Получаем данные
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЦенныеБумаги.СуммаРынокВВалютеУчета + ЦенныеБумаги.СуммаКупонаРынокВВалютеУчета) КАК РыночнаяСтоимость,
		|	0 КАК БалансоваяСтоимость
		|ПОМЕСТИТЬ _СтоимостиАктивов
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ЦенныеБумаги
		|ГДЕ
		|	ЦенныеБумаги.Ссылка = &Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета + БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета + БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета + БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета - БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение + ВЫБОР
		|			КОГДА ВЫБОР
		|						КОГДА НастройкаПравильныйУчетПП.ЗначениеНастройки ЕСТЬ NULL
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ВЫРАЗИТЬ(НастройкаПравильныйУчетПП.ЗначениеНастройки КАК БУЛЕВО)
		|					КОНЕЦ
		|					ИЛИ БухПартииЦенныхБумаг.ЦеннаяБумага = &ОблигацияАвтодор002
		|				ТОГДА БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
		|			ИНАЧЕ БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная - БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
		|		КОНЕЦ)
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(&Период, Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПравильныйУчетПервоначальногоПризнания)) КАК НастройкаПравильныйУчетПП
		|		ПО БухПартииЦенныхБумаг.Организация = НастройкаПравильныйУчетПП.Организация
		|			И БухПартииЦенныхБумаг.ЦеннаяБумага = НастройкаПравильныйУчетПП.ЦеннаяБумага
		|			И БухПартииЦенныхБумаг.Партия = НастройкаПравильныйУчетПП.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = НастройкаПравильныйУчетПП.СтрокаПартии
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = НастройкаПравильныйУчетПП.УчетныйАктивЕПС
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_СтоимостиАктивов.РыночнаяСтоимость), 0) КАК РыночнаяСтоимость,
		|	ЕСТЬNULL(СУММА(_СтоимостиАктивов.БалансоваяСтоимость), 0) КАК БалансоваяСтоимость
		|ИЗ
		|	_СтоимостиАктивов КАК _СтоимостиАктивов");
	
	Запрос.УстановитьПараметр("ОблигацияАвтодор002", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002"));
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка); 	
	Запрос.УстановитьПараметр("Период",	Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	
	
	СтоимостьАктивов = Запрос.Выполнить().Выгрузить()[0]; 
	
	// Пишем движения
	Движения.ВводыВыводыАктивовВВалютеУчета.Очистить();
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать = Истина;
	
	Движение = Движения.ВводыВыводыАктивовВВалютеУчета.Добавить();
	
	Движение.НаправлениеДвижения		  = Перечисления.ВидыДвижений.Расход;
	Движение.Период						  = ЭтотОбъект.Дата;
	Движение.Организация				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ВидАктива					  = Перечисления.ВидыАктивов.ЦенныеБумаги;
	Движение.РыночнаяСтоимость			  = СтоимостьАктивов.РыночнаяСтоимость;
	Движение.БалансоваяСтоимость		  = СтоимостьАктивов.БалансоваяСтоимость;
	
	Движения.Записать();	
	
КонецПроцедуры

Процедура СписатьДебиторскуюЗадолженностьПоПогашениюЦБИКупона(Отказ)
	      		
	// Проверяем ценные бумаги с флагом "СписыватьДебиторку"
	Запрос = Новый Запрос;
	
	Если ПоместитьЦенныеБумагиДляСписанияДебиторкиВМенеджерВременныхТаблиц(Запрос) = Ложь Тогда
		//Нет строк с флагом
		Возврат;
	КонецЕсли;
	
	#Область Текст_Запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеКупона).Облигация
		|		ИНАЧЕ ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Аванс КАК Аванс
		|ПОМЕСТИТЬ _ОстаткиЗадолженности
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюВекселя), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюИпотечногоСертификатаУчастия), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая))
		|				И ТИПЗНАЧЕНИЯ(Основание) В (ТИП(Документ.ПогашениеКупона), ТИП(Документ.ПогашениеЦеннойБумаги))) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|				&ПериодГраница,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ДепозитарныйСчет = &ДепозитарныйСчет) КАК ОстаткиЦенныхБумагОстатки
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеКупона)
		|					ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеКупона).Облигация
		|				ИНАЧЕ ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага
		|			КОНЕЦ = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага)
		|ГДЕ
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦБ_ВывестиДебиторку.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(_ОстаткиЗадолженности.СуммаОстаток * _ЦБ_ВывестиДебиторку.Количество / _ОстаткиЗадолженности.КоличествоОстаток КАК ЧИСЛО(19, 2)) КАК Сумма,
		|	ВЫРАЗИТЬ(_ОстаткиЗадолженности.СуммаКупонаОстаток * _ЦБ_ВывестиДебиторку.Количество / _ОстаткиЗадолженности.КоличествоОстаток КАК ЧИСЛО(19, 2)) КАК СуммаКупона,
		|	_ОстаткиЗадолженности.Валюта КАК Валюта,
		|	_ОстаткиЗадолженности.Основание КАК Основание,
		|	_ОстаткиЗадолженности.ТипЗадолженности КАК ТипЗадолженности,
		|	_ОстаткиЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
		|	_ОстаткиЗадолженности.Организация КАК Организация,
		|	_ОстаткиЗадолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиЗадолженности.Контрагент КАК Контрагент,
		|	_ОстаткиЗадолженности.Аванс КАК Аванс
		|ИЗ
		|	_ЦБ_ВывестиДебиторку КАК _ЦБ_ВывестиДебиторку
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОстаткиЗадолженности КАК _ОстаткиЗадолженности
		|		ПО _ЦБ_ВывестиДебиторку.ЦеннаяБумага = _ОстаткиЗадолженности.ЦеннаяБумага";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ПериодГраница", 					Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарныйСчет", 				ЭтотОбъект.ДепозитарныйСчет);
	
	Результат = Запрос.Выполнить();
	
	УстановитьБлокировки_ЗадолженостьПоДС(Результат);
	
	Выборка = Результат.Выбрать(); 
	
	// Формируем движения
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать		= Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать 	= Истина;
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
				
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период		 = ЭтотОбъект.Дата;
		
		// Также добавляем движение по регистру вводов-выводов на эту сумму
		Движение = Движения.ВводыВыводыАктивовВВалютеУчета.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.НаправлениеДвижения	= Перечисления.ВидыДвижений.Расход;
		Движение.Период					= ЭтотОбъект.Дата;
		Движение.ВидАктива				= Перечисления.ВидыАктивов.ДебиторскаяЗадолженность;		
		Сумма 							= Выборка.Сумма + Выборка.СуммаКупона;
		Движение.РыночнаяСтоимость		= Сумма;
		Движение.БалансоваяСтоимость	= Сумма;
		
	КонецЦикла;
	
	Движения.Записать();	
	
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствам(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Функция ПоместитьЦенныеБумагиДляСписанияДебиторкиВМенеджерВременныхТаблиц(Запрос)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЦенныеБумаги.Количество) КАК Количество,
	|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _ЦБ_ВывестиДебиторку
	|ИЗ
	|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ЦенныеБумаги
	|ГДЕ
	|	ЦенныеБумаги.Ссылка = &Регистратор
	|	И ЦенныеБумаги.СписыватьДебиторку
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦенныеБумаги.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	_ЦБ_ВывестиДебиторку.Количество КАК Количество
	|ИЗ
	|	_ЦБ_ВывестиДебиторку КАК _ЦБ_ВывестиДебиторку";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка); 	
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;   		

	Возврат Истина;
	
КонецФункции

Функция ДатаНачалаСписанияДебиторкиПоЦБИКупону()
	
	Возврат '20210312';
	
КонецФункции

Процедура ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, Отказ)

	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(
															ЭтотОбъект.Дата,
															ЭтотОбъект.Организация,
															ЭтотОбъект.СчетДоверительногоУправления);
															
	НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчета(
															ЭтотОбъект.Дата,
															ЭтотОбъект.Организация,
															ЭтотОбъект.СчетДоверительногоУправления,
															"НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки");
															
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	БухПартииЦенныхБумаг.Организация КАК Организация,
		|	БухПартииЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумаг.Рынок КАК Рынок,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Количество КАК Количество,
		|	БухПартииЦенныхБумаг.РасходыПриПокупкеСНачалаГода КАК РасходыПриПокупкеСНачалаГода,
		|	БухПартииЦенныхБумаг.Стоимость КАК Стоимость,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СтоимостьКупона,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.Переоценка КАК Переоценка,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода,
		|	БухПартииЦенныхБумаг.ПереоценкаСНачалаГодаПоложительная КАК ПереоценкаСНачалаГодаПоложительная,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаСНачалаГода КАК ПереоценкаКупонаСНачалаГода,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйСНачалаГода КАК ДисконтПремияНачисленныйСНачалаГода,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПСНачалаГода КАК КорректировкаЭСПСНачалаГода,
		|	БухПартииЦенныхБумаг.ДисконтПремия КАК ДисконтПремия,
		|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчета КАК СчетУчета,
