				ПараметрыНачисления.Вставить("ДоходРасход",		ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода + ПерекурсовкаОтраженнаяКакПереоценка);
				
				ПараметрыНачисления.Вставить("СчетДоходов",		БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС));
				ПараметрыНачисления.Вставить("СчетРасходов",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС, Ложь));
				
				ПараметрыНачисления.Вставить("АналитикаДоходов",	ВыборкаДетальныеЗаписи.АналитикаДоходовОтПереоценки);
				ПараметрыНачисления.Вставить("АналитикаРасходов",	ВыборкаДетальныеЗаписи.АналитикаРасходовОтПереоценки);
				
				ПараметрыНачисления.Вставить("Аналитика",			"");

				Если ЭтоАктивДляПродажи Тогда // у этих доходы/расходы от переоценки на 106, а не на 7ХХ - т.е. есть валюта и пр.
					ПараметрыНачисления.Вставить("ВалютаУчета",						ВыборкаДетальныеЗаписи.ВалютаНоминала);
				КонецЕсли;
				
				БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				ПараметрыНачисления.Вставить("ВалютаУчета",						Организация.ВалютаУчета); // вернем, если попортили
				
				// корректировка ЭСП
				ПараметрыНачисления.Вставить("ДоходРасход",		ВыборкаДетальныеЗаписи.КорректировкаЭСПСНачалаГода);
				
				ПараметрыНачисления.Вставить("СчетДоходов",		ПланыСчетов.Единый.ПроцентныеДоходы05);
				ПараметрыНачисления.Вставить("СчетРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы06);
				
				ПараметрыНачисления.Вставить("АналитикаДоходов",	ВыборкаДетальныеЗаписи.АналитикаДоходовОтКорректировки);
				ПараметрыНачисления.Вставить("АналитикаРасходов",	ВыборкаДетальныеЗаписи.АналитикаРасходовОтКорректировки);
					
				ПараметрыНачисления.Вставить("Аналитика",			"");
				
				БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
