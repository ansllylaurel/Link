					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СтрокаПартии.СуммаРезервовПодОбесценение, "Формирование резерва");
					
					Проводка.СчетДт												= ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаНачисленияРезервов.НомерСчетаБухгалтерскогоУчета);
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаНачисленияРезервов;
					Проводка.СубконтоДт.ЦенныеБумаги							= СтрокаПартии.ЦеннаяБумага;
					
					Проводка.СчетКт							= УчетныйАктив.СчетУчетаРезервов;
					Проводка.СубконтоКт.Резервы				= СтрокаПартии.Резерв;
					Проводка.СубконтоКт.ЦенныеБумаги		= СтрокаПартии.ЦеннаяБумага;
					Проводка.ВалютаКт						= ЭтотОбъект.Организация.ВалютаУчета;
					Проводка.ВалютнаяСуммаКт				= СтрокаПартии.СуммаРезервовПодОбесценение;

				ИначеЕсли СтрокаПартии.СуммаРезервовПодОбесценение < 0 Тогда
					
