		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СуммаКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК СуммаКупонаНачисленного,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСП) КАК СуммаКорректировкиЭСП,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК СуммаРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Резерв,
		|	СУММА(БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрок) КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	СУММА(БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета) КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В
		|					(ВЫБРАТЬ
		|						Справочник.УчетныеАктивыЕПС.СчетУчетаРезервов
		|					ИЗ
		|						Справочник.УчетныеАктивыЕПС),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО БухПартииЦенныхБумаг.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
