				БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
				// дисконт/премия
				ПараметрыНачисления.Вставить("ДоходРасход",		ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйСНачалаГода);
				
				ПараметрыНачисления.Вставить("СчетДоходов",		ПланыСчетов.Единый.ПроцентныеДоходы01);
