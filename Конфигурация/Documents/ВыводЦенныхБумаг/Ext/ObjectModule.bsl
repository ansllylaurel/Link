					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаСписанияРезервов;
					Проводка.СубконтоКт.ЦенныеБумаги							= СтрокаПартии.ЦеннаяБумага;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
