////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
	СУММА(БухПартииЦенныхБумагОбороты.КоличествоРасход) КАК КоличествоРасход,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьРасход) КАК Сумма_налог,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьКупонаРасход + БухПартииЦенныхБумагОбороты.ПереоценкаКупонаРасход) КАК НКД_налог,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьВВалютеУчетаРасход) КАК Сумма_налогРуб,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьКупонаВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.ПереоценкаКупонаВВалютеУчетаРасход) КАК НКД_налогРуб,
	БухПартииЦенныхБумагОбороты.Регистратор КАК Регистратор
ПОМЕСТИТЬ _Налог
ИЗ
	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(&amp;ДатаНачало, &amp;ДатаКонец, Регистратор, ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)) КАК БухПартииЦенныхБумагОбороты
ГДЕ
	БухПартииЦенныхБумагОбороты.Регистратор В(&amp;ДокВывод)

СГРУППИРОВАТЬ ПО
	БухПартииЦенныхБумагОбороты.ЦеннаяБумага,
	БухПартииЦенныхБумагОбороты.ПереоценкаКупонаВВалютеУчетаРасход,
	БухПартииЦенныхБумагОбороты.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
	СУММА(БухПартииЦенныхБумагОбороты.КоличествоРасход) КАК КоличествоРасход,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьРасход + БухПартииЦенныхБумагОбороты.ПереоценкаРасход + БухПартииЦенныхБумагОбороты.ДисконтПремияНачисленныйРасход + БухПартииЦенныхБумагОбороты.КорректировкаЭСПРасход + БухПартииЦенныхБумагОбороты.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеРасход) КАК Сумма_ЕПС,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьКупонаРасход + БухПартииЦенныхБумагОбороты.ПереоценкаКупонаРасход) КАК НКД_ЕПС,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.ПереоценкаВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.ДисконтПремияНачисленныйВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.КорректировкаЭСПВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаРасход) КАК Сумма_ЕПС_руб,
	СУММА(БухПартииЦенныхБумагОбороты.СтоимостьКупонаВВалютеУчетаРасход + БухПартииЦенныхБумагОбороты.ПереоценкаКупонаВВалютеУчетаРасход) КАК НКД_ЕПС_руб,
	БухПартииЦенныхБумагОбороты.Регистратор КАК Регистратор,
	БухПартииЦенныхБумагОбороты.СуммаРезервовПодОбесценениеРасход КАК ВТомЧислеРезервы
ПОМЕСТИТЬ _ЕПС
ИЗ
	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(&amp;ДатаНачало, &amp;ДатаКонец, Регистратор, ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОбороты
ГДЕ
	БухПартииЦенныхБумагОбороты.Регистратор В(&amp;ДокВывод)

СГРУППИРОВАТЬ ПО
	БухПартииЦенныхБумагОбороты.ЦеннаяБумага,
	БухПартииЦенныхБумагОбороты.Регистратор,
	БухПартииЦенныхБумагОбороты.СуммаРезервовПодОбесценениеРасход
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК ЦеннаяБумагаЭмитент,
	_Рынок.ЦеннаяБумага КАК ЦеннаяБумага,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.Облигации)
			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.Акции)
			ТОГДА ВЫРАЗИТЬ(_Рынок.ЦеннаяБумага КАК Справочник.Акции).Номинал
	КОНЕЦ КАК Номинал,
	_Рынок.ВалютаКотировки КАК ВалютаКотировки,
	_Рынок.Количество КАК Количество,
	_Рынок.СуммаРынок КАК СуммаРынок,
	_Рынок.СуммаРынокРуб КАК СуммаРынокРуб,
	_Рынок.СуммаКупонаРынок КАК СуммаКупонаРынок,
	_Рынок.СуммаКупонаРынокРуб КАК СуммаКупонаРынокРуб,
	ЕСТЬNULL(_Налог.Сумма_налог, 0) КАК Сумма_налог,
	ЕСТЬNULL(_Налог.Сумма_налогРуб, 0) КАК Сумма_налогРуб,
	ЕСТЬNULL(_Налог.НКД_налог, 0) КАК НКД_налог,
	ЕСТЬNULL(_Налог.НКД_налогРуб, 0) КАК НКД_налогРуб,
	ЕСТЬNULL(_ЕПС.Сумма_ЕПС, 0) КАК Сумма_ЕПС,
	ЕСТЬNULL(_ЕПС.Сумма_ЕПС_руб, 0) - ЕСТЬNULL(_ЕПС.ВТомЧислеРезервы, 0) КАК Сумма_ЕПС_руб,
	ЕСТЬNULL(_ЕПС.НКД_ЕПС, 0) КАК НКД_ЕПС,
	ЕСТЬNULL(_ЕПС.НКД_ЕПС_руб, 0) КАК НКД_ЕПС_руб,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.Облигации)
			ТОГДА "Облигация"
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.Акции)
			ТОГДА "Акция"
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.Паи)
			ТОГДА "Пай"
		КОГДА ТИПЗНАЧЕНИЯ(_Рынок.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			ТОГДА "ИСУ"
		ИНАЧЕ ""
	КОНЕЦ КАК ВидЦеннойБумаги,
	_Рынок.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК РегНомер,
	ЕСТЬNULL(_ЕПС.ВТомЧислеРезервы, 0) КАК ВТомЧислеРезервы,
	ЕСТЬNULL(_ЕПС.ВТомЧислеРезервы, 0) КАК ВТомЧислеРезервыРынок
ИЗ
	_Рынок КАК _Рынок
		ЛЕВОЕ СОЕДИНЕНИЕ _Налог КАК _Налог
		ПО _Рынок.ЦеннаяБумага = _Налог.ЦеннаяБумага
			И _Рынок.Ссылка = _Налог.Регистратор
		ЛЕВОЕ СОЕДИНЕНИЕ _ЕПС КАК _ЕПС
		ПО _Рынок.ЦеннаяБумага = _ЕПС.ЦеннаяБумага
			И _Рынок.Ссылка = _ЕПС.Регистратор
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних({(&amp;ДатаКонец)}, ) КАК НоминалыЦенныхБумагСрезПоследних
		ПО _Рынок.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&amp;ДатаКонец {(&amp;ДатаКонец)}, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		ПО _Рынок.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо</query>
	</dataSet>
