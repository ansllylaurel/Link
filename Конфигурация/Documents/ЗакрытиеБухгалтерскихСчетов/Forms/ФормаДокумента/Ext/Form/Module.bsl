
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	Элементы.ЗакрываемыеСчетаВариантЗакрытияБухгалтерскихСчетов.СписокВыбора.ЗагрузитьЗначения(СписокВыбораВарианта(Объект.ВидУчета, Объект.СчетДоверительногоУправления, Объект.ОкончаниеПериода)); 

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияПриИзменении(Объект.СчетДоверительногоУправления, ЭтаФорма);
	Элементы.ЗакрываемыеСчетаВариантЗакрытияБухгалтерскихСчетов.СписокВыбора.ЗагрузитьЗначения(СписокВыбораВарианта(Объект.ВидУчета, Объект.СчетДоверительногоУправления, Объект.ОкончаниеПериода)); 

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаПриИзменении(Элемент)

	Элементы.ЗакрываемыеСчетаВариантЗакрытияБухгалтерскихСчетов.СписокВыбора.ЗагрузитьЗначения(СписокВыбораВарианта(Объект.ВидУчета, Объект.СчетДоверительногоУправления, НачалоДня(Объект.Дата))); 

КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеПериодаПриИзменении(Элемент)
	
	Элементы.ЗакрываемыеСчетаВариантЗакрытияБухгалтерскихСчетов.СписокВыбора.ЗагрузитьЗначения(СписокВыбораВарианта(Объект.ВидУчета, Объект.СчетДоверительногоУправления, Объект.ОкончаниеПериода)); 
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
			
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Организация", Объект.Организация));
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста 
Функция СписокВыбораВарианта(ВидУчета, СчетДУ, ДатаОкончаниеПериода)
	
	Список = Новый Массив;
	
	Если ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет") Тогда 
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСЗакрытиеРаздела7"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСПереносКорректировокНаПереоценки"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСПереносНачисленныхКорректировокНаПереоценки"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСЗакрытиеРаздела7ВОплаченнойЧасти"));
	ИначеЕсли ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.БухгалтерскийУчет") ИЛИ
		ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчета.НалоговыйУчет")  Тогда 
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета91"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета90"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов911и912"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов901и902"));
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета99"));		
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета863"));
		
		// только для расторжения
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДУ, "ДатаРасторжения") = ДатаОкончаниеПериода Тогда 
			Список.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета79"));
		КонецЕсли;		
	КонецЕсли;	
		
	Возврат Список;
		
КонецФункции	


#КонецОбласти

