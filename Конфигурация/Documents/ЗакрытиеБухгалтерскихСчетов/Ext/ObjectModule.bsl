				Проводка.СчетДт = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов;
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеРасходы;
				
				Для НомСубк = 1 По Проводка.СчетКт.ВидыСубконто.Количество() Цикл
					Проводка.СубконтоКт[Проводка.СчетКт.ВидыСубконто[НомСубк - 1].ВидСубконто] = Выборка["Субконто" + НомСубк];
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов901и902 Тогда
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОбороты.Субконто1,
				|	БухгалтерскийУчетОбороты.Субконто2,
				|	БухгалтерскийУчетОбороты.Субконто3,
				|	БухгалтерскийУчетОбороты.СуммаОборотКт - БухгалтерскийУчетОбороты.СуммаОборотДт КАК СуммаОборотКт
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
