			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);

			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], 0, СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов);
				
				Если Выборка.Сальдо90 > 0 Тогда
					Проводка.СчетДт = ПланыСчетов.Основной.ПрибыльУбытокОтПродаж;
					Проводка.СчетКт = ПланыСчетов.Основной.ПрибылиИУбытки;
					Проводка.Сумма  = Выборка.Сальдо90;
				Иначе
					Проводка.СчетДт = ПланыСчетов.Основной.ПрибылиИУбытки;
					Проводка.СчетКт = ПланыСчетов.Основной.ПрибыльУбытокОтПродаж;
					Проводка.Сумма  = -Выборка.Сальдо90;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчетов911и912 Тогда
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОбороты.Субконто1,
				|	БухгалтерскийУчетОбороты.Субконто2,
				|	БухгалтерскийУчетОбороты.Субконто3,
				|	БухгалтерскийУчетОбороты.СуммаОборотКт - БухгалтерскийУчетОбороты.СуммаОборотДт КАК СуммаОборотКт
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
