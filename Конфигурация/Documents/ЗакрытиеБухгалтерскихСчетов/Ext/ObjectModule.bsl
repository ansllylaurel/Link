
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если Не РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + " у " + ЭтотОбъект.СчетДоверительногоУправления + " не ведется " + ЭтотОбъект.ВидУчета, ЭтотОбъект, "ВидУчета",, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	Движения[УчетныйРегистр].Записывать = Истина;
		
	Для каждого СтрокаЗакрываемыеСчета Из ЭтотОбъект.ЗакрываемыеСчета Цикл
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("НачалоПериода",                Новый Граница(НачалоДня(ЭтотОбъект.НачалоПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонецПериода",                 Новый Граница(КонецДня(ЭтотОбъект.ОкончаниеПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		Если СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов = Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЗакрытиеСчета91 Тогда
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОбороты911.СуммаОборотКт - БухгалтерскийУчетОбороты911.СуммаОборотДт - БухгалтерскийУчетОбороты912.СуммаОборотДт + БухгалтерскийУчетОбороты912.СуммаОборотКт КАК Сальдо91
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
				|			,
				|			) КАК БухгалтерскийУчетОбороты911,
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
				|			,
				|			) КАК БухгалтерскийУчетОбороты912";
				
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
				
			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], 0, СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов);
				
				Если Выборка.Сальдо91 > 0 Тогда
					Проводка.СчетДт = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов;
					Проводка.СчетКт = ПланыСчетов.Основной.ПрибылиИУбытки;
					Проводка.Сумма  = Выборка.Сальдо91;
				Иначе
					Проводка.СчетДт = ПланыСчетов.Основной.ПрибылиИУбытки;
					Проводка.СчетКт = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов;
					Проводка.Сумма  = -Выборка.Сальдо91;
				КонецЕсли;
			КонецЕсли;
			
