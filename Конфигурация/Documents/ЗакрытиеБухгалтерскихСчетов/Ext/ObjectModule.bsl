				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
				|			,
				|			) КАК БухгалтерскийУчетОбороты";
				
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
				
			Выборка = Запрос.Выполнить().Выбрать();

			Пока Выборка.Следующий() Цикл
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Выборка.СуммаОборотКт, СтрокаЗакрываемыеСчета.ВариантЗакрытияБухгалтерскихСчетов);
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СчетКт = ПланыСчетов.Основной.СальдоПрочихДоходовИРасходов;
				
				Для НомСубк = 1 По Проводка.СчетДт.ВидыСубконто.Количество() Цикл
					Проводка.СубконтоДт[Проводка.СчетДт.ВидыСубконто[НомСубк - 1].ВидСубконто] = Выборка["Субконто" + НомСубк];
				КонецЦикла;				
				
			КонецЦикла;
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОбороты.Субконто1,
				|	БухгалтерскийУчетОбороты.Субконто2,
				|	БухгалтерскийУчетОбороты.Субконто3,
				|	БухгалтерскийУчетОбороты.СуммаОборотДт - БухгалтерскийУчетОбороты.СуммаОборотКт КАК СуммаОборотДт
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Период,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
