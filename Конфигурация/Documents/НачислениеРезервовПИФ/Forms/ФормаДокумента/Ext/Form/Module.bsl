
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтотОбъект);
	
	ЭтаФорма.ТолькоПросмотр = Истина;
	
	ЭлементСостояниеДокумента = Элементы.Найти("СостояниеДокумента");
	Если ЭлементСостояниеДокумента = Неопределено Тогда
		ЭлементСостояниеДокумента = Элементы.Вставить("СостояниеДокумента", Тип("ДекорацияФормы"), , ЭтаФорма.ПодчиненныеЭлементы[0]);
		ЭлементСостояниеДокумента.Шрифт						= ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт;
		ЭлементСостояниеДокумента.АвтоМаксимальнаяШирина	= Ложь;
		ЭлементСостояниеДокумента.Видимость					= Истина;
	КонецЕсли;
	ЭлементСостояниеДокумента.Заголовок	= Новый ФорматированнаяСтрока("Интерактивное изменение документа разрешено только из формы документа 'Регистрация стоимости активов'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

