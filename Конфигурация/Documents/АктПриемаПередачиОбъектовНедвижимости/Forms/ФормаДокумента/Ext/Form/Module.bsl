&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.НДСВключатьВСтоимость.Видимость = ДанныеОбъекта.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход");
	Элементы.Грузоотправитель.Видимость = ДанныеОбъекта.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход");
	Элементы.ОбъектыНедвижимостиОбъектНедвижимостиПоДДУ.Видимость = ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДДУ");
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();

		ПутьКДаннымСкрываемыхПолей.Вставить("НДСВключатьВСтоимость", 	"Объект.НДСВключатьВСтоимость");
		ПутьКДаннымСкрываемыхПолей.Вставить("Грузоотправитель", 		"Объект.Грузоотправитель");				
		
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);	
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьДоступность

Процедура ОбновитьКПП()
	
	ЭтаФорма.КПП = "";

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА РеквизитыГрузоотправителяАнкетныеСрезПоследних.ЮрФизЛицо ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА РеквизитыГрузоотправителяАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика <> """"
		|						ТОГДА РеквизитыГрузоотправителяАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика
		|					ИНАЧЕ РеквизитыГрузоотправителяАнкетныеСрезПоследних.КПП
		|				КОНЕЦ
		|		КОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо ЕСТЬ НЕ NULL 
		|			ТОГДА ВЫБОР
		|					КОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика <> """"
		|						ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика
		|					ИНАЧЕ РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП
		|				КОНЕЦ
		|	КОНЕЦ КАК КПП
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						СделкаСНедвижимостью.Контрагент КАК Контрагент
		|					ИЗ
		|						Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|					ГДЕ
		|						СделкаСНедвижимостью.Ссылка = &СделкаСНедвижимостью
		|						И СделкаСНедвижимостью.Организация = &Организация
		|						И СделкаСНедвижимостью.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И ЮрФизЛицо = &Грузоотправитель
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыГрузоотправителяАнкетныеСрезПоследних
		|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Грузоотправитель", Объект.Грузоотправитель);
	Запрос.УстановитьПараметр("СделкаСНедвижимостью", Объект.Основание);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЭтаФорма.КПП = ВыборкаДетальныеЗаписи.КПП;
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ОбновитьКПП();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДвиженияПриИзменении(Элемент)
	
	Если Объект.ВидДвижения <> ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход") Тогда
		Объект.НДСВключатьВСтоимость = Ложь;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузоотправительПриИзменении(Элемент)
	ОбновитьКПП();
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	ОбновитьКПП();
КонецПроцедуры

&НаСервере
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если НЕ ЗначениеЗаполнено(ОбъектНаСервере.ДатаСчетаФактуры) Тогда
		ОбъектНаСервере.ДатаСчетаФактуры = ОбъектНаСервере.Дата;
	КонецЕсли;
	
	ОбъектНаСервере.НомерСчетаФактуры = РаботаСНДС.ПолучитьНомерСчетаФактуры(ОбъектНаСервере);
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданного(Команда)
	КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере();
КонецПроцедуры
