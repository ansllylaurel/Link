
Процедура ЗаполнитьВидСделки()
	
	Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПустаяСсылка() Тогда
	    ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.ПустаяСсылка();
		
	ИначеЕсли ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.Сделка") Тогда
		ЭтотОбъект.ВидСделки = ЭтотОбъект.Основание.ВидСделки;
		
	ИначеЕсли ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Если ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 0 Тогда
			Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО Тогда
				ЭтотОбъект.ВидСделки = ЭтотОбъект.Основание.ВидСделки;
			ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
				Если      ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа;
				ИначеЕсли ЭтотОбъект.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
					ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЭтотОбъект.ВидСделки = ЭтотОбъект.Основание.ВидСделки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьВидСделки

Функция ЗаполнитьНаОсновании(_Основание, _ВидЗадолженности = Неопределено) Экспорт

	СтатусВыполнения = РаботаСДокументами.ЗаполнитьИсполнениеПоЦеннымБумагамНаОсновании(ЭтотОбъект, _Основание, _ВидЗадолженности);
	
	// дозаполним поля, связанные с оплатой
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, _Основание, "МестоХранения, Брокер, РасчетныйСчет");
	
	Возврат СтатусВыполнения;

КонецФункции // ЗаполнитьНаОсновании


Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
	
		БлокировкаДанных = Новый БлокировкаДанных;
		
		// остатки ценных бумаг
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
			ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
			
			ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДепозитарныйСчет", "ДепозитарныйСчет");
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага",     "ЦеннаяБумага");
		КонецЕсли;
		
		// задолженность по ц/б
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагам");
		ЭлементБлокировкиДанных.УстановитьЗначение("Основание",        ЭтотОбъект.Основание);
		ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
		
		// задолженность по д/с
		Если ЭтотОбъект.Рынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы") Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
			ЭлементБлокировкиДанных.УстановитьЗначение("Основание",        ЭтотОбъект.Основание);
			ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
		КонецЕсли;
		
		БлокировкаДанных.Заблокировать();
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьДвиженияПоДенежнымСредствам()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ИсполнениеОбязательствПоСделке.Дата КАК Период,
		|	ИсполнениеОбязательствПоСделке.Организация КАК Организация,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Брокер КАК Брокер,
		|	ИсполнениеОбязательствПоСделке.МестоХранения КАК МестоХранения,
		|	ИсполнениеОбязательствПоСделке.РасчетныйСчет КАК РасчетныйСчет,
		|	ИсполнениеОбязательствПоСделке.Рынок КАК Рынок,
		|	ИсполнениеОбязательствПоСделке.ВалютаСделки КАК Валюта,
		|	ИсполнениеОбязательствПоСделкеСуммы.Сумма КАК Сумма,
		|	ИсполнениеОбязательствПоСделкеСуммы.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
		|	ИсполнениеОбязательствПоСделке.ВидЗадолженности КАК ВариантДвиженияДенежныхСредств
		|ИЗ
		|	(ВЫБРАТЬ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка КАК Ссылка,
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма) КАК Сумма,
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата) КАК ВидДвиженияДенежныхСредств
		|	ИЗ
		|		Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|	ГДЕ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма) > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка,
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона),
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
		|	ИЗ
		|		Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|	ГДЕ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона) > 0) КАК ИсполнениеОбязательствПоСделкеСуммы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО ИсполнениеОбязательствПоСделкеСуммы.Ссылка = ИсполнениеОбязательствПоСделке.Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ОстаткиДенежныхСредств.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // СформироватьДвиженияПоДенежнымСредствам

Процедура СформироватьДвиженияПоЗадолженностиДенежнымСредствам()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделке.Дата КАК Период,
		|	ИсполнениеОбязательствПоСделке.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ИсполнениеОбязательствПоСделке.ВидЗадолженности КАК ВидЗадолженности,
		|	ИсполнениеОбязательствПоСделке.Организация КАК Организация,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Основание.Контрагент КАК Контрагент,
		|	ИсполнениеОбязательствПоСделке.ВалютаСделки КАК Валюта,
		|	СуммыЗадолженностиПоДС.Сумма КАК Сумма,
		|	СуммыЗадолженностиПоДС.СуммаКупона КАК СуммаКупона
		|ИЗ
		|	(ВЫБРАТЬ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка КАК Ссылка,
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма) КАК Сумма,
		|		СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона) КАК СуммаКупона
		|	ИЗ
		|		Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|	ГДЕ
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = &Ссылка
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка) КАК СуммыЗадолженностиПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО СуммыЗадолженностиПоДС.Ссылка = ИсполнениеОбязательствПоСделке.Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // СформироватьДвиженияПоЗадолженностиДенежнымСредствам


Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	ЭтоРынокФьючерсов = (ЭтотОбъект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы"));

	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать               = Истина;
	Движения.ОстаткиДенежныхСредств.Записывать           = Истина;
	Движения.ЗадолженностиПоЦеннымБумагам.Записывать     = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать         = Истина;
	
	Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		ВидДвиженияЦБ      = ВидДвиженияНакопления.Приход;
		ВидОперацииСЦБ     = Перечисления.ВидыДвижений.Приход;
		ТипЗадолженностиЦБ = Перечисления.ТипыЗадолженности.Дебиторская;
	ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		ВидДвиженияЦБ      = ВидДвиженияНакопления.Расход;
		ВидОперацииСЦБ     = Перечисления.ВидыДвижений.Расход;
		ТипЗадолженностиЦБ = Перечисления.ТипыЗадолженности.Кредиторская;
	КонецЕсли;
	
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		// остатки ц/б
		Движение = Движения.ОстаткиЦенныхБумаг.Добавить();
		Движение.ВидДвижения                  = ВидДвиженияЦБ;
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		
		// задолженность по ц/б
		Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.ТипЗадолженности             = ТипЗадолженностиЦБ;
		Движение.ВидЗадолженности             = ЭтотОбъект.ВидЗадолженности;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Валюта                       = ЭтотОбъект.ВалютаСделки;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
		Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
		
		// операции с ц/б
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
				
		Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО Тогда
			Движение.ЧастьСделкиРЕПО = 1;
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
			Движение.ЧастьСделкиРЕПО = 2;
		КонецЕсли;
		
		Движение.Операция                     = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения                  = ВидОперацииСЦБ;
		Движение.Основание                    = ЭтотОбъект.Основание;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.ДатаПоставки                 = ЭтотОбъект.Дата;
		Движение.ДатаОплаты                   = ЭтотОбъект.Дата;
		Движение.ДатаОперации                 = ЭтотОбъект.Дата;
		Движение.Валюта		                  = ЭтотОбъект.ВалютаСделки;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		Движение.Цена                         = СтрокаЦенныеБумаги.Цена;
		Движение.ЦенаПроцент                  = СтрокаЦенныеБумаги.ЦенаПроцент;
		Движение.ЦенаКупона                   = СтрокаЦенныеБумаги.ЦенаКупона;
		Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
		Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
	КонецЦикла;
	
	Если НЕ ЭтоРынокФьючерсов Тогда
		СформироватьДвиженияПоЗадолженностиДенежнымСредствам();
		СформироватьДвиженияПоДенежнымСредствам();
	КонецЕсли;
	
	Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда // по аналоги со сделками
	
		// проверим отрицательные остатки
		Движения.Записать();
		
		Если      ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			//РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
		ИначеЕсли ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
		КонецЕсли;
		
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоЦеннымБумагам(ЭтотОбъект, Отказ);
		
		Если НЕ ЭтоРынокФьючерсов Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствам(ЭтотОбъект, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПСФьючерсы(УчетныйРегистр, Отказ)

	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	МассивУчетныхАктивов = Новый Массив;
	
	Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		АналитикаКомиссии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПокупки;
		АналитикаСделки = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПродажи;
	Иначе
		АналитикаКомиссии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПродажи;
		АналитикаСделки = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПокупки;
	КонецЕсли;
	
	БиржаКонтрагент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ").ЮрФизЛицо;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииСрочныхКонтрактов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииСрочныхКонтрактов.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииСрочныхКонтрактов.Количество) КАК Количество,
		|	СУММА(БухПартииСрочныхКонтрактов.СтоимостьПокупки) КАК Стоимость,
		|	СУММА(БухПартииСрочныхКонтрактов.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииСрочныхКонтрактов.ПереоценкаСНачалаГода) КАК ПереоценкаСНачалаГода
		|ПОМЕСТИТЬ ЗакрытияКонтрактов
		|ИЗ
		|	РегистрНакопления.БухПартииСрочныхКонтрактов КАК БухПартииСрочныхКонтрактов
		|ГДЕ
		|	БухПартииСрочныхКонтрактов.Регистратор = &Регистратор
		|	И БухПартииСрочныхКонтрактов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииСрочныхКонтрактов.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииСрочныхКонтрактов.ЦеннаяБумага,
		|	БухПартииСрочныхКонтрактов.УчетныйАктивЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Цена КАК Цена,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗакрытияКонтрактов.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ЗакрытияКонтрактов.Количество КАК Количество,
		|	ЗакрытияКонтрактов.Стоимость КАК Стоимость,
		|	ЗакрытияКонтрактов.Переоценка КАК Переоценка,
		|	ЗакрытияКонтрактов.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода
		|ИЗ
		|	ЗакрытияКонтрактов КАК ЗакрытияКонтрактов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ПО ЗакрытияКонтрактов.ЦеннаяБумага = ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага
		|ГДЕ
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	
	Списания = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаСписания Из Списания Цикл
	
		СебестоимостьФьючерса = СтрокаСписания.Стоимость + СтрокаСписания.Переоценка;
		СтоимостьСписания = СтрокаСписания.Количество * СтрокаСписания.Цена;
		Прибыль = СтоимостьСписания - СебестоимостьФьючерса;
		
		Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда // списывали продажи, а для продаж рост бэд, а падение гуд
			Прибыль = - Прибыль;
		КонецЕсли;
		
		Если МассивУчетныхАктивов.Найти(СтрокаСписания.УчетныйАктивЕПС) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(СтрокаСписания.УчетныйАктивЕПС);
		КонецЕсли;
		
		Если Прибыль > 0 Тогда
		
			// проводка 1: прибыль на фьючерс
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, Прибыль, "Прибыль от закрытия контракта");
				
			// дебет
			Проводка.СчетДт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаПереоценкиА;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = СтрокаСписания.УчетныйАктивЕПС.АналитикаДоходовОтОпераций;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаСделки;
			
			
			// проводка 2: фьючерс на вспомогательный
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, Прибыль, "Прибыль от закрытия контракта");
				
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;
			
			// кредит
			Проводка.СчетКт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаПереоценкиА;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			
			// проводка 3: вспомогательный на дебиторку
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, Прибыль, "Задолженность по вар.марже");
				
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
			Проводка.СубконтоДт.Контрагенты = БиржаКонтрагент;
			Проводка.ВалютаДт = ЭтотОбъект.Организация.ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = Прибыль;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;
			
		ИначеЕсли Прибыль < 0 Тогда
			
			// проводка 1: фьючерс на прибыль
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -Прибыль, "Убыток от закрытия контракта");
				
			// дебет
			Проводка.СчетДт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = СтрокаСписания.УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			Проводка.ДополнительнаяАналитикаДт = АналитикаСделки;
			
			// кредит
			Проводка.СчетКт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаПереоценкиП;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			
			// проводка 2: вспомогательный на фьючерс
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -Прибыль, "Убыток от закрытия контракта");
				
			// дебет
			Проводка.СчетДт = СтрокаСписания.УчетныйАктивЕПС.СчетУчетаПереоценкиП;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаСписания.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;
			
			
			// проводка 3: кредиторку на вспомогательный
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -Прибыль, "Задолженность по вар.марже");
				
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
			Проводка.СубконтоКт.Контрагенты = БиржаКонтрагент;
			Проводка.ВалютаКт = ЭтотОбъект.Организация.ВалютаУчета;
			Проводка.ВалютнаяСуммаКт = -Прибыль;
			
		КонецЕсли;
		
		Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		
			// т.к. закрывали партии фьючерсов то закроем 7ой раздел
			СуммаЗакрытия7гоРаздела = Прибыль;
			Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				СуммаЗакрытия7гоРаздела = СуммаЗакрытия7гоРаздела - СтрокаСписания.ПереоценкаСНачалаГода;
			Иначе
				СуммаЗакрытия7гоРаздела = СуммаЗакрытия7гоРаздела + СтрокаСписания.ПереоценкаСНачалаГода;
			КонецЕсли;
			
			Если СуммаЗакрытия7гоРаздела > 0 Тогда
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
					ЭтотОбъект,
					СтрокаСписания.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций,
					СтрокаСписания.ЦеннаяБумага,
					СтрокаСписания.УчетныйАктивЕПС.АналитикаДоходовОтОпераций,
					ЭтотОбъект.Организация.ВалютаУчета,
					"Закрытие доначисления по переоценке фьючерса",
					АналитикаСделки,
					-СуммаЗакрытия7гоРаздела); //приходится передавать наоборот ибо вот так вот сделана процедура
					
			ИначеЕсли СуммаЗакрытия7гоРаздела < 0 Тогда
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
					ЭтотОбъект,
					СтрокаСписания.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций,
					СтрокаСписания.ЦеннаяБумага,
					СтрокаСписания.УчетныйАктивЕПС.АналитикаРасходовОтОпераций,
					ЭтотОбъект.Организация.ВалютаУчета,
					"Закрытие доначисления по переоценке фьючерса",
					АналитикаСделки,
					-СуммаЗакрытия7гоРаздела); //приходится передавать наоборот ибо вот так вот сделана процедура
					
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	// если мы этим исполнением только закрываем чужие сделки и не открываем новых
	// то мы закроем 7ой раздел в части комиссии, начисленной при сделке
	// ибо других прибылей/убытков по сделке не предполагается
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииСрочныхКонтрактов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииСрочныхКонтрактов.Количество) КАК Количество
		|ПОМЕСТИТЬ ОткрытияКонтрактов
		|ИЗ
		|	РегистрНакопления.БухПартииСрочныхКонтрактов КАК БухПартииСрочныхКонтрактов
		|ГДЕ
		|	БухПартииСрочныхКонтрактов.Регистратор = &Регистратор
		|	И БухПартииСрочныхКонтрактов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииСрочныхКонтрактов.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииСрочныхКонтрактов.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СделкаЦенныеБумаги.Количество КАК КоличествоСделка,
		|	СделкаЦенныеБумаги.ТорговаяКомиссия КАК ТорговаяКомиссия,
		|	ЕСТЬNULL(ОткрытияКонтрактов.Количество, 0) КАК Количество
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОткрытияКонтрактов КАК ОткрытияКонтрактов
		|		ПО (ОткрытияКонтрактов.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага)
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка = &Сделка";
	
	Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	
	Создания = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаСоздания Из Создания Цикл
		
		Если СтрокаСоздания.Количество = 0 Тогда // мы не создавали новых партий
			
			// для фьючей не передаем СчетДоверительногоУправления - ибо не переопределяются
			УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(, Перечисления.РынкиЦенныхБумаг.Фьючерсы, СтрокаСоздания.ЦеннаяБумага);
			
			Если МассивУчетныхАктивов.Найти(УчетныйАктивЕПС) = Неопределено Тогда
				МассивУчетныхАктивов.Добавить(УчетныйАктивЕПС);
			КонецЕсли;
			
			// По просьбе Светы Мищенко не делаем закрытия по комиссии - ждем конца года ибо методика неопределена
			Продолжить;
			
			// закроем 7ой раздел в части начисленной комиссии
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
				ЭтотОбъект,
				УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций,
				СтрокаСоздания.ЦеннаяБумага,
				УчетныйАктивЕПС.АналитикаРасходовОтОпераций,
				ЭтотОбъект.Основание.ВалютаТорговойКомиссии,
				"Закрытие доначисления по переоценке фьючерса",
				АналитикаКомиссии,
				СтрокаСоздания.ТорговаяКомиссия);
		
		КонецЕсли;
		
	КонецЦикла;
	
