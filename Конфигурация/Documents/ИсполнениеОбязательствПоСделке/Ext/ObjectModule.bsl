				Проводка.СчетКт = СчетЗатратВСтоимости;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Выборка.ЦеннаяБумага;
				
				Если СчетЗатратВСтоимости.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.СуммаВалютнаяЗатратыВСтоимости;
					Проводка.ВалютаКт = Выборка.ВалютаЗатратыВСтоимости;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// КОМИССИЯ
	ВыделятьРасходыПриПродаже = Ложь;
	Если (ВидСделки = Перечисления.ВидыСделок.Продажа) Тогда
		ВыделятьРасходыПриПродаже = НастройкиПоВидуУчета.ВыделятьРасходыПриПродаже;
	КонецЕсли;
	
	Если НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Начисления
		И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		
		ОбъектКомиссииСсылка = ЭтотОбъект.Основание;
		
		НачислятьКомиссию = Истина;
		ИспользоватьСчет7616 = Ложь;
		
		ТаблицаКомиссий = ЭтотОбъект.Основание.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, ТорговаяКомиссия");
		
		ТаблицаКомиссий.Колонки.Добавить("Валюта");
		ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности");
		
		ТаблицаКомиссий.ЗаполнитьЗначения(ВалютаТорговойКомиссии, "Валюта");
		ТаблицаКомиссий.ЗаполнитьЗначения(Справочники.ВидыЗадолженности.ПоТорговойКомиссии, "ВидЗадолженности");
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РасходыПоСделкеОбороты.СуммаОборот КАК ТорговаяКомиссия,
		|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			&МоментСделки,
		|			&МоментИсполнения,
		|			Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Сделка = &Сделка
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделкеОбороты";
		
		Запрос.УстановитьПараметр("МоментСделки", НачалоДня(ЭтотОбъект.Основание.Дата));
		Запрос.УстановитьПараметр("МоментИсполнения", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Основание);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяСтрокаТаблицаКомиссий = ТаблицаКомиссий.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицаКомиссий, ВыборкаДетальныеЗаписи);
			
			НоваяСтрокаТаблицаКомиссий.Валюта = ВалютаТорговойКомиссии;
			НоваяСтрокаТаблицаКомиссий.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии;
			
		КонецЦикла;
		
	Иначе	
		НачислятьКомиссию = Ложь;
		ИспользоватьСчет7616 = Ложь;
		
		ТаблицаКомиссий = Неопределено;
	КонецЕсли;
	
	Если НачислятьКомиссию И ТаблицаКомиссий <> Неопределено Тогда
		Для Каждого СтрокаТаблицыКомиссий Из ТаблицаКомиссий Цикл
			
			Если СтрокаТаблицыКомиссий.ТорговаяКомиссия = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если НачислятьКомиссию Тогда
				
				ОбращаетсяНаОРЦБ = Ложь;
				
				// ТОРГОВАЯ КОМИССИЯ НА 76.16 ИЛИ РАСХОДЫ
				Если ЗначениеЗаполнено(СтрокаТаблицыКомиссий.Валюта) Тогда
					ТорговаяКомиссияВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаТаблицыКомиссий.ТорговаяКомиссия,
						СтрокаТаблицыКомиссий.Валюта,
						ЭтотОбъект.Организация,
						ЭтотОбъект.Дата,
						Отказ);	
				Иначе
					ТорговаяКомиссияВВалютеУчета = СтрокаТаблицыКомиссий.ТорговаяКомиссия;
				КонецЕсли;	
					
				ДанныеАналитики = Новый Структура("Сделка, ВидЗадолженности", ОбъектКомиссииСсылка, Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ТорговаяКомиссияВВалютеУчета, "Поступление услуг", ДанныеАналитики);
				
				// дебет
				Если ИспользоватьСчет7616 Тогда
				
					Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоКомиссии;
					
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
					Проводка.СубконтоДт.Сделка      = Сделка;
					
				ИначеЕсли ВыделятьРасходыПриПродаже Тогда
					
					БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
						ЭтотОбъект,
						Проводка.СчетДт,
						Проводка.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаУслуг,
						СтрокаТаблицыКомиссий.ЦеннаяБумага,
						ОбращаетсяНаОРЦБ);
						
				Иначе
					
					УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Рынок,
						СтрокаТаблицыКомиссий.ЦеннаяБумага);
					
					НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктив,
						УчетныйРегистр);		
								
					Если (ВидСделки = Перечисления.ВидыСделок.Покупка И Не НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость) Или (ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы) Тогда
						АналитикаПроводки = АналитикаУслуг;
					Иначе	
						АналитикаПроводки = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;	
					КонецЕсли;
						
					БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
						ЭтотОбъект,
						Проводка.СчетДт,
						Проводка.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаПроводки,
						СтрокаТаблицыКомиссий.ЦеннаяБумага,
						ОбращаетсяНаОРЦБ);
						
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = СчетУчетаКомиссии;
				
				Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
				КонецЕсли;
				
				Если ЕстьСубконтоСделкиПоКомиссии Тогда
					Проводка.СубконтоКт.Сделка = ОбъектКомиссииСсылка;
				КонецЕсли;
				
				Если ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры
