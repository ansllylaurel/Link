			|	СУММА(Движения.КоличествоДт) КАК КоличествоДт,
			|	СУММА(Движения.КоличествоКт) КАК КоличествоКт,
			|	СУММА(Движения.Сумма) КАК Сумма,
			|	СУММА(Движения.ВалютнаяСуммаДт) КАК ВалютнаяСуммаДт,
			|	СУММА(Движения.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
			|	Движения.ДополнительнаяАналитикаДт КАК ДополнительнаяАналитикаДт,
			|	Движения.ДополнительнаяАналитикаКт КАК ДополнительнаяАналитикаКт
			|ИЗ
			|	Движения КАК Движения
			|
			|СГРУППИРОВАТЬ ПО
			|	Движения.СчетДт,
			|	Движения.СубконтоДт1,
			|	Движения.СубконтоДт2,
			|	Движения.СчетКт,
			|	Движения.СубконтоКт1,
			|	Движения.СубконтоКт2,
			|	Движения.ВалютаДт,
			|	Движения.ВалютаКт,
			|	Движения.ДополнительнаяАналитикаДт,
			|	Движения.ДополнительнаяАналитикаКт";
		
	КонецЕсли;							
	
	Запрос.УстановитьПараметр("ВидыСубконтоЦБ", ВидыСубконтоЦБ);
	Запрос.УстановитьПараметр("ВидыСубконтоДС", ВидыСубконтоДС);
	Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.Основание.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", ЭтотОбъект.Дата - 1);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ОснованиеРасчетов", ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("СчетДС", СчетДС);
	Запрос.УстановитьПараметр("СчетЦБ", СчетЦБ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.Сумма, "Исполнение сделки");
		
		Если ВыборкаДетальныеЗаписи.СчетДт = СчетДС ИЛИ ВыборкаДетальныеЗаписи.СчетДт = СчетЦБ Тогда
			
			// дебет
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетДт;
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СубконтоДт1;
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СубконтоДт2) Тогда
				Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.СубконтоДт2;
				Проводка.КоличествоКт = ВыборкаДетальныеЗаписи.КоличествоДт;
			КонецЕсли;
			
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.ВалютаДт;
			Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.ВалютнаяСуммаДт;
			Проводка.ДополнительнаяАналитикаКт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитикаДт;
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетКт;
			
		Иначе
			
			// кредит
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетКт;
			Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СубконтоКт1;
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СубконтоКт2) Тогда
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.СубконтоКт2;
				Проводка.КоличествоДт = ВыборкаДетальныеЗаписи.КоличествоКт;
			КонецЕсли;
			
			Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.ВалютаКт;
			Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ВалютнаяСуммаКт;
			Проводка.ДополнительнаяАналитикаДт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитикаКт;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетДт;
			
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
		ПроведениеПоРегиструЕПСФьючерсы(УчетныйРегистр, Отказ);
	ИначеЕсли БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПартииНаЛицевыхСчетах") Тогда
		ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, Отказ);
	Иначе
		БухгалтерскийУчетЕПС.СформироватьПроводкиПокупкиПродажиЦеннойБумаги(ЭтотОбъект, Основание, УчетныйРегистр, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Если  ЭтотОбъект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы") Тогда	
		ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлы(УчетныйРегистр, Отказ);
		Возврат;
	КонецЕсли;
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	БухгалтерскийУчет.СформироватьПроводкиПокупкиПродажиЦеннойБумагиБУНУ(ЭтотОбъект, УчетныйРегистр, Отказ);
	
	
КонецПроцедуры

Функция ПолучитьОтложеннуюИндексациюпоПартии(Партия, СтрокаПартии, Дата)
	
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если  ЗначениеЗаполнено(ДанныеЗаполнения) И ЭтотОбъект.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда // ввод на основании
		ЗаполнитьНаОсновании(ДанныеЗаполнения);
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект,
		"Основание, ВидЗадолженности, ВидСделки, СчетДоверительногоУправления, Рынок, Брокер, МестоХранения, РасчетныйСчет, ВалютаСделки");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	РаботаСДокументами.ЗаполнитьСтрокиПартии(ЭтотОбъект);
	
	ЗаполнитьВидСделки();
		
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		РаботаСДокументами.ПроверитьЗаполнениеРасчетногоСчета(ЭтотОбъект, Отказ);
		
		// проверим, что в основании выбрано отложенное исполнение, но не выбрано раздельное
		ОтложенноеИсполнение = Неопределено;
		РаздельноеИсполнение = Неопределено;
		
		Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке Тогда
			ОтложенноеИсполнение = ЭтотОбъект.Основание.ОтложенноеИсполнение;
			РаздельноеИсполнение = ЭтотОбъект.Основание.РаздельноеИсполнение;
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО Тогда
			ОтложенноеИсполнение = ЭтотОбъект.Основание.ОтложенноеИсполнение;
			РаздельноеИсполнение = ЭтотОбъект.Основание.РаздельноеИсполнение;
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
			Если ЭтотОбъект.Основание.ЧастьСделкиРЕПО = 2 Тогда
				ОтложенноеИсполнение = ЭтотОбъект.Основание.ОтложенноеИсполнение;
				РаздельноеИсполнение = ЭтотОбъект.Основание.РаздельноеИсполнение;
			Иначе
				ОтложенноеИсполнение = ЭтотОбъект.Основание.ОтложенноеИсполнениеВторойЧасти;
				РаздельноеИсполнение = ЭтотОбъект.Основание.РаздельноеИсполнениеВторойЧасти;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ОтложенноеИсполнение Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В основании не выбран режим отложенного исполнения.", ЭтотОбъект, "Основание",, Отказ);
		КонецЕсли;
		
		Если Не ОтложенноеИсполнение Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В основании выбран режим раздельного исполнения. Поставка и оплата закрываются соответствующими документами.", ЭтотОбъект, "Основание",, Отказ);
		КонецЕсли;
	
		// работа с ценными бумагами
		ТипЦеннойБумаги = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ЭтотОбъект.Рынок);
		
		Для НомСтр = 0 По ЭтотОбъект.ЦенныеБумаги.Количество() - 1 Цикл
			
			СтрокаЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги[НомСтр];
			
			// проверим, что рынок соответствует типу ценной бумаги
			Если Не ТипЦеннойБумаги.СодержитТип(ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип ценной бумаги в строке № " + (НомСтр + 1) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".",,,, Отказ);
			КонецЕсли;
			
			// для рынка векселей проверим количество
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя И СтрокаЦенныеБумаги.Количество <> 1 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество векселей в строке № " + (НомСтр + 1) + " отлично от 1. Обратитесь к разработчикам.",,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. по документу используется сводная форма в журнале
	РаботаСЖурналамиОпераций.ПередЗаписьюДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПередЗаписью

Процедура ПередУдалением(Отказ)
	
	// т.к. по документу используется сводная форма в журнале
	РаботаСЖурналамиОпераций.ПередУдалениемДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
		
КонецПроцедуры

#КонецОбласти

Процедура ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлы(УчетныйРегистр, Отказ)
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	УчетныйАктив					= БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Рынок, Неопределено);
	НастройкиУчетаАктива			= БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, Организация, СчетДоверительногоУправления, УчетныйАктив, УчетныйРегистр);
	ВалютныйУчет					= НастройкиУчетаАктива.СчетУчета.Валютный;
	СчетПрочиеРасходы				= ПланыСчетов.Основной.ПрочиеРасходы;
	СчетПрочиеДоходы				= ПланыСчетов.Основной.ПрочиеДоходы;
	ВидСубконтоУчетаЦеннойБумаги	= БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Основание, "Контрагент, ВалютаТорговойКомиссии");
	Контрагент = РеквизитыОснования.Контрагент;
	Сделка = ЭтотОбъект.Основание;
	ВалютаТорговойКомиссии = РеквизитыОснования.ВалютаТорговойКомиссии;	
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		ЭтотОбъект.Брокер);
	
	СчетУчетаКомиссии = ПланыСчетов.Основной.РасчетыПоКомиссии;
	
	СчетУчетаКомиссииБрокера = ПланыСчетов.Основной.РасчетыПоКомиссии;
	
	СчетУчетаДСДляКомиссии = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ВалютаТорговойКомиссии,
		Брокер);	
		
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		Отказ);
		
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"Аналитика");			
		
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		Если Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			КонтрагентПоКомиссии = Брокер.ЮрФизЛицо;
		Иначе
			КонтрагентПоКомиссии = Контрагент;
		КонецЕсли
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
	
	СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, Брокер, ЭтотОбъект.Дата);
	
	// списание переоценки незавершенных сделок
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Сделка,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	-БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	-БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Граница,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Сделка),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &Сделка) КАК БухгалтерскийУчетОстатки";
	
	Запрос.УстановитьПараметр("Сделка", 								Основание);
	Запрос.УстановитьПараметр("Граница",								Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",			СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", 	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ?(ВыборкаДетальныеЗаписи.СуммаОстаток<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаОстаток, "Переоценка НС");
		
		Если ВыборкаДетальныеЗаписи.СуммаОстаток > 0 Тогда
			Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок;
			Проводка.СубконтоДт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
			Проводка.СубконтоДт.БрокерскиеКомпании = Брокер;
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			
			Проводка.ВалютнаяСуммаДт = ?(ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток<0,-1,1) * ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
			Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.Валюта;
			
			Проводка.СчетКт = СчетПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦенныеБумаги[0].ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ		= Ложь;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СуммаОстаток < 0 Тогда
			
			//кредит. дебет потом
			Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок;
			Проводка.СубконтоКт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
			Проводка.СубконтоКт.БрокерскиеКомпании = Брокер;
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			
			Проводка.ВалютнаяСуммаКт = ?(ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток<0,-1,1) * ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
				
			//дебет			
			Проводка.СчетДт = СчетПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦенныеБумаги[0].ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ		= Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
		
		СчетРасчетаСКонтрагентами		= ПланыСчетов.Основной.РасчетыПоПокупкамТБС;
		
		Для Каждого ТекСтрока Из ЦенныеБумаги Цикл
			
			Если ТекСтрока.Количество > 0 Тогда
				
				//58.16.1/ 76.21.2 стоимость покупки
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТекСтрока.Сумма, ВалютаСделки, Организация, Дата, Отказ), "Покупка ТБС");
				
				// Дт.
				Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ТекСтрока.ЦеннаяБумага;
				
				Проводка.КоличествоДт = ТекСтрока.Количество;
				
				Если НастройкиУчетаАктива.СчетУчета.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = ТекСтрока.Сумма;
					Проводка.ВалютаДт = ВалютаСделки;
				КонецЕсли;
				
				// Кт.
				Проводка.СчетКт = СчетРасчетаСКонтрагентами;
				Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПокупкаТБС;
				
				Если СчетРасчетаСКонтрагентами.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = ТекСтрока.Сумма;
					Проводка.ВалютаКт = ВалютаСделки;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекСтрока.Сумма > 0 Тогда
				
				//76.21.2/55.4 оплата по сделке
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТекСтрока.Сумма, ВалютаСделки, Организация, Дата, Отказ), "Оплата продавцу");
				
				// Дт.
				Проводка.СчетДт = СчетРасчетаСКонтрагентами;
				Проводка.СубконтоДт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПокупкаТБС;
				
				Если СчетРасчетаСКонтрагентами.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = ТекСтрока.Сумма;
					Проводка.ВалютаДт = ВалютаСделки;
				КонецЕсли;
				
				// Кт.
				Проводка.СчетКт = СчетУчетаДС;
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПокупкаТБС;
				КонецЕсли;			
				
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = ТекСтрока.Сумма;
					Проводка.ВалютаКт = ВалютаСделки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		СчетРасчетаСКонтрагентами		= ПланыСчетов.Основной.РасчетыПоПродажамТБС;
		СчетЗатратВСтоимости		= ПланыСчетов.Основной.ЗатратыНаПриобретениеТБС;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Граница",						Новый Граница(МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация",					Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("СчетУчетаАктивов",				НастройкиУчетаАктива.СчетУчета);
		Запрос.УстановитьПараметр("СчетУчетаПереоценки",			НастройкиУчетаАктива.СчетУчетаПереоценки);
		Запрос.УстановитьПараметр("СчетЗатратВСтоимости",			СчетЗатратВСтоимости);
		Запрос.УстановитьПараметр("ТЧ",								ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, Количество, Сумма"));
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ЦенныеБумаги.Количество КАК Количество,
			|	ЦенныеБумаги.Сумма КАК Сумма
			|ПОМЕСТИТЬ _ТЧ
			|ИЗ
			|	&ТЧ КАК ЦенныеБумаги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТЧ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(_ТЧ.Количество) КАК Количество,
			|	СУММА(_ТЧ.Сумма) КАК Сумма
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	_ТЧ КАК _ТЧ
