			|		ИНАЧЕ -ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
			|		ИНАЧЕ -ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
			|	КОНЕЦ,
			|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,
			|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,
			|	ВЫБОР
			|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Единый.КорреспонденцияСАктивом)
			|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.Счет
			|	КОНЕЦ
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&МоментДокумента,
			|			Счет = &СчетЦБ,
			|			&ВидыСубконтоЦБ,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Субконто1 = &ОснованиеРасчетов) КАК ЕдиныйБухгалтерскийУчетОстатки";
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт КАК СчетДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
			|	NULL КАК СубконтоДт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт КАК СчетКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
			|	NULL КАК СубконтоКт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаДт КАК ВалютаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаКт КАК ВалютаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоДт КАК КоличествоДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоКт КАК КоличествоКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Сумма КАК Сумма,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаДт КАК ДополнительнаяАналитикаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаКт КАК ДополнительнаяАналитикаКт
			|ПОМЕСТИТЬ Движения
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ДвиженияССубконто(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Счет = &СчетДС
			|				И Субконто1 = &ОснованиеРасчетов
			|				И Активность,
			|			,
			|			) КАК ЕдиныйБухгалтерскийУчетДвиженияССубконто
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт1,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт,
