Функция ПолучитьМаксимальнуюДатуДействия(ОбъектДокумента, ВидАктива) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
        |	ЗначенияДополнительныхСведений.Значение КАК Срок
        |ИЗ
        |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
        |			&Период,
        |			Организация = &Организация
        |				И СчетДоверительногоУправления = &СчетДУ) КАК КлиентыДоверительногоУправленияСрезПоследних
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
        |		ПО (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнениеПравил))
        |			И (Договоры.Основание = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
        |		ПО (ЗначенияДополнительныхСведений.Объект = Договоры.Ссылка)
        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
        |		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
        |ГДЕ
        |	ЗначенияДополнительныхСведений.Свойство.Ключ = ""ПИФ.СрокДействияПрофСуждения""
        |	И Договоры.ДатаЗаключения <= &Период
        |	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
        |			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
        |
        |УПОРЯДОЧИТЬ ПО
        |	Договоры.ДатаЗаключения УБЫВ";


	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("Период", ОбъектДокумента.Дата);
	Запрос.УстановитьПараметр("СчетДУ", ОбъектДокумента.СчетДоверительногоУправления);

	Срок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Срок = Выборка.Срок;
	КонецЦикла;
	
	Если Срок = 0 Тогда
		Срок = 6;
	КонецЕсли;
	
	Если ВидАктива = Перечисления.ВидыАктивов.Обеспечение Тогда
		Возврат ДобавитьМесяц(ОбъектДокумента.Дата, Срок);
	Иначе
		Возврат ДобавитьМесяц(ОбъектДокумента.ДатаОценки, Срок);
	КонецЕсли;
	
КонецФункции
