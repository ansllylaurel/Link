&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.Основания.Доступность = НЕ ДанныеОбъекта.ЭтоОтмена;
	
	// входящий документ
	ВидимостьВходящийДокумент = НуженВходящийДокумент(ДанныеОбъекта);
	Если НЕ ВидимостьВходящийДокумент Тогда
		Форма.ВходящийДокумент = Ложь;
	КонецЕсли;
	Элементы.ВходящийДокумент.Видимость = ВидимостьВходящийДокумент;
	Элементы.ВидВходящегоДокумента.Видимость   = Форма.ВходящийДокумент;
	Элементы.НомерВходящегоДокумента.Видимость = Форма.ВходящийДокумент;
	Элементы.ДатаВходящегоДокумента.Видимость  = Форма.ВходящийДокумент;
	
	ЭтоКредиторскаяЗадолженность = ЭтоКредиторскаяЗадолженность(ДанныеОбъекта.ОснованиеДляКорректировки);
	
	Элементы.ГрузоотправительНужен.Видимость = Форма.ВестиУчетНДС И ЭтоКредиторскаяЗадолженность;
	Элементы.Грузоотправитель.Видимость = Форма.ВестиУчетНДС И ЭтоКредиторскаяЗадолженность
				И Форма.ГрузоотправительНужен;
	Элементы.КПП.Видимость = Форма.ВестиУчетНДС И ЭтоКредиторскаяЗадолженность;
	Элементы.КомандаПрисвоитьНомерСчетаФактурыВыданного.Видимость = Форма.ВестиУчетНДС И НЕ ЭтоКредиторскаяЗадолженность;
	
	Элементы.Договор.Видимость =
		(Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии") 
			Или ПринадлежитГруппеЗадолженностей(Форма.ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия"))
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимУслугам")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимДоходам")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыНаКоммунальныеУслуги")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоИнымДоходамПоИмуществу"));
	
	// основания и ценные бумаги
	Элементы.ОснованияОснованиеДо.Видимость =
		(Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоТорговойКомиссии")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение"));
	Элементы.ОснованияОснованиеПосле.Видимость = Элементы.ОснованияОснованиеДо.Видимость;			
	
	Элементы.ОснованияЦеннаяБумагаДо.Видимость =
		(Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии")
			Или Форма.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоТорговойКомиссии"));
	Элементы.ОснованияЦеннаяБумагаПосле.Видимость = Элементы.ОснованияЦеннаяБумагаДо.Видимость;
	
	ЭтоИсходящаяУслуга = ЭтоИсходящаяУслуга(ДанныеОбъекта.ОснованиеДляКорректировки);
	ЭтоПеревыставляемаяУслуга = Ложь; //ЭтоПеревыставляемаяУслуга(ДанныеОбъекта.ОснованиеДляКорректировки);
	СодержаниеИспользуетсяДляХраненияДанных = СодержаниеИспользуетсяДляХраненияДанных(ДанныеОбъекта.ОснованиеДляКорректировки);
	
	Элементы.ОснованияСтавкаНДСДо.Видимость	= (ЭтоИсходящаяУслуга И НЕ ЭтоПеревыставляемаяУслуга);
	Элементы.ОснованияСтавкаНДСПосле.Видимость = Элементы.ОснованияСтавкаНДСДо.Видимость;
	Элементы.ОснованияСуммаНДСДо.Видимость 	= (ЭтоИсходящаяУслуга И НЕ ЭтоПеревыставляемаяУслуга);
	Элементы.ОснованияСуммаНДСПосле.Видимость = Элементы.ОснованияСуммаНДСДо.Видимость;
	
	Элементы.ОснованияСодержаниеДо.Видимость = Форма.ВестиУчетНДС И НЕ СодержаниеИспользуетсяДляХраненияДанных;
	Элементы.ОснованияСодержаниеПосле.Видимость = Элементы.ОснованияСодержаниеДо.Видимость;
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ВидВходящегоДокумента"  , "Объект.ВидВходящегоДокумента");
    	ПутьКДаннымСкрываемыхПолей.Вставить("НомерВходящегоДокумента", "Объект.НомерВходящегоДокумента");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаВходящегоДокумента" , "Объект.ДатаВходящегоДокумента");
		ПутьКДаннымСкрываемыхПолей.Вставить("НомерСчетаФактуры" 	 , "Объект.НомерСчетаФактуры");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаСчетаФактуры" 	 	 , "Объект.ДатаСчетаФактуры");
		ПутьКДаннымСкрываемыхПолей.Вставить("Договор"                , "Объект.Договор");
		//ПутьКДаннымСкрываемыхПолей.Вставить("Грузоотправитель"  	 , "Объект.Грузоотправитель");
			
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция СодержаниеИспользуетсяДляХраненияДанных(ОснованиеДляКорректировки) 
	Если ЗначениеЗаполнено(ОснованиеДляКорректировки) Тогда
		Возврат Документы.НачислениеЗадолженности.СодержаниеИспользуетсяДляХраненияДанных(ОснованиеДляКорректировки.ВидЗадолженности)
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИсходящаяУслуга(ОснованиеДляКорректировки)
	Если ЗначениеЗаполнено(ОснованиеДляКорректировки) Тогда
		Возврат Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ОснованиеДляКорректировки.ВидЗадолженности);
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПеревыставляемаяУслуга(ОснованиеДляКорректировки)
	Если ЗначениеЗаполнено(ОснованиеДляКорректировки) Тогда
		Возврат Справочники.ВидыЗадолженности.ЭтоПеревыставляемаяУслуга(ОснованиеДляКорректировки.ВидЗадолженности);
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКредиторскаяЗадолженность(ОснованиеДляКорректировки)
	Если ЗначениеЗаполнено(ОснованиеДляКорректировки) Тогда
		Возврат Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ОснованиеДляКорректировки.ВидЗадолженности) = Перечисления.ТипыЗадолженности.Кредиторская;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция НуженВходящийДокумент(ОбъектФормы)
	
	Объект = ДанныеФормыВЗначение(ОбъектФормы, Тип("ДокументОбъект.КорректировкаЗадолженности"));
	
	Возврат Объект.НуженВходящийДокумент();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПринадлежитГруппеЗадолженностей(ВидЗадолженности, Группа)
	Если НЕ ЗначениеЗаполнено(ВидЗадолженности) Тогда
		Возврат Ложь;
	Иначе
		Возврат ВидЗадолженности.ПринадлежитЭлементу(Группа);
	КонецЕсли;
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаПослеПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

	РассчитатьСуммыИзменений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаНДСПослеПриИзменении(Элемент)
	
	РассчитатьСуммыИзменений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСтавкаНДСПослеПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

	РассчитатьСуммыИзменений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеДляКорректировкиПриИзменении(Элемент)
	
	Если Объект.Основания.Количество() = 0 Или Вопрос("Табличная часть документа будет заполнена заново. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Объект.Основания.Очистить();
		ЗаполнитьНаОсновании();
		РассчитатьСуммыИзменений();
	КонецЕсли;
	
	ПолучитьРеквизитыОснования();	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЭтоОтменаПриИзмененииНаСервере()
	
	Если Объект.ЭтоОтмена Тогда
		Для Каждого Строка Из Объект.Основания Цикл
			Строка.СуммаПосле = 0;
			Строка.СуммаНДСПосле = 0;
			Строка.ДатаОплатыПосле = 0;
			Строка.СтавкаНДСПосле = 0;
		КонецЦикла;
	КонецЕсли;
	
	РассчитатьСуммыИзменений();
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоОтменаПриИзменении(Элемент)
	ЭтоОтменаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере 
Процедура ОснованияПриИзмененииНаСервере(НомерСтроки)
	ЗаполнитьВспомогательныеКолонкиНаСервере(Объект.Основания[НомерСтроки - 1]);
КонецПроцедуры

&НаКлиенте
Процедура ОснованияПриИзменении(Элемент)
	
	ТД = Элементы.Основания.ТекущиеДанные;
	Если ТД <> Неопределено Тогда
		ОснованияПриИзмененииНаСервере(ТД.НомерСтроки);
	КонецЕсли;
	
	РассчитатьСуммыИзменений();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Для Каждого Строка Из Объект.Основания Цикл
		ЗаполнитьВспомогательныеКолонкиНаСервере(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияОснованиеПослеПриИзменении(Элемент)
	
	ТД = Элементы.Основания.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТД.ОснованиеПосле) Тогда
		ТД.ОснованиеПосле = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияЦеннаяБумагаПослеПриИзменении(Элемент)
	
	ТД = Элементы.Основания.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТД.ЦеннаяБумагаПосле) Тогда
		ТД.ЦеннаяБумагаПосле = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.Элементы.ОснованиеДляКорректировки.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.НачислениеЗадолженности");
	
	ЭтаФорма.ВходящийДокумент             = ЗначениеЗаполнено(Объект.ВидВходящегоДокумента);
	ЭтаФорма.ВестиУчетНДС				  = РаботаСНДС.ВестиУчетНДС(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	ЭтаФорма.ГрузоотправительНужен = ЗначениеЗаполнено(Объект.Грузоотправитель);
	Если ЭтаФорма.ВестиУчетНДС Тогда
		ЭтаФорма.Элементы.ВидВходящегоДокумента.РежимВыбораИзСписка = Истина;
		ЭтаФорма.Элементы.ВидВходящегоДокумента.СписокВыбора.Очистить();
		// счет-фактура указывается в отдельном реквизите
		Для сц = 0 по Перечисления.ВидыВходящихДокументов.Количество()-1 Цикл
			ТекВидВходящегоДокумента = Перечисления.ВидыВходящихДокументов.Получить(сц);
			Если ТекВидВходящегоДокумента <> Перечисления.ВидыВходящихДокументов.СчетФактура Тогда 
				ЭтаФорма.Элементы.ВидВходящегоДокумента.СписокВыбора.Добавить(ТекВидВходящегоДокумента);
			КонецЕсли;
		КонецЦикла;
		
		ОбновитьКПП();
	Иначе
		ЭтаФорма.Элементы.ВидВходящегоДокумента.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
	
	
	ПолучитьРеквизитыОснования();
	
	Для Каждого Строка Из Объект.Основания Цикл
		ЗаполнитьВспомогательныеКолонкиНаСервере(Строка);
	КонецЦикла;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	РассчитатьСуммыИзменений();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыИзменений()
	
	УвеличениеСуммы = 0;
	УвеличениеСуммыНДС = 0;
	УменьшениеСуммы = 0;
	УменьшениеСуммыНДС = 0;
	
	Для Каждого Строка Из Объект.Основания Цикл
		
		ИзмениеСуммы = Строка.СуммаПосле - Строка.СуммаДо;
		ИзмениеСуммыНДС = Строка.СуммаНДСПосле - Строка.СуммаНДСДо;
		
		Если ИзмениеСуммы > 0 Тогда
			УвеличениеСуммы = УвеличениеСуммы + ИзмениеСуммы;
		Иначе
			УменьшениеСуммы = УменьшениеСуммы - ИзмениеСуммы;
		КонецЕсли;
		
		Если ИзмениеСуммыНДС > 0 Тогда
			УвеличениеСуммыНДС = УвеличениеСуммыНДС + ИзмениеСуммыНДС;
		Иначе
			УменьшениеСуммыНДС = УменьшениеСуммыНДС - ИзмениеСуммыНДС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте 
Процедура РассчитатьСуммуНДС(ТекущиеДанные)
	
	СтавкаНДС = РаботаСНалогамиКлиентСервер.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДСПосле);

	ТекущиеДанные.СуммаНДСПосле = ТекущиеДанные.СуммаПосле * СтавкаНДС/(100 + СтавкаНДС);
	
КонецПроцедуры	

&НаСервере 
Процедура ЗаполнитьНаОсновании()
	
	ДокументКорректировка = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.КорректировкаЗадолженности"));
	ДокументКорректировка.Заполнить(Объект.ОснованиеДляКорректировки);
	ЗначениеВДанныеФормы(ДокументКорректировка, Объект);
	
	Для Каждого Строка Из Объект.Основания Цикл
		ЗаполнитьВспомогательныеКолонкиНаСервере(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Процедура ЗаполнитьВспомогательныеКолонкиНаСервере(Строка)
	Строка.ОписаниеДо		= "до изменения:";
	Строка.ОписаниеПосле 	= "после изменения:";
КонецПроцедуры

&НаКлиенте
Процедура ПолныйДоступКТабличнойЧастиПриИзменении(Элемент)
	НастроитьВидимостьДоступность(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыОснования()
	
	Если ТипЗнч(Объект.ОснованиеДляКорректировки) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ОснованиеДляКорректировки, "Контрагент, Договор, ВидЗадолженности, Валюта");
		ВидЗадолженности 	 = ДанныеДокумента.ВидЗадолженности;
		Валюта 				 = ДанныеДокумента.Валюта;
	Иначе
		ВидЗадолженности 	 = Справочники.ВидыЗадолженности.ПустаяСсылка();
		Валюта 				 = Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящийДокументПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры


&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ВходящийДокумент Тогда
		Если Не ЗначениеЗаполнено(Объект.ВидВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вид входящего документа"" не заполнено",, "Объект.ВидВходящегоДокумента",, Отказ);
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(Объект.НомерВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Номер входящего документа"" не заполнено",, "Объект.НомерВходящегоДокумента",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ДатаВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата входящего документа"" не заполнено",, "Объект.ДатаВходящегоДокумента",, Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГрузоотправительНуженПриИзменении(Элемент)
	
	Если НЕ ГрузоотправительНужен Тогда
		Объект.Грузоотправитель = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
		ЭтаФорма.Модифицированность = Истина;
		ОбновитьКПП();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКПП()
	
	ЭтаФорма.КПП = "";

	Если ЗначениеЗаполнено(Объект.Контрагент) ИЛИ ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика <> """"
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика
			|		ИНАЧЕ РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП
			|	КОНЕЦ КАК КПП
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|			&Дата,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
		
		Запрос.УстановитьПараметр("Дата", Объект.Дата);
		Запрос.УстановитьПараметр("ЮрФизЛицо", ?(ЗначениеЗаполнено(Объект.Грузоотправитель), Объект.Грузоотправитель, Объект.Контрагент));
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЭтаФорма.КПП = ВыборкаДетальныеЗаписи.КПП;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузоотправительПриИзменении(Элемент)
	ОбновитьКПП();
КонецПроцедуры

&НаСервере
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.ДатаСчетаФактуры) Тогда
		Объект.ДатаСчетаФактуры = Объект.Дата;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|		ЕСТЬNULL(МАКСИМУМ(ВЫРАЗИТЬ(КорректировкаЗадолженности.НомерСчетаФактуры КАК СТРОКА(100))), 0) КАК НомерСчетаФактуры
		|	ИЗ
		|		Документ.КорректировкаЗадолженности КАК КорректировкаЗадолженности
		|	ГДЕ
		|		КорректировкаЗадолженности.ОснованиеДляКорректировки = &ОснованиеДляКорректировки
		|		И КорректировкаЗадолженности.ДатаСчетаФактуры МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ГОД) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|		И КорректировкаЗадолженности.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ОснованиеДляКорректировки", Объект.ОснованиеДляКорректировки);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ВыборкаДанных = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДанных.Следующий() Тогда
		ПредыдущийНомер = ВыборкаДанных.НомерСчетаФактуры;
		Попытка 
			Объект.НомерСчетаФактуры = Число("0"+ПредыдущийНомер) + 1;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить номер счета-фактуры для предыдущего номера " 
				+ ПредыдущийНомер,,,,);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданного(Команда)
	
	КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере();
	
КонецПроцедуры


