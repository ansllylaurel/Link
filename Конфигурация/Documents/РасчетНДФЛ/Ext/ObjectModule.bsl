Функция ПолучитьДанныеДляНачисленияНалога(Запрос, ДатаРасчетаНДФЛ, ОсновнаяСтавка)
	
	Организация = ЭтотОбъект.Организация;
	СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления; 
	Период = КонецДня(ДатаРасчетаНДФЛ); 
	
	
	Запрос.УстановитьПараметр("ОсновнаяСтавка", ОсновнаяСтавка);
	
	АктивыЦБ = Новый Массив;
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.Акции);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративные);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.Паи);
	АктивыЦБ.Добавить(Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов);
	
	АктивыАкции = Новый Массив;
	АктивыАкции.Добавить(Справочники.УчетныеАктивы.Акции);
	АктивыАкции.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);

 	АктивыПроценты = Новый Массив;
	АктивыПроценты.Добавить(Справочники.УчетныеАктивы.ДепозитныеВклады);
	АктивыПроценты.Добавить(Справочники.УчетныеАктивы.ПроцентыНаМНО);
	
	Комиссии = Новый Массив;
	Комиссии.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
	Комиссии.Добавить(Справочники.ВидыЗадолженности.БанковскаяКомиссия);
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления); 
	Запрос.УстановитьПараметр("ДатаКонечная", Период); 
	Запрос.УстановитьПараметр("ДатаКонечнаяГраница", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаНачальная", НачалоГода(Период));  //всегда считаем с начала года. Если были движения задним числом, они должны быть скорретированы новом расчете
	// по ИИС никогда не будет движений пл НДФЛ за прошлые периоды, кроме дивидендов. 
	Запрос.УстановитьПараметр("ЭтоИИС", СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	Запрос.УстановитьПараметр("Клиент", Клиент);
 		
	Запрос.УстановитьПараметр("АктивыЦБ", АктивыЦБ); 
	Запрос.УстановитьПараметр("АктивыАкции", АктивыАкции); 
	Запрос.УстановитьПараметр("АктивыПроценты", АктивыПроценты); 
	Запрос.УстановитьПараметр("Комиссии", Комиссии); 

	
	ГодОтчета = Год(Период);   
	Если ГодОтчета >= 2025 Тогда
		Запрос.УстановитьПараметр("ГодПравил", "2025");      // Добавился код 3023. Код действует с 2021 года, но мы применяем его с 2025
	ИначеЕсли ГодОтчета >= 2021 Тогда
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда
			Запрос.УстановитьПараметр("ГодПравил", "2025");  // для ИИС будем использовать код 3023 с 21 года, т.к. по ИИС делаем только закрытие договора. 
		Иначе
			Запрос.УстановитьПараметр("ГодПравил", "2021");
		КонецЕсли;
	ИначеЕсли ГодОтчета >= 2018 Тогда
		Запрос.УстановитьПараметр("ГодПравил", "2018");
	Иначе
		Запрос.УстановитьПараметр("ГодПравил", "до2018");
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
		|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|	КОНЕЦ КАК АналитикаДоходовОтРеализации,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
		|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
		|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|	КОНЕЦ КАК АналитикаДоходовПоследнееПогашение,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
		|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
		|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
		|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|	КОНЕЦ КАК АналитикаДоходовОтПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаПерекурсовки КАК АналитикаПерекурсовки
		|ПОМЕСТИТЬ _НастройкиУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаКонечная,
