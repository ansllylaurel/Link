Функция ПолучитьДанныеДляНачисленияНалогаПоДивидендам(Запрос, ДатаРасчетаНДФЛ)	
	
	Организация = ЭтотОбъект.Организация;
	СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления; 
	Период = КонецДня(ДатаРасчетаНДФЛ);	
	
	// на момент заполнения документа проводок по НУ может не быть. 
	// сведения о дивидендах берем из регистра ЗадолженностиПоДенежнымСредствам 
	
	АктивыАкции = Новый Массив;
	АктивыАкции.Добавить(Справочники.УчетныеАктивы.Акции);
	АктивыАкции.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления); 
	Запрос.УстановитьПараметр("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период)); 
	Запрос.УстановитьПараметр("ДатаКонечная",  КонецДня(Период)); 
	Запрос.УстановитьПараметр("ДатаКонечнаяГраница", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая)); 
	Запрос.УстановитьПараметр("ОплатыПоДивидендам", ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));   
	// Расчет можем делать не в дату оплаты. Возьмем данные непосредтвенно из движений, сделанных оплатами
	
	// может быть несколько начислений дивидендов в 1 день. Эта ситуация не смоделирована. 
	
	Запрос.УстановитьПараметр("ДатаНачальная", НачалоДня(Период));  
	
//	Запрос.УстановитьПараметр("АктивыАкции", АктивыАкции); 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ГОД(ЗадолженностиПоДенежнымСредствам.Период) КАК Год,
		|	МЕСЯЦ(ЗадолженностиПоДенежнымСредствам.Период) КАК Месяц,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК ДокументНачисление,
		|	НачислениеДивидендов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(НачислениеДивидендов.СуммаОбъявленная * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2)) КАК СуммаОбъявленная,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК ИдСобытия
		|ПОМЕСТИТЬ _НачисленияДивидендов
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеДивидендов КАК НачислениеДивидендов
		|		ПО ЗадолженностиПоДенежнымСредствам.Основание = НачислениеДивидендов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаКонечная,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.НРД)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.КорпоративноеСобытиеПоВыплатеДивидендов)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (НачислениеДивидендов.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО ЗадолженностиПоДенежнымСредствам.Валюта = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ) = КурсыВалют.Период)
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор В(&ОплатыПоДивидендам)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
		|	И ЗадолженностиПоДенежнымСредствам.Активность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НачисленияДивидендов.СуммаОбъявленная КАК Сумма,
		|	ВЫБОР
		|		КОГДА ДивидендыПоАкциямСрезПоследних.Д1 = 0
		|				ИЛИ ДивидендыПоАкциямСрезПоследних.Д1 ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДивидендыПоАкциямСрезПоследних.Д1 > ДивидендыПоАкциямСрезПоследних.Д2
		|					ТОГДА ВЫРАЗИТЬ(_НачисленияДивидендов.СуммаОбъявленная * ДивидендыПоАкциямСрезПоследних.Д2 / ДивидендыПоАкциямСрезПоследних.Д1 КАК ЧИСЛО(19, 2))
		|				ИНАЧЕ _НачисленияДивидендов.СуммаОбъявленная
		|			КОНЕЦ
		|	КОНЕЦ КАК Вычет,
		|	_НачисленияДивидендов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НачисленияДивидендов.Год КАК Год,
		|	_НачисленияДивидендов.Месяц КАК Месяц,
		|	ДивидендыПоАкциямСрезПоследних.Д1 КАК Д1,
		|	ДивидендыПоАкциямСрезПоследних.Д2 КАК Д2
		|ПОМЕСТИТЬ _ВычетыПоДивидендам
		|ИЗ
		|	_НачисленияДивидендов КАК _НачисленияДивидендов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДивидендыПоАкциям.СрезПоследних(
		|				&ДатаКонечная,
		|				ИдСобытияПоВыплатеДивидендов В
		|					(ВЫБРАТЬ
		|						_НачисленияДивидендов.ИдСобытия КАК ИдСобытия
		|					ИЗ
		|						_НачисленияДивидендов КАК _НачисленияДивидендов)) КАК ДивидендыПоАкциямСрезПоследних
		|		ПО _НачисленияДивидендов.ЦеннаяБумага = ДивидендыПоАкциямСрезПоследних.Акция
		|			И _НачисленияДивидендов.ИдСобытия = ДивидендыПоАкциямСрезПоследних.ИдСобытияПоВыплатеДивидендов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ВидНалогооблагаемойБазы КАК ВидНалогооблагаемойБазы,
		|	ВложенныйЗапрос.ВидДохода КАК ВидДохода,
		|	ВложенныйЗапрос.ВидВычета КАК ВидВычета,
		|	СУММА(ВложенныйЗапрос.СуммаДохода) КАК СуммаДохода,
		|	СУММА(ВложенныйЗапрос.СуммаРасхода) КАК СуммаРасхода,
		|	СУММА(ВложенныйЗапрос.СуммаНДФЛДоход) КАК СуммаНДФЛДоход,
		|	СУММА(ВложенныйЗапрос.СуммаНДФЛВычет) КАК СуммаНДФЛВычет,
		|	0 КАК СуммаНалога,
		|	ЛОЖЬ КАК РаспределятьРасход,
		|	0 КАК РаспределяемыеРасходы
		|ПОМЕСТИТЬ _ДвиженияНДФЛ
		|ИЗ
		|	(ВЫБРАТЬ
		|		БазаНачисленияНДФЛОбороты.ВидНалогооблагаемойБазы КАК ВидНалогооблагаемойБазы,
		|		БазаНачисленияНДФЛОбороты.ВидДоходаВычета КАК ВидДохода,
		|		БазаНачисленияНДФЛОбороты.ВидДоходаВычета.ВидВычета КАК ВидВычета,
		|		БазаНачисленияНДФЛОбороты.СуммаОборот КАК СуммаДохода,
		|		0 КАК СуммаРасхода,
		|		БазаНачисленияНДФЛОбороты.СуммаНДФЛОборот КАК СуммаНДФЛДоход,
		|		0 КАК СуммаНДФЛВычет
		|	ИЗ
		|		РегистрНакопления.БазаНачисленияНДФЛ.Обороты(
		|				,
		|				&ДатаКонечнаяГраница,
		|				,
		|				Организация = &Организация
		|					И ФизЛицо = &Клиент
		|					И ГОД(ДатаПолученияДохода) = ГОД(&ДатаКонечная)) КАК БазаНачисленияНДФЛОбороты
		|	ГДЕ
		|		ТИПЗНАЧЕНИЯ(БазаНачисленияНДФЛОбороты.ВидДоходаВычета) = ТИП(Справочник.ВидыДоходовНДФЛ)
		|		И БазаНачисленияНДФЛОбороты.ВидНалогооблагаемойБазы = ЗНАЧЕНИЕ(Перечисление.ВидыНалогооблагаемыхБаз.ПоДивидендам)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ВидНалогооблагаемойБазы,
		|	ВложенныйЗапрос.ВидДохода,
		|	ВложенныйЗапрос.ВидВычета
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	NULL,
		|	NULL,
		|	0,
		|	0,
		|	0,
		|	0,
		|	СУММА(НачисленияНалоговОбороты.СуммаОборот),
		|	ЛОЖЬ,
		|	0
		|ИЗ
		|	РегистрНакопления.НачисленияНалогов.Обороты(
		|			&ДатаНачальная,
		|			&ДатаКонечнаяГраница,
		|			Регистратор,
		|			Организация = &Организация
		|				И Налогоплательщик = &Клиент) КАК НачисленияНалоговОбороты
		|ГДЕ
		|	ВЫРАЗИТЬ(НачисленияНалоговОбороты.Регистратор КАК Документ.РасчетНДФЛ).ОснованиеРасчета = ЗНАЧЕНИЕ(Перечисление.ОснованияРасчетаНДФЛ.ВыплатаДивидендов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыНалогооблагаемыхБаз.ПоДивидендам) КАК ВидНалогооблагаемойБазы,
		|	_ВычетыПоДивидендам.Год КАК Год,
		|	_ВычетыПоДивидендам.Месяц КАК Месяц,
		|	ЗНАЧЕНИЕ(Справочник.ВидыДоходовНДФЛ.Код1010) КАК ВидДохода,
		|	ЗНАЧЕНИЕ(Справочник.ВидыВычетовНДФЛ.Код601) КАК ВидВычета,
		|	СУММА(_ВычетыПоДивидендам.Сумма) КАК СуммаДохода,
		|	СУММА(_ВычетыПоДивидендам.Вычет) КАК СуммаРасхода,
		|	СУММА(_ВычетыПоДивидендам.Сумма) КАК СуммаНДФЛДоход,
		|	СУММА(_ВычетыПоДивидендам.Вычет) КАК СуммаНДФЛВычет,
		|	ЛОЖЬ КАК РаспределятьРасход,
		|	0 КАК СуммаНалога,
		|	0 КАК СуммаУменьшающаяНалог,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка13) КАК СтавкаНДФЛ,
		|	0 КАК РаспределяемыеРасходы
		|ИЗ
		|	_ВычетыПоДивидендам КАК _ВычетыПоДивидендам
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВычетыПоДивидендам.Год,
		|	_ВычетыПоДивидендам.Месяц";  
	
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьБазуДвиженийНДФЛ(ДатаРасчета, ОсновнаяСтавка, Отказ = Ложь) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Если ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов Тогда
		ТаблицаНОБ = ПолучитьДанныеДляНачисленияНалогаПоДивидендам(Запрос, ДатаРасчета);
	Иначе 
		ТаблицаНОБ = ПолучитьДанныеДляНачисленияНалога(Запрос, ДатаРасчета, ОсновнаяСтавка);
	КонецЕсли; 
	
	ДвиженияНДФЛ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДвиженияНДФЛ").ПолучитьДанные().Выгрузить();	
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТаблицаНОБ", ТаблицаНОБ);
	Результат.Вставить("ДвиженияНДФЛ", ДвиженияНДФЛ);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧасть(Отказ = Ложь) Экспорт

	Перем ДанныеПрошлыхЛет;
	
	ЭтоРезидент = Справочники.ЮрФизЛица.ЯвляетсяРезидентом(Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата), ЭтотОбъект.Организация, Дата);
	Если ЭтоРезидент <> Неопределено Тогда 
		Если ЭтоРезидент Тогда 
			ОсновнаяСтавка = Перечисления.СтавкиНДФЛ.Ставка13;
		Иначе
			ОсновнаяСтавка = Перечисления.СтавкиНДФЛ.Ставка30;
		КонецЕсли;	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СчетДоверительногоУправления + " на " + Формат(Дата, "ДФ=dd.MM.yyyy") + " не заполнены анкетные данные. Статус резидента неопределен.");
		Возврат;
	КонецЕсли;	

	//Документы за прошлые годы по ИИС
	Если ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику 
		ИЛИ ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.КорректировкаНалога 
		ИЛИ (ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.РасторжениеДоговора И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		ИЛИ (ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаНаследнику И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет) Тогда
					
		ГодОт = Год(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения);
		ГодДо = Год(ЭтотОбъект.ДатаРасчета)-1;
		Для ГодРасчета=ГодОт по ГодДо Цикл 
			ДатаРасчетаПрошлое = Дата(ГодРасчета, 12, 31);
			
			Результат = ПолучитьБазуДвиженийНДФЛ(КонецДня(ДатаРасчетаПрошлое), ОсновнаяСтавка); //Результат = Документы.РасчетНДФЛ.Расчет_НДФЛ(Объект.Организация, Объект.СчетДоверительногоУправления, КонецДня(ДатаРасчетаПрошлое), ,Объект.ОснованиеРасчета);	
			Если Результат = Неопределено Тогда 
				Продолжить;
			КонецЕсли;				
			Если ДанныеПрошлыхЛет = Неопределено Тогда 
				ДанныеПрошлыхЛет = Результат.ТаблицаНОБ.Скопировать();
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(Результат.ТаблицаНОБ, ДанныеПрошлыхЛет); 
			Конецесли;	
		
		КонецЦикла;
		
	КонецЕсли;
	
	//Текущий период
	Результат = ПолучитьБазуДвиженийНДФЛ(ЭтотОбъект.ДатаРасчета, ОсновнаяСтавка);
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Если ДанныеПрошлыхЛет <> Неопределено Тогда
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеПрошлыхЛет, Результат.ТаблицаНОБ);
		Результат.ТаблицаНОБ.Сортировать("Год, Месяц");
	КонецЕсли;  
	
	Если Дата >= '2025.01.01' 
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда  // по ИСС только закрытие. По ФЛ с 2025 года. 
		УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ = Истина;
	Иначе
		УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ = Ложь;
	КонецЕсли;
		
	ВыполнитьРасчетНалоговойБазы(Результат.ТаблицаНОБ, Результат.ДвиженияНДФЛ, ОсновнаяСтавка, УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ);
	
	ЭтотОбъект.НалоговаяБаза2025.Очистить();
	Для Каждого СтрокаРезультат из Результат.ТаблицаНОБ Цикл    
		
		//могут быть строки с нулевыми показателями. мы их пропустим
		Если СтрокаРезультат.СуммаНДФЛДоход = 0 И СтрокаРезультат.СуммаНДФЛВычет = 0
			И СтрокаРезультат.СуммаДохода = 0 И СтрокаРезультат.СуммаРасхода = 0
			И СтрокаРезультат.СуммаНалога = 0 И СтрокаРезультат.РаспределяемыеРасходы = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ЭтотОбъект.НалоговаяБаза2025.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультат);
		
	КонецЦикла; 
	
	
КонецПроцедуры

Процедура ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, СтавкаНДФЛ, СуммаНалога)
	
	Если НалоговыеНачисленияПоДокументу = Неопределено Тогда
		НалоговыеНачисленияПоДокументу = Новый ТаблицаЗначений; 
		НалоговыеНачисленияПоДокументу.Колонки.Добавить("СтавкаНДФЛ"); 
		НалоговыеНачисленияПоДокументу.Колонки.Добавить("СуммаНалога"); 
	КонецЕсли;
	
	НоваяСтрока = НалоговыеНачисленияПоДокументу.Добавить();
	НоваяСтрока.СтавкаНДФЛ = СтавкаНДФЛ;
	НоваяСтрока.СуммаНалога = СуммаНалога;
	
КонецПроцедуры

Процедура РасчитатьСуммуНалогаПоДокументу(СуммаДохода, СуммаДоходаНаНачалоРасчета, СуммаНалогаРанееНачисленного, ПороговаяСумма, ОсновнаяСтавка, НалоговыеНачисленияПоДокументу)
	
	// вернем таблицу: сколько налога по какой ставке начислено
	// Расчет строк и округление нужно считатать по всем ставкам, что бы в случае выделения налога по ставке 15%
	// сумма налога по ставке 13% за всеть год была равна ровно ПороговаяСумма * 0.13 
	// если так не сделать,  то общая сумма будет правильная, но распределение налога по ставкам из-за округления может отличаться.
		
	СуммаДоходаСНачалаГода = СуммаДоходаНаНачалоРасчета + СуммаДохода; 
	
	ПовышеннаяСтавка = Перечисления.СтавкиНДФЛ.Ставка15;  //   0.15;  // Пока так. Возможно будут еще ступени    
	
	Если (ПороговаяСумма = 0) 
		ИЛИ (СуммаДоходаСНачалаГода <= ПороговаяСумма)  Тогда    
		// это нерезидент, древние времена когда не было повышенной ставки, или просто уложились в доход ниже порога
		СуммаНалогаСНачалаГода = Окр(СуммаДоходаСНачалаГода * РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(ОсновнаяСтавка), 0);  
		СуммаНалога = СуммаНалогаСНачалаГода - СуммаНалогаРанееНачисленного; 
		ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ОсновнаяСтавка, СуммаНалога);
	Иначе	
		СуммаНалогаСНачалаГода = ПороговаяСумма * РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(ОсновнаяСтавка) + Окр((СуммаДоходаСНачалаГода - ПороговаяСумма) * РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(ПовышеннаяСтавка), 0); 
		Если СуммаДоходаНаНачалоРасчета > ПороговаяСумма Тогда //Только 15% 
			СуммаНалога = СуммаНалогаСНачалаГода - СуммаНалогаРанееНачисленного; 
			ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ПовышеннаяСтавка, СуммаНалога);
		Иначе // делим 13, 15%  
			СуммаНалогаПороговая = ПороговаяСумма * РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(ОсновнаяСтавка);

			СуммаНалога13 =  СуммаНалогаПороговая - СуммаНалогаРанееНачисленного;
			СуммаНалога15 =  СуммаНалогаСНачалаГода - СуммаНалогаПороговая; 
			
			ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ОсновнаяСтавка, СуммаНалога13);
			ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ПовышеннаяСтавка, СуммаНалога15);
		КонецЕсли
	КонецЕсли; 
	
КонецПроцедуры

Процедура РасчетСуммыНалога(ТаблицаНОБ, СуммаДоходаНаНачалоРасчета, ПороговаяСумма, СуммаНалогаРанееНачисленного, ОсновнаяСтавка, СуммаНалогаКРаспределениюВведеннаяВручную = 0, ТолькоПересчет = Ложь) Экспорт
	
	Перем НалоговыеНачисленияПоДокументу;
	
	// ТолькоПересчет = Истина - Это вызов из формы документа при изменении руками табличной части. 

	Если ТолькоПересчет Тогда
		Если СуммаНалогаКРаспределениюВведеннаяВручную <> 0 Тогда  // только если считаем налог из формы в интерактивном режиме 
			РучнойРасчет = Истина;
			Погрешность = СуммаНалогаКРаспределениюВведеннаяВручную;
		Иначе
			РучнойРасчет = Ложь;
		КонецЕсли;
		Для Каждого СтрокаНОБ из ТаблицаНОБ Цикл
			ТекущаяСтавка = СтрокаНОБ.СтавкаНДФЛ;
			Ставка = РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(ТекущаяСтавка);
			Если Ставка <> Неопределено Тогда
				СуммаНалога = (СтрокаНОБ.СуммаНДФЛДоход - СтрокаНОБ.СуммаНДФЛВычет) * Ставка;
				ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ТекущаяСтавка, СуммаНалога);
				Если РучнойРасчет Тогда 
					Погрешность = Погрешность - СуммаНалога;
				КонецЕсли;
			Иначе 
				Продолжить;  
				//строка добавлена вручную. Ставка не заполнена
			КонецЕсли;
		КонецЦикла;
		Если РучнойРасчет И Погрешность <> 0 Тогда //тут бы не помешала проверка, что разница слишком большая. Погрешность должна быть не больше одного рубля
			ДобавитьСведенияОНалоге(НалоговыеНачисленияПоДокументу, ТекущаяСтавка, Погрешность); 
		КонецЕсли;
		
		Если НалоговыеНачисленияПоДокументу <> Неопределено Тогда
			НалоговыеНачисленияПоДокументу.Свернуть("СтавкаНДФЛ", "СуммаНалога");
			//Для Каждого СтрокаНачислений из НалоговыеНачисленияПоДокументу Цикл 
			//	СтрокаНачислений.СуммаНалога = Окр(СтрокаНачислений.СуммаНалога, 0);
			//КонецЦикла;
			СуммаНалогаКРаспределению = Окр(НалоговыеНачисленияПоДокументу.Итог("СуммаНалога"), 0); 
		Иначе
			СуммаНалогаКРаспределению = 0;
		КонецЕсли;
		
	Иначе
		
		СуммаДохода = ТаблицаНОБ.Итог("СуммаНДФЛДоход") - ТаблицаНОБ.Итог("СуммаНДФЛВычет");  // полученная между двумя расчетами 
		РасчитатьСуммуНалогаПоДокументу(СуммаДохода, СуммаДоходаНаНачалоРасчета, СуммаНалогаРанееНачисленного, ПороговаяСумма, ОсновнаяСтавка, НалоговыеНачисленияПоДокументу); 
		СуммаНалогаКРаспределению = НалоговыеНачисленияПоДокументу.Итог("СуммаНалога");
		//СуммаНалогаКРаспределению = РасчитатьСуммуНалогаПоДокументу(СуммаДохода, СуммаДоходаНаНачалоРасчета, СуммаНалогаРанееНачисленного, ПороговаяСумма, ОсновнаяСтавка);
				
		//проверим сумму вывода. Если сумма вывода меньше суммы налога, мы должны перезаполнить ТаблицаНОБ и взять налог с вывода
		Если ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыводАктивов Тогда
			СуммаВывода = ЭтотОбъект.Основания.Итог("Сумма");
			Если СуммаВывода < СуммаНалогаКРаспределению И СуммаВывода <> 0 Тогда
				//делаем одну строку. остальное удаляем
				
				ТаблицаНОБ.Сортировать("СуммаДохода Убыв");
				ЭталоннаяСтрока = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(ТаблицаНОБ[0]);
				
				ТаблицаНОБ.Очистить();
				ЗаполнитьЗначенияСвойств(ТаблицаНОБ.Добавить(), ЭталоннаяСтрока);
				ТаблицаНОБ[0].СуммаРасхода = 0;
				ТаблицаНОБ[0].СуммаНДФЛВычет = 0;
				ТаблицаНОБ[0].СуммаДохода = СуммаВывода;
				ТаблицаНОБ[0].СуммаНДФЛДоход = СуммаВывода;
				ТаблицаНОБ[0].Примечание = "Налог с суммы вывода";     
				
				СуммаДохода = СуммаВывода;
				РасчитатьСуммуНалогаПоДокументу(СуммаДохода, СуммаДоходаНаНачалоРасчета, СуммаНалогаРанееНачисленного, ПороговаяСумма, ОсновнаяСтавка, НалоговыеНачисленияПоДокументу);
			КонецЕсли; 
		КонецЕсли;
		
		Если (СуммаДоходаНаНачалоРасчета > ПороговаяСумма) Тогда 
			
			Для Каждого СтрокаНОБ из ТаблицаНОБ Цикл
				Если СтрокаНОБ.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка13 Тогда
					СтрокаНОБ.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли (СуммаДоходаНаНачалоРасчета < ПороговаяСумма)
			И ((СуммаДоходаНаНачалоРасчета + СуммаДохода )> ПороговаяСумма) Тогда
			
			РаспределяемаяСумма = ПороговаяСумма - СуммаДоходаНаНачалоРасчета;
			
			ТаблицаНОБ.Сортировать("СуммаНДФЛДоход Убыв");
			
			МассивУдаляемыхСтрок = Новый Массив;
			//делим доходы по ставке 13 и 15%
			Для Индекс = 0 по ТаблицаНОБ.Количество()-1 Цикл
				СтрокаТаблицы = ТаблицаНОБ[индекс];
				Если СтрокаТаблицы.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка0 Тогда 
					Продолжить;
				КонецЕсли;
				СуммаДоход = СтрокаТаблицы.СуммаНДФЛДоход - СтрокаТаблицы.СуммаНДФЛВычет; 
				Если СуммаДоход < 0 
					И СтрокаТаблицы.Примечание <> "Распределяемые расходы" Тогда
					Продолжить; //убыток по строке. не распределяем.
				КонецЕсли; 
				Если СуммаДоход > РаспределяемаяСумма И РаспределяемаяСумма <> 0 Тогда  // повезло. Есть доход по 15%
					Сумма15 = СтрокаТаблицы.СуммаНДФЛДоход - РаспределяемаяСумма;
					Сумма13 = РаспределяемаяСумма;

					//строка 15%
					НоваяСтрока = ТаблицаНОБ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					НоваяСтрока.СуммаДохода = Сумма15;
					НоваяСтрока.СуммаНДФЛДоход = Сумма15; 
					НоваяСтрока.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15;  
					
					//добавим строку 13%
					НоваяСтрока = ТаблицаНОБ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					НоваяСтрока.СуммаДохода = Сумма13;
					НоваяСтрока.СуммаНДФЛДоход = Сумма13; 
					НоваяСтрока.СуммаРасхода = 0;
					НоваяСтрока.СуммаНДФЛВычет = 0; 
					НоваяСтрока.РаспределяемыеРасходы = 0;  //оставим эту сумму в строке 15%
					
					//исходную строку надо удалить. мы ее разделили на две. 
					МассивУдаляемыхСтрок.Добавить(СтрокаТаблицы);
					РаспределяемаяСумма = 0;      
					
					// т.к. цикл по количеству строк, то по новым строкам цикл уже не будет идти.
				ИначеЕсли СуммаДоход <= РаспределяемаяСумма И РаспределяемаяСумма > 0 Тогда
					РаспределяемаяСумма = РаспределяемаяСумма - СуммаДоход; 
					//ничего не делаем, должно остаться 13%
					//?
				ИначеЕсли РаспределяемаяСумма = 0 И СтрокаТаблицы.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка13 Тогда
					СтрокаТаблицы.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15; 
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаДляУдаления из МассивУдаляемыхСтрок Цикл 
				ТаблицаНОБ.Удалить(СтрокаДляУдаления);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

	//собственно расчет налога.
	ТаблицаНОБ.Сортировать("СтавкаНДФЛ"); 
	
	Если НалоговыеНачисленияПоДокументу = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяЗапись из НалоговыеНачисленияПоДокументу Цикл
		
		РаспределяемыйНалог = ТекущаяЗапись.СуммаНалога;
		СтрокиНОБ = ТаблицаНОБ.НайтиСтроки(Новый Структура("СтавкаНДФЛ", ТекущаяЗапись.СтавкаНДФЛ));
		
		КоличествоСтрок = СтрокиНОБ.Количество();
		Для Индекс = 0 по КоличествоСтрок - 1 Цикл     
			
			Если СтрокиНОБ[Индекс].ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.ПоДивидендам Тогда 
				// по дивидендам у нас всегда будет только одна строка.  
				// Вычет по дивидендам не показываем в 2 НДФЛ. 
				Ставка = РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(СтрокиНОБ[Индекс].СтавкаНДФЛ);
				НалогИсчисленный  = Окр(СтрокиНОБ[Индекс].СуммаНДФЛДоход * Ставка, 0);   // Налог от полной суммы дивидендов.
				СуммаНалогПолучению = Окр((СтрокиНОБ[Индекс].СуммаНДФЛДоход - СтрокиНОБ[Индекс].СуммаНДФЛВычет) * Ставка, 0);  // налог удержанный. То что мы насчитали с учетом вычета
				СтрокиНОБ[Индекс].СуммаНалога = НалогИсчисленный;
				СтрокиНОБ[Индекс].СуммаУменьшающаяНалог = НалогИсчисленный - СуммаНалогПолучению;    // разница. Отражается в 2-НДФЛ и 6-НДФЛ
			Иначе
				Если Индекс < КоличествоСтрок - 1 Тогда  
					СуммаДоходПоСтроке = СтрокиНОБ[Индекс].СуммаНДФЛДоход - СтрокиНОБ[Индекс].СуммаНДФЛВычет;
					//Если СуммаДоходПоСтроке <= 0 И
					//	СтрокиНОБ[Индекс].Примечание <> "Распределяемые расходы" Тогда 
					//	СтрокиНОБ[Индекс].СуммаНалога = 0;
					//	Продолжить;
					//КонецЕсли;
					СуммаНалогПоСтроке = Окр(СуммаДоходПоСтроке * РаботаСНалогамиКлиентСервер.ЧисловоеЗначениеСтавкиНДФЛ(СтрокиНОБ[Индекс].СтавкаНДФЛ), 0);
					СтрокиНОБ[Индекс].СуммаНалога = СуммаНалогПоСтроке;
					РаспределяемыйНалог = РаспределяемыйНалог - СуммаНалогПоСтроке; 
				Иначе
					СтрокиНОБ[Индекс].СуммаНалога = РаспределяемыйНалог; 
					// налог в последней строке не считаем, чтобы избежать погрешности округления. 
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла
	
КонецПроцедуры 

Процедура РаспределитьРасходыНеЦБ(ТаблицаНОБ, ДвиженияНДФЛ = Неопределено, ОсновнаяСтавка, УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ) Экспорт
	
	// расходы поместим в колонку СуммаУмешьшающаДоход. 
	// сократим количество строк. Визуально будет понятно к какому доходу относится сумма, уменьшающая НОБ. 
	
	// распределение расходов, не связанных с ЦБ.
	Если ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыводАктивов Тогда
		РаспределятьРасходыНеЦБ = Ложь;
	Иначе
		РаспределятьРасходыНеЦБ = Истина;
	КонецЕсли;   	
	//СтрокаРасходыНеЦБ = ТаблицаНОБ.Найти(Истина, "РаспределятьРасход");  
	СтрокиРасходыНеЦБ = ТаблицаНОБ.НайтиСтроки(Новый Структура("РаспределятьРасход", Истина));  
	
	Если РаспределятьРасходыНеЦБ И СтрокиРасходыНеЦБ.Количество() > 0 Тогда
		
		ДанныеДляРасчета = ТаблицаНОБ.Скопировать(); 
		Если ДвиженияНДФЛ <> Неопределено Тогда 
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДвиженияНДФЛ, ДанныеДляРасчета);
		КонецЕсли;
		
		//удаляем строки, которые не нужны для распределения расходов.
		// 1) строки со значением РаспределятьРасход
		// 2) неучитывапемые доходы    - 6.11.2025 НЕ УБИРАЕМ! Распределяем расход по всем видам доходов, независимо от того, платим с них налог или нет. 
		// 3) строку с начисленным налогов из таблицы ДвиженияНДФЛ. см. запрос. 
		// 4) "НКД гос. и муницип. обл." и "НКД корп. обл. обращаемых, эмитированных после 01.01.2017". ИИС, старые периоды. По этим доходам налог не платим. Вычет принудительно ставим равным доходу. 
		//     распределять расходы не ЦБ на них не будем, так как налог = 0. 
		
		СуммаРаспределения = 0;
		
		Для индекс = -(ДанныеДляРасчета.Количество() - 1) по 0 Цикл 
			Если ДанныеДляРасчета[-индекс].РаспределятьРасход Тогда 
				СуммаРаспределения = СуммаРаспределения + ДанныеДляРасчета[-индекс].СуммаНДФЛВычет;
			КонецЕсли; 
			Если ДанныеДляРасчета[-индекс].РаспределятьРасход
				ИЛИ (ДанныеДляРасчета[-индекс].ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.НеучитываемыеДоходы И НЕ УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ)
				ИЛИ НЕ ЗначениеЗаполнено(ДанныеДляРасчета[-индекс].ВидНалогооблагаемойБазы) 
				ИЛИ (ДанныеДляРасчета[-индекс].Примечание = "НКД гос. и муницип. обл." 
					ИЛИ ДанныеДляРасчета[-индекс].Примечание = "НКД корп. обл. обращаемых, эмитированных после 01.01.2017") Тогда 
				ДанныеДляРасчета.Удалить(-индекс);
			КонецЕсли;
		КонецЦикла;

		ДанныеДляРасчета.Свернуть("ВидНалогооблагаемойБазы, ВидДохода, ВидВычета, Примечание", "СуммаДохода, СуммаРасхода, СуммаНДФЛДоход, СуммаНДФЛВычет, РаспределяемыеРасходы"); 
		
		Если ДанныеДляРасчета.Количество() = 0 Тогда
			// дохода в этом году нет. налог не платим. сумму не распределяем  
			// При закрытии ИИС строк со знаечнием РаспределятьРасход может быть несколько. По одной на каждый год расчета. В случае ИИС программа может в эту ветку не попасть. 
			Для Каждого СтрокаНОБ из ТаблицаНОБ Цикл 
				Если СтрокаНОБ.РаспределятьРасход Тогда
					СтрокаНОБ.СуммаНДФЛВычет = 0;  
				КонецЕсли;
			КонецЦикла;
		Иначе
			
			ОбщаяСуммаДохода = ДанныеДляРасчета.Итог("СуммаДохода");
			
			//распределим
			ОсталосьРаспределить = СуммаРаспределения;
			КоличествоЗначений = ДанныеДляРасчета.Количество(); 
			Для индекс = 0 по КоличествоЗначений - 1 Цикл
				ДобавкаРасход = Окр(СуммаРаспределения * ДанныеДляРасчета[индекс].СуммаДохода / ОбщаяСуммаДохода, 2);
				Если индекс <> КоличествоЗначений - 1 Тогда
					ДанныеДляРасчета[индекс].РаспределяемыеРасходы = ДобавкаРасход; 
					ОсталосьРаспределить = ОсталосьРаспределить - ДобавкаРасход;
				Иначе
					ДанныеДляРасчета[индекс].РаспределяемыеРасходы = ОсталосьРаспределить; 
				КонецЕсли;
			КонецЦикла;
			
			//удалим строки с расходамм не ЦБ и добавим новые с распределенными расходами. 
			// в последенем расчете могут быть не все виды доходов, а сумму мы распределили пропорционально годовым доходам
			
			Для Каждого СтрокаРасхода из СтрокиРасходыНеЦБ Цикл 
				ТаблицаНОБ.Удалить(СтрокаРасхода);
			КонецЦикла;   
			
			Для Каждого СтрокаТаблицы из ДанныеДляРасчета Цикл
				НоваяСтрока = ТаблицаНОБ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,,"СуммаДохода, СуммаРасхода, СуммаНДФЛДоход, СуммаНДФЛВычет, РаспределяемыеРасходы");
				НоваяСтрока.Год = Год(ЭтотОбъект.ДатаРасчета);
				НоваяСтрока.Месяц = Месяц(ЭтотОбъект.ДатаРасчета);   
				НоваяСтрока.СуммаДохода = 0;
				НоваяСтрока.СуммаНДФЛДоход = 0;
				НоваяСтрока.СуммаРасхода = 0;
				НоваяСтрока.СуммаНДФЛВычет = СтрокаТаблицы.РаспределяемыеРасходы;  //Распределяемые расходы уменьшают НОБ
				НоваяСтрока.РаспределяемыеРасходы = СтрокаТаблицы.РаспределяемыеРасходы; 
				Если НоваяСтрока.ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.НеучитываемыеДоходы Тогда
					НоваяСтрока.СуммаНДФЛВычет = 0;
					НоваяСтрока.СтавкаНДФЛ = Перечисления.СтавкиНДФЛ.Ставка0;
				Иначе
					НоваяСтрока.СтавкаНДФЛ = ОсновнаяСтавка;
				КонецЕсли;
			КонецЦикла; 
			
			
			ТаблицаНОБ.Свернуть("ВидНалогооблагаемойБазы, Год, Месяц, ВидДохода, ВидВычета, СтавкаНДФЛ, Примечание", "СуммаДохода, СуммаРасхода, СуммаНДФЛДоход, СуммаНДФЛВычет, РаспределяемыеРасходы, СуммаНалога")
		КонецЕсли;

	ИначеЕсли НЕ РаспределятьРасходыНеЦБ И СтрокиРасходыНеЦБ.Количество() > 0 Тогда
		Для Каждого СтрокаРасхода из СтрокиРасходыНеЦБ Цикл 
			ТаблицаНОБ.Удалить(СтрокаРасхода);
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьПереносУбытков(ТаблицаНОБ, ДвиженияНДФЛ, ОсновнаяСтавка) 
	
	//Перенос убытков на другие НОБ сделаю потом
	ТаблицаПереносаУбытков = Новый ТаблицаЗначений;
	ТаблицаПереносаУбытков.Колонки.Добавить("ВидНалогооблагаемойБазы");
	ТаблицаПереносаУбытков.Колонки.Добавить("ВидДохода");
	ТаблицаПереносаУбытков.Колонки.Добавить("ВидВычета");
	ТаблицаПереносаУбытков.Колонки.Добавить("СуммаУбытка");   
	
	КолонкиГруппировок = "ВидНалогооблагаемойБазы, ВидДохода, ВидВычета";
	КолонкиИтогов = "СуммаНДФЛДоход, СуммаНДФЛВычет";
	
	ДанныеДляРасчета = ТаблицаНОБ.Скопировать(, КолонкиГруппировок + ", " + КолонкиИтогов);
	ДанныеПрошлыхРасчетов = ДвиженияНДФЛ.Скопировать(, КолонкиГруппировок + ", " + КолонкиИтогов);

	РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеПрошлыхРасчетов, ДанныеДляРасчета);  
	ДанныеДляРасчета.Свернуть(КолонкиГруппировок, КолонкиИтогов);
	
	Для Каждого СтрокаДанные из ДанныеДляРасчета Цикл
		НОБ = СтрокаДанные.СуммаНДФЛДоход - СтрокаДанные.СуммаНДФЛВычет;
		Если НОБ < 0 Тогда  
			СтруктураПоиска = Новый Структура("ВидНалогооблагаемойБазы, ВидДохода, ВидВычета", СтрокаДанные.ВидНалогооблагаемойБазы, СтрокаДанные.ВидДохода, СтрокаДанные.ВидВычета);
			
			НайденныеСтроки = ТаблицаНОБ.НайтиСтроки(СтруктураПоиска);  //будет 1 строка. 
			Для Каждого СтрокаНОБ Из НайденныеСтроки Цикл 
				
				//Умешьшаем вычет
				СуммаУбытка = СтрокаНОБ.СуммаНДФЛВычет - СтрокаНОБ.СуммаНДФЛДоход;
				СтрокаНОБ.СуммаНДФЛВычет = СтрокаНОБ.СуммаНДФЛДоход;
				
				СтрокаПереноса = ТаблицаПереносаУбытков.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПереноса, СтрокаНОБ);
				СтрокаПереноса.СуммаУбытка = СуммаУбытка;  
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	//Перенос убытков на другие НОБ сделаю потом  
	// пока не было подходящей ситуации

	//нераспределенные убытки содержатся в таблице ТаблицаПереносаУбытков 
	
	// у нас только 4 вида доходов.   Доходы по ПФИ пока не учитываем
	
	
	// нет такого случая:
	 // Сумма убытка по операциям с ценными бумагами, обращающимися на организованном рынке ценных бумаг, полученного по результатам указанных операций, 
	 // совершенных в налоговом периоде, уменьшает налоговую базу по операциям с производными финансовыми инструментами, обращающимися на организованном 
	 // рынке, базисным активом которых являются ценные бумаги, фондовые индексы или иные производные финансовые инструменты, базисным активом которых 
	 // являются ценные бумаги или фондовые индексы. 
	 
	// обратный случай: нет такого.  
	// Сумма убытка по операциям с производными финансовыми инструментами, обращающимися на организованном рынке, базисным активом которых являются 
	// ценные бумаги, фондовые индексы или иные производные финансовые инструменты, базисным активом которых являются ценные бумаги или фондовые индексы, 
	// полученного по результатам указанных операций, совершенных в налоговом периоде, после уменьшения налоговой базы по операциям с производными 
	// финансовыми инструментами, обращающимися на организованном рынке, уменьшает налоговую базу по операциям с ценными бумагами, обращающимися 
	// на организованном рынке ценных бумаг.
	
	//  Убыток по операциям РЕПО принимается в уменьшение доходов по операциям с ценными бумагами, обращающимися на организованном рынке ценных бумаг, 
	// а также с ценными бумагами, не обращающимися на организованном рынке ценных бумаг, в пропорции, рассчитанной как соотношение стоимости ценных бумаг,
	// являющихся объектом операций РЕПО, обращающихся на организованном рынке ценных бумаг, и стоимости ценных бумаг, являющихся объектом операций РЕПО, 
	// не обращающихся на организованном рынке ценных бумаг, в общей стоимости ценных бумаг, являющихся объектом операций РЕПО.
	
	// перенос на другой вид НОБ сделаю, если таковой вдругн появится. 
	
	
КонецПроцедуры

Процедура ВыполнитьРасчетНалоговойБазы(ТаблицаНОБ, ДвиженияНДФЛ, ОсновнаяСтавка, УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ)  Экспорт
	
	Если НЕ (ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов
		ИЛИ ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику) Тогда
		РаспределитьРасходыНеЦБ(ТаблицаНОБ, ДвиженияНДФЛ, ОсновнаяСтавка, УчитыватьВсеДоходыПриРаспределенииРасходовНеЦБ);
	КонецЕсли;
	
	//перенос убытков на другие коды. 
	ВыполнитьПереносУбытков(ТаблицаНОБ, ДвиженияНДФЛ, ОсновнаяСтавка);
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда 
		Если ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов Тогда
			//ничего не делаем 
		ИначеЕсли ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику Тогда
			// налоги не платим. Просто передаем информацию о полученных доходах 
			// таблицу не сворачиваем. 
		Иначе   //расторжение договора, корректировка, выплата наследнику 
			// налоговую базу посчитаем за весь период действия договора
			ТаблицаНОБ.ЗаполнитьЗначения(Год(ЭтотОбъект.ДатаРасчета), "Год");
			ТаблицаНОБ.ЗаполнитьЗначения(Месяц(ЭтотОбъект.ДатаРасчета), "Месяц"); 
			
			ТаблицаНОБ.Свернуть("ВидНалогооблагаемойБазы, Год, Месяц, ВидДохода, ВидВычета, СтавкаНДФЛ, Примечание", "СуммаДохода, СуммаРасхода, СуммаНДФЛДоход, СуммаНДФЛВычет, СуммаНалога, РаспределяемыеРасходы");
			
		КонецЕсли;
	КонецЕсли;
		
	Если ЭтотОбъект.ОснованиеРасчета <> Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику Тогда 
		СуммаДоходаНаНачалоРасчета = (ДвиженияНДФЛ.Итог("СуммаНДФЛДоход") - ДвиженияНДФЛ.Итог("СуммаНДФЛВычет")); // до текущего расчета  
		ПороговаяСумма = РаботаСНалогамиКлиентСервер.ПорогПримененияСтавкиНДФЛ15Процентов(ЭтотОбъект.ДатаРасчета, ОсновнаяСтавка); 
		СуммаНалогаРанееНачисленного = ДвиженияНДФЛ.Итог("СуммаНалога");
		РасчетСуммыНалога(ТаблицаНОБ, СуммаДоходаНаНачалоРасчета, ПороговаяСумма, СуммаНалогаРанееНачисленного, ОсновнаяСтавка);
	КонецЕсли;
	
КонецПроцедуры	

