
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено Тогда 
		
		Если НЕ (ДанныеЗаполнения.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет 
			ИЛИ ДанныеЗаполнения.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица) Тогда
			Возврат;
		КонецЕсли;	
		
		ЭтотОбъект.СчетДоверительногоУправления = ДанныеЗаполнения.СчетДоверительногоУправления;
		
		Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыводДенежныхСредств")
			ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда 
			ЭтотОбъект.Дата = ДанныеЗаполнения.Дата+60;
			ЭтотОбъект.ДатаРасчета = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДанныеЗаполнения.Дата - 24*60*60); 
			ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыводАктивов;
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Оплата")
			И ДанныеЗаполнения.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции Тогда 
			ЭтотОбъект.ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов; 
			ЭтотОбъект.Дата = ДанныеЗаполнения.Дата+60;
			ЭтотОбъект.ДатаРасчета = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДанныеЗаполнения.Дата);   
		КонецЕсли;	
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	Если ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаНаследнику Тогда
		ПроверяемыеРеквизиты.Добавить("Наследник");
	КонецЕсли;
				
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	

	Если ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыводАктивов
		ИЛИ ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов Тогда 
		Если Основания.Количество() > 0 Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасчетНДФЛВыводы.Ссылка КАК ДокументРасчет,
			|	РасчетНДФЛВыводы.Основание КАК ДокументВывод
			|ИЗ
			|	Документ.РасчетНДФЛ.Основания КАК РасчетНДФЛВыводы
			|ГДЕ
			|	РасчетНДФЛВыводы.Основание В(&СписокОснований)
			|	И РасчетНДФЛВыводы.Ссылка <> &СсылкаДокументРасчет";
				
			СписокОснований = ЭтотОбъект.Основания.Выгрузить().ВыгрузитьКолонку("Основание");
			Запрос.УстановитьПараметр("СписокОснований", СписокОснований);
			Запрос.УстановитьПараметр("СсылкаДокументРасчет", Ссылка);
						
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Уже существует " + Выборка.ДокументРасчет + " с данными основаниями. Документ не сохранен.",,,,Отказ);
			КонецЦикла;
		Иначе 
			//Фаллико. Два договора ДУ. Вывод делаем по одному, но налог надо посчитать в двух расчетах 
			// проверим есть ли расчеты по другому договору
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
				|ПОМЕСТИТЬ _СчетаДУ
				|ИЗ
				|	(ВЫБРАТЬ
				|		КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
				|	ИЗ
				|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
				|				,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних) КАК ВложенныйЗапрос
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
				|		ПО ВложенныйЗапрос.Клиент = КлиентыДоверительногоУправленияСрезПоследних.Клиент
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасчетНДФЛ.Ссылка КАК ДокументРасчет,
				|	РасчетНДФЛ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
				|ИЗ
				|	Документ.РасчетНДФЛ КАК РасчетНДФЛ
				|ГДЕ
				|	РасчетНДФЛ.СчетДоверительногоУправления В
				|			(ВЫБРАТЬ
				|				_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
				|			ИЗ
				|				_СчетаДУ КАК _СчетаДУ)
				|	И РасчетНДФЛ.СчетДоверительногоУправления <> &СчетДоверительногоУправления
				|	И РасчетНДФЛ.ОснованиеРасчета = ЗНАЧЕНИЕ(Перечисление.ОснованияРасчетаНДФЛ.ВыводАктивов)
				|	И РасчетНДФЛ.ДатаРасчета = &ДатаРасчета";
			
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ДатаРасчета", ЭтотОбъект.ДатаРасчета);
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выводы средств есть в расчете НДФЛ по счету ДУ " + Выборка.СчетДоверительногоУправления, Выборка.ДокументРасчет,,,);	
			Иначе 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Таблица Выводов не заполнена. Документ не сохранен.",,,,Отказ);
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.КонецНалоговогоПериода Тогда 	
		Если ДатаРасчета <> НачалоДня(КонецГода(ДатаРасчета)) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата расчета не является концом года. Документ не сохранен.",,,,Отказ);
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетНДФЛ.Ссылка КАК ДокументРасчет
		|ИЗ
		|	Документ.РасчетНДФЛ КАК РасчетНДФЛ
		|ГДЕ
		|	РасчетНДФЛ.Организация = &Организация
		|	И РасчетНДФЛ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РасчетНДФЛ.ОснованиеРасчета = ЗНАЧЕНИЕ(Перечисление.ОснованияРасчетаНДФЛ.КонецНалоговогоПериода)
		|	И НЕ РасчетНДФЛ.ПометкаУдаления
		|	И РасчетНДФЛ.Ссылка <> &Ссылка
		|	И РасчетНДФЛ.ДатаРасчета = &ДатаРасчета";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Существует документ на конец " + Формат(Год(ДатаРасчета),"ЧГ=0") + " г.",,,,Отказ); 
		КонецЕсли;	
	ИначеЕсли ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.РасторжениеДоговора
		ИЛИ ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику
		ИЛИ ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.КорректировкаНалога Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетНДФЛ.Дата КАК Дата,
		|	РасчетНДФЛ.ОснованиеРасчета КАК ОснованиеРасчета
		|ИЗ
		|	Документ.РасчетНДФЛ КАК РасчетНДФЛ
		|ГДЕ
		|	РасчетНДФЛ.Организация = &Организация
		|	И РасчетНДФЛ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РасчетНДФЛ.ОснованиеРасчета В(&ОснованиеРасчета)
		|	И НЕ РасчетНДФЛ.ПометкаУдаления
		|	И РасчетНДФЛ.Ссылка <> &Ссылка
		|	И РасчетНДФЛ.Дата <> &ДатаРасчета";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
		ОснованияРасторжения = Новый Массив;
		ОснованияРасторжения.Добавить(Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику);
		ОснованияРасторжения.Добавить(Перечисления.ОснованияРасчетаНДФЛ.РасторжениеДоговора);
		
		Запрос.УстановитьПараметр("ОснованиеРасчета", ОснованияРасторжения);
			
		Выборка = Запрос.Выполнить().Выбрать();
		Если ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.РасторжениеДоговора
			ИЛИ ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику Тогда 
			Если Выборка.Следующий() Тогда  
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СчетДоверительногоУправления + " есть Расчет НДФЛ от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " с основанием " + Выборка.ОснованиеРасчета + ", документ не сохранен",,,,Отказ); 
			КонецЕсли;
		ИначеЕсли ОснованиеРасчета =  Перечисления.ОснованияРасчетаНДФЛ.КорректировкаНалога Тогда 
			Если НЕ Выборка.Следующий() Тогда  
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СчетДоверительногоУправления + " нет Расчета НДФЛ с основанием 'Расторжение договора' или 'Перевод активов другому профучастнику', документ не сохранен",,,,Отказ); 
			Иначе
				Если Выборка.Дата >= ДатаРасчета Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СчетДоверительногоУправления + " есть Расчет НДФЛ от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " с основанием " + Выборка.ОснованиеРасчета + ". Корретировка налога должна быть позже расторжения договора или перевода активов",,,,Отказ); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
		
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт 
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата); 
	ИФНС = БухгалтерскийУчет.ОпределитьИФНС(ЭтотОбъект.Ссылка);
	ВалютаРубль = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");

	// регистр БазаНачисленияНДФЛ 
	Движения.БазаНачисленияНДФЛ.Записывать = Истина;
	Для Каждого ТекСтрокаНалоговаяБаза Из НалоговаяБаза2025 Цикл
		
		Если (ЗначениеЗаполнено(ТекСтрокаНалоговаяБаза.ВидДохода) И ТекСтрокаНалоговаяБаза.СуммаНДФЛДоход > 0)
			ИЛИ (ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.НеучитываемыеДоходы И ТекСтрокаНалоговаяБаза.СуммаДохода > 0) Тогда 
			Движение = Движения.БазаНачисленияНДФЛ.Добавить();
			Движение.Период = Дата;
			Движение.Организация = Организация;
			Движение.ФизЛицо = Клиент;
			Движение.ВидНалогооблагаемойБазы = ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы;  
			Движение.ДатаПолученияДохода = Дата(ТекСтрокаНалоговаяБаза.Год, ТекСтрокаНалоговаяБаза.Месяц, 1);
			Движение.ВидДоходаВычета = ТекСтрокаНалоговаяБаза.ВидДохода;
			Движение.СтавкаНДФЛ = ТекСтрокаНалоговаяБаза.СтавкаНДФЛ; 
			Движение.СуммаНДФЛ = ТекСтрокаНалоговаяБаза.СуммаНДФЛДоход; 
			Движение.Сумма = ТекСтрокаНалоговаяБаза.СуммаДохода; 
			Движение.Примечание = ТекСтрокаНалоговаяБаза.Примечание;
		КонецЕсли;  
		
		Если ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов Тогда 
			Продолжить;  // вычет по дивидендам в НДФЛ не отражаем 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрокаНалоговаяБаза.ВидВычета) И ТекСтрокаНалоговаяБаза.СуммаНДФЛВычет <> 0 
			ИЛИ (ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы = Перечисления.ВидыНалогооблагаемыхБаз.НеучитываемыеДоходы И ТекСтрокаНалоговаяБаза.СуммаРасхода > 0) Тогда 
			Движение = Движения.БазаНачисленияНДФЛ.Добавить();
			Движение.Период = Дата;
			Движение.Организация = Организация;
			Движение.ФизЛицо = Клиент;
			Движение.ВидНалогооблагаемойБазы = ТекСтрокаНалоговаяБаза.ВидНалогооблагаемойБазы;  
			Движение.ДатаПолученияДохода = Дата(ТекСтрокаНалоговаяБаза.Год, ТекСтрокаНалоговаяБаза.Месяц, 1);
			Движение.ВидДоходаВычета = ТекСтрокаНалоговаяБаза.ВидВычета;
			Движение.СтавкаНДФЛ = ТекСтрокаНалоговаяБаза.СтавкаНДФЛ; 
			Движение.СуммаНДФЛ = - ТекСтрокаНалоговаяБаза.СуммаНДФЛВычет; 
			Движение.Сумма = - ТекСтрокаНалоговаяБаза.СуммаРасхода;
			Движение.Примечание = ТекСтрокаНалоговаяБаза.Примечание;
		КонецЕсли;
	КонецЦикла; 
	
	//Регистр НачисленияНалогов
	Движения.НачисленияНалогов.Записывать = Истина; 
	//Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	
	Если ОснованиеРасчета = Перечисления.ОснованияРасчетаНДФЛ.ВыплатаДивидендов Тогда
