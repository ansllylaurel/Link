
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикииСобытий
	
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		Если КонсолидированнаяОтчетность.ЕстьДокументыЗаТотЖеПериод(ЭтотОбъект) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если ЭтотОбъект.СтатусОтчета = "Корректировка" И ЭтотОбъект.НомерКорректировки = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер корректировки должен быть отличен от нуля", , "НомерКорректировки", , Отказ);
		КонецЕсли; 
		
	КонецЕсли;
	
	ПредставлениеПериода = КонсолидированнаяОтчетность.ПредставлениеФинансовогоПериода(ДатаНачала, ДатаОкончания);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	ЭтотОбъект.СтатусОтчета = "Черновик";
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
