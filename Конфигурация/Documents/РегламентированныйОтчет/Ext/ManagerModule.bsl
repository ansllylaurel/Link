
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("НаименованиеОтчета");
 	Поля.Добавить("ПредставлениеПериода");
	Поля.Добавить("СчетДоверительногоУправления");
		
 	СтандартнаяОбработка = Ложь;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
			
 	Представление = Данные.НаименованиеОтчета + " за " + Данные.ПредставлениеПериода + " (" + Данные.СчетДоверительногоУправления + ")";
		
 	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

Функция ПолучитьСписокВидовРегламентированныхОтчетов() Экспорт

	СписокРегламентированныхОтчетов = Новый СписокЗначений;
	СписокРегламентированныхОтчетов.Добавить("РегламентированныйОтчетБаланс", "Бухгалтерский баланс");
	СписокРегламентированныхОтчетов.Добавить("РегламентированныйОтчетОПотокахДенежныхСредствНПФ", "Отчет о потоках денежных средств НПФ");
	СписокРегламентированныхОтчетов.Добавить("РегламентированныйОтчетОФинансовыхРезультатах", "Отчет о финансовых результатах");
	СписокРегламентированныхОтчетов.Добавить("РегламентированныйОтчетФинансовыеОперацииНПФ", "Финансовые операции НПФ (1-ФС)");
	
	Возврат СписокРегламентированныхОтчетов;

КонецФункции
 
