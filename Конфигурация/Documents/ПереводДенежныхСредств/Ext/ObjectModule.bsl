			Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.БрокерПолучатель.ЮрФизЛицо;
		КонецЕсли;
		
	Иначе
		
		Если ЭтотОбъект.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			
			Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.СчетаДляКлиринга24;
