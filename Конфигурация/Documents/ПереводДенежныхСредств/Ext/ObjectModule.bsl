Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	// Переводы между местами хранения одного брокера не формируют проводок, чтобы
	// не захламлять журнал оборотами по одному счету с одинаковыми субконто
	Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЭтотОбъект.Брокер = ЭтотОбъект.БрокерПолучатель Тогда
		Возврат;
	КонецЕсли;	
	
	НастройкиУчетаОбщие  = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	
	СуммаВВалютеУчета   = РаботаСВалютами.ПолучитьСуммуДокументаВВалютеУчета(ЭтотОбъект.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект, Отказ);
	ЭтоВалютнаяПроводка = (ЭтотОбъект.Валюта <> ЭтотОбъект.Организация.ВалютаУчета);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВВалютеУчета, "Перевод денежных средств");
		
	// дебет	
	Если ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть Тогда
		
		Если ЭтоВалютнаяПроводка Тогда
			Проводка.СчетДт = ПланыСчетов.Основной.ПереводыВПутиВВалюте;
		
			Проводка.ВалютаДт = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
					
		Иначе
			Проводка.СчетДт = ПланыСчетов.Основной.ПереводыВПути;
			
		КонецЕсли;

	Иначе
		
		Если ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			
			Если (Не ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель)) И ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетПолучатель) Тогда
				Если ЭтотОбъект.РасчетныйСчетПолучатель.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.СчетЭскроу Тогда
					ЭтоСчетЭскроу = Истина;
				Иначе
					ЭтоСчетЭскроу = Ложь;
				КонецЕсли;	
			Иначе
				ЭтоСчетЭскроу = Ложь;
			КонецЕсли;	
			
			Если ЭтотОбъект.МестоХраненияПолучатель = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
			    Проводка.СчетДт = БухгалтерскийУчет.ОпределитьНастройкуУчета(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					"СчетУчетаДенежныхСредствНаБирже");
			ИначеЕсли ЭтоСчетЭскроу Тогда
				Проводка.СчетДт = ПланыСчетов.Основной.СчетаЭскроу;
			Иначе
				Проводка.СчетДт = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					ЭтотОбъект.Валюта,
					ЭтотОбъект.БрокерПолучатель);
			КонецЕсли;
				
			Если ЭтотОбъект.БрокерПолучатель = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда					
			    	Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчетПолучатель;
				КонецЕсли;	
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.БрокерПолучатель;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.БрокерПолучатель, ЭтотОбъект.Дата);
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
