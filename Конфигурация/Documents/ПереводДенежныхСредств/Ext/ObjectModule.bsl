		Иначе
		
			Проводка.СчетДт = ПланыСчетов.Единый.РасчетыСБрокерами02;
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.БрокерПолучатель, ЭтотОбъект.Дата);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Проводка.ВалютаДт  = ЭтотОбъект.Валюта;
	Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
	

	// кредит
	Если ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути Тогда
		
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
		
		Если ЭтотОбъект.БрокерПолучатель = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо;
