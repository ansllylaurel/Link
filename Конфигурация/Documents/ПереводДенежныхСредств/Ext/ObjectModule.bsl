					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДенежныеСредстваВПути;
				Иначе
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПереводДенежныхСредств;
				КонецЕсли;
			КонецЕсли;
			
			Если Проводка.СчетДт.Валютный Тогда
			
				Проводка.ВалютаДт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
							
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			
			Если ЭтоВалютнаяПроводка Тогда
				Проводка.СчетДт = ПланыСчетов.Основной.КассаОрганизацииВал;
				
				Проводка.ВалютаДт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
								
			Иначе
				Проводка.СчетДт = ПланыСчетов.Основной.КассаОрганизации;
				
			КонецЕсли;
				
		КонецЕсли;
				
	КонецЕсли;

	// кредит
	
	Если ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			Проводка.СубконтоКт.Контрагенты = РаботаСДокументами.ПолучитьКонтрагентаПоВидуПайщика(ЭтотОбъект.Основание.ВидПайщика, ЭтотОбъект.Основание.Владелец, ЭтотОбъект.Основание.Пайщик, Дата);  
		КонецЕсли;
		
		Если НастройкиУчетаОбщие.ВестиУчетИмуществаПайщиков Тогда
		
			ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВВалютеУчета, "Перевод денежных средств");
			
			ПроводкаПайщика.СчетДт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
			ПроводкаПайщика.СубконтоДт.Пайщики = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Основание, "Пайщик");
			ПроводкаПайщика.СубконтоДт.ЗаявкиПайщиков = ЭтотОбъект.Основание;
			
			ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.СредстваКлиента;
			ПроводкаПайщика.СубконтоКт.Пайщики = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Основание, "Пайщик");
		
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути Тогда
	
		Если ЭтоВалютнаяПроводка Тогда
			Проводка.СчетКт = ПланыСчетов.Основной.ПереводыВПутиВВалюте;
			
			Проводка.ВалютаКт = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
					
		Иначе
			Проводка.СчетКт = ПланыСчетов.Основной.ПереводыВПути;
			
		КонецЕсли;
		
	Иначе
		
		Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			
			Если (Не ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель)) И ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет) Тогда
				Если ЭтотОбъект.РасчетныйСчет.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.СчетЭскроу Тогда
					ЭтоСчетЭскроу = Истина;
				Иначе
					ЭтоСчетЭскроу = Ложь;
				КонецЕсли;	
			Иначе
				ЭтоСчетЭскроу = Ложь;
			КонецЕсли;	
			
			Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
			    Проводка.СчетКт = БухгалтерскийУчет.ОпределитьНастройкуУчета(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					"СчетУчетаДенежныхСредствНаБирже");
			ИначеЕсли ЭтоСчетЭскроу Тогда
				Проводка.СчетКт = ПланыСчетов.Основной.СчетаЭскроу;
			Иначе
				Проводка.СчетКт = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
					ЭтотОбъект.Дата,
					ЭтотОбъект.Организация,
					ЭтотОбъект.СчетДоверительногоУправления,
					ЭтотОбъект.Валюта,
					ЭтотОбъект.Брокер);
			КонецЕсли;
				
			Если ЭтотОбъект.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			 	   Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;   
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Если ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть
					ИЛИ ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДенежныеСредстваВПути;
				Иначе
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПереводДенежныхСредств;
				КонецЕсли;
			КонецЕсли;			
			
			Если Проводка.СчетКт.Валютный Тогда
			
				Проводка.ВалютаКт  = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
											
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		
			Если ЭтоВалютнаяПроводка Тогда
				Проводка.СчетКт = ПланыСчетов.Основной.КассаОрганизацииВал;
				
				Проводка.ВалютаКт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
								
			Иначе
				Проводка.СчетКт = ПланыСчетов.Основной.КассаОрганизации;
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	БухгалтерскийУчет.ПереоценитьВалютныеАктивы(ЭтотОбъект,УчетныйРегистр, Перечисления.ВидыУчета[УчетныйРегистр], НастройкиУчетаОбщие, Отказ);
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, , "Ответственный, Дата, Номер, Комментарий, Проведен, ПометкаУдаления");
		ФормаДенежныхСредств 			= Перечисления.ФормыДенежныхСредств.Безналичная;
		ФормаДенежныхСредствПолучатель 	= Перечисления.ФормыДенежныхСредств.Безналичная;
		Основание						= ДанныеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Основание, Сумма, СтрокаБанковскойВыписки, СтрокаБанковскойВыпискиПолучатель");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть
		Или ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.Перевод Тогда
		
		Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			ПроверяемыеРеквизиты.Добавить("Касса");
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			ПроверяемыеРеквизиты.Добавить("МестоХранения");
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		ПроверяемыеРеквизиты.Добавить("КассаПолучатель");
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		ПроверяемыеРеквизиты.Добавить("МестоХраненияПолучатель");
	КонецЕсли;
	
	// У плательщика должны быть расходные выписки, у получателя - приходные
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СтрокаБанковскойВыписки, "ВидДвижения") <> Перечисления.ВидыДвижений.Расход
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для плательщика выбрана банковская выписка с видом движения 'Приход'", ЭтотОбъект.Ссылка,, "СтрокаБанковскойВыписки", Отказ); 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель, "ВидДвижения") <> Перечисления.ВидыДвижений.Приход
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для получателя выбрана банковская выписка с видом движения 'Расход'", ЭтотОбъект.Ссылка,, "СтрокаБанковскойВыпискиПолучатель", Отказ); 	
	КонецЕсли;	
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСДокументами.ЗапрещенПрямойПереводНаСчетаБиржи(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
					
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
		
		// основание может быть выбрано только по клиенту, являющемуся ПИФ
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание) И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") И ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)
			И ТипЗнч(КлиентДоверительногоУправления) <> Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды")
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнено основание (заявка пайщика) для клиента, не являющегося ПИФ", ЭтотОбъект, "Основание",, Отказ);
		КонецЕсли;
		
		// Проверка на заполнение заявки пайщика
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Основание) И ТипЗнч(КлиентДоверительногоУправления) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды")
			И РасчетныйСчет.ТранзитныйПИФ
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перевод с транзитного счета ПИФ выполняется только по заявке пайщика", ЭтотОбъект, "Основание",, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание) И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда 
						
			//Брокер исполнил поручения двумя переводами. Разовая заглушка.
			РазрешитьСозданиеДвухПереводовНаОснованииПоручения = (НачалоДня(ЭтотОбъект.Дата) = Дата(2022, 11, 17));
			
			РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Основание, "Дата, Проведен, СчетДоверительногоУправления, Брокер, БрокерПолучатель, РасчетныйСчет, РасчетныйСчетПолучатель, МестоХранения, Сумма, Валюта");
			
			Для Каждого Реквизит Из РеквизитыПоручения Цикл
				
				Если Реквизит.Ключ = "Проведен" Тогда 
			
					Если Не РеквизитыПоручения.Проведен Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать переводы на основании непроведенных поручений.", ЭтотОбъект, "Основание",, Отказ);	
					КонецЕсли;
					
				ИначеЕсли Реквизит.Ключ = "Дата" Тогда
					
					Если ЭтотОбъект.Дата < РеквизитыПоручения.Дата Тогда
					
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата перевода [" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + "] раньше даты поручения [" + Формат(РеквизитыПоручения.Дата, "ДФ=dd.MM.yyyy") + "].", ЭтотОбъект, "Основание",, Отказ);
						
					КонецЕсли;
						
				ИначеЕсли ЭтотОбъект[Реквизит.Ключ] <> Реквизит.Значение Тогда 
					//#321525 Проверка равенства значений реквизита "РасчетныйСчетПолучатель" осуществляется только для переводов в рублях,
					//т.к. переводы в валюте могут осуществляться через транзитные счета, о которых мы узнаем по факту совершенного перевода.
					Если (Реквизит.Ключ = "РасчетныйСчетПолучатель" И (ЭтотОбъект.Валюта <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль") Или ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть)) 
						Или Реквизит.Ключ = "Сумма" И РазрешитьСозданиеДвухПереводовНаОснованииПоручения
						//Если перевод из пути - расчетный счет откуда и место хранения не заполняются.
						Или ((Реквизит.Ключ = "РасчетныйСчет" Или Реквизит.Ключ = "МестоХранения") И ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути) Тогда
						
						Продолжить;
						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе основания значение реквизита " + Реквизит.Ключ + " [" + Реквизит.Значение + "] отличется от значения документа [" + ЭтотОбъект[Реквизит.Ключ] + "]!", ЭтотОбъект, "Основание",, Отказ);		
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
						
			Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА &РазрешитьСозданиеДвухПереводовНаОснованииПоручения
				|				И НАЧАЛОПЕРИОДА(ДокументПоручениеНаПеревод.Дата, ДЕНЬ) = ДАТАВРЕМЯ(2022, 11, 17)
				|			ТОГДА ЕСТЬNULL(ПереводыДенежныхСредств.СуммаПереводов, 0) + &СуммаПеревода > ДокументПоручениеНаПеревод.Сумма
				|					ИЛИ ЕСТЬNULL(ПереводыДенежныхСредств.Количество, 0) > 1
				|		ИНАЧЕ НЕ ПереводыДенежныхСредств.Количество ЕСТЬ NULL
				|	КОНЕЦ КАК ОшибкаСозданияПодчиненногоДокумента,
				|	ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено), ЛОЖЬ) КАК ПоручениеИсполнено
				|ИЗ
				|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокументПоручениеНаПеревод
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(&Период, ) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
				|		ПО (СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств = ДокументПоручениеНаПеревод.Ссылка)
				|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			СУММА(ПереводДенежныхСредств.Сумма) КАК СуммаПереводов,
				|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПереводДенежныхСредств.Ссылка) КАК Количество,
				|			ПереводДенежныхСредств.Основание КАК ОснованиеСсылка
				|		ИЗ
				|			Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
				|		ГДЕ
				|			ПереводДенежныхСредств.Проведен
				|			И ПереводДенежныхСредств.ВариантПеревода = &ВариантПеревода
				|			И ПереводДенежныхСредств.Ссылка <> &ЭтотОбъектСсылка
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ПереводДенежныхСредств.Основание) КАК ПереводыДенежныхСредств
				|		ПО ДокументПоручениеНаПеревод.Ссылка = ПереводыДенежныхСредств.ОснованиеСсылка
				|ГДЕ
				|	ДокументПоручениеНаПеревод.Ссылка = &ОснованиеСсылка";
#КонецОбласти
			Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
			Запрос.УстановитьПараметр("ЭтотОбъектСсылка", ЭтотОбъект.Ссылка);
			Запрос.УстановитьПараметр("ОснованиеСсылка", ЭтотОбъект.Основание);
			Запрос.УстановитьПараметр("РазрешитьСозданиеДвухПереводовНаОснованииПоручения", РазрешитьСозданиеДвухПереводовНаОснованииПоручения);	
			Запрос.УстановитьПараметр("СуммаПеревода", ЭтотОбъект.Сумма);
			Запрос.УстановитьПараметр("ВариантПеревода", ЭтотОбъект.ВариантПеревода); // на случай если поручение будет исполнено двумя переводами (через счет "В пути").
					
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ОшибкаСозданияПодчиненногоДокумента Тогда 
					Если РазрешитьСозданиеДвухПереводовНаОснованииПоручения Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перевод не будет проведен, т.к. общая сумма перевода(ов) созданных на основании поручения превышает сумму поручения.", ЭтотОбъект, "Основание",, Отказ);
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На основании поручения уже создан перевод денежных средств.", ЭтотОбъект, "Основание",, Отказ);
					КонецЕсли;
				КонецЕсли;
					
				Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И Не Выборка.ПоручениеИсполнено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Переводы можно создавать только на основании поручений (НТП) со статусом [ИСПОЛНЕНО].", ЭтотОбъект,,, Отказ);
				КонецЕсли;
													
			КонецЦикла;
					
		КонецЕсли;

		// контроль суммы перевода с транзитного счета для ПИФ по заявке пайщика
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание) И ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")
			И ТипЗнч(КлиентДоверительногоУправления) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды")
		Тогда
			МинимальнаяСуммаЗачисления = РаботаСДокументами.ПолучитьМинимальнуюСуммуЗачисленияПИФ(КлиентДоверительногоУправления, ЭтотОбъект.Дата);
			Если МинимальнаяСуммаЗачисления = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ПИФ не определена минимальная сумма зачисления", ЭтотОбъект, "СчетДоверительногоУправления",, Отказ);
			ИначеЕсли ЭтотОбъект.Сумма < МинимальнаяСуммаЗачисления Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма перевода денежных средств с транзитного счета меньше минимальной суммы зачисления для ПИФ", ЭтотОбъект, "Сумма",, Отказ);
			КонецЕсли; 
		КонецЕсли;
		
		// перевод д/с между брокерами
		Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) И ЭтотОбъект.Брокер <> ЭтотОбъект.БрокерПолучатель Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перевод денежных средств между различными брокерскими компаниями запрещен", ЭтотОбъект, "Брокер",, Отказ);
		КонецЕсли;
		
		// расчетный счет
		Если (ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.Перевод
					Или ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть)
				И ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная
		Тогда
		
			ДетализацияПоРасчетномуСчету =
				(ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК)
					И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект);

			Если ДетализацияПоРасчетномуСчету Тогда
				Если Не ЗначениеЗаполнено(РасчетныйСчет) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счет"" не заполнено", ЭтотОбъект, "РасчетныйСчет",, Отказ);
				Иначе
					Если ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.Валюта Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета отличается от валюты перевода", ЭтотОбъект, "РасчетныйСчет",, Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// расчетный счет получателя
		Если (ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.Перевод
					Или ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути)
				И ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Безналичная
		Тогда
		
			ДетализацияПоРасчетномуСчетуПолучатель =
				(ЭтотОбъект.МестоХраненияПолучатель <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК)
					И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект, "БрокерПолучатель");
			
			// т.к. по просьбе Нади расчетный счет получателя в переводе отображается всегда,
			// сохраним необходимость его заполнения в доп. свойствах объекта,
			// чтобы использовать при получении плановых движений
			
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ДетализацияПоРасчетномуСчетуПолучатель", ДетализацияПоРасчетномуСчетуПолучатель);
			
			Если ДетализацияПоРасчетномуСчетуПолучатель Тогда
				Если Не ЗначениеЗаполнено(РасчетныйСчетПолучатель) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счет получателя"" не заполнено", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
				Иначе
					Если ЭтотОбъект.РасчетныйСчетПолучатель.Валюта <> ЭтотОбъект.Валюта Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта расчетного счета получателя отличается от валюты перевода", ЭтотОбъект, "РасчетныйСчетПолучатель",, Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная
			И ЭтотОбъект.Касса.ВалютаДенежныхСредств <> ЭтотОбъект.Валюта
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта кассы отличается от валюты перевода", ЭтотОбъект, "Касса",, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Наличная
			И ЭтотОбъект.КассаПолучатель.ВалютаДенежныхСредств <> ЭтотОбъект.Валюта
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта кассы получателя отличается от валюты перевода", ЭтотОбъект, "КассаПолучатель",, Отказ);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
		
	//Зафиксируем новый статус для поручения (основания)
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЗначениеЗаполнено(ЭтотОбъект.Основание) 
		И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда

		УстановитьСтатусДокументуОснования();
		
	КонецЕсли;
			
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);	
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура УстановитьСтатусДокументуОснования()
	
	НовыйСтатус = Неопределено;
	
	Если ЭтотОбъект.Проведен Тогда
		
		НовыйСтатус = ?(ЗначениеЗаполнено(ЭтотОбъект.СтрокаБанковскойВыписки) Или ЗначениеЗаполнено(ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель), 
						Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Исполнено, 
						Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Активно);	
						
	ИначеЕсли ЭтотОбъект.ПометкаУдаления Тогда //откатываем статус к исходному
		НовыйСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Активно;
	КонецЕсли;
		
	Если НовыйСтатус <> Неопределено Тогда
		
		ТекущийСтатус = РаботаСДокументами.ПолучитьТекущийСтатусПорученияНаПереводДенежныхСредств(ЭтотОбъект.Основание);
		
		Если ЭтотОбъект.ПометкаУдаления И ТекущийСтатус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено Тогда
			Возврат;
		ИначеЕсли НовыйСтатус <> ТекущийСтатус Тогда
			РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(ЭтотОбъект.Основание, НовыйСтатус);	
		КонецЕсли;
		
	КонецЕсли;
					 	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

#КонецОбласти
