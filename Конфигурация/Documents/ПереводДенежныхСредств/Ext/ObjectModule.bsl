
Функция ПолучитьВариантПереводаДенежныхСредств()
	
	Если      ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ВПуть;
		
	ИначеЕсли ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ИзПути;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Основание) И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ПоЗаявкеПайщика;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.МеждуСчетамиБрокера;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Брокер) И Не ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет;
		
	ИначеЕсли Не ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Касса) И ЗначениеЗаполнено(ЭтотОбъект.КассаПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.МеждуКассами;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Касса) И НЕ ЗначениеЗаполнено(ЭтотОбъект.КассаПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ИзКассыНаРасчетныйСчет;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ЭтотОбъект.Касса) И ЗначениеЗаполнено(ЭтотОбъект.КассаПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаВКассу;
		
	ИначеЕсли Не ЗначениеЗаполнено(ЭтотОбъект.Брокер) И Не ЗначениеЗаполнено(ЭтотОбъект.БрокерПолучатель) Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.МеждуРасчетнымиСчетами;
		
	Иначе
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции // ПолучитьВариантПереводаДенежныхСредств

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                       ЭтотОбъект.Брокер); 
		ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                ЭтотОбъект.МестоХранения);
		ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
		
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваНаличные");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Касса",                        ЭтотОбъект.Касса);
		
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	ВариантПереводаДенежныхСредств = ПолучитьВариантПереводаДенежныхСредств();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиДенежныхСредств.Записывать   = Истина;
	Движения.ДенежныеСредстваНаличные.Записывать = Истина;
	Движения.РеестрПлатежей.Записывать           = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	Движения.ДенежныеСредстваПереданныеВОплатуПаев.Записывать = Истина;
	
	Если ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
		
		// Реестр денежных средств переданных в оплату паев
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			
			Движение = Движения.ДенежныеСредстваПереданныеВОплатуПаев.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Пайщик                       = ЭтотОбъект.Основание.Пайщик;
			Движение.РасчетныйСчет                = ЭтотОбъект.РасчетныйСчет;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;
		
	Иначе
	
		// расход д/с
		Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
			
			Движение.Период                         = ЭтотОбъект.Дата;
			Движение.Организация                    = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Брокер                         = ЭтотОбъект.Брокер;
			Движение.МестоХранения                  = ?(ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути, Справочники.МестаХранения.ВнебиржевойРынок, ЭтотОбъект.МестоХранения);
			Движение.РасчетныйСчет                  = ?(ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути, Справочники.БанковскиеСчета.ДенежныеСредстваВПути, ЭтотОбъект.РасчетныйСчет);
			Движение.Валюта                         = ЭтотОбъект.Валюта;
			Движение.Сумма                          = ЭтотОбъект.Сумма;
			Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств;
			Движение.ВариантДвиженияДенежныхСредств = ВариантПереводаДенежныхСредств;
			
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			Движение = Движения.ДенежныеСредстваНаличные.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Касса                        = ЭтотОбъект.Касса;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;
		
		// Задолженность перед пайщиком
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
			и ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")
			и ЭтотОбъект.РасчетныйСчетПолучатель.ТранзитныйПИФ Тогда
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Основание;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПередПайщиками;
			Движение.Контрагент                   = ЭтотОбъект.Основание.Пайщик;
			Движение.Валюта                       = ЭтотОбъект.Валюта;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			Движение.Аванс                        = Истина;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЭтотОбъект.РасчетныйСчетПолучатель.ТранзитныйПИФ Тогда
		
		// Реестр денежных средств переданных в оплату паев
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			
			Движение = Движения.ДенежныеСредстваПереданныеВОплатуПаев.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Пайщик                       = ЭтотОбъект.Основание.Пайщик;
			Движение.РасчетныйСчет                = ЭтотОбъект.РасчетныйСчетПолучатель;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;

	Иначе
	
		// даже если по брокеру не установлена детализация по р/счету, р/счет-получатель может быть заполнен (это нужно для печ. форм);
		// при этом такой р/счет не должен попадать в движения
		ДетализацияПоРасчетномуСчетуПолучатель =
			ЭтотОбъект.ДополнительныеСвойства.Свойство("ДетализацияПоРасчетномуСчетуПолучатель") И ЭтотОбъект.ДополнительныеСвойства.ДетализацияПоРасчетномуСчетуПолучатель;
			
		// приход д/с

		Если ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Безналичная
			ИЛИ ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть Тогда
			Движение = Движения.ОстаткиДенежныхСредств.ДобавитьПриход();
			
			Движение.Период                         = ЭтотОбъект.Дата;
			Движение.Организация                    = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Валюта                         = ЭтотОбъект.Валюта;
			Движение.Сумма                          = ЭтотОбъект.Сумма;
			Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств;
			Движение.ВариантДвиженияДенежныхСредств = ВариантПереводаДенежныхСредств;
			
			Если ЭтотОбъект.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть Тогда
				Движение.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок;
				Движение.РасчетныйСчет = Справочники.БанковскиеСчета.ДенежныеСредстваВПути;
			Иначе
				Движение.Брокер        = ЭтотОбъект.БрокерПолучатель;
				Движение.МестоХранения = ЭтотОбъект.МестоХраненияПолучатель;
				Движение.РасчетныйСчет = ?(ДетализацияПоРасчетномуСчетуПолучатель, ЭтотОбъект.РасчетныйСчетПолучатель, Справочники.БанковскиеСчета.ПустаяСсылка());
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			Движение = Движения.ДенежныеСредстваНаличные.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Касса                        = ЭтотОбъект.КассаПолучатель;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;
		
		// Задолженность перед пайщиком
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
			И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")
			И ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Основание;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПередПайщиками;
			Движение.Контрагент                   = ЭтотОбъект.Основание.Пайщик;
			Движение.Валюта                       = ЭтотОбъект.Валюта;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			Движение.Аванс                        = Истина;
			
		КонецЕсли;

	КонецЕсли;
			
	Движения.Записать();
	
	Если      ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
		Если ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредствПереданныхВОплатуПаев(ЭтотОбъект, Отказ);	
		КонецЕсли;
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиНаличныхДенежныхСредств(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	СтрокиБанковскойВыписки = Новый Массив();
	СтрокиБанковскойВыписки.Добавить(РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(	ЭтотОбъект.СтрокаБанковскойВыписки,
																													ЭтотОбъект.СтрокаБанковскойВыписки.ВидДвижения,
																													ЭтотОбъект.Сумма,
																													Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств));
	
	// если  был перевод между собственными счетами и необходимо зарегистрировать и второе движение
	Если ЗначениеЗаполнено(ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель) Тогда
		СтрокиБанковскойВыписки.Добавить(РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(	ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель,
																														ЭтотОбъект.СтрокаБанковскойВыпискиПолучатель.ВидДвижения, 
																														ЭтотОбъект.Сумма, 
																														Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств));
	КонецЕсли; 
	
	// реестр платежей
	РегистрыСведений.РеестрПлатежей.ЗарегистрироватьПлатеж(ЭтотОбъект,СтрокиБанковскойВыписки);
				
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	// Переводы между местами хранения одного брокера не формируют проводок, чтобы
	// не захламлять журнал оборотами по одному счету с одинаковыми субконто
	Если ЗначениеЗаполнено(ЭтотОбъект.Брокер) И ЭтотОбъект.Брокер = ЭтотОбъект.БрокерПолучатель Тогда
		Возврат;
	КонецЕсли;	
	
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	// Раньше использовался счет 20209, но в соответствии с 
	// "Разъяснения Банка России от 04.05.2017 
	// "По вопросам, связанным с применением Положения Банка России
	// от 02.09.2015 N 486-П "О Плане счетов бухгалтерского учета в 
	// некредитных финансовых организациях и порядке его применения" 
	//(далее - Положение N 486-П)""
