				Проводка.СчетКт = ?(БанкРезидент, ПланыСчетов.Единый.РасчетныеСчета01, ПланыСчетов.Единый.РасчетныеСчета02);
				
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
