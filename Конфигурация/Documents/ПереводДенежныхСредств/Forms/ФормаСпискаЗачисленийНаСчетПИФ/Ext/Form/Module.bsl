
&НаКлиенте
Процедура ВвестиЗачисление(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(ТекущаяСтрока) = Тип("ДокументСсылка.ПереводДенежныхСредств") Тогда
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		Если ЗначениеЗаполнено(ТекущиеДанные.ЗачислениеПаев) Тогда
			ОткрытьФорму("Документ.ЗачислениеПаев.ФормаОбъекта", Новый Структура("Ключ", ТекущиеДанные.ЗачислениеПаев));
		Иначе		
			ОткрытьФорму("Документ.ЗачислениеПаев.ФормаОбъекта", Новый Структура("Основание", ТекущаяСтрока));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
