
Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.Записывать = Истина;
	
	Если Не ЭтотОбъект.ВыводВсехАктивов Тогда
		// задолженность по ц/б
		Для каждого СтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
			
			Движение = Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Поручение                    = ЭтотОбъект.Ссылка;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.ТипЗадолженности             = ЭтотОбъект.ТипЗадолженности;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.Валюта;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			
			Если ЭтотОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
				Движение.Сумма       = СтрокаЦенныеБумаги.Сумма;
				Движение.СуммаКупона = СтрокаЦенныеБумаги.СуммаКупона;
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если      ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, Рынок, ДепозитарныйСчет");
		
		ЭтотОбъект.Дата 			= ДанныеЗаполнения.Дата - 6*60;
		ЭтотОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская;
		ЭтотОбъект.Валюта           = ДанныеЗаполнения.Валюта;
		
		Для каждого СтрокаЦенныеБумаги Из ДанныеЗаполнения.ЦенныеБумаги Цикл
			ЗаполнитьЗначенияСвойств(ЭтотОбъект.ЦенныеБумаги.Добавить(), СтрокаЦенныеБумаги);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, Рынок, ДепозитарныйСчет");
				
		ЭтотОбъект.Дата 			= ДанныеЗаполнения.Дата - 6*60;
		ЭтотОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская;
		ЭтотОбъект.Валюта           = ЭтотОбъект.Организация.ВалютаУчета;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На данный момент поручение на вывод ценных бумаг автоматически заполняется в валюте учета!");
		Для каждого СтрокаЦенныеБумаги Из ДанныеЗаполнения.ЦенныеБумаги Цикл
			ЗаполнитьЗначенияСвойств(ЭтотОбъект.ЦенныеБумаги.Добавить(), СтрокаЦенныеБумаги);
		КонецЦикла;
		
	КонецЕсли;
		
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры // ОбработкаЗаполнения

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	ЭтотОбъект.ДатаИВремяПолучения 	= "";
	
КонецПроцедуры // ПриКопировании

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВыводВсехАктивов Тогда
		
		Если ПроверяемыеРеквизиты.Найти("ДепозитарныйСчет") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДепозитарныйСчет"));
		КонецЕсли;
		
		Если ПроверяемыеРеквизиты.Найти("Рынок") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Рынок"));
		КонецЕсли;
		
		Если ПроверяемыеРеквизиты.Найти("Валюта") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Валюта"));
		КонецЕсли;
		
		Если ПроверяемыеРеквизиты.Найти("ЦенныеБумаги") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ЦенныеБумаги"));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.Дата < Дата(2021, 12, 15) Тогда
		
		Если ПроверяемыеРеквизиты.Найти("ДатаИсполненияПо") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ДатаИсполненияПо"));	
		КонецЕсли;
		
	КонецЕсли;
		
	Если ПроверяемыеРеквизиты.Найти("СпособПередачи") <> Неопределено
		И (НЕ ЭтоНовый() И НЕ ЗначениеЗаполнено(Ссылка.СпособПередачи)
			ИЛИ НЕ РаботаСДокументами.СчетДоверительногоУправленияПоЛицензииПоУправлениюЦеннымиБумагами(ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления)) Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СпособПередачи"));
	КонецЕсли;
	
	Если РаботаСДокументамиКлиентСервер.ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(ЭтотОбъект) Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если Не Отказ Тогда
			РаботаСДокументами.ВыполнитьСверкуСоСпискомНедействительныхПаспортовОтложенноПоПоручениюНаВыводАктивов(ЭтотОбъект);
		КонецЕсли;
		
		// Ценные бумаги должны быть уникальными
		Если ЭтотОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда
			УникальныеЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага");
			УникальныеЦенныеБумаги.Свернуть("ЦеннаяБумага");
			Если ЭтотОбъект.ЦенныеБумаги.Количество() <> УникальныеЦенныеБумаги.Количество()  Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ценная бумага может быть выбрана в табличной части только один раз!", ЭтотОбъект.ЦенныеБумаги,,, Отказ);
				Возврат;
			КонецЕсли; 
		КонецЕсли;
		
		Если ЭтотОбъект.Дата >= Дата(2021, 12, 15) И ДатаИсполненияПо < НачалоДня(Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата исполнения не может быть раньше даты поручения'"), ЭтотОбъект, "ДатаИсполненияПо",, Отказ);
		КонецЕсли;
		
		Если Не Отказ Тогда
			Отказ = Не РаботаСДокументами.РазрешенВыводАктивовКонтрагенту(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

#КонецОбласти
