

Функция НайтиДокументРаспределениеАктивовЕПСПоСделке(Сделка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РаспределениеАктивовЕПС.Ссылка КАК РаспределениеАктивовЕПС
	|ИЗ
	|	Документ.РаспределениеАктивовЕПС КАК РаспределениеАктивовЕПС
	|ГДЕ
	|	РаспределениеАктивовЕПС.ПоСделке = &Сделка";
	
	Запрос.УстановитьПараметр("Сделка", Сделка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе	
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Возврат ВыборкаДетальныеЗаписи.РаспределениеАктивовЕПС;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

Функция НайтиДокументРаспределениеАктивовЕПСЗаДату(НачальнаяДата, КонечнаяДата, Организация, СчетДоверительногоУправления) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РаспределениеАктивовЕПС.Ссылка КАК РаспределениеАктивовЕПС
	|ИЗ
	|	Документ.РаспределениеАктивовЕПС КАК РаспределениеАктивовЕПС
	|ГДЕ
	|	РаспределениеАктивовЕПС.ПоСделке = ИСТИНА
	|	И РаспределениеАктивовЕПС.Организация = &Организация
	|	И РаспределениеАктивовЕПС.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И РаспределениеАктивовЕПС.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата";
	
	Запрос.УстановитьПараметр("НачальнаяДата", НачальнаяДата);
	Запрос.УстановитьПараметр("КонечнаяДата", КонечнаяДата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе	
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Возврат ВыборкаДетальныеЗаписи.РаспределениеАктивовЕПС;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьРаспределенияАктивовЕПС(Дата, Организация, СчетДоверительногоУправления, ПоСделке, ДокументРаспределениеАктивовЕПС, Сделка, Рынок, ЦеннаяБумага, УчетныйАктивЕПС, Количество, Ответственный, Отказ) Экспорт

	Если ДокументРаспределениеАктивовЕПС = Неопределено Тогда
		
		Если ТипЗнч(ПоСделке) = Тип("ДокументСсылка.Сделка") Тогда
		
			ДокументРаспределениеАктивовЕПССсылка = НайтиДокументРаспределениеАктивовЕПСПоСделке(Сделка);
			
		Иначе
			
			ДокументРаспределениеАктивовЕПССсылка = НайтиДокументРаспределениеАктивовЕПСЗаДату(НачалоДня(Дата), КонецДня(Дата), Организация, СчетДоверительногоУправления);
			
		КонецЕсли;	
			
		Если ДокументРаспределениеАктивовЕПССсылка = Неопределено Тогда
			
			ДокументРаспределениеАктивовЕПС = Документы.РаспределениеАктивовЕПС.СоздатьДокумент();
			
		Иначе
			
			ДокументРаспределениеАктивовЕПС = ДокументРаспределениеАктивовЕПССсылка.ПолучитьОбъект();
			
		КонецЕсли;	
		
		УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ДокументРаспределениеАктивовЕПС);
		
		ДокументРаспределениеАктивовЕПС.Дата = Дата;
		ДокументРаспределениеАктивовЕПС.Организация = Организация;
		ДокументРаспределениеАктивовЕПС.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ДокументРаспределениеАктивовЕПС.ПоСделке = ПоСделке;
		ДокументРаспределениеАктивовЕПС.Ответственный = Ответственный;
		ДокументРаспределениеАктивовЕПС.Комментарий = "";
		
		ДокументРаспределениеАктивовЕПС.ЦенныеБумаги.Очистить();
		
	КонецЕсли;
	
	НоваяСтрокаЦенныеБумаги = ДокументРаспределениеАктивовЕПС.ЦенныеБумаги.Добавить();
	НоваяСтрокаЦенныеБумаги.Рынок           = Рынок;
	НоваяСтрокаЦенныеБумаги.ЦеннаяБумага    = ЦеннаяБумага;
	НоваяСтрокаЦенныеБумаги.Количество      = Количество;
	НоваяСтрокаЦенныеБумаги.Сделка		    = Сделка;
	НоваяСтрокаЦенныеБумаги.УчетныйАктивЕПС = УчетныйАктивЕПС;
	
	Возврат ДокументРаспределениеАктивовЕПС;
	
КонецФункции
