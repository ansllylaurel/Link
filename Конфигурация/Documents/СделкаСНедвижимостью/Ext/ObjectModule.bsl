				КонецЕсли;
					
			Иначе
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.Дельта), "Признание прав и обязательств ");
				
				Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ Тогда
					ЕстьСубконтоОбъектыНедвижимостиСчетУчета = Ложь;
				Иначе
					ЕстьСубконтоОбъектыНедвижимостиСчетУчета = Истина;
				КонецЕсли;	
			
				Если ВыборкаДетальныеЗаписи.Дельта > 0 Тогда
					
					Проводка.СчетДт = НастройкиУчетаПрава.СчетУчета;
					Если ЕстьСубконтоОбъектыНедвижимостиСчетУчета Тогда
						Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
					КонецЕсли;	
					
					Проводка.СчетКт = СчетУчетаРасчетов;
					
