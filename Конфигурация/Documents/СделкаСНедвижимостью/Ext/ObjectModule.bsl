					Если ЕстьСубконтоДтДоговоры Тогда
						Проводка.СубконтоДт.Договоры = ЭтотОбъект.Договор;
					КонецЕсли;	
					Если ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки Тогда
						Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
					КонецЕсли;	
					Если ЕстьСубконтоДтОснованиеРасчетов Тогда
						Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
					КонецЕсли;	
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаПрава.АналитикаДоходовОтРеализации;
					Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Договор;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаПрава.АналитикаДоходовОтРеализации;
					Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Договор;
					
					Проводка.СчетКт = НастройкиУчетаПрава.СчетУчетаПереоценки;
					
					ЕстьСубконтоКтКонтрагенты = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
					ЕстьСубконтоКтДоговоры = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
					ЕстьСубконтоКтОснованиеРасчетов = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов) <> Неопределено);
					
					Если ЕстьСубконтоКтКонтрагенты Тогда
						Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
					КонецЕсли;
					Если ЕстьСубконтоКтДоговоры Тогда 
						Проводка.СубконтоКт.Договоры = ЭтотОбъект.Договор;
					КонецЕсли;	
					Если ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки Тогда
						Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
					КонецЕсли;	
					Если ЕстьСубконтоКтОснованиеРасчетов Тогда
						Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		Если Не Отказ И ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда
			И ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.Изменение Тогда
			
			Выплаты = Документы.СделкаСНедвижимостью.ПолучитьПлановыеВыплатыПоСделкеСНедвижимостью(?(ЭтотОбъект.Изменение, ЭтотОбъект.Основание, ЭтотОбъект.Ссылка), ЭтотОбъект.Дата);
			НоваяЗадолженностьПоБэку = Выплаты.Итог("Сумма");
			ОстатокЗадолженностиПоБУ = 0;
				
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаОстатокКт
				|ИЗ
				|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
				|			&МоментДоДокумента,
				|			Счет = &СчетРасчетов,
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Субконто1 = &Контрагент
				|				И Субконто2 = &Договор) КАК БухгалтерскийУчетОстатки";
			
			Запрос.УстановитьПараметр("СчетРасчетов", СчетУчетаРасчетов);
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ОстатокЗадолженностиПоБУ = ВыборкаДетальныеЗаписи.СуммаОстатокКт;
			КонецЦикла;
			
			Дельта = НоваяЗадолженностьПоБэку - ОстатокЗадолженностиПоБУ;
			
			//проводки при изменении
			Если Дельта > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(Дельта), "Изменение суммы договора аренды");
			
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				//при изменении кадастровой стоимости - прочие, при изменении условий договора нужна другая аналитика. Пока не фиксируется причина изменения.
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПрочие;
				Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Договор;
				
				Проводка.СчетКт = СчетУчетаРасчетов;
				Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
				Проводка.СубконтоКт.Договоры = ЭтотОбъект.Договор;
				
			Иначе
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(Дельта), "Изменение суммы договора аренды");
			
				Проводка.СчетДт = СчетУчетаРасчетов;
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
				Проводка.СубконтоДт.Договоры = ЭтотОбъект.Договор;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПрочие;
				Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Договор;
				
			КонецЕсли;
				
		КонецЕсли;
		
		Если ПереоцениватьПриобретенныеАктивы И НЕ ЭтотОбъект.Изменение Тогда
			
			Параметры = Новый Структура;
			Параметры.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Параметры.Вставить("Период", ЭтотОбъект.Дата);
			Параметры.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиЦелейРасчета.ВариантРасчетаОценочнойСтоимости);
			Параметры.Вставить("Организация", ЭтотОбъект.Организация);
			Параметры.Вставить("ЦельРасчета", Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
			
			ЗадолженностиКОбесценениюИДисконтированию = РаботаСоСтоимостьюПоРыночнойСтавке.РассчитатьСправедливыеСтоимостиЗадолженностей(
				Параметры, 
				Неопределено,
				Отказ);
				
			СтрокаЗадолженности = ЗадолженностиКОбесценениюИДисконтированию.Найти(Ссылка, "ОснованиеЗадолженности");
			
			Если СтрокаЗадолженности <> Неопределено 
				И СтрокаЗадолженности.ПроцентыЭСП <> 0 
				И СтрокаЗадолженности.ВидЗадолженности = ВидЗадолженности Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(СтрокаЗадолженности.ПроцентыЭСП), "Переоценка первоначального признания задолженности");
				
				Если СтрокаЗадолженности.ПроцентыЭСП < 0 Тогда
					
					Проводка.СчетДт = СчетПереоценкиПоВидуЗадолженности;
					Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПоВидуЗадолженности;
					Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Договор;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПоВидуЗадолженности;
					Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Договор;
					
					Проводка.СчетКт = СчетПереоценкиПоВидуЗадолженности;
					Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
					Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СделкаСНедвижимостью") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		ЭтотОбъект.Дата = ТекущаяДата();
		ЭтотОбъект.Изменение = Истина;
		
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Основание) Тогда
			ЭтотОбъект.Основание = ДанныеЗаполнения.Основание;
		Иначе
			ЭтотОбъект.Основание = ДанныеЗаполнения;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокСНедвижимостьюСрезПоследних.ОбъектНедвижимости КАК ОбъектНедвижимости,
			|	УсловияСделокСНедвижимостьюСрезПоследних.Сумма КАК Сумма,
			|	УсловияСделокСНедвижимостьюСрезПоследних.ПлановаяДатаПередачи КАК Срок,
			|	УсловияСделокСНедвижимостьюСрезПоследних.СтавкаНДС КАК СтавкаНДС,
			|	УсловияСделокСНедвижимостьюСрезПоследних.СуммаНДС КАК СуммаНДС
			|ИЗ
			|	РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(, Основание = &Основание) КАК УсловияСделокСНедвижимостьюСрезПоследних
			|ГДЕ
			|	НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено";
		
		Запрос.УстановитьПараметр("Основание", Основание);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ЭтотОбъект.ОбъектыНедвижимости.Загрузить(РезультатЗапроса.Выгрузить());
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ГрафикиПлатежейСрезПоследних.Сумма КАК Сумма,
			|	ГрафикиПлатежейСрезПоследних.ДатаПлатежа КАК ПлановаяДатаОплаты
			|ИЗ
			|	РегистрСведений.ГрафикиПлатежей.СрезПоследних(, Основание = &Основание) КАК ГрафикиПлатежейСрезПоследних
			|ГДЕ
			|	ГрафикиПлатежейСрезПоследних.Действует";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ЭтотОбъект.ГрафикПлатежей.Загрузить(РезультатЗапроса.Выгрузить());
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
			
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		//проверка соответствия вида договора, вида сделки и вида права на недвижимость
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
			Если ЭтотОбъект.Дата > Дата(2021,1,1) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан договор " + ЭтотОбъект.ВидПраваНаНедвижимость, ЭтотОбъект, "Договор", ,Отказ);
			КонецЕсли;
		Иначе
			Если ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
				Если НЕ (ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Собственность 
					И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Договор,"ВидДоговора") = Перечисления.ВидыДоговоров.ДоговорКуплиПродажи) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимое сочетание вида договора и права на недвижимость при продаже " +ЭтотОбъект.ВидПраваНаНедвижимость,ЭтотОбъект, "ВидПраваНаНедвижимость", ,Отказ);
				КонецЕсли;
			Иначе
				Если НЕ ( (ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Собственность 
						И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Договор,"ВидДоговора") = Перечисления.ВидыДоговоров.ДоговорКуплиПродажи)
					ИЛИ (ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ 
						И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Договор,"ВидДоговора") = Перечисления.ВидыДоговоров.ДДУ)
					ИЛИ (ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда 
						И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Договор,"ВидДоговора") = Перечисления.ВидыДоговоров.Аренды)
					ИЛИ (ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Инвестконтракт 
						И Справочники.Договоры.ЭтоИнвестконтракт(ЭтотОбъект.Договор))) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимое сочетание вида договора и права на недвижимость при покупке " +ЭтотОбъект.ВидПраваНаНедвижимость,ЭтотОбъект, "ВидПраваНаНедвижимость", ,Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтотОбъект.ОбъектыНедвижимости.Итог("Сумма") <> ЭтотОбъект.ГрафикПлатежей.Итог("Сумма") 
			И ЭтотОбъект.Дата > Дата(2021,1,1) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма графика платежей не совпадает с суммой сделки!",ЭтотОбъект,,,Отказ);
		КонецЕсли;
		
		//дата передачи объекта
		Для каждого СтрокаОбъекта из ЭтотОбъект.ОбъектыНедвижимости Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаОбъекта.Срок) И НЕ ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + СтрокаОбъекта.НомерСтроки + " не заполнен срок передачи объекта " + СтрокаОбъекта.ОбъектНедвижимости, ЭтотОбъект,"ОбъектыНедвижимости["+(СтрокаОбъекта.НомерСтроки - 1)+"].Срок",, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		//Для аренды проверим, что заполнена дата окончания договора в условиях.
		Если ЗначениеЗаполнено(ЭтотОбъект.Договор) 
			И ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда 
			И ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ДатаРасторжения
				|ИЗ
				|	Справочник.Договоры КАК Договоры
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(
				|				&Период,
				|				Договор = &Договор
				|					И Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
				|		ПО УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка
				|ГДЕ
				|	Договоры.Ссылка = &Договор";
			
			Запрос.УстановитьПараметр("Договор", ЭтотОбъект.Договор);
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			ВыборкаДетальныеЗаписи.Следующий();
			
			Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаРасторжения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для договора долгосрочной аренды необходимо указать срок окончания", ЭтотОбъект.Договор,,, Отказ);
			КонецЕсли;
	
		КонецЕсли;
		
		//здание - только для ДДУ
		Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ Тогда
			Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Здание) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ДДУ необходимо указать здание", ЭтотОбъект, "Здание",, Отказ);
			Иначе
				
				//а это здание вообще?
				ВидОбъектаНедвижимостиДляЗдания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Здание,"ВидОбъектаНедвижимости");
				Если НЕ ЗначениеЗаполнено(ВидОбъектаНедвижимостиДляЗдания) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан вид объекта недвижимости у здания, выбранного для ДДУ", ЭтотОбъект.Здание, "ВидОбъектаНедвижимости",, Отказ);
				ИначеЕсли ВидОбъектаНедвижимостиДляЗдания <> Перечисления.ВидыОбъектовНедвижимости.Здание Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В сделке ДДУ в качестве здания выбран объект в другим видом ("+ВидОбъектаНедвижимостиДляЗдания+")", ЭтотОбъект, "Здание",, Отказ);
				КонецЕсли;	
				
				//здание д.б. заполнено у всех помещений договора
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ОбъектыНедвижимости.Ссылка КАК ОбъектыНедвижимостиСсылка,
					|	ОбъектыНедвижимости.Наименование КАК ОбъектыНедвижимостиНаименование,
					|	ОбъектыНедвижимости.Здание КАК Здание,
					|	ОбъектыНедвижимости.ВидОбъектаНедвижимости КАК ВидОбъектаНедвижимости
					|ИЗ
					|	Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
					|ГДЕ
					|	ОбъектыНедвижимости.Ссылка В(&СписокОбъектовНедвижимости)
					|	И (ОбъектыНедвижимости.Здание <> &Здание
					|			ИЛИ ОбъектыНедвижимости.ВидОбъектаНедвижимости <> ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовНедвижимости.Помещение))
					|	И ОбъектыНедвижимости.ВидОбъектаНедвижимости <> ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовНедвижимости.ОбъектНезавершенногоСтроительства)";
				
				Запрос.УстановитьПараметр("СписокОбъектовНедвижимости", ЭтотОбъект.ОбъектыНедвижимости.ВыгрузитьКолонку("ОбъектНедвижимости"));
				Запрос.УстановитьПараметр("Здание", ЭтотОбъект.Здание);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					Если ВыборкаДетальныеЗаписи.ВидОбъектаНедвижимости <> Перечисления.ВидыОбъектовНедвижимости.Помещение Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид объекта недвижимости " + ВыборкаДетальныеЗаписи.ОбъектыНедвижимостиНаименование + " (" + ВыборкаДетальныеЗаписи.ВидОбъектаНедвижимости + ") не является помещением ", ВыборкаДетальныеЗаписи.ОбъектыНедвижимостиСсылка, "ВидОбъектаНедвижимости",, Отказ);
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Здание) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У помещения " + ВыборкаДетальныеЗаписи.ОбъектыНедвижимостиНаименование + " не указана принадлежность к зданию", ВыборкаДетальныеЗаписи.ОбъектыНедвижимостиСсылка, "Здание",, Отказ);
					ИначеЕсли ВыборкаДетальныеЗаписи.Здание <> ЭтотОбъект.Здание Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У помещения " + ВыборкаДетальныеЗаписи.ОбъектыНедвижимостиНаименование + " указанное здание не совпадает со зданием ДДУ", ЭтотОбъект,,, Отказ);
					КонецЕсли;
					
				КонецЦикла;
	
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ЭтотОбъект.Здание) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Здание нужно только для договора ДДУ! Очистите реквизит",ЭтотОбъект,"Здание",,Отказ);
			КонецЕсли;
		КонецЕсли;
			
				
		Если ЭтотОбъект.Изменение Тогда
			
			Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Основание)  Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана основная сделка с недвижимостью!",ЭтотОбъект,Основание,,Отказ);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Основание, "Основание"))  Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение может быть создано только для основной сделки!",ЭтотОбъект,Основание,,Отказ);
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	                                                                                         
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПриЗаписи

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
