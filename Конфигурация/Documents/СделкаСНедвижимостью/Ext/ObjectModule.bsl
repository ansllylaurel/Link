				КонецЕсли;
				Если ЕстьСубконтоКтДоговоры Тогда 
					Проводка.СубконтоКт.Договоры = ЭтотОбъект.Договор;
				КонецЕсли;	
				
				Если ВыборкаДетальныеЗаписи.ОстатокПереоценки <> 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.ОстатокПереоценки), "Признание прав и обязательств ");
					
					Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ Тогда
						ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки = Ложь;
					Иначе
						ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки = Истина;
					КонецЕсли;	
					
			
					Если ВыборкаДетальныеЗаписи.ОстатокПереоценки > 0 Тогда
						
						Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаПрава.АналитикаДоходовОтРеализации;
						Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Договор;
						
						Проводка.СчетКт = НастройкиУчетаПрава.СчетУчетаПереоценки;
						
						ЕстьСубконтоКтКонтрагенты = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
						ЕстьСубконтоКтДоговоры = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
						
						Если ЕстьСубконтоКтКонтрагенты Тогда
							Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
						КонецЕсли;	
						Если ЕстьСубконтоКтДоговоры Тогда
							Проводка.СубконтоКт.Договоры = ЭтотОбъект.Договор;
						КонецЕсли;	
						Если ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки Тогда
							Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
						КонецЕсли;	
						
					Иначе
						
						Проводка.СчетДт = НастройкиУчетаПрава.СчетУчетаПереоценки;
						
						ЕстьСубконтоДтКонтрагенты = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
						ЕстьСубконтоДтДоговоры = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
						
						Если ЕстьСубконтоДтКонтрагенты Тогда
							Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
						КонецЕсли;	
						Если ЕстьСубконтоДтДоговоры Тогда
							Проводка.СубконтоДт.Договоры = ЭтотОбъект.Договор;
						КонецЕсли;	
						Если ЕстьСубконтоОбъектыНедвижимостиСчетУчетаПереоценки Тогда
							Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
						КонецЕсли;	
						
						Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
						Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаПрава.АналитикаДоходовОтРеализации;
						Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Договор;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//переоценка первоначального признания права (имущественного или аренды)
			Если Не ЭтотОбъект.Изменение И НастройкиУчетаПрава.ПереоцениватьВДеньОперации И ВыборкаДетальныеЗаписи.ЕстьОценка Тогда
				
				СуммаПереоценки = ВыборкаДетальныеЗаписи.Стоимость - ВыборкаДетальныеЗаписи.Сумма;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(СуммаПереоценки), "Переоценка первоначального признания прав");
				
				Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ Тогда
