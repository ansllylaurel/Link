				КонецЕсли;	
				Если ЕстьСубконтоДтДоговоры Тогда
					Проводка.СубконтоДт.Договоры = ЭтотОбъект.Договор;
				КонецЕсли;	
				
				ЕстьСубконтоКтКонтрагенты = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
				ЕстьСубконтоКтДоговоры = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
				
				Если ЕстьСубконтоКтКонтрагенты Тогда
