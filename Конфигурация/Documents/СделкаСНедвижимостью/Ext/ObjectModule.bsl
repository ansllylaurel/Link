Процедура УстановитьБлокировки(ОсновнаяСделкаСНедвижимостью)

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;	
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.УсловияСделокСНедвижимостью");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Основание",               ОсновнаяСделкаСНедвижимостью);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ГрафикиПлатежей");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Основание",               ОсновнаяСделкаСНедвижимостью);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки()

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	Движения.ГрафикиПлатежей.Записывать = Истина;
	Движения.ГрафикиПлатежей.Записать();
	Движения.УсловияСделокСНедвижимостью.Записывать = Истина;
	Движения.УсловияСделокСНедвижимостью.Записать();
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	
	ОсновнаяСделкаСНедвижимостью = ?(ЗначениеЗаполнено(ЭтотОбъект.Основание), ЭтотОбъект.Основание, ЭтотОбъект.Ссылка);
	
	УстановитьБлокировки(ОсновнаяСделкаСНедвижимостью);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СделкаСНедвижимостьюОбъектыНедвижимости.ОбъектНедвижимости ЕСТЬ NULL
		|			ТОГДА УсловияСделокСНедвижимостьюСрезПоследних.ОбъектНедвижимости
		|		ИНАЧЕ СделкаСНедвижимостьюОбъектыНедвижимости.ОбъектНедвижимости
		|	КОНЕЦ КАК ОбъектНедвижимости,
		|	ЕСТЬNULL(СделкаСНедвижимостьюОбъектыНедвижимости.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(СделкаСНедвижимостьюОбъектыНедвижимости.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)) КАК СтавкаНДС,
		|	ЕСТЬNULL(СделкаСНедвижимостьюОбъектыНедвижимости.СуммаНДС, 0) КАК СуммаНДС,
		|	ЕСТЬNULL(СделкаСНедвижимостьюОбъектыНедвижимости.Срок, ДАТАВРЕМЯ(1, 1, 1)) КАК Срок,
		|	УсловияСделокСНедвижимостьюСрезПоследних.Отменено КАК ОтмененоПрежняя,
		|	СделкаСНедвижимостьюОбъектыНедвижимости.ОбъектНедвижимости ЕСТЬ NULL КАК Отменено,
		|	ЕСТЬNULL(УсловияСделокСНедвижимостьюСрезПоследних.АктПриемаПередачи, ЗНАЧЕНИЕ(Документ.АктПриемаПередачиОбъектовНедвижимости.)) КАК АктПриемаПередачи,
		|	ЕСТЬNULL(УсловияСделокСНедвижимостьюСрезПоследних.СведенияОГосРегистрацииПраваСобственности, ЗНАЧЕНИЕ(Документ.СведенияОРегистрацииПраваСобственности.)) КАК СведенияОГосРегистрацииПраваСобственности
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаСНедвижимостьюОбъектыНедвижимости.Ссылка КАК Ссылка,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.НомерСтроки КАК НомерСтроки,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.Сумма КАК Сумма,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.СтавкаНДС КАК СтавкаНДС,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.СуммаНДС КАК СуммаНДС,
		|		СделкаСНедвижимостьюОбъектыНедвижимости.Срок КАК Срок
		|	ИЗ
		|		Документ.СделкаСНедвижимостью.ОбъектыНедвижимости КАК СделкаСНедвижимостьюОбъектыНедвижимости
		|	ГДЕ
		|		СделкаСНедвижимостьюОбъектыНедвижимости.Ссылка = &Ссылка) КАК СделкаСНедвижимостьюОбъектыНедвижимости
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияСделокСНедвижимостьюСрезПоследних.ОбъектНедвижимости КАК ОбъектНедвижимости,
		|			УсловияСделокСНедвижимостьюСрезПоследних.ПлановаяДатаПередачи КАК ПлановаяДатаПередачи,
		|			УсловияСделокСНедвижимостьюСрезПоследних.Сумма КАК Сумма,
		|			УсловияСделокСНедвижимостьюСрезПоследних.АктПриемаПередачи КАК АктПриемаПередачи,
		|			УсловияСделокСНедвижимостьюСрезПоследних.СведенияОГосРегистрацииПраваСобственности КАК СведенияОГосРегистрацииПраваСобственности,
		|			УсловияСделокСНедвижимостьюСрезПоследних.Отменено КАК Отменено
		|		ИЗ
		|			РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(
		|					&Момент,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И Основание = &Основание) КАК УсловияСделокСНедвижимостьюСрезПоследних
		|		ГДЕ
		|			НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено) КАК УсловияСделокСНедвижимостьюСрезПоследних
		|		ПО СделкаСНедвижимостьюОбъектыНедвижимости.ОбъектНедвижимости = УсловияСделокСНедвижимостьюСрезПоследних.ОбъектНедвижимости";
	
	Запрос.УстановитьПараметр("Момент", ЭтотОбъект.МоментВремени());
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Основание", ОсновнаяСделкаСНедвижимостью);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаписьУсловий = Движения.УсловияСделокСНедвижимостью.Добавить();
		ЗаписьУсловий.Период = Дата;
		ЗаписьУсловий.Организация = Организация;
		ЗаписьУсловий.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ЗаписьУсловий.Основание = ОсновнаяСделкаСНедвижимостью;
		ЗаписьУсловий.ОбъектНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
		ЗаписьУсловий.АктПриемаПередачи = ВыборкаДетальныеЗаписи.АктПриемаПередачи;
		ЗаписьУсловий.СведенияОГосРегистрацииПраваСобственности = ВыборкаДетальныеЗаписи.СведенияОГосРегистрацииПраваСобственности;
		ЗаписьУсловий.ПлановаяДатаПередачи = ВыборкаДетальныеЗаписи.Срок;
		ЗаписьУсловий.Сумма = ВыборкаДетальныеЗаписи.Сумма;
		ЗаписьУсловий.СтавкаНДС = ВыборкаДетальныеЗаписи.СтавкаНДС;
		ЗаписьУсловий.СуммаНДС = ВыборкаДетальныеЗаписи.СуммаНДС;
		ЗаписьУсловий.Отменено = ВыборкаДетальныеЗаписи.Отменено;
	КонецЦикла;
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты ЕСТЬ NULL
		|			ТОГДА ГрафикиПлатежейСрезПоследних.ДатаПлатежа
		|		ИНАЧЕ СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты
		|	КОНЕЦ КАК ПлановаяДатаОплаты,
		|	ВЫБОР
		|		КОГДА СделкаСНедвижимостьюГрафикПлатежей.Сумма ЕСТЬ NULL
		|			ТОГДА ГрафикиПлатежейСрезПоследних.Сумма
		|		ИНАЧЕ СделкаСНедвижимостьюГрафикПлатежей.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ЕСТЬNULL(СделкаСНедвижимостьюГрафикПлатежей.Сумма, 0) - ЕСТЬNULL(ГрафикиПлатежейСрезПоследних.Сумма, 0) КАК ДельтаПоСумме,
		|	НЕ СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты ЕСТЬ NULL КАК Действует
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаСНедвижимостьюГрафикПлатежей.Ссылка КАК Ссылка,
		|		СделкаСНедвижимостьюГрафикПлатежей.НомерСтроки КАК НомерСтроки,
		|		СделкаСНедвижимостьюГрафикПлатежей.Сумма КАК Сумма,
		|		СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты КАК ПлановаяДатаОплаты
		|	ИЗ
		|		Документ.СделкаСНедвижимостью.ГрафикПлатежей КАК СделкаСНедвижимостьюГрафикПлатежей
		|	ГДЕ
		|		СделкаСНедвижимостьюГрафикПлатежей.Ссылка = &Ссылка) КАК СделкаСНедвижимостьюГрафикПлатежей
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ГрафикиПлатежейСрезПоследних.Основание КАК Основание,
		|			ГрафикиПлатежейСрезПоследних.ДатаПлатежа КАК ДатаПлатежа,
		|			ГрафикиПлатежейСрезПоследних.Сумма КАК Сумма,
		|			ГрафикиПлатежейСрезПоследних.Действует КАК Действует
		|		ИЗ
		|			РегистрСведений.ГрафикиПлатежей.СрезПоследних(
		|					&Момент,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И Основание = &Основание) КАК ГрафикиПлатежейСрезПоследних
		|		ГДЕ
		|			ГрафикиПлатежейСрезПоследних.Действует) КАК ГрафикиПлатежейСрезПоследних
		|		ПО СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты = ГрафикиПлатежейСрезПоследних.ДатаПлатежа
		|ГДЕ
		|	(СделкаСНедвижимостьюГрафикПлатежей.ПлановаяДатаОплаты ЕСТЬ NULL
		|			ИЛИ ГрафикиПлатежейСрезПоследних.ДатаПлатежа ЕСТЬ NULL
		|			ИЛИ ЕСТЬNULL(СделкаСНедвижимостьюГрафикПлатежей.Сумма, 0) <> ЕСТЬNULL(ГрафикиПлатежейСрезПоследних.Сумма, 0))";
	
	Запрос.УстановитьПараметр("Момент", ЭтотОбъект.МоментВремени());
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Основание", ОсновнаяСделкаСНедвижимостью);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СуммаСделкиДельта = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаписьГрафика = Движения.ГрафикиПлатежей.Добавить();
		ЗаписьГрафика.Период = Дата;
		ЗаписьГрафика.Организация = Организация;
		ЗаписьГрафика.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ЗаписьГрафика.Основание = ОсновнаяСделкаСНедвижимостью;
		ЗаписьГрафика.ДатаПлатежа = ВыборкаДетальныеЗаписи.ПлановаяДатаОплаты;
		ЗаписьГрафика.Сумма = ВыборкаДетальныеЗаписи.Сумма;
		ЗаписьГрафика.Действует = ВыборкаДетальныеЗаписи.Действует;
		
		СуммаСделкиДельта = СуммаСделкиДельта + ВыборкаДетальныеЗаписи.ДельтаПоСумме;
	КонецЦикла;
	
	Если СуммаСделкиДельта <> 0 Тогда
		
		ЗаписьЗадолженности = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		ЗаписьЗадолженности.Период = Дата;
		ЗаписьЗадолженности.Организация = Организация;
		ЗаписьЗадолженности.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ЗаписьЗадолженности.Основание = ОсновнаяСделкаСНедвижимостью;
		ЗаписьЗадолженности.ТипЗадолженности = ?(ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка, Перечисления.ТипыЗадолженности.Кредиторская, Перечисления.ТипыЗадолженности.Дебиторская);
		ЗаписьЗадолженности.ВидЗадолженности = Документы.СделкаСНедвижимостью.ПолучитьВидЗадолженности(ЭтотОбъект.ВидПраваНаНедвижимость, ЭтотОбъект.ВидСделки, Отказ);
		ЗаписьЗадолженности.Валюта = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
		ЗаписьЗадолженности.Контрагент = ЭтотОбъект.Контрагент;
		ЗаписьЗадолженности.Аванс = Ложь;
		ЗаписьЗадолженности.Сумма = СуммаСделкиДельта;
		ЗаписьЗадолженности.СуммаКупона = 0;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ
		ИЛИ ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Инвестконтракт 
		ИЛИ ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда
			И ЭтотОбъект.ВидСделки = Перечисления.ВидыСделок.Покупка
		Тогда
		
		ВидУчета = Перечисления.ВидыУчета[УчетныйРегистр];
		
		ВидЗадолженности = Документы.СделкаСНедвижимостью.ПолучитьВидЗадолженности(ЭтотОбъект.ВидПраваНаНедвижимость, ЭтотОбъект.ВидСделки, Отказ);
		
		Если ЭтотОбъект.ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ Тогда
			СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСКонтрагентами; 
		Иначе
			СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСЗастройщикамиИАрендодателями; 
		КонецЕсли;	

		
		УчетныйАктив = Документы.СделкаСНедвижимостью.ПолучитьУчетныйАктив(ЭтотОбъект.ВидПраваНаНедвижимость, ЭтотОбъект.ВидСделки, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		НастройкиУчетаПрава = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйАктив, ВидУчета);
		
		Если НЕ ЗначениеЗаполнено(НастройкиУчетаПрава.СчетУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет учета для актива " + УчетныйАктив, ЭтотОбъект.Ссылка,,, Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НастройкиУчетаПрава.СчетУчетаПереоценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет учета переоценки для актива " + УчетныйАктив, ЭтотОбъект.Ссылка,,, Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
