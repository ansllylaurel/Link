
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОписаниеРеквизитовБиржевойСделки(Форма, ДанныеОбъекта)
	
	// :)) Сделка № [345769312] на бирже [ММВБ] с контрагентом ["ООО Вечный Отдых"], [15:30:30]
	// Код расчетов [Т+], режим переговорных сделок (РПС), выкуп эмитентом, первичное размещение
	Форма.Элементы.ОписаниеРеквизитовБиржевойСделки.Заголовок =
		"Сделка № " + ?(ЗначениеЗаполнено(ДанныеОбъекта.НомерСделки), ДанныеОбъекта.НомерСделки, "<Не задан>")
			+ " на бирже " + ?(ЗначениеЗаполнено(ДанныеОбъекта.МестоХранения), Строка(ДанныеОбъекта.МестоХранения), "<Не задана>")
			+ ?(ПустаяСтрока(ДанныеОбъекта.КонтрагентНаБирже), "", " с контрагентом " + Строка(ДанныеОбъекта.КонтрагентНаБирже))
			+ ", " + ?(ДанныеОбъекта.ВремяСделки = Дата(1, 1, 1), "<Время сделки не задано>", Формат(ДанныеОбъекта.ВремяСделки, "ДФ=ЧЧ:мм:сс")) + ","
			+ Символы.ПС
			+ ?(ПустаяСтрока(ДанныеОбъекта.КодРасчетовНаБирже), "", "Код расчетов " + ДанныеОбъекта.КодРасчетовНаБирже)
			+ ?(ПустаяСтрока(ДанныеОбъекта.РежимБиржевыхТоргов), "", ", режим торгов " + ДанныеОбъекта.РежимБиржевыхТоргов)
			+ ?(Не ДанныеОбъекта.НеполныеЛоты, "", ", неполные лоты")
			+ ?(Не ДанныеОбъекта.РежимПереговорныхСделок, "", ", режим переговорных сделок (РПС)")
			+ ?(Не ДанныеОбъекта.ВыкупЭмитентом, "", ", выкуп эмитентом")
			+ ?(Не ДанныеОбъекта.ПервичноеРазмещение, "", ", первичное размещение");
				
КонецПроцедуры // ЗаполнитьОписаниеРеквизитовБиржевойСделки

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;
	
	ЭтоРынокДолей = (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Доли"));
	Элементы.ВнебиржеваяСделка.Доступность = Не ЭтоРынокДолей;
	
	// биржа/внебиржа
	Элементы.ГруппаРеквизитыБиржевойСделки.Видимость = Не Форма.ВнебиржеваяСделка;
	Элементы.ВыкупЭмитентом.Видимость				 = Форма.ВнебиржеваяСделка;
	Элементы.ПлатежноеУсловиеСделки.Видимость		 = Форма.ВнебиржеваяСделка;
	Элементы.ГруппаРеквизитыПоручения.Видимость      = Форма.ВнебиржеваяСделка И (Форма.СделкаЧерезБрокера = 1);
	Элементы.ОтложенноеИсполнение.Доступность        = Не Форма.ВнебиржеваяСделка; // "отлож. исполнение", в терминологии бэк-офиса, означает исполнение в другой день; в тикете же мгновенного исполнения не бывает
	
	// режимы и даты исполнения
	Элементы.РаздельноеИсполнение.Видимость = ДанныеОбъекта.ОтложенноеИсполнение;
	
	Элементы.ДатаИсполнения.Видимость = ДанныеОбъекта.ОтложенноеИсполнение И Не ДанныеОбъекта.РаздельноеИсполнение;
	Элементы.ДатаОплаты.Видимость     = ДанныеОбъекта.РаздельноеИсполнение;
	Элементы.ДатаПоставки.Видимость   = ДанныеОбъекта.РаздельноеИсполнение;
	
	// курс оплаты
	Элементы.ГруппаСобственныйКурсВалютыОплаты.Видимость = ЗначениеЗаполнено(ДанныеОбъекта.ВалютаСделки) И ЗначениеЗаполнено(ДанныеОбъекта.ВалютаОплаты)
									И ДанныеОбъекта.ВалютаСделки <> ДанныеОбъекта.ВалютаОплаты И Форма.ВнебиржеваяСделка;
	Элементы.ВалютаОплаты.Доступность = Форма.ВнебиржеваяСделка;								
	Элементы.КурсОплаты.Доступность   = ДанныеОбъекта.СобственныйКурсОплаты;
	Элементы.ГруппаСуммыВВалютеОплаты.Видимость = Элементы.ГруппаСобственныйКурсВалютыОплаты.Видимость;
	
	Элементы.ЦенныеБумагиСуммаКупонаВВалютеОплаты1.Видимость = (Элементы.ГруппаСобственныйКурсВалютыОплаты.Видимость 
																	И ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"));
	
	// прочие
	Элементы.ГруппаРеквизитыКонтрагентаВнебиржевойСделки.Видимость = Форма.ВнебиржеваяСделка И ЗначениеЗаполнено(ДанныеОбъекта.Контрагент);

	//торговая комиссия
	Элементы.ГруппаУчетТорговойКомиссии.Видимость    = Не Форма.ВнебиржеваяСделка;
	Элементы.ЦенныеБумагиТорговаяКомиссия.Видимость  = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ЦенныеБумагиТорговаяКомиссия1.Видимость = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ВалютаТорговойКомиссии.Видимость        = (Форма.ВариантыОплатыТорговойКомиссииБезДаты = 2 Или Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	Элементы.ДатаОплатыТорговойКомиссии.Видимость    = (Форма.ВариантОплатыТорговойКомиссииСДатой = 1);
	
	ЭтоРынокДеривативов = (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы") 
							Или ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы")
							Или ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы"));
							
	Элементы.ВнебиржеваяСделка.Видимость 	  = Не ЭтоРынокДеривативов;
	Элементы.СделкаЧерезБрокера.Доступность   = Не ЭтоРынокДеривативов;

	РаботаСДокументамиКлиентСервер.НастроитьВидимостьБрокераСделкиИСвязанныхРеквизитов(Форма);
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	
	Элементы.ЦенныеБумагиЦена.Видимость  = Не ЭтоРынокДолей;
	Элементы.ЦенныеБумагиЦена1.Видимость = Не ЭтоРынокДолей;
	Элементы.ПриобретениеПаев.Видимость	 = Форма.ВнебиржеваяСделка
											И ДанныеОбъекта.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка")
											И ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Паи");
		
	Элементы.ДекорацияАкцептовано.Видимость = (ЗначениеЗаполнено(ДанныеОбъекта.Ссылка) И РаботаСДокументами.ДокументАкцептован(ДанныеОбъекта.Ссылка, ДанныеОбъекта.Организация));
	
	Элементы.ОписаниеНоминалаЦеннойБумаги.Видимость = РаботаСЦеннымиБумагамиКлиентСервер.ЭтоРынокЦенныхБумагСНоминалом(ДанныеОбъекта.Рынок);
	
	Если Форма.Модифицированность Тогда //удаление значений скрываемых полей
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
			
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаОплатыТорговойКомиссии", "Объект.ДатаОплатыТорговойКомиссии");
		ПутьКДаннымСкрываемыхПолей.Вставить("ВалютаТорговойКомиссии", "Объект.ВалютаТорговойКомиссии");
		ПутьКДаннымСкрываемыхПолей.Вставить("ПлатежноеУсловиеСделки", "Объект.ПлатежноеУсловиеСделки");	
		ПутьКДаннымСкрываемыхПолей.Вставить("ОтложенноеИсполнение", "Объект.ОтложенноеИсполнение");
		ПутьКДаннымСкрываемыхПолей.Вставить("РаздельноеИсполнение", "Объект.РаздельноеИсполнение");
		ПутьКДаннымСкрываемыхПолей.Вставить("ПриобретениеПаев", "Объект.ПриобретениеПаев");
		ПутьКДаннымСкрываемыхПолей.Вставить("ВыкупЭмитентом", "Объект.ВыкупЭмитентом");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаИсполнения", "Объект.ДатаИсполнения");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаПоставки", "Объект.ДатаПоставки");
 		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаОплаты", "Объект.ДатаОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("Брокер", "Объект.Брокер");		
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаСобственныйКурсВалютыОплаты", "Объект.КурсОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаСобственныйКурсВалютыОплаты", "Объект.СобственныйКурсОплаты");

		МассивРеквизитыКонтрагентаВнебиржевойСделки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.ДепозитарныйСчетКонтрагента, Объект.РасчетныйСчетКонтрагента, Объект.Договор, Объект.НомерДоговораКонтрагента", ",", Истина, Истина);
		МассивРеквизитыБиржевойСделки  = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.НомерСделки, Объект.ВремяСделки, Объект.КодРасчетовНаБирже, Объект.РежимБиржевыхТоргов, Объект.КонтрагентНаБирже, Объект.НеполныеЛоты, Объект.РежимПереговорныхСделок, Объект.ПервичноеРазмещение, Объект.ПриобретениеПаев", ",", Истина, Истина);
		
		Если Не Форма.ВнебиржеваяСделка Тогда //для внебиржевой сделки значение скрыто с формы, очищать значение не нужно.
			МассивРеквизитыБиржевойСделки.Добавить("Объект.МестоХранения");	
		КонецЕсли;
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыКонтрагентаВнебиржевойСделки", МассивРеквизитыКонтрагентаВнебиржевойСделки);
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыБиржевойСделки", МассивРеквизитыБиржевойСделки);
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаРеквизитыПоручения", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.ДатаПорученияУБрокера, Объект.НомерПорученияУБрокера", ",", Истина, Истина));
				
		Если Форма.КорзинаЦенныхБумаг Тогда
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиТорговаяКомиссия", "Объект.ЦенныеБумаги.ТорговаяКомиссия");
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиЦена", "Объект.ЦенныеБумаги.Цена");
		Иначе
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиТорговаяКомиссия1", "ЦенныеБумагиТорговаяКомиссия1");
			ПутьКДаннымСкрываемыхПолей.Вставить("ЦенныеБумагиЦена1", "ЦенныеБумагиЦена1");
		КонецЕсли;
		                                               
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);	
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыВВалютеОплаты(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	
	Если ДанныеОбъекта.ВалютаСделки = ДанныеОбъекта.ВалютаОплаты Тогда	
		ДанныеОбъекта.КурсОплаты 			= Неопределено;
		ДанныеОбъекта.СобственныйКурсОплаты = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеОбъекта.ВалютаСделки) Тогда
		Возврат;
	КонецЕсли;
		
	КурсВалютыОплаты = ?(ДанныеОбъекта.СобственныйКурсОплаты, ДанныеОбъекта.КурсОплаты, ДанныеОбъекта.Дата);
	Коэфициент = РаботаСВалютами.ПересчетСуммыВВалюте(1, ДанныеОбъекта.ВалютаСделки, КурсВалютыОплаты, ДанныеОбъекта.ВалютаОплаты, ДанныеОбъекта.Дата); 

	Форма.ЦенныеБумагиСуммаВВалютеОплаты1       = Форма.ЦенныеБумагиСумма1       * Коэфициент;
	Форма.ЦенныеБумагиСуммаКупонаВВалютеОплаты1 = Форма.ЦенныеБумагиСуммаКупона1 * Коэфициент;
	Форма.ЦенныеБумагиСуммаВсегоВВалютеОплаты1  = Форма.ЦенныеБумагиСуммаВсего1  * Коэфициент;

КонецПроцедуры // РассчитатьСуммыВВалютеОплаты

&НаСервере
Процедура ОчиститьКоличествоИЦену();
	
	Для Каждого ТекСтрока Из Объект.ЦенныеБумаги Цикл
		ТекСтрока.Количество	= 0;
		ТекСтрока.Цена			= 0;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено) Экспорт
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	//РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ВнебиржеваяСделка            = (Объект.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок"));
	ЭтаФорма.СделкаЧерезБрокера           = ?(ЗначениеЗаполнено(Объект.Брокер), 1, 0);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	
	ОбщаяСуммаТорговойКомиссии = Объект.ЦенныеБумаги.Итог("ТорговаяКомиссия");
	
	Если ОбщаяСуммаТорговойКомиссии > 0 Тогда
		Если Объект.ОтложеннаяОплатаТорговойКомиссии Тогда
			ЭтаФорма.ВариантОплатыТорговойКомиссииСДатой = 1;
		Иначе
			ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 2;
		КонецЕсли;
	Иначе
		ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 1;
	КонецЕсли;
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		ЭтаФорма.Элементы.КомандаИзменитьРеквизитыБиржевойСделки.Заголовок = "Открыть";	
	КонецЕсли;
	
	Если Не ЭтаФорма.ВнебиржеваяСделка Тогда
		ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма, Объект);
	КонецЕсли;
			
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
			
	Если Не Объект.Ссылка.Пустая() Тогда
		
		ЭтаФорма.РаскрытыйКонтрагент = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "_РаскрытыйКонтрагент", Объект.Ссылка);
		
		Если ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
			ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = ЭтаФорма.РаскрытыйКонтрагент;
		Иначе
			ЭтаФорма.Элементы.ГиперссылкаРаскрытыйКонтрагент.Заголовок = "Выбрать";
		КонецЕсли;

	КонецЕсли;
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ВидСделки = "Купля-продажа";
	
	Если ЗначениеЗаполнено(Объект.ВалютаСделки) Тогда
		ЭтаФорма.Элементы.ГруппаВВалютеСделки.Заголовок = "В валюте сделки (" + Объект.ВалютаСделки + ")";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		ЭтаФорма.Элементы.ГруппаСуммыВВалютеОплаты.Заголовок = "В валюте оплаты (" + Объект.ВалютаОплаты + ")";	
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()
	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаЦенныеБумаги.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ПриЧтенииСозданииНаСервере();
	
	РаботаСФормами.ЗаполнитьДополнительныеСвязиИПараметрыВыбора(Элементы.Договор, "СчетДоверительногоУправления");
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ТекДепозитарныйСчет = Неопределено;
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
	КонецЕсли;
		
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы") 
		Или Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы")
		Или Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы")Тогда
		
		ТекДепозитарныйСчет = ПредопределенноеЗначение("Справочник.ДепозитарныеСчета.СчетУчетаДеривативов");
		
	ИначеЕсли Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Доли") Тогда
		
		ТекДепозитарныйСчет = ПредопределенноеЗначение("Справочник.ДепозитарныеСчета.СчетУчетаДолей");
		
	КонецЕсли;
	
	Если ТекДепозитарныйСчет <> Неопределено Тогда
	
		Для Каждого СтрокаЦенныхБумаг Из Объект.ЦенныеБумаги Цикл
			СтрокаЦенныхБумаг.ДепозитарныйСчет = ТекДепозитарныйСчет;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(ЭтаФорма.РаскрытыйКонтрагент) Тогда
		ПараметрыЗаписи.Вставить("РаскрытыйКонтрагентВДопСведения");	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;

	ЗаполнитьПодтверждениеОперацииНаСервере();
	
	Если ПараметрыЗаписи.Свойство("РаскрытыйКонтрагентВДопСведения") Тогда
		РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Объект.Ссылка, "_РаскрытыйКонтрагент", ЭтаФорма.РаскрытыйКонтрагент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперациинаСервере();
		КонецЕсли;
	Иначе		
		РаботаСДокументамиКлиент.ОбработкаОповещенияФормыДокумента(ЭтаФорма, Объект.Ссылка, ИмяСобытия, Параметр, Источник);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	Оповестить("СводнаяБиржеваяСделка.Обновить", Объект.Ссылка);
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.СделкаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииДаты(ЭтаФорма);
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
			
	// Определяем, какой использован счет внутреннего учета: ДУ или СОБ	
	РаботаСДокументамиКлиентСервер.ЗаполнитьВидСчетаВнутреннегоУчета(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнебиржеваяСделкаПриИзменении(Элемент)
	
	Если ЭтаФорма.ВнебиржеваяСделка Тогда
		
		Объект.МестоХранения		= ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок");
		Объект.ДатаИсполнения		= Объект.Дата;
		Объект.ОтложенноеИсполнение = Истина;
		ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 1;
		ЭтаФорма.ВариантОплатыТорговойКомиссииСДатой   = 0;
		Объект.ОтложеннаяОплатаТорговойКомиссии        = Ложь;
		
	Иначе
		
		Объект.ВыкупЭмитентом       = Ложь;
		Объект.ОтложенноеИсполнение = Ложь;
		Объект.РаздельноеИсполнение = Ложь;
		Объект.МестоХранения        = Неопределено;
		ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма, Объект);
		
	КонецЕсли;
	
	РасчетныйСчетПриИзменении(Неопределено);
	ВалютаПриИзменении(Неопределено);
	ОтложенноеИсполнениеПриИзменении(Неопределено);
	
	Если Не Элемент = Неопределено Тогда
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	Если Объект.Рынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Паи") Тогда
		Объект.ПриобретениеПаев = Ложь;
	КонецЕсли;
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Доли") Тогда
		
		ВнебиржеваяСделка = Истина;
		ВнебиржеваяСделкаПриИзменении(Неопределено);
		СделкаЧерезБрокера = 0;
		СделкаЧерезБрокераПриИзменении(Неопределено);
		Объект.РасчетныйСчет = Неопределено;
		РасчетныйСчетПриИзменении(Неопределено);
		
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииРынка(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура СделкаЧерезБрокераПриИзменении(Элемент)
	
	Объект.РасчетныйСчет = Неопределено; // т.к. связь параметров выбора не отрабатывает при программном изменении брокера
	
	БрокерПриИзменении(Неопределено);
	
	Если Не Элемент = Неопределено Тогда 			
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	Если СделкаЧерезБрокера = 0 Тогда
		Объект.Брокер = Неопределено;
	КонецЕсли;
	
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", Объект.Дата, Объект.Организация, Объект.Брокер));
	
	Если Не Элемент = Неопределено Тогда 			
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ВалютаРасчетногоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РасчетныйСчет, "Валюта");
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Объект.ВалютаОплаты <> ВалютаРасчетногоСчета Тогда
		Объект.ВалютаОплаты = ВалютаРасчетногоСчета;
	КонецЕсли;
	
	Если Не ЭтаФорма.ВнебиржеваяСделка И Объект.ВалютаСделки <> ВалютаРасчетногоСчета Тогда
		Объект.ВалютаСделки = Неопределено;
	КонецЕсли;
	
	Если Не Элемент = Неопределено Тогда
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложенноеИсполнениеПриИзменении(Элемент)
	
	Если Не Объект.ОтложенноеИсполнение Тогда
		Объект.РаздельноеИсполнение = Ложь;
	КонецЕсли;
	
	Если Не Элемент = Неопределено Тогда
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаздельноеИсполнениеПриИзменении(Элемент)
	
	Если Объект.РаздельноеИсполнение Тогда
		Объект.ДатаОплаты     = Объект.ДатаИсполнения;
		Объект.ДатаПоставки   = Объект.ДатаИсполнения;
	Иначе
		Объект.ДатаИсполнения = Макс(Объект.ДатаОплаты, Объект.ДатаПоставки);
	КонецЕсли;
	
	Если Объект.РаздельноеИсполнение И Не ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		Объект.ВалютаОплаты = Объект.ВалютаСделки;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантыОплатыТорговойКомиссииБезДатыПриИзменении(Элемент)
	
	ЭтаФорма.ВариантОплатыТорговойКомиссииСДатой = 0;
	
	Объект.ОтложеннаяОплатаТорговойКомиссии = Ложь;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОплатыТорговойКомиссииСДатойПриИзменении(Элемент)
	
	ЭтаФорма.ВариантыОплатыТорговойКомиссииБезДаты = 0;
	
	Объект.ОтложеннаяОплатаТорговойКомиссии = Истина;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ВалютаСделки) Тогда
		ЭтаФорма.Элементы.ГруппаВВалютеСделки.Заголовок = "В валюте сделки (" + Объект.ВалютаСделки + ")";		
	КонецЕсли;
	
	Если Не ЭтаФорма.ВнебиржеваяСделка Тогда //для биржевой сделки заполняем значение валюты оплаты и делаем недоступным
		Объект.ВалютаОплаты = Объект.ВалютаСделки;
	КонецЕсли;
		
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
	Если Не Элемент = Неопределено Тогда
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
 		
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыПриИзменении(Элемент)
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
	Если ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		ЭтаФорма.Элементы.ГруппаСуммыВВалютеОплаты.Заголовок = "В валюте оплаты (" + Объект.ВалютаОплаты + ")";	
	КонецЕсли;
		
	Если Не Элемент = Неопределено Тогда
		НастроитьВидимостьИДоступность(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СобственныйКурсОплатыПриИзменении(Элемент)
	
	Объект.КурсОплаты = ?(Объект.СобственныйКурсОплаты, 1, Объект.Дата);
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КурсОплатыПриИзменении(Элемент)
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦеннаяБумага1ПриИзменении(Элемент)
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиКоличество1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "Количество", Объект.ВалютаСделки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦена1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "Цена", Объект.ВалютаСделки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаПроцент1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "ЦенаПроцент", Объект.ВалютаСделки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаКупона1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "ЦенаКупона", Объект.ВалютаСделки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСумма1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "Сумма", Объект.ВалютаСделки);
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаКупона1ПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма,, "СуммаКупона", Объект.ВалютаСделки);
	
	РассчитатьСуммыВВалютеОплаты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСделкиПриИзменении(Элемент)
	
	Если Объект.ВидСделки <> ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
		Объект.ПриобретениеПаев = Ложь;
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаСделкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЭтаФорма.ВнебиржеваяСделка Тогда
		РаботаСДокументамиКлиент.СверитьВыбранноеЗначениеВалютыСВалютойРасчетногоСчета(ВыбранноеЗначение, Объект.ВалютаСделки, Объект.РасчетныйСчет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СверитьВыбранноеЗначениеВалютыСВалютойРасчетногоСчета(ВыбранноеЗначение, Объект.ВалютаОплаты, Объект.РасчетныйСчет);
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ТЧ_ЦЕННЫЕ_БУМАГИ

&НаКлиенте
Процедура ЦенныеБумагиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзменении(ЭтаФорма,, НоваяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиПослеУдаления(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзменении(ЭтаФорма);

