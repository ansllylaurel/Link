&НаКлиенте
Процедура КомандаИзменитьРеквизитыБиржевойСделки(Команда)
	
	ПараметрыФормы = Новый Структура("МестоХранения, НомерСделки, ВремяСделки, КодРасчетовНаБирже, НеполныеЛоты, РежимПереговорныхСделок, КонтрагентНаБирже, ВыкупЭмитентом, ПервичноеРазмещение, РежимБиржевыхТоргов");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ЭтаФорма.ТолькоПросмотр);
	
	НовыеЗнчРеквизитовБиржевойСделки = ОткрытьФормуМодально("Документ.Сделка.Форма.РеквизитыБиржевойСделки", ПараметрыФормы, ЭтаФорма);
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
		
		Если ТипЗнч(НовыеЗнчРеквизитовБиржевойСделки) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеЗнчРеквизитовБиржевойСделки);
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	
		ЗаполнитьОписаниеРеквизитовБиржевойСделки(ЭтаФорма, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

