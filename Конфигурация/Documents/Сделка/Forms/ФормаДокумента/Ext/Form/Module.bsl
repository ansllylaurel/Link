&НаКлиенте
Процедура РасчетЭСПвExcel(Команда)
	
	Если Объект.Рынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Только для облигаций!");
		Возврат;
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.РасчетЭСПвExcel(
		ЭтаФорма.ЦенныеБумагиЦеннаяБумага1,
		Новый Структура("Дата, Организация, СчетДоверительногоУправления, УчетныйАктивЕПС, Партия, СтрокаПартии", 
			Объект.Дата, 
			Объект.Организация, 
			Объект.СчетДоверительногоУправления,
			ПредопределенноеЗначение("Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияРФ"), // специально ставлю АСный актив, что бы была возможность посчитать ЭСП для ССных бумаг
			Объект.Ссылка,
			1),
		Новый Структура("ДатаПокупки, ЦенаПокупки, ЦенаПокупкиКупона, Количество", 
			?(Объект.ОтложенноеИсполнение, Объект.ДатаИсполнения, НачалоДня(Объект.Дата)), 
			ЭтаФорма.ЦенныеБумагиЦена1 + БухгалтерскийУчетЕПС.ОпределитьСуммуРасходовПопадающуюВСтоимостьБумаги(Объект.Ссылка) / ЭтаФорма.ЦенныеБумагиКоличество1, 
			ЭтаФорма.ЦенныеБумагиЦенаКупона1, 
			ЭтаФорма.ЦенныеБумагиКоличество1)
	);
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкаРасчетаССНаСервере(РасшифровкаРасчета)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(Объект, "ЦенныеБумаги", АдресТаблицыСтоимостей, 0, , , РасшифровкаРасчета);
	
	Если РасшифровкаРасчета.Операции.Количество() = 0 Тогда
		
		РасшифровкаРасчета = Неопределено;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета стоимости для варианта '" + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости + "' не реализована");	

	Иначе

		Отчет = Новый ТабличныйДокумент;
		
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Вариант расчета справедливой стоимости: " + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости, , , Отчет);
		ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
		
		РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
		
		РасшифровкаРасчета = Отчет;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаРасчетаСС(Команда)
	
	Отказ = Ложь;	
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ЦенныеБумагиЦеннаяБумага1) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для расшифровки", , "ЦеннаяБумага1");
		Возврат;
	КонецЕсли;
	
	// Формируем расшифровку расчета
	
	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	ЭтаФорма.ЦенныеБумагиЦеннаяБумага1);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	ОшибкаРасчетаРыночнойСтоимости = Ложь;
	
	ЦельРасчета				= ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении");
	НастройкиОценки			= РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета);
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "'", , , , ОшибкаРасчетаРыночнойСтоимости);
		
	ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = ПредопределенноеЗначение("Справочник.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом") Тогда
		
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
			АдресТаблицыСтоимостей = РаботаСВнешнимиСистемамиКлиентСервер.ВыбратьФайлОценочнойСтоимостиПредоставленнойКлиентом(
				Объект.СчетДоверительногоУправления, Объект.Дата, Ложь, ЭтаФорма.УникальныйИдентификатор);
			Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
				ОшибкаРасчетаРыночнойСтоимости = Истина;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		АдресТаблицыСтоимостей = Неопределено;
		
	КонецЕсли;
	
	Если ОшибкаРасчетаРыночнойСтоимости Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рыночная стоимость не рассчитана.", , , , Отказ);		
		Возврат;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);	
	КонецЕсли;
	
	// Пересчет рыночной стоимости

	РасшифровкаРасчетаССНаСервере(РасшифровкаРасчета);
	
	Если ТипЗнч(РасшифровкаРасчета) = Тип("ТабличныйДокумент") Тогда
		РасшифровкаРасчета.Показать("Расчет стоимости '" + Строка(ЭтаФорма.ЦенныеБумагиЦеннаяБумага1) + "'");		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЭСПНаРыночностьСервере()
	
	ДатаПереоценки = НачалоДня(Объект.Дата);
	
	ОбщаяСумма = ЭтаФорма.ЦенныеБумагиСуммаВсего1 + БухгалтерскийУчетЕПС.ОпределитьСуммуРасходовПопадающуюВСтоимостьБумаги(Объект.Ссылка);
	ЦенаПриобретения = ОбщаяСумма / ЭтаФорма.ЦенныеБумагиКоличество1;
	
	Облигация = ЭтаФорма.ЦенныеБумагиЦеннаяБумага1;
	
	ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ВидУчета);
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета);
	ВариантРасчетаОценочнойСтоимости = НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости;
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("Организация",							Объект.Организация);
	ПараметрыОценки.Вставить("СчетДоверительногоУправления",		Объект.СчетДоверительногоУправления);
	ПараметрыОценки.Вставить("ВидУчета",							ВидУчета);
	ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	ВариантРасчетаОценочнойСтоимости);
	ПараметрыОценки.Вставить("Клиент",								Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, ДатаПереоценки));
	ПараметрыОценки.Вставить("ПараметрыПолученияПартий",			РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(ЦельРасчета, ВидУчета, ВариантРасчетаОценочнойСтоимости, ДатаПереоценки));
	
	Отказ = Ложь;
	
	ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, Облигация, Отказ);
	Если Отказ Тогда
	    Возврат Неопределено;
	КонецЕсли;
	
	ДоходностьДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
							Облигация,
							ПараметрыДенежногоПотока.ДоДатыПогашения,
							ДатаПереоценки,
							ЦенаПриобретения,
							Объект.СчетДоверительногоУправления,
							ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);
	
	Если ТипЗнч(ДоходностьДюрация) = Тип("Структура") Тогда
		
		ЭСП = ДоходностьДюрация.Доходность;
		
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления);
		Если НастройкиУчета.РазрядностьОкругленияЭСП > 0 Тогда
			ЭСП = Окр(ЭСП, НастройкиУчета.РазрядностьОкругленияЭСП);
		Иначе
			ЭСП = Метаданные.ОпределяемыеТипы.ЭффективнаяПроцентнаяСтавка.Тип.ПривестиЗначение(ЭСП);	
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
	Отчет = Новый ТабличныйДокумент;
	
	ПараметрыПроверки = Новый Структура("НомерСтроки, ЦеннаяБумага, Партия, СтрокаПартии, ЦенаПокупки, НоминалТекущий", 1, Облигация, Объект.Ссылка, 1, ЦенныеБумагиСумма1/ЦенныеБумагиКоличество1, ЦенныеБумагиНоминал1);
	
	Если БухгалтерскийУчетЕПС.ПроверитьЭСПНаРыночность(Облигация, ЭСП, ДатаПереоценки, Объект.СчетДоверительногоУправления, Отчет, ПараметрыПроверки, Отказ) <> Неопределено Тогда
		Возврат Отчет;
	КонецЕсли;
	
КонецФункции
