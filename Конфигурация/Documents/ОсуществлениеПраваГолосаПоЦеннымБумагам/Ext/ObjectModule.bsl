Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	Если Клиенты.Количество() = 0 Или ВопросыПовестки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПериодДвижения = ?(ЗначениеЗаполнено(ДатаГолосования), ДатаГолосования, Дата);
	
	Движения.ГолосованияНаСобранияхВладельцевЦенныхБумаг.Записывать = Истина;
	
	Для Каждого СтрокаКлиент Из Клиенты Цикл
		
		НомерВопроса = 0;
		Для Каждого СтрокаВопрос Из ВопросыПовестки Цикл
			
			НомерВопроса = НомерВопроса + 1;
			
			Движение = Движения.ГолосованияНаСобранияхВладельцевЦенныхБумаг.Добавить();
			Движение.Период                       = ПериодДвижения;
			Движение.Организация                  = Организация;
			Движение.СчетДоверительногоУправления = СтрокаКлиент.СчетДоверительногоУправления;
			Движение.ЦеннаяБумага                 = ЦеннаяБумага;
			Движение.НомерВопроса                 = НомерВопроса;
			Движение.ПовесткаДня                  = ПовесткаДня;
			Движение.ВопросПовесткиДня            = СтрокаВопрос.ВопросПовесткиДня;
			Движение.ВариантГолосования           = СтрокаВопрос.ВариантГолосования;
			Движение.ПозицияПоВопросу             = Строка(СтрокаВопрос.ВариантГолосования);
			Движение.ДатаГолосования              = ДатаГолосования;
			Движение.ДатаСобранияНачало           = ДатаСобранияНачало;
			Движение.ДатаСобранияОкончание        = ДатаСобранияОкончание;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Клиенты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнен список клиентов (счетов ДУ)", ЭтотОбъект, "Клиенты", , Отказ);
	КонецЕсли;
	
	Если ВопросыПовестки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнен список вопросов повестки дня и вариантов голосования", ЭтотОбъект, "ВопросыПовестки", , Отказ);
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		ПредупредитьОДубляхГолосований();
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписью

Процедура ПередУдалением(Отказ)
	
	РаботаСЖурналамиОпераций.ПередУдалениемДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПриЗаписи

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит предупреждение (без отказа), если по портфелю уже заведен документ голосования
// по этой же ценной бумаге и собранию. Служит для контроля дублей.
Процедура ПредупредитьОДубляхГолосований()
	
	Если Клиенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСчетов = Клиенты.ВыгрузитьКолонку("СчетДоверительногоУправления");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Голосования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Голосования.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ГолосованияНаСобранияхВладельцевЦенныхБумаг КАК Голосования
		|ГДЕ
		|	Голосования.Организация = &Организация
		|	И Голосования.ЦеннаяБумага = &ЦеннаяБумага
		|	И Голосования.ДатаСобранияНачало = &ДатаСобранияНачало
		|	И Голосования.Регистратор <> &Регистратор
		|	И Голосования.СчетДоверительногоУправления В (&МассивСчетов)";
	
	Запрос.УстановитьПараметр("Организация",         Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага",        ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДатаСобранияНачало",  ДатаСобранияНачало);
	Запрос.УстановитьПараметр("Регистратор",         Ссылка);
	Запрос.УстановитьПараметр("МассивСчетов",        МассивСчетов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Внимание! По портфелю """ + Строка(Выборка.СчетДоверительногоУправления)
			+ """ уже заведен документ голосования по данной ценной бумаге и собранию: "
			+ Строка(Выборка.Регистратор));
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
