
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Клиенты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнен список клиентов", ЭтотОбъект, "Клиенты", , Отказ);
	КонецЕсли;
	
	Если ВопросыПовестки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнен список вопросов повестки дня и вариантов голосования", ЭтотОбъект, "ВопросыПовестки", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		ПредупредитьОДубляхГолосований();	
	КонецЕсли;
		
КонецПроцедуры // ПриЗаписи

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПредупредитьОДубляхГолосований()

	Если Клиенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСчетов = Клиенты.ВыгрузитьКолонку("СчетДоверительногоУправления");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧКлиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТЧКлиенты.Ссылка КАК Документ
		|ИЗ
		|	Документ.ОсуществлениеПраваГолосаПоЦеннымБумагам.Клиенты КАК ТЧКлиенты
		|ГДЕ
		|	ТЧКлиенты.Ссылка.Организация = &Организация
		|	И ТЧКлиенты.Ссылка.ЦеннаяБумага = &ЦеннаяБумага
		|	И ТЧКлиенты.Ссылка.ДатаСобранияНачало = &ДатаСобранияНачало
		|	И ТЧКлиенты.Ссылка <> &Документ
		|	И ТЧКлиенты.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ТЧКлиенты.СчетДоверительногоУправления В (&МассивСчетов)";

	Запрос.УстановитьПараметр("Организация",         Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага",        ЦеннаяБумага);
	Запрос.УстановитьПараметр("ДатаСобранияНачало",  ДатаСобранияНачало);
	Запрос.УстановитьПараметр("Документ",            Ссылка);
	Запрос.УстановитьПараметр("МассивСчетов",        МассивСчетов);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Внимание! По портфелю """ + Строка(Выборка.СчетДоверительногоУправления)
			+ """ уже заведен документ голосования по данной ценной бумаге и собранию: "
			+ Строка(Выборка.Документ));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
