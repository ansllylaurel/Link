КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	Движения[УчетныйРегистр].Записать();//очистим движения перед запросом остатков на конец дня
	Движения[УчетныйРегистр].Записывать = Истина;	
	
	ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлы(УчетныйРегистр, Отказ);
	
	//а надо?
	Если НЕ Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(Дата, Организация, СчетДоверительногоУправления, ВидУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ОбработкаПроведенияЕПС(Отказ, Режим);
		Возврат;
	КонецЕсли;
	
	НастройкиУчетаОбщие  = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	МассивУчетныеАктивыПоЦБ = Новый Массив;
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Акции);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ВекселяДисконтные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ВекселяПроцентные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Паи);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов);
	
	ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента = БухгалтерскийУчетЕПС.ПолучитьЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаВЗалоге КАК СчетУчетаВЗалоге,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценкиВЗалоге КАК СчетУчетаПереоценкиВЗалоге
		|ПОМЕСТИТЬ _СчетаУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&НаДату,
		|			ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И УчетныйАктив В (&МассивУчетныеАктивыПоЦБ)) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаУчета.СчетУчета КАК Счет
		|ПОМЕСТИТЬ _СчетаУчетаРазвернуто
		|ИЗ
		|	_СчетаУчета КАК _СчетаУчета
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_СчетаУчета.СчетУчетаПереоценки
		|ИЗ
		|	_СчетаУчета КАК _СчетаУчета
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_СчетаУчета.СчетУчетаВЗалоге
		|ИЗ
		|	_СчетаУчета КАК _СчетаУчета
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_СчетаУчета.СчетУчетаПереоценкиВЗалоге
		|ИЗ
		|	_СчетаУчета КАК _СчетаУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основной.Ссылка КАК Счет
		|ПОМЕСТИТЬ _СчетаДляПерекурсовки
		|ИЗ
		|	ПланСчетов.Основной КАК Основной
		|ГДЕ
		|	Основной.Валютный
		|	И НЕ Основной.Забалансовый
		|	И НЕ Основной.Ссылка В
		|				(ВЫБРАТЬ
		|					_СчетаУчетаРазвернуто.Счет
		|				ИЗ
		|					_СчетаУчетаРазвернуто)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	БухгалтерскийУчетОстатки.Субконто3 КАК Субконто3,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	(ВЫРАЗИТЬ(БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток * КурсВалютыОстатка.Курс / КурсВалютыОстатка.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК ЧИСЛО(21, 2))) - БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаКурсовойРазницы,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|			ТОГДА ВЫБОР
		|					КОГДА БухгалтерскийУчетОстатки.СуммаОстаток > 0
		|						ТОГДА ЗНАЧЕНИЕ(ВидСчета.Активный)
		|					ИНАЧЕ ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|				КОНЕЦ
		|		ИНАЧЕ БухгалтерскийУчетОстатки.Счет.Вид
		|	КОНЕЦ КАК ВидСчетаУчета
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&КонецДняПереоценки,
		|			Счет В
		|				(ВЫБРАТЬ
		|					_СчетаДляПерекурсовки.Счет
		|				ИЗ
		|					_СчетаДляПерекурсовки),
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И Валюта <> &ВалютаУчета) КАК БухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыОстатка
		|		ПО БухгалтерскийУчетОстатки.Валюта = КурсВалютыОстатка.Валюта,
		|	РегистрСведений.КурсыВалют КАК КурсВалютыУчета
		|ГДЕ
		|	КурсВалютыУчета.Валюта = &ВалютаУчета
		|	И КурсВалютыОстатка.Период = &Период
		|	И КурсВалютыУчета.Период = &Период
		|	И НЕ БухгалтерскийУчетОстатки.Субконто1 В (&ДефолтныеБумаги)
		|	И (БухгалтерскийУчетОстатки.Субконто2 ЕСТЬ NULL
		|			ИЛИ НЕ БухгалтерскийУчетОстатки.Субконто2 В (&ДефолтныеБумаги))
		|	И (БухгалтерскийУчетОстатки.Субконто3 ЕСТЬ NULL
		|			ИЛИ НЕ БухгалтерскийУчетОстатки.Субконто3 В (&ДефолтныеБумаги))
		|	И (ВЫРАЗИТЬ(БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток * КурсВалютыОстатка.Курс / КурсВалютыОстатка.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК ЧИСЛО(21, 2))) - БухгалтерскийУчетОстатки.СуммаОстаток <> 0";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета));
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("МассивУчетныеАктивыПоЦБ", МассивУчетныеАктивыПоЦБ);
	Запрос.УстановитьПараметр("НаДату", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("Период", ДатаПереоценки);
	Запрос.УстановитьПараметр("КонецДняПереоценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
	// задложенности по дефолтным облигациям не трогаем
	Запрос.УстановитьПараметр("ДефолтныеБумаги", ЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыКурсовойРазницы = Новый Структура("СуммаКурсовойРазницы, Валюта, Счет, ВидСчетаУчета, Субконто1, Субконто2, Субконто3");
		
		ЗаполнитьЗначенияСвойств(ПараметрыКурсовойРазницы, ВыборкаДетальныеЗаписи);
		
		Если НЕ БухгалтерскийУчет.КурсоваяРазницаПереоценкиУдовлетворяет67ФЗ(ПараметрыКурсовойРазницы.СуммаКурсовойРазницы, ЭтотОбъект.ВидУчета, ПараметрыКурсовойРазницы.Счет, ЭтотОбъект.Дата) Тогда 			
			БухгалтерскийУчет.ДобавитьПроводкуКурсовойРазницы(ЭтотОбъект, УчетныйРегистр, ПараметрыКурсовойРазницы, НастройкиУчетаОбщие, Ложь, Отказ);
		Иначе 
			Если ПараметрыКурсовойРазницы.Счет  = ПланыСчетов.Основной.ПредоставленныеЗаймы 
				И ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
				// #542182 
				БухгалтерскийУчет.ДобавитьПроводкуКурсовойРазницы(ЭтотОбъект, УчетныйРегистр, ПараметрыКурсовойРазницы, НастройкиУчетаОбщие, Истина, Отказ);;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлыПереоценкаОстатков(УчетныйРегистр, НастройкиУчетаАктива, Отказ)
	
	СчетПрочиеРасходы				= ПланыСчетов.Основной.ПрочиеРасходы;
	СчетПрочиеДоходы				= ПланыСчетов.Основной.ПрочиеДоходы;
	ВидСубконтоУчетаЦеннойБумаги	= БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	БухгалтерскийУчетОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстаток,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта
		|ПОМЕСТИТЬ _ОстаткиАктива
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Граница,
		|			Счет = &СчетУчетаАктивов,
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта
		|ПОМЕСТИТЬ _ОстаткиПереоценки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Граница,
		|			Счет = &СчетУчетаПереоценки,
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ОстаткиАктива.ЦеннаяБумага, _ОстаткиПереоценки.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_ОстаткиАктива.КоличествоОстаток, 0) * КотировкиТорговыхПлощадок.CLOSE - (ЕСТЬNULL(_ОстаткиАктива.СуммаОстаток, 0) + ЕСТЬNULL(_ОстаткиПереоценки.СуммаОстаток, 0)) КАК СуммаПереоценки,
		|	ЕСТЬNULL(_ОстаткиАктива.Валюта, _ОстаткиПереоценки.Валюта) КАК Валюта
		|ИЗ
		|	_ОстаткиАктива КАК _ОстаткиАктива
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ОстаткиПереоценки КАК _ОстаткиПереоценки
		|		ПО _ОстаткиАктива.ЦеннаяБумага = _ОстаткиПереоценки.ЦеннаяБумага
		|			И _ОстаткиАктива.Валюта = _ОстаткиПереоценки.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок.СрезПоследних(
		|				&Граница,
		|				Биржа = &БиржаММВБ
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы)) КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = ЕСТЬNULL(_ОстаткиАктива.ЦеннаяБумага, _ОстаткиПереоценки.ЦеннаяБумага))
		|ГДЕ
		|	ЕСТЬNULL(_ОстаткиАктива.КоличествоОстаток, 0) * КотировкиТорговыхПлощадок.CLOSE - (ЕСТЬNULL(_ОстаткиАктива.СуммаОстаток, 0) + ЕСТЬNULL(_ОстаткиПереоценки.СуммаОстаток, 0)) <> 0";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета));
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("СчетУчетаАктивов", НастройкиУчетаАктива.СчетУчета);
	Запрос.УстановитьПараметр("СчетУчетаПереоценки", НастройкиУчетаАктива.СчетУчетаПереоценки);
	Запрос.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, "Переоценка ТБС");
		
		Если ВыборкаДетальныеЗаписи.СуммаПереоценки > 0 Тогда
			Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаПереоценки;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			
			Если НастройкиУчетаАктива.СчетУчетаПереоценки.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, ЭтотОбъект.Организация.ВалютаУчета, ЭтотОбъект.Дата, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Дата, Отказ);
				Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.Валюта;
			КонецЕсли;
			
			Проводка.СчетКт = СчетПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ		= Ложь;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СуммаПереоценки < 0 Тогда
			
			//кредит. дебет потом
			Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			
			Если НастройкиУчетаАктива.СчетУчетаПереоценки.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = РаботаСВалютами.ПересчетСуммыВВалюте(?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, ЭтотОбъект.Организация.ВалютаУчета, ЭтотОбъект.Дата, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Дата, Отказ);
				Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
			КонецЕсли;			
			//дебет			
			Проводка.СчетДт = СчетПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ		= Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлыПереоценкаНезавершенныхСделок(УчетныйРегистр, НастройкиУчетаАктива, Отказ)
	
	СчетПрочиеРасходы				= ПланыСчетов.Основной.ПрочиеРасходы;
	СчетПрочиеДоходы				= ПланыСчетов.Основной.ПрочиеДоходы;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Сделка,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиАктива
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Граница,
		|			Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Сделка,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаПереоценкиОстаток
		|ПОМЕСТИТЬ _ОстаткиПереоценки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Граница,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Сделка),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПРЕДСТАВЛЕНИЕ(_ОстаткиПереоценки.Сделка) КАК Сделка,
		|	ПРЕДСТАВЛЕНИЕ(_ОстаткиПереоценки.Валюта) КАК Валюта,
		|	_ОстаткиПереоценки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _НеСписанныеИсполнениямиСуммы
		|ИЗ
		|	_ОстаткиПереоценки КАК _ОстаткиПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиАктива КАК _ОстаткиАктива
		|		ПО (_ОстаткиАктива.Сделка = _ОстаткиПереоценки.Сделка)
		|			И (_ОстаткиАктива.Валюта = _ОстаткиПереоценки.Валюта)
		|ГДЕ
		|	_ОстаткиАктива.Сделка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиАктива.Сделка КАК Сделка,
		|	_ОстаткиАктива.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиАктива.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА _ОстаткиАктива.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЕСТЬNULL(_ОстаткиАктива.КоличествоОстаток, 0) * КотировкиТорговыхПлощадокСрезПоследних.CLOSE - (ЕСТЬNULL(_ОстаткиАктива.СуммаОстаток, 0) + ЕСТЬNULL(_ОстаткиПереоценки.СуммаОстаток, 0))
		|		ИНАЧЕ ЕСТЬNULL(_ОстаткиАктива.СуммаОстаток, 0) - ЕСТЬNULL(_ОстаткиПереоценки.СуммаОстаток, 0) - ЕСТЬNULL(_ОстаткиАктива.КоличествоОстаток, 0) * КотировкиТорговыхПлощадокСрезПоследних.CLOSE
		|	КОНЕЦ КАК СуммаПереоценки,
		|	_ОстаткиАктива.Сделка.Брокер КАК Брокер
		|ИЗ
		|	_ОстаткиАктива КАК _ОстаткиАктива
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПереоценки КАК _ОстаткиПереоценки
		|		ПО _ОстаткиАктива.Сделка = _ОстаткиПереоценки.Сделка
		|			И _ОстаткиАктива.Валюта = _ОстаткиПереоценки.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок.СрезПоследних(
		|				&Граница,
		|				Биржа = &БиржаММВБ
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы)) КАК КотировкиТорговыхПлощадокСрезПоследних
		|		ПО (КотировкиТорговыхПлощадокСрезПоследних.ЦеннаяБумага = _ОстаткиАктива.ЦеннаяБумага)";
	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета));
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНеСписанныеИсполнениямиСуммы = Запрос.МенеджерВременныхТаблиц.Таблицы["_НеСписанныеИсполнениямиСуммы"].ПолучитьДанные().Выбрать();
	
	Если ВыборкаНеСписанныеИсполнениямиСуммы.Количество() > 0 Тогда
		Пока ВыборкаНеСписанныеИсполнениямиСуммы.Следующий() Цикл
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету ДУ " + ЭтотОбъект.СчетДоверительногоУправления + " и сделке " + ВыборкаНеСписанныеИсполнениямиСуммы.Сделка + " обнаружена не списанная переоценка незавешенных сделок на сумму " + Формат(ВыборкаНеСписанныеИсполнениямиСуммы.СуммаОстаток, "ЧЦ=15; ЧДЦ=2") ,,,,Отказ); 
	
		КонецЦикла;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(СчетДоверительногоУправления, ВыборкаДетальныеЗаписи.Брокер, Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, "Переоценка НС");
		
		Если ВыборкаДетальныеЗаписи.СуммаПереоценки >= 0 Тогда
			Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок;
			Проводка.СубконтоДт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
			Проводка.СубконтоДт.БрокерскиеКомпании = ВыборкаДетальныеЗаписи.Брокер;
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			
			Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, ЭтотОбъект.Организация.ВалютаУчета, ЭтотОбъект.Дата, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Дата, Отказ);
			Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.Валюта;
			
			Проводка.СчетКт = СчетПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ		= Ложь;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СуммаПереоценки < 0 Тогда
			
			//кредит. дебет потом
			Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоПереоценкеНезавершенныхСделок;
			Проводка.СубконтоКт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
			Проводка.СубконтоКт.БрокерскиеКомпании = ВыборкаДетальныеЗаписи.Брокер;
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			
			Проводка.ВалютнаяСуммаКт = РаботаСВалютами.ПересчетСуммыВВалюте(?(ВыборкаДетальныеЗаписи.СуммаПереоценки<0,-1,1) * ВыборкаДетальныеЗаписи.СуммаПереоценки, ЭтотОбъект.Организация.ВалютаУчета, ЭтотОбъект.Дата, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Дата, Отказ);
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
				
			//дебет			
			Проводка.СчетДт = СчетПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ		= Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлы(УчетныйРегистр, Отказ)
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Или ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		
		УчетныйАктив					= БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы, Неопределено);
		НастройкиУчетаАктива			= БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, Организация, СчетДоверительногоУправления, УчетныйАктив, УчетныйРегистр);
		
		ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлыПереоценкаНезавершенныхСделок(УчетныйРегистр, НастройкиУчетаАктива, Отказ);
		
		ПериодичностьПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.ДрагоценныеМеталлы, ВидУчета, "ПериодичностьПереоценки");
		
		Если ЗначениеЗаполнено(ПериодичностьПереоценки)
			И ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать Тогда
			
			КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Дата);
			
			Если БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, Дата, КалендарьДляСчетаДУ) Тогда 
				ПроведениеПоРегиструБухгалтерииДрагоценныеМеталлыПереоценкаОстатков(УчетныйРегистр, НастройкиУчетаАктива, Отказ);	
			КонецЕсли;	
			
		КонецЕсли;	
		
	ИначеЕсли ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда	
		
		// По ЕПС пока что учет драгоценных металлов не определен.
		
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

