
Процедура ОбработкаПроведенияЕПС(Отказ, Режим)
	
	// #404987 - хардкод для Большого: задолженность по погашению (тела или купона) на 500х счетах нужно перекурсовать ЕЖЕДНЕВНО
	// остальное ежемесячно
	ЭтоБольшой = (Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой"));
	ЭтоКонецМесяца = (НачалоДня(ЭтотОбъект.Дата) = НачалоДня(КонецМесяца(ЭтотОбъект.Дата)));
	
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	МетодикаПерекурсовкиВалютныхАктивовИОбязательств = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "МетодикаПерекурсовкиВалютныхАктивовИОбязательств");
	
	МассивДопАналитикиПоЦБ = Новый Массив;
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
	
	// ма не должны перекурсовывать просроченное погашение
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА КАК Счет
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаРезервов
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКупона
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокА
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСчетовУчетаБумаг = РезультатЗапроса.Выгрузить();
	ТаблицаИсключаемыхСчетов = БухгалтерскийУчетЕПС.НеПерекурсовыватьСчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3 КАК Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток * КурсВалютыОстатка.Курс / КурсВалютыОстатка.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК СуммаВВалютеУчета,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид  КАК ВидСчета
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&МоментПереоценки,
		|			Счет.Валютный,
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И Валюта <> &ВалютаУчета) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыОстатка
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Валюта = КурсВалютыОстатка.Валюта,
		|	РегистрСведений.КурсыВалют КАК КурсВалютыУчета
		|ГДЕ
		|	КурсВалютыУчета.Валюта = &ВалютаУчета
		|	И КурсВалютыОстатка.Период = &Период
		|	И КурсВалютыУчета.Период = &Период";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("Период", ДатаПереоценки);
	Если МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьВНачалеИКонцеДня Тогда
		Запрос.УстановитьПараметр("МоментПереоценки", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	ИначеЕсли МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьКаждымДокументомИВКонцеДняПоНастройкамПериодичности Тогда
		Запрос.УстановитьПараметр("МоментПереоценки", Новый Граница(КонецДня(ДатаПереоценки), ВидГраницы.Включая));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить методику перекурсовки активов и обязательств для  " + ЭтотОбъект.СчетДоверительногоУправления + " в организации " + ЭтотОбъект.Организация,,,,Отказ); 
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекСчет = ВыборкаДетальныеЗаписи.Счет;
		ТекДопАналитика = ВыборкаДетальныеЗаписи.ДополнительнаяАналитика;
		
		Если ТаблицаСчетовУчетаБумаг.Найти(ТекСчет, "Счет") <> Неопределено Тогда
			Если МассивДопАналитикиПоЦБ.Найти(ТекДопАналитика) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;			
			//Продолжить;
		ИначеЕсли МассивДопАналитикиПоЦБ.Найти(ТекДопАналитика) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокиТаблицыИсключаемыхСчетов = ТаблицаИсключаемыхСчетов.НайтиСтроки(Новый Структура("Счет, ДополнительнаяАналитика", ТекСчет, ?(ЗначениеЗаполнено(ТекДопАналитика), ТекДопАналитика, Неопределено)));
		Если СтрокиТаблицыИсключаемыхСчетов.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСчет = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами12 Тогда
			//это аванс				
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Субконто2) = Тип("СправочникСсылка.Договоры") Тогда
				ВидДоговора = ВыборкаДетальныеЗаписи.Субконто2.ВидДоговора;
				Если ВидДоговора = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.ОтветственногоХранения
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.ВеденияРеестра
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// #404987 - хардкод для Большого: задолженность по погашению (тела или купона) на 500х счетах нужно перекурсовать ЕЖЕДНЕВНО
		// остальное ежемесячно
		Если ЭтоБольшой И НЕ ЭтоКонецМесяца И ДатаПереоценки < '20220101'
			И ВыборкаДетальныеЗаписи.ДополнительнаяАналитика <> Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона
			И ВыборкаДетальныеЗаписи.ДополнительнаяАналитика <> Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		СуммаКурсовойРазницы = Окр(ВыборкаДетальныеЗаписи.СуммаВВалютеУчета, 2) - ВыборкаДетальныеЗаписи.СуммаОстаток;
		Если СуммаКурсовойРазницы = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыКурсовойРазницы = Новый Структура("СуммаКурсовойРазницы, Валюта, Счет, ВидСчетаУчета, Субконто1, Субконто2, Субконто3, ДополнительнаяАналитика",
			СуммаКурсовойРазницы, 
			ВыборкаДетальныеЗаписи.Валюта,
			ВыборкаДетальныеЗаписи.Счет,
			ВыборкаДетальныеЗаписи.ВидСчета,
			ВыборкаДетальныеЗаписи.Субконто1,
			ВыборкаДетальныеЗаписи.Субконто2,
			ВыборкаДетальныеЗаписи.Субконто3,
			ВыборкаДетальныеЗаписи.ДополнительнаяАналитика);
			
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
		
			ПараметрыКурсовойРазницы.Вставить("Партия", ВыборкаДетальныеЗаписи.ЛицевойСчет.Партия);
			ПараметрыКурсовойРазницы.Вставить("СтрокаПартии", ВыборкаДетальныеЗаписи.ЛицевойСчет.СтрокаПартии);
		
		КонецЕсли;
			
		БухгалтерскийУчетЕПС.ДобавитьПроводкуКурсовойРазницы(ЭтотОбъект, ПараметрыКурсовойРазницы, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Функция Перекурсовка(СтрокаПартий, Отказ)
	
	НовоеДвижение = Движения.БухПартииЦенныхБумаг.Добавить();
	
	НовоеДвижение.Организация		= ЭтотОбъект.Организация;
	НовоеДвижение.СчетДоверительногоУправления		= ЭтотОбъект.СчетДоверительногоУправления;
	НовоеДвижение.ВидУчета			= Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	НовоеДвижение.ЦеннаяБумага 		= СтрокаПартий.ЦеннаяБумага;
	НовоеДвижение.УчетныйАктивЕПС 	= СтрокаПартий.УчетныйАктивЕПС;
	НовоеДвижение.Партия 			= СтрокаПартий.Партия;
	НовоеДвижение.СтрокаПартии 		= СтрокаПартий.СтрокаПартии;
	НовоеДвижение.Рынок 			= СтрокаПартий.Рынок;
	
	НовоеДвижение.ВидДвижения 		= Перечисления.ВидыДвижений.Приход;
	НовоеДвижение.Регистратор 		= ЭтотОбъект.Ссылка;
	НовоеДвижение.Период 			= ЭтотОбъект.Дата;
		
	СуммыВВалюте = Новый Структура();
	СуммыВВалюте.Вставить("СтоимостьВВалютеУчета", СтрокаПартий.Стоимость);
	СуммыВВалюте.Вставить("СтоимостьКупонаВВалютеУчета", СтрокаПартий.СтоимостьКупона);
	СуммыВВалюте.Вставить("ПереоценкаВВалютеУчета", СтрокаПартий.Переоценка);
	СуммыВВалюте.Вставить("ПереоценкаКупонаВВалютеУчета", СтрокаПартий.ПереоценкаКупона);
	СуммыВВалюте.Вставить("ДисконтПремияНачисленныйВВалютеУчета", СтрокаПартий.ДисконтПремияНачисленный);
	СуммыВВалюте.Вставить("КорректировкаЭСПВВалютеУчета", СтрокаПартий.КорректировкаЭСП);
	СуммыВВалюте.Вставить("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета", СтрокаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
	
	РаботаСВалютами.ПолучитьСуммыВВалютеУчета(СуммыВВалюте, СтрокаПартий.ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, , Отказ);
	
	НовоеДвижение.СтоимостьВВалютеУчета = (СуммыВВалюте.СтоимостьВВалютеУчета - СтрокаПартий.СтоимостьВВалютеУчета);
	НовоеДвижение.СтоимостьКупонаВВалютеУчета = (СуммыВВалюте.СтоимостьКупонаВВалютеУчета - СтрокаПартий.СтоимостьКупонаВВалютеУчета);
	НовоеДвижение.ПереоценкаВВалютеУчета = (СуммыВВалюте.ПереоценкаВВалютеУчета - СтрокаПартий.ПереоценкаВВалютеУчета);
	НовоеДвижение.ПереоценкаКупонаВВалютеУчета = (СуммыВВалюте.ПереоценкаКупонаВВалютеУчета - СтрокаПартий.ПереоценкаКупонаВВалютеУчета);
	НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета = (СуммыВВалюте.ДисконтПремияНачисленныйВВалютеУчета - СтрокаПартий.ДисконтПремияНачисленныйВВалютеУчета);
	НовоеДвижение.КорректировкаЭСПВВалютеУчета = (СуммыВВалюте.КорректировкаЭСПВВалютеУчета - СтрокаПартий.КорректировкаЭСПВВалютеУчета);
	НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = (СуммыВВалюте.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета - СтрокаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
	НовоеДвижение.КурсовыеРазницыСНачалаГода = НовоеДвижение.СтоимостьВВалютеУчета + НовоеДвижение.СтоимостьКупонаВВалютеУчета + НовоеДвижение.ПереоценкаВВалютеУчета + 
		НовоеДвижение.ПереоценкаКупонаВВалютеУчета + НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета + НовоеДвижение.КорректировкаЭСПВВалютеУчета + 
		НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета + НовоеДвижение.КурсовыеРазницыСНачалаГода;
		
		
	ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
		+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
		+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,"
		+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
		НовоеДвижение.ЦеннаяБумага, НовоеДвижение.УчетныйАктивЕПС,
		НовоеДвижение.СтоимостьВВалютеУчета, НовоеДвижение.СтоимостьКупонаВВалютеУчета, НовоеДвижение.ПереоценкаВВалютеУчета, НовоеДвижение.ПереоценкаКупонаВВалютеУчета,
		НовоеДвижение.ДисконтПремияНачисленныйВВалютеУчета, НовоеДвижение.КорректировкаЭСПВВалютеУчета, НовоеДвижение.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		СтрокаПартий.ДисконтПремияНачисленный,СтрокаПартий.Переоценка,СтрокаПартий.КорректировкаЭСП,СтрокаПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
	
		
	БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);		
	
	Возврат НовоеДвижение;
	
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

