		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыУсловийДляПериодов КАК _ДатыУсловийДляПериодов
		|		ПО _СписокПериодов.Основание = _ДатыУсловийДляПериодов.Основание
		|			И _СписокПериодов.Период = _ДатыУсловийДляПериодов.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияСделок КАК _УсловияСделок
		|		ПО (_ДатыУсловийДляПериодов.Основание = _УсловияСделок.Основание)
		|			И (_ДатыУсловийДляПериодов.ПериодУсловий = _УсловияСделок.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыСледующихПериодов КАК _ДатыСледующихПериодов
		|		ПО _СписокПериодов.Основание = _ДатыСледующихПериодов.Основание
		|			И _СписокПериодов.Период = _ДатыСледующихПериодов.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основание,
		|	ПериодС";
	
	#КонецОбласти
	
	//В запросе считаем что при равномерном распределении по дням исполнение первой части всегда идет одним днем. Ибо сам метод странный. 
	//Если возникают денежные потоки, то нужно выяснять у заказчика как такое считать.
	
	ВидУчета 		= БухгалтерскийУчетПовтИсп.ОпределитьВидУчетаПоЦелиРасчета(ЦельРасчета);
	СписокСтратегий = Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("Организация",								Организация);
	Запрос.УстановитьПараметр("ВидУчета", 									ВидУчета);
	Запрос.УстановитьПараметр("ДатаПереоценки", 							Дата);
	Запрос.УстановитьПараметр("ВечерДатыПереоценки", 						ВечерДатыПереоценки);
	Запрос.УстановитьПараметр("ВечерВчерашнегоДня", 						НачалоДня(ДатаПереоценки)-1);//Проценты начисляются со дня след. за днем исполнения первой части	
	Запрос.УстановитьПараметр("СписокСтратегий", 							СписокСтратегий);
	Запрос.УстановитьПараметр("ПоВсемСчетамДУ", 							СписокСтратегий.Количество() = 0);
	Запрос.УстановитьПараметр("ПоРавномерномуРаспределениюПоДням", 			Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРавномерномуРаспределениюПоДням);
	Запрос.УстановитьПараметр("СделкаРЕПО", 								СделкаРЕПО);
	Запрос.УстановитьПараметр("ВариантРасчетаПроцентовПоСделкамРЕПО",		ВариантРасчетаПроцентовПоСделкамРЕПО);
	
	Если ЗначениеЗаполнено(ВидУчета) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета));
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	СуммыЗаймовПоПериодам = Результат.Выгрузить();
	
	СуммыЗаймовПоПериодам.Колонки.Добавить("СуммаПроцентов", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(19,4)));
	
	НакопленныеПроцентыДляРавномерногоРаспределения = Новый ТаблицаЗначений;
	НакопленныеПроцентыДляРавномерногоРаспределения.Колонки.Добавить("СделкаРЕПО");
	НакопленныеПроцентыДляРавномерногоРаспределения.Колонки.Добавить("СуммаПроцентовПрошлыхПериодов");
	
	ТекСделка = Неопределено;
	
	Для Каждого СтрокаСуммЗаймовПоПериодам ИЗ СуммыЗаймовПоПериодам Цикл
		
		Если СтрокаСуммЗаймовПоПериодам.ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО Тогда
		
			СтрокаСуммЗаймовПоПериодам.СуммаПроцентов = РаботаСоСделкамиРЕПО.РассчитатьСправедливуюСтоимостьЗадолженностиПоСделкеРЕПО(
				СтрокаСуммЗаймовПоПериодам.СуммаПериода,
				СтрокаСуммЗаймовПоПериодам.СтавкаРЕПО,
				СтрокаСуммЗаймовПоПериодам.ПериодС,
				СтрокаСуммЗаймовПоПериодам.ПериодПо,
				СтрокаСуммЗаймовПоПериодам.БазаРасчетаПроцентов) - СтрокаСуммЗаймовПоПериодам.СуммаПериода;
				
		ИначеЕсли СтрокаСуммЗаймовПоПериодам.ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРавномерномуРаспределениюПоДням Тогда
			
			СуммаПроцентовПрошлыхПериодов = 0;				
			СтрокаПроцентов = Неопределено;
			Если СтрокаСуммЗаймовПоПериодам.ПериодС > СтрокаСуммЗаймовПоПериодам.ДатаРЕПО Тогда
				СтрокаПроцентов = НакопленныеПроцентыДляРавномерногоРаспределения.Найти(СтрокаСуммЗаймовПоПериодам.Основание, "СделкаРЕПО");
				Если СтрокаПроцентов <> Неопределено Тогда
					СуммаПроцентовПрошлыхПериодов = СтрокаПроцентов.СуммаПроцентовПрошлыхПериодов;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаСуммЗаймовПоПериодам.СуммаПроцентов = РаботаСоСделкамиРЕПО.РассчитатьЗадолженностьПоСделкеРЕПОПоРавномерномуРаспределениюПоДням(
				СтрокаСуммЗаймовПоПериодам.СуммаПериода + СуммаПроцентовПрошлыхПериодов,
				СтрокаСуммЗаймовПоПериодам.СуммаЗакрытияРЕПО,
				СтрокаСуммЗаймовПоПериодам.ПериодС,
				СтрокаСуммЗаймовПоПериодам.ДатаЗакрытияРЕПО,
				МИН(НачалоДня(ДатаПереоценки), СтрокаСуммЗаймовПоПериодам.ДатаЗакрытияРЕПО)) - (СтрокаСуммЗаймовПоПериодам.СуммаПериода + СуммаПроцентовПрошлыхПериодов);
				
			//накапливаем проценты
			Если НачалоДня(ДатаПереоценки) > СтрокаСуммЗаймовПоПериодам.ДатаЗакрытияРЕПО Тогда
				
				Если СтрокаПроцентов = Неопределено Тогда
					СтрокаПроцентов = НакопленныеПроцентыДляРавномерногоРаспределения.Добавить();
					СтрокаПроцентов.СделкаРЕПО = СтрокаСуммЗаймовПоПериодам.Основание;
					СтрокаПроцентов.СуммаПроцентовПрошлыхПериодов = СтрокаСуммЗаймовПоПериодам.СуммаПроцентов;
				Иначе
					СтрокаПроцентов.СуммаПроцентовПрошлыхПериодов = СтрокаПроцентов.СуммаПроцентовПрошлыхПериодов + СтрокаСуммЗаймовПоПериодам.СуммаПроцентов;
				КонецЕсли;
				
			КонецЕсли;
							
		ИначеЕсли СтрокаСуммЗаймовПоПериодам.ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРасчетнойСтавке Тогда
			
			Если СтрокаСуммЗаймовПоПериодам.СуммаПериода = 0 Тогда // т.е. РЕПО открылось в день переоценки и ничего начислять не надо - за 1ый день РЕПО % не начисляются
				
				СтрокаСуммЗаймовПоПериодам.СуммаПроцентов = 0;
				
				Продолжить;	// сделал так, потому, что в функция РассчитатьСтавкуРЕПО не учитывает ситуацию СтрокаСуммЗаймовПоПериодам.СуммаПериода = 0 и дохнет
			
			КонецЕсли;
						
			Если СтрокаСуммЗаймовПоПериодам.ДатаРЕПО = СтрокаСуммЗаймовПоПериодам.ПериодС Тогда
				//первый период по этой сделке
				РанееРассчитанныйПроцент = 0;
				ТекСделка = СтрокаСуммЗаймовПоПериодам.Основание; 
			КонецЕсли;
				
			РасчетнаяСтавка = РаботаСоСделкамиРЕПО.РассчитатьСтавкуРЕПО(
				СтрокаСуммЗаймовПоПериодам.СуммаПериода,
				СтрокаСуммЗаймовПоПериодам.СуммаЗакрытияРЕПО - РанееРассчитанныйПроцент,
				СтрокаСуммЗаймовПоПериодам.ПериодС,//ДатаРЕПО,
				СтрокаСуммЗаймовПоПериодам.ДатаЗакрытияРЕПО,
				ТочностьРасчетнойСтавкиРЕПО);
				
			СтрокаСуммЗаймовПоПериодам.СуммаПроцентов = РаботаСоСделкамиРЕПО.РассчитатьСправедливуюСтоимостьЗадолженностиПоСделкеРЕПО(
				СтрокаСуммЗаймовПоПериодам.СуммаПериода,
				РасчетнаяСтавка,
				СтрокаСуммЗаймовПоПериодам.ПериодС,
				СтрокаСуммЗаймовПоПериодам.ПериодПо,
				СтрокаСуммЗаймовПоПериодам.БазаРасчетаПроцентов) - СтрокаСуммЗаймовПоПериодам.СуммаПериода;
				
			Если ТекСделка = СтрокаСуммЗаймовПоПериодам.Основание Тогда
				РанееРассчитанныйПроцент = РанееРассчитанныйПроцент + СтрокаСуммЗаймовПоПериодам.СуммаПроцентов;
			Иначе
				//сортировка должна быть по полям Основание и ПериодС
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Возникла проблема с сортировкой данных расчета РЕПО, обратитесь к программистам",,,,Отказ);
				РанееРассчитанныйПроцент = 0;
				ТекСделка = Неопределено;
			КонецЕсли;
				
		Иначе	
			
			Справочники.ВариантыРасчетаОценочнойСтоимости.СообщитьОНеизвестномВариантеРасчетаПроцентовПоСделкамРЕПО(СтрокаСуммЗаймовПоПериодам.СчетДоверительногоУправления, СтрокаСуммЗаймовПоПериодам.ВариантРасчетаПроцентовПоСделкамРЕПО, Отказ);
		    Прервать;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СуммыЗаймовПоПериодам;
	
КонецФункции

Функция ЕстьСделкиРЕПО(День, Организация, СчетДоверительногоУправления) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПО.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|ГДЕ
		|	(УсловияСделокРЕПО.ДатаИсполнения МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|			ИЛИ УсловияСделокРЕПО.ДатаОплаты МЕЖДУ &НачалоПериода И &ОкончаниеПериода)
		|	И УсловияСделокРЕПО.Организация = &Организация
		|	И УсловияСделокРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(День));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(День));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, ВидАктива, ВидУчета, ТолькоПервоначальноеПризнание = Неопределено) Экспорт
	
	НастройкиАктиваПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, Организация, СчетДоверительногоУправления, ВидАктива, ВидУчета);
	
	ЕстьПоручениеНаПереоценку = Ложь;
	Если ВидАктива = Справочники.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс Тогда
		ЕстьПоручениеНаПереоценку = РаботаСПереоценкой.ОпределитьНаличиеПорученияНаПереоценку(Организация, СчетДоверительногоУправления, НачалоДня(Дата), ВидУчета, Перечисления.ВидыАктивовДляПорученийНаПереоценку.Задолженность);
	КонецЕсли;
	
	Переоценивать = Ложь;
	ТолькоПервоначальноеПризнание = Ложь;
	ПереоцениватьВДеньОперации = Ложь;
	
	Если ЗначениеЗаполнено(НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки) Тогда
		Если НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать
			ИЛИ ЕстьПоручениеНаПереоценку Тогда
			
			КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Дата);
			
			ДатаДокумента = НачалоДня(Дата);
			
			ЭтоКонецМесяца					= НачалоДня(КонецМесяца(ДатаДокумента)) = ДатаДокумента;
			ЭтоПоследнийРабочийДеньМесяца	= НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьДляСчетаДУ, НачалоДня(КонецМесяца(ДатаДокумента)))) = ДатаДокумента;
			ЭтоРабочийДень					= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДатаДокумента) = ДатаДокумента;
			
			ПереоцениватьВДеньОперации = НастройкиАктиваПоВидуУчета.ПереоцениватьВДеньОперации; 

			Если НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
				Если ЭтоРабочийДень ИЛИ ЭтоПоследнийРабочийДеньМесяца ИЛИ ЕстьПоручениеНаПереоценку ИЛИ ДатаДокумента < '20240601' Тогда // до 1.6.14 не учитывали настройку ПереоцениватьВНерабочиеДни
					Возврат Истина;
				Иначе
					Возврат НастройкиАктиваПоВидуУчета.ПереоцениватьВНерабочиеДни ИЛИ ЭтоКонецМесяца;
				КонецЕсли;
			ИначеЕсли БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки, ДатаДокумента, КалендарьДляСчетаДУ)
				ИЛИ ЕстьПоручениеНаПереоценку Тогда
			
				Переоценивать =  Истина;
			КонецЕсли;
			
		КонецЕсли;
			
		Если НЕ Переоценивать И ПереоцениватьВДеньОперации 
			И (ВидАктива = Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО ИЛИ ВидАктива = Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО) Тогда
			Переоценивать = ЕстьСделкиРЕПО(Дата, Организация, СчетДоверительногоУправления);
			ТолькоПервоначальноеПризнание = Переоценивать;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Переоценивать;
	
КонецФункции

Функция НужнаПереоценкаЗадолженностей(Дата, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт
	
	ПериодичностьПереоценкиЗадолженностей = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(Дата, Организация, СчетДоверительногоУправления, ВидУчета, "ПериодичностьПереоценкиЗадолженностей");
	
	Переоценивать = Ложь;
	
	Если ЗначениеЗаполнено(ПериодичностьПереоценкиЗадолженностей) Тогда
		Если ПериодичностьПереоценкиЗадолженностей <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать Тогда
			
			КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Дата);
			
			ДатаДокумента = НачалоДня(Дата);
			
			Если БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиЗадолженностей, ДатаДокумента, КалендарьДляСчетаДУ)
				Тогда
				Переоценивать =  Истина;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Переоценивать;
	
КонецФункции

Функция Нужно_ПризнатьРасходыПоБиржевымДепозитам(Дата, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт
	
	МетодПризнанияРасходовПоБиржевымДепозитам = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		ВидУчета,
		"МетодПризнанияРасходовПоБиржевымДепозитам");	
		
		Возврат МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
		ИЛИ МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении
		
КонецФункции

Функция Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО(Дата, Организация, СчетДоверительногоУправления) Экспорт
		
	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Дата);
		
	РабочийДень = Справочники.Календари.ЭтоРабочийДень(КалендарьДляСчетаДУ, Дата);
	
	ПериодичностиДаты = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(Дата);
														
	НастройкиПроцентыПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
									Дата,
									Организация,
									СчетДоверительногоУправления,
									Справочники.УчетныеАктивыЕПС.ПроцентыПоРЕПО,
									Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	ПериодичностьПереоценки = НастройкиПроцентыПоРЕПО.ПериодичностьПереоценки;
	ПереоцениватьВНерабочиеДни = НастройкиПроцентыПоРЕПО.ПереоцениватьВНерабочиеДни; 
	ПереоцениватьВДеньОперации = НастройкиПроцентыПоРЕПО.ПереоцениватьВДеньОперации; 
	
	// такое бывает когда настройки не заданы и это нормальная ситуация (уточнил у бухгалтерии)
	// инвестдекларация не предполагает заключение сделок РЕПО и из учет не описан ни в правилах СЧА, ни в учетной политике для ЕПС
	Если ПериодичностьПереоценки = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Переоценивать = Ложь;
	Если ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		Переоценивать = Истина;
		Если НЕ ПереоцениватьВНерабочиеДни И НЕ РабочийДень И НЕ ПериодичностиДаты.ПериодичностьМесяц Тогда // последний день месяца - отчетная дата, палюбому
			Переоценивать = Ложь;
		КонецЕсли;
	ИначеЕсли БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, Дата, КалендарьДляСчетаДУ) Тогда 
		Переоценивать = Истина;
	КонецЕсли;
	
	Если НЕ Переоценивать И ПереоцениватьВДеньОперации Тогда
		Переоценивать = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.ЕстьСделкиРЕПО(Дата, Организация, СчетДоверительногоУправления);
	КонецЕсли;
	
	Возврат Переоценивать;

КонецФункции

Функция Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО(Дата, Организация, СчетДоверительногоУправления) Экспорт
	
	Отказ = Ложь;
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате
		ИЛИ НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	КалендарьДляСчетаДУ = РаботаСПереоценкой.ПолучитьКалендарьДляСчетаДУ(Организация, СчетДоверительногоУправления, Дата);
	// воткнул т.к. задача ставилась НЕПРАВИЛЬНО и теперь затыкаю дыру
	РабочийДень = Справочники.Календари.ЭтоРабочийДень(КалендарьДляСчетаДУ, Дата);
	
	ПериодичностиДаты = БухгалтерскийУчетЕПС.ПолучитьПериодичностиДаты(Дата);
														
	НастройкиКомиссияПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
									Дата,
									Организация,
									СчетДоверительногоУправления,
									Справочники.УчетныеАктивыЕПС.КомиссияПоРЕПО,
									Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
														
	ПериодичностьПереоценки = 		НастройкиКомиссияПоРЕПО.ПериодичностьПереоценки;
	ПереоцениватьВНерабочиеДни = 	НастройкиКомиссияПоРЕПО.ПереоцениватьВНерабочиеДни;
	ПереоцениватьВДеньОперации = 	НастройкиКомиссияПоРЕПО.ПереоцениватьВДеньОперации;
	
	// такое бывает когда настройки не заданы и это нормальная ситуация (уточнил у бухгалтерии)
	// инвестдекларация не предполагает заключение сделок РЕПО и из учет не описан ни в правилах СЧА, ни в учетной политике для ЕПС
	Если ПериодичностьПереоценки = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Переоценивать = Ложь;
	Если ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		Переоценивать = Истина;
		Если НЕ ПереоцениватьВНерабочиеДни И НЕ РабочийДень И НЕ ПериодичностиДаты.ПериодичностьМесяц Тогда // последний день месяца - отчетная дата, палюбому
			Переоценивать = Ложь;
		КонецЕсли;
	ИначеЕсли БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, Дата, КалендарьДляСчетаДУ) Тогда 	
		Переоценивать = Истина;
	КонецЕсли;
	
	Если НЕ Переоценивать И ПереоцениватьВДеньОперации Тогда
		Переоценивать = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.ЕстьСделкиРЕПО(Дата, Организация, СчетДоверительногоУправления);
	КонецЕсли;
	
	Возврат Переоценивать;
	
КонецФункции

Функция Нужно_ЕПС_ПризнатьРасходыПоБиржевымДепозитам(Дата, Организация, СчетДоверительногоУправления) Экспорт
	
	МетодПризнанияРасходовПоБиржевымДепозитам = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		"МетодПризнанияРасходовПоБиржевымДепозитам");	
		
		Возврат МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
		ИЛИ МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении
		
КонецФункции	
