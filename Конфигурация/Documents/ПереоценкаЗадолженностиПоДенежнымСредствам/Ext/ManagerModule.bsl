Функция РассчитатьПроцентыПоРЕПО(Организация, СчетДоверительногоУправления, Знач Дата, ЦельРасчета, СделкаРЕПО = Неопределено, Отказ = Ложь, ТочностьРасчетнойСтавкиРЕПО = 8, ВариантРасчетаПроцентовПоСделкамРЕПО = Неопределено) Экспорт
	
	Если ТипЗнч(Дата) = Тип("Граница") Тогда
		Если ТипЗнч(Дата.Значение) = Тип("МоментВремени") Тогда
			ДатаПереоценки = Дата.Значение.Дата;
		ИначеЕсли ТипЗнч(Дата.Значение) = Тип("Дата") Тогда
			ДатаПереоценки = Дата.Значение;
	    Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При расчете процентов по РЕПО значение границы типа " + ТипЗнч(Дата.Значение) + " не обрабатывается",,,,Отказ);
			Возврат Неопределено;
		КонецЕсли;
		Если Дата.ВидГраницы = ВидГраницы.Исключая Тогда
			ВечерДатыПереоценки = ДатаПереоценки - 1;
		Иначе
			ВечерДатыПереоценки = ДатаПереоценки;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Дата) = Тип("Дата") Тогда
		ДатаПереоценки = КонецДня(Дата);
		ВечерДатыПереоценки = ДатаПереоценки;
		Дата = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неизвестный параметр периода для расчета процентов сделок РЕПО",,,,Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ДатаПереоценки,
		Организация,
		СчетДоверительногоУправления);
		
	#Область Текст_запроса
	
	// ПРОЦЕНТЫ ПО РЕПО
	//ВНЕБИРЖА, т.е. ЧастьСделкиРЕПО = 0
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.Основание КАК Основание,
		|	ВложенныйЗапрос.Валюта КАК Валюта,
		|	ВложенныйЗапрос.СуммаДолгаПоВторойЧасти КАК СуммаДолгаПоВторойЧасти,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ВложенныйЗапрос.Брокер КАК Брокер,
		|	ВложенныйЗапрос.ОснованиеБазаРасчетаПроцентов КАК ОснованиеБазаРасчетаПроцентов,
		|	ВложенныйЗапрос.ВидСделки КАК ВидСделки,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА &ВариантРасчетаПроцентовПоСделкамРЕПО <> НЕОПРЕДЕЛЕНО
		|			ТОГДА &ВариантРасчетаПроцентовПоСделкамРЕПО
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка)
		|			ТОГДА ЕСТЬNULL(НастройкиФормированияСЧАСрезПоследних.ВариантРасчетаПроцентовПоСделкамРЕПО, ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПустаяСсылка))
		|		КОГДА ЕСТЬNULL(НастройкиПоВидуУчетаСрезПоследних.ВариантРасчетаПроцентовПоСделкамРЕПО, ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО)) = ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО)
		|		ИНАЧЕ ЕСТЬNULL(НастройкиПоВидуУчетаСрезПоследних.ВариантРасчетаПроцентовПоСделкамРЕПО, ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО))
		|	КОНЕЦ КАК ВариантРасчетаПроцентовПоСделкамРЕПО
		|ПОМЕСТИТЬ _ОткрытыеСделкиРЕПОБезНастроек
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|		ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаДолгаПоВторойЧасти,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Основание.Контрагент КАК Контрагент,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Основание.Брокер КАК Брокер,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Основание.БазаРасчетаПроцентов КАК ОснованиеБазаРасчетаПроцентов,
		|		ЗадолженностиПоДенежнымСредствамОстатки.Основание.ВидСделки КАК ВидСделки,
		|		ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И (СчетДоверительногоУправления В (&СписокСтратегий)
		|						ИЛИ &ПоВсемСчетамДУ)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|					И (&СделкаРЕПО = НЕОПРЕДЕЛЕНО
		|						ИЛИ Основание = &СделкаРЕПО)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|	ГДЕ
		|		ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.СделкаРЕПО).ЧастьСделкиРЕПО = 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.Валюта,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаОстаток + ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаКупонаОстаток,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.БазаРасчетаПроцентов,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.ВидСделки,
		|		ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И (СчетДоверительногоУправления В (&СписокСтратегий)
		|						ИЛИ &ПоВсемСчетамДУ)
		|					И (&СделкаРЕПО = НЕОПРЕДЕЛЕНО
		|						ИЛИ СделкаРЕПО = &СделкаРЕПО)) КАК ЗадолженностиПоВторойЧастиРЕПООстатки) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|				&ДатаПереоценки,
		|				ВидУчета = &ВидУчета
		|					И Организация = &Организация
		|					И (СчетДоверительногоУправления В (&СписокСтратегий)
		|						ИЛИ &ПоВсемСчетамДУ)) КАК НастройкиПоВидуУчетаСрезПоследних
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = НастройкиПоВидуУчетаСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И (СчетДоверительногоУправления В (&СписокСтратегий)
		|						ИЛИ &ПоВсемСчетамДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И (СчетДоверительногоУправления В (&СписокСтратегий)
		|						ИЛИ &ПоВсемСчетамДУ)) КАК НастройкиФормированияСЧАСрезПоследних
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = НастройкиФормированияСЧАСрезПоследних.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОткрытыеСделкиРЕПОБезНастроек.Основание КАК Основание,
		|	_ОткрытыеСделкиРЕПОБезНастроек.Валюта КАК Валюта,
		|	_ОткрытыеСделкиРЕПОБезНастроек.СуммаДолгаПоВторойЧасти КАК СуммаДолгаПоВторойЧасти,
		|	_ОткрытыеСделкиРЕПОБезНастроек.Контрагент КАК Контрагент,
		|	_ОткрытыеСделкиРЕПОБезНастроек.Брокер КАК Брокер,
		|	_ОткрытыеСделкиРЕПОБезНастроек.ОснованиеБазаРасчетаПроцентов КАК ОснованиеБазаРасчетаПроцентов,
		|	_ОткрытыеСделкиРЕПОБезНастроек.ВидСделки КАК ВидСделки,
		|	_ОткрытыеСделкиРЕПОБезНастроек.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОткрытыеСделкиРЕПОБезНастроек.ВариантРасчетаПроцентовПоСделкамРЕПО КАК ВариантРасчетаПроцентовПоСделкамРЕПО
		|ПОМЕСТИТЬ _ОткрытыеСделкиРЕПО
		|ИЗ
		|	_ОткрытыеСделкиРЕПОБезНастроек КАК _ОткрытыеСделкиРЕПОБезНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО _ОткрытыеСделкиРЕПОБезНастроек.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	(ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ИСТИНА)
		|			ИЛИ &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта КАК ВалютаСделки,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Период <= &ВечерВчерашнегоДня
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход + ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход + ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход КАК СуммаЗайма
		|ПОМЕСТИТЬ _ДенежныйПоток
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			&ВечерДатыПереоценки,
		|			День,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления В (&СписокСтратегий)
		|					ИЛИ &ПоВсемСчетамДУ)
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ОткрытыеСделкиРЕПО.Основание КАК Основание
		|					ИЗ
		|						_ОткрытыеСделкиРЕПО КАК _ОткрытыеСделкиРЕПО)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Период <= &ВечерВчерашнегоДня
		|			ТОГДА -ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход - ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	-ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход - ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			&ВечерДатыПереоценки,
		|			День,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления В (&СписокСтратегий)
		|					ИЛИ &ПоВсемСчетамДУ)
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ОткрытыеСделкиРЕПО.Основание КАК Основание
		|					ИЗ
		|						_ОткрытыеСделкиРЕПО КАК _ОткрытыеСделкиРЕПО)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОткрытыеСделкиРЕПО КАК _ОткрытыеСделкиРЕПО
		|		ПО ЗадолженностиПоДенежнымСредствамОбороты.Основание = _ОткрытыеСделкиРЕПО.Основание
		|ГДЕ
		|	_ОткрытыеСделкиРЕПО.ВариантРасчетаПроцентовПоСделкамРЕПО <> &ПоРавномерномуРаспределениюПоДням
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Период <= &ВечерВчерашнегоДня
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаПриход
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаПриход
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			&ВечерДатыПереоценки,
		|			Регистратор,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления В (&СписокСтратегий)
		|					ИЛИ &ПоВсемСчетамДУ)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ОткрытыеСделкиРЕПО.Основание КАК Основание
		|					ИЗ
		|						_ОткрытыеСделкиРЕПО КАК _ОткрытыеСделкиРЕПО)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОткрытыеСделкиРЕПО КАК _ОткрытыеСделкиРЕПО
		|		ПО ЗадолженностиПоДенежнымСредствамОбороты.Основание = _ОткрытыеСделкиРЕПО.Основание
		|ГДЕ
		|	_ОткрытыеСделкиРЕПО.ВариантРасчетаПроцентовПоСделкамРЕПО <> &ПоРавномерномуРаспределениюПоДням
		|	И ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаПриход < 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиДенежныхСредств.Регистратор,
		|	ОстаткиДенежныхСредств.Валюта,
		|	ОстаткиДенежныхСредств.Период,
		|	ВЫБОР
