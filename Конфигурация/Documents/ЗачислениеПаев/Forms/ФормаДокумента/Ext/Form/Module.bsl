
#Область События_формы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтотОбъект);
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ЗаявкаПриИзменении(Элемент)
		
	Если Не ЗначениеЗаполнено(Объект.ПоступлениеДенежныхСредств) Тогда
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Заявка, "ВидЗаявки") = ПредопределенноеЗначение("Перечисление.ВидыЗаявокПайщиков.Обмен") Тогда
			//Ищем погашение по заявке и подставляем его сумму
			Объект.Сумма = СуммаПогашенияПоОбменуПаев(Объект.Организация, Объект.Заявка);
		Иначе
			Объект.Сумма = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Заявка, "Сумма");
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьСтоимостьПаяИПараметрыНадбавкиНаСервере();
	РассчитатьКоличествоПаевИСуммуНадбавки(Неопределено);
	
	ОбновитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	ОбновитьСтоимостьПаяИПараметрыНадбавкиНаСервере();
	РассчитатьКоличествоПаевИСуммуНадбавки(Неопределено);
	
	ОбновитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПаевойИнвестиционныйФондПриИзменении(Элемент)
	
	Объект.СчетДоверительногоУправления = ПолучитьСчетДоверительногоУправления(Объект.ПаевойИнвестиционныйФонд, Объект.Дата);
	Объект.ПоступлениеДенежныхСредств   = Неопределено;
    
	ОбновитьСтоимостьПаяИПараметрыНадбавкиНаСервере();
	РассчитатьКоличествоПаевИСуммуНадбавки(Неопределено);

	ОбновитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьКоличествоПаевИСуммуНадбавки(Команда)
			
	Если ЭтаФорма.РасчетнаяСтоимостьПая <> 0 Тогда
		
		НадбавкаИКоличество = РаботаСДокументамиКлиентСервер.РассчитатьКоличествоПаевИСуммуНадбавки(
						Объект.Сумма,
						ЭтаФорма.РасчетнаяСтоимостьПая,
						Новый Структура("ПрименяютсяНадбавкиИСкидки, СтавкаНадбавки", ЭтаФорма.ПрименяетсяНадбавка, ЭтаФорма.СтавкаНадбавки));
				
		Объект.Количество		= НадбавкаИКоличество.Количество;
		Объект.СуммаНадбавки	= НадбавкаИКоличество.СуммаНадбавки;
					
	Иначе
		
		Объект.Количество 		= 0;
		Объект.СуммаНадбавки	= 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеДенежныхСредствПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ПоступлениеДенежныхСредств) Тогда
		Объект.Сумма = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПоступлениеДенежныхСредств, "Сумма");
	КонецЕсли;
	
	СуммаПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	РассчитатьКоличествоПаевИСуммуНадбавки(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Ссылка",
		Справочники.УправляющиеКомпании.ПолучитьПИФыПоЮрФизЛицуУправляющейКомпании(Объект.Дата, Объект.Организация.ЮрФизЛицо)));
		
	Элементы.ПаевойИнвестиционныйФонд.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
		
	ОбновитьСтоимостьПаяИПараметрыНадбавкиНаСервере();
	
	ОбновитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтоимостьПаяИПараметрыНадбавкиНаСервере()
	
	ДатаДокумента = ?(Объект.Дата = '00010101', ТекущаяДатаСеанса(), Объект.Дата);
		
	ДатаСтоимости = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(
						Объект.СчетДоверительногоУправления,						
						ДатаДокумента);
	СтоимостьПаяИзРегистра = РегистрыСведений.ФинансовыеПоказатели.РасчетнаяСтоимостьПаяНаДату(
								Объект.Организация, 
								Объект.СчетДоверительногоУправления, 
								ДатаСтоимости);
		
	ЭтаФорма.РасчетнаяСтоимостьПая 		= 0;
	ЭтаФорма.СтавкаНадбавки 			= 0;
	ЭтаФорма.ПрименяетсяНадбавка		= Ложь;
	ЭтаФорма.ДатаРасчетнойСтоимостиПая	= Неопределено;
		
	Если СтоимостьПаяИзРегистра <> Неопределено Тогда				
		ЭтаФорма.РасчетнаяСтоимостьПая		= СтоимостьПаяИзРегистра;	
		ЭтаФорма.ДатаРасчетнойСтоимостиПая	= ДатаСтоимости;		
	Иначе
		
		Если Объект.Количество <> 0 Тогда
			ЭтаФорма.РасчетнаяСтоимостьПая = Объект.Сумма / Объект.Количество;
		КонецЕсли;
				
	КонецЕсли;
	
	ПараметрыНадбавки = РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.ПараметрыРасчетаНадбавокИСкидок(Объект.ПаевойИнвестиционныйФонд, ДатаДокумента);
	
	ЭтоЗачислениеПоОбменуПаев = ЗначениеЗаполнено(Объект.Заявка) 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Заявка, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен;
		
	Если ПараметрыНадбавки <> Неопределено Тогда			
		ЭтаФорма.ПрименяетсяНадбавка	= ?(ЭтоЗачислениеПоОбменуПаев, Ложь, ПараметрыНадбавки.ПрименяютсяНадбавкиИСкидки);
		ЭтаФорма.СтавкаНадбавки			= ?(ЭтаФорма.ПрименяетсяНадбавка, ПараметрыНадбавки.СтавкаНадбавки, 0);
	КонецЕсли;
			
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьИДоступность(Форма)
	
	Объект		= Форма.Объект;
	Элементы	= Форма.Элементы;
	
	ПрименяетсяНадбавка = Форма.ПрименяетсяНадбавка И Форма.СтавкаНадбавки <> 0;
	
	Элементы.ГруппаНадбавка.Видимость				= ПрименяетсяНадбавка;	
	Элементы.ДатаРасчетнойСтоимостиПая.Видимость	= ЗначениеЗаполнено(Форма.ДатаРасчетнойСтоимостиПая);
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
						
		ПутьКДаннымСкрываемыхПолей.Вставить("ГруппаНадбавка", "Объект.СуммаНадбавки");
				
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетДоверительногоУправления(Знач ПаевойИнвестиционныйФонд, Знач Период)
	
	Возврат Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ПаевойИнвестиционныйФонд, Период);	
	
КонецФункции

&НаСервереБезКонтекста
Функция СуммаПогашенияПоОбменуПаев(Организация, ЗаявкаПайщика)
	
	ДатаЗаявки = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаПайщика, "Дата"));
	
	// Погашение паев по обмену у другого счета ДУ
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход КАК СуммаПогашения
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&Дата,
		|			,
		|			,
		|			Организация = &Организация
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
		|				И Основание = &ЗаявкаПайщика) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход > 0");
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ЗаявкаПайщика",	ЗаявкаПайщика);
	Запрос.УстановитьПараметр("Дата",			ДатаЗаявки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаПогашения;
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не найдено погашение паев по заявке на обмен паев %1", ЗаявкаПайщика), ЗаявкаПайщика);
		Возврат 0;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

#КонецОбласти
