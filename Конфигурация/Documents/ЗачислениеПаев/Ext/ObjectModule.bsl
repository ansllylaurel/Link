
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
	
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Сумма - СуммаНадбавки, "Зачисление паев");
	
	Проводка.СчетДт = Планысчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
	Проводка.СубконтоДт.Контрагенты = РаботаСДокументами.ПолучитьКонтрагентаПоВидуПайщика(Заявка.ВидПайщика, Заявка.Владелец, Пайщик, Дата);	
	
	Проводка.СчетКт = Планысчетов.Основной.ЦелевоеФинансированиеИзБюджета;
	Проводка.СубконтоКт.Контрагенты = Пайщик;
	
	Проводка.КоличествоКт = Количество;
	
	Если ЭтотОбъект.СуммаНадбавки > 0 Тогда
		
		РеквизитыПИФ = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(ЭтотОбъект.ПаевойИнвестиционныйФонд, ЭтотОбъект.Дата);
		УправляющаяКомпания = РеквизитыПИФ.УправляющаяКомпания;
		УправляющаяКомпанияЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаНадбавки, "Надбавка при покупке паев");
		
		Проводка.СчетДт = Планысчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
		Проводка.СубконтоДт.Контрагенты = РаботаСДокументами.ПолучитьКонтрагентаПоВидуПайщика(Заявка.ВидПайщика, Заявка.Владелец, Пайщик, Дата);	
		
		Проводка.СчетКт = Планысчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
		Проводка.СубконтоКт.Контрагенты = УправляющаяКомпанияЮрФизЛицо;

		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаНадбавки, "Перечислена надбавка в УК");
		
		Проводка.СчетДт = Планысчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
		Проводка.СубконтоДт.Контрагенты = УправляющаяКомпанияЮрФизЛицо;

		Проводка.СчетКт = Планысчетов.Основной.РасчетныеСчета;
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.НадбавкаПриПокупкеПаев;
		Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.ПоступлениеДенежныхСредств.РасчетныйСчетПолучатель;
		
	КонецЕсли;
	
	Если НастройкиУчета.ВестиУчетИмуществаПайщиков Тогда
	
		ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Сумма - СуммаНадбавки, "Зачисление паев пайщику");
		
		ПроводкаПайщика.СчетДт = Планысчетов.Основной.ПаиПайщиков;
		ПроводкаПайщика.СубконтоДт.Пайщики = Пайщик;
		ПроводкаПайщика.СубконтоДт.ОснованиеРасчетовПоПайщикам = ЭтотОбъект.Ссылка;
		ПроводкаПайщика.КоличествоДт = Количество;

		ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
		ПроводкаПайщика.СубконтоКт.Пайщики = Пайщик;
		ПроводкаПайщика.СубконтоКт.ЗаявкиПайщиков = ЭтотОбъект.Заявка;
		
		
		ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаНадбавки, "Надбавка при покупке паев");
		
		ПроводкаПайщика.СчетДт = Планысчетов.Основной.НадбавкаПриПокупкеПаев;
		ПроводкаПайщика.СубконтоДт.Пайщики = Пайщик;
		ПроводкаПайщика.СубконтоДт.ОснованиеРасчетовПоПайщикам = ЭтотОбъект.Ссылка;

		ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
		ПроводкаПайщика.СубконтоКт.Пайщики = Пайщик;
		ПроводкаПайщика.СубконтоКт.ЗаявкиПайщиков = ЭтотОбъект.Заявка;
		
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегиструБухгалтерии

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	ДвиженияПоРегиструДолиПайщиков(Отказ);
	ДвиженияПоЗадолженностиПоДенежнымСредствам(Отказ);
	
	Движения.Записать();
	
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствам(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ДвиженияПоРегиструДолиПайщиков(Отказ)
	
	Движения.ДолиПайщиковВИнвестиционномФонде.Записывать = Истина;
	
	Движение = Движения.ДолиПайщиковВИнвестиционномФонде.ДобавитьПриход();
	
	Движение.Период      = Дата;
	Движение.Организация = Организация;
	Движение.Пайщик      = Пайщик;
	Движение.Партия      = Ссылка;
	
	Движение.ПаевойИнвестиционныйФонд = ПаевойИнвестиционныйФонд;
	
	Движение.Количество  = Количество;
	Движение.Стоимость	 = Сумма;
	
КонецПроцедуры

Процедура ДвиженияПоЗадолженностиПоДенежнымСредствам(Отказ)
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ВалютаУчета, ЮрФизЛицо");
	
	ЭтоЗачислениеПаевПоОбмену = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Заявка, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен;

	// При зачислении по обмену ввод денежных средств будет позже, получаем дебиторскую задолженность
	Если ЭтоЗачислениеПаевПоОбмену Тогда		
		Движение 					= Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		Движение.ТипЗадолженности	= Перечисления.ТипыЗадолженности.Дебиторская;
		Движение.Аванс				= Ложь;		
	Иначе		
		Движение					= Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
		Движение.ТипЗадолженности	= Перечисления.ТипыЗадолженности.Кредиторская;
		Движение.Аванс				= Истина;		
	КонецЕсли;
	
	Движение.Период							= Дата;	
	Движение.Основание						= Заявка;	
	Движение.ВидЗадолженности				= Справочники.ВидыЗадолженности.ПередПайщиками;
	Движение.Организация					= Организация;
	Движение.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	Движение.Контрагент						= Пайщик;
	Движение.Валюта							= РеквизитыОрганизации.ВалютаУчета;	
	Движение.Сумма							= Сумма;
	
	Если ЭтотОбъект.СуммаНадбавки > 0 Тогда
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	
		Движение.Период 						= Дата;		
		Движение.Основание 						= Ссылка;
		Движение.ТипЗадолженности 				= Перечисления.ТипыЗадолженности.Кредиторская;
		Движение.ВидЗадолженности 				= Справочники.ВидыЗадолженности.УдержаниеНадбавокПИФ;
		Движение.Организация      				= Организация;
		Движение.СчетДоверительногоУправления 	= СчетДоверительногоУправления;
		Движение.Контрагент 					= РеквизитыОрганизации.ЮрФизЛицо;
		Движение.Валюта 						= РеквизитыОрганизации.ВалютаУчета;				
		Движение.Сумма 							= СуммаНадбавки;
	
	КонецЕсли;	
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);	
	ЭтотОбъект.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ПаевойИнвестиционныйФонд);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПереводДенежныхСредств") 
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		
		ЭтотОбъект.Дата							= НачалоДня(ТекущаяДатаСеанса());
		ЭтотОбъект.Организация					= ДанныеЗаполнения.Организация;
		Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПереводДенежныхСредств") Тогда
			ЭтотОбъект.СчетДоверительногоУправления	= ДанныеЗаполнения.СчетДоверительногоУправления;
			ЭтотОбъект.ПаевойИнвестиционныйФонд 	= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДанныеЗаполнения.Дата);
			ЭтотОбъект.ПоступлениеДенежныхСредств	= ДанныеЗаполнения;
			ЭтотОбъект.Заявка						= ДанныеЗаполнения.Основание;
		Иначе
			ЭтотОбъект.ПаевойИнвестиционныйФонд 	= ?(ДанныеЗаполнения.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен,
												ДанныеЗаполнения.ПаевойИнвестиционныйФондДляОбменаПаев, 
												ДанныеЗаполнения.ПаевойИнвестиционныйФонд);
												
			ЭтотОбъект.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ЭтотОбъект.ПаевойИнвестиционныйФонд);
			ЭтотОбъект.Заявка						= ДанныеЗаполнения.Ссылка;
		КонецЕсли;
		
		РеквизитыЗаявки 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Заявка, "Пайщик, Многократная, ИсточникЗаявки");
		
		ЭтотОбъект.Пайщик							= РеквизитыЗаявки.Пайщик;
		
		Если РеквизитыЗаявки.Многократная 
			И ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПереводДенежныхСредств") Тогда
			ЭтотОбъект.Сумма = ДанныеЗаполнения.Сумма;
		Иначе
			ЭтотОбъект.Сумма = ПолучитьСуммуЗадолженностиПоЗаявке();
		КонецЕсли;
		
		Если ДанныеЗаполнения.РасчетныйСчет.ТранзитныйПИФ
			И ЗначениеЗаполнено(ДанныеЗаполнения.Основание)
			ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			
			Основание = "Уведомление об операции по ЛС";
			
			РасчетнаяСтоимостьПая = РегистрыСведений.ФинансовыеПоказатели.РасчетнаяСтоимостьПаяНаДату(
								Организация,
								СчетДоверительногоУправления,
								Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(
									СчетДоверительногоУправления,						
									Дата));
									
			Если РасчетнаяСтоимостьПая <> Неопределено Тогда
				
				ПараметрыНадбавки	= РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.ПараметрыРасчетаНадбавокИСкидок(ЭтотОбъект.ПаевойИнвестиционныйФонд, ЭтотОбъект.Дата);
				
				НадбавкаИКоличество = РаботаСДокументамиКлиентСервер.РассчитатьКоличествоПаевИСуммуНадбавки(ЭтотОбъект.Сумма, РасчетнаяСтоимостьПая, ПараметрыНадбавки);
				
				// Округления на каждом этапе
				ЭтотОбъект.Количество		= НадбавкаИКоличество.Количество;				
				ЭтотОбъект.СуммаНадбавки	= НадбавкаИКоличество.СуммаНадбавки;
																
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка уникальности перевода
	Если ЗначениеЗаполнено(ПоступлениеДенежныхСредств) Тогда
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("Документ.ЗачислениеПаев");
		ЭлементБлокировки.УстановитьЗначение("ПоступлениеДенежныхСредств", ПоступлениеДенежныхСредств);
		
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗачислениеПаев.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗачислениеПаев КАК ЗачислениеПаев
		|ГДЕ
		|	ЗачислениеПаев.ПоступлениеДенежныхСредств = &ПоступлениеДенежныхСредств
		|	И ЗачислениеПаев.Проведен
		|	И ЗачислениеПаев.Организация = &Организация
		|	И ЗачислениеПаев.Ссылка <> &Ссылка");
		
		Запрос.УстановитьПараметр("ПоступлениеДенежныхСредств", ПоступлениеДенежныхСредств);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		МассивЗачислений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
		Если МассивЗачислений.Количество() Тогда
			СтрокаСообщения = "По документу " + ПоступлениеДенежныхСредств + " уже введено зачисление " + СтрСоединить(МассивЗачислений, ", ");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, Ссылка, "ПоступлениеДенежныхСредств", "Объект", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
				
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
		
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПолучитьСуммуЗадолженностиПоЗаявке()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
		|				И Основание = &ЗаявкаПайщика
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоДенежнымСредствамОстатки";
	
	Запрос.УстановитьПараметр("ЗаявкаПайщика", ЭтотОбъект.Заявка);
	Запрос.УстановитьПараметр("МоментВремени", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.СуммаОстаток;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции