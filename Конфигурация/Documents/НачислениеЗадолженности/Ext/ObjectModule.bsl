
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
			
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВводДенежныхСредств") Тогда
		// реквизиты шапки
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, РасчетныйСчет, Валюта");
		
		ЭтотОбъект.Дата             		= НачалоДня(ДанныеЗаполнения.Дата) + 19*60*60 + 30*60;
		ЭтотОбъект.ВидЗадолженности 		= Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение;
		ЭтотОбъект.МестоХранения    		= Справочники.МестаХранения.ВнебиржевойРынок;
		ЭтотОбъект.Контрагент       		= ЭтотОбъект.Организация.ЮрФизЛицо;
		ЭтотОбъект.Вознаграждение   		= Истина;
		ЭтотОбъект.ДатаПолученияДокумента	= ЭтотОбъект.Дата;
		
		ПроверимУчет = Перечисления.ВидыУчета.БухгалтерскийУчет;
		Если НЕ РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ПроверимУчет) Тогда
			ПроверимУчет = Перечисления.ВидыУчета.НалоговыйУчет;
		КонецЕсли;
		
		АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВидЗадолженности,
			ПроверимУчет,
			"Аналитика");
		
		ЭтотОбъект.ПрочиеДоходыИРасходы		= АналитикаУслуг;
		
		// ввод на основании возможен только если задана ставка 
		СтавкаВознагражденияУправляющегоПлатаЗаРазмещение = Справочники.СтратегииИндивидуальногоИнвестирования.ПолучитьСтавкуВознагражденияУправляющегоПлатуЗаРазмещение(ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления);
		Если СтавкаВознагражденияУправляющегоПлатаЗаРазмещение = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена ставка вознаграждения за размещение по клиенту '" + ЭтотОбъект.СчетДоверительногоУправления + "'. Начисление задолженности не поддерживается");
			Возврат;
		КонецЕсли;
		
		// заполним основание
		НоваяСтрокаОснование = ЭтотОбъект.Основания.Добавить();
		НоваяСтрокаОснование.Основание = ДанныеЗаполнения;
		НоваяСтрокаОснование.Сумма     = ДанныеЗаполнения.Сумма * СтавкаВознагражденияУправляющегоПлатаЗаРазмещение / 100;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасчетНДФЛ") Тогда	
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления");
		
		
		ЭтотОбъект.Дата             		= РаботаСДокументами.ПолучитьВремяДокумента(ДанныеЗаполнения.Дата, ЭтотОбъект.Ссылка);
		ЭтотОбъект.ВидЗадолженности 		= Справочники.ВидыЗадолженности.ПоНДФЛ13;
		ЭтотОбъект.МестоХранения    		= Справочники.МестаХранения.ВнебиржевойРынок;
		ЭтотОбъект.Контрагент       		= РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Ложь);
		ЭтотОбъект.ДатаПолученияДокумента	= ЭтотОбъект.Дата;
		ЭтотОбъект.Валюта 					= ЭтотОбъект.Организация.ВалютаУчета;
		ЭтотОбъект.ПрочиеДоходыИРасходы		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_НалогСДивидендов");

		// заполним основание
		НоваяСтрокаОснование = ЭтотОбъект.Основания.Добавить();
		НоваяСтрокаОснование.Основание = ДанныеЗаполнения;
		НоваяСтрокаОснование.Сумма     = ДанныеЗаполнения.НалоговаяБаза2025.Итог("СуммаНалога") - ДанныеЗаполнения.НалоговаяБаза2025.Итог("СуммаУменьшающаяНалог");
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, РасчетныйСчет, Брокер");
		
		ЭтотОбъект.Дата             		= НачалоДня(ДанныеЗаполнения.Дата) + 19*60*60 + 30*60;
		Если ДанныеЗаполнения.СчетДоверительногоУправления.ВидСчетаДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица 
			ИЛИ ДанныеЗаполнения.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет		Тогда 
			ЭтотОбъект.ВидЗадолженности 		= Справочники.ВидыЗадолженности.ПоНДФЛ13;	
			ЭтотОбъект.Контрагент       		= РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Ложь);		
		Иначе
			ЭтотОбъект.ВидЗадолженности 		= Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль;	
			ЭтотОбъект.Контрагент       		= РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Истина);
		КонецЕсли;	
		
		ЭтотОбъект.ПрочиеДоходыИРасходы		= ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_НалогСДивидендов");
		ЭтотОбъект.МестоХранения    		= Справочники.МестаХранения.ВнебиржевойРынок;	
		ЭтотОбъект.ДатаПолученияДокумента	= ЭтотОбъект.Дата;
		ЭтотОбъект.Валюта 					= ЭтотОбъект.Организация.ВалютаУчета;

		// заполним основание
		НоваяСтрокаОснование = ЭтотОбъект.Основания.Добавить();
		НоваяСтрокаОснование.Основание = ДанныеЗаполнения;
		НоваяСтрокаОснование.Сумма     = ДанныеЗаполнения.СуммаОбъявленная - ДанныеЗаполнения.Сумма;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента") Тогда
		
		КредитныйИнструмент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "КредитныйИнструмент"); 
		Если РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(КредитныйИнструмент) Тогда
		
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, РасчетныйСчет");
			
			ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДепозитныеВклады.БанковскийСчет.Валюта КАК Валюта,
				|	ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо КАК Контрагент
				|ИЗ
				|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
				|ГДЕ
				|	ДепозитныеВклады.Ссылка = &КредитныйИнструмент";
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("КредитныйИнструмент", КредитныйИнструмент);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
			
			ЭтотОбъект.Дата             		= НачалоДня(ДанныеЗаполнения.Дата) + 19*60*60 + 30*60;
			ЭтотОбъект.ВидЗадолженности 		= Справочники.ВидыЗадолженности.ПоТорговойКомиссии;	
			
			ЭтотОбъект.МестоХранения    		= Справочники.МестаХранения.ММВБ_ДепозитыСЦК;	
			ЭтотОбъект.ДатаПолученияДокумента	= ЭтотОбъект.Дата;
			
			// заполним основание
			НоваяСтрокаОснование = ЭтотОбъект.Основания.Добавить();
			НоваяСтрокаОснование.Основание = ДанныеЗаполнения;
			НоваяСтрокаОснование.ЦеннаяБумага = КредитныйИнструмент;
			НоваяСтрокаОснование.ДатаОплаты = ЭтотОбъект.Дата;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
		
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект,
			"НомерВходящегоДокумента, ДатаВходящегоДокумента, Вознаграждение, НеУчитыватьВСЧА, ПоКлиентскомуОтноситьНаДатуОплаты");
	
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "НомерСчетаФактуры, ДатаСчетаФактуры, Предварительно");
	
	Если НЕ НуженВходящийДокумент() Тогда
		ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "ВидВходящегоДокумента");
	КонецЕсли;
	
	ДатаПолученияДокумента = ТекущаяДата();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидВходящегоДокумента) Тогда
		ПроверяемыеРеквизиты.Добавить("НомерВходящегоДокумента");
		ПроверяемыеРеквизиты.Добавить("ДатаВходящегоДокумента");
	КонецЕсли;
		
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде Тогда
		
		ИндексДатыПолучения = ПроверяемыеРеквизиты.Найти("ДатаПолученияДокумента");
		Если ИндексДатыПолучения <> Неопределено Тогда 
			ПроверяемыеРеквизиты.Удалить(ИндексДатыПолучения);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭтотОбъект.Договор)
			И ЭтотОбъект.Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.Аренды")
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности ""По аренде"" возможно указание договора только с видом договора ""Аренды""", ЭтотОбъект.Ссылка, , "Объект.Договор", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
		И ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК
		И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект)
	Тогда
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчет");
	КонецЕсли;
	
	Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если РаботаСДокументами.ОбязательноЗаполнениеРасчетногоСчетаКонтрагентаВНачисленииЗадолженности(ЭтотОбъект)	Тогда
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчетКонтрагента");
	КонецЕсли;
		
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Предварительная обработка объекта
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// Блокирующие проверки
	
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии
			ИЛИ ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия)
		Тогда
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Договор"" не заполнено", ЭтотОбъект.Ссылка,, "Объект.Договор", Отказ);
			ИначеЕсли ТипЗнч(ЭтотОбъект.Договор) = Тип("СправочникСсылка.Договоры") Тогда
				МассивВидовДоговоров = Новый Массив;
				МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ВеденияРеестра"));
				МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДепозитарногоОбслуживания"));
				МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания"));
				МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецРегистрационногоОбслуживания"));
				МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ОтветственногоХранения"));
			
				Если МассивВидовДоговоров.Найти(ЭтотОбъект.Договор.ВидДоговора) = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности '" + ЭтотОбъект.ВидЗадолженности + "' нельзя выбирать договор вида '" + ЭтотОбъект.Договор.ВидДоговора + "'", ЭтотОбъект.Ссылка,, "Объект.Договор", Отказ);
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюОценщика Тогда
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Договор"" не заполнено", ЭтотОбъект.Ссылка,, "Объект.Договор", Отказ);
			ИначеЕсли ЭтотОбъект.Договор.ВидДоговора <> Перечисления.ВидыДоговоров.Оценки Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности '" + ЭтотОбъект.ВидЗадолженности + "' нельзя выбирать договор вида '" + ЭтотОбъект.Договор.ВидДоговора + "'", ЭтотОбъект.Ссылка,, "Объект.Договор", Отказ);
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам Тогда
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Договор)
				И ЭтотОбъект.Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.Прочее")
				И ЭтотОбъект.Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДоговорСтрахования")
			Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности ""По прочим доходам"" возможно указание договора только с видом договора ""Прочее"" или ""Договор страхования""", ЭтотОбъект.Ссылка, , "Объект.Договор", Отказ);
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоИнымДоходамПоИмуществу Тогда
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности ""По иным доходам по имуществу"" заполнение договора обязательно", ЭтотОбъект.Ссылка, , "Объект.Договор", Отказ);
			ИначеЕсли ЭтотОбъект.Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СтроительствоНаСвоемУчастке")
				И ЭтотОбъект.Договор.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СтроительствоНаЧужомУчастке")
			Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности ""По иным доходам по имуществу"" возможно указание только договора строительства", ЭтотОбъект.Ссылка, , "Объект.Договор", Отказ);
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Недвижимость) Тогда
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности """ + ЭтотОбъект.ВидЗадолженности + """ необходимо указать договор!", ЭтотОбъект, "Договор", , Отказ); 
			КонецЕсли;
			
		КонецЕсли;
		
		// Для ПИФ реквизит ПрочиеДоходыИРасходы используется для учета резервов, поэтому проверяем его заполнение
		
		ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
		ДатаНачалаУчетаРезервовПИФ 			= СистемныеФункции.ПолучитьДатуНачалаУчетаРезервовПИФ();
		
		Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
			И ЭтотОбъект.Дата >= ДатаНачалаУчетаРезервовПИФ 
		Тогда
			Если Не ЗначениеЗаполнено(ЭтотОбъект.ПрочиеДоходыИРасходы) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить реквизит 'Прочие доходы и расходы'", ЭтотОбъект, "ПрочиеДоходыИРасходы",, Отказ);
			Иначе
				АналитикаПредварительно = Справочники.ВидыЗадолженности.ПолучитьАналитикуДляПредварительныхНачисленийПоВидуЗадолженности(ЭтотОбъект.ВидЗадолженности);
				Если ЭтотОбъект.Предварительно Тогда
					//проверим что аналитика верная
					Если АналитикаПредварительно = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена аналитика для отражения предварительных начислений по виду задолженности " + ЭтотОбъект.ВидЗадолженности, ЭтотОбъект, "ПрочиеДоходыИРасходы",, Отказ);
					ИначеЕсли АналитикаПредварительно <> ЭтотОбъект.ПрочиеДоходыИРасходы Тогда
						//реквизит должен быть заполнен перед проведением
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Установленное значение реквизита 'Прочие доходы и расходы' не соответствует аналитике предварительных начислений. Ожидается значение """+АналитикаПредварительно+"""", ЭтотОбъект, "ПрочиеДоходыИРасходы",, Отказ);
					КонецЕсли;
				Иначе
					//если не предварительно, то проверим, что не осталась "предварительная" аналитика
					Если ЭтотОбъект.ПрочиеДоходыИРасходы = АналитикаПредварительно Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Установленное значение реквизита 'Прочие доходы и расходы' соответствует аналитике предварительных начислений, при этом проводится обычное начисление.", ЭтотОбъект, "ПрочиеДоходыИРасходы",, Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Для депозитарной комиссии проверка соответствия контрагента документа контрагенту договора с депозитарием 
		
		Если (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии
				ИЛИ ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия))
			И ЗначениеЗаполнено(ЭтотОбъект.Контрагент) И ЗначениеЗаполнено(ЭтотОбъект.Договор)
			И ЭтотОбъект.Договор.Контрагент <> ЭтотОбъект.Контрагент
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент " + ЭтотОбъект.Контрагент + " не является юр/лицом депозитария " + ЭтотОбъект.Договор.Контрагент + " в выбранном договоре депозитарного обслуживания", ЭтотОбъект, "Договор", , Отказ);
		КонецЕсли;
		
		// Задолженность по выплате дохода по инвестиционным паям возможна только по ЗПИФ
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям Тогда
			КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
			Если ТипЗнч(КлиентДоверительногоУправления) <> Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") ИЛИ КлиентДоверительногоУправления.Тип <> Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Закрытый Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Начисление задолженности с видом '" + ЭтотОбъект.ВидЗадолженности + "' возможно только по ЗПИФ", ЭтотОбъект, "ВидЗадолженности",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// Для вознаграждения за размещение должна быть задана ставка вознаграждения
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение Тогда
			Если Справочники.СтратегииИндивидуальногоИнвестирования.ПолучитьСтавкуВознагражденияУправляющегоПлатуЗаРазмещение(ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления) = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана ставка вознаграждения за размещение по клиенту '" + ЭтотОбъект.СчетДоверительногоУправления + "'. Начисление задолженности не поддерживается", ЭтотОбъект,,, Отказ);
			КонецЕсли;
		КонецЕсли;	
			
		// Проверка оснований по виду задолженности
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
			
			// Если заполнено основание, то и ценная бумага должна быть заполнена (почти всегда)
			
			Для Инд = 0 По ЭтотОбъект.Основания.Количество() - 1 Цикл
				СтрокаОснования = ЭтотОбъект.Основания[Инд];
				Если ЗначениеЗаполнено(СтрокаОснования.Основание) И ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.СделкаСВалютой") И ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.СделкаСПФИ") И Не ЗначениеЗаполнено(СтрокаОснования.ЦеннаяБумага) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " необходимо заполнить ценную бумагу", ЭтотОбъект, "Основания[" + Инд + "].ЦеннаяБумага",, Отказ);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
			
			КомиссияПоБиржевомуДепозиту = (ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК);
			
			Для Инд = 0 По ЭтотОбъект.Основания.Количество() - 1 Цикл
				
				СтрокаОснования = ЭтотОбъект.Основания[Инд];
			
				// Документ-основание и ценная бумага (если это не сделка на валютном рынке) должны быть заполнены
				
				Если Не ЗначениеЗаполнено(СтрокаОснования.Основание) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " необходимо заполнить документ-основание", ЭтотОбъект, "Основания[" + Инд + "].Основание",, Отказ);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаОснования.ЦеннаяБумага) И ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.СделкаСВалютой") И ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.СделкаСПФИ") Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " необходимо заполнить ценную бумагу", ЭтотОбъект, "Основания[" + Инд + "].ЦеннаяБумага",, Отказ);
				КонецЕсли;
				
				// Для торговой комиссии депозитов с ЦК проверка соответствия контрагента документа банку депозитного вклада
		
				Если КомиссияПоБиржевомуДепозиту И РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(СтрокаОснования.ЦеннаяБумага) Тогда
					
					БанкДепозита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснования.ЦеннаяБумага, "БанковскийСчет.Банк.ЮрФизЛицо");
					
					Если ЭтотОбъект.Контрагент <> БанкДепозита Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент " + ЭтотОбъект.Контрагент + " не является юр/лицом банка " + БанкДепозита + " в договоре депозитного вклада", ЭтотОбъект, "Основания[" + Инд + "].ЦеннаяБумага", , Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение Тогда
			
			// Должно быть одно основание - ввод д/с с соответствующими реквизитами
			
			Если ЭтотОбъект.Основания.Количество() = 0 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При начислении задолженности " + ЭтотОбъект.ВидЗадолженности + " требуется указать документ-основание", ЭтотОбъект, "Основания",, Отказ);
				
			ИначеЕсли ЭтотОбъект.Основания.Количество() > 1 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Начисление задолженности " + ЭтотОбъект.ВидЗадолженности + " возможно только по одному документу-основанию", ЭтотОбъект, "Основания[1]",, Отказ);
				
			ИначеЕсли Не ЗначениеЗаполнено(Основания[0].Основание) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № 1 необходимо заполнить документ-основание", ЭтотОбъект, "Основания[0].Основание",, Отказ);
				
			ИначеЕсли ТипЗнч(Основания[0].Основание) <> Тип("ДокументСсылка.ВводДенежныхСредств") Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основание начисления задолженности по вознаграждению управляющего (плата за размещение) может быть только ввод денежных средств", ЭтотОбъект, "Основания[0].Основание",, Отказ);
				
			ИначеЕсли Документы.ВводДенежныхСредств.НачислениеВознагражденияЗаРазмещениеТребуетСинхронизации(ЭтотОбъект, ЭтотОбъект.Дата, ЭтотОбъект.СчетДоверительногоУправления) Тогда

				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные документа отличаются от данных ввода денежных средств! Документ не проведен!", ЭтотОбъект, , , Отказ); 
				
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде 
				Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть Тогда
				
			Для Каждого Строка из ЭтотОбъект.Основания Цикл
				Если Не ЗначениеЗаполнено(Строка.ДатаОплаты) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана плановая дата оплаты для арендного платежа!", ЭтотОбъект,, "ПлановаяДатаОплаты", Отказ); 
					Прервать;
				КонецЕсли;
			КонецЦикла;
				
		ИначеЕсли НЕ ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) 
			И ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль
		Тогда
		
			// Бывает так, что заполнение документа-основания нам не нужно
			
			Для Инд = 0 По ЭтотОбъект.Основания.Количество() - 1 Цикл
				СтрокаОснования = ЭтотОбъект.Основания[Инд];
				Если ЗначениеЗаполнено(СтрокаОснования.Основание) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " заполнен документ-основание " + СтрокаОснования.Основание + "! Для вида задолженности " + ЭтотОбъект.ВидЗадолженности + " это поле должно быть пустым", ЭтотОбъект, "Основания[" + Инд + "].ЦеннаяБумага",, Отказ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;	
		
		РаботаСДокументами.ПроверитьВидыЗадолженностиОплачиваемойИзСобственныхСредствКлиента(ЭтотОбъект, Отказ);
						
		// Проверка периода, за который начисляется задолженность 
		
		Если Не (ЗначениеЗаполнено(ЭтотОбъект.НачалоПериодаНачисления) И ЗначениеЗаполнено(ЭтотОбъект.ОкончаниеПериодаНачисления))
			И Справочники.ВидыЗадолженности.ТребуетсяУказаниеПериодаНачисленияЗадолженности(ЭтотОбъект.Организация, ЭтотОбъект.ВидЗадолженности, ЭтотОбъект.Дата, ВидДоговораДоверительногоУправления)
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Период, за который начисляется задолженность, не заполнен", ЭтотОбъект, "ПериодНачисления", , Отказ);
		КонецЕсли;
		
		ЭтоИсходящаяУслуга = Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ЭтотОбъект.ВидЗадолженности);
		
		Если ЭтотОбъект.Предварительно Тогда
			
			Если НЕ Справочники.ВидыЗадолженности.ДопустимоПредварительноеНачислениеЗадолженности(ЭтотОбъект.Организация, ЭтотОбъект.ВидЗадолженности, ЭтотОбъект.Дата) Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности " + ЭтотОбъект.ВидЗадолженности + " не предусмотрено предварительного начисления", ЭтотОбъект.Ссылка, "Предварительно",,Отказ);
			КонецЕсли;
			
			//проверка периода
			Если НЕ (ЭтотОбъект.НачалоПериодаНачисления <= ЭтотОбъект.Дата И ЭтотОбъект.Дата <= КонецДня(ЭтотОбъект.ОкончаниеПериодаНачисления)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для предварительных затрат дата документа должна попадать в период начисления", ЭтотОбъект.Ссылка, "ПериодНачисления",,Отказ);
			КонецЕсли;
			Если НачалоМесяца(ЭтотОбъект.НачалоПериодаНачисления) <> НачалоМесяца(ЭтотОбъект.ОкончаниеПериодаНачисления)Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Предварительные затраты допустимо оформлять только в пределах одного месяца", ЭтотОбъект.Ссылка, "ПериодНачисления",,Отказ);
			КонецЕсли;
			
			//проверка НДС
			Если Не ЭтоИсходящаяУслуга Тогда
				Для Инд = 0 По ЭтотОбъект.Основания.Количество() - 1 Цикл
					СтрокаОснования = ЭтотОбъект.Основания[Инд];
					Если ЗначениеЗаполнено(СтрокаОснования.СтавкаНДС) Или СтрокаОснования.СуммаНДС <> 0 Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " заполнены ставка и/или сумма НДС для предварительного начисления входящей услуги!", ЭтотОбъект, "Основания[" + Инд + "].СтавкаНДС",, Отказ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			//проверка входящего документа
			Если ЗначениеЗаполнено(ЭтотОбъект.ВидВходящегоДокумента) ИЛИ ЗначениеЗаполнено(ЭтотОбъект.НомерВходящегоДокумента) ИЛИ ЗначениеЗаполнено(ЭтотОбъект.ДатаВходящегоДокумента) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указаны реквизиты входящего документа для предвартельных задолженностей. Т.к. документов нет, то реквииты необходимо очистить", ЭтотОбъект.Ссылка, "ВидВходящегоДокумента",,Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если РаботаСНДС.ВестиУчетНДС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
			Если НЕ ЭтоИсходящаяУслуга Тогда
				Если ЭтотОбъект.Основания.Итог("СуммаНДС") > 0 Тогда
					Если ЭтотОбъект.НДСВключатьВСтоимость и ЭтотОбъект.ЗачестьНДС Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя одновременно включить НДС в стоимость и зачесть его", ЭтотОбъект.Ссылка, "ЗачестьНДС",,Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//проверка наличия подчиненного поручения на движение денежных средств
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) 
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда 
		
		ПоручениеСсылка = РаботаСДокументами.ПолучитьПодчиненныйДокументПоручениеНаВыводАктивов(ЭтотОбъект);
		
		Если ПоручениеСсылка <> Неопределено 
			И (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
				Или Не РаботаСДокументами.ЗначенияРеквизитовСоответствуютОснованиюПоручения(ПоручениеСсылка, ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(ЭтотОбъект, "СчетДоверительногоУправления, ВидЗадолженности, Брокер, Валюта, МестоХранения, Основания"))) Тогда 
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На основании начисления задолженности сформировано поручение на движение денежных средств [" + ПоручениеСсылка + "]. Перед изменением документа необходимо отменить поручение.", ЭтотОбъект.Ссылка,,, Отказ);
	
		КонецЕсли;
					
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

Процедура УстановитьБлокировки(ВестиУчетНДС)
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// задолженность по д/с
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("Аванс",       			       Истина);
	ЭлементБлокировкиДанных.УстановитьЗначение("ТипЗадолженности",             Перечисления.ТипыЗадолженности.Дебиторская);
	ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности",             ЭтотОбъект.ВидЗадолженности);
	ЭлементБлокировкиДанных.УстановитьЗначение("Контрагент",             	   ЭтотОбъект.Контрагент);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Валюта",             	       ЭтотОбъект.Валюта);
	
	Если ВестиУчетНДС  Тогда
	
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("Контрагент",             	   РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Истина));
		ЭлементБлокировкиДанных.УстановитьЗначение("Аванс",       			       Ложь);
		ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности",             Справочники.ВидыЗадолженности.НДСПоАвансам);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Валюта",             	       ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
		
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	ВестиУчетНДС = РаботаСНДС.ВестиУчетНДС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	УстановитьБлокировки(ВестиУчетНДС);
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать	= Истина;
	Движения.РасходыПоСделке.Записывать						= Истина;
	Движения.РезервыПИФ.Записывать					        = Истина;
	Движения.НачисленияНалогов.Записывать   		        = Истина;
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// зачет авансов
	Запрос = Новый Запрос;
	Запрос.Текст =	 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(НачислениеЗадолженностиОснования.Сумма) КАК СуммаРасходов
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|ГДЕ
		|	(НачислениеЗадолженностиОснования.Основание = НЕОПРЕДЕЛЕНО
		|			ИЛИ ТИПЗНАЧЕНИЯ(НачислениеЗадолженностиОснования.Основание) = ТИП(Документ.РасчетНДФЛ))
		|	И НачислениеЗадолженностиОснования.Ссылка = &Ссылка
		|
		|ИМЕЮЩИЕ
		|	СУММА(НачислениеЗадолженностиОснования.Сумма) <> 0";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	ВыборкаСуммаРасходовБезОснования = Запрос.Выполнить().Выбрать();
	
	СуммаРасходовБезОснования = 0;
	Если ВыборкаСуммаРасходовБезОснования.Следующий() Тогда
		СуммаРасходовБезОснования = ВыборкаСуммаРасходовБезОснования.СуммаРасходов;
	КонецЕсли; 
		
	// проверим, есть ли авансы
	// зачет авансов только по строкам тч основания с пустым основанием
	Если СуммаРасходовБезОснования > 0 И НЕ ЭтотОбъект.Предварительно Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =	
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			ТипЗадолженности = &ТипЗадолженности
			|				И ВидЗадолженности = &ВидЗадолженности
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Валюта = &Валюта
			|				И Контрагент = &Контрагент
			|				И Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = Оплата.Ссылка
			|			И (Оплата.Договор = &Договор)
			|			И (НЕ Оплата.ОбеспечительныйПлатеж)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.МоментВремени";
		
		Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("ВидЗадолженности", 				ЭтотОбъект.ВидЗадолженности);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Валюта", 						ЭтотОбъект.Валюта);
		Запрос.УстановитьПараметр("Контрагент", 					ЭтотОбъект.Контрагент);
		
		ТипОсновнойЗадолженности = Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности);
		Если ТипОсновнойЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
			ТипЗадолженностиАванса = Перечисления.ТипыЗадолженности.Кредиторская;
		Иначе
			ТипЗадолженностиАванса = Перечисления.ТипыЗадолженности.Дебиторская;
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ТипЗадолженности", ТипЗадолженностиАванса);
		Запрос.УстановитьПараметр("Договор", ЭтотОбъект.Договор);
		
		ТаблицаЗачетаАвансов = Запрос.Выполнить().Выгрузить();
		ТаблицаЗачетаАвансов.Колонки.Добавить("СуммаЗачтено", Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаЗачетаАвансов Из ТаблицаЗачетаАвансов Цикл
			Если СуммаРасходовБезОснования > 0 Тогда
				
				Если СуммаРасходовБезОснования >= СтрокаЗачетаАвансов.СуммаОстаток Тогда
					СуммаЗачетаАванса = СтрокаЗачетаАвансов.СуммаОстаток;
				Иначе
					СуммаЗачетаАванса = СуммаРасходовБезОснования;
				КонецЕсли; 
				
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Аванс                        = Истина;
				Движение.Основание                    = СтрокаЗачетаАвансов.Основание;
				Движение.ТипЗадолженности             = ТипЗадолженностиАванса;
				Движение.ВидЗадолженности             = ЭтотОбъект.ВидЗадолженности;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.Контрагент                   = ЭтотОбъект.Контрагент;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Валюта                       = ЭтотОбъект.Валюта;
				Движение.Сумма                        = СуммаЗачетаАванса;
				
				СуммаРасходовБезОснования = СуммаРасходовБезОснования - СуммаЗачетаАванса;
				СтрокаЗачетаАвансов.СуммаЗачтено = СуммаЗачетаАванса;
				
			Иначе
				Прервать;
			КонецЕсли; 
		КонецЦикла; 		
		
		//авансовый НДС
		//ИтогоСуммаНДС = ЭтотОбъект.Основания.Итог("СуммаНДС");
		Если ВестиУчетНДС И ЭтотОбъект.Основания.Итог("СуммаНДС") > 0 Тогда
			
			ТипЗадолженностиАвансовогоНДС = ?(ТипЗадолженностиАванса = Перечисления.ТипыЗадолженности.Дебиторская, Перечисления.ТипыЗадолженности.Кредиторская, Перечисления.ТипыЗадолженности.Дебиторская);
			
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаЗачетаАвансов, "_ТаблицаЗачетаАвансов", Запрос.МенеджерВременныхТаблиц);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НДСПоАвансам.Основание КАК Основание,
				|	НДСПоАвансам.Валюта КАК Валюта,
				|	НДСПоАвансам.СуммаОстаток КАК СуммаОстаток,
				|	НДСПоАвансам.Контрагент КАК Контрагент,
				|	ЕСТЬNULL(_ТаблицаЗачетаАвансов.СуммаЗачтено, 0) = ЕСТЬNULL(_ТаблицаЗачетаАвансов.СуммаОстаток, 0) КАК АвансЗачтенПолностью,
				|	СчетФактураОснования.СуммаСНДС КАК СуммаСНДССчетаФактуры,
				|	СчетФактураОснования.СуммаНДС КАК СуммаНДССчетаФактуры,
				|	_ТаблицаЗачетаАвансов.СуммаЗачтено КАК СуммаЗачтено
				|ИЗ
				|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
				|			&Период,
				|			ТипЗадолженности = &ТипЗадолженностиАвансовогоНДС
				|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСПоАвансам)
				|				И Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Валюта = &Валюта
				|				И Основание В
				|					(ВЫБРАТЬ
				|						СчетФактураОснования.Ссылка КАК Ссылка
				|					ИЗ
				|						Документ.СчетФактура.Основания КАК СчетФактураОснования
				|					ГДЕ
				|						СчетФактураОснования.Основание В
				|							(ВЫБРАТЬ
				|								_ТаблицаЗачетаАвансов.Основание
				|							ИЗ
				|								_ТаблицаЗачетаАвансов КАК _ТаблицаЗачетаАвансов)
				|						И СчетФактураОснования.Ссылка.Контрагент = &Контрагент
				|						И СчетФактураОснования.Ссылка.Договор = &Договор)) КАК НДСПоАвансам
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура.Основания КАК СчетФактураОснования
				|		ПО НДСПоАвансам.Основание = СчетФактураОснования.Ссылка
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
				|		ПО (СчетФактураОснования.Основание = Оплата.Ссылка)
				|			И (Оплата.ВидЗадолженности = &ВидЗадолженности)
				|			И (НЕ Оплата.ОбеспечительныйПлатеж)
				|			И (Оплата.Ссылка В
				|				(ВЫБРАТЬ
				|					_ТаблицаЗачетаАвансов.Основание
				|				ИЗ
				|					_ТаблицаЗачетаАвансов КАК _ТаблицаЗачетаАвансов))
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаЗачетаАвансов КАК _ТаблицаЗачетаАвансов
				|		ПО (_ТаблицаЗачетаАвансов.Основание = Оплата.Ссылка)
				|			И (_ТаблицаЗачетаАвансов.СуммаЗачтено <> 0)";
			
			Запрос.УстановитьПараметр("Договор", ЭтотОбъект.Договор);
			Запрос.УстановитьПараметр("ТипЗадолженностиАвансовогоНДС", ТипЗадолженностиАвансовогоНДС);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			ИФНС = РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Истина);
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если ВыборкаДетальныеЗаписи.АвансЗачтенПолностью Тогда
					СуммаЗачетаНДСПоАвансам = ВыборкаДетальныеЗаписи.СуммаОстаток;
				Иначе
					СуммаЗачетаНДСПоАвансам = Окр(ВыборкаДетальныеЗаписи.СуммаНДССчетаФактуры * ВыборкаДетальныеЗаписи.СуммаЗачтено / ВыборкаДетальныеЗаписи.СуммаСНДССчетаФактуры, 2);
				КонецЕсли; 
				
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Аванс                        = Ложь;
				Движение.Основание                    = ВыборкаДетальныеЗаписи.Основание;
				Движение.ТипЗадолженности             = ТипЗадолженностиАвансовогоНДС;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.НДСПоАвансам;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.Контрагент                   = ВыборкаДетальныеЗаписи.Контрагент;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Валюта                       = ВыборкаДетальныеЗаписи.Валюта;
				Движение.Сумма                        = СуммаЗачетаНДСПоАвансам;
				
				//типа книга покупок: для аванса полученного - дебиторка, для аванса выданного - кредиторка
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Аванс                        = Ложь;
				Движение.Основание                    = ВыборкаДетальныеЗаписи.Основание;
				Движение.ТипЗадолженности             = ТипЗадолженностиАвансовогоНДС;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.НДСТекущегоПериода;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.Контрагент                   = ИФНС;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Валюта                       = ВыборкаДетальныеЗаписи.Валюта;
				Движение.Сумма                        = СуммаЗачетаНДСПоАвансам;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
		
	//зачтем предварительные
	//Предполагаем, что услуги покупателям закрываем в том же квартале, в котором начисляли предварительные,
	//	иначе НДС не найдем, т.к. собираем на остатках. 
	
	СуммаПредварительныхЗатратСторнированная = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Аванс КАК Аванс,
		|	-ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма,
		|	НачислениеЗадолженности.НачалоПериодаНачисления МЕЖДУ &НачалоПериодаНачисления И &ОкончаниеПериодаНачисления
		|		И (НачислениеЗадолженности.ОкончаниеПериодаНачисления МЕЖДУ &НачалоПериодаНачисления И &ОкончаниеПериодаНачисления) КАК ЭтоКорректныйПериод,
		|	НачислениеЗадолженности.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
		|	НачислениеЗадолженности.ОкончаниеПериодаНачисления КАК ОкончаниеПериодаНачисления
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&МоментВремени,
		|			ВидЗадолженности В (&ВидЗадолженности, ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСТекущегоПериода))
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И НЕ Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО (&ВидЗадолженности = НачислениеЗадолженности.ВидЗадолженности)
		|			И (НачислениеЗадолженности.НачалоПериодаНачисления МЕЖДУ &НачалоПериодаНачисления И &ОкончаниеПериодаНачисления
		|				ИЛИ НачислениеЗадолженности.ОкончаниеПериодаНачисления МЕЖДУ &НачалоПериодаНачисления И &ОкончаниеПериодаНачисления)
		|			И (НачислениеЗадолженности.Договор = &Договор)
		|			И (НачислениеЗадолженности.Предварительно)
		|			И ЗадолженностиПоДенежнымСредствамОстатки.Основание = НачислениеЗадолженности.Ссылка";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
	Запрос.УстановитьПараметр("Договор", ЭтотОбъект.Договор);
	Запрос.УстановитьПараметр("НачалоПериодаНачисления", ЭтотОбъект.НачалоПериодаНачисления);
	Запрос.УстановитьПараметр("ОкончаниеПериодаНачисления", ЭтотОбъект.ОкончаниеПериодаНачисления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ВыборкаДетальныеЗаписи.ЭтоКорректныйПериод И ВыборкаДетальныеЗаписи.ВидЗадолженности = ВидЗадолженности Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружена предварительная задолженность за пересекающийся период с " 
				+ Формат(ВыборкаДетальныеЗаписи.НачалоПериодаНачисления, "ДФ=dd.MM.yyyy") 
				+ " по " + Формат(ВыборкаДетальныеЗаписи.ОкончаниеПериодаНачисления, "ДФ=dd.MM.yyyy") 
				+ " в документе " + ВыборкаДетальныеЗаписи.Основание,,,,Отказ);
			Продолжить;
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
		
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетальныеЗаписи);
		
		СуммаПредварительныхЗатратСторнированная = СуммаПредварительныхЗатратСторнированная + Движение.Сумма;
		
	КонецЦикла;

	// начисление задолженности
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ТипЗадолженности КАК ТипЗадолженности,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	НачислениеЗадолженностиОснования.Основание КАК Основание,
		|	НачислениеЗадолженности.Дата КАК Период,
		|	НачислениеЗадолженности.Организация КАК Организация,
		|	НачислениеЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
		|	НачислениеЗадолженности.Валюта КАК Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Контрагент КАК Контрагент,
		|	СУММА(НачислениеЗадолженностиОснования.Сумма) КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
		|ГДЕ
		|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
		|	И НачислениеЗадолженностиОснования.Основание <> НЕОПРЕДЕЛЕНО
		|	И ТИПЗНАЧЕНИЯ(НачислениеЗадолженностиОснования.Основание) <> ТИП(Документ.РасчетНДФЛ)
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженностиОснования.Основание,
		|	НачислениеЗадолженности.Дата,
		|	НачислениеЗадолженности.Организация,
		|	НачислениеЗадолженности.ВидЗадолженности,
		|	НачислениеЗадолженности.Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Контрагент
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&ТипЗадолженности,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Дата,
		|	НачислениеЗадолженности.Организация,
		|	НачислениеЗадолженности.ВидЗадолженности,
		|	НачислениеЗадолженности.Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Контрагент,
		|	&Сумма
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
		|ГДЕ
		|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
		|	И (НачислениеЗадолженностиОснования.Основание = НЕОПРЕДЕЛЕНО
		|			ИЛИ ТИПЗНАЧЕНИЯ(НачислениеЗадолженностиОснования.Основание) = ТИП(Документ.РасчетНДФЛ))
		|	И &Сумма > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Дата,
		|	НачислениеЗадолженности.Организация,
		|	НачислениеЗадолженности.ВидЗадолженности,
		|	НачислениеЗадолженности.Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Контрагент";
	
	ТипЗадолженности = Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности);
	
	Если ЗначениеЗаполнено(Арендатор) И Не Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ЭтотОбъект.ВидЗадолженности) Тогда
		Запрос.Текст = Запрос.Текст + 
		"
		|
		|ОБЪЕДИНИТЬ
		|
		|";
		
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Дата,
		|	НачислениеЗадолженности.Организация,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде),
		|	НачислениеЗадолженности.Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Арендатор,
		|	&Сумма
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
		|ГДЕ
		|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
		|	И НачислениеЗадолженностиОснования.Основание = НЕОПРЕДЕЛЕНО
		|	И ТИПЗНАЧЕНИЯ(НачислениеЗадолженностиОснования.Основание) <> ТИП(Документ.РасчетНДФЛ)
		|	И &Сумма > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Дата,
		|	НачислениеЗадолженности.Организация,
		|	НачислениеЗадолженности.ВидЗадолженности,
		|	НачислениеЗадолженности.Валюта,
		|	НачислениеЗадолженности.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Арендатор";
		
	КонецЕсли;	
	
	Если ВестиУчетНДС И Основания.Итог("СуммаНДС") > 0 Тогда
		
		Запрос.Текст = Запрос.Текст + 
		"
		|
		|ОБЪЕДИНИТЬ
		|";
		
		ЭтоИсходящаяУслуга = Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ЭтотОбъект.ВидЗадолженности);
		
		Если ЭтоИсходящаяУслуга Тогда
			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ
				|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская),
				|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
				|	НачислениеЗадолженности.Ссылка,
				|	НачислениеЗадолженности.Дата,
				|	НачислениеЗадолженности.Организация,
				|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСТекущегоПериода),
				|	НачислениеЗадолженности.Валюта,
				|	НачислениеЗадолженности.СчетДоверительногоУправления,
				|	&ИФНС,
				|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС)
				|ИЗ
				|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
				|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
				|ГДЕ
				|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	НачислениеЗадолженности.Ссылка,
				|	НачислениеЗадолженности.Дата,
				|	НачислениеЗадолженности.Организация,
				|	НачислениеЗадолженности.Валюта,
				|	НачислениеЗадолженности.СчетДоверительногоУправления,
				|	НачислениеЗадолженности.Контрагент";
			
		Иначе
			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ
				|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
				|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
				|	НачислениеЗадолженности.Ссылка,
				|	НачислениеЗадолженности.Дата,
				|	НачислениеЗадолженности.Организация,
				|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСПоПриобретеннымЦенностям),
				|	НачислениеЗадолженности.Валюта,
				|	НачислениеЗадолженности.СчетДоверительногоУправления,
				|	&ИФНС,
				|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС)
				|ИЗ
				|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
				|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
				|ГДЕ
				|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	НачислениеЗадолженности.Ссылка,
				|	НачислениеЗадолженности.Дата,
				|	НачислениеЗадолженности.Организация,
				|	НачислениеЗадолженности.Валюта,
				|	НачислениеЗадолженности.СчетДоверительногоУправления
				|
				|ИМЕЮЩИЕ
				|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС) > 0";
			
			Если ЭтотОбъект.НДСВключатьВСтоимость ИЛИ ЭтотОбъект.ЗачестьНДС Тогда
				
				Запрос.Текст = Запрос.Текст + 
					"ВЫБРАТЬ
					|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
					|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
					|	НачислениеЗадолженности.Ссылка,
					|	НачислениеЗадолженности.Дата,
					|	НачислениеЗадолженности.Организация,
					|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСПоПриобретеннымЦенностям),
					|	НачислениеЗадолженности.Валюта,
					|	НачислениеЗадолженности.СчетДоверительногоУправления,
					|	&ИФНС,
					|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС)
					|ИЗ
					|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
					|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
					|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
					|ГДЕ
					|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
					|
					|СГРУППИРОВАТЬ ПО
					|	НачислениеЗадолженности.Ссылка,
					|	НачислениеЗадолженности.Дата,
					|	НачислениеЗадолженности.Организация,
					|	НачислениеЗадолженности.Валюта,
					|	НачислениеЗадолженности.СчетДоверительногоУправления
					|
					|ИМЕЮЩИЕ
					|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС) > 0";
				
				Если ЭтотОбъект.ЗачестьНДС Тогда
					
					Запрос.Текст = Запрос.Текст + 
						"ВЫБРАТЬ
						|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская),
						|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
						|	НачислениеЗадолженности.Ссылка,
						|	НачислениеЗадолженности.Дата,
						|	НачислениеЗадолженности.Организация,
						|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСТекущегоПериода),
						|	НачислениеЗадолженности.Валюта,
						|	НачислениеЗадолженности.СчетДоверительногоУправления,
						|	&ИФНС,
						|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС)
						|ИЗ
						|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
						|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
						|		ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
						|ГДЕ
						|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
						|
						|СГРУППИРОВАТЬ ПО
						|	НачислениеЗадолженности.Ссылка,
						|	НачислениеЗадолженности.Дата,
						|	НачислениеЗадолженности.Организация,
						|	НачислениеЗадолженности.Валюта,
						|	НачислениеЗадолженности.СчетДоверительногоУправления
						|
						|ИМЕЮЩИЕ
						|	СУММА(НачислениеЗадолженностиОснования.СуммаНДС) > 0";
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ИФНС", РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, Истина));
		Запрос.УстановитьПараметр("ЭтоИсходящаяУслуга", ЭтоИсходящаяУслуга);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Сумма",  СуммаРасходовБезОснования);
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ТипЗадолженности", ТипЗадолженности);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход(), Выборка);
	КонецЦикла; 
	
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НачислениеЗадолженностиОснования.Ссылка.Дата КАК Период,
			|	НачислениеЗадолженностиОснования.Ссылка.Организация КАК Организация,
			|	НачислениеЗадолженностиОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НачислениеЗадолженностиОснования.Основание КАК Сделка,
			|	ЕСТЬNULL(НачислениеЗадолженностиОснования.Основание.Рынок, НЕОПРЕДЕЛЕНО) КАК Рынок,
			|	НачислениеЗадолженностиОснования.ЦеннаяБумага КАК ЦеннаяБумага,
			|	НачислениеЗадолженностиОснования.Ссылка.ВидЗадолженности КАК ВидЗадолженности,
			|	НачислениеЗадолженностиОснования.Ссылка.Валюта КАК Валюта,
			|	НачислениеЗадолженностиОснования.Сумма КАК Сумма
			|ИЗ
			|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
			|ГДЕ
			|	НачислениеЗадолженностиОснования.Ссылка = &Ссылка
			|	И (НачислениеЗадолженностиОснования.Основание ССЫЛКА Документ.Сделка
			|			ИЛИ НачислениеЗадолженностиОснования.Основание ССЫЛКА Документ.СделкаРЕПО
			|			ИЛИ НачислениеЗадолженностиОснования.Основание ССЫЛКА Документ.СделкаСВалютой)
			|	И НачислениеЗадолженностиОснования.Сумма > 0";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Движения.РасходыПоСделке.Добавить(), Выборка);
		КонецЦикла; 
		
	КонецЕсли;
	
	// Движения по резервам	
	// В резервах учитываем только кредиторскую задолженность
	Если ЗначениеЗаполнено(ЭтотОбъект.ПрочиеДоходыИРасходы) 
		И Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности) = Перечисления.ТипыЗадолженности.Кредиторская Тогда 
		
		РезервПоРасходу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ПрочиеДоходыИРасходы, "Резерв");
		Если ЗначениеЗаполнено(РезервПоРасходу) И БухгалтерскийУчет.РезервПИФНачисляетсяВУчете(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, РезервПоРасходу) Тогда		
			Движение = Движения.РезервыПИФ.ДобавитьРасход();
			
			Движение.Период      = ЭтотОбъект.Дата;
			Движение.Организация = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Резерв = РезервПоРасходу;
			
			ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
			Если ЭтотОбъект.Валюта <> ВалютаУчета Тогда 
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Основания.Итог("Сумма"), ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				Движение.Валюта = ВалютаУчета;
			Иначе
			    СуммаОперации = ЭтотОбъект.Основания.Итог("Сумма");
				Движение.Валюта = ЭтотОбъект.Валюта;
			КонецЕсли;
						
			Движение.Сумма  = СуммаОперации + СуммаПредварительныхЗатратСторнированная;
						
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество
		И ЭтотОбъект.Дата > Дата(2023,1,1) Тогда
		
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
		
		Для Каждого Строка из ЭтотОбъект.Основания Цикл
			
			Движение = Движения.НачисленияНалогов.Добавить();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = ЭтотОбъект.Ссылка;
			Движение.ВидЗадолженности             = ЭтотОбъект.ВидЗадолженности;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.СубъектАналитики             = Строка.ЦеннаяБумага;
			Движение.Налогоплательщик             = Клиент;
			Движение.Сумма                        = Строка.Сумма;
			
			ДополнительныеДанные = Документы.НачислениеЗадолженности.ПолучитьДополнительныеДанныеИзСодержания(Строка.Содержание);
			РасчетНалога = Неопределено;
			Если ДополнительныеДанные.Свойство("РасчетНалога", РасчетНалога) Тогда
				РасчетНалога.Свойство("БазаНалога", Движение.БазаНалога);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РегистрыСведений.ПлановыеДатыОплат.СформироватьДвижения(ЭтотОбъект);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);		
		
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
		
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии 
			ИЛИ ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия))
		И НастройкиУчета.НеОтражатьЗадолженностьПоБанковскойКомиссии
	Тогда
		Возврат;
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
		И ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК
		И НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам <> Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытии
	Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Арендатор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по ЕПС возмещения по договорам аренды не предусмотрено.", ЭтотОбъект, "Арендатор", , Отказ);
		Возврат;
	КонецЕсли;	
	
	ГруппаФинансовогоУчетаДоходовРасходовПриПроведении = ЭтотОбъект.ГруппаФинансовогоУчетаДоходовРасходов;
	
	Если НЕ ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходовПриПроведении) Тогда
		
		Если ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария
			ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		
			// берем настройку учета
			ГруппаФинансовогоУчетаДоходовРасходовПриПроведении = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(Дата, Организация, СчетДоверительногоУправления, ВидЗадолженности, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "Аналитика", Ложь);
			
		ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль Тогда
			
			// пустой ГФУ в данном случае это норма т.к. он далее будет определяться исходя из активов, причем их несколько может быть
			
		Иначе
			
			// вообще говоря сюда мы попадать не должны, исключение составляют документы, заведенные вручную, в которых девочки забыли проставить ГФУ
			ГруппаФинансовогоУчетаДоходовРасходовПриПроведении = БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаПоПрочимДоходамРасходам(
				ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидЗадолженности, Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка());
			
		КонецЕсли;
		
		// Для банковской комиссии заполнение группы фин.учета доходов/расходов обязательна
		
		Если Не ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходовПриПроведении)
			И (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии
				ИЛИ ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия)) 
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Требуется заполнение поля 'Группа финансового учета доходов расходов' для проведения по ЕПС", ЭтотОбъект, "ГруппаФинансовогоУчетаДоходовРасходов", , Отказ);
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;
	
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(
																			ЭтотОбъект.Дата,
																			ЭтотОбъект.Организация,
																			ЭтотОбъект.СчетДоверительногоУправления);
			
	РаспределениеАктива = БухгалтерскийУчетЕПС.ПолучитьРаспределениеПоВидуАктива(Основания.Выгрузить(, "Основание"));
	
	ДолгПоКомиссииНаКонецДня = ПолучитьЗадолженностьПоКомиссииНаКонецДня_ЕПС();
	
	ТаблицаДоговоров = Новый ТаблицаЗначений;
	ТаблицаДоговоров.Колонки.Добавить("Договор", ПланыВидовХарактеристик.ВидыСубконто.Договоры.ТипЗначения);
	ТаблицаДоговоров.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	
	Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Начисление задолженности");
			
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
			Проводка.СубконтоДт.Контрагенты 		= ЭтотОбъект.Контрагент;
			Если ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда 
				Проводка.СубконтоДт.ОснованиеРасчетов	= ЭтотОбъект.Договор;
			КонецЕсли;	
			Проводка.ВалютаДт 						= ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаДт 				= СтрокаОснования.Сумма;			
			
			Проводка.СчетКт = ПланыСчетов.Единый.НайтиПоКоду(ГруппаФинансовогоУчетаДоходовРасходовПриПроведении.НомерСчетаБухгалтерскогоУчета);
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходовПриПроведении;
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Договор)
				И ЭтотОбъект.Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДоговорСтрахования")
				И ЗначениеЗаполнено(ЭтотОбъект.ДополнительнаяАналитика) Тогда
				Проводка.ДополнительнаяАналитикаДт = ЭтотОбъект.ДополнительнаяАналитика;
			КонецЕсли;
			
			Продолжить;
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль Тогда	
			
			Если НЕ ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходовПриПроведении) Тогда 
				ТаблицаГФУ = БухгалтерскийУчетЕПС.ПолучитьСчетГФУУчетногоАктиваЕПСИзПартии(СтрокаОснования.Основание.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, СтрокаОснования.ЦеннаяБумага);
				
				КоличествоВсего = ТаблицаГФУ.Итог("Количество");
				КоличествоСтрок = ТаблицаГФУ.Количество();
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				СуммаОстаток = СуммаОперации;
				
				Для инд = 0 По КоличествоСтрок-1 Цикл   					
					Если инд <> КоличествоСтрок-1 Тогда 
						СуммаПроводки = Окр(СуммаОперации/КоличествоВсего* ТаблицаГФУ[инд].Количество, 2);
						СуммаОстаток = СуммаОстаток - СуммаПроводки;
					Иначе
						СуммаПроводки = СуммаОстаток;
					КонецЕсли;	
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаПроводки, "Начисление задолженности по налогу на прибыль");
					
					Проводка.СчетДт = ТаблицаГФУ[инд].СчетУчетаРасходовОтОпераций;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ТаблицаГФУ[инд].АналитикаРасходовОтОпераций;
					Проводка.СубконтоДт.ЦенныеБумаги = СтрокаОснования.ЦеннаяБумага;  
					
					Проводка.СчетКт = ПланыСчетов.Единый.РасчетыПоНалогуНаПрибыль;
					
					Проводка.СубконтоКт.УровниБюджетов = ЭтотОбъект.УровеньБюджета;
					Проводка.СубконтоКт.НалоговыеОрганы = ЭтотОбъект.Контрагент;
					
				КонецЦикла;
			Иначе
				
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Начисление задолженности по налогу на прибыль");
					
				Проводка.СчетДт = ПланыСчетов.Единый.НайтиПоКоду(ГруппаФинансовогоУчетаДоходовРасходовПриПроведении.НомерСчетаБухгалтерскогоУчета);
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходовПриПроведении;
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаОснования.ЦеннаяБумага; 
					
				Проводка.СчетКт = ПланыСчетов.Единый.РасчетыПоНалогуНаПрибыль;
				
				Проводка.СубконтоКт.УровниБюджетов = ЭтотОбъект.УровеньБюджета;
				Проводка.СубконтоКт.НалоговыеОрганы = ЭтотОбъект.Контрагент;
				
			КонецЕсли;
			
			Продолжить;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
			И ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента")
			И НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытии Тогда
			
			СчетКомиссий = ПланыСчетов.Единый.Депозиты07;
			СчетРасчетов = ПланыСчетов.Единый.Депозиты05;
			СчетДепозитный	= СтрокаОснования.Основание.КредитныйИнструмент.БанковскийСчет;
			
			ГФУКомиссий = ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Комиссионные_расходы_затраты_по_сделке");//Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("31322"); // пока хардкод т.к. еще не устоялась ситуация
			
			СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(ГФУКомиссий.НомерСчетаБухгалтерскогоУчета); // именно доходов т.к. комиссии уменьшают доход
			
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			// Начисление
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Списание расходов");	
			
			
			Проводка.СчетДт = СчетУчетаДоходов;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаОснования.Основание.КредитныйИнструмент;
			
			
			Проводка.СчетКт = СчетРасчетов;
			
			Проводка.СубконтоКт.БанковскиеСчета = СчетДепозитный;
			Проводка.СубконтоКт.ДепозитныеВклады = СтрокаОснования.Основание.КредитныйИнструмент;
			
			Проводка.ВалютаКт = ЭтотОбъект.Валюта;
			Проводка.ВалютнаяСуммаКт = СуммаОперации;
			
			СтрокаОстаткаКомиссии = ДолгПоКомиссииНаКонецДня.Найти(СтрокаОснования.Основание, "Основание");
			Если СтрокаОстаткаКомиссии = Неопределено Тогда
				СуммаОперацииПризнания = СуммаОперации;
			Иначе
				СуммаОстаткаРасчетыВал = СтрокаОстаткаКомиссии.СуммаОстаток;
				СуммаОстаткаРасчеты = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаОстаткаРасчетыВал, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				
				СуммаОперацииПризнания = СуммаОперации - СуммаОстаткаРасчеты; // Определяем сумму оплаченного на конец текущего дня, на случай частичной оплаты.	
			КонецЕсли;
			
			Если СуммаОперацииПризнания > 0 Тогда
				// Признание
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииПризнания, "Списание расходов");	
				
				Проводка.СчетДт = СчетРасчетов;
				
				Проводка.СубконтоДт.БанковскиеСчета = СчетДепозитный;
				Проводка.СубконтоДт.ДепозитныеВклады = СтрокаОснования.Основание.КредитныйИнструмент;
				
				Проводка.ВалютаДт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаОперацииПризнания;
				
				
				Проводка.СчетКт = СчетКомиссий;
				
				Проводка.СубконтоКт.БанковскиеСчета = СчетДепозитный;
				Проводка.СубконтоКт.ДепозитныеВклады = СтрокаОснования.Основание.КредитныйИнструмент;
				
				Проводка.ВалютаКт = ЭтотОбъект.Валюта;
				Проводка.ВалютнаяСуммаКт = СуммаОперацииПризнания;
				
				
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииПризнания, "Списание расходов");	
					
					Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоДт.Договоры 	= ЭтотОбъект.СчетДоверительногоУправления;
					
					Проводка.СчетКт = СчетУчетаДоходов;
					
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
					Проводка.СубконтоКт.ЦенныеБумаги = СтрокаОснования.Основание.КредитныйИнструмент;
					
				КонецЕсли;	
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли; 		
		
		СтруктураПоискаУчетногоАктива = Новый  Структура("Сделка",СтрокаОснования.Основание);
		Если ЗначениеЗаполнено(СтрокаОснования.ЦеннаяБумага) Тогда
			СтруктураПоискаУчетногоАктива.Вставить("ЦеннаяБумага",СтрокаОснования.ЦеннаяБумага);
		КонецЕсли;
		РаспределениеТекущейЦБ = РаспределениеАктива.НайтиСтроки(СтруктураПоискаУчетногоАктива);
		
		ПриходНаСтоимостьЦБ = Ложь;
		ВидСделки = Перечисления.ВидыСделок.Покупка;
		
		ПроводитьЧерезРасчеты 	= Истина;
		СуммаЧерезРасчеты 		= 0;
		СуммаЧерезРасчетыВал 	= 0;
		
		ТекОснование = СтрокаОснования.Основание;
		Если ТипЗнч(ТекОснование) = Тип("ДокументСсылка.Сделка") ИЛИ ТипЗнч(ТекОснование) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			
			Если НастройкиУчета.ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты И ТекОснование.ОтложенноеИсполнение Тогда
				Продолжить;
			КонецЕсли;
			
			Если      ТипЗнч(СтрокаОснования.ЦеннаяБумага) = Тип("СправочникСсылка.Акции") Тогда
				Рынок = Перечисления.РынкиЦенныхБумаг.Акции;						
			ИначеЕсли ТипЗнч(СтрокаОснования.ЦеннаяБумага) = Тип("СправочникСсылка.Векселя") Тогда
				Рынок = Перечисления.РынкиЦенныхБумаг.Векселя;
			ИначеЕсли ТипЗнч(СтрокаОснования.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
				Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
			ИначеЕсли ТипЗнч(СтрокаОснования.ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
				Рынок = Перечисления.РынкиЦенныхБумаг.Паи;
			КонецЕсли;
			
			Если СтрокаОснования.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Иначе
				ВидСделки = Перечисления.ВидыСделок.Продажа;				
			КонецЕсли;
			СтрокаОстаткаКомиссии = ДолгПоКомиссииНаКонецДня.Найти(ТекОснование,"Основание");
			Если СтрокаОстаткаКомиссии = Неопределено Тогда
				ПроводитьЧерезРасчеты = Ложь;
			Иначе
				СуммаЧерезРасчетыВал 	= СтрокаОстаткаКомиссии.СуммаОстаток;
				СуммаЧерезРасчеты 		= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаЧерезРасчетыВал, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			КонецЕсли;
			
			Если ТипЗнч(ТекОснование) = Тип("ДокументСсылка.СделкаРЕПО") И НастройкиУчета.ОтражатьРасчетыПоРасходамПоРепоПоФактуОплаты Тогда
				ПроводитьЧерезРасчеты = Ложь;
			ИначеЕсли ТипЗнч(ТекОснование) = Тип("ДокументСсылка.Сделка") И НастройкиУчета.ПроводитьКомиссиюПоСделкамЧерезСчетаРасчетов Тогда
			    ПроводитьЧерезРасчеты = Истина;
				СуммаЧерезРасчетыВал 	= СтрокаОснования.Сумма;
				СуммаЧерезРасчеты 		= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаЧерезРасчетыВал, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			КонецЕсли;
			
		КонецЕсли;
		
		СуммаКомиссии = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.Сумма, ЭтотОбъект.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		ПараметрыКомиссии = Новый Структура("ЦБ, ВидСделки", СтрокаОснования.ЦеннаяБумага, ВидСделки);
		ПараметрыКомиссии.Вставить("СуммаКомисии", 			СтрокаОснования.Сумма);
		ПараметрыКомиссии.Вставить("ВалютаКомиссии", 		ЭтотОбъект.Валюта);
		ПараметрыКомиссии.Вставить("СуммаОперации", 		СуммаКомиссии);
		ПараметрыКомиссии.Вставить("ВидКомиссии", 			ЭтотОбъект.ВидЗадолженности);
		ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", 	ЭтотОбъект.Контрагент);
		
		// Методика Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО была сделана для счетов ДУ
		// "ГСК Югория АО" и "НПФ Достойное БУДУЩЕЕ  АО РОПС" 
		// клиенты были недовольны, что по торговой комиссии комиссии по РЕПО используются ОФР кредитных организаций (т.к. контрагент НЦК)
		// а по брокерской комиссии по РЕПО используются ОФР некредитных организаций (т.к. берется брокер БК)
		// и написали письма чтобы ОФРы были единые, поэтому теперь по сделкам РЕПО для этой методики берем контрагента по сделке РЕПО, а не брокера
		Если ТипЗнч(ТекОснование) = Тип("ДокументСсылка.СделкаРЕПО") 
			И НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО
			И ЗначениеЗаполнено(ТекОснование.Контрагент) Тогда
			ПараметрыКомиссии.Вставить("Контрагент", 	ТекОснование.Контрагент);
		КонецЕсли;
		
		ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость",	Ложь);
		ПараметрыКомиссии.Вставить("УчетныйАктив", 							Неопределено);
		ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",					Истина);
		ПараметрыКомиссии.Вставить("ПредварительныеЗатратыПоСделке",		Ложь);
		Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.Сделка")
			ИЛИ ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.СделкаРЕПО")
			ИЛИ ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
			ПараметрыКомиссии.Вставить("Сделка",			СтрокаОснования.Основание);
		КонецЕсли;
		ПараметрыКомиссии.Вставить("ПроводитьЧерезРасчеты",	ПроводитьЧерезРасчеты);
		ПараметрыКомиссии.Вставить("СуммаЧерезРасчеты",		СуммаЧерезРасчеты);
		ПараметрыКомиссии.Вставить("СуммаЧерезРасчетыВал",	СуммаЧерезРасчетыВал);
		
		Если НЕ ЗначениеЗаполнено(СтрокаОснования.Основание)
			ИЛИ (ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.Сделка")
			И ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.СделкаРЕПО"))
		Тогда
			ПараметрыКомиссии.Вставить("ЦБ",Неопределено);	
		Иначе
			
			ЭтоВнебиржеваяСделка = (СтрокаОснования.Основание.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок);
			
			Если НЕ СтрокаОснования.Основание.ОтложенноеИсполнение Тогда // Сделка Т0
				ОплатаВДеньПокупки = Истина;
				ПредварительныеЗатратыПоСделке = Ложь;
			ИначеЕсли НЕ ЭтоВнебиржеваяСделка Тогда // Сделка Т+
				ОплатаВДеньПокупки = (НачалоДня(СтрокаОснования.Основание.Дата) = НачалоДня(СтрокаОснования.ДатаОплаты));
				ПредварительныеЗатратыПоСделке = (НачалоДня(СтрокаОснования.Основание.ДатаИсполнения) > НачалоДня(ЭтотОбъект.Дата));
			Иначе // внебиржевая сделка
				ОплатаВДеньПокупки = (НачалоДня(СтрокаОснования.Основание.Дата) = НачалоДня(СтрокаОснования.ДатаОплаты));
				ПредварительныеЗатратыПоСделке = (НачалоДня(СтрокаОснования.Основание.ДатаПоставки) > НачалоДня(ЭтотОбъект.Дата));
			КонецЕсли;
			
			ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",				ОплатаВДеньПокупки);
			ПараметрыКомиссии.Вставить("ПредварительныеЗатратыПоСделке",	ПредварительныеЗатратыПоСделке);
		КонецЕсли;
		ПараметрыКомиссии.Вставить("ГруппаФинансовогоУчетаДоходовРасходов", ГруппаФинансовогоУчетаДоходовРасходовПриПроведении);
		
		Если РаспределениеТекущейЦБ.Количество() = 0 Тогда
			Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии 
				 ИЛИ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия) Тогда
				ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", Договор);
			ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии 
				ИЛИ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
				ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", РасчетныйСчет.Договор);
			ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего
				ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
				ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", СчетДоверительногоУправления);
			ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий Тогда
				ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", СчетДоверительногоУправления);
			ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимУслугам Тогда
				ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", СчетДоверительногоУправления);
			ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
	
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
					|ИЗ
					|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров КАК РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
					|		ПО РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
					|ГДЕ
					|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания.ДатаЗаключения <= &ТекущаяДата
					|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
					|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
					|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ТекущаяДата)
					|	И РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.СчетДоверительногоУправления = &СчетДоверительногоУправления
					|	И РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.Брокер.ЮрФизЛицо = &ЮрФизЛицоБрокера";
				
				Запрос.УстановитьПараметр("ЮрФизЛицоБрокера", Контрагент);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(Дата));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				Если РезультатЗапроса.Пустой() Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден действующий договор с брокером "+Контрагент,,,,Отказ);
					Возврат;
				КонецЕсли;
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ПараметрыКомиссии.Вставить("ДоговорПоКомиссии", ВыборкаДетальныеЗаписи.ДоговорБрокерскогоОбслуживания);
				КонецЦикла;
				
			КонецЕсли;
			
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.СделкаСПФИ") Тогда
				ПараметрыКомиссии.Вставить("Сделка", СтрокаОснования.Основание);
			КонецЕсли;
			
			БухгалтерскийУчетЕПС.НачислитьКомиссию(ЭтотОбъект,ПараметрыКомиссии,Отказ);
			
			НоваяСтрока = ТаблицаДоговоров.Добавить();
			НоваяСтрока.Договор = ПараметрыКомиссии.ДоговорПоКомиссии;
			НоваяСтрока.Сумма = СтрокаОснования.Сумма;			
			
		Иначе
			СуммаКомиссииКРаспределению = ПараметрыКомиссии.СуммаКомисии;
			СуммаОперацииКРаспределению = ПараметрыКомиссии.СуммаОперации;
			СуммаЧерезРасчетыКРаспределению			= ПараметрыКомиссии.СуммаЧерезРасчеты;
			СуммаЧерезРасчетыВалКРаспределению		= ПараметрыКомиссии.СуммаЧерезРасчетыВал;
			
			КоличествоПоСделке = 0;
			Для Каждого СтрокаРаспределенияТекущейЦБ Из РаспределениеТекущейЦБ Цикл
				КоличествоПоСделке = КоличествоПоСделке + СтрокаРаспределенияТекущейЦБ.Количество;
			КонецЦикла;
			
			Для Каждого СтрокаРаспределенияТекущейЦБ Из РаспределениеТекущейЦБ Цикл
				ТекКоличество = СтрокаРаспределенияТекущейЦБ.Количество;
				СуммаКомиссии = Окр(СуммаКомиссииКРаспределению * ТекКоличество / КоличествоПоСделке,2);
				СуммаОперации = Окр(СуммаОперацииКРаспределению * ТекКоличество / КоличествоПоСделке,2);
				СуммаЧерезРасчеты = Окр(СуммаЧерезРасчетыКРаспределению * ТекКоличество / КоличествоПоСделке,2);
				СуммаЧерезРасчетыВал = Окр(СуммаЧерезРасчетыВалКРаспределению * ТекКоличество / КоличествоПоСделке,2);
				
				Если СтрокаРаспределенияТекущейЦБ.УчетныйАктивЕПС = Неопределено Тогда
					ПараметрыКомиссии.ВключатьРасходыПоПокупкеВСтоимость = Ложь;
				Иначе
					ПараметрыКомиссии.ВключатьРасходыПоПокупкеВСтоимость = СтрокаРаспределенияТекущейЦБ.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость;
				КонецЕсли;
				
				ПараметрыКомиссии.СуммаКомисии 	= СуммаКомиссии;
				ПараметрыКомиссии.СуммаОперации = СуммаОперации;
				ПараметрыКомиссии.СуммаЧерезРасчеты = СуммаЧерезРасчеты;
				ПараметрыКомиссии.СуммаЧерезРасчетыВал = СуммаЧерезРасчетыВал;
				ПараметрыКомиссии.УчетныйАктив 	= СтрокаРаспределенияТекущейЦБ.УчетныйАктивЕПС;
				ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",	НачалоДня(СтрокаОснования.ДатаОплаты)=НачалоДня(ЭтотОбъект.Дата));
				
				БухгалтерскийУчетЕПС.НачислитьКомиссию(ЭтотОбъект,ПараметрыКомиссии,Отказ);
			
				КоличествоПоСделке = КоличествоПоСделке - ТекКоличество;
				СуммаКомиссииКРаспределению = СуммаКомиссииКРаспределению - СуммаКомиссии;
				СуммаОперацииКРаспределению = СуммаОперацииКРаспределению - СуммаОперации;
				СуммаЧерезРасчетыКРаспределению = СуммаЧерезРасчетыКРаспределению - СуммаЧерезРасчеты;
				СуммаЧерезРасчетыВалКРаспределению = СуммаЧерезРасчетыВалКРаспределению - СуммаЧерезРасчетыВал;
			КонецЦикла;
		КонецЕсли; 
		
	КонецЦикла;
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
	ТаблицаДоговоров.Свернуть("Договор", "Сумма");
	
	Если (ТаблицаДоговоров.Количество() > 0) И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		
		ТаблицаДоговоров.Колонки.Добавить("Контрагент", ПланыВидовХарактеристик.ВидыСубконто.Контрагенты.ТипЗначения);
		ТаблицаДоговоров.ЗаполнитьЗначения(ЭтотОбъект.Контрагент, "Контрагент");
		
		ПараметрыЗакрытияРасходов = Новый Структура;
		ПараметрыЗакрытияРасходов.Вставить("ВалютаОперации", ЭтотОбъект.Валюта);
		ПараметрыЗакрытияРасходов.Вставить("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
		ПараметрыЗакрытияРасходов.Вставить("ТаблицаДоговоров", ТаблицаДоговоров);
		ПараметрыЗакрытияРасходов.Вставить("ГруппаФинансовогоУчетаДоходовРасходов", ГруппаФинансовогоУчетаДоходовРасходовПриПроведении);
		
		БухгалтерскийУчетЕПС.ЗакрытьРасходы(ЭтотОбъект, ПараметрыЗакрытияРасходов, Отказ);
	
	КонецЕсли; 

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	// Получение списка проводок вынесено в модуль менеджера
	НаборПроводок = Документы.НачислениеЗадолженности.ПодготовитьНаборПроводок(
		ЭтотОбъект.Ссылка, 
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ВидЗадолженности, 
		УчетныйРегистр, 
		Отказ, Истина);
				
	Если Отказ ИЛИ НаборПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗПроводок = НаборПроводок.Выгрузить();
	ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Ссылка, "Регистратор");
	Движения[УчетныйРегистр].Загрузить(ТЗПроводок);         	
	
	Движения[УчетныйРегистр].Записать();

	#Область ПроверкаОтрицательныхОстатков
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МассивТиповОснований = Новый Массив;
	МассивТиповОснований.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	МассивТиповОснований.Добавить(Тип("СправочникСсылка.Договоры"));
	МассивТиповОснований.Добавить(Тип("ДокументСсылка.СчетФактура"));
	
	ТЗОснованияБУ = Новый ТаблицаЗначений;
	ТЗОснованияБУ.Колонки.Добавить("Основание", Новый ОписаниеТипов(МассивТиповОснований));
	
	ТипЗадолженности = Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности);
	
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", 						Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодДата", 					ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Контрагент", 					ЭтотОбъект.Контрагент);
	Запрос.УстановитьПараметр("Договор", 						ЭтотОбъект.Договор); 
	Запрос.УстановитьПараметр("ТипЗадолженности", 				ТипЗадолженности); 
	
	СчетаДляПроверкиОтрицательныхОстатков = Новый Массив;
	
	//проверка отрицательных остатков по авансам
	СтрокаОснование = ТЗОснованияБУ.Добавить();
	СтрокаОснование.Основание = ?(ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Договор);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТЗОснованияБУ, "_ОснованияБУ", Запрос.МенеджерВременныхТаблиц);
	
	Если ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
		СчетаДляПроверкиОтрицательныхОстатков.Добавить(ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные);
	Иначе
		СчетаДляПроверкиОтрицательныхОстатков.Добавить(ПланыСчетов.Основной.РасчетыПоАвансамВыданным);
	КонецЕсли;
	
	ПроверитьОтрицательныеОстаткиБУ(Запрос, СчетаДляПроверкиОтрицательныхОстатков, УчетныйРегистр, Отказ);
	
	//проверка отрицательных остатков по НДС по авансам
	
	Запрос.Текст = 
	"УНИЧТОЖИТЬ _ОснованияБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактура.Ссылка КАК Основание
	|ПОМЕСТИТЬ _ОснованияБУ
	|ИЗ
	|	Документ.СчетФактура КАК СчетФактура
	|ГДЕ
	|	СчетФактура.Контрагент = &Контрагент
	|	И СчетФактура.Договор = &Договор
	|	И СчетФактура.Организация = &Организация
	|	И СчетФактура.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И СчетФактура.Дата <= &ПериодДата";
	
	Запрос.Выполнить();
	
	СчетаДляПроверкиОтрицательныхОстатков.Очистить();
	Если ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
		СчетаДляПроверкиОтрицательныхОстатков.Добавить(ПланыСчетов.Основной.НДСПоАвансамПолученным);
	Иначе
		СчетаДляПроверкиОтрицательныхОстатков.Добавить(ПланыСчетов.Основной.НДСПоАвансамВыданным);
	КонецЕсли;
	
	ПроверитьОтрицательныеОстаткиБУ(Запрос, СчетаДляПроверкиОтрицательныхОстатков, УчетныйРегистр, Отказ);
	
	//проверка отрицательных остатков по оценочным задолженностям
	
	Запрос.Текст = 
	"УНИЧТОЖИТЬ _ОснованияБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НачислениеЗадолженности.Ссылка КАК Основание
	|ПОМЕСТИТЬ _ОснованияБУ
	|ИЗ
	|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
	|ГДЕ
	|	НачислениеЗадолженности.Контрагент = &Контрагент
	|	И НачислениеЗадолженности.Договор = &Договор
	|	И НачислениеЗадолженности.Организация = &Организация
	|	И НачислениеЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И НачислениеЗадолженности.Предварительно
	|	И НачислениеЗадолженности.Дата <= &ПериодДата";
	
	Запрос.Выполнить();
	
	СчетаДляПроверкиОтрицательныхОстатков.Очистить();
	СчетаДляПроверкиОтрицательныхОстатков.Добавить(ПланыСчетов.Основной.ОценочныеЗадолженности);
	
	ПроверитьОтрицательныеОстаткиБУ(Запрос, СчетаДляПроверкиОтрицательныхОстатков, УчетныйРегистр, Отказ);
	
	#КонецОбласти
КонецПроцедуры

Процедура ПроверитьОтрицательныеОстаткиБУ(Запрос, Счета, УчетныйРегистр, Отказ)
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АвансОстатки.Счет КАК Счет,
	|	АвансОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоАвансамВыданным), ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные)) КАК ЭтоАвансы,
	|	АвансОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.НДСПоАвансамВыданным), ЗНАЧЕНИЕ(ПланСчетов.Основной.НДСПоАвансамПолученным)) КАК ЭтоНДСПоАвансам,
	|	АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ОценочныеЗадолженности) КАК ЭтоОценочнаяЗадолженность,
	|	АвансОстатки.Субконто2 КАК Основание,
	|	АвансОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	АвансОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	|	АвансОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
	|			&Период,
	|			Счет В (&Счета),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто1 = &Контрагент
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						_ОснованияБУ.Основание
	|					ИЗ
	|						_ОснованияБУ КАК _ОснованияБУ)) КАК АвансОстатки
	|ГДЕ
	|	ВЫБОР
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоАвансамВыданным)
	|			ТОГДА АвансОстатки.СуммаОстаток < 0
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные)
	|			ТОГДА АвансОстатки.СуммаОстаток > 0
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НДСПоАвансамПолученным)
	|			ТОГДА АвансОстатки.СуммаОстатокДт < 0
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НДСПоАвансамВыданным)
	|			ТОГДА АвансОстатки.СуммаОстатокКт < 0
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ОценочныеЗадолженности)
	|				И &ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	|			ТОГДА АвансОстатки.СуммаОстаток > 0
	|		КОГДА АвансОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ОценочныеЗадолженности)
	|				И &ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	|			ТОГДА АвансОстатки.СуммаОстаток < 0
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Счета", Счета);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ЭтоАвансы Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма зачитываемого аванса больше, чем в БЭКОФИСЕ. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,,Отказ);
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.ЭтоНДСПоАвансам Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма зачитываемого авансового НДС (" + ВыборкаДетальныеЗаписи.Основание + ") больше, чем в БЭКОФИСЕ. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,,Отказ);
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.ЭтоОценочнаяЗадолженность Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма зачитываемой сторнированной оценочной задолженности (" + ВыборкаДетальныеЗаписи.Основание + ") больше, чем в БЭКОФИСЕ. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,,Отказ);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьЗадолженностьПоКомиссииНаКонецДня_ЕПС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Сделка
		|ПОМЕСТИТЬ _ТаблицаСделок
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&КонецДня,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ТаблицаСделок.Сделка
		|					ИЗ
		|						_ТаблицаСделок КАК _ТаблицаСделок)) КАК ЗадолженностиПоДенежнымСредствамОстатки";
	
	Запрос.УстановитьПараметр("КонецДня", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция НуженВходящийДокумент() Экспорт
	
	Возврат Не ЭтотОбъект.Предварительно 
		И НЕ Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ЭтотОбъект.ВидЗадолженности);
			
КонецФункции
