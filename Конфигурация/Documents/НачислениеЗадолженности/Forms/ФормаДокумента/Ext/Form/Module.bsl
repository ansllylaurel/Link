КонецФункции

&НаКлиенте
Функция СформироватьСтруктуруПараметровРасчета(Отказ)
	
	СтруктураПараметров = Новый Структура();
	
	ЕдиницыИзмерения = ПолучитьЕдиницыИзмерениеНаСервере(); 
	
	Для Каждого ТекущаяСтрока Из Объект.Основания Цикл
	
		Если Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНалогуНаИмущество") Тогда
			
			СтруктураПараметровРасчета = Новый Структура();
			СтруктураПараметровРасчета.Вставить("СтавкаНалога", 				ТекущаяСтрока.СтавкаНалога);
			СтруктураПараметровРасчета.Вставить("БазаНалога", 					ТекущаяСтрока.БазаНалога);
			СтруктураПараметровРасчета.Вставить("АвансПоНалогу", 				ТекущаяСтрока.АвансПоНалогу);
			СтруктураПараметровРасчета.Вставить("РасчетПоКадастровойСтоимости", ТекущаяСтрока.РасчетПоКадастровойСтоимости);
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ОбъектРасчетаНалогаНаИмущество) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Объект расчета налога в строке " + ТекущаяСтрока.ИсходныйНомерСтроки + " не заполнен!", 
						Объект.Ссылка, 
						"Основания[" + (ТекущаяСтрока.ИсходныйНомерСтроки - 1) + "].ОбъектРасчетаНалогаНаИмущество", 
						"Объект", 
						Отказ);
			Иначе
				Если ТипЗнч(ТекущаяСтрока.ОбъектРасчетаНалогаНаИмущество) = Тип("Строка") Тогда
					СтруктураПараметровРасчета.Вставить("КодОКТМО", 				ТекущаяСтрока.ОбъектРасчетаНалогаНаИмущество);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Объект расчета налога в строке " + ТекущаяСтрока.ИсходныйНомерСтроки + " должен содержать код ОКТМО!", 
						Объект.Ссылка, 
						"Основания[" + (ТекущаяСтрока.ИсходныйНомерСтроки - 1) + "].ОбъектРасчетаНалогаНаИмущество", 
						"Объект", 
						Отказ);
				КонецЕсли;
			КонецЕсли;
			
			СтруктураПараметров.Вставить("РасчетНалога", СтруктураПараметровРасчета);
			
		ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть") Тогда
			
			СтруктураПараметровКоммунальныхУслуг = Новый Структура();
			СтруктураПараметровКоммунальныхУслуг.Вставить("Количество", 			ТекущаяСтрока.Количество);
			СтруктураПараметровКоммунальныхУслуг.Вставить("Описание", 				ТекущаяСтрока.Описание);
			СтруктураПараметровКоммунальныхУслуг.Вставить("ЕдиницаИзмерения", 		ТекущаяСтрока.ЕдиницаИзмерения);
			СтруктураПараметровКоммунальныхУслуг.Вставить("ЕдиницаИзмеренияКод", 	ТекущаяСтрока.ЕдиницаИзмеренияКод);
			
			СтруктураПараметров.Вставить("КоммунальныеУслуги", СтруктураПараметровКоммунальныхУслуг);
			
		КонецЕсли;
		
		ТекущаяСтрока.Содержание = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураПараметров);
		
	КонецЦикла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоНалог(ВидЗадолженности)
	Возврат ЗначениеЗаполнено(ВидЗадолженности) И ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Налоги);
КонецФункции

&НаСервере
Процедура ПолучитьПараметрыСтрокиОснованияНаСервере(ТекущаяСтрока)
	
	ДополнительныеДанные = Документы.НачислениеЗадолженности.ПолучитьДополнительныеДанныеИзСодержания(ТекущаяСтрока.Содержание);
	
	Если Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество Тогда
		РасчетНалога = Неопределено;
		Если ДополнительныеДанные <> Неопределено И ДополнительныеДанные.Свойство("РасчетНалога", РасчетНалога) Тогда
			РасчетНалога.Свойство("СтавкаНалога", ТекущаяСтрока.СтавкаНалога);
			РасчетНалога.Свойство("БазаНалога", ТекущаяСтрока.БазаНалога);
			РасчетНалога.Свойство("АвансПоНалогу", ТекущаяСтрока.АвансПоНалогу);
			РасчетНалога.Свойство("РасчетПоКадастровойСтоимости", ТекущаяСтрока.РасчетПоКадастровойСтоимости);
			РасчетНалога.Свойство("КодОКТМО", ТекущаяСтрока.ОбъектРасчетаНалогаНаИмущество);
		КонецЕсли;
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть Тогда
		КоммунальныеУслуги = Неопределено;
		Если ДополнительныеДанные = Неопределено Тогда
			ТекущаяСтрока.Описание = ТекущаяСтрока.Содержание;
		ИначеЕсли ДополнительныеДанные.Свойство("КоммунальныеУслуги", КоммунальныеУслуги) Тогда
			КоммунальныеУслуги.Свойство("Количество", ТекущаяСтрока.Количество);
			КоммунальныеУслуги.Свойство("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
			КоммунальныеУслуги.Свойство("ЕдиницаИзмеренияКод", ТекущаяСтрока.ЕдиницаИзмеренияКод);
			КоммунальныеУслуги.Свойство("Описание", ТекущаяСтрока.Описание);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеКолонкиНаСервере()
	
	Если Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество Тогда
		
		Если Элементы.Найти("ОснованияБазаНалога") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("БазаНалога", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(19,2)), "Объект.Основания", "База налога", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияБазаНалога", Тип("ПолеФормы"), Элементы.Основания); 
			Элементы.Переместить(нЭлемент, Элементы.Основания, Элементы.ОснованияСумма);
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.БазаНалога"; 
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияБазаИСтавкаНалогаПриИзменении");
	    КонецЕсли;
		
		Если Элементы.Найти("ОснованияСтавкаНалога") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("СтавкаНалога", Новый ОписаниеТипов("Число"), "Объект.Основания", "Ставка налога", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияСтавкаНалога", Тип("ПолеФормы"), Элементы.Основания); 
			Элементы.Переместить(нЭлемент, Элементы.Основания, Элементы.ОснованияСумма);
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.СтавкаНалога"; 
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияБазаИСтавкаНалогаПриИзменении");
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияАвансПоНалогу") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("АвансПоНалогу", Новый ОписаниеТипов("Число"), "Объект.Основания", "Аванс по налогу", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияАвансПоНалогу", Тип("ПолеФормы"), Элементы.Основания); 
			Элементы.Переместить(нЭлемент, Элементы.Основания, Элементы.ОснованияСумма);
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.АвансПоНалогу"; 
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияБазаИСтавкаНалогаПриИзменении");
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияОбъектРасчетаНалогаНаИмущество") = Неопределено Тогда 
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("Строка"));
			
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("ОбъектРасчетаНалогаНаИмущество", Новый ОписаниеТипов(МассивТипов,,,,Новый КвалификаторыСтроки(11)), "Объект.Основания", "Объект расчета", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияОбъектРасчетаНалогаНаИмущество", Тип("ПолеФормы"), Элементы.Основания); 
			Элементы.Переместить(нЭлемент, Элементы.Основания, Элементы.ОснованияБазаНалога);
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.ОбъектРасчетаНалогаНаИмущество"; 
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияОбъектРасчетаНалогаНаИмуществоПриИзменении");
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияРасчетПоКадастровойСтоимости") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("РасчетПоКадастровойСтоимости", Новый ОписаниеТипов("Булево"), "Объект.Основания", "По кадастровой стоимости", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияРасчетПоКадастровойСтоимости", Тип("ПолеФормы"), Элементы.Основания); 
			Элементы.Переместить(нЭлемент, Элементы.Основания, Элементы.ОснованияБазаНалога);
			нЭлемент.Вид = ВидПоляФормы.ПолеФлажка; 
			нЭлемент.ПутьКДанным = "Объект.Основания.РасчетПоКадастровойСтоимости"; 
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияРасчетПоКадастровойСтоимостиПриИзменении");
		КонецЕсли;
		
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть И Не Объект.Предварительно Тогда
		
		Если Элементы.Найти("ОснованияКоличество") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("Количество", Новый ОписаниеТипов("Число"), "Объект.Основания", "Количество", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияКоличество", Тип("ПолеФормы"), Элементы.Основания); 
			нЭлемент.АвтоМаксимальнаяШирина = Ложь;
			нЭлемент.МаксимальнаяШирина = 10;
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.Количество"; 
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияЕдиницаИзмерения") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("ЕдиницаИзмерения", Новый ОписаниеТипов("Строка"), "Объект.Основания", "Единица измерения", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияЕдиницаИзмерения", Тип("ПолеФормы"), Элементы.Основания); 
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.АвтоМаксимальнаяШирина = Ложь;
			нЭлемент.МаксимальнаяШирина = 6;
			нЭлемент.ПутьКДанным = "Объект.Основания.ЕдиницаИзмерения"; 
			нЭлемент.РежимВыбораИзСписка = Истина;
			нЭлемент.СписокВыбора.Очистить();
			СписокЕдиницИзмерения = Документы.НачислениеЗадолженности.ПолучитьСписокЕдиницИзмерения();
			Для Каждого Единица Из СписокЕдиницИзмерения Цикл
				нЭлемент.СписокВыбора.Добавить(Единица.Значение, Единица.Представление);
			КонецЦикла;
			нЭлемент.УстановитьДействие("ПриИзменении", "ОснованияЕдиницаИзмеренияПриИзменении");
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияЕдиницаИзмеренияКод") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("ЕдиницаИзмеренияКод", Новый ОписаниеТипов("Строка"), "Объект.Основания", "Код единицы измерения", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияЕдиницаИзмеренияКод", Тип("ПолеФормы"), Элементы.Основания); 
			нЭлемент.ПутьКДанным = "Объект.Основания.ЕдиницаИзмеренияКод"; 
			нЭлемент.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.Найти("ОснованияОписание") = Неопределено Тогда 
			нРеквизиты = Новый Массив;
			нРеквизиты.Добавить(Новый РеквизитФормы("Описание", Новый ОписаниеТипов("Строка"), "Объект.Основания", "Описание", Истина));
			ИзменитьРеквизиты(нРеквизиты);
			
			нЭлемент = Элементы.Добавить("ОснованияОписание", Тип("ПолеФормы"), Элементы.Основания); 
			нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			нЭлемент.ПутьКДанным = "Объект.Основания.Описание"; 
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Документы.НачислениеЗадолженности.СодержаниеИспользуетсяДляХраненияДанных(Объект.ВидЗадолженности) Тогда
		Для Каждого Строка из Объект.Основания Цикл
			ТекущаяСтрока = Строка;
			ПолучитьПараметрыСтрокиОснованияНаСервере(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте 
Процедура РассчитатьСуммуНалога(ТекущиеДанные)
	
	ТекущиеДанные.Сумма = Окр(ТекущиеДанные.БазаНалога * ТекущиеДанные.СтавкаНалога/100, 0) - ТекущиеДанные.АвансПоНалогу;
	
КонецПроцедуры	

&НаСервере 
Функция ПолучитьОбъектНедвижимостиПоОКТМОНаСервере(Организация, СчетДоверительногоУправления, КодОКТМО, Период)
	
	Возврат Справочники.ОбъектыНедвижимости.ПолучитьОбъектИмуществаДляКодаОКТМО(
		Организация, 
		СчетДоверительногоУправления, 
		КодОКТМО, 
		Период);
	
КонецФункции 

#Область Работа_с_переключателями_отправителя_и_получателя

&НаСервереБезКонтекста
Функция ОпределитьЗначениеПереключателя(Брокер, МестоХранения)

	Если ЗначениеЗаполнено(Брокер) Тогда
		Возврат ЗначениеПереключателяБрокер();
	ИначеЕсли МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
		Возврат ЗначениеПереключателяБиржа();
	Иначе
		Возврат ЗначениеПереключателяПрямая();
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеПереключателяПрямая()
	Возврат 0;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеПереключателяБрокер()
	Возврат 1;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеПереключателяБиржа()
	Возврат 2;
КонецФункции

&НаКлиенте
Процедура ВозмещениеПоАрендеПриИзменении(Элемент)
	
	Если Не ВозмещениеПоАренде Тогда
		Объект.Арендатор = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
		Объект.ДоговорАренды = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
		Объект.ДатаОплатыАренды = '00010101';
	КонецЕсли;	
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры 

&НаКлиенте
Процедура ДополнительныйДокументПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДополнительногоДокументаПриИзменении(Элемент)
	
	Если Не Объект.Ссылка.Пустая() Тогда	
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "ВидДополнительногоДокумента", ЭтаФорма.ВидДополнительногоДокумента);					
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерДополнительногоДокументаПриИзменении(Элемент)
	
	Если Не Объект.Ссылка.Пустая() Тогда	
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "НомерДополнительногоДокумента", ЭтаФорма.НомерДополнительногоДокумента);					
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДополнительногоДокументаПриИзменении(Элемент)
	
	Если Не Объект.Ссылка.Пустая() Тогда	
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "ДатаДополнительногоДокумента", ЭтаФорма.ДатаДополнительногоДокумента);					
	Конецесли;
	
КонецПроцедуры
		
#КонецОбласти

&НаСервереБезКонтекста
Функция РедактируемыеДополнительныеСведения()
	
	ВариантыКлюча = Новый Массив;
	ВариантыКлюча.Добавить("НомерАктаВыданного");
	ВариантыКлюча.Добавить("НомерСчетаВыданного");
	ВариантыКлюча.Добавить("ВидДополнительногоДокумента");
	ВариантыКлюча.Добавить("НомерДополнительногоДокумента");
	ВариантыКлюча.Добавить("ДатаДополнительногоДокумента");

    Возврат ВариантыКлюча;

КонецФункции

#КонецОбласти
