
#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Свойство("ПараметрыПерезаполнения") Тогда // перезаполним документ на основании
		ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		ОбъектНаСервере.Основания.Очистить();
		ОбъектНаСервере.Заполнить(ЭтаФорма.Параметры.ПараметрыПерезаполнения.Основание);
		
		ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьПодтверждениеОперацииНаСервере();
	
	Если ПараметрыЗаписи.Свойство("НомерАктаВыданногоВДопСведения") Тогда
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "НомерАктаВыданного", ЭтаФорма.НомерАктаВыданного);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("НомерСчетаВыданногоВДопСведения") Тогда
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "НомерСчетаВыданного", ЭтаФорма.НомерСчетаНаОплатуВыданного);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("ВидДополнительногоДокументаВДопСведения") Тогда
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "ВидДополнительногоДокумента", ЭтаФорма.ВидДополнительногоДокумента);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("НомерДополнительногоДокументаВДопСведения") Тогда
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "НомерДополнительногоДокумента", ЭтаФорма.НомерДополнительногоДокумента);	
	КонецЕсли;
	
	Если ПараметрыЗаписи.Свойство("ДатаДополнительногоДокументаВДопСведения") Тогда
		ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Объект.Ссылка, "ДатаДополнительногоДокумента", ЭтаФорма.ДатаДополнительногоДокумента);
	КонецЕсли;
	
	ЗаполнитьДополнительныеКолонкиНаСервере();// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();

	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ДатаОплатыВТабличнойЧасти(Объект.ВидЗадолженности) Тогда
		Для Каждого СтрокаОснования Из Объект.Основания Цикл
			СтрокаОснования.ДатаОплаты = ПлановаяДатаОплаты;
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.НомерАктаВыданного) Тогда
			ПараметрыЗаписи.Вставить("НомерАктаВыданногоВДопСведения");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.НомерСчетаНаОплатуВыданного) Тогда
			ПараметрыЗаписи.Вставить("НомерСчетаВыданногоВДопСведения");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.ВидДополнительногоДокумента) Тогда
			ПараметрыЗаписи.Вставить("ВидДополнительногоДокументаВДопСведения");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.НомерДополнительногоДокумента) Тогда
			ПараметрыЗаписи.Вставить("НомерДополнительногоДокументаВДопСведения");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.ДатаДополнительногоДокумента) Тогда
			ПараметрыЗаписи.Вставить("ДатаДополнительногоДокументаВДопСведения");
		КонецЕсли;
				
	Иначе
		
		ПоручениеСсылка = РаботаСДокументами.ПолучитьПодчиненныйДокументПоручениеНаВыводАктивов(Объект);
			
		Если ПоручениеСсылка <> Неопределено 
			И (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
				Или Не РаботаСДокументами.ЗначенияРеквизитовСоответствуютОснованиюПоручения(ПоручениеСсылка, ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "СчетДоверительногоУправления, ВидЗадолженности, Брокер, Валюта, МестоХранения, Основания"), Ложь)) Тогда
		
			Если Вопрос("На основании начисления задолженности сформировано поручение на движение денежных средств.
						|Поручение будет отменено. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда 
			
				РаботаСБизнесПроцессамиИЗадачами.ЗавершитьБизнесПроцессИОтменитьПоручение(Объект.Организация, ПоручениеСсылка, Отказ); 
			Иначе
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
					
	КонецЕсли;		
				
	ТекущийОбъект = Объект;
	
	Если СодержаниеИспользуетсяДляХраненияДанных(ТекущийОбъект.ВидЗадолженности) Тогда
		СформироватьСтруктуруПараметровРасчета(Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ОплатаЧерезБрокера = ЗначениеПереключателяБрокер() И Не ЗначениеЗаполнено(Объект.Брокер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Брокер"" не заполнено",, "Объект.Брокер",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РасчетныйСчет)
		И ЭтаФорма.ДетализацияПоРасчетномуСчету
		И ЭтаФорма.ОплатаЧерезБрокера <> ЗначениеПереключателяБиржа()
		И Объект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Расчетный счет"" не заполнено",, "Объект.РасчетныйСчет",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ВходящийДокумент Тогда
		Если Не ЗначениеЗаполнено(Объект.ВидВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вид входящего документа"" не заполнено",, "Объект.ВидВходящегоДокумента",, Отказ);
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(Объект.НомерВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Номер входящего документа"" не заполнено",, "Объект.НомерВходящегоДокумента",, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ДатаВходящегоДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата входящего документа"" не заполнено",, "Объект.ДатаВходящегоДокумента",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтаФорма.ВозмещениеПоАренде И Не ЗначениеЗаполнено(Объект.Арендатор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Арендатор"" при возмещении по аренде не заполнено",, "Объект.Арендатор",, Отказ);
	КонецЕсли;
	
	ТекстСообщения = "";
    
	Если Справочники.ВидыЗадолженности.ТребуетсяУказаниеПериодаНачисленияЗадолженности(
				Объект.Организация,
				Объект.ВидЗадолженности,
				Объект.Дата,
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"))
		И Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ПериодНачисления,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "ПериодНачисления", Отказ); 	
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);

	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.ОплатаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		УстановитьПлановуюДатуОплаты();
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаЧерезБрокераПриИзменении(Элемент)
	
	Объект.Брокер		 = Неопределено;
	Объект.МестоХранения = Неопределено;
	
	Если ЭтаФорма.ОплатаЧерезБрокера = ЗначениеПереключателяБиржа() Тогда
		Объект.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ММВБ_ДепозитыСЦК");
	КонецЕсли;
		
	БрокерПриИзменении(Неопределено);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура МестоХраненияПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	
	Если Объект.Основания.Количество() > 0 Тогда
		Если Вопрос("Табличная часть документа будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.Основания.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьДополнительныеКолонкиНаСервере();
	
	Если Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего")
		ИЛИ Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.НеобходимыеРасходыУправляющего")
	Тогда
		Объект.Контрагент 	 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо");
		Объект.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок");
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Объект.ПрочиеДоходыИРасходы)  Тогда
		Объект.ПрочиеДоходыИРасходы = ПолучитьПрочиеДоходыИРасходы(Объект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
	    Объект.ГруппаФинансовогоУчетаДоходовРасходов = ПолучитьГруппуФинансовогоУчетаДоходовРасходов(
															Объект.Дата,
															Объект.Организация,
															Объект.СчетДоверительногоУправления,
															Объект.ВидЗадолженности,
															Объект.ПрочиеДоходыИРасходы);
	КонецЕсли;	
	
	Элементы.ОснованияДатаОплаты.Заголовок = "Дата оплаты " + НРег(Объект.ВидЗадолженности);
	
	УстановитьСвойстваНДСНаСервере();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Объект.ДополнительнаяАналитика = ПолучитьДополнительнуюАналитику(Объект.Договор);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ЭтаФорма.ДепозитарийКонтрагента = ПолучитьДепозитарийКонтрагента(Объект.Контрагент);
	ОбновитьКППНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период = Новый СтандартныйПериод(Объект.НачалоПериодаНачисления, Объект.ОкончаниеПериодаНачисления);
    
	Если Диалог.Редактировать() Тогда
		ЭтаФорма.ПериодНачисления.ДатаНачала	= Диалог.Период.ДатаНачала;
		ЭтаФорма.ПериодНачисления.ДатаОкончания	= Диалог.Период.ДатаОкончания;
		
		ПериодНачисленияПриИзменении(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодНачисленияПриИзменении(Элемент)

	Объект.НачалоПериодаНачисления		= ЭтаФорма.ПериодНачисления.ДатаНачала;
	Объект.ОкончаниеПериодаНачисления	= ЭтаФорма.ПериодНачисления.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящийДокументПриИзменении(Элемент)
		
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Объект.Договор = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Объект.ДополнительнаяАналитика = ПолучитьДополнительнуюАналитику(Объект.Договор);
	
	УстановитьПлановуюДатуОплаты();
	
	УстановитьСвойстваНДСНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПлановуюДатуОплаты()
	
	НоваяПлановаяДатаОплаты = ПолучитьДатуОплатыПоДоговору(Объект.Дата, Объект.Договор);
	Если ЗначениеЗаполнено(НоваяПлановаяДатаОплаты) Тогда
		Если НЕ ЗначениеЗаполнено(ПлановаяДатаОплаты) Тогда
			ПлановаяДатаОплаты = НоваяПлановаяДатаОплаты;
		ИначеЕсли ПлановаяДатаОплаты <> НачалоДня(НоваяПлановаяДатаОплаты) Тогда
			Если Вопрос("Изменить плановую дату оплаты на " + Формат(НоваяПлановаяДатаОплаты, "ДФ=dd.MM.yyyy") + "?", РежимДиалогаВопрос.ДаНет, 60) = КодВозвратаДиалога.Да Тогда
				ПлановаяДатаОплаты = НоваяПлановаяДатаОплаты;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеДоходыИРасходыПриИзменении(Элемент)
	
	ГруппаФинансовогоУчетаДоходовРасходов = ПолучитьГруппуФинансовогоУчетаДоходовРасходов(
												Объект.Дата,
												Объект.Организация,
												Объект.СчетДоверительногоУправления,
												Объект.ВидЗадолженности,
												Объект.ПрочиеДоходыИРасходы);
	
	Если НЕ ЗначениеЗаполнено(Объект.ГруппаФинансовогоУчетаДоходовРасходов) ИЛИ 
		(ГруппаФинансовогоУчетаДоходовРасходов <> Объект.ГруппаФинансовогоУчетаДоходовРасходов И 
		Вопрос("Перезаполнить группу финансового учета доходов и расходов?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да) Тогда
	    Объект.ГруппаФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияБазаИСтавкаНалогаПриИзменении(Элемент)
	
	РассчитатьСуммуНалога(Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияРасчетПоКадастровойСтоимостиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Основания.ТекущиеДанные;	
	ТекущиеДанные.ОбъектРасчетаНалогаНаИмущество = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияОбъектРасчетаНалогаНаИмуществоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Основания.ТекущиеДанные;
	
	Если ТекущиеДанные.ОбъектРасчетаНалогаНаИмущество <> "" Тогда	
		
		ТекущиеДанные.ЦеннаяБумага = ПолучитьОбъектНедвижимостиПоОКТМОНаСервере(Объект.Организация, Объект.СчетДоверительногоУправления, ТекущиеДанные.ОбъектРасчетаНалогаНаИмущество, Объект.Дата);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ЦеннаяБумага) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден объект недвижимости с кодом ОКАТО " + ТекущиеДанные.ОбъектРасчетаНалогаНаИмущество);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоДенежнымСредствам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоДенежнымСредствам(ЭтаФорма, ЭтаФорма.ОплатаЧерезБрокера);

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПоНалогуНаИмущество(Команда)
	
	Если Объект.Основания.Количество()>0 Тогда
		Если Вопрос("Очистить табличную часть документа?", РежимДиалогаВопрос.ДаНет,60) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КомандаЗаполнитьПоНалогуНаИмуществоНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьПоНалогуНаИмуществоНаСервере()
	
	Отказ = Ложь;
	
	Объект.Основания.Очистить();
	
	РасчетНалогаНаИмущество = РаботаСНалогамиКлиентСервер.РассчитатьНалогНаИмущество(Объект.ОкончаниеПериодаНачисления, Объект.Организация, Объект.СчетДоверительногоУправления, Отказ, Ложь);
	
	Для Каждого СтрокаРасчета Из РасчетНалогаНаИмущество  Цикл
		
		Строка = Объект.Основания.Добавить();
		Строка.ЦеннаяБумага = СтрокаРасчета.ОбъектНедвижимости;
		Строка.БазаНалога = СтрокаРасчета.БазаНалога;
		Строка.СтавкаНалога = СтрокаРасчета.СтавкаНалога;
		Строка.Сумма = СтрокаРасчета.СуммаНалога - СтрокаРасчета.СуммаАванса;
		Строка.АвансПоНалогу = СтрокаРасчета.СуммаАванса;
		Строка.РасчетПоКадастровойСтоимости = СтрокаРасчета.РасчетПоКадастровойСтоимости;
		Строка.ОбъектРасчетаНалогаНаИмущество = СтрокаРасчета.КодОКТМО;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаКлиенте 
Процедура РассчитатьСуммуНДС(ТекущиеДанные)
	
	СтавкаНДС = РаботаСНалогамиКлиентСервер.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);

	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * СтавкаНДС/(100 + СтавкаНДС);
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЭтоКредиторскаяЗадолженность(ВидЗадолженности)
	Возврат Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ВидЗадолженности) = Перечисления.ТипыЗадолженности.Кредиторская;
КонецФункции

&НаСервереБезКонтекста
Функция НуженВходящийДокумент(ОбъектФормы)
	Объект = ДанныеФормыВЗначение(ОбъектФормы, Тип("ДокументОбъект.НачислениеЗадолженности"));
	Возврат Объект.НуженВходящийДокумент();
КонецФункции

&НаСервереБезКонтекста
Функция ДоступноПредварительноеНачисление(Объект)
	Возврат Справочники.ВидыЗадолженности.ВидыЗадолженностиСПредварительнымНачислением(Объект.Организация, Объект.Дата).Найти(Объект.ВидЗадолженности) <> Неопределено;	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИсходящаяУслуга(ВидЗадолженности)
	Возврат Справочники.ВидыЗадолженности.ЭтоИсходящаяУслуга(ВидЗадолженности);
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоПеревыставляемаяУслуга(ВидЗадолженности)
	Возврат Справочники.ВидыЗадолженности.ЭтоПеревыставляемаяУслуга(ВидЗадолженности);
КонецФункции

&НаСервереБезКонтекста
Функция ДоступныПолныеПрава()
	Возврат РольДоступна(Метаданные.Роли.ПолныеПрава);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.МестоХранения.Доступность = (Форма.ОплатаЧерезБрокера <> ЗначениеПереключателяБиржа());
	
	Элементы.Брокер.Видимость = (Форма.ОплатаЧерезБрокера = ЗначениеПереключателяБрокер());
	
	// основания и ценные бумаги
	Элементы.ОснованияОснование.Видимость =
		(Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоТорговойКомиссии")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение")
			Или ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.НДФЛ"))			
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНалогуНаПрибыль"));
			
	Элементы.ОснованияЦеннаяБумага.Видимость =
		(Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоТорговойКомиссии")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНалогуНаПрибыль")
			Или ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.НДФЛ")));
			
	ЭтоНалог = ЭтоНалог(Объект.ВидЗадолженности);
	
	ЭтоНалогНаИмущество = Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНалогуНаИмущество");
	
	Элементы.КомандаЗаполнитьПоНалогуНаИмущество.Видимость = ЭтоНалогНаИмущество;
	
	Если ЭтоНалог Тогда
		
		Элементы.ОснованияСумма.Заголовок = "Сумма";
				
		Если ЭтоНалогНаИмущество Тогда
			Элементы.ОснованияЦеннаяБумага.Заголовок = "Объект недвижимости";
		КонецЕсли;
		
	Иначе
		Элементы.ОснованияСумма.Заголовок = "Сумма с НДС";
		Элементы.ОснованияЦеннаяБумага.Заголовок = "Ценная бумага";
	КонецЕсли;
		
	//НДС		
	ЭтоКредиторскаяЗадолженность = ЭтоКредиторскаяЗадолженность(Объект.ВидЗадолженности);
	ЭтоИсходящаяУслуга = ЭтоИсходящаяУслуга(Объект.ВидЗадолженности);
	ЭтоПеревыставляемаяУслуга = ЭтоПеревыставляемаяУслуга(Объект.ВидЗадолженности);
	//в 2022 году оформили предварительные по аренде с НДС. Это ошибка, но исправлять поздно, а в докумнте надо показать как есть.
	Элементы.ОснованияСтавкаНДС.Видимость 	= НЕ (Объект.Предварительно ИЛИ ЭтоНалог) ИЛИ (Объект.Дата < Дата(2023,1,1)) И (ЭтоИсходящаяУслуга И НЕ ЭтоПеревыставляемаяУслуга);
	Элементы.ОснованияСуммаНДС.Видимость 	= НЕ (Объект.Предварительно ИЛИ ЭтоНалог) ИЛИ (Объект.Дата < Дата(2023,1,1)) И (ЭтоИсходящаяУслуга И НЕ ЭтоПеревыставляемаяУслуга);
	
	Элементы.ОснованияСодержание.Видимость = Форма.ВестиУчетНДС И НЕ СодержаниеИспользуетсяДляХраненияДанных(Объект.ВидЗадолженности);
	Элементы.ГруппаСчетФактура.Видимость = Форма.ВестиУчетНДС И Не Объект.Предварительно;
	Элементы.ГруппаНДС.Видимость = Форма.ВестиУчетНДС И ЭтоКредиторскаяЗадолженность;
	Элементы.НомерСчетаФактуры.Заголовок = "Счет-фактура " + ?(ЭтоКредиторскаяЗадолженность, "полученный", "выданный") + " №";
	Элементы.КомандаПрисвоитьНомерСчетаФактурыВыданного.Видимость = ЭтоИсходящаяУслуга;
	Если Элементы.ГруппаСчетФактура.Видимость 
		И Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда 
		Элементы.СчетФактураСводный.Видимость = Истина;
	КонецЕсли;
	Элементы.НомерАктаВыданного.Видимость = ЭтоИсходящаяУслуга;
	Элементы.НомерСчетаНаОплатуВыданного.Видимость = ЭтоИсходящаяУслуга;
	Элементы.ГрузоотправительНужен.Видимость = Форма.ВестиУчетНДС И Не Объект.Предварительно И ЭтоКредиторскаяЗадолженность;
	Элементы.Грузоотправитель.Видимость = Форма.ВестиУчетНДС И Не Объект.Предварительно И ЭтоКредиторскаяЗадолженность
				И Форма.ГрузоотправительНужен;
	Элементы.КПП.Видимость = Форма.ВестиУчетНДС И Не Объект.Предварительно И ЭтоКредиторскаяЗадолженность;
	
	Элементы.РасчетныйСчетКонтрагента.Видимость = РаботаСДокументами.ОбязательноЗаполнениеРасчетногоСчетаКонтрагентаВНачисленииЗадолженности(Объект);
	
	// входящий документ
	ВидимостьВходящийДокумент = НуженВходящийДокумент(Объект);
	Если НЕ ВидимостьВходящийДокумент Тогда
		Форма.ВходящийДокумент = Ложь;
	КонецЕсли;
	Элементы.ВходящийДокумент.Видимость = ВидимостьВходящийДокумент;
	Элементы.ВидВходящегоДокумента.Видимость   = Форма.ВходящийДокумент;
	Элементы.НомерВходящегоДокумента.Видимость = Форма.ВходящийДокумент;
	Элементы.ДатаВходящегоДокумента.Видимость  = Форма.ВходящийДокумент;
	
	// Период, за который начисляется задолженность 
	Элементы.ПериодНачисления.Видимость = ЗначениеЗаполнено(Форма.ПериодНачисления) 
		Или ТребуетсяУказаниеПериодаНачисленияЗадолженности(Объект.Организация, Объект.ВидЗадолженности, Объект.Дата, Объект.СчетДоверительногоУправления);
			
	Элементы.Предварительно.Видимость = ДоступноПредварительноеНачисление(Объект) И Элементы.ПериодНачисления.Видимость;
	
	// элементы, зависящие от детализации по р/с
	Если Форма.ОплатаЧерезБрокера = ЗначениеПереключателяБиржа() Тогда
		Элементы.КомандаВыбратьИсполнителяПоДенежнымСредствам.Видимость	= Ложь;
		Элементы.РасчетныйСчет.Видимость								= Ложь;
	Иначе
		РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	КонецЕсли;
	
	Элементы.Договор.Видимость =
		(Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии") 
			Или ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия"))
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимУслугам")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимДоходам")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыНаКоммунальныеУслуги")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоУслугамПрочегоИспользованияИмущества")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоУлучшениюОбъектовНедвижимости")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАрендеПеременнаяЧасть")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПолучениюВАренду")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоИнымДоходамПоИмуществу")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий")
			Или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоРекламе"));
			
			
	ПараметрыВыбораДоговора = Новый Массив;
	МассивТиповДоговоров	= Новый Массив;
	МассивТиповДоговоров.Добавить(Тип("СправочникСсылка.Договоры"));
			
	Если Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии")
		ИЛИ ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия")) Тогда
		
		МассивВидовДоговоров = Новый Массив;
		МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ВеденияРеестра"));
		МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДепозитарногоОбслуживания"));
		МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания"));
		МассивВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецРегистрационногоОбслуживания"));
		
		ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", МассивВидовДоговоров));
		
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика") Тогда
		ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.Оценки")));
		
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора") Тогда
		ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СпецРегистрационногоОбслуживания")));
		
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде") 
		ИЛИ Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПолучениюВАренду") Тогда
		ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.Аренды")));
		
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий") Тогда
		ПараметрыВыбораДоговора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДоговорСтрахования")));	
		
	КонецЕсли;
	
	Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораДоговора);
	Элементы.Договор.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДоговоров);
	
	// плановая дата оплаты
	Элементы.ОснованияДатаОплаты.Видимость = ДатаОплатыВТабличнойЧасти(Объект.ВидЗадолженности);
	Элементы.ПлановаяДатаОплаты.Видимость  = НЕ ДатаОплатыВТабличнойЧасти(Объект.ВидЗадолженности);
			
	Элементы.ДополнительнаяАналитика.Видимость =
		Элементы.Договор.Видимость И ЗначениеЗаполнено(Объект.Договор)
			И ТипЗнч(Объект.Договор) = Тип("СправочникСсылка.Договоры")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВидДоговора") = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДоговорСтрахования"); 
			
	Если Элементы.Найти("ФормаОбщаяКомандаПровестиПоБухгалтерскомуУчету") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаПровестиПоБухгалтерскомуУчету.Видимость = НЕ БухгалтерскийУчет.ВидЗадолженностиСвязанСПартиями(Объект.ВидЗадолженности);
	КонецЕсли;
	
	Если Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		Элементы.ВозмещениеПоАренде.Видимость = Истина;
		Элементы.СтраницаВозмещениеПоАренде.Видимость = Форма.ВозмещениеПоАренде; 
	Иначе
		Элементы.ВозмещениеПоАренде.Видимость = Ложь;
		Элементы.СтраницаВозмещениеПоАренде.Видимость = Ложь;
	КонецЕсли;	
	
	Элементы.ГруппаДанныеДополнительногоДокумента.Видимость = Форма.ДополнительныйДокумент;
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
		
		ПутьКДаннымСкрываемыхПолей.Вставить("ПериодНачисления"       , РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("ПериодНачисления, Объект.НачалоПериодаНачисления, Объект.ОкончаниеПериодаНачисления", ",", Истина, Истина));
		ПутьКДаннымСкрываемыхПолей.Вставить("ВидВходящегоДокумента"  , "Объект.ВидВходящегоДокумента");
    	ПутьКДаннымСкрываемыхПолей.Вставить("НомерВходящегоДокумента", "Объект.НомерВходящегоДокумента");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаВходящегоДокумента" , "Объект.ДатаВходящегоДокумента");
		ПутьКДаннымСкрываемыхПолей.Вставить("НомерСчетаФактуры" 	 , "Объект.НомерСчетаФактуры");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаСчетаФактуры" 	 	 , "Объект.ДатаСчетаФактуры");
		ПутьКДаннымСкрываемыхПолей.Вставить("Договор"                , "Объект.Договор");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияОснование"     , "Объект.Основания.Основание");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияЦеннаяБумага"  , "Объект.Основания.ЦеннаяБумага");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСтавкаНДС" 	 , "Объект.Основания.СтавкаНДС");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСуммаНДС" 	 , "Объект.Основания.СуммаНДС");
		ПутьКДаннымСкрываемыхПолей.Вставить("Предварительно"  		 , "Объект.Предварительно");
		ПутьКДаннымСкрываемыхПолей.Вставить("Грузоотправитель"  	 , "Объект.Грузоотправитель");
			
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДатаОплатыВТабличнойЧасти(ВидЗадолженности)
	
	Возврат ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоТорговойКомиссии")
			ИЛИ ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии");

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДепозитарийКонтрагента(Контрагент)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПредопределенноеЗначение("Справочник.ДепозитарныеКомпании.ПустаяСсылка");
	Иначе
		Возврат Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Контрагент, "ДепозитарныеКомпании");
	КонецЕсли;
	
КонецФункции // ПолучитьДепозитарийКонтрагента

&НаСервереБезКонтекста
Функция ПолучитьПрочиеДоходыИРасходы(Знач Объект)
	
	Если Объект.Предварительно Тогда
		Возврат Справочники.ВидыЗадолженности.ПолучитьАналитикуДляПредварительныхНачисленийПоВидуЗадолженности(Объект.ВидЗадолженности);
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ОбщРасхПоУслугамБрокера");
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии
		ИЛИ ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия) Тогда 	
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ОбщРасхПоУслугамДепозитария");
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии
		ИЛИ ПринадлежитГруппеЗадолженностей(Объект.ВидЗадолженности, Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда 	
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_КомиссияБанка");
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоРекламе Тогда
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РасходыСвязанныеСРекламой");
	ИначеЕсли Объект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПолучениюВАренду Тогда
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РасходыПоПолучениюВАренду");
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		Возврат БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидЗадолженности, Перечисления.ВидыУчета.БухгалтерскийУчет, "Аналитика");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьГруппуФинансовогоУчетаДоходовРасходов(Дата, Организация, СчетДоверительногоУправления, ВидЗадолженности, ПрочиеДоходыИРасходы)

	Если ЗначениеЗаполнено(ВидЗадолженности) Тогда
		
		Возврат БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаПоПрочимДоходамРасходам(
										Дата,
										Организация,
										СчетДоверительногоУправления,
										ВидЗадолженности,
										ПрочиеДоходыИРасходы);
		
	КонецЕсли; 

КонецФункции // ПолучитьГруппуФинансовогоУчетаДоходовРасходов()

&НаСервереБезКонтекста
Функция ПринадлежитГруппеЗадолженностей(ВидЗадолженности, Группа)
	Если НЕ ЗначениеЗаполнено(ВидЗадолженности) Тогда
		Возврат Ложь;
	Иначе
		Возврат ВидЗадолженности.ПринадлежитЭлементу(Группа);
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаписатьДанныеОДокументеВДопСведенияНаСервере(Ссылка, ИмяКлюча, Значение) 
	
	ВариантыКлюча = РедактируемыеДополнительныеСведения();
	Если ВариантыКлюча.Найти(ИмяКлюча) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано сохранение дополнительного сведения с ключом """ + ИмяКлюча + """");
		Возврат;
	КонецЕсли;
	
	ПланыВидовХарактеристик.ДополнительныеСведения.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Ссылка, ИмяКлюча, Значение);
			
КонецПроцедуры

&НаСервере
Функция ДанныеДокументаИзДопСведенийНаСервере(Ссылка, ИмяКлюча) 
	
	ВариантыКлюча = РедактируемыеДополнительныеСведения();
	
	Если ВариантыКлюча.Найти(ИмяКлюча) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано получение из дополнительных сведений по ключу """ + ИмяКлюча + """");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, ИмяКлюча, Ссылка);
			
КонецФункции 

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ВходящийДокумент             = ЗначениеЗаполнено(Объект.ВидВходящегоДокумента);
	ЭтаФорма.ВозмещениеПоАренде           = ЗначениеЗаполнено(Объект.Арендатор) Или ЗначениеЗаполнено(Объект.ДоговорАренды);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	
	ЭтаФорма.ОплатаЧерезБрокера           = ОпределитьЗначениеПереключателя(Объект.Брокер, Объект.МестоХранения);
	ЭтаФорма.ДепозитарийКонтрагента       = ПолучитьДепозитарийКонтрагента(Объект.Контрагент);
	ЭтаФорма.ПериодНачисления			  = Новый СтандартныйПериод(Объект.НачалоПериодаНачисления, Объект.ОкончаниеПериодаНачисления);	
	ЭтаФорма.ВестиУчетНДС				  = РаботаСНДС.ВестиУчетНДС(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ЭтаФорма.НомерАктаВыданного		  		= ДанныеДокументаИзДопСведенийНаСервере(Объект.Ссылка, "НомерАктаВыданного");
		ЭтаФорма.НомерСчетаНаОплатуВыданного 	= ДанныеДокументаИзДопСведенийНаСервере(Объект.Ссылка, "НомерСчетаВыданного");
		
		ЭтаФорма.ВидДополнительногоДокумента 	= ДанныеДокументаИзДопСведенийНаСервере(Объект.Ссылка, "ВидДополнительногоДокумента");
		ЭтаФорма.НомерДополнительногоДокумента 	= ДанныеДокументаИзДопСведенийНаСервере(Объект.Ссылка, "НомерДополнительногоДокумента");
		ЭтаФорма.ДатаДополнительногоДокумента 	= ДанныеДокументаИзДопСведенийНаСервере(Объект.Ссылка, "ДатаДополнительногоДокумента");
		
		ЭтаФорма.ДополнительныйДокумент = Не ПустаяСтрока(ЭтаФорма.ВидДополнительногоДокумента);	
	КонецЕсли;
	
	Элементы.ОснованияДатаОплаты.Заголовок = "Дата оплаты " + НРег(Объект.ВидЗадолженности);
	
	Если НЕ ДатаОплатыВТабличнойЧасти(Объект.ВидЗадолженности) Тогда
		Если Объект.Основания.Количество() > 0 Тогда
			ПлановаяДатаОплаты = Объект.Основания[0].ДатаОплаты;
		КонецЕсли;
	КонецЕсли;

	ЭтаФорма.ГрузоотправительНужен = ЗначениеЗаполнено(Объект.Грузоотправитель);
	Если ЭтаФорма.ВестиУчетНДС Тогда
		ЭтаФорма.Элементы.ВидВходящегоДокумента.РежимВыбораИзСписка = Истина;
		ЭтаФорма.Элементы.ВидВходящегоДокумента.СписокВыбора.Очистить();
		// счет-фактура указывается в отдельном реквизите
		Для сц = 0 по Перечисления.ВидыВходящихДокументов.Количество()-1 Цикл
			ТекВидВходящегоДокумента = Перечисления.ВидыВходящихДокументов.Получить(сц);
			Если ТекВидВходящегоДокумента <> Перечисления.ВидыВходящихДокументов.СчетФактура Тогда 
				ЭтаФорма.Элементы.ВидВходящегоДокумента.СписокВыбора.Добавить(ТекВидВходящегоДокумента);
			КонецЕсли;
		КонецЦикла;
		
		ОбновитьКППНаСервере();
	Иначе
		ЭтаФорма.Элементы.ВидВходящегоДокумента.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
	
	ЗаполнитьДополнительныеКолонкиНаСервере();	
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДополнительнуюАналитику(Договор)
	
	Если ЗначениеЗаполнено(Договор)
		И ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры")
		И Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДоговорСтрахования") Тогда
		Возврат ПредопределенноеЗначение("Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВозвратСтраховойПремии");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДатуОплатыПоДоговору(ДатаЗадолженности, Договор)
	
	Возврат Справочники.Календари.ПолучитьДатуОплаты(ДатаЗадолженности, Договор);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТребуетсяУказаниеПериодаНачисленияЗадолженности(Организация, ВидЗадолженности, Дата, СчетДоверительногоУправления)
	
	Возврат Справочники.ВидыЗадолженности.ТребуетсяУказаниеПериодаНачисленияЗадолженности(
				Организация,
				ВидЗадолженности,
				Дата,
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
	
КонецФункции

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

