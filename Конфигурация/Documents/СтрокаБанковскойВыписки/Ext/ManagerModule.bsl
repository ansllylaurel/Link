			|			И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
			|ГДЕ
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет
			|	И СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств ЕСТЬ NULL
			|	И ИсполнителиСоСчетомКонтрагента.РасчетныйСчет ЕСТЬ NULL
			|	И ВЫБОР
			|			КОГДА ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание ЕСТЬ NULL
			|				ТОГДА &ВНазначенииПлатежаНеУпоминаетсяБрокер
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И (КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Контрагент
			|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо = &Контрагент)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""ВводДенежныхСредств"",
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
			|	ДокументЗаявкаПайщика.Ссылка,
			|	&РасчетныйСчет,
			|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда,
			|	ДокументЗаявкаПайщика.НомерЗаявки,
			|	0,
			|	0,
			|	ДокументЗаявкаПайщика.Дата,
			|	NULL,
			|	ДокументЗаявкаПайщика.Пайщик,
			|	NULL
			|ИЗ
			|	РегистрСведений.СтатусыЗаявокПайщиков.СрезПоследних(&КонецДня, Организация = &Организация) КАК СтатусыЗаявокПайщиковСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ДокументЗаявкаПайщика
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецДня, ) КАК РеквизитыПИФСрезПоследних
			|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецДня, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
			|				ПО РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
			|			ПО ДокументЗаявкаПайщика.Организация.ЮрФизЛицо = РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
			|				И ДокументЗаявкаПайщика.ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
			|				И (ДокументЗаявкаПайщика.РасчетныйСчет = &РасчетныйСчетКонтрагента)
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|					&КонецДня,
			|					Организация = &Организация
			|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|			ПО ДокументЗаявкаПайщика.Организация = РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация
			|				И ДокументЗаявкаПайщика.Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
			|			ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
			|			ПО (ТИПЗНАЧЕНИЯ(ЗадачаИсполнителя.БизнесПроцесс) = ТИП(БизнесПроцесс.ЗачислениеПаев))
			|				И (ЗадачаИсполнителя.БизнесПроцесс.ЗаявкаПайщика = ДокументЗаявкаПайщика.Ссылка)
			|				И (ЗадачаИсполнителя.БизнесПроцесс.Стартован)
			|				И (НЕ ЗадачаИсполнителя.ПометкаУдаления)
			|		ПО СтатусыЗаявокПайщиковСрезПоследних.ЗаявкаПайщика = ДокументЗаявкаПайщика.Ссылка
			|			И (НЕ ДокументЗаявкаПайщика.ПометкаУдаления)
			|			И (ДокументЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление))
			|ГДЕ
			|	(&ТранзитныйСчетПИФ
			|				И &ВНазначенииПлатежаОплатаИнвестиционныхПаев
			|				И ДокументЗаявкаПайщика.Ссылка ЕСТЬ НЕ NULL 
			|				И ДокументЗаявкаПайщика.Многократная
			|			ИЛИ НЕ ДокументЗаявкаПайщика.Многократная
			|				И ЗадачаИсполнителя.Ссылка ЕСТЬ NULL)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	1 КАК Номер
			|ИЗ
			|	_Основания КАК _Основания
			|ГДЕ
			|	_Основания.ВидДокумента = ""Оплата""");
		
		#КонецОбласти
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		// По МНО и депозитам нужно проверять конец предыдущего дня
		Запрос.УстановитьПараметр("КонецПредыдущегоДняГраница",	Новый Граница(НачалоДня(ДатаВыписки) - 1, ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ТекущееВремяГраница",		Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонецДняГраница",			Новый Граница(КонецДня(ДатаВыписки), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("НачалоДня",					НачалоДня(ДатаВыписки));
		Запрос.УстановитьПараметр("КонецДня",					КонецДня(ДатаВыписки));
		Запрос.УстановитьПараметр("Организация",				Организация);
		Запрос.УстановитьПараметр("РасчетныйСчет",  			РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет);
		Запрос.УстановитьПараметр("РасчетныйСчетКонтрагента",  	РеквизитыСтрокиБанковскойВыписки.РасчетныйСчетКонтрагента);
		Запрос.УстановитьПараметр("Сумма",  					РеквизитыСтрокиБанковскойВыписки.Сумма);
		Запрос.УстановитьПараметр("ТранзитныйСчетПИФ",			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет, "ТранзитныйПИФ"));
		
		Запрос.УстановитьПараметр(
			"ВНазначенииПлатежаНеУпоминаетсяБрокер", 
			СтрНайти(ВРег(РеквизитыСтрокиБанковскойВыписки.НазначениеПлатежа), "БРОКЕР") = 0);
			
		Запрос.УстановитьПараметр(
			"ВНазначенииПлатежаОплатаИнвестиционныхПаев", 	
			СтрНайти(ВРег(РеквизитыСтрокиБанковскойВыписки.НазначениеПлатежа), "ПЕРЕЧИСЛЕНИЕ ДЕНЕЖНЫХ СРЕДСТВ В ОПЛАТУ ИНВЕСТИЦИОННЫХ ПАЕВ") > 0
			Или СтрНайти(ВРег(РеквизитыСтрокиБанковскойВыписки.НазначениеПлатежа), "ПЕРЕЧИСЛЕНИЕ ДЕНЕЖНЫХ СРЕДСТВ В ОПЛАТУ ПАЕВ") > 0
			Или СтрНайти(ВРег(РеквизитыСтрокиБанковскойВыписки.НазначениеПлатежа), "ОПЛАТА ПАЕВ") > 0);
			
		Запрос.УстановитьПараметр("Брокер_БК",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
		Запрос.УстановитьПараметр("Брокер_ГПБ",					ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
		Запрос.УстановитьПараметр("Брокер_РСХБ",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_РСХБ"));
		Запрос.УстановитьПараметр("ГПБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкГПБ"));
		Запрос.УстановитьПараметр("Контрагент",					РеквизитыСтрокиБанковскойВыписки.Контрагент);
		Запрос.УстановитьПараметр("НКО_НКЦ",					ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
		Запрос.УстановитьПараметр("РСХБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкРСХБ"));
		Запрос.УстановитьПараметр("СтрокаБанковскойВыписки",	СтрокаБанковскойВыписки);                                         
		Запрос.УстановитьПараметр("ММВБ_РТС",					ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС"));
		Запрос.УстановитьПараметр("ММВБ_РТС_ТорговыйПлюс",		ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
		Запрос.УстановитьПараметр("БК_Регион",					ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_РЕГИОН_БК"));
				
		КоличествоСтрокОплаты = Запрос.Выполнить().Выбрать().Количество();
		
		СозданоОплат = 0;
		СимволДвойныеКавычки = Символ(34);
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_Основания"].ПолучитьДанные().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДополнительныйИдентификатор = ?(ТипЗнч(Выборка.ДополнительныйИдентификатор) = Тип("Число"), Формат(Выборка.ДополнительныйИдентификатор, "ЧН='""""'; ЧГ=0"), Выборка.ДополнительныйИдентификатор);
			
			// Пробуем найти в назначении платежа основной и дополнительный идентификатор
			Если Выборка.ВидДокумента <> "ЗакрытиеКредитногоИнструмента" 
				И (СтрНайти(НазначениеПлатежа, НРег(Выборка.ОсновнойИдентификатор)) > 0 
					Или СтрНайти(НазначениеПлатежа, СтрЗаменить(НРег(Выборка.ОсновнойИдентификатор), СимволДвойныеКавычки, "")) > 0) Тогда
								
				Если Выборка.ВидДокумента = "ПриходПроцентовМНО" И Не ПустаяСтрока(ДополнительныйИдентификатор) Тогда
					
					Для Каждого СимволНомера Из МассивСимволовНомера Цикл
						
						Если СтрНайти(НазначениеПлатежа, НРег(СимволНомера + ДополнительныйИдентификатор)) > 0 Тогда
							
							// Идентификация завершена, можно искать документ (он создается заранее в непроведенном виде)
							ДокументДДССсылка = НайтиДокументДвиженияДенежныхСредствПоЗначениюРеквизита("ПриходПроцентовМНО", "МНО", Выборка.Основание, ДатаВыписки, "НеПроведен");
							
							Если ДокументДДССсылка <> Неопределено Тогда
								
								ДокументДДС = ДокументДДССсылка.ПолучитьОбъект();
								ДокументДДС.СтрокаБанковскойВыписки = СтрокаБанковскойВыписки;
								
								Попытка 
									ДокументДДС.Записать(РежимЗаписиДокумента.Проведение);
									Возврат ДокументДДС.Ссылка;
								Исключение
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
								КонецПопытки;
								
							КонецЕсли;	
							
							Возврат Неопределено;
							
						КонецЕсли;
						
					КонецЦикла;
					
				ИначеЕсли Выборка.ВидДокумента = "Оплата" Тогда
					
					// Проверим, что вся сумма строки выписки еще не использована
					Если СтрокаБанковскиИспользуетсяВРеестреПлатежейВсейСуммой(СтрокаБанковскойВыписки, РеквизитыСтрокиБанковскойВыписки.Сумма) Тогда
						Возврат Неопределено;						
					КонецЕсли;
					
					ДокументДДС = Документы.Оплата.СоздатьДокумент();
										
					ДокументДДС.Заполнить(Выборка.Основание);
					ДокументДДС.Дата = Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка, "Приход");
					
					ДокументДДС.СтрокаБанковскойВыписки	= СтрокаБанковскойВыписки;
					
					ДокументДДС.РасчетныйСчет			= РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет;
					
					Если Не ЗначениеЗаполнено(ДокументДДС.ВидДвижения) Тогда
												
						ДокументДДС.ВидДвижения			= Перечисления.ВидыДвижений.Приход;											
						ДокументДДС.ВидЗадолженности	= Выборка.ДополнительныйИдентификатор; 
						ДокументДДС.Контрагент			= Выборка.Контрагент;
						ДокументДДС.ВалютаОплаты		= ВалютаУчета;
						
						СтрокаОснования				= ДокументДДС.Основания.Добавить();
						СтрокаОснования.Основание	= Выборка.Основание; 
						СтрокаОснования.Валюта		= ВалютаУчета;
						
						Если Выборка.СуммаОстаток > 0 Тогда
							СтрокаОснования.Сумма		= Выборка.СуммаОстаток;
							СтрокаОснования.СуммаОплаты	= Выборка.СуммаОстаток;
						ИначеЕсли Выборка.СуммаКупонаОстаток > 0 Тогда
							СтрокаОснования.СуммаКупона			= Выборка.СуммаКупонаОстаток;
							СтрокаОснования.СуммаОплатыКупона	= Выборка.СуммаКупонаОстаток;
						КонецЕсли;
						
					КонецЕсли;	
					
					Если ДокументДДС.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции Тогда
						ДокументДДС.Основания[0].Сумма			= Выборка.СуммаОстаток;
						ДокументДДС.Основания[0].СуммаОплаты	= Выборка.СуммаОстаток;
					КонецЕсли;
					
					Если Не РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда							
						Возврат Неопределено;
					КонецЕсли;
					
					СозданоОплат = СозданоОплат + 1;
					
					Если СозданоОплат = КоличествоСтрокОплаты Тогда
						Возврат ДокументДДС.Ссылка;
					Иначе
						Продолжить;
					КонецЕсли;
						
				ИначеЕсли Выборка.ВидДокумента = "ПереводДенежныхСредствПоПоручению" И РеквизитыСтрокиБанковскойВыписки.Сумма = Выборка.СуммаОстаток Тогда
										
					ДокументДДССсылка = НайтиДокументДвиженияДенежныхСредствПоЗначениюРеквизита("ПереводДенежныхСредств", "Основание", Выборка.Основание, ДатаВыписки, "НеИмеетЗначения");
					
					Если ДокументДДССсылка <> Неопределено Тогда						
						ДокументДДС = ДокументДДССсылка.ПолучитьОбъект();						
					Иначе
						ДокументДДС = Документы.ПереводДенежныхСредств.СоздатьДокумент();
						ДокументДДС.Заполнить(Выборка.Основание);
					КонецЕсли;
					
					ДокументДДС.Дата = Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка, "Приход");
					
					ДокументДДС.СтрокаБанковскойВыпискиПолучатель = СтрокаБанковскойВыписки;
					
					Если РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат ДокументДДС.Ссылка;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
					КонецЕсли;
										
					Возврат Неопределено;
										
				ИначеЕсли Выборка.ВидДокумента = "ПереводДенежныхСредствБезПоручения" Тогда
										
					ДокументДДС = Документы.ПереводДенежныхСредств.СоздатьДокумент();
					
					УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ДокументДДС);
					
					ЗаполнитьЗначенияСвойств(ДокументДДС, РеквизитыСтрокиБанковскойВыписки);                                                             
					
					ДокументДДС.РасчетныйСчет			= ?(Выборка.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок,
															РеквизитыСтрокиБанковскойВыписки.РасчетныйСчетКонтрагента,
															Справочники.БанковскиеСчета.ПустаяСсылка());
															
					ДокументДДС.РасчетныйСчетПолучатель	= РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет;
					
					ДокументДДС.ВариантПеревода	= Перечисления.ВариантыПереводаДенежныхСредств.Перевод;
					ДокументДДС.Валюта			= ВалютаУчета;
					
					ДокументДДС.МестоХранения			= Выборка.МестоХранения;
					ДокументДДС.МестоХраненияПолучатель	= Документы.СтрокаБанковскойВыписки.МестоХраненияДляРасчетногоСчета(ДокументДДС.РасчетныйСчетПолучатель);
					
					ДокументДДС.Брокер = Документы.СтрокаБанковскойВыписки.БрокерскаяКомпанияПоЮрЛицуИлиРасчетномуСчету(
											РеквизитыСтрокиБанковскойВыписки.Контрагент,
											ДатаВыписки,
											РеквизитыСтрокиБанковскойВыписки.РасчетныйСчетКонтрагента);
															
					ДокументДДС.СчетДоверительногоУправления = Документы.СтрокаБанковскойВыписки.СчетДоверительногоУправленияПоРасчетномуСчетуИИсполнителю(
																Новый Структура("Период, Организация, РасчетныйСчет, Контрагент, ВидДокумента", 
																		ДатаВыписки, 
																		Организация, 
																		РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет, 
																		РеквизитыСтрокиБанковскойВыписки.Контрагент, 
																		"ПереводДенежныхСредств"));
																		
					ДокументДДС.ФормаДенежныхСредств			= Перечисления.ФормыДенежныхСредств.Безналичная;
					ДокументДДС.ФормаДенежныхСредствПолучатель	= Перечисления.ФормыДенежныхСредств.Безналичная;
					
					ДокументДДС.Дата = Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка, "Приход");
					
					ДокументДДС.СтрокаБанковскойВыпискиПолучатель = СтрокаБанковскойВыписки;
					
					Если РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат ДокументДДС.Ссылка;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
					КонецЕсли;
										
					Возврат Неопределено;
					
				// Техдолг: у УКПИ много входящих платежей, не являющихся вводами, но ошибочно загружающихся как вводы; поэтому эта организация исключена, пока они не используют формирование исходящих платежных поручений
				ИначеЕсли Выборка.ВидДокумента = "ВводДенежныхСредств" И Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда	
														
					ДокументДДССсылка = НайтиДокументДвиженияДенежныхСредствПоЗначениюРеквизита("ВводДенежныхСредств", "СтрокаБанковскойВыписки", СтрокаБанковскойВыписки, ДатаВыписки, "Проведен");
					
					Если ДокументДДССсылка <> Неопределено Тогда						
						ДокументДДС = ДокументДДССсылка.ПолучитьОбъект();						
					Иначе
						
						ДокументДДС = Документы.ВводДенежныхСредств.СоздатьДокумент(); 
						
						ДокументДДС.Заполнить(Выборка.Основание); 
						
						ДокументДДС.Дата = Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка, "Приход");
						
						ДокументДДС.СтрокаБанковскойВыписки = СтрокаБанковскойВыписки;
					
						Если Не ЗначениеЗаполнено(Выборка.Основание) Или ТипЗнч(Выборка.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
							
							ДокументДДС.Контрагент = РеквизитыСтрокиБанковскойВыписки.Контрагент;
							ДокументДДС.НомерВходящегоДокумента = Выборка.ДополнительныйИдентификатор;
							ДокументДДС.ДатаВходящегоДокумента  = Выборка.Дата;
							ДокументДДС.РасчетныйСчетКонтрагента = РеквизитыСтрокиБанковскойВыписки.РасчетныйСчетКонтрагента;
							ДокументДДС.РасчетныйСчет = РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет;							
							ДокументДДС.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет, "Валюта");
							ДокументДДС.Сумма = РеквизитыСтрокиБанковскойВыписки.Сумма;
							ДокументДДС.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
																					
							ДокументДДС.КонтрагентДоговорТекстом = РаботаСДокументами.ПолучитьТекстКонтрагентаДляВводовВыводовДенежныхСредств(											
																		Организация,
																		ДокументДДС.Контрагент,
																		ДокументДДС.РасчетныйСчетКонтрагента,
																		Ложь,
																		ДокументДДС.Дата);
																		
							ДокументДДС.ДополнительныеСвойства.Вставить("ЗагрузкаБанковскойВыписки", Истина);																		
							
							Если Не ЗначениеЗаполнено(ДокументДДС.Основание) И ЗначениеЗаполнено(Выборка.Основание) Тогда
								ДокументДДС.Основание = Выборка.Основание;
							КонецЕсли;
							
						КонецЕсли;
						
						Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
								Выборка.СчетДоверительногоУправления,
								"ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР
						ИначеЕсли ТипЗнч(Выборка.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПайщика;
						Иначе	
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление;
						КонецЕсли;
								
						ДокументДДС.КоррСчет = БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(
													ДокументДДС.Дата,
													Организация,
													ДокументДДС.СчетДоверительногоУправления,
													ДокументДДС.ВидОперации);

						Если ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПайщика Тогда
							ДокументДДС.Субконто1 = ДокументДДС.Контрагент;
						КонецЕсли;

					КонецЕсли;
					
					Если РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат ДокументДДС.Ссылка;
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
					КонецЕсли;
										
					Возврат Неопределено;
					
				КонецЕсли;
				
			ИначеЕсли Выборка.ВидДокумента = "ЗакрытиеКредитногоИнструмента" Тогда
				
				// К закрытию кредитного инструмента прикрепляются две строки выписки (проценты и тело), назначение платежа у разных банков отличается:
				// 1. Содержится и ген. соглашение, и номер и дата подтверждения
				// 2. Содержится только номер и дата подтверждения
				// 3. Содержится номер договора депозита (если заключен не по ген. соглашению)
				// 4. Содержится только номер подтверждения (номер относительно длинный)
				//
				// В назначении платежа по выплате процентов содержится "процент"
								
				ДатаПодтверждения = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
				
				Если СтрНайти(НазначениеПлатежа, НРег(Выборка.ОсновнойИдентификатор)) > 0
					И (СтрНайти(НазначениеПлатежа, " " + НРег(ДополнительныйИдентификатор + " от " + ДатаПодтверждения)) > 0						
						Или (СтрНайти(НазначениеПлатежа, НРег(ДополнительныйИдентификатор)) > 0 И СтрДлина(ДополнительныйИдентификатор) > 6)) Тогда
					
					// Ищем или создаем документ
				    ДокументДДССсылка = НайтиДокументДвиженияДенежныхСредствПоЗначениюРеквизита("ЗакрытиеКредитногоИнструмента", "КредитныйИнструмент", Выборка.Основание, ДатаВыписки, "Проведен");
					
					Если ДокументДДССсылка = Неопределено Тогда
						
						МассивДокументов = Справочники.ДепозитныеВклады.СоздатьЗакрытияКредитныхИнструментов(Организация, НачалоДня(ДатаВыписки), Выборка.Основание);
						
						Если МассивДокументов = Неопределено Тогда
							Возврат Неопределено;	
						КонецЕсли;
						
						ДокументДДССсылка = МассивДокументов[0];
						
					КонецЕсли;
					
					ДокументДДС = ДокументДДССсылка.ПолучитьОбъект();
														
					Если СтрНайти(НазначениеПлатежа, "процент") > 0 Тогда
						ДокументДДС.СтрокаБанковскойВыпискиПроценты	= СтрокаБанковскойВыписки;
						ДокументДДС.СуммаПроцентов = СтрокаБанковскойВыписки.Сумма;
					Иначе	
						ДокументДДС.СтрокаБанковскойВыписки	= СтрокаБанковскойВыписки;
					КонецЕсли;
					
					ДокументДДС.РасчетныйСчет = РеквизитыСтрокиБанковскойВыписки.РасчетныйСчет;
										
					Если РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат ДокументДДС.Ссылка;
					Иначе
						Возврат Неопределено;
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
				
	Иначе
		
	    Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПлатежноеПоручениеИсходящееОснования.Основание КАК Основание,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ПлатежноеПоручениеИсходящееОснования.Основание) В (&ТипыОснований_Оплата)
			|			ТОГДА ""Оплата""
			|		КОГДА ТИПЗНАЧЕНИЯ(ПлатежноеПоручениеИсходящееОснования.Основание) В (&ТипыОснований_ВыводДенежныхСредств)
			|			ТОГДА ""ВыводДенежныхСредств""
			|		КОГДА ТИПЗНАЧЕНИЯ(ПлатежноеПоручениеИсходящееОснования.Основание) В (&ТипыОснований_ПереводДенежныхСредств)
			|			ТОГДА ""ПереводДенежныхСредств""
			|		КОГДА ТИПЗНАЧЕНИЯ(ПлатежноеПоручениеИсходящееОснования.Основание) В (&ТипыОснований_РазмещениеКредитногоИнструмента)
			|			ТОГДА ""РазмещениеКредитногоИнструмента""
			|	КОНЕЦ КАК ТипДокумента
			|ИЗ
			|	Документ.ПлатежноеПоручениеИсходящее.Основания КАК ПлатежноеПоручениеИсходящееОснования
			|ГДЕ
			|	ПлатежноеПоручениеИсходящееОснования.Ссылка = &Ссылка"); 
		
		Запрос.УстановитьПараметр("Ссылка", ПлатежноеПоручение);
		
		ТипыОснований_Оплата = Новый Массив;
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.НачислениеЗадолженности"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.Сделка"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.СделкаСНедвижимостью"));	
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.СделкаСМО"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.ОперацияНДС"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.Оплата"));
		ТипыОснований_Оплата.Добавить(Тип("ДокументСсылка.РасчетНДФЛПайщиков"));
		
		ТипыОснований_ВыводДенежныхСредств = Новый Массив;
		ТипыОснований_ВыводДенежныхСредств.Добавить(Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств"));
		ТипыОснований_ВыводДенежныхСредств.Добавить(Тип("ДокументСсылка.ПогашениеПаев"));
		
		ТипыОснований_ПереводДенежныхСредств = Новый Массив;
		ТипыОснований_ПереводДенежныхСредств.Добавить(Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств"));
		ТипыОснований_ПереводДенежныхСредств.Добавить(Тип("ДокументСсылка.ПереводДенежныхСредств"));
		ТипыОснований_ПереводДенежныхСредств.Добавить(Тип("ДокументСсылка.ВводДенежныхСредств"));
		
		ТипыОснований_РазмещениеКредитногоИнструмента = Новый Массив;
		ТипыОснований_РазмещениеКредитногоИнструмента.Добавить(Тип("ДокументСсылка.Распоряжение"));
		
		Запрос.УстановитьПараметр("ТипыОснований_Оплата",									ТипыОснований_Оплата);
		Запрос.УстановитьПараметр("ТипыОснований_ВыводДенежныхСредств",						ТипыОснований_ВыводДенежныхСредств);
		Запрос.УстановитьПараметр("ТипыОснований_ПереводДенежныхСредств",					ТипыОснований_ПереводДенежныхСредств);
		Запрос.УстановитьПараметр("ТипыОснований_РазмещениеКредитногоИнструмента",			ТипыОснований_РазмещениеКредитногоИнструмента);
			
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() > 0 Тогда
			
			Если ЗначениеЗаполнено(Результат[0].ТипДокумента) Тогда
				
				Если Результат[0].ТипДокумента = "Оплата" И Результат.Количество() > 1 Тогда
					
					// Доработаем позже
					Возврат Неопределено;
					
				ИначеЕсли Результат[0].ТипДокумента = "РазмещениеКредитногоИнструмента" Тогда	
					
					ДокументДДС = НайтиСоздатьРазмещениеДепозита(ПлатежноеПоручение, СтрокаБанковскойВыписки);
					
				ИначеЕсли ТипЗнч(Результат[0].Основание) = Тип("ДокументСсылка.ПереводДенежныхСредств")
					Или Результат[0].ТипДокумента = "Оплата" И ТипЗнч(Результат[0].Основание) = Тип("ДокументСсылка.Оплата") Тогда
					
					// Документ ДДС уже есть, осталось прикрепись к нему строку банковской выписки
					ДокументДДС = Результат[0].Основание.ПолучитьОбъект();
					
					ДокументДДС.СтрокаБанковскойВыписки = СтрокаБанковскойВыписки;
					
					Если Не РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат Неопределено;
					КонецЕсли;
					
				Иначе			
						
					ДокументДДС = Документы[Результат[0].ТипДокумента].СоздатьДокумент();
					
					Если Результат[0].ТипДокумента = "Оплата" Тогда
						ДокументДДС.ДополнительныеСвойства.Вставить("ЗагрузкаБанковскойВыписки", Истина);
					КонецЕсли;  
					
					Если ЗначениеЗаполнено(ПлатежноеПоручение.СчетДоверительногоУправления) Тогда
						ДокументДДС.СчетДоверительногоУправления = ПлатежноеПоручение.СчетДоверительногоУправления;
					КонецЕсли;
										
					ДокументДДС.Заполнить(Результат[0].Основание);
					Если Результат[0].ТипДокумента = "Оплата" Тогда
						
						Если Не ЗначениеЗаполнено(ДокументДДС.ВидДвижения) Тогда
							ДокументДДС.ВидДвижения = Перечисления.ВидыДвижений.Расход;
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(ДокументДДС.ВидЗадолженности) И Результат[0].Основание.Метаданные().Реквизиты.Найти("ВидЗадолженности") <> Неопределено Тогда
							ДокументДДС.ВидЗадолженности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат[0].Основание, "ВидЗадолженности");
						КонецЕсли;
						
						// При заполнении документа Оплата на основании документов начисления счет берется из документа начисления,
						// а нужно устанавливать фактический счет из выписки
						ДокументДДС.РасчетныйСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежноеПоручение, "РасчетныйСчет");
						
					КонецЕсли;
															
					ДокументДДС.Дата = Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка);
					
					Если Результат[0].ТипДокумента = "ВыводДенежныхСредств" Тогда
						
						// Заполняется в зависимости от вида договора
						
						ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументДДС.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
						
						Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР;
						ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
							Если ТипЗнч(ДокументДДС.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") 
									И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументДДС.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен
								Или ТипЗнч(ДокументДДС.Основание) = Тип("ДокументСсылка.ПогашениеПаев") 
									И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументДДС.Основание.Заявка, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен
							Тогда
								ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствПриОбменеПаев;
							Иначе	
								ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику;
							КонецЕсли; 	
						ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов Тогда
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения;
						Иначе
							ДокументДДС.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению;
						КонецЕсли;
						
						ДокументДДС.КоррСчет = БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(ДокументДДС.Дата, Организация, ДокументДДС.СчетДоверительногоУправления, ДокументДДС.ВидОперации);							
													
						Если Не ЗначениеЗаполнено(ДокументДДС.РасчетныйСчет) Тогда
							ДокументДДС.РасчетныйСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежноеПоручение, "РасчетныйСчет");		
						КонецЕсли;
						
						Если Не ЗначениеЗаполнено(ДокументДДС.РасчетныйСчетКонтрагента) Тогда
							ДокументДДС.РасчетныйСчетКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежноеПоручение, "РасчетныйСчетКонтрагента");		
						КонецЕсли;
						
					ИначеЕсли Результат[0].ТипДокумента = "ПереводДенежныхСредств" И ТипЗнч(Результат[0].Основание) = Тип("ДокументСсылка.ВводДенежныхСредств") Тогда
						
						РеквизитыВводаДС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат[0].Основание, "СчетДоверительногоУправления, Основание");
						ЗаполнитьЗначенияСвойств(ДокументДДС, РеквизитыВводаДС);
						
						РеквизитыСтрокиВыписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаБанковскойВыписки, "РасчетныйСчет, РасчетныйСчетКонтрагента, Сумма");
						ЗаполнитьЗначенияСвойств(ДокументДДС, РеквизитыСтрокиВыписки);
						ДокументДДС.РасчетныйСчетПолучатель = РеквизитыСтрокиВыписки.РасчетныйСчетКонтрагента;
						
						ДокументДДС.МестоХранения			= Справочники.МестаХранения.ВнебиржевойРынок;
						ДокументДДС.МестоХраненияПолучатель	= Справочники.МестаХранения.ВнебиржевойРынок;
						
						ДокументДДС.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументДДС.Организация, "ВалютаУчета");
						
					КонецЕсли;
						
					ДокументДДС.СтрокаБанковскойВыписки = СтрокаБанковскойВыписки;				
					
					// При отсутствии задолженности документ Оплата автоматически помечается на удаление, добавляется комментарий - выведем его 
					Если ДокументДДС.ПометкаУдаления Тогда
						
						ТекстСообщения = СтрШаблон("Не удалось создать документ '%1' по строке выписки '%2'", Результат[0].ТипДокумента, СтрокаБанковскойВыписки); 
						Если Не ПустаяСтрока(ДокументДДС.Комментарий) Тогда
							ТекстСообщения = ТекстСообщения + ", комментарий: " + СокрЛП(ДокументДДС.Комментарий);
						КонецЕсли;
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаБанковскойВыписки);
						
						Возврат Неопределено;
										
					КонецЕсли; 
					
					Если Не РаботаСДокументами.ЗаписатьПровестиДокумент(ДокументДДС) Тогда
						Возврат Неопределено;				
					КонецЕсли;                     			
					
				КонецЕсли;	
							
				Возврат ?(ДокументДДС = Неопределено, Неопределено, ДокументДДС.Ссылка);
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не определен тип документа движения денежных средств для ввода на основании документа %1", Результат[0].Основание), Результат[0].Основание);   
				Возврат Неопределено;
			КонецЕсли;               		
					
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Функция СтрокаБанковскиИспользуетсяВРеестреПлатежейВсейСуммой(СтрокаБанковскойВыписки, Сумма)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрПлатежей.ДвижениеДенежныхСредств КАК ДвижениеДенежныхСредств,
		|	СУММА(РеестрПлатежей.Сумма) КАК Сумма
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|ГДЕ
		|	РеестрПлатежей.СтрокаБанковскойВыписки = &СтрокаБанковскойВыписки
		|	И РеестрПлатежей.Активность
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрПлатежей.ДвижениеДенежныхСредств
		|
		|ИМЕЮЩИЕ
		|	СУММА(РеестрПлатежей.Сумма) = &Сумма");
	
	Запрос.УстановитьПараметр("СтрокаБанковскойВыписки",	СтрокаБанковскойВыписки);
	Запрос.УстановитьПараметр("Сумма",						Сумма);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции	

Функция НайтиДокументДвиженияДенежныхСредствПоЗначениюРеквизита(ВидДокумента, Реквизит, ЗначениеРеквизита, ДатаВыписки, СтатусПроведенияДокумента)
	
	Если СтатусПроведенияДокумента = "Проведен" Тогда
		УсловиеНаСостояниеДокумента = "Документ.Проведен";
	ИначеЕсли СтатусПроведенияДокумента = "НеПроведен" Тогда
		УсловиеНаСостояниеДокумента = "НЕ Документ.Проведен И НЕ Документ.ПометкаУдаления";
	Иначе	
		УсловиеНаСостояниеДокумента = "НЕ Документ.ПометкаУдаления";
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Ссылка
		|ИЗ
		|	&Документ КАК Документ
		|ГДЕ
		|	&УсловияНаДокумент");
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Документ", "Документ." + ВидДокумента);	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"&УсловияНаДокумент", 
						СтрШаблон("Документ.%1 = &ЗначениеРеквизита И %2 И Документ.Дата МЕЖДУ &НачалоДня И &КонецДня",
							Реквизит,
							УсловиеНаСостояниеДокумента));
	
	Запрос.УстановитьПараметр("ЗначениеРеквизита", ЗначениеРеквизита);
	Запрос.УстановитьПараметр("НачалоДня", 		   НачалоДня(ДатаВыписки));
	Запрос.УстановитьПараметр("КонецДня", 		   КонецДня(ДатаВыписки));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

Функция НайтиСоздатьРазмещениеДепозита(ПлатежноеПоручение, СтрокаБанковскойВыписки)
	
	// В платежном поручении по размещению кредитного инструмента в основаниях может быть только одно распоряжение,
	// поэтому смотрим только первую строку
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РазмещениеКредитногоИнструмента.Ссылка КАК РазмещениеКредитногоИнструмента,
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
		|	ДепозитныеВклады.Распоряжение КАК Распоряжение
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
		|		ПО ДепозитныеВклады.Ссылка = РазмещениеКредитногоИнструмента.КредитныйИнструмент
		|			И (НЕ РазмещениеКредитногоИнструмента.ПометкаУдаления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПлатежноеПоручениеОснования.Основание КАК Распоряжение
		|		ИЗ
		|			Документ.ПлатежноеПоручениеИсходящее.Основания КАК ПлатежноеПоручениеОснования
		|		ГДЕ
		|			ПлатежноеПоручениеОснования.Ссылка = &ПлатежноеПоручение
		|			И ПлатежноеПоручениеОснования.НомерСтроки = 1) КАК Распоряжения
		|		ПО ДепозитныеВклады.Распоряжение = Распоряжения.Распоряжение");
	
	Запрос.УстановитьПараметр("ПлатежноеПоручение", ПлатежноеПоручение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	 	
	Если Выборка.Следующий() Тогда
	
		Если ЗначениеЗаполнено(Выборка.РазмещениеКредитногоИнструмента) Тогда
			РазмещениеКредитногоИнструмента = Выборка.РазмещениеКредитногоИнструмента.ПолучитьОбъект();	
		Иначе
			РазмещениеКредитногоИнструмента = Документы.РазмещениеКредитногоИнструмента.СоздатьДокумент();
			
			РазмещениеКредитногоИнструмента.ДополнительныеСвойства.Вставить("ДепозитныйВклад", Выборка.ДепозитныйВклад);
			РазмещениеКредитногоИнструмента.Заполнить(Выборка.Распоряжение);
			
			РазмещениеКредитногоИнструмента.Дата = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаБанковскойВыписки, "Дата")) + 17 * 60 * 60 + 30 * 60;;
		КонецЕсли;
		
		РазмещениеКредитногоИнструмента.СтрокаБанковскойВыписки = СтрокаБанковскойВыписки;
		
		Если РаботаСДокументами.ЗаписатьПровестиДокумент(РазмещениеКредитногоИнструмента) Тогда		
			Возврат РазмещениеКредитногоИнструмента;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	
	Иначе
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден депозитный вклад для платежного поручения " + СокрЛП(ПлатежноеПоручение), ПлатежноеПоручение);
		Возврат Неопределено;	
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти
