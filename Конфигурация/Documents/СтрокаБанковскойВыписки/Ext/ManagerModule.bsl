
Функция БрокерскаяКомпанияПоЮрЛицуИлиРасчетномуСчету(Контрагент, Период, РасчетныйСчет) Экспорт
	
	Брокер = Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Контрагент, "БрокерскиеКомпании");
	
	Если ЗначениеЗаполнено(Брокер) Тогда 
		Возврат Брокер;		
	КонецЕсли;

	// такое бывает, когда брокер работает через р/счет, не принадлежащий брокеру
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Брокер КАК Брокер
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет = &РасчетныйСчет
		|	И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &ДатаЗакрытия
		|			ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
		
	Запрос.УстановитьПараметр("РасчетныйСчет", РасчетныйСчет);
	Запрос.УстановитьПараметр("ДатаЗакрытия",  Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Брокер;
	КонецЕсли;
	
	Возврат Справочники.БрокерскиеКомпании.ПустаяСсылка();
	
КонецФункции

Функция МестоХраненияДляРасчетногоСчета(РасчетныйСчет) Экспорт
	
	НомерСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РасчетныйСчет, "НомерСчета");
	Возврат ?(Лев(НомерСчета, 1) = "4", Справочники.МестаХранения.ВнебиржевойРынок, Справочники.МестаХранения.ПустаяСсылка());
	
КонецФункции

Функция СчетДоверительногоУправленияПоРасчетномуСчетуИИсполнителю(ДанныеПоРасчетномуСчетуИКонтрагенту) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &ДатаЗакрытия
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
		
	Запрос.УстановитьПараметр("Организация",   ДанныеПоРасчетномуСчетуИКонтрагенту.Организация);
	Запрос.УстановитьПараметр("РасчетныйСчет", ДанныеПоРасчетномуСчетуИКонтрагенту.РасчетныйСчет);
	Запрос.УстановитьПараметр("ДатаЗакрытия",  ДанныеПоРасчетномуСчетуИКонтрагенту.Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		
		//Значит, исполнитель используется не у одного счета ДУ и использовать первый счет ДУ некорректно
		//Если это ввод, поищем по контрагенту платежки
		Если ДанныеПоРасчетномуСчетуИКонтрагенту.ВидДокумента = "ВводДенежныхСредств" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Клиент = &Контрагент) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
			|ГДЕ
			|	(СчетаДоверительногоУправления.ДатаРасторжения >= &Период
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))";
			
			Запрос.УстановитьПараметр("Контрагент", ДанныеПоРасчетномуСчетуИКонтрагенту.Контрагент);
			Запрос.УстановитьПараметр("Период", 	ДанныеПоРасчетномуСчетуИКонтрагенту.Период);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Количество() = 1 И ВыборкаДетальныеЗаписи.Следующий() Тогда 
				Возврат ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У контрагента " + ДанныеПоРасчетномуСчетуИКонтрагенту.Контрагент + " действует более одного счета ДУ, поэтому нельзя однозначно определить счет ДУ по контрагенту из п/п.");
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет " + ДанныеПоРасчетномуСчетуИКонтрагенту.РасчетныйСчет + " используется для более одного счета ДУ, поэтому нельзя однозначно определить счет ДУ.");
		КонецЕсли;
		
	ИначеЕсли Выборка.Следующий() Тогда 
		Возврат Выборка.СчетДоверительногоУправления;
	КонецЕсли;

	Возврат Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
	
КонецФункции

Функция ВремяДокументаДвиженияДенежныхСредств(ДатаВыписки, ИспользуетсяПредварительнаяВыписка, ВидДвижения = "Расход") Экспорт
	
	ТекущаяДата			= ТекущаяДатаСеанса();                                  
	НачалоТекущейДаты	= НачалоДня(ТекущаяДата);
	НачалоДатыВыписки	= НачалоДня(ДатаВыписки);
	
	// Если в организации не используется загрузка предварительной выписки,
	// то поступления д/с на расчетый счет устанавливаем в 10-30
	Если Не ИспользуетсяПредварительнаяВыписка И ВидДвижения = "Приход" Тогда
		Возврат НачалоДатыВыписки + 10 * 60 * 60 + 30 * 60;
	Иначе	
		// При загрузке выписки день в день у новых документов устанавливаем текущее время, при загрузке на следующий день - 19-30	
		Возврат ?(НачалоДатыВыписки = НачалоТекущейДаты, 
								ТекущаяДата, 
								НачалоДатыВыписки + 19 * 60 * 60 + 30 * 60);
	КонецЕсли; 

КонецФункции

Функция ОрганизацияЗагружаетПредварительнуюВыписку(Организация) Экспорт
	
	Возврат Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")
		Или Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
		
КонецФункции

#Область Загрузка_выписки

Процедура ЗаполнитьСтрокиВыпискиИзФайлаЗагрузки(Организация, ПутьКФайлу, ТаблицаВыписки, Отказ) Экспорт
	
    Текст = Новый ТекстовыйДокумент;
	
	Попытка
		Текст.Прочитать(ПутьКФайлу);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Заполнение табличной части не выполнено!
			|При чтении файла '" + ПутьКФайлу + "' произошла ошибка.
			|Ошибка:
			|" + ОписаниеОшибки(),,,, Отказ);
		Возврат;
	КонецПопытки;
	
	БлокДанных = "";
	
	Для НомСтр = 1 По Текст.КоличествоСтрок() Цикл
		
		СтрокаТекста = СокрЛП(Текст.ПолучитьСтроку(НомСтр));
		
		Если СокрЛП(СтрокаТекста) = "КонецДокумента" Тогда
			
			ДатаПоступило	= Неопределено;
			ДатаСписано		= Неопределено;
			
			НоваяСтрокаВыписки = ТаблицаВыписки.Добавить();
			
			НоваяСтрокаВыписки.Данные       = БлокДанных;
			НоваяСтрокаВыписки.ДанныеСсылка = "Открыть";
			НоваяСтрокаВыписки.Флажок       = Ложь;
			
			НоваяСтрокаВыписки.УказанБИКПолучателя	= Истина;
			НоваяСтрокаВыписки.УказанБИКПлательщика	= Истина;
			
			НоваяСтрокаВыписки.РеквизитыПолучателя  = Новый Структура;
			НоваяСтрокаВыписки.РеквизитыПлательщика = Новый Структура;
			
			НоваяСтрокаВыписки.РеквизитыПлательщика.Вставить("Наименование", "");
			НоваяСтрокаВыписки.РеквизитыПлательщика.Вставить("ИНН", "");
			НоваяСтрокаВыписки.РеквизитыПлательщика.Вставить("КПП", "");
			НоваяСтрокаВыписки.РеквизитыПолучателя.Вставить("Наименование", "");
			НоваяСтрокаВыписки.РеквизитыПолучателя.Вставить("ИНН", "");
			НоваяСтрокаВыписки.РеквизитыПолучателя.Вставить("КПП", "");
			
			Для Инд = 1 По СтрЧислоСтрок(БлокДанных) Цикл
				СтрокаДанных = СтрПолучитьСтроку(БлокДанных, Инд);
				
				ПозицияРавно = Найти(СтрокаДанных, "=");
				
				ИмяРеквизита = Лев(СтрокаДанных, ПозицияРавно - 1);
				ЗнчРеквизита = СокрЛП(Сред(СтрокаДанных, ПозицияРавно + 1));
				
				Если      ИмяРеквизита = "СекцияДокумент" Тогда
					Если      ЗнчРеквизита = "Платежное поручение" Тогда
						НоваяСтрокаВыписки.ВидПлатежногоДокумента = Перечисления.ВидыПлатежныхДокументов.ПлатежноеПоручение;
					ИначеЕсли ЗнчРеквизита = "Платежное требование" Тогда
						НоваяСтрокаВыписки.ВидПлатежногоДокумента = Перечисления.ВидыПлатежныхДокументов.ПлатежноеТребование;
					ИначеЕсли ЗнчРеквизита = "Банковский ордер" Или ЗнчРеквизита = "Платежный ордер" Тогда
						НоваяСтрокаВыписки.ВидПлатежногоДокумента = Перечисления.ВидыПлатежныхДокументов.БанковскийОрдер;
					ИначеЕсли ЗнчРеквизита = "Мемориальный ордер" Тогда
						НоваяСтрокаВыписки.ВидПлатежногоДокумента = Перечисления.ВидыПлатежныхДокументов.МемориальныйОрдер;
					Иначе
						Сообщить("Неизвестный вид исходного документа " + ЗнчРеквизита);
					КонецЕсли;
					
				ИначеЕсли ИмяРеквизита = "Дата" Тогда
					НоваяСтрокаВыписки.Дата                    = Дата(Прав(ЗнчРеквизита, 4), Сред(ЗнчРеквизита, 4, 2), Лев(ЗнчРеквизита, 2));
					НоваяСтрокаВыписки.ДатаПлатежногоДокумента = НоваяСтрокаВыписки.Дата 
					
				ИначеЕсли ИмяРеквизита = "ДатаПоступило" Тогда
					Если ЗнчРеквизита <> "" Тогда
						ДатаПоступило			= Дата(Прав(ЗнчРеквизита, 4), Сред(ЗнчРеквизита, 4, 2), Лев(ЗнчРеквизита, 2));
						НоваяСтрокаВыписки.Дата = Дата(Прав(ЗнчРеквизита, 4), Сред(ЗнчРеквизита, 4, 2), Лев(ЗнчРеквизита, 2));
					КонецЕсли;
					
				ИначеЕсли ИмяРеквизита = "ДатаСписано" Тогда
					Если ЗнчРеквизита <> "" Тогда
						ДатаСписано				= Дата(Прав(ЗнчРеквизита, 4), Сред(ЗнчРеквизита, 4, 2), Лев(ЗнчРеквизита, 2));
						НоваяСтрокаВыписки.Дата = Дата(Прав(ЗнчРеквизита, 4), Сред(ЗнчРеквизита, 4, 2), Лев(ЗнчРеквизита, 2));
					КонецЕсли;
					
				ИначеЕсли ИмяРеквизита = "Сумма" Тогда
					НоваяСтрокаВыписки.Сумма = Число(ЗнчРеквизита);
					
				ИначеЕсли ИмяРеквизита = "Получатель1" Или ИмяРеквизита = "Получатель" Тогда // у всех банк-клиентов Получатель1, а у АБСОЛЮТ-а Получатель
					НоваяСтрокаВыписки.РеквизитыПолучателя.Наименование = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПолучательИНН" Тогда
					НоваяСтрокаВыписки.РеквизитыПолучателя.ИНН = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПолучательКПП" Тогда
					НоваяСтрокаВыписки.РеквизитыПолучателя.КПП = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПолучательБИК" Тогда
					НоваяСтрокаВыписки.ПолучательБИК = ЗнчРеквизита;	
					
				ИначеЕсли ИмяРеквизита = "ПолучательСчет" Тогда
					
					//Банк подменяет реальный номер счета своим, выделим номер счета из данных получателя
					Если Лев(ЗнчРеквизита,1) = "3" Тогда
						ПозРасчетногоСчета = ПозицияРасчетногоСчета(НоваяСтрокаВыписки.РеквизитыПолучателя.Наименование);
						Если ПозРасчетногоСчета <> 0 Тогда
							ЗнчРеквизита = Сред(НоваяСтрокаВыписки.РеквизитыПолучателя.Наименование, ПозРасчетногоСчета + 4, 20);
							НоваяСтрокаВыписки.УказанБИКПолучателя = Ложь;
						КонецЕсли; 
					КонецЕсли;

					НоваяСтрокаВыписки.ПолучательНомерСчета = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "Плательщик1" Или ИмяРеквизита = "Плательщик" Тогда // у всех банк-клиентов Плательщик1, а у АБСОЛЮТ-а Плательщик
					НоваяСтрокаВыписки.РеквизитыПлательщика.Наименование = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПлательщикИНН" Тогда
					НоваяСтрокаВыписки.РеквизитыПлательщика.ИНН = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПлательщикКПП" Тогда
					НоваяСтрокаВыписки.РеквизитыПлательщика.КПП = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПлательщикБИК" Тогда					
					НоваяСтрокаВыписки.ПлательщикБИК = ЗнчРеквизита;
					
				ИначеЕсли ИмяРеквизита = "ПлательщикСчет" Тогда
					//Банк подменяет реальный номер счета своим, выделим номер счета из данных плательщика
					Если Лев(ЗнчРеквизита,1) = "3" Тогда
						ПозРасчетногоСчета = ПозицияРасчетногоСчета(НоваяСтрокаВыписки.РеквизитыПлательщика.Наименование);
						Если ПозРасчетногоСчета <> 0 Тогда
							ЗнчРеквизита = Сред(НоваяСтрокаВыписки.РеквизитыПлательщика.Наименование, ПозРасчетногоСчета + 4, 20);
							НоваяСтрокаВыписки.УказанБИКПлательщика = Ложь;
						КонецЕсли; 
					КонецЕсли; 
					
					НоваяСтрокаВыписки.ПлательщикНомерСчета = ЗнчРеквизита;
					
				Иначе
					Попытка
						НоваяСтрокаВыписки[ИмяРеквизита] = ЗнчРеквизита;
					Исключение
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ДатаПоступило) И ЗначениеЗаполнено(ДатаСписано) Тогда //одно и то же, но оставим чтобы было понятно, что если есть две даты, то это перемещение
				НоваяСтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Расход;
				
				ВтораяЧастьВыписки = ТаблицаВыписки.Добавить();
				
				ВтораяЧастьВыписки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
				ЗаполнитьЗначенияСвойств(ВтораяЧастьВыписки, НоваяСтрокаВыписки,, "ВидДвижения");
				
			ИначеЕсли ЗначениеЗаполнено(ДатаСписано) Тогда //одно и то же, но оставим чтобы было понятно
				НоваяСтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Расход;
			ИначеЕсли ЗначениеЗаполнено(ДатаПоступило) Тогда
				НоваяСтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Приход;
			КонецЕсли;
			
		ИначеЕсли Найти(СтрокаТекста, "СекцияДокумент") > 0 Тогда
			БлокДанных = СтрокаТекста + Символы.ПС; // + Символы.ВК;
			
		ИначеЕсли БлокДанных <> "" Тогда
			БлокДанных = БлокДанных + СтрокаТекста  + Символы.ПС; // + Символы.ВК;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого СтрокаВыписки Из ТаблицаВыписки Цикл
		ЗаполнитьДанныеСтрокиВыписки(Организация, СтрокаВыписки);
	КонецЦикла;
	
	ТаблицаВыписки.Сортировать("Статус, ВидДвижения, Номер");
	
	// Удаляем лишние строки - у них статус 9
	СтрокиКУдалению = ТаблицаВыписки.НайтиСтроки(Новый Структура("Статус", 9));     
	
	КоличествоСтрокКУдалению 	= СтрокиКУдалению.Количество();
	ИндексПоследнейСтроки		= ТаблицаВыписки.Количество() - 1;	
	Если КоличествоСтрокКУдалению > 0 Тогда
		Для Сч = 0 По КоличествоСтрокКУдалению - 1 Цикл               	
			ТаблицаВыписки.Удалить(ИндексПоследнейСтроки - Сч);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

Процедура ЗаполнитьДанныеСтрокиВыписки(Организация, СтрокаВыписки) Экспорт

	Если Не ЗначениеЗаполнено(СтрокаВыписки.ПолучательСчет) Тогда // может быть заполнен вручную
		СтрокаВыписки.ПолучательСчет = ПолучитьБанковскийСчет(Организация, СтрокаВыписки.ПолучательНомерСчета, СтрокаВыписки.ПолучательБИК, СтрокаВыписки.РеквизитыПолучателя.ИНН, СтрокаВыписки.Дата, СтрокаВыписки.Получатель, СтрокаВыписки.УказанБИКПолучателя);		
		Если Не ЗначениеЗаполнено(СтрокаВыписки.Получатель) Тогда
			СтрокаВыписки.Получатель = ПолучитьЮрФизЛицо(СтрокаВыписки.РеквизитыПолучателя, СтрокаВыписки.Дата, Организация);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаВыписки.ПлательщикСчет) Тогда // может быть заполнен вручную
		СтрокаВыписки.ПлательщикСчет = ПолучитьБанковскийСчет(Организация, СтрокаВыписки.ПлательщикНомерСчета, СтрокаВыписки.ПлательщикБИК, СтрокаВыписки.РеквизитыПлательщика.ИНН, СтрокаВыписки.Дата, СтрокаВыписки.Плательщик, СтрокаВыписки.УказанБИКПлательщика);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаВыписки.Плательщик) Тогда // может быть заполнен вручную
		СтрокаВыписки.Плательщик = ПолучитьЮрФизЛицо(СтрокаВыписки.РеквизитыПлательщика, СтрокаВыписки.Дата, Организация);
	КонецЕсли;

	Если ТипЗнч(СтрокаВыписки.Получатель) = Тип("Строка") Или ТипЗнч(СтрокаВыписки.Плательщик) = Тип("Строка") Тогда
		СтрокаВыписки.Статус = 0;
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = Новый Структура("Организация, ВидПлатежногоДокумента, НомерПлатежногоДокумента, ДатаПлатежногоДокумента, Сумма, НазначениеПлатежа, Ответственный, ИсходныеДанные",
		Организация, СтрокаВыписки.ВидПлатежногоДокумента, СтрокаВыписки.Номер, СтрокаВыписки.ДатаПлатежногоДокумента, СтрокаВыписки.Сумма, СтрокаВыписки.НазначениеПлатежа, РаботаСПользователями.ТекущийПользователь(), СтрокаВыписки.Данные);
		
	ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо");
		
	Если СтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда // мы - плательщик
		РеквизитыДокумента.Вставить("РасчетныйСчет",            СтрокаВыписки.ПлательщикСчет);
		РеквизитыДокумента.Вставить("Контрагент",               СтрокаВыписки.Получатель);
		РеквизитыДокумента.Вставить("РасчетныйСчетКонтрагента", СтрокаВыписки.ПолучательСчет);
		РеквизитыДокумента.Вставить("ВидДвижения",              СтрокаВыписки.ВидДвижения);
		
		// расчетный счет должен быть заполнен
		Если ТипЗнч(РеквизитыДокумента.РасчетныйСчет) = Тип("Строка") Тогда
			СтрокаВыписки.Статус = 0;
			Возврат;
		КонецЕсли;
		
		// расчетный счет контрагента должен быть заполнен только тогда, когда он задан
		Если Не ПустаяСтрока(СтрокаВыписки.ПолучательНомерСчета) И ТипЗнч(РеквизитыДокумента.РасчетныйСчетКонтрагента) = Тип("Строка") Тогда
			СтрокаВыписки.Статус = 0;
			Возврат;
		КонецЕсли;
		
	ИначеЕсли СтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда // мы - получатель
        РеквизитыДокумента.Вставить("РасчетныйСчет",            СтрокаВыписки.ПолучательСчет);
		РеквизитыДокумента.Вставить("Контрагент",               СтрокаВыписки.Плательщик);
		РеквизитыДокумента.Вставить("РасчетныйСчетКонтрагента", СтрокаВыписки.ПлательщикСчет);
		РеквизитыДокумента.Вставить("ВидДвижения",              СтрокаВыписки.ВидДвижения);
		
		// расчетный счет должен быть заполнен
		Если Не ЗначениеЗаполнено(РеквизитыДокумента.РасчетныйСчет) Тогда
			СтрокаВыписки.Статус = 0;
			Возврат;
		КонецЕсли;
		
		// расчетный счет контрагента должен быть заполнен только тогда, когда он задан
		Если Не ПустаяСтрока(СтрокаВыписки.ПлательщикНомерСчета) И ТипЗнч(РеквизитыДокумента.РасчетныйСчетКонтрагента) = Тип("Строка") Тогда
			СтрокаВыписки.Статус = 0;
			Возврат;
		КонецЕсли;
		
	Иначе 
		
		// не загружаем, регистрировать ошибку не нужно (банк выгружает неисполненные платежки)
		ТекстОшибки = "Не удалось определить направление движения документа " + СтрокаВыписки.ВидПлатежногоДокумента + " с номером " + СтрокаВыписки.Номер + " от " + Формат(СтрокаВыписки.ДатаПлатежногоДокумента, "ДФ=dd.MM.yyyy");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
		СтрокаВыписки.Статус = 0;
		Возврат;
		
	КонецЕсли;
	
	//Отсекаем движения по счетам депозитов (некоторые банки выгружают выписки по всем открытым счетам)
	// В таких строках устанавливаем статус 9	
	Если ТипЗнч(РеквизитыДокумента.РасчетныйСчет) = Тип("СправочникСсылка.БанковскиеСчета") 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.РасчетныйСчет, "ВидБанковскогоСчета") = Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет Тогда
		СтрокаВыписки.Статус = 9;
		Возврат;
	КонецЕсли;
	
	СтрокаВыписки.Реквизиты = РеквизитыДокумента;
	
	ПлатежныеДокументы = ПолучитьПлатежныеДокументы(
			Организация,
			СтрокаВыписки.ДатаПлатежногоДокумента,
			СтрокаВыписки.Номер,
			РеквизитыДокумента.РасчетныйСчет,
			РеквизитыДокумента.РасчетныйСчетКонтрагента,
			РеквизитыДокумента.Сумма,
			РеквизитыДокумента.ВидДвижения);
			
	СтрокаВыписки.Ссылка 							= ПлатежныеДокументы.СтрокаБанковскойВыписки;
	СтрокаВыписки.ПлатежноеПоручение				= ПлатежныеДокументы.ПлатежноеПоручение;
	СтрокаВыписки.ДокументДвиженияДенежныхСредств	= ПлатежныеДокументы.ДокументДвиженияДенежныхСредств;
	
	Если ЗначениеЗаполнено(СтрокаВыписки.Ссылка) Тогда
		СтрокаВыписки.Статус = 2;
		СтрокаВыписки.Флажок = Ложь;
	Иначе
		СтрокаВыписки.Статус = 1;
		СтрокаВыписки.Флажок = Истина;
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьПлатежныеДокументы(Организация, ДатаПлатежногоДокумента, Номер, РасчетныйСчет, РасчетныйСчетКонтрагента, Сумма, ВидДвижения)
	
	Результат = Новый Структура("СтрокаБанковскойВыписки, ПлатежноеПоручение, ДокументДвиженияДенежныхСредств");
	
	// если р/счет и р/счет контрагента принадлежат организации, 
	// то определить, что это (приход или расход), практически не возможно; 
	// загружаем как повезет, а девочки, при необходимости, меняют счета местами
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СтрокаБанковскойВыписки.Ссылка КАК СтрокаБанковскойВыписки
	    |ПОМЕСТИТЬ _СтрокиВыписки
	    |ИЗ
	    |	Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
	    |ГДЕ
	    |	СтрокаБанковскойВыписки.Организация = &Организация
	    |	И СтрокаБанковскойВыписки.ДатаПлатежногоДокумента = &ДатаПлатежногоДокумента
	    |	И СтрокаБанковскойВыписки.НомерПлатежногоДокумента = &НомерПлатежногоДокументаСтр
	    |	И СтрокаБанковскойВыписки.ВидДвижения = &ВидДвижения
	    |	И СтрокаБанковскойВыписки.Сумма = &Сумма
	    |	И (СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента = &РасчетныйСчетКонтрагента
	    |				И СтрокаБанковскойВыписки.РасчетныйСчет = &РасчетныйСчет
	    |			ИЛИ СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента = &РасчетныйСчет
	    |				И СтрокаБанковскойВыписки.РасчетныйСчет = &РасчетныйСчетКонтрагента)
	    |	И НЕ СтрокаБанковскойВыписки.ПометкаУдаления
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ПлатежноеПоручениеИсходящее.Ссылка КАК Документ,
	    |	""ПлатежноеПоручение"" КАК ИмяРеквизита
	    |ИЗ
	    |	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	    |ГДЕ
	    |	ПлатежноеПоручениеИсходящее.Организация = &Организация
	    |	И НАЧАЛОПЕРИОДА(ПлатежноеПоручениеИсходящее.Дата, ДЕНЬ) = &ДатаПлатежногоДокумента
	    |	И ПлатежноеПоручениеИсходящее.НомерПлатежногоПоручения = &НомерПлатежногоДокумента
	    |	И ПлатежноеПоручениеИсходящее.РасчетныйСчетКонтрагента = &РасчетныйСчетКонтрагента
	    |	И ПлатежноеПоручениеИсходящее.РасчетныйСчет = &РасчетныйСчет
	    |	И НЕ ПлатежноеПоручениеИсходящее.ПометкаУдаления
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	_СтрокиВыписки.СтрокаБанковскойВыписки,
	    |	""СтрокаБанковскойВыписки""
	    |ИЗ
	    |	_СтрокиВыписки КАК _СтрокиВыписки
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	РеестрПлатежей.ДвижениеДенежныхСредств,
	    |	""ДокументДвиженияДенежныхСредств""
	    |ИЗ
	    |	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтрокиВыписки КАК _СтрокиВыписки
	    |		ПО РеестрПлатежей.СтрокаБанковскойВыписки = _СтрокиВыписки.СтрокаБанковскойВыписки";

	Запрос.УстановитьПараметр("Организация",              		Организация);
	Запрос.УстановитьПараметр("ДатаПлатежногоДокумента",  		ДатаПлатежногоДокумента);
	Запрос.УстановитьПараметр("НомерПлатежногоДокумента", 		Число(Номер));
	Запрос.УстановитьПараметр("НомерПлатежногоДокументаСтр",	Номер);
	Запрос.УстановитьПараметр("РасчетныйСчет",            		РасчетныйСчет);
	Запрос.УстановитьПараметр("РасчетныйСчетКонтрагента", 		РасчетныйСчетКонтрагента);
	Запрос.УстановитьПараметр("Сумма",                    		Сумма);
	Запрос.УстановитьПараметр("ВидДвижения",              		ВидДвижения);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Результат[Выборка.ИмяРеквизита] = Выборка.Документ;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции 

Функция ПолучитьЮрФизЛицо(Реквизиты, Период, Организация)
	
	Реквизиты.ИНН = ?(Реквизиты.ИНН = "0", "", Реквизиты.ИНН);
	Реквизиты.КПП = ?(Реквизиты.КПП = "0", "", Реквизиты.КПП);
	
	Если (ПустаяСтрока(Реквизиты.ИНН) Или Реквизиты.ИНН = "000000000000") И Не ПустаяСтрока(Реквизиты.Наименование) Тогда // для физиков-пайщиков очень часто ИНН не указывается
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
			|ГДЕ
			|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество = &Наименование
			|	И НЕ РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо.ПометкаУдаления";
			
		Запрос.УстановитьПараметр("Период",       Период);
		Запрос.УстановитьПараметр("Организация",  Организация);
		Запрос.УстановитьПараметр("Наименование", Реквизиты.Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЮрФизЛицо;
		КонецЕсли;
		
		Возврат "Не найден " + Реквизиты.Наименование;
	КонецЕсли;	
	
	Если      Реквизиты.ИНН = "7744001497" И Реквизиты.КПП = "775001001" Тогда // ГПБ
		Реквизиты.КПП = "997950001";
	ИначеЕсли Реквизиты.ИНН = "7730149408" Тогда // РЭМ
		Реквизиты.КПП = "770601001";
	ИначеЕсли Реквизиты.ИНН = "7729405872" Тогда // ЗЕНИТ
		Реквизиты.КПП = "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|ГДЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН = &ИНН
		|	И (РеквизитыЮридическихЛицСрезПоследних.КПП = &КПП
		|			ИЛИ &КПП = """")
		|	И НЕ РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо.Ссылка
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|ГДЕ
		|	РеквизитыФизическихЛицСрезПоследних.ИНН = &ИНН
		|	И НЕ РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо.ПометкаУдаления";

	Запрос.УстановитьПараметр("ИНН",    	 Реквизиты.ИНН);
	Запрос.УстановитьПараметр("КПП",    	 Реквизиты.КПП);
	Запрос.УстановитьПараметр("Период", 	 Период);
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат "Не найден " + Реквизиты.Наименование;

КонецФункции

Функция ПолучитьБанковскийСчет(Организация, НомерСчета, БИК, ИНН, Период, ЮрФизЛицо, ПроверятьБИК = Истина)

	Если ПустаяСтрока(НомерСчета) Тогда 
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА Банки.Код = &БИК
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НайденПоБИК
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|		ПО БанковскиеСчета.Банк = Банки.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО БанковскиеСчета.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	БанковскиеСчета.НомерСчета = &НомерСчета
		|	И БанковскиеСчета.Организация = &Организация
		|	И НЕ БанковскиеСчета.ПометкаУдаления
		|	И (НЕ Банки.ЭтоТерриториальныйОрганФедеральногоКазначейства
		|			ИЛИ ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ИНН, """") = &ИНН)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НайденПоБИК УБЫВ";

	// 1. При поиске достаточно найти банковский счет по номеру и БИК; 
	// 	  кроме того, банки, особенно ГПБ, очень часто вместо реального контрагента
	// 	  подставляют себя любимых, а в счетах контрагенты худо-бедно выверены
	// 2. Для бюджетных платежей номера счетов могут дублироваться, отличаем по ИНН
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("БИК", БИК);

	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоСчетов = Выборка.Количество();
	БанковскийСчет = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		Если (Не ПроверятьБИК Или Выборка.НайденПоБИК)
				И БанковскийСчет = Неопределено Тогда
			ЮрФизЛицо = Выборка.ЮрФизЛицо;
			БанковскийСчет = Выборка.Ссылка;
			Продолжить;
		КонецЕсли;
		
		Если Не Выборка.НайденПоБИК И ПроверятьБИК Тогда
			КомментарийКОшибке = "Не найден по БИК " + БИК;
		Иначе	
			КомментарийКОшибке = "Имеются дубли по номеру счета " + НомерСчета;
		КонецЕсли;			
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Необходимо проверить счет %1: %2", Выборка.Ссылка, КомментарийКОшибке), Выборка.Ссылка);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат БанковскийСчет;
	ИначеЕсли КоличествоСчетов > 1 Тогда
		Возврат "Найдено несколько " + НомерСчета + ", у которых БИК не соответствует загружаемому " + БИК;
	Иначе
		Возврат "Не найден " + НомерСчета + ", БИК " + БИК;
	КонецЕсли;

КонецФункции // ПолучитьБанковскийСчет

Функция ПозицияРасчетногоСчета(Текст)
	
	// строка "р/с" может быть частично или полностью написана латиницей
	МассивВариантов = Новый Массив;
	МассивВариантов.Добавить("р/с");
	МассивВариантов.Добавить("p/c");
	МассивВариантов.Добавить("p/с");
	МассивВариантов.Добавить("р/c");	
	
	Для Каждого Вариант Из МассивВариантов Цикл
		НомерСимвола = СтрНайти(Текст, Вариант + " ");
		Если НомерСимвола > 0 Тогда
			Возврат НомерСимвола;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Процедура СформироватьДокументыПоСтрокамБанковскойВыписки(Организация, ТаблицаВыписки, ИспользуетсяПредварительнаяВыписка) Экспорт
	
	Для каждого СтрокаВыписки Из ТаблицаВыписки Цикл
		
		Если Не СтрокаВыписки.Флажок Тогда
			Продолжить;
		КонецЕсли;
				
		Если СтрокаВыписки.Ссылка = Документы.СтрокаБанковскойВыписки.ПустаяСсылка() Тогда
			Документ = Документы.СтрокаБанковскойВыписки.СоздатьДокумент();
			Документ.Дата = СтрокаВыписки.Дата;
		Иначе
			Документ = СтрокаВыписки.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Документ, СтрокаВыписки.Реквизиты);
		
		Если Не ЗначениеЗаполнено(Документ.ПлатежноеПоручение) Тогда
			Документ.ПлатежноеПоручение = СтрокаВыписки.ПлатежноеПоручение;
		КонецЕсли;
				
		Попытка 
			Документ.Записать();
		Исключение  
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());			
			Продолжить;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Документ.ПлатежноеПоручение) Тогда
			НачатьТранзакцию();
			РегистрыСведений.СтатусыИсходящихПлатежныхПоручений.УстановитьСтатусПлатежногоПоручения(Документ.Организация, Документ.ПлатежноеПоручение, Перечисления.СтатусыПлатежныхПоручений.Исполнено);			
			ЗафиксироватьТранзакцию();			
		КонецЕсли;
						
		// Создаем документы движения денежных средств
		Если ЗначениеЗаполнено(СтрокаВыписки.ПлатежноеПоручение) И Не ЗначениеЗаполнено(СтрокаВыписки.ДокументДвиженияДенежныхСредств) Тогда
			
			СтрокаВыписки.ДокументДвиженияДенежныхСредств = СформироватьДокументДвиженияДенежныхСредств(Документ.Ссылка, Документ.Дата, ИспользуетсяПредварительнаяВыписка, Организация, СтрокаВыписки.ПлатежноеПоручение);
						
			// Если в платежном поручении не заполнены основания, заполняем
			Если ЗначениеЗаполнено(СтрокаВыписки.ДокументДвиженияДенежныхСредств) И СтрокаВыписки.ПлатежноеПоручение.Основания.Количество() = 0 Тогда
				
				ПлатежноеПоручение				= СтрокаВыписки.ПлатежноеПоручение.ПолучитьОбъект();
				НоваяСтрокаОснования			= ПлатежноеПоручение.Основания.Добавить();
				НоваяСтрокаОснования.Основание	= СтрокаВыписки.ДокументДвиженияДенежныхСредств;
								
				Попытка 
					ПлатежноеПоручение.Записать();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());					
					Продолжить; 				
				КонецПопытки;			
				
			КонецЕсли;			
			
		ИначеЕсли СтрокаВыписки.ВидДвижения = Перечисления.ВидыДвижений.Приход И Не ЗначениеЗаполнено(СтрокаВыписки.ДокументДвиженияДенежныхСредств) Тогда
			
			СтрокаВыписки.ДокументДвиженияДенежныхСредств = СформироватьДокументДвиженияДенежныхСредств(Документ.Ссылка, Документ.Дата, ИспользуетсяПредварительнаяВыписка, Организация);
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры	

Функция СформироватьДокументДвиженияДенежныхСредств(СтрокаБанковскойВыписки, ДатаВыписки, ИспользуетсяПредварительнаяВыписка, Организация, ПлатежноеПоручение = Неопределено)
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	// Если нет платежного поручения, то это приход денежных средств
	Если ПлатежноеПоручение = Неопределено Тогда
		
		// Приход процентов МНО		
		// Закрытие депозитов с приходом процентов		
		// Погашение ЦБ и купонов                
		// Перевод денежных средств
		// Ввод денежных средств
		
		РеквизитыСтрокиБанковскойВыписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаБанковскойВыписки, "НазначениеПлатежа, РасчетныйСчет, РасчетныйСчетКонтрагента, Сумма, Контрагент");
		
		НазначениеПлатежа = НРег(РеквизитыСтрокиБанковскойВыписки.НазначениеПлатежа);
		
		МассивСимволовНомера = Новый Массив;
		МассивСимволовНомера.Добавить("№");
		МассивСимволовНомера.Добавить("№ ");
		МассивСимволовНомера.Добавить("N");
		МассивСимволовНомера.Добавить("N ");	
		
		#Область Текст_запроса
		
		// Собираем данные по регистрам на конец дня, чтобы получить документы-основания
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	""ПриходПроцентовМНО"" КАК ВидДокумента,
			|	ДенежныеСредстваМНООстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДенежныеСредстваМНООстатки.МНО КАК Основание,
			|	ДенежныеСредстваМНООстатки.РасчетныйСчет КАК РасчетныйСчет,
			|	ДенежныеСредстваМНООстатки.МНО.РасчетныйСчет.ДоговорМНО.НомерДоговора КАК ОсновнойИдентификатор,
			|	ВЫБОР
			|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000001"" И ""000009""
			|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 6, 1)
			|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000010"" И ""000099""
			|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 5, 2)
			|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000100"" И ""000999""
			|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 4, 3)
			|		КОГДА НомераОбъектов.Номер МЕЖДУ ""001000"" И ""009999""
			|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 3, 4)
			|		КОГДА НомераОбъектов.Номер МЕЖДУ ""010000"" И ""099999""
			|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 2, 5)
			|		ИНАЧЕ НомераОбъектов.Номер
			|	КОНЕЦ КАК ДополнительныйИдентификатор,
			|	ДенежныеСредстваМНООстатки.СуммаОстаток КАК СуммаОстаток,
			|	0 КАК СуммаКупонаОстаток,
			|	NULL КАК Дата,
			|	ЛОЖЬ КАК ГенСоглашение,
			|	NULL КАК Контрагент,
			|	NULL КАК МестоХранения
			|ПОМЕСТИТЬ _Основания
			|ИЗ
			|	РегистрНакопления.ДенежныеСредстваМНО.Остатки(
			|			&КонецПредыдущегоДняГраница,
			|			Организация = &Организация
			|				И РасчетныйСчет = &РасчетныйСчет
			|				И МНО.ДатаВозврата = &НачалоДня) КАК ДенежныеСредстваМНООстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
			|		ПО (НомераОбъектов.Организация = ДенежныеСредстваМНООстатки.Организация)
			|			И (НомераОбъектов.СчетДоверительногоУправления = ДенежныеСредстваМНООстатки.СчетДоверительногоУправления)
			|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
			|			И ДенежныеСредстваМНООстатки.МНО.Основание = НомераОбъектов.Объект
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Оплата"",
			|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание,
			|	НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеКупона)
			|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеКупона).Облигация.ГосударственныйРегистрационныйНомер
			|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
			|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеДивидендов).ЦеннаяБумага.ГосударственныйРегистрационныйНомер
			|		ИНАЧЕ ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага.ГосударственныйРегистрационныйНомер
			|	КОНЕЦ,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
			|			ТОГДА &Сумма
			|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
			|	КОНЕЦ,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток,
			|	NULL,
			|	ЛОЖЬ,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент,
			|	NULL
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&КонецДняГраница,
			|			Организация = &Организация
			|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции))) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаДоходовПоЦеннымБумагам.СрезПоследних(&КонецДняГраница, Организация = &Организация) КАК НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Организация = НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Организация
			|			И ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления = НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.СчетДоверительногоУправления
			|			И ЗадолженностиПоДенежнымСредствамОстатки.Валюта = НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.Валюта
			|			И (НастройкиУчетаДоходовПоЦеннымБумагамСрезПоследних.РасчетныйСчет = &РасчетныйСчет)
			|ГДЕ
