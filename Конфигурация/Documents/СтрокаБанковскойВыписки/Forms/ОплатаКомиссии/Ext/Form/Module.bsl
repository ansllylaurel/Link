&НаКлиенте
Процедура КомиссияПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Комиссия.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// редактировать разрешено только номер, дату с/ф и флажок для строк со статусом 1
	Если ТекущиеДанные.Статус = 1
		И (Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияНомерСФ
			Или Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияДатаСФ
			Или Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияФлажок)
	Тогда
		Возврат;
	КонецЕсли;
	
	// все прочие поля штатно не редактируются
	Отказ = Истина;
	
	Если Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияСтрокаБанковскойВыписки
		И ЗначениеЗаполнено(ТекущиеДанные.СтрокаБанковскойВыписки)
	Тогда
		ОткрытьЗначение(ТекущиеДанные.СтрокаБанковскойВыписки);
		
	ИначеЕсли Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияНачислениеЗадолженности
		И ЗначениеЗаполнено(ТекущиеДанные.НачислениеЗадолженности)
	Тогда
		ОткрытьЗначение(ТекущиеДанные.НачислениеЗадолженности);
		
	ИначеЕсли Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияОплата
		И ЗначениеЗаполнено(ТекущиеДанные.Оплата)
	Тогда
		ОткрытьЗначение(ТекущиеДанные.Оплата);
		
	ИначеЕсли Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияСчетДоверительногоУправления
		И ЗначениеЗаполнено(ТекущиеДанные.СчетДоверительногоУправления)
	Тогда
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
		
	ИначеЕсли Элементы.Комиссия.ТекущийЭлемент = Элементы.КомиссияРасчетныйСчет
		И ЗначениеЗаполнено(ТекущиеДанные.РасчетныйСчет)
	Тогда
		ОткрытьЗначение(ТекущиеДанные.РасчетныйСчет);
		
	КонецЕсли;
	
КонецПроцедуры


