
&НаСервереБезКонтекста
Функция СформироватьИтоговуюСтроку(Знач ДанныеКомиссии)
	
	ИтоговаяСтрока = "";
	
	ПоказателиИтоговойСтроки = Новый ТаблицаЗначений;
	ПоказателиИтоговойСтроки.Колонки.Добавить("Флажок");
	ПоказателиИтоговойСтроки.Колонки.Добавить("Статус");
	ПоказателиИтоговойСтроки.Колонки.Добавить("Валюта");
	ПоказателиИтоговойСтроки.Колонки.Добавить("Сумма");
	
	Для каждого СтрокаДанныеКомиссии Из ДанныеКомиссии Цикл
		НоваяСтрокаПоказателиИтоговойСтроки = ПоказателиИтоговойСтроки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПоказателиИтоговойСтроки, СтрокаДанныеКомиссии);
		
		Если      НоваяСтрокаПоказателиИтоговойСтроки.Флажок = 1 Тогда // выбрано
			НоваяСтрокаПоказателиИтоговойСтроки.Статус = 1;
		ИначеЕсли НоваяСтрокаПоказателиИтоговойСтроки.Статус = 1 Тогда // не выбрано
			НоваяСтрокаПоказателиИтоговойСтроки.Статус = 2;
		ИначеЕсли НоваяСтрокаПоказателиИтоговойСтроки.Статус = 2 Тогда // обработано ранее
			НоваяСтрокаПоказателиИтоговойСтроки.Статус = 3;
		ИначеЕсли НоваяСтрокаПоказателиИтоговойСтроки.Статус = 0 Тогда // ошибки
			НоваяСтрокаПоказателиИтоговойСтроки.Статус = 4;
		КонецЕсли;
	КонецЦикла;
	
	ПоказателиИтоговойСтроки.Свернуть("Статус, Валюта", "Сумма");
	ПоказателиИтоговойСтроки.Сортировать("Статус, Валюта");
	
	ЗафиксированныеСтатусы = Новый Массив();
	
	Для каждого СтрокаПоказателиИтоговойСтроки Из ПоказателиИтоговойСтроки Цикл
		Если ЗафиксированныеСтатусы.Найти(СтрокаПоказателиИтоговойСтроки.Статус) = Неопределено Тогда
			ИтоговаяСтрока = ИтоговаяСтрока + ?(ПустаяСтрока(ИтоговаяСтрока), "", "; ");
			
			Если      СтрокаПоказателиИтоговойСтроки.Статус = 1 Тогда
				ИтоговаяСтрока = ИтоговаяСтрока + "Выбрано "
			ИначеЕсли СтрокаПоказателиИтоговойСтроки.Статус = 2 Тогда
				ИтоговаяСтрока = ИтоговаяСтрока + "Не выбрано "
			ИначеЕсли СтрокаПоказателиИтоговойСтроки.Статус = 3 Тогда
				ИтоговаяСтрока = ИтоговаяСтрока + "Обработано ранее "
			ИначеЕсли СтрокаПоказателиИтоговойСтроки.Статус = 4 Тогда
				ИтоговаяСтрока = ИтоговаяСтрока + "Ошибки "
			КонецЕсли;
			
			ЗафиксированныеСтатусы.Добавить(СтрокаПоказателиИтоговойСтроки.Статус);
		КонецЕсли;
		
		ИтоговаяСтрока = ИтоговаяСтрока + СтрокаПоказателиИтоговойСтроки.Сумма + " " + СтрокаПоказателиИтоговойСтроки.Валюта;
	КонецЦикла;
	
	Возврат ИтоговаяСтрока;
	
КонецФункции // СформироватьИтоговуюСтроку

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоговыеСуммы(Форма)
	
	Форма.Элементы.ДекорацияИтого.Заголовок = СформироватьИтоговуюСтроку(Форма.Комиссия);
	
КонецПроцедуры // ДанныеКомиссии


&НаСервере
Процедура ОбновитьКомиссиюНаСервере()
	
	ЭтаФорма.Комиссия.Очистить();
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ВидКомиссии) Или Не ЗначениеЗаполнено(ЭтаФорма.Период)
		Или Не ЗначениеЗаполнено(ЭтаФорма.Контрагент) Или Не ЗначениеЗаполнено(ЭтаФорма.РасчетныйСчетКонтрагента)
		Или Не ЗначениеЗаполнено(ЭтаФорма.Организация)
	Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеЗадолженностиОснования.Ссылка КАК Ссылка,
		|	НачислениеЗадолженностиОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НачислениеЗадолженностиОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
		|	СУММА(НачислениеЗадолженностиОснования.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _НачислениеЗадолженности
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|ГДЕ
		|	НачислениеЗадолженностиОснования.Ссылка.Проведен
		|	И НачислениеЗадолженностиОснования.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И НачислениеЗадолженностиОснования.Ссылка.Организация = &Организация
		|	И НачислениеЗадолженностиОснования.Ссылка.ВидЗадолженности = &ВидЗадолженности
		|	И НачислениеЗадолженностиОснования.Ссылка.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженностиОснования.Ссылка,
		|	НачислениеЗадолженностиОснования.Ссылка.СчетДоверительногоУправления,
		|	НачислениеЗадолженностиОснования.Ссылка.РасчетныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Ссылка КАК Ссылка,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОплатаОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
		|	ОплатаОснования.Ссылка.СтрокаБанковскойВыписки КАК СтрокаБВ,
		|	ОплатаОснования.Основание КАК Основание,
		|	СУММА(ОплатаОснования.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _Оплата
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка.Проведен
		|	И ОплатаОснования.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И ОплатаОснования.Ссылка.Организация = &Организация
		|	И ОплатаОснования.Ссылка.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	И ОплатаОснования.Ссылка.ВидЗадолженности = &ВидЗадолженности
		|	И ОплатаОснования.Ссылка.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И ОплатаОснования.Ссылка.Контрагент = &Контрагент
		|	И ОплатаОснования.Ссылка.РасчетныйСчетКонтрагента = &РасчетныйСчетКонтрагента
		|
		|СГРУППИРОВАТЬ ПО
		|	ОплатаОснования.Ссылка,
		|	ОплатаОснования.Основание,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления,
		|	ОплатаОснования.Ссылка.РасчетныйСчет,
		|	ОплатаОснования.Ссылка.СтрокаБанковскойВыписки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтрокаБанковскойВыписки.Ссылка КАК СтрокаБанковскойВыписки,
		|	СтрокаБанковскойВыписки.РасчетныйСчет КАК РасчетныйСчет,
		|	СтрокаБанковскойВыписки.РасчетныйСчет.Валюта КАК Валюта,
		|	СтрокаБанковскойВыписки.Сумма КАК Сумма,
		|	СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НачислениеЗадолженности.Ссылка КАК НачислениеЗадолженности,
		|	_Оплата.Ссылка КАК Оплата,
		|	ВЫБОР
		|		КОГДА НЕ ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления ЕСТЬ NULL
		|				И _Оплата.Ссылка ЕСТЬ NULL
		|			ТОГДА 1
		|		КОГДА НЕ ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления ЕСТЬ NULL
		|				И НЕ _НачислениеЗадолженности.Ссылка ЕСТЬ NULL
		|				И НЕ _Оплата.Ссылка ЕСТЬ NULL
		|			ТОГДА 2
		|		КОГДА _Оплата.Основание <> _НачислениеЗадолженности.Ссылка
		|			ТОГДА 0
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Статус,
		|	ВЫБОР
		|		КОГДА _Оплата.СтрокаБВ ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ _Оплата.СтрокаБВ <> ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка)
		|	КОНЕЦ КАК ЗаполненаСтрокаБанковскойВыпискиВОплате
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО СтрокаБанковскойВыписки.Организация = ИсполнителиПоДенежнымСредствамСобственные.Организация
		|			И СтрокаБанковскойВыписки.РасчетныйСчет = ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
		|			И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|				ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|			И (ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.ДатаЗаключения <= &Дата)
		|			И (ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.ДатаРасторжения >= &Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Оплата КАК _Оплата
		|		ПО (ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = _Оплата.СчетДоверительногоУправления)
		|			И СтрокаБанковскойВыписки.Ссылка = _Оплата.СтрокаБВ
		|			И СтрокаБанковскойВыписки.РасчетныйСчет = _Оплата.РасчетныйСчет
		|			И СтрокаБанковскойВыписки.Сумма = _Оплата.Сумма
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачислениеЗадолженности КАК _НачислениеЗадолженности
		|		ПО (ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = _НачислениеЗадолженности.СчетДоверительногоУправления)
		|			И СтрокаБанковскойВыписки.РасчетныйСчет = _НачислениеЗадолженности.РасчетныйСчет
		|			И СтрокаБанковскойВыписки.Сумма = _НачислениеЗадолженности.Сумма
		|			И (_Оплата.Основание = _НачислениеЗадолженности.Ссылка)
		|ГДЕ
		|	НЕ СтрокаБанковскойВыписки.ПометкаУдаления
		|	И СтрокаБанковскойВыписки.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	И СтрокаБанковскойВыписки.Организация = &Организация
		|	И СтрокаБанковскойВыписки.Контрагент = &Контрагент
		|	И СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента = &РасчетныйСчетКонтрагента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Данные.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ИмеющиеНесколькоВариантовРазнесения
		|ИЗ
		|	_Данные КАК _Данные
		|ГДЕ
		|	НЕ _Данные.ЗаполненаСтрокаБанковскойВыпискиВОплате
		|	И НЕ _Данные.СтрокаБанковскойВыписки В
		|				(ВЫБРАТЬ
		|					_Данные.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
		|				ИЗ
		|					_Данные КАК _Данные
		|				ГДЕ
		|					_Данные.ЗаполненаСтрокаБанковскойВыпискиВОплате)
		|
		|СГРУППИРОВАТЬ ПО
		|	_Данные.СтрокаБанковскойВыписки
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Данные.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
		|	_Данные.РасчетныйСчет КАК РасчетныйСчет,
		|	_Данные.Валюта КАК Валюта,
		|	_Данные.Сумма КАК Сумма,
		|	_Данные.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Данные.НачислениеЗадолженности КАК НачислениеЗадолженности,
		|	_Данные.Оплата КАК Оплата,
		|	_Данные.Статус КАК Статус,
		|	ЕСТЬNULL(_КоличествоИсполнителей.Количество, 1) КАК Количество
		|ИЗ
		|	_Данные КАК _Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИмеющиеНесколькоВариантовРазнесения КАК _КоличествоИсполнителей
		|		ПО _Данные.СтрокаБанковскойВыписки = _КоличествоИсполнителей.СтрокаБанковскойВыписки";
		
	Запрос.УстановитьПараметр("Дата",                     ЭтаФорма.Период);
	Запрос.УстановитьПараметр("Организация",              ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("Контрагент",               ЭтаФорма.Контрагент);
	Запрос.УстановитьПараметр("РасчетныйСчетКонтрагента", ЭтаФорма.РасчетныйСчетКонтрагента);
	Запрос.УстановитьПараметр("ВидЗадолженности",         ЭтаФорма.ВидКомиссии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрокаКомиссия = ЭтаФорма.Комиссия.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаКомиссия, Выборка);
		
		НоваяСтрокаКомиссия.Флажок = (Выборка.Количество < 2 И НоваяСтрокаКомиссия.Статус = 1);
	КонецЦикла;
	
	ИмеющиеНесколькоВариантовРазнесения = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИмеющиеНесколькоВариантовРазнесения");
	
	Выборка = ИмеющиеНесколькоВариантовРазнесения.ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По '" + Выборка.СтрокаБанковскойВыписки + "' обнаружено несколько вариантов для разнесения!");
	КонецЦикла;
	
	ОбновитьИтоговыеСуммы(ЭтаФорма);
	
КонецПроцедуры // ОбновитьКомиссиюНаСервере

&НаСервереБезКонтекста
Функция ПолучитьПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее()

	
	ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее = Новый ТаблицаЗначений;
	
	ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее.Колонки.Добавить("Банк", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее.Колонки.Добавить("ГФУ", Новый ОписаниеТипов("СправочникСсылка.ГруппыФинансовогоУчетаДоходовРасходов"));
	ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));

	СтрокаПравила = ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее.Добавить();
