&НаСервере
Процедура СоздатьКомиссиюНаСервере()
	
	ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее = ПолучитьПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее(); 
	
	ТекДата = ТекущаяДатаСеанса();
	ДатаДокументовНачисления	= ?(ТекДата > ЭтаФорма.Период + 14*60*60, ЭтаФорма.Период + 14*60*60, ТекДата);
	ДатаДокументовОплаты		= ?(ТекДата > ЭтаФорма.Период + 14*60*60 + 30*60, ЭтаФорма.Период + 14*60*60 + 30*60, ТекДата + 1);
	
	Для каждого СтрокаКомиссия Из ЭтаФорма.Комиссия Цикл
		Если Не СтрокаКомиссия.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		ШаблонСообщенияОбОшибке = "Не удалось создать %1 по счету д/у " + СтрокаКомиссия.СчетДоверительногоУправления
									+ ", р/счету " + СтрокаКомиссия.РасчетныйСчет + " на сумму " + СтрокаКомиссия.Сумма;
		
		НачатьТранзакцию();
		
		// поступление услуг
		НачислениеЗадолженности = СтрокаКомиссия.НачислениеЗадолженности;
				 
		Если Не ЗначениеЗаполнено(НачислениеЗадолженности) Тогда
			НачислениеЗадолженности = Документы.НачислениеЗадолженности.СоздатьДокумент();
			
			НачислениеЗадолженности.Дата									= ДатаДокументовНачисления;
			НачислениеЗадолженности.Организация								= ЭтаФорма.Организация;
			НачислениеЗадолженности.ВидЗадолженности						= ЭтаФорма.ВидКомиссии;
			НачислениеЗадолженности.СчетДоверительногоУправления			= СтрокаКомиссия.СчетДоверительногоУправления;
			НачислениеЗадолженности.МестоХранения							= Справочники.МестаХранения.ВнебиржевойРынок;
			НачислениеЗадолженности.РасчетныйСчет							= СтрокаКомиссия.РасчетныйСчет;
			НачислениеЗадолженности.Валюта									= СтрокаКомиссия.Валюта;
			НачислениеЗадолженности.Контрагент								= ЭтаФорма.Контрагент;
			НачислениеЗадолженности.Ответственный							= РаботаСПользователями.ТекущийПользователь();
			НачислениеЗадолженности.ПрочиеДоходыИРасходы					= ПолучитьПрочиеДоходыИРасходы(ЭтаФорма.ВидКомиссии);
			
			НачислениеЗадолженности.ГруппаФинансовогоУчетаДоходовРасходов	= ПолучитьГруппуФинансовогоУчетаДоходовРасходов(
																					ЭтаФорма.Период,
																					ЭтаФорма.Организация,
																					СтрокаКомиссия.СчетДоверительногоУправления,
																					НачислениеЗадолженности.ВидЗадолженности,
																					НачислениеЗадолженности.ПрочиеДоходыИРасходы,
																					СтрокаКомиссия.СтрокаБанковскойВыписки,
																					ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее);
																					
			НачислениеЗадолженности.ДатаПолученияДокумента					= НачислениеЗадолженности.Дата;
			
			Если ЗначениеЗаполнено(СтрокаКомиссия.НомерСФ) И ЗначениеЗаполнено(СтрокаКомиссия.ДатаСФ) Тогда
				НачислениеЗадолженности.ВидВходящегоДокумента   = Перечисления.ВидыВходящихДокументов.СчетФактура;
				НачислениеЗадолженности.НомерВходящегоДокумента = СтрокаКомиссия.НомерСФ;
				НачислениеЗадолженности.ДатаВходящегоДокумента  = СтрокаКомиссия.ДатаСФ;
			КонецЕсли;
			
			НоваяСтрокаОснования = НачислениеЗадолженности.Основания.Добавить();
			НоваяСтрокаОснования.Сумма = СтрокаКомиссия.Сумма;
			
			Если Не НачислениеЗадолженности.ПроверитьЗаполнение() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонСообщенияОбОшибке, "начисление задолженности"));
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			Попытка
				НачислениеЗадолженности.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонСообщенияОбОшибке, "начисление задолженности"));
				ОтменитьТранзакцию();
				Продолжить;
			КонецПопытки;
			
			НачислениеЗадолженности = НачислениеЗадолженности.Ссылка;
		КонецЕсли;
		
		// оплата
		Оплата = Документы.Оплата.СоздатьДокумент();
		
		Оплата.Дата                         = ДатаДокументовОплаты;
		Оплата.Организация                  = ЭтаФорма.Организация;
		Оплата.ВидЗадолженности             = ЭтаФорма.ВидКомиссии;
		Оплата.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
		Оплата.СчетДоверительногоУправления = СтрокаКомиссия.СчетДоверительногоУправления;
		Оплата.МестоХранения                = Справочники.МестаХранения.ВнебиржевойРынок;
		Оплата.РасчетныйСчет                = СтрокаКомиссия.РасчетныйСчет;
		Оплата.СтрокаБанковскойВыписки      = СтрокаКомиссия.СтрокаБанковскойВыписки;
		Оплата.ВалютаОплаты                 = СтрокаКомиссия.Валюта;
		Оплата.Ответственный                = РаботаСПользователями.ТекущийПользователь();
		Оплата.Контрагент   	            = ЭтаФорма.Контрагент;
		Оплата.РасчетныйСчетКонтрагента 	= ЭтаФорма.РасчетныйСчетКонтрагента;
		
		НоваяСтрокаОснования = Оплата.Основания.Добавить();
		НоваяСтрокаОснования.Основание                = НачислениеЗадолженности;
		НоваяСтрокаОснования.Сумма                    = СтрокаКомиссия.Сумма;
		НоваяСтрокаОснования.Валюта                   = СтрокаКомиссия.Валюта;
		
		Если Не Оплата.ПроверитьЗаполнение() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонСообщенияОбОшибке, "оплату"));
			ОтменитьТранзакцию();
			Продолжить;
		КонецЕсли;
		
		Попытка
			Оплата.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонСообщенияОбОшибке, "оплату"));
			ОтменитьТранзакцию();
			Продолжить;
		КонецПопытки;		
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
	ОбновитьКомиссиюНаСервере();
	
КонецПроцедуры // СоздатьКомиссиюНаСервере

&НаСервереБезКонтекста
Функция ПолучитьПрочиеДоходыИРасходы(ВидЗадолженности)
	
	Если ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии") Тогда
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам брокера");
	ИначеЕсли ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии")
		ИЛИ ПринадлежитГруппеЗадолженностей(ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия")) Тогда 	
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам депозитария");
	ИначеЕсли ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБанковскойКомиссии")
		ИЛИ ПринадлежитГруппеЗадолженностей(ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.БанковскаяКомиссия")) Тогда 	
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Комиссия банка");	
	КонецЕсли;
	
КонецФункции // ПолучитьДепозитарийКонтрагента

&НаСервереБезКонтекста
Функция ПринадлежитГруппеЗадолженностей(ВидЗадолженности, Группа)
	Если НЕ ЗначениеЗаполнено(ВидЗадолженности) Тогда
		Возврат Ложь;
	Иначе
		Возврат ВидЗадолженности.ПринадлежитЭлементу(Группа);
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьГруппуФинансовогоУчетаДоходовРасходов(Дата, Организация, СчетДоверительногоУправления, ВидЗадолженности, ПрочиеДоходыИРасходы, СтрокаБанковскойВыписки, ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее)

	Если БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, Дата) Тогда // попробуем определить по ключевым словам в назначении платежа
		
		Для каждого ПравилоОпределенияГФУдляКомиссийБанкаГруппыБудущее Из ПравилаОпределенияГФУдляКомиссийБанкаГруппыБудущее Цикл
			
			Если СтрокаБанковскойВыписки.ВидДвижения = Перечисления.ВидыДвижений.Расход
				И СтрокаБанковскойВыписки.Контрагент = ПравилоОпределенияГФУдляКомиссийБанкаГруппыБудущее.Банк
				И СтрНайти(СтрокаБанковскойВыписки.НазначениеПлатежа, ПравилоОпределенияГФУдляКомиссийБанкаГруппыБудущее.Ключ) <> 0 Тогда
			
				Возврат ПравилоОпределенияГФУдляКомиссийБанкаГруппыБудущее.ГФУ;
			
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидЗадолженности) Тогда
		
		Возврат БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаПоПрочимДоходамРасходам(
									Дата,
									Организация,
									СчетДоверительногоУправления,
									ВидЗадолженности,
									ПрочиеДоходыИРасходы);
		
	КонецЕсли; 

КонецФункции // ПолучитьГруппуФинансовогоУчетаДоходовРасходов()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "Период, Организация, Контрагент, РасчетныйСчетКонтрагента");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыЗадолженности.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыЗадолженности КАК ВидыЗадолженности
		|ГДЕ
		|	ВидыЗадолженности.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Комиссия))";
	
	Элементы.ВидКомиссии.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	ЭтаФорма.ВидКомиссии = Справочники.ВидыЗадолженности.КомиссияБанкаЗаПереводДС;
	
	ОбновитьКомиссиюНаСервере();
	
КонецПроцедуры

