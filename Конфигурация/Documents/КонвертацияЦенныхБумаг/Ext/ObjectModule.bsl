
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// остатки ценных бумаг
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",                 ЭтотОбъект.ЦеннаяБумага);
	
	ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
	ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДепозитарныйСчет", "ДепозитарныйСчет");

	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать         = Истина;

	// остатки ценных бумаг
	
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		Если ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Обмен Тогда
			// списываем остатки ц/б
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
						
			// приходуем остатки новой ц/б
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
			Движение.Количество                   = СтрокаЦенныеБумаги.КоличествоНовое;
						
		ИначеЕсли ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.ОбменЦелогоКоличества Тогда 
			// списываем остатки ц/б
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
			Движение.Количество                   = Цел(СтрокаЦенныеБумаги.КоличествоНовое / ЭтотОбъект.Коэффициент);
						
			// приходуем остатки новой ц/б
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
			Движение.Количество                   = СтрокаЦенныеБумаги.КоличествоНовое;
						
		ИначеЕсли ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Выделение Тогда
			// приходуем остатки новой ц/б
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = СтрокаЦенныеБумаги.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
			Движение.Количество                   = СтрокаЦенныеБумаги.КоличествоНовое;
						
		КонецЕсли;
		
	КонецЦикла;
	
	// операции с ценными бумгами
	// счет депо не нужен
	ИтогоКоличество      = ЭтотОбъект.ЦенныеБумаги.Итог("Количество");
	ИтогоКоличествоНовое = ЭтотОбъект.ЦенныеБумаги.Итог("КоличествоНовое");
	
	Если ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Обмен Тогда
		
		// списываем остатки ц/б			
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		Движение.Операция 					  = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения 				  = Перечисления.ВидыДвижений.Расход;
		Движение.Организация 				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
		Движение.Количество 				  = ИтогоКоличество;
		Движение.ДатаОперации 				  = ЭтотОбъект.Дата;
		
		// приходуем остатки новой ц/б
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		Движение.Операция 					  = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения 				  = Перечисления.ВидыДвижений.Приход;
		Движение.Организация 				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
		Движение.Количество 				  = ИтогоКоличествоНовое;
		Движение.ДатаОперации 				  = ЭтотОбъект.Дата;
		Движение.ДатаПокупки                  = ЭтотОбъект.Дата;
		
	ИначеЕсли ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.ОбменЦелогоКоличества Тогда 
		
		// списываем остатки ц/б
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		Движение.Операция 					  = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения 				  = Перечисления.ВидыДвижений.Расход;
		Движение.Организация 				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
		Движение.Количество 				  = Цел(ИтогоКоличествоНовое / ЭтотОбъект.Коэффициент);
		Движение.ДатаОперации 				  = ЭтотОбъект.Дата;
		
		// приходуем остатки новой ц/б			
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		Движение.Операция 					  = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения 				  = Перечисления.ВидыДвижений.Приход;
		Движение.Организация 				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
		Движение.Количество 				  = ИтогоКоличествоНовое;
		Движение.ДатаОперации 				  = ЭтотОбъект.Дата;
		Движение.ДатаПокупки                  = ЭтотОбъект.Дата;
		
	ИначеЕсли ЭтотОбъект.ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Выделение Тогда
		
		// приходуем остатки новой ц/б			
		Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
		Движение.Операция 					  = ЭтотОбъект.Ссылка;
		Движение.ВидДвижения 				  = Перечисления.ВидыДвижений.Приход;
		Движение.Организация 				  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумагаНовая;
		Движение.Количество 				  = ИтогоКоличествоНовое;
		Движение.ДатаОперации 				  = ЭтотОбъект.Дата;
		Движение.ДатаПокупки                  = ЭтотОбъект.Дата;
		
	КонецЕсли;		
	
	Движения.Записать();
	
	// проверим отриц. остатки
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Конвертация ценных бумаг, процедура проведения по ЕПС не реализована");
	Возврат;
	
КонецПроцедуры 

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Если Рынок <> Перечисления.РынкиЦенныхБумаг.Акции Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Конвертация ценных бумаг, процедура проведения реализована только для акций");
		Возврат;
	КонецЕсли;	
	
	Если ВидКонвертации = Справочники.ВидыКонвертацииЦенныхБумаг.Выделение Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида конвертации 'Выделение' процедура проведения не реализована");
		Возврат;		
	КонецЕсли;	
	
	Движения[УчетныйРегистр].Записывать = Истина;
		
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	СчетРасчетов = ПланыСчетов.Основной.РасчетыСКонтрагентами; //76.52
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
	|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
	|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
	|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
	|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьПокупки) КАК СтоимостьПокупки,
	|	СУММА(БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости) КАК РасходыПриПокупкеВСтоимости,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВСтоимости) КАК ПереоценкаВСтоимости,
	|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
	|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
	|	БухПартииЦенныхБумаг.Рынок КАК Рынок
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|ГДЕ
	|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
	|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	БухПартииЦенныхБумаг.СтрокаКорзиныЦенныхБумаг,
	|	БухПартииЦенныхБумаг.ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.ВидДвижения,
	|	БухПартииЦенныхБумаг.Рынок";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЦеннаяБумага = Выборка.ЦеннаяБумага;
		
		Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
			Валюта = ЭтотОбъект.Организация.ВалютаУчета;
		Иначе
			Валюта = ЦеннаяБумага.ВалютаНоминала;
		КонецЕсли;

		УчетныйАктив       = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, ЦеннаяБумага);

		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);	
						
		ВалютныйУчет = НастройкиУчетаАктива.СчетУчета.Валютный;

			
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда 	
			
			Контрагент = РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЦеннаяБумага, ЭтотОбъект.Дата);
			
			// ТЕЛО
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Списание ценной бумаги по конвертации");
			
			// дебет
			Проводка.СчетДт = СчетРасчетов;			
			Проводка.СубконтоДт.Контрагенты = Контрагент;
			
			// кредит
			Проводка.СчетКт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
			Если ВалютныйУчет Тогда
				Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
				Проводка.ВалютаКт = Валюта;
			КонецЕсли;
			
			
			Если Выборка.ПереоценкаВВалютеУчета <> 0 Тогда
			
				//ПЕРЕОЦЕНКА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаВВалютеУчета, "Списание переоценки ценной бумаги по конвертации");
				
				// дебет
				Проводка.СчетДт = СчетРасчетов;
				Проводка.СубконтоДт.Контрагенты = Контрагент;

				// кредит		
				Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.Переоценка;
					Проводка.ВалютаКт = Валюта;
				КонецЕсли;
			
			КонецЕсли;
			
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда 
			
			Контрагент = РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЦеннаяБумага, ЭтотОбъект.Дата);
			
			// ТЕЛО
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Приход ценной бумаги по конвертации");
			
			// дебет
			Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;		
			Проводка.КоличествоДт = Выборка.Количество;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;			
			Проводка.СубконтоКт.Контрагенты = Контрагент;
						
			Если ВалютныйУчет Тогда
				Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
				Проводка.ВалютаКт = Валюта;
			КонецЕсли;
			
			Если Выборка.ПереоценкаВВалютеУчета <> 0 Тогда
			
				//ПЕРЕОЦЕНКА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.ПереоценкаВВалютеУчета, "Приход ценной бумаги по конвертации");
				
				// дебет
				Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаПереоценки;
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;		
				
				// кредит
				Проводка.СчетКт = СчетРасчетов;			
				Проводка.СубконтоКт.Контрагенты = Контрагент;
							
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.Переоценка;
					Проводка.ВалютаКт = Валюта;
				КонецЕсли;
				
			КонецЕсли;
			
 		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры	

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Акции;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры // ОбработкаЗаполнения

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		// на текущий момент документ поддерживает только конвертацию акций
		Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Акции Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поддерживается только конвертация акций.", ЭтотОбъект, "Рынок",, Отказ);
			Возврат;
		КонецЕсли;
		
		// тип ц/б должен соответствовать рынку ц/б
		ТребТипЦеннойБумаги = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ЭтотОбъект.Рынок);
		
		Если Не ТребТипЦеннойБумаги.СодержитТип(ТипЗнч(ЭтотОбъект.ЦеннаяБумага)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип ц/б " + ТипЗнч(ЭтотОбъект.ЦеннаяБумага) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".", ЭтотОбъект, "ЦеннаяБумага",, Отказ);
		КонецЕсли;
		
		Если Не ТребТипЦеннойБумаги.СодержитТип(ТипЗнч(ЭтотОбъект.ЦеннаяБумагаНовая)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип новой ц/б " + ТипЗнч(ЭтотОбъект.ЦеннаяБумагаНовая) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".", ЭтотОбъект, "ЦеннаяБумагаНовая",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
