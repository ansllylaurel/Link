	//		  и суммы начисленных, но не выплаченных процентов.
	//  2.13. Оценочная стоимость маржируемых  производных финансовых инструментов  определяется по расчетной цене, на основании которой ежедневно производится зачисление 
	//   	  либо списание вариационной маржи. Для целей расчета оценочной стоимости Активов на ежедневной основе, оценочная стоимость маржируемых  производных финансовых инструментов  признается равной нулю.
	//	2.14. Сумма денежных средств и обязательств в иностранной валюте пересчитывается в рубли по курсу, установленному Центральным банком 
	//  	  Российской Федерации на дату оценки Активов
	//	3.1. Оценочная стоимость ценных бумаг, приобретенных по сделке, предусматривающей обязательство по обратной продаже указанных ценных бумаг лицу, у которого они приобретены, определяется в соответствии с разделом 2  настоящей Методики.
	//  3.2. Задолженности, возникшие в результате совершения сделок, предусматривающих обязательство по обратной продаже/покупке ценных бумаг (сделки РЕПО) оценивается следующим образом:
	//       - Сделка покупки  ценной бумаги с обязательством обратной продажи:
	//		   Кредиторская задолженность по ценным бумагам, возникшая в результате  заключенной сделки РЕПО оценивается в соответствии с разделом 2 настоящей методики, исходя из количества ценных бумаг, предусмотренных в условиях соответствующей сделки (второй ее части).
	//		   Дебиторская задолженность по денежным средствам, возникшая в результате  заключенной сделки РЕПО оценивается в сумме  первой части сделки РЕПО с учетом процентов, накопленных на отчетную дату. Проценты рассчитываются равномерно исходя из срока действия сделки РЕПО и разницы между суммами последующей покупки (вторая часть РЕПО) и первоначальной продажи (первая часть РЕПО). 
	//	  	 - Сделка продажи  ценной бумаги с обязательством обратной покупки:
	//		   Кредиторская задолженность по денежным средствам, возникшая в результате  заключенной сделки РЕПО оценивается в сумме  первой части сделки РЕПО с учетом процентов, накопленных на отчетную дату. Проценты рассчитываются равномерно исходя из срока действия сделки РЕПО и разницы между суммами последующей покупки (вторая часть РЕПО) и первоначальной продажи (первая часть РЕПО).
	//		   Дебиторская задолженность по ценным бумагам, возникшая в результате  заключенной сделки РЕПО оценивается в соответствии разделом 2 настоящей методики, исходя из количества ценных бумаг, предусмотренных в условиях соответствующей сделки (второй ее части).
	//
	// 4.1. Дебиторская задолженность по процентному (купонному) доходу по составляющим Активы денежным средствам на счетах и во вкладах и ценным бумагам принимается в расчет стоимости Активов в сумме, исчисленной исходя из ставки процента (купонного дохода), установленной в договоре банковского счета, договоре банковского вклада или решении о выпуске (о дополнительном выпуске) эмиссионных ценных бумаг.
  	// 4.2. Не принимаются в расчет стоимости активов:
  	//      - начисленный процентный (купонный) доход по ценным бумагам, составляющим Активы, в случае если указанный доход включен в оценочную стоимость таких ценных бумаг, а также в случае опубликования в соответствии с федеральными законами и иными нормативными правовыми актами Российской Федерации сведений о просрочке исполнения эмитентом обязательства по выплате указанного дохода или сведений о применении к эмитенту процедур банкротства;
  	//      - объявленные, но не полученные дивиденды по акциям, составляющим Активы;
 	//      - начисленные, но не полученные доходы по инвестиционным паям закрытых паевых инвестиционных фондов, составляющим Активы
	//
	// Задача № 228439:
	//		- заключили форвардную сделку евро за доллары с далеким исполнением по противоестественному курсу. Как следствие при пересчете в рубли по текущему курсу
	//		  образовалась гигантская прибыль. Чтобы ее не показывать было решено использовать не кросс-курс из документа, а пересчитывать контр. валюту по кросс-курсу
	//        ЦБ на дату расчета, уводя тем самым прибыль по сделке в ноль

	РасчетПартий = Неопределено;
	Параметры.Свойство("РасчетПартий", РасчетПартий);

	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамРЕПО(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ТаблицаСтоимостей,
		Параметры.ЦельРасчета,
		РасчетПартий,
		Параметры.НастройкиФормированияСЧА,
		Отказ,
		Запрос.МенеджерВременныхТаблиц, 
		Параметры);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСОтложеннымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ТаблицаСтоимостей,
		Отказ,
		Запрос.МенеджерВременныхТаблиц,
		Параметры);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСВалютойСОтложеннымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Отказ,
		Запрос.МенеджерВременныхТаблиц);
		
	СтоимостиДепозитныхВкладов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
		Параметры.СчетДоверительногоУправления, 
		КонецДня(Параметры.Период), 
		Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
		Параметры.УчитыватьПлановыеОперации, 
		Ложь,
		Неопределено,
		Отказ);
		
	Если Параметры.Период >= '20221230' 
			И Параметры.ВариантРасчетаОценочнойСтоимости <> Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ Тогда	
		
		СтоимостиМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
			Параметры.СчетДоверительногоУправления, 
			Неопределено, 
			Ложь,
			КонецДня(Параметры.Период),
			Параметры.ЦельРасчета,
			Отказ);
			
	Иначе // Возвращаем пустую таблицу МНО
			
		СтоимостиМНО = Новый ТаблицаЗначений;
		СтоимостиМНО.Колонки.Добавить("МНО",		 Новый ОписаниеТипов("ДокументСсылка.МНО"));
		СтоимостиМНО.Колонки.Добавить("СуммаМНО",	 Новый ОписаниеТипов("Число"));
		СтоимостиМНО.Колонки.Добавить("ПроцентыМНО", Новый ОписаниеТипов("Число"));
			
	КонецЕсли;
	
	//Параметр КупонРЕПООтражатьПоОплате используется только для ДУ УКПИ с 01.08.2023 
	//   для исключения задолженностей по купону и возвратному купону, которые возникли по сделкам обратного РЕПО (#494926 по аналогии с #381178).
	//Для реализации использованы временные таблицы: _ВозвратныйКупонИсключаемыйСОкруглением, _ВозвратныйКупонИсключитьПоПогашениям, 
	//   _ВозвратныйКупонИсключитьРазвернутый,  _ВозвратныйКупонКИсключению
	Запрос.УстановитьПараметр("КупонРЕПООтражатьПоОплате", 
		Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023 
			И НачалоДня(Параметры.Период) >= Дата(2023,8,1)); 
	
		
	СписокВидовЗадолженности = Новый Массив;
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоСделке);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции); // объявленные, но не полученные дивиденды по акциям, составляющим Активы
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи); // начисленные, но не полученные доходы по инвестиционным паям закрытых паевых инвестиционных фондов, составляющим Активы
	
	ЗадолженностиОбнуляемыеПриДефолтеЭмитента = Новый Массив;
	ЗадолженностиОбнуляемыеПриДефолтеЭмитента.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	ЗадолженностиОбнуляемыеПриДефолтеЭмитента.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	ЗадолженностиОбнуляемыеПриДефолтеЭмитента.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	ЗадолженностиОбнуляемыеПриДефолтеЭмитента.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	
	ВестиРасчетПоПартиям =
		Параметры.ВариантРасчетаОценочнойСтоимости = справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс;
	
	СчитатьВалютныеФорвардыПоЧестному = 
		Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс;
		
	НеВключатьКЗПоОплатеНДФЛ = Параметры.Период >= '20191231' // По методике, с 31.12.2019 кредиторская задолженность по оплате НДФЛ не включается в СЧА	
		И (Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
			ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии);	
	
	Запрос.УстановитьПараметр("СтоимостиМНО",													СтоимостиМНО);
	Запрос.УстановитьПараметр("СтоимостиДепозитныхВкладов",										СтоимостиДепозитныхВкладов);
	Запрос.УстановитьПараметр("СписокВидовЗадолженности",										СписокВидовЗадолженности);
	Запрос.УстановитьПараметр("ЗадолженностиОбнуляемыеПриДефолтеЭмитента",						ЗадолженностиОбнуляемыеПриДефолтеЭмитента);
	Запрос.УстановитьПараметр("ВестиРасчетПоПартиям",											ВестиРасчетПоПартиям);
	Запрос.УстановитьПараметр("СчитатьВалютныеФорвардыПоЧестному",								СчитатьВалютныеФорвардыПоЧестному);
	Запрос.УстановитьПараметр("НеВключатьКЗПоОплатеНДФЛ",										НеВключатьКЗПоОплатеНДФЛ);
	
	Запрос.УстановитьПараметр("Период",															Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода",													КонецДня(Параметры.Период));
	Запрос.УстановитьПараметр("КонецПериодаНачалоДня",											НачалоДня(Параметры.Период));
	Запрос.УстановитьПараметр("Организация",													Параметры.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",									Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета",													Параметры.ВалютаРубли);
	Запрос.УстановитьПараметр("ММВБ",															ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);
	Запрос.УстановитьПараметр("Блумберг",														ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("СтоимостьПогашенныхЦенныхБумагВСоставеДебиторскойзадолженности", Параметры.СпособОценкиПогашенныхБумаг <> "ОцениватьПоОстаткуЗадолженности");	
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, Параметры.Период);
	
	Отбор = "НЕ _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (&СписокВидовЗадолженности)";
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностиПоДенежнымСредствамВМенеджерВременныхТаблиц(Запрос, Отбор);	
	
	Отбор = "ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение) И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)";
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьОстаткиЦенныхБумагЗаблокированныеВМенеджерВременныхТаблиц(Запрос, Отбор);	
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьОстаткиДенежныхСредствВМенеджерВременныхТаблиц(Запрос);	
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностьПоКомиссиямПоСделкамСОтложеннымИсполнениемВМенеждерВременныхТаблиц(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Отказ,
		Запрос.МенеджерВременныхТаблиц); 
					
	#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостиДепозитныхВкладов.КредитныйИнструмент КАК ДепозитныйВклад,
		|	СтоимостиДепозитныхВкладов.Номинал КАК Номинал,
		|	СтоимостиДепозитныхВкладов.Проценты КАК Проценты
		|ПОМЕСТИТЬ _СтоимостиДепозитныхВкладовИзПараметра
		|ИЗ
		|	&СтоимостиДепозитныхВкладов КАК СтоимостиДепозитныхВкладов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДепозитныйВклад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостиДепозитныхВкладовИзПараметра.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_СтоимостиДепозитныхВкладовИзПараметра.Номинал КАК Номинал,
		|	_СтоимостиДепозитныхВкладовИзПараметра.Проценты КАК Проценты,
		|	ВЫРАЗИТЬ(_СтоимостиДепозитныхВкладовИзПараметра.ДепозитныйВклад КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта КАК Валюта
		|ПОМЕСТИТЬ _СтоимостиДепозитныхВкладов
		|ИЗ
		|	_СтоимостиДепозитныхВкладовИзПараметра КАК _СтоимостиДепозитныхВкладовИзПараметра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостиМНО.МНО КАК МНО,
		|	СтоимостиМНО.СуммаМНО КАК СуммаМНО,
		|	СтоимостиМНО.ПроцентыМНО КАК ПроцентыМНО
		|ПОМЕСТИТЬ _СтоимостиМНО
		|ИЗ
		|	&СтоимостиМНО КАК СтоимостиМНО
		|ГДЕ
		|	СтоимостиМНО.ПроцентыМНО <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ММВБ КАК Биржа,
		|	2 КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетыБиржевыхКотировок
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Блумберг,
		|	1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДефолтыПоОблигациямСрезПоследних.Период КАК Период,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация,
		|	ДефолтыПоОблигациямСрезПоследних.ТипДефолта КАК ТипДефолта,
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта КАК СтатусДефолта,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация.Эмитент КАК ОблигацияЭмитент
