		|			КОНЕЦ
		|	КОНЕЦ КАК Сумма,
		|	_Задолженность_Вся.Сумма КАК _Задолженность_Вся_Сумма,
		|	_Авансы_СоСроками.СуммаНакопительная КАК _Авансы_СоСроками_СуммаНакопительная,
		|	_РасчетныеЗадолженностиРПИ.Сумма КАК _РасчетныеЗадолженностиРПИ_Сумма,
		|	_Задолженность_Вся.Валюта КАК Валюта,
		|	_Задолженность_Вся.ВидЗадолженностиНаименование КАК ВидЗадолженностиНаименование,
		|	_Задолженность_Вся.ОбесцененнаяЗадолженность КАК ОбесцененнаяЗадолженность
		|ПОМЕСТИТЬ _Задолженность_Вся_Врем
		|ИЗ
		|	_Задолженность_Вся КАК _Задолженность_Вся
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Авансы_СоСроками КАК _Авансы_СоСроками
		|		ПО _Задолженность_Вся.ОснованиеЗадолженности = _Авансы_СоСроками.ОснованиеЗадолженности
		|			И _Задолженность_Вся.ТипЗадолженности = _Авансы_СоСроками.ТипЗадолженности
		|			И _Задолженность_Вся.ВидЗадолженности = _Авансы_СоСроками.ВидЗадолженности
		|			И _Задолженность_Вся.Контрагент = _Авансы_СоСроками.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РасчетныеЗадолженностиРПИБезАвансов КАК _РасчетныеЗадолженностиРПИ
		|		ПО (_РасчетныеЗадолженностиРПИ.Контрагент = _Авансы_СоСроками.Контрагент)
		|			И (_РасчетныеЗадолженностиРПИ.Договор = _Авансы_СоСроками.Договор)
		|			И (_РасчетныеЗадолженностиРПИ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|					И _Авансы_СоСроками.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ИЛИ _РасчетныеЗадолженностиРПИ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|					И _Авансы_СоСроками.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Задолженность_Вся
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Задолженность_Вся.ТипЗадолженности КАК ТипЗадолженности,
		|	_Задолженность_Вся.ВидЗадолженности КАК ВидЗадолженности,
		|	_Задолженность_Вся.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	_Задолженность_Вся.Контрагент КАК Контрагент,
		|	_Задолженность_Вся.Сумма КАК Сумма,
		|	_Задолженность_Вся.Валюта КАК Валюта,
		|	_Задолженность_Вся.ВидЗадолженностиНаименование КАК ВидЗадолженностиНаименование,
		|	_Задолженность_Вся.ОбесцененнаяЗадолженность КАК ОбесцененнаяЗадолженность
		|ПОМЕСТИТЬ _Задолженность_Вся
		|ИЗ
		|	_Задолженность_Вся_Врем КАК _Задолженность_Вся
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Задолженность_Вся_Врем
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Авансы_СоСрокамиПредварительно
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Авансы_СоСроками
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РасчетныеЗадолженностиРПИБезСроков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РасчетныеЗадолженностиРПИБезАвансов";
	Запрос.Выполнить();
КонецПроцедуры

Процедура СформироватьЗапросРасчетСЧА_ПИФ2018(Запрос, Параметры, Отказ)
	
	Запрос.УстановитьПараметр("Организация", 				  	Параметры.Организация);
	Запрос.УстановитьПараметр("Период", 				  	  	Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодРезервы", 					Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("КонецПериода", 				  	КонецДня(Параметры.Период));
	Запрос.УстановитьПараметр("КонецПериодаНачалоДня", 		  	НачалоДня(Параметры.Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", 				  	Параметры.ВалютаРубли);
	Запрос.УстановитьПараметр("ИФНС", 				  			РегистрыСведений.ИФНСОрганизаций.ПолучитьИФНС(Параметры.Период, Параметры.Организация, Истина));
	Запрос.УстановитьПараметр("ВариантРасчетаОценочнойСтоимости", 	Параметры.ВариантРасчетаОценочнойСтоимости);
	
	Если Параметры.Свойство("ДатаПоследнегоСЧА") Тогда
		
		ДатаПоследнегоСЧА = Параметры.ДатаПоследнегоСЧА;
		Если ДатаПоследнегоСЧА = Неопределено Тогда
			//первый расчет СЧА
			Запрос.УстановитьПараметр("ПериодРезервы", Новый Граница(НачалоДня(Параметры.Период), ВидГраницы.Включая));
		Иначе
			Запрос.УстановитьПараметр("ПериодРезервы", Новый Граница(НачалоДня(ДатаПоследнегоСЧА + 86400), ВидГраницы.Включая));
		КонецЕсли;
	
	КонецЕсли; 	 
	
	Отказ = Ложь;
	
	СтоимостиКредитныхИнструментов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
		Параметры.СчетДоверительногоУправления,
		КонецДня(Параметры.Период),
		Неопределено,
		Параметры.УчитыватьПлановыеОперации, 
		Истина,,
		Отказ);
		
	Запрос.УстановитьПараметр("СтоимостиКредитныхИнструментов", СтоимостиКредитныхИнструментов);

	СтоимостиПросроченнойДебиторки = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиПросроченныхЗаймовПоСчетуДоверительногоУправления(
		Параметры.СчетДоверительногоУправления,
		КонецДня(Параметры.Период),
		Параметры.УчитыватьПлановыеОперации, ,
		Отказ);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СтоимостиПросроченнойДебиторки, "_СтоимостиПросроченнойДебиторки0", Запрос.МенеджерВременныхТаблиц);

	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСОтложеннымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ТаблицаСтоимостей,
		Отказ,
		Запрос.МенеджерВременныхТаблиц,
		Параметры);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСВалютойСОтложеннымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Отказ,
		Запрос.МенеджерВременныхТаблиц);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамРЕПО(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ТаблицаСтоимостей,
		Параметры.ЦельРасчета,
		Неопределено,
		Параметры.НастройкиФормированияСЧА,
		Отказ,
		Запрос.МенеджерВременныхТаблиц,
		Параметры);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСРаздельнымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ЦельРасчета,
		Отказ,
		Запрос.МенеджерВременныхТаблиц);
		
	// Сделки ФЕО
	
	ПроцентыПоСделкамФЕО = РаботаСМНО.РассчитатьПроцентыПоСделкамФЕО(Параметры.Организация, Параметры.СчетДоверительногоУправления, НачалоДня(Параметры.Период), Отказ);
	
	Запрос.УстановитьПараметр("ПроцентыПоСделкамФЕО", ПроцентыПоСделкамФЕО);
	
	ОпределитьПериодичностьПереоценкиМНО = Истина;
	СтоимостиМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
		Параметры.СчетДоверительногоУправления, 
		Перечисления.ВидыУчета.БухгалтерскийУчет, 
		ОпределитьПериодичностьПереоценкиМНО,
		КонецДня(Параметры.Период),
		Параметры.ЦельРасчета,
		Отказ);
		
	Запрос.УстановитьПараметр("СтоимостиМНО", СтоимостиМНО);
	
	Справочники.ОбъектыНедвижимости.ПоместитьСтоимостиОбъектовНедвижимостиПоСчетуДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц, Параметры.ВариантРасчетаОценочнойСтоимости, Параметры.Организация,
		Параметры.СчетДоверительногоУправления, Параметры.Период, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//Параметр КупонРЕПООтражатьПоОплате используется только для ПИФов УКПИ с 01.04.2021 
	//   для исключения задолженностей по купону и возвратному купону, которые возникли по сделкам обратного РЕПО (#381178).
	//Для реализации использованы временные таблицы: _ВозвратныйКупонИсключаемыйСОкруглением, _ВозвратныйКупонИсключитьПоПогашениям, 
	//   _ВозвратныйКупонИсключитьРазвернутый,  _ВозвратныйКупонКИсключению
	Запрос.УстановитьПараметр("КупонРЕПООтражатьПоОплате", 
		Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ 
			И НачалоДня(Параметры.Период) >= Дата(2021,4,1)
		Или (Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
			Или Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021)
			И НачалоДня(Параметры.Период) >= Дата(2023,9,1)); 
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностиПоДенежнымСредствамВМенеджерВременныхТаблиц(Запрос);
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностиПоЦеннымБумагамВМенеджерВременныхТаблиц(Запрос);
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьОстаткиДенежныхСредствВМенеджерВременныхТаблиц(Запрос);
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЗадолженностиПоВзносамВУставныйКапиталВМенеджерВременныхТаблиц(Запрос);

	ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию = РаботаСоСтоимостьюПоРыночнойСтавке.РассчитатьСправедливыеСтоимостиЗадолженностей(
			Параметры, 
			Запрос,
			Отказ);
			
	Запрос.УстановитьПараметр("ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию", ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию);
	
	ЗадолженностиПоБрокерскойКомиссииПоНачислениям = ПолучитьЗадолженностиПоБрокерскойКомиссииПоНачислениям(Параметры, Запрос, Отказ);
	
	Запрос.УстановитьПараметр("ЗадолженностиПоБрокерскойКомиссииПоНачислениям", ЗадолженностиПоБрокерскойКомиссииПоНачислениям);
	
	//Задолженности с процентами - не операционные и с дисконтированием.
	ЗадолженностиПоДенежнымСредствамСПроцентами = РаботаСоСтоимостьюПоРыночнойСтавке.РассчитатьПроцентыПоЗадолженностям(
			Параметры.СчетДоверительногоУправления,
			ЗадолженностиПоДенежнымСредствамКОбесценениюИДисконтированию.ВыгрузитьКолонку("ОснованиеЗадолженности"), 
			Параметры.Период);
			
	Запрос.УстановитьПараметр("ЗадолженностиПоДенежнымСредствамСПроцентами", ЗадолженностиПоДенежнымСредствамСПроцентами);
	
	// Обязательства, в том числе по выплате купонов и дивидендов, в отношении ценных бумаг,
	// по которым выплата не может быть произведена в рублях в соответствии с действующим законодательством РФ,
	// с даты признания в имуществе паевого инвестиционного фонда признаются находящимися в состоянии дефолта,
	// LGD по этим обязательствам принимается равным 100% (#438375, #Техдолг)	
	
	ОбесценениеЗадолженности = Новый ТаблицаЗначений;
	ОбесценениеЗадолженности.Колонки.Добавить("ТипЗадолженности",				Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.ТипЗадолженности.Тип);
	ОбесценениеЗадолженности.Колонки.Добавить("ВидЗадолженности",				Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.ВидЗадолженности.Тип);
	ОбесценениеЗадолженности.Колонки.Добавить("ОснованиеЗадолженности",			Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.Основание.Тип);
	ОбесценениеЗадолженности.Колонки.Добавить("ВероятностьДефолта",				Новый ОписаниеТипов("Число"));
	ОбесценениеЗадолженности.Колонки.Добавить("УровеньПотерьВСлучаеДефолта",	Новый ОписаниеТипов("Число"));
	
	Если Параметры.Период >= '20220729' И Параметры.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		
		СтрокаОбесценения = ОбесценениеЗадолженности.Добавить();
		СтрокаОбесценения.ТипЗадолженности				= Перечисления.ТипыЗадолженности.Дебиторская;
		СтрокаОбесценения.ВидЗадолженности				= Справочники.ВидыЗадолженности.ПоПогашениюКупона;
		СтрокаОбесценения.ОснованиеЗадолженности		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Купон_XS0191754729_280422");
		СтрокаОбесценения.ВероятностьДефолта			= 100;
		СтрокаОбесценения.УровеньПотерьВСлучаеДефолта	= 100;
		
	ИначеЕсли Параметры.Период >= '20221130' И Параметры.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		
		СтрокаОбесценения = ОбесценениеЗадолженности.Добавить();
		СтрокаОбесценения.ТипЗадолженности				= Перечисления.ТипыЗадолженности.Дебиторская;
		СтрокаОбесценения.ВидЗадолженности				= Справочники.ВидыЗадолженности.ПоПогашениюКупона;
		СтрокаОбесценения.ОснованиеЗадолженности		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Купон_XS0921331509_301122");
		СтрокаОбесценения.ВероятностьДефолта			= 100;
		СтрокаОбесценения.УровеньПотерьВСлучаеДефолта	= 100;
		
	КонецЕсли;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ОбесценениеЗадолженности, "_ОбесценениеЗадолженности", Запрос);
	
	ПоместитьЗачетАвансовПоПредварительнымЗадолженностямВМенеджерВременныхТаблиц(Запрос);
	
	#Область Текст_основного_запроса
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего) КАК Резерв
	|ПОМЕСТИТЬ _РезервыДляУчетаВСЧА
	|ИЗ
	|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(
	|			&Период,
	|			ПаевойИнвестиционныйФонд В
	|				(ВЫБРАТЬ
