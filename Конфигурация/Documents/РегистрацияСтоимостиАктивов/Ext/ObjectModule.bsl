		|				КОГДА ТИПЗНАЧЕНИЯ(_Задолженность_Вся.ОснованиеЗадолженности) = ТИП(Документ.ПогашениеКупона)
		|					ТОГДА ВЫРАЗИТЬ(_Задолженность_Вся.ОснованиеЗадолженности КАК Документ.ПогашениеКупона).Облигация = _ОценкаДЗПоЦБИКупону.ЦеннаяБумага
		|							И _Задолженность_Вся.ОснованиеЗадолженности = _ОценкаДЗПоЦБИКупону.ОснованиеЗадолженности
		|							И _Задолженность_Вся.ВидЗадолженности = _ОценкаДЗПоЦБИКупону.ВидЗадолженности
		|				КОГДА ТИПЗНАЧЕНИЯ(_Задолженность_Вся.ОснованиеЗадолженности) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|					ТОГДА ВЫРАЗИТЬ(_Задолженность_Вся.ОснованиеЗадолженности КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага = _ОценкаДЗПоЦБИКупону.ЦеннаяБумага
		|							И _Задолженность_Вся.ОснованиеЗадолженности = _ОценкаДЗПоЦБИКупону.ОснованиеЗадолженности
		|							И _Задолженность_Вся.ВидЗадолженности = _ОценкаДЗПоЦБИКупону.ВидЗадолженности
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОценкаПросроченнойДЗ КАК _ОценкаПросроченнойДЗ
		|		ПО _Задолженность_Вся.ОснованиеЗадолженности = _ОценкаПросроченнойДЗ.ОснованиеЗадолженности
		|ГДЕ
		|	_Задолженность_Вся.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4,
		|	""КЗ: "" + _Задолженность_Вся.ВидЗадолженности.Наименование,
		|	_Задолженность_Вся.Валюта,
		|	NULL,
		|	-_Задолженность_Вся.Сумма,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность),
		|	_Задолженность_Вся.ОснованиеЗадолженности,
		|	_Задолженность_Вся.ВидЗадолженности,
		|	_Задолженность_Вся.Контрагент,
		|	NULL
		|ИЗ
		|	_Задолженность_Вся КАК _Задолженность_Вся
		|ГДЕ
		|	_Задолженность_Вся.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4,
		|	""КЗ: Требования о перечислении средств"",
		|	ЗадолженностиДСПоПоручениям.Валюта,
		|	NULL,
		|	-СУММА(ЗадолженностиДСПоПоручениям.СуммаОстаток),
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность),
		|	ЗадолженностиДСПоПоручениям.Основание,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходамИРасходам),
		|	ЕСТЬNULL(ВЫРАЗИТЬ(КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Справочник.ЮрФизЛица), ВЫРАЗИТЬ(ЗадолженностиДСПоПоручениям.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).РасчетныйСчет.Банк.ЮрФизЛицо),
		|	NULL
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
		|			&Период,
		|			&УчитыватьЗадолженностьПоПоручениямНаВыводДС
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема)) КАК ЗадолженностиДСПоПоручениям
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ЗадолженностиДСПоПоручениям.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиДСПоПоручениям.Валюта,
		|	ЗадолженностиДСПоПоручениям.Основание,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Справочник.ЮрФизЛица), ВЫРАЗИТЬ(ЗадолженностиДСПоПоручениям.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).РасчетныйСчет.Банк.ЮрФизЛицо)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4,
		|	""КЗ: брокерская комиссиия"",
		|	_КЗПоБрокерскойКомиссии.Валюта,
		|	NULL,
		|	-_КЗПоБрокерскойКомиссии.СуммаОстаток,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность),
		|	NULL,
		|	_КЗПоБрокерскойКомиссии.ВидЗадолженности,
		|	_КЗПоБрокерскойКомиссии.Контрагент,
		|	NULL
		|ИЗ
		|	_КЗПоБрокерскойКомиссии КАК _КЗПоБрокерскойКомиссии
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	9,
		|	""Сделка СПФИ"",
		|	_СделкиСПФИ.ВалютаСтроки,
		|	_СделкиСПФИ.СубъектАналитики,
		|	0,
		|	_СделкиСПФИ.ВидАктива,
		|	NULL,
		|	NULL,
		|	_СделкиСПФИ.Контрагент,
		|	0
		|ИЗ
		|	_СделкиСПФИ КАК _СделкиСПФИ";
	
	#КонецОбласти
		
	Запрос.Выполнить();
	
	ПроверитьРезультатыВТаблицахЗапроса(Запрос);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.Приоритет КАК Приоритет,
		|	ВЫРАЗИТЬ(_ИтоговаяТаблица.Примечание КАК СТРОКА(150)) КАК Примечание,
		|	_ИтоговаяТаблица.ВалютаСтроки КАК ВалютаСтроки,
		|	_ИтоговаяТаблица.СубъектАналитики КАК СубъектАналитики,
		|	ЕСТЬNULL(_ИтоговаяТаблица.СуммаРынокВВалютеУчета, _ИтоговаяТаблица.СуммаРынок * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс) КАК СуммаРынокВВалютеУчета,
		|	_ИтоговаяТаблица.СуммаРынок КАК СуммаРынок,
		|	_ИтоговаяТаблица.Контрагент КАК Контрагент,
		|	_ИтоговаяТаблица.ОснованиеЗадолженности КАК Основание,
		|	_ИтоговаяТаблица.ВидАктива КАК ВидАктива,
		|	_ИтоговаяТаблица.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _ИтоговаяТаблица.ВалютаСтроки = _КурсыВалют.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|		ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|ГДЕ
		|	(_ИтоговаяТаблица.СуммаРынок <> 0
		|			ИЛИ _ИтоговаяТаблица.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ПрочиеАктивы)
		|				И _ИтоговаяТаблица.СубъектАналитики ССЫЛКА Документ.СделкаСПФИ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
КонецПроцедуры

Процедура ПроверитьРезультатыВТаблицахЗапроса(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОценкаДЗПоЦБИКупону.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	100 КАК ПроцентОбесценения,
		|	_ИтоговаяТаблица.Примечание КАК Примечание
		|ИЗ
		|	_ОценкаДЗПоЦБИКупону КАК _ОценкаДЗПоЦБИКупону
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ПО _ОценкаДЗПоЦБИКупону.ОснованиеЗадолженности = _ИтоговаяТаблица.ОснованиеЗадолженности
		|			И (_ИтоговаяТаблица.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность))
		|ГДЕ
		|	_ОценкаДЗПоЦБИКупону.РезультатОценки = ""Стоимость0""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ОценкаПросроченнойДЗ.ОснованиеЗадолженности,
		|	(1 - _ОценкаПросроченнойДЗ.Коэффициент) * 100,
		|	_ИтоговаяТаблица.Примечание
		|ИЗ
		|	_ОценкаПросроченнойДЗ КАК _ОценкаПросроченнойДЗ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ПО _ОценкаПросроченнойДЗ.ОснованиеЗадолженности = _ИтоговаяТаблица.ОснованиеЗадолженности
		|			И (_ИтоговаяТаблица.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность))
		|			И (_ОценкаПросроченнойДЗ.Коэффициент <> 1)";
	
	ОбесценениеЗадолженности = Запрос.Выполнить().Выгрузить();
	
	Для каждого ТекСтрока Из ОбесценениеЗадолженности Цикл
		ТекстОшибки = СтрШаблон("Произошло обесценение %1 по документу %2 с процентом обесценения %3%%", ТекСтрока.Примечание, ТекСтрока.ОснованиеЗадолженности, ТекСтрока.ПроцентОбесценения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекСтрока.ОснованиеЗадолженности);
	КонецЦикла; 
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПросроченнаяЗадолженность.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	_ПросроченнаяЗадолженность.Сумма КАК СуммаЗадолженности
		|ИЗ
		|	_ПросроченнаяЗадолженность КАК _ПросроченнаяЗадолженность
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РейтинговыеГруппыИВероятностиДефолта КАК _РейтинговыеГруппыИВероятностиДефолта
		|		ПО _ПросроченнаяЗадолженность.ОснованиеЗадолженности = _РейтинговыеГруппыИВероятностиДефолта.ОснованиеЗадолженности
		|ГДЕ
		|	_ПросроченнаяЗадолженность.Сумма > 0
		|	И ЕСТЬNULL(_РейтинговыеГруппыИВероятностиДефолта.Контрагент, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)) = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)";

	ОтсутствующиеСвязанныеКонтрагенты = Запрос.Выполнить().Выгрузить();
	
	Для каждого ТекСтрока Из ОтсутствующиеСвязанныеКонтрагенты Цикл
		ТекстОшибки = СтрШаблон("Не оценена дебиторская задолженность по документу %1, т. к. для этого документа не указан связанный контрагент, или для контрагента не загружены рейтинги!", ТекСтрока.ОснованиеЗадолженности);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекСтрока.ОснованиеЗадолженности);
	КонецЦикла; 	
	
	// Проверяем, что для задолженности по прочим доходам заполнены соответствующие даты оплат
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Задолженность_Вся.ОснованиеЗадолженности КАК ОснованиеЗадолженности
		|ИЗ
		|	_Задолженность_Вся КАК _Задолженность_Вся
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходам)) КАК ПлановыеДатыОплатСрезПоследних
		|		ПО _Задолженность_Вся.ОснованиеЗадолженности = ПлановыеДатыОплатСрезПоследних.Основание
		|ГДЕ
		|	&РассчитыватьПросроченнуюЗадолженностьПоДЗ
		|	И _Задолженность_Вся.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходам)
		|	И _Задолженность_Вся.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	И ТИПЗНАЧЕНИЯ(_Задолженность_Вся.ОснованиеЗадолженности) = ТИП(Документ.НачислениеЗадолженности)
		|	И ПлановыеДатыОплатСрезПоследних.ДатаОплаты ЕСТЬ NULL";	
	
	ОтсутствующиеДатыОплат = Запрос.Выполнить().Выгрузить();
	
	Для каждого ТекСтрока Из ОтсутствующиеДатыОплат Цикл
		ТекстОшибки = СтрШаблон("Не оценена дебиторская задолженность по документу %1, т. к. для этого документа отсутствует запись в регистре сведений 'Плановые даты оплат'!", ТекСтрока.ОснованиеЗадолженности);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ТекСтрока.ОснованиеЗадолженности);
	КонецЦикла; 
					
КонецПроцедуры

Процедура ПоместитьНеВключаемыеВДефолтОблигацииВМенеджерВременныхТаблиц(Запрос)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	ТаблицаИсключенийДляДефолта = Новый ТаблицаЗначений;  
	ТаблицаИсключенийДляДефолта.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаИсключенийДляДефолта.Колонки.Добавить("Облигация", 		Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаИсключенийДляДефолта.Колонки.Добавить("СтатусДефолта", 	Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДефолтаПоОблигациям"));
	ТаблицаИсключенийДляДефолта.Колонки.Добавить("ТипДефолта", 		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДефолтаПоОблигациям"));
	ТаблицаИсключенийДляДефолта.Колонки.Добавить("СрокДействия",	Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	Облигация_О1Пропертиз_Дол 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол");
	Облигация_ОВКФинанс 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОВКФинанс");
	НоваяСтрока 				= ТаблицаИсключенийДляДефолта.Добавить();
	НоваяСтрока.Период 			= '20210129';
	НоваяСтрока.Облигация 		= Облигация_О1Пропертиз_Дол;
	НоваяСтрока.ТипДефолта 		= Перечисления.ТипыДефолтаПоОблигациям.КупонныеВыплаты;
	НоваяСтрока.СтатусДефолта 	= Перечисления.СтатусыДефолтаПоОблигациям.ТехническийДефолт;
	НоваяСтрока.СрокДействия	= '20210210';
	
	НоваяСтрока 				= ТаблицаИсключенийДляДефолта.Добавить();
	НоваяСтрока.Период 			= '20210310';
	НоваяСтрока.Облигация 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс");
	НоваяСтрока.ТипДефолта 		= Перечисления.ТипыДефолтаПоОблигациям.КупонныеВыплаты;
