
#Область Обработчики_событий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Очистить();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
		
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		ПроверкиПередПроведениемДокумента(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	НачислениеСписаниеРезервовОбъект = Неопределено;
	РегистрацияСтоимостиОбъект = Неопределено;
	НачислениеРезервовПИФОбъект = Неопределено;
	ЭтотОбъект.ДополнительныеСвойства.Свойство("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект);
	ЭтотОбъект.ДополнительныеСвойства.Свойство("РегистрацияСтоимости", РегистрацияСтоимостиОбъект);
	ЭтотОбъект.ДополнительныеСвойства.Свойство("НачислениеРезервовПИФ", НачислениеРезервовПИФОбъект);
		
	Если НачислениеСписаниеРезервовОбъект = Неопределено И РегистрацияСтоимостиОбъект = Неопределено И НачислениеРезервовПИФОбъект = Неопределено Тогда
		
		#Область Получение_объектов_документов_НачислениеСписаниеРезервов_РСП_и_НачислениеРезервовПИФ
		
		// пришли сюда не из формы и не из процедуры ЗаполнитьДокументыРегистрацииСтоимости
		// если статус документа изменился - изменим статусы у связанных документов
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		// если режим записи "Запись" - передаем текущее значение поля Проведен
		// если это "Проведение" - передаем Истину
		// если "Отмена проведения" - Ложь
		Запрос.УстановитьПараметр("Проведен", ?(РежимЗаписи = РежимЗаписиДокумента.Запись, ЭтотОбъект.Проведен, РежимЗаписи = РежимЗаписиДокумента.Проведение));
		Запрос.УстановитьПараметр("ПометкаУдаления", ЭтотОбъект.ПометкаУдаления);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	1
			|ИЗ
			|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
			|ГДЕ
			|	РегистрацияСтоимостиАктивов.Ссылка = &Ссылка
			|	И (РегистрацияСтоимостиАктивов.Проведен <> &Проведен
			|			ИЛИ РегистрацияСтоимостиАктивов.ПометкаУдаления <> &ПометкаУдаления)";
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Если ЗначениеЗаполнено(ЭтотОбъект.НачислениеСписаниеРезервов) Тогда
				НачислениеСписаниеРезервовОбъект = ЭтотОбъект.НачислениеСписаниеРезервов.ПолучитьОбъект();
				НачислениеСписаниеРезервовОбъект.ПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
			КонецЕсли; 
			Если ЗначениеЗаполнено(ЭтотОбъект.РегистрацияСтоимости) Тогда
				РегистрацияСтоимостиОбъект = ЭтотОбъект.РегистрацияСтоимости.ПолучитьОбъект();
				РегистрацияСтоимостиОбъект.ПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
			КонецЕсли; 
			Если ЗначениеЗаполнено(ЭтотОбъект.НачислениеРезервовПИФ) Тогда
				НачислениеРезервовПИФОбъект = ЭтотОбъект.НачислениеРезервовПИФ.ПолучитьОбъект();
				НачислениеРезервовПИФОбъект.ПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
			КонецЕсли; 
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	МассивСообщенийПользователю = Новый Массив(ПолучитьСообщенияПользователю(Истина));
	
	Если НачислениеСписаниеРезервовОбъект <> Неопределено Тогда
		
		#Область Проведение_документа_НачислениеСписаниеРезервов
		
		Если НачислениеСписаниеРезервовОбъект.Ссылка.Пустая() Тогда
			НачислениеСписаниеРезервовОбъект.УстановитьНовыйНомер();
		Иначе
			НачислениеСписаниеРезервовОбъект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(НачислениеСписаниеРезервовОбъект.Дата, НачислениеСписаниеРезервовОбъект.Ссылка);
		КонецЕсли; 
		
		Попытка
			НачислениеСписаниеРезервовОбъект.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРегистрацииСтоимостиАктивов");
			НачислениеСписаниеРезервовОбъект.Записать(РежимЗаписи, РежимПроведения);
			ЭтотОбъект.НачислениеСписаниеРезервов = НачислениеСписаниеРезервовОбъект.Ссылка;				
		Исключение
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не удалось записать документ 'Начисление и списание резервов'. Система сообщает:
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ЭтотОбъект.Ссылка, , , Отказ);
			
		КонецПопытки; 
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "НачислениеСписаниеРезервов.");
		
		#КонецОбласти
		
	КонецЕсли;
	 
	Если РегистрацияСтоимостиОбъект <> Неопределено Тогда
		
		#Область Проведение_документа_РСП
		
		Если РегистрацияСтоимостиОбъект.Ссылка.Пустая() Тогда
			РегистрацияСтоимостиОбъект.УстановитьНовыйНомер();
		КонецЕсли; 
		
		Попытка
			РегистрацияСтоимостиОбъект.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРегистрацииСтоимостиАктивов");
			РегистрацияСтоимостиОбъект.Записать(РежимЗаписи, РежимПроведения);
			ЭтотОбъект.РегистрацияСтоимости = РегистрацияСтоимостиОбъект.Ссылка;				
		Исключение
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не удалось записать документ 'Регистрация стоимости переоценки'. Система сообщает:
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ЭтотОбъект.Ссылка, , , Отказ);
			
			Если РегистрацияСтоимостиОбъект.ДополнительныеСвойства.Свойство("ОшибкаОпределенияЦены") Тогда
				ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаОпределенияЦены", РегистрацияСтоимостиОбъект.ДополнительныеСвойства.ОшибкаОпределенияЦены);
			КонецЕсли;
			
		КонецПопытки; 
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "РегистрацияСтоимости.");
		
		#КонецОбласти
		
	КонецЕсли;
	 
	Если НачислениеРезервовПИФОбъект <> Неопределено И НЕ Отказ Тогда
		
		#Область Проведение_документа_НачислениеРезервов
		
		Если НачислениеРезервовПИФОбъект.Ссылка.Пустая() Тогда
			НачислениеРезервовПИФОбъект.УстановитьНовыйНомер();
		КонецЕсли; 
		
		Попытка
			НачислениеРезервовПИФОбъект.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРегистрацииСтоимостиАктивов");
			НачислениеРезервовПИФОбъект.Записать(РежимЗаписи, РежимПроведения);
			ЭтотОбъект.НачислениеРезервовПИФ = НачислениеРезервовПИФОбъект.Ссылка;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ 'Начисление резервов ПИФ'. Система сообщает:
				|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ЭтотОбъект.Ссылка,,, Отказ);
		КонецПопытки;
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "НачислениеРезервовПИФ.");
		
		#КонецОбласти
		
	КонецЕсли;
	
	Если Не Отказ
		И НачислениеСписаниеРезервовОбъект <> Неопределено
		И РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		ПроверитьЗависшиеРезервыПоСписаннымАктивам(Отказ);
				
	КонецЕсли;
	
	ОбщегоНазначения.ВывестиСообщенияПользователю(МассивСообщенийПользователю); 
		
КонецПроцедуры // ПередЗаписью

Процедура ПередУдалением(Отказ)
	
	РаботаСЖурналамиОпераций.ПередУдалениемДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти

#Область Служебные_процедуры_и_функции

Функция ПолучитьКоличествоПаев(СчетДУ, Дата) Экспорт
	
	Результат = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток, 0) КАК КоличествоПаев
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&ПериодГраница, Организация = &Организация) КАК ДолиПайщиковВИнвестиционномФондеОстатки
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд"; 
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ПериодГраница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КоличествоПаев;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьБлокировки(УстановитьБлокировкуПоСвязаннымРегистрам = Ложь)
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ФинансовыеПоказатели"); // при расчете фин. показателей используются значения за предыдущие даты
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",      ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СубъектАналитики", ЭтотОбъект.СчетДоверительногоУправления);
				
	Если УстановитьБлокировкуПоСвязаннымРегистрам Тогда // это заполнение документа с РСП и начислением резервов
		
		ДиапазонБлокировки = Новый Диапазон(НачалоДня(ЭтотОбъект.Дата), КонецДня(ЭтотОбъект.Дата));
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.СтоимостьПереоценки");
		ЭлементБлокировкиДанных.УстановитьЗначение("Период",      					ДиапазонБлокировки);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("ЦельРасчета", 					ЭтотОбъект.ЦельРасчетаСтоимостиОценки);
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.РезервыПИФ");
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	КонецЕсли; 
	
	БлокировкаДанных.Заблокировать();	
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ФинансовыеПоказатели.Записывать 					    = Истина;
	Движения.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Записывать = Истина;
	
	ВидДоговораДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	
	НеобходимаСтоимостьПая = (ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);

	#Область Финансовые_показатели
	ДобавитьСтрокуФинансовогоПоказателя(Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок,  СЧАРынок);
	ДобавитьСтрокуФинансовогоПоказателя(Справочники.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов,      РСА);
	
	Если НеобходимаСтоимостьПая Тогда
		ДобавитьСтрокуФинансовогоПоказателя(Справочники.ВидыФинансовыхПоказателей.СтоимостьПая, СтоимостьПая);
		ДобавитьДвиженияПоказателейДоходностиПИФ(Отказ);
		ПроверитьОтрицательныеОстаткиРезервовПИФ(Отказ);
	КонецЕсли; 
	#КонецОбласти
	
	СформироватьСтоимостьАктивовНеОтносящихсяКЦБ();	
	
	ЗарегистрироватьФинансовыеПоказателиДоходности(Отказ);
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура РассчитатьФинансовыеПоказателиДоходности(ФинансовыеПоказатели, Отказ) Экспорт
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
		ДатаРасчетаДоходностиПФР = Документы.РегистрацияСтоимостиАктивов.ПолучитьДатуРасчетаДоходностиПФР(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата, Отказ);
		Если ДатаРасчетаДоходностиПФР = Неопределено ИЛИ Отказ Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Если ДатаРасчетаДоходностиПФР = НачалоДня(ЭтотОбъект.Дата) Тогда
			//проверка прошлого квартала. Если были изменения и учет не перепроведен, могут быть ошибки
			ДатаПрошлое = ДобавитьМесяц(ЭтотОбъект.Дата, -3);
			ДатаРасчетаДоходностиПФРПрошлое = Документы.РегистрацияСтоимостиАктивов.ПолучитьДатуРасчетаДоходностиПФР(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ДатаПрошлое, Отказ);
			
			Если  Не (ДатаРасчетаДоходностиПФРПрошлое = Неопределено ИЛИ Отказ) Тогда
				ДеталиРасчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьИнвестированияПФР(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления,  КонецКвартала(ДатаПрошлое), Истина);
				ТаблицаРасшифроки = ДеталиРасчета.Расшифровка_Проверка.Таблица;
				Для Каждого СтрокаРасшифровки ИЗ ТаблицаРасшифроки Цикл 
					Если СтрокаРасшифровки.ДоходностьУчет <> СтрокаРасшифровки.ДоходностьРасчет	Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сохраненные показатели доходности ПФР за прошлый квартал расходятся с расчетными. Проверьте документ за прошлый квартал.",,,,Отказ);
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;				
			Для Каждого Элемент Из Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьИнвестированияПФР(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, КонецКвартала(ЭтотОбъект.Дата)) Цикл
				Движение = ФинансовыеПоказатели.Добавить();
				Движение.Период				= ЭтотОбъект.Дата;
				Движение.Организация		= ЭтотОбъект.Организация;
				Движение.СубъектАналитики	= ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ВидПоказателя		= Элемент.Ключ;
				Движение.Значение			= Элемент.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) Тогда
		Для Каждого Элемент Из Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьСтратегииСНачалаГода(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата, Ложь, Отказ) Цикл
			Движение = ФинансовыеПоказатели.Добавить();
			Движение.Период				= ЭтотОбъект.Дата;
			Движение.Организация		= ЭтотОбъект.Организация;
			Движение.СубъектАналитики	= ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ВидПоказателя		= Элемент.Ключ;
			Движение.Значение			= Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьСтоимостьАктивовНеОтносящихсяКЦБ()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияСтоимостиАктивов.Ссылка КАК Регистратор,
		|	РегистрацияСтоимостиАктивов.Дата КАК Период,
		|	РегистрацияСтоимостиАктивов.Организация КАК Организация,
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидАктива КАК ВидАктива,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Контрагент КАК Контрагент,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Основание КАК Основание,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВалютаСтроки КАК Валюта,
		|	МИНИМУМ(РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.НомерСтроки) КАК НомерСтроки,
		|	СУММА(РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаБаланс) КАК СуммаБаланс,
		|	СУММА(РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаРынок) КАК СуммаРынок,
		|	СУММА(РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК СуммаРынокВВалютеУчета,
		|	СУММА(РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СуммаРезерваВВалютеУчета) КАК СуммаРезерваВВалютеУчета,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.УровеньОценки КАК УровеньОценки
		|ИЗ
		|	Документ.РегистрацияСтоимостиАктивов.АктивыНеОтносящиесяКЦеннымБумагам КАК РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|		ПО РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Ссылка = РегистрацияСтоимостиАктивов.Ссылка
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидАктива,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.СубъектАналитики,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Контрагент,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.Основание,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВидЗадолженности,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.ВалютаСтроки,
		|	РегистрацияСтоимостиАктивов.Организация,
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления,
		|	РегистрацияСтоимостиАктивов.Ссылка,
		|	РегистрацияСтоимостиАктивов.Дата,
		|	РегистрацияСтоимостиАктивовАктивыНеОтносящиесяКЦеннымБумагам.УровеньОценки
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки");

	Запрос.УстановитьПараметр("Ссылка", 	  Ссылка);
	Запрос.УстановитьПараметр("КонецПериода", Дата);
	
	Движения.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры // СформироватьСтоимостьАктивовНеОтносящихсяКЦБ()

Процедура ДобавитьСтрокуФинансовогоПоказателя(ВидПоказателя, Значение)
	
	Движение = Движения.ФинансовыеПоказатели.Добавить();
	Движение.Период = ЭтотОбъект.Дата;
	Движение.Организация = ЭтотОбъект.Организация;
	Движение.СубъектАналитики = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ВидПоказателя = ВидПоказателя;
	Движение.Значение = Значение;
	
КонецПроцедуры // ДобавитьСтрокуФинансовогоПоказателя

Процедура ДобавитьДвиженияПоказателейДоходностиПИФ(Отказ)

	Движения.ФинансовыеПоказатели.Записать();
	Движения.ФинансовыеПоказатели.Записывать = Истина;
	
	МВТ = Новый МенеджерВременныхТаблиц; 
	Документы.РегистрацияСтоимостиАктивов.РасчетПоказателейПИФ(
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Дата,
		МВТ,
		Отказ);
	
	ВыборкаДоходность = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		МВТ, "_Доходность", Ложь, "ВидПоказателя, Значение", "Значение <> Неопределено", "Порядок, КоличествоИнтервалов").Выбрать();
		
	Пока ВыборкаДоходность.Следующий() Цикл
		ДобавитьСтрокуФинансовогоПоказателя(ВыборкаДоходность.ВидПоказателя, ВыборкаДоходность.Значение);
	КонецЦикла; 
	
	ВыборкаОтклонение = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		МВТ, "_ОтклонениеИндикатора", Ложь, "ВидПоказателя, Значение", , "Порядок УБЫВ, КоличествоИнтервалов").Выбрать();
		
	Пока ВыборкаОтклонение.Следующий() Цикл
		ДобавитьСтрокуФинансовогоПоказателя(ВыборкаОтклонение.ВидПоказателя, ВыборкаОтклонение.Значение);
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьТаблицуАктивовИОбязательств(Параметры, МенеджерВременныхТаблиц = Неопределено) Экспорт
	// Проверки корректности настроек
	НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(
		Параметры.Период, Параметры.Организация, Параметры.СчетДоверительногоУправления);
	
	Если НастройкиФормированияСЧА = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Параметры.Вставить("НастройкиФормированияСЧА", НастройкиФормированияСЧА);
	КонецЕсли;
	
	Если Не Параметры.Свойство("ТаблицаСтоимостей") Тогда
		Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
			И Параметры.Период >= Дата(2020, 1, 1)
			И ДополнительныеСвойства.Свойство("ТаблицаСтоимостейИзФайла")
		Тогда
			// #Техдолг, потому что запрос _КотировкиКупона повторяет аналогичный из РаботаСПереоценкой.ПодготовитьЗапросТаблицыКотировок,
			//	а там имеется вариативность в зависимости от методики
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ТаблицаСтоимостей",	ДополнительныеСвойства.ТаблицаСтоимостейИзФайла);
			Запрос.УстановитьПараметр("ВалютаУчета",		Параметры.Организация.ВалютаУчета);
			Запрос.УстановитьПараметр("ДатаПереоценки",		Параметры.Период);
			Запрос.УстановитьПараметр("ММВБ",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			Запрос.УстановитьПараметр("Блумберг",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
			Запрос.УстановитьПараметр("Режим_BGN",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
			Запрос.Текст =
			#Область ТекстЗапроса
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ТаблицаСтоимостей.Рынок КАК Рынок,
				|	ТаблицаСтоимостей.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ТаблицаСтоимостей.Стоимость КАК Стоимость,
				|	ТаблицаСтоимостей.ВидЦены КАК ВидЦены,
				|	ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки,
				|	ТаблицаСтоимостей.ДатаЦены КАК ДатаЦены,
				|	ТаблицаСтоимостей.Источник КАК Источник,
				|	ТаблицаСтоимостей.ВалютаКотировки КАК ВалютаКотировки
				|ПОМЕСТИТЬ _ТаблицаСтоимостей
				|ИЗ
				|	&ТаблицаСтоимостей КАК ТаблицаСтоимостей
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТаблицаСтоимостей.Рынок КАК Рынок,
				|	_ТаблицаСтоимостей.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ТаблицаСтоимостей.Стоимость КАК Стоимость,
				|	_ТаблицаСтоимостей.ВидЦены КАК ВидЦены,
				|	_ТаблицаСтоимостей.УровеньОценки КАК УровеньОценки,
				|	_ТаблицаСтоимостей.ДатаЦены КАК ДатаЦены,
				|	_ТаблицаСтоимостей.Источник КАК Источник,
				|	_ТаблицаСтоимостей.ВалютаКотировки КАК ВалютаКотировки,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.Акции)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.Облигации)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.ПроизводныеФинансовыеИнструменты)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
				|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаСтоимостей.ЦеннаяБумага) = ТИП(Справочник.Паи)
				|			ТОГДА ВЫРАЗИТЬ(_ТаблицаСтоимостей.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
				|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
				|	КОНЕЦ КАК ВалютаНоминала
				|ПОМЕСТИТЬ _ТаблицаСтоимостейСВалютами
				|ИЗ
				|	_ТаблицаСтоимостей КАК _ТаблицаСтоимостей
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТаблицаСтоимостейСВалютами.ЦеннаяБумага КАК ЦеннаяБумага,
				|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
				|	КотировкиТорговыхПлощадок.Период КАК Период,
				|	КотировкиТорговыхПлощадок.Рынок КАК Рынок,
				|	КотировкиТорговыхПлощадок.РежимТоргов КАК РежимТоргов,
				|	КотировкиТорговыхПлощадок.Валюта КАК Валюта,
				|	КотировкиТорговыхПлощадок.ACCINT КАК ACCINT
				|ПОМЕСТИТЬ _ПоследниеКотировки
				|ИЗ
				|	_ТаблицаСтоимостейСВалютами КАК _ТаблицаСтоимостейСВалютами
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
				|		ПО _ТаблицаСтоимостейСВалютами.ЦеннаяБумага = Облигации.Ссылка
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
				|		ПО (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
				|			И (КотировкиТорговыхПлощадок.Период = &ДатаПереоценки)
				|			И (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ТаблицаСтоимостейСВалютами.ЦеннаяБумага)
				|			И (КотировкиТорговыхПлощадок.Биржа = &ММВБ)
				|			И (КотировкиТорговыхПлощадок.Валюта В (Облигации.ВалютаНоминала, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)))
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	_ТаблицаСтоимостейСВалютами.ЦеннаяБумага,
				|	КотировкиТорговыхПлощадок.Биржа
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ПоследниеКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	МАКСИМУМ(_ПоследниеКотировки.РежимТоргов) КАК РежимТорговДляACCINT
				|ПОМЕСТИТЬ _РежимыТорговПоследнихКотировок
				|ИЗ
				|	_ПоследниеКотировки КАК _ПоследниеКотировки
				|
				|СГРУППИРОВАТЬ ПО
				|	_ПоследниеКотировки.ЦеннаяБумага
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	_ПоследниеКотировки.ЦеннаяБумага
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТаблицаСтоимостейСВалютами.ЦеннаяБумага КАК ЦеннаяБумага,
				|	Облигации.ВалютаНоминала КАК ВалютаКупона,
				|	ВЫБОР
				|		КОГДА НЕ КупоныВыходногоДня.Период ЕСТЬ NULL
				|			ТОГДА НЕОПРЕДЕЛЕНО
				|		ИНАЧЕ ПоследниеКотировкиДляACCINT.РежимТоргов
				|	КОНЕЦ КАК РежимТорговДляACCINT,
				|	ЕСТЬNULL(КупоныВыходногоДня.ACCINT, ПоследниеКотировкиДляACCINT.ACCINT) КАК Купон
				|ПОМЕСТИТЬ _КотировкиКупонов
				|ИЗ
				|	_ТаблицаСтоимостейСВалютами КАК _ТаблицаСтоимостейСВалютами
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
				|		ПО _ТаблицаСтоимостейСВалютами.ЦеннаяБумага = Облигации.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыТорговПоследнихКотировок КАК _РежимыТорговПоследнихКотировок
				|		ПО _ТаблицаСтоимостейСВалютами.ЦеннаяБумага = _РежимыТорговПоследнихКотировок.ЦеннаяБумага
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеКотировки КАК ПоследниеКотировкиДляACCINT
				|		ПО (_РежимыТорговПоследнихКотировок.ЦеннаяБумага = ПоследниеКотировкиДляACCINT.ЦеннаяБумага)
				|			И (_РежимыТорговПоследнихКотировок.РежимТорговДляACCINT = ПоследниеКотировкиДляACCINT.РежимТоргов)
				|			И (ПоследниеКотировкиДляACCINT.Период = &ДатаПереоценки)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупоныВыходногоДня КАК КупоныВыходногоДня
				|		ПО (КупоныВыходногоДня.Период = &ДатаПереоценки)
				|			И (_ТаблицаСтоимостейСВалютами.ЦеннаяБумага ССЫЛКА Справочник.Облигации)
				|			И _ТаблицаСтоимостейСВалютами.ЦеннаяБумага = КупоныВыходногоДня.Облигация
				|			И (КупоныВыходногоДня.Биржа = &ММВБ)
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	_ТаблицаСтоимостейСВалютами.ЦеннаяБумага
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТаблицаСтоимостейСВалютами.Рынок КАК Рынок,
				|	_ТаблицаСтоимостейСВалютами.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ТаблицаСтоимостейСВалютами.Стоимость КАК Стоимость,
				|	_КотировкиКупонов.Купон КАК Купон,
				|	_ТаблицаСтоимостейСВалютами.ВидЦены КАК ВидЦены,
				|	_ТаблицаСтоимостейСВалютами.УровеньОценки КАК УровеньОценки,
				|	_ТаблицаСтоимостейСВалютами.ДатаЦены КАК ДатаЦены,
				|	_ТаблицаСтоимостейСВалютами.Источник КАК Источник,
				|	_ТаблицаСтоимостейСВалютами.ВалютаНоминала КАК ВалютаНоминала,
				|	_ТаблицаСтоимостейСВалютами.ВалютаКотировки КАК ВалютаКотировки,
				|	_КотировкиКупонов.ВалютаКупона КАК ВалютаКупона
				|ИЗ
				|	_ТаблицаСтоимостейСВалютами КАК _ТаблицаСтоимостейСВалютами
				|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиКупонов КАК _КотировкиКупонов
				|		ПО _ТаблицаСтоимостейСВалютами.ЦеннаяБумага = _КотировкиКупонов.ЦеннаяБумага";
			#КонецОбласти
			Параметры.Вставить("ТаблицаСтоимостей", Запрос.Выполнить().Выгрузить());
		Иначе
			Параметры.Вставить("ТаблицаСтоимостей", Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Если Не Параметры.Свойство("УчитыватьПлановыеОперации") Тогда
		Параметры.Вставить("УчитыватьПлановыеОперации", Ложь);
	КонецЕсли;
	
	ПараметрыДляПогашенныхЦБ = Новый Структура("Дата, Организация, СчетДоверительногоУправления, ЦельРасчета");
	ЗаполнитьЗначенияСвойств(ПараметрыДляПогашенныхЦБ, ЭтотОбъект);
	ПараметрыДляПогашенныхЦБ.ЦельРасчета = ЭтотОбъект.ЦельРасчетаСтоимостиОценки;
	ПараметрыДляПогашенныхЦБ.Вставить("ВариантРасчетаСправедливойСтоимости", Параметры.ВариантРасчетаОценочнойСтоимости);
	
	Параметры.Вставить("СпособОценкиПогашенныхБумаг", РаботаСПереоценкой.СпособОценкиПогашенныхЦенныхБумаг(ПараметрыДляПогашенныхЦБ));
	
	РезультатЗапроса = ПолучитьВыборкуДанных(Параметры, МенеджерВременныхТаблиц);
	Если РезультатЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции

Функция ПолучитьВыборкуДанных(Параметры, МенеджерВременныхТаблиц)
	
	Отказ = Ложь;
	
	// Для ПИФов проверим даты. Возможно, формирование СЧА не требуется
	
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		Если Не ПроверкаКлючевыхДатПИФПройдена(Параметры) Тогда
			Отказ = Истина;
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Параметры.ВариантРасчетаОценочнойСтоимости) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	Если Параметры.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении
		И (Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ 
			ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс)
	Тогда

		#Область Получение_остатков_партий_ценных_бумаг	
	
		Параметры.Вставить("РасчетПартий", Неопределено);	
		
		РеквизитыОценки = Новый Структура;
		РеквизитыОценки.Вставить("Организация",						Параметры.Организация);
		РеквизитыОценки.Вставить("СчетДоверительногоУправления",	Параметры.СчетДоверительногоУправления);
		РеквизитыОценки.Вставить("ЦельРасчета",						Параметры.ЦельРасчета);
		РеквизитыОценки.Вставить("ВидУчета",						Параметры.ВидУчета);
		РеквизитыОценки.Вставить("Дата",							Параметры.Период);
		РеквизитыОценки.Вставить("Ссылка",							Документы.РегистрацияСтоимостиПереоценки.ПустаяСсылка());
		
		РаботаСПереоценкой.ПолучитьЦенныеБумаги(РеквизитыОценки, Новый МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", , Параметры.РасчетПартий);  	
		
		#КонецОбласти
		
	КонецЕсли;
			 	
	Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений 
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов
	Тогда
	
		СформироватьЗапросРыночная2ПН_ПР(Запрос, Параметры, Отказ); // Для ПН и ПР - временный вариант по определению видов задолженности, не включаемых в СЧА
		
	ИначеЕсли Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС_УКПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
	Тогда
		
		СформироватьЗапросРЭМ(Запрос, Параметры, Отказ);
		
	ИначеЕсли Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СправедливаяПИФ Тогда
				
		СформироватьЗапросСправедливаяПИФ(Запрос, Параметры, Отказ);
		
	ИначеЕсли Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2018
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2020
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ОПИФ2021
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2018
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ2021
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФк_ФДЦБ2021
	Тогда
		
		СформироватьЗапросРасчетСЧА_ПИФ2018(Запрос, Параметры, Отказ);
		
	ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов
		ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний
		ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний
		//Будущее (включая Образование и СоцРазвитие) и Традиция даже СС теперь по методике ПН/ПР, но с определенной даты
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее201218 
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Будущее2020 
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Традиция2019
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_Нефтегарант2018
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Эволюция2021_2
		// Аквилон СС по методике Аквилона
        ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2019
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Национальный2020
		ИЛИ Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Аквилон2021
	Тогда
		
		СформироватьЗапросРасчетСЧА_НПФ2018(Запрос, Параметры, Отказ);
		
	КонецЕсли;
	
	Если Отказ ИЛИ ПустаяСтрока(Запрос.Текст) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура СформироватьЗапросРыночная2ПН_ПР(Запрос, Параметры, Отказ)

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НачислениеЗадолженности.Ссылка КАК Ссылка,
	|	НачислениеЗадолженности.Дата КАК Дата,
	|	НачислениеЗадолженности.ВидЗадолженности КАК ВидЗадолженности
	|ИЗ
	|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
	|ГДЕ
	|	НачислениеЗадолженности.Организация = &Организация
	|	И НачислениеЗадолженности.Дата МЕЖДУ &ДатаНачала И КОНЕЦПЕРИОДА(&Дата, ГОД)
	|	И НачислениеЗадолженности.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария))
	|	И НачислениеЗадолженности.Проведен
	|	И НачислениеЗадолженности.НеУчитыватьВСЧА
	|	И НачислениеЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НачислениеЗадолженности.Ссылка,
	|	НачислениеЗадолженности.Дата,
	|	НачислениеЗадолженности.ВидЗадолженности
	|ИЗ
	|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
	|ГДЕ
	|	НачислениеЗадолженности.Организация = &Организация
	|	И НачислениеЗадолженности.Дата МЕЖДУ &ДатаНачала И КОНЕЦПЕРИОДА(&Дата, ГОД)
	|	И НачислениеЗадолженности.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария))
	|	И НачислениеЗадолженности.Проведен
	|	И НачислениеЗадолженности.НеУчитыватьВСЧА
	|	И НачислениеЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", 	Параметры.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 			НачалоДня(Параметры.Период));
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоМесяца(Параметры.Период));
	
	ТаблицаУчетаЗадолженностиВСЧА = Запрос.Выполнить().Выгрузить();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостиДепозитныхВкладов.КредитныйИнструмент КАК ДепозитныйВклад,
	|	СтоимостиДепозитныхВкладов.Номинал КАК Номинал,
	|	СтоимостиДепозитныхВкладов.Проценты КАК Проценты
	|ПОМЕСТИТЬ _СтоимостиДепозитныхВкладовИзПараметра
	|ИЗ
	|	&СтоимостиДепозитныхВкладов КАК СтоимостиДепозитныхВкладов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДепозитныйВклад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
	|ПОМЕСТИТЬ _КурсыВалют
	|ИЗ
