КонецПроцедуры
		
//Тех.долг: перенести в общий модуль. Этаже функция используется в отчёности ЦБ
Процедура ДобавитьКалендари(СчетДоверительногоУправления, Период, Отказ, МенеджерВременныхТаблиц)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;

	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(
		СчетДоверительногоУправления, 
		Период,
		Справочники.Календари.Общероссийский,, ДобавитьМесяц(Период, -12), ДобавитьМесяц(Период, 12),
		МенеджерВременныхТаблиц);

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаряВсеДни.Дата КАК Дата,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаряРабочиеДни.Дата) КАК КоличествоРабочихДней
		|ПОМЕСТИТЬ ВТ_КоличествоДнейСДатыНачала
		|ИЗ
		|	_ДанныеКалендаря КАК ДанныеКалендаряВсеДни
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеКалендаря КАК ДанныеКалендаряРабочиеДни
		|		ПО ДанныеКалендаряВсеДни.Дата >= ДанныеКалендаряРабочиеДни.Дата
		|			И (ДанныеКалендаряРабочиеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДанныеКалендаряРабочиеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|ГДЕ
		|	ДанныеКалендаряВсеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаряВсеДни.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаряВсеДни.Дата КАК Дата,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаряРабочиеДни.Дата) КАК КоличествоРабочихДней
		|ПОМЕСТИТЬ ВТ_КоличествоРабочихДнейСДатыНачала
		|ИЗ
		|	_ДанныеКалендаря КАК ДанныеКалендаряВсеДни
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеКалендаря КАК ДанныеКалендаряРабочиеДни
		|		ПО ДанныеКалендаряВсеДни.Дата >= ДанныеКалендаряРабочиеДни.Дата
		|			И (ДанныеКалендаряРабочиеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДанныеКалендаряРабочиеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|ГДЕ
		|	ДанныеКалендаряВсеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаряВсеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаряВсеДни.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_КоличествоДнейСДатыНачала.Дата КАК ДатаОперации,
		|	ВТ_КоличествоРабочихДнейСДатыНачала.КоличествоРабочихДней - ВТ_КоличествоДнейСДатыНачала.КоличествоРабочихДней КАК КоличествоДней,
		|	ВТ_КоличествоРабочихДнейСДатыНачала.Дата КАК ДатаОплаты
		|ПОМЕСТИТЬ ВТ_КоличествоРабочихДней
		|ИЗ
		|	ВТ_КоличествоДнейСДатыНачала КАК ВТ_КоличествоДнейСДатыНачала,
		|	ВТ_КоличествоРабочихДнейСДатыНачала КАК ВТ_КоличествоРабочихДнейСДатыНачала
		|ГДЕ
		|	ВТ_КоличествоРабочихДнейСДатыНачала.КоличествоРабочихДней - ВТ_КоличествоДнейСДатыНачала.КоличествоРабочихДней >= 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&СПоследнегоКалендарногоДняМесяца КАК Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СПоследнегоКалендарногоДняМесяца) КАК Вариант
		|ПОМЕСТИТЬ ВТ_ВариантыНачалаСрока
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СНачалаТекущегоМесяца,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СНачалаТекущегоМесяца)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СНачалаТекущегоКвартала,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СНачалаТекущегоКвартала)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СПоследнегоРабочегоДняМесяца,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СПоследнегоРабочегоДняМесяца)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СКонцаТекущегоКвартала,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СКонцаТекущегоКвартала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_КоличествоДнейСДатыНачала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_КоличествоРабочихДнейСДатыНачала";
	
	Запрос.УстановитьПараметр("СНачалаТекущегоМесяца",				НачалоМесяца(Период));
	Запрос.УстановитьПараметр("СНачалаТекущегоКвартала",			НачалоКвартала(Период));
	Запрос.УстановитьПараметр("СПоследнегоРабочегоДняМесяца",		Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(Период)));
	Запрос.УстановитьПараметр("СПоследнегоКалендарногоДняМесяца",	НачалоДня(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("СКонцаТекущегоКвартала",				НачалоДня(КонецКвартала(Период)));
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
КонецПроцедуры

Процедура ПолучитьПараметрыСтавкиСДСР(Запрос, ВидДоговора, Суффикс, Отказ)

	Запрос.УстановитьПараметр("ВидДоговораСДСР", ВидДоговора);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчетаСоставляющие.БазаРасчета КАК БазаРасчета,
		|	НастройкиРасчетаСоставляющие.ПараметрыРасчета КАК ПараметрыРасчета
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Справочник_Договоры
		|		ПО (Справочник_Договоры.Ссылка = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка)
		|			И (Справочник_Договоры.ВидДоговора = &ВидДоговораСДСР)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка = УсловияДоговоровОбщиеСрезПоследних.Договор.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДепозитарногоОбслуживания.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровДепозитарногоОбслуживанияСрезПоследних
		|		ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка = УсловияДоговоровДепозитарногоОбслуживанияСрезПоследних.Договор.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|		ПО (УсловияДоговоровДепозитарногоОбслуживанияСрезПоследних.НастройкаРасчетаЕжедневнойКредиторки = НастройкиРасчетаСоставляющие.Ссылка)
		|ГДЕ
		|	(ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(2100, 1, 1)) > &Период
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|";

	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Количество() > 0 Тогда

		Результат.Следующий();
		Если Результат.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтОднойДвенадцатойПоследнейСЧА Тогда
			Параметры = Результат.ПараметрыРасчета.Получить();
			Запрос.УстановитьПараметр("Ставка" + Суффикс, Параметры.ПараметрРасчетаСтавка);
			Запрос.УстановитьПараметр("НижняяГраница" + Суффикс, Параметры.ПараметрРасчетаНижняяГраницаСуммы);
		ИначеЕсли Результат.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
			Параметры = Результат.ПараметрыРасчета.Получить();
			Запрос.УстановитьПараметр("Ставка" + Суффикс, 0);
			Запрос.УстановитьПараметр("НижняяГраница" + Суффикс, Параметры.ПараметрРасчетаСумма);
		Иначе
			Если ЗначениеЗаполнено(Результат.БазаРасчета) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчёт ежедневного вознаграждения СД/СР возможно только от базы 1/12 последней СЧА или фикс.суммой в месяц",,,, Отказ);
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура ПолучитьРасчетныеЗадолженностиРПИ(Организация, СчетДоверительногоУправления, Валюта, Период, Отказ, МенеджерВременныхТаблиц)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("КонецПрошлогоМесяца", НачалоМесяца(Период) - 1);
	Запрос.УстановитьПараметр("ДнейВМесяце", День(КонецМесяца(Период)));
	Запрос.УстановитьПараметр("ТекущийДень", День(Период));
	Запрос.УстановитьПараметр("ДнейВКвартале", (КонецКвартала(Период) - НачалоКвартала(Период) + 1) / 86400);
	Запрос.УстановитьПараметр("ТекущийДеньКвартала", (Период - НачалоКвартала(Период)) / 86400 + 1);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", Валюта);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СтавкаСД", 0);
	Запрос.УстановитьПараметр("НижняяГраницаСД", 0);
	Запрос.УстановитьПараметр("СтавкаСР", 0);
	Запрос.УстановитьПараметр("НижняяГраницаСР", 0);
	Запрос.УстановитьПараметр("ЕжедневноеФормированиеСЧА", РегистрыСведений.НастройкиФормированияСЧА.ЕжедневноеФормированиеСЧА(Период, Организация, СчетДоверительногоУправления));
	
	ПолучитьПараметрыСтавкиСДСР(Запрос, Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания, "СД", Отказ);
	ПолучитьПараметрыСтавкиСДСР(Запрос, Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания, "СР", Отказ);
	
	ДобавитьКалендари(СчетДоверительногоУправления, Период, Отказ, МенеджерВременныхТаблиц);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ДЗ: Расч. "" + УсловияДоговоровАрендыСрезПоследних.ВидЗадолженности.Наименование КАК Примечание,
		|	&ВалютаУчета КАК Валюта,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Договор,
		|	Справочник_Договоры.Контрагент КАК Контрагент,
		|	УсловияДоговоровАрендыСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность) КАК ВидАктива,
		|	ВЫРАЗИТЬ(УсловияДоговоровАрендыСрезПоследних.Сумма / &ДнейВМесяце * &ТекущийДень КАК ЧИСЛО(19, 2)) КАК Сумма
		|ПОМЕСТИТЬ _РасчетныеЗадолженностиРПИБезСроков
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Справочник_Договоры
		|		ПО (Справочник_Договоры.Ссылка = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка)
		|			И (Справочник_Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Аренды))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровАренды.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВидДоговораАренды = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровАренды.Передачи)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде)) КАК УсловияДоговоровАрендыСрезПоследних
		|		ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка = УсловияДоговоровАрендыСрезПоследних.Договор.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка = УсловияДоговоровОбщиеСрезПоследних.Договор.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО (НачислениеЗадолженности.Дата > &КонецПрошлогоМесяца)
		|			И (НачислениеЗадолженности.Дата <= &Период)
		|			И (НачислениеЗадолженности.Проведен = ИСТИНА)
		|			И (НачислениеЗадолженности.Организация = &Организация)
		|			И (НачислениеЗадолженности.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоАренде))
		|			И (НачислениеЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (НачислениеЗадолженности.Договор = УсловияДоговоровАрендыСрезПоследних.Договор)
		|			И (НачислениеЗадолженности.НачалоПериодаНачисления > &КонецПрошлогоМесяца)
		|			И (НачислениеЗадолженности.ОкончаниеПериодаНачисления <= &Период)
		|ГДЕ
		|	УсловияДоговоровАрендыСрезПоследних.Сумма > 0
		|	И УсловияДоговоровАрендыСрезПоследних.Сумма / &ДнейВМесяце * &ТекущийДень > 0
		|	И НачислениеЗадолженности.Ссылка ЕСТЬ NULL
		|	И (ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(2100, 1, 1)) > &Период
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ДЗ: Расч. "" + УсловияДоговоровАрендыСрезПоследних.ВидЗадолженности.Наименование,
		|	&ВалютаУчета,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор,
		|	Справочник_Договоры.Контрагент,
		|	УсловияДоговоровАрендыСрезПоследних.ВидЗадолженности,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность),
		|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(УсловияДоговоровПрогнозируемаяСтоимостьСрезПоследних.Сумма КАК ЧИСЛО(19, 2))) / &ДнейВМесяце * &ТекущийДень КАК ЧИСЛО(19, 2))
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Справочник_Договоры
		|		ПО (Справочник_Договоры.Ссылка = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Ссылка)
		|			И (Справочник_Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Аренды))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровАренды.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
