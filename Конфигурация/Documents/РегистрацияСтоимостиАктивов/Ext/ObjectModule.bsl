		|	_ИтоговаяТаблица.ОснованиеЗадолженности КАК Основание,
		|	_ИтоговаяТаблица.ВидАктива КАК ВидАктива,
		|	_ИтоговаяТаблица.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _ИтоговаяТаблица.ВалютаСтроки = _КурсыВалют.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|		ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФорвардыПоставочные КАК _ФорвардыПоставочные
		|		ПО _ИтоговаяТаблица.ОснованиеЗадолженности = _ФорвардыПоставочные.Ссылка
		|ГДЕ
		|	(&СчитатьВалютныеФорвардыПоЧестному
		|			ИЛИ (ЕСТЬNULL(_ИтоговаяТаблица.ВидЗадолженности, ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоФорвардуПоставки)
		|				ИЛИ _ИтоговаяТаблица.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоФорвардуПоставки)
		|					И _ИтоговаяТаблица.ВалютаСтроки = _ФорвардыПоставочные.Валюта))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.Приоритет,
		|	_ИтоговаяТаблица.Примечание,
		|	_ИтоговаяТаблица.ВалютаСтроки,
		|	_ИтоговаяТаблица.СубъектАналитики,
		|	_ИтоговаяТаблица.Контрагент,
		|	_ИтоговаяТаблица.ОснованиеЗадолженности,
		|	_ИтоговаяТаблица.ВидАктива,
		|	_ИтоговаяТаблица.ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ВалютаСтроки = &ВалютаУчета
		|			ТОГДА _ИтоговаяТаблица.СуммаРынок
		|		КОГДА &ВестиРасчетПоПартиям
		|				И _ИтоговаяТаблица.СуммаВВалютеУчета <> 0
		|				И (ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Облигации)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Векселя)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Паи)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.ДепозитарныеРасписки)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Доли)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Закладные)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.СубъектАналитики) = ТИП(Справочник.Акции))
		|			ТОГДА _ИтоговаяТаблица.СуммаВВалютеУчета
		|		ИНАЧЕ _ИтоговаяТаблица.СуммаРынок * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИтоговаяТаблицаКонтрвалюта.Приоритет,
		|	_ИтоговаяТаблицаКонтрвалюта.Примечание,
		|	&ВалютаУчета,
		|	_ИтоговаяТаблицаКонтрвалюта.СубъектАналитики,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ВалютаСтроки = &ВалютаУчета
		|			ТОГДА _ИтоговаяТаблица.СуммаРынок
		|		ИНАЧЕ _ИтоговаяТаблица.СуммаРынок * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс
		|	КОНЕЦ * -1,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ВалютаСтроки = &ВалютаУчета
		|			ТОГДА _ИтоговаяТаблица.СуммаРынок
		|		ИНАЧЕ _ИтоговаяТаблица.СуммаРынок * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс
		|	КОНЕЦ * -1,
		|	_ИтоговаяТаблицаКонтрвалюта.Контрагент,
		|	_ИтоговаяТаблицаКонтрвалюта.ОснованиеЗадолженности,
		|	_ИтоговаяТаблицаКонтрвалюта.ВидАктива,
		|	_ИтоговаяТаблицаКонтрвалюта.ВидЗадолженности
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ФорвардыПоставочные КАК _ФорвардыПоставочные
		|		ПО _ИтоговаяТаблица.ОснованиеЗадолженности = _ФорвардыПоставочные.Ссылка
		|			И _ИтоговаяТаблица.ВалютаСтроки = _ФорвардыПоставочные.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИтоговаяТаблица КАК _ИтоговаяТаблицаКонтрвалюта
		|		ПО _ИтоговаяТаблица.ОснованиеЗадолженности = _ИтоговаяТаблицаКонтрвалюта.ОснованиеЗадолженности
		|			И (_ФорвардыПоставочные.Контрвалюта = _ИтоговаяТаблицаКонтрвалюта.ВалютаСтроки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _ИтоговаяТаблица.ВалютаСтроки = _КурсыВалют.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|		ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыКонтрвалюты
		|		ПО (_КурсыКонтрвалюты.Валюта = _ФорвардыПоставочные.Контрвалюта)
		|ГДЕ
		|	НЕ &СчитатьВалютныеФорвардыПоЧестному
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";		
	#КонецОбласти

КонецПроцедуры

Процедура СформироватьЗапросСправедливаяПИФ(Запрос, Параметры, Отказ)

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостиДепозитныхВкладов.КредитныйИнструмент КАК ДепозитныйВклад,
	|	СтоимостиДепозитныхВкладов.Номинал КАК Номинал,
	|	СтоимостиДепозитныхВкладов.Проценты КАК Проценты
	|ПОМЕСТИТЬ _СтоимостиДепозитныхВкладов
	|ИЗ
	|	&СтоимостиДепозитныхВкладов КАК СтоимостиДепозитныхВкладов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДепозитныйВклад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
	|ПОМЕСТИТЬ _КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Период = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДефолтыПоОблигациямСрезПоследних.Период КАК Период,
	|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация,
	|	ДефолтыПоОблигациямСрезПоследних.ТипДефолта КАК ТипДефолта,
	|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта КАК СтатусДефолта,
	|	ДефолтыПоОблигациямСрезПоследних.Облигация.Эмитент КАК ОблигацияЭмитент
	|ПОМЕСТИТЬ _ДефолтыОблигаций
	|ИЗ
	|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&Период, ТипДефолта В (ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации), ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство))) КАК ДефолтыПоОблигациямСрезПоследних
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
	|				ТОГДА ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_ДефолтыОблигаций.ОблигацияЭмитент.ЮрФизЛицо КАК Эмитент
	|ПОМЕСТИТЬ _ЭмитентыВДефолте
	|ИЗ
	|	_ДефолтыОблигаций КАК _ДефолтыОблигаций
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.ТипЗадолженности КАК ТипЗадолженности,
	|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
	|	ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
	|	ВложенныйЗапрос.Валюта КАК Валюта
	|ПОМЕСТИТЬ _Задолженность_Вся
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
	|		ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
	|		ВЫБОР
	|			КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи))
	|				ТОГДА НЕОПРЕДЕЛЕНО
	|			ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.Основание
	|		КОНЕЦ КАК ОснованиеЗадолженности,
	|		ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма,
	|		ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
	|		ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент
	|	ИЗ
	|		РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|					И НЕ ВидЗадолженности В (&СписокВидовЗадолженности)) КАК ЗадолженностиПоДенежнымСредствамОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыВДефолте КАК _ЭмитентыВДефолте
	|			ПО ЗадолженностиПоДенежнымСредствамОстатки.Контрагент = _ЭмитентыВДефолте.Эмитент
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧАПоВидамЗадолженности.СрезПоследних(
	|					&КонецПериода,
	|					Организация = &Организация
	|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних
	|			ПО ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних.ВидЗадолженности
	|				И (ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
	|	ГДЕ
	|		(НЕ ЕСТЬNULL(НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних.ЗадолженностьУчитываетсяВСЧАСДатыПолученияДокумента, ЛОЖЬ)
	|				ИЛИ ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаПолученияДокумента, &КонецПериода) <= &КонецПериода
	|					И ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаПолученияДокумента, &КонецПериода) <> ДАТАВРЕМЯ(1, 1, 1))
	|		И _ЭмитентыВДефолте.Эмитент ЕСТЬ NULL) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ВидЗадолженности,
	|	ВложенныйЗапрос.ТипЗадолженности,
	|	ВложенныйЗапрос.ОснованиеЗадолженности,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.Сумма > 0
	|			ТОГДА ВложенныйЗапрос.ТипЗадолженности
	|		КОГДА ВложенныйЗапрос.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	|	КОНЕЦ,
	|	ВложенныйЗапрос.ВидЗадолженности,
	|	ВложенныйЗапрос.ОснованиеЗадолженности,
	|	NULL,
	|	ВложенныйЗапрос.Сумма,
	|	ВложенныйЗапрос.Валюта
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.ТипЗадолженности КАК ТипЗадолженности,
	|		ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
	|		ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
	|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
	|		ВложенныйЗапрос.Валюта КАК Валюта
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
	|			ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
	|			ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК ОснованиеЗадолженности,
	|			ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма,
	|			ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта
	|		ИЗ
	|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
	|					&Период,
	|					Организация = &Организация
	|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|						И ВидЗадолженности В (&СписокВидовЗадолженности)
	|						И НЕ Основание ССЫЛКА Документ.СделкаСВалютой) КАК ЗадолженностиПоДенежнымСредствамОстатки
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧАПоВидамЗадолженности.СрезПоследних(
	|						&КонецПериода,
	|						Организация = &Организация
	|							И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних
	|				ПО ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних.ВидЗадолженности
	|					И (ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
	|		ГДЕ
	|			(НЕ ЕСТЬNULL(НастройкиФормированияСЧАПоВидамЗадолженностиСрезПоследних.ЗадолженностьУчитываетсяВСЧАСДатыПолученияДокумента, ЛОЖЬ)
	|					ИЛИ ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаПолученияДокумента, &КонецПериода) <= &КонецПериода
	|						И ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаПолученияДокумента, &КонецПериода) <> ДАТАВРЕМЯ(1, 1, 1))
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
