КонецПроцедуры

// Добавляет во временных таблицах с фиксированными именами поле УровеньОценки и заполняет его по правилам
// 	Запрос 								- Запрос
//	ВариантРасчетаОценочнойСтоимости 	- вариант расчета оценочной стоимости
//	Отказ								- Отказ, Булево
Процедура УстановитьУровниОценкиВоВременныхТаблицах(Запрос, ВариантРасчетаОценочнойСтоимости, Отказ)
	
	// Обрабатывать нужно только определенные таблицы
	МассивВТДляОбработки = Новый Массив;
	МассивВТДляОбработки.Добавить("_ДенежныеСредства");
	МассивВТДляОбработки.Добавить("_СтоимостиКредитныхИнструментов");
	МассивВТДляОбработки.Добавить("_СтоимостиМНО");
	МассивВТДляОбработки.Добавить("_СделкиСОтложеннымИсполнением");
	МассивВТДляОбработки.Добавить("_СделкиРЕПО");
	МассивВТДляОбработки.Добавить("_Задолженность_Вся");
	МассивВТДляОбработки.Добавить("_РасчетныеЗадолженностиРПИ");
	МассивВТДляОбработки.Добавить("_ЗадолженностиПоСделкамСРаздельнымИсполнением");
	МассивВТДляОбработки.Добавить("_РезервыПИФ");
	МассивВТДляОбработки.Добавить("_СделкиСВалютой");
	МассивВТДляОбработки.Добавить("_ПроцентыПоСделкамФЕО");
	МассивВТДляОбработки.Добавить("_ЗадолженностиПоВзносамВУставныйКапиталОстатки");
	МассивВТДляОбработки.Добавить("_СтоимостиОбъектовНедвижимости");
	МассивВТДляОбработки.Добавить("_СтоимостиПросроченнойДебиторки");
	
	// Массив таблиц, в которых нужно установить Уровень 1, без вариантов
	МассивВТ_Уровень1 = Новый Массив;
	МассивВТ_Уровень1.Добавить("_ДенежныеСредства");
	МассивВТ_Уровень1.Добавить("_СтоимостиМНО");
	МассивВТ_Уровень1.Добавить("_СделкиСВалютой");
	МассивВТ_Уровень1.Добавить("_ПроцентыПоСделкамФЕО");
	МассивВТ_Уровень1.Добавить("_ЗадолженностиПоВзносамВУставныйКапиталОстатки");
	
	// Массив таблиц, в которых нужно установить Уровень 3, без вариантов
	МассивВТ_Уровень3 = Новый Массив;
	МассивВТ_Уровень3.Добавить("_РезервыПИФ");
	МассивВТ_Уровень3.Добавить("_ЗадолженностиПоСделкамСРаздельнымИсполнением");
	МассивВТ_Уровень3.Добавить("_СтоимостиОбъектовНедвижимости");
	МассивВТ_Уровень3.Добавить("_СтоимостиПросроченнойДебиторки");
	МассивВТ_Уровень3.Добавить("_РасчетныеЗадолженностиРПИ");
	
	Для Каждого ИмяТаблицы Из МассивВТДляОбработки Цикл
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы) = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе отсутствует временная таблица " + ИмяТаблицы,,,, Отказ);
			Возврат;
		КонецЕсли;
			
		// Переносим данные из исходной таблицы в служебную, исходную удаляем
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ПОМЕСТИТЬ _ИмяТаблицы_Служебная
			|ИЗ
			|	_ИмяТаблицы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ИмяТаблицы";
		
		// Заменяем имя таблицы, а для таблиц с однозначным уровнем устанавливаем его
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяТаблицы", ИмяТаблицы);
		
		УровеньУстановлен = Ложь;
		Если МассивВТ_Уровень1.Найти(ИмяТаблицы) <> Неопределено Тогда
			
			// Уровень 1
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "*", "*, 1 КАК УровеньОценки");			
			УровеньУстановлен = Истина;
			
		ИначеЕсли МассивВТ_Уровень3.Найти(ИмяТаблицы) <> Неопределено Тогда
			
			// Уровень 3
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "*", "*, 3 КАК УровеньОценки");
			УровеньУстановлен = Истина;
			
		КонецЕсли;	
		
		Запрос.Выполнить();
						
		Если УровеньУстановлен Тогда
			
			// Возвращаем обработанную таблицу обратно, служебную удаляем
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	*
				|ПОМЕСТИТЬ _ИмяТаблицы
				|ИЗ
				|	_ИмяТаблицы_Служебная
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ИмяТаблицы_Служебная";	  		
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяТаблицы", ИмяТаблицы);
			
			Запрос.Выполнить();	
			
		Иначе
			// Обрабатываем вариативность	
			РассчитатьУровеньОценки(Запрос, ИмяТаблицы, ВариантРасчетаОценочнойСтоимости, Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;		
				
	КонецЦикла;                                   	
	
КонецПроцедуры

// Рассчитывает уровень оценки для временной таблицы по условиям
// 	Запрос 								- Запрос
//	ИмяТаблицы							- имя обрабатываемой временной таблицы
//	ВариантРасчетаОценочнойСтоимости 	- вариант расчета оценочной стоимости
//	Отказ								- Отказ, Булево
Процедура РассчитатьУровеньОценки(Запрос, ИмяТаблицы, ВариантРасчетаОценочнойСтоимости, Отказ)
	
	// В МВТ запроса таблица имеет имя ИмяТаблицы + "_Служебная"
	
	Если ИмяТаблицы = "_СтоимостиКредитныхИнструментов" Тогда
		
		// если ЕстьОбесценение = Истина, то Уровень 3, 
		// если кредитный инструмент - займ выданный, то Уровень 3
		// иначе Уровень 2 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*,
			|	ВЫБОР
			|		КОГДА _ИмяТаблицы.ЕстьОбесценение
			|			ТОГДА 3
			|		КОГДА ТИПЗНАЧЕНИЯ(_ИмяТаблицы.КредитныйИнструмент) = ТИП(Справочник.Займы)
			|				И ВЫРАЗИТЬ(_ИмяТаблицы.КредитныйИнструмент КАК Справочник.Займы).ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Выданный)
			|			ТОГДА 3
			|		ИНАЧЕ ВЫБОР
			|				КОГДА &КонецПериода >= ДАТАВРЕМЯ(2022, 6, 30)
			|					ТОГДА 3
			|				ИНАЧЕ 2
			|			КОНЕЦ
			|	КОНЕЦ КАК УровеньОценки
			|ИЗ
			|	_ИмяТаблицы КАК _ИмяТаблицы";
		
	ИначеЕсли ИмяТаблицы = "_СделкиСОтложеннымИсполнением" Тогда
		
		// для внебиржевых сделок Уровень 3;
		// для биржевых сделок уровень оценки равен уровню из поля УроверьОценкиЦБ
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*,
			|	ВЫБОР
			|		КОГДА _ИмяТаблицы.Основание.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
			|			ТОГДА 3
			|		ИНАЧЕ _ИмяТаблицы.УровеньОценкиЦБ
			|	КОНЕЦ КАК УровеньОценки
			|ИЗ
			|	_ИмяТаблицы КАК _ИмяТаблицы";
			
	ИначеЕсли ИмяТаблицы = "_СделкиРЕПО" Тогда
		
		// если сделка РЕПО с ЦК, то Уровень 1;
		// если внебиржевая или РЕПО не с ЦК, то 
		//		для методики РасчетСЧА_ЗПИФ_УКПИ Уровень 2 (т. к. оцениваются как займы),
		// 		иначе Уровень 3
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*,
			|	ВЫБОР
			|		КОГДА _ИмяТаблицы.Основание.СделкаСЦентральнымКонтрагентом
			|			ТОГДА 1
			|		КОГДА &РЕПОКакЗаймы			
			|			ТОГДА 2
			|		ИНАЧЕ 3
			|	КОНЕЦ КАК УровеньОценки
			|ИЗ
			|	_ИмяТаблицы КАК _ИмяТаблицы";		
		
		Запрос.УстановитьПараметр("РЕПОКакЗаймы", ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РасчетСЧА_ЗПИФ_УКПИ);
		
	ИначеЕсли ИмяТаблицы = "_Задолженность_Вся" Тогда
		
		// средства у брокера - Уровень 1;
		// кредиторская задолженность - Уровень 3;
		// кредиторская задолженность по инвесткотракту - уровень 3 
		// дебиторская задолженность с видом задолженности "По прочим доходам" или "По прочим доходам и расходам" - Уровень 3
		// дебиторская задолженность по погашению займа выданного - Уровень 3
		// дебиторская задолженность по инвестконтрактам, ДДУ, аренде - уровень 3
		// дебиторская задолженность по доходам по ценным бумагам - Уровень 1. При наличии кредитных рисков должен быть уровень 3, пока не реализовано
		// дебиторская задолженность налогам - Уровень 3
		// дебиторская задолженность по ПоНачислениюРаспределяемойПрибылиООО, РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям,
		//		ПоВознаграждениюУправляющего, РасходыНаКоммунальныеУслуги, РасходыПоСодержаниюНедвижимости, 
		//		ПоВкладуВУставныйКапиталООО, РасходыПоУслугамСпецДепозитария	- Уровень 3
		// дебиторская задолженность остальная - Уровень 1
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ВсеПоля КАК ВсеПоля,
			|	ВЫБОР
			|		КОГДА _ИмяТаблицы.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|			ТОГДА ВЫБОР
			|					КОГДА _ИмяТаблицы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоИнвестконтракту)
			|							И &КонецПериодаНачалоДня < ДАТАВРЕМЯ(2023, 9, 29)
			|						ТОГДА 2
			|					ИНАЧЕ 3
			|				КОНЕЦ
			|		КОГДА _ИмяТаблицы.ВидЗадолженности В (&ВидыЗадолженностиУровня3)
			|			ТОГДА 3
			|		КОГДА _ИмяТаблицы.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗайму), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗаймуПроценты))
			|				И ТИПЗНАЧЕНИЯ(_ИмяТаблицы.ОснованиеЗадолженности) = ТИП(Документ.ЗакрытиеКредитногоИнструмента)
			|				И ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(_ИмяТаблицы.ОснованиеЗадолженности КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент) = ТИП(Справочник.Займы)
			|				И ВЫРАЗИТЬ(ВЫРАЗИТЬ(_ИмяТаблицы.ОснованиеЗадолженности КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент КАК Справочник.Займы).ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Выданный)
			|			ТОГДА 3
			|		КОГДА _ИмяТаблицы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоЗаймуПроценты)
			|				И ТИПЗНАЧЕНИЯ(_ИмяТаблицы.ОснованиеЗадолженности) = ТИП(Документ.ПриходПроцентовПоКредитномуИнструменту)
			|				И ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(_ИмяТаблицы.ОснованиеЗадолженности КАК Документ.ПриходПроцентовПоКредитномуИнструменту).КредитныйИнструмент) = ТИП(Справочник.Займы)
			|				И ВЫРАЗИТЬ(ВЫРАЗИТЬ(_ИмяТаблицы.ОснованиеЗадолженности КАК Документ.ПриходПроцентовПоКредитномуИнструменту).КредитныйИнструмент КАК Справочник.Займы).ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Выданный)
			|			ТОГДА 3
			|		КОГДА _ИмяТаблицы.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И _ИмяТаблицы.ВидЗадолженности В (&ВидыЗадолженностиДоходПоБумагам1Уровень)
			|			ТОГДА 1
			|		КОГДА _ИмяТаблицы.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И _ИмяТаблицы.ВидЗадолженности В (&ВидыЗадолженностиДебиторкаУровня3)
			|			ТОГДА 3
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК УровеньОценки
			|ИЗ
			|	_ИмяТаблицы КАК _ИмяТаблицы"; 					
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВсеПоля КАК ВсеПоля", "*");
		
		ВидыЗадолженностиУровня3 = Новый Массив;
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоПрочимДоходам);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоПрочимДоходамИРасходам);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоДДУ);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоИнвестконтракту);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоСделкеСНедвижимостью);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоАренде);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть);
		ВидыЗадолженностиУровня3.Добавить(Справочники.ВидыЗадолженности.ПоРекламе);
		
		ВидыЗадолженностиДоходПоБумагам1Уровень = Новый Массив;
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюВекселя);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюИпотечногоСертификатаУчастия);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюПая);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
		ВидыЗадолженностиДоходПоБумагам1Уровень.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
		
		ВидыЗадолженностиДебиторкаУровня3 = Новый Массив;
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюРаспределяемойПрибылиООО);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.ПоВкладуВУставныйКапиталООО);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.НДСПоАвансам);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.НДСПоПриобретеннымЦенностям);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.НДСТекущегоПериода);
		ВидыЗадолженностиДебиторкаУровня3.Добавить(Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость);
		
		Запрос.Параметры.Вставить("ВидыЗадолженностиУровня3", ВидыЗадолженностиУровня3);
		Запрос.Параметры.Вставить("ВидыЗадолженностиДоходПоБумагам1Уровень", ВидыЗадолженностиДоходПоБумагам1Уровень);
		Запрос.Параметры.Вставить("ВидыЗадолженностиДебиторкаУровня3", ВидыЗадолженностиДебиторкаУровня3);
		
	Иначе	
		// Неизвестная таблица
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не произведен расчет уровня оценки в таблице " + ИмяТаблицы,,,, Отказ);
	    Возврат;
	КонецЕсли;
	
	// Дополняем запрос
	Запрос.Текст = Запрос.Текст + ";" + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмяТаблицы";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяТаблицы", ИмяТаблицы + "_Служебная");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК УровеньОценки", 
		"КАК УровеньОценки
		| ПОМЕСТИТЬ " + ИмяТаблицы);
		
	Запрос.Выполнить();
		
КонецПроцедуры 

Процедура СформироватьЗапросРасчетСЧА_НПФ2018(Запрос, Параметры, Отказ)
	
	СтоимостиДепозитныхВкладов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
		Параметры.СчетДоверительногоУправления,
		КонецДня(Параметры.Период),
		Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
		Параметры.УчитыватьПлановыеОперации,
		Истина,,
		Отказ);
		
	Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз
		ИЛИ (Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Федерация И Параметры.Период < '20200514')
	Тогда
		ВидУчета = Неопределено;		
		ОпределитьПериодичностьПереоценкиМНО = Истина;
	ИначеЕсли Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СбербанкСтрахование Тогда
		ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;		
		ОпределитьПериодичностьПереоценкиМНО = Истина;
	Иначе
		ВидУчета = Неопределено;		
		ОпределитьПериодичностьПереоценкиМНО = Ложь;
	КонецЕсли;
	
	СтоимостиМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
		Параметры.СчетДоверительногоУправления, 
		ВидУчета, 
		ОпределитьПериодичностьПереоценкиМНО,
		КонецДня(Параметры.Период),
		Параметры.ЦельРасчета,
		Отказ);

	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСОтложеннымИсполнением(
		Параметры.ВариантРасчетаОценочнойСтоимости,
		Параметры.Организация,
		Параметры.СчетДоверительногоУправления, 
		Параметры.Период,
		Параметры.ТаблицаСтоимостей,
		Отказ,
		Запрос.МенеджерВременныхТаблиц,
		Параметры);
		
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамРЕПО(
