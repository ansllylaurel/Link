		|	ДефолтыПоОблигациям.Облигация КАК Облигация,
		|	ДефолтыПоОблигациям.ТипДефолта КАК ТипДефолта,
		|	ДефолтыПоОблигациям.СтатусДефолта КАК СтатусДефолта
		|ПОМЕСТИТЬ _ТаблицаИсключенийДляДефолта
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям КАК ДефолтыПоОблигациям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИсключенияДляДефолта_ИзТаблицы КАК _ИсключенияДляДефолта_ИзТаблицы
		|		ПО ДефолтыПоОблигациям.Облигация = _ИсключенияДляДефолта_ИзТаблицы.Облигация
		|			И ДефолтыПоОблигациям.ТипДефолта = _ИсключенияДляДефолта_ИзТаблицы.ТипДефолта
		|			И ДефолтыПоОблигациям.СтатусДефолта = _ИсключенияДляДефолта_ИзТаблицы.СтатусДефолта
		|			И ДефолтыПоОблигациям.Период >= _ИсключенияДляДефолта_ИзТаблицы.Период
		|			И (ВЫБОР
		|				КОГДА _ИсключенияДляДефолта_ИзТаблицы.СрокДействия <> ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ДефолтыПоОблигациям.Период <= _ИсключенияДляДефолта_ИзТаблицы.СрокДействия
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)";
		
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьТаблицуПроцентовОбесценения(ВариантРасчетаОценочнойСтоимости)

	ТаблицаПроцентовОбесценения = Новый ТаблицаЗначений;
	ТаблицаПроцентовОбесценения.Колонки.Добавить("СрокПросрочкиОт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3)));
	ТаблицаПроцентовОбесценения.Колонки.Добавить("СрокПросрочкиДо", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3)));
	ТаблицаПроцентовОбесценения.Колонки.Добавить("ПроцентОбесценения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3)));
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ОПК2018 Тогда
	
		НоваяСтрока = ТаблицаПроцентовОбесценения.Добавить();
		НоваяСтрока.СрокПросрочкиОт = 0;
		НоваяСтрока.СрокПросрочкиДо = 90;
		НоваяСтрока.ПроцентОбесценения = 0;
		
		НоваяСтрока = ТаблицаПроцентовОбесценения.Добавить();
		НоваяСтрока.СрокПросрочкиОт = 91;
		НоваяСтрока.СрокПросрочкиДо = 180;
		НоваяСтрока.ПроцентОбесценения = 25;
		
		// в договоре два интервала: от 181 дня до года и более года
		// здесь в сроках указываем 365, обработаем в запросе
		НоваяСтрока = ТаблицаПроцентовОбесценения.Добавить();
		НоваяСтрока.СрокПросрочкиОт = 181;
		НоваяСтрока.СрокПросрочкиДо = 365;
		НоваяСтрока.ПроцентОбесценения = 50;
		
		НоваяСтрока = ТаблицаПроцентовОбесценения.Добавить();
		НоваяСтрока.СрокПросрочкиОт = 365;
		НоваяСтрока.СрокПросрочкиДо = 0;
		НоваяСтрока.ПроцентОбесценения = 100;
	
	КонецЕсли; 
	
	Возврат ТаблицаПроцентовОбесценения;
	
КонецФункции

Функция МодифицироватьТекстЗапросаДляПолученияИтогов(ТекстЦБ) Экспорт
	
	// Дополним текст новым запросом для получения итоговых сумм по ЦБ
	
	ТекстЦБ = ТекстЦБ + ";
	|////////////////////////////////////////////////////////////////////////////////	
	|" + 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЕСТЬNULL(_ТаблицаЦБ.ИтогоРынок, 0)) КАК СуммаРынок,
	|	СУММА(ЕСТЬNULL(_ТаблицаЦБ.Сумма, 0)) КАК СуммаРынокБезКупона,
	|	СУММА(ЕСТЬNULL(_ТаблицаЦБ.Купон, 0)) КАК КупонРынок
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Разделы.СуммаРынокВВалютеУчета, 0) КАК СуммаРынокВВалютеУчета,
	|	ВЫБОР
	|		КОГДА Разделы.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(Разделы.СуммаРынокВВалютеУчета, 0)
	|	КОНЕЦ КАК РСА,
	|	Разделы.НомерСтроки КАК НомерСтроки,
	|	Разделы.ВалютаСтроки КАК ВалютаСтроки
	|ПОМЕСТИТЬ _ТЗ_Разделы
	|ИЗ
	|	&Разделы КАК Разделы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(_ТЗ_Разделы.СуммаРынокВВалютеУчета) КАК СуммаРынок,
	|	СУММА(_ТЗ_Разделы.РСА) КАК РСА
	|ИЗ
	|	_ТЗ_Разделы КАК _ТЗ_Разделы"; 
	
	Возврат ТекстЦБ;
	
КонецФункции		

Функция ПолучитьЗначенияИтоговыхРеквизитов(ТаблицаЦБ = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СЧАРынок",										0);
	Результат.Вставить("РСА",											0);
	Результат.Вставить("КоличествоПаев",								0);
	Результат.Вставить("СтоимостьПая",									0);
	Результат.Вставить("ЦБСумма",										0);
	Результат.Вставить("ЦБКупон",										0);
	Результат.Вставить("ЦБИтогоРынок",									0);
	Результат.Вставить("АктивыНеОтносящиесяКЦБСуммаРынокВВалютеУчета",	0);
	
	Если НЕ ЗначениеЗаполнено(СчетДоверительногоУправления)
		ИЛИ НЕ ЗначениеЗаполнено(ЦельРасчетаСтоимостиОценки)
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = МодифицироватьТекстЗапросаДляПолученияИтогов(Документы.РегистрацияСтоимостиАктивов.ПолучитьТекстЗапросаДляСпискаЦБ(ТаблицаЦБ));
	
	Запрос.УстановитьПараметр("Разделы", 		 			  АктивыНеОтносящиесяКЦеннымБумагам.Выгрузить());
	Запрос.УстановитьПараметр("ВалютаДокумента", 			  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("Период",         			  НачалоДня(Дата));
	Запрос.УстановитьПараметр("Организация", 				  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета", 				  ЦельРасчетаСтоимостиОценки);
	Запрос.УстановитьПараметр("ВидУчета",					  РаботаСПереоценкой.ОпределитьВидУчета(Организация, СчетДоверительногоУправления, ЦельРасчетаСтоимостиОценки, Дата));
	Запрос.УстановитьПараметр("ДатаПереоценки", 			  НачалоДня(Дата));
	Запрос.УстановитьПараметр("ТаблицаЦБ", 			  		  ТаблицаЦБ);
	
	ПакетРезультата = Запрос.ВыполнитьПакет();
	
	ВГраница = ПакетРезультата.ВГраница();
	Выборка = ПакетРезультата[ВГраница].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СуммаРынок) Тогда
			Результат.СЧАРынок										= Выборка.СуммаРынок;
			Результат.АктивыНеОтносящиесяКЦБСуммаРынокВВалютеУчета	= Выборка.СуммаРынок;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.РСА) Тогда
			Результат.РСА = Выборка.РСА;
		КонецЕсли;
		
	КонецЕсли;  	
	
	Выборка = ПакетРезультата[ВГраница-2].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СуммаРынок) Тогда
			Результат.СЧАРынок		= Результат.СЧАРынок + Выборка.СуммаРынок;
			Результат.РСА			= Результат.РСА + Выборка.СуммаРынок;
			Результат.ЦБСумма		= Выборка.СуммаРынокБезКупона;
			Результат.ЦБКупон		= Выборка.КупонРынок;
			Результат.ЦБИтогоРынок	= Выборка.СуммаРынок;
		КонецЕсли;
		
	КонецЕсли;
			
	ВидДоговораДУ			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	НеобходимаСтоимостьПая	= (ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	
	Если НеобходимаСтоимостьПая Тогда
		Результат.КоличествоПаев = ПолучитьКоличествоПаев(СчетДоверительногоУправления, НачалоДня(Дата));
		Результат.СтоимостьПая = ?(Результат.КоличествоПаев = 0, 0, ?(Результат.СЧАРынок < 0, 0, Окр(Результат.СЧАРынок / Результат.КоличествоПаев, 2, 1)));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура РассчитатьИУстановитьЗначенияИтоговыхРеквизитов(ТаблицаЦБ = Неопределено) Экспорт
	
	ЗначенияИтоговыхРеквизитов = ПолучитьЗначенияИтоговыхРеквизитов(ТаблицаЦБ);
	
	Если ЗначенияИтоговыхРеквизитов <> Неопределено Тогда
		СЧАРынок		= ЗначенияИтоговыхРеквизитов.СЧАРынок;
		РСА				= ЗначенияИтоговыхРеквизитов.РСА;
		СтоимостьПая	= ЗначенияИтоговыхРеквизитов.СтоимостьПая;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверкаКлючевыхДатПИФПройдена(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияДополнительныхСведений.Значение КАК ДатаОкончанияФормированияПИФ
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаРасчета, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ПО (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
	|			И ЗначенияДополнительныхСведений.Объект = КлиентыДоверительногоУправленияСрезПоследних.Клиент";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаРасчета", 				  Параметры.Период);

	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = "";
	Если Выборка.Следующий() Тогда
		ДатаОкончанияФормированияПИФ = Выборка.ДатаОкончанияФормированияПИФ;
		// Проверяем эту дату
		Если Не ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) Тогда
			ТекстСообщения = "Для " + СокрЛП(Параметры.СчетДоверительногоУправления) + " не указана дата окончания формирования ПИФ. Заполнение документа прервано.";
		ИначеЕсли ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) И (Параметры.Период < ДатаОкончанияФормированияПИФ) Тогда
			ТекстСообщения = "У " + СокрЛП(Параметры.СчетДоверительногоУправления) + " дата окончания формирования ПИФ (" + Формат(ДатаОкончанияФормированияПИФ, "ДФ=dd.MM.yyyy") + ") позже даты расчета. Формирование СЧА до этой даты не требуется. Заполнение документа прервано.";
		КонецЕсли;
	Иначе
		ТекстСообщения = "Для " + СокрЛП(Параметры.СчетДоверительногоУправления) + " не указана дата окончания формирования ПИФ. Заполнение документа прервано.";
	КонецЕсли;	

	Если ТекстСообщения <> "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Параметры.СчетДоверительногоУправления);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, Префикс)

	МассивПодчиненных = ПолучитьСообщенияПользователю(Истина);
	Для каждого Сообщение Из МассивПодчиненных Цикл
		
		Сообщение.КлючДанных = ЭтотОбъект.Ссылка;
		Если ЗначениеЗаполнено(Сообщение.Поле) Тогда
			Сообщение.Поле = Префикс + Сообщение.Поле;
		КонецЕсли; 
		МассивСообщенийПользователю.Добавить(Сообщение);
	
	КонецЦикла; 

КонецПроцедуры 

Процедура ПоместитьКредиторскуюЗадолженностьПоБрокерскойКомиссииВМенеджерВременныхТаблиц(Запрос)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КЗПоБрокерскойКомиссии") = Неопределено Тогда

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Сделка
			|ПОМЕСТИТЬ _ОткрытыеСделки
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|ГДЕ
			|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
			|ГДЕ
			|	ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаОстаток + ЗадолженностиПоВторойЧастиРЕПООстатки.СуммаКупонаОстаток <> 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
			|				И ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.СделкаСВалютой)) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|ГДЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	СУММА(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток) КАК СуммаОстаток,
			|	СУММА(ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток) КАК СуммаКупонаОстаток
			|ПОМЕСТИТЬ _КЗПоБрокерскойКомиссии
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|				И НЕ Аванс
			|				И НЕ Основание В
			|						(ВЫБРАТЬ
			|							_ОткрытыеСделки.Сделка
			|						ИЗ
			|							_ОткрытыеСделки)
			|				И &ОтражатьНачисленнуюНеоплаченнуюКомиссиюВКредиторскойЗадолженности = ЛОЖЬ
			|				И ВЫБОР
			|					КОГДА ТИПЗНАЧЕНИЯ(Основание) = ТИП(Документ.СделкаРЕПО)
			|						ТОГДА &ОтражатьНачисленнуюНеоплаченнуюКомиссиюПоСделкамРЕПОВКредиторскойЗадолженности = ЛОЖЬ
			|					ИНАЧЕ ИСТИНА
			|				КОНЕЦ) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОткрытыеСделки";

		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПоместитьОстаткиДенежныхСредствВПутиВМенедждерВременныхТаблиц(Запрос)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДенежныеСредстваВПути") = Неопределено Тогда
        			
		Если НачалоДня(ЭтотОбъект.Дата) >= '20210921' И НачалоДня(ЭтотОбъект.Дата) < '20230214' Тогда 
			
			// Для денежных средств в пути необходимо определять контрагента (может быть банк или брокер), к которому эти средства должны прийти.
			// В регистре остатков ДС этой информации нет, собираем ее по документам переводов.
			// Также учтена ситуация, когда остаток по денежным средствам в пути сформирован не переводом, в этом случае контрагент не определяется
		    		
			Запрос.УстановитьПараметр("ДатаНачалаРасчета", '20210921');
		
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути) КАК КлючМестаХранения,
				|	ВложенныйЗапрос.Валюта КАК Валюта,
				|	ВложенныйЗапрос.Контрагент КАК Контрагент,
				|	_КурсыВалют.Курс КАК Курс,
				|	ВложенныйЗапрос.СуммаОстаток КАК СуммаВВалюте,
				|	ВЫРАЗИТЬ(ВложенныйЗапрос.СуммаОстаток * _КурсыВалют.Курс КАК ЧИСЛО(15, 2)) КАК СуммаВВалютеУчета
				|ПОМЕСТИТЬ _ДенежныеСредстваВПути
				|ИЗ
				|	(ВЫБРАТЬ
				|		ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор) = ТИП(Документ.ПереводДенежныхСредств)
				|				ТОГДА ВЫБОР
				|						КОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.)
				|							ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).РасчетныйСчетПолучатель.Банк.ЮрФизЛицо
				|						ИНАЧЕ ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).БрокерПолучатель.ЮрФизЛицо
				|					КОНЕЦ
				|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
				|		КОНЕЦ КАК Контрагент,
				|		ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
				|		СУММА(ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПриход - ОстаткиДенежныхСредствОстаткиИОбороты.СуммаРасход) КАК СуммаОстаток
				|	ИЗ
				|		РегистрНакопления.ОстаткиДенежныхСредств.Обороты(
				|				&ДатаНачалаРасчета,
				|				&КонецПериода,
				|				Регистратор,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|					И РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
				|	
				|	СГРУППИРОВАТЬ ПО
				|		ОстаткиДенежныхСредствОстаткиИОбороты.Валюта,
				|		ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор) = ТИП(Документ.ПереводДенежныхСредств)
				|				ТОГДА ВЫБОР
				|						КОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.)
				|							ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).РасчетныйСчетПолучатель.Банк.ЮрФизЛицо
				|						ИНАЧЕ ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).БрокерПолучатель.ЮрФизЛицо
				|					КОНЕЦ
				|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
				|		КОНЕЦ) КАК ВложенныйЗапрос
				|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
				|		ПО ВложенныйЗапрос.Валюта = _КурсыВалют.Валюта
				|ГДЕ
				|	ВложенныйЗапрос.СуммаОстаток <> 0";
			
		ИначеЕсли НачалоДня(ЭтотОбъект.Дата) >= '20260514' Тогда 
			
			// Требуется банк-отправитель для определения его рейтинга при расчете резервов
					
			Запрос.УстановитьПараметр("ДатаНачалаРасчета", '20260514');
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути) КАК КлючМестаХранения,
				|	ВложенныйЗапрос.Валюта КАК Валюта,
				|	ВложенныйЗапрос.Контрагент КАК Контрагент,
				|	_КурсыВалют.Курс КАК Курс,
				|	ВложенныйЗапрос.СуммаОстаток КАК СуммаВВалюте,
				|	ВЫРАЗИТЬ(ВложенныйЗапрос.СуммаОстаток * _КурсыВалют.Курс КАК ЧИСЛО(15, 2)) КАК СуммаВВалютеУчета
				|ПОМЕСТИТЬ _ДенежныеСредстваВПути
				|ИЗ
				|	(ВЫБРАТЬ
				|		ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор) = ТИП(Документ.ПереводДенежныхСредств)
				|				ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).Основание.РасчетныйСчет.Банк.ЮрФизЛицо
				|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
				|		КОНЕЦ КАК Контрагент,
				|		ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
				|		СУММА(ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПриход - ОстаткиДенежныхСредствОстаткиИОбороты.СуммаРасход) КАК СуммаОстаток
				|	ИЗ
				|		РегистрНакопления.ОстаткиДенежныхСредств.Обороты(
				|				&ДатаНачалаРасчета,
				|				&КонецПериода,
				|				Регистратор,
				|				Организация = &Организация
				|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|					И РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
				|	
				|	СГРУППИРОВАТЬ ПО
				|		ОстаткиДенежныхСредствОстаткиИОбороты.Валюта,
				|		ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор) = ТИП(Документ.ПереводДенежныхСредств)
				|				ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Документ.ПереводДенежныхСредств).Основание.РасчетныйСчет.Банк.ЮрФизЛицо
				|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
				|		КОНЕЦ) КАК ВложенныйЗапрос
				|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
				|		ПО ВложенныйЗапрос.Валюта = _КурсыВалют.Валюта
				|ГДЕ
				|	ВложенныйЗапрос.СуммаОстаток <> 0";
			
		Иначе
				
			// Берем данные из готовой таблицы остатков ДС
			
			Запрос.Текст = 
		        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		        |	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути) КАК КлючМестаХранения,
		        |	ВложенныйЗапрос.Валюта КАК Валюта,
		        |	NULL КАК Контрагент,
		        |	_КурсыВалют.Курс КАК Курс,
		        |	ВложенныйЗапрос.СуммаОстаток КАК СуммаВВалюте,
		        |	ВЫРАЗИТЬ(ВложенныйЗапрос.СуммаОстаток * _КурсыВалют.Курс КАК ЧИСЛО(15, 2)) КАК СуммаВВалютеУчета
		        |ПОМЕСТИТЬ _ДенежныеСредстваВПути
		        |ИЗ
		        |	(ВЫБРАТЬ
		        |		ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		        |		СУММА(ОстаткиДенежныхСредствОстатки.СуммаОстаток) КАК СуммаОстаток
		        |	ИЗ
		        |		_ОстаткиДенежныхСредствОстатки КАК ОстаткиДенежныхСредствОстатки
		        |	ГДЕ
		        |		ОстаткиДенежныхСредствОстатки.РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
		        |	
		        |	СГРУППИРОВАТЬ ПО
		        |		ОстаткиДенежныхСредствОстатки.Валюта) КАК ВложенныйЗапрос
		        |		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		        |		ПО ВложенныйЗапрос.Валюта = _КурсыВалют.Валюта";

		КонецЕсли;
			
		Запрос.Выполнить();
		
	КонецЕсли;  	
	
КонецПроцедуры

Процедура ЗарегистрироватьФинансовыеПоказателиДоходности(Отказ)
	
	Если Документы.РегистрацияСтоимостиАктивов.ТребуетсяРегистрацияФинансовыхПоказателейДоходности(ЭтотОбъект.Организация, ЭтотОбъект.Дата) Тогда
		Движения.ФинансовыеПоказатели.ДополнительныеСвойства.Вставить("ЗапускатьПроверки", Ложь);
		// #ТехДолг: Свойство "ЗапускатьПроверки" добавлено для исключения двойного запуска проверок при записи в регистр. Необходимо убрать двойную запись и доп. свойство
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроведениеРегламентныхОпераций") Тогда
			Движения.ФинансовыеПоказатели.ДополнительныеСвойства.Вставить("ПроведениеРегламентныхОпераций");
		КонецЕсли; 
		Движения.ФинансовыеПоказатели.Записать();
		Движения.ФинансовыеПоказатели.ДополнительныеСвойства.Вставить("ЗапускатьПроверки", Истина);
		Движения.ФинансовыеПоказатели.Записывать = Истина;
		
		РассчитатьФинансовыеПоказателиДоходности(Движения.ФинансовыеПоказатели, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

//возвращает таблицу с кредиторкой по брокерской комиссии с начислениями в колокне оснований
Функция ПолучитьЗадолженностиПоБрокерскойКомиссииПоНачислениям(Параметры, Запрос, Отказ)
	
	ТаблицаБрокерскойКомиссии = Новый ТаблицаЗначений;
	ТаблицаБрокерскойКомиссии.Колонки.Добавить("Основание",				Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.Основание.Тип);
	ТаблицаБрокерскойКомиссии.Колонки.Добавить("ОснованиеНачисление",	Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.Основание.Тип);
	ТаблицаБрокерскойКомиссии.Колонки.Добавить("Сумма",					Новый ОписаниеТипов("Число"));
	
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	
	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		И НачалоДня(Параметры.Период) >= Дата(2024,1,1) Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
			|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток
			|ПОМЕСТИТЬ _КомиссияБрокераНаЗамену
			|ИЗ
			|	_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
			|ГДЕ
			|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КомиссияБрокераНаЗамену.Основание КАК Основание,
			|	_КомиссияБрокераНаЗамену.СуммаОстаток КАК СуммаОстаток,
			|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
			|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
			|	ЗадолженностиПоДенежнымСредствам.Регистратор.МоментВремени КАК РегистраторМоментВремени
			|ИЗ
			|	_КомиссияБрокераНаЗамену КАК _КомиссияБрокераНаЗамену
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО _КомиссияБрокераНаЗамену.ВидЗадолженности = ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
			|			И _КомиссияБрокераНаЗамену.ТипЗадолженности = ЗадолженностиПоДенежнымСредствам.ТипЗадолженности
			|			И _КомиссияБрокераНаЗамену.Основание = ЗадолженностиПоДенежнымСредствам.Основание
			|			И (ЗадолженностиПоДенежнымСредствам.Организация = &Организация
			|				И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Основание,
			|	РегистраторМоментВремени УБЫВ
			|ИТОГИ
			|	МИНИМУМ(СуммаОстаток)
			|ПО
			|	Основание";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			СуммаКомиссииПоСделке = Выборка.СуммаОстаток;
			
			ВыборкаДетальныеЗаписи = Выборка.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтрокаКомисии = ТаблицаБрокерскойКомиссии.Добавить();
				СтрокаКомисии.Основание = ВыборкаДетальныеЗаписи.Основание;
				СтрокаКомисии.ОснованиеНачисление = ВыборкаДетальныеЗаписи.Регистратор;
				СтрокаКомисии.Сумма = Мин(СуммаКомиссииПоСделке, ВыборкаДетальныеЗаписи.Сумма);
				
				СуммаКомиссииПоСделке = СуммаКомиссииПоСделке - СтрокаКомисии.Сумма;
				
				Если СуммаКомиссииПоСделке = 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаБрокерскойКомиссии;
	
КонецФункции

Процедура ПоместитьЗачетАвансовПоПредварительнымЗадолженностямВМенеджерВременныхТаблиц(Запрос)
	
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности = Новый ТаблицаЗначений;
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("ТипЗадолженностиАванса",		Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.ТипЗадолженности.Тип);
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("ТипЗадолженностиНачисления",	Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.ТипЗадолженности.Тип);
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("ВидЗадолженности",			Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.ВидЗадолженности.Тип);
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("ОснованиеЗадолженности",		Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.Основание.Тип);
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("ОснованиеАванса",				Метаданные.РегистрыНакопления.ЗадолженностиПоДенежнымСредствам.Измерения.Основание.Тип);
	ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Колонки.Добавить("СуммаЗачета",					Новый ОписаниеТипов("Число"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеЗадолженности).Договор КАК Договор
		|ПОМЕСТИТЬ _ПредварительныеЗадолженности
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеЗадолженности).Предварительно
		|	И _ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСТекущегоПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	Оплата.Договор КАК Договор
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО _ЗадолженностиПоДенежнымСредствамОстатки.Основание = Оплата.Ссылка
		|ГДЕ
		|	ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Оплата).Аванс
		|	И НЕ ВЫРАЗИТЬ(_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.Оплата).ОбеспечительныйПлатеж
		|	И (_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности, _ЗадолженностиПоДенежнымСредствамОстатки.Контрагент) В
		|			(ВЫБРАТЬ
		|				_ПредварительныеЗадолженности.ВидЗадолженности,
		|				_ПредварительныеЗадолженности.Контрагент
		|			ИЗ
		|				_ПредварительныеЗадолженности)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПредварительныеЗадолженности.Основание КАК Основание,
		|	_ПредварительныеЗадолженности.ТипЗадолженности КАК ТипЗадолженности,
		|	_ПредварительныеЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
		|	_ПредварительныеЗадолженности.Валюта КАК Валюта,
		|	_ПредварительныеЗадолженности.Контрагент КАК Контрагент,
		|	_ПредварительныеЗадолженности.СуммаОстаток КАК СуммаОстаток,
		|	_ПредварительныеЗадолженности.Договор КАК Договор
		|ИЗ
		|	_ПредварительныеЗадолженности КАК _ПредварительныеЗадолженности";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ТаблицаАвансов = МассивРезультатов[1].Выгрузить();
	
	ВыборкаДетальныеЗаписи = МассивРезультатов[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокиАвансов = ТаблицаАвансов.НайтиСтроки(Новый Структура("Контрагент, ВидЗадолженности, Договор, ТипЗадолженности", 
			ВыборкаДетальныеЗаписи.Контрагент, 
			ВыборкаДетальныеЗаписи.ВидЗадолженности, 
			ВыборкаДетальныеЗаписи.Договор, 
			?(ВыборкаДетальныеЗаписи.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская, Перечисления.ТипыЗадолженности.Кредиторская, Перечисления.ТипыЗадолженности.Дебиторская)));
			
		СуммаЗадолженности = ВыборкаДетальныеЗаписи.СуммаОстаток;
		
		Для Каждого СтрокаАванса Из СтрокиАвансов Цикл
			
			Если СтрокаАванса.СуммаОстаток = 0 Тогда 
				Продолжить;
			КонецЕсли;
			
			СуммаЗачета = Мин(СтрокаАванса.СуммаОстаток, СуммаЗадолженности);
			
			СтрокаЗачета = ТаблицаЗачетаАвансовДляПредварительнойЗадолженности.Добавить();
			СтрокаЗачета.ТипЗадолженностиАванса = СтрокаАванса.ТипЗадолженности;
			СтрокаЗачета.ТипЗадолженностиНачисления = ВыборкаДетальныеЗаписи.ТипЗадолженности;
			СтрокаЗачета.ВидЗадолженности = ВыборкаДетальныеЗаписи.ВидЗадолженности;
			СтрокаЗачета.ОснованиеЗадолженности = ВыборкаДетальныеЗаписи.Основание;
			СтрокаЗачета.ОснованиеАванса = СтрокаАванса.Основание;
			СтрокаЗачета.СуммаЗачета = СуммаЗачета;
			
			СуммаЗадолженности = СуммаЗадолженности - СуммаЗачета;
			СтрокаАванса.СуммаОстаток = СтрокаАванса.СуммаОстаток - СуммаЗачета;
			
			Если СуммаЗадолженности = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаЗачетаАвансовДляПредварительнойЗадолженности, "_ЗачетыАвансовДляПредварительнойЗадолженности", Запрос);
	
КонецПроцедуры

Процедура ПроверкиПередПроведениемДокумента(Отказ)
	          	
	// Начиная с 01.01.2019 проверяем знаки у сумм прочих активов (нулевые суммы не попадают в документ)
	//
	// Сообщение и Отказ, если не выполнены условия:
	// - Дебиторка положительна (исключая обесценение, МНО)
	// - Тело депозита положительно
	// - Кредиторка отрицательна (исключая обесценение)
	// - Имущественные права, Недвижимость положительны
	//
	// Просто сообщение (без Отказа), если не выполнены условия:
	// - Денежные средства положительны
	// - Средства у брокера положительны
	
	ИсключаемыеВидыЗадолженности = Новый Массив;
	ИсключаемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ОбесценениеДисконтированиеОсновнойДолгИПроценты);
	ИсключаемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ОбесценениеДисконтированиеОсновнойДолг);
	ИсключаемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ОбесценениеДисконтированиеПроценты);
	ИсключаемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоДепозитномуВкладуПроценты);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("ИсключаемыеВидыЗадолженности", ИсключаемыеВидыЗадолженности);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Выгрузить(), "_АктивыНеЦБ", Запрос.МенеджерВременныхТаблиц);
		
	Если ДополнительныеСвойства.Свойство("НачислениеСписаниеРезервов") Тогда
		ТаблицаРезервов = ДополнительныеСвойства.НачислениеСписаниеРезервов.Партии.Выгрузить();
	Иначе
		ТаблицаРезервов = НачислениеСписаниеРезервов.Партии.Выгрузить();
	КонецЕсли;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ТаблицаРезервов, "_РезервыПредстоящихРасходов", Запрос.МенеджерВременныхТаблиц);
		
	#Область Проверка_сумм_активов_не_ЦБ
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыНеЦБ.НомерСтроки КАК НомерСтроки,
		|	_АктивыНеЦБ.СуммаРынокВВалютеУчета КАК Сумма,
		|	_АктивыНеЦБ.ВидАктива КАК ВидАктива,
		|	_АктивыНеЦБ.СубъектАналитики КАК СубъектАналитики,
		|	_АктивыНеЦБ.ВидЗадолженности КАК ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА _АктивыНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|				И _АктивыНеЦБ.СубъектАналитики <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.)
		|			ТОГДА ЛОЖЬ
		|		КОГДА _АктивыНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ &Дата >= ДАТАВРЕМЯ(2019, 1, 1)
		|	КОНЕЦ КАК Отказ
		|ИЗ
		|	_АктивыНеЦБ КАК _АктивыНеЦБ
		|ГДЕ
		|	ВЫБОР
		|			КОГДА _АктивыНеЦБ.ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ИмущественныеПрава), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость))
		|				ТОГДА _АктивыНеЦБ.СуммаРынокВВалютеУчета < 0
		|			КОГДА _АктивыНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				ТОГДА _АктивыНеЦБ.СуммаРынокВВалютеУчета > 0
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	И НЕ _АктивыНеЦБ.ВидЗадолженности В (&ИсключаемыеВидыЗадолженности)
		|	И ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.СубъектАналитики) <> ТИП(Документ.МНО)";		
	 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = ?(Выборка.Сумма < 0,
			"отрицательная сумма по виду актива " + СокрЛП(Выборка.ВидАктива),
			"положительная сумма кредиторской задолженности " + СокрЛП(Выборка.ВидЗадолженности));
		
		ТекстСообщения = "В строке " + Формат(Выборка.НомерСтроки, "ЧГ=0") + " " + ТекстОшибки + " " + СокрЛП(Выборка.Сумма);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.СчетДоверительногоУправления, , , ?(Выборка.Отказ, Отказ, Неопределено));
		
		Если Выборка.Отказ Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаЗнакаСтоимостиАктивовНеОтносящихсяКЦеннымБумагам", Истина);
		КонецЕсли;
		
	КонецЦикла;
	#КонецОбласти
	
	#Область Проверка_резервов_по_брокеру
	// Проверяем резервы под обесценение по брокеру: резервы по умолчанию относим к остатку в рублях, но если на брокере только остаток в валюте, резервы "теряются"		
	ОшибкаРезерваПодОбесценениеПоБрокеру = Ложь;
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Дата);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.СубъектАналитики КАК СубъектАналитики,
		|	ЕСТЬNULL(_РезервыПредстоящихРасходов.СуммаОстаток, 0) КАК ОстатокРезерва
		|ИЗ
		|	(ВЫБРАТЬ
		|		_АктивыНеЦБ.СубъектАналитики КАК СубъектАналитики,
		|		СУММА((ВЫРАЗИТЬ(_АктивыНеЦБ.СуммаРынок * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс КАК ЧИСЛО(1, 1))) - _АктивыНеЦБ.СуммаРынокВВалютеУчета) КАК СуммаРезерва
		|	ИЗ
		|		_АктивыНеЦБ КАК _АктивыНеЦБ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|			ПО _АктивыНеЦБ.ВалютаСтроки = _КурсыВалют.Валюта
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|			ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|	ГДЕ
		|		ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_АктивыНеЦБ.СубъектАналитики) КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_РезервыПредстоящихРасходов.Актив КАК СубъектАналитики,
		|			СУММА(_РезервыПредстоящихРасходов.СуммаРезерваПартии) КАК СуммаОстаток
		|		ИЗ
		|			_РезервыПредстоящихРасходов КАК _РезервыПредстоящихРасходов
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_РезервыПредстоящихРасходов.Актив) КАК _РезервыПредстоящихРасходов
		|		ПО _ИтоговаяТаблица.СубъектАналитики = _РезервыПредстоящихРасходов.СубъектАналитики
		|ГДЕ
		|	ЕСТЬNULL(_РезервыПредстоящихРасходов.СуммаОстаток, 0) <> 0
		|	И _ИтоговаяТаблица.СуммаРезерва <> ЕСТЬNULL(_РезервыПредстоящихРасходов.СуммаОстаток, 0)";   
	
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ЧИСЛО(1, 1)", СтрШаблон("КАК ЧИСЛО(%1, %2)",
			Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.Разрядность,
			Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти));	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрШаблон("Не учтен резерв под обесценение по брокеру %1, т. к. в остатках денежных средств " 
			+ "по этому брокеру отсутствует остаток на рублевом счете. Остаток резерва - %2 рублей", 
			Выборка.СубъектАналитики, 
			Выборка.ОстатокРезерва);
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.СчетДоверительногоУправления,,, ОшибкаРезерваПодОбесценениеПоБрокеру);
		
	КонецЦикла;

	Если ОшибкаРезерваПодОбесценениеПоБрокеру Тогда
		Отказ = Истина;
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаРезерваПодОбесценениеПоБрокеру", Истина);
	КонецЕсли;		
	#КонецОбласти

	#Область Проверка_используемых_аналитик_резервов
	ВидДоговораДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФондФилософии
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РПИ2023
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ЛонгТермИнвестментс
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.СредневзвешеннаяЕПС_УКПИ
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
	Тогда
	
		МассивИспользуемыхАналитикРезервов = Новый Массив;
		Если ВидДоговораДУ <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			МассивИспользуемыхАналитикРезервов.Добавить(Тип("СправочникСсылка.ЮрФизЛица"));
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_РезервыПредстоящихРасходов.Актив КАК СубъектАналитики
			|ИЗ
			|	_РезервыПредстоящихРасходов КАК _РезервыПредстоящихРасходов
			|ГДЕ
			|	НЕ ТИПЗНАЧЕНИЯ(_РезервыПредстоящихРасходов.Актив) В (&ИспользуемыеАналитики)";
		
		Запрос.УстановитьПараметр("ИспользуемыеАналитики", МассивИспользуемыхАналитикРезервов);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 0 Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаНекорректныхОстатковРезервовПредстоящихРасходов", Истина);
		КонецЕсли;
		
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщения = СтрШаблон("Обнаружены остатки по резервам с аналитикой %1. " 
				+ "Учет этих резервов не автоматизирован, необходимо обратиться к программистам", 
				Выборка.СубъектАналитики);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.СчетДоверительногоУправления,,, Отказ);
			
		КонецЦикла;
			
	КонецЕсли;		
	#КонецОбласти
	
КонецПроцедуры

Процедура ПроверитьЗависшиеРезервыПоСписаннымАктивам(Отказ)
	
	// До этой даты работал отчет
	Если ЭтотОбъект.Дата < '20260528' Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Выгрузить(), "_АктивыНеЦБ", Запрос.МенеджерВременныхТаблиц);
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
		|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&ПериодВключаяГраницу,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СубъектАналитики <> НЕОПРЕДЕЛЕНО) КАК РезервыПредстоящихРасходовОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АктивыНеЦБ КАК _АктивыНеЦБ
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.Основание) = ТИП(Документ.СделкаРЕПО)
		|					ТОГДА _АктивыНеЦБ.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И _АктивыНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.Основание) = ТИП(Документ.ПогашениеКупона)
		|					ТОГДА _АктивыНеЦБ.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И _АктивыНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.Основание) = ТИП(Документ.НачислениеДивидендов)
		|					ТОГДА _АктивыНеЦБ.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И _АктивыНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|						И _АктивыНеЦБ.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|					ТОГДА _АктивыНеЦБ.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады)
		|					ТОГДА _АктивыНеЦБ.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И _АктивыНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				КОГДА ТИПЗНАЧЕНИЯ(_АктивыНеЦБ.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|					ТОГДА _АктивыНеЦБ.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И _АктивыНеЦБ.ВалютаСтроки = РезервыПредстоящихРасходовОстатки.Валюта
		|				ИНАЧЕ _АктивыНеЦБ.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|			КОНЕЦ)
		|ГДЕ
		|	_АктивыНеЦБ.СубъектАналитики ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ПериодВключаяГраницу",			Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщения = СтрШаблон("Обнаружен остаток резерва по активу, отсутсвующему в СЧА: %1, сумма %2", Выборка.СубъектАналитики, Выборка.Сумма);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.СчетДоверительногоУправления,,, Отказ);
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение_связанных_документов

Функция ПолучитьПараметрыЗаполнения(ПараметрыЗаполнения, РеквизитыСчетаДУ, Отказ) Экспорт
		
	ПараметрыЗаполнения.Вставить("Период", 					     		НачалоДня(ЭтотОбъект.Дата));
	ПараметрыЗаполнения.Вставить("Организация", 				 		ЭтотОбъект.Организация);
	ПараметрыЗаполнения.Вставить("СчетДоверительногоУправления", 		ЭтотОбъект.СчетДоверительногоУправления);
	ПараметрыЗаполнения.Вставить("ВалютаРубли",  				 		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета")); 	
	ПараметрыЗаполнения.Вставить("ЦельРасчета", 				 		ЭтотОбъект.ЦельРасчетаСтоимостиОценки);
		
	НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(ПараметрыЗаполнения.Период, ПараметрыЗаполнения.Организация, ПараметрыЗаполнения.СчетДоверительногоУправления);
	Если НастройкиФормированияСЧА = Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СокрЛП(ПараметрыЗаполнения.СчетДоверительногоУправления) + " не определены настройки формирования СЧА на дату " + Формат(ПараметрыЗаполнения.Период, "ДФ=dd.MM.yyyy") + "", ПараметрыЗаполнения.СчетДоверительногоУправления,,,Отказ);
		Возврат Неопределено;
	ИначеЕсли НЕ ЗначениеЗаполнено(НастройкиФормированияСЧА.ПериодичностьРасчетаСЧА) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СокрЛП(ПараметрыЗаполнения.СчетДоверительногоУправления) + " не указана периодичность формирования СЧА на дату " + Формат(ПараметрыЗаполнения.Период, "ДФ=dd.MM.yyyy") + "", ПараметрыЗаполнения.СчетДоверительногоУправления,,,Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоОтчетноеСЧА = Ложь;
	ДатыРасчетаСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, ПараметрыЗаполнения.Период, ПараметрыЗаполнения.Период, Истина);
	Для каждого ДатаРасчетаСЧА из ДатыРасчетаСЧА Цикл
		ЭтоОтчетноеСЧА = ДатаРасчетаСЧА = НачалоДня(ПараметрыЗаполнения.Период);
	КонецЦикла;
	
	ПараметрыЗаполнения.Вставить("ЭтоОтчетнаяСЧА", ЭтоОтчетноеСЧА);
		
	Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		ЗаполнитьПараметрыПИФ(ПараметрыЗаполнения);
	КонецЕсли;
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	// Проверим, что настройки есть
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют настройки цели расчета 'Оценка объектов в управлении'",,,, Отказ);
	Иначе
		ПараметрыЗаполнения.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВидУчетаДляОстатковПартий) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан вид учета.",,,, Отказ);
	Иначе
		ПараметрыЗаполнения.Вставить("ВидУчета", НастройкиОценки.ВидУчетаДляОстатковПартий);
	КонецЕсли;
	
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		// Если оценка "заморожена", то актуальные цены от клиента не нужны
		
		ВыполнятьРасчетПоУказаниюЦБ	= НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
		
		Если Не ВыполнятьРасчетПоУказаниюЦБ Тогда
		
			Если ПараметрыЗаполнения.Свойство("ПутьКФайлу") И Не ЗначениеЗаполнено(ПараметрыЗаполнения.ПутьКФайлу) Тогда
				 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задан путь к файлам оценочной стоимости ценных бумаг клиента.",,,, Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.АдресТаблицыСтоимостей) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке стоимостей ценных бумаг из файла клиента: некорректный путь или ошибка доступа к файлу " + ПараметрыЗаполнения.ПутьКФайлу + ".",,,, Отказ);
			КонецЕсли;

		КонецЕсли;
	
	Иначе
		ПараметрыЗаполнения.АдресТаблицыСтоимостей = Неопределено;
	КонецЕсли; 
	
	// Настройки для документа НачислениеСписаниеРезервов
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	НужноНачислениеРезервов	= НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 
		И БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(НастройкиФормированияСЧА.ПериодичностьНачисленияРезервов, ЭтотОбъект.Дата);
		
	ТолькоПоступившиеАктивы = (НЕ НужноНачислениеРезервов И НастройкиФормированияСЧА.ПериодичностьНачисленияРезервов <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать)
		И НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9;
		
	ПараметрыЗаполнения.Вставить("НужноНачислениеРезервов", НужноНачислениеРезервов);
	ПараметрыЗаполнения.Вставить("ТолькоПоступившиеАктивы", ТолькоПоступившиеАктивы);
	
	// У Гефеста пока что нужно отображать резервы по выбывшим активам (недоработка в их методике до 28.02.2024 включительно)
	// У Атомов, Хантов и прочих резервы на МНО начисляются в день открытия МНО, когда нет процентов, т.е.в СЧА нет актива, есть только резерв
	ВключатьВСЧАРезервыПоОтсутствующимАктивам = 
		НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Гефест И ПараметрыЗаполнения.Период < '20240229'
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 И ПараметрыЗаполнения.Период >= '20250101'
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 И ПараметрыЗаполнения.Период >= '20250101'
		Или НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Газфонд И ПараметрыЗаполнения.Период >= '20250101';
		
	ПараметрыЗаполнения.Вставить("ВключатьВСЧАРезервыПоОтсутствующимАктивам", ВключатьВСЧАРезервыПоОтсутствующимАктивам);
		
	// Добавляем вспомогательные свойства
	
	Если Не ПараметрыЗаполнения.Свойство("Оповещения") Тогда
		ПараметрыЗаполнения.Вставить("Оповещения", Новый Массив);
	КонецЕсли;
	
	Если Не ПараметрыЗаполнения.Свойство("Исключения") Тогда
		ПараметрыЗаполнения.Вставить("Исключения", Новый Массив);
	КонецЕсли;
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Процедура ЗаполнитьДокументыРегистрацииСтоимости(ПараметрыЗаполнения, ПроводитьДокументы, Отказ) Экспорт
	
	// Возможные варианты вызова функции:
	// 1. Проводить И Не КонтрольСЧА	- проведение регламентных операций
	// 2. Не Проводить И КонтрольСЧА 	- контроль СЧА
	// 3. Не Проводить И Не КонтрольСЧА	- заполнение документа из формы
	
	ВыполнятьВТранзакции = Не ПараметрыЗаполнения.Свойство("КонтрольСЧА");							// транзакция нужна для защиты от изменения документов на время заполнения
	ПродолжитьПриОтказе	 = Не ПроводитьДокументы И Не ПараметрыЗаполнения.Свойство("КонтрольСЧА");	// при заполнении из формы при ошибке идем дальше и покажем пользователю, что получилось
	
	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "КодСчета, ВидДоговораДоверительногоУправления");
	Если РеквизитыСчетаДУ.КодСчета = "О" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = ПолучитьПараметрыЗаполнения(ПараметрыЗаполнения, РеквизитыСчетаДУ, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	Если ВыполнятьВТранзакции Тогда
		НачатьТранзакцию();
		УстановитьБлокировки(Истина);
		ТранзакцияАктивна = Истина;
	КонецЕсли;
	
	МассивСообщенийПользователю = ОбщегоНазначения.ОчиститьБуферСообщенийПользователю();
	
	ОписаниеПараметровДляСбораСтатистики = СтрШаблон("Организация: %1
		|Счет доверительного управления: %2
		|Дата: %3", ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
	
	#Область Регистрация_стоимости_активов
		
	Если Не Отказ ИЛИ ПродолжитьПриОтказе Тогда

		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			"Документ.РегистрацияСтоимостиАктивов.СтоимостьАктивов", , ОписаниеПараметровДляСбораСтатистики);
		
		Попытка
			
			ТаблицаАктивовИОбязательств = ПолучитьТаблицуАктивовИОбязательств(ПараметрыЗаполнения);
			
			Если ТаблицаАктивовИОбязательств = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не произведен расчет активов и обязательств.",,,, Отказ);
				ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Очистить();
			Иначе
				ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Загрузить(ТаблицаАктивовИОбязательств);
			КонецЕсли;
			
		Исключение
			
			ОбщегоНазначения.ОбработатьИсключение("Ошибка заполнения документа.", ИнформацияОбОшибке(), ЭтотОбъект.Ссылка, Отказ, ПараметрыЗаполнения.Исключения);
			
		КонецПопытки;
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "");
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
			"Документ.РегистрацияСтоимостиАктивов.СтоимостьАктивов", Сессия);
		
	КонецЕсли;
	
	#КонецОбласти 
	
	РасчетПартий = Неопределено;
	
	#Область Начисление_резервов
	
	Если ПараметрыЗаполнения.НужноНачислениеРезервов Или ПараметрыЗаполнения.ТолькоПоступившиеАктивы Тогда
		
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			"Документ.РегистрацияСтоимостиАктивов.НачислениеРезервов", , ОписаниеПараметровДляСбораСтатистики);
		
		ЗаполнитьНачислениеСписаниеРезервов(ПараметрыЗаполнения, ТаблицаАктивовИОбязательств, РасчетПартий, Отказ);
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "НачислениеСписаниеРезервов.");
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
			"Документ.РегистрацияСтоимостиАктивов.НачислениеРезервов", Сессия);
				
	Иначе
		
		ЭтотОбъект.НачислениеСписаниеРезервов = Неопределено;
		
	КонецЕсли;
	
	ЗаполнитьСуммыРезервовВВалютеУчета(ПараметрыЗаполнения);
		
	ОбщегоНазначения.ОчиститьБуферСообщенийПользователю(МассивСообщенийПользователю);
	
	#КонецОбласти 
	
	#Область Регистрация_стоимости_переоценки
	
	РегистрацияСтоимостиПереоценки = Неопределено;
	ДополнительныеСвойства.Свойство("РегистрацияСтоимости", РегистрацияСтоимостиПереоценки);
	
	Если РегистрацияСтоимостиПереоценки = Неопределено Или РегистрацияСтоимостиПереоценки.Ссылка.Пустая() Тогда
	
		Если ЭтотОбъект.РегистрацияСтоимости.Пустая() Тогда
			РегистрацияСтоимостиПереоценки = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		Иначе
			РегистрацияСтоимостиПереоценки = ЭтотОбъект.РегистрацияСтоимости.ПолучитьОбъект();
		КонецЕсли; 
		
		ДополнительныеСвойства.Вставить("РегистрацияСтоимости", РегистрацияСтоимостиПереоценки);
	
	КонецЕсли;
	
	Если Не Отказ Или ПродолжитьПриОтказе Тогда

		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			"Документ.РегистрацияСтоимостиАктивов.СтоимостьПереоценки", , ОписаниеПараметровДляСбораСтатистики);
		
		ЗаполнитьРегистрациюСтоимостиПереоценки(ПараметрыЗаполнения, РасчетПартий, Отказ);
		
		ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "РегистрацияСтоимости.");
		
		СтоимостиПереоценки = ДополнительныеСвойства.РегистрацияСтоимости.СтоимостиПереоценки.Выгрузить();
			
		РассчитатьИУстановитьЗначенияИтоговыхРеквизитов(СтоимостиПереоценки);
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
			"Документ.РегистрацияСтоимостиАктивов.СтоимостьПереоценки", Сессия);
		
	КонецЕсли;
		
	#КонецОбласти 
	
	#Область Начисление_резервов_ПИФ
	
	Если Не Отказ Или ПродолжитьПриОтказе Тогда
	
		Если РеквизитыСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			
			Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
				"Документ.РегистрацияСтоимостиАктивов.РезервыПИФ", , ОписаниеПараметровДляСбораСтатистики);
			
			// если из СЧА нужно убрать сумму вознаграждения управляющего, начисленную на дату расчета,
			// посчитаем ее
			СуммаВознагражденияУправляющего = 0;
			СуммаВознагражденияСДРасч = 0;
			
			ПаевойИнвестиционныйФонд = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
			УсловияПравилПИФ = БухгалтерскийУчет.ОпределитьУсловияПравилПаевогоИнвестиционногоФонда(ЭтотОбъект.Дата, ПаевойИнвестиционныйФонд);
			
			// Для ФДЦБ вознаграждение УК, влияющее на СЧА начисляется фиксированной суммой (вручную), а лимит на вознаграждение УК - по среднегодовой.
			//    Поэтому вознаграждение УК не вычитаем из предварительной СЧА
			Если Не ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПИФФДЦБ")
				И Не УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
				И ТаблицаАктивовИОбязательств <> Неопределено
			Тогда
				// из предварительной СЧА уберем расходы управляющего, начисленные сегодня из предвартельной СЧА.
				СтрокиВознагражденияУправляющего = ТаблицаАктивовИОбязательств.НайтиСтроки(Новый Структура("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего));
				Для Каждого СтрокаАктивовИОбязательств Из СтрокиВознагражденияУправляющего Цикл
					Если ЗначениеЗаполнено(СтрокаАктивовИОбязательств.Основание) И НачалоДня(СтрокаАктивовИОбязательств.Основание.Дата) = НачалоДня(ЭтотОбъект.Дата) Тогда
						СуммаВознагражденияУправляющего = СуммаВознагражденияУправляющего + СтрокаАктивовИОбязательств.СуммаРынокВВалютеУчета;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если (РегистрыСведений.НастройкиФормированияСЧА.ЕжедневноеФормированиеСЧА(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления))
					И (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"))
					И ТаблицаАктивовИОбязательств <> Неопределено Тогда
					
				//при ежедневном расчёте резервы ранее уменьшили на расчётную кредиторку по вознаграждению СД и СР, надо вернуть
				СтрокиВознагражденияСДСР = ТаблицаАктивовИОбязательств.НайтиСтроки(Новый Структура("ВидЗадолженности", Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария));
				Для Каждого СтрокаАктивовИОбязательств Из СтрокиВознагражденияСДСР Цикл
					Если ЗначениеЗаполнено(СтрокаАктивовИОбязательств.Основание) И ТипЗнч(СтрокаАктивовИОбязательств.Основание) = Тип("СправочникСсылка.Договоры")  Тогда
						СуммаВознагражденияСДРасч = СуммаВознагражденияСДРасч + СтрокаАктивовИОбязательств.СуммаРынокВВалютеУчета;
					КонецЕсли;
				КонецЦикла;

				СтрокиВознагражденияСДСР = ТаблицаАктивовИОбязательств.НайтиСтроки(Новый Структура("ВидЗадолженности", Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора));
				Для Каждого СтрокаАктивовИОбязательств Из СтрокиВознагражденияСДСР Цикл
					Если ЗначениеЗаполнено(СтрокаАктивовИОбязательств.Основание) И ТипЗнч(СтрокаАктивовИОбязательств.Основание) = Тип("СправочникСсылка.Договоры")  Тогда
						СуммаВознагражденияСДРасч = СуммаВознагражденияСДРасч + СтрокаАктивовИОбязательств.СуммаРынокВВалютеУчета;
					КонецЕсли;
				КонецЦикла;

			КонецЕсли;
			ЗаполнитьНачислениеРезервовПИФ(ПараметрыЗаполнения, ЭтотОбъект.СЧАРынок - СуммаВознагражденияУправляющего - СуммаВознагражденияСДРасч, Отказ);
			
			ПерезаполнитьЗадолженностьПоРезервам(ПараметрыЗаполнения);
			
			РассчитатьИУстановитьЗначенияИтоговыхРеквизитов(СтоимостиПереоценки);
			
			ОбработатьСообщенияПодчиненногоДокумента(МассивСообщенийПользователю, "НачислениеРезервовПИФ.");		
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
				"Документ.РегистрацияСтоимостиАктивов.РезервыПИФ", Сессия);
						
		КонецЕсли;  
	
	КонецЕсли;
	
	#КонецОбласти  
	
	НачислениеСписаниеРезервовОбъект = Неопределено;
	ДополнительныеСвойства.Свойство("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект);
	Если ПараметрыЗаполнения.Свойство("КонтрольСЧА")
		И Не ПроводитьДокументы
		И НачислениеСписаниеРезервовОбъект <> Неопределено Тогда
		
		ПроверитьЗависшиеРезервыПоСписаннымАктивам(Отказ);
		
	КонецЕсли;
	
	Если ПроводитьДокументы И Не Отказ Тогда
		
		Попытка
			ЭтотОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			
			#Область Обработка_ошибок
			
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаОпределенияЦены")
				ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаОтрицательныхОстатковРезервовПИФ")
				ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаНекорректныхОстатковРезервовПредстоящихРасходов")
				ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаЗапретаРедактированияДокумента")
				ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаЗнакаСтоимостиАктивовНеОтносящихсяКЦеннымБумагам")
				ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкаРезерваПодОбесценениеПоБрокеру")
			Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка проведения документа: не выполнены необходимые проверки", ЭтотОбъект, , , Отказ);
			Иначе
				ОбщегоНазначения.ОбработатьИсключение("Ошибка проведения документа.", ИнформацияОбОшибке(), ЭтотОбъект.Ссылка, Отказ, ПараметрыЗаполнения.Исключения);
			КонецЕсли;
			
			#КонецОбласти
			
		КонецПопытки;
		
	КонецЕсли;
	
	// Фиксируем результаты работы

	Если ВыполнятьВТранзакции Тогда
		
		ФиксацияТранзакции = ПроводитьДокументы И Не Отказ;
		
		Если ФиксацияТранзакции Тогда
			
			ЗафиксироватьТранзакцию();
			
		Иначе
			
			Если ТранзакцияАктивна Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			
			#Область Сохранение_зарегистрированных_аналогов
			
			СозданныеДокументы = Неопределено;
			
			Если ДополнительныеСвойства.Свойство("РегистрацияСтоимости")
				И ДополнительныеСвойства.РегистрацияСтоимости.ДополнительныеСвойства.Свойство("СозданныеДокументы", СозданныеДокументы)
			Тогда
				
				Для Каждого Документ Из СозданныеДокументы Цикл
					
					// Т.к. после отката транзакции документ становится "не выбран" и его уже нельзя сохранить,
					// то последовательно сериализуем/десериализуем его перед записью
					
					ОбщегоНазначения.ОчиститьБуферСообщенийПользователю(МассивСообщенийПользователю);
					
					Попытка
						НовыйДокумент = СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(Документ));
						НовыйДокумент.УстановитьНовыйНомер();
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);		
					Исключение
						ОбщегоНазначения.ОбработатьИсключение(СтрШаблон("Ошибка проведения документа '%1'.", НовыйДокумент), ИнформацияОбОшибке(), ЭтотОбъект.Ссылка, Отказ, ПараметрыЗаполнения.Исключения);
					КонецПопытки;
					
				КонецЦикла;
				
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;
	
	#Область Формирование_оповещений
	
	Оповещения = Неопределено;
	Если ДополнительныеСвойства.РегистрацияСтоимости.ДополнительныеСвойства.Свойство("Оповещения", Оповещения) Тогда
		РаботаСКоллекциями.ДополнитьМассив(ПараметрыЗаполнения.Оповещения, Оповещения);
	КонецЕсли;
			
	Для Каждого Оповещение Из ПараметрыЗаполнения.Оповещения Цикл
		
		Если Оповещение.РеквизитыОповещения.Свойство("Текст") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Оповещение.РеквизитыОповещения.Текст);
		КонецЕсли;
			
		Если Не ВыполнятьВТранзакции Или ФиксацияТранзакции Тогда
			
			ОбщегоНазначения.ОчиститьБуферСообщенийПользователю(МассивСообщенийПользователю);
			
			Попытка
				Справочники.Оповещения.СформироватьОповещения(Оповещение.ПолноеИмяИсточника, Оповещение.ТипСобытия, Оповещение.РеквизитыОповещения);
			Исключение
				ОбщегоНазначения.ОбработатьИсключение(СтрШаблон("Ошибка выполнения оповещения '%1'.", Оповещение.ПолноеИмяИсточника), ИнформацияОбОшибке(), ЭтотОбъект.Ссылка, Отказ, ПараметрыЗаполнения.Исключения);
			КонецПопытки;
			
		КонецЕсли;
	
	КонецЦикла;
	
	#КонецОбласти
	
	ОбщегоНазначения.ВосстановитьСообщенияПользователю(МассивСообщенийПользователю);
	
	ОбщегоНазначения.ЗарегистрироватьИсключения(ПараметрыЗаполнения.Исключения, ЭтотОбъект.Метаданные().ПолноеИмя() + ".ЗаполнитьДокументыРегистрацииСтоимости");
	
КонецПроцедуры

Процедура ЗаполнитьРегистрациюСтоимостиПереоценки(ПараметрыЗаполнения, РасчетПартий, Отказ)

	РегистрацияСтоимостиПереоценки = ДополнительныеСвойства.РегистрацияСтоимости;
	
	ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиПереоценки, ЭтотОбъект, "Дата, Организация, СчетДоверительногоУправления, Ответственный");
	ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиПереоценки, ПараметрыЗаполнения, "ЦельРасчета, ВидУчета");
	
	Если ПараметрыЗаполнения.Свойство("КонтрольСЧА") Тогда
		РегистрацияСтоимостиПереоценки.ДополнительныеСвойства.Вставить("КонтрольСЧА");	
	КонецЕсли;
	
	РегистрацияСтоимостиПереоценки.Дата = РаботаСДокументами.ПолучитьВремяДокумента(РегистрацияСтоимостиПереоценки.Дата, РегистрацияСтоимостиПереоценки.Ссылка);
	
	ОшибкаЗаполнения			= Ложь;
	МассивСообщенийПользователю	= ОбщегоНазначения.ОчиститьБуферСообщенийПользователю();
	
	Попытка
		ТаблицыДокумента = РегистрацияСтоимостиПереоценки.ПолучитьСтоимостиПереоценкиДляОценкиОбъектовВУправлении(ПараметрыЗаполнения.АдресТаблицыСтоимостей, Отказ, РасчетПартий);
	Исключение
		ОбщегоНазначения.ОбработатьИсключение("Ошибка заполнения документа.", ИнформацияОбОшибке(), РегистрацияСтоимостиПереоценки.Ссылка, ОшибкаЗаполнения, ПараметрыЗаполнения.Исключения);
	КонецПопытки;
	
	ОбщегоНазначения.ВосстановитьСообщенияПользователю(МассивСообщенийПользователю);
	
	Если ОшибкаЗаполнения Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицыДокумента) = Тип("Структура") Тогда
		
		Если ПараметрыЗаполнения.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом
			И РегистрацияСтоимостиПереоценки.ДополнительныеСвойства.Свойство("ТаблицаСтоимостейИзФайла") Тогда
			ДополнительныеСвойства.Вставить("ТаблицаСтоимостейИзФайла", РегистрацияСтоимостиПереоценки.ДополнительныеСвойства.ТаблицаСтоимостейИзФайла);
		КонецЕсли;
		
		Если ТаблицыДокумента.СтоимостиПереоценки = Неопределено Тогда
		    РегистрацияСтоимостиПереоценки.СтоимостиПереоценки.Очистить();
		Иначе
			РегистрацияСтоимостиПереоценки.СтоимостиПереоценки.Загрузить(ТаблицыДокумента.СтоимостиПереоценки);
		КонецЕсли; 
		
		Если ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг = Неопределено Тогда
		    РегистрацияСтоимостиПереоценки.СтоимостиПрочихЦенныхБумаг.Очистить();
		Иначе
			РегистрацияСтоимостиПереоценки.СтоимостиПрочихЦенныхБумаг.Загрузить(ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг);
		КонецЕсли;		
	
	КонецЕсли; 
					
КонецПроцедуры
 
Процедура ЗаполнитьНачислениеРезервовПИФ(ПараметрыЗаполнения, ПредварительнаяСЧА, Отказ)
	
	НачислениеРезервовПИФОбъект = Неопределено;

	Если Не ДополнительныеСвойства.Свойство("НачислениеРезервовПИФ", НачислениеРезервовПИФОбъект) Тогда
	
		Если ЭтотОбъект.НачислениеРезервовПИФ.Пустая() Тогда
			НачислениеРезервовПИФОбъект = Документы.НачислениеРезервовПИФ.СоздатьДокумент();
		Иначе
			НачислениеРезервовПИФОбъект = ЭтотОбъект.НачислениеРезервовПИФ.ПолучитьОбъект();
		КонецЕсли; 
		ДополнительныеСвойства.Вставить("НачислениеРезервовПИФ", НачислениеРезервовПИФОбъект);
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НачислениеРезервовПИФОбъект, ЭтотОбъект, "Дата, Организация, СчетДоверительногоУправления, Ответственный");
	
	НачислениеРезервовПИФОбъект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(НачислениеРезервовПИФОбъект.Дата, НачислениеРезервовПИФОбъект.Ссылка);
	НачислениеРезервовПИФОбъект.ПаевойИнвестиционныйФонд = ПараметрыЗаполнения.ПаевойИнвестиционныйФонд;
	
	МассивСообщенийПользователю	= ОбщегоНазначения.ОчиститьБуферСообщенийПользователю();
	
	Попытка

		Резервы = Документы.НачислениеРезервовПИФ.РассчитатьРезервы(НачислениеРезервовПИФОбъект, ПредварительнаяСЧА);
		Если Резервы = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка расчета резервов", , , , Отказ);
		Иначе
			ЗаполнитьЗначенияСвойств(НачислениеРезервовПИФОбъект, Резервы);
		КонецЕсли;
		
	Исключение
		ОбщегоНазначения.ОбработатьИсключение("Ошибка заполнения документа начисления резервов ПИФ.", ИнформацияОбОшибке(), НачислениеРезервовПИФОбъект.Ссылка, Отказ, ПараметрыЗаполнения.Исключения);
	КонецПопытки;
	
	ОбщегоНазначения.ВосстановитьСообщенияПользователю(МассивСообщенийПользователю);

КонецПроцедуры

Процедура ЗаполнитьПараметрыПИФ(ПараметрыЗаполнения)
		
	ПараметрыЗаполнения.Вставить("ДатаПоследнегоСЧА", 
			Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ПараметрыЗаполнения.СчетДоверительногоУправления, ПараметрыЗаполнения.Период));			
	ПараметрыЗаполнения.Вставить("ПаевойИнвестиционныйФонд", 
			Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ПараметрыЗаполнения.СчетДоверительногоУправления, ПараметрыЗаполнения.Период));
					
КонецПроцедуры

Процедура ПерезаполнитьЗадолженностьПоРезервам(ПараметрыЗаполнения) Экспорт

	Если НЕ ПараметрыЗаполнения.ЭтоОтчетнаяСЧА Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаКурса", 						НачалоДня(ПараметрыЗаполнения.Период));
	Запрос.УстановитьПараметр("Организация", 					ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыЗаполнения.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗаполнения.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("ПериодНачало", 					Новый Граница(НачалоДня(ПараметрыЗаполнения.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодОкончание", 				Новый Граница(КонецДня(ПараметрыЗаполнения.Период), ВидГраницы.Включая));
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, ПараметрыЗаполнения.Период);
	Документы.РегистрацияСтоимостиАктивов.ПоместитьОстаткиРезервовВМенеджерВременныхТаблиц(Запрос);
	
	Запрос.УстановитьПараметр("ВознаграждениеУправляющего", 				ЭтотОбъект.ДополнительныеСвойства.НачислениеРезервовПИФ.СуммаНаВознаграждениеУправляющего);
	Запрос.УстановитьПараметр("ВознаграждениеДепозитарияАудитораОценщика",	ЭтотОбъект.ДополнительныеСвойства.НачислениеРезервовПИФ.СуммаНаУслугиДепозитария);
	Запрос.УстановитьПараметр("ПрочиеВозмещаемыеРасходыУправляющего", 		ЭтотОбъект.ДополнительныеСвойства.НачислениеРезервовПИФ.СуммаНаПрочиеРасходы);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего) КАК Резерв,
	|	&ВалютаУчета КАК Валюта,
	|	-&ВознаграждениеУправляющего КАК Сумма,
	|	-&ВознаграждениеУправляющего КАК СуммаРынокВВалютеУчета
	|ПОМЕСТИТЬ _Объединение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика),
	|	&ВалютаУчета,
	|	-&ВознаграждениеДепозитарияАудитораОценщика,
	|	-&ВознаграждениеДепозитарияАудитораОценщика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего),
	|	&ВалютаУчета,
	|	-&ПрочиеВозмещаемыеРасходыУправляющего,
	|	-&ПрочиеВозмещаемыеРасходыУправляющего
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_ОстаткиРезервов.Резерв,
	|	_ОстаткиРезервов.Валюта,
	|	_ОстаткиРезервов.Сумма,
	|	_ОстаткиРезервов.Сумма * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс
	|ИЗ
	|	_ОстаткиРезервов КАК _ОстаткиРезервов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
	|		ПО _ОстаткиРезервов.Валюта = _КурсыВалют.Валюта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
	|		ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Резервы: "" + _Объединение.Резерв.Наименование КАК Примечание,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность) КАК ВидАктива,
	|	_Объединение.Резерв КАК ВидЗадолженности,
	|	_Объединение.Валюта КАК ВалютаСтроки,
	|	3 КАК УровеньОценки,
	|	СУММА(_Объединение.Сумма) КАК СуммаРынок,
	|	СУММА(_Объединение.СуммаРынокВВалютеУчета) КАК СуммаРынокВВалютеУчета
	|ИЗ
	|	_Объединение КАК _Объединение
	|ГДЕ
	|	_Объединение.Резерв В
	|			(ВЫБРАТЬ
	|				_РезервыДляУчетаВСЧА.Резерв
	|			ИЗ
	|				_РезервыДляУчетаВСЧА)
	|
	|СГРУППИРОВАТЬ ПО
	|	_Объединение.Резерв,
	|	_Объединение.Валюта,
	|	""Резервы: "" + _Объединение.Резерв.Наименование";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	РезервыДляУчетаВСЧА = Запрос.МенеджерВременныхТаблиц.Таблицы["_РезервыДляУчетаВСЧА"].ПолучитьДанные().Выгрузить();
	Для каждого СтрокаРезерва Из РезервыДляУчетаВСЧА Цикл
		НайденныеСтроки = ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.НайтиСтроки(Новый Структура("ВидЗадолженности", СтрокаРезерва.Резерв));
		Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
			ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Удалить(СтрокаКУдалению);
		КонецЦикла; 
	КонецЦикла; 
	
	ЕжедневныйРасчетСЧА_РПИ = Ложь;
	ДатаОснованияДляПрекращенияПИФПрошла = Ложь;
	Если ПараметрыЗаполнения.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
		И РегистрыСведений.НастройкиФормированияСЧА.ЕжедневноеФормированиеСЧА(ПараметрыЗаполнения.Период, ПараметрыЗаполнения.Организация, ПараметрыЗаполнения.СчетДоверительногоУправления) Тогда
		ЕжедневныйРасчетСЧА_РПИ = Истина;
		НайденныеСтроки = ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.НайтиСтроки(Новый Структура("Примечание", "КЗ: Расч. По вознаграждению управляющего"));
		Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
			ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Удалить(СтрокаКУдалению);
		КонецЦикла; 
		ДатаВозникновенияОснованияПрекращенияФонда = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаВозникновенияОснованияПрекращенияФонда", ПараметрыЗаполнения.ПаевойИнвестиционныйФонд);
		ДатаОснованияДляПрекращенияПИФПрошла = ЗначениеЗаполнено(ДатаВозникновенияОснованияПрекращенияФонда) И (НачалоДня(ПараметрыЗаполнения.Период) >= ДатаВозникновенияОснованияПрекращенияФонда);
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаРынокВВалютеУчета + Выборка.СуммаРынок <> 0 Тогда
			НоваяСтрока = ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Если ЕжедневныйРасчетСЧА_РПИ Тогда
				Если Выборка.ВидЗадолженности = Справочники.Резервы.ВознаграждениеДепозитарияАудитораОценщика Тогда
					НайденныеСтроки = ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.НайтиСтроки(Новый Структура("Примечание", "КЗ: Расч. расходы по вознаграждению спецдепозитария"));
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если НоваяСтрока.СуммаРынок < НайденныеСтроки[0].СуммаРынок Тогда
							НоваяСтрока.СуммаРынок = Мин(0, НоваяСтрока.СуммаРынок - НайденныеСтроки[0].СуммаРынок);
							НоваяСтрока.СуммаРынокВВалютеУчета = НоваяСтрока.СуммаРынок;
						Иначе
							ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Удалить(НоваяСтрока);
							Продолжить;
						КонецЕсли;
					КонецЕсли;

					НайденныеСтроки = ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.НайтиСтроки(Новый Структура("Примечание", "КЗ: Расч. расходы по вознаграждению спец.регистратора"));
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если НоваяСтрока.СуммаРынок < НайденныеСтроки[0].СуммаРынок Тогда
							НоваяСтрока.СуммаРынок = Мин(0, НоваяСтрока.СуммаРынок - НайденныеСтроки[0].СуммаРынок);
							НоваяСтрока.СуммаРынокВВалютеУчета = НоваяСтрока.СуммаРынок;
						Иначе
							ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам.Удалить(НоваяСтрока);
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли Выборка.ВидЗадолженности = Справочники.Резервы.ВознаграждениеУправляющего И Не ДатаОснованияДляПрекращенияПИФПрошла Тогда
					НоваяСтрока.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего;
					НоваяСтрока.Контрагент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ").ЮрФизЛицо;
					НоваяСтрока.Примечание = "КЗ: Расч. По вознаграждению управляющего";
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПроверитьОтрицательныеОстаткиРезервовПИФ(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", 						Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПИФОстатки.Резерв КАК Резерв,
		|	РезервыПИФОстатки.Валюта КАК Валюта,
		|	РезервыПИФОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РезервыПИФОстатки
		|ГДЕ
		|	РезервыПИФОстатки.СуммаОстаток < 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Резерв
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаОтрицательныхОстатковРезервовПИФ", Истина);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = "На конец дня обнаружен отрицательный остаток резервов предстоящих расходов на " + Выборка.Резерв + ".";
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект,,, Отказ);
				
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНачислениеСписаниеРезервов(ПараметрыЗаполнения, ТаблицаАктивовИОбязательств, РасчетПартий, Отказ) Экспорт

	Если ПараметрыЗаполнения.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
	
		ДатаЗапретаРедактированияПартий = ПолучитьДатуЗапретаРедактированияПартий();
		
		Если ДатаЗапретаРедактированияПартий < НачалоДня(ЭтотОбъект.Дата) Тогда
		
			РасчетПартий = Обработки.РасчетПартий.Создать();
			
			РасчетПартий.Организация                  = ПараметрыЗаполнения.Организация;
			РасчетПартий.СчетДоверительногоУправления = ПараметрыЗаполнения.СчетДоверительногоУправления;
			РасчетПартий.ВидУчета                     = ПараметрыЗаполнения.ВидУчета;
			РасчетПартий.НачалоПериода                = ДатаЗапретаРедактированияПартий + 86400;
			РасчетПартий.КонецПериода                 = КонецДня(ЭтотОбъект.Дата);
			РасчетПартий.ТаблицаПлановыхОпераций	  = Неопределено;
			РасчетПартий.ВариантРасчета				  = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы;
			
			РасчетПартий.РассчитатьПартии(Отказ, Истина);
		
		КонецЕсли;
	
	КонецЕсли;
	
	ДокументыНачисленияРезервовКПолномуПерезаполнению = Неопределено;
	Если Не ПараметрыЗаполнения.Свойство("ДокументыНачисленияРезервовКПолномуПерезаполнению", ДокументыНачисленияРезервовКПолномуПерезаполнению) Тогда
		ДокументыНачисленияРезервовКПолномуПерезаполнению = Новый Массив;	
	КонецЕсли;	
	
	НачислениеСписаниеРезервовОбъект = Неопределено;
	
	Если Не ДополнительныеСвойства.Свойство("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект) Тогда
	
		Если ЭтотОбъект.НачислениеСписаниеРезервов.Пустая() Тогда
			НачислениеСписаниеРезервовОбъект = Документы.НачислениеСписаниеРезервов.СоздатьДокумент();
		Иначе
			НачислениеСписаниеРезервовОбъект = ЭтотОбъект.НачислениеСписаниеРезервов.ПолучитьОбъект();
		КонецЕсли; 
		
		ДополнительныеСвойства.Вставить("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект);
	
	КонецЕсли;
	
	НачислениеСписаниеРезервовОбъект.ТаблицаАктивовИОбязательств = ТаблицаАктивовИОбязательств;
	НачислениеСписаниеРезервовОбъект.РасчетПартий = РасчетПартий;
	
	ЗаполнитьЗначенияСвойств(НачислениеСписаниеРезервовОбъект, ЭтотОбъект, "Дата, Организация, СчетДоверительногоУправления, Ответственный");
	НачислениеСписаниеРезервовОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	НачислениеСписаниеРезервовОбъект.ЗаполнитьРезервы(Отказ,, ПараметрыЗаполнения.ТолькоПоступившиеАктивы);
	
	Если Не ПараметрыЗаполнения.Свойство("КонтрольСЧА") И Не ЭтотОбъект.НачислениеСписаниеРезервов.Пустая() 
		И ДокументыНачисленияРезервовКПолномуПерезаполнению.Найти(ЭтотОбъект.НачислениеСписаниеРезервов) = Неопределено Тогда
		
		ОтборРучныхКорректировок = Новый Структура();
		ОтборРучныхКорректировок.Вставить("РучнаяКорректировка", Истина);
		СтрокиРучныхКорректировок = ЭтотОбъект.НачислениеСписаниеРезервов.Партии.НайтиСтроки(ОтборРучныхКорректировок);
		Если СтрокиРучныхКорректировок.Количество() > 0 Тогда
			Для Каждого СтрокаРучныхКорректировок Из СтрокиРучныхКорректировок Цикл
				
				ОтборПоАктивамИПартиям = Новый Структура();
				ОтборПоАктивамИПартиям.Вставить("Партия", СтрокаРучныхКорректировок.Партия);
				ОтборПоАктивамИПартиям.Вставить("СтрокаПартии", СтрокаРучныхКорректировок.СтрокаПартии);
				ОтборПоАктивамИПартиям.Вставить("Актив", СтрокаРучныхКорректировок.Актив);
				
				СтрокиРасчетРезервовОтборПоАктивамИПартиям = НачислениеСписаниеРезервовОбъект.Партии.НайтиСтроки(ОтборПоАктивамИПартиям);
				
				Если СтрокиРасчетРезервовОтборПоАктивамИПартиям.Количество() > 0 Тогда
					Для Каждого СтрокаРасчетРезервовОтборПоАктивамИПартиям Из СтрокиРасчетРезервовОтборПоАктивамИПартиям Цикл
						ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервовОтборПоАктивамИПартиям, СтрокаРучныхКорректировок);
					КонецЦикла;
				Иначе
					СтрокаРасчетРезервов = НачислениеСписаниеРезервовОбъект.Партии.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчетРезервов, СтрокаРучныхКорректировок);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	Если РасчетПартий <> Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		ЕстьОблигации = Ложь;
		Для каждого СтрокаПартии Из НачислениеСписаниеРезервовОбъект.Партии Цикл
			Если ТипЗнч(СтрокаПартии.Актив) = Тип("СправочникСсылка.Облигации") Тогда
				ЕстьОблигации = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьОблигации Тогда
			// Если документ содержит строки по облигациям - подменим суммы в остатках партий
			
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
				РасчетПартий.КонечныеОстаткиПартий.Выгрузить(), 
				"_КонечныеОстаткиПартий", 
				Запрос.МенеджерВременныхТаблиц,, 
				"НомерСтроки, ЦеннаяБумага, Партия, СтрокаПартии, СуммаРезервовПодОбесценение",,
				"ЦеннаяБумага, Партия, СтрокаПартии");
				
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
				НачислениеСписаниеРезервовОбъект.Партии.Выгрузить(), 
				"_НачислениеСписаниеРезервовПартии", 
				Запрос.МенеджерВременныхТаблиц,, 
				"Актив, Партия, СтрокаПартии, СуммаРезерваПартии",,
				"Актив, Партия, СтрокаПартии");
				
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_КонечныеОстаткиПартий.НомерСтроки КАК НомерСтроки,
				|	ЕСТЬNULL(_НачислениеСписаниеРезервовПартии.СуммаРезерваПартии, _КонечныеОстаткиПартий.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение
				|ИЗ
				|	_КонечныеОстаткиПартий КАК _КонечныеОстаткиПартий
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачислениеСписаниеРезервовПартии КАК _НачислениеСписаниеРезервовПартии
				|		ПО _КонечныеОстаткиПартий.ЦеннаяБумага = _НачислениеСписаниеРезервовПартии.Актив
				|			И _КонечныеОстаткиПартий.Партия = _НачислениеСписаниеРезервовПартии.Партия
				|			И _КонечныеОстаткиПартий.СтрокаПартии = _НачислениеСписаниеРезервовПартии.СтрокаПартии
				|ГДЕ
				|	_КонечныеОстаткиПартий.СуммаРезервовПодОбесценение <> ЕСТЬNULL(_НачислениеСписаниеРезервовПартии.СуммаРезерваПартии, _КонечныеОстаткиПартий.СуммаРезервовПодОбесценение)";
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				РасчетПартий.КонечныеОстаткиПартий[Выборка.НомерСтроки - 1].СуммаРезервовПодОбесценение = Выборка.СуммаРезервовПодОбесценение;
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьСуммыРезервовВВалютеУчета(ПараметрыЗаполнения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	НачислениеСписаниеРезервовОбъект = Неопределено;
	ДополнительныеСвойства.Свойство("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект);
	
	Если НачислениеСписаниеРезервовОбъект = Неопределено Тогда
		ТаблицаРезервов = ЭтотОбъект.НачислениеСписаниеРезервов.Партии.ВыгрузитьКолонки();
	Иначе
		ТаблицаРезервов = ДополнительныеСвойства.НачислениеСписаниеРезервов.Партии.Выгрузить();
	КонецЕсли;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ТаблицаРезервов, 
		"_ТаблицаРезервов", 
		Запрос,, 
		"Актив, АналитикаРезерва, СуммаРезерваПартии");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Актив КАК Актив,
		|	ВложенныйЗапрос.АналитикаРезерва КАК АналитикаРезерва,
		|	СУММА(ВложенныйЗапрос.СуммаРезерваПартии) КАК СуммаРезерваПартии
		|ИЗ
		|	(ВЫБРАТЬ
		|		РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК Актив,
		|		РезервыПредстоящихРасходовОстатки.Резерв КАК АналитикаРезерва,
		|		РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК СуммаРезерваПартии
		|	ИЗ
		|		РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|				&ПериодГраница,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РезервыПредстоящихРасходовОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаРезервов КАК _ТаблицаРезервов
		|			ПО РезервыПредстоящихРасходовОстатки.СубъектАналитики = _ТаблицаРезервов.Актив
		|				И РезервыПредстоящихРасходовОстатки.Резерв = _ТаблицаРезервов.АналитикаРезерва
		|	ГДЕ
		|		_ТаблицаРезервов.СуммаРезерваПартии ЕСТЬ NULL
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ТаблицаРезервов.Актив,
		|		_ТаблицаРезервов.АналитикаРезерва,
		|		_ТаблицаРезервов.СуммаРезерваПартии
		|	ИЗ
		|		_ТаблицаРезервов КАК _ТаблицаРезервов
		|	ГДЕ
		|		ТИПЗНАЧЕНИЯ(_ТаблицаРезервов.Актив) <> ТИП(Справочник.Облигации)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Актив,
		|	ВложенныйЗапрос.АналитикаРезерва
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВложенныйЗапрос.СуммаРезерваПартии) <> 0";
	
	Запрос.УстановитьПараметр("ПериодГраница", Новый Граница(КонецДня(ПараметрыЗаполнения.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыЗаполнения.СчетДоверительногоУправления);
	
	ТаблицаРезервов = Запрос.Выполнить().Выгрузить();
		
	Если ТаблицаРезервов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПрочиеАктивы 				= ЭтотОбъект.АктивыНеОтносящиесяКЦеннымБумагам;
	ВидЗадолженностиРЕПО		= Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО;
	ВидЗадолженностиПоДепозиту  = Справочники.ВидыЗадолженности.ПоДепозитномуВкладу;
	
	ВидЗадолженностиПогашениеОблигации			= Справочники.ВидыЗадолженности.ПоПогашениюОблигации;
	ВидЗадолженностиПоследнееПогашениеОблигации	= Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации;
	
	ВидЗадолженностиНачислениеДивидендов		= Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции;
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
	
	// Строк с резервами мало, проще заполнить через НайтиСроки
	Для Каждого СтрокаРезервов Из ТаблицаРезервов Цикл
	
		Если ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			
			ПараметрыОтбора = Новый Структура("Основание, ВидЗадолженности", СтрокаРезервов.Актив, ВидЗадолженностиРЕПО);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
			
		ИначеЕсли ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
			
			ПараметрыОтбора = Новый Структура("Основание", СтрокаРезервов.Актив);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
			
		ИначеЕсли ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
			
			ПараметрыОтбора = Новый Структура("Основание, ВидЗадолженности", СтрокаРезервов.Актив, ВидЗадолженностиНачислениеДивидендов);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);	
			
		ИначеЕсли ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
			
			// Для облигаций отдельные условия
			РеквизитыПогашения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаРезервов.Актив, "ВидПогашения, ЦеннаяБумага");
			Если ТипЗнч(РеквизитыПогашения.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
							
				// Сначала найдем строки по основанию. Если одна, то дальше можно не искать
				ПараметрыОтбора = Новый Структура("Основание", СтрокаРезервов.Актив);
				НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
				
				Если НайденныеСтроки.Количество() > 1 Тогда
					ПараметрыОтбора = Новый Структура("Основание, ВидЗадолженности",
						СтрокаРезервов.Актив, 
						?(РеквизитыПогашения.ВидПогашения = Перечисления.ВидыПогашения.ПолноеПогашение
							Или РеквизитыПогашения.ВидПогашения = Перечисления.ВидыПогашения.Оферта,
							ВидЗадолженностиПоследнееПогашениеОблигации,
							ВидЗадолженностиПогашениеОблигации));
					НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
				КонецЕсли;				
					
			Иначе
				
				ПараметрыОтбора = Новый Структура("Основание", СтрокаРезервов.Актив);
				НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
				
			КонецЕсли; 
			
		ИначеЕсли ТипЗнч(СтрокаРезервов.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			
			ПараметрыОтбора = Новый Структура("СубъектАналитики, ВидЗадолженности", СтрокаРезервов.Актив, ВидЗадолженностиПоДепозиту);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
			
		ИначеЕсли ТипЗнч(СтрокаРезервов.Актив) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
			
			ПараметрыОтбора = Новый Структура("СубъектАналитики, ВалютаСтроки", СтрокаРезервов.Актив, ВалютаУчета);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора); 
			
		Иначе
			
			ПараметрыОтбора = Новый Структура("СубъектАналитики", СтрокаРезервов.Актив);
			НайденныеСтроки = ПрочиеАктивы.НайтиСтроки(ПараметрыОтбора);
			
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() = 0 И ПараметрыЗаполнения.ВключатьВСЧАРезервыПоОтсутствующимАктивам
			И ТипЗнч(СтрокаРезервов.Актив) <> Тип("СправочникСсылка.Облигации") Тогда
			
			// Добавляем в зависимости от даты изменения подхода к списанию резервов и даты актива (актуально для отдельных методик и видов активов)
			ДатаНачалаСписанияРезервовПредстоящихРасходовДокументом = РаботаСДокументами.ДатаНачалаСписанияРезервовПредстоящихРасходовРегламентнымДокументом();
			Если ЭтотОбъект.Дата < ДатаНачалаСписанияРезервовПредстоящихРасходовДокументом 
				Или (ЭтотОбъект.Дата >= ДатаНачалаСписанияРезервовПредстоящихРасходовДокументом
					И (ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.МНО")
						Или ТипЗнч(СтрокаРезервов.Актив) = Тип("ДокументСсылка.СделкаСМО")) 
					И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРезервов.Актив, "Дата") >= НачалоДня(ЭтотОбъект.Дата)) Тогда
				
				СтрокаПрочиеАктивы = ПрочиеАктивы.Добавить();
				СтрокаПрочиеАктивы.Примечание = "Резерв под обесценение";
				СтрокаПрочиеАктивы.ВалютаСтроки = ВалютаУчета;
				СтрокаПрочиеАктивы.СубъектАналитики = СтрокаРезервов.Актив;
				СтрокаПрочиеАктивы.ВидАктива = Перечисления.ВидыАктивов.КредиторскаяЗадолженность;
				СтрокаПрочиеАктивы.Основание = СтрокаРезервов.Актив;
				СтрокаПрочиеАктивы.ВидЗадолженности = СтрокаРезервов.АналитикаРезерва;				
			Иначе
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			
			СтрокаПрочиеАктивы = НайденныеСтроки[0];
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокаПрочиеАктивы.СуммаРезерваВВалютеУчета = СтрокаРезервов.СуммаРезерваПартии;
		СтрокаПрочиеАктивы.СуммаРынокВВалютеУчета = СтрокаПрочиеАктивы.СуммаРынокВВалютеУчета - СтрокаПрочиеАктивы.СуммаРезерваВВалютеУчета;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДатуЗапретаРедактированияПартий()

	ЗапросДатыЗапрета = Новый Запрос;
	ЗапросДатыЗапрета.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
		|	И ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)";

	ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);

	Выборка = ЗапросДатыЗапрета.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ДатаЗапретаРедактированияПартий = Выборка.ДатаЗапретаРедактирования;
	Иначе
		ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
	КонецЕсли;

	Возврат ДатаЗапретаРедактированияПартий;

КонецФункции

#КонецОбласти
