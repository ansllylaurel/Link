
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.КорзинаЦенныхБумаг = Истина; // в этом документе всегда вкл. корзина ц/б
	
	ПриЧтенииСозданииНаСервере();
		
КонецПроцедуры                              

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьПодтверждениеОперацииНаСервере();
	
	Если Не Объект.РегистрацияСтоимости.Пустая() Тогда
		ЗначениеВРеквизитФормы(Объект.РегистрацияСтоимости.ПолучитьОбъект(), "РегистрацияСтоимости");
	КонецЕсли; 	
	
	Если Не Объект.НачислениеРезервовПИФ.Пустая() Тогда
		ЗначениеВРеквизитФормы(Объект.НачислениеРезервовПИФ.ПолучитьОбъект(), "НачислениеРезервовПИФ");
	КонецЕсли;
	
	Если Не Объект.НачислениеСписаниеРезервов.Пустая() Тогда
		ЗначениеВРеквизитФормы(Объект.НачислениеСписаниеРезервов.ПолучитьОбъект(), "НачислениеСписаниеРезервов");
	КонецЕсли;
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьРегистрациюСтоимости(Отказ, ТекущийОбъект);
	ЗаполнитьНачислениеСписаниеРезервов(Отказ, ТекущийОбъект);
	
	Если ЭтаФорма.ЭтоПИФ Тогда
		ЗаполнитьНачислениеРезервов(Отказ, ТекущийОбъект);
	ИначеЕсли Не Объект.НачислениеРезервовПИФ.Пустая() Тогда 
		НачислениеРезервовОбъект = РеквизитФормыВЗначение("НачислениеРезервовПИФ");
		НачислениеРезервовОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРегистрациюСтоимости(Отказ, ТекущийОбъект)

	РегистрацияСтоимостиОбъект = РеквизитФормыВЗначение("РегистрацияСтоимости");
	
	ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиОбъект, Объект, "Дата, Организация, СчетДоверительногоУправления, ПометкаУдаления");
	РегистрацияСтоимостиОбъект.ЦельРасчета		= Объект.ЦельРасчетаСтоимостиОценки;
	РегистрацияСтоимостиОбъект.ВидУчета			= ЭтаФорма.ВидУчета;
	РегистрацияСтоимостиОбъект.Ответственный 	= РаботаСПользователями.ТекущийПользователь();
		
	ТекущийОбъект.ДополнительныеСвойства.Вставить("РегистрацияСтоимости", РегистрацияСтоимостиОбъект);
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьНачислениеРезервов(Отказ, ТекущийОбъект)

	НачислениеРезервовОбъект = РеквизитФормыВЗначение("НачислениеРезервовПИФ");
	
	ЗаполнитьЗначенияСвойств(НачислениеРезервовОбъект, Объект, "Дата, Организация, СчетДоверительногоУправления, ПометкаУдаления");
	НачислениеРезервовОбъект.ПаевойИнвестиционныйФонд 	= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления, Объект.Дата);
	НачислениеРезервовОбъект.Ответственный 				= РаботаСПользователями.ТекущийПользователь();
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("НачислениеРезервовПИФ", НачислениеРезервовОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачислениеСписаниеРезервов(Отказ, ТекущийОбъект)

	НачислениеСписаниеРезервовОбъект = РеквизитФормыВЗначение("НачислениеСписаниеРезервов");
	
	ЗаполнитьЗначенияСвойств(НачислениеСписаниеРезервовОбъект, Объект, "Дата, Организация, СчетДоверительногоУправления, ПометкаУдаления");
	НачислениеСписаниеРезервовОбъект.ЦельРасчета = Объект.ЦельРасчетаСтоимостиОценки;
	НачислениеСписаниеРезервовОбъект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("НачислениеСписаниеРезервов", НачислениеСписаниеРезервовОбъект);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ЗаполнитьИтогиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
