&НаКлиенте
Процедура РучнойВводПриИзменении(Элемент)
	
	Если Объект.РучнойВвод Тогда
		// разрешаем редактирование
		НастроитьВидимостьИДоступность(ЭтаФорма);
	Иначе
		// спросим о перезаполнении, в случае отказа вернем ружной ввод
		ТекстВопроса = "Документ будет перезаполнен, все внесенные изменения будут утеряны. Продолжить?";
		ПоказатьВопрос(Новый ОписаниеОповещения("РучнойВводПриИзмененииЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет,,, "Внимание!"); 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РучнойВводПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		// запрещаем редактирование
		НастроитьВидимостьИДоступность(ЭтаФорма);
		// заполняем
		ЗаполнитьАдресФайлаXML();
		ЗаполнитьНаСервере();
	Иначе
		Объект.РучнойВвод = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ЗаполнитьПриИзмененииРеквизитовШапки();
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

