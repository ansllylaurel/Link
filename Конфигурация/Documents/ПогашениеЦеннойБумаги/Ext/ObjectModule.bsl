				// переоценка
				БалансоваяПереоценка = ВыборкаДетальныеЗаписи.Переоценка;
				БалансоваяПереоценкаВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
				
				ПараметрыНачисления.Вставить("Сумма",				-ВыборкаДетальныеЗаписи.Переоценка);
				ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	-ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
				ПараметрыНачисления.Вставить("СуммаСНачалаГода",	-ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода);
