	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		ПроведениеПоРегиструЕПСПогашениеСПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, Отказ);
		Возврат;
	
	КонецЕсли;
	
	
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
