				ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
				
				ПараметрыНачисления.Вставить("СуммаСНачалаГодаНачальная",	-ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода);
				ПараметрыНачисления.Вставить("СуммаСНачалаГодаКонечная",	ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета-ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода);
				
