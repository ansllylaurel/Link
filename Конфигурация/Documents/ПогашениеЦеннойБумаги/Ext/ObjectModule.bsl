					ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", УчетныйАктив.СчетУчетаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("ГФУПарный",		УчетныйАктив.АналитикаДоходовОтПереоценки);
				КонецЕсли;
					
				БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли НастройкиУчета.СписыватьПриПолномПогашенииВМоментПогашения Тогда // спишем, раз такая настройка
		БухгалтерскийУчетЕПС.СформироватьПроводкиСписанияЦеннойБумагиСПартиямиНаЛицевыхСчетах(УчетныйРегистр, ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПСПогашение(УчетныйРегистр, Отказ)

	// Только начисляем, ничего не гасим. Такое вот погашение!
	
