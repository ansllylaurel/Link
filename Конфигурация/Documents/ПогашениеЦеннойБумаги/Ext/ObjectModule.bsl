КонецПроцедуры

Процедура ПроведениеПоРегиструЕПСЧастичноеПогашение(УчетныйРегистр, Отказ)

	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаДисконта = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаПремии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаДебиторкиПоТелу = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
	
	Облигация = ЭтотОбъект.ЦеннаяБумага;
	ВалютаНоминала = Облигация.ВалютаНоминала;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		ПроведениеПоРегиструЕПСЧастичноеПогашениеСПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, Отказ);
		Возврат;
	
	КонецЕсли;
	
	// читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|		И БухПартииЦенныхБумаг.КорректировкаЭСП = 0
		|		И БухПартииЦенныхБумаг.ДисконтПремияНачисленный = 0
		|		И БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0 КАК Перекурсовка,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток < 0 КАК Дисконт
		|ПОМЕСТИТЬ _ОстаткиПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДоДокумента,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ВидУчета = &ВидУчета
		|				И (ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии) В
		|					(ВЫБРАТЬ
		|						_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|						_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|						_ДвиженияПартий.Партия КАК Партия,
		|						_ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
		|					ИЗ
		|						_ДвиженияПартий КАК _ДвиженияПартий)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт КАК Дисконт,
		|	_ДвиженияПартий.Перекурсовка КАК Перекурсовка,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(_ДвиженияПартий.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(_ДвиженияПартий.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(_ОстаткиПартий.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(_ОстаткиПартий.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(_ОстаткиПартий.КорректировкаЭСПОстаток) КАК КорректировкаЭСПОстаток,
		|	СУММА(_ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартий.УчетныйАктивЕПС
		|			И _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ДвиженияПартий.Партия = _ОстаткиПартий.Партия
		|			И _ДвиженияПартий.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияПартий.УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт,
		|	_ДвиженияПартий.Перекурсовка";

	Запрос.УстановитьПараметр("ВидУчета",						Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Регистратор",					ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ДоДокумента",    Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",    ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",    ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));

	РезультатЗапроса = Запрос.Выполнить();
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	БухПартииЦенныхБумаг = РезультатЗапроса.Выгрузить();
	
	МассивУчетныхАктивов = Новый Массив;
	
	Для Каждого СтрокаПартии Из БухПартииЦенныхБумаг Цикл
		УчетныйАктив = СтрокаПартии.УчетныйАктивЕПС;
		
		Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(УчетныйАктив);
		КонецЕсли;
		
		Если  СтрокаПартии.Перекурсовка Тогда
			
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
				+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, "
				+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
				СтрокаПартии.ЦеннаяБумага, УчетныйАктив,
				СтрокаПартии.СтоимостьВВалютеУчета, СтрокаПартии.СтоимостьКупонаВВалютеУчета, СтрокаПартии.ПереоценкаВВалютеУчета, СтрокаПартии.ПереоценкаКупонаВВалютеУчета,
				СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.КорректировкаЭСПВВалютеУчета, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
				СтрокаПартии.ДисконтПремияНачисленныйОстаток,СтрокаПартии.ПереоценкаОстаток,СтрокаПартии.КорректировкаЭСПОстаток,СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
				
			БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);	
			
		Иначе
			
			// Дооцениваем купон
			Если СтрокаПартии.ПереоценкаКупона<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Аналитика",
					СтрокаПартии.ПереоценкаКупона, СтрокаПартии.ПереоценкаКупонаВВалютеУчета, ВалютаУчета, УчетныйАктив, Облигация, ВалютаНоминала, АналитикаКупонНачисленный);
				БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			//дооценки перед расходом купона, дисконта и т.п.
			Если СтрокаПартии.ДисконтПремияНачисленный<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
					СтрокаПартии.ДисконтПремияНачисленный, СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, ВалютаУчета, УчетныйАктив, Облигация, ВалютаНоминала);
				ПараметрыНачисления.Вставить("Аналитика", ?(СтрокаПартии.ДисконтПремияНачисленный<0, АналитикаПремии, АналитикаДисконта));
				БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			
			Если СтрокаПартии.КорректировкаЭСП<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"КорректировкаЭСП", СтрокаПартии.КорректировкаЭСП, СтрокаПартии.КорректировкаЭСПвВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, Облигация, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);

			КонецЕсли;
			
			Если СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"РазницаПервоначальногоПризнания", СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, Облигация, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Ложь, Истина, Облигация, Отказ);
	
	СуммаНаОднуОблигацию = ЭтотОбъект.Сумма / ЭтотОбъект.Количество;
	
	// читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
		|ПОМЕСТИТЬ ДвиженияСписанияПоВидуАктивов
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумагОстатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиКоличествоПоВидуАктивов
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДвиженияСписанияПоВидуАктивов.Стоимость КАК Стоимость,
		|	ДвиженияСписанияПоВидуАктивов.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	ДвиженияСписанияПоВидуАктивов.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ОстаткиКоличествоПоВидуАктивов.КоличествоОстаток КАК КоличествоОстаток,
		|	ДвиженияСписанияПоВидуАктивов.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	ДвиженияСписанияПоВидуАктивов.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	ДвиженияСписанияПоВидуАктивов.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	ДвиженияСписанияПоВидуАктивов.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
		|ИЗ
		|	ДвиженияСписанияПоВидуАктивов КАК ДвиженияСписанияПоВидуАктивов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиКоличествоПоВидуАктивов КАК ОстаткиКоличествоПоВидуАктивов
		|		ПО ДвиженияСписанияПоВидуАктивов.УчетныйАктивЕПС = ОстаткиКоличествоПоВидуАктивов.УчетныйАктивЕПС";

	Запрос.УстановитьПараметр("ВидУчета",						Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",							Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Регистратор",					ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ЦеннаяБумага",					Облигация);

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ЭтотОбъект.Ссылка,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Стоимость				= Выборка.Стоимость;
		СтоимостьВВалютеУчета	= Выборка.СтоимостьвВалютеУчета;
		Дисконт					= Выборка.ДисконтПремияНачисленный;
		ДисконтВВалютеУчета		= Выборка.ДисконтПремияНачисленныйВВалютеУчета;
		
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		
		УчетныйАктив	= Выборка.УчетныйАктивЕПС;
		
		// ***** СТОИМОСТЬ *****			
		Если Стоимость > 0 Тогда 
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СтоимостьВВалютеУчета, "Погашение облигации");
			
			// дебет
			Если НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = УчетныйАктив.СчетУчета;
				
				Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Стоимость;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоТелу;

			Иначе
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт  = Облигация.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Стоимость;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоТелу;
				
			КонецЕсли;
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчета;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
			
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = Стоимость;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
		
		КонецЕсли;
		
		// ***** ПРЕМИЯ *****
		Если Дисконт > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДисконтВВалютеУчета, "Погашение облигации");
			
			// дебет
			Если НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = УчетныйАктив.СчетУчета;
				
				Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Дисконт;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоТелу;

			Иначе	
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт  = Облигация.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = Дисконт;
							
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоТелу;
				
			КонецЕсли;

			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчета;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
			
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = Дисконт;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаДисконта;
		
		КонецЕсли;
		
		Если Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"РазницаПервоначальногоПризнания", -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныевВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, Облигация, ВалютаНоминала, Ссылка);
			БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
		КонецЕсли;
		
	КонецЦикла;

	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПСПогашениеСПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, Отказ)

	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	// проверяем было ли списание с счета ДЕПО и оплата долга за погашение
	НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности =  БухгалтерскийУчетЕПС.НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности(ЭтотОбъект.Ссылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаНачисление.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПереоценкаНачисление.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ПереоценкаНачисление.УчетныйАктивЕПС.СчетУчетаПереоценкиА КАК СчетУчетаПереоценкиА,
		|	ПереоценкаНачисление.УчетныйАктивЕПС.СчетУчетаПереоценкиП КАК СчетУчетаПереоценкиП,
		|	ПереоценкаНачисление.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки,
		|	ПереоценкаНачисление.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки КАК АналитикаРасходовОтПереоценки,
		|	ПереоценкаНачисление.Партия КАК Партия,
		|	ПереоценкаНачисление.СтрокаПартии КАК СтрокаПартии,
		|	ПереоценкаНачисление.Переоценка КАК Переоценка,
		|	ПереоценкаНачисление.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	ПереоценкаНачисление.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода,
		|	ПереоценкаНачисление.ПереоценкаКупона КАК ПереоценкаКупонаПартииПриход,
		|	ПереоценкаНачисление.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчетаПартииПриход,
		|	ПереоценкаНачисление.ДисконтПремияНачисленный КАК ДисконтПремияНачисленныйПартииПриход,
		|	ПереоценкаНачисление.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчетаПартииПриход,
		|	ПереоценкаНачисление.КорректировкаЭСП КАК КорректировкаЭСППартииПриход,
		|	ПереоценкаНачисление.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчетаПартииПриход,
		|	ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеПартииПриход,
		|	ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаПартииПриход,
		|	ЕСТЬNULL(Перекурсовка.СтоимостьВВалютеУчета, 0) КАК СтоимостьПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.СтоимостьКупонаВВалютеУчета, 0) КАК СтоимостьКупонаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ПереоценкаВВалютеУчета, 0) КАК ПереоценкаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ПереоценкаКупонаВВалютеУчета, 0) КАК ПереоценкаКупонаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ДисконтПремияНачисленныйВВалютеУчета, 0) КАК ДисконтПремияНачисленныйПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.КорректировкаЭСПВВалютеУчета, 0) КАК КорректировкаЭСППерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, 0) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеПерекурсовка,
		|	Остатки.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупки,
		|	Остатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	Остатки.КорректировкаЭСПВВалютеУчетаОстаток КАК КорректировкаЭСПВВалютеУчетаОстаток,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	Остатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГодаОстаток,
		|	Остатки.РазницаПервоначальногоПризнанияСНачалаГодаОстаток КАК РазницаПервоначальногоПризнанияСНачалаГодаОстаток,
		|	Остатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	Остатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчетаОстаток,
		|	Остатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток,
		|	Остатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупонаОстаток,
		|	Остатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчетаОстаток,
		|	Остатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчетаОстаток,
		|	Остатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК ПереоценкаНачисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК Перекурсовка
		|		ПО ПереоценкаНачисление.Регистратор = Перекурсовка.Регистратор
		|			И ПереоценкаНачисление.ВидУчета = Перекурсовка.ВидУчета
		|			И ПереоценкаНачисление.ЦеннаяБумага = Перекурсовка.ЦеннаяБумага
		|			И ПереоценкаНачисление.Партия = Перекурсовка.Партия
		|			И ПереоценкаНачисление.СтрокаПартии = Перекурсовка.СтрокаПартии
		|			И (Перекурсовка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (Перекурсовка.ПереоценкаКупона = 0)
		|			И (Перекурсовка.ДисконтПремияНачисленный = 0)
		|			И (Перекурсовка.КорректировкаЭСП = 0)
		|			И (Перекурсовка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага = &ЦеннаяБумага) КАК Остатки
		|		ПО ПереоценкаНачисление.Партия = Остатки.Партия
		|			И ПереоценкаНачисление.СтрокаПартии = Остатки.СтрокаПартии
		|ГДЕ
		|	ПереоценкаНачисление.Регистратор = &Ссылка
		|	И ПереоценкаНачисление.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И ПереоценкаНачисление.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И (ПереоценкаНачисление.ПереоценкаКупона <> 0
		|			ИЛИ ПереоценкаНачисление.ДисконтПремияНачисленный <> 0
		|			ИЛИ ПереоценкаНачисление.КорректировкаЭСП <> 0
		|			ИЛИ ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0)";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	
	ПараметрыНачисления = Новый Структура;
	
	ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
	
	ПараметрыНачисления.Вставить("ЦеннаяБумага",	ЭтотОбъект.ЦеннаяБумага);
	ПараметрыНачисления.Вставить("ВалютаНоминала",	ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		// 1 Начислим %ные доходы
		ПараметрыНачисления.Вставить("Партия",			ВыборкаДетальныеЗаписи.Партия);
		ПараметрыНачисления.Вставить("СтрокаПартии",	ВыборкаДетальныеЗаписи.СтрокаПартии);
		ПараметрыНачисления.Вставить("Количество",		0);
		ПараметрыНачисления.Вставить("ПроверитьПарные",	"");
		
		// дисконт-премия	
		ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйПартииПриход);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчетаПартииПриход);
		
		ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчета);
		Если ВыборкаДетальныеЗаписи.ДисконтПремияПокупки > 0 Тогда
			ПараметрыНачисления.Вставить("Содержание",			"Списание премии");
			ПараметрыНачисления.Вставить("Аналитика",			АналитикаПремии);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы04);
			ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.АналитикаСписанияПремии);
		Иначе
			ПараметрыНачисления.Вставить("Содержание",			"Начисление дисконта");
			ПараметрыНачисления.Вставить("Аналитика",			АналитикаДисконта);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы01);
			ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.АналитикаПроцентныхДоходов);
		КонецЕсли;
		
		БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
		
		// ННКД	
		ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ПереоценкаКупонаПартииПриход);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчетаПартииПриход);
		
		ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчета);
		ПараметрыНачисления.Вставить("Содержание",			"Переоценка купона");
		ПараметрыНачисления.Вставить("Аналитика",			АналитикаКупонНачисленный);
		ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
		ПараметрыНачисления.Вставить("ГФУ",				ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.АналитикаПроцентныхДоходов);
		
		БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
		
		Если НастройкиУчета.ПереоцениватьОблигацииПриПолномПогашении Тогда
		
			// переоценка
			БалансоваяПереоценка = ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
			БалансоваяПереоценкаВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаОстаток;
			
			ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.Переоценка);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаСНачалаГода",	ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаОстаток + ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
			ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
			ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
			
			ПараметрыНачисления.Вставить("Содержание",			"Переоценка");
			ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
			
			ПараметрыНачисления.Вставить("ПроверитьПарные",		"Переоценка");
			
			Если (БалансоваяПереоценкаВВалютеУчета > 0)ИЛИ(БалансоваяПереоценкаВВалютеУчета = 0 И ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета > 0) Тогда
				ПараметрыНачисления.Вставить("СчетУчета",		ВыборкаДетальныеЗаписи.СчетУчетаПереоценкиА);
