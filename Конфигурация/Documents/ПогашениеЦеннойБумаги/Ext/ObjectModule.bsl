		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.Переоценка = 0
		|		И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|		И БухПартииЦенныхБумаг.КорректировкаЭСП = 0
		|		И БухПартииЦенныхБумаг.ДисконтПремияНачисленный = 0
		|		И БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0 КАК Перекурсовка,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.Переоценка КАК Переоценка,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.ИндексацияНоминала КАК ИндексацияНоминала
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток < 0 КАК Дисконт,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК ИндексацияНоминалаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчетаОстаток
		|ПОМЕСТИТЬ _ОстаткиПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДоДокумента,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И ВидУчета = &ВидУчета
		|				И (ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии) В
		|					(ВЫБРАТЬ
		|						_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|						_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|						_ДвиженияПартий.Партия КАК Партия,
		|						_ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
		|					ИЗ
		|						_ДвиженияПартий КАК _ДвиженияПартий)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт КАК Дисконт,
		|	_ДвиженияПартий.Перекурсовка КАК Перекурсовка,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(_ДвиженияПартий.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(_ДвиженияПартий.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(_ОстаткиПартий.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(_ОстаткиПартий.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(_ОстаткиПартий.КорректировкаЭСПОстаток) КАК КорректировкаЭСПОстаток,
		|	СУММА(_ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(_ДвиженияПартий.Переоценка) КАК Переоценка,
		|	СУММА(_ДвиженияПартий.ИндексацияНоминала) КАК ИндексацияНоминала,
		|	СУММА(_ОстаткиПартий.ИндексацияНоминалаОстаток) КАК ИндексацияНоминалаОстаток,
		|	СУММА(_ОстаткиПартий.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
		|	СУММА(_ОстаткиПартий.ПереоценкаКупонаВВалютеУчетаОстаток) КАК ПереоценкаКупонаВВалютеУчетаОстаток,
		|	СУММА(_ОстаткиПартий.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток,
		|	СУММА(_ОстаткиПартий.СтоимостьКупонаВВалютеУчетаОстаток) КАК СтоимостьКупонаВВалютеУчетаОстаток
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартий.УчетныйАктивЕПС
		|			И _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ДвиженияПартий.Партия = _ОстаткиПартий.Партия
		|			И _ДвиженияПартий.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияПартий.УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ОстаткиПартий.Дисконт,
		|	_ДвиженияПартий.Перекурсовка";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("ДоДокумента",    Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",    ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",    ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() 
		И НЕ НастройкиУчета.УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу 
		И НЕ НастройкиУчета.СписыватьПриПолномПогашенииВМоментПогашения Тогда
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ЭтотОбъект,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
	БухПартииЦенныхБумаг = РезультатЗапроса.Выгрузить();
	
	МассивУчетныхАктивов = Новый Массив;
	
	ПереоценкаКупонаОстаток = 0;
	ПереоценкаКупонаВВалютеУчетаОстаток = 0;
	СтоимостьКупонаОстаток = 0;
	СтоимостьКупонаВВалютеУчетаОстаток = 0;
	
	Для Каждого СтрокаПартии Из БухПартииЦенныхБумаг Цикл
		УчетныйАктив = СтрокаПартии.УчетныйАктивЕПС;
		
		Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(УчетныйАктив);
		КонецЕсли;
		
		Если СтрокаПартии.Перекурсовка Тогда
			
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
				+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, "
				+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
				СтрокаПартии.ЦеннаяБумага, УчетныйАктив,
				СтрокаПартии.СтоимостьВВалютеУчета, СтрокаПартии.СтоимостьКупонаВВалютеУчета, СтрокаПартии.ПереоценкаВВалютеУчета, СтрокаПартии.ПереоценкаКупонаВВалютеУчета,
				СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.КорректировкаЭСПВВалютеУчета, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
				СтрокаПартии.ДисконтПремияНачисленныйОстаток,СтрокаПартии.ПереоценкаОстаток,СтрокаПартии.КорректировкаЭСПОстаток,СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
				
			БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);	
			
		Иначе
			
			Если НастройкиУчета.ПереоцениватьОблигацииПриПолномПогашении И СтрокаПартии.Переоценка<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"Переоценка", СтрокаПартии.Переоценка, СтрокаПартии.ПереоценкаВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, СтрокаПартии.ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
			
			// Дооцениваем купон
			Если СтрокаПартии.ПереоценкаКупона <> 0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Аналитика",
					СтрокаПартии.ПереоценкаКупонаВВалютеУчета, СтрокаПартии.ПереоценкаКупона, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, АналитикаКупонНачисленный);
				БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			//дооценки перед расходом купона, дисконта и т.п.
			Если СтрокаПартии.ДисконтПремияНачисленный<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
					СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.ДисконтПремияНачисленный, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала);
				ПараметрыНачисления.Вставить("Аналитика", ?(СтрокаПартии.ДисконтПремияНачисленный<0, АналитикаПремии, АналитикаДисконта));
				БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			
			Если СтрокаПартии.КорректировкаЭСП<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"КорректировкаЭСП", СтрокаПартии.КорректировкаЭСПВВалютеУчета, СтрокаПартии.КорректировкаЭСП,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
				
			КонецЕсли;
			
			Если СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"РазницаПервоначальногоПризнания", СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
			
			Если СтрокаПартии.ИндексацияНоминала<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"ИндексацияНоминала", СтрокаПартии.ИндексацияНоминала, СтрокаПартии.ИндексацияНоминала,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
			
			ПереоценкаКупонаОстаток = ПереоценкаКупонаОстаток + СтрокаПартии.ПереоценкаКупонаОстаток + СтрокаПартии.ПереоценкаКупона;
			ПереоценкаКупонаВВалютеУчетаОстаток = ПереоценкаКупонаВВалютеУчетаОстаток + СтрокаПартии.ПереоценкаКупонаВВалютеУчетаОстаток + СтрокаПартии.ПереоценкаКупонаВВалютеУчета;
			СтоимостьКупонаОстаток = СтоимостьКупонаОстаток + СтрокаПартии.СтоимостьКупонаОстаток;
			СтоимостьКупонаВВалютеУчетаОстаток = СтоимостьКупонаВВалютеУчетаОстаток + СтрокаПартии.СтоимостьКупонаВВалютеУчетаОстаток;
			
		КонецЕсли;	
			
	КонецЦикла;
	
	ЗакрыватьПереоценки = Ложь;
	Если НастройкиУчета.УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу Тогда // доводим до номинала, если сегодня не было ни 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|ГДЕ
			|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
			|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумаг.ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС";
		
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета <> 0 Тогда 
				
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
						"Переоценка",
						-ВыборкаДетальныеЗаписи.Переоценка,
						-ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета,
						ЭтотОбъект.Организация.ВалютаУчета,
						ВыборкаДетальныеЗаписи.УчетныйАктивЕПС,
						ЦеннаяБумага,
						ЦеннаяБумага.ВалютаНоминала,
						Неопределено);
						
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
				
				Если МассивУчетныхАктивов.Найти(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС) = Неопределено Тогда
					МассивУчетныхАктивов.Добавить(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС);
				КонецЕсли;
				
				ЗакрыватьПереоценки = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
	
	ИначеЕсли НастройкиУчета.СписыватьПриПолномПогашенииВМоментПогашения Тогда // спишем, раз такая настройка
		БухгалтерскийУчетЕПС.СформироватьПроводкиСписанияЦеннойБумаги(УчетныйРегистр, ЭтотОбъект, Отказ);
	КонецЕсли;
	
	// проверяем было ли списание с счета ДЕПО и оплата долга за погашение, если, конечно, это не клиент со списанием при погашении
	Если НЕ НастройкиУчета.СписыватьПриПолномПогашенииВМоментПогашения
		И БухгалтерскийУчетЕПС.НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности(ЭтотОбъект.Ссылка) Тогда
		// Бумаги и не списаны и не оплачены - перенесем НКД на аналитику по задолженности
		
		Контрагент = РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ЦеннаяБумага, Дата);
		
		Если ЗначениеЗаполнено(ПереоценкаКупонаОстаток) Или ЗначениеЗаполнено(ПереоценкаКупонаВВалютеУчетаОстаток) Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ПереоценкаКупонаВВалютеУчетаОстаток, "Задолженность по погашению купона");
			
			// дебет
			Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
			
				Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаДт  = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ПереоценкаКупонаОстаток;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			Иначе
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт  = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ПереоценкаКупонаОстаток;
								
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			КонецЕсли;
			
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаКт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = ПереоценкаКупонаОстаток;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтоимостьКупонаОстаток) Или ЗначениеЗаполнено(СтоимостьКупонаВВалютеУчетаОстаток) Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СтоимостьКупонаВВалютеУчетаОстаток, "Задолженность по погашению купона");
			
			// дебет
			Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
			
				Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаДт  = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = СтоимостьКупонаОстаток;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			Иначе
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт  = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = СтоимостьКупонаОстаток;
								
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаКт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = СтоимостьКупонаОстаток;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
			
		КонецЕсли;
		
		
	КонецЕсли;	
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, ЗакрыватьПереоценки, Истина, ЭтотОбъект.ЦеннаяБумага, Отказ);
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ЭтотОбъект.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
	
		ПроведениеПоРегиструЕПСЧастичноеПогашение(УчетныйРегистр, Отказ);
		
	Иначе
		
		ПроведениеПоРегиструЕПСПогашение(УчетныйРегистр, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	// Получение списка проводок вынесено в модуль менеджера
	НаборПроводок = Документы.ПогашениеЦеннойБумаги.ПодготовитьНаборПроводок(
		ЭтотОбъект.Ссылка, 
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		,
		УчетныйРегистр, 
		Отказ, Истина);
				
	Если Отказ ИЛИ НаборПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗПроводок = НаборПроводок.Выгрузить();
	ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Ссылка, "Регистратор");
	Движения[УчетныйРегистр].Загрузить(ТЗПроводок);  
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Количество, Сумма, СуммаКупона");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		ПроверяемыеРеквизиты.Добавить("ВидПогашения");
		ПроверяемыеРеквизиты.Добавить("ДатаФиксации");
	КонецЕсли;
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации и ВидПогашения = Перечисления.ВидыПогашения.Оферта Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияОферт.Облигация
			|ИЗ
			|	РегистрСведений.УсловияОферт КАК УсловияОферт
			|ГДЕ
			|	УсловияОферт.Облигация = &Облигация
			|	И УсловияОферт.ДатаВыкупа = &ДатаВыкупа";
		
		Запрос.УстановитьПараметр("ДатаВыкупа", НачалоДня(Дата));
		Запрос.УстановитьПараметр("Облигация", ЦеннаяБумага);
		
		РезультатЗапроса = Запрос.Выполнить();
			
		Если РезультатЗапроса.Пустой() Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru=""На дату документа " + Ссылка
			// пока у нас не все оферты
			//	+ " остутствуют условия оферт по облигации " + ЦеннаяБумага + """"),,,, Отказ);  
				+ " остутствуют условия оферт по облигации " + ЦеннаяБумага + """"), Ссылка,,, );
				
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
			Если ЭтотОбъект.Дата < ЭтотОбъект.ДатаФиксации Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа не может быть меньше даты фиксации!'"), ЭтотОбъект, "ДатаФиксации",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.СуммаКупона > 0 И ЭтотОбъект.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Сумма купона не может быть задана при частичном погашении облигации!'"), ЭтотОбъект, "ВидПогашения",, Отказ);
			КонецЕсли;

			ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект);
			
			Если ДетализацияПоРасчетномуСчету Тогда
				Если НЕ ЗначениеЗаполнено(РасчетныйСчет) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Расчетный счёт"" не заполнено'"), ЭтотОбъект, "РасчетныйСчет",, Отказ);			
				Иначе
					Если ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.ВалютаОплаты Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Валюта расчетного счета отличается от валюты оплаты!'"), ЭтотОбъект, "РасчетныйСчет",, Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ЭтотОбъект.ВидПогашения = Перечисления.ВидыПогашения.ЧастичноеПогашение И  НЕ ЭтотОбъект.ЦеннаяБумага.Амортизационная Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='При частичном погашении должна быть выбрана амортизационная облигация!'"), ЭтотОбъект, "ВидПогашения",, Отказ);
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Паи И ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Векселя И ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Недопустимое значение рынка ценных бумаг!'"), ЭтотОбъект, "Рынок",, Отказ);
			
		КонецЕсли;
		
		Если РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЭтотОбъект.ЦеннаяБумага) <> ЭтотОбъект.Рынок Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Рынок не соответствует ценной бумаге!'"), ЭтотОбъект, "Рынок",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	// неблокирующие проверки
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) И ЭтотОбъект.ВидПогашения = Перечисления.ВидыПогашения.ПолноеПогашение И НачалоДня(ЭтотОбъект.Дата) <> ЭтотОбъект.ЦеннаяБумага.ДатаПогашения Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа отличается от даты погашения облигации!'"), ЭтотОбъект, "Дата",,);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти 
