
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
		
	ПриЧтенииСозданииНаСервере();
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Паи") Тогда
		ЭтаФорма.ЮрФизЛицоУКПИФ = ПолучитьЮрФизЛицоУКПИФ(Объект.ЦеннаяБумага, Объект.Дата);
	КонецЕсли;
	
	РаботаСФормами.ЗаполнитьДополнительныеСвязиИПараметрыВыбора(Элементы.Договор, "СчетДоверительногоУправления,ДатаРасторжения");
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	Оповестить("СводноеПогашениеОблигации.Обновить", Объект.Ссылка);
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ОплатаЧерезБрокера = 1 Тогда
		ПроверяемыеРеквизиты.Добавить("Брокер");
	КонецЕсли;
	
	Если ЭтаФорма.ДетализацияПоРасчетномуСчету Тогда
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчет");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ШАПКИ_ФОРМЫ

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	Элементы.ЦеннаяБумага.ОграничениеТипа = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	
	ЗаполнитьСуммуНаОднуОблигацию(ЭтаФорма);
	
	Если Объект.Рынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
		Объект.СуммаКупона	= 0;
		Объект.ВидПогашения = ПредопределенноеЗначение("Перечисление.ВидыПогашения.ПолноеПогашение"); 
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеннаяБумагаПриИзменении(Элемент)
		
	ЭтаФорма.ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЦеннаяБумага, "ВалютаНоминала");
		
	Если Не ЗначениеЗаполнено(Объект.ВалютаОплаты) Тогда
		Объект.ВалютаОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЦеннаяБумага, "ВалютаНоминала");
	КонецЕсли;
	
	ПересчетСуммы();
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Паи") Тогда
		ЭтаФорма.ЮрФизЛицоУКПИФ = ПолучитьЮрФизЛицоУКПИФ(Объект.ЦеннаяБумага, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.ОплатаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	ПересчетСуммы();
		
КонецПроцедуры

&НаКлиенте
Процедура ВидПогашенияПриИзменении(Элемент)
	
	Если Объект.ВидПогашения = ПредопределенноеЗначение("Перечисление.ВидыПогашения.ЧастичноеПогашение") Тогда
		Объект.СуммаКупона = 0;
	КонецЕсли;
	
	ПересчетСуммы();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОплатаЧерезБрокераПриИзменении(Элемент)
		
	Если ЭтаФорма.ОплатаЧерезБрокера = 0 Тогда
		Объект.Брокер = Неопределено;
	КонецЕсли;
	
	Элементы.Брокер.Видимость = (ЭтаФорма.ОплатаЧерезБрокера = 1); 
	
	БрокерПриИзменении(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
КонецПроцедуры 

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	ПересчетСуммы();

КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	Если Объект.ВидПогашения = ПредопределенноеЗначение("Перечисление.ВидыПогашения.Оферта") Тогда
		ЭтаФорма.СуммаНаОднуОблигацию = ?(Объект.Количество > 0, Объект.Сумма / Объект.Количество, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.ЦеннаяБумага) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите ценную бумагу", Объект, "ЦеннаяБумага", "ЦеннаяБумага");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
	
		ВалютаРасчетногоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РасчетныйСчет, "Валюта");
		
		Если Объект.ВалютаОплаты <> ВалютаРасчетногоСчета Тогда
		
			Объект.ВалютаОплаты = ВалютаРасчетногоСчета;
		    ПересчетСуммы();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СверитьВыбранноеЗначениеВалютыСВалютойРасчетногоСчета(ВыбранноеЗначение, Объект.ВалютаОплаты, Объект.РасчетныйСчет);
	Если Объект.ВалютаОплаты <> ВыбранноеЗначение Тогда
		Объект.ВалютаОплаты = ВыбранноеЗначение;
		ПересчетСуммы();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоДенежнымСредствам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоДенежнымСредствам(ЭтаФорма, ЭтаФорма.ОплатаЧерезБрокера);
	РасчетныйСчетПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаРасчета(Команда)
	
	Если НЕ ТипЗнч(Объект.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета доступна только для облигаций");
		Возврат;
	КонецЕсли; 
	
	СписокПартий = ПолучитьСписокПартий(Объект.Ссылка, Объект.СчетДоверительногоУправления, Объект.Организация, Объект.ЦеннаяБумага);
	
	Если СписокПартий.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет движений по регистру ""Партии ценных бумаг""");
		Возврат;
	КонецЕсли;
	
	ЭлементСпискаПартий =  СписокПартий.ВыбратьЭлемент("Партия");
	
	Если ЭлементСпискаПартий <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
			|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, БалансовыйДисконт, Стоимость",
			Объект.Дата, 
			Объект.Организация, 
			Объект.СчетДоверительногоУправления, 
			ЭлементСпискаПартий.Значение.Количество, 
			0, // - купон уже погашен
			Объект.ЦеннаяБумага, 
			ЭлементСпискаПартий.Значение.Партия, 
			ЭлементСпискаПартий.Значение.СтрокаПартии,
			ЭлементСпискаПартий.Значение.УчетныйАктивЕПС,
			ЭлементСпискаПартий.Значение.БалансовыйДисконт,
			ЭлементСпискаПартий.Значение.Стоимость);
		ОткрытьФорму("Отчет.РасшифровкаРасчетаАмортизацииДисконтаПремииИКорректировкиПоЭСП.Форма.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокПартий(ПогашениеОблигации, СчетДоверительногоУправления, Организация, Облигация)
	
	СписокПартий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумагОстатки.КоличествоОстаток) КАК Количество,
		|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленный,
		|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток) КАК Стоимость
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага = &ЦеннаяБумага
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.СтрокаПартии,
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	Запрос.УстановитьПараметр("Регистратор", ПогашениеОблигации);
	Запрос.УстановитьПараметр("Период", Новый Граница(ПогашениеОблигации.МоментВремени(), ВидГраницы.Исключая));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокПартий.Добавить(
			Новый Структура("Партия, СтрокаПартии, УчетныйАктивЕПС, Количество, БалансовыйДисконт, Стоимость", 
				Выборка.Партия, Выборка.СтрокаПартии, Выборка.УчетныйАктивЕПС, Выборка.Количество, Выборка.ДисконтПремияНачисленный, Выборка.Стоимость),
			Строка(Выборка.Партия) + ". Строка партии:" +  Выборка.СтрокаПартии);
	КонецЦикла;
	
	Возврат СписокПартий;
	
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСуммуНаОднуОблигацию(Форма)
	
	Объект = Форма.Объект;
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
		Если Объект.ВидПогашения = ПредопределенноеЗначение("Перечисление.ВидыПогашения.Оферта") Тогда
			Если Форма.СуммаНаОднуОблигацию = 0 И Объект.Сумма > 0 И Объект.Количество > 0 Тогда // по оферте сумму вводится вручную; расчет нужен только при создании/чтении формы
				Форма.СуммаНаОднуОблигацию = Объект.Сумма / Объект.Количество;
			КонецЕсли;
		Иначе
			Форма.СуммаНаОднуОблигацию = ?(ЗначениеЗаполнено(Объект.Дата) И ЗначениеЗаполнено(Объект.ЦеннаяБумага), СуммаВЗависимостиОтВидаПогашения(Объект.ЦеннаяБумага, Объект.Дата, Объект.ВидПогашения), 0);
		КонецЕсли;
	Иначе
		Форма.СуммаНаОднуОблигацию = 0;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьСуммуНаОднуОблигацию

&НаКлиенте 
Процедура ПересчетСуммы()
	
	ЗаполнитьСуммуНаОднуОблигацию(ЭтаФорма);
		
	Объект.Сумма = РаботаСВалютами.ПересчетСуммыВВалюте(Объект.Количество * ЭтаФорма.СуммаНаОднуОблигацию, ВалютаНоминала, Объект.Дата, Объект.ВалютаОплаты, Объект.Дата);

КонецПроцедуры	

&НаСервереБезКонтекста 
Функция СуммаИзмененияНоминала(ДатаНоминала, ЦеннаяБумага)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумаг.СуммаИзменения
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|ГДЕ
		|	НоминалыЦенныхБумаг.Период = &ДатаНоминала
		|	И НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага";

	Запрос.УстановитьПараметр("ДатаНоминала", ДатаНоминала);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.СуммаИзменения;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции 

&НаСервереБезКонтекста
Функция СуммаВЗависимостиОтВидаПогашения(Облигация, Дата, ВидПогашения) 
	
	Если ВидПогашения = ПредопределенноеЗначение("Перечисление.ВидыПогашения.ЧастичноеПогашение") Тогда
		Возврат СуммаИзмененияНоминала(НачалоДня(Дата), Облигация);
	Иначе	
		Возврат РаботаСЦеннымиБумагами.ПолучитьНоминалИВалютуЦеннойБумаги(Облигация, НачалоДня(Дата)).Номинал;
	Конецесли;
	
КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;

	ЭтоРынокОблигаций	= (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"));
	ЭтоРынокПаев		= (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Паи"));
	
	Если ЭтоРынокОблигаций Тогда
		Элементы.ДатаФиксации.Видимость   			  = Истина;
		Элементы.ВидПогашения.Доступность   		  = Истина;
		Элементы.СуммаНаОднуОблигацию.Видимость       = Истина;
		Элементы.СуммаНаОднуОблигацию.ТолькоПросмотр  = (ДанныеОбъекта.ВидПогашения <> ПредопределенноеЗначение("Перечисление.ВидыПогашения.Оферта"));
		Элементы.СуммаКупона.Видимость                = (ДанныеОбъекта.ВидПогашения <> ПредопределенноеЗначение("Перечисление.ВидыПогашения.ЧастичноеПогашение"));
	Иначе
		Элементы.ДатаФиксации.Видимость   			  = Ложь;
		Элементы.ВидПогашения.Доступность   		  = Ложь;
		Элементы.СуммаНаОднуОблигацию.Видимость       = Ложь;
		Элементы.СуммаКупона.Видимость                = Ложь;
	КонецЕсли;	
	
	Элементы.ВидПогашения.Видимость = НЕ ЭтоРынокПаев;
	Элементы.Договор.Видимость 		= ЭтоРынокПаев;
	
	Элементы.Брокер.Видимость = (Форма.ОплатаЧерезБрокера = 1);
	
	// элементы, зависящие от детализации по р/с
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);

КонецПроцедуры 	

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Элементы.ЦеннаяБумага.ОграничениеТипа = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	
	ЗаполнитьСуммуНаОднуОблигацию(ЭтаФорма);
	
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	ЭтаФорма.ОплатаЧерезБрокера           = ?(ЗначениеЗаполнено(Объект.Брокер), 1, 0);

	Если ЗначениеЗаполнено(Объект.ЦеннаяБумага) Тогда
		ЭтаФорма.ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЦеннаяБумага, "ВалютаНоминала");
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);

КонецПроцедуры 	

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

