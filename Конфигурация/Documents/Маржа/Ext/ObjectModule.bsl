КонецПроцедуры // СформироватьДвиженияДенежныхСредств

Процедура СформироватьДвиженияПоОперациямСЦеннымиБумагами()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВариационнаяМаржа.Ссылка КАК Операция,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Сумма > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ВариационнаяМаржа.Организация,
		|	ВариационнаяМаржа.СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы) КАК Рынок,
		|	ВариационнаяМаржа.ВалютаОплаты КАК Валюта,
		|	МаржаИнструменты.Инструмент КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Сумма > 0
		|			ТОГДА МаржаИнструменты.Сумма
		|		ИНАЧЕ -МаржаИнструменты.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВариационнаяМаржа.Дата КАК ДатаОперации
		|ИЗ
		|	Документ.Маржа КАК ВариационнаяМаржа
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Маржа.Инструменты КАК МаржаИнструменты
		|		ПО (МаржаИнструменты.Ссылка = ВариационнаяМаржа.Ссылка)
		|ГДЕ
		|	ВариационнаяМаржа.Ссылка = &Ссылка
		|	И МаржаИнструменты.Сумма <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	МаржаИнструменты.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ОперацииСЦеннымиБумагами.Добавить(), Выборка);
	КонецЦикла;
		
КонецПроцедуры // СформироватьДвиженияПоОперациямСЦеннымиБумагами

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// остатки д/с
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                       ЭтотОбъект.Брокер);
	ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                ЭтотОбъект.МестоХранения);
	ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
	ЭлементБлокировкиДанных.УстановитьЗначение("Валюта",                       ЭтотОбъект.ВалютаОплаты);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОперацииСЦеннымиБумагами.Записывать         = НЕ ЭтотОбъект.РынокСПФИ;
	Движения.ОстаткиДенежныхСредств.Записывать           = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;

	СформироватьДвиженияПоЗадолженности();
	СформироватьДвиженияДенежныхСредств();
	Если НЕ ЭтотОбъект.РынокСПФИ Тогда
		СформироватьДвиженияПоОперациямСЦеннымиБумагами();
	КонецЕсли;
	
	Движения.Записать();
	
	Если НЕ ЭтотОбъект.ОтложеннаяОплата И ЭтотОбъект.Инструменты.Итог("Сумма") < 0 Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкуДвиженияДС(ПараметрыПроводки)

	//СПФИ, Контрагент, СчетДС, ВидСубконтоДС, СубконтоДС, СуммаДвиженияДС, Валюта, КоррСчет, ВидДвиженияДенежныхСредств, Описание
	
	Если ПараметрыПроводки.СуммаДвиженияДС > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		Проводка.СчетДт = ПараметрыПроводки.СчетДС;
		Проводка.СубконтоДт[ПараметрыПроводки.ВидСубконтоДС] = ПараметрыПроводки.СубконтоДС;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ПараметрыПроводки.ВидДвиженияДенежныхСредств;
						
		Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.СуммаДвиженияДС;
		
		
		Проводка.СчетКт = ПараметрыПроводки.КоррСчет;
		Проводка.СубконтоКт.Контрагенты = ПараметрыПроводки.Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыПроводки.СПФИ;
		
		Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.СуммаДвиженияДС;
		
		
	ИначеЕсли ПараметрыПроводки.СуммаДвиженияДС < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		Проводка.СчетДт = ПараметрыПроводки.КоррСчет;
		Проводка.СубконтоДт.Контрагенты = ПараметрыПроводки.Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыПроводки.СПФИ;
		
		Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаДт = -ПараметрыПроводки.СуммаДвиженияДС;
		
		
		Проводка.СчетКт = ПараметрыПроводки.СчетДС;
		Проводка.СубконтоКт[ПараметрыПроводки.ВидСубконтоДС] = ПараметрыПроводки.СубконтоДС;
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ПараметрыПроводки.ВидДвиженияДенежныхСредств;
						
		Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаКт = -ПараметрыПроводки.СуммаДвиженияДС;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(ВидУчета, Отказ) Экспорт

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	БиржаКонтрагент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ").ЮрФизЛицо;
	
	Если ЭтотОбъект.РынокСПФИ Тогда
		
		УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
		
		МассивУчетныхАктивов = Новый Массив;
		МассивУчетныхАктивов.Добавить(УчетныйАктивЕПС);
		
		МассивСПФИ = Новый Массив;
	
	КонецЕсли;
	
	
	Для каждого СтрокаИнструменты Из ЭтотОбъект.Инструменты Цикл
		
		Если ЭтотОбъект.РынокСПФИ Тогда
			
