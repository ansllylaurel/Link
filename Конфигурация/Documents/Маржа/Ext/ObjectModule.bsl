
Процедура СформироватьДвиженияПоЗадолженности()
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МаржаИнструменты.Ссылка.Дата КАК Период,
		|	МаржаИнструменты.Ссылка КАК Основание,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Сумма > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВариационнойМарже) КАК ВидЗадолженности,
		|	МаржаИнструменты.Ссылка.Организация КАК Организация,
		|	МаржаИнструменты.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МаржаИнструменты.Ссылка.ВалютаОплаты КАК Валюта,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Сумма > 0
		|			ТОГДА МаржаИнструменты.Сумма
		|		ИНАЧЕ -МаржаИнструменты.Сумма
		|	КОНЕЦ КАК Сумма,
		|	МаржаИнструменты.Ссылка.ОтложеннаяОплата КАК ОтложеннаяОплата
		|ПОМЕСТИТЬ ВТ_ВариационнаяМаржа
		|ИЗ
		|	Документ.Маржа.Инструменты КАК МаржаИнструменты
		|ГДЕ
		|	МаржаИнструменты.Ссылка = &Ссылка
		|	И МаржаИнструменты.Сумма <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	МаржаИнструменты.Ссылка.Дата,
		|	МаржаИнструменты.Ссылка,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Процент > 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	КОНЕЦ,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВариационнойМарже),
		|	МаржаИнструменты.Ссылка.Организация,
		|	МаржаИнструменты.Ссылка.СчетДоверительногоУправления,
		|	МаржаИнструменты.Ссылка.ВалютаОплаты,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Процент > 0
		|			ТОГДА МаржаИнструменты.Процент
		|		ИНАЧЕ -МаржаИнструменты.Процент
		|	КОНЕЦ,
		|	МаржаИнструменты.Ссылка.ОтложеннаяОплата
		|ИЗ
		|	Документ.Маржа.Инструменты КАК МаржаИнструменты
		|ГДЕ
		|	МаржаИнструменты.Ссылка = &Ссылка
		|	И МаржаИнструменты.Процент <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ВариационнаяМаржа.Период КАК Период,
		|	ВТ_ВариационнаяМаржа.Основание КАК Основание,
		|	ВТ_ВариационнаяМаржа.ТипЗадолженности КАК ТипЗадолженности,
		|	ВТ_ВариационнаяМаржа.ВидЗадолженности КАК ВидЗадолженности,
		|	ВТ_ВариационнаяМаржа.Организация КАК Организация,
		|	ВТ_ВариационнаяМаржа.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_ВариационнаяМаржа.Валюта КАК Валюта,
		|	ВТ_ВариационнаяМаржа.Сумма КАК Сумма,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения
		|ИЗ
		|	ВТ_ВариационнаяМаржа КАК ВТ_ВариационнаяМаржа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ВариационнаяМаржа.Период,
		|	ВТ_ВариационнаяМаржа.Основание,
		|	ВТ_ВариационнаяМаржа.ТипЗадолженности,
		|	ВТ_ВариационнаяМаржа.ВидЗадолженности,
		|	ВТ_ВариационнаяМаржа.Организация,
		|	ВТ_ВариационнаяМаржа.СчетДоверительногоУправления,
		|	ВТ_ВариационнаяМаржа.Валюта,
		|	ВТ_ВариационнаяМаржа.Сумма,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|ИЗ
		|	ВТ_ВариационнаяМаржа КАК ВТ_ВариационнаяМаржа
		|ГДЕ
		|	НЕ ВТ_ВариационнаяМаржа.ОтложеннаяОплата";
				
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтотОбъект.Движения.ЗадолженностиПоДенежнымСредствам.Добавить(), Выборка);
	КонецЦикла;

КонецПроцедуры // СформироватьДвиженияПоЗадолженности

Процедура СформироватьДвиженияДенежныхСредств()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МаржаИнструменты.Ссылка.Дата КАК Период,
		|	ВЫБОР
		|		КОГДА МаржаИнструменты.Сумма > 0
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
