Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(	ЭтотОбъект.Дата,
																		ЭтотОбъект.Организация,
																		ЭтотОбъект.СчетДоверительногоУправления,
																		ЭтотОбъект.ВалютаОплаты,
																		ЭтотОбъект.Брокер);
																		
	Если ЭтотОбъект.РынокСПФИ Тогда
		
	Иначе	
		ВариационнаяМаржаПрибыль	= ОбщегоНазначения.ПолучитьИменованныйОбъект("МаржаПрибыль");
		ВариационнаяМаржаУбыток		= ОбщегоНазначения.ПолучитьИменованныйОбъект("МаржаУбыток");
	КонецЕсли;
	
	
	ЕстьБрокер							= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено;
	ЕстьДоговорыБрокерскогоОбслуживания	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено;
	ЕстьВидДвиженияДС					= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено;
	ЕстьРасчетныйСчет                	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено;
	
	Если ЕстьДоговорыБрокерскогоОбслуживания Тогда
		ДоговорБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	КонецЕсли;
	
	
	ТаблицаЦБ = Новый ТаблицаЗначений;
	ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип); 
	Для Каждого СтрИнструменты Из ЭтотОбъект.Инструменты Цикл 
		НовСтрока = ТаблицаЦБ.Добавить();
		НовСтрока.ЦеннаяБумага = СтрИнструменты.Инструмент;
	КонецЦикла;	
		
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр, , ТаблицаЦБ);	
	
	Для Каждого СтрокаИнструменты Из ЭтотОбъект.Инструменты Цикл
		
		Если ЭтотОбъект.РынокСПФИ Тогда
			
			НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(СтрокаИнструменты.Инструмент, "ЦеннаяБумага");
			
			Если ЗначениеЗаполнено(НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ) Тогда
				ОбращаетсяНаОРЦБ = НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ.ОбращаетсяНаОРЦБ;
			Иначе
				ОбращаетсяНаОРЦБ = Ложь;
			КонецЕсли;
			
			СчетДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				ЭтотОбъект.ВалютаОплаты,
				ЭтотОбъект.Брокер);
				
			СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
			
			ПараметрыПроводкиДвиженияДС = Новый Структура();
			ПараметрыПроводкиДвиженияДС.Вставить("СПФИ", СтрокаИнструменты.Инструмент);
			ПараметрыПроводкиДвиженияДС.Вставить("Контрагент", СтрокаИнструменты.Инструмент.Контрагент);
			ПараметрыПроводкиДвиженияДС.Вставить("СчетДС", СчетДС);
			ПараметрыПроводкиДвиженияДС.Вставить("УчетныйРегистр", УчетныйРегистр);
			ПараметрыПроводкиДвиженияДС.Вставить("СубконтоДС", СубконтоДС);
			ПараметрыПроводкиДвиженияДС.Вставить("Валюта", ЭтотОбъект.ВалютаОплаты);
			
			СтоимостьСВОПа = ОпределитьNPV(СтрокаИнструменты.Инструмент, НачалоДня(ЭтотОбъект.Дата));
			
			ПараметрыПроводкиДвиженияДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.ВариационнаяМаржа);
			ПараметрыПроводкиДвиженияДС.Вставить("Описание", "Депозитная маржа");

			ДепозитнаяМаржаРасчеты = 0;
			ДепозитнаяМаржаПривлеченка = 0;
			
			Если СтрокаИнструменты.Сумма > 0 Тогда // нам пришла маржа - у нас появились привлеченные средства
				
				Если СтоимостьСВОПа <= 0 Тогда // сидим в минусах - корреспондируем с расчетами
				
					ДепозитнаяМаржаРасчеты = СтрокаИнструменты.Сумма;
					
				ИначеЕсли СтрокаИнструменты.Сумма >= СтоимостьСВОПа Тогда // приход маржи вывел NPV из минуса в плюс - часть с взаиморасчетов, часть с привлеченки
					
					ДепозитнаяМаржаРасчеты = СтрокаИнструменты.Сумма - СтоимостьСВОПа;
					ДепозитнаяМаржаПривлеченка = СтоимостьСВОПа;
					
				Иначе // мы в плюсах - все с привлеченки
					
					ДепозитнаяМаржаПривлеченка = СтрокаИнструменты.Сумма;
					
				КонецЕсли;
				
			ИначеЕсли СтрокаИнструменты.Сумма < 0 Тогда // мы отдали маржу - возник долг нам по марже (расчеты)
				
				Если СтоимостьСВОПа >= 0 Тогда // сидим в плюсах - корреспондируем с привлеченкой
				
					ДепозитнаяМаржаПривлеченка = СтрокаИнструменты.Сумма;
					
				ИначеЕсли СтрокаИнструменты.Сумма <= СтоимостьСВОПа Тогда // приход маржи вывел NPV из плюса в минус - часть с привлеченки, часть с взаиморасчетов
					
					ДепозитнаяМаржаРасчеты = СтоимостьСВОПа;
					ДепозитнаяМаржаПривлеченка = СтрокаИнструменты.Сумма - СтоимостьСВОПа;
					
				Иначе // мы в минусе - все с расчетов
					
					ДепозитнаяМаржаРасчеты = СтрокаИнструменты.Сумма;
					
				КонецЕсли;
				
			КонецЕсли;	
			
			Если ДепозитнаяМаржаРасчеты <> 0 Тогда
			
				ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", ДепозитнаяМаржаРасчеты);
				ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Основной.РазмещенныеСредстваДепозитнаяМаржа); //58.3 (58.4) //47010 ПланыСчетов.Единый.ПрочиеСредства10);
				
				СформироватьПроводкуДвиженияДСБУНУ(ПараметрыПроводкиДвиженияДС);
			
			КонецЕсли;
			
			Если ДепозитнаяМаржаПривлеченка <> 0 Тогда
			
				ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", ДепозитнаяМаржаПривлеченка);
				ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Основной.ПривлеченныеСредстваДепозитнаяМаржа); //43708    ПривлеченныеСредстваФинОрг08
				
				СформироватьПроводкуДвиженияДСБУНУ(ПараметрыПроводкиДвиженияДС);
			
			КонецЕсли;
			
			Если СтрокаИнструменты.Сумма > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаИнструменты.Сумма, "Депозитная маржа");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ДепозитнаяМаржа;//76.31//52601 УчетныйАктивЕПС.СчетУчетаПереоценкиА;
				Проводка.СубконтоДт.Контрагенты = СтрокаИнструменты.Инструмент.Контрагент;
				Проводка.СубконтоДт.Сделка = СтрокаИнструменты.Инструмент;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;//71509_36204 УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДепозитнаяМаржаВнереализационные");
				Проводка.СубконтоКт.ЦенныеБумаги = СтрокаИнструменты.Инструмент;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
				
			ИначеЕсли СтрокаИнструменты.Сумма < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -СтрокаИнструменты.Сумма, "Депозитная маржа");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;//71510_46204 УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДепозитнаяМаржаВнереализационные");
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаИнструменты.Инструмент;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
				
