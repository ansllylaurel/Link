#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	// заполним связанные поля
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВалютаОплаты) Тогда
		ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	ЭтотОбъект.Сумма = Инструменты.Итог("Сумма");
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;

	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		РаботаСДокументами.ПроверитьЗаполнениеРасчетногоСчета(ЭтотОбъект, Отказ);
		
		ВыбраныеИнструменты = Новый Соответствие;
		
		Для НомСтр = 0 По ЭтотОбъект.Инструменты.Количество() - 1 Цикл
			СтрокаИнструменты = ЭтотОбъект.Инструменты[НомСтр];
			
			Если ВыбраныеИнструменты.Получить(СтрокаИнструменты.Инструмент) = Неопределено Тогда
				ВыбраныеИнструменты.Вставить(СтрокаИнструменты.Инструмент, Строка(НомСтр + 1));
			Иначе
				ВыбраныеИнструменты.Вставить(СтрокаИнструменты.Инструмент, ВыбраныеИнструменты.Получить(СтрокаИнструменты.Инструмент) + ", " + Строка(НомСтр + 1));
			КонецЕсли;
			
		КонецЦикла;	
		
		Для Каждого ВыбранныйИнструмент Из ВыбраныеИнструменты Цикл
			Если Найти(ВыбранныйИнструмент.Значение, ",") > 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Фьючерс """ + ВыбранныйИнструмент.Ключ + """ встречается в документе несколько раз, в строках: " + ВыбранныйИнструмент.Значение,,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСЖурналамиОпераций.ПередЗаписьюДокумента(ЭтотОбъект);	
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

