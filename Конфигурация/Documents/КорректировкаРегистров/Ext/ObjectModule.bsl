#Область ОписаниеМодуля

////////////////////////////////////////////////////////////////////////////////
// Дополнительные свойства (ПередЗаписью, ПриЗаписи):
//	- НеПрочитыватьДвижения - Неопределено - наличие свойства позволяет
//		учитывать изменённые движения объекта вместо чтения их из регистров
//	- Программно - Неопределено - наличие свойства отменяет изменение регистров
////////////////////////////////////////////////////////////////////////////////

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	// Заполнение выбранных регистров
	ИспользуемыеРегистры = ЭтотОбъект.ТаблицаРегистров.ВыгрузитьКолонку("Имя");
	ЭтотОбъект.ВыбранныеРегистры = "";
	Для Каждого РегистрМД Из Метаданные.Документы.КорректировкаРегистров.Движения Цикл
		Если ИспользуемыеРегистры.Найти(РегистрМД.Имя) <> Неопределено Тогда
			Если Метаданные.РегистрыСведений.Содержит(РегистрМД)
				Или Метаданные.РегистрыНакопления.Содержит(РегистрМД)
				Или Метаданные.РегистрыБухгалтерии.Содержит(РегистрМД)
			Тогда
				ЭтотОбъект.ВыбранныеРегистры = ЭтотОбъект.ВыбранныеРегистры + ?(ПустаяСтрока(ЭтотОбъект.ВыбранныеРегистры), "", ", ") + РегистрМД.Представление();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Т.к. во всех регистрах есть измерения "Организация" и "СчетДоверительногоУправления", проверим,
	//	чтобы значения соответствующих полей в документе и записях регистрах совпадали
	Для Каждого НаборДвижений Из ЭтотОбъект.Движения Цикл
		Если Не ДополнительныеСвойства.Свойство("НеПрочитыватьДвижения") Тогда
			НаборДвижений.Прочитать();
		КонецЕсли;
		Если НаборДвижений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Документы.КорректировкаРегистров.ПроверитьНаборДвижений(ЭтотОбъект, НаборДвижений, Отказ);
	КонецЦикла;
	
	// Проверка наличия лишних имён регистров (по которым нет движений)
	Для Каждого СтрокаТЧ Из ЭтотОбъект.ТаблицаРегистров Цикл
		Если Не ПроверитьСуществованиеРегистра(СтрокаТЧ.Имя) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Регистр """ + СтрокаТЧ.Имя
				+ """ из состава регистров документа не существует.", ЭтотОбъект.Ссылка,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	// Установка активности движений
	Если Не ЭтотОбъект.ЭтоНовый() И ЭтотОбъект.Ссылка.ПометкаУдаления <> ЭтотОбъект.ПометкаУдаления Тогда
		УстановитьАктивностьДвижений(Не ПометкаУдаления);
	КонецЕсли;
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Программно") Тогда
		// Записывать будем только модифицированные регистры
		МодифицированныеРегистры = ПолучитьМодифицированныеРегистры();
		Для Каждого ДвиженияРегистра Из ЭтотОбъект.Движения Цикл
			ДвиженияРегистра.Записывать = (МодифицированныеРегистры.Найти(ДвиженияРегистра.Метаданные().Имя) <> Неопределено);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьСуществованиеРегистра(ИмяРегистра)
	Возврат Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено
		Или Метаданные.РегистрыНакопления.Найти(ИмяРегистра) <> Неопределено
		Или Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра) <> Неопределено;
КонецФункции

#КонецОбласти

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура УстановитьАктивностьДвижений(ФлагАктивности)
	
	Для Каждого НаборДвижений Из ЭтотОбъект.Движения Цикл
		НаборДвижений.Прочитать();
		НаборДвижений.УстановитьАктивность(ФлагАктивности);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМодифицированныеРегистры()
	
	МодифицированныеРегистры = Новый Массив;
	
	// Удаленные / добавленные регистры точно модифицированы
	
	ИспользуемыеРегистрыТекущие	= ЭтотОбъект.ТаблицаРегистров.ВыгрузитьКолонку("Имя");
	ИспользуемыеРегистрыСтарые	= ?(ЭтотОбъект.ЭтоНовый(), Новый Массив, ЭтотОбъект.Ссылка.ТаблицаРегистров.ВыгрузитьКолонку("Имя"));	
	
	Для Каждого ИмяРегистра Из ИспользуемыеРегистрыТекущие Цикл
		Если ИспользуемыеРегистрыСтарые.Найти(ИмяРегистра) = Неопределено Тогда
			МодифицированныеРегистры.Добавить(ИмяРегистра);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяРегистра Из ИспользуемыеРегистрыСтарые Цикл
		Если ИспользуемыеРегистрыТекущие.Найти(ИмяРегистра) = Неопределено Тогда
			МодифицированныеРегистры.Добавить(ИмяРегистра);	
		КонецЕсли;
	КонецЦикла;	
	
	// Проанализируем остальные
	
	Для Каждого ИмяРегистра Из ИспользуемыеРегистрыТекущие Цикл
		Если МодифицированныеРегистры.Найти(ИмяРегистра) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЭтотОбъект.Движения[ИмяРегистра].Модифицированность() Тогда
			Продолжить;
		КонецЕсли;
		
		ДвиженияТекущие = ЭтотОбъект.Движения[ИмяРегистра].Выгрузить();
		
		ОбъектСтарый = ?(ОбъектСтарый = Неопределено, ЭтотОбъект.Ссылка.ПолучитьОбъект(), ОбъектСтарый);
		ОбъектСтарый.Движения[ИмяРегистра].Прочитать();
		ДвиженияСтарые = ОбъектСтарый.Движения[ИмяРегистра].Выгрузить();
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Новый ХранилищеЗначения(ДвиженияТекущие, Новый СжатиеДанных(9)), "ValueStorage", "http://v8.1c.ru/8.1/data/core");
		ДвиженияТекущие = ЗаписьXML.Закрыть();
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Новый ХранилищеЗначения(ДвиженияСтарые, Новый СжатиеДанных(9)), "ValueStorage", "http://v8.1c.ru/8.1/data/core");
		ДвиженияСтарые = ЗаписьXML.Закрыть();

		Если ДвиженияТекущие <> ДвиженияСтарые Тогда
			МодифицированныеРегистры.Добавить(ИмяРегистра);	
		КонецЕсли;		
	КонецЦикла;
	
	Возврат МодифицированныеРегистры;
	
КонецФункции
