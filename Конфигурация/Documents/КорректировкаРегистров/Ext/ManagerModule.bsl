#Область СлужебныйПрограммныйИнтерфейс

// Проверка набора движений:
//	- Регистр набора движений должен быть в составе таблицы регистров документа
//	- Организация в записи набора движений должна соответствовать организации в документе
//	- Счёт д/у в записи набора движений должен соответствовать счёту д/у в документе
//	- Период в записи набора движений должен соответствовать дате в документе
//
// Параметры:
//	Документ - ДокументСсылка.КорректировкаРегистров, ДокументОбъект.КорректировкаРегистров
//	НаборДвижений - РегистрСведенийНаборЗаписей, РегистрНакопленияНаборЗаписей, РегистрБухгалтерииНаборЗаписей
//	Отказ - выходной параметр
Функция ПроверитьНаборДвижений(Документ, НаборДвижений, Отказ = Ложь) Экспорт
	ПроверкаПрошлаУспешно = Истина;
	Если НаборДвижений.Количество() = 0 Тогда
		Возврат ПроверкаПрошлаУспешно;
	КонецЕсли;
	
	ЭтоСсылка = ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаРегистров");
	ДокументСсылка = ?(ЭтоСсылка, Документ, Документ.Ссылка);
	Если ЭтоСсылка Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ,
			"Дата, Организация, СчетДоверительногоУправления, ВводНачальныхОстатков, ТаблицаРегистров");
		РеквизитыДокумента.ТаблицаРегистров = РеквизитыДокумента.ТаблицаРегистров.Выгрузить();
	Иначе
		РеквизитыДокумента = Документ;
	КонецЕсли;
	
	МетаданныеРегистра = НаборДвижений.Метаданные();
	ЭтоРегистрСведений = Метаданные.РегистрыСведений.Найти(МетаданныеРегистра.Имя) <> Неопределено;
	СтруктураСверки = Новый Структура("Организация, СчетДоверительногоУправления");
	ДатаНеобходимостиПроверкиПериода = ПолучитьДатуНачалаНеобходимостиПроверкиПериода();
	ЭтоОрганизацияИсключение = ПроверитьОрганизациюНаИсключениеПроверкиДвижений(РеквизитыДокумента.Организация);
	ЕстьПолеПериод = Не ЭтоРегистрСведений
		Или МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	ПроверятьПериод = Не ЭтоОрганизацияИсключение И ЕстьПолеПериод
		И (Не ЭтоРегистрСведений Или НачалоДня(РеквизитыДокумента.Дата) >= ДатаНеобходимостиПроверкиПериода)
		И Не РеквизитыДокумента.ВводНачальныхОстатков;
	ПриведеннаяКПериодичностиДата = РеквизитыДокумента.Дата;
	Если ЭтоРегистрСведений Тогда
		Если МетаданныеРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.День Тогда
			ПриведеннаяКПериодичностиДата = НачалоДня(ПриведеннаяКПериодичностиДата);
		ИначеЕсли МетаданныеРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Месяц Тогда
			ПриведеннаяКПериодичностиДата = НачалоМесяца(ПриведеннаяКПериодичностиДата);
		ИначеЕсли МетаданныеРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Квартал Тогда
			ПриведеннаяКПериодичностиДата = НачалоКвартала(ПриведеннаяКПериодичностиДата);
		ИначеЕсли МетаданныеРегистра.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Год Тогда
			ПриведеннаяКПериодичностиДата = НачалоГода(ПриведеннаяКПериодичностиДата);
		КонецЕсли;
	КонецЕсли;
	
	// Проверка набора движений
	Если РеквизитыДокумента.ТаблицаРегистров.НайтиСтроки(Новый Структура("Имя", МетаданныеРегистра.Имя)).Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Регистр """ + МетаданныеРегистра.Представление()
			+ """ не включён в состав регистров документа.", ДокументСсылка,,, Отказ);
		ПроверкаПрошлаУспешно = Ложь;
	КонецЕсли;
	Для Каждого Движение Из НаборДвижений Цикл
		ЗаполнитьЗначенияСвойств(СтруктураСверки, Движение);
		Если СтруктураСверки.Организация <> Неопределено И Движение.Организация <> РеквизитыДокумента.Организация Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В движениях по регистру """ + МетаданныеРегистра.Представление()
				+ """ присутствует организация, отличная от выбранной в документе.", ДокументСсылка,,, Отказ);
			ПроверкаПрошлаУспешно = Ложь;
			Прервать;
		ИначеЕсли СтруктураСверки.СчетДоверительногоУправления <> Неопределено И Движение.СчетДоверительногоУправления <> РеквизитыДокумента.СчетДоверительногоУправления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В движениях по регистру """ + МетаданныеРегистра.Представление()
				+ """ присутствует счет доверительного управления, отличный от выбранного в документе.", ДокументСсылка,,, Отказ);
			ПроверкаПрошлаУспешно = Ложь;
			Прервать;
		ИначеЕсли ПроверятьПериод И Движение.Период <> ПриведеннаяКПериодичностиДата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В движениях по регистру """ + МетаданныеРегистра.Представление()
				+ """ присутствует период, отличный от выбранной даты в документе.", ДокументСсылка,,, Отказ);
			ПроверкаПрошлаУспешно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ПроверкаПрошлаУспешно;
КонецФункции

Функция ПолучитьДатуНачалаНеобходимостиПроверкиПериода() Экспорт
	Возврат Дата(2024, 7, 14);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОрганизацииИсключенияПроверкиДвижений()
	ОрганизацииИсключения = Новый Массив;
	ОрганизацииИсключения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));
	Возврат ОрганизацииИсключения;
КонецФункции

Функция ПроверитьОрганизациюНаИсключениеПроверкиДвижений(Организация)
	Возврат ПолучитьОрганизацииИсключенияПроверкиДвижений().Найти(Организация) <> Неопределено;
КонецФункции

#КонецОбласти