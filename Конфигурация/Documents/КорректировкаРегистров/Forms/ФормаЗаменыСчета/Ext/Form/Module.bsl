
&НаСервере
Процедура СчетЗаменитьНаПриИзмененииНаСервере()
	
	ЭтаФорма.УстановитьСубконто.Очистить();
	
	СвойстваСчета = БухгалтерскийУчет.ПолучитьСвойстваСчета(ЭтаФорма.СчетЗаменитьНа);
	
	Для Инд = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
		СтрокаУстановитьСубконто = ЭтаФорма.УстановитьСубконто.Добавить();
		
		СвойстваСчета.Свойство("ВидСубконто" + Строка(Инд), СтрокаУстановитьСубконто.ВидСубконто);
		СвойстваСчета.Свойство("ВидСубконто" + Строка(Инд) + "ТипЗначения", СтрокаУстановитьСубконто.ТипЗначения);
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетЗаменитьНаПриИзменении(Элемент)
	СчетЗаменитьНаПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСубконтоПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
	
		ЭтаФорма.Элементы.УстановитьСубконтоСубконто.ОграничениеТипа = Элемент.ТекущиеДанные.ТипЗначения;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Заменить(Команда)
	
	ДанныеЗамены = Новый Структура("СчетЗаменить,СчетЗаменитьНа", ЭтаФорма.СчетЗаменить, ЭтаФорма.СчетЗаменитьНа);
	
	Для Инд = 1 По ЭтаФорма.УстановитьСубконто.Количество() Цикл
		ДанныеЗамены.Вставить("Субконто" + Строка(Инд), ЭтаФорма.УстановитьСубконто[Инд - 1].Субконто);
	КонецЦикла;
	
	Этаформа.Закрыть(ДанныеЗамены);
	
КонецПроцедуры
