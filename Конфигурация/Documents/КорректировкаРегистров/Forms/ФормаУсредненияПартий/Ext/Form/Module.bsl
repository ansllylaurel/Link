
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ЭтаФорма.Параметры.Организация;
	ЭтаФорма.Дата = ЭтаФорма.Параметры.Дата;
	
КонецПроцедуры

&НаКлиенте
Процедура Усреднить(Команда)
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
		
		ХранилищеКлиент = ПолучитьУсредненныеПартии(ЭтаФорма.Дата, ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.ВидУчета, ЭтаФорма.УсреднятьСтоимость, ЭтаФорма.УсреднятьСтоимостьКупона);
		
		ЭтаФорма.Закрыть(ХранилищеКлиент);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьРеквизит(НеусредненнаяСумма, Количество, РеквизитПогрешность, Распределить, РаспределитьКоличество)

	Дельта = Распределить / РаспределитьКоличество * Количество - НеусредненнаяСумма;
	ОкругленнаяДельта = Окр(Дельта, 2);
	
	Распределить = Распределить - НеусредненнаяСумма - ОкругленнаяДельта;
	
	РеквизитПогрешность = РеквизитПогрешность + (Дельта - ОкругленнаяДельта);
	
	Если РеквизитПогрешность > 0.01 ИЛИ РеквизитПогрешность < -0.01 Тогда
		
		ОкругленныйРеквизитПогрешность = Окр(РеквизитПогрешность, 2);
		РеквизитПогрешность = РеквизитПогрешность - ОкругленныйРеквизитПогрешность;
		
		ОкругленнаяДельта = ОкругленнаяДельта + ОкругленныйРеквизитПогрешность;
		Распределить = Распределить - ОкругленныйРеквизитПогрешность;
	
	КонецЕсли; 

	Возврат ОкругленнаяДельта;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьУсредненныеПартии(Дата, Организация, СчетДоверительногоУправления, ВидУчета, УсреднятьСтоимость, УсреднятьСтоимостьКупона)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток
		|ПОМЕСТИТЬ НеусредненныеОстатки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НеусредненныеОстатки.Рынок,
		|	НеусредненныеОстатки.ЦеннаяБумага,
		|	СУММА(НеусредненныеОстатки.РасходыПриПокупкеВСтоимостиОстаток) КАК РасходыПриПокупкеВСтоимостиОстаток,
		|	СУММА(НеусредненныеОстатки.ПереоценкаВСтоимостиОстаток) КАК ПереоценкаВСтоимостиОстаток,
		|	СУММА(НеусредненныеОстатки.ПереоценкаКупонаВСтоимостиОстаток) КАК ПереоценкаКупонаВСтоимостиОстаток,
		|	СУММА(НеусредненныеОстатки.СтоимостьОстаток) КАК СтоимостьОстаток,
		|	СУММА(НеусредненныеОстатки.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток,
		|	СУММА(НеусредненныеОстатки.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(НеусредненныеОстатки.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
		|	СУММА(НеусредненныеОстатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ УсредненныеОстатки
		|ИЗ
		|	НеусредненныеОстатки КАК НеусредненныеОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	НеусредненныеОстатки.Рынок,
		|	НеусредненныеОстатки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НеусредненныеОстатки.Рынок КАК Рынок,
		|	НеусредненныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НеусредненныеОстатки.Партия КАК Партия,
		|	НеусредненныеОстатки.СтрокаПартии КАК СтрокаПартии,
		|	УсредненныеОстатки.КоличествоОстаток КАК КоличествоОбщее,
		|	НеусредненныеОстатки.КоличествоОстаток КАК Количество,
		|	УсредненныеОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимостиСреднее,
		|	УсредненныеОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимостиСреднее,
		|	УсредненныеОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимостиСреднее,
		|	УсредненныеОстатки.СтоимостьОстаток КАК СтоимостьСреднее,
		|	УсредненныеОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаСреднее,
		|	УсредненныеОстатки.ПереоценкаОстаток КАК ПереоценкаСреднее,
		|	УсредненныеОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупонаСреднее,
		|	НеусредненныеОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимости,
		|	НеусредненныеОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимости,
		|	НеусредненныеОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимости,
		|	НеусредненныеОстатки.СтоимостьОстаток КАК Стоимость,
		|	НеусредненныеОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
		|	НеусредненныеОстатки.ПереоценкаОстаток КАК Переоценка,
		|	НеусредненныеОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона
		|ИЗ
		|	НеусредненныеОстатки КАК НеусредненныеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ УсредненныеОстатки КАК УсредненныеОстатки
		|		ПО НеусредненныеОстатки.Рынок = УсредненныеОстатки.Рынок
		|			И НеусредненныеОстатки.ЦеннаяБумага = УсредненныеОстатки.ЦеннаяБумага
		|
		|УПОРЯДОЧИТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии";

	Запрос.Параметры.Вставить("Период", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.Параметры.Вставить("Организация", Организация);
	Запрос.Параметры.Вставить("ВидУчета", ВидУчета);
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
	ТаблицаУсреднений = Запрос.Выполнить().Выгрузить();
	
	ТаблицаУсреднений.Сортировать("Рынок,ЦеннаяБумага,Партия,СтрокаПартии");

	МассивУсреднений = Новый Массив;
	
	ПогрешностьРасходыПриПокупкеВСтоимости	= 0;
	ПогрешностьПереоценкаВСтоимости			= 0;
	ПогрешностьПереоценкаКупонаВСтоимости	= 0;
	ПогрешностьСтоимость					= 0;
	ПогрешностьСтоимостьКупона				= 0;
	ПогрешностьПереоценка					= 0;
	ПогрешностьПереоценкаКупона			 	= 0;
	
	РаспределитьРасходыПриПокупкеВСтоимости = 0;
	РаспределитьПереоценкаВСтоимости		= 0;
	РаспределитьПереоценкаКупонаВСтоимости	= 0;
	РаспределитьСтоимость					= 0;
	РаспределитьСтоимостьКупона				= 0;
	РаспределитьПереоценка					= 0;
	РаспределитьПереоценкаКупона			= 0;
	
	РаспределитьКоличество					= 0;
	
	ТекущаяЦеннаяБумага = Справочники.Акции.ПустаяСсылка();
	
	Для каждого СтрокаТаблицаУсреднений Из ТаблицаУсреднений Цикл
		
		Если ТекущаяЦеннаяБумага <> СтрокаТаблицаУсреднений.ЦеннаяБумага Тогда
			
			ТекущаяЦеннаяБумага = СтрокаТаблицаУсреднений.ЦеннаяБумага;
		
			ПогрешностьРасходыПриПокупкеВСтоимости	= 0;
			ПогрешностьПереоценкаВСтоимости			= 0;
			ПогрешностьПереоценкаКупонаВСтоимости	= 0;
			ПогрешностьСтоимость					= 0;
			ПогрешностьСтоимостьКупона				= 0;
			ПогрешностьПереоценка					= 0;
			ПогрешностьПереоценкаКупона			 	= 0;
			
			РаспределитьРасходыПриПокупкеВСтоимости = СтрокаТаблицаУсреднений.РасходыПриПокупкеВСтоимостиСреднее;
			РаспределитьПереоценкаВСтоимости		= СтрокаТаблицаУсреднений.ПереоценкаВСтоимостиСреднее;
			РаспределитьПереоценкаКупонаВСтоимости	= СтрокаТаблицаУсреднений.ПереоценкаКупонаВСтоимостиСреднее;
			РаспределитьСтоимость					= СтрокаТаблицаУсреднений.СтоимостьСреднее;
			РаспределитьСтоимостьКупона				= СтрокаТаблицаУсреднений.СтоимостьКупонаСреднее;
			РаспределитьПереоценка					= СтрокаТаблицаУсреднений.ПереоценкаСреднее;
			РаспределитьПереоценкаКупона			= СтрокаТаблицаУсреднений.ПереоценкаКупонаСреднее;
			
			РаспределитьКоличество					= СтрокаТаблицаУсреднений.КоличествоОбщее;
			
		КонецЕсли;
		
		ДанныеУсреднения = Новый Структура("Период,Организация,СчетДоверительногоУправления,ВидУчета,Рынок,ЦеннаяБумага,Партия,СтрокаПартии,РасходыПриПокупкеВСтоимости,ПереоценкаВСтоимости,ПереоценкаКупонаВСтоимости,Стоимость,СтоимостьКупона,Переоценка,ПереоценкаКупона");
		
		ДанныеУсреднения.Период						  = Дата;
		ДанныеУсреднения.Организация				  = Организация;
		ДанныеУсреднения.СчетДоверительногоУправления = СчетДоверительногоУправления;
		ДанныеУсреднения.ВидУчета					  = ВидУчета;
		ДанныеУсреднения.Рынок						  = СтрокаТаблицаУсреднений.Рынок;
		ДанныеУсреднения.ЦеннаяБумага				  = СтрокаТаблицаУсреднений.ЦеннаяБумага;
		ДанныеУсреднения.Партия						  = СтрокаТаблицаУсреднений.Партия;
		ДанныеУсреднения.СтрокаПартии				  = СтрокаТаблицаУсреднений.СтрокаПартии;
		
		ДанныеУсреднения.РасходыПриПокупкеВСтоимости = ОбработатьРеквизит(СтрокаТаблицаУсреднений.РасходыПриПокупкеВСтоимости, СтрокаТаблицаУсреднений.Количество, ПогрешностьРасходыПриПокупкеВСтоимости, РаспределитьРасходыПриПокупкеВСтоимости, РаспределитьКоличество);
		ДанныеУсреднения.ПереоценкаВСтоимости		 = ОбработатьРеквизит(СтрокаТаблицаУсреднений.ПереоценкаВСтоимости,		   СтрокаТаблицаУсреднений.Количество, ПогрешностьПереоценкаВСтоимости,		   РаспределитьПереоценкаВСтоимости,	    РаспределитьКоличество);
		ДанныеУсреднения.ПереоценкаКупонаВСтоимости  = ОбработатьРеквизит(СтрокаТаблицаУсреднений.ПереоценкаКупонаВСтоимости,  СтрокаТаблицаУсреднений.Количество, ПогрешностьПереоценкаКупонаВСтоимости,  РаспределитьПереоценкаКупонаВСтоимости,  РаспределитьКоличество);
		ДанныеУсреднения.Стоимость					 = ОбработатьРеквизит(СтрокаТаблицаУсреднений.Стоимость,				   СтрокаТаблицаУсреднений.Количество, ПогрешностьСтоимость,				   РаспределитьСтоимость,		    РаспределитьКоличество);
		ДанныеУсреднения.СтоимостьКупона			 = ОбработатьРеквизит(СтрокаТаблицаУсреднений.СтоимостьКупона,			   СтрокаТаблицаУсреднений.Количество, ПогрешностьСтоимостьКупона,			   РаспределитьСтоимостьКупона,		    РаспределитьКоличество);
		ДанныеУсреднения.Переоценка					 = ОбработатьРеквизит(СтрокаТаблицаУсреднений.Переоценка,				   СтрокаТаблицаУсреднений.Количество, ПогрешностьПереоценка,				   РаспределитьПереоценка,		    РаспределитьКоличество);
		ДанныеУсреднения.ПереоценкаКупона			 = ОбработатьРеквизит(СтрокаТаблицаУсреднений.ПереоценкаКупона,			   СтрокаТаблицаУсреднений.Количество, ПогрешностьПереоценкаКупона,			   РаспределитьПереоценкаКупона,	    РаспределитьКоличество);
		
		РаспределитьКоличество = РаспределитьКоличество - СтрокаТаблицаУсреднений.Количество;
		
		Если НЕ УсреднятьСтоимость Тогда
		
			ДанныеУсреднения.РасходыПриПокупкеВСтоимости = 0;
			ДанныеУсреднения.ПереоценкаВСтоимости = 0;
			ДанныеУсреднения.Стоимость = 0;
			ДанныеУсреднения.Переоценка = 0;
		
		КонецЕсли;
		
		Если НЕ УсреднятьСтоимостьКупона Тогда
		
			ДанныеУсреднения.ПереоценкаКупонаВСтоимости = 0;
			ДанныеУсреднения.СтоимостьКупона = 0;
			ДанныеУсреднения.ПереоценкаКупона = 0;
		
		КонецЕсли;
		
		МассивУсреднений.Добавить(ДанныеУсреднения);
		
		ПредыдущаяСтрока = СтрокаТаблицаУсреднений;
		
	КонецЦикла;
	
	//ХЗ = Новый ХранилищеЗначения(МассивУсреднений, Новый СжатиеДанных(9));
	//
	//Возврат  ХЗ;
	Возврат  МассивУсреднений;
	
КонецФункции

