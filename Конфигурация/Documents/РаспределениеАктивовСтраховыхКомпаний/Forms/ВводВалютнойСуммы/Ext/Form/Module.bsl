
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры, "ВалютаУчета, ВалютаАктива, Курс, Кратность, СуммаВалютаУчета, СуммаВалютаАктива");
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	ЭтаФорма.Закрыть(
		Новый Структура("СуммаВалютаАктива, СуммаВалютаУчета", ЭтаФорма.СуммаВалютаАктива,ЭтаФорма.СуммаВалютаУчета));
КонецПроцедуры

&НаКлиенте
Процедура СуммаВалютаУчетаПриИзменении(Элемент)
	Результат=Окр(ЭтаФорма.Кратность*ЭтаФорма.СуммаВалютаУчета/ЭтаФорма.Курс,2);
	ЭтаФорма.СуммаВалютаАктива=Результат;
	ЭтаФорма.СуммаВалютаУчета=Окр(Результат*ЭтаФорма.Курс/ЭтаФорма.Кратность,2);
КонецПроцедуры

&НаКлиенте
Процедура СуммаВалютаАктиваПриИзменении(Элемент)
	 Результат=ЭтаФорма.СуммаВалютаАктива;
	 ЭтаФорма.СуммаВалютаУчета=Окр(Результат*ЭтаФорма.Курс/ЭтаФорма.Кратность,2);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ПодчиненныеЭлементы.СуммаВалютаАктива.Заголовок="Сумма в "+ЭтаФорма.ВалютаАктива;
	ЭтаФорма.ПодчиненныеЭлементы.СуммаВалютаУчета.Заголовок="Сумма в "+ЭтаФорма.ВалютаУчета;
	ЭтаФорма.Заголовок="Ввод ("+ЭтаФорма.ВалютаАктива+" - "+ ЭтаФорма.Курс+")";
КонецПроцедуры
