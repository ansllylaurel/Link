		Если ДействуютПравилаКонтроля710ПНаСервере() = ложь Тогда
			
			ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - собственные ср-ва сверх норматива: " + 
									Формат(ИтоговыеСуммы.СобственныеСредстваСверхНорматива, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
			
			Если ПрочиеСобственныеСредстваСверхНорматива > 0 Тогда
				ТекстИтоговойСтроки = ТекстИтоговойСтроки + " (в других портфелях группы:  " + 
									Формат(ПрочиеСобственныеСредстваСверхНорматива, "ЧДЦ=2; ЧН=0") + ")";
			КонецЕсли;
								
		КонецЕсли;
		
		Если  ИтоговыеСуммы.РезервыПоСтрахованиюЖизни + ПрочиеРезервыПоСтрахованиюЖизни 				<> РезервыПоСтрахованиюЖизни 
		Или	  ИтоговыеСуммы.РезервыПоСтрахованиюИномуЧемЖизни + ПрочиеРезервыПоСтрахованиюИномуЧемЖизни <> РезервыПоСтрахованиюИномуЧемЖизни
		Или   ИтоговыеСуммы.СобственныеСредстваВРазмереНорматива + ПрочиеСобственныеСредства 			<> Макс(НормативныйРазмерМаржиПлатежеспособности,МинимальныйРазмерУставногоКапитала) 
		Или   (ИтоговыеСуммы.СобственныеСредстваСверхНорматива + ПрочиеСобственныеСредстваСверхНорматива <> СобственныеСредстваСверхНорматива  
				И НЕ ДействуютПравилаКонтроля710ПНаСервере())Тогда
			Если ИтоговыеСуммы.СобственныеСредстваСверхНорматива + ПрочиеСобственныеСредстваСверхНорматива <> СобственныеСредстваВсего Тогда
				Элементы.ИтоговаяСтрокаПредоставляемыеПоказатели.ЦветТекста = WebЦвета.Красный;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ИтоговаяСтрокаАктивыСтраховойКомпании.Заголовок = ТекстИтоговойСтроки;
	
	ТекстИтоговойСтроки = "Предоставляемые показатели:";
	ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - страховые резервы по страхованию жизни: " + Формат(РезервыПоСтрахованиюЖизни, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
	ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - страховые резервы по страхованию иному, чем жизни: " + Формат(РезервыПоСтрахованиюИномуЧемЖизни, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
	Если ДействуютПравилаКонтроля710ПНаСервере() = Ложь Тогда

		ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - нормативный размер маржи платежеспособности: " + Формат(НормативныйРазмерМаржиПлатежеспособности, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
		ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - мин. размер уставного капитала: " + Формат(МинимальныйРазмерУставногоКапитала, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
		ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - превышение размера собственных ср-в над наибольшим показателем: " + Формат(СобственныеСредстваСверхНорматива, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
		
	Иначе
		ТекстИтоговойСтроки = ТекстИтоговойСтроки + Символы.ПС + Символы.Таб + " - собственные средства, всего: " + Формат(СобственныеСредстваВсего, "ЧДЦ=2; ЧН=0") + " " + ВалютаУчета;
	КонецЕсли;
	
	Элементы.ИтоговаяСтрокаПредоставляемыеПоказатели.Заголовок = ТекстИтоговойСтроки;      	                     	
	
КонецПроцедуры // ЗаполнитьИтоговуюСтрокуАктивыЦенныхБумагНаСервере


&НаСервере
Функция ДействуютПравилаКонтроля710ПНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ДействуютПравилаКонтроля710П();
	
КонецФункции


&НаСервере
Процедура ЗаполнитьАктивыСтраховойКомпанииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумагиСК.Организация КАК Организация,
			|	_ЦенныеБумагиСК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ЦенныеБумагиСК.ВидУчета КАК ВидУчета,
			|	_ЦенныеБумагиСК.Рынок КАК Рынок,
			|	_ЦенныеБумагиСК.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ЦенныеБумагиСК.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	_ЦенныеБумагиСК.ВалютаНоминала КАК ВалютаНоминала,
			|	_ЦенныеБумагиСК.ДатаКурсаВалют КАК ДатаКурсаВалют,
			|	_ЦенныеБумагиСК.Курс КАК Курс,
			|	_ЦенныеБумагиСК.Кратность КАК Кратность,
			|	ЕСТЬNULL(_ЦенныеБумагиСК.БалансоваяСтоимость, 0) + ЕСТЬNULL(_ЦенныеБумагиСК.БалансоваяСтоимостьКупона, 0) КАК БалансоваяСтоимость,
			|	_ЦенныеБумагиСК.БалансоваяСтоимостьКупона КАК БалансоваяСтоимостьКупона,
			|	_ЦенныеБумагиСК.Количество КАК Количество,
			|	_ЦенныеБумагиСК.Стоимость КАК Стоимость,
			|	_ЦенныеБумагиСК.СтоимостьКупона КАК СтоимостьКупона,
			|	_ЦенныеБумагиСК.СтоимостьПокупки КАК СтоимостьПокупки,
			|	_ЦенныеБумагиСК.СтоимостьПокупкиКупона КАК СтоимостьПокупкиКупона,
			|	_ЦенныеБумагиСК.Переоценка КАК Переоценка,
			|	_ЦенныеБумагиСК.ПереоценкаКупона КАК ПереоценкаКупона,
			|	_ЦенныеБумагиСК.ДисконтПремия КАК ДисконтПремия,
			|	_ЦенныеБумагиСК.КорректировкаЭСП КАК КорректировкаЭСП
			|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховойКомпании
			|ИЗ
			|	&СтоимостьЦенныхБумагСтраховойКомпании КАК _ЦенныеБумагиСК
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ОстаткиНаДепозитныхВкладах.ДепозитныйВклад КАК ДепозитныйВклад,
			|	_ОстаткиНаДепозитныхВкладах.СуммаДепозитногоВкладаБУ КАК СуммаДепозитногоВкладаБУ,
			|	_ОстаткиНаДепозитныхВкладах.СуммаДепозитногоВкладаВВалютеУчетаБУ КАК СуммаДепозитногоВкладаВВалютеУчетаБУ,
			|	_ОстаткиНаДепозитныхВкладах.НоминалЕПС КАК НоминалЕПС,
			|	_ОстаткиНаДепозитныхВкладах.ПроцентыЕПС КАК ПроцентыЕПС,
			|	_ОстаткиНаДепозитныхВкладах.БалансоваяСтоимостьДепозитногоВклада КАК БалансоваяСтоимостьДепозитногоВклада,
			|	_ОстаткиНаДепозитныхВкладах.ДатаКурсаВалют КАК ДатаКурсаВалют,
			|	_ОстаткиНаДепозитныхВкладах.Курс КАК Курс,
			|	_ОстаткиНаДепозитныхВкладах.Кратность КАК Кратность,
			|	_ОстаткиНаДепозитныхВкладах.Валюта КАК Валюта
			|ПОМЕСТИТЬ _ОстаткиНаДепозитныхВкладахСтраховойКомпании
			|ИЗ
			|	&ОстаткиНаДепозитныхВкладах КАК _ОстаткиНаДепозитныхВкладах
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	""Расчетные счета, "" + ОстаткиДенежныхСредствОстатки.Валюта.Наименование КАК ГруппаАктивов,
			|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет КАК Актив,
			|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
			|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК ОбщаяСтоимостьАктива,
			|	NULL КАК СубъектПрочегоАктива,
			|	ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен КАК Исключен
			|ПОМЕСТИТЬ _НераспределенныеАктивы
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)) КАК ОстаткиДенежныхСредствОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних
			|		ПО ОстаткиДенежныхСредствОстатки.РасчетныйСчет = ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Актив
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Денежные средства у брокеров"",
			|	ОстаткиДенежныхСредствОстатки.Брокер,
			|	ОстаткиДенежныхСредствОстатки.Валюта,
			|	ОстаткиДенежныхСредствОстатки.СуммаОстаток,
			|	NULL,
			|	ЛОЖЬ
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)) КАК ОстаткиДенежныхСредствОстатки
			|ГДЕ
			|	&Период < &ДатаКонцаУчетаБрокерскихСчетов
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Депозитные вклады"",
			|	_ОстаткиНаДепозитныхВкладахСтраховойКомпании.ДепозитныйВклад,
			|	_ОстаткиНаДепозитныхВкладахСтраховойКомпании.Валюта,
			|	_ОстаткиНаДепозитныхВкладахСтраховойКомпании.БалансоваяСтоимостьДепозитногоВклада,
			|	NULL,
			|	ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен
			|ИЗ
			|	_ОстаткиНаДепозитныхВкладахСтраховойКомпании КАК _ОстаткиНаДепозитныхВкладахСтраховойКомпании
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних
			|		ПО _ОстаткиНаДепозитныхВкладахСтраховойКомпании.ДепозитныйВклад = ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Актив
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиПрочихАктивовОстатки.Актив.ВидПрочегоАктива,
			|	ОстаткиПрочихАктивовОстатки.Актив,
			|	ОстаткиПрочихАктивовОстатки.Валюта,
			|	ВЫБОР
			|		КОГДА ОстаткиПрочихАктивовОстатки.Актив.ВидПрочегоАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.НедвижимоеИмущество)
			|			ТОГДА ВЫБОР
			|					КОГДА ОценкиСтоимостьИмуществаСрезПоследних.Стоимость ЕСТЬ NULL
			|						ТОГДА ОстаткиПрочихАктивовОстатки.СуммаОстаток
			|					КОГДА ОценкиСтоимостьИмуществаСрезПоследних.Стоимость > 0
			|							И ОценкиСтоимостьИмуществаСрезПоследних.Стоимость < ОстаткиПрочихАктивовОстатки.СуммаОстаток
			|						ТОГДА ОценкиСтоимостьИмуществаСрезПоследних.Стоимость
			|					ИНАЧЕ ОстаткиПрочихАктивовОстатки.СуммаОстаток
			|				КОНЕЦ
			|		ИНАЧЕ ОстаткиПрочихАктивовОстатки.СуммаОстаток
			|	КОНЕЦ,
			|	ОстаткиПрочихАктивовОстатки.Субъект,
			|	ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен
			|ИЗ
			|	РегистрНакопления.ОстаткиПрочихАктивов.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних
			|		ПО ОстаткиПрочихАктивовОстатки.Актив = ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Актив
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостьИмущества.СрезПоследних(&Период, Организация = &Организация) КАК ОценкиСтоимостьИмуществаСрезПоследних
			|		ПО ОстаткиПрочихАктивовОстатки.Актив = ОценкиСтоимостьИмуществаСрезПоследних.Имущество
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_СтоимостьЦенныхБумагСтраховойКомпании.Рынок,
			|	_СтоимостьЦенныхБумагСтраховойКомпании.ЦеннаяБумага,
			|	_СтоимостьЦенныхБумагСтраховойКомпании.ВалютаНоминала,
			|	СУММА(_СтоимостьЦенныхБумагСтраховойКомпании.БалансоваяСтоимость),
			|	NULL,
			|	ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен
			|ИЗ
			|	_СтоимостьЦенныхБумагСтраховойКомпании КАК _СтоимостьЦенныхБумагСтраховойКомпании
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних
			|		ПО _СтоимостьЦенныхБумагСтраховойКомпании.ЦеннаяБумага = ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Актив
			|
			|СГРУППИРОВАТЬ ПО
			|	_СтоимостьЦенныхБумагСтраховойКомпании.Рынок,
			|	_СтоимостьЦенныхБумагСтраховойКомпании.ЦеннаяБумага,
			|	ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен,
			|	_СтоимостьЦенныхБумагСтраховойКомпании.ВалютаНоминала
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Остатки на вкладах МНО"",
			|	МНО.Ссылка,
			|	МНО.РасчетныйСчет.Валюта,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
			|	NULL,
			|	ЛОЖЬ
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Субконто2 ССЫЛКА Документ.МНО) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.МНО КАК МНО
			|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = МНО.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА ТекущиеАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.БанковскиеСчета
