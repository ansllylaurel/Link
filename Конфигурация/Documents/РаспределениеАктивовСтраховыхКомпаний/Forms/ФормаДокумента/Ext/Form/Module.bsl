&НаКлиенте
Процедура АктивыСтраховойКомпанииПриАктивизацииСтроки(Элемент)

	ВалютаУчета=ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	ТекущиеДанные = Элементы.АктивыСтраховойКомпании.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если (Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни Или
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииОбщаяСтоимостьАктива ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРаспределено ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииНераспределено  ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииКлюч) И
		   Не (ТекущиеДанные.Валюта=Неопределено) Тогда
		Если ТекущиеДанные.Валюта = ВалютаУчета Тогда
			Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииОбщаяСтоимостьАктива.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииРаспределено.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
			Элементы.АктивыСтраховойКомпанииНераспределено.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 2));
		Иначе	
			Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииОбщаяСтоимостьАктива.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииРаспределено.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
			Элементы.АктивыСтраховойКомпанииНераспределено.ОграничениеТипа = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АктивыСтраховойКомпанииПередНачаломИзменения(Элемент, Отказ)
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	ТекущиеДанные = Элементы.АктивыСтраховойКомпании.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Валюта = ВалютаУчета Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Валюта) Тогда
		Возврат
	КонецЕсли;

	Если Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни Или
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива ИЛИ
		   Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива  Тогда

			Курс=ВалютнаяСтрокаПолучениеКурса(ТекущиеДанные.Валюта, Валюты, ТекущиеДанные.Актив, ВалютаУчета);
			
			Если Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни Тогда
				СуммаВалюта=ВалютнаяСтрокаРазбор(Строка(ТекущиеДанные.РезервыПоСтрахованиюЖизни));
			ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни Тогда
				СуммаВалюта=ВалютнаяСтрокаРазбор(Строка(ТекущиеДанные.РезервыПоСтрахованиюИномуЧемЖизни));
			ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива Тогда
				СуммаВалюта=ВалютнаяСтрокаРазбор(Строка(ТекущиеДанные.СобственныеСредстваВРазмереНорматива));
			ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива Тогда
				СуммаВалюта=ВалютнаяСтрокаРазбор(Строка(ТекущиеДанные.СобственныеСредстваСверхНорматива));
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("ВалютаУчета, ВалютаАктива, Курс, Кратность, СуммаВалютаУчета, СуммаВалютаАктива",
				ВалютаУчета,
				ТекущиеДанные.Валюта,
				Курс.Курс,
				Курс.Кратность,
				СуммаВалюта.СуммаВалютаУчета,
				СуммаВалюта.СуммаВалютаАктива);
			
			Результат = ОткрытьФормуМодально("Документ.РаспределениеАктивовСтраховыхКомпаний.Форма.ВводВалютнойСуммы",
				ПараметрыФормы, ЭтаФорма);
				
			Если Результат <> Неопределено Тогда
				РезСтрока=ВалютнаяСтрокаФормирование(ТекущиеДанные.Валюта,Результат.СуммаВалютаАктива, Валюты,  ТекущиеДанные.Актив, ВалютаУчета);
				
				Если Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюЖизни Тогда
					ТекущиеДанные.РезервыПоСтрахованиюЖизни=РезСтрока;
				ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииРезервыПоСтрахованиюИномуЧемЖизни Тогда
					ТекущиеДанные.РезервыПоСтрахованиюИномуЧемЖизни=РезСтрока;
				ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваВРазмереНорматива Тогда
					ТекущиеДанные.СобственныеСредстваВРазмереНорматива=РезСтрока;
				ИначеЕсли Элементы.АктивыСтраховойКомпании.ТекущийЭлемент = Элементы.АктивыСтраховойКомпанииСобственныеСредстваСверхНорматива Тогда
					ТекущиеДанные.СобственныеСредстваСверхНорматива=РезСтрока;
				КонецЕсли;

				ПересчитатьРаспределено();
				ЗаполнитьИтоговуюСтрокуАктивыЦенныхБумагНаСервере();

			КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВалютнаяСтрокаФормирование(Знач Валюта, Знач Сумма, Знач ВалютыЗнач, Актив, ВалютаУчета)
	Результат="";
	Если Не (Сумма=Неопределено) Тогда
		Курс=ВалютнаяСтрокаПолучениеКурса(Валюта, ВалютыЗнач, Актив, ВалютаУчета);
		Если Сумма<>0 Тогда
			Если Не (Курс=Неопределено) Тогда
					ВалютаАктива=Формат(Сумма,"ЧДЦ=2; ЧН=0");
					ВалютаУчетаЧисло=Окр(Сумма*Курс.Курс/Курс.Кратность,2);
					СуммаВВалютеУчета=Формат(ВалютаУчетаЧисло,"ЧДЦ=2; ЧН=0");
					Если ВалютаАктива<>ВалютаУчета Тогда
						Результат=ВалютаАктива+" ("+СуммаВВалютеУчета+")";
					КонецЕсли;
				Иначе
					Результат=Формат(Сумма,"ЧДЦ=2; ЧН=0");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВалютнаяСтрокаРазбор(Знач СуммаСтрока)
	Результат=Неопределено;
	Начало=Найти(СуммаСтрока,"(");
	Конец=Найти(СуммаСтрока,")");
	Если СуммаСтрока=Неопределено Или Начало=0 Или Конец=0 Или ПустаяСтрока(СуммаСтрока) Тогда
		Результат=Новый Структура("СуммаВалютаУчета,СуммаВалютаАктива",0,0);	
	Иначе
		СуммаСтрока=СтрЗаменить(СуммаСтрока,")","");
		СуммаСтрокаМассив=СтрЗаменить(СуммаСтрока,"(",Символы.ПС);
		Результат=Новый Структура("СуммаВалютаУчета,СуммаВалютаАктива",
							Число(СтрЗаменить(СтрПолучитьСтроку(СуммаСтрокаМассив, 2)," ","")),
							Число(СтрЗаменить(СтрПолучитьСтроку(СуммаСтрокаМассив, 1)," ","")));
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВалютнаяСтрокаПолучениеКурса(Знач Валюта, Знач ВалютыЗнач, Актив, ВалютаУчета)
	Результат=Неопределено;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Валюта", Валюта);	
	Если(Валюта <> ВалютаУчета) Тогда
		ПараметрыОтбора.Вставить("Актив", Актив);
	КонецЕсли;
	НайденныеСтроки = ВалютыЗнач.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 Тогда
		Результат=Новый Структура("Курс,Кратность",НайденныеСтроки[0].Курс,НайденныеСтроки[0].Кратность)
	КонецЕсли;
	Возврат Результат;
КонецФункции
