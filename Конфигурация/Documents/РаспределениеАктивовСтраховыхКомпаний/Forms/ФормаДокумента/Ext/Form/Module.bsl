				Если Найти(Строка(НоваяСтрокаАктив.Распределено),"(")=0 И Строка(НоваяСтрокаАктив.Распределено)<>"" Тогда
					НоваяСтрокаАктив.Распределено=ВалютнаяСтрокаФормирование(НоваяСтрокаАктив.Валюта,НоваяСтрокаАктив.Распределено,ЭтаФорма.Валюты,НоваяСтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
				
				Если Найти(Строка(НоваяСтрокаАктив.ОбщаяСтоимостьАктива),"(")=0 И Строка(НоваяСтрокаАктив.ОбщаяСтоимостьАктива)<>"" Тогда
					НоваяСтрокаАктив.ОбщаяСтоимостьАктива=ВалютнаяСтрокаФормирование(НоваяСтрокаАктив.Валюта,НоваяСтрокаАктив.ОбщаяСтоимостьАктива,ЭтаФорма.Валюты,НоваяСтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;

			КонецЕсли;
			
			// !!! здесь нужно заполнить руб. эквивалент
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнитьИтоговуюСтрокуАктивыЦенныхБумагНаСервере();
	
КонецПроцедуры // ЗаполнитьАктивыСтраховойКомпанииНаСервере

&НаСервере
