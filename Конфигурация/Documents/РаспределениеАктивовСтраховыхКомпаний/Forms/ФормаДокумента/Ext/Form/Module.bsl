
&НаСервере
Процедура ЗаполнитьВалютыНаСервере(АктивыСтраховойКомпании)
			
		Запрос = Новый Запрос();
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	_АктивыСтраховойКомпании.Валюта КАК Валюта,
		               |	_АктивыСтраховойКомпании.Актив КАК Актив,
		               |	_АктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		               |ПОМЕСТИТЬ _ВсеАктивыСтраховойКомпании
		               |ИЗ
		               |	&АктивыСтраховойКомпании КАК _АктивыСтраховойКомпании
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	_ВсеАктивыСтраховойКомпании.Валюта КАК Валюта,
		               |	_ВсеАктивыСтраховойКомпании.Актив КАК Актив,
		               |	_ВсеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		               |ИЗ
		               |	_ВсеАктивыСтраховойКомпании КАК _ВсеАктивыСтраховойКомпании
		               |ГДЕ
		               |	_ВсеАктивыСтраховойКомпании.Валюта <> ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета";
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("АктивыСтраховойКомпании", АктивыСтраховойКомпании);

		
		КурсыВалют =  Документы.РаспределениеАктивовСтраховыхКомпаний.ПолучитьКурсыВалютДляАктивовСтраховойКомпании(Запрос.Выполнить().Выгрузить(), ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,КонецДня(ТекущаяДата())), объект.Организация);
		
		Для Каждого СтрокаКурсыВалют Из КурсыВалют Цикл 
			НоваяСтрокаТаблицы = ЭтаФорма.Валюты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаКурсыВалют);
			НоваяСтрокаТаблицы.ДатаКурса = СтрокаКурсыВалют.ДатаКурсаВалют;
		КонецЦикла;
		
		ВалютаСтрока=ЭтаФорма.Валюты.Добавить();
		ВалютаСтрока.Валюта=Объект.Организация.ВалютаУчета;
		ВалютаСтрока.Курс=1;
		ВалютаСтрока.Кратность=1; 	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПеренестиАктивыСтраховойКомпанииВДокумент(Форма)
	
	Форма.Объект.АктивыСтраховойКомпании.Очистить();
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Объект.Организация, "ВалютаУчета");

	Для каждого СтрокаГруппаАктивов Из Форма.АктивыСтраховойКомпании.ПолучитьЭлементы() Цикл
		Для каждого СтрокаАктив Из СтрокаГруппаАктивов.ПолучитьЭлементы() Цикл

			Если СтрокаАктив.Валюта<>ВалютаУчета Тогда
				СтрокаАктив.Нераспределено=ВалютнаяСтрокаРазбор(СтрокаАктив.Нераспределено).СуммаВалютаАктива;
				СтрокаАктив.РезервыПоСтрахованиюЖизни=ВалютнаяСтрокаРазбор(СтрокаАктив.РезервыПоСтрахованиюЖизни).СуммаВалютаАктива;
				СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни=ВалютнаяСтрокаРазбор(СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни).СуммаВалютаАктива;
				СтрокаАктив.СобственныеСредстваВРазмереНорматива=ВалютнаяСтрокаРазбор(СтрокаАктив.СобственныеСредстваВРазмереНорматива).СуммаВалютаАктива;
				СтрокаАктив.СобственныеСредстваСверхНорматива=ВалютнаяСтрокаРазбор(СтрокаАктив.СобственныеСредстваСверхНорматива).СуммаВалютаАктива;
				СтрокаАктив.Распределено=ВалютнаяСтрокаРазбор(СтрокаАктив.Распределено).СуммаВалютаАктива;
				СтрокаАктив.ОбщаяСтоимостьАктива=ВалютнаяСтрокаРазбор(СтрокаАктив.ОбщаяСтоимостьАктива).СуммаВалютаАктива;
			КонецЕсли;
		
			ЗаполнитьЗначенияСвойств(Форма.Объект.АктивыСтраховойКомпании.Добавить(), СтрокаАктив);
			
			Если СтрокаАктив.Валюта<>ВалютаУчета Тогда
				Если Найти(Строка(СтрокаАктив.Нераспределено),"(")=0 И Строка(СтрокаАктив.Нераспределено)<>"" Тогда
					СтрокаАктив.Нераспределено=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.Нераспределено,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
			
				Если Найти(Строка(СтрокаАктив.РезервыПоСтрахованиюЖизни),"(")=0 И Строка(СтрокаАктив.РезервыПоСтрахованиюЖизни)<>"" Тогда
					СтрокаАктив.РезервыПоСтрахованиюЖизни=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.РезервыПоСтрахованиюЖизни,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
					
				Если Найти(Строка(СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни),"(")=0 И Строка(СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни)<>"" Тогда
					СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
				
				Если Найти(Строка(СтрокаАктив.СобственныеСредстваВРазмереНорматива),"(")=0 И Строка(СтрокаАктив.СобственныеСредстваВРазмереНорматива)<>"" Тогда
					СтрокаАктив.СобственныеСредстваВРазмереНорматива=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.СобственныеСредстваВРазмереНорматива,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
				
				Если Найти(Строка(СтрокаАктив.СобственныеСредстваСверхНорматива),"(")=0 И Строка(СтрокаАктив.СобственныеСредстваСверхНорматива)<>"" Тогда
					СтрокаАктив.СобственныеСредстваСверхНорматива=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.СобственныеСредстваСверхНорматива,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
				
				Если Найти(Строка(СтрокаАктив.Распределено),"(")=0 И Строка(СтрокаАктив.Распределено)<>"" Тогда
					СтрокаАктив.Распределено=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.Распределено,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;
				
				Если Найти(Строка(СтрокаАктив.ОбщаяСтоимостьАктива),"(")=0 И Строка(СтрокаАктив.ОбщаяСтоимостьАктива)<>"" Тогда
					СтрокаАктив.ОбщаяСтоимостьАктива=ВалютнаяСтрокаФормирование(СтрокаАктив.Валюта,СтрокаАктив.ОбщаяСтоимостьАктива,Форма.Валюты,СтрокаАктив.Актив, ВалютаУчета);
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры // ПеренестиАктивыСтраховойКомпанииВДокумент

&НаСервере
Процедура ЗаполнитьИтоговуюСтрокуАктивыЦенныхБумагНаСервере()

	ПеренестиАктивыСтраховойКомпанииВДокумент(ЭтаФорма);
	
	ТекстИтоговойСтроки = "";
	// Для нового документа дата неизвестна
	Период =  ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата, КонецДня(ТекущаяДата()));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивыСтраховойКомпанииВДокументе.Актив КАК Актив,
		|	АктивыСтраховойКомпанииВДокументе.Валюта КАК Валюта,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюЖизни КАК РезервыПоСтрахованиюЖизни,
		|	АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюИномуЧемЖизни КАК РезервыПоСтрахованиюИномуЧемЖизни,
		|	АктивыСтраховойКомпанииВДокументе.СобственныеСредстваВРазмереНорматива КАК СобственныеСредстваВРазмереНорматива,
		|	АктивыСтраховойКомпанииВДокументе.СобственныеСредстваСверхНорматива КАК СобственныеСредстваСверхНорматива,
		|	АктивыСтраховойКомпанииВДокументе.Нераспределено КАК Нераспределено
		|ПОМЕСТИТЬ _АктивыСтраховойКомпанииВДокументе
		|ИЗ
		|	&АктивыСтраховойКомпанииВДокументе КАК АктивыСтраховойКомпанииВДокументе
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСтраховойКомпанииВДокументе.Актив КАК Актив,
		|	_АктивыСтраховойКомпанииВДокументе.Валюта КАК Валюта,
		|	_АктивыСтраховойКомпанииВДокументе.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюЖизни КАК РезервыПоСтрахованиюЖизни,
		|	_АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюИномуЧемЖизни КАК РезервыПоСтрахованиюИномуЧемЖизни,
		|	_АктивыСтраховойКомпанииВДокументе.СобственныеСредстваВРазмереНорматива КАК СобственныеСредстваВРазмереНорматива,
		|	_АктивыСтраховойКомпанииВДокументе.СобственныеСредстваСверхНорматива КАК СобственныеСредстваСверхНорматива,
		|	_АктивыСтраховойКомпанииВДокументе.Нераспределено КАК Нераспределено
		|ПОМЕСТИТЬ _ВсеРаспределенныеАктивыСтраховойКомпании
		|ИЗ
		|	_АктивыСтраховойКомпанииВДокументе КАК _АктивыСтраховойКомпанииВДокументе
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Актив,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Валюта,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива,
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Нераспределено
		|ИЗ
		|	Документ.РаспределениеАктивовСтраховыхКомпаний.АктивыСтраховойКомпании КАК РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.Проведен = ИСТИНА
		|	И РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления.Родитель = ВЫРАЗИТЬ(&СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).Родитель
		|	И РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления <> &СчетДоверительногоУправления
		|	И КОНЕЦПЕРИОДА(РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеРаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	_ВсеРаспределенныеАктивыСтраховойКомпании.Валюта КАК Валюта,
		|	_ВсеРаспределенныеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни, 0) КАК РезервыПоСтрахованиюЖизни,
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни, 0) КАК РезервыПоСтрахованиюИномуЧемЖизни,
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива, 0) КАК СобственныеСредстваВРазмереНорматива,
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива, 0) КАК СобственныеСредстваСверхНорматива,
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.Нераспределено, 0) КАК Нераспределено
		|ИЗ
		|	_ВсеРаспределенныеАктивыСтраховойКомпании КАК _ВсеРаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.Нераспределено, 0) > 0";
		
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления); 
	Запрос.УстановитьПараметр("АктивыСтраховойКомпанииВДокументе", Объект.АктивыСтраховойКомпании.Выгрузить());	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("Период", Период);	    	

	ВсеРаспределенныеАктивыСтраховойКомпании = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВсеРаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	ВсеРаспределенныеАктивыСтраховойКомпании.Валюта КАК Валюта,
		|	ВсеРаспределенныеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _АктивыСтраховойКомпании
		|ИЗ
		|	&ВсеРаспределенныеАктивыСтраховойКомпании КАК ВсеРаспределенныеАктивыСтраховойКомпании
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_АктивыСтраховойКомпании.Актив КАК Актив,
		|	_АктивыСтраховойКомпании.Валюта КАК Валюта,
		|	_АктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_АктивыСтраховойКомпании КАК _АктивыСтраховойКомпании
		|ГДЕ
		|	_АктивыСтраховойКомпании.Валюта <> ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета";
	
