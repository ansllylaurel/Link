	|				И (ЗначенияДополнительныхСведенийДляСчетаДоверительногоУправления.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
	|	ГДЕ
	|		(ЗначенияДополнительныхСведенийСрезПоследних.Объект ЕСТЬ NULL
	|					И ЗначенияДополнительныхСведенийДляСчетаДоверительногоУправления.Объект ЕСТЬ NULL
	|				ИЛИ НЕ ЗначенияДополнительныхСведенийДляСчетаДоверительногоУправления.Объект ЕСТЬ NULL
	|					И ЗначенияДополнительныхСведенийСрезПоследних.Значение = ЗначенияДополнительныхСведенийДляСчетаДоверительногоУправления.Значение)) КАК СтоимостьАктивовСрезПоследних
	|		ПОЛНОЕ СОЕДИНЕНИЕ _НоваяСтоимостьАктивовСтраховыхКомпаний КАК _НоваяСтоимостьАктивовСтраховыхКомпаний
	|		ПО СтоимостьАктивовСрезПоследних.СчетДоверительногоУправления = _НоваяСтоимостьАктивовСтраховыхКомпаний.СчетДоверительногоУправления
	|			И СтоимостьАктивовСрезПоследних.Актив = _НоваяСтоимостьАктивовСтраховыхКомпаний.Актив
	|			И СтоимостьАктивовСрезПоследних.Валюта = _НоваяСтоимостьАктивовСтраховыхКомпаний.Валюта
	|			И (ЕСТЬNULL(СтоимостьАктивовСрезПоследних.СубъектПрочегоАктива, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) = ЕСТЬNULL(_НоваяСтоимостьАктивовСтраховыхКомпаний.СубъектПрочегоАктива, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)))
	|ГДЕ
	|	(ЕСТЬNULL(_НоваяСтоимостьАктивовСтраховыхКомпаний.Сумма, 0) <> 0
	|			ИЛИ ЕСТЬNULL(СтоимостьАктивовСрезПоследних.Сумма, 0) <> 0)";
		
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("НоваяСтоимостьАктивовСтраховыхКомпаний",
		НоваяСтоимостьАктивовСтраховыхКомпаний);
		
	Движения.СтоимостьАктивовСтраховыхКомпаний.Загрузить(
		Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры


