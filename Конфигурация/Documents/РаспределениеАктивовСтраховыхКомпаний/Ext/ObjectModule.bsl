
Функция ПолучитьПортфелиСтраховойКомпании(ПортфельДляНераспределенныхАктивов) Экспорт

	ПорфтелиСтраховойКомпании = Новый Структура("Нераспределено", ПортфельДляНераспределенныхАктивов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект,
		|	ЗначенияДополнительныхСведений.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании""
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Родитель = &Родитель";
		
	Запрос.УстановитьПараметр("Родитель", ПортфельДляНераспределенныхАктивов.Родитель);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Значение =  Перечисления.ВидыПортфелейСтраховыхКомпаний.ПортфельВДоверительномУправлении тогда		
				ПорфтелиСтраховойКомпании.Вставить(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Выборка.Значение), Выборка.Объект);
		КонецЕсли;
	КонецЦикла;
	        
	Для каждого ОбъектМД Из Метаданные.Перечисления.ВидыПортфелейСтраховыхКомпаний.ЗначенияПеречисления Цикл
		Если Не ПорфтелиСтраховойКомпании.Свойство(ОбъектМД.Имя) И Не ОбъектМД =Метаданные.Перечисления.ВидыПортфелейСтраховыхКомпаний.ЗначенияПеречисления.ПортфельВДоверительномУправлении  Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти портфель страховой компании по виду '" + ОбъектМД.Представление() + "'");
		КонецЕсли;
	КонецЦикла;    
	
	Возврат ПорфтелиСтраховойКомпании;

КонецФункции // ПолучитьПортфелиСтраховойКомпании

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;	
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиПрочихАктивов");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.СтоимостьАктивовСтраховыхКомпаний");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

////////////////////////////////////////////////////////////////////////////////

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	ЭтотОбъект.Дата=ОбъектКопирования.Дата;


КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта	
	ТекущаяДатаДокумента = ЭтотОбъект.Дата; // для распределения активов важно время распределения, нельзя его сбрасывать в 19:00, пользователи сходят с ума.
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	ЭтотОбъект.Дата = ТекущаяДатаДокумента;

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	ЗапретСверхНормативныхСредств = ДействуютПравилаКонтроля710П();
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда // блокирующие проверки
		
		// отрицательных сумм быть не должно
		Для каждого СтрокаАктивыСтраховойКомпании Из ЭтотОбъект.АктивыСтраховойКомпании Цикл
			
			Если СтрокаАктивыСтраховойКомпании.Нераспределено < 0 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отрицательная нераспределенная сумма актива '" + СтрокаАктивыСтраховойКомпании.Актив + "'",,,, Отказ);
				
			ИначеЕсли СтрокаАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни < 0
				Или СтрокаАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни < 0
				Или СтрокаАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива < 0
				Или СтрокаАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива < 0
			Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отрицательная распределенная сумма актива '" + СтрокаАктивыСтраховойКомпании.Актив + "'",,,, Отказ);
				
			КонецЕсли;
			
			Если СтрокаАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива > 0 И ЗапретСверхНормативныхСредств Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для контроля по правилам 710-П нельзя инвестировать в активы собственные средства сверх норматива. '" + СтрокаАктивыСтраховойКомпании.Актив + "'",,,, Отказ);
			
				
			КонецЕсли;
			
		КонецЦикла;		
		
		Период =  ЭтотОбъект.Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктивыСтраховойКомпанииВДокументе.Актив КАК Актив,
	|	АктивыСтраховойКомпанииВДокументе.Валюта КАК Валюта,
	|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюЖизни КАК РезервыПоСтрахованиюЖизни,
	|	АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюИномуЧемЖизни КАК РезервыПоСтрахованиюИномуЧемЖизни,
	|	АктивыСтраховойКомпанииВДокументе.СобственныеСредстваВРазмереНорматива КАК СобственныеСредстваВРазмереНорматива,
	|	АктивыСтраховойКомпанииВДокументе.СобственныеСредстваСверхНорматива КАК СобственныеСредстваСверхНорматива,
	|	АктивыСтраховойКомпанииВДокументе.Нераспределено КАК Нераспределено
	|ПОМЕСТИТЬ _АктивыСтраховойКомпанииВДокументе
	|ИЗ
	|	&АктивыСтраховойКомпанииВДокументе КАК АктивыСтраховойКомпанииВДокументе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_АктивыСтраховойКомпанииВДокументе.Актив КАК Актив,
	|	_АктивыСтраховойКомпанииВДокументе.Валюта КАК Валюта,
	|	_АктивыСтраховойКомпанииВДокументе.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюЖизни КАК РезервыПоСтрахованиюЖизни,
	|	_АктивыСтраховойКомпанииВДокументе.РезервыПоСтрахованиюИномуЧемЖизни КАК РезервыПоСтрахованиюИномуЧемЖизни,
	|	_АктивыСтраховойКомпанииВДокументе.СобственныеСредстваВРазмереНорматива КАК СобственныеСредстваВРазмереНорматива,
	|	_АктивыСтраховойКомпанииВДокументе.СобственныеСредстваСверхНорматива КАК СобственныеСредстваСверхНорматива,
	|	_АктивыСтраховойКомпанииВДокументе.Нераспределено КАК Нераспределено
	|ПОМЕСТИТЬ _ВсеРаспределенныеАктивыСтраховойКомпании
	|ИЗ
	|	_АктивыСтраховойКомпанииВДокументе КАК _АктивыСтраховойКомпанииВДокументе
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Актив,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Валюта,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Нераспределено
	|ИЗ
	|	Документ.РаспределениеАктивовСтраховыхКомпаний.АктивыСтраховойКомпании КАК РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании
	|ГДЕ
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.Проведен = ИСТИНА
	|	И РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления.Родитель = ВЫРАЗИТЬ(&СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).Родитель
	|	И РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.СчетДоверительногоУправления <> &СчетДоверительногоУправления
	|	И КОНЕЦПЕРИОДА(РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВсеРаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
	|	_ВсеРаспределенныеАктивыСтраховойКомпании.Валюта КАК Валюта,
	|	_ВсеРаспределенныеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни, 0) КАК РезервыПоСтрахованиюЖизни,
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни, 0) КАК РезервыПоСтрахованиюИномуЧемЖизни,
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива, 0) КАК СобственныеСредстваВРазмереНорматива,
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива, 0) КАК СобственныеСредстваСверхНорматива,
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.Нераспределено, 0) КАК Нераспределено
	|ИЗ
	|	_ВсеРаспределенныеАктивыСтраховойКомпании КАК _ВсеРаспределенныеАктивыСтраховойКомпании
	|ГДЕ
	|	ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.РезервыПоСтрахованиюИномуЧемЖизни, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваВРазмереНорматива, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.СобственныеСредстваСверхНорматива, 0) + ЕСТЬNULL(_ВсеРаспределенныеАктивыСтраховойКомпании.Нераспределено, 0) > 0";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления); 
	Запрос.УстановитьПараметр("АктивыСтраховойКомпанииВДокументе", ЭтотОбъект.АктивыСтраховойКомпании.Выгрузить());	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);	
	Запрос.УстановитьПараметр("Период", Период);	    	

	ВсеРаспределенныеАктивыСтраховойКомпании = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВсеРаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
	|	ВсеРаспределенныеАктивыСтраховойКомпании.Валюта КАК Валюта,
	|	ВсеРаспределенныеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ПОМЕСТИТЬ _АктивыСтраховойКомпании
	|ИЗ
	|	&ВсеРаспределенныеАктивыСтраховойКомпании КАК ВсеРаспределенныеАктивыСтраховойКомпании
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_АктивыСтраховойКомпании.Актив КАК Актив,
	|	_АктивыСтраховойКомпании.Валюта КАК Валюта,
	|	_АктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ИЗ
	|	_АктивыСтраховойКомпании КАК _АктивыСтраховойКомпании
	|ГДЕ
	|	_АктивыСтраховойКомпании.Валюта <> ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета";
	
	Запрос.УстановитьПараметр("ВсеРаспределенныеАктивыСтраховойКомпании", ВсеРаспределенныеАктивыСтраховойКомпании);	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);	
	ВсеВалютныеАктивы = Запрос.Выполнить().Выгрузить();  	
	
	КурсыВалютАктивовСтраховойКомпании =  Документы.РаспределениеАктивовСтраховыхКомпаний.ПолучитьКурсыВалютДляАктивовСтраховойКомпании(
			ВсеВалютныеАктивы, Период, ЭтотОбъект.Организация);
			                                                     		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Актив КАК Актив,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Валюта КАК Валюта,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.РезервыПоСтрахованиюЖизни КАК РезервыПоСтрахованиюЖизни,
