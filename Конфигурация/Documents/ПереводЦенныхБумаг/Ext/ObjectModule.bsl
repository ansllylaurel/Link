
Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;

	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("ДепозитарныйСчет",             ЭтотОбъект.ДепозитарныйСчет);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок);
	
	ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
	ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага", "ЦеннаяБумага");
	
	Если ЭтотОбъект.ПереводСЗаблокированногоСчета Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("ВидБлокировкиАктива",          Перечисления.ВидыБлокировокАктивов.Погашение);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("ДепозитарныйСчет",             ЭтотОбъект.ДепозитарныйСчет);
		ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЭтотОбъект.Рынок); 		
		
		ЭлементБлокировкиДанных.ИсточникДанных = ЭтотОбъект.ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага", "ЦеннаяБумага");
	
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать 					= Истина;
	Движения.ОстаткиЦенныхБумагЗаблокированные.Записывать 	= Истина;

	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
		// расход ц/б
		Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
				
		// приход ц/б
		Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчетПолучатель;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
		
		Если ЭтотОбъект.ПереводСЗаблокированногоСчета Тогда
			
			// расход ц/б заблокированных
			Движение = Движения.ОстаткиЦенныхБумагЗаблокированные.ДобавитьРасход();
			Движение.ВидБлокировкиАктива		  = Перечисления.ВидыБлокировокАктивов.Погашение;		
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
					
			// приход ц/б заблокированных
			Движение = Движения.ОстаткиЦенныхБумагЗаблокированные.ДобавитьПриход();
			Движение.ВидБлокировкиАктива		  = Перечисления.ВидыБлокировокАктивов.Погашение;
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчетПолучатель;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.Записать();
	
	// проверим отрицательные остатки
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
	Если ЭтотОбъект.ПереводСЗаблокированногоСчета Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумагЗаблокированных(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроверитьПереводМеждуСпецдепами(Отказ)
	
	ДепозитарийОтправитель 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ДепозитарныйСчет, 			"Депозитарий");
	ДепозитарийПолучатель 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ДепозитарныйСчетПолучатель, 	"Депозитарий");
	
	Если ДепозитарийОтправитель = ДепозитарийПолучатель Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО КАК СделкаРЕПО,
	    |	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВозврата,
	    |	ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага В (&ЦенныеБумаги)
	    |		ИЛИ ЗадолженностиПоВторойЧастиРЕПООстатки.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)) КАК БлокироватьПроведение
	    |ИЗ
	    |	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
	    |			&ПериодГраница,
	    |			Организация = &Организация
	    |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				И Рынок = &Рынок) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
	    |				&ПериодГраница,
	    |				Организация = &Организация
	    |					И ДепозитарныйСчет = &ДепозитарныйСчет
	    |					И Рынок = &Рынок
	    |					И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
	    |		ПО ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
	    |			И ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
	    |ГДЕ
	    |	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &Период");
	
	Запрос.УстановитьПараметр("Период", 						КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПериодГраница", 					Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарныйСчет",             	ЭтотОбъект.ДепозитарныйСчет);
	Запрос.УстановитьПараметр("Рынок",                        	ЭтотОбъект.Рынок);
	Запрос.УстановитьПараметр("ЦенныеБумаги", 					ЭтотОбъект.ЦенныеБумаги.ВыгрузитьКолонку("ЦеннаяБумага"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У сделки РЕПО " + СокрЛП(Выборка.СделкаРЕПО) + " дата второй части " + Формат(Выборка.ДатаВозврата, "ДФ=dd.MM.yyyy") + " позже даты перевода", Выборка.СделкаРЕПО);
		Отказ = Макс(Отказ, Выборка.БлокироватьПроведение);
	КонецЦикла;
		
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		// ценная бумага должна быть уникальной
		РазличныеЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага");
		РазличныеЦенныеБумаги.Свернуть("ЦеннаяБумага");
		
		Если ЭтотОбъект.ЦенныеБумаги.Количество() <> РазличныеЦенныеБумаги.Количество()  Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ценная бумага может быть выбрана в табличной части только один раз!", ЭтотОбъект.ЦенныеБумаги,,, Отказ);
		КонецЕсли;
		
		ТипЦеннойБумаги = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ЭтотОбъект.Рынок);
		
		Для НомСтр = 0 По ЭтотОбъект.ЦенныеБумаги.Количество() - 1 Цикл
			СтрокаЦенныеБумаги = ЭтотОбъект.ЦенныеБумаги[НомСтр];
			
			// для рынка векселей проверим количество
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя И СтрокаЦенныеБумаги.Количество <> 1 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество векселей в строке № " + (НомСтр + 1) + " отлично от 1. Обратитесь к разработчикам.",,,, Отказ);
			КонецЕсли;
			
			// проверим, что рынок соответствует типу ценной бумаги
			Если Не ТипЦеннойБумаги.СодержитТип(ТипЗнч(СтрокаЦенныеБумаги.ЦеннаяБумага)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип ценной бумаги в строке № " + (НомСтр + 1) + " не соответствует рынку " + ЭтотОбъект.Рынок + ".",,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// При переводе между спец. депами нужно проверить, что нет незавершенных сделок РЕПО с датой второй части позже даты перевода
	ПроверитьПереводМеждуСпецдепами(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти
