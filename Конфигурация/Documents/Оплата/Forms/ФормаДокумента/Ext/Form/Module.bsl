&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоговуюСтрокуОснований(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	
	ОбщаяСуммаОплаты       = 0;
	ОбщаяСуммаОплатыКупона = 0;
	
	Для каждого СтрокаДанныеОснования Из ДанныеОбъекта.Основания Цикл
		ОбщаяСуммаОплаты       = ОбщаяСуммаОплаты + СтрокаДанныеОснования.СуммаОплаты;
		ОбщаяСуммаОплатыКупона = ОбщаяСуммаОплатыКупона + СтрокаДанныеОснования.СуммаОплатыКупона;
	КонецЦикла;
	
	ИтоговаяСтрокаОснования = "Итого: " + ОбщаяСуммаОплаты + " " + ДанныеОбъекта.ВалютаОплаты;
		
	Если ОбщаяСуммаОплатыКупона > 0 Тогда
		ИтоговаяСтрокаОснования = ИтоговаяСтрокаОснования + ", купона " + ОбщаяСуммаОплатыКупона + " " + ДанныеОбъекта.ВалютаОплаты
			+ ", всего " + (ОбщаяСуммаОплаты + ОбщаяСуммаОплатыКупона) + " " + ДанныеОбъекта.ВалютаОплаты;
	КонецЕсли;			
			
	Форма.Элементы.НадписьИтоговаяСтрокаОснования.Заголовок = ИтоговаяСтрокаОснования;
	
КонецПроцедуры // ОбновитьИтоговуюСтрокуОснований

&НаСервереБезКонтекста
Функция ОпределитьБазовыйТипЗадолженности(ВидЗадолженности)
	Возврат Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ВидЗадолженности);
КонецФункции

&НаСервере
Функция ПроверитьНаличиеЗадолженностиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&ТипЗадолженности КАК ТипЗадолженности,
		|	&ВидЗадолженности КАК ВидЗадолженности,
		|	ОснованияОплаты.Основание КАК Основание,
		|	ОснованияОплаты.Валюта КАК Валюта,
		|	ОснованияОплаты.Сумма КАК Сумма,
		|	ОснованияОплаты.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _ОснованияОплаты
		|ИЗ
		|	&ОснованияОплаты КАК ОснованияОплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОснованияОплаты.Основание КАК Основание,
		|	СУММА(_ОснованияОплаты.Сумма) КАК Сумма,
		|	СУММА(_ОснованияОплаты.СуммаКупона) КАК СуммаКупона,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток, 0)) КАК СуммаКупонаОстаток,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) КАК СуммаДвижения,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.СуммаКупона, 0)) КАК СуммаКупонаДвижения
		|ИЗ
		|	_ОснованияОплаты КАК _ОснованияОплаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = &ТипЗадолженности
		|					И ВидЗадолженности = &ВидЗадолженности
		|					И Валюта В
		|						(ВЫБРАТЬ
		|							_ОснованияОплаты.Валюта
		|						ИЗ
		|							_ОснованияОплаты)
		|					И Основание В
		|						(ВЫБРАТЬ
		|							_ОснованияОплаты.Основание
		|						ИЗ
		|							_ОснованияОплаты)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО _ОснованияОплаты.Организация = ЗадолженностиПоДенежнымСредствамОстатки.Организация
		|			И _ОснованияОплаты.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления
		|			И _ОснованияОплаты.ТипЗадолженности = ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности
		|			И _ОснованияОплаты.ВидЗадолженности = ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности
		|			И _ОснованияОплаты.Валюта = ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|			И _ОснованияОплаты.Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО (ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор)
		|			И _ОснованияОплаты.Организация = ЗадолженностиПоДенежнымСредствам.Организация
		|			И _ОснованияОплаты.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления
		|			И _ОснованияОплаты.ТипЗадолженности = ЗадолженностиПоДенежнымСредствам.ТипЗадолженности
		|			И _ОснованияОплаты.ВидЗадолженности = ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
		|			И _ОснованияОплаты.Валюта = ЗадолженностиПоДенежнымСредствам.Валюта
		|			И _ОснованияОплаты.Основание = ЗадолженностиПоДенежнымСредствам.Основание
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОснованияОплаты.Основание
		|
		|ИМЕЮЩИЕ
		|	(СУММА(_ОснованияОплаты.Сумма) > СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток, 0)) + СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0))
		|		ИЛИ СУММА(_ОснованияОплаты.СуммаКупона) > СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток, 0)) + СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.СуммаКупона, 0)))";
	
	Запрос.УстановитьПараметр("Период",                       ?(ЗначениеЗаполнено(Объект.Ссылка), Новый МоментВремени(Объект.Дата, Объект.Ссылка), Неопределено));
	Запрос.УстановитьПараметр("Регистратор",                  Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТипЗадолженности",             РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(Объект.ВидДвижения));
	Запрос.УстановитьПараметр("ВидЗадолженности",             Объект.ВидЗадолженности);
	Запрос.УстановитьПараметр("ОснованияОплаты",              Объект.Основания.Выгрузить(, "Основание, Валюта, Сумма, СуммаКупона"));
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции // ПроверитьНаличиеЗадолженностиНаСервере

&НаСервереБезКонтекста
Функция ПолучитьВалютуВозвратногоКупона(Основание, Организация, СчетДоверительногоУправления)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|				И Основание = &Основание) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество()>1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По основанию " + Основание + " обнаружена задолженность по возврату купонного дохода в нескольких валютах! Валюта в документе может быть заполнена некорректно.");
	КонецЕсли;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Валюта;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРасчетныеПоляОснованийНаСервере(НомерСтроки = Неопределено)
	
	Если Объект.Основания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОснованияОплаты.НомерСтроки КАК НомерСтроки,
		|	ОснованияОплаты.Основание КАК Основание,
		|	ОснованияОплаты.Валюта КАК Валюта
		|ПОМЕСТИТЬ _ОснованияОплаты
		|ИЗ
		|	&ОснованияОплаты КАК ОснованияОплаты
		|ГДЕ
		|	(ОснованияОплаты.НомерСтроки = &НомерСтроки
		|			ИЛИ &НомерСтроки = НЕОПРЕДЕЛЕНО)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОснованияОплаты.Основание,
		|	ОснованияОплаты.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаЗадолженности
		|ПОМЕСТИТЬ _ЗадолженностьПоОснованиямОплаты
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ТипЗадолженности = &ТипЗадолженности
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Основание В (&Основания)
		|				И Контрагент = &Контрагент) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокСрезПоследних.Сделка КАК Основание,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплаты
		|ПОМЕСТИТЬ _УсловияСделок
		|ИЗ
		|	РегистрСведений.УсловияСделок.СрезПоследних(
		|			&Период,
		|			НЕ Отменено
		|				И Сделка В (&Основания)) КАК УсловияСделокСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.ДатаОплаты
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&Период,
		|			НЕ Отменено
		|				И СделкаРЕПО В (&Основания)
		|				И ЧастьСделкиРЕПО = &ЧастьСделкиРЕПО) КАК УсловияСделокРЕПОСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОснованияОплаты.НомерСтроки КАК НомерСтроки,
		|	_УсловияСделок.ДатаОплаты КАК ПлановаяДатаОплаты,
		|	_ЗадолженностьПоОснованиямОплаты.СуммаЗадолженности КАК СуммаЗадолженности,
		|	_ЗадолженностьПоОснованиямОплаты.СуммаКупонаЗадолженности КАК СуммаКупонаЗадолженности
		|ИЗ
		|	_ОснованияОплаты КАК _ОснованияОплаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьПоОснованиямОплаты КАК _ЗадолженностьПоОснованиямОплаты
		|		ПО (_ЗадолженностьПоОснованиямОплаты.ВидЗадолженности = &ВидЗадолженности)
		|			И _ОснованияОплаты.Основание = _ЗадолженностьПоОснованиямОплаты.Основание
		|			И _ОснованияОплаты.Валюта = _ЗадолженностьПоОснованиямОплаты.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияСделок КАК _УсловияСделок
		|		ПО _ОснованияОплаты.Основание = _УсловияСделок.Основание";
		
	Запрос.УстановитьПараметр("ОснованияОплаты",              Объект.Основания.Выгрузить());
	Запрос.УстановитьПараметр("НомерСтроки",                  НомерСтроки);	
	Запрос.УстановитьПараметр("Период",                       Новый Граница(Объект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Основания",                    Объект.Основания.Выгрузить(, "Основание").ВыгрузитьКолонку("Основание"));
	Запрос.УстановитьПараметр("ТипЗадолженности",             РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(Объект.ВидДвижения));
	Запрос.УстановитьПараметр("ВидЗадолженности",             Объект.ВидЗадолженности);
	Запрос.УстановитьПараметр("ЧастьСделкиРЕПО",              РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьЧастьСделкиРЕПОПоВидуЗадолженности(Объект.ВидЗадолженности));
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент",                   Объект.Контрагент);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	// прямая выгрузка в реквизит не катит, т.к. заметна глазу, поэтому пройдемся циклом по строкам
	Выборка = Запрос.Выполнить().Выбрать();
	
	// почему-то, при заполнении коллекции на форме, теряются значения суммовых полей,
	// а плановая дата (типа "Дата") остается заполненной
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.Основания[Выборка.НомерСтроки - 1], Выборка, "ПлановаяДатаОплаты, СуммаЗадолженности, СуммаКупонаЗадолженности");
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляОснованийНаСервере

&НаСервере
Функция ЗаполнитьОснованияОстаткамиЗадолженностиНаСервере(ХранилищеВыбЗадолженности, ОбновитьРеквизитыШапки = Ложь)
	
	ОстаткиЗадолженности = ХранилищеВыбЗадолженности.Получить();
		
	// при подборе, в ряде случаев, возможен неуникальный ключ тип + вид задолженности
	ВариантыЗадолженности = ОстаткиЗадолженности.Скопировать(, "СчетДоверительногоУправления, ТипЗадолженности, ВидЗадолженности");
	ВариантыЗадолженности.Свернуть("СчетДоверительногоУправления, ТипЗадолженности, ВидЗадолженности", "");
	
	Если ВариантыЗадолженности.Количество() > 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// заполним документ
	
	Для НомСтр = 0 По ОстаткиЗадолженности.Количество() - 1 Цикл
		СтрокаОстаткиЗадолженности = ОстаткиЗадолженности[НомСтр];
		
		НоваяСтрокаОснования = Объект.Основания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОснования, СтрокаОстаткиЗадолженности);
		
		НоваяСтрокаОснования.СуммаЗадолженности			 = НоваяСтрокаОснования.Сумма;
		НоваяСтрокаОснования.СуммаКупонаЗадолженности	 = НоваяСтрокаОснования.СуммаКупона;
		
		Если ОбновитьРеквизитыШапки И НомСтр = 0 Тогда
			ЗаполнитьЗначенияСвойств(Объект, СтрокаОстаткиЗадолженности);
			Объект.ВидДвижения = РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьВидДвиженияПоТипуЗадолженности(СтрокаОстаткиЗадолженности.ТипЗадолженности);
			
			Документы.Оплата.ЗаполнитьДатуИВалютуОплатыПоПервойСтрокеОснования(Объект);			
		КонецЕсли;
		
		Документы.Оплата.ЗаполнитьДанныеКонтрагента(Объект, НоваяСтрокаОснования);
	КонецЦикла;
	
	
	Возврат Истина;
	
КонецФункции // ЗаполнитьОснованияОстаткамиЗадолженностиНаСервере

&НаСервере
Процедура ЗаполнитьНастройкиОтображенияНаСервере()
	
	ВыбБрокеры = Новый Массив();
	
	ЭтаФорма.ОтображатьКурсыОплат = Ложь; 
	
	Для каждого СтрокаОснования Из Объект.Основания Цикл
		Если Не ЭтаФорма.ОтображатьКурсыОплат И ЗначениеЗаполнено(Объект.ВалютаОплаты) И ЗначениеЗаполнено(СтрокаОснования.Валюта) И Объект.ВалютаОплаты <> СтрокаОснования.Валюта Тогда
			ЭтаФорма.ОтображатьКурсыОплат = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

