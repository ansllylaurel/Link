
#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) И Объект.ПометкаУдаления Тогда // "отказ" при обработке заполнения
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Объект.Комментарий,,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ТипЗнч(ЭтаФорма.Параметры.Основание) = Тип("ДокументСсылка.РаспределениеДоходаПайщикам") 
			И ЗначениеЗаполнено(ЭтаФорма.Параметры.Основание.Основание) Тогда
			ЭтаФорма.ДокументОснование = ЭтаФорма.Параметры.Основание.Основание; // возможно, потребуется для интерактивного выбора задолженности
		Иначе
			ЭтаФорма.ДокументОснование = ЭтаФорма.Параметры.Основание; // возможно, потребуется для интерактивного выбора задолженности
		КонецЕсли;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ДокументОснование) И Не ЗначениеЗаполнено(Объект.ВидДвижения) Тогда // требуется интерактивный выбор списываемой задолженности
		ПараметрыПодбора = Новый Структура("МножественныйВыбор, ЗакрыватьПустой, Организация, СчетДоверительногоУправления, Брокер, МестоХранения, Основание, РасчетныйСчет");
		ЗаполнитьЗначенияСвойств(ПараметрыПодбора, Объект);
		
		ПараметрыПодбора.МножественныйВыбор = Истина;
		ПараметрыПодбора.ЗакрыватьПустой    = Истина;
		ПараметрыПодбора.Основание          = ЭтаФорма.ДокументОснование;
		
		ХранилищеВыбЗадолженности = ОткрытьФормуМодально("ОбщаяФорма.ПодборЗадолженностиПоДенежнымСредствам", ПараметрыПодбора, ЭтаФорма);
		
		Если ТипЗнч(ХранилищеВыбЗадолженности) = Тип("ХранилищеЗначения") Тогда
			Если Не ЗаполнитьОснованияОстаткамиЗадолженностиНаСервере(ХранилищеВыбЗадолженности, Истина) Тогда
				Предупреждение("При подборе следует выбирать только один тип и вид задолженности по одному счету д/у.");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ОснованияПриИзменении(Неопределено);
		
		НастроитьВидимостьИДоступность(ЭтаФорма);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для каждого СтрокаОснования Из Объект.Основания Цикл
			КурсВалютыОплаты = ?(СтрокаОснования.СобственныйКурсОплаты,СтрокаОснования.КурсОплаты,Объект.Дата);	
			СтрокаОснования.СуммаОплаты = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаОснования.Сумма, СтрокаОснования.Валюта, КурсВалютыОплаты, Объект.ВалютаОплаты, Объект.Дата); 
			СтрокаОснования.СуммаОплатыКупона = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаОснования.СуммаКупона, СтрокаОснования.Валюта, КурсВалютыОплаты, Объект.ВалютаОплаты, Объект.Дата); 
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ОплатаЧерезБрокера = ЗначениеПереключателяБрокер() Тогда
		ПроверяемыеРеквизиты.Добавить("Брокер");
	КонецЕсли;
	
	Если ЭтаФорма.ДетализацияПоРасчетномуСчету
		И ЭтаФорма.ОплатаЧерезБрокера <> ЗначениеПереключателяБиржа()
	Тогда
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчет");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	ЗаполнитьРасчетныеПоляОснованийНаСервере();
	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	Если      Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПогашениюКупона") Тогда
		Оповестить("СводноеПогашениеКупона.Обновить", Объект.Ссылка);
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПогашениюОблигации") Тогда
		Оповестить("СводноеПогашениеОблигации.Обновить", Объект.Ссылка);
	ИначеЕсли Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции") 
		или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи")
		или Объект.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки") Тогда
		Оповестить("СводноеНачислениеДивидендов.Обновить", Объект.Ссылка);
	КонецЕсли;
	
	Оповестить("БанковкиеВыписки.Обновить", Объект.Ссылка);
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") И ИсточникВыбора.ИмяФормы = "Документ.СтрокаБанковскойВыписки.Форма.БанковкиеВыписки" Тогда
		Если ИсточникВыбора.ИсточникВыбора = "СтрокаБанковскойВыписки" Тогда
			
			Объект.СтрокаБанковскойВыписки   = ВыбранноеЗначение;
			ЭтаФорма.СтрокаБанковскойВыписки = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
			
		КонецЕсли;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли; 	
	Иначе		
		РаботаСДокументамиКлиент.ОбработкаОповещенияФормыДокумента(ЭтаФорма, Объект.Ссылка, ИмяСобытия, Параметр, Источник);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыОплатыНаСервере()
	
	Для Каждого СтрокаОснования Из Объект.Основания Цикл
		
		Если СтрокаОснования.СобственныйКурсОплаты Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаОснования.КурсОплаты) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + СтрокаОснования.НомерСтроки  + " не указан курс оплаты.");	
			КонецЕсли;
			
			Продолжить;
		Иначе
			
			Если СтрокаОснования.Сумма <> 0 Тогда
				СтрокаОснования.СуммаОплаты = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаОснования.Сумма, СтрокаОснования.Валюта, Объект.Дата, Объект.ВалютаОплаты, Объект.Дата);
			КонецЕсли;
			
			Если СтрокаОснования.СуммаКупона <> 0 Тогда 
				СтрокаОснования.СуммаОплатыКупона = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаОснования.СуммаКупона, СтрокаОснования.Валюта, Объект.Дата, Объект.ВалютаОплаты, Объект.Дата);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
 
#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если Не ПроверитьНаличиеЗадолженностиНаСервере() Тогда
		КомандаОчиститьОснования(Неопределено);
	КонецЕсли;
		
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.ОплатаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	ПересчитатьСуммыОплатыНаСервере(); 	
	
	ЗаполнитьРасчетныеПоляОснованийНаСервере();
	ЗаполнитьНастройкиОтображенияНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДвиженияПриИзменении(Элемент)
	
	//Пока не отработаны авансы полученные для клиента.
	Если Объект.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход") Тогда
		Объект.Аванс = Ложь;	
	КонецЕсли; 
	
	КомандаОчиститьОснования(Неопределено);
	
	НастроитьВидимостьИДоступность(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	КомандаОчиститьОснования(Неопределено);
	// !!! ВРЕМЕННО НЕ ПРОВЕРЯЕМ (09.10.2024)
	//ОбновитьНеобходимостьПроверкиРеквизитаДоговор();
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	// !!! ВРЕМЕННО НЕ ПРОВЕРЯЕМ (09.10.2024)
	//ОбновитьНеобходимостьПроверкиРеквизитаДоговор();
КонецПроцедуры

&НаКлиенте
Процедура ОплатаЧерезБрокераПриИзменении(Элемент)
	
	Объект.Брокер		 = Неопределено;
	Объект.МестоХранения = Неопределено;
	
	Если ЭтаФорма.ОплатаЧерезБрокера = ЗначениеПереключателяБиржа() Тогда
		Объект.МестоХранения			 = ПредопределенноеЗначение("Справочник.МестаХранения.ММВБ_ДепозитыСЦК");
		Объект.СтрокаБанковскойВыписки	 = Неопределено;
		ЭтаФорма.СтрокаБанковскойВыписки = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
	КонецЕсли;
	
	БрокерПриИзменении(Элемент);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	КомандаОчиститьОснования(Неопределено);
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура МестоХраненияПриИзменении(Элемент)
	
	КомандаОчиститьОснования(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	
	КомандаОчиститьОснования(Неопределено);
	
	Если Объект.ВидЗадолженности <> ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ОшибочноеСписание")
		И Объект.ВидЗадолженности <> ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимУслугам") Тогда
		
		Объект.КоррСчет = ПредопределенноеЗначение("ПланСчетов.Основной.ПустаяСсылка");
		КоррСчетПриИзменении(Элемент);
		
		Объект.КоррСчетЕПС = ПредопределенноеЗначение("ПланСчетов.Единый.ПустаяСсылка");
		КоррСчетЕПСПриИзменении(Элемент);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВидЗадолженности) И ЗначениеЗаполнено(Объект.Поручение) Тогда
		
		Если Не ДоступноСозданиеОплатыПоВидуЗадолженностиНаОснованииПоручения(Объект.ВидЗадолженности)
			И Вопрос("Нельзя создавать оплату с видом задолженности [" + Объект.ВидЗадолженности + "] на основании поручения. Очистить значение поля [Поручение]?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			
			Объект.Поручение = Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма, Элемент);
	
	Если Объект.Основания.Количество() > 0 Тогда
		ОбновитьИтоговуюСтрокуОснований(ЭтаФорма);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда
		ВалютаРасчетногоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РасчетныйСчет, "Валюта");
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Объект.ВалютаОплаты <> ВалютаРасчетногоСчета Тогда
		
		Объект.ВалютаОплаты = ВалютаРасчетногоСчета;
		ВалютаОплатыПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыПриИзменении(Элемент)
	
	//Для прочих доходов и расходов документ-основание не заполняется и валюта сделки = валюте оплаты
	Для Каждого СтрокаОснования Из Объект.Основания Цикл
		
		Если(СтрокаОснования.Валюта <> Объект.ВалютаОплаты) И НЕ ЗначениеЗаполнено(СтрокаОснования.Основание) Тогда
			СтрокаОснования.Валюта = Объект.ВалютаОплаты;
		КонецЕсли;
		
	КонецЦикла;
	
	ПересчитатьСуммыОплатыНаСервере();
	ЗаполнитьНастройкиОтображенияНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаОплатыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СверитьВыбранноеЗначениеВалютыСВалютойРасчетногоСчета(ВыбранноеЗначение, Объект.ВалютаОплаты, Объект.РасчетныйСчет);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаБанковскойВыпискиНажатие(Элемент, СтандартнаяОбработка)
	
	ПолнаяСуммаОплаты = 0;
	
	Для каждого СтрокаОснования Из Объект.Основания Цикл
		ПолнаяСуммаОплаты = СтрокаОснования.Сумма + СтрокаОснования.СуммаКупона;
	КонецЦикла;
	
	РаботаСБанковскимиВыпискамиКлиентСервер.ВыполнитьДействиеСоСтрокойБанковскойВыписки(
		Новый Структура("Период, Организация, РасчетныйСчет, ВидДвижения, Сумма, Контрагент, РасчетныйСчетКонтрагента",
			Объект.Дата,
			Объект.Организация,
			Объект.РасчетныйСчет,
			Объект.ВидДвижения,
			ПолнаяСуммаОплаты,
			Объект.Контрагент,
			Объект.РасчетныйСчетКонтрагента),
		"СтрокаБанковскойВыписки",
		ЭтаФорма,
		СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура АвансПриИзменении(Элемент)
		
	КомандаОчиститьОснования(Неопределено);
	
	Если НЕ Объект.Аванс Тогда
		Объект.ОбеспечительныйПлатеж = Ложь;
		Объект.ДатаПлановогоПогашенияЗадолженности = Дата(1,1,1,0,0,0);
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбеспечительныйПлатежПриИзменении(Элемент)
	
	Если Объект.ОбеспечительныйПлатеж и НЕ Объект.Аванс = Истина Тогда
		
		Объект.Аванс = Истина;
		
		КомандаОчиститьОснования(Неопределено);
		НастроитьВидимостьИДоступность(ЭтаФорма, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоррСчетПриИзменении(Элемент)
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Объект.Организация, Объект.КоррСчет);
	
	Для Инд = 1 По 3 Цикл
		Если НЕ ЭтаФорма.Элементы["Субконто" + Строка(Инд)].Доступность Тогда
			Объект["Субконто" + Строка(Инд)] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КоррСчетЕПСПриИзменении(Элемент)
	
	УстановитьЗаголовкиИДоступностьСубконтоЕПС(ЭтаФорма, Объект.Организация, Объект.КоррСчетЕПС);
	
	Для Инд = 1 По 3 Цикл
		Если НЕ ЭтаФорма.Элементы["СубконтоЕПС" + Строка(Инд)].Доступность Тогда
			Объект["Субконто" + Строка(Инд)] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ТЧ_ОСНОВАНИЯ

&НаКлиенте
Процедура ОснованияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Валюта) Тогда
		ТекущиеДанные.Валюта = Объект.ВалютаОплаты;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияПриИзменении(Элемент)
	
	ОбновитьИтоговуюСтрокуОснований(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияОснованиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Основания.ТекущиеДанные;
	ТипОснования  = ТипЗнч(ТекущиеДанные.Основание);
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Основание) Тогда
		Если ТипОснования <> Тип("Неопределено") Тогда
			Возврат;
		Иначе	
			ТекущиеДанные.Валюта = Объект.ВалютаОплаты;
		КонецЕсли;	
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.Сделка") Или ТипОснования = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Если Объект.ВидЗадолженности <> ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода") Тогда
			ТекущиеДанные.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Основание, "ВалютаСделки");              	
		Иначе
			ТекущиеДанные.Валюта = ПолучитьВалютуВозвратногоКупона(ТекущиеДанные.Основание, Объект.Организация, Объект.СчетДоверительногоУправления);
		КонецЕсли;
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.НачислениеЗадолженности") или ТипОснования = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		ТекущиеДанные.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Основание, "Валюта");
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.НачислениеДивидендов") или ТипОснования = Тип("ДокументСсылка.ПогашениеКупона") или ТипОснования = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		ТекущиеДанные.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Основание, "ВалютаОплаты");
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента") Тогда 	
		ТекущиеДанные.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Основание, "РасчетныйСчет.Валюта");
	КонецЕсли;
	
	ЗаполнитьРасчетныеПоляОснованийНаСервере(ТекущиеДанные.НомерСтроки);
	
	ЗаполнитьНастройкиОтображенияНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаОплатыПриИзменении(Элемент)
	
	ПересчитатьСуммыДолга(Этаформа.Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаОплатыКупонаПриИзменении(Элемент)
	
	ПересчитатьСуммыДолга(Этаформа.Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаПриИзменении(Элемент)
	
	ПересчитатьСуммыОплаты(Этаформа.Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСуммаКупонаПриИзменении(Элемент)
	
	ПересчитатьСуммыОплаты(Этаформа.Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСобственныйКурсОплатыПриИзменении(Элемент)
	
	ТД = Этаформа.Элементы.Основания.ТекущиеДанные;
	
	Если Не ТД.СобственныйКурсОплаты Тогда
		ТД.КурсОплаты = 0;
	КонецЕсли;
	
	Если ТД.СобственныйКурсОплаты И Не ЗначениеЗаполнено(ТД.КурсОплаты) Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСуммыОплаты(ТД);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияКурсОплатыПриИзменении(Элемент)
	
	ТД = Этаформа.Элементы.Основания.ТекущиеДанные;
	
	Если ТД.СобственныйКурсОплаты И Не ЗначениеЗаполнено(ТД.КурсОплаты) Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСуммыОплаты(ТД);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияСтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаПодборОснований(Команда)
	
	// обязательные поля отбора
	ПараметрыПодбора = Новый Структура("МножественныйВыбор", Истина);
	
	// не обязательные поля отбора, передача которых определяется заполненными полями
	ПоляОтбораЗадолженности = "Организация, ВидЗадолженности, СчетДоверительногоУправления, МестоХранения";
	ПоляОтбораЗадолженности = СтрЗаменить(ПоляОтбораЗадолженности, ", ", Символы.ПС);
	
	Для НомСтр = 1 По СтрЧислоСтрок(ПоляОтбораЗадолженности) Цикл
		ПолеОтбораЗадолженности = СтрПолучитьСтроку(ПоляОтбораЗадолженности, НомСтр);
		Если ЗначениеЗаполнено(Объект[ПолеОтбораЗадолженности]) Тогда
			ПараметрыПодбора.Вставить(ПолеОтбораЗадолженности, Объект[ПолеОтбораЗадолженности]);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыПодбора.Вставить("Период", РаботаСДокументами.ПолучитьМоментВремени(Объект.Ссылка));
	
	// не обязательные поля, которые соответствуют не 1:1
	Если ЗначениеЗаполнено(Объект.ВидДвижения) Тогда
		ПараметрыПодбора.Вставить("ТипЗадолженности", РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(Объект.ВидДвижения));
	КонецЕсли;
	
	Если Не ЭтаФорма.ОплатаЧерезБрокера Или (ЭтаФорма.ОплатаЧерезБрокера И ЗначениеЗаполнено(Объект.Брокер)) Тогда
		ПараметрыПодбора.Вставить("Брокер", Объект.Брокер);
	КонецЕсли;
	
	// Также при подборе учтем банковский счет
	Если ЗначениеЗаполнено(Объект.РасчетныйСчет) Тогда 
		ПараметрыПодбора.Вставить("РасчетныйСчет", Объект.РасчетныйСчет);
	КонецЕсли;
	
	// собственно, подбор
	ХранилищеВыбЗадолженности = ОткрытьФормуМодально("ОбщаяФорма.ПодборЗадолженностиПоДенежнымСредствам", ПараметрыПодбора, ЭтаФорма);
	
	Если ТипЗнч(ХранилищеВыбЗадолженности) = Тип("ХранилищеЗначения") Тогда
		ЗаполнитьОснованияОстаткамиЗадолженностиНаСервере(ХранилищеВыбЗадолженности, Истина);
		Модифицированность = Истина;
	КонецЕсли;
	
	ОснованияПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчиститьОснования(Команда)
	
	Если (Объект.Основания.Количество() > 0 И Вопрос("Очистить таблицу оснований оплаты?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да) Тогда
		Объект.Основания.Очистить();
		ОбновитьИтоговуюСтрокуОснований(ЭтаФорма);
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоДенежнымСредствам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоДенежнымСредствам(ЭтаФорма, ЭтаФорма.ОплатаЧерезБрокера);
	
	РасчетныйСчетПриИзменении(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// ЖУУУУУУУУУУУТЬ !!!!!!!!!!!
	Если Объект.ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.Устаревшие Тогда
		Если Объект.Основания.Количество() > 0 Тогда
			Если ТипЗнч(Объект.Основания[0].Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				Если Объект.ВидЗадолженности <> Объект.Основания[0].Основание.ВидЗадолженности Тогда
					Объект.ВидЗадолженности = Объект.Основания[0].Основание.ВидЗадолженности;
					Сообщить("Обновлен вид задолженности!");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// ЖУУУУУУУУУУУТЬ !!!!!!!!!!!
	
	ЭтаФорма.ОплатаЧерезБрокера           = ОпределитьЗначениеПереключателя(Объект.Брокер, Объект.МестоХранения);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	ЭтаФорма.СтрокаБанковскойВыписки      = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьПредставлениеСтрокиБанковскойВыписки(Объект.СтрокаБанковскойВыписки);
	
	ЗаполнитьРасчетныеПоляОснованийНаСервере();
	ЗаполнитьНастройкиОтображенияНаСервере();
	
	ОбновитьИтоговуюСтрокуОснований(ЭтаФорма);
	
	// !!! ВРЕМЕННО НЕ ПРОВЕРЯЕМ (09.10.2024)
	//ОбновитьНеобходимостьПроверкиРеквизитаДоговор();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	ПроверитьАкцептованиеНаСервере();
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма, Элемент = Неопределено)
	
	Элементы = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.ОснованияГруппаКурсОплаты.Видимость = Форма.ОтображатьКурсыОплат;
	
	Элементы.МестоХранения.Доступность = (Форма.ОплатаЧерезБрокера <> ЗначениеПереключателяБиржа());
	
	Элементы.Брокер.Видимость = (Форма.ОплатаЧерезБрокера = ЗначениеПереключателяБрокер());
	
	Если Форма.ОплатаЧерезБрокера = ЗначениеПереключателяБиржа() Тогда
		Элементы.КомандаВыбратьИсполнителяПоДенежнымСредствам.Видимость	= Ложь;
		Элементы.РасчетныйСчет.Видимость								= Ложь;
		Элементы.СтрокаБанковскойВыписки.Видимость						= Ложь;
	Иначе
		РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	КонецЕсли;

	БазовыйТипЗадолженности = ОпределитьБазовыйТипЗадолженности(ДанныеОбъекта.ВидЗадолженности);
	Элементы.Аванс.Доступность = БазовыйТипЗадолженности = ПредопределенноеЗначение("Перечисление.ТипыЗадолженности.Кредиторская")
									И ДанныеОбъекта.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход")
								ИЛИ БазовыйТипЗадолженности = ПредопределенноеЗначение("Перечисление.ТипыЗадолженности.Дебиторская")
									И ДанныеОбъекта.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход");
								
	Элементы.ОбеспечительныйПлатеж.Видимость = ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде");
	Элементы.ДатаПлановогоПогашенияЗадолженности.Видимость = ДанныеОбъекта.Аванс;
	Элементы.Поручение.Видимость = ДанныеОбъекта.Аванс И (Не ЗначениеЗаполнено(ДанныеОбъекта.ВидЗадолженности) Или ДоступноСозданиеОплатНаОснованииПоручений(ДанныеОбъекта));   
									
	Если ДанныеОбъекта.Аванс 
			И (ДанныеОбъекта.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход")
				ИЛИ ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде")) Тогда
		
		Элементы.ОснованияОснование.Видимость 			= Ложь;
		Элементы.ОснованияПлановаяДатаОплаты.Видимость 	= Ложь;
		
		Элементы.ОснованияСуммаОплаты.Видимость       = Истина;
		Элементы.ОснованияСуммаОплатыКупона.Видимость = Ложь;

		Элементы.ОснованияСумма.Видимость       = Истина;
		Элементы.ОснованияСуммаКупона.Видимость = Ложь;
		
		Элементы.ОснованияСуммаЗадолженности.Видимость       = Ложь;
		Элементы.ОснованияСуммаКупонаЗадолженности.Видимость = Ложь;
	
	ИначеЕсли ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПогашениюКупона")
		Или ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона")
		Или ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода") Тогда
	
		Элементы.ОснованияОснование.Видимость 			= Истина;
		Элементы.ОснованияПлановаяДатаОплаты.Видимость 	= Ложь;
		
		Элементы.ОснованияСуммаОплаты.Видимость       = Ложь;
		Элементы.ОснованияСуммаОплатыКупона.Видимость = Истина;
		
		Элементы.ОснованияСумма.Видимость       = Ложь;
		Элементы.ОснованияСуммаКупона.Видимость = Истина;
		
		Элементы.ОснованияСуммаЗадолженности.Видимость       = Ложь;
		Элементы.ОснованияСуммаКупонаЗадолженности.Видимость = Истина;
		
	ИначеЕсли ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоСделке")
		Или ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО")
		Или ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО") Тогда
	
		Элементы.ОснованияОснование.Видимость          = Истина;
		Элементы.ОснованияПлановаяДатаОплаты.Видимость = Истина;
		
		Элементы.ОснованияСуммаОплаты.Видимость       = Истина;
		Элементы.ОснованияСуммаОплатыКупона.Видимость = Истина;

		Элементы.ОснованияСумма.Видимость       = Истина;
		Элементы.ОснованияСуммаКупона.Видимость = Истина;
		
		Элементы.ОснованияСуммаЗадолженности.Видимость       = Истина;
		Элементы.ОснованияСуммаКупонаЗадолженности.Видимость = Истина;
				
	Иначе
			
		Элементы.ОснованияОснование.Видимость          = Истина;
		Элементы.ОснованияПлановаяДатаОплаты.Видимость = Ложь;
		
		Элементы.ОснованияСуммаОплаты.Видимость       = Истина;
		Элементы.ОснованияСуммаОплатыКупона.Видимость = Ложь;
		
		Элементы.ОснованияСумма.Видимость       = Истина;
		Элементы.ОснованияСуммаКупона.Видимость = Ложь;
		
		Элементы.ОснованияСуммаЗадолженности.Видимость       = Истина;
		Элементы.ОснованияСуммаКупонаЗадолженности.Видимость = Ложь;
		
	КонецЕсли;
	
	Элементы.ОснованияГруппаСуммыВВалютеОплаты.Заголовок = "В валюте оплаты (" + ДанныеОбъекта.ВалютаОплаты + ")";
	
	Элементы.СтраницаБухгалтерия.Видимость = (ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ОшибочноеСписание")
												ИЛИ ДанныеОбъекта.ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоПрочимУслугам"));
	
	Если Элементы.Найти("ФормаОбщаяКомандаПровестиПоБухгалтерскомуУчету") <> Неопределено Тогда
		Элементы.ФормаОбщаяКомандаПровестиПоБухгалтерскомуУчету.Видимость = НЕ БухгалтерскийУчет.ВидЗадолженностиСвязанСПартиями(ДанныеОбъекта.ВидЗадолженности);
	КонецЕсли;
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();

		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияОснование", "Объект.Основания.Основание");
		ПутьКДаннымСкрываемыхПолей.Вставить("Поручение", "Объект.Поручение");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияПлановаяДатаОплаты", "Объект.Основания.ПлановаяДатаОплаты");				
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСумма", "Объект.Основания.Сумма");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСуммаОплаты", "Объект.Основания.СуммаОплаты");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСуммаКупона", "Объект.Основания.СуммаКупона");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияСуммаОплатыКупона", "Объект.Основания.СуммаОплатыКупона");
		ПутьКДаннымСкрываемыхПолей.Вставить("ОснованияГруппаКурсОплаты", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Объект.Основания.КурсОплаты, Объект.Основания.СобственныйКурсОплаты", ",", Истина, Истина));
		
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);	
		
	КонецЕсли;
	
КонецПроцедуры

