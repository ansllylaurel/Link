КонецПроцедуры

&НаКлиенте 
Процедура РассчитатьСуммуНДС(ТекущиеДанные)
	
	СтавкаНДС = РаботаСНалогамиКлиентСервер.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);

	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * СтавкаНДС/(100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыОплаты(ТД)
		
	КурсВалюты = ?(ТД.СобственныйКурсОплаты, ТД.КурсОплаты, Объект.Дата);
	КурсОплаты = ?(ТД.СобственныйКурсОплаты, ?(ТипЗнч(ТД.КурсОплаты) = Тип("Число"), 1, ТД.КурсОплаты), Объект.Дата);
	
	Коэфициент = РаботаСВалютами.ПересчетСуммыВВалюте(1, ТД.Валюта, КурсВалюты, Объект.ВалютаОплаты, КурсОплаты);
		
	Если ТД.Сумма <> 0 Тогда
		ТД.СуммаОплаты = ТД.Сумма * Коэфициент;	
	КонецЕсли;
	
	Если ТД.СуммаКупона <> 0 Тогда
		ТД.СуммаОплатыКупона = ТД.СуммаКупона * Коэфициент;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыДолга(ТД)
		
	КурсОплаты = ?(ТД.СобственныйКурсОплаты, ТД.КурсОплаты, Объект.Дата);
	КурсВалюты = ?(ТД.СобственныйКурсОплаты, ?(ТипЗнч(ТД.КурсОплаты) = Тип("Число"), 1, ТД.КурсОплаты), Объект.Дата);
	
	Коэфициент = РаботаСВалютами.ПересчетСуммыВВалюте(1, Объект.ВалютаОплаты, КурсОплаты, ТД.Валюта, КурсВалюты);
		
	Если ТД.СуммаОплаты <> 0 Тогда
		ТД.Сумма = ТД.СуммаОплаты * Коэфициент;	
	КонецЕсли;
	
	Если ТД.СуммаОплатыКупона <> 0 Тогда
		ТД.СуммаКупона = ТД.СуммаОплатыКупона * Коэфициент;	
	КонецЕсли;

	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

КонецПроцедуры

&НаСервере
Процедура ПроверитьАкцептованиеНаСервере()
		
	Элементы.ДекорацияАкцептовано.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АкцептованиеОперацийСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Регистратор.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВЫБОР
		|					КОГДА &ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|						ТОГДА ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.СписаниеБрокерскойКомиссии)
		|					КОГДА &ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|						ТОГДА ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.СписаниеТорговойКомиссии)
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ) КАК АкцептованиеОперацийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО АкцептованиеОперацийСрезПоследних.Операция = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АкцептованиеОперацийСрезПоследних.Регистратор
		|ИЗ
		|	РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Регистратор.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (ВЫРАЗИТЬ(Операция КАК Справочник.БанковскиеСчета)) = &РасчетныйСчет
		|				И ВЫБОР
		|					КОГДА &ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.БанковскаяКомиссия))
		|						ТОГДА ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.СписаниеКомиссииБанка)
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ) КАК АкцептованиеОперацийСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АкцептованиеОперацийСрезПоследних.Регистратор
		|ИЗ
		|	РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И (Операция = &Ссылка
		|					ИЛИ Операция = &СтрокаБанковскойВыписки)) КАК АкцептованиеОперацийСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", 						Объект.Дата);
		Запрос.УстановитьПараметр("Организация", 					Объект.Организация);
		Запрос.УстановитьПараметр("Брокер", 	 					Объект.Брокер);
		Запрос.УстановитьПараметр("РасчетныйСчет", 	 				Объект.РасчетныйСчет);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Объект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидЗадолженности",				Объект.ВидЗадолженности);
		Запрос.УстановитьПараметр("Ссылка",							Объект.Ссылка);
		Запрос.УстановитьПараметр("СтрокаБанковскойВыписки",		Объект.СтрокаБанковскойВыписки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Элементы.ДекорацияАкцептовано.Видимость	= Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область Работа_с_переключателями_отправителя_и_получателя

&НаСервереБезКонтекста
Функция ОпределитьЗначениеПереключателя(Брокер, МестоХранения)

	Если ЗначениеЗаполнено(Брокер) Тогда
		Возврат ЗначениеПереключателяБрокер();
	ИначеЕсли МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
		Возврат ЗначениеПереключателяБиржа();
	Иначе
		Возврат ЗначениеПереключателяПрямая();
	КонецЕсли;

КонецФункции

