
Функция ЗначенияЗаполнения() Экспорт
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("МестоХранения", Справочники.МестаХранения.ВнебиржевойРынок);
	ЗначенияЗаполнения.Вставить("ВидДвижения",   Перечисления.ВидыДвижений.Расход);
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	Если (Данные.ВидДвижения  = Перечисления.ВидыДвижений.Приход  
			ИЛИ Данные.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде 
				И Данные.ВидДвижения = Перечисления.ВидыДвижений.Расход ) 
		И ЭтоОплатаНаОснованииОплаты(Данные.Ссылка) Тогда
		Если Данные.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) Тогда		
			Представление = "Возврат НДФЛ " + Данные.Номер + " от " + Данные.Дата;
		Иначе	
			Представление = "Возврат аванса " + НРег(Данные.ВидЗадолженности.Наименование) + " " + Данные.Номер + " от " + Данные.Дата;
		КонецЕсли;	
	ИначеЕсли Данные.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) Тогда		
		Представление = "Оплата по НДФЛ " + Данные.Номер + " от " + Данные.Дата;
	Иначе
		Представление = ?(Данные.Аванс, "Аванс ", "Оплата ") + НРег(Данные.ВидЗадолженности.Наименование) + " " + Данные.Номер + " от " + Данные.Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("ВидЗадолженности");
	Поля.Добавить("Аванс");
	Поля.Добавить("Ссылка");
	Поля.Добавить("ВидДвижения");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

