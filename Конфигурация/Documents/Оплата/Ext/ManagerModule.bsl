Процедура ЗаполнитьДанныеКонтрагента(ДанныеОбъекта, СтрокаОснования) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеОбъекта.Контрагент) Тогда
		Возврат;
	КонецЕсли; 
	
	Если ДанныеОбъекта.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		ДанныеОбъекта.Контрагент = ДанныеОбъекта.Брокер.ЮрФизЛицо;
		
	Иначе
		ТипОснования = ТипЗнч(СтрокаОснования.Основание);
		
		Если ТипОснования = Тип("ДокументСсылка.Сделка") Или ТипОснования = Тип("ДокументСсылка.СделкаРЕПО")
			Или ТипОснования = Тип("ДокументСсылка.ИзменениеУсловийСделки")
		Тогда
			ДанныеОбъекта.Контрагент               = СтрокаОснования.Основание.Контрагент;
			ДанныеОбъекта.РасчетныйСчетКонтрагента = СтрокаОснования.Основание.РасчетныйСчетКонтрагента;
			
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
			ДанныеОбъекта.Контрагент = СтрокаОснования.Основание.Контрагент;
			
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПогашениеКупона") Тогда
			ДанныеОбъекта.Контрагент = СтрокаОснования.Основание.Облигация.Эмитент.ЮрФизЛицо;
			
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
			Если СтрокаОснования.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
				УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ДанныеОбъекта.Дата, СтрокаОснования.Основание.ЦеннаяБумага);
				ДанныеОбъекта.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
			Иначе
				ДанныеОбъекта.Контрагент = СтрокаОснования.Основание.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
			КонецЕсли;
			
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
			Если ТипЗнч(СтрокаОснования.Основание.ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
				УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ДанныеОбъекта.Дата, СтрокаОснования.Основание.ЦеннаяБумага);
				ДанныеОбъекта.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
			Иначе	
				ДанныеОбъекта.Контрагент = СтрокаОснования.Основание.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
			КонецЕсли; 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДатуИВалютуОплатыПоПервойСтрокеОснования(ДанныеОбъекта) Экспорт
	
	Если ДанныеОбъекта.Основания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОснования = ДанныеОбъекта.Основания[0];
	
	ТипОснования = ТипЗнч(СтрокаОснования.Основание);
	
	Если ТипОснования = Тип("ДокументСсылка.Сделка") Или ТипОснования = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	УсловияСделокРЕПОСрезПоследних.ВалютаОплаты,
			|	УсловияСделокРЕПОСрезПоследних.ДатаОплаты
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			,
			|			НЕ Отменено
			|				И СделкаРЕПО = &Сделка
			|				И ЧастьСделкиРЕПО = &ЧастьСделкиРЕПО) КАК УсловияСделокРЕПОСрезПоследних";
			
		Если ТипОснования = Тип("ДокументСсылка.Сделка") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ЧастьСделкиРЕПО = &ЧастьСделкиРЕПО", "");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РЕПО", "");
		КонецЕсли;
			
		Запрос.УстановитьПараметр("Сделка",          СтрокаОснования.Основание);
		Запрос.УстановитьПараметр("ЧастьСделкиРЕПО", РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьЧастьСделкиРЕПОПоВидуЗадолженности(ДанныеОбъекта.ВидЗадолженности));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДанныеОбъекта.ВалютаОплаты	 = Выборка.ВалютаОплаты;
			ДанныеОбъекта.Дата			 = РаботаСДокументами.ПолучитьВремяДокумента(Выборка.ДатаОплаты, ДанныеОбъекта.Ссылка);
		КонецЕсли;
		
	Иначе
		ДанныеОбъекта.ВалютаОплаты = СтрокаОснования.Валюта;
		
		Если  ТипОснования = Тип("ДокументСсылка.СделкаСВалютой") Тогда
			ЗаполнитьРасчетныйСчетПоСделкеСВалютой(ДанныеОбъекта);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРасчетныйСчетПоСделкеСВалютой(ДанныеОбъекта) Экспорт
	
	Если ДанныеОбъекта.Основания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОснования = ДанныеОбъекта.Основания[0];
	
	ТипОснования = ТипЗнч(СтрокаОснования.Основание);
	
	Если  ТипОснования = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		
		//ДанныеОбъекта.Дата = СтрокаОснования.Основание.ДатаЗачисления;
		
		// расход по комиссии при продаже с расчетного счета получателя
		ЭтоБанковскаяКомиссия = (ДанныеОбъекта.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии 
								ИЛИ ДанныеОбъекта.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия));
		
		Если (ДанныеОбъекта.ВидДвижения = Перечисления.ВидыДвижений.Расход и СтрокаОснования.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка) 
		 Или (ДанныеОбъекта.ВидДвижения = Перечисления.ВидыДвижений.Приход и СтрокаОснования.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа)							
		 Или (СтрокаОснования.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтоБанковскаяКомиссия) Тогда
			ДанныеОбъекта.РасчетныйСчет = СтрокаОснования.Основание.РасчетныйСчетКонтрвалюты;	
		Иначе
			ДанныеОбъекта.РасчетныйСчет = СтрокаОснования.Основание.РасчетныйСчет;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

// Необходимость проверки реквизита "Договор".
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект.Оплата, ДанныеФормыСтруктура - объект документа
//
// Возвращаемое значение:
//	Булево - признак необходимости проверки реквизита
Функция НеобходимостьПроверкиРеквизитаДоговор(ЭтотОбъект) Экспорт
	Возврат ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)
		И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР;
КонецФункции

Функция ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям(Документ) Экспорт
	
	Возврат Документ.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет 
		И (Документ.МестоХранения = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок"))
		И (Документ.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход"))
		И Не ЗначениеЗаполнено(Документ.Брокер)
		И РаботаСдокументами.ДействуетКонтрольПорученийВнутреннейСистемы(?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДата()), Документ.Организация) 
		И Справочники.ВидыЗадолженности.ЭтоВидЗадолженностиДляФормированияПоручений(Документ.ВидЗадолженности); 
		
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоОплатаНаОснованииОплаты(Оплата)
	
	// раньше было Данные.Ссылка.Основания.Количество() > 0) и (ТипЗнч(Данные.Ссылка.Основания[0].Основание) = Тип("ДокументСсылка.Оплата"),
	// однако это приводило к регистрации ошибки доступа к данным + сама концепция получения реквизитов через точку некорректна
	
	// #ТехДолг: по задаче #283142 необходимо отказаться от обращения к реквизитам через точку (запросом) при получении представления
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Основание КАК Основание
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И ОплатаОснования.НомерСтроки = 1
		|	И (ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.Оплата)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.КорректировкаЗадолженности))";
	
	Запрос.УстановитьПараметр("Ссылка", Оплата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции 

#КонецОбласти
