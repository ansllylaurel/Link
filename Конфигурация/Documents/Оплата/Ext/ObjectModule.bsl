							ИначеЕсли (ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"))
								И СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы
								И СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда		
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПокупкаТБС;
							ИначеЕсли (ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"))
								И СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы
								И СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда		
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПродажаТБС;
							ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда		
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПокупка;
							Иначе
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПродажа;
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ДепозитарнаяКомиссия;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.НеобходимыеРасходыСпецДепозитария;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоВознаграждениюСпецДепозитария;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамДепозитария;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамСпецДепозитария;						
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамСпецРегистратора;						
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюОценщика  Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоВознаграждениюОценщика;						
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимУслугам
						Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюАудитора
						Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости 
						Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоУлучшениюОбъектовНедвижимости 
						Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги Тогда
						//добавил свое
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;					
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить вид движения денежных средств для вида задолженности """ + ЭтотОбъект.ВидЗадолженности + """ в документе " + ЭтотОбъект.Ссылка, ЭтотОбъект);
					КонецЕсли;
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
				КонецЕсли;
							
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.СуммаОплаты;
					Проводка.ВалютаКт = ВалютаОплаты;
				КонецЕсли;
				
				// Начислим комиссию при кассовом методе
				Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате
					И ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
					
					ДанныеАналитики = Новый Структура("Сделка, ВидЗадолженности", СтрокаОснование.Основание, ЭтотОбъект.ВидЗадолженности);
					
					ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Проводка.Сумма, Содержание, ДанныеАналитики);
					
					// Дебет
					СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, СтрокаОснование.Основание, УчетныйРегистр);

					// Сделано для случая одной ценной бумаги
					ЦеннаяБумага = СтрокаОснование.Основание.ЦенныеБумаги[0].ЦеннаяБумага;
					
					ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
					
					АналитикаУслугКомиссииРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
						ЭтотОбъект.Дата, 
						ЭтотОбъект.Организация, 
						ЭтотОбъект.СчетДоверительногоУправления,
						ЭтотОбъект.ВидЗадолженности,
						УчетныйРегистр,
						"АналитикаРЕПО"); 
						
					БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
						ЭтотОбъект,
						ПроводкаНачисления.СчетДт,
						ПроводкаНачисления.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаУслугКомиссииРЕПО,
						ЦеннаяБумага,
						ОбращаетсяНаОРЦБ);
					
					// Кредит
					ПроводкаНачисления.СчетКт = СчетУчетаУслуг;
					
