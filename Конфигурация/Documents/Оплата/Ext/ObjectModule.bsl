			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|	КОНЕЦ КАК ТипЗадолженностиАвансовогоНДС
			|ПОМЕСТИТЬ _ВозвратАвансовСНДС
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура.Основания КАК СчетФактураОснования
			|		ПО ОплатаОснования.Основание = СчетФактураОснования.Основание
			|			И (ОплатаОснования.Ссылка = &Ссылка)
			|			И (ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.Оплата))
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|				&Период,
			|				Основание В
			|						(ВЫБРАТЬ
			|							ОплатаОснования.Основание КАК Основание
			|						ИЗ
			|							Документ.Оплата.Основания КАК ОплатаОснования
			|						ГДЕ
			|							ОплатаОснования.Ссылка = &Ссылка
			|							И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.Оплата))
			|					И ВидЗадолженности = &ВидЗадолженности) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ПО ОплатаОснования.Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
			|
			|СГРУППИРОВАТЬ ПО
			|	СчетФактураОснования.Ссылка,
			|	ВЫБОР
			|		КОГДА СчетФактураОснования.Ссылка.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Выданный)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|	КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВозвратАвансовСНДС.СчетФактура КАК СчетФактура,
			|	ВЫБОР
			|		КОГДА _ВозвратАвансовСНДС.СуммаОстаток <= _ВозвратАвансовСНДС.СуммаОплаты
			|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
			|		ИНАЧЕ _ВозвратАвансовСНДС.СуммаНДСФактура * _ВозвратАвансовСНДС.СуммаОплаты / _ВозвратАвансовСНДС.СуммаСНДСФактура
			|	КОНЕЦ КАК СуммаАвансовогоНДСКВосстановлению,
			|	_ВозвратАвансовСНДС.ТипЗадолженностиАвансовогоНДС КАК ТипЗадолженностиАвансовогоНДС,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК ИФНС,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта
			|ИЗ
			|	_ВозвратАвансовСНДС КАК _ВозвратАвансовСНДС
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСПоАвансам)
			|					И Основание В
			|						(ВЫБРАТЬ
			|							_ВозвратАвансовСНДС.СчетФактура
			|						ИЗ
			|							_ВозвратАвансовСНДС КАК _ВозвратАвансовСНДС)) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ПО _ВозвратАвансовСНДС.СчетФактура = ЗадолженностиПоДенежнымСредствамОстатки.Основание";
		
		Запрос.УстановитьПараметр("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Аванс                        = Ложь;
			Движение.Основание                    = ВыборкаДетальныеЗаписи.СчетФактура;
			Движение.ТипЗадолженности             = ВыборкаДетальныеЗаписи.ТипЗадолженностиАвансовогоНДС;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.НДСПоАвансам;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.Контрагент                   = ВыборкаДетальныеЗаписи.ИФНС;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Валюта                       = ВыборкаДетальныеЗаписи.Валюта;
			Движение.Сумма                        = ВыборкаДетальныеЗаписи.СуммаАвансовогоНДСКВосстановлению;
			
			//типа книга покупок: для аванса полученного - дебиторка, для аванса выданного - кредиторка
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Аванс                        = Ложь;
			Движение.Основание                    = ВыборкаДетальныеЗаписи.СчетФактура;
			Движение.ТипЗадолженности             = ВыборкаДетальныеЗаписи.ТипЗадолженностиАвансовогоНДС;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.НДСТекущегоПериода;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.Контрагент                   = ВыборкаДетальныеЗаписи.ИФНС;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Валюта                       = ВыборкаДетальныеЗаписи.Валюта;
			Движение.Сумма                        = ВыборкаДетальныеЗаписи.СуммаАвансовогоНДСКВосстановлению;
			
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьДвиженияПоЗадолженностиПоПоручениям()
			
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.Дата КАК Период,
		|	Оплата.Организация КАК Организация,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОплатаОснования.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА Оплата.Аванс
		|			ТОГДА Оплата.Поручение
		|		ИНАЧЕ ОплатаОснования.Основание
		|	КОНЕЦ КАК Основание,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская) КАК ТипЗадолженности,
		|	СУММА(ОплатаОснования.Сумма) КАК Сумма
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО Оплата.Ссылка = ОплатаОснования.Ссылка
		|			И (Оплата.Ссылка = &Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Оплата.Дата,
		|	Оплата.Организация,
		|	Оплата.СчетДоверительногоУправления,
		|	ОплатаОснования.Валюта,
		|	ВЫБОР
		|		КОГДА Оплата.Аванс
		|			ТОГДА Оплата.Поручение
		|		ИНАЧЕ ОплатаОснования.Основание
		|	КОНЕЦ,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("БазовыйТипЗадолженности", Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствамПоПоручениям.ДобавитьРасход(), Выборка);
	КонецЦикла;
					
КонецПроцедуры

Процедура СформироватьДвиженияПоОперациямСЦеннымиБумагами()
	
	РегистрируемыеВидыЗадолженности = Новый Массив();
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюПая);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюВекселя);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
	РегистрируемыеВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
	
	Если РегистрируемыеВидыЗадолженности.Найти(ЭтотОбъект.ВидЗадолженности) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Погашение купона и тела возможно также по дефолтным облигациям, задолженность по которым
	// введена документом "Ввод ценных бумаг". Такие движения, согласно требованию аналитика,
	// проводить не требуется
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.Ссылка КАК Операция,
		|	ОплатаОснования.Основание КАК Основание,
		|	Оплата.Организация КАК Организация,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Оплата.ВалютаОплаты КАК Валюта,
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюВекселя)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.СделкаРЕПО).Рынок
		|	КОНЕЦ КАК Рынок,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.НачислениеДивидендов)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеДивидендов).ЦеннаяБумага
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеКупона).Облигация
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	СУММА(ОплатаОснования.Сумма) КАК Сумма,
		|	СУММА(ОплатаОснования.СуммаКупона) КАК СуммаКупона,
		|	Оплата.Дата КАК ДатаОперации
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО ОплатаОснования.Ссылка = Оплата.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&Дата,
		|				(Организация, СделкаРЕПО) В
		|					(ВЫБРАТЬ
		|						ОплатаОснования.Ссылка.Организация КАК Организация,
		|						ОплатаОснования.Основание КАК Основание
		|					ИЗ
		|						Документ.Оплата.Основания КАК ОплатаОснования
		|					ГДЕ
		|						ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.СделкаРЕПО)
		|						И ОплатаОснования.Ссылка = &Ссылка)) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ОплатаОснования.Основание = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) <> ТИП(Документ.ВводЦенныхБумаг)
		|	И ВЫБОР
		|			КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|					ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.СделкаРЕПО).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ЛОЖЬ
		|					КОНЕЦ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Оплата.Ссылка,
		|	Оплата.Дата,
		|	Оплата.Организация,
		|	Оплата.СчетДоверительногоУправления,
		|	Оплата.ВалютаОплаты,
		|	ОплатаОснования.Основание,
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюВекселя)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.Рынок
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.НачислениеДивидендов)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеДивидендов).ЦеннаяБумага
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеКупона).Облигация
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Ссылка.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ОперацииСЦеннымиБумагами.Добавить(), Выборка);
	КонецЦикла;
		
КонецПроцедуры

Процедура СформироватьКорректировкуРезерваПоВалютнымНачислениямЗадолженности(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	Оплата.Дата КАК Период,
		|	Оплата.Организация КАК Организация,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Оплата.ВалютаОплаты КАК Валюта,
		|	СводныеОснования.Резерв КАК Резерв,
		|	СводныеОснования.Сумма КАК Сумма
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(ОплатаОснования.СуммаОплаты) - СУММА(ОплатаОснования.Сумма) * КурсыВалют.Курс / КурсыВалют.Кратность КАК Сумма,
		|		ОплатаОснования.Валюта КАК Валюта,
		|		ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеЗадолженности).ПрочиеДоходыИРасходы.Резерв КАК Резерв
		|	ИЗ
		|		Документ.Оплата.Основания КАК ОплатаОснования
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО (НАЧАЛОПЕРИОДА(ОплатаОснования.Основание.Дата, ДЕНЬ) = КурсыВалют.Период)
		|				И ОплатаОснования.Валюта = КурсыВалют.Валюта
		|	ГДЕ
		|		ОплатаОснования.Ссылка = &Ссылка
		|		И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.НачислениеЗадолженности)
		|		И ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеЗадолженности).ПрочиеДоходыИРасходы.Резерв В (ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего), ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика), ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего))
		|		И ОплатаОснования.Валюта <> ОплатаОснования.Ссылка.ВалютаОплаты
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ОплатаОснования.Валюта,
		|		КурсыВалют.Курс,
		|		КурсыВалют.Кратность,
		|		ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеЗадолженности).ПрочиеДоходыИРасходы.Резерв
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ОплатаОснования.СуммаОплаты) > 0) КАК СводныеОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО (Оплата.Ссылка = &Ссылка)";  		
		
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.РезервыПИФ.Добавить(), Выборка);
	КонецЦикла;

	Если Выборка.Количество() > 0 Тогда
		Движения.РезервыПИФ.Записать();	
	КонецЕсли;
			
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям = Документы.Оплата.ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям(ЭтотОбъект);
	
	УстановитьБлокировки(ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям);
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиДенежныхСредств.Записывать							= Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать				= Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать						= Истина;
	Движения.РезервыПредстоящихРасходов.Записывать						= Истина;	
	Движения.ЗадолженностиПоДенежнымСредствамПоПоручениям.Записывать	= ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям;
		
	Движения.ЗадолженностиПоДенежнымСредствам.Записать();
	
	// задолженность д/с
#Область Задолженность_по_денежным_средствам
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции или (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи) Тогда // закроем задолженность в полном объеме 
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОплатаОснования.НомерСтроки КАК НомерСтроки,
			|	ОплатаОснования.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
			|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток, 0) КАК ОстатокЗадолженности,
			|	ОплатаОснования.Сумма КАК СуммаОплаты
			|ПОМЕСТИТЬ _Задолженность
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|				&Период,
			|				Организация = &Организация
			|						И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
			|					ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи)
			|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ПО ОплатаОснования.Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
			|			И ОплатаОснования.Валюта = ЗадолженностиПоДенежнымСредствамОстатки.Валюта
			|			И ОплатаОснования.Ссылка.Контрагент = ЗадолженностиПоДенежнымСредствамОстатки.Контрагент
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОплатаОснования.НомерСтроки КАК НомерСтроки,
			|	ОплатаОснования.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
			|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток, 0) КАК ОстатокЗадолженности,
			|	ОплатаОснования.Сумма КАК СуммаОплаты
			|ПОМЕСТИТЬ _ЗадолженностьНалог
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|					И ВидЗадолженности В (&ВидНалога)
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ПО ОплатаОснования.Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
			|			И ОплатаОснования.Валюта = ЗадолженностиПоДенежнымСредствамОстатки.Валюта
			|			И ОплатаОснования.Ссылка.Контрагент = ЗадолженностиПоДенежнымСредствамОстатки.Контрагент
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Задолженность.НомерСтроки КАК НомерСтроки,
			|	_Задолженность.Основание КАК Основание,
			|	_Задолженность.ТипЗадолженности КАК ТипЗадолженности,
			|	_Задолженность.ВидЗадолженности КАК ВидЗадолженности,
			|	_Задолженность.Организация КАК Организация,
			|	_Задолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Задолженность.Контрагент КАК Контрагент,
			|	_Задолженность.Валюта КАК Валюта,
			|	_Задолженность.СуммаОплаты КАК Сумма,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
			|	NULL КАК Содержание
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_Задолженность.НомерСтроки,
			|	_Задолженность.Основание,
			|	_Задолженность.ТипЗадолженности,
			|	_Задолженность.ВидЗадолженности,
			|	_Задолженность.Организация,
			|	_Задолженность.СчетДоверительногоУправления,
			|	_Задолженность.Контрагент,
			|	_Задолженность.Валюта,
			|	_Задолженность.СуммаОплаты - _Задолженность.ОстатокЗадолженности,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
			|	""Сторно задолженности""
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|ГДЕ
			|	_Задолженность.СуммаОплаты - _Задолженность.ОстатокЗадолженности < 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_Задолженность.НомерСтроки,
			|	_Задолженность.Основание,
			|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская),
			|	&ВидНалога,
			|	_Задолженность.Организация,
			|	_Задолженность.СчетДоверительногоУправления,
			|	_Задолженность.Контрагент,
			|	_Задолженность.Валюта,
			|	_Задолженность.ОстатокЗадолженности - ЕСТЬNULL(_ЗадолженностьНалог.ОстатокЗадолженности, 0) - _Задолженность.СуммаОплаты,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
			|	""Начисление налога""
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьНалог КАК _ЗадолженностьНалог
			|		ПО _Задолженность.Основание = _ЗадолженностьНалог.Основание
			|			И _Задолженность.Организация = _ЗадолженностьНалог.Организация
			|			И _Задолженность.СчетДоверительногоУправления = _ЗадолженностьНалог.СчетДоверительногоУправления
			|ГДЕ
			|	_Задолженность.ОстатокЗадолженности <> _Задолженность.СуммаОплаты
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_Задолженность.НомерСтроки,
			|	_Задолженность.Основание,
			|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская),
			|	&ВидНалога,
			|	_Задолженность.Организация,
			|	_Задолженность.СчетДоверительногоУправления,
			|	_Задолженность.Контрагент,
			|	_Задолженность.Валюта,
			|	_Задолженность.ОстатокЗадолженности - _Задолженность.СуммаОплаты,
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
			|	""Списание налога""
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьНалог КАК _ЗадолженностьНалог
			|		ПО _Задолженность.Основание = _ЗадолженностьНалог.Основание
			|			И _Задолженность.Организация = _ЗадолженностьНалог.Организация
			|			И _Задолженность.СчетДоверительногоУправления = _ЗадолженностьНалог.СчетДоверительногоУправления
			|ГДЕ
			|	_Задолженность.ОстатокЗадолженности <> _Задолженность.СуммаОплаты";

		Запрос.УстановитьПараметр("Период",                       ЭтотОбъект.МоментВремени());
		Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Ссылка",                       ЭтотОбъект.Ссылка);
		
		ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
		Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет
			ИЛИ ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица Тогда
			Запрос.УстановитьПараметр("ВидНалога",                    Справочники.ВидыЗадолженности.ПоНДФЛ13);     // по дивидендам ставка 13%, маловероятно, что будет другая. 
		Иначе
			Запрос.УстановитьПараметр("ВидНалога",                    Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль);
		КонецЕсли;
		
		// проверим, что задолженность присутствует по каждой строке основания
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Сумма = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует задолженность по документу " + Выборка.Основание, ЭтотОбъект, "Основания[" + Выборка.НомерСтроки + "].Сумма");
			КонецЕсли; 
			
		КонецЦикла;
		
		Если Не Отказ Тогда
			Выборка.Сбросить();
			РаботаСРегистрамиНакопления.СформироватьДвижения(ЭтотОбъект.Движения.ЗадолженностиПоДенежнымСредствам, , ЭтотОбъект.Дата, Выборка);
		КонецЕсли;
		
	Иначе
		
		СформироватьДвиженияПоЗадолженности();	
		
	КонецЕсли;
#КонецОбласти
	
	// остатки д/с
	СформироватьДвиженияДенежныхСредств();
	
	// операции с ц/б
	СформироватьДвиженияПоОперациямСЦеннымиБумагами();
	
	Если ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям Тогда	
		СформироватьДвиженияПоЗадолженностиПоПоручениям();
	КонецЕсли;
	
	Если      ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитномуВкладу Тогда
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада;
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитномуВкладуПроценты Тогда
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу;
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Тогда
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона;
	Иначе
		ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
	КонецЕсли; 
	
	// резервы
	Если ЭтотОбъект.Дата < РаботаСДокументами.ДатаНачалаСписанияРезервовПредстоящихРасходовРегламентнымДокументом() Тогда
		
		//#ТехДолг - Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона пока не учитываем потому что при последнем погашении сейчас тело и купон и для СЧА и на ЕПС не делится.
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации 
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона 
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции 
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки
			Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия Тогда
						
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&ДатаДвижения КАК Период,
				|	РезервыПредстоящихРасходовОстатки.Организация КАК Организация,
				|	РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	РезервыПредстоящихРасходовОстатки.Резерв КАК Резерв,
				|	РезервыПредстоящихРасходовОстатки.Валюта КАК Валюта,
				|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
				|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма
				|ИЗ
				|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
				|			&Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И СубъектАналитики В (&СубъектыАналитики)) КАК РезервыПредстоящихРасходовОстатки";
			
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("СубъектыАналитики", ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ДатаДвижения", ЭтотОбъект.Дата);
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Движение = Движения.РезервыПредстоящихРасходов.ДобавитьРасход();
				ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетальныеЗаписи);
			
			КонецЦикла;
		КонецЕсли;
	
	КонецЕсли;
	
	// контроль отр. остатков
	Движения.Записать();
	
	// реестр платежей
	РегистрыСведений.РеестрПлатежей.ЗарегистрироватьПлатеж(ЭтотОбъект,
		РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
			ЭтотОбъект.СтрокаБанковскойВыписки,
			ЭтотОбъект.ВидДвижения,
			ЭтотОбъект.Основания.Итог("СуммаОплаты") + ЭтотОбъект.Основания.Итог("СуммаОплатыКупона"),
			ВидДвиженияДенежныхСредств));
					
	Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствам(ЭтотОбъект, Отказ);
	
	Если ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствамПоПоручениям(ЭтотОбъект, Отказ);	
	КонецЕсли;
	
	// Для валютных начислений по ПИФ требуется корректировка списанного резерва
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	
	Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход И ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		СформироватьКорректировкуРезерваПоВалютнымНачислениямЗадолженности(Отказ);	
	КонецЕсли;
	
	Если ЭтотОбъект.Аванс Тогда
		РегистрыСведений.ПлановыеДатыОплат.СформироватьДвижения(ЭтотОбъект);
	КонецЕсли;
	
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям Тогда
		РегистрыНакопления.НачисленияНалогов.ПроверитьУдержаниеНалогаПоДоходу(ЭтотОбъект.Ссылка, Отказ);
	ИначеЕсли ЭтотОбъект.ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.НДФЛ Тогда
		РегистрыНакопления.НачисленияНалогов.ПроверитьСоответствиеНалогаПриОплате(ЭтотОбъект.Ссылка, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОплатаПоПогашениюКупонаЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, СчетДС, ВидСубконтоДС, СубконтоДС, НастройкиУчета, Закрывать7ойРазделПриПоступленииДенежныхСредств, Отказ)

	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Основание КАК Основание,
		|	ОплатаОснования.СуммаОплатыКупона КАК СуммаОплатыКупона,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПогашениеКупона.СуммаКупона, 0) > 0
		|			ТОГДА ПогашениеКупона.СуммаКупона
		|		ИНАЧЕ ПогашениеЦеннойБумаги.СуммаКупона
		|	КОНЕЦ КАК СуммаКупона,
		|	ЕСТЬNULL(ПогашениеКупона.Количество, ПогашениеЦеннойБумаги.Количество) КАК Количество,
		|	ЕСТЬNULL(ПогашениеКупона.Облигация, ПогашениеЦеннойБумаги.ЦеннаяБумага) КАК Облигация,
		|	ОплатаОснования.Ссылка.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ ОснованияПоКупону
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеКупона КАК ПогашениеКупона
		|		ПО ОплатаОснования.Основание = ПогашениеКупона.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|		ПО ОплатаОснования.Основание = ПогашениеЦеннойБумаги.Ссылка
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) <> ТИП(Документ.ВводЦенныхБумаг)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ОплатаОснования.Основание,
		|	ОплатаОснования.СуммаОплатыКупона,
		|	ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон,
		|	ВводЦенныхБумагЦенныеБумаги.Количество,
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
		|	ОплатаОснования.Ссылка.Контрагент
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ОплатаОснования.Основание = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И (ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон > 0)
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ВводЦенныхБумаг)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СписаниеЦеннойБумаги.Ссылка КАК Ссылка,
		|	СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги КАК Основание
		|ПОМЕСТИТЬ _ДокументыСписанияПартий
		|ИЗ
		|	Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
		|ГДЕ
		|	СписаниеЦеннойБумаги.Проведен
		|	И СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги В
		|			(ВЫБРАТЬ
		|				ОснованияПоКупону.Основание
		|			ИЗ
		|				ОснованияПоКупону)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОснованияПоКупону.Основание,
		|	ОснованияПоКупону.Основание
		|ИЗ
		|	ОснованияПоКупону КАК ОснованияПоКупону
		|ГДЕ
		|	(ОснованияПоКупону.Основание ССЫЛКА Документ.ПогашениеКупона
		|			ИЛИ ОснованияПоКупону.Основание ССЫЛКА Документ.ПогашениеЦеннойБумаги)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОплатаОснования.Ссылка,
		|	ОплатаОснования.Основание
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка.Проведен
		|	И ОплатаОснования.Основание В
		|			(ВЫБРАТЬ
		|				ОснованияПоКупону.Основание
		|			ИЗ
		|				ОснованияПоКупону)
		|	И ОплатаОснования.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчет.СчетКт КАК Счет,
		|	ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт.ЦеннаяБумага КАК Облигация,
		|	ЕдиныйБухгалтерскийУчет.ВалютаКт КАК Валюта,
		|	ЕдиныйБухгалтерскийУчет.Сумма КАК СуммаЗадолженности,
		|	ЕдиныйБухгалтерскийУчет.ВалютнаяСуммаКт КАК СуммаЗадолженностиВал,
		|	ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт КАК ЛицевойСчет
		|ПОМЕСТИТЬ _ДвиженияОплатБух
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет
		|ГДЕ
		|	ЕдиныйБухгалтерскийУчет.Регистратор = &Ссылка
		|	И (ЕдиныйБухгалтерскийУчет.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты23)
		|			ИЛИ ЕдиныйБухгалтерскийУчет.СчетКт В
		|				(ВЫБРАТЬ
		|					УчетныеАктивыЕПС.СчетУчета КАК СчетУчета
		|				ИЗ
		|					Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|				ГДЕ
		|					ЕСТЬNULL(УчетныеАктивыЕПС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)) <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)))
		|	И ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт.ДополнительнаяАналитика = &АналитикаДебиторкиПоКупону
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Счет, _ДвиженияОплатБух.Счет) КАК Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, _ДвиженияОплатБух.Облигация) КАК Облигация,
