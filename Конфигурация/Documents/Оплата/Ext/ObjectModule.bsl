		ДвижениеНакопления.ВидДвижения                  = ВидДвиженияНакопления.Расход;
		ДвижениеНакопления.Период                       = ЭтотОбъект.Дата;
		ДвижениеНакопления.Организация                  = ЭтотОбъект.Организация;
		ДвижениеНакопления.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		ДвижениеНакопления.Продажа						= ВыборкаДетальныеЗаписи.Основание;
		ДвижениеНакопления.УчетныйАктивЕПС		        = УчетныйАктив;
		ДвижениеНакопления.ЦеннаяБумага 		        = ЦеннаяБумага;
		ДвижениеНакопления.ДисконтПремия                = ДисконтПремияСписать;
		ДвижениеНакопления.ПереоценкаКупона             = ПереоценкаКупонаСписать;
		ДвижениеНакопления.КорректировкаЭСП             = КорректировкаЭСПСписать;
		ДвижениеНакопления.Переоценка                   = ПереоценкаСписать;
		ДвижениеНакопления.РасходыПриПокупкеСНачалаГода = РасходыПриПокупкеСНачалаГодаСписать;
		ДвижениеНакопления.РазницаПервоначальногоПризнанияСНачалаГода = РазницаПервоначальногоПризнанияНаблюдаемыеДанныеСписать;
		ДвижениеНакопления.ФинансовыйРезультат			= ФинансовыйРезультатСписать;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьНачислениеНалога(Основание)
	
	ВидыЗадолженности = Новый Массив;
	// возможно еще добавятся
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеЗадолженностиОснования.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|ГДЕ
		|	НачислениеЗадолженностиОснования.Основание = &Основание
		|	И НачислениеЗадолженностиОснования.Ссылка.Проведен
		|	И НачислениеЗадолженностиОснования.Ссылка.ВидЗадолженности В(&ВидыЗадолженности)";
	
	Запрос.УстановитьПараметр("ВидыЗадолженности", ВидыЗадолженности);
	Запрос.УстановитьПараметр("Основание", Основание);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьПараметрыОплатыИзПроводок(ОплатаОснование)

	ПараметрыОплаты = Новый Структура("СчетДоходовРасходов,ГФУ,СчетРасчетов,ЕстьСубконтоКонтрагенты,ЕстьСубконтоДоговоры,ЕстьСубконтоОснованиеРасчетов,БылоЗакрытие7гоРаздела",
		Неопределено, Неопределено, Неопределено, Ложь, Ложь, Ложь, Ложь);
	ПараметрыОплаты.БылоЗакрытие7гоРаздела = Ложь;
	
	НаборЗаписей = РегистрыБухгалтерии.ЕдиныйБухгалтерскийУчет.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОплатаОснование);
	НаборЗаписей.Прочитать();
	
	Для каждого Запись Из НаборЗаписей Цикл
	
		Если Лев(Запись.СчетДт.Код, 1) = "7" Тогда
			ПараметрыОплаты.СчетДоходовРасходов = Запись.СчетДт;
			ПараметрыОплаты.ГФУ = Запись.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов;
		КонецЕсли;	
		
		Если Лев(Запись.СчетКт.Код, 1) = "7" Тогда
			ПараметрыОплаты.СчетДоходовРасходов = Запись.СчетКт;
			ПараметрыОплаты.ГФУ = Запись.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов;
		КонецЕсли;	
		
		Если Запись.СчетДт.Код = "47903" Тогда
			ПараметрыОплаты.БылоЗакрытие7гоРаздела = Истина;
		КонецЕсли;	
		
		Если (Лев(Запись.СчетКт.Код, 3) = "205" ИЛИ Лев(Запись.СчетКт.Код, 3) = "306")
			И Лев(Запись.СчетДт.Код, 1) <> "7" Тогда
		
			ПараметрыОплаты.СчетРасчетов = Запись.СчетДт;
			
			ПараметрыОплаты.ЕстьСубконтоКонтрагенты = (ПараметрыОплаты.СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
			ПараметрыОплаты.ЕстьСубконтоДоговоры = (ПараметрыОплаты.СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
			ПараметрыОплаты.ЕстьСубконтоОснованиеРасчетов = (ПараметрыОплаты.СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов) <> Неопределено);
		
		КонецЕсли;
		
	КонецЦикла;

	Если ПараметрыОплаты.СчетДоходовРасходов = Неопределено Тогда // придется перебирать проводки оснований
	
		Для каждого СтрокаОснования Из ОплатаОснование.Основания Цикл
		
			НаборЗаписей = РегистрыБухгалтерии.ЕдиныйБухгалтерскийУчет.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СтрокаОснования.Основание);
			НаборЗаписей.Прочитать();
			
			Для каждого Запись Из НаборЗаписей Цикл
						
				Если Лев(Запись.СчетДт.Код, 1) = "7" Тогда
					ПараметрыОплаты.СчетДоходовРасходов = Запись.СчетДт;
					ПараметрыОплаты.ГФУ = Запись.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов;
				КонецЕсли;	
				
				Если Лев(Запись.СчетКт.Код, 1) = "7" Тогда
					ПараметрыОплаты.СчетДоходовРасходов = Запись.СчетКт;
					ПараметрыОплаты.ГФУ = Запись.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов;
				КонецЕсли;	
				
			КонецЦикла;
		
		КонецЦикла;	
	
	КонецЕсли;
	
	Возврат ПараметрыОплаты;
	
КонецФункции

Функция ПолучитьЗадолженностьПоКомиссииНаНачалоДня_ЕПС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Сделка
		|ПОМЕСТИТЬ _ТаблицаСделок
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&НачалоДня,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ТаблицаСделок.Сделка
		|					ИЗ
		|						_ТаблицаСделок КАК _ТаблицаСделок)) КАК ЗадолженностиПоДенежнымСредствамОстатки";
	
	Запрос.УстановитьПараметр("НачалоДня", Новый Граница(НачалоДня(ЭтотОбъект.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ПолучитьДокументОплатыПоТелу(ДоДаты = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОснованияКупон.Основание КАК Основание,
		|	ОснованияТело.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Оплата.Основания КАК ОснованияКупон
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОснованияТело
		|		ПО ОснованияКупон.Основание = ОснованияТело.Основание
		|			И (ОснованияТело.Ссылка.Проведен)
		|			И (ОснованияТело.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации))
		|ГДЕ
		|	ОснованияКупон.Ссылка = &Ссылка
		|	И ОснованияТело.Ссылка.Дата <= &ДоДаты";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Если ДоДаты = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ОснованияТело.Ссылка.Дата <= &ДоДаты", "");
	Иначе
		Запрос.УстановитьПараметр("ДоДаты", ДоДаты);
	КонецЕсли;
	
	МассивОплат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если МассивОплат.Количество() = 0 Тогда // платежа по телу еще не было
	    Возврат Неопределено;
	Иначе
		Возврат МассивОплат[0];
	КонецЕсли;

КонецФункции 
