								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссия; //комиссия, выставленная брокером без привязки к сделке
							ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаСПФИ") Тогда	
