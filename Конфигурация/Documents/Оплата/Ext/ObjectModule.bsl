					СуммаОперацииПоСделке = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.Основание.Сумма, СтрокаОснование.Основание.Валюта, ЭтотОбъект.Организация, СтрокаОснование.Основание.Дата);
				КонецЕсли;
				
				// проводки начала сделки
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
					|ИЗ
					|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
					|			&Период,
