						ПроводкаНачисления.СчетДт,
						ПроводкаНачисления.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаУслуг);
					
				// Начислим комиссию при кассовом методе
				ИначеЕсли МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый
					И ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Тогда
					
					// Поведение оплаты при кассовом методе в части начисления:
					//
					// Покупка Т0 - начисляем на 91, если день сделки не совпадает с днем НАЧИСЛЕНИЯ(!!!) комиссии в противном случае не начисляем
					// Продажа Т0 - начисляем на 91
					// Покупка Т+ - делаем Дт 76.16 Кт 60.5 - я называю это "признание комиссии"
					// Продажа Т+ - начисляем на 91
					// фьючерсы всегда начисляют на 91
					//
					// также есть небольшая "закладка": если метод кассовый -> расходы идут в себестоимость, считаем, что обратного не существует
					
					НачислятьКомиссию = Ложь;
					Использовать7616 = Ложь;
					Если СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
						// фьючерсы
						НачислятьКомиссию = Истина;
					ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка И НЕ СтрокаОснование.Основание.ОтложенноеИсполнение Тогда
						// Покупка Т0 - начисляем на 91, если день сделки не совпадает с днем начисления комиссии в противном случае не начисляем
						
						Запрос = Новый Запрос;
						Запрос.Текст = 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	РасходыПоСделкеОбороты.СуммаОборот КАК СуммаОборот,
							|	РасходыПоСделкеОбороты.Валюта КАК Валюта
							|ИЗ
							|	РегистрНакопления.РасходыПоСделке КАК РасходыПоСделке,
							|	РегистрНакопления.РасходыПоСделке.Обороты(
							|			&НачалоПериода,
							|			&ОкончаниеПериода,
							|			Период,
							|			Организация = &Организация
							|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
							|				И ВидЗадолженности = &ВидЗадолженности
							|				И Сделка = &Сделка) КАК РасходыПоСделкеОбороты";
						
						Запрос.УстановитьПараметр("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
						Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
						Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
						Запрос.УстановитьПараметр("Сделка", СтрокаОснование.Основание);
						Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(СтрокаОснование.Основание.Дата), ВидГраницы.Включая));
						Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(СтрокаОснование.Основание.Дата), ВидГраницы.Включая));
						
						Начислено = 0;
						ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
						Если ВыборкаДетальныеЗаписи.Следующий() Тогда
							Начислено = ВыборкаДетальныеЗаписи.СуммаОборот;
						КонецЕсли;
						
						Если Начислено < СтрокаОснование.СуммаОплаты Тогда
							НачислятьКомиссию = Истина;
						КонецЕсли;
					ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа И НЕ СтрокаОснование.Основание.ОтложенноеИсполнение Тогда
						// Продажа Т0 - начисляем на 91
						НачислятьКомиссию = Истина;
					ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка И СтрокаОснование.Основание.ОтложенноеИсполнение Тогда
						// Покупка Т+ - делаем Дт 76.16 Кт 60.5 - я называю это "признание комиссии"
						НачислятьКомиссию = Истина;
						Использовать7616 = Истина;
					ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа И СтрокаОснование.Основание.ОтложенноеИсполнение Тогда
						НачислятьКомиссию = Истина;
					КонецЕсли;
					
					Если НачислятьКомиссию Тогда
						
						ДанныеАналитики = Новый Структура("Сделка, ВидЗадолженности", СтрокаОснование.Основание, ЭтотОбъект.ВидЗадолженности);
						
						ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Проводка.Сумма, Содержание, ДанныеАналитики);
						
						// Кредит
						ПроводкаНачисления.СчетКт = СчетУчетаУслуг;
						
						Если ЕстьСубконтоКонтрагенты Тогда
							ПроводкаНачисления.СубконтоКт.Контрагенты = Проводка.СубконтоДт.Контрагенты;
						КонецЕсли;
						
						Если ЕстьСубконтоСделки Тогда
							ПроводкаНачисления.СубконтоКт.Сделка = СтрокаОснование.Основание;
						КонецЕсли;
						
						Если ЕстьСубконтоДоговорыДепо Тогда
							ПроводкаНачисления.СубконтоКт.ДоговорыДепозитарногоОбслуживания = СтрокаОснование.Основание.Договор;
						КонецЕсли;
						
						Если ЕстьСубконтоБрокерскиеДоговоры Тогда
							ПроводкаНачисления.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
						КонецЕсли;
						
						Если СчетУчетаУслуг.Валютный Тогда
							ПроводкаНачисления.ВалютнаяСуммаКт = СтрокаОснование.Сумма;
							ПроводкаНачисления.ВалютаКт = СтрокаОснование.Валюта;
						КонецЕсли;
						
						Если Использовать7616 Тогда
						
							// возможна ситуция, когда при покупке комиссию начислили ПОСЛЕ поставки и нужно отправлять на расходы
							Запрос = Новый Запрос;
							Запрос.Текст = 
								"ВЫБРАТЬ РАЗРЕШЕННЫЕ
								|	УсловияСделокСрезПоследних.ДатаПоставки КАК ДатаПоставки,
								|	НАЧАЛОПЕРИОДА(РасходыПоСделке.Регистратор.Дата, ДЕНЬ) КАК ДатаНачисления,
								|	РасходыПоСделке.Валюта КАК Валюта,
								|	РасходыПоСделке.Сумма КАК Сумма
								|ИЗ
								|	РегистрСведений.УсловияСделок.СрезПоследних(
								|			&Период,
								|			Организация = &Организация
								|				И Сделка = &Сделка) КАК УсловияСделокСрезПоследних
								|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке КАК РасходыПоСделке
								|		ПО УсловияСделокСрезПоследних.Сделка = РасходыПоСделке.Сделка
								|			И (РасходыПоСделке.ВидЗадолженности = &ВидЗадолженности)";
							
							Запрос.УстановитьПараметр("ВидЗадолженности", ЭтотОбъект.ВидЗадолженности);
							Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
							Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
							Запрос.УстановитьПараметр("Сделка", СтрокаОснование.Основание);
							
							ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
							
							СуммаНачисленоПослеПоставки = 0; 
							
							Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
								// поставлено раньше, чем начислено
								Если ВыборкаДетальныеЗаписи.ДатаПоставки < ВыборкаДетальныеЗаписи.ДатаНачисления Тогда
								
									СуммаНачисленоПослеПоставки = СуммаНачисленоПослеПоставки + 
											РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.Сумма, 
																						ВыборкаДетальныеЗаписи.Валюта,
																						ЭтотОбъект.Организация,
																						ЭтотОбъект.Дата); 
								
								КонецЕсли;
								
							КонецЦикла;
							
							Если СуммаНачисленоПослеПоставки = Проводка.Сумма Тогда
							
								АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
									ЭтотОбъект.Дата, 
									ЭтотОбъект.Организация, 
									ЭтотОбъект.СчетДоверительногоУправления,
									ЭтотОбъект.ВидЗадолженности,
									УчетныйРегистр,
									"Аналитика");			
								
								БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
									ЭтотОбъект,
									ПроводкаНачисления.СчетДт,
									ПроводкаНачисления.СубконтоДт,
									ПланыСчетов.Основной.ПрочиеРасходы,
									АналитикаУслуг,
									ЦеннаяБумага,
									ОбращаетсяНаОРЦБ);
									
							Иначе
								
								ПроводкаНачисления.СчетДт = ПланыСчетов.Основной.РасчетыПоКомиссии;
								
								ПроводкаНачисления.СубконтоДт.Контрагенты = Проводка.СубконтоДт.Контрагенты;;
								ПроводкаНачисления.СубконтоДт.Сделка      = СтрокаОснование.Основание;
								
							КонецЕсли;
							
							// или же бывет ситуация что сделка была отменена - тогда тоже нужно на расходы
							Запрос = Новый Запрос;
							Запрос.Текст = 
								"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
								|	УсловияСделокСрезПоследних.Отменено КАК Отменено,
								|	УсловияСделокСрезПоследних.Рынок КАК Рынок,
								|	УсловияСделокСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
								|ИЗ
								|	РегистрСведений.УсловияСделок.СрезПоследних(
								|			&Период,
								|			Организация = &Организация
								|				И Сделка = &Сделка) КАК УсловияСделокСрезПоследних
								|ГДЕ
								|	НЕ УсловияСделокСрезПоследних.Отменено";
							
							Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
							Запрос.УстановитьПараметр("Период", ЭтотОбъект.МоментВремени());
							Запрос.УстановитьПараметр("Сделка", СтрокаОснование.Основание);
							
							Если Запрос.Выполнить().Пустой() Тогда // Дт 91,2 Кт 76,16
							
								ПроводкаРасходыПриОтмене = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Проводка.Сумма, "Списана комиссия на расходы", ДанныеАналитики);
								
								АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
									ЭтотОбъект.Дата, 
									ЭтотОбъект.Организация, 
									ЭтотОбъект.СчетДоверительногоУправления,
									ЭтотОбъект.ВидЗадолженности,
									УчетныйРегистр,
									"Аналитика");			
								
								БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
									ЭтотОбъект,
									ПроводкаРасходыПриОтмене.СчетДт,
									ПроводкаРасходыПриОтмене.СубконтоДт,
									ПланыСчетов.Основной.ПрочиеРасходы,
									АналитикаУслуг,
									ЦеннаяБумага,
									ОбращаетсяНаОРЦБ);
								
								
								ПроводкаРасходыПриОтмене.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
								
								ПроводкаРасходыПриОтмене.СубконтоКт.Контрагенты = Проводка.СубконтоДт.Контрагенты;
								ПроводкаРасходыПриОтмене.СубконтоКт.Сделка      = СтрокаОснование.Основание;
								
							
							КонецЕсли;
							
						Иначе
							
							СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, СтрокаОснование.Основание, УчетныйРегистр);

							// Сделано для случая одной ценной бумаги
							ЦеннаяБумага = СтрокаОснование.Основание.ЦенныеБумаги[0].ЦеннаяБумага;
							
							ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
							
							ВыделятьРасходыПриПродаже = Ложь;
							Если СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда 
								ВыделятьРасходыПриПродаже = Истина;
							ИначеЕсли (СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа) Тогда	
								ВыделятьРасходыПриПродаже = НастройкиПоВидуУчета.ВыделятьРасходыПриПродаже;
							КонецЕсли;	
							
							Если ВыделятьРасходыПриПродаже Тогда
								
								АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
									ЭтотОбъект.Дата, 
									ЭтотОбъект.Организация, 
									ЭтотОбъект.СчетДоверительногоУправления,
									ЭтотОбъект.ВидЗадолженности,
									УчетныйРегистр,
									"Аналитика");			
								
								БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
									ЭтотОбъект,
									ПроводкаНачисления.СчетДт,
									ПроводкаНачисления.СубконтоДт,
									ПланыСчетов.Основной.ПрочиеРасходы,
									АналитикаУслуг,
									ЦеннаяБумага,
									ОбращаетсяНаОРЦБ);
									
							Иначе
								
								УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(
									ЭтотОбъект.Дата,
									СтрокаОснование.Основание.Рынок,
									ЦеннаяБумага);
								
								НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
									ЭтотОбъект.Дата,
									ЭтотОбъект.Организация,
									ЭтотОбъект.СчетДоверительногоУправления,
									УчетныйАктив,
									УчетныйРегистр);		
								
								БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
									ЭтотОбъект,
									ПроводкаНачисления.СчетДт,
									ПроводкаНачисления.СубконтоДт,
									ПланыСчетов.Основной.ПрочиеРасходы, 
									НастройкиУчетаАктива.АналитикаДоходовОтРеализации,
									ЦеннаяБумага,
									ОбращаетсяНаОРЦБ);
									
							КонецЕсли;
						
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	#КонецОбласти
	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
		Тогда
		
		РасчетныеНастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
		
	#Область ПогашениеКупона		
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			СуммаОплатыКупона = СтрокаОснование.СуммаОплатыКупона;
			СуммаКупона = СтрокаОснование.СуммаКупона;
			
			
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
				Облигация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснование.Основание, "Облигация");
			ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
				Облигация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснование.Основание, "ЦеннаяБумага");
			ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда	
				// непонятно из какой строки бумагу брать 
				// пробегусь в цикле - посмотрю где вводили дебиторку по погашению купона				
				Для каждого СтрокаЦенныеБумаги Из СтрокаОснование.Основание.ЦенныеБумаги Цикл
					Если СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупон = СуммаКупона Тогда
						Облигация = СтрокаЦенныеБумаги.ЦеннаяБумага;
					КонецЕсли;
				КонецЦикла;					
			КонецЕсли;
			
			ВалютаНоминала 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
			
			Если ВалютаНоминала = ЭтотОбъект.Организация.ВалютаУчета Тогда
				СчетПогашенияКупона = ПланыСчетов.Основной.ПогашениеКупона;
			Иначе
				СчетПогашенияКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации;
			КонецЕсли;
			
			СуммаОплатыКупона = СтрокаОснование.СуммаОплатыКупона;
			СуммаКупона = СтрокаОснование.СуммаКупона;
			
			Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
				И МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый Тогда // получим списания купонов в этом дне и остатки на счете 97
				
				СформироватьПроводкиПоследнегоПогашенияБУНУ(ЭтотОбъект, Облигация, ВалютаНоминала, СчетПогашенияКупона, УчетныйРегистр, СтрокаОснование, СуммаКупона, СуммаОплатыКупона, ВалютаОплаты, Истина, Отказ);
				Если Отказ Тогда
					Возврат;
				КонецЕсли;
				
			КонецЕсли;
			
			Если РасчетныеНастройкиУчета.ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты
				И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход
				И (ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ПогашениеКупона") ИЛИ ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
			Тогда
				НачислитьЗадолженностьКупонаДляОбратногоРЕПО(СтрокаОснование.Основание, СуммаКупона, СтрокаОснование.Валюта, УчетныйРегистр, Отказ);	
