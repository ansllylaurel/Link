	Запрос.УстановитьПараметр("БазовыйТипЗадолженности", Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НаправлениеДвиженияЗадолженности = Перечисления.ВидыДвижений.Приход Тогда
			ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход(), Выборка);
		Иначе
			ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), Выборка);
		КонецЕсли; 
		
	КонецЦикла;

	Если РаботаСНДС.ВестиУчетНДС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
