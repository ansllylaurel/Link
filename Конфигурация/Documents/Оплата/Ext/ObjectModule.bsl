			КоэффициентЗакрытия = СтрокиДокумента.СуммаОплатыКупона / СтрокиДокумента.СуммаКупона;
			Если ОплатаРублямиВалютнойЗадолженности Тогда
				КоэффициентЗакрытия = 1; // пока предполагаем полную оплату, дпльше буду думать - мне бухгалтерия ответ не дала
			КонецЕсли;
			// вообще тут не совсем хорошо, мы можем попасть на копейку из-за округлений
			// но! это редкий случай, когда больше одной оплаты приходит
			// и максимум, что было, это 2 оплаты - они обычно без копеек делятся, но потом подумать надо
			// самая бяка, что остаток берется на дату погашения купона и фиг поймешь сколько там осталось...
			
			СтрокиПартий = СписанияПартий.НайтиСтроки(Новый Структура("Основание", СтрокиДокумента.Основание));
			
			Для Каждого СтрокаПартий из СтрокиПартий Цикл
				
				ПараметрыЗакрытия = Новый Структура;
				
				ПараметрыЗакрытия.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
				ПараметрыЗакрытия.Вставить("ЦеннаяБумага",					СтрокиДокумента.Облигация);
				ПараметрыЗакрытия.Вставить("Партия",						СтрокаПартий.Партия);
				ПараметрыЗакрытия.Вставить("СтрокаПартии",					СтрокаПартий.СтрокаПартии);
				ПараметрыЗакрытия.Вставить("СчетДоходов",					ПланыСчетов.Единый.ПроцентныеДоходы01);
				ПараметрыЗакрытия.Вставить("СчетРасходов",					ПланыСчетов.Единый.ПроцентныеДоходы01);
				ПараметрыЗакрытия.Вставить("Аналитика",						Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
				ПараметрыЗакрытия.Вставить("АналитикаДоходов",				СтрокаПартий.УчетныйАктивЕПС.АналитикаПроцентныхДоходов);
				ПараметрыЗакрытия.Вставить("АналитикаРасходов",				СтрокаПартий.УчетныйАктивЕПС.АналитикаПроцентныхРасходов);
				ПараметрыЗакрытия.Вставить("ВалютаУчета",					ЭтотОбъект.Организация.ВалютаУчета);
				ПараметрыЗакрытия.Вставить("ДоходРасход",					СтрокаПартий.ПереоценкаКупонаСНачалаГода * КоэффициентЗакрытия);
				
				БухгалтерскийУчетЕПС.Закрыть7ойРазделПоПартии(ЭтотОбъект, УчетныйРегистр, ПараметрыЗакрытия);
				
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЦикла;	
	
	БухгалтерскийУчетЕПС.ПереоценитьВалютныеАктивы(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ОплатаПоПогашениюОблигацииЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, СчетДС, ВидСубконтоДС, СубконтоДС, НастройкиУчета, Закрывать7ойРазделПриПоступленииДенежныхСредств, Отказ)
	
	// Если частичное погашение и задолженность на счетах
	//		запрос к партиям - спишем с 500х
	// Иначе
	//		в цикле по строкам с 47408
	// КонецЕсли
	
	// Если НЕ Закрывать7ойРазделПриПоступленииДенежныхСредств
	//		возврат
	// КонецЕсли
	
	// Если частичное погашение
	//		закрываем только если что-то уходило с того дисконта что был начислен в этом году 
	// Иначе
	//		закроем ВСЁ, что ушло из погашения
	// КонецЕсли
	
	
	Если (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации)
		И НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
		
		// читаем движения партий
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОплатаОснования.Основание КАК Основание,
			|	ОплатаОснования.Валюта КАК Валюта,
			|	ОплатаОснования.Сумма КАК СуммаОплаты,
			|	ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).Сумма КАК СуммаПогашения,
			|	ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).Количество КАК Количество,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.Партия КАК Партия,
			|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумаг.Стоимость КАК Стоимость,
			|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
			|	БухПартииЦенныхБумаг.ДисконтПремия КАК ДисконтПремия,
			|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
			|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.КоличествоОстаток, 0) + БухПартииЦенныхБумаг.Количество КАК КоличествоПартии
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|		ПО ОплатаОснования.Основание = БухПартииЦенныхБумаг.Регистратор
			|			И (БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
			|			И (БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|				&Период,
			|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|					И Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК БухПартииЦенныхБумагОстатки
			|		ПО (БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага)
			|			И (БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия)
			|			И (БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии)
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
		
		РезультатЗапроса = Запрос.Выполнить();                                          	
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Облигация 		= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			УчетныйАктив 	= ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			
			ПроверятьРаспределениеПоПартиям = Истина;
			
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
				И НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
				Если ВыборкаДетальныеЗаписи.Основание.ВидПогашения = Перечисления.ВидыПогашения.Оферта Тогда
					ПроверятьРаспределениеПоПартиям = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			// #Хардкод - по этой бумаге был давным-давно неправильный ввод
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Основание) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
				Если СокрЛП(ВыборкаДетальныеЗаписи.Основание.ЦеннаяБумага) = "МФ и НП НСО, RU34016ANO0, 1000.00 RUB" Тогда
					ПроверятьРаспределениеПоПартиям = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			СуммаПоПартии = ВыборкаДетальныеЗаписи.Стоимость + ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный + ВыборкаДетальныеЗаписи.КорректировкаЭСП;
			СуммаПоДокументу = ВыборкаДетальныеЗаписи.СуммаПогашения / ВыборкаДетальныеЗаписи.Количество * ВыборкаДетальныеЗаписи.КоличествоПартии;
			
			Если ПроверятьРаспределениеПоПартиям И СуммаПоПартии <> СуммаПоДокументу Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма распределения по партиям не совпадает с суммой погашения " + ВыборкаДетальныеЗаписи.Основание, ЭтотОбъект,,, Отказ);
			КонецЕсли;

			СуммаОперации 	= ВыборкаДетальныеЗаписи.СуммаОплаты / ВыборкаДетальныеЗаписи.Количество * ВыборкаДетальныеЗаписи.КоличествоПартии;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Погашение облигации");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПогашениеОблигации;
			
			Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаОперации;
			
			
			Проводка.СчетКт = УчетныйАктив.СчетУчета;
		
			Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
			
			Проводка.ВалютаКт = Облигация.ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = СуммаОперации;
			
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
				
			Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
			
		КонецЦикла;
		
		
	Иначе
		
		Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СтрокаОснования.Сумма, "Погашение облигации");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПогашениеОблигации;
			
			Проводка.ВалютаДт  = СтрокаОснования.Валюта;
			Проводка.ВалютнаяСуммаДт = СтрокаОснования.Сумма;
			
			
			Облигация = СтрокаОснования.Основание.ЦеннаяБумага;
			
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
			
			// или это частичное погашение, которое всегда через 47423 или полное + настройка
			Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации     
				ИЛИ НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении <> Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408 Тогда 
				
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
				
			КонецЕсли;
			
			Проводка.СубконтоКт.Контрагенты = Облигация.Эмитент.ЮрФизЛицо;
			Проводка.СубконтоКт.ОснованиеРасчетов = СтрокаОснования.Основание;
			
			Проводка.ВалютаКт = СтрокаОснования.Валюта;
			Проводка.ВалютнаяСуммаКт = СтрокаОснования.Сумма;
			
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
		
		КонецЦикла;
		
	КонецЕсли;
	
	// закроем начисленные резервы
	Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда

		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
		НастройкиУчетаПогашениеКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйАктив, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		Если НастройкиУчетаПогашениеКупона.СписыватьРезервОКУНаДатуПрекращенияПризнания Тогда
			
			СчетУчетаРезервов = ПланыСчетов.Единый.Расчеты25;
			
			АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
			
			СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
			
			БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетУчетаРезервов, ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов, СчетДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет);

			Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
				
				Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
				
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПрочиеДоходыРасходы01, СтрокаОснования.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПрочиеДоходыРасходы02, СтрокаОснования.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
					
					Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
						
						ОблигацияДля7Раздела = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснования.Основание, "ЦеннаяБумага");
						
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам01, ОблигацияДля7Раздела, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам02, ОблигацияДля7Раздела, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
					
					КонецЕсли;
					
				КонецЦикла;
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если НЕ Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
		
		Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
			
			Облигация = СтрокаОснования.Основание.ЦеннаяБумага;
			
	 		БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПроцентныеДоходы01, 			Облигация, Облигация.ВалютаНоминала, "Закрытие доначисления по дисконту", 				ЭтотОбъект.Дата, Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт,,,, Истина);
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПроцентныеДоходы01, 			Облигация, Облигация.ВалютаНоминала, "Закрытие доначисления по погашению облигации",	ЭтотОбъект.Дата, Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка(),,,, Истина);
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПроцентныеДоходы04, 			Облигация, Облигация.ВалютаНоминала, "Закрытие доначисления по премии", 				ЭтотОбъект.Дата,,,,, Истина);
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыОтОпераций03, 	Облигация, Облигация.ВалютаНоминала, "Закрытие переоценки", 							ЭтотОбъект.Дата,,,,, Истина);
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыОтОпераций04, 	Облигация, Облигация.ВалютаНоминала, "Закрытие переоценки", 							ЭтотОбъект.Дата,,,,, Истина);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
				|ГДЕ
				|	БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
				|	И БухПартииЦенныхБумаг.Организация = &Организация
				|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
				|	И БухПартииЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
				|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага";
			
			Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				БухгалтерскийУчетЕПС.ЗакрытьКорректировки710(ЭтотОбъект, Облигация, ЭтотОбъект.Дата, ВыборкаДетальныеЗаписи.УчетныйАктивЕПС, Истина);
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток * БухПартииЦенныхБумаг.ДисконтПремияНачисленный / БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК СуммаДисконта,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов КАК АналитикаПроцентныхДоходов,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток) КАК ДисконтПремияНачисленныйСНачалаГодаОстаток,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Рынок = БухПартииЦенныхБумагОстатки.Рынок
		|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор В(&СписокРегистраторов)
		|	И БухПартииЦенныхБумаг.ДисконтПремияНачисленный <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии";
		
		Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления"	, ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("СписокРегистраторов"				, ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));
		Запрос.УстановитьПараметр("Период"							, Новый Граница(ЭтотОбъект.Основания[0].Основание.Дата, ВидГраницы.Исключая));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			// закрываем только если что-то уходило с того дисконта что был начислен в этом году
			ДисконтПремияНачисленныйНаНачалоГода = Выборка.ДисконтПремияНачисленныйОстаток - Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток;
			Если ДисконтПремияНачисленныйНаНачалоГода < Выборка.ДисконтПремияНачисленный Тогда // списали больше того, что было начислено на начало, значит закрываем
				
				НужноЗакрытьДисконта = Выборка.ДисконтПремияНачисленный - ДисконтПремияНачисленныйНаНачалоГода;
				Если НужноЗакрытьДисконта > Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток Тогда // а вдруг
					НужноЗакрытьДисконта = Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток;
				КонецЕсли;
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
						ЭтотОбъект, 
						ПланыСчетов.Единый.ПроцентныеДоходы01, 
						Выборка.ЦеннаяБумага, 
						Выборка.АналитикаПроцентныхДоходов, 
						Выборка.ВалютаНоминала, 
						"Закрытие доначисления по дисконту", 
						Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт, 
						-НужноЗакрытьДисконта,
						Выборка.Партия,
						Выборка.СтрокаПартии);
																							
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Дата), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	ОплатаКомиссииПобиржевымДепозитам = (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии	И ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК);
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(
																			ЭтотОбъект.Дата,
																			ЭтотОбъект.Организация,
																			ЭтотОбъект.СчетДоверительногоУправления);
																			
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
	ЭтоОплатаПоПоследнемуПогашениюТела = (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюПая);
	ЭтоОплатаПоПоследнемуПогашениюКупона = (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	
	СделатьПроверкуНаОплатуТПлюс = (НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423ПриОплатеВДеньТПлюс);
		
	Если СделатьПроверкуНаОплатуТПлюс // сложное условие у группы будущее, применяем для тела и купона, если он по схеме тела
		И (ЭтоОплатаПоПоследнемуПогашениюТела ИЛИ ЭтоОплатаПоПоследнемуПогашениюКупона И НастройкиУчета.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации) Тогда
		
		ДокументДляПроверки = Неопределено;
		Если ЭтоОплатаПоПоследнемуПогашениюТела Тогда // нам важно понять не прошла ли наша оплата по телу в день Т+ после списания
			ДокументДляПроверки = ЭтотОбъект; 
		ИначеЕсли ЭтоОплатаПоПоследнемуПогашениюКупона Тогда // нам важно понять не прошла ли оплата по телу в день Т+ после списания, но сначала нужно ее найти
			ДокументДляПроверки = ПолучитьДокументОплатыПоТелу(); 
		КонецЕсли;
		
		Если ДокументДляПроверки = Неопределено Тогда // оплата по купону прошла раньше, условие будущего не сработало
			НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408;
		ИначеЕсли БухгалтерскийУчетЕПС.ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423(ДокументДляПроверки, "Оплата") Тогда
			НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
		Иначе
			НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОплатаКомиссииПобиржевымДепозитам Тогда
	    СчетДС = ПланыСчетов.Единый.СчетаДляКлиринга24;
	ИначеЕсли ЭтотОбъект.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02;
		
		ВидСубконтоДС = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
		СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	Иначе
		Если Справочники.Банки.ЯвляетсяРезидентом(ЭтотОбъект.РасчетныйСчет.Банк, Дата) Тогда
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;		
		
		ВидСубконтоДС = ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета;
		СубконтоДС = ЭтотОбъект.РасчетныйСчет;
	КонецЕсли;
	
	ТаблицаДоговоров = Новый ТаблицаЗначений;
	ТаблицаДоговоров.Колонки.Добавить("Контрагент", ПланыВидовХарактеристик.ВидыСубконто.Контрагенты.ТипЗначения);
	ТаблицаДоговоров.Колонки.Добавить("Договор", 	Новый ОписаниеТипов(ПланыВидовХарактеристик.ВидыСубконто.Договоры.ТипЗначения, "СправочникСсылка.Договоры"));
	ТаблицаДоговоров.Колонки.Добавить("Валюта", 	Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДоговоров.Колонки.Добавить("Сумма", 		Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	ТаблицаДоговоров.Колонки.Добавить("ГруппаФинансовогоУчетаДоходовРасходов", Новый ОписаниеТипов("СправочникСсылка.ГруппыФинансовогоУчетаДоходовРасходов"));
	
	Если ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Комиссия)
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.Прочее
		Или ЭтотОбъект.ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.УслугиДоверительногоУправления
	Тогда
	
		ПараметрыКомиссии = Новый Структура();
		ПараметрыКомиссии.Вставить("ВидКомиссии", 			ЭтотОбъект.ВидЗадолженности);
		
		ПараметрыКомиссии.Вставить("СчетДС", 		СчетДС);
		ПараметрыКомиссии.Вставить("СубконтоДС", 	СубконтоДС);
		ПараметрыКомиссии.Вставить("ВидСубконтоДС",	ВидСубконтоДС);
		
		ТаблицаКомиссии = новый ТаблицаЗначений;
		ТаблицаКомиссии.Колонки.Добавить("Сделка", 				Метаданные.ОпределяемыеТипы.Сделки.Тип);
		ТаблицаКомиссии.Колонки.Добавить("ЦеннаяБумага", 		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ТаблицаКомиссии.Колонки.Добавить("УчетныйАктивЕПС", 	Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ТаблицаКомиссии.Колонки.Добавить("ВидСделки", 			Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСделок"));
		ТаблицаКомиссии.Колонки.Добавить("СуммаКомиссии", 		Новый ОписаниеТипов("Число"));
		ТаблицаКомиссии.Колонки.Добавить("СуммаКомиссииВал", 	Новый ОписаниеТипов("Число"));
		ТаблицаКомиссии.Колонки.Добавить("ВалютаКомиссии", 		Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ТаблицаКомиссии.Колонки.Добавить("ВидКомиссии", 		Новый ОписаниеТипов("СправочникСсылка.ВидыЗадолженности"));
	
		РаспределениеАктива = БухгалтерскийУчетЕПС.ПолучитьРаспределениеПоВидуАктива(Основания.Выгрузить(, "Основание"));
		
		ЗадолженностьПоКомиссии = БухгалтерскийУчетЕПС.ПолучитьЗадолженностьПоКомиссииНаГраницу(ЭтотОбъект, Основания.Выгрузить(,"Основание"), ЭтотОбъект.ВидЗадолженности, Новый Граница(НачалоДня(ЭтотОбъект.Дата), ВидГраницы.Исключая),Отказ);
		ЗадолженностьПоКомиссииНаТекущийМомент = БухгалтерскийУчетЕПС.ПолучитьЗадолженностьПоКомиссииНаГраницу(ЭтотОбъект, Основания.Выгрузить(,"Основание"), ЭтотОбъект.ВидЗадолженности, Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая),Отказ);
		
		МассивУчетныхАктивов = Новый Массив;
		МассивЦенныхБумаг = Новый Массив;
		
		ЕстьРЕПО = Ложь;
			
		Для каждого СтрокаОснование из Основания Цикл
			ОснованиеСтроки = СтрокаОснование.Основание;
			
			//Сумма оплаты в валюте учета
			Если ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета Тогда
				СуммаОперации = СтрокаОснование.СуммаОплаты;
			Иначе
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплаты, ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			КонецЕсли;

			Если ЗначениеЗаполнено(ОснованиеСтроки) 
				И (ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.Сделка")
					ИЛИ ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.СделкаРЕПО")) Тогда
						
				Если РаспределениеАктива=Неопределено Тогда	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить распределение активов ЕПС", ЭтотОбъект,,, Отказ);
					Возврат;
				КонецЕсли;
				
				РаспределениеТекущейЦБ = РаспределениеАктива.НайтиСтроки(Новый  Структура("Сделка",ОснованиеСтроки));
				
				Если РаспределениеТекущейЦБ.Количество()=0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определено распределение бумаг по видам актива ЕПС по сделке " + ОснованиеСтроки, ЭтотОбъект,,, Отказ);
					Продолжить;
				КонецЕсли;
				
				ЕстьРЕПО = ЕстьРЕПО ИЛИ ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.СделкаРЕПО");
				СуммаОперацииКРаспределению = СуммаОперации;
				
				//Сумма в валюте сделки
				СуммаКомиссииКРаспределению = СтрокаОснование.Сумма;
				
				КоличествоПоСделке = 0;
				Для каждого СтрокаРаспределенияЦБ из РаспределениеТекущейЦБ Цикл
					КоличествоПоСделке = КоличествоПоСделке + СтрокаРаспределенияЦБ.Количество;
				КонецЦикла;
				
				Для каждого СтрокаРаспределенияЦБ из РаспределениеТекущейЦБ Цикл
					
					Если МассивУчетныхАктивов.Найти(СтрокаРаспределенияЦБ.УчетныйАктивЕПС) = Неопределено Тогда
						МассивУчетныхАктивов.Добавить(СтрокаРаспределенияЦБ.УчетныйАктивЕПС);
					КонецЕсли;
					Если МассивЦенныхБумаг.Найти(СтрокаРаспределенияЦБ.ЦеннаяБумага) = Неопределено Тогда
						МассивЦенныхБумаг.Добавить(СтрокаРаспределенияЦБ.ЦеннаяБумага);
					КонецЕсли;
					
					ТекКоличество = СтрокаРаспределенияЦБ.Количество;
					СуммаКомиссииПоСтроке = Окр(СуммаКомиссииКРаспределению * ТекКоличество / КоличествоПоСделке,2);
					СуммаОперацииПоСтроке = Окр(СуммаОперацииКРаспределению * ТекКоличество / КоличествоПоСделке,2);
					
					ЭтоВнебиржеваяСделка = (ОснованиеСтроки.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок);
					
					Если НЕ СтрокаОснование.Основание.ОтложенноеИсполнение Тогда // Сделка Т0
						ОплатаВДеньИсполнения = Истина;
					ИначеЕсли НЕ ЭтоВнебиржеваяСделка Тогда // Сделка Т+
						ОплатаВДеньИсполнения = НачалоДня(СтрокаОснование.Основание.ДатаИсполнения) <= НачалоДня(ЭтотОбъект.Дата);
					Иначе // внебиржевая сделка
						ОплатаВДеньИсполнения = НачалоДня(СтрокаОснование.Основание.ДатаОплаты) <= НачалоДня(ЭтотОбъект.Дата);
					КонецЕсли;
						
					ПроводитьЧерезРасчеты = Ложь;
					СтрокаЗадолженности = ЗадолженностьПоКомиссии.Найти(СтрокаОснование.Основание,"Сделка");
					Если СтрокаЗадолженности <> Неопределено Тогда
						Если СтрокаЗадолженности.СуммаОстаток > 0 Тогда
							ПроводитьЧерезРасчеты = Истина;

							// это сделано для случай оплаты задолженности по нескольким начислениям комиссии
							// если мы по одному начислению оплатили, то 2ой раз его уже не учитываем
							СтрокаЗадолженности.СуммаОстаток = СтрокаЗадолженности.СуммаОстаток - Мин(СтрокаЗадолженности.СуммаОстаток, СуммаКомиссииПоСтроке);
						КонецЕсли;
					КонецЕсли;
					
					// в случае частичной оплаты комиссии (очень редкий случай)
					СтрокаЗадолженностиНаТекущийМомент = ЗадолженностьПоКомиссииНаТекущийМомент.Найти(СтрокаОснование.Основание,"Сделка");
					Если СтрокаЗадолженностиНаТекущийМомент <> Неопределено 
						И (ТипЗнч(ОснованиеСтроки) <> Тип("ДокументСсылка.СделкаРЕПО") И НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении) Тогда
						Если СтрокаЗадолженностиНаТекущийМомент.СуммаОстаток > СтрокаОснование.Сумма тогда
							ПроводитьЧерезРасчеты = Истина;
						КонецЕсли;
						// это сделано для случай оплаты задолженности по нескольким начислениям комиссии
						// если мы по одному начислению оплатили, то 2ой раз его уже не учитываем
						СтрокаЗадолженностиНаТекущийМомент.СуммаОстаток = СтрокаЗадолженностиНаТекущийМомент.СуммаОстаток - Мин(СтрокаЗадолженностиНаТекущийМомент.СуммаОстаток, СтрокаОснование.Сумма);
					КонецЕсли;
					
					Если ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.СделкаРЕПО") И НастройкиУчета.ОтражатьРасчетыПоРасходамПоРепоПоФактуОплаты Тогда
						ПроводитьЧерезРасчеты = Ложь;
					ИначеЕсли ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.Сделка") И НастройкиУчета.ПроводитьКомиссиюПоСделкамЧерезСчетаРасчетов Тогда
					    ПроводитьЧерезРасчеты = Истина;
					КонецЕсли;
					
					ПараметрыКомиссии.Вставить("ЦБ", 								СтрокаРаспределенияЦБ.ЦеннаяБумага);
					ПараметрыКомиссии.Вставить("УчетныйАктив", 						СтрокаРаспределенияЦБ.УчетныйАктивЕПС);
					ПараметрыКомиссии.Вставить("ВидСделки", 						СтрокаОснование.Основание.ВидСделки);
					ПараметрыКомиссии.Вставить("СуммаКомисии", 						СуммаКомиссииПоСтроке);
					ПараметрыКомиссии.Вставить("ВалютаКомиссии", 					СтрокаОснование.Валюта);
					ПараметрыКомиссии.Вставить("СуммаОперации", 					СуммаОперацииПоСтроке);
					ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", 				ЭтотОбъект.Контрагент);
					ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",				ОплатаВДеньИсполнения);
					ПараметрыКомиссии.Вставить("Сделка",							ОснованиеСтроки);
					
					Если СтрокаРаспределенияЦБ.УчетныйАктивЕПС = Неопределено Тогда
						ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", Ложь);
					Иначе
						ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость",СтрокаРаспределенияЦБ.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость);
					КонецЕсли;
					
					ПараметрыКомиссии.Вставить("ПроводитьЧерезРасчеты", 			ПроводитьЧерезРасчеты);
					ПараметрыКомиссии.Вставить("ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты",	НастройкиУчета.ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты);
					
					Если НастройкиУчета.ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты Тогда
					    // не могу менять извращенную логику, поэтому просто встроюсь в нее
						ОплатаВДеньСделки = (НачалоДня(СтрокаОснование.Основание.Дата) = НачалоДня(ЭтотОбъект.Дата));
						ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",				ОплатаВДеньСделки);
					
					КонецЕсли;
					
					Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
						ПараметрыКомиссии.Вставить("ОтражатьПартииНаЛицевыхСчетах",	Истина);	
					КонецЕсли;
					
					ПараметрыКомиссии.Вставить("Закрывать7ойРазделПриПоступленииДенежныхСредств",	Закрывать7ойРазделПриПоступленииДенежныхСредств);
					
					БухгалтерскийУчетЕПС.ОплатитьКомиссиюНаЦБ(ЭтотОбъект,ПараметрыКомиссии, Отказ);
					
					СтрокаКомиссии 					= ТаблицаКомиссии.Добавить();
					СтрокаКомиссии.Сделка 			= ОснованиеСтроки;
					СтрокаКомиссии.ЦеннаяБумага 	= ПараметрыКомиссии.ЦБ;
					СтрокаКомиссии.УчетныйАктивЕПС 	= ПараметрыКомиссии.УчетныйАктив;
					СтрокаКомиссии.ВидСделки 		= ПараметрыКомиссии.ВидСделки;
					СтрокаКомиссии.СуммаКомиссии 	= СуммаОперацииПоСтроке;
					СтрокаКомиссии.СуммаКомиссииВал = ПараметрыКомиссии.СуммаКомисии;
					СтрокаКомиссии.ВалютаКомиссии 	= ПараметрыКомиссии.ВалютаКомиссии;
					СтрокаКомиссии.ВидКомиссии 		= ПараметрыКомиссии.ВидКомиссии;
					
					КоличествоПоСделке = КоличествоПоСделке - ТекКоличество;
					СуммаКомиссииКРаспределению = СуммаКомиссииКРаспределению - СуммаКомиссииПоСтроке;
					СуммаОперацииКРаспределению = СуммаОперацииКРаспределению - СуммаОперацииПоСтроке;
				КонецЦикла;
				
				Если ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.СделкаРЕПО") Тогда 
					
					Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
						ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;	
						ОписаниеПроводкиЗакрытия = "Комиссия брокера закрытие расхода";
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
						ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия;	
						ОписаниеПроводкиЗакрытия = "Торговая комиссия закрытие расхода";
					КонецЕсли;
					
					КонтрагентПоСделке = ОснованиеСтроки.Контрагент;
					// некоторые клиенты не хотят раскрывать реального контрагента по репо и требуют отображать брокера
					Если НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО Тогда
						Если ОснованиеСтроки.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
							КонтрагентПоСделке = ОснованиеСтроки.Брокер.ЮрФизЛицо;
						КонецЕсли;
					КонецЕсли;
					
					Если НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОплате Тогда
						
						БухгалтерскийУчетЕПС.ПроводкиПризнанияКомиссииПоРЕПО(ЭтотОбъект, 
							ОснованиеСтроки, 
							СуммаОперации, 
							СтрокаОснование.Сумма,
							ПараметрыКомиссии.ВалютаКомиссии, 
							Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО, 
							ОснованиеСтроки.ЦенныеБумаги[0].ЦеннаяБумага,
							КонтрагентПоСделке,
							ЭтотОбъект.Контрагент, 
							ДополнительнаяАналитика,
							Закрывать7ойРазделПриПоступленииДенежныхСредств);
						
					ИначеЕсли НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО
							И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
							
						// Методика Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО была сделана для счетов ДУ
						// "ГСК Югория АО" и "НПФ Достойное БУДУЩЕЕ  АО РОПС" 
						// клиенты были недовольны, что по торговой комиссии комиссии по РЕПО используются ОФР кредитных организаций (т.к. контрагент НЦК)
						// а по брокерской комиссии по РЕПО используются ОФР некредитных организаций (т.к. берется брокер БК)
						// и написали письма чтобы ОФРы были единые, поэтому теперь по сделкам РЕПО для этой методики берем контрагента по сделке РЕПО, а не брокера
						КонтрагентПоКомиссии = ЭтотОбъект.Контрагент;
						Если ЗначениеЗаполнено(СтрокаОснование.Основание.Контрагент) Тогда
							КонтрагентПоКомиссии = СтрокаОснование.Основание.Контрагент;
						КонецЕсли;
						
						ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоКомиссии, ЭтотОбъект.Дата);
						
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиЗакрытия);
						// дебет
						Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
						Проводка.СубконтоДт.Договоры = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
						
						// кредит
						Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы03;
						Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
						Проводка.СубконтоКт.ЦенныеБумаги = ОснованиеСтроки.ЦенныеБумаги[0].ЦеннаяБумага;
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ОснованиеСтроки)
					И ТипЗнч(ОснованиеСтроки) = Тип("ДокументСсылка.Оплата") Тогда  //возврат аванса
					
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Поступление услуг");
				
				Проводка.СчетДт 					= СчетДС;
				Проводка.СубконтоДт[ВидСубконтоДС] 	= СубконтоДС;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления;
								
				Проводка.ВалютаДт  			= ВалютаОплаты;
