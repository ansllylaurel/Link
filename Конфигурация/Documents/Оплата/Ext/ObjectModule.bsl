							Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияРЕПО;
							ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности")
								ИЛИ ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента") Тогда	
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
							ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаСПФИ") Тогда	
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
							ИначеЕсли (ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"))
								И СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы
								И СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда	
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупкаТБС;
							ИначеЕсли (ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"))
								И СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.ДрагоценныеМеталлы
								И СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда	
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажаТБС;
							ИначеЕсли СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда	
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
							Иначе
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
						ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссия;
