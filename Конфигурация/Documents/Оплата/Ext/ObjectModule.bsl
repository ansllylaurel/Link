#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ЭтотОбъект.Метаданные().ТабличныеЧасти.Основания.Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(ДанныеЗаполнения))
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда // ввод на основании
		ЗаполнитьДокументНаОсновании(ДанныеЗаполнения);
	КонецЕсли;	
	
	// заполним связанные поля
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВалютаОплаты) Тогда
		ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "СтрокаБанковскойВыписки");
	
	ЭтотОбъект.Основания.Очистить();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты) 
	Если ЭтотОбъект.Аванс Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
		
		// Необходимость проверки реквизита "Поручение"
		Если Документы.Оплата.ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям(ЭтотОбъект) Тогда
			ПроверяемыеРеквизиты.Добавить("Поручение");
		КонецЕсли;
	Иначе
		// Необходимость проверки реквизита "Основание" табличной части "Основания"
		Если ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоПрочимДоходамИРасходам Тогда
			ПроверяемыеРеквизиты.Добавить("Основания.Основание");
		КонецЕсли;
		
		// Необходимость проверки реквизита "Контрагент"
		Если ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
			ПроверяемыеРеквизиты.Добавить("Контрагент");
		КонецЕсли;
	КонецЕсли;
	
	// !!! ВРЕМЕННО НЕ ПРОВЕРЯЕМ (09.10.2024)
	//// Необходимость проверки реквизита "Договор"
	//НеобходимостьПроверкиРеквизитаДоговор = Документы.Оплата.НеобходимостьПроверкиРеквизитаДоговор(ЭтотОбъект);
	//Если НеобходимостьПроверкиРеквизитаДоговор И Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
	//	ПроверяемыеРеквизиты.Добавить("Договор");
	//КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// т.к. никакие механизмы не адаптированы для работы с полями "СуммаОплаты" и "СуммаОплатыКупона",
	// как временное :)) решение сделаем следующий ход конем: если валюта задолженности совпадает с валютой
	// оплаты, то в суммы оплаты подставим суммы задолженности
	Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
		Если СтрокаОснования.Валюта = ЭтотОбъект.ВалютаОплаты И Не ЗначениеЗаполнено(СтрокаОснования.СуммаОплаты) Тогда
			СтрокаОснования.СуммаОплаты       = СтрокаОснования.Сумма;
			СтрокаОснования.СуммаОплатыКупона = СтрокаОснования.СуммаКупона;
		КонецЕсли;
	КонецЦикла;
	
	// Блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда // Блокирующие проверки
		
		Если ЭтотОбъект.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК Тогда
			РаботаСДокументами.ПроверитьЗаполнениеРасчетногоСчета(ЭтотОбъект, Отказ);
		КонецЕсли;
		
		КоличествоСтрокТабличнойЧасти = ЭтотОбъект.Основания.Количество();
		
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде Тогда
			Если ЭтотОбъект.ОбеспечительныйПлатеж И НЕ ЭтотОбъект.Аванс Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обеспечительный платеж учитывается как аванс. Установите признак аванса!", ЭтотОбъект, "Аванс",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтотОбъект.Аванс 
			И Справочники.ВидыЗадолженности.ДопустимоПредварительноеНачислениеЗадолженности(ЭтотОбъект.Организация, ЭтотОбъект.ВидЗадолженности, ЭтотОбъект.Дата)
			И НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаПлановогоПогашенияЗадолженности)
			И ЭтотОбъект.Дата > Дата(2022,7,1) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного вида задолженности обязательно указание даты планового погашения!", ЭтотОбъект, "ДатаПлановогоПогашенияЗадолженности",, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ОшибочноеСписание
			И ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоПрочимУслугам
			И (ЭтотОбъект.КоррСчет <> ПланыСчетов.Основной.ПустаяСсылка() ИЛИ ЭтотОбъект.КоррСчетЕПС <> ПланыСчетов.Единый.ПустаяСсылка()) Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности " + Строка(ЭтотОбъект.ВидЗадолженности) + " не должен заполняться КоррСчет", ЭтотОбъект, "КоррСчет",, Отказ);
		
		КонецЕсли;
		
		// если р/счет контрагента задан, то его владельцем должен являться контрагент, а валюта должна совпасть с валютой оплаты
		Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетКонтрагента) Тогда
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.ЮрФизЛицо <> ЭтотОбъект.Контрагент Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Р/с контрагента " + ЭтотОбъект.РасчетныйСчетКонтрагента + " не принадлежит контрагенту " + ЭтотОбъект.Контрагент, ЭтотОбъект, "РасчетныйСчетКонтрагента",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.Валюта <> ЭтотОбъект.ВалютаОплаты Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта р/с контрагента " + ЭтотОбъект.РасчетныйСчетКонтрагента + " отличается от валюты оплаты " + ЭтотОбъект.ВалютаОплаты, ЭтотОбъект, "РасчетныйСчетКонтрагента",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// проверка табличной части
		Для Инд = 0 По КоличествоСтрокТабличнойЧасти - 1 Цикл
			
			СтрокаОснования = ЭтотОбъект.Основания[Инд];
			
			//Чтобы правильно выводить представление оплаты при зачете аванса - запретим, чтобы в табличной части одновременно были оплаты и другие документы
			Если Инд = 0 Тогда
				ТипОснованияВПредыдущейСтроке = ТипЗнч(СтрокаОснования.Основание);
			ИначеЕсли (ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.Оплата") И ТипОснованияВПредыдущейСтроке <> Тип("ДокументСсылка.Оплата"))
				Или (ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.Оплата") И ТипОснованияВПредыдущейСтроке = Тип("ДокументСсылка.Оплата"))
			Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В табличной части оснований нельзя одновременно с оплатами выбирать документы других видов", ЭтотОбъект, "Основания[" + Инд + "].Основание",, Отказ);
			Иначе
				ТипОснованияВПредыдущейСтроке = ТипЗнч(СтрокаОснования.Основание);
			КонецЕсли;
			
			// Одна из сумм должна быть отлична от 0
			Если (СтрокаОснования.Сумма = 0) И (СтрокаОснования.СуммаКупона = 0) Тогда
				
				Если (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке) Или (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО) 
					Или (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО)
				Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " сумма и сумма купона равны 0", ЭтотОбъект, "Основания[" + Инд + "].Сумма",, Отказ);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " сумма равна 0", ЭтотОбъект, "Основания[" + Инд + "].Сумма",, Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
			Если (СтрокаОснования.СуммаКупона = 0) 
				И ((ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона)
					ИЛИ (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд+1) + " сумма купона равна 0", ЭтотОбъект, "Основания[" + Инд + "].СуммаКупона",, Отказ);
			КонецЕсли;
			
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение
				И НЕ ЗначениеЗаполнено(ЭтотОбъект.Договор)
				И НЕ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.УслугиДоверительногоУправления)
				И НЕ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ)
				И НЕ ВидЗадолженности = Справочники.ВидыЗадолженности.ОшибочноеСписание
				И (Аванс 
					ИЛИ НЕ Аванс И ЗначениеЗаполнено(СтрокаОснования.Основание) И ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.Оплата")
					ИЛИ Справочники.ВидыЗадолженности.ТребуетсяУказаниеДоговораДляВидаЗадолженности(ВидЗадолженности))
				И РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаОрганизации(ЭтотОбъект.Организация).Найти(ЭтотОбъект.Контрагент) = Неопределено Тогда			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен реквизит 'Договор'!", ЭтотОбъект, "Договор",, Отказ);
			КонецЕсли;
			
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснования.Основание, "Предварительно") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке № " + Строка(Инд + 1) + " указано предварительное начисление задолженности!", ЭтотОбъект, "Основания[" + Инд + "].Основание",, Отказ);
			КонецЕсли;
			
			// Для торговой комиссии депозитов с ЦК проверка соответствия контрагента документа банку депозитного вклада
			
			Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
				И ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК
				И ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента")
			Тогда
				
				РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаОснования.Основание,
					Новый Структура("КредитныйИнструмент, БанкДепозита", "КредитныйИнструмент", "КредитныйИнструмент.БанковскийСчет.Банк.ЮрФизЛицо"));
				
				Если РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(РеквизитыОснования.КредитныйИнструмент)
					И ЭтотОбъект.Контрагент <> РеквизитыОснования.БанкДепозита
				Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагент " + ЭтотОбъект.Контрагент + " не является юр/лицом банка " + РеквизитыОснования.БанкДепозита + " в договоре депозитного вклада", ЭтотОбъект, "Основания[" + Инд + "].Основание",, Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не (ЭтотОбъект.ДополнительныеСвойства.Свойство("ВидыУчетаДляПроведения") И ЭтотОбъект.ДополнительныеСвойства.ВидыУчетаДляПроведения.Количество() > 0)
			И Документы.Оплата.ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям(ЭтотОбъект) Тогда 
			
			ТекстЗапроса = "";
			
			Если ЭтотОбъект.Аванс Тогда
				// Если аванс - оплата создается на основании поручения. Проверяем акцептовано ли поручение. Сразу проверим и наличие задолженности.
				Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда
					
					ТекстЗапроса = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание КАК Ссылка
						|ИЗ
						|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
						|			&Дата,
						|			Организация = &Организация
						|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
						|				И Основание В (&Основания)) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки";
										
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать оплаты авансом без поручений на движение денежных средств.", ЭтотОбъект, "Поручение",, Отказ);
				КонецЕсли;
				
			Иначе 
				// Если НЕ аванс - оплата создается на основании начисления задолженности. На основании этого же начисления задолженности создается поручение (в документе "поручение" есть реквизит "Основание")
				// Проверяем акцептовано ли поручение, которое создано на основании "Начисления задолженности".
				Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать оплаты на основании поручений если это не оплата авансом.", ЭтотОбъект, "Аванс",, Отказ);
				Иначе
					
					ТекстЗапроса = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Ссылка
						|ИЗ
						|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
						|			&Дата,
						|			Организация = &Организация
						|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
						|				И Основание В (&Основания)) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
						|		ПО ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание = ПоручениеНаДвижениеДенежныхСредств.Основание
						|			И (ПоручениеНаДвижениеДенежныхСредств.Проведен)";
						
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
				
				Запрос = Новый Запрос(ТекстЗапроса);
				Запрос.УстановитьПараметр("Дата", Новый Граница(ЭтотОбъект.Дата, ВидГраницы.Исключая)); 
				Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
				Запрос.УстановитьПараметр("Основания", ?(ЭтотОбъект.Аванс, ЭтотОбъект.Поручение, ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание")));
		
				Результат = Запрос.Выполнить();
			
				Если Результат.Пустой() Тогда
					
					Если ЭтотОбъект.Аванс Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует задолженность по денежным средствам по поручениям. Документ [" + ЭтотОбъект.Поручение + "]", ЭтотОбъект, "Поручение",, Отказ);	
					Иначе
						
						Для Каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл	
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для основания [" + СтрокаОснования.Основание + "] отсутствует задолженность по денежным средствам по поручениям.", ЭтотОбъект,,, Отказ);	
						КонецЦикла;	
					
					КонецЕсли;                                            
					
				Иначе
					
					Выборка = Результат.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						Если Не РаботаСдокументами.ПоручениеНаВыводАктивовСогласовано(Выборка.Ссылка, ЭтотОбъект.Дата) Тогда	
							
							Если ЭтотОбъект.Аванс Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя проводить оплату на основании несогласованного поручения [" + Выборка.Ссылка + "]", ЭтотОбъект,,, Отказ);	
							Иначе	
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя проводить оплату на основании начисления задолженности, для которого не согласовано поручение [" + Выборка.Ссылка + "]", ЭтотОбъект,,, Отказ);							
							КонецЕсли;
							
						Иначе
							
							СчетИзПоручения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Ссылка, "РасчетныйСчет");
							
							Если ЭтотОбъект.РасчетныйСчет <> СчетИзПоручения Тогда	
							
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет списания [" + ЭтотОбъект.РасчетныйСчет + "] не соответствует расчетному счету в документе [" + Выборка.Ссылка + "].", ЭтотОбъект,,, Отказ);			
							
							КонецЕсли;
							
						КонецЕсли;
		
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЕсли;
		
		РаботаСДокументами.ПроверитьВидыЗадолженностиОплачиваемойИзСобственныхСредствКлиента(ЭтотОбъект, Отказ);
		
		РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
			ЭтотОбъект.СтрокаБанковскойВыписки, ЭтотОбъект.ВидДвижения, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти 

Процедура ЗаполнитьДокументНаОсновании(ДокументОснование, ВыбВидЗадолженности = Неопределено)
		
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		// В сделке с валютой какой расчетный счет брать зависит от вида задолженности
		ЗаполняемыеРеквизитыШапки = Новый Структура("Организация, СчетДоверительногоУправления, Брокер, МестоХранения");	
	Иначе	
		ЗаполняемыеРеквизитыШапки = Новый Структура("Организация, СчетДоверительногоУправления, Брокер, МестоХранения, РасчетныйСчет");
	КонецЕсли; 

	ЗаполнитьЗначенияСвойств(ЗаполняемыеРеквизитыШапки, ДокументОснование);
	
	// в некоторых документах МестоХранения отсутствует; при этом подразумевается, что используется внебиржевой рынок
	Если Не ЗначениеЗаполнено(ЗаполняемыеРеквизитыШапки.МестоХранения) Тогда
		ЗаполняемыеРеквизитыШапки.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗаполняемыеРеквизитыШапки);
	
	// определим документы, на основании которых начислена задолженность
	ОснованияЗадолженности	= Новый Массив;
	ВидыЗадолженностей		= Новый Массив;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеЗадолженности") 
		И (ДокументОснование.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии
				Или ДокументОснование.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение
				Или ДокументОснование.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ)
				Или ДокументОснование.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль
				Или ДокументОснование.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
				Или ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗагрузкаБанковскойВыписки") И ЭтотОбъект.ДополнительныеСвойства.ЗагрузкаБанковскойВыписки)
	Тогда
		ЭтотОбъект.ВидЗадолженности = ДокументОснование.ВидЗадолженности;
		
		// основанием задолженности м.б. как само поступление услуг (в этом случае основание в таб.ч. не заполнено),
		// так и документ-основание, указанный в его табличной части
		Для каждого СтрокаОснования Из ДокументОснование.Основания Цикл
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.РасчетНДФЛ") Тогда 
				ОснованияЗадолженности.Добавить(ДокументОснование);
			ИначеЕсли ЗначениеЗаполнено(СтрокаОснования.Основание) Тогда
				ОснованияЗадолженности.Добавить(СтрокаОснования.Основание);
			ИначеЕсли ОснованияЗадолженности.Найти(ДокументОснование) = Неопределено Тогда
				ОснованияЗадолженности.Добавить(ДокументОснование);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЗадолженностиПоДенежнымСредствам.Основание
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|ГДЕ
			|	ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор";
			
		Запрос.УстановитьПараметр("Регистратор", ДокументОснование);
		
		ОснованияЗадолженности = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Основание");
		
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода);
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РаспределениеДоходаПайщикам") Тогда
		
		ОснованияЗадолженности.Добавить(ДокументОснование);
		
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ13);     
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ15);     
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ30);     
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям);
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		
		Если РаботаСДокументами.ДействуетКонтрольПорученийВнутреннейСистемы(ДокументОснование.Дата, ДокументОснование.Организация) Тогда
		
			ЭтотОбъект.РасчетныйСчет = ДокументОснование.РасчетныйСчет;
			ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход;
			ЭтотОбъект.ВалютаОплаты = ДокументОснование.Валюта; 
			ЭтотОбъект.Аванс = Истина;
			ЭтотОбъект.Поручение = ДокументОснование;
			
			НоваяСтрокаОснования = ЭтотОбъект.Основания.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОснования, ДокументОснование,, "Основание");
			НоваяСтрокаОснования.СуммаОплаты = ДокументОснование.Сумма;
	        Возврат;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасчетНДФЛПайщиков") Тогда
		ОснованияЗадолженности.Добавить(ДокументОснование);		
		ВидыЗадолженностей.Добавить(Справочники.ВидыЗадолженности.ПоНДФЛ13);
	Иначе
		ОснованияЗадолженности.Добавить(ДокументОснование);	
	КонецЕсли;
	
	Если ВыбВидЗадолженности <> Неопределено И НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидЗадолженности) Тогда
		ЭтотОбъект.ВидЗадолженности = ВыбВидЗадолженности;
	КонецЕсли;

	// заполним основания
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.Основание.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.)) КАК Договор,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупона,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Сделки))
		|			ТОГДА ВЫБОР
		|					КОГДА УсловияСделокСрезПоследних.ВалютаОплаты <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|						ТОГДА УсловияСделокСрезПоследних.ВалютаОплаты
		|					КОГДА УсловияСделокРЕПОСрезПоследних.ВалютаОплаты <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|						ТОГДА УсловияСделокРЕПОСрезПоследних.ВалютаОплаты
		|					ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|				КОНЕЦ
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.Валюта
		|	КОНЕЦ КАК ВалютаОплаты,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Сделки))
		|			ТОГДА ЕСТЬNULL(УсловияСделокСрезПоследних.ДатаОплаты, ЕСТЬNULL(УсловияСделокРЕПОСрезПоследних.ДатаОплаты, СделкаСВалютой.ДатаИсполнения))
		|		ИНАЧЕ ЕСТЬNULL(ПлановыеДатыОплатСрезПоследних.ДатаОплаты, СделкаСВалютой.ДатаИсполнения)
		|	КОНЕЦ КАК ДатаОплаты
		|ПОМЕСТИТЬ _ЗадолженностиПоДенежнымСредствамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			,
		|			Основание В (&Основания)
		|				И Организация = &Организация
		|				И &ОграничениеПоВидуЗадолженности
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|			МАКСИМУМ(УсловияСделокСрезПоследних.ДатаОплаты) КАК ДатаОплаты,
		|			УсловияСделокСрезПоследних.ВалютаОплаты КАК ВалютаОплаты
		|		ИЗ
		|			РегистрСведений.УсловияСделок.СрезПоследних(
		|					,
		|					Сделка В (&Основания)
		|						И НЕ Отменено) КАК УсловияСделокСрезПоследних
		|		
		|		СГРУППИРОВАТЬ ПО
		|			УсловияСделокСрезПоследних.Сделка,
		|			УсловияСделокСрезПоследних.ВалютаОплаты) КАК УсловияСделокСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = УсловияСделокСрезПоследних.Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				,
		|				СделкаРЕПО В (&Основания)
		|					И НЕ Отменено
		|					И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЧастьСделкиРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ЧастьСделкиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = СделкаСВалютой.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|				,
		|				Основание В (&Основания)
		|					И Организация = &Организация
		|					И &ОграничениеПоВидуЗадолженности
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ПлановыеДатыОплатСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ПлановыеДатыОплатСрезПоследних.ВидЗадолженности
		|			И ЗадолженностиПоДенежнымСредствамОстатки.Основание = ПлановыеДатыОплатСрезПоследних.Основание
		|			И ЗадолженностиПоДенежнымСредствамОстатки.Валюта = ПлановыеДатыОплатСрезПоследних.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Договор КАК Договор,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Сумма КАК Сумма,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупона КАК СуммаКупона,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.Сумма КАК СуммаОплаты,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупона КАК СуммаОплатыКупона,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ВалютаОплаты КАК ВалютаОплаты,
		|	_ЗадолженностиПоДенежнымСредствамОстатки.ДатаОплаты КАК ДатаОплаты
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствамОстатки КАК _ЗадолженностиПоДенежнымСредствамОстатки";
			
	Запрос.УстановитьПараметр("Основания",                    ОснованияЗадолженности);
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидЗадолженности) Тогда
		ВидыЗадолженностей.Добавить(ЭтотОбъект.ВидЗадолженности);
	КонецЕсли;
	
	Если ВидыЗадолженностей.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ОграничениеПоВидуЗадолженности","ВидЗадолженности В (&ВидыЗадолженности)");
		Запрос.УстановитьПараметр("ВидыЗадолженности", ВидыЗадолженностей);
	Иначе
		Запрос.УстановитьПараметр("ОграничениеПоВидуЗадолженности",             Истина);
	КонецЕсли;
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	КолВариантовЗаполнения = ПакетРезультатовЗапроса[1].Выгрузить().Количество();
	
	Если КолВариантовЗаполнения = 1 Тогда
		// если есть только одна комбинация контрагента, типа и вида задолженности, то сразу заполним документ
		Выборка = ПакетРезультатовЗапроса[2].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЭтотОбъект.Основания.Количество() = 0 Тогда
				ЭтотОбъект.ВидЗадолженности = Выборка.ВидЗадолженности;
				ЭтотОбъект.Контрагент	 	= Выборка.Контрагент;
				ЭтотОбъект.Договор 			= Выборка.Договор;
				ЭтотОбъект.ВидДвижения      = РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьВидДвиженияПоТипуЗадолженности(Выборка.ТипЗадолженности);
				ЭтотОбъект.ВалютаОплаты 	= Выборка.ВалютаОплаты;
				ЭтотОбъект.Дата 			= РаботаСДокументами.ПолучитьВремяДокумента(?(ЗначениеЗаполнено(Выборка.ДатаОплаты), Выборка.ДатаОплаты, ТекущаяДатаСеанса()), ЭтотОбъект.Ссылка);
			КонецЕсли;
						
			НоваяСтрокаОснования = ЭтотОбъект.Основания.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОснования, Выборка);
			
			Документы.Оплата.ЗаполнитьДанныеКонтрагента(ЭтотОбъект, НоваяСтрокаОснования);
			
			Если НЕ ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет) И ЗначениеЗаполнено(НоваяСтрокаОснования.Основание) И ТипЗнч(НоваяСтрокаОснования.Основание)=Тип("ДокументСсылка.СделкаСВалютой") Тогда
				Документы.Оплата.ЗаполнитьРасчетныйСчетПоСделкеСВалютой(ЭтотОбъект);
			КонецЕсли;
			
			НоваяСтрокаОснования.СуммаОплаты 		= РаботаСВалютами.ПересчетСуммыВВалюте(НоваяСтрокаОснования.Сумма, НоваяСтрокаОснования.Валюта, ЭтотОбъект.Дата, ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Дата); 
			НоваяСтрокаОснования.СуммаОплатыКупона 	= РаботаСВалютами.ПересчетСуммыВВалюте(НоваяСтрокаОснования.СуммаКупона, НоваяСтрокаОснования.Валюта, ЭтотОбъект.Дата, ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Дата);
			
		КонецЦикла;
		
	ИначеЕсли КолВариантовЗаполнения = 0 Тогда
		// если задолженность отсутствует, заблокируем создание формы, но т.к.
		// передать значения из модуля объекта в форму через переменные модуля и доп.
		// свойства объекта нельзя, придется воспользоваться косвенными признаками
		//
		// раньше в этом месте мы генерировали исключение, но оно попадает в журнал
		// ошибок, который мы анализируем, а ошибкой не является
		
		ЭтотОбъект.ПометкаУдаления = Истина;
		ЭтотОбъект.Комментарий     = "Отсутствует задолженность по денежным средствам по документу " + ДокументОснование;
		
		Возврат;
		
	Иначе
		// будет интерактивный выбор при открытии
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура УстановитьБлокировки(ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям)

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	// задолженность по д/с
	БлокировкаЗадолженностиПоДенежнымСредствам = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
	БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("ТипЗадолженности",             РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(ЭтотОбъект.ВидДвижения));
	БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("ВидЗадолженности",             ЭтотОбъект.ВидЗадолженности);
	
	БлокировкаЗадолженностиПоДенежнымСредствам.ИсточникДанных = ЭтотОбъект.Основания;
	БлокировкаЗадолженностиПоДенежнымСредствам.ИспользоватьИзИсточникаДанных("Основание", "Основание");
	БлокировкаЗадолженностиПоДенежнымСредствам.ИспользоватьИзИсточникаДанных("Валюта",    "Валюта");
	
	Если РаботаСНДС.ВестиУчетНДС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
		
		БлокировкаЗадолженностиПоДенежнымСредствам = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
		БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("ВидЗадолженности",             Справочники.ВидыЗадолженности.НДСПоАвансам);
		БлокировкаЗадолженностиПоДенежнымСредствам.УстановитьЗначение("Валюта",    ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
		
	КонецЕсли;
	
	// остатки д/с
	БлокировкаОстаткиДенежныхСредств = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("Брокер",                       ЭтотОбъект.Брокер);
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("МестоХранения",                ЭтотОбъект.МестоХранения);
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
	БлокировкаОстаткиДенежныхСредств.УстановитьЗначение("Валюта",                       ЭтотОбъект.ВалютаОплаты);
	
	БлокировкаОстаткиДенежныхСредств.ИсточникДанных = ЭтотОбъект.Основания;
	
	Если ФормироватьДвиженияПоЗадолженностиПоДенежнымСредствамПоПоручениям Тогда
		
		БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям");
		БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.УстановитьЗначение("ТипЗадолженности",             РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(ЭтотОбъект.ВидДвижения));
		БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.УстановитьЗначение("Валюта",                       ЭтотОбъект.ВалютаОплаты);
		
		Если ЭтотОбъект.Аванс Тогда
			БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.УстановитьЗначение("Основание", ЭтотОбъект.Поручение);
		Иначе
			БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.ИсточникДанных = ЭтотОбъект.Основания;
			БлокировкаЗадолженностиПоДенежнымСредствамПоПоручениям.ИспользоватьИзИсточникаДанных("Основание", "Основание");	
		КонецЕсли;
		
	КонецЕсли;
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

Процедура СформироватьДвиженияДенежныхСредств()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		КОГДА Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	Оплата.Дата КАК Период,
		|	Оплата.Организация КАК Организация,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Оплата.Брокер КАК Брокер,
		|	Оплата.МестоХранения КАК МестоХранения,
		|	Оплата.РасчетныйСчет КАК РасчетныйСчет,
		|	Оплата.ВалютаОплаты КАК Валюта,
		|	СводныеОснования.Сумма КАК Сумма,
		|	СводныеОснования.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
		|	Оплата.ВидЗадолженности КАК ВариантДвиженияДенежныхСредств
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(ОплатаОснования.СуммаОплаты) КАК Сумма,
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата) КАК ВидДвиженияДенежныхСредств
		|	ИЗ
		|		Документ.Оплата.Основания КАК ОплатаОснования
		|	ГДЕ
		|		ОплатаОснования.Ссылка = &Ссылка
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ОплатаОснования.СуммаОплаты) > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		СУММА(ОплатаОснования.СуммаОплатыКупона),
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
		|	ИЗ
		|		Документ.Оплата.Основания КАК ОплатаОснования
		|	ГДЕ
		|		ОплатаОснования.Ссылка = &Ссылка
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ОплатаОснования.СуммаОплатыКупона) > 0) КАК СводныеОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО (Оплата.Ссылка = &Ссылка)";		
		
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ОстаткиДенежныхСредств.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДвиженияПоЗадолженности()
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходамИРасходам)
		|				И ОплатаОснования.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		КОГДА &БазовыйТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И Оплата.Аванс
		|				И Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		КОГДА &БазовыйТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И Оплата.Аванс
		|				И Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК НаправлениеДвиженияЗадолженности,
		|	Оплата.Организация КАК Организация,
		|	Оплата.ВидЗадолженности КАК ВидЗадолженности,
		|	Оплата.Дата КАК Период,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.Оплата)
		|			ТОГДА ИСТИНА
		|		КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.КорректировкаЗадолженности)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ Оплата.Аванс
		|	КОНЕЦ КАК Аванс,
		|	Оплата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА &БазовыйТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ВЫБОР
		|					КОГДА Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|						ТОГДА ВЫБОР
		|								КОГДА Оплата.Аванс
		|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|								ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|							КОНЕЦ
		|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				КОНЕЦ
		|		КОГДА &БазовыйТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ВЫБОР
		|					КОГДА Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|						ТОГДА ВЫБОР
		|								КОГДА Оплата.Аванс
		|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|								ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|							КОНЕЦ
		|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				КОНЕЦ
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходамИРасходам)
		|			ТОГДА ВЫБОР
		|					КОГДА Оплата.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				КОНЕЦ
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимДоходамИРасходам)
		|				И ОплатаОснования.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА Оплата.Ссылка
		|		КОГДА Оплата.Аванс
