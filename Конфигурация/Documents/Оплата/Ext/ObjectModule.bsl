						Проводка.СубконтоДт.Договоры 			= СчетДоверительногоУправления;
						
						Если ЭтотОбъект.Дата > Дата(2020,5,1) Тогда
							Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда 
								Проводка.ДополнительнаяАналитикаДт 		= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
							ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
								Проводка.ДополнительнаяАналитикаДт 		= Справочники.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего;
							КонецЕсли;	
						Иначе
							Проводка.ДополнительнаяАналитикаДт 		= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
						КонецЕсли; 	
					Иначе	
						Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
						Проводка.СчетДт 				= ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами12;	
						Проводка.СубконтоДт.Договоры 	= ЭтотОбъект.Договор;
					КонецЕсли; 
				
					Если Проводка.СчетДт.Валютный Тогда
						Проводка.ВалютаДт  			= ВалютаОплаты;
						Проводка.ВалютнаяСуммаДт 	= СтрокаОснование.СуммаОплаты;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт 					= СчетДС;
					Проводка.СубконтоКт[ВидСубконтоДС] 	= СубконтоДС;
					Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ОплатаВознагражденияУК;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ОплатаВозмещенияРасходовУК;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.БанковскаяКомиссия Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.БанковскаяКомиссия;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ДепозитарнаяКомиссия;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.НеобходимыеРасходыСпецдепозитария;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоВознаграждениюСпецдепозитария;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамДепозитария;
					ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария Тогда
						Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамСпецДепозитария;
					КонецЕсли;
					
					Проводка.ВалютаКт  			= ВалютаОплаты;
					Проводка.ВалютнаяСуммаКт 	= СтрокаОснование.СуммаОплаты;
				Иначе	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для документа " + ЭтотОбъект + " не определены параметры комиссии для ЕПС!", ЭтотОбъект);	
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьРЕПО Тогда
			//найдем закрытия, которые по времени раньше оплаты комиссии
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ОплатаОснования.Основание КАК ПерваяЧастьРЕПО
				|ИЗ
				|	Документ.Оплата.Основания КАК ОплатаОснования
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
				|		ПО ОплатаОснования.Основание = СделкаРЕПО.ПерваяЧастьРЕПО
				|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 2)
				|ГДЕ
				|	ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.СделкаРЕПО)
				|	И ОплатаОснования.Ссылка.МоментВремени > СделкаРЕПО.МоментВремени
				|	И ОплатаОснования.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				//запишем проводки, т.к.процедура получает остатки включая границы
				ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записать();
				ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Прочитать();
				ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
			КонецЕсли;
			
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				КонтрагентПоСделке = ВыборкаДетальныеЗаписи.ПерваяЧастьРЕПО.Контрагент;
				// некоторые клиенты не хотят раскрывать реального контрагента по репо и требуют отображать брокера
				Если НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО Тогда
					Если ВыборкаДетальныеЗаписи.ПерваяЧастьРЕПО.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
						КонтрагентПоСделке = ВыборкаДетальныеЗаписи.ПерваяЧастьРЕПО.Брокер.ЮрФизЛицо;
					КонецЕсли;
				КонецЕсли;
				
				БухгалтерскийУчетЕПС.ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект,
					ВыборкаДетальныеЗаписи.ПерваяЧастьРЕПО,
					КонтрагентПоСделке,
					ЭтотОбъект.Контрагент,
					Закрывать7ойРазделПриПоступленииДенежныхСредств);
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
	Тогда
		
		//читаем движения погашений
		ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
		
		АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
		
		АналитикиДебиторкиПоКупону = Новый Массив();
		АналитикиДебиторкиПоКупону.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона);
		Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
		    АналитикиДебиторкиПоКупону.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок);
		КонецЕсли;
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
		
			ОплатаПоПогашениюКупонаЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, СчетДС, ВидСубконтоДС, СубконтоДС, НастройкиУчета, Закрывать7ойРазделПриПоступленииДенежныхСредств, Отказ);
			Возврат;
		
		КонецЕсли;
		
		
		//предполагаем, что в случае смены настройки "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов" остатки задолженности будут перенесены на соответсвующий счет.
		//валюта получения дохода фиксируется в погашении купона. Как быть со вводами - вопрос. Пока считаем, что валюта задолженности = валюте номинала.

		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОплатаОснования.Основание КАК Основание,
			|	ОплатаОснования.СуммаОплатыКупона КАК СуммаОплатыКупона,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ПогашениеКупона.СуммаКупонаВВалютеОплаты, 0) > 0
			|			ТОГДА ПогашениеКупона.СуммаКупонаВВалютеОплаты
			|		ИНАЧЕ ПогашениеЦеннойБумаги.СуммаКупона
			|	КОНЕЦ КАК СуммаКупона,
			|	ЕСТЬNULL(ПогашениеКупона.Количество, ПогашениеЦеннойБумаги.Количество) КАК Количество,
			|	ЕСТЬNULL(ПогашениеКупона.Облигация, ПогашениеЦеннойБумаги.ЦеннаяБумага) КАК Облигация,
			|	ОплатаОснования.Ссылка.Контрагент КАК Контрагент
			|ПОМЕСТИТЬ _ОснованияПоКупону
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеКупона КАК ПогашениеКупона
			|		ПО ОплатаОснования.Основание = ПогашениеКупона.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
			|		ПО ОплатаОснования.Основание = ПогашениеЦеннойБумаги.Ссылка
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка
			|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) <> ТИП(Документ.ВводЦенныхБумаг)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОплатаОснования.Основание,
			|	ОплатаОснования.СуммаОплатыКупона,
			|	ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон,
			|	ВводЦенныхБумагЦенныеБумаги.Количество,
			|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
			|	ОплатаОснования.Ссылка.Контрагент
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
			|		ПО ОплатаОснования.Основание = ВводЦенныхБумагЦенныеБумаги.Ссылка
			|			И (ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон > 0)
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка
			|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ВводЦенныхБумаг)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Облигация,
			|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
			|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК СуммаЗадолженностиВал,
			|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК АналитикаДебиторкиПоКупону,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаЗадолженности
			|ПОМЕСТИТЬ _ОстаткиБУ
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&ДоДокумента,
			|			Счет В
			|				(ВЫБРАТЬ
			|					УчетныеАктивыЕПС.СчетУчета КАК СчетУчета
			|				ИЗ
			|					Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|				ГДЕ
			|					ЕСТЬNULL(УчетныеАктивыЕПС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)) <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)),
			|			,
			|			Субконто1 В
			|					(ВЫБРАТЬ
			|						ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Облигация
			|					ИЗ
			|						_ОснованияПоКупону КАК _ОснованияПоКупону
			|							ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
			|							ПО
			|								_ОснованияПоКупону.Основание = ВводЦенныхБумагЦенныеБумаги.Ссылка
			|									И ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон <> 0
			|					ГДЕ
			|						ТИПЗНАЧЕНИЯ(_ОснованияПоКупону.Основание) = ТИП(Документ.ВводЦенныхБумаг)
			|					СГРУППИРОВАТЬ ПО
			|						ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
			|			
			|					ОБЪЕДИНИТЬ
			|			
			|					ВЫБРАТЬ
			|						_ОснованияПоКупону.Облигация
			|					ИЗ
			|						_ОснованияПоКупону КАК _ОснованияПоКупону
			|					ГДЕ
			|						ТИПЗНАЧЕНИЯ(_ОснованияПоКупону.Основание) <> ТИП(Документ.ВводЦенныхБумаг))
			|				И ЛицевойСчет.ДополнительнаяАналитика В (&АналитикиДебиторкиПоКупону)
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК ЕдиныйБухгалтерскийУчетОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОснованияПоКупону.Основание КАК Основание,
			|	ОснованияПоКупону.СуммаОплатыКупона КАК СуммаОплатыКупона,
			|	ОснованияПоКупону.СуммаКупона КАК СуммаКупона,
			|	ОснованияПоКупону.Количество КАК Количество,
			|	ОснованияПоКупону.Облигация КАК Облигация,
			|	ОснованияПоКупону.Контрагент КАК Контрагент
			|ИЗ
			|	_ОснованияПоКупону КАК ОснованияПоКупону";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("АналитикиДебиторкиПоКупону", АналитикиДебиторкиПоКупону);
		
		ДоДокумента = ЭтотОбъект;
		БратьГраницу = ВидГраницы.Исключая;
		
		Если НЕ НастройкиУчета.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации
			И ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
			
			ОплатаПоТелу = ПолучитьДокументОплатыПоТелу(КонецДня(ЭтотОбъект.Дата));
			Если ОплатаПоТелу <> Неопределено Тогда
			
				ДоДокумента = ОплатаПоТелу;
				БратьГраницу = ВидГраницы.Включая;
			
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ДоДокумента.МоментВремени(), БратьГраницу));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ОстаткиБУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОстаткиБУ"].ПолучитьДанные().Выгрузить();
		
		СтрокиДокумента = РезультатЗапроса.Выбрать();
		Пока СтрокиДокумента.Следующий() Цикл
			
			// проводки по РЕПОшным бумагам
