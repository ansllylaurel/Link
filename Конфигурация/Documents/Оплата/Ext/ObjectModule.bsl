					// кредит
					Проводка.СчетКт = СчетЗадолженности.Счет;
				
					Проводка.СубконтоКт.ЦенныеБумаги = СчетЗадолженности.Облигация;
					
					Проводка.ВалютаКт = ВалютаЗадолженности;
					Проводка.ВалютнаяСуммаКт = СуммаКПогашению;
					
					Проводка.ДополнительнаяАналитикаКт = СчетЗадолженности.АналитикаДебиторкиПоКупону;
					
				КонецЦикла;
				
			ИначеЕсли ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				СчетаЗадолженностей = ОстаткиБУ.НайтиСтроки(Новый Структура("Облигация", СтрокиДокумента.Облигация));
				
				Для Каждого СчетЗадолженности из СчетаЗадолженностей Цикл
					
					СуммаКПогашению = Мин(СчетЗадолженности.СуммаЗадолженностиВал, СуммаСтроки);
					СуммаКПогашениюВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКПогашению, ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), 2);
					
					СуммаСтроки = СуммаСтроки - СуммаКПогашению;
					СуммаСтрокиВВалютеУчета = СуммаСтрокиВВалютеУчета - СуммаКПогашениюВВалютеУчета;
					
					СчетЗадолженности.СуммаЗадолженностиВал = СчетЗадолженности.СуммаЗадолженностиВал - СуммаКПогашению;
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаКПогашениюВВалютеУчета, "Погашение купона");
					
					// дебет
					Проводка.СчетДт = СчетДС;
					
					Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.КупонныйДоход;
					
					Проводка.ВалютаДт  = ВалютаОплаты;
					Проводка.ВалютнаяСуммаДт = СуммаКПогашению;
					
					// кредит
					Проводка.СчетКт = СчетЗадолженности.Счет;
				
					Проводка.СубконтоКт.ЦенныеБумаги = СчетЗадолженности.Облигация;
					
					Проводка.ВалютаКт = ВалютаОплаты;
					Проводка.ВалютнаяСуммаКт = СуммаКПогашению;
					
					Проводка.ДополнительнаяАналитикаКт = СчетЗадолженности.АналитикаДебиторкиПоКупону;
					
				КонецЦикла;
				
				
				Если СуммаСтроки <> 0 Тогда
					//РЕПОшные
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСтрокиВВалютеУчета, "Погашение купона");
					
					// дебет
					Проводка.СчетДт = СчетДС;
					
					Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.КупонныйДоход;
					
					Проводка.ВалютаДт  = ЭтотОбъект.ВалютаОплаты;
					Проводка.ВалютнаяСуммаДт = СуммаСтроки;
					
						
					Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
				
					Проводка.СубконтоКт.Контрагенты = СтрокиДокумента.Контрагент;
					Проводка.СубконтоКт.ОснованиеРасчетов = СтрокиДокумента.Основание;				
					
					Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
					Проводка.ВалютнаяСуммаКт = СуммаСтроки;
					
					// для бумаг по РЕПО используем аналитику задолженности по НКД, т.к. просрочки тут не бывает (РЕПО это высоколиквидные бумаги)
					Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоКупону; 
					
				КонецЕсли;
				
			Иначе
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаСтрокиВВалютеУчета, "Погашение купона");
				
				// дебет
				Проводка.СчетДт = СчетДС;
				
				Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.КупонныйДоход;
				
				Проводка.ВалютаДт  = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаДт = СуммаСтроки;
				
					
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
			
				Проводка.СубконтоКт.Контрагенты = СтрокиДокумента.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов = СтрокиДокумента.Основание;				
				
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаКт = СуммаСтроки;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоКупону;
				
			КонецЕсли;
			
			// закроем начисленные резервы
			Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда

				УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
				НастройкиУчетаПогашениеКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйАктив, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
				Если НастройкиУчетаПогашениеКупона.СписыватьРезервОКУНаДатуПрекращенияПризнания Тогда

					СчетУчетаРезервов = ПланыСчетов.Единый.Расчеты25;
					ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов;
					СчетУчетаДоходов = ПланыСчетов.Единый.ПрочиеДоходыРасходы01;
					СчетУчетаРасходов = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
					
					Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
						И НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
					
						УчетныйАктивЦБРФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокиДокумента.Облигация, "УчетныйАктивЦБРФ");
						
						Если УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияРФ;
						ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияСубьектовРФ;
						ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияКредитныхОрганизаций;
						ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов;
						ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияБанковНерезидентов;
						ИначеЕсли УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
							УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихНерезидентов;
						КонецЕсли;

						СчетУчетаРезервов = УчетныйАктив.СчетУчетаРезервов;
						ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;

						СчетУчетаДоходов = ПланыСчетов.Единый.ДоходыРасходыПоРезервам01;
						СчетУчетаРасходов = ПланыСчетов.Единый.ДоходыРасходыПоРезервам02;

					КонецЕсли;
					
					АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив);
					
					СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
					
					БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетУчетаРезервов, ВидСубконто, СчетДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет, СтрокиДокумента.Облигация);
					
					Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
						
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, СчетУчетаДоходов, СтрокиДокумента.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, СчетУчетаРасходов, СтрокиДокумента.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
					
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств И СтрокиДокумента.Основание.Дата >= БухгалтерскийУчетЕПС.ОпределитьДатуНачалаБухгалтерскогоПериода(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
				
				// закрываем 7ой раздел только в оплаченой части
				КоэффициентЗакрытия = СтрокиДокумента.СуммаОплатыКупона / СтрокиДокумента.СуммаКупона;
				// вообще тут не совсем хорошо, мы можем попасть на копейку из-за округлений
				// но! это редкий случай, когда больше одной оплаты приходит
				// и максимум, что было, это 2 оплаты - они обычно без копеек делятся, но потом подумать надо
				// самя бяка, что остаток берется на дату погашения купона и фиг поймешь сколько там осталось...
			
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПроцентныеДоходы01, СтрокиДокумента.Облигация, ЭтотОбъект.ВалютаОплаты, "Закрытие доначисления по погашению купона", СтрокиДокумента.Основание.Дата, Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный,,, КоэффициентЗакрытия);
			
			КонецЕсли;
		
		КонецЦикла;
		
		Если НастройкиУчета.ДействияПриПогашенииКупонаНаСчетахГлавыГ = "Начислять_И_СписыватьПриОплатеПоПогашениюКупона" Тогда
			
			АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
			АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия КАК Партия,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаПартии КАК СтрокаПартии,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона КАК СтоимостьКупона,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона КАК ПереоценкаКупона,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
				|ГДЕ
				|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор В(&Основания)
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Активность";
			
			Запрос.УстановитьПараметр("Основания", ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				// списываем УНКД
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета, "Погашение купона по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Партия;
				
				Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.СтоимостьКупона;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаКупонПриобретенный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
				
				// списываем ННКД
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета, "Погашение купона по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Партия;
				
				Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ПереоценкаКупона;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
				
			КонецЦикла;
		
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода Тогда
		
		АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
		
		Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СтрокаОснования.СуммаКупона, "Возврат купона по ЦБ, купленым по РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты22;
		
