				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.КупонныйДоход;
				КонецЕсли;				
				
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.СуммаОплатыКупона;
					ПРоводка.ВалютаКт = ВалютаОплаты;
				КонецЕсли;
				
			ИначеЕсли ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход И ТипЗнч(СделкаРЕПО) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплатыКупона, ВалютаОплаты, Организация, Дата, Отказ), "Возврат купонного дохода");
				
				//дебет
				Проводка.СчетДт = СчетУчетаДС;
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.КупонныйДоход;
				КонецЕсли;
				
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = СтрокаОснование.СуммаОплатыКупона;
					ПРоводка.ВалютаДт = ВалютаОплаты;
				КонецЕсли;
				
				//кредит
				Если ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона Тогда
					Если СтрокаОснование.Валюта <> ВалютаУчета Тогда
						Проводка.СчетКт = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации;
						Проводка.СубконтоКт.ОснованиеРасчетов = СделкаРЕПО; 
					Иначе
						Проводка.СчетКт = ПланыСчетов.Основной.ПогашениеКупона;
					КонецЕсли;
					Проводка.СубконтоКт.Облигации 		= СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				Иначе
					Если СтрокаОснование.Валюта <> ВалютаУчета Тогда
						Проводка.СчетКт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
					Иначе
						Проводка.СчетКт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
					КонецЕсли;

					Если СделкаРЕПО.СделкаСЦентральнымКонтрагентом И Документы.ПогашениеКупона.НКЦпоРЕПОсЦК(СделкаРЕПО.Дата) Тогда
						Проводка.СубконтоКт.Контрагенты 		= СделкаРЕПО.Контрагент;
					ИначеЕсли ЗначениеЗаполнено(СделкаРЕПО.Брокер) Тогда 
						Проводка.СубконтоКт.Контрагенты 		= СделкаРЕПО.Брокер.ЮрФизЛицо;
					Иначе
						Проводка.СубконтоКт.Контрагенты 		= СделкаРЕПО.Контрагент;
					КонецЕсли;
				КонецЕсли;
				Если СтрокаОснование.Валюта <> ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.СуммаКупона;
					Проводка.ВалютаКт = СтрокаОснование.Валюта;
				КонецЕсли;
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Возврат купонного дохода не сформировал проводки. ", ЭтотОбъект.Ссылка,,, Отказ);
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
		
	#КонецОбласти	
	
	ИначеЕсли (ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ))
		ИЛИ (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль)  
		ИЛИ (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость)  
		ИЛИ (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗемельномуНалогу)  
		ИЛИ (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество) Тогда 
		
	#Область Налоги
		Если ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) Тогда 
			СчетУчетаУслуг = ПланыСчетов.Основной.НДФЛ;
			Содержание = "НДФЛ";
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество Тогда 
			СчетУчетаУслуг = ПланыСчетов.Основной.НалогНаИмущество;
			Содержание = "Налог на имущество";
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗемельномуНалогу Тогда 
			СчетУчетаУслуг = ПланыСчетов.Основной.ЗемельныйНалог;
			Содержание = "Земельный налог";
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость Тогда 
			СчетУчетаУслуг = ПланыСчетов.Основной.НДС;
			Содержание = "НДС";
		Иначе
			СчетУчетаУслуг = ПланыСчетов.Основной.НалогНаПрибыль;
			Содержание = "Налог на прибыль";
		КонецЕсли;		
							
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплаты, ВалютаОплаты, Организация, Дата, Отказ), Содержание);
			
			Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
				// Дебет
				Проводка.СчетДт = СчетУчетаУслуг;
				Проводка.СубконтоДт.ВидыПлатежейВБюджет	= Перечисления.ВидыПлатежейВБюджет.НалогВзносыНачисленоУплачено;
				
				// Кредит
				Проводка.СчетКт = СчетУчетаДС;
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;
				КонецЕсли;
				
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.СуммаОплаты;
					ПРоводка.ВалютаКт = ВалютаОплаты;
				КонецЕсли;
				
			Иначе //возврат излишне уплаченного налога или возмещение по НДС
				
				Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Оплата") Тогда
					Проводка.Содержание = "Возврат: " + Проводка.Содержание;
				ИначеЕсли ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида задолженности " + ЭтотОбъект.ВидЗадолженности 
						+ "по основанию " + СтрокаОснование.Основание + " не определены проводки возврата. Обратитесь к разработчикам. Документ " 
						+ ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект.Ссылка,,, Отказ);	
					Возврат;
				КонецЕсли;
							
				// Дебет
				Проводка.СчетДт = СчетУчетаДС;
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления;
				КонецЕсли;
				
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = СтрокаОснование.СуммаОплаты;
					ПРоводка.ВалютаДт = ВалютаОплаты;
				КонецЕсли;						
				
				//кредит
				Проводка.СчетКт = СчетУчетаУслуг;
				Проводка.СубконтоКт.ВидыПлатежейВБюджет	= Перечисления.ВидыПлатежейВБюджет.НалогВзносыНачисленоУплачено;      
				
			КонецЕсли;
		КонецЦикла;
	#КонецОбласти	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда 
		
	#Область РЕПО	
		НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйРегистр,
			Отказ); 
			
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата), ЭтотОбъект);
			Возврат;
		КонецЕсли;
			
		ЕстьОбратноеРЕПО = Ложь;
		
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			Если НастройкиПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда // учитываем как репо
			
				
				Если	СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
					И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход 
					И СтрокаОснование.Основание.ЧастьСделкиРЕПО = 1
						ИЛИ
					СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Продажа 
					И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход 
					И СтрокаОснование.Основание.ЧастьСделкиРЕПО = 2 
						ИЛИ
					СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
					И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход 
					И СтрокаОснование.Основание.ЧастьСделкиРЕПО = 0
						ИЛИ
					СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка 
					И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход 
					И СтрокаОснование.Основание.ЧастьСделкиРЕПО = 0 
				Тогда
						
					ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, СтрокаОснование.Основание, СтрокаОснование.СуммаОплаты + СтрокаОснование.СуммаОплатыКупона, СтрокаОснование.Сумма + СтрокаОснование.СуммаКупона, Отказ);
					ЕстьОбратноеРЕПО = Истина;
					
				Иначе
					
					ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, СтрокаОснование.Основание, СтрокаОснование.СуммаОплаты + СтрокаОснование.СуммаОплатыКупона, СтрокаОснование.Сумма + СтрокаОснование.СуммаКупона, Отказ);
					
				КонецЕсли;
				
			Иначе
				
				ПроведениеПоРегиструБухгалтерииОбычнаяСделка_РЕПО(УчетныйРегистр, СтрокаОснование, Отказ);
			
			КонецЕсли;
		КонецЦикла;	
		
		Если ЕстьОбратноеРЕПО Тогда
			ПерекурсоватьБумагиОбратногоРЕПО(УчетныйРегистр, Отказ);
		КонецЕсли;
	#КонецОбласти	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям Тогда
		
	#Область ДозодПоИнвПаям	
		Если СчетУчетаДС <> Неопределено Тогда	
			ЕстьСубконтоБрокерскиеДоговорыДС = (СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках учета не определен счет учета д/с. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,, Отказ);	
			Возврат;
		КонецЕсли;
		
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплаты, ВалютаОплаты, Организация, Дата, Отказ), "Выплата инвестиционного дохода");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
			Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
			
			Проводка.СчетКт = СчетУчетаДС;
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если ЕстьСубконтоБрокерскиеДоговорыДС Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты; //не было такого
			КонецЕсли;
			
			Если ЕстьСубконтоБрокерскиеДоговорыДС Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = СтрокаОснование.СуммаОплаты;
				Проводка.ВалютаКт = ВалютаОплаты;
			КонецЕсли;
			
		КонецЦикла;
		
	#КонецОбласти	
	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗаймуПроценты 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗайму Тогда
		
	#Область ПоЗайму	
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			СчетРасчетовПоЗайму = ПланыСчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
			
			СторонаДС = ?(ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход, "Кт", "Дт");
			СторонаКредитногоИнструмента = ?(СторонаДС = "Дт", "Кт", "Дт");
			
			// оплата полной суммы займа
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаОснование.Сумма, ?(ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоЗайму, "Оплата по займу", "Оплата процентов"));
			
			// дебет
			Проводка["Счет"+СторонаДС] = СчетУчетаДС;
			
			Проводка["Субконто"+СторонаДС].БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
				Проводка["Субконто"+СторонаДС].ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПогашениеЗайма;  
			КонецЕсли;
			
			// кредит
			Проводка["Счет"+СторонаКредитногоИнструмента] = СчетРасчетовПоЗайму;
			Проводка["Субконто"+СторонаКредитногоИнструмента].Контрагенты = ЭтотОбъект.Контрагент;
			
		КонецЦикла;
		
	#КонецОбласти	
	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАренде
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть Тогда
		
	#Область	Аренда	
		ВидДоговораАренды = РегистрыСведений.УсловияДоговоровАренды.ПолучитьПоследнее(ЭтотОбъект.Дата, Новый Структура("Организация, Договор", ЭтотОбъект.Организация, ЭтотОбъект.Договор)).ВидДоговораАренды;
		Если ВидДоговораАренды = Перечисления.ВидыДоговоровАренды.Получения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование проводок по получению в аренду должно использовать вид задолженности ""По получению в аренду"". Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,, Отказ);	
			Возврат;
		КонецЕсли;
			
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
		
			СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчиками;
			Если ЭтотОбъект.ОбеспечительныйПлатеж Тогда
				СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиОбеспечительныйПлатеж;
			ИначеЕсли ЭтотОбъект.Аванс Тогда
				СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные;
			ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Оплата") 
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснование.Основание, "Аванс") Тогда
				СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные;
			ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть Тогда
				СчетУчетаРасчетов = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиПеременнаяЧасть;
			КонецЕсли;
			
			Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаОснование.Сумма, "Оплата по передаче имущества в аренду");
				
				// дебет
				Проводка.СчетДт = СчетУчетаДС;
				
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				
				Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПоДоговоруПередачиВАренду;  
				КонецЕсли;
				
				Проводка.СчетКт = СчетУчетаРасчетов;
				
				Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
				Проводка.СубконтоКт.Договоры = ЭтотОбъект.Договор;
				
			Иначе
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаОснование.Сумма, "Возврат аванса по аренде");
				
				Проводка.СчетДт = СчетУчетаРасчетов;
				
				Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
				Проводка.СубконтоДт.Договоры = ЭтотОбъект.Договор;
				
				// дебет
				Проводка.СчетКт = СчетУчетаДС;
				
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				
				Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;  
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла;
		
	#КонецОбласти
	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ОшибочноеСписание Тогда
		
	#Область ОшибочноеСписание	
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаОснование.Сумма, "Возврат ошибочно списанных средств");
				
				Проводка.СчетДт = СчетУчетаДС;
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ОшибочноЗачисленныеСписанныеДенежныеСредства;  
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЭтотОбъект.КоррСчет) Тогда
					
					Проводка.СчетКт = ЭтотОбъект.КоррСчет;
					
					Для НомСубк = 1 По Проводка.СчетКт.ВидыСубконто.Количество() Цикл
						Проводка.СубконтоКт[ЭтотОбъект.КоррСчет.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
					КонецЦикла;
					
				Иначе
					
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоПретензиям;
					Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
					
				КонецЕсли;
				
			ИначеЕсли ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаОснование.Сумма, "Ошибочное списание");
				
				Если ЗначениеЗаполнено(ЭтотОбъект.КоррСчет) Тогда
					
					Проводка.СчетДт = ЭтотОбъект.КоррСчет;
					
					Для НомСубк = 1 По Проводка.СчетДт.ВидыСубконто.Количество() Цикл
						Проводка.СубконтоДт[ЭтотОбъект.КоррСчет.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
					КонецЦикла;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоПретензиям;
					Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Контрагент;
					
				КонецЕсли;
				
				Проводка.СчетКт = СчетУчетаДС;
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ОшибочноЗачисленныеСписанныеДенежныеСредства;  
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	#КонецОбласти	
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделкеСНедвижимостью 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоИнвестконтракту
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДДУ 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПолучениюВАренду Тогда
		
	#Область Недвижимость
	
		Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделкеСНедвижимостью Тогда
		
			СчетРасчетовПоСделке = ПланыСчетов.Основной.РасчетыПоСделкамСНедвижимостью;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоИнвестконтракту
			ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПолучениюВАренду Тогда
			
			СчетРасчетовПоСделке = ПланыСчетов.Основной.РасчетыСЗастройщикамиИАрендодателями;
			
		ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДДУ Тогда
			
			СчетРасчетовПоСделке = ПланыСчетов.Основной.РасчетыСКонтрагентами;
			
		КонецЕсли;
		

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОплатаОснования.Сумма КАК Сумма,
			|	ОплатаОснования.СтавкаНДС КАК СтавкаНДС,
			|	ОплатаОснования.СуммаНДС КАК СуммаНДС,
			|	ОплатаОснования.Основание КАК Основание
			|ИЗ
			|	Документ.Оплата.Основания КАК ОплатаОснования
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
				СторонаДС = "Кт";
				СторонаРасчетов = "Дт";
			Иначе
				СторонаДС = "Дт";
				СторонаРасчетов = "Кт";
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ВыборкаДетальныеЗаписи.Сумма, "Оплата по сделке с недвижимостью");
			
			// расчеты
			Проводка["Счет"+СторонаРасчетов] = ?(ТипЗнч(ВыборкаДетальныеЗаписи.Основание) = Тип("ДокументСсылка.Оплата") Или Аванс,
				?(ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход, ПланыСчетов.Основной.РасчетыПоАвансамВыданным,  ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные), 
				СчетРасчетовПоСделке);
			
			ЕстьСубконтоКонтрагенты = (Проводка["Счет"+СторонаРасчетов].ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
			ЕстьСубконтоДоговоры = (Проводка["Счет"+СторонаРасчетов].ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка["Субконто"+СторонаРасчетов].Контрагенты = ЭтотОбъект.Контрагент;
			КонецЕсли;	
			Если ЕстьСубконтоДоговоры Тогда
				Проводка["Субконто"+СторонаРасчетов].Договоры = ЭтотОбъект.Договор;
			КонецЕсли;	
			
			// деньги
			Проводка["Счет"+СторонаДС] = СчетУчетаДС;
			
			Проводка["Субконто"+СторонаДС].БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда 
				Проводка["Субконто"+СторонаДС].ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.Покупка;  
			КонецЕсли;
				
		КонецЦикла;
		
	#КонецОбласти	
	КонецЕсли;
	
	Если РаботаСНДС.ВестиУчетНДС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
		//НДС по авансам
		РаботаСНДС.СформироватьПроводкиЗачетаНДСПоАвансам(ЭтотОбъект.Ссылка, Движения[УчетныйРегистр], ЭтотОбъект.Контрагент);
	КонецЕсли;

	Для Каждого ТекСтрока Из ЭтотОбъект.Основания Цикл
		
		Если ТипЗнч(ТекСтрока.Основание) = Тип("ДокументСсылка.Сделка")
			И ТекСтрока.Основание.ОтложенноеИсполнение
			И НЕ БухгалтерскийУчет.ПроверитьНаличиеОстатковЗадолженностейПоСделке(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ТекСтрока.Основание, Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая)) Тогда
			
			ЦенныеБумагиОснования = ТекСтрока.Основание.ЦенныеБумаги.Выгрузить(,"ЦеннаяБумага");
			ЦенныеБумагиОснования.Свернуть("ЦеннаяБумага");
			СписокЦБ = ЦенныеБумагиОснования.ВыгрузитьКолонку("ЦеннаяБумага");
			
			ПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс = БухгалтерскийУчет.ПолучитьПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс(
																					ЭтотОбъект.Организация,
																					ЭтотОбъект.СчетДоверительногоУправления,
																					ТекСтрока.Основание,
																					СписокЦБ,
																					УчетныйРегистр,
																					ЭтотОбъект.Дата,
																					ЭтотОбъект.МоментВремени());
			
			Для Каждого ДанныеПроводки Из ПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс Цикл
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.БухгалтерскийУчет, ДанныеПроводки.Сумма, "Сторно переоценки сделки Т+");
				
				Проводка.СчетДт = ДанныеПроводки.СчетДт;
				Проводка.СчетКт = ДанныеПроводки.СчетКт;
				
				ИндексСубконто = 1;
				
				Для Каждого ТекСубконто Из Проводка.СчетДт.ВидыСубконто Цикл
					Проводка.СубконтоДт[ТекСубконто.ВидСубконто] = ДанныеПроводки["СубконтоДт" + ИндексСубконто];
					ИндексСубконто = ИндексСубконто + 1;
				КонецЦикла;
				
				ИндексСубконто = 1;
				
				Для Каждого ТекСубконто Из Проводка.СчетКт.ВидыСубконто Цикл
					Проводка.СубконтоКт[ТекСубконто.ВидСубконто] = ДанныеПроводки["СубконтоКт" + ИндексСубконто];
					ИндексСубконто = ИндексСубконто + 1;
				КонецЦикла;
				
			КонецЦикла;
																															
		КонецЕсли;
		
	КонецЦикла;
	
	БухгалтерскийУчет.ПереоценитьВалютныеАктивы(ЭтотОбъект,УчетныйРегистр, Перечисления.ВидыУчета[УчетныйРегистр], НастройкиУчетаОбщие, Отказ);
	
	БухгалтерскийУчет.ВосстановитьПереоценкуЗадолженности(ЭтотОбъект, УчетныйРегистр, ЭтотОбъект.ВидЗадолженности, Отказ);
	
КонецПроцедуры

// #ТехническийДолг - проверить, может стрельнуть при 3х и более оплатах
Функция ПолучитьПогрешностьПрошедшихОплат(ВидДвижения, Основание, КоэффициентПересчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Ссылка КАК Ссылка,
		|	ОплатаОснования.СуммаОплаты КАК СуммаОплаты
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка.Дата < &Дата
		|	И ОплатаОснования.Ссылка.Организация = &Организация
		|	И ОплатаОснования.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОплатаОснования.Ссылка.ВидДвижения = &ВидДвижения
		|	И ОплатаОснования.Основание = &Основание
		|	И ОплатаОснования.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Погрешность = 0;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СуммаПриведенная = ВыборкаДетальныеЗаписи.СуммаОплаты * КоэффициентПересчета;
		
		Погрешность = Погрешность + (СуммаПриведенная - Окр(СуммаПриведенная, 2));
		
	КонецЦикла;
	
	Возврат Погрешность;

КонецФункции 

Процедура ПроведениеПоРегиструБухгалтерииОбратноеРЕПО(УчетныйРегистр, Основание, СуммаОплаты,  СуммаЗадолженности, Отказ)

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
	
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ЧастьСделкиРЕПО = Основание.ЧастьСделкиРЕПО;
	Если Основание.ЧастьСделкиРЕПО = 0 Тогда
		СделкаРЕПО = Основание;
		Если Основание.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход
			ИЛИ Основание.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
			ЧастьСделкиРЕПО = 1;
		Иначе
			ЧастьСделкиРЕПО = 2;
		КонецЕсли;
	ИначеЕсли Основание.ЧастьСделкиРЕПО = 1 Тогда
		СделкаРЕПО = Основание;
	Иначе
		СделкаРЕПО = Основание.ПерваяЧастьРЕПО;
	КонецЕсли;
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаОплаты,
		ЭтотОбъект.Брокер);	
		
		
	РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СделкаРЕПО, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов, ВалютаСделки");
	КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(РеквизитыСделки, НастройкиУчета);
		
	
	АналитикаПерекурсовкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, УчетныйРегистр, "АналитикаПерекурсовки"); 
	АналитикаПереоценкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, УчетныйРегистр, "АналитикаДоходовОтПереоценки"); 
	АналитикаДоходовРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, УчетныйРегистр, "АналитикаДоходов"); 
	СчетПереоценкиРасчетовПоРЕПО = ПланыСчетов.Основной.НалоговыеНачисленияПоРЕПО; 
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	КонецЕсли;
	
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
		
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, Основание, УчетныйРегистр);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияЧасть1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияЧасть1.ВалютаОплаты КАК ВалютаЧасть1,
		|	УсловияЧасть2.ВалютаОплаты КАК ВалютаЧасть2,
		|	УсловияЧасть1.Сумма + УсловияЧасть1.СуммаКупона КАК СуммаЧасть1,
		|	УсловияЧасть2.Сумма + УсловияЧасть2.СуммаКупона КАК СуммаЧасть2,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоОбратномуРЕПО.СуммаОстатокДт, 0) КАК СуммаОстатокРасчетыПоОбратномуРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоОбратномуРЕПО.ВалютнаяСуммаОстатокДт, 0) КАК ВалютнаяСуммаОстатокРасчетыПоОбратномуРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетПроцентыПоРЕПО.СуммаОстаток, 0) КАК СуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетПроцентыПоРЕПО.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетЗакрытыеПроценты.СуммаОборот, 0) КАК СуммаЗакрытыхПроцентовПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетЗакрытыеПроценты.ВалютнаяСуммаОборот, 0) КАК ВалютнаяСуммаЗакрытыхПроцентовПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетОплатыВторойЧасти.СуммаОборотКт, 0) КАК СуммаОплатВторойЧастиРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетОплатыВторойЧасти.ВалютнаяСуммаОборотКт, 0) КАК ВалютнаяСуммаОплатВторойЧастиРЕПО
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодУсловияСделок,
		|			СделкаРЕПО = &СделкаРЕПО
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияЧасть1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетРасчетыПоОбратномуРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетРасчетыПоОбратномуРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетПроцентыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетПроцентыПоРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодУсловияСделок,
		|				СделкаРЕПО = &СделкаРЕПО
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияЧасть2
		|		ПО УсловияЧасть1.СделкаРЕПО = УсловияЧасть2.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
		|				&ДатаСделкиРЕПО,
		|				&Период,
		|				Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО,
		|				КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				) КАК БухгалтерскийУчетЗакрытыеПроценты
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетЗакрытыеПроценты.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
		|				&ДатаСделкиРЕПО,
		|				&Период,
		|				Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО,
		|				КорСчет = &СчетУчетаДС,
		|				) КАК БухгалтерскийУчетОплатыВторойЧасти
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетОплатыВторойЧасти.Субконто1";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодУсловияСделок", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
	Запрос.УстановитьПараметр("ДатаСделкиРЕПО", РеквизитыСделки.Дата);
	Запрос.УстановитьПараметр("СчетУчетаДС", СчетУчетаДС);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(Выборка.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		Если ЧастьСделкиРЕПО = 1 Тогда // ОТКРЫТИЕ ПОКУПКИ РЕПО
			
			СуммаЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СуммаЗадолженности,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗаймаПоТекущемуКурсу, "Займ РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
			Проводка.ВалютнаяСуммаДт = СуммаЗадолженности;
			
			// кредит
			Проводка.СчетКт = СчетУчетаДС;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ОткрытиеРЕПО;
			КонецЕсли;			
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаКт = СуммаОплаты;
			КонецЕсли;
			
		Иначе // ЗАКРЫТИЕ ПОКУПКИ РЕПО
			
			// Перекурсовка Займа
			СуммаЗаймаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.ВалютнаяСуммаОстатокРасчетыПоОбратномуРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата), 2);
				
			КурсоваяРазницаЗайм = СуммаЗаймаПоТекущемуКурсу - Выборка.СуммаОстатокРасчетыПоОбратномуРЕПО;
				
			Если КурсоваяРазницаЗайм > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаПерекурсовкиЗаймов;
				
			ИначеЕсли КурсоваяРазницаЗайм < 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаЗайм, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаПерекурсовкиЗаймов;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = Выборка.ВалютаЧасть1;
				
			КонецЕсли;
			
			// Перекурсовка Процентов
			СуммаПроцентовПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата), 2);
				
			КурсоваяРазницаПроценты = СуммаПроцентовПоТекущемуКурсу - Выборка.СуммаОстатокПроцентыПоРЕПО;
			
			Если КурсоваяРазницаПроценты > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть1;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
			ИначеЕсли КурсоваяРазницаПроценты < 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
				Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = Выборка.ВалютаЧасть1;
				
			КонецЕсли;
			
			ПолныеПроцентыПоРЕПО = ОКР((Выборка.СуммаЧасть2 - Выборка.СуммаЧасть1) * (СуммаЗадолженности + Выборка.ВалютнаяСуммаОплатВторойЧастиРЕПО) / Выборка.СуммаЧасть2  - Выборка.ВалютнаяСуммаЗакрытыхПроцентовПоРЕПО, 2);
			ПолныеПроцентыПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ПолныеПроцентыПоРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
				
			Если ЭтоПИФ И ЗначениеЗаполнено(АналитикаПереоценкиРасчетовПоРЕПО) И АналитикаПереоценкиРасчетовПоРЕПО <> АналитикаДоходовРасчетовПоРЕПО Тогда
				
				Если СуммаПроцентовПоТекущемуКурсу <> 0 Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПроцентовПоТекущемуКурсу, "Переоценка по РЕПО");
				
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					// кредит
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаКт = Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
				КонецЕсли;
					
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
			
				// дебет
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
				Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
			Иначе
				
				ЭтоПоследняяОплатаПоСделке = (Выборка.ВалютнаяСуммаОстатокРасчетыПоОбратномуРЕПО + ПолныеПроцентыПоРЕПО) = СуммаЗадолженности;
				
				Если ЭтоПоследняяОплатаПоСделке Тогда
					ДоначислитьПроцентовПоРЕПО = ПолныеПроцентыПоРЕПО - Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
				Иначе
					ДоначислитьПроцентовПоРЕПО = ?(Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО < ПолныеПроцентыПоРЕПО, ПолныеПроцентыПоРЕПО - Выборка.ВалютнаяСуммаОстатокПроцентыПоРЕПО, 0);
				КонецЕсли;
				
				ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
					ДоначислитьПроцентовПоРЕПО,
					РеквизитыСделки.ВалютаСделки,
					ЭтотОбъект.Организация,
					ЭтотОбъект.Дата);
					
				Если ДоначислитьПроцентовПоРЕПО > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
				
					// дебет
					Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаДт = ДоначислитьПроцентовПоРЕПО;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
				ИначеЕсли ДоначислитьПроцентовПоРЕПО < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
				
					// дебет
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					// кредит
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
					Проводка.ВалютнаяСуммаКт = -ДоначислитьПроцентовПоРЕПО;
					
				КонецЕсли;
			КонецЕсли;
			
			// закрываем проценты на займ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
		
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
			
			// кредит
			Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
			
			
			// оплата полной суммы займа
			СуммаЗакрытияЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СуммаЗадолженности,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗакрытияЗаймаПоТекущемуКурсу, "Возврат займа РЕПО");
			
			// дебет
			Проводка.СчетДт = СчетУчетаДС;
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			

			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеРЕПО;
			КонецЕсли;
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаДт = Выборка.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаДт = СуммаОплаты;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПредоставленныеЗаймы;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = Выборка.ВалютаЧасть2;
			Проводка.ВалютнаяСуммаКт = СуммаЗадолженности;
			
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Процедура ПерекурсоватьБумагиОбратногоРЕПО(УчетныйРегистр, Отказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Организация КАК Организация,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения КАК ВидДвижения
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
		|ГДЕ
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Ссылка
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Количество = 0
		|	И (БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения = &Приход
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Стоимость = 0
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона = 0
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Переоценка = 0
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаВВалютеУчета = 0
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона = 0
		|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета = 0
		|	ИЛИ БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения <> &Приход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.Организация,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага,
		|	БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Приход",  ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			Если ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета <>0 Тогда
				
				СторонаПроводки = ?(ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета>0,"Кт","Дт");
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета), "Курсовая разница");
				
				Проводка["Счет" + СторонаПроводки] = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
				Проводка["Субконто" + СторонаПроводки].ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка["Валюта" + СторонаПроводки] = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета <>0 Тогда
				
				СторонаПроводки = ?(ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета>0,"Кт","Дт");
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета), "Курсовая разница");
				
				Проводка["Счет" + СторонаПроводки] = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				Проводка["Субконто" + СторонаПроводки].ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка["Валюта" + СторонаПроводки] = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;
				
			КонецЕсли;
		Иначе
			Если ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета <>0 Тогда
				
				СторонаПроводки = ?(ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета>0,"Дт","Кт");
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета), "Списание залоговой стоимости");
				
				Проводка["Счет" + СторонаПроводки] = ПланыСчетов.Основной.ПартииРЕПОПокупкаТело;
				Проводка["Субконто" + СторонаПроводки].ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка["Валюта" + СторонаПроводки] = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;
				Проводка["ВалютнаяСумма" + СторонаПроводки] = ВыборкаДетальныеЗаписи.Стоимость;
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета <>0 Тогда
				
				СторонаПроводки = ?(ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета>0,"Дт","Кт");
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета), "Списание залоговой стоимости");
				
				Проводка["Счет" + СторонаПроводки] = ПланыСчетов.Основной.ПартииРЕПОПокупкаКупон;
				Проводка["Субконто" + СторонаПроводки].ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка["Валюта" + СторонаПроводки] = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;
				Проводка["ВалютнаяСумма" + СторонаПроводки] = ВыборкаДетальныеЗаписи.СтоимостьКупона;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ПроведениеПоРегиструБухгалтерииОбычнаяСделка_РЕПО(УчетныйРегистр, СтрокаОснования, Отказ)
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);

	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаОплаты,
		ЭтотОбъект.Брокер);	
		
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	КонецЕсли;
		
	ВалютнаяСделка = СтрокаОснования.Валюта <> ЭтотОбъект.Организация.ВалютаУчета;
	СчетРасчетовПоСделке = ?(НЕ ВалютнаяСделка, ПланыСчетов.Основной.РасчетыСКонтрагентами, ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте);
		
	Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда // ПОКУПКА
			
	    // ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.СуммаОплаты,ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), "Покупка ценной бумаги");
		
		// дебет
		Проводка.СчетДт = СчетРасчетовПоСделке;
		Проводка.СубконтоДт.Контрагенты = СтрокаОснования.Основание.Контрагент;
		Если НЕ ЗначениеЗаполнено(Проводка.СубконтоДт.Контрагенты) Тогда
			Проводка.СубконтоДт.Контрагенты = Брокер.ЮрФизЛицо;
		КонецЕсли;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = СтрокаОснования.Сумма;
			Проводка.ВалютаДт = СтрокаОснования.Валюта;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = СчетУчетаДС;
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;	
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
			Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
		КонецЕсли;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
		КонецЕсли;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
		КонецЕсли;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = СтрокаОснования.СуммаОплаты;
			Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
		КонецЕсли;
		
		Если СтрокаОснования.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			// ПРИХОДУЕМ СТОИМОСТЬ КУПОНА
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.СуммаОплатыКупона,ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), "Покупка ценной бумаги (купон)");
			
			// дебет
			Проводка.СчетДт = СчетРасчетовПоСделке;
			Проводка.СубконтоДт.Контрагенты = СтрокаОснования.Основание.Контрагент;
			Если НЕ ЗначениеЗаполнено(Проводка.СубконтоДт.Контрагенты) Тогда
				Проводка.СубконтоДт.Контрагенты = Брокер.ЮрФизЛицо;
			КонецЕсли;
			
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = СтрокаОснования.СуммаКупона;
				Проводка.ВалютаДт = СтрокаОснования.Валюта;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетУчетаДС;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
			КонецЕсли;
			
			Если Проводка.СчетКт.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = СтрокаОснования.СуммаОплатыКупона;
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
			КонецЕсли;
		
		КонецЕсли;
		
	Иначе // ПРОДАЖА	
		// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.СуммаОплаты,ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), "Продажа ценной бумаги");
		
		Проводка.СчетДт = СчетУчетаДС;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
			Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
		КонецЕсли;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
		КонецЕсли;
		
		Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Продажа;
		КонецЕсли;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = СтрокаОснования.СуммаОплаты;
			Проводка.ВалютаДт = ЭтотОбъект.ВалютаОплаты;
		КонецЕсли;
		
		Проводка.СчетКт = СчетРасчетовПоСделке;
		Проводка.СубконтоКт.Контрагенты = СтрокаОснования.Основание.Контрагент;
		Если НЕ ЗначениеЗаполнено(Проводка.СубконтоКт.Контрагенты) Тогда
			Проводка.СубконтоКт.Контрагенты = Брокер.ЮрФизЛицо;
		КонецЕсли;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = СтрокаОснования.Сумма;
			Проводка.ВалютаКт = СтрокаОснования.Валюта;
		КонецЕсли;
		
		
		Если СтрокаОснования.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ КУПОНА
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснования.СуммаОплатыКупона,ЭтотОбъект.ВалютаОплаты, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), "Продажа ценной бумаги (купон)");
			
			Проводка.СчетДт = СчетУчетаДС;
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.Продажа;;
			КонецЕсли;
						
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = СтрокаОснования.СуммаОплатыКупона;
				Проводка.ВалютаДт = ЭтотОбъект.ВалютаОплаты;
			КонецЕсли;
			
			Проводка.СчетКт = СчетРасчетовПоСделке;
			Проводка.СубконтоКт.Контрагенты = СтрокаОснования.Основание.Контрагент;
			Если НЕ ЗначениеЗаполнено(Проводка.СубконтоКт.Контрагенты) Тогда
				Проводка.СубконтоКт.Контрагенты = Брокер.ЮрФизЛицо;
			КонецЕсли;
			
			Если Проводка.СчетКт.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = СтрокаОснования.СуммаКупона;
				Проводка.ВалютаКт = СтрокаОснования.Валюта;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииПрямоеРЕПО(УчетныйРегистр, Основание, СуммаОплаты,  СуммаЗадолженности, Отказ)

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);
	
	СчетДоходов = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаОплаты,
		ЭтотОбъект.Брокер);	
		
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	КонецЕсли;
	
	АналитикаПерекурсовкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, УчетныйРегистр, "АналитикаПерекурсовки"); 
	АналитикаПереоценкиРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, УчетныйРегистр, "АналитикаДоходовОтПереоценки"); 
	АналитикаДоходовРасчетовПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, УчетныйРегистр, "АналитикаДоходов"); 
	СчетПереоценкиРасчетовПоРЕПО = ПланыСчетов.Основной.ПроцентыПоКраткосрочнымКредитам; 
	
	ЭтоПИФ = ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
	
	ЧастьСделкиРЕПО = Основание.ЧастьСделкиРЕПО;
	Если Основание.ЧастьСделкиРЕПО = 0 Тогда
		СделкаРЕПО = Основание;
		Если Основание.ВидСделки = Перечисления.ВидыСделок.Покупка И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход
			ИЛИ Основание.ВидСделки = Перечисления.ВидыСделок.Продажа И ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
			ЧастьСделкиРЕПО = 1;
		Иначе
			ЧастьСделкиРЕПО = 2;
		КонецЕсли;
	ИначеЕсли Основание.ЧастьСделкиРЕПО = 1 Тогда
		СделкаРЕПО = Основание;
	Иначе
		СделкаРЕПО = Основание.ПерваяЧастьРЕПО;
	КонецЕсли;
	
	
	РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СделкаРЕПО, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов, ВалютаСделки, ВидСделки");
	КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(РеквизитыСделки, НастройкиУчета);
	
	
	//// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, Основание, УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияЧасть1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияЧасть1.ВалютаОплаты КАК ВалютаЧасть1,
		|	УсловияЧасть2.ВалютаОплаты КАК ВалютаЧасть2,
		|	УсловияЧасть1.Сумма + УсловияЧасть1.СуммаКупона КАК СуммаЧасть1,
		|	УсловияЧасть2.Сумма + УсловияЧасть2.СуммаКупона КАК СуммаЧасть2,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоПрямомуРЕПО.СуммаОстатокКт, 0) КАК СуммаОстатокРасчетыПоПрямомуРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетРасчетыПоПрямомуРЕПО.ВалютнаяСуммаОстатокКт, 0) КАК ВалютнаяСуммаОстатокРасчетыПоПрямомуРЕПО,
		|	ЕСТЬNULL(-БухгалтерскийУчетПроцентыПоРЕПО.СуммаОстаток, 0) КАК СуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(-БухгалтерскийУчетПроцентыПоРЕПО.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокПроцентыПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетЗакрытыеПроценты.СуммаОборот, 0) КАК СуммаЗакрытыхПроцентовПоРЕПО,
		|	ЕСТЬNULL(БухгалтерскийУчетЗакрытыеПроценты.ВалютнаяСуммаОборот, 0) КАК ВалютнаяСуммаЗакрытыхПроцентовПоРЕПО
		|ПОМЕСТИТЬ _ДвиженияДокумента
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодУсловияСделок,
		|			СделкаРЕПО = &СделкаРЕПО
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияЧасть1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодУсловияСделок,
		|				СделкаРЕПО = &СделкаРЕПО
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияЧасть2
		|		ПО УсловияЧасть1.СделкаРЕПО = УсловияЧасть2.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.КраткосрочныеКредиты),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетРасчетыПоПрямомуРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетРасчетыПоПрямомуРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО) КАК БухгалтерскийУчетПроцентыПоРЕПО
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетПроцентыПоРЕПО.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
		|				&ДатаСделкиРЕПО,
		|				&Период,
		|				Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|					ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|					И Субконто1 = &СделкаРЕПО,
		|				КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.КраткосрочныеКредиты),
		|				) КАК БухгалтерскийУчетЗакрытыеПроценты
		|		ПО УсловияЧасть1.СделкаРЕПО = БухгалтерскийУчетЗакрытыеПроценты.Субконто1";

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Регистратор", Основание);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодУсловияСделок", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
	Запрос.УстановитьПараметр("ДатаСделкиРЕПО", РеквизитыСделки.Дата);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	Запрос.Выполнить();
	
	
	// дс
	
	ВыборкаДвиженияДокумента = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДвиженияДокумента").ПолучитьДанные().Выбрать();	
	Пока ВыборкаДвиженияДокумента.Следующий() Цикл
		
		Если ЧастьСделкиРЕПО = 1 Тогда // займ
			
			СуммаЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СуммаЗадолженности,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗаймаПоТекущемуКурсу, "Продажа РЕПО");
			
			// дебет
			Проводка.СчетДт = СчетУчетаДС;
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоДт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ОткрытиеРЕПО;
			КонецЕсли;
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаДт = ВыборкаДвиженияДокумента.ВалютаЧасть1;
				Проводка.ВалютнаяСуммаДт = СуммаОплаты;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = СуммаЗадолженности;
			
		ИначеЕсли ЧастьСделкиРЕПО = 2 Тогда // Закрытие займа
			
			// Перекурсовка Займа
			СуммаЗаймаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ВыборкаДвиженияДокумента.ВалютнаяСуммаОстатокРасчетыПоПрямомуРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата), 2);
				
			КурсоваяРазницаЗайм = СуммаЗаймаПоТекущемуКурсу - ВыборкаДвиженияДокумента.СуммаОстатокРасчетыПоПрямомуРЕПО;
			
			Если РеквизитыСделки.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда  
				
				Если КурсоваяРазницаЗайм < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаЗайм, "Курсовая разница");
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
					
					Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
					
				ИначеЕсли КурсоваяРазницаЗайм > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаЗайм, "Курсовая разница");
					
					Проводка.СчетДт = ПланыСчетов.Основной.КраткосрочныеКредиты;
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
					
				КонецЕсли;
			Иначе
				Если КурсоваяРазницаЗайм < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаЗайм, "Курсовая разница");
					
					Проводка.СчетДт = ПланыСчетов.Основной.КраткосрочныеКредиты;
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
					
				ИначеЕсли КурсоваяРазницаЗайм > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаЗайм, "Курсовая разница");
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
					
					Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
								
				КонецЕсли;
				
			КонецЕсли;
				
			// Перекурсовка Процентов
			СуммаПроцентовПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ВыборкаДвиженияДокумента.ВалютнаяСуммаОстатокПроцентыПоРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата), 2);
				
			КурсоваяРазницаПроценты = СуммаПроцентовПоТекущемуКурсу - ВыборкаДвиженияДокумента.СуммаОстатокПроцентыПоРЕПО;
			
			Если КурсоваяРазницаПроценты < 0 Тогда
				//пассив уменьшился -> доход
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
			ИначеЕсли КурсоваяРазницаПроценты > 0 Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], КурсоваяРазницаПроценты, "Курсовая разница");
				
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовкиРасчетовПоРЕПО;
				
				Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
				
			КонецЕсли;
			
			ПолныеПроцентыПоРЕПО = ВыборкаДвиженияДокумента.СуммаЧасть2 - ВыборкаДвиженияДокумента.СуммаЧасть1;
			ПолныеПроцентыПоРЕПОПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				ПолныеПроцентыПоРЕПО,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата), 2);
				
			Если ВыборкаДвиженияДокумента.СуммаЗакрытыхПроцентовПоРЕПО = 0 Тогда
				
				Если ЭтоПИФ И ЗначениеЗаполнено(АналитикаПереоценкиРасчетовПоРЕПО) И АналитикаПереоценкиРасчетовПоРЕПО <> АналитикаДоходовРасчетовПоРЕПО Тогда
					
					СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(
							ЭтотОбъект.Дата,
							СделкаРЕПО, 
							УчетныйРегистр);
							
					ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
					
					ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
					
					Если СуммаПроцентовПоТекущемуКурсу <> 0 Тогда
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПроцентовПоТекущемуКурсу, "Переоценка по РЕПО");
						
						Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
						Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
						Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
						
						Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
						Проводка.ВалютнаяСуммаДт = ВыборкаДвиженияДокумента.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
						
						Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
						Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПереоценкиРасчетовПоРЕПО;
						Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
						Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
						
					КонецЕсли;
						
						
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
					
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
					Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
					
					Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
					Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
					
					Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
					Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
						
				Иначе
					ДоначислитьПроцентовПоРЕПО = ПолныеПроцентыПоРЕПО - ВыборкаДвиженияДокумента.ВалютнаяСуммаОстатокПроцентыПоРЕПО;
					ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу = ПолныеПроцентыПоРЕПОПоТекущемуКурсу - СуммаПроцентовПоТекущемуКурсу;
						
					// доначисляем проценты
					Если ДоначислитьПроцентовПоРЕПО > 0 Тогда
						
						СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(
							ЭтотОбъект.Дата,
							СделкаРЕПО, 
							УчетныйРегистр);
							
						ЦеннаяБумага = СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
						
						ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
						
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДоначислитьПроцентовПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
						
						Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
						Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовРасчетовПоРЕПО;
						Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
						Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
						
						Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
						Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
						
						Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
						Проводка.ВалютнаяСуммаКт = ДоначислитьПроцентовПоРЕПО;
						
					КонецЕсли;
				КонецЕсли;
				
				// закрываем проценты на займ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ПолныеПроцентыПоРЕПОПоТекущемуКурсу, "Проценты по РЕПО");
				
				Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = ПолныеПроцентыПоРЕПО;
				
				Проводка.СчетКт = ПланыСчетов.Основной.КраткосрочныеКредиты;
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.СделкаРЕПО = СделкаРЕПО;
				
				Проводка.ВалютаКт = РеквизитыСделки.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = ПолныеПроцентыПоРЕПО;
				
			КонецЕсли;
			
			// оплата полной суммы займа
			СуммаЗакрытияЗаймаПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СуммаЗадолженности,
				РеквизитыСделки.ВалютаСделки,
				ЭтотОбъект.Организация,
				ЭтотОбъект.Дата);
			                       
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаЗакрытияЗаймаПоТекущемуКурсу, "Проценты по РЕПО");
			
			Проводка.СчетДт = ПланыСчетов.Основной.КраткосрочныеКредиты;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СделкаРЕПО;
			
			Проводка.ВалютаДт = РеквизитыСделки.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = СуммаЗадолженности;
			
			Проводка.СчетКт = СчетУчетаДС;
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
				Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
			КонецЕсли;	
			

			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
				Проводка.СубконтоКт.БрокерскиеКомпании              = ЭтотОбъект.Брокер;
			КонецЕсли;
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
				Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
			КонецЕсли;
			
			Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.ЗакрытиеРЕПО;
			КонецЕсли;			
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютаКт = ВыборкаДвиженияДокумента.ВалютаЧасть2;
				Проводка.ВалютнаяСуммаКт = СуммаОплаты;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПроводкиПоНачислению(УчетныйРегистр, Отказ)
	
	ТЗПроводокОбщая = Неопределено;
	
	// В массив добавляются виды документов, у которых в модуле менеджера есть функция ПодготовитьНаборПроводок
	МассивВидовДокументовНачисления = Новый Массив;
	МассивВидовДокументовНачисления.Добавить("НачислениеЗадолженности");
	МассивВидовДокументовНачисления.Добавить("ПогашениеКупона");
	МассивВидовДокументовНачисления.Добавить("ПогашениеЦеннойБумаги");
	МассивВидовДокументовНачисления.Добавить("НачислениеДивидендов");
	МассивВидовДокументовНачисления.Добавить("СписаниеЦеннойБумаги");
	МассивВидовДокументовНачисления.Добавить("КорректировкаЗадолженности");
			
	ТЗОснования = Основания.Выгрузить();
	ТЗОснования.Свернуть("Основание, Валюта, КурсОплаты, СобственныйКурсОплаты", "Сумма, СуммаКупона, СуммаОплаты, СуммаОплатыКупона");
	
	// Если в основаниях документы "Ввод денежных средств", нужно найти соответствующие документы "Начисление задолженности" и сформировать проводки по ним
	// Также в отдельных случаях требуются проводки документа "Списание ЦБ"
	ПодготовитьТаблицуОснований(ТЗОснования, МассивВидовДокументовНачисления);
	
	Для Каждого СтрокаОснования Из ТЗОснования Цикл
		
		// Начисление нужно проводить на сумму оплаты
		СуммаОплаты 		= РаботаСВалютами.ПолучитьСуммуВВалютеУчета(?(СтрокаОснования.СуммаОплатыКупона <> 0, СтрокаОснования.СуммаОплатыКупона, СтрокаОснования.СуммаОплаты), ВалютаОплаты, Организация, Дата, Отказ);		
		ВалютнаяСуммаОплаты = ?(СтрокаОснования.СуммаОплатыКупона <> 0, СтрокаОснования.СуммаОплатыКупона, СтрокаОснования.СуммаОплаты);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ВидДокумента = РаботаСДокументами.ПолучитьИмя(СтрокаОснования.Основание);
		
		Если МассивВидовДокументовНачисления.Найти(ВидДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;		
		
		НаборПроводок = Документы[ВидДокумента].ПодготовитьНаборПроводок(
			СтрокаОснования.Основание, 
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления, 
			ЭтотОбъект.ВидЗадолженности, 
			УчетныйРегистр, 
			Отказ);
			
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если НаборПроводок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТЗПроводок = НаборПроводок.Выгрузить();
		
		ТЗПроводок.Свернуть("Период, Регистратор, Активность, СчетДт, СчетКт, Организация, СчетДоверительногоУправления, ВалютаДт, ВалютаКт, Содержание, ПорядокОпераций, МоментВремени, ВидСубконтоДт1, СубконтоДт1, ВидСубконтоДт2, СубконтоДт2, ВидСубконтоДт3, СубконтоДт3, ВидСубконтоКт1, СубконтоКт1, ВидСубконтоКт2, СубконтоКт2, ВидСубконтоКт3, СубконтоКт3", "КоличествоДт, КоличествоКт, Сумма, ВалютнаяСуммаДт, ВалютнаяСуммаКт");
		
		ТЗПроводок.Колонки.Добавить("ЭтоПерекурсовка");
		ТЗПроводок.Колонки.Добавить("ЭтоНачисление");
		ТЗПроводок.ЗаполнитьЗначения(Ложь, 				"ЭтоПерекурсовка");
		ТЗПроводок.ЗаполнитьЗначения(Ложь, 				"ЭтоНачисление");
		ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Ссылка, "Регистратор");
		ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Дата,   "Период");
		
		ЭтоПоступлениеДС	= ВидДвижения = Перечисления.ВидыДвижений.Приход;
		СчетПрочиеДоходы	= ПланыСчетов.Основной.ПрочиеДоходы;
		СчетПрочиеРасходы	= ПланыСчетов.Основной.ПрочиеРасходы;
				
		// Заполняем суммы по оплате.
		// Суммы соответствующих списаний себестоимости и т. д. принимаются пропорционально оплате.
				
		// Найдем суммы начислений в таблице. Они требуются для пропорционального распределения
		Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.КорректировкаЗадолженности") Тогда
			ТекОтбор = Новый Структура(?(ЭтоПоступлениеДС, "СчетДт", "СчетКт"), ?(ЭтоПоступлениеДС, СчетПрочиеРасходы, СчетПрочиеДоходы));
		Иначе
			ТекОтбор = Новый Структура(?(ЭтоПоступлениеДС, "СчетКт", "СчетДт"), ?(ЭтоПоступлениеДС, СчетПрочиеДоходы, СчетПрочиеРасходы));
		КонецЕсли;	
		НайдСтроки = ТЗПроводок.НайтиСтроки(ТекОтбор);
		
		Если НайдСтроки.Количество() = 0 Тогда
			
			Если ТипЗнч(СтрокаОснования.Основание) <> Тип("ДокументСсылка.ПогашениеКупона") Тогда // для погашения купона такое можно
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В проводках документа начисления отсутствуют записи по" + ?(ЭтоПоступлениеДС, " кредиту счета " + СокрЛП(СчетПрочиеДоходы), " дебету счета " + СокрЛП(СчетПрочиеРасходы)) + "!", ЭтотОбъект.Ссылка,,, Отказ);
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
				
		ОбщаяСуммаНачисления 	= 0;
		ПроводкиПерекурсовки = ТЗПроводок.Скопировать();
		ПроводкиПерекурсовки.Очистить();
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл
			
			// Если в проводке есть валюта, а валютная сумма равна нулю, это перекурсовка. 
			// Суммы перекурсовки получены на дату оплаты
			Если (ЗначениеЗаполнено(НайдСтрока.ВалютаДт) И НайдСтрока.ВалютнаяСуммаДт = 0) 
				ИЛИ (ЗначениеЗаполнено(НайдСтрока.ВалютаКт) И НайдСтрока.ВалютнаяСуммаКт = 0) Тогда
				СтрокаПерекурсовки = ПроводкиПерекурсовки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПерекурсовки, НайдСтрока);
				НайдСтрока.ЭтоПерекурсовка = Истина;
				Продолжить;
			КонецЕсли;
			
			Если ЭтоПоступлениеДС Тогда
				ОбщаяСуммаНачисления 	= ОбщаяСуммаНачисления + ?(НайдСтрока.ВалютнаяСуммаДт = 0, НайдСтрока.Сумма, НайдСтрока.ВалютнаяСуммаДт);
			Иначе
				ОбщаяСуммаНачисления 	= ОбщаяСуммаНачисления + ?(НайдСтрока.ВалютнаяСуммаКт = 0, НайдСтрока.Сумма, НайдСтрока.ВалютнаяСуммаКт);
			КонецЕсли;
			
			НайдСтрока.ЭтоНачисление = Истина;
			
		КонецЦикла;
		
		// Возможны случаи, когда по 91 счету в документах начисления проходят остаточные или корректировочные суммы
		// В таких случаях пропорцию не применяем, переносим проводки как есть
		НеИзменятьПроводки = Ложь;
		Если ВалютнаяСуммаОплаты >= ОбщаяСуммаНачисления Тогда // если совпали тоже менять не надо!
			НеИзменятьПроводки = Истина;
		Иначе	
			КоэффициентСписания = ВалютнаяСуммаОплаты / ОбщаяСуммаНачисления;
		КонецЕсли;
				
		ЭтоПоследняяОплата = ВалютнаяСуммаОплаты = СтрокаОснования.ОстатокЗадолженности;
		Для Каждого СтрокаПроводки Из ТЗПроводок Цикл
			
			// по дивидендам не нужно трогать проводки
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
				Продолжить;
			КонецЕсли;
			
			// Проводки перекурсовки пропускаем
			Если СтрокаПроводки.ЭтоПерекурсовка Тогда
				Продолжить;
			КонецЕсли;
			
			Если НеИзменятьПроводки Тогда 
				Продолжить;
			КонецЕсли;
			
			// Для самих начислений устанавливаем суммы оплаты
			// Учитываем Сумму, ВалютнуюСуммуДт и ВалютнуюСуммуКт
						
			Если СтрокаПроводки.ЭтоНачисление Тогда
				
				СтрокаПроводки.Сумма = СуммаОплаты;	
				
				Если СтрокаПроводки.СчетДт.Валютный Тогда
					СтрокаПроводки.ВалютнаяСуммаДт = ВалютнаяСуммаОплаты;
				КонецЕсли;
							
				Если СтрокаПроводки.СчетКт.Валютный Тогда
					СтрокаПроводки.ВалютнаяСуммаКт = ВалютнаяСуммаОплаты;
				КонецЕсли;
				
			Иначе
				
				// Для последней оплаты получим остаток по счету и спишем
				Если ЭтоПоследняяОплата Тогда
					
					Если СтрокаПроводки.СчетДт = СчетПрочиеРасходы Тогда
						СтруктураОстатков = ПолучитьОстатокПоСчету(СтрокаОснования.Основание, УчетныйРегистр, СтрокаПроводки.СчетКт, СтрокаПроводки.СубконтоКт1, СтрокаПроводки.СубконтоКт2, СтрокаПроводки.СубконтоКт3);
						
						Если СтрокаПроводки.СчетКт.Валютный Тогда
							СтрокаПроводки.ВалютнаяСуммаКт = СтруктураОстатков.ВалютнаяСуммаДт;
						КонецЕсли;
						
					ИначеЕсли СтрокаПроводки.СчетКт = СчетПрочиеДоходы Тогда
						СтруктураОстатков = ПолучитьОстатокПоСчету(СтрокаОснования.Основание, УчетныйРегистр, СтрокаПроводки.СчетДт, СтрокаПроводки.СубконтоДт1, СтрокаПроводки.СубконтоДт2, СтрокаПроводки.СубконтоДт3);	
						
						Если СтрокаПроводки.СчетДт.Валютный Тогда
							СтрокаПроводки.ВалютнаяСуммаДт = СтруктураОстатков.ВалютнаяСуммаКт;
						КонецЕсли;
						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проводки по начислению для последней оплаты не сформированы!", ЭтотОбъект.Ссылка,,, Отказ);
						Отказ = Истина;
						Возврат;
					КонецЕсли;
					
					СтрокаПроводки.Сумма = СтруктураОстатков.Сумма;
										
				Иначе
					
					СтрокаПроводки.Сумма = СтрокаПроводки.Сумма * КоэффициентСписания;
					
					Если СтрокаПроводки.СчетДт.Валютный Тогда
						СтрокаПроводки.ВалютнаяСуммаДт = СтрокаПроводки.ВалютнаяСуммаДт * КоэффициентСписания;
					КонецЕсли;
								
					Если СтрокаПроводки.СчетКт.Валютный Тогда
						СтрокаПроводки.ВалютнаяСуммаКт = СтрокаПроводки.ВалютнаяСуммаКт * КоэффициентСписания;
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Если ТЗПроводокОбщая = Неопределено Тогда
			ТЗПроводокОбщая = ТЗПроводок.Скопировать();
			ТЗПроводокОбщая.Очистить();
		КонецЕсли;	
			
		Для Каждого СтрокаПроводки Из ТЗПроводок Цикл
									
			НоваяСтрокаПроводки = ТЗПроводокОбщая.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПроводки, СтрокаПроводки);	
				
		КонецЦикла;	
			
	КонецЦикла;	
	
	Если Не ТЗПроводокОбщая = Неопределено Тогда
		Движения[УчетныйРегистр].Загрузить(ТЗПроводокОбщая);
	КонецЕсли;
		
КонецПроцедуры // СформироватьПроводкиПоНачислению()	

Процедура ПодготовитьТаблицуОснований(ТЗОснования, МассивВидовДокументовНачисления)

	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Основания.Основание КАК Основание,
	|	_Основания.Валюта КАК Валюта,
	|	_Основания.КурсОплаты КАК КурсОплаты,
	|	_Основания.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
	|	_Основания.Сумма КАК Сумма,
	|	_Основания.СуммаКупона КАК СуммаКупона,
	|	_Основания.СуммаОплаты КАК СуммаОплаты,
	|	_Основания.СуммаОплатыКупона КАК СуммаОплатыКупона
	|ПОМЕСТИТЬ _ОснованияИзТЗ
	|ИЗ
	|	&Основания КАК _Основания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ОснованияИзТЗ.Основание КАК Основание,
	|	_ОснованияИзТЗ.Валюта КАК Валюта,
	|	_ОснованияИзТЗ.КурсОплаты КАК КурсОплаты,
	|	_ОснованияИзТЗ.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
	|	СУММА(_ОснованияИзТЗ.Сумма) КАК Сумма,
	|	СУММА(_ОснованияИзТЗ.СуммаКупона) КАК СуммаКупона,
	|	СУММА(_ОснованияИзТЗ.СуммаОплаты) КАК СуммаОплаты,
	|	СУММА(_ОснованияИзТЗ.СуммаОплатыКупона) КАК СуммаОплатыКупона
	|ПОМЕСТИТЬ _Основания
	|ИЗ
	|	_ОснованияИзТЗ КАК _ОснованияИзТЗ
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(_ОснованияИзТЗ.Основание) В (&СписокТиповДокументов)
	|
	|СГРУППИРОВАТЬ ПО
	|	_ОснованияИзТЗ.Основание,
	|	_ОснованияИзТЗ.Валюта,
	|	_ОснованияИзТЗ.КурсОплаты,
	|	_ОснованияИзТЗ.СобственныйКурсОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаОстаток,
	|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание
	|ПОМЕСТИТЬ _ОстаткиЗадолженности
	|ИЗ
	|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
	|			&ПериодГраница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Основание В
	|					(ВЫБРАТЬ
	|						_Основания.Основание
	|					ИЗ
	|						_Основания КАК _Основания)) КАК ЗадолженностиПоДенежнымСредствамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НачислениеЗадолженностиОснования.Ссылка КАК НачислениеЗадолженности,
	|	НачислениеЗадолженностиОснования.Основание КАК ВводДС
	|ПОМЕСТИТЬ _Начисления
	|ИЗ
	|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
	|ГДЕ
	|	НачислениеЗадолженностиОснования.Основание В
	|			(ВЫБРАТЬ
	|				_Основания.Основание
	|			ИЗ
	|				_Основания КАК _Основания)
	|	И ТИПЗНАЧЕНИЯ(НачислениеЗадолженностиОснования.Основание) = ТИП(Документ.ВводДенежныхСредств)
	|	И НачислениеЗадолженностиОснования.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(_Начисления.НачислениеЗадолженности, _Основания.Основание) КАК Основание,
	|	_Основания.Валюта КАК Валюта,
	|	_Основания.КурсОплаты КАК КурсОплаты,
	|	_Основания.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
	|	_Основания.Сумма КАК Сумма,
	|	_Основания.СуммаКупона КАК СуммаКупона,
	|	_Основания.СуммаОплаты КАК СуммаОплаты,
	|	_Основания.СуммаОплатыКупона КАК СуммаОплатыКупона,
	|	ЕСТЬNULL(_ОстаткиЗадолженности.СуммаОстаток, 0) КАК ОстатокЗадолженности
	|ИЗ
	|	_Основания КАК _Основания
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Начисления КАК _Начисления
	|		ПО _Основания.Основание = _Начисления.ВводДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиЗадолженности КАК _ОстаткиЗадолженности
	|		ПО _Основания.Основание = _ОстаткиЗадолженности.Основание";
	
	// Если оплата по последнему погашению облигации, дополнительно требуются проводки документа "Списание ЦБ"
	Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|";
		
		Запрос.Текст = Запрос.Текст + 		
		"ВЫБРАТЬ
		|	СписаниеЦБ.Ссылка КАК Основание,
		|	_Основания.Валюта КАК Валюта,
		|	_Основания.КурсОплаты КАК КурсОплаты,
		|	_Основания.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	_Основания.Сумма КАК Сумма,
		|	_Основания.СуммаКупона КАК СуммаКупона,
		|	_Основания.СуммаОплаты КАК СуммаОплаты,
		|	_Основания.СуммаОплатыКупона КАК СуммаОплатыКупона,
		|	0 КАК ОстатокЗадолженности
		|ИЗ
		|	Документ.СписаниеЦеннойБумаги КАК СписаниеЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Основания КАК _Основания
		|		ПО ((ВЫРАЗИТЬ(_Основания.Основание КАК Документ.ПогашениеЦеннойБумаги)) = СписаниеЦБ.ПогашениеЦеннойБумаги)
		|ГДЕ
		|	СписаниеЦБ.ПогашениеЦеннойБумаги В
		|			(ВЫБРАТЬ
		|				_Основания.Основание
		|			ИЗ
		|				_Основания КАК _Основания)
		|	И НЕ СписаниеЦБ.ПометкаУдаления";

	КонецЕсли;
	
	СтрокаТиповДокументов = "ТИП(Документ.ВводДенежныхСредств)";
	Для Каждого ТипДокументаНачисления Из МассивВидовДокументовНачисления Цикл
		СтрокаТиповДокументов = СтрокаТиповДокументов + ", ТИП(Документ." + ТипДокументаНачисления + ")";
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СписокТиповДокументов", СтрокаТиповДокументов);
		
	Запрос.УстановитьПараметр("Основания",						ТЗОснования);
	Запрос.УстановитьПараметр("ПериодГраница",					Новый МоментВремени(Дата, Ссылка));
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	ТЗОснования = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Функция ПолучитьОстатокПоСчету(ОснованиеПлатежа, УчетныйРегистр, Счет, Субконто1 = Неопределено, Субконто2 = Неопределено, Субконто3 = Неопределено)
	
	Результат = Новый Структура("Сумма, ВалютнаяСуммаДт, ВалютнаяСуммаКт", 0, 0, 0);
	
	Запрос = Новый Запрос;
	ТекстЗапроса =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухгалтерскийУчетОстатки.СуммаОстаток - БухгалтерскийУчетОбороты.СуммаОборотКт КАК Сумма,
	|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт - БухгалтерскийУчетОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаДт,
	|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт + БухгалтерскийУчетОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаКт
	|ИЗ
	|	РегистрБухгалтерии." + УчетныйРегистр + ".Остатки(
	|			&МоментВремениОснование,
	|			Счет = &Счет,
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета";
	
	Если ЗначениеЗаполнено(Субконто1) Тогда
		ТекстЗапроса = ТекстЗапроса + "	
		|				И Субконто1 = &Субконто1";
		Запрос.УстановитьПараметр("Субконто1", Субконто1);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Субконто2) Тогда
		ТекстЗапроса = ТекстЗапроса + "	
		|				И Субконто2 = &Субконто2";
		Запрос.УстановитьПараметр("Субконто2", Субконто2);
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(Субконто3) Тогда
		ТекстЗапроса = ТекстЗапроса + "		
		|				И Субконто3 = &Субконто3";
		Запрос.УстановитьПараметр("Субконто3", Субконто3);
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + ") КАК БухгалтерскийУчетОстатки,
	|	РегистрБухгалтерии." + УчетныйРегистр + ".Обороты(
	|			&МоментВремениОснование,
	|			&МоментВремени,
	|			Период,
	|			Счет = &Счет,
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета";
	
	Если ЗначениеЗаполнено(Субконто1) Тогда
		ТекстЗапроса = ТекстЗапроса + "	
		|				И Субконто1 = &Субконто1";
		Запрос.УстановитьПараметр("Субконто1", Субконто1);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Субконто2) Тогда
		ТекстЗапроса = ТекстЗапроса + "	
		|				И Субконто2 = &Субконто2";
		Запрос.УстановитьПараметр("Субконто2", Субконто2);
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(Субконто3) Тогда
		ТекстЗапроса = ТекстЗапроса + "		
		|				И Субконто3 = &Субконто3";
		Запрос.УстановитьПараметр("Субконто3", Субконто3);
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + ") КАК БухгалтерскийУчетОбороты";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("МоментВремениОснование", Новый Граница(ОснованиеПлатежа.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Сумма", Выборка.Сумма);
		Результат.Вставить("ВалютнаяСуммаДт", Выборка.ВалютнаяСуммаДт);
		Результат.Вставить("ВалютнаяСуммаКт", Выборка.ВалютнаяСуммаКт);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Для ПИФ УКПИ с апреля 2021 
Процедура НачислитьЗадолженностьКупонаДляОбратногоРЕПО(ПогашениеКупона, СуммаКупона, ВалютаЗадолженностиПоКупону, УчетныйРегистр, Отказ)
	
	//Начислим задолженность по возвратному купону в сумме оплаты, если уже оплачен купон по собственным бумагам, а также зачтенный купон.
	Запрос = Новый Запрос;
	запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК ПогашениеКупона,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КупонНачислено,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КупонОплачено
		|ПОМЕСТИТЬ _РасчетыПоКупону
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание = &ПогашениеКупона
		|	И ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|	И ЗадолженностиПоДенежнымСредствам.СуммаКупона > 0
		|	И ЗадолженностиПоДенежнымСредствам.МоментВремени < &МоментВремени
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РасчетыПоКупону.ПогашениеКупона КАК ПогашениеКупона,
		|	ЗадолженностиПоДенежнымСредствамПоВозврату.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамПоВозврату.Основание КАК Основание,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамПоВозврату.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					И ЗадолженностиПоДенежнымСредствамПоВозврату.СуммаКупона > 0
		|				ТОГДА ЗадолженностиПоДенежнымСредствамПоВозврату.СуммаКупона
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВозвратныйКупонНачислено
		|ПОМЕСТИТЬ _ВозвратныйКупонНачислено
		|ИЗ
		|	_РасчетыПоКупону КАК _РасчетыПоКупону
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствамПоВозврату
		|		ПО _РасчетыПоКупону.ПогашениеКупона = ЗадолженностиПоДенежнымСредствамПоВозврату.Регистратор
		|			И (ЗадолженностиПоДенежнымСредствамПоВозврату.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода))
		|			И (ЗадолженностиПоДенежнымСредствамПоВозврату.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская))
		|			И (ЗадолженностиПоДенежнымСредствамПоВозврату.МоментВремени < &МоментВремени)
		|
		|СГРУППИРОВАТЬ ПО
		|	_РасчетыПоКупону.ПогашениеКупона,
		|	ЗадолженностиПоДенежнымСредствамПоВозврату.Контрагент,
		|	ЗадолженностиПоДенежнымСредствамПоВозврату.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВозвратныйКупонНачислено.Основание КАК Основание,
		|	_ВозвратныйКупонНачислено.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток, 0) КАК ВозвратныйКупонОстаток,
		|	_ВозвратныйКупонНачислено.ВозвратныйКупонНачислено КАК ВозвратныйКупонНачислено,
		|	_ВозвратныйКупонНачислено.ПогашениеКупона КАК ПогашениеКупона
		|ПОМЕСТИТЬ _ВозвратныйКупон
		|ИЗ
		|	_ВозвратныйКупонНачислено КАК _ВозвратныйКупонНачислено
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&МоментВремени,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Основание В
		|						(ВЫБРАТЬ
		|							_ВозвратныйКупонНачислено.Основание КАК Основание
		|						ИЗ
		|							_ВозвратныйКупонНачислено КАК _ВозвратныйКупонНачислено)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО _ВозвратныйКупонНачислено.Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РасчетыПоКупону.ПогашениеКупона КАК ПогашениеКупона,
		|	_РасчетыПоКупону.КупонНачислено КАК КупонНачислено,
		|	_РасчетыПоКупону.КупонОплачено КАК КупонОплачено,
		|	СУММА(ЕСТЬNULL(_ВозвратныйКупон.ВозвратныйКупонОстаток, 0)) КАК ВозвратныйКупонОстаток,
		|	СУММА(ЕСТЬNULL(_ВозвратныйКупон.ВозвратныйКупонНачислено, 0)) КАК ВозвратныйКупонНачислено
		|ИЗ
		|	_РасчетыПоКупону КАК _РасчетыПоКупону
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВозвратныйКупон КАК _ВозвратныйКупон
		|		ПО _РасчетыПоКупону.ПогашениеКупона = _ВозвратныйКупон.ПогашениеКупона
		|
		|СГРУППИРОВАТЬ ПО
		|	_РасчетыПоКупону.ПогашениеКупона,
		|	_РасчетыПоКупону.КупонНачислено,
		|	_РасчетыПоКупону.КупонОплачено
		|";
	
	Запрос.УстановитьПараметр("ПогашениеКупона", ПогашениеКупона);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("МоментВремени", ЭтотОбъект.МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если НЕ ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не обнаружено начисления купонов по документу " + ПогашениеКупона, ЭтотОбъект.Ссылка,,, Отказ);
		Возврат;
	КонецЕсли;
	
	//на начало документа
	НачисленоКупонаПоСобственнымБумагам = ВыборкаДетальныеЗаписи.КупонНачислено - ВыборкаДетальныеЗаписи.ВозвратныйКупонНачислено;
	ОстатокЗадолженностиКупонаПоСобственнымБумагам = Макс(НачисленоКупонаПоСобственнымБумагам - ВыборкаДетальныеЗаписи.КупонОплачено, 0);
	ОстатокВозвратногоКупонаОбщий = ВыборкаДетальныеЗаписи.ВозвратныйКупонОстаток;
	ВозвращенныйКупон = ВыборкаДетальныеЗаписи.ВозвратныйКупонНачислено - ОСтатокВозвратногоКупонаОбщий;//уже есть проводка
	ОплаченныйЭмитентомВозвратныйКупон = Макс(ВыборкаДетальныеЗаписи.КупонОплачено - НачисленоКупонаПоСобственнымБумагам - ВозвращенныйКупон, 0);
	ОстатокЗадолженностиНеоплаченногоЭмитентомВозвратногоКупона = ВыборкаДетальныеЗаписи.ВозвратныйКупонНачислено - ВозвращенныйКупон - ОплаченныйЭмитентомВозвратныйКупон;//на эту сумму нужна проводка, если денег хватит
	//по документу
	СуммаПроводокВозвратногоКупона = Макс(СуммаКупона - ОстатокЗадолженностиКупонаПоСобственнымБумагам - ВозвращенныйКупон, 0);
	
	Если СуммаПроводокВозвратногоКупона > 0 Тогда
		
		ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
		ВалютаНоминала 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПогашениеКупона.Облигация, "ВалютаНоминала");
		
		Если ВалютаНоминала  <> ВалютаУчета Тогда
			СчетВозвратногоКупона = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
			СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации;
		Иначе
			СчетВозвратногоКупона = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
			СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупона;
		КонецЕсли;	
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	_ВозвратныйКупон.Контрагент КАК Контрагент,
		|	СУММА(_ВозвратныйКупон.ВозвратныйКупонОстаток) КАК ВозвратныйКупонОстаток
		|ИЗ
		|	_ВозвратныйКупон КАК _ВозвратныйКупон
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВозвратныйКупон.Контрагент";
		
		РезультатЗапроса = Запрос.Выполнить();
	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СуммаПроводкиВал = Окр(СуммаПроводокВозвратногоКупона * ВыборкаДетальныеЗаписи.ВозвратныйКупонОстаток / ОстатокВозвратногоКупонаОбщий, 2);
			СуммаПроводки = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПроводкиВал, ВалютаЗадолженностиПоКупону, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ); 
			
			СуммаПроводокВозвратногоКупона = СуммаПроводокВозвратногоКупона - СуммаПроводкиВал;
			ОстатокВозвратногоКупонаОбщий = ОстатокВозвратногоКупонаОбщий - ВыборкаДетальныеЗаписи.ВозвратныйКупонОстаток;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПроводки, "Начислена задолженность по возвратному купону");
			
			Проводка.СчетДт = СчетПогашениеКупона;
			Проводка.СубконтоДт.Облигации = ПогашениеКупона.Облигация;
			
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютаДт = ВалютаЗадолженностиПоКупону;
				Проводка.ВалютнаяСуммаДт = СуммаПроводкиВал;
			КонецЕсли;
			
			Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
				Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеКупона;
			КонецЕсли;									
			
			Проводка.СчетКт = СчетВозвратногоКупона;
			Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			
			Если Проводка.СчетКт.Валютный Тогда
				Проводка.ВалютаКт = ВалютаЗадолженностиПоКупону;
				Проводка.ВалютнаяСуммаКт = СуммаПроводкиВал;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗакрытьНакопленныеДоходыРасходыПоПродажам(МассивУчетныхАктивов, МассивЦенныхБумаг) 
	//закрываем доходы/расходы по текущему документу в зависимости от закрытия по ЦБ
	
	ЭтотОбъект.Движения.НакопленныеДоходыИРасходыКСписаниюПриПродажеЕПС.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона) КАК СуммаОплатыТекущая
		|ПОМЕСТИТЬ ОплатаТекущая
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор = &Регистратор
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствам.Основание КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание КАК Основание,
		|	СУММА(ЗадолженностиПоЦеннымБумагамОбороты.СуммаРасход + ЗадолженностиПоЦеннымБумагамОбороты.СуммаКупонаРасход) КАК СуммаПоставки
		|ПОМЕСТИТЬ ПоставкиПоСделкам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Обороты(
		|			,
