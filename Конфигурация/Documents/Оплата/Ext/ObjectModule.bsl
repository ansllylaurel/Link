				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Если Выборка.СуммаОстаток = 0 Тогда
					
						Если СтрокаОснование.Основание.Валюта = ЭтотОбъект.Организация.ВалютаУчета Тогда
							СуммаСделкиВВалютеУчета = СтрокаОснование.Основание.Сумма;
