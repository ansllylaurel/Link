							Проводка.ВалютаДт = СтрокаОснование.Основание.Контрвалюта;
							Проводка.ВалютнаяСуммаДт = СтрокаОснование.Основание.СуммаКонтрвалюты;
						КонецЕсли;
						
						// кредит
						Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
						
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
						Проводка.СубконтоКт.ОснованиеРасчетов = СтрокаОснование.Основание;
						
