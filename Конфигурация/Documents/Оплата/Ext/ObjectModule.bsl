				Запрос.УстановитьПараметр("МоментНачалаОборотов", Новый Граница(СтрокаОснование.Основание.МоментВремени(),ВидГраницы.Исключая));
				Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ЭтотОбъект.МоментВремени(),ВидГраницы.Исключая));
				Запрос.УстановитьПараметр("Сделка", СтрокаОснование.Основание);
				
				Если Запрос.Выполнить().Пустой() Тогда // ни оплат, ни поставок не было
					БухгалтерскийУчетЕПС.СформироватьПроводкиНачалаСделки(ЭтотОбъект, СтрокаОснование.Основание, КонтрагентПоСделке, СтрокаОснование.Основание.Дата, СтрокаОснование.Валюта, СтрокаОснование.Сумма + СтрокаОснование.СуммаКупона, Ложь, , НастройкиУчета , Отказ);
				КонецЕсли;
				
				ПараметрыОплаты = Новый Структура("Сделка, СуммаТела, СуммаКупона, ВалютаСделки, "
					+ "СуммаТелаДС, СуммаКупонаДС, ВалютаОплаты, "
					+ "Контрагент, СчетДС, СубконтоДС, ВидСубконтоДС",
