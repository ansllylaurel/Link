							Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
								ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияРЕПО;
