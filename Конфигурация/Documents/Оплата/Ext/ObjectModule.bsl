						ПроводкаНачисления.СубконтоКт.Контрагенты = Проводка.СубконтоДт.Контрагенты;
					КонецЕсли;
					
					Если ЕстьСубконтоСделки Тогда
						ПроводкаНачисления.СубконтоКт.Сделка = СтрокаОснование.Основание;
					КонецЕсли;
					
