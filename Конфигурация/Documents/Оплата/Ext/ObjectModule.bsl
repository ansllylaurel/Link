					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоАкциям;
				ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи Тогда
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоПаям;
				ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия Тогда
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоИпотечнымСертификатамУчастия;
				ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюРаспределяемойПрибылиООО Тогда //никогда не было
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления; 
				ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки Тогда	
					ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоДепозитарнымРаспискам;
				КонецЕсли;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = ВидДвиженияДенежныхСредств;
			КонецЕсли;
			
			Если СчетУчетаДС.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = СтрокаОснование.СуммаОплаты;
				ПРоводка.ВалютаДт = ВалютаОплаты;
			КонецЕсли;
			
			УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаОснование.Основание.Рынок, СтрокаОснование.Основание.ЦеннаяБумага);
			ДанныеУчетаДивидендов = БухгалтерскийУчет.ОпределитьДанныеУчетаДивидендов(СтрокаОснование.Основание.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, УчетныйАктив);
			
			Если ДанныеУчетаДивидендов.СчетУчетаДивидендов = ПланыСчетов.Основной.ПустаяСсылка() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента не счет учета дивидендов", ЭтотОбъект, "СчетДоверительногоУправления",, Отказ);
				Возврат;
			КонецЕсли;
			
			Если (ДанныеУчетаДивидендов.СпособОтраженияДивидендов = Перечисления.СпособыОтраженияДивидендов.ОтражатьДатойОплаты) 
				И (НЕ ДанныеУчетаДивидендов.ВыделятьНалогПоДивидендам) Тогда
				// Кредит
				
				АналитикаДоходов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				УчетныйРегистр,
				"АналитикаДоходов");		
				
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
				Проводка.СубконтоКт.ЦенныеБумаги         = СтрокаОснование.Основание.ЦеннаяБумага;
				Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			Иначе
				// Кредит
				Проводка.СчетКт = ДанныеУчетаДивидендов.СчетУчетаДивидендов;		
				Если (ДанныеУчетаДивидендов.СчетУчетаДивидендов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено) Тогда
					Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
				КонецЕсли;
				Если ДанныеУчетаДивидендов.СчетУчетаДивидендов.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.Сумма;
					Проводка.ВалютаКт = СтрокаОснование.Валюта;
				КонецЕсли;
			КонецЕсли; 
			
			Если (ДанныеУчетаДивидендов.ВыделятьНалогПоДивидендам) И (ЭтотОбъект.ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоНачислениюРаспределяемойПрибылиООО) Тогда
				СуммаНалога = СтрокаОснование.Основание.Сумма - СтрокаОснование.СуммаОплаты;
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаНалога, ВалютаОплаты, Организация, Дата, Отказ), "Удержание налога");
				
				АналитикаНалогов = Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Налог с дивидендов"); // сделать настройку		
								
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаНалогов;
				Проводка.СубконтоДт.ЦенныеБумаги         = СтрокаОснование.Основание.ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				
				Проводка.СчетКт = ДанныеУчетаДивидендов.СчетУчетаДивидендов;		
				Если (ДанныеУчетаДивидендов.СчетУчетаДивидендов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено) Тогда
					Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
				КонецЕсли;
				Если ДанныеУчетаДивидендов.СчетУчетаДивидендов.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.Сумма;
					Проводка.ВалютаКт = СтрокаОснование.Валюта;
				КонецЕсли;
				
	
			КонецЕсли;	
			
			
		КонецЦикла;
		
	#КонецОбласти	
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке 
		ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВкладуВУставныйКапиталООО Тогда
		
	#Область ПоСделке
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
				
				#Область СделкаСВалютой
				
				СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, СтрокаОснование.Основание.Брокер, ЭтотОбъект.Дата);
				
				//курсовую разницу формируем только если оплата по контрвалюте.
				ВалютаКурсовойРазницы = ?(СтрокаОснование.Основание.Валюта = ЭтотОбъект.Организация.ВалютаУчета, СтрокаОснование.Основание.Контрвалюта, СтрокаОснование.Основание.Валюта);
				
				Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				
					Если СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					
						Валюта = СтрокаОснование.Основание.Валюта;	
						Сумма = СтрокаОснование.Сумма;
						СуммаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						РасчетныйСчет = СтрокаОснование.Основание.РасчетныйСчет;
						
						Контрвалюта = СтрокаОснование.Основание.Контрвалюта;
						КоэффициентПересчета = СтрокаОснование.Основание.СуммаКонтрвалюты / СтрокаОснование.Основание.Сумма;
						СуммаКонтрвалюты = СтрокаОснование.Сумма * КоэффициентПересчета;
						
						СуммаКонтрвалюты = СуммаКонтрвалюты + ПолучитьПогрешностьПрошедшихОплат(ЭтотОбъект.ВидДвижения, СтрокаОснование.Основание, КоэффициентПересчета);
						
						СуммаКонтрвалютыВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКонтрвалюты, Контрвалюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						Если ВалютаКурсовойРазницы = ЭтотОбъект.ВалютаОплаты Тогда
							КурсоваяРазница = 0;
						Иначе
							КурсоваяРазница = СуммаКонтрвалютыВВалютеУчета - СуммаВВалютеУчета;
						КонецЕсли;
						
					Иначе
					
						Валюта = СтрокаОснование.Основание.Контрвалюта;	
						Сумма = СтрокаОснование.Сумма;
						СуммаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						РасчетныйСчет = СтрокаОснование.Основание.РасчетныйСчетКонтрвалюты;
					
						Контрвалюта = СтрокаОснование.Основание.Валюта;
						КоэффициентПересчета = СтрокаОснование.Основание.Сумма / СтрокаОснование.Основание.СуммаКонтрвалюты;
						
						СуммаКонтрвалюты = СтрокаОснование.Сумма * КоэффициентПересчета;
						
						СуммаКонтрвалюты = СуммаКонтрвалюты + ПолучитьПогрешностьПрошедшихОплат(ЭтотОбъект.ВидДвижения, СтрокаОснование.Основание, КоэффициентПересчета);
						
						СуммаКонтрвалютыВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКонтрвалюты, Контрвалюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						Если ВалютаКурсовойРазницы = ЭтотОбъект.ВалютаОплаты Тогда
							КурсоваяРазница = 0;
						Иначе
							КурсоваяРазница = СуммаКонтрвалютыВВалютеУчета - СуммаВВалютеУчета;
						КонецЕсли;
						
					КонецЕсли;
					
					СчетУчетаВалюты = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						Валюта,
						СтрокаОснование.Основание.Брокер);
						
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВВалютеУчета, "Сделка с валютой");
					
					// дебет	
					Проводка.СчетДт = СчетУчетаВалюты;
					
					Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
						Проводка.СубконтоДт.БанковскиеСчета                 = РасчетныйСчет;
					КонецЕсли;	

					Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
						Проводка.СубконтоДт.БрокерскиеКомпании              = СтрокаОснование.Основание.Брокер;
					КонецЕсли;
										
					Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
						Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
					КонецЕсли;
					
					Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
						Проводка.СубконтоДт.ВидДвиженияДенежныхСредств              = Справочники.ВидыДвиженияДенежныхСредств.КонверсионнаяОперация;
					КонецЕсли;
										
					Если Валюта <> ЭтотОбъект.Организация.ВалютаУчета Тогда
						Проводка.ВалютаДт        = Валюта;
						Проводка.ВалютнаяСуммаДт = Сумма;
					КонецЕсли;
					
					// кредит	
					Проводка.СчетКт = ПланыСчетов.Основной.ПереводыВПутиВВалюте;
					Проводка.ВалютаКт  = ВалютаКурсовойРазницы;
					Если СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
						Проводка.ВалютнаяСуммаКт = Сумма;
					Иначе
						Проводка.ВалютнаяСуммаКт  = СуммаКонтрвалюты;
					КонецЕсли;
					
				Иначе
					
					Если СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
					
						Валюта = СтрокаОснование.Основание.Контрвалюта;	
						Сумма = СтрокаОснование.Сумма;
						СуммаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						РасчетныйСчет = СтрокаОснование.Основание.РасчетныйСчетКонтрвалюты;
					
						Контрвалюта = СтрокаОснование.Основание.Валюта;
						СуммаКонтрвалюты = СтрокаОснование.Основание.Сумма / СтрокаОснование.Основание.СуммаКонтрвалюты * СтрокаОснование.Сумма;
						СуммаКонтрвалютыВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКонтрвалюты, Контрвалюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						Если ВалютаКурсовойРазницы = ЭтотОбъект.ВалютаОплаты Тогда
							КурсоваяРазница = 0;
						Иначе
							КурсоваяРазница = СуммаВВалютеУчета - СуммаКонтрвалютыВВалютеУчета;
						КонецЕсли;
						
					Иначе
					
						Валюта = СтрокаОснование.Основание.Валюта;	
						Сумма = СтрокаОснование.Сумма;
						СуммаВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						РасчетныйСчет = СтрокаОснование.Основание.РасчетныйСчет;
						
						Контрвалюта = СтрокаОснование.Основание.Контрвалюта;
						СуммаКонтрвалюты = СтрокаОснование.Основание.СуммаКонтрвалюты / СтрокаОснование.Основание.Сумма * СтрокаОснование.Сумма;
						СуммаКонтрвалютыВВалютеУчета = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКонтрвалюты, Контрвалюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата), 2);
						
						Если ВалютаКурсовойРазницы = ЭтотОбъект.ВалютаОплаты Тогда
							КурсоваяРазница = 0;
						Иначе
							КурсоваяРазница = СуммаВВалютеУчета - СуммаКонтрвалютыВВалютеУчета;
						КонецЕсли;
					КонецЕсли;
					
					СчетУчетаВалюты = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						Валюта,
						СтрокаОснование.Основание.Брокер);
						
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВВалютеУчета, "Сделка с валютой");
					
					// дебет	
					Проводка.СчетДт = ПланыСчетов.Основной.ПереводыВПутиВВалюте;
					Проводка.ВалютаДт  = ВалютаКурсовойРазницы;
					Если СтрокаОснование.Основание.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
						Проводка.ВалютнаяСуммаДт = СуммаКонтрвалюты;
					Иначе
						Проводка.ВалютнаяСуммаДт = Сумма;
					КонецЕсли;
					
					// кредит	
					Проводка.СчетКт = СчетУчетаВалюты;
					
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					    Проводка.СубконтоКт.БанковскиеСчета                 = РасчетныйСчет;

					КонецЕсли;
					//удалить
					Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
						Проводка.СубконтоКт.БрокерскиеКомпании              = СтрокаОснование.Основание.Брокер;
