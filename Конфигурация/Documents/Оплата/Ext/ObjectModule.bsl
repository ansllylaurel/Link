				БухгалтерскийУчетЕПС.СформироватьПроводкиОплатыПоСделке(ЭтотОбъект, ПараметрыОплаты, Отказ);
				
			ИначеЕсли ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
				
				Если СтрокаОснование.Основание.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
					КонтрагентПоСделке = СтрокаОснование.Основание.РасчетныйСчет.Банк.ЮрФизЛицо;	
