				КонецЕсли;
				
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.Сумма, СтрокаОснование.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				
				КурсоваяРазница = СуммаОперации - СуммаОперацииПоСделке;
				
