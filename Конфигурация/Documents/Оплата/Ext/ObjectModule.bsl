			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПогашениеОблигации;
			
			Проводка.ВалютаДт = ЭтотОбъект.ВалютаОплаты;
			Проводка.ВалютнаяСуммаДт = СтрокаОснования.СуммаКупона;
			
			// кредит
			Если ТипЗнч(СтрокаОснования.Основание) = Тип("ДокументСсылка.ВводЦенныхБумаг") И ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				ЦеннаяБумага = БухгалтерскийУчетЕПС.ПолучитьЦеннуюБумагуПриОплатеПогашенияПоВводу(ЭтотОбъект, СтрокаОснования.Основание, ЭтотОбъект.Контрагент, ЭтотОбъект.ВидЗадолженности, Отказ);
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
					|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчета КАК СчетУчета
					|ИЗ
					|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
					|ГДЕ
					|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
					|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага";
				
				Запрос.УстановитьПараметр("Регистратор", СтрокаОснования.Основание);
				Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					СчетУчетаУчетногоАктиваЕПС = ВыборкаДетальныеЗаписи.СчетУчета;
					Прервать;
				КонецЦикла;

				Проводка.СчетКт = СчетУчетаУчетногоАктиваЕПС;
			
				Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаКт = СтрокаОснования.СуммаКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоОблигации;
			Иначе
				
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
			
				Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов = СтрокаОснования.Основание;				
				
				Проводка.ВалютаКт = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаКт = СтрокаОснования.СуммаКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоОблигации;
				
			КонецЕсли;
		КонецЦикла;
		
		// закроем начисленные резервы
		Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда

			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
			НастройкиУчетаПогашениеКупона = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйАктив, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
			Если НастройкиУчетаПогашениеКупона.СписыватьРезервОКУНаДатуПрекращенияПризнания Тогда
				
				СчетУчетаРезервов = ПланыСчетов.Единый.Расчеты25;
				
				АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
				
				СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
				
				БухгалтерскийУчетЕПС.СформироватьДвиженияПоЗакрытиюРезервовОКУ(ЭтотОбъект, СчетУчетаРезервов, ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов, СчетДоходов, АналитикаСписанияРезервов, Движения.ЕдиныйБухгалтерскийУчет);
				
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств И ЭтотОбъект.Дата > БухгалтерскийУчетЕПС.ДатаВключенияЗакрытия7гоРазделаПоРезервам() Тогда
					
					Для каждого СтрокаОснования Из ЭтотОбъект.Основания Цикл
					
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПрочиеДоходыРасходы01, СтрокаОснования.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ПрочиеДоходыРасходы02, СтрокаОснования.Основание, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
						
						Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
							
							ОблигацияДля7Раздела = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснования.Основание, "ЦеннаяБумага");
							
							БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам01, ОблигацияДля7Раздела, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
							БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыПоРезервам02, ОблигацияДля7Раздела, ЭтотОбъект.ВалютаОплаты, "Закрытие резервов", ЭтотОбъект.Дата,,,,, Истина);
						
						КонецЕсли;
					
					КонецЦикла;
				
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации) И Закрывать7ойРазделПриПоступленииДенежныхСредств  Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
			|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток * БухПартииЦенныхБумаг.ДисконтПремияНачисленный / БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК СуммаДисконта,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов КАК АналитикаПроцентныхДоходов,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
			|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток) КАК ДисконтПремияНачисленныйСНачалаГодаОстаток,
			|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
			|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|				&Период,
			|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|					И Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета) КАК БухПартииЦенныхБумагОстатки
			|		ПО БухПартииЦенныхБумаг.Рынок = БухПартииЦенныхБумагОстатки.Рынок
			|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
			|			И БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
			|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
			|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
			|ГДЕ
			|	БухПартииЦенныхБумаг.Регистратор В(&СписокРегистраторов)
			|	И БухПартииЦенныхБумаг.ДисконтПремияНачисленный <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумаг.ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала";
			
			Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления"	, ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			Запрос.УстановитьПараметр("СписокРегистраторов"				, ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));
			Запрос.УстановитьПараметр("Период"							, Новый Граница(ЭтотОбъект.Основания[0].Основание.Дата, ВидГраницы.Исключая));
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				// закрываем только если что-то уходило с того дисконта что был начислен в этом году
				ДисконтПремияНачисленныйНаНачалоГода = Выборка.ДисконтПремияНачисленныйОстаток - Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток;
				Если ДисконтПремияНачисленныйНаНачалоГода < Выборка.ДисконтПремияНачисленный Тогда // списали больше того, что было начислено на начало, значит закрываем
					НужноЗакрытьДисконта = Выборка.ДисконтПремияНачисленный - ДисконтПремияНачисленныйНаНачалоГода;
					Если НужноЗакрытьДисконта > Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток Тогда // а вдруг
						НужноЗакрытьДисконта = Выборка.ДисконтПремияНачисленныйСНачалаГодаОстаток;
					КонецЕсли;
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, 
																								ПланыСчетов.Единый.ПроцентныеДоходы01, 
																								Выборка.ЦеннаяБумага, 
																								Выборка.АналитикаПроцентныхДоходов, 
																								Выборка.ВалютаНоминала, 
																								"Закрытие доначисления по дисконту", 
																								Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт, 
																								-НужноЗакрытьДисконта);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюИпотечногоСертификатаУчастия Тогда
		
		БухгалтерскийУчетЕПС.СформироватьПроводкиСписанияЦеннойБумаги(УчетныйРегистр, ЭтотОбъект, Отказ);
		
		ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов 	= БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
		АналитикаДебиторкиПоПогашениею 					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;

		// читаем движения партий
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость + БухПартииЦенныхБумаг.Переоценка) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаСНачалаГода) КАК ПереоценкаСНачалаГода,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаСНачалаГодаПоложительная) КАК ПереоценкаСНачалаГодаПоложительная,
		|	ОплатаОснования.Валюта КАК Валюта,
		|	ОплатаОснования.Основание КАК Основание,
		|	ОплатаОснования.Сумма КАК СуммаОплаты,
		|	ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).Сумма КАК СуммаПогашения
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ПО ОплатаОснования.Основание = БухПартииЦенныхБумаг.Регистратор
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	ОплатаОснования.Валюта,
		|	ОплатаОснования.Сумма,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	ОплатаОснования.Основание";
		
		Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период",	Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ПредыдущийУчетныйАктив = "";
		ПредыдущаяЦеннаяБумага = "";

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ИСУ		 		= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			УчетныйАктив 	= ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			
			Если ИСУ = ПредыдущаяЦеннаяБумага и УчетныйАктив <> ПредыдущийУчетныйАктив Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Распределение по нескольким учетным активам в рамках одного погашения не отработано " + ВыборкаДетальныеЗаписи.Основание, ЭтотОбъект,,, Отказ);
			Иначе
				ПредыдущаяЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				ПредыдущийУчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			КонецЕсли; 
			
			СуммаОперации 	= ВыборкаДетальныеЗаписи.СуммаОплаты;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Погашение ИСУ");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоПаям;
			
			Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаОперации;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоКт.Контрагенты = ИСУ.Эмитент.ЮрФизЛицо;
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Основание;
			
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаКт = СуммаОперации;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоПогашениею;
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
				
				Если НастройкиУчета.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки Тогда
					
					Если ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная > 0 Тогда
					
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
							ЭтотОбъект, 
							УчетныйАктив.СчетУчетаДоходовОтОпераций, 
							ИСУ, 
							УчетныйАктив.АналитикаДоходовОтОпераций, 
							ИСУ.ВалютаНоминала, 
							"Закрытие переоценки", 
							, 
							ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная);
					
					КонецЕсли;
					
					Если ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода - ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная < 0 Тогда
					
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
							ЭтотОбъект, 
							УчетныйАктив.СчетУчетаРасходовОтОпераций, 
							ИСУ, 
							УчетныйАктив.АналитикаРасходовОтОпераций, 
							ИСУ.ВалютаНоминала, 
							"Закрытие переоценки", 
							, 
							ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода - ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная);
					
					КонецЕсли;
					
				Иначе
					
					СуммаЗакрытияПереоценки = ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода;
					
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
						ЭтотОбъект, 
						УчетныйАктив.СчетУчетаДоходовОтОпераций, 
						ИСУ, 
						УчетныйАктив.АналитикаДоходовОтОпераций, 
						ИСУ.ВалютаНоминала, 
						"Закрытие переоценки", 
						, 
						СуммаЗакрытияПереоценки);
					
				КонецЕсли;
					
				СуммаЗакрытияДоходаОтПогашения = ВыборкаДетальныеЗаписи.Стоимость - ВыборкаДетальныеЗаписи.СуммаОплаты;
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
					ЭтотОбъект, 
					УчетныйАктив.СчетУчетаДоходовОтОпераций, 
					ИСУ, 
					УчетныйАктив.АналитикаДоходовОтОпераций, 
					ИСУ.ВалютаНоминала, 
					"Закрытие переоценки", 
					, 
					СуммаЗакрытияДоходаОтПогашения);
					
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюПая Тогда
		
		ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов 	= БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
		АналитикаДебиторкиПоПогашениею 					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;

		// читаем движения партий
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Основание КАК Основание,
		|	ОплатаОснования.Валюта КАК Валюта,
		|	ОплатаОснования.Сумма КАК Сумма
		|ПОМЕСТИТЬ _Основания
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СписаниеЦеннойБумаги.Ссылка КАК Ссылка,
		|	СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|ПОМЕСТИТЬ _Списания
		|ИЗ
		|	_Основания КАК _Основания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
		|		ПО _Основания.Основание = СписаниеЦеннойБумаги.ПогашениеЦеннойБумаги
		|			И (СписаниеЦеннойБумаги.Дата <= &ДатаОплаты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Списания.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаСНачалаГода) КАК ПереоценкаСНачалаГода,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаСНачалаГодаПоложительная) КАК ПереоценкаСНачалаГодаПоложительная
		|ПОМЕСТИТЬ _ДвиженияСписаний
		|ИЗ
		|	_Списания КАК _Списания
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ПО _Списания.Ссылка = БухПартииЦенныхБумаг.Регистратор
		|			И (БухПартииЦенныхБумаг.ВидУчета = &ВидУчета)
		|			И (БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|
		|СГРУППИРОВАТЬ ПО
		|	_Списания.ПогашениеЦеннойБумаги,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияСписаний.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияСписаний.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_ДвиженияСписаний.Стоимость + _ДвиженияСписаний.Переоценка) КАК Стоимость,
		|	СУММА(_ДвиженияСписаний.ПереоценкаСНачалаГода) КАК ПереоценкаСНачалаГода,
		|	СУММА(_ДвиженияСписаний.ПереоценкаСНачалаГодаПоложительная) КАК ПереоценкаСНачалаГодаПоложительная,
		|	_Основания.Валюта КАК Валюта,
		|	_Основания.Основание КАК Основание,
		|	_Основания.Сумма КАК СуммаОплаты
		|ИЗ
		|	_Основания КАК _Основания
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДвиженияСписаний КАК _ДвиженияСписаний
		|		ПО _Основания.Основание = _ДвиженияСписаний.ПогашениеЦеннойБумаги
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияСписаний.УчетныйАктивЕПС,
		|	_Основания.Валюта,
		|	_Основания.Сумма,
		|	_ДвиженияСписаний.ЦеннаяБумага,
		|	_Основания.Основание";
		
		Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ДатаОплаты", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("Период",	Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ПредыдущийУчетныйАктив = "";
		ПредыдущаяЦеннаяБумага = "";

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ЦеннаяБумага	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			УчетныйАктив 	= ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			
			Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
				УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ЭтотОбъект.Дата, ЦеннаяБумага);
				КонтрагентПогашения 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо"); 
			Иначе
				КонтрагентПогашения 			= ЦеннаяБумага.Эмитент.ЮрФизЛицо; 
			КонецЕсли;
			
			Если ЦеннаяБумага = ПредыдущаяЦеннаяБумага и УчетныйАктив <> ПредыдущийУчетныйАктив Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Распределение по нескольким учетным активам в рамках одного погашения не отработано " + ВыборкаДетальныеЗаписи.Основание, ЭтотОбъект,,, Отказ);
			Иначе
				ПредыдущаяЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				ПредыдущийУчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			КонецЕсли; 
			
			СуммаОперации 	= ВыборкаДетальныеЗаписи.СуммаОплаты;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Погашение ценной бумаги");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоПаям;
			
			Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаОперации;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
			Если НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении <> Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408 Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты23;
			КонецЕсли;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПогашения;
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Основание;
			
			Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаКт = СуммаОперации;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоПогашениею;
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
				
				Если НастройкиУчета.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки Тогда
					
					Если ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная > 0 Тогда
					
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
							ЭтотОбъект, 
							УчетныйАктив.СчетУчетаДоходовОтОпераций, 
							ИСУ, 
							УчетныйАктив.АналитикаДоходовОтОпераций, 
							ИСУ.ВалютаНоминала, 
							"Закрытие переоценки", 
							, 
							ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная);
					
					КонецЕсли;
					
					Если ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода - ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная < 0 Тогда
					
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
							ЭтотОбъект, 
							УчетныйАктив.СчетУчетаРасходовОтОпераций, 
							ИСУ, 
							УчетныйАктив.АналитикаРасходовОтОпераций, 
							ИСУ.ВалютаНоминала, 
							"Закрытие переоценки", 
							, 
							ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода - ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГодаПоложительная);
					
					КонецЕсли;
					
				Иначе
					
					СуммаЗакрытияПереоценки = ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода;
					
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
						ЭтотОбъект, 
						УчетныйАктив.СчетУчетаДоходовОтОпераций, 
						ЦеннаяБумага, 
						УчетныйАктив.АналитикаДоходовОтОпераций, 
						ЦеннаяБумага.ВалютаНоминала, 
						"Закрытие переоценки", 
						, 
						СуммаЗакрытияПереоценки);
					
				КонецЕсли;
				
					
					
				СуммаЗакрытияДоходаОтПогашения = ВыборкаДетальныеЗаписи.Стоимость - ВыборкаДетальныеЗаписи.СуммаОплаты;
				
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
					ЭтотОбъект, 
					УчетныйАктив.СчетУчетаДоходовОтОпераций, 
					ЦеннаяБумага, 
					УчетныйАктив.АналитикаДоходовОтОпераций, 
					ЦеннаяБумага.ВалютаНоминала, 
					"Закрытие переоценки", 
					, 
					СуммаЗакрытияДоходаОтПогашения);
					
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции 
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия Тогда
		
		МассивУчетныхАктивов = Новый Массив;
		МассивЦенныхБумаг = Новый Массив;
		
		Для Каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, СтрокаОснование.Основание.Рынок, СтрокаОснование.Основание.ЦеннаяБумага);
			
			НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
				СтрокаОснование.Основание.Дата, // проверяем настройки на момент начисления
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления);
			
			ЦеннаяБумага = СтрокаОснование.Основание.ЦеннаяБумага;
			
			Если МассивЦенныхБумаг.Найти(ЦеннаяБумага) = Неопределено Тогда
				МассивЦенныхБумаг.Добавить(ЦеннаяБумага);
			КонецЕсли;
			
			ТаблицаРаспределенияАктивовЕПС = Неопределено;
			БухгалтерскийУчетЕПС.ПолучитьРаспределениеУчетныхАктивовЕПСПоДивидендам(СтрокаОснование.Основание, ТаблицаРаспределенияАктивовЕПС);
			
			КоличествоОстаток = СтрокаОснование.Основание.Количество;
			
			СуммаРасчетнаяОстаток = СтрокаОснование.Основание.Сумма;
			СуммаПлатежаОстаток = СтрокаОснование.Сумма;
			СуммаОбъявленнаяОстаток = СтрокаОснование.Основание.СуммаОбъявленная;
			
			Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Акции") Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоАкциям;
			ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоПаям;
			ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитарныеРасписки") Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоДепозитарнымРаспискам;
			ИначеЕсли ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ИпотечныеСертификатыУчастия") Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоИпотечнымСертификатамУчастия;
			КонецЕсли;
			
			Для Каждого СтрокаТаблицаРаспределенияАктивовЕПС из ТаблицаРаспределенияАктивовЕПС Цикл
				
				УчетныйАктивЕПС = СтрокаТаблицаРаспределенияАктивовЕПС.УчетныйАктивЕПС;
				Если МассивУчетныхАктивов.Найти(УчетныйАктивЕПС) = Неопределено Тогда
					МассивУчетныхАктивов.Добавить(УчетныйАктивЕПС);
				КонецЕсли;
				
				СуммаПлатежа = Окр(СуммаПлатежаОстаток * СтрокаТаблицаРаспределенияАктивовЕПС.Количество / КоличествоОстаток, 2);
				СуммаПлатежаОстаток = СуммаПлатежаОстаток - СуммаПлатежа;
				
				СуммаОбъявленная = Окр(СуммаОбъявленнаяОстаток * СтрокаТаблицаРаспределенияАктивовЕПС.Количество / КоличествоОстаток, 2);
				СуммаОбъявленнаяОстаток = СуммаОбъявленнаяОстаток - СуммаОбъявленная;
				
				СуммаРасчетная = Окр(СуммаРасчетнаяОстаток * СтрокаТаблицаРаспределенияАктивовЕПС.Количество / КоличествоОстаток, 2);
				СуммаРасчетнаяОстаток = СуммаРасчетнаяОстаток - СуммаОбъявленная;
				
				// Согласно п. 6 ст. 52 НК РФ нужно округлять сумму налога
				ОжидаемаяСуммаНалога = Окр(СуммаОбъявленная - СуммаРасчетная);
				ФактическаяСуммаНалога = СуммаОбъявленная - СуммаПлатежа;
				
				КоличествоОстаток = КоличествоОстаток - СтрокаТаблицаРаспределенияАктивовЕПС.Количество;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПлатежа, "Поступление дивидендов");
				
				// дебет
				Проводка.СчетДт = СчетДС;
				
				Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
				
				Проводка.ВалютаДт  = СтрокаОснование.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаПлатежа;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами47;
				
				Если СтрокаОснование.Основание.Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
					УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ЭтотОбъект.Дата, СтрокаОснование.Основание.ЦеннаяБумага);
					Проводка.СубконтоКт.Контрагенты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
				Иначе		
			    	Проводка.СубконтоКт.Контрагенты = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
				КонецЕсли;
				Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаКт  = ЦеннаяБумага.ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = СуммаПлатежа;
				
				Если ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоИпотечнымСертификатамУчастия Тогда
					Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дивиденды;
				КонецЕсли;

				
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
				
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыОтОпераций05, ЦеннаяБумага, ЦеннаяБумага.ВалютаНоминала, "Закрытие доначисления по начислению дивидендов",,Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дивиденды,,УчетныйАктивЕПС.АналитикаДивидендов);
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыОтОпераций06, ЦеннаяБумага, ЦеннаяБумага.ВалютаНоминала, "Закрытие доначисления по начислению дивидендов",,,,УчетныйАктивЕПС.АналитикаДивидендов);
				
				КонецЕсли;
			
				
				//Удержание налога
				Если ФактическаяСуммаНалога > 0 Тогда
			
					СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ФактическаяСуммаНалога, ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Удержание налога");
					
					Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций06;
					
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
					Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
					
					
					Проводка.СчетКт = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами47;
						
					Проводка.СубконтоКт.Контрагенты = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
					Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
					
					Проводка.ВалютаКт  = ЦеннаяБумага.ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = ФактическаяСуммаНалога;
					
					Если ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ДоходПоИпотечнымСертификатамУчастия Тогда
						Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дивиденды;
					КонецЕсли;
					
					
					Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
						
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, ПланыСчетов.Единый.ДоходыРасходыОтОпераций06, ЦеннаяБумага, УчетныйАктивЕПС.АналитикаРасходовОтОпераций, ЦеннаяБумага.ВалютаНоминала, "Закрытие начисления по удержанию налога",, СуммаОперации);
						
					КонецЕсли;
					
				КонецЕсли; 
				
				Если НастройкиУчетаОбщие.НачислятьОбязательстваПоОплатеНалогаСДивидендов Тогда // для волги
				
					Если ФактическаяСуммаНалога > ОжидаемаяСуммаНалога Тогда
						
						//корректировка налога
						СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ФактическаяСуммаНалога - ОжидаемаяСуммаНалога, ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
						
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка резерва по налогу на дивиденды");
						
						
						Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности02;
							
						Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("55501");
						
						
						Проводка.СчетКт = ПланыСчетов.Единый.РезервыОценочныеОбязательстваНекредитногоХарактера;
						
						Проводка.СубконтоКт.Контрагенты = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
						Проводка.СубконтоКт.Резервы = Справочники.Резервы.ПоНалогуНаПрибыльСДивидендов;
						
					ИначеЕсли ФактическаяСуммаНалога < ОжидаемаяСуммаНалога Тогда
						
						//корректировка налога
						СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ОжидаемаяСуммаНалога - ФактическаяСуммаНалога, ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
						
						Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка резерва по налогу на дивиденды");
						
						
						Проводка.СчетДт = ПланыСчетов.Единый.РезервыОценочныеОбязательстваНекредитногоХарактера;
						
						Проводка.СубконтоДт.Контрагенты = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
						Проводка.СубконтоДт.Резервы = Справочники.Резервы.ПоНалогуНаПрибыльСДивидендов;
						
						
						Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности01;
							
						Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("54301");
						
					КонецЕсли;	
					
						
					//закрытие резерва по налогу
					СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ФактическаяСуммаНалога, ЦеннаяБумага.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Закрытие резерва по налогу на дивиденды");
					
					
					Проводка.СчетДт = ПланыСчетов.Единый.РезервыОценочныеОбязательстваНекредитногоХарактера;
					
					Проводка.СубконтоДт.Контрагенты = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
					Проводка.СубконтоДт.Резервы = Справочники.Резервы.ПоНалогуНаПрибыльСДивидендов;
					
					
					Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности01;
						
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("54301");
					
				КонецЕсли;
					
			КонецЦикла;	
			
		КонецЦикла;
		
		// закроем начисленные резервы
		Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда
			
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДебиторскаяЗадолженностьПоПроцентнымДоходамПоОблигациям;
			
			СчетУчетаРезервов = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами24;
			
			АналитикаСписанияРезервов = БухгалтерскийУчетЕПС.ПолучитьГФУСписанияРезервов(ЭтотОбъект, УчетныйАктив); 
			
			СчетДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Контрагент,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК АналитикаРезерва,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3 КАК ЦеннаяБумага,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК Сумма,
			|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
			|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = &СчетУчетаРезервов,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Субконто3 В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						НачислениеДивидендов.ЦеннаяБумага КАК ЦеннаяБумага
			|					ИЗ
			|						Документ.НачислениеДивидендов КАК НачислениеДивидендов
			|					ГДЕ
			|						НачислениеДивидендов.Ссылка В (&МассивОснований))) КАК ЕдиныйБухгалтерскийУчетОстатки";
			
			Запрос.УстановитьПараметр("МассивОснований", ЭтотОбъект.Основания.ВыгрузитьКолонку("Основание"));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("СчетУчетаРезервов", СчетУчетаРезервов);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, -ВыборкаДетальныеЗаписи.Сумма, "Списание резерва");	
				
				Проводка.СчетДт							= СчетУчетаРезервов;
				Проводка.СубконтоДт.Резервы				= ВыборкаДетальныеЗаписи.АналитикаРезерва;
				Проводка.СубконтоДт.Контрагенты			= ВыборкаДетальныеЗаписи.Контрагент;
				Проводка.СубконтоДт.ЦенныеБумаги		= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				
				Проводка.ВалютаДт						= ВыборкаДетальныеЗаписи.Валюта;
				Проводка.ВалютнаяСуммаДт				= -ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
				
				Проводка.СчетКт												= СчетДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= АналитикаСписанияРезервов;
				Проводка.СубконтоКт.ЦенныеБумаги							= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				
				Если Проводка.СчетКт.Валютный Тогда
					Проводка.ВалютаКт	= ВыборкаДетальныеЗаписи.Валюта;
					Проводка.ВалютнаяСуммаКт	= -ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ НастройкиУчетаОбщие.ОтражатьПартииНаЛицевыхСчетах Тогда
			БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Истина, Истина, МассивЦенныхБумаг, Отказ);	
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке Тогда
		
		МассивУчетныхАктивов = Новый Массив;
		МассивЦенныхБумаг = Новый Массив;
		
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Сделка") Тогда
				
				Если СтрокаОснование.Основание.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
					КонтрагентПоСделке = СтрокаОснование.Основание.Брокер.ЮрФизЛицо;
				Иначе	
					КонтрагентПоСделке = ?(ЗначениеЗаполнено(ЭтотОбъект.Контрагент), ЭтотОбъект.Контрагент, СтрокаОснование.Основание.Контрагент);				
				КонецЕсли;
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание
					|ИЗ
					|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
					|			&МоментНачалаОборотов,
					|			&МоментДокумента,
					|			,
					|			Основание = &Сделка
					|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоДенежнымСредствамОбороты
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	ЗадолженностиПоЦеннымБумагамОбороты.Основание
					|ИЗ
