			КонецЕсли;
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.СделкаСВалютой") Тогда // эти закрываются выше
				Продолжить;
			КонецЕсли;
			КурсоваяРазницаСНачалаГода = 0;
			ВидСчетаУчета = Неопределено;
			ЦеннаяБумага = Неопределено;
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
				//курса задолженности нет, поэтому берем по дате
				ДатаКурса = СтрокаОснование.Основание.Дата;
				Если ДатаКурса < НачалоГода(ЭтотОбъект.Дата) Тогда
					ДатаКурса = НачалоГода(ЭтотОбъект.Дата)-1;//берем курс на 31.12, считаем что переоценка в конце года была.
				КонецЕсли;
				КурсоваяРазницаСНачалаГода = Окр(РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаОснование.СуммаОплаты+СтрокаОснование.СуммаОплатыКупона, ЭтотОбъект.ВалютаОплаты, ?(СтрокаОснование.СобственныйКурсОплаты, СтрокаОснование.КурсОплаты, ЭтотОбъект.Дата), ЭтотОбъект.Организация.ВалютаУчета, ЭтотОбъект.Дата, Отказ), 2) 
					- Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.Сумма+СтрокаОснование.СуммаКупона, СтрокаОснование.Валюта, ЭтотОбъект.Организация, ДатаКурса, Отказ), 2);
				ЦеннаяБумага = БухгалтерскийУчетЕПС.ПолучитьЦеннуюБумагуПриОплатеПогашенияПоВводу(СтрокаОснование.Основание,ЭтотОбъект.Контрагент, ЭтотОбъект.ВидЗадолженности, Отказ);	
				ВидСчетаУчета = ВидСчета.Активный;
			КонецЕсли;
			
			Если ВидСчетаУчета = ВидСчета.Активный Тогда
				СчетУчетаКурсовойРазницы = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			Иначе 						
				СчетУчетаКурсовойРазницы = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			КонецЕсли;

			Если КурсоваяРазницаСНачалаГода > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, КурсоваяРазницаСНачалаГода, "Закрытие курсовой разницы");
				
				Проводка.СчетДт = СчетУчетаКурсовойРазницы;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(Проводка.СчетДт, СтрокаОснование.Валюта);
				Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
					Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				КонецЕсли;
				
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				Проводка.ВалютаКт = ВалютаУчета;
			Иначе
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, - КурсоваяРазницаСНачалаГода, "Закрытие курсовой разницы");
				
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				Проводка.ВалютаДт = ВалютаУчета;
				
				Проводка.СчетКт = СчетУчетаКурсовойРазницы;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(Проводка.СчетКт, СтрокаОснование.Валюта);
				Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
					Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиПоследнегоПогашенияБУНУ(ЭтотОбъект, Облигация, ВалютаНоминала, СчетПогашения, УчетныйРегистр, СтрокаОснование, Сумма, СуммаОплаты, ВалютаОплаты, Купон = Ложь, Отказ)

	Постфикс = ?(Купон, "купона", "облигации");
	
	ВидУчета = Перечисления.ВидыУчета[УчетныйРегистр];
	
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;				
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, Перечисления.РынкиЦенныхБумаг.Облигации, Облигация, Купон);
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, УчетныйАктив, УчетныйРегистр);		
	Аналитика = НастройкиУчета.АналитикаДоходовПоследнееПогашение;
	СчетУчета = НастройкиУчета.СчетУчета;
	СчетУчетаПереоценки = НастройкиУчета.СчетУчетаПереоценки;
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(ЭтотОбъект.Дата, Облигация, УчетныйРегистр);	
	
	СуммаОплатыВВалютеОплаты = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаОплаты, ВалютаОплаты, Организация, Дата, Отказ);
	
	// доход
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаОплатыВВалютеОплаты, "Доход от погашения " + Постфикс);
	
	Проводка.СчетДт = СчетПогашения;
	
	Если Купон Тогда
		Проводка.СубконтоДт.Облигации = Облигация;
	Иначе
		Эмитент	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "Эмитент");
		ЮрЛицоЭмитента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эмитент, "ЮрФизЛицо");
		Проводка.СубконтоДт.Контрагенты = ЮрЛицоЭмитента;
	КонецЕсли;
	
	Если СчетПогашения.Валютный Тогда
		Проводка.ВалютнаяСуммаДт = Сумма; 
		Проводка.ВалютаДт = СтрокаОснование.Валюта;
	КонецЕсли;
	
	Если СчетПогашения = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
		Проводка.СубконтоДт.ОснованиеРасчетов = СтрокаОснование.Основание; 
	КонецЕсли;									
	
	Проводка.СчетКт = СчетДоходов;
	Проводка.СубконтоКт.ПрочиеДоходыИРасходы = Аналитика;
	Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
	Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
	
	// списание с 58го или 97го
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета
		|ПОМЕСТИТЬ _СписаниеПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Период >= &НачалоДня
		|	И БухПартииЦенныхБумаг.Период <= &КонецДня
		|	И БухПартииЦенныхБумаг.Активность
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.Организация = &Организация
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОтложенныеРасходы
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ДокументГраница,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасходыБудущихПериодов),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &Аналитика
		|				И Субконто2 = &ЦеннаяБумага) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(_СписаниеПартий.СтоимостьКупона, 0) КАК Стоимость,
		|	ЕСТЬNULL(_СписаниеПартий.СтоимостьКупонаВВалютеУчета, 0) КАК СтоимостьВВалютеУчета,
		|	ЕСТЬNULL(_СписаниеПартий.ПереоценкаКупона, 0) КАК Переоценка,
		|	ЕСТЬNULL(_СписаниеПартий.ПереоценкаКупонаВВалютеУчета, 0) КАК ПереоценкаВВалютеУчета,
		|	_ОтложенныеРасходы.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	_СписаниеПартий КАК _СписаниеПартий,
		|	_ОтложенныеРасходы КАК _ОтложенныеРасходы";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	Если НЕ Купон Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтоимостьКупона", "Стоимость");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаКупона", "Переоценка");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДокументГраница", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	
	Результат = Запрос.Выполнить().Выгрузить();
	ДанныеДвиженийИОстатков = Результат[0];
	
	Если ДанныеДвиженийИОстатков.Стоимость + ДанныеДвиженийИОстатков.Переоценка > 0
		И ДанныеДвиженийИОстатков.СуммаОстаток > 0 Тогда // не может в одном дне быть и списания партий и остаток по 97му счету на момент документа
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проблемы с формированием партий и проводок по документу " + Строка(СтрокаОснование.Основание) + "! Документ " + ЭтотОбъект + " не проведен по виду учета!", ЭтотОбъект,,,Отказ);
		Возврат;
	
	КонецЕсли;
	
	Если ДанныеДвиженийИОстатков.СуммаОстаток > 0 Тогда // спишем с 97го на 91
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДанныеДвиженийИОстатков.СуммаОстаток, "Доход от погашения " + Постфикс);
		
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
		Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		
		Проводка.СчетКт = ПланыСчетов.Основной.РасходыБудущихПериодов;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = Аналитика;
		Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
		
	Иначе // спишем с 58го
		
		Если ДанныеДвиженийИОстатков.СтоимостьВВалютеУчета > 0 Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДанныеДвиженийИОстатков.СтоимостьВВалютеУчета, "Себестоимость в расход");
			
			Проводка.СчетДт = СчетРасходов;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
			Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетУчета;
			Проводка.СубконтоКт.Облигации = Облигация;
			
			Если СчетУчета.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = ДанныеДвиженийИОстатков.Стоимость;
				Проводка.ВалютаКт = ВалютаНоминала;
			КонецЕсли;
		
		КонецЕсли;
		
		Если ДанныеДвиженийИОстатков.ПереоценкаВВалютеУчета > 0 Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДанныеДвиженийИОстатков.ПереоценкаВВалютеУчета, "Себестоимость в расход");
			
			Проводка.СчетДт = СчетРасходов;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
			Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетУчетаПереоценки;
			Проводка.СубконтоКт.Облигации = Облигация;
			
			Если СчетУчета.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = ДанныеДвиженийИОстатков.Переоценка;
				Проводка.ВалютаКт = ВалютаНоминала;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	ОплатаКомиссииПобиржевымДепозитам = (ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии	И ЭтотОбъект.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК);
	
	НастройкиУчетаОбщие  = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);

	//проверим особый случай. Траст. Лазарев А.П. 13.04.2017
	//Возврат купонного дохода по погашению, которое еще не наступило. 
	//Оставляем до лучших времен
	
	Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода И 
		ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда 
		Для Каждого СтрокаОснование из ЭтотОбъект.Основания Цикл 
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда 
				//Это и есть особый случай. Проводок не делаем, Ошибку не герерируем
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Возврат купонного дохода с основанием Погашение купона. Проводки по " + УчетныйРегистр + " не делаем!", ЭтотОбъект);
				Возврат;
		    КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
		
	МетодОпределенияДоходовИРасходов = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		"МетодОпределенияДоходовИРасходов");

	МетодПризнанияРасходовПоСделкамРЕПО = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		"МетодПризнанияРасходовПоСделкамРЕПО");
		
	Если Не ЗначениеЗаполнено(МетодОпределенияДоходовИРасходов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках по виду учета " + УчетныйРегистр + " не указан метод определения доходов и расходов. Документ " + ЭтотОбъект + " не проведен по виду учета!", ЭтотОбъект,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Если МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый 
		И НЕ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ)
		И ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль
		И ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона				// эти    все      сами
		И ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда	//    двое   делают
		// Формируем проводки по начислению
		СформироватьПроводкиПоНачислению(УчетныйРегистр, Отказ);		
	КонецЕсли;	
	
	Если ОплатаКомиссииПобиржевымДепозитам Тогда
	    СчетУчетаДС = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			"СчетУчетаДенежныхСредствНаБирже");
	Иначе
		СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВалютаОплаты,
			ЭтотОбъект.Брокер);
	КонецЕсли;

	ДоговорБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	
	Если ЭтотОбъект.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.Комиссия)
		Или ЭтотОбъект.ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.УслугиДоверительногоУправления
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимУслугам
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоИнымДоходамПоИмуществу
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоУслугамПрочегоИспользованияИмущества
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоУлучшениюОбъектовНедвижимости
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги
		Или ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоРекламе
		Тогда 
		
	#Область ПоступленияУслуг
		Если Аванс = 1  Тогда
		    Если Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ЭтотОбъект.ВидЗадолженности) = Перечисления.ТипыЗадолженности.Кредиторская Тогда
				СчетУчетаУслугРуб = ПланыСчетов.Основной.РасчетыПоАвансамВыданным;
			Иначе
				СчетУчетаУслугРуб = ПланыСчетов.Основной.РасчетыСПокупателямиИЗаказчикамиАвансыПолученные;
			КонецЕсли;
		ИначеЕсли ОплатаКомиссииПобиржевымДепозитам Тогда
			СчетУчетаУслугРуб = ПланыСчетов.Основной.РасчетыПоКомиссии;
		Иначе	
			СчетУчетаУслугРуб = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВидЗадолженности,
			УчетныйРегистр,
			"СчетУчета");
		КонецЕсли; 
		
		СчетУчетаУслугВалюта = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
		
		Если ЗначениеЗаполнено(СчетУчетаУслугРуб) Тогда	
			ЕстьСубконтоКонтрагенты          = (СчетУчетаУслугРуб.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);			
			ЕстьСубконтоСделки               = (СчетУчетаУслугРуб.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
			ЕстьСубконтоДоговорыДепо         = (СчетУчетаУслугРуб.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыДепозитарногоОбслуживания) <> Неопределено);
			ЕстьСубконтоБрокерскиеДоговоры   = (СчетУчетаУслугРуб.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
			ЕстьСубконтоДоговоры			 = (СчетУчетаУслугРуб.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках учета не определен счет учета по выбранному виду задолженности. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,,);
			Возврат;
		КонецЕсли; 	
		
		Если СчетУчетаДС <> Неопределено Тогда	
			ЕстьСубконтоБрокерскиеДоговорыДС = (СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках учета не определен счет учета д/с. Документ " + ЭтотОбъект + " не проведен по виду учета " + УчетныйРегистр + "!", ЭтотОбъект,,,);	
			Возврат;
		КонецЕсли;
		
		Для каждого СтрокаОснование Из ЭтотОбъект.Основания Цикл
			
			Если СтрокаОснование.Валюта = Организация.ВалютаУчета Тогда 
				СчетУчетаУслуг = СчетУчетаУслугРуб;
			Иначе
				СчетУчетаУслуг = СчетУчетаУслугВалюта;
			КонецЕсли;							
			
			Если ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.Оплата")
				ИЛИ ТипЗнч(СтрокаОснование.Основание) = Тип("ДокументСсылка.КорректировкаЗадолженности") Тогда
				СчетУчетаУслуг 			 		= ПланыСчетов.Основной.РасчетыПоАвансамВыданным;
				Содержание 						= "Возврат аванса";
				ЕстьСубконтоДоговоры			= Истина;   
				ЕстьСубконтоСделки 		 		= Ложь;
				ЕстьСубконтоДоговорыДепо 		= Ложь;
				ЕстьСубконтоБрокерскиеДоговоры 	= Ложь;
			Иначе
				Содержание = "Оплата задолженности";
			КонецЕсли;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				
				КонтрагентПоУслугам = ЭтотОбъект.Контрагент;
				
				Если ЗначениеЗаполнено(СтрокаОснование.Основание) 
					и СтрокаОснование.Основание.Метаданные().Реквизиты.Найти("Брокер") <> Неопределено 
					и СтрокаОснование.Основание.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
					КонтрагентПоУслугам = СтрокаОснование.Основание.Брокер.ЮрФизЛицо;
				КонецЕсли;
				
			КонецЕсли;

			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплаты, ВалютаОплаты, Организация, Дата, Отказ), Содержание);
			
			Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
				// это вид задолженности ПоПрочимДоходам или зачет аванса
		
				// дебет
				Проводка.СчетДт = СчетУчетаДС;
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоДт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если ЕстьСубконтоБрокерскиеДоговорыДС Тогда
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления;
				КонецЕсли;				
								
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = СтрокаОснование.СуммаОплаты;
					ПРоводка.ВалютаДт = ВалютаОплаты;
				КонецЕсли;
				
				// кредит
				Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимУслугам И ЗначениеЗаполнено(ЭтотОбъект.КоррСчет) Тогда
					
					Проводка.СчетКт = ЭтотОбъект.КоррСчет;
					
					Для НомСубк = 1 По Проводка.СчетКт.ВидыСубконто.Количество() Цикл
						Проводка.СубконтоКт[ЭтотОбъект.КоррСчет.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
					КонецЦикла;
					
				Иначе
				
					Проводка.СчетКт = СчетУчетаУслуг;
					Если ЕстьСубконтоКонтрагенты Тогда
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоУслугам;
					КонецЕсли;
					
					Если ЕстьСубконтоСделки Тогда
						Проводка.СубконтоКт.Сделка = СтрокаОснование.Основание;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговорыДепо Тогда
						Проводка.СубконтоКт.ДоговорыДепозитарногоОбслуживания = СтрокаОснование.Основание.Договор;
					КонецЕсли;
					
					Если ЕстьСубконтоБрокерскиеДоговоры Тогда
						Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговоры Тогда
						Проводка.СубконтоКт.Договоры = ?(ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего, СчетДоверительногоУправления, ЭтотОбъект.Договор);
					КонецЕсли;
					
				КонецЕсли;
				
				Если Проводка.СчетКт.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаОснование.Сумма;
					Проводка.ВалютаКт = СтрокаОснование.Валюта;
				КонецЕсли;
				
				Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии 
					ИЛИ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
				
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаОснование.СуммаОплаты, ВалютаОплаты, Организация, Дата, Отказ), Содержание);
					
					Проводка.СчетДт = СчетУчетаУслуг;
					Если ЕстьСубконтоКонтрагенты Тогда
						Проводка.СубконтоДт.Контрагенты = КонтрагентПоУслугам;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговоры Тогда
						Проводка.СубконтоДт.Договоры = ?(ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего, СчетДоверительногоУправления, ЭтотОбъект.Договор);
					КонецЕсли;
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
						ЭтотОбъект.Дата, 
						ЭтотОбъект.Организация, 
						ЭтотОбъект.СчетДоверительногоУправления,
						ЭтотОбъект.ВидЗадолженности,
						УчетныйРегистр,
						"Аналитика");
						
				КонецЕсли;
				
			Иначе
			
				// дебет
				Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимУслугам И ЗначениеЗаполнено(ЭтотОбъект.КоррСчет) Тогда
					
					Проводка.СчетДт = ЭтотОбъект.КоррСчет;
					
					Для НомСубк = 1 По Проводка.СчетДт.ВидыСубконто.Количество() Цикл
						Проводка.СубконтоДт[ЭтотОбъект.КоррСчет.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
					КонецЦикла;
					
				Иначе
				
					Проводка.СчетДт = СчетУчетаУслуг;
					
					Если ЕстьСубконтоКонтрагенты Тогда
						Проводка.СубконтоДт.Контрагенты = КонтрагентПоУслугам;
					КонецЕсли;
					
					Если ЕстьСубконтоСделки Тогда
						Проводка.СубконтоДт.Сделка = СтрокаОснование.Основание;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговорыДепо Тогда
						Проводка.СубконтоДт.ДоговорыДепозитарногоОбслуживания = СтрокаОснование.Основание.Договор;
					КонецЕсли;
					
					Если ЕстьСубконтоБрокерскиеДоговоры Тогда
						Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговоры Тогда
						Проводка.СубконтоДт.Договоры = ?(ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего, СчетДоверительногоУправления, ЭтотОбъект.Договор);
					КонецЕсли;

				КонецЕсли;
					
				Если Проводка.СчетДт.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = СтрокаОснование.Сумма;
					Проводка.ВалютаДт = СтрокаОснование.Валюта;
				КонецЕсли;
				
				// Кредит
				Проводка.СчетКт = СчетУчетаДС;
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;	
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
				КонецЕсли;
				
				Если ЕстьСубконтоБрокерскиеДоговорыДС Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ДоговорБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					 //позаимствовано из  БухгалтерскийУчетЕПС.ОплатитьКомиссиюНаЦБ
					 Если ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего 
						 ИЛИ ЭтотОбъект.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение Тогда 
