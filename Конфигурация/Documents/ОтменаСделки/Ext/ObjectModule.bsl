			|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И НЕ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|	И ЗадолженностиПоДенежнымСредствам.МоментВремени <= &МоментВремени
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	""ОстаткиДенежныхСредств"" КАК ИмяРегистра,
			|	ОстаткиДенежныхСредств.Период КАК Период,
			|	ОстаткиДенежныхСредств.Регистратор КАК Регистратор,
			|	ОстаткиДенежныхСредств.НомерСтроки КАК НомерСтроки,
			|	ОстаткиДенежныхСредств.Активность КАК Активность,
			|	ОстаткиДенежныхСредств.ВидДвижения КАК ВидДвижения,
			|	ОстаткиДенежныхСредств.Организация КАК Организация,
			|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ОстаткиДенежныхСредств.Брокер КАК Брокер,
			|	ОстаткиДенежныхСредств.МестоХранения КАК МестоХранения,
			|	ОстаткиДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
			|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
			|	-ОстаткиДенежныхСредств.Сумма КАК Сумма,
			|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
			|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
			|	ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Содержание КАК СТРОКА(999)) КАК Содержание
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
			|ГДЕ
			|	ОстаткиДенежныхСредств.Регистратор = &Сделка
			|	И НЕ ВЫРАЗИТЬ(ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК Справочник.ВидыЗадолженности) В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
			|	И ОстаткиДенежныхСредств.Организация = &Организация
			|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ОстаткиДенежныхСредств.МоментВремени <= &МоментВремени"; 		
		
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции // ПолучитьТекстЗапросаПоДвижениямНакопления

Функция ПолучитьТекстЗапросаПоРегистрамСведений(Запрос, ТипЗначенияСделки)
			
	ТекстЗапроса = "";
	
	Запрос.УстановитьПараметр("Сделка", 					  ЭтотОбъект.Сделка);
	Запрос.УстановитьПараметр("Ссылка", 					  ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", 				  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", 					  ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("МоментВремени", 				  Новый МоментВремени(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка));
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СвязанныеДокументы
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Основание = &Сделка
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделке.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	ИзменениеУсловийСделки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|ГДЕ
		|	ИзменениеУсловийСделки.Основание = &Сделка
		|	И ИзменениеУсловийСделки.Организация = &Организация
		|	И ИзменениеУсловийСделки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИзменениеУсловийСделки.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.Ссылка
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.ПерваяЧастьРЕПО = &Сделка
		|	И СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПО.МоментВремени <= &МоментВремени";
	
	Запрос.Выполнить();
	
	Если ТипЗначенияСделки = Тип("ДокументСсылка.Сделка") Тогда	
		
		// ОперацииСЦеннымиБумагами
		// УсловияСделок
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ОперацииСЦеннымиБумагами"" КАК ИмяРегистра,
		|	ОперацииСЦеннымиБумагами.Регистратор,
		|	ОперацииСЦеннымиБумагами.НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Активность,
		|	ОперацииСЦеннымиБумагами.СтрокаПартии,
		|	&Ссылка КАК Операция,
		|	ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО,
		|	ОперацииСЦеннымиБумагами.ВидДвижения,
		| 	ОперацииСЦеннымиБумагами.Регистратор КАК Основание,
		|	ОперацииСЦеннымиБумагами.Организация,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления,
		|	ОперацииСЦеннымиБумагами.Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.Валюта,
		|	ОперацииСЦеннымиБумагами.ДатаПокупки,
		|	ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаПоставки,
		|	ОперацииСЦеннымиБумагами.ДатаОплатыПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаОплаты,
		|	-ОперацииСЦеннымиБумагами.Количество КАК Количество,
		|	ОперацииСЦеннымиБумагами.Цена КАК Цена,
		|	ОперацииСЦеннымиБумагами.ЦенаПроцент КАК ЦенаПроцент,
		|	ОперацииСЦеннымиБумагами.ЦенаКупона,
		|	-ОперацииСЦеннымиБумагами.Сумма КАК Сумма,
		|	-ОперацииСЦеннымиБумагами.СуммаКупона КАК СуммаКупона,
		|	ОперацииСЦеннымиБумагами.ДатаОперации
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	(ОперацииСЦеннымиБумагами.Регистратор = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Основание = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Операция = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор В
		|				(ВЫБРАТЬ
		|					_СвязанныеДокументы.Ссылка
		|				ИЗ
		|					_СвязанныеДокументы КАК _СвязанныеДокументы))
		|	И ОперацииСЦеннымиБумагами.Регистратор <> &Ссылка
		|	И ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.Регистратор.МоментВремени <= &МоментВремени
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""УсловияСделок"" КАК ИмяРегистра,
		|	УсловияСделок.Период КАК Период,
		|	УсловияСделок.Регистратор,
		|	УсловияСделок.НомерСтроки,
		|	УсловияСделок.Активность,
		|	УсловияСделок.Организация,
		|	УсловияСделок.Сделка,
		|	УсловияСделок.Рынок,
		|	УсловияСделок.ЦеннаяБумага,
		|	ИСТИНА КАК Отменено,
		|	УсловияСделок.ДепозитарныйСчет,
		|	УсловияСделок.ДатаИсполнения,
		|	УсловияСделок.ДатаОплаты,
		|	УсловияСделок.ДатаПоставки,
		|	УсловияСделок.ВалютаОплаты,
		|	УсловияСделок.СобственныйКурсОплаты,
		|	УсловияСделок.КурсОплаты,
		|	УсловияСделок.Количество,
		|	УсловияСделок.Цена,
		|	УсловияСделок.ЦенаПроцент,
		|	УсловияСделок.ЦенаКупона,
		|	УсловияСделок.Сумма,
		|	УсловияСделок.СуммаКупона,
		|	УсловияСделок.ОтложенноеИсполнение,
		|	УсловияСделок.РаздельноеИсполнение,
		|	УсловияСделок.СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.УсловияСделок КАК УсловияСделок
		|ГДЕ
		|	(УсловияСделок.Регистратор = &Сделка
		|			ИЛИ УсловияСделок.Сделка = &Сделка
		|			ИЛИ УсловияСделок.Регистратор В
		|				(ВЫБРАТЬ
		|					_СвязанныеДокументы.Ссылка
		|				ИЗ
		|					_СвязанныеДокументы КАК _СвязанныеДокументы))
		|	И УсловияСделок.Регистратор <> &Ссылка
		|	И УсловияСделок.Организация = &Организация
		|	И УсловияСделок.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|   И НЕ Отменено
		|	И УсловияСделок.МоментВремени <= &МоментВремени
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	ИначеЕсли ТипЗначенияСделки = Тип("ДокументСсылка.СделкаРЕПО") Тогда	
		
		// ОперацииСЦеннымиБумагами
		// УсловияСделокРЕПО
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ОперацииСЦеннымиБумагами"" КАК ИмяРегистра,
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ОперацииСЦеннымиБумагами.НомерСтроки КАК НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Активность КАК Активность,
		|	ОперацииСЦеннымиБумагами.СтрокаПартии КАК СтрокаПартии,
		|	&Ссылка КАК Операция,
		|	ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	ОперацииСЦеннымиБумагами.ВидДвижения КАК ВидДвижения,
		| 	ОперацииСЦеннымиБумагами.Регистратор КАК Основание,
		|	ОперацииСЦеннымиБумагами.Организация КАК Организация,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.Валюта КАК Валюта,
		|	ОперацииСЦеннымиБумагами.ДатаПокупки КАК ДатаПокупки,
		|	ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая КАК ДатаПоставкиПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаПоставки КАК ДатаПоставки,
		|	ОперацииСЦеннымиБумагами.ДатаОплатыПлановая КАК ДатаОплатыПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаОплаты КАК ДатаОплаты,
		|	-ОперацииСЦеннымиБумагами.Количество КАК Количество,
		|	ОперацииСЦеннымиБумагами.Цена КАК Цена,
		|	ОперацииСЦеннымиБумагами.ЦенаПроцент КАК ЦенаПроцент,
		|	ОперацииСЦеннымиБумагами.ЦенаКупона КАК ЦенаКупона,
		|	-ОперацииСЦеннымиБумагами.Сумма КАК Сумма,
		|	-ОперацииСЦеннымиБумагами.СуммаКупона КАК СуммаКупона,
		|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаОперации
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	(ОперацииСЦеннымиБумагами.Регистратор = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Основание = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Операция = &Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор В
		|				(ВЫБРАТЬ
		|					_СвязанныеДокументы.Ссылка
		|				ИЗ
		|					_СвязанныеДокументы КАК _СвязанныеДокументы))
		|	И ОперацииСЦеннымиБумагами.Регистратор <> &Ссылка
		|	И ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОперацииСЦеннымиБумагами.Регистратор.МоментВремени <= &МоментВремени
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""УсловияСделокРЕПО"" КАК ИмяРегистра,
		|	УсловияСделокРЕПО.Период КАК Период,
		|	УсловияСделокРЕПО.Регистратор КАК Регистратор,
		|	УсловияСделокРЕПО.НомерСтроки КАК НомерСтроки,
		|	УсловияСделокРЕПО.Активность КАК Активность,
		|	УсловияСделокРЕПО.Организация КАК Организация,
		|	УсловияСделокРЕПО.Рынок КАК Рынок,
		|	УсловияСделокРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ИСТИНА КАК Отменено,
		|	УсловияСделокРЕПО.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	УсловияСделокРЕПО.ДатаИсполнения КАК ДатаИсполнения,
		|	УсловияСделокРЕПО.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделокРЕПО.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокРЕПО.ВалютаОплаты КАК ВалютаОплаты,
		|	УсловияСделокРЕПО.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	УсловияСделокРЕПО.КурсОплаты КАК КурсОплаты,
		|	УсловияСделокРЕПО.Количество КАК Количество,
		|	УсловияСделокРЕПО.Цена КАК Цена,
		|	УсловияСделокРЕПО.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияСделокРЕПО.ЦенаКупона КАК ЦенаКупона,
		|	УсловияСделокРЕПО.Сумма КАК Сумма,
		|	УсловияСделокРЕПО.СуммаКупона КАК СуммаКупона,
		|	УсловияСделокРЕПО.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	УсловияСделокРЕПО.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	УсловияСделокРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокРЕПО.ВидЗадолженности КАК ВидЗадолженности,
		|	УсловияСделокРЕПО.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	УсловияСделокРЕПО.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПО.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|ГДЕ
		|	(УсловияСделокРЕПО.Регистратор = &Сделка
		|			ИЛИ УсловияСделокРЕПО.Регистратор В
		|				(ВЫБРАТЬ
		|					_СвязанныеДокументы.Ссылка
		|				ИЗ
		|					_СвязанныеДокументы КАК _СвязанныеДокументы))
		|	И УсловияСделокРЕПО.Регистратор <> &Ссылка
		|	И УсловияСделокРЕПО.Организация = &Организация
		|	И УсловияСделокРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НЕ УсловияСделокРЕПО.Отменено
		|	И УсловияСделокРЕПО.МоментВремени <= &МоментВремени
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
			
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции // ПолучитьТекстЗапросаПоРегистрамСведений

Функция ПолучитьТекстЗапросаПоДвижениямБухгалтерии(Запрос, ДатаНачала, УчетныйРегистр)
	
	ТекстЗапроса = "";
	
	Запрос.УстановитьПараметр("Сделка", 					  ЭтотОбъект.Сделка);
	Запрос.УстановитьПараметр("Ссылка", 					  ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", 				  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("НачалоПериода", 				  ДатаНачала);
	Запрос.УстановитьПараметр("Период",		 				  ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("МоментВремени", 				  Новый МоментВремени(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка));
	
	// Исключаем сторнирование проводок по комиссиям.
	// Для этого получим счета учета комиссий из настроек соответствующего учета
	// !!!!Уточнить про предварительные затраты по комиссии!!!!
	СчетаУчетаКомиссии = Новый Массив;
	СубконтоКомиссии = Новый Массив;
	Если Учетныйрегистр = "ЕдиныйБухгалтерскийУчет" Тогда		
		СчетаУчетаКомиссии.Добавить(ПланыСчетов.Единый.РасчетыСБрокерами02);
		СубконтоКомиссии.Добавить(Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия);		
	Иначе	
		СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
				ДатаНачала, 
				ЭтотОбъект.Организация, 
				ЭтотОбъект.СчетДоверительногоУправления,
				Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
				УчетныйРегистр,
				"СчетУчета");
				
		СчетаУчетаКомиссии.Добавить(СчетУчетаКомиссии);		
	КонецЕсли;			
	
	Запрос.УстановитьПараметр("СчетаУчетаКомиссии",	СчетаУчетаКомиссии);
	Запрос.УстановитьПараметр("СубконтоКомиссии",	СубконтоКомиссии);
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СвязанныеДокументы
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Основание = &Сделка
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделке.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	ИзменениеУсловийСделки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|ГДЕ
		|	ИзменениеУсловийСделки.Основание = &Сделка
		|	И ИзменениеУсловийСделки.Организация = &Организация
		|	И ИзменениеУсловийСделки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИзменениеУсловийСделки.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.Ссылка
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.ПерваяЧастьРЕПО = &Сделка
		|	И СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПО.МоментВремени <= &МоментВремени";
	
	Запрос.Выполнить();
				
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	" + """" + УчетныйРегистр + """" + " КАК ИмяРегистра,
		|	БухгалтерскийУчетДвиженияССубконто.Период КАК Период,
		|	БухгалтерскийУчетДвиженияССубконто.Регистратор КАК Регистратор,
		|	БухгалтерскийУчетДвиженияССубконто.НомерСтроки КАК НомерСтроки,
		|	БухгалтерскийУчетДвиженияССубконто.Активность КАК Активность,
		|	БухгалтерскийУчетДвиженияССубконто.СчетДт КАК СчетДт,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоДт1 КАК ВидСубконтоДт1,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоДт2 КАК ВидСубконтоДт2,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоДт3 КАК ВидСубконтоДт3,
		|	БухгалтерскийУчетДвиженияССубконто.СчетКт КАК СчетКт,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоКт1 КАК ВидСубконтоКт1,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоКт2 КАК ВидСубконтоКт2,
		|	БухгалтерскийУчетДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
		|	БухгалтерскийУчетДвиженияССубконто.ВидСубконтоКт3 КАК ВидСубконтоКт3,
		|	БухгалтерскийУчетДвиженияССубконто.Организация КАК Организация,
		|	БухгалтерскийУчетДвиженияССубконто.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухгалтерскийУчетДвиженияССубконто.ВалютаДт КАК ВалютаДт,
		|	БухгалтерскийУчетДвиженияССубконто.ВалютаКт КАК ВалютаКт,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетДвиженияССубконто.КоличествоДт = 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухгалтерскийУчетДвиженияССубконто.КоличествоДт
		|	КОНЕЦ КАК КоличествоДт,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетДвиженияССубконто.КоличествоКт = 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухгалтерскийУчетДвиженияССубконто.КоличествоКт
		|	КОНЕЦ КАК КоличествоКт,
		|	-БухгалтерскийУчетДвиженияССубконто.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаДт = 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаДт
		|	КОНЕЦ КАК ВалютнаяСуммаДт,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаКт = 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаКт
		|	КОНЕЦ КАК ВалютнаяСуммаКт,
		|	ВЫРАЗИТЬ(БухгалтерскийУчетДвиженияССубконто.Содержание КАК СТРОКА(999)) КАК Содержание,
		|	БухгалтерскийУчетДвиженияССубконто.ПорядокОпераций КАК ПорядокОпераций
		|ИЗ
		|	РегистрБухгалтерии." + УчетныйРегистр + ".ДвиженияССубконто(	
		|			&НачалоПериода,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Активность
		|				И (Регистратор = &Сделка
		|					ИЛИ Регистратор В
		|						(ВЫБРАТЬ
		|							_СвязанныеДокументы.Ссылка
		|						ИЗ
		|							_СвязанныеДокументы КАК _СвязанныеДокументы)),
		|			,
		|			) КАК БухгалтерскийУчетДвиженияССубконто
		|ГДЕ 
		|	БухгалтерскийУчетДвиженияССубконто.МоментВремени <= &МоментВремени
	 	|	И (НЕ (БухгалтерскийУчетДвиженияССубконто.СчетКт В (&СчетаУчетаКомиссии)"
		+ ?(СубконтоКомиссии.Количество() > 0, " И БухгалтерскийУчетДвиженияССубконто.СубконтоКт2 В (&СубконтоКомиссии))", ")") +"
		|)
		|	И (НЕ (БухгалтерскийУчетДвиженияССубконто.СчетДт В (&СчетаУчетаКомиссии)"
		+ ?(СубконтоКомиссии.Количество() > 0, " И БухгалтерскийУчетДвиженияССубконто.СубконтоДт2 В (&СубконтоКомиссии))", ")") +"
		|)";
	 	
	Возврат ТекстЗапроса;
	
КонецФункции // ПолучитьТекстЗапросаПоДвижениямБухгалтерии

Процедура ПроверитьДублированиеОтменыСделки(Отказ)
	
	Если Отказ ИЛИ ЭтотОбъект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) = ТИП(Документ.ОтменаСделки)
		|	И ОперацииСЦеннымиБумагами.Основание = &Основание";
	
	Если Не ЭтоНовый() Тогда
		ТекстЗапроса = ТекстЗапроса + " И ОперацииСЦеннымиБумагами.Регистратор <> &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Основание", ЭтотОбъект.Сделка);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Уже проведена отмена сделки " + СокрЛП(Выборка.Регистратор),,,, Отказ);
	КонецЕсли;
		
КонецПроцедуры // ПроверитьДублированиеОтменыСделки
	
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	// Заполнение шапки
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Сделка") Тогда
		Сделка = ДанныеЗаполнения.Ссылка;
		СчетДоверительногоУправления = ДанныеЗаполнения.СчетДоверительногоУправления;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Сделка = ДанныеЗаполнения.Ссылка;
		СчетДоверительногоУправления = ДанныеЗаполнения.СчетДоверительногоУправления;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		Сделка = ДанныеЗаполнения.Ссылка;
		СчетДоверительногоУправления = ДанныеЗаполнения.СчетДоверительногоУправления;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Сделка");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
			
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
		
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	ПроверитьДублированиеОтменыСделки(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// т.к. по документу используется сводная форма в журнале
	РаботаСЖурналамиОпераций.ПередЗаписьюДокумента(ЭтотОбъект);
	
КонецПроцедуры // ПередЗаписью

Процедура ПередУдалением(Отказ)
	
	РаботаСЖурналамиОпераций.ПередУдалениемДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти

