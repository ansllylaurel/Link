
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;

	ТипЗначенияСделки = ТипЗнч(ЭтотОбъект.Сделка);
	Если ТипЗначенияСделки = Тип("ДокументСсылка.Сделка") ИЛИ ТипЗначенияСделки = Тип("ДокументСсылка.СделкаРЕПО") Тогда
						
		ЗначенияРеквизитаРынок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Сделка, "Рынок");
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        ЗначенияРеквизитаРынок);
		
		ЦенныеБумаги = ПолучитьЦенныеБумагиСделки();
		ЭлементБлокировкиДанных.ИсточникДанных = ЦенныеБумаги;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДепозитарныйСчет", "ДепозитарныйСчет");
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ЦеннаяБумага",     "ЦеннаяБумага");
		
	ИначеЕсли ТипЗначенияСделки = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
		
		ЗначенияРеквизитовСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Сделка, "Брокер, МестоХранения, РасчетныйСчет, РасчетныйСчетКонтрвалюты, ВидСделки");
				
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                       	ЗначенияРеквизитовСделки.Брокер);
		ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                 ЗначенияРеквизитовСделки.МестоХранения);
		
		Если      ЗначенияРеквизитовСделки.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет", ЗначенияРеквизитовСделки.РасчетныйСчетКонтрвалюты);
		ИначеЕсли ЗначенияРеквизитовСделки.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет", ЗначенияРеквизитовСделки.РасчетныйСчет);
		КонецЕсли;
		
	КонецЕсли;

	Если БлокировкаДанных.Количество() <> 0 Тогда
		БлокировкаДанных.Заблокировать();	
	КонецЕсли; 
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	ТипЗначенияСделки = ТипЗнч(ЭтотОбъект.Сделка);
	Если ТипЗначенияСделки = Тип("ДокументСсылка.Сделка") Тогда 
		
		Движения.ОстаткиЦенныхБумаг.Записывать               = Истина;
		Движения.ОстаткиДенежныхСредств.Записывать           = Истина;
		Движения.ЗадолженностиПоЦеннымБумагам.Записывать     = Истина;
		Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
		Движения.ОперацииСЦеннымиБумагами.Записывать         = Истина;
		Движения.УсловияСделок.Записывать                    = Истина;
		Движения.РасходыПоСделке.Записывать                  = Истина;
		
	ИначеЕсли ТипЗначенияСделки = Тип("ДокументСсылка.СделкаРЕПО") Тогда 	
		
		Движения.ОстаткиЦенныхБумаг.Записывать               = Истина;
		Движения.ОстаткиДенежныхСредств.Записывать           = Истина;
		Движения.ЗадолженностиПоВторойЧастиРЕПО.Записывать   = Истина;
		Движения.ЗадолженностиПоЦеннымБумагам.Записывать     = Истина;
		Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
		Движения.УсловияСделокРЕПО.Записывать                = Истина;
		Движения.ОперацииСЦеннымиБумагами.Записывать         = Истина;
		Движения.РасходыПоСделке.Записывать                  = Истина;
		
	Иначе
		
		Движения.ОстаткиДенежныхСредств.Записывать           = Истина;
		Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
		Движения.РасходыПоСделке.Записывать                  = Истина;
	
	КонецЕсли;
	
	Если ТипЗначенияСделки = Тип("ДокументСсылка.Сделка") Тогда
		Движения.УсловияСделок.Записать();
	ИначеЕсли ТипЗначенияСделки = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Движения.УсловияСделокРЕПО.Записать();
	КонецЕсли;

	СформироватьДвиженияНакопленияДляСторнирования(ТипЗначенияСделки);
	
	СформироватьНачислениеЗадолженностиПоОтступным(ТипЗначенияСделки);
	
	Если ТипЗначенияСделки <> Тип("ДокументСсылка.СделкаСВалютой") Тогда
		СформироватьЗаписиРегистровСведенийДляСторнирования(ТипЗначенияСделки);
	КонецЕсли;	
	         	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	СформироватьДвиженияРегистраБухгалтерииДляСторнирования(УчетныйРегистр);
	
КонецПроцедуры
 
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	СформироватьДвиженияРегистраБухгалтерииДляСторнирования(УчетныйРегистр);
			
КонецПроцедуры

Функция ПолучитьЦенныеБумагиСделки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.Ссылка,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет,
		|	СделкаЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка = &Сделка";
	
	Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Сделка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьЦенныеБумагиСделки

Процедура СформироватьДвиженияНакопленияДляСторнирования(ТипЗначенияСделки)

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПоДвижениямНакопления(Запрос, ТипЗначенияСделки);
		
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		ЗаписиРегистра = СтрокаРезультата.Выгрузить();
		Если ЗаписиРегистра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРегистра = ЗаписиРегистра[0].ИмяРегистра;
						
		Для Каждого СтрокаРегистра Из ЗаписиРегистра Цикл
			НоваяЗапись = Движения[ИмяРегистра].Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаРегистра);
			НоваяЗапись.Регистратор = Ссылка;
			НоваяЗапись.Период      = Дата;
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьДвиженияНакопленияДляСторнирования

Процедура СформироватьЗаписиРегистровСведенийДляСторнирования(ТипЗначенияСделки)

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПоРегистрамСведений(Запрос, ТипЗначенияСделки);
		
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		ЗаписиРегистра = СтрокаРезультата.Выгрузить();
		Если ЗаписиРегистра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРегистра = ЗаписиРегистра[0].ИмяРегистра;
						
		Для Каждого СтрокаРегистра Из ЗаписиРегистра Цикл
			НоваяЗапись = Движения[ИмяРегистра].Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаРегистра);
			НоваяЗапись.Регистратор = Ссылка;
			НоваяЗапись.Период      = Дата;
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьЗаписиРегистровСведенийДляСторнирования

Процедура СформироватьДвиженияРегистраБухгалтерииДляСторнирования(УчетныйРегистр)
	
	ДатаНачала = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Сделка, "Дата"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПоДвижениямБухгалтерии(Запрос, ДатаНачала, УчетныйРегистр);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		ЗаписиРегистра = СтрокаРезультата.Выгрузить();
		Если ЗаписиРегистра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРегистра = ЗаписиРегистра[0].ИмяРегистра;
		
		Если ИмяРегистра = "ЕдиныйБухгалтерскийУчет" Тогда
			КоличествоСубконто = Метаданные.ПланыСчетов.Единый.МаксКоличествоСубконто;
		Иначе	
			КоличествоСубконто = Метаданные.ПланыСчетов.Основной.МаксКоличествоСубконто;
		КонецЕсли;
		
		Для Каждого СтрокаРегистра Из ЗаписиРегистра Цикл
			НоваяЗапись = Движения[ИмяРегистра].Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаРегистра);
			НоваяЗапись.Регистратор = Ссылка;
			НоваяЗапись.Период      = Дата;
			
			Для Сч = 1 По КоличествоСубконто Цикл 
				
				Если ЗначениеЗаполнено(СтрокаРегистра["ВидСубконтоДт" + Сч]) Тогда
					НоваяЗапись.СубконтоДт.Вставить(СтрокаРегистра["ВидСубконтоДт" + Сч], СтрокаРегистра["СубконтоДт" + Сч]);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаРегистра["ВидСубконтоКт" + Сч]) Тогда
					НоваяЗапись.СубконтоКт.Вставить(СтрокаРегистра["ВидСубконтоКт" + Сч], СтрокаРегистра["СубконтоКт" + Сч]);
				КонецЕсли;
				
			КонецЦикла;	

		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьДвиженияРегистраБухгалтерииДляСторнирования

Процедура СформироватьНачислениеЗадолженностиПоОтступным(ТипЗначенияСделки)
	
	Если ЭтотОбъект.СуммаОтступных = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Начисляем задолженность 	
	Если ТипЗначенияСделки = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Сделка, "РасчетныйСчет"); 
		Контрагент = РеквизитыСделки.РасчетныйСчет.Банк.ЮрФизЛицо;
	Иначе
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Сделка, "Контрагент, Брокер");
		Контрагент = ?(ЗначениеЗаполнено(РеквизитыСделки.Контрагент), РеквизитыСделки.Контрагент, РеквизитыСделки.Брокер.ЮрФизЛицо);
	КонецЕсли;	
		
	СтрокаЗадолженности                              = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	СтрокаЗадолженности.Регистратор                  = ЭтотОбъект.Ссылка;
	СтрокаЗадолженности.Период                       = ЭтотОбъект.Дата;
	СтрокаЗадолженности.Основание                    = ЭтотОбъект.Сделка;
	СтрокаЗадолженности.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
	СтрокаЗадолженности.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
	СтрокаЗадолженности.Организация                  = ЭтотОбъект.Организация;
	СтрокаЗадолженности.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	СтрокаЗадолженности.Валюта                       = ЭтотОбъект.Валюта;
	СтрокаЗадолженности.Контрагент                   = Контрагент;
	СтрокаЗадолженности.Содержание                   = "Отступные по отмене сделки";
	СтрокаЗадолженности.Сумма                  		 = ЭтотОбъект.СуммаОтступных;	
	
КонецПроцедуры // СформироватьНачислениеЗадолженностиПоОтступным

Функция ПолучитьТекстЗапросаПоДвижениямНакопления(Запрос, ТипЗначенияСделки)
	
	ТекстЗапроса = "";
	
	Запрос.УстановитьПараметр("Сделка", 					  ЭтотОбъект.Сделка);
	Запрос.УстановитьПараметр("Ссылка", 					  ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", 				  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Период",		 				  ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("МоментВремени", 				  Новый МоментВремени(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка));
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СвязанныеДокументы
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Основание = &Сделка
		|	И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнениеОбязательствПоСделке.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	ИзменениеУсловийСделки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|ГДЕ
		|	ИзменениеУсловийСделки.Основание = &Сделка
		|	И ИзменениеУсловийСделки.Организация = &Организация
		|	И ИзменениеУсловийСделки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИзменениеУсловийСделки.МоментВремени <= &МоментВремени
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.Ссылка
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.ПерваяЧастьРЕПО = &Сделка
		|	И СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПО.МоментВремени <= &МоментВремени";
	
	Запрос.Выполнить();
	
	Если ТипЗначенияСделки = Тип("ДокументСсылка.Сделка") Тогда	
		
		// БухПартииЦенныхБумаг
		// БухПартииЦенныхБумагКПолучению
		// ЗадолженностиПоДенежнымСредствам
		// ЗадолженностиПоЦеннымБумагам
		// ОстаткиДенежныхСредств
		// ОстаткиЦенныхБумаг
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	""БухПартииЦенныхБумаг"" КАК ИмяРегистра,
			|	БухПартииЦенныхБумаг.Период КАК Период,
			|	БухПартииЦенныхБумаг.Регистратор КАК Регистратор,
			|	БухПартииЦенныхБумаг.НомерСтроки КАК НомерСтроки,
			|	БухПартииЦенныхБумаг.Активность КАК Активность,
