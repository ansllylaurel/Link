
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Данные.Сделка) = Тип("ДокументСсылка.СделкаСВалютой") Тогда 
		Представление = "Отмена сделки с валютой " + Данные.Номер + " от " + Данные.Дата;
	ИначеЕсли ТипЗнч(Данные.Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда 
		Представление = "Отмена сделки РЕПО " + Данные.Номер + " от " + Данные.Дата;
	Иначе
		Представление = "Отмена сделки " + Данные.Номер + " от " + Данные.Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("Сделка");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
