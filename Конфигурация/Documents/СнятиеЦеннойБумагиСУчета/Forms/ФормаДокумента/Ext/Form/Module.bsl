
&НаСервереБезКонтекста
Функция ПолучитьКоличествоЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, ДепозитарныйСчет, ЦеннаяБумага)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ДепозитарныйСчет = &ДепозитарныйСчет
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки";
		
	Запрос.УстановитьПараметр("Период",                       ?(ТипЗнч(Период) = Тип("Дата") Или ТипЗнч(Период) = Тип("МоментВремени"), Новый Граница(Период, ВидГраницы.Исключая), Период));
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарныйСчет",             ДепозитарныйСчет);
	Запрос.УстановитьПараметр("ЦеннаяБумага",                 ЦеннаяБумага);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоОстаток;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции // ПолучитьКоличествоЦенныхБумаг

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Элементы.ЦеннаяБумага.ОграничениеТипа = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура ОбновитьКоличествоЦенныхБумаг()
	
	Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И ЗначениеЗаполнено(Объект.ДепозитарныйСчет) И ЗначениеЗаполнено(Объект.ЦеннаяБумага) Тогда
		
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Период = Объект.Дата;
		Иначе
			Период = Неопределено;
		КонецЕсли;
		
		НовоеКоличество = ПолучитьКоличествоЦенныхБумаг(Период, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДепозитарныйСчет, Объект.ЦеннаяБумага);
		
		Если НовоеКоличество = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ценная бумага '" + Объект.ЦеннаяБумага + "' на счете депо '" + Объект.ДепозитарныйСчет + "' по клиенту '" + ОбщегоНазначенияКлиентСервер.ПервоеЗаполненноеЗначение(Объект.СчетДоверительногоУправления) + "' отсутсвует");
			Возврат;
		КонецЕсли;		
		
		Если      Объект.Количество = 0 Тогда
			Объект.Количество = НовоеКоличество;
		ИначеЕсли Объект.Количество <> НовоеКоличество Тогда
			Если Вопрос("Изменить количество ценных бумаг на " + НовоеКоличество + " (доступный остаток)?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Объект.Количество = НовоеКоличество;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ОбновитьКоличествоЦенныхБумаг

#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьПодтверждениеОперацииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоЦеннымБумагам",
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, ДепозитарныйСчет"))
	Тогда
		Объект.ДепозитарныйСчет = Неопределено;
	КонецЕсли;		
	
	ОбновитьКоличествоЦенныхБумаг();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьКоличествоЦенныхБумаг();
	
КонецПроцедуры

&НаКлиенте
Процедура ДепозитарныйСчетПриИзменении(Элемент)
	
	ОбновитьКоличествоЦенныхБумаг();
	
КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)

	Элементы["ЦеннаяБумага"].ОграничениеТипа = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеннаяБумагаПриИзменении(Элемент)
	
	ОбновитьКоличествоЦенныхБумаг();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаВыбратьИсполнителяПоЦеннымБумагам(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоЦеннымБумагам(ЭтаФорма,);
	
	ОбновитьКоличествоЦенныхБумаг();
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры
