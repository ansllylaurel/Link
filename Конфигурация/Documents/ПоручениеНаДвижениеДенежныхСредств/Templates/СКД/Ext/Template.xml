		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	ВЫБОР
		КОГДА СУММА(ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток) = 0
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ФлЕстьОстаток
ПОМЕСТИТЬ _ОстаткиАктивов
ИЗ
	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(&amp;НачалоДня, &amp;КонецДня, День, , Организация = &amp;Организация) КАК ОстаткиДенежныхСредствОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления,
	ВЫБОР
		КОГДА СУММА(ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток) = 0
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ
ИЗ
	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(&amp;НачалоДня, &amp;КонецДня, День, , Организация = &amp;Организация) КАК ОстаткиЦенныхБумагОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Ссылка,
	ПоручениеНаДвижениеДенежныхСредств.Организация КАК Организация,
	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления.Наименование КАК НаименованиеСчета,
	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления.КодСчета КАК КодСчета,
	ПоручениеНаДвижениеДенежныхСредств.ТипЗадолженности КАК ТипЗадолженности,
	ПоручениеНаДвижениеДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
	ПоручениеНаДвижениеДенежныхСредств.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
	ПоручениеНаДвижениеДенежныхСредств.Сумма КАК Сумма,
	ПоручениеНаДвижениеДенежныхСредств.Валюта КАК Валюта,
	ПоручениеНаДвижениеДенежныхСредств.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	ПоручениеНаДвижениеДенежныхСредств.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов КАК ВыводВсехАктивов,
	ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияС КАК ДатаИсполненияС,
	ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо КАК ДатаИсполненияПо,
	ВЫБОР
		КОГДА ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо &gt;= &amp;НачалоДня
			ТОГДА РАЗНОСТЬДАТ(&amp;НачалоДня, ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо, ДЕНЬ)
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоДнейДоКрайнейДатыВывода,
	ВЫБОР
		КОГДА ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				И &amp;НачалоДня &gt;= НАЧАЛОПЕРИОДА(ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо, ДЕНЬ)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ДатаВыводаНаступила,
	ВЫБОР
		КОГДА ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов
			ТОГДА НЕ ОстаткиАктивов.ФлЕстьОстаток
		ИНАЧЕ ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.СуммаКонечныйОстаток = 0
	КОНЕЦ КАК Исполнено,
	ВЫБОР
		КОГДА НЕ ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов
			ТОГДА ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.СуммаКонечныйОстаток &gt; 0
					И ПоручениеНаДвижениеДенежныхСредств.Сумма &lt;&gt; ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.СуммаКонечныйОстаток
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ИсполненоЧастично,
	ВЫБОР
		КОГДА ЗадачаИсполнителя.Ссылка ЕСТЬ NULL
				ИЛИ НЕ ВложенныйЗапрос.Основание ЕСТЬ NULL
			ТОГДА 0
		КОГДА ЗадачаИсполнителя.Выполнена
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ КАК СтатусСогласования,
	ЗадачаИсполнителя.Ссылка КАК Согласование
ИЗ
	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.ОстаткиИОбороты(&amp;НачалоДня, &amp;КонецДня, День, , Организация = &amp;Организация) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты
		ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.Основание
		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = ЗадачаИсполнителя.Основание
			И (ЗадачаИсполнителя.Организация = &amp;Организация)
			И (ТИПЗНАЧЕНИЯ(ЗадачаИсполнителя.БизнесПроцесс) = ТИП(БизнесПроцесс.СогласованиеПорученийНаВыводАктивов))
			И (ЗадачаИсполнителя.ГруппаИсполнителей В
				(ВЫБРАТЬ
					СоставГруппПользователей.ГруппаПользователей КАК Группа
				ИЗ
					РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
				ГДЕ
					СоставГруппПользователей.ГруппаПользователей.Организация = &amp;Организация
					И СоставГруппПользователей.Пользователь = &amp;Исполнитель))
			И (НЕ ЗадачаИсполнителя.ПометкаУдаления)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			_ОстаткиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			МАКСИМУМ(_ОстаткиАктивов.ФлЕстьОстаток) КАК ФлЕстьОстаток
		ИЗ
			_ОстаткиАктивов КАК _ОстаткиАктивов
		
		СГРУППИРОВАТЬ ПО
			_ОстаткиАктивов.СчетДоверительногоУправления) КАК ОстаткиАктивов
		ПО ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления = ОстаткиАктивов.СчетДоверительногоУправления
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
		ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = СписаниеЗадолженностейПоПоручению.Поручение
			И (СписаниеЗадолженностейПоПоручению.Проведен)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			СогласованиеПорученийНаВыводАктивов.Основание КАК Основание
		ИЗ
			БизнесПроцесс.СогласованиеПорученийНаВыводАктивов КАК СогласованиеПорученийНаВыводАктивов
		ГДЕ
			СогласованиеПорученийНаВыводАктивов.Организация = &amp;Организация
			И НЕ СогласованиеПорученийНаВыводАктивов.ПометкаУдаления
			И СогласованиеПорученийНаВыводАктивов.Отменен) КАК ВложенныйЗапрос
		ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = ВложенныйЗапрос.Основание
ГДЕ
	ПоручениеНаДвижениеДенежныхСредств.Проведен
	И ПоручениеНаДвижениеДенежныхСредств.Организация = &amp;Организация
	И СписаниеЗадолженностейПоПоручению.Ссылка ЕСТЬ NULL
	И ВЫБОР
			КОГДА ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов
				ТОГДА НЕ ОстаткиАктивов.СчетДоверительногоУправления ЕСТЬ NULL
			ИНАЧЕ НЕ ЗадолженностиПоДенежнымСредствамПоПоручениямОстаткиИОбороты.Основание ЕСТЬ NULL
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ТипЗадолженности = 1
				ТОГДА ПоручениеНаДвижениеДенежныхСредств.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			КОГДА &amp;ТипЗадолженности = 2
				ТОГДА ПоручениеНаДвижениеДенежныхСредств.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ВыводВсехАктивов = 0
				ТОГДА ИСТИНА
			ИНАЧЕ ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов = (&amp;ВыводВсехАктивов = 1)
		КОНЕЦ
	И (&amp;СчетДУ В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			ИЛИ ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления = &amp;СчетДУ)
	И ВЫБОР
			КОГДА &amp;ДатаИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
					И &amp;ОтборПоДатеИсполнения &lt;&gt; 0
				ТОГДА &amp;ОтборПоДатеИсполнения = 1
							И ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияС = &amp;ДатаИсполнения
						ИЛИ &amp;ОтборПоДатеИсполнения = 2
							И ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо = &amp;ДатаИсполнения
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
	</dataSet>
