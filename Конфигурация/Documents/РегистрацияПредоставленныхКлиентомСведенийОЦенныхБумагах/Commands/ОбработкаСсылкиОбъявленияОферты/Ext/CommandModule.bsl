
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды.Количество() = 3 Тогда
	
		ПараметрыФормы = Новый Структура("ЦеннаяБумага, Клиент, Организация", ПараметрКоманды[0], ПараметрКоманды[1], ПараметрКоманды[2]);
		ОткрытьФорму("Документ.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах.Форма.ФормаДокумента", ПараметрыФормы);
	
	КонецЕсли;
	
КонецПроцедуры
