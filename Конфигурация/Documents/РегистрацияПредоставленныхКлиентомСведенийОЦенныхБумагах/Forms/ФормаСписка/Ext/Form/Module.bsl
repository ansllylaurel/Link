
&НаКлиенте
Процедура Отчет(Команда)
	
	КлиентОтбор = Неопределено;
	ОблигацияОтбор = Неопределено;
	
	Для каждого ПользовательскаяНастройка Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		
		Если ТипЗнч(ПользовательскаяНастройка) = Тип("ОтборКомпоновкиДанных") Тогда
			
			Для каждого ЭлементНастройки Из ПользовательскаяНастройка.Элементы Цикл
			
				Если ЭлементНастройки.ВидСравнения = ПредопределенноеЗначение("ВидСравненияКомпоновкиДанных.Равно")
					И ЭлементНастройки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Клиент")
					И ТипЗнч(ЭлементНастройки.ПравоеЗначение) = Тип("СправочникСсылка.ЮрФизЛица")
					И ЭлементНастройки.Использование Тогда
				
					КлиентОтбор = ЭлементНастройки.ПравоеЗначение
				
				КонецЕсли;
				
				Если ЭлементНастройки.ВидСравнения = ПредопределенноеЗначение("ВидСравненияКомпоновкиДанных.Равно")
					И ЭлементНастройки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦеннаяБумага")
					И ТипЗнч(ЭлементНастройки.ПравоеЗначение) = Тип("СправочникСсылка.Облигации")
					И ЭлементНастройки.Использование Тогда
				
					ОблигацияОтбор = ЭлементНастройки.ПравоеЗначение
				
				КонецЕсли;
			
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЦикла;
	
	ФормаОтчета = ПолучитьФорму("Отчет.РешенияКлиентовПоЗначениямЭСП.Форма");
	
	ФормаОтчета.Клиент = КлиентОтбор;
	ФормаОтчета.ЦеннаяБумага = ОблигацияОтбор;
	
	ФормаОтчета.Открыть();
	
КонецПроцедуры
