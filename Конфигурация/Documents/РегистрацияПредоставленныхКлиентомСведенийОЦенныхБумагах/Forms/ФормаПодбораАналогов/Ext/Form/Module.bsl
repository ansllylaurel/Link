
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЭтаФорма.Параметры.Свойство("ПараметрыПодбора") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры.ПараметрыПодбора);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	ОбновитьМетодикуНаСервере();
		
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) И ЗначениеЗаполнено(ЭтотОбъект.Период) И ЗначениеЗаполнено(ЭтотОбъект.Методика) Тогда	
		ЗаполнитьАналоги();	
	КонецЕсли;
	
	ПересчитатьИтогиПоАналогам(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если ЭтаФорма.Параметры.ЗакрыватьПриВыборе = Неопределено Тогда
		Элементы.ВыполнитьВыбор.Видимость			= Ложь;
		Элементы.ЗаполнитьАналоги.КнопкаПоУмолчанию	= Истина;
	КонецЕсли;	
		
	Элементы.Организация.Видимость			= РаботаСПользователями.ЭтоПолноправныйПользователь();
	Элементы.ОрганизацияНадпись.Видимость	= Не Элементы.Организация.Видимость;
	
КонецПроцедуры

