&НаКлиенте
Процедура АналогиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.АналогиЗначение Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОткрытьЗначение(Элементы.Аналоги.ТекущиеДанные.Значение);
		
	КонецЕсли;
	
