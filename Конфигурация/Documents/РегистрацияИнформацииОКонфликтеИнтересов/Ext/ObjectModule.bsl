
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	ЭтотОбъект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонфликтыИнтересов") Тогда
		
		ЭтотОбъект.СчетДоверительногоУправления = ДанныеЗаполнения.СчетДоверительногоУправления;
		ЭтотОбъект.КонфликтИнтересов = ДанныеЗаполнения;
		
		ДанныеКонфликтов = Справочники.КонфликтыИнтересов.ПолучитьТаблицуДанныеКонфликтов();
		НоваяСтрока = ДанныеКонфликтов.Добавить();
		НоваяСтрока.КонфликтИнтересов = ДанныеЗаполнения;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения);
		
		РеквизитыКИ = Справочники.КонфликтыИнтересов.ПолучитьРеквизитыКонфликтовИнтересов(ДанныеКонфликтов);
		
		Если РеквизитыКИ.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыКИ[0], "СведенияОКлиенте, СодержаниеКонфликтаИнтересов");
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

