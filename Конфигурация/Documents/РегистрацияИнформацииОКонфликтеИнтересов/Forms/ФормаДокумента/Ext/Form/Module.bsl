
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура КонфликтИнтересовПриИзменении(Элемент)
	
	КонфликтИнтересовПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидИнформацииПриИзменении(Элемент)
	
	УстановитьЗаголовокСодержанияКонфликта(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура КонфликтИнтересовПриИзмененииНаСервере()

	ИменаРеквизитов = "Организация, СчетДоверительногоУправления, ДатаВозникновения, СвязанноеЛицо";
	РеквизитыКонфликта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КонфликтИнтересов, ИменаРеквизитов);
	
	ДанныеКонфликтов = Справочники.КонфликтыИнтересов.ПолучитьТаблицуДанныеКонфликтов();
	НоваяСтрока = ДанныеКонфликтов.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыКонфликта);
	НоваяСтрока.КонфликтИнтересов = Объект.КонфликтИнтересов;
	
	Реквизиты = Справочники.КонфликтыИнтересов.ПолучитьРеквизитыКонфликтовИнтересов(ДанныеКонфликтов);
	
	Если Реквизиты.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(Объект, Реквизиты[0], "СведенияОКлиенте, СодержаниеКонфликтаИнтересов");
		Объект.СчетДоверительногоУправления = РеквизитыКонфликта.СчетДоверительногоУправления;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить содержание конфликта и сведения о клинете");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	УстановитьЗаголовокСодержанияКонфликта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСодержанияКонфликта(ЭтаФорма)

	Если ЭтаФорма.Объект.ВидСобытия = ПредопределенноеЗначение("Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение") Тогда
		Заголовок = "Обстоятельства прекращения конфликта";
	Иначе
		Заголовок = "Содержание конфликта интересов";	
	КонецЕсли;
	
	ЭтаФорма.Элементы.СодержаниеКонфликтаИнтересов.Заголовок = Заголовок;

КонецПроцедуры

#КонецОбласти 

