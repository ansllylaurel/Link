Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	ЭтотОбъект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВнутреннийДокумент") Тогда
		
		ЭтотОбъект.ВидВнутреннегоДокумента = Справочники.ВидыВнутреннихДокументов.Приказ;
		ЭтотОбъект.Основание = ДанныеЗаполнения;
		                                                                    
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "НаименованиеДокумента, ДатаНачалаДействия, КраткоеСодержание, ДатаОкончанияДействия");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийВнутреннихДокументов.НазначениеДолжностногоЛица 
		Или ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийВнутреннихДокументов.СнятиеДолжностногоЛица Тогда
	
		ПроверяемыеРеквизиты.Добавить("ВидДолжностногоЛица");
		ПроверяемыеРеквизиты.Добавить("Сотрудник");
		ПроверяемыеРеквизиты.Добавить("ДатаНачалаДействия");
		
	ИначеЕсли ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийВнутреннихДокументов.НазначениеИсполняющегоОбязанности  Тогда 
		
		ПроверяемыеРеквизиты.Добавить("ВидДолжностногоЛица");
		ПроверяемыеРеквизиты.Добавить("Заместитель");
		ПроверяемыеРеквизиты.Добавить("ДатаНачалаДействия");
		ПроверяемыеРеквизиты.Добавить("ДатаОценки");
		
	ИначеЕсли ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийВнутреннихДокументов.ПрекращениеИсполненияОбязанностей Тогда 
		
		ПроверяемыеРеквизиты.Добавить("ВидДолжностногоЛица");
		ПроверяемыеРеквизиты.Добавить("Заместитель");
		ПроверяемыеРеквизиты.Добавить("ДатаНачалаДействия");
		
	ИначеЕсли (ЗначениеЗаполнено(ЭтотОбъект.ВидВнутреннегоДокумента) 
		И ЭтотОбъект.ВидВнутреннегоДокумента.ПринадлежитЭлементу(Справочники.ВидыВнутреннихДокументов.Распорядительные)) Тогда 
		
		ПроверяемыеРеквизиты.Добавить("ДатаНачалаДействия");
		ПроверяемыеРеквизиты.Добавить("ВидВнутреннегоДокумента");
		ПроверяемыеРеквизиты.Добавить("Подготовил");
		
	КонецЕсли; 
	
	Если ЭтотОбъект.ВидВнутреннегоДокумента = Справочники.ВидыВнутреннихДокументов.Приказ Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("НаименованиеДокумента"));
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидВнутреннегоДокумента)
		И ЭтотОбъект.ВидВнутреннегоДокумента.ПринадлежитЭлементу(Справочники.ВидыВнутреннихДокументов.Распорядительные) Тогда
		
		ЭтотОбъект.ПоХозяйственнойДеятельности 		= Ложь;
		ЭтотОбъект.ПоЛицензииУКПИФ 					= Ложь;
		ЭтотОбъект.ПоЛицензииДУ 					= Ложь;
		ЭтотОбъект.ВСоответствииСЗаконодательством 	= Ложь;
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			ПроверитьПодписанта(Отказ);
			ПроверитьПериодДействия(Отказ);
					
		КонецЕсли;
		
	Иначе
		
		ЭтотОбъект.Подписал = Неопределено;
		
	КонецЕсли;
	
	Если ЭтотОбъект.ВидОперации <> Перечисления.ВидыОперацийВнутреннихДокументов.НазначениеИсполняющегоОбязанности Тогда
		ЭтотОбъект.ДатаОценки = Неопределено;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ВСоответствииСЗаконодательством Тогда
		ЭтотОбъект.ПравовоеОбоснование = "";
	КонецЕсли; 
	
	Если (ЭтотОбъект.ВидВнутреннегоДокумента = Справочники.ВидыВнутреннихДокументов.Решение ИЛИ ЭтотОбъект.ВидВнутреннегоДокумента = Справочники.ВидыВнутреннихДокументов.Протокол) 
		И ЭтотОбъект.ВидДолжностногоЛица <> Перечисления.ВидыДолжностныхЛиц.Руководитель Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Решение или протокол могут изменить состояние только Руководителя",,,, Отказ); 
	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
	
		ЭтотОбъект.Сотрудник = Неопределено;
		ЭтотОбъект.Заместитель = Неопределено;
		ЭтотОбъект.ДатаОценки = Неопределено;
		ЭтотОбъект.ВидДолжностногоЛица = Неопределено;
	
	КонецЕсли; 
	
	Если ЭтотОбъект.ВидВнутреннегоДокумента = Справочники.ВидыВнутреннихДокументов.Приказ 
		И Не ЗначениеЗаполнено(ЭтотОбъект.НаименованиеДокумента) Тогда
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Номер) Тогда
			ЭтотОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
		ЭтотОбъект.НаименованиеДокумента = СтрШаблон("Приказ №%1 от %2 г.", 
			СокрЛП(ЭтотОбъект.Номер),
			Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ВидДолжностногоЛица", ЭтотОбъект.ВидДолжностногоЛица);
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДолжностныеЛицаОрганизацийСрезПоследних.Период КАК Период,
			|	ДолжностныеЛицаОрганизацийСрезПоследних.Регистратор КАК Регистратор,
			|	ДолжностныеЛицаОрганизацийСрезПоследних.Сотрудник КАК Сотрудник,
			|	ДолжностныеЛицаОрганизацийСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ ДолжностныеЛицаОрганизацийСрезПоследних.ДатаОкончания >= &Период КАК Действует
			|ИЗ
			|	РегистрСведений.ДолжностныеЛицаОрганизаций.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ВидДолжностногоЛица = &ВидДолжностногоЛица
			|				И ИсполняющийОбязанности = &ИсполняющийОбязанности
			|				И Регистратор <> &Регистратор) КАК ДолжностныеЛицаОрганизацийСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
			|		ПО ДолжностныеЛицаОрганизацийСрезПоследних.Сотрудник = Сотрудники.Ссылка
			|ГДЕ
			|	&ОтборПоСотруднику";
		
		ОтборПоСотруднику = 
			"Сотрудники.ЮрФизЛицо = &ЮрФизЛицо";
		
		ПараметрыДвижения = Новый Структура("Период, Сотрудник, ИсполняющийОбязанности, ДатаОкончания");
		ВидыОпераций = Перечисления.ВидыОперацийВнутреннихДокументов;
		
		Отборы = Новый Массив;
		
		Если ЭтотОбъект.ВидОперации = ВидыОпераций.НазначениеДолжностногоЛица Тогда
			
			ПараметрыДвижения.Период = ЭтотОбъект.ДатаНачалаДействия;
			ПараметрыДвижения.Сотрудник = ЭтотОбъект.Сотрудник;
			ПараметрыДвижения.ИсполняющийОбязанности = Ложь;
			ПараметрыДвижения.ДатаОкончания = ЭтотОбъект.ДатаОкончанияДействия;
			
			// разрешаем назначить любого сотрудника, если на текущий момент нет другого действующего ДЛ
			НеобходимДействующийИсполнительРоли = Ложь;
			СообщениеОбОшибке = "Должностное лицо '%1' уже назначено документом: %2";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоСотруднику", "ИСТИНА");
			
		ИначеЕсли ЭтотОбъект.ВидОперации = ВидыОпераций.СнятиеДолжностногоЛица Тогда  
			
			ПараметрыДвижения.Период = ЭтотОбъект.ДатаНачалаДействия;
			ПараметрыДвижения.Сотрудник = ЭтотОбъект.Сотрудник;
			ПараметрыДвижения.ИсполняющийОбязанности = Ложь;
			ПараметрыДвижения.ДатаОкончания = ЭтотОбъект.ДатаНачалаДействия;
			
			// разрешаем снять только того, кто сейчас занимает эту роль
			НеобходимДействующийИсполнительРоли = Истина;
			СообщениеОбОшибке = "Сначала необходимо назначить должностное лицо";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоСотруднику", ОтборПоСотруднику);	
						
		ИначеЕсли ЭтотОбъект.ВидОперации = ВидыОпераций.НазначениеИсполняющегоОбязанности Тогда  
			
			ПараметрыДвижения.Период = ЭтотОбъект.ДатаНачалаДействия;
			ПараметрыДвижения.Сотрудник = ЭтотОбъект.Заместитель;
			ПараметрыДвижения.ИсполняющийОбязанности = Истина;
			ПараметрыДвижения.ДатаОкончания = ЭтотОбъект.ДатаОкончанияДействия;
			// разрешаем назначить любого сотрудника, если на текущий момент нет другого действующего ДЛ
			НеобходимДействующийИсполнительРоли = Ложь;
			СообщениеОбОшибке = "Исполняющий обязанности должностного лица '%1' уже назначен документом: %2";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоСотруднику", "ИСТИНА");
			
		ИначеЕсли ЭтотОбъект.ВидОперации = ВидыОпераций.ПрекращениеИсполненияОбязанностей Тогда  
			
			ПараметрыДвижения.Период = НачалоДня(ЭтотОбъект.ДатаНачалаДействия - 1);
			ПараметрыДвижения.Сотрудник = ЭтотОбъект.Заместитель;
			ПараметрыДвижения.ИсполняющийОбязанности = Истина;
			ПараметрыДвижения.ДатаОкончания = ПараметрыДвижения.Период;
			// разрешаем снять только того, кто сейчас занимает эту роль
			НеобходимДействующийИсполнительРоли = Истина;
			СообщениеОбОшибке = "Сначала необходимо назначить исполняющего обязанности";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоСотруднику", ОтборПоСотруднику);	
			
		Иначе 
			Возврат;
		КонецЕсли; 
		
		ЮрФизЛицоСотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыДвижения.Сотрудник, "ЮрФизЛицо"); 
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("Период", ПараметрыДвижения.Период);
		Запрос.УстановитьПараметр("ИсполняющийОбязанности", ПараметрыДвижения.ИсполняющийОбязанности);
		Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицоСотрудник);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		ЕстьДействующийИсполнительРоли = Выборка.Следующий() И Выборка.Действует;
		
		Если НеобходимДействующийИсполнительРоли <> ЕстьДействующийИсполнительРоли Тогда
			
			Если ЕстьДействующийИсполнительРоли Тогда
				СообщениеОбОшибке = СтрШаблон(СообщениеОбОшибке, ЭтотОбъект.ВидДолжностногоЛица, Выборка.Регистратор);
			КонецЕсли; 
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, ЭтотОбъект.Ссылка,,, Отказ);

		КонецЕсли; 
		
		Движения.ДолжностныеЛицаОрганизаций.Записывать = Истина;
		Движение = Движения.ДолжностныеЛицаОрганизаций.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, ЭтотОбъект, "Организация, ВидДолжностногоЛица");
		ЗаполнитьЗначенияСвойств(Движение, ПараметрыДвижения);
						
	КонецЕсли;
	          	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидВнутреннегоДокумента)
		И ЭтотОбъект.ВидВнутреннегоДокумента.ПринадлежитЭлементу(Справочники.ВидыВнутреннихДокументов.Распорядительные) Тогда
		
		РаботаСДокументооборотом.ПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПодписанта(Отказ)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДолжностныеЛицаОрганизацийСрезПоследних.Период КАК Период,
		|	ДолжностныеЛицаОрганизацийСрезПоследних.Сотрудник.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.ДолжностныеЛицаОрганизаций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ВидДолжностногоЛица = ЗНАЧЕНИЕ(Перечисление.ВидыДолжностныхЛиц.Руководитель)) КАК ДолжностныеЛицаОрганизацийСрезПоследних
		|ГДЕ
		|	(ДолжностныеЛицаОрганизацийСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ДолжностныеЛицаОрганизацийСрезПоследних.ДатаОкончания >= &Период)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДолжностныеЛицаОрганизацийСрезПоследних.Период УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СообщенияОбОшибках = Новый Массив;
	СообщенияОбОшибках.Добавить("Подписать распорядительный документ может только руководитель или исполняющий его обязанности");
		
	Если Выборка.Следующий() Тогда
		
		Если ЭтотОбъект.Подписал <> Выборка.ЮрФизЛицо Тогда
			СообщенияОбОшибках.Добавить(СтрШаблон("На дату документа %1 руководителем является %2",
				Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"),
				Выборка.ЮрФизЛицо));
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ВидДолжностногоЛица = Перечисления.ВидыДолжностныхЛиц.Руководитель Тогда
		
		ФизЛицоСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Сотрудник, "ЮрФизЛицо");
		Если ЭтотОбъект.Подписал <> ФизЛицоСотрудника Тогда
			СообщенияОбОшибках.Добавить("На дату документа руководитель не назначен");
		КонецЕсли;
		
	Иначе
		
		СообщенияОбОшибках.Добавить("На дату документа руководитель не назначен");
		
	КонецЕсли;
	
	Если СообщенияОбОшибках.Количество() > 1 Тогда
	
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(СообщенияОбОшибках, Символы.ПС), ЭтотОбъект.Ссылка,,, Отказ);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПериодДействия(Отказ)

	ТекстСообщения = "Дата начала действия не может быть";
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончанияДействия) И ЭтотОбъект.ДатаОкончанияДействия < ЭтотОбъект.ДатаНачалаДействия Тогда
		ТекстСообщения = ТекстСообщения + " позднее даты окончания";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка,, "Объект.ДатаНачалаДействия", Отказ);
	КонецЕсли;
	Если ЭтотОбъект.ДатаНачалаДействия < НачалоДня(ЭтотОбъект.Дата) Тогда
		ТекстСообщения = ТекстСообщения + " ранее даты приказа";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка,, "Объект.ДатаНачалаДействия", Отказ);
	КонецЕсли;

КонецПроцедуры