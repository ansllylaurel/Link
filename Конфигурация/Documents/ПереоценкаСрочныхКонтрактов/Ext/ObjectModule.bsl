Процедура ОбработкаПроведенияЕПС(Отказ, Режим)
	МассивУчетныхАктивов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииСрочныхКонтрактовОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииСрочныхКонтрактовОстатки.Партия КАК Партия,
		|	БухПартииСрочныхКонтрактовОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииСрочныхКонтрактовОстатки.ВидСделки КАК ВидСделки,
		|	БухПартииСрочныхКонтрактовОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток КАК СтоимостьОстаток,
		|	БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииСрочныхКонтрактовОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток,
		|	БухПартииСрочныхКонтрактовОстатки.СтоимостьБазовогоАктиваВВалютеУчетаОстаток КАК СтоимостьБазовогоАктиваВВалютеУчетаОстаток,
		|	КотировкиТорговыхПлощадок.SETTLEPRICE КАК РасчетнаяЦена,
		|	БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток + БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток КАК БалансоваяСтоимость,
		|	БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток * КотировкиТорговыхПлощадок.SETTLEPRICE КАК РыночнаяСтоимость,
		|	ВЫБОР
		|		КОГДА БухПартииСрочныхКонтрактовОстатки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток * КотировкиТорговыхПлощадок.SETTLEPRICE - (БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток + БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток)
		|		ИНАЧЕ БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток + БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток - БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток * КотировкиТорговыхПлощадок.SETTLEPRICE
		|	КОНЕЦ КАК Переоценка,
		|	БухПартииСрочныхКонтрактовОстатки.КоличествоОстаток * КотировкиТорговыхПлощадок.SETTLEPRICE - (БухПартииСрочныхКонтрактовОстатки.СтоимостьПокупкиОстаток + БухПартииСрочныхКонтрактовОстатки.ПереоценкаОстаток) КАК ИзменениеСтоимостиПартии
		|ИЗ
		|	РегистрНакопления.БухПартииСрочныхКонтрактов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииСрочныхКонтрактовОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО БухПартииСрочныхКонтрактовОстатки.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И (КотировкиТорговыхПлощадок.Период = &ДатаКотировок)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов = &РежимТоргов)";
	#КонецОбласти
	Запрос.УстановитьПараметр("ДатаКотировок", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РежимТоргов", ОбщегоНазначения.ПолучитьИменованныйОбъект("РежимТоргов_ФОРТС"));
	
	// #381119: Хардкод для Сафмара по фьючерсам, т.к. непонятно пока, какую делать настройку
	МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
		ЭтотОбъект.Дата);
	
	ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	Если ЭтоКлиентСАФМАР Тогда // Всё у Сафмара по-особенному...
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "SETTLEPRICE", "CLOSE");
	КонецЕсли;
	
	ПартииПереоценки = Запрос.Выполнить().Выгрузить();
	
	Акции = Новый Массив;
	Для Каждого СтрокаПартииПереоценки Из ПартииПереоценки Цикл
		Если ТипЗнч(СтрокаПартииПереоценки.ЦеннаяБумага.БазовыйАктив) = Тип("СправочникСсылка.Акции")
			И Акции.Найти(СтрокаПартииПереоценки.ЦеннаяБумага.БазовыйАктив) = Неопределено
		Тогда
			Акции.Добавить(СтрокаПартииПереоценки.ЦеннаяБумага.БазовыйАктив);
		КонецЕсли;
	КонецЦикла;
	
	Если Акции.Количество() <> 0 Тогда
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",					ЭтотОбъект.Организация);
		ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
		ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
		ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
		ПараметрыРасчета.Вставить("Дата",							КонецДня(ЭтотОбъект.Дата));
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
			ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
		ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий);
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
		
		РСП = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(РСП, ПараметрыРасчета);
		РСП.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
		РСП.ДополнительныеСвойства.Вставить("ВыполнятьРасчетПоУказаниюЦБ", Ложь);
		
		ОцениваемыеБумаги = Новый ТаблицаЗначений;
		
		ОцениваемыеБумаги.Колонки.Добавить("ЦеннаяБумага",		Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("Количество",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("ВидДвижения",		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
		ОцениваемыеБумаги.Колонки.Добавить("Рынок",				Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		ОцениваемыеБумаги.Колонки.Добавить("ТипЗадолженности",	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		
		ОцениваемыеБумаги.Колонки.Добавить("Партия",						Метаданные.ОпределяемыеТипы.Партия.Тип);
		ОцениваемыеБумаги.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
		ОцениваемыеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ОцениваемыеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
		
		Для Каждого Акция Из Акции Цикл
			СтрокаОцениваемыеБумаги = ОцениваемыеБумаги.Добавить();
			СтрокаОцениваемыеБумаги.ЦеннаяБумага = Акция;
			СтрокаОцениваемыеБумаги.Количество = 1;
			СтрокаОцениваемыеБумаги.ВидДвижения = Перечисления.ВидыДвижений.Приход;
			СтрокаОцениваемыеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции;
		КонецЦикла;
		
		РСП.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ОцениваемыеБумаги, Истина);
		ТаблицаСтоимостейАкций = РСП.СтоимостиПереоценки.Выгрузить();
	КонецЕсли;
	
	// Движения по партиям
	Для Каждого СтрокаПартииПереоценки Из ПартииПереоценки Цикл
		Если СтрокаПартииПереоценки.РасчетнаяЦена = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует котировка фьючерса: " + СокрЛП(СтрокаПартииПереоценки.ЦеннаяБумага),,,, Отказ);
			Возврат;
		КонецЕсли;
		
		Если МассивУчетныхАктивов.Найти(СтрокаПартииПереоценки.УчетныйАктивЕПС) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(СтрокаПартииПереоценки.УчетныйАктивЕПС);
		КонецЕсли;
		
		Движение = Движения.БухПартииСрочныхКонтрактов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = ЭтотОбъект.Дата;
		Движение.Организация = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ВидУчета = ЭтотОбъект.ВидУчета;
		Движение.ЦеннаяБумага = СтрокаПартииПереоценки.ЦеннаяБумага;
		Движение.Партия = СтрокаПартииПереоценки.Партия;
		Движение.СтрокаПартии = СтрокаПартииПереоценки.СтрокаПартии;
		Движение.ВидСделки = СтрокаПартииПереоценки.ВидСделки;
		Движение.УчетныйАктивЕПС = СтрокаПартииПереоценки.УчетныйАктивЕПС;
		Движение.Переоценка = СтрокаПартииПереоценки.ИзменениеСтоимостиПартии;
		Движение.ПереоценкаСНачалаГода = СтрокаПартииПереоценки.ИзменениеСтоимостиПартии;
		
		БазовыйАктив = СтрокаПартииПереоценки.ЦеннаяБумага.БазовыйАктив;
		
		Если ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.ВалютныеПары") Тогда
			СтоимостьБазовогоАктиваВВалюте = СтрокаПартииПереоценки.КоличествоОстаток * СтрокаПартииПереоценки.ЦеннаяБумага.Лот;
			СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Движение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета - СтрокаПартииПереоценки.СтоимостьБазовогоАктиваВВалютеУчетаОстаток;
		ИначеЕсли ТипЗнч(БазовыйАктив) = Тип("СправочникСсылка.Акции") Тогда
			СтоимостьБазовогоАктиваВВалюте = СтрокаПартииПереоценки.КоличествоОстаток
				* ТаблицаСтоимостейАкций.НайтиСтроки(Новый Структура("ЦеннаяБумага", БазовыйАктив))[0].ЦенаКотировки;
			СтоимостьБазовогоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
				СтоимостьБазовогоАктиваВВалюте, БазовыйАктив.ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Движение.СтоимостьБазовогоАктиваВВалютеУчета = СтоимостьБазовогоАктиваВВалютеУчета - СтрокаПартииПереоценки.СтоимостьБазовогоАктиваВВалютеУчетаОстаток;
		КонецЕсли;
	КонецЦикла;
	
	БиржаКонтрагент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ").ЮрФизЛицо;
	
	Переоценки = ПартииПереоценки.Скопировать();
	//Переоценки.Свернуть("ВидСделки, ЦеннаяБумага, УчетныйАктивЕПС", "Переоценка");
	
	Для Каждого СтрокаПереоценки Из Переоценки Цикл
		Если СтрокаПереоценки.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			АналитикаСделки = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПокупки;
		Иначе
			АналитикаСделки = Справочники.ДополнительныеАналитикиЛицевыхСчетов.СделкаПродажи;
		КонецЕсли;
		
		СуммаОперации = СтрокаПереоценки.Переоценка; // Никаких валют
		
		Если СуммаОперации > 0 Тогда // Намаржевали!
			// Проводка 1: Прибыль на фьючерс
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Переоценка фьючерсов");
			
			// Дебет
			Проводка.СчетДт = СтрокаПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиА;
			Проводка.СубконтоДт.ЦенныеБумаги = СтрокаПереоценки.ЦеннаяБумага;
			Проводка.ВалютаДт = ЭтотОбъект.Организация.ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = СтрокаПереоценки.Переоценка;
			
			// Кредит
			Проводка.СчетКт = СтрокаПереоценки.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = СтрокаПереоценки.УчетныйАктивЕПС.АналитикаДоходовОтОпераций;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПереоценки.ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаКт = АналитикаСделки;
			
			// Проводка 2: Фьючерс на вспомогательный
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Переоценка фьючерсов");
			
			// Дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоДт.ОснованиеРасчетов = СтрокаПереоценки.Партия;
			
			// Кредит
			Проводка.СчетКт = СтрокаПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиА;
			Проводка.СубконтоКт.ЦенныеБумаги = СтрокаПереоценки.ЦеннаяБумага;
			Проводка.ВалютаКт = ЭтотОбъект.Организация.ВалютаУчета;
			Проводка.ВалютнаяСуммаКт = СтрокаПереоценки.Переоценка;
			
			// Проводка 3: Вспомогательный на дебиторку
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Задолженность по вар.марже");
			
			// Дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
			Проводка.СубконтоДт.Контрагенты = БиржаКонтрагент;
			Проводка.ВалютаДт = ЭтотОбъект.Организация.ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = СтрокаПереоценки.Переоценка;
			
			// Кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ВспомогательныеСчета01;
			Проводка.СубконтоКт.ОснованиеРасчетов = СтрокаПереоценки.Партия;
			
