КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьИДоступность()
	
	ЭтаФорма.Элементы.ЦеннаяБумага.Доступность = ЗначениеЗаполнено(Объект.СчетДоверительногоУправления);
	ЭтаФорма.Элементы.ГруппаСтраницы.Доступность = ЗначениеЗаполнено(Объект.ЦеннаяБумага);
	
	ЭтаФорма.Элементы.ПартииПереоценка.Видимость = ЭтаФорма.ОтображатьПереоценку;
	ЭтаФорма.Элементы.ПартииБалансоваяПереоценка.Видимость = ЭтаФорма.ОтображатьБалансовуюПереоценку;
	
	ЭтаФорма.Элементы.ПартииКорректировкаЭСП.Видимость = ЭтаФорма.ОтображатьКорректировкуЭСП И Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	ЭтаФорма.Элементы.ПартииБалансоваяКорректировкаЭСП.Видимость = ЭтаФорма.ОтображатьБалансовуюКорректировкуЭСП;
	
	ЭтаФорма.Элементы.ПартииРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные.Видимость = Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	ЭтаФорма.Элементы.ПартииСуммаРезервовПодОбесценение.Видимость = Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	
	ЭтаФорма.Элементы.Партии1КорректировкаЭСПВВалютеУчета.Видимость = ЭтаФорма.ОтображатьКорректировкуЭСП И Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	ЭтаФорма.Элементы.Партии1БалансоваяКорректировкаЭСПВВалютеУчета.Видимость = ЭтаФорма.ОтображатьБалансовуюКорректировкуЭСП;
	ЭтаФорма.Элементы.Партии1РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета.Видимость = Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	ЭтаФорма.Элементы.Партии1СуммаРезервовПодОбесценение.Видимость = Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку;
	
	ЭтаФорма.Элементы.Партии1ПереоценкаВВалютеУчета.Видимость = ЭтаФорма.ОтображатьПереоценку;
	ЭтаФорма.Элементы.Партии1БалансоваяПереоценкаВВалютеУчета.Видимость = ЭтаФорма.ОтображатьБалансовуюПереоценку;
	
	ЭтаФорма.Элементы.Партии3ГруппаДооценка.Видимость = ЭтаФорма.ОтображатьБалансовуюПереоценку И Объект.Переоценивать;
	ЭтаФорма.Элементы.Партии3ГруппаДоначислениеДисконтаПремии.Видимость = Объект.НачислятьПроцентныеПоказатели;
	ЭтаФорма.Элементы.Партии3ГруппаДоначислениеКорректировкаЭСП.Видимость = ЭтаФорма.ОтображатьБалансовуюКорректировкуЭСП И Объект.НачислятьПроцентныеПоказатели;
	ЭтаФорма.Элементы.Партии3ГруппаДоначислениеРазницаПП.Видимость = Объект.НачислятьПроцентныеПоказатели;
	
	ЭтаФорма.Элементы.Переоценивать.Видимость = ЭтаФорма.ОтображатьБалансовуюПереоценку;
	ЭтаФорма.Элементы.ГруппаЦена.Видимость = Объект.Переоценивать;
	
КонецПроцедуры

&НаСервере
Функция ЭтоПереоцениваемыйВидАктива(УчетныйАктивЕПС, РасчетЦены = Ложь)
	
	Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		Возврат Ложь;	
	ИначеЕсли УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		ПроверяемыйАктив = УчетныйАктивЕПС;
	Иначе
		ПроверяемыйАктив = УчетныйАктивЕПС.Родитель;
	КонецЕсли;
	
	Если ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток
		ИЛИ ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
		ИЛИ ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой 
		ИЛИ ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи 
		Или (Объект.КорректировкаЭСПРазницаППРезервВПереоценку И Не РасчетЦены) Тогда
	
		Возврат Истина;	
	
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭтоКорректируемыйВидАктива(УчетныйАктивЕПС)
	
	Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		Возврат Ложь;	
	ИначеЕсли УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ПустаяСсылка() Тогда
		ПроверяемыйАктив = УчетныйАктивЕПС;
	Иначе
		ПроверяемыйАктив = УчетныйАктивЕПС.Родитель;
	КонецЕсли;
	
	Если ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
		ИЛИ ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД
		ИЛИ ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения Тогда
	
		Возврат Истина;	
		
	ИначеЕсли ПроверяемыйАктив = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток Тогда
		
		ВариантУчетаКупонногоДохода = БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ВариантУчетаКупонногоДохода");
		Если ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке Или Объект.Дата >= Дата(2024, 1, 1) Тогда
		
			Возврат Истина;	
		
		КонецЕсли;
		
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЦеннаяБумагаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("СправочникСсылка.Облигации") И ТипЗнч(ВыбранноеЗначение) <> Тип("Тип") Тогда
	
		СтандартнаяОбработка = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Реклассификация активов реализована только для облигаций");
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Объект.ЦеннаяБумага = ПредопределенноеЗначение("Справочник.Облигации.ПустаяСсылка");
	ЦеннаяБумагаПриИзменении(Неопределено);
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПартии()

	БалансовыеПартии = ПолучитьПартии();
	Объект.Партии.Загрузить(БалансовыеПартии);

	ЭтаФорма.СтарыйКласс = Справочники.УчетныеАктивыЕПС.ПустаяСсылка();
	Если БалансовыеПартии.Количество() > 0 Тогда
		ЭтаФорма.СтарыйКласс = БалансовыеПартии[0].УчетныйАктивЕПС.Родитель;
	КонецЕсли;
	
	Для каждого СтрокаПартии Из Объект.Партии Цикл
		
		СтрокаПартии.Стоимость = СтрокаПартии.БалансоваяСтоимость;
		СтрокаПартии.СтоимостьВВалютеУчета = СтрокаПартии.БалансоваяСтоимостьВВалютеУчета;
		
		СтрокаПартии.ДисконтПремияНачисленный = СтрокаПартии.БалансоваяДисконтПремияНачисленный;
		СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета = СтрокаПартии.БалансоваяДисконтПремияНачисленныйВВалютеУчета;
		
		Если Объект.БезДооценкиКупона Тогда
			СтрокаПартии.ДооценкаКупона = 0;
			СтрокаПартии.ДооценкаКупонаВВалютеУчета = 0;
		Иначе
			ЦенаКупона = Справочники.Облигации.ПолучитьКупон(Объект.ЦеннаяБумага, НачалоДня(Объект.Дата), Объект.СчетДоверительногоУправления);
			СтоимостьКупона = ЦенаКупона * СтрокаПартии.Количество;
			СтоимостьКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтоимостьКупона, Объект.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата);
			
			СтрокаПартии.ДооценкаКупона = СтоимостьКупона - СтрокаПартии.СтоимостьКупона - СтрокаПартии.ПереоценкаКупона;
			СтрокаПартии.ДооценкаКупонаВВалютеУчета = СтоимостьКупонаВВалютеУчета - СтрокаПартии.СтоимостьКупонаВВалютеУчета - СтрокаПартии.ПереоценкаКупонаВВалютеУчета;
		КонецЕсли;	
		
		СтрокаПартии.ПереоценкаКупона = СтрокаПартии.ПереоценкаКупона + СтрокаПартии.ДооценкаКупона;
		СтрокаПартии.ПереоценкаКупонаВВалютеУчета = СтрокаПартии.ПереоценкаКупонаВВалютеУчета + СтрокаПартии.ДооценкаКупонаВВалютеУчета;
				
		ПересчитатьСтоимость(СтрокаПартии);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеннаяБумагаПриИзменении(Элемент) Экспорт
	
	Если Объект.УчетныйАктивЕПС = ПредопределенноеЗначение("Справочник.УчетныеАктивыЕПС.ПустаяСсылка") Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран новый класс!",, "УчетныйАктивЕПС", "УчетныйАктивЕПС");
		Возврат;
	
	КонецЕсли;
	
	Объект.Переоценивать = Ложь;
	Объект.НачислятьПроцентныеПоказатели = Ложь;
	
	ЭтаФорма.ОтображатьПереоценку = Ложь;
	ЭтаФорма.ОтображатьКорректировкуЭСП = Ложь;
	
	ЦеннаяБумагаПриИзмененииСервер();
	
	ПересчитатьИтоговыеПоля();
	
	УчетныйАктивЕПСПриИзменении(Элемент);
	
	Если Элемент <> Неопределено Тогда
		НастроитьВидимостьИДоступность();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЦеннаяБумагаПриИзмененииСервер()
	
	ЗаполнитьПартии();
	
	ЭтаФорма.ОтображатьБалансовуюПереоценку = ЭтоПереоцениваемыйВидАктива(ЭтаФорма.СтарыйКласс) Или ЭтоПереоцениваемыйВидАктива(Объект.УчетныйАктивЕПС);
	ЭтаФорма.ОтображатьБалансовуюКорректировкуЭСП = ЭтоКорректируемыйВидАктива(ЭтаФорма.СтарыйКласс);
	ЭтаФорма.ОтображатьПереоценку = ЭтоПереоцениваемыйВидАктива(Объект.УчетныйАктивЕПС);
	
КонецПроцедуры


&НаКлиенте
Процедура УчетныйАктивЕПСПриИзменении(Элемент)
	
	ЭтаФорма.ОтображатьПереоценку = ЭтоПереоцениваемыйВидАктива(Объект.УчетныйАктивЕПС);
	ЭтаФорма.ОтображатьКорректировкуЭСП = ЭтоКорректируемыйВидАктива(Объект.УчетныйАктивЕПС);
	
	Если НЕ ЭтаФорма.ОтображатьПереоценку ИЛИ НЕ ЭтаФорма.ОтображатьКорректировкуЭСП Тогда
		
		Для каждого СтрокаПартии Из Объект.Партии Цикл
			
			Если НЕ ЭтаФорма.ОтображатьКорректировкуЭСП И Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку Тогда
				СтрокаПартии.Переоценка = 0;
				СтрокаПартии.ПереоценкаВВалютеУчета = 0;
			КонецЕсли;	
			
			Если НЕ ЭтаФорма.ОтображатьКорректировкуЭСП И Не Объект.КорректировкаЭСПРазницаППРезервВПереоценку Тогда
				СтрокаПартии.КорректировкаЭСП = 0;
				СтрокаПартии.КорректировкаЭСПВВалютеУчета = 0;
			КонецЕсли;	
			
			ПересчитатьСтоимость(СтрокаПартии);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Если Объект.КорректировкаЭСПРазницаППРезервВПереоценку Тогда
		БалансовыеПоказателиВТекущие(Неопределено);
		КорректировкаЭСПРазницаППРезервВПереоценку(Неопределено);
	КонецЕсли;	
	
	ПересчитатьИтоговыеПоля();
	
	Если Элемент <> Неопределено Тогда
		НастроитьВидимостьИДоступность();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПересчитатьИтоговыеПоля();
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоговыеПоля()
	
	ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленный = 0;
	ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленныйВВалютеУчета = 0;
	ЭтаФорма.ИтогБалансоваяКорректировкаЭСП = 0;
	ЭтаФорма.ИтогБалансоваяКорректировкаЭСПВВалютеУчета = 0;
	ЭтаФорма.ИтогБалансоваяПереоценка = 0;
	ЭтаФорма.ИтогБалансоваяПереоценкаВВалютеУчета = 0;
	ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0;
	ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = 0;
	ЭтаФорма.ИтогБалансоваяСтоимость = 0;
	ЭтаФорма.ИтогБалансоваяСтоимостьВВалютеУчета = 0;
	ЭтаФорма.ИтогБалансоваяСуммаРезервовПодОбесценение = 0;
	ЭтаФорма.ИтогНоваяСтоимость = 0;
	ЭтаФорма.ИтогНоваяСтоимостьВВалютеУчета = 0;
	ЭтаФорма.ИтогПереоценкаКупона = 0;
	ЭтаФорма.ИтогПереоценкаКупонаВВалютеУчета = 0;
	ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрок = 0;
	ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрокВВалютеУчета = 0;
	ЭтаФорма.ИтогСтараяСтоимость = 0;
	ЭтаФорма.ИтогСтараяСтоимостьВВалютеУчета = 0;
	ЭтаФорма.ИтогСтоимостьКупона = 0;
	ЭтаФорма.ИтогСтоимостьКупонаВВалютеУчета = 0;
	
	Для каждого СтрокаПартии Из Объект.Партии Цикл
		
		ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленный = ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленный + СтрокаПартии.БалансоваяДисконтПремияНачисленный;
		ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленныйВВалютеУчета = ЭтаФорма.ИтогБалансоваяДисконтПремияНачисленныйВВалютеУчета + СтрокаПартии.БалансоваяДисконтПремияНачисленныйВВалютеУчета;
		ЭтаФорма.ИтогБалансоваяКорректировкаЭСП = ЭтаФорма.ИтогБалансоваяКорректировкаЭСП + СтрокаПартии.БалансоваяКорректировкаЭСП;
		ЭтаФорма.ИтогБалансоваяКорректировкаЭСПВВалютеУчета = ЭтаФорма.ИтогБалансоваяКорректировкаЭСПВВалютеУчета + СтрокаПартии.БалансоваяКорректировкаЭСПВВалютеУчета;
		ЭтаФорма.ИтогБалансоваяПереоценка = ЭтаФорма.ИтогБалансоваяПереоценка + СтрокаПартии.БалансоваяПереоценка;
		ЭтаФорма.ИтогБалансоваяПереоценкаВВалютеУчета = ЭтаФорма.ИтогБалансоваяПереоценкаВВалютеУчета + СтрокаПартии.БалансоваяПереоценкаВВалютеУчета;
		ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные + СтрокаПартии.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = ЭтаФорма.ИтогБалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета + СтрокаПартии.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
		ЭтаФорма.ИтогБалансоваяСтоимость = ЭтаФорма.ИтогБалансоваяСтоимость + СтрокаПартии.БалансоваяСтоимость;
		ЭтаФорма.ИтогБалансоваяСтоимостьВВалютеУчета = ЭтаФорма.ИтогБалансоваяСтоимостьВВалютеУчета + СтрокаПартии.БалансоваяСтоимостьВВалютеУчета;
		ЭтаФорма.ИтогБалансоваяСуммаРезервовПодОбесценение = ЭтаФорма.ИтогБалансоваяСуммаРезервовПодОбесценение + СтрокаПартии.БалансоваяСуммаРезервовПодОбесценение;
		ЭтаФорма.ИтогНоваяСтоимость = ЭтаФорма.ИтогНоваяСтоимость + СтрокаПартии.НоваяСтоимость;
		ЭтаФорма.ИтогНоваяСтоимостьВВалютеУчета = ЭтаФорма.ИтогНоваяСтоимостьВВалютеУчета + СтрокаПартии.НоваяСтоимостьВВалютеУчета;
		ЭтаФорма.ИтогПереоценкаКупона = ЭтаФорма.ИтогПереоценкаКупона + СтрокаПартии.ПереоценкаКупона;
		ЭтаФорма.ИтогПереоценкаКупонаВВалютеУчета = ЭтаФорма.ИтогПереоценкаКупонаВВалютеУчета + СтрокаПартии.ПереоценкаКупонаВВалютеУчета;
		ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрок = ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрок + СтрокаПартии.ПогашениеКупонаНеИсполненноеВСрок;
		ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрокВВалютеУчета = ЭтаФорма.ИтогПогашениеКупонаНеИсполненноеВСрокВВалютеУчета + СтрокаПартии.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета;
		ЭтаФорма.ИтогСтараяСтоимость = ЭтаФорма.ИтогСтараяСтоимость + СтрокаПартии.СтараяСтоимость;
		ЭтаФорма.ИтогСтараяСтоимостьВВалютеУчета = ЭтаФорма.ИтогСтараяСтоимостьВВалютеУчета + СтрокаПартии.СтараяСтоимостьВВалютеУчета;
		ЭтаФорма.ИтогСтоимостьКупона = ЭтаФорма.ИтогСтоимостьКупона + СтрокаПартии.СтоимостьКупона;
		ЭтаФорма.ИтогСтоимостьКупонаВВалютеУчета = ЭтаФорма.ИтогСтоимостьКупонаВВалютеУчета + СтрокаПартии.СтоимостьКупонаВВалютеУчета;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПартии()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК БалансоваяСтоимость,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК БалансоваяСтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК БалансоваяПереоценка,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток КАК БалансоваяПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток КАК ДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК БалансоваяДисконтПремияНачисленный,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК БалансоваяДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК БалансоваяКорректировкаЭСП,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК БалансоваяСуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПогашениеКупонаНеИсполненноеВСрокОстаток КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	БухПартииЦенныхБумагОстатки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)) КАК ДатаПокупки,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СуммаПокупки,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупки,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерСделки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И УчетныйАктивЕПС <> &УчетныйАктивЕПС
		|				И ВЫБОР
		|					КОГДА &УчетныйАктивЕПССтарый <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
		|						ТОГДА УчетныйАктивЕПС = &УчетныйАктивЕПССтарый
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос.УстановитьПараметр("Период",							Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	Иначе
		Запрос.УстановитьПараметр("Период",							Новый Граница(Объект.Дата, ВидГраницы.Исключая));
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", Объект.ЦеннаяБумага);
	Запрос.УстановитьПараметр("УчетныйАктивЕПС", Объект.УчетныйАктивЕПС);
	Запрос.УстановитьПараметр("УчетныйАктивЕПССтарый", Объект.УчетныйАктивЕПССтарый);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьБалансовыеДанные()
	
	БалансовыеРесурсыПартий = "
		|	БалансоваяСтоимость,
		|	БалансоваяСтоимостьВВалютеУчета,
		|	БалансоваяПереоценка,
		|	БалансоваяПереоценкаВВалютеУчета,
		|	БалансоваяДисконтПремияНачисленный,
		|	БалансоваяДисконтПремияНачисленныйВВалютеУчета,
		|	БалансоваяКорректировкаЭСП,
		|	БалансоваяКорректировкаЭСПВВалютеУчета,
		|	БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
		|	БалансоваяСуммаРезервовПодОбесценение,
		|	ПогашениеКупонаНеИсполненноеВСрок,
		|	ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	УчетныйАктивЕПС";
	
	БалансовыеПартии = ПолучитьПартии();
	Для каждого СтрокаБалансовыеПартии Из БалансовыеПартии Цикл
		
		ЭтаФорма.СтарыйКласс = СтрокаБалансовыеПартии.УчетныйАктивЕПС.Родитель;
		
		СтрокиПартий = Объект.Партии.НайтиСтроки(Новый Структура("Партия,СтрокаПартии", СтрокаБалансовыеПартии.Партия, СтрокаБалансовыеПартии.СтрокаПартии));
		
		Если СтрокиПартий.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет партий на балансе");
			Возврат;
		КонецЕсли;
		
		СтрокаПартий = СтрокиПартий[0];
			
		ЗаполнитьЗначенияСвойств(СтрокаПартий, СтрокаБалансовыеПартии, БалансовыеРесурсыПартий);
		
		СтрокаПартий.БалансоваяПереоценка = СтрокаПартий.БалансоваяПереоценка + СтрокаПартий.ДооценкаПоПрофсуждению;
		СтрокаПартий.БалансоваяПереоценкаВВалютеУчета = СтрокаПартий.БалансоваяПереоценкаВВалютеУчета + СтрокаПартий.ДооценкаПоПрофсуждениюВВалютеУчета;
		
		СтрокаПартий.БалансоваяДисконтПремияНачисленный = СтрокаПартий.БалансоваяДисконтПремияНачисленный + СтрокаПартий.ДоначислениеДисконтаПремии;
		СтрокаПартий.БалансоваяДисконтПремияНачисленныйВВалютеУчета = СтрокаПартий.БалансоваяДисконтПремияНачисленныйВВалютеУчета + СтрокаПартий.ДоначислениеДисконтаПремииВВалютеУчета;
		
		СтрокаПартий.БалансоваяКорректировкаЭСП = СтрокаПартий.БалансоваяКорректировкаЭСП + СтрокаПартий.ДоначислениеКорректировкиЭСП;
		СтрокаПартий.БалансоваяКорректировкаЭСПВВалютеУчета = СтрокаПартий.БалансоваяКорректировкаЭСПВВалютеУчета + СтрокаПартий.ДоначислениеКорректировкиЭСПВВалютеУчета;
		
		СтрокаПартий.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = СтрокаПартий.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные + СтрокаПартий.ДоначислениеРазницаПервоначальногоПризнания;
		СтрокаПартий.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = СтрокаПартий.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета + СтрокаПартий.ДоначислениеРазницаПервоначальногоПризнанияВВалютеУчета;
		
		ПересчитатьСтоимость(СтрокаПартий);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСтоимостьПоМетодике(РасшифровкаРасчета = Неопределено) Экспорт
	
	Отказ = Ложь;
	
	ОцениваемыеБумаги = ПолучитьПартии();
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",					Объект.Организация);
	ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	Объект.СчетДоверительногоУправления);
	ПараметрыРасчета.Вставить("ЦельРасчета",					Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	ПараметрыРасчета.Вставить("ВалютаУчета",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета"));
	ПараметрыРасчета.Вставить("Дата", 							КонецДня(Объект.Дата));
	
	НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.ЦельРасчета);
	
	ПараметрыРасчета.Вставить("ВидУчета",							НастройкиОценки.ВидУчетаДляОстатковПартий); 	
	ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 	
	
	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
	
		Объект.Стоимость = 0;
		Объект.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ПустаяСсылка();
		Объект.Источник = Справочники.ЮрФизЛица.ПустаяСсылка();
		Объект.УровеньОценки = 0;
		
		Возврат Истина;
	
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);	
	КонецЕсли;
	
	РСП = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(РСП, ПараметрыРасчета);
	РСП.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
	РСП.ДополнительныеСвойства.Вставить("ВыполнятьРасчетПоУказаниюЦБ", Ложь);
	
	ОцениваемыеБумаги.Колонки.Добавить("ТипЗадолженности", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
	
	РСП.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, РасшифровкаРасчета, ОцениваемыеБумаги, Истина);
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РСП.СтоимостиПереоценки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РасшифровкаРасчета = Неопределено Тогда
		Объект.Стоимость = РСП.СтоимостиПереоценки[0].Цена;
		Объект.ВидЦены = РСП.СтоимостиПереоценки[0].ВидЦены;
		Объект.Источник = РСП.СтоимостиПереоценки[0].Источник;
		Объект.УровеньОценки = РСП.СтоимостиПереоценки[0].УровеньОценки;
	Иначе
		
		Отчет = Новый ТабличныйДокумент;
		
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Вариант расчета справедливой стоимости: " + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости, , , Отчет);
		ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
		
		РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
		
		РасшифровкаРасчета = Отчет;
	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтотОбъект);
	
	ЭтаФорма.ОтображатьПереоценку = ЭтоПереоцениваемыйВидАктива(Объект.УчетныйАктивЕПС);
	ЭтаФорма.ОтображатьКорректировкуЭСП = ЭтоКорректируемыйВидАктива(Объект.УчетныйАктивЕПС);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьБалансовыеДанные();
	КонецЕсли;
	
	ЭтаФорма.ОтображатьБалансовуюПереоценку = ЭтоПереоцениваемыйВидАктива(ЭтаФорма.СтарыйКласс) Или ЭтоПереоцениваемыйВидАктива(Объект.УчетныйАктивЕПС);
	ЭтаФорма.ОтображатьБалансовуюКорректировкуЭСП = ЭтоКорректируемыйВидАктива(ЭтаФорма.СтарыйКласс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереоцениватьПриИзменении(Элемент)
	
	ЭтаФорма.Элементы.ГруппаЦена.Видимость = Объект.Переоценивать;
	
	Если Объект.Переоценивать Тогда
	
		Если НЕ ЗаполнитьСтоимостьПоМетодике() И (ЭтоПереоцениваемыйВидАктива(ЭтаФорма.СтарыйКласс, Истина)) Тогда
			
			Объект.Переоценивать = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить стоимость по методике", Объект.Ссылка);
			Возврат;
			
		КонецЕсли;
	Иначе
		Объект.Стоимость = 0;
		Объект.ВидЦены = ПредопределенноеЗначение("Перечисление.ИсточникиЦеныДляПереоценки.ПустаяСсылка");
		Объект.Источник = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
		Объект.УровеньОценки = 0;
	КонецЕсли;
	
	СтоимостьПриИзменении(Элемент);
	
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

#Область РеализацияВариантовПереносаСтоимостей

&НаКлиенте
Процедура ПереоценкуВКорректировкуЭСП(Команда) Экспорт
	
