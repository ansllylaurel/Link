		СтрокаПартии.Переоценка = СтрокаПартии.БалансоваяКорректировкаЭСП;
		СтрокаПартии.ПереоценкаВВалютеУчета = СтрокаПартии.БалансоваяКорректировкаЭСПВВалютеУчета;
		
		ПересчитатьСтоимость(СтрокаПартии);	
		
	КонецЦикла;
	
	ПересчитатьИтоговыеПоля();
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСтоимость(ТекущиеДанные)

	МассивВариантов = Новый Массив;
	МассивВариантов.Добавить(Новый Структура("Префикс,Постфикс,ИмяРеквизитаСтоимости", "", 				"",				"НоваяСтоимость"));
	МассивВариантов.Добавить(Новый Структура("Префикс,Постфикс,ИмяРеквизитаСтоимости", "", 				"ВВалютеУчета",	"НоваяСтоимость"));	
	МассивВариантов.Добавить(Новый Структура("Префикс,Постфикс,ИмяРеквизитаСтоимости", "Балансовая",	"",				"СтараяСтоимость"));	
	МассивВариантов.Добавить(Новый Структура("Префикс,Постфикс,ИмяРеквизитаСтоимости", "Балансовая",	"ВВалютеУчета",	"СтараяСтоимость"));	
	
	Для каждого Вариант Из МассивВариантов Цикл
	
		ТекущиеДанные[Вариант.ИмяРеквизитаСтоимости + Вариант.Постфикс] = ТекущиеДанные[Вариант.Префикс + "Стоимость" + Вариант.Постфикс]
																		+ ТекущиеДанные[Вариант.Префикс + "Переоценка" + Вариант.Постфикс]
																		+ ТекущиеДанные[Вариант.Префикс + "ДисконтПремияНачисленный" + Вариант.Постфикс]
																		+ ТекущиеДанные[Вариант.Префикс + "КорректировкаЭСП" + Вариант.Постфикс]
																		+ ТекущиеДанные[Вариант.Префикс + "СуммаРезервовПодОбесценение"]
																		+ ТекущиеДанные[Вариант.Префикс + "РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные" + Вариант.Постфикс];
		
	КонецЦикла;
	
КонецПроцедуры

