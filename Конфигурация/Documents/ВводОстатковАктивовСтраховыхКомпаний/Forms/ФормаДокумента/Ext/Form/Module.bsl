#Область Импорт_Займов

&НаСервере
Процедура ИмпортироватьЗаймыИзФайлаExcelНаСервере(ДанныеФайла)
	
	ИмпортируемыеДанные = Новый ТаблицаЗначений();
	ИмпортируемыеДанные.Колонки.Добавить("ИННЗаемщика", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ИмпортируемыеДанные.Колонки.Добавить("ОГРНЗаемщика", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ИмпортируемыеДанные.Колонки.Добавить("НаименованиеЗаемщика", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	ИмпортируемыеДанные.Колонки.Добавить("ДатаВыдачиЗайма", Новый ОписаниеТипов("Дата"));
	ИмпортируемыеДанные.Колонки.Добавить("ДатаПогашенияЗайма", Новый ОписаниеТипов("Дата"));
	ИмпортируемыеДанные.Колонки.Добавить("ПроцентЗайма", Новый ОписаниеТипов("Число"));
	ИмпортируемыеДанные.Колонки.Добавить("КодЗайма", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ИмпортируемыеДанные.Колонки.Добавить("СтоимостьЗайма", Новый ОписаниеТипов("Число"));
	ИмпортируемыеДанные.Колонки.Добавить("ЗаймВСистеме", Новый ОписаниеТипов("СправочникСсылка.ПрочиеАктивы"));
	ИмпортируемыеДанные.Колонки.Добавить("ЗаемщикВСистеме", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ИмпортируемыеДанные.Колонки.Добавить("ВходящийОстаток", Новый ОписаниеТипов("Число"));
	ИмпортируемыеДанные.Колонки.Добавить("ПрочиеСумма", Новый ОписаниеТипов("Число"));
	ИмпортируемыеДанные.Колонки.Добавить("ИсходящийОстаток", Новый ОписаниеТипов("Число"));
	ИмпортируемыеДанные.Колонки.Добавить("ВидПрочегоАктива", Новый ОписаниеТипов("СправочникСсылка.ВидыПрочихАктивов"));
	
	Для Каждого ТекСтрока Из ДанныеФайла.Строки Цикл
		
		НоваяСтрока = ИмпортируемыеДанные.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
	КонецЦикла;
	
	Запрос = Новый Запрос();
	
	// Реквизиты займа
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрочиеАктивы.Ссылка КАК Займ,
		|	УсловияЗаймовСтраховыхКомпанийСрезПоследних.Контрагент КАК Заемщик,
		|	УсловияЗаймовСтраховыхКомпанийСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	Займы.ДатаЗаключения КАК ДатаРазмещения,
		|	УсловияЗаймовСтраховыхКомпанийСрезПоследних.Процент КАК Процент,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ИНН, РеквизитыФизическихЛицСрезПоследних.ИНН) КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо.Наименование КАК ЮрФизЛицоНаименование,
		|	ЕСТЬNULL(РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо.ВидЮрФизЛица, РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо.ВидЮрФизЛица) КАК ЮрФизЛицоВидЮрФизЛица,
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество КАК ФИО,
		|	ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
		|	ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ОстаткиПрочихАктивовОстаткиИОбороты.Валюта КАК Валюта
		|ИЗ
		|	Справочник.ПрочиеАктивы КАК ПрочиеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийЗайм
		|		ПО (ЗначенияДополнительныхСведенийЗайм.Объект = ПрочиеАктивы.Ссылка)
		|			И (ЗначенияДополнительныхСведенийЗайм.Свойство.Ключ = ""РеквизитыЗаймаДляПрочегоАктива"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
		|		ПО (ЗначенияДополнительныхСведенийЗайм.Значение = Займы.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|			УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Период, ДатаНачалаДействияУсловий <= &Период) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Период, ДатаНачалаДействияУсловий <= &Период) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияЗаймовСтраховыхКомпанийСрезПоследних
		|		ПО (УсловияЗаймовСтраховыхКомпанийСрезПоследних.КредитныйИнструмент = Займы.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (УсловияЗаймовСтраховыхКомпанийСрезПоследних.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|		ПО (УсловияЗаймовСтраховыхКомпанийСрезПоследних.Контрагент = РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
		|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстаткиИОбороты
		|		ПО ПрочиеАктивы.Ссылка = ОстаткиПрочихАктивовОстаткиИОбороты.Актив
		|			И (УсловияЗаймовСтраховыхКомпанийСрезПоследних.Контрагент = ОстаткиПрочихАктивовОстаткиИОбороты.Субъект)
		|ГДЕ
		|	ПрочиеАктивы.ВидПрочегоАктива.Родитель = &ВидПрочегоАктива";
	
	Запрос.УстановитьПараметр("Период",                       Объект.Дата);
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидПрочегоАктива",			  Справочники.ВидыПрочихАктивов.Займы); 

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПрочиеАктивы = РезультатЗапроса.Выбрать();
	
	Для Каждого СтрокаИмпортируемыхДанных Из ИмпортируемыеДанные Цикл
		
		СтрокаИмпортируемыхДанных.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.ЗаймыПредоставленныеДругимОрганизациям;
		
		// Физическое лицо
		Если ВыборкаПрочиеАктивы.НайтиСледующий(Новый Структура("ФИО, ЮрФизЛицоВидЮрФизЛица, ДатаРазмещения, ДатаПогашения",
			СтрокаИмпортируемыхДанных.НаименованиеЗаемщика, Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо, 
			СтрокаИмпортируемыхДанных.ДатаВыдачиЗайма, СтрокаИмпортируемыхДанных.ДатаПогашенияЗайма)) Тогда
			
			СтрокаИмпортируемыхДанных.ЗаймВСистеме = ВыборкаПрочиеАктивы.Займ; 			
			СтрокаИмпортируемыхДанных.ЗаемщикВСистеме = ВыборкаПрочиеАктивы.Заемщик;
			СтрокаИмпортируемыхДанных.ВходящийОстаток = ВыборкаПрочиеАктивы.СуммаНачальныйОстаток;			
			СтрокаИмпортируемыхДанных.ПрочиеСумма = ВыборкаПрочиеАктивы.СуммаОборот;   			
			СтрокаИмпортируемыхДанных.ИсходящийОстаток = ВыборкаПрочиеАктивы.СуммаКонечныйОстаток;	
			СтрокаИмпортируемыхДанных.ВидПрочегоАктива = ВыборкаПрочиеАктивы.Займ.ВидПрочегоАктива;
		КонецЕсли;  
		ВыборкаПрочиеАктивы.Сбросить();

		
		// Юр.лицо
		Если ВыборкаПрочиеАктивы.НайтиСледующий(Новый Структура("ОГРН, ЮрФизЛицоВидЮрФизЛица, ДатаРазмещения, ДатаПогашения",
			СтрокаИмпортируемыхДанных.ОГРНЗаемщика, Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо, 
			СтрокаИмпортируемыхДанных.ДатаВыдачиЗайма, СтрокаИмпортируемыхДанных.ДатаПогашенияЗайма)) Тогда
			
			СтрокаИмпортируемыхДанных.ЗаймВСистеме = ВыборкаПрочиеАктивы.Займ; 			
			СтрокаИмпортируемыхДанных.ЗаемщикВСистеме = ВыборкаПрочиеАктивы.Заемщик;
			СтрокаИмпортируемыхДанных.ВходящийОстаток = ВыборкаПрочиеАктивы.СуммаНачальныйОстаток;			
			СтрокаИмпортируемыхДанных.ПрочиеСумма = ВыборкаПрочиеАктивы.СуммаОборот;   			
			СтрокаИмпортируемыхДанных.ИсходящийОстаток = ВыборкаПрочиеАктивы.СуммаКонечныйОстаток;	
			СтрокаИмпортируемыхДанных.ВидПрочегоАктива = ВыборкаПрочиеАктивы.Займ.ВидПрочегоАктива;

		КонецЕсли; 		
		ВыборкаПрочиеАктивы.Сбросить(); 

	КонецЦикла;

	//Для новых займов
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеЗаемщиков.ИННЗаемщика КАК ИННЗаемщика,
		|	ДанныеЗаемщиков.ОГРНЗаемщика КАК ОГРНЗаемщика,
		|	ДанныеЗаемщиков.НаименованиеЗаемщика КАК НаименованиеЗаемщика,
		|	ДанныеЗаемщиков.ЗаймВСистеме КАК ЗаймВСистеме
		|ПОМЕСТИТЬ _ДанныеЗаемщиков
		|ИЗ
		|	&ДанныеЗаемщиков КАК ДанныеЗаемщиков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеЗаемщиков.ИННЗаемщика КАК ИННЗаемщика,
		|	_ДанныеЗаемщиков.ОГРНЗаемщика КАК ОГРНЗаемщика,
		|	_ДанныеЗаемщиков.НаименованиеЗаемщика КАК НаименованиеЗаемщика,
		|	ЮрФизЛица.Ссылка КАК Заемщик,
		|	ЮрФизЛица.ВидЮрФизЛица КАК ВидЮрФизЛица
		|ИЗ
		|	_ДанныеЗаемщиков КАК _ДанныеЗаемщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|			ПО РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|		ПО (_ДанныеЗаемщиков.НаименованиеЗаемщика = РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеЗаемщиков.ИННЗаемщика,
		|	_ДанныеЗаемщиков.ОГРНЗаемщика,
		|	_ДанныеЗаемщиков.НаименованиеЗаемщика,
		|	ЮрФизЛица.Ссылка,
		|	ЮрФизЛица.ВидЮрФизЛица
		|ИЗ
		|	_ДанныеЗаемщиков КАК _ДанныеЗаемщиков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|			ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|		ПО _ДанныеЗаемщиков.ОГРНЗаемщика = РеквизитыЮридическихЛицСрезПоследних.ОГРН";
	
	Запрос.УстановитьПараметр("Период",				Объект.Дата);
	Запрос.УстановитьПараметр("Организация",		Объект.Организация);
	Запрос.УстановитьПараметр("ДанныеЗаемщиков",	ИмпортируемыеДанные);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаемщики = РезультатЗапроса.Выбрать();

	Для Каждого СтрокаИмпортируемыхДанных Из ИмпортируемыеДанные Цикл

		Если НЕ ЗначениеЗаполнено( СтрокаИмпортируемыхДанных.ЗаймВСистеме ) Тогда
			// Физическое лицо
			Если ВыборкаЗаемщики.НайтиСледующий(Новый Структура("НаименованиеЗаемщика, ВидЮрФизЛица",
				СтрокаИмпортируемыхДанных.НаименованиеЗаемщика, Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо)) Тогда 				 			
				СтрокаИмпортируемыхДанных.ЗаемщикВСистеме = ВыборкаЗаемщики.Заемщик; 	
			КонецЕсли; 
			ВыборкаЗаемщики.Сбросить();
			//Юр.лицо 			
			Если ВыборкаЗаемщики.НайтиСледующий(Новый Структура("ОГРНЗаемщика, ВидЮрФизЛица",
				СтрокаИмпортируемыхДанных.ОГРНЗаемщика, Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо)) Тогда 				 			
				СтрокаИмпортируемыхДанных.ЗаемщикВСистеме = ВыборкаЗаемщики.Заемщик; 	
			КонецЕсли;  			
			ВыборкаЗаемщики.Сбросить();

			Если НЕ  ЗначениеЗаполнено( СтрокаИмпортируемыхДанных.ЗаемщикВСистеме) Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден заемщик в системе по ОГРН или ФИО. (" + 
					СтрокаИмпортируемыхДанных.НаименованиеЗаемщика   + ")");
					
			КонецЕсли;
			
		КонецЕсли;            
		
	КонецЦикла; 	
	
	Для Каждого СтрокаИмпортируемыхДанных Из ИмпортируемыеДанные Цикл

		Займ = Объект.ОстаткиПрочихАктивов.Добавить(); 		
		Займ.Актив =  СтрокаИмпортируемыхДанных.ЗаймВСистеме;
		Займ.СубъектПрочегоАктива =  СтрокаИмпортируемыхДанных.ЗаемщикВСистеме;
		Займ.Валюта = Объект.Организация.ВалютаУчета;
		ЗаполнитьЗначенияСвойств(Займ, СтрокаИмпортируемыхДанных);
		Если Займ.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.ЗаймыПредоставленныеДругимОрганизациям Тогда
			Займ.УчетныйАктивЕПС  =     Справочники.УчетныеАктивыЕПС.ПредоставленныеЗаймы;
		Иначе
			Займ.УчетныйАктивЕПС  = Справочники.УчетныеАктивыЕПС.ПрочиеАктивыВнеКлассификации;
			
		КонецЕсли;
		
		Займ.ИсходящийОстаток =  СтрокаИмпортируемыхДанных.СтоимостьЗайма + СтрокаИмпортируемыхДанных.ПрочиеСумма;
		Займ.Сумма = СтрокаИмпортируемыхДанных.СтоимостьЗайма - Займ.ВходящийОстаток - СтрокаИмпортируемыхДанных.ПрочиеСумма;
				      
	КонецЦикла; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьЗаймыИзФайлаExcel(Команда)
	
	Если Объект.Проведен Тогда          		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Невозможно импортировать займы в проведенный документ");
		Возврат; 
	КонецЕсли;
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Предупреждение("Не все обязательные атрибуты заполнены",,"Внимание!")	;
		Возврат;
	КонецЕсли;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбора.Фильтр = "Файлы EXCEL (*.xls)|*.xls;*.xlsx";
	ДиалогВыбора.Заголовок = "Укажите расположение файла с информацией о займах";

	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ИмпортируемыйФайл = ДиалогВыбора.ПолноеИмяФайла;
	 	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмпортируемыйФайл);
		Excel.Sheets(1).Select();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	НомСтр = 8;
	
	//ТаблицаЗначений = Новый ТаблицаЗначений();
	//ТаблицаЗначений.Колонки.Добавить("ИННЗаемщика", Новый ОписаниеТипов("Строка"));
	//ТаблицаЗначений.Колонки.Добавить("ОГРНЗаемщика", Новый ОписаниеТипов("Строка"));
	//ТаблицаЗначений.Колонки.Добавить("НаименованиеЗаемщика", Новый ОписаниеТипов("Строка"));
	//ТаблицаЗначений.Колонки.Добавить("ДатаВыдачиЗайма", Новый ОписаниеТипов("Дата"));
	//ТаблицаЗначений.Колонки.Добавить("ДатаПогашенияЗайма", Новый ОписаниеТипов("Дата"));
	//ТаблицаЗначений.Колонки.Добавить("ПроцентЗайма", Новый ОписаниеТипов("Строка"));
	//ТаблицаЗначений.Колонки.Добавить("КодЗайма", Новый ОписаниеТипов("Строка"));
	//ТаблицаЗначений.Колонки.Добавить("СтоимостьЗайма", Новый ОписаниеТипов("Число"));
	//ТаблицаЗначений.Колонки.Добавить("ЗаймВСистеме", Новый ОписаниеТипов("СправочникСсылка.ПрочиеАктивы"));
	//ТаблицаЗначений.Колонки.Добавить("ЗаемщикВСистеме", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	//ТаблицаЗначений.Колонки.Добавить("ВходящийОстаток", Новый ОписаниеТипов("Число"));
	//ТаблицаЗначений.Колонки.Добавить("ПрочиеСумма", Новый ОписаниеТипов("Число"));
	//ТаблицаЗначений.Колонки.Добавить("ИсходящийОстаток", Новый ОписаниеТипов("Число"));
	//ТаблицаЗначений.Колонки.Добавить("ВидПрочегоАктива", Новый ОписаниеТипов("СправочникСсылка.ВидыПрочихАктивов"));
	
	ДанныеФайла = Новый Структура();
	ДанныеФайла.Вставить("Строки", Новый Массив);
	
	Пока НомСтр < 10000 Цикл 		
		Если Не ЗначениеЗаполнено(Excel.Cells(НомСтр,8).Value) Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = Новый Структура();
		НоваяСтрока.Вставить("ИННЗаемщика", Excel.Cells(НомСтр, 8).Value);   		
		НоваяСтрока.Вставить("ОГРНЗаемщика", Excel.Cells(НомСтр, 9).Value); 
		НоваяСтрока.Вставить("НаименованиеЗаемщика", Excel.Cells(НомСтр, 10).Value); 
		НоваяСтрока.Вставить("ДатаВыдачиЗайма", РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Excel.Cells(НомСтр, 12).Value)); 
		НоваяСтрока.Вставить("ДатаПогашенияЗайма", РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Excel.Cells(НомСтр, 13).Value)); 
		НоваяСтрока.Вставить("КодЗайма", Excel.Cells(НомСтр, 15).Value);  	
		НоваяСтрока.Вставить("СтоимостьЗайма", Excel.Cells(НомСтр, 27).Value);  
		НоваяСтрока.Вставить("ПроцентЗайма", Excel.Cells(НомСтр, 29).Value);  
		
		ДанныеФайла.Строки.Добавить(НоваяСтрока);
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;

	Excel.DisplayAlerts = 0;
	Excel.ActiveWorkbook.Close();
	Excel.DisplayAlerts = 1;                  
	
	ИмпортироватьЗаймыИзФайлаExcelНаСервере(ДанныеФайла);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаймыВОстаткахПрочихАктивов()
	
	// Займы теперь заводятся отдельно для Заемщика/Даты займа и тд.
	Для каждого ПрочийАктив из Объект.ОстаткиПрочихАктивов Цикл
		
		// Прочий актив заводим вручную
		Если НЕ ЗначениеЗаполнено(ПрочийАктив.Актив) И ПрочийАктив.ВидПрочегоАктива.Родитель = Справочники.ВидыПрочихАктивов.Займы 
			И ЗначениеЗаполнено(ПрочийАктив.СубъектПрочегоАктива) И ЗначениеЗаполнено( ПрочийАктив.ДатаВыдачиЗайма ) 
			И ЗначениеЗаполнено(ПрочийАктив.ДатаПогашенияЗайма) Тогда
			
			//Проверить, что займ с подобными реквизитами не существует
			Запрос = Новый Запрос();
			Запрос.Текст =                                   
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПрочиеАктивы.Ссылка КАК Займ
				|ИЗ
				|	Справочник.ПрочиеАктивы КАК ПрочиеАктивы
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийЗайм
				|		ПО (ЗначенияДополнительныхСведенийЗайм.Объект = ПрочиеАктивы.Ссылка)
				|			И (ЗначенияДополнительныхСведенийЗайм.Свойство.Ключ = ""РеквизитыЗаймаДляПрочегоАктива"")
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
				|		ПО (ЗначенияДополнительныхСведенийЗайм.Значение = Займы.Ссылка)
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
				|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
				|			УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
				|			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
				|			УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
				|		ИЗ
				|			(ВЫБРАТЬ
				|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
				|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
				|			ИЗ
				|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
				|						&Период,
				|						ДатаНачалаДействияУсловий <= &Период
				|							И Контрагент = &Заемщик
				|							И ДатаПогашения = &ДатаПогашения) КАК УсловияКредитныхИнструментовСрезПоследних
				|			ГДЕ
				|				УсловияКредитныхИнструментовСрезПоследних.Действует
				|			
				|			СГРУППИРОВАТЬ ПО
				|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
				|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
				|						&Период,
				|						ДатаНачалаДействияУсловий <= &Период
				|							И Контрагент = &Заемщик
				|							И ДатаПогашения = &ДатаПогашения) КАК УсловияКредитныхИнструментовСрезПоследних
				|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
				|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияЗаймовСтраховыхКомпанийСрезПоследних
				|		ПО (УсловияЗаймовСтраховыхКомпанийСрезПоследних.КредитныйИнструмент = Займы.Ссылка)
				|ГДЕ
				|	Займы.ДатаЗаключения = &ДатаРазмещения";
			
			Запрос.УстановитьПараметр("Период", Объект.Дата);
			Запрос.УстановитьПараметр("Заемщик", ПрочийАктив.СубъектПрочегоАктива); 			
			Запрос.УстановитьПараметр("ДатаПогашения", ПрочийАктив.ДатаПогашенияЗайма);			
			Запрос.УстановитьПараметр("ДатаРазмещения", ПрочийАктив.ДатаВыдачиЗайма);
			
			Результат = Запрос.Выполнить();
			
			Займы = Результат.Выбрать();
			
			Если Займы.Следующий() Тогда
				ПрочийАктив.Актив = Займы.Займ.Ссылка;
			Иначе
				
				НачатьТранзакцию();
					
				Блокировка = Новый БлокировкаДанных;
				
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УсловияКредитныхИнструментов");				
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияДополнительныхСведений");				
				ЭлементБлокировки = Блокировка.Добавить("Справочник.ПрочиеАктивы");   				
				ЭлементБлокировки = Блокировка.Добавить("Справочник.Займы"); 

 
				Блокировка.Заблокировать();        				
				
				// Добавить займ в справочник прочих активов

				ПрочийАктивЗайм = Справочники.ПрочиеАктивы.СоздатьЭлемент();
				ПрочийАктивЗайм.Наименование = "Займ (" + ПрочийАктив.СубъектПрочегоАктива.Наименование + "); от " + Формат(ПрочийАктив.ДатаВыдачиЗайма,  "ДФ=dd.MM.yyyy");
				ПрочийАктивЗайм.ВидПрочегоАктива = ПрочийАктив.ВидПрочегоАктива;
				ПрочийАктивЗайм.Описание =   ПрочийАктивЗайм.Наименование + "; Срок погашения: " + Формат(ПрочийАктив.ДатаПогашенияЗайма, "ДФ=dd.MM.yyyy")  + 
					"; Процентная ставка: " + ПрочийАктив.ПроцентЗайма; 				
				ПрочийАктивЗайм.Записать(); 
				
				// Добавить прокси-займ в справочник займов
				
				СправочникЗайм = Справочники.Займы.СоздатьЭлемент();
				СправочникЗайм.Организация = Объект.Организация;
				СправочникЗайм.Наименование = ПрочийАктивЗайм.Наименование;
				СправочникЗайм.Валюта = Объект.Организация.ВалютаУчета;
				СправочникЗайм.ДатаЗаключения = ПрочийАктив.ДатаВыдачиЗайма;
				СправочникЗайм.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный;
				СправочникЗайм.Записать();
				
				// Добавить ссылку на прокси-займ в дополнительные сведения к прочему объекту
				
				Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "РеквизитыЗаймаДляПрочегоАктива");
				Если ЗначениеЗаполнено(Свойство) Тогда
					Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
					Запись.Объект = ПрочийАктивЗайм.Ссылка;
					Запись.Свойство = Свойство;
					Запись.Значение = СправочникЗайм.Ссылка;
					Запись.Записать();		
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено дополнительное свойство ""РеквизитыЗаймаДляПрочегоАктива""");
					Возврат;	
				КонецЕсли; 

				// Регистрация реквизитов нового займа
				
				Запись = РегистрыСведений.УсловияКредитныхИнструментов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Новый Структура("КредитныйИнструмент, Процент, ДатаПогашения, Контрагент, УчетныйАктив, Действует",
					СправочникЗайм.Ссылка, ПрочийАктив.ПроцентЗайма, ПрочийАктив.ДатаПогашенияЗайма, 
						ПрочийАктив.СубъектПрочегоАктива, ПрочийАктив.УчетныйАктивЕПС, Истина));
				Запись.Период = Объект.Дата;
				Запись.ДатаНачалаДействияУсловий = Объект.Дата;
				Запись.Записать();
				
				ЗафиксироватьТранзакцию();
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Добавлен займ в справочник прочих активов: " + ПрочийАктивЗайм.Описание);
				
				ПрочийАктив.Актив = ПрочийАктивЗайм.Ссылка;

		 
			КонецЕСли;
			
		КонецЕсли;
		
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыЗаймов()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрочиеАктивы.Ссылка КАК ПрочийАктив,
		|	Займы.ДатаЗаключения КАК ДатаВыдачиЗайма,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашенияЗайма,
		|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК ПроцентЗайма
		|ИЗ
		|	Документ.ВводОстатковАктивовСтраховыхКомпаний.ОстаткиПрочихАктивов КАК ВводОстатковАктивовСтраховыхКомпанийОстаткиПрочихАктивов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеАктивы КАК ПрочиеАктивы
		|		ПО ВводОстатковАктивовСтраховыхКомпанийОстаткиПрочихАктивов.Актив = ПрочиеАктивы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО (ПрочиеАктивы.Ссылка = ЗначенияДополнительныхСведений.Объект)
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""РеквизитыЗаймаДляПрочегоАктива"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Займы КАК Займы
		|		ПО (ЗначенияДополнительныхСведений.Значение = Займы.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|			УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Период, ДатаНачалаДействияУсловий <= &Период) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Период, ДатаНачалаДействияУсловий <= &Период) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО (Займы.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
		|ГДЕ
		|	ВводОстатковАктивовСтраховыхКомпанийОстаткиПрочихАктивов.Ссылка = &ДокументВводОстатковПрочихАктивов";
		
	Запрос.УстановитьПараметр("ДокументВводОстатковПрочихАктивов", Объект.Ссылка);  	
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	
	РеквизитыЗаймов = Запрос.Выполнить().Выбрать();
	
	Для Каждого ПрочийАктив Из ЭтаФорма.Объект.ОстаткиПрочихАктивов Цикл
		
        Если РеквизитыЗаймов.НайтиСледующий(ПрочийАктив.Актив, "ПрочийАктив") Тогда
			
			ЗаполнитьЗначенияСвойств( ПрочийАктив, РеквизитыЗаймов );
			
		КонецЕсли;
		
    КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеОперацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
    ПараметрыОтбора = Новый Структура
		("ФильтрПоСчетуДоверительногоУправления, ФильтрПоОрганизации, ФильтрПоДатеОперации", 
			Объект.СчетДоверительногоУправления, Объект.Организация, Объект.Дата);
    ОткрытьФорму("Документ.ВходящийДокумент.Форма.ФормаВыбораДатаСчетДУ", ПараметрыОтбора, Элемент);
	

КонецПроцедуры


