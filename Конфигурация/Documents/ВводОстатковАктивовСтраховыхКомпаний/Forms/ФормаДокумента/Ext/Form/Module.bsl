Процедура УстановитьРежимФормированияНачальныхОстатковНаСервере()   
	
	Объект.ФормироватьНачальныеОстатки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	СчетДоверительногоУправленияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СчетДоверительногоУправленияПриИзмененииНаСервере()
	 
	Объект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Очистить();
	Объект.ОстаткиПрочихАктивов.Очистить(); 
	
КонецПроцедуры

&НаКлиенте
Процедура СвязаннаяКорректировкаПриИзменении(Элемент)
	
	УстановитьДоступностьПолейЗаголовкаФормы();	
 	СвязаннаяКорректировкаПриИзмененииНаСервере(ЭтаФорма.Объект.СвязаннаяКорректировка, Ложь);

КонецПроцедуры

&НаСервере
Процедура СвязаннаяКорректировкаПриИзмененииНаСервере(ДокументКорректировкаРегистровСсылка, ОтображатьВсеАктивы)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.СвязаннаяКорректировка) Тогда
		Объект.Дата = ДокументКорректировкаРегистровСсылка.Дата;
		Объект.СчетДоверительногоУправления = ДокументКорректировкаРегистровСсылка.СчетДоверительногоУправления;
		Объект.ОснованиеОперации = Неопределено;
	КонецЕсли;
	// При указании связанной корректировки данные по суммам берутся из нее.
	Объект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Очистить();
	Объект.ОстаткиПрочихАктивов.Очистить();
	
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ДокументОбъект.ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереПрочиеАктивы();
	ДокументОбъект.ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереДенежныеСредства();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти

#Область Изменения_Табличной_Части_ОстаткиДенежныхСредств     

&НаКлиенте
Процедура ОстаткиДенежныхСредствНаРасчетныхСчетахСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОстаткиДенежныхСредствНаРасчетныхСчетах.ТекущиеДанные;
	ТекущиеДанные.ИсходящийОстаток = ТекущиеДанные.ВходящийОстаток + ТекущиеДанные.Сумма + ТекущиеДанные.СуммаПрочие; 
	//ПересчитатьОшибкуВТабличнойЧасти(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствНаРасчетныхСчетахИсходящийОстатокПриИзменении(Элемент)
	 	
	ТекущиеДанные = Элементы.ОстаткиДенежныхСредствНаРасчетныхСчетах.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.ИсходящийОстаток - ТекущиеДанные.ВходящийОстаток - ТекущиеДанные.СуммаПрочие;   
	//ПересчитатьОшибкуВТабличнойЧасти(ТекущиеДанные);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПересчитатьОшибкуВТабличнойЧасти(ТекущиеДанные)
	
	 ТекущиеДанные.Ошибка = ТекущиеДанные.ВходящийОстаток + ТекущиеДанные.СуммаПрочие + ТекущиеДанные.Сумма -  ТекущиеДанные.ИсходящийОстаток;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВходящийИсходящийОстаткиНаРасчетномСчете(СтрокаТабличнойЧасти)
	
	СтрокаТабличнойЧасти.ВходящийОстаток = 0;	
	СтрокаТабличнойЧасти.ИсходящийОстаток = 0; 	
	СтрокаТабличнойЧасти.СуммаПрочие = 0;

	ДанныеРасчетногоСчета = ПолучитьОстаткиНаРасчетномСчете(
								СтрокаТабличнойЧасти.РасчетныйСчет);
	
	Если Не ДанныеРасчетногоСчета = Неопределено Тогда  	
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ДанныеРасчетногоСчета);
		СтрокаТабличнойЧасти.ИсходящийОстаток = СтрокаТабличнойЧасти.ВходящийОстаток + СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.ПрочиеСумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствНаРасчетныхСчетахРасчетныйСчетПриИзменении(Элемент)
	
	ТекущаяСтрокаТабличнойЧасти = Элементы.ОстаткиДенежныхСредствНаРасчетныхСчетах.ТекущиеДанные; 	
	ТекущаяСтрокаТабличнойЧасти.Сумма = 0;	
	
	ПолучитьВходящийИсходящийОстаткиНаРасчетномСчете(ТекущаяСтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОстаткиНаРасчетномСчете(РасчетныйСчет)

	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения КАК МестоХранения,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК Расчетный_Счет,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК ВходящийОстаток,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК Исходящий_Остаток,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
	|	ОстаткиДенежныхСредств.Сумма КАК СуммаДокумент
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
	|			НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|			КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|			День,
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И РасчетныйСчет = &РасчетныйСчет) КАК ОстаткиДенежныхСредствОстаткиИОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
	|		ПО ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет = ОстаткиДенежныхСредств.РасчетныйСчет
	|			И ОстаткиДенежныхСредствОстаткиИОбороты.Организация = ОстаткиДенежныхСредств.Организация
	|			И ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления = ОстаткиДенежныхСредств.СчетДоверительногоУправления
	|			И ОстаткиДенежныхСредствОстаткиИОбороты.Брокер = ОстаткиДенежныхСредств.Брокер
	|			И ОстаткиДенежныхСредствОстаткиИОбороты.Валюта = ОстаткиДенежныхСредств.Валюта
	|			И (ОстаткиДенежныхСредств.Регистратор = &Документ)";
	
	Запрос.УстановитьПараметр("Период", Объект.Дата);                	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Документ", ?(ЗначениеЗаполнено(Объект.СвязаннаяКорректировка), Объект.СвязаннаяКорректировка, Объект.Ссылка));	
	Запрос.УстановитьПараметр("РасчетныйСчет", РасчетныйСчет);
	
	Результат = Запрос.Выполнить().Выгрузить();
	                                                     
	Для Каждого СтрокаРезультат из Результат Цикл
		
		РезультатСтруктура = Новый Структура();
		
		Для Каждого Колонка из Результат.Колонки Цикл
			РезультатСтруктура.Вставить(Колонка.Имя, СтрокаРезультат[Колонка.Имя]);
		КонецЦикла;
		
		РезультатСтруктура.Вставить("СуммаПрочие", СтрокаРезультат.СуммаОборот - СтрокаРезультат.СуммаДокумент);
		
		Возврат РезультатСтруктура;	
		
	КонецЦикла;
	
КонецФункции

#Область Заполнение_табличной_части_ОстаткиНаРасчетныхСчетах_Команда

&НаСервере
Процедура ЗагрузитьНачальныеОстаткиНаРасчетныхСчетахНаСервере()
	
	Если Объект.Проведен Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Невозможно заполнить проведенный документ");
		Возврат;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвязаннаяКорректировка) Тогда
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		
		ДокументОбъект.ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереДенежныеСредства();
		
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

		Возврат;
	
	КонецЕсли;
	// Очистка имеющихся данных
	Объект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Очистить();
	 	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения КАК МестоХранения,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК ВходящийОстаток,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаПрочие,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК ИсходящийОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
	|			НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|			КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|			,
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Объект.Дата); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);  
	
	ВыборкаОстаткиНаРабочихСчетах = Запрос.Выполнить().Выбрать();
		
	Пока ВыборкаОстаткиНаРабочихСчетах.Следующий() Цикл
		
		НоваяСтрокаРасчетныйСчет = Объект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРасчетныйСчет, ВыборкаОстаткиНаРабочихСчетах);
		          
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьВходящиеОстаткиНаРасчетныхСчетах(Команда)
	
	ЗагрузитьНачальныеОстаткиНаРасчетныхСчетахНаСервере();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Изменения_Табличной_Части_ОстаткиПрочихАктивов 

&НаКлиенте
Процедура ПолучитьВходящийИсходящийОстаткиПрочихАктивов(СтрокаТабличнойЧасти)
	
	Если Объект.Проведен Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Невозможно заполнить проведенный документ");
		Возврат;

	КонецЕсли;
	
	
	СтрокаТабличнойЧасти.ВходящийОстаток = 0;	
	СтрокаТабличнойЧасти.ИсходящийОстаток = 0; 	
	СтрокаТабличнойЧасти.ПрочиеСумма = 0;

	ДанныеПрочегоАктива = ПолучитьОстаткиПрочегоАктива(
								СтрокаТабличнойЧасти.Актив,
								СтрокаТабличнойЧасти.Валюта, 
								СтрокаТабличнойЧасти.СубъектПрочегоАктива);
	
	Если Не ДанныеПрочегоАктива = Неопределено Тогда  	
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ДанныеПрочегоАктива);
		СтрокаТабличнойЧасти.ИсходящийОстаток = СтрокаТабличнойЧасти.ВходящийОстаток +  СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.ПрочиеСумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПрочихАктивовАктивПриИзменении(Элемент)
	
	ТекущаяСтрокаТабличнойЧасти = Элементы.ОстаткиПрочихАктивов.ТекущиеДанные; 	
	ТекущаяСтрокаТабличнойЧасти.Сумма = 0;	
	
	ПолучитьВходящийИсходящийОстаткиПрочихАктивов(ТекущаяСтрокаТабличнойЧасти);
	// Учетный актив пересчитывается при выборе нового актива.
	ТекущаяСтрокаТабличнойЧасти.УчетныйАктивЕПС = ПолучитьУчетныйАктив(ТекущаяСтрокаТабличнойЧасти.Актив);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОстаткиПрочихАктивовСубъектВалютаПрочегоАктиваПриИзменении(Элемент)
	
	ТекущаяСтрокаТабличнойЧасти = Элементы.ОстаткиПрочихАктивов.ТекущиеДанные;
	ПолучитьВходящийИсходящийОстаткиПрочихАктивов(ТекущаяСтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПрочихАктивовСуммаПриИзменении(Элемент)
	 	
	ТекущиеДанные = Элементы.ОстаткиПрочихАктивов.ТекущиеДанные;
	ТекущиеДанные.ИсходящийОстаток = ТекущиеДанные.ВходящийОстаток + ТекущиеДанные.Сумма + ТекущиеДанные.ПрочиеСумма; 
	//ПересчитатьОшибкуВТабличнойЧасти(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПрочихАктивовИсходящийОстатокПриИзменении(Элемент)
		
	ТекущиеДанные = Элементы.ОстаткиПрочихАктивов.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.ИсходящийОстаток - ТекущиеДанные.ВходящийОстаток - ТекущиеДанные.ПрочиеСумма;   
	//ПересчитатьОшибкуВТабличнойЧасти(ТекущиеДанные);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстаткиПрочихАктивов(Команда)
	
	Для НомерСтроки = 0 по Объект.ОстаткиПрочихАктивов.Количество() - 1 Цикл
		СтрокаТаблицы = Объект.ОстаткиПрочихАктивов[НомерСтроки];

		ПолучитьВходящийИсходящийОстаткиПрочихАктивов(СтрокаТаблицы); 

	КонецЦикла; 	

КонецПроцедуры 

&НаСервере
Функция ПолучитьУчетныйАктив(ПрочийАктив)
	
	Возврат Документы.ВводОстатковАктивовСтраховыхКомпаний.ОпределитьУчетныйПрочийАктивЕПС(Объект.Дата, Неопределено, ПрочийАктив);
				
КонецФункции  

&НаСервере
Функция ПолучитьОстаткиПрочегоАктива(Актив, Валюта, СубъектПрочегоАктива)
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрочиеАктивы.ВидПрочегоАктива КАК Вид_Прочего_Актива,
	|	ОстаткиПрочихАктивовОстаткиИОбороты.Актив КАК Прочий_Актив,
	|	ОстаткиПрочихАктивовОстаткиИОбороты.Субъект КАК Субъект_Прочего_Актива,
	|	ОстаткиПрочихАктивовОстаткиИОбороты.Валюта КАК Валюта,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК ВходящийОстаток,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК Исходящий_Остаток,
	|	ЕСТЬNULL(ОстаткиПрочихАктивов.Сумма, 0) КАК СуммаДокумент,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот, 0) КАК СуммаОборот
	|ИЗ
	|	РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
	|			НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|			КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|			День,
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ЕСТЬNULL(Субъект, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) = ЕСТЬNULL(&Субъект, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
	|				И Актив = &Актив
	|				И (ЕСТЬNULL(&Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|					ИЛИ Валюта = &Валюта)) КАК ОстаткиПрочихАктивовОстаткиИОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрочиеАктивы КАК ПрочиеАктивы
	|		ПО ОстаткиПрочихАктивовОстаткиИОбороты.Актив = ПрочиеАктивы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
	|		ПО ОстаткиПрочихАктивовОстаткиИОбороты.Актив = ОстаткиПрочихАктивов.Актив
	|			И (ОстаткиПрочихАктивов.СчетДоверительногоУправления = ОстаткиПрочихАктивовОстаткиИОбороты.СчетДоверительногоУправления)
	|			И (ЕСТЬNULL(ОстаткиПрочихАктивов.Субъект, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) = ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Субъект, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)))
	|			И (ОстаткиПрочихАктивов.Валюта = ОстаткиПрочихАктивовОстаткиИОбороты.Валюта)
	|			И (ОстаткиПрочихАктивов.Регистратор = &Документ)";
	
	Запрос.УстановитьПараметр("Период", Объект.Дата);                	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Документ", ?(ЗначениеЗаполнено(Объект.СвязаннаяКорректировка), Объект.СвязаннаяКорректировка, Объект.Ссылка));	
	Запрос.УстановитьПараметр("Актив", Актив);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Субъект", СубъектПрочегоАктива); 
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультат из Результат Цикл
		
		РезультатСтруктура = Новый Структура();
		
		Для Каждого Колонка из Результат.Колонки Цикл
			РезультатСтруктура.Вставить(Колонка.Имя, СтрокаРезультат[Колонка.Имя]);
		КонецЦикла;
		
		РезультатСтруктура.Вставить("ПрочиеСумма", СтрокаРезультат.СуммаОборот - СтрокаРезультат.СуммаДокумент);
		
		Возврат РезультатСтруктура;	
		
	КонецЦикла; 	
	
КонецФункции

#Область Заполнение_табличной_части_ОстаткПрочихАктивов_Команда

&НаСервере
Процедура ЗагрузитьНачальныеОстаткиПрочихАктивовНаСервере()
	
	Если Объект.Проведен Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Невозможно заполнить проведенный документ");
		Возврат;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвязаннаяКорректировка) Тогда
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		
		ДокументОбъект.ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереПрочиеАктивы();
		
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

		Возврат;
	
	КонецЕсли;
	// Очистка имеющихся данных
	Объект.ОстаткиПрочихАктивов.Очистить();
	 	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОборотыДокумента.ВидПрочегоАктива КАК ВидПрочегоАктива,
	|	ОборотыДокумента.Актив КАК Актив,
	|	ОборотыДокумента.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
	|	ОборотыДокумента.Валюта КАК Валюта,
	|	ОборотыДокумента.Сумма КАК Сумма,
	|	ОборотыДокумента.УчетныйАктивЕПС КАК УчетныйАктивЕПС
	|ПОМЕСТИТЬ _ОборотыДокумента
	|ИЗ
	|	&ОборотыДокумента КАК ОборотыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыПрочихАктивов.Ссылка КАК ВидПрочегоАктива,
	|	ПрочиеАктивы.Ссылка КАК Актив,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Валюта, Организации.ВалютаУчета) КАК Валюта,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК ВходящийОстаток,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот, 0) КАК СуммаВсего,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК ИсходящийОстаток,
	|	_ОборотыДокумента.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ЕСТЬNULL(_ОборотыДокумента.Сумма, 0) КАК СуммаДокумента,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Субъект, _ОборотыДокумента.СубъектПрочегоАктива) КАК СубъектПрочегоАктива
	|ПОМЕСТИТЬ _ОстаткиПрочихАктивов
	|ИЗ
	|	Справочник.ПрочиеАктивы КАК ПрочиеАктивы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыПрочихАктивов КАК ВидыПрочихАктивов
	|		ПО ПрочиеАктивы.ВидПрочегоАктива = ВидыПрочихАктивов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
	|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|				,
	|				,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстаткиИОбороты
	|		ПО ПрочиеАктивы.Ссылка = ОстаткиПрочихАктивовОстаткиИОбороты.Актив
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (Организации.Ссылка = &Организация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ОборотыДокумента КАК _ОборотыДокумента
	|		ПО (_ОборотыДокумента.Актив = ПрочиеАктивы.Ссылка)
	|ГДЕ
	|	(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток > 0
	|			ИЛИ ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток > 0
	|			ИЛИ ЕСТЬNULL(_ОборотыДокумента.Сумма, 0) > 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ОстаткиПрочихАктивов.ВидПрочегоАктива КАК ВидПрочегоАктива,
	|	_ОстаткиПрочихАктивов.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
	|	_ОстаткиПрочихАктивов.Актив КАК Актив,
	|	_ОстаткиПрочихАктивов.Валюта КАК Валюта,
	|	_ОстаткиПрочихАктивов.ВходящийОстаток КАК ВходящийОстаток,
	|	_ОстаткиПрочихАктивов.СуммаДокумента КАК Сумма,
	|	_ОстаткиПрочихАктивов.ИсходящийОстаток + _ОстаткиПрочихАктивов.СуммаДокумента КАК ИсходящийОстаток,
	|	_ОстаткиПрочихАктивов.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	_ОстаткиПрочихАктивов.СуммаВсего - _ОстаткиПрочихАктивов.СуммаДокумента КАК ПрочиеСумма
	|ИЗ
	|	_ОстаткиПрочихАктивов КАК _ОстаткиПрочихАктивов";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Объект.Дата); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);  	
	Запрос.УстановитьПараметр("ОборотыДокумента", Объект.ОстаткиПрочихАктивов.Выгрузить()); 
	
	ВыборкаПрочиеАктивы = Запрос.Выполнить().Выбрать();
	 
		
	Пока ВыборкаПрочиеАктивы.Следующий() Цикл
		
		НоваяСтрокаПрочийАктив = Объект.ОстаткиПрочихАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПрочийАктив, ВыборкаПрочиеАктивы);
		
	 	Если НЕ ЗначениеЗаполнено(НоваяСтрокаПрочийАктив.УчетныйАктивЕПС) Тогда
			НоваяСтрокаПрочийАктив.УчетныйАктивЕПС = 
				Документы.ВводОстатковАктивовСтраховыхКомпаний.ОпределитьУчетныйПрочийАктивЕПС
					(Объект.Дата, ВыборкаПрочиеАктивы.ВидПрочегоАктива, ВыборкаПрочиеАктивы.Актив);
		КонецЕсли;
		          
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьВходящиеОстаткиПрочихАктивов(Команда)
	
	ЗагрузитьНачальныеОстаткиПрочихАктивовНаСервере();
	
КонецПроцедуры

