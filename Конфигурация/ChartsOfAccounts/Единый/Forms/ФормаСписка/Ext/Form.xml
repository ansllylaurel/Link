			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Единый.Ссылка,
	Единый.ПометкаУдаления,
	Единый.Родитель,
	Единый.Код,
	Единый.Наименование,
	Единый.Порядок,
	ВЫБОР
		КОГДА Единый.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА "А"
		ИНАЧЕ ВЫБОР
				КОГДА Единый.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
					ТОГДА "П"
				ИНАЧЕ "АП"
			КОНЕЦ
	КОНЕЦ КАК Вид,
	Единый.Забалансовый,
	Единый.Количественный,
	Единый.Валютный,
	Единый.ВидыСубконто.(
		Ссылка,
		НомерСтроки,
		ВидСубконто,
		Предопределенное,
		ТолькоОбороты
	),
	Единый.Предопределенный,
	Единый.ИмяПредопределенныхДанных,
	ЕдиныйВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	ЕдиныйВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	ЕдиныйВидыСубконто3.ВидСубконто КАК ВидСубконто3,
	Единый.ГлаваПланаСчетовНФО
ИЗ
	ПланСчетов.Единый КАК Единый
		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто1
		ПО (ЕдиныйВидыСубконто1.Ссылка = Единый.Ссылка)
			И (ЕдиныйВидыСубконто1.НомерСтроки = 1)
		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто2
		ПО (ЕдиныйВидыСубконто2.Ссылка = Единый.Ссылка)
			И (ЕдиныйВидыСубконто2.НомерСтроки = 2)
		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто3
		ПО (ЕдиныйВидыСубконто3.Ссылка = Единый.Ссылка)
			И (ЕдиныйВидыСубконто3.НомерСтроки = 3)</QueryText>
				<MainTable>ChartOfAccounts.Единый</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
