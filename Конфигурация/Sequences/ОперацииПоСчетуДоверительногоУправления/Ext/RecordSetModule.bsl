
Процедура ПриЗаписи(Отказ, Замещение)
	
	ГлубинаРекурсии = 0;
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ГлубинаРекурсии", ГлубинаРекурсии) Тогда
		ГлубинаРекурсии = ГлубинаРекурсии + 1;
	Иначе
		ГлубинаРекурсии = 0;
	КонецЕсли; 	
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ГлубинаРекурсии", ГлубинаРекурсии);
	
	Если ГлубинаРекурсии > 2 Тогда
		ВызватьИсключение "Превышена допустимая глубина рекурсии при записи набора записей последовательности";
	КонецЕсли; 
	
	ЗаписатьНабор = Ложь;
	Для каждого Запись Из ЭтотОбъект Цикл
		Если Не Запись.Период = Запись.Регистратор.Дата Тогда
			Запись.Период = Запись.Регистратор.Дата;
			ЗаписатьНабор = Истина;
		КонецЕсли; 
	КонецЦикла; 
	Если ЗаписатьНабор Тогда
		ЭтотОбъект.Записать();
	КонецЕсли; 
	
КонецПроцедуры
