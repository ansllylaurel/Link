Перем РасшифровкаДоходностиПоМетодикеПФР;

Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Расчет доходности ДУ",
		"2.38",
		"",
		Истина,
		"СкриншотФормы");
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	// Организуем сбор статистики
	Механизм	= ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия		= ЗарегистрироватьСессиюСбораСтатистики(Механизм);
	
	ВидыДоговоров = Новый Массив;
	Для Каждого ЭлементСписка Из ЭтотОбъект.ВидыДоговоровДоверительногоУправления Цикл
		Если ЭлементСписка.Пометка ИЛИ ВариантОтчета = "ДоходностьИндексов" Тогда
			ВидыДоговоров.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВидыДоговоровСЧАБезПослаблений = Новый Массив;
	
	Если ЭтотОбъект.РассчитыватьСЧАБезПослаблений Тогда
		Для Каждого ЭлементСписка Из ЭтотОбъект.ВидыДоговоровДоверительногоУправленияСЧАБезПослаблений Цикл
			Если ЭлементСписка.Пометка 
				И ВариантОтчета <> "ДоходностьИндексов"
				И ВидыДоговоров.Найти(ЭлементСписка.Значение) <> Неопределено Тогда
					ВидыДоговоровСЧАБезПослаблений.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	ЭлементСписковДоговоров = ЭтотОбъект.СпискиДоговоров.НайтиПоИдентификатору(ЭтотОбъект.ИдентификаторСпискаДоговоров);
	Если ЭлементСписковДоговоров = Неопределено Тогда
		СписокДоговоров = Новый СписокЗначений;
	Иначе
		СписокДоговоров = ЭлементСписковДоговоров.Значение;
	КонецЕсли;
	
	Если ЭтотОбъект.ВариантОтчета = "ВознагражденияУК" Тогда
		ВознагражденияУКБух = РаботаСВнешнимиСистемами.ПолучитьДанныеБухгалтерииОВознагражденииУК(
			"Начисленное", НачалоГода(ЭтотОбъект.Период), КонецДня(ЭтотОбъект.Период), ЭтотОбъект.Организация);
		Если ВознагражденияУКБух = Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ВознагражденияУКБух = Новый ТаблицаЗначений;
		ВознагражденияУКБух.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления")); 
		ВознагражденияУКБух.Колонки.Добавить("Период",							Новый ОписаниеТипов("Дата"));
		ВознагражденияУКБух.Колонки.Добавить("Сумма",							Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	ГруппировкаПоВидуДоговораГлавная = Истина;
	Для Каждого Группировка Из ГруппировкиОтчета Цикл
		Если Группировка.Пометка Тогда
			ГруппировкаПоВидуДоговораГлавная = (Группировка.Значение = "ВидДоговораДоверительногоУправления");
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация"											, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"											, НачалоГода(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ДатаОкончания"										, КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ВидыДоговоров"										, ВидыДоговоров);
	Запрос.УстановитьПараметр("ОтборПоДоговорам"									, ЭтотОбъект.ОтборПоДоговорам);
	Запрос.УстановитьПараметр("СписокДоговоров"										, СписокДоговоров);
	Запрос.УстановитьПараметр("ВидыДоговоровСЧАБезПослаблений"						, ВидыДоговоровСЧАБезПослаблений);	
	Запрос.УстановитьПараметр("Расшифровка"											, Ложь);
	Запрос.УстановитьПараметр("СкрытьФизЛиц"										, СкрытьФизЛиц);
	Запрос.УстановитьПараметр("ВидПлановойДоходности"								, ЭтотОбъект.ВидПлановойДоходности);
	Запрос.УстановитьПараметр("ВидВалюты"											, ЭтотОбъект.ВидВалюты);
	Запрос.УстановитьПараметр("ВариантОтчета"										, ВариантОтчета);	
	Запрос.УстановитьПараметр("ГруппировкаПоВидуДоговораГлавная"					, ГруппировкаПоВидуДоговораГлавная);	
	
	ТаблицаДоходностей = ПолучитьТаблицуДоходностей(ВидыДоговоров, НачалоГода(ЭтотОбъект.Период), КонецДня(ЭтотОбъект.Период));
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаДоходностей, "_ТаблицаДоходностей", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ВознагражденияУКБух, "_ВознагражденияУКБух", Запрос);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(РассчитатьДоходностьПоМетодикеПФР(ВидыДоговоров, СписокДоговоров), "_ТаблицаДоходностиПоМетодикеПФР", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицаСЧАБезПослаблений(ВидыДоговоровСЧАБезПослаблений, СписокДоговоров), "_ТаблицаСЧАБезПослаблений", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицуКодыСчетовУБрокера(ВидыДоговоров, ЭтотОбъект.Период), "_КодыСчетовУБрокера", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицуНастроекПлановогоВознаграждения(ВидыДоговоров, КонецДня(ЭтотОбъект.Период)), "_НастройкиПлановогоВознаграждения", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицуНастроекВознагражденияСГарантированнымДоходом(ВидыДоговоров, КонецДня(ЭтотОбъект.Период)), "_НастройкиВознагражденияСГарантированнымДоходом", Запрос);
	
	ПараметрыРасчетаЗадолженностиПоНДФЛ = Новый Структура;
	ПараметрыРасчетаЗадолженностиПоНДФЛ.Вставить("ВидВалюты",					 ЭтотОбъект.ВидВалюты);
	ПараметрыРасчетаЗадолженностиПоНДФЛ.Вставить("УчитыватьНДФЛПоНачислению",	 Истина);
	
	Если ЭтотОбъект.ОтборПоДоговорам Тогда
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, Новый СтандартныйПериод(НачалоГода(ЭтотОбъект.Период), КонецДня(ЭтотОбъект.Период)), "СчетаДоверительногоУправления", СписокДоговоров, ПараметрыРасчетаЗадолженностиПоНДФЛ);
	Иначе
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, Новый СтандартныйПериод(НачалоГода(ЭтотОбъект.Период), КонецДня(ЭтотОбъект.Период)), "ВидыДоговоровДоверительногоУправления", ВидыДоговоров, ПараметрыРасчетаЗадолженностиПоНДФЛ);
	КонецЕсли;
	
#Область ТекстЗапроса	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыОперацийПриВводеВыводеДенежныхСредств.Ссылка КАК ВидОперацииВводаВыводаДС
		|ПОМЕСТИТЬ ВидыОперацииВводаВыводаДС
		|ИЗ
		|	Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств КАК ВидыОперацийПриВводеВыводеДенежныхСредств
		|ГДЕ
		|	ВидыОперацийПриВводеВыводеДенежныхСредств.Ссылка В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствИспользованныхДляСобственныхСделок), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыделениеДенежныхСредствДляСобственныхСделок))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчетаПлановойДоходностиСрезПоследних.СубъектАналитики КАК СубъектАналитики,
		|	НастройкиРасчетаПлановойДоходностиСрезПоследних.Год КАК Год,
		|	ВЫБОР &ВидПлановойДоходности
		|		КОГДА ""Негативная""
		|			ТОГДА НастройкиРасчетаПлановойДоходностиСрезПоследних.НегативнаяДоходность
		|		КОГДА ""Нейтральная""
		|			ТОГДА НастройкиРасчетаПлановойДоходностиСрезПоследних.НейтральнаяДоходность
		|		КОГДА ""Позитивная""
		|			ТОГДА НастройкиРасчетаПлановойДоходностиСрезПоследних.ПозитивнаяДоходность
		|	КОНЕЦ КАК ПлановаяДоходность
		|ПОМЕСТИТЬ _НастройкиРасчетаПлановойДоходности
		|ИЗ
		|	РегистрСведений.НастройкиРасчетаПлановойДоходности.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК НастройкиРасчетаПлановойДоходностиСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	РАЗНОСТЬДАТ(&ДатаНачала, &ДатаОкончания, ДЕНЬ) + 1 КАК ДнейВПериоде,
		|	_НастройкиВознагражденияСГарантированнымДоходом.СтавкаГарантированногоДохода КАК СтавкаГарантированногоДохода,
		|	ДЕНЬГОДА(КОНЕЦПЕРИОДА(&ДатаОкончания, ГОД)) КАК ДнейВГоду,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	НастройкиРасчетаБенчмарковСрезПоследних.НастройкаРасчета КАК Бенчмарк,
		|	_ТаблицаДоходностей.Доходность КАК ДоходностьБенчмарка,
		|	_КодыСчетовУБрокера.КодСчетаУБрокера КАК КодСчетаУБрокера,
		|	УправляющиеСчетовДоверительногоУправленияСрезПоследних.Управляющий КАК Управляющий,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная, ЛОЖЬ)
		|				ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|			ТОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
		|				И ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта.Наименование = ""RUB""
		|			ТОГДА ""рублёвые портфели""
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
		|				И ЕСТЬNULL(ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта.Наименование, ""RUB"") <> ""RUB""
		|			ТОГДА ""валютные портфели""
		|	КОНЕЦ КАК Стратегия,
		|	ВЫБОР
		|		КОГДА &ВидВалюты = ""ВалютаУчета""
		|				ИЛИ ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта ЕСТЬ NULL
		|			ТОГДА Организации.ВалютаУчета
		|		КОГДА &ВидВалюты = ""ВалютаЦелиРасчета""
		|			ТОГДА ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок) КАК ВидПоказателя,
		|	ВЫБОР
		|		КОГДА &СкрытьФизЛиц
		|				И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица))
		|			ТОГДА СчетаДоверительногоУправления.КодСчета
		|		ИНАЧЕ СчетаДоверительногоУправления.Наименование
		|	КОНЕЦ КАК Наименование,
		|	ВЫБОР
		|		КОГДА &СкрытьФизЛиц
		|				И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица))
		|			ТОГДА СчетаДоверительногоУправления.КодСчета
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		ИНАЧЕ КлиентыДоверительногоУправленияСрезПоследних.Клиент.Наименование
		|	КОНЕЦ КАК НаименованиеКлиента,
		|	ЕСТЬNULL(НастройкиДоходности1.ПлановаяДоходность, ЕСТЬNULL(НастройкиДоходности2.ПлановаяДоходность, ЕСТЬNULL(НастройкиДоходности3.ПлановаяДоходность, 0))) КАК ПлановаяДоходность,
