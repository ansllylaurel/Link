		|				ИЛИ _ПредварительныеДанные0.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИнвестиционныйДоход))
		|			И _ПредварительныеДанные0.ПлановаяДоходностьПлюс1 - _ПредварительныеДанные0.МинимальнаяДоходность > 0
		|			ТОГДА (_ПредварительныеДанные0.ПлановаяДоходностьПлюс1 - _ПредварительныеДанные0.МинимальнаяДоходность) / 100
		|		ИНАЧЕ 0
		|	КОНЕЦ * _ПредварительныеДанные0.АктивыНаКонецГодаПлюс0 * _ПредварительныеДанные0.СтавкаВознаграждения / 100 КАК ВознаграждениеПлюс1,
		|	_ПредварительныеДанные0.АктивыНаКонецГодаПлюс0 + _ПредварительныеДанные0.АктивыНаКонецГодаПлюс0 * _ПредварительныеДанные0.ПлановаяДоходностьПлюс1 / 100 
		|	- ВЫБОР
		|		КОГДА _ПредварительныеДанные0.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.СредняяРыночнаяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного)
		|			ТОГДА 1
		|		КОГДА (_ПредварительныеДанные0.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ПревышениеНадМинимальнымДоходом)
		|				ИЛИ _ПредварительныеДанные0.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИнвестиционныйДоход))
		|			И _ПредварительныеДанные0.ПлановаяДоходностьПлюс1 - _ПредварительныеДанные0.МинимальнаяДоходность > 0
		|			ТОГДА (_ПредварительныеДанные0.ПлановаяДоходностьПлюс1 - _ПредварительныеДанные0.МинимальнаяДоходность) / 100
		|		ИНАЧЕ 0
		|	КОНЕЦ * _ПредварительныеДанные0.АктивыНаКонецГодаПлюс0 * _ПредварительныеДанные0.СтавкаВознаграждения / 100 КАК АктивыНаКонецГодаПлюс1
		|ПОМЕСТИТЬ _ПредварительныеДанные1
		|ИЗ
		|	_ПредварительныеДанные0 КАК _ПредварительныеДанные0";
		
		НомерПредварительныеДанные = 4;
		
		Для Индекс = 0 По 4 Цикл
			Запрос.Текст = Запрос.Текст + 
			СтрЗаменить(
			СтрЗаменить(
			СтрЗаменить(
			СтрЗаменить(ШаблонЗапроса, 
			"_ПредварительныеДанные1", "_ПредварительныеДанные" + Строка(НомерПредварительныеДанные + Индекс + 1)), 
			"_ПредварительныеДанные0", "_ПредварительныеДанные" + Строка(НомерПредварительныеДанные + Индекс)), 
			"Плюс1", "Плюс" + Строка(Индекс + 1)),
			"Плюс0", "Плюс" + Индекс);
		КонецЦикла;
	КонецЕсли;
#КонецОбласти	
#Область ИтогиЗапроса
	Запрос.Текст = Запрос.Текст + СтрЗаменить("
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПредварительныеДанные0.*
		|ИЗ
		|	_ПредварительныеДанные0 КАК _ПредварительныеДанные0
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидДоговораДоверительногоУправления,
		|	Стратегия,
		|	СчетДоверительногоУправленияНаименование
		|ИТОГИ
		|	ВЫБОР
		|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Валюта) = 1 
		|			ТОГДА МАКСИМУМ(Валюта)
		|	КОНЕЦ КАК Валюта,
		|	СУММА(АктивыНаНачало),
		|	СУММА(АктивыНаКонец),
		|	СУММА(СредняяСтоимостьИмущества),
		|	СУММА(СредняяСтоимостьИмуществаЗаГод),
		|	СУММА(ПереданоВДУ),
		|	СУММА(АктивыНаКонецРасчетная),
		|	СУММА(Доход),
		|	СУММА(СуммаПоказателей),
		|	МАКСИМУМ(Бенчмарк),
		|	МАКСИМУМ(ДоходностьБенчмарка),
		|	ВЫБОР
		|		КОГДА СУММА(СредняяСтоимостьИмущества) = 0 ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Валюта) > 1 
		|			ТОГДА 0
		|		ИНАЧЕ СУММА(Доход) * 100 / СУММА(СредняяСтоимостьИмущества)
		|	КОНЕЦ КАК Доходность,
		|	СУММА(Обязательства),
		|	СУММА(Дельта),
		|	ВЫБОР
		|		КОГДА СУММА(СредняяСтоимостьИмущества) = 0 ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Валюта) > 1 
		|			ТОГДА 0
		|		КОГДА ТИПЗНАЧЕНИЯ(МАКСИМУМ(Клиент)) = ТИП(Справочник.ПаевыеИнвестиционныеФонды)
		|			ТОГДА СУММА(Доход) * 100 / СУММА(СредняяСтоимостьИмущества)
		|		ИНАЧЕ (СУММА(Доход) + СУММА(СуммаПоказателей)) * 100 / СУММА(СредняяСтоимостьИмущества)
		|	КОНЕЦ КАК ЭффективнаяДоходность,
		|	МИНИМУМ(ДатаНачалаУправления),
		|	МАКСИМУМ(Дней),
		|	СУММА(ВводыВыводы),
		|	СУММА(ДляСреднего),
		|	МАКСИМУМ(ДнейВГоду),
		|	СУММА(ВознаграждениеУправляющего),
		|	СУММА(ПрогнозДоходаДоКонцаГода),
		|	СУММА(ИтогоДоходЗаГод),
		|	СУММА(ИтогоВознаграждение),
		|	СУММА(ВознаграждениеЗаВычетомУдержанного),
		|	СУММА(ВознаграждениеКвартал1),
		|	СУММА(ВознаграждениеКвартал2),
		|	СУММА(ВознаграждениеКвартал3),
		|	СУММА(ВознаграждениеКвартал4),
		|	СУММА(АктивыНаКонецГодаПлюс0),
		|	МАКСИМУМ(ДоходностьВидаДоговораПоМетодикеПФР),
		|	МАКСИМУМ(ДоходностьКлиентаПоМетодикеПФР),
		|	МАКСИМУМ(ДоходностьСтратегииПоМетодикеПФР)
		|ПО
		|	ОБЩИЕ,
		|	Стратегия
		|АВТОУПОРЯДОЧИВАНИЕ", "_ПредварительныеДанные0", "_ПредварительныеДанные" + Строка(НомерПредварительныеДанные + Индекс)); 
	
#КонецОбласти

#Область ИтогиЗапросаНа5Лет
	Если ВариантОтчета = "ПрогнозируемаяДоходность" Тогда
		МассивСтрокЗапроса = СтрРазделить(Запрос.Текст, Символы.ПС);
		
		Для Индекс = 1 По 5 Цикл
			МассивСтрокЗапроса.Вставить(МассивСтрокЗапроса.Количество() - 5, "СУММА(ДоходПлюс" + Индекс + "),");
			МассивСтрокЗапроса.Вставить(МассивСтрокЗапроса.Количество() - 5, "СУММА(ВознаграждениеПлюс" + Индекс + "),");
			МассивСтрокЗапроса.Вставить(МассивСтрокЗапроса.Количество() - 5, "СУММА(АктивыНаКонецГодаПлюс" + Индекс + "),");
		КонецЦикла;
		
		Запрос.Текст = СтрСоединить(МассивСтрокЗапроса, Символы.ПС);
	КонецЕсли;
#КонецОбласти

#Область УдалениеИтоговВРазныхВалютах
	Если ЭтотОбъект.ВидВалюты <> "ВалютаУчета" И ЭтотОбъект.ВариантОтчета <> "ВознагражденияУК" Тогда
		МассивСтрокЗапроса = СтрРазделить(Запрос.Текст, Символы.ПС);
		
		НачалоИтогов = МассивСтрокЗапроса.Найти("ИТОГИ");
		Для Индекс = НачалоИтогов + 1 По МассивСтрокЗапроса.ВГраница() Цикл
			СтрокаЗапроса = МассивСтрокЗапроса[Индекс];
			Если СтрНачинаетсяС(СтрокаЗапроса, "	СУММА(") Тогда
				ЧастиСтрокиЗапроса = СтрРазделить(СтрокаЗапроса, "()");
				ИмяПоля = ЧастиСтрокиЗапроса[1];
				МассивСтрокЗапроса.Установить(Индекс,
					СтрШаблон(
						"	ВЫБОР
						|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Валюта) = 1 
						|			ТОГДА СУММА(%1)
						|		ИНАЧЕ
						|			0
						|	КОНЕЦ КАК %1", ИмяПоля) + ?(ЧастиСтрокиЗапроса[ЧастиСтрокиЗапроса.ВГраница()] = ",", ",", ""));
			КонецЕсли;
		КонецЦикла;
		
		Запрос.Текст = СтрСоединить(МассивСтрокЗапроса,  Символы.ПС);
	КонецЕсли;
#КонецОбласти

	Если ВариантОтчета = "ОбязательстваПередКлиентами" Тогда
		ЗаполнитьОтчетОбязательстваПередКлиентами(ДокументРезультат, Запрос);
		
	ИначеЕсли ВариантОтчета = "РасчетДоходностиДУ"
		Или ВариантОтчета = "РасчетДоходностиДУСокращенная"
		Или ВариантОтчета = "ПрогнозируемаяДоходность"
		Или ВариантОтчета = "ВознагражденияУК"
	Тогда
		ЗаполнитьОтчетРасчетДоходностиДУ(ДокументРезультат, Запрос);
		
	ИначеЕсли ВариантОтчета = "ДоходностьИндексов" Тогда
		ЗаполнитьДоходностьИндексов(ДокументРезультат, Запрос, ТаблицаДоходностей);
		
	КонецЕсли;
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЭтотОбъект.СравнитьСПериодом ИЛИ ВариантОтчета = "РасчетДоходностиДУСокращенная" Тогда
		ПроверяемыеРеквизиты.Добавить("ПериодДляСравнения");
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьТаблицуДоходностей(МассивВидыДоговоровДУ, ДатаНачальная, ДатаКонечная)
	Если ВариантОтчета = "ОбязательстваПередКлиентами" Тогда
		НастройкиРасчета = Новый ТаблицаЗначений;
		НастройкиРасчета.Колонки.Добавить("НастройкаРасчета", Новый ОписаниеТипов("СправочникСсылка.НастройкиРасчета"));
		НастройкиРасчета.Колонки.Добавить("Доходность"		, Новый ОписаниеТипов("Число"));
		НастройкиРасчета.Колонки.Добавить("ДатаНачальная"	, Новый ОписаниеТипов("Дата"));
		
		Возврат НастройкиРасчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивВидыДоговоровДУ"	, МассивВидыДоговоровДУ);
	Запрос.УстановитьПараметр("ДатаНачальная"			, ДатаНачальная);
	Запрос.УстановитьПараметр("ДатаКонечная"			, ДатаКонечная);
	Запрос.УстановитьПараметр("ДатаОкончания"			, ДатаКонечная);
	Запрос.УстановитьПараметр("Организация"				, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ММВБ"					, ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчета.НастройкаРасчета КАК НастройкаРасчета,
		|	НастройкиРасчета.ДатаНачальная КАК ДатаНачальная,
		|	НастройкиРасчетаСоставляющие.БазаРасчета КАК БазаРасчета,
		|	НастройкиРасчетаСоставляющие.ПараметрыРасчета КАК ПараметрыРасчета
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		НастройкиРасчетаБенчмарковСрезПоследних.НастройкаРасчета КАК НастройкаРасчета,
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(ПервыеВводы.Период, &ДатаНачальная) > &ДатаНачальная
		|				ТОГДА ПервыеВводы.Период
		|			ИНАЧЕ &ДатаНачальная
		|		КОНЕЦ КАК ДатаНачальная
		|	ИЗ
		|		РегистрСведений.НастройкиРасчетаБенчмарков.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И (ВЫРАЗИТЬ(СубъектАналитики КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления В (&МассивВидыДоговоровДУ)
		|						ИЛИ ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет) В (&МассивВидыДоговоровДУ)
		|							И ТИПЗНАЧЕНИЯ(СубъектАналитики) = ТИП(Справочник.СтратегииИндивидуальногоИнвестирования))) КАК НастройкиРасчетаБенчмарковСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|			ПО НастройкиРасчетаБенчмарковСрезПоследних.СубъектАналитики = СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО (ВЫБОР
		|					КОГДА НастройкиРасчетаБенчмарковСрезПоследних.СубъектАналитики ССЫЛКА Справочник.СтратегииИндивидуальногоИнвестирования
		|						ТОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|					ИНАЧЕ НастройкиРасчетаБенчмарковСрезПоследних.СубъектАналитики
		|				КОНЕЦ = СчетаДоверительногоУправления.Ссылка)
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|				НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыВыводыАктивовВВалютеУчета.Период), ДЕНЬ) КАК Период
		|			ИЗ
		|				РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|			ГДЕ
		|				ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
		|				И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				И ВводыВыводыАктивовВВалютеУчета.Активность
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления) КАК ПервыеВводы
		|			ПО (СчетаДоверительногоУправления.Ссылка = ПервыеВводы.СчетДоверительногоУправления)) КАК НастройкиРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|		ПО НастройкиРасчета.НастройкаРасчета = НастройкиРасчетаСоставляющие.Ссылка
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(НастройкиРасчета.ДатаНачальная, ДЕНЬ) < НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)";
	#КонецОбласти
	НастройкиРасчета = Запрос.Выполнить().Выгрузить();
	НастройкиРасчета.Колонки.Добавить("БиржевойИндекс"		, Новый ОписаниеТипов("СправочникСсылка.БиржевыеИндексы"));
	НастройкиРасчета.Колонки.Добавить("ЦеннаяБумага"		, Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	НастройкиРасчета.Колонки.Добавить("Превышение"			, Новый ОписаниеТипов("Число"));
	НастройкиРасчета.Колонки.Добавить("Доля"				, Новый ОписаниеТипов("Число"));
	НастройкиРасчета.Колонки.Добавить("Среднеарифметическое", Новый ОписаниеТипов("Булево"));
	НастройкиРасчета.Колонки.Добавить("КоличествоЗначений"	, Новый ОписаниеТипов("Число"));
	НастройкиРасчета.Колонки.Добавить("ВалютаКонвертации"	, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	НастройкиРасчета.Колонки.Добавить("ВидКотировки"		, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	Для Каждого Настройка Из НастройкиРасчета Цикл
		ПараметрыРасчета = Настройка.ПараметрыРасчета.Получить();
		// ФиксированнаяСтавка
		Если Настройка.БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСтавка Тогда
			Настройка.Превышение			= ПараметрыРасчета.ПараметрРасчетаСтавка;
			Настройка.Доля					= 100;
			Настройка.Среднеарифметическое	= Ложь;
		// БиржевойИндекс
		ИначеЕсли Настройка.БазаРасчета = Справочники.БазыРасчета.БиржевойИндекс Тогда
			Настройка.БиржевойИндекс		= ПараметрыРасчета.ПараметрРасчетаБиржевойИндекс;
			Настройка.Доля					= ПараметрыРасчета.ПараметрРасчетаДоля;
			Настройка.Среднеарифметическое	= ПараметрыРасчета.ПараметрСреднеарифметическое;
			Настройка.КоличествоЗначений	= ПараметрыРасчета.ПараметрКоличествоЗначений;
			Настройка.ВалютаКонвертации		= ПараметрыРасчета.ПараметрРасчетаВалютаКонвертации;
		// ИзменениеСтоимостиЦБ
		ИначеЕсли Настройка.БазаРасчета = Справочники.БазыРасчета.ИзменениеСтоимостиЦБ Тогда
			Настройка.ЦеннаяБумага			= ПараметрыРасчета.ПараметрРасчетаЦБ;
			Настройка.Доля					= ПараметрыРасчета.ПараметрРасчетаДоля;
			Настройка.ВидКотировки			= ПараметрыРасчета.ПараметрВидКотировки;
		// КлючеваяСтавкаЦБРФ, ИндексПотребительскихЦен
		ИначеЕсли Настройка.БазаРасчета = Справочники.БазыРасчета.КлючеваяСтавкаЦБРФ
			Или Настройка.БазаРасчета = Справочники.БазыРасчета.ИндексПотребительскихЦен
		Тогда
			Настройка.Доля					= ПараметрыРасчета.ПараметрРасчетаДоля;
			Настройка.Среднеарифметическое	= Ложь;
		КонецЕсли;
	КонецЦикла;
	
	НастройкиРасчета.Колонки.Удалить("ПараметрыРасчета");
	Запрос.УстановитьПараметр("НастройкиРасчета", НастройкиРасчета);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиРасчета.НастройкаРасчета КАК НастройкаРасчета,
		|	ВЫРАЗИТЬ(НастройкиРасчета.ДатаНачальная КАК ДАТА) КАК ДатаНачальная,
		|	НастройкиРасчета.БазаРасчета КАК БазаРасчета,
		|	ВЫРАЗИТЬ(НастройкиРасчета.БиржевойИндекс КАК Справочник.БиржевыеИндексы) КАК БиржевойИндекс,
		|	НастройкиРасчета.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НастройкиРасчета.Превышение КАК Превышение,
		|	НастройкиРасчета.Доля КАК Доля,
		|	НастройкиРасчета.Среднеарифметическое КАК Среднеарифметическое,
		|	НастройкиРасчета.ВалютаКонвертации КАК ВалютаКонвертации,
		|	НастройкиРасчета.ВидКотировки КАК ВидКотировки,
		|	ВЫРАЗИТЬ(НастройкиРасчета.КоличествоЗначений КАК ЧИСЛО(10, 2)) КАК КоличествоЗначений
		|ПОМЕСТИТЬ ВТ_НастройкаРасчета
		|ИЗ
		|	&НастройкиРасчета КАК НастройкиРасчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БиржевойИндекс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_НастройкаРасчета.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВТ_НастройкаРасчета.ДатаНачальная КАК ДатаНачальная,
		|	ВТ_НастройкаРасчета.ВидКотировки КАК ВидКотировки,
		|	СправочникАкции.ВалютаНоминала КАК ВалютаНоминала,
		|	ВТ_НастройкаРасчета.ДатаНачальная КАК НаДату,
		|	ИСТИНА КАК НаНачало
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК СправочникАкции
		|		ПО ВТ_НастройкаРасчета.ЦеннаяБумага = СправочникАкции.Ссылка
		|ГДЕ
		|	ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИзменениеСтоимостиЦБ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_НастройкаРасчета.ЦеннаяБумага,
		|	ВТ_НастройкаРасчета.ДатаНачальная,
		|	ВТ_НастройкаРасчета.ВидКотировки,
		|	СправочникАкции.ВалютаНоминала,
		|	&ДатаКонечная,
		|	ЛОЖЬ
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК СправочникАкции
		|		ПО ВТ_НастройкаРасчета.ЦеннаяБумага = СправочникАкции.Ссылка
		|ГДЕ
		|	ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИзменениеСтоимостиЦБ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВТ_НастройкаРасчета.БиржевойИндекс КАК БиржевойИндекс,
		|	ВТ_НастройкаРасчета.ДатаНачальная КАК ДатаНачальная,
		|	ВТ_НастройкаРасчета.Среднеарифметическое КАК Среднеарифметическое,
		|	ВТ_НастройкаРасчета.КоличествоЗначений КАК КоличествоЗначений,
		|	ВТ_НастройкаРасчета.ВалютаКонвертации КАК ВалютаКонвертации
		|ПОМЕСТИТЬ ВТ_БиржевыеИндексы
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|ГДЕ
		|	ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.БиржевойИндекс)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПериодыКлючевыхСтавок.ДатаНачальная КАК ДатаНачальная,
		|	ВЫБОР
		|		КОГДА ПериодыКлючевыхСтавок.ДатаНачальная > КлючевыеСтавкиЦБРФ.ДатаЗначения
		|			ТОГДА ПериодыКлючевыхСтавок.ДатаНачальная
		|		ИНАЧЕ КлючевыеСтавкиЦБРФ.ДатаЗначения
		|	КОНЕЦ КАК Период,
		|	КлючевыеСтавкиЦБРФ.ЗначениеПоказателя КАК КлючеваяСтавка
		|ПОМЕСТИТЬ ВТ_КлючевыеСтавки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_НастройкаРасчета.ДатаНачальная КАК ДатаНачальная,
		|		МАКСИМУМ(КлючевыеСтавкиЦБРФ.ДатаЗначения) КАК ПериодПервойКлючевойСтавки
		|	ИЗ
		|		ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|					&ДатаКонечная,
		|					Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|						И Прогноз = ЛОЖЬ) КАК КлючевыеСтавкиЦБРФ
		|			ПО ВТ_НастройкаРасчета.ДатаНачальная >= КлючевыеСтавкиЦБРФ.Период
		|	ГДЕ
		|		ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.КлючеваяСтавкаЦБРФ)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_НастройкаРасчета.ДатаНачальная) КАК ПериодыКлючевыхСтавок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|				&ДатаКонечная,
		|				Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|					И Прогноз = ЛОЖЬ) КАК КлючевыеСтавкиЦБРФ
		|		ПО (КлючевыеСтавкиЦБРФ.ДатаЗначения МЕЖДУ ПериодыКлючевыхСтавок.ПериодПервойКлючевойСтавки И &ДатаКонечная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ДатаНачала.ДатаНачальная КАК ДатаНачальная,
		|	ВТ_ДатаНачала.КлючеваяСтавка * РАЗНОСТЬДАТ(ВТ_ДатаНачала.Период, ЕСТЬNULL(МИНИМУМ(ВТ_ДатаОкончания.Период), НАЧАЛОПЕРИОДА(&ДатаКонечная, ДЕНЬ)), ДЕНЬ) / РАЗНОСТЬДАТ(ВТ_ДатаНачала.ДатаНачальная, &ДатаКонечная, ДЕНЬ) КАК СтавкаВДень
		|ПОМЕСТИТЬ ВТ_КлючевыеСтавкиСумма
		|ИЗ
		|	ВТ_КлючевыеСтавки КАК ВТ_ДатаНачала
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КлючевыеСтавки КАК ВТ_ДатаОкончания
		|		ПО ВТ_ДатаНачала.ДатаНачальная = ВТ_ДатаОкончания.ДатаНачальная
		|			И ВТ_ДатаНачала.Период < ВТ_ДатаОкончания.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ДатаНачала.ДатаНачальная,
		|	ВТ_ДатаНачала.КлючеваяСтавка,
		|	ВТ_ДатаНачала.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПроцентныеПоказателиСрезПоследних.ДатаЗначения КАК Дата,
		|	МЕСЯЦ(ПроцентныеПоказателиСрезПоследних.ДатаЗначения) КАК МЕСЯЦ,
		|	ПроцентныеПоказателиСрезПоследних.ЗначениеПоказателя КАК Значение
		|ПОМЕСТИТЬ _ИнфляцияККонцуПредыдущегоМесяца
		|ИЗ
		|	РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|			,
		|			Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца)
		|				И НЕ Прогноз) КАК ПроцентныеПоказателиСрезПоследних
		|ГДЕ
		|	ПроцентныеПоказателиСрезПоследних.ДатаЗначения МЕЖДУ &ДатаНачальная И &ДатаКонечная
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 1
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Январь,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 2
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Февраль,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 3
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Март,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 4
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Апрель,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 5
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Май,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 6
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Июнь,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 7
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Июль,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 8
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Август,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 9
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Сентябрь,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 10
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Октябрь,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 11
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Ноябрь,
		|	ВЫБОР
		|		КОГДА МЕСЯЦ(ВложенныйЗапрос.Дата) = 12
		|			ТОГДА (_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(КОНЕЦПЕРИОДА(ВложенныйЗапрос.Дата, МЕСЯЦ))
		|	КОНЕЦ КАК Декабрь,
		|	(_ИнфляцияККонцуПредыдущегоМесяца.Значение - 100) / ДЕНЬ(_ИнфляцияККонцуПредыдущегоМесяца.Дата) КАК Значение
		|ПОМЕСТИТЬ _ИнфляцияПоМесяцам
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДанныеКалендаря.Дата КАК Дата,
		|		МАКСИМУМ(_ИнфляцияККонцуПредыдущегоМесяца.Дата) КАК ДатаИнфляции
		|	ИЗ
		|		РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ИнфляцияККонцуПредыдущегоМесяца КАК _ИнфляцияККонцуПредыдущегоМесяца
		|			ПО (ДанныеКалендаря.Дата >= НАЧАЛОПЕРИОДА(_ИнфляцияККонцуПредыдущегоМесяца.Дата, МЕСЯЦ))
		|	ГДЕ
		|		ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|		И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачальная И &ДатаКонечная
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ДанныеКалендаря.Дата) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнфляцияККонцуПредыдущегоМесяца КАК _ИнфляцияККонцуПредыдущегоМесяца
		|		ПО ВложенныйЗапрос.ДатаИнфляции = _ИнфляцияККонцуПредыдущегоМесяца.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИнфляцияККонцуПредыдущегоГод.ДатаНачальная КАК ДатаНачальная,
		|	ИнфляцияККонцуПредыдущегоГод.Значение КАК Значение,
		|	(ИнфляцияККонцуПредыдущегоГод.Значение - 100) * ДЕНЬГОДА(КОНЕЦПЕРИОДА(&ДатаКонечная, ГОД)) / (РАЗНОСТЬДАТ(ИнфляцияККонцуПредыдущегоГод.ДатаНачальная, &ДатаКонечная, ДЕНЬ) + 1) КАК Доходность
		|ПОМЕСТИТЬ _ИнфляцияККонцуПредыдущегоГод
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_НастройкаРасчета.ДатаНачальная КАК ДатаНачальная,
