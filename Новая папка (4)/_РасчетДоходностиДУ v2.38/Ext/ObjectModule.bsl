		|			И (ВТ_ЗначенияБиржевыхИндексов.НаДату = &ДатаКонечная)";
	
	ДокументРезультат.Очистить();
	
	Макет = ПолучитьМакет("ДоходностьИндексов"); 		
	
	ОбластьШапка	= Макет.ПолучитьОбласть("ШапкаИндекс");
	ОбластьСтрока	= Макет.ПолучитьОбласть("СтрокаИндекс");
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
		ДокументРезультат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ДокументРезультат.Вывести(Макет.ПолучитьОбласть("Разрыв"));
	
	ОбластьШапка	= Макет.ПолучитьОбласть("ШапкаНастройки");
	ОбластьСтрока	= Макет.ПолучитьОбласть("СтрокаНастройки");
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ПараметрыПоиска = Новый Структура("ДатаНачальная", НачалоГода(ЭтотОбъект.Период));
	
	Для Каждого СтрокаДоходностей Из ТаблицаДоходностей.НайтиСтроки(ПараметрыПоиска) Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДоходностей);
		ДокументРезультат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ВывестиОписаниеИндексов(ДокументРезультат);
	
	ДокументРезультат.ФиксацияСверху = 1;
	
КонецПроцедуры

#Область СЧА_ПоПисьмуЦБ

Функция ПолучитьТаблицаСЧАБезПослаблений(ВидыДоговоровСЧАБезПослаблений, СписокДоговоров)

	Запрос = Новый Запрос;
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок) КАК ВидПоказателя
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА &ОтборПоДоговорам
		|				ТОГДА СчетаДоверительногоУправления.Ссылка В (&СписокДоговоров)
		|			ИНАЧЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровСЧАБезПослаблений)
		|		КОНЕЦ
		|	И &РассчитыватьСЧАБезПослаблений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаНачала КАК Дата,
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаНачала,
		|	ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) КАК ДатаОкончания
		|ПОМЕСТИТЬ ВТ_РабочиеДни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	&ДатаНачала >= ДАТАВРЕМЯ(2020, 3, 1)
		|	И ДанныеКалендаря.Дата < &ДатаНачала
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) ЕСТЬ НЕ NULL 
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&ДатаОкончания,
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	&ДатаОкончания
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	&ДатаОкончания >= ДАТАВРЕМЯ(2020, 3, 1)
		|	И ДанныеКалендаря.Дата <= &ДатаОкончания
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Дата КАК Дата,
		|	ВложенныйЗапрос.ДатаСЧА КАК ДатаСЧА,
		|	ДОБАВИТЬКДАТЕ(ВложенныйЗапрос.Дата, ДЕНЬ, -1) КАК ДатаДляРасчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДУ.Ссылка КАК СчетДоверительногоУправления,
		|		ВТ_РабочиеДни.Дата КАК Дата,
		|		_СчетаДУ.ВидПоказателя КАК ВидПоказателя,
		|		МАКСИМУМ(ФинансовыеПоказатели.Период) КАК ДатаСЧА
		|	ИЗ
		|		_СчетаДУ КАК _СчетаДУ
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РабочиеДни КАК ВТ_РабочиеДни
		|			ПО (ИСТИНА)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ПО _СчетаДУ.Ссылка = ФинансовыеПоказатели.СубъектАналитики
		|				И (ФинансовыеПоказатели.ВидПоказателя = _СчетаДУ.ВидПоказателя)
		|				И (ФинансовыеПоказатели.Период МЕЖДУ ВТ_РабочиеДни.ДатаНачала И ВТ_РабочиеДни.ДатаОкончания)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДУ.Ссылка,
		|		ВТ_РабочиеДни.Дата,
		|		_СчетаДУ.ВидПоказателя) КАК ВложенныйЗапрос";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"						, НачалоГода(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ДатаОкончания"					, КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ОтборПоДоговорам"				, ЭтотОбъект.ОтборПоДоговорам);
	Запрос.УстановитьПараметр("СписокДоговоров"					, СписокДоговоров);
	Запрос.УстановитьПараметр("ВидыДоговоровСЧАБезПослаблений"	, ВидыДоговоровСЧАБезПослаблений);
	Запрос.УстановитьПараметр("РассчитыватьСЧАБезПослаблений"	, ЭтотОбъект.РассчитыватьСЧАБезПослаблений);
	
	ТаблицаСЧАБезПослаблений = Запрос.Выполнить().Выгрузить();
	ТаблицаСЧАБезПослаблений.Колонки.Добавить("СЧА", Новый ОписаниеТипов("Число"));
	
	Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ"); 
	//Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ = ВнешниеОтчеты.Создать("\\ap69\Developers\Рома\Epf\_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.erf");
	Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.Организация = ЭтотОбъект.Организация;
	
	МассивСтрокДляУдаления = Новый Массив;
	
	Для Каждого СтрокаСЧА Из ТаблицаСЧАБезПослаблений Цикл
		Если ЗначениеЗаполнено(СтрокаСЧА.ДатаСЧА) Тогда
			Если РаботаСПереоценкой.ОпределитьНастройкиОценки(
						СтрокаСЧА.ДатаСЧА, 
						ЭтотОбъект.Организация, 
						СтрокаСЧА.СчетДоверительногоУправления, 
						Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении).ВыполнятьРасчетПоПисьмуЦБ0185316 = ИСТИНА Тогда
				
				Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.СчетДоверительногоУправления	= СтрокаСЧА.СчетДоверительногоУправления;
				Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.Период						= СтрокаСЧА.ДатаСЧА;
				
				Попытка
					РСА = Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.ПолучитьРегистрациюСтоимостиАктивовБезРасчетаПоПисьму(Ложь);
					СтрокаСЧА.СЧА = РСА.СЧАРынок;
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			Иначе
				МассивСтрокДляУдаления.Добавить(СтрокаСЧА);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаСЧА Из МассивСтрокДляУдаления Цикл
		ТаблицаСЧАБезПослаблений.Удалить(СтрокаСЧА);
	КонецЦикла;	
	
	Возврат ТаблицаСЧАБезПослаблений;
	
КонецФункции

#КонецОбласти

