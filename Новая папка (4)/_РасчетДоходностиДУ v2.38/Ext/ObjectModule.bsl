		ВызватьИсключение "В отчётном периоде начисление по НДФЛ попадает в СЧА. Формирование отчёта невозможно. Обратитесь к разрабочикам. Задача #360946";
	КонецЕсли;
КонецПроцедуры

Функция ЗарегистрироватьСессиюСбораСтатистики(Механизм)
	
	ДополнительныеСвойства = Новый Структура;
	
	Для Каждого МетаРеквизит Из ЭтотОбъект.Метаданные().Реквизиты Цикл
		Если МетаРеквизит.Тип = Новый ОписаниеТипов("СписокЗначений") Тогда
			МассивЗначение = Новый Массив;
			
			Для Каждого ЭлементСписка Из ЭтотОбъект[МетаРеквизит.Имя] Цикл
				Если ЭлементСписка.Пометка Тогда
					МассивЗначение.Добавить(ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
			
			ДополнительныеСвойства.Вставить(МетаРеквизит.Имя, СтрСоединить(МассивЗначение, ", "));
			
		КонецЕсли;
	КонецЦикла;		
	
	ПараметрыВыполнения = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект,, ДополнительныеСвойства);
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполнения.Хранилище, ПараметрыВыполнения.Описание);
	
	Возврат Сессия;
	
КонецФункции

Функция РассчитатьДоходностьПоМетодикеПФР(ВидыДоговоров, СписокДоговоров)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ЭтотОбъект.ОтборПоДоговорам Тогда
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиСтратегииСНачалаГодаВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период, "СчетаДоверительногоУправления", СписокДоговоров);
	Иначе
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиСтратегииСНачалаГодаВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период, "ВидыДоговоровДоверительногоУправления", ВидыДоговоров);
	КонецЕсли;
	
	МассивТиповСубъектаАналитики = Новый Массив;
	МассивТиповСубъектаАналитики.Добавить(Тип("СправочникСсылка.СчетаДоверительногоУправления"));
	МассивТиповСубъектаАналитики.Добавить(Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования"));
	МассивТиповСубъектаАналитики.Добавить(Тип("СправочникСсылка.ЮрФизЛица"));
	МассивТиповСубъектаАналитики.Добавить(Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"));
	МассивТиповСубъектаАналитики.Добавить(Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	
	МассивТиповДоходности = Новый Массив;
	МассивТиповДоходности.Добавить(Тип("Число"));
	МассивТиповДоходности.Добавить(Тип("Строка"));
	
	ТаблицаДоходности = Новый ТаблицаЗначений;
	ТаблицаДоходности.Колонки.Добавить("СубъектАналитики"	, Новый ОписаниеТипов(МассивТиповСубъектаАналитики));
	ТаблицаДоходности.Колонки.Добавить("Доходность"			, Новый ОписаниеТипов(МассивТиповДоходности, Новый КвалификаторыЧисла(19, 2), Новый КвалификаторыСтроки(1000)));
	
	Если ЭтотОбъект.ПечатьСРасшифровкой Тогда
		РасшифровкаДоходностиПоМетодикеПФР	= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Расшифровка",,, "ЛОЖЬ").Выгрузить(); //пустая таблица
	КонецЕсли;
	
	ВыборкаСубъектАналитики				= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Расшифровка",,,, "СубъектАналитики, ДатаРасчета", "СубъектАналитики", "МАКСИМУМ(КоличествоДней)").Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Таблица_КонтрольСЧА					= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_КонтрольСЧА").Выгрузить();
	
	Пока ВыборкаСубъектАналитики.Следующий() Цикл
		
		ПараметрыПоискаСЧАNull = Новый Структура;
		Если ТипЗнч(ВыборкаСубъектАналитики.СубъектАналитики) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			ПараметрыПоискаСЧАNull.Вставить("СчетДоверительногоУправления", ВыборкаСубъектАналитики.СубъектАналитики);
		ИначеЕсли ТипЗнч(ВыборкаСубъектАналитики.СубъектАналитики) = Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления") Тогда
			ПараметрыПоискаСЧАNull.Вставить("ВидДоговораДоверительногоУправления", ВыборкаСубъектАналитики.СубъектАналитики);
		ИначеЕсли ТипЗнч(ВыборкаСубъектАналитики.СубъектАналитики) = Тип("СправочникСсылка.ЮрФизЛица")
		 ИЛИ ТипЗнч(ВыборкаСубъектАналитики.СубъектАналитики) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
			ПараметрыПоискаСЧАNull.Вставить("Клиент", ВыборкаСубъектАналитики.СубъектАналитики);
		ИначеЕсли ТипЗнч(ВыборкаСубъектАналитики.СубъектАналитики) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
			ПараметрыПоискаСЧАNull.Вставить("Стратегия", ВыборкаСубъектАналитики.СубъектАналитики);
		Иначе
			ПараметрыПоискаСЧАNull.Вставить("СчетДоверительногоУправления", NULL);
		КонецЕсли;
		
		НайденныеСтроки_КонтрольСЧА = Таблица_КонтрольСЧА.НайтиСтроки(ПараметрыПоискаСЧАNull);
		
		Если НайденныеСтроки_КонтрольСЧА.Количество() > 0 Тогда
			МассивСтрокСообщения = Новый Массив;
			
			Для Каждого Строка_КонтрольСЧА Из НайденныеСтроки_КонтрольСЧА Цикл
				МассивСтрокСообщения.Добавить(СтрШаблон("по счёту %1 не зарегистрирована СЧА на %2", Строка_КонтрольСЧА.СчетДоверительногоУправления, Формат(Строка_КонтрольСЧА.ДатаСЧА, "ДФ=dd.MM.yyyy")));
			КонецЦикла;
			
			СтрокаДоходности = ТаблицаДоходности.Добавить();
			СтрокаДоходности.СубъектАналитики	= ВыборкаСубъектАналитики.СубъектАналитики;
			СтрокаДоходности.Доходность			= СтрСоединить(МассивСтрокСообщения, ", ") + ".";
			
		Иначе
		
			ПриростИтог = 1;
			
			Выборка = ВыборкаСубъектАналитики.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ПриростИтог = ПриростИтог * Выборка.Прирост;
				
				Если ЭтотОбъект.ПечатьСРасшифровкой Тогда
					СтрокаРасшифровки = РасшифровкаДоходностиПоМетодикеПФР.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, Выборка);
					СтрокаРасшифровки.ПриростИтог	 = ПриростИтог;
					СтрокаРасшифровки.КоличествоДней = ВыборкаСубъектАналитики.КоличествоДней;
				КонецЕсли;
			
			КонецЦикла;
			
			СтрокаДоходности = ТаблицаДоходности.Добавить();
			СтрокаДоходности.СубъектАналитики = ВыборкаСубъектАналитики.СубъектАналитики;
			
			Если ВыборкаСубъектАналитики.КоличествоДней <> 0 Тогда
				СтрокаДоходности.Доходность = ОКР((ПриростИтог - 1) * 365 / ВыборкаСубъектАналитики.КоличествоДней * 100, 2);
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДоходности;
	
КонецФункции









