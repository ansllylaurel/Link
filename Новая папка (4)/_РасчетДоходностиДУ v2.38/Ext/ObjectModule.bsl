		|		ПО (ВТ_НастройкаРасчета.БиржевойИндекс.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыБиржевыхИндексов.Доходность))
		|			И ВТ_НастройкаРасчета.БиржевойИндекс = ВТ_ЗначенияБиржевыхИндексов.БиржевойИндекс
		|			И ВТ_НастройкаРасчета.Среднеарифметическое = ВТ_ЗначенияБиржевыхИндексов.Среднеарифметическое
		|			И ВТ_НастройкаРасчета.ДатаНачальная = ВТ_ЗначенияБиржевыхИндексов.ДатаНачальная
		|			И (ВТ_ЗначенияБиржевыхИндексов.НаДату = &ДатаКонечная)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.БазыРасчета.КлючеваяСтавкаЦБРФ),
		|	ВТ_КлючевыеСтавкиСумма.ДатаНачальная,
		|	NULL,
		|	NULL,
		|	"""",
		|	ЛОЖЬ,
		|	0,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
		|	СУММА(ВТ_КлючевыеСтавкиСумма.СтавкаВДень)
		|ИЗ
		|	ВТ_КлючевыеСтавкиСумма КАК ВТ_КлючевыеСтавкиСумма
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_КлючевыеСтавкиСумма.ДатаНачальная
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИндексПотребительскихЦен),
		|	_ИнфляцияККонцуПредыдущегоГод.ДатаНачальная,
		|	NULL,
		|	NULL,
		|	"""",
		|	ЛОЖЬ,
		|	0,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
		|	_ИнфляцияККонцуПредыдущегоГод.Доходность
		|ИЗ
		|	_ИнфляцияККонцуПредыдущегоГод КАК _ИнфляцияККонцуПредыдущегоГод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_НастройкаРасчета.БазаРасчета,
		|	ВТ_НастройкаРасчета.ДатаНачальная,
		|	NULL,
		|	NULL,
		|	"""",
		|	ЛОЖЬ,
		|	0,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
		|	0
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|ГДЕ
		|	ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ФиксированнаяСтавка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_НастройкаРасчета.БазаРасчета,
		|	ВТ_НастройкаРасчета.ДатаНачальная,
		|	NULL,
		|	ВТ_НастройкаРасчета.ЦеннаяБумага,
		|	ВТ_НастройкаРасчета.ВидКотировки,
		|	ЛОЖЬ,
		|	0,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(КотировкиНаНачало.Котировка, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ (КотировкиНаКонец.Котировка - КотировкиНаНачало.Котировка) * 100 * ДЕНЬГОДА(КОНЕЦПЕРИОДА(&ДатаКонечная, ГОД)) / КотировкиНаНачало.Котировка / (РАЗНОСТЬДАТ(ВТ_НастройкаРасчета.ДатаНачальная, &ДатаКонечная, ДЕНЬ) + 1)
		|	КОНЕЦ
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК КотировкиНаНачало
		|		ПО ВТ_НастройкаРасчета.ЦеннаяБумага = КотировкиНаНачало.ЦеннаяБумага
		|			И ВТ_НастройкаРасчета.ВидКотировки = КотировкиНаНачало.ВидКотировки
		|			И (КотировкиНаНачало.НаНачало)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КотировкиЦенныхБумаг КАК КотировкиНаКонец
		|		ПО ВТ_НастройкаРасчета.ЦеннаяБумага = КотировкиНаКонец.ЦеннаяБумага
		|			И ВТ_НастройкаРасчета.ВидКотировки = КотировкиНаКонец.ВидКотировки
		|			И (НЕ КотировкиНаКонец.НаНачало)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_НастройкаРасчета.НастройкаРасчета КАК НастройкаРасчета,
		|	ВТ_НастройкаРасчета.ДатаНачальная КАК ДатаНачальная,
		|	ВЫРАЗИТЬ(СУММА(_ТаблицаДоходностей.Доходность * ВТ_НастройкаРасчета.Доля / 100 + ВТ_НастройкаРасчета.Превышение) КАК ЧИСЛО(19, 2)) КАК Доходность
		|ИЗ
		|	ВТ_НастройкаРасчета КАК ВТ_НастройкаРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаДоходностей КАК _ТаблицаДоходностей
		|		ПО ВТ_НастройкаРасчета.БазаРасчета = _ТаблицаДоходностей.БазаРасчета
		|			И ВТ_НастройкаРасчета.ДатаНачальная = _ТаблицаДоходностей.ДатаНачальная
		|			И (ВЫБОР
		|				КОГДА ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.БиржевойИндекс)
		|					ТОГДА ВТ_НастройкаРасчета.БиржевойИндекс = _ТаблицаДоходностей.БиржевойИндекс
		|							И ВТ_НастройкаРасчета.Среднеарифметическое = _ТаблицаДоходностей.Среднеарифметическое
		|							И ВТ_НастройкаРасчета.КоличествоЗначений = _ТаблицаДоходностей.КоличествоЗначений
		|							И ВТ_НастройкаРасчета.ВалютаКонвертации = _ТаблицаДоходностей.ВалютаКонвертации
		|				КОГДА ВТ_НастройкаРасчета.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИзменениеСтоимостиЦБ)
		|					ТОГДА ВТ_НастройкаРасчета.ЦеннаяБумага = _ТаблицаДоходностей.ЦеннаяБумага
		|							И ВТ_НастройкаРасчета.ВидКотировки = _ТаблицаДоходностей.ВидКотировки
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_НастройкаРасчета.НастройкаРасчета,
		|	ВТ_НастройкаРасчета.ДатаНачальная
		|
		|УПОРЯДОЧИТЬ ПО
		|	НастройкаРасчета
		|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецОбласти
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьТаблицуНастроекПлановогоВознаграждения(ВидыДоговоров, ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заполнить"		, ВариантОтчета = "ПрогнозируемаяДоходность");
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидыДоговоров"	, ВидыДоговоров);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	НастройкиРасчетаСоставляющие.БазаРасчета КАК БазаРасчета,
		|	НастройкиРасчетаСоставляющие.ПараметрыРасчета КАК ПараметрыРасчета,
		|	НастройкиРасчетаСоставляющие.Периодичность КАК Периодичность,
		|	НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.НастройкаРасчета КАК НастройкаРасчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И ВидВознаграждения = ЗНАЧЕНИЕ(Перечисление.ВидыВознагражденийУправляющего.ПлановоеВознаграждениеУправляющего)) КАК НастройкиРасчетаВознагражденияУправляющегоСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|			ПО НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.НастройкаРасчета = НастройкиРасчетаСоставляющие.Ссылка
		|				И (НастройкиРасчетаСоставляющие.НомерСтроки = 1)
		|		ПО (НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	&Заполнить
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ВидыДоговоров)
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания";
#КонецОбласти

	НастройкиПлановогоВознаграждения = Запрос.Выполнить().Выгрузить();
	НастройкиПлановогоВознаграждения.Колонки.Добавить("СтавкаВознаграждения"	, Новый ОписаниеТипов("Число"));
	НастройкиПлановогоВознаграждения.Колонки.Добавить("МинимальнаяДоходность", Новый ОписаниеТипов("Число"));
	
	Для Каждого Настройка Из НастройкиПлановогоВознаграждения Цикл
		Если ЗначениеЗаполнено(Настройка.ПараметрыРасчета) Тогда
			ПараметрыРасчета = Настройка.ПараметрыРасчета.Получить();
			
			Если Настройка.БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход Тогда
				Настройка.СтавкаВознаграждения = ПараметрыРасчета.ПараметрРасчетаСтавка;
				
			ИначеЕсли Настройка.БазаРасчета = Справочники.БазыРасчета.СредняяРыночнаяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного Тогда
				Настройка.СтавкаВознаграждения = ПараметрыРасчета.ПараметрРасчетаСтавка;
				
			ИначеЕсли Настройка.БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом Тогда
				Настройка.СтавкаВознаграждения	= ПараметрыРасчета.ПараметрРасчетаСтавкаПревышение;
				Настройка.МинимальнаяДоходность = ПараметрыРасчета.ПараметрРасчетаСтавкаМД;
				
		    КонецЕсли;
	    КонецЕсли;
	КонецЦикла;
	
	НастройкиПлановогоВознаграждения.Колонки.Удалить("ПараметрыРасчета");
	
	Возврат НастройкиПлановогоВознаграждения;
	
КонецФункции

Функция ПолучитьТаблицуНастроекВознагражденияСГарантированнымДоходом(ВидыДоговоров, ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидыДоговоров"	, ВидыДоговоров);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	НастройкиРасчетаСоставляющие.БазаРасчета КАК БазаРасчета,
		|	НастройкиРасчетаСоставляющие.ПараметрыРасчета КАК ПараметрыРасчета,
		|	НастройкиРасчетаСоставляющие.Периодичность КАК Периодичность,
		|	НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.НастройкаРасчета КАК НастройкаРасчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиРасчетаВознагражденияУправляющего.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И ВидВознаграждения = ЗНАЧЕНИЕ(Перечисление.ВидыВознагражденийУправляющего.ВознаграждениеУправляющего)) КАК НастройкиРасчетаВознагражденияУправляющегоСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК НастройкиРасчетаСоставляющие
		|			ПО НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.НастройкаРасчета = НастройкиРасчетаСоставляющие.Ссылка
		|				И (НастройкиРасчетаСоставляющие.НомерСтроки = 1)
		|		ПО (НастройкиРасчетаВознагражденияУправляющегоСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ВидыДоговоров)
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания";
#КонецОбласти

	НастройкиВознаграждения = Запрос.Выполнить().Выгрузить();
	НастройкиВознаграждения.Колонки.Добавить("СтавкаГарантированногоДохода", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(19, 2)));
	
	Для Каждого Настройка Из НастройкиВознаграждения Цикл
		
		Если ЗначениеЗаполнено(Настройка.ПараметрыРасчета) Тогда
			
			ПараметрыРасчета = Настройка.ПараметрыРасчета.Получить();
			
			Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаГД") Тогда		
				Настройка.СтавкаГарантированногоДохода = ПараметрыРасчета.ПараметрРасчетаСтавкаГД;				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НастройкиВознаграждения.Колонки.Удалить("ПараметрыРасчета");
	
	Возврат НастройкиВознаграждения;
	
КонецФункции

Функция ПолучитьТаблицуКодыСчетовУБрокера(ВидыДоговоров, ДатаОкончания)
	
	ТаблицаКодовСчетовУБрокера = Новый ТаблицаЗначений;
	ТаблицаКодовСчетовУБрокера.Колонки.Добавить("СчетДоверительногоУправления"	, Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));  
	ТаблицаКодовСчетовУБрокера.Колонки.Добавить("КодСчетаУБрокера"				, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыДоговоров"	, ВидыДоговоров);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК КодСчетаУБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|				И СчетДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаОкончания, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения < &ДатаОкончания
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаОкончания)
		|	И КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НоваяСтрока = ТаблицаКодовСчетовУБрокера.Добавить(); //Пустая строка нужна для проверки смены счета ду, потом удалим.
	
	Пока Выборка.Следующий() Цикл
		Если НоваяСтрока.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления Тогда
			НоваяСтрока.КодСчетаУБрокера = НоваяСтрока.КодСчетаУБрокера + ", " + Выборка.КодСчетаУБрокера;
		Иначе
			НоваяСтрока = ТаблицаКодовСчетовУБрокера.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКодовСчетовУБрокера.Удалить(0);
	
	Возврат ТаблицаКодовСчетовУБрокера;
	
КонецФункции

Процедура ЗаполнитьОтчетОбязательстваПередКлиентами(ДокументРезультат, Запрос)
	
	Макет = ПолучитьМакет(ВариантОтчета); 		
	
	ОбластьШапка								= Макет.ПолучитьОбласть("Шапка");
	ОбластьВидДоговораДоверительногоУправления	= Макет.ПолучитьОбласть("ВидДоговораДоверительногоУправления");
	ОбластьСчетДоверительногоУправления			= Макет.ПолучитьОбласть("СчетДоверительногоУправления");
	
	ДокументРезультат.Очистить();
	ДокументРезультат.Вывести(ОбластьШапка);
	
	МассивСтрокЗапроса = СтрРазделить(Запрос.Текст, Символы.ПС);
	МассивСтрокЗапроса.Установить(МассивСтрокЗапроса.Найти("	ОБЩИЕ,"), 		"ВидДоговораДоверительногоУправления");
	МассивСтрокЗапроса.Установить(МассивСтрокЗапроса.Найти("	Стратегия,"),	"");
	МассивСтрокЗапроса.Установить(МассивСтрокЗапроса.Найти("	Стратегия"),	"");
	
	Запрос.Текст = СтрСоединить(МассивСтрокЗапроса,  Символы.ПС);
	
	ВыборкаВидДоговораДоверительногоУправления = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидДоговораДоверительногоУправления.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьВидДоговораДоверительногоУправления.Параметры, ВыборкаВидДоговораДоверительногоУправления);
		
		ДокументРезультат.Вывести(ОбластьВидДоговораДоверительногоУправления);
		ДокументРезультат.НачатьГруппуСтрок();
		
		ВыборкаСчетаДУ = ВыборкаВидДоговораДоверительногоУправления.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			Если ВыборкаСчетаДУ.ТипЗаписи() <> ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОбластьСчетДоверительногоУправления.Параметры, ВыборкаСчетаДУ);
			ДокументРезультат.Вывести(ОбластьСчетДоверительногоУправления);
		КонецЦикла;
		
		ДокументРезультат.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	ДокументРезультат.ФиксацияСверху = 1;
	
КонецПроцедуры	

Процедура ЗаполнитьОтчетРасчетДоходностиДУ(ДокументРезультат, Запрос)
	Макет = ПолучитьМакет(ВариантОтчета);
	
	ИмяДополнительнойОбласти = ?(Не ЭтотОбъект.СравнитьСПериодом, "|Основная", "");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка" + ИмяДополнительнойОбласти);
	
	Если Макет.Области.Найти("Итоги") = Неопределено Тогда
		ОбластьИтоги = Неопределено;
	Иначе
		ОбластьИтоги = Макет.ПолучитьОбласть("Итоги" + ИмяДополнительнойОбласти);
	КонецЕсли;
	
	ОбластиГруппировок = Новый Структура;
	ОбластиГруппировок.Вставить("ВидДоговораДоверительногоУправления"	, Макет.ПолучитьОбласть("ВидДоговораДоверительногоУправления" + ИмяДополнительнойОбласти));
	ОбластиГруппировок.Вставить("Управляющий"							, Макет.ПолучитьОбласть("Управляющий" + ИмяДополнительнойОбласти));
	ОбластиГруппировок.Вставить("Клиент"								, Макет.ПолучитьОбласть("Клиент" + ИмяДополнительнойОбласти));
	ОбластиГруппировок.Вставить("Стратегия"								, Макет.ПолучитьОбласть("Стратегия" + ИмяДополнительнойОбласти));
	ОбластиГруппировок.Вставить("СчетДоверительногоУправления"			, Макет.ПолучитьОбласть("СчетДоверительногоУправления" + ИмяДополнительнойОбласти));
	
	МассивСтрокЗапроса = СтрРазделить(Запрос.Текст, Символы.ПС);

	Для Каждого Группировка Из ГруппировкиОтчета Цикл
		Если Группировка.Пометка Тогда
			МассивСтрокЗапроса.Вставить(МассивСтрокЗапроса.Количество() - 2, Группировка.Значение + ",");
		ИначеЕсли Группировка.Значение = "Управляющий" Тогда
			МассивСтрокЗапроса.Вставить(МассивСтрокЗапроса.Найти("ИТОГИ") + 1, 
				"ВЫБОР
				|		КОГДА НЕ Стратегия ЕСТЬ NULL
				|			ТОГДА МАКСИМУМ(Управляющий)
				|	КОНЕЦ КАК Управляющий,");
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(МассивСтрокЗапроса,  Символы.ПС);
	
	ДокументРезультат.Очистить();
	
	ПараметрыШапки = Новый Структура;
	ПараметрыШапки.Вставить("ДатаНачальная"			, Формат(НачалоГода(ЭтотОбъект.Период), "ДФ=dd.MM.yyyy"));
	ПараметрыШапки.Вставить("ДатаКонечная"			, Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"));
	ПараметрыШапки.Вставить("Организация"			, ЭтотОбъект.Организация);
	ПараметрыШапки.Вставить("ВидПлановойДоходности"	, ЭтотОбъект.ВидПлановойДоходности);
	ПараметрыШапки.Вставить("ДатаСравнения"			, Формат(ЭтотОбъект.ПериодДляСравнения, "ДФ=dd.MM.yyyy"));
	ПараметрыШапки.Вставить("Год"					, Формат(ЭтотОбъект.Период, "ДФ=yyyy"));
	
	Для Сч = 1 По 5 Цикл
		ПараметрыШапки.Вставить("ГодПлюс" + Сч, Формат(ДобавитьМесяц(ЭтотОбъект.Период, 12 * Сч), "ДФ=yyyy"));
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ПараметрыШапки);
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ВводыВыводы = Новый ТаблицаЗначений;
	
	Если ЭтотОбъект.ПечатьСРасшифровкой
		И Не ЭтотОбъект.ВариантОтчета = "ПрогнозируемаяДоходность"
		И Не ЭтотОбъект.УровеньРасшифровки = "Стратегия"
	Тогда
		Запрос.УстановитьПараметр("Расшифровка", ЭтотОбъект.ПечатьСРасшифровкой);
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ВводыВыводы = Запрос.МенеджерВременныхТаблиц.Таблицы["_ВводыВыводы"].ПолучитьДанные().Выгрузить();
		ВводыВыводы.Свернуть(ЭтотОбъект.УровеньРасшифровки + ",Дата,ДнейВУправлении,ВидПоказателя", "СуммаВводаВывода,ДляСреднего,СуммаПоказателя");
		ВводыВыводы.Сортировать("Дата");
		
	Иначе
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	КонтрольНДФЛ_В_СЧА(Запрос);
	
	Если ЭтотОбъект.СравнитьСПериодом ИЛИ ВариантОтчета = "РасчетДоходностиДУСокращенная" Тогда
		ДанныеДляСравнения = ПолучитьДанныеДляСравнения(Запрос);
		КонтрольНДФЛ_В_СЧА(Запрос);
	КонецЕсли;
	
	Отступ = 0;
	
	Пока Выборка.Следующий() Цикл
		ВывестиГруппировку(Выборка, ДокументРезультат, Макет, ВводыВыводы, ОбластиГруппировок, ДанныеДляСравнения, Отступ);
		
		Если ОбластьИтоги <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ОбластьИтоги.Параметры, Выборка);
			ВывестиСравнение(Выборка, ОбластьИтоги, ДанныеДляСравнения, "Итоги");
			ДокументРезультат.Вывести(ОбластьИтоги);
		КонецЕсли;
	КонецЦикла;
	
	ВывестиОписаниеИндексов(ДокументРезультат);
	ДокументРезультат.ФиксацияСверху = 1;
КонецПроцедуры

Процедура ВывестиОписаниеИндексов(ДокументРезультат)
	
	Если ЭтотОбъект.ВариантОтчета = "РасчетДоходностиДУ"
	 ИЛИ ЭтотОбъект.ВариантОтчета = "ДоходностьИндексов"
	 ИЛИ ЭтотОбъект.ВариантОтчета = "РасчетДоходностиДУСокращенная" Тогда
		ДокументРезультат.Вывести(ПолучитьМакет("ОписаниеИндексов"));
	КонецЕсли; 
	
КонецПроцедуры

Процедура ВывестиГруппировку(ВыборкаТекущийУровень, ДокументРезультат, Макет, ВводыВыводы, ОбластиГруппировок, ДанныеДляСравнения, Отступ)
	
	ИмяГруппировки = ВыборкаТекущийУровень.Группировка();
	
	Если НЕ ЗначениеЗаполнено(ИмяГруппировки) Тогда
		ИмяГруппировки = "СчетДоверительногоУправления";
	ИначеЕсли ИмяГруппировки = "Стратегия" И НЕ ЗначениеЗаполнено(ВыборкаТекущийУровень.Стратегия) Тогда
		ИмяГруппировки = "НеВыводить";
	КонецЕсли;
		
	Если ОбластиГруппировок.Свойство(ИмяГруппировки) Тогда
		ЗаполнитьЗначенияСвойств(ОбластиГруппировок[ИмяГруппировки].Параметры, ВыборкаТекущийУровень);
		ВывестиСравнение(ВыборкаТекущийУровень, ОбластиГруппировок[ИмяГруппировки], ДанныеДляСравнения, ИмяГруппировки);
		
		ДокументРезультат.Вывести(ОбластиГруппировок[ИмяГруппировки]);
		ДокументРезультат.НачатьГруппуСтрок();
		
		Отступ = Отступ + 2;
	КонецЕсли;
	
	ВыборкаСледующийУровень = ВыборкаТекущийУровень.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСледующийУровень.Следующий() Цикл
		ВывестиГруппировку(ВыборкаСледующийУровень, ДокументРезультат, Макет, ВводыВыводы, ОбластиГруппировок, ДанныеДляСравнения, Отступ);
	КонецЦикла;
	
	Если ОбластиГруппировок.Свойство(ИмяГруппировки) Тогда
		ВывестиРасшифровкуРасчетаДоходностиДУ(ДокументРезультат, ВыборкаТекущийУровень, Макет, ВводыВыводы, ИмяГруппировки);
		ВывестиРасшифровкуРасчетаДоходностиПоМетодикеПФР(ДокументРезультат, ВыборкаТекущийУровень, Макет, ИмяГруппировки);
		
		ДокументРезультат.ЗакончитьГруппуСтрок();
		Отступ = Отступ - 2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиРасшифровкуРасчетаДоходностиДУ(ДокументРезультат, Выборка, Макет, ВводыВыводы, ТекущаяГруппировка)
	
	Если НЕ ЭтотОбъект.ПечатьСРасшифровкой 
		ИЛИ ЭтотОбъект.УровеньРасшифровки <> ТекущаяГруппировка
		ИЛИ ЭтотОбъект.УровеньРасшифровки = "Стратегия"
		ИЛИ ЭтотОбъект.ВариантОтчета = "ПрогнозируемаяДоходность"
		ИЛИ ЭтотОбъект.ВариантОтчета = "ВознагражденияУК" Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьШапкаВводыВыводы		= Макет.ПолучитьОбласть("ШапкаВводыВыводы");
	ОбластьСтрокаВводыВыводы	= Макет.ПолучитьОбласть("СтрокаВводыВыводы");
	ОбластьИтогВводВывод		= Макет.ПолучитьОбласть("ИтогВводВывод");
	ОбластьДопПоказатели		= Макет.ПолучитьОбласть("ДопПоказатели");
	ОбластьРазрыв				= Макет.ПолучитьОбласть("Разрыв");
	
	ДокументРезультат.Вывести(ОбластьШапкаВводыВыводы);
	
	ПараметрыПоиска = Новый Структура(ЭтотОбъект.УровеньРасшифровки, Выборка[ЭтотОбъект.УровеньРасшифровки]);
	НайденныеСтроки = ВводыВыводы.НайтиСтроки(ПараметрыПоиска);
	
	ИтогиНайденныхСтрок = Новый Структура("СуммаВводаВывода,ДляСреднего,СуммаПоказателя", 0, 0, 0);
	
	Для Каждого СтрокаВводыВыводы Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(СтрокаВводыВыводы.СуммаВводаВывода)
			ИЛИ ЗначениеЗаполнено(СтрокаВводыВыводы.СуммаПоказателя) Тогда
		
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаВводыВыводы.Параметры, СтрокаВводыВыводы);
			ДокументРезультат.Вывести(ОбластьСтрокаВводыВыводы);
			
			ДобавитьВИтогиНайденныхСтрок(ИтогиНайденныхСтрок, СтрокаВводыВыводы);
		
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ОбластьИтогВводВывод.Параметры, ИтогиНайденныхСтрок);
	ДокументРезультат.Вывести(ОбластьИтогВводВывод);
	
	ДопПоказатели = Новый СписокЗначений;
	ДопПоказатели.Добавить(Формат(Выборка.ДатаНачалаУправления, "ДФ=dd.MM.yyyy"), "Дата первого СЧА в текущем году");
	ДопПоказатели.Добавить(Выборка.Дней, "Дней для расчета доходности");
	ДопПоказатели.Добавить(Выборка.СредняяСтоимостьИмущества, "Расчет среднего: ((" + Выборка.АктивыНаНачало + "-" + Выборка.ЗадолженностьНДФЛНаНачало + ")*" + Выборка.Дней + " + " + Выборка.ДляСреднего + ")/" + Выборка.ДнейВГоду + " = ");
	ДопПоказатели.Добавить(Выборка.ПереданоВДУ, "Передано в ДУ: " + Выборка.АктивыНаНачало + " - " + Выборка.ЗадолженностьНДФЛНаНачало + " + " + Выборка.ВводыВыводы + " = ");
	ДопПоказатели.Добавить(Формат(Выборка.Доходность, "ЧДЦ=2"), "Доходность: (" + Выборка.АктивыНаКонец + " - " + Выборка.ЗадолженностьНДФЛНаКонец + " - " + Выборка.ПереданоВДУ + ")/" + Выборка.СредняяСтоимостьИмущества + " * 100 = ");
	
	Для Каждого Показатель из ДопПоказатели Цикл
		ЗаполнитьЗначенияСвойств(ОбластьДопПоказатели.Параметры , Показатель);
		ДокументРезультат.Вывести(ОбластьДопПоказатели);
	КонецЦикла;
	
	ДокументРезультат.Вывести(ОбластьРазрыв);
	
КонецПроцедуры

Процедура ВывестиРасшифровкуРасчетаДоходностиПоМетодикеПФР(ДокументРезультат, Выборка, Макет, ТекущаяГруппировка)
	
	Если НЕ ЭтотОбъект.ПечатьСРасшифровкой 
		ИЛИ ЭтотОбъект.УровеньРасшифровки <> ТекущаяГруппировка
		ИЛИ ЭтотОбъект.ВариантОтчета <> "РасчетДоходностиДУ" Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьШапка  = Макет.ПолучитьОбласть("ШапкаДоходностьПоМетодикеПФР");
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаДоходностьПоМетодикеПФР");
	ОбластьИтоги  = Макет.ПолучитьОбласть("ИтогиДоходностьПоМетодикеПФР");
	ОбластьОшибка = Макет.ПолучитьОбласть("ОшибкаДоходностьПоМетодикеПФР");
	ОбластьРазрыв = Макет.ПолучитьОбласть("Разрыв");
	
	ПараметрыПоиска = Новый Структура("СубъектАналитики", Выборка[ЭтотОбъект.УровеньРасшифровки]);
	НайденныеСтроки = РасшифровкаДоходностиПоМетодикеПФР.НайтиСтроки(ПараметрыПоиска);
	
	Если ЭтотОбъект.УровеньРасшифровки = "Стратегия" Тогда
		Доходность = Выборка.ДоходностьСтратегииПоМетодикеПФР;
	ИначеЕсли ЭтотОбъект.УровеньРасшифровки = "ВидДоговораДоверительногоУправления" Тогда
		Доходность = Выборка.ДоходностьВидаДоговораПоМетодикеПФР;
	ИначеЕсли ЭтотОбъект.УровеньРасшифровки = "Клиент" Тогда
		Доходность = Выборка.ДоходностьКлиентаПоМетодикеПФР;
	Иначе
		Доходность = Выборка.ДоходностьСчетаДУПоМетодикеПФР;
	КонецЕсли;
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ОбластьШапка.Параметры.СубъектАналитики = Выборка[ЭтотОбъект.УровеньРасшифровки];
		ДокументРезультат.Вывести(ОбластьШапка);
		
		Для Каждого СтрокаРасшифровки Из НайденныеСтроки Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРасшифровки);
			ДокументРезультат.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		ОбластьИтоги.Параметры.Формула	 = "(" +Строка(Окр(СтрокаРасшифровки.ПриростИтог, 10)) + " - 1)*365/" + СтрокаРасшифровки.КоличествоДней + "*100 = ";	
		ОбластьИтоги.Параметры.Доходность = Доходность;
		
		ДокументРезультат.Вывести(ОбластьИтоги);
		
	Иначе
		
		ОбластьОшибка.Параметры.Доходность = Доходность;
		ДокументРезультат.Вывести(ОбластьОшибка);
		
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьРазрыв);
	ДокументРезультат.Вывести(ОбластьРазрыв);
	
КонецПроцедуры

Процедура ДобавитьВИтогиНайденныхСтрок(ИтогиНайденныхСтрок, СтрокаДанных)
	
	Для Каждого Итог Из ИтогиНайденныхСтрок Цикл
		Если ТипЗнч(СтрокаДанных[Итог.Ключ]) = Тип("Число") Тогда
			ИтогиНайденныхСтрок.Вставить(Итог.Ключ, Итог.Значение + СтрокаДанных[Итог.Ключ]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСравнение(Выборка, Область, ДанныеДляСравнения, ТекущаяГруппировка)
	
	Если НЕ ЭтотОбъект.СравнитьСПериодом И НЕ ВариантОтчета = "РасчетДоходностиДУСокращенная" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ВидДоговораДоверительногоУправления,Клиент,Стратегия,СчетДоверительногоУправления", 
	                                    Выборка.ВидДоговораДоверительногоУправления,
										Выборка.Клиент,
										Выборка.Стратегия, 
										Выборка.СчетДоверительногоУправления);
									
	НайденныеСтроки = ДанныеДляСравнения.НайтиСтроки(ПараметрыПоиска);
		
	ПараметрыРасчета = Новый Структура("СредняяСтоимостьИмущества,Доход,СуммаПоказателей, Доходность, ЭффективнаяДоходность, ВидДоговораДоверительногоУправления", 0, 0, 0, 0, 0);

	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ПараметрыРасчета.СредняяСтоимостьИмущества						= ПараметрыРасчета.СредняяСтоимостьИмущества	+ СтрокаДанных.СредняяСтоимостьИмущества;
		ПараметрыРасчета.Доход											= ПараметрыРасчета.Доход						+ СтрокаДанных.Доход;
		ПараметрыРасчета.СуммаПоказателей								= ПараметрыРасчета.СуммаПоказателей				+ СтрокаДанных.СуммаПоказателей;
		ПараметрыРасчета.ВидДоговораДоверительногоУправления			= СтрокаДанных.ВидДоговораДоверительногоУправления;
	КонецЦикла;
	
	Если ПараметрыРасчета.СредняяСтоимостьИмущества <> 0 Тогда
		ПараметрыРасчета.Доходность = ПараметрыРасчета.Доход * 100 / ПараметрыРасчета.СредняяСтоимостьИмущества;
		
		Если ПараметрыРасчета.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			ПараметрыРасчета.ЭффективнаяДоходность	= ПараметрыРасчета.Доход * 100 / ПараметрыРасчета.СредняяСтоимостьИмущества;
		Иначе
			ПараметрыРасчета.ЭффективнаяДоходность	= (ПараметрыРасчета.Доход + ПараметрыРасчета.СуммаПоказателей) * 100 / ПараметрыРасчета.СредняяСтоимостьИмущества;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыМакета = Новый Структура("ДоходностьПрошлое,ДоходностьРазница,ЭффективнаяДоходностьПрошлое,ЭффективнаяДоходностьРазница");
	ПараметрыМакета.ДоходностьПрошлое				= ПараметрыРасчета.Доходность;
	ПараметрыМакета.ДоходностьРазница				= Окр(Выборка.Доходность, 2) - Окр(ПараметрыРасчета.Доходность, 2);
	ПараметрыМакета.ЭффективнаяДоходностьПрошлое	= ПараметрыРасчета.ЭффективнаяДоходность;
	ПараметрыМакета.ЭффективнаяДоходностьРазница	= Окр(Выборка.ЭффективнаяДоходность, 2) - Окр(ПараметрыРасчета.ЭффективнаяДоходность, 2);
	
	ЗаполнитьЗначенияСвойств(Область.Параметры, ПараметрыМакета);
	
КонецПроцедуры

Функция ПолучитьДанныеДляСравнения(Запрос)
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос,, 
		"_ТаблицаДоходностей,_ВознагражденияУКБух,_ТаблицаДоходностиПоМетодикеПФР,_ТаблицаСЧАБезПослаблений,_КодыСчетовУБрокера,_НастройкиПлановогоВознаграждения,_НастройкиВознагражденияСГарантированнымДоходом");
	
	Запрос.УстановитьПараметр("ДатаНачала"			, НачалоГода(ЭтотОбъект.ПериодДляСравнения));
	Запрос.УстановитьПараметр("ДатаОкончания"		, КонецДня(ЭтотОбъект.ПериодДляСравнения));
	Запрос.УстановитьПараметр("Расшифровка"			, Ложь);
	
	ПараметрыРасчетаЗадолженностиПоНДФЛ = Новый Структура;
	ПараметрыРасчетаЗадолженностиПоНДФЛ.Вставить("ВидВалюты",					 ЭтотОбъект.ВидВалюты);
	ПараметрыРасчетаЗадолженностиПоНДФЛ.Вставить("УчитыватьНДФЛПоНачислению",	 Истина);
	
	Если ЭтотОбъект.ОтборПоДоговорам Тогда
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, Новый СтандартныйПериод(НачалоГода(ЭтотОбъект.ПериодДляСравнения), КонецДня(ЭтотОбъект.ПериодДляСравнения)), "СчетаДоверительногоУправления", Запрос.Параметры.СписокДоговоров, ПараметрыРасчетаЗадолженностиПоНДФЛ);
	Иначе
		Документы.РегистрацияСтоимостиАктивов.ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, Новый СтандартныйПериод(НачалоГода(ЭтотОбъект.ПериодДляСравнения), КонецДня(ЭтотОбъект.ПериодДляСравнения)), "ВидыДоговоровДоверительногоУправления", Запрос.Параметры.ВидыДоговоров, ПараметрыРасчетаЗадолженностиПоНДФЛ);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьДоходностьИндексов(ДокументРезультат, Запрос, ТаблицаДоходностей)
	
	Запрос.УстановитьПараметр("НастройкиБиржевыхИндексов", ЭтотОбъект.НастройкиБиржевыхИндексов);
	Запрос.УстановитьПараметр("ДатаНачальная"			, НачалоГода(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ДатаКонечная"			, КонецДня(ЭтотОбъект.Период));
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(НастройкиБиржевыхИндексов.БиржевойИндекс КАК Справочник.БиржевыеИндексы) КАК БиржевойИндекс,
		|	НастройкиБиржевыхИндексов.Среднеарифметическое КАК Среднеарифметическое,
		|	ВЫРАЗИТЬ(НастройкиБиржевыхИндексов.ВалютаКонвертации КАК Справочник.Валюты) КАК ВалютаКонвертации,
		|	ВЫРАЗИТЬ(НастройкиБиржевыхИндексов.КоличествоЗначений КАК ЧИСЛО(10, 2)) КАК КоличествоЗначений
		|ПОМЕСТИТЬ ВТ_БиржевыеИндексы
		|ИЗ
		|	&НастройкиБиржевыхИндексов КАК НастройкиБиржевыхИндексов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БиржевойИндекс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.БиржевойИндекс КАК БиржевойИндекс,
		|	ВложенныйЗапрос.Среднеарифметическое КАК Среднеарифметическое,
		|	ВложенныйЗапрос.КоличествоЗначений КАК КоличествоЗначений,
		|	ВложенныйЗапрос.ВалютаКонвертации КАК ВалютаКонвертации,
		|	СУММА(ВложенныйЗапрос.CLOSE) / ВложенныйЗапрос.КоличествоЗначений КАК CLOSE,
		|	МАКСИМУМ(ВложенныйЗапрос.ДатаИндекса) КАК ДатаИндекса,
		|	ВложенныйЗапрос.НаДату КАК НаДату
		|ПОМЕСТИТЬ ВТ_ЗначенияБиржевыхИндексов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_БиржевыеИндексы.БиржевойИндекс КАК БиржевойИндекс,
		|		ВТ_БиржевыеИндексы.Среднеарифметическое КАК Среднеарифметическое,
		|		ВТ_БиржевыеИндексы.КоличествоЗначений КАК КоличествоЗначений,
		|		ВТ_БиржевыеИндексы.ВалютаКонвертации КАК ВалютаКонвертации,
		|		ЗначенияБиржевыхИндексов.CLOSE * ЕСТЬNULL(КурсыВалютыИндекса.Курс, 1) * ЕСТЬNULL(КурсыВалютыКонвертации.Кратность, 1) / ЕСТЬNULL(КурсыВалютыИндекса.Кратность, 1) / ЕСТЬNULL(КурсыВалютыКонвертации.Курс, 1) КАК CLOSE,
		|		ЗначенияБиржевыхИндексов.Период КАК ДатаИндекса,
		|		&ДатаНачальная КАК НаДату
		|	ИЗ
		|		ВТ_БиржевыеИндексы КАК ВТ_БиржевыеИндексы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|			ПО (ВТ_БиржевыеИндексы.Среднеарифметическое)
		|				И (ВТ_БиржевыеИндексы.БиржевойИндекс <> ЗНАЧЕНИЕ(Справочник.БиржевыеИндексы.))
		|				И (ВТ_БиржевыеИндексы.КоличествоЗначений <> 0)
		|				И (ВТ_БиржевыеИндексы.БиржевойИндекс.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыБиржевыхИндексов.Доходность))
		|				И ВТ_БиржевыеИндексы.БиржевойИндекс = ЗначенияБиржевыхИндексов.БиржевойИндекс
		|				И (ЗначенияБиржевыхИндексов.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачальная, МЕСЯЦ, -3) И &ДатаНачальная)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов1
		|			ПО (ЗначенияБиржевыхИндексов.БиржевойИндекс = ЗначенияБиржевыхИндексов1.БиржевойИндекс)
		|				И (ЗначенияБиржевыхИндексов1.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачальная, МЕСЯЦ, -3) И &ДатаНачальная)
		|				И (ЗначенияБиржевыхИндексов.Период <= ЗначенияБиржевыхИндексов1.Период)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыИндекса
		|			ПО (ВТ_БиржевыеИндексы.ВалютаКонвертации <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|				И (ЗначенияБиржевыхИндексов.Период = КурсыВалютыИндекса.Период)
		|				И (ЗначенияБиржевыхИндексов.Валюта = КурсыВалютыИндекса.Валюта)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыКонвертации
		|			ПО (ВТ_БиржевыеИндексы.ВалютаКонвертации <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|				И (ЗначенияБиржевыхИндексов.Период = КурсыВалютыКонвертации.Период)
		|				И ВТ_БиржевыеИндексы.ВалютаКонвертации = КурсыВалютыКонвертации.Валюта
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_БиржевыеИндексы.БиржевойИндекс,
		|		ВТ_БиржевыеИндексы.Среднеарифметическое,
		|		ВТ_БиржевыеИндексы.КоличествоЗначений,
		|		ЗначенияБиржевыхИндексов.CLOSE * ЕСТЬNULL(КурсыВалютыИндекса.Курс, 1) * ЕСТЬNULL(КурсыВалютыКонвертации.Кратность, 1) / ЕСТЬNULL(КурсыВалютыИндекса.Кратность, 1) / ЕСТЬNULL(КурсыВалютыКонвертации.Курс, 1),
		|		ЗначенияБиржевыхИндексов.Период,
		|		ВТ_БиржевыеИндексы.ВалютаКонвертации
		|	
		|	ИМЕЮЩИЕ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗначенияБиржевыхИндексов1.Период) <= ВТ_БиржевыеИндексы.КоличествоЗначений
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТ_БиржевыеИндексы.БиржевойИндекс,
		|		ВТ_БиржевыеИндексы.Среднеарифметическое,
		|		ВТ_БиржевыеИндексы.КоличествоЗначений,
		|		ВТ_БиржевыеИндексы.ВалютаКонвертации,
		|		ЗначенияБиржевыхИндексов.CLOSE * ЕСТЬNULL(КурсыВалютыИндекса.Курс, 1) * ЕСТЬNULL(КурсыВалютыКонвертации.Кратность, 1) / ЕСТЬNULL(КурсыВалютыИндекса.Кратность, 1) / ЕСТЬNULL(КурсыВалютыКонвертации.Курс, 1),
		|		ЗначенияБиржевыхИндексов.Период,
		|		&ДатаКонечная
		|	ИЗ
		|		ВТ_БиржевыеИндексы КАК ВТ_БиржевыеИндексы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|			ПО (ВТ_БиржевыеИндексы.Среднеарифметическое)
		|				И (ВТ_БиржевыеИндексы.БиржевойИндекс <> ЗНАЧЕНИЕ(Справочник.БиржевыеИндексы.))
		|				И (ВТ_БиржевыеИндексы.КоличествоЗначений <> 0)
		|				И (ВТ_БиржевыеИндексы.БиржевойИндекс.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипыБиржевыхИндексов.Доходность))
		|				И ВТ_БиржевыеИндексы.БиржевойИндекс = ЗначенияБиржевыхИндексов.БиржевойИндекс
		|				И (ЗначенияБиржевыхИндексов.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаКонечная, МЕСЯЦ, -3) И &ДатаКонечная)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов1
		|			ПО (ЗначенияБиржевыхИндексов.БиржевойИндекс = ЗначенияБиржевыхИндексов1.БиржевойИндекс)
		|				И (ЗначенияБиржевыхИндексов1.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаКонечная, МЕСЯЦ, -3) И &ДатаКонечная)
		|				И (ЗначенияБиржевыхИндексов.Период <= ЗначенияБиржевыхИндексов1.Период)
