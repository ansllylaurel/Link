
#Область Интерфейс

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Формирование отчетности",
		"2.54",
		"",
		Истина,
		"СкриншотФормы");
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоФормированиеОтчетов", "Автоматическое формирование клиентской отчетности",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверкаОтправкиПоЭДО", "Проверка отправки клиентской отчетности в ЭДО",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповещениеОРезультатахОбработкиОтчетов", "Оповещение о результатах обработки отчетов",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВыгрузкаОтчетностиВДО", "Выгрузка отчетности в ДО",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// Получаем параметры команды
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Организация					= ПараметрыКоманды.Организация;
	ЭтотОбъект.Дата							= НачалоДня(ТекущаяДатаСеанса());
	ЭтотОбъект.УчитыватьСрокФормирования	= Истина;
	ЭтотОбъект.АвтоматическийЗапуск			= Истина;
	
	// Выполняем только по рабочим дням
	Если НЕ Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ЭтотОбъект.Дата) Тогда
		Возврат;		
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоФормированиеОтчетов" Тогда
		ВыполнитьАвтоматическоеФормированиеОтчетов(ПараметрыКоманды, ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	ИначеЕсли ИдентификаторКоманды = "ПроверкаОтправкиПоЭДО" Тогда
		ПроверитьОтправкуПоЭДО(ПараметрыКоманды);
	ИначеЕсли ИдентификаторКоманды = "ОповещениеОРезультатахОбработкиОтчетов" Тогда
		ОповеститьОРезультатахОбработкиОтчетов(ПараметрыКоманды);
	ИначеЕсли ИдентификаторКоманды = "ВыгрузкаОтчетностиВДО" Тогда
		ВыгрузитьОтчетностьВДО(ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет обработку пакета отчетов
//
Процедура ОбработатьПакетОтчетов(ПараметрыВыполнения, АдресХранилища = Неопределено) Экспорт
	
	Если ПараметрыВыполнения.Свойство("АвтоматическийЗапуск")
		И ПараметрыВыполнения.АвтоматическийЗапуск Тогда
		ЭтотОбъект.АвтоматическийЗапуск	= Истина;
		ЭтотОбъект.Организация			= ПараметрыВыполнения.Организация;
	Иначе
		СостоянияОтчетовПередЗапуском = ПараметрыВыполнения.СостоянияОтчетовПередЗапуском;
	КонецЕсли;
	
	Договор				= ПараметрыВыполнения.Договор;
	НастройкиОтчетов	= ПараметрыВыполнения.Настройки;
	
	Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
		СостоянияОтчетовПередЗапускомПоИдентификаторамСтрок = Новый Соответствие;
	КонецЕсли;
	
	СостоянияОтчетов	= Новый Соответствие;
	ЭкземплярыОтчетов	= Новый Соответствие;
	НастройкиСтрок		= Новый Соответствие;
	
	#Область Блокировка_и_определение_статусов_отчетов_пакета
	
	Для Каждого Настройки Из НастройкиОтчетов Цикл
		
		// Начинаем транзакцию для блокировки справочника "Экземпляры отчетов"
		НачатьТранзакцию();
		
		#Область Блокировка_области_справочника
		
		Блокировка = Новый БлокировкаДанных;
	
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ЭкземплярыОтчетов");
		
		ЭлементБлокировки.УстановитьЗначение("Организация",		ЭтотОбъект.Организация);
		ЭлементБлокировки.УстановитьЗначение("Субъект",			Настройки.Субъект);
		ЭлементБлокировки.УстановитьЗначение("Отчет",			Настройки.Отчет);
		ЭлементБлокировки.УстановитьЗначение("Периодичность",	Настройки.Периодичность);
		ЭлементБлокировки.УстановитьЗначение("Дата",			Настройки.ОтчетнаяДата);
		
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		// Блокируем область справочника
		Попытка
			Блокировка.Заблокировать();
		Исключение
			
			ОтменитьТранзакцию();
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось установить блокировку отчета! Отчет не будет обработан.",
							ОписаниеОшибки(), 
							ЭтотОбъект.АвтоматическийЗапуск);
			
			Продолжить;
			
		КонецПопытки;
		
		#КонецОбласти
		
		ОтчетыКОбработке = ПолучитьПустуюТаблицуОтчетов();
		
	 	#Область Получение_актуального_состояния_отчета
		
		// Получаем актуальное состояние отчета и запоминаем настройки
		ОтчетКОбработке = ОтчетыКОбработке.Добавить();
		
		ЗаполнитьЗначенияСвойств(ОтчетКОбработке, Настройки);
		Если Настройки.Свойство("ВыбраннаяФорма1ФС") Тогда 
			 ОтчетКОбработке.ВыбраннаяФорма = Настройки.ВыбраннаяФорма1ФС;
		КонецЕсли;	 
		
		ОтчетКОбработке.Дата				= Настройки.ОтчетнаяДата;
		ОтчетКОбработке.ДатаНачала			= Настройки.Период.ДатаНачала;
		ОтчетКОбработке.ДатаОкончания		= Настройки.Период.ДатаОкончания;
		ОтчетКОбработке.ИдентификаторСтроки	= Строка(Новый УникальныйИдентификатор);
		
		АктуальноеСостояние = РаботаСОтчетами.ПолучитьСостоянияОтчетов(ЭтотОбъект.Организация, ОтчетыКОбработке)[0];
		
		#КонецОбласти
		
		#Область Проверка_запрета_обработки
		
		Если АктуальноеСостояние.ЗапретОбработки Тогда
			
			ОтменитьТранзакцию();
			
			Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Установлен запрет обработки отчета! Отчет не будет обработан.");
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		#КонецОбласти
		
		#Область Проверка_актуальности_состояния_отчета
		
		// Для ручного запуска проверяем, что состояние отчета не изменилось с момента запуска
		// и устанавливаем действия с отчетом, которые указал пользователь
		Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("Субъект", 		ОтчетКОбработке.Субъект);
			Отбор.Вставить("Отчет",			ОтчетКОбработке.Отчет);
			Отбор.Вставить("Периодичность", ОтчетКОбработке.Периодичность);
			Отбор.Вставить("Дата",			ОтчетКОбработке.Дата);
			
			СостояниеПередЗапуском = СостоянияОтчетовПередЗапуском.НайтиСтроки(Отбор)[0];
			
			Если ЗначениеЗаполнено(АктуальноеСостояние.Экземпляр) <> ЗначениеЗаполнено(СостояниеПередЗапуском.Экземпляр)
				ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Экземпляр)
					И (АктуальноеСостояние.Экземпляр <> СостояниеПередЗапуском.Экземпляр
						ИЛИ АктуальноеСостояние.ВерсияДанных <> СостояниеПередЗапуском.ВерсияДанных)
				ИЛИ АктуальноеСостояние.СтатусВыгрузки <> СостояниеПередЗапуском.СтатусВыгрузки
				ИЛИ АктуальноеСостояние.СтатусОтправки <> СостояниеПередЗапуском.СтатусОтправки
				ИЛИ АктуальноеСостояние.Регламентированный
					И (ЗначениеЗаполнено(АктуальноеСостояние.РегламентированныйОтчет) <> ЗначениеЗаполнено(СостояниеПередЗапуском.РегламентированныйОтчет)
						ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.РегламентированныйОтчет)
							И (АктуальноеСостояние.РегламентированныйОтчет <> СостояниеПередЗапуском.РегламентированныйОтчет
								ИЛИ АктуальноеСостояние.СтатусРегламентированногоОтчета <> СостояниеПередЗапуском.СтатусРегламентированногоОтчета)) Тогда
				
				ОтменитьТранзакцию();
				
				ОбработатьОшибку(СостояниеПередЗапуском.ГруппаОтчетов,
								СостояниеПередЗапуском.Отчет,
								СостояниеПередЗапуском.Периодичность,
								СостояниеПередЗапуском.Субъект,
								СостояниеПередЗапуском.Дата,
								"Данные по отчету в таблице стали неактуальными! Отчет не будет обработан.");
				
				Продолжить;
				
			Иначе
				АктуальноеСостояние.Сформировать	= СостояниеПередЗапуском.Сформировать;
				АктуальноеСостояние.Выгрузить		= СостояниеПередЗапуском.Выгрузить;
				АктуальноеСостояние.Отправить		= СостояниеПередЗапуском.Отправить;
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
		// Если с отчетом не нужно ничего делать, пропускаем
		Если НЕ АктуальноеСостояние.Сформировать
			И НЕ АктуальноеСостояние.Выгрузить
			И НЕ АктуальноеСостояние.Отправить Тогда
			
			ОтменитьТранзакцию();
			
			Продолжить;
			
		КонецЕсли;
		
		#Область Проверка_экземпляра_отчета_и_его_создание
		
		// Создаем экземпляр отчета, если его нет
		Если НЕ ЗначениеЗаполнено(АктуальноеСостояние.Экземпляр) Тогда
			
			Попытка
				АктуальноеСостояние.Экземпляр = РаботаСОтчетами.СоздатьЭкземплярОтчета(ЭтотОбъект.Организация, Настройки.Субъект, Настройки.Отчет, Настройки.Периодичность, Настройки.ОтчетнаяДата);
			Исключение
				
				ОтменитьТранзакцию();
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не удалось создать экземпляр отчета! Отчет не будет обработан.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
				
				Продолжить;
				
			КонецПопытки;
			
		КонецЕсли;
		
		#КонецОбласти
		
		#Область Блокировка_экземпляра_отчета
		
		// Экземпляр блокируем на все время обработки всех отчетов по субъекту
		// всегда, даже если уже есть актуальная окончательная версия
		// делаем это для избежания повторной отправки / выгрузки
		ОбъектЭкземпляра = АктуальноеСостояние.Экземпляр.ПолучитьОбъект();
		
		Попытка
			ОбъектЭкземпляра.Заблокировать();
		Исключение
			
			ОтменитьТранзакцию();
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось заблокировать экземпляр отчета! Отчет не будет обработан.",
							ОписаниеОшибки(),
							ЭтотОбъект.АвтоматическийЗапуск);
			
			Продолжить;
			
		КонецПопытки;
		
		#КонецОбласти
		
		ЗафиксироватьТранзакцию();
		
		// Запоминаем данные отчета для последующей обработки
		СостоянияОтчетов.Вставить(АктуальноеСостояние.ИдентификаторСтроки, АктуальноеСостояние);
		ЭкземплярыОтчетов.Вставить(АктуальноеСостояние.ИдентификаторСтроки, ОбъектЭкземпляра);
		НастройкиСтрок.Вставить(АктуальноеСостояние.ИдентификаторСтроки, Настройки);
		
	КонецЦикла;
	
	#КонецОбласти
	
	// К этому моменту у нас есть заблокированные объекты экземпляров отчетов, которые нужно обработать
	
	#Область Обработка_отчетов_пакета
	
	// Т.к. в процессе формирования отчета может произойти ошибка, нужна возможность отметки, что отчет не нужно обрабатывать
	// а удалять элемент коллекции в цикле, который обходит эту коллекцию - криво, запомним идентификаторы
	// а после цикла удалим ненужные отчеты
	НеобрабатываемыеОтчеты = Новый Массив;
	
	Для Каждого Отчет Из СостоянияОтчетов Цикл
		
		СостояниеОтчета = Отчет.Значение;
		
		// Получаем данные для обработки отчета
		ОбъектЭкземпляра	= ЭкземплярыОтчетов.Получить(Отчет.Ключ);
		Настройки			= НастройкиСтрок.Получить(Отчет.Ключ);
		
		#Область Формирование_отчета
		
		Если СостояниеОтчета.Сформировать Тогда
			
			Если НЕ УчетЕПСГотов(Настройки) Тогда
				
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
				
				Продолжить;
				
			КонецЕсли;
			
			#Область Проверка_наличия_и_готовности_регламентированного_отчета
			
			Если СостояниеОтчета.Регламентированный Тогда
				
				Если НЕ ЗначениеЗаполнено(СостояниеОтчета.РегламентированныйОтчет) Тогда
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
									Настройки.Отчет,
									Настройки.Периодичность,
									Настройки.Субъект,
									Настройки.ОтчетнаяДата,
									"Отсутствует сохраненный регламентированный отчет, необходимо создать черновик! Отчет не будет обработан.");
					
					РазблокироватьЭкземпляр(ОбъектЭкземпляра);
					
					НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
					
					Продолжить;
					
				ИначеЕсли СостояниеОтчета.СтатусРегламентированногоОтчета <> "Готов"
					И СостояниеОтчета.СтатусРегламентированногоОтчета <> "Отправлен"
					И СостояниеОтчета.СтатусРегламентированногоОтчета <> "Корректировка" Тогда
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
									Настройки.Отчет,
									Настройки.Периодичность,
									Настройки.Субъект,
									Настройки.ОтчетнаяДата,
									"Сохраненный регламентированный отчет не имеет статуса 'Готов', 'Отправлен' или 'Корректировка'. Отчет не будет обработан.");
					
					РазблокироватьЭкземпляр(ОбъектЭкземпляра);
					
					НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
					
					Продолжить;
					
				КонецЕсли;
				
				// Добавляем в структуру настроек необходимые для формирования регламентированного отчета параметры
				Настройки.Вставить("РегламентированныйОтчет", СостояниеОтчета.РегламентированныйОтчет);
				
			КонецЕсли;
			
			#КонецОбласти
		
			ЗафкисироватьСозданиеНовойВерсии		= Ложь;
			ЗафиксироватьУстановкуОкончательности	= Ложь;
			
			#Область Автоматическое_формирование_отчета
			
			Попытка
				Справочники.Отчеты.ВыполнитьАвтоматическоеФормирование(Настройки.КлючОтчета, Настройки);
			Исключение
				
				ТекстСообщений = "";
				СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
				Для Каждого ТекСообщение Из СообщенияПользователю Цикл				
					ТекстСообщений = ТекстСообщений + Символы.ПС + ТекСообщение.Текст;
				КонецЦикла;                                           				
			
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не удалось сформировать отчет!",
								ОписаниеОшибки() + ТекстСообщений,
								ЭтотОбъект.АвтоматическийЗапуск);
								
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
				
				Продолжить;
				
			КонецПопытки;
			
			#КонецОбласти
			
			#Область Обработка_результата_формирования
					
			ТекстСообщений = "";
			СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
			Для Каждого ТекСообщение Из СообщенияПользователю Цикл				
				ТекстСообщений = ТекстСообщений + Символы.ПС + ТекСообщение.Текст;
			КонецЦикла;                                           				
			
			// Если в отчете сработали блокирующие проверки и он не сформировался,
			// в настройки помещено свойство Отказ
			Если Настройки.Свойство("Отказ") Тогда
				ИмяОповещенияОбОтказе = Неопределено;
				Настройки.Свойство("ИмяОповещенияОбОтказе", ИмяОповещенияОбОтказе);
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Ошибки формирования отчета. Отчет не будет обработан",
								ТекстСообщений,
								Ложь,
								ИмяОповещенияОбОтказе);
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);				
				Продолжить;
			КонецЕсли;
			
			Если НЕ Настройки.Свойство("Результат") Тогда         				
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Отчет не вернул результат формирования! Отчет не будет обработан.",
								"Отчет не добавил в структуру с результатом формирования элемент 'Результат':" + ТекстСообщений,
								ЭтотОбъект.АвтоматическийЗапуск);
				
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
				
				Продолжить;
				
			КонецЕсли;
			
			Попытка
				ДанныеРезультатаОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьДанныеРезультатаОтчета(Настройки.Результат, Настройки.Расширение);
			Исключение
				
				ТекстСообщений = "";
				СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
				Для Каждого ТекСообщение Из СообщенияПользователю Цикл				
					ТекстСообщений = ТекстСообщений + Символы.ПС + ТекСообщение.Текст;
				КонецЦикла; 
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не удалось обработать результат формирования отчета! Отчет не будет обработан.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
				
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
				
				Продолжить;
				
			КонецПопытки;
			
			#КонецОбласти
			
			Адрес = ПоместитьВоВременноеХранилище(ДанныеРезультатаОтчета.ДвоичныеДанные);
			
			РазмерФайла = ДанныеРезультатаОтчета.ДвоичныеДанные.Размер()/1048576;
			
			#Область Определение_действий_с_файлом_отчета
			
			ЕстьСохраненныеДанныеЭкземпляраОтчета = РегистрыСведений.ВременноеХранилищеОтчетов.ЕстьСохраненныеДанныеЭкземпляраОтчета(ОбъектЭкземпляра.Ссылка);
			
			// Если файл еще не сохранили в хранилище
			Если Не ЗначениеЗаполнено(ОбъектЭкземпляра.ИдентификаторФайла) И Не ЕстьСохраненныеДанныеЭкземпляраОтчета Тогда
				
				#Область Создание_нового_файла
				
				// Создаем файл в хранилище
				ПараметрыФайла = Новый Структура;
				
				ПараметрыФайла.Вставить("Адрес",					Адрес);
				ПараметрыФайла.Вставить("Имя",						Настройки.ИмяБезРасширения);
				ПараметрыФайла.Вставить("Расширение",				Настройки.Расширение);
				ПараметрыФайла.Вставить("Экземпляр",				ОбъектЭкземпляра.Ссылка);
				ПараметрыФайла.Вставить("НаименованиеВладельца",	Строка(Настройки.Субъект));
				ПараметрыФайла.Вставить("ИдентификаторВладельца",	Строка(Настройки.Субъект.УникальныйИдентификатор()));
				ПараметрыФайла.Вставить("ТипВладельца",				"Клиентские отчеты");
				
				Попытка
					ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, ЭтотОбъект.Организация, Истина);
				Исключение
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не удалось сохранить результат формирования отчета в файловом хранилище! Отчет не будет обработан.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
					
					РазблокироватьЭкземпляр(ОбъектЭкземпляра);
					
					НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
					
					Продолжить;
					
				КонецПопытки;
				
				ОбъектЭкземпляра.ИдентификаторФайла = ДанныеВерсии.ИдентификаторФайла;
				
				НоваяВерсия = ОбъектЭкземпляра.ВерсииОтчетов.Добавить();
				
				НоваяВерсия.ИдентификаторВерсии	= ДанныеВерсии.ИдентификаторВерсии;
				НоваяВерсия.КонтрольнаяСумма	= ДанныеРезультатаОтчета.КонтрольнаяСумма;
				НоваяВерсия.ИмяПриСохранении	= Настройки.ИмяБезРасширения + "." + Настройки.Расширение;
				НоваяВерсия.Окончательная		= Истина;
				НоваяВерсия.Актуальная			= Истина;
				НоваяВерсия.Размер				= РазмерФайла;
				
				СостояниеОтчета.ИдентификаторВерсии = ДанныеВерсии.ИдентификаторВерсии;
				
				ЗафкисироватьСозданиеНовойВерсии		= Истина;
				ЗафиксироватьУстановкуОкончательности	= Истина;
				
				#КонецОбласти
				
			ИначеЕсли СостояниеОтчета.КонтрольнаяСумма <> ДанныеРезультатаОтчета.КонтрольнаяСумма Тогда
				
				#Область Добавление_новой_версии_файла
				
				// Добавляем новую версию файла
				Попытка
					СостояниеОтчета.ИдентификаторВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(ОбъектЭкземпляра.ИдентификаторФайла, Адрес, Настройки.Расширение, Истина, ОбъектЭкземпляра.Ссылка, Настройки.ИмяБезРасширения);
				Исключение
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
									Настройки.Отчет,
									Настройки.Периодичность,
									Настройки.Субъект,
									Настройки.ОтчетнаяДата,
									"Не удалось сохранить результат формирования отчета в файловом хранилище! Отчет не будет обработан.",
									ОписаниеОшибки(),
									ЭтотОбъект.АвтоматическийЗапуск);
					
					РазблокироватьЭкземпляр(ОбъектЭкземпляра);
					
					НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
					
					Продолжить;
					
				КонецПопытки;
				
				Версия = ОбъектЭкземпляра.ВерсииОтчетов.НайтиСтроки(Новый Структура("Актуальная", Истина))[0];
				
				Версия.Актуальная = Ложь;
				
				НоваяВерсия = ОбъектЭкземпляра.ВерсииОтчетов.Добавить();
				
				НоваяВерсия.ИдентификаторВерсии	= СостояниеОтчета.ИдентификаторВерсии;
				НоваяВерсия.КонтрольнаяСумма	= ДанныеРезультатаОтчета.КонтрольнаяСумма;
				НоваяВерсия.ИмяПриСохранении	= Настройки.ИмяБезРасширения + "." + Настройки.Расширение;
				НоваяВерсия.Окончательная		= Истина;
				НоваяВерсия.Актуальная			= Истина;
				НоваяВерсия.Размер				= РазмерФайла;
				
				ЗафкисироватьСозданиеНовойВерсии		= Истина;
				ЗафиксироватьУстановкуОкончательности	= Истина;
				
				#КонецОбласти
				
			Иначе
				
				#Область Установка_окончательности_предыдущей_версии_файла
				
				Если НЕ СостояниеОтчета.Окончательная Тогда
					
					Версия = ОбъектЭкземпляра.ВерсииОтчетов.НайтиСтроки(Новый Структура("ИдентификаторВерсии", СостояниеОтчета.ИдентификаторВерсии))[0];
					
					Версия.Окончательная = Истина;
					
					ЗафиксироватьУстановкуОкончательности = Истина;
					
				КонецЕсли;
				
				#КонецОбласти
				
			КонецЕсли;
			
			УдалитьИзВременногоХранилища(Адрес);
			
			#КонецОбласти
			
			#Область Сохранение_экземпляра_отчета
			
			Попытка
				ОбъектЭкземпляра.Записать();
			Исключение
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не удалось зафиксировать сохранение результата формирования отчета в файловом хранилище! Отчет не будет обработан.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
				
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				НеобрабатываемыеОтчеты.Добавить(Отчет.Ключ);
				
				Продолжить;
				
			КонецПопытки;
			
			#КонецОбласти
			
			#Область Фиксация_изменений_в_версиях_отчета
			
			Если ЗафкисироватьСозданиеНовойВерсии Тогда
				РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.СозданиеВерсии, СостояниеОтчета.Экземпляр, СостояниеОтчета.ИдентификаторВерсии);
			КонецЕсли;
			
			Если ЗафиксироватьУстановкуОкончательности Тогда
				РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.УстановкаОкончательности, СостояниеОтчета.Экземпляр, СостояниеОтчета.ИдентификаторВерсии);
			КонецЕсли;
			
			#КонецОбласти
			
			Если Настройки.Свойство("НеОбрабатыватьПакет") Тогда
				СостояниеОтчета.КомментарийКОтменеОбработки = "Обработка пустого отчета отключена";
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЦикла;
	
	// Удаляем проблемные отчеты
	Для Каждого Ключ Из НеобрабатываемыеОтчеты Цикл
		СостоянияОтчетов.Удалить(Ключ);
		ЭкземплярыОтчетов.Удалить(Ключ);
		НастройкиСтрок.Удалить(Ключ);
	КонецЦикла;
	
	#КонецОбласти
	
	#Область Обработка_результатов_отчетов
	
	// Временный блок, реализованный по просьбе бухгалтерии:
	// хотят до конца 2022 года, чтобы отчеты сохранялись в привычный каталог
	ФайлыКСохранению = Новый Массив;
	/////////////////////////////////////////////////////////////////////////
	
	#Область Формирование_выгрузки
	
	// Для выгрузки ключ - путь к файлу (каталог)
	ДанныеПакетовВыгрузок = Новый ТаблицаЗначений;
	
	ДанныеПакетовВыгрузок.Колонки.Добавить("Пакет", Новый ОписаниеТипов("Булево"));
	ДанныеПакетовВыгрузок.Колонки.Добавить("Каталог", Новый ОписаниеТипов("Строка"));
	ДанныеПакетовВыгрузок.Колонки.Добавить("ОграничениеРазмера", Новый ОписаниеТипов("Число"));
	ДанныеПакетовВыгрузок.Колонки.Добавить("Файлы",	Новый ОписаниеТипов("Массив"));
	ДанныеПакетовВыгрузок.Колонки.Добавить("КомментарийКОтменеОбработки", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Отчет Из СостоянияОтчетов Цикл
		
		Состояние	= Отчет.Значение;
		Настройки	= НастройкиСтрок.Получить(Отчет.Ключ);
		
		// Формируем пакет для выгрузки в ЭДО
		Если Состояние.Выгрузить Тогда
			
			#Область Определение_пакета
			
			Если Настройки.Свойство("ВыгружатьОтчетВСоставеПакета")
				И Настройки.ВыгружатьОтчетВСоставеПакета = Истина Тогда
				
				// Выгружаем пакетом
				Отбор = Новый Структура;
				
				Отбор.Вставить("Пакет",		Истина);
				Отбор.Вставить("Каталог",	Настройки.КаталогФайловДляОтправкиПоЭДО);
				
				НайденныеСтроки = ДанныеПакетовВыгрузок.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					Пакет = НайденныеСтроки[0];
				Иначе
					
					Пакет = ДанныеПакетовВыгрузок.Добавить();
					
					Пакет.Пакет = Истина;
					
				КонецЕсли;
				
			Иначе
				
				Пакет = ДанныеПакетовВыгрузок.Добавить();
					
				Пакет.Пакет = Ложь;
				
			КонецЕсли;
			
			#КонецОбласти
			
			#Область Добавление_в_пакет
			
			Если Настройки.Свойство("КаталогФайловДляОтправкиПоЭДО")
				И НЕ ЗначениеЗаполнено(Пакет.Каталог) Тогда
				Пакет.Каталог = Настройки.КаталогФайловДляОтправкиПоЭДО;
			КонецЕсли;
			
			Если Настройки.Свойство("МаксимальныйРазмерФайлаДляВыгрузкиВЭДО") И ЗначениеЗаполнено(Настройки.МаксимальныйРазмерФайлаДляВыгрузкиВЭДО)
				И (Пакет.ОграничениеРазмера = 0 ИЛИ Пакет.ОграничениеРазмера > Настройки.МаксимальныйРазмерФайлаДляВыгрузкиВЭДО) Тогда
				Пакет.ОграничениеРазмера = Настройки.МаксимальныйРазмерФайлаДляВыгрузкиВЭДО;
			КонецЕсли;
			
			// Выгружаем индивидуально
			ДанныеОтчета = Новый Структура;
			
			ДанныеОтчета.Вставить("Экземпляр",				Состояние.Экземпляр);
			ДанныеОтчета.Вставить("ИдентификаторВерсии",	Состояние.ИдентификаторВерсии);
			ДанныеОтчета.Вставить("Имя",					Настройки.ИмяБезРасширения);
			ДанныеОтчета.Вставить("Расширение",				Настройки.Расширение);
			ДанныеОтчета.Вставить("Субъект",				Настройки.Субъект);
			ДанныеОтчета.Вставить("ГруппаОтчетов",			Настройки.ГруппаОтчетов);
			ДанныеОтчета.Вставить("Отчет",					Настройки.Отчет);
			ДанныеОтчета.Вставить("Периодичность",			Настройки.Периодичность);
			ДанныеОтчета.Вставить("Дата",					Настройки.ОтчетнаяДата);
			
			Пакет.Файлы.Добавить(ДанныеОтчета);
			
			#КонецОбласти
			
			Пакет.КомментарийКОтменеОбработки = Состояние.КомментарийКОтменеОбработки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область Формирование_письма
	
	// Для письма ключ - адрес отправителя и адреса получателей
	ДанныеПакетовПисем = Новый ТаблицаЗначений;
	
	ДанныеПакетовПисем.Колонки.Добавить("Пакет", Новый ОписаниеТипов("Булево"));
	ДанныеПакетовПисем.Колонки.Добавить("АдресОтправителя", Новый ОписаниеТипов("Строка"));
	ДанныеПакетовПисем.Колонки.Добавить("ПредставлениеОтправителя", Новый ОписаниеТипов("Строка"));
	ДанныеПакетовПисем.Колонки.Добавить("АдресаПолучателей", Новый ОписаниеТипов("Строка"));
	ДанныеПакетовПисем.Колонки.Добавить("ОграничениеРазмера", Новый ОписаниеТипов("Число"));
	ДанныеПакетовПисем.Колонки.Добавить("Файлы", Новый ОписаниеТипов("Массив"));
	ДанныеПакетовПисем.Колонки.Добавить("ТемаПисьма", Новый ОписаниеТипов("Строка"));
	ДанныеПакетовПисем.Колонки.Добавить("КомментарийКОтменеОбработки", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Отчет Из СостоянияОтчетов Цикл
		
		Состояние	= Отчет.Значение;
		Настройки	= НастройкиСтрок.Получить(Отчет.Ключ);
		
		// Формируем пакет для отправки почтой
		Если Состояние.Отправить Тогда
			
			#Область Определение_общих_параметров_письма
			
			Если Настройки.Свойство("АдресОтправителя")
				И ЗначениеЗаполнено(Настройки.АдресОтправителя) Тогда
				
				Попытка
					// Преобразуем строку адресов в массив адресов получателей
					МассивАдресов = РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(НРег(Настройки.АдресОтправителя));
				Исключение
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не корректно задана настройка 'Адрес отправителя'! Отчет не будет отправлен почтой.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
					
					Продолжить;
					
				КонецПопытки;
				
				Если МассивАдресов.Количество() > 1 Тогда
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не корректно задана настройка 'Адрес отправителя'! Отчет не будет отправлен почтой.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
					
					Продолжить;
					
				КонецЕсли;
				
				АдресОтправителя			= МассивАдресов[0].Адрес;
				ПредставлениеОтправителя	= МассивАдресов[0].Представление;
				
			Иначе
				// Используется отправитель по умолчанию
				АдресОтправителя			= "";
				ПредставлениеОтправителя	= "";
			КонецЕсли;
			
			Если Настройки.Свойство("АдресЭлектроннойПочты")
				И ЗначениеЗаполнено(Настройки.АдресЭлектроннойПочты) Тогда
				
				Попытка
					// Преобразуем строку адресов в массив адресов получателей
					МассивПолучателей = РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(НРег(Настройки.АдресЭлектроннойПочты));
				Исключение
					
					ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не корректно задана настройка 'E-mail'! Отчет не будет отправлен почтой.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
					
					Продолжить;
					
				КонецПопытки;
				
				// Из полученного массива достаем адреса
				МассивАдресов	= Новый Массив;
				Получатели		= Новый Массив;
				
				Для Каждого Адрес Из МассивПолучателей Цикл
					МассивАдресов.Добавить(Адрес.Адрес);
				КонецЦикла;
				
				// Удаляем дубли адресов
				РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивАдресов);
				
				// Готовим данные к сортировке
				СписокАдресов = Новый СписокЗначений;
				
				СписокАдресов.ЗагрузитьЗначения(МассивАдресов);
				
				// Сортируем
				СписокАдресов.СортироватьПоЗначению();
				
				АдресаПолучателей = "";
				
				Для Каждого Адрес Из СписокАдресов.ВыгрузитьЗначения() Цикл
					АдресаПолучателей = АдресаПолучателей + ?(АдресаПолучателей = "", "", "; ") + Адрес;
				КонецЦикла;
				
			Иначе
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не задана настройка 'E-mail'! Отчет не будет отправлен почтой.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
				
				Продолжить;
				
			КонецЕсли;
			
			ТемаПисьма	= "";
			Если Настройки.Свойство("ТемаПисьма")
				И ЗначениеЗаполнено(Настройки.ТемаПисьма) Тогда
				
				ТемаПисьма = Настройки.ТемаПисьма;
				
			КонецЕсли;
			
			#КонецОбласти
			
			#Область Определение_пакета
			
			Если Настройки.Свойство("ОтправлятьОтчетВСоставеПакета")
				И Настройки.ОтправлятьОтчетВСоставеПакета = Истина Тогда
				
				Отбор = Новый Структура;
				
				Отбор.Вставить("Пакет",				Истина);
				Отбор.Вставить("АдресОтправителя",	АдресОтправителя);
				Отбор.Вставить("АдресаПолучателей",	АдресаПолучателей);
				
				НайденныеСтроки = ДанныеПакетовПисем.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					Пакет = НайденныеСтроки[0];
				Иначе
					
					Пакет = ДанныеПакетовПисем.Добавить();
					
					Пакет.Пакет = Истина;
					
				КонецЕсли;
				
			Иначе
				
				Пакет = ДанныеПакетовПисем.Добавить();
					
				Пакет.Пакет = Ложь;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Пакет.АдресаПолучателей) Тогда
				Пакет.АдресОтправителя			= АдресОтправителя;
				Пакет.ПредставлениеОтправителя	= ПредставлениеОтправителя;
				Пакет.АдресаПолучателей			= АдресаПолучателей;
				Пакет.ТемаПисьма				= ТемаПисьма; 
			КонецЕсли;
				
			#КонецОбласти
			
			#Область Добавление_в_пакет
			
			Если Настройки.Свойство("МаксимальныйСуммарныйРазмерфайловПисьма") И ЗначениеЗаполнено(Настройки.МаксимальныйСуммарныйРазмерфайловПисьма)
				И (Пакет.ОграничениеРазмера = 0 ИЛИ Пакет.ОграничениеРазмера > Настройки.МаксимальныйСуммарныйРазмерфайловПисьма) Тогда
				Пакет.ОграничениеРазмера = Настройки.МаксимальныйСуммарныйРазмерфайловПисьма;
			КонецЕсли;
			
			// Выгружаем индивидуально
			ДанныеОтчета = Новый Структура;
			
			ДанныеОтчета.Вставить("Экземпляр",				Состояние.Экземпляр);
			ДанныеОтчета.Вставить("ИдентификаторВерсии",	Состояние.ИдентификаторВерсии);
			ДанныеОтчета.Вставить("Имя",					Настройки.ИмяБезРасширения);
			ДанныеОтчета.Вставить("Расширение",				Настройки.Расширение);
			ДанныеОтчета.Вставить("Субъект",				Настройки.Субъект);
			ДанныеОтчета.Вставить("ГруппаОтчетов",			Настройки.ГруппаОтчетов);
			ДанныеОтчета.Вставить("Отчет",					Настройки.Отчет);
			ДанныеОтчета.Вставить("Периодичность",			Настройки.Периодичность);
			ДанныеОтчета.Вставить("Дата",					Настройки.ОтчетнаяДата);
			
			Пакет.Файлы.Добавить(ДанныеОтчета);
			
			#КонецОбласти
			
			Пакет.КомментарийКОтменеОбработки = Состояние.КомментарийКОтменеОбработки;
			
		КонецЕсли;
		
		#КонецОбласти
				
		#Область Добавление_к_сохранению_в_отправленных
		
		// Временный блок, реализованный по просьбе бухгалтерии:
		// хотят до конца 2022 года, чтобы отчеты сохранялись в привычный каталог
		Если Настройки.ГруппаОтчетов = Справочники.Отчеты.Бухгалтерия И (Состояние.Отправить ИЛИ Состояние.Выгрузить) Тогда
			
			Если Настройки.Свойство("ПутьКФайлу") И ЗначениеЗаполнено(Настройки.ПутьКФайлу) Тогда
				
				ДанныеФайла = Новый Структура;
				
				ДанныеФайла.Вставить("ИдентификаторВерсии",	Состояние.ИдентификаторВерсии);
				ДанныеФайла.Вставить("Настройки",			Настройки);
				
				ФайлыКСохранению.Добавить(ДанныеФайла);
				
			Иначе
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
								Настройки.Отчет,
								Настройки.Периодичность,
								Настройки.Субъект,
								Настройки.ОтчетнаяДата,
								"Не задана настройка 'Путь к файлу'! Отчет не будет сохранен.",
								ОписаниеОшибки(),
								ЭтотОбъект.АвтоматическийЗапуск);
				
			КонецЕсли;
			
		КонецЕсли;
			
		#КонецОбласти
		
	КонецЦикла;
	
	// Создаем пакеты "Выгрузка файла"
	СоздатьПакетыДанных(Договор, Перечисления.ВидыПакетовДанныхКОбработке.ВыгрузкаФайла, ДанныеПакетовВыгрузок);
	
	// Создаем пакеты "Электронное письмо"
	СоздатьПакетыДанных(Договор, Перечисления.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо, ДанныеПакетовПисем);
	
	// Снимаем блокировку с экземпляров отчетов
	Для Каждого Экземпляр Из ЭкземплярыОтчетов Цикл
		РазблокироватьЭкземпляр(Экземпляр.Значение);
	КонецЦикла;
	
	// Временный блок, реализованный по просьбе бухгалтерии:
	// хотят до конца 2022 года, чтобы отчеты сохранялись в привычный каталог
	СохранитьФайлыОтчетов(ФайлыКСохранению);
	/////////////////////////////////////////////////////////////////////////
	
	#КонецОбласти
	
КонецПроцедуры

// Формирует пакеты очтетов и выполняет их обработку
Процедура ВыполнитьОбработкуОтчетов(ПараметрыОбработки) Экспорт
	
	ЗаполнитьТаблицуОтчетов(ЭтотОбъект.ТаблицаОтчетов, ПараметрыОбработки.Отбор, , ?(ПараметрыОбработки.Свойство("Период"), ПараметрыОбработки.Период, Неопределено));
	
	// Если запустили вручную, проверим актуальность состояний отчетов
	Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
		СостоянияОтчетовПередЗапуском = ПараметрыОбработки.СостоянияОтчетовПередЗапуском;
	КонецЕсли;
	
	// Фиксируем запуск в статистике работы внутренних механизмов
	Механизм			= "ВнешняяОбработка._ФормированиеОтчетности.АвтоматическоеФормированиеОтчетов";
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	#Область Формирование_списка_и_состава_пакетов_отчетов
	
	// Формируем список отчетов по каждому из счетов ДУ
	ДанныеОтчетов = Новый Соответствие;
	
	#Область Проверка_состояния_отчетов_перед_запуском_интерактивного_формирования_отчетности
	
	Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
		
		// Проверяем все ли выбранные отчеты к обработке остались в составе
		Для Каждого СостояниеПередЗапуском Из СостоянияОтчетовПередЗапуском Цикл
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("Субъект", 		СостояниеПередЗапуском.Субъект);
			Отбор.Вставить("Отчет",			СостояниеПередЗапуском.Отчет);
			Отбор.Вставить("Периодичность", СостояниеПередЗапуском.Периодичность);
			Отбор.Вставить("Дата",			СостояниеПередЗапуском.Дата);
			
			Если ЭтотОбъект.ТаблицаОтчетов.НайтиСтроки(Отбор).Количество() = 0 Тогда
				
				ОбработатьОшибку(СостояниеПередЗапуском.ГруппаОтчетов,
								СостояниеПередЗапуском.Отчет,
								СостояниеПередЗапуском.Периодичность,
								СостояниеПередЗапуском.Субъект,
								СостояниеПередЗапуском.Дата,
								"Отчет был удален из состава отчетов! Отчет не будет обработан.");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти
	
	ИсключитьОтчеты = Новый Массив;
	ИсключитьОтчеты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("_ЭскпортВСЭДВТБ_Форма029"));
	ИсключитьОтчеты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("_ЭскпортВСЭДВТБ_Форма522"));
	ИсключитьОтчеты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("_ЭскпортВСЭДВТБ_Форма685"));
	
	#Область Добавление_годовых_строк_482_в_ТаблицуОтчетов
	
	// Для субъектов, у которых нет годовой записи в реестре, но выполняются бизнес-условия
	// (целевой капитал, 4-й квартал, активы > 45 млн), добавляем годовую строку прямо
	// в ТаблицаОтчетов до главного цикла. Это позволяет отчёту пройти стандартный путь
	// обработки без обходных флагов.
	МассивСтрокДляДобавленияВТаблицу = Новый Массив;
	Отчет482 = ОбщегоНазначения.ПолучитьИменованныйОбъект("ОтчетОтчетУправляющегоФорма482");
	
	Для Каждого СтрОтч Из ЭтотОбъект.ТаблицаОтчетов Цикл
		
		Если СтрОтч.Отчет <> Отчет482 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрОтч.Периодичность <> Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЦелевойКапиталТребуетГодовогоОтчета(КонецДня(СтрОтч.Дата), СтрОтч.Субъект) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборГодТО = Новый Структура("Субъект, Отчет, Периодичность",
			СтрОтч.Субъект,
			СтрОтч.Отчет,
			Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);
		
		Если ЭтотОбъект.ТаблицаОтчетов.НайтиСтроки(ОтборГодТО).Количество() > 0 Тогда
			Продолжить; // годовая строка уже есть в реестре - не дублируем
		КонецЕсли;
		
		МассивСтрокДляДобавленияВТаблицу.Добавить(СтрОтч);
		
	КонецЦикла;
	
	Для Каждого СтрКвГод Из МассивСтрокДляДобавленияВТаблицу Цикл
		
		НоваяСтрТО = ЭтотОбъект.ТаблицаОтчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрТО, СтрКвГод);
		НоваяСтрТО.Периодичность       = Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно;
		НоваяСтрТО.Дата                = КонецГода(СтрКвГод.Дата);
		НоваяСтрТО.ДатаНачала          = НачалоГода(СтрКвГод.Дата);
		НоваяСтрТО.ДатаОкончания       = КонецГода(СтрКвГод.Дата);
		НоваяСтрТО.ИмяФайла            = СтрЗаменить(СтрКвГод.ИмяФайла, " 4 квартал", " год");
		НоваяСтрТО.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		
		// В ручном режиме главный цикл (строки ниже) пропустит строку, если её нет
		// в СостоянияОтчетовПередЗапуском. Добавляем актуальное состояние из БД,
		// перенося действия пользователя (Сформировать/Выгрузить/Отправить) из квартального.
		Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
			
			ОтборКвСост = Новый Структура("Субъект, Отчет, Периодичность, Дата",
				СтрКвГод.Субъект,
				СтрКвГод.Отчет,
				Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально,
				СтрКвГод.Дата);
			
			НайденныеКвСост = СостоянияОтчетовПередЗапуском.НайтиСтроки(ОтборКвСост);
			
			Если НайденныеКвСост.Количество() > 0 Тогда
				
				СтрКвСост = НайденныеКвСост[0];
				
				ОтчетыДляСостГод = ПолучитьПустуюТаблицуОтчетов();
				СтрДСГод = ОтчетыДляСостГод.Добавить();
				ЗаполнитьЗначенияСвойств(СтрДСГод, НоваяСтрТО);
				СтрДСГод.Дата              = НоваяСтрТО.Дата;
				СтрДСГод.ДатаНачала        = НоваяСтрТО.ДатаНачала;
				СтрДСГод.ДатаОкончания     = НоваяСтрТО.ДатаОкончания;
				СтрДСГод.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
				
				АктСостГодТО = РаботаСОтчетами.ПолучитьСостоянияОтчетов(
					ЭтотОбъект.Организация, ОтчетыДляСостГод)[0];
				
				АктСостГодТО.Сформировать = СтрКвСост.Сформировать;
				АктСостГодТО.Выгрузить    = СтрКвСост.Выгрузить;
				АктСостГодТО.Отправить    = СтрКвСост.Отправить;
				
				НовоеСостТО = СостоянияОтчетовПередЗапуском.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеСостТО, АктСостГодТО);
				НовоеСостТО.Субъект       = НоваяСтрТО.Субъект;
				НовоеСостТО.Отчет         = НоваяСтрТО.Отчет;
				НовоеСостТО.Периодичность = НоваяСтрТО.Периодичность;
				НовоеСостТО.Дата          = НоваяСтрТО.Дата;
				НовоеСостТО.ГруппаОтчетов = НоваяСтрТО.ГруппаОтчетов;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	Для Каждого Отчет Из ЭтотОбъект.ТаблицаОтчетов Цикл
		
		#Область Проверка_наличия_отчетов_в_списке_отчетов_к_формированию_перед_запуском_интерактивного_формирования_отчетности
		
		Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("Субъект", 		Отчет.Субъект);
			Отбор.Вставить("Отчет",			Отчет.Отчет);
			Отбор.Вставить("Периодичность", Отчет.Периодичность);
			Отбор.Вставить("Дата",			Отчет.Дата);
			
			СостояниеПередЗапуском = СостоянияОтчетовПередЗапуском.НайтиСтроки(Отбор);
			
			Если СостояниеПередЗапуском.Количество() = 0 Тогда
				// Отчет не был выбран к обработке
				Продолжить;
			Иначе
				СостояниеПередЗапуском = СостояниеПередЗапуском[0];
			КонецЕсли;
			
		Иначе
			
			Если ИсключитьОтчеты.Найти(Отчет.Отчет) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СостояниеПередЗапуском = Неопределено;
		КонецЕсли;
		
		#КонецОбласти
		
		Отказ = Ложь;
		Настройки = ПолучитьСтруктуруНастроек(Отчет,, ЭтотОбъект.АвтоматическийЗапуск, Отказ);
		
		// Сообщаем о незаполненных обязательных настройках
		Если Отказ Тогда
		
			ТекстСообщений = "";
			СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
			Для Каждого ТекСообщение Из СообщенияПользователю Цикл				
				ТекстСообщений = ТекстСообщений + Символы.ПС + ТекСообщение.Текст;
			КонецЦикла;                                           				
		
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось сформировать отчет!",
							ТекстСообщений);
			
			Продолжить;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Настройки.ИмяБезРасширения)
			ИЛИ НЕ ЗначениеЗаполнено(Настройки.Расширение)Тогда
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Отсутствует или некорректно указано значение настройки 'Имя файла'! Отчет не будет обработан.",
							"Настройка 'Имя файла' должна быть обязательно заполнена для отчетов, которые формируются с помощью обработки 'Формирование отчетности'.");
			
			Продолжить;
			
		КонецЕсли;
				
		ДанныеОтчетовСубъекта = ДанныеОтчетов.Получить(Отчет.Субъект);
		
		Если ДанныеОтчетовСубъекта = Неопределено Тогда
			
			ДанныеОтчетовСубъекта = Новый Структура;
			
			ДанныеОтчетовСубъекта.Вставить("НастройкиОтчетов", Новый Массив);
			
			Если НЕ ЭтотОбъект.АвтоматическийЗапуск Тогда
				ДанныеОтчетовСубъекта.Вставить("СостоянияОтчетовПередЗапуском", СостоянияОтчетовПередЗапуском.Скопировать(СостоянияОтчетовПередЗапуском.НайтиСтроки(Новый Структура("Субъект", Отчет.Субъект))));
			КонецЕсли;
			
			ДанныеОтчетов.Вставить(Отчет.Субъект, ДанныеОтчетовСубъекта);
			
		КонецЕсли;
		
		ДанныеОтчетовСубъекта.НастройкиОтчетов.Добавить(Настройки);
		
	КонецЦикла;
	
	#КонецОбласти
	
	Если ЭтотОбъект.АвтоматическийЗапуск Тогда
		
		#Область Запуск_фоновых_заданий
		
		// Подготавливаем параметры для запуска фоновых заданий
		Если ПараметрыОбработки.Свойство("МаксимальноеКоличествоСеансов") Тогда
			МаксимальноеКоличествоСеансов = Мин(Макс(ПараметрыОбработки.МаксимальноеКоличествоСеансов, 1), 10);
		Иначе
			МаксимальноеКоличествоСеансов = 1;
		КонецЕсли;
		
		НомерРодительскогоСеанса	= НомерСеансаИнформационнойБазы();
		РаботающиеСеансы			= Новый Массив;
		
		Для Каждого ДанныеОтчетовСубъекта Из ДанныеОтчетов Цикл
			
			ОжиданиеСвободныхСеансов(РаботающиеСеансы, МаксимальноеКоличествоСеансов);
			
			НаименованиеЗадания = СтрШаблон("Автоматическое формирование отчетов по договору %1 [%2]", ДанныеОтчетовСубъекта.Ключ, НомерРодительскогоСеанса);
			
			ПараметрыВыполнения = Новый Структура;
			
			ПараметрыВыполнения.Вставить("АвтоматическийЗапуск",	Истина);
			ПараметрыВыполнения.Вставить("Организация",				ЭтотОбъект.Организация);
			ПараметрыВыполнения.Вставить("Договор",					ДанныеОтчетовСубъекта.Ключ);
			ПараметрыВыполнения.Вставить("Настройки",				ДанныеОтчетовСубъекта.Значение.НастройкиОтчетов);
			
			ПараметрыДлительнойОперации = Новый Структура;
			
			ПараметрыДлительнойОперации.Вставить("ЭтоВнешняяОбработка",				Истина);
			ПараметрыДлительнойОперации.Вставить("ДополнительнаяОбработкаСсылка",	ПараметрыОбработки.ОбработкаФормированиеОтчетности);
			ПараметрыДлительнойОперации.Вставить("ИмяМетода",						"ОбработатьПакетОтчетов");
			ПараметрыДлительнойОперации.Вставить("ПараметрыВыполнения",				ПараметрыВыполнения);
			
			Параметры = Новый Массив;
			
			Параметры.Добавить(ПараметрыДлительнойОперации);
			Параметры.Добавить(Неопределено);
			
			ФоновоеЗадание = ФоновыеЗадания.Выполнить("РаботаСДлительнымиОперациями.ВыполнитьПроцедуруМодуляОбъектаОбработки", Параметры, , НаименованиеЗадания);
			
			РаботающиеСеансы.Добавить(ФоновоеЗадание);
			
		КонецЦикла;
		
		#КонецОбласти
		
	Иначе
		
		#Область Запуск_обработки_пакетов
		
		Для Каждого ДанныеОтчетовСубъекта Из ДанныеОтчетов Цикл
			
			ПараметрыВыполнения = Новый Структура;
			
			ПараметрыВыполнения.Вставить("Договор",							ДанныеОтчетовСубъекта.Ключ);
			ПараметрыВыполнения.Вставить("Настройки",						ДанныеОтчетовСубъекта.Значение.НастройкиОтчетов);
			ПараметрыВыполнения.Вставить("СостоянияОтчетовПередЗапуском",	ДанныеОтчетовСубъекта.Значение.СостоянияОтчетовПередЗапуском);
			
			ОбработатьПакетОтчетов(ПараметрыВыполнения);
			
		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;
	
	// Фиксируем завершение работы в статистике работы внутренних механизмов
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Функция ЦелевойКапиталТребуетГодовогоОтчета(КонецПериода, Субъект)
	
	Если КонецКвартала(КонецПериода) <> КонецПериода ИЛИ Месяц(КонецПериода) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Субъект) <> Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Субъект, "ВидДоговораДоверительногоУправления");
	Если ВидДоговора <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПолучитьСтоимостьАктивовНаДату(
		ЭтотОбъект.Организация, Субъект, КонецПериода) > 45000000;
	
КонецФункции

Функция ПолучитьСтоимостьАктивовНаДату(Организация, СчетДоверительногоУправления, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СубъектАналитики", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Заполняет таблицу отчетов с учетом переданного отбора
Процедура ЗаполнитьТаблицуОтчетов(Таблица, Отбор = Неопределено, УникальныйИдентификаторФормы = Неопределено, Период = Неопределено) Экспорт
	
	Если Период = Неопределено Тогда
		
		Таблица.Загрузить(
			РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьСоставИНастройкиОтчетовНаДату(
				ЭтотОбъект.Организация, ЭтотОбъект.Дата, ЭтотОбъект.УчитыватьСрокФормирования, Отбор, УникальныйИдентификаторФормы, ЭтотОбъект.ВсеОтчетыБезУчетаПериодичности, Истина));
				
	Иначе          		
		
		Таблица.Очистить();
		
		Если Период.ДатаНачала = '00010101' Или Период.ДатаОкончания = '00010101' Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно указан период заполнения");
			Возврат;
		КонецЕсли;
		
		ТекДата = Период.ДатаНачала;
		Пока ТекДата <= Период.ДатаОкончания Цикл                                                                                   			
			ТаблицаНаДату = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьСоставИНастройкиОтчетовНаДату(
				ЭтотОбъект.Организация, ТекДата, Ложь, Отбор, УникальныйИдентификаторФормы);
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицаНаДату, Таблица);	
			ТекДата = ТекДата + 24 * 60 * 60;
		КонецЦикла;
		
	КонецЕсли;
				
	Для Каждого ТекущаяСтрока Из Таблица Цикл
		ТекущаяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает обработанную и подготовленную структуру со значениями настроек отчета
//
Функция ПолучитьСтруктуруНастроек(Отчет, УдалитьНастройкиИзВременногоХранилища = Истина, СообщатьОбОшибкахНастроек = Ложь, Отказ = Ложь) Экспорт

	НастройкиОтчета = Новый Структура;
	
	НастройкиОтчета.Вставить("АвтоматическоеФормирование", 		ЭтотОбъект.АвтоматическийЗапуск);
	НастройкиОтчета.Вставить("Организация", 					ЭтотОбъект.Организация);
	НастройкиОтчета.Вставить("Субъект",							Отчет.Субъект);
	НастройкиОтчета.Вставить("Отчет",							Отчет.Отчет);
	НастройкиОтчета.Вставить("ГруппаОтчетов",					Отчет.ГруппаОтчетов);
	НастройкиОтчета.Вставить("Периодичность", 					Отчет.Периодичность);
	НастройкиОтчета.Вставить("ОтчетнаяДата",					Отчет.Дата);
	НастройкиОтчета.Вставить("ВыгружаетсяВЭДО",					Отчет.ВыгружаетсяВЭДО);
	НастройкиОтчета.Вставить("ОтправляетсяПочтой",				Отчет.ОтправляетсяПочтой);
	НастройкиОтчета.Вставить("ИмяФайла",						Отчет.ИмяФайла);
	НастройкиОтчета.Вставить("СчетДоверительногоУправления",	Отчет.Субъект);
	НастройкиОтчета.Вставить("КлючОтчета",						Отчет.КлючОтчета);
	НастройкиОтчета.Вставить("Период",							Новый СтандартныйПериод(Отчет.ДатаНачала, Отчет.ДатаОкончания));
	НастройкиОтчета.Вставить("Регламентированный",				Отчет.Регламентированный);
	
	
	Если ЗначениеЗаполнено(Отчет.ИмяФайла) Тогда
		
		Файл = Новый Файл(Отчет.ИмяФайла);
		
		ИмяБезРасширения	= Файл.ИмяБезРасширения;
		Расширение			= СтрЗаменить(Файл.Расширение, ".", "");
		
	Иначе
		ИмяБезРасширения	= Неопределено;
		Расширение			= Неопределено;
	КонецЕсли;
	
	НастройкиОтчета.Вставить("ИмяБезРасширения",	ИмяБезРасширения);
	НастройкиОтчета.Вставить("Расширение",			Расширение);
	
	МассивНастроек = ПолучитьИзВременногоХранилища(Отчет.АдресНастроек);
	Для Каждого Настройка Из МассивНастроек Цикл
		
		Если СообщатьОбОшибкахНастроек И Настройка.ОшибкаВЗначении Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно заполнена или отсутствует настройка '" + СокрЛП(Настройка.Настройка) + "'",,,, Отказ);			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Настройка.КодНастройки) Тогда
			
			Если Настройка.КодНастройки = "Подписант" ИЛИ Настройка.КодНастройки = "ПодписантБухгалтер" Тогда
				
				СтруктураКлюча = Новый Структура;
	
				СтруктураКлюча.Вставить("Подразделение",	ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
			    СтруктураКлюча.Вставить("Язык",				ПредопределенноеЗначение("Справочник.Языки.Русский"));
				СтруктураКлюча.Вставить("Объект",			ЭтотОбъект.Организация);
				СтруктураКлюча.Вставить("КонтактноеЛицо",	Настройка.Значение);
				
				СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
				
				НастройкиОтчета.Вставить(Настройка.КодНастройки, СтруктураДанныхКонтактногоЛица);
				
			ИначеЕсли Настройка.КодНастройки = "ВариантОтчета" Тогда
				
				Если ТипЗнч(Настройка.Значение) = Тип("СправочникСсылка.ВариантыОтчетов") Тогда 
					НастройкиОтчета.Вставить("ВариантОтчета", Настройка.Значение.УникальныйИдентификатор());
				Иначе
					НастройкиОтчета.Вставить("ВариантОтчета", Настройка.Значение);	
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Настройка.Значение) = Тип("СправочникСсылка.ЗначенияНастроекОтчетов") Тогда
				НастройкиОтчета.Вставить(Настройка.КодНастройки, Настройка.КлючЗначения);
			Иначе
				НастройкиОтчета.Вставить(Настройка.КодНастройки, Настройка.Значение);
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если УдалитьНастройкиИзВременногоХранилища Тогда
		УдалитьИзВременногоХранилища(Отчет.АдресНастроек);
	КонецЕсли;
	
	Возврат НастройкиОтчета;

КонецФункции

#КонецОбласти

#Область Служебные_процедуры_и_функции

#Область Временный_блок

// Временная процедура, реализованная по просьбе бухгалтерии:
// хотят до конца 2022 года, чтобы отчеты сохранялись в привычный каталог
Процедура СохранитьФайлыОтчетов(ДанныеФайлов)
	
	ЭтоТестоваяБаза = НЕ ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
	
	Для Каждого ДанныеФайла Из ДанныеФайлов Цикл
		
		Настройки = ДанныеФайла.Настройки;
		
		Попытка
			ДанныеВерсии = РаботаСФайловымХранилищем.ПолучитьВерсиюФайла(ДанныеФайла.ИдентификаторВерсии);
		Исключение
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось сохранить файл в каталоге для отправленных отчетов из-за ошибки при получении данных файла из файлового хранилища!",
							ОписаниеОшибки(),
							ЭтотОбъект.АвтоматическийЗапуск);
			
			Продолжить;
			
		КонецПопытки;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
		Исключение
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось сохранить файл в каталоге для отправленных отчетов из-за ошибки при получении данных файла из временного хранилища!",
							ОписаниеОшибки(),
							ЭтотОбъект.АвтоматическийЗапуск);
			
			Продолжить;
			
		КонецПопытки;
		
		Если ЭтоТестоваяБаза Тогда
			
			Файл = Новый Файл(Настройки.ПутьКФайлу);
			
			ТестовыйКаталог = Константы.КаталогВыгрузкиФайловДляТестовойБазы.Получить();
			
			Если НЕ ЗначениеЗаполнено(ТестовыйКаталог) Тогда
				
				ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось сохранить файл в каталоге для отправленных отчетов, т.к. не заполнен каталог выгрузки для тестовой базы!",
							ОписаниеОшибки(),
							ЭтотОбъект.АвтоматическийЗапуск);
			
				Продолжить;
				
			КонецЕсли;
			
			ПутьКФайлу = ТестовыйКаталог + ?(Прав(ТестовыйКаталог, 1) = "\", "", "\") + "ОтправленныеИВыгруженные\" + Файл.Имя;
			
		Иначе
			ПутьКФайлу = Настройки.ПутьКФайлу;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные.Записать(ПутьКФайлу);
		Исключение
			
			ОбработатьОшибку(Настройки.ГруппаОтчетов,
							Настройки.Отчет,
							Настройки.Периодичность,
							Настройки.Субъект,
							Настройки.ОтчетнаяДата,
							"Не удалось сохранить файл в каталоге для отправленных отчетов из-за ошибки при записи файла!",
							ОписаниеОшибки(),
							ЭтотОбъект.АвтоматическийЗапуск);
			
			Продолжить;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_команд

Процедура ПроверитьОтправкуПоЭДО(ПараметрыКоманды)
	
	// Фиксируем запуск в статистике работы внутренних механизмов
	Механизм			= "ВнешняяОбработка._ФормированиеОтчетности.ПроверкаОтправкиПоЭДО";
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	Отбор = Новый Структура;
	
	// В отбор при автоформировании добавляем только текущее время, для получения списка отчетов, которые к этому времени должны быть обработаны
	Отбор.Вставить("ТекущееВремя", '00010101' + (ТекущаяДатаСеанса() - ЭтотОбъект.Дата));
	
	ЗаполнитьТаблицуОтчетов(ЭтотОбъект.ТаблицаОтчетов, Отбор);
	
	Для Каждого Отчет Из ЭтотОбъект.ТаблицаОтчетов Цикл
		
		ЭтоОтчетБэкОфиса = Отчет.Отчет.ПринадлежитЭлементу(Справочники.Отчеты.БэкОфис);
		
		Настройки = ПолучитьСтруктуруНастроек(Отчет);
		
		// Если ЭДО не может отправить файлы, она помещает их специальный каталог.
		// Если мы обнаруживаем в нем файлы, то необходимо переместить их обратно в каталог ЭДО для повторной отправки,
		// а также уведомить об этом сотрудника бэк-офиса.
		Если Отчет.ВыгружаетсяВЭДО Тогда
			
			КаталогОшибок = РаботаСОтчетамиКлиентСервер.ПолучитьКаталогСохраненияРезультатаОтчета(Настройки, "КаталогФайловСОшибкойОтправкиПоЭДО", Ложь);	
			
			Если Не ЗначениеЗаполнено(КаталогОшибок) Тогда
				Продолжить;
			КонецЕсли;
			
			КаталогСохранения = РаботаСОтчетамиКлиентСервер.ПолучитьКаталогСохраненияРезультатаОтчета(Настройки, "КаталогФайловДляОтправкиПоЭДО", Ложь);	
			
			Если Не ЗначениеЗаполнено(КаталогСохранения) Тогда
				Продолжить;
			КонецЕсли;			
			
			// Не все файлы являются отчетами
			ИгнорируемыеФайлы = Новый Массив;
			
			ИгнорируемыеФайлы.Добавить("Thumbs.db");
			
			// Получаем все файлы из каталога ошибок отправки через ЭДО и перемещаем их в каталог отправки
			НайденныеФайлы = НайтиФайлы(КаталогОшибок, "*.*");
			
			Если НайденныеФайлы.Количество() > 0 Тогда
				
				МассивИменФайлов = Новый Массив;
				
				Для Каждого НеотправленныйФайл Из НайденныеФайлы Цикл
					
					Если НеотправленныйФайл.ЭтоКаталог()
						ИЛИ ИгнорируемыеФайлы.Найти(НеотправленныйФайл.Имя) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					МассивИменФайлов.Добавить(НеотправленныйФайл.Имя); 
					ПереместитьФайл(НеотправленныйФайл.ПолноеИмя, КаталогСохранения + НеотправленныйФайл.Имя);	
					
				КонецЦикла;
				
				// При необходимости отправляем письмо о наличии ошибок
				Если МассивИменФайлов.Количество() > 0
					И ((ЭтоОтчетБэкОфиса 
						И Настройки.Свойство("АдресЭлектроннойПочтыБэкОфиса")
						И ЗначениеЗаполнено(Настройки.АдресЭлектроннойПочтыБэкОфиса))
					Или
					   (Не ЭтоОтчетБэкОфиса 
						И Настройки.Свойство("АдресЭлектроннойПочтыБухгалтерии")
						И ЗначениеЗаполнено(Настройки.АдресЭлектроннойПочтыБухгалтерии)))
					
					Тогда
					
					ДанныеПисьма = Новый Структура;
					
					ШаблонПисьма =	"<HTML><HEAD />
									|<BODY>
									|	<P>В каталоге ошибок отправки файлов через ЭДО обнаружены файлы:
									|		<BR>- %1
									|	</P>
									|	<P>Данные файлы будут перемещены в каталог для повторной отправки через ЭДО.</P>
									|	<P>Каталог отправки: ""%2""						
									|		<BR>Каталог ошибок: ""%3""						
									|	</P>
									|</BODY></HTML>";
					
					ДанныеПисьма.Вставить("Тема",		"Ошибка отправки файлов через ЭДО");
					ДанныеПисьма.Вставить("Текст",		СтрШаблон(ШаблонПисьма, СтрСоединить(МассивИменФайлов, "<BR>- "), КаталогСохранения, КаталогОшибок));
					ДанныеПисьма.Вставить("ТипТекста",	Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
					
					ДанныеПисьма.Вставить("Получатели", РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(?(ЭтоОтчетБэкОфиса, Настройки.АдресЭлектроннойПочтыБэкОфиса, Настройки.АдресЭлектроннойПочтыБухгалтерии)));
					
					Попытка
						РаботаСПакетамиДанныхКОбработке.СоздатьПакетДанных(Перечисления.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо, ДанныеПисьма);
					Исключение
						РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Ошибка создания электронного письма об ошибках выгрузки в ЭДО." + Символы.ПС + ОписаниеОшибки(), "Проверка отправки отчетов в ЭДО");
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;				
			
		КонецЕсли;			
		
		Если ЭтоАдресВременногоХранилища(Отчет.АдресНастроек) Тогда
			УдалитьИзВременногоХранилища(Отчет.АдресНастроек);
		КонецЕсли;
		
	КонецЦикла;
	
	// Фиксируем завершение работы в статистике работы внутренних механизмов
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура ВыполнитьАвтоматическоеФормированиеОтчетов(ПараметрыКоманды, ОбработкаФормированиеОтчетности)
	
	Отбор = Новый Структура;
	
	// В отбор при автоформировании добавляем только текущее время, для получения списка отчетов, которые к этому времени должны быть обработаны
	Отбор.Вставить("ТекущееВремя", '00010101' + (ТекущаяДатаСеанса() - ЭтотОбъект.Дата));
	
	ПараметрыОбработки = Новый Структура;
	
	ПараметрыОбработки.Вставить("Отбор",							Отбор);
	ПараметрыОбработки.Вставить("ОбработкаФормированиеОтчетности",	ОбработкаФормированиеОтчетности);
	
	Если ПараметрыКоманды.Свойство("МаксимальноеКоличествоСеансов") Тогда
		ПараметрыОбработки.Вставить("МаксимальноеКоличествоСеансов", ПараметрыКоманды.МаксимальноеКоличествоСеансов);
	КонецЕсли;
	
	ВыполнитьОбработкуОтчетов(ПараметрыОбработки);
	
КонецПроцедуры

Процедура ОповеститьОРезультатахОбработкиОтчетов(Параметры)
	
	ОтчетОбъект = Отчеты.РезультатыОбработкиОтчетов.Создать();
	
	ОтчетОбъект.Организация		= Параметры.Организация;
	ОтчетОбъект.ГруппаОтчетов	= Параметры.ГруппаОтчетов;
	ОтчетОбъект.Дата			= ТекущаяДата();
	
	ВыводитьВсе = ОтчетОбъект.ГруппаОтчетов = Справочники.Отчеты.БэкОфис; 
	
	Результат = ОтчетОбъект.Сформировать(,, ВыводитьВсе);
	
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
	ИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + Строка(Новый УникальныйИдентификатор) + ".html";
	
	Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТД = Новый ТекстовыйДокумент;
	
	ТД.Прочитать(ИмяФайла);
	
	Тема = СтрШаблон("Результаты обработки отчетов %1 за %2 по группе отчетов '%3'", ОтчетОбъект.Организация, Формат(ОтчетОбъект.Дата, "ДФ=dd.MM.yyyy"), ОтчетОбъект.ГруппаОтчетов);
	
	РеквизитыОповещения = Новый Структура;
	
	РеквизитыОповещения.Вставить("Организация",		ОтчетОбъект.Организация);
	РеквизитыОповещения.Вставить("ГруппаОтчетов",	ОтчетОбъект.ГруппаОтчетов);
	РеквизитыОповещения.Вставить("Тема",			Тема);
	РеквизитыОповещения.Вставить("Текст",			ТД.ПолучитьТекст());
	
	Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._ФормированиеОтчетности.АвтоформированиеОтчетов", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	
КонецПроцедуры

Процедура ВыгрузитьОтчетностьВДО(ПараметрыКоманды)
	
	// Фиксируем запуск в статистике работы внутренних механизмов
	Механизм			= "ВнешняяОбработка._ФормированиеОтчетности.ВыгрузитьОтчетностьВДО";
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	МассивОшибок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВременноеХранилищеОтчетов.Период КАК Период,
		|	ВременноеХранилищеОтчетов.ЭкземплярОтчета КАК ЭкземплярОтчета,
		|	ВременноеХранилищеОтчетов.ИдентификаторВерсии КАК ИдентификаторВерсии,
		|	ВременноеХранилищеОтчетов.ДвоичныеДанные КАК ДвоичныеДанные,
		|	ВременноеХранилищеОтчетов.Имя КАК Имя,
		|	ВременноеХранилищеОтчетов.Расширение КАК Расширение,
		|	ВременноеХранилищеОтчетов.ИдентификаторФайла КАК ИдентификаторФайла,
		|	ВременноеХранилищеОтчетов.ЭкземплярОтчета.Организация КАК Организация,
		|	ВременноеХранилищеОтчетов.ЭкземплярОтчета.Субъект КАК Субъект,
		|	ВременноеХранилищеОтчетов.ЭкземплярОтчета.Отчет КАК Отчет,
		|	ВременноеХранилищеОтчетов.ЭкземплярОтчета.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.ВременноеХранилищеОтчетов КАК ВременноеХранилищеОтчетов
		|ГДЕ
		|	ВременноеХранилищеОтчетов.Период < &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВременноеХранилищеОтчетов.Период
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НачатьТранзакцию();
		
		ОбъектЭкземпляра = ВыборкаДетальныеЗаписи.ЭкземплярОтчета.ПолучитьОбъект();
		
		Попытка
			ОбъектЭкземпляра.Заблокировать();
		Исключение
			
			ОтменитьТранзакцию();
			
			МассивОшибок.Добавить("Не удалось заблокировать экземпляр отчета!" + Символы.ПС +
				Строка(ВыборкаДетальныеЗаписи.Отчет) + " по " + Строка(ВыборкаДетальныеЗаписи.Субъект) + " за " + Формат(ВыборкаДетальныеЗаписи.Отчет, "ДФ=dd.MM.yyyy") + Символы.ПС +
				"По причине: " + ОписаниеОшибки() + Символы.ПС + 
				" Отчет не будет обработан.");
			
			Продолжить;
			
		КонецПопытки;
		
		ДвоичныеДанные = ВыборкаДетальныеЗаписи.ДвоичныеДанные.Получить();
		
		АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		РазмерФайла = ДвоичныеДанные.Размер()/1048576;
		
		Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИдентификаторФайла) Тогда
			// Создаем новый файл
			ПараметрыФайла = Новый Структура;
			
			ПараметрыФайла.Вставить("Адрес",					АдресДвоичныхДанных);
			ПараметрыФайла.Вставить("Имя",						ВыборкаДетальныеЗаписи.Имя);
			ПараметрыФайла.Вставить("Расширение",				ВыборкаДетальныеЗаписи.Расширение);
			ПараметрыФайла.Вставить("НаименованиеВладельца",	Строка(ВыборкаДетальныеЗаписи.Субъект));
			ПараметрыФайла.Вставить("ИдентификаторВладельца",	Строка(ВыборкаДетальныеЗаписи.Субъект.УникальныйИдентификатор()));
			ПараметрыФайла.Вставить("ТипВладельца",				"Клиентские отчеты");
			
			Попытка
				ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, ВыборкаДетальныеЗаписи.Организация);
			Исключение
				
				ОбъектЭкземпляра.Разблокировать();
				
				ТекстОшибки = СтрШаблон("Не удалось сохранить файл в файловом хранилище из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
				
				МассивОшибок.Добавить(ТекстОшибки);
				
				ОтменитьТранзакцию();
				
				Продолжить;
				
			КонецПопытки;
			
			НовыйИдентификаторВерсии = ДанныеВерсии.ИдентификаторВерсии;
			НовыйИдентификаторФайла = ДанныеВерсии.ИдентификаторФайла;
			
			
			ОбъектЭкземпляра.ИдентификаторФайла = НовыйИдентификаторФайла;
			
		Иначе
			Попытка
				НовыйИдентификаторВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(ВыборкаДетальныеЗаписи.ИдентификаторФайла, АдресДвоичныхДанных, ВыборкаДетальныеЗаписи.Расширение);
			Исключение
				
				МассивОшибок.Добавить("Не удалось сохранить результат формирования отчета в файловом хранилище!" + Символы.ПС +
					Строка(ВыборкаДетальныеЗаписи.Отчет) + " по " + Строка(ВыборкаДетальныеЗаписи.Субъект) + " за " + Формат(ВыборкаДетальныеЗаписи.Отчет, "ДФ=dd.MM.yyyy") + Символы.ПС +
					"По причине: " + ОписаниеОшибки() + Символы.ПС + 
					" Отчет не будет обработан.");
				
				
				РазблокироватьЭкземпляр(ОбъектЭкземпляра);
				
				ОтменитьТранзакцию();
				
				Продолжить;
				
			КонецПопытки;
			
			НовыйИдентификаторФайла = ВыборкаДетальныеЗаписи.ИдентификаторФайла;
			
		КонецЕсли;
		
		//РаботаСФайловымХранилищем.ОбновитьФайл(
		Для Каждого СтрокаТаблицы Из ОбъектЭкземпляра.ВерсииОтчетов Цикл
			Если СтрокаТаблицы.ИдентификаторВерсии = ВыборкаДетальныеЗаписи.ИдентификаторВерсии Тогда
				СтрокаТаблицы.ИдентификаторВерсии = НовыйИдентификаторВерсии;	
			КонецЕсли;	
		КонецЦикла;	
		
		УдалитьИзВременногоХранилища(АдресДвоичныхДанных);
		
		#Область Сохранение_экземпляра_отчета
		
		Попытка
			ОбъектЭкземпляра.Записать();
		Исключение
			
			МассивОшибок.Добавить("Не удалось зафиксировать сохранение результата формирования отчета в файловом хранилище!" + Символы.ПС +
				Строка(ВыборкаДетальныеЗаписи.Отчет) + " по " + Строка(ВыборкаДетальныеЗаписи.Субъект) + " за " + Формат(ВыборкаДетальныеЗаписи.Отчет, "ДФ=dd.MM.yyyy") + Символы.ПС +
				"По причине: " + ОписаниеОшибки() + Символы.ПС + 
				" Отчет не будет обработан.");
			
			РазблокироватьЭкземпляр(ОбъектЭкземпляра);
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецПопытки;
		
		#КонецОбласти
		
		#Область Обработка_Регистров
		
		// Обработка регистров где участвуют ИдентификаторФайла или ИдентификаторВерсии 
		
		//ДанныеФормированияОтчетности
		Попытка
			
			НаборЗаписей = РегистрыСведений.ВременноеХранилищеОтчетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(ВыборкаДетальныеЗаписи.ЭкземплярОтчета);
			НаборЗаписей.Отбор.ИдентификаторВерсии.Установить(ВыборкаДетальныеЗаписи.ИдентификаторВерсии);
			НаборЗаписей.Записать();
			
		Исключение
			
			МассивОшибок.Добавить("При обработке регистра ВременноеХранилищеОтчетов произошла ошибка: " + ОписаниеОшибки());
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецПопытки;
		
		//НомераВерсийОтчетовДляКлиентов
		Попытка 
			
			НаборЗаписей = РегистрыСведений.НомераВерсийОтчетовДляКлиентов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Экземпляр.Установить(ВыборкаДетальныеЗаписи.ЭкземплярОтчета);
			НаборЗаписей.Отбор.ИдентификаторВерсии.Установить(ВыборкаДетальныеЗаписи.ИдентификаторВерсии);
			НаборЗаписей.Прочитать();
			
			ЗаписиРСНовая = РегистрыСведений.НомераВерсийОтчетовДляКлиентов.СоздатьНаборЗаписей();
			ЗаписиРСНовая.Отбор.Экземпляр.Установить(ВыборкаДетальныеЗаписи.ЭкземплярОтчета);
			ЗаписиРСНовая.Отбор.ИдентификаторВерсии.Установить(НовыйИдентификаторВерсии);
			
			Для Каждого Запись Из НаборЗаписей Цикл
						
				НоваяЗапись = ЗаписиРСНовая.Добавить();
				НоваяЗапись.Экземпляр = ВыборкаДетальныеЗаписи.ЭкземплярОтчета;
				НоваяЗапись.ИдентификаторВерсии = НовыйИдентификаторВерсии;
				НоваяЗапись.НомерВерсии = Запись.НомерВерсии;
			
			КонецЦикла;
			
			ЗаписиРСНовая.Записать();
			
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			
		Исключение
			
			МассивОшибок.Добавить("При обработке регистра НомераВерсийОтчетовДляКлиентов произошла ошибка: " + ОписаниеОшибки());
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецПопытки;	
		
		//ЖурналСобытийСОтчетами
		Попытка 
			
			НаборЗаписей = РегистрыСведений.ЖурналСобытийСОтчетами.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Экземпляр.Установить(ВыборкаДетальныеЗаписи.ЭкземплярОтчета);
			НаборЗаписей.Отбор.ИдентификаторВерсии.Установить(ВыборкаДетальныеЗаписи.ИдентификаторВерсии);
			НаборЗаписей.Прочитать();
			
			ЗаписиРСНовая = РегистрыСведений.ЖурналСобытийСОтчетами.СоздатьНаборЗаписей();
			ЗаписиРСНовая.Отбор.Экземпляр.Установить(ВыборкаДетальныеЗаписи.ЭкземплярОтчета);
			ЗаписиРСНовая.Отбор.ИдентификаторВерсии.Установить(НовыйИдентификаторВерсии);
			
			Для Каждого Запись Из НаборЗаписей Цикл
				ЗаписьРСНовая = ЗаписиРСНовая.Добавить();
				ЗаписьРСНовая.Экземпляр =  Запись.Экземпляр;
				ЗаписьРСНовая.Событие = Запись.Событие;
				ЗаписьРСНовая.Дата = Запись.Дата;
				ЗаписьРСНовая.ИдентификаторВерсии = НовыйИдентификаторВерсии;
				ЗаписьРСНовая.ПакетДанных = Запись.ПакетДанных;
				ЗаписьРСНовая.Ответственный = Запись.Ответственный;
			КонецЦикла;	
			
			ЗаписиРСНовая.Записать();
			
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			
		Исключение
			
			МассивОшибок.Добавить("При обработке регистра ЖурналСобытийСОтчетами произошла ошибка: " + ОписаниеОшибки());
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецПопытки;	
		
		#КонецОбласти
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		РеквизитыОповещения = Новый Структура;
		
		РеквизитыОповещения.Вставить("Тема",			"Ошибка отправке отчетности в ДО");
		РеквизитыОповещения.Вставить("Текст",			СтрСоединить(МассивОшибок, Символы.ПС));
		
		ИмяОповещения = "ВнешняяОбработка._ФормированиеОтчетности.ВыгрузитьОтчетностьВДО";
		
		Справочники.Оповещения.СформироватьОповещения(ИмяОповещения, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;	
	
	// Фиксируем завершение работы в статистике работы внутренних механизмов
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры	

#КонецОбласти

#Область Прочие

Процедура СоздатьПакетыДанных(Договор, ВидПакетов, ДанныеПакетов)
	
	Для Каждого ДанныеПакета Из ДанныеПакетов Цикл
		
		ТехническаяИнформация	= "";
		ДанныеДляФиксацииОшибок	= Новый Массив;
		Файлы					= Новый Массив;
		
		Для Каждого ФайлПакета Из ДанныеПакета.Файлы Цикл
			
			ДанныеДляФиксации = Новый Структура;
			
			ДанныеДляФиксации.Вставить("ГруппаОтчетов",			ФайлПакета.ГруппаОтчетов.ИмяПредопределенныхДанных);
			ДанныеДляФиксации.Вставить("Отчет",					Строка(ФайлПакета.Отчет));
			ДанныеДляФиксации.Вставить("Периодичность",			Строка(ФайлПакета.Периодичность));
			ДанныеДляФиксации.Вставить("Субъект",				Строка(Договор));
			ДанныеДляФиксации.Вставить("ОтчетнаяДата",			ФайлПакета.Дата);
			
			ДанныеДляФиксацииОшибок.Добавить(ДанныеДляФиксации);
			
		КонецЦикла;
		
		НачатьТранзакцию();
		
		Для Каждого ФайлПакета Из ДанныеПакета.Файлы Цикл
			
			Попытка
				НомерВерсии = РегистрыСведений.НомераВерсийОтчетовДляКлиентов.УстановитьНомерВерсииДляКлиента(ФайлПакета.Экземпляр, ФайлПакета.ИдентификаторВерсии);
			Исключение
				
				ОтменитьТранзакцию();
				
				ТехническаяИнформация = ОписаниеОшибки();
				
				Прервать;
				
			КонецПопытки;
			
			Если НомерВерсии > 1 Тогда
				ПредставлениеВерсии = Формат(НомерВерсии, "ЧГ=0; ЧФ=' (v.Ч)'");
			Иначе
				ПредставлениеВерсии = "";
			КонецЕсли;
			
			Файл = Новый Структура;
			
			Файл.Вставить("ИдентификаторВерсии",	ФайлПакета.ИдентификаторВерсии);
			Файл.Вставить("Имя",					СтрШаблон("%1%2.%3", ФайлПакета.Имя, ПредставлениеВерсии, ФайлПакета.Расширение));
			
			Файлы.Добавить(Файл);
			
		КонецЦикла;
		
		Если ТранзакцияАктивна() Тогда
			
			Если ВидПакетов = Перечисления.ВидыПакетовДанныхКОбработке.ВыгрузкаФайла Тогда
				
				ПакетДанных = Новый Структура;
			
				ПакетДанных.Вставить("Организация", ЭтотОбъект.Организация);
				
				Событие		= Перечисления.СобытияСОтчетами.СозданиеВыгрузкиВЭДО;
				ТекстОшибки	= "Не удалось создать задание на выгрузку! Отчет не будет выгружен в ЭДО.";
				
				Если ЗначениеЗаполнено(ДанныеПакета.ОграничениеРазмера) Тогда
					ПакетДанных.Вставить("МаксимальныйСуммарныйРазмерФайлов", ДанныеПакета.ОграничениеРазмера);
				КонецЕсли;
				
				ПакетДанных.Вставить("Путь", ДанныеПакета.Каталог);
				
				Если Файлы.Количество() > 1 Тогда
					
					Запрос = Новый Запрос;
					
					Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
					Запрос.УстановитьПараметр("Договор",		Договор);
					Запрос.УстановитьПараметр("ТекущаяДата",	ТекущаяДата());
					
					Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
					
					Запрос.Текст =
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	РеквизитыЮридическихЛицАнкетные.КраткоеНаименованиеПоУставу КАК Наименование
						|ПОМЕСТИТЬ _ДанныеОрганизации
						|ИЗ
						|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
						|			&ТекущаяДата,
						|			ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
						|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетные
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	СчетаДоверительногоУправления.Наименование КАК Наименование,
						|	СчетаДоверительногоУправления.НомерДоговора КАК Номер
						|ПОМЕСТИТЬ _ДанныеДоговора
						|ИЗ
						|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
						|ГДЕ
						|	СчетаДоверительногоУправления.Ссылка = &Договор";
					
					Запрос.Выполнить();
										
					ДанныеОрганизации	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеОрганизации"].ПолучитьДанные().Выгрузить();
					ДанныеДоговора		= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДоговора"].ПолучитьДанные().Выгрузить();
					
					КраткоеНаименование = РаботаСОтчетами.КраткоеНаименованиеСубъектаДляИмениФайла(
												Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Договор, ЭтотОбъект.Дата),
												Ложь);
												
					Если Не ПустаяСтрока(КраткоеНаименование) Тогда
						КраткоеНаименование = СокрЛП(КраткоеНаименование + " " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами"));
					Иначе
						КраткоеНаименование = ДанныеДоговора[0].Наименование;
					КонецЕсли;							
					
					ИмяАрхива = СтрШаблон("Отчетность по %1 (%2), %3 (%4)",
										КраткоеНаименование,
										СтрЗаменить(СтрЗаменить(ДанныеДоговора[0].Номер, "\", "_"), "/", "_"),
										ДанныеОрганизации[0].Наименование,
										Строка(Новый УникальныйИдентификатор));
					
					ПакетДанных.Вставить("ИмяАрхива", РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ИмяАрхива));
					
				КонецЕсли;
				
			Иначе
				
				Событие		= Перечисления.СобытияСОтчетами.СозданиеПисьма;
				ТекстОшибки	= "Не удалось создать электронное письмо! Отчет не будет отправлен почтой.";
				
				ПакетДанных = ПолучитьОбщиеДанныеПисьма(Договор, ДанныеПакета.АдресОтправителя, ДанныеПакета.ПредставлениеОтправителя, ДанныеПакета.АдресаПолучателей, ДанныеПакета.ОграничениеРазмера, ДанныеПакета.ТемаПисьма);
				
			КонецЕсли;
			
			ПакетДанных.Вставить("Файлы", Файлы);
			ПакетДанных.Вставить("КомментарийКОтменеОбработки", ДанныеПакета.КомментарийКОтменеОбработки);
			
			Попытка
				ПакетДанных = РаботаСПакетамиДанныхКОбработке.СоздатьПакетДанных(ВидПакетов, ПакетДанных);
			Исключение
				
				ОтменитьТранзакцию();
				
				ТехническаяИнформация = ОписаниеОшибки();
				
				ОбработатьОшибку(Справочники.Отчеты[ДанныеДляФиксации.ГруппаОтчетов],
								ДанныеДляФиксации.Отчет,
								ДанныеДляФиксации.Периодичность,
								ДанныеДляФиксации.Субъект,
								ДанныеДляФиксации.ОтчетнаяДата,
								ТекстОшибки,
								ТехническаяИнформация,
								ЭтотОбъект.АвтоматическийЗапуск);
				
				Продолжить;
				
			КонецПопытки;
			
			Для Каждого ФайлПакета Из ДанныеПакета.Файлы Цикл
				РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Событие, ФайлПакета.Экземпляр, ФайлПакета.ИдентификаторВерсии, ПакетДанных);
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			
			Для Каждого ДанныеДляФиксации Из ДанныеДляФиксацииОшибок Цикл
				ОбработатьОшибку(Справочники.Отчеты[ДанныеДляФиксации.ГруппаОтчетов],
								ДанныеДляФиксации.Отчет,
								ДанныеДляФиксации.Периодичность,
								ДанныеДляФиксации.Субъект,
								ДанныеДляФиксации.ОтчетнаяДата,
								ТекстОшибки,
								ТехническаяИнформация,
								ЭтотОбъект.АвтоматическийЗапуск);
			КонецЦикла;
									
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УчетЕПСГотов(Настройки)
	
	Результат = Истина;
	
	// Считаем, что учет ЕПС не готов, если не стоят даты запрета редактирования (партии + проводки).
	// В этом случае отчет не формируем и информируем об этом бухгалтерию.
	Если ЭтотОбъект.АвтоматическийЗапуск
		И Настройки.Свойство("ПроверкаГотовностиУчетаЕПС")
		И Настройки.ПроверкаГотовностиУчетаЕПС = Истина Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования) КАК ДатаЗапретаРедактирования
			|ИЗ
			|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
			|ГДЕ
			|	ДатыЗапретаРедактирования.Организация = &Организация
			|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ДатыЗапретаРедактирования.ГруппаЗапрета В (ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии), ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки))
			|	И ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
			|
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования) = 2";
		
		Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Настройки.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Период",							Настройки.Период.ДатаОкончания);
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			// При необходимости отправляем письмо о неготовности учета ЕПС
			Если Настройки.Свойство("АдресЭлектроннойПочтыБухгалтерии") И ЗначениеЗаполнено(Настройки.АдресЭлектроннойПочтыБухгалтерии) Тогда
				
				ДанныеПисьма = Новый Структура;
				
				ТемаПисьма	= СтрШаблон("Проверка готовности учета ЕПС для '%1' на %2", Настройки.СчетДоверительногоУправления, Формат(Настройки.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
				ТекстПисьма = СтрШаблон("<html>
										|	<body>
										|		<p>Автоматическое формирование отчета было прервано по причине неготовности учета ЕПС на %1 (не установлены даты запрета редактирования).</p>
										|		<table>
										|			<tr><td><b>Организация:</b></td><td>%2</tr>
										|			<tr><td><b>Договор:</b></td><td>%3</tr>
										|			<tr><td><b>Отчет:</b></td><td>%4</tr>
										|			<tr><td><b>Периодичность:</b></td><td>%5</tr>
										|			<tr><td><b>Отчетная дата:</b></td><td>%6</tr>
										|		</table>
										|	</body>
										|</html>",
										Формат(Настройки.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"),
										ЭтотОбъект.Организация,
										Настройки.СчетДоверительногоУправления,
										Настройки.Отчет,
										Настройки.Периодичность,
										Формат(Настройки.ОтчетнаяДата, "ДФ=dd.MM.yyyy"));
				
				ДанныеПисьма.Вставить("Тема",		ТемаПисьма);
				ДанныеПисьма.Вставить("Текст",		ТекстПисьма);
				ДанныеПисьма.Вставить("ТипТекста",	Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
				
				ДанныеПисьма.Вставить("Получатели", РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(Настройки.АдресЭлектроннойПочтыБухгалтерии));
				
				Попытка
					РаботаСПакетамиДанныхКОбработке.СоздатьПакетДанных(Перечисления.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо, ДанныеПисьма);
				Исключение
					РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Ошибка отправки письма о результатах проверки готовности учета ЕПС." + Символы.ПС + ОписаниеОшибки(), "Автоматическое формирование отчетности"); 
				КонецПопытки;
				
			КонецЕсли;
			
			Результат = Ложь;
			
		КонецЕсли;								
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОжиданиеСвободныхСеансов(РаботающиеСеансы, МаксимальноеКоличествоСеансов)
	
	ВсегоСеансов = РаботающиеСеансы.Количество();	
	
	Пока ВсегоСеансов >= МаксимальноеКоличествоСеансов Цикл
		
		Для Индекс = 1 - РаботающиеСеансы.Количество() По 0 Цикл
		
			Сеанс = РаботающиеСеансы[-Индекс].ОжидатьЗавершенияВыполнения(1);
			
			Если Сеанс.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				РаботающиеСеансы.Удалить(-Индекс);
				ВсегоСеансов = ВсегоСеансов - 1;
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 

	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбработатьОшибку(ГруппаОтчетов, Отчет, Периодичность, Субъект, ОтчетнаяДата, ОписаниеОшибки, 
	ТехническаяИнформация = "", РегистрироватьОшибкуРегламентногоЗадания = Ложь, ИмяОповещенияОбОтказе = Неопределено)
	
	ШаблонТекстаОшибки = "При обработке отчета %1 (%2) по %3 за %4 произошла ошибка:%5" + ?(ТехническаяИнформация = "", "", Символы.ПС + "Техническая информация: " + ТехническаяИнформация);
	
	Если ЭтотОбъект.АвтоматическийЗапуск Тогда
		
		ТекстОповещения = СтрШаблон("<html>
									|	<body>
									|		<p>При обработке отчета произошла ошибка!</p>
									|		<br>
									|		<table>
									|			<tr><td><b>Организация:</b></td><td>%1</tr>
									|			<tr><td><b>Договор:</b></td><td>%2</tr>
									|			<tr><td><b>Отчет:</b></td><td>%3</tr>
									|			<tr><td><b>Периодичность:</b></td><td>%4</tr>
									|			<tr><td><b>Отчетная дата:</b></td><td>%5</tr>
									|		</table>
									|		<br>
									|		<p><b>Описание ошибки:</b><br>%6</p>
									|		<br>
									|		<p><b>Техническая информация:</b><br>%7</p>
									|	</body>
									|</html>",
									ЭтотОбъект.Организация,
									Субъект,
									Отчет,
									Периодичность,
									Формат(ОтчетнаяДата, "ДФ=dd.MM.yyyy"),
									ОписаниеОшибки,
									?(ТехническаяИнформация = "", "<отсутствует>", ТехническаяИнформация));
		
		// Формируем оповещение
		РеквизитыОповещения = Новый Структура;
		
		РеквизитыОповещения.Вставить("Организация",		ЭтотОбъект.Организация);
		РеквизитыОповещения.Вставить("ГруппаОтчетов",	ГруппаОтчетов);
		РеквизитыОповещения.Вставить("Тема",			"Ошибка при автоматической обработке отчета");
		РеквизитыОповещения.Вставить("Текст",			ТекстОповещения);
		
		ИмяОповещения = ?(ИмяОповещенияОбОтказе = Неопределено, "ВнешняяОбработка._ФормированиеОтчетности.АвтоформированиеОтчетов", ИмяОповещенияОбОтказе);
		Справочники.Оповещения.СформироватьОповещения(ИмяОповещения, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
		// Регистрируем ошибку регламентного задания, если требуется
		Если РегистрироватьОшибкуРегламентногоЗадания Тогда
			
			ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, Отчет, Периодичность, Субъект, Формат(ОтчетнаяДата, "ДФ=dd.MM.yyyy"), Символы.ПС + ОписаниеОшибки);
			
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Автоматическое формирование отчетности");
			
		КонецЕсли;
		
	Иначе
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, Отчет, Периодичность, Субъект, Формат(ОтчетнаяДата, "ДФ=dd.MM.yyyy"), Символы.ПС + ОписаниеОшибки);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РазблокироватьЭкземпляр(Экземпляр)
	
	Попытка
		Экземпляр.Разблокировать();
	Исключение
		// Ну, не разблокировали и не разблокировали
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьПустуюТаблицуОтчетов()
	
	Результат = ЭтотОбъект.ТаблицаОтчетов.Выгрузить(Новый Массив());
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОбщиеДанныеПисьма(Договор, АдресОтправителя, ПредставлениеОтправителя, Получатели, МаксимальныйРазмерПисьма, Тема = "")
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация",						ЭтотОбъект.Организация);
	Результат.Вставить("МаксимальныйСуммарныйРазмерФайлов",	МаксимальныйРазмерПисьма);
	Результат.Вставить("АдресОтправителя",					АдресОтправителя);
	Результат.Вставить("ПредставлениеОтправителя",			ПредставлениеОтправителя);
	Результат.Вставить("ПолучателиСлепыхКопий",				Новый Массив);
	Результат.Вставить("ОбратныеАдреса",					Новый Массив);
	
	Результат.ПолучателиСлепыхКопий.Добавить(Новый Структура("Адрес, Представление", АдресОтправителя, ПредставлениеОтправителя));
	Результат.ОбратныеАдреса.Добавить(Новый Структура("Адрес, Представление", АдресОтправителя, ПредставлениеОтправителя));
	
	Попытка
		МассивАдресовПолучателей = РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(НРег(Получатели));
		РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивАдресовПолучателей);
	Исключение
		ВызватьИсключение СтрШаблон("Некорректный список адресов получателей письма: ""%1""", Получатели);
	КонецПопытки;
	
	// Получатели
	Результат.Вставить("Получатели", Новый Массив);
	
	Для Каждого Получатель Из МассивАдресовПолучателей Цикл
		
		НовыйПолучатель = Новый Структура;
		
		НовыйПолучатель.Вставить("Адрес",			Получатель.Адрес);
		НовыйПолучатель.Вставить("Представление",	Получатель.Представление);
		
		Результат.Получатели.Добавить(НовыйПолучатель);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекущаяДата",	ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК Наименование
		|ПОМЕСТИТЬ _ДанныеОбОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ТекущаяДата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК АдресДляБухгалтерии
		|ПОМЕСТИТЬ _АдресОтправителяДляБухгалтерскихОтчетов
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&ТекущаяДата,
		|			Организация = &Организация
		|				И Настройка.Код = ""АдресОтправителя""
		|				И Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.Бухгалтерия)
		|				И Субъект = НЕОПРЕДЕЛЕНО
		|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				И Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";
	
	Запрос.Выполнить();
	
	ДанныеОбАдресеОтправителя	= Запрос.МенеджерВременныхТаблиц.Таблицы["_АдресОтправителяДляБухгалтерскихОтчетов"].ПолучитьДанные().Выгрузить();
	ДанныеОбОрганизации			= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеОбОрганизации"].ПолучитьДанные().Выгрузить();
	
	Если ДанныеОбОрганизации.Количество() > 0 Тогда
		НомерТелефона = " " + ДанныеОбОрганизации[0].Телефоны;
	Иначе
		НомерТелефона = "";			
	КонецЕсли;
	
	// Если настройка заполнена верно - берем ее значение, если нет - считаем значение пустым.
	АдресДляБухгалтерии = "";
	
	Если ДанныеОбАдресеОтправителя.Количество() > 0 Тогда
		
		МассивАдресов = РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(ДанныеОбАдресеОтправителя[0].АдресДляБухгалтерии);
		
		Если МассивАдресов.Количество() = 1 Тогда
			
			Если ЗначениеЗаполнено(МассивАдресов[0].Адрес) Тогда
				АдресДляБухгалтерии = МассивАдресов[0].Адрес;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("Тема", ?(ПустаяСтрока(Тема), СтрШаблон("Отчетность по %1 (№'%2'), %3", Договор, Договор.НомерДоговора, ДанныеОбОрганизации[0].Наименование), Тема));
	
	Текст = 
		"<HTML><HEAD>
		|<BODY>
		|<P>Добрый день.</P>
		|<P>Данное письмо было отправлено Вам автоматически.</P>
		|<P>Для получения информации по возникшим вопросам Вам необходимо связаться с сотрудниками Управляющей компании по телефону" + НомерТелефона + " или отправить сообщение по адресу <a href=""mailto:" + Результат.АдресОтправителя + """>" + Результат.АдресОтправителя + "</a></P>
		|</BODY></HTML>";
	
	Результат.Вставить("Текст",		Текст);
	Результат.Вставить("ТипТекста",	Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
	
	Если Результат.АдресОтправителя = АдресДляБухгалтерии Тогда
		
		Результат.Вставить("УведомитьОПрочтении",				Истина);
		Результат.Вставить("ПолучателиУведомленияОПрочтении",	Новый Массив);
		
		Результат.ПолучателиУведомленияОПрочтении.Добавить(Новый Структура("Адрес, Представление", Результат.АдресОтправителя));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

