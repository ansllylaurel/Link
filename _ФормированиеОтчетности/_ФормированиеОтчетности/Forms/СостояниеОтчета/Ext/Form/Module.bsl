
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры,, "ЗакрыватьПриВыборе, ЗакрыватьПриЗакрытииВладельца, КлючНазначенияИспользования, ТолькоПросмотр");
	
	Период = Новый СтандартныйПериод(Параметры.ДатаНачала, Параметры.ДатаОкончания);
	
	// Создаем группу основных настроек
	ОсновныеНастройки = ЗначенияНастроек.ПолучитьЭлементы().Добавить();
	
	ОсновныеНастройки.Наименование	= "Основные";
	
	// Создаем группу настроек отправки почтой
	НастройкиПочты = ЗначенияНастроек.ПолучитьЭлементы().Добавить();
	
	НастройкиПочты.Наименование	= "Настройки почты";
	
	// Создаем группу настроек выгрузки в ЭДО
	НастройкиЭДО = ЗначенияНастроек.ПолучитьЭлементы().Добавить();
	
	НастройкиЭДО.Наименование	= "Настройки ЭДО";
	
	// Создаем группу прочих настроек
	ПрочиеНастройки = ЗначенияНастроек.ПолучитьЭлементы().Добавить();
	
	ПрочиеНастройки.Наименование	= "Прочие";
	
	Настройки = ПолучитьИзВременногоХранилища(Параметры.АдресНастроек);
	
	РучнаяЗагрузкаФайловВЭДО = Ложь;
		
	Для Каждого Настройка Из Настройки Цикл
		
		Если Настройка.КодНастройки = "РучнаяЗагрузкаФайловВЭДО" Тогда
			РучнаяЗагрузкаФайловВЭДО = Настройка.Значение;	
		КонецЕсли;
		
		Если Настройка.КодНастройки = "АвтоматическаяВыгрузкаВЭДО"
			ИЛИ Настройка.КодНастройки = "АвтоматическаяОтправка"
			ИЛИ Настройка.КодНастройки = "ВариантПолученияКонечнойДатыПриЕженедФормировании"
			ИЛИ Настройка.КодНастройки = "ВариантОпределенияНачальнойДаты"
			ИЛИ Настройка.КодНастройки = "ВремяФормирования"
			ИЛИ Настройка.КодНастройки = "ИмяФайла"
			ИЛИ Настройка.КодНастройки = "СрокФормирования" Тогда
			Коллекция = ОсновныеНастройки;
		ИначеЕсли Настройка.КодНастройки = "АдресОтправителя"
			ИЛИ Настройка.КодНастройки = "АдресЭлектроннойПочты"
			ИЛИ Настройка.КодНастройки = "АдресЭлектроннойПочтыБухгалтерии"
			ИЛИ Настройка.КодНастройки = "АдресЭлектроннойПочтыБэкОфиса"
			ИЛИ Настройка.КодНастройки = "МаксимальныйСуммарныйРазмерфайловПисьма"
			ИЛИ Настройка.КодНастройки = "ОтправлятьОтчетВСоставеПакета" Тогда
			Коллекция = НастройкиПочты;
		ИначеЕсли Настройка.КодНастройки = "ВыгружатьОтчетВСоставеПакета" 
			ИЛИ Настройка.КодНастройки = "КаталогФайловДляОтправкиПоЭДО"
			ИЛИ Настройка.КодНастройки = "КаталогФайловСОшибкойОтправкиПоЭДО"
			ИЛИ Настройка.КодНастройки = "МаксимальныйРазмерФайлаДляВыгрузкиВЭДО"
			ИЛИ Настройка.КодНастройки = "РучнаяЗагрузкаФайловВЭДО" Тогда
			Коллекция = НастройкиЭДО;
		Иначе
			Коллекция = ПрочиеНастройки;
		КонецЕсли;
		
		НоваяСтрока = Коллекция.ПолучитьЭлементы().Добавить();
		
		НоваяСтрока.Наименование	= Строка(Настройка.Настройка);
		НоваяСтрока.Настройка		= Настройка.Настройка;
		НоваяСтрока.Значение		= Настройка.Значение;
		НоваяСтрока.ДатаЗначения	= Настройка.ДатаЗначения;
		НоваяСтрока.Приоритет		= Настройка.Приоритет;
		НоваяСтрока.ОшибкаВЗначении	= Настройка.ОшибкаВЗначении;
		НоваяСтрока.КодНастройки	= Настройка.КодНастройки;
		НоваяСтрока.Уровень			= 1;
		
	КонецЦикла;
	
	Элементы.ЗапретОбработки.Видимость					= ЗапретОбработки;
	Элементы.СтатусВыгрузки.Видимость					= СтатусВыгрузки > 0;
	Элементы.СтатусОтправки.Видимость					= СтатусОтправки > 0;
	Элементы.РегламентированныйОтчет.Видимость			= Регламентированный;
	Элементы.СтатусРегламентированногоОтчета.Видимость	= Регламентированный;
	
	РучнаяЗагрузкаФайловВЭДО = ?(РучнаяЗагрузкаФайловВЭДО = Неопределено, Ложь, РучнаяЗагрузкаФайловВЭДО);
	События.Загрузить(РаботаСОтчетами.ПолучитьСобытияСОтчетом(Экземпляр, РучнаяЗагрузкаФайловВЭДО));
		
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ЗначенияНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаНастроек = ЗначенияНастроек.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если СтрокаНастроек.Уровень = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	
	Если Поле.Имя = "ЗначенияНастроекНастройка" Тогда
		ВыбранноеЗначение = СтрокаНастроек.Настройка;
	ИначеЕсли Поле.Имя = "ЗначенияНастроекЗначение" Тогда
		
		ВыбранноеЗначение = СтрокаНастроек.Значение;
		
		Если СтрокаНастроек.КодНастройки = "ВремяФормирования" Тогда
			ВыбранноеЗначение = Формат(ВыбранноеЗначение, "ДФ=HH:mm; ДП=<отсутствует>");
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОткрытьЗначение(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СобытияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаСобытия = События.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если СтрокаСобытия.КодСобытия >= 3 И СтрокаСобытия.КодСобытия <= 6 Тогда
		
		// Получаем версию из хранилища
		Попытка
			ДанныеВерсии = ПолучитьДанныеВерсии(ВыбраннаяСтрока);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось открыть версию отчета из-за ошибки: %1", ОписаниеОшибки()));
			Возврат;
		КонецПопытки;
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось открыть версию из-за ошибки при получении данных из временного хранилища!");
			Возврат;
		КонецПопытки;
		
		Попытка
			УдалитьИзВременногоХранилища(ДанныеВерсии.Адрес);
		Исключение
			// Ну, не удалили и не удалили
		КонецПопытки;
		
		// Сохраняем версию во временный файл
		ИмяФайла = СтрШаблон("%1%2\%3",
							ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов(),
							Строка(Новый УникальныйИдентификатор),
							ДанныеВерсии.ИмяПриСохранении);
		
		Попытка
			ДвоичныеДанные.Записать(ИмяФайла);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось открыть версию из-за ошибки при сохранении временного файла!");
			Возврат;
		КонецПопытки;
		
		// Открываем файл
		ЗапуститьПриложение(ИмяФайла);
		
	ИначеЕсли СтрокаСобытия.КодСобытия >= 7 И СтрокаСобытия.КодСобытия <= 17 Тогда
		ОткрытьЗначение(СтрокаСобытия.ПакетДанных);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ПолучитьДанныеВерсии(Идентификатор)
	
	Событие = События.НайтиПоИдентификатору(Идентификатор);
	
	Попытка
		ДанныеВерсии = РаботаСФайловымХранилищем.ПолучитьВерсиюФайла(Событие.ИдентификаторВерсии);
	Исключение
		ВызватьИсключение "Не удалось получить данные версии отчета из файлового хранилища!";
	КонецПопытки;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяПриСохранении",	Событие.ИмяПриСохранении);
	Результат.Вставить("Адрес",				ДанныеВерсии.Адрес);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти