&НаСервере
Функция ЗагрузитьИзФайлаНаСервере(Адрес, РасширениеВыбранногоФайла)
		
	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось получить данные файла из временного хранилища из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Возврат Ложь;
		
	КонецПопытки;
	
	РазмерФайла = ДвоичныеДанные.Размер() / 1048576;
	
	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		// Ну, не удалили и не удалили
	КонецПопытки;
	
	КонтрольнаяСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанные);
	
	Попытка
		АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось поместить данные файла во временное хранилище из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Возврат Ложь;
		
	КонецПопытки;
	
	ДанныеЭкземпляров = ПолучитьОбъектыЭкземпляровОтчетовНаСервере(Элементы.ТаблицаОтчетов.ВыделенныеСтроки);
	
	Если ДанныеЭкземпляров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеЭкземпляра = ДанныеЭкземпляров[0];
	
	СтрокаТаблицы	= Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеЭкземпляров[0].ИдентификаторСтроки))[0];
	Экземпляр		= ДанныеЭкземпляров[0].Объект;
	
	НачатьТранзакцию();
	
	Если НЕ ЗначениеЗаполнено(Экземпляр.ИдентификаторФайла) Тогда
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИмяФайла) Тогда
			
			ТекстОшибки = СтрШаблон("Не заполнено значение настройки 'Имя файла'! Загрузка файла отменена.");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Экземпляр.Разблокировать();
			
			ОтменитьТранзакцию();
			
			Возврат Ложь;
			
		КонецЕсли;
			
		Файл = Новый Файл(СтрокаТаблицы.ИмяФайла);
		
		// Создаем новый файл
		ПараметрыФайла = Новый Структура;
		
		ПараметрыФайла.Вставить("Адрес",					АдресДвоичныхДанных);
		ПараметрыФайла.Вставить("Имя",						Файл.ИмяБезРасширения);
		ПараметрыФайла.Вставить("Расширение",				СтрЗаменить(РасширениеВыбранногоФайла, ".", ""));
		ПараметрыФайла.Вставить("Экземпляр",				Экземпляр.Ссылка);
		ПараметрыФайла.Вставить("НаименованиеВладельца",	Строка(СтрокаТаблицы.Субъект));
		ПараметрыФайла.Вставить("ИдентификаторВладельца",	Строка(СтрокаТаблицы.Субъект.УникальныйИдентификатор()));
		ПараметрыФайла.Вставить("ТипВладельца",				"Клиентские отчеты");
		
		Попытка
			ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, Объект.Организация, Истина);
		Исключение
			
			Экземпляр.Разблокировать();
			
			ТекстОшибки = СтрШаблон("Не удалось сохранить файл в файловом хранилище из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			ОтменитьТранзакцию();
			
			Возврат Ложь;
			
		КонецПопытки;
		
		Экземпляр.ИдентификаторФайла = ДанныеВерсии.ИдентификаторФайла;
		
		СтрокаТаблицы.ИдентификаторВерсии = ДанныеВерсии.ИдентификаторВерсии;
		
		НоваяВерсия = Экземпляр.ВерсииОтчетов.Добавить();
		
		НоваяВерсия.ИдентификаторВерсии	= ДанныеВерсии.ИдентификаторВерсии;
		НоваяВерсия.КонтрольнаяСумма	= КонтрольнаяСумма;
		НоваяВерсия.ИмяПриСохранении	= СтрокаТаблицы.ИмяФайла;
		НоваяВерсия.Окончательная		= Ложь;
		НоваяВерсия.Актуальная			= Истина;
		НоваяВерсия.Размер				= РазмерФайла;
		
		РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.ЗагрузкаВерсииИзФайла, Экземпляр.Ссылка, ДанныеВерсии.ИдентификаторВерсии);
		
	Иначе
		
		АктуальнаяВерсия = Экземпляр.ВерсииОтчетов.НайтиСтроки(Новый Структура("Актуальная", Истина))[0];
		
		Если АктуальнаяВерсия.КонтрольнаяСумма <> КонтрольнаяСумма Тогда
			
			АктуальнаяВерсия.Актуальная = Ложь;
			Файл = Новый Файл(СтрокаТаблицы.ИмяФайла);
			Расширение = СтрЗаменить(РасширениеВыбранногоФайла, ".", "");
			ИмяФайла = Файл.ИмяБезРасширения;
			
			Попытка
				ИдентификаторВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(Экземпляр.ИдентификаторФайла, АдресДвоичныхДанных, Расширение, Истина, Экземпляр.Ссылка, ИмяФайла);
			Исключение
				
				Экземпляр.Разблокировать();
				
				ТекстОшибки = СтрШаблон("Не удалось обновить версию отчета в файловом хранилище из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				ОтменитьТранзакцию();
				
				Возврат Ложь;
				
			КонецПопытки;
			
			СтрокаТаблицы.ИдентификаторВерсии = ИдентификаторВерсии;
			
			НоваяВерсия = Экземпляр.ВерсииОтчетов.Добавить();
			
			НоваяВерсия.ИдентификаторВерсии	= ИдентификаторВерсии;
			НоваяВерсия.КонтрольнаяСумма	= КонтрольнаяСумма;
			НоваяВерсия.ИмяПриСохранении	= СтрокаТаблицы.ИмяФайла;
			НоваяВерсия.Окончательная		= Ложь;
			НоваяВерсия.Актуальная			= Истина;
			НоваяВерсия.Размер				= РазмерФайла;
			
			РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.ЗагрузкаВерсииИзФайла, Экземпляр.Ссылка, ИдентификаторВерсии);
			
		Иначе
			
			Экземпляр.Разблокировать();
			
			ТекстОшибки = СтрШаблон("Данные загружаемого файла идентичны с данными последней версии отчета! Загрузка отменена.");
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			ОтменитьТранзакцию();
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Сохраняем экземпляр
	УспешнаяЗапись = Истина;
	
	Попытка
		Экземпляр.Записать();
	Исключение
		
		ТекстОшибки = СтрШаблон("Загрузка отменена! Не удалось сохранить сведения о загрузке новой версии из-за ошибки:%1", Символы.ПС + ОписаниеОшибки());
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		УспешнаяЗапись = Ложь;
		
	КонецПопытки;
	
	Если УспешнаяЗапись Тогда
		
		ЗафиксироватьТранзакцию();
		
		СтрокаТаблицы.ОбработкаЗавершена	= Ложь;
		СтрокаТаблицы.ВерсияДанных			= Экземпляр.Ссылка.ВерсияДанных;
		СтрокаТаблицы.СтатусВерсии			= 1;
		СтрокаТаблицы.Сформировать			= Истина;
		СтрокаТаблицы.СтатусВыгрузки		= ?(СтрокаТаблицы.ВыгружаетсяВЭДО, 1, 0);
		СтрокаТаблицы.Выгрузить				= НЕ СтрокаТаблицы.ЗапретОбработки И СтрокаТаблицы.ВыгружаетсяВЭДО;
		СтрокаТаблицы.Выгрузка				= Неопределено;
		СтрокаТаблицы.СтатусОтправки		= ?(СтрокаТаблицы.ОтправляетсяПочтой, 1, 0);
		СтрокаТаблицы.Отправить				= НЕ СтрокаТаблицы.ЗапретОбработки И СтрокаТаблицы.ОтправляетсяПочтой;
		СтрокаТаблицы.Письмо				= Неопределено;
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
	Экземпляр.Разблокировать();
	
	Возврат УспешнаяЗапись;
	
КонецФункции

&НаСервере
Функция СформироватьДляПросмотраНаСервере()
	
	РезультатыОтчетов = Новый Массив;
	
	ВыделенныеСтроки = Элементы.ТаблицаОтчетов.ВыделенныеСтроки;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		// Получаем строку ТЧ по идентификатору
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Настройки = РеквизитФормыВЗначение("Объект").ПолучитьСтруктуруНастроек(СтрокаТаблицы, Ложь);
		
		// Для регламентированных отчетов дополняем структуру настроек
		Если СтрокаТаблицы.Регламентированный Тогда
			Настройки.Вставить("РегламентированныйОтчет", СтрокаТаблицы.РегламентированныйОтчет);
		КонецЕсли;
		
		// Выполняем формирование отчета
		Попытка
			Справочники.Отчеты.ВыполнитьАвтоматическоеФормирование(Настройки.КлючОтчета, Настройки);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет сформирован из-за ошибки:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Если НЕ Настройки.Свойство("Результат") Тогда
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не обработан т.к. отсутствует результат отчета!",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецЕсли;
		
		Представление = СтрШаблон("%1 (%2) по %3 за %4",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
									
		ДанныеРезультата = Новый Структура;
		
		ДанныеРезультата.Вставить("Идентификатор",	СтрокаТаблицы.ПолучитьИдентификатор());
		ДанныеРезультата.Вставить("Представление",	Представление);
		ДанныеРезультата.Вставить("Результат",		Настройки.Результат);
		
		РезультатыОтчетов.Добавить(ДанныеРезультата);
		
	КонецЦикла;
	
	Возврат РезультатыОтчетов;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФормыРегламентированногоОтчетаНаСервере(ИдентификаторыСтрок)
	
	Результат = Новый Соответствие;
	
	// Чтобы не искать потом опять в таблице
	СтрокиТаблицы = Новый Соответствие;
	// Для получения актуального состояния отчетов
	Список = Новый Массив;
	
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки))[0];
		
		СтрокиТаблицы.Вставить(ИдентификаторСтроки, СтрокаТаблицы);
		
		Список.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	// Получаем актуальные состояния отчетов
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(Список));
	
	// Проверим, не изменились ли данные по регламентированным отчетам
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		Если НЕ СостояниеОтчета.Регламентированный
			ИЛИ ЗначениеЗаполнено(СостояниеОтчета.РегламентированныйОтчет)
			ИЛИ ЗначениеЗаполнено(СостояниеОтчета.СтатусРегламентированногоОтчета) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		
		СтрокаТаблицы = СтрокиТаблицы.Получить(ИдентификаторСтроки);
		
		ЗначенияНастроекОтчета = РеквизитФормыВЗначение("Объект").ПолучитьСтруктуруНастроек(СтрокаТаблицы, Ложь);
		
		// Добавляем в структуру настроек необходимые для формирования регламентированного отчета параметры
		ЗначенияНастроекОтчета.Вставить("РегламентированныйОтчет", Неопределено);
		
		СтруктураДействий = Новый Структура;		
	
		СтруктураДействий.Вставить("ОткрытьФорму", 			Ложь);
		СтруктураДействий.Вставить("ОткрытьИПерезаполнить",	Ложь);
		СтруктураДействий.Вставить("Перезаполнить",			Ложь);
		
		ЗначенияНастроекОтчета.Вставить("СтруктураДействий", СтруктураДействий);
		
		ПараметрыФормыРегламентированногоОтчета = Справочники.Отчеты.ПолучитьПараметрыФормыОтчета(СтрокаТаблицы.КлючОтчета, Новый Структура("НастройкиОтчета", ЗначенияНастроекОтчета));
		
		Результат.Вставить(ИдентификаторСтроки, ПараметрыФормыРегламентированногоОтчета);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьСтатусРегламентированногоОтчетаНаСервере(СтатусРегламентированногоОтчета)
	
	// Чтобы потом не искать в таблице
	ИдентификаторыСтрок = Новый Соответствие;
	// Для получения актуального состояния отчетов
	СписокСтрок = Новый Массив;
	
	Для Каждого Идентификатор Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор);
		
		СписокСтрок.Добавить(СтрокаТаблицы);
		
		ИдентификаторыСтрок.Вставить(СтрокаТаблицы.ИдентификаторСтроки, СтрокаТаблицы);
		
	КонецЦикла;
	
	// Получаем актуальные состояния отчетов
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(СписокСтрок));
	
	// Проверим, не изменились ли данные по регламентированным отчетам
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		СтрокаТаблицы = ИдентификаторыСтрок.Получить(СостояниеОтчета.ИдентификаторСтроки);
		
		Если ЗначениеЗаполнено(СостояниеОтчета.РегламентированныйОтчет) <> ЗначениеЗаполнено(СтрокаТаблицы.РегламентированныйОтчет)
			ИЛИ ЗначениеЗаполнено(СостояниеОтчета.РегламентированныйОтчет)
				И (СостояниеОтчета.РегламентированныйОтчет <> СтрокаТаблицы.РегламентированныйОтчет
					ИЛИ СостояниеОтчета.СтатусРегламентированногоОтчета <> СтрокаТаблицы.СтатусРегламентированногоОтчета) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из СписокСтрок Цикл
		
		Попытка
			РаботаСОтчетами.УстановитьСтатусРегламентированногоОтчета(СтрокаТаблицы.РегламентированныйОтчет, СтатусРегламентированногоОтчета);
		Исключение
			
			ТекстСообщения = СтрШаблон("Не удалось установить статус '%1' регламентированного отчета для %2 (%3) по %4 за %5 из-за ошибки:%6",
										СтатусРегламентированногоОтчета,
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
			
		КонецПопытки;
		
		СтрокаТаблицы.СтатусРегламентированногоОтчета = СтатусРегламентированногоОтчета;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьСортировкуНаСервере()
	
	ПоляСортировки = Новый Массив;
	
	Для Каждого Строка Из Сортировка Цикл
		Если ЗначениеЗаполнено(Строка.Поле) Тогда
			ПоляСортировки.Добавить(Строка.Поле + ?(Строка.Порядок, " УБЫВ", ""));
		КонецЕсли;
	КонецЦикла;		
	
	Если ПоляСортировки.Количество() = 0 Тогда
		ПоляСортировки.Добавить("ИсходныйПорядковыйНомерСтроки");		
	КонецЕсли;
	
	Объект.ТаблицаОтчетов.Сортировать(СтрСоединить(ПоляСортировки, ", "), Новый СравнениеЗначений);
	
КонецПроцедуры

&НаСервере
Процедура ФайлЗагруженВЭДОВручнуюНаСервере()
	
	Список = Новый Массив;
	
	Для Каждого Идентификатор Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		Список.Добавить(Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор));
	КонецЦикла;
	
	// Получаем актуальные состояния отчетов
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(Список));
	
	// Контролируем актуальность таблицы
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СостояниеОтчета.ИдентификаторСтроки))[0];
		
		Если ЗначениеЗаполнено(СостояниеОтчета.Экземпляр) И СостояниеОтчета.Экземпляр <> СтрокаТаблицы.Экземпляр
			ИЛИ СостояниеОтчета.ВерсияДанных <> СтрокаТаблицы.ВерсияДанных
			ИЛИ СостояниеОтчета.СтатусВыгрузки <> СтрокаТаблицы.СтатусВыгрузки Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Идентификатор Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор);
		
		Попытка
			РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.РучнаяЗагрузкаВЭДО, СтрокаТаблицы.Экземпляр, СтрокаТаблицы.ИдентификаторВерсии, СтрокаТаблицы.Выгрузка);
		Исключение
			
			ТекстСообщения = СтрШаблон("Не зафиксировать ручную загрузку в ЭДО для %1 (%2) по %3 за %4 из-за ошибки:%6",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
			
		КонецПопытки;
		
		СтрокаТаблицы.СтатусВыгрузки = 4;
		
	КонецЦикла;
	
КонецПроцедуры

