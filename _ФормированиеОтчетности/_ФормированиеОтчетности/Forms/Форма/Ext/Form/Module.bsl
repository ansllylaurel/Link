#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;	
	
	Элементы.ТаблицаОтчетовСтатусРегламентированногоОтчета.Видимость = ДанныеОбъекта.ГруппаОтчетов = Форма.ГруппаОтчетовБухгалтерия;
	
	Элементы.ТаблицаОтчетов.ТолькоПросмотр	= НЕ Форма.ИзмененияКлючевыхПолейПрименены;
	Элементы.ВыполнитьОбработку.Доступность	= Форма.ИзмененияКлючевыхПолейПрименены;
	Элементы.ДекорацияОбновление.Видимость	= НЕ Форма.ИзмененияКлючевыхПолейПрименены;

	Элементы.Период.Видимость 			= Не ДанныеОбъекта.УчитыватьСрокФормирования И Форма.УказатьПериод;
	Элементы.Дата.Видимость				= ДанныеОбъекта.УчитыватьСрокФормирования Или Не Форма.УказатьПериод;
		
КонецПроцедуры // НастроитьВидимостьДоступность

#Область Клиентские

&НаКлиенте
Процедура ОбновитьКонтекстноеМеню()
	
	УстановитьВидимостьИДоступностьКомандКонтекстногоМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеФлагаДляВсех(Флаг, Значение)
	
	Для Каждого Строка Из Объект.ТаблицаОтчетов Цикл
		УстановитьЗначениеФлагаДляСтроки(Строка, Флаг, Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеФлага(Флаг, Значение)
	
	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		УстановитьЗначениеФлагаДляСтроки(Объект.ТаблицаОтчетов.НайтиПоИдентификатору(ИдентификаторСтроки), Флаг, Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеФлагаДляСтроки(Строка, Флаг, Значение)
	
	Если Значение = Истина
		И (Флаг = "Выгрузить" ИЛИ Флаг = "Отправить")
		И Строка.СтатусВерсии < 1 И НЕ Строка.Сформировать Тогда
		Возврат;
	КонецЕсли;
	
	Строка[Флаг] = Значение;
	
	Если Флаг = "Сформировать" Тогда
		ПривестиВыгрузкуИОтправкуВСоотстветствиеСоСтатусомВерсии(Строка)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеФлажкиТекущейТаблицы(Флажок)

	ТекущаяТаблицаФормы = Объект.ТаблицаОтчетов;
	
	Для каждого Элемент Из ТекущаяТаблицаФормы Цикл
		Элемент.Флажок = Флажок;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьИДоступностьКомандКонтекстногоМеню()
	
	Если НЕ ИзмененияКлючевыхПолейПрименены Тогда
		
		Элементы.ТаблицаОтчетовКонтекстноеМеню.Видимость = Ложь;
		
		Возврат;
		
	Иначе
		Элементы.ТаблицаОтчетовКонтекстноеМеню.Видимость = Истина;
	КонецЕсли;
	
	ИдентификаторыСтрок = Элементы.ТаблицаОтчетов.ВыделенныеСтроки;
	
	СтрокВсего							= ИдентификаторыСтрок.Количество();
	СтрокСЗапретомОбработки				= 0;
	СтрокСВерсией						= 0;
	СтрокСОкончательнойВерсией			= 0;
	СтрокРегламентированныхОтчетов		= 0;
	СтрокБезРегламентированногоОтчета	= 0;
	СтрокСЧерновиками					= 0;
	СтрокСГотовыми						= 0;
	СтрокСРучнойЗагрузкойВЭДО			= 0;
	СтрокДляОтменыРучнойЗагрузкиВЭДО	= 0;
	
	Для Каждого Идентификатор Из ИдентификаторыСтрок Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор);
		
		Если СтрокаТаблицы.ЗапретОбработки Тогда
			СтрокСЗапретомОбработки = СтрокСЗапретомОбработки + 1;
		КонецЕсли;
		
		Если СтрокаТаблицы.СтатусВерсии > 0 Тогда
			СтрокСВерсией = СтрокСВерсией + 1;
		КонецЕсли;
		
		Если СтрокаТаблицы.СтатусВерсии = 2 Тогда
			СтрокСОкончательнойВерсией = СтрокСОкончательнойВерсией + 1;
		КонецЕсли;
		
		Если СтрокаТаблицы.СтатусВыгрузки = 5 Тогда
			СтрокСРучнойЗагрузкойВЭДО = СтрокСРучнойЗагрузкойВЭДО + 1;
		ИначеЕсли СтрокаТаблицы.СтатусВыгрузки = 4 И СтрокаТаблицы.РучнаяЗагрузкаФайловВЭДО Тогда
			СтрокДляОтменыРучнойЗагрузкиВЭДО = СтрокДляОтменыРучнойЗагрузкиВЭДО + 1;
		КонецЕсли;
		
		Если СтрокаТаблицы.Регламентированный Тогда
			
			СтрокРегламентированныхОтчетов = СтрокРегламентированныхОтчетов + 1;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.РегламентированныйОтчет) Тогда
				СтрокБезРегламентированногоОтчета = СтрокБезРегламентированногоОтчета + 1;
			ИначеЕсли СтрокаТаблицы.СтатусРегламентированногоОтчета = "Черновик" Тогда
				СтрокСЧерновиками = СтрокСЧерновиками + 1;
			ИначеЕсли СтрокаТаблицы.СтатусРегламентированногоОтчета = "Готов"
				ИЛИ СтрокаТаблицы.СтатусРегламентированногоОтчета = "Отправлен"
				ИЛИ СтрокаТаблицы.СтатусРегламентированногоОтчета = "Корректировка" Тогда
				СтрокСГотовыми = СтрокСГотовыми + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Устанавливаем видимость
	Элементы.ТаблицаОтчетовКонтекстноеМенюЗапретитьОбработку.Видимость										= СтрокВсего > 0 И СтрокСЗапретомОбработки < СтрокВсего;
	Элементы.ТаблицаОтчетовКонтекстноеМенюРазрешитьОбработку.Видимость										= СтрокВсего > 0 И СтрокСЗапретомОбработки > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюСделатьВерсиюОкончательной.Видимость								= СтрокВсего > 0 И СтрокСОкончательнойВерсией < СтрокСВерсией;
	Элементы.ТаблицаОтчетовКотекстноеМенюСделатьВерсиюПредварительной.Видимость								= СтрокВсего > 0 И СтрокСОкончательнойВерсией > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюОткрытьОтчет.Видимость											= СтрокВсего > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюВыгрузитьВКаталог.Видимость										= СтрокВсего > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюЗагрузитьИзФайла.Видимость										= СтрокВсего = 1;
	Элементы.ТаблицаОтчетовКонтекстноеМенюСоздатьЧерновикРегламентированногоОтчета.Видимость				= СтрокРегламентированныхОтчетов > 0 И СтрокБезРегламентированногоОтчета > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюУстановитьДляРегламентированногоОтчетаСтатусГотов.Видимость		= СтрокРегламентированныхОтчетов > 0 И СтрокСЧерновиками > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюУстановитьДляРегламентированногоОтчетаСтатусЧерновик.Видимость	= СтрокРегламентированныхОтчетов > 0 И СтрокСГотовыми > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюСформироватьДляПросмотра.Видимость								= СтрокВсего > 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюФайлЗагруженВЭДОВручную.Видимость									= СтрокВсего > 0 И СтрокСРучнойЗагрузкойВЭДО = СтрокВсего;
	Элементы.ТаблицаОтчетовКонтекстноеМенюОтменитьЗагрузкуВЭДОВручную.Видимость								= СтрокВсего > 0 И СтрокДляОтменыРучнойЗагрузкиВЭДО = СтрокВсего;
	Элементы.ТаблицаОтчетовКонтекстноеМенюОтправитьПочтой.Видимость											= СтрокВсего > 0 И СтрокСВерсией > 0 И СтрокВсего = СтрокСВерсией;
	Элементы.ТаблицаОтчетовКонтекстноеМенюПечать.Видимость													= СтрокВсего > 0 И СтрокСВерсией > 0 И СтрокВсего = СтрокСВерсией;
	
	// Устанавливаем доступность
	Элементы.ТаблицаОтчетовКонтекстноеМенюЗапретитьОбработку.Доступность									= СтрокСЗапретомОбработки = 0;
	Элементы.ТаблицаОтчетовКонтекстноеМенюРазрешитьОбработку.Доступность									= СтрокСЗапретомОбработки = СтрокВсего;
	Элементы.ТаблицаОтчетовКонтекстноеМенюСделатьВерсиюОкончательной.Доступность							= СтрокСОкончательнойВерсией = 0;
	Элементы.ТаблицаОтчетовКотекстноеМенюСделатьВерсиюПредварительной.Доступность							= СтрокСОкончательнойВерсией = СтрокВсего;
	Элементы.ТаблицаОтчетовКонтекстноеМенюСоздатьЧерновикРегламентированногоОтчета.Доступность				= СтрокРегламентированныхОтчетов = СтрокБезРегламентированногоОтчета;
	Элементы.ТаблицаОтчетовКонтекстноеМенюУстановитьДляРегламентированногоОтчетаСтатусГотов.Доступность		= СтрокРегламентированныхОтчетов = СтрокСЧерновиками;
	Элементы.ТаблицаОтчетовКонтекстноеМенюУстановитьДляРегламентированногоОтчетаСтатусЧерновик.Доступность	= СтрокРегламентированныхОтчетов = СтрокСГотовыми;
	
КонецПроцедуры

&НаКлиенте
Процедура ПривестиВыгрузкуИОтправкуВСоотстветствиеСоСтатусомВерсии(СтрокаТаблицыОтчетов)
	
	Если НЕ СтрокаТаблицыОтчетов.Сформировать
		И СтрокаТаблицыОтчетов.СтатусВерсии = 0 Тогда
		СтрокаТаблицыОтчетов.Выгрузить	= Ложь;
		СтрокаТаблицыОтчетов.Отправить	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеРезультатаОтчетаДляВывода(Результат)
	
	// Адерс в хранилище
	Если ТипЗнч(Результат) = Тип("Строка") И ЭтоАдресВременногоХранилища(Результат) Тогда
		
		Возврат ПолучитьДанныеРезультатаОтчетаДляВывода(ПолучитьИзВременногоХранилища(Результат));
		
	// Если структура с пакетом отображаемых документов
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ПакетОтображаемыхДокументов")
		И ТипЗнч(Результат.ПакетОтображаемыхДокументов) = Тип("ПакетОтображаемыхДокументов") Тогда
		
		Возврат ПолучитьДанныеРезультатаОтчетаДляВывода(Результат.ПакетОтображаемыхДокументов);
		
	// Если табличный / текстовый документ / пакет отображаемых документов
	ИначеЕсли ТипЗнч(Результат) = Тип("ТабличныйДокумент")
		ИЛИ ТипЗнч(Результат) = Тип("ТекстовыйДокумент")
		ИЛИ ТипЗнч(Результат) = Тип("ПакетОтображаемыхДокументов")
		ИЛИ ТипЗнч(Результат) = Тип("ДвоичныеДанные") Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьТабличныеДокументыПакетаОтображаемыхДокументов(ПакетОтображаемыхДокументов, Представление)
	
	Для Каждого Элемент Из ПакетОтображаемыхДокументов.Состав Цикл
		
		Если ТипЗнч(Элемент.Данные) = Тип("Строка") Тогда
			
			Попытка
				ЭлементПакета = ПолучитьИзВременногоХранилища(Элемент.Данные);
			Исключение
				
				ТекстСообщения = СтрШаблон("Не удалось открыть все страницы результата отчета %1 из-за ошибки:
											|Ошибка при попытке получения из временного хранилища элемента '%2'!",
											Представление,
											Элемент.Наименование);
				
				Продолжить;
				
			КонецПопытки;
			
			Попытка
				ЭлементПакета.Показать(СтрШаблон("%1 (%2)", Представление, Элемент.Наименование));
			Исключение
				
				ТекстСообщения = СтрШаблон("Не удалось открыть все страницы результата отчета %1 из-за ошибки:
											|Ошибка при выводе элемента '%2'!",
											Представление,
											Элемент.Наименование);
				
				Продолжить;
				
			КонецПопытки;
			
		Иначе
			ОткрытьТабличныеДокументыПакетаОтображаемыхДокументов(Элемент, Представление);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СоздатьДокументРегламентированныйОтчет(ПараметрыФормыСозданияПисьма)
	
	Попытка
		ФормаОтчета = ПолучитьФорму(ПараметрыФормыСозданияПисьма.ИмяФормы, ПараметрыФормыСозданияПисьма.Параметры, ЭтаФорма, Истина);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось создать регламентированный отчет из-за невозможности создать форму отчета по ключу '%1'!", ПараметрыФормыСозданияПисьма.ИмяФормы);
	КонецПопытки;
	
	ФормаОтчета.СоздатьИЗаписать();
	
	Возврат ФормаОтчета.мСохраненныйДок;
	
КонецФункции

#КонецОбласти

#Область Серверные

&НаСервереБезКонтекста
Функция ПолучитьОписаниеТипаЗначенияНастройкиНаСервере(Настройка)

	ТипЗначения = Настройка.ТипЗначения;
	
	Если ТипЗначения = Неопределено Тогда
		
		ТипЗначения = Новый ОписаниеТипов;		
		
	КонецЕсли;
	
	Возврат ТипЗначения;		

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормыНаСервере(Ключ, ДополнительныеПараметры = Неопределено)

	Возврат Справочники.Отчеты.ПолучитьПараметрыФормыОтчета(Ключ, ДополнительныеПараметры);

КонецФункции

&НаСервере
Функция ПолучитьСостояниеОтчетаНаСервере(ИдентификаторСтроки)
	
	СтрокаТаблицы		= Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки))[0];
	АктуальноеСостояние = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)))[0];
	
	Если ЗначениеЗаполнено(АктуальноеСостояние.Экземпляр) <> ЗначениеЗаполнено(СтрокаТаблицы.Экземпляр)
		ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Экземпляр)
			И (АктуальноеСостояние.Экземпляр <> СтрокаТаблицы.Экземпляр
				ИЛИ АктуальноеСостояние.ВерсияДанных <> СтрокаТаблицы.ВерсияДанных)
		ИЛИ СтрокаТаблицы.Регламентированный
			И (ЗначениеЗаполнено(АктуальноеСостояние.РегламентированныйОтчет) <> ЗначениеЗаполнено(СтрокаТаблицы.РегламентированныйОтчет)
				ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.РегламентированныйОтчет)
					И (АктуальноеСостояние.РегламентированныйОтчет <> СтрокаТаблицы.РегламентированныйОтчет
						ИЛИ АктуальноеСостояние.СтатусРегламентированногоОтчета <> СтрокаТаблицы.СтатусРегламентированногоОтчета))
		ИЛИ АктуальноеСостояние.СтатусВерсии <> СтрокаТаблицы.СтатусВерсии
		ИЛИ АктуальноеСостояние.СтатусВыгрузки <> СтрокаТаблицы.СтатусВыгрузки
		ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Выгрузка) <> ЗначениеЗаполнено(СтрокаТаблицы.Выгрузка)
		ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Выгрузка) И АктуальноеСостояние.Выгрузка <> СтрокаТаблицы.Выгрузка
		ИЛИ АктуальноеСостояние.СтатусОтправки <> СтрокаТаблицы.СтатусОтправки
		ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Письмо) <> ЗначениеЗаполнено(СтрокаТаблицы.Письмо)
		ИЛИ ЗначениеЗаполнено(АктуальноеСостояние.Письмо) И АктуальноеСостояние.Письмо <> СтрокаТаблицы.Письмо Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		СостояниеОтчета = Новый Структура;
		
		СостояниеОтчета.Вставить("Организация",						Объект.Организация);
		СостояниеОтчета.Вставить("Экземпляр",						СтрокаТаблицы.Экземпляр);
		СостояниеОтчета.Вставить("Договор",							СтрокаТаблицы.Субъект);
		СостояниеОтчета.Вставить("Отчет",							СтрокаТаблицы.Отчет);
		СостояниеОтчета.Вставить("Периодичность",					СтрокаТаблицы.Периодичность);
		СостояниеОтчета.Вставить("Дата",							СтрокаТаблицы.Дата);
		СостояниеОтчета.Вставить("Регламентированный",				СтрокаТаблицы.Регламентированный);
		СостояниеОтчета.Вставить("РегламентированныйОтчет",			СтрокаТаблицы.РегламентированныйОтчет);
		СостояниеОтчета.Вставить("СтатусРегламентированногоОтчета",	СтрокаТаблицы.СтатусРегламентированногоОтчета);
		СостояниеОтчета.Вставить("ОбработкаЗавершена",				СтрокаТаблицы.ОбработкаЗавершена);
		СостояниеОтчета.Вставить("ЗапретОбработки",					СтрокаТаблицы.ЗапретОбработки);
		СостояниеОтчета.Вставить("СтатусВерсии",					СтрокаТаблицы.СтатусВерсии);
		СостояниеОтчета.Вставить("СтатусВыгрузки",					СтрокаТаблицы.СтатусВыгрузки);
		СостояниеОтчета.Вставить("Выгрузка",						СтрокаТаблицы.Выгрузка);
		СостояниеОтчета.Вставить("СтатусОтправки",					СтрокаТаблицы.СтатусОтправки);
		СостояниеОтчета.Вставить("Письмо",							СтрокаТаблицы.Письмо);
		СостояниеОтчета.Вставить("ДатаНачала",						СтрокаТаблицы.ДатаНачала);
		СостояниеОтчета.Вставить("ДатаОкончания",					СтрокаТаблицы.ДатаОкончания);
		СостояниеОтчета.Вставить("АдресНастроек",					СтрокаТаблицы.АдресНастроек);
		
		Возврат СостояниеОтчета;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВыполнитьОбработкуНаСервере()
	
	МассивСтрокКОбработке = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из Объект.ТаблицаОтчетов Цикл
		
		Если СтрокаТаблицы.Сформировать ИЛИ СтрокаТаблицы.Выгрузить ИЛИ СтрокаТаблицы.Отправить Тогда
			МассивСтрокКОбработке.Добавить(СтрокаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОбработки = Новый Структура;
	
	ПараметрыОбработки.Вставить("Отбор",							ПолучитьСтруктуруСДаннымиОтбораНаСервере());
	ПараметрыОбработки.Вставить("СостоянияОтчетовПередЗапуском",	Объект.ТаблицаОтчетов.Выгрузить(МассивСтрокКОбработке, "Субъект, Отчет, ГруппаОтчетов, Периодичность, Дата, Экземпляр, ВерсияДанных, СтатусВыгрузки, СтатусОтправки, Регламентированный, РегламентированныйОтчет, СтатусРегламентированногоОтчета, Сформировать, Выгрузить, Отправить"));
	ПараметрыОбработки.Вставить("Период",  							?(ЭтаФорма.УказатьПериод, ЭтаФорма.Период, Неопределено));
	РеквизитФормыВЗначение("Объект").ВыполнитьОбработкуОтчетов(ПараметрыОбработки);
	
	ЗаполнитьТаблицуОтчетовНаСервере();	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруСДаннымиОтбораНаСервере()
	
	ЭлементыОтбора = Новый Массив;
	
	ЭлементыОтбора.Добавить("Договоры");
	ЭлементыОтбора.Добавить("Периодичность");
	ЭлементыОтбора.Добавить("СписокОтчетов");
	ЭлементыОтбора.Добавить("ВидыДоговоров");
	ЭлементыОтбора.Добавить("Лицензия");
	ЭлементыОтбора.Добавить("Клиенты");
		
	Результат = Новый Структура;
	
	Результат.Вставить("ГруппаОтчетов", Объект.ГруппаОтчетов);
	
	Если ЗначениеЗаполнено(ЭтаФорма.Настройка) Тогда
		Результат.Вставить("Настройка",			ЭтаФорма.Настройка);
		Результат.Вставить("ЗначениеНастройки",	ЭтаФорма.ЗначениеНастройки);
	КонецЕсли;
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ЗначениеЗаполнено(ЭтаФорма[ЭлементОтбора]) Тогда
			Результат.Вставить(ЭлементОтбора, ЭтаФорма[ЭлементОтбора]);
		КонецЕсли; 		
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуОтчетовНаСервере()
	
	Для Каждого Отчет Из Объект.ТаблицаОтчетов Цикл
		УдалитьИзВременногоХранилища(Отчет.АдресНастроек);
	КонецЦикла;
	
	РеквизитФормыВЗначение("Объект").ЗаполнитьТаблицуОтчетов(Объект.ТаблицаОтчетов, ПолучитьСтруктуруСДаннымиОтбораНаСервере(), ЭтаФорма.УникальныйИдентификатор, ?(ЭтаФорма.УказатьПериод, ЭтаФорма.Период, Неопределено));
	
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить());
	
	Для Каждого Состояние Из СостоянияОтчетов Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Состояние.ИдентификаторСтроки))[0];
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Состояние,, "Сформировать, Выгрузить, Отправить");
		
		СтрокаТаблицы.Период = Новый СтандартныйПериод(СтрокаТаблицы.ДатаНачала, СтрокаТаблицы.ДатаОкончания);
		
	КонецЦикла;
	
	// Запоминаем исходные порядковые номера строк
	
	Индекс = 0;
	
	Для Каждого СтрокаТаблицы Из Объект.ТаблицаОтчетов Цикл
		СтрокаТаблицы.ИсходныйПорядковыйНомерСтроки = Индекс;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ПрименитьСортировкуНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьСоответствиеОрганизацииСчетовДУНаСервере()
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("Договоры",		Договоры.ВыгрузитьЗначения());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация <> &Организация
		|	И СчетаДоверительногоУправления.Ссылка В(&Договоры)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		Результат = Ложь;
		
		ТекстСообщения = СтрШаблон("Организация выбранных договоров ДУ должна соответствовать '%1'!
									|Следующие договоры ДУ исключены из отбора:", Объект.Организация);
		
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС + Выборка.СчетДУ;
			
			Пока Договоры.НайтиПоЗначению(Выборка.СчетДУ) <> Неопределено Цикл
				Договоры.Удалить(Договоры.НайтиПоЗначению(Выборка.СчетДУ));
			КонецЦикла;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеАктуальны(ПроверятьТолькоВыделенныеСтроки = Истина, ПроверятьСтатусыВыгрузкиИОтправки = Ложь)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	Если ПроверятьТолькоВыделенныеСтроки Тогда
		ТекущиеДанные = ОбъектОбработки.ПолучитьСтатусыОтчетов(Элементы.ТаблицаОтчетов.ВыделенныеСтроки);
	Иначе
		ТекущиеДанные = ОбъектОбработки.ПолучитьСтатусыОтчетов();
	КонецЕсли;
	
	Для Каждого Строка Из ТекущиеДанные Цикл
		
		Если Объект.ТаблицаОтчетов[Строка.НомерСтроки].ЗапретОбработки <> Строка.ЗапретОбработки
			ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].ИдентификаторФайла <> Строка.ИдентификаторФайла
			ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].ИдентификаторВерсии <> Строка.ИдентификаторВерсии
			ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].Регламентированный
				И (Объект.ТаблицаОтчетов[Строка.НомерСтроки].РегламентированныйОтчет <> Строка.РегламентированныйОтчет
					ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].СтатусРегламентированногоОтчета <> Строка.СтатусРегламентированногоОтчета)
			ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].СтатусВерсии <> Строка.СтатусВерсии
			ИЛИ ПроверятьСтатусыВыгрузкиИОтправки
				И (Объект.ТаблицаОтчетов[Строка.НомерСтроки].СтатусВыгрузки <> Строка.СтатусВыгрузки
					ИЛИ Объект.ТаблицаОтчетов[Строка.НомерСтроки].СтатусОтправки <> Строка.СтатусОтправки) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗаблокироватьСправочникЭкземпляровНаСервере(ДанныеОтчета)
	
	Результат = Истина;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ЭкземплярыОтчетов");
	
	ЭлементБлокировки.УстановитьЗначение("Организация",		Объект.Организация);
	ЭлементБлокировки.УстановитьЗначение("Субъект",			ДанныеОтчета.Субъект);
	ЭлементБлокировки.УстановитьЗначение("Отчет",			ДанныеОтчета.Отчет);
	ЭлементБлокировки.УстановитьЗначение("Периодичность",	ДанныеОтчета.Периодичность);
	ЭлементБлокировки.УстановитьЗначение("Дата",			ДанныеОтчета.Дата);
	
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьОбъектыЭкземпляровОтчетовНаСервере(ВыделенныеСтроки)
	
	Результат = Новый Массив;
	
	Список = Новый Массив;
	
	// Начало транзакции
	НачатьТранзакцию();
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		// Получаем строку ТЧ по идентификатору
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		// Пытаемся заблокировать справочник по ключевым полям
		Если НЕ ЗаблокироватьСправочникЭкземпляровНаСервере(СтрокаТаблицы) Тогда
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = СтрШаблон("Не удалось обработать отчеты из-за невозможности заблокировать данные отчета %1 (%2) по %3 за %4!",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		// Добавляем строку ТЧ в список для получения состояния
		Список.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	// Получаем актуальные состояния отчетов
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(Список));
	
	// Контролируем актуальность таблицы
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СостояниеОтчета.ИдентификаторСтроки))[0];
		
		Если ЗначениеЗаполнено(СостояниеОтчета.Экземпляр) И СостояниеОтчета.Экземпляр <> СтрокаТаблицы.Экземпляр
			ИЛИ СостояниеОтчета.ВерсияДанных <> СтрокаТаблицы.ВерсияДанных Тогда
			
			ОтменитьТранзакцию();
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Создаем экземпляры, если отсутствуют
	ОтчетыБезЭкземпляров = СостоянияОтчетов.НайтиСтроки(Новый Структура("Экземпляр", Неопределено));
	
	Для Каждого ОтчетБезЭкземпляра Из ОтчетыБезЭкземпляров Цикл
		
		ДанныеОтчета = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ОтчетБезЭкземпляра.ИдентификаторСтроки))[0];
		
		Попытка
			Экземпляр = РаботаСОтчетами.СоздатьЭкземплярОтчета(Объект.Организация, ДанныеОтчета.Субъект, ДанныеОтчета.Отчет, ДанныеОтчета.Периодичность, ДанныеОтчета.Дата);
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = СтрШаблон("Не удалось обработать отчеты из-за ошибки при создании экземпляра отчета %1 (%2) по %3 за %4:%5",
									ДанныеОтчета.Отчет,
									ДанныеОтчета.Периодичность,
									ДанныеОтчета.Субъект,
									Формат(ДанныеОтчета.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
		ДанныеОтчета.Экземпляр		= Экземпляр;
		ДанныеОтчета.ВерсияДанных	= Экземпляр.Ссылка.ВерсияДанных;
		
	КонецЦикла;
	
	// Формируем результат
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		ДанныеОтчета = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СостояниеОтчета.ИдентификаторСтроки))[0];
		
		Если ЗначениеЗаполнено(ДанныеОтчета.Экземпляр) Тогда
			
			ОбъектЭкземпляра = ДанныеОтчета.Экземпляр.ПолучитьОбъект();
			
			Если ОбъектЭкземпляра.Заблокирован() Тогда
				
				ОтменитьТранзакцию();
				
				ТекстОшибки = СтрШаблон("Не удалось обработать отчеты из-за невозможности занять отчет %1 (%2) по %3 за %4, т.к. он уже занят другим пользователем или сеансом!",
										ДанныеОтчета.Отчет,
										ДанныеОтчета.Периодичность,
										ДанныеОтчета.Субъект,
										Формат(ДанныеОтчета.Дата, "ДФ=dd.MM.yyyy"));
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Возврат Неопределено;
				
			Иначе
				
				Попытка
					ОбъектЭкземпляра.Заблокировать();
				Исключение
					
					ОтменитьТранзакцию();
					
					ТекстОшибки = СтрШаблон("Не удалось обработать отчеты из-за ошибки при попытке занять отчет %1 (%2) по %3 за %4:%5",
											ДанныеОтчета.Отчет,
											ДанныеОтчета.Периодичность,
											ДанныеОтчета.Субъект,
											Формат(ДанныеОтчета.Дата, "ДФ=dd.MM.yyyy"),
											Символы.ПС + ОписаниеОшибки());
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
					
					Возврат Неопределено;
					
				КонецПопытки;
				
				ДанныеЭкземпляра = Новый Структура;
				
				ДанныеЭкземпляра.Вставить("Объект",					ОбъектЭкземпляра);
				ДанныеЭкземпляра.Вставить("ИдентификаторСтроки",	Строка(ДанныеОтчета.ИдентификаторСтроки));
				
				Результат.Добавить(ДанныеЭкземпляра);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеВерсийНаСервере()
	
	Результат = Новый Массив;
	
	Список = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИмяФайла) Тогда
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет обработан из-за того, что не заполнено значение настройки 'Имя файла'!",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
									
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецЕсли;
		
		// Добавляем строку ТЧ в список для получения состояния
		Список.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	// Не смогли заблокировать данные ни по одному из отчетов
	Если Список.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получаем актуальные состояния отчетов
	СостоянияОтчетов = РаботаСОтчетами.ПолучитьСостоянияОтчетов(Объект.Организация, Объект.ТаблицаОтчетов.Выгрузить(Список));
	
	// Контролируем актуальность таблицы
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СостояниеОтчета.ИдентификаторСтроки))[0];
		
		Если ЗначениеЗаполнено(СостояниеОтчета.Экземпляр) И СостояниеОтчета.Экземпляр <> СтрокаТаблицы.Экземпляр
			ИЛИ СостояниеОтчета.ВерсияДанных <> СтрокаТаблицы.ВерсияДанных Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Формируем результат
	Для Каждого СостояниеОтчета Из СостоянияОтчетов Цикл
		
		Если ЗначениеЗаполнено(СостояниеОтчета.ИдентификаторВерсии) Тогда
			
			СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СостояниеОтчета.ИдентификаторСтроки))[0];
			
			ДанныеФайла = Новый Структура;
			
			ДанныеФайла.Вставить("ИмяФайла",			СтрокаТаблицы.ИмяФайла);
		    ДанныеФайла.Вставить("ИдентификаторСтроки",	СостояниеОтчета.ИдентификаторСтроки);
			
			Попытка
