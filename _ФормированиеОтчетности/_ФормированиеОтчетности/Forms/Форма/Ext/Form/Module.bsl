&НаКлиенте
Процедура КлючевыеПоляПриИзменении(Элемент)
	
	ИзмененияКлючевыхПолейПрименены = Ложь;
	
	Если ЭтаФорма.Договоры.Количество() > 0
		Или ЭтаФорма.СписокОтчетов.Количество() > 0
		Или ЭтаФорма.Клиенты.Количество() > 0
		Или ЭтаФорма.ВидыДоговоров.Количество() > 0
		Или ЗначениеЗаполнено(ЭтаФорма.Лицензия)
		Или ЗначениеЗаполнено(ЭтаФорма.Периодичность)
		Или ЗначениеЗаполнено(ЭтаФорма.Настройка)
	Тогда
		ЭтаФорма.ЗаголовокОтборов = "установлен";
	Иначе
		ЭтаФорма.ЗаголовокОтборов = "не задан";
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДатыПриИзменении(Элемент)
	
	Объект.УчитыватьСрокФормирования = РежимФормирования = 1;
	УказатьПериод = РежимФормирования = 2;
	Объект.ВсеОтчетыБезУчетаПериодичности = РежимФормирования = 3;
	 		
	КлючевыеПоляПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВерсиюОтчета(СтрокаТаблицы)
	
	// Получаем версию из хранилища
	Попытка
		ДанныеВерсии = РаботаСФайловымХранилищем.ПолучитьВерсиюФайла(СтрокаТаблицы.ИдентификаторВерсии);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось открыть версию отчета %1 (%2) по %3 за %4 из-за ошибки при получении данных из файлового хранилища:%5",
								СтрокаТаблицы.Отчет,
								СтрокаТаблицы.Периодичность,
								СтрокаТаблицы.Субъект,
								Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
								Символы.ПС + ОписаниеОшибки());
								
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
		
	КонецПопытки;
			
	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось открыть версию отчета %1 (%2) по %3 за %4 из-за ошибки при получении данных из временного хранилища:%5",
								СтрокаТаблицы.Отчет,
								СтрокаТаблицы.Периодичность,
								СтрокаТаблицы.Субъект,
								Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
								Символы.ПС + ОписаниеОшибки());
								
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
		
	КонецПопытки;
	
	Попытка
		УдалитьИзВременногоХранилища(ДанныеВерсии.Адрес);
	Исключение
		// Ну, не удалили и не удалили
	КонецПопытки;
	
	// Сохраняем версию во временный файл
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
	ИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + СтрокаТаблицы.ИмяФайла;
	
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось открыть версию отчета %1 (%2) по %3 за %4 из-за записи временного файла:%5",
								СтрокаТаблицы.Отчет,
								СтрокаТаблицы.Периодичность,
								СтрокаТаблицы.Субъект,
								Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
								Символы.ПС + ОписаниеОшибки());
								
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
		
	КонецПопытки;
	
	// Открываем файл
	ЗапуститьПриложение(ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена выбранная строка");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
		
	СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ВыбранноеЗначение = Неопределено;
	
	Если Поле.Имя = "ТаблицаОтчетовСубъект" Тогда
		ВыбранноеЗначение = СтрокаТаблицы.Субъект;
	ИначеЕсли Поле.Имя = "ТаблицаОтчетовОтчет" Тогда
		ВыбранноеЗначение = СтрокаТаблицы.Отчет;
	ИначеЕсли Поле.Имя = "ТаблицаОтчетовСтатусРегламентированногоОтчета" Тогда
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.РегламентированныйОтчет) Тогда
			ВыбранноеЗначение = СтрокаТаблицы.РегламентированныйОтчет;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Регламентированный отчет не создан!");
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ТаблицаОтчетовСтатусВерсии" И ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторВерсии) Тогда
		ОткрытьВерсиюОтчета(СтрокаТаблицы);
	ИначеЕсли Поле.Имя = "ТаблицаОтчетовСтатусВыгрузки" И ЗначениеЗаполнено(СтрокаТаблицы.Выгрузка) Тогда
		ВыбранноеЗначение = СтрокаТаблицы.Выгрузка;
	ИначеЕсли Поле.Имя = "ТаблицаОтчетовСтатусОтправки" И ЗначениеЗаполнено(СтрокаТаблицы.Письмо) Тогда
		ВыбранноеЗначение = СтрокаТаблицы.Письмо;
	Иначе
		
		СостояниеОтчета = ПолучитьСостояниеОтчетаНаСервере(Элементы.ТаблицаОтчетов.ТекущиеДанные.ИдентификаторСтроки);
		
		Если СостояниеОтчета <> Неопределено Тогда
			ОткрытьФормуМодально("ВнешняяОбработка._ФормированиеОтчетности.Форма.СостояниеОтчета", СостояниеОтчета);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные в таблице отчетов стали неактуальными! Обновите таблицу.");
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьЗначение(ВыбранноеЗначение);
	КонецЕсли; 
	
КонецПроцедуры

