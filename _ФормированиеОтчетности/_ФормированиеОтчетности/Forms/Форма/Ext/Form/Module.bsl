#Область Команды_формы

&НаКлиенте
Процедура ЗапретитьОбработку(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, для которого требуется запретить обработку!");
		Возврат;
	КонецЕсли;
	
	ЗапретитьОбработкуНаСервере();
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьОбработку(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, для которого требуется разрешить обработку!");
		Возврат;
	КонецЕсли;
	
	ИдентификаторыСтрок = РазрешитьОбработкуНаСервере();
	
	Если ИдентификаторыСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторыСтрок.Количество() > 0 Тогда
		
		ТекстВопроса =
			"Среди отчетов, для которых был отключен запрет обработки, прошла дата формирования!
			|Обработать отчеты автоматически?";
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			
			ДанныеДляВыбора = Новый Массив;
			
			Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
				
				ДанныеОтчета = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки))[0];
				
				НоваяСтрока = Новый Структура;
				
				НоваяСтрока.Вставить("ИдентификаторСтроки",				ИдентификаторСтроки);
				НоваяСтрока.Вставить("Субъект",							ДанныеОтчета.Субъект);
				НоваяСтрока.Вставить("Отчет",							ДанныеОтчета.Отчет);
				НоваяСтрока.Вставить("Периодичность",					ДанныеОтчета.Периодичность);
				НоваяСтрока.Вставить("Период",							ДанныеОтчета.Период);
				НоваяСтрока.Вставить("Обработать",						Истина);
				
				ДанныеДляВыбора.Добавить(НоваяСтрока);
				
			КонецЦикла;
			
			ФормаВыбораОтчетов = ПолучитьФорму("ВнешняяОбработка._ФормированиеОтчетности.Форма.ФормаВыбораОтчетовДляОбработки", Новый Структура("ДанныеДляВыбора", ДанныеДляВыбора));
			
			РезультатВыбора = ФормаВыбораОтчетов.ОткрытьМодально();
			
			Если РезультатВыбора <> Неопределено Тогда
				
				Для Каждого СтрокаТаблицы Из Объект.ТаблицаОтчетов Цикл
					
					Если РезультатВыбора.Найти(СтрокаТаблицы.ИдентификаторСтроки) = Неопределено Тогда
						// Отключаем обработку
						СтрокаТаблицы.Сформировать	= Ложь;
						СтрокаТаблицы.Выгрузить		= Ложь;
						СтрокаТаблицы.Отправить		= Ложь;
					Иначе
						// Заполняем действиями по умолчанию
						СтрокаТаблицы.Сформировать	= СтрокаТаблицы.СтатусВерсии < 2;
						СтрокаТаблицы.Выгрузить		= СтрокаТаблицы.ВыгружаетсяВЭДО И (СтрокаТаблицы.Сформировать ИЛИ СтрокаТаблицы.СтатусВерсии = 2);
						СтрокаТаблицы.Отправить		= СтрокаТаблицы.ОтправляетсяПочтой И (СтрокаТаблицы.Сформировать ИЛИ СтрокаТаблицы.СтатусВерсии = 2);
					КонецЕсли;
					
				КонецЦикла;
				
				ВыполнитьОбработку(Неопределено);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

