
#Область Внешний_интерфейс

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	// Обновляем организацию, очищаем отбор по счетам ДУ, заполняем таблицу отчетов.
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Договоры.Очистить();
	
	ЗаполнитьТаблицуОтчетов(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_формы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если НЕ ЗначениеЗаполнено(Объект.ГруппаОтчетов) Тогда
		Объект.ГруппаОтчетов = ГруппаОтчетовБухгалтерия;
	КонецЕсли;

	ВидДатыПриИзменении(Неопределено);
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Дата			= ТекущаяДатаСеанса();
	
	ГруппаОтчетовБухгалтерия	= Справочники.Отчеты.Бухгалтерия;
	ПолноправныйПользователь	= РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	РаботаСФормами.УстановитьПредставлениеЗначенийДляПоляТабличнойЧастиСоСпискомВыбора(ЭтаФорма, Элементы.СортировкаПоле);	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
	// Для обычных пользователей счета доверительного управления в отборе могут быть недоступны после входа под пользователем другой организации.
	Если НЕ РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		
		УдаляемыеЭлементыОтбора = Новый Массив;
		
		// Перебираем все счета доверительного управления из отбора.
		Для Каждого Договор Из Договоры Цикл
			
			// Пытаемся получить объект.
			Попытка
				ПолученныйОбъект = Договор.Значение.ПолучитьОбъект();
			Исключение
				// Если поймали исключение, значит счет доверительного управления недоступен пользователю. Удаляем его из отбора.
				Если УдаляемыеЭлементыОтбора.Найти(Договор) = Неопределено Тогда
					УдаляемыеЭлементыОтбора.Добавить(Договор);
				КонецЕсли;
			КонецПопытки;
			
		КонецЦикла;
		
		Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементыОтбора Цикл
			Договоры.Удалить(УдаляемыйЭлемент);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

