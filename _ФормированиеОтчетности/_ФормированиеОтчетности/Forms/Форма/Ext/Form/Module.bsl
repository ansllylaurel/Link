Функция РазрешитьОбработкуНаСервере()
	
	ДанныеЭкземпляров = ПолучитьОбъектыЭкземпляровОтчетовНаСервере(Элементы.ТаблицаОтчетов.ВыделенныеСтроки);
	
	Если ДанныеЭкземпляров = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработанныеСтроки = Новый Массив;
	
	Для Каждого ДанныеЭкземпляра Из ДанныеЭкземпляров Цикл
		
		НачатьТранзакцию();
		
		Экземпляр		= ДанныеЭкземпляра.Объект;
		СтрокаТаблицы	= Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеЭкземпляра.ИдентификаторСтроки))[0];
		
		Экземпляр.ЗапретОбработки = Ложь;
		
		УспешнаяЗапись = Истина;
		
		Попытка
			Экземпляр.Записать();
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось разрешить обработку отчета %1 (%2) по %3 за %4 из-за ошибки:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			УспешнаяЗапись = Ложь;
			
		КонецПопытки;
		
		Если УспешнаяЗапись Тогда
			
			РаботаСОтчетами.ЗафиксироватьСобытиеСОтчетом(Перечисления.СобытияСОтчетами.ОтключениеЗапретаОбработки, Экземпляр.Ссылка);
			
			ЗафиксироватьТранзакцию();
			
			СтрокаТаблицы.ВерсияДанных		= Экземпляр.Ссылка.ВерсияДанных;
			СтрокаТаблицы.ЗапретОбработки	= Ложь;
			СтрокаТаблицы.Сформировать		= СтрокаТаблицы.СтатусВерсии < 2;
			СтрокаТаблицы.Выгрузить			= СтрокаТаблицы.ВыгружаетсяВЭДО И (СтрокаТаблицы.Сформировать ИЛИ СтрокаТаблицы.СтатусВерсии = 2);
			СтрокаТаблицы.Отправить			= СтрокаТаблицы.ОтправляетсяПочтой И (СтрокаТаблицы.Сформировать ИЛИ СтрокаТаблицы.СтатусВерсии = 2);
			
			ОбработанныеСтроки.Добавить(СтрокаТаблицы);
			
		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Экземпляр.Разблокировать();
		
	КонецЦикла;
	
	Если ОбработанныеСтроки.Количество() > 0 Тогда
		
		Результат = Новый Массив;
		
		Для Каждого СтрокаТаблицы Из ОбработанныеСтроки Цикл
			
			ДатаФормирования = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, СтрокаТаблицы.Дата, СтрокаТаблицы.СрокФормирования+1);
			
			Если НачалоДня(ТекущаяДата()) > ДатаФормирования Тогда
				Результат.Добавить(СтрокаТаблицы.ИдентификаторСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Результат;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

