&НаКлиенте
Процедура РезультатыОбработкиОтчетовЗаДень(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Организация",				Объект.Организация);
	ПараметрыФормы.Вставить("УчитываяСрокФормирования",	Объект.УчитыватьСрокФормирования);
	ПараметрыФормы.Вставить("Дата",						Объект.Дата);
	ПараметрыФормы.Вставить("ГруппаОтчетов",			Объект.ГруппаОтчетов);
	ПараметрыФормы.Вставить("Клиенты",					Клиенты);
	ПараметрыФормы.Вставить("ВидыДоговоров",			ВидыДоговоров);
	ПараметрыФормы.Вставить("Договоры",					Договоры);
	ПараметрыФормы.Вставить("СписокОтчетов",			СписокОтчетов);
	ПараметрыФормы.Вставить("Периодичность",			Периодичность);
	
	ФормаОтчета = ПолучитьФорму("Отчет.РезультатыОбработкиОтчетов.Форма.ФормаОтчета", ПараметрыФормы);
	
	ФормаОтчета.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагруженВЭДОВручную(Команда)
	
	ФайлЗагруженВЭДОВручнуюНаСервере();
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЗагрузкуВЭДОВручную(Команда)
	
	ОтменитьЗагрузкуВЭДОВручнуюНаСервере();
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуОтчетов(Команда)
	
	ЗаполнитьТаблицуОтчетовНаСервере();
	
	ИзмененияКлючевыхПолейПрименены = Истина;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПараметры(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПолучитьНастройкиИзХранилищаВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихНастроек);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, ОписаниеНастроек.Настройки);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОписаниеНастроек.Настройки);
		
		// Отрабатываем связь по типу
		ЭтаФорма.Элементы.ЗначениеНастройки.ОграничениеТипа = ПолучитьОписаниеТипаЗначенияНастройкиНаСервере(ЭтаФорма.Настройка);
		ЭтаФорма.ЗначениеНастройки = ЭтаФорма.Элементы.ЗначениеНастройки.ОграничениеТипа.ПривестиЗначение(ЭтаФорма.ЗначениеНастройки); 
		
		ДоговорыПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПараметры(Команда)
	
	Настройки = Новый Структура("СписокОтчетов, Договоры, Клиенты, ВидыДоговоров, Лицензия, Периодичность, Настройка, ЗначениеНастройки");
	
	Если ЗначениеЗаполнено(ЭтаФорма.СписокОтчетов) Тогда
		Настройки.Вставить("ГруппаОтчетов");		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Настройки, Объект);
	ЗаполнитьЗначенияСвойств(Настройки, ЭтаФорма);
	
	РаботаСФормамиКлиент.СохранитьНастройкиВХранилищеВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихНастроек, Настройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтбор(Команда)

	СписокОтчетов.Очистить();
	Договоры.Очистить();
	Клиенты.Очистить();
	ВидыДоговоров.Очистить();
	
	ОтборОтчетности = Новый Структура("Лицензия, Периодичность, Настройка, ЗначениеНастройки");
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОтборОтчетности);
	
	КлючевыеПоляПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеЭлектронногоПисьма(Команда)
	
	ПараметрыФормыСозданияПисьма = Новый Структура;
	ПараметрыФормыСозданияПисьма.Вставить("Организация",	Объект.Организация);
	ПараметрыФормыСозданияПисьма.Вставить("ГруппаОтчетов",	Объект.ГруппаОтчетов);
	
	Если Договоры.Количество() > 0 Тогда
		ПараметрыФормыСозданияПисьма.Вставить("СчетДоверительногоУправления", Договоры[0].Значение);
	КонецЕсли;
	
	ФормаРучнойОтправки = ПолучитьФорму("ВнешняяОбработка._ФормированиеОтчетности.Форма.ФормаСозданияЭлектронногоПисьма", ПараметрыФормыСозданияПисьма, ЭтаФорма);
	
	ФормаРучнойОтправки.ОткрытьМодально();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПочтой(Команда)
	
	Вложения = Новый Массив;
	
	Для Каждого Строка Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Строка);
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторВерсии)
			 ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИмяФайла) Тогда
			 Продолжить;
		КонецЕсли;
		
		НовоеВложение = Новый Структура;
		
		НовоеВложение.Вставить("Идентификатор",	СтрокаТаблицы.ИдентификаторВерсии);
		НовоеВложение.Вставить("Имя",			СтрокаТаблицы.ИмяФайла);
		НовоеВложение.Вставить("Экземпляр",		СтрокаТаблицы.Экземпляр);
		
		Вложения.Добавить(НовоеВложение);
		
	КонецЦикла;
	
	Если Вложения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для отправки! Выберите строки с отчетами, по которым есть сохраненные версии.");
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуМодально("ОбщаяФорма.ОтправкаФайловПочтой", Новый Структура("Организация, Вложения", Объект.Организация, Вложения));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, версию которого требуется выгрузить!");
		Возврат;
	КонецЕсли;
	
	ДанныеВерсий = ПолучитьДанныеВерсийНаСервере();
	
	Если ДанныеВерсий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеВерсии Из ДанныеВерсий Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеВерсии.ИдентификаторСтроки))[0];
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось открыть версию отчета %1 (%2) по %3 за %4 из-за ошибки при получении версии отчета из временного хранилища:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
									
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		// Сохраняем версию во временный файл
		Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
		
		ИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + СтрокаТаблицы.ИмяФайла;
		
		Попытка
			ДвоичныеДанные.Записать(ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось открыть версию отчета %1 (%2) по %3 за %4 из-за ошибки при записи временного файла:%5",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
									
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Возврат;
			
		КонецПопытки;
		
		// Открываем файл
		ЗапуститьПриложение(ИмяФайла);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	ДанныеВерсий = ПолучитьДанныеВерсийНаСервере();
	
	Если ДанныеВерсий = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Сохраняем версию во временный файл
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + "\";
	
	Для Каждого ДанныеВерсии Из ДанныеВерсий Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеВерсии.ИдентификаторСтроки))[0];
		
		Попытка
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выведен на печать из-за ошибки при получении версии отчета из временного хранилища:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Попытка
			ДвоичныеДанные.Записать(Каталог + ДанныеВерсии.ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выведен на печать из-за ошибки при записи временного файла:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		Попытка
			РаботаСОтчетамиКлиент.НапечататьФайл(Каталог + ДанныеВерсии.ИмяФайла);
		Исключение
			
			ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выведен на печать из-за ошибки при вызове функции печати:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									Символы.ПС + ОписаниеОшибки());
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьФормированиеВыделенные(Команда)
	
	УстановитьЗначениеФлага("Сформировать", Ложь);
	
