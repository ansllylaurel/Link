				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не будет обработан из-за ошибки при формировании отчета:%5",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
			Если НЕ Настройки.Свойство("Результат") Тогда
				
				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не обработан т.к. отсутствует результат отчета!",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецЕсли;
			
			Попытка
				ДанныеРезультатаОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьДанныеРезультатаОтчета(Настройки.Результат, Настройки.Расширение);
			Исключение
				
				ТекстОшибки = СтрШаблон("Отчет  %1 (%2) по %3 за %4 не обработан из-за ошибки при сохранении файла отчета:%5",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
			ДанныеФайла = Новый Структура;
			
			ДанныеФайла.Вставить("ИмяФайла",			СтрокаТаблицы.ИмяФайла);
		    ДанныеФайла.Вставить("ИдентификаторСтроки",	СтрокаТаблицы.ИдентификаторСтроки);
