&НаКлиенте
Процедура СделатьВерсиюПредварительной(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, версию которого требуется сделать предварительной!");
		Возврат;
	КонецЕсли;
	
	СделатьВерсиюПредварительнойНаСервере();
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьВерсиюОкончательной(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, версии которого требуется сделать окончательной!");
		Возврат;
	КонецЕсли;
	
	СделатьВерсиюОкончательнойНаСервере();
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКаталог(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, версию которого требуется выгрузить!");
		Возврат;
	КонецЕсли;
	
	ДВФ = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	
	Если ДВФ.Выбрать() Тогда
		
		ДанныеВерсий = ПолучитьДанныеВерсийНаСервере();
		
		Если ДанныеВерсий = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ДанныеВерсии Из ДанныеВерсий Цикл
			
			Попытка
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеВерсии.Адрес);
			Исключение
				
				СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеВерсии.ИдентификаторСтроки))[0];
				
				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выгружен из-за ошибки при получении версии отчета из временного хранилища:%6",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
										
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
			Попытка
				ДвоичныеДанные.Записать(ДВФ.Каталог + ?(Прав(ДВФ.Каталог, 1) = "\", "", "\") + ДанныеВерсии.ИмяФайла);
			Исключение
				
				СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеВерсии.ИдентификаторСтроки))[0];
				
				ТекстОшибки = СтрШаблон("Отчет %1 (%2) по %3 за %4 не выгружен из-за ошибки при записи файла:%6",
										СтрокаТаблицы.Отчет,
										СтрокаТаблицы.Периодичность,
										СтрокаТаблицы.Субъект,
										Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
										Символы.ПС + ОписаниеОшибки());
										
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
				Продолжить;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	// Загрузка доступна только для одного файла
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать отчет, для которого требуется выполнить загрузку версии из файла!");
		Возврат;
	ИначеЕсли Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать только один отчет, для которого требуется выполнить загрузку версии из файла!");
		Возврат;
	КонецЕсли;                     
	
	ИмяФайлаПоНастройке = Элементы.ТаблицаОтчетов.ТекущиеДанные.ИмяФайла;
	РасширениеПоНастройке = РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ИмяФайлаПоНастройке);
	
	ДВФ = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДВФ.МножественныйВыбор = Ложь;
	
	Если ДВФ.Выбрать() Тогда       
		
		ПолноеИмяВыбранногоФайла = ДВФ.ВыбранныеФайлы[0]; 
		РасширениеВыбранногоФайла = РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ПолноеИмяВыбранногоФайла);
		
		Попытка
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяВыбранногоФайла);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось получить данные из выбранного файла из-за ошибки:%1", Символы.ПС + ОписаниеОшибки())); 
			Возврат;
		КонецПопытки;
		
		Попытка
			Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось поместить данные файла во временное хранилище из-за ошибки:%1", Символы.ПС + ОписаниеОшибки())); 
			Возврат;
		КонецПопытки;
		
		ЗагружатьФайл = Истина;
		Если РасширениеПоНастройке <> РасширениеВыбранногоФайла Тогда 
			Если Вопрос("Расширение загружаемого файла '" + РасширениеВыбранногоФайла + "' не совпадает с расширением, указанным в настройке '" + РасширениеПоНастройке + "'. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
				ЗагружатьФайл = Ложь;  
			КонецЕсли;
		КонецЕсли; 
		
		Если ЗагружатьФайл Тогда
			Если ЗагрузитьИзФайлаНаСервере(Адрес, РасширениеВыбранногоФайла) Тогда
				
				Если Вопрос("Версия успешно загружена. Установить для загруженной версии пометку 'Окончательная'?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
					СделатьВерсиюОкончательной(Неопределено)
				Иначе
					ОбновитьКонтекстноеМеню();
				КонецЕсли;
				
			КонецЕсли;   
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ТребуетсяПодтверждениеПовтораОбработки = Ложь;
	
	КоличествоСформировать	= 0;
	КоличествоВыгрузить		= 0;
	КоличествоОтправить		= 0;
	
	Для Каждого СтрокаТаблицы Из Объект.ТаблицаОтчетов Цикл
		
		КоличествоСформировать	= КоличествоСформировать + ?(СтрокаТаблицы.Сформировать, 1, 0);
		КоличествоВыгрузить		= КоличествоВыгрузить + ?(СтрокаТаблицы.Выгрузить, 1, 0);
		КоличествоОтправить		= КоличествоОтправить + ?(СтрокаТаблицы.Отправить, 1, 0);
		
		// Версия окончательная, но хотят сформировать новую
		Если СтрокаТаблицы.Сформировать И СтрокаТаблицы.СтатусВерсии = 2 Тогда
			ТребуетсяПодтверждениеПовтораОбработки = Истина;
		КонецЕсли;
		
		// Версия выгружена, но хотят выгрузить повторно
		Если НЕ СтрокаТаблицы.Сформировать И СтрокаТаблицы.Выгрузить И СтрокаТаблицы.СтатусВыгрузки > 1 Тогда
			ТребуетсяПодтверждениеПовтораОбработки = Истина;
		КонецЕсли;
		
		// Версия выгружена, но хотят выгрузить повторно
		Если НЕ СтрокаТаблицы.Сформировать И СтрокаТаблицы.Отправить И СтрокаТаблицы.СтатусОтправки > 1 Тогда
			ТребуетсяПодтверждениеПовтораОбработки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоСформировать > 0
		ИЛИ КоличествоВыгрузить > 0
		ИЛИ КоличествоОтправить > 0 Тогда
		
		Формирование	= ?(КоличествоСформировать > 0,	Символы.ПС + СтрШаблон("формирование %1 отчетов",	Формат(КоличествоСформировать, "ЧГ=0")),	"");
		Выгрузка		= ?(КоличествоВыгрузить > 0,	Символы.ПС + СтрШаблон("выгрузка %1 отчетов",		Формат(КоличествоВыгрузить, "ЧГ=0")),		"");
		Отправка		= ?(КоличествоОтправить > 0,	Символы.ПС + СтрШаблон("отправка %1 отчетов",		Формат(КоличествоОтправить, "ЧГ=0")),		"");
		
		ТекстВопроса = СтрШаблон("Будет выполнено: %1%2%3
								|Прервать выполнение?",
								Формирование,
								Выгрузка,
								Отправка);
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяПодтверждениеПовтораОбработки Тогда
		
		ТекстВопроса =
			"Среди выбранных к обработке отчетов обнаружены отчеты, по которым:
			|или есть окончательная версия и установлен флаг 'Сформировать'
			|или версия была выгружена в ЭДО и установлен флаг 'Выгрузить'
			|или версия была отправлена почтой и установлен флаг 'Отправить'.
			|Прервать выполнение обработки?";
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.ГруппаОтчетов = ГруппаОтчетовБухгалтерия Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Сформировать",						Истина);
		Отбор.Вставить("Регламентированный",				Истина);
		Отбор.Вставить("РегламентированныйОтчет",			ПустаяСсылкаРегламентированногоОтчета);
		
		ЕстьОтсутствующиеРегламентированныеОтчеты = Объект.ТаблицаОтчетов.НайтиСтроки(Отбор).Количество() > 0;
		
		Отбор.Удалить("РегламентированныйОтчет");
		
		Отбор.Вставить("СтатусРегламентированногоОтчета", "Черновик");
		
		ЕстьНеготовыеРегламентированныеОтчеты = Объект.ТаблицаОтчетов.НайтиСтроки(Отбор).Количество() > 0;
		
		Если ЕстьОтсутствующиеРегламентированныеОтчеты
			ИЛИ ЕстьНеготовыеРегламентированныеОтчеты Тогда
			
			Если ЕстьОтсутствующиеРегламентированныеОтчеты
				И ЕстьНеготовыеРегламентированныеОтчеты Тогда
				ТекстВопроса =
					"Среди выбранных к обработке отчетов обнаружено отсутствие регламентированного отчета или регламентованные отчеты не готовы.
					|Такие отчеты не будут обработаны.
					|Прервать выполнение обработки?";
			ИначеЕсли ЕстьОтсутствующиеРегламентированныеОтчеты Тогда
				ТекстВопроса =
					"Среди выбранных к обработке отчетов обнаружено отсутствие регламентированных отчетов.
					|Такие отчеты не будут обработаны.
					|Прервать выполнение обработки?";
			ИначеЕсли ЕстьНеготовыеРегламентированныеОтчеты Тогда
				ТекстВопроса =
					"Среди выбранных к обработке отчетов обнаружены неготовые регламентированные отчеты.
					|Такие отчеты не будут обработаны.
					|Прервать выполнение обработки?";
			КонецЕсли;
			
			Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьОбработкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДляПросмотра(Команда)
	
	Если Элементы.ТаблицаОтчетов.ВыделенныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать хотя бы один отчет, который требуется сформировать для порсмотра!");
		Возврат;
	КонецЕсли;
	
	РезультатыОтчетов = СформироватьДляПросмотраНаСервере();
	
	Для Каждого Результат Из РезультатыОтчетов Цикл
		
		ДанныеДляВывода = ПолучитьДанныеРезультатаОтчетаДляВывода(Результат.Результат);
		
		Если ТипЗнч(ДанныеДляВывода) = Тип("ТабличныйДокумент") ИЛИ ТипЗнч(ДанныеДляВывода) = Тип("ТекстовыйДокумент") Тогда
			ДанныеДляВывода.Показать(Результат.Представление);
		ИначеЕсли ТипЗнч(ДанныеДляВывода) = Тип("ПакетОтображаемыхДокументов") Тогда
			ОткрытьТабличныеДокументыПакетаОтображаемыхДокументов(ДанныеДляВывода, Результат.Представление);
		ИначеЕсли ТипЗнч(ДанныеДляВывода) = Тип("ДвоичныеДанные") Тогда
			
			СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Результат.Идентификатор);
			
			Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
			
			ИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + Строка(Новый УникальныйИдентификатор) + "\" + СтрокаТаблицы.ИмяФайла;
			
			Попытка
				ДанныеДляВывода.Записать(ИмяФайла);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить двоичные данные результата отчета в файл!");
				Возврат;
			КонецПопытки;
			
			ЗапуститьПриложение(ИмяФайла);
			
		Иначе
			
			ТекстСообщения = СтрШаблон("Для отчета %1 невозможно вывести результат, т.к. тип результата отчета (%2) не поддерживается!",
										Результат.Представление,
										ТипЗнч(ДанныеДляВывода));
										
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВсе(Команда)
	
	УстановитьЗначениеФлагаДляВсех("Сформировать",	Истина);
	УстановитьЗначениеФлагаДляВсех("Выгрузить",		Истина);
	УстановитьЗначениеФлагаДляВсех("Отправить",		Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьВсе(Команда)
	
	УстановитьЗначениеФлагаДляВсех("Сформировать",	Ложь);
	УстановитьЗначениеФлагаДляВсех("Выгрузить",		Ложь);
	УстановитьЗначениеФлагаДляВсех("Отправить",		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЧерновикРегламентированногоОтчета(Команда)
	
	ИдентификаторыСтрок = Новый Массив;
	
	Для Каждого Идентификатор Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		ИдентификаторыСтрок.Добавить(Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор).ИдентификаторСтроки);
	КонецЦикла;
	
	ПараметрыФорм = ПолучитьПараметрыФормыРегламентированногоОтчетаНаСервере(ИдентификаторыСтрок);
	
	Если ПараметрыФорм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Идентификатор Из Элементы.ТаблицаОтчетов.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Объект.ТаблицаОтчетов.НайтиПоИдентификатору(Идентификатор);
		
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФормыРегламентированногоОтчета = ПараметрыФорм.Получить(СтрокаТаблицы.ИдентификаторСтроки);
		
		Если ПараметрыФормыРегламентированногоОтчета = Неопределено Тогда
			Продолжить;
		ИначеЕсли ПараметрыФормыРегламентированногоОтчета.Свойство("ОписаниеОшибки")
			И ЗначениеЗаполнено(ПараметрыФормыРегламентированногоОтчета.ОписаниеОшибки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПараметрыФормыРегламентированногоОтчета.ОписаниеОшибки);
			Продолжить;
		КонецЕсли;
		
		Попытка
			РегламентированныйОтчет = СоздатьДокументРегламентированныйОтчет(ПараметрыФормыРегламентированногоОтчета);
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось создать регламентированный отчет для %1 (%2) по %3 за %4 из-за ошибки:%6",
									СтрокаТаблицы.Отчет,
									СтрокаТаблицы.Периодичность,
									СтрокаТаблицы.Субъект,
									Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"),
									ОписаниеОшибки());
									
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		СтрокаТаблицы.РегламентированныйОтчет			= РегламентированныйОтчет;
		СтрокаТаблицы.СтатусРегламентированногоОтчета	= "Черновик";
		
	КонецЦикла;
	
	ОбновитьКонтекстноеМеню();
	
КонецПроцедуры

