
Процедура ПередВыполнением(Отказ)
	
	ЭтотОбъект.Исполнитель    = РаботаСПользователями.ТекущийПользователь();
	
	Если ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПровестиОбучение 
		Или ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПройтиОбучение И ЭтотОбъект.ОбучениеПройденоОффлайн Тогда
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаВыполнения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле ""Дата выполнения""", ЭтотОбъект, "ДатаВыполнения",, Отказ);
			Возврат;
		КонецЕсли;
	Иначе
		ЭтотОбъект.ДатаВыполнения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	КонтрольДатыВыполнения(Отказ);
		
	Если ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПроверитьЗнания
	 ИЛИ ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПровестиОбучение Тогда
	 
	 	ВидДолжностногоЛица = Документы.ОбучениеСотрудников.ПолучитьВидДолжностногоЛицаОтветственногоЗаОбучение(Основание.ВидПеречня, Отказ);
		
		Если ВидДолжностногоЛица = Неопределено Тогда
			Возврат;
		КонецЕсли;
	 
		ОтветственныйЗаПроверкуЗнаний = РегистрыСведений.ДолжностныеЛицаОрганизаций.ПолучитьДолжностноеЛицо(ЭтотОбъект.ДатаВыполнения, ЭтотОбъект.Организация, ВидДолжностногоЛица);
		Если НЕ ЗначениеЗаполнено(ОтветственныйЗаПроверкуЗнаний) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Не установлено должностное лицо (%1) на %2. Проведение обучения невозможно. Для назначения ДЛ используйте внутренний документ с видом 'Приказ'.",
					ВидДолжностногоЛица,
					Формат(ЭтотОбъект.ДатаВыполнения, "ДФ=dd.MM.yyyy")),,,, Отказ);
		
		ИначеЕсли НЕ (ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ОбучениеСотрудников") 
		   			И Документы.ОбучениеСотрудников.ИспользуютсяПростыеПодписи(ЭтотОбъект.Основание.Организация, ЭтотОбъект.Основание.ВидПеречня, ЭтотОбъект.Основание.Дата)) Тогда
			ЭтотОбъект.Исполнитель = ОтветственныйЗаПроверкуЗнаний.Пользователь;
			
		Иначе
			Если ЭтотОбъект.Исполнитель <> ОтветственныйЗаПроверкуЗнаний.Пользователь Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Пользователь %1 не может проверять знания. Ответственный за проверку знаний на %2 назначен %3 (%4)",
						ЭтотОбъект.Исполнитель,
						Формат(ЭтотОбъект.ДатаВыполнения, "ДФ=dd.MM.yyyy"),
						ОтветственныйЗаПроверкуЗнаний,
						ВидДолжностногоЛица), ЭтотОбъект,,, Отказ);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
	
		РаботаСБизнесПроцессамиИЗадачами.ПередЗаписьюЗадачи(ЭтотОбъект);
		РаботаСБизнесПроцессамиИЗадачами.ПроверитьДатуЗадачиНаСогласованиеОтносительноСрокаПорученияНаВыводАктивов(ЭтотОбъект, Отказ);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Основание");
	
КонецПроцедуры

//Проверяет, что дата выполнения входит в установленный период. Для обучения это период обучения, для проверки - период проверки. Если сотрудник в установленном периоде в отпуске, то срок увеличивается до дня выхода из отпуска.
//
// Параметры:
//  Отказ - Булево - при непрохождении контроля устанавливается значение Истина
//
Процедура КонтрольДатыВыполнения(Отказ)
	
	Если ТипЗнч(ЭтотОбъект.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ОбучениеСотрудника") Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Сотрудник",	 	ЭтотОбъект.БизнесПроцесс.Сотрудник);
		Запрос.УстановитьПараметр("ДатаВыполнения", ЭтотОбъект.ДатаВыполнения);
		
		Если ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПройтиОбучение Тогда
			
			Если РаботаССотрудниками.СотрудникОтсутсвуетНаРабочемМесте(ЭтотОбъект.Организация, ЭтотОбъект.БизнесПроцесс.Сотрудник, ЭтотОбъект.ДатаВыполнения, Отказ) Тогда
				Возврат;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("НачалоВыполнения", 	 НачалоДня(ЭтотОбъект.Основание.Дата));
			Запрос.УстановитьПараметр("ОкончаниеВыполнения", КонецДня(ЭтотОбъект.Основание.ОкончаниеОбучения));
			
			ШаблонСообщения = "Дата выполнения %1 должна попадать в период обучения с %2 по %3";
			
		ИначеЕсли ЭтотОбъект.ТочкаМаршрута = БизнесПроцессы.ОбучениеСотрудника.ТочкиМаршрута.ПроверитьЗнания Тогда
			
			Запрос.УстановитьПараметр("НачалоВыполнения", 	 ЭтотОбъект.Основание.НачалоПроверкиЗнаний);
			Запрос.УстановитьПараметр("ОкончаниеВыполнения", КонецДня(ЭтотОбъект.Основание.ОкончаниеПроверкиЗнаний));
			
			ШаблонСообщения = "Дата выполнения %1 должна попадать в период проверки знаний с %2 по %3";
			
		Иначе
			Возврат;
			
		КонецЕсли;
		
#Область ТекстЗапроса

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&НачалоВыполнения КАК НачалоВыполнения,
			|	КОНЕЦПЕРИОДА(ВЫБОР
			|			КОГДА СостояниеСотрудниковОрганизацийСрезПоследних.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.РаботаВОтпускеПоУходуЗаРебенком))
			|				ТОГДА &ОкончаниеВыполнения
			|			ИНАЧЕ МИНИМУМ(СостояниеСотрудниковОрганизаций.Период)
			|		КОНЕЦ, ДЕНЬ) КАК ОкончаниеВыполнения
			|ПОМЕСТИТЬ _ДоступныйПериодВыполнения
			|ИЗ
			|	РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(
			|			&ОкончаниеВыполнения,
			|			Организация = &Организация
			|				И Сотрудник = &Сотрудник) КАК СостояниеСотрудниковОрганизацийСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций КАК СостояниеСотрудниковОрганизаций
			|		ПО (СостояниеСотрудниковОрганизаций.Организация = &Организация)
			|			И (СостояниеСотрудниковОрганизаций.Сотрудник = &Сотрудник)
			|			И (СостояниеСотрудниковОрганизаций.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.РаботаВОтпускеПоУходуЗаРебенком)))
			|			И (СостояниеСотрудниковОрганизаций.Период >= &ОкончаниеВыполнения)
			|
			|СГРУППИРОВАТЬ ПО
			|	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаВыполнения КАК ДатаВыполнения,
			|	_ДоступныйПериодВыполнения.НачалоВыполнения КАК НачалоВыполнения,
			|	_ДоступныйПериодВыполнения.ОкончаниеВыполнения КАК ОкончаниеВыполнения
			|ИЗ
			|	_ДоступныйПериодВыполнения КАК _ДоступныйПериодВыполнения
			|ГДЕ
			|	НЕ(&ДатаВыполнения МЕЖДУ _ДоступныйПериодВыполнения.НачалоВыполнения И _ДоступныйПериодВыполнения.ОкончаниеВыполнения)";
		
#КонецОбласти	

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ШаблонСообщения, 
					Формат(Выборка.ДатаВыполнения, "ДФ=dd.MM.yyyy"), 
					Формат(Выборка.НачалоВыполнения, "ДФ=dd.MM.yyyy"), 
					Формат(Выборка.ОкончаниеВыполнения, "ДФ=dd.MM.yyyy")),,,, Отказ);
		КонецЦикла;	
	
	КонецЕсли;
	
КонецПроцедуры
	
	
	
	