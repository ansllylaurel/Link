
Функция ОпределитьНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки) Экспорт
	// Расчетные настройки
	ЗначениеНастройки = Неопределено;
	Если БухгалтерскийУчет.ОпределитьРасчетнуюНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки, ЗначениеНастройки) Тогда
		Возврат ЗначениеНастройки;
	КонецЕсли;       
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка[ИмяНастройки];
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ОпределитьНастройкуУчета

Функция ПолучитьДатуИЦенуВыкупа(Облигация, Дата, ДатаПокупки, СчетДоверительногоУправления, ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, ИгнорироватьИнформациюОбОбязательномДосрочномПогашении, ОтборПоТипамОфертПоОблигациям, ДелатьОтборПоДатеОбъявления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	УсловияОферт.Цена КАК Цена
		|ПОМЕСТИТЬ _Оферты
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &Облигация
		|	И УсловияОферт.ДатаВыкупа >= &Дата
		|	И &ОтборПоДатеОбъявления 
		|	И &ОтборПоТипамОфертПоОблигациям 
		|	И &УчитыватьОбъявлениеОбязательногоДосрочногоПогашения
		|	И НЕ УсловияОферт.ТолькоДляФизическихЛиц
		|	И (&ДатаПокупки = НЕОПРЕДЕЛЕНО
		|			ИЛИ УсловияОферт.АкцептПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ УсловияОферт.АкцептПо > &ДатаПокупки)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВыкупа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Оферты.Цена КАК Цена,
		|	ЕСТЬNULL(КупонныйДоходПоОблигациям.ДатаОкончанияКупона, Оферты.ДатаВыкупа) КАК ДатаВыкупа
		|ИЗ
		|	_Оферты КАК Оферты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО Оферты.ДатаВыкупа >= КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|			И (КупонныйДоходПоОблигациям.Облигация = &Облигация)
		|			И (&ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона УБЫВ");
	
	
	Если СчетДоверительногоУправления = Неопределено Тогда
		ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Ложь;
		УчитыватьОбъявлениеОбязательногоДосрочногоПогашения = Истина;
	Иначе
		
		Если ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Неопределено Тогда
		
			ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона =
				БухгалтерскийУчет.ОпределитьНастройкуУчета(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона");
				
		КонецЕсли;
		
		Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Неопределено Тогда
		
			ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = 
				БухгалтерскийУчет.ОпределитьНастройкуУчета(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ИгнорироватьИнформациюОбОбязательномДосрочномПогашении");
			
		КонецЕсли;
		
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_431") Тогда
			
			Если Дата >= '20230501' И БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, Дата) Тогда // #483764 с 1.5.23 группа будущее настройкой начинает игнорировать инфу об обяз.доср.погаш. а по этй бумаге не игнорит
			
				ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Ложь;
				
			Иначе
				
				МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
					ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
					ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
					Дата);
			
				ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(СчетДоверительногоУправления) <> Неопределено);
				
				Если ЭтоКлиентСАФМАР Тогда
					ИгнорироватьИнформациюОбОбязательномДосрочномПогашении = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_011") И Дата >= '20230101' Тогда // ГТЛК АО, 4B02-11-32432-H-001P, 1000.00 USD
			
			// #465403 #Хардкод #Техдолг
			
			Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН") Тогда // НПФ Достойное БУДУЩЕЕ  АО ПН
				ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона = Ложь;
			КонецЕсли;
			
		КонецЕсли;		
		
		Если НЕ ИгнорироватьИнформациюОбОбязательномДосрочномПогашении Тогда
			УчитыватьОбъявлениеОбязательногоДосрочногоПогашения = Истина;
		Иначе // игнорируем объявление досрочного погашения до самого дня погашения
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчитыватьОбъявлениеОбязательногоДосрочногоПогашения",
				"(УсловияОферт.ТипОферты <> ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно) ИЛИ УсловияОферт.ДатаВыкупа = НАЧАЛОПЕРИОДА(&Дата, День))");
		КонецЕсли;
			
	КонецЕсли;	
	
	ОтборПоДатеОбъявления = "(УсловияОферт.ДатаОбъявления = ДАТАВРЕМЯ(1, 1, 1) ИЛИ УсловияОферт.ДатаОбъявления <= &Дата)";
	Если НЕ ДелатьОтборПоДатеОбъявления ИЛИ Облигация.ДатаПогашения = '00010101' Тогда // для бессрочной бумаги оферты берем без учета объявления (#362218, #380983)
		ОтборПоДатеОбъявления = "ИСТИНА";
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоДатеОбъявления", ОтборПоДатеОбъявления);
	
	Если ЗначениеЗаполнено(ОтборПоТипамОфертПоОблигациям) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоТипамОфертПоОблигациям", "УсловияОферт.ТипОферты В(&ОтборПоТипамОфертПоОблигациям)");
		
		МассивОтборПоТипамОфертПоОблигациям = Новый Массив;
		
		Если ТипЗнч(ОтборПоТипамОфертПоОблигациям) = Тип("Структура") Тогда
			Для Каждого ЗначениеОтборПоТипамОфертПоОблигациям Из ОтборПоТипамОфертПоОблигациям Цикл
				Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении И ЗначениеОтборПоТипамОфертПоОблигациям.Значение = Перечисления.ТипыОфертПоОблигациям.Досрочно Тогда
					Продолжить;	
				Иначе	
					МассивОтборПоТипамОфертПоОблигациям.Добавить(ЗначениеОтборПоТипамОфертПоОблигациям.Значение);
				КонецЕсли;	
			КонецЦикла;	
		ИначеЕсли ТипЗнч(ОтборПоТипамОфертПоОблигациям) = Тип("ПеречислениеСсылка.ТипыОфертПоОблигациям") Тогда	
			Если ИгнорироватьИнформациюОбОбязательномДосрочномПогашении И ОтборПоТипамОфертПоОблигациям <> Перечисления.ТипыОфертПоОблигациям.Досрочно Тогда
				МассивОтборПоТипамОфертПоОблигациям.Добавить(ОтборПоТипамОфертПоОблигациям);	
			КонецЕсли;	
		КонецЕсли;	
			
		Запрос.УстановитьПараметр("ОтборПоТипамОфертПоОблигациям", 								МассивОтборПоТипамОфертПоОблигациям);
	Иначе
		Запрос.УстановитьПараметр("ОтборПоТипамОфертПоОблигациям", 								Истина);
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Облигация",													Облигация);
	Запрос.УстановитьПараметр("Дата",														Дата);
	Запрос.УстановитьПараметр("ДатаПокупки",												ДатаПокупки);
	Запрос.УстановитьПараметр("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
	Запрос.УстановитьПараметр("УчитыватьОбъявлениеОбязательногоДосрочногоПогашения", 		УчитыватьОбъявлениеОбязательногоДосрочногоПогашения);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ДатаВыкупа	= ВыборкаДетальныеЗаписи.ДатаВыкупа;
		ЦенаВыкупа	= ВыборкаДетальныеЗаписи.Цена;
		
	Иначе
		
		РеквизитыОблигации	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Облигация, "ДатаПогашения, ИндексируемыйНоминал, Амортизационная");
		ДатаВыкупа			= ?(ЗначениеЗаполнено(РеквизитыОблигации.ДатаПогашения), РеквизитыОблигации.ДатаПогашения, Неопределено);
		
		Если РеквизитыОблигации.ИндексируемыйНоминал И (ДатаВыкупа = Неопределено ИЛИ ДатаВыкупа > Дата)
			ИЛИ РеквизитыОблигации.Амортизационная И ДатаВыкупа = Неопределено
		Тогда 
			ЦенаВыкупа = Неопределено;
		Иначе
			ЦенаВыкупа = Справочники.Облигации.ПолучитьНоминал(Облигация, ДатаВыкупа);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("ДатаВыкупа, ЦенаВыкупа", ДатаВыкупа, ЦенаВыкупа); 
	
КонецФункции

Функция СчетаДоверительногоУправленияКлиента(Клиент, Организация, Период) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|			И (СчетаДоверительногоУправления.Организация = &Организация)
		|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|			И (СчетаДоверительногоУправления.ДатаЗаключения <= &Период)
		|			И (СчетаДоверительногоУправления.ДатаРасторжения > &Период
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент");
	
	Запрос.УстановитьПараметр("Период",		 Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Клиент",		 Клиент);
			
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости() Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	УчетныеАктивыЕПС.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ВекселяДоПогашения))");
			
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

Функция ВидЗадолженностиСвязанСПартиями(ВидЗадолженности) Экспорт

	МассивВидовЗадолженностиСвязанныхСПартиями = Новый Массив;
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюВекселя);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюПая);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода);
	
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоСделке);
	МассивВидовЗадолженностиСвязанныхСПартиями.Добавить(Справочники.ВидыЗадолженности.ПоФорвардуПоставки);
	
	Возврат (МассивВидовЗадолженностиСвязанныхСПартиями.Найти(ВидЗадолженности) <> Неопределено);

КонецФункции

Функция ПолучитьПереопределенныеУчетныеАктивыЦБРФ(Период, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.Эмитент КАК Эмитент,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.ИсходныйУчетныйАктивЦБ КАК ИсходныйУчетныйАктивЦБ,
		|	ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.НовыйУчетныйАктивЦБ КАК НовыйУчетныйАктивЦБ
		|ИЗ
		|	РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СрезПоследних(
		|			&Период,
		|			(Организация, Клиент) В
		|				(ВЫБРАТЬ
		|					_Клиент.Организация,
		|					_Клиент.Клиент
		|				ИЗ
		|					_Клиент)) КАК ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних");
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	ПереопределенныеУчетныеАктивыЦБРФ = Запрос.Выполнить().Выгрузить();
	ПереопределенныеУчетныеАктивыЦБРФ.Индексы.Добавить("Эмитент, ИсходныйУчетныйАктивЦБ");
	
	Возврат ПереопределенныеУчетныеАктивыЦБРФ;

КонецФункции

Функция ПолучитьПереопределенныйУчетныйАктивЦБРФ(УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Эмитент)

	Если СчетДоверительногоУправления = Неопределено Тогда
		Возврат УчетныйАктивЦБРФ;
	КонецЕсли;
	
	Если Период = '00010101' ИЛИ Период = Неопределено Тогда  
		ДатаНастроек = Период;
	ИначеЕсли ТипЗнч(Период) = Тип("Дата") ИЛИ ТипЗнч(Период) = Тип("Граница") Тогда
		ДатаНастроек = КонецДня(СистемныеФункции.ПолучитьДатуИзГраницы(Период));
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип значения '%1' параметра 'Период'", ТипЗнч(Период));
	КонецЕсли;	
	
	ПереопределенныеУчетныеАктивыЦБРФ	= Кэширование.ПолучитьПереопределенныеУчетныеАктивыЦБРФ(ДатаНастроек, СчетДоверительногоУправления);
	ПереопределенныйУчетныйАктивЦБРФ	= ПереопределенныеУчетныеАктивыЦБРФ.НайтиСтроки(Новый Структура("Эмитент, ИсходныйУчетныйАктивЦБ", Эмитент, УчетныйАктивЦБРФ));
	УчетныйАктивЦБ						= ?(ПереопределенныйУчетныйАктивЦБРФ.Количество() = 0, УчетныйАктивЦБРФ, ПереопределенныйУчетныйАктивЦБРФ[0].НовыйУчетныйАктивЦБ);
	
	Возврат УчетныйАктивЦБ;

КонецФункции

Функция ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период)

	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции ИЛИ Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Если СчетДоверительногоУправления = Неопределено Тогда
			Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой;
		Иначе
			Настройка = БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриоритетнаяКатегорияПриКлассификацииДолевыхЦенныхБумаг");
			Если НЕ ЗначениеЗаполнено(Настройка) Тогда
				Возврат Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой;
			Иначе	
				Возврат Настройка;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Если СчетДоверительногоУправления = Неопределено Тогда
			Возврат Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток;
		Иначе
			Настройка = БухгалтерскийУчет.ОпределитьНастройкуУчета(Период, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, "ПриоритетнаяКатегорияПриКлассификацииДолговыхЦенныхБумаг");
			Если НЕ ЗначениеЗаполнено(Настройка) Тогда
				Возврат Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток;
			Иначе	
				Возврат Настройка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ОпределитьУчетныйАктивЕПС(Период, Рынок, Актив, СчетДоверительногоУправления = Неопределено) Экспорт

	Эмитент = Неопределено;
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		
		АктивУчетныйАктивЦБРФ = ПолучитьПереопределенныйУчетныйАктивЦБРФ(Актив.УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Актив.Эмитент);
		
		ПриоритетнаяКатегория = ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период);
		
		Если ПриоритетнаяКатегория = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи Тогда
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков Тогда
			
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиКредитныхОрганизаций;
				
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ Тогда
				
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиПрочихРезидентов;
				
			Иначе //незаполнено или что- то непонятное
				
				Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиПрочихРезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажиКредитныхОрганизаций;
				КонецЕсли;
				
			КонецЕсли;
		Иначе			
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИБанков
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИБанков Тогда
			
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
				
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АОИ
				ИЛИ АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.АПИ Тогда
				
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
				
			Иначе //незаполнено или что- то непонятное
				
				Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		//пока отправим на "посправедливой"
		
		// для паев нет возможности получать данные из <<УчетныйАктивЦБРФ>>
		УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(Период, Актив);
		УправляющаяКомпания_ЮрЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(УправляющаяКомпания_ЮрЛицо, "Банки") = Неопределено Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов;
		Иначе
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций;
		КонецЕсли;
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		// К.Б.:  ДР классифицируются по базовому активу
		УчетныйАктивЦБРФ =  ОпределитьУчетныйАктивЕПС(Период, Перечисления.РынкиЦенныхБумаг.Акции, Актив.БазоваяЦБ, СчетДоверительногоУправления);
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
		// а Х.З.
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		
		Если Актив.Эмитент.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияРФ;
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма,
				|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации КАК СтранаРегистрации
				|ИЗ
				|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
				|			&Период,
				|			ЮрФизЛицо = &ЮрФизЛицо
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
				
			Запрос.УстановитьПараметр("Период",    Период);
			Запрос.УстановитьПараметр("ЮрФизЛицо", Актив.Эмитент.ЮрФизЛицо);
			
			ОПФ = Справочники.ОрганизационноПравовыеФормы.ПубличноеАкционерноеОбщество; // по умолчанию некое юр.лицо
			Страна = Справочники.СтраныМира.Россия;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОПФ = Выборка.ОрганизационноПравоваяФорма;
				Страна = Выборка.СтранаРегистрации;
			КонецЕсли;
			КредитнаяОрганизация = (Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") <> Неопределено);
			
			Если Страна = Справочники.СтраныМира.Россия Тогда
				Если ОПФ = Справочники.ОрганизационноПравовыеФормы.ГосударственноеПредприятие Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияСубъектовРФ;	
				ИначеЕсли КредитнаяОрганизация Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияКредитныхОрганизаций;
				Иначе
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияПрочихРезидентов;
				КонецЕсли;
			Иначе
				Если ОПФ = Справочники.ОрганизационноПравовыеФормы.ГосударственноеПредприятие Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияИностранныхГосударств;	
				ИначеЕсли КредитнаяОрганизация Тогда
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияБанковНерезидентов;
				Иначе
					Возврат Справочники.УчетныеАктивыЕПС.ВекселяДоПогашенияПрочихНерезидентов;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// пока на долговые по амортизации
		Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Актив.Эмитент.ЮрФизЛицо, "Банки") = Неопределено Тогда
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСДПрочихРезидентов;
		Иначе
			УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСДКредитныхОрганизаций;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		АктивУчетныйАктивЦБРФ = ПолучитьПереопределенныйУчетныйАктивЦБРФ(Актив.УчетныйАктивЦБРФ, Период, СчетДоверительногоУправления, Актив.Эмитент);
		
		ПриоритетнаяКатегория = ОпределитьПриоритетнуюКатегориюПриКлассификации(СчетДоверительногоУправления, Рынок, Период);
		
		Если ПриоритетнаяКатегория = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
			Если АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиСубъектовРФ;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиКредитныхОрганизаций;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиБанковНерезидентов;
			ИначеЕсли АктивУчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
				УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихНерезидентов;
			Иначе
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиРФ;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Субфедеральная
						  ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиСубъектовРФ;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиКредитныхОрганизаций;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихРезидентов;
				ИначеЕсли Актив.УчетныйАктивЦБРФ = Справочники.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов Тогда
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиБанковНерезидентов;
				Иначе
					УчетныйАктивЦБРФ = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиПрочихНерезидентов;
				КонецЕсли;
			КонецЕсли;
