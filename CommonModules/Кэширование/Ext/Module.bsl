Функция КоличествоЗаписейТаблицы(ПолноеИмяТаблицы) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	#ПолноеИмяТаблицы# КАК Таблица");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ПолноеИмяТаблицы#", ПолноеИмяТаблицы);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	КоличествоЗаписей = ?(ВыборкаЗапроса.Следующий(), ВыборкаЗапроса.Количество, 0);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КоличествоЗаписей;
	
КонецФункции

Функция ПолучитьДатуПредыдущегоДействия(ВидДействия, СчетДоверительногоУправления, Дата, ОтсутствуютНастройки) Экспорт

	Вчера = НачалоДня(Дата)-1;
	
	МассивСДатой = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыДействияЗаПериод(ВидДействия, СчетДоверительногоУправления, НачалоГода(НачалоГода(Дата)-1), Вчера, Дата, Истина, ОтсутствуютНастройки);
	
	Если ОтсутствуютНастройки Тогда 
		Возврат Неопределено;
	ИначеЕсли МассивСДатой.Количество() = 1 Тогда
		Возврат МассивСДатой[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

