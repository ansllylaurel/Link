// Проверяет, существует ли указанное поле в коллекции. Опционально, возвращает
//  значение переданного поля в параметр ЗначПоля
//
// Параметры:
//  Коллекция                  - Коллекция (Структура, СправочникОбъект, ДокументОбъект, …), содержащая поля, доступные на чтение
//  ИмяПоля                    - Строка - имя поля в формате требований к свойствам структуры
//  ЗначПоля                   - Необязательный параметр, в который возвращается значение поля, если оно существует
//  ЭтоУникальныйИдентификатор - Необязательный параметр, в который необходимо передать ИСТИНА, если поле имеет тип
//                               "УникальныйИдентификатор", т.к. в этом случае алгоритм работы фукнции будет иным
// Возвращает:
//  Булево - признак существования поля в коллекции
//
Функция ПолеСуществует(Коллекция, ИмяПоля, ЗначПоля = Неопределено, ЭтоУникальныйИдентификатор = Ложь) Экспорт
	
	Если ЭтоУникальныйИдентификатор Тогда
		НевозможноеЗначение = Неопределено;
	Иначе
		НевозможноеЗначение = Новый УникальныйИдентификатор; // чисто гипотетически, если в объекте есть реквизит типа УникальныйИдентификатор, то может и совпать
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить(ИмяПоля, НевозможноеЗначение); // Неопределено не прокатывает для незаполненых реквизитов составного типа
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, Коллекция);
	
	ЗначПоля = СтруктураПоиска[ИмяПоля];
	
	Если      ЗначПоля = НевозможноеЗначение Тогда
		ЗначПоля = Неопределено;
		Возврат Ложь;
		
	#Если Сервер Тогда
		
	ИначеЕсли ЗначПоля = Null Тогда
		// в процессе работы выяснилась одна интересная особенность: если коллекцией является группа справочника,
		// то поля, которые недоступны в группе, в коллекции, тем не менее, присутствуют, только значение у них Null
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(Коллекция));
		
		Если ОбъектМД <> Неопределено И Лев(ОбъектМД.ПолноеИмя(), 10) = "Справочник" Тогда
			ЗначПоля = Неопределено;
			Возврат Ложь;
		КонецЕсли;
		
	#КонецЕсли
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ПолеСуществует

// Проверяет, заполнены ли указанные поля колллекции.
//
// Параметры:
//  Коллекция - Коллекция (Структура, СправочникОбъект, ДокументОбъект, …), содержащая поля, доступные на чтение
//
//  Поля      - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель"
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передаются фактические имена полей
//            - Массив, ФиксированныйМассив - имена полей в формате требований к свойствам структуры
//
Функция ПоляЗаполнены(Коллекция, Поля) Экспорт

	// сформируем массив, в котором перечислены проверямые поля
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		ПроверямыеПоля = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Поля, ",", Истина, Истина);
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Структура") Или ТипЗнч(Поля) = Тип("ФиксированнаяСтруктура") Тогда
		ПроверямыеПоля = Новый Массив();
		
		Для каждого КлючЗнач Из ПроверямыеПоля Цикл
			ПроверямыеПоля.Добавить(ПроверямыеПоля.Ключ);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Массив") Или ТипЗнч(Поля) = Тип("ФиксированныйМассив") Тогда
		ПроверямыеПоля = Поля;
		
	Иначе
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный тип второго параметра Поля: %1'"),
			Строка(ТипЗнч(Поля)));
			
	КонецЕсли;
	
	// проверим заполнение полей
	Для каждого Поле Из ПроверямыеПоля Цикл
		Если Не ЗначениеЗаполнено(Коллекция[Поле]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // ПоляЗаполнены

// Выделяет указанные реквизиты коллекции в отдельную структуру. Акутально,
//  например, когда поля объекта нужно передать из формы на сервер (сам объект
//  при этом передавать нельзя, из-за ограничений платформы)
// 
// Параметры:
//  Коллекция - Коллекция (Структура, СправочникОбъект, ДокументОбъект, …), содержащая поля, доступные на чтение
//
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//
Функция ПоляВСтруктуру(Коллекция, Поля) Экспорт
	
	// сформируем строку, в которой через "," перечислены имена копируемых полей
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		КопируемыеПоля = Поля;
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Структура") Или ТипЗнч(Поля) = Тип("ФиксированнаяСтруктура") Тогда
		КопируемыеПоля = "";
		
		Для каждого КлючЗнач Из Поля Цикл
			КопируемыеПоля = КопируемыеПоля + ?(КопируемыеПоля = "", "", ", ") + КлючЗнач.Ключ;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Массив") Или ТипЗнч(Поля) = Тип("ФиксированныйМассив") Тогда
		КопируемыеПоля = "";
		
		Для каждого Поле Из Поля Цикл
			КопируемыеПоля = КопируемыеПоля + ?(КопируемыеПоля = "", "", ", ") + Поле;
		КонецЦикла;
		
	Иначе
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный тип второго параметра Поля: %1'"),
			Строка(ТипЗнч(Поля)));
			
	КонецЕсли;	
	
	СтруктураПолей = Новый Структура(КопируемыеПоля);
	ЗаполнитьЗначенияСвойств(СтруктураПолей, Коллекция, КопируемыеПоля);
	
	Возврат СтруктураПолей;
	
КонецФункции // ПоляОбъектаВСтруктуру

// Присваивает указанным полям кпервооллекции значение НЕОПРЕДЕЛЕНО
// 
// Параметры:
//  Коллекция - Коллекция (Структура, СправочникОбъект, ДокументОбъект, …), содержащая поля, доступные на запись
//
//  Поля      - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель"
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передаются фактические имена полей
//            - Массив, ФиксированныйМассив - имена полей в формате требований к свойствам структуры
// 
Процедура ОчиститьПоля(Коллекция, Поля) Экспорт

	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		ОчищаемыеПоля = Новый Структура(Поля);
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Структура") Или ТипЗнч(Поля) = Тип("ФиксированнаяСтруктура") Тогда
		ОчищаемыеПоля = Поля;
		
	ИначеЕсли ТипЗнч(Поля) = Тип("Массив") Или ТипЗнч(Поля) = Тип("ФиксированныйМассив") Тогда
		ОчищаемыеПоля = Новый Структура;
		
		Для каждого Реквизит Из Поля Цикл
			ОчищаемыеПоля.Вставить(Реквизит);
		КонецЦикла;
		
	Иначе
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный тип второго параметра Поля: %1'"),
			Строка(ТипЗнч(Поля)));
			
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Коллекция, ОчищаемыеПоля);
	
КонецПроцедуры // ОчиститьПоля

#КонецОбласти

