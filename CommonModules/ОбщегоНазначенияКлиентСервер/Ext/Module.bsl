
// Возвращает имя подкаталога, создаваемого для временных файлов и последующей автоматической ежедневной очистке
//
Функция ПолучитьИмяПодкаталогаДляСохраненияВременныхФайлов() Экспорт
	
	Возврат "1sfiles.tmp";
	
КонецФункции

// Возвращает путь к каталогу временных файлов, который автоматически очищается на следующий день
Функция ПолучитьКаталогВременныхФайлов() Экспорт
	
	Подкаталог	= Неопределено;
	
	#Если Сервер Тогда
		
		ОчищаемыйКаталог = ПолучитьИмяПодкаталогаДляСохраненияВременныхФайлов();
		
		Если ЗначениеЗаполнено(ОчищаемыйКаталог) Тогда
			
			Подкаталог = ОчищаемыйКаталог + ?(Прав(ОчищаемыйКаталог, 1) = "\", "", "\") + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + "\";
			
			Отказ = Ложь;
			
			РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогВременныхФайлов() + Подкаталог, Отказ);
			
			Если Отказ Тогда
				Подкаталог = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	#КонецЕсли
	
	Если ЗначениеЗаполнено(Подкаталог) Тогда
		Путь = КаталогВременныхФайлов() + Подкаталог;
	Иначе
		Путь = КаталогВременныхФайлов();
	КонецЕсли;
	
	Возврат Путь;
	
КонецФункции

Функция ПериодЗаполненКорректно(Период, РазрешенаПустаяДатаНачала = Ложь, РазрешенаПустаяДатаОкончания = Ложь, СтрокаСообщений = "") Экспорт
	
	Ошибки = Новый Массив;
	
	Если Не (ЗначениеЗаполнено(Период.ДатаНачала) ИЛИ ЗначениеЗаполнено(Период.ДатаОкончания)) Тогда
	
		Если Не (РазрешенаПустаяДатаНачала И РазрешенаПустаяДатаОкончания) Тогда
			Ошибки.Добавить("Период не заполнен.");
		КонецЕсли;

	Иначе
	
		Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
			
			Если Не РазрешенаПустаяДатаНачала Тогда
				Ошибки.Добавить("Начало периода не заполнено.");
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
			
			Если Период.ДатаНачала > Период.ДатаОкончания Тогда
				Ошибки.Добавить("Начало периода не должно превышать окончание периода.");
			КонецЕсли;
			
		ИначеЕсли Не РазрешенаПустаяДатаОкончания Тогда
			
			Ошибки.Добавить("Окончание периода не заполнено.");
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаСообщений = СтрСоединить(Ошибки, Символы.ПС);
	
	Возврат (Ошибки.Количество() = 0);
	
КонецФункции

Функция РазностьДатВДнях(Дата1, Дата2) Экспорт
	
	СекундВДне = 86400; // в секундах
	
	Возврат Цел((НачалоДня(Дата1) - НачалоДня(Дата2)) / СекундВДне);
	
КонецФункции

Функция ПустоеЗначениеТипа(Тип) Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип);
	
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	
	Возврат ОписаниеТипов.ПривестиЗначение(Неопределено);
	
КонецФункции

