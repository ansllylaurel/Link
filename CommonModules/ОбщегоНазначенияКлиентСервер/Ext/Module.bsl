Функция ЕстьЗаполненноеЗначение(Значение1, Значение2, Значение3 = Неопределено, Значение4 = Неопределено, Значение5 = Неопределено) Экспорт
	
	Возврат
		ЗначениеЗаполнено(Значение1)
			Или ЗначениеЗаполнено(Значение2)
			Или ЗначениеЗаполнено(Значение3)
			Или ЗначениеЗаполнено(Значение4)
			Или ЗначениеЗаполнено(Значение5);
	
КонецФункции // ЕстьЗаполненноеЗначение

Функция ПервоеЗаполненноеЗначение(Значение1, Значение2, Значение3 = Неопределено, Значение4 = Неопределено, Значение5 = Неопределено) Экспорт
	
	Если      ЗначениеЗаполнено(Значение1) Тогда
		Возврат Значение1;
	ИначеЕсли ЗначениеЗаполнено(Значение2) Тогда
		Возврат Значение2;
	ИначеЕсли ЗначениеЗаполнено(Значение3) Тогда
		Возврат Значение3;
	ИначеЕсли ЗначениеЗаполнено(Значение4) Тогда
		Возврат Значение4;
	ИначеЕсли ЗначениеЗаполнено(Значение5) Тогда
		Возврат Значение5;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // ПервоеЗаполненноеЗначение

