			ПараметрыМакета.Вставить("СтрокаНаименование2", Сред(СтрокаНаименование, Позиция));
			
			СтруктураАдресаФИАС		= РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(Выборка.ЮридическийАдресФИАС);
			ТипыАдресныхЭлементов	= РаботаСКонтактнойИнформациейКлиентСервер.ПолучитьСокращенныеТипыАдресныхЭлементов();
			
			ЭлементыАдреса1 = Новый Массив;
			ЭлементыАдреса1.Добавить(СтруктураАдресаФИАС.Индекс);
			ЭлементыАдреса1.Добавить(СтруктураАдресаФИАС.Регион);
			ЭлементыАдреса1.Добавить(СтруктураАдресаФИАС.Город);
			
			ПараметрыМакета.Вставить("Адрес1", СтрЗаменить(СтрСоединить(ЭлементыАдреса1, ", ") + ",", ", ,", ","));
			
			ЭлементыАдреса2 = Новый Массив;
			ЭлементыАдреса2.Добавить(СокрЛП(СтруктураАдресаФИАС.Улица));
			
			Для Каждого АдресныйЭлемент Из СтруктураАдресаФИАС.ДополнительныеАдресныеЭлементы Цикл
				ЭлементыАдреса2.Добавить(ТипыАдресныхЭлементов.Получить(АдресныйЭлемент.Тип) + Символы.НПП + АдресныйЭлемент.Значение);
			КонецЦикла;

			ПараметрыМакета.Вставить("Адрес2", СтрЗаменить(СтрСоединить(ЭлементыАдреса2, ", "), ", ,", ","));
			
			ОбластьБланк.Параметры.Заполнить(Выборка);
			ОбластьБланк.Параметры.Заполнить(ПараметрыМакета);
			
			Если ЗначениеЗаполнено(Выборка.ИмяЛоготипа) Тогда
				ОбластьБланк.Рисунки[Выборка.ИмяЛоготипа].Картинка = Новый Картинка(ПолучитьОбщийМакет(Выборка.ИмяЛоготипа));
			КонецЕсли; 
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В системе отсутствует официальный бланк организации %1.", Организация.ЮрФизЛицо),,,, Отказ);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутсвует анкета юридического лица %1. Формирование официального бланка невозможно.", Организация.ЮрФизЛицо),,,, Отказ);
	КонецЕсли;
	
	Возврат ОбластьБланк;
	
КонецФункции

Функция ПолучитьДолгосрочныеИКраткосрочныеАктивы(Организация, СчетДоверительногоУправления, Период) Экспорт
	
	// описание запросов
	// _Настройка - Берем настройки классификации видов активов по сроку и счета учета активов:
	// Если счет не задан, определеям счет по уомлчанию. 
	// Запрос повторяет логику функций БухгалтерскийУчет.ОпределитьСчетУчетаАктивов() и БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов()
	// _Партии: ПарпииЦеннныхБумаг + ПартииЦенныхБумагПроданныеВРепо + ПартииЦенныхБумагКупленныеПоРЕПО + Депозиты
	// _ЦенныеБумаги. Из таблицы _Партии. Далее определяем параметры
	// _ЦенныеБумагиИУчетныеАктивы - определяем учетные активы для ценных бумаг. Перенос логики функции БухгалтерскийУчет.ОпределитьУчетныйАктив() 
	// _ПараметрыЦенныхБумаг: Ценные бумаги, + учетные активы + настройки активов по срочности + счета учета (для бумаг в залоге, для купона отдельно)
	// _ПартииИСрочность. Соединяем _Партии и _ПараметрыЦенныхБумаг. 
	// Для сделок РЕПО дату погашения берем из регистра УсловияСделокРЕПО.
	// Расчитываем поля Стоимость и СтроимостьКупона. Оставлем только суммы, которые хранятся на счете 58, 76 не учитываем 
	// _ИтоговаяТаблица
	// для каждой партии определем краткосрочная или долгосрочная она. 
	// если КлассификацияПоСрочностиЦБ не задана, партию считаем краткосрочной 
	// для опреления срочности нужны дата покупки, отчетная дата и дата погашения бумаги 
	// возможны три варианта: от отчетной даты до погашения (основной), от даты покупик до погашения, от даты покупик до даты погашения. 
	// если для купона не задана классификация срочности, то купон считаем по сроку погашения тела 
	// _Активы. По данным таблицы  _ИтоговаяТаблица расчтываем суммы краткосчроных и долгосрочных активов
	// _Баланс. Для провеки. Берем остаток счетов 58, 59 и 55.5 (депозиты)
		
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности КАК КлассификацияАктиваПоСрочности,
	|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитныеВклады)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ДепозитныеСчета)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Акции)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.АкцииИностранныхЭмитентов)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Паи)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Векселя)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Векселя)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтныеВалютные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ВекселяВалютные)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентныеВалютные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ВекселяВалютные)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.КорпоративныеОблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ГосударственныеОблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.КорпоративныеОблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ГосударственныеОблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииКупон)
	|				КОНЕЦ
	|		ИНАЧЕ НастройкиУчетаАктивовСрезПоследних.СчетУчета
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитныеВклады)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаАкций)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаАкцийИностранныхЭмитентов)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаПаев)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселей)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселей)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтныеВалютные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселейВалютных)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентныеВалютные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселейВалютных)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаКорпоративныхОблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаГосударственныхОблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаКорпоративныхОблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаГосударственныхОблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийКупон)
	|				КОНЕЦ
	|		ИНАЧЕ НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки
	|	КОНЕЦ КАК СчетУчетаПереоценки,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчетаВЗалоге = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.АкцииВЗалоге)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.АкцииИностранныхЭмитентовВЗалоге)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПаиВЗалоге)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ВекселяВЗалоге)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ВекселяВЗалоге)
