		Результат.Вставить("_ВводыУровень", МВТ.Таблицы.Найти("_ВводыУровень").ПолучитьДанные().Выгрузить());
		Результат.Вставить("_ВыводыУровень", МВТ.Таблицы.Найти("_ВыводыУровень").ПолучитьДанные().Выгрузить());
		Результат.Вставить("_УровниЦБ_нужные", МВТ.Таблицы.Найти("_УровниЦБ_нужные").ПолучитьДанные().Выгрузить());
	КонецЕсли;

	Результат.Вставить("_Показатели", МВТ.Таблицы.Найти("_Показатели").ПолучитьДанные().Выгрузить());
	
	Возврат Результат;
	
КонецФункции 	

Процедура ПолучитьДанныеДляИнформацииПоКредитнымРейтингам(Запрос) Экспорт
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
		|	ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) КАК Тип,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения,
		|	ВЫБОР
		|		КОГДА НачислениеСписаниеРезервовПартии.ЗначениеРейтинга = ""Профсуждение""
		|				ИЛИ НачислениеСписаниеРезервовПартии.ЗначениеРейтинга = ""Государственные бумаги""
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(ЗначенияРейтингов.СтрокаСопоставления, 5)
		|	КОНЕЦ КАК СтрокаСопоставления,
		|	НачислениеСписаниеРезервовПартии.EAD КАК Сумма,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.Родитель ЕСТЬ NULL
		|			ТОГДА ""СС""
		|		КОГДА БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.Родитель В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток))
		|			ТОГДА ""СС""
		|		ИНАЧЕ ""АС""
		|	КОНЕЦ КАК ВидАктива,
		|	НачислениеСписаниеРезервовПартии.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ЗначенияРейтингов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(НачислениеСписаниеРезервовПартии.Актив КАК Справочник.Облигации).ВалютаНоминала
		|		ИНАЧЕ &ВалютаУчета
		|	КОНЕЦ КАК ВалютаНоминала
		|ПОМЕСТИТЬ _РезервыПредварительно
		|ИЗ
		|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			РейтингиСрезПоследних.ЗначениеРейтинга.Наименование КАК ЗначениеРейтинга,
		|			МИНИМУМ(ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления, 5)) КАК СтрокаСопоставления,
		|			МАКСИМУМ(РейтингиСрезПоследних.РейтинговоеАгентство) КАК РейтинговоеАгентство
		|		ИЗ
		|			РегистрСведений.Рейтинги.СрезПоследних(&КонецПериода, ) КАК РейтингиСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&ДатаРейтинга, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|				ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
		|					И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			РейтингиСрезПоследних.ЗначениеРейтинга.Наименование) КАК ЗначенияРейтингов
		|		ПО НачислениеСписаниеРезервовПартии.ЗначениеРейтинга = ЗначенияРейтингов.ЗначениеРейтинга
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ПО НачислениеСписаниеРезервовПартии.Актив = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И НачислениеСписаниеРезервовПартии.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И НачислениеСписаниеРезервовПартии.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|ГДЕ
		|	НачислениеСписаниеРезервовПартии.Ссылка В
		|			(ВЫБРАТЬ
		|				НачислениеСписаниеРезервов.Ссылка КАК Ссылка
		|			ИЗ
		|				Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
		|			ГДЕ
		|				НачислениеСписаниеРезервов.Организация = &Организация
		|				И НачислениеСписаниеРезервов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И НачислениеСписаниеРезервов.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
		|				И НАЧАЛОПЕРИОДА(НачислениеСписаниеРезервов.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ)
		|				И НачислениеСписаниеРезервов.ПереходНаМСФО9 = &ПереходНаМСФО9
		|				И НачислениеСписаниеРезервов.Проведен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Резервы.Актив КАК Актив,
		|	_Резервы.Тип КАК Тип,
		|	_Резервы.СтадияОбесценения КАК СтадияОбесценения,
		|	_Резервы.СтрокаСопоставления КАК СтрокаСопоставления,
		|	СУММА(ВЫРАЗИТЬ(_Резервы.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2))) КАК Сумма,
		|	_Резервы.ВидАктива КАК ВидАктива,
		|	_Резервы.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_Резервы.РейтинговоеАгентство КАК РейтинговоеАгентство
		|ПОМЕСТИТЬ _Резервы
		|ИЗ
		|	_РезервыПредварительно КАК _Резервы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО _Резервы.ВалютаНоминала = КурсыВалют.Валюта
		|			И (КурсыВалют.Период = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	_Резервы.Актив,
		|	_Резервы.Тип,
		|	_Резервы.СтадияОбесценения,
		|	_Резервы.СтрокаСопоставления,
		|	_Резервы.ЗначениеРейтинга,
		|	_Резервы.РейтинговоеАгентство,
