#Область Вывод_подписей_в_отчетах

Функция ПолучитьДанныеВыбораКонтактныхЛиц(Объект, СтрокаПоиска) Экспорт
	
	КонтактныеЛица = Новый СписокЗначений;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Подразделение КАК Подразделение,
		|	КонтактныеЛица.Язык КАК Язык,
		|	КонтактныеЛица.Объект КАК Объект,
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо,
		|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛица.КонтактноеЛицо) КАК ПредставлениеКонтактноеЛицо
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Подразделение = &Подразделение
		|	И КонтактныеЛица.Язык = &Язык
		|	И КонтактныеЛица.Объект = &Объект
		|	И ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(КонтактныеЛица.КонтактноеЛицо) = ТИП(СТРОКА)
		|				ТОГДА КонтактныеЛица.КонтактноеЛицо ПОДОБНО &СтрокаПоиска + ""%""
		|			ИНАЧЕ КонтактныеЛица.КонтактноеЛицо.Наименование ПОДОБНО &СтрокаПоиска + ""%""
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(КонтактныеЛица.КонтактноеЛицо) = ТИП(СТРОКА)
		|			ТОГДА КонтактныеЛица.КонтактноеЛицо
		|		ИНАЧЕ КонтактныеЛица.КонтактноеЛицо.Наименование
		|	КОНЕЦ");
	
	ОбъектЛица = Объект;
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
		ОбъектЛица = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "ЮрФизЛицо");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Подразделение",	Справочники.Подразделения.ГруппаКомпаний);
	Запрос.УстановитьПараметр("Язык",			Справочники.Языки.Русский);
	Запрос.УстановитьПараметр("Объект",			ОбъектЛица);
	Запрос.УстановитьПараметр("СтрокаПоиска",	СтрокаПоиска);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	СтруктураКлюча = Новый Структура("Подразделение, Язык, Объект, КонтактноеЛицо");	
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураКлюча, ВыборкаЗапроса);
		КонтактныеЛица.Добавить(РегистрыСведений.КонтактныеЛица.СоздатьКлючЗаписи(СтруктураКлюча), ВыборкаЗапроса.КонтактноеЛицо);	
	КонецЦикла;
	
	Возврат КонтактныеЛица;
	
КонецФункции

// Функция - Получить параметры формы выбора контактного лица
//
// Параметры:
//  Параметры	 - Параметры - Структура
// 
// Возвращаемое значение:
//  Структура - Содержит параметры Отбор и ТекущаяСтрока для формы выбора из списка регистра сведений Контактные лица
//
Функция ПолучитьПараметрыФормыВыбораКонтактногоЛица(Параметры) Экспорт

	// Определяем объект контактного лица
	
	Объект = Неопределено;
	
	Если Параметры.Свойство("Объект") Тогда
		Объект = Параметры.Объект;
	ИначеЕсли Параметры.Свойство("Организация") Тогда
		Объект = Параметры.Организация;		
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации")  Тогда 
		Объект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "ЮрФизЛицо");	
	КонецЕсли;		
		
	// Формируем структуру ключа	
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение",	Справочники.Подразделения.ГруппаКомпаний);
    СтруктураКлюча.Вставить("Язык", 			Справочники.Языки.Русский);
	СтруктураКлюча.Вставить("Объект", 			Объект);
		
	ПараметрыФормы = Новый Структура;    
	ПараметрыФормы.Вставить("Отбор", Новый Структура(Новый ФиксированнаяСтруктура(СтруктураКлюча)));
	
	Если ЗначениеЗаполнено(Параметры.КонтактноеЛицо) Тогда
		
		СтруктураКлюча.Вставить("КонтактноеЛицо", Параметры.КонтактноеЛицо);
		
		ПараметрыФормы.Вставить("ТекущаяСтрока", РегистрыСведений.КонтактныеЛица.СоздатьКлючЗаписи(СтруктураКлюча));
	
	КонецЕсли;
	
	Возврат ПараметрыФормы;

КонецФункции

// Функция - Получить контактное лицо из ключа
//
// Параметры:
//  Ключ							 - РегистрСведенийКлючЗаписи.КонтактныеЛица, Структура
// 
// Возвращаемое значение:
// Структура - Все данные записи регистра сведений КонтактныеЛица по переданному ключу
//
Функция ПолучитьДанныеКонтактногоЛицаПоКлючу(Ключ) Экспорт

	Если ЗначениеЗаполнено(Ключ) Тогда
		
		СтруктураДанныхКонтактногоЛица = Новый Структура;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	*
		               |ИЗ
		               |	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		               |ГДЕ
		               |	КонтактныеЛица.Подразделение = &Подразделение
		               |	И КонтактныеЛица.Язык = &Язык
		               |	И КонтактныеЛица.Объект = &Объект
		               |	И КонтактныеЛица.КонтактноеЛицо = &КонтактноеЛицо";
					   
		Если ТипЗнч(Ключ) = Тип("Структура") И Не ТипЗнч(Ключ.Объект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
			Ключ.Объект = Ключ.Объект.ЮрФизЛицо;
		КонецЕсли; 
					   
		Для каждого Измерение Из Метаданные.РегистрыСведений.КонтактныеЛица.Измерения Цикл
			Запрос.УстановитьПараметр(Измерение.Имя, Ключ[Измерение.Имя]);
		КонецЦикла;
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
		
			Для каждого Колонка Из Результат.Колонки Цикл
			
				СтруктураДанныхКонтактногоЛица.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
			
			КонецЦикла; 
		
		КонецЕсли; 
		
		Возврат СтруктураДанныхКонтактногоЛица;
		
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьДанныеКонтактногоЛица(КонтактноеЛицо, Объект) Экспорт
	
	КлючКонтактногоЛица = Новый Структура;
	КлючКонтактногоЛица.Вставить("Подразделение", 	Справочники.Подразделения.ГруппаКомпаний);
    КлючКонтактногоЛица.Вставить("Язык", 			Справочники.Языки.Русский);
    КлючКонтактногоЛица.Вставить("Объект", 			Объект);
    КлючКонтактногоЛица.Вставить("КонтактноеЛицо", 	КонтактноеЛицо);
			
	Возврат ПолучитьДанныеКонтактногоЛицаПоКлючу(КлючКонтактногоЛица);
	
КонецФункции

Функция ПолучитьПодписантаПоУмолчанию(Знач Отчет, Организация = Неопределено) Экспорт
	
	// Подписанта берем из настроек формирования клиентских отчетов 	
	
	Если ТипЗнч(Отчет) = Тип("Строка") Тогда
		
		КлиентскийОтчет = ПолучитьКлиентскийОтчетПоКлючу(Отчет);
		
		Если КлиентскийОтчет = Неопределено Тогда
			КлиентскийОтчет = ПолучитьПредопределеннуюГруппуОтчета(Отчет);
		КонецЕсли;
		
	Иначе
		
		КлиентскийОтчет = Отчет;	
		
	КонецЕсли;
	
	// Если клиентский отчет один, то берем его настройки.
	// Если их несколько, то берем настройки верхней группы отчета
	
	Если ТипЗнч(КлиентскийОтчет) = Тип("Массив") Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЕСТЬNULL(ОтчетыРодитель2.Ссылка, ЕСТЬNULL(ОтчетыРодитель1.Ссылка, Отчеты.Ссылка)) КАК ГруппаОтчета
			|ИЗ
			|	Справочник.Отчеты КАК Отчеты
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Отчеты КАК ОтчетыРодитель1
			|		ПО (ОтчетыРодитель1.Ссылка = Отчеты.Родитель)
			|			И (Отчеты.Родитель <> ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка))
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Отчеты КАК ОтчетыРодитель2
			|		ПО (ОтчетыРодитель2.Ссылка = ОтчетыРодитель1.Родитель)
			|			И (ОтчетыРодитель1.Родитель <> ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка))
			|ГДЕ
			|	Отчеты.Ссылка В(&Отчеты)");
		
		Запрос.УстановитьПараметр("Отчеты", КлиентскийОтчет);
		
		ГруппаОтчета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
		Если ГруппаОтчета.Количество() = 1 Тогда
			КлиентскийОтчет = ГруппаОтчета[0];
		Иначе // Если клиентские отчеты находятся в разных группах, то ничего не берем
			КлиентскийОтчет = ПолучитьПредопределеннуюГруппуОтчета(Отчет);
		КонецЕсли;

	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлиентскийОтчет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Организация = Неопределено Тогда
		Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;	
	
	Подписант = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройкиОтчета(КлиентскийОтчет, "Подписант", Организация, ТекущаяДатаСеанса());	
	Если Подписант = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Возврат ПолучитьДанныеКонтактногоЛица(Подписант, Организация);
	
КонецФункции

Функция ПолучитьКлиентскийОтчетПоКлючу(Знач КлючОтчета) Экспорт
	
	Если ТипЗнч(КлючОтчета) = Тип("Строка") Тогда
		
		Если СтрНачинаетсяС(КлючОтчета, "Отчет.") Тогда
			
			КлючОтчета = Сред(КлючОтчета, СтрДлина("Отчет.") + 1); 
			
		ИначеЕсли СтрНачинаетсяС(КлючОтчета, "ВнешнийОтчет.") Тогда
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
				|ГДЕ
				|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОтчета");
			
			Запрос.УстановитьПараметр("ИмяОтчета", Сред(КлючОтчета, СтрДлина("ВнешнийОтчет.") + 1)); 
			
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			
			КлючОтчета = ?(РезультатЗапроса.Следующий(), РезультатЗапроса.Ссылка, Неопределено);
			
		КонецЕсли;

	КонецЕсли;
	
	Если КлючОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отчеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|ГДЕ
		|	Отчеты.Ключ = &КлючОтчета
		|	И Отчеты.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("КлючОтчета", КлючОтчета); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		РезультатФункции = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	КонецЕсли;
	
	Возврат ?(РезультатФункции.Количество() = 1, РезультатФункции[0], РезультатФункции);
	
КонецФункции

Функция ПолучитьПредопределеннуюГруппуОтчета(КлючОтчета)
	
	// Отчеты, про которые мы знаем, что они бухгалтерские

	Если КлючОтчета = "Отчет.РегламентированныйОтчетБалансРСБУ"
		ИЛИ КлючОтчета = "ВнешнийОтчет._ОтчетОСостоянииПортфеля"
	Тогда
		Возврат Справочники.Отчеты.НайтиПоКоду("000000011"); // Бухгалтерия УК	
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция - Получить контактное лицо
// Заготовка на будущее. Должна возвращать контактное лицо по набору параметров
// Параметры:
//  Параметры	 - Структура - Содержит параметры отбора контактного лица (Организация, Функциональная роль, Отчет, Счет ДУ и тд)
// 
// Возвращаемое значение:
// СправочникСсылка.ЮрФизЛицо - Контактное лицо по указанным параметрам
//
Функция ПолучитьКонтактноеЛицо(Параметры) Экспорт
	
	Возврат Параметры.КонтактноеЛицо;
	
КонецФункции

// Процедура - Выполнить компоновку программно
//
// Параметры:
//  ОтчетОбъект				 - ОтчетОбъект, ВнешнийОтчет - отчет, формируемый при помощи СКД 
//  ДокументРезультат		 - ТабличныйДокумент - см. описание параметров процедуры ПриКомпоновкеРезультата 
//  ДанныеРасшифровки		 - ДанныеРасшифровкиКомпоновкиДанных - см. описание параметров процедуры ПриКомпоновкеРезультата 
//  СтандартнаяОбработка	 - Булево - Выходной параметр, см. описание параметров процедуры ПриКомпоновкеРезультата
//                               Всегда устанавливается в значение Ложь 
//  ПараметрыВыводаПодписей	 - Структура - см. описание в процедуре РаботаСОтчетами.ВывестиПодписи
//	КлючПараметровПечати	 - Строка - ключ значения, в котором сохраняются параметры печати таблицы
//                               Если не указано, устанавливается полное имя отчета 
//	НастройкиПечати			 - Структура - структура с параметрами печати (см. описание параметров процедуры ЗаполнитьНастройкиПечати)
//
Процедура ВыполнитьКомпоновкуПрограммно(ОтчетОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, 
										ПараметрыВыводаПодписей = Неопределено, КлючПараметровПечати = Неопределено, 
										НастройкиПечати = Неопределено, ВнешниеНаборыДанных = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	СтандартнаяОбработка = Ложь;
	
	РегистрацияСтатистики = Истина;
	МенеджерВременныхТаблиц = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
	
		Если ДополнительныеПараметры.Свойство("РегистрацияСтатистики") Тогда
			РегистрацияСтатистики = ДополнительныеПараметры.РегистрацияСтатистики;
		КонецЕсли; 
		ДополнительныеПараметры.Свойство("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	КонецЕсли; 
		
	Если РегистрацияСтатистики Тогда
	
		// Организуем сбор статистики
		ПолноеИмяОтчета = ОтчетОбъект.Метаданные().ПолноеИмя();
		СессияСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюКомпоновкиСКД(ОтчетОбъект, ПолноеИмяОтчета);			
	
	КонецЕсли;
	
	// Стандартная компоновка отчета	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ОтчетОбъект.СхемаКомпоновкиДанных,  ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина, , МенеджерВременныхТаблиц);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Если ТипЗнч(ПараметрыВыводаПодписей) = Тип("Структура") Тогда
		ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);
	КонецЕсли; 
	
	Если РегистрацияСтатистики Тогда
		// Завершаем сессию сбора статистики
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики); 	
	КонецЕсли;
	
	// Заполняем настройки печати
	Если КлючПараметровПечати = Неопределено Тогда
		КлючПараметровПечати = ПолноеИмяОтчета;
	КонецЕсли;
	
	АвтоМасштаб	= Неопределено;
	Ориентация	= Неопределено; 
	Поля		= Неопределено;
	
	Если ТипЗнч(НастройкиПечати) = Тип("Структура") Тогда
		НастройкиПечати.Свойство("АвтоМасштаб", АвтоМасштаб);
		НастройкиПечати.Свойство("Ориентация", Ориентация);
		НастройкиПечати.Свойство("Поля", Поля);
	КонецЕсли;
	
	ЗаполнитьНастройкиПечати(ДокументРезультат, КлючПараметровПечати, АвтоМасштаб, Ориентация, Поля);	
КонецПроцедуры

// Процедура - Вывести подписи
//
// Параметры:
//  ДокументРезультат		 - ТабличныйДокумент - Табличный документ, к которому будет добавлена область подписей
//  ПараметрыВыводаПодписей	 - Структура - Структура обязательно должна содержать свойство "ИмяОбласти", содержащее 
//											имя присоединяемой области макета "ОбщиеОбластиСтандартногоОтчета"
//											остальные свойства могут содержать значения параметров областиданной области
//
Процедура ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей) Экспорт

	Макет = ПолучитьОбщийМакет("ОбщиеОбластиСтандартногоОтчета");
	ОбластьПодписи = Макет.ПолучитьОбласть(ПараметрыВыводаПодписей.ИмяОбласти);
	ОбластьПодписи.Параметры.Заполнить(ПараметрыВыводаПодписей);
	ДокументРезультат.Вывести(ОбластьПодписи);

КонецПроцедуры

#КонецОбласти

#Область Работа_с_вариантами_отчета

// Заполняет свойства формы КлючТекущегоВарианта и ПредставлениеТекущегоВарианта по данным справочника ВариантыОтчетов
Процедура ЗаполнитьВариантОтчета(ЭтаФорма) Экспорт

	Если ТипЗнч(ЭтаФорма.КлючТекущегоВарианта) = Тип("УникальныйИдентификатор") Тогда
		Возврат;
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВариантыОтчетов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
			|ГДЕ
			|	ВариантыОтчетов.ИмяПредопределенногоВарианта = &ИмяПредопределенногоВарианта
			|	И ВариантыОтчетов.ПредопределенныйВариант
			|	И НЕ ВариантыОтчетов.ПометкаУдаления
			|	И ВариантыОтчетов.Ключ = &Ключ";
		
		Запрос.УстановитьПараметр("ИмяПредопределенногоВарианта", ЭтаФорма.КлючТекущегоВарианта);
		Запрос.УстановитьПараметр("Ключ", Лев(ЭтаФорма.ИмяФормы, СтрНайти(ЭтаФорма.ИмяФормы, ".", , , 2)-1));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЭтаФорма.КлючТекущегоВарианта = Выборка.Ссылка.УникальныйИдентификатор();
			ЭтаФорма.ПредставлениеТекущегоВарианта = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Устарел, использовать РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета 
Процедура ЗапомнитьКлючВариантаОтчета(Отчет, КлючВарианта) Экспорт
	ДополнительныеСвойстваОтчета = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;	
	ДополнительныеСвойстваОтчета.Вставить("КлючВарианта", КлючВарианта);
	
	Если ТипЗнч(КлючВарианта) = Тип("Строка") Тогда
		ИмяПредопределенногоВарианта = КлючВарианта;
	Иначе
		Вариант = Справочники.ВариантыОтчетов.ПолучитьСсылку(КлючВарианта);
		
		ИмяПредопределенногоВарианта = Вариант.ИмяПредопределенногоВарианта;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПредопределенногоВарианта) Тогда
		ДополнительныеСвойстваОтчета.Вставить("ИмяПредопределенногоВарианта", ИмяПредопределенногоВарианта);
	ИначеЕсли Не ДополнительныеСвойстваОтчета.Свойство("ИмяПредопределенногоВарианта") Тогда
		ДополнительныеСвойстваОтчета.Вставить("ИмяПредопределенногоВарианта", Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вариант) Тогда
		ДополнительныеСвойстваОтчета.Вставить("ПредставлениеВарианта", Вариант.Наименование);
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьСвойстваВариантаОтчета(КлючВарианта) Экспорт
	ДополнительныеСвойстваОтчета = Новый Структура;	
	ДополнительныеСвойстваОтчета.Вставить("КлючВарианта", КлючВарианта);
	
	Если ТипЗнч(КлючВарианта) = Тип("Строка") Тогда
		ИмяПредопределенногоВарианта = КлючВарианта;
	Иначе
		Вариант = Справочники.ВариантыОтчетов.ПолучитьСсылку(КлючВарианта);
		
		ИмяПредопределенногоВарианта = Вариант.ИмяПредопределенногоВарианта;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПредопределенногоВарианта) Тогда
		ДополнительныеСвойстваОтчета.Вставить("ИмяПредопределенногоВарианта", ИмяПредопределенногоВарианта);
	ИначеЕсли Не ДополнительныеСвойстваОтчета.Свойство("ИмяПредопределенногоВарианта") Тогда
		ДополнительныеСвойстваОтчета.Вставить("ИмяПредопределенногоВарианта", Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вариант) Тогда
		ДополнительныеСвойстваОтчета.Вставить("ПредставлениеВарианта", Вариант.Наименование);
	КонецЕсли;
	
	Возврат ДополнительныеСвойстваОтчета;
КонецФункции

#КонецОбласти

#Область Печать_произвольных_таблиц

// Возвращает структуру параметров вывода таблицы значений в табличный документ
//
// Параметры:
//   ВыводимыеОбласти - Строка - (Необязательный) имена областей макета, разделенные запятыми
//		Может содежать следующие области: ЗаголовокОтчета, ЗаголовокТаблицы, ПолеШапки, ПолеТаблицы, РазделительТаблиц 
//		Если параметр не задан, выводятся все области
//		Если какой-то области нет, то поля, соответствующие этой области, не выводятся.
//   ЗаголовокОтчета - Строка - (Необязательный) Заголовок отчета
//   Макет - ТабличныйДокумент - (Необязательный) если не задан - используется общий макет МакетВыводаТаблицыЗначений
Функция ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(ЗаголовокОтчета = "", ВыводимыеОбласти = "ЗаголовокОтчета,ЗаголовокТаблицы,ПолеШапки,ПолеТаблицы,РазделительТаблиц", Макет = Неопределено, ДокументРезультат = Неопределено) Экспорт

	ПараметрыВывода = Новый Структура;
	ПараметрыВывода.Вставить("ШиринаКолонок", Новый Соответствие);
	
	Если ДокументРезультат = Неопределено Тогда
		ДокументРезультат = Новый ТабличныйДокумент;	
	КонецЕсли; 
	
	ДокументРезультат.ТолькоПросмотр		= Истина;
	ДокументРезультат.ОтображатьЗаголовки	= Ложь;
	ДокументРезультат.ОтображатьСетку		= Ложь;
	
	ПараметрыВывода.Вставить("ДокументРезультат", ДокументРезультат);
	
	Если Макет = Неопределено Тогда
		Макет = ПолучитьОбщийМакет("МакетВыводаТаблицыЗначений");
	КонецЕсли; 
	
	ИменаОбластей = СтрРазделить(СтрЗаменить(ВыводимыеОбласти, " ", ""), ",", Ложь);
	
	Для каждого ИмяОбласти Из ИменаОбластей Цикл
		ПараметрыВывода.Вставить(ИмяОбласти, Макет.ПолучитьОбласть(ИмяОбласти));
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(ЗаголовокОтчета) Тогда
		ПараметрыВывода.ЗаголовокОтчета.Параметры.Поле = ЗаголовокОтчета;
		ДокументРезультат.Вывести(ПараметрыВывода.ЗаголовокОтчета);
	КонецЕсли; 
	
	Возврат ПараметрыВывода;
	
КонецФункции
 
// Выводит переданную таблицу значений в табличный документ
//
// Параметры:
//   ДокументРезультат - ТабличныйДокумент - заполняемый документ
//   Таблица - ТаблицаЗначений - таблица с данными
//   СтруктураТаблицы - Структура - поля таблицы, выводимые в документ.
//		Начальные значения структуры выводятся в шапке таблицы.
//		После выполнения процедуры структура содержит максимальную ширину выведенных значений
//   ПараметрыОформления - Структура - области макета, используемые для оформления полей.
//		Может содежать следующие области: ЗаголовокТаблицы, ПолеШапки, ПолеТаблицы, РазделительТаблиц 
//		Если какой-то области нет, то поля, соответствующие этой области, не выводятся.
//   Заголовок - Строка - (Необязательный) Заголовок выводимой таблицы
//   СворачиватьГруппыСтрок - Булево - (Необязательный)
//   РаскрашиватьЗначенияПоТипу - Булево - (Необязательный) В зависимости от типа значения будет подобран цвет текста ячейки
//
Процедура ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, Знач Таблица, СтруктураТаблицы = Неопределено, Заголовок = Неопределено, СворачиватьГруппыСтрок = Ложь, РаскрашиватьЗначенияПоТипу = Ложь) Экспорт
	
	ДокументРезультат = ПараметрыВывода.ДокументРезультат;	
	
	Если СтруктураТаблицы = Неопределено Тогда
		// Получаем описание колонок таблицы
		СтруктураТаблицы = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтруктураТаблицы.Вставить(Колонка.Имя, ?(ЗначениеЗаполнено(Колонка.Заголовок), Колонка.Заголовок, Колонка.Имя)); 			
		КонецЦикла;
	КонецЕсли; 
	
	ШиринаКолонок = Новый Структура;
	Для Каждого КлючЗнч Из СтруктураТаблицы Цикл
		ШиринаКолонок.Вставить(КлючЗнч.Ключ, 0);
	КонецЦикла;

	СобственныйФорматСтрок = ПараметрыВывода.Свойство("СобственныйФорматСтрок") И ПараметрыВывода.СобственныйФорматСтрок = Истина;	
	Если СобственныйФорматСтрок Тогда
		НомерНачальнойСтроки = Макс(ДокументРезультат.ВысотаТаблицы, 1);
	КонецЕсли;
	
	НачатаГруппировкаСтрок = Ложь;
	
	// Выводим заголовок, если он и его оформление указаны
	ЗаголовокТаблицы = Неопределено;
	Если ПараметрыВывода.Свойство("ЗаголовокТаблицы", ЗаголовокТаблицы) И ЗначениеЗаполнено(Заголовок) Тогда
		ЗаголовокТаблицы.Параметры.Поле = Заголовок;			
		ДокументРезультат.Вывести(ЗаголовокТаблицы);
	КонецЕсли;
	
	// Выводим шапку таблицы, если указано ее оформление
	ПолеШапки = Неопределено;
	Если ПараметрыВывода.Свойство("ПолеШапки", ПолеШапки) Тогда
		Если Не НачатаГруппировкаСтрок Тогда
			ДокументРезультат.НачатьГруппуСтрок(, Не СворачиватьГруппыСтрок);
			НачатаГруппировкаСтрок = Истина;	
		КонецЕсли;
		
		ПерваяКолонка = Истина;
		Для Каждого ПолеСтруктуры Из СтруктураТаблицы Цикл
			ПолеШапки.Параметры.Поле = ПолеСтруктуры.Значение;			
			Если ПерваяКолонка Тогда
				ПерваяКолонка = Ложь;
				ДокументРезультат.Вывести(ПолеШапки);
			Иначе
				ДокументРезультат.Присоединить(ПолеШапки);
			КонецЕсли;
			ШиринаКолонок[ПолеСтруктуры.Ключ] = Макс(ШиринаКолонок[ПолеСтруктуры.Ключ], СтрДлина(ПолеСтруктуры.Значение) + 1);
		КонецЦикла;
	КонецЕсли;

	// Выводим тело таблицы, если указано его оформление
	ПолеТаблицы = Неопределено;
	Если ПараметрыВывода.Свойство("ПолеТаблицы", ПолеТаблицы) Тогда
		Если Не НачатаГруппировкаСтрок Тогда
			ДокументРезультат.НачатьГруппуСтрок(, Не СворачиватьГруппыСтрок);
			НачатаГруппировкаСтрок = Истина;	
		КонецЕсли;
		
		НомерСтроки = 0;
		ВыводитьНомерСтроки = СтруктураТаблицы.Свойство("НомерСтроки");
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			ЗаполнитьЗначенияСвойств(СтруктураТаблицы, СтрокаТаблицы);
			Если ВыводитьНомерСтроки Тогда
				НомерСтроки = НомерСтроки + 1;
				СтруктураТаблицы.НомерСтроки = НомерСтроки;
			КонецЕсли;
			
			ПерваяКолонка = Истина;
			Для Каждого ПолеСтруктуры Из СтруктураТаблицы Цикл
				Если РаскрашиватьЗначенияПоТипу Тогда
					Оформление = ПараметрыДляОтображенияЯчейки(ПолеСтруктуры.Значение);
					ПолеТаблицы.Параметры.Поле = Оформление.Текст;			
					
					Ячейка = ПолеТаблицы.ТекущаяОбласть;
					Ячейка.Расшифровка	= Оформление.Значение;
					Ячейка.ЦветТекста	= Оформление.ЦветТекста;
					Ячейка.ГоризонтальноеПоложение	= Оформление.ГоризонтальноеПоложение;
					Ячейка.Формат	= Оформление.Формат;
					
					ШиринаКолонок[ПолеСтруктуры.Ключ] = Макс(ШиринаКолонок[ПолеСтруктуры.Ключ], Оформление.Ширина + 1);
				Иначе
					ПолеТаблицы.Параметры.Поле = ПолеСтруктуры.Значение;
					
					ШиринаКолонок[ПолеСтруктуры.Ключ] = Макс(ШиринаКолонок[ПолеСтруктуры.Ключ], СтрДлина(ПолеСтруктуры.Значение) + 1);
				КонецЕсли;
				
				Если ПерваяКолонка Тогда
					ПерваяКолонка = Ложь;
					ДокументРезультат.Вывести(ПолеТаблицы);
				Иначе
					ДокументРезультат.Присоединить(ПолеТаблицы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураТаблицы = ШиринаКолонок;
	
	// Закачиваем группировку строк, если данные таблицы были выведены
	Если НачатаГруппировкаСтрок Тогда
		ДокументРезультат.ЗакончитьГруппуСтрок();
	КонецЕсли;
	
	// Выводим разделитель таблиц, если указано его оформление
	РазделительТаблиц = Неопределено;
	Если ПараметрыВывода.Свойство("РазделительТаблиц", РазделительТаблиц) Тогда
		ДокументРезультат.Вывести(РазделительТаблиц);
	КонецЕсли;
	
	// Фиксируем максимальные ширины колонок
	
	Если СобственныйФорматСтрок Тогда
		ШиринаКолонок = Новый Соответствие;
	ИначеЕсли Не СворачиватьГруппыСтрок И ПараметрыВывода.Свойство("ШиринаКолонок") Тогда
		ШиринаКолонок = ПараметрыВывода.ШиринаКолонок;
	Иначе
		ШиринаКолонок = Неопределено;	
	КонецЕсли;	
	
	Если ШиринаКолонок <> Неопределено Тогда 
		ВсегоКолонок = 0; 
		Для Каждого ШиринаКолонки Из СтруктураТаблицы Цикл
			ШиринаКолонок.Вставить(ВсегоКолонок, ?(ШиринаКолонок[ВсегоКолонок] = Неопределено, Макс(ШиринаКолонки.Значение, СтрДлина(ШиринаКолонки.Ключ)), Макс(ШиринаКолонок[ВсегоКолонок], ШиринаКолонки.Значение))); 		
			ВсегоКолонок = ВсегоКолонок + 1;
		КонецЦикла;
	КонецЕсли;
	
	Если СобственныйФорматСтрок Тогда
		РаботаСОтчетами.УстановитьШиринуКолонок(Новый Структура("ДокументРезультат, ШиринаКолонок", ДокументРезультат, ШиринаКолонок), НомерНачальнойСтроки, , Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыДляОтображенияЯчейки(Значение)
	Ячейка = Новый Структура("Значение,Текст,ЦветТекста,Ширина,ГоризонтальноеПоложение,Формат", Значение, Значение, WebЦвета.Черный, 0, ГоризонтальноеПоложение.Авто, "");
	
	Если Ячейка.Значение = NULL Тогда
		Ячейка.Текст = "<NULL>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
	ИначеЕсли Ячейка.Значение = Неопределено Тогда	
		Ячейка.Текст = "<Неопределено>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
	ИначеЕсли Ячейка.Значение = "" Тогда	
		Ячейка.Текст = "<Пустая строка>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("МоментВремени") Тогда	
		Ячейка.Текст = "<МоментВремени>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
	ИначеЕсли  Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) 
		ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) 
		ИЛИ ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) 
		ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение))
		ИЛИ ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение))
		ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение))
	Тогда
		Если Ячейка.Значение.Пустая() Тогда
			Если  Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "Справочник.";
			ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "Документ.";
			ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "ПланСчетов.";
			ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "ПланВидовХарактеристик.";
			ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "ПланВидовРасчета";
			ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда
				пТип = "Перечисление.";
			КонецЕсли;
			Ячейка.Текст = "<Пустая ссылка: " + пТип + ТипЗнч(Ячейка.Значение) + ">";
			Ячейка.ЦветТекста = WebЦвета.Серый;
			Ячейка.Ширина = СтрДлина(Ячейка.Текст);
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда	
			Ячейка.ЦветТекста = WebЦвета.ТемноБордовый;
			Ячейка.Ширина = СтрДлина(Ячейка.Значение);
			// определим по типу
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение))  Тогда	
			Ячейка.ЦветТекста = WebЦвета.КожаноКоричневый;
			Ячейка.Ширина = СтрДлина(Ячейка.Значение);
			// определим по типу
		ИначеЕсли  Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда	
			Если Ячейка.Значение.Предопределенный Тогда
				Ячейка.ЦветТекста = WebЦвета.ТемноБордовый;
			КонецЕсли;		
			Ячейка.Ширина = СтрДлина(Ячейка.Значение.Наименование);
		ИначеЕсли  ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда	
			Если Ячейка.Значение.Предопределенный Тогда
				Ячейка.ЦветТекста = WebЦвета.ТемноБордовый;
			Иначе 
				Ячейка.ЦветТекста = WebЦвета.Томатный;
			КонецЕсли;		
			Ячейка.Ширина = СтрДлина(Ячейка.Значение.Наименование);
		ИначеЕсли  ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда	
			Если Ячейка.Значение.Предопределенный Тогда
				Ячейка.ЦветТекста = WebЦвета.ТемноБордовый;
			Иначе 
				Ячейка.ЦветТекста = WebЦвета.Томатный;
			КонецЕсли;		
			Ячейка.Ширина = СтрДлина(Ячейка.Значение.Наименование);
		ИначеЕсли  ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗнч(Ячейка.Значение)) Тогда	
			Если Ячейка.Значение.Предопределенный Тогда
				Ячейка.ЦветТекста = WebЦвета.ТемноБордовый;
			Иначе 
				Ячейка.ЦветТекста = WebЦвета.Томатный;
			КонецЕсли;		
			Ячейка.Ширина = СтрДлина(Строка(Ячейка.Значение));
		КонецЕсли;
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("Строка") Тогда	
		Ячейка.ЦветТекста = WebЦвета.ТемноЗеленый;
		Ячейка.Ширина = СтрДлина(Ячейка.Значение);
	ИначеЕсли Ячейка.Значение = Дата(1,1,1) Тогда
		Ячейка.Текст = "<Пустая дата>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("Дата") Тогда	
		Ячейка.ЦветТекста = WebЦвета.ТемноСиний;
		Ячейка.Ширина = СтрДлина("00.00.0000 00:00:00");
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда	
		Ячейка.ЦветТекста = WebЦвета.ФуксинТемный;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
		Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		Ячейка.Формат = "ЧН=0";
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("Булево") Тогда	
		Ячейка.ЦветТекста = ?(Ячейка.Значение,WebЦвета.ТемноЗолотистый,WebЦвета.ТемноГрифельноСерый);
	ИначеЕсли ТипЗнч(Ячейка.Значение) = Тип("ТаблицаЗначений") Тогда	
		Ячейка.Текст = "<ТаблицаЗначений>";
		Ячейка.ЦветТекста = WebЦвета.Серый;
		Ячейка.Ширина = СтрДлина(Ячейка.Текст);
		Ячейка.Значение = "Просмотр таблицы значений не реализован";
	КонецЕсли;
	
	Возврат Ячейка;
КонецФункции

Процедура УстановитьШиринуКолонок(ПараметрыВывода, НомерПервойСтроки = Неопределено, НомерПоследнейСтроки = Неопределено, СобственныйФорматСтрок = Ложь) Экспорт

	// Установим ширины колонок для таблицы
	
	ДокументРезультат	= ПараметрыВывода.ДокументРезультат;
	ШиринаКолонок		= ПараметрыВывода.ШиринаКолонок;
	
	НомерПервойСтроки		= ?(НомерПервойСтроки = Неопределено, 1, НомерПервойСтроки);
	НомерПоследнейСтроки	= ?(НомерПоследнейСтроки = Неопределено, ДокументРезультат.ВысотаТаблицы, НомерПоследнейСтроки);
	
	Если СобственныйФорматСтрок Тогда
		ДокументРезультат.Область(НомерПервойСтроки, , НомерПоследнейСтроки, ).СоздатьФорматСтрок();	
	КонецЕсли;
	
	ВсегоКолонок = ШиринаКолонок.Количество(); 
	Для н = 1 По ВсегоКолонок Цикл
		ДокументРезультат.Область(НомерПервойСтроки, н, НомерПоследнейСтроки, н).ШиринаКолонки = Мин(Макс(ШиринаКолонок[н - 1], 3), 100); // Пусть минимальная ширина колонок будет 3, а максимальная - 100
	КонецЦикла;

КонецПроцедуры

Процедура ПодобратьШиринуКолонокТаблицыОтчета(Отчет, НомерПервойСтроки, НомерПервойКолонки, НомерПоследнейСтроки, НомерПоследнейКолонки, МаксШиринаКолонки = 30) Экспорт
	
	МаксИндКолонки = НомерПоследнейКолонки - НомерПервойКолонки;
		
	ШириныКолонок = Новый Массив;
	Для Инд = 0 По МаксИндКолонки Цикл
		ШириныКолонок.Добавить(0);
	КонецЦикла;
	
	Для НомСтр = НомерПервойСтроки По НомерПоследнейСтроки Цикл
		Для Инд = 0 По МаксИндКолонки Цикл
			ДлинаСтроки = СтрДлина(Отчет.Область(НомСтр, НомерПервойКолонки + Инд).Текст);
			Если ДлинаСтроки > ШириныКолонок[Инд] Тогда
				ШириныКолонок[Инд] = ДлинаСтроки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// приведем ширины к максимальной ширине
	Для Инд = 0 По МаксИндКолонки Цикл
		Если ШириныКолонок[Инд] > МаксШиринаКолонки Тогда
			ШириныКолонок[Инд] = МаксШиринаКолонки;
		КонецЕсли;
	КонецЦикла;
	
	// установим ширины колонок для таблицы
	Для Инд = 0 По МаксИндКолонки Цикл
		Отчет.Область(НомерПервойСтроки, НомерПервойКолонки + Инд, Отчет.ВысотаТаблицы, НомерПервойКолонки + Инд).ШиринаКолонки = ШириныКолонок[Инд];
	КонецЦикла;
	
КонецПроцедуры // ПодобратьШиринуКолонокТаблицыОтчета

#КонецОбласти

// Заполняет настройки печати, соответствующие параметрам печати табличного документа
//
// Параметры:
//   ДокументРезультат - ТабличныйДокумент - документ, выводимый на печать
//   КлючПараметровПечати - Строка - ключ значения, в котором сохраняются параметры печати таблицы
//   АвтоМасштаб - Булево - признак автоматического масштабирования
//   Ориентация - ОриентацияСтраницы - ориентация страницы при выводе таблицы на печать (значение по умолчанию = Ландшафт)
//   Поля - Структура - структура с одноименными полями отступа (значения по умолчанию: ПолеСверху = 10, ПолеСправа = 10, ПолеСнизу = 10, ПолеСлева = 10)
//
Процедура ЗаполнитьНастройкиПечати(ДокументРезультат, КлючПараметровПечати, АвтоМасштаб = Истина, Ориентация = Неопределено, Поля = Неопределено) Экспорт
	
	// Если пользователь уже настроил параметры, то ничего не делаем
	Если ЗначениеЗаполнено(ДокументРезультат.КлючПараметровПечати) Тогда
		Возврат;	
	КонецЕсли;
	
	// Ориентация и масштаб
	ДокументРезультат.АвтоМасштаб			= ?(АвтоМасштаб = Неопределено, Истина, АвтоМасштаб);
	ДокументРезультат.ОриентацияСтраницы	= ?(Ориентация = Неопределено, ОриентацияСтраницы.Ландшафт, Ориентация);	
	
	// Поля отступа
	ПолеСверху	= Неопределено;
	ПолеСправа	= Неопределено;
	ПолеСнизу	= Неопределено;
	ПолеСлева	= Неопределено;
	
	Если ТипЗнч(Поля) = Тип("Структура") Тогда
		Поля.Свойство("ПолеСверху", ПолеСверху);
		Поля.Свойство("ПолеСправа", ПолеСправа);
		Поля.Свойство("ПолеСнизу", ПолеСнизу);
		Поля.Свойство("ПолеСправа", ПолеСлева);
	КонецЕсли;
	
	ДокументРезультат.ПолеСверху	= ?(ПолеСверху = Неопределено, 10, ПолеСверху);
	ДокументРезультат.ПолеСправа	= ?(ПолеСправа = Неопределено, 10, ПолеСправа);
	ДокументРезультат.ПолеСнизу		= ?(ПолеСнизу = Неопределено, 10, ПолеСнизу);
	ДокументРезультат.ПолеСлева		= ?(ПолеСлева = Неопределено, 10, ПолеСлева);	
	
	// Грузим переопределенные пользователем параметры
	ДокументРезультат.КлючПараметровПечати	= КлючПараметровПечати;

КонецПроцедуры

// Должна быть хотя бы одна запись в регистрах либо проведенные документы
Функция ПроверитьРегистрациюСЧА(Организация, СчетДоверительногоУправления, Период) Экспорт
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	""ЦенныеБумаги""
		|ИЗ
		|	(
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть данные в регистре"" КАК Запись 
		|		ИЗ
		|			РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки 
		|		ГДЕ
		|			СтоимостьПереоценки.Организация = &Организация
		|				И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|				И СтоимостьПереоценки.Период = &Период
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть проведенный документ"" КАК Запись 
		|		ИЗ
		|			Документ.РегистрацияСтоимостиПереоценки КАК СтоимостьПереоценки 
		|		ГДЕ
		|			СтоимостьПереоценки.Организация = &Организация
		|				И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|				И НАЧАЛОПЕРИОДА(СтоимостьПереоценки.Дата, ДЕНЬ) = &Период
		|				И СтоимостьПереоценки.Проведен
		|	) КАК ЦенныеБумаги
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	""АктивыНеЦБ""
		|ИЗ
		|	(
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть данные в регистре"" КАК Запись 
		|		ИЗ
		|			РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеЦБ 
		|		ГДЕ
		|			СтоимостьАктивовНеЦБ.Организация = &Организация
		|				И СтоимостьАктивовНеЦБ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СтоимостьАктивовНеЦБ.Период = &Период
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть проведенный документ"" КАК Запись 
		|		ИЗ
		|			Документ.РегистрацияСтоимостиАктивов КАК СтоимостьАктивовНеЦБ 
		|		ГДЕ
		|			СтоимостьАктивовНеЦБ.Организация = &Организация
		|				И СтоимостьАктивовНеЦБ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СтоимостьАктивовНеЦБ.ЦельРасчетаСтоимостиОценки = &ЦельРасчета
		|				И НАЧАЛОПЕРИОДА(СтоимостьАктивовНеЦБ.Дата, ДЕНЬ) = &Период
		|				И СтоимостьАктивовНеЦБ.Проведен
		|	) КАК АктивыНеЦБ
		|");
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",							НачалоДня(Период));
	Запрос.УстановитьПараметр("ЦельРасчета",					Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении); 

	Возврат (Запрос.Выполнить().Выгрузить().Количество() = 2); // должно быть 2 записи - и бумаги, и активы не ЦБ
КонецФункции 

Процедура ОтправитьОтчет(НастройкиОтчета, Результат) Экспорт
	
	Получатели = Неопределено;
	АдресОтправителя = Неопределено;
	НастройкиОтчета.Свойство("АдресЭлектроннойПочты",	Получатели);
	НастройкиОтчета.Свойство("АдресОтправителя",		АдресОтправителя);
		
	Если ЗначениеЗаполнено(Получатели) И ЗначениеЗаполнено(АдресОтправителя) Тогда
		
		Если НастройкиОтчета.Свойство("ФайлРезультатаОтчета") Тогда
			Файл = НастройкиОтчета.ФайлРезультатаОтчета;
		Иначе
			Файл = РаботаСОтчетамиКлиентСервер.ПолучитьФайлРезультатаОтчета(НастройкиОтчета, Результат);
		КонецЕсли;		
		
		Если Файл.Существует() Тогда
		
			Организация = НастройкиОтчета.Организация;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны
				|ИЗ
				|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
				|			&ТекущаяДата,
				|			Организация = &Организация
				|				И ЮрФизЛицо = &ЮрФизЛицо
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
			Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
			Запрос.УстановитьПараметр("Организация",	Организация);
			Запрос.УстановитьПараметр("ЮрФизЛицо", 		Организация.ЮрФизЛицо);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				НомерТелефона = Выборка.Телефоны;
			Иначе
				НомерТелефона = "";			
			КонецЕсли; 
			
			Вложения = Новый Соответствие;
			Вложения.Вставить(Файл.Имя, Файл);
			
			АдресОтправителя	= НастройкиОтчета.АдресОтправителя;
			МассивАдресов 		= РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(АдресОтправителя);
			
			Если МассивАдресов.Количество() <> 1 Тогда
				ВызватьИсключение СтрШаблон("Некорректный адрес отправителя: ""%1""", АдресОтправителя);
			Иначе
				СтруктураАдреса = МассивАдресов[0];
			КонецЕсли; 
			
			РеквизитыОтправителя = Новый Структура("ИмяПользователя, АдресЭлектроннойПочты", СтруктураАдреса.Представление, СтруктураАдреса.Адрес); 
			СлепыеКопии			= СтруктураАдреса.Адрес;
			АдресОтвета			= СтруктураАдреса.Адрес;
			ИмяПользователя 	= СтруктураАдреса.Представление;
			
			Тело = 
			"<HTML><HEAD>
			|<BODY>
			|<P>Добрый день.</P>
			|<P>Данное письмо было отправлено Вам автоматически.</P>
			|<P>Для получения информации по возникшим вопросам Вам необходимо связаться с сотрудниками Управляющей компании по телефону " + НомерТелефона + " или отправить сообщение по адресу <a href=""mailto:" + АдресОтвета + """>" + АдресОтвета + "</a></P>
			|</BODY></HTML>";
			
			РеквизитыОтправителя = Новый Структура("ИмяПользователя, АдресЭлектроннойПочты", ИмяПользователя, АдресОтвета); 
			
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Вложения, СлепыеКопии, АдресОтвета, РеквизитыОтправителя", 
				Получатели, 
				Файл.ИмяБезРасширения, 
				Тело, 
				ТипТекстаПочтовогоСообщения.HTML, 
				Вложения, 
				СлепыеКопии, 
				АдресОтвета, 
				РеквизитыОтправителя);
			
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма, , Истина);
						
			КаталогСохранения = РаботаСОтчетамиКлиентСервер.ПолучитьКаталогСохраненияРезультатаОтчета(НастройкиОтчета);
			Если ЗначениеЗаполнено(КаталогСохранения) Тогда
				КопироватьФайл(Файл.ПолноеИмя, КаталогСохранения + Файл.Имя);
			КонецЕсли;
			
			Если Не (НастройкиОтчета.Свойство("НеУдалятьФайлПослеОтправки") И НастройкиОтчета.НеУдалятьФайлПослеОтправки = Истина) Тогда
				УдалитьФайлы(Файл.ПолноеИмя);
			КонецЕсли;			
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыШапки(Период, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&Период КАК ДатаОтчета,
		|	&ПоследнийРабочийДень КАК ПоследнийРабочийДень,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Отчество, 1, 1) + ""."") КАК УчредительУправления,
		|	РеквизитыЮридическихЛицОрганизации.ПолноеНаименованиеПоУставу КАК ДоверительныйУправляющийПолноеНаименование,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.ПолноеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + РеквизитыФизическихЛицКлиента.Имя + "" "" + РеквизитыФизическихЛицКлиента.Отчество) КАК УчредительУправленияПолноеНаименование
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период)));
	Запрос.УстановитьПараметр("ЮрФизЛицо", Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
КонецФункции

Процедура ОтправитьОтчеты(Организация, Отправитель, Получатели, ОтправляемыеОтчеты, ОтложеннаяОтправка = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны
		|ПОМЕСТИТЬ _ТелефонДляОбратнойСвязи
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ТекущаяДата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК АдресДляБухгалтерии
		|ПОМЕСТИТЬ _АдресОтправителяДляБухгалтерскихОтчетов
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&ТекущаяДата,
		|			Организация = &Организация
		|				И Настройка.Код = ""АдресОтправителя""
		|				И Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.Бухгалтерия)
		|				И Субъект = НЕОПРЕДЕЛЕНО
		|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				И Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)";
	
	Запрос.Выполнить();
	ДанныеОНомере				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ТелефонДляОбратнойСвязи"].ПолучитьДанные().Выгрузить();
	ДанныеОбАдресеОтправителя	= Запрос.МенеджерВременныхТаблиц.Таблицы["_АдресОтправителяДляБухгалтерскихОтчетов"].ПолучитьДанные().Выгрузить();
	
	Если ДанныеОНомере.Количество() > 0 Тогда
		НомерТелефона = " " + ДанныеОНомере[0].Телефоны;
	Иначе
		НомерТелефона = "";			
	КонецЕсли;
	
	// Если настройка заполнена верно - берем ее значение, если нет - считаем значение пустым.
	АдресДляБухгалтерии = "";
	
	Если ДанныеОбАдресеОтправителя.Количество() > 0 Тогда
		МассивАдресов = РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(ДанныеОбАдресеОтправителя[0].АдресДляБухгалтерии);
		
		Если МассивАдресов.Количество() = 1 Тогда
			Если ЗначениеЗаполнено(МассивАдресов[0].Адрес) Тогда
				АдресДляБухгалтерии = МассивАдресов[0].Адрес;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Вложения								= Новый Соответствие;
	Файлы									= Новый Массив;
	ОписаниеВложений						= "";
	ОтправленныеРегламентированныеОтчеты	= Новый Массив;
	
	// Формируем список вложений.
	Для Каждого Отчет Из ОтправляемыеОтчеты Цикл
		
		Если Отчет.НастройкиОтчета.Свойство("ФайлРезультатаОтчета") Тогда
			Файл = Отчет.НастройкиОтчета.ФайлРезультатаОтчета;
		Иначе
			Файл = РаботаСОтчетамиКлиентСервер.ПолучитьФайлРезультатаОтчета(Отчет.НастройкиОтчета, Отчет.Результат);
		КонецЕсли;
		
		Если Файл.Существует() Тогда
			Файлы.Добавить(Новый Структура("Отчет, Файл", Отчет, Файл));
			
			Вложения.Вставить(Файл.Имя, Файл);
			
			ОписаниеВложений = ?(ОписаниеВложений = "", "", ОписаниеВложений + "; ") + Файл.ИмяБезРасширения;
		КонецЕсли;
		
		Если ТипЗнч(Отчет.Результат) = Тип("Структура")
			И Отчет.Результат.Свойство("РегламентированныйОтчет") Тогда
			ОтправленныеРегламентированныеОтчеты.Добавить(Отчет.Результат.РегламентированныйОтчет);
		КонецЕсли;
		
	КонецЦикла;
	
	АдресОтправителя	= Отправитель;
	МассивАдресов 		= РаботаСоСтрокамиКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(АдресОтправителя);
	
	Если МассивАдресов.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Некорректный адрес отправителя: ""%1""", АдресОтправителя);
	Иначе
		СтруктураАдреса = МассивАдресов[0];
	КонецЕсли; 
	
	РеквизитыОтправителя = Новый Структура("ИмяПользователя, АдресЭлектроннойПочты", СтруктураАдреса.Представление, СтруктураАдреса.Адрес); 
	СлепыеКопии			= СтруктураАдреса.Адрес;
	АдресОтвета			= СтруктураАдреса.Адрес;
	ИмяПользователя 	= СтруктураАдреса.Представление;
	
	Тело = 
		"<HTML><HEAD>
		|<BODY>
		|<P>Добрый день.</P>
		|<P>Данное письмо было отправлено Вам автоматически.</P>
		|<P>Для получения информации по возникшим вопросам Вам необходимо связаться с сотрудниками Управляющей компании по телефону" + НомерТелефона + " или отправить сообщение по адресу <a href=""mailto:" + АдресОтвета + """>" + АдресОтвета + "</a></P>
		|</BODY></HTML>";
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Вложения, СлепыеКопии, АдресОтвета, РеквизитыОтправителя, УведомитьОПрочтении", 
				Получатели, 
				ОписаниеВложений, 
				Тело, 
				ТипТекстаПочтовогоСообщения.HTML, 
				Вложения, 
				СлепыеКопии, 
				АдресОтвета, 
				РеквизитыОтправителя,
				АдресОтвета = АдресДляБухгалтерии);
	
	Если РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма, , ОтложеннаяОтправка, Организация, Истина) = Неопределено Тогда
		ВызватьИсключение "Не удалось отправить письмо!";
	КонецЕсли;
	
	Для Каждого ТекФайл Из Файлы Цикл
		Настройки	= ТекФайл.Отчет.НастройкиОтчета;
		Файл		= ТекФайл.Файл;
		
		КаталогСохранения = РаботаСОтчетамиКлиентСервер.ПолучитьКаталогСохраненияРезультатаОтчета(Настройки);
		Если ЗначениеЗаполнено(КаталогСохранения) Тогда
			КопироватьФайл(Файл.ПолноеИмя, КаталогСохранения + Файл.Имя);
		КонецЕсли;
		
		Если Не (Настройки.Свойство("НеУдалятьФайлПослеОтправки") И Настройки.НеУдалятьФайлПослеОтправки = Истина) Тогда
			УдалитьФайлы(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Отчет Из ОтправленныеРегламентированныеОтчеты Цикл
		УстановитьСтатусРегламентированногоОтчета(Отчет, "Отправлен");
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает для регламентированного отчета переданный статус
//
Процедура УстановитьСтатусРегламентированногоОтчета(Отчет, Статус) Экспорт
	
	Если Отчет.СтатусОтчета = Статус Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетОбъект = Отчет.ПолучитьОбъект();
	
	ОтчетОбъект.СтатусОтчета = Статус;
	
	ОтчетОбъект.Записать();
	
КонецПроцедуры

// Получает основные реквизиты ЦБ на дату
Функция ПолучитьРеквизитыЦеннойБумаги(ЦеннаяБумага, Дата) Экспорт
	
	СтруктураРеквизитовЦБ = Новый Структура("Тип, КраткоеНаименованиеЭмитента, КраткоеНаименованиеЭмитентаПоУставу, ПолноеНаименованиеЭмитента, РегистрационныйНомер, Номинал, ВалютаНоминала", "", "", "", "", "", "");
	
	ТаблицаЦБ = Новый ТаблицаЗначений;
		
	ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы()));
	НоваяСтрока = ТаблицаЦБ.Добавить();
	НоваяСтрока.ЦеннаяБумага = ЦеннаяБумага;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЦБ", 	ТаблицаЦБ);
	Запрос.УстановитьПараметр("Период", 	Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _ЦенныеБумаги
	|ИЗ
	|	&ТаблицаЦБ КАК ТаблицаЦБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|			ТОГДА ""Акция""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|			ТОГДА ""Вексель""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|			ТОГДА ""Депозитарная расписка""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
	|			ТОГДА ""Доля""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	|			ТОГДА ""Закладная""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|			ТОГДА ""Ипотечный сертификат участия""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|			ТОГДА ""Облигация""
	|		КОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
	|			ТОГДА ""Опцион""
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА ""Пай""
	|		КОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
	|			ТОГДА ""Фьючерс""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Тип,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КраткоеНаименованиеЭмитента,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
	|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, """")
	|	КОНЕЦ КАК КраткоеНаименованиеЭмитентаПоУставу,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда
	|		ИНАЧЕ ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, """")
	|	КОНЕЦ КАК ПолноеНаименованиеЭмитента,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номер
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|				И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер <> """"
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
	|		ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихISIN.Код, КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Код)
	|	КОНЕЦ КАК РегистрационныйНомер,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Номинал
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номинал
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Номинал
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Номинал,
	|	ВЫБОР
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
	|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ВалютаНоминала
	|ИЗ
	|	_ЦенныеБумаги КАК _ЦенныеБумаги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО (ВЫБОР
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Закладные
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Закладные).Банк.ЮрФизЛицо
	|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
	|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
	|		ПО (ВЫБОР
	|				КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
	|					ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
	|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитовЦБ, Выборка);
	КонецЕсли;	
	
	Возврат СтруктураРеквизитовЦБ;
	
КонецФункции

Функция ПолучитьПредставлениеЦеннойБумаги(ЦеннаяБумага, Дата, ВыводитьТипЦБ = Истина) Экспорт

	РеквизитыЦеннойБумаги = ПолучитьРеквизитыЦеннойБумаги(ЦеннаяБумага, Дата);
	
	// Составляем из всех полученных реквизитов, кроме полного наименования эмитента
	Результат = "";
	
	ЕстьЭмитент = ЗначениеЗаполнено(РеквизитыЦеннойБумаги.КраткоеНаименованиеЭмитента);
	ЕстьРегНомер = ЗначениеЗаполнено(РеквизитыЦеннойБумаги.РегистрационныйНомер);
	ЕстьНоминал = ЗначениеЗаполнено(РеквизитыЦеннойБумаги.Номинал) Или ЗначениеЗаполнено(РеквизитыЦеннойБумаги.ВалютаНоминала);
	
	Для Каждого ТекРеквизит Из РеквизитыЦеннойБумаги Цикл
		
		Если Не ЗначениеЗаполнено(ТекРеквизит.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекРеквизит.Ключ = "ПолноеНаименованиеЭмитента" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекРеквизит.Ключ = "Тип" И (Не ВыводитьТипЦБ) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = ?(Результат = "", СокрЛП(ТекРеквизит.Значение), Результат + " " + СокрЛП(ТекРеквизит.Значение));
		
		Если ТекРеквизит.Ключ = "Тип" И Не (ЕстьЭмитент) Тогда
			Результат = Результат + ",";
		КонецЕсли;
			
		Если ТекРеквизит.Ключ = "КраткоеНаименованиеЭмитента" И (ЕстьРегНомер Или ЕстьНоминал) Тогда
			Результат = Результат + ",";
		КонецЕсли;
		
		Если ТекРеквизит.Ключ = "РегистрационныйНомер" И ЕстьНоминал Тогда
			Результат = Результат + ",";
		КонецЕсли;
		
	КонецЦикла;     	
	
	Возврат Результат;
	
КонецФункции

#Область Общие_запросы_для_внешних_отчетов

// Рассчитывает суммы комиссий (торговой и брокерской) по сделкам за период и помещает во временную таблицу запроса _КомиссииПоСделкам
// Список счетов доверительного управления принадлежит одному клиенту, должен быть помещен во временную таблицу
//
// 	Запрос 												- Исходный запрос
//	Организация 										- Организация 
//  ДатаНачала 											- Начало периода для получения расходов
//  ДатаОкончания 										- Окончание периода для получения расходов
//  ДатыСЧА												- Структура со свойствами ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода - даты СЧА на конец и начало периода по настройкам регламентных действий
//	ИмяТаблицыСчетовДУ 									- Имя временной таблицы, в которую помещены счета доверительного управления
//	ИспользоватьПисьмоЦБ_47_1_2_699_ДляПокупокПоАС		- Булево. По письму ЦБ № 47-1-2/699 от 13.08.2024, комиссии по покупкам ЦБ по АС должны включаться в состав необходимых расходов, 
//														  а в отчетах по данным ЕПС (507, 255) они должны включаться в стоимость ЦБ
//	Отказ 												- Отказ
//
Процедура ПоместитьКомиссииПоСделкамЗаПериодВМенеджерВременныхТаблиц(Запрос, Организация, ДатаНачала, ДатаОкончания, ДатыСЧА, ИмяТаблицыСчетовДУ = "_СчетаДоверительногоУправления", ИспользоватьПисьмоЦБ_47_1_2_699_ДляПокупокПоАС = Ложь, Отказ = Ложь) Экспорт
	
	// Описание
	// В итоговой таблице комиссии сгруппированы по счету ДУ, Периоду, Месту хранения, сделке (сделке РЕПО), Контрагенту и Виду задолженности 
	// для дальнейшего использования в отчетах и расшифровках к ним
	//
	// Комиссии по сделкам Т+ и РЕПО включаются в отчеты за период по правилам:
	//	I. Сделки Т+ (с ЦБ, с валютой):
	//		1. У отдельных клиентов комиссии по покупке ЦБ по АС не включаются в отчет
	//		2. Если исполнение сделки находится в периоде отчета, 
	//		   комиссии включаются в отчет в полном объеме (в т. ч. по сделкам, открытым до начала периода и исполненным в периоде)
	//		3. Если исполнение сделки после окончания периода отчета, комиссии не включаются в отчет
	// II. Сделки РЕПО
	//		1. Если обе части сделки РЕПО внутри периода отчета, комиссии включаются в отчет в полном объеме
	//		2. Если первая часть РЕПО до начала периода, а вторая - в периоде, 
	//		   используются параметры комиссий по сделкам РЕПО (Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыУчетаКомиссийПоСделкамРЕПО) 
	//		   на начало периода:
	// 		   - НеУчитыватьКомиссиюВДебиторке - комиссии не включаются (т. к. влючены в отчет предыдущего периода)
	//		   - ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки - комиссии включаются в полном объеме (т. к. не включались в отчет предыдущего периода)
	// 		   - иначе - комиссии включаются пропорционально оставшимся дням от начала периода до даты второй части
	//		3. Если первая часть РЕПО в периоде, а вторая - после окончания периода, 
	//		   используются параметры комиссий по сделкам РЕПО (Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыУчетаКомиссийПоСделкамРЕПО) 
	//		   на конец периода:
	// 		   - НеУчитыватьКомиссиюВДебиторке - комиссии включаются в полном объеме
	//		   - ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки - комиссии не включаются
	// 		   - иначе - комиссии включаются пропорционально прошедшим дням от даты первой части до конца периода
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли; 	
	
	СчетаДоверительногоУправления = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицыСчетовДУ).ПолучитьДанные().Выгрузить();	
	Если СчетаДоверительногоУправления.Количество() = 0 Тогда
		ПустаяТаблица = Новый ТаблицаЗначений;
		ПустаяТаблица.Колонки.Добавить("СчетДоверительногоУправления", 	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ПустаяТаблица.Колонки.Добавить("Сумма", 						Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(19, 2)));
		ПустаяТаблица.Колонки.Добавить("Регистратор", 					Новый ОписаниеТипов("ДокументСсылка.Сделка"));
		ПустаяТаблица.Колонки.Добавить("МестоХранения", 				Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
		ПустаяТаблица.Колонки.Добавить("Период", 						Новый ОписаниеТипов("Дата", ,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		ПустаяТаблица.Колонки.Добавить("ВидЗадолженности", 				Новый ОписаниеТипов("СправочникСсылка.ВидыЗадолженности")); 
		ПустаяТаблица.Колонки.Добавить("Контрагент", 					Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица")); 
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПустаяТаблица, "_КомиссииПоСделкам", Запрос.МенеджерВременныхТаблиц);	
		Возврат;
	КонецЕсли;
	
	ТекущиеТаблицыЗапроса = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(Запрос); 
	ТекущиеТаблицыЗапроса.Добавить("_КомиссииПоСделкам");
	
	//Используем счет ДУ с минимальной датой заключения		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ИмяТаблицыСчетовДУ КАК _СчетаДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДоверительногоУправления.СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаЗаключения";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицыСчетовДУ", ИмяТаблицыСчетовДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	СчетДоверительногоУправления	= Выборка.СчетДоверительногоУправления;
	МинимальнаяДатаЗаключения		= Выборка.ДатаЗаключения;
			
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ДатаОкончания, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	ВариантРасчетаОценочнойСтоимости = НастройкиОценки.ВариантРасчетаОценочнойСтоимости;
	ПараметрыУчетаКомиссийПоРЕПО = Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыУчетаКомиссийПоСделкамРЕПО(Организация, СчетДоверительногоУправления, ВариантРасчетаОценочнойСтоимости, ДатаОкончания);
	
	Если ПараметрыУчетаКомиссийПоРЕПО = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("НеУчитыватьКомиссиюВДебиторке",	 				ПараметрыУчетаКомиссийПоРЕПО.НеУчитыватьКомиссиюВДебиторке);
	Запрос.УстановитьПараметр("ВыделятьКомиссиюПоСделкам",  					ПараметрыУчетаКомиссийПоРЕПО.ВыделятьКомиссиюПоСделкам);
	Запрос.УстановитьПараметр("ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки", ПараметрыУчетаКомиссийПоРЕПО.ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки);
	Запрос.УстановитьПараметр("ИспользоватьНачисленнуюКомиссию",  				ПараметрыУчетаКомиссийПоРЕПО.ИспользоватьНачисленнуюКомиссию);
	
	НастройкиОценки_НачалоПериода = РаботаСПереоценкой.ОпределитьНастройкиОценки(ДатаНачала, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода = Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыУчетаКомиссийПоСделкамРЕПО(
								Организация, 
								СчетДоверительногоУправления, 
								НастройкиОценки_НачалоПериода.ВариантРасчетаОценочнойСтоимости, 
								?(ДатаНачала < МинимальнаяДатаЗаключения, МинимальнаяДатаЗаключения, ДатаНачала)
								);
	
	Если ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("НеУчитыватьКомиссиюВДебиторке_НачалоПериода",				 							ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода.НеУчитыватьКомиссиюВДебиторке);
	Запрос.УстановитьПараметр("ВыделятьКомиссиюПоСделкам_НачалоПериода",  												ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода.ВыделятьКомиссиюПоСделкам);
	Запрос.УстановитьПараметр("ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки_НачалоПериода",							ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода.ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки);
	Запрос.УстановитьПараметр("ИспользоватьНачисленнуюКомиссию_НачалоПериода",  										ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода.ИспользоватьНачисленнуюКомиссию);
	Запрос.УстановитьПараметр("ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков_НачалоПериода",	ПараметрыУчетаКомиссийПоРЕПО_НачалоПериода.ОкруглятьКомиссиюРассчитаннуюПропорциональноДнямОтДатыСделкиДоДвухЗнаков);
	
	
	Запрос.УстановитьПараметр("НачалоПериода",			НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", 			КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница", 	Новый Граница(КонецДня(ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 			Организация);

	Запрос.УстановитьПараметр("ВалютаРубли",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
			
	Запрос.УстановитьПараметр("ДатаПоследнейСЧА", ДатыСЧА.ДатаПоследнейСЧА);		
	Запрос.УстановитьПараметр("ДатаПоследнейСЧАДоНачалаПериода"	, ДатыСЧА.ДатаПоследнейСЧАДоНачалаПериода);    	
	
	//#ТехДолг Начало
	// Порция хардкода	
	// Когда-нибудь должны появиться настройки
	// Комиссии по незавершенным сделкам не включаются в отчеты этого периода, начиная с отчетности за 2020 год
	// Незавершенные сделки:
	// 	- сделки с отложенным исполнением, не исполненные на отчетную дату
	//  - для внебиржевых сделок - сделки с незавершенной поставкой ЦБ
	//  - для сделок РЕПО - сделки, по которым еще не прошла вторая часть РЕПО
	//
	Запрос.УстановитьПараметр("НачалоИсключенияКомиссийПоНезавершеннымСделкам"	, '20200701');       	
	
	// Будущее, Телеком-Союз и Федерация просят исключать комиссии по сделкам покупки амортизируемых ЦБ (не РЕПО) из отчета
	КлиентБудущее 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ");
	КлиентТелекомСоюз 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз");
	КлиентФедерация 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация");
	
	// Для остальных клиентов группы Будущее - с 01.01.2022
	КлиентУГМКПерспектива 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_УГМК");
	КлиентБольшой 			= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой");
	КлиентОПФ 				= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ");
	КлиентЭволюция 			= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция");
	КлиентДостойноеБудущее 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар");
	КлиентХантыМансийский	= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ХантыМансийский");
	КлиентГефест			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ГЕФЕСТ");
	КлиентРостех			= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Ростех");
	
	КлиентСчетаДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаОкончания);
	ИсключатьКомиссииПоПокупкамЦБпоАС = (ДатаНачала >= '20210101' 
											И (КлиентСчетаДУ = КлиентБудущее 
											Или КлиентСчетаДУ = КлиентТелекомСоюз
											Или КлиентСчетаДУ = КлиентФедерация))
										Или ДатаНачала >= '20220101' 
											И (КлиентСчетаДУ = КлиентУГМКПерспектива 
											Или КлиентСчетаДУ = КлиентБольшой
											Или КлиентСчетаДУ = КлиентОПФ
											Или КлиентСчетаДУ = КлиентЭволюция
											Или КлиентСчетаДУ = КлиентДостойноеБудущее)
										Или ДатаНачала >= '20240101' И КлиентСчетаДУ = КлиентХантыМансийский И Не ИспользоватьПисьмоЦБ_47_1_2_699_ДляПокупокПоАС
										Или ДатаНачала >= '20240101' И КлиентСчетаДУ = КлиентГефест
										Или ДатаНачала >= '20250101' И КлиентСчетаДУ = КлиентРостех;
									
	Запрос.УстановитьПараметр("ИсключатьКомиссииПоПокупкамЦБпоАС", 				ИсключатьКомиссииПоПокупкамЦБпоАС);									
	Запрос.УстановитьПараметр("УчетныеАктивыЕПСПоАмортизированнойСтоимости",	Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости());  
	
	//#ТехДолг Конец  	
	
	Запрос.УстановитьПараметр("УчестьПереходБольшогоНаМетодикуБудущее2020", 	ДатаНачала = '20230101' И КлиентСчетаДУ = КлиентБольшой);
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК СделкаРЕПО,
		|	ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).МестоХранения КАК МестоХранения
		|ПОМЕСТИТЬ _НеУчитыватьКомиссиюВДебиторке_ОткрытыеРЕПО_ДатаПоследнейСЧА
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &ДатаПоследнейСЧА
		|	И &НеУчитыватьКомиссиюВДебиторке
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК СделкаРЕПО,
		|	ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).Дата КАК Дата,
		|	ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).МестоХранения КАК МестоХранения,
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).Дата, ДЕНЬ) КАК ДатаСделки,
		|	ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).ДатаВторойЧастиРЕПО КАК ДатаВторойЧасти
		|ПОМЕСТИТЬ _НезавершенныеДлинныеСделкиРЕПО
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	НЕ &НеУчитыватьКомиссиюВДебиторке
		|	И НЕ &ОплаченнаяКомиссияВДебиторкеДоИсполненияСделки
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &ДатаПоследнейСЧА
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета <> 0
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|	И ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).Дата < &ДатаПоследнейСЧА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК СделкаРЕПО,
		|	СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК СуммаРынокВВалютеУчета
		|ПОМЕСТИТЬ _ОстаткиКомиссииНаДатуПоследнейСЧА
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	&ВыделятьКомиссиюПоСделкам
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &ДатаПоследнейСЧА
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления, СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) В
		|			(ВЫБРАТЬ
		|				_НезавершенныеДлинныеСделкиРЕПО.СчетДоверительногоУправления,
		|				_НезавершенныеДлинныеСделкиРЕПО.СделкаРЕПО
		|			ИЗ
		|				_НезавершенныеДлинныеСделкиРЕПО КАК _НезавершенныеДлинныеСделкиРЕПО)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета <> 0
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НезавершенныеДлинныеСделкиРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НезавершенныеДлинныеСделкиРЕПО.СделкаРЕПО КАК СделкаРЕПО,
		|	_НезавершенныеДлинныеСделкиРЕПО.Дата КАК Дата,
		|	_НезавершенныеДлинныеСделкиРЕПО.МестоХранения КАК МестоХранения,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Валюта = &ВалютаРубли
