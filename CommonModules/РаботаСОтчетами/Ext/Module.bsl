		|ВЫБРАТЬ
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.СчетДоверительногоУправления,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.Сумма,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.СделкаРЕПО,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.МестоХранения,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.Дата,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.ВидЗадолженности,
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода.Контрагент
		|ИЗ
		|	_ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода КАК _ДобавитьКомиссииРЕПО_КомиссияВыделенаПоСделкам_НачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание КАК Сделка
		|ПОМЕСТИТЬ _ВнебиржевыеСделкиСПоставкамиВПериоде
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)
		|				И ВЫРАЗИТЬ(Основание КАК Документ.Сделка).МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)) КАК ЗадолженностиПоЦеннымБумагамОбороты
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагамОбороты.КоличествоРасход > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗадолженностиПоЦеннымБумагамОбороты.Регистратор) КАК КоличествоПоставок,
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание КАК Основание
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)
		|				И Основание В
		|					(ВЫБРАТЬ
		|						_ВнебиржевыеСделкиСПоставкамиВПериоде.Сделка
		|					ИЗ
		|						_ВнебиржевыеСделкиСПоставкамиВПериоде)) КАК ЗадолженностиПоЦеннымБумагамОбороты
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагамОбороты.КоличествоРасход > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоЦеннымБумагамОбороты.Основание
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗадолженностиПоЦеннымБумагамОбороты.Регистратор) > 1";

	Если ИмяТаблицыСчетовДУ <> "_СчетаДоверительногоУправления" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления", ИмяТаблицыСчетовДУ + " КАК _СчетаДоверительногоУправления");
	КонецЕсли;
	
	#КонецОбласти
	
	// Проверяем, что по каждой сделке только одна поставка, т. к. под другие случаи, возможно, потребуется доработка
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		
		ТекстСообщения = "По следующим сделкам более одной поставки, требуется доработка отчета:";
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС + СокрЛП(Выборка.Основание);			
		КонецЦикла;	
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				
	КонецЕсли;
		
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ТекущиеТаблицыЗапроса);
	
КонецПроцедуры

// Добавляет таблицу с заданной базой расчета (Справочники.БазыРасчета.ММ.ДобавитьИсточникДанных) в менеджер временных таблиц запроса
// 
// 	Запрос 										- Исходный запрос
// 	ДатыПериода 								- Структура со свойствами "НачалоПериода", "КонецПериода". Период для расчета базы
//	ИмяТаблицыСчетовДоверительногоУправления 	- Имя таблицы со счетами доверительного управления, для которых нужно рассчитать базу
//	ИмяТаблицыБазыРасчета 						- Имя таблицы базы расчета из используемых в Справочники.БазыРасчета.ММ.ДобавитьИсточникДанных()
//	Отказ 										- Отказ (Булево)
//
Процедура ДобавитьДанныеПоБазеРасчетаВЗапрос(Запрос, ДатыПериода, ИмяТаблицыСчетовДоверительногоУправления, ИмяТаблицыБазыРасчета, Отказ) Экспорт
	
	// Процедура проверена только на источниках данных:
	//	_РСАНаКонецБаланс
	// 	_РСАНаКонецБалансРСБУ
	// 	_ИнвестиционныйДоход
	// Для других источников может потребоваться адаптация
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе, переданном в ДобавитьДанныеПоБазеРасчетаВЗапрос, не определен менеджер временных таблиц",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// Проверим, что в МВТ есть таблица счетов ДУ с заданным именем
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицыСчетовДоверительногоУправления) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В менеджере временных таблиц запроса, переданного в ДобавитьДанныеПоБазеРасчетаВЗапрос, отсутствует таблица " + ИмяТаблицыСчетовДоверительногоУправления,,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// Проверим структуру ДатыПериода
	Если Не ТипЗнч(ДатыПериода) = Тип("Структура") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В РаботаСОтчетами.ДобавитьДанныеПоБазеРасчетаВЗапрос параметр ДатыПериода должен иметь тип Структура",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если Не (ДатыПериода.Свойство("НачалоПериода") И ДатыПериода.Свойство("КонецПериода")) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В РаботаСОтчетами.ДобавитьДанныеПоБазеРасчетаВЗапрос параметр ДатыПериода должен иметь свойства НачалоПериода и КонецПериода",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// Массив временных таблиц, которые должны остаться в МВТ после выполнения процедуры
	МассивНеудаляемыхТаблиц = Новый Массив;
	МассивНеудаляемыхТаблиц.Добавить(ИмяТаблицыБазыРасчета);
	Для Каждого ТаблицаМВТ Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если (ТаблицаМВТ.ПолноеИмя = "_СчетаДоверительногоУправления" Или ТаблицаМВТ.ПолноеИмя = "_Клиенты")
				И ТаблицаМВТ.ПолноеИмя = ИмяТаблицыСчетовДоверительногоУправления  Тогда
			// Эту таблицу не добавляем, ниже добавим служебную
			Продолжить;
		КонецЕсли;
		
		МассивНеудаляемыхТаблиц.Добавить(ТаблицаМВТ.ПолноеИмя);
		
	КонецЦикла;

	Запрос.УстановитьПараметр("НачалоПериода", 					ДатыПериода.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 					ДатыПериода.КонецПериода);
	Запрос.УстановитьПараметр("КонецРасчетногоПериодаГраница", 	Новый Граница(ДатыПериода.КонецПериода, ВидГраницы.Включая));
	
	// Если передана таблица с именем _Клиенты, ее нужно переименовать, т. к. имя используется
	ИмяСлужебнойТаблицы = "";
	Если ИмяТаблицыСчетовДоверительногоУправления = "_Клиенты" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			| *
			|ПОМЕСТИТЬ _Клиенты_Служебная
			|ИЗ _Клиенты КАК _Клиенты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _Клиенты";
		
		МассивНеудаляемыхТаблиц.Добавить("_Клиенты_Служебная");
		ИмяСлужебнойТаблицы = "_Клиенты_Служебная";
		
		Запрос.Выполнить();
		
	КонецЕсли;   		
		
	// Помещаем таблицу счетов ДУ в новую временную таблицу с дополнительными данными
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&НачалоПериода КАК НачалоРасчетногоПериода,
		|	НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ) КАК КонецРасчетногоПериода,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаРасчета,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления.ДатаЗаключения < НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД) КАК ДоговорЗаключенДоТекущегоГода,
		|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД), ДЕНЬ, -1) КАК КонецПредыдущегоГода,
		|	НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД) КАК НачалоГода
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления";
				
	Если ИмяТаблицыСчетовДоверительногоУправления <> "_СчетаДоверительногоУправления" Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_СчетаДоверительногоУправления КАК", ?(ИмяСлужебнойТаблицы = "", ИмяТаблицыСчетовДоверительногоУправления, ИмяСлужебнойТаблицы) + " КАК");
	Иначе
		
		// При дальнейших вычислениях базы расчета может появиться таблица _СчетаДоверительногоУправления, поэтому текущую нужно заменить, а затем вернуть
		Запрос.Текст = Запрос.Текст + "                
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////";
		
		Запрос.Текст = Запрос.Текст + "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			| *
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления_Служебная
			|ИЗ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СчетаДоверительногоУправления";
		
		МассивНеудаляемыхТаблиц.Добавить("_СчетаДоверительногоУправления_Служебная");
		ИмяСлужебнойТаблицы = "_СчетаДоверительногоУправления_Служебная";
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Справочники.БазыРасчета.ДобавитьИсточникДанных(Запрос, ИмяТаблицыБазыРасчета);
	
	// Уничтожаем накопленные временные таблицы, кроме исключенных
	Запрос.Текст = "";
	Для каждого ТаблицаМВТ Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл

		Если МассивНеудаляемыхТаблиц.Найти(ТаблицаМВТ.ПолноеИмя) = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + 
				"УНИЧТОЖИТЬ " + ТаблицаМВТ.ПолноеИмя + "
				|;
				|";
		КонецЕсли; 
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Запрос.Текст) Тогда
		Запрос.Выполнить();
	КонецЕсли;
	
	// Если использовалась служебная таблица счетов ДУ, нужно переименовать ее обратно в ИмяТаблицыСчетовДоверительногоУправления
	Если ИмяСлужебнойТаблицы <> "" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			| *
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ _СчетаДоверительногоУправления_Служебная КАК _СчетаДоверительногоУправления_Служебная
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СчетаДоверительногоУправления_Служебная";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_СчетаДоверительногоУправления", ИмяТаблицыСчетовДоверительногоУправления);
		
		Запрос.Выполнить();	
	
	КонецЕсли;
	
КонецПроцедуры

// Добавляет таблицы с даными по инфляции, стоимостью пая и СЧА на горизонте 5 лет в менеджер временных таблиц запроса
// 
// 	Запрос 										- Исходный запрос
// 	Дата 										- Дата отсчета горизонта
//	Отказ 										- Отказ (Булево)
//
Процедура ДобавитьДанныеДляРасчетаДоходностиПИФИОтклоненияОтИнфляцииВЗапрос(Запрос, Дата, Отказ) Экспорт
	
	// Процедура используется во внешней обработке _КлючевойИнформационныйДокумент и внешнем отчете _РасчетДоходностиПИФиОтклоненияОтИнфляции
	
	// Запрос помещает в менеджер временных таблиц:
	//	1. Данные по стоимости пая, СЧА и РСА ПИФ:
	//		- на дату, переданную в параметре Дата
	//		- на конец предыдущих 6 календарных лет (по рабочим датам) от этой даты; при этом, если дата окончания формирования ПИФ не ранее 5го года,
	//        то на последний рабочий день месяца даты окончания формирования ПИФ (строка предыдущего года заменяется на эту).
	//	 	- на конец предыдущих 1, 3, 6, 12, 36, 60 месяцев (по рабочим дням) от этой даты
	//
	//	2. Данные по месячной инфляции (ИПЦкКонцуПредыдущегоМесяца) за месяц даты из параметра, а также за 60 предыдущих месяцев
	// 	   При этом, если данные по инфляции за месяц даты из параметра отсутствуют, для этого месяца используются данные за предыдущий месяц
	//
	//  3. Данные по доходам к выплате пайщикам за периоды из п. 1
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе, переданном в ДобавитьДанныеДляРасчетаДоходностиПИФИОтклоненияОтИнфляцииВЗапрос, не определен менеджер временных таблиц",,,, Отказ);
		Возврат;
	КонецЕсли;
			
	Запрос.УстановитьПараметр("ДатаРезультатовИнвестирования", 	Дата);
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
	
	#Область Текст_запроса
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ДатаОкончанияФормированияПИФ.Значение КАК ДАТА) КАК Дата,
		|	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ВЫРАЗИТЬ(ДатаОкончанияФормированияПИФ.Значение КАК ДАТА), ГОД, -1), ГОД) КАК Год
		|ПОМЕСТИТЬ _ДатаОкончанияФормированияПИФ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
		|ГДЕ
		|	ДатаОкончанияФормированияПИФ.Объект В
		|			(ВЫБРАТЬ
		|				_КлиентДоверительногоУправления.Клиент
		|			ИЗ
		|				_КлиентДоверительногоУправления)
		|	И ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ДатаРезультатовИнвестирования"" КАК ВидИнтервала,
		|	&ДатаРезультатовИнвестирования КАК Дата,
