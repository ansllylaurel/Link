		|	_ДанныеОВерсиях.Актуальная КАК Актуальная,
		|	_ДанныеОВерсиях.Размер КАК Размер
		|ПОМЕСТИТЬ _Итоговая
		|ИЗ
		|	_ТаблицаОтчетов КАК _ТаблицаОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭкземплярыОтчетов КАК _ЭкземплярыОтчетов
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ЭкземплярыОтчетов.ИдентификаторСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеОВерсиях КАК _ДанныеОВерсиях
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераВерсийОтчетовДляКлиентов КАК НомераВерсийОтчетовДляКлиентов
		|			ПО _ДанныеОВерсиях.Экземпляр = НомераВерсийОтчетовДляКлиентов.Экземпляр
		|				И _ДанныеОВерсиях.ИдентификаторВерсии = НомераВерсийОтчетовДляКлиентов.ИдентификаторВерсии
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ДанныеОВерсиях.ИдентификаторСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеРегламентированныхОтчетов КАК _ДанныеРегламентированныхОтчетов
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ДанныеРегламентированныхОтчетов.ИдентификаторСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеДляОпределенияСтатусовВыгрузкиИОтправки КАК _ДанныеДляОпределенияСтатусовВыгрузки
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ДанныеДляОпределенияСтатусовВыгрузки.ИдентификаторСтроки
		|			И (_ДанныеДляОпределенияСтатусовВыгрузки.ВидПакета = ЗНАЧЕНИЕ(Перечисление.ВидыПакетовДанныхКОбработке.ВыгрузкаФайла))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеДляОпределенияСтатусовВыгрузкиИОтправки КАК _ДанныеДляОпределенияСтатусовОтправки
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ДанныеДляОпределенияСтатусовОтправки.ИдентификаторСтроки
		|			И (_ДанныеДляОпределенияСтатусовОтправки.ВидПакета = ЗНАЧЕНИЕ(Перечисление.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераВерсийОтчетовДляКлиентов.Экземпляр КАК Экземпляр,
		|	МАКСИМУМ(НомераВерсийОтчетовДляКлиентов.НомерВерсии) КАК МаксимальныйНомерВерсии
		|ПОМЕСТИТЬ _МаксимальныеНомераВерсий
		|ИЗ
		|	РегистрСведений.НомераВерсийОтчетовДляКлиентов КАК НомераВерсийОтчетовДляКлиентов
		|ГДЕ
		|	НомераВерсийОтчетовДляКлиентов.Экземпляр В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Итоговая.Экземпляр КАК Экземпляр
		|			ИЗ
		|				_Итоговая КАК _Итоговая)
		|
		|СГРУППИРОВАТЬ ПО
		|	НомераВерсийОтчетовДляКлиентов.Экземпляр
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Итоговая.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	_Итоговая.Регламентированный КАК Регламентированный,
		|	_Итоговая.РегламентированныйОтчет КАК РегламентированныйОтчет,
		|	_Итоговая.СтатусРегламентированногоОтчета КАК СтатусРегламентированногоОтчета,
		|	_Итоговая.Экземпляр КАК Экземпляр,
		|	_Итоговая.ВерсияДанных КАК ВерсияДанных,
		|	_Итоговая.ЗапретОбработки КАК ЗапретОбработки,
		|	_Итоговая.ИдентификаторВерсии КАК ИдентификаторВерсии,
		|	_Итоговая.КонтрольнаяСумма КАК КонтрольнаяСумма,
		|	_Итоговая.ИмяПриСохранении КАК ИмяПриСохранении,
		|	_Итоговая.Окончательная КАК Окончательная,
		|	_Итоговая.СтатусВерсии КАК СтатусВерсии,
		|	_Итоговая.СтатусВыгрузки КАК СтатусВыгрузки,
		|	_Итоговая.Выгрузка КАК Выгрузка,
		|	_Итоговая.СтатусОтправки КАК СтатусОтправки,
		|	_Итоговая.Письмо КАК Письмо,
		|	_Итоговая.ОбработкаЗавершена КАК ОбработкаЗавершена,
		|	_Итоговая.Сформировать КАК Сформировать,
		|	_Итоговая.Выгрузить КАК Выгрузить,
		|	_Итоговая.Отправить КАК Отправить,
		|	ВЫБОР
		|		КОГДА _Итоговая.ВерсияОтправлялась
		|			ТОГДА _Итоговая.НомерВерсииДляКлиента
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _Итоговая.Актуальная
		|					ТОГДА ЕСТЬNULL(_МаксимальныеНомераВерсий.МаксимальныйНомерВерсии, 0) + 1
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК НомерВерсииДляКлиента,
		|	_Итоговая.ВерсияОтправлялась КАК ВерсияОтправлялась,
		|	_Итоговая.Размер КАК Размер
		|ИЗ
		|	_Итоговая КАК _Итоговая
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МаксимальныеНомераВерсий КАК _МаксимальныеНомераВерсий
		|		ПО _Итоговая.Экземпляр = _МаксимальныеНомераВерсий.Экземпляр";
	#КонецОбласти
	
	СостоянияОтчетов = Запрос.Выполнить().Выгрузить();
	СостоянияОтчетов.Колонки.Добавить("КомментарийКОтменеОбработки", Новый ОписаниеТипов("Строка"));
	
	Возврат СостоянияОтчетов
	
КонецФункции

// Выполняет попытки отменить все пакеты данных (письма и выгрузки файлов),
//	в ТЧ 'Файлы' которых присутствуют идентификаторы версий экземпляра отчета
//
Процедура ОтменитьОбработкуПакетовЭкземпляра(Экземпляр) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Экземпляр", Экземпляр);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПакетыДанныхКОбработкеФайлы.Ссылка КАК Пакет
		|ИЗ
		|	Справочник.ПакетыДанныхКОбработке.Файлы КАК ПакетыДанныхКОбработкеФайлы
		|ГДЕ
		|	НЕ ПакетыДанныхКОбработкеФайлы.Ссылка.ПометкаУдаления
		|	И НЕ ПакетыДанныхКОбработкеФайлы.Ссылка.ОбработкаОтменена
		|	И ПакетыДанныхКОбработкеФайлы.ИдентификаторВерсии В
		|			(ВЫБРАТЬ
		|				ЭкземплярыОтчетовВерсииОтчетов.ИдентификаторВерсии КАК ИдентификаторВерсии
		|			ИЗ
		|				Справочник.ЭкземплярыОтчетов.ВерсииОтчетов КАК ЭкземплярыОтчетовВерсииОтчетов
		|			ГДЕ
		|				ЭкземплярыОтчетовВерсииОтчетов.Ссылка = &Экземпляр)";
	
	Пакеты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пакет");
	
	Если Пакеты.Количество() > 0 Тогда
		РаботаСПакетамиДанныхКОбработке.ОтменитьОбработкуПакетов(Пакеты);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает массив с кодами общих настроек отчетов
//
Функция ПолучитьКодыОбщихНастроек() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("АвтоматическаяВыгрузкаВЭДО");
	Результат.Добавить("АвтоматическаяОтправка");
	Результат.Добавить("АдресОтправителя");
	Результат.Добавить("АдресЭлектроннойПочты");
	Результат.Добавить("АдресЭлектроннойПочтыБухгалтерии");
	Результат.Добавить("АдресЭлектроннойПочтыБэкОфиса");
	Результат.Добавить("ВариантПолученияКонечнойДатыПриЕженедФормировании");
	Результат.Добавить("ВариантОпределенияНачальнойДаты");
	Результат.Добавить("ВремяФормирования");
	Результат.Добавить("ВыгружатьОтчетВСоставеПакета");
	Результат.Добавить("ИмяФайла");
	Результат.Добавить("КаталогФайловДляОтправкиПоЭДО");
	Результат.Добавить("КаталогФайловСОшибкойОтправкиПоЭДО");
	Результат.Добавить("МаксимальныйРазмерФайлаДляВыгрузкиВЭДО");
	Результат.Добавить("МаксимальныйСуммарныйРазмерфайловПисьма");
	Результат.Добавить("ОтправлятьОтчетВСоставеПакета");
	Результат.Добавить("РучнаяЗагрузкаФайловВЭДО");
	Результат.Добавить("СрокПредоставления");
	Результат.Добавить("СрокФормирования");
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив с общими настройками отчетов
//
Функция ПолучитьОбщиеНастройки() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Коды", ПолучитьКодыОбщихНастроек());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОтчетов.Ссылка КАК Настройка
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НЕ НастройкиОтчетов.ПометкаУдаления
		|	И НастройкиОтчетов.Код В(&Коды)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Настройка");
	
КонецФункции

//	Возвращает зарегистрированные события с экземпляром отчета в таблице значений
//	
//	Параметры
//		- Экземпляр					- СправочникСсылка.ЭкземплярыОтчетов
//		- РучнаяЗагрузкаФаловВЭДО	- Булево. Значение соответствующей настройки. Требуется разделения события выгрузки в ЭДО 
//									  на выгрузку для ручной или автоматической загрузки. 
//									  Если параметр не передан, значение настройки определяется внутри функции
//		Колонки таблицы:
//			- КодСобытия			- числовой код события для вывода картинки
//			- Дата					- дата события
//			- Ответственный			- пользователь, под учетной записью которого зарегистрировано событие
//			- ИдентификаторВерсии	- идентификатор версии отчета, с которой произошло событие
//			- ИмяПриСохранении		- имя при сохранении версии файла
//			- ПакетДанных			- пакет данных (письма / выгрузка файла), который имеет отношение к событию
//			- Событие				- зарегистрированное событие
//
Функция ПолучитьСобытияСОтчетом(Экземпляр, РучнаяЗагрузкаФайловВЭДО = Неопределено) Экспорт
	
	Если РучнаяЗагрузкаФайловВЭДО = Неопределено Тогда		
		РеквизитыЭкземпляра = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Экземпляр, "Дата, Субъект, Отчет, Периодичность");	
		РучнаяЗагрузкаФайловВЭДО = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройки(
												РеквизитыЭкземпляра.Дата, 
												РеквизитыЭкземпляра.Субъект, 
												РеквизитыЭкземпляра.Отчет, 
												ПланыВидовХарактеристик.НастройкиОтчетов.ЗначениеНастройкиПоКоду("РучнаяЗагрузкаФайловВЭДО"), 
												РеквизитыЭкземпляра.Периодичность);		
												
		РучнаяЗагрузкаФайловВЭДО = ?(РучнаяЗагрузкаФайловВЭДО = Неопределено, Ложь, РучнаяЗагрузкаФайловВЭДО);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Экземпляр", 					Экземпляр);
	Запрос.УстановитьПараметр("РучнаяЗагрузкаФайловВЭДО", 	РучнаяЗагрузкаФайловВЭДО);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.УстановкаЗапретаОбработки)
		|			ТОГДА 1
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтключениеЗапретаОбработки)
		|			ТОГДА 2
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеВерсии)
		|			ТОГДА 3
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ЗагрузкаВерсииИзФайла)
		|			ТОГДА 4
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.УстановкаОкончательности)
		|			ТОГДА 5
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтключениеОкончательности)
		|			ТОГДА 6
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеВыгрузкиВЭДО)
		|			ТОГДА 7
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ВыгрузкаВЭДО)
		|				И &РучнаяЗагрузкаФайловВЭДО
		|			ТОГДА 18
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ВыгрузкаВЭДО)
		|			ТОГДА 8
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьма)
		|			ТОГДА 9
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтправкаПисьмом)
		|			ТОГДА 10
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаВыгрузкиВЭДО)
		|			ТОГДА 11
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмом)
		|			ТОГДА 12
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.РучнаяЗагрузкаВЭДО)
		|			ТОГДА 13
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаРучнойЗагрузкиВЭДО)
		|			ТОГДА 14
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьмаПоПросьбе)
		|			ТОГДА 15
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмомПоПросьбе)
		|			ТОГДА 16
		|		КОГДА ЖурналСобытийСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтправкаПисьмомПоПросьбе)
		|			ТОГДА 17
		|	КОНЕЦ КАК КодСобытия,
		|	ЖурналСобытийСОтчетами.Дата КАК Дата,
		|	ЖурналСобытийСОтчетами.Ответственный КАК Ответственный,
		|	ЖурналСобытийСОтчетами.ИдентификаторВерсии КАК ИдентификаторВерсии,
		|	ЭкземплярыОтчетовВерсииОтчетов.ИмяПриСохранении КАК ИмяПриСохранении,
		|	ЖурналСобытийСОтчетами.ПакетДанных КАК ПакетДанных,
		|	ЖурналСобытийСОтчетами.Событие КАК Событие,
		|	ЕСТЬNULL(НомераВерсийОтчетовДляКлиентов.НомерВерсии, ВЫБОР
		|			КОГДА ЭкземплярыОтчетовВерсииОтчетов.Актуальная
		|				ТОГДА ЕСТЬNULL(_МаксимальныйНомерВерсии.МаксимальныйНомерВерсии, 0) + 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК НомерВерсииДляКлиента,
		|	НЕ НомераВерсийОтчетовДляКлиентов.НомерВерсии ЕСТЬ NULL КАК ВерсияОтправлялась,
		|	ЭкземплярыОтчетовВерсииОтчетов.Размер КАК Размер
		|ИЗ
		|	РегистрСведений.ЖурналСобытийСОтчетами КАК ЖурналСобытийСОтчетами
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭкземплярыОтчетов.ВерсииОтчетов КАК ЭкземплярыОтчетовВерсииОтчетов
		|		ПО ЖурналСобытийСОтчетами.Экземпляр = ЭкземплярыОтчетовВерсииОтчетов.Ссылка
		|			И ЖурналСобытийСОтчетами.ИдентификаторВерсии = ЭкземплярыОтчетовВерсииОтчетов.ИдентификаторВерсии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераВерсийОтчетовДляКлиентов КАК НомераВерсийОтчетовДляКлиентов
		|		ПО ЖурналСобытийСОтчетами.Экземпляр = НомераВерсийОтчетовДляКлиентов.Экземпляр
		|			И ЖурналСобытийСОтчетами.ИдентификаторВерсии = НомераВерсийОтчетовДляКлиентов.ИдентификаторВерсии
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НомераВерсийОтчетовДляКлиентов.Экземпляр КАК Экземпляр,
		|			МАКСИМУМ(НомераВерсийОтчетовДляКлиентов.НомерВерсии) КАК МаксимальныйНомерВерсии
		|		ИЗ
		|			РегистрСведений.НомераВерсийОтчетовДляКлиентов КАК НомераВерсийОтчетовДляКлиентов
		|		ГДЕ
		|			НомераВерсийОтчетовДляКлиентов.Экземпляр = &Экземпляр
		|		
		|		СГРУППИРОВАТЬ ПО
		|			НомераВерсийОтчетовДляКлиентов.Экземпляр) КАК _МаксимальныйНомерВерсии
		|		ПО ЖурналСобытийСОтчетами.Экземпляр = _МаксимальныйНомерВерсии.Экземпляр
		|ГДЕ
		|	ЖурналСобытийСОтчетами.Экземпляр = &Экземпляр
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	КодСобытия";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

