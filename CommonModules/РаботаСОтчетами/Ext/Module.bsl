КонецФункции

#Область Отчет_о_расхождениях_наборов_данных

Функция ЗаполнитьОтчетОРасхожденияхНаборовДанных(Данные, Отчет, ЕстьРасхождения = Неопределено, ВернутьМассивРасхождений = Ложь, ГруппироватьРасхожденияПоСтрокам = Ложь) Экспорт

	Если ВернутьМассивРасхождений Тогда
		МассивРасхождений = Новый Массив;
	КонецЕсли;	
	
	ЕстьРасхождения = Ложь;
	
	Отчет.Очистить();
	
	Макет = ПолучитьОбщийМакет("РасхожденияНаборовДанных");
	
	// заголовок отчета
	Область = Макет.ПолучитьОбласть("ЗаголовокОтчета");
	Область.Параметры.ЗаголовокОтчета = Данные.ЗаголовокОтчета;
	
	Отчет.Вывести(Область);
	
	// параметры отчета
	Если Не Данные.Свойство("ВыводитьПараметры") ИЛИ Данные.ВыводитьПараметры Тогда
		
		Область = Макет.ПолучитьОбласть("ПараметрыОтчета");
	
		Для каждого КлючЗнач Из Данные.ПараметрыОтчета Цикл
			Область.Параметры.ИмяПараметра      = ПолучитьЗаголовокПоляОтчетаОРасхождениях(КлючЗнач.Ключ, Данные.Заголовки);
			Область.Параметры.ЗначениеПараметра = КлючЗнач.Значение;
			Отчет.Вывести(Область);
		КонецЦикла;
		
	КонецЕсли;
	
	// наборы данных
	ОбластьПустаяКолонка         = Макет.ПолучитьОбласть("СтрокаТаблицы|ПустаяКолонка");
	ОбластьИзмерение             = Макет.ПолучитьОбласть("СтрокаТаблицы|Измерение");
	ОбластьРесурсыБезРасхождений = Макет.ПолучитьОбласть("СтрокаТаблицы|Ресурсы");
	ОбластьРесурсыСРасхождениями = Макет.ПолучитьОбласть("СтрокаТаблицыРасхождения|Ресурсы");	
	
	ПредставлениеУчетнойСистемы = ?(Данные.Свойство("ПредставлениеУчетнойСистемы"), Данные.ПредставлениеУчетнойСистемы, "Учетная система");
	ПредставлениеВнешнейСистемы = ?(Данные.Свойство("ПредставлениеВнешнейСистемы"), Данные.ПредставлениеВнешнейСистемы, "Внешняя система");
	ВыводитьТолькоРасхождения	= Данные.Свойство("ВыводитьТолькоРасхождения") И Данные.ВыводитьТолькоРасхождения;
	
	Для каждого НаборДанных Из Данные.НаборыДанных Цикл
		
		Если НаборДанных.Свойство("Заголовок") Тогда
			Область = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			Область.Параметры.ЗаголовокТаблицы = НаборДанных.Заголовок;
			Отчет.Вывести(Область);
		КонецЕсли;
		
		НомПервойСтрокиТаблицы = Отчет.ВысотаТаблицы;
		Отчет.НачатьГруппуСтрок();
				
		// отобразим шапку
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|ПустаяКолонка");
		Отчет.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Измерение");
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
			Область.Параметры.Заголовок = ПолучитьЗаголовокПоляОтчетаОРасхождениях(Поле, Данные.Заголовки);
			Отчет.Присоединить(Область);
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Ресурсы");
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			Область.Параметры.Заголовок						= ПолучитьЗаголовокПоляОтчетаОРасхождениях(Поле, Данные.Заголовки);
			Область.Параметры.ПредставлениеУчетнойСистемы	= ПредставлениеУчетнойСистемы;
			Область.Параметры.ПредставлениеВнешнейСистемы	= ПредставлениеВнешнейСистемы;
			Отчет.Присоединить(Область);
		КонецЦикла;
		
		// подготовим запрос для сравнения и выборки расхождений
		
		ГруппироватьЗаписиПоКлючевымПолям = Не НаборДанных.Свойство("ГруппироватьЗаписиПоКлючевымПолям") ИЛИ НаборДанных.ГруппироватьЗаписиПоКлючевымПолям;
		
		Запрос = Новый Запрос;
		
		ДанныеВнешнейСистемы = ?(ТипЗнч(НаборДанных.ДанныеВнешнейСистемы) = Тип("ХранилищеЗначения"), НаборДанных.ДанныеВнешнейСистемы.Получить(), НаборДанных.ДанныеВнешнейСистемы);
		
		Запрос.УстановитьПараметр("ДанныеВнешнейСистемы", ДанныеВнешнейСистемы);
		
		Для каждого КлючЗнач Из Данные.ПараметрыОтчета Цикл
			Запрос.УстановитьПараметр(КлючЗнач.Ключ, КлючЗнач.Значение);
		КонецЦикла;
		
		Если ТипЗнч(НаборДанных.ДанныеУчетнойСистемы) = Тип("Строка") Тогда
			
			Запрос.Текст = СтрЗаменить(НаборДанных.ДанныеУчетнойСистемы, "ИЗ", "ПОМЕСТИТЬ _ДанныеУчетнойСистемы" + Символы.ПС + "ИЗ");
			
		Иначе
			
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДанныеУчетнойСистемы.*
				|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
				|ИЗ
				|	&ДанныеУчетнойСистемы КАК ДанныеУчетнойСистемы";
				
			Если ГруппироватьЗаписиПоКлючевымПолям Тогда
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ДанныеУчетнойСистемы", "_ДанныеУчетнойСистемыРазвернутые");
				
				Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + Символы.ПС +
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	&КлючевыеПоля,
					|	&СуммыРесурсов
					|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
					|ИЗ
					|	_ДанныеУчетнойСистемыРазвернутые КАК _ДанныеУчетнойСистемыРазвернутые
					|СГРУППИРОВАТЬ ПО
					|	&КлючевыеПоля";
				
			КонецЕсли;
			
			ДанныеУчетнойСистемы = ?(ТипЗнч(НаборДанных.ДанныеУчетнойСистемы) = Тип("ХранилищеЗначения"), НаборДанных.ДанныеУчетнойСистемы.Получить(), НаборДанных.ДанныеУчетнойСистемы);
			
			Запрос.УстановитьПараметр("ДанныеУчетнойСистемы", ДанныеУчетнойСистемы);
			
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + Символы.ПС +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеВнешнейСистемы.*
			|ПОМЕСТИТЬ _ДанныеВнешнейСистемы
			|ИЗ
			|	&ДанныеВнешнейСистемы КАК ДанныеВнешнейСистемы";
		
		Если ГруппироватьЗаписиПоКлючевымПолям Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ДанныеВнешнейСистемы", "_ДанныеВнешнейСистемыРазвернутые");
			
			Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + Символы.ПС +
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&КлючевыеПоля,
				|	&СуммыРесурсов
				|ПОМЕСТИТЬ _ДанныеВнешнейСистемы
				|ИЗ
				|	_ДанныеВнешнейСистемыРазвернутые КАК _ДанныеВнешнейСистемыРазвернутые
				|СГРУППИРОВАТЬ ПО
				|	&КлючевыеПоля";
			
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + Символы.ПС +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&СводныеКлючевыеПоля,
			|	&СводныеРесурсы,
			|	&Расхождения
			|ИЗ
			|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
			|	ПОЛНОЕ СОЕДИНЕНИЕ _ДанныеВнешнейСистемы КАК _ДанныеВнешнейСистемы
			|	ПО &УсловиеСоединенияКлючевыхПолей
			|ГДЕ
			|	&УсловиеФильтрацииРасхождений
			|УПОРЯДОЧИТЬ ПО
			|	&КлючевыеПоля";
			
		КлючевыеПоля					= "";
		СуммыРесурсов					= "";
		СводныеКлючевыеПоля				= "";
		СводныеРесурсы					= "";
		УсловиеСоединенияКлючевыхПолей	= "";
		Расхождения						= "";
		УсловиеФильтрацииРасхождений	= ?(ВыводитьТолькоРасхождения, "", "ИСТИНА");
				
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
			
			КлючевыеПоля = КлючевыеПоля
				+ ?(ПустаяСтрока(КлючевыеПоля), "", "," + Символы.ПС + Символы.Таб)
				+ Поле;
			
			СводныеКлючевыеПоля = СводныеКлючевыеПоля
				+ ?(ПустаяСтрока(СводныеКлючевыеПоля), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("ЕСТЬNULL(_ДанныеУчетнойСистемы.%1, _ДанныеВнешнейСистемы.%1) КАК %1", "%1", Поле);
				
			УсловиеСоединенияКлючевыхПолей = УсловиеСоединенияКлючевыхПолей
				+ ?(ПустаяСтрока(УсловиеСоединенияКлючевыхПолей), "", " И ")
				+ СтрЗаменить("_ДанныеУчетнойСистемы.%1 = _ДанныеВнешнейСистемы.%1", "%1", Поле);
				
		КонецЦикла;
		
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			
			Если ГруппироватьЗаписиПоКлючевымПолям Тогда
				
				СуммыРесурсов = СуммыРесурсов
					+ ?(ПустаяСтрока(СуммыРесурсов), "", "," + Символы.ПС + Символы.Таб)
					+ СтрЗаменить("СУММА(%1) КАК %1", "%1", Поле);
					
			КонецЕсли;
				
			СводныеРесурсы = СводныеРесурсы
				+ ?(ПустаяСтрока(СводныеРесурсы), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("_ДанныеУчетнойСистемы.%1 КАК %1УчетнойСистемы", "%1", Поле)
				+ "," + Символы.ПС + Символы.Таб + СтрЗаменить("_ДанныеВнешнейСистемы.%1 КАК %1ВнешнейСистемы", "%1", Поле);
				
		КонецЦикла;
		
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			
			Расхождения = Расхождения
				+ ?(ПустаяСтрока(Расхождения), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("ВЫБОР КОГДА (ЕСТЬNULL(_ДанныеУчетнойСистемы.%1, 0) <> ЕСТЬNULL(_ДанныеВнешнейСистемы.%1, 0)) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК РасхождениеПо%1", "%1", Поле);
				
			Если ВыводитьТолькоРасхождения Тогда
				
				УсловиеФильтрацииРасхождений = УсловиеФильтрацииРасхождений
					+ ?(ПустаяСтрока(УсловиеФильтрацииРасхождений), "", Символы.ПС + Символы.Таб + "ИЛИ ")
					+ СтрЗаменить("ВЫБОР КОГДА (ЕСТЬNULL(_ДанныеУчетнойСистемы.%1, 0) <> ЕСТЬNULL(_ДанныеВнешнейСистемы.%1, 0)) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ", "%1", Поле);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлючевыеПоля",					КлючевыеПоля);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммыРесурсов",					СуммыРесурсов);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СводныеКлючевыеПоля",			СводныеКлючевыеПоля);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СводныеРесурсы",					СводныеРесурсы);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединенияКлючевыхПолей",	УсловиеСоединенияКлючевыхПолей);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Расхождения",					Расхождения);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеФильтрацииРасхождений",	УсловиеФильтрацииРасхождений);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		// строки таблиц
		Пока Выборка.Следующий() Цикл
			Отчет.Вывести(ОбластьПустаяКолонка);
			
			Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
				ОбластьИзмерение.Параметры.Значение = Выборка[Поле];
				Отчет.Присоединить(ОбластьИзмерение);
			КонецЦикла;
			
			МассивРасхожденийСтроки = Новый Массив;
			
			Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
				Если Выборка["РасхождениеПо" + Поле] Тогда
					Область = ОбластьРесурсыСРасхождениями;
					ЕстьРасхождения = Истина;
					
					Если ВернутьМассивРасхождений Тогда
						
						Если ГруппироватьРасхожденияПоСтрокам Тогда
							
							МассивРасхожденийСтроки.Добавить(
								Новый Структура("Поле, ЗаголовокПоля, ЗначениеУчетнойСистемы, ЗначениеВнешнейСистемы",
									Поле,
									ПолучитьЗаголовокПоляОтчетаОРасхождениях(Поле, Данные.Заголовки),
									Выборка[Поле + "УчетнойСистемы"],
									Выборка[Поле + "ВнешнейСистемы"]
								)
							);
							
						Иначе
						
							МассивРасхождений.Добавить(
								Новый Структура("НаборДанных, КлючевыеПоля, Поле, ЗаголовокПоля, ЗначениеУчетнойСистемы, ЗначениеВнешнейСистемы",
								    НаборДанных,
									ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Выборка, НаборДанных.КлючевыеПоля),
									Поле,
									ПолучитьЗаголовокПоляОтчетаОРасхождениях(Поле, Данные.Заголовки),
									Выборка[Поле + "УчетнойСистемы"],
									Выборка[Поле + "ВнешнейСистемы"]
								)
							);
							
						КонецЕсли;
						
					КонецЕсли;
				Иначе
					Область = ОбластьРесурсыБезРасхождений;
				КонецЕсли;
				
				Область.Параметры.ЗначениеУчетнойСистемы = Выборка[Поле + "УчетнойСистемы"];
				Область.Параметры.ЗначениеВнешнейСистемы = Выборка[Поле + "ВнешнейСистемы"];
				Отчет.Присоединить(Область);
			КонецЦикла;
			
			Если ВернутьМассивРасхождений И ГруппироватьРасхожденияПоСтрокам И МассивРасхожденийСтроки.Количество() > 0 Тогда
				
				МассивРасхождений.Добавить(
					Новый Структура("НаборДанных, КлючевыеПоля, Поля",
					    НаборДанных,
						ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Выборка, НаборДанных.КлючевыеПоля),
						МассивРасхожденийСтроки
					)
				);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Отчет.ЗакончитьГруппуСтрок();
		
		ВсегоИзмерений = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина).Количество();
		ПодобратьШиринуКолонокТаблицыОтчета(Отчет, НомПервойСтрокиТаблицы + 1, 2, Отчет.ВысотаТаблицы, 2 + ВсегоИзмерений);		
		
	КонецЦикла;
	
	Если ВернутьМассивРасхождений Тогда
		Возврат МассивРасхождений;
	КонецЕсли;
	
КонецФункции // ЗаполнитьОтчетОРасхожденияхНаборовДанных

Функция ПолучитьЗаголовокПоляОтчетаОРасхождениях(ИмяПоля, Заголовки)
	Перем ЗаголовокПоля;
	
	Если Не Заголовки.Свойство(ИмяПоля, ЗаголовокПоля) Тогда
		ЗаголовокПоля = ИмяПоля;
	КонецЕсли;
	
	Возврат ЗаголовокПоля;
	
КонецФункции // ПолучитьЗаголовокПоляОтчетаОРасхождениях

#КонецОбласти

#Область Контроль_расходов_по_сделкам

Процедура КонтрольМультивалютностиРасходовПоСделкам(СчетДоверительногоУправления, ДатаНачала, ДатаОкончания, Сделки = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Сделка КАК Сделка,
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	(ВЫБРАТЬ
		|		РасходыПоСделкеОбороты.Сделка КАК Сделка,
		|		РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|		РасходыПоСделкеОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|		РасходыПоСделкеОбороты.Валюта КАК Валюта
		|	ИЗ
		|		РегистрНакопления.РасходыПоСделке.Обороты(&ДатаНачала, , Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК РасходыПоСделкеОбороты
		|	ГДЕ
		|		РасходыПоСделкеОбороты.Сделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Сделка,
		|	ВложенныйЗапрос.ЦеннаяБумага,
		|	ВложенныйЗапрос.ВидЗадолженности
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала"					, ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ДатаОкончания);
	
	Если Сделки <> Неопределено Тогда
		Если ТипЗнч(Сделки) = Тип("Массив") Тогда
			Запрос.УстановитьПараметр("МассивСделок", Сделки);
		Иначе
			МассивСделок = Новый Массив;
			МассивСделок.Добавить(Сделки);
			Запрос.УстановитьПараметр("МассивСделок", МассивСделок);
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РасходыПоСделкеОбороты.Сделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания", "РасходыПоСделкеОбороты.Сделка В (&МассивСделок)");
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		ТекстОщибки = "Обнаружены комиссии по сделкам одного вида в разных валютах:";
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстОщибки = ТекстОщибки + Символы.ПС + "Сделка: " + Выборка.Сделка + ", ЦБ: " + Выборка.ЦеннаяБумага + ", Вид комиссии: " + Выборка.ВидЗадолженности;
		КонецЦикла;
		
		ВызватьИсключение ТекстОщибки;
	
	КонецЕсли;
	
КонецПроцедуры	

Процедура КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(СчетДоверительногоУправления, ДатаНачала, ДатаОкончания, Сделки = Неопределено) Экспорт

