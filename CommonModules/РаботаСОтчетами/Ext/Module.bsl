		|			ТОГДА &СтрокаДенежныеСредства
		|		КОГДА _Резервы.Тип = ТИП(Справочник.Облигации)
		|				И _Резервы.ВидАктива = ""АС""
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_Резервы.Актив КАК Справочник.Облигации).УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов))
		|						ТОГДА &СтрокаДолговыеПоАсКредитныеОрганизации
		|					ИНАЧЕ &СтрокаДолговыеПоАсПрочие
		|				КОНЕЦ
		|		КОГДА _Резервы.Тип = ТИП(Справочник.Облигации)
		|				И _Резервы.ВидАктива = ""СС""
		|			ТОГДА &СтрокаДолговыеПоСС
		|		КОГДА _Резервы.Тип = ТИП(Документ.МНО)
		|			ТОГДА &СтрокаДенежныеСредства
		|		КОГДА _Резервы.Тип = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА &СтрокаДебиторскаяЗадолженность
		|	КОНЕЦ КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА _Резервы.СтрокаСопоставления = 1
		|			ТОГДА ""02""
		|		КОГДА _Резервы.СтрокаСопоставления = 2
		|			ТОГДА ""03""
		|		КОГДА _Резервы.СтрокаСопоставления = 3
		|			ТОГДА ""04""
		|		КОГДА _Резервы.СтрокаСопоставления = 4
		|			ТОГДА ""05""
		|		ИНАЧЕ ""06""
		|	КОНЕЦ КАК НомерКолонки,
		|	_Резервы.Актив КАК Актив,
		|	_Резервы.Тип КАК Тип,
		|	_Резервы.СтадияОбесценения КАК СтадияОбесценения,
		|	_Резервы.СтрокаСопоставления КАК СтрокаСопоставления,
		|	_Резервы.Сумма - ЕСТЬNULL(_ПроцентыМНО.СуммаОстаток, 0) - ЕСТЬNULL(_ПроцентыДепозиты.СуммаОстаток, 0) КАК Сумма,
		|	_Резервы.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_Резервы.РейтинговоеАгентство КАК РейтинговоеАгентство
		|ПОМЕСТИТЬ _ТаблицаОтчета
		|ИЗ
		|	_Резервы КАК _Резервы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Депозиты КАК _Депозиты
		|		ПО _Резервы.Актив = _Депозиты.Депозит
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПроцентыМНО КАК _ПроцентыМНО
		|		ПО _Резервы.Актив = _ПроцентыМНО.МНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПроцентыДепозиты КАК _ПроцентыДепозиты
		|		ПО _Резервы.Актив = _ПроцентыДепозиты.Депозит
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&СтрокаМНО,
		|	ВЫБОР
		|		КОГДА _Резервы.СтрокаСопоставления = 1
		|			ТОГДА ""02""
		|		КОГДА _Резервы.СтрокаСопоставления = 2
		|			ТОГДА ""03""
		|		КОГДА _Резервы.СтрокаСопоставления = 3
		|			ТОГДА ""04""
		|		КОГДА _Резервы.СтрокаСопоставления = 4
		|			ТОГДА ""05""
		|		ИНАЧЕ ""06""
		|	КОНЕЦ,
		|	_ПроцентыМНО.МНО,
		|	_Резервы.Тип,
		|	_Резервы.СтадияОбесценения,
		|	_Резервы.СтрокаСопоставления,
		|	_ПроцентыМНО.СуммаОстаток,
		|	_Резервы.ЗначениеРейтинга,
		|	_Резервы.РейтинговоеАгентство
		|ИЗ
		|	_ПроцентыМНО КАК _ПроцентыМНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Резервы КАК _Резервы
		|		ПО _ПроцентыМНО.МНО = _Резервы.Актив
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА &ПроцентыПоДепозитамВДС
		|				И _Депозиты.ЭтоКраткосрочныйДепозит
		|			ТОГДА &СтрокаДенежныеСредства
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _Депозиты.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)
		|					ТОГДА &СтрокаДепозитыПоАС
		|				ИНАЧЕ &СтрокаДепозитыПоСС
		|			КОНЕЦ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _Резервы.СтрокаСопоставления = 1
		|			ТОГДА ""02""
		|		КОГДА _Резервы.СтрокаСопоставления = 2
		|			ТОГДА ""03""
		|		КОГДА _Резервы.СтрокаСопоставления = 3
		|			ТОГДА ""04""
		|		КОГДА _Резервы.СтрокаСопоставления = 4
		|			ТОГДА ""05""
		|		ИНАЧЕ ""06""
		|	КОНЕЦ,
		|	_ПроцентыДепозиты.Депозит,
		|	_Резервы.Тип,
		|	_Резервы.СтадияОбесценения,
		|	_Резервы.СтрокаСопоставления,
		|	_ПроцентыДепозиты.СуммаОстаток,
		|	_Резервы.ЗначениеРейтинга,
		|	_Резервы.РейтинговоеАгентство
		|ИЗ
		|	_ПроцентыДепозиты КАК _ПроцентыДепозиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Депозиты КАК _Депозиты
		|		ПО _ПроцентыДепозиты.Депозит = _Депозиты.Депозит
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Резервы КАК _Резервы
		|		ПО _ПроцентыДепозиты.Депозит = _Резервы.Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Резервы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПроцентыМНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПроцентыДепозиты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Депозиты";  
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьССпоМодели3ДляГруппыБудущее(РеквизитыПереоценки, Облигация)
	
	Результат = Новый Структура;
	
	Отказ = Ложь; 
	Дата = РеквизитыПереоценки.Дата;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, РеквизитыПереоценки.Организация, РеквизитыПереоценки.СчетДоверительногоУправления);
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(Дата, РеквизитыПереоценки.Организация, РеквизитыПереоценки.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(РеквизитыПереоценки, Дата, Облигация, Отказ);
	
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		Истина);
	ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	НастройкиУчета.УчитыватьКупонКОферте);

	ПараметрыДенежногоПотока.Вставить("Дата",				Дата);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		Дата);
	
	ПараметрыДенежногоПотока.Вставить("НеУчитыватьРешенияКлиентовПоПотокам", Истина);
	
	РасшифровкаРасчета = Новый Структура();
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	Облигация);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	Поток = Справочники.Облигации.ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, РеквизитыПереоценки, Отказ, РасшифровкаРасчета);
	
	Если Поток = Неопределено Тогда
		Результат.Вставить("Стоимость", 0);
		Результат.Вставить("Купон", 0);
		
		Возврат Результат;
	КонецЕсли;
	
	Поток.Свернуть("Дата", "Поток");
	Поток.Сортировать("Дата");
	
	Поток.Колонки.Добавить("СрокВГодах", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("PD", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("PDi", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("ПотокСРезервом", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("LGD", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("КБД", Новый ОписаниеТипов("Число"));
	Поток.Колонки.Добавить("ПотокСРезервомИКБД", Новый ОписаниеТипов("Число"));
	
	ДокументРезервов = Документы.НачислениеСписаниеРезервов.СоздатьДокумент();
	ДокументРезервов.Дата = Дата;
	ДокументРезервов.СчетДоверительногоУправления = РеквизитыПереоценки.СчетДоверительногоУправления;
	
	ТаблицаPD = ДокументРезервов.ПолучитьТаблицуPD("ЭволюцияШкалаPD", Истина);
	ПараметрыНастройкиДляPDАктиваНаДату = ДокументРезервов.ПолучитьНастройкиДляPDАктиваНаДату();

	LGD = 0.45;
	PD = ДокументРезервов.ПолучитьPDАктиваНаДату(Дата, Облигация, Облигация.Эмитент.ЮрФизЛицо, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
	
	Для каждого СтрокаПотока Из Поток Цикл
		
		КоличествоДней = (СтрокаПотока.Дата - Дата) / (60 * 60 * 24);
		
		СтрокаПотока.СрокВГодах = КоличествоДней / 365;
		СтрокаПотока.LGD = LGD;
		СтрокаПотока.PD = PD / 100;
		СтрокаПотока.PDi = 1 - Pow(1 - СтрокаПотока.PD, МатематическиеФункции.ОкрВверхДоЦелого(СтрокаПотока.СрокВГодах));
		СтрокаПотока.ПотокСРезервом = СтрокаПотока.Поток * (1 - СтрокаПотока.LGD * СтрокаПотока.PDi);
		СтрокаПотока.КБД = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьЗначениеКривойБескупоннойДоходности(Дата, СтрокаПотока.СрокВГодах,, Отказ);
		
		СтрокаПотока.ПотокСРезервомИКБД = СтрокаПотока.ПотокСРезервом / Pow(1 + СтрокаПотока.КБД / 100, СтрокаПотока.СрокВГодах);
		
	КонецЦикла;
	
	Номинал = РаботаСЦеннымиБумагами.ПолучитьНоминалИВалютуЦеннойБумаги(Облигация, Дата).Номинал;
	НКД = Справочники.Облигации.ПолучитьКупон(Облигация, Дата, РеквизитыПереоценки.СчетДоверительногоУправления);
	НКДВПроцентах = НКД / Номинал * 100;
	ЦенаСНКД = 100 / Номинал * Поток.Итог("ПотокСРезервомИКБД");
	ЦенаВПроцентах = ЦенаСНКД - НКДВПроцентах;
	
	Цена = Номинал * ЦенаВПроцентах / 100;
	
	Результат.Вставить("Стоимость", Цена);
	Результат.Вставить("Купон", НКД); 
	
	Возврат Результат;
	
КонецФункции 


Функция ПолучитьУровеньОценкиБумагПоСправедливойСтоимости(ПараметрыОценки, МВТ)
		
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;

	Если ТипЗнч(ПараметрыОценки.СчетДоверительногоУправления) = Тип("Массив") Тогда 
		СчетДоверительногоУправления = ПараметрыОценки.СчетДоверительногоУправления[0];  //расшифровка строиттся по клиенту. Берем первый СчетДУ, предполагая, что настройки у них будут одинакорвые.   
	Иначе
		СчетДоверительногоУправления = ПараметрыОценки.СчетДоверительногоУправления;  
	КонецЕсли;  
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыОценки.мДатаКонцаПериодаОтчета, ПараметрыОценки.Организация, СчетДоверительногоУправления, ЦельРасчета, Истина);
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоКлиентБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, ПараметрыОценки.мДатаКонцаПериодаОтчета);	
	
	РеквизитыПереоценки = Новый Структура;
	
	РеквизитыПереоценки.Вставить("Дата",									НачалоДня(ПараметрыОценки.мДатаКонцаПериодаОтчета));
	РеквизитыПереоценки.Вставить("Организация",								ПараметрыОценки.Организация);         
	РеквизитыПереоценки.Вставить("СчетДоверительногоУправления",			СчетДоверительногоУправления);  
	РеквизитыПереоценки.Вставить("ЦельРасчета",								ЦельРасчета);
	РеквизитыПереоценки.Вставить("ВидУчета",								Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	РеквизитыПереоценки.Вставить("ПереоцениватьНаОснованииНастроекУчета",	Ложь);
	РеквизитыПереоценки.Вставить("ВариантРасчетаОценочнойСтоимости",		НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
	РеквизитыПереоценки.Вставить("ВариантРасчетаСправедливойСтоимости",		НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
	РеквизитыПереоценки.Вставить("ЦенныеБумаги",							Новый ТаблицаЗначений);
	РеквизитыПереоценки.Вставить("ПараметрыПолученияПартий",				Неопределено);   
	Если ПараметрыОценки.Свойство("Клиент") И ЗначениеЗаполнено(ПараметрыОценки.Клиент) Тогда 
		РеквизитыПереоценки.Вставить("Клиент",								ПараметрыОценки.Клиент);
	Иначе 	
		РеквизитыПереоценки.Вставить("Клиент",								Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, РеквизитыПереоценки.Дата)); 
	КонецЕсли;
	РеквизитыПереоценки.Вставить("ОцениватьПоСправедливойСтоимости", 		Истина);
	
	//отберем только по амортизированной, + бумаги РЕПО
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
	|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
	|	ЛОЖЬ КАК ЭтоРЕПО,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС
	|ПОМЕСТИТЬ _ЦенныеБумагиАМ
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&грКонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДоверительногоУправления)
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	|				И УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))) КАК БухПартииЦенныхБумагОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага,
	|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок,
	|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток,
	|	ИСТИНА,
	|	NULL
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
	|			&грКонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДоверительногоУправления)
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ЦенныеБумагиАМ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ЦенныеБумагиАМ.Рынок КАК Рынок,
	|	СУММА(_ЦенныеБумагиАМ.Количество) КАК Количество
	|ИЗ
	|	_ЦенныеБумагиАМ КАК _ЦенныеБумагиАМ
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЦенныеБумагиАМ.ЦеннаяБумага,
	|	_ЦенныеБумагиАМ.Рынок";
	
	Запрос.УстановитьПараметр("грКонецПериода", Новый Граница(ПараметрыОценки.мДатаКонцаПериодаОтчета, ВидГраницы.Включая)); 
	Запрос.УстановитьПараметр("Организация", ПараметрыОценки.Организация);  
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОценки.СчетДоверительногоУправления); 
	
	ТаблицаЦБ = Запрос.Выполнить().Выгрузить();
	
	// и переоценим бумаги по амортизированной как по справедливой
	ТаблицаСтоимостейЦБ = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(РеквизитыПереоценки, НачалоДня(ПараметрыОценки.мДатаКонцаПериодаОтчета), ТаблицаЦБ, , Ложь);

	Для Каждого СтрокаТаблицы из ТаблицаСтоимостейЦБ Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Стоимость) Тогда 
			СтрокаТаблицы.Стоимость = 0;  //дефолтные бумаги Стоимость неопределено. 
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Купон) Тогда 
			СтрокаТаблицы.Купон = 0;  //на всякий случай
		КонецЕсли;  
		
		Если СтрокаТаблицы.Стоимость = 0 И ЭтоКлиентБудущее Тогда                                                          
			СтоимостьСС = ПолучитьССпоМодели3ДляГруппыБудущее(РеквизитыПереоценки, СтрокаТаблицы.ЦеннаяБумага);
			СтрокаТаблицы.Стоимость = СтоимостьСС.Стоимость; 
			СтрокаТаблицы.Купон = СтоимостьСС.Купон;
			СтрокаТаблицы.УровеньОценки = 3;
			СтрокаТаблицы.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена;
			СтрокаТаблицы.ДатаЦены = НачалоДня(ПараметрыОценки.мДатаКонцаПериодаОтчета);
		КонецЕсли;
		
	КонецЦикла;	  
	
	Возврат ТаблицаСтоимостейЦБ;
	
КонецФункции	

