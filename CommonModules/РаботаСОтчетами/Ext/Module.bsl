// Возвращает созданный по ключевым полям экземпляр отчета
//	Параметры:
//		- Организация	- организация, которой принадлежит отчет
//		- Субъект		- субъект отчета (пока только договор ДУ)
//		- Отчет			- клиентский отчет
//		- Периодичность	- периодичность отчета
//		- Дата			- отчетная дата
//
Функция СоздатьЭкземплярОтчета(Организация, Субъект, Отчет, Периодичность, Дата) Экспорт
	
	Результат = Справочники.ЭкземплярыОтчетов.СоздатьЭлемент();
	
	Результат.Организация	= Организация;
	Результат.Субъект		= Субъект;
	Результат.Отчет			= Отчет;
	Результат.Периодичность	= Периодичность;
	Результат.Дата			= Дата;
	
	Результат.Записать();
	
	Возврат Результат.Ссылка;
	
КонецФункции

// Процедура проверяет, есть ли необходимость в регистрации события очтета, и, если она есть, регистрирует событие с отчетом
//	Параметры:
//		Пакет - пакет данных к обработке, который помечается на удаление или для которого отменяется обработка
//
Процедура ЗафиксироватьОтменуОтправкиИлиВыгрузкиОтчета(Пакет) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналСобытийСОтчетами.Экземпляр КАК Экземпляр,
		|	ЖурналСобытийСОтчетами.ИдентификаторВерсии КАК ИдентификаторВерсии,
		|	ЖурналСобытийСОтчетами.Событие КАК Событие,
		|	ЖурналСобытийСОтчетами.Дата КАК Дата
		|ПОМЕСТИТЬ _СобытияСОтчетами
		|ИЗ
		|	РегистрСведений.ЖурналСобытийСОтчетами КАК ЖурналСобытийСОтчетами
		|ГДЕ
		|	ЖурналСобытийСОтчетами.ПакетДанных = &Пакет
		|	И ЖурналСобытийСОтчетами.Событие В (ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьма), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмом), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтправкаПисьмом), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеВыгрузкиВЭДО), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаВыгрузкиВЭДО), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ВыгрузкаВЭДО), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьмаПоПросьбе), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмомПоПросьбе), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтправкаПисьмомПоПросьбе))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СобытияСОтчетами.Экземпляр КАК Экземпляр,
		|	_СобытияСОтчетами.ИдентификаторВерсии КАК ИдентификаторВерсии,
		|	МАКСИМУМ(_СобытияСОтчетами.Дата) КАК Дата
		|ПОМЕСТИТЬ _ДатыПоследнихСобытийСОтчетами
		|ИЗ
		|	_СобытияСОтчетами КАК _СобытияСОтчетами
		|
		|СГРУППИРОВАТЬ ПО
		|	_СобытияСОтчетами.Экземпляр,
		|	_СобытияСОтчетами.ИдентификаторВерсии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СобытияСОтчетами.Экземпляр КАК Экземпляр,
		|	ВЫБОР
		|		КОГДА _СобытияСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьма)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмом)
		|		КОГДА _СобытияСОтчетами.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьмаПоПросьбе)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаОтправкиПисьмомПоПросьбе)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.ОтменаВыгрузкиВЭДО)
		|	КОНЕЦ КАК Событие,
		|	_СобытияСОтчетами.ИдентификаторВерсии КАК ИдентификаторВерсии
		|ИЗ
		|	_СобытияСОтчетами КАК _СобытияСОтчетами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыПоследнихСобытийСОтчетами КАК _ДатыПоследнихСобытийСОтчетами
		|		ПО _СобытияСОтчетами.Экземпляр = _ДатыПоследнихСобытийСОтчетами.Экземпляр
		|			И _СобытияСОтчетами.ИдентификаторВерсии = _ДатыПоследнихСобытийСОтчетами.ИдентификаторВерсии
		|			И _СобытияСОтчетами.Дата = _ДатыПоследнихСобытийСОтчетами.Дата
		|ГДЕ
		|	_СобытияСОтчетами.Событие В (ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьма), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеВыгрузкиВЭДО), ЗНАЧЕНИЕ(Перечисление.СобытияСОтчетами.СозданиеПисьмаПоПросьбе))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьСобытиеСОтчетом(Выборка.Событие, Выборка.Экземпляр, Выборка.ИдентификаторВерсии, Пакет);
	КонецЦикла;
	
КонецПроцедуры

// Регистрирует событие с отчетом в журнале событий отчетов
// в случае возникновения ошибки - регистрирует ее, исключение при этом не генерируется
//	Параметры:
//		Событие				- регистрируемое событие (перечисление "СобытияСОтчетами")
//		Экземпляр			- экземпляр отчета, для которого необходимо зарегистрировать событие
//		ИдентификаторВерсии	- идентификатор версии очтета, для которой необходимо зарегистрировать событие
//		ПакетДанных			- пакет данных (выгрузка в ЭДО или письмо), которое имеет отношение к регистрируемому событию
//
Процедура ЗафиксироватьСобытиеСОтчетом(Событие, Экземпляр, ИдентификаторВерсии = Неопределено, ПакетДанных = Неопределено) Экспорт
	
	Запись = РегистрыСведений.ЖурналСобытийСОтчетами.СоздатьМенеджерЗаписи();
	
	Запись.Экземпляр	= Экземпляр;
	Запись.Событие		= Событие;
	Запись.Дата			= ТекущаяДатаСеанса();
	
	Если ИдентификаторВерсии <> Неопределено Тогда
		Запись.ИдентификаторВерсии = ИдентификаторВерсии;
	КонецЕсли;
	
	Если ПакетДанных <> Неопределено Тогда
		Запись.ПакетДанных = ПакетДанных;
	КонецЕсли;
	
	Запись.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Попытка
		Запись.Записать();
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось зафиксировать событие (%1) с отчетом %2 (%3) по %4 за %5 из-за ошибки:%6",
								Событие,
								Экземпляр.Отчет,
								Экземпляр.Периодичность,
								Экземпляр.Субъект,
								Экземпляр.Дата,
								Символы.ПС + ОписаниеОшибки());
		
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Фиксация событий с отчетами");
		
	КонецПопытки;
	
КонецПроцедуры

// Возвращает таблицу с данными о текущем состоянии отчетов
// Параметры:
//	- Организация	- организация, которой принадлежит отчет
//	- Отчеты		- таблица значений, содержащая данные отчетов, по которым требуется получить состояние
//		колонки таблицы отчетов:
//			- Субъект					- договор ДУ (пока только договор) отчета
//			- Отчет						- ссылка на отчет
//			- КлючОтчета				- ключ отчета
//			- Периодичность				- периодичность отчета
//			- Дата						- отчетная дата отчета
//			- ДатаНачала				- начало периода отчета, используется для определения ссылки на регламентированный отчет
//			- ДатаОкончания				- конец периода отчета, используется для определения ссылки на регламентированный отчет
//			- ОтправляетсяПочтой		- признак автоматической отправки отчета почтой
//			- ВыгружаетсяВЭДО			- признак автоматической выгрузки отчета в ЭДО
//			- РучнаяЗагрузкаФайловВЭДО	- признак того, что после выполнения выгрузки файла в ЭДО его нужно загрузить в ЭДО вручную
//			- Регламентированный		- признак того, что отчет является регламентированным
//			- ВалютаДокумента			- валюта документа регламентированного очтета, используется для определения ссылки на регламентированный отчет
//			- ОтчетЗаПоследнийКвартал	- признак того, что отчет за последний квартал, используется для определения ссылки на регламентированный отчет
//			- ВыбраннаяФорма			- выбранная форма отчета, используется для определения ссылки на регламентированный отчет
//			- ИдентификаторСтроки		- строковый идентификатор строки таблицы
//
// Колонки возвращаемой таблицы:
//	- ИдентификаторСтроки				- идентификатор строки из исходной таблицы
//	- Регламентированный				- признак того, что отчет является регламентированным
//	- РегламентированныйОтчет			- ссылка на регламентированный отчет, если удалось определить
//	- СтатусРегламентированногоОтчета	- текущий статус регламентированного очтета
//	- Экземпляр							- ссылка на экземпляр отчета
//	- ВерсияДанных						- версия данных экземпляра отчета
//	- ЗапретОбработки					- признак того, что для экземпляра отчета установлен запрет обработки
//	- ИдентификаторВерсии				- идентификатор актуальной версии отчета
//	- КонтрольнаяСумма					- контрольная сумма актуальной версии очтета
//	- ИмяПриСохранении					- имя файла для версии отчета, которое было определено по значению настройки "ИмяФайла" на момент сохранения версии
//	- Окончательная						- признак того, что актуальная версия является окончательной
//	- СтатусВерсии						- числовой статус версии (0 - отсутствует, 1 - предварительная, 2 - окончательная)
//	- СтатусВыгрузки					- числовой статус выгрузки в ЭДО (0 - не выгружается и не выгружен, 1 - выгружается, но не выгружен, 2 - создано задание на выгрузку, 3 - не выгружен из-за ошибки, 4 - успешно выгружен)
//	- Выгрузка							- ссылка на пакет данных выгрузки в ЭДО
//	- СтатусОтправки					- числовой статус отправки почтой (0 - не отправляется и не отправлен, 1 - отправляется, но не отправлен, 2 - создано письмо, 3 - не отправлен из-за ошибки, 4 - успешно отправлен)
//	- Письмо							- ссылка на пакет данных письма
//	- ОбработкаЗавершена				- признак того, что все обязательные действия с отчетом выполнены
//	- Сформировать						- признак того, что нужно создать окончательную версию отчета
//	- Выгрузить							- признак того, что нужно выгрузить окончательную версию отчета в ЭДО
//	- Отправить							- признак того, что нужно отправить окончательную версию отчета почтой
//
Функция ПолучитьСостоянияОтчетов(Организация, Отчеты) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Отчеты",			Отчеты);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	Отчеты.Субъект КАК Договор,
		|	Отчеты.Отчет КАК Отчет,
		|	Отчеты.КлючОтчета КАК КлючОтчета,
		|	Отчеты.Периодичность КАК Периодичность,
		|	Отчеты.Дата КАК Дата,
		|	Отчеты.ДатаНачала КАК ДатаНачала,
		|	Отчеты.ДатаОкончания КАК ДатаОкончания,
		|	Отчеты.ОтправляетсяПочтой КАК ОтправляетсяПочтой,
		|	Отчеты.ВыгружаетсяВЭДО КАК ВыгружаетсяВЭДО,
		|	Отчеты.РучнаяЗагрузкаФайловВЭДО КАК РучнаяЗагрузкаФайловВЭДО,
		|	Отчеты.Регламентированный КАК Регламентированный,
		|	Отчеты.ВалютаДокумента КАК ВалютаДокумента,
		|	Отчеты.ОтчетЗаПоследнийКвартал КАК ОтчетЗаПоследнийКвартал,
		|	Отчеты.ВыбраннаяФорма КАК ВыбраннаяФорма,
		|	Отчеты.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ _ТаблицаОтчетов
		|ИЗ
		|	&Отчеты КАК Отчеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОтчетов.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	РегламентированныйОтчет.Ссылка КАК РегламентированныйОтчет,
		|	РегламентированныйОтчет.СтатусОтчета КАК СтатусРегламентированногоОтчета,
		|	РегламентированныйОтчет.НомерКорректировки КАК НомерКорректировки
		|ПОМЕСТИТЬ _ВсеРегламентированныеОтчеты
		|ИЗ
		|	_ТаблицаОтчетов КАК _ТаблицаОтчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегламентированныйОтчет КАК РегламентированныйОтчет
		|		ПО (_ТаблицаОтчетов.Регламентированный)
		|			И (НЕ РегламентированныйОтчет.ПометкаУдаления)
		|			И (РегламентированныйОтчет.Организация = &Организация)
		|			И _ТаблицаОтчетов.Договор = РегламентированныйОтчет.СчетДоверительногоУправления
		|			И _ТаблицаОтчетов.ДатаНачала = РегламентированныйОтчет.ДатаНачала
		|			И (НАЧАЛОПЕРИОДА(_ТаблицаОтчетов.ДатаОкончания, ДЕНЬ) = РегламентированныйОтчет.ДатаОкончания)
		|			И _ТаблицаОтчетов.ВалютаДокумента = РегламентированныйОтчет.ВалютаДокумента
		|			И _ТаблицаОтчетов.ОтчетЗаПоследнийКвартал = РегламентированныйОтчет.ОтчетЗаПоследнийКвартал
		|			И ((ВЫРАЗИТЬ(_ТаблицаОтчетов.ВыбраннаяФорма КАК СТРОКА(254))) = РегламентированныйОтчет.ВыбраннаяФорма)
		|			И ((ВЫРАЗИТЬ(_ТаблицаОтчетов.КлючОтчета КАК СТРОКА(254))) = РегламентированныйОтчет.ИсточникОтчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеРегламентированныеОтчеты.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	МАКСИМУМ(_ВсеРегламентированныеОтчеты.НомерКорректировки) КАК НомерКорректировки
		|ПОМЕСТИТЬ _НомераКорректировокРегламентированныхОтчетов
		|ИЗ
		|	_ВсеРегламентированныеОтчеты КАК _ВсеРегламентированныеОтчеты
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеРегламентированныеОтчеты.ИдентификаторСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОтчетов.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	МАКСИМУМ(_ВсеРегламентированныеОтчеты.РегламентированныйОтчет) КАК РегламентированныйОтчет,
		|	МАКСИМУМ(_ВсеРегламентированныеОтчеты.СтатусРегламентированногоОтчета) КАК СтатусРегламентированногоОтчета
		|ПОМЕСТИТЬ _ДанныеРегламентированныхОтчетов
		|ИЗ
		|	_ТаблицаОтчетов КАК _ТаблицаОтчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НомераКорректировокРегламентированныхОтчетов КАК _НомераКорректировокРегламентированныхОтчетов
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _НомераКорректировокРегламентированныхОтчетов.ИдентификаторСтроки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеРегламентированныеОтчеты КАК _ВсеРегламентированныеОтчеты
		|		ПО _ТаблицаОтчетов.ИдентификаторСтроки = _ВсеРегламентированныеОтчеты.ИдентификаторСтроки
