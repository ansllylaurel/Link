		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдресФИАС КАК ЮридическийАдресФИАС,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК ВебСтраница,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
		|	ВЫБОР
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РЭМ""
		|			ТОГДА ""РЭМ""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_ТрастМ""
		|			ТОГДА ""Траст""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РПИ""
		|			ТОГДА ""РПИ""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_МДТраст""
		|			ТОГДА ""МдТраст""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ИмяОбласти,
		|	ВЫБОР
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РЭМ""
		|			ТОГДА ""ЛоготипРЭМ""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_ТрастМ""
		|			ТОГДА ""ЛоготипТраст""
		|		КОГДА ИменованныеОбъекты.Имя = ""Организация_РПИ""
		|			ТОГДА ""ЛоготипРПИ""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ИмяЛоготипа
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|		ПО Организации.Ссылка = ИменованныеОбъекты.Объект
		|			И (ИменованныеОбъекты.Имя В (""Организация_РЭМ"", ""Организация_ТрастМ"", ""Организация_РПИ"", ""Организация_МДТраст""))
		|ГДЕ
		|	Организации.Ссылка = &Организация";
#КонецОбласти	

	ОбластьБланк = Новый ТабличныйДокумент;

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Макет = ПолучитьОбщийМакет("ОфициальныйБланкОрганизации");
		
		Если Макет.Области.Найти(Выборка.ИмяОбласти) <> Неопределено Тогда
			
			ОбластьБланк = Макет.ПолучитьОбласть(Выборка.ИмяОбласти);
			
			ПараметрыМакета = Новый Структура;

			СтрокаНаименование = Выборка.НаименованиеОрганизации;
			Позиция = Найти(СтрокаНаименование,"""");
			
