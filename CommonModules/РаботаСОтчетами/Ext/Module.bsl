	|			ТОГДА _ИтоговаяТаблица.Стоимость - _ИтоговаяТаблица.РезервПодОбесцение
	|		КОГДА НЕ _ИтоговаяТаблица.ЦБКраткосрочная
	|				И _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА _ИтоговаяТаблица.СтоимостьКупона
	|		КОГДА НЕ _ИтоговаяТаблица.ЦБКраткосрочная
	|				И НЕ _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА 0
	|	КОНЕЦ КАК СуммаКраткосрочная,
	|	_ИтоговаяТаблица.Стоимость - _ИтоговаяТаблица.РезервПодОбесцение + _ИтоговаяТаблица.СтоимостьКупона - ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|				И _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА _ИтоговаяТаблица.Стоимость - _ИтоговаяТаблица.РезервПодОбесцение + _ИтоговаяТаблица.СтоимостьКупона
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|				И НЕ _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА _ИтоговаяТаблица.Стоимость - _ИтоговаяТаблица.РезервПодОбесцение
	|		КОГДА НЕ _ИтоговаяТаблица.ЦБКраткосрочная
	|				И _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА _ИтоговаяТаблица.СтоимостьКупона
	|		КОГДА НЕ _ИтоговаяТаблица.ЦБКраткосрочная
	|				И НЕ _ИтоговаяТаблица.КупонКраткосрочный
	|			ТОГДА 0
	|	КОНЕЦ КАК СуммаДолгосрочная,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.СтоимостьПокупкиСРасходамиПриПокупке
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная,
	|	_ИтоговаяТаблица.СтоимостьПокупкиСРасходамиПриПокупке - ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.СтоимостьПокупкиСРасходамиПриПокупке
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИндексацияНоминалаЗаВремяВладенияОстатокКраткосрочная,
	|	_ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияОстаток - ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИндексацияНоминалаЗаВремяВладенияОстатокДолгосрочная
	|ПОМЕСТИТЬ _Активы
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВЫБОР
	|			КОГДА БухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ДепозитныеСчета)
	|					И ЕСТЬNULL(_НастройкаДепозитБалансРСБУ.СтрокаДляДепозитныхВкладов, 1240) = 1250
	|				ТОГДА 0
	|			ИНАЧЕ БухгалтерскийУчетОстатки.СуммаОстаток
	|		КОНЕЦ) КАК Сумма
	|ПОМЕСТИТЬ _Баланс
	|ИЗ
	|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
	|			&ПериодЗапроса,
	|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Основной.ФинансовыеВложения))
	|				ИЛИ Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Основной.РезервыПодОбесценениеФинансовыхВложений))
	|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ДепозитныеСчета),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкаДепозитБалансРСБУ КАК _НастройкаДепозитБалансРСБУ
	|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПериодЗапроса", Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("Рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.Выполнить();
	
	Настройка = МВТ.Таблицы.Найти("_Настройка").ПолучитьДанные().Выгрузить();
	Активы = МВТ.Таблицы.Найти("_Активы").ПолучитьДанные().Выгрузить();
	Баланс = МВТ.Таблицы.Найти("_Баланс").ПолучитьДанные().Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("Настройка", Настройка);
	Результат.Вставить("Активы", Активы);
	Результат.Вставить("СуммаКраткосрочная", Активы.Итог("СуммаКраткосрочная"));
	Результат.Вставить("СуммаДолгосрочная", Активы.Итог("СуммаДолгосрочная"));
	Результат.Вставить("СуммаБаланс", Баланс.Итог("Сумма"));
	
	// используется во внешнем отчете "Расшифровка долгосрочных и краткосрочных вложений" (_КракосрочныеДолгосрочныеЦБ)
	// и РегламентированныйОтчетБалансРСБУ. В балансе используются только числовые показатели СуммаКраткосрочная, СуммаДолгосрочная и СуммаБаланс для проверки.   
	
	Возврат Результат;
		
КонецФункции	

// Помещает даты получения документов о смерти физ.лиц в менеджер временных таблиц
// Временная таблица содержит колонки: ФизЛицо, Дата, ДатаСмерти
//
// Параметры:
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц		- источник временных таблиц
//  Период					- Дата									- дата актуальности
//  Организация				- СправочникСсылка.Организации			- организация
//	ФизическиеЛица			- СправочникСсылка.ЮрФизЛица, Массив	- фильтр физ.лиц
//							- Структура								- описание временной таблицы с физ.лицами (ключи: ИмяТаблицы - имя временной таблицы, ПолеФизЛица - имя поля с физ.лицами)
//							- Неопределено							- без фильтра
//	ИмяВременнойТаблицы		- Строка								- имя таблицы, под которым она будет создана в менеджере
//
Процедура ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Период, Организация, ФизическиеЛица = Неопределено, ИмяВременнойТаблицы = "_ДатыПолученияДокументовОСмерти") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо КАК ФизЛицо,
		|	МИНИМУМ(РеквизитыФизическихЛицАнкетные.Период) КАК Дата,
		|	МИНИМУМ(РеквизитыФизическихЛицАнкетные.ДатаСмерти) КАК ДатаСмерти
		|ПОМЕСТИТЬ #ДатыПолученияДокументовОСмерти#
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизическихЛицАнкетные
		|ГДЕ
		|	РеквизитыФизическихЛицАнкетные.Организация = &Организация
		|	И РеквизитыФизическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|	И РеквизитыФизическихЛицАнкетные.ДатаСмерти <> ДАТАВРЕМЯ(1, 1, 1)
		|	И РеквизитыФизическихЛицАнкетные.Период <= &Период
		|	И &ФильтрФизЛиц
		|
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыФизическихЛицАнкетные.ЮрФизЛицо";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДатыПолученияДокументовОСмерти#", ИмяВременнойТаблицы); 
	
	#Область Установка_фильтра_физлиц
	
	Если ФизическиеЛица = Неопределено Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрФизЛиц", "ИСТИНА");
		
	ИначеЕсли ТипЗнч(ФизическиеЛица) = Тип("СправочникСсылка.ЮрФизЛица")
		ИЛИ ТипЗнч(ФизическиеЛица) = Тип("Массив")
	Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрФизЛиц", "ЮрФизЛицо В (&ФизическиеЛица)");
	
	ИначеЕсли ТипЗнч(ФизическиеЛица) = Тип("Структура") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрФизЛиц", СтрШаблон("ЮрФизЛицо В (ВЫБРАТЬ %1 ИЗ %2)", ФизическиеЛица.ПолеФизЛица, ФизическиеЛица.ИмяТаблицы));
		
	Иначе
		
		ВызватьИсключение СтрШаблон("Некорректный тип параметра 'ФизическиеЛица': '%1'", ТипЗнч(ФизическиеЛица));
		
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ФизическиеЛица",	ФизическиеЛица);
		
	Запрос.Выполнить();	
	
КонецПроцедуры

// Возвращает структуру с кратким и полным наименованием клиента 
// Для целевых капиталов в скобках добавляется НаименованиеЦелевогоКапитала счета доверительного управления
//
//	Параметры:
//		СчетДоверительногоУправления - счет доверительного управления
//		Период - Дата среза
Функция ПолноеИКраткоеНаименованиеКлиентаДляДокументов(СчетДоверительногоУправления, Период) Экспорт
	
	Результат = Новый Структура("КраткоеНаименование, ПолноеНаименование", "", "");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов)
		|				И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НаименованиеЦелевогоКапитала <> """"
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу + "" ("" + КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НаименованиеЦелевогоКапитала + "")""
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу
		|		ИНАЧЕ РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество, 1, 1) + ВЫБОР
		|				КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество = """"
		|					ТОГДА """"
		|				ИНАЧЕ "".""
		|			КОНЕЦ
		|	КОНЕЦ КАК КраткоеНаименование,
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
		|			ТОГДА РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов)
		|				И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НаименованиеЦелевогоКапитала <> """"
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу + "" ("" + КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НаименованиеЦелевогоКапитала + "")""
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу
		|		ИНАЧЕ РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество
		|	КОНЕЦ КАК ПолноеНаименование
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование клиента или счета ДУ из значения дополнительного сведения "ВнешниеОтчеты.КраткоеНаименованиеДляФайла"
//
//		Параметры:
//			- Субъект - ссылка на элемент справочника ЮрФизЛица, ПаевыеИнвестиционныФонды или СчетаДоверительногоУправления 
//          - ПриОтсутствииДопСведенияИспользоватьПредставлениеСсылки - Булево. Если Ложь и нет значения дополнительного сведения, функция возвращает ""
//
Функция КраткоеНаименованиеСубъектаДляИмениФайла(Субъект, ПриОтсутствииДопСведенияИспользоватьПредставлениеСсылки = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Субъект) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, ВЫБОР
		|			КОГДА &ПриОтсутствииДопСведенияИспользоватьПредставлениеСсылки
		|				ТОГДА ПРЕДСТАВЛЕНИЕ(&Субъект)
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК КраткоеНаименованиеДляФайла
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(&Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|				ТОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			ИНАЧЕ КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|		КОНЕЦ КАК Объект
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(&Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|						ТОГДА СчетДоверительногоУправления = &Субъект
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|	ГДЕ
		|		ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(&Субъект) <> ТИП(Справочник.СчетаДоверительногоУправления)
		|					ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Субъект
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ) КАК КлиентыДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО КлиентыДоверительногоУправления.Объект = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешниеОтчеты.КраткоеНаименованиеДляФайла"")";
	
	Запрос.УстановитьПараметр("Субъект", 													Субъект);
	Запрос.УстановитьПараметр("Период", 													ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПриОтсутствииДопСведенияИспользоватьПредставлениеСсылки", 	ПриОтсутствииДопСведенияИспользоватьПредставлениеСсылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КраткоеНаименованиеДляФайла;
	
КонецФункции

// Проверяет даты запрета редактирования по таблице счетов доверительного управления, переданной в менеджере временных таблиц
//
//	Параметры:
//		МенеджерВременныхТаблиц - менеджер временных таблиц
//		ДатаПроверки			- дата проверки
//		Организация 			- организация
//		ГруппаЗапрета			- группа запрета 
//		ВидУчета				- вид учета (для проверки бухгалтерских дат запрета)
//		ИмяТаблицы				- имя временной таблицы счетов доверительного управления
//		Отказ					- Булево - проверка не пройдена
//
Функция ЕстьДатыЗапретаРедактированияСчетовДоверительногоУправленияДоДатыПроверки(МенеджерВременныхТаблиц, ДатаПроверки, Организация, ГруппаЗапрета, ВидУчета = Неопределено, ИмяТаблицы = "_СчетаДоверительногоУправления") Экспорт
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы) = Неопределено Тогда
		ВызватьИсключение "В менеджере временных таблиц отсутствует таблица " + ИмяТаблицы;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ДатыЗапретаРедактирования.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = &ГруппаЗапрета
		|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования < &Период
		|	И ВЫРАЗИТЬ(_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ДатаЗаключения <= &Период
		|	И (ВЫРАЗИТЬ(_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ВЫРАЗИТЬ(_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ДатаРасторжения >= &Период)
		|	И &УсловиеНаВидУчета";

	Если ИмяТаблицы <> "_СчетаДоверительногоУправления" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_СчетаДоверительногоУправления", ИмяТаблицы); 	
	КонецЕсли;
	
	Если ГруппаЗапрета <> Перечисления.ГруппыЗапретаРедактирования.БэкОфис Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаВидУчета", "ДатыЗапретаРедактирования.ВидУчета = &ВидУчета");
		Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Иначе
		Запрос.УстановитьПараметр("УсловиеНаВидУчета", Истина);
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ГруппаЗапрета", 	ГруппаЗапрета);
	Запрос.УстановитьПараметр("Период", 		НачалоДня(ДатаПроверки));

	Отказ = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл		
		Если ГруппаЗапрета = Перечисления.ГруппыЗапретаРедактирования.БэкОфис Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("У счета ДУ '%1' дата запрета редактирования %2 по группе '%3' ранее отчетной даты %4", Выборка.СчетДоверительногоУправления, Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"), ГруппаЗапрета, Формат(ДатаПроверки, "ДФ=dd.MM.yyyy")), Выборка.СчетДоверительногоУправления,,, Отказ);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("У счета ДУ '%1' дата запрета редактирования %2 по группе '%3' вида учета '%4' ранее отчетной даты %5", Выборка.СчетДоверительногоУправления, Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"), ГруппаЗапрета, ВидУчета, Формат(ДатаПроверки, "ДФ=dd.MM.yyyy")), Выборка.СчетДоверительногоУправления,,, Отказ);
		КонецЕсли;
	КонецЦикла;                  	
	
	Возврат Отказ;
	
КонецФункции

// Получает таблицу значений с данными для расчета минимальной достаточности
//	
//	Параметры:
//		- Организация - организация
//		- ДатаРасчета - дата получения данных
//
Функция ДанныеДляРасчетаМинимальнойДостаточности(Организация, ДатаРасчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
	ВидыДоговоровУчитываемыеПоСЧА = Новый Массив;
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
	ВидыДоговоровУчитываемыеПоСЧА.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	
	Запрос.УстановитьПараметр("ВидыДоговоровУчитываемыеПоСЧА", 	ВидыДоговоровУчитываемыеПоСЧА);
	Запрос.УстановитьПараметр("ДатаОтчета", 					КонецДня(ДатаРасчета));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", 			Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ДатаРасчета));
	Запрос.УстановитьПараметр("Организация", 					Организация);
	
	// Поместим счета ДУ, учитываемые по РСБУ, во временную таблицу _Клиенты
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&ДатаОтчета, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО (НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И НЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровУчитываемыеПоСЧА, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОтчета)
		| 	И ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) 
		|	И СчетаДоверительногоУправления.ДатаЗаключения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОтчета";

	Запрос.Выполнить();
	
	// Балансовую стоимость по РСБУ получаем из баз расчета
	ДатыПериода = Новый Структура("НачалоПериода, КонецПериода", ДатаРасчета, КонецДня(ДатаРасчета));
	Отказ = Ложь;
	ДобавитьДанныеПоБазеРасчетаВЗапрос(Запрос,  ДатыПериода, "_СчетаДоверительногоУправления", "_РСАНаКонецБалансРСБУ", Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Поместим счета ДУ во временную таблицу _Клиенты
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	НЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОтчета)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОтчета";
		
	Запрос.Выполнить();
		
	// Балансовую стоимость по ЕПС получаем из баз расчета
	ДобавитьДанныеПоБазеРасчетаВЗапрос(Запрос, ДатыПериода, "_Клиенты", "_РСАНаКонецБаланс", Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
#Область ТекстЗапроса	

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ЕСТЬNULL(ФинансовыеПоказателиСЧА.Значение, 0) КАК СЧА,
		|	ЕСТЬNULL(ФинансовыеПоказателиРСА.Значение, 0) КАК РСА,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет, ЛОЖЬ)
		|			ТОГДА ЕСТЬNULL(БалансоваяСтоимость.Сумма, 0)
		|		ИНАЧЕ ЕСТЬNULL(БалансоваяСтоимостьРСБУ.Сумма, 0)
		|	КОНЕЦ КАК Баланс,
		|	- КредиторскаяЗадолженность.Сумма КАК КредиторскаяЗадолженность,
		|	ЛОЖЬ КАК УчтенВОтчете
		|ИЗ
		|	_Клиенты КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ФинансовыеПоказатели.СубъектАналитики КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ)) КАК Дата
		|		ИЗ
		|			РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ГДЕ
		|			ФинансовыеПоказатели.Активность
		|			И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|			И ФинансовыеПоказатели.Период МЕЖДУ &ПоследнийРабочийДень И &ДатаОтчета
		|			И ФинансовыеПоказатели.Организация = &Организация
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ФинансовыеПоказатели.СубъектАналитики) КАК ДатыПоследнихСЧА
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ДатыПоследнихСЧА.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиСЧА
		|		ПО (ФинансовыеПоказателиСЧА.СубъектАналитики = СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|			И (ФинансовыеПоказателиСЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ДатыПоследнихСЧА.Дата = ФинансовыеПоказателиСЧА.Период)
		|			И (ФинансовыеПоказателиСЧА.Активность)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиРСА
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ФинансовыеПоказателиРСА.СубъектАналитики
		|			И (ФинансовыеПоказателиРСА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов))
		|			И (ДатыПоследнихСЧА.Дата = ФинансовыеПоказателиРСА.Период)
		|			И (ФинансовыеПоказателиРСА.Активность)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОтчета, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&ДатаОтчета, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО (НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РСАНаКонецБаланс КАК БалансоваяСтоимость
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = БалансоваяСтоимость.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РСАНаКонецБалансРСБУ КАК БалансоваяСтоимостьРСБУ
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = БалансоваяСтоимостьРСБУ.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|			СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК Сумма
		|		ИЗ
		|			РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ГДЕ
		|			СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность
		|			И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|			И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период МЕЖДУ &ПоследнийРабочийДень И &ДатаОтчета
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период,
		|			СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления) КАК КредиторскаяЗадолженность
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = КредиторскаяЗадолженность.СчетДоверительногоУправления
		|			И (ДатыПоследнихСЧА.Дата = КредиторскаяЗадолженность.Период)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидДоговораДоверительногоУправления,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";
	
#КонецОбласти	

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТабличныйДокументВHTML(Результат) Экспорт
	
	ИмяВременногоФайла = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + ".html";
	
	Результат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяВременногоФайла);
	
	ТекстПисьма = ТелоПисьма.ПолучитьТекст();
	
	УдалитьФайлы(ИмяВременногоФайла);

	Возврат ТекстПисьма;
	
КонецФункции

// Формирует отчёт в формате HTML на основании массива элементов: заголовок, параметры, таблицы значений
//	
//	Параметры:
//		- ЭлементыОтчета - Массив - Массив структур
Функция СформироватьОтчетВHTML(ЭлементыОтчета) Экспорт
	
#Область Тело
	Тело = 
		"<html>
		|	<head>
		|		<style type=""text/css"">
		|        body {
		|			font: 10pt sans-serif;
		|			color: black
		|        }
		|        .title {
		|			margin-bottom: 15px;
		|			font-size: 20px;
		|			font-weight: 600
		|        }
		|        .parametr {
		|			font-size: 15px;
		|        }
		|        table {
		|			margin-top: 15px;
		|			text-align: left;
		|			border-spacing: 0;
		|			border-collapse: collapse;
		|        }
		|        td {
		|			font-size: 10pt;
		|			border: 1px solid black;
		|			padding: 5px 20px 5px 20px;
		|			
		|        }
		|        caption{
		|			text-align: left;
		|			padding: 5px 20px 5px 20px
		|        }
		|        .top {
		|            font-size: 10pt;
		|            border: 1px solid black;
		|            padding: 5px 20px 5px 20px;
		|			font-weight: 600
		|        }
		|		</style>
		|	</head>
		|	<body></body>
		|</html>";
#КонецОбласти	

	ЭлементыТела = Новый Массив;
	
	Для Каждого ЭлементОтчета Из ЭлементыОтчета Цикл
		Если ЭлементОтчета.Тип = "Заголовок" Тогда
			ЭлементыТела.Добавить("<p Class = ""title""> " + ЭлементОтчета.Значение + "</p>");		
			
		ИначеЕсли ЭлементОтчета.Тип = "Параметр" Тогда
			ЭлементыТела.Добавить("<p Class = ""parametr"">" + ЭлементОтчета.Имя + ": " + ЭлементОтчета.Значение + "</p>");		

		ИначеЕсли ЭлементОтчета.Тип = "ТаблицаЗначений" Тогда
			
			ЭлементыТела.Добавить("<table>");		
			ЭлементыТела.Добавить("<caption>" + ЭлементОтчета.Заголовок + "</caption>");		
			
#Область ЗаголовкиТаблицы
			ЭлементыТела.Добавить("	<tr Class=""top"">");		
			
			Если ЭлементОтчета.Свойство("Колонки") Тогда
				Для Каждого Колонка Из ЭлементОтчета.Колонки Цикл
					ЭлементыТела.Добавить("		<td>" + Колонка.Заголовок + "</td>");		
				КонецЦикла;
			Иначе
				Для Каждого Колонка Из ЭлементОтчета.Значение.Колонки Цикл
					Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
						ЭлементыТела.Добавить("		<td>" + Колонка.Заголовок + "</td>");		
					Иначе
						ЭлементыТела.Добавить("		<td>" + Колонка.Имя + "</td>");		
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ЭлементыТела.Добавить("	</tr>");		
#КонецОбласти			

#Область СтрокиТаблицы
			Для Каждого СтрокаТаблицы Из ЭлементОтчета.Значение Цикл
				ЭлементыТела.Добавить("	<tr>");		
				
				Если ЭлементОтчета.Свойство("Колонки") Тогда
					Для Каждого Колонка Из ЭлементОтчета.Колонки Цикл
						Если Колонка.Свойство("Формат") Тогда
							ЭлементыТела.Добавить("		<td>" + Формат(СтрокаТаблицы[Колонка.Имя], Колонка.Формат) + "</td>");		
						Иначе
							ЭлементыТела.Добавить("		<td>" + СтрокаТаблицы[Колонка.Имя] + "</td>");		
						КонецЕсли;
					КонецЦикла;
				Иначе
					Для Каждого Колонка Из ЭлементОтчета.Значение.Колонки Цикл
						ЭлементыТела.Добавить("		<td>" + СтрокаТаблицы[Колонка.Имя] + "</td>");		
					КонецЦикла;
				КонецЕсли;
			
				ЭлементыТела.Добавить("	</tr>");		
			КонецЦикла;
#КонецОбласти			
			
		КонецЕсли;
	КонецЦикла;
	
	ЭлементыТела.Добавить("</body>");

	Тело = СтрЗаменить(Тело, "</body>", СтрСоединить(ЭлементыТела, Символы.ПС + Символы.Таб));

	Возврат Тело;
	
КонецФункции

// Обрабатывает параметры схемы компоновки для отключения их доступности в полях отбора и добавляет в схему компоновки параметры данных из компоновщика
// Добавление в схему компоновки параметров данных из компоновщика может понадобиться в случае, если схема компоновки была создана программно без добавления параметров
//
//	Параметры:
//		СхемаКомпоновки 	- схема компоновки данных
//		КомпоновщикНастроек	- компоновщик настроек компоновки данных (инициализированный)
Процедура ОбработатьПараметрыСхемыКомпоновкиИДобавитьПараметрыИзКомпоновщика(СхемаКомпоновки, КомпоновщикНастроек = Неопределено) Экспорт
	
	Для Каждого Параметр Из СхемаКомпоновки.Параметры Цикл
		Параметр.ВключатьВДоступныеПоля = Ложь;	
	КонецЦикла;	
	
	Если Не КомпоновщикНастроек = Неопределено Тогда
		Для Каждого ПараметрДанных Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл 
			Если СхемаКомпоновки.Параметры.Найти(Параметр) = Неопределено Тогда
				НовыйПараметр = СхемаКомпоновки.Параметры.Добавить();
				НовыйПараметр.Имя                    = Строка(ПараметрДанных.Параметр);
				НовыйПараметр.ВключатьВДоступныеПоля = Ложь;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

// Формирует HTML-отчёт о расхождениях по таблице с колонками ВариантРасхождения, ключевыми полями и полями _Тек_<Имя>, _Нов_<Имя>.
// Используется при сверке данных (например, котировок, реестров).
//
// Параметры:
//  Расхождения - Структура: ЕстьРасхождения, Таблица, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена
//  КлючевыеПоля - Массив строк — имена ключевых колонок таблицы
//  СравниваемыеПоля - Массив строк — имена сравниваемых полей (в таблице — колонки _Тек_<Имя>, _Нов_<Имя>)
//  ТипыВариантовРасхождений - Структура с ключами НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена (числа 0,1,2,3). Необязательно.
//  СкрыватьНовыеЗаписи - Булево. Не выводить в отчёт строки с вариантом "НоваяЗапись". Необязательно, по умолчанию Ложь.
//
// Возвращаемое значение: Строка — HTML-фрагмент таблицы расхождений.
//
Функция ПодготовитьОтчетОРасхождениях(Расхождения, КлючевыеПоля, СравниваемыеПоля, ТипыВариантовРасхождений = Неопределено, СкрыватьНовыеЗаписи = Ложь, ДетализированныйВид = Ложь) Экспорт
	
	Если ТипыВариантовРасхождений = Неопределено Тогда
		ТипыВариантовРасхождений = Новый Структура("НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена", 0, 1, 2, 3);
	КонецЕсли;
	НетРасхождений = ТипыВариантовРасхождений.НетРасхождений;
	НоваяЗапись = ТипыВариантовРасхождений.НоваяЗапись;
	ЗаписьУдалена = ТипыВариантовРасхождений.ЗаписьУдалена;
	ЗаписьИзменена = ТипыВариантовРасхождений.ЗаписьИзменена;

	МассивОтчетаHTML = Новый Массив;

	Если Не Расхождения.ЕстьРасхождения Тогда
		МассивОтчетаHTML.Добавить("<h3 style=""color: green"">Нет расхождений</h3>");
	Иначе
		МассивОтчетаHTML.Добавить("<h3>Новых: " + Расхождения.НоваяЗапись + ", удалено: " + Расхождения.ЗаписьУдалена + ", изменено: " + Расхождения.ЗаписьИзменена + "</h3>");
	КонецЕсли;

	МассивОтчетаHTML.Добавить("<table class=""compare_records"">");
	Расхождения.Таблица.Сортировать("ВариантРасхождения УБЫВ");

	Для Каждого СтрокаРасхождения Из Расхождения.Таблица Цикл
		Если СтрокаРасхождения.ВариантРасхождения = НоваяЗапись И СкрыватьНовыеЗаписи Тогда
			Продолжить;
		КонецЕсли;

		МассивОтчетаHTML.Добавить("<tr>");
		
		Если СтрокаРасхождения.ВариантРасхождения = НоваяЗапись Тогда
			ВариантРасхождения = "НОВ";
		ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьУдалена Тогда
			ВариантРасхождения = "УДЛ";
		ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьИзменена Тогда
			ВариантРасхождения = "ИЗМ";
		Иначе
			ВариантРасхождения = "";
		КонецЕсли;

		МассивОтчетаHTML.Добавить("<td class=""col-flag"">" + ВариантРасхождения + "</td>");

		Для Каждого Поле Из КлючевыеПоля Цикл
			Если Поле = "ТипЛица" Тогда
				МассивОтчетаHTML.Добавить("<td class=""col-type"">" + СтрокаРасхождения[Поле] + "</td>");
			Иначе
				МассивОтчетаHTML.Добавить("<td class=""col-name"">" + СтрокаРасхождения[Поле] + "</td>");
			КонецЕсли;
		КонецЦикла;

		Если ДетализированныйВид Тогда
			ПодготовитьДетализированноеПредставление(МассивОтчетаHTML, СтрокаРасхождения, СравниваемыеПоля, СтрокаРасхождения.ВариантРасхождения, НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена);
		Иначе
			КолСравниваемыхПолейВЯчейке = 5;
			Для НомПоля = 1 По СравниваемыеПоля.Количество() Цикл
				Если (НомПоля - 1) % КолСравниваемыхПолейВЯчейке = 0 Тогда
					МассивОтчетаHTML.Добавить("<td>");
				Иначе
					МассивОтчетаHTML.Добавить("<br>");
				КонецЕсли;

				Поле = СравниваемыеПоля[НомПоля - 1];

				Если СтрокаРасхождения.ВариантРасхождения = НетРасхождений Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = НоваяЗапись Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Нов_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьУдалена Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьИзменена Тогда
					Если СтрокаРасхождения["_Тек_" + Поле] = СтрокаРасхождения["_Нов_" + Поле] Тогда
						МассивОтчетаHTML.Добавить("<div class=""eq_values"">" + Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]</div>");
					Иначе
						МассивОтчетаHTML.Добавить("<div class=""nq_values"">" + Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "] -> ["
							+ СтрокаРасхождения["_Нов_" + Поле] + "]</div>");
					КонецЕсли;
				КонецЕсли;

				Если НомПоля % КолСравниваемыхПолейВЯчейке = 0 Тогда
					МассивОтчетаHTML.Добавить("</td>");
				КонецЕсли;
			КонецЦикла;

			Если (СравниваемыеПоля.Количество() - 1) % КолСравниваемыхПолейВЯчейке > 0 Тогда
				МассивОтчетаHTML.Добавить("</td>");
			КонецЕсли;
		КонецЕсли;

		МассивОтчетаHTML.Добавить("</tr>");
	КонецЦикла;

	МассивОтчетаHTML.Добавить("</table>");

	Возврат СтрСоединить(МассивОтчетаHTML, "");

КонецФункции

Процедура ПодготовитьДетализированноеПредставление(МассивОтчетаHTML, СтрокаРасхождения, СравниваемыеПоля, ВариантРасхождения, НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена)
    
    МассивОтчетаHTML.Добавить("<td><ul class=""rec_list"">");
    
    Для Каждого Поле Из СравниваемыеПоля Цикл
        
        ТекЗнач = Строка(СтрокаРасхождения["_Тек_" + Поле]);
        НовЗнач = Строка(СтрокаРасхождения["_Нов_" + Поле]);
        
        Если (ТекЗнач = "" И НовЗнач = "") И ВариантРасхождения <> НоваяЗапись И ВариантРасхождения <> ЗаписьУдалена Тогда
            Продолжить;
        КонецЕсли;
        
        НазваниеПоля = Поле;
        Если НазваниеПоля = "Паспорт" Тогда НазваниеПоля = "Паспорт"; КонецЕсли;
        Если НазваниеПоля = "Наименование" Тогда НазваниеПоля = "Наименование"; КонецЕсли;
        Если НазваниеПоля = "ИНН" Тогда НазваниеПоля = "ИНН"; КонецЕсли;
        Если НазваниеПоля = "ОГРН" Тогда НазваниеПоля = "ОГРН"; КонецЕсли;
        Если НазваниеПоля = "Адрес" Тогда НазваниеПоля = "Адрес"; КонецЕсли;
        Если НазваниеПоля = "РасчетныйСчет" Тогда НазваниеПоля = "Расчётный счёт"; КонецЕсли;
        Если НазваниеПоля = "ДатаГосРегистрации" Тогда НазваниеПоля = "Дата регистрации/выдачи"; КонецЕсли;
        Если НазваниеПоля = "ОрганГосРегистрации" Тогда НазваниеПоля = "Орган регистрации/выдачи"; КонецЕсли;
        
        Если ВариантРасхождения = НоваяЗапись Тогда      
            Элемент = "<li><span class=""rec_label"">" + НазваниеПоля + ":</span> " + НовЗнач + "</li>";
        ИначеЕсли ВариантРасхождения = ЗаписьУдалена Тогда 
            Элемент = "<li><span class=""rec_label"">" + НазваниеПоля + ":</span> " + ТекЗнач + "</li>";
        ИначеЕсли ВариантРасхождения = ЗаписьИзменена Тогда 
            Если ТекЗнач = НовЗнач Тогда
                Элемент = "<li><span class=""rec_label"">" + НазваниеПоля + ":</span> <span class=""eq_values"">" + ТекЗнач + "</span></li>";
            Иначе
                Элемент = "<li><span class=""rec_label"">" + НазваниеПоля + "</span><ul class=""sub_list"">"
                    + "<li><span class=""arrow-right"">&rarr;</span> " + ТекЗнач + "</li>"
                    + "<li><span class=""arrow-left"">&larr;</span> " + НовЗнач + "</li></ul></li>";
            КонецЕсли;
        КонецЕсли;
        
        МассивОтчетаHTML.Добавить(Элемент);
    КонецЦикла;
    
    МассивОтчетаHTML.Добавить("</ul></td>");
    
КонецПроцедуры