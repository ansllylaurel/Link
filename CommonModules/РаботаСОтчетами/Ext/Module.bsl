Функция ПолучитьШапкуОфициальногоБланкаОрганизации(Организация, Дата, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	
