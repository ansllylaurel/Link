Функция УстановитьПараметрСеансаТекущаяОрганизация(Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыСеанса.ТекущаяОрганизация = Организация;
	
КонецФункции // УстановитьПараметрСеансаТекущаяОрганизация

Процедура УстановитьПараметрСеансаКонтрольДоступаКСчетамДоверительногоУправления(КонтрольДоступа) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыСеанса.КонтрольДоступаКСчетамДоверительногоУправления = КонтрольДоступа;
	
КонецПроцедуры

Процедура УстановитьПараметрСеансаДоступныВсеСчетаДоверительногоУправления(КонтрольДоступа) Экспорт
	
	Если НЕ КонтрольДоступа Тогда
		ПараметрыСеанса.ДоступныВсеСчетаДоверительногоУправления = Истина;
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",	ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Пользователь",	ПараметрыСеанса.ТекущийПользователь);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И НЕ СчетаДоверительногоУправления.Ссылка В
		|				(ВЫБРАТЬ
		|					ДоступныеСчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|				ИЗ
		|					РегистрСведений.ДоступныеСчетаДоверительногоУправления КАК ДоступныеСчетаДоверительногоУправления
		|				ГДЕ
		|					ДоступныеСчетаДоверительногоУправления.Организация = &Организация
		|					И ДоступныеСчетаДоверительногоУправления.Пользователь = &Пользователь)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПараметрыСеанса.ДоступныВсеСчетаДоверительногоУправления = Ложь;
	Иначе
		ПараметрыСеанса.ДоступныВсеСчетаДоверительногоУправления = Истина;
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроверкаНаНаличиеФункциональнойРоли(ФункциональнаяРоль, Отказ) Экспорт
	
	// проверим возможность выбора юр. лица в данной функциональной роли
	Если Не МонопольныйРежим() Тогда
		БлокировкаДанных = Новый БлокировкаДанных;
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник." + ФункциональнаяРоль.Метаданные().Имя);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		БлокировкаДанных.Заблокировать();
	КонецЕсли;
	
	ОписаниеПричины = "";
	
	Если Не Справочники.ЮрФизЛица.ФункциональнаяРольДоступна(ФункциональнаяРоль, ОписаниеПричины) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеПричины, ФункциональнаяРоль, "ЮрФизЛицо",, Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьЮрФизЛицоСчетаДоверительногоУправления(СчетДоверительногоУправления, Период) Экспорт
	                                                                         
	Если Не ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		Возврат Справочники.ЮрФизЛица.ПустаяСсылка();
	КонецЕсли;
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	Если      ТипЗнч(Клиент) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Возврат Клиент;
	ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		Возврат Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(Период, Клиент);
	КонецЕсли;
	
	Возврат Справочники.ЮрФизЛица.ПустаяСсылка();
	
КонецФункции // ПолучитьЮрФизЛицоСчетаДоверительногоУправления

Функция ПолучитьЮрФизЛицоКлиента(Клиент, Период = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Справочники.ЮрФизЛица.ПустаяСсылка();
	КонецЕсли;
	
	Если      ТипЗнч(Клиент) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Возврат Клиент;
	ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		Возврат Клиент;
	ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Возврат ПолучитьЮрФизЛицоСчетаДоверительногоУправления(Клиент, Период);
	КонецЕсли;
	
	Возврат Справочники.ЮрФизЛица.ПустаяСсылка();
	
КонецФункции // ПолучитьЮрФизЛицоКлиента

Процедура ВывестиРеквизитыЮрФизЛица(ЮрФизЛицо, Форма, ИмяГруппыВладельца, ИспользоватьАнкетныеДанные = Ложь, КонтактныеЛица = Ложь, КонтактнаяИнформация = Ложь, КвалифицированныеИнвесторы = Ложь, Организация = Неопределено) Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
	ИменаГруппДанных = Новый Структура("ПИФ, ЮрЛицо, ФизЛицо",
	"ДанныеКлиентаПИФа", "ДанныеКлиентаЮрЛица", "ДанныеКлиентаФизЛица");
	
	ТипЮрФизЛица = ТипЗнч(ЮрФизЛицо);
	
	// определим набор имен реквизитов (имена элементов формы будут идентичными),
	// которые потребуются для отображения сведений о юр. или  физ. лице или ПИФ-е
	ОписаниеНовыхРеквизитов = Новый Массив();
	
	Если      ТипЮрФизЛица = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		ОписаниеНовыхРеквизитов.Добавить(
			Новый Структура("Имя, Синоним, Тип",
				"ТипПИФа", "Тип", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыПифовВЗависимостиОтЛиквидности")));
		
		ОписаниеНовыхРеквизитов.Добавить(
			Новый Структура("Имя, Синоним, Тип",
				"КатегорияПИФа", "Категория", Новый ОписаниеТипов("ПеречислениеСсылка.КатегорииПИФовВЗависимостиОтОбъектаИнвестирования")));
		
		ОписаниеНовыхРеквизитов.Добавить(
			Новый Структура("Имя,Синоним,Тип",
				"ПравилаПИФа", "Правила", Новый ОписаниеТипов("Строка")));
		
		Для каждого РесурсРегистра Из Метаданные.РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.Ресурсы Цикл
			ОписаниеНовыхРеквизитов.Добавить(
				Новый Структура("Имя, Синоним, Тип",
					"ПИФ" + РесурсРегистра.Имя, РесурсРегистра.Синоним, РесурсРегистра.Тип));
		КонецЦикла;
		
		ИмяГруппыДанных = ИменаГруппДанных.ПИФ;
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Если      ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			ИмяГруппыДанных        = ИменаГруппДанных.ЮрЛицо;
			ИмяРегистра            = "РеквизитыЮридическихЛиц" + ?(ИспользоватьАнкетныеДанные, "Анкетные","");
			ПрефиксИмениРеквизитов = "ЮрЛицо";
		ИначеЕсли ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			ИмяГруппыДанных        = ИменаГруппДанных.ФизЛицо;
			ИмяРегистра            = "РеквизитыФизическихЛицАнкетные";
			ПрефиксИмениРеквизитов = "ФизЛицо";
			
			ОписаниеНовыхРеквизитов.Добавить(
				Новый Структура("Имя,Синоним,Тип",
					"ФизЛицоДатаПолученияДокументовОСмерти", "Дата получения документов", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата))));
			
		Иначе
			Возврат;			
		КонецЕсли;
		
		Для каждого РесурсРегистра Из Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы Цикл
			ОписаниеНовыхРеквизитов.Добавить(
				Новый Структура("Имя, Синоним, Тип",
					ПрефиксИмениРеквизитов + РесурсРегистра.Имя, РесурсРегистра.Синоним, РесурсРегистра.Тип));
		КонецЦикла;
		
	Иначе
		Возврат;
		
	КонецЕсли;
	
	// проверим, была ли создана группа, содержащая реквизиты юр./физ. лица или ПИФ-а
	// и создадим её при отсутствии
	ТолькоОбновлениеДанных = Истина;
	
	ГруппаРеквизитов = Форма.Элементы.Найти(ИмяГруппыДанных);
	Если ГруппаРеквизитов = Неопределено Тогда
		ГруппаРеквизитов = Форма.Элементы.Добавить(ИмяГруппыДанных, Тип("ГруппаФормы"), Форма.Элементы[ИмяГруппыВладельца]);
		// Только просмотр настраиваем отдельно для каждой подчиненной страницы
		ГруппаРеквизитов.ТолькоПросмотр = Ложь;
		ГруппаРеквизитов.Вид            = ВидГруппыФормы.Страницы;
		
		ТолькоОбновлениеДанных = Ложь;
	КонецЕсли;
	
	// настроим видимость групп
	Для каждого КлючЗнч Из ИменаГруппДанных Цикл
		ГруппаФормы = Форма.Элементы.Найти(КлючЗнч.Значение);
		Если ГруппаФормы <> Неопределено Тогда
			ГруппаФормы.Видимость = (КлючЗнч.Значение = ИмяГруппыДанных);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ТолькоОбновлениеДанных Тогда
		// создадим реквизиты
		ДобавляемыеРеквизиты = Новый Массив();
		
		Для каждого ОписаниеРеквизита Из ОписаниеНовыхРеквизитов Цикл
			НовыйРеквизит = Новый РеквизитФормы(ОписаниеРеквизита.Имя, ОписаниеРеквизита.Тип,, ОписаниеРеквизита.Синоним, Ложь);
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		КонецЦикла;
		
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		// Сначала выводим недоступные для редактирования страницы
		ТолькоПросмотр = Истина;
		// создадим элементы формы (автоматизация минимальна)
		Если      ИмяГруппыДанных = ИменаГруппДанных.ПИФ Тогда
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ПИФОсновныеДанные", "ПИФ", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			СоздатьПодчиненныеПоляФормы("ТипПИФа, КатегорияПИФа, ПравилаПИФа", Форма, СтраницаГруппыРеквизитов);
			
			// Теперь доступные для редактирования страницы
			ТолькоПросмотр = Ложь;
			
			// контактные лица
			Если КонтактныеЛица Тогда
				СоздатьДинамическийСписокКонтактныхЛиц("ПИФКонтактныеЛица", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			КонецЕсли;
			
			СоздатьДинамическийСписокУсловий("ПИФУсловияПравилПаевогоИнвестиционногоФонда", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			СоздатьДинамическийСписокДополненийПравилПИФ("ПИФДополненияПравилПаевогоИнвестиционногоФонда", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
						
		ИначеЕсли ИмяГруппыДанных = ИменаГруппДанных.ЮрЛицо Тогда
			// Основные
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ЮрЛицоОсновныеДанные", "Основные", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			// Группа "Наименования"
			ГруппаНаименованияЮрЛица = Форма.Элементы.Добавить("ГруппаНаименованияЮрЛица", Тип("ГруппаФормы"), СтраницаГруппыРеквизитов);
			ГруппаНаименованияЮрЛица.Вид       = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаНаименованияЮрЛица.Заголовок = "Наименования";
			
			СоздатьПодчиненныеПоляФормы("ЮрЛицоСокращенноеНаименование/Сокращенное, ЮрЛицоПолноеНаименованиеПоУставу/Полное по уставу, ЮрЛицоКраткоеНаименованиеПоУставу/Краткое по уставу", Форма, ГруппаНаименованияЮрЛица);
			
			// коды
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ЮрЛицоКоды", "Коды", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			// Группа "ИНН, КПП"
			ГруппаИННиКПП = СоздатьГоризонтальнуюГруппуЭлементов("ЮрЛицоИННиКПП", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ЮрЛицоИНН, ЮрЛицоКПП", Форма, ГруппаИННиКПП);
			
			// Прочие подчиненные поля страницы
			СоздатьПодчиненныеПоляФормы("ЮрЛицоКодПоОКПО, ЮрЛицоКодПоОКВЭД, ЮрЛицоКодПоОКТМО", Форма, СтраницаГруппыРеквизитов);
			
			// документы
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ЮрЛицоДокументы", "Документы", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			// Группа "ОГРН"
			ГруппаОГРН = Форма.Элементы.Добавить("ЮрЛицоСведенияОбОГРН", Тип("ГруппаФормы"), СтраницаГруппыРеквизитов);
			ГруппаОГРН.Вид       = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаОГРН.Заголовок = "ОГРН";
			
			// Группа "Номер и дата ОГРН"
			ГруппаНомерДатаОГРН = СоздатьГоризонтальнуюГруппуЭлементов("ЮрЛицоНомерДатаОГРН", Форма, ГруппаОГРН);
			СоздатьПодчиненныеПоляФормы("ЮрЛицоОГРН/Номер, ЮрЛицоДатаВыдачиОГРН/Дата выдачи", Форма, ГруппаНомерДатаОГРН);
			
			// Прочие подчиненные элементы группы "ОГРН"
			СоздатьПодчиненныеПоляФормы("ЮрЛицоОрганВыдавшийОГРН/Выдан", Форма, ГруппаОГРН);
			
			// контактная информация
			Если КонтактнаяИнформация Тогда
				Если ИспользоватьАнкетныеДанные Тогда
					ЗаполнитьКонтактнуюИнформациюИзАнкет(Организация, "ЮрЛицоКонтактнаяИнформация", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
				Иначе
					СоздатьДинамическийСписокКонтактнойИнформации("ЮрЛицоКонтактнаяИнформация", Форма, ГруппаРеквизитов, ЮрФизЛицо, , ТолькоПросмотр);
					Форма.Элементы.ЮрЛицоКонтактнаяИнформацияЗначенияПолей.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			// Теперь доступные для редактирования страницы
			ТолькоПросмотр = Ложь;

			// контактные лица
			Если КонтактныеЛица Тогда
				СоздатьДинамическийСписокКонтактныхЛиц("ЮрЛицоКонтактныеЛица", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			КонецЕсли;
						
			Если КвалифицированныеИнвесторы Тогда
				СоздатьДинамическийСписокКвалифицированныеИнвесторы("ЮрЛицоКвалифицированныеИнвесторы", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			КонецЕсли;	
			
		ИначеЕсли ИмяГруппыДанных = ИменаГруппДанных.ФизЛицо Тогда
			// основные данные
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ЮрЛицоОсновныеДанные", "Основные", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			СоздатьПодчиненныеПоляФормы("ФизЛицоФамилия", Форма, СтраницаГруппыРеквизитов);
			
			// Группа "Имя и Отчество"
			ГруппаИмяИОтчество = СоздатьГоризонтальнуюГруппуЭлементов("ФизЛицоИмяИОтчество", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ФизЛицоИмя, ФизЛицоОтчество", Форма, ГруппаИмяИОтчество);
			
			// "Пол"	
			СоздатьПодчиненныеПоляФормы("ФизЛицоПол", Форма, СтраницаГруппыРеквизитов);
			
			// Группа "Дата рождения, Дата смерти и дата получения документов о смерти"	
			ГруппаДатаСмертиИДатаПолученияДокументовОСмерти = СоздатьГоризонтальнуюГруппуЭлементов("ФизЛицоДатаСмертиИДатаПолученияДокументовОСмерти", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ФизЛицоДатаРождения, ФизЛицоДатаСмерти",	Форма, ГруппаДатаСмертиИДатаПолученияДокументовОСмерти);
			СоздатьПодчиненныеПоляФормы("ФизЛицоДатаПолученияДокументовОСмерти",	Форма, ГруппаДатаСмертиИДатаПолученияДокументовОСмерти, ВидПоляФормы.ПолеНадписи);
			
			// Прочие подчиненные элементы страницы
			СоздатьПодчиненныеПоляФормы("ФизЛицоИНН", Форма, СтраницаГруппыРеквизитов);
			
			//Гражданство
			НовыйЭлемент = Форма.Элементы.Добавить("ФизЛицоРезидентРФ", Тип("ПолеФормы"), СтраницаГруппыРеквизитов);
			НовыйЭлемент.ПутьКДанным		= "ФизЛицоРезидентРФ";
			НовыйЭлемент.Вид         		= ВидПоляФормы.ПолеФлажка;
			НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
			
			// Группа "Гражданство и Второе гражданство"	
			ГруппаГражданствоИВтороеГражданство = СоздатьГоризонтальнуюГруппуЭлементов("ФизЛицоГражданствоИВтороеГражданство", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ФизЛицоГражданство, ФизЛицоВтороеГражданство", Форма, ГруппаГражданствоИВтороеГражданство);
			
			// документы
			СтраницаГруппыРеквизитов = СоздатьСтраницу("ФизЛицоДокументы", "Документы", Форма, ГруппаРеквизитов, ТолькоПросмотр);
			
			// Группа "Удостоверение личности"
			ГруппаУдостоверениеЛичности = Форма.Элементы.Добавить("ГруппаНаименованияЮрЛица", Тип("ГруппаФормы"), СтраницаГруппыРеквизитов);
			ГруппаУдостоверениеЛичности.Вид       = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаУдостоверениеЛичности.Заголовок = "Удостоверение личности";
			
			СоздатьПодчиненныеПоляФормы("ФизЛицоВидУдостоверенияЛичности/Документ", Форма, СтраницаГруппыРеквизитов);
			
			// Серия и номер
			ГруппНомерИСерияУдостоверенияЛичности = СоздатьГоризонтальнуюГруппуЭлементов("ФизЛицоНомерИСерияУдостоверенияЛичности", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ФизЛицоСерияУдостоверенияЛичности/Серия, ФизЛицоНомерУдостоверенияЛичности/Номер", Форма, ГруппНомерИСерияУдостоверенияЛичности);
			
			СоздатьПодчиненныеПоляФормы("ФизЛицоОрганВыдавшийУдостоверениеЛичности/Выдан", Форма, СтраницаГруппыРеквизитов);
			
			ГруппаДатаВыдачиКодОрганаУдостоверенияЛичности = СоздатьГоризонтальнуюГруппуЭлементов("ФизЛицоДатаВыдачиКодОрганаУдостоверенияЛичности", Форма, СтраницаГруппыРеквизитов);
			СоздатьПодчиненныеПоляФормы("ФизЛицоДатаВыдачиУдостоверенияЛичности/Дата выдачи, ФизЛицоКодОрганаВыдавшегоУдостоверениеЛичности/Код подразделения", Форма, ГруппаДатаВыдачиКодОрганаУдостоверенияЛичности);
			
			// контактные лица
			Если КонтактнаяИнформация Тогда
				Если ИспользоватьАнкетныеДанные Тогда
					ЗаполнитьКонтактнуюИнформациюИзАнкет(Организация, "ЮрЛицоКонтактнаяИнформация", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
				Иначе
					СоздатьДинамическийСписокКонтактнойИнформации("ЮрЛицоКонтактнаяИнформация", Форма, ГруппаРеквизитов, ЮрФизЛицо,, ТолькоПросмотр);
					Форма.Элементы.ЮрЛицоКонтактнаяИнформацияЗначенияПолей.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			// Теперь доступные для редактирования страницы
			ТолькоПросмотр = Ложь;

			// контактные лица
			Если КонтактныеЛица Тогда
				СоздатьДинамическийСписокКонтактныхЛиц("ФизЛицоКонтактныеЛица", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			КонецЕсли;
						
			Если КвалифицированныеИнвесторы Тогда
				СоздатьДинамическийСписокКвалифицированныеИнвесторы("ЮрЛицоКвалифицированныеИнвесторы", Форма, ГруппаРеквизитов, ЮрФизЛицо, ТолькоПросмотр);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	// заполнение общих созданных реквизитов данными
	ЗаполнитьДанныеОЮрФизЛице(Организация, ЮрФизЛицо, Форма, ИспользоватьАнкетныеДанные);
	
	НастроитьВидимостьРеквизитов(Форма);
	
КонецПроцедуры // ВывестиРеквизитыФизЮрЛица

Функция ПолучитьЮрФизЛицаБанкроты(Период) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДефолтыПоОблигациям.Облигация.Эмитент.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&Период, ТипДефолта В (ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации), ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство))) КАК ДефолтыПоОблигациям
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ДефолтыПоОблигациям.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|				ТОГДА ДефолтыПоОблигациям.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	Справочник.Эмитенты КАК Эмитенты
		|ГДЕ
		|	Эмитенты.ДатаБанкротства <> ДАТАВРЕМЯ(1, 1, 1)");
	
	Запрос.УстановитьПараметр("Период", Период);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЮрФизЛицо");	
КонецФункции

