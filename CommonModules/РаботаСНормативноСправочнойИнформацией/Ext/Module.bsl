Процедура ЗаполнитьКонтактнуюИнформациюИзАнкет(Организация, Имя, Форма, ГруппаВладелец, ЮрФизЛицо, ТолькоПросмотр = Истина)
		
	// Для анкетных данных список полей известен заранее	
	
	ВидыКонтактнойИнформации = Новый Структура;
	ВидыКонтактнойИнформации.Вставить("EMail", "E-mail");
	ВидыКонтактнойИнформации.Вставить("Телефоны", "Телефоны");
	ВидыКонтактнойИнформации.Вставить("ПочтовыйАдрес", "Почтовый адрес");
	
	Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		ВидыКонтактнойИнформации.Вставить("АдресРегистрации", "Адрес регистрации");
		ВидыКонтактнойИнформации.Вставить("АдресМестаЖительства", "Адрес места жительства");
	ИначеЕсли ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		ВидыКонтактнойИнформации.Вставить("ЮридическийАдрес", "Юридический адрес");
		ВидыКонтактнойИнформации.Вставить("ФактическийАдрес", "Фактический адрес");
	КонецЕсли;
	
	// Добавляем реквизиты
	
	ДобавляемыеРеквизиты = Новый Массив();	
	
	Для Каждого ВидКИ Из ВидыКонтактнойИнформации Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Имя + ВидКИ.Ключ, Новый ОписаниеТипов("Строка"), , ВидКИ.Значение, Ложь));	
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
	// Заполняем данными
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СписокПолей
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = &Язык) КАК РеквизитыАнкетныеСрезПоследних
		|");
	Запрос.УстановитьПараметр("Период",			ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",		ЮрФизЛицо);        
	Запрос.УстановитьПараметр("Язык",			Справочники.Языки.Русский);
	
	Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеквизитыФизическихЛицАнкетные", "РеквизитыЮридическихЛицАнкетные");
	КонецЕсли;
	
	СписокПолейСтрокой = "";
	Для Каждого ВидКИ Из ВидыКонтактнойИнформации Цикл
		СписокПолейСтрокой = СписокПолейСтрокой + ВидКИ.Ключ + ", ";	
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СписокПолей", Лев(СписокПолейСтрокой, СтрДлина(СписокПолейСтрокой) - 2));
	
	КонтактнаяИнформация = Запрос.Выполнить().Выбрать();
	Если КонтактнаяИнформация.Следующий() Тогда
		Для Каждого ВидКИ Из ВидыКонтактнойИнформации Цикл
			Форма[Имя + ВидКИ.Ключ] = КонтактнаяИнформация[ВидКИ.Ключ];	
		КонецЦикла;
	КонецЕсли;
	
	// Добавляем элементы 
	
	Страница = СоздатьСтраницу("Группа" + Имя, "Контактная информация", Форма, ГруппаВладелец, ТолькоПросмотр);
	
	Для Каждого ВидКИ Из ВидыКонтактнойИнформации Цикл
		НовыйЭлемент = Форма.Элементы.Добавить(Имя + ВидКИ.Ключ, Тип("ПолеФормы"), Страница);
		НовыйЭлемент.ПутьКДанным			= Имя + ВидКИ.Ключ;
		НовыйЭлемент.Вид					= ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок				= ВидКИ.Значение;
		НовыйЭлемент.АвтоМаксимальнаяШирина	= Ложь;
	КонецЦикла;

КонецПроцедуры

Процедура НастроитьВидимостьРеквизитов(Форма)
	
	Если Форма.Элементы.Найти("ФизЛицоДатаСмерти") <> Неопределено Тогда
		Форма.Элементы.ФизЛицоДатаСмерти.Видимость						= ЗначениеЗаполнено(Форма.ФизЛицоДатаСмерти);
		Форма.Элементы.ФизЛицоДатаПолученияДокументовОСмерти.Видимость	= ЗначениеЗаполнено(Форма.ФизЛицоДатаСмерти);
	КонецЕсли;
	
КонецПроцедуры
