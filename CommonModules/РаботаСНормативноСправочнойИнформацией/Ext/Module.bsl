Функция ЭтоУникальныйДоговор(Договор) Экспорт
	
	// уникальность каждого из 3-х видов договоров контролируется по номеру и дате в рамках
	// организации, которая его заключила, и 2-й стороной (банком, брокером или депозитарием)
	
	ТипДоговора = ТипЗнч(Договор);
	
	Если ТипДоговора = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") Или ТипДоговора = Тип("СправочникОбъект.ДоговорыБрокерскогоОбслуживания") Тогда
		ИмяСправочника            = "ДоговорыБрокерскогоОбслуживания";
		ИмяРеквизитаВторойСтороны = "Контрагент";
		
	ИначеЕсли ТипДоговора = Тип("СправочникСсылка.Договоры") Или ТипДоговора = Тип("СправочникОбъект.Договоры") Тогда
		ИмяСправочника            = "Договоры";
		ИмяРеквизитаВторойСтороны = "Контрагент";	
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.Контрагент = &Контрагент
		|	И Договоры.НомерДоговора = &НомерДоговора
		|	И Договоры.ДатаЗаключения = &ДатаЗаключения
		|	И &ОтборПоВидуДоговора
		|	И Договоры.Ссылка <> &Ссылка
		|	И НЕ Договоры.ПометкаУдаления";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Договоры", "Справочник." + ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагент", ИмяРеквизитаВторойСтороны);
	
	Если ИмяСправочника <> "Договоры" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидуДоговора", "ИСТИНА");
		
	Иначе
		Если Договор.ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Тогда
			// по доп. соглашениям уникальность нумерации контролируется в разрезе основания
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидуДоговора", "Договоры.ВидДоговора = &ВидДоговора И Договоры.Основание = &Основание");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидуДоговора", "Договоры.ВидДоговора = &ВидДоговора");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Основание",   Договор.Основание);
		Запрос.УстановитьПараметр("ВидДоговора", Договор.ВидДоговора);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",    Договор.Организация);
	Запрос.УстановитьПараметр("НомерДоговора",  Договор.НомерДоговора);
	Запрос.УстановитьПараметр("ДатаЗаключения", Договор.ДатаЗаключения);
	Запрос.УстановитьПараметр("Ссылка",         Договор.Ссылка);
	
	Запрос.УстановитьПараметр(ИмяРеквизитаВторойСтороны, Договор[ИмяРеквизитаВторойСтороны]);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции // ПроверитьУникальностьДоговора

Функция ПолучитьДатуЗакрытияСчетаПоДоговору(Счет) Экспорт
	
	Если ЗначениеЗаполнено(Счет) Тогда
		Возврат Справочники.Договоры.ПолучитьДатуРасторженияДоговора(Счет.Договор);
	КонецЕсли;
	
	Возврат Дата(1, 1, 1);
	
КонецФункции // ПолучитьДатуЗакрытияСчетаПоДоговору

Функция ПолучитьГоловнуюОрганизацию(ЮридическоеЛицо, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",				?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Запрос.УстановитьПараметр("ЮридическоеЛицо",	ЮридическоеЛицо);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК РодительскоеЮридическоеЛицо
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Период,
		|			ЮридическоеЛицо = &ЮридическоеЛицо
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РодительскоеЮридическоеЛицо;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьГлавуХолдинга(ЮридическоеЛицо, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",				?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Запрос.УстановитьПараметр("ЮридическоеЛицо",	ЮридическоеЛицо);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК РодительскоеЮридическоеЛицо
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Период,
		|			ЮридическоеЛицо = &ЮридическоеЛицо
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ВходитВГруппуКомпаний)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РодительскоеЮридическоеЛицо;
	Иначе
		Возврат ЮридическоеЛицо;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьРеквизитыДоговора(Договор, Реквизиты, Период = Неопределено) Экспорт
	
	ЗначенияРеквизитов = Новый Структура(Реквизиты);

	Если Не ЗначениеЗаполнено(Договор) Тогда
		//заполнения реквизитов пустыми значениями требуется, чтобы при пустом договоре, в месте вызова исключить ошибки на операции сравнения <>, сравнения на булево и обращения к реквизитам через точку.
		//поэтому перечисления и строки можно не указывать.
		ЗначенияРеквизитовПриОтсутствииДоговора = Новый Структура;
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("ОтветственноеХранение", Ложь);
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("Контрагент"			, Справочники.ЮрФизЛица.ПустаяСсылка());
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("ДатаЗаключения"		, Дата(1,1,1));
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("ДатаРасторжения"		, Дата(1,1,1));
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("СрокОплаты"			, 0);
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("Депозитарий"			, Справочники.ДепозитарныеКомпании.ПустаяСсылка());
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("Брокер"				, Справочники.БрокерскиеКомпании.ПустаяСсылка());
		ЗначенияРеквизитовПриОтсутствииДоговора.Вставить("ВидДоговораАренды"	, Перечисления.ВидыДоговоровАренды.ПустаяСсылка());
		
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЗначенияРеквизитовПриОтсутствииДоговора);
		
		Возврат ЗначенияРеквизитов;
	КонецЕсли;
	
	Если Период = Неопределено Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДоговорыБрокерскогоОбслуживания.Контрагент КАК Контрагент,
			|	ДоговорыБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговора,
			|	ДоговорыБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаЗаключения,
			|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ДатаРасторжения,
			|	УсловияДоговоровОбщиеСрезПоследних.СрокОплаты КАК СрокОплаты,
			|	УсловияДоговоровОбщиеСрезПоследних.ВариантДлиныСрока КАК ВариантДлиныСрока,
			|	БрокерскиеКомпании.Ссылка КАК Брокер
			|ИЗ
			|	Справочник.ДоговорыБрокерскогоОбслуживания КАК ДоговорыБрокерскогоОбслуживания
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
			|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ДоговорыБрокерскогоОбслуживания.Ссылка)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
			|		ПО ДоговорыБрокерскогоОбслуживания.Контрагент = БрокерскиеКомпании.ЮрФизЛицо
			|ГДЕ
			|	ДоговорыБрокерскогоОбслуживания.Ссылка = &Договор";
		
	Иначе
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Договоры.ВидДоговора КАК ВидДоговора,
			|	Договоры.Контрагент КАК Контрагент,
			|	Договоры.НомерДоговора КАК НомерДоговора,
			|	Договоры.ДатаЗаключения КАК ДатаЗаключения,
			|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ДатаРасторжения,
			|	УсловияДоговоровОбщиеСрезПоследних.СрокОплаты КАК СрокОплаты,
			|	УсловияДоговоровОбщиеСрезПоследних.ВариантДлиныСрока КАК ВариантДлиныСрока,
			|	Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ОтветственногоХранения)
			|		ИЛИ Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания) КАК ОтветственноеХранение
			|ИЗ
			|	Справочник.Договоры КАК Договоры
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
			|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Договоры.Ссылка)
			|ГДЕ
			|	Договоры.Ссылка = &Договор";
	
	
		Если ЗначенияРеквизитов.Свойство("Депозитарий") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеКомпании КАК ДепозитарныеКомпании
				|		ПО Договоры.Контрагент = ДепозитарныеКомпании.ЮрФизЛицо
				|ГДЕ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ", 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ДепозитарныеКомпании.Ссылка КАК Депозитарий,");
		КонецЕсли;
	
		Если ЗначенияРеквизитов.Свойство("Брокер") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
				|		ПО Договоры.Контрагент = БрокерскиеКомпании.ЮрФизЛицо
				|ГДЕ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ", 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	БрокерскиеКомпании.Ссылка КАК Брокер,");
		КонецЕсли;
		
		Если ЗначенияРеквизитов.Свойство("ВидДоговораАренды") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровАренды.СрезПоследних(&Период, ) КАК УсловияДоговоровАрендыСрезПоследних
				|		ПО (УсловияДоговоровАрендыСрезПоследних.Договор = Договоры.Ссылка)
				|ГДЕ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ", 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	УсловияДоговоровАрендыСрезПоследних.ВидДоговораАренды КАК ВидДоговораАренды,");
		КонецЕсли;
		
		Если ЗначенияРеквизитов.Свойство("ПродолжениеГенСоглашения") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийПродолжениеГенСоглашения
				|		ПО Договоры.Ссылка = ЗначенияДополнительныхСведенийПродолжениеГенСоглашения.Значение
				|			И (ЗначенияДополнительныхСведенийПродолжениеГенСоглашения.Свойство.Ключ = ""ПредыдущееГенСоглашение"")
				|ГДЕ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ", 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ЕСТЬNULL(ЗначенияДополнительныхСведенийПродолжениеГенСоглашения.Объект, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК ПродолжениеГенСоглашения,");
		КонецЕсли;
		
		Если ЗначенияРеквизитов.Свойство("ПредыдущееГенСоглашение") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийПредыдущееГенСоглашение
				|		ПО Договоры.Ссылка = ЗначенияДополнительныхСведенийПредыдущееГенСоглашение.Объект
				|			И (ЗначенияДополнительныхСведенийПредыдущееГенСоглашение.Свойство.Ключ = ""ПредыдущееГенСоглашение"")
				|ГДЕ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ", 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	ЕСТЬNULL(ЗначенияДополнительныхСведенийПредыдущееГенСоглашение.Значение, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК ПредыдущееГенСоглашение,");
		КонецЕсли;
		
		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Договор"	, Договор);
	Запрос.УстановитьПараметр("Период"	, Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Выборка);
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

Функция ПолучитьЮрФизЛицаОрганизации(Организация, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",			?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Период,
		|			ЮридическоеЛицо В
		|					(ВЫБРАТЬ
		|						Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|					ИЗ
		|						Справочник.Организации КАК Организации
		|					ГДЕ
		|						Организации.Ссылка = &Организация)
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЮрФизЛицо");
	
КонецФункции

// Проверяет, что контрагент указан выгодоприобретателем в анкете физ. лица, действующей на дату
//
//		Параметры:
//			- Организация	- Организация
//			- Клиент 		- Юр./физ. лицо
//			- Контрагент 	- Юр./физ. лицо
//			- Дата			- Дата проверки
//
Функция КонтрагентЯвляетсяВыгодоприобретателемКлиентаФизическогоЛица(Организация, Клиент, Контрагент, Дата) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &Клиент
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаФизическогоЛицаПредставителиВыгодоприобретатели
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.Ссылка
		|			И (АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо = &Контрагент)
		|			И (АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ВидУчастника = ЗНАЧЕНИЕ(Перечисление.ВидыУчастниковАнкет.Выгодоприобретатель))
		|ГДЕ
		|	НЕ АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо ЕСТЬ NULL");
	
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("Клиент", 		Клиент);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент); 	
	
	ЭтоВыгодоприобретатель = Не Запрос.Выполнить().Пустой();
	
	Если Не ЭтоВыгодоприобретатель Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Контрагент '%1' не является выгодоприобретателем клиента '%2'", Контрагент, Клиент));	
	КонецЕсли;
	
	Возврат ЭтоВыгодоприобретатель;
	
КонецФункции

// Получает таблицу юридических лиц депозитариев, спец. депозитариев, брокеров, банков для действующих счетов доверительного управления
// 	
//	Параметры:
// 		- Дата - дата среза
//
Функция ЮридическиеЛицаИспользуемыеДействующимиСчетамДоверительногоУправления(Дата) Экспорт 
	
	// Необходимо получить все счета ДУ, поэтому в привилегированном режиме
	УстановитьПривилегированныйРежим(Истина);
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, Дата, Новый Структура("Организация", МассивОрганизаций), "_СчетаДоверительногоУправления");
	
	Запрос.УстановитьПараметр("Дата", 	Дата);
	Запрос.УстановитьПараметр("ПустаяДата", 	'00010101');
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВложенныйЗапрос.Организация КАК Организация
		|ИЗ
		|	(ВЫБРАТЬ
		|		СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо КАК ЮрФизЛицо,
		|		СчетаДоверительногоУправления.Организация КАК Организация
		|	ИЗ
		|		Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|	ГДЕ
		|		СчетаДоверительногоУправления.Ссылка В
		|				(ВЫБРАТЬ
		|					_СчетаДоверительногоУправления.Ссылка
		|				ИЗ
		|					_СчетаДоверительногоУправления)
		|		И СчетаДоверительногоУправления.СпециализированныйДепозитарий <> ЗНАЧЕНИЕ(Справочник.ДепозитарныеКомпании.)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИсполнителиПоДенежнымСредствамБрокерские.Брокер.ЮрФизЛицо,
		|		ИсполнителиПоДенежнымСредствамБрокерские.Организация
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|	ГДЕ
		|		ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаДоверительногоУправления.Ссылка
		|				ИЗ
		|					_СчетаДоверительногоУправления)
		|		И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = &ПустаяДата
		|				ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия > &Дата)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.ЮрФизЛицо,
		|		ИсполнителиПоДенежнымСредствамСобственные.Организация
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|	ГДЕ
		|		ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаДоверительногоУправления.Ссылка
		|				ИЗ
		|					_СчетаДоверительногоУправления)
		|		И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = &ПустаяДата
		|				ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &Дата)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо,
		|		ИсполнителиПоЦеннымБумагам.Организация
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|	ГДЕ
		|		ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаДоверительногоУправления.Ссылка
		|				ИЗ
		|					_СчетаДоверительногоУправления)
		|		И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = &ПустаяДата
		|				ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &Дата)) КАК ВложенныйЗапрос";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат; 
	
КонецФункции

// Возвращает реквизиты головной организации
//
// Параметры
//	Организация						- СправочникСсылка.Организации	- Организация для которой необходимо получить реквизиты головной организации
//	Дата							- Дата							- Дата реквизитов
//	Реквизиты						- Строка						- Список реквизитов через запятую
//
// Возвращаемое значение:
//  Структура - реквизиты головной организации
//
Функция ПолучитьРеквизитыГоловнойОрганизации(Организация, Дата, Реквизиты) Экспорт
	
	ИсключаемыеГоловныеОрганизации = Новый Массив;
	ИсключаемыеГоловныеОрганизации.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Траст")); //#ТехДолг Кривоносов
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес КАК ЮридическийАдрес,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК EMail,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК ВебСтраница
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&Дата,
		|				ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|					И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&Дата,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|			ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = ЮрФизЛица.Ссылка)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	Результат = Запрос.Выполнить();
	РеквизитыОрганизации = Новый Структура(Реквизиты);
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, Выборка);
	Иначе
		ВызватьИсключение "Ошибка вычисления реквизитов организации";
		
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции	


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ФУНКЦИИ

Процедура ЗаполнитьДанныеОЮрФизЛице(Организация, ЮрФизЛицо, Форма, ИспользоватьАнкетныеДанные = Ложь)

	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		Форма["ТипПИФа"]       = ЮрФизЛицо.Тип;
		Форма["КатегорияПИФа"] = ЮрФизЛицо.Категория;
		
		НомерПравилПИФа = ЮрФизЛицо.НомерПравил;
		ДатаПравилПИФа  = ЮрФизЛицо.ДатаПравил;
		
		Если ПустаяСтрока(НомерПравилПИФа) и Не ЗначениеЗаполнено(ДатаПравилПИФа) Тогда
			Форма["ПравилаПИФа"] = "не заданы";
		Иначе
			Форма["ПравилаПИФа"] = ?(Не ПустаяСтрока(НомерПравилПИФа), "№ " + НомерПравилПИФа, "");
			
			Если ЗначениеЗаполнено(ДатаПравилПИФа) Тогда
				Форма["ПравилаПИФа"] = Форма["ПравилаПИФа"] + ?(ПустаяСтрока(Форма["ПравилаПИФа"]), "", " от ") + Формат(ДатаПравилПИФа, "ДФ=dd.MM.yyyy")+?(ПустаяСтрока(ЮрФизЛицо.ОрганВыдавшийЛицензию), "", ", выданы ") + ЮрФизЛицо.ОрганВыдавшийЛицензию;
			КонецЕсли;
		КонецЕсли;
		
		НаДату = ТекущаяДата();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ИЗ
			|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(
			|			&Период,
			|			ПаевойИнвестиционныйФонд = &ЮрФизЛицо) КАК РеквизитыСрезПоследних
			|";
		
		Запрос.УстановитьПараметр("Период",        НаДату);
		Запрос.УстановитьПараметр("ЮрФизЛицо",     ЮрФизЛицо);
			
		Выборка = Запрос.Выполнить().Выгрузить();
		
		// удалим из выборки те колонки, которые не являются ресурсами регистра сведений
		Для Инд = 1 - Выборка.Колонки.Количество() По 0 Цикл
			Если Метаданные.РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.Ресурсы.Найти(Выборка.Колонки[-Инд].Имя) = Неопределено Тогда
				Выборка.Колонки.Удалить(-Инд);
			КонецЕсли;
		КонецЦикла;
		
		Если Выборка.Количество() = 1 Тогда
			ЗнчРеквизитов = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Выборка[0]);
		Иначе
			ЗнчРеквизитов = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Выборка.Добавить());
		КонецЕсли;
		
		Для каждого КлючИЗначение Из ЗнчРеквизитов Цикл
			Форма["ПИФ" + КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЦикла;

	Иначе	
		Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			ИмяРегистраСРеквизитами = "РеквизитыФизическихЛиц";
			Если НЕ ИспользоватьАнкетныеДанные Тогда
				ВызватьИсключение "У физических лиц присутствуют только анкетные реквизиты.";
			КонецЕсли;
		Иначе
			ИмяРегистраСРеквизитами = "РеквизитыЮридическихЛиц";
		КонецЕсли;
		
		Если ИспользоватьАнкетныеДанные Тогда
			ИмяРегистраСРеквизитами = ИмяРегистраСРеквизитами + "Анкетные";
		КонецЕсли;
		
		ПрефиксИмениРеквизитов  = ?(ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо, "ФизЛицо", "ЮрЛицо");
		
		НаДату = ТекущаяДата();
		
		Запрос = Новый Запрос;
		
		Если ИспользоватьАнкетныеДанные Тогда
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	*
				|ИЗ
				|	РегистрСведений." + ИмяРегистраСРеквизитами + ".СрезПоследних(
				|			&Период,
				|			ЮрФизЛицо = &ЮрФизЛицо
				|				И Организация = &Организация
				|				И Язык = &Язык) КАК РеквизитыСрезПоследних
				|";
			Запрос.УстановитьПараметр("Организация", Организация);
		Иначе
			Запрос.Текст =
			    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	*
				|ИЗ
				|	РегистрСведений." + ИмяРегистраСРеквизитами + ".СрезПоследних(
				|			&Период,
				|			ЮрФизЛицо = &ЮрФизЛицо
				|				И Подразделение = &Подразделение
				|				И Язык = &Язык) КАК РеквизитыСрезПоследних
				|";
			Запрос.УстановитьПараметр("Подразделение", Справочники.Подразделения.ГруппаКомпаний);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Язык",		Справочники.Языки.Русский);
		Запрос.УстановитьПараметр("Период",		НаДату);
		Запрос.УстановитьПараметр("ЮрФизЛицо",	ЮрФизЛицо);
			
		Выборка = Запрос.Выполнить().Выгрузить();
		
		// удалим из выборки те колонки, которые не являются ресурсами регистра сведений
		Для Инд = 1 - Выборка.Колонки.Количество() По 0 Цикл
			Если Метаданные.РегистрыСведений[ИмяРегистраСРеквизитами].Ресурсы.Найти(Выборка.Колонки[-Инд].Имя) = Неопределено Тогда
				Выборка.Колонки.Удалить(-Инд);
			КонецЕсли;
		КонецЦикла;
		
		// Если известна дата смерти, заполним ДатаПолученияДокументовОСмерти - это дата первой анкеты с заполненной датой смерти 
		
		Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо 
			И ИспользоватьАнкетныеДанные 
			И Выборка.Количество() > 0
			И ЗначениеЗаполнено(Выборка[0].ДатаСмерти)
		Тогда
			
			РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(Запрос, НаДату, Организация, ЮрФизЛицо, "_ДатыПолученияДокументовОСмерти");
			
			ВыборкаДатаСмерти = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ДатыПолученияДокументовОСмерти").Выбрать();
			Если ВыборкаДатаСмерти.Следующий() Тогда
				Выборка.Колонки.Добавить("ДатаПолученияДокументовОСмерти", Новый ОписаниеТипов("Дата"));
				Выборка[0].ДатаПолученияДокументовОСмерти = ВыборкаДатаСмерти.Дата;
			КонецЕсли;
			
		КонецЕсли;
		
		// Если это юридическое лицо и не используются анкетные данные,
		// то данные по ОГРН получаем из регистра "ДокументыЮридическихЛиц".
		Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо
			И НЕ ИспользоватьАнкетныеДанные Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Период",		НаДату);
			Запрос.УстановитьПараметр("ЮрФизЛицо",	ЮрФизЛицо);
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН,
				|	ДокументыЮридическихЛицСрезПоследних.Период КАК ДатаВыдачиОГРН,
				|	ДокументыЮридическихЛицСрезПоследних.КемВыдан КАК ОрганВыдавшийОГРН
				|ИЗ
				|	РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
				|			&Период,
				|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
				|				И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)
				|				И ЮрФизЛицо = &ЮрФизЛицо) КАК ДокументыЮридическихЛицСрезПоследних
				|ГДЕ
				|	(ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
				|			ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)";
			
			ОГРН = Запрос.Выполнить().Выбрать();
			
			Если ОГРН.Следующий() Тогда
				НомерОГРН			= ОГРН.ОГРН;
				ДатаВыдачиОГРН		= ОГРН.ДатаВыдачиОГРН;
				ОрганВыдавшийОГРН	= ОГРН.ОрганВыдавшийОГРН;
			Иначе
				НомерОГРН			= Неопределено;
				ДатаВыдачиОГРН		= Неопределено;
				ОрганВыдавшийОГРН	= Неопределено;
			КонецЕсли;
			
			// Если колонок для данных по ОГРН нет, добавлем новые и заполняем.
			Если Выборка.Колонки.Найти("ОГРН") = Неопределено Тогда
				Выборка.Колонки.Добавить("ОГРН",				Новый ОписаниеТипов("Строка"));
				Выборка.Колонки.Добавить("ДатаВыдачиОГРН",		Новый ОписаниеТипов("Дата"));
				Выборка.Колонки.Добавить("ОрганВыдавшийОГРН",	Новый ОписаниеТипов("Строка"));
			КонецЕсли;
			
			// Данных о юр. лице может и не быть.
			Если Выборка.Количество() = 0 Тогда
				Выборка.Добавить();
			КонецЕсли;
			
			// Устанавливаем значения.
			Выборка[0].ОГРН					= НомерОГРН;
			Выборка[0].ДатаВыдачиОГРН		= ДатаВыдачиОГРН;
			Выборка[0].ОрганВыдавшийОГРН	= ОрганВыдавшийОГРН;
			
		КонецЕсли;
		
		Если Выборка.Количество() = 1 Тогда
			ЗнчРеквизитов = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Выборка[0]);
		Иначе
			ЗнчРеквизитов = РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(Выборка.Добавить());
		КонецЕсли;
		
		РеквизитыФормы = Новый Структура;
		Для каждого КлючИЗначение Из ЗнчРеквизитов Цикл
			РеквизитыФормы.Вставить(ПрефиксИмениРеквизитов + КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(Форма, РеквизитыФормы);
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьДанныеОЮрФизЛице

Процедура СоздатьПодчиненныеПоляФормы(ОписанияПолей, Форма, ГруппаВладелец, ВидПоля = Неопределено)

	Если ВидПоля = Неопределено Тогда
		ВидПоля = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	
	ОписанияПолей = СтрЗаменить(ОписанияПолей, ",", Символы.ПС);
	
	Для НомСтр = 1 По СтрЧислоСтрок(ОписанияПолей) Цикл
		ОписаниеПоля = СокрЛП(СтрПолучитьСтроку(ОписанияПолей, НомСтр));
		
		ПозРазделителяИмениИЗаголовка = Найти(ОписаниеПоля, "/");
		Если ПозРазделителяИмениИЗаголовка > 0 Тогда
			ИмяПоля   = СокрЛП(Лев(ОписаниеПоля, ПозРазделителяИмениИЗаголовка - 1));
			Заголовок = СокрЛП(Сред(ОписаниеПоля, ПозРазделителяИмениИЗаголовка + 1));
		Иначе
			ИмяПоля   = ОписаниеПоля;
			Заголовок = "";
		КонецЕсли;
		
		НовыйЭлемент = Форма.Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), ГруппаВладелец);
		НовыйЭлемент.ПутьКДанным = ИмяПоля;
		НовыйЭлемент.Вид         = ВидПоля;
		НовыйЭлемент.Заголовок   = Заголовок;
	КонецЦикла;
	
КонецПроцедуры // СоздатьПодчиненныеПоляФормы

Функция СоздатьГоризонтальнуюГруппуЭлементов(ИмяГруппы, Форма, ГруппаВладелец)
	
	НоваяГруппа = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаВладелец);
	НоваяГруппа.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение         = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	
	Возврат НоваяГруппа
	
КонецФункции // СоздатьГоризонтальнуюГруппуЭлементов

Функция СоздатьСтраницу(ИмяГруппы, Заголовок, Форма, ГруппаСтраницы, ТолькоПросмотр = Ложь)
	
	Страница = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаСтраницы);
	Страница.Вид       		= ВидГруппыФормы.Страница;
	Страница.Заголовок 		= Заголовок;
	Страница.ТолькоПросмотр	= ТолькоПросмотр;
	
	Возврат Страница;
	
КонецФункции // СоздатьСтраницу

Процедура СоздатьДинамическийСписокУсловий(Имя, Форма, ГруппаВладелец, ЮрФизЛицо, ТолькоПросмотр = Ложь)
	
	// нас будут интересовать все измерения, ресурсы и реквизиты данного списка
	ОписаниеПолейУсловий = РаботаСМетаданнымиПовтИсп.ПолучитьОписаниеПолейРегистра("РегистрыСведений", "УсловияПравилПаевогоИнвестиционногоФонда");
	
	// все таблицы контактных лиц на форме будут связаны с одним динамическим списком
	ДобавляемыеРеквизиты = Новый Массив();
	
	ДинамическийСписок = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("ДинамическийСписок"),, "Условия ПИФ", Ложь);
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Форма[Имя].ОсновнаяТаблица = "РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда";
	
	// создадим на форме соответствующие элементы
	Страница = СоздатьСтраницу("Группа" + Имя, "Условия ПИФ", Форма, ГруппаВладелец, ТолькоПросмотр);
	
	ТаблицаДинамическогоСписка = Форма.Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Страница);
	ТаблицаДинамическогоСписка.ПутьКДанным           = Имя;
	ТаблицаДинамическогоСписка.ВысотаВСтрокахТаблицы = 5;
	
	    // подчиненные поля-колонки
		Для каждого ОписаниеПоля Из ОписаниеПолейУсловий Цикл
			Если ОписаниеПоля.Имя <> "Объект" Тогда
				НовыйЭлемент = Форма.Элементы.Добавить(Имя + ОписаниеПоля.Имя, Тип("ПолеФормы"), ТаблицаДинамическогоСписка);
				НовыйЭлемент.ПутьКДанным = Имя + "." + ОписаниеПоля.Имя;
				НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.Заголовок   = ОписаниеПоля.Синоним;
				
				// длинные строки на общем фоне смотрятся не красиво
				Если Строка(ОписаниеПоля.Тип) = "Строка" Тогда
					Если ОписаниеПоля.Тип.КвалификаторыСтроки.Длина > 25 Тогда
						НовыйЭлемент.Ширина = 25;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Список = Форма[Имя].Отбор;
	
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(Список, "ПаевойИнвестиционныйФонд",, ВидСравненияКомпоновкиДанных.Равно, ЮрФизЛицо,
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	// Теперь эта гиперссылка не требуется	
	// ссылка, которая открывает сведения о клиенте на закладке "Контактные лица"
	//НовыйЭлемент = Форма.Элементы.Добавить(Имя + "Изменить", Тип("ДекорацияФормы"), Страница);
	//НовыйЭлемент.Вид         = ВидДекорацииФормы.Надпись;
	//НовыйЭлемент.Заголовок   = "Изменить";
	//НовыйЭлемент.Гиперссылка = Истина;
	//НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_УсловияИзменитьНажатие");
	
КонецПроцедуры // СоздатьДинамическийСписокУсловий

Процедура СоздатьДинамическийСписокДополненийПравилПИФ(Имя, Форма, ГруппаВладелец, ЮрФизЛицо, ТолькоПросмотр = Ложь)
	
	// нас будут интересовать все измерения, ресурсы и реквизиты данного списка
	ОписаниеПолейДополнений = Новый Массив;
	ОписаниеПолейДополнений.Добавить(Новый Структура("Имя, Тип, Синоним", "Наименование"	, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(Метаданные.Справочники.Договоры.ДлинаНаименования)), "Наименование"));
	ОписаниеПолейДополнений.Добавить(Новый Структура("Имя, Тип, Синоним", "НомерДоговора"	, Метаданные.Справочники.Договоры.Реквизиты.НомерДоговора.Тип, "Номер договора"));
	ОписаниеПолейДополнений.Добавить(Новый Структура("Имя, Тип, Синоним", "ДатаЗаключения"	, Метаданные.Справочники.Договоры.Реквизиты.ДатаЗаключения.Тип, "Дата заключения"));
	
	// все таблицы контактных лиц на форме будут связаны с одним динамическим списком
	ДобавляемыеРеквизиты = Новый Массив();
	
	ДинамическийСписок = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("ДинамическийСписок"),, "Дополнения правил", Ложь);
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Форма[Имя].ОсновнаяТаблица = "Справочник.Договоры";
	
	// создадим на форме соответствующие элементы
	Страница = СоздатьСтраницу("Группа" + Имя, "Дополнения правил", Форма, ГруппаВладелец, ТолькоПросмотр);
	
	ТаблицаДинамическогоСписка = Форма.Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Страница);
	ТаблицаДинамическогоСписка.ПутьКДанным           = Имя;
	ТаблицаДинамическогоСписка.ВысотаВСтрокахТаблицы = 5;
	
    // подчиненные поля-колонки
	Для каждого ОписаниеПоля Из ОписаниеПолейДополнений Цикл
		НовыйЭлемент = Форма.Элементы.Добавить(Имя + ОписаниеПоля.Имя, Тип("ПолеФормы"), ТаблицаДинамическогоСписка);
		НовыйЭлемент.ПутьКДанным = Имя + "." + ОписаниеПоля.Имя;
		НовыйЭлемент.Вид         = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок   = ОписаниеПоля.Синоним;
		
		// длинные строки на общем фоне смотрятся не красиво
		Если Строка(ОписаниеПоля.Тип) = "Строка" Тогда
			Если ОписаниеПоля.Тип.КвалификаторыСтроки.Длина > 25 Тогда
				НовыйЭлемент.Ширина = 25;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	Список = Форма[Имя].Отбор;
	
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(Список, "Основание",, ВидСравненияКомпоновкиДанных.Равно, ЮрФизЛицо,
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	РаботаСНастройкамиСписковКлиентСервер.ДобавитьЭлементОтбора(Список, "ВидДоговора",, ВидСравненияКомпоновкиДанных.Равно, ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДополнениеПравил"),
		Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	// ссылка, которая открывает сведения о клиенте на закладке "Контактные лица"
	//НовыйЭлемент = Форма.Элементы.Добавить(Имя + "Изменить", Тип("ДекорацияФормы"), Страница);
	//НовыйЭлемент.Вид         = ВидДекорацииФормы.Надпись;
	//НовыйЭлемент.Заголовок   = "Изменить";
	//НовыйЭлемент.Гиперссылка = Истина;
	//НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_УсловияИзменитьНажатие");
	
КонецПроцедуры // СоздатьДинамическийСписокДополненийПравилПИФ

