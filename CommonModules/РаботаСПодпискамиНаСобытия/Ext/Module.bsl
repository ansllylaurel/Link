Процедура ПроверкаЗапретаРедактированияУчетныхРегистров(Источник, Отказ, Замещение) Экспорт  

	Если Источник.ДополнительныеСвойства.Свойство("УдалениеВСоставеИзмененияНабора") И Источник.ДополнительныеСвойства.УдалениеВСоставеИзмененияНабора Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ЗаписьВСоставеРасчетаПартий") И Источник.ДополнительныеСвойства.ЗаписьВСоставеРасчетаПартий Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И Источник.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПроверкиЗапретаРедактирования = Неопределено;
	
	РегистрМД			= Источник.Метаданные();
	ПолноеИмяРегистра	= РегистрМД.ПолноеИмя();

	ЕстьОтборПоРегистратору = Источник.Отбор.Найти("Регистратор") <> Неопределено;	
	Если ЕстьОтборПоРегистратору Тогда
		Регистратор = Источник.Отбор.Регистратор.Значение;
	Иначе
		Регистратор = Неопределено;
	КонецЕсли;    
	
	// Отбор ставим либо по счету д/у из измерения, либо из реквизита регистратора.
	// Если ни там, ни там нет, то для регистра с движениями по клиенту получаем связанные с ним счета д/у.
	// Если счета д/у определить не удалось, то проверять не по кому
	
	Если РегистрМД.Измерения.Найти("СчетДоверительногоУправления") <> Неопределено Тогда	
		
		СчетаДоверительногоУправления = "Регистр.СчетДоверительногоУправления";
		
		Если РегистрМД.Имя = "ВводыВыводыАктивовВВалютеУчета" Тогда
			
			#Область Таблица_проверки_запрета_редактирования_для_регистра_вводов_выводов_активов
			
			// Перед записью запоминаем действующие значения регистра, а при записи сравниваем изменения
			
			Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
				Источник.ДополнительныеСвойства.Вставить("НаборЗаписейПередЗаписью", ПолучитьНаборЗаписейПоРегистратору(ПолноеИмяРегистра, Регистратор, Истина));
				Возврат;		
			Иначе
				ТаблицаПроверкиЗапретаРедактирования = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).ПолучитьТаблицуПроверкиДатЗапретаРедактирования(Источник);		
			КонецЕсли;			
			
			#КонецОбласти
			
		КонецЕсли;
		
	ИначеЕсли ЕстьОтборПоРегистратору И Регистратор.Метаданные().Реквизиты.Найти("СчетДоверительногоУправления") <> Неопределено Тогда
		
		СчетаДоверительногоУправления = Регистратор.СчетДоверительногоУправления;
		
	ИначеЕсли РаботаСМетаданнымиПовтИсп.РегистрыСРегистрациейПоКлиенту().Получить(ПолноеИмяРегистра) <> Неопределено Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
			НаборЗаписей = ПолучитьНаборЗаписейПоРегистратору(ПолноеИмяРегистра, Регистратор);
		Иначе
			НаборЗаписей = Источник;
		КонецЕсли;
		
		Если РегистрМД.Имя = "АналогиЦенныхБумаг" Тогда
			ТаблицаПроверкиЗапретаРедактирования = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).ПолучитьТаблицуПроверкиДатЗапретаРедактирования(НаборЗаписей);		
			СчетаДоверительногоУправления = Неопределено;
		Иначе
			СчетаДоверительногоУправления = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).ПолучитьСвязанныеСчетаДоверительногоУправления(НаборЗаписей);
		КонецЕсли;	

	ИначеЕсли РегистрМД.Имя = "ЗначенияДополнительныхСведений" Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
			НаборЗаписейПередЗаписью = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).ПолучитьТаблицуНабораЗаписейПередЗаписью(Источник);
			Источник.ДополнительныеСвойства.Вставить("НаборЗаписейПередЗаписью", НаборЗаписейПередЗаписью);
			Возврат;		
		Иначе
			ТаблицаПроверкиЗапретаРедактирования = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).ПолучитьТаблицуПроверкиДатЗапретаРедактирования(Источник);
		КонецЕсли;
		
	Иначе
		Возврат;		
	КонецЕсли;
	
	// Если таблица проверки не переопределена, заполняем алгоритмом по умолчанию
	
	Если ТаблицаПроверкиЗапретаРедактирования = Неопределено Тогда	
	
		// регистры можно разделить на 3 группы:
		//	- "проводки": бух. регистры (они всегда содержат вид учета)
		//	- "партии": регистры сведений и накоплений, содержащие вид учета (одноименное измерение)
		//	- "бэк-офис": прочие регистры сведений и накоплений
		
		ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.ПустаяСсылка();
		
		СписокРегистровБухгалтерии	= РаботаСМетаданнымиПовтИсп.ПолучитьСписокРегистровБухгалтерии();
		СписокРегистровСПроводками	= РаботаСМетаданнымиПовтИсп.ПолучитьСписокРегистровСПроводками();
		СписокРегистровСПартиями	= РаботаСМетаданнымиПовтИсп.ПолучитьСписокРегистровСПартиями();
		
		Если СписокРегистровСПроводками[РегистрМД.Имя] <> Неопределено Тогда	
			
			ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Проводки;
			
			Если СписокРегистровБухгалтерии[РегистрМД.Имя] <> Неопределено Тогда
				ВидыУчета = Перечисления.ВидыУчета[РегистрМД.Имя];
			ИначеЕсли СтрЗаканчиваетсяНа(РегистрМД.Имя, "ЕПС") Тогда
				ВидыУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
			ИначеЕсли РегистрМД.Имя = "ПорученияНаПереоценку" Тогда
				ВидыУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
			Иначе
				ВызватьИсключение "Не удалось определить вид учета записей регистра '" + РегистрМД.Синоним + "'";
			КонецЕсли;
			
		ИначеЕсли СписокРегистровСПартиями[РегистрМД.Имя] <> Неопределено Тогда
			
			ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Партии;
			
		Иначе
			
			ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.БэкОфис;
			ВидыУчета                   = Перечисления.ВидыУчета.ПустаяСсылка();
			
		КонецЕсли;	
		
		// Собираем запрос	
		
		Запрос = Новый Запрос;
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	&Активность КАК Активность,
			|	НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) КАК Период,
			|	&Организация КАК Организация,
			|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	&ГруппаЗапрета КАК ГруппаЗапрета,
			|	&ВидУчета КАК ВидУчета
			|ПОМЕСТИТЬ _ДвиженияДокумента
			|ИЗ
			|	&НаборЗаписей КАК Регистр";	
		
		ЕстьСтандРеквизитАктивность	= Ложь;
		Для Каждого Поле Из РегистрМД.СтандартныеРеквизиты Цикл
			Если Поле.Имя = "Активность" Тогда
				  ЕстьСтандРеквизитАктивность = Истина;
				  Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьСтандРеквизитАктивность Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Активность", "Регистр.Активность");
		Иначе
			Запрос.УстановитьПараметр("Активность", Истина);
		КонецЕсли;
		
		ЭтоНепериодическийРегистрСведений = СтрНачинаетсяС(ПолноеИмяРегистра, "РегистрСведений.") 
			И (РегистрМД.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);		
		
		Если ЭтоНепериодическийРегистрСведений Тогда
			Запрос.УстановитьПараметр("Период", Регистратор.Дата);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период", "Регистр.Период");
		КонецЕсли;

		Если РегистрМД.Измерения.Найти("Организация") = Неопределено Тогда
			Запрос.УстановитьПараметр("Организация", Регистратор.Организация);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Организация", "Регистр.Организация");
		КонецЕсли;

		Если ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Партии Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидУчета", "Регистр.ВидУчета");
		Иначе
			Запрос.УстановитьПараметр("ВидУчета", ВидыУчета);
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("ГруппаЗапрета", ГруппаЗапретаРедактирования);
		
		// если это регистр партий - возможно наличие записей в наборе по разным видам учета. Порядок дейтсвий следующий:
		// ПередЗаписью набора формируем таблицу, содержащую записи, запрещенные для редактирования, вставляем ее в ДополнительныеСвойства набора
		// ПриЗаписи набора формируем аналогичную таблицу, сверяем ее с таблицей из доп. свойств. Выводим ошибки при наличии расхождений
		
		// для прочих регистров проверяем только наличие записей, запрещенных для редактирования. Если такие есть - выводим ошибки
		
		Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
			
			ТекстЗапроса = ТекстЗапроса + "
				|ГДЕ
				|	Регистр.Регистратор = &Регистратор";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаборЗаписей", ПолноеИмяРегистра);
			
			Запрос.УстановитьПараметр("Регистратор", Регистратор);
			
		Иначе
			
			Запрос.УстановитьПараметр("НаборЗаписей", Источник.Выгрузить());
			
		КонецЕсли;
		
		// Если отбор по одному счету д/у, то просто устанавливаем его.
		// Если отбор по массиву счетов, то множим записи набора по каждому.
		
		Если ТипЗнч(СчетаДоверительногоУправления) = Тип("Строка") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетДоверительногоУправления", "Регистр.СчетДоверительногоУправления");
		ИначеЕсли ТипЗнч(СчетаДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетаДоверительногоУправления);
		ИначеЕсли ТипЗнч(СчетаДоверительногоУправления) = Тип("Массив") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетДоверительногоУправления КАК СчетДоверительногоУправления,", "");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ _ДвиженияДокумента", "ПОМЕСТИТЬ _ДвиженияДокументаБезСчетов");
			ТекстЗапроса = ТекстЗапроса + "
				|;
				|" +
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ДвиженияДокументаБезСчетов.*,
				|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления			
				|ПОМЕСТИТЬ _ДвиженияДокумента
				|ИЗ
				|	_ДвиженияДокументаБезСчетов КАК _ДвиженияДокументаБезСчетов
				|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
				|	ПО СчетаДоверительногоУправления.Ссылка В (&СчетДоверительногоУправления)";
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетаДоверительногоУправления);
		КонецЕсли;
		
	Иначе
		
		// Проверка непосредственно по таблице	
		
		Запрос = Новый Запрос;
		
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаПроверки.Организация КАК Организация,
			|	ТаблицаПроверки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ТаблицаПроверки.ГруппаЗапрета КАК ГруппаЗапрета,
			|	ТаблицаПроверки.ВидУчета КАК ВидУчета,
			|	ТаблицаПроверки.Период КАК Период,
			|	ИСТИНА КАК Активность
			|ПОМЕСТИТЬ _ДвиженияДокумента
			|ИЗ
			|	&ТаблицаПроверки КАК ТаблицаПроверки";

		Запрос.УстановитьПараметр("ТаблицаПроверки", ТаблицаПроверкиЗапретаРедактирования);	
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса + "
		|;
		|" +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета
		|ИЗ
		|	_ДвиженияДокумента КАК _ДвиженияДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО _ДвиженияДокумента.Организация = ДатыЗапретаРедактирования.Организация
		|			И _ДвиженияДокумента.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления
		|			И _ДвиженияДокумента.ГруппаЗапрета = ДатыЗапретаРедактирования.ГруппаЗапрета
		|			И _ДвиженияДокумента.ВидУчета = ДатыЗапретаРедактирования.ВидУчета
		|			И _ДвиженияДокумента.Период <= ДатыЗапретаРедактирования.ДатаЗапретаРедактирования
		|ГДЕ
		|	_ДвиженияДокумента.Активность";

	Если ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Партии Тогда
		
		ВидыУчета = Запрос.Выполнить().Выгрузить();
		
		Если Источник.ДополнительныеСвойства.Свойство("ВидыУчета") Тогда
			Для каждого ВидУчета Из ВидыУчета Цикл
				ЗаполнитьЗначенияСвойств(Источник.ДополнительныеСвойства.ВидыУчета.Добавить(), ВидУчета);
			КонецЦикла; 
		Иначе
			Источник.ДополнительныеСвойства.Вставить("ВидыУчета", ВидыУчета);
		КонецЕсли; 
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("Источник", 			Источник);
		ПараметрыПроверки.Вставить("ПолноеИмяРегистра", ПолноеИмяРегистра);
		ПараметрыПроверки.Вставить("Регистратор",		Регистратор);
		ПараметрыПроверки.Вставить("Запрос", 			Запрос);
		
		РезультатЗапроса = ПроверитьЗаписиРегистраПартий(ПараметрыПроверки);
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + "
			|ИТОГИ ПО
			|	ДатыЗапретаРедактирования.ВидУчета";
		
		РезультатЗапроса = Запрос.Выполнить();
		
	КонецЕсли;
			
	Если Не РезультатЗапроса = Неопределено Тогда
		
		ВыборкаПоВидуУчета = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоВидуУчета.Следующий() Цикл
			
			ПредставлениеРегистра = РегистрМД.Представление();
			Если ГруппаЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Партии
				ИЛИ ГруппаЗапретаРедактирования = Неопределено И ЗначениеЗаполнено(ВыборкаПоВидуУчета.ВидУчета)
			Тогда
				ПредставлениеРегистра = ПредставлениеРегистра + "' по виду учета '" + ВыборкаПоВидуУчета.ВидУчета;
			КонецЕсли; 
			
			ТекстСообщения = СтрШаблон("Запрещено редактирование регистра '%1', т.к. период меньше даты запрета редактирования",
				ПредставлениеРегистра + ?(ЕстьОтборПоРегистратору,"' по документу '" + Регистратор, ""));
				
			Если ТипЗнч(СчетаДоверительногоУправления) = Тип("Массив") ИЛИ СчетаДоверительногоУправления = Неопределено Тогда
				ЗакрытыеСчета = Новый Массив;
				ВыборкаПоСчетуДоверительногоУправления = ВыборкаПоВидуУчета.Выбрать();
				Пока ВыборкаПоСчетуДоверительногоУправления.Следующий() Цикл
					ЗакрытыеСчета.Добавить(ВыборкаПоСчетуДоверительногоУправления.СчетДоверительногоУправления);		
				КонецЦикла;
				ТекстСообщения = ТекстСообщения + " " + СтрСоединить(ЗакрытыеСчета, ", ");
			КонецЕсли;
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Регистратор, , , Отказ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверкаЗапретаРедактированияУчетныхРегистров

Процедура ПроверкаЗапретаРедактированияУчетныхРегистровПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Источник.ДополнительныеСвойства.Вставить("ПередЗаписью");
	ПроверкаЗапретаРедактированияУчетныхРегистров(Источник, Отказ, Замещение);
	Источник.ДополнительныеСвойства.Удалить("ПередЗаписью");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗаписьюРегистров(Источник, Отказ, Замещение) Экспорт
	
	// Если происходит всамделешное удаление набора записей, то в ПередЗаписью Модифицированность()=ИСТИНА,
	// а если удаление, которое предшествует записи нового набора (при изменении) — ЛОЖЬ
	Источник.ДополнительныеСвойства.Вставить("УдалениеВСоставеИзмененияНабора", Источник.Количество() = 0 И Не Источник.Модифицированность());
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РаспределенияАктивовЕПС") Тогда
		
		#Область РаспределенияАктивовЕПС
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЮрФизЛицо_Сургутнефтегаз",	ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сургутнефтегаз"));
		Запрос.УстановитьПараметр("НаборЗаписей",				Источник.Выгрузить());
		Запрос.Текст =
		#Область ТекстЗапроса
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _СДУ
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|ГДЕ
			|	КлиентыДоверительногоУправления.Клиент = &ЮрФизЛицо_Сургутнефтегаз
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НаборЗаписей.Активность КАК Активность,
			|	НаборЗаписей.Организация КАК Организация,
			|	НаборЗаписей.Сделка КАК Сделка,
			|	НаборЗаписей.Рынок КАК Рынок,
			|	НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
			|	НаборЗаписей.Количество КАК Количество,
			|	НаборЗаписей.УчетныйАктивЕПС КАК УчетныйАктивЕПС
			|ПОМЕСТИТЬ _НаборЗаписей
			|ИЗ
			|	&НаборЗаписей КАК НаборЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_НаборЗаписей.Организация КАК Организация,
			|	_НаборЗаписей.Сделка КАК Сделка,
			|	_НаборЗаписей.Рынок КАК Рынок,
			|	_НаборЗаписей.Количество КАК Количество,
			|	_НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _НовыйНаборЗаписей
			|ИЗ
			|	_НаборЗаписей КАК _НаборЗаписей
			|ГДЕ
			|	ВЫБОР
			|			КОГДА _НаборЗаписей.Сделка ССЫЛКА Документ.Сделка
			|				ТОГДА ВЫРАЗИТЬ(_НаборЗаписей.Сделка КАК Документ.Сделка).СчетДоверительногоУправления
			|			КОГДА _НаборЗаписей.Сделка ССЫЛКА Документ.Сделка
			|				ТОГДА ВЫРАЗИТЬ(_НаборЗаписей.Сделка КАК Документ.СделкаРЕПО).СчетДоверительногоУправления
			|			ИНАЧЕ ВЫРАЗИТЬ(_НаборЗаписей.Сделка КАК Документ.СделкаСВалютой).СчетДоверительногоУправления
			|		КОНЕЦ В
			|			(ВЫБРАТЬ
			|				_СДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|			ИЗ
			|				_СДУ КАК _СДУ)
			|	И _НаборЗаписей.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))
			|	И _НаборЗаписей.Активность
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	РаспределенияАктивовЕПС.Организация КАК Организация,
			|	РаспределенияАктивовЕПС.Сделка КАК Сделка,
			|	РаспределенияАктивовЕПС.Рынок КАК Рынок,
			|	РаспределенияАктивовЕПС.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ТекущийСнимокРегистра
			|ИЗ
			|	РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
			|ГДЕ
			|	(РаспределенияАктивовЕПС.Организация, РаспределенияАктивовЕПС.Сделка, РаспределенияАктивовЕПС.Рынок, РаспределенияАктивовЕПС.ЦеннаяБумага) В
			|			(ВЫБРАТЬ
			|				_НовыйНаборЗаписей.Организация КАК Организация,
			|				_НовыйНаборЗаписей.Сделка КАК Сделка,
			|				_НовыйНаборЗаписей.Рынок КАК Рынок,
			|				_НовыйНаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага
			|			ИЗ
			|				_НовыйНаборЗаписей КАК _НовыйНаборЗаписей)
			|	И РаспределенияАктивовЕПС.УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))
			|	И ВЫБОР
			|			КОГДА РаспределенияАктивовЕПС.Сделка ССЫЛКА Документ.Сделка
			|				ТОГДА ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.Сделка).СчетДоверительногоУправления
			|			КОГДА РаспределенияАктивовЕПС.Сделка ССЫЛКА Документ.Сделка
			|				ТОГДА ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.СделкаРЕПО).СчетДоверительногоУправления
			|			ИНАЧЕ ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.СделкаСВалютой).СчетДоверительногоУправления
			|		КОНЕЦ В
			|			(ВЫБРАТЬ
			|				_СДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|			ИЗ
			|				_СДУ КАК _СДУ)
			|	И РаспределенияАктивовЕПС.Активность
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_НовыйНаборЗаписей.Организация КАК Организация,
			|	ВЫБОР
			|		КОГДА _НовыйНаборЗаписей.Сделка ССЫЛКА Документ.Сделка
			|			ТОГДА ВЫРАЗИТЬ(_НовыйНаборЗаписей.Сделка КАК Документ.Сделка).СчетДоверительногоУправления
			|		КОГДА _НовыйНаборЗаписей.Сделка ССЫЛКА Документ.СделкаРЕПО
			|			ТОГДА ВЫРАЗИТЬ(_НовыйНаборЗаписей.Сделка КАК Документ.СделкаРЕПО).СчетДоверительногоУправления
			|		ИНАЧЕ ВЫРАЗИТЬ(_НовыйНаборЗаписей.Сделка КАК Документ.СделкаСВалютой).СчетДоверительногоУправления
			|	КОНЕЦ КАК СчетДоверительногоУправления,
			|	_НовыйНаборЗаписей.Сделка КАК Сделка,
			|	_НовыйНаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_НовыйНаборЗаписей.Количество КАК Количество
			|ИЗ
			|	_НовыйНаборЗаписей КАК _НовыйНаборЗаписей
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ТекущийСнимокРегистра КАК _ТекущийСнимокРегистра
			|		ПО _НовыйНаборЗаписей.Организация = _ТекущийСнимокРегистра.Организация
			|			И _НовыйНаборЗаписей.Сделка = _ТекущийСнимокРегистра.Сделка
			|			И _НовыйНаборЗаписей.Рынок = _ТекущийСнимокРегистра.Рынок
			|			И _НовыйНаборЗаписей.ЦеннаяБумага = _ТекущийСнимокРегистра.ЦеннаяБумага
			|ГДЕ
			|	_ТекущийСнимокРегистра.Сделка ЕСТЬ NULL";
		#КонецОбласти
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			
			ТекстСообщения = "";
			
			Пока Выборка.Следующий() Цикл
				ТекстСообщения = ТекстСообщения + Символы.ПС +
					"<tr><td>" + Выборка.Организация + "</td><td>" + Выборка.СчетДоверительногоУправления + "</td><td>" + Выборка.Сделка + "</td><td class=""greentext"">" + Выборка.ЦеннаяБумага + "</td><td align=""center"" class=""purple"">" + Выборка.Количество + "</td></tr>";
			КонецЦикла;
			
			ТекстСообщения = 
				"<html><head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
				|	<style>
				|		body       { font: 10pt sans-serif; }
				|		table      { text-align: left; border-spacing: 0; border-collapse: collapse; }
				|		td         { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
				|		.top       { font-size: 14px; background: #F4ECC5; }
				|		.greentext { color: #009646; }
				|		.purple    { color: #8B008B; }
				|	</style>
				|</head>
				|<body>
				|<table cols=""5"">
				|<tr class=""top""><td colspan=""5"">Перечень ценных бумаг классифицированных в категорию 'До погашения'</td></tr>
				|<tr class=""top""><td>Организация</td><td>Счет доверительного управления</td><td>Сделка</td><td>Ценная бумага</td><td>Количество</td></tr>
				|" + ТекстСообщения + "</table></body></html>";
			
			РеквизитыОповещения = Новый Структура("Тема, Текст", "Результат проверки на классификацию актива в категорию 'До погашения'", ТекстСообщения);
			
			Справочники.Оповещения.СформироватьОповещения("РегистрСведений.РаспределенияАктивовЕПС", Перечисления.ТипыСобытий.ПередЗаписьюРегистраСведений, РеквизитыОповещения);
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДоговорыСчетовДоверительногоУправления") 		
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ЛицензииДоговоровДоверительногоУправления")
	Тогда
	
		#Область ДоговорыСчетовДоверительногоУправления_ЛицензииДоговоровДоверительногоУправления
	
		Если НЕ Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("ПредыдущаяАктивностьДоговоровПоВидамДеятельности") Тогда
			
			Источник.ЗаписьИсторииДанных.ДобавитьДополнительныеДанные(
				"ПредыдущаяАктивностьДоговоровПоВидамДеятельности", 
				РегистрыСведений.ДоговорыСчетовДоверительногоУправления.ПолучитьАктивностьДоговоровПоВидамДеятельности(Источник.Отбор),
				"ПредыдущаяАктивностьДоговоровПоВидамДеятельности");
				
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.КодыСчетовДоверительногоУправленияУБрокеров") Тогда
		
		#Область КодыСчетовДоверительногоУправленияУБрокеров
		
		Если Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("КодыУБрокераПередЗаписью") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Период КАК Период,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация КАК Организация,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.КодFORTS КАК КодFORTS
				|ИЗ
				|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
				|ГДЕ
				|	&Отбор";
			
			Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

			Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
				
				Если ЭлементОтбора.Имя <> "Период" И ЭлементОтбора.Использование Тогда
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", "&Отбор И " + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя + "");
					Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", "ИСТИНА");
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("КодыУБрокераПередЗаписью", РезультатЗапроса.Выгрузить());
				
			Иначе
				
				КодыСчетовДоверительногоУправленияУБрокеровМД = Метаданные.РегистрыСведений.КодыСчетовДоверительногоУправленияУБрокеров;
				
				КодыУБрокераБезЗаписей = Новый ТаблицаЗначений;
				КодыУБрокераБезЗаписей.Колонки.Добавить("Период",                       Новый ОписаниеТипов("Дата"));
				КодыУБрокераБезЗаписей.Колонки.Добавить("Организация",                  КодыСчетовДоверительногоУправленияУБрокеровМД.Измерения.Организация.Тип);
				КодыУБрокераБезЗаписей.Колонки.Добавить("СчетДоверительногоУправления", КодыСчетовДоверительногоУправленияУБрокеровМД.Измерения.СчетДоверительногоУправления.Тип);
				КодыУБрокераБезЗаписей.Колонки.Добавить("Брокер",                       КодыСчетовДоверительногоУправленияУБрокеровМД.Измерения.Брокер.Тип);
				КодыУБрокераБезЗаписей.Колонки.Добавить("Код",                          КодыСчетовДоверительногоУправленияУБрокеровМД.Ресурсы.Код.Тип);
				КодыУБрокераБезЗаписей.Колонки.Добавить("КодFORTS",                     КодыСчетовДоверительногоУправленияУБрокеровМД.Ресурсы.КодFORTS.Тип);
				
				Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("КодыУБрокераПередЗаписью", КодыУБрокераБезЗаписей);
				
			КонецЕсли;
	
		КонецЕсли;
		
		#КонецОбласти
						
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ОстаткиЦенныхБумаг") И Источник.Количество() = 0 Тогда
			
		ПроверитьДвиженияПаевСобственногоПортфеляИСформироватьОповещение(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДокументыЮридическихЛиц")
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ВхожденияВРеестры") 
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛиц") 
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛицАнкетные") Тогда
		
		РаботаСОтчетностьюЦБ.ДобавитьДанныеДляПроверкиРеквизитовАудитора(Источник);
		
		#Область РеквизитыЮридическихЛиц
		
		Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛиц") 
			И Источник.ДополнительныеСвойства.Свойство("ЮридическиеЛицаПоДействующимСчетамДУ")
			И Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("РеквизитыЮридическихЛицПередЗаписью") Тогда
			
			// Необходимо проверить изменение наименования по уставу у брокеров, депозитариев, банков, связанных со счетами ДУ РЭМа и Траста
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Запрос.УстановитьПараметр("ТекущаяДата", 							ТекущаяДатаСеанса());
			Запрос.УстановитьПараметр("ЮридическиеЛицаПоДействующимСчетамДУ", 	Источник.ДополнительныеСвойства.ЮридическиеЛицаПоДействующимСчетамДУ);
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЮридическиеЛицаПоДействующимСчетамДУ.ЮрФизЛицо КАК ЮрФизЛицо,
				|	ЮридическиеЛицаПоДействующимСчетамДУ.Организация КАК Организация
				|ПОМЕСТИТЬ _ЮрЛицаДляПроверки
				|ИЗ
				|	&ЮридическиеЛицаПоДействующимСчетамДУ КАК ЮридическиеЛицаПоДействующимСчетамДУ";
			
			Запрос.Выполнить();
			
			// Запоминаем наименование по уставу и организацию для полученных юр. лиц
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
				|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
				|	РеквизитыЮридическихЛицСрезПоследних.Язык КАК Язык,
				|	РеквизитыЮридическихЛицСрезПоследних.Подразделение КАК Подразделение,
				|	_ЮрЛицаДляПроверки.Организация КАК Организация
				|ИЗ
				|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&ТекущаяДата, ИСТИНА) КАК РеквизитыЮридическихЛицСрезПоследних
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЮрЛицаДляПроверки КАК _ЮрЛицаДляПроверки
				|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = _ЮрЛицаДляПроверки.ЮрФизЛицо";
									
			Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
				
				Если ЭлементОтбора.Имя <> "Период" И ЭлементОтбора.Использование Тогда
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "ИСТИНА И " + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя + "");
					Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда 				
				Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("РеквизитыЮридическихЛицПередЗаписью", РезультатЗапроса.Выгрузить());				
			КонецЕсли;
	
		КонецЕсли;
		
		#КонецОбласти	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.УсловияОферт") И Не (Источник.Количество() = 0 И Источник.Модифицированность()) Тогда
		
	#Область УсловияОферт
		Если Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_УсловияОфертПередЗаписью") Тогда
		
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	УсловияОферт.Облигация КАК Облигация,
				|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
				|	УсловияОферт.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛиц,
				|	УсловияОферт.ЦенаПроцент КАК ЦенаПроцент,
				|	УсловияОферт.Цена КАК Цена,
				|	УсловияОферт.АкцептС КАК АкцептС,
				|	УсловияОферт.АкцептПо КАК АкцептПо,
				|	УсловияОферт.ТипОферты КАК ТипОферты,
				|	УсловияОферт.ДатаОбъявления КАК ДатаОбъявления
				|ПОМЕСТИТЬ _УсловияОфертПередЗаписью
				|ИЗ
				|	РегистрСведений.УсловияОферт КАК УсловияОферт
				|ГДЕ
				|	(УсловияОферт.ДатаВыкупа >= &ТекущаяДатаСеанса И УсловияОферт.АкцептПо = ДАТАВРЕМЯ(1,1,1) ИЛИ УсловияОферт.АкцептПо >= &ТекущаяДатаСеанса)
				|	И УсловияОферт.ТипОферты В (ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно), ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ДопОферта))
				|	И ИСТИНА";
			
			Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
			
			Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
				
				Если ЭлементОтбора.Использование Тогда
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "ИСТИНА И УсловияОферт." + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя + "");
					Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Запрос.Выполнить();
							
			Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("МВТ_УсловияОфертПередЗаписью", Запрос.МенеджерВременныхТаблиц);				
		
		КонецЕсли;
	#КонецОбласти
			
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СостояниеСотрудниковОрганизаций") И Не (Источник.Количество() = 0 И Источник.Модифицированность()) Тогда
		
	#Область СостояниеСотрудниковОрганизаций
		Если Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_СостояниеСотрудниковОрганизацийПередЗаписью") Тогда
		
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	СостояниеСотрудниковОрганизаций.Период КАК Период,
				|	СостояниеСотрудниковОрганизаций.Организация КАК Организация,
				|	СостояниеСотрудниковОрганизаций.Сотрудник КАК Сотрудник,
				|	СостояниеСотрудниковОрганизаций.Состояние КАК Состояние
				|ПОМЕСТИТЬ _СостояниеСотрудниковОрганизацийПередЗаписью
				|ИЗ
				|	РегистрСведений.СостояниеСотрудниковОрганизаций КАК СостояниеСотрудниковОрганизаций
				|ГДЕ
				|	ИСТИНА";
			
			Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
				Если ЭлементОтбора.Использование Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "ИСТИНА И СостояниеСотрудниковОрганизаций." + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя + "");
					Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
				КонецЕсли;
			КонецЦикла;
			
			Запрос.Выполнить();
							
			Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("МВТ_СостояниеСотрудниковОрганизацийПередЗаписью", Запрос.МенеджерВременныхТаблиц);				
		
		КонецЕсли;
	#КонецОбласти
			
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СтатусыМЧД") И Не (Источник.Количество() = 0 И Источник.Модифицированность()) Тогда
		
	#Область СостояниеСотрудниковОрганизаций
		Если Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_СтатусыМЧДПередЗаписью") Тогда
		
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтатусыМЧДСрезПоследних.Период КАК Период,
				|	СтатусыМЧДСрезПоследних.Организация КАК Организация,
				|	СтатусыМЧДСрезПоследних.Доверенность КАК Доверенность,
				|	СтатусыМЧДСрезПоследних.Статус КАК Статус,
				|	СтатусыМЧДСрезПоследних.УстановленВручную КАК УстановленВручную,
				|	СтатусыМЧДСрезПоследних.Комментарий КАК Комментарий
				|ПОМЕСТИТЬ _СтатусыМЧДПередЗаписью
				|ИЗ
				|	РегистрСведений.СтатусыМЧД.СрезПоследних(&ТекущаяДата, ИСТИНА) КАК СтатусыМЧДСрезПоследних";
			
			Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
				Если ЭлементОтбора.Имя <> "Период" И ЭлементОтбора.Использование Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА", "ИСТИНА И " + ЭлементОтбора.Имя + " = &" + ЭлементОтбора.Имя + "");
					Запрос.УстановитьПараметр(ЭлементОтбора.Имя, ЭлементОтбора.Значение);
				КонецЕсли;
			КонецЦикла;
			
			Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
			Запрос.Выполнить();
							
			Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Вставить("МВТ_СтатусыМЧДПередЗаписью", Запрос.МенеджерВременныхТаблиц);				
		
		КонецЕсли;
	#КонецОбласти
			
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыФизическихЛицАнкетные")
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыСотрудниковОрганизации") Тогда
		
		РегистрыСведений.ЖурналСверкиСоСписками.ДобавитьДанныеДляПроверкиРеквизитовЛицПодлежащихСверкеСоСписками(Источник);
		
	КонецЕсли;
	
	МетаданныеРегистра = Источник.Метаданные();
	ЭтоРегистрСведений = Метаданные.РегистрыСведений.Найти(МетаданныеРегистра.Имя) <> Неопределено;
	РегистрПодчиненРегистратору = Не ЭтоРегистрСведений
		Или МетаданныеРегистра.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
	
	// Проверка движений документа "Корректировка регистров"
	Если РегистрПодчиненРегистратору И ЗначениеЗаполнено(Источник.Отбор.Регистратор.Значение)
		И ТипЗнч(Источник.Отбор.Регистратор.Значение) = Тип("ДокументСсылка.КорректировкаРегистров")
	Тогда
		Документы.КорректировкаРегистров.ПроверитьНаборДвижений(Источник.Отбор.Регистратор.Значение, Источник, Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписьюДокументов(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ЭтоНовый() Тогда 
		РаботаСДокументами.УстановитьОтветственного(Источник, Отказ); 
	КонецЕсли;

	Источник.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);

КонецПроцедуры
 
Процедура ПередЗаписьюДокументовБэкОфиса(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
КонецПроцедуры

Процедура ПриЗаписиДокументовБэкОфиса(Источник, Отказ) Экспорт
	
	Если Источник.ПометкаУдаления ИЛИ Не Источник.Проведен Тогда
		РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ОтменитьПодтверждениеОперации(Источник, , "Отмена проведения документа", Ложь);	
	ИначеЕсли Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда  
		АвтоматическоеПодтверждениеОперацииБэкОфиса(Источник, Отказ);
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если ЗарегистрированНомерСообщенияОбОткрытииЗакрытииИИС(Источник.Ссылка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено отменять проведение документов, по которым зарегистрирован номер сообщения об открытии / закрытии ИИС.",,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения 
		И (ТипЗнч(Источник) = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств")
			Или ТипЗнч(Источник) = Тип("ДокументОбъект.ПоручениеНаДвижениеЦенныхБумаг")) Тогда		
		РаботаСБизнесПроцессамиИЗадачами.ПроверитьИНачатьСогласованиеПорученияНаВыводАктивов(Источник, Отказ);		
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеЗадолженностейПоПоручению") 
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Поручение, "ТипЗадолженности") = Перечисления.ТипыЗадолженности.Кредиторская Тогда
		РаботаСБизнесПроцессамиИЗадачами.ОбработатьБизнесПроцессПорученияПриСписанииЗадолженности(Источник, Отказ);
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаПайщика")
		И Источник.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление
		И Не Источник.ПометкаУдаления Тогда
		РаботаСБизнесПроцессамиИЗадачами.НачатьБизнесПроцессПоДвижениюПаевПаевогоИнвестиционногоФонда("ПоступлениеИПроверкаЗаявкиНаПриобретениеПаев", Источник, Отказ);
	КонецЕсли;
	
	// Для процесса зачисления паев используем подтвержденные банком вводы по заявкам пайщика
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ВводДенежныхСредств")
		И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")		
		И ЗначениеЗаполнено(Источник.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		РаботаСБизнесПроцессамиИЗадачами.НачатьБизнесПроцессПоДвижениюПаевПаевогоИнвестиционногоФонда("ЗачислениеПаев", Источник, Отказ);
	КонецЕсли;
	
	// В отдельных случаях необходимо автоматически выполнить задачу
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ПереводДенежныхСредств")
		И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")		
		И ЗначениеЗаполнено(Источник.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.РасчетныйСчет, "ТранзитныйПИФ") = Истина
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		РаботаСБизнесПроцессамиИЗадачами.НайтиИВыполнитьЗадачуСистемногоПользователяПоБизнесПроцессу(
								Источник.Организация,
								Источник.Основание,
								"ЗачислениеПаев",
								БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ФормированиеПлатежногоПорученияНаПереводДенежныхСредствСТранзитногоСчетаНаРасчетный,
								Отказ);
								
	ИначеЕсли Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводДенежныхСредств")
		И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")		
		И ЗначениеЗаполнено(Источник.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.РасчетныйСчет, "ТранзитныйПИФ") = Истина
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		РаботаСБизнесПроцессамиИЗадачами.НайтиИВыполнитьЗадачуСистемногоПользователяПоБизнесПроцессу(
								Источник.Организация,
								Источник.Основание,
								"ЗачислениеПаев",
								БизнесПроцессы.ЗачислениеПаев.ТочкиМаршрута.ВозвратДенежныхСредствПайщику,
								Отказ);
								
	ИначеЕсли Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводДенежныхСредств")
		И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")		
		И ЗначениеЗаполнено(Источник.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Погашение Тогда
		
		РаботаСБизнесПроцессамиИЗадачами.НайтиИВыполнитьЗадачуСистемногоПользователяПоБизнесПроцессу(
								Источник.Организация,
								Источник.Основание,
								"ПогашениеПаев",
								БизнесПроцессы.ПогашениеПаев.ТочкиМаршрута.ФормированиеПлатежногоПорученияНаВыплатуДенежныхСредствПайщику,
								Отказ);
								
	ИначеЕсли Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводДенежныхСредств")
		И ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")		
		И ЗначениеЗаполнено(Источник.СтрокаБанковскойВыписки)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Основание, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		
		РаботаСБизнесПроцессамиИЗадачами.НайтиИВыполнитьЗадачуСистемногоПользователяПоБизнесПроцессу(
								Источник.Организация,
								Источник.Основание,
								"ОбменПаев",
								БизнесПроцессы.ОбменПаев.ТочкиМаршрута.ФормированиеПлатежногоПорученияНаПереводДенежныхСредствВПИФПоОбмену,
								Отказ);							
								
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаПайщика")
		И Источник.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Погашение Тогда
		РаботаСБизнесПроцессамиИЗадачами.НачатьБизнесПроцессПоДвижениюПаевПаевогоИнвестиционногоФонда("ПогашениеПаев", Источник, Отказ);
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения
		И Не Источник.ПометкаУдаления
		И ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаПайщика")
		И Источник.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		РаботаСБизнесПроцессамиИЗадачами.НачатьБизнесПроцессПоДвижениюПаевПаевогоИнвестиционногоФонда("ОбменПаев", Источник, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриПроведенииДокументовБэкОфиса(Источник, Отказ, РежимПроведения) Экспорт
	
	АвтоматическоеПодтверждениеОперацииБэкОфиса(Источник, Отказ);
	
КонецПроцедуры

