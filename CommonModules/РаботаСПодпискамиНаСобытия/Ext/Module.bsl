			|	_Расхождения.АкцептСНов КАК АкцептСНов,
			|	_Расхождения.АкцептПоНов КАК АкцептПоНов,
			|	_Расхождения.ТипОфертыНов КАК ТипОфертыНов,
			|	_Расхождения.ДатаОбъявленияНов КАК ДатаОбъявленияНов,
			|	_Расхождения.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛиц,
			|	_Расхождения.ЦенаПроцент КАК ЦенаПроцент,
			|	_Расхождения.Цена КАК Цена,
			|	_Расхождения.АкцептС КАК АкцептС,
			|	_Расхождения.АкцептПо КАК АкцептПо,
			|	_Расхождения.ТипОферты КАК ТипОферты,
			|	_Расхождения.ДатаОбъявления КАК ДатаОбъявления,
			|	_Расхождения.ФлагНоваяЗапись КАК ФлагНоваяЗапись,
			|	_Расхождения.Поля КАК Поля
			|ИЗ
			|	_ОстаткиОбщие КАК _ОстаткиОбщие
			|		ЛЕВОЕ СОЕДИНЕНИЕ _Расхождения КАК _Расхождения
			|		ПО _ОстаткиОбщие.ЦеннаяБумага = _Расхождения.Облигация
			|			И _ОстаткиОбщие.ДатаВыкупа = _Расхождения.ДатаВыкупа
			|			И _ОстаткиОбщие.ДляФизЛиц = _Расхождения.ДляФизЛиц
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыУБрокеров КАК _КодыУБрокеров
			|		ПО _ОстаткиОбщие.Организация = _КодыУБрокеров.Организация
			|			И _ОстаткиОбщие.СчетДоверительногоУправления = _КодыУБрокеров.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ОстаткиОбщие.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
			|			И (КодыВТорговыхСистемахСрезПоследних.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN))
			|ИТОГИ ПО
			|	ЦеннаяБумага,
			|	ДатаВыкупа,
			|	Организация";
		
		Запрос.УстановитьПараметр("НаборНовыхЗаписей", Источник.Выгрузить());
		Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("РЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
		Запрос.УстановитьПараметр("Траст", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
		
		Результат = Запрос.Выполнить();
		
		ГруппировкаПоЦеннойБумаге = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЦеннаяБумага");
		
		ТекстСообщения = "";
		
		Пока ГруппировкаПоЦеннойБумаге.Следующий() Цикл
								
			ГруппировкаПоДатеВыкупа = ГруппировкаПоЦеннойБумаге.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ДатаВыкупа");
			
			Пока ГруппировкаПоДатеВыкупа.Следующий() Цикл
				
				ДобавитьУсловиеОферты = Истина;
				
				ГруппировкаПоОрганизации = ГруппировкаПоДатеВыкупа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Организация");
				
				Пока ГруппировкаПоОрганизации.Следующий() Цикл
					
					ДобавитьДанныеОрганизации = Истина;
					
					Выборка = ГруппировкаПоОрганизации.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						Если ДобавитьУсловиеОферты Тогда
							
							ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", "<br>") + "<table cols=""4""><tr class=""top""><td colspan=""4"">Облигация: " + Выборка.ЦеннаяБумага + " (ISIN " + Выборка.КодISIN + ")</td></tr>";
							ТекстСообщения = ТекстСообщения + "<tr class=""top2""><td colspan=""4"">Условия оферты</td></tr>";
							ТекстСообщения = ТекстСообщения + "<tr class=""line""><td colspan=""4"">Дата выкупа: <b>" + Формат(Выборка.ДатаВыкупа, "ДФ=dd.MM.yyyy") + "</b><br>";
							ТекстСообщения = ТекстСообщения + "Только для физ лиц: <b>" + Выборка.ТолькоДляФизическихЛицНов + "</b><br>";
							ТекстСообщения = ТекстСообщения + "Цена: <b>" + Выборка.ЦенаНов + "</b><br>";
							ТекстСообщения = ТекстСообщения + "Цена процент: <b>" + Выборка.ЦенаПроцентНов + "</b><br>";
							ТекстСообщения = ТекстСообщения + "Акцепт с: <b>" + Формат(Выборка.АкцептСНов, "ДФ=dd.MM.yyyy") + "</b> по: <b>" + Формат(Выборка.АкцептПоНов, "ДФ=dd.MM.yyyy") + "</b><br>";   
							ТекстСообщения = ТекстСообщения + "Тип оферты: <b>" + Выборка.ТипОфертыНов + "</b><br>";  
							ТекстСообщения = ТекстСообщения + "Дата объявления: <b>" + Формат(Выборка.ДатаОбъявленияНов, "ДФ=dd.MM.yyyy") + "</b></td></tr>"; 
							
							Если Не Выборка.ФлагНоваяЗапись Тогда
								
								МассивПолей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Выборка.Поля, ",", Истина, Истина);
								
								Если МассивПолей.Количество() > 0 Тогда
									
									ТекстСообщения = ТекстСообщения + "<tr class=""top2""><td colspan=""4"">Изменения условий оферты</td></tr><tr class=""line""><td colspan=""4"">";
									
									Для Каждого Поле Из МассивПолей Цикл
										ТекстСообщения = ТекстСообщения + Поле + ": <b>" + СтрЗаменить(Выборка[Поле], " 0:00:00", "")  + " => " + СтрЗаменить(Выборка[Поле + "Нов"], " 0:00:00", "") + "</b><br>";	
									КонецЦикла;
									
									ТекстСообщения = ТекстСообщения + "</tr>";									
								КонецЕсли;
								
							КонецЕсли;
							
							ТекстСообщения = ТекстСообщения + 
								"<tr class=""top""><td colspan=""4"">Остатки ценных бумаг</td></tr>
								|<tr class=""top""><td>Счет доверительного управления</td><td>Код у брокера</td><td>Количество</td><td>Сумма</td></tr>";
								
							ДобавитьУсловиеОферты = Ложь;
							
						КонецЕсли;
						
						Если ДобавитьДанныеОрганизации Тогда
							ТекстСообщения = ТекстСообщения + "<tr class=""top3""><td colspan=""4"">" + Выборка.Организация + "</td></tr>";
							ДобавитьДанныеОрганизации = Ложь;
						КонецЕсли;
						
						ТекстСообщения = ТекстСообщения + "<tr class=""line""><td>" + Выборка.СчетДоверительногоУправления + "</td>";
						ТекстСообщения = ТекстСообщения + "<td>" + Выборка.КодУБрокера + "</td>";
						ТекстСообщения = ТекстСообщения + "<td>" + Выборка.Количество + "</td>";
						ТекстСообщения = ТекстСообщения + "<td>" + Выборка.Сумма + "</td></tr>";
		
					КонецЦикла;
					
				КонецЦикла;
				
				ТекстСообщения = ТекстСообщения + "</table>";
	
			КонецЦикла;
							
		КонецЦикла;
		
		Если ТекстСообщения <> "" Тогда
			
			ТекстСообщения = 
				"<html>
				|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
				|	<style>
				|		body  { font: 10pt sans-serif; }
				|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
				|		td    { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
				|		.top  { font-size: 14px; font-weight: 600; background: #F4ECC5; }
				|		.top2 { font-size: 14px; background: #F8F2D8; }
				|		.top3 { font-size: 14px; font-weight: 600; background: #FBF9EC; }
				|		.line { font-size: 12px;}
				|	</style>
				|</head>
				|<body>
				|" + ТекстСообщения + "</body></html>";
			
			РеквизитыОповещения = Новый Структура("Тема, Текст", "ВАЖНО! Новые данные об оферте.", ТекстСообщения); 
				
		КонецЕсли;	
	#КонецОбласти
	
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СостояниеСотрудниковОрганизаций")
			 И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_СостояниеСотрудниковОрганизацийПередЗаписью") Тогда
			 
 #Область ДанныеОбОтсутствии 
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Источник.ЗаписьИсторииДанных.ДополнительныеДанные.МВТ_СостояниеСотрудниковОрганизацийПередЗаписью;
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Источник.Выгрузить(), "_НаборНовыхЗаписей", Запрос);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеРегистра.Организация КАК Организация,
			|	СправочникСотрудники.ЮрФизЛицо КАК ФизЛицо,
			|	ДанныеРегистра.Сотрудник КАК Сотрудник,
			|	СправочникСотрудники.ВидЗанятости КАК ВидЗанятости,
			|	СотрудникиОрганизации.Должность КАК Должность,
			|	СотрудникиОрганизации.Подразделение КАК Подразделение,
			|	ДанныеРегистра.ДатаНачала КАК ДатаНачала,
			|	ДанныеРегистра.ДатаОкончания КАК ДатаОкончания,
			|	ДанныеРегистра.Состояние КАК Состояние,
			|	ДанныеРегистра.НоваяЗапись КАК НоваяЗапись,
			|	ДанныеРегистра.УдаленнаяЗапись КАК УдаленнаяЗапись
			|ПОМЕСТИТЬ _ДанныеОбОтсутствии
			|ИЗ
			|	(ВЫБРАТЬ
			|		_НаборНовыхЗаписей.Организация КАК Организация,
			|		_НаборНовыхЗаписей.Сотрудник КАК Сотрудник,
			|		_НаборНовыхЗаписей.Период КАК ДатаНачала,
			|		ДОБАВИТЬКДАТЕ(МИНИМУМ(_НаборНовыхЗаписейСледующаяЗапись.Период), ДЕНЬ, -1) КАК ДатаОкончания,
			|		_НаборНовыхЗаписей.Состояние КАК Состояние,
			|		ИСТИНА КАК НоваяЗапись,
			|		ЛОЖЬ КАК УдаленнаяЗапись,
			|		МАКСИМУМ(СотрудникиОрганизации.Период) КАК ПериодСотрудникиОрганизации
			|	ИЗ
			|		_НаборНовыхЗаписей КАК _НаборНовыхЗаписей
			|			ЛЕВОЕ СОЕДИНЕНИЕ _СостояниеСотрудниковОрганизацийПередЗаписью КАК _СостояниеСотрудниковОрганизацийПередЗаписью
			|			ПО _НаборНовыхЗаписей.Организация = _СостояниеСотрудниковОрганизацийПередЗаписью.Организация
			|				И _НаборНовыхЗаписей.Сотрудник = _СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник
			|				И _НаборНовыхЗаписей.Состояние = _СостояниеСотрудниковОрганизацийПередЗаписью.Состояние
			|				И _НаборНовыхЗаписей.Период = _СостояниеСотрудниковОрганизацийПередЗаписью.Период
			|			ЛЕВОЕ СОЕДИНЕНИЕ _НаборНовыхЗаписей КАК _НаборНовыхЗаписейСледующаяЗапись
			|			ПО _НаборНовыхЗаписей.Организация = _НаборНовыхЗаписейСледующаяЗапись.Организация
			|				И _НаборНовыхЗаписей.Сотрудник = _НаборНовыхЗаписейСледующаяЗапись.Сотрудник
			|				И _НаборНовыхЗаписей.Состояние <> _НаборНовыхЗаписейСледующаяЗапись.Состояние
			|				И _НаборНовыхЗаписей.Период < _НаборНовыхЗаписейСледующаяЗапись.Период
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
			|			ПО _НаборНовыхЗаписей.Организация = СотрудникиОрганизации.Организация
			|				И _НаборНовыхЗаписей.Сотрудник = СотрудникиОрганизации.Сотрудник
			|				И _НаборНовыхЗаписей.Период >= СотрудникиОрганизации.Период
			|	ГДЕ
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Период ЕСТЬ NULL
			|	
			|	СГРУППИРОВАТЬ ПО
			|		_НаборНовыхЗаписей.Организация,
			|		_НаборНовыхЗаписей.Сотрудник,
			|		_НаборНовыхЗаписей.Период,
			|		_НаборНовыхЗаписей.Состояние
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Организация,
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник,
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Период,
			|		ДОБАВИТЬКДАТЕ(МИНИМУМ(_СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись.Период), ДЕНЬ, -1),
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Состояние,
			|		ЛОЖЬ,
			|		ИСТИНА,
			|		МАКСИМУМ(СотрудникиОрганизации.Период)
			|	ИЗ
			|		_СостояниеСотрудниковОрганизацийПередЗаписью КАК _СостояниеСотрудниковОрганизацийПередЗаписью
			|			ЛЕВОЕ СОЕДИНЕНИЕ _НаборНовыхЗаписей КАК _НаборНовыхЗаписей
			|			ПО _СостояниеСотрудниковОрганизацийПередЗаписью.Организация = _НаборНовыхЗаписей.Организация
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник = _НаборНовыхЗаписей.Сотрудник
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Состояние = _НаборНовыхЗаписей.Состояние
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Период = _НаборНовыхЗаписей.Период
			|			ЛЕВОЕ СОЕДИНЕНИЕ _СостояниеСотрудниковОрганизацийПередЗаписью КАК _СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись
			|			ПО _СостояниеСотрудниковОрганизацийПередЗаписью.Организация = _СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись.Организация
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник = _СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись.Сотрудник
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Состояние <> _СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись.Состояние
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Период < _СостояниеСотрудниковОрганизацийПередЗаписьюСледующаяЗапись.Период
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
			|			ПО _СостояниеСотрудниковОрганизацийПередЗаписью.Организация = СотрудникиОрганизации.Организация
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник = СотрудникиОрганизации.Сотрудник
			|				И _СостояниеСотрудниковОрганизацийПередЗаписью.Период >= СотрудникиОрганизации.Период
			|	ГДЕ
			|		_НаборНовыхЗаписей.Период ЕСТЬ NULL
			|	
			|	СГРУППИРОВАТЬ ПО
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Организация,
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Сотрудник,
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Период,
			|		_СостояниеСотрудниковОрганизацийПередЗаписью.Состояние) КАК ДанныеРегистра
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СправочникСотрудники
			|		ПО ДанныеРегистра.Сотрудник = СправочникСотрудники.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
			|		ПО ДанныеРегистра.Организация = СотрудникиОрганизации.Организация
			|			И ДанныеРегистра.Сотрудник = СотрудникиОрганизации.Сотрудник
			|			И ДанныеРегистра.ПериодСотрудникиОрганизации = СотрудникиОрганизации.Период
			|ГДЕ
			|	ДанныеРегистра.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.Работа)
			|	И ДанныеРегистра.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.РаботаВОтпускеПоУходуЗаРебенком)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДанныеОбОтсутствии.Организация КАК Организация,
			|	_ДанныеОбОтсутствии.ФизЛицо КАК ФизЛицо,
			|	МАКСИМУМ(_ДанныеОбОтсутствии.НоваяЗапись) КАК НоваяЗапись,
			|	МАКСИМУМ(_ДанныеОбОтсутствии.УдаленнаяЗапись) КАК УдаленнаяЗапись
			|ПОМЕСТИТЬ _Отборы
			|ИЗ
			|	_ДанныеОбОтсутствии КАК _ДанныеОбОтсутствии
			|
			|СГРУППИРОВАТЬ ПО
			|	_ДанныеОбОтсутствии.Организация,
			|	_ДанныеОбОтсутствии.ФизЛицо";

		Запрос.Выполнить();
		
		Отборы = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Отборы",,,, "Организация, ФизЛицо АВТОУПОРЯДОЧИВАНИЕ").Выгрузить();
		ДанныеОбОтсутствии	= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ДанныеОбОтсутствии").Выгрузить();
		
		Колонки = Новый Массив;
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Сотрудник", 	"Сотрудник"));
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Должность",		"Должность"));
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Подразделение",	"Подразделение"));
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Состояние", 	"Состояние"));
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "ДатаНачала", 	"Дата начала", "ДФ=dd.MM.yyyy"));
		Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "ДатаОкончания", "Дата окончания", "ДФ=dd.MM.yyyy"));
		
		Для Каждого Отбор Из Отборы Цикл
			
			ЭлементыОтчета = Новый Массив;
			ЭлементыОтчета.Добавить(Новый Структура("Тип, Значение", "Заголовок", "Данные об отсутствии сотрудника"));
			ЭлементыОтчета.Добавить(Новый Структура("Тип, Имя, Значение", "Параметр", "Организация", Отбор.Организация));
			ЭлементыОтчета.Добавить(Новый Структура("Тип, Имя, Значение", "Параметр", "Физ.лицо",	 Отбор.ФизЛицо));
			
			Если Отбор.НоваяЗапись Тогда
				ПараметрыПоиска = Новый Структура("Организация, ФизЛицо, НоваяЗапись", Отбор.Организация, Отбор.ФизЛицо, Истина);
				ЭлементыОтчета.Добавить(Новый Структура("Тип, Заголовок, Значение, Колонки", "ТаблицаЗначений", "Новые данные", ДанныеОбОтсутствии.Скопировать(ПараметрыПоиска), Колонки));
			КонецЕсли;
			
			Если Отбор.УдаленнаяЗапись Тогда
				ПараметрыПоиска = Новый Структура("Организация, ФизЛицо, НоваяЗапись", Отбор.Организация, Отбор.ФизЛицо, Ложь);
				ЭлементыОтчета.Добавить(Новый Структура("Тип, Заголовок, Значение, Колонки", "ТаблицаЗначений", "Отменённые данные", ДанныеОбОтсутствии.Скопировать(ПараметрыПоиска), Колонки));
			КонецЕсли;

			РеквизитыОповещения = Новый Структура;
			РеквизитыОповещения.Вставить("Организация", Отбор.Организация);
			РеквизитыОповещения.Вставить("ФизЛицо",		Отбор.ФизЛицо);
			РеквизитыОповещения.Вставить("Текст",		РаботаСОтчетами.СформироватьОтчетВHTML(ЭлементыОтчета));
			
			Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя() + "_ДанныеОбОтсутствии", Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
			
			РеквизитыОповещения = Неопределено;
			
		КонецЦикла;
#КонецОбласти	
	
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СтатусыМЧД") 
			 И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_СтатусыМЧДПередЗаписью") Тогда
		
		#Область Статусы_МЧД
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Источник.ЗаписьИсторииДанных.ДополнительныеДанные.МВТ_СтатусыМЧДПередЗаписью;
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Источник.Выгрузить(), "_НаборНовыхЗаписей", Запрос);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Доверенности.Организация КАК Организация,
			|	_НаборНовыхЗаписей.Доверенность КАК Доверенность,
			|	_НаборНовыхЗаписей.УстановленВручную КАК УстановленВручную,
			|	_НаборНовыхЗаписей.Комментарий КАК Комментарий,
			|	_СтатусыМЧДПередЗаписью.Статус КАК ПредыдущийСтатус,
			|	_НаборНовыхЗаписей.Статус КАК Статус,
			|	Доверенности.Доверитель КАК Доверитель,
			|	Доверенности.Номер КАК Номер,
			|	Доверенности.Дата КАК Дата,
			|	Доверенности.ИдентификаторДоверенности КАК ИдентификаторДоверенности,
			|	Доверенности.ИнформационнаяСистема КАК ИнформационнаяСистема,
			|	Доверенности.Поверенные.(
			|		Поверенный КАК Поверенный
			|	) КАК Поверенные
			|ИЗ
			|	_НаборНовыхЗаписей КАК _НаборНовыхЗаписей
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыМЧДПередЗаписью КАК _СтатусыМЧДПередЗаписью
			|		ПО _НаборНовыхЗаписей.Организация = _СтатусыМЧДПередЗаписью.Организация
			|			И _НаборНовыхЗаписей.Доверенность = _СтатусыМЧДПередЗаписью.Доверенность
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Доверенности КАК Доверенности
			|		ПО _НаборНовыхЗаписей.Доверенность = Доверенности.Ссылка
			|ГДЕ
			|	(_СтатусыМЧДПередЗаписью.Период ЕСТЬ NULL
			|			ИЛИ _НаборНовыхЗаписей.Статус <> _СтатусыМЧДПередЗаписью.Статус
			|				И _НаборНовыхЗаписей.Период > _СтатусыМЧДПередЗаписью.Период)
			|ИТОГИ ПО
			|	Организация";
		
		Результат = Запрос.Выполнить();
		ВыборкаОрганизация = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если Не Результат.Пустой() Тогда
		
			ТаблицаОтчета = Новый ТаблицаЗначений;
			ТаблицаОтчета.Колонки.Добавить("Доверитель", Новый ОписаниеТипов("Строка"));
			ТаблицаОтчета.Колонки.Добавить("Поверенный", Новый ОписаниеТипов("Строка"));
			ТаблицаОтчета.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
			ТаблицаОтчета.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
			ТаблицаОтчета.Колонки.Добавить("ИдентификаторДоверенности", Новый ОписаниеТипов("Строка"), "Идентификатор");
			ТаблицаОтчета.Колонки.Добавить("ИнформационнаяСистема", Новый ОписаниеТипов("Строка"), "Информационная система");
		
		КонецЕсли;
		
		Пока ВыборкаОрганизация.Следующий() Цикл
			
			РеквизитыОповещения = Новый Структура;
			РеквизитыОповещения.Вставить("Организация", ВыборкаОрганизация.Организация);
			
			ЭлементыОтчета = Новый Массив;
			
			Выборка = ВыборкаОрганизация.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Поверенные = Выборка.Поверенные.Выгрузить().ВыгрузитьКолонку(0);
				
				НоваяСтрока = ТаблицаОтчета.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Доверитель, Статус, ИдентификаторДоверенности, ИнформационнаяСистема");
				НоваяСтрока.Поверенный = СтрСоединить(Поверенные, Символы.ПС);
				НоваяСтрока.Номер = СтрШаблон("%1 от %2", Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
				
			КонецЦикла;
			
			ЭлементыОтчета.Добавить(Новый Структура("Тип, Заголовок, Значение", "ТаблицаЗначений", "Изменились статусы доверенностей", ТаблицаОтчета));
			
			РеквизитыОповещения.Вставить("Текст", РаботаСОтчетами.СформироватьОтчетВHTML(ЭлементыОтчета));
            
			Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя() + "_ИзменениеСтатусаМЧД", Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
			
			РеквизитыОповещения = Неопределено;
			ТаблицаОтчета.Очистить();
			
		КонецЦикла;	
		
		#КонецОбласти
		
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыФизическихЛицАнкетные")
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыСотрудниковОрганизации") Тогда
		
		Если НЕ Источник.ДополнительныеСвойства.УдалениеВСоставеИзмененияНабора И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("ПроверкаРеквизитовЛицПодлежащихСверкеСоСписками") Тогда
			Для Каждого СписокЛицПодлежащихСверкеСоСписками Из РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьСписокЛицПодлежащихСверкеСоСписками(Источник) Цикл
				РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомДисквалифицированныхЛиц(СписокЛицПодлежащихСверкеСоСписками.Организация, СписокЛицПодлежащихСверкеСоСписками.ПроверяемыеЛица, ТекущаяДата());
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РеквизитыОповещения <> Неопределено Тогда
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
	КонецЕсли;
	
КонецПроцедуры // ОповещенияПриЗаписиРегистровСведений

Процедура ОповещенияПриЗаписиСправочников(Источник, Отказ) Экспорт
	
	РеквизитыОповещения = Неопределено;
	
	ЭтоНовыйЭлемент = Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") И Источник.ДополнительныеСвойства.ЭтоНовый;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.СчетаДоверительногоУправления") Тогда
		Если ЭтоНовыйЭлемент Тогда
			
			РеквизитыОповещения = Новый Структура("Организация,ВидДоговораДоверительногоУправления,Наименование,НомерСчета,ДатаЗаключения,Агент");
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
			РеквизитыОповещения.Агент = Источник.АгентскийДоговор.Контрагент;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.БазовыеСтавкиОблигаций")
		И ЭтоНовыйЭлемент Тогда
		РеквизитыОповещения = Новый Структура("Наименование");
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.БанковскиеСчета") Тогда
		
		ЮрФизЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Организация, "ЮрФизЛицо");
		СчетПринадлежитОрганизации = (Источник.ЮрФизЛицо = ЮрФизЛицоОрганизации ИЛИ Источник.ЮрФизЛицо = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЮрФизЛицоОрганизации));
		
		РеквизитыОповещения = Новый Структура("СчетПринадлежитОрганизации, Организация, Наименование, НомерСчета, Валюта, Банк, ВидДоговора, ДатаДоговора, ДатаОткрытияРавнаДатеДоговора", СчетПринадлежитОрганизации);
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
		РеквизитыОповещения.Вставить("ДатаОткрытия", Формат(Источник.ДатаОткрытия, "ДФ=dd.MM.yyyy"));
		
		Если СчетПринадлежитОрганизации Тогда
			Если ЗначениеЗаполнено(Источник.ДоговорЦессии) Тогда
				Договор = Источник.ДоговорЦессии;
			Иначе 
				Договор = Источник.Договор;
			КонецЕсли;
			
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ДатаЗаключения, ВидДоговора");
			
			РеквизитыОповещения.Вставить("Договор",							Договор);
			РеквизитыОповещения.Вставить("ВидДоговора",						РеквизитыДоговора.ВидДоговора);
			РеквизитыОповещения.Вставить("ДатаДоговора",					Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("ДатаОткрытияРавнаДатеДоговора",	Источник.ДатаОткрытия = РеквизитыДоговора.ДатаЗаключения);
			РеквизитыОповещения.Вставить("ДатаЗакрытия",					Формат(Источник.ДатаЗакрытия, "ДФ=dd.MM.yyyy; ДП=-"));
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.Доверенности") Тогда
		
		РеквизитыОповещения = Новый Структура("Организация, Наименование, ВозрастПоследнейАнкетыВДнях, Доверитель, ВидДоверенности, Номер");
		
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
		РеквизитыОповещения.Вставить("ЭтоНовыйЭлемент",			?(ЭтоНовыйЭлемент, "Новый", "Изменен"));
		РеквизитыОповещения.Вставить("Дата",					Формат(Источник.Дата, "ДФ=dd.MM.yyyy"));
		РеквизитыОповещения.Вставить("ДатаНачалаДействия",		Формат(Источник.ДатаНачалаДействия, "ДФ=dd.MM.yyyy"));
		РеквизитыОповещения.Вставить("ДатаОкончанияДействия",	Формат(Источник.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy"));
		
		РеквизитыОповещения.Вставить("ДоверительЯвляетсяКлиентом",	Справочники.ЮрФизЛица.ЯвляетсяКлиентом(Источник.Доверитель, Источник.Организация, ТекущаяДата()));
		
		ЗаполнитьИзмененияРеквизитов(Источник, РеквизитыОповещения);
		
#Область АнкетыПоверенных

		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("Период",		 ТекущаяДата());
		Запрос.УстановитьПараметр("Организация", Источник.Организация);
		Запрос.УстановитьПараметр("Поверенные",	 Источник.Поверенные.ВыгрузитьКолонку("Поверенный"));
		
		Если Источник.ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитов") Тогда
			Запрос.УстановитьПараметр("ПоверенныеПроверенныеРанее", Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.Поверенные.Выгрузить().ВыгрузитьКолонку("Поверенный"));
		Иначе
			Запрос.УстановитьПараметр("ПоверенныеПроверенныеРанее",	Новый Массив); 
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЮрФизЛица.Ссылка КАК Поверенный,
			|	ЮрФизЛица.Ссылка В (&ПоверенныеПроверенныеРанее) КАК ПроверенРанее,
			|	РеквизитыЮрФизЛицАнкетныеСрезПоследних.Анкета ЕСТЬ НЕ NULL  КАК ЕстьАнкетаПоверенного,
			|	РеквизитыЮрФизЛицАнкетныеСрезПоследних.ДатаАнкеты КАК ДатаАнкетыПоверенного,
			|	РАЗНОСТЬДАТ(РеквизитыЮрФизЛицАнкетныеСрезПоследних.ДатаАнкеты, &Период, ДЕНЬ) КАК ВозрастАнкетыПоверенногоВДнях
			|ИЗ
			|	Справочник.ЮрФизЛица КАК ЮрФизЛица
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
			|			РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор КАК Анкета,
			|			РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК ДатаАнкеты
			|		ИЗ
			|			РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|					&Период,
			|					Организация = &Организация
			|						И ЮрФизЛицо В (&Поверенные)
			|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо,
			|			РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор,
			|			РеквизитыЮридическихЛицАнкетныеСрезПоследних.Период
			|		ИЗ
			|			РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|					&Период,
			|					Организация = &Организация
			|						И ЮрФизЛицо В (&Поверенные)
			|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних) КАК РеквизитыЮрФизЛицАнкетныеСрезПоследних
			|		ПО ЮрФизЛица.Ссылка = РеквизитыЮрФизЛицАнкетныеСрезПоследних.ЮрФизЛицо
			|ГДЕ
			|	ЮрФизЛица.Ссылка В(&Поверенные)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			РеквизитыОповещения.Вставить("Поверенный",				Выборка.Поверенный);
			РеквизитыОповещения.Вставить("ПроверенРанее",			Выборка.ПроверенРанее);
			РеквизитыОповещения.Вставить("ЕстьАнкетаПоверенного",	Выборка.ЕстьАнкетаПоверенного);
			РеквизитыОповещения.Вставить("ДатаАнкетыПоверенного",	Формат(Выборка.ДатаАнкетыПоверенного, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("ВозрастАнкетыПоверенногоВДнях", Выборка.ВозрастАнкетыПоверенногоВДнях);
			
			РеквизитыОповещения.Вставить("ПроверкаАнкетПоверенных",	
				ЭтоНовыйЭлемент 
				ИЛИ НЕ Выборка.ПроверенРанее
				ИЛИ (РеквизитыОповещения.Свойство("ИзменилсяРеквизитДоверитель") И РеквизитыОповещения.ИзменилсяРеквизитДоверитель));
			
			Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиСправочников, РеквизитыОповещения);
			
		КонецЦикла;
		
		РеквизитыОповещения.Вставить("ПроверкаАнкетПоверенных",	Ложь);
		
#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ДепозитарныеСчета") Тогда
		
		ЮрФизЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Организация, "ЮрФизЛицо");
		СчетПринадлежитОрганизации = (Источник.ВладелецСчета = ЮрФизЛицоОрганизации ИЛИ Источник.ВладелецСчета = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЮрФизЛицоОрганизации));
		
		РеквизитыОповещения = Новый Структура("СчетПринадлежитОрганизации, Организация, НомерСчета, Депозитарий", СчетПринадлежитОрганизации);
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
		РеквизитыОповещения.Вставить("ДатаОткрытия", Формат(Источник.ДатаОткрытия, "ДФ=dd.MM.yyyy"));
		РеквизитыОповещения.Вставить("ДатаЗакрытия", Формат(Источник.ДатаЗакрытия, "ДФ=dd.MM.yyyy; ДП=-"));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ДепозитныеВклады") Тогда
		
		Если НЕ ЭтоНовыйЭлемент И РаботаСоСправочниками.ИзмененыРеквизитыРеквизитыСправочника(Источник, "ДатаРегистрации,_НачальныйНоминал,ДатаНачалаНачисленияПроцентов",, Отказ) Тогда
			
			ТекущаяОрганизация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
			
			Если НЕ Отказ И Справочники.ДепозитныеВклады.БылиДвиженияПоДепозиту(Источник.Ссылка, ТекущаяОрганизация) Тогда
			
				РеквизитыОповещения = Новый Структура;
				РеквизитыОповещения.Вставить("Организация",								ТекущаяОрганизация);
				РеквизитыОповещения.Вставить("Депозит",									Источник.Ссылка);
				РеквизитыОповещения.Вставить("ДатаРегистрации", 						Источник.ДатаРегистрации);
				РеквизитыОповещения.Вставить("Номинал",									Источник._НачальныйНоминал);
				РеквизитыОповещения.Вставить("ДатаНачалаНачисленияПроцентов",			Источник.ДатаНачалаНачисленияПроцентов);
				
				Если Источник.ДатаРегистрации = Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.ДатаРегистрации Тогда
					РеквизитыОповещения.Вставить("ДатаРегистрацииСтарая",				"");
				Иначе
					РеквизитыОповещения.Вставить("ДатаРегистрацииСтарая",				Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.ДатаРегистрации);
				КонецЕсли;
				
				Если Источник._НачальныйНоминал = Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов._НачальныйНоминал Тогда
					РеквизитыОповещения.Вставить("НоминалСтарый",						"");
				Иначе
					РеквизитыОповещения.Вставить("НоминалСтарый",						Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов._НачальныйНоминал);
				КонецЕсли;
				
				Если Источник.ДатаНачалаНачисленияПроцентов = Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.ДатаНачалаНачисленияПроцентов Тогда
					РеквизитыОповещения.Вставить("ДатаНачалаНачисленияПроцентовСтарая",	"");
				Иначе
					РеквизитыОповещения.Вставить("ДатаНачалаНачисленияПроцентовСтарая",	Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.ДатаНачалаНачисленияПроцентов);
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если РеквизитыОповещения <> Неопределено Тогда
		
		РеквизитыОповещения.Вставить("ЭтоНовыйЭлемент",		?(ЭтоНовыйЭлемент, "Новый", "Изменен"));
		РеквизитыОповещения.Вставить("ТекущийПользователь", РаботаСПользователями.ТекущийПользователь());
		
		ЗаполнитьИзмененияРеквизитов(Источник, РеквизитыОповещения);
		
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиСправочников, РеквизитыОповещения);

	КонецЕсли;
	
КонецПроцедуры

Процедура ОповещенияПриОтменеПроведенияДокументов(Источник, Отказ) Экспорт
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;

	Если ДополнительныеСвойства.Свойство("ГрупповоеПроведение") И ДополнительныеСвойства.ГрупповоеПроведение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// заполним персонифицированные реквизиты, зависящие от вида обрабатываемого документа
	РеквизитыОповещения = Неопределено;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Оплата") Тогда
		
		РеквизитыОповещения = Новый Структура;
		
		СуммаОплаты = Источник.Основания.Итог("Сумма") + Источник.Основания.Итог("СуммаОплатыКупона");
		
		РеквизитыОповещения.Вставить("ВидЗадолженности"			, Источник.ВидЗадолженности);
		РеквизитыОповещения.Вставить("ВидЗадолженностиРодитель"	, Источник.ВидЗадолженности.Родитель);
		РеквизитыОповещения.Вставить("Сумма"					, СуммаОплаты);
		РеквизитыОповещения.Вставить("Валюта"					, Источник.ВалютаОплаты);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоручениеНаДвижениеЦенныхБумаг") Тогда
		
		РеквизитыОповещения = ПолучитьРеквизитыДляПоручений(Источник);
			
	КонецЕсли;

	// получим и обработаем оповещения
	Если РеквизитыОповещения <> Неопределено Тогда
		
		РеквизитыОповещения.Вставить("Источник", Источник);
		
		// дополним реквизиты оповещения общими свойствами
		РеквизитыОповещения.Вставить("Дата");
		РеквизитыОповещения.Вставить("Организация");
		РеквизитыОповещения.Вставить("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПустаяСсылка());
		РеквизитыОповещения.Вставить("Комментарий");
		
		Если Источник.Метаданные().Реквизиты.Найти("СчетДоверительногоУправления") <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник, "Дата, Организация, СчетДоверительногоУправления, Комментарий");
			
			// реквизиты счета д/у
			РеквизитыСчетаДоверительногоУправления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыОповещения.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления, НомерДоговора, ДатаЗаключения");
			
			РеквизитыОповещения.Вставить("ВидДоговораДоверительногоУправления",   РеквизитыСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления);
			РеквизитыОповещения.Вставить("НомерДоговораДоверительногоУправления", РеквизитыСчетаДоверительногоУправления.НомерДоговора);
			РеквизитыОповещения.Вставить("ДатаДоговораДоверительногоУправления",  Формат(РеквизитыСчетаДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy"));

		Иначе
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник, "Дата, Организация, Комментарий");
		КонецЕсли;
		
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриОтменеПроведенияДокумента, РеквизитыОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповещенияПриЗаписиДвиженийРегистровНакопления(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ОстаткиЦенныхБумаг") Тогда
				
		ПроверитьДвиженияПаевСобственногоПортфеляИСформироватьОповещение(Источник);
				                    
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Процедура УстановитьПрефиксНомераДокумента(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	Если ПустаяСтрока(Префикс) Тогда
		Если Источник.Метаданные().Нумератор = Метаданные.НумераторыДокументов.Автоматический Тогда
			Префикс = Источник.Организация.ПрефиксНумерации + "-50";
		ИначеЕсли Источник.Метаданные().Нумератор = Метаданные.НумераторыДокументов.СпециальныйВПределахДня Тогда
			Префикс = Источник.Организация.ПрефиксНумерации + "-" +  Формат(Источник.Дата, "ДФ=ггггММдд") + "-";
		Иначе
			Префикс = Источник.Организация.ПрефиксНумерации + "-00";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УстановитьПрефиксНомераДокумента

Процедура УстановитьПрефиксКодаСправочника(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	Если ПустаяСтрока(Префикс) Тогда
		Префикс = Источник.Организация.ПрефиксНумерации + "-0";
	КонецЕсли;
	
КонецПроцедуры // УстановитьПрефиксКодаСправочника

