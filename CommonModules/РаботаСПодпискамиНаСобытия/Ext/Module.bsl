#Область Оповещения_при_записи_задач

Процедура ОповещенияПриЗаписиЗадач(Источник, Отказ) Экспорт
	
	РеквизитыОповещения = Неопределено;
	
	ЭтоНовыйЭлемент = Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") И Источник.ДополнительныеСвойства.ЭтоНовый;
	
	Если ТипЗнч(Источник) = Тип("ЗадачаОбъект.ОшибкиРегламентыхЗаданий") Тогда
		
		РеквизитыОповещения = Новый Структура("Номер, Дата, Выполнена, ПометкаУдаления, Источник, ТекстЗадачи, ДатаВыполнения, Исполнитель, КомментарийКВыполнению");
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		ЗаменитьНомераЗадачНаСсылки(РеквизитыОповещения.КомментарийКВыполнению);
		
		Если ЗначениеЗаполнено(Источник.Пользователь) Тогда
			Пользователь = "Пользователь: " + Источник.Пользователь + "<br>";
		Иначе
			Пользователь = "";
		КонецЕсли; 
		
		РеквизитыОповещения.Вставить("Пользователь", Пользователь);
		РеквизитыОповещения.Вставить("ТекстЗадачи", "<pre>" + Источник.ТекстЗадачи + "</pre>");
		
		РеквизитыОповещения.Вставить("Ссылка",		  ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Источник));
		РеквизитыОповещения.Вставить("ПохожиеЗадачи", ПолучитьПохожиеЗадачи(Источник));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ЗадачаОбъект.ЗадачаИсполнителя") 		
		И (ТипЗнч(Источник.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ПоступлениеИПроверкаЗаявкиНаПриобретениеПаев")
			Или ТипЗнч(Источник.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ЗачислениеПаев")
			Или ТипЗнч(Источник.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ПогашениеПаев")
			Или ТипЗнч(Источник.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ОбменПаев")) Тогда
			
		Если ЭтоНовыйЭлемент	
			И Источник.ГруппаИсполнителей.Родитель <> ОбщегоНазначения.ПолучитьИменованныйОбъект("СистемныеПользователи") Тогда
			
			РеквизитыОповещения = Новый Структура("Наименование, Дата, Организация, Основание, ТекстЗадачи, Комментарий, ТочкаМаршрута, ГруппаИсполнителей, Выполнена");
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
			РеквизитыОповещения.Вставить("ДополнительныеПолучатели", Задачи.ЗадачаИсполнителя.ПолучитьЭлектронныеАдресаИсполнителейЗадачи(Источник, Отказ));	
			РеквизитыОповещения.Вставить("ЗадачаДляСистемногоПользователя", Ложь);
			
		Иначе
			
			РеквизитыОповещения = Новый Структура("Наименование, Дата, Организация, Основание, ГруппаИсполнителей, ТочкаМаршрута, Выполнена");
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
			РеквизитыОповещения.Вставить("ЗадачаДляСистемногоПользователя", Истина);
						
		КонецЕсли;
		
		ЗаявкаПайщика = ?(ТипЗнч(Источник.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ЗачислениеПаев"), 
								ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.БизнесПроцесс, "ЗаявкаПайщика"),
								Источник.Основание);
		РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
							ЗаявкаПайщика,
							"Пайщик, ПаевойИнвестиционныйФонд, ВидЗаявки");
							
		РеквизитыОповещения.Вставить("ЗаявкаПайщика",				ЗаявкаПайщика);
		РеквизитыОповещения.Вставить("Пайщик",						РеквизитыЗаявки.Пайщик);
		РеквизитыОповещения.Вставить("ПаевойИнвестиционныйФонд",	РеквизитыЗаявки.ПаевойИнвестиционныйФонд);
		РеквизитыОповещения.Вставить("ВидЗаявки",					РеквизитыЗаявки.ВидЗаявки);
			
		РеквизитыОповещения.Вставить("Ссылка", ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Источник.Ссылка));
		
		РеквизитыОповещения.Вставить("НомерООВП",	Источник.НомерОтчетаОВозможностиЗачисленияПаев);
		РеквизитыОповещения.Вставить("ОтветООВП",	Источник.ОтветОВозможностиЗачисленияПаев);
		РеквизитыОповещения.Вставить("ЕстьООВП",	ЗначениеЗаполнено(Источник.ОтветОВозможностиЗачисленияПаев));
		
		РеквизитыОповещения.Вставить("ЗадачаПоРозницеПИФ", Истина);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ЗадачаОбъект.ЗадачаИсполнителя") Тогда
		
		РеквизитыОповещения = Новый Структура("Номер, Наименование, Дата, ПометкаУдаления, ТочкаМаршрута, Выполнена, Организация, Основание, ДатаВыполнения, ТекстЗадачи, Комментарий, ГруппаИсполнителей, Исполнитель");
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
		РеквизитыОповещения.Вставить("Ссылка", ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Источник.Ссылка));
		РеквизитыОповещения.Вставить("ДополнительныеПолучатели", Задачи.ЗадачаИсполнителя.ПолучитьЭлектронныеАдресаИсполнителейЗадачи(Источник, Отказ));
		
		Если ТипЗнч(Источник.Основание) = Тип("ДокументСсылка.ОбучениеСотрудников") Тогда
			РеквизитыОповещения.Вставить("ВидПеречня", Источник.Основание.ВидПеречня);
		КонецЕсли;
		
		РеквизитыОповещения.Вставить("ЭтоНовыйЭлемент",	?(ЭтоНовыйЭлемент, "Новая", "Изменилась"));
		РеквизитыОповещения.Вставить("СрокИсполнения",	Формат(Источник.СрокИсполнения, "ДФ=dd.MM.yyyy"));
		
		РеквизитыОповещения.Вставить("ДатаЗадачиБольшеТекущейДаты", Источник.Дата > ТекущаяДата());
		РеквизитыОповещения.Вставить("ИзменилсяИсполнительИлиГруппаИсполнителей", ЭтоНовыйЭлемент);
		
		ЗаполнитьИзмененияРеквизитов(Источник, РеквизитыОповещения);
		
		Если Источник.ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитов") Тогда
			Если Источник.Исполнитель <> Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.Исполнитель
			 ИЛИ Источник.ГруппаИсполнителей <> Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов.ГруппаИсполнителей Тогда 
				РеквизитыОповещения.Вставить("ИзменилсяИсполнительИлиГруппаИсполнителей", Истина);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РеквизитыОповещения <> Неопределено Тогда
		
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиЗадачи, РеквизитыОповещения);
		
		// #ТехДолг
		// Это временное решение. После реализации механизма фиксации формирования и отправки / выгрузки отчетов, код можно удалить
		// Если ошибка содержит упоминание о формировании отчетности, уведомим бухгалтерию
		Если СтрНайти(Источник.ТекстЗадачи, "ВнешняяОбработка._ФормированиеОтчетности") Тогда
			Справочники.Оповещения.СформироватьОповещения("ОповещениеБухгалтерииОбОшибкахПриФормированииОтчетности", Перечисления.ТипыСобытий.ПриЗаписиЗадачи, РеквизитыОповещения);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры // ОповещенияПриЗаписиЗадач

Процедура ЗаменитьНомераЗадачНаСсылки(КомментарийКВыполнению)

	RegExp = Новый COMОбъект("VBScript.RegExp");
	
	RegExp.Global     = Истина;
	RegExp.IgnoreCase = Истина;
	RegExp.MultiLine  = Истина;

	RegExp.Pattern = "#\d{6}";
	Совпадения = RegExp.Execute(КомментарийКВыполнению);

	Ссылка = "<A href=""http://1f.g1.lan/MaintaskForm.aspx?TaskID=НомерЗадачи"">#НомерЗадачи</A>";
	Для Каждого Совпадение Из Совпадения Цикл	
		КомментарийКВыполнению = СтрЗаменить(КомментарийКВыполнению, Совпадение.Value, СтрЗаменить(Ссылка, "НомерЗадачи", Сред(Совпадение.Value, 2)));
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПохожиеЗадачи(Источник)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОшибкиРегламентыхЗаданий.Ссылка КАК Ссылка,
		|	ОшибкиРегламентыхЗаданий.ДатаВыполнения КАК ДатаВыполнения,
		|	ОшибкиРегламентыхЗаданий.Исполнитель КАК Исполнитель,
		|	ОшибкиРегламентыхЗаданий.КомментарийКВыполнению КАК КомментарийКВыполнению,
		|	ОшибкиРегламентыхЗаданий.Выполнена КАК Выполнена,
		|	ОшибкиРегламентыхЗаданий.Дата КАК Дата,
		|	ОшибкиРегламентыхЗаданий.Номер КАК Номер
		|ПОМЕСТИТЬ _ПохожиеЗадачи
		|ИЗ
		|	Задача.ОшибкиРегламентыхЗаданий КАК ОшибкиРегламентыхЗаданий
		|ГДЕ
		|	ОшибкиРегламентыхЗаданий.ТекстЗадачи ПОДОБНО &ТекстЗадачи + ""%"" СПЕЦСИМВОЛ ""/""
		|	И ОшибкиРегламентыхЗаданий.Ссылка <> &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПохожиеЗадачи.ВсегоПохожих КАК ВсегоПохожих,
		|	ПоследняяВыполненная.ДатаВыполнения КАК ДатаВыполнения,
		|	ПоследняяВыполненная.Исполнитель КАК Исполнитель,
		|	ПоследняяВыполненная.КомментарийКВыполнению КАК КомментарийКВыполнению,
		|	ЕСТЬNULL(Пользователи.АдресЭлектроннойПочты, """") КАК АдресЭлектроннойПочты,
		|	ПоследняяВыполненная.Ссылка КАК Ссылка,
		|	ПоследняяВыполненная.Дата КАК Дата,
		|	ПоследняяВыполненная.Номер КАК Номер
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПохожиеЗадачи.Ссылка) КАК ВсегоПохожих
		|	ИЗ
		|		_ПохожиеЗадачи КАК _ПохожиеЗадачи) КАК ПохожиеЗадачи
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			_ПохожиеЗадачи.ДатаВыполнения КАК ДатаВыполнения,
		|			_ПохожиеЗадачи.Исполнитель КАК Исполнитель,
		|			_ПохожиеЗадачи.КомментарийКВыполнению КАК КомментарийКВыполнению,
		|			_ПохожиеЗадачи.Ссылка КАК Ссылка,
		|			_ПохожиеЗадачи.Дата КАК Дата,
		|			_ПохожиеЗадачи.Номер КАК Номер
		|		ИЗ
		|			_ПохожиеЗадачи КАК _ПохожиеЗадачи
		|		ГДЕ
		|			_ПохожиеЗадачи.Выполнена
		|		
		|		УПОРЯДОЧИТЬ ПО
		|			ДатаВыполнения УБЫВ) КАК ПоследняяВыполненная
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО (ПоследняяВыполненная.Исполнитель = Пользователи.Ссылка)";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	ТекстЗадачи = Источник.ТекстЗадачи;
	СпецСимволы = Новый Массив;
	СпецСимволы.Добавить("[");
	СпецСимволы.Добавить("]");
	СпецСимволы.Добавить("%");
	СпецСимволы.Добавить("_");
	Для каждого СпецСимвол Из СпецСимволы Цикл
		ТекстЗадачи = СтрЗаменить(ТекстЗадачи, СпецСимвол, "/" + СпецСимвол);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ТекстЗадачи", Лев(ТекстЗадачи, 1000));
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Если Выборка.ВсегоПохожих > 0 Тогда
		
		Если Не Выборка.Исполнитель = Null Тогда
			
			ПохожиеЗадачи = "Параметры последней" 
				+ ?(Выборка.ВсегоПохожих > 1, " (из " + Выборка.ВсегоПохожих + ")", "") 
				+ " похожей ошибки " + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка) + Символы.ПС
				+ "Исполнитель: " + Выборка.Исполнитель + " (" + Выборка.АдресЭлектроннойПочты + ")" + Символы.ПС
				+ "Дата выполнения: " + Выборка.ДатаВыполнения + Символы.ПС
				+ "Комментарий к выполнению: " + Выборка.КомментарийКВыполнению;
				
			ЗаменитьНомераЗадачНаСсылки(ПохожиеЗадачи);
			
		Иначе
			
			ПохожиеЗадачи = "Похожих ошибок " + Символ(8211) + " " + Выборка.ВсегоПохожих + ", отработанные похожие ошибки отсутствуют";
						
		КонецЕсли; 		
		
	Иначе
		
		ПохожиеЗадачи = "Похожие ошибки не найдены";
		
	КонецЕсли;
	
	Возврат СтрЗаменить(ПохожиеЗадачи, Символы.ПС, "<br>");
	
КонецФункции

#КонецОбласти 

Процедура ОповещенияПриПроведенииДокументов(Источник, Отказ, РежимПроведения) Экспорт
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;
	
	Если ДополнительныеСвойства.Свойство("ГрупповоеПроведение") И ДополнительныеСвойства.ГрупповоеПроведение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНовыйДокумент		= ДополнительныеСвойства.Свойство("ЭтоНовый") И ДополнительныеСвойства.ЭтоНовый
			Или ДополнительныеСвойства.Свойство("ЗагрузкаБанковскойВыписки") И ДополнительныеСвойства.ЗагрузкаБанковскойВыписки;
			
	ЭтоПервыйВводАктивов 	= ДополнительныеСвойства.Свойство("ЭтоПервыйВводАктивов") И ДополнительныеСвойства.ЭтоПервыйВводАктивов;
	ЭтоПервоеПроведение		= (ЭтоНовыйДокумент
								ИЛИ ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитовШапки") 
									И ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.Свойство("Проведен") 
									И НЕ ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.Проведен);
									
	ИзмененныеРеквизиты = Новый Массив;
	
	// Оповестим о проведении документов после расторжения договора д/у
	Если Не ДополнительныеСвойства.Свойство("НеОповещатьПриПроведенииДокументаПослеРасторженияДоговора") Тогда
		ОповещенияПриПроведенииДокументовПослеРасторженияДоговора(Источник);
	КонецЕсли;
	
	// Заполним персонифицированные реквизиты, зависящие от вида обрабатываемого документа
	
	РеквизитыОповещения = Неопределено;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ВводДенежныхСредств")
			Или ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводДенежныхСредств")
	Тогда
	
		Если Не ЭтоНовыйДокумент
				И Не РаботаСДокументами.ИзмененыРеквизитыШапкиДокумента(Источник, "Дата, СчетДоверительногоУправления, Сумма")
				И Источник.РасчетныйСчет.Валюта = ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.РасчетныйСчет.Валюта
		Тогда
			Возврат;
		КонецЕсли;
		
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("ВидДвиженияДС"	, ?(ТипЗнч(Источник) = Тип("ДокументОбъект.ВводДенежныхСредств"), "ввод д/с", "вывод д/с"));
		РеквизитыОповещения.Вставить("Сумма"			, Источник.Сумма);
		РеквизитыОповещения.Вставить("Валюта"			, Источник.РасчетныйСчет.Валюта);
		
		РеквизитыСчета = Новый Структура("НомерСчета, Валюта, Банк, БанкДляРасчетов");
		ЗаполнитьЗначенияСвойств(РеквизитыСчета, Источник.РасчетныйСчет);		
		РеквизитыОповещения.Вставить("РасчетныйСчет"	, Справочники.БанковскиеСчета.СформироватьНаименование(РеквизитыСчета));
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ВводДенежныхСредств") Тогда
			РеквизитыКлиента = Справочники.СчетаДоверительногоУправления.ПолучитьРеквизитыКлиента(Источник.СчетДоверительногоУправления, Источник.Дата);
			РеквизитыОповещения.Вставить("Клиент", РеквизитыКлиента.ПолноеНаименование);
			РеквизитыОповещения.Вставить("ДополнительныеПолучатели", РеквизитыКлиента.АдресЭлектроннойПочты);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ВводКредитногоИнструмента")
			Или ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводКредитногоИнструмента")
	Тогда
		ЭтоДепозитныйВклад = ТипЗнч(Источник.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады");
		Если ЭтоДепозитныйВклад Тогда
			РеквизитыОповещения = Новый Структура("КредитныйИнструмент, СуммаПроцентов");
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
			
			РеквизитыОповещения.Вставить("ЭтоВводДепозитногоВклада"	, ?(ТипЗнч(Источник) = Тип("ДокументОбъект.ВводКредитногоИнструмента"), " ввод " + ?(ЭтоДепозитныйВклад,"депозитного вклада ", "займа "), " вывод "+?(ЭтоДепозитныйВклад,"депозитного вклада ", "займа ")) );
			РеквизитыОповещения.Вставить("Номинал"					, РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Источник.КредитныйИнструмент, Новый Граница(Источник.МоментВремени(), ВидГраницы.Включая)).Номинал);
			РеквизитыОповещения.Вставить("Валюта"					, Источник.КредитныйИнструмент.БанковскийСчет.Валюта);
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ВводЦенныхБумаг")
			Или ТипЗнч(Источник) = Тип("ДокументОбъект.ВыводЦенныхБумаг")
	Тогда
		ЭтоВводЦенныхБумаг = (ТипЗнч(Источник) = Тип("ДокументОбъект.ВводЦенныхБумаг"));		
		
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("ЭтоВводЦенныхБумаг"	, ?(ЭтоВводЦенныхБумаг, "ввод ц/б", "вывод ц/б"));
		РеквизитыОповещения.Вставить("Сумма"				, ?(ЭтоВводЦенныхБумаг, Источник.ЦенныеБумаги.Итог("Сумма"), Источник.ЦенныеБумаги.Итог("СуммаРынок")));		

	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РазмещениеКредитногоИнструмента")
		И ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса	// только при бэкофисном проведении
		И (ЭтоНовыйДокумент ИЛИ РаботаСДокументами.ИзмененыРеквизитыШапкиДокумента(Источник, "Дата, СчетДоверительногоУправления, КредитныйИнструмент, Сумма")) Тогда 
		
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("КредитныйИнструмент", Источник.КредитныйИнструмент);
		РеквизитыОповещения.Вставить("Сумма",				Источник.Сумма);
		РеквизитыОповещения.Вставить("Довнесение",			Источник.Довнесение);
		
		Если ЭтоНовыйДокумент ИЛИ Источник.СчетДоверительногоУправления = ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.СчетДоверительногоУправления Тогда
			РеквизитыОповещения.Вставить("СчетДоверительногоУправленияСтарый",	"");
		Иначе
			РеквизитыОповещения.Вставить("СчетДоверительногоУправленияСтарый",	ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.СчетДоверительногоУправления);
		КонецЕсли;
		Если ЭтоНовыйДокумент ИЛИ Источник.КредитныйИнструмент = ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.КредитныйИнструмент Тогда
			РеквизитыОповещения.Вставить("КредитныйИнструментСтарый",			"");
		Иначе
			РеквизитыОповещения.Вставить("КредитныйИнструментСтарый",			ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.КредитныйИнструмент);
		КонецЕсли;
		Если ЭтоНовыйДокумент ИЛИ Источник.Сумма = ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.Сумма Тогда
			РеквизитыОповещения.Вставить("СуммаСтарая",			"");
		Иначе
			РеквизитыОповещения.Вставить("СуммаСтарая",							ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.Сумма);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Оплата") Тогда
		
		РеквизитыОповещения = Новый Структура;
		
		СуммаОплаты = Источник.Основания.Итог("Сумма") + Источник.Основания.Итог("СуммаОплатыКупона");
		
		РеквизитыОповещения.Вставить("ВидЗадолженности"			, Источник.ВидЗадолженности);
		РеквизитыОповещения.Вставить("ВидЗадолженностиРодитель"	, Источник.ВидЗадолженности.Родитель);
		РеквизитыОповещения.Вставить("Сумма"					, СуммаОплаты);
		РеквизитыОповещения.Вставить("Валюта"					, Источник.ВалютаОплаты);
		РеквизитыОповещения.Вставить("Контрагент"				, Источник.Контрагент);
		РеквизитыОповещения.Вставить("ВидЮрФизЛица"				, Источник.Контрагент.ВидЮрФизЛица);
		РеквизитыОповещения.Вставить("ВидДвижения"				, Источник.ВидДвижения);
		
		Если Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции
			ИЛИ Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки
			ИЛИ Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия
			ИЛИ Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи Тогда
			
			//Определим задолженность.
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ВЫБОР
			|			КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Валюта = ОплатаОснования.Ссылка.ВалютаОплаты
			|				ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
			|			ИНАЧЕ (ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток) * КурсыВалют.Курс / КурсыВалют.Кратность / КурсыВалютОплаты.Курс * КурсыВалютОплаты.Кратность
			|		КОНЕЦ) КАК СуммаЗадолженности,
			|	СУММА(ОплатаОснования.СуммаОплаты + ОплатаОснования.СуммаОплатыКупона) КАК СуммаОплаты,
			|	НачислениеДивидендов.ЦеннаяБумага КАК ЦеннаяБумага,
			|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ КАК РезидентРФ
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			&Период,
			|			ВидЗадолженности = &ВидЗадолженности
			|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|				И Основание В
			|					(ВЫБРАТЬ
			|						Документ.Оплата.Основания.Основание
			|					ИЗ
			|						Документ.Оплата.Основания
			|					ГДЕ
			|						Документ.Оплата.Основания.Ссылка = &Оплата)) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Валюта = КурсыВалют.Валюта
			|			И (КурсыВалют.Период = &ПериодДень)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютОплаты
			|			ПО ОплатаОснования.Ссылка.ВалютаОплаты = КурсыВалютОплаты.Валюта
			|				И (КурсыВалютОплаты.Период = &ПериодДень)
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = ОплатаОснования.Основание
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеДивидендов КАК НачислениеДивидендов
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
			|			ПО (НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
			|				И (ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних КАК РеквизитыЮридическихЛицСрезПоследних
			|			ПО (ВЫБОР
			|					КОГДА НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|						ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
			|					КОГДА НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|						ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
			|					КОГДА НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|						ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
			|					КОГДА НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|						ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
			|					КОГДА НачислениеДивидендов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|						ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
			|				КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
			|				И (РеквизитыЮридическихЛицСрезПоследних.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = НачислениеДивидендов.Ссылка
			|ГДЕ
			|	ОплатаОснования.Ссылка = &Оплата
			|
			|СГРУППИРОВАТЬ ПО
			|	НачислениеДивидендов.ЦеннаяБумага,
			|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ";
			
			Запрос.УстановитьПараметр("ВидЗадолженности", Источник.ВидЗадолженности);
			Запрос.УстановитьПараметр("Оплата", Источник.Ссылка);
 			Запрос.УстановитьПараметр("Период", Новый Граница(Источник.МоментВремени(), ВидГраницы.Исключая)); 
			Запрос.УстановитьПараметр("ПериодДень", НачалоДня(Источник.Дата));
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда   
				Если МатематическиеФункции.МодульЧисла(Выборка.СуммаЗадолженности - Выборка.СуммаОплаты) <= 0.01 
					ИЛИ НЕ Выборка.РезидентРФ Тогда  
					РеквизитыОповещения.Вставить("ВажноДляНДФЛ", Истина);
				
				Текст = "УК: " + Источник.Организация + "
				|Документ: " + Источник + "
				|Клиент: " + Источник.СчетДоверительногоУправления + "
				|Сумма задолженности: " + Выборка.СуммаЗадолженности + "
				|Сумма оплаты:        " + Выборка.СуммаОплаты + "
				|Ценная бумага:       " + Выборка.ЦеннаяБумага + "
				|" + ?(Выборка.РезидентРФ, "", "Эмитент не является резидентом РФ.");

				РеквизитыОповещения.Вставить("Текст", Текст);
			КонецЕсли;
		КонецЕсли;
			
		КонецЕсли;	
		Если ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитовШапки") Тогда
			ПредОснования	= ДополнительныеСвойства.ПредЗначенияРеквизитовШапки.Основания.Выгрузить();
			ПредСуммаОплаты	= ПредОснования.Итог("Сумма") + ПредОснования.Итог("СуммаОплатыКупона");
			Если ПредСуммаОплаты <> СуммаОплаты Тогда
				СтруктураИзмененияРеквизита = Новый Структура;
				СтруктураИзмененияРеквизита.Вставить("Ключ"			, "Сумма");
				СтруктураИзмененияРеквизита.Вставить("Значение"		, СуммаОплаты);
				СтруктураИзмененияРеквизита.Вставить("ПредЗначение"	, ПредСуммаОплаты);
				ИзмененныеРеквизиты.Добавить(СтруктураИзмененияРеквизита);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.АнкетаФизическогоЛица") Тогда
		
		РеквизитыОповещения = Новый Структура(	
			"РезидентРФ,
			|НалоговыйРезидентИностранногоГосударства,
			|РезидентПо173ФЗ,
			|РаспространениеЗаконодательстваСША,
			|ИностранныйНалогоплательщик,
			|СогласиеНаПередачуИнформации,
			|ЮрФизЛицо,
			|ДатаСмерти");
		
		
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		
		
		РеквизитыОповещения.Вставить("ЕстьАдресФактическогоПроживанияВИностранномГосударстве"	, ЗначениеЗаполнено(Источник.АдресФактическогоПроживанияВИностранномГосударстве));
		РеквизитыОповещения.Вставить("ЕстьАдресПочтовыйВИностранномГосударстве"					, ЗначениеЗаполнено(Источник.АдресПочтовыйВИностранномГосударстве));
		РеквизитыОповещения.Вставить("ЕстьАдресДоВостребованияВИностранномГосударстве"			, ЗначениеЗаполнено(Источник.АдресДоВостребованияВИностранномГосударстве));
		
		РеквизитыОповещения.Вставить("ОписаниеНестандартныхДанных", Новый Массив);
		
		СтандартныеДанные = Новый ТаблицаЗначений;
		СтандартныеДанные.Колонки.Добавить("Значение"		, Новый ОписаниеТипов("Булево"));
		СтандартныеДанные.Колонки.Добавить("Ключ"			, Новый ОписаниеТипов("Строка"));
		СтандартныеДанные.Колонки.Добавить("Представление"	, Новый ОписаниеТипов("Строка"));
		
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Истина	, "РезидентРФ", "Являетесь ли Вы налоговым резидентом Российской Федерации?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "НалоговыйРезидентИностранногоГосударства", "Являетесь ли Вы налоговым резидентом иностранного государства?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Истина	, "РезидентПо173ФЗ", "Являетесь ли Вы резидентом в соответствии с Федеральным законом от 10 декабря 2003 года №173-ФЗ «О валютном регулировании и валютном контроле»? "));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "РаспространениеЗаконодательстваСША", "Являетесь ли Вы лицом, на которое распространяется законодательство США о налогообложении иностранных счетов (налогоплательщиком США)?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "ИностранныйНалогоплательщик", "Имеются ли иные основания для отнесения Вас к категории иностранных налогоплательщиков?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Истина	, "СогласиеНаПередачуИнформации", "Даете ли Вы согласие на передачу информации  о Вас, как о лице, на которое распространяется законодательство иностранного государства?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "ЕстьАдресФактическогоПроживанияВИностранномГосударстве", "Сведения о наличии адреса фактического проживания в иностранном государстве?"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "ЕстьАдресПочтовыйВИностранномГосударстве", "Имеется ли у Вас  почтовый адрес в иностранном государстве"));
		ЗаполнитьЗначенияСвойств(СтандартныеДанные.Добавить(), Новый Структура("Значение, Ключ, Представление", Ложь	, "ЕстьАдресДоВостребованияВИностранномГосударстве", "Имеется ли у Вас адрес до востребования в иностранном государстве?"));
		
		Для Каждого ЭлементСтандартныхДанных Из СтандартныеДанные Цикл
			Если ЭлементСтандартныхДанных.Значение <> РеквизитыОповещения[ЭлементСтандартныхДанных.Ключ] Тогда
				РеквизитыОповещения.ОписаниеНестандартныхДанных.Добавить(ЭлементСтандартныхДанных.Представление + " Ответ: " + РеквизитыОповещения[ЭлементСтандартныхДанных.Ключ]);
			КонецЕсли;
		КонецЦикла;
		
		РеквизитыОповещения.Вставить("НестандартныеДанные", РеквизитыОповещения.ОписаниеНестандартныхДанных.Количество() <> 0);
		РеквизитыОповещения.ОписаниеНестандартныхДанных = СтрСоединить(РеквизитыОповещения.ОписаниеНестандартныхДанных, "<p>" + Символы.ПС + "</p>");
		
		РеквизитыОповещения.Вставить("ЗагрузкаДанныхВАнкету", ДополнительныеСвойства.Свойство("ЗагрузкаДанныхВАнкету") И ДополнительныеСвойства.ЗагрузкаДанныхВАнкету);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ВходящийДокумент") И Источник.Статус = Перечисления.СтатусыВходящихДокументов.НаРегистрации Тогда
		РеквизитыОповещения = Новый Структура("Номер, Отправитель, НомерВходящегоДокумента");
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник);
		РеквизитыОповещения.Вставить("ДатаВходящегоДокумента", Формат(Источник.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"));
								
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоручениеНаДвижениеЦенныхБумаг") Тогда
		
		РеквизитыОповещения = ПолучитьРеквизитыДляПоручений(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.НачислениеЗадолженности") Тогда  
		
		РеквизитыОповещения = Новый Структура;
		
		Сумма = Источник.Основания.Итог("Сумма");
		
		РеквизитыОповещения.Вставить("ВидЗадолженности"			, Источник.ВидЗадолженности);
		РеквизитыОповещения.Вставить("Сумма"					, Сумма);
		РеквизитыОповещения.Вставить("Валюта"					, Источник.Валюта);
		РеквизитыОповещения.Вставить("Контрагент"				, Источник.Контрагент);
		РеквизитыОповещения.Вставить("ВидЮрФизЛица"				, Источник.Контрагент.ВидЮрФизЛица);
	КонецЕсли;
	
	// получим и обработаем оповещения
	
	Если РеквизитыОповещения <> Неопределено Тогда
		
		РеквизитыОповещения.Вставить("ЭтоНовыйДокумент"		, ?(ЭтоНовыйДокумент, "Новый", "Изменен"));
		РеквизитыОповещения.Вставить("ПервоеПроведение"		, ЭтоПервоеПроведение);
		РеквизитыОповещения.Вставить("ЭтоПервыйВводАктивов"	, ?(ЭтоПервыйВводАктивов, "Первый ввод активов", ""));
		РеквизитыОповещения.Вставить("Источник", Источник);
		
		//Изменение значений реквизитов шапки
		Если ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитовШапки") Тогда
			Для Каждого Реквизит Из ДополнительныеСвойства.ПредЗначенияРеквизитовШапки Цикл
				Если ТипЗнч(Реквизит.Значение) <> Тип("РезультатЗапроса") Тогда //Табличная часть
					Если Источник[Реквизит.Ключ] <> Реквизит.Значение Тогда
						СтруктураИзмененияРеквизита = Новый Структура;
						СтруктураИзмененияРеквизита.Вставить("Ключ"			, Реквизит.Ключ);
						СтруктураИзмененияРеквизита.Вставить("Значение"		, Источник[Реквизит.Ключ]);
						СтруктураИзмененияРеквизита.Вставить("ПредЗначение"	, Реквизит.Значение);
						ИзмененныеРеквизиты.Добавить(СтруктураИзмененияРеквизита);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		РеквизитыОповещения.Вставить("ИзмененныеРеквизиты", ИзмененныеРеквизиты);
		
		// дополним реквизиты оповещения общими свойствами
		РеквизитыОповещения.Вставить("Дата");
		РеквизитыОповещения.Вставить("Организация");
		РеквизитыОповещения.Вставить("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПустаяСсылка());
		РеквизитыОповещения.Вставить("Комментарий");
		
		Если Источник.Метаданные().Реквизиты.Найти("СчетДоверительногоУправления") <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник, "Дата, Организация, СчетДоверительногоУправления, Комментарий");
			
			// агентская схема
			АгентскийДоговор = РеквизитыОповещения.СчетДоверительногоУправления.АгентскийДоговор;
			
			РеквизитыОповещения.Вставить("АгентскийДоговор", АгентскийДоговор);
			РеквизитыОповещения.Вставить("Агент", ?(ЗначениеЗаполнено(АгентскийДоговор.Контрагент), АгентскийДоговор.Контрагент, "без агента"));
			
			// реквизиты счета д/у
			РеквизитыСчетаДоверительногоУправления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыОповещения.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления, НомерДоговора, ДатаЗаключения");
			
			РеквизитыОповещения.Вставить("ВидДоговораДоверительногоУправления",   РеквизитыСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления);
			РеквизитыОповещения.Вставить("НомерДоговораДоверительногоУправления", РеквизитыСчетаДоверительногоУправления.НомерДоговора);
			РеквизитыОповещения.Вставить("ДатаДоговораДоверительногоУправления",  Формат(РеквизитыСчетаДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy"));

		Иначе
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник, "Дата, Организация, Комментарий");
		КонецЕсли;
		
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриПроведенииДокумента, РеквизитыОповещения);
		
	КонецЕсли;

КонецПроцедуры // ОповещенияПриПроведенииДокументов

Процедура ОповещенияПриЗаписиДокументов(Источник, Отказ) Экспорт
	
	Если Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	#Область Оповещение_о_некорректном_времени_документа
	
	// Проверяем документы бэк-офиса, кроме корректировок регистров.
	// Время документов должно быть в диапазоне рабочих часов.
	// Если не так, формируем оповещение
	
	РабочееВремя = РаботаСДокументами.ПериодРабочегоВремениДня();
	
	НачалоДняДокумента = НачалоДня(Источник.Дата);
	
	// Время в рабочих границах, не нужно проверять
	Если Источник.Дата >= НачалоДняДокумента + РабочееВремя.ВремяНачала
		И Источник.Дата <= НачалоДняДокумента + РабочееВремя.ВремяОкончания Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВидовДокументовБэкОфиса = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыОперацийБэкОфиса");
	СтруктураВидовДокументовБэкОфиса.Удалить("КорректировкаРегистров");
	
	ИмяДокумента = Источник.Метаданные().Имя;
	
	// Проверяем, что это документ бэк-офиса, тогда формируем оповещение
	Если СтруктураВидовДокументовБэкОфиса.Свойство(ИмяДокумента) Тогда
			
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("Тема"	, 		"Неверное время документа");
		РеквизитыОповещения.Вставить("Текст", 		СтрШаблон("Время '%1' документа '%2' за пределами рабочих часов", Формат(Источник.Дата, "ДЛФ=T"), СокрЛП(Источник)));
		РеквизитыОповещения.Вставить("Организация", Источник.Организация);
		
		Справочники.Оповещения.СформироватьОповещения("Документ", Перечисления.ТипыСобытий.ПриЗаписиДокумента, РеквизитыОповещения);
		
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры // ОповещенияПриЗаписиДокументов

Процедура ОповещенияПриПроведенииДокументовПослеРасторженияДоговора(Источник)
	
	Если Источник.Метаданные().Реквизиты.Найти("СчетДоверительногоУправления") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыСчетаДУ = Кэширование.РеквизитыСчетаДоверительногоУправления(Источник.СчетДоверительногоУправления);
	
	Если ЗначениеЗаполнено(РеквизитыСчетаДУ.ДатаРасторжения) И РеквизитыСчетаДУ.ДатаРасторжения < НачалоДня(Источник.Дата) Тогда
		
		РеквизитыОповещения = Новый Структура("Источник, Дата, Организация, СчетДоверительногоУправления, ДатаРасторжения", Источник);
		
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Источник,			"Дата, Организация, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(РеквизитыОповещения, РеквизитыСчетаДУ, "ДатаРасторжения");
		
		Справочники.Оповещения.СформироватьОповещения(
			"РаботаСПодпискамиНаСобытия.ОповещенияПриПроведенииДокументовПослеРасторженияДоговора", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповещенияПриЗаписиРегистровСведений(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.Количество() = 0
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.ДоговорыСчетовДоверительногоУправления") 
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.ЛицензииДоговоровДоверительногоУправления")
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.ДокументыЮридическихЛиц")
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.ВхожденияВРеестры") 
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛиц") 
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛицАнкетные") 
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.РеквизитыФизическихЛицАнкетные") 
		И ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.РеквизитыСотрудниковОрганизации") Тогда // запись пустого набора
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;
	
	Если ДополнительныеСвойства.Свойство("ГрупповоеПроведение") И ДополнительныеСвойства.ГрупповоеПроведение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Неопределено;
	
	// Получим и обработаем оповещения
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.КодыСчетовДоверительногоУправленияУБрокеров") Тогда
		
		#Область КодыСчетовДоверительногоУправленияУБрокеров
		
		Если Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("КодыУБрокераПередЗаписью") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НаборЗаписей.Период КАК Период,
				|	НаборЗаписей.Организация КАК Организация,
				|	НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	НаборЗаписей.Брокер КАК Брокер,
				|	НаборЗаписей.Код КАК Код,
				|	НаборЗаписей.КодFORTS КАК КодFORTS
				|ПОМЕСТИТЬ _НаборЗаписей
				|ИЗ
				|	&НаборЗаписей КАК НаборЗаписей
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КодыУБрокераПередЗаписью.Период КАК Период,
				|	КодыУБрокераПередЗаписью.Организация КАК Организация,
				|	КодыУБрокераПередЗаписью.Брокер КАК Брокер,
				|	КодыУБрокераПередЗаписью.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	КодыУБрокераПередЗаписью.Код КАК Код,
				|	КодыУБрокераПередЗаписью.КодFORTS КАК КодFORTS
				|ПОМЕСТИТЬ _КодыУБрокераПередЗаписью
				|ИЗ
				|	&КодыУБрокераПередЗаписью КАК КодыУБрокераПередЗаписью
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(_НаборЗаписей.Период, _КодыУБрокераПередЗаписью.Период) КАК Период,
				|	ЕСТЬNULL(_НаборЗаписей.Организация, _КодыУБрокераПередЗаписью.Организация) КАК Организация,
				|	ЕСТЬNULL(_НаборЗаписей.СчетДоверительногоУправления, _КодыУБрокераПередЗаписью.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
				|	ЕСТЬNULL(_НаборЗаписей.Брокер, _КодыУБрокераПередЗаписью.Брокер) КАК Брокер,
				|	ЕСТЬNULL(_НаборЗаписей.Код, """") КАК Код,
				|	ЕСТЬNULL(_КодыУБрокераПередЗаписью.Код, """") КАК КодПередЗаписью,
				|	ЕСТЬNULL(_НаборЗаписей.КодFORTS, """") КАК КодFORTS,
				|	ЕСТЬNULL(_КодыУБрокераПередЗаписью.КодFORTS, """") КАК КодFORTSПередЗаписью,
				|	ВЫБОР
				|		КОГДА _КодыУБрокераПередЗаписью.Код ЕСТЬ NULL
				|			ТОГДА 1
				|		КОГДА _НаборЗаписей.Код ЕСТЬ NULL
				|			ТОГДА 3
				|		ИНАЧЕ 2
				|	КОНЕЦ КАК ВидИзменения
				|ИЗ
				|	_НаборЗаписей КАК _НаборЗаписей
				|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыУБрокераПередЗаписью КАК _КодыУБрокераПередЗаписью
				|		ПО _НаборЗаписей.Период = _КодыУБрокераПередЗаписью.Период
				|			И _НаборЗаписей.Организация = _КодыУБрокераПередЗаписью.Организация
				|			И _НаборЗаписей.СчетДоверительногоУправления = _КодыУБрокераПередЗаписью.СчетДоверительногоУправления
				|			И _НаборЗаписей.Брокер = _КодыУБрокераПередЗаписью.Брокер
				|ГДЕ
				|	(ЕСТЬNULL(_НаборЗаписей.Код, """") <> ЕСТЬNULL(_КодыУБрокераПередЗаписью.Код, """")
				|			ИЛИ ЕСТЬNULL(_НаборЗаписей.КодFORTS, """") <> ЕСТЬNULL(_КодыУБрокераПередЗаписью.КодFORTS, """"))
				|ИТОГИ ПО
				|	Организация";
			
			Запрос.УстановитьПараметр("НаборЗаписей"            , Источник.Выгрузить());
			Запрос.УстановитьПараметр("КодыУБрокераПередЗаписью", Источник.ЗаписьИсторииДанных.ДополнительныеДанные.КодыУБрокераПередЗаписью);
							
			ВыборкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоОрганизации.Следующий() Цикл
				
				СтрокиОповещения = Новый Массив;
				
				Выборка = ВыборкаПоОрганизации.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ОписаниеИзменений = "";
					Если      Выборка.ВидИзменения = 1 Тогда
						ОписаниеИзменений = "добавлен новый код """ + Выборка.Код + """, код FORTS """ + Выборка.КодFORTS + """";
					ИначеЕсли Выборка.ВидИзменения = 3 Тогда
						// отловить удаление записей из формы списка здесь не получится, но по задаче это и не требуется
						ОписаниеИзменений = "удален код """ + Выборка.Код + """, код FORTS """ + Выборка.КодFORTS + """";
					ИначеЕсли Выборка.ВидИзменения = 2 Тогда
						Если Выборка.КодПередЗаписью <> Выборка.Код Тогда
							ОписаниеИзменений = "код """ + Выборка.КодПередЗаписью + """ изменен на """ + Выборка.Код + """";
						КонецЕсли;
						Если Выборка.КодFORTSПередЗаписью <> Выборка.КодFORTS Тогда
							ОписаниеИзменений = ОписаниеИзменений + ?(ПустаяСтрока(ОписаниеИзменений), "код", " и код")
								+ " FORTS """ + Выборка.КодFORTSПередЗаписью + """ изменен на """ + Выборка.КодFORTS + """";
						КонецЕсли;
					Иначе
						ВызватьИсключение "Не удалось определить вид изменения кода счета д/у у брокера";
					КонецЕсли;
					
					СтрокиОповещения.Добавить(
						СтрШаблон("По клиенту %1 (%2) по брокеру %3 на дату %4 ",
							Выборка.СчетДоверительногоУправления,
							Выборка.Организация,
							Выборка.Брокер,
							Формат(Выборка.Период, "ДФ=dd.MM.yyyy")
						) + ОписаниеИзменений
					);
					
				КонецЦикла;
				
				Справочники.Оповещения.СформироватьОповещения(
					Источник.Метаданные().ПолноеИмя(),
					Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений,
					Новый Структура("Организация, Текст", ВыборкаПоОрганизации.Организация, СтрСоединить(СтрокиОповещения, Символы.ПС))
				);
	
			КонецЦикла;
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ЖурналСверкиСоСписками") Тогда
		
		#Область ЖурналСверкиСоСписками
		
		ЭтоПроверкаСМЭВ = Источник.Отбор.ВидПеречня.Значение = Справочники.ВидыПеречнейОбъектов.СМЭВ;
		// нас интересуют только не прошедшие проверку
		Если ЭтоПроверкаСМЭВ Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("НаборЗаписей", Источник.Выгрузить());
			#Область ТекстЗапроса
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НаборЗаписей.Период КАК Период,
				|	НаборЗаписей.Организация КАК Организация,
				|	НаборЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
				|	НаборЗаписей.ВидПеречня КАК ВидПеречня,
				|	НаборЗаписей.Пройдена КАК Пройдена,
				|	НаборЗаписей.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
				|	НаборЗаписей.Ответственный КАК Ответственный,
				|	НаборЗаписей.ИдентификаторПакета КАК ИдентификаторПакета,
				|	НаборЗаписей.Статус КАК Статус,
				|	НаборЗаписей.РеквизитыСверки КАК РеквизитыСверки,
				|	ВЫРАЗИТЬ(НаборЗаписей.Комментарий КАК СТРОКА(1024)) КАК Комментарий
				|ПОМЕСТИТЬ _НаборЗаписей
				|ИЗ
				|	&НаборЗаписей КАК НаборЗаписей
				|ГДЕ
				|	НаборЗаписей.Пройдена
				|	И НаборЗаписей.Статус <> ""VALID""
				|	И НаборЗаписей.ИдентификаторПакета <> """"
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_НаборЗаписей.Период КАК Период,
				|	_НаборЗаписей.Организация КАК Организация,
				|	_НаборЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
				|	_НаборЗаписей.ВидПеречня КАК ВидПеречня,
				|	_НаборЗаписей.Пройдена КАК Пройдена,
				|	_НаборЗаписей.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
				|	_НаборЗаписей.Ответственный КАК Ответственный,
				|	_НаборЗаписей.ИдентификаторПакета КАК ИдентификаторПакета,
				|	_НаборЗаписей.Статус КАК Статус,
				|	_НаборЗаписей.Комментарий КАК Комментарий,
				|	АнкетаЮридическогоЛица.ЮрФизЛицо КАК Представитель,
				|	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ВидУчастника КАК ВидУчастника
				|ПОМЕСТИТЬ _ПредставителиВыгодоприобретатели
				|ИЗ
				|	_НаборЗаписей КАК _НаборЗаписей
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаЮридическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаЮридическогоЛица КАК АнкетаЮридическогоЛица
				|			ПО АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка = АнкетаЮридическогоЛица.Ссылка
				|		ПО _НаборЗаписей.ЮрФизЛицо = АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НаборЗаписей.Период КАК Период,
				|	НаборЗаписей.Организация КАК Организация,
				|	НаборЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
				|	НаборЗаписей.ВидПеречня КАК ВидПеречня,
				|	НаборЗаписей.Пройдена КАК Пройдена,
				|	НаборЗаписей.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
				|	НаборЗаписей.Ответственный КАК Ответственный,
				|	НаборЗаписей.ИдентификаторПакета КАК ИдентификаторПакета,
				|	НаборЗаписей.Статус КАК Статус,
				|	_НаборЗаписей.РеквизитыСверки КАК РеквизитыСверки,
				|	НаборЗаписей.Комментарий КАК Комментарий,
				|	НаборЗаписей.Представитель КАК Представитель,
				|	НаборЗаписей.ВидУчастника КАК ВидУчастника
				|ИЗ
				|	(ВЫБРАТЬ
				|		_ПредставителиВыгодоприобретатели.Период КАК Период,
				|		_ПредставителиВыгодоприобретатели.Организация КАК Организация,
				|		_ПредставителиВыгодоприобретатели.ЮрФизЛицо КАК ЮрФизЛицо,
				|		_ПредставителиВыгодоприобретатели.ВидПеречня КАК ВидПеречня,
				|		_ПредставителиВыгодоприобретатели.Пройдена КАК Пройдена,
				|		_ПредставителиВыгодоприобретатели.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
				|		_ПредставителиВыгодоприобретатели.Ответственный КАК Ответственный,
				|		_ПредставителиВыгодоприобретатели.ИдентификаторПакета КАК ИдентификаторПакета,
				|		_ПредставителиВыгодоприобретатели.Статус КАК Статус,
				|		_ПредставителиВыгодоприобретатели.Комментарий КАК Комментарий,
				|		_ПредставителиВыгодоприобретатели.Представитель КАК Представитель,
				|		_ПредставителиВыгодоприобретатели.ВидУчастника КАК ВидУчастника
				|	ИЗ
				|		_ПредставителиВыгодоприобретатели КАК _ПредставителиВыгодоприобретатели
				|	
				|	ОБЪЕДИНИТЬ ВСЕ
				|	
				|	ВЫБРАТЬ
				|		_НаборЗаписей.Период,
				|		_НаборЗаписей.Организация,
				|		_НаборЗаписей.ЮрФизЛицо,
				|		_НаборЗаписей.ВидПеречня,
				|		_НаборЗаписей.Пройдена,
				|		_НаборЗаписей.ДатаПоследнейСверки,
				|		_НаборЗаписей.Ответственный,
				|		_НаборЗаписей.ИдентификаторПакета,
				|		_НаборЗаписей.Статус,
				|		_НаборЗаписей.Комментарий,
				|		НЕОПРЕДЕЛЕНО,
				|		НЕОПРЕДЕЛЕНО
				|	ИЗ
				|		_НаборЗаписей КАК _НаборЗаписей
				|			ЛЕВОЕ СОЕДИНЕНИЕ _ПредставителиВыгодоприобретатели КАК _ПредставителиВыгодоприобретатели
				|			ПО _НаборЗаписей.ЮрФизЛицо = _ПредставителиВыгодоприобретатели.ЮрФизЛицо
				|	ГДЕ
				|		_ПредставителиВыгодоприобретатели.ЮрФизЛицо ЕСТЬ NULL) КАК НаборЗаписей
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НаборЗаписей КАК _НаборЗаписей
				|		ПО (_НаборЗаписей.Период = НаборЗаписей.Период)
				|			И (_НаборЗаписей.ЮрФизЛицо = НаборЗаписей.ЮрФизЛицо)
				|			И (_НаборЗаписей.ВидПеречня = НаборЗаписей.ВидПеречня)
				|			И (_НаборЗаписей.Организация = НаборЗаписей.Организация)";	
			#КонецОбласти 
			
			НепрошедшиеПроверку = Запрос.Выполнить().Выгрузить();
			СоставРеквизитов = "ЮрФизЛицо, ВидПеречня, Пройдена, ДатаПоследнейСверки, Ответственный, Комментарий, Статус, ДополнительнаяИнформация, Организация";
			
		Иначе
			
			НепрошедшиеПроверку = Источник.Выгрузить().Скопировать(Новый Структура("Пройдена", Ложь));
			СоставРеквизитов = "ЮрФизЛицо, ВидПеречня, Пройдена, ДатаПоследнейСверки, Ответственный, Комментарий, Организация";
		
		КонецЕсли;
		
		Если НепрошедшиеПроверку.Количество() > 0  Тогда
			
			РеквизитыОповещения = Новый Структура(СоставРеквизитов);
			РеквизитыОповещения.Вставить("ПриИзмененииАнкеты",	ДополнительныеСвойства.Свойство("ЮрФизЛицоПриИзмененииАнкеты"));
			РеквизитыОповещения.Вставить("ПриПорученииНаВывод", ДополнительныеСвойства.Свойство("ПриПорученииНаВывод"));
			РеквизитыОповещения.Вставить("ВидПеречня", 			Источник.Отбор.ВидПеречня);
			
			Для Каждого НепрошедшийПроверку Из НепрошедшиеПроверку Цикл
				
				ЗаполнитьЗначенияСвойств(РеквизитыОповещения, НепрошедшийПроверку);
				Если ЭтоПроверкаСМЭВ Тогда
					
					Если ЗначениеЗаполнено(НепрошедшийПроверку.Представитель) Тогда
						РеквизитыОповещения.ДополнительнаяИнформация = " " + НепрошедшийПроверку.ВидУчастника + " " + НепрошедшийПроверку.Представитель;
					Иначе 
						РеквизитыОповещения.ДополнительнаяИнформация = "";
					КонецЕсли;
					
					РеквизитыОповещения.Комментарий = СокрЛП(РеквизитыОповещения.Комментарий);
					
				КонецЕсли; 
				
				Если ТипЗнч(НепрошедшийПроверку.РеквизитыСверки) = Тип("ХранилищеЗначения") Тогда
					РеквизитыСверки = НепрошедшийПроверку.РеквизитыСверки.Получить();
					Если ТипЗнч(РеквизитыСверки) = Тип("Структура") Тогда
						Для Каждого РеквизитСверки Из РеквизитыСверки Цикл
							РеквизитыОповещения.Вставить(РеквизитСверки.Ключ, РеквизитСверки.Значение);
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);		
				
			КонецЦикла;
			
			РеквизитыОповещения = Неопределено;
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.СтатусыПорученийНаПереводДенежныхСредств") Тогда

		#Область СтатусыПорученийНаПереводДенежныхСредств

		Если Источник[0].Статус = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте Тогда
		
			Реквизиты_НТП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник[0].ПоручениеНаПереводДенежныхСредств, "Ссылка, Организация, Брокер, СчетДоверительногоУправления, Сумма, Валюта");
			
			РеквизитыОповещения = Новый Структура("Поручение, Сумма, Валюта, СчетДоверительногоУправления, ТекстСообщения",
														Реквизиты_НТП.Ссылка,
														Реквизиты_НТП.Сумма,
														Реквизиты_НТП.Валюта,
														Реквизиты_НТП.СчетДоверительногоУправления,
														Источник[0].Комментарий);
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.КодFORTS КАК КодFORTS
				|ИЗ
				|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
				|			&Период,
				|			Организация = &Организация
				|				И Брокер = &Брокер
				|				И СчетДоверительногоУправления = &СчетДу) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";
			
			Запрос.УстановитьПараметр("Организация", Реквизиты_НТП.Организация);
			Запрос.УстановитьПараметр("Брокер"     , Реквизиты_НТП.Брокер);
			Запрос.УстановитьПараметр("СчетДу"     , Реквизиты_НТП.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Период"     , ТекущаяДатаСеанса());
			
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			Если РезультатЗапроса.Количество() = 1 Тогда
				РеквизитыОповещения.Вставить("КодУБрокера", РезультатЗапроса[0].Код);
				РеквизитыОповещения.Вставить("КодFORTS"   , РезультатЗапроса[0].КодFORTS);
			КонецЕсли;
		
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДоговорыСчетовДоверительногоУправления")
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ЛицензииДоговоровДоверительногоУправления")
	Тогда
	
		#Область ДоговорыСчетовДоверительногоУправления_ЛицензииДоговоровДоверительногоУправления
	
		Если НЕ Источник.ДополнительныеСвойства.УдалениеВСоставеИзмененияНабора Тогда
			ПредыдущаяАктивностьДоговоровПоВидамДеятельности = Источник.ЗаписьИсторииДанных.ДополнительныеДанные.ПредыдущаяАктивностьДоговоровПоВидамДеятельности;
			Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Удалить("ПредыдущаяАктивностьДоговоровПоВидамДеятельности");
			ИзмененияВАктивностиДоговоровПоВидамДеятельности = РегистрыСведений.ДоговорыСчетовДоверительногоУправления.ПолучитьИзмененияВАктивностиДоговоровПоВидамДеятельности(Источник.Отбор, ПредыдущаяАктивностьДоговоровПоВидамДеятельности);
			
			СтруктураПараметров = 
				"Период,
				|Организация,
				|СчетДоверительногоУправления,
				|ВидДоговораДУ,
				|Договор,
				|ВидДоговора,
				|НомерДоговора,
				|Контрагент,
				|ВидДеятельности,
				|НоваяСвязь,
				|Стратегия,
				|НаименованиеЦелевогоКапитала";
			
			ГруппыПараметров = ИзмененияВАктивностиДоговоровПоВидамДеятельности.Скопировать(, СтруктураПараметров);
			ГруппыПараметров.Свернуть(СтруктураПараметров);

			Для Каждого ГруппаПараметров Из ГруппыПараметров Цикл
				
				РеквизитыОповещения = Новый Структура(СтруктураПараметров);
				ЗаполнитьЗначенияСвойств(РеквизитыОповещения, ГруппаПараметров);
				НайденныеСтроки = ИзмененияВАктивностиДоговоровПоВидамДеятельности.НайтиСтроки(РеквизитыОповещения);
				МассивСтрокТекстаОповещения = Новый Массив;
				
				Для Каждого СтрокаИзменения Из НайденныеСтроки Цикл
					
					ЭтоИИС = СтрокаИзменения.ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет;
					ЭтоЦК = СтрокаИзменения.ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов;
					ВидДоговораРодП = НРег(ПолучитьСклоненияСтроки(СтрокаИзменения.ВидДоговора, , "ПД=Родительный")[0]);
					
					РеквизитыОповещения.Вставить("ТипОперации", ?(СтрокаИзменения.НоваяСвязь, "Заключение ", "Закрытие "));
					РеквизитыОповещения.Вставить("ВидОперации", ?(ЭтоИИС, "портфеля по брокеру", ВидДоговораРодП));
					РеквизитыОповещения.Вставить("ВидДоговора", "Договор " + ВидДоговораРодП);
					РеквизитыОповещения.Вставить("ДатаОткрытияЗакрытия", ?(СтрокаИзменения.НоваяСвязь, "Дата открытия", "Дата закрытия"));
					РеквизитыОповещения.Вставить("Период", Формат(СтрокаИзменения.Период, "ДЛФ=Д"));
					
					Если ЭтоИИС И ЗначениеЗаполнено(СтрокаИзменения.Стратегия) Тогда
						
						//Если клиент имеет индивидуальный инвестиционный счет, то в дополнение к наименованию клиента прибавится стратегия
					    РеквизитыОповещения.Вставить("Клиент", 
							Строка(СтрокаИзменения.СчетДоверительногоУправления) 
							+ ", стратегия: " + Строка(СтрокаИзменения.Стратегия));
							
					ИначеЕсли ЭтоЦК И ЗначениеЗаполнено(СтрокаИзменения.НаименованиеЦелевогоКапитала) Тогда
							
						//Если клиент управляет активами целевого капитала, то в дополнение к наименованию прибавится наименование целевого капитала	
						РеквизитыОповещения.Вставить("Клиент", 
							Строка(СтрокаИзменения.СчетДоверительногоУправления) 
							+ ", целевой капитал: " + Строка(СтрокаИзменения.НаименованиеЦелевогоКапитала));
							
					Иначе
						РеквизитыОповещения.Вставить("Клиент", СтрокаИзменения.СчетДоверительногоУправления); 
					КонецЕсли;
					
				КонецЦикла;

				Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);

			КонецЦикла;
			
			РеквизитыОповещения = Неопределено;
			
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ФинансовыеПоказатели") Тогда
		
		#Область ФинансовыеПоказатели
		
		// #ТехДолг: Свойство "ЗапускатьПроверки" добавлено для исключения двойного запуска проверок в момент расчета финансовых показателей доходности документом РегистрацияСтоимостиАктивов
		
		Если Не Источник.ДополнительныеСвойства.Свойство("ЗапускатьПроверки") ИЛИ Источник.ДополнительныеСвойства.ЗапускатьПроверки Тогда
		
			Для Каждого Запись Из Источник Цикл
			
				РеквизитыОповещения = Новый Структура("Период, Организация, СубъектАналитики, ВидПоказателя, Значение");
				
				ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Запись);
				
				РеквизитыОповещения.Вставить("ДатаСтрокой", Формат(РеквизитыОповещения.Период, "ДФ=dd.MM.yyyy"));
				
				Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
				
			КонецЦикла;
		
			РеквизитыОповещения = Неопределено;
		
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДополнительныеДатыРасчетаСЧА") Тогда
		
		#Область ДополнительныеДатыРасчетаСЧА
		
		Для Каждого Запись Из Источник Цикл
		
			РеквизитыОповещения = Новый Структура("Организация");
			
			ЗаполнитьЗначенияСвойств(РеквизитыОповещения, Запись);
			
			РеквизитыОповещения.Вставить("ВидДоговораДоверительногоУправления", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
			РеквизитыОповещения.Вставить("СчетДоверительногоУправленияНаименование", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.СчетДоверительногоУправления, "Наименование"));
			РеквизитыОповещения.Вставить("ДатаСЧАСтрокой", Формат(Запись.ДатаСЧА,"ДФ=dd.MM.yyyy"));
			
			Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
			
		КонецЦикла;
	
		РеквизитыОповещения = Неопределено;
	
		#КонецОбласти
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ДокументыЮридическихЛиц")
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ВхожденияВРеестры") 
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛиц") 
		ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.РеквизитыЮридическихЛицАнкетные") Тогда
		
		Если НЕ Источник.ДополнительныеСвойства.УдалениеВСоставеИзмененияНабора И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("ПроверкаРеквизитовАудитора") Тогда
			Для Каждого РезультатПроверкиПоОрганизации Из РаботаСОтчетностьюЦБ.ПолучитьРезультатПроверкиРеквизитовАудитора(Источник) Цикл
				Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РезультатПроверкиПоОрганизации);		
			КонецЦикла;
		КонецЕсли;
		
		#Область РеквизитыЮридическихЛиц
						
		Если Источник.Количество() > 0 И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("РеквизитыЮридическихЛицПередЗаписью") Тогда			
			
			// Выполняем в привилегированном режиме, чтобы создать оповещения по разным организациям
			
			УстановитьПривилегированныйРежим(Истина);
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НаборЗаписей.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
				|	НаборЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
				|	НаборЗаписей.Подразделение КАК Подразделение,
				|	НаборЗаписей.Язык КАК Язык
				|ПОМЕСТИТЬ _НаборЗаписей
				|ИЗ
				|	&НаборЗаписей КАК НаборЗаписей
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыЮридическихЛицПередЗаписью.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
				|	РеквизитыЮридическихЛицПередЗаписью.ЮрФизЛицо КАК ЮрФизЛицо,
				|	РеквизитыЮридическихЛицПередЗаписью.Подразделение КАК Подразделение,
				|	РеквизитыЮридическихЛицПередЗаписью.Язык КАК Язык,
				|	РеквизитыЮридическихЛицПередЗаписью.Организация КАК Организация
				|ПОМЕСТИТЬ _РеквизитыЮридическихЛицПередЗаписью
				|ИЗ
				|	&РеквизитыЮридическихЛицПередЗаписью КАК РеквизитыЮридическихЛицПередЗаписью
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_НаборЗаписей.Язык КАК Язык,
				|	_НаборЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
				|	_РеквизитыЮридическихЛицПередЗаписью.Организация КАК Организация
				|ИЗ
				|	_НаборЗаписей КАК _НаборЗаписей
				|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮридическихЛицПередЗаписью КАК _РеквизитыЮридическихЛицПередЗаписью
				|		ПО _НаборЗаписей.Подразделение = _РеквизитыЮридическихЛицПередЗаписью.Подразделение
				|			И _НаборЗаписей.Язык = _РеквизитыЮридическихЛицПередЗаписью.Язык
				|			И _НаборЗаписей.ЮрФизЛицо = _РеквизитыЮридическихЛицПередЗаписью.ЮрФизЛицо
				|ГДЕ
				|	НЕ _НаборЗаписей.ПолноеНаименованиеПоУставу ЕСТЬ NULL
				|	И _НаборЗаписей.ПолноеНаименованиеПоУставу <> ЕСТЬNULL(_РеквизитыЮридическихЛицПередЗаписью.ПолноеНаименованиеПоУставу, """")
				|ИТОГИ ПО
				|	Организация");
			
			Запрос.УстановитьПараметр("НаборЗаписей",							Источник.Выгрузить());
			Запрос.УстановитьПараметр("РеквизитыЮридическихЛицПередЗаписью", 	Источник.ЗаписьИсторииДанных.ДополнительныеДанные.РеквизитыЮридическихЛицПередЗаписью);
							
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
								
				ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
								
				Пока ВыборкаОрганизация.Следующий() Цикл
					
					ТекстОповещения = "";
					
					Выборка     = ВыборкаОрганизация.Выбрать();
					
					Пока Выборка.Следующий() Цикл                                                                           
						ТекстОповещения = ТекстОповещения + ?(ТекстОповещения = "", "", Символы.ПС) + СтрШаблон("Изменено наименование по уставу юр. лица '%1' на языке '%2'", Выборка.ЮрФизЛицо, Выборка.Язык); 	
					КонецЦикла;
					
					Если Не ПустаяСтрока(ТекстОповещения) Тогда
						Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя() + "_КонтрольНаименования", Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, Новый Структура("Организация, Текст", ВыборкаОрганизация.Организация, ТекстОповещения));
					КонецЕсли;
	
				КонецЦикла;
				
				УстановитьПривилегированныйРежим(Ложь);
																
			КонецЕсли;
			
		КонецЕсли;
					
		#КонецОбласти

		Возврат;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.УсловияОферт")
			 И Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("МВТ_УсловияОфертПередЗаписью") Тогда
		
	#Область УсловияОферт
	
		Если Источник.Количество() > 0 Тогда
		
			ТипыОфертТребующиеПересчетаЭСП = Документы.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах.ТипыОфертТребующиеПересчетаЭСП();
			НачалоЭтогоДня = НачалоДня(ТекущаяДата());
			ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
			ОрганизацияТраст = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
	
			Для каждого Запись Из Источник Цикл
				
				Если Запись.ДатаОбъявления = НачалоЭтогоДня
					И ТипыОфертТребующиеПересчетаЭСП.Найти(Запись.ТипОферты) <> Неопределено Тогда
				
					РегистрыСведений.УсловияОферт.ПроинформироватьОНеобходимостиЗаведенияДокументаРегистрацииСведений(Запись.Облигация, ОрганизацияРЭМ);
					РегистрыСведений.УсловияОферт.ПроинформироватьОНеобходимостиЗаведенияДокументаРегистрацииСведений(Запись.Облигация, ОрганизацияТраст);
				
				КонецЕсли;
			
			КонецЦикла;
		
		КонецЕсли;
		
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Источник.ЗаписьИсторииДанных.ДополнительныеДанные.МВТ_УсловияОфертПередЗаписью;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НаборНовыхЗаписей.Облигация КАК Облигация,
			|	НаборНовыхЗаписей.ДатаВыкупа КАК ДатаВыкупа,
			|	НаборНовыхЗаписей.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛиц,
			|	НаборНовыхЗаписей.ЦенаПроцент КАК ЦенаПроцент,
			|	НаборНовыхЗаписей.Цена КАК Цена,
			|	НаборНовыхЗаписей.АкцептС КАК АкцептС,
			|	НаборНовыхЗаписей.АкцептПо КАК АкцептПо,
			|	НаборНовыхЗаписей.ТипОферты КАК ТипОферты,
			|	НаборНовыхЗаписей.ДатаОбъявления КАК ДатаОбъявления
			|ПОМЕСТИТЬ _НаборНовыхЗаписей
			|ИЗ
			|	&НаборНовыхЗаписей КАК НаборНовыхЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_НаборНовыхЗаписей.Облигация, _УсловияОфертПередЗаписью.Облигация) КАК Облигация,
			|	ЕСТЬNULL(_НаборНовыхЗаписей.ДатаВыкупа, _УсловияОфертПередЗаписью.ДатаВыкупа) КАК ДатаВыкупа,
			|	ЕСТЬNULL(_НаборНовыхЗаписей.ТолькоДляФизическихЛиц, _УсловияОфертПередЗаписью.ТолькоДляФизическихЛиц) КАК ДляФизЛиц,
			|	_НаборНовыхЗаписей.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛицНов,
			|	_НаборНовыхЗаписей.ЦенаПроцент КАК ЦенаПроцентНов,
			|	_НаборНовыхЗаписей.Цена КАК ЦенаНов,
			|	_НаборНовыхЗаписей.АкцептС КАК АкцептСНов,
			|	_НаборНовыхЗаписей.АкцептПо КАК АкцептПоНов,
			|	_НаборНовыхЗаписей.ТипОферты КАК ТипОфертыНов,
			|	_НаборНовыхЗаписей.ДатаОбъявления КАК ДатаОбъявленияНов,
			|	_УсловияОфертПередЗаписью.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛиц,
			|	_УсловияОфертПередЗаписью.ЦенаПроцент КАК ЦенаПроцент,
			|	_УсловияОфертПередЗаписью.Цена КАК Цена,
			|	_УсловияОфертПередЗаписью.АкцептС КАК АкцептС,
			|	_УсловияОфертПередЗаписью.АкцептПо КАК АкцептПо,
			|	_УсловияОфертПередЗаписью.ТипОферты КАК ТипОферты,
			|	_УсловияОфертПередЗаписью.ДатаОбъявления КАК ДатаОбъявления,
			|	_УсловияОфертПередЗаписью.Облигация ЕСТЬ NULL КАК ФлагНоваяЗапись,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_НаборНовыхЗаписей.АкцептПо, _УсловияОфертПередЗаписью.АкцептПо) = ДАТАВРЕМЯ(1, 1, 1)
			|			ТОГДА ЕСТЬNULL(_НаборНовыхЗаписей.ДатаВыкупа, _УсловияОфертПередЗаписью.ДатаВыкупа)
			|		ИНАЧЕ ЕСТЬNULL(_НаборНовыхЗаписей.АкцептПо, _УсловияОфертПередЗаписью.АкцептПо)
			|	КОНЕЦ КАК ДатаФиксацииОстатков,
			|	ВЫБОР
			|		КОГДА _НаборНовыхЗаписей.ТолькоДляФизическихЛиц <> _УсловияОфертПередЗаписью.ТолькоДляФизическихЛиц
			|			ТОГДА ""ТолькоДляФизическихЛиц,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _НаборНовыхЗаписей.ЦенаПроцент <> _УсловияОфертПередЗаписью.ЦенаПроцент
			|			ТОГДА ""ЦенаПроцент,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
			|		КОГДА _НаборНовыхЗаписей.Цена <> _УсловияОфертПередЗаписью.Цена
			|			ТОГДА ""Цена,""
			|		ИНАЧЕ """"
			|	КОНЕЦ + ВЫБОР
