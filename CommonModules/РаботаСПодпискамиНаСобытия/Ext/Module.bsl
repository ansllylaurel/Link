Функция ПроверитьЗаписиРегистраПартий(ПараметрыПроверки)

	Источник 			= ПараметрыПроверки.Источник;
	ПолноеИмяРегистра	= ПараметрыПроверки.ПолноеИмяРегистра;
	Регистратор 		= ПараметрыПроверки.Регистратор;
	Запрос 				= ПараметрыПроверки.Запрос;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВидыУчета.ВидУчета КАК ВидУчета
		|ПОМЕСТИТЬ _ВидыУчета
		|ИЗ
		|	&ВидыУчета КАК ВидыУчета
		|;
		|";
	
	Запрос.УстановитьПараметр("ВидыУчета", Источник.ДополнительныеСвойства.ВидыУчета);
	
	Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
	
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	*
			|ИЗ
			|	&ИмяРегистра КАК Регистр
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВидыУчета КАК _ВидыУчета
			|	ПО _ВидыУчета.СчетДоверительногоУправления = Регистр.СчетДоверительногоУправления
			|		И _ВидыУчета.ВидУчета = Регистр.ВидУчета
			|ГДЕ 
			|	Регистр.Регистратор = &Регистратор
			|	И Регистр.Активность"; // Почему тут нет сортировки по номеру строки? нужно ли еще добавить сортировку по СчетДоверительногоУправления? 
	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяРегистра", ПолноеИмяРегистра);
		
		Запрос.УстановитьПараметр("Регистратор", Регистратор);
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ПОМЕСТИТЬ _НаборЗаписей
			|ИЗ
			|	&НаборЗаписей КАК НаборЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ИЗ
			|	_НаборЗаписей КАК _НаборЗаписей
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВидыУчета КАК _ВидыУчета
			|	ПО _ВидыУчета.СчетДоверительногоУправления = _НаборЗаписей.СчетДоверительногоУправления
			|		И _ВидыУчета.ВидУчета = _НаборЗаписей.ВидУчета
			|ГДЕ
			|	_НаборЗаписей.Активность
			|
			|УПОРЯДОЧИТЬ ПО
			|	_НаборЗаписей.СчетДоверительногоУправления,
			|	_НаборЗаписей.НомерСтроки";
		
		НаборЗаписей = Источник.Выгрузить();
		НаборЗаписей.Колонки.Удалить("МоментВремени");
		
		Запрос.УстановитьПараметр("НаборЗаписей", НаборЗаписей);
		
	КонецЕсли; 
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;		
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаДвижений = Запрос.Выполнить().Выгрузить();
	ТаблицаДвижений.Колонки.Удалить("НомерСтроки");
	Если Не ТаблицаДвижений.Колонки.Найти("Содержание") = Неопределено Тогда
		ТаблицаДвижений.Колонки.Удалить("Содержание");
	КонецЕсли; 
	
	Если Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") Тогда
		
		ХранилищеЗначения = Новый ХранилищеЗначения(ТаблицаДвижений, Новый СжатиеДанных(9));
		Источник.ДополнительныеСвойства.Вставить("ИсходныеДвижения", ХранилищеЗначения);
		
	Иначе
		
		ИсходныеДвижения = Источник.ДополнительныеСвойства.ИсходныеДвижения;
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ИсходныеДвижения, "ValueStorage", "http://v8.1c.ru/8.1/data/core");
		ИсходныеДвижения = ЗаписьXML.Закрыть();
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Новый ХранилищеЗначения(ТаблицаДвижений, Новый СжатиеДанных(9)), "ValueStorage", "http://v8.1c.ru/8.1/data/core");
		ТекущиеДвижения = ЗаписьXML.Закрыть();
		
		Если Не ИсходныеДвижения = ТекущиеДвижения Тогда
		
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ВидыУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	_ВидыУчета.ВидУчета КАК ВидУчета
				|ИЗ
				|	_ВидыУчета КАК _ВидыУчета
				|ИТОГИ ПО
				|	ВидУчета";	
			
			Возврат Запрос.Выполнить();
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецФункции

Процедура АвтоматическоеПодтверждениеОперацииБэкОфиса(Источник, Отказ)
	
	Если Источник.Дата < '20171001' // подтверждаем операции только после 01.10.2017
		ИЛИ Не Источник.Проведен
		ИЛИ Не Метаданные.ОпределяемыеТипы.ПодтверждаемыеОперацииБэкОфиса.Тип.СодержитТип(ТипЗнч(Источник.Ссылка))
		ИЛИ РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ОперацияПодтверждена(Источник.Ссылка)
	Тогда 
		Возврат;
	КонецЕсли;
	
	// Только для организаций, для которых требуется подтверждение операций
	КонтрольПодтвержденийОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Организация, "КонтрольПодтвержденийОпераций");
	Если Не КонтрольПодтвержденийОпераций Тогда
		Возврат;
	КонецЕсли;
	
	Основание	= Неопределено;
	Примечание	= "";
	
	ВидОперации = РаботаСДокументами.ПолучитьИмя(Источник);
	
	Если ВидОперации = "ВводКредитногоИнструмента" ИЛИ ВидОперации = "ВыводКредитногоИнструмента" Тогда
		
		Основание = "Договор";
		
	ИначеЕсли ВидОперации = "НачислениеДивидендов" Тогда
		
		Основание = "Решение эмитента";
		
	ИначеЕсли ВидОперации = "ПогашениеКупона" ИЛИ ВидОперации = "ПогашениеЦеннойБумаги" Тогда
		
		Основание = "Проспект эмиссии";
		
	ИначеЕсли ВидОперации = "ПоручениеНаДвижениеДенежныхСредств" Тогда
		
		Если Источник.СпособПередачи = Перечисления.СпособыПередачиПоручений.ВнутренняяСистема Тогда
			Возврат;
		Иначе
			Основание = "Оригинал документа";	
		КонецЕсли;
			
	ИначеЕсли ВидОперации = "ПоручениеНаДвижениеЦенныхБумаг" Тогда
		
		Основание = "Оригинал документа";
		
	ИначеЕсли ВидОперации = "ВводДенежныхСредств" Тогда
	
		Если Источник.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			Основание = "Приходный кассовый ордер";
		ИначеЕсли РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
			Основание = "Банковские выписки";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = "ВыводДенежныхСредств"
		ИЛИ ВидОперации = "ПриходПроцентовМНО"
		ИЛИ ВидОперации = "ПриходПроцентовПоКредитномуИнструменту"
	Тогда
	
		Если РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
			Основание = "Банковские выписки";
		КонецЕсли;
		
	ИначеЕсли ВидОперации = "РазмещениеКредитногоИнструмента" ИЛИ ВидОперации = "ЗакрытиеКредитногоИнструмента" Тогда
	
		Если РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(Источник.КредитныйИнструмент) Тогда
		
			//НетРасхожденийСБиржей = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьРезультатСверки(
			//	Источник.Организация,
			//	Источник.СчетДоверительногоУправления,
			//	НачалоДня(Источник.Дата),
			//	Справочники.ВнешниеСистемы.КлиринговыйОтчетММВБоДвиженииДенежныхСредств
			//);
			НетРасхожденийСБиржей = Ложь;
			
			Если НетРасхожденийСБиржей Тогда
				Основание = "Клиринговый отчет";
			КонецЕсли;				
		
		ИначеЕсли РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
			
			Основание = "Банковские выписки";

		КонецЕсли;		
		
	ИначеЕсли ВидОперации = "ПереводДенежныхСредств" Тогда
		
		Если ЗначениеЗаполнено(Источник.Брокер) ИЛИ ЗначениеЗаполнено(Источник.БрокерПолучатель) Тогда
			
			Брокер = ?(ЗначениеЗаполнено(Источник.Брокер), Источник.Брокер, Источник.БрокерПолучатель);
			
			Если Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда 
				ОтчетБрокера = Справочники.ВнешниеСистемы.ОтчетБрокераБКРегион;
			ИначеЕсли Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") Тогда
				ОтчетБрокера = Справочники.ВнешниеСистемы.ОтчетБрокераГПБ;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подтверждение операции с брокером '" + Брокер + "' не реализовано.", Источник);
				Возврат;
			КонецЕсли;
			
			НетРасхожденийСБрокером = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьРезультатСверки(
				Источник.Организация,
				Источник.СчетДоверительногоУправления,
				НачалоДня(Источник.Дата),
				ОтчетБрокера
			);
			
			Если НетРасхожденийСБрокером Тогда 
				Если Источник.Брокер = Источник.БрокерПолучатель Тогда
					Основание	= "Отчет брокера";
				ИначеЕсли РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
					Основание	= "Отчет брокера";
					Примечание	= "Поступление на счет банка подтверждено банковскими выписками";				
				КонецЕсли;
			КонецЕсли;				
			
		ИначеЕсли Источник.МестоХранения = Справочники.МестаХранения.ММВБ_ДепозитыСЦК
			ИЛИ Источник.МестоХраненияПолучатель = Справочники.МестаХранения.ММВБ_ДепозитыСЦК
		Тогда
		
			//НетРасхожденийСБиржей = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьРезультатСверки(
			//	Источник.Организация,
			//	Источник.СчетДоверительногоУправления,
			//	НачалоДня(Источник.Дата),
			//	Справочники.ВнешниеСистемы.КлиринговыйОтчетММВБоДвиженииДенежныхСредств
			//);
			НетРасхожденийСБиржей = Ложь;
			
			Если НетРасхожденийСБиржей И РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
				Основание		 = "Клиринговый отчет";
				ДействиеСоСчетом = ?(Источник.МестоХраненияПолучатель = Справочники.МестаХранения.ММВБ_ДепозитыСЦК, "Списание со счета", "Поступление на счет");
				Примечание		 = ДействиеСоСчетом + " банка подтверждено банковскими выписками";				
			КонецЕсли;				
		
		ИначеЕсли РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник) Тогда
			
			Основание = "Банковские выписки";

		КонецЕсли;
		
	ИначеЕсли ВидОперации = "МНО" Тогда
		
		Основание = "Подтверждение МНО";
		
	ИначеЕсли (ВидОперации = "Сделка" ИЛИ ВидОперации = "СделкаРЕПО" ИЛИ ВидОперации = "СделкаСВалютой" ИЛИ ВидОперации = "СделкаСМО"
		ИЛИ ВидОперации = "ИзменениеУсловийСделки" ИЛИ ВидОперации = "ИсполнениеОбязательствПоСделке" ИЛИ ВидОперации = "ОтменаСделки") 
		И Не РаботаСДокументами.СделкаЧерезБрокера(Источник) Тогда
		
		Основание = "Договор";
		
	ИначеЕсли ВидОперации = "Оплата" Тогда
		
		Если Не ЗначениеЗаполнено(Источник.Брокер)
			И Источник.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК
			И РегистрыСведений.РеестрПлатежей.РазнесеныВсеПлатежи(Источник)
		Тогда
			Основание = "Банковские выписки";
		КонецЕсли;
	
	ИначеЕсли ВидОперации = "НачислениеЗадолженности" Тогда
		
		Если Не ЗначениеЗаполнено(Источник.Брокер)
			И Источник.МестоХранения <> Справочники.МестаХранения.ММВБ_ДепозитыСЦК
		Тогда
		
			// Прочие доходы и расходы, связанные с депозитарием
			ПрочиеДоходыИРасходыДепозитария = Новый Массив;
			ПрочиеДоходыИРасходыДепозитария.Добавить(Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам спецдепозитария", Истина));
			ПрочиеДоходыИРасходыДепозитария.Добавить(Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам депозитария", Истина));	
			
			Если Источник.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия)
				ИЛИ Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии Тогда
				
				Основание = "Банковские выписки";
				
			ИначеЕсли Источник.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.УслугиДоверительногоУправления) Тогда
				
				Основание = "Расчет вознаграждения";
				
			ИначеЕсли Источник.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ) Тогда
				
				Основание = "Расчет НДФЛ";
				
			ИначеЕсли Источник.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия)
				ИЛИ Источник.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии
				ИЛИ ПрочиеДоходыИРасходыДепозитария.Найти(Источник.ПрочиеДоходыИРасходы) <> Неопределено Тогда
				
				Основание = "Выставленный счет";
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	// При первом проведении документа добавляем в журнал подтверждений запись о внесении.
	// Если запись о подтверждении является первой записью в журнале подтверждений, то это указывается в примечании.
	
	ПоследняяЗаписьЖурналаПодтверждений = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПоследнююЗаписьЖурналаПодтверждений(Источник.Ссылка); 
	Если ПоследняяЗаписьЖурналаПодтверждений = Неопределено Тогда
		Примечание = ?(ЗначениеЗаполнено(Примечание), "Внесение записи (" + Примечание + ")", "Внесение записи");
	КонецЕсли;	
	
	// Время подтверждения может заполняться алгоритмами	
	
	ТекДата = ТекущаяДата();
	Если Источник.ДополнительныеСвойства.Свойство("ВремяПодтверждения") Тогда
		ВремяЗаписи = Источник.ДополнительныеСвойства.ВремяПодтверждения;
	ИначеЕсли ТекДата < Источник.Дата И НачалоДня(Источник.Дата) = НачалоДня(ТекДата) Тогда
		// У некоторых операций время сдвинуто на более позднее в текущем дне, у них сдвигаем время подтверждения
		ВремяЗаписи = Источник.Дата;
	Иначе
		ВремяЗаписи = Неопределено;
	КонецЕсли;
	
	Если (Основание <> Неопределено)
		И (Источник.Дата <= ТекДата Или НачалоДня(Источник.Дата) = НачалоДня(ТекДата)) Тогда
		РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ДобавитьЗаписьВЖурналПодтверждений(Источник, Истина, Основание, Примечание, Ложь, ВремяЗаписи);
	ИначеЕсли ПоследняяЗаписьЖурналаПодтверждений = Неопределено Тогда 
		РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ДобавитьЗаписьВЖурналПодтверждений(Источник, Ложь, Основание, Примечание, Ложь, ВремяЗаписи);
	КонецЕсли;

КонецПроцедуры

Функция ЗарегистрированНомерСообщенияОбОткрытииЗакрытииИИС(Объект)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|ГДЕ
		|	НомераОбъектов.Объект = &Объект
		|	И НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС)";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПолучитьНаборЗаписейПоРегистратору(ПолноеИмяРегистра, Регистратор, ВыгрузитьВТаблицу = Ложь)
	
	НаборЗаписей = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ПолноеИмяРегистра).СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();
	
	Возврат ?(ВыгрузитьВТаблицу, НаборЗаписей.Выгрузить(), НаборЗаписей);	
	
КонецФункции

Процедура ПроверитьДвиженияПаевСобственногоПортфеляИСформироватьОповещение(Источник)
	
	РеквизитыОповещения = Новый Структура("Организация, Текст", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"), "");
	
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборЗаписей.Период КАК Период,
		|	НаборЗаписей.Активность КАК Активность,
		|	НаборЗаписей.Организация КАК Организация,
		|	НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НаборЗаписей.Регистратор КАК Регистратор,
		|	НаборЗаписей.Рынок КАК Рынок,
		|	НаборЗаписей.ВидДвижения КАК ВидДвижения,
		|	НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
		|	НаборЗаписей.Количество КАК Количество
		|ПОМЕСТИТЬ _НаборЗаписей
		|ИЗ
		|	&НаборЗаписей КАК НаборЗаписей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НаборЗаписей.Период КАК Период,
		|	_НаборЗаписей.Активность КАК Активность,
		|	_НаборЗаписей.Организация КАК Организация,
		|	_НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НаборЗаписей.Регистратор КАК Регистратор,
		|	_НаборЗаписей.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НаборЗаписей.Количество КАК Количество,
		|	_НаборЗаписей.ВидДвижения КАК ВидДвижения
		|ПОМЕСТИТЬ _НаборЗаписейСОтбором
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|ГДЕ
		|	НЕ _НаборЗаписей.Регистратор ССЫЛКА Документ.ПереводЦенныхБумаг
		|	И _НаборЗаписей.Регистратор = &Регистратор
		|	И _НаборЗаписей.Организация = &Организация
		|	И _НаборЗаписей.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|	И _НаборЗаписей.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				СчетаДУ.Ссылка
		|			ИЗ
		|				Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|			ГДЕ
		|				СчетаДУ.Организация = &Организация
		|				И СчетаДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумаг.Период КАК Период,
		|	ОстаткиЦенныхБумаг.Активность КАК Активность,
		|	ОстаткиЦенныхБумаг.Организация КАК Организация,
		|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумаг.Количество КАК Количество,
		|	ОстаткиЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	ОстаткиЦенныхБумаг.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ _ОстаткиЦБСОтбором
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|ГДЕ
		|	НЕ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПереводЦенныхБумаг
		|	И ОстаткиЦенныхБумаг.Регистратор = &Регистратор
		|	И ОстаткиЦенныхБумаг.Организация = &Организация
		|	И ОстаткиЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|	И ОстаткиЦенныхБумаг.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				СчетаДУ.Ссылка
		|			ИЗ
		|				Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|			ГДЕ
		|				СчетаДУ.Организация = &Организация
		|				И СчетаДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Источник.Период КАК Период,
		|	ВЫБОР
		|		КОГДА &ФлПустойНабор
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ Источник.Активность
		|	КОНЕЦ КАК Активность,
		|	Источник.Организация КАК Организация,
		|	Источник.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Источник.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Источник.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА Источник.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ""+""
		|		ИНАЧЕ ""-""
		|	КОНЕЦ КАК ВидДвижения
		|ИЗ
		|	&Источник КАК Источник";
#КонецОбласти
	Запрос.УстановитьПараметр("Регистратор"  , Источник.Отбор.Регистратор.Значение);
	Запрос.УстановитьПараметр("Организация"  , РеквизитыОповещения.Организация);
	Запрос.УстановитьПараметр("НаборЗаписей" , Источник.Выгрузить());
	Запрос.УстановитьПараметр("ФлПустойНабор", Источник.Количество() = 0);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", ?(Источник.Количество() = 0, "_ОстаткиЦБСОтбором", "_НаборЗаписейСОтбором"));
		
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
			
		Если РеквизитыОповещения.Текст = "" Тогда
			РеквизитыОповещения.Текст = ?(Выборка.Активность, "", "Отмена операции! ") + "Дата операции: " + Выборка.Период + ". Счет доверительного управления: " + СокрЛП(Выборка.СчетДоверительногоУправления) + "." + Символы.ПС + "Ценные бумаги: " + Символы.ПС + СокрЛП(Выборка.ЦеннаяБумага) + " (" + Выборка.ВидДвижения + Строка(Выборка.Количество) + " ед.)";
		Иначе 
			РеквизитыОповещения.Текст = РеквизитыОповещения.Текст + ";" + Символы.ПС + СокрЛП(Выборка.ЦеннаяБумага) + " (" + Выборка.ВидДвижения + Строка(Выборка.Количество) + " ед.)";				
		КонецЕсли;	
		
	КонецЦикла;
	
	Если РеквизитыОповещения.Текст <> "" Тогда
		Справочники.Оповещения.СформироватьОповещения(Источник.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ПриЗаписиДвиженийРегистровНакопления, РеквизитыОповещения);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьРеквизитыДляПоручений(Источник)
	
	Источник.ДополнительныеСвойства.Свойство("ЭтоНовый", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &Период)";
	
	Запрос.УстановитьПараметр("Период", Источник.Дата);
	Запрос.УстановитьПараметр("Организация", Источник.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Источник.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КодУБрокера = "";
	Пока Выборка.Следующий() Цикл
		КодУБрокера = КодУБрокера + ?(КодУБрокера = "", "", ", ") + Выборка.Код + " [" + Выборка.Брокер + "]";	
	КонецЦикла;

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.СчетДоверительногоУправления, Новый Структура("КодСчета, НомерДоговора, Наименование, ВидДоговораДоверительногоУправления"));
	
	РеквизитыОповещения = Новый Структура();
	РеквизитыОповещения.Вставить("Организация", Источник.Организация);
	
	Если Источник.ВыводВсехАктивов Тогда
		РеквизитыОповещения.Вставить("ВидПоручения", "вывод всех активов");
	Иначе
		РеквизитыОповещения.Вставить("ВидПоручения", ?(Источник.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская, "ввод ", "вывод ") + "ценных бумаг");	
	КонецЕсли;
	
	РеквизитыОповещения.Вставить("КодКлиента", ЗначенияРеквизитов.КодСчета);
	РеквизитыОповещения.Вставить("Наименование", ЗначенияРеквизитов.Наименование);
	РеквизитыОповещения.Вставить("НомерДоговора", ЗначенияРеквизитов.НомерДоговора);
	РеквизитыОповещения.Вставить("НомерПоручения", СокрЛП(Источник.Номер));
	РеквизитыОповещения.Вставить("ДатаПоручения", Формат(Источник.Дата, "ДФ=dd.MM.yyyy"));
	РеквизитыОповещения.Вставить("КодУБрокера", КодУБрокера);
	
	// Для новых поручений на вывод добавляем текст о необходимости согласования документа
	Если Источник.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение 
			И Источник.ДополнительныеСвойства.Свойство("ТребуетсяСогласованиеПорученияНаВыводАктивов")
			И Не РаботаСДокументами.ПоручениеНаВыводАктивовСогласовано(Источник.Ссылка, ТекущаяДата()) 
			И Не РаботаСДокументами.ПоручениеНаВыводАктивовОтменено(Источник.Ссылка) Тогда
			
		РеквизитыОповещения.Вставить("НеобходимоСогласие", "Необходимо согласовать поручение");
	Иначе
		РеквизитыОповещения.Вставить("НеобходимоСогласие", "Поручение");	
	КонецЕсли;
					
	ТекстСообщения = "Дата исполнения поручения по: " + Формат(Источник.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") + Символы.ПС + "Ценные бумаги: ";
	
	Для Каждого СтрокаТабЧасти Из Источник.ЦенныеБумаги Цикл
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтрокаТабЧасти.НомерСтроки + ". " + СтрокаТабЧасти.Количество + " (шт.) " + СтрокаТабЧасти.ЦеннаяБумага;	
	КонецЦикла;
					
	РеквизитыОповещения.Вставить("ТекстСообщения", ТекстСообщения);   	
	
	Возврат РеквизитыОповещения;
	
КонецФункции

Процедура ЗаполнитьИзмененияРеквизитов(Источник, РеквизитыОповещения)
	
	Если Источник.ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитов") Тогда
		Для Каждого ЗначениеРеквизитаПередЗаписью Из Источник.ДополнительныеСвойства.ПредЗначенияРеквизитов Цикл
			РеквизитыОповещения.Вставить("ИзменилсяРеквизит" + ЗначениеРеквизитаПередЗаписью.Ключ, ЗначениеРеквизитаПередЗаписью.Значение <> Источник[ЗначениеРеквизитаПередЗаписью.Ключ]);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
