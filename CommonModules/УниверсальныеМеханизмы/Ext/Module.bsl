
// Эта процедура, при удачном раскладе, перейдет в модуль РаботаСДокументами
// и заменит процедуры ЗаполнитьРеквизитыПоУмолчанию и ЗаполнитьЗначенияСвойствНовогоДокумента
Процедура ЗаполнитьОбщиеРеквизитыДокумента(Объект, ДанныеЗаполнения = Неопределено) Экспорт
	
	// Организация в документах есть всегда; у неё всегда установлено свойство "Заполнять из данных заполнения"
	ТребуетсяЗаполнениеОрганизации = Не ЗначениеЗаполнено(Объект.Организация)
		И Не РеквизитЗаполненВДанныхЗаполнения(ДанныеЗаполнения, "Организация");
		
	Если ТипЗнч(Объект) <> Тип("ЗадачаОбъект.ЗадачаИсполнителя") Тогда
		// Ответственный в документах есть всегда
		Объект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	КонецЕсли;
		
	Если ТребуетсяЗаполнениеОрганизации Тогда
		Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	// комментарий в документах есть всегда
	Объект.Комментарий = "";
	
КонецПроцедуры // ЗаполнитьОбщиеРеквизитыДокумента

Процедура ЗаполнитьОбщиеРеквизитыСправочника(Объект, ДанныеЗаполнения = Неопределено) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Объект, "Организация") Тогда
		ТребуетсяЗаполнениеОрганизации = Не ЗначениеЗаполнено(Объект.Организация)
			И Не РеквизитЗаполненВДанныхЗаполнения(ДанныеЗаполнения, "Организация");
		
		Если ТребуетсяЗаполнениеОрганизации Тогда
			Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		КонецЕсли;	
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Объект, "Наименование") 
		И Объект.Метаданные().ДлинаНаименования > 0 Тогда
		Объект.Наименование = "";
	КонецЕсли;	

	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Объект, "Комментарий") Тогда
		Объект.Комментарий = "";
	КонецЕсли;	
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Объект, "Ответственный") Тогда
		Объект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	КонецЕсли;	
		
КонецПроцедуры // ЗаполнитьОбщиеРеквизитыСправочника

Процедура ПослеОбработкиПроверкиЗаполнения(Объект, Отказ) Экспорт
	
	Объект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры // ПослеОбработкиПроверкиЗаполнения

Функция ОбъектМожноЗаписать(Объект, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	Перем ОбработкаПроверкиЗаполненияОтказ, Описание;
	
	// т.к. перед программной записью вызвать проверку заполнения могли и забыть,
	// вызовем её сами
	ПроверкаЗаполненияВыдалаОшибку = Ложь;
	Если Не Объект.ДополнительныеСвойства.Свойство("ОбработкаПроверкиЗаполненияОтказ", ОбработкаПроверкиЗаполненияОтказ) Тогда
		ПроверкаЗаполненияВыдалаОшибку = Не Объект.ПроверитьЗаполнение();
	КонецЕсли;
	//в старых периодах есть документы, с кривым заполнением
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И ПроверкаЗаполненияВыдалаОшибку Тогда
		ПроверкаЗаполненияВыдалаОшибку = Ложь;	
	КонецЕсли;
	
	Отказ = Отказ Или ПроверкаЗаполненияВыдалаОшибку Или (ОбработкаПроверкиЗаполненияОтказ = Истина);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
		
	// защита от программного ввода объектов, загружаемых из внешних систем
	Если Не Объект.ДополнительныеСвойства.Свойство("ИмпортИзВнешнейСистемы") // возможность изменять данные элементы программно
			И РаботаСВнешнимиСистемами.ОбъектИмпортируетсяИзВнешнейСистемы(Объект, Описание)
			И Не ЭтоУдалениеСведенийПоВедущемуИзмерению(Объект)
			И Не ЭтоИзменениеПометкиНаУдаление(Объект)
			И (НЕ Объект.ДополнительныеСвойства.Свойство("ОчисткаРегистра")
				ИЛИ НЕ Объект.ДополнительныеСвойства.ОчисткаРегистра)
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Описание, Объект,,, Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	// проверки, общие для групп объект метаданных
	ОбъектМД    = Объект.Метаданные();
	ПолноеИмяМД = ОбъектМД.ПолноеИмя();
	
	Если СтрНачинаетсяС(ПолноеИмяМД, "Документ.") Тогда
		
		ЕстьРеквизитСчетДУ = ОбщегоНазначенияКлиентСервер.ПолеСуществует(Объект, "СчетДоверительногоУправления");
		
		// и новые и старые реквизиты не должны попадать в дату запрета редактирования
		Если Не Объект.ЭтоНовый() Тогда
			Если РаботаСДокументами.ЗапретРедактированияДокумента(Объект.Ссылка, Объект, Отказ,,, РежимЗаписи) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Если Объект.Проведен И РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
				ИзменилисьРеквизиты = Ложь;
				Если ЕстьРеквизитСчетДУ Тогда
					РеквизитыДатаСчет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "Дата,СчетДоверительногоУправления");
					ИзменилисьРеквизиты = (НачалоДня(Объект.Дата) <> НачалоДня(РеквизитыДатаСчет.Дата) ИЛИ Объект.СчетДоверительногоУправления <> РеквизитыДатаСчет.СчетДоверительногоУправления);
				Иначе
					ИзменилисьРеквизиты = (НачалоДня(Объект.Дата) <> НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Дата")));
				КонецЕсли;
				Если ИзменилисьРеквизиты Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменять дату или счет доверительного управления можно только у непроведенного документа!",,,, Отказ);
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если РаботаСДокументами.ЗапретРедактированияДокумента(Объект, Объект, Отказ,,, РежимЗаписи) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// акцептованные документы изменять нельзя
		Если Не РаботаСДокументами.АкцептованныйДокументМожноЗаписать(Объект, Отказ) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если ЕстьРеквизитСчетДУ Тогда
				Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
					Если Объект.Организация <> Объект.СчетДоверительногоУправления.Организация Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранная организация '" + Объект.Организация + "' не соответствует организации '" + Объект.СчетДоверительногоУправления.Организация + "' в выбранном счете доверительного управления '" + Объект.СчетДоверительногоУправления + "'", Объект, "СчетДоверительногоУправления",, Отказ);
						Возврат Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если Не РаботаСДокументами.ПроверитьРынокЦенныхБумаг(Объект, Отказ) Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяМД, "Регистр") Тогда
		
		Если ПроверитьСоответствиеОрганизацииИПолейРегистра(Объект, Отказ) = Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		
		РегистрыСКонтролемКоличестваРегистраторов = Новый Массив;
		РегистрыСКонтролемКоличестваРегистраторов.Добавить("РегистрСведений.СтоимостьПереоценки");
		РегистрыСКонтролемКоличестваРегистраторов.Добавить("РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам");
		РегистрыСКонтролемКоличестваРегистраторов.Добавить("РегистрСведений.ФинансовыеПоказатели");
		РегистрыСКонтролемКоличестваРегистраторов.Добавить("РегистрНакопления.РезервыПИФ");
		
		Если РегистрыСКонтролемКоличестваРегистраторов.Найти(ПолноеИмяМД) <> Неопределено 
			И Не ПроверитьКоличествоРегистраторов(ОбъектМД, Объект, Отказ) Тогда
			Возврат Ложь;
		КонецЕсли; 
	
	КонецЕсли;

	Возврат Не Отказ;
	
КонецФункции // ОбъектМожноЗаписать	

Процедура ОбработкаЗаполнения(Объект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИсключаемыПоля = "";
	
	Для каждого ЭлементДанныхЗаполнения Из ДанныеЗаполнения Цикл
		
		ДанныеТабЧасти = Неопределено;
		
		Если      ТипЗнч(ЭлементДанныхЗаполнения.Значение) = Тип("Массив") Тогда // массив структур
			ДанныеТабЧасти = ЭлементДанныхЗаполнения.Значение;
			
		ИначеЕсли ТипЗнч(ЭлементДанныхЗаполнения.Значение) = Тип("ХранилищеЗначения") Тогда // таблица значений в хранилище
			ДанныеТабЧасти = ЭлементДанныхЗаполнения.Значение.Получить();
			
			Если ТипЗнч(ДанныеТабЧасти) <> Тип("ТаблицаЗначений") Тогда
				ДанныеТабЧасти = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеТабЧасти) Тогда
			Для каждого СтрокаТабЧасти Из ДанныеТабЧасти Цикл
				ЗаполнитьЗначенияСвойств(Объект[ЭлементДанныхЗаполнения.Ключ].Добавить(), СтрокаТабЧасти);
			КонецЦикла;
			
			ИсключаемыПоля = ИсключаемыПоля + ?(ПустаяСтрока(ИсключаемыПоля), "", ", ") + ЭлементДанныхЗаполнения.Ключ;
		КонецЕсли;
			
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения,, ИсключаемыПоля);
	
КонецПроцедуры // ОбработкаЗаполнения

