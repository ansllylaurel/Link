					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала; // АналитикаДоходовОтРеализации;
					Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
					Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
					// кредит
					Проводка.СчетКт = НастройкиУчетаАктива.СчетУчетаИндексацииНоминалаЗаВремяВладения;
					Проводка.СубконтоКт.Облигации = ЦеннаяБумага;
					
				КонецЕсли;
								
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЭтоИсполнение Или ЭтоПоставка Тогда
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.Сделка") Тогда
			
			ПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс = БухгалтерскийУчет.ПолучитьПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс(
																					ЭтотОбъект.Организация,
																					ЭтотОбъект.СчетДоверительногоУправления,
																					ЭтотОбъект.Основание,
																					ЭтотОбъект.ЦенныеБумаги.ВыгрузитьКолонку("ЦеннаяБумага"),
																					УчетныйРегистр,
																					ЭтотОбъект.Дата,
																					ЭтотОбъект.МоментВремени());
			
			Для Каждого ДанныеПроводки Из ПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс Цикл
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.БухгалтерскийУчет, ДанныеПроводки.Сумма, "Сторно переоценки сделки Т+");
				
				Проводка.СчетДт = ДанныеПроводки.СчетДт;
				Проводка.СчетКт = ДанныеПроводки.СчетКт;
				
				ИндексСубконто = 1;
				
				Для Каждого ТекСубконто Из Проводка.СчетДт.ВидыСубконто Цикл
					Проводка.СубконтоДт[ТекСубконто.ВидСубконто] = ДанныеПроводки["СубконтоДт" + ИндексСубконто];
					ИндексСубконто = ИндексСубконто + 1;
				КонецЦикла;
				
				ИндексСубконто = 1;
				
				Для Каждого ТекСубконто Из Проводка.СчетКт.ВидыСубконто Цикл
					Проводка.СубконтоКт[ТекСубконто.ВидСубконто] = ДанныеПроводки["СубконтоКт" + ИндексСубконто];
					ИндексСубконто = ИндексСубконто + 1;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;	
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
	БухгалтерскийУчет.ПереоценитьВалютныеАктивы(ЭтотОбъект,УчетныйРегистр, Перечисления.ВидыУчета[УчетныйРегистр], НастройкиУчетаОбщие, Отказ);
	
КонецПроцедуры	

Функция РеквизитыСчета(Счет) Экспорт
	Возврат БухгалтерскийУчетПовтИсп.РеквизитыСчета(Счет);	
