		ВалютныйУчет = НастройкиУчетаАктива.СчетУчета.Валютный;
		
		ПараметрыПереоценки = Новый Структура("УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ",
												УчетныйРегистр,ВалютныйУчет,ВидСубконтоУчетаЦеннойБумаги,ЦеннаяБумага,ВалютаНоминала,ОбращаетсяНаОРЦБ);
												
		ЗначенияСубконтоСчетУчетаДС = Новый Структура;
												
		Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
			Если ЭтоСделка Или ЭтоИсполнение Тогда
				ЗначенияСубконтоСчетУчетаДС.Вставить("РасчетныйСчет", ЭтотОбъект.РасчетныйСчет); 
			ИначеЕсли ЭтоПоставка Тогда
				ЗначенияСубконтоСчетУчетаДС.Вставить("РасчетныйСчет", РеквизитыОснования.РасчетныйСчет); 
			КонецЕсли;	
		КонецЕсли;
		
		Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
			ЗначенияСубконтоСчетУчетаДС.Вставить("БрокерскиеКомпании", Брокер); 
		КонецЕсли;
		
		Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
			ЗначенияСубконтоСчетУчетаДС.Вставить("ДоговорыБрокерскогоОбслуживания", СубконтоДоговорыБрокерскогоОбслуживания);
		КонецЕсли;												
												
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // ПОКУПКА
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				ЗначенияСубконтоСчетУчетаДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.Покупка);
			КонецЕсли;					
				
		    // ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА ЗА ВЫЧЕТОМ РАСХОДОВ ПРИ ПОКУПКЕ И ИНДЕКСАЦИИ НОМИНАЛА
			//Индексация и так уже убрана в расчете партий
			СтоимостьПокупки = Выборка.Стоимость - Выборка.РасходыПриПокупкеВСтоимости;
			СтоимостьПокупкиВВалютеУчета = Выборка.СтоимостьВВалютеУчета - Выборка.РасходыПриПокупкеВСтоимостиВВалютеУчета;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], СтоимостьПокупкиВВалютеУчета, "Покупка ценной бумаги");
			
			// дебет
			Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			
			Проводка.КоличествоДт = Выборка.Количество;
			
			Если ВалютныйУчет Тогда
				Проводка.ВалютнаяСуммаДт = СтоимостьПокупки;
				Проводка.ВалютаДт = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Если ЭтоСделка Или ЭтоИсполнение Тогда
				Проводка.СчетКт = СчетУчетаДС;
				
				Для Каждого СтрокаВидСубконто из СчетУчетаДС.ВидыСубконто Цикл 
					Проводка.СубконтоКт[СтрокаВидСубконто.ВидСубконто]  = ЗначенияСубконтоСчетУчетаДС[СтрокаВидСубконто.ВидСубконто.ИмяПредопределенныхДанных];	
				КонецЦикла;	
							
				Если СчетУчетаДС.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.Сумма;
					Проводка.ВалютаКт = ЭтотОбъект.ВалютаСделки;
				КонецЕсли;
			Иначе // ЭтоПоставка	
				Проводка.СчетКт = СчетРасчетовПоСделке;
				Проводка.СубконтоКт.Контрагенты = Контрагент;
				
				Если ВалютнаяСделка Тогда
					Проводка.ВалютнаяСуммаКт = Выборка.Сумма;
					Проводка.ВалютаКт = ЭтотОбъект.ВалютаСделки;
				КонецЕсли;
			КонецЕсли;	
			
			// ПРИХОДУЕМ РАСХОДЫ НА СТОИМОСТЬ ТЕЛА
			Если Выборка.РасходыПриПокупкеВСтоимости <> 0 Тогда 
				
				ЭтоПокупкаИВключатьВСтоимостьТПлюс = Ложь;
				
				Если ЭтоСделка Тогда
					Если НЕ ЭтотОбъект.ОтложенноеИсполнение
						И ВидСделки = Перечисления.ВидыСделок.Покупка
						И НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда // редкий случай: Покупка + ВключатьВСтоимость + Т+
						
						ЭтоПокупкаИВключатьВСтоимостьТПлюс = Истина;
						
					КонецЕсли;	
				КонецЕсли;	
				
				Если ЭтоПокупкаИВключатьВСтоимостьТПлюс Тогда // редкий случай: Покупка + ВключатьВСтоимость + Т+
					
					СуммаТорговойКомиссии = ЭтотОбъект.ЦенныеБумаги[Выборка.НомерСтроки - 1].ТорговаяКомиссия;
					Если ЗначениеЗаполнено(ЭтотОбъект.ВалютаТорговойКомиссии) Тогда
						СуммаТорговойКомиссииВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаТорговойКомиссии, ЭтотОбъект.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);					
					Иначе
						СуммаТорговойКомиссииВВалютеУчета = СуммаТорговойКомиссии;					
					КонецЕсли;	
					
					// торговая комиссия на стоимость
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], СуммаТорговойКомиссииВВалютеУчета, "Покупка ценной бумаги");
					
					// дебет
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
					Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаДт = СуммаТорговойКомиссии;
						Проводка.ВалютаДт = ВалютаНоминала;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = СчетУчетаКомиссии;
					
					Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
					КонецЕсли;
					
					Если ЕстьСубконтоСделкиПоКомиссии Тогда
						Проводка.СубконтоКт.Сделка = Сделка;
					КонецЕсли;
					
					Если ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии Тогда
						Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
					КонецЕсли;
					
					// брокерская комиссия на стоимость
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Выборка.РасходыПриПокупкеВСтоимостиВВалютеУчета - СуммаТорговойКомиссииВВалютеУчета, "Покупка ценной бумаги");
					
					// дебет
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
					Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаДт = Выборка.РасходыПриПокупкеВСтоимости - СуммаТорговойКомиссии;
						Проводка.ВалютаДт = ВалютаНоминала;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = СчетУчетаКомиссииБрокера;
					
					Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
						Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
					КонецЕсли;
					
					Если ЕстьСубконтоСделкиПоКомиссии Тогда
						Проводка.СубконтоКт.Сделка = Сделка;
					КонецЕсли;
					
					Если СчетУчетаКомиссииБрокера.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
						Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
					КонецЕсли;
					
				Иначе
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Выборка.РасходыПриПокупкеВСтоимостиВВалютеУчета, "Покупка ценной бумаги");
					
					// дебет
					Проводка.СчетДт = НастройкиУчетаАктива.СчетУчета;
					Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
					
					Если ВалютныйУчет Тогда
						Проводка.ВалютнаяСуммаДт = Выборка.РасходыПриПокупкеВСтоимости;
						Проводка.ВалютаДт = ВалютаНоминала;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
					
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
					Проводка.СубконтоКт.Сделка      = Сделка;
				
				КонецЕсли;
				
			КонецЕсли;
					
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				// ПРИХОДУЕМ СТОИМОСТЬ КУПЛЕННОГО КУПОНА
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Выборка.СтоимостьКупонаВВалютеУчета, "Покупка ценной бумаги (купон)");
				
				// дебет
				Проводка.СчетДт = НастройкиУчетаКупона.СчетУчета;
				Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
				
				Если ВалютныйУчет Тогда
					Проводка.ВалютнаяСуммаДт 	= Выборка.СтоимостьКупона;
					Проводка.ВалютаДт 			= ВалютаНоминала;
				КонецЕсли;
				
				// кредит
				Если ЭтоСделка Или ЭтоИсполнение Тогда
					Проводка.СчетКт = СчетУчетаДС;
					Для Каждого СтрокаВидСубконто из СчетУчетаДС.ВидыСубконто Цикл 
						Проводка.СубконтоКт[СтрокаВидСубконто.ВидСубконто]  = ЗначенияСубконтоСчетУчетаДС[СтрокаВидСубконто.ВидСубконто.ИмяПредопределенныхДанных];	
					КонецЦикла;					
									
					Если СчетУчетаДС.Валютный Тогда
						Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
						Проводка.ВалютаКт		 = ЭтотОбъект.ВалютаСделки;
					КонецЕсли;
				Иначе // ЭтоПоставка	
					Проводка.СчетКт = СчетРасчетовПоСделке;
					Проводка.СубконтоКт.Контрагенты = Контрагент;
					
					Если ВалютнаяСделка Тогда
						Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
						Проводка.ВалютаКт = ЭтотОбъект.ВалютаСделки;
					КонецЕсли;
				КонецЕсли;	
			
			КонецЕсли;
			
			БухгалтерскийУчет.ПроизвестиПереоценкуБумагиИКупонаБУНУ(ЭтотОбъект, ПараметрыПереоценки, Выборка, НастройкиУчетаАктива, НастройкиУчетаКупона);
						
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда // ПРОДАЖА	
			
			Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
				ЗначенияСубконтоСчетУчетаДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.Продажа);
			КонецЕсли;					
			
			//Перекурсовка #452426. Изменен запрос, добавлено соединение, отдельные поля для курсовой разницы
			Если Выборка.СтоимостьВВалютеУчетаПерекурсовка <> 0 
				ИЛИ Выборка.ПереоценкаВВалютеУчетаПерекурсовка <> 0 
				ИЛИ Выборка.СтоимостьКупонаВВалютеУчетаПерекурсовка <> 0 
				ИЛИ Выборка.ПереоценкаКупонаВВалютеУчетаПерекурсовка <> 0 Тогда
				
				ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЦеннаяБумага, ЭтотОбъект.Рынок,
				Выборка.СтоимостьВВалютеУчетаПерекурсовка, Выборка.СтоимостьКупонаВВалютеУчетаПерекурсовка, Выборка.ПереоценкаВВалютеУчетаПерекурсовка, Выборка.ПереоценкаКупонаВВалютеУчетаПерекурсовка);
				
				// когда учитываем на партиях стоимость и переоценку отдельно, а на счетах вместе, то проводку нужно делать одну
				// у Кольского такая ситуация - #576917
				Если НастройкиУчетаАктива.СчетУчета = НастройкиУчетаАктива.СчетУчетаПереоценки Тогда
					ПараметрыПерекурсовки.СтоимостьВВалютеУчета = ПараметрыПерекурсовки.СтоимостьВВалютеУчета + ПараметрыПерекурсовки.ПереоценкаВВалютеУчета;
					ПараметрыПерекурсовки.ПереоценкаВВалютеУчета = 0;
				КонецЕсли;
				Если НастройкиУчетаКупона.СчетУчета = НастройкиУчетаКупона.СчетУчетаПереоценки Тогда
					ПараметрыПерекурсовки.СтоимостьКупонаВВалютеУчета = ПараметрыПерекурсовки.СтоимостьКупонаВВалютеУчета + ПараметрыПерекурсовки.ПереоценкаКупонаВВалютеУчета;
					ПараметрыПерекурсовки.ПереоценкаКупонаВВалютеУчета = 0;
				КонецЕсли;
				
				БухгалтерскийУчет.НачислитьКурсовуюРазницуБумагиИКупонаНУБУ(ЭтотОбъект, ПараметрыПерекурсовки, УчетныйАктив, НастройкиУчетаАктива, УчетныйАктивКупона, НастройкиУчетаКупона, УчетныйРегистр, ОбращаетсяНаОРЦБ, Отказ);
				
			КонецЕсли;
			
			
			Если Выборка.ИндексацияНоминалаДоначислено <> 0 ИЛИ Выборка.ИндексацияНоминалаЗаВремяВладенияДоначислено <> 0 Тогда
				
				АналитикаДоходовОтИндексацииНоминала = НастройкиУчетаАктива.АналитикаДоходовИндексацииНоминала;
				
				Если Выборка.ИндексацияНоминалаДоначислено <> 0 Тогда
					СчетУчетаИндексацииНоминала = НастройкиУчетаАктива.СчетУчетаИндексацииНоминала;
				Иначе
					СчетУчетаИндексацииНоминала = НастройкиУчетаАктива.СчетУчетаИндексацииНоминалаЗаВремяВладения;
				КонецЕсли;
				
				ПараметрыИндексацииНоминала = Новый Структура("ЦеннаяБумага, ИндексацияНоминала, КупонныйДоход, ТаблицаНепринимаемойИндексацииНоминалов",
					ЦеннаяБумага, 
					Выборка.ИндексацияНоминалаДоначислено + Выборка.ИндексацияНоминалаЗаВремяВладенияДоначислено,  
					?(ЗначениеЗаполнено(ЭтотОбъект.ВалютаСделки), РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Выборка.СуммаКупона, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ), Выборка.СуммаКупона) 
						- Выборка.СтоимостьКупонаВВалютеУчета - Выборка.ПереоценкаКупонаВВалютеУчета,
					ТаблицаНепринимаемойИндексацииНоминалов);
					
				БухгалтерскийУчет.ДвижениеИндексацииНоминала(ЭтотОбъект,
					ЭтотОбъект.Движения[УчетныйРегистр],
					ПараметрыИндексацииНоминала,
					АналитикаДоходовОтИндексацииНоминала,
					СчетУчетаИндексацииНоминала,
					ОбращаетсяНаОРЦБ,
					Отказ);
				
			КонецЕсли;
			
			РесурсыКСписанию = "Стоимость, СтоимостьВВалютеУчета, Переоценка, ПереоценкаВВалютеУчета";
			ПараметрыСписания = Новый Структура(РесурсыКСписанию);
			ЗаполнитьЗначенияСвойств(ПараметрыСписания, Выборка, РесурсыКСписанию);
			
			Если НастройкиУчетаАктива.СчетУчета = НастройкиУчетаАктива.СчетУчетаПереоценки Тогда
				ПараметрыСписания.Стоимость = ПараметрыСписания.Стоимость + ПараметрыСписания.Переоценка;
				ПараметрыСписания.Переоценка = 0;

				ПараметрыСписания.СтоимостьВВалютеУчета = ПараметрыСписания.СтоимостьВВалютеУчета + ПараметрыСписания.ПереоценкаВВалютеУчета;
				ПараметрыСписания.ПереоценкаВВалютеУчета = 0;
			КонецЕсли;
			
			
			БухгалтерскийУчет.ПроизвестиПереоценкуБумагиИКупонаБУНУ(ЭтотОбъект, ПараметрыПереоценки, Выборка, НастройкиУчетаАктива, НастройкиУчетаКупона);
			
			// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПРОДАННОЙ БУМАГИ В РАСХОДЫ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ПараметрыСписания.СтоимостьВВалютеУчета, "Продажа ценной бумаги");
			
