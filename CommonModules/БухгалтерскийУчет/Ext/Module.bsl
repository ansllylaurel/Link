
#Область Расчет_доходности

// Рассчитывает доходность и дюрацию по потоку
//
// Параметры:
//  ДенежныйПоток	- ТаблицаЗначений		- первая колонка - даты, вторая - суммы
//  Дата			- Дата					- дата покупки
//  Цена			- Число					- цена покупки, включая купон, переданная со знаком "минус"
//	Точность		- Число, Неопределено	- точность результата, при котором следует прекратить расчеты.
//											  Если значение не задано, будет использована точность 0.0000001 
// 
// Возвращаемое значение:
//   Структура - Содержит два ключа Доходность и Дюрация
//
Функция РассчитатьДоходностьИДюрациюПоПотоку(ДенежныйПоток, Дата, Знач Цена, Точность = Неопределено) Экспорт
	
	Цена = Абс(Цена);
	
	Итерация = 0;
	ДоходностьМин = 3;
	ДоходностьМакс = 20;
	
	МаксИтераций = 100;
	Если Точность = Неопределено Тогда
		Точность = 0.0000001;
	ИначеЕсли Точность = 0.0000000001 Тогда // #462467 группа Будущее стандартизировали все
		МаксИтераций = 1000;
	КонецЕсли;
	
	ТаблицаПотока = Новый ТаблицаЗначений;
	ТаблицаПотока.Колонки.Добавить("Поток", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаПотока.Колонки.Добавить("Период", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("Фактор", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("НпвМин", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("НпвМакс", Новый ОписаниеТипов("Число"));
	
	Для каждого СтрокаПотока Из ДенежныйПоток Цикл
	
		НоваяСтрока = ТаблицаПотока.Добавить();
		НоваяСтрока.Дата = СтрокаПотока[0];
		НоваяСтрока.Поток = СтрокаПотока[1];
		НоваяСтрока.Период = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(НоваяСтрока.Дата, Дата);
		НоваяСтрока.Фактор = НоваяСтрока.Период / 365;
		
	КонецЦикла; 
	
		
	Пока Итерация < МаксИтераций и ДоходностьМин > -100 и ДоходностьМакс > -100 Цикл
		
		Для каждого СтрокаПотока Из ТаблицаПотока Цикл
		
			СтрокаПотока.НпвМин = СтрокаПотока.Поток / Pow(1+ДоходностьМин/100, СтрокаПотока.Фактор);
			СтрокаПотока.НпвМакс = СтрокаПотока.Поток / Pow(1+ДоходностьМакс/100, СтрокаПотока.Фактор);
		
		КонецЦикла; 
		
		НпвМин = ТаблицаПотока.Итог("НпвМин") - Цена;
		НпвМакс = ТаблицаПотока.Итог("НпвМакс") - Цена;

		Если Абс(НпвМин) < Точность или Абс(НпвМакс) < Точность Тогда
		
			Прервать;
		
		КонецЕсли; 
		
		Дельта = ДоходностьМакс - ДоходностьМин;
		
		Если Абс(Дельта) < Точность Тогда
		
			Прервать;
		
		КонецЕсли;
		
		
		Если Знак(НпвМин) * Знак(НпвМакс) > 0 и абс(НпвМин)  < абс(НпвМакс) Тогда 
			НовыйМин = ДоходностьМин - НпвМин * Дельта / (НпвМакс - НпвМин) * 1.01;
		ИначеЕсли Знак(НпвМин) * Знак(НпвМакс) > 0 и абс(НпвМакс) < абс(НпвМин) Тогда 
			НовыйМин = ДоходностьМакс;
		ИначеЕсли Знак(НпвМин) * Знак(НпвМакс) < 0 и абс(НпвМин)  > абс(НпвМакс) Тогда 
			НовыйМин = ДоходностьМин - НпвМин * Дельта / (НпвМакс - НпвМин);
		Иначе                                                                          
			НовыйМин = ДоходностьМин;
		КонецЕсли; 
		
		Если Знак(НпвМин) * Знак(НпвМакс) > 0 и абс(НпвМакс) < абс(НпвМин) Тогда 
			НовыйМакс = ДоходностьМакс + НпвМакс * Дельта / (НпвМин - НпвМакс) * 1.01;
		ИначеЕсли Знак(НпвМин) * Знак(НпвМакс) > 0 и абс(НпвМин)  < абс(НпвМакс) Тогда 
			НовыйМакс = ДоходностьМин;
		ИначеЕсли Знак(НпвМин) * Знак(НпвМакс) < 0 и абс(НпвМакс) > абс(НпвМин) Тогда 
			НовыйМакс = ДоходностьМакс + НпвМакс * Дельта / (НпвМин - НпвМакс);
		Иначе                                                                          
			НовыйМакс = ДоходностьМакс;
		КонецЕсли; 
		
		Итерация = Итерация + 1;
		
		Если абс(НовыйМин - ДоходностьМин) > 2 * Абс(Дельта) Тогда
			ДоходностьМин = ДоходностьМин + Знак(НовыйМин - ДоходностьМин) * 2 * Абс(Дельта);
		Иначе
			ДоходностьМин = НовыйМин;
		КонецЕсли; 
		
		Если абс(НовыйМакс - ДоходностьМакс) > 2 * Абс(Дельта) Тогда
			ДоходностьМакс = ДоходностьМакс + Знак(НовыйМакс - ДоходностьМакс) * 2 * Абс(Дельта);
		Иначе
			ДоходностьМакс = НовыйМакс;
		КонецЕсли; 
		
		Если Итерация = МаксИтераций или ДоходностьМин <= -100 или ДоходностьМакс <= -100 Тогда
			Возврат Новый Структура("Доходность, Дюрация", 0, 0);
		КонецЕсли;	
		
	КонецЦикла; 	
	
	Доходность = ?(Абс(НпвМин) < Абс(НпвМакс), ДоходностьМин, ДоходностьМакс);
	
	Дюрация = 0;

	Для каждого СтрокаПотока Из ТаблицаПотока Цикл
			
		Дюрация = Дюрация + СтрокаПотока.Поток / Pow(1+Доходность/100, СтрокаПотока.Фактор) * СтрокаПотока.Период / Цена;
		
	КонецЦикла;
	
	Возврат Новый Структура("Доходность, Дюрация", Доходность, Дюрация);
	
КонецФункции

Функция Абс(Число)
	Возврат МатематическиеФункции.МодульЧисла(Число);
КонецФункции

Функция Знак(Число)
	Возврат МатематическиеФункции.ЗнакЧисла(Число); 
КонецФункции
 
#КонецОбласти 

Функция ВедетсяУчетЕПС(Дата, Организация, СчетДоверительногоУправления) Экспорт

	Возврат РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
				Дата,
				Организация,
				Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления),
				ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет"));

КонецФункции

Функция ПолучитьСвойстваСчета(Знач Счет) Экспорт

	ДанныеСчета = Новый Структура;
	ДанныеСчета.Вставить("Ссылка",             Неопределено);
	ДанныеСчета.Вставить("Наименование",       "");
	ДанныеСчета.Вставить("Код",                "");
	ДанныеСчета.Вставить("Родитель",           Неопределено);
	ДанныеСчета.Вставить("Вид",                Неопределено);
	ДанныеСчета.Вставить("Валютный",           Ложь);
	ДанныеСчета.Вставить("Количественный",     Ложь);
	ДанныеСчета.Вставить("КоличествоСубконто", 0);
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат ДанныеСчета;
	КонецЕсли;
	
	Для ИндексСубконто = 1 По РаботаСМетаданнымиПовтИсп.ПолучитьМаксимальноеКоличествоСубконто(Счет.Родитель) Цикл
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто,                   Неопределено);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "Наименование",  Неопределено);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "ТипЗначения",   Неопределено);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "ТолькоОбороты", Ложь);
	КонецЦикла;
	
	ДанныеСчета.Вставить("ИмяПланаСчетов",     РаботаСМетаданнымиПовтИсп.скПолучитьИмяПоСсылке(Счет));
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет", Счет);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основной.Ссылка,
		|	Основной.Родитель,
		|	Основной.Код,
		|	Основной.Наименование,
		|	Основной.Вид,
		|	Основной.Валютный,
		|	Основной.Количественный
		|ИЗ
		|	ПланСчетов.Основной КАК Основной
		|ГДЕ
		|	Основной.Ссылка = &Счет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновнойВидыСубконто.НомерСтроки КАК НомерСтроки,
		|	ОсновнойВидыСубконто.ВидСубконто КАК ВидСубконто,
		|	ОсновнойВидыСубконто.ВидСубконто.Наименование КАК Наименование,
		|	ОсновнойВидыСубконто.ВидСубконто.ТипЗначения КАК ТипЗначения,
		|	ОсновнойВидыСубконто.ТолькоОбороты КАК ТолькоОбороты
		|ИЗ
		|	ПланСчетов.Основной.ВидыСубконто КАК ОсновнойВидыСубконто
		|ГДЕ
		|	ОсновнойВидыСубконто.Ссылка = &Счет
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновнойВидыСубконто.НомерСтроки";
	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПланСчетов.Основной", "ПланСчетов." + ДанныеСчета.ИмяПланаСчетов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Выборка = МассивРезультатов[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
	КонецЕсли;
	
	ВыборкаВидыСубконто = МассивРезультатов[1].Выбрать();
		
	ДанныеСчета.КоличествоСубконто = ВыборкаВидыСубконто.Количество();
		
	ИндексСубконто = 0;
		
	Пока ВыборкаВидыСубконто.Следующий() Цикл
		ИндексСубконто = ИндексСубконто + 1;
		
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто,                   ВыборкаВидыСубконто.ВидСубконто);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "Наименование",  ВыборкаВидыСубконто.Наименование);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "ТипЗначения",   ВыборкаВидыСубконто.ТипЗначения);
		ДанныеСчета.Вставить("ВидСубконто" + ИндексСубконто + "ТолькоОбороты", ВыборкаВидыСубконто.ТолькоОбороты);
	КонецЦикла;
	
	Возврат ДанныеСчета;
	
КонецФункции

Функция СчетЯвляетсяГруппой(Счет) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.СчетЯвляетсяГруппой(Счет);
	
КонецФункции // СчетЯвляетсяГруппой

Функция СчетаВИерархии(СчетГруппа) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СчетГруппа) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетГруппа", СчетГруппа);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основной.Ссылка КАК Счет
		|ИЗ
		|	ПланСчетов." + РаботаСМетаданнымиПовтИсп.скПолучитьИмяПоСсылке(СчетГруппа) + " КАК Основной
		|ГДЕ
		|	Основной.Ссылка В ИЕРАРХИИ(&СчетГруппа)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");

КонецФункции

