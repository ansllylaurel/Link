Функция ОпределитьВидСубконтоУчетаЦеннойБумаги(Рынок) Экспорт
	
	Если      Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Акции;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Облигации;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Паи;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Векселя;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
		Возврат ПланыВидовХарактеристик.ВидыСубконто.Доли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда 
		Возврат ПланыВидовХарактеристик.ВидыСубконто.ИпотечныеСертификатыУчастия;  
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда 
		Возврат ПланыВидовХарактеристик.ВидыСубконто.ДепозитарныеРасписки;  
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	
КонецФункции // ОпределитьВидСубконтоУчетаЦеннойБумаги

Функция ОпределитьУчетныйАктивЕПС(Период, Рынок, Актив, СчетДоверительногоУправления = Неопределено) Экспорт
	
	Если Период = '00010101' ИЛИ Период = Неопределено Тогда  
		ДатаНастроек = Период;
	ИначеЕсли ТипЗнч(Период) = Тип("Дата") ИЛИ ТипЗнч(Период) = Тип("Граница") Тогда
		ДатаНастроек = КонецДня(СистемныеФункции.ПолучитьДатуИзГраницы(Период));
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный тип значения '%1' параметра 'Период'", ТипЗнч(Период));
	КонецЕсли;
	
	Возврат Кэширование.ОпределитьУчетныйАктивЕПС(ДатаНастроек, Рынок, Актив, СчетДоверительногоУправления);
	
КонецФункции

Функция ОпределитьУчетныйАктив(Период, Рынок, Актив, ЭтоКупон = Ложь) Экспорт
	
	ВалютаРубли	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат Справочники.УчетныеАктивы.Акции;
		Иначе
			Возврат Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов;	
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат Справочники.УчетныеАктивы.Паи;
		Иначе
			Возврат Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки Тогда
		Возврат Справочники.УчетныеАктивы.ДепозитарныеРасписки;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия Тогда
		Возврат Справочники.УчетныеАктивы.ИпотечныеСертификатыУчастия;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		Если Актив.ВалютаНоминала = ВалютаРубли Тогда
			Возврат ?(Актив.ТипВекселя = Перечисления.ТипыВекселей.Дисконтный, Справочники.УчетныеАктивы.ВекселяДисконтные, Справочники.УчетныеАктивы.ВекселяПроцентные);
		Иначе
			Возврат ?(Актив.ТипВекселя = Перечисления.ТипыВекселей.Дисконтный, Справочники.УчетныеАктивы.ВекселяДисконтныеВалютные, Справочники.УчетныеАктивы.ВекселяПроцентныеВалютные);
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда	
		Если Актив.ВалютаНоминала <> ВалютаРубли Тогда
			Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте;
				КонецЕсли;	
			Иначе
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ЕврооблигацииКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.Еврооблигации;
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли Период >= '2014-01-01 00:00:00' И Период <= '2015-03-31 23:59:59' Тогда
			//*********************************************************
			// 7ка целый год неправильно учитавала госкорпорации
			// она считала их госами!!!!!!!!!!!!!!!!
			Если Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда
				
				// определим, является ли эмитент гос. корпорацией
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма
					|ИЗ
					|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ЮрФизЛицо И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
					
				Запрос.УстановитьПараметр("Период",    Период);
				Запрос.УстановитьПараметр("ЮрФизЛицо", Актив.Эмитент.ЮрФизЛицо);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() И Выборка.ОрганизационноПравоваяФорма = Справочники.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация Тогда
					Если ЭтоКупон Тогда
						Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
					Иначе
						Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
					КонецЕсли;
				Иначе	
					Если ЭтоКупон Тогда
						Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон;
					Иначе
						Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративные;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				Если ЭтоКупон Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
				КонецЕсли;
			КонецЕсли;
			//*********************************************************
		Иначе
			Если ЭтоКупон Тогда
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Еврооблигация Тогда
					Возврат Справочники.УчетныеАктивы.ЕврооблигацииКупон;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Ипотечная Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон;
				КонецЕсли;
			Иначе
				Если Актив.Категория = Перечисления.КатегорииОблигаций.Еврооблигация Тогда
					Возврат Справочники.УчетныеАктивы.Еврооблигации;
				ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Корпоративная ИЛИ Актив.Категория = Перечисления.КатегорииОблигаций.Ипотечная Тогда
					Возврат Справочники.УчетныеАктивы.ОблигацииКорпоративные;
				Иначе
					Возврат Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Доли Тогда
		Возврат Справочники.УчетныеАктивы.Доли;
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
		Возврат Справочники.УчетныеАктивы.Фьючерсы;
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		Возврат Справочники.УчетныеАктивы.ДепозитныеВклады;
	ИначеЕсли ТипЗнч(Актив) = Тип("СправочникСсылка.Займы") Тогда
		ДатаПогашенияЗайма = РаботаСКредитнымиИнструментами.ПолучитьДатуПогашенияКредитногоИнструмента(Актив, Период);
		Если Актив.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный тогда
			Возврат Справочники.УчетныеАктивы.ЗаймыВыданные;
		ИначеЕсли ДатаПогашенияЗайма = Неопределено Тогда
			Возврат Неопределено;
		ИначеЕсли ДобавитьМесяц(ДатаПогашенияЗайма, -12) < Период Тогда
			Возврат Справочники.УчетныеАктивы.ЗаймыПолученныеКраткосрочные;
		Иначе
			Возврат Справочники.УчетныеАктивы.ЗаймыПолученныеДолгосрочные;
		КонецЕсли;
		
	КонецЕсли;

КонецФункции // ОпределитьУчетныйАктив

Функция ОпределитьСчетУчетаДенежныхСредств(Период, Организация, СчетДоверительногоУправления, Валюта, Брокер) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.СчетУчетаДенежныхСредств КАК СчетУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
	Если Организация.ВалютаУчета = Валюта Тогда
		Если Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			ИмяПоля = "СчетУчетаДенежныхСредств";
		Иначе
			ИмяПоля = "СчетУчетаДенежныхСредствУБрокера";
		КонецЕсли;
	Иначе
		Если Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			ИмяПоля = "СчетУчетаВалютныхСредств";
		Иначе
			ИмяПоля = "СчетУчетаВалютныхСредствУБрокера";
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетУчетаДенежныхСредств", ИмяПоля);

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Организация",                  Организация);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетУчета;
	Иначе
		Если Организация.ВалютаУчета = Валюта Тогда
			Если Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				Возврат ПланыСчетов.Основной.РасчетныеСчета;
			Иначе
				Возврат ПланыСчетов.Основной.ДенежныеСредстваУБрокера;
			КонецЕсли;
		Иначе
			Если Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
				Возврат ПланыСчетов.Основной.ВалютныеСчета;
			Иначе
				Возврат ПланыСчетов.Основной.ВалютныеСредстваУБрокера;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ОпределитьСчетУчетаДенежныхСредств

Функция ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(Период, Организация, СчетДоверительногоУправления, ВидОперации) Экспорт

	Если (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозмещениеРасходовВИмуществоФондаЗаСчетУправляющейКомпании)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыделениеДенежныхСредствДляСобственныхСделок)
		Или (ВидОперации = Неопределено)
	Тогда
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих Тогда
			Возврат ПланыСчетов.Основной.ЦелевоеФинансированиеВоеннойИпотекиПереданноеВОтчетномГоду; // 86.4.1 - без субконто
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиУчетаОбщиеСрезПоследних.СчетРасчетовПоДоговоруДоверительногоУправления КАК СчетУчета
				|ИЗ
				|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";

			Запрос.УстановитьПараметр("Период",                       Период);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Выборка.СчетУчета;
			Иначе
				Возврат ПланыСчетов.Основной.РасчетыПоДоговоруДоверительногоУправленияИмуществом; // 79.3 - контрагенты
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПеречислениеНедополученногоДоходаПоУсловиямДоверительногоУправления Тогда 
		Возврат ПланыСчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками; // 76.5 - Расчеты с прочими поставщиками и подрядчиками
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратИзлишнеУдержанногоВознаграждения Тогда
		Возврат ПланыСчетов.Основной.РасчетыПоАвансамВыданным; // 60.2 - Расчеты по авансам выданным
	 
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратИзлишнеУдержаннойКомиссии Тогда
		Возврат ПланыСчетов.Основной.УслугиБрокера; // 60.5 - контрагенты, договоры
		
	ИначеЕсли (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваДоходПоПаямЗПИФ)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваПроцентЗаПользованиеДенежнымиСредствами)
	Тогда
		Возврат ПланыСчетов.Основной.ПрочиеДоходы; // 91.1.1 - комментарии излишни
		
	ИначеЕсли (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОшибочноЗачисленные) 	
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы) Тогда  // прочие сюда, так их лучше видно для корректного отнесения
		Возврат ПланыСчетов.Основной.РасчетыПоПретензиям; // 76.2 - контрагенты
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР Тогда
		Возврат ПланыСчетов.Основной.ЦелевоеФинансированиеПФРПереданноеВОтчетномГоду; // 86.3.1 - транш (ввод дс)
		
	ИначеЕсли (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствИспользованныхДляСобственныхСделок)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствСПереводомВсехАктивовНаДругойИИС)
	Тогда
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих Тогда
			Возврат ПланыСчетов.Основной.ЦелевоеФинансированиеВоеннойИпотекиВозврат; // 86.4.2 - без субконто
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиУчетаОбщиеСрезПоследних.СчетРасчетовПоДоговоруДоверительногоУправления КАК СчетУчета
				|ИЗ
				|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";

			Запрос.УстановитьПараметр("Период",                       Период);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				Возврат Выборка.СчетУчета;
			Иначе
				Возврат ПланыСчетов.Основной.РасчетыПоДоговоруДоверительногоУправленияИмуществом; // 79.3 - контрагенты
			КонецЕсли;
		КонецЕсли;		
	ИначеЕсли (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных) 
			Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы) Тогда // прочие сюда, так их лучше видно для корректного отнесения
		Возврат ПланыСчетов.Основной.РасчетыПоПретензиям; // 76.2 - контрагенты
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД Тогда
		Возврат ПланыСчетов.Основной.ЧастьПенсионныхВзносовДляОбеспеченияИОУДПеречисленно; // 79.5.2 - контрагенты
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.СчетУчетаГодовогоФинасовогоРезультата КАК СчетУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
		Запрос.УстановитьПараметр("Период",                       Период);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.СчетУчета;
		Иначе
			Возврат ПланыСчетов.Основной.ПрибыльУбытокДУТекущегоПериода; // 79.4.1 - контрагенты
		КонецЕсли;
		
	ИначеЕсли ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР Тогда
		Возврат ПланыСчетов.Основной.РасчетыСАгентами; // 76.10 - контрагенты
		
	ИначеЕсли (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПайщика)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПриНеудачномВыводеДенежныхСредствПайщику)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВводДенежныхСредствПриОбменеПаев)
		Или (ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствПриОбменеПаев)
	Тогда
		Возврат ПланыСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами; // 76.9 - контрагенты
		
	КонецЕсли;

КонецФункции // ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления

Функция ОпределитьСчетУчетаАктивов(Период, Организация, СчетДоверительногоУправления, УчетныйАктив, ВидУчета, ВЗалоге=Ложь) Экспорт

	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		ВидУчетаПеречисление = Перечисления.ВидыУчета[ВидУчета];
	Иначе
		ВидУчетаПеречисление = ВидУчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив = &УчетныйАктив
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("УчетныйАктив",                 УчетныйАктив);
	Запрос.УстановитьПараметр("ВидУчета", 					  ВидУчетаПеречисление);

	Если ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиУчетаАктивов", "НастройкиУчетаАктивовЕПС");
	КонецЕсли;
	Если ВЗалоге Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".СчетУчета", ".СчетУчетаВЗалоге");
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетУчета;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ДепозитныеВклады Тогда
		Возврат ПланыСчетов.Основной.ДепозитныеСчета;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Акции Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.АкцииВЗалоге, ПланыСчетов.Основной.Акции); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.АкцииИностранныхЭмитентовВЗалоге, ПланыСчетов.Основной.АкцииИностранныхЭмитентов); 		
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Паи Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ПаиВЗалоге, ПланыСчетов.Основной.Паи);
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяДисконтные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ВекселяВЗалоге, ПланыСчетов.Основной.Векселя);
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяПроцентные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ВекселяВЗалоге, ПланыСчетов.Основной.Векселя);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.КорпоративныеОблигациивЗалоге, ПланыСчетов.Основной.КорпоративныеОблигацииТело);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ГосударственныеОблигацииВЗалоге, ПланыСчетов.Основной.ГосударственныеОблигацииТело);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.КорпоративныеОблигацииВЗалогеКупон, ПланыСчетов.Основной.КорпоративныеОблигацииКупон);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ГосударственныеОблигацииВЗалогеКупон, ПланыСчетов.Основной.ГосударственныеОблигацииКупон);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Еврооблигации Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеТело, ПланыСчетов.Основной.ЕврооблигацииТело);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ЕврооблигацииКупон Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеКупон, ПланыСчетов.Основной.ЕврооблигацииКупон);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеТело, ПланыСчетов.Основной.ЕврооблигацииТело);
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеКупон, ПланыСчетов.Основной.ЕврооблигацииКупон) ;
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаМНО
		ИЛИ УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаСМО
		ИЛИ УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаФЕО
	Тогда
		Возврат ПланыСчетов.Основной.ПроцентыПоМинимальномуНеснижаемомуОстатку;
		
	КонецЕсли;
	
КонецФункции // ОпределитьСчетУчетаАктивов

Функция ОпределитьСчетУчетаПереоценкиАктивов(Период, Организация, СчетДоверительногоУправления, УчетныйАктив, ВидУчета, ВЗалоге=Ложь) Экспорт

	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		ВидУчетаПеречисление = Перечисления.ВидыУчета[ВидУчета];
	Иначе
		ВидУчетаПеречисление = ВидУчета;
	КонецЕсли;
	
	Если ВидУчетаПеречисление=Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		//для ЕПС другие настройки и активы
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив = &УчетныйАктив
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("УчетныйАктив",                 УчетныйАктив);
	Запрос.УстановитьПараметр("ВидУчета", 					  ВидУчетаПеречисление);

	Если ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиУчетаАктивов", "НастройкиУчетаАктивовЕПС");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетУчетаПереоценки", "СчетУчетаПереоценкиА КАК СчетУчетаПереоценки");
	КонецЕсли;
	Если вЗалоге Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".СчетУчетаПереоценки", ".СчетУчетаПереоценкиВЗалоге");
	КонецЕсли;	
	
	
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетУчетаПереоценки;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ДепозитныеВклады Тогда
		Возврат ПланыСчетов.Основной.ПроцентыПоДепозитнымВкладам;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Акции Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.АкцииВЗалогеПереоценка, ПланыСчетов.Основной.ПереоценкаАкций); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.АкцииИностранныхЭмитентовВЗалогеПереоценка, ПланыСчетов.Основной.ПереоценкаАкцийИностранныхЭмитентов); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Паи Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ПаиВЗалогеПереоценка, ПланыСчетов.Основной.ПереоценкаПаев); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяДисконтные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ВекселяВЗалоге, ПланыСчетов.Основной.ПереоценкаВекселей);  //не знаю, что ставить, нет отдельного счета переоценки
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяПроцентные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ВекселяВЗалоге, ПланыСчетов.Основной.ПереоценкаВекселей); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.КорпоративныеОблигациивЗалогеПереоценкаТела, ПланыСчетов.Основной.ПереоценкаКорпоративныхОблигацийТело); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ГосударственныеОблигацииВЗалогеПереоценкаТела, ПланыСчетов.Основной.ПереоценкаГосударственныхОблигацийТело); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.КорпоративныеОблигацииВЗалогеКупонНачисленный, ПланыСчетов.Основной.ПереоценкаКорпоративныхОблигацийКупон); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ГосударственныеОблигацииВЗалогеКупонНачисленный, ПланыСчетов.Основной.ПереоценкаГосударственныхОблигацийКупон); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Еврооблигации Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеПереоценкаТела, ПланыСчетов.Основной.ПереоценкаЕврооблигацийТело); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ЕврооблигацииКупон Тогда
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеКупонНачисленный, ПланыСчетов.Основной.ПереоценкаЕврооблигацийКупон); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеПереоценкаТела, ПланыСчетов.Основной.ПереоценкаЕврооблигацийТело); 
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон И НЕ вЗалоге Тогда	
		Возврат ?(ВЗалоге, ПланыСчетов.Основной.ЕврооблигацииВЗалогеКупонНачисленный, ПланыСчетов.Основной.ПереоценкаЕврооблигацийКупон); 
				
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаМНО
		ИЛИ УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаСМО
		ИЛИ УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаФЕО
	Тогда
		Возврат ПланыСчетов.Основной.ПроцентыПоМинимальномуНеснижаемомуОстатку;
		
	КонецЕсли;
	
КонецФункции // ОпределитьСчетУчетаПереоценкиАктивов

Функция ОпределитьСчетРезерваПодОбесценение(УчетныйАктив, ЭтоНачисленныйКупон = Ложь) Экспорт

	Если УчетныйАктив = Справочники.УчетныеАктивы.Акции Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеАкций;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Паи Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеПаев;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяДисконтные Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеВекселей;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ВекселяПроцентные Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеВекселей;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративные Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеКорпоративныхОблигацийТело;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные Тогда
		Возврат ПланыСчетов.Основной.РезервыПодОбесценениеГосударственныхОблигацийТело;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон Тогда
		Возврат ?(ЭтоНачисленныйКупон, ПланыСчетов.Основной.РезервыПодОбесценениеКорпоративныхОблигацийКупонНачисленный, ПланыСчетов.Основной.РезервыПодОбесценениеКорпоративныхОблигацийКупон);
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон Тогда
		Возврат ?(ЭтоНачисленныйКупон, ПланыСчетов.Основной.РезервыПодОбесценениеГосударственныхОблигацийКупонНачисленный, ПланыСчетов.Основной.РезервыПодОбесценениеГосударственныхОблигацийКупон);
		
	КонецЕсли;
	
КонецФункции // ОпределитьСчетРезерваПодОбесценение

Функция ОпределитьСчетРезерваПоСомнительнымДолгам(УчетныйАктив) Экспорт

	Если УчетныйАктив = Справочники.УчетныеАктивы.Акции Тогда
		Возврат ПланыСчетов.Основной.РезервыПоСомнительнымДолгамАкции;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.Паи Тогда
		Возврат ПланыСчетов.Основной.РезервыПоСомнительнымДолгамПаи;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииКорпоративные Тогда
		Возврат ПланыСчетов.Основной.РезервыПоСомнительнымДолгамКорпоративныеОблигации;
		
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные Тогда
		Возврат ПланыСчетов.Основной.РезервыПоСомнительнымДолгамГосударственныеОблигации;
		
	КонецЕсли;
	
КонецФункции // ОпределитьСчетРезерваПоСомнительнымДолгам

Функция ОпределитьДанныеУчетаДивидендов(Период, Организация, СчетДоверительногоУправления, ВидУчета, УчетныйАктив) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаДивидендов,
		|	НастройкиУчетаАктивовСрезПоследних.ВыделятьНалогПоДивидендам,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов,
		|	НастройкиУчетаАктивовСрезПоследних.СпособОтраженияДивидендов
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И УчетныйАктив = &УчетныйАктив) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("УчетныйАктив", 					УчетныйАктив);
	
	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		Запрос.УстановитьПараметр("ВидУчета",               Перечисления.ВидыУчета[ВидУчета]);
	Иначе
		Запрос.УстановитьПараметр("ВидУчета",               ВидУчета);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("СчетУчетаДивидендов,ВыделятьНалогПоДивидендам,СпособОтраженияДивидендов,АналитикаДоходов", 
				Выборка.СчетУчетаДивидендов,
				Выборка.ВыделятьНалогПоДивидендам,
				Выборка.СпособОтраженияДивидендов,
				Выборка.АналитикаДоходов);
	Иначе
		Возврат Новый Структура("СчетУчетаДивидендов", ПланыСчетов.Основной.ПустаяСсылка());
	КонецЕсли;

КонецФункции // ОпределитьДанныеУчетаДивидендов

////////////////////////////////////////////////////////////////////////////////
Функция РезервПИФНачисляетсяВУчете(Период, Организация, СчетДоверительногоУправления, Резерв, ВидУчета = Неопределено) Экспорт
	
	// Если Период меньше даты начала учета резервов, возвращаем Ложь
	Если Период < СистемныеФункции.ПолучитьДатуНачалаУчетаРезервовПИФ() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Пока настройки отличаются только в учете бэк-офиса.
	// Для бухгалтерского учета используется СчетаДоверительногоУправления.НачислятьРезервыПредстоящихРасходов()
	// Другие виды учета у ПИФов пока не используются.
	// ВидУчета = Неопределено - это учет в бэк-офисе (в перечислении ВидыУчета нет соответствующего значения)
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если Не ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ВидУчета = Неопределено Тогда
		СтрУчет = "ВБэкОфисе";
		
		// Определим наименование настройки учета по виду резерва
		Если Резерв = Справочники.Резервы.ВознаграждениеУправляющего Тогда
			ИмяНастройки = "НачислятьРезервыЗаВознаграждениеУправляющего" + СтрУчет;		
		ИначеЕсли Резерв = Справочники.Резервы.ВознаграждениеДепозитарияАудитораОценщика Тогда
			ИмяНастройки = "НачислятьРезервыЗаВознаграждениеДепозитария" + СтрУчет;
		ИначеЕсли Резерв = Справочники.Резервы.ПрочиеВозмещаемыеРасходыУправляющего Тогда	
			ИмяНастройки = "НачислятьРезервыЗаПрочиеВозмещаемыеРасходыУправляющего" + СтрУчет;
		Иначе
			//Другие виды резерва не учитываем
			Возврат Ложь;
		КонецЕсли;
		
		Возврат ОпределитьУсловияПравилПаевогоИнвестиционногоФонда(Период, СчетДоверительногоУправления, ИмяНастройки)[ИмяНастройки];
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки) Экспорт
	
	Возврат Кэширование.ОпределитьНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки);
	
КонецФункции // ОпределитьНастройкуУчета

Функция ОпределитьНастройкиУчета(Период, Организация, СчетДоверительногоУправления) Экспорт
	
	СписокРесурсов = "";
	Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиУчетаОбщие.Ресурсы Цикл
		СписокРесурсов = СписокРесурсов + Ресурс.Имя + ",";
	КонецЦикла;
	НастройкиУчета = Новый Структура(Лев(СписокРесурсов, СтрДлина(СписокРесурсов) - 1));

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(НастройкиУчета, Выборка, СписокРесурсов);
	КонецЦикла;

	// Расчетные настройки
	РасчетныеНастройки = ОпределитьРасчетныеНастройкиУчета(Период, Организация, Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Для Каждого ЗначениеНастройки Из РасчетныеНастройки Цикл
		НастройкиУчета.Вставить(ЗначениеНастройки.Ключ, ЗначениеНастройки.Значение);
	КонецЦикла;
	
	НастройкиУчета.Вставить("НастройкиУчетаЦенныхБумаг", ОпределитьНастройкиУчетаЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, "ПолучитьСписокНастроекДляРасчета"));
	
	Возврат НастройкиУчета;
	
КонецФункции // ОпределитьНастройкиУчета

Функция ОпределитьУсловияПравилПаевогоИнвестиционногоФонда(Период, Знач ПаевойИнвестиционныйФонд, Знач НаборУсловий = "") Экспорт
	
	Если Не ЗначениеЗаполнено(НаборУсловий) Тогда
		Для каждого Ресурс Из Метаданные.РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.Ресурсы Цикл
			НаборУсловий = НаборУсловий + ?(ПустаяСтрока(НаборУсловий), "", ", ") + Ресурс.Имя;
		КонецЦикла;
	КонецЕсли;
	
	НастройкиУчета = Новый Структура(НаборУсловий);

	Если ТипЗнч(ПаевойИнвестиционныйФонд) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		
		КлиентыДоверительногоУправленияСрезПоследних =
			РегистрыСведений.КлиентыДоверительногоУправления.СрезПоследних(
				Период,
				Новый Структура("СчетДоверительногоУправления", ПаевойИнвестиционныйФонд));
				
		Если КлиентыДоверительногоУправленияСрезПоследних.Количество() = 0 Тогда
			ВызватьИсключение "Не удалось определить клиента доверительного управления для счета д/у '" + ПаевойИнвестиционныйФонд + "' на дату " + Период + " при вызове ОпределитьУсловияПравилПаевогоИнвестиционногоФонда";
		КонецЕсли;
		
		ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних[0].Клиент;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПоляРегистра КАК ПоляРегистра
		|ИЗ
		|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&Период, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФонда";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРегистра КАК ПоляРегистра", НаборУсловий);
	
	Запрос.УстановитьПараметр("Период",                   Период);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", ПаевойИнвестиционныйФонд);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НастройкиУчета, Выборка);
	КонецЕсли;

	Возврат НастройкиУчета;
	
КонецФункции // ОпределитьУсловияПравилПаевогоИнвестиционногоФонда

Функция ОпределитьРасчетнуюНастройкуУчета(Период, Организация, СчетДоверительногоУправления, ИмяНастройки, ЗначениеНастройки) Экспорт
	РасчетныеНастройки = ОпределитьРасчетныеНастройкиУчета(Период, Организация, СчетДоверительногоУправления);  
	
	Возврат РасчетныеНастройки.Свойство(ИмяНастройки, ЗначениеНастройки);
КонецФункции

Функция ОпределитьРасчетныеНастройкиУчета(Период, Организация, СчетДоверительногоУправления) Экспорт
	
	ЭтоКлиентБудущее = БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, Период);
	
	КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	ЭтоКлиентСНГ	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"));
	ЭтоКлиентВолга	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал"));
	ЭтоКлиентППА	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ППА"));
	ЭтоКлиентРостех	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Ростех"));
	ЭтоКлиентЮгория	= (КлиентДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"));
						
	РасчетныеНастройки = Новый Структура;
	
	РасчетныеНастройки.Вставить("ОпределятьСреднегодовуюСЧАЗаПериодРаботы", Ложь);

	//
	// Настройка: ПриостановленРасчетСЧА - для ОПИФ Атлант
	//
	ПериодПриостановкиПИФ = Справочники.ПаевыеИнвестиционныеФонды.ПериодПриостановкиОперацийСПаями(СчетДоверительногоУправления);
	Если ПериодПриостановкиПИФ <> Неопределено И Период >= ПериодПриостановкиПИФ.ДатаНачала И Период <= ПериодПриостановкиПИФ.ДатаОкончания Тогда 
		РасчетныеНастройки.Вставить("ПриостановленРасчетСЧА", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ПриостановленРасчетСЧА", Ложь);
	КонецЕсли;
					
	//
	// Настройка: ПереоцениватьОблигацииПриПолномПогашении					
	//
	РасчетныеНастройки.Вставить("ПереоцениватьОблигацииПриПолномПогашении", Ложь);
	Если Период >= '20230101' Тогда
		
		Если ЭтоКлиентБудущее ИЛИ ЭтоКлиентРостех ИЛИ ЭтоКлиентППА И (Период < '20230301' ИЛИ Период > '20240731') Тогда
			РасчетныеНастройки.Вставить("ПереоцениватьОблигацииПриПолномПогашении", Ложь);
		Иначе
			РасчетныеНастройки.Вставить("ПереоцениватьОблигацииПриПолномПогашении", Истина);		
		КонецЕсли;
		
	КонецЕсли; 
	
	//
	// Настройка: ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку					
	//
	Если Период >= '20230301' И ЭтоКлиентБудущее
		ИЛИ Период >= '20250901' И ЭтоКлиентЮгория Тогда
		РасчетныеНастройки.Вставить("ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ОтражатьДоходыРасходыОтПерекурсовкиПереоценкиКакПереоценку", Ложь);		
	КонецЕсли;
	
	//
	// Настройка: ТочностьРасчетногоКупонаДляОблигацийВВалюте - #542080 Будущее сначала захотели ограничить до 2х знаков, но потом выяснилось что по некоторым облигациям становится только хуже.
	//
	Если Период >= '20240613' И Период < '20240629' И ЭтоКлиентБудущее Тогда
		РасчетныеНастройки.Вставить("ТочностьРасчетногоКупонаДляОблигацийВВалюте", 2);
	Иначе
		РасчетныеНастройки.Вставить("ТочностьРасчетногоКупонаДляОблигацийВВалюте", Неопределено);		
	КонецЕсли;
	
	//
	// Настройка: ТочностьРасчетногоКупонаДляОблигацийВВалюте - #678442 для Волги
	//
	Если Период >= '20250919' И ЭтоКлиентВолга Тогда
		РасчетныеНастройки.Вставить("ТочностьРасчетногоКупонаДляОблигацийВВалюте", 2);
	Иначе
		РасчетныеНастройки.Вставить("ТочностьРасчетногоКупонаДляОблигацийВВалюте", Неопределено);
	КонецЕсли;
	
	//
	// Настройка: ПерекурсовыватьВалютныеАктивыНаДатуЗакрытияПоБумагамПоСделкамОбратногоРЕПО					
	//
	Если Период >= '20240701' И ЭтоКлиентБудущее Тогда
		РасчетныеНастройки.Вставить("ПерекурсовыватьВалютныеАктивыНаДатуЗакрытияПоБумагамПоСделкамОбратногоРЕПО", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ПерекурсовыватьВалютныеАктивыНаДатуЗакрытияПоБумагамПоСделкамОбратногоРЕПО", Ложь);		
	КонецЕсли;
	
	//
	// Настройка: ДействияПриПогашенииКупонаНаСчетахГлавыГ					
	//
	Если Период < '20240601' ИЛИ ЭтоКлиентСНГ Тогда
		РасчетныеНастройки.Вставить("ДействияПриПогашенииКупонаНаСчетахГлавыГ", "НеНачислять_И_НеСписывать");
	ИначеЕсли ЭтоКлиентБудущее Или ЭтоКлиентЮгория Тогда
		РасчетныеНастройки.Вставить("ДействияПриПогашенииКупонаНаСчетахГлавыГ", "Начислять_И_СписыватьПриПогашенииКупона");
	Иначе
		РасчетныеНастройки.Вставить("ДействияПриПогашенииКупонаНаСчетахГлавыГ", "Начислять_И_СписыватьПриОплатеПоПогашениюКупона");
	КонецЕсли;

	//
	// Настройка: СворачиватьПарныеСчетаКорректировокПутемПереброски					
	//
	Если Период >= '20230101' И ЭтоКлиентСНГ Тогда
		РасчетныеНастройки.Вставить("СворачиватьПарныеСчетаКорректировокПутемПереброски", Истина);
	Иначе
		РасчетныеНастройки.Вставить("СворачиватьПарныеСчетаКорректировокПутемПереброски", Ложь);		
	КонецЕсли;
	
	//
	// Настройка: ПереоцениватьБумагиПриПродажеНаСчетахГлавыГ					
	//
	Если Период >= '20230301' И ЭтоКлиентВолга Тогда
		РасчетныеНастройки.Вставить("ПереоцениватьБумагиПриПродажеНаСчетахГлавыГ", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ПереоцениватьБумагиПриПродажеНаСчетахГлавыГ", Ложь);
	КонецЕсли;
	
	//
	// Настройка: ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости					
	//
	Если Период >= '20230301' И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
		РасчетныеНастройки.Вставить("ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости", Ложь);
	КонецЕсли;
	
	//
	// Настройка: УчитыватьПогрешностьСложенияСтоимостиИПереоценкиЦеннойБумаги					
	//
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
		РасчетныеНастройки.Вставить("УчитыватьПогрешностьСложенияСтоимостиИПереоценкиЦеннойБумаги", Истина);
	Иначе
		РасчетныеНастройки.Вставить("УчитыватьПогрешностьСложенияСтоимостиИПереоценкиЦеннойБумаги", Ложь);
	КонецЕсли;

	//
	// Настройка: ПереоцениватьБумагиКПолучениюПоСделкамТПлюсЗаключеннымВОсновныхРежимахТоргов - только ростех их не переоценивает
	//
	РасчетныеНастройки.Вставить("ПереоцениватьБумагиКПолучениюПоСделкамТПлюсЗаключеннымВОсновныхРежимахТоргов", НЕ ЭтоКлиентРостех);
	
	//
	// Настройка: ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты - ПИФы РПИ встали на этот путь раньше остальных
	// 
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		И Период >= '20210401'
	Тогда
		РасчетныеНастройки.Вставить("ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты", Истина);
	ИначеЕсли Период >= '20230801' Тогда // остальные с 01.08.2023
		РасчетныеНастройки.Вставить("ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты", Истина);
	Иначе
		РасчетныеНастройки.Вставить("ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты", Ложь);
	КонецЕсли;

	//
	// Настройка: РасчетКорректировкиЭСПМетодомОтНСД
	//
	Если Период >= '20250401' И ЭтоКлиентБудущее Тогда
		РасчетныеНастройки.Вставить("РасчетКорректировкиЭСПМетодомОтНСД", Истина);
	Иначе
		РасчетныеНастройки.Вставить("РасчетКорректировкиЭСПМетодомОтНСД", Ложь);		
	КонецЕсли;
	
	//
	// Настройка: РазрешатьКороткуюПозициюПоСделкамРЕПОвЕПС
	//
	РасчетныеНастройки.Вставить("РазрешатьКороткуюПозициюПоСделкамРЕПОвЕПС", Ложь);		
	
	//
	// Настройка: ПартииСОценкойРазницыПервоначальногоПризнания
	//
	РасчетныеНастройки.Вставить("ПартииСОценкойРазницыПервоначальногоПризнания", Ложь);		
	
	//
	// Настройка: ПартииСОценкойРазницыПервоначальногоПризнанияВДатуПогашенияКупона
	//
	РасчетныеНастройки.Вставить("ПартииСОценкойРазницыПервоначальногоПризнанияВДатуПогашенияКупона", Ложь);		
	
	//
	// Настройка: ПравильныйУчетПервоначальногоПризнания
	//
	РасчетныеНастройки.Вставить("ПравильныйУчетПервоначальногоПризнания", Истина);		
	
	//
	// Настройка: ПравильныйУчетПервоначальногоПризнанияДляКорректировок
	//
	РасчетныеНастройки.Вставить("ПравильныйУчетПервоначальногоПризнанияДляКорректировок", Истина);		

	//
	// Настройка: НеВключатьРасходыВСтоимость
	//
	РасчетныеНастройки.Вставить("НеВключатьРасходыВСтоимость", Ложь);
	
	//
	// Настройка: ПризнатьДефолтной
	//
	РасчетныеНастройки.Вставить("ПризнатьДефолтной", Ложь);		

	//
	// Настройка: ДенежныйПотокПоОблигации
	//
	РасчетныеНастройки.Вставить("ДенежныйПотокПоОблигации", Справочники.ДенежныеПотокиПоОблигациям.ПустаяСсылка());		
	
	//
	// Настройки аналитик 					
	//
	РасчетныеНастройки.Вставить("АналитикаУчетаРезервовДебиторскойЗадолженности", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РезервПоСомнительнымДолгам"));
	РасчетныеНастройки.Вставить("АналитикаПереоценкиДебиторскойЗадолженности", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПереоценкаДебиторскойЗадолженности"));
	РасчетныеНастройки.Вставить("АналитикаИзмененияСтоимостиДебиторскойЗадолженностиВРезультатеСделок", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ИзмСтомостиДебЗадолженностиВРезультатеСделок"));
	
	Возврат РасчетныеНастройки;              
	
КонецФункции

Функция ОпределитьНастройкуУчетаАктива(Период, Организация, СчетДоверительногоУправления, УчетныйАктив, ВидУчета, ИмяНастройки) Экспорт

	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		ВидУчетаПеречисление = Перечисления.ВидыУчета[ВидУчета];
	Иначе
		ВидУчетаПеречисление = ВидУчета;
	КонецЕсли;
	
	СчетДоверительногоУправленияДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления);
	
	Если ИмяНастройки = "ОтражатьНаПереоценкеПолнуюСумму" Тогда
		Возврат НастройкаОтражатьНаПереоценкеПолнуюСумму(Период, Организация, СчетДоверительногоУправленияДляУчета, УчетныйАктив, ВидУчетаПеречисление);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив = &УчетныйАктив
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Если ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиУчетаАктивов", "НастройкиУчетаАктивовЕПС");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("УчетныйАктив",                 УчетныйАктив);
	Запрос.УстановитьПараметр("ВидУчета", 					  ВидУчетаПеречисление);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка[ИмяНастройки];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ОпределитьНастройкуУчетаАктива

Функция ОпределитьНастройкуУчетаКомиссии(Период, Организация, СчетДоверительногоУправления, Знач ВидЗадолженности, ВидУчета, ИмяНастройки, ИнформироватьОНезаполненности = Истина) Экспорт

	ВидУчетаПеречисление = ?(ТипЗнч(ВидУчета) = Тип("Строка"), Перечисления.ВидыУчета[ВидУчета], ВидУчета);
	
	//подмена вида задолженности для "Прочих" расходов
	Если ЗначениеЗаполнено(ВидЗадолженности.Родитель) И ВидЗадолженности.Родитель = Справочники.ВидыЗадолженности.Прочее Тогда
		Если ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий 
			И ВидЗадолженности <> Справочники.ВидыЗадолженности.РасходыПоСодержаниюНедвижимости 
			И ВидЗадолженности <> Справочники.ВидыЗадолженности.ПоПолучениюВАренду 
			И ВидЗадолженности <> Справочники.ВидыЗадолженности.РасходыНаКоммунальныеУслуги Тогда
			ВидЗадолженности = ВидЗадолженности.Родитель;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ВидЗадолженности",             ВидЗадолженности);
	Запрос.УстановитьПараметр("ВидУчета",		              ВидУчетаПеречисление);

	Выборка = Запрос.Выполнить().Выбрать();

	НастройкаУчетаКомиссии = Неопределено;
	
	Если Выборка.Следующий() Тогда
		НастройкаУчетаКомиссии = Выборка[ИмяНастройки];
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкаУчетаКомиссии)
		И ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет
		И ИмяНастройки = "Аналитика"
		И (ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария
			ИЛИ ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии) Тогда
		
		НастройкаУчетаКомиссии = ?(ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария,
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ГФУ_ПоУмолчанию_Для_РасходыПоУслугамДепозитария"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ГФУ_ПоУмолчанию_Для_ПоБрокерскойКомиссии"));

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкаУчетаКомиссии) И ИнформироватьОНезаполненности Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена настройка [" + ИмяНастройки + "] учета комиссии по виду задолженности " + ВидЗадолженности+" для "+Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления)+"("+Организация+")");
	КонецЕсли;
	
	Возврат НастройкаУчетаКомиссии;
	
КонецФункции // ОпределитьНастройкуУчетаКомиссии

Функция ОпределитьНастройкуДляВидаУчета(Период, Организация, СчетДоверительногоУправления, ВидУчета, ИмяНастройки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиПоВидуУчетаСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиПоВидуУчетаСрезПоследних";

	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		Запрос.УстановитьПараметр("ВидУчета",               Перечисления.ВидыУчета[ВидУчета]);
	Иначе
		Запрос.УстановитьПараметр("ВидУчета",               ВидУчета);
	КонецЕсли;

	
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка[ИмяНастройки];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ОпределитьНастройкуДляВидаУчета

Функция ОпределитьНастройкиПоВидуУчета(Период, Организация, СчетДоверительногоУправления, ВидУчета, Отказ) Экспорт

	СписокРесурсов = "";
	Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиПоВидуУчета.Ресурсы Цикл
		СписокРесурсов = СписокРесурсов + Ресурс.Имя + ",";
	КонецЦикла;
	НастройкиУчетаПереоценки = Новый Структура(Лев(СписокРесурсов, СтрДлина(СписокРесурсов) - 1));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиПоВидуУчетаСрезПоследних.*
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиПоВидуУчетаСрезПоследних";

		
	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		Запрос.УстановитьПараметр("ВидУчета",               Перечисления.ВидыУчета[ВидУчета]);
	Иначе
		Запрос.УстановитьПараметр("ВидУчета",               ВидУчета);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НастройкиУчетаПереоценки, Выборка, СписокРесурсов);
	Иначе
		ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку("Для клиента %1 не заданы настройки по виду учета %2 на %3", СчетДоверительногоУправления, ВидУчета, Формат(Период, "ДФ=dd.MM.yyyy"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
	КонецЕсли;

	Возврат НастройкиУчетаПереоценки;
	
КонецФункции // ОпределитьНастройкиПоВидуУчета

Функция ОпределитьНастройкиУчетаПереоценки(Период, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт

	НастройкиУчетаПереоценки = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчета = НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК УчитыватьПереоценкуОтдельно
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НастройкиУчетаПереоценки.Вставить(Выборка.УчетныйАктив.ИмяПредопределенныхДанных, Выборка.УчитыватьПереоценкуОтдельно);
	КонецЦикла;
	
	Возврат НастройкиУчетаПереоценки;
	
КонецФункции // ОпределитьНастройкиУчетаПереоценки

Функция ОпределитьНастройкиУчетаИндексацииНоминала(Период, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт

	НастройкиУчетаИндексацииНоминала = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчетаИндексацииНоминала = НастройкиУчетаАктивовСрезПоследних.СчетУчетаИндексацииНоминалаЗаВремяВладения
