Процедура ЗаполнитьАналитикуРасходов(ДокументОбъект, СчетПроводки, СубконтоПроводки, СчетРасходов, ПрочиеДоходыИРасходы, ЦеннаяБумага = Неопределено, ОбращаетсяНаОРЦБ = Неопределено) Экспорт
	
	СписыватьРасходыЗаСчетРезерва = Неопределено;
	ДокументОбъект.ДополнительныеСвойства.Свойство("СписыватьРасходыЗаСчетРезерва", СписыватьРасходыЗаСчетРезерва);
	
	Если СписыватьРасходыЗаСчетРезерва = Неопределено Тогда
		СписыватьРасходыЗаСчетРезерва = Справочники.СчетаДоверительногоУправления.НачислятьРезервыПредстоящихРасходов(
				Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ДокументОбъект.СчетДоверительногоУправления),
				ДокументОбъект.Дата);
		ДокументОбъект.ДополнительныеСвойства.Вставить("СписыватьРасходыЗаСчетРезерва", СписыватьРасходыЗаСчетРезерва);
	КонецЕсли;
	
	Если СписыватьРасходыЗаСчетРезерва 
		и ЗначениеЗаполнено(ПрочиеДоходыИРасходы)
		и ЗначениеЗаполнено(ПрочиеДоходыИРасходы.Резерв) Тогда
		
		СчетПроводки = ПланыСчетов.Основной.РезервыПредстоящихРасходов;
		
		СубконтоПроводки.Резервы              = ПрочиеДоходыИРасходы.Резерв;
		СубконтоПроводки.ПрочиеДоходыИРасходы = ПрочиеДоходыИРасходы;
		
	Иначе
		
		СчетПроводки = СчетРасходов;
		
		СубконтоПроводки.ПрочиеДоходыИРасходы = ПрочиеДоходыИРасходы;
		СубконтоПроводки.ЦенныеБумаги         = ЦеннаяБумага;
		СубконтоПроводки.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
	КонецЕсли;
	
КонецПроцедуры

