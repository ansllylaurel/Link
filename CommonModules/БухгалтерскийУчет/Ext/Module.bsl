	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	НастройкиУчетаАктивовСрезПоследних." + ИмяНастройки + "
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов"+?(ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "ЕПС", "")+".СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НастройкаУчетаАктивов.Вставить(Выборка.ИмяПредопределенныхДанных, Выборка[ИмяНастройки]);
	КонецЦикла;
	
	Возврат НастройкаУчетаАктивов;
	
КонецФункции // ОпределитьНастройкeУчетаАктивов

Функция ОпределитьНастройкиУчетаАктива(Период, Организация, СчетДоверительногоУправления, УчетныйАктив, ВидУчета) Экспорт

	Если ТипЗнч(ВидУчета) = Тип("Строка") Тогда
		ВидУчетаПеречисление = Перечисления.ВидыУчета[ВидУчета];
	Иначе
		ВидУчетаПеречисление = ВидУчета;
	КонецЕсли;
	
	СчетДоверительногоУправленияДляУчета = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления);
	
	ИмяРегистра = "НастройкиУчетаАктивов";
	Если ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ИмяРегистра = "НастройкиУчетаАктивовЕПС";
	КонецЕсли;
	
	СписокРесурсов = "";
	Для каждого Ресурс Из Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы Цикл
		СписокРесурсов = СписокРесурсов + Ресурс.Имя + ",";
	КонецЦикла;
	НастройкиУчетаАктива = Новый Структура(Лев(СписокРесурсов, СтрДлина(СписокРесурсов) - 1));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.*
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + ".СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив = &УчетныйАктив
		|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправленияДляУчета);
	Запрос.УстановитьПараметр("УчетныйАктив",                 УчетныйАктив);
	Запрос.УстановитьПараметр("ВидУчета",               	  ВидУчетаПеречисление);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(НастройкиУчетаАктива, Выборка, СписокРесурсов);
	КонецЦикла;
	
	ЗначениеНастройки = НастройкаОтражатьНаПереоценкеПолнуюСумму(Период, Организация, СчетДоверительногоУправленияДляУчета, УчетныйАктив, ВидУчетаПеречисление);
	НастройкиУчетаАктива.Вставить("ОтражатьНаПереоценкеПолнуюСумму", ЗначениеНастройки);
	
	Если ВидУчетаПеречисление = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		НастройкиУчетаАктива.Вставить("НастройкиУчетаЦенныхБумаг", ОпределитьНастройкиУчетаЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, "ПолучитьСписокНастроекДляПереоценки"));			
	КонецЕсли;
	
	Возврат НастройкиУчетаАктива;
	
КонецФункции // ОпределитьНастройкиУчетаАктива

