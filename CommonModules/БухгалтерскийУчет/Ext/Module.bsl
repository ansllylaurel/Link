			КонецЕсли;
			
			Если ПараметрыСписания.Переоценка <> 0 Тогда
				
				// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРЕОЦЕНКИ ПРОДАННОЙ БУМАГИ В РАСХОДЫ
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ПараметрыСписания.ПереоценкаВВалютеУчета, "Продажа ценной бумаги");
				
				// дебет
