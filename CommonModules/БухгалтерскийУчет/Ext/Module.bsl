Процедура ПроверитьУникальностьЭлементаПоРеквизиту(Объект, ИмяТаблицы, ИмяРеквизита, ЗначениеРеквизита, Отказ = Ложь, ДополнительныйОтбор = Неопределено) Экспорт
			
	Запрос = Новый Запрос;
	
	ТекстОсновногоЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	" + ИмяТаблицы + ".Ссылка 
	|ИЗ
	|	Справочник." + ИмяТаблицы + " КАК " + ИмяТаблицы;
	
	// Не выполняем контроль уникальности групп.
	ТекстУсловия = "
	|ГДЕ
	|	(Не " + ИмяТаблицы + ".ЭтоГруппа)";
	
	// Условие по реквизиту.	
	ТекстУсловия = ТекстУсловия +
	"
	|  И " + ИмяТаблицы + "." + ИмяРеквизита + " = &" + ИмяРеквизита;
	
	// Условие по дополнительному отбору.
	Если ТипЗнч(ДополнительныйОтбор) = Тип("Структура")
		И ДополнительныйОтбор.Свойство("ИмяРеквизита") 
		И ДополнительныйОтбор.Свойство("ЗначениеРеквизита") Тогда
	
		ТекстУсловия = ТекстУсловия +
		"
		|  И " + ИмяТаблицы + "." + ДополнительныйОтбор.ИмяРеквизита + " = &" + ДополнительныйОтбор.ИмяРеквизита;
		Запрос.УстановитьПараметр(ДополнительныйОтбор.ИмяРеквизита, ДополнительныйОтбор.ЗначениеРеквизита);
		
	КонецЕсли;
	
	// Условие по ссылке.	
	ТекстУсловия = ТекстУсловия +
	"
	|  И " + ИмяТаблицы + ".Ссылка <> &Ссылка";	
	
	Запрос.УстановитьПараметр(ИмяРеквизита, ЗначениеРеквизита);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Запрос.Текст = ТекстОсновногоЗапроса + ТекстУсловия;
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		МетаданныеСправочника = Объект.Метаданные();
		РеквизитМетаданные = МетаданныеСправочника.Реквизиты.Найти(ИмяРеквизита);
		
		Если РеквизитМетаданные = Неопределено Тогда
			РеквизитМетаданные = МетаданныеСправочника.СтандартныеРеквизиты[ИмяРеквизита];
		КонецЕсли;
		
		СинонимРеквизита = РеквизитМетаданные.Синоним;
		ТекстОшибки = "Значение """ + Строка(ЗначениеРеквизита) + """ поля """ + Строка(СинонимРеквизита) + """ не уникально";
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки, Объект, ИмяРеквизита,,Отказ);	
		
	КонецЕсли;
	
	
КонецПроцедуры

