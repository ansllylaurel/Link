			КонецЕсли;
			
			// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ
			
			
			ЗначенияСубконтоСчетДоходов = Новый Структура;
			ЗначенияСубконтоСчетДоходов.Вставить("ПрочиеДоходыИРасходы", НастройкиУчетаАктива.АналитикаДоходовОтРеализации);
