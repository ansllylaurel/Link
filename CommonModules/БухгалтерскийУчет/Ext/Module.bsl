Процедура ПереоценитьСчет(ОбъектДокумента, СчетДС, СубконтоДС, ВалютаОплаты) Экспорт

	ВидыСубконто = Новый Массив;
	
	Если СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02 Тогда // субконто договоры брок.
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания);
	Иначе
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетДС,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &СубконтоДС
		|				И Валюта = &Валюта) КАК БухгалтерскийУчетОстатки";

	Запрос.УстановитьПараметр("Период",			Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДС",			СчетДС);
	Запрос.УстановитьПараметр("ВидыСубконто",	ВидыСубконто);
	Запрос.УстановитьПараметр("Валюта",	ВалютаОплаты);
	Запрос.УстановитьПараметр("Организация",	ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("СубконтоДС",		СубконтоДС);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОстатокВалютаУчета = ВыборкаДетальныеЗаписи.СуммаОстатокДт;
		ОстатокВалюта = ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстатокДт;
	Иначе
		Возврат;
	КонецЕсли;
	
	ОстатокПоКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ОстатокВалюта, ВалютаОплаты, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
	
	КурсоваяРазница = ОстатокПоКурсу - ОстатокВалютаУчета;
	
	Если КурсоваяРазница > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, КурсоваяРазница, "Курсовая разница");
		
		Проводка.СчетДт = СчетДС;
		
		Если СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02 Тогда
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДС;
		Иначе
			Проводка.СубконтоДт.БанковскиеСчета = СубконтоДС;
		КонецЕсли;
		
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
		
		Проводка.ВалютаДт = ВалютаОплаты;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
		
		Если ВалютаОплаты.Код = "840" Тогда // USD
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("37201");
		ИначеЕсли ВалютаОплаты.Код = "978" Тогда // EUR
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("37202");
		Иначе
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("37201"); // плохо, будем исправлять
		КонецЕсли;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		
	ИначеЕсли КурсоваяРазница < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, -КурсоваяРазница, "Курсовая разница");
		
		Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
		
		Если ВалютаОплаты.Код = "840" Тогда // USD
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("47201");
		ИначеЕсли ВалютаОплаты.Код = "978" Тогда // EUR
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("47202");
		Иначе
			ГФУ = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("47201"); // плохо, будем исправлять
		КонецЕсли;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		
		
		Проводка.СчетКт = СчетДС;
		
		Если СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02 Тогда
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДС;
		Иначе
			Проводка.СубконтоКт.БанковскиеСчета = СубконтоДС;
		КонецЕсли;
		
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
		
		Проводка.ВалютаКт = ВалютаОплаты;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокПроданныхПартийПоРегистратору(Регистратор) Экспорт
	
	СписокПартий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагРасход.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагРасход.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагРасход.Партия КАК Партия,
		|	БухПартииЦенныхБумагРасход.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагРасход.Количество КАК Количество,
		|	БухПартииЦенныхБумагРасход.ДисконтПремияНачисленный - БухПартииЦенныхБумагПриход.ДисконтПремияНачисленный КАК БалансовыйДисконт,
		|	БухПартииЦенныхБумагРасход.СтоимостьКупона + БухПартииЦенныхБумагРасход.ПереоценкаКупона КАК ОценочнаяСуммаКупона,
		|	БухПартииЦенныхБумагРасход.Стоимость КАК Стоимость
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагРасход
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагПриход
		|		ПО БухПартииЦенныхБумагРасход.ЦеннаяБумага = БухПартииЦенныхБумагПриход.ЦеннаяБумага
		|			И БухПартииЦенныхБумагРасход.Партия = БухПартииЦенныхБумагПриход.Партия
		|			И БухПартииЦенныхБумагРасход.СтрокаПартии = БухПартииЦенныхБумагПриход.СтрокаПартии
		|ГДЕ
		|	БухПартииЦенныхБумагПриход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииЦенныхБумагРасход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумагРасход.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагПриход.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагПриход.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумагРасход.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)";

	Запрос.УстановитьПараметр("Регистратор", Регистратор);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеРасхода = Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, Количество, БалансовыйДисконт, ОценочнаяСуммаКупона, Стоимость");
		ЗаполнитьЗначенияСвойств(ДанныеРасхода, Выборка);
		
		СписокПартий.Добавить(ДанныеРасхода, Строка(Выборка.Партия) + ". Строка партии:" +  Выборка.СтрокаПартии);
		
	КонецЦикла;
	
	Возврат СписокПартий;
	
КонецФункции

Процедура ДвижениеПереоценкиБУНУ(ОбъектДокумента, ПараметрыПереоценки) Экспорт

	Если ПараметрыПереоценки.СуммаВВалютеУчета > 0 Тогда
		// доначислим переоценку перед продажей
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[ПараметрыПереоценки.УчетныйРегистр], ПараметрыПереоценки.СуммаВВалютеУчета, ПараметрыПереоценки.Описание);
		
		Проводка.СчетДт = ПараметрыПереоценки.СчетУчета;
		Проводка.СубконтоДт[ПараметрыПереоценки.ВидСубконтоУчетаЦеннойБумаги] = ПараметрыПереоценки.ЦеннаяБумага;
		
		Если ПараметрыПереоценки.ВалютныйУчет Тогда
			Проводка.ВалютнаяСуммаДт = ПараметрыПереоценки.СуммаВВалютеНоминала;
			Проводка.ВалютаДт = ПараметрыПереоценки.ВалютаНоминала;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ПараметрыПереоценки.АналитикаДоходовОтПереоценки;
		Проводка.СубконтоКт.ЦенныеБумаги         = ПараметрыПереоценки.ЦеннаяБумага;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ПараметрыПереоценки.ОбращаетсяНаОРЦБ;
		
	ИначеЕсли ПараметрыПереоценки.СуммаВВалютеУчета < 0 Тогда
		// доначислим переоценку перед продажей
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[ПараметрыПереоценки.УчетныйРегистр], -ПараметрыПереоценки.СуммаВВалютеУчета, ПараметрыПереоценки.Описание);
		
		Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
		
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ПараметрыПереоценки.АналитикаДоходовОтПереоценки;
		Проводка.СубконтоДт.ЦенныеБумаги         = ПараметрыПереоценки.ЦеннаяБумага;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ПараметрыПереоценки.ОбращаетсяНаОРЦБ;
		
		
		Проводка.СчетКт = ПараметрыПереоценки.СчетУчета;
		Проводка.СубконтоКт[ПараметрыПереоценки.ВидСубконтоУчетаЦеннойБумаги] = ПараметрыПереоценки.ЦеннаяБумага;
		
		Если ПараметрыПереоценки.ВалютныйУчет Тогда
			Проводка.ВалютнаяСуммаКт = -ПараметрыПереоценки.СуммаВВалютеНоминала;
			Проводка.ВалютаКт = ПараметрыПереоценки.ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры
