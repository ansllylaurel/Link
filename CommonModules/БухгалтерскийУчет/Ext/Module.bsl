Функция ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(Период, Документ, УчетныйРегистр, КорзинаЦенныхБумаг = "ЦенныеБумаги", ТаблицаЦБ = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ТаблицаЦБ = Неопределено Тогда
		Запрос.УстановитьПараметр("Ссылка",	Документ);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|ГДЕ
			|	СделкаЦенныеБумаги.Ссылка = &Ссылка";
		
		ИмяДокумента = Документ.Метаданные().Имя;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СделкаЦенныеБумаги",  ИмяДокумента + КорзинаЦенныхБумаг);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка.ЦенныеБумаги", ИмяДокумента + "." + КорзинаЦенныхБумаг);
	Иначе
		Запрос.УстановитьПараметр("ТаблицаЦБ",	ТаблицаЦБ);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	&ТаблицаЦБ КАК ТаблицаЦБ";
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Возврат ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(Период, Запрос.МенеджерВременныхТаблиц, УчетныйРегистр);
	
КонецФункции // ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ

Функция ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Период, ЦеннаяБумага, УчетныйРегистр) Экспорт
	
	ЦенныеБумаги = Новый ТаблицаЗначений;
	ЦенныеБумаги.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	
	НоваяСтрока = ЦенныеБумаги.Добавить();
	НоваяСтрока.ЦеннаяБумага = ЦеннаяБумага;
	
	Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда  
		Возврат ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(Период, ЦенныеБумаги, УчетныйРегистр)[0].ОбращаетсяНаОРЦБ;
	Иначе
		Возврат Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции // ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ

// Функция - Получить сведения об обращении ценных бумаг на ОРЦБ
//
// Параметры:
//  Период			- Дата												- дата, на которую необходимо определить вид обращения
//  ЦенныеБумаги	- Массив/ТаблицаЗначений/МенеджерВременныхТаблиц	- параметр содержащий массив ценных бумаг / таблицу значений с одной колонкой "ЦеннаяБумага" / МВТ, содержащий ВТ с одним полем "ЦеннаяБумага"
// 
// Возвращаемое значение:
//   ТаблицаЗначений с колонками:
//		ЦеннаяБумага		-	Ценная бумага							- ссылка на ценную бумагу, для которой определен вид обращения
//		ДатаКотировки		-	Дата/Неопределено						- дата котировки, по которой был определен вид обращения
//		ОбращаетсяНаОРЦБ	-	ПеречислениеСсылка.ВидыОбращенияНаОРЦБ	- определенный вид обращения ЦБ
//
Функция ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(Период, ЦенныеБумаги, УчетныйРегистр) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", НачалоДня(Период) - 86400); //текущая дата не входит! 
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Блумберг", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("ДатаОтключенияБлумберг", Дата(2021,10,1));     //с этой даты котировки блумберг для облигаций учитываться не будут
	
	МассивБирж = Новый Массив;
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_NYSE_Arca"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_HKEX"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_FRNK"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_LSE"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Paris"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Lisbon"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Brussels"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_Amsterdam"));
	МассивБирж.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Euronext_London"));
	
	Запрос.УстановитьПараметр("МассивБирж", МассивБирж);
	
	Если ТипЗнч(ЦенныеБумаги) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = ЦенныеБумаги;
	Иначе
		
		Если ТипЗнч(ЦенныеБумаги) = Тип("Массив") Тогда
			
			ЦБ = Новый ТаблицаЗначений;
			ЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
			
			Для Каждого ТекЦБ Из ЦенныеБумаги Цикл
				НоваяСтрока					= ЦБ.Добавить();
				НоваяСтрока.ЦеннаяБумага	= ТекЦБ;
			КонецЦикла;
			
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЦБ);
			
		Иначе
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	&ЦенныеБумаги КАК ЦенныеБумаги";
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Запрос.Текст) Тогда
		Запрос.Текст = Запрос.Текст +
			"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|";
	КонецЕсли;
	
	Если УчетныйРегистр = "БухгалтерскийУчет" Тогда 
		
		Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.ПустаяСсылка) КАК ОбращаетсяНаОРЦБ
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги";
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НормыЗаконодательстваСрезПоследних.СрокДействияКотировокДляОРЦБ КАК СрокДействияКотировокДляОРЦБ
		|ПОМЕСТИТЬ _СрокДействияКотировок
		|ИЗ
		|	РегистрСведений.НормыЗаконодательства.СрезПоследних(&Период, ) КАК НормыЗаконодательстваСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ПроизводныеФинансовыеИнструменты)
		|					И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|				ТОГДА ВЫБОР
		|						КОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипБазовогоАктива В (ЗНАЧЕНИЕ(Перечисление.ТипыБазовыхАктивов.БиржевойИндекс), ЗНАЧЕНИЕ(Перечисление.ТипыБазовыхАктивов.ЦеннаяБумага))
		|							ТОГДА &Период
		|						ИНАЧЕ ДАТАВРЕМЯ(2000, 1, 1)
		|					КОНЕЦ
		|			КОГДА ЕСТЬNULL(КотировкиММВБ.WAPRICE_DATE, ДАТАВРЕМЯ(2000, 1, 1)) >= ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -ЕСТЬNULL(_СрокДействияКотировок.СрокДействияКотировокДляОРЦБ, 0))
		|				ТОГДА КотировкиММВБ.WAPRICE_DATE
		|			КОГДА ЕСТЬNULL(КотировкиБлумберг.CLOSE_DATE, ДАТАВРЕМЯ(2000, 1, 1)) >= ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -ЕСТЬNULL(_СрокДействияКотировок.СрокДействияКотировокДляОРЦБ, 0))
		|					И &Период < &ДатаОтключенияБлумберг
		|				ТОГДА КотировкиБлумберг.CLOSE_DATE
		|			КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|					И ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентов)
		|					И ЕСТЬNULL(КотировкиБлумберг.LEGALCLOSEPRICE_DATE, ДАТАВРЕМЯ(2000, 1, 1)) >= ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -ЕСТЬNULL(_СрокДействияКотировок.СрокДействияКотировокДляОРЦБ, 0))
		|				ТОГДА КотировкиБлумберг.LEGALCLOSEPRICE_DATE
		|			ИНАЧЕ НЕОПРЕДЕЛЕНО
		|		КОНЕЦ) КАК ДатаКотировки
		|ПОМЕСТИТЬ _БумагиИДаты
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ЦенныеБумаги.ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги)
		|					И Биржа = &ММВБ
		|					И НЕ РежимТоргов.РЕПО
		|					И НЕ РежимТоргов.ПервичноеРазмещение) КАК КотировкиММВБ
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиММВБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
		|				&Период,
		|				ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ЦенныеБумаги.ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумаги)
		|					И (Биржа = &Блумберг
		|						ИЛИ Биржа В (&МассивБирж))
		|					И НЕ РежимТоргов.РЕПО
		|					И НЕ РежимТоргов.ПервичноеРазмещение) КАК КотировкиБлумберг
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиБлумберг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СрокДействияКотировок КАК _СрокДействияКотировок
		|		ПО (ИСТИНА)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦенныеБумаги.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БумагиИДаты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _БумагиИДаты.ЦеннаяБумага = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.ПустаяСсылка)
		|		КОГДА _СрокДействияКотировок.СрокДействияКотировокДляОРЦБ ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
		|		КОГДА ЕСТЬNULL(_БумагиИДаты.ДатаКотировки, ДАТАВРЕМЯ(2000, 1, 1)) >= ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -ЕСТЬNULL(_СрокДействияКотировок.СрокДействияКотировокДляОРЦБ, 0))
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
		|	КОНЕЦ КАК ОбращаетсяНаОРЦБ
		|ИЗ
		|	_БумагиИДаты КАК _БумагиИДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СрокДействияКотировок КАК _СрокДействияКотировок
		|		ПО (ИСТИНА)";
	
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ
	
