Функция ОпределитьГруппуФинансовогоУчетаДоходовРасходов(Код, ДополнительныеПараметры = Неопределено) Экспорт
	КодПоиска = "";
	Если СтрДлина(Код)=5 Тогда 
		КодПоиска = Код;
	ИначеЕсли Код = "3112" Тогда
		Банк = Неопределено;
		
		Если ДополнительныеПараметры<>Неопределено И ДополнительныеПараметры.Свойство("Банк",Банк)<>Неопределено Тогда
			Если ЗначениеЗаполнено(Банк) Тогда
				КодПоиска = Код + ?(Справочники.Банки.ЯвляетсяРезидентом(Банк,ДополнительныеПараметры.Период),"0","1");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КодПоиска<>"" Тогда
		Возврат Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду(КодПоиска,Ложь);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция Закрывать7ойРазделПриПоступленииДенежныхСредств(Период, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиЗакрытияБухгалтерскихСчетовСрезПоследних.ЗакрыватьПриПоступленииДенежныхСредств
		|ИЗ
		|	РегистрСведений.НастройкиЗакрытияБухгалтерскихСчетов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И ВариантЗакрытияБухгалтерскихСчетов = &ВариантЗакрытияБухгалтерскихСчетов) КАК НастройкиЗакрытияБухгалтерскихСчетовСрезПоследних";
	
	Запрос.УстановитьПараметр("ВариантЗакрытияБухгалтерскихСчетов", Перечисления.ВариантыЗакрытияБухгалтерскихСчетов.ЕПСЗакрытиеРаздела7);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.ЗакрыватьПриПоступленииДенежныхСредств;
		
	Иначе
		
		Возврат Ложь;
	
	КонецЕсли;

