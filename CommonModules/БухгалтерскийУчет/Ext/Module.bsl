Функция ПолучитьДоговорБрокерскогоОбслуживания(СчетДоверительногоУправления, Брокер, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Брокер = &Брокер
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";

	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДоговорБрокерскогоОбслуживания;
	КонецЕсли;
	
КонецФункции // ПолучитьДоговорБрокерскогоОбслуживания

