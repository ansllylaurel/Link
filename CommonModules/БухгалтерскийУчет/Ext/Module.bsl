	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ПериодичностьЗакрытия", ПериодичностьЗакрытия);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВариантЗакрытияБухгалтерскихСчетов");

КонецФункции

Функция ВариантСписанияДоходовИРасходов(Период, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.ВариантСписанияДоходовИРасходов КАК ВариантСписанияДоходовИРасходов
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.ВариантСписанияДоходовИРасходов;
		
	Иначе
		
		Возврат Перечисления.ВариантыСписанияДоходовИРасходов.ПустаяСсылка();
	
	КонецЕсли;

КонецФункции

Процедура ПереоценитьВалютныйСчет(ОбъектДокумента, ПараметрыПереоценки, ВидГраницы, НастройкиУчетаОбщие, УчетныйРегистр, Отказ = Ложь) Экспорт

	// не для ЕПС!
	
	// ПараметрыПереоценки - структура, ключи:
	//   Счет - счет бухучета
	//   УчетныйРегистр  - вид учета (строка)
	//   Валюта - справочник валюты_ссылка
	//   <ИмяСубконто> - <ЗначениеСубконто>
	
	МассивВидовСубконто = Новый Массив;
	
	УсловиеСубконто = "";
	
	Запрос = Новый Запрос;
	
	НомерСубконто = 1;
	
	Для каждого СтрокаВидыСубконто Из ПараметрыПереоценки.Счет.ВидыСубконто Цикл
		
		Если СтрокаВидыСубконто.ТолькоОбороты Тогда
			Продолжить;
		КонецЕсли;
		
		Субконто = Неопределено;
		Если ПараметрыПереоценки.Свойство(СтрокаВидыСубконто.ВидСубконто.ИмяПредопределенныхДанных, Субконто) Тогда
			
			Запрос.УстановитьПараметр("Субконто" + Строка(НомерСубконто), Субконто);
		
			МассивВидовСубконто.Добавить(СтрокаВидыСубконто.ВидСубконто);
			
			УсловиеСубконто = УсловиеСубконто + РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(" И Субконто%1 = &Субконто%1", Строка(НомерСубконто));
			
			НомерСубконто = НомерСубконто + 1;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт - БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстаток,
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт - БухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &Счет,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Валюта = &Валюта 
		|				$УсловиеСубконто$) КАК БухгалтерскийУчетОстатки";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", ПараметрыПереоценки.УчетныйРегистр);	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "$УсловиеСубконто$", УсловиеСубконто);	
	
	Запрос.УстановитьПараметр("Валюта", 		ПараметрыПереоценки.Валюта);
	Запрос.УстановитьПараметр("Организация", 	ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("Период", 		Новый Граница(ОбъектДокумента.Дата, ВидГраницы));
	Запрос.УстановитьПараметр("ВидыСубконто", 	МассивВидовСубконто);
	Запрос.УстановитьПараметр("Счет", 			ПараметрыПереоценки.Счет);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		АналитикаПерекурсовки = БухгалтерскийУчет.ПолучитьПрочийДоходРасходДляКурсовойРазницы(ПараметрыПереоценки.Счет, ?(ВыборкаДетальныеЗаписи.СуммаОстаток > 0, ВидСчета.Активный, ВидСчета.Пассивный), НастройкиУчетаОбщие, УчетныйРегистр, ОбъектДокумента.Дата, ОбъектДокумента.СчетДоверительногоУправления, Отказ);

		СуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуДокументаВВалютеУчета(ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток, ПараметрыПереоценки.Валюта, ОбъектДокумента, Отказ);
		
		КурсоваяРазница = СуммаВВалютеУчета - ВыборкаДетальныеЗаписи.СуммаОстаток;
		
		КурсоваяРазницаМодуль = Макс(КурсоваяРазница, -КурсоваяРазница);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[ПараметрыПереоценки.УчетныйРегистр], КурсоваяРазницаМодуль, "Курсовая разница");
		
		Если КурсоваяРазница > 0 Тогда
			
			Проводка.СчетДт = ПараметрыПереоценки.Счет;
			Для каждого СтрокаВидыСубконто Из ПараметрыПереоценки.Счет.ВидыСубконто Цикл
		
				Субконто = Неопределено;
				Если ПараметрыПереоценки.Свойство(СтрокаВидыСубконто.ВидСубконто.ИмяПредопределенныхДанных, Субконто) Тогда
					Проводка.СубконтоДт[СтрокаВидыСубконто.ВидСубконто] = Субконто;
				КонецЕсли;
				
			КонецЦикла;
			Проводка.ВалютаДт  = ПараметрыПереоценки.Валюта;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
		
		Иначе
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
			
			
			Проводка.СчетКт = ПараметрыПереоценки.Счет;
			Для каждого СтрокаВидыСубконто Из ПараметрыПереоценки.Счет.ВидыСубконто Цикл
		
				Субконто = Неопределено;
				Если ПараметрыПереоценки.Свойство(СтрокаВидыСубконто.ВидСубконто.ИмяПредопределенныхДанных, Субконто) Тогда
					Проводка.СубконтоКт[СтрокаВидыСубконто.ВидСубконто] = Субконто;
				КонецЕсли;
				
			КонецЦикла;
			Проводка.ВалютаКт = ПараметрыПереоценки.Валюта;
			
		КонецЕсли;
		
	
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьГруппуФинансовогоУчетаПоПрочимДоходамРасходам(Дата, Организация, СчетДоверительногоУправления, ВидКомиссии, ПрочиеДоходыРасходы) Экспорт
	
	ГФУКлиента = ОпределитьНастройкуУчетаКомиссии(Дата, Организация, СчетДоверительногоУправления, ВидКомиссии, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "Аналитика", Ложь);
	
	Если ЗначениеЗаполнено(ГФУКлиента) Тогда
	
		Возврат ГФУКлиента;
	
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	НастройкиЗаполненияГруппыФинансовогоУчета.ГруппаФинансовогоУчетаДоходовРасходов КАК ГруппаФинансовогоУчетаДоходовРасходов,
			|	НастройкиЗаполненияГруппыФинансовогоУчета.ПрочиеДоходыИРасходы = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка) КАК Порядок
			|ИЗ
			|	РегистрСведений.НастройкиЗаполненияГруппыФинансовогоУчета КАК НастройкиЗаполненияГруппыФинансовогоУчета
			|ГДЕ
			|	НастройкиЗаполненияГруппыФинансовогоУчета.ВидЗадолженности = &ВидЗадолженности
			|	И (НастройкиЗаполненияГруппыФинансовогоУчета.ПрочиеДоходыИРасходы = &ПрочиеДоходыИРасходы
			|			ИЛИ НастройкиЗаполненияГруппыФинансовогоУчета.ПрочиеДоходыИРасходы = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Порядок";
		Запрос.УстановитьПараметр("ВидЗадолженности", ВидКомиссии);
		Запрос.УстановитьПараметр("ПрочиеДоходыИРасходы", ПрочиеДоходыРасходы);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Возврат Выборка.ГруппаФинансовогоУчетаДоходовРасходов;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ДвижениеПерекурсовки(ОбъектДокумента, УчетныйРегистр, Параметры, АналитикаПерекурсовки, СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ) Экспорт
	
	ОбъектЭтоСтруктура = ТипЗнч(ОбъектДокумента) = Тип("Структура");
	Если ОбъектЭтоСтруктура Тогда
		// Определим необходимые параметры
		// В структуре должны быть свойства:
		//  - Ссылка - ссылка на проводимый документ
		//  - Дата - дата документа
		//  - Движения - набор движений по регистру бухгалтерии БухгалтерскийУчет
		
		ДокументСсылка	= ОбъектДокумента.Ссылка;
		Движения		= ОбъектДокумента.Движения;
	КонецЕсли;		
		
	ЦеннаяБумага = Параметры.ЦеннаяБумага;
	
	ВалютаНоминала	= ЦеннаяБумага.ВалютаНоминала;
	Рынок			= Параметры.Рынок;
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(Рынок);	
	
	УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ОбъектДокумента.Дата, Рынок, ЦеннаяБумага);
	УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ОбъектДокумента.Дата, Рынок, ЦеннаяБумага, Истина);
	ИмяАктива 			= УчетныйАктив.ИмяПредопределенныхДанных;
	ИмяАктиваКупон		= УчетныйАктивКупон.ИмяПредопределенныхДанных;
	
	СтоимостьВВалютеУчета = Параметры.СтоимостьВВалютеУчета;
	СтоимостьКупонаВВалютеУчета = Параметры.СтоимостьКупонаВВалютеУчета;
	ПереоценкаВВалютеУчета = Параметры.ПереоценкаВВалютеУчета;
	ПереоценкаКупонаВВалютеУчета = Параметры.ПереоценкаКупонаВВалютеУчета;
	
	Если СтоимостьВВалютеУчета <> 0 Тогда
		
		СтоимостьВВалютеУчетаМодуль = Макс(СтоимостьВВалютеУчета, -СтоимостьВВалютеУчета);
		Если ОбъектЭтоСтруктура Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьВВалютеУчетаМодуль, "Перекурсовка стоимости");
		Иначе	
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СтоимостьВВалютеУчетаМодуль, "Перекурсовка стоимости");
		КонецЕсли;
		
		Если СтоимостьВВалютеУчета > 0 Тогда
			Проводка.СчетДт = СчетаУчета[ИмяАктива];
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктива];
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктива];
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетаУчета[ИмяАктива];
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтоимостьКупонаВВалютеУчета <> 0 Тогда
		
		СтоимостьКупонаВВалютеУчетаМодуль = Макс(СтоимостьКупонаВВалютеУчета, -СтоимостьКупонаВВалютеУчета);
		Если ОбъектЭтоСтруктура Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьКупонаВВалютеУчетаМодуль, "Перекурсовка купона");
		Иначе
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СтоимостьКупонаВВалютеУчетаМодуль, "Перекурсовка купона");
		КонецЕсли;	
			
		Если СтоимостьКупонаВВалютеУчета > 0 Тогда
			Проводка.СчетДт = СчетаУчета[ИмяАктиваКупон];
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктиваКупон];
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктиваКупон];
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетаУчета[ИмяАктиваКупон];
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПереоценкаВВалютеУчета <> 0 Тогда
		
		ПереоценкаВВалютеУчетаМодуль = Макс(ПереоценкаВВалютеУчета, -ПереоценкаВВалютеУчета);
		Если ОбъектЭтоСтруктура Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаВВалютеУчетаМодуль, "Перекурсовка переоценки");
		Иначе
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПереоценкаВВалютеУчетаМодуль, "Перекурсовка переоценки");
		КонецЕсли;
		
		Если ПереоценкаВВалютеУчета > 0 Тогда
			Проводка.СчетДт = СчетаУчетаПереоценки[ИмяАктива];
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктива];
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктива];
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетаУчетаПереоценки[ИмяАктива];
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПереоценкаКупонаВВалютеУчета <> 0 Тогда
		
		ПереоценкаКупонаВВалютеУчетаМодуль = Макс(ПереоценкаКупонаВВалютеУчета, -ПереоценкаКупонаВВалютеУчета);
		Если ОбъектЭтоСтруктура Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаКупонаВВалютеУчетаМодуль, "Перекурсовка переоценки купона");
		Иначе
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПереоценкаКупонаВВалютеУчетаМодуль, "Перекурсовка переоценки купона");
		КонецЕсли;
		
		Если ПереоценкаКупонаВВалютеУчета > 0 Тогда
			Проводка.СчетДт = СчетаУчетаПереоценки[ИмяАктиваКупон];
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктиваКупон];
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки[ИмяАктиваКупон];
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			Проводка.СчетКт = СчетаУчетаПереоценки[ИмяАктиваКупон];
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ДвижениеИндексацииНоминала(ОбъектДокумента, Движения, ПараметрыИндексацииНоминала, АналитикаДоходовОтИндексацииНоминала, СчетУчетаИндексацииНоминала, ОбращаетсяНаОРЦБ, Отказ) Экспорт
	
	ОбъектЭтоСтруктура = ТипЗнч(ОбъектДокумента) = Тип("Структура");
	Если ОбъектЭтоСтруктура Тогда
	//	// Определим необходимые параметры
	//	// В структуре должны быть свойства:
	//	//  - Ссылка - ссылка на проводимый документ
	//	//  - Дата - дата документа
	//	//  - Движения - набор движений по регистру бухгалтерии БухгалтерскийУчет
	//	
		ДокументСсылка		= ОбъектДокумента.Ссылка;
		//Движения 	= ОбъектДокумента.Движения;
	КонецЕсли;		

	ЦеннаяБумага = ПараметрыИндексацииНоминала.ЦеннаяБумага;
	ИндексацияНоминала = ПараметрыИндексацииНоминала.ИндексацияНоминала;
	ПроцентныйДоход = ПараметрыИндексацииНоминала.КупонныйДоход;
	ТаблицаНепринимаемойИндексацииНоминалов = ПараметрыИндексацииНоминала.ТаблицаНепринимаемойИндексацииНоминалов;
	
	Если ИндексацияНоминала > 0 Тогда
					
		Если ОбъектЭтоСтруктура Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ИндексацияНоминала, "Доход от индексации номинала ценной бумаги");
		Иначе
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения, ИндексацияНоминала, "Доход от индексации номинала ценной бумаги");
		КонецЕсли;
					
		// дебет
		Проводка.СчетДт = СчетУчетаИндексацииНоминала;
		Проводка.СубконтоДт.Облигации = ЦеннаяБумага;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала;
		Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
		ПроцентныйДоход = ПроцентныйДоход + ИндексацияНоминала;
		
	ИначеЕсли ИндексацияНоминала < 0 Тогда
		
		ИндексацияНоминалаПринимаемая = - Мин( -ИндексацияНоминала, ПроцентныйДоход);
		ПроцентныйДоход = ПроцентныйДоход + ИндексацияНоминалаПринимаемая;
		ИндексацияНоминала = ИндексацияНоминала - ИндексацияНоминалаПринимаемая;
		
		Если ИндексацияНоминалаПринимаемая < 0 Тогда
			Если ОбъектЭтоСтруктура Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, -ИндексацияНоминалаПринимаемая, "Принимаемый расход от индексации номинала ценной бумаги");
			Иначе
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения, -ИндексацияНоминалаПринимаемая, "Принимаемый расход от индексации номинала ценной бумаги");
			КонецЕсли;
						
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала;
			Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
			// кредит
			Проводка.СчетКт = СчетУчетаИндексацииНоминала;
			Проводка.СубконтоКт.Облигации = ЦеннаяБумага;
		КонецЕсли;
		
		Если ИндексацияНоминала < 0 Тогда
						
			Если ОбъектЭтоСтруктура Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, -ИндексацияНоминала, "Отложенный расход от индексации номинала ценной бумаги");
			Иначе
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения, -ИндексацияНоминала, "Отложенный расход от индексации номинала ценной бумаги");
			КонецЕсли;
						
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.РасходыБудущихПериодов;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала;
			Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = СчетУчетаИндексацииНоминала;
			Проводка.СубконтоКт.Облигации = ЦеннаяБумага;
			
			СтрокаОтложеннойИндексации = ТаблицаНепринимаемойИндексацииНоминалов.Найти(ЦеннаяБумага, "ЦеннаяБумага");
			Если СтрокаОтложеннойИндексации = Неопределено Тогда
				СтрокаОтложеннойИндексации = ТаблицаНепринимаемойИндексацииНоминалов.Добавить();
				СтрокаОтложеннойИндексации.ЦеннаяБумага = ЦеннаяБумага;
				СтрокаОтложеннойИндексации.Сумма = ИндексацияНоминала;
			Иначе
				СтрокаОтложеннойИндексации.Сумма = СтрокаОтложеннойИндексации.Сумма + ИндексацияНоминала;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
			
	Если ПроцентныйДоход > 0 Тогда
					
		СтрокаОтложеннойИндексации = ТаблицаНепринимаемойИндексацииНоминалов.Найти(ЦеннаяБумага, "ЦеннаяБумага");
		Если СтрокаОтложеннойИндексации <> Неопределено Тогда
			
			ИндексацияОтложеннаяНаРасходы = Мин(СтрокаОтложеннойИндексации.Сумма, ПроцентныйДоход);
			Если ИндексацияОтложеннаяНаРасходы > 0 Тогда
				
				СтрокаОтложеннойИндексации.Сумма = СтрокаОтложеннойИндексации.Сумма - ИндексацияОтложеннаяНаРасходы;
				
				Если ОбъектЭтоСтруктура Тогда
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ИндексацияОтложеннаяНаРасходы, "Зачет отложенного расхода от индексации номинала ценной бумаги");
				Иначе
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения, ИндексацияОтложеннаяНаРасходы, "Зачет отложенного расхода от индексации номинала ценной бумаги");
				КонецЕсли;

				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала;
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.РасходыБудущихПериодов;
				Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтИндексацииНоминала;
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				
			КонецЕсли;
			
		КонецЕсли;			
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПрочийДоходРасходДляКурсовойРазницы(Счет, ВидСчетаУчета, НастройкиУчетаОбщие, УчетныйРегистр, Дата, СчетДоверительногоУправления, Отказ = Ложь) Экспорт
	
	Если Счет = ПланыСчетов.Основной.ВалютныеСредстваУБрокера ИЛИ Счет = ПланыСчетов.Основной.РасчетыЧерезБрокераВВалюте Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиВалютныхСредствУБрокера;
		
	ИначеЕсли Счет = ПланыСчетов.Основной.ВалютныеСчета Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиВалютныхСредств;
		
	ИначеЕсли Счет = ПланыСчетов.Основной.ПереводыВПутиВВалюте Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиВалютныхСредствВПути;
		
	ИначеЕсли Счет = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте
		И ВидСчетаУчета = ВидСчета.Активный Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиДебеторскойЗадолженности
		
	ИначеЕсли Счет = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте
		И ВидСчетаУчета = ВидСчета.Пассивный Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиКредиторскойЗадолженности

	ИначеЕсли Счет = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиДебеторскойЗадолженности;
		
	ИначеЕсли Счет = ПланыСчетов.Основной.ПредоставленныеЗаймы Тогда
		Возврат НастройкиУчетаОбщие.АналитикаПерекурсовкиЗаймов;
		
	ИначеЕсли Счет = ПланыСчетов.Основной.КраткосрочныеКредиты Тогда
		Возврат БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, УчетныйРегистр, "АналитикаПерекурсовки"); 
		
	ИначеЕсли Счет = ПланыСчетов.Основной.ПроцентыПоКраткосрочнымКредитам
		ИЛИ Счет = ПланыСчетов.Основной.НалоговыеНачисленияПоРЕПО Тогда
		Возврат БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, УчетныйРегистр, "АналитикаПерекурсовки"); 
		
	ИначеЕсли Счет = ПланыСчетов.Основной.РезервыПоСомнительнымДолгамКорпоративныеОблигации Тогда
		
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РезервПоСомнительнымДолгам");
		
	ИначеЕсли Счет = ПланыСчетов.Основной.ВекселяВалютные
		ИЛИ Счет = ПланыСчетов.Основной.ПереоценкаВекселейВалютных Тогда
		
		Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_КурсоваяРазницаВекселей");
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена аналитика доходов/расходов курсовой разницы для счета " + Счет.Код,,,, Отказ);
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьПроводкуКурсовойРазницы(ОбъектДокумента, УчетныйРегистр, ПараметрыКурсовойРазницы, НастройкиУчетаОбщие, ЭтоОтложеннаяКурсоваяРазница, Отказ) Экспорт
	
	СуммаКурсовойРазницы 	= ПараметрыКурсовойРазницы.СуммаКурсовойРазницы;
	Валюта 					= ПараметрыКурсовойРазницы.Валюта;
	Счет 					= ПараметрыКурсовойРазницы.Счет;
	ВидСчетаУчета			= ПараметрыКурсовойРазницы.ВидСчетаУчета;
	Субконто1				= ПараметрыКурсовойРазницы.Субконто1;
	Субконто2				= ПараметрыКурсовойРазницы.Субконто2;
	Субконто3				= ПараметрыКурсовойРазницы.Субконто3;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ?(СуммаКурсовойРазницы<0,-1,1) * СуммаКурсовойРазницы, ?(ЭтоОтложеннаяКурсоваяРазница, "Отложенная курсовая разница", "Курсовая разница"));
	
	//УчетКурсовойРазницы = ПолучитьСчетДоходаРасходаПоКурсовойРазнице(ОбъектДокумента, Счет, Субконто1, Субконто2, Субконто3, ДополнительнаяАналитика, Валюта, СуммаКурсовойРазницы, Отказ);			
	АналитикаПерекурсовки = БухгалтерскийУчет.ПолучитьПрочийДоходРасходДляКурсовойРазницы(Счет, ВидСчетаУчета,  НастройкиУчетаОбщие, УчетныйРегистр, ОбъектДокумента.Дата, ОбъектДокумента.СчетДоверительногоУправления, Отказ);
	
	ВидСубконто1 = Неопределено;
	ВидСубконто2 = Неопределено;
	ВидСубконто3 = Неопределено;
	
	Для каждого СтрокаВидыСубконто Из Счет.ВидыСубконто Цикл
		Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
			ВидСубконто1 = СтрокаВидыСубконто.ВидСубконто;
		ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
			ВидСубконто2 = СтрокаВидыСубконто.ВидСубконто;
		ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
			ВидСубконто3 = СтрокаВидыСубконто.ВидСубконто;
		КонецЕсли;
	КонецЦикла;
	Если СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Активный
		ИЛИ СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
			Проводка.СчетДт = Счет;
			Если ЗначениеЗаполнено(Субконто1) Тогда
				Проводка.СубконтоДт[ВидСубконто1] = Субконто1;
			ИначеЕсли ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто1] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто2) Тогда
				Проводка.СубконтоДт[ВидСубконто2] = Субконто2;
			ИначеЕсли ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто2] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто3) Тогда
				Проводка.СубконтоДт[ВидСубконто3] = Субконто3;
			ИначеЕсли ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто3] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			
			Проводка.ВалютаДт = Валюта;
			
			Если ЭтоОтложеннаяКурсоваяРазница Тогда
				Проводка.СчетКт = ПланыСчетов.Основной.ДоходыБудущихПериодов;
			Иначе	
				Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			КонецЕсли;	
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
			Если ЗначениеЗаполнено(Проводка.СубконтоДт.Облигации) Тогда
				Проводка.СубконтоКт.ЦенныеБумаги = Проводка.СубконтоДт.Облигации;
			КонецЕсли;							
			
	ИначеЕсли СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Активный
		ИЛИ СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
		
			//кредит. дебет потом
			Проводка.СчетКт = Счет;
			Если ЗначениеЗаполнено(Субконто1) Тогда
				Проводка.СубконтоКт[ВидСубконто1] = Субконто1;
			ИначеЕсли ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто1] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто2) Тогда
				Проводка.СубконтоКт[ВидСубконто2] = Субконто2;
			ИначеЕсли ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто2] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто3) Тогда
				Проводка.СубконтоКт[ВидСубконто3] = Субконто3;
			ИначеЕсли ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто3] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Проводка.ВалютаКт = Валюта;
			
			//дебет			
			Если ЭтоОтложеннаяКурсоваяРазница Тогда
				Проводка.СчетДт = ПланыСчетов.Основной.РасходыБудущихПериодов;	
			Иначе	
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			КонецЕсли;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
			Если ЗначениеЗаполнено(Проводка.СубконтоДт.Облигации) Тогда
				Проводка.СубконтоДт.ЦенныеБумаги = Проводка.СубконтоКт.Облигации;
			КонецЕсли;				
			
	КонецЕсли;
		
КонецПроцедуры

Процедура ПереоценитьВалютныеАктивы(ОбъектДокумента, УчетныйРегистр, ВидУчета, НастройкиУчетаОбщие, Отказ) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	Если ОбъектДокумента.Движения[УчетныйРегистр].Записывать Тогда
		ОбъектДокумента.Движения[УчетныйРегистр].Записать();
		ОбъектДокумента.Движения[УчетныйРегистр].Прочитать();
		ОбъектДокумента.Движения[УчетныйРегистр].Записывать = Истина;
	КонецЕсли;
	//Возврат;
	ТаблицаСчетовИСубконто = Новый ТаблицаЗначений;
	
	
	СписокТиповСубконто = Новый Массив;
	
	Выборка = ПланыВидовХарактеристик.ВидыСубконто.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивТипов = Выборка.ТипЗначения.Типы();
		Для Каждого ТипИзМассива из МассивТипов Цикл
			Если ТипИзМассива = Тип("Дата") Тогда
				ИмяТипа = "Дата";
			Иначе
				Переменная = Новый(ТипИзМассива);
				ИмяТипа = Переменная.Метаданные().ПолноеИмя();
				ИмяТипа = СтрЗаменить(ИмяТипа, ".", "Ссылка.");
			КонецЕсли;
			Если СписокТиповСубконто.Найти(ИмяТипа) = Неопределено Тогда
				СписокТиповСубконто.Добавить(Тип(ИмяТипа));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	МассивУчетныеАктивыПоЦБ = Новый Массив;
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Акции);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ВекселяДисконтные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ВекселяПроцентные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративные);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.Паи);
	МассивУчетныеАктивыПоЦБ.Добавить(Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&НаДату,
		|			ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И УчетныйАктив В (&МассивУчетныеАктивыПоЦБ)) КАК НастройкиУчетаАктивовСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаВЗалоге,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценкиВЗалоге
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&НаДату,
		|			ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И УчетныйАктив В (&МассивУчетныеАктивыПоЦБ)) КАК НастройкиУчетаАктивовСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("МассивУчетныеАктивыПоЦБ", МассивУчетныеАктивыПоЦБ);
	Запрос.УстановитьПараметр("НаДату", ОбъектДокумента.Дата);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСчетовУчетаБумаг = РезультатЗапроса.Выгрузить();
	
	ТаблицаСчетовИСубконто.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.Основной"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто1", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто2", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто3", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("СуммаВВалютеУчета", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	ВидыСубконто = Новый Массив;
	
	ДтКт = Новый Массив;
	ДтКт.Добавить("Дт");
	ДтКт.Добавить("Кт");
	
	Для Каждого Проводка из ОбъектДокумента.Движения[УчетныйРегистр] Цикл
		Для Инд = 0 По ДтКт.ВГраница() Цикл
		
			// балансовые счета должны быть заполнены
			ТекДтКт = ДтКт[Инд];
			ТекСчет = Проводка["Счет" + ТекДтКт];
			ТекВалюта = Проводка["Валюта" + ТекДтКт];
			//убираем счета учета ЦБ, курсовые по ним - на партиях
			Если НЕ ТекСчет.Валютный Тогда
				Продолжить;
			КонецЕсли;
			Если ТекВалюта = ВалютаУчета Тогда 
				Продолжить;
			КонецЕсли;
			Если ТаблицаСчетовУчетаБумаг.Найти(ТекСчет, "СчетУчета") <> Неопределено
				 ИЛИ ТаблицаСчетовУчетаБумаг.Найти(ТекСчет, "СчетУчетаПереоценки") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТекСчет.Забалансовый Тогда
				//тут исключаем "ПР.1"
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = ТаблицаСчетовИСубконто.Добавить();
			СтрокаТаблицы.Счет = ТекСчет;
			
			СтрокаТаблицы.Субконто1 = Неопределено;
			СтрокаТаблицы.Субконто2 = Неопределено;
			СтрокаТаблицы.Субконто3 = Неопределено;
			
			// проверим заполнение субконто
			Для каждого СтрокаВидыСубконто Из ТекСчет.ВидыСубконто Цикл
				
				Если СтрокаВидыСубконто.ТолькоОбороты 
					Тогда Продолжить; 
				КонецЕсли;
				
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					СтрокаТаблицы.Субконто1 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					СтрокаТаблицы.Субконто2 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					СтрокаТаблицы.Субконто3 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаТаблицы.СуммаВВалютеУчета = ?(ТекДтКт = "Кт", -1, 1) * Проводка.Сумма;
			СтрокаТаблицы.Сумма = ?(ТекДтКт = "Кт", -1, 1) * Проводка["ВалютнаяСумма" + ТекДтКт];
			СтрокаТаблицы.Валюта = ТекВалюта;

		КонецЦикла;		
	КонецЦикла;
	
	ТаблицаСчетовИСубконто.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Валюта", "СуммаВВалютеУчета,Сумма");
	Если ТаблицаСчетовИСубконто.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДвижений.Счет КАК Счет,
		|	ТаблицаДвижений.Субконто1 КАК Субконто1,
		|	ТаблицаДвижений.Субконто2 КАК Субконто2,
		|	ТаблицаДвижений.Субконто3 КАК Субконто3,
		|	ТаблицаДвижений.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаДвижений.Сумма КАК Сумма,
		|	ТаблицаДвижений.Валюта КАК Валюта
		|ПОМЕСТИТЬ ТаблицаДвижений
		|ИЗ
		|	&ТаблицаДвижений КАК ТаблицаДвижений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|	БухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО)) КАК БухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	БухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	БухгалтерскийУчетОстатки.Валюта,
		|	БухгалтерскийУчетОстатки.СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, Субконто2, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.Субконто2 КАК Субконто2,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО)) КАК БухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	БухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	БухгалтерскийУчетОстатки.Валюта,
		|	БухгалтерскийУчетОстатки.СуммаОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, Субконто2, Субконто3, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.Субконто2 КАК Субконто2,
		|						ТаблицаДвижений.Субконто3 КАК Субконто3,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО)) КАК БухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(БухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Вид КАК ВидСчета,
		|	Остатки.Субконто1 КАК Субконто1,
		|	Остатки.Субконто2 КАК Субконто2,
		|	Остатки.Субконто3 КАК Субконто3,
		|	Остатки.Валюта КАК Валюта,
		|	Остатки.СуммаОстаток КАК СуммаОстаток,
		|	Остатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ВЫРАЗИТЬ(Остатки.ВалютнаяСуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2)) КАК СуммаОстатокРасчетная,
		|	Остатки.ВалютнаяСуммаОстаток - ТаблицаДвижений.Сумма КАК ОстатокНаНачалоДокумента
		|ИЗ
		|	Остатки КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО Остатки.Валюта = КурсыВалют.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДвижений КАК ТаблицаДвижений
		|		ПО Остатки.Счет = ТаблицаДвижений.Счет
		|			И (ЕСТЬNULL(Остатки.Субконто1, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО))
		|			И (ЕСТЬNULL(Остатки.Субконто2, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО))
		|			И (ЕСТЬNULL(Остатки.Субконто3, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО))
		|			И Остатки.Валюта = ТаблицаДвижений.Валюта
		|ГДЕ
		|	КурсыВалют.Период = &Период
		|	И (ВЫРАЗИТЬ(Остатки.ВалютнаяСуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2))) <> Остатки.СуммаОстаток";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	Запрос.Параметры.Вставить("Организация", ОбъектДокумента.Организация);
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
	Запрос.Параметры.Вставить("ПослеДокумента", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Включая));
	Запрос.Параметры.Вставить("ТаблицаДвижений", ТаблицаСчетовИСубконто);
	Запрос.Параметры.Вставить("Период", НачалоДня(ОбъектДокумента.Дата));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВидСубконтоЦеннаяБумага = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;
	
	//в результирующей таблице должно быть:
	//Дебетовые остатки остатки по активным счетам > 0, кредитовые остатки не обрабатываем. Кредитовый оборот по активному счету <0, 
	//Кредитовые остатки по пассивынм счетам >0, дебетовые остатки не обрабатываем
	//Процедура списывает курсовые разницы по счетам с остаткамив случае расхода (кредитовый оборот по активному счету и дебетовый - по пассивному).
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаКурсовойРазницы = ВыборкаДетальныеЗаписи.СуммаОстатокРасчетная - ВыборкаДетальныеЗаписи.СуммаОстаток;
		
		Если (ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Активный) 
			ИЛИ (ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.АктивноПассивный И ВыборкаДетальныеЗаписи.СуммаОстаток>0) ТОгда
			ВидСчетаУчета = ВидСчета.Активный;
		Иначе
			ВидСчетаУчета = ВидСчета.Пассивный;
		КонецЕсли;
		
		Если СуммаКурсовойРазницы <> 0 ТОгда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ?(СуммаКурсовойРазницы<0,-1,1) * СуммаКурсовойРазницы, "Курсовая разница");
			
			ВалютаКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Валюта;
			СчетКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Счет;
			Субконто1				= ВыборкаДетальныеЗаписи.Субконто1;
			Субконто2				= ВыборкаДетальныеЗаписи.Субконто2;
			Субконто3				= ВыборкаДетальныеЗаписи.Субконто3;
			
			//АналитикаПерекурсовки = БухгалтерскийУчет.ПолучитьПрочийДоходРасходДляКурсовойРазницы(СчетКурсовойРазницы, ВидСчетаУчета, НастройкиУчетаОбщие);
			АналитикаПерекурсовки = БухгалтерскийУчет.ПолучитьПрочийДоходРасходДляКурсовойРазницы(СчетКурсовойРазницы, ?(ВыборкаДетальныеЗаписи.ОстатокНаНачалоДокумента > 0, ВидСчета.Активный, ВидСчета.Пассивный), НастройкиУчетаОбщие, УчетныйРегистр, ОбъектДокумента.Дата, ОбъектДокумента.СчетДоверительногоУправления, Отказ);

			ВидСубконто1 = Неопределено;
			ВидСубконто2 = Неопределено;
			ВидСубконто3 = Неопределено;
			
			Для каждого СтрокаВидыСубконто Из СчетКурсовойРазницы.ВидыСубконто Цикл
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					ВидСубконто1 = СтрокаВидыСубконто.ВидСубконто;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					ВидСубконто2 = СтрокаВидыСубконто.ВидСубконто;
					Если ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
						Субконто2 = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
					КонецЕсли;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					ВидСубконто3 = СтрокаВидыСубконто.ВидСубконто;
					Если ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
						Субконто3 = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
					КонецЕсли;					
				КонецЕсли;
			КонецЦикла;
			
			Если СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Активный
				ИЛИ СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
				
					Проводка.СчетДт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоДт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоДт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоДт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаДт = ВалютаКурсовойРазницы;
					
					Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
					Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
					Если ЗначениеЗаполнено(Проводка.СубконтоДт.Облигации) Тогда
						Проводка.СубконтоКт.ЦенныеБумаги = Проводка.СубконтоДт.Облигации;
					КонецЕсли;
					
			ИначеЕсли СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Активный
				ИЛИ СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
				
					Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
					Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
					Если ЗначениеЗаполнено(Проводка.СубконтоКт.Облигации) Тогда
						Проводка.СубконтоДт.ЦенныеБумаги = Проводка.СубконтоКт.Облигации;
					КонецЕсли;
					
					Проводка.СчетКт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоКт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоКт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоКт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаКт = ВалютаКурсовойРазницы;
					
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьНаличиеОстатковЗадолженностейПоСделке(Организация, СчетДоверительногоУправления, Сделка, Граница) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",							Граница);
	Запрос.УстановитьПараметр("Сделка",							Сделка);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Задолженность по ДС"" КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И Основание = &Сделка) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Задолженность по ЦБ"",
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток + ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И Основание = &Сделка) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток + ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток > 0";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

Функция ПолучитьПроводкиПоЗакрытиюЗадолженностиПоПереоценкеСделкиТПлюс(Организация, СчетДоверительногоУправления, Сделка, ЦенныеБумаги, УчетныйРегистр, Дата, МоментВремени) Экспорт
	
	Проводки = Новый ТаблицаЗначений;
	
	НастройкиАктиваПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс, УчетныйРегистр);
	//НастройкиПоВидуУчета = ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	
	ЕстьПоручениеНаПереоценку = РаботаСПереоценкой.ОпределитьНаличиеПорученияНаПереоценку(Организация, СчетДоверительногоУправления, Дата, Перечисления.ВидыУчета.БухгалтерскийУчет, Перечисления.ВидыАктивовДляПорученийНаПереоценку.Задолженность);
	
	Если ЗначениеЗаполнено(НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки)
		И НастройкиАктиваПоВидуУчета.ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать
		ИЛИ ЕстьПоручениеНаПереоценку Тогда
		
		ЭтоКонецГода					= НачалоДня(КонецГода(Дата)) = Дата;
		ЭтоКонецКвартала				= НачалоДня(КонецКвартала(Дата)) = Дата;
		ЭтоКонецМесяца					= НачалоДня(КонецМесяца(Дата)) = Дата;
		ЭтоПоследнийРабочийДеньМесяца	= НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(КонецМесяца(Дата)))) = Дата;
		
		ОбращениеНаОРЦБ = ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(Дата, ЦенныеБумаги, УчетныйРегистр);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Граница",						Новый Граница(МоментВремени, ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Период",							Дата);
		Запрос.УстановитьПараметр("Организация",					Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("Сделка",							Сделка);
		Запрос.УстановитьПараметр("ОбращениеНаОРЦБ",				ОбращениеНаОРЦБ);
		Запрос.УстановитьПараметр("ВидУчета",						Перечисления.ВидыУчета[УчетныйРегистр]);
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Сделка);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
		
		Запрос.УстановитьПараметр("ВидыСубконто",					ВидыСубконто);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбращениеНаОРЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОбращениеНаОРЦБ.ОбращаетсяНаОРЦБ КАК ОбращениеНаОРЦБ
		|ПОМЕСТИТЬ _ОбращениеНаОРЦБ
		|ИЗ
		|	&ОбращениеНаОРЦБ КАК ОбращениеНаОРЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
		|ПОМЕСТИТЬ _АналитикаПереоценки
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс)
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Сделка,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК ЦеннаяБумага,
		|	-БухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаДт,
		|	-БухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаКт
		|ПОМЕСТИТЬ _ТекущиеЗадолженности
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&Граница,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &Сделка) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс) КАК СчетДт,
		|	_ТекущиеЗадолженности.Сделка КАК СубконтоДт1,
		|	_ТекущиеЗадолженности.ЦеннаяБумага КАК СубконтоДт2,
		|	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
		|	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы) КАК СчетКт,
		|	_АналитикаПереоценки.АналитикаДоходовОтПереоценки КАК СубконтоКт1,
		|	_ТекущиеЗадолженности.ЦеннаяБумага КАК СубконтоКт2,
		|	_ОбращениеНаОРЦБ.ОбращениеНаОРЦБ КАК СубконтоКт3,
		|	_ТекущиеЗадолженности.СуммаДт КАК Сумма,
		|	ИСТИНА КАК Сторнирование
		|ИЗ
		|	_ТекущиеЗадолженности КАК _ТекущиеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаПереоценки КАК _АналитикаПереоценки
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОбращениеНаОРЦБ КАК _ОбращениеНаОРЦБ
		|		ПО _ТекущиеЗадолженности.ЦеннаяБумага = _ОбращениеНаОРЦБ.ЦеннаяБумага
		|ГДЕ
		|	_ТекущиеЗадолженности.СуммаДт < 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
		|	_АналитикаПереоценки.АналитикаДоходовОтПереоценки,
		|	_ТекущиеЗадолженности.ЦеннаяБумага,
		|	_ОбращениеНаОРЦБ.ОбращениеНаОРЦБ,
		|	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс),
		|	_ТекущиеЗадолженности.Сделка,
		|	_ТекущиеЗадолженности.ЦеннаяБумага,
		|	НЕОПРЕДЕЛЕНО,
		|	_ТекущиеЗадолженности.СуммаКт,
		|	ИСТИНА
		|ИЗ
		|	_ТекущиеЗадолженности КАК _ТекущиеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаПереоценки КАК _АналитикаПереоценки
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОбращениеНаОРЦБ КАК _ОбращениеНаОРЦБ
		|		ПО _ТекущиеЗадолженности.ЦеннаяБумага = _ОбращениеНаОРЦБ.ЦеннаяБумага
		|ГДЕ
		|	_ТекущиеЗадолженности.СуммаКт < 0";
		
		Проводки = Запрос.Выполнить().Выгрузить();
			
	КонецЕсли;
	
	Возврат Проводки;
		
КонецФункции

Функция НужнаИндексацияНоминала(Дата, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт  
	ДатаПереоценки = НачалоДня(Дата);
	
	ПериодичностьИндексацииНоминала = Неопределено;
	ИндексироватьНоминалВНерабочиеДни = Неопределено;
	
	Отказ = Ложь;
	НастройкиВидаУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(Дата, Организация, СчетДоверительногоУправления, ВидУчета, Отказ);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ПериодичностьИндексацииНоминала = НастройкиВидаУчета.ПериодичностьИндексацииНоминала;
	ИндексироватьНоминалВНерабочиеДни = НастройкиВидаУчета.ИндексироватьНоминалВНерабочиеДни;
	
	ПоследняяРабочаяДата = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	
	Если ПериодичностьИндексацииНоминала = Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать Тогда
		Возврат Ложь;
	ИначеЕсли ПериодичностьИндексацииНоминала = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
		Если ПоследняяРабочаяДата <> ДатаПереоценки Тогда
			Возврат ИндексироватьНоминалВНерабочиеДни;
		Иначе
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьИндексацииНоминала, ДатаПереоценки) Тогда
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция НужнаПерекурсовкаВДатуОперации(ДатаПерекурсовки, Организация, СчетДоверительногоУправления, ВидУчета, ВЗалоге = Ложь) Экспорт
	
	//Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &ВЗалоге
		|			ТОГДА НастройкиПоВидуУчетаСрезПоследних.ПериодичностьПерекурсовкиБумагВЗалоге
		|		ИНАЧЕ НастройкиПоВидуУчетаСрезПоследних.ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств
		|	КОНЕЦ КАК ПериодичностьПерекурсовки,
		|	НастройкиПоВидуУчетаСрезПоследних.ПерекурсовыватьВалютныеАктивыВМоментОперации КАК ПерекурсовыватьВалютныеАктивыВМоментОперации
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|			&ДатаПерекурсовки,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И ВидУчета = &ВидУчета) КАК НастройкиПоВидуУчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ДатаПерекурсовки", ДатаПерекурсовки);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВЗалоге", ВЗалоге);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПериодичностьПерекурсовкиБумагВЗалоге = ВыборкаДетальныеЗаписи.ПериодичностьПерекурсовки;
		Если ВыборкаДетальныеЗаписи.ПерекурсовыватьВалютныеАктивыВМоментОперации  Тогда
			Возврат Истина;
		ИначеЕсли ПериодичностьПерекурсовкиБумагВЗалоге = Перечисления.ПериодичностьПереоценкиАктивов.ЕжегодноИПослеПриобретенийИРеализаций
			ИЛИ ПериодичностьПерекурсовкиБумагВЗалоге = Перечисления.ПериодичностьПереоценкиАктивов.ЕжеквартальноИПослеПриобретенийИРеализаций
			ИЛИ ПериодичностьПерекурсовкиБумагВЗалоге = Перечисления.ПериодичностьПереоценкиАктивов.ЕжемесячноИПослеПриобретенийИРеализаций
			ИЛИ ПериодичностьПерекурсовкиБумагВЗалоге = Перечисления.ПериодичностьПереоценкиАктивов.ПослеПриобретенийИРеализаций Тогда
			Возврат Истина;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ПолучитьДополнительнуюАналитикуБухгалтерскогоУчета(Организация, ДанныеАналитики) Экспорт

	Сделка			 = Документы.Сделка.ПустаяСсылка();
	СделкаРЕПО		 = Документы.СделкаРЕПО.ПустаяСсылка();
	ВидЗадолженности = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка();
	
	ЕстьСделка			 = ДанныеАналитики.Свойство("Сделка", Сделка);
	ЕстьСделкаРЕПО		 = ДанныеАналитики.Свойство("СделкаРЕПО", СделкаРЕПО);
	ЕстьВидЗадолженности = ДанныеАналитики.Свойство("ВидЗадолженности", ВидЗадолженности);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДополнительныеАналитикиБухгалтерскогоУчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеАналитикиБухгалтерскогоУчета КАК ДополнительныеАналитикиБухгалтерскогоУчета
		|ГДЕ
		|	ДополнительныеАналитикиБухгалтерскогоУчета.Организация = &Организация
		|	И ДополнительныеАналитикиБухгалтерскогоУчета.Сделка = &СделкаОбычная
		|	И ДополнительныеАналитикиБухгалтерскогоУчета.СделкаРЕПО = &СделкаРЕПО
		|	И ДополнительныеАналитикиБухгалтерскогоУчета.ВидЗадолженности = &ВидЗадолженности";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ЕстьСделка Тогда
		Запрос.УстановитьПараметр("СделкаОбычная", Сделка);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СделкаОбычная", "ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка)");
	КонецЕсли;
	
	Если ЕстьСделкаРЕПО Тогда
		Запрос.УстановитьПараметр("СделкаРЕПО", СделкаРЕПО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СделкаРЕПО", "ЗНАЧЕНИЕ(Документ.СделкаРЕПО.ПустаяСсылка)");
	КонецЕсли;
	
	Если ЕстьВидЗадолженности Тогда
		Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидЗадолженности", "ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПустаяСсылка)");
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
		
	Иначе
		
		НоваяАналитика = Справочники.ДополнительныеАналитикиБухгалтерскогоУчета.СоздатьЭлемент();
		НоваяАналитика.Организация = Организация;
		
		Если ЕстьСделка Тогда
			НоваяАналитика.Сделка = Сделка;
		КонецЕсли;
		Если ЕстьСделкаРЕПО Тогда
			НоваяАналитика.СделкаРЕПО = СделкаРЕПО;
		КонецЕсли;
		Если ЕстьВидЗадолженности Тогда
			НоваяАналитика.ВидЗадолженности = ВидЗадолженности;
		КонецЕсли;
		
		НоваяАналитика.Записать();
		
		Возврат НоваяАналитика.Ссылка;
	
	КонецЕсли;
	
КонецФункции 

// Реквизиты, это структура с полями "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов"
Функция ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета) Экспорт
	
	Если (НЕ НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет							// если мы не ведем ЕПС
			ИЛИ НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО)	// или ведем, но берем именно брокера
		И ЗначениеЗаполнено(Реквизиты.Брокер)										// ну и брокер, конечно заполнен
	Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Брокер, "ЮрФизЛицо");		// брокер
	КонецЕсли;
	
	Если БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(Реквизиты.СчетДоверительногоУправления, Реквизиты.Дата) 	// у группы Будущее
		И ЗначениеЗаполнено(Реквизиты.РежимБиржевыхТоргов)														// РЕПО на бирже
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.РежимБиржевыхТоргов, "РЕПО_М") Тогда				// по сделкам РЕПО-М берем раскрытого контрагента
			
		РаскрытыйКонтрагент = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, "_РаскрытыйКонтрагент", Реквизиты.Ссылка);
		Если ЗначениеЗаполнено(РаскрытыйКонтрагент) Тогда														// если он есть, конечно
			Возврат РаскрытыйКонтрагент;
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Реквизиты.Контрагент;
	
КонецФункции

Функция ОпределитьИФНС(Документ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИФНСОрганизацийСрезПоследних.ИФНС КАК ИФНС
		|ИЗ
		|	РегистрСведений.ИФНСОрганизаций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И НЕ ПоКрупнейшимНалогоплательщикам) КАК ИФНСОрганизацийСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Запрос.УстановитьПараметр("Период", Документ.Дата);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ИФНС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция НастройкаОтражатьНаПереоценкеПолнуюСумму(Период, Организация, СчетДоверительногоУправления, УчетныйАктив, ВидУчета)
	
	// _СчетаСНГ - счета ду СНГ в РЭМ. 
	//	Заменяем вызов функции РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента()
	//  Запрос взят из Кэширование.СчетаДоверительногоУправленияКлиента. Замена хардкода для СНГ
	//  _ПереводыПрофучастнику - для ИИС узнаем был ли перевод активов другому профучаснику
	//  _СчетДУ - нужные параметры счета ДУ
	// Результат:
	// - для физлиц "Да" с 2020 года. 
	// - для ИИС, закрытие после 01.01.2021 - да. 
	// - ИИС, закрытые до 01.01.2021 - да, если был перевод активов - тогда нет. 
	// по физлицам сдаем налог ежегодно, по ИСС по факту закрытия. Если у ИСС считали "неправильно" и он от нас ушел, остается как было. 
	// - СНГ. только купон корпоративный. До 2020 "да". 
	
	//#518772 c 01.01.2024 для ИИС и ФЛ значение настройки = НЕТ
	
	Если УчетныйАктив <> Неопределено 
		И ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
		Возврат Ложь;  //настройка имеет смысл только для НУ. Если УчетныйАктив = Неопределено, тогда возращаем структуру: запрос надо выполнить.
	КонецЕсли;	
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ПОМЕСТИТЬ _СчетаСНГ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
		|			И (СчетаДоверительногоУправления.Организация = &ОрганизацияРЭМ)
		|			И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
		|			И (СчетаДоверительногоУправления.ДатаЗаключения <= &Период)
		|			И (СчетаДоверительногоУправления.ДатаРасторжения > &Период
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &КлиентСНГ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РасчетНДФЛ.Ссылка КАК Ссылка,
		|	РасчетНДФЛ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ПереводыПрофучастнику
		|ИЗ
		|	Документ.РасчетНДФЛ КАК РасчетНДФЛ
		|ГДЕ
		|	НЕ РасчетНДФЛ.ПометкаУдаления
		|	И РасчетНДФЛ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РасчетНДФЛ.ОснованиеРасчета = ЗНАЧЕНИЕ(Перечисление.ОснованияРасчетаНДФЛ.ПереводАктивовДругомуПрофучастнику)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА НЕ _ПереводыПрофучастнику.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЗакрытПереводом,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.Ссылка В
		|				(ВЫБРАТЬ
		|					_СчетаСНГ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|				ИЗ
		|					_СчетаСНГ КАК _СчетаСНГ)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоСНГ
		|ПОМЕСТИТЬ _СчетДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереводыПрофучастнику КАК _ПереводыПрофучастнику
		|		ПО СчетаДоверительногоУправления.Ссылка = _ПереводыПрофучастнику.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивы.Ссылка КАК УчетныйАктив,
		|	УчетныеАктивы.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
		|	ВЫБОР
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И _СчетДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
		|				И УчетныеАктивы.Ссылка В (&АктивыКупон)
		|				И (&Период >= ДАТАВРЕМЯ(2020, 1, 1)
		|					И &Период < ДАТАВРЕМЯ(2024, 1, 1))
		|			ТОГДА ИСТИНА
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И _СчетДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|				И УчетныеАктивы.Ссылка В (&АктивыКупон)
		|				И (_СчетДУ.ДатаРасторжения >= ДАТАВРЕМЯ(2021, 1, 1)
		|					ИЛИ _СчетДУ.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|				И &Период < ДАТАВРЕМЯ(2024, 1, 1)
		|			ТОГДА ИСТИНА
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И _СчетДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|				И УчетныеАктивы.Ссылка В (&АктивыКупон)
		|				И _СчетДУ.ДатаРасторжения < ДАТАВРЕМЯ(2021, 1, 1)
		|				И НЕ _СчетДУ.ЗакрытПереводом
		|			ТОГДА ИСТИНА
		|		КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И _СчетДУ.ЭтоСНГ
		|				И УчетныеАктивы.Ссылка = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
		|				И &Период < ДАТАВРЕМЯ(2020, 1, 1, 0, 0, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЗначениеНастройки
		|ИЗ
		|	Справочник.УчетныеАктивы КАК УчетныеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетДУ КАК _СчетДУ
		|		ПО (ИСТИНА)
		|ГДЕ
		|	&ОтборУчетныхАктивов";
	Если УчетныйАктив = Неопределено Тогда                                                                                
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборУчетныхАктивов", " НЕ УчетныеАктивы.ПометкаУдаления");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборУчетныхАктивов", "УчетныеАктивы.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", УчетныйАктив);
	КонецЕсли;
	
	АктивыКупон = Новый Массив;
	АктивыКупон.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
	АктивыКупон.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
	АктивыКупон.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	АктивыКупон.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	
	Запрос.УстановитьПараметр("АктивыКупон", АктивыКупон);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОрганизацияРЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("КлиентСНГ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФ_СНГ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если УчетныйАктив = Неопределено Тогда 
		//возвращаем структуру
		НастройкаУчетаАктивов = Новый Структура();
		Пока Выборка.Следующий() Цикл
			НастройкаУчетаАктивов.Вставить(Выборка.ИмяПредопределенныхДанных, Выборка.ЗначениеНастройки);
		КонецЦикла;
		Возврат НастройкаУчетаАктивов;
	Иначе
		//возвращаем значение настройки
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЗначениеНастройки;
		КонецЕсли;		
	КонецЕсли;	
		
КонецФункции	

Функция ВидЗадолженностиСвязанСПартиями(ВидЗадолженности) Экспорт

	Возврат Кэширование.ВидЗадолженностиСвязанСПартиями(ВидЗадолженности);

КонецФункции

Процедура ДвижениеПереоценки(ОбъектДокумента, Параметры, Отказ) Экспорт 
	
	УчетныйРегистр		= Параметры.УчетныйРегистр;
	ЦеннаяБумага		= Параметры.ЦеннаяБумага;
	ВидСубконто			= Параметры.ВидСубконто;
	ВалютаНоминала		= Параметры.ВалютаНоминала;
	ОбращаетсяНаОРЦБ	= Параметры.ОбращаетсяНаОРЦБ;
	Аналитика			= Параметры.Аналитика;
	СчетУчета			= Параметры.СчетУчета;
	Сумма				= Параметры.Сумма;
	СуммаВал			= Параметры.СуммаВал;
	
	Если Сумма > 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Сумма, "Переоценка");
		
		
		Проводка.СчетДт = СчетУчета;
		
		Проводка.СубконтоДт[ВидСубконто] = ЦеннаяБумага;
		
		Если СчетУчета.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = СуммаВал;
			Проводка.ВалютаДт		 = ВалютаНоминала;
		КонецЕсли;
		
		
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
		
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = Аналитика;
		Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
	ИначеЕсли Сумма < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], - Сумма, "Переоценка");
		
		
		Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
		
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
		
		Проводка.СчетКт = СчетУчета;
		
		Проводка.СубконтоКт[ВидСубконто] = ЦеннаяБумага;
		
		Если СчетУчета.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = - СуммаВал;
			Проводка.ВалютаКт		 = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроизвестиПереоценкуБумагиИКупонаБУНУ(ОбъектДокумента, ПараметрыПереоценки, Выборка, НастройкиУчета, НастройкиУчетаКупона) Экспорт

	Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
		ВидСделки = ОбъектДокумента.ВидСделки;
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПоставкаЦенныхБумаг") Тогда
		ВидСделки = ОбъектДокумента.Основание.ВидСделки;
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка") Тогда
		ВидСделки = ОбъектДокумента.ВидСделки;
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.СделкаРЕПО") Тогда
		ВидСделки = ОбъектДокумента.ВидСделки;
		
		Если ОбъектДокумента.ЧастьСделкиРЕПО = 2			// если закрытие РЕПО
			И ВидСделки = Перечисления.ВидыСделок.Покупка	// причем, закрытие прямого РЕПО - т.е. бумаги возвращаются из РЕПО
			И ОбъектДокумента.Дата >= '20241101' Тогда		// причем с 1.11.24 т.к. ранее РПИ закрыли корректировками
		
			ВидСделки = Перечисления.ВидыСделок.Продажа;	// то видом сделки считаем продажу, чтобы взялись аналитики переоценки, а не ПП т.к. ПП уже было, мы просто вернули бумаги из РЕПО 
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
	
		АналитикаПереоценки = НастройкиУчета.АналитикаПервоначальногоПризнания;
		АналитикаПереоценкиКупона = НастройкиУчетаКупона.АналитикаПервоначальногоПризнания;
		
	ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		
		АналитикаПереоценки = НастройкиУчета.АналитикаДоходовОтПереоценки;
		АналитикаПереоценкиКупона = НастройкиУчетаКупона.АналитикаДоходовОтПереоценки;
		
	КонецЕсли;
	
	Если Выборка.СтоимостьВВалютеУчетаДоначислено <> 0 Тогда
	
		ПараметрыПереоценки.Вставить("СуммаВВалютеНоминала", Выборка.СтоимостьДоначислено); 
		ПараметрыПереоценки.Вставить("СуммаВВалютеУчета", Выборка.СтоимостьВВалютеУчетаДоначислено); 
		
		ПараметрыПереоценки.Вставить("Описание", "Переоценка ценной бумаги"); 
		ПараметрыПереоценки.Вставить("СчетУчета", НастройкиУчета.СчетУчета);
		ПараметрыПереоценки.Вставить("АналитикаДоходовОтПереоценки", АналитикаПереоценки);
		
		БухгалтерскийУчет.ДвижениеПереоценкиБУНУ(ОбъектДокумента, ПараметрыПереоценки);
		
	КонецЕсли;
	
	Если Выборка.ПереоценкаВВалютеУчетаДоначислено <> 0 Тогда
	
		ПараметрыПереоценки.Вставить("СуммаВВалютеНоминала", Выборка.ПереоценкаДоначислено); 
		ПараметрыПереоценки.Вставить("СуммаВВалютеУчета", Выборка.ПереоценкаВВалютеУчетаДоначислено); 
		
		ПараметрыПереоценки.Вставить("Описание", "Переоценка ценной бумаги"); 
		ПараметрыПереоценки.Вставить("СчетУчета", НастройкиУчета.СчетУчетаПереоценки);
		ПараметрыПереоценки.Вставить("АналитикаДоходовОтПереоценки", АналитикаПереоценки);
		
		БухгалтерскийУчет.ДвижениеПереоценкиБУНУ(ОбъектДокумента, ПараметрыПереоценки);
		
	КонецЕсли;
	
	
	Если Выборка.СтоимостьКупонаВВалютеУчетаДоначислено <> 0 Тогда
	
		ПараметрыПереоценки.Вставить("СуммаВВалютеНоминала", Выборка.СтоимостьКупонаДоначислено); 
		ПараметрыПереоценки.Вставить("СуммаВВалютеУчета", Выборка.СтоимостьКупонаВВалютеУчетаДоначислено); 
		
		ПараметрыПереоценки.Вставить("Описание", "Переоценка купона ценной бумаги"); 
		ПараметрыПереоценки.Вставить("СчетУчета", НастройкиУчетаКупона.СчетУчета);
		ПараметрыПереоценки.Вставить("АналитикаДоходовОтПереоценки", АналитикаПереоценкиКупона);
		
		БухгалтерскийУчет.ДвижениеПереоценкиБУНУ(ОбъектДокумента, ПараметрыПереоценки);
		
	КонецЕсли;
	
	Если Выборка.ПереоценкаКупонаВВалютеУчетаДоначислено <> 0 Тогда
	
		ПараметрыПереоценки.Вставить("СуммаВВалютеНоминала", Выборка.ПереоценкаКупонаДоначислено); 
		ПараметрыПереоценки.Вставить("СуммаВВалютеУчета", Выборка.ПереоценкаКупонаВВалютеУчетаДоначислено); 
		
		ПараметрыПереоценки.Вставить("Описание", "Переоценка купона ценной бумаги"); 
		ПараметрыПереоценки.Вставить("СчетУчета", НастройкиУчетаКупона.СчетУчетаПереоценки);
		ПараметрыПереоценки.Вставить("АналитикаДоходовОтПереоценки", АналитикаПереоценкиКупона);
		
		БухгалтерскийУчет.ДвижениеПереоценкиБУНУ(ОбъектДокумента, ПараметрыПереоценки);
		
	КонецЕсли;

КонецПроцедуры

Процедура НачислитьКурсовуюРазницуБумагиИКупонаНУБУ(ОбъектДокумента, ПараметрыПерекурсовки, УчетныйАктив, НастройкиУчетаАктива, УчетныйАктивКупона, НастройкиУчетаКупона, УчетныйРегистр, ОбращаетсяНаОРЦБ, Отказ)  Экспорт
		
	СчетаУчета = Новый Структура;
	СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчета);
	СчетаУчета.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчета);
	
	СчетаУчетаПереоценки = Новый Структура;
	СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценки);
	СчетаУчетаПереоценки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.СчетУчетаПереоценки);
	
	АналитикаПерекурсовки = Новый Структура;
	АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
	АналитикаПерекурсовки.Вставить(УчетныйАктивКупона.ИмяПредопределенныхДанных, НастройкиУчетаКупона.АналитикаПерекурсовки);
	
	БухгалтерскийУчет.ДвижениеПерекурсовки(ОбъектДокумента, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);				
	
	
КонецПроцедуры	

Функция КурсоваяРазницаПереоценкиУдовлетворяет67ФЗ(СуммаКурсовойРазницы, ВидУчета, СчетУчета, Дата) Экспорт
	
	// #434365
	// 1. Налоговый учет
	// 2. Курсовая разница по обязательствам и требованиям (Дебиторка, кредиторка, депозиты) признается на момент исполнения 
	// 3. Положительная курсовая разница не принимается к учету с 01.01.2022 по 31.12.2024
	// 4. Отрицательная курсовая разница не принимается к учету с 01.01.2023 по 31.12.2024
	// Для всех документов кроме Переоценки курсовая разница работает как обычно. В переоценке контролируем выполнение этих условий
	// счет 76.40 (РасчетыЧерезБрокераВВалюте) переоцениваем как денежные средства 
	// данную функцию следует вызывать только из переоценки (ценных бумаг, валютных ценностей) 
	
	// #542182 В проверку добавлен счет 58.3     
	// #586519 продлен период действия закона до 31.12.2027
	
	Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		Если (СчетУчета.ПринадлежитЭлементу(ПланыСчетов.Основной.РасчетыСПрочимиДебиторамиИКредиторами)
			И СчетУчета <> ПланыСчетов.Основной.РасчетыЧерезБрокераВВалюте)
			ИЛИ СчетУчета.ПринадлежитЭлементу(ПланыСчетов.Основной.РасчетыПоКраткосрочнымКредитамИЗаймам) 
			ИЛИ СчетУчета = ПланыСчетов.Основной.ПредоставленныеЗаймы  Тогда
			Если СуммаКурсовойРазницы > 0 Тогда
				Если Дата >= Дата(2022, 1, 1) И Дата < Дата(2028,1,1) Тогда
					Возврат Истина;
				КонецЕсли;	
			Иначе 
				Если Дата >= Дата(2023, 1, 1) И Дата < Дата(2028,1,1) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		Конецесли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ВосстановитьПереоценкуЗадолженности(ОбъектДокумента, УчетныйРегистр, ВидЗадолженности, Отказ) Экспорт
	
	Если УчетныйРегистр <> "БухгалтерскийУчет" Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектДокумента.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") 
		<>	Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДДУ Тогда
		Возврат; //На 76.ПЗ.71 переоценка объекта по ДДУ, её восстанавливать не надо
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК СчетПереоценкиОстаток,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Контрагент,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК ОснованиеРасчетов,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	НастройкиУчетаКомиссииСрезПоследних.АналитикаПереоценки КАК АналитикаПереоценки,
		|	ВЫБОР
		|		КОГДА БухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ЗакрытиеКредитногоИнструмента.КредитныйИнструмент
		|		КОГДА БухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.Сделка
		|			ТОГДА Сделка.Договор
		|		КОГДА БухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.СделкаСНедвижимостью
		|			ТОГДА СделкаСНедвижимостью.Договор
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяССылка)
		|	КОНЕЦ КАК Договор,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток, 0) КАК ОстатокЗадолженностиДоДвижения,
		|	ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамДвижения.Сумма, 0) КАК СуммаДвиженияЗадолженности
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ДоДокумента,
		|			Счет В ИЕРАРХИИ (&Счет76ПЗ),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто2 В (&ОснованияРасчетов)) КАК БухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДоДокумента,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = &ВидЗадолженности
		|					И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО БухгалтерскийУчетОстатки.Счет = НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = Сделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = СделкаСНедвижимостью.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = ЗакрытиеКредитногоИнструмента.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&ДоДокумента,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = &ВидЗадолженности
		|					И Основание В (&ОснованияРасчетов)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = ЗадолженностиПоДенежнымСредствамОстатки.Основание
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|			СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) КАК Сумма
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ГДЕ
		|			ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|			И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = &ВидЗадолженности
		|			И ЗадолженностиПоДенежнымСредствам.Основание В(&ОснованияРасчетов)
		|			И ЗадолженностиПоДенежнымСредствам.Регистратор = &ДокументСсылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗадолженностиПоДенежнымСредствам.Основание) КАК ЗадолженностиПоДенежнымСредствамДвижения
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = ЗадолженностиПоДенежнымСредствамДвижения.Основание";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	ОснованияРасчетов = Новый Массив;
	Если ТипЗнч(ОбъектДокумента.Ссылка) = Тип("ДокументСсылка.Оплата") Тогда
		ОснованияРасчетов = ОбъектДокумента.Основания.ВыгрузитьКолонку("Основание");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано получение основанияРасчетов для документа типа "+ТипЗнч(ОбъектДокумента.Ссылка), ОбъектДокумента.ссылка,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ОбъектДокумента.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("Счет76ПЗ", ПланыСчетов.Основной.ПереоценкаЗадолженностей);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОснованияРасчетов", ОснованияРасчетов);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("ДокументСсылка", ОбъектДокумента.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаПереоценки) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПереоценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для основания расчетов " + ВыборкаДетальныеЗаписи.ОснованиеРасчетов + " не удалось определить настройки переоценки", ОбъектДокумента.ссылка,,,Отказ);
			Возврат;
		КонецЕсли;
		
		//Если настройки поменялись, остатки надо переместить корректировкой
		Если ВыборкаДетальныеЗаписи.СчетУчетаПереоценки <> ВыборкаДетальныеЗаписи.СчетПереоценкиОстаток Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счета учета переоценки на остатках и в настройках для вида задолженности " + ВидЗадолженности + " по основанию расчетов " + ВыборкаДетальныеЗаписи.ОснованиеРасчетов + " отличаются. Остаток переоценки не восстановле", ОбъектДокумента.ссылка,,,Отказ);
			Возврат;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ОстатокЗадолженностиДоДвижения <> 0 
			И ОбъектДокумента.Дата >= Дата(2023,10,1) Тогда
			
			СуммаПереоценкиДляПроводки = Окр(ВыборкаДетальныеЗаписи.СуммаОстаток 
				* ВыборкаДетальныеЗаписи.СуммаДвиженияЗадолженности / ВыборкаДетальныеЗаписи.ОстатокЗадолженностиДоДвижения, 2);
				
		Иначе
			СуммаПереоценкиДляПроводки = ВыборкаДетальныеЗаписи.СуммаОстаток;
		КонецЕсли;
		
		Если СуммаПереоценкиДляПроводки > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаПереоценкиДляПроводки, "Восстановлена переоценка задолженности");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.ОснованиеРасчетов;
			
		ИначеЕсли СуммаПереоценкиДляПроводки < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], - СуммаПереоценкиДляПроводки, "Восстановлена переоценка задолженности");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоДт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.ОснованиеРасчетов;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьНастройкиУчетаЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, ИмяМетода) Экспорт

	Возврат Кэширование.ОпределитьНастройкиУчетаЦенныхБумаг(Период, Организация, СчетДоверительногоУправления, ИмяМетода);
	
КонецФункции

Функция ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчета, ЦеннаяБумага, УчетныйАктивЕПС, Партия = Неопределено, СтрокаПартии = Неопределено) Экспорт

	Если ТипЗнч(ЦеннаяБумага) <> Тип("СправочникСсылка.Облигации") Тогда
		Возврат НастройкиУчета;
	КонецЕсли;
	
	НастройкиЦенныхБумаг = НастройкиУчета.НастройкиУчетаЦенныхБумаг;
	
	НастройкиДляЦеннойБумаги = РаботаСКоллекциями.СкопироватьСтруктуру(НастройкиУчета);
	
	СтрокиНастроекПоЦБ = Новый Массив();
	СтрокиНастроекПоПартиям = Новый Массив();
	
	Если Партия <> Неопределено И СтрокаПартии <> Неопределено Тогда // эти 2 параметра всегда идут синхронно: либо заполнены, либо не заполнены
		СтрокиНастроекПоПартиям = НастройкиЦенныхБумаг.НайтиСтроки(Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии", ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии));
	КонецЕсли;
	
	// всё что не нашли или не искали по партии - будем искать по ценной бумаге
	СтрокиНастроекПоЦБ = НастройкиЦенныхБумаг.НайтиСтроки(Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии", ЦеннаяБумага, УчетныйАктивЕПС, Неопределено, 0));
	
	// Сначала устанавливаем настройки по ЦБ
	Для Каждого СтрокаНастроекПоЦБ Из СтрокиНастроекПоЦБ Цикл
		НастройкиДляЦеннойБумаги[СтрокаНастроекПоЦБ.Имя] = СтрокаНастроекПоЦБ.ЗначениеНастройки;
		НастройкиДляЦеннойБумаги.Вставить(СокрЛП(СтрокаНастроекПоЦБ.Имя) + "_Переопределена", Истина);
	КонецЦикла;
	
	// И если есть настройки по партиям - у них выше приоритет, и они должны будут перекрыть настройки по ЦБ
	Для Каждого СтрокаНастроекПоПартиям Из СтрокиНастроекПоПартиям Цикл
		НастройкиДляЦеннойБумаги[СтрокаНастроекПоПартиям.Имя] = СтрокаНастроекПоПартиям.ЗначениеНастройки;
		НастройкиДляЦеннойБумаги.Вставить(СокрЛП(СтрокаНастроекПоПартиям.Имя) + "_Переопределена", Истина);
	КонецЦикла;
	
	Возврат НастройкиДляЦеннойБумаги;
	
КонецФункции 

Процедура СформироватьПроводкиПокупкиПродажиЦеннойБумагиБУНУ(ЭтотОбъект, УчетныйРегистр, Отказ) Экспорт

	ЭтоСделка = (ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.Сделка"));
	ЭтоИсполнение = (ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке"));
	ЭтоПоставка = (ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.ПоставкаЦенныхБумаг"));
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Неопределено;
	ЕстьМенеджерВременныхТаблицДвиженияПартийЗаПериод = ЭтотОбъект.ДополнительныеСвойства.Свойство("МенеджерВременныхТаблицДвиженияПартийЗаПериод", МенеджерВременныхТаблиц);
	
	ЭтоПриобретениеПаев = Ложь;
	
	Если ЭтоСделка Тогда
		Брокер = ЭтотОбъект.Брокер;
		ВидСделки = ЭтотОбъект.ВидСделки;
		Контрагент = ЭтотОбъект.Контрагент;
		Сделка = ЭтотОбъект.Ссылка;
		ВалютаТорговойКомиссии = ЭтотОбъект.ВалютаТорговойКомиссии;	
	ИначеЕсли ЭтоИсполнение Тогда
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Основание, "Контрагент, ВалютаТорговойКомиссии");
		Брокер = ЭтотОбъект.Брокер;
		ВидСделки = ЭтотОбъект.ВидСделки;
		Контрагент = РеквизитыОснования.Контрагент;
		Сделка = ЭтотОбъект.Основание;
		ВалютаТорговойКомиссии = РеквизитыОснования.ВалютаТорговойКомиссии;	
	ИначеЕсли ЭтоПоставка Тогда 
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Основание, "Контрагент, Брокер, ВидСделки, ВалютаТорговойКомиссии, ПриобретениеПаев, РасчетныйСчет");
		
		Брокер = РеквизитыОснования.Брокер;
		ВидСделки = РеквизитыОснования.ВидСделки;
		Контрагент = Брокер.ЮрФизЛицо;
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			Контрагент = РеквизитыОснования.Контрагент;
		КонецЕсли;
		
		ВалютнаяСделка = ЭтотОбъект.ВалютаСделки <> ЭтотОбъект.Организация.ВалютаУчета;
		СчетРасчетовПоСделке = ?(НЕ ВалютнаяСделка, ПланыСчетов.Основной.РасчетыСКонтрагентами, ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте);
		Сделка = ЭтотОбъект.Основание;
		ВалютаТорговойКомиссии = РеквизитыОснования.ВалютаТорговойКомиссии;	
		
		Если ЭтотОбъект.ВидДвижения = Перечисления.ВидыДвижений.Расход
			И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.Сделка") Тогда
			
			ЭтоПриобретениеПаев = РеквизитыОснования.ПриобретениеПаев;
			
		КонецЕсли;
	Иначе
		ВызватьИсключение "По документу " + ТипЗнч(ЭтотОбъект) + " формирование " + УчетныйРегистр + " не поддерживается!";
	КонецЕсли;	
	
	СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВалютаСделки,
		Брокер);	
		
	СчетУчетаДСДляКомиссии = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ВалютаТорговойКомиссии,
		Брокер);	
		
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	

	// проводки по торговой комиссии
	Если ЭтоСделка Тогда
		СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
			УчетныйРегистр,
			"СчетУчета");
			
		СчетУчетаКомиссииБрокера = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии,
			УчетныйРегистр,
			"СчетУчета");
	Иначе
		СчетУчетаКомиссии = ПланыСчетов.Основной.РасчетыПоКомиссии;
		
		СчетУчетаКомиссииБрокера = ПланыСчетов.Основной.РасчетыПоКомиссии;
	КонецЕсли;		
		
	ВыделятьРасходыПриПродаже = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		"ВыделятьРасходыПриПродаже");
		
	АналитикаУслуг = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии,
		УчетныйРегистр,
		"Аналитика");			
	
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов  = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
	
	ЕстьСубконтоКонтрагентыПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);						
	
	Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
		Если Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
			КонтрагентПоКомиссии = Брокер.ЮрФизЛицо;
		Иначе
			КонтрагентПоКомиссии = Контрагент;
		КонецЕсли
	КонецЕсли;
	
	ЕстьСубконтоСделкиПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено);
	ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии = (СчетУчетаКомиссии.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено);
	
	Если ЭтоСделка Тогда	
		ОплачиватьКомиссию = НЕ ЭтотОбъект.ОтложеннаяОплатаТорговойКомиссии;
	Иначе
		ОплачиватьКомиссию = Ложь;
	КонецЕсли;
	
	Если СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено
		Или ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии Тогда
		СубконтоДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, Брокер, ЭтотОбъект.Дата);
	КонецЕсли;
	
	// ЦЕННЫЕ БУМАГИ
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр);
		
#Область ТорговаяКомиссия	

	// КОМИССИЯ
	ВыделятьРасходыПриПродаже = Ложь;
	Если (ВидСделки = Перечисления.ВидыСделок.Продажа) Или (ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы) Тогда
		ВыделятьРасходыПриПродаже = НастройкиПоВидуУчета.ВыделятьРасходыПриПродаже;
	КонецЕсли;
	
	Если ЭтоСделка И НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Начисления Тогда
		НачислятьКомиссию = Истина;
		
		Если ЭтотОбъект.ОтложенноеИсполнение
			И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
			И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			НачислятьКомиссию = Ложь;
		КонецЕсли;
		
		Если НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда
			Если ЭтотОбъект.ОтложенноеИсполнение Тогда
				НачислятьКомиссию = Истина;
				ИспользоватьСчет7616 = Истина;
			Иначе
				Если ВидСделки = Перечисления.ВидыСделок.Покупка И НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда
					НачислятьКомиссию = Ложь; // на 58ой отправит ниже проведение
				Иначе
					НачислятьКомиссию = Истина;
					ИспользоватьСчет7616 = Ложь;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли НачислятьКомиссию Тогда
			
			ИспользоватьСчет7616 = Ложь;
			Если (ВидСделки = Перечисления.ВидыСделок.Покупка) 
				И (НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость)
				И (ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Фьючерсы) Тогда
				ИспользоватьСчет7616 = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		ТаблицаКомиссий = ЭтотОбъект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, ТорговаяКомиссия");
		ТаблицаКомиссий.Колонки.Добавить("Валюта");
		ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности");
		
		ТаблицаКомиссий.ЗаполнитьЗначения(ВалютаТорговойКомиссии, "Валюта");
		ТаблицаКомиссий.ЗаполнитьЗначения(Справочники.ВидыЗадолженности.ПоТорговойКомиссии, "ВидЗадолженности");
		
		ОбъектКомиссииСсылка = ЭтотОбъект.Ссылка;
		
	ИначеЕсли ЭтоСделка И НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый Тогда
		
		Если ЭтотОбъект.ОтложеннаяОплатаТорговойКомиссии Тогда
			НачислятьКомиссию = Ложь;
		Иначе
			
			Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
				
			    НачислятьКомиссию = Истина;
				ИспользоватьСчет7616 = Ложь;
			
			ИначеЕсли НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Тогда
				
				Если ЭтотОбъект.ОтложенноеИсполнение Тогда
					НачислятьКомиссию = Истина;
					
					Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
						ИспользоватьСчет7616 = Истина;
					Иначе	
						ИспользоватьСчет7616 = Ложь;
					КонецЕсли;
				Иначе
					Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
						НачислятьКомиссию = Ложь; // на 58ой отправит ниже проведение
						ИспользоватьСчет7616 = Ложь;
					Иначе
						НачислятьКомиссию = Истина;
						ИспользоватьСчет7616 = Ложь;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				
				НачислятьКомиссию = Истина;
				ИспользоватьСчет7616 = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ТаблицаКомиссий = ЭтотОбъект.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, ТорговаяКомиссия");
		ТаблицаКомиссий.Колонки.Добавить("Валюта");
		ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности");
		
		ТаблицаКомиссий.ЗаполнитьЗначения(ВалютаТорговойКомиссии, "Валюта");
		ТаблицаКомиссий.ЗаполнитьЗначения(Справочники.ВидыЗадолженности.ПоТорговойКомиссии, "ВидЗадолженности");
		
		ОбъектКомиссииСсылка = ЭтотОбъект.Ссылка;
		
	ИначеЕсли (ЭтоИсполнение Или ЭтоПоставка) И НастройкиПоВидуУчета.МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Начисления
		И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		И (Не НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость Или ВидСделки = Перечисления.ВидыСделок.Продажа) Тогда // для Исполнения по НУ только продажи, покупки на 58ой ниже
		
		ОбъектКомиссииСсылка = ЭтотОбъект.Основание;
		
		Если ЭтоИсполнение Тогда
			
			НачислятьКомиссию = Истина;
			ИспользоватьСчет7616 = Ложь;
			
			ТаблицаКомиссий = ЭтотОбъект.Основание.ЦенныеБумаги.Выгрузить(, "ЦеннаяБумага, ТорговаяКомиссия");
			
			ТаблицаКомиссий.Колонки.Добавить("Валюта");
			ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности");
			
			ТаблицаКомиссий.ЗаполнитьЗначения(ВалютаТорговойКомиссии, "Валюта");
			ТаблицаКомиссий.ЗаполнитьЗначения(Справочники.ВидыЗадолженности.ПоТорговойКомиссии, "ВидЗадолженности");
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	РасходыПоСделкеОбороты.СуммаОборот КАК ТорговаяКомиссия,
			|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			&МоментСделки,
			|			&МоментИсполнения,
			|			Период,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Сделка = &Сделка
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделкеОбороты";
			
			Запрос.УстановитьПараметр("МоментСделки", НачалоДня(ЭтотОбъект.Основание.Дата));
			Запрос.УстановитьПараметр("МоментИсполнения", КонецДня(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Основание);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НоваяСтрокаТаблицаКомиссий = ТаблицаКомиссий.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицаКомиссий, ВыборкаДетальныеЗаписи);
				
				НоваяСтрокаТаблицаКомиссий.Валюта = ВалютаТорговойКомиссии;
				НоваяСтрокаТаблицаКомиссий.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии;
				
			КонецЦикла;
			
		ИначеЕсли ЭтоПоставка Тогда
			
			НачислятьКомиссию = Истина;
			ИспользоватьСчет7616 = Ложь;
				
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	РасходыПоСделкеОбороты.СуммаОборот КАК ТорговаяКомиссия,
				|	РасходыПоСделкеОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
				|	РасходыПоСделкеОбороты.Валюта КАК Валюта,
				|	РасходыПоСделкеОбороты.ВидЗадолженности КАК ВидЗадолженности
				|ИЗ
				|	РегистрНакопления.РасходыПоСделке.Обороты(
				|			&МоментСделки,
				|			&МоментИсполнения,
				|			Период,
				|			СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Сделка = &Сделка
				|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК РасходыПоСделкеОбороты";
			
			Запрос.УстановитьПараметр("МоментСделки", НачалоДня(ЭтотОбъект.Основание.Дата));
			Запрос.УстановитьПараметр("МоментИсполнения", КонецДня(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			Запрос.УстановитьПараметр("Сделка", ЭтотОбъект.Основание);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			
			ТаблицаКомиссий = Запрос.Выполнить().Выгрузить();
				
		Иначе
			
			ТаблицаКомиссий = Новый ТаблицаЗначений;
			ТаблицаКомиссий.Колонки.Добавить("ЦеннаяБумага");
			ТаблицаКомиссий.Колонки.Добавить("ТорговаяКомиссия");
			ТаблицаКомиссий.Колонки.Добавить("Валюта");
			ТаблицаКомиссий.Колонки.Добавить("ВидЗадолженности");
			
		КонецЕсли;
		
	Иначе	
		НачислятьКомиссию = Ложь;
		ИспользоватьСчет7616 = Ложь;
		
		ТаблицаКомиссий = Неопределено;
	КонецЕсли;
	
	Если (НачислятьКомиссию Или ОплачиватьКомиссию) И ТаблицаКомиссий <> Неопределено Тогда
		Для Каждого СтрокаТаблицыКомиссий Из ТаблицаКомиссий Цикл
			
			Если СтрокаТаблицыКомиссий.ТорговаяКомиссия = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если НачислятьКомиссию Тогда
				
				ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(СтрокаТаблицыКомиссий.ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
				
				// ТОРГОВАЯ КОМИССИЯ НА 76.16 ИЛИ РАСХОДЫ
				Если ЗначениеЗаполнено(СтрокаТаблицыКомиссий.Валюта) Тогда
					ТорговаяКомиссияВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаТаблицыКомиссий.ТорговаяКомиссия,
						СтрокаТаблицыКомиссий.Валюта,
						ЭтотОбъект.Организация,
						ЭтотОбъект.Дата,
						Отказ);	
				Иначе
					ТорговаяКомиссияВВалютеУчета = СтрокаТаблицыКомиссий.ТорговаяКомиссия;
				КонецЕсли;	
					
				ДанныеАналитики = Новый Структура("Сделка, ВидЗадолженности", ОбъектКомиссииСсылка, Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ТорговаяКомиссияВВалютеУчета, "Поступление услуг", ДанныеАналитики);
				
				// дебет
				Если ИспользоватьСчет7616 Тогда
				
					Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоКомиссии;
					
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
					Проводка.СубконтоДт.Сделка      = Сделка;
					
				ИначеЕсли ВыделятьРасходыПриПродаже Тогда
					
					БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
						ЭтотОбъект,
						Проводка.СчетДт,
						Проводка.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаУслуг,
						СтрокаТаблицыКомиссий.ЦеннаяБумага,
						ОбращаетсяНаОРЦБ);
						
				Иначе
					
					УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Рынок,
						СтрокаТаблицыКомиссий.ЦеннаяБумага);
					
					НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
						ЭтотОбъект.Дата,
						ЭтотОбъект.Организация,
						ЭтотОбъект.СчетДоверительногоУправления,
						УчетныйАктив,
						УчетныйРегистр);		
								
					Если (ВидСделки = Перечисления.ВидыСделок.Покупка И Не НастройкиПоВидуУчета.ВключатьРасходыПоПокупкеВСтоимость) Или (ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы) Тогда
						АналитикаПроводки = АналитикаУслуг;
					Иначе	
						АналитикаПроводки = НастройкиУчетаАктива.АналитикаДоходовОтРеализации;	
					КонецЕсли;
						
					БухгалтерскийУчет.ЗаполнитьАналитикуРасходов(
						ЭтотОбъект,
						Проводка.СчетДт,
						Проводка.СубконтоДт,
						ПланыСчетов.Основной.ПрочиеРасходы,
						АналитикаПроводки,
						СтрокаТаблицыКомиссий.ЦеннаяБумага,
						ОбращаетсяНаОРЦБ);
						
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = СчетУчетаКомиссии;
				
				Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
					Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
				КонецЕсли;
				
				Если ЕстьСубконтоСделкиПоКомиссии Тогда
					Проводка.СубконтоКт.Сделка = ОбъектКомиссииСсылка;
				КонецЕсли;
				
				Если ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ОплачиватьКомиссию Тогда
			
				// торговую комиссию Деньги -> Комисия 
				// а на расходы комиссию спишет исполнение
				
				Если ЗначениеЗаполнено(СтрокаТаблицыКомиссий.Валюта) Тогда
					ТорговаяКомиссияВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
						СтрокаТаблицыКомиссий.ТорговаяКомиссия,
						СтрокаТаблицыКомиссий.Валюта,
						ЭтотОбъект.Организация,
						ЭтотОбъект.Дата,
						Отказ);	
				Иначе
					ТорговаяКомиссияВВалютеУчета = СтрокаТаблицыКомиссий.ТорговаяКомиссия;		
				КонецЕсли;		
					
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], ТорговаяКомиссияВВалютеУчета, "Списание торговой комиссии");
				
				// дебет
				Проводка.СчетДт = СчетУчетаКомиссии;
				
				Если ЕстьСубконтоКонтрагентыПоКомиссии Тогда
					Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
				КонецЕсли;
				
				Если ЕстьСубконтоСделкиПоКомиссии Тогда
					Проводка.СубконтоДт.Сделка = Сделка;
				КонецЕсли;
				
				Если ЕстьСубконтоДоговорБрокерскогоОбслуживанияПоКомиссии Тогда
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = СчетУчетаДСДляКомиссии;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено Тогда
					Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено Тогда
					Проводка.СубконтоКт.БрокерскиеКомпании              = Брокер;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено Тогда
					Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = СубконтоДоговорыБрокерскогоОбслуживания;
				КонецЕсли;
				
				Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда
					Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
						ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
					ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
						ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
					КонецЕсли;	
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств              = ВидДвиженияДенежныхСредств;
				КонецЕсли;			
							
				Если СчетУчетаДСДляКомиссии.Валютный Тогда
					Проводка.ВалютнаяСуммаКт = СтрокаТаблицыКомиссий.ТорговаяКомиссия;
					Проводка.ВалютаКт = СтрокаТаблицыКомиссий.Валюта;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
#КонецОбласти	
	
	Запрос = Новый Запрос;
	Если ЕстьМенеджерВременныхТаблицДвиженияПартийЗаПериод Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДвиженияПартий") <> Неопределено Тогда 
			
			ТекущиеВременныеТаблицы = Новый Массив;
			ТекущиеВременныеТаблицы.Добавить("_ДвиженияПартийЗаПериод");
			
			СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ТекущиеВременныеТаблицы);	
	
		КонецЕсли;	
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДвиженияПартийЗаПериод.СтрокаКорзиныЦенныхБумаг КАК СтрокаКорзиныЦенныхБумаг,
			|	_ДвиженияПартийЗаПериод.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ДвиженияПартийЗаПериод.ВидДвижения КАК ВидДвижения,
			|	_ДвиженияПартийЗаПериод.Количество КАК Количество,
			|	_ДвиженияПартийЗаПериод.Стоимость КАК Стоимость,
			|	_ДвиженияПартийЗаПериод.РасходыПриПокупкеВСтоимости КАК РасходыПриПокупкеВСтоимости,
			|	_ДвиженияПартийЗаПериод.СтоимостьКупона КАК СтоимостьКупона,
			|	_ДвиженияПартийЗаПериод.Переоценка КАК Переоценка,
			|	_ДвиженияПартийЗаПериод.ПереоценкаКупона КАК ПереоценкаКупона,
			|	_ДвиженияПартийЗаПериод.СуммаЧастичногоПогашения КАК СуммаЧастичногоПогашения,
			|	_ДвиженияПартийЗаПериод.Перекурсовка КАК Перекурсовка,
			|	_ДвиженияПартийЗаПериод.ДвижениеИндексацииНоминала КАК ДвижениеИндексацииНоминала,
			|	_ДвиженияПартийЗаПериод.Дооценка КАК Дооценка,
			|	_ДвиженияПартийЗаПериод.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
			|	_ДвиженияПартийЗаПериод.РасходыПриПокупкеВСтоимостиВВалютеУчета КАК РасходыПриПокупкеВСтоимостиВВалютеУчета,
