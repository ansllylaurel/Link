Процедура СформироватьПроводки(Документ, Отказ) Экспорт
	Перем ВидыУчетаДляПроведения;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// виды учета должны быть либо заданы явно, либо установлен параметр сеанса "ФормированиеДвиженийПоРегистрамБухгалтерии"
	Если Не Документ.ДополнительныеСвойства.Свойство("ВидыУчетаДляПроведения", ВидыУчетаДляПроведения) Тогда
		ВидыУчетаДляПроведения = Новый Массив;
		Если ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБухгалтерии") Тогда
			Для каждого ВидУчета Из Перечисления.ВидыУчета Цикл
				ВидыУчетаДляПроведения.Добавить(ВидУчета);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидыУчетаДляПроведения.Количество() = 0 Тогда
		Если Не ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен режим формирования движений при проведении документа '" + Документ + "'", Документ,,, Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
		
	// исключим те виды учета, по которым нет настроек
	Для Инд = -ВидыУчетаДляПроведения.ВГраница() По 0 Цикл
		Если Не РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(Документ.Дата, Документ.Организация, Документ.СчетДоверительногоУправления, ВидыУчетаДляПроведения[-Инд]) Тогда
			ВидыУчетаДляПроведения.Удалить(-Инд);
		КонецЕсли;
	КонецЦикла;
	
	// формирование проводок
	Для каждого ВидУчета Из ВидыУчетаДляПроведения Цикл
		
		Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			Документ.ПроведениеПоРегиструЕПС("ЕдиныйБухгалтерскийУчет", Отказ);
		Иначе
			Документ.ПроведениеПоРегиструБухгалтерии(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета), Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры // СформироватьПроводки

Процедура СформироватьДвиженияПоРегистрамБэкОфиса(Документ, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБэкОфиса") Тогда
		Документ.ПроведениеПоРегистрамБэкОфиса(Отказ);
	Иначе
		Если Не ОбщегоНазначения.ЗначениеПараметраСеанса("ФормированиеДвиженийПоРегистрамБухгалтерии") И Не Документ.ДополнительныеСвойства.Свойство("ВидыУчетаДляПроведения") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен режим формирования движений при проведении документа '" + Документ + "'", Документ,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // СформироватьДвиженияПоРегистрамБэкОфиса

// Заполняет ответственного за регистрацию документа в соответствии с регистром ОтветственныеЗаОперации 
// Если это новый документ, проверяет текущего пользователя, может ли он быть ответственным за регистрацию операции,
// иначе - проверяет ранее установленного ответственного.		
//
// Параметры:
//   Документ - ДокументОбъект - Документ, у которого нужно заполнить реквизит "Ответственный"  
//   Отказ - Булево - Признак отказа от записи
//
Процедура УстановитьОтветственного(Документ, Отказ) Экспорт
	
	// Только для организаций, для которых требуется контроль ответственных за операции
	КонтрольОтветственныхЗаОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Организация, "КонтрольОтветственныхЗаОперации");
	Если Не КонтрольОтветственныхЗаОперации Тогда
		Возврат;
	КонецЕсли;
	
	ИмяДокумента			= ПолучитьИмя(Документ);
	ТекущийОтветственный	= ?(Документ.ЭтоНовый(), РаботаСПользователями.ТекущийПользователь(), Документ.Ответственный);
	
	Если РаботаСМетаданнымиПовтИсп.ЕстьРеквизитШапкиДокумента(ИмяДокумента, "ЦельРасчета") Тогда
		ЦельРасчета = Документ.ЦельРасчета;
	КонецЕсли;
	
	Если ИмяДокумента = "КорректировкаРегистров" Тогда
		// Для корректировок регистров определяем ответственного
		// только при изменении бек-офисных регистров
		ТребуетсяОпределениеОтветственного = Ложь;
		
		РегистрыБэкОфиса = РаботаСМетаданнымиПовтИсп.ПолучитьСписокРегистровБэкОфиса();
		Для Каждого СтрокаРегистра Из Документ.ТаблицаРегистров Цикл
			Если РегистрыБэкОфиса[СтрокаРегистра.Имя] <> Неопределено Тогда
				ТребуетсяОпределениеОтветственного = Истина;
				Прервать;
			КонецЕсли;			
		КонецЦикла;
	Иначе
		ТребуетсяОпределениеОтветственного = Истина;
	КонецЕсли;
	
	Если ТребуетсяОпределениеОтветственного Тогда
		Ответственный = РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(Документ.Организация, ИмяДокумента, ЦельРасчета, Документ.Дата, ТекущийОтветственный);
	Иначе
		Ответственный = ТекущийОтветственный;
	КонецЕсли;	
	
	// Ответственного не удалось определить, но он должен был быть
	Если Ответственный = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить ответственного за регистрацию документов вида """ + ИмяДокумента + """ в " + Строка(Документ.Организация), Документ, , , Отказ);
		Возврат;	
	КонецЕсли;
	
	Документ.Ответственный = Ответственный;
	
КонецПроцедуры

Функция СделкаЧерезБрокера(Документ) Экспорт
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.Сделка") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Сделка")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СделкаРЕПО") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СделкаРЕПО")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СделкаСВалютой") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		
		ЭтоСсылкаНаДокумент = СтрНачинаетсяС(XMLТипЗнч(Документ).ИмяТипа, "DocumentRef");
	
		Брокер = ?(ЭтоСсылкаНаДокумент, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Брокер"), Документ.Брокер);
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ИзменениеУсловийСделки")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
		
		Брокер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Основание, "Брокер");
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.ОтменаСделки") Тогда	
		
		Брокер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Сделка, "Брокер");

	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ИзменениеУсловийСделки")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")	
		ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ОтменаСделки") Тогда	
		
		Запрос = Новый Запрос("
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Документ.Основание.Брокер КАК Брокер
			|ИЗ
			|	Документ.ИзменениеУсловийСделки КАК Документ
			|ГДЕ
			|	Документ.Ссылка = &Ссылка
			|");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИзменениеУсловийСделки", РаботаСДокументами.ПолучитьИмя(Документ));
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.ОтменаСделки") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".Основание.", ".Сделка.");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ссылка", Документ);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Брокер = РезультатЗапроса.Выгрузить()[0].Брокер;
		
	Иначе
		
		Возврат Ложь;

	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Брокер);

Конецфункции

#Область Подтверждение_операций_внутреннего_учета

Процедура ЗаполнитьПодтверждениеОперации(Форма, ОсновнойРеквизит) Экспорт
	
	// Только подтверждаемые операции
	Если Не Метаданные.ОпределяемыеТипы.ПодтверждаемыеОперацииБэкОфиса.Тип.СодержитТип(ТипЗнч(ОсновнойРеквизит)) Тогда
		Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(ОсновнойРеквизит) = Тип("ДокументСсылка.РегистрацияСтоимостиАктивов") 
			И ОсновнойРеквизит.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		Или ТипЗнч(ОсновнойРеквизит) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") 
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнойРеквизит, "СпособПередачи") = Перечисления.СпособыПередачиПоручений.ВнутренняяСистема Тогда
			
		КнопкаПодтвердитьОперацию = Форма.Элементы.Найти("ФормаРегистрСведенийПодтверждениеОперацийБэкОфисаПодтвердитьОперацию");	
		
		Если КнопкаПодтвердитьОперацию <> Неопределено Тогда
			КнопкаПодтвердитьОперацию.Видимость = Ложь;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли; 
	
	ЭлементГруппаСостояниеДокумента	= Форма.Элементы.Найти("ГруппаСостояниеДокумента");
	Если ЭлементГруппаСостояниеДокумента = Неопределено Тогда
		ЭлементГруппаСостояниеДокумента = Форма.Элементы.Вставить("ГруппаСостояниеДокумента", Тип("ГруппаФормы"), , Форма.ПодчиненныеЭлементы[0]);
		ЭлементГруппаСостояниеДокумента.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ЭлементГруппаСостояниеДокумента.ОтображатьЗаголовок = Ложь;
	КонецЕсли;
	ЭлементГруппаСостояниеДокумента.Видимость = Истина;	
	
	ОперацияПодтверждена			= Ложь;
	ТребуетсяПодтверждениеОперации	= Ложь; 
	
	Если ЗначениеЗаполнено(ОсновнойРеквизит) Тогда
		
		// Только для организаций, для которых требуется подтверждение операций
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойРеквизит, Новый Структура("КонтрольПодтвержденийОпераций", "Организация.КонтрольПодтвержденийОпераций"));
		Если РеквизитыОрганизации.КонтрольПодтвержденийОпераций Тогда
			ТребуетсяПодтверждениеОперации = Истина;
		КонецЕсли;
	
		// отображаем состояние подтверждения только для документов после 01.10.2017
		ТребуетсяПодтверждениеОперации = ТребуетсяПодтверждениеОперации И (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнойРеквизит, "Дата") >= '20171001');
		
		Если ТребуетсяПодтверждениеОперации Тогда
			СведенияОПодтвержденииОперации	= Неопределено;
			ОперацияПодтверждена			= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ОперацияПодтверждена(ОсновнойРеквизит, СведенияОПодтвержденииОперации); 
			РасшифровкаЗаписиЖурнала		= "";
			
			Если ОперацияПодтверждена Тогда
				РасшифровкаЗаписиЖурнала	= Строка(СведенияОПодтвержденииОперации.Период) + ", основание: " + СведенияОПодтвержденииОперации.Основание;
				СостояниеДокумента			= Новый ФорматированнаяСтрока("Операция подтверждена " + РасшифровкаЗаписиЖурнала, , WebЦвета.Зеленый);
			Иначе
				СведенияОВнесенииОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПервуюЗаписьЖурналаПодтверждений(ОсновнойРеквизит);
				Если СведенияОВнесенииОперации <> Неопределено Тогда
					РасшифровкаЗаписиЖурнала = ", время внесения " + СведенияОВнесенииОперации.Период + ?(ЗначениеЗаполнено(СведенияОВнесенииОперации.Основание), ", основание: " + СведенияОВнесенииОперации.Основание, "");  	
				КонецЕсли;
				СостояниеДокумента = Новый ФорматированнаяСтрока("Операция не подтверждена" + РасшифровкаЗаписиЖурнала, , WebЦвета.Красный);
			КонецЕсли;
			
			РаботаСДокументамиКлиентСервер.УстановитьСостояниеДокумента(Форма, СостояниеДокумента, "ПодтверждениеОперации");
		КонецЕсли;

	КонецЕсли;
	
	КнопкаПодтвердитьОперацию = Форма.Элементы.Найти("ФормаРегистрСведенийПодтверждениеОперацийБэкОфисаПодтвердитьОперацию");	
	Если КнопкаПодтвердитьОперацию = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.Переместить(КнопкаПодтвердитьОперацию, ЭлементГруппаСостояниеДокумента);
	
	КнопкаПодтвердитьОперацию.Видимость		= ОперацияПодтверждена ИЛИ (ТребуетсяПодтверждениеОперации И ЗначениеЗаполнено(ОсновнойРеквизит));		
	КнопкаПодтвердитьОперацию.Отображение	= ОтображениеКнопки.Текст;
	КнопкаПодтвердитьОперацию.Вид			= ВидКнопкиФормы.Гиперссылка;
	КнопкаПодтвердитьОперацию.Заголовок		= "Подробнее";
	
КонецПроцедуры

Функция ПолучитьКрайниеЗаписиЖурналаПодтверждений(Операция) Экспорт	
	КрайниеЗаписи = Новый Структура("ПерваяЗапись, ПоследняяЗапись");
	
	КрайниеЗаписи.ПерваяЗапись		= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПервуюЗаписьЖурналаПодтверждений(Операция); 
	КрайниеЗаписи.ПоследняяЗапись	= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПоследнююЗаписьЖурналаПодтверждений(Операция); 
	
	Возврат КрайниеЗаписи;
КонецФункции

Функция ПолучитьКлючЗаписиПодтвержденияОперации(Операция, Организация, Период) Экспорт
	Возврат РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьКлючЗаписи(Новый Структура("Операция, Организация, Период", Операция, Организация, Период)); 	
КонецФункции

Функция СледующийРабочийДень(ДеньОперации) Экспорт	
	Возврат Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ДеньОперации) + 1, 1);
КонецФункции

#КонецОбласти

#Область Расшифровка_расчета_стоимости_ЦБ

// Выполняем запрос, заполняя расшифровку расчета
//
// Параметры:
//	РасшифровкаРасчета		- Структура					- расшифровка расчета или расшифровка операции
//	Запрос					- Запрос, РезультатЗапроса	- запрос для выполнения или его результат
//	ИмяОперации				- Строка					- имя добавляемой в расшифровку расчета операции, в которую будут помещены временные таблицы и результат запроса 
//							- Неопределено				- временные таблицы и результат запроса будут размещены на текущем уровне расшифровки расчета
//	ИмяРезультата			- Строка					- имя результата запроса (имеет смысл при ТипРезультатаЗапроса <> Неопределено)
//							- Неопределено				- результат не будет помещен в расшифровку расчета
//	ТипРезультатаЗапроса	- Строка					- тип возвращаемого результата (варианты "Выгрузка", "Выборка", "ВыборкаПоГруппировкам", "ВыгрузкаПоГруппировкам")
//							- Неопределено				- без возвращаемого результата
//	СписокТаблиц			- Строка					- строка разделенных запятыми временных таблиц, включаемых в расшифровку
//							- Неопределено				- все временные таблицы
//	ИсключаемыеТаблицы		- Строка					- строка разделенных запятыми временных таблиц, исключаемых из расшифровки
//							- Неопределено				- без исключения каких-либо временных таблиц
//	ВыводитьВСвернутомВиде	- Булево					- вывод добавляемой операции в свернутом виде (имеет смысл при ИмяОперации <> Неопределено)
//
// Возвращаемое значение:
//	ВыборкаИзРезультатаЗапроса, ТаблицаЗначений, Неопределено - результат запроса в соответствии с параметром ТипРезультатаЗапроса
//
Функция ВыполнитьЗапросСРасшифровкойРезультата(РасшифровкаРасчета, Запрос, ИмяОперации = Неопределено, ИмяРезультата = Неопределено, ТипРезультатаЗапроса = "Выгрузка", СписокТаблиц = Неопределено, ИсключаемыеТаблицы = Неопределено, ВыводитьВСвернутомВиде = Ложь) Экспорт
	
	ТребуетсяРасшифровка = (РасшифровкаРасчета <> Неопределено);
	
	Если ТребуетсяРасшифровка Тогда
		МенеджерВременныхТаблицБылИнициализирован = Истина;	
		Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда 
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			МенеджерВременныхТаблицБылИнициализирован = Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Запрос) = Тип("РезультатЗапроса") Тогда
		РезультатПоследнегоЗапроса = Запрос;	
	Иначе
		РезультатПоследнегоЗапроса = Запрос.Выполнить();
	КонецЕсли;
	
	Если ТипРезультатаЗапроса = "Выгрузка" Тогда
		ВозвращаемыйРезультат = РезультатПоследнегоЗапроса.Выгрузить();
	ИначеЕсли ТипРезультатаЗапроса = "Выборка" Тогда
		ВозвращаемыйРезультат = РезультатПоследнегоЗапроса.Выбрать();
	ИначеЕсли ТипРезультатаЗапроса = "ВыборкаПоГруппировкам" Тогда
		ВозвращаемыйРезультат = РезультатПоследнегоЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ИначеЕсли ТипРезультатаЗапроса = "ВыгрузкаПоГруппировкам" Тогда
		ВозвращаемыйРезультат = РезультатПоследнегоЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе
		ВозвращаемыйРезультат = Неопределено;
	КонецЕсли;
	
	Если ТребуетсяРасшифровка Тогда
		
		#Область Добавление_временных_таблиц_и_результата_запроса_в_расшифровку
		
		Если ИмяОперации = Неопределено Тогда
			РасшифровкаОперации = РасшифровкаРасчета;	
		Иначе
			РасшифровкаОперации = ДобавитьРасшифровкуОперации(РасшифровкаРасчета, ИмяОперации, , , ВыводитьВСвернутомВиде);
		КонецЕсли;
		
		// Если задан список таблиц или исключений, то оставляем в таблице только нужные
		
		Если СписокТаблиц <> Неопределено ИЛИ ИсключаемыеТаблицы <> Неопределено Тогда
			СписокТаблиц		= ?(СписокТаблиц = Неопределено, Неопределено, Новый Структура(СписокТаблиц));
			ИсключаемыеТаблицы	= ?(ИсключаемыеТаблицы = Неопределено, Неопределено, Новый Структура(ИсключаемыеТаблицы));
		КонецЕсли;
		
		// Параметры запроса
		
		Если ВключатьТаблицуВРасшифровку("ПараметрыЗапроса", СписокТаблиц, ИсключаемыеТаблицы) Тогда  	
			ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, "ПараметрыЗапроса", Запрос.Параметры, "Параметры запроса", Истина, Истина);
		КонецЕсли;
			
		// Временные таблицы запроса
		
		Для Каждого ВременнаяТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
			Если ВключатьТаблицуВРасшифровку(ВременнаяТаблица.ПолноеИмя, СписокТаблиц, ИсключаемыеТаблицы) Тогда
				ДобавитьРасшифровкуРезультатаОперации(
					РасшифровкаОперации,
					?(СтрНачинаетсяС(ВременнаяТаблица.ПолноеИмя, "_"), Сред(ВременнаяТаблица.ПолноеИмя, 2), ВременнаяТаблица.ПолноеИмя),
					ВременнаяТаблица.ПолучитьДанные().Выгрузить(), ,
					Ложь);
			КонецЕсли;
		КонецЦикла;
		
		// Полученные результаты запроса
		
		Если ВозвращаемыйРезультат <> Неопределено И ИмяРезультата <> Неопределено Тогда
		
			Если СтрНачинаетсяС(ТипРезультатаЗапроса, "Выборка") Тогда
				
				ТаблицаРезультат = Новый ТаблицаЗначений;
				Для Каждого Колонка Из РезультатПоследнегоЗапроса.Колонки Цикл
					ТаблицаРезультат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);	
				КонецЦикла;
				
				Пока ВозвращаемыйРезультат.Следующий() Цикл
				   ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), ВозвращаемыйРезультат); 
				КонецЦикла;
				ВозвращаемыйРезультат.Сбросить();
				
			Иначе
				
				ТаблицаРезультат = ВозвращаемыйРезультат.Скопировать();	
				
			КонецЕсли;
			
			ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, ИмяРезультата, ТаблицаРезультат, , Ложь);
			
		КонецЕсли;
		
		Если Не МенеджерВременныхТаблицБылИнициализирован Тогда
			Запрос.МенеджерВременныхТаблиц = Неопределено;	
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	Возврат ВозвращаемыйРезультат;

КонецФункции

Функция ВключатьТаблицуВРасшифровку(ИмяТаблицы, СписокТаблиц, ИсключаемыеТаблицы)
	
	Если СписокТаблиц <> Неопределено И Не СписокТаблиц.Свойство(ИмяТаблицы) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Если ИсключаемыеТаблицы <> Неопределено И ИсключаемыеТаблицы.Свойство(ИмяТаблицы) Тогда
		Возврат Ложь;	
	КонецЕсли;			
	
	Возврат Истина;	
	
КонецФункции

// Добавляет расшифровку операции
//
// Параметры:
//   РасшифровкаРасчета - Структура - расшифровка расчета или расшифровка операции 
//   ИмяОперации - Строка, Неопределено - имя новой операции.
//										  Если параметр заполнен, то добавляется новая операция с результатом в расшифровку текущей операции,
//										  иначе результат добавляется в расшифровку текущей операции 
//   ИмяРезультата - Строка, Неопределено - имя результата операции 
//   Результат - Структура, ТаблицаЗначений, Неопределено - результат операции
//   ВыводитьОперациюВСвернутомВиде - Булево - операция будет выведена в отчете в свернутом виде
//   ВыводитьРезультатВСвернутомВиде - Булево - результат операции будет выведен в отчете в свернутом виде
//
Функция ДобавитьРасшифровкуОперации(РасшифровкаРасчета, ИмяОперации = Неопределено, ИмяРезультата = Неопределено, Результат = Неопределено, ВыводитьОперациюВСвернутомВиде = Ложь, ВыводитьРезультатВСвернутомВиде = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ИмяОперации) Тогда
		
		Операция = Новый Структура("Имя, Операции, ВыводитьВСвернутомВиде", ИмяОперации, Новый Массив, ВыводитьОперациюВСвернутомВиде);
		
		РасшифровкаРасчета.Операции.Добавить(Операция);
		
	Иначе
		
		Операция = РасшифровкаРасчета;
		
	КонецЕсли;
	
	// Добавляем результат при необходимости
	
	Если ЗначениеЗаполнено(ИмяРезультата) ИЛИ ЗначениеЗаполнено(Результат) Тогда
	
		ДобавитьРасшифровкуРезультатаОперации(Операция, ИмяРезультата, Результат, , ВыводитьРезультатВСвернутомВиде);
		
	КонецЕсли;		
		
	Возврат Операция;
	
КонецФункции

Функция ДобавитьРасшифровкуРезультатаОперации(РасшифровкаОперации, ИмяРезультата, Результат, ПредставлениеРезультата = Неопределено, ВыводитьВСвернутомВиде = Ложь, ТранспонироватьРезультат = Ложь) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		РезультатТаблица = Новый ТаблицаЗначений;
		Для Каждого ЭлементСтруктуры Из Результат Цикл
			РезультатТаблица.Колонки.Добавить(ЭлементСтруктуры.Ключ);		
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(РезультатТаблица.Добавить(), Результат);
	Иначе
		РезультатТаблица = Результат;
	КонецЕсли;
	
	Если ТранспонироватьРезультат Тогда
		
		#Область Транспонирование_таблицы_значений
		
		ОднаСтрока = (РезультатТаблица.Количество() = 1);
		
		ТранспонированнаяТаблица = Новый ТаблицаЗначений;
		ТранспонированнаяТаблица.Колонки.Добавить("Параметр");
		
		ПерваяКолонка = Истина;
		
		Для Каждого Колонка Из РезультатТаблица.Колонки Цикл
			
			СтрокаТранспонированная = ТранспонированнаяТаблица.Добавить();
			СтрокаТранспонированная.Параметр = ?(ЗначениеЗаполнено(Колонка.Заголовок), Колонка.Заголовок, Колонка.Имя);	
			
			НомерСтроки = 0;
			
			Для Каждого СтрокаТаблицы Из РезультатТаблица Цикл
				
				НомерСтроки = НомерСтроки + 1;
				
				Если ПерваяКолонка Тогда
					КолонкаТранспонированная = ТранспонированнаяТаблица.Колонки.Добавить("Значение" + НомерСтроки, , "Значение" + ?(ОднаСтрока, "", " " + НомерСтроки));
				КонецЕсли;
				
				СтрокаТранспонированная["Значение" + НомерСтроки] = СтрокаТаблицы[Колонка.Имя];
				
			КонецЦикла;			
			
			ПерваяКолонка = Ложь;
			
		КонецЦикла;
		
		РезультатТаблица = ТранспонированнаяТаблица;
		
		#КонецОбласти
		
	КонецЕсли;
	
	РезультатОперации = Новый Структура("Имя, Операции, ВыводитьВСвернутомВиде", ИмяРезультата, РезультатТаблица, ВыводитьВСвернутомВиде);
	Если ПредставлениеРезультата <> Неопределено Тогда
		РезультатОперации.Вставить("Представление", ПредставлениеРезультата);	
	КонецЕсли;
	
	Если ТипЗнч(РасшифровкаОперации.Операции) = Тип("ТаблицаЗначений") Тогда
		КопияОперации				 = РаботаСКоллекциями.СкопироватьСтруктуру(РасшифровкаОперации);
		РасшифровкаОперации.Операции = РаботаСКоллекциями.ЗначениеВМассив(КопияОперации);
	КонецЕсли;

	РасшифровкаОперации.Операции.Добавить(РезультатОперации);
	
	Возврат РезультатОперации;
	
КонецФункции

Процедура УстановитьПараметрыРасшифровкиРезультатаОперации(РасшифровкаРасчета, ИмяРезультата = Неопределено, Параметры) Экспорт
	
	Для Каждого РезультатОперации Из РасшифровкаРасчета.Операции Цикл
			
		Если РезультатОперации.Имя = ИмяРезультата ИЛИ ИмяРезультата = Неопределено Тогда
			РаботаСКоллекциями.ДополнитьСтруктуру(РезультатОперации, Параметры, Истина);	
		КонецЕсли;
		
		Если ТипЗнч(РезультатОперации.Операции) <> Тип("ТаблицаЗначений") Тогда
			УстановитьПараметрыРасшифровкиРезультатаОперации(РезультатОперации, ИмяРезультата, Параметры);	
		КонецЕсли;
			
	КонецЦикла;	
	
КонецПроцедуры

Функция НайтиОперациюРасшифровкиРасчета(РасшифровкаРасчета, ИмяОперации, ВключатьПодчиненные = Ложь) Экспорт
	
	Для Каждого РезультатОперации Из РасшифровкаРасчета.Операции Цикл
		
		Если РезультатОперации.Имя = ИмяОперации Тогда
			
			Возврат РезультатОперации;			
			
		ИначеЕсли ВключатьПодчиненные И ТипЗнч(РезультатОперации.Операции) <> Тип("ТаблицаЗначений") Тогда
			
			Возврат НайтиОперациюРасшифровкиРасчета(РезультатОперации, ИмяОперации, ВключатьПодчиненные);	
			
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Формирует расшифровку расчета справедливой стоимости ценной бумаги по методике клиента 
//
// Параметры:
//	Отчет					- ТабличныйДокумент										- выходной параметр, возвращает отчет с расшифровкой
//	ПараметрыПереоценки		- ДокументОбъект.РегистрацияСтоимостиПереоценки			- документ
//							- Структура												- в структуре передавать значения реквизитов документа РегистрацияСтоимостиПереоценки 
//	ЦеннаяБумага			- ОпределяемыйТип.ЦенныеБумаги							- 
//	ВариантРасчета			- СправочникСсылка.ВариантыРасчетаОценочнойСтоимости	- методика расчета справедливой стоимости
//	АдресТаблицыСтоимостей	- Строка, ТаблицаЗначений								- см. параметр
//	Ошибки					- Массив												- выходной параметр, возвращает массив ошибок, возникших при расшифровке
//
// Возвращаемое значение:
//	Булево - Истина, если удалось выполнить расшифровку, Ложь - в противном случае
//
Функция СформироватьРасшифровкуРасчетаСтоимостиЦеннойБумаги(Отчет, ПараметрыПереоценки, ЦеннаяБумага, ВариантРасчета, Знач АдресТаблицыСтоимостей = Неопределено, Ошибки = Неопределено) Экспорт
	
	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Массив;
	КонецЕсли;
	
	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	ЦеннаяБумага);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина); // временное решение, т.к. если у пользователя нет права на создание документа, то и расшифровка не сформируется
	
	РегистрацияСтоимостиПереоценки = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(РегистрацияСтоимостиПереоценки, ПараметрыПереоценки);

	ОценкаПрочихЦенныхБумаг = Ложь;
	ПараметрыПереоценки.Свойство("ОценкаПрочихЦенныхБумаг", ОценкаПрочихЦенныхБумаг);
	
	ОценкаПрочихЦенныхБумаг = ?(ОценкаПрочихЦенныхБумаг = Неопределено, Ложь, ОценкаПрочихЦенныхБумаг);
	
	РегистрацияСтоимостиПереоценки.ЗаполнитьСтоимостьПереоценки(Ложь, Ложь, Ложь, АдресТаблицыСтоимостей, Ложь, РасшифровкаРасчета,, ОценкаПрочихЦенныхБумаг);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РасшифровкаРасчета.Операции.Количество() = 0 Тогда
		Возврат Ложь;		
	КонецЕсли;	
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Вариант расчета справедливой стоимости: " + ВариантРасчета,,, Отчет);
	ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
	
	СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьРасшифровкуОперации(Операция, ПараметрыВывода) Экспорт
	
	ВыводитьВСвернутомВиде = Операция.Свойство("ВыводитьВСвернутомВиде") И Операция.ВыводитьВСвернутомВиде;
	
	Если Операция.Свойство("Имя") Тогда
		ПараметрыВывода.ЗаголовокТаблицы.Параметры.Поле = ?(Операция.Свойство("Представление"), Операция.Представление, Операция.Имя);			
		ПараметрыВывода.ДокументРезультат.Вывести(ПараметрыВывода.ЗаголовокТаблицы);
		ПараметрыВывода.ДокументРезультат.НачатьГруппуСтрок(, Не ВыводитьВСвернутомВиде);
		ПараметрыВывода.ДокументРезультат.Вывести(ПараметрыВывода.РазделительТаблиц);
	КонецЕсли;
	
	// Результаты операции
	
	Для Каждого РезультатОперации Из Операция.Операции Цикл
		
		Если ТипЗнч(РезультатОперации.Операции) = Тип("ТаблицаЗначений") Тогда
			
			ТаблицаЗначений = РезультатОперации.Операции;
			Если ТаблицаЗначений.Колонки.Найти("Период") <> Неопределено Тогда
				ТаблицаЗначений.Сортировать("Период");	
			КонецЕсли;
			
			РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
				ПараметрыВывода,
				ТаблицаЗначений,
				Неопределено,
				?(РезультатОперации.Свойство("Представление"), РезультатОперации.Представление, РезультатОперации.Имя),
				РезультатОперации.ВыводитьВСвернутомВиде,
				Истина);
			
		Иначе
			
			СформироватьРасшифровкуОперации(РезультатОперации, ПараметрыВывода);	
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если Операция.Свойство("Имя") Тогда
		ПараметрыВывода.ДокументРезультат.ЗакончитьГруппуСтрок();
		ПараметрыВывода.ДокументРезультат.Вывести(ПараметрыВывода.РазделительТаблиц);
	КонецЕсли;	
	
КонецФункции

