
Функция ТребуетсяДетализацияПоРасчетномуСчету(ДанныеДокумента, ИмяРеквизитаСБрокером = "Брокер") Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеДокумента[ИмяРеквизитаСБрокером]) Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаБэкОфисаСрезПоследних.ДетализацияПоРасчетномуСчету
		|ИЗ
		|	РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",      ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("Брокер",      ДанныеДокумента[ИмяРеквизитаСБрокером]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДетализацияПоРасчетномуСчету;
	Иначе
		Возврат Истина; // по-умолчанию требуется детализация
	КонецЕсли;
	
КонецФункции // ТребуетсяДетализацияПоРасчетномуСчету

Функция ПолучитьНастройкиОтраженияКомиссий(ДанныеДокумента, ИмяРеквизитаСБрокером = "Брокер") Экспорт
	
	Результат = Новый Структура("СписаниеТорговойКомиссииПриИсполнении, СписаниеКомиссииБрокераПриИсполнении", Ложь, Ложь);
	Если Не ЗначениеЗаполнено(ДанныеДокумента[ИмяРеквизитаСБрокером]) Тогда
		Возврат Результат;
	КонецЕсли; 
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаБэкОфисаСрезПоследних.СписаниеТорговойКомиссииПриИсполненииОтложеннойСделки КАК СписаниеТорговойКомиссииПриИсполнении,
		|	НастройкиУчетаБэкОфисаСрезПоследних.СписаниеКомиссииБрокераПриИсполненииОтложеннойСделки КАК СписаниеКомиссииБрокераПриИсполнении
		|ИЗ
		|	РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",      ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("Брокер",      ДанныеДокумента[ИмяРеквизитаСБрокером]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции // ПолучитьНастройкиОтраженияКомиссий

Функция ОтложенноеИсполнениеСделки(Сделка) Экспорт
	
	Возврат ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка") и Сделка.ОтложенноеИсполнение;
	
КонецФункции

Функция ОтложенноеОтражениеКомиссий(НастройкиОтраженияКомиссий, Сделка, ВидЗадолженности) Экспорт
	
	Если ОтложенноеИсполнениеСделки(Сделка) Тогда
	
			Возврат ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии
				 	И НастройкиОтраженияКомиссий.СписаниеКомиссииБрокераПриИсполнении
				 или
				 	ВидЗадолженности = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
				 	И НастройкиОтраженияКомиссий.СписаниеТорговойКомиссииПриИсполнении;
				
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции // ОтложенноеОтражениеКомиссий

Процедура ПроверитьЗаполнениеРасчетногоСчета(ДанныеДокумента, Отказ = Неопределено) Экспорт
	
	РасчетныйСчетЗаполнен = ЗначениеЗаполнено(ДанныеДокумента.РасчетныйСчет);
	
	Если РасчетныйСчетЗаполнен <> ТребуетсяДетализацияПоРасчетномуСчету(ДанныеДокумента) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(РасчетныйСчетЗаполнен, "Заполнение р/счета не требуется.", "Требуется заполнение р/счета."),
			ДанныеДокумента, "РасчетныйСчет",, Отказ);
	КонецЕсли;
		
	Если Не Отказ И РасчетныйСчетЗаполнен Тогда
		
		Если ТипЗнч(ДанныеДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
			ИмяРеквизита = "ВалютаСделки";
		Иначе
			ИмяРеквизита = "ВалютаОплаты";
		КонецЕсли;
		
		Если ДанныеДокумента.РасчетныйСчет.Валюта <> ДанныеДокумента[ИмяРеквизита] Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта оплаты (" + ДанныеДокумента[ИмяРеквизита] + ") не соответствует валюте расчетного счета (" + ДанныеДокумента.РасчетныйСчет.Валюта + ").",
				ДанныеДокумента, ИмяРеквизита,, Отказ);
		КонецЕсли;
			
		Если ТипЗнч(ДанныеДокумента) = Тип("ДокументОбъект.СделкаРЕПО") И ДанныеДокумента.ЧастьСделкиРЕПО < 2
			И ДанныеДокумента.РасчетныйСчет.Валюта <> ДанныеДокумента.ВалютаОплатыВторойЧасти Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта оплаты второй части (" + ДанныеДокумента.ВалютаОплатыВторойЧасти + ") не соответствует валюте расчетного счета (" + ДанныеДокумента.РасчетныйСчет.Валюта + ").",
				ДанныеДокумента, "ВалютаОплатыВторойЧасти",, Отказ);
				
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьРынокЦенныхБумаг(ДанныеДокумента, Отказ) Экспорт
	
	ТипДокумента = ТипЗнч(ДанныеДокумента.Ссылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ВводЦенныхБумаг") Или ТипДокумента = Тип("ДокументСсылка.ВыводЦенныхБумаг")
		Или ТипДокумента = Тип("ДокументСсылка.ПереводЦенныхБумаг") Или ТипДокумента = Тип("ДокументСсылка.СделкаРЕПО")
		Или ТипДокумента = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Или ТипДокумента = Тип("ДокументСсылка.ПоставкаЦенныхБумаг")
	Тогда
	
		Если ДанныеДокумента.Рынок = Перечисления.РынкиЦенныхБумаг.Закладные Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На текущий момент допускается только покупка закладных", ДанныеДокумента, "Рынок",, Отказ);
			Возврат Ложь;
		КонецЕсли;
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.Сделка") Тогда
	
		Если ДанныеДокумента.Рынок = Перечисления.РынкиЦенныхБумаг.Закладные
			И ДанныеДокумента.ВидСделки = Перечисления.ВидыСделок.Продажа
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На текущий момент допускается только покупка закладных", ДанныеДокумента, "Рынок",, Отказ);
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьМинимальнуюСуммуЗачисленияПИФ(ПаевойИнвестиционныйФонд, Период = Неопределено) Экспорт
	
	МинимальныеСуммыЗачисления = РегистрыСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(
		?(Период = Неопределено, ТекущаяДатаСеанса(), Период),
		Новый Структура("ПаевойИнвестиционныйФонд", ПаевойИнвестиционныйФонд));
		
	Возврат ?(МинимальныеСуммыЗачисления.Количество() > 0, МинимальныеСуммыЗачисления[0].МинимальнаяСуммаЗачисления, Неопределено);
	
КонецФункции // КлиентДоверительногоУправления

Функция ПроверитьУникальностьНомераСделки(ДанныеДокумента, Отказ = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеДокумента.НомерСделки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сделка.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	НЕ Сделка.ПометкаУдаления
		|	И Сделка.Организация = &Организация
		|	И Сделка.ВидСделки = &ВидСделки
		|	И Сделка.НомерСделки = &НомерСделки
		|	И Сделка.Ссылка <> &Ссылка";
	
	Если ТипЗнч(ДанныеДокумента) = Тип("ДокументОбъект.СделкаРЕПО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка", "СделкаРЕПО");
	ИначеЕсли ТипЗнч(ДанныеДокумента) = Тип("ДокументОбъект.СделкаСВалютой") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка", "СделкаСВалютой");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидСделки",   ДанныеДокумента.ВидСделки);
	Запрос.УстановитьПараметр("НомерСделки", ДанныеДокумента.НомерСделки);
	Запрос.УстановитьПараметр("Ссылка",      ДанныеДокумента.Ссылка);
	
	// группировка по организации также нужна, т.к. одна сделка может быть
	// отражена и у УК, и у СпецДепа
	Запрос.УстановитьПараметр("Организация", ДанныеДокумента.Организация);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер сделки '" + ДанныеДокумента.НомерСделки + "' не уникален", ДанныеДокумента, "НомерСделки",, Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

