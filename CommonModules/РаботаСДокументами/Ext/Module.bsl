// Контролирует, что вывод активов контрагенту-физ. лицу производится либо физ. лицу-выгодоприобретателю, либо самому клиенту
// 
// 	Параметры:
//		- ДокументОбъект - поручение на вывод или сам вывод активов
//
Функция РазрешенВыводАктивовКонтрагенту(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.Дата < ДатаНачалаПроверкиВыгодоприобретателяПриВыводеАктивов() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(ДокументОбъект);
	Если Не (((ТипДокумента = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств") 
						Или ТипДокумента = Тип("ДокументОбъект.ПоручениеНаДвижениеЦенныхБумаг")) 
						И ДокументОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская)			
			Или ТипДокумента = Тип("ДокументОбъект.ВыводДенежныхСредств")
			Или ТипДокумента = Тип("ДокументОбъект.ВыводЦенныхБумаг")) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументОбъект.СчетДоверительногоУправления, ДокументОбъект.Дата);
	
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ВидЮрФизЛица") = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо 		
		И ЗначениеЗаполнено(ДокументОбъект.Контрагент) 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Контрагент, "ВидЮрФизЛица") = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо
		И Клиент <> ДокументОбъект.Контрагент Тогда
		
		Возврат РаботаСНормативноСправочнойИнформацией.КонтрагентЯвляетсяВыгодоприобретателемКлиентаФизическогоЛица(ДокументОбъект.Организация, 
																													Клиент, 
																													ДокументОбъект.Контрагент, 
																													ДокументОбъект.Дата);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

//Осуществляется проверка дат исполнения поручений с реальной датой подчиненных документов (вводов/выводов)
Процедура ПроверитьДатуИсполненияПоручения(Объект, Отказ) Экспорт
	
	Если Объект.Дата < ДатаНачалаПроверкиСоответствияДатыИсполнения() Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(Объект.Ссылка);
	ОснованиеСтр = "";

	Если ТипДокумента = Тип("ДокументСсылка.ВводДенежныхСредств") 
		Или ТипДокумента = Тип("ДокументСсылка.ВыводДенежныхСредств") 
		Или ТипДокумента = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		
		ОснованиеСтр = "Основание";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВводЦенныхБумаг") Или ТипДокумента = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
     	ОснованиеСтр = "Поручение";
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ОснованиеСтр) Тогда
		Возврат;
	КонецЕсли;
	
	ПоручениеСсылка = Объект[ОснованиеСтр];
	
	Если ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		
		РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоручениеСсылка, "Дата, ДатаИсполненияС, ДатаИсполненияПо");
		
	ИначеЕсли ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг") Тогда
		
		РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоручениеСсылка, "Дата, ДатаИсполненияПо");
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
		
	Если РеквизитыПоручения.Дата >= ДатаНачалаПроверкиЗаполненияДатыИсполненияПоручения(ПоручениеСсылка) Тогда
		
		Если ТипДокумента = Тип("ДокументСсылка.ВводДенежныхСредств") Или ТипДокумента = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
			
			Если ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") И Объект.Дата < РеквизитыПоручения.ДатаИсполненияС Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа меньше даты исполнения [" + Формат(РеквизитыПоручения.ДатаИсполненияС, "ДФ=dd.MM.yyyy") + "] документа основания", Объект, "Дата",, Отказ);
				Возврат;	
			КонецЕсли;
				
			Если НачалоДня(Объект.Дата) > РеквизитыПоручения.ДатаИсполненияПо Тогда
				
				// Бывают исключительные ситуации, когда документы ввода/вывода проводятся после крайнего срока исполнения поручения
				// Для таких документов указывается доп. сведение
				
				Запрос = Новый Запрос(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗначенияДополнительныхСведений.Значение КАК Значение
					|ИЗ
					|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
					|ГДЕ
					|	ЗначенияДополнительныхСведений.Объект = &Объект
					|	И ЗначенияДополнительныхСведений.Свойство.Ключ = ""РазрешитьПроведениеПослеКрайнейДатыИсполненияПоручения"""); 
				
				Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				РазрешеноПроведениеПослеДатыИсполненияПоручения = Ложь;
				Если Выборка.Следующий() Тогда
					РазрешеноПроведениеПослеДатыИсполненияПоручения = Выборка.Значение;	
				КонецЕсли;
				
				Если Не РазрешеноПроведениеПослеДатыИсполненияПоручения Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа больше даты исполнения [" + Формат(РеквизитыПоручения.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") + "] документа основания", Объект, "Дата",, Отказ);					
				КонецЕсли;
				
			КонецЕсли;		
				
		ИначеЕсли ТипДокумента = Тип("ЗадачаСсылка.ЗадачаИсполнителя") И ЗначениеЗаполнено(Объект.ДатаВыполнения) Тогда
			
			Если Объект.ТочкаМаршрута = БизнесПроцессы.СогласованиеПорученийНаВыводАктивов.ТочкиМаршрута.СогласованиеОтделомСопровожденияОпераций Тогда
				
				Если НачалоДня(Объект.ДатаВыполнения) < РеквизитыПоручения.ДатаИсполненияС
					Или НачалоДня(Объект.ДатаВыполнения) > РеквизитыПоручения.ДатаИсполненияПо Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата согласования [" + Формат(НачалоДня(Объект.ДатаВыполнения), "ДФ=dd.MM.yyyy") + "] задачи [" + Объект.Наименование + "] должна соответствовать периоду исполнения поручения [" + Формат(РеквизитыПоручения.ДатаИсполненияС, "ДФ=dd.MM.yyyy") + "-" + Формат(РеквизитыПоручения.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") + "]. ",,,, Отказ)
				КонецЕсли;
			
			ИначеЕсли НачалоДня(Объект.ДатаВыполнения) > РеквизитыПоручения.ДатаИсполненияПо Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата согласования [" + Формат(НачалоДня(Объект.ДатаВыполнения), "ДФ=dd.MM.yyyy") + "] задачи [" + Объект.Наименование + "] не может быть позже крайней даты исполнения поручения [" + Формат(РеквизитыПоручения.ДатаИсполненияПо, "ДФ=dd.MM.yyyy") + "]. ",,,, Отказ);
            КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
					
КонецПроцедуры

// Возвращает список выводов ценных бумаг по доступным организациям. Используется для заполнения
// табличных частей других документов данными из табличной части вывода
//
//	Параметры:
//		- Дата 						- конечная дата поиска документов вывода
// 		- ПривилегированныйРежим 	- Булево - использование привилигированного режима
//		- ТолькоКоличество 			- Булево - список требуется только для заполнения ЦБ и количества, без суммовых показателей
//
Функция СписокВыводовЦенныхБумагПоПрочимОрганизациям(Дата, ПривилегированныйРежим = Ложь, ТолькоКоличество = Ложь) Экспорт
	
	Если ПривилегированныйРежим Тогда
	
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Пользователи.Организация КАК Организация
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ
			|	И Пользователи.Организация <> &Организация";
		
		Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь").ИдентификаторПользователяИБ);
		Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"));
		
		ПрочиеОрганизацииПользователя = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
		
		Если ПрочиеОрганизацииПользователя.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Прочие организации недоступны");
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	СписокДокументов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыводЦенныхБумаг.Ссылка КАК Ссылка,
		|	ВыводЦенныхБумаг.Номер КАК Номер,
		|	ВыводЦенныхБумаг.Дата КАК Дата,
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВыводЦенныхБумаг.Рынок КАК Рынок
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
		|ГДЕ
		|	ВыводЦенныхБумаг.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И &УсловиеНаДокумент";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаДокумент", ?(ТолькоКоличество, "НЕ ВыводЦенныхБумаг.ПометкаУдаления", "ВыводЦенныхБумаг.Проведен"));
	
	Если ПривилегированныйРежим Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РАЗРЕШЕННЫЕ", "") + "
		|	И ВыводЦенныхБумаг.Организация В(&Организации)";
		
		Запрос.УстановитьПараметр("Организации", ПрочиеОрганизацииПользователя);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачальнаяДата", ДобавитьМесяц(Дата, -1));
	Запрос.УстановитьПараметр("КонечнаяДата", КонецДня(Дата));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СписокДокументов.Добавить(ВыборкаДетальныеЗаписи.Ссылка, 
			СтрШаблон("№ %1 от %2 %3 (%4)", 
					ВыборкаДетальныеЗаписи.Номер, 
					ВыборкаДетальныеЗаписи.Дата, 
					ВыборкаДетальныеЗаписи.СчетДоверительногоУправления,
					ВыборкаДетальныеЗаписи.Рынок));
		
	КонецЦикла;
	
	Если ПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат СписокДокументов;
	
КонецФункции

// Заполняет табличную часть ЦенныеБумаги (ЦБ и количество) документа из переданного вывода ценных бумаг
//
// Параметры:
//	ДокументОбъект 			- ДокументОбъект					- заполняемый документ с ТЧ ЦенныеБумаги
//	ВыводЦенныхБумаг 		- ДокументСсылка.ВыводЦенныхБумаг	- вывод ц/б
//	ПривилегированныйРежим 	- Булево							- использование привилегированного режима 
//
Процедура ЗаполнитьЦенныеБумагиИКоличествоИзВыводаЦенныхБумаг(ДокументОбъект, ВыводЦенныхБумаг, ПривилегированныйРежим = Ложь) Экспорт
	
	Если ПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	//При заполнении только ценных бумаг и количества ценные бумаги сворачиваем  	
	Запрос = Новый Запрос( 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВыводЦенныхБумагЦенныеБумаги.Количество) КАК Количество
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВыводЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага");
		
	Запрос.УстановитьПараметр("Ссылка", ВыводЦенныхБумаг);	
	
	ДокументОбъект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если ПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает дату, с которой проверяется реквизит ДатаИВремяПолучения в поручениях на движение активов
Функция ДатаНачалаПроверкиДатыИВремениПолученияДляПорученийНаДвижениеАктивов() Экспорт
	
	Возврат '20221228';

КонецФункции		 

#КонецОбласти

#Область Формирование_платежных_поручений

// Выгрузка платежных поручений в клиент банк включается по очереди для каждой организации
Функция ИспользуетсяВыгрузкаПлатежныхПорученийВКлиентБанк(Организация, Дата) Экспорт
	
	// Организации включаем по очереди в разные даты
	Возврат Дата >= '20241213' И Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст")     		
		Или Дата >= '20241219' И Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")
		Или Дата >= '20250116' И Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") 
		Или Дата >= '20250820' И Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ");
					
КонецФункции
	
// Проверяет использование реквизита РасчетныйСчетКонтрагента в документе НачислениеЗадолженности
Функция ОбязательноЗаполнениеРасчетногоСчетаКонтрагентаВНачисленииЗадолженности(ДокументОбъект) Экспорт
	
	// Если в документе дата не заполнена, считаем, что это текущая дата	
	ДатаПроверки = ?(ДокументОбъект.Дата = '00010101', ТекущаяДатаСеанса(), ДокументОбъект.Дата);
	
	Возврат ИспользуетсяВыгрузкаПлатежныхПорученийВКлиентБанк(ДокументОбъект.Организация, ДатаПроверки)
	    И ДокументОбъект.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок
		И ДатаПроверки >= '20250416'
		И Справочники.ВидыЗадолженности.ОпределитьТипЗадолженности(ДокументОбъект.ВидЗадолженности) = Перечисления.ТипыЗадолженности.Кредиторская
		И Справочники.ВидыЗадолженности.ЭтоВидЗадолженностиДляФормированияПоручений(ДокументОбъект.ВидЗадолженности);
	
КонецФункции

#КонецОбласти

Функция ТребуетсяЗаполнениеОснованияДокументаРазмещениеКредитногоИнструмента(ДатаДокумента, Организация, РазмещениеБиржевогоДепозита) Экспорт
	
	// по задаче #546288 для биржевых депозитов создание распоряжений более не требуется
	Если РазмещениеБиржевогоДепозита Тогда
		Возврат Ложь;
	Иначе
		Возврат ДатаДокумента > Дата(2024, 02, 27)
			И (Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")
				Или Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	КонецЕсли;
	
КонецФункции
	
// Проверяет соответствие документа основания (расспоряжение) и подчиненных документов (МНО, Размещение кредитного инструмента)	
Процедура ПроверитьВозможностьСозданияПодчиненногоДокументаНаОснованииРаспоряжения(Объект, Отказ) Экспорт
		
	Если Не (ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.Распоряжение")) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеРеквизитовОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "ПометкаУдаления, Дата");
	
	Если ЗначениеРеквизитовОснования.ПометкаУдаления Тогда

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя создавать документы на основании помеченного на удаление распоряжения!",,,, Отказ);
		Возврат;
			
	КонецЕсли;
	
	ЭтоРаспоряжениеНаРазмещениеБиржевогоДепозита = Ложь;
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента") Тогда
					
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Основание, "СчетДоверительногоУправления, РасчетныйСчет, Сумма, Валюта, ДоВостребования, ПроцентнаяСтавкаПриДосрочномЗакрытии, Субординированность");
		РеквизитыДепозита = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КредитныйИнструмент, "БанковскийСчет, ДоВостребования, ПроцентнаяСтавкаПриДосрочномЗакрытии, Субординированность");  
		
		Если РеквизитыОснования.СчетДоверительногоУправления <> Объект.СчетДоверительногоУправления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счет доверительного управления отличается счета указанного в документе основания [" + РеквизитыОснования.СчетДоверительногоУправления + "]", Объект, "СчетДоверительногоУправления",, Отказ);
		КонецЕсли;
		
		ЭтоРаспоряжениеНаРазмещениеБиржевогоДепозита = РаботаСКредитнымиИнструментами.ЭтоБиржевойДепозит(Объект.КредитныйИнструмент);
		
		Если Не ЭтоРаспоряжениеНаРазмещениеБиржевогоДепозита Тогда
			
			Если РеквизитыОснования.Сумма <> Объект.Сумма Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма отличается от суммы документа основания [" + РеквизитыОснования.Сумма + "]", Объект, "Сумма",, Отказ);
			КонецЕсли;
	
			Если РеквизитыОснования.РасчетныйСчет <> Объект.РасчетныйСчет Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет отличается от счета документа основания [" + РеквизитыОснования.РасчетныйСчет + "]", Объект, "РасчетныйСчет",, Отказ);
			КонецЕсли;
			
		Иначе
			
			// распоряжение по биржевым депозитам может исполняться частично или не исполняться вовсе
			
			// каждому биржевому депозиту расчетный счет присваивается в заключения сделки на бирже
			// и при создании распоряжения они не известны
			
		КонецЕсли;
		
		Если РеквизитыОснования.Валюта <> РеквизитыДепозита.БанковскийСчет.Валюта Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта в документе основания [" + РеквизитыОснования.Валюта + "] отличается от валюты депозита [" + РеквизитыДепозита.Валюта + "]", Объект, "КредитныйИнструмент",, Отказ);
		КонецЕсли;
		
		Если РеквизитыОснования.ДоВостребования <> РеквизитыДепозита.ДоВостребования Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Условие [До востребования] в документе основания [" + РеквизитыОснования.ДоВостребования + "] отличается от условия депозита [" + РеквизитыДепозита.ДоВостребования + "]", Объект, "КредитныйИнструмент",, Отказ);
		КонецЕсли;
		
		Если РеквизитыОснования.ПроцентнаяСтавкаПриДосрочномЗакрытии <> РеквизитыДепозита.ПроцентнаяСтавкаПриДосрочномЗакрытии Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение процентной ставки при досрочном закрытии в документе основания [" + РеквизитыОснования.ПроцентнаяСтавкаПриДосрочномЗакрытии+ "] отличается от значения в депозите [" + РеквизитыДепозита.ПроцентнаяСтавкаПриДосрочномЗакрытии + "]", Объект, "КредитныйИнструмент",, Отказ);
		КонецЕсли;
		
		Если РеквизитыОснования.Субординированность <> РеквизитыДепозита.Субординированность Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Условие [Субординированность] в документе основания [" + РеквизитыОснования.Субординированность + "] отличается от условия депозита [" + РеквизитыДепозита.Субординированность + "]", Объект, "КредитныйИнструмент",, Отказ);
		КонецЕсли;
							
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.МНО") Тогда
													
		Если НачалоДня(Объект.Дата) <> НачалоДня(ЗначениеРеквизитовОснования.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Значение поля [Дата] не соответствует условиям распоряжения'"), Объект, "Дата",, Отказ);
		КонецЕсли; 
		
		Если Объект.Дата < ЗначениеРеквизитовОснования.Дата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Время документа [" + Формат(Объект.Дата, "ДФ=ЧЧ:мм:сс") + "] не должно быть раньше распоряжения [" + Формат(ЗначениеРеквизитовОснования.Дата, "ДФ=ЧЧ:мм:сс") + "]'"), Объект, "Дата",, Отказ);
		КонецЕсли;

		МассивПроверяемыхРеквизитовМНО = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Организация,СчетДоверительногоУправления,Сумма,Процент,ДатаВозврата,РасчетныйСчет", ",");

		Для Каждого Реквизит Из Метаданные.Документы.Распоряжение.Реквизиты Цикл
		
			Если МассивПроверяемыхРеквизитовМНО.Найти(Реквизит.Имя) <> Неопределено И Объект[Реквизит.Имя] <> Объект.Основание[Реквизит.Имя] Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Значение поля [" + Реквизит.Синоним + "] не соответствует условиям распоряжения'"), Объект, Реквизит.Имя,, Отказ);
			КонецЕсли; 
			
		КонецЦикла;
		
		Если Объект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		
			ЗарегистрированныеНомера = РегистрыСведений.НомераОбъектов.ПолучитьЗарегистрированныеНомера(
											Объект.Организация, 
											Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО,
											РаботаСКоллекциями.ЗначениеВМассив(Объект.Основание),
											Объект.СчетДоверительногоУправления,
											Год(Объект.Основание.Дата));
			
			Если ЗарегистрированныеНомера = Неопределено Или ЗарегистрированныеНомера.Получить(Объект.Основание) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нельзя создавать документ МНО на основании распоряжения без номера.'"), Объект, "Основание",, Отказ);									
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЕсли;   
	
	Если Не ЭтоРаспоряжениеНаРазмещениеБиржевогоДепозита Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Документ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РазмещениеКредитногоИнструмента КАК Документ
			|ГДЕ
			|	Документ.Ссылка <> &Ссылка 
			|	И Документ.Основание = &Основание
			|	И НЕ Документ.ПометкаУдаления";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("Основание", Объект.Основание);
		
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.МНО") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РазмещениеКредитногоИнструмента", "МНО");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На основании распоряжения уже создан документ [" + Выборка.Ссылка + "]",,,, Отказ);	
		КонецЦикла;
		
	Иначе	
		// у биржевых депозитов возможно исполнение распоряжения несколькими сделками-размещениями	
	КонецЕсли;
	
КонецПроцедуры

// Проверяет вид задолженности в документах НачислениеЗадолженности и Оплата:
// в зависимости от настройки ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента в условиях договоров доверительного управления 
// отдельные виды задолженности оплачиваются за счет собственных средств клиента, поэтому учет такой задолженности 
// ведется в бухгалтерской базе
//
// Параметры:
//		- Объект	- ДокументОбъект (Оплата, НачислениеЗадолженности)
//  	- Отказ		- Булево, устанавливается в Истина, если отсутствуют настройки или учет по виду задолженности ведется в бухгалтерской базе
//
Процедура ПроверитьВидыЗадолженностиОплачиваемойИзСобственныхСредствКлиента(Объект, Отказ) Экспорт
	
	ТипДокумента = ТипЗнч(Объект);
	Если ТипДокумента <> Тип("ДокументОбъект.НачислениеЗадолженности") 
		И ТипДокумента <> Тип("ДокументОбъект.Оплата") Тогда
		Возврат;
	КонецЕсли;
		
	Если РегистрыСведений.УсловияДоговоровДоверительногоУправления.ДляВидаДоговораДУВозможнаОплатаВознагражденияУправляющегоИРасходовСпецдепозитарияИзСобственныхСредствКлиента(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления")) Тогда
		
	    НастройкаУстановлена = РегистрыСведений.УсловияДоговоровДоверительногоУправления.ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.Дата, Отказ);
			
		Если Не Отказ 
			И НастройкаУстановлена
			И Справочники.ВидыЗадолженности.ВидыЗадолженностиОплачиваемойИзСобственныхСредствКлиента().Найти(Объект.ВидЗадолженности) <> Неопределено Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Задолженность вида '%1' для счета ДУ %2 начисляется и оплачивается только в базе собственной бухгалтерии", 
																Объект.ВидЗадолженности, Объект.СчетДоверительногоУправления), Объект.СчетДоверительногоУправления,,, Отказ);
				
		КонецЕсли;
																
	КонецЕсли;	
	  	
КонецПроцедуры

// Проверка необходимости заполнения основания в поручениях (Начисление задолженности) для контроля
// задолженности по денежным средствам по поручениям при проведении оплат на основании начислений задолженности.
Функция ДействуетКонтрольПорученийВнутреннейСистемы(ДатаДокумента, Организация) Экспорт
	
	Возврат ДатаДокумента > Дата(2024, 11, 26)
		И (Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") 
			Или Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	
КонецФункции
		
Функция ЗначенияРеквизитовСоответствуютОснованиюПоручения(Поручение, РеквизитыОснования = Неопределено, СообщитьОбОшибках = Истина) Экспорт
	
	Отказ = Ложь;
	
	Если РеквизитыОснования = Неопределено Тогда
				
		Если ЗначениеЗаполнено(Поручение.Основание) Тогда 
			
			РеквизитыОснования = Новый Структура("СчетДоверительногоУправления, ВидЗадолженности, Брокер, Валюта, МестоХранения, Сумма");
			
			Если ТипЗнч(Поручение.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	НачислениеЗадолженности.Брокер КАК Брокер,
					|	НачислениеЗадолженности.МестоХранения КАК МестоХранения,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
					|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма
					|ИЗ
					|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(&ДатаПоручения, Основание = &Основание) КАК ЗадолженностиПоДенежнымСредствамОстатки
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
					|			ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = НачислениеЗадолженности.Ссылка
					|				И НачислениеЗадолженности.Ссылка = &Основание";
				
				Запрос.УстановитьПараметр("ДатаПоручения", Поручение.Дата);
				Запрос.УстановитьПараметр("Основание", Поручение.Основание);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ЗаполнитьЗначенияСвойств(РеквизитыОснования, Выборка);	
				КонецЕсли;
			
			ИначеЕсли ТипЗнч(Поручение.Основание) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
		
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	НачислениеЗадолженности.Брокер КАК Брокер,
					|	НачислениеЗадолженности.МестоХранения КАК МестоХранения,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
					|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма
					|ИЗ
					|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(&ДатаПоручения, Основание = &Основание) КАК ЗадолженностиПоДенежнымСредствамОстатки
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
					|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
					|			ПО НачислениеЗадолженностиОснования.Ссылка = НачислениеЗадолженности.Ссылка
					|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = НачислениеЗадолженностиОснования.Основание
					|			И (ЗадолженностиПоДенежнымСредствамОстатки.Основание = &Основание)";
				
				Запрос.УстановитьПараметр("ДатаПоручения", Поручение.Дата);
				Запрос.УстановитьПараметр("Основание", Поручение.Основание);
				
				Результат = Запрос.Выполнить();
				
				Если Результат.Пустой() Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить начисление задолженности по НДФЛ с основанием [" + Поручение.Основание + "].",,,, Отказ);
					
				Иначе
					
					Выборка = Результат.Выбрать();
				
					Если Выборка.Следующий() Тогда	
						ЗаполнитьЗначенияСвойств(РеквизитыОснования, Выборка);
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Поручение.Основание) = Тип("ДокументСсылка.ПогашениеПаев") Тогда
		
				Запрос = Новый Запрос;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок) КАК МестоХранения,
					|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Брокер,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
					|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
					|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма
					|ИЗ
					|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(&ДатаПоручения, Основание = &ЗаявкаПайщика) КАК ЗадолженностиПоДенежнымСредствамОстатки";
				
				Запрос.УстановитьПараметр("ДатаПоручения", Поручение.Дата);
				Запрос.УстановитьПараметр("ЗаявкаПайщика", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поручение.Основание, "Заявка"));
				
				Результат = Запрос.Выполнить();
				
				Если Результат.Пустой() Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить задолженность с основанием [" + Поручение.Основание + "].",,,, Отказ);
					
				Иначе
					
					Выборка = Результат.Выбрать();
				
					Если Выборка.Следующий() Тогда	
						ЗаполнитьЗначенияСвойств(РеквизитыОснования, Выборка);
					КонецЕсли;
					
				КонецЕсли;
	
			Иначе
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать поручение на основании документа [" + Поручение.Основание + "].",,,, Отказ);
								
			КонецЕсли;
			
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
									
	Если РеквизитыОснования.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поручения можно создавать на основании задолженности с местом хранения [Внебиржевой рынок]. В начислениии задолженности указано место хранения [" + РеквизитыОснования.МестоХранения + "].",,,, Отказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыОснования.Брокер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать поручение на основании начислений задолженности с оплатой через брокера [" + РеквизитыОснования.Брокер + "].",,,, Отказ);		
	КонецЕсли; 
	
	Если Не Справочники.ВидыЗадолженности.ЭтоВидЗадолженностиДляФормированияПоручений(РеквизитыОснования.ВидЗадолженности) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрещено создавать поручение на основании начислений с видом задолженности [" + РеквизитыОснования.ВидЗадолженности + "].",,,, Отказ);		
	КонецЕсли;
	
	Если РеквизитыОснования.СчетДоверительногоУправления <> Поручение.СчетДоверительногоУправления Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта поручения [" + Поручение.СчетДоверительногоУправления + "] отличается от валюты [" + РеквизитыОснования.СчетДоверительногоУправления + "] документа основания [" + Поручение.Основание + "].",,,, Отказ);	
	КонецЕсли;
		
	Если РеквизитыОснования.Свойство("Основания") Тогда	
		//#184359 тех долг. Доработать проверку значения реквизита "Сумма" документа "Начисление задолженности" при перепроведении.
		СуммаНачисления = РеквизитыОснования.Основания.Выгрузить().Итог("Сумма");	
	ИначеЕсли РеквизитыОснования.Свойство("Сумма") Тогда	
		
		СуммаНачисления = РеквизитыОснования.Сумма; 
		
		Если СуммаНачисления <> Поручение.Сумма Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма поручения [" + Поручение.Сумма + "] отличается от суммы [" + СуммаНачисления + "] документа основания [" + Поручение.Основание + "].",,,, Отказ);	
		КонецЕсли; 
		
	КонецЕсли;
	
	Если РеквизитыОснования.Валюта <> Поручение.Валюта Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта поручения [" + Поручение.Валюта + "] отличается от валюты [" + РеквизитыОснования.Валюта + "] документа основания [" + Поручение.Основание + "].",,,, Отказ);	
	КонецЕсли;
			
	Если Не СообщитьОбОшибках Тогда
		ПолучитьСообщенияПользователю(Истина);	
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции 

// Проверка наличия подчиненного поручения на движение денежных средств созданного на основании начисления задолженности.
Функция ПолучитьПодчиненныйДокументПоручениеНаВыводАктивов(Знач Объект) Экспорт
	
	Если ТипЗнч(Объект.Ссылка) <> Тип("ДокументСсылка.НачислениеЗадолженности") Тогда 
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Не ДействуетКонтрольПорученийВнутреннейСистемы(Объект.Дата, Объект.Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоДенежнымСредствамПоПоручениям.Регистратор КАК Ссылка,
		|	ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамПоПоручениям.Регистратор) = ТИП(Документ.КорректировкаРегистров) КАК ЭтоКорректировка
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям КАК ЗадолженностиПоДенежнымСредствамПоПоручениям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВЫБОР
		|				КОГДА НачислениеЗадолженностиОснования.Основание ССЫЛКА Документ.НачислениеДивидендов
		|					ТОГДА НачислениеЗадолженностиОснования.Основание
		|				ИНАЧЕ НачислениеЗадолженностиОснования.Ссылка
		|			КОНЕЦ КАК Ссылка
		|		ИЗ
		|			Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК ДокНачислениеЗадолженности
		|				ПО НачислениеЗадолженностиОснования.Ссылка = ДокНачислениеЗадолженности.Ссылка
		|					И (ДокНачислениеЗадолженности.Ссылка = &ДокументСсылка)
		|					И (ДокНачислениеЗадолженности.ВидЗадолженности В (&ВидыЗадолженности))) КАК ОснованиеПоручения
		|		ПО ЗадолженностиПоДенежнымСредствамПоПоручениям.Основание = ОснованиеПоручения.Ссылка
		|			И (ЗадолженностиПоДенежнымСредствамПоПоручениям.Организация = &Организация)
		|			И (ЗадолженностиПоДенежнымСредствамПоПоручениям.Активность)
		|			И (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамПоПоручениям.Регистратор) В (ТИП(Документ.ПоручениеНаДвижениеДенежныхСредств), ТИП(Документ.КорректировкаРегистров)))
		|			И (ЗадолженностиПоДенежнымСредствамПоПоручениям.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))";
	
	Запрос.УстановитьПараметр("ДокументСсылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ВидыЗадолженности", Справочники.ВидыЗадолженности.ВидыЗадолженностиДляФормированияПоручений());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.ЭтоКорректировка Тогда 
			
			//На основании начисления задолженности должны формироваться поручения, если движение (в регистре Начисление задолженности по денежным средствам по поручениям) сформированно корректировкой - это странно. Сообщим об этом. 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре [Начисление задолженности по денежным средствам по поручениям] сформировано движение регистратором [" + Выборка.Ссылка + "], где основанием является [" + Объект.Ссылка + "].");	
			
		Иначе
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;		
	
	Возврат Неопределено;	
									
КонецФункции

Функция ПолучитьТекущийСтатусПорученияНаПереводДенежныхСредств(ПоручениеСсылка) Экспорт 
				
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыПоручений.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(&Период, ПоручениеНаПереводДенежныхСредств = &ПоручениеСсылка) КАК СтатусыПоручений";
	
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПоручениеСсылка", ПоручениеСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда	
		Возврат Выборка.Статус;	
	КонецЕсли;
		
КонецФункции

// Возвращает значение реквизита Субконто1 для документа ВводДенежныхСредств или ВыводДенежныхСредств
// 
//	Параметры:
//		Объект - ДанныеФормыСтруктура, ДокументОбъект - документ ввода или вывода денежных средств
//
Функция Субконто1ДляВводаВыводаДенежныхСредств(Объект) Экспорт
	
	Результат = Неопределено;
	
	Если Объект.КоррСчет = ПланыСчетов.Основной.ЦелевоеФинансированиеВоеннойИпотекиПереданноеВОтчетномГоду Тогда 
		// 86.4.1 - без субконто. Ничего не делаем				
	ИначеЕсли Объект.КоррСчет = ПланыСчетов.Основной.РасчетыПоДоговоруДоверительногоУправленияИмуществом Тогда // 79.3 - контрагенты
		
		Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда 
			Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Объект.СчетДоверительногоУправления);
			Результат = ?(ТипЗнч(Клиент) = Тип("СправочникСсылка.ЮрФизЛица"), Клиент, Неопределено);		
		КонецЕсли;
			
	ИначеЕсли Объект.КоррСчет = ПланыСчетов.Основной.ПрочиеДоходы Тогда // 91.1.1 - комментарии излишни
		
		Если Объект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваДоходПоПаямЗПИФ Тогда
			Результат = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДоходыПоПаямЗПИФ");
		ИначеЕсли Объект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваПроцентЗаПользованиеДенежнымиСредствами Тогда
			Результат = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПроцентыНаОстатокНаРасчетномСчете");
		КонецЕсли;
		
	ИначеЕсли Объект.КоррСчет = ПланыСчетов.Основной.УслугиБрокера
		Или Объект.КоррСчет = ПланыСчетов.Основной.РасчетыПоПретензиям 
		Или Объект.КоррСчет = ПланыСчетов.Основной.ЧастьПенсионныхВзносовДляОбеспеченияИОУДПеречисленно
		Или Объект.КоррСчет = ПланыСчетов.Основной.ПрибыльУбытокДУТекущегоПериода
		Или Объект.КоррСчет = ПланыСчетов.Основной.РасчетыСАгентами Тогда // 60.5, 76.2, 79.5.2, 79.4.1, 76.10 - контрагенты
		
		Результат = Объект.Контрагент;
					
	ИначеЕсли Объект.КоррСчет = ПланыСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами Тогда // 76.9 - контрагенты
		
		Если ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ПогашениеПаев") И ЗначениеЗаполнено(Объект.Основание) Тогда
			Результат = ПолучитьКонтрагентаПоВидуПайщика(Объект.Основание.ВидПайщика, Объект.Основание.Владелец, Объект.Основание.Пайщик, Объект.Дата);
		Иначе
			Результат = Объект.Контрагент;
		КонецЕсли;
		
	ИначеЕсли Объект.КоррСчет = ПланыСчетов.Основной.РасчетыПоАвансамВыданным Тогда // 60.2 - контрагенты
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо");
	КонецЕсли;	
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКонтрагентаПоВидуПайщика(ВидПайщика, Владелец, Пайщик, Дата) Экспорт    
	
	Если Дата >= Дата(2025, 1, 1) Тогда
		Если ВидПайщика = Перечисления.ВидыПайщиков.НоминальныйДержатель Тогда   
			Контрагент = Владелец;   
		Иначе	
			Контрагент = Пайщик;   
		КонецЕсли;		
	Иначе
		Контрагент = Пайщик;
	КонецЕсли;	
	
	Возврат Контрагент;
	
КонецФункции	

// Функция пробует сначала записать документ, а в случае успеха - провести его
//
//	Параметры:
//		ДокументОбъект - объект записываемого документа
//
Функция ЗаписатьПровестиДокумент(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.ПроверитьЗаполнение() Тогда
						
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось записать документ %1: %2", ДокументОбъект, ОписаниеОшибки()));
			Возврат Ложь;
		КонецПопытки;
		
		ДокументСсылка = ДокументОбъект.Ссылка;
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Документ %1 находится в состоянии 'Записан'", ДокументСсылка), ДокументСсылка); 			
		КонецПопытки;
				
		Возврат Истина;
		
	Иначе
		
		ТекстСообщения = СтрШаблон("Вид документа '%1'", ДокументОбъект.Метаданные().Имя);
		Если ДокументОбъект.Метаданные().Реквизиты.Найти("СчетДоверительногоУправления") <> Неопределено Тогда
			ТекстСообщения = ТекстСообщения + СтрШаблон(", счет доверительного управления %1", ДокументОбъект.СчетДоверительногоУправления);
		КонецЕсли;
		
		Если ДокументОбъект.Метаданные().Реквизиты.Найти("Сумма") <> Неопределено Тогда
			ТекстСообщения = ТекстСообщения + СтрШаблон(", сумма %1", Формат(ДокументОбъект.Сумма, "ЧГ=0"));
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;	
	
КонецФункции

Функция ОрганизацияРаботаетСРозницейПИФ(Организация, Дата) Экспорт

	Возврат Дата >= '20260130'
		И Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
		
КонецФункции
