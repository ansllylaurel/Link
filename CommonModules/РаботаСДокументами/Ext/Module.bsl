#Область Акцептование_Операций

Функция ДокументАкцептован(ДокументСсылка, Организация) Экспорт
	
	Возврат ЗначениеЗаполнено(ПолучитьДатуАкцептования(ДокументСсылка, Организация));
	
КонецФункции

Функция ПолучитьДатуАкцептования(ДокументСсылка, Организация = Неопределено) Экспорт
		
	Если Не Метаданные.РегистрыСведений["АкцептованиеОпераций"].Измерения.Операция.Тип.СодержитТип(ТипЗнч(ДокументСсылка)) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АкцептованиеОпераций.Период КАК ДатаАкцепта
		|ИЗ
		|	РегистрСведений.АкцептованиеОпераций КАК АкцептованиеОпераций
		|ГДЕ
		|	АкцептованиеОпераций.Операция = &ДокументСсылка
		|	И АкцептованиеОпераций.Организация = &Организация
		|	И АкцептованиеОпераций.Активность";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
			
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаАкцепта;	
	КонецЕсли;
				
КонецФункции

Функция АкцептованныйДокументМожноЗаписать(ДанныеДокумента, Отказ = Неопределено) Экспорт
	
	Если РаботаСДокументами.ДокументАкцептован(ДанныеДокумента.Ссылка, ДанныеДокумента.Организация) Тогда
		Если РаботаСДокументами.ИзмененыРеквизитыШапкиДокумента(ДанныеДокумента, РаботаСМетаданнымиПовтИсп.ПолучитьИменаПолейШапкиДокумента(ДанныеДокумента.Метаданные().Имя), "Номер", Истина) Тогда
			// Пока ничего не сообщаем. Нужно переделать на интерактивную проверку с вопросом
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Изменен акцептованный документ", ДанныеДокумента,,,);		
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя изменять акцептованный документ!", ДанныеДокумента,,, Отказ);		
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Истина;
		
КонецФункции //АкцептованныйДокументМожноЗаписать

Процедура ИзменитьВремяДокументаСУчетомАкцептования(Документ, ДатаПодтверждения) Экспорт 
		
	Если НачалоДня(Документ.Дата) = НачалоДня(ДатаПодтверждения) Тогда

		Если Документ.Дата <= ДатаПодтверждения Тогда
			
			// Проблема: время документа изменяется, при этом время проводок (БУ, НУ, ЕПС) остается прежним
			// Отключаем автоматическое изменение времени в закрытом периоде, а также ранее последнего рабочего дня
			Если ЗапретРедактированияДокумента(Документ.Ссылка, Документ, Ложь, Ложь)  Тогда			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время документа раньше времени акцепта, и период закрыт. Необходимо обратиться к программистам.", Документ);				
			ИначеЕсли  НачалоДня(Документ.Дата) < Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2)	Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Время документа раньше времени акцепта, а дата раньше последней даты проведения регламентных операций. Необходимо обратиться к программистам.", Документ);
			ИначеЕсли ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.Распоряжение") Тогда // для распоряжений так и должно быть -> (дата распоряжения <= дата акцепта)
				Возврат;
			Иначе
				
				Генератор = Новый ГенераторСлучайныхЧисел(Число(ТекущаяДата() - Дата(1, 1, 1)));
				
				ДокументОбъект = Документ.ПолучитьОбъект();
						
				ДокументОбъект.Дата = ДатаПодтверждения + Генератор.СлучайноеЧисло(20, 24) * 60 + Генератор.СлучайноеЧисло(0, 59);
				
				Если ДокументОбъект.Проведен Тогда
					// Пока так, чтобы движения гарантированно очистились и сформировались заново
					ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);				
				Иначе
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли НачалоДня(Документ.Дата) < НачалоДня(ДатаПодтверждения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата документа раньше даты акцепта, необходимо обратиться к программистам.", Документ);
	КонецЕсли;
	
КонецПроцедуры

Функция ТребуетсяАкцептованиеДокумента(ДокументСсылка, Организация, СчетДоверительногоУправления, Дата = Неопределено) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств") Тогда 
		
		РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Брокер, БрокерПолучатель");
		//интересуют только поручения на выводы со счетов брокера	
		Если ЗначениеЗаполнено(РеквизитыПоручения.БрокерПолучатель) Или Не ЗначениеЗаполнено(РеквизитыПоручения.Брокер) Тогда
			Возврат Ложь;	
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
	#Область Текст_Запроса 
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДокПоручение.Дата КАК Дата,
			|	ДокПоручение.Ссылка КАК Ссылка,
			|	ДокПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДокПоручение.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ) КАК ЭтоФогф,
			|	ДокПоручение.Брокер КАК Брокер,
			|	ДокПоручение.Брокер.ЮрФизЛицо КАК БрокерЮрЛицо,
			|	ДокПоручение.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
			|	ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОжидаетАкцепта) КАК ТребуетсяАкцепт
			|ПОМЕСТИТЬ ДанныеПоручения
			|ИЗ
			|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(
			|				&Дата,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный)) КАК НастройкиАкцептованияОперацийСрезПоследних
			|		ПО ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления
			|			И (ДокПоручение.Организация = &Организация)
			|			И (ДокПоручение.Ссылка = &Поручение)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(&Дата, ) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
			|		ПО ДокПоручение.Ссылка = СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств
			|ГДЕ
			|	НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	АкцептованиеОперацийСрезПоследних.Период КАК Период,
			|	АкцептованиеОперацийСрезПоследних.Операция КАК Операция,
			|	АкцептованиеОперацийСрезПоследних.Срок КАК Срок,
			|	ТИПЗНАЧЕНИЯ(АкцептованиеОперацийСрезПоследних.Операция) В (ТИП(Справочник.ДоговорыБрокерскогоОбслуживания), ТИП(Справочник.Договоры)) КАК АкцептНаДоговор
			|ПОМЕСТИТЬ _АкцептованиеОпераций
			|ИЗ
			|	РегистрСведений.АкцептованиеОпераций.СрезПоследних(
			|			,
			|			Организация = &Организация
			|				И Операция В
			|					(ВЫБРАТЬ
			|						ДанныеПоручения.Ссылка КАК Операция
			|					ИЗ
			|						ДанныеПоручения КАК ДанныеПоручения
			|			
			|					ОБЪЕДИНИТЬ
			|			
			|					ВЫБРАТЬ
			|						КодыСчетов.ДоговорБрокерскогоОбслуживания
			|					ИЗ
			|						РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&Дата, Организация = &Организация
			|							И (СчетДоверительногоУправления, Брокер) В
			|								(ВЫБРАТЬ
			|									ДанныеПоручения.СчетДоверительногоУправления,
			|									ДанныеПоручения.Брокер
			|								ИЗ
			|									ДанныеПоручения КАК ДанныеПоручения)) КАК КодыСчетов)
			|				И ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный)) КАК АкцептованиеОперацийСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.ЮрЛицо КАК ЮрЛицо,
			|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК Ссылка
			|ПОМЕСТИТЬ _ГоловныеОрганизации
			|ИЗ
			|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ДанныеПоручения.БрокерЮрЛицо КАК ЮрЛицо
			|	ИЗ
			|		ДанныеПоручения КАК ДанныеПоручения
			|	ГДЕ
			|		НЕ ДанныеПоручения.ТребуетсяАкцепт
			|	
			|	ОБЪЕДИНИТЬ
			|	
			|	ВЫБРАТЬ РАЗЛИЧНЫЕ
			|		ДанныеПоручения.БанкЮрЛицо
			|	ИЗ
			|		ДанныеПоручения КАК ДанныеПоручения
			|	ГДЕ
			|		НЕ ДанныеПоручения.ТребуетсяАкцепт) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
			|		ПО ВложенныйЗапрос.ЮрЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
			|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА &Дата >= &ДатаНачалаКонтроляАкцептов
			|			ТОГДА ВЫБОР
			|					КОГДА ДанныеПоручения.ТребуетсяАкцепт
			|						ТОГДА ИСТИНА
			|					ИНАЧЕ ВЫБОР
			|							КОГДА ДлинныйАкцепт.Операция ЕСТЬ NULL
			|								ТОГДА КороткийАкцепт.Операция ЕСТЬ NULL
			|							ИНАЧЕ ВЫБОР
			|									КОГДА ДанныеПоручения.ЭтоФогф
			|										ТОГДА ЛОЖЬ
			|									ИНАЧЕ ЕСТЬNULL(_БрокерГоловнаяОрганизация.Ссылка, _БрокерГоловнаяОрганизация.ЮрЛицо) <> ЕСТЬNULL(_БанкГоловнаяОрганизация.Ссылка, _БанкГоловнаяОрганизация.ЮрЛицо)
			|								КОНЕЦ
			|						КОНЕЦ
			|				КОНЕЦ
			|		ИНАЧЕ КороткийАкцепт.Операция ЕСТЬ NULL
			|	КОНЕЦ КАК ТребуетсяАкцепт
			|ИЗ
			|	ДанныеПоручения КАК ДанныеПоручения
			|		ЛЕВОЕ СОЕДИНЕНИЕ _АкцептованиеОпераций КАК КороткийАкцепт
			|		ПО ДанныеПоручения.Ссылка = КороткийАкцепт.Операция
			|		ЛЕВОЕ СОЕДИНЕНИЕ _АкцептованиеОпераций КАК ДлинныйАкцепт
			|		ПО (ДлинныйАкцепт.АкцептНаДоговор)
			|			И ДанныеПоручения.Дата >= ДлинныйАкцепт.Период
			|			И (ДлинныйАкцепт.Срок = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ ДанныеПоручения.Дата < ДлинныйАкцепт.Срок)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _БрокерГоловнаяОрганизация
			|		ПО ДанныеПоручения.БрокерЮрЛицо = _БрокерГоловнаяОрганизация.ЮрЛицо
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _БанкГоловнаяОрганизация
			|		ПО ДанныеПоручения.БанкЮрЛицо = _БанкГоловнаяОрганизация.ЮрЛицо";
	#КонецОбласти
		
		Запрос.УстановитьПараметр("ДатаНачалаКонтроляАкцептов", РаботаСДокументами.ДатаНачалаКонтроляАкцептов());
		Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Поручение" , ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
			
		Возврат (Выборка.Следующий() И Выборка.ТребуетсяАкцепт);
	
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Распоряжение") Тогда  
		
		Запрос = Новый Запрос;
		
	#Область Текст_Запроса
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиАкцептованияОперацийСрезПоследних.Организация КАК Организация,
			|	НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта КАК ВидАкцепта,
			|	ДокРаспоряжение.Ссылка КАК Распоряжение,
			|	ДокРаспоряжение.РасчетныйСчет КАК РасчетныйСчет
			|ПОМЕСТИТЬ _НастройкиАкцептования
			|ИЗ
			|	РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(
			|			&Дата,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидАкцепта В (ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО), ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНОСрочный30Дней4ПроцентаУКПИ))) КАК НастройкиАкцептованияОперацийСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК ДокРаспоряжение
			|		ПО (ДокРаспоряжение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация)
			|			И (ДокРаспоряжение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления)
			|			И (ДокРаспоряжение.Ссылка = &Распоряжение)
			|ГДЕ
			|	НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	АкцептованиеОперацийСрезПоследних.Операция ЕСТЬ NULL
			|		ИЛИ АкцептованиеОперацийСрезПоследних.Срок <> ДАТАВРЕМЯ(1, 1, 1)
			|			И АкцептованиеОперацийСрезПоследних.Срок <= &Дата КАК ТребуетсяАкцепт
			|ИЗ
			|	_НастройкиАкцептования КАК _НастройкиАкцептования
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций.СрезПоследних(
			|				&Дата,
			|				(Организация, ВидАкцепта) В
			|						(ВЫБРАТЬ
			|							_НастройкиАкцептования.Организация,
			|							_НастройкиАкцептования.ВидАкцепта
			|						ИЗ
			|							_НастройкиАкцептования КАК _НастройкиАкцептования)
			|					И Операция В
			|						(ВЫБРАТЬ
			|							_НастройкиАкцептования.Распоряжение
			|						ИЗ
			|							_НастройкиАкцептования КАК _НастройкиАкцептования
			|				
			|						ОБЪЕДИНИТЬ
			|				
			|						ВЫБРАТЬ
			|							_НастройкиАкцептования.РасчетныйСчет
			|						ИЗ
			|							_НастройкиАкцептования КАК _НастройкиАкцептования)) КАК АкцептованиеОперацийСрезПоследних
			|		ПО _НастройкиАкцептования.Организация = АкцептованиеОперацийСрезПоследних.Организация
			|			И _НастройкиАкцептования.ВидАкцепта = АкцептованиеОперацийСрезПоследних.ВидАкцепта";
	#КонецОбласти
		
		Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Распоряжение" , ДокументСсылка);

		Выборка = Запрос.Выполнить().Выбрать();
			
		Возврат (Выборка.Следующий() И Выборка.ТребуетсяАкцепт);
	
	КонецЕсли;
		
КонецФункции

// Проверяет, согласовано ли поручение на вывод активов
//
//	Параметры:
//		- ДокументСсылка - ПоручениеНаДвижениеДенежныхСредств, ПоручениеНаДвижениеЦенныхБумаг
//		- Дата - Дата проверки
//
Функция ПоручениеНаВыводАктивовСогласовано(ДокументСсылка, Дата) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АкцептованиеОперацийСрезПоследних.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Операция = &Ссылка
		|				И ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПоручениеНаВыводАктивов)) КАК АкцептованиеОперацийСрезПоследних";
	
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация"));
	Запрос.УстановитьПараметр("Ссылка",			ДокументСсылка);
			                                    
	Выборка = Запрос.Выполнить().Выбрать();
		
	Возврат ?(Выборка.Следующий(), Истина, Ложь);
		
КонецФункции

#КонецОбласти

// Возвращает список значений, состоящий из документов движения денежных средств для данной строки банковской выписки
Функция ПолучитьДвиженияДенежныхСредствПоСтрокеБанковскойВыписки(СтрокаБанковскойВыписки) Экспорт
	
	Возврат РегистрыСведений.РеестрПлатежей.НайтиВРеестреПлатежей(СтрокаБанковскойВыписки);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция ЗаполнитьСтрокиПартии(ПартиобразующийДокумент, ИмяКорзиныЦенныхБумаг = "ЦенныеБумаги") Экспорт
	
	МаксСтрокаПартии = 0;
	
	// за первый проход определим макс. строку партии
	Для каждого СтрокаКорзиныЦенныхБумаг Из ПартиобразующийДокумент[ИмяКорзиныЦенныхБумаг] Цикл
		МаксСтрокаПартии = Макс(МаксСтрокаПартии, СтрокаКорзиныЦенныхБумаг.СтрокаПартии);
	КонецЦикла;
	
	МаксСтрокаПартии = МаксСтрокаПартии + 1;
	
	// за 2-й проход заполним незаполненные ранее строки партий
	Для каждого СтрокаКорзиныЦенныхБумаг Из ПартиобразующийДокумент[ИмяКорзиныЦенныхБумаг] Цикл
		Если СтрокаКорзиныЦенныхБумаг.СтрокаПартии = 0 Тогда
			СтрокаКорзиныЦенныхБумаг.СтрокаПартии = МаксСтрокаПартии;
			МаксСтрокаПартии = МаксСтрокаПартии + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ЗаполнитьСтрокиПартии

Функция ЗаполнитьИсполнениеПоЦеннымБумагамНаОсновании(Документ, Основание, ВидЗадолженности = Неопределено) Экспорт
	
	Документ.ЦенныеБумаги.Очистить();
	
	// заполним шапки реквизиты, общие для всех документов
	ЗаполнитьЗначенияСвойств(Документ, Основание, "Организация, Рынок, СчетДоверительногоУправления, ВалютаСделки");
	
	Если Не ЗначениеЗаполнено(Документ.Ссылка) Тогда // новый документ
		Документ.Основание        = Основание;
		Документ.ВидЗадолженности = ВидЗадолженности;
	КонецЕсли;
	
	ЧастныеРеквизитыШапки = Новый Структура("ВидДвижения", Основание.ВидСделки);
	ЗаполнитьЗначенияСвойств(Документ, ЧастныеРеквизитыШапки);
	
	// по возможности, определим тип и вид задолженности
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Период,
		|			Основание = &Основание
		|				И ВидЗадолженности = &ВидЗадолженности) КАК ЗадолженностиПоЦеннымБумагамОстатки";
		
	Если Не ЗначениеЗаполнено(ВидЗадолженности) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВидЗадолженности = &ВидЗадолженности", "");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Период",           ?(Не ЗначениеЗаполнено(Документ.Ссылка), Неопределено, Документ.МоментВремени()));
	Запрос.УстановитьПараметр("Основание",        Основание);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
		
	ВариантыЗаполнения = Запрос.Выполнить().Выгрузить();
	
	Если      ВариантыЗаполнения.Количество() = 0 Тогда
		// нет задолженности по документу
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Задолженность по ценным бумагам " + ?(ЗначениеЗаполнено(ВидЗадолженности), НРег(ВидЗадолженности), "по документу") + " " + Основание + " отсутствует");
		Возврат Неопределено;
		
	ИначеЕсли ВариантыЗаполнения.Количество() = 1 Тогда
		Документ.ВидЗадолженности = ВариантыЗаполнения[0].ВидЗадолженности;
		
		ЧастныеРеквизитыШапки.ВидДвижения = РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьВидДвиженияПоТипуЗадолженности(ВариантыЗаполнения[0].ТипЗадолженности);
		ЗаполнитьЗначенияСвойств(Документ, ЧастныеРеквизитыШапки);
		
	Иначе
		// когда вариантов более одного, при открытии формы нужно произведить подбор задолженности из соотв. общ. формы
		Возврат Ложь;
		
	КонецЕсли;
		
	// получим данные по ценным бумагам
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК Количество,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток КАК Сумма,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаКупонаОстаток КАК СуммаКупона
		|ПОМЕСТИТЬ _ЗадолженностьПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Период,
		|			Основание = &Основание
		|				И ВидЗадолженности = &ВидЗадолженности) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностьПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЗадолженностьПоЦеннымБумагамОстатки.Количество КАК Количество,
		|	_ЗадолженностьПоЦеннымБумагамОстатки.Сумма КАК Сумма,
		|	_ЗадолженностьПоЦеннымБумагамОстатки.СуммаКупона КАК СуммаКупона,
		|	УсловияСделокСрезПоследних.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	УсловияСделокСрезПоследних.Цена КАК Цена,
		|	УсловияСделокСрезПоследних.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК ПлановаяДатаПоставки,
		|	УсловияСделокСрезПоследних.ЦенаКупона КАК ЦенаКупона
		|ИЗ
		|	_ЗадолженностьПоЦеннымБумагамОстатки КАК _ЗадолженностьПоЦеннымБумагамОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&Период,
		|				НЕ Отменено
		|					И СделкаРЕПО = &Основание
		|					И ВидЗадолженности = &ВидЗадолженности) КАК УсловияСделокСрезПоследних
		|		ПО _ЗадолженностьПоЦеннымБумагамОстатки.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага";
		
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РЕПО", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВидЗадолженности = &ВидЗадолженности", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",           ?(Не ЗначениеЗаполнено(Документ.Ссылка), Неопределено, Документ.МоментВремени()));
	Запрос.УстановитьПараметр("Основание",        Документ.Основание);
	Запрос.УстановитьПараметр("ВидЗадолженности", Документ.ВидЗадолженности);
	
 	РезультатЗапроса = Запрос.Выполнить();
	Документ.ЦенныеБумаги.Загрузить(РезультатЗапроса.Выгрузить());
	
	// если поставка проходит в ту же дату, что и изменение условий, то для нового документа установим
	// время позже, чем последнее изменение этих условий сделки
	Если НЕ ЗначениеЗаполнено(Документ.Ссылка) Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ПлановаяДатаПоставки = Выборка.ПлановаяДатаПоставки;
			
			Если ПлановаяДатаПоставки = НачалоДня(Документ.Основание.Дата) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	МАКСИМУМ(УсловияСделок.Период) КАК Период
					|ИЗ
					|	РегистрСведений.УсловияСделокРЕПО КАК УсловияСделок
					|ГДЕ
					|	УсловияСделок.Период <= &Период
					|	И УсловияСделок.СделкаРЕПО = &Основание";
				
				Если ТипЗнч(Основание) <> Тип("ДокументСсылка.СделкаРЕПО") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "РЕПО", "");
				КонецЕсли;
				
				Запрос.УстановитьПараметр("Период",    КонецДня(ПлановаяДатаПоставки));
				Запрос.УстановитьПараметр("Основание", Документ.Основание);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					Если Выборка.Период + 1 > КонецДня(ПлановаяДатаПоставки) Тогда // чтобы случайно не перескочить на следующий день
						Документ.Дата = КонецДня(ПлановаяДатаПоставки)
					Иначе
						Документ.Дата = Выборка.Период + 1;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				Документ.Дата = ПлановаяДатаПоставки;
				
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат Истина;
	
КонецФункции // ЗаполнитьИсполнениеПоЦеннымБумагамНаОсновании

////////////////////////////////////////////////////////////////////////////////

// Возвращает имя документа из метаданных. Актуально для вызова
// с клиента для последующей передачи в прочие объекты или структуры данных
// 
// Параметры:
//  Документ - ДокументСсылка или ДокументОбъект
// 
// Возвращаемое значение:
//  Имя документа, как оно задано в метаданных
//
Функция ПолучитьИмя(Документ) Экспорт
	
	Возврат Документ.Метаданные().Имя;
	
КонецФункции // ПолучитьИмя

// Возвращает момент времени переданного документа. Актуально для вызова
// с клиента для последующей передачи в прочие объекты или структуры данных
// 
// Параметры:
//  Документ - ДокументСсылка или ДокументОбъект
// 
// Возвращаемое значение:
//  Момент времени документа, если он был сохранен, или неопределено, в противном случае
//
Функция ПолучитьМоментВремени(Документ) Экспорт
	
	Если ЗначениеЗаполнено(Документ) Тогда
		Возврат Документ.МоментВремени();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьМоментВремени

////////////////////////////////////////////////////////////////////////////////

Функция ЭтоРежимПроведения(Документ, РежимЗаписи) Экспорт
	
	Возврат (РежимЗаписи = РежимЗаписиДокумента.Проведение) Или (РежимЗаписи = РежимЗаписиДокумента.Запись И Документ.Проведен);
	
КонецФункции // ЭтоРежимПроведения

// Проверяет возможность редактирования документа
//
// Параметры:
//	Документ			- ДокументСсылка				- ссылка на проверяемый документ
//	ДокументОбъект		- ДокументОбъект				- объект проверяемого документа
//	Отказ				- Булево						- выходной параметр, при запрете редактирования устанавливается в значение Истина
//	СообщатьОбОтказе	- Булево						- при Истина пользователю будет выведено сообщение об отказе, при Ложь будет заполнен параметр ТекстСообщения
//	ТекстСообщения		- Строка, ФорматированнаяСтрока	- выходной параметр, при СообщатьОбОтказе=Ложь будет заполнен текстом сообщения о причине запрета редактирования
//	РежимЗаписи			- РежимЗаписиДокумента			- режим записи документа
//
// Возвращаемое значение:
//	Булево - редактирование документа запрещено
//
Функция ЗапретРедактированияДокумента(Документ, ДокументОбъект, Отказ, СообщатьОбОтказе = Истина, ТекстСообщения = Неопределено, РежимЗаписи = Неопределено) Экспорт
	
	Запрет = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументМД = Документ.Метаданные();
	
	// Для проводимых документов проверку выполняем, только если документ уже проведен или проводится в данный момент
	
	Если ДокументМД.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить
		И Не Документ.Проведен 
		И РежимЗаписи <> Неопределено 
		И РежимЗаписи <> РежимЗаписиДокумента.Проведение
	Тогда
		Запрет = Ложь; 
	КонецЕсли; 
	
	// Определяем счета д/у документа, у которых нужно проверить даты запрета реадактирования
	
	Если Запрет = Неопределено Тогда
	
		ЕстьРеквизитСчетДоверительногоУправления = (ДокументМД.Реквизиты.Найти("СчетДоверительногоУправления") <> Неопределено);
		
		Если ЕстьРеквизитСчетДоверительногоУправления Тогда
			СчетаДоверительногоУправления = Документ.СчетДоверительногоУправления;	
		ИначеЕсли РаботаСМетаданнымиПовтИсп.ДокументыСРегистрациейПоКлиенту().Получить(ДокументМД.Имя) <> Неопределено Тогда
			СчетаДоверительногоУправления = Документы[ДокументМД.Имя].ПолучитьСвязанныеСчетаДоверительногоУправления(Документ);
		ИначеЕсли ДокументМД.Имя = "РегистрацияФинансовыхПоказателей" Тогда
			Запрет = Документы.РегистрацияФинансовыхПоказателей.ЗапретРедактированияДокумента(Документ, Отказ, СообщатьОбОтказе, ТекстСообщения);
		Иначе
			Запрет = Ложь; // по организации пока не проверяем
		КонецЕсли;
		
	КонецЕсли;
	
	// Корректировку регистров проверим в наборе записей регистров
	
	Если Запрет = Неопределено И ДокументМД.Имя = "КорректировкаРегистров" Тогда
		Запрет = Ложь;
	КонецЕсли;
	
	// У документа рисковиков дату запрета не проверяем
	
	Если Запрет = Неопределено И ДокументМД.Имя = "РегистрацияСведенийОбОценкеИнвестиционныхРисков" Тогда
		Запрет = Ложь;
	КонецЕсли;
	
	// Для документов Акцепт у "МД Траст" не нужно проверять даты запрета, т.к. список акцептов за месяц получают только в середине следующего месяца
	// Также не проверяем акцепты на поручения на вывод активов
	
	Если Запрет = Неопределено
		И ДокументМД.Имя = "Акцепт" 
		И (Документ.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст") 
			Или Документ.ВидАкцепта = Перечисления.ВидыАкцептов.ПоручениеНаВыводАктивов)
	Тогда
		Запрет = Ложь;
	КонецЕсли;
	
	// Документы не относящиеся к бэк-офису или бухгалтерии:
	// пока по ним нет отдельных дат запрета, исключаем из проверки
	
	Если Запрет = Неопределено Тогда 
		
		ДокументыИсключения = Новый Структура();
		ДокументыИсключения.Вставить("Распоряжение");
		ДокументыИсключения.Вставить("Нарушение");
		ДокументыИсключения.Вставить("УстранениеНарушения");
		ДокументыИсключения.Вставить("ИсходящийДокумент");
		ДокументыИсключения.Вставить("СлужебноеРасследование");
		ДокументыИсключения.Вставить("НесоответствиеИнвестиционнойДекларации");
		ДокументыИсключения.Вставить("РегистрацияИнформацииОКонфликтеИнтересов");

		Если ДокументыИсключения.Свойство(ДокументМД.Имя) Тогда
			Запрет = Ложь;
		КонецЕсли;
		
	КонецЕсли; 
	
	// Входящий документ формирует движения только при типе "Входящий документ депозитарной компании",
	// в остальных случаях должны быть доступны для редактирования сам документ и реквизиты № и дата исходящего документа и результат рассмотрения.
	
	Если Запрет = Неопределено
		И ДокументМД.Имя = "ВходящийДокумент"
		И Документ.ТипВходящегоДокумента <> Перечисления.ТипыВходящихДокументов.ВходящийДокументДепозитарнойКомпании
	Тогда
		Запрет = Ложь;
	КонецЕсли;
	
	// Определяем виды учета и группы запрета и проверяем даты запрета по ним
	
	Если Запрет = Неопределено Тогда
		
		ЕстьРеквизитВидУчета = (ДокументМД.Реквизиты.Найти("ВидУчета") <> Неопределено);
		
		МассивИсключений = РаботаСМетаданнымиПовтИсп.ПолучитьИменаДокументовБезДвиженийПоБэкОфису();
		МассивИсключений.Добавить("ЗакрытиеБухгалтерскихСчетов");
		МассивИсключений.Добавить("ПоручениеНаПереоценку");
		
		ЭтоБухРезервы = (ДокументМД.Имя = "НачислениеСписаниеРезервов" И Документ.ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
		ДокументыСДвижениямиПоПартиям = Новый Массив;
		ДокументыСДвижениямиПоПартиям.Добавить("ПереоценкаЦенныхБумаг");
		ДокументыСДвижениямиПоПартиям.Добавить("КорректировкаПервоначальногоПризнания");
		ДокументыСДвижениямиПоПартиям.Добавить("ПереоценкаСрочныхКонтрактов");
		Если ЭтоБухРезервы Тогда
			ДокументыСДвижениямиПоПартиям.Добавить("НачислениеСписаниеРезервов");
		КонецЕсли;
		
		СтандартнаяОбработкаПроведения = (МассивИсключений.Найти(ДокументМД.Имя) = Неопределено И ДокументыСДвижениямиПоПартиям.Найти(ДокументМД.Имя) = Неопределено);
		
		Если ДокументМД.Имя = "РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах" Или ДокументМД.Имя = "РегистрацияСведенийОбОценкеИнвестиционныхРисков" Тогда
			// Пока считаем его чисто бэк-офисным
			ЭтоРегламентныйДокумент = Ложь;	
		ИначеЕсли ДокументОбъект = Неопределено Тогда
			// пришли сюда из ПриСозданииФормыНаСервере
			// параметры сеанса и доп. свойства объекта не смотрим, пока проверяем по реквизиту ВидУчета
			ЭтоРегламентныйДокумент = ЕстьРеквизитВидУчета ИЛИ (ДокументМД.Имя = "ПоручениеНаПереоценку") ИЛИ ЭтоБухРезервы;
		Иначе
			// пришли сюда из ПередЗаписью
			// если формируем проводки - параметр сеанса ФормированиеДвиженийПоРегистрамБэкОфиса установлен в Ложь
			// документы ПереоценкаЦенныхБумаг КорректировкаПервоначальногоПризнания также обрабатываем, как регламентные
			ЭтоБухРегистрацияСтоимостиПереоценки = ДокументМД.Имя = "РегистрацияСтоимостиПереоценки" И ЗначениеЗаполнено(Документ.ЦельРасчета) И Документ.ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(Документ.ВидУчета);
			ЭтоРегламентныйДокумент = Не ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса Или Не СтандартнаяОбработкаПроведения Или ЭтоБухРегистрацияСтоимостиПереоценки;
		КонецЕсли; 
		
		ТаблицаПроверкиЗапретаРедактирования = Неопределено;
		
		ВидыУчетаДляПроведения = Новый Массив;
		
		Если ЭтоРегламентныйДокумент Тогда
			
			Если Не (ДокументОбъект = Неопределено Или ДокументОбъект.ДополнительныеСвойства.Свойство("ВидыУчетаДляПроведения", ВидыУчетаДляПроведения)) Тогда
				// помещаем массив видов учета из доп. свойства объекта в массив ВидыУчетаДляПроведения
				// доп. свойство может остуствовать при приведении документа, в котором реализован нестандартный обработчик проведения, например, ПереоценкаЦенныхБумаг
				ВидыУчетаДляПроведения = Новый Массив;
			КонецЕсли;
			
			Если ЕстьРеквизитВидУчета И ВидыУчетаДляПроведения.Найти(Документ.ВидУчета) = Неопределено Тогда
				// добавим реквизит ВидУчета из шапки документа
				ВидыУчетаДляПроведения.Добавить(Документ.ВидУчета);
			КонецЕсли; 
			
			// #ТехническийДолг в документе реквизит "ЦельРасчета" нужно удалить, а "ВидУчета" - добавить
			Если ДокументМД.Имя = "ПоручениеНаПереоценку" ИЛИ ДокументМД.Имя = "НачислениеСписаниеРезервов" Тогда
				ВидыУчетаДляПроведения.Добавить(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
			КонецЕсли;
			
			Если ВидыУчетаДляПроведения.Количество() = 0 Тогда
				
				Запрет = Истина;
				
				ВидОперации	   = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, "Проведение", "Редактирование");
				ТекстСообщения = СтрШаблон("%1 документа запрещено, т.к. не удалось определить виды учета. Возможно, отсутствуют права на проведение документа", ВидОперации);
				
				Если СообщатьОбОтказе Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Документ);
				КонецЕсли;
				
			Иначе
				
				ГруппыЗапретаРедактирования = Новый Массив;
				ГруппыЗапретаРедактирования.Добавить(Перечисления.ГруппыЗапретаРедактирования.Проводки);
				
				Если Не ДокументыСДвижениямиПоПартиям.Найти(ДокументМД.Имя) = Неопределено Тогда
					ГруппыЗапретаРедактирования.Добавить(Перечисления.ГруппыЗапретаРедактирования.Партии);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ДокументМД.Имя = "РасчетНДФЛ" Тогда
				
				// Расчет НДФЛ не бэкофисный документ  
				
				ВидыУчетаДляПроведения.Добавить(Перечисления.ВидыУчета.НалоговыйУчет);
				ГруппыЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.Проводки;
				
			ИначеЕсли ДокументМД.Имя = "РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах" Тогда
				
				ТаблицаПроверкиЗапретаРедактирования = РаботаСМетаданнымиПовтИсп.МенеджерОбъектаМетаданных(ДокументМД.ПолноеИмя()).ПолучитьТаблицуПроверкиДатЗапретаРедактирования(Документ);
				
			Иначе
				
				ВидыУчетаДляПроведения.Добавить(Перечисления.ВидыУчета.ПустаяСсылка());
				ГруппыЗапретаРедактирования = Перечисления.ГруппыЗапретаРедактирования.БэкОфис;		
				
			КонецЕсли; 
			
		КонецЕсли;	

		Если Запрет = Неопределено Тогда
		
			// Если таблица проверки не переопределена, заполняем алгоритмом по умолчанию
			
			Если ТаблицаПроверкиЗапретаРедактирования = Неопределено Тогда
				
				ТаблицаПроверкиЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьТаблицуПроверкиДатЗапретаРедактирования();
				
				Если ТипЗнч(СчетаДоверительногоУправления) <> Тип("Массив") Тогда
					СчетаДоверительногоУправления = РаботаСКоллекциями.ЗначениеВМассив(СчетаДоверительногоУправления);
				КонецЕсли;
				
				Если ТипЗнч(ГруппыЗапретаРедактирования) <> Тип("Массив") Тогда
					ГруппыЗапретаРедактирования = РаботаСКоллекциями.ЗначениеВМассив(ГруппыЗапретаРедактирования);
				КонецЕсли;
				
				Для Каждого СчетДоверительногоУправления Из СчетаДоверительногоУправления Цикл 
					Для Каждого ГруппаЗапрета Из ГруппыЗапретаРедактирования Цикл
						Если ГруппаЗапрета = Перечисления.ГруппыЗапретаРедактирования.БэкОфис Тогда
							РегистрыСведений.ДатыЗапретаРедактирования.ДобавитьСтрокуВТаблицуПроверкиДатЗапретаРедактирования(
								ТаблицаПроверкиЗапретаРедактирования, ГруппаЗапрета, , Документ.Организация, СчетДоверительногоУправления, Документ.Дата);
						Иначе
							Для Каждого ВидУчета Из ВидыУчетаДляПроведения Цикл
								РегистрыСведений.ДатыЗапретаРедактирования.ДобавитьСтрокуВТаблицуПроверкиДатЗапретаРедактирования(
									ТаблицаПроверкиЗапретаРедактирования, ГруппаЗапрета, ВидУчета, Документ.Организация, СчетДоверительногоУправления, Документ.Дата);
							КонецЦикла;
						КонецЕсли;	
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
			
			// Непосредственно проверка по таблице	
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ТаблицаПроверки.Организация КАК Организация,
				|	ТаблицаПроверки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	ТаблицаПроверки.ГруппаЗапрета КАК ГруппаЗапрета,
				|	ТаблицаПроверки.ВидУчета КАК ВидУчета,
				|	ТаблицаПроверки.Период КАК Период
				|ПОМЕСТИТЬ _ТаблицаПроверки
				|ИЗ
				|	&ТаблицаПроверки КАК ТаблицаПроверки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	МАКСИМУМ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования) КАК ДатаЗапретаРедактирования
				|ИЗ
				|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПроверки КАК _ТаблицаПроверки
				|		ПО (_ТаблицаПроверки.Организация = ДатыЗапретаРедактирования.Организация)
				|			И (_ТаблицаПроверки.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления)
				|			И (_ТаблицаПроверки.ГруппаЗапрета = ДатыЗапретаРедактирования.ГруппаЗапрета)
				|			И (_ТаблицаПроверки.ВидУчета = ДатыЗапретаРедактирования.ВидУчета)
				|			И (_ТаблицаПроверки.Период <= ДатыЗапретаРедактирования.ДатаЗапретаРедактирования)
				|
				|СГРУППИРОВАТЬ ПО
				|	ДатыЗапретаРедактирования.СчетДоверительногоУправления");

			Запрос.УстановитьПараметр("ТаблицаПроверки", ТаблицаПроверкиЗапретаРедактирования);	
			
			РезультатЗапроса = Запрос.Выполнить();
				
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Запрет = Истина; 
				
				ВсеСчетаДУ = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
				
				ТекстСообщения = "Редактирование документа запрещено, т.к. его дата меньше либо равна дате запрета редактирования";
				
				Если СообщатьОбОтказе Тогда
					
					Если Не ЕстьРеквизитСчетДоверительногоУправления Тогда
						ТекстСообщения = ТекстСообщения + " " + СтрСоединить(ВсеСчетаДУ, ", ");		
					КонецЕсли;
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Документ, "Дата");
					
				Иначе
					
					НавигационныеСсылки = Новый Массив;
					
					Для Каждого СчетДУ Из ВсеСчетаДУ Цикл
						НавигационныеСсылки.Добавить(ПолучитьНавигационнуюСсылку(СчетДУ));		
					КонецЦикла;
					
					ТекстСообщения = Новый ФорматированнаяСтрока(ТекстСообщения, , , , СтрСоединить(НавигационныеСсылки, "|"));
					
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	// Итоговый результат
	
	Если Запрет = Истина Тогда
		
		Отказ = Истина;
		
		Если ДокументОбъект <> Неопределено Тогда
			ДокументОбъект.ДополнительныеСвойства.Вставить("ОшибкаЗапретаРедактированияДокумента", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ?(Запрет = Истина, Истина, Ложь); // При Неопределено считаем, что запрета нет 
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗаписью(Документ) Экспорт
	
	ЗапомнитьТекущиеРеквизитыДокумента(Документ);
	
	УстановитьВремяНовогоДокумента(Документ);
	
КонецПроцедуры // ПередЗаписью

Функция ИзмененыРеквизитыШапкиДокумента(Документ, Знач РеквизитыШапки, ИсключаемыеПоляШапки = "", ЭтоАкцептование = Ложь) Экспорт
		
	Если Документ.ДополнительныеСвойства.Свойство("ПредЗначенияРеквизитовШапки") Тогда
		ПредЗначенияРеквизитовШапки = Документ.ДополнительныеСвойства.ПредЗначенияРеквизитовШапки;	
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для документа " + Документ + " нет возможности проверить изменялись ли реквизиты.", Документ,,,);		
		Возврат Ложь;
	КонецЕсли; 
	
	ИсключаемыеПоляШапки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсключаемыеПоляШапки,, Истина, Истина);	
	ИсключаемыеПоляШапки.Добавить("Ссылка");
	ИсключаемыеПоляШапки.Добавить("ВерсияДанных");
	ИсключаемыеПоляШапки.Добавить("Ответственный");
	ИсключаемыеПоляШапки.Добавить("Комментарий");
		
	// всегда сверяем статус проведения
	Если Документ.Проведен <> ПредЗначенияРеквизитовШапки.Проведен Тогда
		Возврат Истина;
	КонецЕсли;
	
	// проверяем прочие реквизиты
	Если ТипЗнч(РеквизитыШапки) <> Тип("Массив") Тогда
		РеквизитыШапки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(РеквизитыШапки,, Истина, Истина);		
	КонецЕсли; 
	
	Для каждого Реквизит Из РеквизитыШапки Цикл
		Если ИсключаемыеПоляШапки.Найти(Реквизит) = Неопределено Тогда
			Если Документ[Реквизит] <> ПредЗначенияРеквизитовШапки[Реквизит] Тогда
				//Если это акцептование и время документа двинулось вперед внутри рабочего дня, то норм 
				Если ЭтоАкцептование и (Реквизит = "Дата") и (НачалоДня(Документ[Реквизит]) = НачалоДня(ПредЗначенияРеквизитовШапки[Реквизит]))
					и Документ[Реквизит] > ПредЗначенияРеквизитовШапки[Реквизит] Тогда
		                 Продолжить;
					КонецЕсли; 
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоПервыйВводАктивов(Документ)

	ТипДокумента = ТипЗнч(Документ);
	Если ТипДокумента <> Тип("ДокументОбъект.ВводДенежныхСредств")
		И ТипДокумента <> Тип("ДокументОбъект.ВводКредитногоИнструмента")
		И ТипДокумента <> Тип("ДокументОбъект.ВводЦенныхБумаг")
	Тогда
		Возврат Ложь;	
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВводыВыводыАктивовВВалютеУчета.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Документ.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ЗапомнитьТекущиеРеквизитыДокумента(Документ)
	
	ЭтоНовыйДокумент = Документ.ЭтоНовый();
	
	Документ.ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовыйДокумент);
	Документ.ДополнительныеСвойства.Вставить("ЭтоПервыйВводАктивов", ЭтоПервыйВводАктивов(Документ));

	Если ЭтоНовыйДокумент Тогда
		Возврат;
	КонецЕсли;
	
	ЗнчРеквизитовШапки = Новый Структура();
	
	ИсключаемыеПоляШапки = Новый Массив();
	ИсключаемыеПоляШапки.Добавить("Ссылка");
	ИсключаемыеПоляШапки.Добавить("ВерсияДанных");
	ИсключаемыеПоляШапки.Добавить("Ответственный");
	ИсключаемыеПоляШапки.Добавить("Комментарий");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ШапкаДокумента.*
		|ИЗ
		|	" + Документ.Метаданные().ПолноеИмя() + " КАК ШапкаДокумента
		|ГДЕ
		|	ШапкаДокумента.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если ИсключаемыеПоляШапки.Найти(Колонка.Имя) = Неопределено Тогда
				ЗнчРеквизитовШапки.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Документ.ДополнительныеСвойства.Вставить("ПредЗначенияРеквизитовШапки", ЗнчРеквизитовШапки);
	
КонецПроцедуры // ЗапомнитьТекущиеРеквизитыДокумента

// Новые документы, введенные раньше или позже границ дня 09:30—20:30:00
// автоматически приводятся к ближайшей границе
//
// Параметры:
//   Документ - ДокументОбъект
//
Процедура УстановитьВремяНовогоДокумента(Документ)
	
	Если Документ.ЭтоНовый() Тогда
		Документ.Дата = ПолучитьВремяДокумента(Документ.Дата, Документ.Ссылка);				
	КонецЕсли;
	
КонецПроцедуры // УстановитьВремяНовогоДокумента

// Возвращает период рабочего времени для документов бэк-офиса
Функция ПериодРабочегоВремениДня() Экспорт
	
	// 9:30 - 20:30
	Возврат Новый Структура("ВремяНачала, ВремяОкончания", 9.5 * 60 * 60, 20.5 * 60 * 60);
	
КонецФункции

// Используется и для контроля интерактивного изменения даты/времени документа.
// Границы рабочего времени: 09:30—20:30:00
Функция ПолучитьВремяДокумента(ДатаДокумента, ДокументСсылка) Экспорт
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Если ПроверитьВидДокумента(ТипДокумента, "ВходящийДокумент")
		ИЛИ ПроверитьВидДокумента(ТипДокумента, "ИсходящийДокумент")
	Тогда
		Возврат ДатаДокумента;
	КонецЕсли; 
	
	// Если у документа установлено доп. сведение РазрешитьВремяДокументаЗаГраницамиРабочихЧасов = Истина,
	// его время не изменяем
	Если ЗначениеЗаполнено(ДокументСсылка) И ДляДокументаРазрешеноНерабочееВремя(ДокументСсылка) Тогда
		Возврат ДатаДокумента;
	КонецЕсли;
	
	РабочиеЧасы = ПериодРабочегоВремениДня();
	
	// Регламентные документы - в конец дня
	// У связанных документов "НачислениеРезервовПИФ" и "РегистрацияСтоимостиПереоценки" время берется
	// из документа "РегистрацияСтоимостиАктивов", отдельно их обрабатывать не нужно.
	
	Если ПроверитьВидДокумента(ТипДокумента, "РегистрацияСтоимостиАктивов") 
		ИЛИ ПроверитьВидДокумента(ТипДокумента, "РегистрацияФинансовыхПоказателей")
		ИЛИ ПроверитьВидДокумента(ТипДокумента, "ОперацияНДС")
	Тогда
	    Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания; // 20:30:00
	КонецЕсли;		

	Если ПроверитьВидДокумента(ТипДокумента, "НачислениеСписаниеРезервов") Тогда
	    Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания + 1; // 20:30:01 чтобы гарантированно был позднее всех переоценок
	КонецЕсли;		
	
	// Реклассификация при переходе на МСФО9 01.01.2025 00:00:00
	
	Если ПроверитьВидДокумента(ТипДокумента, "РеклассификацияАктивовЕПС") И НачалоДня(ДатаДокумента) = '20250101' Тогда
		Возврат НачалоДня(ДатаДокумента); // 00:00:00
	КонецЕсли;
	
	// Прочие должны попадать в границы рабочего времени 09:30 - 20:30
	
	Если ДатаДокумента < НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяНачала Тогда // 9:30
		
		Если ПроверитьВидДокумента(ТипДокумента, "Оплата")
			ИЛИ ПроверитьВидДокумента(ТипДокумента, "ВыводДенежныхСредств")
			ИЛИ ПроверитьВидДокумента(ТипДокумента, "ВыводЦенныхБумаг")
		Тогда
			Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяНачала + 1; // 9:30:01
		ИначеЕсли ПроверитьВидДокумента(ТипДокумента, "ПереоценкаВалютныхЦенностей") И ДатаДокумента >= '20240501'
		Тогда
		    Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяНачала - 60 * 60; // 8:30:00	
		Иначе
			Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяНачала; // 9:30:00
		КонецЕсли;	
		
	ИначеЕсли ДатаДокумента > НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания Тогда // 20:30:00
		
		Если ПроверитьВидДокумента(ТипДокумента, "НачислениеЗадолженности")
			ИЛИ ПроверитьВидДокумента(ТипДокумента, "ПоручениеНаДвижениеДенежныхСредств")
			ИЛИ ПроверитьВидДокумента(ТипДокумента, "ПоручениеНаДвижениеЦенныхБумаг")
		Тогда
			Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания - 1; // 20:29:59
		ИначеЕсли ПроверитьВидДокумента(ТипДокумента, "ПереоценкаВалютныхЦенностей") И ДатаДокумента >= '20240501' 
		Тогда
		    Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания + 60 * 60; // 21:30:00	
		Иначе
			Возврат НачалоДня(ДатаДокумента) + РабочиеЧасы.ВремяОкончания; // 20:30:00	
		КонецЕсли;		
		
	КонецЕсли; 
	
	Возврат ДатаДокумента;
	
КонецФункции

Функция ПроверитьВидДокумента(ТипЗначения, ВидДокумента)
	
	Возврат (ТипЗначения = Тип("ДокументСсылка." + ВидДокумента) ИЛИ ТипЗначения = Тип("ДокументОбъект." + ВидДокумента));	
	
КонецФункции

Функция ДляДокументаРазрешеноНерабочееВремя(ДокументСсылка) 
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект = &Объект
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = ""РазрешитьВремяДокументаЗаГраницамиРабочихЧасов""
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА");
	
	Запрос.УстановитьПараметр("Объект", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

