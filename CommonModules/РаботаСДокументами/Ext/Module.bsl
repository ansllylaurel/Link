Функция ЗапрещенПрямойПереводНаСчетаБиржи(Объект, Отказ) Экспорт
	
	// Для клиентов ПФР и ГСК Югория нельзя переводить дс напрямую с расчетных счетов на биржевые секции если у брокера не доступна роль "Банк"
	// Все переводы с расчетных счетов на биржу и наоборот должны осуществляться через внебиржу брокера.
	Если Не ДействуетКонтрольПрямыхПереводНаСчетаБиржи(Объект.СчетДоверительногоУправления) Тогда
		Возврат Ложь;	
	КонецЕсли;
		
	Если Объект.Брокер <> Объект.БрокерПолучатель И (НеобходимКонтрольПереводовБрокера(Объект.Брокер) И Объект.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок 
		Или НеобходимКонтрольПереводовБрокера(Объект.БрокерПолучатель) И Объект.МестоХраненияПолучатель <> Справочники.МестаХранения.ВнебиржевойРынок) Тогда 
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета доверительного управления [" + Объект.СчетДоверительногоУправления + "] запрещены прямые вводы/выводы денежных средств с биржевых секций. Переводы должны осуществляться через внебиржевую секцию брокера!",,,, Отказ);
		Возврат Истина;
		
	Иначе
		Возврат Ложь;		
	КонецЕсли;
	
КонецФункции

Функция ДействуетКонтрольПрямыхПереводНаСчетаБиржи(СчетДоверительногоУправления) Экспорт
	
	Возврат ЗначениеЗаполнено(СчетДоверительногоУправления) И (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ГСК_ЮГОРИЯ"));
	
КонецФункции
	
Функция НеобходимКонтрольПереводовБрокера(Брокер) Экспорт
	//Если Юрфиз лицу брокерской компании доступна роль банка - не нужно контролировать переводы с/на счета брокера
	Возврат (ЗначениеЗаполнено(Брокер) И Не ЗначениеЗаполнено(Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Брокер.ЮрФизЛицо, "Банки")));
	    
КонецФункции

// Проверяет обязательные реквизиты у поручений на движение ДС, вводов и выводов ДС по договорам НПФ
//	Параметры
//		Объект - ДокументОбъект - проверяемый документ
//		Отказ  - Булево
//
Процедура ПроверитьРеквизитыВводаВыводаДенежныхСредств(Объект, Отказ) Экспорт
	
	ТипДокумента = ТипЗнч(Объект);
	Если Не (ТипДокумента = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств")
			Или ТипДокумента = Тип("ДокументОбъект.ВводДенежныхСредств")
			Или ТипДокумента = Тип("ДокументОбъект.ВыводДенежныхСредств")) Тогда
		Возврат;
	КонецЕсли;
	
	// Для портфелей НПФ не проводим без заполнения обязательных реквизитов
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если Объект.Дата >= ДатаНачалаПроверкиЗаполненияКонтрагентаВоВводахВыводахДенежныхСредствИЦенныхБумагКлиентовНПФ() 
			И (ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
			Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
			Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов) Тогда
			
	    ТекстОшибки = "";
		Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ТекстОшибки = "Не указан контрагент";
		КонецЕсли;
		
		Если ПустаяСтрока(Объект.КонтрагентДоговорТекстом) Тогда
			ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + "Не заполнен текст контрагента";
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств") Тогда			
			Если Объект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская 
				И Не Объект.ПоручениеНаПереводМеждуСчетамиДУ 
				И Не ЗначениеЗаполнено(Объект.РасчетныйСчетПолучатель) Тогда
				ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + "Не заполнен расчетный счет контрагента";
			КонецЕсли;   			
		ИначеЕсли Не ЗначениеЗаполнено(Объект.РасчетныйСчетКонтрагента) Тогда
			ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + "Не заполнен расчетный счет контрагента";
		КонецЕсли;
		
		// Временно отключена проверка, т. к. допник не еще не подписан
		//Если ТипДокумента <> Тип("ДокументОбъект.ВыводДенежныхСредств") Тогда
		//	// Проверяем номер и дату входящего документа (в выводе этих реквизитов нет)
		//	Если ПустаяСтрока(Объект.НомерВходящегоДокумента) Тогда
		//		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + "Не указан номер входящего документа";
		//	КонецЕсли;	
		//	Если Объект.ДатаВходящегоДокумента = '00010101' Тогда
		//		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + "Не указана дата входящего документа";
		//	КонецЕсли;	                                                                  			
		//КонецЕсли;		
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка,,, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры	

Функция СчетДоверительногоУправленияПоЛицензииПоУправлениюЦеннымиБумагами(Дата, СчетДоверительногоУправления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",							Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ЕСТЬNULL(МАКСИМУМ(ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует), ЛОЖЬ) КАК НужнаПроверка
	    |ИЗ
	    |	РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(
	    |			&Период,
	    |			СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				И Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НужнаПроверка;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#Область Согласование_поручений_на_вывод_активов

// Возвращает дату, с которой запущен механизм согласования поручений на вывод активов
Функция ДатаНачалаСогласованияПорученийНаВыводАктивов() Экспорт
	
	Возврат '20221021';
	
КонецФункции	

// Проверяет, требуется ли согласовывать поручение на вывод активов
//
// Параметры:
// 	РеквизитыПоручения - Структура с реквизитами поручения на вывод денежных средств или ценных бумаг
//						 либо объект документа такого поручения
Функция ТребуетсяСогласованиеПорученияНаВыводАктивов(РеквизитыПоручения) Экспорт
	
	// Документы по ИИС, а также поручения на ввод активов не нужно согласовывать
	// Кроме этого, согласование применяется только в РЭМе и Трасте
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыПоручения.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	УК_РЭМ = РеквизитыПоручения.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	УК_Траст = РеквизитыПоручения.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
	
	//Клиентский отдел согласовывает поручения физ.лиц
	// + при наличии свойства формируется оповещение для клиентского отдела (при проведении, изменении, отмене проведения).
	Если ТипЗнч(РеквизитыПоручения) = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств")
		И РеквизитыПоручения.СпособПередачи <> Перечисления.СпособыПередачиПоручений.ВнутренняяСистема 
		И ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица Тогда 
					
		РеквизитыПоручения.ДополнительныеСвойства.Вставить("ТребуетсяПодтверждениеКлиентскогоОтдела");
			
		Если РеквизитыПоручения.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;

	Если РеквизитыПоручения.Дата < ДатаНачалаСогласованияПорученийНаВыводАктивов() 
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет 
		Или РеквизитыПоручения.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская 
		Или Не (УК_РЭМ Или УК_Траст) 
		Или Не РеквизитыПоручения.Проведен Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(РеквизитыПоручения) = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств") Тогда
		РеквизитыПоручения.ДополнительныеСвойства.Вставить("ТребуетсяСогласованиеПорученияНаВыводАктивов");
	КонецЕсли;
			
	Возврат Истина;
		
КонецФункции

// Проверяет, отменен ли бизнес-процесс согласования поручения
//
// 	Параметры:
//		- ДокументСсылка - ссылка на документ ПоручениеНаДвижениеДенежныхСредств, ПоручениеНаДвижениеЦенныхБумаг
//
Функция ПоручениеНаВыводАктивовОтменено(ДокументСсылка) Экспорт 
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованиеПорученийНаВыводАктивов.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.СогласованиеПорученийНаВыводАктивов КАК СогласованиеПорученийНаВыводАктивов
		|ГДЕ
		|	СогласованиеПорученийНаВыводАктивов.Организация = &Организация
		|	И СогласованиеПорученийНаВыводАктивов.Основание = &Основание
		|	И НЕ СогласованиеПорученийНаВыводАктивов.ПометкаУдаления
		|	И СогласованиеПорученийНаВыводАктивов.Отменен
		|
		|УПОРЯДОЧИТЬ ПО
		|	СогласованиеПорученийНаВыводАктивов.Отменен");

	Запрос.УстановитьПараметр("Основание",		ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация"));
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Получает карту маршрута бизнес-процесса согласования поручения на вывод денежных средств или ценных бумаг
//
//	Параметры:
//		ДокументСсылка - ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств, ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг - поручение на согласовании
// 		Организация - Организация
//
Функция ПолучитьКартуСогласованияПорученияНаВыводАктивов(ДокументСсылка, Организация) Экспорт
		
	//Ищем бизнес-процесс согласования этого поручения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованиеПорученийНаВыводАктивов.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.СогласованиеПорученийНаВыводАктивов КАК СогласованиеПорученийНаВыводАктивов
		|ГДЕ
		|	СогласованиеПорученийНаВыводАктивов.Организация = &Организация
		|	И СогласованиеПорученийНаВыводАктивов.Основание = &Основание
		|	И НЕ СогласованиеПорученийНаВыводАктивов.ПометкаУдаления
		|	И СогласованиеПорученийНаВыводАктивов.Стартован
		|
		|УПОРЯДОЧИТЬ ПО
		|	СогласованиеПорученийНаВыводАктивов.Отменен";
	
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("Основание",		ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект().ПолучитьКартуМаршрута();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
	
#КонецОбласти

#Область Сверка_со_списком_недействительных_паспортов

// Возвращает дату, с которой полностью запущен механизм сверки со списком недействительных паспортов
Функция ДатаНачалаСверкиСоСпискомНедействительныхПаспортов() Экспорт
	
	Возврат '20230217';
	
КонецФункции	

// Запускает отложенную сверку со списком недействительных паспортов 
// из документов ПоручениеНаДвижениеДенежныхСредств, ПоручениеНаДвижениеЦенныхБумаг
//
//	Параметры: 
//		- ДокументОбъект 	- объект документа ПоручениеНаДвижениеДенежныхСредств или ПоручениеНаДвижениеЦенныхБумаг
//
Процедура ВыполнитьСверкуСоСпискомНедействительныхПаспортовОтложенноПоПоручениюНаВыводАктивов(ДокументОбъект) Экспорт
	
	Если Не ((ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоручениеНаДвижениеДенежныхСредств")
		Или ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоручениеНаДвижениеЦенныхБумаг")) 
		И ДокументОбъект.Дата > ДатаНачалаСверкиСоСпискомНедействительныхПаспортов()) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументОбъект.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Или ДокументОбъект.ВыводВсехАктивов Тогда
		
		МассивЮрФизЛиц = МассивЮрФизЛицДляСверкиСоСпискомНедействительныхПаспортов(ДокументОбъект.СчетДоверительногоУправления, ДокументОбъект.Контрагент, ДокументОбъект.Дата);
		
		// В массиве не более двух элементов
		Для Каждого ЮрФизЛицо Из МассивЮрФизЛиц Цикл
			РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомНедействительныхПаспортовОтложенно(ДокументОбъект.Организация, ЮрФизЛицо);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

// Проверяет результат отложенной сверки со списком недействительных паспортов
// из документов ВыводДенежныхСредств, ВыводЦенныхБумаг
//
//	Параметры: 
//		- ДокументОбъект 	- объект документа ВыводДенежныхСредств или ВыводЦенныхБумаг
//
Функция ПройденаОтложеннаяСверкаСоСпискомНедействительныхПаспортовПриВыводеАктивов(ДокументОбъект) Экспорт
	
	// Проверяем только выводы ДС и ЦБ
	ТипДокумента = ТипЗнч(ДокументОбъект);
	Если Не ((ТипДокумента = Тип("ДокументОбъект.ВыводДенежныхСредств")
		Или ТипДокумента = Тип("ДокументОбъект.ВыводЦенныхБумаг"))
		И ДокументОбъект.Дата > ДатаНачалаСверкиСоСпискомНедействительныхПаспортов()) Тогда
		Возврат Истина;
	КонецЕсли;
		
	Поручение = ?(ТипДокумента = Тип("ДокументОбъект.ВыводДенежныхСредств"), ДокументОбъект.Основание, ДокументОбъект.Поручение);
	
	Отказ = Ложь;	
	
	МассивЮрФизЛиц = МассивЮрФизЛицДляСверкиСоСпискомНедействительныхПаспортов(ДокументОбъект.СчетДоверительногоУправления, ДокументОбъект.Контрагент, ДокументОбъект.Дата);
	
	// В массиве не более двух элементов
	Для Каждого ЮрФизЛицо Из МассивЮрФизЛиц Цикл
		РегистрыСведений.ЖурналСверкиСоСписками.ПроверитьРезультатОтложеннойСверкиСоСпискомНедействительныхПаспортов(
					ДокументОбъект.Организация, 
					ЮрФизЛицо, 
					НачалоДня(ДокументОбъект.Дата),
					НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поручение, "Дата")),				
					Отказ);			
	КонецЦикла;					
					
	Возврат Не Отказ;
	
КонецФункции

// Возвращает массив из одного или двух элементов справочника юр./физ. лиц для сверки со списком недействительных паспортов при выводе активов
// 
//	Параметры:
//		- СчетДоверительногоУправления 	- владелец активов
//		- Контрагент 					- юр./физ. лицо, которому выводятся активы
//		- Дата 							- дата вывода или поручения на вывод
//
Функция МассивЮрФизЛицДляСверкиСоСпискомНедействительныхПаспортов(СчетДоверительногоУправления, Контрагент, Дата)
	
	// Для умершего клиента проверяем паспорт контрагента
	// Если клиент жив, но активы выводятся другому физ. лицу, проверяем паспорта обоих
	
	МассивЮрФизЛицДляПроверки = Новый Массив;
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата);
	Если Справочники.СчетаДоверительногоУправления.ЭтоУмершийКлиент(СчетДоверительногоУправления, Дата) Тогда
		МассивЮрФизЛицДляПроверки.Добавить(Контрагент);
	ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		МассивЮрФизЛицДляПроверки.Добавить(Контрагент);
	ИначеЕсли Клиент <> Контрагент Тогда
		МассивЮрФизЛицДляПроверки.Добавить(Контрагент);
		МассивЮрФизЛицДляПроверки.Добавить(Клиент);
	Иначе
		МассивЮрФизЛицДляПроверки.Добавить(Клиент);
	КонецЕсли;
	
	Возврат МассивЮрФизЛицДляПроверки;
	
КонецФункции

#КонецОбласти

#Область Поручения_и_вводы_выводы_активов

Процедура ПроверитьВозможностьСозданияПодчиненногоДокументаНаОснованииПоручения(Объект, Отказ) Экспорт
	
	ТекстСообщения = "";
	ПоручениеСсылка = Неопределено;
	ОбъектСсылка = Объект.Ссылка;
	ТипДокумента = ТипЗнч(ОбъектСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ВводДенежныхСредств") Или ТипДокумента = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
		ПоручениеСсылка = Объект.Основание;			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыводЦенныхБумаг") Или ТипДокумента = Тип("ДокументСсылка.СписаниеЗадолженностейПоПоручению") Тогда
     	ПоручениеСсылка = Объект.Поручение;		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПоручениеСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не (ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Или ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг")) Тогда
		Возврат;
	КонецЕсли;
	
	//1. Если поручение на вывод денежных средств или ценных бумаг:
	//		1.1 Нельзя создавать вывод активов, если поручение не согласовано
	Если (ТипДокумента = Тип("ДокументСсылка.ВыводДенежныхСредств") Или ТипДокумента = Тип("ДокументСсылка.ВыводЦенныхБумаг")) Тогда
		
		РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоручениеСсылка, "Дата, Организация, СчетДоверительногоУправления, ТипЗадолженности, Проведен");
		РеквизитыПоручения.Вставить("Ссылка", ПоручениеСсылка);
		
		Если ТребуетсяСогласованиеПорученияНаВыводАктивов(РеквизитыПоручения)
			И Не ПоручениеНаВыводАктивовСогласовано(ПоручениеСсылка, ТекущаяДата()) Тогда
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя создавать документ вывода активов, пока поручение не согласовано",,,, Отказ);
			Возврат;
			
		КонецЕсли;
	
	КонецЕсли;
		
	ВыводВсехАктивов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеСсылка, "ВыводВсехАктивов");
	
	//	1.2 для поручения на движение ЦБ, если это не вывод всех активов, нельзя создавать ввод/вывод денежных средств
	Если ТипЗнч(ПоручениеСсылка) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг") 
		И (Не ВыводВсехАктивов)
		И (ТипДокумента = Тип("ДокументСсылка.ВводДенежныхСредств") Или ТипДокумента = Тип("ДокументСсылка.ВыводДенежныхСредств")) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя создавать документ ввода/вывода денежных средств на основании поручения на движение ценных бумаг",,,, Отказ);
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(ПоручениеСсылка) <> Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
		Возврат;
	КонецЕсли;
	
	//2. Если поручение на вывод всех активов:
	//		2.1 нельзя создавать ввод денежных средств.
	//		2.2 нельзя создавать списание задолженности, если на основании поручения уже создан вывод ДС/ЦБ.
	//		2.3 нельзя создавать выводы ДС/ЦБ, если на основании поручения создано списание задолженности (отмена поручения).
	//3. Если поручение НЕ на вывод всех активов:
	//		3.1 нельзя создавать вывод ценных бумаг.
	//		3.2 нельзя создавать подчиненные документы при отсутствии задолженности по поручению.   	
		
	Если ВыводВсехАктивов Тогда
		
		Если ТипЗнч(Объект) = Тип("ДокументОбъект.ВводДенежныхСредств") Тогда
				
			ТекстСообщения = "Нельзя создавать документ [Ввод денежных средств] на основании поручения на вывод всех активов!";
			
		ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.СписаниеЗадолженностейПоПоручению") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СписаниеЗадолженностейПоПоручению.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
				|ГДЕ
				|	СписаниеЗадолженностейПоПоручению.Проведен
				|	И СписаниеЗадолженностейПоПоручению.Поручение = &Поручение
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	ВыводДенежныхСредств.Ссылка КАК Ссылка 
				|ИЗ
				|	Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
				|ГДЕ
				|	ВыводДенежныхСредств.Проведен
				|	И ВыводДенежныхСредств.Основание = &Поручение
				|
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	ВыводЦенныхБумаг.Ссылка
				|ИЗ
				|	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
				|ГДЕ
				|	ВыводЦенныхБумаг.Проведен
				|	И ВыводЦенныхБумаг.Поручение = &Поручение";
			
			Запрос.УстановитьПараметр("Поручение", ПоручениеСсылка);
				
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл 
				ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", Символы.ПС) + "На основании поручения создан документ [" + Выборка.Ссылка  + "].";	
			КонецЦикла;
								
		Иначе
				
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СписаниеЗадолженностейПоПоручению.Ссылка КАК Ссылка
				|ИЗ
				|	Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
				|ГДЕ
				|	СписаниеЗадолженностейПоПоручению.Проведен
				|	И СписаниеЗадолженностейПоПоручению.Поручение = &Поручение";
			
			Запрос.УстановитьПараметр("Поручение", ПоручениеСсылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", Символы.ПС) + "На основании поручения создан документ [" + Выборка.Ссылка  + "]."; 	
			КонецЦикла;
				
		КонецЕсли;
		
	Иначе
		
		Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
			
			ТекстСообщения = "Документ [Вывод ценных бумаг] можно создавать на основании поручений на вывод всех активов!";
			
		ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.СписаниеЗадолженностейПоПоручению") Тогда
			//У документа нет реквизита сумма, поэтому необходимо проверить задолженность по поручению
			Запрос = Новый Запрос;
			Запрос.Текст = 
	           "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	           |	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СуммаОстаток КАК Сумма
	           |ИЗ
	           |	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
	           |			,
	           |			Основание = &Основание
	           |				И ТипЗадолженности = &ТипЗадолженности) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки
	           |ГДЕ
	           |	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СуммаОстаток > 0";
           
			РеквизитыПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоручениеСсылка, "ТипЗадолженности, Основание");
			
			Запрос.УстановитьПараметр("Основание", ?(ЗначениеЗаполнено(РеквизитыПоручения.Основание), РеквизитыПоручения.Основание, ПоручениеСсылка));
			Запрос.УстановитьПараметр("ТипЗадолженности", РеквизитыПоручения.ТипЗадолженности);
                                                                          
		   Если Запрос.Выполнить().Пустой() Тогда
			   ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", Символы.ПС) + "Отсутствует задолженность денежных средств по поручению.";
           КонецЕсли;
			
		ИначеЕсли Объект.Сумма = 0 Тогда
			//В обработке заполнения данные заполняются из регистра "задолженности дс по поручениям" - если сумма 0, значит задолженность отсутствует.
			ТекстСообщения = "Отсутствует задолженность денежных средств по поручению.";	
				
		КонецЕсли;
			
	КонецЕсли;
	
	Если ТекстСообщения <> "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстКонтрагентаДляВводовВыводовДенежныхСредств(Организация, Контрагент, РасчетныйСчет, ПереводВнутриУК, Дата) Экспорт

	// При переводе между портфелями внутри УК устанавливаем наименование получателя из договора к расчетному счету и номер/дату договора ДУ;
	// иначе - краткое наименование по уставу (для физ. лица - ФИО) контрагента
	
	Если ПереводВнутриУК Тогда
		
		// Определим дату и номер договора ДУ из исполнителя по ДС
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
			|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
			|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
			|ГДЕ
			|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
			|	И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет
			|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Дата
			|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))");
		
		Запрос.УстановитьПараметр("Дата", 			Дата);
		Запрос.УстановитьПараметр("Организация",	Организация);
		Запрос.УстановитьПараметр("РасчетныйСчет", 	РасчетныйСчет);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.НаименованиеВладельцаДляДокументов + ", договор ДУ " + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		Иначе			
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РасчетныйСчет, "Договор.НаименованиеВладельцаДляДокументов");
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(РеквизитыАнкетные.КраткоеНаименованиеПоУставу, Реквизиты.КраткоеНаименованиеПоУставу) КАК Наименование
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|			&Период,
			|			ЮрФизЛицо = &ЮрФизЛицо
			|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК Реквизиты
			|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ЮрФизЛицо = &ЮрФизЛицо
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыАнкетные
			|		ПО (ИСТИНА)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	РеквизитыАнкетные.Фамилия + "" "" + РеквизитыАнкетные.Имя + "" "" + РеквизитыАнкетные.Отчество
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыАнкетные");
		
		Запрос.УстановитьПараметр("Организация", 	Организация);
		Запрос.УстановитьПараметр("Период", 		Дата);
		Запрос.УстановитьПараметр("ЮрФизЛицо", 		Контрагент);
						
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Наименование;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены данные по " + СокрЛП(Контрагент), Контрагент);
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
КонецФункции
					
// Возвращет значение (0, 1, 2) для значения реквизита формы "ТипПередачи"
// для наглядного отражения куда/откуда был введен/выведен актив
//	0 - клиент
//	1 - другой портфель
//	2 - сторонее юр.физ лицо, другая УК
//
Функция ПолучитьТипПередачиДляВводаВыводаАктивов(Дата, Организация, СчетДоверительногоУправления, Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат 0;
	КонецЕсли;
	
	ЮрФизЛицоСчетаДУ = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(СчетДоверительногоУправления, Дата);
	ЮрФизЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо");
		
	Если Контрагент = ЮрФизЛицоСчетаДУ  Тогда
		Возврат 0;		
	ИначеЕсли Контрагент = ЮрФизЛицоОрганизации Тогда
		Возврат 1;
	Иначе	
		Возврат 2;		
	КонецЕсли;
	
КонецФункции

