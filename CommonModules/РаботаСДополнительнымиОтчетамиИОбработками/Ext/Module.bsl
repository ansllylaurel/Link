
Функция ЕстьПравоИнтерактивнойРаботы() Экспорт
	
	// в отличие от типовой конфигурации, мы считаем, что добавлять внешние отчеты и обработки
	// имеет право тот, у кого есть право на их запуск
	
	Возврат Истина; // пока не было времени разобраться, как проверить наличие права на интерактивное открытие внеш. отчетов и обработок
	
КонецФункции

// Возвращает Истина если вид относится к категории глобальных дополнительных отчетов или обработок.
//
// Параметры:
//   Вид - ПеречислениеСсылка.ВидыДополнительныхОтчетовИОбработок - Вид внешней обработки.
//
// Возвращаемое значение: 
//    Истина - обработка относится к категории глобальных
//    Ложь   - обработка относится к категории назначаемых
//
Функция ЭтоГлобальнаяОбработка(Вид) Экспорт
	
	Возврат Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка
		Или Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;
	
КонецФункции

Функция НаименованиеПодсистемы() Экспорт
	
	Возврат НСтр("ru = 'Дополнительные отчеты и обработки'");
	
КонецФункции

Функция НайтиКонфликтующиеИмена(ИмяОбъекта, Вид, Ссылка) Экспорт
	
	КонфликтующиеИмена = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработки.Ссылка,
		|	ДополнительныеОтчетыИОбработки.Представление
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
		|	И ДополнительныеОтчетыИОбработки.Вид = &Вид
		|	И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ
		|	И ДополнительныеОтчетыИОбработки.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("Вид",        Вид);
	Запрос.УстановитьПараметр("Ссылка",     Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КонфликтующиеИмена.Добавить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КонфликтующиеИмена;
	
КонецФункции // НайтиКонфликтующиеИмена

Функция ЗарегистрироватьОбработку(Знач Объект, ИмяФайла, АдресФайла, ЭтоОтчет, ИдентификаторВладельца, ТаблицаДоступныхКоманд) Экспорт
	
	Результат = Новый Структура("ИмяОбъекта, АдресаСкриншотов, Успешно, ИмяОбъектаЗанято, Конфликтующие, ФайлИзменен, КраткоеПредставлениеОшибки");
	Результат.ИмяОбъектаЗанято	= Ложь;
	Результат.Успешно			= Ложь;
	Результат.ФайлИзменен		= Истина;
	
	РегистрационныеДанные = ПолучитьРегистрационныеДанные(Объект, АдресФайла, ЭтоОтчет, ИдентификаторВладельца);
	
	Если РегистрационныеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если      Не Объект.ЭтоНовый() И РегистрационныеДанные.Вид <> Объект.Вид Тогда
		Результат.КраткоеПредставлениеОшибки = НСтр("ru = 'Невозможно сменить вид существующего дополнительного отчета или обработки'");
		Возврат Результат;
	ИначеЕсли ЭтоОтчет <> (РегистрационныеДанные.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет) Тогда
		Результат.КраткоеПредставлениеОшибки = НСтр("ru = 'Вид обработки, указанный в сведениях о внешней обработке, не соответствует её расширению'");
		Возврат Результат;
	КонецЕсли;

	// Проверка уникальности имени
	КонфликтующиеИмена = НайтиКонфликтующиеИмена(РегистрационныеДанные.ИмяОбъекта, РегистрационныеДанные.Вид, Объект.Ссылка);
	
	Если КонфликтующиеИмена.Количество() > 0 Тогда
		Результат.ИмяОбъектаЗанято           = Истина;
		Результат.Конфликтующие              = КонфликтующиеИмена;
		Результат.КраткоеПредставлениеОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Имя объекта ""%1"" занято.'"), РегистрационныеДанные.ИмяОбъекта);
		
		Возврат Результат;
	КонецЕсли;
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	РазмерФайла = ДвоичныеДанныеФайла.Размер();

	CRC32 = Новый ХешированиеДанных(ХешФункция.CRC32);
	CRC32.Добавить(ДвоичныеДанныеФайла);

	// Проверка изменения версии при изменении файла (борьба с кэширование 1С)
	Если Не Объект.ЭтоНовый() И Объект.Версия = РегистрационныеДанные.Версия Тогда
		Если Объект.РазмерФайла <> РазмерФайла Тогда
			Результат.КраткоеПредставлениеОшибки = НСтр("ru = 'Файл был изменен. Необходимо изменить версию в сведениях об отчете (обработке). Это необходимо для борьбы с кешированием 1С, из-за которого возможен вызов старой версии.'");
			Возврат Результат;
		КонецЕсли;
		
		Если Объект.ХешСуммаФайла <> CRC32.ХешСумма Тогда
			Результат.КраткоеПредставлениеОшибки = НСтр("ru = 'Файл был изменен. Необходимо изменить версию в сведениях об отчете (обработке). Это необходимо для борьбы с кешированием 1С, из-за которого возможен вызов старой версии.'");
			Возврат Результат;
		КонецЕсли;
		
		Результат.ФайлИзменен = Ложь;
	КонецЕсли;
	
	// Установим сведения об обработке
	Объект.Наименование         = РегистрационныеДанные.Наименование;
	Объект.ДоступенИнтерактивно = РегистрационныеДанные.ДоступенИнтерактивно;
	Объект.Версия               = РегистрационныеДанные.Версия;
	Объект.Информация           = РегистрационныеДанные.Информация;
	Объект.Вид                  = РегистрационныеДанные.Вид;
	Объект.ИмяОбъекта           = РегистрационныеДанные.ИмяОбъекта;
	Объект.ИмяФайла             = ИмяФайла;
	Объект.РазмерФайла          = РазмерФайла;
	Объект.ХешСуммаФайла        = CRC32.ХешСумма;
	
	// Инициализация команд
	ТаблицаДоступныхКоманд = РегистрационныеДанные.Команды.Скопировать();
	
	// ответственный
	Объект.Ответственный = РаботаСПользователями.ТекущийПользователь();
	
	// финиш
	Результат.Успешно          = Истина;
	Результат.АдресаСкриншотов = РегистрационныеДанные.АдресаСкриншотов;
	
	Возврат Результат;
	
КонецФункции

#Область ИНТЕГРАЦИЯ_С_ВНЕШНИМИ_ОТЧЕТАМИ_И_ОБРАБОТКАМИ

Функция СоздатьТаблицуКоманд() Экспорт
	
	Команды = Новый ТаблицаЗначений;
	
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Модификатор");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Использование");
	
	Возврат Команды;
	
КонецФункции // СоздатьТаблицуКоманд

Функция ДобавитьНовуюКомандуВТаблицу(Команды, ИмяКоманды, Представление, Модификатор, ПоказыватьОповещение, Использование) Экспорт
	
	НоваяКоманда = Команды.Добавить();
	
	НоваяКоманда.Идентификатор        = ИмяКоманды;
	НоваяКоманда.Представление        = Представление;
	НоваяКоманда.Модификатор          = Модификатор;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Использование        = Использование;
	
КонецФункции // ДобавитьНовуюКомандуВТаблицу

Функция ДобавитьНовыйПарамерВТаблицу(Параметры, Имя, Тип, Обязательный) Экспорт
	
	Если ТипЗнч(Параметры) <> Тип("ТаблицаЗначений") Тогда
		Параметры = Новый ТаблицаЗначений;
		
		Параметры.Колонки.Добавить("Имя");
		Параметры.Колонки.Добавить("Тип");
		Параметры.Колонки.Добавить("Обязательный");
	КонецЕсли;
	
	НовыйПараметры = Параметры.Добавить();
	
	НовыйПараметры.Имя          = Имя;
	НовыйПараметры.Тип          = Тип;
	НовыйПараметры.Обязательный = Обязательный;
	
КонецФункции // ДобавитьНовыйПарамерВТаблицу

Функция ПолучитьПараметрыКоманды(ВнешнийОбъект, ИдентификаторКоманды, ГруппаПараметров = Неопределено) Экспорт
	
	ПараметрыКоманды = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработкиПараметры.Имя КАК Имя,
		|	ДополнительныеОтчетыИОбработкиПараметры.Значение КАК Значение
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Параметры КАК ДополнительныеОтчетыИОбработкиПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
		|		ПО ДополнительныеОтчетыИОбработкиПараметры.Ссылка = ДополнительныеОтчетыИОбработкиКоманды.Ссылка
		|			И ДополнительныеОтчетыИОбработкиПараметры.Группа = ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров
		|ГДЕ
		|	ДополнительныеОтчетыИОбработкиПараметры.Ссылка = &Ссылка
		|	И ДополнительныеОтчетыИОбработкиКоманды.Идентификатор = &Идентификатор
		|	И &ГруппаПараметров";
		
	Запрос.УстановитьПараметр("Ссылка",        	ВнешнийОбъект);
	Запрос.УстановитьПараметр("Идентификатор", 	ИдентификаторКоманды);
	
	Если ГруппаПараметров = Неопределено Тогда
		Запрос.УстановитьПараметр("ГруппаПараметров", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ГруппаПараметров", "ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров = &ГруппаПараметров");
		Запрос.УстановитьПараметр("ГруппаПараметров", ГруппаПараметров);
	КонецЕсли; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ПараметрыКоманды.Свойство(Выборка.Имя) Тогда
			
			ТекущееЗначение = ПараметрыКоманды[Выборка.Имя];
			
			Если ТипЗнч(ТекущееЗначение) = Тип("Массив") Тогда
				ТекущееЗначение.Добавить(Выборка.Значение)
			Иначе
				МассивЗначений = Новый Массив;
				МассивЗначений.Добавить(ТекущееЗначение);
				МассивЗначений.Добавить(Выборка.Значение);
				
				ПараметрыКоманды.Вставить(Выборка.Имя, МассивЗначений);
			КонецЕсли;
			
		Иначе
			
			ПараметрыКоманды.Вставить(Выборка.Имя, Выборка.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыКоманды;
	
КонецФункции // ПолучитьПараметрыКоманды

Функция ЗарегистрироватьОшибкуВыполнения(ВнешнийОбъект, ТекстОшибки) Экспорт
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru ='Ошибка выполнения дополнительного отчета или обработки'"),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
		ВнешнийОбъект,
		НСтр("ru ='" + ТекстОшибки + "'")
	);
	
КонецФункции // ЗарегистрироватьОшибкуВыполнения

Функция ЗаполнитьРегистрационныеДанные(Вид, Наименование, Версия, Информация = Неопределено, ДоступенИнтерактивно, Скриншоты = Неопределено) Экспорт
	
	РегистрационныеДанные = Новый Структура;
	
	РегистрационныеДанные.Вставить("Вид",                  Вид);
	РегистрационныеДанные.Вставить("Наименование",         Наименование);
	РегистрационныеДанные.Вставить("Версия",               Версия);
	РегистрационныеДанные.Вставить("Информация",           Информация);
	РегистрационныеДанные.Вставить("ДоступенИнтерактивно", ДоступенИнтерактивно);
	
	Если      ТипЗнч(Скриншоты) = Тип("Массив") Тогда
		РегистрационныеДанные.Вставить("Скриншоты", Скриншоты);
	ИначеЕсли ТипЗнч(Скриншоты) = Тип("Строка") Тогда
		РегистрационныеДанные.Вставить("Скриншоты", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Скриншоты, ",", Истина, Истина));
	Иначе
		РегистрационныеДанные.Вставить("Скриншоты", Новый Массив());
	КонецЕсли;
	
	Возврат РегистрационныеДанные;
	
КонецФункции // ЗаполнитьРегистрационныеДанные

#КонецОбласти

#Область РАБОТА_С_РЕГЛАМЕНТНЫМИ_ЗАДАНИЯМИ

// Обработчик экземпляра регламентного задания ЗапускДополнительныхОбработок
//
// Запускает обработчик глобальной обработки по регламентному заданию,
// с указанным идентификатором команды
//
// Параметры:
//    ВнешняяОбработка (Ссылка.ДополнительныеОтчетыИОбработки)
//    ИдентификаторКоманды (УникальныйИдентификатор)
//
Процедура ВыполнитьОбработкуПоРегламентномуЗаданию(ВнешняяОбработка, ИдентификаторКоманды, ГруппаПараметров = Неопределено, ГруппаПараметровИмя = Неопределено) Экспорт
	
	// Запись журнала регистрации
	Если ГруппаПараметровИмя = Неопределено Тогда
		ТекстСообщения = "'Команда %1";
	Иначе
		ТекстСообщения = "'Команда %1 (" + ГруппаПараметровИмя + ")";
	КонецЕсли; 
	
	ЗаписатьИнформацию(ВнешняяОбработка, ТекстСообщения + ": Запуск.'", ИдентификаторКоманды, ГруппаПараметровИмя);
	
	// Выполнение команды
	Попытка
		ВыполнитьКоманду(Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ГруппаПараметров", ВнешняяОбработка, ИдентификаторКоманды, ГруппаПараметров), Неопределено);
		
		// Запись журнала регистрации
		ЗаписатьИнформацию(ВнешняяОбработка, ТекстСообщения + ": Завершение.'", ИдентификаторКоманды, ГруппаПараметровИмя);
		
	Исключение
		
		ТекстОшибки = СтрШаблон(ТекстСообщения + ": Ошибка выполнения:%2'", 
			ИдентификаторКоманды,
			Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
КонецПроцедуры

// Создает новое регламентное задание в информационной базе.
//
// Параметры:
//  Наименование - строка, наименование регламентного задания.
//
// Возвращаемое значение: РегламентноеЗадание.
//
Функция СоздатьНовоеЗадание(Знач Наименование) Экспорт
	
	Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание("ЗапускДополнительныхОбработок");
	Задание.Использование = Ложь;
	Задание.Наименование  = Наименование;
	Задание.Записать();
	
	Возврат Задание;
	
КонецФункции

// Возвращает идентификатор регламентного задания (для сохранения в данных информационной базы).
//
// Задание - РегламентноеЗадание.
//
// Возвращаемое значение: УникальныйИдентификатор.
//
Функция ПолучитьИдентификаторЗадания(Знач Задание) Экспорт
	
	Возврат Задание.УникальныйИдентификатор;
	
КонецФункции

// Устанавливает параметры регламентного задания.
//
// Параметры:
//  Задание - РегламентноеЗадание,
//  Использование - булево, флаг использования регламентного задания,
//  Наименование - строка, наименование регламентного задания,
//  Параметры - Массив(Произвольный), параметры регламентного задания,
//  Расписание - РасписаниеРегламентногоЗадания.
//
Процедура УстановитьПараметрыЗадания(Задание, Использование, Наименование, Параметры, Расписание) Экспорт
	
	Задание.Использование = Использование;
	Задание.Наименование  = Наименование;
	Задание.Параметры     = Параметры;
	Задание.Расписание    = Расписание;
	
	Задание.Записать();
	
КонецПроцедуры

// Возвращает параметры регламентного задания.
//
// Параметры:
//  Задание - РегламентноеЗадание.
//
// Возвращаемое значение: Структура, ключи:
//  Использование - булево, флаг использования регламентного задания,
//  Наименование - строка, наименование регламентного задания,
//  Параметры - Массив(Произвольный), параметры регламентного задания,
//  Расписание - РасписаниеРегламентногоЗадания.
//
Функция ПолучитьПараметрыЗадания(Знач Задание) Экспорт
	
	Результат = Новый Структура();
	
	Результат.Вставить("Использование", Задание.Использование);
	Результат.Вставить("Наименование",  Задание.Наименование);
	Результат.Вставить("Параметры",     Задание.Параметры);
	Результат.Вставить("Расписание",    Задание.Расписание);
	
	Возврат Результат;
	
КонецФункции

// Выполняет поиск задания по идентификатору (предположительно, сохраненному в данных
// информационной базы).
//
// Параметры: Идентификатор - УникальныйИдентификатор.
//
// Возвращаемое значение: РегламентноеЗадание.
//
Функция НайтиЗадание(Знач Идентификатор) Экспорт
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
	
	Возврат Задание;
	
КонецФункции

// Удаляет регламентное задание из информационной базы.
//
// Параметры:
// Задание - РегламентноеЗадание.
//
Процедура УдалитьЗадание(Знач Задание) Экспорт
	
	Если ТипЗнч(Задание) = Тип("РегламентноеЗадание") Тогда
		Задание.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВЫПОЛНЕНИЕ_КОМАНД

// Выполняет команду обработки и возвращает результат ее выполнения
//
// Параметры:
//   ПараметрыКоманды (Структура) - Параметры, с которыми выполняется команда.
//       |- ДополнительнаяОбработкаСсылка (СправочникСсылка.ДополнительныеОтчетыИОбработки) - Ссылка на отчет или обработку
//       |- ИдентификаторКоманды (Строка)                                                   - Имя выполняемой команды.
//       |- ОбъектыНазначения (Массив)                                                      - Ссылки на объекты, для которых выполняется обработка. Обязательный для назначаемых обработок.
//       |- РезультатВыполнения                                                             - Необязательный. Используется для передачи результата работы на клиента.
//   АдресРезультата (Строка) - Необязательный. Адрес временного хранилища по которому будет размещен результат выполнения.
//
// Возвращаемое значение:
//   ПараметрыКоманды.РезультатВыполнения - см. ПараметрыКоманды. Если был передан АдресРезультата, то возвращается Неопределено.
//
Функция ВыполнитьКоманду(ПараметрыКоманды, АдресРезультата = Неопределено) Экспорт
	
	Возврат ВыполнитьКомандуВнешнегоОбъекта(
		ПолучитьОбъектВнешнейОбработки(ПараметрыКоманды.ДополнительнаяОбработкаСсылка),
		ПараметрыКоманды.ИдентификаторКоманды,
		ПараметрыКоманды,
		АдресРезультата);
	
КонецФункции // ВыполнитьКоманду

Функция ВыполнитьКомандуВнешнегоОбъекта(ВнешнийОбъект, ИдентификаторКоманды, ПараметрыКоманды, АдресРезультата)
	
	// проверим, чтобы версия внешнего объекта совпадала с указанной в базе
	СведенияОВнешнемОбъекте = ВнешнийОбъект.СведенияОВнешнейОбработке();
	
	Если СведенияОВнешнемОбъекте.Версия <> ПараметрыКоманды.ДополнительнаяОбработкаСсылка.Версия Тогда
		ВызватьИсключение РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку("Версия (%3) вызываемого отчета или обработки (%1) не совпадает с версией, указанной в базе данных (%2). Возможно, требуется очистка локального кэша пользователя",
			ПараметрыКоманды.ДополнительнаяОбработкаСсылка.ИмяОбъекта,
			ПараметрыКоманды.ДополнительнаяОбработкаСсылка.Версия,
			СведенияОВнешнемОбъекте.Версия);
	КонецЕсли;	
	
	// выполним команду
	Если Не ПараметрыКоманды.Свойство("РезультатВыполнения") Тогда
		ПараметрыКоманды.Вставить("РезультатВыполнения", РаботаСФормамиКлиентСервер.НовыйРезультатВыполнения());
	КонецЕсли;
	
	ИзмененныеОбъекты = Неопределено;
	
	ВидОбработки = ПараметрыКоманды.ДополнительнаяОбработкаСсылка.Вид;
	
	Если ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка
		Или ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет
	Тогда
		ВыполнитьКомандуДополнительногоОтчетаИлиОбработки(ВнешнийОбъект, ИдентификаторКоманды, ПараметрыКоманды);
		
	ИначеЕсли ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ЗаполнениеОбъекта Тогда
		ОбъектыНазначения = Неопределено;
		ПараметрыКоманды.Свойство("ОбъектыНазначения", ОбъектыНазначения);
		
		ВыполнитьНазначаемуюКомандуДополнительногоОтчетаИлиОбработки(ВнешнийОбъект, ИдентификаторКоманды, ПараметрыКоманды, ОбъектыНазначения);
		
		ИзмененныеОбъекты = ОбъектыНазначения;
			
	ИначеЕсли ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ПечатнаяФорма Тогда
		ОбъектыНазначения = Неопределено;
		ПараметрыКоманды.Свойство("ОбъектыНазначения", ОбъектыНазначения);
		
		ВыполнитьКомандуФормированияПечатнойФормы(ВнешнийОбъект, ИдентификаторКоманды, ПараметрыКоманды, ОбъектыНазначения);
		
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.ПодготовитьОповещениеДинамическихСписков(ИзмененныеОбъекты, ПараметрыКоманды.РезультатВыполнения);
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка") И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ПараметрыКоманды.РезультатВыполнения, АдресРезультата);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПараметрыКоманды.РезультатВыполнения;
	
КонецФункции

Процедура ВыполнитьКомандуДополнительногоОтчетаИлиОбработки(ВнешнийОбъект, Знач ИдентификаторКоманды, ПараметрыКоманды)
	
	Если ПараметрыКоманды = Неопределено Тогда
		ВнешнийОбъект.ВыполнитьКоманду(ИдентификаторКоманды);
	Иначе
		ВнешнийОбъект.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьНазначаемуюКомандуДополнительногоОтчетаИлиОбработки(ВнешнийОбъект, Знач ИдентификаторКоманды, ПараметрыКоманды, ОбъектыНазначения)
	
	Если ПараметрыКоманды = Неопределено Тогда
		ВнешнийОбъект.ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения);
	Иначе
		ВнешнийОбъект.ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения, ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуФормированияПечатнойФормы(ВнешнийОбъект, Знач ИдентификаторКоманды, ПараметрыКоманды, ОбъектыНазначения)
	
	Если ПараметрыКоманды = Неопределено Тогда
		ВнешнийОбъект.Печать(ИдентификаторКоманды, ОбъектыНазначения);
	Иначе
		ВнешнийОбъект.Печать(ИдентификаторКоманды, ОбъектыНазначения, ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВЫПОЛНЕНИЕ_ОБРАБОТОК

Процедура ЗарегистрироватьВнутрОшибкуВыполнения(Объект, ТекстОшибки) Экспорт
	
	ДопСвойства = Объект.ДополнительныеСвойства;
	
	Если Не ДопСвойства.Свойство("Ошибки") Тогда
		ДопСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	ДопСвойства.Ошибки.Добавить(ТекстОшибки);
	
КонецПроцедуры // ЗарегистрироватьВнутрОшибкуИмпорта

Процедура ОповеститьОВнутрОшибках(Объект, ЕстьОшибки = Неопределено) Экспорт
	
	ДопСвойства = Объект.ДополнительныеСвойства;
	
	ЕстьОшибки = ДопСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ДопСвойства.Ошибки, ДопСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ДопСвойства.Ошибки));
	КонецЕсли;
	
КонецПроцедуры // ОповеститьОВнутрОшибках

#КонецОбласти

// Подключает внешнюю обработку (отчет). После подключения
//   обработка (отчет) регистрируется в программе под определенным именем,
//   используя которое можно создавать объект или открывать формы обработки (отчета).
//
// Параметры:
//   Ссылка (СправочникСсылка.ДополнительныеОтчетыИОбработки) Подключаемая обработка.
//
// Возвращаемое значение: 
//   (Строка)       Имя подключенной обработки (отчета).
//   (Неопределено) Если передана некорректная ссылка.
//
Функция ПодключитьВнешнююОбработку(Ссылка) Экспорт
	
	// Проверка корректности переданных параметров
	Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки")
		Или Ссылка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка()
	Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Подключение
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ИмяОбработки = ПолучитьИмяВременногоФайла();
		ДвоичныеДанные = Ссылка.ХранилищеФайла.Получить();
		ДвоичныеДанные.Записать(ИмяОбработки);
		Возврат ИмяОбработки;
	#КонецЕсли
	
	Если Ссылка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
		Менеджер = ВнешниеОтчеты;
	Иначе
		Менеджер = ВнешниеОбработки;
	КонецЕсли;
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Ссылка.ХранилищеФайла.Получить());
	
	ИмяТипа = "ОписаниеЗащитыОтОпасныхДействий";
	ОписаниеЗащиты = Новый(ИмяТипа);
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	
	Возврат Менеджер.Подключить(АдресВоВременномХранилище, , Ложь, ОписаниеЗащиты);
	
КонецФункции

// Создает и возвращает объект внешней обработки (отчета)
//
// Параметры:
//   Ссылка (СправочникСсылка.ДополнительныеОтчетыИОбработки|Строка) Подключаемая обработка либо имя объекта обработки
//
// Возвращаемое значение: 
//   (ВнешняяОбработкаОбъект.*) Объект подключенной обработки.
//   (ВнешнийОтчетОбъект.*)     Объект подключенного отчета.
//   (Неопределено)             Если передана некорректная ссылка.
//
// Важно:
//   Проверка функциональной опции "ИспользоватьДополнительныеОтчетыИОбработки"
//     должна выполняться вызывающим кодом.
//
Функция ПолучитьОбъектВнешнейОбработки(Знач Ссылка) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
	
		Ссылка = ПолучитьСсылкуПоИмениОбъекта(Ссылка);
	
	КонецЕсли;
	
	// Подключение
	ИмяОбработки = ПодключитьВнешнююОбработку(Ссылка);
	
	// Проверка корректности переданных параметров
	Если ИмяОбработки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получение экземпляра объекта
	Если Ссылка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
		Менеджер = ВнешниеОтчеты;
	Иначе
		Менеджер = ВнешниеОбработки;
	КонецЕсли;
	
	Возврат Менеджер.Создать(ИмяОбработки, Ложь);
	
КонецФункции


// Функция - Получить ссылку по имени объекта
//
// Параметры:
//  ИмяОбъекта	 - Строка - Значение реквизита обработки ИмяОбъекта
// 
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки; Неопределено - ссылка на внешнюю обработку. 
//	Если обработка с таким именем не найдена будет возвращено Неопределено
//
Функция ПолучитьСсылкуПоИмениОбъекта(ИмяОбъекта) Экспорт

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьРегистрационныеДанные(Знач Объект, АдресФайла, ЭтоОтчет, ИдентификаторВладельца)
	
	// Подключение и получение имени, под которым объект будет подключаться
	Менеджер = ?(ЭтоОтчет, ВнешниеОтчеты, ВнешниеОбработки);
	
	ИмяОбъекта = СокрЛП(Менеджер.Подключить(АдресФайла,, Истина));
	
	// Получение сведений о внешней обработке
	ВнешнийОбъект = Менеджер.Создать(ИмяОбъекта);
		
	Попытка
		РегистрационныеДанные = ВнешнийОбъект.СведенияОВнешнейОбработке();
	Исключение
		ВызватьИсключение "Отчет или обработка не предназначены для подключения к дополнительным отчетам и обработкам, т.к. отсутствует или некорректно работает экспортный метод ""СведенияОВнешнейОбработке""";
	КонецПопытки;	
	
	ВнешнийОбъектМетаданные = ВнешнийОбъект.Метаданные();
	
	// Имя объекта, наименование, информация, вид
	РегистрационныеДанные.Вставить("ИмяОбъекта", ИмяОбъекта);
	
	Если ТипЗнч(РегистрационныеДанные.Вид) <> Тип("ПеречислениеСсылка.ВидыДополнительныхОтчетовИОбработок") Тогда
		РегистрационныеДанные.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок[РегистрационныеДанные.Вид];
	КонецЕсли;
	
	Если РегистрационныеДанные.Наименование = Неопределено Тогда
		РегистрационныеДанные.Наименование = ВнешнийОбъектМетаданные.Представление();
	КонецЕсли;
	
	Если РегистрационныеДанные.Информация = Неопределено Тогда
		РегистрационныеДанные.Информация = ВнешнийОбъектМетаданные.Комментарий;
	КонецЕсли;
	
	// хранилище скриншотов
	АдресаСкриншотов = Новый Массив;
	
	Если ТипЗнч(РегистрационныеДанные.Скриншоты) = Тип("Массив") Тогда
		Для Инд = 0 По РегистрационныеДанные.Скриншоты.Количество() - 1 Цикл
			АдресаСкриншотов.Добавить(
				ПоместитьВоВременноеХранилище(ВнешнийОбъект.ПолучитьМакет(РегистрационныеДанные.Скриншоты[Инд]), ИдентификаторВладельца));
		КонецЦикла;
	КонецЕсли;
	
	РегистрационныеДанные.Вставить("АдресаСкриншотов", АдресаСкриншотов);
	
	// хранилище вариантов
	РегистрационныеДанные.Вставить("ХранилищеВариантов");
	
	Если РегистрационныеДанные.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
		Если ВнешнийОбъектМетаданные.ХранилищеВариантов <> Неопределено Тогда
			РегистрационныеДанные.ХранилищеВариантов = ВнешнийОбъектМетаданные.ХранилищеВариантов.Имя;
		КонецЕсли;
	КонецЕсли;
	
	// команды
	РегистрационныеДанные.Команды.Колонки.Добавить("ВариантЗапуска");
	
	Для Каждого КомандаОписание Из РегистрационныеДанные.Команды Цикл
		КомандаОписание.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок[КомандаОписание.Использование];
	КонецЦикла;
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьТаблицуДоступныхКоманд(Ссылка) Экспорт

	ВнешнийОбъект = ПолучитьОбъектВнешнейОбработки(Ссылка);
	
	Попытка
		РегистрационныеДанные = ВнешнийОбъект.СведенияОВнешнейОбработке();
	Исключение
		ВызватьИсключение "Отчет или обработка не предназначены для подключения к дополнительным отчетам и обработкам, т.к. отсутствует или некорректно работает экспортный метод ""СведенияОВнешнейОбработке""";
	КонецПопытки;
	
	РегистрационныеДанные.Команды.Колонки.Добавить("ВариантЗапуска", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВызоваДополнительныхОбработок"));
	
	Для Каждого КомандаОписание Из РегистрационныеДанные.Команды Цикл
		КомандаОписание.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок[КомандаОписание.Использование];
	КонецЦикла;
	
	Возврат РегистрационныеДанные.Команды;

КонецФункции
 

// Возвращает вид обработки по строковому представлению
// Параметры
// СтроковоеПредставление - Строка - строковое представление вида обработки
// Возвращаемое значение
// ПеречислениеСсылка.ВидыДополнительныхОтчетовИОбработок - вид обработки
//
Функция ПолучитьВидОбработкиПоСтроковомуПредставлениюВида(Знач СтроковоеПредставление) Экспорт
	
	СтроковоеПредставление = ВРег(СтроковоеПредставление);
	
	Если      СтроковоеПредставление = ВРег(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Перечисления.ВидыДополнительныхОтчетовИОбработок.ЗаполнениеОбъекта)) Тогда
		Возврат Перечисления.ВидыДополнительныхОтчетовИОбработок.ЗаполнениеОбъекта;
	ИначеЕсли СтроковоеПредставление = ВРег(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Перечисления.ВидыДополнительныхОтчетовИОбработок.ПечатнаяФорма)) Тогда
		Возврат Перечисления.ВидыДополнительныхОтчетовИОбработок.ПечатнаяФорма;
	ИначеЕсли СтроковоеПредставление = ВРег(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка)) Тогда
		Возврат Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка;
	ИначеЕсли СтроковоеПредставление = ВРег(РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет)) Тогда
		Возврат Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;
	КонецЕсли;
	
КонецФункции

