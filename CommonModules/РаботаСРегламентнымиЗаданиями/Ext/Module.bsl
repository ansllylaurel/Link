
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Создает задачу из серии ОшибкиРегламентыхЗаданий в текущую дату сеанса
//
// Параметры:
//     ТекстЗадачи         - Строка,Массив - массив из строк, преобразуется в многострочный текст
//     Источник            - Строка - описание механизма, при исполении которого возникла ошибка
//                         - СправочникСсылка.ДополнительныеОтчетыИОбработки - устаревший вариант. Будет преобразован к виду, аналогичному вызову Метаданные().ПолноеИмя() 
//     ГруппаПользователей - СправочникСсылка.ГруппыПользователей - если не задан, выбирается группа ВсеПользователи
//     СессияСтатистики    - УникальныйИдентификатор - Иднетификатор сессии статистики
//
// Примечание:
//     Перед регистрацией новой ошибки проверяется наличие не выполненной и аналогичной по тексту и источнику за текущую дату сеанса
//
Функция ЗарегистрироватьОшибку(Знач ТекстЗадачи, Знач Источник, ГруппаПользователей = Неопределено, СессияСтатистики = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаЗадачи = ТекущаяДатаСеанса();
	
	Если ТипЗнч(ТекстЗадачи) = Тип("Массив") Тогда
		ТекстЗадачи = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ТекстЗадачи, Символы.ПС);
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
		
		РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Вид, ИмяОбъекта");
		
		Если РеквизитыИсточника.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
			Источник = "ВнешниеОтчеты";
		Иначе
			Источник = "ВнешниеОбработки";
		КонецЕсли;
		
		Источник = Источник + "." + РеквизитыИсточника.ИмяОбъекта;
		
	КонецЕсли;
	
	// Ограничения релиза 8.3.7 - нельзя пихать в ПОДОБНО строку длиной больше 1024 символа.
	// Таким образом максимальная длина текста задачи стала 1000 символов
	
	МаксимальныйРазмерИскомогоТекста = 1000;
	
	ИскомыйТекст = ТекстЗадачи;
	Если СтрДлина(ИскомыйТекст) > МаксимальныйРазмерИскомогоТекста Тогда
		ИскомыйТекст = Лев(ИскомыйТекст, МаксимальныйРазмерИскомогоТекста);
	КонецЕсли;
	
	// Сначала проверим, а не было ли у нас уже аналогичной задачи
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОшибкиРегламентыхЗаданий.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ОшибкиРегламентыхЗаданий КАК ОшибкиРегламентыхЗаданий
		|ГДЕ
		|	ОшибкиРегламентыхЗаданий.Источник = &Источник
		|	И НЕ ОшибкиРегламентыхЗаданий.Выполнена
		|	И ОшибкиРегламентыхЗаданий.Дата МЕЖДУ &ДатаЗадачиНачалоДня И &ДатаЗадачиКонецДня
		|	И (ВЫРАЗИТЬ(ОшибкиРегламентыхЗаданий.ТекстЗадачи КАК СТРОКА(1))) = &ТекстЗадачи");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СТРОКА(1)", Формат(МаксимальныйРазмерИскомогоТекста, "ЧФ=СТРОКА(Ч); ЧГ="));
	
	Запрос.УстановитьПараметр("ТекстЗадачи",         ИскомыйТекст);
	Запрос.УстановитьПараметр("Источник",            Источник);
	Запрос.УстановитьПараметр("ДатаЗадачиНачалоДня", НачалоДня(ДатаЗадачи));
	Запрос.УстановитьПараметр("ДатаЗадачиКонецДня",  КонецДня(ДатаЗадачи));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// если не было, создадим
	НоваяЗадача = Задачи.ОшибкиРегламентыхЗаданий.СоздатьЗадачу();
	НоваяЗадача.Дата                = ДатаЗадачи;
	НоваяЗадача.ГруппаПользователей = ?(ГруппаПользователей = Неопределено, Справочники.ГруппыПользователей.ВсеПользователи, ГруппаПользователей);
	НоваяЗадача.ТекстЗадачи         = ТекстЗадачи;
	НоваяЗадача.Источник            = Источник;
	НоваяЗадача.Наименование        = Источник;
	НоваяЗадача.СессияСтатистики	= СессияСтатистики;
	НоваяЗадача.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НоваяЗадача.Ссылка;
	
КонецФункции // ЗарегистрироватьОшибку

////////////////////////////////////////////////////////////////////////////////
// РЕГЛАМЕНТНЫЕ ЗАДАНИЯ

// Возвращает использование регламентного задания.
//  Перед вызовом требуется иметь право Администрирования
// или УстановитьПривилегированныйРежим.
//
// Параметры:
//  Идентификатор - ОбъектМетаданных регламентного задания для поиска
//                  предопределенного регламентного задания.
//                - УникальныйИдентификатор регламентного задания.
//                - Строка уникального идентификатора регламентного задания.
//                - РегламентноеЗадание.
//
// Возвращаемое значение:
//  Булево.
// 
Функция ПолучитьИспользованиеРегламентногоЗадания(Знач Идентификатор) Экспорт
	
	РаботаСРегламентнымиЗаданиямиСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = ПолучитьРегламентноеЗадание(Идентификатор);
	
	Возврат Задание.Использование;
	
КонецФункции

// Устанавливает использование регламентного задания.
//  Перед вызовом требуется иметь право Администрирования
// или УстановитьПривилегированныйРежим.
//
// Параметры:
//  Идентификатор - ОбъектМетаданных регламентного задания для поиска
//                  предопределенного регламентного задания.
//                - УникальныйИдентификатор регламентного задания.
//                - Строка уникального идентификатора регламентного задания.
//                - РегламентноеЗадание.
//
// Использование  - Булево.
// 
Процедура УстановитьИспользованиеРегламентногоЗадания(Знач Идентификатор, Знач Использование) Экспорт
	
	РаботаСРегламентнымиЗаданиямиСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = ПолучитьРегламентноеЗадание(Идентификатор);
	
	Если Задание.Использование <> Использование Тогда
		Задание.Использование = Использование;
	КонецЕсли;
	
	Задание.Записать();
	
КонецПроцедуры

// Возвращает расписание регламентного задания.
//  Перед вызовом требуется иметь право Администрирования
// или УстановитьПривилегированныйРежим.
//
// Параметры:
//  Идентификатор - ОбъектМетаданных регламентного задания для поиска
//                  предопределенного регламентного задания.
//                - УникальныйИдентификатор регламентного задания.
//                - Строка уникального идентификатора регламентного задания.
//                - РегламентноеЗадание.
//
// ВСтруктуре     - Булево, если Истина, тогда расписание будет преобразовано
//                  в структуру, которую можно передать на клиент.
// 
// Возвращаемое значение:
//  Булево.
// 
Функция ПолучитьРасписаниеРегламентногоЗадания(Знач Идентификатор, Знач ВСтруктуре = Ложь) Экспорт
	
	РаботаСРегламентнымиЗаданиямиСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = ПолучитьРегламентноеЗадание(Идентификатор);
	
	Если ВСтруктуре Тогда
		Возврат РасписаниеВСтруктуру(Задание.Расписание);
	КонецЕсли;
	
	Возврат Задание.Расписание;
	
КонецФункции

// Устанавливает расписание регламентного задания.
//  Перед вызовом требуется иметь право Администрирования
// или УстановитьПривилегированныйРежим.
//
// Параметры:
//  Идентификатор - ОбъектМетаданных регламентного задания для поиска
//                  предопределенного регламентного задания.
//                - УникальныйИдентификатор регламентного задания.
//                - Строка уникального идентификатора регламентного задания.
//                - РегламентноеЗадание.
//
// Расписание     - РасписаниеРегламентногоЗадания.
//                - Структура расписания, как возвращает функция
//                  ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру.
// 
Процедура УстановитьРасписаниеРегламентногоЗадания(Знач Идентификатор, Знач Расписание) Экспорт
	
	РаботаСРегламентнымиЗаданиямиСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = ПолучитьРегламентноеЗадание(Идентификатор);
	
	Если ТипЗнч(Расписание) = Тип("РасписаниеРегламентногоЗадания") Тогда
		Задание.Расписание = Расписание;
	Иначе
		Задание.Расписание = СтруктураВРасписание(Расписание);
	КонецЕсли;
	
	Задание.Записать();
	
КонецПроцедуры

// Возвращает РегламентноеЗадание из информационной базы.
//
// Параметры:
//  Идентификатор - ОбъектМетаданных регламентного задания для поиска
//                  предопределенного регламентного задания.
//                - УникальныйИдентификатор регламентного задания.
//                - Строка уникального идентификатора регламентного задания.
//                - РегламентноеЗадание из которого нужно получить уникальный
//                  идентификатор для получения свежей копии регламентного задания.
// 
// Возвращаемое значение:
//  РегламентноеЗадание, прочитанное из базы данных.
//
Функция ПолучитьРегламентноеЗадание(Знач Идентификатор) Экспорт
	
	РаботаСРегламентнымиЗаданиямиСлужебный.ВызватьИсключениеЕслиНетПраваАдминистрирования();
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(Идентификатор) = Тип("РегламентноеЗадание") Тогда
		Идентификатор = Идентификатор.УникальныйИдентификатор;
	КонецЕсли;
	
	Если ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Идентификатор = Новый УникальныйИдентификатор(Идентификатор);
	КонецЕсли;
	
	Если ТипЗнч(Идентификатор) = Тип("ОбъектМетаданных") Тогда
		РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Идентификатор);
	Иначе
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
	КонецЕсли;
	
	Если РегламентноеЗадание = Неопределено Тогда
		ВызватьИсключение( НСтр("ru = 'Регламентное задание не найдено.
		                              |Возможно, оно удалено другим пользователем.'") );
	КонецЕсли;
	
	Возврат РегламентноеЗадание;
	
КонецФункции

