// ОТЛОЖЕННЫЕ ЗАДАНИЯ

// Функция - Добавить отложенное задание
//
// Параметры:
//  Объект							 - Строка|СправочникСсылка.ДополнительныеОтчетыИОбработки - Полное имя объекта метаданных или ссылка на объект отчета/обработки, метод которой необходимо выполнить
//  Команда							 - Строка - Имя выполняемого метода
//  Параметры						 - Структура - Параметры, передаваемые в вызываемый метод
//  Таймаут							 - Число - Интервал времени в минутах, по истечении которого в регистре отложенных заданий будет зафиксирована ошибка выполнения отложенного задания
//  ПерезапускатьПоИстечениюТаймаута - Булево - Признак необходимости добавления новой записи для выполнения задания с теми же параметрами
//  ДатаЗапускаПлан					 - ДатаВремя - Дата и время, ранее которых задание запусаться не будет
// 
// Возвращаемое значение:
//  Идентификатор задания или Неопределено
//
Функция ДобавитьОтложенноеЗадание(Объект, Команда, Параметры, Таймаут = 0, ПерезапускатьПоИстечениюТаймаута = Ложь, ДатаЗапускаПлан = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПредставлениеОбъекта = "";
	Если ТипЗнч(Объект) = Тип("Строка") Тогда
		ПредставлениеОбъекта = Объект;
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") Тогда
		ПредставлениеОбъекта = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(Объект.Вид) + "." + Объект.ИмяОбъекта;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.ОтложенныеЗадания.СоздатьМенеджерЗаписи();
	
	Запись.Объект							= Объект;
	Запись.Идентификатор					= Новый УникальныйИдентификатор();
	Запись.Команда							= Команда;
	Запись.Таймаут							= Таймаут;
	Запись.ПерезапускатьПоИстечениюТаймаута	= ПерезапускатьПоИстечениюТаймаута;
	Запись.Состояние						= Перечисления.СостоянияОтложенныхЗаданий.Ожидание;
	Запись.ДатаДобавления					= ТекущаяДатаСеанса();
	Запись.ДатаЗапускаПлан					= ?(ДатаЗапускаПлан = Неопределено, Запись.ДатаДобавления, ДатаЗапускаПлан);
	
	Параметры.Свойство("Организация", Запись.Организация);
	
	ОписаниеПараметров = "";		
	
	Если Параметры <> Неопределено И Параметры.Количество() > 0 Тогда
		
		Запись.Параметры = Новый ХранилищеЗначения(Параметры);
		
		Для Каждого ТекПараметр Из Параметры Цикл
			Если ТекПараметр.Ключ <> "ТекстОшибки" И ТекПараметр.Ключ <> "ИсточникОшибки" Тогда
				ОписаниеПараметров = ?(ОписаниеПараметров <> "", ОписаниеПараметров + Символы.ПС, "") + ТекПараметр.Ключ + " = " + Строка(ТекПараметр.Значение);	
			КонецЕсли;
			
		КонецЦикла;
		
		Запись.ОписаниеПараметров = ОписаниеПараметров;
		
		Если Объект = "Обработки.ФормированиеБухгалтерскогоУчета" Тогда
		
			Запись.Организация					= Параметры.Организация;
			Запись.СчетДоверительногоУправления	= Параметры.СчетДоверительногоУправления;
			Запись.ВидУчета						= Параметры.ВидУчета;
			Запись.Сложность					= Параметры.Сложность;
			Запись.Пользователь					= Параметры.Пользователь;
			Запись.ИнтерактивныйЗапуск			= Истина;
		
		КонецЕсли;
		
	КонецЕсли;
		
	Попытка
		
		Запись.Записать();
		Результат = Запись.Идентификатор;
		
	Исключение
		
		Результат = Неопределено;
		
		ТекстОшибки = СтрШаблон("Не удалось добавить отложенное задание, объект: %1, команда: %2", ПредставлениеОбъекта, Команда);
		Если Параметры.Свойство("ТекстОшибки") Тогда
			ТекстОшибки = Параметры.ТекстОшибки;
		КонецЕсли;
		
		Если Параметры.Свойство("ИсточникОшибки") Тогда
			ИсточникОшибки = Параметры.ИсточникОшибки;
		КонецЕсли;
		
		Для каждого ТекПараметр Из Параметры Цикл
			Если ТекПараметр.Ключ <> "ТекстОшибки" И ТекПараметр.Ключ <> "ИсточникОшибки" Тогда
				ТекстОшибки = ТекстОшибки + Символы.ПС + ТекПараметр.Ключ + ": " + ТекПараметр.Значение;
			КонецЕсли;
		КонецЦикла;
		
		ЗарегистрироватьОшибку(ТекстОшибки, ИсточникОшибки);
		
	КонецПопытки;
			
	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат Результат;
	
КонецФункции

// Функция - Зафиксировать запуск отложенного задания
//
// Параметры:
//  Идентификатор	 - УникальныйИдентификатор - идентификатор задания
// 
// Возвращаемое значение:
//  Булево - Признак успешной смены состояния выполнения задания
//
Функция ЗафиксироватьЗапускОтложенногоЗадания(Идентификатор, ИдентификаторФоновогоЗадания = Неопределено) Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
	Записи.Отбор.Идентификатор.Установить(Идентификатор);
	Записи.Отбор.Организация.Установить(ПолучитьОрганизациюОтложенногоЗадания(Идентификатор));
	Записи.Прочитать();
	
	Попытка
		
		Запись = Записи[0];
		
		Если Запись.ИнтерактивныйЗапуск И Запись.Состояние <> Перечисления.СостоянияОтложенныхЗаданий.Ожидание Тогда 
			Результат = Ложь;
		Иначе
			Запись.Состояние	= Перечисления.СостоянияОтложенныхЗаданий.Выполняется;
			Запись.ДатаЗапуска	= ТекущаяДатаСеанса();
			
			Если ИдентификаторФоновогоЗадания <> Неопределено Тогда
				Запись.ИдентификаторФоновогоЗадания = ИдентификаторФоновогоЗадания;
			КонецЕсли;
			
			Записи.Записать();
		КонецЕсли;
		
	Исключение
		
		Результат = Ложь;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ОтменитьОтложенноеЗадание(Идентификатор, Комментарий = "", Пересоздать = Ложь) Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
	Записи.Отбор.Идентификатор.Установить(Идентификатор);
	Записи.Отбор.Организация.Установить(ПолучитьОрганизациюОтложенногоЗадания(Идентификатор));
	Записи.Прочитать();
	
	Задание = Записи[0];
	
	Если Пересоздать Тогда
		ДобавитьОтложенноеЗадание(Задание.Объект, Задание.Команда, Задание.Параметры.Получить());
	КонецЕсли;
	
	Задание.Состояние			= Перечисления.СостоянияОтложенныхЗаданий.Отменено;
	Задание.Комментарий			= Комментарий;
	Задание.ДатаОшибкиОтмены	= ТекущаяДатаСеанса();
	
	Записи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьПовторноОтложенноеЗадание(Идентификатор) Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
	Записи.Отбор.Идентификатор.Установить(Идентификатор);
	Записи.Прочитать();
	
	Задание = Записи[0];
	
	ДобавитьОтложенноеЗадание(Задание.Объект, Задание.Команда, Задание.Параметры.Получить());
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ЗафиксироватьВыполнениеОтложенногоЗадания(Идентификатор, ЗавершилосьОшибкой = Ложь, Комментарий = "") Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
	Записи.Отбор.Идентификатор.Установить(Идентификатор);
	Записи.Отбор.Организация.Установить(ПолучитьОрганизациюОтложенногоЗадания(Идентификатор));
	Записи.Прочитать();
	
	Запись = Записи[0];
	
	Если ЗавершилосьОшибкой Тогда
		Запись.Состояние	= Перечисления.СостоянияОтложенныхЗаданий.Ошибка;
		Запись.Комментарий	= Комментарий + ?(ПустаяСтрока(Комментарий), "", Символы.ПС);
		
		СообщенияФоновогоЗадания = РаботаСДлительнымиОперациями.ПолучитьСообщения(Запись.ИдентификаторФоновогоЗадания);
		Если СообщенияФоновогоЗадания.Количество() = 0 Тогда
			Запись.Комментарий = Запись.Комментарий + "Сообщения не зафиксированы";
		Иначе
		    Запись.Комментарий = Запись.Комментарий + "Зафиксированы сообщения:" + Символы.ПС + СтрСоединить(СообщенияФоновогоЗадания, Символы.ПС);
		КонецЕсли;
	Иначе
		Запись.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Завершено;
	КонецЕсли;
	
	Запись.ДатаВыполнения = ТекущаяДатаСеанса();
	
	Записи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция УстановитьИдентификаторыФоновогоЗадания(Экземпляры)

	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	
	Если ТипЗнч(ФоновоеЗадание) = Тип("ФоновоеЗадание") Тогда
		
		ИдентификаторФоновогоЗадания = ФоновоеЗадание.УникальныйИдентификатор;
		
		Организация = ПолучитьОрганизациюОтложенногоЗадания(Экземпляры[0].Идентификатор); 
		
		// заблокируем наши задания
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОтложенныеЗадания");
		ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
		ЭлементБлокировки.ИсточникДанных = Экземпляры;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Идентификатор", "Идентификатор");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		Для каждого Экземпляр Из Экземпляры Цикл
			
			Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
			Записи.Отбор.Идентификатор.Установить(Экземпляр.Идентификатор);
		    Записи.Отбор.Организация.Установить(Организация);
			Записи.Прочитать();
			
			Запись = Записи[0];
			
			Если Запись.Состояние = Перечисления.СостоянияОтложенныхЗаданий.Отменено Тогда // успели уже отменить, ничего запускать не надо
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			Запись.ИдентификаторФоновогоЗадания = ИдентификаторФоновогоЗадания;
			
			Записи.Записать();
			
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию(); 
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ЗапуститьОтложенноеЗадание(Объект, Команда, Экземпляры) Экспорт
	
	Если НЕ УстановитьИдентификаторыФоновогоЗадания(Экземпляры) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Обработка / отчет из дерева конфигурации.
	Если ТипЗнч(Объект) = Тип("Строка") Тогда
		
		// Отчет.
		Если ВРег(Лев(Объект, 7)) = "ОТЧЕТЫ." Тогда
			КоллекцияМетаданных = Отчеты;
		// Обработка.
		ИначеЕсли ВРег(Лев(Объект, 10)) = "ОБРАБОТКИ." Тогда
			КоллекцияМетаданных = Обработки;
		Иначе 
			Модуль = СистемныеФункции.СерверныйМодульМенеджера(Объект);
			Модуль.ВыполнитьМетод(Команда, Экземпляры);
			Возврат Результат;
		КонецЕсли;
		
		ИмяОбъекта = Сред(Объект, Найти(Объект, ".") + 1);
		
		ОбъектОбработкаОтчет = КоллекцияМетаданных[ИмяОбъекта].Создать();
		
	// Дополнительный отчет / обработка.
	Иначе
		ОбъектОбработкаОтчет = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(Объект);
	КонецЕсли;
	
	ОбъектОбработкаОтчет.ВыполнитьМетод(Команда, Экземпляры);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция УдалитьДанныеОЗадании(Идентификатор) Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записи = РегистрыСведений.ОтложенныеЗадания.СоздатьНаборЗаписей();
	Записи.Отбор.Идентификатор.Установить(Идентификатор);
	Записи.Прочитать();
	
	Записи.Очистить();
	
	Попытка
		
		Записи.Записать(Истина);
		
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось удалить информацию об отложенном заданияи с идентификатором '" + Строка(Идентификатор) + "'!" + Символы.ПС + ОписаниеОшибки());
		
		Результат = Ложь;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

