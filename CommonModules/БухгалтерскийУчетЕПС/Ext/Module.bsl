		|	_ДвиженияПартий.УчетныйАктивЕПССчетУчетаКорректировокП КАК УчетныйАктивЕПССчетУчетаКорректировокП,
		|	_ДвиженияПартий.УчетныйАктивЕПСАналитикаДоходовОтКорректировки КАК УчетныйАктивЕПСАналитикаДоходовОтКорректировки,
		|	_ДвиженияПартий.УчетныйАктивЕПСАналитикаРасходовОтКорректировки КАК УчетныйАктивЕПСАналитикаРасходовОтКорректировки,
		|	_ДвиженияПартий.УчетныйАктивЕПСАналитикаДоходовПервоначальногоПризнания КАК УчетныйАктивЕПСАналитикаДоходовПервоначальногоПризнания,
		|	_ДвиженияПартий.УчетныйАктивЕПСАналитикаРасходовПервоначальногоПризнания КАК УчетныйАктивЕПСАналитикаРасходовПервоначальногоПризнания,
		|	_ДвиженияПартий.УчетныйАктивЕПССчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт КАК УчетныйАктивЕПССчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт,
		|	_ДвиженияПартий.УчетныйАктивЕПССчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт КАК УчетныйАктивЕПССчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт,
		|	_ДвиженияПартий.УчетныйАктивЕПССчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт КАК УчетныйАктивЕПССчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт,
		|	_ДвиженияПартий.УчетныйАктивЕПССчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Кт КАК УчетныйАктивЕПССчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Кт,
		|	ЕСТЬNULL(_АналитикаРезервов.АналитикаРезерва, &АналитикаРезерваПоУмолчанию) КАК АналитикаРезерва
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаРезервов КАК _АналитикаРезервов
		|		ПО _ДвиженияПартий.ЦеннаяБумага = _АналитикаРезервов.ЦеннаяБумага
		|			И _ДвиженияПартий.Организация = _АналитикаРезервов.Организация
		|			И _ДвиженияПартий.СчетДоверительногоУправления = _АналитикаРезервов.СчетДоверительногоУправления
		|			И _ДвиженияПартий.УчетныйАктивЕПССчетУчетаРезервов = _АналитикаРезервов.СчетУчетаРезерва
		|ИТОГИ
		|	МИНИМУМ(Количество),
		|	МИНИМУМ(СуммаСделки),
		|	МИНИМУМ(СуммаКупонаСделки),
		|	МИНИМУМ(ТорговаяКомиссияСделки),
		|	МИНИМУМ(РасходыПоСделке)
		|ПО
		|	ЦеннаяБумага";
	
	
	Запрос.УстановитьПараметр("Сделка", ПараметрыОплаты.Сделка);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ПараметрыОплаты.Сделка.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОбъектДокумента.Дата));
	Запрос.УстановитьПараметр("Ссылка", ОбъектДокумента.Ссылка);
	Запрос.УстановитьПараметр("СубконтоЦБ_Р", СубконтоЦБ_Р);
	Запрос.УстановитьПараметр("АналитикаРезерваПоУмолчанию", Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	Запрос.УстановитьПараметр("Период", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	
	Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Сделка.", "Документ.ИсполнениеОбязательствПоСделке.");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СделкаЦенныеБумаги.ТорговаяКомиссия КАК ТорговаяКомиссияСделки,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ДвиженияПартий.ТорговаяКомиссияСделки КАК ТорговаяКомиссияСделки,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ(ТорговаяКомиссияСделки),", "");
		
	КонецЕсли;
	
	ПроизошлоВосстановлениеРезерва = Ложь;
	
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЦеннаяБумага = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		КоличествоСделки = ВыборкаЦеннаяБумага.Количество;
		
		СуммаСделки = ВыборкаЦеннаяБумага.СуммаСделки;
		СуммаКупонаСделки = ВыборкаЦеннаяБумага.СуммаКупонаСделки;
		РасходыПоСделке = ВыборкаЦеннаяБумага.РасходыПоСделке;
		
		СуммаСделкиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаСделки, ОбъектДокумента.ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
		СуммаКупонаСделкиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКупонаСделки, ОбъектДокумента.ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
		РасходыПоСделкеВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(РасходыПоСделке, ОбъектДокумента.ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
		
		Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка") Тогда
		
			ТорговаяКомиссияСделки = ВыборкаЦеннаяБумага.ТорговаяКомиссияСделки;
			ТорговаяКомиссияСделкиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТорговаяКомиссияСделки, ОбъектДокумента.ВалютаТорговойКомиссии, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
		
		КонецЕсли;
		
		ОсталосьСписатьКоличество = КоличествоСделки;
		
		ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ОсталосьСписатьКоличество = ОсталосьСписатьКоличество - ВыборкаДетальныеЗаписи.КоличествоПартииРасход;
			
			Если ОсталосьСписатьКоличество <> 0 Тогда 
			
				СуммаСделкиСписать				= Окр(СуммаСделки				/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				СуммаКупонаСделкиСписать		= Окр(СуммаКупонаСделки			/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				РасходыПоСделкеСписать			= Окр(РасходыПоСделке			/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				
				СуммаСделкиВВалютеУчетаСписать				= Окр(СуммаСделкиВВалютеУчета				/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				СуммаКупонаСделкиВВалютеУчетаСписать		= Окр(СуммаКупонаСделкиВВалютеУчета			/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				РасходыПоСделкеВВалютеУчетаСписать			= Окр(РасходыПоСделкеВВалютеУчета			/ КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				
			Иначе // последняя строка - сбросим на нее все погрешности округления
				
				СуммаСделкиСписать				= СуммаСделки;
				СуммаКупонаСделкиСписать		= СуммаКупонаСделки;
				РасходыПоСделкеСписать			= РасходыПоСделке;
				
				СуммаСделкиВВалютеУчетаСписать				= СуммаСделкиВВалютеУчета;
				СуммаКупонаСделкиВВалютеУчетаСписать		= СуммаКупонаСделкиВВалютеУчета;
				РасходыПоСделкеВВалютеУчетаСписать			= РасходыПоСделкеВВалютеУчета;
				
			КонецЕсли;
			
			СуммаСделки = СуммаСделки - СуммаСделкиСписать;
			СуммаКупонаСделки = СуммаКупонаСделки - СуммаКупонаСделкиСписать;
			РасходыПоСделке = РасходыПоСделке - РасходыПоСделкеСписать;
			
			СуммаСделкиВВалютеУчета = СуммаСделкиВВалютеУчета - СуммаСделкиВВалютеУчетаСписать;
			СуммаКупонаСделкиВВалютеУчета = СуммаКупонаСделкиВВалютеУчета - СуммаКупонаСделкиВВалютеУчетаСписать;
			РасходыПоСделкеВВалютеУчета = РасходыПоСделкеВВалютеУчета - РасходыПоСделкеВВалютеУчетаСписать;
			
			
			ПараметрыОплаты.Вставить("УчетныйАктивЕПС",		ВыборкаДетальныеЗаписи.УчетныйАктивЕПС);
			ПараметрыОплаты.Вставить("ЦеннаяБумага",		ВыборкаДетальныеЗаписи.ЦеннаяБумага);
			ПараметрыОплаты.Вставить("ВалютаНоминала",		ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала);
			ПараметрыОплаты.Вставить("ВалютаУчета",			ВалютаУчета);
			
			ПараметрыОплаты.Вставить("Партия",						ВыборкаДетальныеЗаписи.Партия);
			ПараметрыОплаты.Вставить("СтрокаПартии",				ВыборкаДетальныеЗаписи.СтрокаПартии);
			
			Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка") Тогда
			
				ТорговаяКомиссияСделкиСписать = Окр(ТорговаяКомиссияСделки / КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				ТорговаяКомиссияСделкиВВалютеУчетаСписать = Окр(ТорговаяКомиссияСделкиВВалютеУчета / КоличествоСделки * ВыборкаДетальныеЗаписи.КоличествоПартииРасход, 2);
				
				ТорговаяКомиссияСделки = ТорговаяКомиссияСделки - ТорговаяКомиссияСделкиСписать;
				ПараметрыОплаты.Вставить("ТорговаяКомиссия",	ТорговаяКомиссияСделкиСписать);
				
				БухгалтерскийУчетЕПС.СформироватьПроводкиОплатыТорговойКомиссииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
			
			КонецЕсли;
			
			КоличествоСделки = КоличествоСделки - ВыборкаДетальныеЗаписи.КоличествоПартииРасход;
			
			// 2 Продажа тела и купона 47407-61
			ПараметрыОплаты.Вставить("Количество",					ВыборкаДетальныеЗаписи.КоличествоПартииРасход);
			ПараметрыОплаты.Вставить("СуммаРеализации",				СуммаСделкиСписать);
			ПараметрыОплаты.Вставить("СуммаРеализацииВВалютеУчета",	СуммаСделкиВВалютеУчетаСписать);
			
			СформироватьПроводкуРеализацииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
			
			ПараметрыОплаты.Вставить("Количество",					0);
			ПараметрыОплаты.Вставить("СуммаРеализации",				СуммаКупонаСделкиСписать);
			ПараметрыОплаты.Вставить("СуммаРеализацииВВалютеУчета",	СуммаКупонаСделкиВВалютеУчетаСписать);
			
			СформироватьПроводкуРеализацииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ, "(Купон)");
			
			
			// 5 Начислим %ные доходы и переоценку
			ПараметрыНачисления = Новый Структура;
			
			ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
			
			ПараметрыНачисления.Вставить("ЦеннаяБумага",	ВыборкаДетальныеЗаписи.ЦеннаяБумага);
			ПараметрыНачисления.Вставить("ВалютаНоминала",	ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала);
			ПараметрыНачисления.Вставить("Партия",			ВыборкаДетальныеЗаписи.Партия);
			ПараметрыНачисления.Вставить("СтрокаПартии",	ВыборкаДетальныеЗаписи.СтрокаПартии);
			ПараметрыНачисления.Вставить("Количество",		0);
			ПараметрыНачисления.Вставить("ВалютаСделки",	ОбъектДокумента.ВалютаСделки);
			ПараметрыНачисления.Вставить("ПроверитьПарные",	"");
			
			// дисконт-премия	
			ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйПартииПриход);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчетаПартииПриход);
			
			ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПССчетУчета);
			Если ВыборкаДетальныеЗаписи.ДисконтПремияПокупки > 0 Тогда
				ПараметрыНачисления.Вставить("Содержание",				"Списание премии");
				ПараметрыНачисления.Вставить("Аналитика",				АналитикаПремии);
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы04);
				ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаСписанияПремии);
			Иначе
				ПараметрыНачисления.Вставить("Содержание",			"Начисление дисконта");
				ПараметрыНачисления.Вставить("Аналитика",			АналитикаДисконта);
				ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы01);
				ПараметрыНачисления.Вставить("ГФУ",					ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаПроцентныхДоходов);
			КонецЕсли;
			
			СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыНачисления);
				
			// ННКД	
			ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ПереоценкаКупонаПартииПриход);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчетаПартииПриход);
			
			ПараметрыНачисления.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПССчетУчета);
			ПараметрыНачисления.Вставить("Содержание",			"Переоценка купона");
			ПараметрыНачисления.Вставить("Аналитика",			АналитикаКупонНачисленный);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
			ПараметрыНачисления.Вставить("ГФУ",				ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаПроцентныхДоходов);
			
			СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыНачисления);
				
			// переоценка
			БалансоваяПереоценка = ВыборкаДетальныеЗаписи.ПереоценкаПартииРасход - ВыборкаДетальныеЗаписи.ПереоценкаПартииПриход;
			БалансоваяПереоценкаВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаПартииРасход - ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаПартииПриход;
			БалансоваяПереоценкаСНачалаГода = ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода - ВыборкаДетальныеЗаписи.ПереоценкаПартииПриход;
			
			ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ПереоценкаПартииПриход);
			ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаПартииПриход);
			ПараметрыНачисления.Вставить("СуммаСНачалаГода",	ВыборкаДетальныеЗаписи.ПереоценкаСНачалаГода);
			ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
