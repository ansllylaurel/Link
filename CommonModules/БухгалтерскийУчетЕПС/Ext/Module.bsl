		|					И ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт = 0
		|					И ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт <> 0
		|				ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт = 0
		|					И ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт <> 0
		|			ТОГДА ""Зависла валютная сумма""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Ошибка
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет.Вид <> ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|				И ВЫБОР
		|					КОГДА Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03)
		|						ТОГДА &ПроверятьСчет47903
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиОценкаНоль КАК _ЦенныеБумагиОценкаНоль
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = _ЦенныеБумагиОценкаНоль.ЦеннаяБумага
		|			И (ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 3) = ""971"")
