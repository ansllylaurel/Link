		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	МАКСИМУМ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) КАК АналитикаРезерва,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК СчетУчетаРезерва
		|ПОМЕСТИТЬ _АналитикаРезервов
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В
		|				(ВЫБРАТЬ
		|					_ДвиженияПартий.УчетныйАктивЕПС.СчетУчетаРезервов
		|				ИЗ
		|					_ДвиженияПартий КАК _ДвиженияПартий
		|				ГДЕ
		|					_ДвиженияПартий.СуммаРезервовПодОбесценение > 0),
		|			&СубконтоЦБ_Р,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Субконто1 = &ЦеннаяБумага) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	СчетУчетаРезерва
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияПартий.Количество КАК Количество,
		|	_ДвиженияПартий.Стоимость + ВЫБОР
		|		КОГДА _ДвиженияПартий.ЦеннаяБумага <> &Облигация_РЖД_11
		|			ТОГДА 0
		|		ИНАЧЕ _ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная
		|	КОНЕЦ КАК Стоимость,
		|	_ДвиженияПартий.СтоимостьВВалютеУчета + ВЫБОР
		|		КОГДА _ДвиженияПартий.ЦеннаяБумага <> &Облигация_РЖД_11
		|			ТОГДА 0
		|		ИНАЧЕ _ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная
		|	КОНЕЦ КАК СтоимостьВВалютеУчета,
		|	_ДвиженияПартий.Переоценка КАК Переоценка,
		|	_ДвиженияПартий.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	_ДвиженияПартий.СтоимостьКупона КАК СтоимостьКупона,
		|	_ДвиженияПартий.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	_ДвиженияПартий.ПереоценкаКупона КАК ПереоценкаКупона,
		|	_ДвиженияПартий.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	_ДвиженияПартий.ПремияНачисленная КАК ПремияНачисленная,
		|	_ДвиженияПартий.ПремияНачисленнаяВВалютеУчета КАК ПремияНачисленнаяВВалютеУчета,
		|	_ДвиженияПартий.ДисконтНачисленный КАК ДисконтНачисленный,
		|	_ДвиженияПартий.ДисконтНачисленныйВВалютеУчета КАК ДисконтНачисленныйВВалютеУчета,
		|	_ДвиженияПартий.КорректировкаЭСП КАК КорректировкаЭСП,
		|	_ДвиженияПартий.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	_ДвиженияПартий.ИндексацияНоминала КАК ИндексацияНоминала,
		|	_ДвиженияПартий.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
		|	_ДвиженияПартий.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	_ОстаткиПартий.КоличествоОстаток КАК КоличествоОстаток,
		|	_ОстаткиПартий.ДатаПокупки КАК ДатаПокупки,
		|	ЕСТЬNULL(_АналитикаРезервов.АналитикаРезерва, &АналитикаРезерваПоУмолчанию) КАК АналитикаРезерва,
		|	_ДвиженияПартий.Партия КАК Партия,
		|	_ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ДвиженияИОстаткиПартий
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартий.УчетныйАктивЕПС
		|			И _ДвиженияПартий.Партия = _ОстаткиПартий.Партия
		|			И _ДвиженияПартий.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаРезервов КАК _АналитикаРезервов
		|		ПО _ДвиженияПартий.ЦеннаяБумага = _АналитикаРезервов.ЦеннаяБумага
		|			И _ДвиженияПартий.УчетныйАктивЕПС.СчетУчетаРезервов = _АналитикаРезервов.СчетУчетаРезерва";

	Запрос.УстановитьПараметр("Регистратор", ОбъектДокумента.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Период", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ПогашениеСсылка", ПогашениеСсылка);
	Запрос.УстановитьПараметр("ДатаПогашения", ДанныеПогашения.Дата);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ОбъектДокумента.Дата));
	Запрос.УстановитьПараметр("ЦеннаяБумага", ДанныеПогашения.ЦеннаяБумага);
	Запрос.УстановитьПараметр("СубконтоЦБ_Р", СубконтоЦБ_Р);
	Запрос.УстановитьПараметр("АналитикаРезерваПоУмолчанию", Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	// у нее корректировка ПП пошла в тело, пока хардкод, будет исправляться по задаче по корректировке ПП
	Запрос.УстановитьПараметр("Облигация_РЖД_11", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_11"));
	
	Запрос.Выполнить();
	
	ДвиженияПартий			= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияИОстаткиПартий"].ПолучитьДанные().Выгрузить();
	ФактическиеПлатежи	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ФактическиеПлатежи"].ПолучитьДанные().Выгрузить();
	Перекурсовка		= Запрос.МенеджерВременныхТаблиц.Таблицы["_Перекурсовка"].ПолучитьДанные().Выгрузить();
	
	// для списания ВСЕГДа должно быть списание партий, а для погашения если мы сюда попали, то тоже обязано быть списание партий, для оплат партии не обязательны - по ним ошибку не генерим
	Если ДвиженияПартий.Количество() = 0 Тогда
		Если ЭтоСписаниеЦеннойБумаги ИЛИ ЭтоПогашениеЦеннойБумаги Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ОбъектДокумента.Ссылка,,, Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// у валютных бумаг если оплата или снисание идет в день отличный от дня погашения возможна перекурсовка
	Для каждого СтрокаПерекурсовка Из Перекурсовка Цикл
		
		ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС,
			|СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, 
			|ДисконтНачисленныйВВалютеУчета, ДисконтПремияНачисленныйВВалютеУчета, ДисконтПремияНачисленныйОстаток, 
			|ПереоценкаВВалютеУчета, ПереоценкаОстаток, 
			|КорректировкаЭСПВВалютеУчета, КорректировкаЭСПОстаток,
			|РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
			СтрокаПерекурсовка.ЦеннаяБумага, СтрокаПерекурсовка.УчетныйАктивЕПС,
			СтрокаПерекурсовка.СтоимостьВВалютеУчета, СтрокаПерекурсовка.СтоимостьКупонаВВалютеУчета, СтрокаПерекурсовка.ПереоценкаКупонаВВалютеУчета,
			СтрокаПерекурсовка.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПерекурсовка.ДисконтПремияНачисленныйВВалютеУчета, 0,
			0, 0, 0, 0, 0, 0);
		БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ОбъектДокумента, ПараметрыПерекурсовки, Отказ);	
	
	КонецЦикла;
	
	ПараметрыСписания = Новый Структура();
	ПараметрыСписания.Вставить("ВалютаУчета", ВалютаУчета);
	ПараметрыСписания.Вставить("ЦеннаяБумага", ДанныеПогашения.ЦеннаяБумага);
	ПараметрыСписания.Вставить("Сделка", ПогашениеСсылка);
	ПараметрыСписания.Вставить("ВалютаНоминала", ДанныеБумаги.ВалютаНоминала);
	ПараметрыСписания.Вставить("Контрагент", Контрагент);
	
	// ситуация, когда по списанию списываем только количество
	Если ДвиженияПартий.Итог("Стоимость") = 0 И ЭтоСписаниеЦеннойБумаги Тогда
		
		// это важный момент - от того, была ли оплата в прошлых днях зависит есть ли сальдо на счете 61210 и соответственно нужно ли его списывать или нет
		БылаОплатаВПрошлыхДнях = Ложь; 
		Для каждого СтрокаФактическиеПлатежи Из ФактическиеПлатежи Цикл
			Если СтрокаФактическиеПлатежи.ДеньПлатежа < НачалоДня(ОбъектДокумента.Дата) Тогда
				БылаОплатаВПрошлыхДнях = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если БылаОплатаВПрошлыхДнях Тогда
			ПараметрыСписания.Вставить("КоличествоНаСчете61210", 0);
		КонецЕсли;
		
		ПараметрыСписания.Вставить("ВалютаСделки", ДанныеБумаги.ВалютаНоминала); // вообще не важно, списываем только количество, заполняем т.к. нужно
		
		Для каждого СтрокаДвижения Из ДвиженияПартий Цикл
		
			НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
				НастройкиУчетаОбщие,
				ДанныеПогашения.ЦеннаяБумага,
				СтрокаДвижения.УчетныйАктивЕПС,
				СтрокаДвижения.Партия,
				СтрокаДвижения.СтрокаПартии);
			
			ПараметрыСписания.Вставить("НастройкиУчета", НастройкиУчетаЦеннойБумаги);
			ПараметрыСписания.Вставить("СчетУчета", СтрокаДвижения.УчетныйАктивЕПС.СчетУчета);
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаТела);
			ПараметрыСписания.Вставить("Количество", СтрокаДвижения.Количество);
			ПараметрыСписания.Вставить("Стоимость", 0);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", 0);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
		
		КонецЦикла;
		
		Возврат;
	
	КонецЕсли;
	
	НоминальныеСуммы = ОпределитьНоминальныеСуммыПогашения(ДанныеПогашения, ДанныеБумаги, ОбъектДокумента, ВалютаУчета, Отказ);
	
	// определяем суммы фактических платежей, для завешивания задолженности
	Если ФактическиеПлатежи.Количество() = 0 Тогда // не было платежей - завешивать будем по номинальной стоимости
		СуммаОплаты						= НоминальныеСуммы.НоминальнаяСумма;
		СуммаОплатыВВалютеУчета			= НоминальныеСуммы.НоминальнаяСуммаВВалютеУчета;
		СуммаОплатыКупона				= НоминальныеСуммы.НоминальнаяСуммаКупона;
		СуммаОплатыКупонаВВалютеУчета	= НоминальныеСуммы.НоминальнаяСуммаКупонаВВалютеУчета;
		ВалютаОплаты					= ДанныеБумаги.ВалютаНоминала;
		БылиПлатежи						= Ложь;
	Иначе // собираем платежи для получения фактической суммы	
		СуммаОплаты						= 0;
		СуммаОплатыВВалютеУчета			= 0;
		СуммаОплатыКупона				= 0;
		СуммаОплатыКупонаВВалютеУчета	= 0;
		БылиПлатежи						= Истина;
		
		Для каждого СтрокаФактическиеПлатежи Из ФактическиеПлатежи Цикл
			ВалютаОплаты = СтрокаФактическиеПлатежи.Валюта;
			
			Если ВалютаОплаты = ВалютаУчета Тогда
				ПлатежВВалютеУчета = СтрокаФактическиеПлатежи.Сумма;
			Иначе
				ПлатежВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(СтрокаФактическиеПлатежи.Сумма, ВалютаОплаты, ОбъектДокумента.Дата, ВалютаУчета, ОбъектДокумента.Дата, Отказ);
			КонецЕсли;
			
			Если СтрокаФактическиеПлатежи.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
				СуммаОплаты = СуммаОплаты + СтрокаФактическиеПлатежи.Сумма;
				СуммаОплатыВВалютеУчета = СуммаОплатыВВалютеУчета + ПлатежВВалютеУчета;
			ИначеЕсли СтрокаФактическиеПлатежи.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Тогда
				СуммаОплатыКупона = СуммаОплатыКупона + СтрокаФактическиеПлатежи.Сумма;
				СуммаОплатыКупонаВВалютеУчета = СуммаОплатыКупонаВВалютеУчета + ПлатежВВалютеУчета;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчетаОбщие, ДанныеПогашения.ЦеннаяБумага, Неопределено);
	
	ДанныеПроводок = Новый Структура();
	ДанныеПроводок.Вставить("СуммаОплаты",					СуммаОплаты);
	ДанныеПроводок.Вставить("СуммаОплатыВВалютеУчета",		СуммаОплатыВВалютеУчета);
	ДанныеПроводок.Вставить("НоминальнаяСумма",				НоминальныеСуммы.НоминальнаяСумма);
	ДанныеПроводок.Вставить("НоминальнаяСуммаВВалютеУчета",	НоминальныеСуммы.НоминальнаяСуммаВВалютеУчета);
	ДанныеПроводок.Вставить("Облигация",					ДанныеПогашения.ЦеннаяБумага);
	ДанныеПроводок.Вставить("ВалютаНоминала",				ДанныеБумаги.ВалютаНоминала);
	ДанныеПроводок.Вставить("ВалютаОплаты",					ВалютаОплаты);
	ДанныеПроводок.Вставить("Аналитика",					АналитикаДебиторкиПоТелу);
	ДанныеПроводок.Вставить("Количество",					ДанныеПогашения.Количество);
	ДанныеПроводок.Вставить("Контрагент",					Контрагент);
	ДанныеПроводок.Вставить("НастройкиУчета",				НастройкиУчетаЦеннойБумаги);
	ДанныеПроводок.Вставить("ВалютаУчета",					ВалютаУчета);
	ДанныеПроводок.Вставить("БылиПлатежи",					БылиПлатежи);
	ДанныеПроводок.Вставить("УчитыватьПрошедшиеПлатежи",	УчитыватьПрошедшиеПлатежи);
	
	Если ЭтоОплата Тогда // есть нюанс со счетом 61210: если у нас оплата и списание будет в следующем дне, то количество на счете 61210 не завешиваем, чтобы не вылезло отрицательное сальдо
		
		БумагаСписанаНаКонецДня = (Запрос.МенеджерВременныхТаблиц.Таблицы["_ОстаткиНаКонецДня"].ПолучитьДанные().Выгрузить().Количество() = 0);
		// если бумага на конец дня не списана, значит списание будет в следующем дне и количество на счете 61210 не завешиваем
		Если НЕ БумагаСписанаНаКонецДня Тогда
			ДанныеПроводок.Вставить("Количество", 0);
		КонецЕсли;
		
	КонецЕсли;
	
	СоздатьПроводкиНачалаСделки(ОбъектДокумента, Движения, ПогашениеСсылка, ДанныеПроводок);
	
	Если ТипЗнч(ДанныеПогашения.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") 
		И НастройкиУчетаЦеннойБумаги.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда
		
		ДанныеПроводок = Новый Структура();
		ДанныеПроводок.Вставить("СуммаОплаты",					СуммаОплатыКупона);
		ДанныеПроводок.Вставить("СуммаОплатыВВалютеУчета",		СуммаОплатыКупонаВВалютеУчета);
		ДанныеПроводок.Вставить("НоминальнаяСумма",				НоминальныеСуммы.НоминальнаяСуммаКупона);
		ДанныеПроводок.Вставить("НоминальнаяСуммаВВалютеУчета",	НоминальныеСуммы.НоминальнаяСуммаКупонаВВалютеУчета);
		ДанныеПроводок.Вставить("Облигация",					ДанныеПогашения.ЦеннаяБумага);
		ДанныеПроводок.Вставить("ВалютаНоминала",				ДанныеБумаги.ВалютаНоминала);
		ДанныеПроводок.Вставить("ВалютаОплаты",					ВалютаОплаты);
		ДанныеПроводок.Вставить("Аналитика",					АналитикаДебиторкиПоКупону);
		ДанныеПроводок.Вставить("Количество",					ДанныеПогашения.Количество);
		ДанныеПроводок.Вставить("Контрагент",					Контрагент);
		ДанныеПроводок.Вставить("НастройкиУчета",				НастройкиУчетаЦеннойБумаги);
		ДанныеПроводок.Вставить("ВалютаУчета",					ВалютаУчета);
		ДанныеПроводок.Вставить("БылиПлатежи",					БылиПлатежи);
		ДанныеПроводок.Вставить("УчитыватьПрошедшиеПлатежи",	УчитыватьПрошедшиеПлатежи);
		
		СоздатьПроводкиНачалаСделки(ОбъектДокумента, Движения, ПогашениеСсылка, ДанныеПроводок);
	
	КонецЕсли;
	
	ТаблицаСписанийПоАктивам = Новый ТаблицаЗначений();
	ТаблицаСписанийПоАктивам.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ТаблицаСписанийПоАктивам.Колонки.Добавить("Количество",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаСписанийПоАктивам.Колонки.Добавить("СтоимостьСписания",				Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ТаблицаСписанийПоАктивам.Колонки.Добавить("СтоимостьСписанияВВалютеУчета",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСуммаВалютная.Тип);
	
	ПараметрыСписания.Вставить("ВалютаСделки", ВалютаОплаты);
	
	Для каждого СтрокаДвижения Из ДвиженияПартий Цикл

		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			ДанныеПогашения.ЦеннаяБумага,
			СтрокаДвижения.УчетныйАктивЕПС,
			СтрокаДвижения.Партия,
			СтрокаДвижения.СтрокаПартии);
		
		ПараметрыСписания.Вставить("НастройкиУчета", НастройкиУчетаЦеннойБумаги);
		
		ПроверитьПравильностьСписанияЦеннойБумаги(ДанныеПогашения.ЦеннаяБумага, ОбъектДокумента, ПогашениеСсылка, ДанныеПогашения, СтрокаДвижения, НастройкиУчетаЦеннойБумаги, Отказ);
		
		// ***** СТОИМОСТЬ *****
		// когда-то (в 2019м) году мы не умели правильно вести корректировку ПП и отражали ее в теле
		// потом мы сделали правильно, но по тем счетам, где она уже была, ничего менять было нельзя и мы оставили по ним как есть
		// для этого была введена функция ПолучитьМассивСчетовСПравильнымУчетомПП чтобы отделить Счета ДУ с учетом по-старому (неправильно) и по-новому (правильно)
		ДобавкаКТелу = 0;	
		ДобавкаКТелуВВалютеУчета = 0;	
		Если СтрокаДвижения.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
			И НЕ НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания	// партия (ранее счет ДУ) с неправильным учетом ПП
			И ОбъектДокумента.СчетДоверительногоУправления <> ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_NPF375") // но это не счет "НПФ Национальный АО" - у него все по-своему #522665
			И ДанныеПогашения.ЦеннаяБумага <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002") Тогда // но вот именно эту бумагу стали учитывать правильно, даже у неправильных счетов ДУ
		
			ДобавкаКТелу = СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная;	
			ДобавкаКТелуВВалютеУчета = СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная;	
		
		КонецЕсли;
		
		ПараметрыСписания.Вставить("СчетУчета", СтрокаДвижения.УчетныйАктивЕПС.СчетУчета);
		ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаТела);
		ПараметрыСписания.Вставить("Количество", СтрокаДвижения.Количество);
		ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.Стоимость + ДобавкаКТелу);
		ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.СтоимостьВВалютеУчета + ДобавкаКТелуВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
		
		ПараметрыСписания.Вставить("Количество", 0);
		
		// ***** ПЕРЕОЦЕНКА *****			
		Если СтрокаДвижения.Переоценка <> 0 Тогда 
			
			Если СтрокаДвижения.ПереоценкаВВалютеУчета > 0 Тогда
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
			Иначе
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
			КонецЕсли;
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаПереоценкиТела);

			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.Переоценка);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.ПереоценкаВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
			
		// ***** ИНДЕКСАЦИЯ НОМИНАЛА *****			
		Если СтрокаДвижения.ИндексацияНоминала <> 0 Тогда 
			
			Если СтрокаДвижения.ПереоценкаВВалютеУчета > 0 Тогда
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
			Иначе
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
			КонецЕсли;
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаИндексацииНоминала);
			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.ИндексацияНоминала);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.ИндексацияНоминала);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
			
		// ***** КОРРЕКТИРОВКА ЭСП *****
		Если СтрокаДвижения.КорректировкаЭСП <> 0 Тогда 
			
			Если СтрокаДвижения.КорректировкаЭСП > 0 Тогда
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКорректировокА);
			Иначе
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКорректировокП);
			КонецЕсли;
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка());
			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.КорректировкаЭСП);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.КорректировкаЭСПВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
			
		Если СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0 Тогда 
			
			Если СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные > 0 Тогда
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт);
			Иначе
				ПараметрыСписания.Вставить("СчетУчета",	СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт);
			КонецЕсли;
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
		
		// ***** ДИСКОНТ *****			
		Если СтрокаДвижения.ДисконтНачисленный <> 0 Тогда 
			
			ПараметрыСписания.Вставить("СчетУчета", СтрокаДвижения.УчетныйАктивЕПС.СчетУчета);
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаДисконта);
			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.ДисконтНачисленный);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.ДисконтНачисленныйВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
			
		// ***** ПРЕМИЯ *****			
		Если СтрокаДвижения.ПремияНачисленная <> 0 Тогда 
			
			ПараметрыСписания.Вставить("СчетУчета", СтрокаДвижения.УчетныйАктивЕПС.СчетУчета);
			ПараметрыСписания.Вставить("ДополнительнаяАналитика", АналитикаПремии);
			ПараметрыСписания.Вставить("Стоимость", СтрокаДвижения.ПремияНачисленная);
			ПараметрыСписания.Вставить("СтоимостьВВалютеУчета", СтрокаДвижения.ПремияНачисленнаяВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ);
			
		КонецЕсли;
		
		Если ТипЗнч(ДанныеПогашения.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
			
			Если СтрокаДвижения.СтоимостьКупона <> 0 Тогда
				
				// ***** купон *****
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СтрокаДвижения.СтоимостьКупонаВВалютеУчета, "Погашение купона");
				
				// дебет
				Если НастройкиУчетаЦеннойБумаги.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда
					
					Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
						
					Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
					Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеСсылка;
					
				ИначеЕсли ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
					
					Проводка.СчетДт = СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКупона;
					
					Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
					
					Проводка.ВалютаДт = ДанныеБумаги.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = СтрокаДвижения.СтоимостьКупона;
					
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
					
					Проводка.СубконтоДт.Контрагенты = Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеСсылка;
					
					Проводка.ВалютаДт  = ДанныеБумаги.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = СтрокаДвижения.СтоимостьКупона;
									
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				КонецЕсли;

				// кредит
				Проводка.СчетКт = СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКупона;
				
				Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				
				Проводка.ВалютаКт = ДанныеБумаги.ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = СтрокаДвижения.СтоимостьКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
				
			КонецЕсли;
			
			Если СтрокаДвижения.ПереоценкаКупона <> 0 Тогда
				
				// ***** переоценка купона *****
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СтрокаДвижения.ПереоценкаКупонаВВалютеУчета, "Погашение купона");
				
				// дебет
				Если НастройкиУчетаЦеннойБумаги.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда
					
					Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
						
					Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
					Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеСсылка;
					
				ИначеЕсли ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
					
					Проводка.СчетДт = СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКупона;
					
					Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
					
					Проводка.ВалютаДт = ДанныеБумаги.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = СтрокаДвижения.ПереоценкаКупона;
					
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
					
					Проводка.СубконтоДт.Контрагенты = Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеСсылка;
					
					Проводка.ВалютаДт  = ДанныеБумаги.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = СтрокаДвижения.ПереоценкаКупона;
									
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				КонецЕсли;

				// кредит
				Проводка.СчетКт = СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаКупона;
				
				Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				
				Проводка.ВалютаКт = ДанныеБумаги.ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = СтрокаДвижения.ПереоценкаКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
				
			КонецЕсли;	
			
		КонецЕсли;			
			
		Если СтрокаДвижения.СуммаРезервовПодОбесценение > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СтрокаДвижения.СуммаРезервовПодОбесценение, "Списание резерва");	
			
			
			Проводка.СчетДт = СтрокаДвижения.УчетныйАктивЕПС.СчетУчетаРезервов;
			
			Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
			Проводка.СубконтоДт.Резервы	= СтрокаДвижения.АналитикаРезерва; 
			
			Проводка.ВалютаДт			= ВалютаУчета;
			Проводка.ВалютнаяСуммаДт	= СтрокаДвижения.СуммаРезервовПодОбесценение;
			
			
			Проводка.СчетКт = ПланыСчетов.Единый.НайтиПоКоду(СтрокаДвижения.УчетныйАктивЕПС.АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета) ;
			
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= СтрокаДвижения.УчетныйАктивЕПС.АналитикаСписанияРезервов;
			Проводка.СубконтоКт.ЦенныеБумаги							= ДанныеПогашения.ЦеннаяБумага;
			
		КонецЕсли;
		
		СтрокаСписанийПоАктивам = ТаблицаСписанийПоАктивам.Добавить();
		СтрокаСписанийПоАктивам.УчетныйАктивЕПС = СтрокаДвижения.УчетныйАктивЕПС;
		СтрокаСписанийПоАктивам.Количество = СтрокаДвижения.КоличествоОстаток;
		СтрокаСписанийПоАктивам.СтоимостьСписания = СтрокаДвижения.Стоимость + СтрокаДвижения.ДисконтНачисленный + СтрокаДвижения.ПремияНачисленная + СтрокаДвижения.Переоценка + СтрокаДвижения.ИндексацияНоминала
			+ СтрокаДвижения.КорректировкаЭСП + СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные + ДобавкаКТелу;
		СтрокаСписанийПоАктивам.СтоимостьСписанияВВалютеУчета = СтрокаДвижения.СтоимостьВВалютеУчета + СтрокаДвижения.ДисконтНачисленныйВВалютеУчета + СтрокаДвижения.ПремияНачисленнаяВВалютеУчета + СтрокаДвижения.ПереоценкаВВалютеУчета + СтрокаДвижения.ИндексацияНоминала
			+ СтрокаДвижения.КорректировкаЭСПВВалютеУчета + СтрокаДвижения.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета + ДобавкаКТелуВВалютеУчета;
		
	КонецЦикла; 
	
	// на момент погашения стоимость ценной бумаги (тело + дисконт) не доросла до номинала
	// или же наоборот еще превышает номинал
	Если НоминальныеСуммы.НоминальнаяСумма <> ТаблицаСписанийПоАктивам.Итог("СтоимостьСписания") 
		ИЛИ НоминальныеСуммы.НоминальнаяСуммаВВалютеУчета <> ТаблицаСписанийПоАктивам.Итог("СтоимостьСписанияВВалютеУчета") Тогда
		
		ТаблицаСписанийПоАктивам.Свернуть("УчетныйАктивЕПС", "Количество,СтоимостьСписания,СтоимостьСписанияВВалютеУчета");
		
		Для каждого СтрокаСписанийПоАктивам Из ТаблицаСписанийПоАктивам Цикл
			НоминальнаяСуммаАктива = Окр(НоминальныеСуммы.НоминальнаяСумма / ДанныеПогашения.Количество * СтрокаСписанийПоАктивам.Количество, 2);
			НоминальнаяСуммаАктиваВВалютеУчета = Окр(НоминальныеСуммы.НоминальнаяСуммаВВалютеУчета / ДанныеПогашения.Количество * СтрокаСписанийПоАктивам.Количество, 2);
			
			Если СтрокаСписанийПоАктивам.СтоимостьСписанияВВалютеУчета < НоминальнаяСуммаАктиваВВалютеУчета Тогда
				
				СуммаДосписать = НоминальнаяСуммаАктива - СтрокаСписанийПоАктивам.СтоимостьСписания;
				СуммаДосписатьВВалютеУчета = НоминальнаяСуммаАктиваВВалютеУчета - СтрокаСписанийПоАктивам.СтоимостьСписанияВВалютеУчета;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СуммаДосписатьВВалютеУчета, "Погашение ценной бумаги");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ПогашениеСсылка;
				
				// кредит
				Проводка.СчетКт = СтрокаСписанийПоАктивам.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
				
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = СтрокаСписанийПоАктивам.УчетныйАктивЕПС.АналитикаДоходовОтОпераций;
				Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				
			ИначеЕсли СтрокаСписанийПоАктивам.СтоимостьСписанияВВалютеУчета > НоминальнаяСуммаАктиваВВалютеУчета Тогда
				
				СуммаДосписать = СтрокаСписанийПоАктивам.СтоимостьСписания - НоминальнаяСуммаАктива;
				СуммаДосписатьВВалютеУчета = СтрокаСписанийПоАктивам.СтоимостьСписанияВВалютеУчета - НоминальнаяСуммаАктиваВВалютеУчета;
				
				// с реализации на расходы
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СуммаДосписатьВВалютеУчета, "Погашение ценной бумаги");
				
				// дебет
				Проводка.СчетДт = СтрокаСписанийПоАктивам.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
				
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = СтрокаСписанийПоАктивам.УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
				Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
				
				Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПогашения.ЦеннаяБумага;
				Проводка.СубконтоКт.ОснованиеРасчетов = ПогашениеСсылка;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;											
	
КонецПроцедуры

Процедура СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент) 

	Если ПараметрыПроводки.Сумма = 0 И ПараметрыПроводки.СуммаВВалютеУчета = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
	
	// дебет
	Проводка.СчетДт = ПараметрыПроводки.СчетУчета;
	
	Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
	
	Если ПараметрыПроводки.Количество <> 0 Тогда
		Проводка.КоличествоДт = ПараметрыПроводки.Количество;	
	КонецЕсли;
	
	Проводка.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
	Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.Сумма;
	
	Проводка.ДополнительнаяАналитикаДт = ПараметрыПроводки.Аналитика;
	
	// кредит
	Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
	
	Проводка.СубконтоКт.Контрагенты = Контрагент;
	Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыПроводки.Сделка;
	
	Проводка.ВалютаКт        = ПараметрыПроводки.ВалютаНоминала;
	Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.Сумма;
	
	
	Проводка.Партия = ПараметрыПроводки.Партия;
	Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;

КонецПроцедуры

Процедура СформироватьПроводкуРеализацииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ, ДопОписание = "") 

	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыОплаты.СуммаРеализацииВВалютеУчета, "Продажа ценной бумаги " + ДопОписание);
	
	Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
	
	Проводка.СубконтоДт.Контрагенты = ПараметрыОплаты.Контрагент;
	Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыОплаты.Сделка;
	
	Проводка.ВалютаДт        = ПараметрыОплаты.ВалютаСделки;
	Проводка.ВалютнаяСуммаДт = ПараметрыОплаты.СуммаРеализации;
	
	
	Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
	
	Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыОплаты.ЦеннаяБумага;
	Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыОплаты.Сделка;
	
	Проводка.КоличествоКт = ПараметрыОплаты.Количество;

КонецПроцедуры

Процедура СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыСписания, Отказ, ДопОписание = "") 

	Если ПараметрыСписания.СтоимостьВВалютеУчета > 0 ИЛИ ПараметрыСписания.СтоимостьВВалютеУчета = 0 И ПараметрыСписания.Количество <> 0 Тогда // погашение списывает только количество с пустой суммой, это нормально для ЕПС
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыСписания.СтоимостьВВалютеУчета, "Списание себестоимости ценной бумаги(" + ?(ДопОписание = "", Строка(ПараметрыСписания.ДополнительнаяАналитика), ДопОписание) +")");
		
		Если (ПараметрыСписания.ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный
			ИЛИ ПараметрыСписания.ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный)
			И ПараметрыСписания.Свойство("НастройкиУчета") Тогда // при полном погашении есть нюансы...
			
			Если ПараметрыСписания.НастройкиУчета.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда
			
				Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыСписания.Сделка;
				
				Проводка.КоличествоДт = ПараметрыСписания.Количество;
				
			ИначеЕсли ПараметрыСписания.НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = ПараметрыСписания.СчетУчета;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
				
				Проводка.КоличествоДт = ПараметрыСписания.Количество;
				Проводка.ВалютаДт  = ПараметрыСписания.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = ПараметрыСписания.Стоимость;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
			
			Иначе
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = ПараметрыСписания.Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыСписания.Сделка;
				
				Проводка.ВалютаДт  = ПараметрыСписания.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = ПараметрыСписания.Стоимость;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
				
			КонецЕсли;
			
		Иначе
			
			Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
			
			Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
			Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыСписания.Сделка;
			
			Проводка.КоличествоДт = ПараметрыСписания.Количество;
			Если ПараметрыСписания.Свойство("КоличествоНаСчете61210") Тогда
				Проводка.КоличествоДт = ПараметрыСписания.КоличествоНаСчете61210;
			КонецЕсли;
			
		КонецЕсли;
		
		
		Проводка.СчетКт = ПараметрыСписания.СчетУчета;
		
		Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
		
		Проводка.КоличествоКт = ПараметрыСписания.Количество;
		Проводка.ВалютаКт = ПараметрыСписания.ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = ПараметрыСписания.Стоимость;
		
		Проводка.ДополнительнаяАналитикаКт = ПараметрыСписания.ДополнительнаяАналитика;
		
		Если ПараметрыСписания.Свойство("Партия") Тогда
			Проводка.Партия = ПараметрыСписания.Партия;
			Проводка.СтрокаПартии = ПараметрыСписания.СтрокаПартии;
		КонецЕсли;
		
	ИначеЕсли ПараметрыСписания.СтоимостьВВалютеУчета < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -ПараметрыСписания.СтоимостьВВалютеУчета, "Списание себестоимости ценной бумаги(" + ?(ДопОписание = "", Строка(ПараметрыСписания.ДополнительнаяАналитика), ДопОписание) +")");
		
		Проводка.СчетДт = ПараметрыСписания.СчетУчета;
		
		Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
		
		Проводка.ВалютаДт = ПараметрыСписания.ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = -ПараметрыСписания.Стоимость;
		
		Проводка.ДополнительнаяАналитикаДт = ПараметрыСписания.ДополнительнаяАналитика;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		
		Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыСписания.ЦеннаяБумага;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыСписания.Сделка;
		
		Если ПараметрыСписания.Свойство("Партия") Тогда
			Проводка.Партия = ПараметрыСписания.Партия;
			Проводка.СтрокаПартии = ПараметрыСписания.СтрокаПартии;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьПроводкиПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, Контрагент) Экспорт

	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.Стоимость КАК Стоимость,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки > 0
		|				ИЛИ БухПартииЦенныхБумаг.ДисконтПремияНачисленный > 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленный
		|	КОНЕЦ КАК Дисконт,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки > 0
		|				ИЛИ БухПартииЦенныхБумаг.ДисконтПремияНачисленный > 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|	КОНЕЦ КАК ДисконтВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки < 0
		|				ИЛИ БухПартииЦенныхБумаг.ДисконтПремияНачисленный < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленный
		|	КОНЕЦ КАК Премия,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки < 0
		|				ИЛИ БухПартииЦенныхБумаг.ДисконтПремияНачисленный < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|	КОНЕЦ КАК ПремияВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СтоимостьКупона,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ИндексацияНоминала КАК ИндексацияНоминала,
		|	БухПартииЦенныхБумаг.Количество КАК Количество
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ОбъектДокумента.Ссылка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыПроводки = Новый Структура;
		
		Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке") Тогда
			ПараметрыПроводки.Вставить("Сделка",			ОбъектДокумента.Основание);
		Иначе
			ПараметрыПроводки.Вставить("Сделка",			ОбъектДокумента.Ссылка);
		КонецЕсли;		
		
		ПараметрыПроводки.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчета);
		ПараметрыПроводки.Вставить("ЦеннаяБумага",		ВыборкаДетальныеЗаписи.ЦеннаяБумага);
		ПараметрыПроводки.Вставить("ВалютаНоминала",	ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала);
		ПараметрыПроводки.Вставить("Партия",			ВыборкаДетальныеЗаписи.Партия);
		ПараметрыПроводки.Вставить("СтрокаПартии",		ВыборкаДетальныеЗаписи.СтрокаПартии);
		
		ПараметрыПроводки.Вставить("Сумма",				ВыборкаДетальныеЗаписи.Стоимость);
		ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета);
		ПараметрыПроводки.Вставить("Количество",		ВыборкаДетальныеЗаписи.Количество);
		ПараметрыПроводки.Вставить("Содержание",		"Покупка ценной бумаги (тело)");
		ПараметрыПроводки.Вставить("Аналитика",			АналитикаТела);
		
		СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент);
		
		ПараметрыПроводки.Вставить("Количество",		0);
		
		ПараметрыПроводки.Вставить("Сумма",				ВыборкаДетальныеЗаписи.Дисконт);
		ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.ДисконтВВалютеУчета);
		ПараметрыПроводки.Вставить("Содержание",		"Покупка ценной бумаги (дисконт)");
		ПараметрыПроводки.Вставить("Аналитика",			АналитикаДисконта);
		
		СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент);
		
		
		ПараметрыПроводки.Вставить("Сумма",				ВыборкаДетальныеЗаписи.Премия);
		ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.ПремияВВалютеУчета);
		ПараметрыПроводки.Вставить("Содержание",		"Покупка ценной бумаги (премия)");
		ПараметрыПроводки.Вставить("Аналитика",			АналитикаПремии);
		
		СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент);
		
		
		ПараметрыПроводки.Вставить("Сумма",				ВыборкаДетальныеЗаписи.ИндексацияНоминала);
		ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.ИндексацияНоминала);
		ПараметрыПроводки.Вставить("Содержание",		"Покупка ценной бумаги (индексация)");
		ПараметрыПроводки.Вставить("Аналитика",			АналитикаИндексацииНоминала);
		
		СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент);
		
		
		ПараметрыПроводки.Вставить("СчетУчета",			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаКупона);
		ПараметрыПроводки.Вставить("Сумма",				ВыборкаДетальныеЗаписи.СтоимостьКупона);
		ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета);
		ПараметрыПроводки.Вставить("Содержание",		"Покупка ценной бумаги (купон)");
		ПараметрыПроводки.Вставить("Аналитика",			АналитикаКупонПриобретенный);
		
		СформироватьПроводкуПокупкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки, Контрагент);
		
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки) Экспорт

	Если ПараметрыПроводки.Сумма = 0 И ПараметрыПроводки.СуммаВВалютеУчета = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// #473904 - извраты от СНГ
	// СНГ настоял на своей схеме закрытия парных счетов корректировок ЭСП, причем они ведут учет партий на лицевых счетах
	// остальные фонды не маятся дурью и закрывают из по обычной схеме парных, 
	// но СНГ не смог реализовать ее для этих счетов - они сделали вечернюю свертку парных
	// после ряда споров, договорились, что мы будем сворачивать либо после операции (это место), либо в переоценке (см. модуль ее) - это даст такой же результат, как у них
	Если ПараметрыПроводки.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка() 
		И (ПараметрыПроводки.СчетДоходовРасходов = ПланыСчетов.Единый.ПроцентныеДоходы05 ИЛИ ПараметрыПроводки.СчетДоходовРасходов = ПланыСчетов.Единый.ПроцентныеДоходы06)
		И ПараметрыПроводки.НастройкиУчета.СворачиватьПарныеСчетаКорректировокПутемПереброски Тогда
		СформироватьПроводкиНачисленияКорректировкиЭСПСПереброской(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПроводки.СуммаВВалютеУчета > 0 Тогда
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетУчета;
		
		ПроводкаНачисления.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		ПроводкаНачисления.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаНачисления.ВалютнаяСуммаДт = ПараметрыПроводки.Сумма;
		
		ПроводкаНачисления.ДополнительнаяАналитикаДт = ПараметрыПроводки.Аналитика;
		
		// кредит
		ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетДоходовРасходов;
		
		ПроводкаНачисления.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУ;
		ПроводкаНачисления.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		Если ПараметрыПроводки.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт
			ИЛИ ПараметрыПроводки.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный Тогда
		
			ПроводкаНачисления.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;
		
		КонецЕсли;
		
		Если ПроводкаНачисления.СчетКт.Валютный Тогда // для счетов 106ХХ
			ПроводкаНачисления.ВалютаКт = ПараметрыПроводки.ВалютаНоминала;
			ПроводкаНачисления.ВалютнаяСуммаКт = ПараметрыПроводки.Сумма;
		КонецЕсли;
		
	Иначе
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетДоходовРасходов;
		
		ПроводкаНачисления.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУ;
		ПроводкаНачисления.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		Если ПараметрыПроводки.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт
			ИЛИ ПараметрыПроводки.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный Тогда
		
			ПроводкаНачисления.ДополнительнаяАналитикаДт = ПараметрыПроводки.Аналитика;
		
		КонецЕсли;
		
		Если ПроводкаНачисления.СчетДт.Валютный Тогда // для счетов 106ХХ
			ПроводкаНачисления.ВалютаДт = ПараметрыПроводки.ВалютаНоминала;
			ПроводкаНачисления.ВалютнаяСуммаДт = -ПараметрыПроводки.Сумма;
		КонецЕсли;
		
		// кредит
		ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетУчета;
		
		ПроводкаНачисления.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		ПроводкаНачисления.ВалютаКт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаНачисления.ВалютнаяСуммаКт = -ПараметрыПроводки.Сумма;
		
		ПроводкаНачисления.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;
		
	КонецЕсли;
	
	ПроводкаНачисления.Партия = ПараметрыПроводки.Партия;
	ПроводкаНачисления.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
	
	ПроверитьПарные = "";
	Если НЕ ПараметрыПроводки.Свойство("ПроверитьПарные", ПроверитьПарные) Тогда
		Возврат;
	КонецЕсли;
	Если ПроверитьПарные = "" Тогда
		Возврат;
	КонецЕсли;
	 	
	// проверим парность по счету учета
	НачальноеСальдоПоСчету500 = ПараметрыПроводки.СуммаБалансоваяВВалютеУчета;
	НачальноеСальдоПоСчету500Вал = ПараметрыПроводки.СуммаБалансовая;
	
	КонечноеСальдоПоСчету500 = ПараметрыПроводки.СуммаБалансоваяВВалютеУчета + ПараметрыПроводки.СуммаВВалютеУчета;
	КонечноеСальдоПоСчету500Вал = ПараметрыПроводки.СуммаБалансовая + ПараметрыПроводки.Сумма;
	
	НачальноеСальдоПоСчету500Парному = 0;
	КонечноеСальдоПоСчету500Парному = 0;
	
	НачальноеСальдоПоСчету500ПарномуВал = 0;
	КонечноеСальдоПоСчету500ПарномуВал = 0;
	   	
	НачальноеСальдоПоСчету700 = ПараметрыПроводки.СуммаСНачалаГода - ПараметрыПроводки.СуммаВВалютеУчета;
	КонечноеСальдоПоСчету700 = ПараметрыПроводки.СуммаСНачалаГода;
	
	Если ПараметрыПроводки.Свойство("СуммаСНачалаГодаНачальная") И ПараметрыПроводки.Свойство("СуммаСНачалаГодаКонечная") Тогда
	
		НачальноеСальдоПоСчету700 = ПараметрыПроводки.СуммаСНачалаГодаНачальная;
		КонечноеСальдоПоСчету700 = ПараметрыПроводки.СуммаСНачалаГодаКонечная;
	
	КонецЕсли;
	
	НачальноеСальдоПоСчету700Парному = 0;
	КонечноеСальдоПоСчету700Парному = 0;
	
	СуммаПереброскиВВалютеУчета = 0;
	СуммаПереброски = 0;
	//  была отрицательная после переоценки стала положительная, значит мы начисляли ПОЛОЖИТЕЛЬНУЮ сумму
	Если НачальноеСальдоПоСчету500 < 0 И КонечноеСальдоПоСчету500 > 0 Тогда
		
		СуммаПереброскиВВалютеУчета = КонечноеСальдоПоСчету500;
		СуммаПереброски = КонечноеСальдоПоСчету500Вал;
		
		// уменьшим суммы начисления
		ПроводкаНачисления.ВалютнаяСуммаДт = ПроводкаНачисления.ВалютнаяСуммаДт - СуммаПереброски;
		ПроводкаНачисления.Сумма = ПроводкаНачисления.Сумма - СуммаПереброскиВВалютеУчета;
		Если ПроводкаНачисления.СчетКт.Валютный Тогда // 106й счет
		    ПроводкаНачисления.ВалютнаяСуммаКт = ПроводкаНачисления.ВалютнаяСуммаКт - СуммаПереброски;
		КонецЕсли;
		
		// сделаем проводку по парным 500м-700м счетам
		ПроводкаПарные = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаПереброскиВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаПарные.СчетДт = ПараметрыПроводки.СчетУчетаПарный;
		
		ПроводкаПарные.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		ПроводкаПарные.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаПарные.ВалютнаяСуммаДт = СуммаПереброски;
		
		ПроводкаПарные.ДополнительнаяАналитикаДт = ПараметрыПроводки.Аналитика;
		
		// кредит
		ПроводкаПарные.СчетКт = ПараметрыПроводки.СчетДоходовРасходовПарный;
		
		ПроводкаПарные.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		ПроводкаПарные.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУПарный;
		
		Если ПроводкаПарные.СчетКт.Валютный Тогда // для счетов 106ХХ
			ПроводкаПарные.ВалютаКт = ПараметрыПроводки.ВалютаНоминала;
			ПроводкаПарные.ВалютнаяСуммаКт = СуммаПереброски;
		КонецЕсли;
		
		ПроводкаПарные.Партия = ПараметрыПроводки.Партия;
		ПроводкаПарные.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
		
