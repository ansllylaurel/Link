			|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта
			|ПОМЕСТИТЬ _ТаблицаНакладныхРасходов
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|ГДЕ
			|	ЗадолженностиПоДенежнымСредствам.Основание = &Сделка
			|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления В(&СписокСтратегий)
			|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.поСделке)
			|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаСделки И &ДатаДокумента
			|	И ЗадолженностиПоДенежнымСредствам.Активность
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗадолженностиПоДенежнымСредствам.Период,
			|	ЗадолженностиПоДенежнымСредствам.Валюта";
	КонецЕсли;	

	Запрос.УстановитьПараметр("Регистратор",	ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",		ВидУчета);
	
	Запрос.УстановитьПараметр("Сделка",							Сделка);
	Запрос.УстановитьПараметр("ДатаДокумента",					КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаСделки",						НачалоДня(Сделка.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ДокументОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий",				Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ДокументОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("СубконтоЦБ_Р", СубконтоЦБ_Р);
	Запрос.УстановитьПараметр("АналитикаРезерваПоУмолчанию", Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	Запрос.УстановитьПараметр("Период", Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ДокументОбъект.СчетДоверительногоУправления));
	
	Запрос.Выполнить();
	
	ДвиженияПартий				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияПартий"].ПолучитьДанные().Выгрузить();
	АналитикаРезервов			= Запрос.МенеджерВременныхТаблиц.Таблицы["_АналитикаРезервов"].ПолучитьДанные().Выгрузить();
	ТаблицаНакладныхРасходов	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаНакладныхРасходов"].ПолучитьДанные().Выгрузить();
	
	ОстаткиПартий = Неопределено;
	Если НужнаТаблицаОстатков Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
			|	БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК ИндексацияНоминалаОстаток,
			|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
			|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
			|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток
			|ПОМЕСТИТЬ _ОстаткиПартий
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&ДоДокумента,
			|			ВидУчета = &ВидУчета
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
			|				И (УчетныйАктивЕПС, ЦеннаяБумага, Партия, СтрокаПартии) В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|						ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
			|						ДвиженияПартий.Партия КАК Партия,
			|						ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
			|					ИЗ
			|						_ДвиженияПартий КАК ДвиженияПартий)) КАК БухПартииЦенныхБумагОстатки";
		
		Запрос.УстановитьПараметр("ДоДокумента",    Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация",    ДокументОбъект.Организация);
		
		Запрос.Выполнить();
		
		ОстаткиПартий = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОстаткиПартий"].ПолучитьДанные().Выгрузить();
	КонецЕсли;
	
	ТаблицаПредварительныхЗатрат = Неопределено;
	Если НужнаТаблицаПредварительныхЗатрат Тогда
		
		Если ЕстьМенеджерВременныхТаблицДвиженияПартийЗаПериод Тогда
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ТаблицаПредварительныхЗатратПолная.Валюта КАК Валюта,
				|	_ТаблицаПредварительныхЗатратПолная.Сумма КАК Сумма,
				|	_ТаблицаПредварительныхЗатратПолная.ВалютнаяСумма КАК ВалютнаяСумма,
				|	_ТаблицаПредварительныхЗатратПолная.ДатаСделки КАК ДатаСделки,
				|	_ТаблицаПредварительныхЗатратПолная.ВалютаСделки КАК ВалютаСделки
				|ПОМЕСТИТЬ _ТаблицаПредварительныхЗатрат
				|ИЗ
				|	_ТаблицаПредварительныхЗатратПолная КАК _ТаблицаПредварительныхЗатратПолная
				|ГДЕ
				|	_ТаблицаПредварительныхЗатратПолная.Сделка = &Сделка";
		Иначе
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
				|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК Сумма,
				|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСумма,
				|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка).Дата КАК ДатаСделки,
				|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Документ.Сделка).ВалютаСделки КАК ВалютаСделки
				|ПОМЕСТИТЬ _ТаблицаПредварительныхЗатрат
				|ИЗ
				|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
				|			&НачалоДня,
				|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05),
				|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов),
				|			Субконто1 = &Сделка
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("НачалоДня",	Новый Граница(НачалоДня(ДокументОбъект.Дата), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Сделка",		Сделка);
		
		Запрос.Выполнить();
		
		ТаблицаПредварительныхЗатрат = Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаПредварительныхЗатрат"].ПолучитьДанные().Выгрузить();
	
	КонецЕсли;
	
	ТаблицаДвиженийПоГлавеГ = Неопределено;
	Если ПараметрыДляГлавыГ <> Неопределено Тогда
			
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт КАК СчетДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
			|	NULL КАК СубконтоДт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт КАК СчетКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
			|	NULL КАК СубконтоКт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаДт КАК ВалютаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаКт КАК ВалютаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоДт КАК КоличествоДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоКт КАК КоличествоКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Сумма КАК Сумма,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаДт КАК ДополнительнаяАналитикаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаКт КАК ДополнительнаяАналитикаКт,
			|	ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетДвиженияССубконто.Регистратор) КАК ТипРегистратора
			|ПОМЕСТИТЬ Движения
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ДвиженияССубконто(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Счет = &СчетДС
			|				И Субконто1 = &ОснованиеРасчетов
			|				И Активность,
			|			,
			|			) КАК ЕдиныйБухгалтерскийУчетДвиженияССубконто
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт1,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоКт1,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоКт2,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.КоличествоКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Сумма,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютнаяСуммаКт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаДт,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ДополнительнаяАналитикаКт,
			|	ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетДвиженияССубконто.Регистратор)
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ДвиженияССубконто(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Счет = &СчетЦБ
			|				И Субконто1 = &ОснованиеРасчетов
			|				И Активность,
			|			,
			|			) КАК ЕдиныйБухгалтерскийУчетДвиженияССубконто
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Движения.СчетДт КАК СчетДт,
			|	Движения.СубконтоДт1 КАК СубконтоДт1,
			|	Движения.СубконтоДт2 КАК СубконтоДт2,
			|	Движения.СчетКт КАК СчетКт,
			|	Движения.СубконтоКт1 КАК СубконтоКт1,
			|	Движения.СубконтоКт2 КАК СубконтоКт2,
			|	Движения.ВалютаДт КАК ВалютаДт,
			|	Движения.ВалютаКт КАК ВалютаКт,
			|	СУММА(Движения.КоличествоДт) КАК КоличествоДт,
			|	СУММА(Движения.КоличествоКт) КАК КоличествоКт,
			|	СУММА(Движения.Сумма) КАК Сумма,
			|	СУММА(Движения.ВалютнаяСуммаДт) КАК ВалютнаяСуммаДт,
			|	СУММА(Движения.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
			|	Движения.ДополнительнаяАналитикаДт КАК ДополнительнаяАналитикаДт,
			|	Движения.ДополнительнаяАналитикаКт КАК ДополнительнаяАналитикаКт
			|ПОМЕСТИТЬ _ТаблицаДвиженийПоГлавеГ
			|ИЗ
			|	Движения КАК Движения
			|
			|СГРУППИРОВАТЬ ПО
			|	Движения.СчетДт,
			|	Движения.СубконтоДт1,
			|	Движения.СубконтоДт2,
			|	Движения.СчетКт,
			|	Движения.СубконтоКт1,
			|	Движения.СубконтоКт2,
			|	Движения.ВалютаДт,
			|	Движения.ВалютаКт,
			|	Движения.ДополнительнаяАналитикаДт,
			|	Движения.ДополнительнаяАналитикаКт";
		
		Если ПараметрыДляГлавыГ.ПереоценкаБумагПриПродажеНаСчетахГлавыГ Тогда // для данной настройки нужно разбивать отдельно сделку и переоценку
			Запрос.Текст = Запрос.Текст + ", ТипРегистратора";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Сделка.Дата));
		Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
		Запрос.УстановитьПараметр("ОснованиеРасчетов", Сделка);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ДокументОбъект.СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("СчетДС", ПараметрыДляГлавыГ.СчетДСГлаваГ);
		Запрос.УстановитьПараметр("СчетЦБ", ПараметрыДляГлавыГ.СчетЦБГлаваГ);
		
		Запрос.Выполнить();
		
		ТаблицаДвиженийПоГлавеГ = Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаДвиженийПоГлавеГ"].ПолучитьДанные().Выгрузить();
	
	КонецЕсли;
	
	Возврат Новый Структура("ДвиженияПартий, ОстаткиПартий, ТаблицаНакладныхРасходов, ТаблицаДвиженийПоГлавеГ, ТаблицаПредварительныхЗатрат, АналитикаРезервов", 
							ДвиженияПартий, ОстаткиПартий, ТаблицаНакладныхРасходов, ТаблицаДвиженийПоГлавеГ, ТаблицаПредварительныхЗатрат, АналитикаРезервов);
	
КонецФункции

Функция ПолучитьЗадолженностьПоКомиссииНаГраницу(ОбъектДокумента, СписокСделок, ВидЗадолженности, Граница, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.Основание КАК Сделка
		|ПОМЕСТИТЬ ТаблицаСделок
		|ИЗ
		|	&ТаблицаСделок КАК Сделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Сделка
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Граница,
		|			СчетДоверительногоУправления В(&СписокСтратегий)
		|				И ВидЗадолженности = &ВидЗадолженности
		|				И Основание В
		|					(ВЫБРАТЬ
		|						ТаблицаСделок.Сделка
		|					ИЗ
		|						ТаблицаСделок КАК ТаблицаСделок)) КАК ЗадолженностиПоДенежнымСредствамОстатки";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	Запрос.УстановитьПараметр("ТаблицаСделок", СписокСделок);
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ОбъектДокумента.СчетДоверительногоУправления));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьОстаткиПоказателейПартий(ОбъектДокумента, ТаблицаЦБ, ВидУчета) Экспорт
	//ТаблицаЦБ содержит колонки: ЦеннаяБумага, Рынок, УчетныйАктивЕПС
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ1.ЦеннаяБумага,
		|	ТаблицаЦБ1.УчетныйАктивЕПС
		|ПОМЕСТИТЬ ТаблицаЦБ
		|ИЗ
		|	&ТаблицаЦБ КАК ТаблицаЦБ1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.УчетныйАктивЕПС,
		|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток, 0)) КАК КорректировкаЭСПОстаток,
		|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток, 0)) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток, 0)) КАК ПереоценкаОстаток
		|ИЗ
		|	ТаблицаЦБ КАК ТаблицаЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ДоДокумента,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И (ЦеннаяБумага, УчетныйАктивЕПС) В
		|						(ВЫБРАТЬ
		|							ТаблицаЦБ.ЦеннаяБумага,
		|							ТаблицаЦБ.УчетныйАктивЕПС
		|						ИЗ
		|							ТаблицаЦБ КАК ТаблицаЦБ)) КАК БухПартииЦенныхБумагОстатки
		|		ПО ТаблицаЦБ.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И ТаблицаЦБ.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦБ.ЦеннаяБумага,
		|	ТаблицаЦБ.УчетныйАктивЕПС";
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ТаблицаЦБ", ТаблицаЦБ);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

Функция ОпределитьУчетныеАктивыЕПСДляСделки(Сделка) Экспорт
	
	Сделки = Новый ТаблицаЗначений;
	Сделки.Колонки.Добавить("Основание", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	Сделки.Добавить().Основание = Сделка;
	
	Возврат ПолучитьРаспределениеПоВидуАктива(Сделки).ВыгрузитьКолонку("УчетныйАктивЕПС");
	
КонецФункции

Функция ПолучитьРаспределениеПоВидуАктива(Сделки) Экспорт
	//На входе Таблица значений с колонками: Основание, ЦеннаяБумага (необязательно).
	//на выходе таблица в колонками: Сделка, ЦеннаяБумага, УчетныйАктивЕПС, Количество, КоличествоСделки
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Сделка", Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ПустаяТаблица.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Акции"));
	ПустаяТаблица.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ПустаяТаблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ПустаяТаблица.Колонки.Добавить("КоличествоСделки", Новый ОписаниеТипов("Число"));
	
	Если Сделки.Колонки.Найти("ЦеннаяБумага") = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Сделки.Основание КАК Сделка
			|ПОМЕСТИТЬ СделкиЦБ
			|ИЗ
			|	&Сделки КАК Сделки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СделкаЦенныеБумаги.Ссылка КАК Основание,
			|	СделкаЦенныеБумаги.ЦеннаяБумага,
			|	СделкаЦенныеБумаги.Ссылка.ВидСделки
			|ИЗ
			|	СделкиЦБ КАК СделкиЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|		ПО СделкиЦБ.Сделка = СделкаЦенныеБумаги.Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СделкаРЕПОЦенныеБумаги.Ссылка,
			|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага,
			|	СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки
			|ИЗ
			|	СделкиЦБ КАК СделкиЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
			|		ПО СделкиЦБ.Сделка = СделкаРЕПОЦенныеБумаги.Ссылка";
		
		Запрос.УстановитьПараметр("Сделки", Сделки);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат ПустаяТаблица;
		КонецЕсли;
		
		Сделки = РезультатЗапроса.Выгрузить();
		
	КонецЕсли;
		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.Основание КАК Сделка,
		|	Сделки.ЦеннаяБумага,
		|	Сделки.ВидСделки
		|ПОМЕСТИТЬ СделкиЦБ
		|ИЗ
		|	&Сделки КАК Сделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиЦБ.Сделка,
		|	СделкиЦБ.ЦеннаяБумага,
		|	СделкиЦБ.ВидСделки,
		|	СУММА(ЕСТЬNULL(СделкаЦенныеБумаги.Количество, СделкаРЕПОЦенныеБумаги.Количество)) КАК КоличествоСделки,
		|	ЕСТЬNULL(СделкаЦенныеБумаги.Ссылка.Рынок, СделкаРЕПОЦенныеБумаги.Ссылка.Рынок) КАК Рынок,
		|	ЕСТЬNULL(СделкаЦенныеБумаги.Ссылка.Дата, СделкаРЕПОЦенныеБумаги.Ссылка.Дата) КАК Дата
		|ПОМЕСТИТЬ СделкиЦБСКоличеством
		|ИЗ
		|	СделкиЦБ КАК СделкиЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО СделкиЦБ.Сделка = СделкаЦенныеБумаги.Ссылка
		|			И СделкиЦБ.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|		ПО СделкиЦБ.Сделка = СделкаРЕПОЦенныеБумаги.Ссылка
		|			И СделкиЦБ.ЦеннаяБумага = СделкаРЕПОЦенныеБумаги.ЦеннаяБумага
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкиЦБ.Сделка,
		|	СделкиЦБ.ЦеннаяБумага,
		|	СделкиЦБ.ВидСделки,
		|	ЕСТЬNULL(СделкаЦенныеБумаги.Ссылка.Рынок, СделкаРЕПОЦенныеБумаги.Ссылка.Рынок),
		|	ЕСТЬNULL(СделкаЦенныеБумаги.Ссылка.Дата, СделкаРЕПОЦенныеБумаги.Ссылка.Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(РаспределенияАктивовЕПС.Количество) КАК Количество,
		|	СделкиЦБ.Сделка,
		|	СделкиЦБ.ЦеннаяБумага,
		|	СделкиЦБ.ВидСделки
		|ПОМЕСТИТЬ РаспределеноЦБ
		|ИЗ
		|	СделкиЦБ КАК СделкиЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|		ПО СделкиЦБ.Сделка = РаспределенияАктивовЕПС.Сделка
		|			И СделкиЦБ.ЦеннаяБумага = РаспределенияАктивовЕПС.ЦеннаяБумага
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкиЦБ.Сделка,
		|	СделкиЦБ.ЦеннаяБумага,
		|	СделкиЦБ.ВидСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиЦБСКоличеством.Сделка,
		|	СделкиЦБСКоличеством.ЦеннаяБумага,
		|	СделкиЦБСКоличеством.ВидСделки,
		|	СделкиЦБСКоличеством.КоличествоСделки - ЕСТЬNULL(РаспределеноЦБ.Количество, 0) КАК Количество,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
		|	СделкиЦБСКоличеством.Рынок,
		|	СделкиЦБСКоличеством.Дата,
		|	СделкиЦБСКоличеством.КоличествоСделки
		|ИЗ
		|	СделкиЦБСКоличеством КАК СделкиЦБСКоличеством
		|		ЛЕВОЕ СОЕДИНЕНИЕ РаспределеноЦБ КАК РаспределеноЦБ
		|		ПО СделкиЦБСКоличеством.Сделка = РаспределеноЦБ.Сделка
		|			И СделкиЦБСКоличеством.ЦеннаяБумага = РаспределеноЦБ.ЦеннаяБумага
		|ГДЕ
		|	СделкиЦБСКоличеством.КоличествоСделки - ЕСТЬNULL(РаспределеноЦБ.Количество, 0) > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РаспределеноЦБ.Сделка,
		|	РаспределеноЦБ.ЦеннаяБумага,
		|	РаспределеноЦБ.ВидСделки,
		|	РаспределенияАктивовЕПС.Количество,
		|	РаспределенияАктивовЕПС.УчетныйАктивЕПС,
		|	СделкиЦБСКоличеством.Рынок,
		|	СделкиЦБСКоличеством.Дата,
		|	СделкиЦБСКоличеством.КоличествоСделки
		|ИЗ
		|	РаспределеноЦБ КАК РаспределеноЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|		ПО РаспределеноЦБ.Сделка = РаспределенияАктивовЕПС.Сделка
		|			И РаспределеноЦБ.ЦеннаяБумага = РаспределенияАктивовЕПС.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ СделкиЦБСКоличеством КАК СделкиЦБСКоличеством
		|		ПО РаспределеноЦБ.Сделка = СделкиЦБСКоличеством.Сделка
		|			И РаспределеноЦБ.ЦеннаяБумага = СделкиЦБСКоличеством.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("Сделки", Сделки);
	
	ТаблицаАктивовПоСделкам = Запрос.Выполнить().Выгрузить();
	
	Если Сделки.Количество() > 0 Тогда
		СчетДоверительногоУправления = Сделки[0].Основание.СчетДоверительногоУправления;
	Иначе
		СчетДоверительногоУправления = Неопределено;
	КонецЕсли;
	
	//СтрокиБезАктиваКУдалению = Новый Массив;
	СтрокиБезАктива = ТаблицаАктивовПоСделкам.НайтиСтроки(Новый Структура("УчетныйАктивЕПС",Справочники.УчетныеАктивыЕПС.ПустаяСсылка()));
	Для Каждого СтрокаТаблицыАктивов из СтрокиБезАктива Цикл
		Если СтрокаТаблицыАктивов.ВидСделки = Перечисления.ВидыСделок.Покупка
			ИЛИ СтрокаТаблицыАктивов.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
			СтрокаТаблицыАктивов.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(СтрокаТаблицыАктивов.Дата, СтрокаТаблицыАктивов.Рынок, СтрокаТаблицыАктивов.ЦеннаяБумага, СчетДоверительногоУправления);
		//Иначе
		//	СтрокиБезАктиваКУдалению.Добавить(СтрокаТаблицыАктивов);
		КонецЕсли;
	КонецЦикла;
	
	//Для каждого СтрокаБезАктиваКУдалению Из СтрокиБезАктиваКУдалению Цикл
	//	ТаблицаАктивовПоСделкам.Удалить(СтрокаБезАктиваКУдалению);
	//КонецЦикла;
	
	Возврат ТаблицаАктивовПоСделкам;
	
КонецФункции

Функция ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423(ОбъектДокумента, Операция = "") Экспорт

	ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 = Истина;
	
	// эта настройка, согласно задаче #517624 с 1.1.24 у группы будущее работает по-другому:
	// настройка должна срабатывать если "ценная бумага списана в один день, а денежные средства от эмитента поступили позже в последующие дни"
	// или другими словами:
	// для операции оплаты настройка должна срабатывать, если оплата идет позднее дня погашения и на утро дня оплаты бумаги уже списаны
	// для операции списание настройка должна срабатывать, если списание идет именно документом списания(не оплатой) и на вечер дня списания погашение еще не оплачено
	Если Операция = "Оплата" Тогда
		
		// оплата идет позднее дня погашения
		Для каждого СтрокаОснования Из ОбъектДокумента.Основания Цикл
			Если НачалоДня(ОбъектДокумента.Дата) = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОснования.Основание, "Дата")) Тогда
				ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// на утро дня оплаты бумаги уже списаны
		Если ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК ЦеннаяБумага
				|ПОМЕСТИТЬ _ЦенныеБумаги
				|ИЗ
				|	Документ.Оплата.Основания КАК ОплатаОснования
				|ГДЕ
				|	ОплатаОснования.Ссылка = &Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОстаткиЦенныхБумагЗаблокированныеОстатки.КоличествоОстаток КАК КоличествоОстаток
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные.Остатки(
				|			&Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ЦеннаяБумага В
				|					(ВЫБРАТЬ
				|						_ЦенныеБумаги.ЦеннаяБумага
				|					ИЗ
				|						_ЦенныеБумаги)) КАК ОстаткиЦенныхБумагЗаблокированныеОстатки
				|ГДЕ
				|	ОстаткиЦенныхБумагЗаблокированныеОстатки.КоличествоОстаток > 0";
			
			Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
			Запрос.УстановитьПараметр("Период", НачалоДня(ОбъектДокумента.Дата));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Ссылка", ОбъектДокумента.Ссылка);
			
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 = Ложь;
			КонецЕсли;
		
		КонецЕсли;
		
	ИначеЕсли Операция = "Списание" Тогда
		
		// списание идет именно документом списания(не оплатой)
		Если ТипЗнч(ОбъектДокумента) <> Тип("ДокументОбъект.СписаниеЦеннойБумаги") Тогда
			ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 = Ложь;
		Иначе // вечер дня списания погашение еще не оплачено
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток
				|ИЗ
				|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
				|			&Период,
				|			Организация = &Организация      
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Основание = &Основание) КАК ЗадолженностиПоДенежнымСредствамОстатки
				|ГДЕ
				|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток > 0";
			
			Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
			Запрос.УстановитьПараметр("Период", КонецДня(ОбъектДокумента.Дата));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Основание", ОбъектДокумента.ПогашениеЦеннойБумаги);
			
			Если Запрос.Выполнить().Пустой() Тогда
				ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423 = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

	Возврат ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423;
	
КонецФункции

// #техдолг - переделать процедуру полностью
// сейчас по погашениям некрасиво сделано
Процедура СформироватьДвиженияПоЗакрытиюРезервовОКУ(ОбъектДокумента, СчетРезерва, ВидСубконто, СчетДоходов, АналитикаСписанияРезервов, Движения_ЕдиныйБухгалтерскийУчет, ЦеннаяБумага = Неопределено) Экспорт
	// Для закрытия резервов ОКУ в МНО, Депозитах, РЕПО, оплатах по погашениям
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ВидСубконто);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Резервы);
	
	ОтборДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка();
	
	Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады Тогда
		СсылкаДляОтбора = ОбъектДокумента.КредитныйИнструмент;
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов Тогда
		Если СчетРезерва = ПланыСчетов.Единый.Расчеты25 Тогда
			СсылкаДляОтбора = ОбъектДокумента.Основания[0].Основание; // не страшно т.к. нет оплат по 2м и более погашениям, но не красиво капец
		Иначе
			СсылкаДляОтбора = ОбъектДокумента.ПерваяЧастьРЕПО;
		КонецЕсли;
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов Тогда
		СсылкаДляОтбора = ОбъектДокумента.МНО;
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги Тогда
		СсылкаДляОтбора = ЦеннаяБумага;
		ОтборДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РезервПоЗадолженностиПоПогашениюКупона;
	Иначе
		СсылкаДляОтбора = Неопределено;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Резерв,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Актив,
		|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт, 0)) КАК СуммаОстатокЕПС,
		|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт, 0)) КАК ВалютнаяСуммаОстатокЕПС,
		|	ЕдиныйБухгалтерскийУчетОстатки.Организация.ВалютаУчета КАК ОрганизацияВалютаУчета
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетРезерва,
		|			&ВидСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &Ссылка
		|				И ЛицевойСчет.ДополнительнаяАналитика = &ОтборДопАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Организация.ВалютаУчета";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаДляОтбора);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетРезерва", СчетРезерва);
	Запрос.УстановитьПараметр("ВидСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ОтборДопАналитика", ОтборДопАналитика);
	
	Движение = Запрос.Выполнить().Выбрать();
	
	Пока Движение.Следующий() Цикл
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения_ЕдиныйБухгалтерскийУчет, Движение.СуммаОстатокЕПС, "Списание резерва");	
		
		Проводка.СчетДт	= СчетРезерва;
		Проводка.СубконтоДт.Резервы	= Движение.Резерв;
		
		Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады Тогда
			Проводка.СубконтоДт.ДепозитныеВклады = ОбъектДокумента.КредитныйИнструмент;
		ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов Тогда
			Если СчетРезерва = ПланыСчетов.Единый.Расчеты25 Тогда
				Проводка.СубконтоДт.Контрагенты	= ОбъектДокумента.Контрагент;
			Иначе
				Проводка.СубконтоДт.Контрагенты	= Движение.Актив.Контрагент;
			КонецЕсли;
			Проводка.СубконтоДт.ОснованиеРасчетов	= Движение.Актив;
		ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов Тогда
			Проводка.СубконтоДт.БанковскиеСчета	= Движение.Актив.РасчетныйСчет;
			Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = Движение.Актив;
		ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги Тогда
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РезервПоЗадолженностиПоПогашениюКупона;
		КонецЕсли;	
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютаДт	= Движение.ОрганизацияВалютаУчета;
			Проводка.ВалютнаяСуммаДт	= Движение.СуммаОстатокЕПС;
		КонецЕсли;
		
		Проводка.СчетКт	= СчетДоходов;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= АналитикаСписанияРезервов;
		
		Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов Или ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов Тогда
			// СделкаРЕПО и ПриходПроцентовМНО
			Проводка.СубконтоКт.ЦенныеБумаги	= Движение.Актив;
		ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады Тогда
			// ЗакрытиеКредитногоИнструмента
			Проводка.СубконтоКт.ЦенныеБумаги = ОбъектДокумента.КредитныйИнструмент;
		ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги Тогда
			// Оплата по погашению купона
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		КонецЕсли;	
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютаКт	= Движение.ОрганизацияВалютаУчета;
			Проводка.ВалютнаяСуммаКт	= Движение.СуммаОстатокЕПС;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры	

// Возвращает ГФУ для списания резервов. Используется в СделкаРЕПО, ПриходПроцентовМНО, ЗакрытиеКредитногоИнструмента 
Функция ПолучитьГФУСписанияРезервов(ОбъектДокумента, УчетныйАктив) Экспорт
	
	АналитикиСписанияРезервов = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "АналитикаСписанияРезервов");
	
	АналитикаСписанияРезервов = АналитикиСписанияРезервов[УчетныйАктив.ИмяПредопределенныхДанных];
	Если Не ЗначениеЗаполнено(АналитикаСписанияРезервов) Тогда
		АналитикаСписанияРезервов = УчетныйАктив.АналитикаСписанияРезервов;
	КонецЕсли;
	
	Возврат АналитикаСписанияРезервов;
	
КонецФункции

