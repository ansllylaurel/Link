#Область Расчет_дисконта_премии

Функция РасчетДисконтаПремииВДеньПокупки(НачальныйДисконт, Количество, НастройкиУчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
	
	Если НачальныйДисконт > 0                           	// купили с премией
		ИЛИ НастройкиУчета.СтоимостьТелаРавнаНоминалу Тогда	// дисконт = дисконт начальный (оба < 0)
		
		РезультатРасчетаДисконтаПремии.ОценочныеДисконтПремия = НачальныйДисконт * Количество;
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт;
	РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = НачальныйДисконт * Количество;
	РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет = РезультатРасчетаДисконтаПремии.ОценочныеДисконтПремия;	
	
	Если НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.НеУчитывать Тогда
		РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Не учитывать");
	Иначе	
		РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Расчет в день покупки");
	КонецЕсли;
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииПослеПогашенияИлиОферты(НачальныйДисконт, Количество, НастройкиУчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
	
	// В эту функцию мы можем попасть в 2х случаях
	// у нас сегодня прошло погашение бумаги - все уже списано и вообще ничего начислять не надо
	// либо же мы прошли оферту, а клиент учитывал дисконт/премию до оферты
	// в этом случае нужно полностью списать премию (начислить дисконт)
	// и если с премией все и так нормально срабатывает, то для дисконта есть некоторые нюансы, которые тут отработаны

	Если НастройкиУчета.ДоводитьСтоимостьДоНоминалаВДеньОферты И НачальныйДисконт < 0 Тогда 
		
		РезультатРасчетаДисконтаПремии.ОценочныеДисконтПремия = - НачальныйДисконт;
		РезультатРасчетаДисконтаПремии.ИзменениеДисконтаПремии = РезультатРасчетаДисконтаПремии.ОценочныеДисконтПремия;
		
		РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет = Окр(НачальныйДисконт * Количество, 2);
		РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет = Окр(НачальныйДисконт * Количество, 2);
		
	Иначе
		
		НачальныйДисконт = 0;
		
	КонецЕсли;

	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Расчет после погашения или оферты");
	
	Возврат РезультатРасчетаДисконтаПремии;
	
КонецФункции 

Функция РасчетДисконтаПремииСНГ(Облигация, НачальныйДисконт, Количество, ДнейОтПокупкиДоПереоценки, ДнейОтПокупкиДоПогашения, ДнейОтПереоценкиДоПогашения, ДатаПереоценки, ДатаПокупки, ДатаПогашения, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
	
	Если НачальныйДисконт = 0 Тогда // по номиналу взяли
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = 0;
		
	ИначеЕсли НачальныйДисконт > 0 Тогда // премия, немного по-другому считается
		
	    РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = Окр(НачальныйДисконт * Количество, 2) - Окр(НачальныйДисконт * Количество, 2) * ДнейОтПокупкиДоПереоценки / ДнейОтПокупкиДоПогашения;
		
	Иначе // дисконт
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = Окр(НачальныйДисконт * Количество, 2) * ДнейОтПереоценкиДоПогашения / ДнейОтПокупкиДоПогашения;
		
	КонецЕсли;
	
	Если Облигация.Амортизационная Тогда
		
		ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
		ТаблицаАмортизаций.Колонки.Добавить("ПрошедшийПериод", Новый ОписаниеТипов("Булево"));
		ТаблицаАмортизаций.Колонки.Добавить("ДисконтЗаПериод", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("ТекущийДисконт", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("ТекущийНоминал", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
		
		ИтогАмортизаций = ТаблицаАмортизаций.Итог("Поток");
		
		РазностьДатПолная = (НачалоДня(ДатаПереоценки) - НачалоДня(ДатаПокупки)) / 86400;
		
		НоминалПриПокупке = ТаблицаАмортизаций.Итог("Поток");
		ТекущийНоминал = НоминалПриПокупке;
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = НачальныйДисконт * Количество;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
				
				РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет - НачальныйДисконт * Количество * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций;
				
				ТекущийНоминал = СтрокаТаблицаАмортизаций.Номинал;
				Если НачальныйДисконт < 0 Тогда
					РезультатРасчетаДисконтаПремии.ПогашенияДисконтов = РезультатРасчетаДисконтаПремии.ПогашенияДисконтов - НачальныйДисконт * Количество / ИтогАмортизаций * СтрокаТаблицаАмортизаций.Поток;
				КонецЕсли;
				
				СтрокаТаблицаАмортизаций.ПрошедшийПериод = Истина;
				СтрокаТаблицаАмортизаций.ДисконтЗаПериод = НачальныйДисконт * Количество / ИтогАмортизаций * СтрокаТаблицаАмортизаций.Поток;
				СтрокаТаблицаАмортизаций.ТекущийНоминал = ТекущийНоминал;
				
			Иначе
				
				РазностьДат = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;	
				РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет - НачальныйДисконт * Количество * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций / РазностьДат * РазностьДатПолная;
				
				СтрокаТаблицаАмортизаций.ПрошедшийПериод = Ложь;
				СтрокаТаблицаАмортизаций.ДисконтЗаПериод = НачальныйДисконт * Количество * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций / РазностьДат * РазностьДатПолная;
				СтрокаТаблицаАмортизаций.РазностьДат = РазностьДат;
				
			КонецЕсли;
			
			СтрокаТаблицаАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет;
			
		КонецЦикла;
		
		Если НачальныйДисконт > 0 Тогда // премия
			
			Если ТекущийНоминал <> 0 Тогда
				ИзменениеПремии = НачальныйДисконт * Количество - РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет;
			Иначе // дошли дополного погашения
				РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = 0;
				ИзменениеПремии = НачальныйДисконт * Количество;
			КонецЕсли;
			
		ИначеЕсли НачальныйДисконт < 0 Тогда // дисконт
			
			РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет - РезультатРасчетаДисконтаПремии.ПогашенияДисконтов;
			
			ИзменениеПремии = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет;
			
		КонецЕсли;
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет / Количество;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаСНГ = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета СНГ", , , Истина);	
		
		ДанныеРасчетаСНГ = Новый Структура;
		ДанныеРасчетаСНГ.Вставить("НачальныйДисконт", НачальныйДисконт);
		ДанныеРасчетаСНГ.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		ДанныеРасчетаСНГ.Вставить("Количество", Количество);
		ДанныеРасчетаСНГ.Вставить("ДнейОтПокупкиДоПогашения", ДнейОтПокупкиДоПогашения);
		ДанныеРасчетаСНГ.Вставить("ДнейОтПокупкиДоПереоценки", ДнейОтПокупкиДоПереоценки);
		
		Если Облигация.Амортизационная Тогда
			ДанныеРасчетаСНГ.Вставить("ИтогАмортизаций", ИтогАмортизаций);
			ДанныеРасчетаСНГ.Вставить("РазностьДатПолная", РазностьДатПолная);
			ДанныеРасчетаСНГ.Вставить("НоминалПриПокупке", НоминалПриПокупке);
			ДанныеРасчетаСНГ.Вставить("ПогашенияДисконтов", РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
			ДанныеРасчетаСНГ.Вставить("ИзменениеПремии", ИзменениеПремии);
			
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаСНГ, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		КонецЕсли;
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеРасчетаСНГ", ДанныеРасчетаСНГ, "Данные расчета СНГ", Истина, Истина);
		
	КонецЕсли;
	
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Методика СНГ");
	
	Возврат РезультатРасчетаДисконтаПремии;
	
КонецФункции 

Функция РасчетДисконтаПремииАтом(Облигация, СчетДоверительногоУправления, НастройкиУчета, НачальныйДисконт, Количество, ДатаПокупки, ДатаПереоценки, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
	
	// #371057 - извращенная метиода расчета для Атомгаранта
	НачальныйДисконтНаПакет = НачальныйДисконт * Количество;
	
	// Берем интегрированную таблицу оферт (с датой объявлений!) и амортизаций (только для случая дисконта)
	// В таблице будут поля: Дата (объявления оферты или амортизации) Тип ("Оферта" или "Амортизация")
	// Таблица будет отсортирована по полю дата
	// 
	// Перед циклом по строкам таблицы мы фмксируем начальный дисконт и дату покупки
	// Обрабатываем в цикле строки таблицы
	// Если Тип = "Оферта" значит расчитываем дисконт на эту дату - это будет новый начальный дисконт
	// а дата объявления будет новой начальной покупкой
	// Если Тип = "Амортизация" - считаем дисконт в этот день и накапливаем - по окончании цикла спишем все накопленное
	ТекущийНачальныйДисконтНаПакет = НачальныйДисконтНаПакет;
	ТекущаяДатаПокупки = ДатаПокупки;
	ТекущаяДатаПогашения = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(Облигация, ДатаПокупки, ДатаПокупки, СчетДоверительногоУправления,
									НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
	
	СписанияДисконтовПриАмортизациях = 0;
	ДатаПредыдущейАморизации = ДатаПокупки;
	
	ТаблицаОфертИАмортизаций = ПолучитьОфертыИАмортизации(Облигация, ДатаПокупки, ДатаПереоценки, (НачальныйДисконт < 0));
	
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ДатаОбъявления", Новый ОписаниеТипов("Дата"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ДнейОтПокупкиДоАмортизацииИлиОферты", Новый ОписаниеТипов("Число"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ДнейОтПокупкиДоПогашения", Новый ОписаниеТипов("Число"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ДисконтЗаДень", Новый ОписаниеТипов("Число"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ИзменениеДисконта", Новый ОписаниеТипов("Число"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ТекущийДисконт", Новый ОписаниеТипов("Число"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("ДатаПогашения", Новый ОписаниеТипов("Дата"));
	ТаблицаОфертИАмортизаций.Колонки.Добавить("СписанияДисконтовПриАмортизациях", Новый ОписаниеТипов("Число"));
	
	Для каждого СтрокаОфертИАмортизаций Из ТаблицаОфертИАмортизаций Цикл
		
		// если мы считаем дисконт для погашения купона или продажи при расчете партий, и в этот день амортизация, то её не считаем - она в конце дня
		Если СтрокаОфертИАмортизаций.ТипДействия = "Амортизация" И КонецДня(СтрокаОфертИАмортизаций.Дата) > ДатаПереоценки Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаОфертИАмортизаций.ТипДействия = "Оферта"
			И СтрокаОфертИАмортизаций.Дата < ДатаПереоценки // нас интересуют только уже объявленые оферты, причем рассматривать начинаем только на следующий день после объявления
			И НачалоДня(СтрокаОфертИАмортизаций.ДатаВыкупа) <= НачалоДня(ТекущаяДатаПогашения) Тогда // нас интересуют только оферты, которые сдвигают дату погашения "назад", ближе к покупке
			
			ДатаОбъявленияОферты = СтрокаОфертИАмортизаций.Дата;
			ДнейОтПокупкиДоОбъявленияОферты = (НачалоДня(ДатаОбъявленияОферты) - НачалоДня(ТекущаяДатаПокупки)) / 86400;
			ДнейОтПокупкиДоПогашения = (НачалоДня(ТекущаяДатаПогашения) - НачалоДня(ТекущаяДатаПокупки)) / 86400;
			
			ДисконтЗаДень = ТекущийНачальныйДисконтНаПакет / ДнейОтПокупкиДоПогашения;
			ИзменениеДисконта = ДисконтЗаДень * ДнейОтПокупкиДоОбъявленияОферты;
			ТекущийДисконт = Окр(ТекущийНачальныйДисконтНаПакет - ИзменениеДисконта, 2);
			
			ТекущийНачальныйДисконтНаПакет = ТекущийДисконт;
			ТекущаяДатаПокупки = ДатаОбъявленияОферты;
			ТекущаяДатаПогашения = СтрокаОфертИАмортизаций.ДатаВыкупа;
			
			
			СтрокаОфертИАмортизаций.ДатаОбъявления = ДатаОбъявленияОферты;
			СтрокаОфертИАмортизаций.ДнейОтПокупкиДоАмортизацииИлиОферты = ДнейОтПокупкиДоОбъявленияОферты;
			СтрокаОфертИАмортизаций.ДнейОтПокупкиДоПогашения = ДнейОтПокупкиДоПогашения;
			СтрокаОфертИАмортизаций.ДисконтЗаДень = ДисконтЗаДень;
			СтрокаОфертИАмортизаций.ИзменениеДисконта = ИзменениеДисконта;
			СтрокаОфертИАмортизаций.ТекущийДисконт = ТекущийДисконт;
			СтрокаОфертИАмортизаций.ДатаПогашения = ТекущаяДатаПогашения;
			
		ИначеЕсли СтрокаОфертИАмортизаций.ТипДействия = "Амортизация" И НачальныйДисконтНаПакет < 0 Тогда // амортизации интересуют только для дисконта, на премию они не влияют
			
			ДатаАмортизации = СтрокаОфертИАмортизаций.Дата;
			ДнейОтПокупкиДоАмортизации = (НачалоДня(ДатаАмортизации) - НачалоДня(ДатаПредыдущейАморизации)) / 86400;
			ДнейОтПокупкиДоПогашения = (НачалоДня(ТекущаяДатаПогашения) - НачалоДня(ТекущаяДатаПокупки)) / 86400;
			
			ДисконтЗаДень = ТекущийНачальныйДисконтНаПакет / ДнейОтПокупкиДоПогашения;
			СписанияДисконтовПриАмортизациях = СписанияДисконтовПриАмортизациях + Окр(ДисконтЗаДень * ДнейОтПокупкиДоАмортизации, 2);
			
			ДатаПредыдущейАморизации = ДатаАмортизации;
			
			СтрокаОфертИАмортизаций.ДатаОбъявления = ДатаАмортизации;
			СтрокаОфертИАмортизаций.ДнейОтПокупкиДоАмортизацииИлиОферты = ДнейОтПокупкиДоАмортизации;
			СтрокаОфертИАмортизаций.ДнейОтПокупкиДоПогашения = ДнейОтПокупкиДоПогашения;
			СтрокаОфертИАмортизаций.ДисконтЗаДень = ДисконтЗаДень;
			СтрокаОфертИАмортизаций.СписанияДисконтовПриАмортизациях = СписанияДисконтовПриАмортизациях;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НачалоДня(ТекущаяДатаПогашения) < НачалоДня(ДатаПереоценки) Тогда // была оферта к которой всё списали
		ИзменениеДисконта = ТекущийНачальныйДисконтНаПакет;
		Если НачальныйДисконтНаПакет > 0 Тогда // списали всю премию
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
		Иначе // начислили весь дисконт
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконтНаПакет;
		КонецЕсли;
	Иначе
		
		ДнейОтПокупкиДоПогашения = (НачалоДня(ТекущаяДатаПогашения) - НачалоДня(ТекущаяДатаПокупки)) / 86400;
		ДнейОтПокупкиДоПереоценки = (НачалоДня(ДатаПереоценки) - НачалоДня(ТекущаяДатаПокупки)) / 86400;
		
		ДисконтЗаДень = ТекущийНачальныйДисконтНаПакет / ДнейОтПокупкиДоПогашения;
		ИзменениеДисконта = Окр(ДисконтЗаДень * ДнейОтПокупкиДоПереоценки, 2) - СписанияДисконтовПриАмортизациях;
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = Окр(ТекущийНачальныйДисконтНаПакет - ИзменениеДисконта, 2);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет = НачальныйДисконтНаПакет - РезультатРасчетаДисконтаПремии.ТекущийДисконт;
	
	Если НачальныйДисконтНаПакет >= 0 Тогда
		РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
	Иначе
		РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет = -РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЛМСПСПАИППО = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета по методу 'Линейный метод с полным списанием при амортизаци и пересчетом при офертах", , , Истина);	
		
		РасчетЛМСПСПАИППО = Новый Структура;
		РасчетЛМСПСПАИППО.Вставить("НачальныйДисконтНаПакет", НачальныйДисконтНаПакет);
		РасчетЛМСПСПАИППО.Вставить("ДисконтНаПакет", ТекущийНачальныйДисконтНаПакет);
		Если НачалоДня(ТекущаяДатаПогашения) < НачалоДня(ДатаПереоценки) Тогда
			РасчетЛМСПСПАИППО.Вставить("БылаОфертаККоторойВсёСписали", Истина);
		Иначе
			РасчетЛМСПСПАИППО.Вставить("ДнейОтПокупкиДоПогашения", ДнейОтПокупкиДоПогашения);
			РасчетЛМСПСПАИППО.Вставить("ДнейОтПокупкиДоПереоценки", ДнейОтПокупкиДоПереоценки);
			РасчетЛМСПСПАИППО.Вставить("ДисконтЗаДень", ДисконтЗаДень);
		КонецЕсли;
		РасчетЛМСПСПАИППО.Вставить("ИзменениеДисконта", ИзменениеДисконта);
		РасчетЛМСПСПАИППО.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		РасчетЛМСПСПАИППО.Вставить("ИзменениеДисконтаНаПакет", РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛМСПСПАИППО, "ТаблицаОфертИАмортизаций", ТаблицаОфертИАмортизаций, "Таблица оферт и амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛМСПСПАИППО, "РасчетЛМСПСПАИППО", РасчетЛМСПСПАИППО, "Данные расчета ", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод с полным списанием при амортизации и пересчетом при офертах(Атомы)");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииЛинейно(НачальныйДисконт, ДнейОтПереоценкиДоПогашения, ДнейОтПокупкиДоПогашения)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
	
	// линейно дисконт считается просто:
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт * ДнейОтПереоценкиДоПогашения / ДнейОтПокупкиДоПогашения;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейно");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииДляАмортизационнойЛинейно(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, ЦенаПокупки, ДатаПереоценки, Количество, ОфертаПройденаИСтоимостьРавнаНоминальной, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
	
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПогашениеДисконта", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПогашениеДисконтаНаПакет", Новый ОписаниеТипов("Число"));
	
	Если ЦенаПокупки = 0 Тогда
		ЭСП = 0;
	Иначе
		ЭСП = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ТаблицаАмортизаций, ДатаПокупки, - ЦенаПокупки).Доходность;
	КонецЕсли;
	
	ПогашенияДисконтовНаПакет = 0;
	
	// списываем эти кусочки
	Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
		
		Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
		
			РазностьДат = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;
			
			ПогашениеДисконта =  СтрокаТаблицаАмортизаций.Поток * (1 - 1 / Pow(1 + ЭСП / 100, РазностьДат / 365));
			
			ПогашениеДисконтаНаПакет = Окр(ПогашениеДисконта * Количество, 2);
			
			РезультатРасчетаДисконтаПремии.ПогашенияДисконтов = РезультатРасчетаДисконтаПремии.ПогашенияДисконтов + ПогашениеДисконта;
			
			ПогашенияДисконтовНаПакет = ПогашенияДисконтовНаПакет + ПогашениеДисконтаНаПакет;
			
			СтрокаТаблицаАмортизаций.РазностьДат = РазностьДат;
			СтрокаТаблицаАмортизаций.ПогашениеДисконта = ПогашениеДисконта;
			СтрокаТаблицаАмортизаций.ПогашениеДисконтаНаПакет = ПогашениеДисконтаНаПакет;
			
		КонецЕсли;
	
	КонецЦикла;
	
	//ТекущийДисконт = ТекущийДисконт - ПогашенияДисконтов;
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - ПогашенияДисконтовНаПакет / Количество;
	Если ОфертаПройденаИСтоимостьРавнаНоминальной Тогда
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЭСП = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета через ЭСП для амортизационной облигации", , , Истина);	
		
		РасчетЭСП = Новый Структура;
		РасчетЭСП.Вставить("ЭСП", ЭСП);
		РасчетЭСП.Вставить("ПогашенияДисконтов", РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
		РасчетЭСП.Вставить("ПогашениеДисконтаНаПакет", ПогашениеДисконтаНаПакет);
		РасчетЭСП.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЭСП, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЭСП, "РасчетЭСП", РасчетЭСП, "Расчет через ЭСП", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейно для амортизационной бумаги");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииСАмортизациейПремииИлиДисконта(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, ДатаПереоценки, НачальныйДисконт, Количество, ОфертаПройденаИСтоимостьРавнаНоминальной, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
	ТаблицаАмортизаций.Колонки.Добавить("ДисконтЗаПериод", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ТекущийДисконт", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	
	ИтогАмортизаций = ТаблицаАмортизаций.Итог("Поток");
	
	РазностьДатПолная = (НачалоДня(ДатаПереоценки) - НачалоДня(ДатаПокупки)) / 86400;
	
	НоминалПриПокупке = ТаблицаАмортизаций.Итог("Поток");
	ТекущийНоминал = НоминалПриПокупке;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт;
	
	ПогашенияДисконтовНаПакет = 0;
	
	Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
		
		//ТекущийНоминал = СтрокаТаблицаАмортизаций.Номинал;
		
		Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
			
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - НачальныйДисконт * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций;
			
			ТекущийНоминал = СтрокаТаблицаАмортизаций.Номинал;
			Если НачальныйДисконт < 0 Тогда
				РезультатРасчетаДисконтаПремии.ПогашенияДисконтов = РезультатРасчетаДисконтаПремии.ПогашенияДисконтов - НачальныйДисконт / ИтогАмортизаций * СтрокаТаблицаАмортизаций.Поток;
				ПогашенияДисконтовНаПакет = ПогашенияДисконтовНаПакет - Окр(Количество * НачальныйДисконт / ИтогАмортизаций * СтрокаТаблицаАмортизаций.Поток, 2)
			КонецЕсли;
			
			СтрокаТаблицаАмортизаций.ДисконтЗаПериод = НачальныйДисконт / ИтогАмортизаций * СтрокаТаблицаАмортизаций.Поток;
			СтрокаТаблицаАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
			
		Иначе
			
			РазностьДат = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;	
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - НачальныйДисконт * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций / РазностьДат * РазностьДатПолная;
			
			СтрокаТаблицаАмортизаций.ДисконтЗаПериод = НачальныйДисконт * СтрокаТаблицаАмортизаций.Поток / ИтогАмортизаций / РазностьДат * РазностьДатПолная;
			СтрокаТаблицаАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
			СтрокаТаблицаАмортизаций.РазностьДат = РазностьДат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОфертаПройденаИСтоимостьРавнаНоминальной Тогда
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
	КонецЕсли;
	
	Если НачальныйДисконт > 0 Тогда // премия
		
		Если ТекущийНоминал <> 0 Тогда
			ИзменениеПремии = НачальныйДисконт - РезультатРасчетаДисконтаПремии.ТекущийДисконт;
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт - ИзменениеПремии;
		Иначе // дошли дополного погашения
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
			ИзменениеПремии = НачальныйДисконт;
		КонецЕсли;
		
	ИначеЕсли НачальныйДисконт < 0 Тогда // дисконт
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - ПогашенияДисконтовНаПакет / Количество;
		
		ИзменениеПремии = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЛинейныйСАмортизацией = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета 'Линейный метод с амотризацией дисконта или премии'", , , Истина);	
		
		РасчетЛинейныйСАмортизацией = Новый Структура;
		РасчетЛинейныйСАмортизацией.Вставить("ИтогАмортизаций", ИтогАмортизаций);
		РасчетЛинейныйСАмортизацией.Вставить("РазностьДатПолная", РазностьДатПолная);
		РасчетЛинейныйСАмортизацией.Вставить("НоминалПриПокупке", НоминалПриПокупке);
		РасчетЛинейныйСАмортизацией.Вставить("НачальныйДисконт", НачальныйДисконт);
		РасчетЛинейныйСАмортизацией.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		РасчетЛинейныйСАмортизацией.Вставить("ПогашенияДисконтов", РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
		РасчетЛинейныйСАмортизацией.Вставить("ПогашенияДисконтовНаПакет", ПогашенияДисконтовНаПакет);
		РасчетЛинейныйСАмортизацией.Вставить("ИзменениеПремии", ИзменениеПремии);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСАмортизацией, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСАмортизацией, "РасчетЛинейныйСАмортизацией", РасчетЛинейныйСАмортизацией, "Расчет линейный с амортизацией", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод с амортизацией премии или дисконта");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииМетодомНационального(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, ДатаПереоценки, НачальныйДисконт, Количество, ОфертаПройденаИСтоимостьРавнаНоминальной, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
	ТаблицаАмортизаций.Колонки.Добавить("ДнейОтПокупки", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("КоэффициентПериода", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ДисконтЗаПериод", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПогашениеДисконта", Новый ОписаниеТипов("Число"));
	
	ИтогАмортизаций = ТаблицаАмортизаций.Итог("Поток");
	НоминалПриПокупке = ИтогАмортизаций;
	
	ДнейОтПокупкиДоПереоценки = (НачалоДня(ДатаПереоценки) - НачалоДня(ДатаПокупки)) / 86400;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт;
	
	ПогашенияДисконтовНаПакет = 0;
	
	Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
		
		СтрокаТаблицаАмортизаций.ДнейОтПокупки = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;
		
		ДоляПогашенияНоминала = СтрокаТаблицаАмортизаций.Поток / НоминалПриПокупке;
		
		СтрокаТаблицаАмортизаций.КоэффициентПериода = -НачальныйДисконт * ДоляПогашенияНоминала / СтрокаТаблицаАмортизаций.ДнейОтПокупки;
		
		Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
		
			СтрокаТаблицаАмортизаций.ДисконтЗаПериод = 0;
			СтрокаТаблицаАмортизаций.ПогашениеДисконта = -НачальныйДисконт * ДоляПогашенияНоминала;
			
		Иначе
			
			СтрокаТаблицаАмортизаций.ДисконтЗаПериод = СтрокаТаблицаАмортизаций.КоэффициентПериода * ДнейОтПокупкиДоПереоценки;
			СтрокаТаблицаАмортизаций.ПогашениеДисконта = 0;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОфертаПройденаИСтоимостьРавнаНоминальной Тогда
	//	РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0; // тут пока не ясно - ждем разъяснений
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт + ТаблицаАмортизаций.Итог("ДисконтЗаПериод");
	РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконт * Количество;
	РезультатРасчетаДисконтаПремии.ИзменениеДисконтаПремии = ТаблицаАмортизаций.Итог("ДисконтЗаПериод");
	РезультатРасчетаДисконтаПремии.ПогашенияДисконтов = ТаблицаАмортизаций.Итог("ПогашениеДисконта");
	РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет = ТаблицаАмортизаций.Итог("ДисконтЗаПериод") * Количество;
	РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЛинейныйСАмортизацией = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета 'Метод Национального'", , , Истина);	
		
		РасчетЛинейныйСАмортизацией = Новый Структура;
		РасчетЛинейныйСАмортизацией.Вставить("ИтогАмортизаций", ИтогАмортизаций);
		РасчетЛинейныйСАмортизацией.Вставить("РазностьДатПолная", ДнейОтПокупкиДоПереоценки);
		РасчетЛинейныйСАмортизацией.Вставить("НоминалПриПокупке", НоминалПриПокупке);
		РасчетЛинейныйСАмортизацией.Вставить("НачальныйДисконт", НачальныйДисконт);
		РасчетЛинейныйСАмортизацией.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		РасчетЛинейныйСАмортизацией.Вставить("ПогашенияДисконтов", РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
		РасчетЛинейныйСАмортизацией.Вставить("ПогашенияДисконтовНаПакет", ПогашенияДисконтовНаПакет);
		РасчетЛинейныйСАмортизацией.Вставить("ИзменениеПремии", 0);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСАмортизацией, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСАмортизацией, "РасчетЛинейныйСАмортизацией", РасчетЛинейныйСАмортизацией, "Расчет линейный с амортизацией", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод с амортизацией премии или дисконта");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииЛинейнымМетодомСЕжедневнойПроцентнойСтавкой(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, НачальныйДисконт, Номинал, ДатаПереоценки, ЦенаПокупки, РасшифровкаРасчета)

	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
	
	ТаблицаАмортизаций.Колонки.Добавить("ТекущийНоминал", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("Номиналодней", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ДисконтЗаПериод", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ТекущийДисконт", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДатПремия", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СписаниеДисконта", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СписаниеТела", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ТекущееТело", Новый ОписаниеТипов("Число"));
	
	СуммаНоминалодней = 0;
	НоминалПриПокупке = ТаблицаАмортизаций.Итог("Поток");
	ТекущаяДата = ДатаПокупки;
	ТекущийНоминал = НоминалПриПокупке;
	
	Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
		
		СтрокаТаблицаАмортизаций.ТекущийНоминал = ТекущийНоминал;
		
		СтрокаТаблицаАмортизаций.РазностьДат = (СтрокаТаблицаАмортизаций.Дата - НачалоДня(ТекущаяДата)) / 86400;
		
		СтрокаТаблицаАмортизаций.Номиналодней = СтрокаТаблицаАмортизаций.ТекущийНоминал * СтрокаТаблицаАмортизаций.РазностьДат;
		СуммаНоминалодней = СуммаНоминалодней + СтрокаТаблицаАмортизаций.Номиналодней;
		
		ТекущийНоминал = ТекущийНоминал - СтрокаТаблицаАмортизаций.Поток;
		ТекущаяДата = СтрокаТаблицаАмортизаций.Дата;
	
	КонецЦикла;
	
	//ЕжедневнаяПроцентнаяСтавка = НачальныйДисконт / СуммаНоминалодней;
	
	Если Номинал = НоминалПриПокупке Тогда // когда номинал не меняется с даты покупки то и смысла нет пересчитывать по таблице
	
		// ничего не делаем
		
	ИначеЕсли НачальныйДисконт > 0 Тогда // Премия
	
		ТекущаяДата = ДатаПокупки;
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			НачальнаяДата = Мин(СтрокаТаблицаАмортизаций.Дата, ДатаПереоценки);
			
			РазностьДат = (НачалоДня(НачальнаяДата) - НачалоДня(ТекущаяДата)) / 86400;
			Если РазностьДат < 0 Тогда
				РазностьДат = 0;
			КонецЕсли;
			ДисконтЗаПериод = СтрокаТаблицаАмортизаций.ТекущийНоминал * РазностьДат * НачальныйДисконт / СуммаНоминалодней;
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - ДисконтЗаПериод;
			
			ТекущаяДата = СтрокаТаблицаАмортизаций.Дата;
			
			СтрокаТаблицаАмортизаций.ДисконтЗаПериод = ДисконтЗаПериод;
			СтрокаТаблицаАмортизаций.ТекущийДисконт = ТекущийДисконт;
			СтрокаТаблицаАмортизаций.РазностьДатПремия = РазностьДат;
			
		КонецЦикла;
		
	Иначе
		
		ТекущаяДата = ДатаПокупки;
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
		ТекущееТело = ЦенаПокупки;
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
			
			Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
				
				ДисконтЗаПериод = СтрокаТаблицаАмортизаций.ТекущийНоминал * СтрокаТаблицаАмортизаций.РазностьДат * (-НачальныйДисконт) / СуммаНоминалодней;
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + ДисконтЗаПериод;
				
				СписаниеДисконта = РезультатРасчетаДисконтаПремии.ТекущийДисконт * СтрокаТаблицаАмортизаций.Поток / (РезультатРасчетаДисконтаПремии.ТекущийДисконт + ТекущееТело);
				СписаниеТела = СтрокаТаблицаАмортизаций.Поток - СписаниеДисконта;
				
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - СписаниеДисконта;
				ТекущееТело = ТекущееТело - СписаниеТела;
				
				СтрокаТаблицаАмортизаций.ДисконтЗаПериод = ДисконтЗаПериод;
				СтрокаТаблицаАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
				СтрокаТаблицаАмортизаций.СписаниеДисконта = СписаниеДисконта;
				СтрокаТаблицаАмортизаций.СписаниеТела = СписаниеТела;
				СтрокаТаблицаАмортизаций.ТекущееТело = ТекущееТело;
			Иначе
				
				РазностьДат = (НачалоДня(ДатаПереоценки) - НачалоДня(ТекущаяДата)) / 86400;
				Если РазностьДат < 0 Тогда
					РазностьДат = 0;
				КонецЕсли;
				ДисконтЗаПериод = СтрокаТаблицаАмортизаций.ТекущийНоминал * РазностьДат * (-НачальныйДисконт) / СуммаНоминалодней;
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + ДисконтЗаПериод;
				
				СтрокаТаблицаАмортизаций.ДисконтЗаПериод = ДисконтЗаПериод;
				СтрокаТаблицаАмортизаций.РазностьДатПремия = РазностьДат;
				СтрокаТаблицаАмортизаций.ТекущийДисконт = ТекущийДисконт;
				
			КонецЕсли;
			
			ТекущаяДата = СтрокаТаблицаАмортизаций.Дата;
			
		КонецЦикла;
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + НачальныйДисконт; // дисконт с минусом считаются
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЛинейныйСЕжедневнойСтавкой = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета 'Линейный метод с ежедневной процентной ставкой'", , , Истина);	
		
		РасчетЛинейныйСЕжедневнойСтавкой = Новый Структура;
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("НоминалПриПокупке", НоминалПриПокупке);
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("ДатаПокупки", ДатаПокупки);
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("ЦенаПокупки", ЦенаПокупки);
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("СуммаНоминалодней", СуммаНоминалодней);
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("НачальныйДисконт", НачальныйДисконт);
		РасчетЛинейныйСЕжедневнойСтавкой.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСЕжедневнойСтавкой, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСЕжедневнойСтавкой, "РасчетЛинейныйСЕжедневнойСтавкой", РасчетЛинейныйСЕжедневнойСтавкой, "Расчет линейный с ежедневной процентной ставкой", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод с ежедневной процентной ставкой");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииЛинейнымМетодомСПолнымСписаниемПриАмортизаци(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, НачальныйДисконт, ДатаПереоценки, ДатаОфертыПослеПокупки, РасшифровкаРасчета)
	
	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	Если НачальныйДисконт < 0 Тогда // актуально только для дисконтов, по премия списывается линейно
		
		СписывалиПолныйДисконт = Ложь;
		
		ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
		
		ТаблицаАмортизаций.Колонки.Добавить("ПрошлоДней", Новый ОписаниеТипов("Число"));
		ТаблицаАмортизаций.Колонки.Добавить("ДисконтВДеньАмортизации", Новый ОписаниеТипов("Число"));
		
		НужноНачислитьДисконта = - НачальныйДисконт;
		
		ДнейОтПокупкиДоПогашения = (НачалоДня(ДатаПогашения) - НачалоДня(ДатаПокупки)) / 86400;
		
		Для каждого СтрокаТаблицаАмортизаций Из ТаблицаАмортизаций Цикл
		
			Если СтрокаТаблицаАмортизаций.Дата < НачалоДня(ДатаПереоценки + 1) Тогда
			
				ПрошлоДней = (НачалоДня(СтрокаТаблицаАмортизаций.Дата) - НачалоДня(ДатаПокупки)) / 86400;
				
				ДисконтВДеньАмортизации = НужноНачислитьДисконта * ПрошлоДней / ДнейОтПокупкиДоПогашения;
				
				РезультатРасчетаДисконтаПремии.ПогашенияДисконтов = ДисконтВДеньАмортизации;
				
				Если ДатаОфертыПослеПокупки < СтрокаТаблицаАмортизаций.Дата Тогда
				
					СписывалиПолныйДисконт = Истина;
				
				КонецЕсли;
				
				СтрокаТаблицаАмортизаций.ПрошлоДней = ПрошлоДней;
				СтрокаТаблицаАмортизаций.ДисконтВДеньАмортизации = ДисконтВДеньАмортизации;
				
			КонецЕсли;
		
		КонецЦикла;
		
		РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - РезультатРасчетаДисконтаПремии.ПогашенияДисконтов;
		
		Если СписывалиПолныйДисконт Тогда
		
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = НачальныйДисконт;
		
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
		
			РасшифровкаЛинейныйСПолнымСписанием = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета 'Линейный метод с полным списанием при амортизации'", , , Истина);	
			
			РасчетЛинейныйСПолнымСписанием = Новый Структура;
			РасчетЛинейныйСПолнымСписанием.Вставить("ДнейОтПокупкиДоПогашения", ДнейОтПокупкиДоПогашения);
			РасчетЛинейныйСПолнымСписанием.Вставить("НачальныйДисконт", НачальныйДисконт);
			РасчетЛинейныйСПолнымСписанием.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
			РасчетЛинейныйСПолнымСписанием.Вставить("СписывалиПолныйДисконт", СписывалиПолныйДисконт);
			РасчетЛинейныйСПолнымСписанием.Вставить("ПогашенияДисконтов", РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
			
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСПолнымСписанием, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
			
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЛинейныйСПолнымСписанием, "РасчетЛинейныйСПолнымСписанием", РасчетЛинейныйСПолнымСписанием, "Расчет линейный с полным списанием при амортизации", Истина, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод с полным списанием при амортизации");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииЛинейнымМетодомПлюсМетодикаСафмараДляАмортизационныхОблигаций(Облигация, ТекущийДисконт, ДатаПокупки, ДатаПогашения, НачальныйДисконт, ДатаПереоценки, РасшифровкаРасчета)
	
	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, ТекущийДисконт, 0, 0, 0, 0, 0);
	
	// в функции БухгалтерскийУчетЕПС.РассчитатьЕжедневноеПриращениеПоПотокуСафмар детально расписан алгоритм по Сафмару
	НачальныйДисконтДляРасчета = -НачальныйДисконт; // Для премии (она > 0) будет отрицательное приращения, а для дисконта положительное
	
	ТаблицаАмортизаций = БухгалтерскийУчетЕПС.ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
	ТаблицаАмортизаций.Колонки.Добавить("Период", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СуммаПоПотоку", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ЗаПериод", Новый ОписаниеТипов("Число"));
	
	Если ТаблицаАмортизаций.Количество() > 1 Тогда
	
		МинимальнаяТочкаРазрыва = 1;
		Для каждого СтрокаАмортизаций Из ТаблицаАмортизаций Цикл
			СтрокаАмортизаций.Период = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаАмортизаций.Дата, ДатаПокупки);
			МинимальнаяТочкаРазрыва = Мин(МинимальнаяТочкаРазрыва, 1 / СтрокаАмортизаций.Период);
		КонецЦикла;
		
		Если НачальныйДисконт < 0 Тогда
			МинимумДиапазонаРасчета = 0;
			МаксимумДиапазонаРасчета = МинимальнаяТочкаРазрыва * 0.999;
		Иначе	
			МинимумДиапазонаРасчета = -МинимальнаяТочкаРазрыва * 0.999;
			МаксимумДиапазонаРасчета = 0;
		КонецЕсли;
		
		ЕжедневноеПриращение = РассчитатьЕжедневноеПриращениеПоПотокуСафмар(ТаблицаАмортизаций, МинимумДиапазонаРасчета, МаксимумДиапазонаРасчета, НачальныйДисконтДляРасчета);
		
	Иначе
	
		СтрокаАмортизаций = ТаблицаАмортизаций[0];
		СтрокаАмортизаций.Период = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(СтрокаАмортизаций.Дата, ДатаПокупки);
		ЕжедневноеПриращение = Окр(НачальныйДисконтДляРасчета / СтрокаАмортизаций.Период / (СтрокаАмортизаций.Поток - НачальныйДисконтДляРасчета), 20);
	
	КонецЕсли;
	
	ТекущийДисконтПремия = 0;
	ДнейОтПокупкиДоПереоценки = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ДатаПереоценки, ДатаПокупки);
	СписаниеПремий = 0;
	
	Для каждого СтрокаАмортизаций Из ТаблицаАмортизаций Цикл
		
		Если СтрокаАмортизаций.Период > ДнейОтПокупкиДоПереоценки 
			ИЛИ (НачалоДня(ДатаПереоценки) = НачалоДня(ДатаПогашения) И НачальныйДисконт < 0) Тогда
			СуммаПоПотоку = Окр(СтрокаАмортизаций.Поток / (1 + СтрокаАмортизаций.Период * ЕжедневноеПриращение), 12);
			ТекущийДисконтПремия = ТекущийДисконтПремия + Окр(СуммаПоПотоку * ЕжедневноеПриращение * ДнейОтПокупкиДоПереоценки, 15);
			
			СтрокаАмортизаций.СуммаПоПотоку = СуммаПоПотоку;
			СтрокаАмортизаций.ЗаПериод = Окр(СуммаПоПотоку * ЕжедневноеПриращение * ДнейОтПокупкиДоПереоценки, 15);
			
		ИначеЕсли НачальныйДисконт > 0 Тогда
			СписаниеПремий = СписаниеПремий + СтрокаАмортизаций.Поток / (1 + СтрокаАмортизаций.Период * ЕжедневноеПриращение) * ЕжедневноеПриращение * СтрокаАмортизаций.Период;
			
			СтрокаАмортизаций.ЗаПериод = СтрокаАмортизаций.Поток / (1 + СтрокаАмортизаций.Период * ЕжедневноеПриращение) * ЕжедневноеПриращение * СтрокаАмортизаций.Период;
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = ТекущийДисконтПремия + НачальныйДисконт + СписаниеПремий;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаСафмар = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета 'метедика Сафмар'", , , Истина);	
		
		РасчетСафмар = Новый Структура;
		РасчетСафмар.Вставить("НачальныйДисконт", НачальныйДисконт);
		РасчетСафмар.Вставить("ЕжедневноеПриращение", ЕжедневноеПриращение);
		РасчетСафмар.Вставить("ДнейОтПокупкиДоПереоценки", ДнейОтПокупкиДоПереоценки);
		РасчетСафмар.Вставить("СписаниеПремий", СписаниеПремий);
		РасчетСафмар.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаСафмар, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаСафмар, "РасчетСафмар", РасчетСафмар, "Расчет Сафмар", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Линейный метод плюс методика сафмара для амортизационныхОблигаций");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

Функция РасчетДисконтаПремииЧерезЭСП(Облигация, ДатаПокупки, ДатаПогашения, Номинал, ЦенаПокупки, НачальныйДисконт, ДатаПереоценки, ДнейОтПокупкиДоПогашения, ДнейОтПереоценкиДоПогашения, НастройкиУчета, РасшифровкаРасчета)
	
	РезультатРасчетаДисконтаПремии = Новый Структура("ОценочныеДисконтПремия, ТекущийДисконт, ТекущийДисконтНаПакет, ИзменениеДисконтаПремии, ПогашенияДисконтов, ИзменениеДисконтаНаПакет, ОценочныйДисконтНаПакет", 0, 0, 0, 0, 0, 0, 0);
		
	Если Облигация.Амортизационная Тогда
		
		ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения);
		
	Иначе	
	
		ТаблицаАмортизаций = Новый ТаблицаЗначений;
		
		ТаблицаАмортизаций.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		ТаблицаАмортизаций.Колонки.Добавить("Поток", Новый ОписаниеТипов("Число"));
		
		НоваяСтрока = ТаблицаАмортизаций.Добавить();
		НоваяСтрока.Дата = ДатаПогашения;
		НоваяСтрока.Поток = Номинал;
	
	КонецЕсли;
	
	Если ЦенаПокупки = 0 Тогда
		ЭСП = 0;
	Иначе
		Результат = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ТаблицаАмортизаций, ДатаПокупки, - ЦенаПокупки);
		ЭСП = Результат.Доходность;
	КонецЕсли;
	
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("РазностьДатНИ", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СтоимостьЭСП", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПроцентыЭСП", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СуммаДень", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СуммаДеньНИ", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("СуммаПериодНИ", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПрошлоДней", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ТекущийДисконт", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("ПогашениеДисконта", Новый ОписаниеТипов("Число"));
	
	КоличествоСтрок = ТаблицаАмортизаций.Количество();
	СуммаДеньНИ = 0;
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
	
		ТекущаяСтрока = ТаблицаАмортизаций[КоличествоСтрок - НомерСтроки];
		
		ТекущаяСтрока.РазностьДатНИ = (НачалоДня(ТекущаяСтрока.Дата) - НачалоДня(ДатаПокупки)) / 86400;
		
		ТекущаяСтрока.СтоимостьЭСП = ТекущаяСтрока.Поток / Pow(1 + ЭСП / 100, ТекущаяСтрока.РазностьДатНИ / 365);
		ТекущаяСтрока.ПроцентыЭСП = ТекущаяСтрока.СтоимостьЭСП * Pow(1 + ЭСП / 100, ТекущаяСтрока.РазностьДатНИ / 365) - ТекущаяСтрока.СтоимостьЭСП;
		ТекущаяСтрока.СуммаДень = ТекущаяСтрока.ПроцентыЭСП / ТекущаяСтрока.РазностьДатНИ;
		
		ТекущаяСтрока.ПогашениеДисконта = 0;
		Если НачальныйДисконт < 0 Тогда // купили с дисконтом - будем считать его погашения при амортизации
		
			ТекущаяСтрока.ПогашениеДисконта = ТекущаяСтрока.СтоимостьЭСП * Pow(1 + ЭСП / 100, ТекущаяСтрока.РазностьДатНИ / 365) - ТекущаяСтрока.СтоимостьЭСП;
			
		КонецЕсли;
		
		
		СуммаДеньНИ = СуммаДеньНИ + ТекущаяСтрока.СуммаДень;
		ТекущаяСтрока.СуммаДеньНИ = СуммаДеньНИ;
		
		Если НомерСтроки = КоличествоСтрок Тогда
			
			ТекущаяСтрока.РазностьДат = (НачалоДня(ТекущаяСтрока.Дата) - НачалоДня(ДатаПокупки)) / 86400;
			
		Иначе
			
			ПредыдущаяСтрока = ТаблицаАмортизаций[КоличествоСтрок - НомерСтроки - 1];
			
			ТекущаяСтрока.РазностьДат = (НачалоДня(ТекущаяСтрока.Дата) - НачалоДня(ПредыдущаяСтрока.Дата)) / 86400;
			
		КонецЕсли;
		
		ТекущаяСтрока.СуммаПериодНИ = ТекущаяСтрока.СуммаДеньНИ * ТекущаяСтрока.РазностьДат;
		
	КонецЦикла;
	
	// теперь, когда адская таблица заполнена начинаем считать 
	РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0;
	ПогашениеДисконта = 0;
	Для каждого СтрокаТаблицыАмортизаций Из ТаблицаАмортизаций Цикл
		
		Если НачалоДня(СтрокаТаблицыАмортизаций.Дата) < НачалоДня(ДатаПереоценки) Тогда
			
			ПогашениеДисконта = ПогашениеДисконта + СтрокаТаблицыАмортизаций.ПогашениеДисконта;
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + СтрокаТаблицыАмортизаций.СуммаПериодНИ;
			СтрокаТаблицыАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
			
		Иначе
			
			Если КонецДня(СтрокаТаблицыАмортизаций.Дата) = ДатаПереоценки Тогда
				ПогашениеДисконта = ПогашениеДисконта + СтрокаТаблицыАмортизаций.ПогашениеДисконта;
			КонецЕсли;
			
			ОсталосьДнейВПериоде = (НачалоДня(СтрокаТаблицыАмортизаций.Дата) - НачалоДня(ДатаПереоценки)) / 86400;
			СтрокаТаблицыАмортизаций.ПрошлоДней = СтрокаТаблицыАмортизаций.РазностьДат - ОсталосьДнейВПериоде;
			
			Если Облигация.Амортизационная Тогда //вот тут вот немного бяка, но она в очень мелких долях сказывается - пока пусь
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + СтрокаТаблицыАмортизаций.СуммаДеньНИ * СтрокаТаблицыАмортизаций.ПрошлоДней;
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + НачальныйДисконт;
			Иначе
				РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт + СтрокаТаблицыАмортизаций.СтоимостьЭСП * Pow(1 + ЭСП / 100, СтрокаТаблицыАмортизаций.ПрошлоДней / 365) - СтрокаТаблицыАмортизаций.Поток;
			КонецЕсли;
			
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт - ПогашениеДисконта;
			
			СтрокаТаблицыАмортизаций.ТекущийДисконт = РезультатРасчетаДисконтаПремии.ТекущийДисконт;
			
			Прервать;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если ДнейОтПокупкиДоПогашения < 365
		И НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности
		И НастройкиУчета.КритерийСущественностиДисконтаПремии > 0 Тогда
		
		ЛинейныйТекущийДисконт = НачальныйДисконт * ДнейОтПереоценкиДоПогашения / ДнейОтПокупкиДоПогашения;
		
		Если ЛинейныйТекущийДисконт = 0 Тогда
			Если РезультатРасчетаДисконтаПремии.ТекущийДисконт = 0 Тогда // только купили
				Оклонение = 0;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проценты, рассчитанные линейным методом для ценной бумаги " + Строка(Облигация) + " равны нулю");
				Оклонение = 100;
			КонецЕсли;
		Иначе
			Оклонение = (РезультатРасчетаДисконтаПремии.ТекущийДисконт - ЛинейныйТекущийДисконт) / ЛинейныйТекущийДисконт * 100;			
		КонецЕсли; 
		
		//Оклонение = (ЛинейныйТекущийДисконт - ТекущийДисконт) / ЛинейныйТекущийДисконт * 100;
		Оклонение = Макс(Оклонение, - Оклонение);
		
		Если Оклонение < НастройкиУчета.КритерийСущественностиДисконтаПремии Тогда
		
			РезультатРасчетаДисконтаПремии.ТекущийДисконт = ЛинейныйТекущийДисконт;
		
		КонецЕсли;
	
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаЭСП = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расшифровка расчета через ЭСП для амортизационной облигации", , , Истина);	
		
		РасчетЭСП = Новый Структура;
		РасчетЭСП.Вставить("ЭСП", ЭСП);
		РасчетЭСП.Вставить("ТекущийДисконт", РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЭСП, "ТаблицаАмортизаций", ТаблицаАмортизаций, "Таблица амортизаций", Истина);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаЭСП, "РасчетЭСП", РасчетЭСП, "Расчет через ЭСП", Истина, Истина);
		
	КонецЕсли;
	
	РезультатРасчетаДисконтаПремии.Вставить("МетодРасчета", "Через ЭСП");
	
	Возврат РезультатРасчетаДисконтаПремии;

КонецФункции 

#КонецОбласти

#Область Расчет_стоимости_по_ЭСП

Функция РасчетСтоимостиПоЭСПМетодомЧИСТНЗ(Облигация, ДатаПереоценки, ДатаОпределенияДенежногоПотока, СчитаемДоПогашения, ЭСП, СчетДоверительногоУправления, НастройкиУчета, ДанныеПереоценки, ТочностьРасчетов = Неопределено, ДенежныйПотокВх = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)

	ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;	
	Если НастройкиУчета.ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости Тогда
		ЦельРасчета = Справочники.ЦелиРасчета.БухгалтерскийУчет;
	КонецЕсли;
	
	НастройкиЦелиРасчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, ЦельРасчета);
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	ПараметрыОценки.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки));
	
	ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, Облигация, Отказ);
	
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		СчитаемДоПогашения);
	ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	НастройкиУчета.УчитыватьКупонКОферте);

	ПараметрыДенежногоПотока.Вставить("Дата",				ДатаОпределенияДенежногоПотока);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",		ДатаОпределенияДенежногоПотока);
	ПараметрыДенежногоПотока.Вставить("НастройкиУчета",		НастройкиУчета);
	
	Если НастройкиУчета.Свойство("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона_Переопределена") Тогда
		ПараметрыДенежногоПотока.Вставить("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона",	НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
	КонецЕсли;
	
	Если ДенежныйПотокВх = Неопределено Тогда
		ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ДанныеПереоценки, Отказ);
	Иначе
		ДенежныйПоток = ДенежныйПотокВх;
	КонецЕсли;
	
	ДенежныйПоток.Свернуть("Дата", "Поток");
	ДенежныйПоток.Сортировать("Дата");
	
	ДенежныйПоток.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("ПроцентыПоЭСПЗаПериод", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("СтоимостьЭСПДоВычитанияПотока", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("СтоимостьЭСППослеВычитанияПотока", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("ПроцентыЭспНакопленные", Новый ОписаниеТипов("Число"));
	
	СтоимостьПоЭСП = 0;
	
	Для каждого СтрокаДенежныйПоток Из ДенежныйПоток Цикл
		
		Если НачалоДня(СтрокаДенежныйПоток.Дата) < НачалоДня(ДатаПереоценки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДенежныйПоток.РазностьДат = (НачалоДня(СтрокаДенежныйПоток.Дата) - НачалоДня(ДатаПереоценки)) / 86400;
		
		СтрокаДенежныйПоток.СтоимостьЭСПДоВычитанияПотока = Pow(1 + ЭСП / 100, СтрокаДенежныйПоток.РазностьДат / 365);
		Если ТочностьРасчетов <> Неопределено
			И ТочностьРасчетов <> 2 Тогда	// пришлось сделать специальное условие для Ростеха (см. вызов этой функции из РассчитатьКорректировкуПоЭСП)
			                                // т.к. только им пришла в голову идея округлять до 2х(!!!) знаков потоки (см. переменная ТочностьОкругленияДисконтируемыхСуммДенежныхПотоковПриРасчетеАС)
											// причем вот тут они не округляют, а ниже округляют!
			СтрокаДенежныйПоток.СтоимостьЭСПДоВычитанияПотока = Окр(СтрокаДенежныйПоток.СтоимостьЭСПДоВычитанияПотока, ТочностьРасчетов);	
		КонецЕсли;
			
		СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод = СтрокаДенежныйПоток.Поток / СтрокаДенежныйПоток.СтоимостьЭСПДоВычитанияПотока;
		Если ТочностьРасчетов <> Неопределено Тогда
			СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод = Окр(СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод, ТочностьРасчетов);
		КонецЕсли;
		
		СтоимостьПоЭСП = СтоимостьПоЭСП + СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод;
		
		СтрокаДенежныйПоток.СтоимостьЭСППослеВычитанияПотока = СтоимостьПоЭСП;
	
	КонецЦикла;
	
	Если НастройкиУчета.РазрядностьОкругленияАС <> 0 Тогда
	    СтоимостьПоЭСП = Окр(СтоимостьПоЭСП, НастройкиУчета.РазрядностьОкругленияАС);
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ПараметрыДенежногоПотока.Вставить("ЭСП", ЭСП);
		ПараметрыДенежногоПотока.Вставить("ТочностьРасчетов", ТочностьРасчетов);
		ПараметрыДенежногоПотока.Вставить("СтоимостьПоЭСП", СтоимостьПоЭСП);
		ПараметрыДенежногоПотока.Удалить("НастройкиУчета");
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РасчетМетодомЧИСТНЗ", ПараметрыДенежногоПотока, "Расчет методом ЧИСТНЗ", Истина, Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДенежныйПоток", ДенежныйПоток, "Денежный поток", Истина);
		
	КонецЕсли;
	
	Возврат СтоимостьПоЭСП;

КонецФункции

Функция РасчетСтоимостиПоЭСПИтерационнымМетодом(Облигация, УчетныйАктивЕПС, ДатаПокупки, НачальнаяСтоимость, ДатаПереоценки, СчитаемДоПогашения, ЭСП, СчетДоверительногоУправления, НастройкиУчета, ДанныеПереоценки, Количество, РасшифровкаРасчета = Неопределено)

	НастройкиУчетаАктива = Неопределено;
	Если НастройкиУчета.РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением Тогда
		НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(ДатаПереоценки, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, УчетныйАктивЕПС, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	КонецЕсли;
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",		СчитаемДоПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",					ДатаПокупки);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",			ДатаПереоценки);
	ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",	НастройкиУчета.УчитыватьКупонКОферте);
	
	ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ДанныеПереоценки);
	ДенежныйПоток.Свернуть("Дата", "Поток");
	ДенежныйПоток.Сортировать("Дата");
	
	ДенежныйПоток.Колонки.Добавить("РазностьДат", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("ПроцентыПоЭСПЗаПериод", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("СтоимостьЭСПДоВычитанияПотока", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("СтоимостьЭСППослеВычитанияПотока", Новый ОписаниеТипов("Число"));
	ДенежныйПоток.Колонки.Добавить("ПроцентыЭспНакопленные", Новый ОписаниеТипов("Число"));
	
	СтоимостьПоЭСП = НачальнаяСтоимость;
	ПроцентыПоЭСП = 0;
	
	ТекущаяДата = ДатаПокупки;
	
	Для каждого СтрокаДенежныйПоток Из ДенежныйПоток Цикл
		
		СтрокаДенежныйПоток.СтоимостьЭСПДоВычитанияПотока = СтоимостьПоЭСП;
		
		Если СтрокаДенежныйПоток.Дата <= НачалоДня(ДатаПереоценки) Тогда
			КонечнаяДатаПериода = СтрокаДенежныйПоток.Дата;
		Иначе
			КонечнаяДатаПериода = ДатаПереоценки;
		КонецЕсли;
		
		СтрокаДенежныйПоток.РазностьДат = (НачалоДня(КонечнаяДатаПериода) - НачалоДня(ТекущаяДата)) / 86400;
		
		Если НастройкиУчета.РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением Тогда
			
			СтоимостьПоЭСПДляРасчетаПоДням = СтоимостьПоЭСП * Количество;
			ПредыдущийДень = НачалоДня(ТекущаяДата);
			ПроцентыПоЭСПИтого = 0;
			
			ДниНачисленияКорректировкиЭСП = Новый Массив;
			ТекДень = НачалоДня(ТекущаяДата) + 86400;
			Пока ТекДень <= НачалоДня(КонечнаяДатаПериода) Цикл
				ДниНачисленияКорректировкиЭСП.Добавить(ТекДень);
				ТекДень = ТекДень + 86400;
			КонецЦикла; 
			
			//ДниНачисленияКорректировкиЭСП = ПолучитьДниНачисленияКорректировкиЭСП(НачалоДня(ТекущаяДата) + 86400, НачалоДня(КонечнаяДатаПериода), Облигация, СчетДоверительногоУправления, НастройкиУчета, НастройкиУчетаАктива);
			
			Для каждого ТекущийДень Из ДниНачисленияКорректировкиЭСП Цикл
				
				РазностьДат = (ТекущийДень - ПредыдущийДень) / 86400;
				
				ПроцентыПоЭСПЗаПериод = Окр(СтоимостьПоЭСПДляРасчетаПоДням * Pow(1 + ЭСП / 100, РазностьДат / 365), 2) - СтоимостьПоЭСПДляРасчетаПоДням;
				ПроцентыПоЭСПИтого = ПроцентыПоЭСПИтого + ПроцентыПоЭСПЗаПериод;
				СтоимостьПоЭСПДляРасчетаПоДням = СтоимостьПоЭСПДляРасчетаПоДням + ПроцентыПоЭСПЗаПериод;
				
				ПредыдущийДень = ТекущийДень;
			
			КонецЦикла;
			
			СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод = ПроцентыПоЭСПИтого / Количество;
			
		Иначе // нормальные люди считают сразу за весь период
			
			СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод = СтоимостьПоЭСП * Pow(1 + ЭСП / 100, СтрокаДенежныйПоток.РазностьДат / 365) - СтоимостьПоЭСП;
			
		КонецЕсли;
		
		ПроцентыПоЭСП = ПроцентыПоЭСП + СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод;
		
		СтоимостьПоЭСП = СтоимостьПоЭСП + СтрокаДенежныйПоток.ПроцентыПоЭСПЗаПериод;
		
		Если СтрокаДенежныйПоток.Дата <= НачалоДня(ДатаПереоценки) Тогда
			СтоимостьПоЭСП = СтоимостьПоЭСП - СтрокаДенежныйПоток.Поток;
		КонецЕсли;
		
		СтрокаДенежныйПоток.СтоимостьЭСППослеВычитанияПотока	= СтоимостьПоЭСП;
		СтрокаДенежныйПоток.ПроцентыЭспНакопленные				= ПроцентыПоЭСП;
		
		ТекущаяДата = СтрокаДенежныйПоток.Дата;
		
		Если СтрокаДенежныйПоток.Дата >= НачалоДня(ДатаПереоценки) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкиУчета.РазрядностьОкругленияАС <> 0 Тогда
	    СтоимостьПоЭСП = Окр(СтоимостьПоЭСП, НастройкиУчета.РазрядностьОкругленияАС);
	    ПроцентыПоЭСП = Окр(ПроцентыПоЭСП, НастройкиУчета.РазрядностьОкругленияАС);
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ПараметрыДенежногоПотока.Вставить("ЭСП", ЭСП);
		ПараметрыДенежногоПотока.Вставить("РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением", НастройкиУчета.РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением);
		ПараметрыДенежногоПотока.Вставить("НачальнаяСтоимость", НачальнаяСтоимость);
		ПараметрыДенежногоПотока.Вставить("СтоимостьПоЭСП", СтоимостьПоЭСП);
		ПараметрыДенежногоПотока.Вставить("ПроцентыПоЭСП", ПроцентыПоЭСП);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РасчетИтерационнымМетодом", ПараметрыДенежногоПотока, "Расчет итерационным методом", Истина, Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДенежныйПоток", ДенежныйПоток, "Денежный поток", Истина);
		
	КонецЕсли;
	
	Возврат Новый Структура("СтоимостьПоЭСП, ПроцентыПоЭСП", СтоимостьПоЭСП, ПроцентыПоЭСП);
	
КонецФункции

#КонецОбласти

#Область Формирование_проводок

Функция ОпределитьНоминальныеСуммыПогашения(ДанныеПогашения, ДанныеБумаги, ОбъектДокумента, ВалютаУчета, Отказ)

	Если ТипЗнч(ДанныеПогашения.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда
		
		НоминальнаяСумма = ДанныеПогашения.Количество * Справочники.Облигации.ПолучитьНоминал(ДанныеПогашения.ЦеннаяБумага, ДанныеПогашения.Дата);
		Если ДанныеБумаги.ВалютаНоминала = ВалютаУчета Тогда
			НоминальнаяСуммаВВалютеУчета = НоминальнаяСумма;
		Иначе
			НоминальнаяСуммаВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(НоминальнаяСумма, ДанныеБумаги.ВалютаНоминала, ОбъектДокумента.Дата, ВалютаУчета, ОбъектДокумента.Дата, Отказ);
		КонецЕсли;

		Если ДанныеПогашения.ВалютаОплаты = ДанныеБумаги.ВалютаНоминала Тогда
			НоминальнаяСуммаКупона = ДанныеПогашения.СуммаКупона;
		Иначе // делаем запрос, боясь нарваться на копейки при пересчете курса
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КупонныйДоходПоОблигациям.СуммаКупона
				|ИЗ
				|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
				|ГДЕ
				|	КупонныйДоходПоОблигациям.Облигация = &Облигация
				|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &ДатаОкончанияКупона";
			
			Запрос.УстановитьПараметр("ДатаОкончанияКупона", НачалоДня(ДанныеПогашения.Дата));
			Запрос.УстановитьПараметр("Облигация", ДанныеПогашения.ЦеннаяБумага);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			    НоминальнаяСуммаКупона = ВыборкаДетальныеЗаписи.СуммаКупона * ДанныеПогашения.Количество;
			Иначе
				НоминальнаяСуммаКупона = Справочники.Облигации.ПолучитьКупон(ДанныеПогашения.ЦеннаяБумага, ДанныеПогашения.Дата) * ДанныеПогашения.Количество;
			КонецЕсли;
		КонецЕсли;
		Если ДанныеПогашения.ВалютаОплаты = ВалютаУчета Тогда
			НоминальнаяСуммаКупонаВВалютеУчета = ДанныеПогашения.СуммаКупона;
		Иначе
			НоминальнаяСуммаКупонаВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(НоминальнаяСуммаКупона, ДанныеБумаги.ВалютаНоминала, ОбъектДокумента.Дата, ВалютаУчета, ОбъектДокумента.Дата, Отказ);
		КонецЕсли;
		
	Иначе // паи, ису, векселя - пока одни рубли (пока)
		
		НоминальнаяСумма = ДанныеПогашения.Сумма;
		НоминальнаяСуммаВВалютеУчета = ДанныеПогашения.Сумма;
		
		НоминальнаяСуммаКупона = 0;
		НоминальнаяСуммаКупонаВВалютеУчета = 0;
		
	КонецЕсли;
	
	Возврат Новый Структура("НоминальнаяСумма, НоминальнаяСуммаВВалютеУчета, НоминальнаяСуммаКупона, НоминальнаяСуммаКупонаВВалютеУчета", 
		НоминальнаяСумма, НоминальнаяСуммаВВалютеУчета, НоминальнаяСуммаКупона, НоминальнаяСуммаКупонаВВалютеУчета);

КонецФункции

Процедура СформироватьПроводкиСписанияЦеннойБумаги(УчетныйРегистр, ОбъектДокумента, Отказ) Экспорт 
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ОбъектДокумента.Дата,
		ОбъектДокумента.Организация,
		ОбъектДокумента.СчетДоверительногоУправления);
		
	УчитыватьПрошедшиеПлатежи = Ложь;
	Если НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423ПриОплатеВДеньТПлюс Тогда
		
		Если БухгалтерскийУчетЕПС.ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423(ОбъектДокумента, "Списание") Тогда
		
			НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
			УчитыватьПрошедшиеПлатежи = Истина;
			
		Иначе
			
			НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408;
		
		КонецЕсли;
		
	КонецЕсли;
		
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	Движения = ОбъектДокумента.Движения;
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(
														ОбъектДокумента.Дата,
														ОбъектДокумента.Организация,
														ОбъектДокумента.СчетДоверительногоУправления,
														"ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	
	ЭтоСписаниеЦеннойБумаги		= (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.СписаниеЦеннойБумаги"));
	ЭтоПогашениеЦеннойБумаги	= (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПогашениеЦеннойБумаги"));
	ЭтоОплата					= (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Оплата"));
	
	Если ЭтоПогашениеЦеннойБумаги Тогда
		ПогашениеСсылка = ОбъектДокумента.Ссылка;
	ИначеЕсли ЭтоСписаниеЦеннойБумаги Тогда
		ПогашениеСсылка = ОбъектДокумента.ПогашениеЦеннойБумаги;
	ИначеЕсли ЭтоОплата Тогда
		ПогашениеСсылка = ОбъектДокумента.Основания[0].Основание;
	КонецЕсли;
	
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	Если (ЭтоСписаниеЦеннойБумаги Или ЭтоОплата) И НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности(ПогашениеСсылка) Тогда
		// бумага не была списана в день погашения и весь НКД ранее был перенесен на эту аналитику
		АналитикаКупонНачисленный 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;	
		АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	Иначе
		АналитикаКупонНачисленный 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
		АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	КонецЕсли;	
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДебиторкиПоТелу 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
	АналитикаДебиторкиПоКупону 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	
	ДанныеПогашения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПогашениеСсылка, "Дата, ЦеннаяБумага, ВалютаОплаты, Количество, Сумма, СуммаКупона");
	Если ТипЗнч(ДанныеПогашения.ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
		ДанныеБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПогашения.ЦеннаяБумага, "ВалютаНоминала");
		
		РеквизитыПИФ = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПогашения.ЦеннаяБумага, "ПаевойИнвестиционныйФонд"), ДанныеПогашения.Дата);
		ДанныеБумаги.Вставить("Эмитент", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыПИФ.УправляющаяКомпания, "ЮрФизЛицо"));
	Иначе
		ДанныеБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПогашения.ЦеннаяБумага, "ВалютаНоминала, Эмитент");
	КонецЕсли;	
	Контрагент = РаботаСЦеннымиБумагами.КонтрагентПоЦеннойБумаге(ДанныеПогашения.ЦеннаяБумага, ДанныеПогашения.Дата);
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	
	СубконтоЦБ_Р = Новый Массив;
	СубконтоЦБ_Р.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	СубконтоЦБ_Р.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Резервы);
	
	// читаем движения партий
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ОстаткиНаКонецДня
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&КонецДня,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки
		|ГДЕ
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
		|	НАЧАЛОПЕРИОДА(ОстаткиДенежныхСредств.Период, ДЕНЬ) КАК ДеньПлатежа
		|ПОМЕСТИТЬ _ФактическиеПлатежи
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период >= &ДатаПогашения
		|	И ОстаткиДенежныхСредств.Период <= &КонецДня
		|	И ОстаткиДенежныхСредств.Регистратор В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ОплатаОснования.Ссылка КАК Ссылка
		|			ИЗ
		|				Документ.Оплата.Основания КАК ОплатаОснования
		|			ГДЕ
		|				ОплатаОснования.Основание = &ПогашениеСсылка)
		|	И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая))
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ОстаткиДенежныхСредств.Период, ДЕНЬ),
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета
		|ПОМЕСТИТЬ _Перекурсовка
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииЦенныхБумаг.Количество = 0
		|	И БухПартииЦенныхБумаг.Стоимость = 0
		|	И БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|	И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|	И БухПартииЦенныхБумаг.ДисконтПремияНачисленный = 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС
		|;
		|
