			Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			
			Проводка.ВалютаДт  					= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаДт 			= СуммаКомисии;
			
		Иначе
			Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего 
				ИЛИ ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда		
				Проводка.СчетДт 		= ПланыСчетов.Единый.АктивыВДУ03;								
				Если ОбъектДокумента.Дата > Дата(2020,5,1) Тогда
					Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
						ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
					ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда		
						ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего;
					КонецЕсли;
				Иначе 
					Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
						ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
					КонецЕсли;
				КонецЕсли;	
				Проводка.ДополнительнаяАналитикаДт	= ДопАналитика;
			Иначе
				Проводка.СчетДт 				= ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами11;//АктивыВДУ03;//Расчеты07; - без привязки к ЦБ счет д.б. 47903 ?
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
				Проводка.ДополнительнаяАналитикаДт	= ДопАналитика;
				
				Если ВидКомиссии = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария Тогда
					ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеСпецдепозитария;
					Проводка.ДополнительнаяАналитикаДт	= ДопАналитика;
				КонецЕсли;
				
				
				СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(ОбъектДокумента.Дата, 
																						ОбъектДокумента.Организация, 
																						ОбъектДокумента.СчетДоверительногоУправления, 
