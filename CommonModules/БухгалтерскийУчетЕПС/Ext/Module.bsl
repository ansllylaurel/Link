				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаПереброски, ПараметрыПроводки.Содержание);
				
				Если ПараметрыПроводки.СуммаВВалютеУчета > 0 Тогда
					// дебет
					Проводка.СчетДт = ПараметрыПроводки.СчетУчета;
					Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = СуммаПереброскиВалютная;
					Проводка.ДополнительнаяАналитикаДт = ПараметрыПроводки.Аналитика;
					
					// кредит
					Проводка.СчетКт = ПараметрыПроводки.СчетДоходовРасходовПарный;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУПарный;
					Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					
					Если Проводка.СчетКт.Валютный Тогда // для счетов 106ХХ
						Проводка.ВалютаКт = ПараметрыПроводки.ВалютаНоминала;
						Проводка.ВалютнаяСуммаКт = СуммаПереброски;
					КонецЕсли;
					
				Иначе
					// дебет
					Проводка.СчетДт = ПараметрыПроводки.СчетДоходовРасходовПарный;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУПарный;
					Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					
					Если Проводка.СчетДт.Валютный Тогда // для счетов 106ХХ
						Проводка.ВалютаДт = ПараметрыПроводки.ВалютаНоминала;
						Проводка.ВалютнаяСуммаДт = СуммаПереброски;
					КонецЕсли;
					
					// кредит
					Проводка.СчетКт = ПараметрыПроводки.СчетУчета;
					Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.ВалютаКт  = ПараметрыПроводки.ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт = СуммаПереброскиВалютная;
					Проводка.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;
				КонецЕсли;
				
				Проводка.Партия = ПараметрыПроводки.Партия;
				Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
				
				
			Иначе // Корректировка
				// Нужно сделать переброску с основного 700го на парный 700й и всё
				
				Если НачальноеСальдоПоСчету700 < 0 И КонечноеСальдоПоСчету700 > 0 Тогда
				
					СуммаПереброски = КонечноеСальдоПоСчету700;
					
					СчетДт = ПараметрыПроводки.СчетДоходовРасходов;
					СчетКт = ПараметрыПроводки.СчетДоходовРасходовПарный;
					
					ГФУДт = ПараметрыПроводки.ГФУ;
					ГФУКт = ПараметрыПроводки.ГФУПарный;
					
				Иначе  // Если НачальноеСальдоПоСчету700 > 0 И КонечноеСальдоПоСчету700 < 0 Тогда
					
					СуммаПереброски = - КонечноеСальдоПоСчету700;
					
					СчетДт = ПараметрыПроводки.СчетДоходовРасходовПарный;
					СчетКт = ПараметрыПроводки.СчетДоходовРасходов;
					
					ГФУДт = ПараметрыПроводки.ГФУПарный;
					ГФУКт = ПараметрыПроводки.ГФУ;
					
				КонецЕсли;
				
				Если СуммаПереброски > 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаПереброски, "Закрытие парных счетов");
					
					// дебет
					Проводка.СчетДт = СчетДт;
					
					Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУДт;
					
					// кредит
					Проводка.СчетКт = СчетКт;
					
					Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКт;
					
					// допы
					Проводка.Партия = ПараметрыПроводки.Партия;
					Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
					
				ИначеЕсли СуммаПереброски < 0 Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -СуммаПереброски, "Закрытие парных счетов");
					
					// дебет
					Проводка.СчетДт = СчетКт;
					
					Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКт;
					
					// кредит
					Проводка.СчетКт = СчетДт;
					
					Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУДт;
					
					// допы
					Проводка.Партия = ПараметрыПроводки.Партия;
					Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

