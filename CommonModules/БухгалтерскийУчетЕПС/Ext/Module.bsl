Процедура ПровестиКорректировкуЭСП(ЭтотОбъект, КредитныйИнструмент, СтоимостьВклада, СтоимостьВкладаПоЭСП, ПереоценкаПослеВводаНачальныхОстатков = Ложь) Экспорт
	
	ТипИнструмента = ТипЗнч(КредитныйИнструмент);
	Если ТипИнструмента = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		БанковскийСчет = КредитныйИнструмент.БанковскийСчет;
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС;
	ИначеЕсли ТипИнструмента = Тип("ДокументСсылка.МНО") Тогда
		БанковскийСчет = КредитныйИнструмент.РасчетныйСчет;
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настоящий момент не поддерживается начисление корректировок ЭСП по виду кредитного инструмента: " + Строка(ТипИнструмента));
		Возврат;
	КонецЕсли;
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады);
	
	ПроцентыЭСП = СтоимостьВкладаПоЭСП - СтоимостьВклада;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК ОстатокКорректировки,
	|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаКорректировкиА,
	|	0 КАК СуммаКорректировкиП
	|ПОМЕСТИТЬ ОстаткиКорректировки
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|			&Период,
	|			Счет = &СчетУчетаКорректировокА,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто1 = &БанковскиеСчета
	|				И Субконто2 = &КредитныйИнструмент) КАК БухгалтерскийУчетОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-БухгалтерскийУчетОстатки.СуммаОстатокКт,
	|	0,
	|	БухгалтерскийУчетОстатки.СуммаОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	|			&Период,
	|			Счет = &СчетУчетаКорректировокП,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто1 = &БанковскиеСчета
	|				И Субконто2 = &КредитныйИнструмент) КАК БухгалтерскийУчетОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ОстаткиКорректировки.ОстатокКорректировки) КАК ОстатокКорректировки,
	|	СУММА(ОстаткиКорректировки.СуммаКорректировкиА) КАК СуммаКорректировкиА,
	|	СУММА(ОстаткиКорректировки.СуммаКорректировкиП) КАК СуммаКорректировкиП,
	|	ЕСТЬNULL(УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив, &УчетныйАктив) КАК УчетныйАктив
	|ИЗ
	|	ОстаткиКорректировки КАК ОстаткиКорректировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
	|			УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
	|		ИЗ
	|			(ВЫБРАТЬ
	|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
	|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
	|			ИЗ
	|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
	|						&ПериодУсловий,
	|						ДатаНачалаДействияУсловий <= &ПериодУсловий
	|							И КредитныйИнструмент = &КредитныйИнструмент) КАК УсловияКредитныхИнструментовСрезПоследних
	|			ГДЕ
	|				УсловияКредитныхИнструментовСрезПоследних.Действует
	|			
	|			СГРУППИРОВАТЬ ПО
	|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
	|						&ПериодУсловий,
	|						ДатаНачалаДействияУсловий <= &ПериодУсловий
	|							И КредитныйИнструмент = &КредитныйИнструмент) КАК УсловияКредитныхИнструментовСрезПоследних
	|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
	|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
	|		ПО (ИСТИНА)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив, &УчетныйАктив)";
	
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период"						, Новый Граница(ЭтотОбъект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ВидыСубконто"				, ВидыСубконто);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокА"		, ПланыСчетов.Единый.Депозиты09);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокП"		, ПланыСчетов.Единый.Депозиты11);
	Запрос.УстановитьПараметр("БанковскиеСчета"				, БанковскийСчет);
	Запрос.УстановитьПараметр("КредитныйИнструмент"			, КредитныйИнструмент);
	Запрос.УстановитьПараметр("ПериодУсловий"				, ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("УчетныйАктив"				, УчетныйАктив);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если ПроцентыЭСП >= 0 Тогда // положительная корректировка
			
			Если ВыборкаДетальныеЗаписи.ОстатокКорректировки >= 0 Тогда // уже была положительная или никакая
				
				СуммаКорректировкиА = ПроцентыЭСП - ВыборкаДетальныеЗаписи.СуммаКорректировкиА; // сделаем положительную
				СуммаКорректировкиП = 0;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ОстатокКорректировки < 0 Тогда // уже была отрицательная
				
				СуммаКорректировкиА = ПроцентыЭСП; // начислим положительную
				СуммаКорректировкиП = ВыборкаДетальныеЗаписи.СуммаКорректировкиП; // уберем всю отрицательную
				
			КонецЕсли;
				
		ИначеЕсли ПроцентыЭСП < 0 Тогда // отрицательная корректировка
			
			Если ВыборкаДетальныеЗаписи.ОстатокКорректировки <= 0 Тогда // уже была отрицательная или никакая
				
				СуммаКорректировкиА = 0;
				СуммаКорректировкиП = ПроцентыЭСП + ВыборкаДетальныеЗаписи.СуммаКорректировкиП; // сделаем отрицательную
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ОстатокКорректировки > 0 Тогда // уже была положительная
				
				СуммаКорректировкиА = -ВыборкаДетальныеЗаписи.СуммаКорректировкиА; // уберем всю положительную
				СуммаКорректировкиП = ПроцентыЭСП; // начислим отрицательную
				
			КонецЕсли;
				
		КонецЕсли;
		
		УчетныйАктивДепозита = ВыборкаДетальныеЗаписи.УчетныйАктив;
		
		СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктивДепозита.АналитикаДоходовОтКорректировки.НомерСчетаБухгалтерскогоУчета);
		СчетУчетаРасходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктивДепозита.АналитикаРасходовОтКорректировки.НомерСчетаБухгалтерскогоУчета);
		
		Если СуммаКорректировкиА > 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКорректировкиА, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ЭСП");
			
			Проводка.СчетДт = УчетныйАктивДепозита.СчетУчетаКорректировокА;
			Проводка.СубконтоДт.БанковскиеСчета = БанковскийСчет;
			Проводка.СубконтоДт.ДепозитныеВклады = КредитныйИнструмент;
			Проводка.ВалютаДт  = БанковскийСчет.Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаКорректировкиА;
			
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт = СчетУчетаДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивДепозита.АналитикаДоходовОтКорректировки;
				Проводка.СубконтоКт.ЦенныеБумаги = КредитныйИнструмент;
			КонецЕсли;
			
		ИначеЕсли СуммаКорректировкиА < 0 Тогда 
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(-СуммаКорректировкиА, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ЭСП");
			
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетДт = СчетУчетаРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивДепозита.АналитикаРасходовОтКорректировки;
				Проводка.СубконтоДт.ЦенныеБумаги = КредитныйИнструмент;
			КонецЕсли;
		
			Проводка.СчетКт = УчетныйАктивДепозита.СчетУчетаКорректировокА;
			Проводка.СубконтоКт.БанковскиеСчета = БанковскийСчет;
			Проводка.СубконтоКт.ДепозитныеВклады = КредитныйИнструмент;
			Проводка.ВалютаКт  = БанковскийСчет.Валюта;
			Проводка.ВалютнаяСуммаКт = - СуммаКорректировкиА;
			
		КонецЕсли;
		
		Если СуммаКорректировкиП > 0 Тогда 
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКорректировкиП, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ЭСП");
			
			Проводка.СчетДт = УчетныйАктивДепозита.СчетУчетаКорректировокП;
			Проводка.СубконтоДт.БанковскиеСчета = БанковскийСчет;
			Проводка.СубконтоДт.ДепозитныеВклады = КредитныйИнструмент;
			Проводка.ВалютаДт  = БанковскийСчет.Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаКорректировкиП;
			
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт = СчетУчетаДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивДепозита.АналитикаДоходовОтКорректировки;
				Проводка.СубконтоКт.ЦенныеБумаги = КредитныйИнструмент;
			КонецЕсли;
			
		ИначеЕсли СуммаКорректировкиП < 0 Тогда 
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(-СуммаКорректировкиП, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ЭСП");
			
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетДт = СчетУчетаРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивДепозита.АналитикаРасходовОтКорректировки;
				Проводка.СубконтоДт.ЦенныеБумаги = КредитныйИнструмент;
