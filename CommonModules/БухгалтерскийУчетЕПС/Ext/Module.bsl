			//		строка остатков - остаток парного = СуммаВторойПроводки
			СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = СуммаВторойПроводки;	
		КонецЕсли;
	КонецЕсли;

	Возврат РезультатРаботы;
	
КонецФункции

Функция ОбработатьЗаписьПоСчетамКорректировок(ПараметрыОбработки)
	
	РезультатРаботы = Новый Структура("НичегоНеДелали, ИзменилиСчет, ДобавилиПроводку, ДобавилиПроводкуЗакрытия", Ложь, Ложь, Ложь, Ложь);
	
	ОбъектДокумента 	= ПараметрыОбработки.ОбъектДокумента;
	НаборЗаписей 		= ПараметрыОбработки.НаборЗаписей;
	ВидСубконтоГФУДоходовРасходов 	= ПараметрыОбработки.ВидСубконтоГФУДоходовРасходов;
	ВидСубконтоЦенныеБумаги			= ПараметрыОбработки.ВидСубконтоЦенныеБумаги;
	СтрокаОстатков 		= ПараметрыОбработки.СтрокаОстатков;
	Запись 				= ПараметрыОбработки.Запись;
	УвеличениеОстатка 	= ПараметрыОбработки.УвеличениеОстатка;
	ПостфиксСчета 		= ПараметрыОбработки.ПостфиксСчета;
	ПостфиксОстатка 	= ПараметрыОбработки.ПостфиксОстатка;
	ПостфиксПарногоСчета 	= ПараметрыОбработки.ПостфиксПарногоСчета;
	ПостфиксПарногоОстатка 	= ПараметрыОбработки.ПостфиксПарногоОстатка;
	
	ЭтоЗакрытие7огоРаздела = (Запись["Счет" + ПостфиксПарногоСчета] = ПланыСчетов.Единый.АктивыВДУ03);
	
	Если УвеличениеОстатка Тогда
		// Счет на своем месте
		Если (СтрокаОстатков.СуммаОстатокА = 0 И СтрокаОстатков.СуммаОстатокП = 0)
			Или СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] > 0 Тогда
	        //	Остатков нет или есть остаток своего счета
			// 		проводка - ничего не делаем
			//		строка остатков - увеличиваем остаток на совем счете
			СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] + Запись.Сумма;
			
			РезультатРаботы.НичегоНеДелали = Истина;
			
		ИначеЕсли СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] >= Запись.Сумма Тогда
			//	Сумма остатка парного больше или равна сумме проводки
			Если НЕ ЭтоЗакрытие7огоРаздела Тогда
				//		проводка - меняем счет
				Запись["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				
				РезультатРаботы.ИзменилиСчет = Истина;
				
			Иначе
				//		проводка - не меняем счет
				//		добавляем проводку перекидки
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, Запись.Сумма, "Перенос начисленной переоценки перед закрытием 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;				
