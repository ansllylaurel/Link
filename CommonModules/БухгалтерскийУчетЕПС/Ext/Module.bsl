Функция СлитьУпорядоченныеМассивы(Массив1, Массив2) Экспорт

	МассивРезультат = Новый Массив;
	
	Количество1 = Массив1.Количество();
	Количество2 = Массив2.Количество();
	
	Индекс1 = 0;
	Индекс2 = 0;
	
	Пока Индекс1 < Количество1 ИЛИ Индекс2 < Количество2 Цикл
	
		Если Индекс1 = Количество1 Тогда
		
			МассивРезультат.Добавить(Массив2[Индекс2]);
			Индекс2 = Индекс2 + 1;
		
		ИначеЕсли Индекс2 = Количество2 Тогда
		
			МассивРезультат.Добавить(Массив1[Индекс1]);
			Индекс1 = Индекс1 + 1;
			
		ИначеЕсли Массив1[Индекс1] = Массив2[Индекс2] Тогда
			
			МассивРезультат.Добавить(Массив1[Индекс1]);	
			Индекс1 = Индекс1 + 1;
			Индекс2 = Индекс2 + 1;
			
		ИначеЕсли Массив1[Индекс1] < Массив2[Индекс2] Тогда
			
			МассивРезультат.Добавить(Массив1[Индекс1]);	
			Индекс1 = Индекс1 + 1;
			
		Иначе
			
			МассивРезультат.Добавить(Массив2[Индекс2]);
			Индекс2 = Индекс2 + 1;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат МассивРезультат;

