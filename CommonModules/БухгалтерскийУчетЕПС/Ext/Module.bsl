				Проводка.ВалютнаяСуммаКт = СуммаКомисии;
				
					
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Брокерская комиссия списание");
				
