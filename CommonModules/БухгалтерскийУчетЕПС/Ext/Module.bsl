Функция ПолучитьПартииПродававшиесяЗаДень(День, Организация, СчетДоверительногоУправления, НастройкиУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И БухПартииЦенныхБумаг.Организация = &Организация
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.Количество <> 0
		|	И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) <> ТИП(Документ.ВыводЦенныхБумаг)
		|			ИЛИ &БратьВыводы)";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(День));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(День));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("БратьВыводы", НЕ НастройкиУчета.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода);
	
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПДляПереоценки(ОбъектДокумента, ТабличнаяЧастьЦенныеБумаги, СообщенияОбОценочнойСтоимости = Неопределено, Отказ = Ложь) Экспорт 
	
	// это чисто ЕПСная процедура, СЧА ее не использует, она вызывается только для переоценки
	
	ДатаПереоценки = НачалоДня(ОбъектДокумента.Дата);
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления);
	
	НастройкиПереоценкиЦенныхБумаг = БухгалтерскийУчет.ОпределитьНастройкиУчетаЦенныхБумаг(ДатаПереоценки, 
		ОбъектДокумента.Организация,
		ОбъектДокумента.СчетДоверительногоУправления,
		"ПолучитьСписокНастроекДляПереоценки");
	
	//Если это первая переоценка до начала ведения учета
	Если НЕ ЗначениеЗаполнено(НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет) Тогда
		НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки + 86400, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления);
		Если НЕ ЗначениеЗаполнено(НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату переоценки не ведется единый бухгалтерский учет!", ОбъектДокумента.Ссылка,,,);
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
	Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");

	Если НастройкиУчетаОбщие.УтреннееНачислениеДисконтаПремии Тогда // у этих товарищей не нужно начислять дисконт/премию по тем бумагам и партиям, которые сегодня продавались - все уже начислено до нас
		ПартииПродававшиесяСегодня = ПолучитьПартииПродававшиесяЗаДень(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, НастройкиУчетаОбщие);
	КонецЕсли;
	
	//Если ТипЗнч(ОбъектДокумента) = Тип("Структура") Тогда
		ЦенныеБумаги = ТабличнаяЧастьЦенныеБумаги.Скопировать(
				ТабличнаяЧастьЦенныеБумаги.НайтиСтроки(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации)));
	//Иначе
	//	ЦенныеБумаги = ОбъектДокумента.ЦенныеБумаги.Выгрузить(
	//			Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации), "НомерСтроки,ЦеннаяБумага,Партия,СтрокаПартии,УчетныйАктивЕПС,Количество");
	//КонецЕсли;
	
	РешенияКлиентовПоЗначениямЭСП = РегистрыСведений.РешенияКлиентовПоЗначениямЭСП.ПолучитьПоСчету(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления);
	
	РезультатЗапроса = ПолучитьДатыИЦеныПокупки(ЦенныеБумаги, ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки);
	
	КэшДенежныхПотоковПоОблигациям = Новый Соответствие();
	
	ОблигацииНаБалансеСПрошедшимПогашением = ПолучитьОблигацииНаБалансеСПрошедшимПогашением();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокаЦенныеБумаги = ТабличнаяЧастьЦенныеБумаги[ВыборкаДетальныеЗаписи.НомерСтроки - 1];
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			ВыборкаДетальныеЗаписи.ЦеннаяБумага,
			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС,
			ВыборкаДетальныеЗаписи.Партия,
			ВыборкаДетальныеЗаписи.СтрокаПартии);
		
		Если ВыборкаДетальныеЗаписи.ДатаПогашения = NULL Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить дату погашения для ЦБ " + ВыборкаДетальныеЗаписи.ЦеннаяБумага + " (" + ВыборкаДетальныеЗаписи.Партия + "/" + ВыборкаДетальныеЗаписи.СтрокаПартии + "). Возможно, дата покупки заполнена некорректно",,,,Отказ);
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаЦенныеБумаги.Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС")		// в день реклассификации ничего делать не нужно!
			И НачалоДня(СтрокаЦенныеБумаги.ДатаПартии) = НачалоДня(ДатаПереоценки)
			И НачалоДня(ДатаПереоценки) <> '20250101' Тогда 											// исключая 1.1.25 - это день перехода на МСФО9
		
			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			
			Продолжить;
		
		КонецЕсли;
		
		
		// в день реформации баланса не работает ПрименитьПолитикуУчетаЕПС, поэтому еще тут контроль
		ОтборПоНастройке = Новый Структура("УчетныйАктивЕПС, Рынок, ЦеннаяБумага, Настройка, ЗначениеНастройки",
			ВыборкаДетальныеЗаписи.УчетныйАктивЕПС,
			Перечисления.РынкиЦенныхБумаг.Облигации,
			ВыборкаДетальныеЗаписи.ЦеннаяБумага,
			ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПериодичностьНачисленияПроцентныхДоходов,
			Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать);
		
		СтрокиНастроек = НастройкиПереоценкиЦенныхБумаг.НайтиСтроки(ОтборПоНастройке);
		
		Если СтрокиНастроек.Количество() > 0 Тогда // есть настройка, запрещающая начисление
			
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
			СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;

			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			СтрокаЦенныеБумаги.ОценочныеДисконтПремияВВалютеУчета = СтрокаЦенныеБумаги.БалансовыеДисконтПремияВВалютеУчета;

			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСП;
			СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСПВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяКорректировкаЭСПВВалютеУчета;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета;
			
			Продолжить;
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ДатаПогашения <= ДатаПереоценки														// бумага погашена, партии списаны, все по нулям, ничего не считаем
			И (ОблигацииНаБалансеСПрошедшимПогашением.Найти(ВыборкаДетальныеЗаписи.ЦеннаяБумага) = Неопределено)		// и не в списке исключений
			И ВыборкаДетальныеЗаписи.ДатаПогашения <> '00010101'														// и не бессрочная бумага
			И ДатаПереоценки < '20230715' Тогда																			// с 15.07.23 эта проверка не актуальна - дисконт/премия считаются нормально и так + суммы уходят при списании и погашении
			СтрокаЦенныеБумаги.ОценочныеДисконтПремия = 0;
			СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = 0;
			Продолжить;
		КонецЕсли;
		
		// у клиента не считается ЭСП
		Если НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода <> Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке Тогда
			// по всем, кроме "через прибыль/убыток" считаем Корректировку ЭСП независимо от настроек
			Если ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток
				И ВыборкаДетальныеЗаписи.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
				НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
			КонецЕсли;
		КонецЕсли;
		
		ДенежныйПоток = Неопределено;
		Если НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке // нужно считать корректировку по ЭСП
			И ВыборкаДетальныеЗаписи.МожноИНужноКэшироватьДенежныйПоток Тогда // можно использовать кэш
			
			ДенежныйПоток = КэшДенежныхПотоковПоОблигациям[ВыборкаДетальныеЗаписи.ЦеннаяБумага];
			Если ДенежныйПоток = Неопределено Тогда
			
				ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(
					ВыборкаДетальныеЗаписи.ЦеннаяБумага,
					Новый Структура("ДоДатыПогашения, Дата, ДатаПереоценки", Истина, ВыборкаДетальныеЗаписи.ДатаНачалаРазмещения, ДатаПереоценки));
					
				КэшДенежныхПотоковПоОблигациям.Вставить(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ДенежныйПоток);
					
			КонецЕсли;
		
		КонецЕсли;
		
		ДанныеПереоценки = Новый Структура("Количество, ОценочнаяСуммаКупона, УчетныйАктивЕПС, Партия, СтрокаПартии");
		ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаЦенныеБумаги, "Количество, ОценочнаяСуммаКупона, УчетныйАктивЕПС, Партия, СтрокаПартии");
		ДанныеПереоценки.Вставить("ДатаПереоценки", КонецДня(ДатаПереоценки)); // все расчеты у вечерней переоценки идут на конец дня
		ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаЦенныеБумаги.БалансовыеДисконтПремия);
		ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаЦенныеБумаги.БалансоваяРазницаППНеНаблюдаемыеДанные);
		ДанныеПереоценки.Вставить("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
		ДанныеПереоценки.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ОбъектДокумента.СчетДоверительногоУправления, ДатаПереоценки));
		ДанныеПереоценки.Вставить("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		ДанныеПереоценки.Вставить("ЦельРасчета", БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет));
		НастройкиЦелиРасчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, ДанныеПереоценки.ЦельРасчета);
		ДанныеПереоценки.Вставить("ВариантРасчетаОценочнойСтоимости" ,НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
		ДанныеПереоценки.Вставить("Стоимость", СтрокаЦенныеБумаги.Стоимость);
		ДанныеПереоценки.Вставить("РешенияКлиентовПоЗначениямЭСП", РешенияКлиентовПоЗначениямЭСП);
		ДанныеПереоценки.Вставить("ДенежныйПоток", ДенежныйПоток);
		
		ДанныеПокупки = Новый Структура("НачальныйДисконт,ДатаПокупки,ДатаПокупкиНачальная,КорректировкаЭСПНачальная,ЦенаПокупки,ЦенаПокупкиНачальная");
		ЗаполнитьЗначенияСвойств(ДанныеПокупки, ВыборкаДетальныеЗаписи, "НачальныйДисконт,ДатаПокупки,ДатаПокупкиНачальная,КорректировкаЭСПНачальная,ЦенаПокупки,ЦенаПокупкиНачальная");
		ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаЦенныеБумаги.НачальнаяРазницаППНеНаблюдаемыеДанные / СтрокаЦенныеБумаги.Количество);
		ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ВыборкаДетальныеЗаписи.ЦенаКупона);
		
		ДанныеРасчета = РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
													
		Если ДанныеРасчета = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаЦенныеБумаги.ОценочныеДисконтПремия = ДанныеРасчета.ОценочныеДисконтПремия;
		СтрокаЦенныеБумаги.ОценочнаяКорректировкаЭСП = ДанныеРасчета.ОценочнаяКорректировкаЭСП;
		СтрокаЦенныеБумаги.ОценочнаяРазницаППНеНаблюдаемыеДанные = ДанныеРасчета.ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		
		Если ВыборкаДетальныеЗаписи.НачальныйДисконт > 0 Тогда
			
			Если СтрокаЦенныеБумаги.ОценочныеДисконтПремия > СтрокаЦенныеБумаги.БалансовыеДисконтПремия Тогда
			
				СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;
			
			КонецЕсли;
		
		КонецЕсли;
		
		Если НастройкиУчетаЦеннойБумаги.УтреннееНачислениеДисконтаПремии Тогда
		
			СтрокиПродаж = ПартииПродававшиесяСегодня.НайтиСтроки(Новый Структура("ЦеннаяБумага,Партия,СтрокаПартии", СтрокаЦенныеБумаги.ЦеннаяБумага, СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
			Если СтрокиПродаж.Количество() > 0 Тогда // продавали - не начисляем
				СтрокаЦенныеБумаги.ОценочныеДисконтПремия = СтрокаЦенныеБумаги.БалансовыеДисконтПремия;	
			КонецЕсли;
		КонецЕсли;
		
		Если СообщенияОбОценочнойСтоимости <> Неопределено Тогда 
			Если СтрокаЦенныеБумаги.НачальныеДисконтПремия < 0 Тогда
				// Купили с дисконтом, поэтому ОценочныеДисконтПремия сравниваем с НачальныеДисконтПремия для проверки не превысили ли мы его
				Если СтрокаЦенныеБумаги.ОценочныеДисконтПремия > -СтрокаЦенныеБумаги.НачальныеДисконтПремия Тогда
					ТекстСообщения = "Оповещение о переначислении дисконта/премии: По ценной бумаге " + Строка(СтрокаЦенныеБумаги.ЦеннаяБумага) + " при переоценке ЦБ рассчитанная сумма оценочного дисконта " + Строка(СтрокаЦенныеБумаги.ОценочныеДисконтПремия) + " превысила первоначальную сумму " + Строка(-СтрокаЦенныеБумаги.НачальныеДисконтПремия);
					
					Если СообщенияОбОценочнойСтоимости.НайтиПоЗначению(ТекстСообщения) = Неопределено Тогда
						СообщенияОбОценочнойСтоимости.Добавить(ТекстСообщения);
					КонецЕсли; 
				КонецЕсли;	
			ИначеЕсли СтрокаЦенныеБумаги.НачальныеДисконтПремия > 0 Тогда
				// Купили с премией, и тут просто проверяем не ушла ли премия в минус
				Если СтрокаЦенныеБумаги.ОценочныеДисконтПремия < 0 Тогда
					ТекстСообщения = "Оповещение о переначислении дисконта/премии: По ценной бумаге " + Строка(СтрокаЦенныеБумаги.ЦеннаяБумага) + " при переоценке ЦБ рассчитанная сумма оценочной премии " + Строка(СтрокаЦенныеБумаги.ОценочныеДисконтПремия) + " превысила первоначальную и ушла в минус.";
					
					Если СообщенияОбОценочнойСтоимости.НайтиПоЗначению(ТекстСообщения) = Неопределено Тогда
						СообщенияОбОценочнойСтоимости.Добавить(ТекстСообщения);
					КонецЕсли; 
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПравильностьСписанияЦеннойБумаги(Облигация, ЭтотОбъект, Погашение, ДанныеПогашения, ВыборкаДетальныеЗаписи, НастройкиУчетаЦеннойБумаги, Отказ)

	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Облигация) <> Тип("СправочникСсылка.Облигации") Тогда
		Возврат;
	КонецЕсли;
	
	ПроверятьРаспределениеПоПартиям = Истина;
	
	Если ТипЗнч(Погашение) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
		И НастройкиУчетаЦеннойБумаги.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
		Если Погашение.ВидПогашения = Перечисления.ВидыПогашения.Оферта Тогда
			ПроверятьРаспределениеПоПартиям = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// #Хардкод - по этой бумаге был давным-давно неправильный ввод
	Если ТипЗнч(Погашение) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Белгородская007")
			И ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_БУДУЩЕЕ_ПР030518-1") Тогда
		
		    ПроверятьРаспределениеПоПартиям = Ложь;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_МФ_и_НП_НСО") Тогда
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_НижгорОбл9") Тогда 
			// Коля:
			// тут скорее всего мой косяк - там сложный метод расчета и он где-то сбоит поэтому произошло переначисление дисконта
			// но клиент с этом было согласен, поэтому единственный вариант - погасить как есть, а потом разобраться с расчетом
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26205")
			И ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН") Тогда
			// Коля:
			// СОРЯН!!!
			// иначе никак с этим САФМАРОМ
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Белгородская008")
			И ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН") Тогда
			// Коля: она пришла к нам "косая" из "УК Управление инвестициями ООО" и к погашению выровнять никак не смогли
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ХМЮгра_002")
			И ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СафмарПН") Тогда
			// Коля: она пришла к нам "косая" из "УК Управление инвестициями ООО" и к погашению выровнять никак не смогли
			// это последняя из косых сафмаровских - еще и с амортизацией
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СамарОбл010")
			И ЭтотОбъект.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СТРОЙКОМПЛЕКС_ПН") Тогда
			// Коля: у СТРОЙКОМПЛЕКСа на ходу 1го июня 21го поменяли метод расчета дисконта и к погашению не сошлось
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДОМ.РФ_016")
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ХантыМансийский") Тогда
			// Коля: Ханты еще в 19м году завели криво бумагу, так и не дошли руки исправить
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_11") Тогда
			// Коля: это облигация трудной судьбы - её вместе со Сбер 045 и ГПБ 002 купили еще в 18 году и по ним первым была сделана корректировка ПП
			// и изменена ЭСП. Тогда еще никто не знал как это делать и оформлять, плюс еще корректировали ЭСП и ПП дважды и оба раза по расчету Ани и бухгалтерии фонда
			// в итоге к погашению немного не сошлись, но все с этим согласны
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АльфаБанк_15")
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_УГМК") Тогда
			// УГМК перспектива давала свои ЭСП с меньшей точностью, при этом корректировки ПП не делалось
			// естественно, к погашению КорректировкаЭСП на 0 не вышла, остались копейки
			ПроверятьРаспределениеПоПартиям = Ложь;
		ИначеЕсли Облигация.ВалютаНоминала <> ЭтотОбъект.Организация.ВалютаУчета Тогда
			// на текущий момент пока не ясно как проверять распределение - оплаты приходят в рублях причем, дата курса может быть выбрана по-разному
			ПроверятьРаспределениеПоПартиям = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СуммаСписания = ВыборкаДетальныеЗаписи.Стоимость + ВыборкаДетальныеЗаписи.ПремияНачисленная + ВыборкаДетальныеЗаписи.ДисконтНачисленный + ВыборкаДетальныеЗаписи.КорректировкаЭСП;
	Если ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда
		// когда-то (в 2019м) году мы не умели правильно вести корректировку ПП и отражали ее в теле - это случай ненаблюдаемых данных (хотя такие на бирже не возможны!)
		// потом мы сделали правильно, но по тем счетам, где она уже была, ничего менять было нельзя и мы оставили по ним как есть
		// для этого была введена функция ПолучитьМассивСчетовСПравильнымУчетомПП чтобы отделить Счета ДУ с учетом по-старому (неправильно) и по-новому (правильно)
		ВключатьВСуммуСписанияНачальнуюПП = Не НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания; // Клиенты с неправильным учетом включают ее в стоимость
		Если ВключатьВСуммуСписанияНачальнуюПП Тогда
			СуммаСписания = СуммаСписания + ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная; // начальную корректировку ПП - в тело!	
		КонецЕсли;
		
		// все остальные клиенты должны включать в стоимость корректироку ПП (не начальную! обычную!)
		СуммаСписания = СуммаСписания + ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные; // начальную корректировку ПП - в тело!	
		
	КонецЕсли;
	
	Если Облигация.ИндексируемыйНоминал Тогда
		НоминалПриПокупке = Справочники.Облигации.ПолучитьНоминал(Облигация, ВыборкаДетальныеЗаписи.ДатаПокупки);
		СуммаПогашения = НоминалПриПокупке * ВыборкаДетальныеЗаписи.КоличествоОстаток;
		
		ВариантУчетаИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "ВариантУчетаИндексацииНоминала");
		Если ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала
			ИЛИ ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНоминалаПриПокупке Тогда
			
			Если ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНачальногоНоминала
					И ВыборкаДетальныеЗаписи.ИндексацияНоминала <> (ВыборкаДетальныеЗаписи.Номинал - Облигация.Номинал) * ВыборкаДетальныеЗаписи.КоличествоОстаток
				ИЛИ ВариантУчетаИндексацииНоминала = Перечисления.ВариантыУчетаИндексированногоНоминала.ОтНоминалаПриПокупке
					И ВыборкаДетальныеЗаписи.ИндексацияНоминала <> (ВыборкаДетальныеЗаписи.Номинал - НоминалПриПокупке) * ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма списываемой индексации номинала не совпадает с расчетной суммой индексации номинала " + Погашение,,,, Отказ);
			КонецЕсли;
				
		КонецЕсли;
	Иначе
		СуммаПогашения = ДанныеПогашения.Сумма / ДанныеПогашения.Количество * ВыборкаДетальныеЗаписи.КоличествоОстаток;
	КонецЕсли;
	
	Если ПроверятьРаспределениеПоПартиям И СуммаСписания <> СуммаПогашения Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма распределения по партиям не совпадает с суммой погашения " + Погашение,,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуОстатковПоПарнымСчетамДоходовРасходов(Граница, Организация, СчетДоверительногоУправления, ЗакрыватьПереоценки, ЗакрыватьКорректировкиЭСП, МассивУчетныхАктивов = Неопределено, МассивЦенныхБумаг = Неопределено, Ссылка = Неопределено) Экспорт

	// Формируем таблицу парных счетов по данным справочника Учетные активы ЕПС, присоединяем соответствующие остатки
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаДоходовОтОпераций КАК СчетП,
		|	УчетныеАктивыЕПС.СчетУчетаРасходовОтОпераций КАК СчетА,
		|	УчетныеАктивыЕПС.АналитикаДоходовОтПереоценки КАК АналитикаП,
		|	УчетныеАктивыЕПС.АналитикаРасходовОтПереоценки КАК АналитикаА,
		|	ЛОЖЬ КАК ЭтоКорректировка
		|ПОМЕСТИТЬ _ПарныеСчета
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	&ЗакрыватьПереоценки
		|	И УчетныеАктивыЕПС.Ссылка В(&МассивУчетныхАктивов)
		|	И УчетныеАктивыЕПС.АналитикаДоходовОтПереоценки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|	И УчетныеАктивыЕПС.АналитикаРасходовОтПереоценки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|	И УчетныеАктивыЕПС.СчетУчетаДоходовОтОпераций <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)
		|	И УчетныеАктивыЕПС.СчетУчетаРасходовОтОпераций <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы05),
		|	ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы06),
		|	УчетныеАктивыЕПС.АналитикаДоходовОтКорректировки,
		|	УчетныеАктивыЕПС.АналитикаРасходовОтКорректировки,
		|	ИСТИНА
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	&ЗакрыватьКорректировкиЭСП
		|	И УчетныеАктивыЕПС.Ссылка В(&МассивУчетныхАктивов)
		|	И УчетныеАктивыЕПС.АналитикаДоходовОтКорректировки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|	И УчетныеАктивыЕПС.АналитикаРасходовОтКорректировки <> ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Аналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиНаНачалоДокумента
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДоДокумента,
		|			,
		|			&МассивСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И &МассивЦБ) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПарныеСчета КАК ПарныеСчета
		|		ПО (ПарныеСчета.АналитикаП = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|				ИЛИ ПарныеСчета.АналитикаА = ЕдиныйБухгалтерскийУчетОстатки.Субконто1)
		|			И (ПарныеСчета.СчетП = ЕдиныйБухгалтерскийУчетОстатки.Счет
		|				ИЛИ ПарныеСчета.СчетА = ЕдиныйБухгалтерскийУчетОстатки.Счет)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПарныеСчета.СчетП КАК СчетП,
		|	_ПарныеСчета.СчетА КАК СчетА,
		|	_ПарныеСчета.АналитикаП КАК АналитикаП,
		|	_ПарныеСчета.АналитикаА КАК АналитикаА,
		|	_ОстаткиНаНачалоДокумента.ЦеннаяБумага КАК ЦеннаяБумага,
		|	-ЕСТЬNULL(_ОстаткиНаНачалоДокументаП.СуммаОстаток, 0) КАК СуммаОстатокП,
		|	ЕСТЬNULL(_ОстаткиНаНачалоДокументаА.СуммаОстаток, 0) КАК СуммаОстатокА
		|ИЗ
		|	_ПарныеСчета КАК _ПарныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокумента
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокументаА
		|		ПО _ПарныеСчета.СчетА = _ОстаткиНаНачалоДокументаА.Счет
		|			И _ПарныеСчета.АналитикаА = _ОстаткиНаНачалоДокументаА.Аналитика
		|			И (_ОстаткиНаНачалоДокумента.ЦеннаяБумага = _ОстаткиНаНачалоДокументаА.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокументаП
		|		ПО _ПарныеСчета.СчетП = _ОстаткиНаНачалоДокументаП.Счет
		|			И _ПарныеСчета.АналитикаП = _ОстаткиНаНачалоДокументаП.Аналитика
		|			И (_ОстаткиНаНачалоДокумента.ЦеннаяБумага = _ОстаткиНаНачалоДокументаП.ЦеннаяБумага)
		|ГДЕ
		|	(ЕСТЬNULL(_ОстаткиНаНачалоДокументаП.СуммаОстаток, 0) <> 0
		|				И ЕСТЬNULL(_ОстаткиНаНачалоДокументаА.СуммаОстаток, 0) <> 0
		|			ИЛИ ЕСТЬNULL(_ОстаткиНаНачалоДокументаП.СуммаОстаток, 0) > 0
		|			ИЛИ ЕСТЬNULL(_ОстаткиНаНачалоДокументаА.СуммаОстаток, 0) < 0)";

	ВидСубконтоГФУДоходовРасходов = ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов;
	ВидСубконтоЦенныеБумаги = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ВидСубконтоГФУДоходовРасходов);
	МассивСубконто.Добавить(ВидСубконтоЦенныеБумаги);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&МассивЦБ", ?(ЗначениеЗаполнено(МассивЦенныхБумаг), "Субконто2 В (&МассивЦБ)", "ИСТИНА"));
	Если НЕ ЗначениеЗаполнено(МассивУчетныхАктивов) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И УчетныеАктивыЕПС.Ссылка В(&МассивУчетныхАктивов)", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивСубконто",					МассивСубконто);
	Запрос.УстановитьПараметр("МассивУчетныхАктивов",			МассивУчетныхАктивов);
	Запрос.УстановитьПараметр("МассивЦБ", 						МассивЦенныхБумаг);
	Запрос.УстановитьПараметр("ДоДокумента",					Граница);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЗакрыватьПереоценки",			ЗакрыватьПереоценки);
	Запрос.УстановитьПараметр("ЗакрыватьКорректировкиЭСП",		ЗакрыватьКорректировкиЭСП);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		
		ТаблицаОстатковДо = Результат.Выгрузить();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректные остатки доходов и расходов: ", Ссылка);
		
		Для Каждого СтрокаОстатковДо из ТаблицаОстатковДо Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(" " + СтрокаОстатковДо.ЦеннаяБумага 
			+ " (активный счет " + СтрокаОстатковДо.СчетА + ", ОФР " + СтрокаОстатковДо.АналитикаА + ": " + Формат(СтрокаОстатковДо.СуммаОстатокА, "ЧДЦ=2; ЧРД=.; ЧРГ=' '") 
			+ ", пассивный счет" + СтрокаОстатковДо.СчетП + ", ОФР " + СтрокаОстатковДо.АналитикаП + ": " + Формат(СтрокаОстатковДо.СуммаОстатокП, "ЧДЦ=2; ЧРД=.; ЧРГ=' '") +")", Ссылка);
		КонецЦикла;
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПарныеСчета.СчетП КАК СчетП,
		|	_ПарныеСчета.СчетА КАК СчетА,
		|	_ПарныеСчета.АналитикаП КАК АналитикаП,
		|	_ПарныеСчета.АналитикаА КАК АналитикаА,
		|	ЕСТЬNULL(_ОстаткиНаНачалоДокумента.ЦеннаяБумага, НЕОПРЕДЕЛЕНО) КАК ЦеннаяБумага,
		|	-ЕСТЬNULL(_ОстаткиНаНачалоДокументаП.СуммаОстаток, 0) КАК СуммаОстатокП,
		|	ЕСТЬNULL(_ОстаткиНаНачалоДокументаА.СуммаОстаток, 0) КАК СуммаОстатокА,
		|	_ПарныеСчета.ЭтоКорректировка КАК ЭтоКорректировка
		|ПОМЕСТИТЬ _ОстаткиРазвернуто
		|ИЗ
		|	_ПарныеСчета КАК _ПарныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокумента
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокументаА
		|		ПО _ПарныеСчета.СчетА = _ОстаткиНаНачалоДокументаА.Счет
		|			И _ПарныеСчета.АналитикаА = _ОстаткиНаНачалоДокументаА.Аналитика
		|			И (_ОстаткиНаНачалоДокумента.ЦеннаяБумага = _ОстаткиНаНачалоДокументаА.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаНачалоДокумента КАК _ОстаткиНаНачалоДокументаП
		|		ПО _ПарныеСчета.СчетП = _ОстаткиНаНачалоДокументаП.Счет
		|			И _ПарныеСчета.АналитикаП = _ОстаткиНаНачалоДокументаП.Аналитика
		|			И (_ОстаткиНаНачалоДокумента.ЦеннаяБумага = _ОстаткиНаНачалоДокументаП.ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ПарныеСчета.СчетП,
		|	_ПарныеСчета.СчетА,
		|	_ПарныеСчета.АналитикаП,
		|	_ПарныеСчета.АналитикаА,
		|	НЕОПРЕДЕЛЕНО,
		|	0,
		|	0,
		|	_ПарныеСчета.ЭтоКорректировка
		|ИЗ
		|	_ПарныеСчета КАК _ПарныеСчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиРазвернуто.СчетП КАК СчетП,
		|	_ОстаткиРазвернуто.СчетА КАК СчетА,
		|	_ОстаткиРазвернуто.АналитикаП КАК АналитикаП,
		|	_ОстаткиРазвернуто.АналитикаА КАК АналитикаА,
		|	_ОстаткиРазвернуто.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиРазвернуто.СуммаОстатокП КАК СуммаОстатокП,
		|	_ОстаткиРазвернуто.СуммаОстатокА КАК СуммаОстатокА,
		|	_ОстаткиРазвернуто.ЭтоКорректировка КАК ЭтоКорректировка
		|ИЗ
		|	_ОстаткиРазвернуто КАК _ОстаткиРазвернуто";
		
	Возврат Запрос.Выполнить().Выгрузить();

	
КонецФункции 

Функция ОпределитьДатуНачалаБухгалтерскогоПериода(ДатаОпределения, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеформацииБалансов.ДатаРеформации КАК ДатаРеформации
		|ИЗ
		|	РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
		|ГДЕ
		|	РеформацииБалансов.Организация = &Организация
		|	И РеформацииБалансов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеформацииБалансов.ДатаРеформации < &ДатаОпределения
		|	И РеформацииБалансов.ДатаРеформации >= &ДатаНачалаГода
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРеформации УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНачалаГода", НачалоГода(ДатаОпределения));
	Запрос.УстановитьПараметр("ДатаОпределения", ДатаОпределения);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(СчетДоверительногоУправления));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
		Возврат ВыборкаДетальныеЗаписи.ДатаРеформации + 24 * 60 * 60; // начало следующего дня
	
	КонецЕсли;
	
	Возврат	НачалоГода(ДатаОпределения);

