Функция ПолучитьСчетДоходаРасходаПоКурсовойРазнице(ОбъектДокумента, Счет, Субконто1, Субконто2, Субконто3, ДополнительнаяАналитика, Валюта, КурсоваяРазница, Отказ) Экспорт
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ЦеннаяБумага", Неопределено);
	
	СчетГлавыВ = (Счет.ГлаваПланаСчетовНФО = Перечисления.ГлавыПланаСчетовНФО.ГлаваВ);
	СчетГлавыГ = (Счет.ГлаваПланаСчетовНФО = Перечисления.ГлавыПланаСчетовНФО.ГлаваГ);
	
	Если КурсоваяРазница > 0 Тогда
		Если Счет.Вид = ВидСчета.Активный Тогда
			Если СчетГлавыВ Тогда
			    СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСАктивом9;
			ИначеЕсли СчетГлавыГ Тогда
				СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСАктивом;
			Иначе
				СчетДоходаРасхода = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			КонецЕсли;
		Иначе 						
			Если СчетГлавыВ Тогда
			    СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
			ИначеЕсли СчетГлавыГ Тогда
				СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			Иначе
				СчетДоходаРасхода = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Счет.Вид = ВидСчета.Активный Тогда
			Если СчетГлавыВ Тогда
			    СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСАктивом9;
			ИначеЕсли СчетГлавыГ Тогда
				СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСАктивом;
			Иначе
				СчетДоходаРасхода = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			КонецЕсли;
		Иначе 						
			Если СчетГлавыВ Тогда
			    СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
			ИначеЕсли СчетГлавыГ Тогда
				СчетДоходаРасхода = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			Иначе
				СчетДоходаРасхода = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если (Счет = ПланыСчетов.Единый.Расчеты23 ИЛИ Счет = ПланыСчетов.Единый.Расчеты23) И ЗначениеЗаполнено(Субконто1) И ЗначениеЗаполнено(Субконто2)
		ИЛИ ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона 
		ИЛИ ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела Тогда
		
		СтруктураРезультата.Вставить("Счет", СчетДоходаРасхода);
		СтруктураРезультата.Вставить("ГруппаФинансовогоУчетаДоходовРасходов", БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(СчетДоходаРасхода, Валюта));
		Если ТипЗнч(Субконто2) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			Если ТипЗНч(ОбъектДокумента) = Тип("ДокументОбъект.Оплата") ТОгда
				ВидЗадолженности = ОбъектДокумента.ВидЗадолженности;
			Иначе 
				//задлженность м.б. по купону или по телу бумаги
				ВидЗадолженности = Справочники.ВидыЗадолженности.ПустаяСсылка();
			КонецЕсли;
			СтруктураРезультата.ЦеннаяБумага = ПолучитьЦеннуюБумагуПриОплатеПогашенияПоВводу(Субконто2, Субконто1, ВидЗадолженности, Отказ); 
		ИначеЕсли ТипЗнч(Субконто1) = Тип("СправочникСсылка.Облигации") Тогда
			СтруктураРезультата.ЦеннаяБумага = Субконто1; 
		ИначеЕсли ТипЗнч(Субконто2) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
			СтруктураРезультата.ЦеннаяБумага = Субконто2.Облигация; 
		Иначе	
			//погашение
			СтруктураРезультата.ЦеннаяБумага = Субконто2.ЦеннаяБумага; 
		КонецЕсли;
		
		Возврат СтруктураРезультата;
		
	ИначеЕсли СчетГлавыВ ИЛИ СчетГлавыГ Тогда
		
		СтруктураРезультата.Вставить("Счет", СчетДоходаРасхода);
		СтруктураРезультата.Вставить("ГруппаФинансовогоУчетаДоходовРасходов", Справочники.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка());
		Возврат СтруктураРезультата;
		
	ИначеЕсли 
		Счет = ПланыСчетов.Единый.ДенежныеСредстваВПути 
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты07
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты08
			ИЛИ Счет = ПланыСчетов.Единый.Расчеты23
			ИЛИ Счет = ПланыСчетов.Единый.РасчетныеСчета01   
			ИЛИ Счет = ПланыСчетов.Единый.РасчетыСБрокерами01
			ИЛИ Счет = ПланыСчетов.Единый.РасчетыСБрокерами02
			ИЛИ Счет = ПланыСчетов.Единый.Депозиты01   
			ИЛИ Счет = ПланыСчетов.Единый.АктивыВДУ03
			ИЛИ Счет.Родитель = ПланыСчетов.Единый.ПрочиеСредства
			ИЛИ Счет.Родитель = ПланыСчетов.Единый.ПрочиеСредстваКоммерческим

	Тогда
		
		СтруктураРезультата.Вставить("Счет", СчетДоходаРасхода);
		СтруктураРезультата.Вставить("ГруппаФинансовогоУчетаДоходовРасходов", БухгалтерскийУчетЕПС.ПолучитьГФУПоВалюте(СчетДоходаРасхода, Валюта));
		Возврат СтруктураРезультата;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен счет доходов/расходов курсовой разницы для счета "+Счет+"("+Субконто1+","+Субконто2+","+Субконто3+","+ДополнительнаяАналитика+") по документу " + ОбъектДокумента.Ссылка,ОбъектДокумента,,,Отказ);
	
	Возврат Неопределено;
КонецФункции

Функция ПолучитьЦеннуюБумагуПриОплатеПогашенияПоВводу(ВводЦБ, Контрагент, ВидЗадолженности, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность) КАК ДебиторскаяЗадолженность,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон) КАК ДебиторскаяЗадолженностьКупон
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон > 0
		|			ИЛИ ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность > 0)
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка = &ВводЦБ
		|	И ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо = &Контрагент
		|	И ВЫБОР
		|			КОГДА &ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|				ТОГДА ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон > 0
		|			КОГДА &ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|				ТОГДА ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность > 0
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ВводЦБ", ВводЦБ);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество()>1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По документу " + ВводЦБ + " введена задолженность по нескольким бумагам эмитента " + Контрагент + ". Необходимо разделить вводы ценных бумаг",,,,Отказ);
		Возврат Неопределено;
	Иначе
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОпределитьПостфиксГФУ(Контрагент, НаДату) 

	//0	По прочим средствам, предоставленным негосударственным финансовым организациям
	//1	По прочим средствам, предоставленным негосударственным коммерческим организациям
	//2	По прочим средствам, предоставленным негосударственным некоммерческим организациям
	//3	По прочим средствам, предоставленным юридическим лицам - нерезидентам
	//4	По прочим средствам, предоставленным кредитным организациям
	//5	По прочим средствам, предоставленным банкам-нерезидентам
	
	//6	По прочим средствам, предоставленным физическим лицам
	//7	По прочим средствам, предоставленным физическим лицам - нерезидентам
	
	Если Контрагент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		ВызватьИсключение Контрагент + " является физическим лицом";	
	Иначе
		
		ДатаПеречня = КонсолидированнаяОтчетность.ПолучитьДатуПеречняФинансовыхОрганизаций(НаДату);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПеречниОбъектов.ВидПеречня КАК ВидПеречня
			|ИЗ
			|	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
			|ГДЕ
			|	ПеречниОбъектов.Включен
			|	И ПеречниОбъектов.Период = &ДатаПеречня
			|	И ПеречниОбъектов.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
			|	И ПеречниОбъектов.ВидПеречня.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора)
			|	И ПеречниОбъектов.Объект = &Контрагент";
		
		Запрос.УстановитьПараметр("ДатаПеречня", ДатаПеречня);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ВыборкаДетальныеЗаписи.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ЦБРФ_Нерезиденты Тогда
				Если Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Контрагент, "Банки") = Неопределено Тогда
					Возврат "3";	
				Иначе
					Возврат "5";	
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ЦБРФ_КредитныеОрганизации Тогда
				Возврат "4";	
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ЦБРФ_НекоммерческиеОрганизацииОбслуживающиеНаселение Тогда
				Возврат "2";	
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ЦБРФ_НефинансовыеОрганизации Тогда
				Возврат "1";	
			Иначе
				Возврат "0";	
			КонецЕсли;
		КонецЕсли;
		Возврат "0";	
	КонецЕсли;

КонецФункции

Функция ОпределитьПостфиксГФУДляРасходов(Контрагент, НаДату) 
	
	//2	Процентные расходы: по привлеченным средствам негосударственных финансовых организаций
	//3	Процентные расходы: по привлеченным средствам негосударственных коммерческих организаций
	//4	Процентные расходы: по привлеченным средствам негосударственных некоммерческих организаций
	//5	Процентные расходы: по привлеченным средствам юридических лиц - нерезидентов
	//6	Процентные расходы: по привлеченным средствам кредитных организаций
	//7	Процентные расходы: по привлеченным средствам банков-нерезидентов
	
	//8	Процентные расходы: по привлеченным средствам физических лиц
	//9	Процентные расходы: по привлеченным средствам физических лиц - нерезидентов
	
	ПостфиксГФУДоходов = ОпределитьПостфиксГФУ(Контрагент, НаДату);
	
	Возврат Строка(Число(ПостфиксГФУДоходов) + 2);
	
КонецФункции

