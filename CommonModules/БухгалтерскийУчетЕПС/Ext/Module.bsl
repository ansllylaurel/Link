			Проводка.ВалютнаяСуммаКт = СуммаКомисии;
			
			
			Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
				
				// если мы этой сделкой только закрываем чужие сделки и не открываем новых то мы сразу же и закроем 7ой раздел 
				// ибо других прибылей/убытков по сделке не предполагается
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	БухПартииСрочныхКонтрактов.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СУММА(БухПартииСрочныхКонтрактов.Количество) КАК Количество
					|ПОМЕСТИТЬ ОткрытияКонтрактов
					|ИЗ
					|	РегистрНакопления.БухПартииСрочныхКонтрактов КАК БухПартииСрочныхКонтрактов
					|ГДЕ
					|	БухПартииСрочныхКонтрактов.Регистратор = &Регистратор
					|	И БухПартииСрочныхКонтрактов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					|	И БухПартииСрочныхКонтрактов.ВидУчета = &ВидУчета
					|
					|СГРУППИРОВАТЬ ПО
					|	БухПартииСрочныхКонтрактов.ЦеннаяБумага
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
					|	СделкаЦенныеБумаги.Количество КАК КоличествоСделка,
					|	РасходыПоСделкеОбороты.СуммаОборот КАК БрокерскаяКомиссия,
					|	ЕСТЬNULL(ОткрытияКонтрактов.Количество, 0) КАК Количество
					|ИЗ
					|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
					|		ЛЕВОЕ СОЕДИНЕНИЕ ОткрытияКонтрактов КАК ОткрытияКонтрактов
					|		ПО (ОткрытияКонтрактов.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага),
					|	РегистрНакопления.РасходыПоСделке.Обороты(
					|			,
					|			&ОкончаниеПериода,
					|			Период,
					|			СчетДоверительногоУправления = &СчетДоверительногоУправления
					|				И Сделка = &Регистратор
					|				И Организация = &Организация
					|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделкеОбороты
					|ГДЕ
					|	СделкаЦенныеБумаги.Ссылка = &Регистратор";
				
				Запрос.УстановитьПараметр("Регистратор", Сделка);
				Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
				
				Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
				Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
				
				
				Создания = Запрос.Выполнить().Выгрузить();
				Для каждого СтрокаСоздания Из Создания Цикл
					
					Если СтрокаСоздания.Количество = 0 Тогда // мы не создавали новых партий
						
						УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(, Перечисления.РынкиЦенныхБумаг.Фьючерсы, СтрокаСоздания.ЦеннаяБумага, ОбъектДокумента.СчетДоверительногоУправления);
						
						//Если МассивУчетныхАктивов.Найти(УчетныйАктивЕПС) = Неопределено Тогда
						//	МассивУчетныхАктивов.Добавить(УчетныйАктивЕПС);
						//КонецЕсли;
						
						// закроем 7ой раздел в части начисленной комиссии
						БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
							ОбъектДокумента,
							УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций,
							СтрокаСоздания.ЦеннаяБумага,
							УчетныйАктивЕПС.АналитикаРасходовОтОпераций,
							ВалютаКомиссии,
							"Закрытие доначисления по переоценке фьючерса",
							АналитикаКомиссии,
							СтрокаСоздания.БрокерскаяКомиссия);
					
					КонецЕсли;
					
				КонецЦикла;
			
			КонецЕсли;
			
		ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			
			Если ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты И ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка") Тогда // пошли сложности
				
				ПроводитьЧерезРасчеты = Ложь;
				
				Если Сделка.ОтложенноеИсполнение Тогда
					
					Если Сделка.РаздельноеИсполнение Тогда
						ДатаПоставки = Сделка.ДатаПоставки;
					Иначе
						ДатаПоставки = Сделка.ДатаИсполнения;
					КонецЕсли;
					
					Если ОплатаВДеньПокупки Тогда
						
						ПроводитьЧерезРасчеты = Ложь; // В день сделки - на предварительные
						ОплатаВДеньПокупки = Ложь;
						
					ИначеЕсли НачалоДня(ОбъектДокумента.Дата) < ДатаПоставки Тогда
						
						ПроводитьЧерезРасчеты = Ложь; // Между сделкой и исполнением - на предварительные
						
					ИначеЕсли НачалоДня(ОбъектДокумента.Дата) = ДатаПоставки Тогда
						
						ОплатаВДеньПокупки = Истина; // В день исполнения - на расходы
						//ВключатьРасходыПоПокупкеВСтоимость = Ложь; - это лишняя штука, ее быть не должно, я проверил: случаев Т+ + АС + "ОтражатьПре.." + Оплата в день исполнения не было до 25.1.23 где это вылезло по СНГ
						
					Иначе
						
						ПроводитьЧерезРасчеты = Истина; // После исполнения - на расчеты
						
					КонецЕсли;
					
				ИначеЕсли НЕ ОплатаВДеньПокупки Тогда // сделка Т0 и исполнение не в момент сделки т.е. позднее - значит нужно через расчеты
					
					ПроводитьЧерезРасчеты = Истина;
					
				КонецЕсли;
			
			КонецЕсли;
			
			//оплата комиссии
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ВидКомиссии.Наименование + " списание");
			// дебет
			Если ПроводитьЧерезРасчеты Тогда
				Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты22;
				Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
				Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			ИначеЕсли ОплатаВДеньПокупки Тогда
				Если ВключатьРасходыПоПокупкеВСтоимость Тогда
					Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты08;
					Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
					Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
				Иначе
					Проводка.СчетДт 											= УчетныйАктив.СчетУчетаРасходовОтОпераций;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов 	= УчетныйАктив.АналитикаРасходовОтОпераций;
					Проводка.СубконтоДт.ЦенныеБумаги 							= ЦБ;
					
					Если ОтражатьПартииНаЛицевыхСчетах Тогда
					
						Проводка.Партия = Сделка;
						Проводка.СтрокаПартии = 1; // я понимаю, что это не совсем правильно, но у меня цейтнот - позже исправлю
					
					КонецЕсли;
					
				КонецЕсли;
			Иначе
				Проводка.СчетДт 						= ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
				Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
				Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			КонецЕсли;
			
			Если  ВключатьРасходыПоПокупкеВСтоимость ИЛИ НЕ ОплатаВДеньПокупки Тогда
				Проводка.ВалютаДт  			= ЦБ.ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт 	= РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКомисии, ВалютаКомиссии, ОбъектДокумента.Дата, ЦБ.ВалютаНоминала, ОбъектДокумента.Дата, Отказ);
			ИначеЕсли ПроводитьЧерезРасчеты Тогда
				Проводка.ВалютаДт  			= ВалютаКомиссии;
				Проводка.ВалютнаяСуммаДт 	= СуммаКомисии;
			ИначеЕсли ОплатаВДеньПокупки И ВключатьРасходыПоПокупкеВСтоимость Тогда
				Проводка.ВалютаДт  = ВалютаКомиссии;
				Проводка.ВалютнаяСуммаДт = СуммаКомисии;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт 					= СчетДС;
			Проводка.СубконтоКт[ВидСубконтоДС] 	= СубконтоДС;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= ВидДвиженияДенежныхСредств;
			
			Проводка.ВалютаКт  			= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт 	= СуммаКомисии;
			
		ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			
			ВключатьРасходыПоПокупкеВСтоимость = Ложь; // у нас же продажа, какие расчеты?
			
			Если ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты И ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка") Тогда // пошли сложности
				
				ПроводитьЧерезРасчеты = Ложь;
				
				Если Сделка.ОтложенноеИсполнение Тогда
					
					Если Сделка.РаздельноеИсполнение Тогда
						ДатаПоставки = Сделка.ДатаПоставки;
					Иначе
						ДатаПоставки = Сделка.ДатаИсполнения;
					КонецЕсли;
					
					Если ОплатаВДеньПокупки Тогда
						
						ПроводитьЧерезРасчеты = Ложь; // В день сделки - на предварительные
						ОплатаВДеньПокупки = Ложь;
						
					ИначеЕсли НачалоДня(ОбъектДокумента.Дата) < ДатаПоставки Тогда 
						
						ПроводитьЧерезРасчеты = Ложь; // Между сделкой и исполнением - на предварительные
						ОплатаВДеньПокупки = Ложь;
						
					ИначеЕсли НачалоДня(ОбъектДокумента.Дата) = ДатаПоставки Тогда 
						
						ОплатаВДеньПокупки = Истина; // В день исполнения - на расходы
						ВключатьРасходыПоПокупкеВСтоимость = Истина;
						
					Иначе
						
						ПроводитьЧерезРасчеты = Истина; // После исполнения - на расчеты
						
					КонецЕсли;
					
				ИначеЕсли НЕ ОплатаВДеньПокупки Тогда // сделка Т0 и исполнение не в момент сделки т.е. позднее - значит нужно через расчеты
					
					ПроводитьЧерезРасчеты = Истина;
					
				КонецЕсли;
			
			КонецЕсли;
			
			//списание комиссии
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ВидКомиссии.Наименование + " списание");
			
			// дебет
			Если ПроводитьЧерезРасчеты Тогда
				Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты22;
				Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
			Иначе
				Если ОплатаВДеньПокупки Тогда
					Проводка.СчетДт 					= ПланыСчетов.Единый.ВыбытиеИРеализация10;
					Проводка.СубконтоДт.Ценныебумаги 	= ЦБ;
				Иначе
					Проводка.СчетДт 					= ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
					Проводка.СубконтоДт.Контрагенты 	= КонтрагентПоКомиссии;
				КонецЕсли;
			КонецЕсли;
			
			Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютаДт  			= ВалютаКомиссии;
				Проводка.ВалютнаяСуммаДт 	= СуммаКомисии;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт 					= СчетДС;
			Проводка.СубконтоКт[ВидСубконтоДС] 	= СубконтоДС;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= ВидДвиженияДенежныхСредств;
			
			Проводка.ВалютаКт  			= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт 	= СуммаКомисии;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиПокупкиПродажиЦеннойБумаги(ОбъектДокумента, Сделка, УчетныйРегистр, Отказ) Экспорт

	ЭтоСделка = (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка"));
	ЭтоИсполнение = (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке"));
	ЭтоПоставка = (ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПоставкаЦенныхБумаг"));
	
	РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сделка, "ВидСделки, Дата, Брокер, Контрагент, РасчетныйСчет, ВалютаСделки");
	
	НастройкиУчетаОбщие = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиУчета(
		ОбъектДокумента.Дата,
		ОбъектДокумента.Организация,
		ОбъектДокумента.СчетДоверительногоУправления);

	Если ЭтоПоставка Тогда // никогда не закрывает 7ой раздел - это делает оплата
		Закрывать7ойРазделПриПоступленииДенежныхСредств = Ложь;
	Иначе
		Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления);
	КонецЕсли;

	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектДокумента.Организация, "ВалютаУчета"); 
	
	НужнаТаблицаОстатков = Ложь;
	Если РеквизитыСделки.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		Для каждого СтрокаЦенныеБумаги Из ОбъектДокумента.ЦенныеБумаги Цикл
			Если СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала <> ВалютаУчета  Тогда
				НужнаТаблицаОстатков = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если РеквизитыСделки.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
		Контрагент 				= РеквизитыСделки.Брокер.ЮрФизЛицо;
		КонтрагентПоКомиссии	= РеквизитыСделки.Брокер.ЮрФизЛицо;
		СчетДС 					= ПланыСчетов.Единый.РасчетыСБрокерами02;
		
		ВидСубконтоДС	= ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
		СубконтоДС 		= БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ОбъектДокумента.СчетДоверительногоУправления, РеквизитыСделки.Брокер, РеквизитыСделки.Дата);
	Иначе
		Контрагент 				= РеквизитыСделки.Контрагент;
		КонтрагентПоКомиссии 	= РеквизитыСделки.Контрагент;
		Если Справочники.Банки.ЯвляетсяРезидентом(РеквизитыСделки.РасчетныйСчет.Банк, РеквизитыСделки.Дата) Тогда
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			СчетДС = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		
		ВидСубконтоДС 	= ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета;
		СубконтоДС		= РеквизитыСделки.РасчетныйСчет;
	КонецЕсли;
	
	Если ЭтоИсполнение ИЛИ ЭтоПоставка Тогда
		
		НужнаТаблицаПредварительныхЗатрат = Истина;
		НужнаТаблицаДвиженийПоГлавеГ = Истина;
		ПереоценкаБумагПриПродажеНаСчетахГлавыГ = НастройкиУчетаОбщие.ПереоцениватьБумагиПриПродажеНаСчетахГлавыГ И РеквизитыСделки.ВидСделки = Перечисления.ВидыСделок.Продажа;	
		
		КонтрагентЯвляетсяРезидентом = Справочники.ЮрФизЛица.ЯвляетсяРезидентом(Контрагент, ОбъектДокумента.Организация);
		Если РеквизитыСделки.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			СчетДСГлаваГ = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС01, ПланыСчетов.Единый.ОбязательстваПоПоставкеДС02);
			СчетЦБГлаваГ = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ01, ПланыСчетов.Единый.ТребованияПоПоставкеЦБ02);
		Иначе
			СчетДСГлаваГ = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ТребованияПоПоставкеДС01, ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
			СчетЦБГлаваГ = ?(КонтрагентЯвляетсяРезидентом, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01, ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ02);
		КонецЕсли;
		
		ПараметрыДляГлавыГ = Новый Структура("ПереоценкаБумагПриПродажеНаСчетахГлавыГ, СчетДСГлаваГ, СчетЦБГлаваГ", ПереоценкаБумагПриПродажеНаСчетахГлавыГ, СчетДСГлаваГ, СчетЦБГлаваГ);
		
	Иначе
		
		НужнаТаблицаПредварительныхЗатрат = Ложь;
		ПараметрыДляГлавыГ = Неопределено;
		
	КонецЕсли;
	
	// все запросы к данным строго тут!!! это нужно для дальнейших оптимизаций
	// в остальных местах строго формирование проводок и более ничего!
	ДанныеПартий = ПолучитьДвиженияДляФормированияПроводокПоТорговымОперациям(ОбъектДокумента, Сделка, Перечисления.ВидыУчета[УчетныйРегистр], НужнаТаблицаОстатков, НужнаТаблицаПредварительныхЗатрат, ПараметрыДляГлавыГ);
	
	ДвиженияПартий					= ДанныеПартий.ДвиженияПартий;
	ОстаткиПартий					= ДанныеПартий.ОстаткиПартий;
	ТаблицаНакладныхРасходов		= ДанныеПартий.ТаблицаНакладныхРасходов;
	ТаблицаДвиженийПоГлавеГ			= ДанныеПартий.ТаблицаДвиженийПоГлавеГ;
	ТаблицаПредварительныхЗатрат	= ДанныеПартий.ТаблицаПредварительныхЗатрат;
	АналитикаРезервов	= ДанныеПартий.АналитикаРезервов;
	
	Если ДвиженияПартий.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для документа не расчитаны партии!", ОбъектДокумента, "ДатаИсполнения",, Отказ);
		Возврат;
	КонецЕсли; 	

	ОбщаяСумма = ОбъектДокумента.ЦенныеБумаги.Итог("Сумма");
	ОбщаяСуммаКупона = ОбъектДокумента.ЦенныеБумаги.Итог("СуммаКупона");
	ОбщаяСуммаСделки = ОбщаяСумма + ОбщаяСуммаКупона;
	
	// внутри данной функции есть запрос, но он только для документа поставка, а их в ЕПСе практически нет
	СформироватьПроводкиНачалаСделки(ОбъектДокумента, Сделка, Контрагент, РеквизитыСделки.Дата, РеквизитыСделки.ВалютаСделки, ОбщаяСуммаСделки, ЭтоПоставка, ДвиженияПартий.Скопировать(, "ВалютаНоминала, СтоимостьПокупки, СтоимостьКупона"), Отказ);
	
	Если ЭтоИсполнение ИЛИ ЭтоПоставка Тогда
		СформироватьПроводкиПоГлавеГДляИсполненияИПоставки(ОбъектДокумента, РеквизитыСделки.ВалютаСделки, ОбщаяСумма, ПараметрыДляГлавыГ, ДвиженияПартий, ТаблицаДвиженийПоГлавеГ, Отказ)
	КонецЕсли;
	
	Если ЭтоСделка ИЛИ ЭтоИсполнение Тогда

		ПараметрыОплаты = Новый Структура;
		ПараметрыОплаты.Вставить("Сделка",			Сделка);
		ПараметрыОплаты.Вставить("СуммаТела",		ОбщаяСумма);
		ПараметрыОплаты.Вставить("СуммаКупона",		ОбщаяСуммаКупона);
		ПараметрыОплаты.Вставить("ВалютаСделки",	ОбъектДокумента.ВалютаСделки);
		ПараметрыОплаты.Вставить("СуммаТелаДС",		ПараметрыОплаты.СуммаТела);
		ПараметрыОплаты.Вставить("СуммаКупонаДС",	ПараметрыОплаты.СуммаКупона);
		ПараметрыОплаты.Вставить("ВалютаОплаты",	ОбъектДокумента.ВалютаСделки);
		ПараметрыОплаты.Вставить("Контрагент",		Контрагент);
		ПараметрыОплаты.Вставить("СчетДС",			СчетДС);
		ПараметрыОплаты.Вставить("СубконтоДС",		СубконтоДС);
		ПараметрыОплаты.Вставить("ВидСубконтоДС",	ВидСубконтоДС);
		СформироватьПроводкиОплатыПоСделке(ОбъектДокумента, ПараметрыОплаты, Отказ);
		
		Если ЭтоСделка Тогда
		
			ПараметрыКомиссии = Новый Структура("ВидСделки", РеквизитыСделки.ВидСделки);
			ПараметрыКомиссии.Вставить("ВалютаКомиссии", 		ОбъектДокумента.ВалютаТорговойКомиссии);
			ПараметрыКомиссии.Вставить("ВидКомиссии", 			Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
			ПараметрыКомиссии.Вставить("КонтрагентПоКомиссии", 	КонтрагентПоКомиссии);
			ПараметрыКомиссии.Вставить("ОплатаВДеньПокупки",	Истина);
			ПараметрыКомиссии.Вставить("Сделка",				Сделка);
			Если Не ОбъектДокумента.ОтложеннаяОплатаТорговойКомиссии Тогда
				ПараметрыКомиссии.Вставить("СчетДС", 		СчетДС);
				ПараметрыКомиссии.Вставить("СубконтоДС", 	СубконтоДС);
				ПараметрыКомиссии.Вставить("ВидСубконтоДС",	ВидСубконтоДС);
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;

	БылаКорректировкаПППриПокупке = Ложь;
	
	МассивУчетныхАктивов = Новый Массив;
	МассивЦенныхБумаг = Новый Массив;
	
	Для Каждого СтрокаЦенныеБумаги Из ОбъектДокумента.ЦенныеБумаги Цикл
		
		ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Если МассивЦенныхБумаг.Найти(ЦеннаяБумага) = Неопределено Тогда
			МассивЦенныхБумаг.Добавить(ЦеннаяБумага);
		КонецЕсли;
		
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		
		Если ЭтоСделка Тогда
			ТорговаяКомиссия	= СтрокаЦенныеБумаги.ТорговаяКомиссия;
		КонецЕсли;
		
		Сумма				= СтрокаЦенныеБумаги.Сумма;
		СуммаКупона			= СтрокаЦенныеБумаги.СуммаКупона;
		Количество			= СтрокаЦенныеБумаги.Количество;
		
		СуммаНакладныхРасходов				= 0;
		СуммаНакладныхРасходовВВалютеУчета	= 0;
		Для Каждого СтрокаНакладныхРасходов Из ТаблицаНакладныхРасходов Цикл
			СуммаСписанияРасходов = Окр(СтрокаНакладныхРасходов.Сумма * (Сумма + СуммаКупона) / ОбщаяСуммаСделки,2);
			СтрокаНакладныхРасходов.Сумма = СтрокаНакладныхРасходов.Сумма - СуммаСписанияРасходов;
			ДатаНачисления = СтрокаНакладныхРасходов.Период;
			СуммаНакладныхРасходов = СуммаНакладныхРасходов
										+ РаботаСВалютами.ПересчетСуммыВВалюте(
															СуммаСписанияРасходов,
															СтрокаНакладныхРасходов.Валюта,
															ДатаНачисления,
															ВалютаНоминала,
															ДатаНачисления,
															Отказ);
			СуммаНакладныхРасходовВВалютеУчета = СуммаНакладныхРасходовВВалютеУчета
										+ РаботаСВалютами.ПересчетСуммыВВалюте(
															СуммаСписанияРасходов,
															СтрокаНакладныхРасходов.Валюта,
															ДатаНачисления,
															ВалютаУчета,
															ДатаНачисления,
															Отказ);
		КонецЦикла;
		
		СтрокиВыборки = ДвиженияПартий.НайтиСтроки(Новый Структура("СтрокаКорзиныЦенныхБумаг", СтрокаЦенныеБумаги.СтрокаПартии));
		Для Каждого Выборка из СтрокиВыборки Цикл
			
			УчетныйАктив = Выборка.УчетныйАктивЕПС;
			Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
				МассивУчетныхАктивов.Добавить(УчетныйАктив);
			КонецЕсли;
			
			Если Выборка.Количество = 0 Тогда // движение перекурсовки или переоценки и начисления процентов перед покупкой или продажей
				СформироватьПроводкиПереоценки(ОбъектДокумента, Выборка, УчетныйАктив, ВалютаНоминала, ВалютаУчета, ОстаткиПартий, Отказ);
			Иначе				
				СуммаПартии				= Окр(Сумма				* Выборка.Количество / Количество,2);
				СуммаКупонаПартии		= Окр(СуммаКупона		* Выборка.Количество / Количество,2);
				
				СуммаНакладныхРасходовПартии				= Окр(СуммаНакладныхРасходов				* Выборка.Количество / Количество,2);
				СуммаНакладныхРасходовПартииВВалютеУчета	= Окр(СуммаНакладныхРасходовВВалютеУчета	* Выборка.Количество / Количество,2);
				
				Если ЭтоСделка Тогда
					ТорговаяКомиссияПартии	= Окр(ТорговаяКомиссия	* Выборка.Количество / Количество,2);
					ТорговаяКомиссия	= ТорговаяКомиссия - ТорговаяКомиссияПартии;
					СуммаТорговойКомиссии = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТорговаяКомиссияПартии, ОбъектДокумента.ВалютаТорговойКомиссии, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
					ПараметрыКомиссии.Вставить("ЦБ", 									ЦеннаяБумага);
					ПараметрыКомиссии.Вставить("УчетныйАктив", 							УчетныйАктив);
					ПараметрыКомиссии.Вставить("СуммаКомисии", 							ТорговаяКомиссияПартии);
					ПараметрыКомиссии.Вставить("ВалютаКомиссии", 						ОбъектДокумента.ВалютаТорговойКомиссии);
					ПараметрыКомиссии.Вставить("СуммаОперации", 						СуммаТорговойКомиссии);
					ПараметрыКомиссии.Вставить("ВключатьРасходыПоПокупкеВСтоимость", 	УчетныйАктив.ВключатьРасходыПоПокупкеВСтоимость);
				
					// начисляем комиссию если оплата отложенная или по настройке всегда начислять
					Если ОбъектДокумента.ОтложеннаяОплатаТорговойКомиссии ИЛИ НастройкиУчетаОбщие.ПроводитьКомиссиюПоСделкамЧерезСчетаРасчетов Тогда
						ПараметрыКомиссии.Вставить("СуммаЧерезРасчеты", 		СуммаТорговойКомиссии);
						ПараметрыКомиссии.Вставить("СуммаЧерезРасчетыВал", 		ТорговаяКомиссияПартии);
						ПараметрыКомиссии.Вставить("ПроводитьЧерезРасчеты", 	Истина);
						НачислитьКомиссию(ОбъектДокумента, ПараметрыКомиссии, Отказ);
					КонецЕсли;
					
					// оплачиваем если надо
					Если НЕ ОбъектДокумента.ОтложеннаяОплатаТорговойКомиссии Тогда
						ПараметрыКомиссии.Вставить("ПроводитьЧерезРасчеты", НастройкиУчетаОбщие.ПроводитьКомиссиюПоСделкамЧерезСчетаРасчетов);
						ПараметрыКомиссии.Вставить("Закрывать7ойРазделПриПоступленииДенежныхСредств",	Закрывать7ойРазделПриПоступленииДенежныхСредств);
						ОплатитьКомиссиюНаЦБ(ОбъектДокумента,ПараметрыКомиссии, Отказ);
					КонецЕсли;
				КонецЕсли;
				
				Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
					НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
						НастройкиУчетаОбщие,
						ЦеннаяБумага,
						УчетныйАктив,
						Выборка.Партия,
						Выборка.СтрокаПартии);
					СформироватьПроводкиПокупки(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Выборка, УчетныйАктив, ВалютаНоминала, НастройкиУчетаЦеннойБумаги, Сделка, Контрагент);
					Если Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета <> 0 Тогда
						БылаКорректировкаПППриПокупке = Истина;
					КонецЕсли;
				Иначе
					СформироватьПроводкиПродажи(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Выборка, УчетныйАктив, ВалютаНоминала, ВалютаУчета, 
						Сделка, Контрагент, СуммаПартии, СуммаКупонаПартии, СуммаНакладныхРасходовПартии, СуммаНакладныхРасходовПартииВВалютеУчета, 
						Закрывать7ойРазделПриПоступленииДенежныхСредств, НастройкиУчетаОбщие.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов, АналитикаРезервов, Отказ);
				КонецЕсли;
				
				Сумма				= Сумма - СуммаПартии;
				СуммаКупона			= СуммаКупона - СуммаКупонаПартии;
				Количество			= Количество - Выборка.Количество;
				
				СуммаНакладныхРасходов				= СуммаНакладныхРасходов - СуммаНакладныхРасходовПартии;
				СуммаНакладныхРасходовВВалютеУчета	= СуммаНакладныхРасходовВВалютеУчета - СуммаНакладныхРасходовПартииВВалютеУчета;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЭтоИсполнение ИЛИ ЭтоПоставка Тогда
			УчестьПредварительныеЗатраты(ОбъектДокумента, Сделка, РеквизитыСделки.ВидСделки, УчетныйАктив, ЦеннаяБумага, КонтрагентПоКомиссии, ВалютаУчета, ТаблицаПредварительныхЗатрат, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если РеквизитыСделки.ВидСделки = Перечисления.ВидыСделок.Продажа ИЛИ БылаКорректировкаПППриПокупке Тогда
		
		ОбработатьДвиженияДокументаПоПарнымСчетам(ОбъектДокумента, Отказ);	

		Если Закрывать7ойРазделПриПоступленииДенежныхСредств И НЕ БылаКорректировкаПППриПокупке Тогда
			ОтнесениеНачисленныхДоходовНаАктивыВДУПоЦеннымБумагам(ОбъектДокумента, ОбъектДокумента.ЦенныеБумаги, ОбъектДокумента.Рынок);
		КонецЕсли;
		
		ЗакрытьПарныеСчетаДоходовРасходов(ОбъектДокумента, МассивУчетныхАктивов, Истина, Истина, МассивЦенныхБумаг, Отказ);
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьПроводкиПоГлавеГДляИсполненияИПоставки(ОбъектДокумента, ВалютаСделки, СуммаСделки, ПараметрыДляГлавыГ, ДвиженияПартий, ТаблицаДвиженийПоГлавеГ, Отказ)
	
	Если ПараметрыДляГлавыГ.ПереоценкаБумагПриПродажеНаСчетахГлавыГ Тогда
		
		СуммаСделкиРуб = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаСделки, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата, Отказ), 2);
		
		СтоимостьСС = 0;
		СтоимостьССВВалютеУчета = 0;
		
		Для каждого СтрокаДвиженияПартий Из ДвиженияПартий Цикл
			
			Если СтрокаДвиженияПартий.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			
				СтоимостьСС = СтоимостьСС
								+ СтрокаДвиженияПартий.Стоимость
								+ СтрокаДвиженияПартий.Переоценка
								+ СтрокаДвиженияПартий.ДисконтПремияНачисленный
								+ СтрокаДвиженияПартий.КорректировкаЭСП
								+ СтрокаДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
				СтоимостьССВВалютеУчета = СтоимостьССВВалютеУчета
								+ СтрокаДвиженияПартий.СтоимостьВВалютеУчета
								+ СтрокаДвиженияПартий.ПереоценкаВВалютеУчета
								+ СтрокаДвиженияПартий.ДисконтПремияНачисленныйВВалютеУчета
								+ СтрокаДвиженияПартий.КорректировкаЭСПВВалютеУчета
								+ СтрокаДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
			
			КонецЕсли;
		
		КонецЦикла;
		
		СуммаДооценкиДоСуммыСделки = СуммаСделки - СтоимостьСС;
		СуммаДооценкиДоСуммыСделкиВВалютеУчета = СуммаСделкиРуб - СтоимостьССВВалютеУчета;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицаДвиженийПоГлавеГ Из ТаблицаДвиженийПоГлавеГ Цикл
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СтрокаТаблицаДвиженийПоГлавеГ.Сумма, "Исполнение сделки");
		
		Проводка.СчетКт = СтрокаТаблицаДвиженийПоГлавеГ.СчетДт;
		Проводка.СчетДт = СтрокаТаблицаДвиженийПоГлавеГ.СчетКт;
		
		Если СтрокаТаблицаДвиженийПоГлавеГ.СчетДт = ПараметрыДляГлавыГ.СчетДСГлаваГ ИЛИ СтрокаТаблицаДвиженийПоГлавеГ.СчетДт = ПараметрыДляГлавыГ.СчетЦБГлаваГ Тогда
			
			// дебет
			Проводка.СчетКт = СтрокаТаблицаДвиженийПоГлавеГ.СчетДт;
			Проводка.СубконтоКт.ОснованиеРасчетов = СтрокаТаблицаДвиженийПоГлавеГ.СубконтоДт1;
			Если ЗначениеЗаполнено(СтрокаТаблицаДвиженийПоГлавеГ.СубконтоДт2) Тогда
				Проводка.СубконтоКт.ЦенныеБумаги = СтрокаТаблицаДвиженийПоГлавеГ.СубконтоДт2;
				Проводка.КоличествоКт = СтрокаТаблицаДвиженийПоГлавеГ.КоличествоДт;
			КонецЕсли;
			
			Проводка.ВалютаКт = СтрокаТаблицаДвиженийПоГлавеГ.ВалютаДт;
			Проводка.ВалютнаяСуммаКт = СтрокаТаблицаДвиженийПоГлавеГ.ВалютнаяСуммаДт;
			Проводка.ДополнительнаяАналитикаКт = СтрокаТаблицаДвиженийПоГлавеГ.ДополнительнаяАналитикаДт;
			
		Иначе
			
			// кредит
			Проводка.СчетДт = СтрокаТаблицаДвиженийПоГлавеГ.СчетКт;
			Проводка.СубконтоДт.ОснованиеРасчетов = СтрокаТаблицаДвиженийПоГлавеГ.СубконтоКт1;
			Если ЗначениеЗаполнено(СтрокаТаблицаДвиженийПоГлавеГ.СубконтоКт2) Тогда
				Проводка.СубконтоДт.ЦенныеБумаги = СтрокаТаблицаДвиженийПоГлавеГ.СубконтоКт2;
				Проводка.КоличествоДт = СтрокаТаблицаДвиженийПоГлавеГ.КоличествоКт;
			КонецЕсли;
			
			Проводка.ВалютаДт = СтрокаТаблицаДвиженийПоГлавеГ.ВалютаКт;
			Проводка.ВалютнаяСуммаДт = СтрокаТаблицаДвиженийПоГлавеГ.ВалютнаяСуммаКт;
			Проводка.ДополнительнаяАналитикаДт = СтрокаТаблицаДвиженийПоГлавеГ.ДополнительнаяАналитикаКт;
			
		КонецЕсли;
		
		Если ПараметрыДляГлавыГ.ПереоценкаБумагПриПродажеНаСчетахГлавыГ
			И СтрокаТаблицаДвиженийПоГлавеГ.Сумма <> СуммаСделкиРуб
			И (СтрокаТаблицаДвиженийПоГлавеГ.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги	
				ИЛИ СтрокаТаблицаДвиженийПоГлавеГ.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги) Тогда // это проводка сторнирования переоценки
			
				
			Если Проводка.СчетКт = ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01 Тогда 
			
				ОснованиеРасчетов = Проводка.СубконтоКт.ОснованиеРасчетов;
				ЦеннаяБумага = Проводка.СубконтоКт.ЦенныеБумаги;
				
				Проводка.Сумма = Проводка.Сумма - СуммаДооценкиДоСуммыСделкиВВалютеУчета;
				Проводка.ВалютнаяСуммаКт = Проводка.ВалютнаяСуммаКт - СуммаДооценкиДоСуммыСделки;
				
			Иначе
				
				ОснованиеРасчетов = Проводка.СубконтоДт.ОснованиеРасчетов;
				ЦеннаяБумага = Проводка.СубконтоДт.ЦенныеБумаги;
				
				Проводка.Сумма = Проводка.Сумма + СуммаДооценкиДоСуммыСделкиВВалютеУчета;
				Проводка.ВалютнаяСуммаДт = Проводка.ВалютнаяСуммаДт + СуммаДооценкиДоСуммыСделки;
				
			КонецЕсли;					
				
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, МатематическиеФункции.МодульЧисла(СуммаДооценкиДоСуммыСделкиВВалютеУчета), "Исполнение сделки");
			
			Если СуммаДооценкиДоСуммыСделкиВВалютеУчета > 0 Тогда
			
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
				
				Проводка.СчетКт = ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01;
				Проводка.СубконтоКт.ОснованиеРасчетов = ОснованиеРасчетов;
				Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаКт = ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = СуммаДооценкиДоСуммыСделки;
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
			
			Иначе
			
				Проводка.СчетДт = ПланыСчетов.Единый.ОбязательстваПоПоставкеЦБ01;
				Проводка.СубконтоДт.ОснованиеРасчетов = ОснованиеРасчетов;
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаДт = ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = -СуммаДооценкиДоСуммыСделки;
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
				
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
			
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьПроводкиОплатыПоСделке(ОбъектДокумента, ПараметрыОплаты, Отказ) Экспорт
	
	Сделка 			= ПараметрыОплаты.Сделка;
	СуммаТела 		= ПараметрыОплаты.СуммаТела;
	СуммаКупона 	= ПараметрыОплаты.СуммаКупона;
	ВалютаСделки 	= ПараметрыОплаты.ВалютаСделки;
	ВалютаОплаты 	= ПараметрыОплаты.ВалютаОплаты;
	Контрагент 		= ПараметрыОплаты.Контрагент;
	СчетДС 			= ПараметрыОплаты.СчетДС;
	СубконтоДС 		= ПараметрыОплаты.СубконтоДС;
	ВидСубконтоДС 	= ПараметрыОплаты.ВидСубконтоДС;
	
	СуммаОперацииТело = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаТела, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
	СуммаОперацииКупон = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКупона, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
	
	Если Сделка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииТело, "Оплата покупки");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
		
		Проводка.СубконтоДт.Контрагенты = Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаДт  = ВалютаСделки;
		Проводка.ВалютнаяСуммаДт = СуммаТела;
		
		// кредит
		Проводка.СчетКт = СчетДС;
		
		Проводка.СубконтоКт[ВидСубконтоДС] = СубконтоДС;
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
		
		Проводка.ВалютаКт  = ВалютаОплаты;
		Проводка.ВалютнаяСуммаКт = СуммаТела;
		
		Если СуммаКупона <> 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииКупон, "Оплата покупки (купон)");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
			
			Проводка.СубконтоДт.Контрагенты = Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаДт  = ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = СуммаКупона;
			
			// кредит
			Проводка.СчетКт = СчетДС;
			
			Проводка.СубконтоКт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.Покупка;
			
			Проводка.ВалютаКт  = ВалютаОплаты;
			Проводка.ВалютнаяСуммаКт = СуммаКупона;
			
		КонецЕсли;
		
	Иначе
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииТело, "Оплата продажи");
		
		// дебет
		Проводка.СчетДт = СчетДС;
		
		Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.Продажа;
		
		Проводка.ВалютаДт  = ВалютаОплаты;
		Проводка.ВалютнаяСуммаДт = СуммаТела;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоКт.Контрагенты = Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт  = ВалютаСделки;
		Проводка.ВалютнаяСуммаКт = СуммаТела;
		
		Если СуммаКупона <> 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперацииКупон, "Оплата продажи (купон)");
			
			// дебет
			Проводка.СчетДт = СчетДС;
			
			Проводка.СубконтоДт[ВидСубконтоДС] = СубконтоДС;
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.Продажа;
			
			Проводка.ВалютаДт  = ВалютаОплаты;
			Проводка.ВалютнаяСуммаДт = СуммаКупона;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоКт.Контрагенты = Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт  = ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = СуммаКупона;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПроводкуКурсовойРазницы(ОбъектДокумента, ПараметрыКурсовойРазницы, Отказ) Экспорт
	
	СуммаКурсовойРазницы 	= ПараметрыКурсовойРазницы.СуммаКурсовойРазницы;
	Валюта 					= ПараметрыКурсовойРазницы.Валюта;
	Счет 					= ПараметрыКурсовойРазницы.Счет;
	ВидСчетаУчета			= ПараметрыКурсовойРазницы.ВидСчетаУчета;
	Субконто1				= ПараметрыКурсовойРазницы.Субконто1;
	Субконто2				= ПараметрыКурсовойРазницы.Субконто2;
	Субконто3				= ПараметрыКурсовойРазницы.Субконто3;
	ДополнительнаяАналитика = ПараметрыКурсовойРазницы.ДополнительнаяАналитика;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ?(СуммаКурсовойРазницы<0,-1,1) * СуммаКурсовойРазницы, "Курсовая разница");
	
	УчетКурсовойРазницы = БухгалтерскийУчетЕПС.ПолучитьСчетДоходаРасходаПоКурсовойРазнице(ОбъектДокумента, Счет, Субконто1, Субконто2, Субконто3, ДополнительнаяАналитика, Валюта, СуммаКурсовойРазницы, Отказ);			
	
	ВидСубконто1 = Неопределено;
	ВидСубконто2 = Неопределено;
	ВидСубконто3 = Неопределено;
	
	Для каждого СтрокаВидыСубконто Из Счет.ВидыСубконто Цикл
		Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
			ВидСубконто1 = СтрокаВидыСубконто.ВидСубконто;
		ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
			ВидСубконто2 = СтрокаВидыСубконто.ВидСубконто;
		ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
			ВидСубконто3 = СтрокаВидыСубконто.ВидСубконто;
		КонецЕсли;
	КонецЦикла;
	Если СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Активный
		ИЛИ СуммаКурсовойРазницы > 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
		
			Проводка.СчетДт = Счет;
			Если ЗначениеЗаполнено(Субконто1) Тогда
				Проводка.СубконтоДт[ВидСубконто1] = Субконто1;
			ИначеЕсли ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто1] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто2) Тогда
				Проводка.СубконтоДт[ВидСубконто2] = Субконто2;
			ИначеЕсли ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто2] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто3) Тогда
				Проводка.СубконтоДт[ВидСубконто3] = Субконто3;
			ИначеЕсли ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоДт[ВидСубконто3] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			
			Проводка.ВалютаДт = Валюта;
			Проводка.ДополнительнаяАналитикаДт = ДополнительнаяАналитика;
			
			Проводка.СчетКт = УчетКурсовойРазницы.Счет;
			Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаКурсовойРазницы);
			КонецЕсли;
			Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
				Проводка.СубконтоКт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
			КонецЕсли;
			
	ИначеЕсли СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Активный 
		ИЛИ СуммаКурсовойРазницы < 0 И ВидСчетаУчета = ВидСчета.Пассивный Тогда
		
			Проводка.СчетДт = УчетКурсовойРазницы.Счет;
			Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаКурсовойРазницы);
			КонецЕсли;
			Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
				Проводка.СубконтоДт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
			КонецЕсли;
			
			Проводка.СчетКт = Счет;
			Если ЗначениеЗаполнено(Субконто1) Тогда
				Проводка.СубконтоКт[ВидСубконто1] = Субконто1;
			ИначеЕсли ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто1] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто2) Тогда
				Проводка.СубконтоКт[ВидСубконто2] = Субконто2;
			ИначеЕсли ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто2] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Если ЗначениеЗаполнено(Субконто3) Тогда
				Проводка.СубконтоКт[ВидСубконто3] = Субконто3;
			ИначеЕсли ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
				Проводка.СубконтоКт[ВидСубконто3] = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
			КонецЕсли;
			Проводка.ВалютаКт = Валюта;
			Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитика;
			
	КонецЕсли;
		
	Если ПараметрыКурсовойРазницы.Свойство("Партия") Тогда
	
		Проводка.Партия = ПараметрыКурсовойРазницы.Партия;
		Проводка.СтрокаПартии = ПараметрыКурсовойРазницы.СтрокаПартии;
	
	КонецЕсли;	
		
		
КонецПроцедуры

Процедура ПереоценитьВалютныеАктивы(ОбъектДокумента, Отказ, ИсключитьЗабалансовуюЗадолженностьПоЦБПоРЕПО = Ложь) Экспорт
	
	МетодикаПерекурсовкиВалютныхАктивовИОбязательств = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "МетодикаПерекурсовкиВалютныхАктивовИОбязательств");
	
	Если МетодикаПерекурсовкиВалютныхАктивовИОбязательств = Перечисления.МетодикиПерекурсовкиВалютныхАктивовИОбязательств.ПереоцениватьВНачалеИКонцеДня Тогда
		Возврат;	
	КонецЕсли;
	
	Если ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Записывать Тогда
		ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Записать();
		ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Прочитать();
		ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления);
	
	ТаблицаСчетовИСубконто = Новый ТаблицаЗначений;
	
	СписокТиповСубконто = Новый Массив;
	
	Выборка = ПланыВидовХарактеристик.ВидыСубконто.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивТипов = Выборка.ТипЗначения.Типы();
		Для Каждого ТипИзМассива из МассивТипов Цикл
			Переменная = Новый(ТипИзМассива);
			ИмяТипа = Переменная.Метаданные().ПолноеИмя();
			ИмяТипа = СтрЗаменить(ИмяТипа, ".", "Ссылка.");
			Если СписокТиповСубконто.Найти(ИмяТипа) = Неопределено Тогда
				СписокТиповСубконто.Добавить(Тип(ИмяТипа));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	МассивДопАналитикиПоЦБ = Новый Массив;
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА КАК Счет
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаРезервов
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКупона
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокА
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСчетовУчетаБумаг = РезультатЗапроса.Выгрузить();
	
	ТаблицаСчетовИСубконто.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто1", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто2", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто3", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("ДополнительнаяАналитика", Новый ОписаниеТипов("СправочникСсылка.ДополнительныеАналитикиЛицевыхСчетов"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("СуммаВВалютеУчета", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.ЛицевыеСчета"));
	
	ТаблицаИсключаемыхСчетов = НеПерекурсовыватьСчета();
	ВидыСубконто = Новый Массив;
	
	ДтКт = Новый Массив;
	ДтКт.Добавить("Дт");
	ДтКт.Добавить("Кт");
	
	Для Каждого Проводка из ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет Цикл
		Для Инд = 0 По ДтКт.ВГраница() Цикл
		
			// балансовые счета должны быть заполнены
			ТекДтКт = ДтКт[Инд];
			ТекСчет = Проводка["Счет" + ТекДтКт];
			ТекДопАналитика = Проводка["ДополнительнаяАналитика" + ТекДтКт];
			ТекВалюта = Проводка["Валюта" + ТекДтКт];
			ТекЛицевойСчет = Проводка["ЛицевойСчет" + ТекДтКт];
			//убираем счета учета ЦБ, курсовые по ним - на партиях
			Если НЕ ТекСчет.Валютный Тогда
				Продолжить;
			КонецЕсли;
			Если ТекВалюта = ВалютаУчета Тогда 
				Продолжить;
			КонецЕсли;
			Если ТаблицаСчетовУчетаБумаг.Найти(ТекСчет, "Счет") <> Неопределено Тогда
				Если ЗначениеЗаполнено(ТекДопАналитика) Тогда
					Если МассивДопАналитикиПоЦБ.Найти(ТекДопАналитика) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			СтрокиТаблицыИсключаемыхСчетов = ТаблицаИсключаемыхСчетов.НайтиСтроки(Новый Структура("Счет, ДополнительнаяАналитика", ТекСчет, ?(ЗначениеЗаполнено(ТекДопАналитика), ТекДопАналитика, Неопределено)));
			Если СтрокиТаблицыИсключаемыхСчетов.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекСчет = ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами12 Тогда
				//это аванс				
				Если ТипЗнч(Проводка.Проводка["Субконто" + ТекДтКт].Договоры) = Тип("СправочникСсылка.Договоры") Тогда
					ВидДоговора = Проводка.Проводка["Субконто" + ТекДтКт].Договоры.ВидДоговора;
					Если ВидДоговора = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания
						ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.ОтветственногоХранения
						ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.ВеденияРеестра
						ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания
						ИЛИ ВидДоговора = Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ИсключитьЗабалансовуюЗадолженностьПоЦБПоРЕПО И ТекСчет = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = ТаблицаСчетовИСубконто.Добавить();
			СтрокаТаблицы.Счет = ТекСчет;
			
			СтрокаТаблицы.Субконто1 = Неопределено;
			СтрокаТаблицы.Субконто2 = Неопределено;
			СтрокаТаблицы.Субконто3 = Неопределено;
			
			// проверим заполнение субконто
			Для каждого СтрокаВидыСубконто Из ТекСчет.ВидыСубконто Цикл
				
				Если СтрокаВидыСубконто.ТолькоОбороты 
					Тогда Продолжить; 
				КонецЕсли;
				
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					СтрокаТаблицы.Субконто1 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					СтрокаТаблицы.Субконто2 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					СтрокаТаблицы.Субконто3 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаТаблицы.ДополнительнаяАналитика = ТекДопАналитика;
			СтрокаТаблицы.СуммаВВалютеУчета = ?(ТекДтКт = "Кт", -1, 1) * Проводка.Сумма;
			СтрокаТаблицы.Сумма = ?(ТекДтКт = "Кт", -1, 1) * Проводка["ВалютнаяСумма" + ТекДтКт];
			СтрокаТаблицы.Валюта = ТекВалюта;
			СтрокаТаблицы.ЛицевойСчет = ТекЛицевойСчет;

		КонецЦикла;		
	КонецЦикла;
	
	ТаблицаСчетовИСубконто.Свернуть("Счет,Субконто1,Субконто2,Субконто3,ДополнительнаяАналитика,Валюта,ЛицевойСчет", "СуммаВВалютеУчета,Сумма");
	Если ТаблицаСчетовИСубконто.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДвижений.Счет КАК Счет,
		|	ТаблицаДвижений.Субконто1 КАК Субконто1,
		|	ТаблицаДвижений.Субконто2 КАК Субконто2,
		|	ТаблицаДвижений.Субконто3 КАК Субконто3,
		|	ТаблицаДвижений.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ТаблицаДвижений.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаДвижений.Сумма КАК Сумма,
		|	ТаблицаДвижений.Валюта КАК Валюта,
		|	ТаблицаДвижений.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ ТаблицаДвижений
		|ИЗ
		|	&ТаблицаДвижений КАК ТаблицаДвижений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия КАК Партия,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии КАК СтрокаПартии,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, ЛицевойСчет, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.ЛицевойСчет КАК ЛицевойСчет,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, Субконто2, ЛицевойСчет, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.Субконто2 КАК Субконто2,
		|						ТаблицаДвижений.ЛицевойСчет КАК ЛицевойСчет,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ПослеДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, Субконто2, Субконто3, ЛицевойСчет, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.Субконто2 КАК Субконто2,
		|						ТаблицаДвижений.Субконто3 КАК Субконто3,
		|						ТаблицаДвижений.ЛицевойСчет КАК ЛицевойСчет,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|						И ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|	И ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Вид КАК ВидСчета,
		|	Остатки.Субконто1 КАК Субконто1,
		|	Остатки.Субконто2 КАК Субконто2,
		|	Остатки.Субконто3 КАК Субконто3,
		|	Остатки.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	Остатки.Партия КАК Партия,
		|	Остатки.СтрокаПартии КАК СтрокаПартии,
		|	Остатки.ЛицевойСчет КАК ЛицевойСчет,
		|	Остатки.Валюта КАК Валюта,
		|	Остатки.СуммаОстаток КАК СуммаОстаток,
		|	Остатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ТаблицаДвижений.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаДвижений.Сумма КАК Сумма,
		|	ВЫРАЗИТЬ(Остатки.ВалютнаяСуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2)) КАК СуммаОстатокРасчетная
		|ИЗ
		|	Остатки КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО Остатки.Валюта = КурсыВалют.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДвижений КАК ТаблицаДвижений
		|		ПО Остатки.Счет = ТаблицаДвижений.Счет
		|			И (ЕСТЬNULL(Остатки.Субконто1, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто1, НЕОПРЕДЕЛЕНО))
		|			И (ЕСТЬNULL(Остатки.Субконто2, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто2, НЕОПРЕДЕЛЕНО))
		|			И (ЕСТЬNULL(Остатки.Субконто3, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(ТаблицаДвижений.Субконто3, НЕОПРЕДЕЛЕНО))
		|			И Остатки.ЛицевойСчет = ТаблицаДвижений.ЛицевойСчет
		|			И Остатки.Валюта = ТаблицаДвижений.Валюта
		|ГДЕ
		|	КурсыВалют.Период = &Период
		|	И (ВЫРАЗИТЬ(Остатки.ВалютнаяСуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК ЧИСЛО(19, 2))) <> Остатки.СуммаОстаток";
	
	
	Запрос.Параметры.Вставить("Организация", ОбъектДокумента.Организация);
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	Запрос.Параметры.Вставить("ПослеДокумента", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.Параметры.Вставить("Период", НачалоДня(ОбъектДокумента.Дата));
	Запрос.Параметры.Вставить("ТаблицаДвижений", ТаблицаСчетовИСубконто);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВидСубконтоЦеннаяБумага = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;
	
	//в результирующей таблице должно быть:
	//Дебетовые остатки остатки по активным счетам > 0, кредитовые остатки не обрабатываем. Кредитовый оборот по активному счету <0, 
	//Кредитовые остатки по пассивынм счетам >0, дебетовые остатки не обрабатываем
	//Процедура списывает курсовые разницы по счетам с остаткамив случае расхода (кредитовый оборот по активному счету и дебетовый - по пассивному).
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаКурсовойРазницы = ВыборкаДетальныеЗаписи.СуммаОстатокРасчетная - ВыборкаДетальныеЗаписи.СуммаОстаток;
		
		Если (ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Активный) 
			ИЛИ (ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.АктивноПассивный И ВыборкаДетальныеЗаписи.СуммаОстаток>0) ТОгда
			ВидСчетаУчета = ВидСчета.Активный;
		Иначе
			ВидСчетаУчета = ВидСчета.Пассивный;
		КонецЕсли;
		
		Если СуммаКурсовойРазницы <> 0 ТОгда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ?(СуммаКурсовойРазницы<0,-1,1) * СуммаКурсовойРазницы, "Курсовая разница");
			
			ВалютаКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Валюта;
			СчетКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Счет;
			Субконто1				= ВыборкаДетальныеЗаписи.Субконто1;
			Субконто2				= ВыборкаДетальныеЗаписи.Субконто2;
			Субконто3				= ВыборкаДетальныеЗаписи.Субконто3;
			
			УчетКурсовойРазницы = ПолучитьСчетДоходаРасходаПоКурсовойРазнице(ОбъектДокумента, СчетКурсовойРазницы, Субконто1, Субконто2, Субконто3, ВыборкаДетальныеЗаписи.ДополнительнаяАналитика, ВалютаКурсовойРазницы, СуммаКурсовойРазницы, Отказ);			
			
			ВидСубконто1 = Неопределено;
			ВидСубконто2 = Неопределено;
			ВидСубконто3 = Неопределено;
			
			Для каждого СтрокаВидыСубконто Из СчетКурсовойРазницы.ВидыСубконто Цикл
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					ВидСубконто1 = СтрокаВидыСубконто.ВидСубконто;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					ВидСубконто2 = СтрокаВидыСубконто.ВидСубконто;
					Если ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств Тогда
						Субконто2 = Справочники.ВидыДвиженияДенежныхСредств.КурсоваяРазница;
					КонецЕсли;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					ВидСубконто3 = СтрокаВидыСубконто.ВидСубконто;
				КонецЕсли;
			КонецЦикла;
			
			Если СуммаКурсовойРазницы > 0 Тогда
				//Если ВидСчетаУчета = ВидСчета.Активный Тогда
					Проводка.СчетДт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоДт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоДт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоДт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаДт = ВалютаКурсовойРазницы;
					Проводка.ДополнительнаяАналитикаДт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитика;
					
					Проводка.СчетКт = УчетКурсовойРазницы.Счет;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
						Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаКурсовойРазницы);
					КонецЕсли;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
						Проводка.СубконтоКт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
					КонецЕсли;
				//Иначе
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано списание курсовых разниц для пассивных счетов", ОбъектДокумента.Ссылка,,,Отказ);
				//КонецЕсли;
			Иначе
				//Если ВидСчетаУчета = ВидСчета.Активный Тогда
					Проводка.СчетДт = УчетКурсовойРазницы.Счет;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
						Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаКурсовойРазницы);
					КонецЕсли;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
						Проводка.СубконтоДт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
					КонецЕсли;
					
					Проводка.СчетКт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоКт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоКт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоКт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаКт = ВалютаКурсовойРазницы;
					Проводка.ДополнительнаяАналитикаКт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитика;
				//Иначе
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано списание курсовых разниц для пассивных счетов", ОбъектДокумента.Ссылка,,,Отказ);
				//КонецЕсли;
			КонецЕсли;
			
			Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
			
				Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
				Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
			
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДвижениеПерекурсовки(ОбъектДокумента, Параметры, Отказ) Экспорт 
	
	ЦеннаяБумага = Параметры.ЦеннаяБумага;
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Акции") Тогда
		//по акциям пересчет по курсу не производится (ПБУ 3 п.7)
		Возврат;
	КонецЕсли;
	
	ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
	УчетныйАктивЕПС = Параметры.УчетныйАктивЕПС;
	
	СтоимостьВВалютеУчета = Параметры.СтоимостьВВалютеУчета;
	СтоимостьКупонаВВалютеУчета = Параметры.СтоимостьКупонаВВалютеУчета;
	ПереоценкаВВалютеУчета = Параметры.ПереоценкаВВалютеУчета;
	ПереоценкаКупонаВВалютеУчета = Параметры.ПереоценкаКупонаВВалютеУчета;
	ДисконтНачисленныйВВалютеУчета 	= ?(Параметры.Свойство("ДисконтНачисленныйВВалютеУчета"), Параметры.ДисконтНачисленныйВВалютеУчета, 0);
	ПремияНачисленнаяВВалютеУчета 	= ?(Параметры.Свойство("ПремияНачисленнаяВВалютеУчета"), Параметры.ПремияНачисленнаяВВалютеУчета, 0);;
	КорректировкаЭСПВВалютеУчета = Параметры.КорректировкаЭСПВВалютеУчета;
	РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета = Параметры.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета;
	
	ПереоценкаПоФиксированномуКурсу	= ?(Параметры.Свойство("ПереоценкаПоФиксированномуКурсу"), Параметры.ПереоценкаПоФиксированномуКурсу, Ложь);
	
	ОтражатьПартииНаЛицевыхСчетах = Параметры.Свойство("ОтражатьПартииНаЛицевыхСчетах");
	
	//остатки
	Если ДисконтНачисленныйВВалютеУчета <> 0 ИЛИ ПремияНачисленнаяВВалютеУчета <> 0 Тогда
		ДисконтПремияНачисленныйВВалютеУчета = 0;
	Иначе
		ДисконтПремияНачисленныйВВалютеУчета = Параметры.ДисконтПремияНачисленныйВВалютеУчета;
	КонецЕсли;
	
