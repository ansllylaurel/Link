Функция ПолучитьВыборкуДляЗакрытияРасходов(ПараметрыЗапроса)

	ОбъектДокумента  = ПараметрыЗапроса.ОбъектДокумента;
	ВидЗадолженности = ПараметрыЗапроса.ВидЗадолженности;
