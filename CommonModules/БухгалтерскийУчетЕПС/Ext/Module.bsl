			|	_ТаблицаДоговоров.Валюта,
			|	_ТаблицаДоговоров.ГруппаФинансовогоУчетаДоходовРасходов";
			
			Запрос.УстановитьПараметр("СчетУчетаРасчетов", ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами11);
						
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Если ОбъектДокумента.Дата > Дата(2020,5,1) Тогда // для оплаты нужно получить дату основания
		Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
			Запрос.УстановитьПараметр("ДопАналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего);
		ИначеЕсли ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда 
			Запрос.УстановитьПараметр("ДопАналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего);
		КонецЕсли;	
	Иначе 
		Запрос.УстановитьПараметр("ДопАналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ТаблицаДоговоров", ТаблицаДоговоров);
	Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("МассивСубконто", МассивСубконто);
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Валюта", ВалютаОперации);
	Запрос.УстановитьПараметр("НачалоГода", ОпределитьДатуНачалаБухгалтерскогоПериода(ОбъектДокумента.Дата, ОбъектДокумента.Организация, ОбъектДокумента.СчетДоверительногоУправления));
	
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ОпределитьДатуПокупкиПартии(Партия, СтрокаПартии, БратьДатуИзВводов = Ложь, МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ = Неопределено) Экспорт

	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(Партия.СчетДоверительногоУправления);
	
	Если МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ = Неопределено Тогда
		МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(УчетныйСчетДоверительногоУправления);
	КонецЕсли;
	
	Если Партия.Дата < МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ Тогда
		
		Если БратьДатуИзВводов И ТипЗнч(Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			
			СтрокаТаблицыПартий = Партия.ЦенныеБумаги.Найти(СтрокаПартии, "СтрокаПартии");
			Если СтрокаТаблицыПартий = Неопределено Тогда
				Возврат Неопределено;
			Иначе
				Возврат СтрокаТаблицыПартий.ДатаПокупки;
			КонецЕсли;
			
		Иначе
			Возврат Партия.Дата;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Партия) <> Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		
		Возврат Партия.Дата;
		
	Иначе
		
		СтрокаТаблицыПартий = Партия.ЦенныеБумаги.Найти(СтрокаПартии, "СтрокаПартии");
		Если СтрокаТаблицыПартий = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Возврат СтрокаТаблицыПартий.ДатаПокупки;
		КонецЕсли;	
		
	КонецЕсли;

КонецФункции

Функция ПолучитьРаспределениеУчетныхАктивовЕПСПоДивидендам(Основание, ТаблицаРаспределенияАктивовЕПС) Экспорт
	
	УчетныйСчетДоверительногоУправления			 = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(Основание.СчетДоверительногоУправления);
	МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(УчетныйСчетДоверительногоУправления);
	
	Если ТаблицаРаспределенияАктивовЕПС = Неопределено Тогда
		ТаблицаРаспределенияАктивовЕПС = Новый ТаблицаЗначений;
		ТаблицаРаспределенияАктивовЕПС.Колонки.Добавить("Основание");
		ТаблицаРаспределенияАктивовЕПС.Колонки.Добавить("УчетныйАктивЕПС");
		ТаблицаРаспределенияАктивовЕПС.Колонки.Добавить("Количество");
	КонецЕсли;
		
	ДатаРеестраДляПроверки = Основание.ДатаРеестра;
	Если НЕ БухгалтерскийУчет.ВедетсяУчетЕПС(Основание.ДатаРеестра, Основание.Организация, УчетныйСчетДоверительногоУправления) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиУчетаОбщиеСрезПоследних.Период
			|ИЗ
			|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|			&ДатаДокумента,
			|			ВестиЕдиныйБухгалтерскийУчет
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
		Запрос.УстановитьПараметр("ДатаДокумента", Основание.Дата);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДатаРеестраДляПроверки = ВыборкаДетальныеЗаписи.Период;
		КонецЦикла;
	
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии,
		|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ) КАК Дата
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаРеестра,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии,
		|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаДокумента,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И ВидУчета = &ВидУчета
		|				И (ВЫРАЗИТЬ(Партия КАК Документ.ВводЦенныхБумаг).Дата МЕЖДУ &ДатаРеестра И &ДатаДокумента)) КАК БухПартииЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("ДатаРеестра", НачалоДня(ДатаРеестраДляПроверки) + 86400);  //на утро
	Запрос.УстановитьПараметр("ДатаДокумента", Основание.Дата);  //получим вводы
	Запрос.УстановитьПараметр("Рынок", Основание.Рынок);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", Основание.ЦеннаяБумага);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаПартий = РезультатЗапроса.Выгрузить();
	
	КоличествоОстаток = 0;
	КоличествоСтрокПартий = ТаблицаПартий.Количество();
	Для сц = -КоличествоСтрокПартий По -1 Цикл
		ТекущаяСтрокаПартий = ТаблицаПартий.Получить(-сц-1);
		ДатаПокупкиПартии = ТекущаяСтрокаПартий.Дата;
		Если ТипЗнч(ТекущаяСтрокаПартий.Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			ДатаПокупкиПартии = НачалоДня(БухгалтерскийУчетЕПС.ОпределитьДатуПокупкиПартии(ТекущаяСтрокаПартий.Партия, ТекущаяСтрокаПартий.СтрокаПартии, Истина, МоментНачалаНеобходимостиДанныхЕПСВоВводахЦБ));
		КонецЕсли;
		Если ДатаПокупкиПартии <= Основание.ДатаРеестра Тогда
			КоличествоОстаток = КоличествоОстаток + ТекущаяСтрокаПартий.КоличествоОстаток;
		Иначе 
			ТаблицаПартий.Удалить(ТекущаяСтрокаПартий);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПартий.Свернуть("УчетныйАктивЕПС","КоличествоОстаток");
	
	Для Каждого СтрокаТаблицыПартий Из ТаблицаПартий Цикл
		СтрокаТаблицыРаспределениеАктивовЕПС = ТаблицаРаспределенияАктивовЕПС.Добавить();
		СтрокаТаблицыРаспределениеАктивовЕПС.Основание = Основание;
		СтрокаТаблицыРаспределениеАктивовЕПС.УчетныйАктивЕПС = СтрокаТаблицыПартий.УчетныйАктивЕПС;
		СтрокаТаблицыРаспределениеАктивовЕПС.Количество = СтрокаТаблицыПартий.КоличествоОстаток;
		
	КонецЦикла;
		
КонецФункции

