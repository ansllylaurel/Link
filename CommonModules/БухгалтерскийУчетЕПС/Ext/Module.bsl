		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДвиженияПартий") <> Неопределено Тогда 
			
			ТекущиеВременныеТаблицы = Новый Массив;
