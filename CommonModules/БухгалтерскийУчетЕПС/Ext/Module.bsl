		КонецЕсли;	
		
		Если РезультатПроверкиСтавкиЭСП	= "ЭСП не рыночная" Тогда
		
			//В иных случаях ЭСП признается соответсвующей рыночным условиям в случае, если ее значение не выходит за диапазон рыночных ставок.
			
			КритерийРыночностиЭСП = КритерийРыночностиЭСП + Символы.ПС + "В иных случаях ЭСП признается соответсвующей рыночным условиям в случае, если ее значение не выходит за диапазон рыночных ставок.";
			
			БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(Облигация, ДатаПереоценки, ДенежныеПотоки, ОшибкаРасчета, РасшифровкаРасчета);
			Если ОшибкаРасчета Тогда
				Возврат Неопределено;
			КонецЕсли;		
			
			ПараметрыРасчетаРейтинга			= РаботаСПереоценкой.ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
			ПараметрыРасчетаРейтинга.Вставить("ИсключатьДляРублевыхОблигацийРейтингВИностраннойВалюте", Ложь);
			
			ПараметрыРасчетаКредитногоСпреда	= РаботаСПереоценкой.ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
			ПараметрыРасчетаКредитногоСпреда.Вставить("РассчитыватьКредитныйСпредДляГосударственныхОблигаций", Истина);
			
			//МассивРейтинговыхГрупп = Новый Массив;
			//МассивРейтинговыхГрупп.Добавить(1);
			//МассивРейтинговыхГрупп.Добавить(2);
			//МассивРейтинговыхГрупп.Добавить(3);
			//МассивРейтинговыхГрупп.Добавить(4);
			//
			//ПараметрыРасчетаРейтинга.Вставить("РейтинговаяГруппа", МассивРейтинговыхГрупп);
			
			КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(Облигация, ДатаПереоценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ОшибкаРасчета, РасшифровкаРасчета);				
			
			Если ОшибкаРасчета ИЛИ ТипЗнч(КредитныйСпред) <> Тип("ТаблицаЗначений") ИЛИ КредитныйСпред.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;		
			
			МедианаКредитногоСпреда		= КредитныйСпред[0].Медиана;
			МинимумКредитногоСпреда		= КредитныйСпред[0].МинимумКредитногоСпреда;
			МаксимумКредитногоСпреда	= КредитныйСпред[0].МаксимумКредитногоСпреда;
			
			Если МинимумКредитногоСпреда = Неопределено ИЛИ МаксимумКредитногоСпреда = Неопределено Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + Строка(СчетДоверительногоУправления) + " не описано получение диапазона кредитного спреда",,,, Отказ);
				Возврат Неопределено;
				
			КонецЕсли;
			
			РасшифровкаРасчета.Вставить("МинимумКредитногоСпреда",		МинимумКредитногоСпреда);
			РасшифровкаРасчета.Вставить("МаксимумКредитногоСпреда",		МаксимумКредитногоСпреда);
			РасшифровкаРасчета.Вставить("МедианаКредитногоСпреда",		МедианаКредитногоСпреда);
			
			НижняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности + МинимумКредитногоСпреда / 100;
			ВерхняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности + МаксимумКредитногоСпреда / 100;
			
			Если ЭСП >= НижняяГраницаКоридораЭСП И ЭСП <= ВерхняяГраницаКоридораЭСП Тогда
				РезультатПроверкиСтавкиЭСП = "ЭСП рыночная";
				ПринимаемаяЭСП = ЭСП;
			Иначе
				РезультатПроверкиСтавкиЭСП = "ЭСП нерыночная";
				ПринимаемаяЭСП = ?(ЭСП < НижняяГраницаКоридораЭСП, НижняяГраницаКоридораЭСП, ВерхняяГраницаКоридораЭСП);
			КонецЕсли;
			
		КонецЕсли;
		
		РасшифровкаРасчета.Вставить("КритерийРыночностиЭСП",				КритерийРыночностиЭСП);
		РасшифровкаРасчета.Вставить("МестоСовершенияСделки",				МестоХранения);
		РасшифровкаРасчета.Вставить("ПокупнаяСтоимость",					ПокупнаяСтоимость);
		РасшифровкаРасчета.Вставить("СправедливаяСтоимость",				СправедливаяСтоимость);
		РасшифровкаРасчета.Вставить("РасчетнаяЭСП",							РасчетнаяЭСП);
		РасшифровкаРасчета.Вставить("МинимумДиапазонаСС",					МинимумДиапазонаСС);
		РасшифровкаРасчета.Вставить("МаксимумДиапазонаСС",					МаксимумДиапазонаСС);
		РасшифровкаРасчета.Вставить("РезультатПроверкиПокупнойСтоимости",	РезультатПроверкиПокупнойСтоимости);
		
	Иначе
		
		БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(Облигация, ДатаПереоценки, ДенежныеПотоки, ОшибкаРасчета, РасшифровкаРасчета);
		Если ОшибкаРасчета Тогда
			Возврат Неопределено;
		КонецЕсли;		
		
		ПараметрыРасчетаРейтинга			= РаботаСПереоценкой.ПолучитьПараметрыРасчетаРейтинга(ПараметрыОценки, ДатаПереоценки, Отказ);
		ПараметрыРасчетаКредитногоСпреда	= РаботаСПереоценкой.ПолучитьПараметрыРасчетаКредитногоСпреда(ПараметрыОценки, ДатаПереоценки, Отказ);
		
		ПараметрыРасчетаКредитногоСпреда.Вставить("РассчитыватьКредитныйСпредДляГосударственныхОблигаций", Истина);
		
		КредитныйСпред = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьКредитныйСпред(Облигация, ДатаПереоценки, ПараметрыРасчетаРейтинга, ПараметрыРасчетаКредитногоСпреда, ОшибкаРасчета, РасшифровкаРасчета);				
			
		Если ОшибкаРасчета ИЛИ ТипЗнч(КредитныйСпред) <> Тип("ТаблицаЗначений") ИЛИ КредитныйСпред.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;		
		
		Если ПараметрыРасчетаКредитногоСпреда.ВариантРасчетаКредитногоСпреда = "ПоИндексамСовокупногоДоходаГосударственныхИКорпоративныхОблигаций"
			И Облигация.Категория <> Перечисления.КатегорииОблигаций.Государственная
			И КредитныйСпред[0].НомерГруппы = 4
			И (КредитныйСпред[0].МинимумКредитногоСпреда = Неопределено ИЛИ КредитныйСпред[0].МаксимумКредитногоСпреда = Неопределено) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для IV рейтинговой группы не предусмотрен расчет спреда",,,, Отказ);
			Возврат Неопределено;
		
		КонецЕсли;
		
		МедианаКредитногоСпреда		= КредитныйСпред[0].Медиана;
		МинимумКредитногоСпреда		= КредитныйСпред[0].МинимумКредитногоСпреда;
		МаксимумКредитногоСпреда	= КредитныйСпред[0].МаксимумКредитногоСпреда;
		
		Если МинимумКредитногоСпреда = Неопределено ИЛИ МаксимумКредитногоСпреда = Неопределено Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента не описано получение диапазона кредитного спреда",,,, Отказ);
			Возврат Неопределено;
		
		КонецЕсли;
		
		РасшифровкаРасчета.Вставить("МинимумКредитногоСпреда",		МинимумКредитногоСпреда);
		РасшифровкаРасчета.Вставить("МаксимумКредитногоСпреда",		МаксимумКредитногоСпреда);
		РасшифровкаРасчета.Вставить("МедианаКредитногоСпреда",		МедианаКредитногоСпреда);
		
		НижняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности + МинимумКредитногоСпреда / 100;
		ВерхняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности + МаксимумКредитногоСпреда / 100;
		
		Если ЭСП >= НижняяГраницаКоридораЭСП И ЭСП <= ВерхняяГраницаКоридораЭСП Тогда
			РезультатПроверкиСтавкиЭСП = "ЭСП рыночная";
			ПринимаемаяЭСП = ЭСП;
		Иначе
			РезультатПроверкиСтавкиЭСП = "ЭСП нерыночная";
			ПринимаемаяЭСП = ?(ЭСП < НижняяГраницаКоридораЭСП, НижняяГраницаКоридораЭСП, ВерхняяГраницаКоридораЭСП);
		КонецЕсли;
		
	КонецЕсли;
	
	РасшифровкаРасчета.Вставить("БезрисковаяСтавкаДоходности",	БезрисковаяСтавкаДоходности);
	РасшифровкаРасчета.Вставить("НижняяГраницаКоридораЭСП",		НижняяГраницаКоридораЭСП);
	РасшифровкаРасчета.Вставить("ВерхняяГраницаКоридораЭСП",	ВерхняяГраницаКоридораЭСП);
	РасшифровкаРасчета.Вставить("РасчетнаяЭСП",					ЭСП);
	РасшифровкаРасчета.Вставить("РезультатПроверкиСтавкиЭСП",	РезультатПроверкиСтавкиЭСП);
	РасшифровкаРасчета.Вставить("СтавкаПрименяемаяДляРасчета",	ПринимаемаяЭСП);
	
	ИтогиПроверки = Новый ТаблицаЗначений;
	ИтогиПроверки.Колонки.Добавить("Параметр");
	ИтогиПроверки.Колонки.Добавить("Значение");
	
	Для Каждого Параметр Из РасшифровкаРасчета Цикл
		
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") ИЛИ ТипЗнч(Параметр.Значение) = Тип("Структура") ИЛИ ТипЗнч(Параметр.Значение) = Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Итог = ИтогиПроверки.Добавить();
		Итог.Параметр = Параметр.Ключ;
		Итог.Значение = Параметр.Значение;
		
	КонецЦикла;
	
	РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ИтогиПроверки", ИтогиПроверки, "Итоги проверки");
	
	Если Расшифровка <> Неопределено Тогда
	
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("ПроверкаЭСП",,, Расшифровка);
		ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
		
		РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
		
		Область = Расшифровка.НайтиТекст("ЭСП нерыночная");
		Если Область <> Неопределено Тогда
			Область.ЦветТекста = WebЦвета.Красный;
		КонецЕсли;
		
		Область = Расшифровка.НайтиТекст("СтавкаПрименяемаяДляРасчета");
		Расшифровка.Область(Область.Верх, Область.Лево + 1, Область.Низ, Область.Право + 1).ЦветТекста = WebЦвета.Синий;
		
		Область = Расшифровка.НайтиТекст("КритерийРыночностиЭСП");
		Если Область <> Неопределено Тогда
			Расшифровка.Область(Область.Верх, Область.Лево + 1, Область.Низ, Область.Право + 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		КонецЕсли;	
	
	КонецЕсли;
	
	ПараметрыПроверки.Вставить("СтавкаПрименяемаяДляРасчета",	ПринимаемаяЭСП);
	
	Возврат (ПринимаемаяЭСП = ЭСП);

КонецФункции 

Функция ПолучитьОфертыИАмортизации(Облигация, ДатаПокупки, ДатаПереоценки, ВключатьАмортизации = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.ДатаОбъявления КАК Дата,
		|	""Оферта"" КАК ТипДействия,
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа
		|ПОМЕСТИТЬ _ВсеДаты
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.Облигация = &ЦеннаяБумага
		|	И УсловияОферт.ДатаОбъявления > &НачальнаяДата
		|	И УсловияОферт.ДатаОбъявления <= &КонечнаяДата
		|	И НЕ УсловияОферт.ТолькоДляФизическихЛиц
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НоминалыЦенныхБумаг.Период,
		|	""Амортизация"",
		|	НоминалыЦенныхБумаг.Период
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|ГДЕ
		|	&ВключатьАмортизации
		|	И НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И НоминалыЦенныхБумаг.Период > &НачальнаяДата
		|	И НоминалыЦенныхБумаг.Период <= &КонечнаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ВсеДаты.Дата КАК Дата,
		|	_ВсеДаты.ТипДействия КАК ТипДействия,
		|	_ВсеДаты.ДатаВыкупа КАК ДатаВыкупа
		|ИЗ
		|	_ВсеДаты КАК _ВсеДаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	Запрос.УстановитьПараметр("НачальнаяДата", КонецДня(ДатаПокупки));
	Запрос.УстановитьПараметр("КонечнаяДата", НачалоДня(ДатаПереоценки));
	Запрос.УстановитьПараметр("ВключатьАмортизации", ВключатьАмортизации);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РассчитатьЕжедневноеПриращениеПоПотокуСафмар(ТаблицаПотока, МинЗнач, МаксЗнач, ДисконтПремия) Экспорт
	
	//Расчет дисконта и премии по амортизационным облигациям у Сафмара (задача 387776)

	//Основы:
	//	амортизационная облигация - когда номинал гасится частями
	//	дисконт - когда купили ниже номинала и он НАЧИСЛЯЕТСЯ с 0 до Номинал - ЦенаПокупки
	//	премия - когда купили выше номинала и она СПИСЫВАЕТСЯ с ЦенаПокупки - Номинал до 0
	//	погашение – ниже в тексте понимается как финальное погашение	

	//Ежедневная процентная ставка:
	//	Сафмар вводит некое "ежедневное приращение" (она же "ежедневная процентная ставка")
	//	Это очень небольшая величина (значащие разряды далеко после запятой)
	//	Она определяется из формулы:
	//		  n      t_i * N_i * d
	//		Сумма ------------------ = D
	//		 i=1      1 + t_i * d
	//	Как видно, тут идет суммирование всех амортизаций (которые относятся к периоду между покупкой и погашением, разумеется)
	//		t – Количество дней от покупки до этой амортизации
	//		N – Сумма амортизации
	//		d – Наше «ежедневное приращение»
	//		D – дисконт/премия при покупке
	//		
	//Разберем на примере:
	//	1го купили облигацию с дисконтом 21,2
	//	Номинал при покупке 200
	//	Есть 2 амортизации: 2го и 3го по 100 (1 день от покупки до первой и 2 дня до второй)
	//	Формула получается:
	//		1*100*d   2*100*d
	//		------- + ------- = 21,2
	//		 1+1*d     1+2*d
	//	И d получился около 0,08
	//	Рассчитывается d числено
	//	Сафмар считал итерационно (капец!) я сделал расчет дихотомией (лень было хорды делать)
	//	
	//Расчет текущего дисконта/премии:
	//	Зная d, расчет текущего дисконта/премии идет по формуле:
	//		n      N_i * k_i * d
	//		Сумма ------------------
	//		i=1      1 + t_i * d
	//	k –количество дней от переоценки до амортизации (t – от покупки до амортизации)

	//	Важный момент: 
	//		когда мы считали d, мы брали амортизации от покупки до погашения, 
	//	а когда считаем текущий дисконт/премию берем уже от переоценки до погашения т.к. часть амортизаций уже прошли и не учитываются

	//Действия при амортизации:
	//	Когда идет амортизация бумаги, купленной с премией, 
	//		сумма оставшейся премии не меняется – вся сумма амортизации списывается с тела бумаги 
	//		т.к. на теле полная номинальная стоимость
	//	А когда идет амортизация бумаги, купленной с дисконтом, то списание идет и с тела, и с дисконта. 
	//	С дисконта списывается сумма: 
	//		N_i / (1 + t_i * d)
	//	В формуле идет речь о i-той амортизации
	//	
	
	ПриращениеМин = МинЗнач;
	ПриращениеМакс = МаксЗнач;
	Точность = 0.000000000000000000001;
	
	ТаблицаПотока.Колонки.Добавить("НпвМин", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("НпвМакс", Новый ОписаниеТипов("Число"));
	ТаблицаПотока.Колонки.Добавить("НпвСред", Новый ОписаниеТипов("Число"));
	
	Для Итерация = 1 По 100 Цикл
	
		ПриращениеСред = ПриращениеМин + (ПриращениеМакс - ПриращениеМин) / 2;
		
		Для каждого СтрокаПотока Из ТаблицаПотока Цикл
			
			ДнейНаПриращениеМин = СтрокаПотока.Период * ПриращениеМин;
			ДнейНаПриращениеМакс = СтрокаПотока.Период * ПриращениеМакс;
			ДнейНаПриращениеСред = СтрокаПотока.Период * ПриращениеСред;
			
			СтрокаПотока.НпвМин = СтрокаПотока.Поток * ДнейНаПриращениеМин / (1 + ДнейНаПриращениеМин);
			СтрокаПотока.НпвМакс = СтрокаПотока.Поток * ДнейНаПриращениеМакс / (1 + ДнейНаПриращениеМакс);
			СтрокаПотока.НпвСред = СтрокаПотока.Поток * ДнейНаПриращениеСред / (1 + ДнейНаПриращениеСред);
		
		КонецЦикла; 
		
		НпвМин = ТаблицаПотока.Итог("НпвМин") - ДисконтПремия;
		НпвМакс = ТаблицаПотока.Итог("НпвМакс") - ДисконтПремия;
		НпвСред = ТаблицаПотока.Итог("НпвСред") - ДисконтПремия;

		Если МатематическиеФункции.МодульЧисла(НпвСред) < Точность Тогда
			Прервать;
		КонецЕсли; 
		
		Если МатематическиеФункции.ЗнакЧисла(НпвМин) = МатематическиеФункции.ЗнакЧисла(НпвСред) Тогда
			ПриращениеМин = ПриращениеСред;	
		ИначеЕсли МатематическиеФункции.ЗнакЧисла(НпвМакс) = МатематическиеФункции.ЗнакЧисла(НпвСред) Тогда
			ПриращениеМакс = ПриращениеСред;	
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ПриращениеСред;
	
КонецФункции

Функция ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Доход = Истина) Экспорт
	
	// В справочнике учетных активов явно не заданы счета учета доходов/расходов от ПЕРЕОЦЕНКИ
	// Это было связано с тем, что они до последнего случая совпадали со счетами учета доходов/расходов от ОПЕРАЦИЙ (от продажи, например)
	// И на это заложились в разных местах - это все меняю
	
	// Правильно определять счет через аналитику ГФУ, которая всегда заполнена и в которой указан НомерСчетаБухгалтерскогоУчета
	Аналитика = ?(Доход, УчетныйАктив.АналитикаДоходовОтПереоценки, УчетныйАктив.АналитикаРасходовОтПереоценки);
	СчетУчета = ПланыСчетов.Единый.НайтиПоКоду(Аналитика.НомерСчетаБухгалтерскогоУчета);
	
	// Это сделал для страховки - есть сложности с ГФУ у паев и векселей
	Если СчетУчета = Неопределено Тогда
		СчетУчета = ?(Доход, УчетныйАктив.СчетУчетаДоходовОтОпераций, УчетныйАктив.СчетУчетаРасходовОтОпераций);
	КонецЕсли;
	
	Возврат СчетУчета;
	
КонецФункции

Функция ПолучитьЭСПИДенежныйПотокДляОблигации(Облигация, ДанныеПереоценки, ДанныеПокупки) Экспорт

	РассчитыватьЭСПДо = БухгалтерскийУчет.ОпределитьНастройкуУчета(ДанныеПереоценки.Дата, ДанныеПереоценки.Организация, ДанныеПереоценки.СчетДоверительногоУправления, "РассчитыватьЭСПДо");
	
	ДоПогашения = (РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения);
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения", ДоПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",			 НачалоДня(ДанныеПереоценки.Дата));
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",	 НачалоДня(ДанныеПереоценки.Дата));
	
	ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ДанныеПереоценки);
	
	ДоходностьДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
							Облигация,
							ДоПогашения,
							ДанныеПокупки.ДатаПокупки,
							ДанныеПокупки.ЦенаПокупки,
							ДанныеПереоценки.СчетДоверительногоУправления,
							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
							
	ЭСП = 0;
	Если ТипЗнч(ДоходностьДюрация) = Тип("Структура") Тогда
		ЭСП = ДоходностьДюрация.Доходность;
	КонецЕсли; 

	Возврат Новый Структура("ЭСП, Поток", ЭСП, РаботаСКоллекциями.ТаблицаЗначений_В_МассивСтруктур(ДенежныйПоток, "Дата, Поток"));
	
КонецФункции

Функция ОпределитьСуммуРасходовПопадающуюВСтоимостьБумаги(Документ) Экспорт

	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		Сделка = Документ.Основание;	
	Иначе
		Сделка = Документ;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенияАктивовЕПС.Сделка КАК Сделка
		|ИЗ
		|	РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|ГДЕ
		|	РаспределенияАктивовЕПС.Организация = &Организация
		|	И РаспределенияАктивовЕПС.Сделка = &Сделка
		|	И РаспределенияАктивовЕПС.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость";
	
	Запрос.УстановитьПараметр("Организация", Сделка.Организация);
	Запрос.УстановитьПараметр("Сделка", Сделка);
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходыПоСделкеОбороты.СуммаОборот КАК СуммаОборот,
		|	РасходыПоСделкеОбороты.Валюта КАК Валюта
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Сделка = &Сделка
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделкеОбороты";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Сделка.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Документ.Дата));
	Запрос.УстановитьПараметр("Организация", Сделка.Организация);
	Запрос.УстановитьПараметр("Сделка", Сделка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Сделка.СчетДоверительногоУправления);
	
	РасходыПоСделке = 0;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Валюта = Сделка.ВалютаСделки Тогда
			СуммаКомиссии = ВыборкаДетальныеЗаписи.СуммаОборот;
		Иначе
			СуммаКомиссии = РаботаСВалютами.ПересчетСуммыВВалюте(ВыборкаДетальныеЗаписи.СуммаОборот, ВыборкаДетальныеЗаписи.Валюта, НачалоДня(Сделка.Дата), Сделка.ВалютаСделки, НачалоДня(Сделка.Дата));
		КонецЕсли;
		РасходыПоСделке = РасходыПоСделке + СуммаКомиссии;
	КонецЦикла;
	
	Возврат РасходыПоСделке;
	
КонецФункции

Функция ПолучитьТаблицуНеправильныхОстатковПоСчетамБухгалтерскогоУчета(Период, Организация, СчетДоверительногоУправления, ВидУчета, ПолучатьОтрицательноеСальдо = Истина, ПолучатьЗависшееСальдоПоВалютеИКоличеству = Ложь) Экспорт

	Если НЕ ПолучатьОтрицательноеСальдо И НЕ ПолучатьЗависшееСальдоПоВалютеИКоличеству Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СтоимостьПереоценки.Цена) КАК Цена
		|ПОМЕСТИТЬ _ЦенныеБумагиОценкаНоль
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.Период = &ПериодПереоценки
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага
		|
		|ИМЕЮЩИЕ
		|	СУММА(СтоимостьПереоценки.Цена) = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3 КАК Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.Организация КАК Организация,
		|	ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 3) = ""612""
		|			ТОГДА ""Остаток на 612 счете""
		|		КОГДА &ПолучатьОтрицательноеСальдо
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокДт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт < 0)
		|			ТОГДА ""Отрицательное сальдо по активному счету""
		|		КОГДА &ПолучатьОтрицательноеСальдо
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт < 0)
		|			ТОГДА ""Положительное сальдо по пассивному счету""
		|		КОГДА &ПолучатьЗависшееСальдоПоВалютеИКоличеству
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт < 0)
		|			ТОГДА ""Положительное сальдо по пассивному счету""
		|		КОГДА &ПолучатьЗависшееСальдоПоВалютеИКоличеству
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт < 0)
		|			ТОГДА ""Положительное сальдо по пассивному счету""
		|		КОГДА &ПолучатьЗависшееСальдоПоВалютеИКоличеству
		|					И ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт = 0
		|					И ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокДт <> 0
		|				ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт = 0
		|					И ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт <> 0
		|			ТОГДА ""Зависло количество""
