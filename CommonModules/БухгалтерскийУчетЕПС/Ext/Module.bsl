		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт < 0)
		|			ИЛИ &ПолучатьОтрицательноеСальдо
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|				И ЕдиныйБухгалтерскийУчетОстатки.Счет <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ДобавочныйКапитал30)
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт < 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт < 0)
		|			ИЛИ &ПолучатьЗависшееСальдоПоВалютеИКоличеству
		|				И ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт = 0
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокДт <> 0
		|						И ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 2) <> ""58""
		|						И ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 2) <> ""50""
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт <> 0)
		|			ИЛИ &ПолучатьЗависшееСальдоПоВалютеИКоличеству
		|				И ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт = 0
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстатокКт <> 0
		|						И ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 2) <> ""58""
		|						И ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 2) <> ""50""
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт <> 0)
		|				И _ЦенныеБумагиОценкаНоль.ЦеннаяБумага ЕСТЬ NULL
		|			ИЛИ ПОДСТРОКА(ЕдиныйБухгалтерскийУчетОстатки.Счет.Код, 1, 3) = ""612""
		|				И (ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстаток <> 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток <> 0
		|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток <> 0))";
	
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет ИЛИ ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет КАК ЛицевойСчет,", "");
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
			СтрокаЗамены = "БухгалтерскийУчет";
		Иначе
			СтрокаЗамены = "НалоговыйУчет";
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчет", СтрокаЗамены);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(Период, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодПереоценки", НачалоДня(Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПолучатьОтрицательноеСальдо", ПолучатьОтрицательноеСальдо);
	Запрос.УстановитьПараметр("ПолучатьЗависшееСальдоПоВалютеИКоличеству", ПолучатьЗависшееСальдоПоВалютеИКоличеству);
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		Запрос.УстановитьПараметр("ПроверятьСчет47903", Ложь);
	Иначе
		Запрос.УстановитьПараметр("ПроверятьСчет47903", Истина);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
