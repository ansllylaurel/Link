					ПараметрыНачисления.Вставить("СчетДоходов",		ВыборкаДетальныеЗаписи.УчетныйАктивЕПССчетУчетаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("СчетРасходов",	ВыборкаДетальныеЗаписи.УчетныйАктивЕПССчетУчетаРасходовОтОпераций);
					
					ПараметрыНачисления.Вставить("АналитикаДоходов",	ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаДоходовОтОпераций);
					ПараметрыНачисления.Вставить("АналитикаРасходов",	ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаРасходовОтОпераций);
					
					Если ТипЗнч(ПараметрыНачисления.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
						ПараметрыНачисления.Вставить("Партия",	ПараметрыНачисления.Партия.Основание);
					КонецЕсли;
					
					Закрыть7ойРазделПоПартии(ОбъектДокумента, УчетныйРегистр, ПараметрыНачисления);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ПроизошлоВосстановлениеРезерва И Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда // ооочень редкая штука, поэтому вытащил в отдельный запрос
		
		ЗакрытьДоходыРасходыпоРезервамСПартиямиНаЛицевыхСчетах(ОбъектДокумента);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиОплатыТорговойКомиссииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ) Экспорт

	Сделка = ПараметрыОплаты.Сделка;
	
	СуммаКомиссииВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПараметрыОплаты.ТорговаяКомиссия, Сделка.ВалютаТорговойКомиссии, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаКомиссииВВалютеУчета, "По торговой комиссии списание");
	
	Если Сделка.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		Проводка.СчетДт 						= ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоДт.ЦенныеБумаги 		= ПараметрыОплаты.ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
	ИначеЕсли ПараметрыОплаты.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость Тогда
		Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты08;
		Проводка.СубконтоДт.Контрагенты 		= ПараметрыОплаты.КонтрагентПоКомиссии;
		Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
		Проводка.ВалютаДт  						= Сделка.ВалютаТорговойКомиссии;
		Проводка.ВалютнаяСуммаДт 				= ПараметрыОплаты.ТорговаяКомиссия;
	Иначе
		Проводка.СчетДт 											= ПараметрыОплаты.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов 	= ПараметрыОплаты.УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
		Проводка.СубконтоДт.ЦенныеБумаги 							= ПараметрыОплаты.ЦеннаяБумага;
		
		Проводка.Партия = ПараметрыОплаты.Партия;
		Проводка.СтрокаПартии = ПараметрыОплаты.СтрокаПартии;
	КонецЕсли;
	
	Проводка.СчетКт 									= ПараметрыОплаты.СчетДС;
	Проводка.СубконтоКт[ПараметрыОплаты.ВидСубконтоДС]	= ПараметрыОплаты.СубконтоДС;
	
	Если Сделка.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств		= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
	Иначе	
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств		= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
	КонецЕсли;
	
	Проводка.ВалютаКт  			= Сделка.ВалютаТорговойКомиссии;
	Проводка.ВалютнаяСуммаКт 	= ПараметрыОплаты.ТорговаяКомиссия;

КонецПроцедуры

Процедура СформироватьПроводкиПокупки(ЭтотОбъект, Движения, Выборка, УчетныйАктив, ВалютаНоминала, НастройкиУчетаЦеннойБумаги, Сделка, Контрагент) Экспорт
	
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	АналитикаПП					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
	
    // ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА СПИСЫВАЯ СО 47408
	СуммаПремии = ?(Выборка.ДисконтПремия > 0, Выборка.ДисконтПремияНачисленный, 0);
	СуммаПремииВВалютеУчета = ?(Выборка.ДисконтПремия > 0, Выборка.ДисконтПремияНачисленныйВВалютеУчета, 0);
	СуммаДисконта = 0;
	СуммаДисконтаВВалютеУчета = 0;
	СуммаТела = Выборка.Стоимость;
	СуммаТелаВВалютеУчета = Выборка.СтоимостьВВалютеУчета;
	
	// т.к. индексированный номинал возможен только у гособлигации
	// и они завязаны на инфляцию валюты страны
	// и врядли мы купим цб других стран
	// то пока заложимся на то, что они строго в рублях
	СуммаИндексацииНоминала = Выборка.ИндексацияНоминала; 

	Если НастройкиУчетаЦеннойБумаги.СтоимостьТелаРавнаНоминалу И Выборка.ДисконтПремия < 0 Тогда
		// на стоимости всегда номинал и дисконт < 0
		СуммаДисконта = Выборка.ДисконтПремияНачисленный;
		СуммаДисконтаВВалютеУчета = Выборка.ДисконтПремияНачисленныйВВалютеУчета;
		
	КонецЕсли;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаТелаВВалютеУчета, "Покупка ценной бумаги (тело)");
	
	// дебет
	Проводка.СчетДт = УчетныйАктив.СчетУчета;
	
	Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
	
	Проводка.КоличествоДт = Выборка.Количество;
	Проводка.ВалютаДт  = ВалютаНоминала;
	Проводка.ВалютнаяСуммаДт = СуммаТела;
	
	Проводка.ДополнительнаяАналитикаДт = АналитикаТела;
	
	// кредит
	Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
	
	Проводка.СубконтоКт.Контрагенты = Контрагент;
	Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
	
	Проводка.ВалютаКт        = ВалютаНоминала;
	Проводка.ВалютнаяСуммаКт = СуммаТела;
	
	Если СуммаПремии > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаПремииВВалютеУчета, "Покупка ценной бумаги (премия)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчета;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.КоличествоДт = 0;
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = СуммаПремии;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаПремии;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоКт.Контрагенты = Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт        = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = СуммаПремии;
		
	КонецЕсли;
	
	Если СуммаДисконта < 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаДисконтаВВалютеУчета, "Покупка ценной бумаги (дисконт)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчета;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.КоличествоДт = 0;
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = СуммаДисконта;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаДисконта;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоКт.Контрагенты = Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт        = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = СуммаДисконта;
	
	КонецЕсли;
	
	Если СуммаИндексацииНоминала > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаИндексацииНоминала, "Покупка ценной бумаги (индексация номинала)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаПереоценкиА;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.КоличествоДт = 0;
		Проводка.ВалютаДт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = СуммаИндексацииНоминала;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаИндексацииНоминала;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоКт.Контрагенты = Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт        = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = СуммаИндексацииНоминала;
		
	КонецЕсли;
	
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		
		// ПРИХОДУЕМ СТОИМОСТЬ ТЕЛА СПИСЫВАЯ СО 47408
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.СтоимостьКупонаВВалютеУчета, "Покупка ценной бумаги (купон)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.КоличествоДт = 0;
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = Выборка.СтоимостьКупона;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаКупонПриобретенный;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоКт.Контрагенты = Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт        = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
		
	КонецЕсли;
	
	
	Если Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, "Покупка ценной бумаги (корректировка ПП)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаКорректировокА;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаПП;
		
		// кредит
		Проводка.СчетКт = УчетныйАктив.СчетУчетаДоходовОтОпераций;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовПервоначальногоПризнания;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
	ИначеЕсли Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, "Покупка ценной бумаги (корректировка ПП)");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаРасходовОтОпераций;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовПервоначальногоПризнания;
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		// кредит
		Проводка.СчетКт = УчетныйАктив.СчетУчетаКорректировокП;
		
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		
		Проводка.ВалютаКт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
		
		Проводка.ДополнительнаяАналитикаКт = АналитикаПП;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиПереоценки(ЭтотОбъект, Выборка, УчетныйАктив, ВалютаНоминала, ВалютаУчета, ОстаткиПартий, Отказ) Экспорт

	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	Если Выборка.Перекурсовка Тогда
		
		СтрокиОстатков = ОстаткиПартий.НайтиСтроки(Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии", Выборка.ЦеннаяБумага, УчетныйАктив, выборка.Партия, Выборка.СтрокаПартии));
		
		ДисконтПремияНачисленныйОстаток 										= 0;
		ПереоценкаОстаток 											= 0;
		КорректировкаЭСПОстаток 									= 0;
		РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток 	= 0;
		
		Если СтрокиОстатков.Количество()>0 Тогда
			СтрокаОстатков = СтрокиОстатков[0];
			ДисконтПремияНачисленныйОстаток 							= СтрокаОстатков.ДисконтПремияНачисленныйОстаток;
			ПереоценкаОстаток 											= СтрокаОстатков.ПереоценкаОстаток;
			КорректировкаЭСПОстаток 									= СтрокаОстатков.КорректировкаЭСПОстаток;
			РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток 	= СтрокаОстатков.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток;
		КонецЕсли;
		
		ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
			+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
			+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,"
			+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
			Выборка.ЦеннаяБумага, УчетныйАктив,
			Выборка.СтоимостьВВалютеУчета, Выборка.СтоимостьКупонаВВалютеУчета, Выборка.ПереоценкаВВалютеУчета, Выборка.ПереоценкаКупонаВВалютеУчета,
			Выборка.ДисконтПремияНачисленныйВВалютеУчета, Выборка.КорректировкаЭСПВВалютеУчета, Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
			ДисконтПремияНачисленныйОстаток,ПереоценкаОстаток,КорректировкаЭСПОстаток,РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
		
		ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);	
		
	Иначе
		
		//дооценки перед расходом купона, дисконта и т.п.
		Если Выборка.Переоценка <> 0 Тогда
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"Переоценка", Выборка.Переоценка, Выборка.ПереоценкаВВалютеУчета, ВалютаУчета, УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Неопределено);
			ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
		КонецЕсли;
		
		Если Выборка.ДисконтПремияНачисленный <> 0 Тогда
			ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
				Выборка.ДисконтПремияНачисленныйВВалютеУчета, Выборка.ДисконтПремияНачисленный, ВалютаУчета, УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала);
			ПараметрыНачисления.Вставить("Аналитика", ?(Выборка.ДисконтПремияНачисленный < 0,АналитикаПремии,АналитикаДисконта));
			НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
		КонецЕсли;
		
		Если Выборка.КорректировкаЭСП <> 0 Тогда
			ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
				"КорректировкаЭСП", Выборка.КорректировкаЭСП, Выборка.КорректировкаЭСПВВалютеУчета,ВалютаУчета,  УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Неопределено);
			ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Если Выборка.ПереоценкаКупона <> 0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Аналитика",
					Выборка.ПереоценкаКупонаВВалютеУчета, Выборка.ПереоценкаКупона, ВалютаУчета, УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, АналитикаКупонНачисленный);
				НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			
			Если Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"РазницаПервоначальногоПризнания", Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, ВалютаУчета,  УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Неопределено);
				ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура СформироватьПроводкиПродажи(ЭтотОбъект, Движения, Выборка, УчетныйАктив, ВалютаНоминала, ВалютаУчета, Сделка, Контрагент, СуммаПартии, СуммаКупонаПартии, СуммаНакладныхРасходовПартии, СуммаНакладныхРасходовПартииВВалютеУчета, Закрывать7ойРазделПриПоступленииДенежныхСредств, ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов, АналитикаРезервов, Отказ)

	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ НА РЕАЛИЗАЦИЮ
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.СтоимостьВВалютеУчета, "Списание себестоимости ценной бумаги");
	
	Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
	Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
	Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
	Проводка.КоличествоДт = Выборка.Количество;
	
	Проводка.СчетКт = УчетныйАктив.СчетУчета;
	Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
	Проводка.КоличествоКт = Выборка.Количество;
	Проводка.ВалютаКт = ВалютаНоминала;
	Проводка.ВалютнаяСуммаКт = Выборка.Стоимость;
	Проводка.ДополнительнаяАналитикаКт = АналитикаТела;
	
	Если Выборка.ДисконтПремия > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.ДисконтПремияНачисленныйВВалютеУчета, "Списание себестоимости ценной бумаги (премия)");

		Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		Проводка.КоличествоДт = 0;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчета;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.КоличествоКт = 0;
		Проводка.ВалютаКт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = Выборка.ДисконтПремияНачисленный;
		Проводка.ДополнительнаяАналитикаКт = АналитикаПремии;
		
	ИначеЕсли Выборка.ДисконтПремия < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.ДисконтПремияНачисленныйВВалютеУчета, "Списание себестоимости ценной бумаги (дисконт)");

		Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		Проводка.КоличествоДт = 0;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчета;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.КоличествоКт = 0;
		Проводка.ВалютаКт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = Выборка.ДисконтПремияНачисленный;
		Проводка.ДополнительнаяАналитикаКт = АналитикаДисконта;
		
	КонецЕсли;
	
	ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
		"Переоценка", -Выборка.Переоценка, -Выборка.ПереоценкаВВалютеУчета, ВалютаУчета,  УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Сделка);
	ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
	
	ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
		"ИндексацияНоминала", -Выборка.ИндексацияНоминала, -Выборка.ИндексацияНоминала, ВалютаУчета, УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Сделка);
	ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
	
	ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
		"КорректировкаЭСП", -Выборка.КорректировкаЭСП, -Выборка.КорректировкаЭСПВВалютеУчета, ВалютаУчета,  УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Сделка);
	ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
	
	ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
		"РазницаПервоначальногоПризнания", -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, -Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, ВалютаУчета,  УчетныйАктив, Выборка.ЦеннаяБумага, ВалютаНоминала, Сделка);
	ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
	
	// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ
	СуммаПартииВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПартии, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаПартииВВалютеУчета, "Продажа ценной бумаги");
	
	Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
	Проводка.СубконтоДт.Контрагенты = Контрагент;
	Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
	Проводка.ВалютаДт        = ЭтотОбъект.ВалютаСделки;
	Проводка.ВалютнаяСуммаДт = СуммаПартии;
	
	Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
	Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
	Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
	Проводка.КоличествоКт = Выборка.Количество;
	
	Доход = СуммаПартии
		- Выборка.Стоимость
		- Выборка.Переоценка
		- Выборка.ИндексацияНоминала
		- Выборка.ДисконтПремияНачисленный
		- Выборка.КорректировкаЭСП;
		
	ДоходВВалютеУчета = СуммаПартииВВалютеУчета
		- Выборка.СтоимостьВВалютеУчета
		- Выборка.ПереоценкаВВалютеУчета
		- Выборка.ИндексацияНоминала
		- Выборка.ДисконтПремияНачисленныйВВалютеУчета
		- Выборка.КорректировкаЭСПВВалютеУчета;
		
	ДоходПоБумаге = Доход - СуммаНакладныхРасходовПартии;
	ДоходПоБумагеВВалютеУчета = ДоходВВалютеУчета - СуммаНакладныхРасходовПартииВВалютеУчета;
	
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
	    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПРОДАННОГО КУПОНА НА РЕАЛИЗАЦИЮ
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.СтоимостьКупонаВВалютеУчета, "Списание себестоимости ценной бумаги (купон)");

		Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		Проводка.КоличествоДт = 0;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.КоличествоКт = 0;
		Проводка.ВалютаКт = ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = Выборка.СтоимостьКупона;
		Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
		
		Если Выборка.ПереоценкаКупона <> 0 Тогда
		    // СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПЕРОЦЕНКИ ПРОДАННОГО КУПОНА НА РЕАЛИЗАЦИЮ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.ПереоценкаКупонаВВалютеУчета, "Списание себестоимости ценной бумаги (переоценка купона)");

			Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			Проводка.КоличествоДт = 0;
			
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;	                                             
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.КоличествоКт = 0;
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = Выборка.ПереоценкаКупона;
			Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;

		КонецЕсли;
		
		// ПРИХОДУЕМ ДОХОД ОТ ПРОДАЖИ КУПОНА
		СуммаКупонаПартииВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКупонаПартии, ЭтотОбъект.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаКупонаПартииВВалютеУчета, "Продажа ценной бумаги (купон)");
		
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
		Проводка.СубконтоДт.Контрагенты = Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		Проводка.ВалютаДт        = ЭтотОбъект.ВалютаСделки;
		Проводка.ВалютнаяСуммаДт = СуммаКупонаПартии;
		
		Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		Проводка.КоличествоКт = 0;
		
		Доход = СуммаКупонаПартии - Выборка.СтоимостьКупона - Выборка.ПереоценкаКупона;
		ДоходВВалютеУчета = СуммаКупонаПартииВВалютеУчета - Выборка.СтоимостьКупонаВВалютеУчета - Выборка.ПереоценкаКупонаВВалютеУчета;
		ДоходПоБумаге = ДоходПоБумаге + Доход;
		ДоходПоБумагеВВалютеУчета = ДоходПоБумагеВВалютеУчета + ДоходВВалютеУчета;
		
	КонецЕсли;

	Если ДоходПоБумагеВВалютеУчета > 0 Тогда
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, ДоходПоБумагеВВалютеУчета, "Продажа ценной бумаги");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
		
		// кредит
		Проводка.СчетКт = УчетныйАктив.СчетУчетаДоходовОтОпераций;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтОпераций;
		Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
		
		//закрыть 7 раздел
		Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, ДоходПоБумагеВВалютеУчета, "Закрытие дохода");
			
			// дебет
			Проводка.СчетДт = УчетныйАктив.СчетУчетаДоходовОтОпераций;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтОпераций;
			Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
		
		КонецЕсли;
		
	ИначеЕсли ДоходПоБумагеВВалютеУчета < 0 Тогда
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, -ДоходПоБумагеВВалютеУчета, "Продажа ценной бумаги");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаРасходовОтОпераций;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
		Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		//закрыть 7 раздел
		Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, -ДоходПоБумагеВВалютеУчета, "Закрытие расхода");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаРасходовОтОпераций;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
			Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
		
		КонецЕсли;
		
	КонецЕсли;

	Если Выборка.СуммаРезервовПодОбесценение > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, Выборка.СуммаРезервовПодОбесценение, "Списание резерва");	
		
		
		Проводка.СчетДт = УчетныйАктив.СчетУчетаРезервов;
		
		Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;   
		Если ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО39 Тогда
			Проводка.СубконтоДт.Резервы	= Справочники.Резервы.РезервПодОбесценениеМСФО39; 
		Иначе	
			ОтборАналитикаРезервов = Новый Структура();
			ОтборАналитикаРезервов.Вставить("ЦеннаяБумага", Выборка.ЦеннаяБумага);
			ОтборАналитикаРезервов.Вставить("СчетУчетаРезерва", УчетныйАктив.СчетУчетаРезервов);
			ОтборАналитикаРезервов.Вставить("Организация", ЭтотОбъект.Организация);
			ОтборАналитикаРезервов.Вставить("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
			
			СтрокиАналитикаРезервов = АналитикаРезервов.НайтиСтроки(ОтборАналитикаРезервов);
			Если СтрокиАналитикаРезервов.Количество() > 0 Тогда
				Проводка.СубконтоДт.Резервы	= СтрокиАналитикаРезервов[0].АналитикаРезерва; 
			Иначе	
				Проводка.СубконтоДт.Резервы	= Справочники.Резервы.РезервОбесценениеУбытки12Месяцев;
			КонецЕсли;
		КонецЕсли;
		
		Проводка.ВалютаДт			= ВалютаУчета;
		Проводка.ВалютнаяСуммаДт	= Выборка.СуммаРезервовПодОбесценение;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета) ;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= УчетныйАктив.АналитикаСписанияРезервов;
		Проводка.СубконтоКт.ЦенныеБумаги							= Выборка.ЦеннаяБумага;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиНачалаСделки(ОбъектДокумента, Сделка, Контрагент, ДатаСделки, ВалютаСделки, ОбщаяСуммаСделки, ЭтоПоставка, ДвиженияПартий = Неопределено, Отказ) Экспорт
	
	Если НЕ ЭтоПоставка Тогда
		
		ВалютаСделкиДт = ВалютаСделки;
		ВалютнаяСуммаДт = ОбщаяСуммаСделки;
		
		Если ДвиженияПартий <> Неопределено Тогда
			ДвиженияПартий.Свернуть("ВалютаНоминала", "СтоимостьПокупки, СтоимостьКупона");
			
			Для Каждого СтрокаДвиженийПартий Из ДвиженияПартий Цикл
				Если СтрокаДвиженийПартий.ВалютаНоминала <> ВалютаСделки Тогда
					ВалютаСделкиДт = СтрокаДвиженийПартий.ВалютаНоминала;
					ВалютнаяСуммаДт = СтрокаДвиженийПартий.СтоимостьПокупки + СтрокаДвиженийПартий.СтоимостьКупона;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
		
		ОбщаяСуммаСделкиРуб = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ОбщаяСуммаСделки, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата, Отказ), 2);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ОбщаяСуммаСделкиРуб, "Цена сделки");
		
		// дебет
		Проводка.СчетДт							= ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоДт.Контрагенты			= Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов	= Сделка;
		
		Проводка.ВалютаДт						= ВалютаСделкиДт;
		Проводка.ВалютнаяСуммаДт				= ВалютнаяСуммаДт;
		
		// кредит
		Проводка.СчетКт							= ПланыСчетов.Единый.Расчеты07;
		
		Проводка.СубконтоКт.Контрагенты			= Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов	= Сделка;
		
		Проводка.ВалютаКт						= ВалютаСделки;
		Проводка.ВалютнаяСуммаКт				= ОбщаяСуммаСделки;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход) КАК СуммаРасход,
			|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход) КАК КоличествоРасход,
			|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание
			|ПОМЕСТИТЬ ИсполненияПоСделкам
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|			&ДатаНачалаОборотов,
			|			&МоментДляИсполнений,
			|			,
			|			Основание = &Сделка
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоДенежнымСредствамОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗадолженностиПоДенежнымСредствамОбороты.Основание
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СУММА(ЗадолженностиПоЦеннымБумагамОбороты.СуммаРасход),
			|	СУММА(ЗадолженностиПоЦеннымБумагамОбороты.КоличествоРасход),
			|	ЗадолженностиПоЦеннымБумагамОбороты.Основание
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Обороты(&ДатаНачалаОборотов, &МоментДляИсполнений, , Основание = &Сделка) КАК ЗадолженностиПоЦеннымБумагамОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗадолженностиПоЦеннымБумагамОбороты.Основание
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(УсловияСделокСрезПоследних.Сумма) КАК СуммаСделки,
			|	СУММА(УсловияСделокСрезПоследних.СуммаКупона) КАК СуммаСделкиКупон,
			|	ИсполненияПоСделкам.Основание КАК Основание
			|ИЗ
			|	РегистрСведений.УсловияСделок.СрезПоследних(&МоментДляУсловий, Сделка = &Сделка) КАК УсловияСделокСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ ИсполненияПоСделкам КАК ИсполненияПоСделкам
			|		ПО УсловияСделокСрезПоследних.Сделка = ИсполненияПоСделкам.Основание
			|ГДЕ
			|	ИсполненияПоСделкам.Основание ЕСТЬ NULL
			|
			|СГРУППИРОВАТЬ ПО
			|	ИсполненияПоСделкам.Основание";
		
		Запрос.УстановитьПараметр("ДатаНачалаОборотов", НачалоДня(ДатаСделки));
		Запрос.УстановитьПараметр("МоментДляИсполнений", Новый Граница(ОбъектДокумента.МоментВремени(),ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("МоментДляУсловий", Новый Граница(ОбъектДокумента.МоментВремени(),?(ТипЗнч(ОбъектДокумента.Ссылка)=Тип("ДокументСсылка.Сделка"),ВидГраницы.Включая,ВидГраницы.Исключая)));
		Запрос.УстановитьПараметр("Сделка", Сделка);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныхЗаписей = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныхЗаписей.Следующий() Цикл
			
			СуммаСделки = ВыборкаДетальныхЗаписей.СуммаСделки;
			СуммаСделкиКупон = ВыборкаДетальныхЗаписей.СуммаСделкиКупон;
			
			СуммаСделкиРуб = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаСделки, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата, Отказ),2);
			СуммаСделкиКупонРуб = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаСделкиКупон, ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата, Отказ),2);
			
			//отражаем цену сделки
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаСделкиРуб + СуммаСделкиКупонРуб, "Цена сделки");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоДт.Контрагенты = Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаДт  = ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = СуммаСделки + СуммаСделкиКупон;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
			
			Проводка.СубконтоКт.Контрагенты = Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт        = ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = СуммаСделки + СуммаСделкиКупон;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПроводкиСписанияЦеннойБумагиСПартиямиНаЛицевыхСчетах(УчетныйРегистр, ОбъектДокумента, Отказ) Экспорт 
	
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ОбъектДокумента.Дата,
		ОбъектДокумента.Организация,
		ОбъектДокумента.СчетДоверительногоУправления);
		
	Если НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423ПриОплатеВДеньТПлюс Тогда
		Если БухгалтерскийУчетЕПС.ОтражатьЗадолженностьПриПолномПогашенииОблигацийНаСчете47423(ОбъектДокумента, "Списание") Тогда
			НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
		Иначе
			НастройкиУчетаОбщие.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоСписаниеЦеннойБумаги = ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.СписаниеЦеннойБумаги");
	ЭтоПогашениеЦеннойБумаги = ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПогашениеЦеннойБумаги");
	ЭтоОплата = ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Оплата");
	
	МассивПогашений = Новый Массив();
	
	Если ЭтоПогашениеЦеннойБумаги Тогда
		МассивПогашений.Добавить(ОбъектДокумента.Ссылка);
	ИначеЕсли ЭтоСписаниеЦеннойБумаги Тогда
		МассивПогашений.Добавить(ОбъектДокумента.ПогашениеЦеннойБумаги);
	ИначеЕсли ЭтоОплата Тогда
		Для каждого СтрокаОснования Из ОбъектДокумента.Основания Цикл
			МассивПогашений.Добавить(СтрокаОснования.Основание);
		КонецЦикла;
	КонецЕсли;
	
	СубконтоЦБ_Р = Новый Массив;
	СубконтоЦБ_Р.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
