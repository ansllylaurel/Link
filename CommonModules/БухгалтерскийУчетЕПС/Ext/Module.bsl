Процедура ПровестиКорректировкуПП(ЭтотОбъект, КредитныйИнструмент, СтоимостьВклада, СтоимостьВкладаПриПП) Экспорт
	
	ТипИнструмента = ТипЗнч(КредитныйИнструмент);
	Если ТипИнструмента = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		БанковскийСчет = КредитныйИнструмент.БанковскийСчет;
		УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(КредитныйИнструмент, ЭтотОбъект.Дата);
	ИначеЕсли ТипИнструмента = Тип("ДокументСсылка.МНО") Тогда
		БанковскийСчет = КредитныйИнструмент.РасчетныйСчет;
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настоящий момент не поддерживается начисление корректировок ПП по виду кредитного инструмента: " + Строка(ТипИнструмента));
		Возврат;
	КонецЕсли;
	
	СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаДоходовПервоначальногоПризнания.НомерСчетаБухгалтерскогоУчета);
	СчетУчетаРасходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаРасходовПервоначальногоПризнания.НомерСчетаБухгалтерскогоУчета);
	
	КорректировкаПП = СтоимостьВкладаПриПП - СтоимостьВклада;
	
	Если КорректировкаПП > 0 Тогда
		
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(КорректировкаПП, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ПП");
		
		Проводка.СчетДт = УчетныйАктив.СчетУчетаКорректировокА;
		Проводка.СубконтоДт.БанковскиеСчета = БанковскийСчет;
		Проводка.СубконтоДт.ДепозитныеВклады = КредитныйИнструмент;
		Проводка.ВалютаДт  = БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаДт = КорректировкаПП;
		
		Проводка.СчетКт = СчетУчетаДоходов;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовПервоначальногоПризнания;
		Проводка.СубконтоКт.ЦенныеБумаги = КредитныйИнструмент;
		
	ИначеЕсли КорректировкаПП < 0 Тогда 
		
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(-КорректировкаПП, БанковскийСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка ПП");
		
		Проводка.СчетДт = СчетУчетаРасходов;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовПервоначальногоПризнания;
		Проводка.СубконтоДт.ЦенныеБумаги = КредитныйИнструмент;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчетаКорректировокП;
		Проводка.СубконтоКт.БанковскиеСчета = БанковскийСчет;
		Проводка.СубконтоКт.ДепозитныеВклады = КредитныйИнструмент;
		Проводка.ВалютаКт  = БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаКт = -КорректировкаПП;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтнесениеНачисленныхДоходовНаАктивыВДУ(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ВалютаДоходов, Содержание, НаДату = "", Аналитика = Неопределено, ДоходЗаТекущийГод = 0, ГруппаФинансовогоУчетаДоходовРасходов = Неопределено, КоэффициентЗакрытия = 0, УчитыватьПартииНаСчетахУчета = Ложь) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И ЭтотОбъект.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
	КонецЕсли;
	
	ЭтотОбъект.Движения.Записать();
	
 	ВидыСубконто = Новый Массив;
 	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов);
 	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	
 	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ЭтотОбъект.Дата;
 	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстаток - ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстаток КАК ДоходЗаТекущийГод,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК ГруппаФинансовогоУчетаДоходовРасходов
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&Период,
		|			Период,
		|			,
		|			Счет = &СчетУчетаДоходов,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто2 = &ЦеннаяБумага
		|				И (&Аналитика = НЕОПРЕДЕЛЕНО
		|					ИЛИ ЛицевойСчет.ДополнительнаяАналитика = &Аналитика)
		|				И (&ГруппаФинансовогоУчетаДоходовРасходов = НЕОПРЕДЕЛЕНО
		|					ИЛИ Субконто1 = &ГруппаФинансовогоУчетаДоходовРасходов)) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты";
		
	Запрос.УстановитьПараметр("Организация"								, ЭтотОбъект.Организация);
 	Запрос.УстановитьПараметр("СчетДоверительногоУправления"			, УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГода"								, Новый Граница(НачалоГода(НаДату), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период"									, Новый Граница(НаДату, ВидГраницы.Включая));
 	Запрос.УстановитьПараметр("СчетУчетаДоходов"						, СчетУчетаДоходов);
	Запрос.УстановитьПараметр("ВидыСубконто"							, ВидыСубконто);
 	Запрос.УстановитьПараметр("ЦеннаяБумага"							, ЦеннаяБумага);
 	Запрос.УстановитьПараметр("Аналитика"								, Аналитика);
 	Запрос.УстановитьПараметр("ГруппаФинансовогоУчетаДоходовРасходов"	, ГруппаФинансовогоУчетаДоходовРасходов);
	
	Если УчитыватьПартииНаСчетахУчета Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК ГруппаФинансовогоУчетаДоходовРасходов", 
			"ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК ГруппаФинансовогоУчетаДоходовРасходов,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет");
	
	КонецЕсли;
	
  	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ДоходЗаТекущийГод = 0 Тогда
			
			ДоходВПроводку = ВыборкаДетальныеЗаписи.ДоходЗаТекущийГод;
			
			Если КоэффициентЗакрытия <> 0  Тогда
			
				ДоходВПроводку = ДоходВПроводку * КоэффициентЗакрытия;
			
			КонецЕсли;
			
		Иначе
			
			ДоходВПроводку = ДоходЗаТекущийГод;
			
		КонецЕсли;
		

		Если ДоходВПроводку > 0 Тогда
	
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ДоходВПроводку, Содержание);
			
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			
			Проводка.СчетКт = СчетУчетаДоходов;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.ГруппаФинансовогоУчетаДоходовРасходов;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаКт = Аналитика;
			
			Если УчитыватьПартииНаСчетахУчета Тогда
			
				Проводка.Партия = ВыборкаДетальныеЗаписи.ЛицевойСчет.Партия;	
				Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.ЛицевойСчет.СтрокаПартии;	
			
			КонецЕсли;
			
		ИначеЕсли ДоходВПроводку < 0 Тогда
	
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, - ДоходВПроводку, Содержание);
			
			Проводка.СчетДт = СчетУчетаДоходов;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.ГруппаФинансовогоУчетаДоходовРасходов;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаДт = Аналитика;
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			
			Если УчитыватьПартииНаСчетахУчета Тогда
			
				Проводка.Партия = ВыборкаДетальныеЗаписи.ЛицевойСчет.Партия;	
				Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.ЛицевойСчет.СтрокаПартии;	
			
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;

 	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
КонецПроцедуры

Процедура ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДоходов, Содержание, Аналитика, ДоходЗаТекущийГод, Партия = Неопределено, СтрокаПартии = Неопределено) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	Если ДоходЗаТекущийГод > 0 Тогда

		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ДоходЗаТекущийГод, ВалютаДоходов, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, Содержание);
		
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
		
		Проводка.СчетКт = СчетУчетаДоходов;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		Проводка.ДополнительнаяАналитикаКт = Аналитика;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
	ИначеЕсли ДоходЗаТекущийГод < 0 Тогда

		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета( - ДоходЗаТекущийГод, ВалютаДоходов, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, Содержание);
		
		Проводка.СчетДт = СчетУчетаДоходов;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		Проводка.ДополнительнаяАналитикаДт = Аналитика;
		
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОтнесениеНачисленныхДоходовНаАктивыВДУПоЦеннымБумагам(ЭтотОбъект, ТЧ_ЦенныеБумаги, Рынок, ДоляЗакрытия = 1) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчета(
																ЭтотОбъект.Дата,
																ЭтотОбъект.Организация,
																УчетныйСчетДоверительногоУправления,
																"НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки");
																
	ЗакрытиеДоходовРасходовОтПереоценкиПоСтаройСхеме = (ЭтотОбъект.Дата < '20221001') И НЕ НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки; // тем, кто не сворачивает новая схема не нужна
																
	СуммаРассчитана = Ложь;
	Если ДоляЗакрытия <> 1 ИЛИ ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.Оплата") Тогда
		ЭтотОбъект.Движения.НакопленныеДоходыИРасходыКСписаниюПриПродажеЕПС.Записывать = Истина;
	КонецЕсли;
	
	Если ТипЗнч(ЭтотОбъект.Ссылка) <> Тип("ДокументСсылка.Сделка") 
		И ТипЗнч(ЭтотОбъект.Ссылка) <> Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") 
		И ТипЗнч(ЭтотОбъект.Ссылка) <> Тип("ДокументСсылка.ВыводЦенныхБумаг") 
		И ТипЗнч(ЭтотОбъект.Ссылка) <> Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|	-БухПартииЦенныхБумаг.ПереоценкаКупонаСНачалаГода КАК ПереоценкаКупонаСНачалаГода,
	|	-БухПартииЦенныхБумаг.КорректировкаЭСПСНачалаГода КАК КорректировкаЭСПСНачалаГода,
	|	-БухПартииЦенныхБумаг.ДисконтПремияНачисленныйСНачалаГода КАК ДисконтПремияНачисленныйСНачалаГода,
	|	-БухПартииЦенныхБумаг.ПереоценкаСНачалаГода КАК ПереоценкаСНачалаГода,
	|	-БухПартииЦенныхБумаг.ПереоценкаСНачалаГодаПоложительная КАК ПереоценкаСНачалаГодаПоложительная,
	|	-БухПартииЦенныхБумаг.РасходыПриПокупкеСНачалаГода КАК РасходыПриПокупкеСНачалаГода,
	|	-БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияСНачалаГода КАК РазницаПервоначальногоПризнанияСНачалаГода,
	|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
	|ПОМЕСТИТЬ _ЧистыеЗакрытияДоходовРасходов
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|ГДЕ
	|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
	|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ЧистыеЗакрытияДоходовРасходов.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.ПереоценкаКупонаСНачалаГода) КАК ПереоценкаКупона,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.КорректировкаЭСПСНачалаГода) КАК КорректировкаЭСП,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.ДисконтПремияНачисленныйСНачалаГода) КАК ДисконтПремияНачисленный,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.РасходыПриПокупкеСНачалаГода) КАК РасходыПриПокупкеСНачалаГода,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.РазницаПервоначальногоПризнанияСНачалаГода) КАК РазницаПервоначальногоПризнанияСНачалаГода,
	|	_ЧистыеЗакрытияДоходовРасходов.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.ПереоценкаСНачалаГода) КАК Переоценка,
	|	СУММА(_ЧистыеЗакрытияДоходовРасходов.ПереоценкаСНачалаГодаПоложительная) КАК ПереоценкаПоложительная
	|ИЗ
	|	_ЧистыеЗакрытияДоходовРасходов КАК _ЧистыеЗакрытияДоходовРасходов
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЧистыеЗакрытияДоходовРасходов.ЦеннаяБумага,
	|	_ЧистыеЗакрытияДоходовРасходов.УчетныйАктивЕПС";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ЦенныеБумаги = Запрос.Выполнить().Выгрузить();
	
	//Все суммы с начала года в валюте учета и их пересчитывать не надо
	ВалютаДохода  = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
		ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Попытка
			УчетныйАктив = СтрокаЦенныеБумаги.УчетныйАктивЕПС;	
		Исключение
			УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ЭтотОбъект, Рынок, ЦеннаяБумага, УчетныйСчетДоверительногоУправления);
		КонецПопытки;
		
		КорректировкаЭСП = 0;
		ПереоценкаКупона = 0;
		ДисконтПремияНачисленный = 0;
		
		
		Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			ДисконтПремияНачисленный = Окр(СтрокаЦенныеБумаги.ДисконтПремияНачисленный * ДоляЗакрытия, 2);
			
			ПереоценкаКупона = Окр(СтрокаЦенныеБумаги.ПереоценкаКупона * ДоляЗакрытия, 2);
			Если СтрокаЦенныеБумаги.ПереоценкаКупона <> 0 Тогда
				СчетУчетаДоходов = ПланыСчетов.Единый.ПроцентныеДоходы01;
				ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
				Если ПереоценкаКупона <> 0 Тогда
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по погашению купона", Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный, ПереоценкаКупона);
				КонецЕсли;
			КонецЕсли;
			
			КорректировкаЭСП = Окр(СтрокаЦенныеБумаги.КорректировкаЭСП * ДоляЗакрытия, 2);
			Если СтрокаЦенныеБумаги.КорректировкаЭСП > 0 Тогда
				СчетУчетаДоходов = ПланыСчетов.Единый.ПроцентныеДоходы06;
				ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтКорректировки;
				Если КорректировкаЭСП <> 0 Тогда
			    	БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по корректировке ЭСП", Неопределено, КорректировкаЭСП);
				КонецЕсли;
			ИначеЕсли СтрокаЦенныеБумаги.КорректировкаЭСП < 0 Тогда
				СчетУчетаДоходов = ПланыСчетов.Единый.ПроцентныеДоходы05;
				ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтКорректировки;
				Если КорректировкаЭСП <> 0 Тогда
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по корректировке ЭСП", Неопределено, КорректировкаЭСП);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки Тогда
			
			ПереоценкаПоложительная = Окр(СтрокаЦенныеБумаги.ПереоценкаПоложительная * ДоляЗакрытия, 2);
			
			Если ПереоценкаПоложительная < 0 Тогда
				
