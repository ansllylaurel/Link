	Запрос.УстановитьПараметр("СубконтоЦБ_Р", СубконтоЦБ_Р);
	Запрос.УстановитьПараметр("АналитикаРезерваПоУмолчанию", Справочники.Резервы.РезервОбесценениеУбытки12Месяцев);
	// у нее корректировка ПП пошла в тело, пока хардкод, будет исправляться по задаче по корректировке ПП
	Запрос.УстановитьПараметр("Облигация_РЖД_11", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РЖД_11"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда // списания партий не было
		Если ЭтоСписаниеЦеннойБумаги ИЛИ ЭтоПогашениеЦеннойБумаги Тогда // для списания ВСЕГДа должно быть списание партий, а для погашения если мы сюда попали, то тоже обязано быть списание партий
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ОбъектДокумента.Ссылка,,, Отказ);
		Иначе
			// в любом случае ничего не делаем, только для оплат это норма
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	
	СделалиПроводкиНачалаСделки = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			Выборка.ЦеннаяБумага,
			Выборка.УчетныйАктивЕПС,
			Выборка.Партия,
			Выборка.СтрокаПартии);
			
		Если (ЭтоСписаниеЦеннойБумаги Или ЭтоОплата) И НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности(Выборка.Погашение) Тогда
			// бумага не была списана в день погашения и весь НКД ранее был перенесен на эту аналитику
			АналитикаКупонНачисленный 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;	
			АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
		Иначе
			АналитикаКупонНачисленный 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
			АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
		КонецЕсли;	
		
		Если Выборка.Стоимость = 0 Тогда // сумма уже списана -> гоним количество по маршруту 50х -> 612 -> 47407
	
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, 0, "Погашение ценной бумаги");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
				
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.ОснованиеРасчетов = Выборка.Погашение;
			
			Проводка.КоличествоДт = Выборка.Количество;
			
			// кредит
			Проводка.СчетКт = Выборка.УчетныйАктивЕПС.СчетУчета;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			
			Проводка.ВалютаКт = Выборка.Погашение_ВалютаОплаты;
			Проводка.КоличествоКт = Выборка.Количество;
			
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
			
			Проводка.Партия = Выборка.Партия;
			Проводка.СтрокаПартии = Выборка.СтрокаПартии;
			
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, 0, "Погашение ценной бумаги");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
				
			Проводка.СубконтоДт.Контрагенты = Выборка.Погашение_Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Выборка.Погашение;
			
			Проводка.ВалютаДт = Выборка.Погашение_ВалютаОплаты;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
				
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоКт.ОснованиеРасчетов = Выборка.Погашение;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
			Продолжить;
			
		КонецЕсли;
		
		ДанныеПогашения = Новый Структура("Сумма, Количество", Выборка.Погашение_Сумма , Выборка.Погашение_Количество);
		
		ПроверитьПравильностьСписанияЦеннойБумаги(Выборка.ЦеннаяБумага, ОбъектДокумента, Выборка.Погашение, ДанныеПогашения, Выборка, НастройкиУчетаЦеннойБумаги, Отказ);
		
		Если НЕ СделалиПроводкиНачалаСделки Тогда
			
			Количество = Выборка.Погашение_Количество;
			
			СуммаВВалютеОплаты = Выборка.Погашение_Сумма;
			СуммаВВалютеНоминала = Выборка.Погашение_Количество * Выборка.Номинал;
			
			СуммаКупонаВВалютеОплаты = Выборка.Погашение_СуммаКупона;
			СуммаКупонаВВалютеНоминала = Количество * РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Выборка.ЦеннаяБумага, НачалоДня(Выборка.Погашение.Дата), ОбъектДокумента.СчетДоверительногоУправления, Истина);
			
			Если Выборка.Погашение_ВалютаОплаты = ВалютаУчета Тогда
				СуммаВВалютеУчета = СуммаВВалютеОплаты;
				СуммаКупонаВВалютеУчета = СуммаКупонаВВалютеОплаты;
			ИначеЕсли Выборка.ВалютаНоминала = ВалютаУчета Тогда
				СуммаВВалютеУчета = СуммаВВалютеНоминала;
				СуммаКупонаВВалютеУчета = СуммаКупонаВВалютеНоминала;
			Иначе
				СуммаВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаВВалютеНоминала, Выборка.ВалютаНоминала, ОбъектДокумента.Дата, ВалютаУчета, ОбъектДокумента.Дата, Отказ);
				СуммаКупонаВВалютеУчета = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупонаВВалютеНоминала, Выборка.ВалютаНоминала, ОбъектДокумента.Дата, ВалютаУчета, ОбъектДокумента.Дата, Отказ);
			КонецЕсли;
			
			ПараметрыОплаты = Новый Структура;
			
			ПараметрыОплаты.Вставить("ВалютаУчета",						ВалютаУчета);
			ПараметрыОплаты.Вставить("Сделка",							Выборка.Погашение);
			ПараметрыОплаты.Вставить("СуммаТела",						СуммаВВалютеОплаты);
			ПараметрыОплаты.Вставить("СуммаКупона",						СуммаКупонаВВалютеОплаты);
			ПараметрыОплаты.Вставить("ВалютаСделки",					Выборка.Погашение_ВалютаОплаты);
			ПараметрыОплаты.Вставить("ВалютаОплаты",					Выборка.Погашение_ВалютаОплаты);
			ПараметрыОплаты.Вставить("Контрагент",						Выборка.Погашение_Контрагент);
			ПараметрыОплаты.Вставить("НастройкиУчета",					НастройкиУчетаЦеннойБумаги);
			
			ПараметрыОплаты.Вставить("СуммаСделкиВВалютеУчета",			СуммаВВалютеУчета);
			ПараметрыОплаты.Вставить("СуммаКупонаВВалютеУчета",			СуммаКупонаВВалютеУчета);
			
			Если НЕ НастройкиУчетаЦеннойБумаги.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда // купон идет, как при погшашении купона по 501м счетам
			
				ПараметрыОплаты.Вставить("СуммаКупона",				0);
				ПараметрыОплаты.Вставить("СуммаКупонаВВалютеУчета",	0);
				
			КонецЕсли;
			
			БухгалтерскийУчетЕПС.СформироватьПроводкиНачалаСделкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
			
			СделалиПроводкиНачалаСделки = Истина;
		
		КонецЕсли;
		
		СписыватьПереоценку = Истина;
		Если НастройкиУчетаЦеннойБумаги.УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу Тогда  // переоценку списывать не надо - ее списали в погашении
			Если Выборка.Погашение.Дата < НачалоДня(ОбъектДокумента.Дата)                		// но только если погашение было в прошлом дне 
				ИЛИ НастройкиУчетаЦеннойБумаги.СписыватьПриПолномПогашенииВМоментПогашения Тогда 			// или они списывают при погашении
				СписыватьПереоценку = Ложь;
			КонецЕсли;
		КонецЕсли;
		
					
		СуммаСписать		= Окр(СуммаВВалютеОплаты		/ Количество * Выборка.КоличествоОстаток, 2);
		СуммаКупонаСписать	= Окр(СуммаКупонаВВалютеОплаты	/ Количество * Выборка.КоличествоОстаток, 2);
		
		СуммаВВалютеУчетаСписать		= Окр(СуммаВВалютеУчета			/ Количество * Выборка.КоличествоОстаток, 2);
		СуммаКупонаВВалютеУчетаСписать	= Окр(СуммаКупонаВВалютеУчета	/ Количество * Выборка.КоличествоОстаток, 2);
		
		СуммаВВалютеОплаты			= СуммаВВалютеОплаты		- СуммаСписать;
		СуммаКупонаВВалютеОплаты	= СуммаКупонаВВалютеОплаты	- СуммаКупонаСписать;
		
		СуммаВВалютеУчета		= СуммаВВалютеУчета			- СуммаВВалютеУчетаСписать;
		СуммаКупонаВВалютеУчета	= СуммаКупонаВВалютеУчета	- СуммаКупонаВВалютеУчетаСписать;
		
		ПараметрыОплаты.Вставить("УчетныйАктивЕПС",		Выборка.УчетныйАктивЕПС);
		ПараметрыОплаты.Вставить("ЦеннаяБумага",		Выборка.ЦеннаяБумага);
		ПараметрыОплаты.Вставить("ВалютаНоминала",		Выборка.ВалютаНоминала);
		ПараметрыОплаты.Вставить("ВалютаСделки",		Выборка.ВалютаНоминала);
		ПараметрыОплаты.Вставить("ВалютаУчета",			ВалютаУчета);
		
		ПараметрыОплаты.Вставить("Партия",				Выборка.Партия);
		ПараметрыОплаты.Вставить("СтрокаПартии",		Выборка.СтрокаПартии);
		
		Количество = Количество - Выборка.КоличествоОстаток;
		
		// 2 Продажа тела и купона 47407-61
		ПараметрыОплаты.Вставить("Количество",			Выборка.Количество);
		
		ПараметрыОплаты.Вставить("СуммаРеализации",				СуммаСписать);
		ПараметрыОплаты.Вставить("СуммаРеализацииВВалютеУчета",	СуммаВВалютеУчетаСписать);
		
		СформироватьПроводкуРеализацииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		Если НастройкиУчетаЦеннойБумаги.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации Тогда
		
			ПараметрыОплаты.Вставить("Количество",					0);
			ПараметрыОплаты.Вставить("СуммаРеализации",				СуммаКупонаСписать);
			ПараметрыОплаты.Вставить("СуммаРеализацииВВалютеУчета",	СуммаКупонаВВалютеУчетаСписать);
			
			СформироватьПроводкуРеализацииСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ, "(Купон)");
		
		КонецЕсли;
		
		// 3 Списание себестоимости и прочего 612-501
		
		// тело
		ПараметрыОплаты.Вставить("Количество",					Выборка.Количество);
		ПараметрыОплаты.Вставить("СчетУчета",					Выборка.УчетныйАктивЕПС.СчетУчета);
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаТела);
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.Стоимость);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.СтоимостьВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		ПараметрыОплаты.Вставить("Количество",					0);
		
		// НКДУ
		ПараметрыОплаты.Вставить("СчетУчета",					Выборка.УчетныйАктивЕПС.СчетУчетаКупона);
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаКупонПриобретенный);
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.СтоимостьКупона);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.СтоимостьКупонаВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// НКДН
		ПараметрыОплаты.Вставить("СчетУчета",					Выборка.УчетныйАктивЕПС.СчетУчетаКупона);
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаКупонНачисленный);
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.ПереоценкаКупона);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.ПереоценкаКупонаВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// Дисконт/премия
		ПараметрыОплаты.Вставить("СчетУчета",					Выборка.УчетныйАктивЕПС.СчетУчета);
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаДисконта);
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.ДисконтНачисленный);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.ДисконтНачисленныйВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// Премия
		ПараметрыОплаты.Вставить("СчетУчета",					Выборка.УчетныйАктивЕПС.СчетУчета);
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаПремии);
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.ПремияНачисленная);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.ПремияНачисленнаяВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// Переоценка
		Если СписыватьПереоценку Тогда
			ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		АналитикаПереоценкиТела);
			Если Выборка.ПереоценкаВВалютеУчета > 0 Тогда
				ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
			Иначе
				ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
			КонецЕсли;
			ПараметрыОплаты.Вставить("Стоимость",					Выборка.Переоценка);
			ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.ПереоценкаВВалютеУчета);
			
			СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		КонецЕсли;
		
		// Корректировка
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка());
		Если Выборка.КорректировкаЭСПВВалютеУчета > 0 Тогда
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаКорректировокА);
		Иначе
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаКорректировокП);
		КонецЕсли;
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.КорректировкаЭСП);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.КорректировкаЭСПВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ, "Корректировка ЭСП");
		
		// Разница ПП
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
		Если Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета > 0 Тогда
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт);
		Иначе
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт);
		КонецЕсли;
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// Индексация номинала
		ПараметрыОплаты.Вставить("ДополнительнаяАналитика",		Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала);
		Если Выборка.ИндексацияНоминала > 0 Тогда
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
		Иначе
			ПараметрыОплаты.Вставить("СчетУчета",				Выборка.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
		КонецЕсли;
		ПараметрыОплаты.Вставить("Стоимость",					Выборка.ИндексацияНоминала);
		ПараметрыОплаты.Вставить("СтоимостьВВалютеУчета",		Выборка.ИндексацияНоминала);
		
		СформироватьПроводкиСписания(ОбъектДокумента, УчетныйРегистр, ПараметрыОплаты, Отказ);
		
		// 4 Доход/расход по бумаге 612-715 или наоборот
		
		ДоходРасход = СуммаСписать + СуммаКупонаСписать
			- Выборка.Стоимость
			- Выборка.СтоимостьКупона
			- Выборка.ПереоценкаКупона
			- Выборка.ДисконтНачисленный
			- Выборка.ПремияНачисленная
			- Выборка.КорректировкаЭСП
			- Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные
			- Выборка.ИндексацияНоминала;
			
		ДоходРасходВВалютеУчета = СуммаВВалютеУчетаСписать + СуммаКупонаВВалютеУчетаСписать
			- Выборка.СтоимостьВВалютеУчета
			- Выборка.СтоимостьКупонаВВалютеУчета
			- Выборка.ПереоценкаКупонаВВалютеУчета
			- Выборка.ДисконтНачисленныйВВалютеУчета
			- Выборка.ПремияНачисленнаяВВалютеУчета
			- Выборка.КорректировкаЭСПВВалютеУчета
			- Выборка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета
			- Выборка.ИндексацияНоминала;
			
		Если СписыватьПереоценку Тогда
		
			ДоходРасход = ДоходРасход - Выборка.Переоценка;
				
			ДоходРасходВВалютеУчета = ДоходРасходВВалютеУчета - Выборка.ПереоценкаВВалютеУчета;
		
		КонецЕсли;						
			
		Если ДоходРасходВВалютеУчета > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ДоходРасходВВалютеУчета, "Продажа ценной бумаги");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
			
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыОплаты.Сделка;
			
			// кредит
			Проводка.СчетКт = Выборка.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
			
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = Выборка.УчетныйАктивЕПС.АналитикаДоходовОтОпераций;
			Проводка.СубконтоКт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			
			Проводка.Партия = Выборка.Партия;
			Проводка.СтрокаПартии = Выборка.СтрокаПартии;
			
		ИначеЕсли ДоходРасходВВалютеУчета < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, -ДоходРасходВВалютеУчета, "Продажа ценной бумаги");
			
			// дебет
			Проводка.СчетДт = Выборка.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = Выборка.УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
			Проводка.СубконтоДт.ЦенныеБумаги         = Выборка.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыОплаты.Сделка;
			
			Проводка.Партия = Выборка.Партия;
			Проводка.СтрокаПартии = Выборка.СтрокаПартии;
		
		КонецЕсли;
		
		Если Выборка.СуммаРезервовПодОбесценение > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, Выборка.СуммаРезервовПодОбесценение, "Списание резерва");	
			
			
			Проводка.СчетДт = Выборка.УчетныйАктивЕПС.СчетУчетаРезервов;
			
			Проводка.СубконтоДт.ЦенныеБумаги = Выборка.ЦеннаяБумага;
			Проводка.СубконтоДт.Резервы	= Выборка.АналитикаРезерва; 
			
			ЭтоАктивДляПродажи = (Выборка.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
									ИЛИ Выборка.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
			
			Если ЭтоАктивДляПродажи Тогда
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУРезервовДляБумагДляПродажиНаСчете106(Выборка.УчетныйАктивЕПС, Ложь);
			КонецЕсли;
			
			Проводка.ВалютаДт			= ВалютаУчета;
			Проводка.ВалютнаяСуммаДт	= Выборка.СуммаРезервовПодОбесценение;
			
			
			Проводка.СчетКт = ПланыСчетов.Единый.НайтиПоКоду(Выборка.УчетныйАктивЕПС.АналитикаСписанияРезервов.НомерСчетаБухгалтерскогоУчета) ;
			
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов	= Выборка.УчетныйАктивЕПС.АналитикаСписанияРезервов;
			Проводка.СубконтоКт.ЦенныеБумаги							= Выборка.ЦеннаяБумага;

			Проводка.Партия = Выборка.Партия;
			Проводка.СтрокаПартии = Выборка.СтрокаПартии;
			
		КонецЕсли;
		
		// для бумаг "Для продажи" нужно перевести переоценку со 106го на 715й счет
		Если Выборка.УчетныйАктивЕПС.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
		
			ПереносПереоценкиСоСчетовДобавочногоКапиталаНаСчетаДоходовРасходов(
									ОбъектДокумента,
									Выборка.УчетныйАктивЕПС,
									Выборка.ЦеннаяБумага,
									ВалютаУчета,
									-Выборка.ПереоценкаСНачалаГода,
									Выборка.Партия,
									Выборка.СтрокаПартии);
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПроводкиНачисленияКорректировкиЭСПСПереброской(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки)

	СуммаПереброскиКорректировкиЭСП = 0;
	СуммаПереброскиКорректировкиЭСПВВалютеУчета = 0;
	СуммаПереброскиДоходовРасходов = 0;
	
	СчетПереброски500Дт = Неопределено;
	СчетПереброски500Кт = Неопределено;
	
	СчетПереброски700Дт = Неопределено;
	СчетПереброски700Кт = Неопределено;
	АналитикаПереброски700Дт = Неопределено;
	АналитикаПереброски700Кт = Неопределено;
	
	Если ПараметрыПроводки.СуммаВВалютеУчета > 0 Тогда
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		Если ПараметрыПроводки.СчетУчета.Вид = ВидСчета.Активный Тогда // все ок, без переброски
			ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетУчета;
		Иначе // переброска: у нас ПАССИВНОЕ сальдо на начало проводки, а нам нужно НАЧИСЛЯТЬ - значит начисляем и потом перекидываем
			ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетУчетаПарный;
			Если ПараметрыПроводки.СуммаБалансоваяВВалютеУчета + ПараметрыПроводки.СуммаВВалютеУчета  <= 0 Тогда // начислив, мы так и остались в рамках пассивного сальдо - перенесем сумму проводки
				СуммаПереброскиКорректировкиЭСПВВалютеУчета = ПараметрыПроводки.СуммаВВалютеУчета;
				СуммаПереброскиКорректировкиЭСП = ПараметрыПроводки.Сумма;
			Иначе // начислив, мы перешли в положительное сальдо - делаем переброску на сумма начального остатка, он с минусом, поэтому меняем знак
				СуммаПереброскиКорректировкиЭСПВВалютеУчета = -ПараметрыПроводки.СуммаБалансоваяВВалютеУчета;
				СуммаПереброскиКорректировкиЭСП = -ПараметрыПроводки.СуммаБалансовая;
			КонецЕсли;
			// с активного на пассивный
			СчетПереброски500Дт = ПараметрыПроводки.СчетУчета;
			СчетПереброски500Кт = ПараметрыПроводки.СчетУчетаПарный;
		КонецЕсли;
		
		ПроводкаНачисления.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		ПроводкаНачисления.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаНачисления.ВалютнаяСуммаДт = ПараметрыПроводки.Сумма;
		
		// кредит
		Если ПараметрыПроводки.СчетДоходовРасходов.Вид = ВидСчета.Пассивный Тогда // все ок, без переброски
			ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетДоходовРасходов;
			ПроводкаНачисления.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУ;
		Иначе // переброска: у нас АКТИВНОЕ сальдо на начало проводки, а нам нужно СПИСЫВАТЬ - значит списываем и потом перекидываем
			ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетДоходовРасходовПарный;
			ПроводкаНачисления.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУПарный;
			Если ПараметрыПроводки.СуммаСНачалаГода <= 0 Тогда // списав, так и остались в рамках активного сальдо, (нюанс СуммаСНачалаГодаВВалютеУчета - это сумма на конец проводки, она идет уже с учетом движения)
				СуммаПереброскиДоходовРасходов = ПараметрыПроводки.СуммаВВалютеУчета; // перенесем сумму проводки
			Иначе // списав, мы перешли в пассивное сальдо - делаем переброску на сумма начального остатка
				СуммаПереброскиДоходовРасходов = ПараметрыПроводки.СуммаСНачалаГода + ПараметрыПроводки.СуммаВВалютеУчета;
			КонецЕсли;
			// с активного на пассивный
			СчетПереброски700Дт = ПараметрыПроводки.СчетДоходовРасходовПарный;
			СчетПереброски700Кт = ПараметрыПроводки.СчетДоходовРасходов;
			АналитикаПереброски700Дт = ПараметрыПроводки.ГФУПарный;
			АналитикаПереброски700Кт = ПараметрыПроводки.ГФУ;
		КонецЕсли;
		
		ПроводкаНачисления.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
	ИначеЕсли ПараметрыПроводки.СуммаВВалютеУчета < 0 Тогда
		
		ПроводкаНачисления = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		Если ПараметрыПроводки.СчетДоходовРасходов.Вид = ВидСчета.Активный Тогда // все ок, без переброски
			ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетДоходовРасходов;
			ПроводкаНачисления.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУ;
		Иначе // переброска: у нас ПАССИВНОЕ сальдо на начало проводки, а нам нужно НАЧИСЛЯТЬ - значит начисляем и потом перекидываем			
			ПроводкаНачисления.СчетДт = ПараметрыПроводки.СчетДоходовРасходовПарный;
			ПроводкаНачисления.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыПроводки.ГФУПарный;
			Если ПараметрыПроводки.СуммаСНачалаГода >= 0 Тогда // начислив, мы так и остались в рамках пассивного сальдо - перенесем сумму проводки (нюанс СуммаСНачалаГодаВВалютеУчета - это сумма на конец проводки, она идет уже с учетом движения)
				СуммаПереброскиДоходовРасходов = -ПараметрыПроводки.СуммаВВалютеУчета; // перенесем сумму проводки, только знак на + поменяем
			Иначе // начислив, мы перешли в положительное сальдо - делаем переброску на сумма начального остатка
				СуммаПереброскиДоходовРасходов = ПараметрыПроводки.СуммаСНачалаГода - ПараметрыПроводки.СуммаВВалютеУчета;
			КонецЕсли;
			// с активного на пассивный
			СчетПереброски700Дт = ПараметрыПроводки.СчетДоходовРасходов;
			СчетПереброски700Кт = ПараметрыПроводки.СчетДоходовРасходовПарный;
			АналитикаПереброски700Дт = ПараметрыПроводки.ГФУ;
			АналитикаПереброски700Кт = ПараметрыПроводки.ГФУПарный;
		КонецЕсли;
		
		ПроводкаНачисления.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		// кредит
		Если ПараметрыПроводки.СчетУчета.Вид = ВидСчета.Пассивный Тогда // все ок, без переброски
			ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетУчета;
		Иначе // переброска: у нас АКТИВНОЕ сальдо на начало проводки, а нам нужно СПИСЫВАТЬ - значит списываем и потом перекидываем
		    ПроводкаНачисления.СчетКт = ПараметрыПроводки.СчетУчетаПарный;
			Если ПараметрыПроводки.СуммаБалансоваяВВалютеУчета + ПараметрыПроводки.СуммаВВалютеУчета  >= 0 Тогда // списав, так и остались в рамках активного сальдо - перенесем сумму проводки
				СуммаПереброскиКорректировкиЭСПВВалютеУчета = -ПараметрыПроводки.СуммаВВалютеУчета;
				СуммаПереброскиКорректировкиЭСП = -ПараметрыПроводки.Сумма;
			Иначе // начислив, мы перешли в положительное сальдо - делаем переброску на сумма начального остатка
				СуммаПереброскиКорректировкиЭСПВВалютеУчета = ПараметрыПроводки.СуммаБалансоваяВВалютеУчета;
				СуммаПереброскиКорректировкиЭСП = ПараметрыПроводки.СуммаБалансовая;
			КонецЕсли;
			// с активного на пассивный
			СчетПереброски500Дт = ПараметрыПроводки.СчетУчетаПарный;
			СчетПереброски500Кт = ПараметрыПроводки.СчетУчета;
		КонецЕсли;
		
		ПроводкаНачисления.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		
		ПроводкаНачисления.ВалютаКт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаНачисления.ВалютнаяСуммаКт = -ПараметрыПроводки.Сумма;
		
	КонецЕсли;
	
	ПроводкаНачисления.Партия = ПараметрыПроводки.Партия;
	ПроводкаНачисления.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
	
	Если СуммаПереброскиКорректировкиЭСПВВалютеУчета <> 0 Тогда
		
		ПроводкаПереброски500 = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], СуммаПереброскиКорректировкиЭСПВВалютеУчета, "Закрытие парных счетов корректировки ЭСП");
		
		ПроводкаПереброски500.СчетДт = СчетПереброски500Дт;
		ПроводкаПереброски500.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		ПроводкаПереброски500.ВалютаДт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаПереброски500.ВалютнаяСуммаДт = СуммаПереброскиКорректировкиЭСП;
		
		ПроводкаПереброски500.СчетКт = СчетПереброски500Кт;
		ПроводкаПереброски500.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
		ПроводкаПереброски500.ВалютаКт  = ПараметрыПроводки.ВалютаНоминала;
		ПроводкаПереброски500.ВалютнаяСуммаКт = СуммаПереброскиКорректировкиЭСП;
		
		ПроводкаПереброски500.Партия = ПараметрыПроводки.Партия;
		ПроводкаПереброски500.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
		
	КонецЕсли;
	
	// тут должна была быть проводка свертки парных счетов доходов/ расходов
	// мы ведь считали СчетПереброски700Дт, СчетПереброски700Кт и прочее
	// но СНГ не смог реализовать учет партий на лицевых счетах счетов 71005/71006
	// поэтому свертка в документе переоценка и уже без партий
	
КонецПроцедуры

Процедура СформироватьПроводкиНачалаСделкиСПартиямиНаЛицевыхСчетах(ОбъектДокумента, УчетныйРегистр, Параметры, Отказ) Экспорт

	Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПоставкаЦенныхБумаг") Тогда
		
		// начало сделки "торговое" - не делим стоимость и купон
		Если Параметры.СуммаСделкиВВалютеУчета + Параметры.СуммаКупонаВВалютеУчета <> 0
			И Параметры.СуммаТела + Параметры.СуммаКупона <> 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьПокупки) КАК СуммаТела,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СуммаКупона
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|ГДЕ
			|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
			|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала <> &ВалютаСделки
			|	И БухПартииЦенныхБумаг.Организация = &Организация
			|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И БухПартииЦенныхБумаг.Активность
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала";
			
			Запрос.УстановитьПараметр("Регистратор", ОбъектДокумента.Ссылка);
			Запрос.УстановитьПараметр("ВалютаСделки", Параметры.ВалютаСделки);
			Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаСделкиВВалютеУчета + Параметры.СуммаКупонаВВалютеУчета, "Цена сделки");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
				
				Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаДт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = Параметры.СуммаТела + Параметры.СуммаКупона;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
				
				Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаКт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = Параметры.СуммаТела + Параметры.СуммаКупона;
			Иначе
				// сделка с замещающими облигациями
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаСделкиВВалютеУчета + Параметры.СуммаКупонаВВалютеУчета, "Цена сделки");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
					
					Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
					
					Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.ВалютаНоминала;
					Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.СуммаТела + ВыборкаДетальныеЗаписи.СуммаКупона;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
					
					Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
					Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
					
					Проводка.ВалютаКт  = Параметры.ВалютаСделки;
					Проводка.ВалютнаяСуммаКт = Параметры.СуммаТела + Параметры.СуммаКупона;
				КонецЦикла;
				
			КонецЕсли;
		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПогашениеЦеннойБумаги")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.СписаниеЦеннойБумаги")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Оплата") Тогда
		
		ДелатьПроводкуНачалаСделки = 
			Параметры.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408
			ИЛИ Параметры.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
			
		ДелатьПроводкуПереброски = 
			Параметры.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
		
		ДелатьПроводкуНачалаСделкиКупон = ДелатьПроводкуНачалаСделки И Параметры.НастройкиУчета.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации;
		
		ДелатьПроводкуПереброскиКупон = ДелатьПроводкуПереброски И Параметры.НастройкиУчета.ВключатьКупонВСуммуРеализацииПриПолномПогашенииОблигации; 
		
		// начало сделки "погашенческое" - не делим стоимость и купон
		Если Параметры.СуммаСделкиВВалютеУчета <> 0 И Параметры.СуммаТела <> 0 И ДелатьПроводкуНачалаСделки Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаСделкиВВалютеУчета, "Цена сделки");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
			
			Проводка.ВалютаДт  = Параметры.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = Параметры.СуммаТела;
			
			Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
			
			Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
			
			Проводка.ВалютаКт  = Параметры.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = Параметры.СуммаТела;

			Если ДелатьПроводкуПереброски Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаСделкиВВалютеУчета, "Задолженность");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаДт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = Параметры.СуммаТела;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
				
				Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаКт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = Параметры.СуммаТела;
				
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
			
			КонецЕсли;	
			
		КонецЕсли;
		
		Если Параметры.СуммаКупонаВВалютеУчета <> 0 И Параметры.СуммаКупона <> 0 И ДелатьПроводкуНачалаСделкиКупон Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаКупонаВВалютеУчета, "Цена сделки");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
			
			Проводка.ВалютаДт  = Параметры.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = Параметры.СуммаКупона;
			
			Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
			
			Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
			
			Проводка.ВалютаКт  = Параметры.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = Параметры.СуммаКупона;

			Если ДелатьПроводкуПереброскиКупон Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], Параметры.СуммаКупонаВВалютеУчета, "Задолженность");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаДт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = Параметры.СуммаКупона;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
				
				Проводка.СубконтоКт.Контрагенты = Параметры.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов = Параметры.Сделка;
				
				Проводка.ВалютаКт  = Параметры.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = Параметры.СуммаКупона;
				
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
			
		КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьПроводкиНачалаСделки(ОбъектДокумента, Движения, Регистратор, ДанныеПроводок)

	ДелатьПроводкуНачалаСделки = 
		ДанныеПроводок.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47408
		ИЛИ ДанныеПроводок.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;

	ДелатьПроводкуПереброски = 
		ДанныеПроводок.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423;
		
	Если ДелатьПроводкуНачалаСделки Тогда
	
		// Создадим проводки "начала сделки"
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, ДанныеПроводок.НоминальнаяСуммаВВалютеУчета, "Цена сделки");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
		
		Проводка.СубконтоДт.Контрагенты = ДанныеПроводок.Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = Регистратор;
		
		Проводка.ВалютаДт  = ДанныеПроводок.ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = ДанныеПроводок.НоминальнаяСумма;
		
		Проводка.ДополнительнаяАналитикаДт = ДанныеПроводок.Аналитика;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
		
		Проводка.СубконтоКт.Контрагенты = ДанныеПроводок.Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = Регистратор;
		
		Проводка.ВалютаКт  = ДанныеПроводок.ВалютаНоминала;
		Проводка.ВалютнаяСуммаКт = ДанныеПроводок.НоминальнаяСумма;
		
		Проводка.ДополнительнаяАналитикаКт = ДанныеПроводок.Аналитика;

		Если ДелатьПроводкуПереброски Тогда
			
			// перекурсовываем 47408 до фактической суммы платежа
			Если ДанныеПроводок.ВалютаНоминала <> ДанныеПроводок.ВалютаУчета И ДанныеПроводок.СуммаОплатыВВалютеУчета <> ДанныеПроводок.НоминальнаяСуммаВВалютеУчета Тогда
			
				Если ДанныеПроводок.НоминальнаяСуммаВВалютеУчета > ДанныеПроводок.СуммаОплатыВВалютеУчета Тогда
					
					СуммаПерекурсовки = ДанныеПроводок.НоминальнаяСуммаВВалютеУчета - ДанныеПроводок.СуммаОплатыВВалютеУчета;
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СуммаПерекурсовки, "Перекурсовка задолженности");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
					
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетДт, ДанныеПроводок.ВалютаНоминала, Истина);
					Проводка.СубконтоДт.ЦенныеБумаги = ДанныеПроводок.Облигация;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
					
					Проводка.СубконтоКт.Контрагенты = ДанныеПроводок.Контрагент;
					Проводка.СубконтоКт.ОснованиеРасчетов = Регистратор;
					
					Проводка.ВалютаКт  = ДанныеПроводок.ВалютаНоминала;
					
					Проводка.ДополнительнаяАналитикаКт = ДанныеПроводок.Аналитика;
				
				ИначеЕсли ДанныеПроводок.НоминальнаяСуммаВВалютеУчета < ДанныеПроводок.СуммаОплатыВВалютеУчета Тогда
					
					СуммаПерекурсовки = -(ДанныеПроводок.НоминальнаяСуммаВВалютеУчета - ДанныеПроводок.СуммаОплатыВВалютеУчета);
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СуммаПерекурсовки, "Перекурсовка задолженности");
					
					// дебет
					Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
					
					Проводка.СубконтоДт.Контрагенты = ДанныеПроводок.Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = Регистратор;
					
					Проводка.ВалютаДт  = ДанныеПроводок.ВалютаНоминала;
					
					Проводка.ДополнительнаяАналитикаДт = ДанныеПроводок.Аналитика;
					
					// кредит
					Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
					
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетКт, ДанныеПроводок.ВалютаНоминала, Истина);
					Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПроводок.Облигация;
					
				КонецЕсли;
			
			КонецЕсли;
			
			// для Будущего переносим только то, что не оплачено!
			Если ДанныеПроводок.УчитыватьПрошедшиеПлатежи И ДанныеПроводок.БылиПлатежи Тогда
				СуммаПереносаЗадолженности = ДанныеПроводок.НоминальнаяСумма - ДанныеПроводок.СуммаОплаты;
				СуммаПереносаЗадолженностиВВалютеУчета = ДанныеПроводок.НоминальнаяСуммаВВалютеУчета - ДанныеПроводок.СуммаОплатыВВалютеУчета;
				НоминальнаяСуммаПереносаЗадолженности = СуммаПереносаЗадолженности;
			Иначе
				СуммаПереносаЗадолженности = ДанныеПроводок.СуммаОплаты;
				СуммаПереносаЗадолженностиВВалютеУчета = ДанныеПроводок.СуммаОплатыВВалютеУчета;
				НоминальнаяСуммаПереносаЗадолженности = ДанныеПроводок.НоминальнаяСумма;
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереносаЗадолженностиВВалютеУчета, "Задолженность");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
			
			Проводка.СубконтоДт.Контрагенты = ДанныеПроводок.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = Регистратор;
			
			Проводка.ВалютаДт  = ДанныеПроводок.ВалютаОплаты;
			Проводка.ВалютнаяСуммаДт = СуммаПереносаЗадолженности;
			
			Проводка.ДополнительнаяАналитикаДт = ДанныеПроводок.Аналитика;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.Расчеты08;
			
			Проводка.СубконтоКт.Контрагенты = ДанныеПроводок.Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = Регистратор;
			
			Проводка.ВалютаКт  = ДанныеПроводок.ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = НоминальнаяСуммаПереносаЗадолженности;
			
			Проводка.ДополнительнаяАналитикаКт = ДанныеПроводок.Аналитика;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	// Создадим задолженность по погашению
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, Движения.ЕдиныйБухгалтерскийУчет, ДанныеПроводок.НоминальнаяСуммаВВалютеУчета, "Погашение ценной бумаги");

	// дебет
	Если ДанныеПроводок.НастройкиУчета.ВариантОтраженияЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияЗадолженностиПриПолномПогашении.НаСчете47423БезСчетов47407и47408 Тогда
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
	Иначе	
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты07;
	КонецЕсли;
	
	Проводка.СубконтоДт.Контрагенты = ДанныеПроводок.Контрагент;
	Проводка.СубконтоДт.ОснованиеРасчетов = Регистратор;
	
	Проводка.ВалютаДт  = ДанныеПроводок.ВалютаНоминала;
	Проводка.ВалютнаяСуммаДт = ДанныеПроводок.НоминальнаяСумма;
	
	Проводка.ДополнительнаяАналитикаДт = ДанныеПроводок.Аналитика;
	
	// кредит
	Проводка.СчетКт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		
	Проводка.СубконтоКт.ЦенныеБумаги = ДанныеПроводок.Облигация;
	Проводка.СубконтоКт.ОснованиеРасчетов = Регистратор;
	
	// количество только по телу, не по купону
	Если ДанныеПроводок.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела  Тогда
		Проводка.КоличествоКт = ДанныеПроводок.Количество;	
	КонецЕсли;

КонецПроцедуры

Процедура ПризнатьКомиссиюПоРЕПО(ОбъектДокумента, ПерваяЧастьРЕПО, Контрагент, КонтрагентПоКомиссии, Закрывать7ойРазделПриПоступленииДенежныхСредств) Экспорт

	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);

	// Итак, тут сделано проведение по "правильной" схеме, до 1.1.18 все проведене было не очень правильно (мягко говоря).
	// По большинству клиентов 18й год проводили, но были и такие по которым только с февраля провели
	// К сожалению эта периодичность тут не зашита
	// Проведение этого документа ранее 1.1.18 меняет проводки, и Таня К.(и остальные бухгалтера) в курсе
	// 
	// С 1го марта 18го схема опять изменилась, но это уже тут учитывается
	
	// Комиссия брокера
	ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;
	
	// ГПБ ведет себя аналогично бирже - начисляет комиссию 1 раз и сразу поэтому ее тоже размазываем
	//
	// БК до 1.3.18 ведет себя "плохо" (и это реализовано в следующем блоке)
	// но с 1.3.18 начинает вести себя "хорошо", как ГПБ
	
	Если ПерваяЧастьРЕПО.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") // для ГПБ тоже размазываем
		ИЛИ ОбъектДокумента.Дата > '20180402' // со 2го апреля и БК размазываем по всем
		ИЛИ (ОбъектДокумента.Дата > '20180303' // с 3го марта и БК размазываем по всем кроме традиций и нг пр
			И СокрЛП(ОбъектДокумента.СчетДоверительногоУправления.КодСчета) <> "DU_PR_RN_001"
			И СокрЛП(ОбъектДокумента.СчетДоверительногоУправления.КодСчета) <> "DU_UL_PR_24"
			И СокрЛП(ОбъектДокумента.СчетДоверительногоУправления.КодСчета) <> "DU_NPF037")
		Тогда  // для остальных с 1го марта - тоже, как хотелось, но БК в 1-2 марта опять неправильно сделал...
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК СуммаКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК ОстатокОплаченоКомиссии,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК НачислитьКомиссии,
			|	РасходыПоСделке.Валюта КАК Валюта
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			,
			|			&Период,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Сделка = &СделкаРЕПО
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделке
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&Период,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства19),
			|				&ВидыСубконто,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Валюта = &Валюта
			|					И Субконто1 = &СделкаРЕПО
			|					И ЛицевойСчет.ДополнительнаяАналитика = &ДополнительнаяАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ПО РасходыПоСделке.Сделка = ЕдиныйБухгалтерскийУчетОстатки.Субконто1";
		
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
		
		Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
		Запрос.УстановитьПараметр("ДополнительнаяАналитика", ДополнительнаяАналитика);
		Запрос.УстановитьПараметр("Период", ?(ТипЗнч(ОбъектДокумента) = ТИП("ДокументОбъект.Оплата"),Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Включая), Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая)));			
		
		Запрос.УстановитьПараметр("СделкаРЕПО", ПерваяЧастьРЕПО);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Валюта", ПерваяЧастьРЕПО.ВалютаСделки);
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
			СуммаКомисии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
			ВалютаКомисии = ВыборкаДетальныеЗаписи.Валюта;
			
			ЦеннаяБумага = ПерваяЧастьРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомисии, ПерваяЧастьРЕПО.ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
			
			ПроводкиПризнанияКомиссииПоРЕПО(ОбъектДокумента, ПерваяЧастьРЕПО, СуммаОперации, СуммаКомисии, ВалютаКомисии, УчетныйАктив, ЦеннаяБумага, Контрагент, КонтрагентПоКомиссии, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств);
			
		КонецЕсли;
		
	ИначеЕсли ОбъектДокумента.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда // брокер БК
		
		//если предыдущий день нерабочий - берем, что было оплачено сегодня
		
		// теущий день тоже считаем, поэтому -2 
		ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ОбъектДокумента.Дата), -2);
		Если НачалоДня(ПредыдущийРабочийДень) <> (НачалоДня(ОбъектДокумента.Дата) - 86400) Тогда
		
			НачалоПериода = НачалоДня(ОбъектДокумента.Дата);
			КонецПериода = КонецДня(ОбъектДокумента.Дата);
			
		//иначе - берем, что было оплачено вчера
		Иначе
		
			НачалоПериода = НачалоДня(ОбъектДокумента.Дата) - 86400;
			КонецПериода = КонецДня(ОбъектДокумента.Дата) - 86400;
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК Комиссия,
			|	РасходыПоСделке.Валюта КАК Валюта
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Сделка = &СделкаРЕПО
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделке";
		
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			
		Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
		Запрос.УстановитьПараметр("СделкаРЕПО", ПерваяЧастьРЕПО);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
			СуммаКомисии = ВыборкаДетальныеЗаписи.Комиссия;
			ВалютаКомисии = ВыборкаДетальныеЗаписи.Валюта;
			
			ЦеннаяБумага = ПерваяЧастьРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомисии, ПерваяЧастьРЕПО.ВалютаСделки, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
			
			ПроводкиПризнанияКомиссииПоРЕПО(ОбъектДокумента, ПерваяЧастьРЕПО, СуммаОперации, СуммаКомисии, ВалютаКомисии, УчетныйАктив, ЦеннаяБумага, Контрагент, КонтрагентПоКомиссии, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств);
			
		КонецЕсли;
		
	Иначе
		
		Возврат;
	
	КонецЕсли;

КонецПроцедуры
	
Процедура ПроводкиПризнанияКомиссииПоРЕПО(ОбъектДокумента, ПерваяЧастьРЕПО, СуммаОперации, СуммаКомисии, ВалютаКомиссии, УчетныйАктив, ЦеннаяБумага, Контрагент, КонтрагентПоКомиссии, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств) Экспорт

	ПризнаватьКомиссию = Истина;
	
	Если ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия Тогда
	
		ОписаниеПроводкиНачисления = "Начисление торговой комиссия";
		ОписаниеПроводкиПризнания = "Признание торговой комиссия";
		ОписаниеПроводкиЗакрытия = "Торговая комиссия закрытие расхода";
		
	ИначеЕсли ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера Тогда
		
		ОписаниеПроводкиНачисления = "Начисление брокерской комиссия";
		ОписаниеПроводкиПризнания = "Признание брокерской комиссия";
		ОписаниеПроводкиЗакрытия = "Комиссия брокера закрытие расхода";
		
		
		// Хардкорд для ППА, еще 1 хардкод в модуле БухгалтерскийУчет 
		Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.СделкаРЕПО") Тогда
			
			Если ОбъектДокумента.ЧастьСделкиРЕПО = 2 Тогда
			
				МассивСчетовППА = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																							ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ППА"),
																							ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																							ОбъектДокумента.Дата);
				
				ЭтоКлиентППА = (МассивСчетовППА.Найти(ОбъектДокумента.СчетДоверительногоУправления) <> Неопределено);
				
				Если ЭтоКлиентППА И ПерваяЧастьРЕПО.Дата >= '20200622' И ПерваяЧастьРЕПО.Дата < '20200701' Тогда
					
					ПризнаватьКомиссию = Ложь;
					
					Если СуммаКомисии = 0 Тогда // нам она нужна для закрытия 7ого раздела
					
						Запрос = Новый Запрос;
						Запрос.Текст = 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	РасходыПоСделке.СуммаОборот КАК СуммаКомиссии,
							|	РасходыПоСделке.Валюта КАК Валюта
							|ИЗ
							|	РегистрНакопления.РасходыПоСделке.Обороты(
							|			,
							|			&КонецДня,
							|			Период,
							|			Организация = &Организация
							|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
							|				И Сделка = &СделкаРЕПО
							|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоСделке";
						
						Запрос.УстановитьПараметр("КонецДня", КонецДня(ОбъектДокумента.Дата));
						Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
						Запрос.УстановитьПараметр("СделкаРЕПО", ПерваяЧастьРЕПО);
						Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
						
						ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
						
						Если ВыборкаДетальныеЗаписи.Следующий() Тогда
						
							СуммаКомиссии = ВыборкаДетальныеЗаписи.СуммаКомиссии;
							СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.Валюта, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
						
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
		
		КонецЕсли;
		// конец хардкода
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если ЭтоКлиентГруппыБудущее(ОбъектДокумента.СчетДоверительногоУправления, ОбъектДокумента.Дата)	И ОбъектДокумента.Дата > '20230101' Тогда
	
		ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоКомиссии, ОбъектДокумента.Дата);
		
	Иначе
		ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(Контрагент, ОбъектДокумента.Дата);
	КонецЕсли;
	
	Если ПризнаватьКомиссию Тогда
	
		// ПРИЗНАНИЕ КОМИССИИ
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиНачисления);
		
		// дебет
		Если ПерваяЧастьРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы03;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеРасходы02;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам(Контрагент, ОбъектДокумента.Дата);
		КонецЕсли;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		// кредит
		Если ПерваяЧастьРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства18;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
		КонецЕсли;	
		
		Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПерваяЧастьРЕПО;
		
		Проводка.ВалютаКт = ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт = СуммаКомисии;
		
		// СВЕРНЕМ 18 и 19
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиПризнания);
		
		// дебет
		Если ПерваяЧастьРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства18;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
		КонецЕсли;	
		
		Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
		Проводка.СубконтоДт.ОснованиеРасчетов = ПерваяЧастьРЕПО;
		
		Проводка.ВалютаДт = ВалютаКомиссии;
		Проводка.ВалютнаяСуммаДт = СуммаКомисии;
		
		// кредит
		Если ПерваяЧастьРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства19;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19;
		КонецЕсли;	
		
		Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПерваяЧастьРЕПО;
		
		Проводка.ВалютаКт = ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт = СуммаКомисии;
		Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитика;
	
	КонецЕсли;
	
	// ЗАКРЫТИЕ РАСХОДОВ ПО ТОРГОВОЙ КОМИССИИ НА АКТИВЫ В ДУ
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиЗакрытия);
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
		
		// кредит
		Если ПерваяЧастьРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы03;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеРасходы02;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам(Контрагент, ОбъектДокумента.Дата);
		КонецЕсли;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
	
	КонецЕсли; 

КонецПроцедуры

Процедура ЗачестьНачисленныеИПолученныеПроцентыПоДепозитнымВкладам(ОбъектДокумента, Закрывать7ойРазделПриПоступленииДенежныхСредств) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Записать();
	ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Прочитать();
	ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	//возможно, условие для других вариантом выплаты процентов тоже актуально, но пока оставлю так.
	//свернуть 20603 и 20613
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	БухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03)
		|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК ДепозитныйВклад
		|					ИЗ
		|						РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&Период, КредитныйИнструмент В
		|							(ВЫБРАТЬ
		|								ПереоценкаДепозитныхВкладовДепозитныеВклады.КредитныйИнструмент КАК ДепозитныйВклад
		|							ИЗ
		|								Документ.ПереоценкаКредитныхИнструментов.КредитныеИнструменты КАК ПереоценкаДепозитныхВкладовДепозитныеВклады
		|							ГДЕ
		|								ПереоценкаДепозитныхВкладовДепозитныеВклады.Ссылка = &Ссылка
		|								И ТИПЗНАЧЕНИЯ(ПереоценкаДепозитныхВкладовДепозитныеВклады.КредитныйИнструмент) = ТИП(Справочник.ДепозитныеВклады))) КАК УсловияКредитныхИнструментовСрезПоследних
		|					ГДЕ
		|						УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов = &Авансом)) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Остатки03.Субконто1 КАК ДепозитныйВклад,
		|	_Остатки03.СуммаОстатокДт КАК НачисленныеПроценты,
		|	_Остатки03.ВалютнаяСуммаОстатокДт КАК НачисленныеПроцентыВал,
		|	_Остатки13.СуммаОстатокКт КАК ПолученныеПроценты,
		|	_Остатки13.ВалютнаяСуммаОстатокКт КАК ПолученныеПроцентыВал,
		|	УсловияКредитныхИнструментовСрезПоследних.УчетныйАктив КАК УчетныйАктив
		|ИЗ
		|	_Остатки КАК _Остатки03
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Остатки КАК _Остатки13
		|		ПО _Остатки03.Субконто1 = _Остатки13.Субконто1
		|			И (_Остатки03.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03))
		|			И (_Остатки13.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&ПериодДата, ) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО _Остатки03.Субконто1 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент";

	Запрос.УстановитьПараметр("Организация",                  	ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("Период",                       	Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Авансом",			  			Перечисления.ПериодичностиВыплатыПроцентов.Авансом);
	Запрос.УстановитьПараметр("Ссылка",			  				ОбъектДокумента.Ссылка);
	Запрос.УстановитьПараметр("ПериодДата",                    	ОбъектДокумента.Дата);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекущийДепозит = ВыборкаДетальныеЗаписи.ДепозитныйВклад;
		УчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктив;
		СуммаЗакрытия = Мин(ВыборкаДетальныеЗаписи.ПолученныеПроценты, ВыборкаДетальныеЗаписи.НачисленныеПроценты);
		СуммаЗакрытияВал = Мин(ВыборкаДетальныеЗаписи.ПолученныеПроцентыВал, ВыборкаДетальныеЗаписи.НачисленныеПроцентыВал);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаЗакрытия, "Закрытие полученных процентов по депозитному вкладу");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.Депозиты13;
		Проводка.СубконтоДт.БанковскиеСчета = ТекущийДепозит.БанковскийСчет;
		Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ТекущийДепозит;
		Проводка.ВалютаДт  = ТекущийДепозит.БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаДт = СуммаЗакрытияВал;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоКт.Контрагенты = ТекущийДепозит.БанковскийСчет.Банк.ЮрФизЛицо;
		Проводка.СубконтоКт.УсловияЗаймовКредитовИДепозитов = ТекущийДепозит;
		Проводка.ВалютаКт  = ТекущийДепозит.БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаКт = СуммаЗакрытияВал;
		
		Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаЗакрытия, "Закрытие полученных процентов по депозитному вкладу");
			
			// дебет
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги = ТекущийДепозит;
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьДвиженияДокументаПоПарнымСчетам(ОбъектДокумента, Отказ) Экспорт
	
	НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ОбъектДокумента.Дата,
			ОбъектДокумента.Организация,
			ОбъектДокумента.СчетДоверительногоУправления,
			"НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки");
			
	НеСворачиватьПоПарнымСчетамПереоценкуЦенныхБумаг = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ОбъектДокумента.Дата,
			ОбъектДокумента.Организация,
			ОбъектДокумента.СчетДоверительногоУправления,
			"НеСворачиватьПоПарнымСчетамПереоценкуЦенныхБумаг");
			
			
	Если НеСворачиватьПоПарнымСчетамПереоценкуЦенныхБумаг Тогда
				
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА КАК СчетУчетаПереоценки
			|ПОМЕСТИТЬ _СчетаПереоценки
			|ИЗ
			|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|ГДЕ
			|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП
			|ИЗ
			|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|ГДЕ
			|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	_СчетаПереоценки.СчетУчетаПереоценки КАК СчетУчетаПереоценки
			|ИЗ
			|	_СчетаПереоценки КАК _СчетаПереоценки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Единый КАК Единый
			|		ПО _СчетаПереоценки.СчетУчетаПереоценки = Единый.Ссылка
			|ГДЕ
			|	Единый.Код ПОДОБНО ""5%""";
		
		МассивСчетовПереоценки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетУчетаПереоценки");
		
	КонецЕсли;
	
	ДанныеПарныхСчетов = Кэширование.ПолучитьДанныеПарныхСчетов();
	
	
	//#381119 - учет фьючерсов решение проблемы с парными. Счета 47407 и 47408 вообще говоря парные (Света М. присылала выдержку из нормативки) 
	//Но, у документов сделка Т0 и исполнение первая проводка идет Дт 47408 Кт 47407 и это тоже норма, хотя и возникает сальдо по парным
	//Поэтому мы эти счета и не внесли в регистр парных
	//Но по фьючерсам эти 2 счета должны сворачиваться и пришлось добавить параметр ОбработатьСчета47407и47408 в ОбработатьДвиженияДокументаПоПарнымСчетам
	Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Маржа")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ПереоценкаСрочныхКонтрактов") Тогда
		
		ДанныеПарныхСчетов.ПарныеСчетаА.Добавить(ПланыСчетов.Единый.Расчеты08);
		ДанныеПарныхСчетов.ПарныеСчетаП.Добавить(ПланыСчетов.Единый.Расчеты07);
		
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ИсполнениеОбязательствПоСделке")
		ИЛИ ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Сделка") Тогда
		
		Если ОбъектДокумента.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
		
			ДанныеПарныхСчетов.ПарныеСчетаА.Добавить(ПланыСчетов.Единый.Расчеты08);
			ДанныеПарныхСчетов.ПарныеСчетаП.Добавить(ПланыСчетов.Единый.Расчеты07);
		
		КонецЕсли;
		
	КонецЕсли;
	
	
	СписокТиповСубконто = РаботаСМетаданнымиПовтИсп.ПолучитьСписокТиповСубконто();
	
	ТаблицаПарныхСчетов = Новый ТаблицаЗначений;
	
	ТаблицаПарныхСчетов.Колонки.Добавить("СчетА",					Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	ТаблицаПарныхСчетов.Колонки.Добавить("СчетП",					Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	ТаблицаПарныхСчетов.Колонки.Добавить("Субконто1",				Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаПарныхСчетов.Колонки.Добавить("Субконто2",				Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаПарныхСчетов.Колонки.Добавить("Субконто3",				Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаПарныхСчетов.Колонки.Добавить("ДополнительнаяАналитика",	Новый ОписаниеТипов("СправочникСсылка.ДополнительныеАналитикиЛицевыхСчетов"));
	ТаблицаПарныхСчетов.Колонки.Добавить("Валюта",					Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Для каждого ДвижениеЕПС Из ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет Цикл
		
		// по дебету
		ИндексА = ДанныеПарныхСчетов.ПарныеСчетаА.Найти(ДвижениеЕПС.СчетДт);
		ИндексП = ДанныеПарныхСчетов.ПарныеСчетаП.Найти(ДвижениеЕПС.СчетДт);
		
		Если (ДвижениеЕПС.СчетДт.Вид = ВидСчета.Активный И ИндексА <> Неопределено)
			ИЛИ (ДвижениеЕПС.СчетДт.Вид = ВидСчета.Пассивный И ИндексП <> Неопределено) Тогда
			
			СтрокаТаблицыПарныхСчетов = ТаблицаПарныхСчетов.Добавить();
			
			Если ДвижениеЕПС.СчетДт.Вид = ВидСчета.Активный Тогда
				СтрокаТаблицыПарныхСчетов.СчетА = ДвижениеЕПС.СчетДт;
				СтрокаТаблицыПарныхСчетов.СчетП = ДанныеПарныхСчетов.ПарныеСчетаП[ИндексА];
			Иначе
				СтрокаТаблицыПарныхСчетов.СчетА = ДанныеПарныхСчетов.ПарныеСчетаА[ИндексП];
				СтрокаТаблицыПарныхСчетов.СчетП = ДвижениеЕПС.СчетДт;
			КонецЕсли;
			
			Для каждого СтрокаВидыСубконто Из ДвижениеЕПС.СчетДт.ВидыСубконто Цикл
				СтрокаТаблицыПарныхСчетов["Субконто" + Строка(СтрокаВидыСубконто.НомерСтроки)] = ДвижениеЕПС["СубконтоДт"][СтрокаВидыСубконто.ВидСубконто];
			КонецЦикла;
			
			СтрокаТаблицыПарныхСчетов.ДополнительнаяАналитика = ДвижениеЕПС.ДополнительнаяАналитикаДт;
			СтрокаТаблицыПарныхСчетов.Валюта = ДвижениеЕПС.ВалютаДт;
			
		КонецЕсли;
		
		// по кредиту
		ИндексА = ДанныеПарныхСчетов.ПарныеСчетаА.Найти(ДвижениеЕПС.СчетКт);
		ИндексП = ДанныеПарныхСчетов.ПарныеСчетаП.Найти(ДвижениеЕПС.СчетКт);
		
		Если (ДвижениеЕПС.СчетКт.Вид = ВидСчета.Активный И ИндексА <> Неопределено)
			ИЛИ (ДвижениеЕПС.СчетКт.Вид = ВидСчета.Пассивный И ИндексП <> Неопределено) Тогда
			
			СтрокаТаблицыПарныхСчетов = ТаблицаПарныхСчетов.Добавить();
			
			Если ДвижениеЕПС.СчетКт.Вид = ВидСчета.Активный Тогда
				СтрокаТаблицыПарныхСчетов.СчетА = ДвижениеЕПС.СчетКт;
				СтрокаТаблицыПарныхСчетов.СчетП = ДанныеПарныхСчетов.ПарныеСчетаП[ИндексА];
			Иначе
				СтрокаТаблицыПарныхСчетов.СчетА = ДанныеПарныхСчетов.ПарныеСчетаА[ИндексП];
				СтрокаТаблицыПарныхСчетов.СчетП = ДвижениеЕПС.СчетКт;
			КонецЕсли;
			
			Для каждого СтрокаВидыСубконто Из ДвижениеЕПС.СчетКт.ВидыСубконто Цикл
				СтрокаТаблицыПарныхСчетов["Субконто" + Строка(СтрокаВидыСубконто.НомерСтроки)] = ДвижениеЕПС["СубконтоКт"][СтрокаВидыСубконто.ВидСубконто];
			КонецЦикла;
			
			СтрокаТаблицыПарныхСчетов.ДополнительнаяАналитика = ДвижениеЕПС.ДополнительнаяАналитикаКт;
			СтрокаТаблицыПарныхСчетов.Валюта = ДвижениеЕПС.ВалютаКт;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПарныеСчета = ТаблицаПарныхСчетов.Скопировать(, "СчетА, СчетП");
	ПарныеСчета.Свернуть("СчетА, СчетП");
		
	ГруппыСчетовПоСубконто = Новый Соответствие;
	// элементы коллекции ГруппыСчетовПоСубконто в ключе содержат массив счетов, в значении - структуру, содержащую массив субконто, а также таблицу остатков по счетам в массиве
	Для каждого СтрокаПарныхСчетов Из ПарныеСчета Цикл
		СчетДобавлен = Ложь;
		Для каждого ГруппаСчетов Из ГруппыСчетовПоСубконто Цикл
			МассивСубконто = СтрокаПарныхСчетов.СчетА.ВидыСубконто.ВыгрузитьКолонку("ВидСубконто");
			КоличествоСубконто = МассивСубконто.Количество();
			КоличествоНайдено = 0;
			Если ГруппаСчетов.Значение.МассивСубконто.Количество() = КоличествоСубконто Тогда
				Для каждого Субконто Из МассивСубконто Цикл
					Если НЕ ГруппаСчетов.Значение.МассивСубконто.Найти(Субконто) = Неопределено Тогда
						КоличествоНайдено = КоличествоНайдено + 1;
					КонецЕсли; 
				КонецЦикла; 
			КонецЕсли; 
			Если КоличествоНайдено = КоличествоСубконто Тогда
				ГруппаСчетов.Ключ.Добавить(СтрокаПарныхСчетов.СчетА);
				ГруппаСчетов.Ключ.Добавить(СтрокаПарныхСчетов.СчетП);
				СчетДобавлен = Истина;
			КонецЕсли; 
		КонецЦикла; 
		Если НЕ СчетДобавлен Тогда
			МассивСчетов = Новый Массив;
			МассивСчетов.Добавить(СтрокаПарныхСчетов.СчетА);
			МассивСчетов.Добавить(СтрокаПарныхСчетов.СчетП);
			СтруктураПараметров = Новый Структура("МассивСубконто, ТаблицаОстатков", СтрокаПарныхСчетов.СчетА.ВидыСубконто.ВыгрузитьКолонку("ВидСубконто"), Неопределено);
			ГруппыСчетовПоСубконто.Вставить(МассивСчетов, СтруктураПараметров);
		КонецЕсли; 
	КонецЦикла; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_ТаблицаПарныхСчетов.СчетА КАК СчетА,
	|	_ТаблицаПарныхСчетов.СчетП КАК СчетП,
	|	_ТаблицаПарныхСчетов.Субконто1 КАК Субконто1,
	|	_ТаблицаПарныхСчетов.Субконто2 КАК Субконто2,
	|	_ТаблицаПарныхСчетов.Субконто3 КАК Субконто3,
	|	_ТаблицаПарныхСчетов.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
	|	_ТаблицаПарныхСчетов.Валюта КАК Валюта
	|ПОМЕСТИТЬ _ТаблицаПарныхСчетов
	|ИЗ
	|	&ТаблицаПарныхСчетов КАК _ТаблицаПарныхСчетов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетА,
	|	СчетП,
	|	ДополнительнаяАналитика,
	|	Субконто3,
	|	Субконто2,
	|	Субконто1";
	Запрос.УстановитьПараметр("ТаблицаПарныхСчетов", ТаблицаПарныхСчетов);
	Запрос.Выполнить();
	
	// получаем остатки по группам счетов с одинаковой аналитикой
	Для каждого ГруппаСчетов Из ГруппыСчетовПоСубконто Цикл
		
		ТекстЗапроса =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	&ВыборСубконто КАК Субконто,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток) КАК СуммаОстаток,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика
		|ПОМЕСТИТЬ _ОстаткиПредварительные
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (&МассивСчетов),
		|			&МассивСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Счет,
		|	&ИндексСубконто
		|	ДополнительнаяАналитика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиПредварительные.Счет КАК Счет,
		|	&ВыборИзОстаткиСубконто КАК Субконто,
		|	ОстаткиПредварительные.СуммаОстаток КАК СуммаОстаток,
		|	ОстаткиПредварительные.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ОстаткиПредварительные.ДополнительнаяАналитика КАК ДополнительнаяАналитика
		|ПОМЕСТИТЬ _Остатки
		|ИЗ	
		|	_ОстаткиПредварительные КАК ОстаткиПредварительные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПарныхСчетов КАК _ТаблицаПарныхСчетов
		|		ПО (ОстаткиПредварительные.Счет = _ТаблицаПарныхСчетов.СчетА
		|			ИЛИ ОстаткиПредварительные.Счет = _ТаблицаПарныхСчетов.СчетП)
		|		И (_ТаблицаПарныхСчетов.ДополнительнаяАналитика = ОстаткиПредварительные.ДополнительнаяАналитика)
		|		&ОтборСубконто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПарныхСчетов.СчетА,
		|	_ТаблицаПарныхСчетов.СчетП,
		|	ЕСТЬNULL(_ТаблицаПарныхСчетов.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
		|	ЕСТЬNULL(_ТаблицаПарныхСчетов.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|	ЕСТЬNULL(_ТаблицаПарныхСчетов.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|	ЕСТЬNULL(_ТаблицаПарныхСчетов.ДополнительнаяАналитика, НЕОПРЕДЕЛЕНО) КАК ДополнительнаяАналитика,
		|	ЕСТЬNULL(_ОстаткиА.СуммаОстаток, 0) КАК СуммаОстатокА,
		|	ЕСТЬNULL(_ОстаткиА.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокА,
		|	-ЕСТЬNULL(_ОстаткиП.СуммаОстаток, 0) КАК СуммаОстатокП,
		|	-ЕСТЬNULL(_ОстаткиП.ВалютнаяСуммаОстаток, 0) КАК ВалютнаяСуммаОстатокП
		|ИЗ
		|	_ТаблицаПарныхСчетов КАК _ТаблицаПарныхСчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Остатки КАК _ОстаткиА
		|		ПО _ТаблицаПарныхСчетов.СчетА = _ОстаткиА.Счет
		|			И (&УсловиеСубконтоА)
		|			И _ТаблицаПарныхСчетов.ДополнительнаяАналитика = _ОстаткиА.ДополнительнаяАналитика
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Остатки КАК _ОстаткиП
		|		ПО _ТаблицаПарныхСчетов.СчетП = _ОстаткиП.Счет
		|			И (&УсловиеСубконтоП)
		|			И _ТаблицаПарныхСчетов.ДополнительнаяАналитика = _ОстаткиП.ДополнительнаяАналитика";
	
		Запрос.УстановитьПараметр("Период", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
		
		Запрос.УстановитьПараметр("МассивСчетов", ГруппаСчетов.Ключ);
		Запрос.УстановитьПараметр("МассивСубконто", ГруппаСчетов.Значение.МассивСубконто);
		НомерСубконто = 1;
		УсловиеСубконто = "";
		ВыборСубконто = "";
		ВыборИзОстаткиСубконто = "";
		ОтборСубконто = "";
		ИндексСубконто = "";
		//ВложенныйЗапросСубконто = "";
		ГруппировкаСубконто = "ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика, ";
		
		Для каждого Субконто Из ГруппаСчетов.Значение.МассивСубконто Цикл
			
			ИндексСубконто = ИндексСубконто + "Субконто" + НомерСубконто + ",";
			
			ВыборСубконто = ВыборСубконто + "ЕдиныйБухгалтерскийУчетОстатки.Субконто" + НомерСубконто + " КАК Субконто" + НомерСубконто + ", 
			|	";

			ВыборИзОстаткиСубконто = ВыборИзОстаткиСубконто + "ОстаткиПредварительные.Субконто" + НомерСубконто + " КАК Субконто" + НомерСубконто + ", 
			|	";
			
			ГруппировкаСубконто = ГруппировкаСубконто + "ЕдиныйБухгалтерскийУчетОстатки.Субконто" + НомерСубконто + ", ";
			
			ОтборСубконто = ОтборСубконто + "И ОстаткиПредварительные.Субконто" + НомерСубконто + " = _ТаблицаПарныхСчетов.Субконто" + НомерСубконто + "  ";
			
			УсловиеСубконто = УсловиеСубконто + ?(НомерСубконто > 1, " И ", "");
			УсловиеСубконто = УсловиеСубконто + "_ТаблицаПарныхСчетов.Субконто" + НомерСубконто + " = _ОстаткиА.Субконто" + НомерСубконто;
			НомерСубконто = НомерСубконто + 1;
			
		КонецЦикла;
		
		ВыборСубконто = ВыборСубконто + "ИСТИНА";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыборСубконто", ВыборСубконто);
		
		ВыборИзОстаткиСубконто = ВыборИзОстаткиСубконто + "ИСТИНА";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыборИзОстаткиСубконто", ВыборИзОстаткиСубконто);
		
		ОтборСубконто = ?(ЗначениеЗаполнено(ОтборСубконто), ОтборСубконто, "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборСубконто", ОтборСубконто);

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика,", ГруппировкаСубконто);
		
		УсловиеСубконто = ?(ЗначениеЗаполнено(УсловиеСубконто), УсловиеСубконто, "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСубконтоА", УсловиеСубконто);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСубконтоП", СтрЗаменить(УсловиеСубконто, "_ОстаткиА", "_ОстаткиП"));
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИндексСубконто", ИндексСубконто);
		
		Запрос.Текст = ТекстЗапроса;
		ГруппаСчетов.Значение.ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
		
		Запрос.Текст = "УНИЧТОЖИТЬ _Остатки; УНИЧТОЖИТЬ _ОстаткиПредварительные";
		Запрос.Выполнить();
		
	КонецЦикла;
		
	Движения = ОбъектДокумента.Движения;
	НаборЗаписей = Движения.ЕдиныйБухгалтерскийУчет;
	ВсегоЗаписей = НаборЗаписей.Количество();
	ТекИндекс = 0;
	
	Для каждого Запись Из НаборЗаписей Цикл
		
		Если ТекИндекс >= ВсегоЗаписей Тогда
			Прервать;
		КонецЕсли;
		ТекИндекс = ТекИндекс + 1;
		
		ПостфиксДт = ?(Запись.СчетДт.Вид = ВидСчета.Активный, "А", "П");
		ПостфиксКт = ?(Запись.СчетДт.Вид = ВидСчета.Активный, "П", "А");
		
		СтрокаТаблицыПарныхСчетов = ПарныеСчета.Найти(Запись.СчетДт, "Счет" + ПостфиксДт);
		Если НЕ СтрокаТаблицыПарныхСчетов = Неопределено Тогда
			
			Если НеСворачиватьПоПарнымСчетамПереоценкуЦенныхБумаг И МассивСчетовПереоценки.Найти(Запись.СчетДт) <> Неопределено Тогда
				ДелатьПроводкуНаРазницу = Истина;
			Иначе
				ДелатьПроводкуНаРазницу = НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки;
			КонецЕсли;
			
			ЗнакОперации = ?(Запись.СчетДт.Вид = ВидСчета.Активный, 1, -1);
			ПараметрыСчетов = Новый Структура("ПостфиксСчета, ПостфиксПарного, ПостфиксОстатка, ПостфиксПарногоОстатка, ДелатьПроводкуНаРазницу", "Дт", "Кт", ПостфиксДт, ПостфиксКт, ДелатьПроводкуНаРазницу);
			ОбработатьЗаписьПарныхСчетов(ГруппыСчетовПоСубконто, ОбъектДокумента, НаборЗаписей, Запись, Запись.СчетДт, Запись.ДополнительнаяАналитикаДт, ПараметрыСчетов, ЗнакОперации, Отказ);
		КонецЕсли; 
		
		ПостфиксДт = ?(Запись.СчетКт.Вид = ВидСчета.Активный, "П", "А");
		ПостфиксКт = ?(Запись.СчетКт.Вид = ВидСчета.Активный, "А", "П");
		
		СтрокаТаблицыПарныхСчетов = ПарныеСчета.Найти(Запись.СчетКт, "Счет" + ПостфиксКт);
		Если НЕ СтрокаТаблицыПарныхСчетов = Неопределено Тогда
			
			Если НеСворачиватьПоПарнымСчетамПереоценкуЦенныхБумаг И МассивСчетовПереоценки.Найти(Запись.СчетКт) <> Неопределено Тогда
				ДелатьПроводкуНаРазницу = Истина;
			Иначе
				ДелатьПроводкуНаРазницу = НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки;
			КонецЕсли;
			
			ЗнакОперации = ?(Запись.СчетКт.Вид = ВидСчета.Пассивный, 1, -1);
			ПараметрыСчетов = Новый Структура("ПостфиксСчета, ПостфиксПарного, ПостфиксОстатка, ПостфиксПарногоОстатка, ДелатьПроводкуНаРазницу", "Кт", "Дт", ПостфиксКт, ПостфиксДт, ДелатьПроводкуНаРазницу);
			ОбработатьЗаписьПарныхСчетов(ГруппыСчетовПоСубконто, ОбъектДокумента, НаборЗаписей, Запись, Запись.СчетКт, Запись.ДополнительнаяАналитикаКт, ПараметрыСчетов, ЗнакОперации, Отказ);
		КонецЕсли; 
		
	КонецЦикла; 
		
КонецПроцедуры

Процедура ОбработатьЗаписьПарныхСчетов(ГруппыСчетовПоСубконто, ОбъектДокумента, НаборЗаписей, Запись, СчетУчета, ДополнительнаяАналитика, ПараметрыСчетов, ЗнакОперации, Отказ)

	ПостфиксСчета = ПараметрыСчетов.ПостфиксСчета;
	ПостфиксПарного = ПараметрыСчетов.ПостфиксПарного;
	ПостфиксОстатка = ПараметрыСчетов.ПостфиксОстатка;
	ПостфиксПарногоОстатка = ПараметрыСчетов.ПостфиксПарногоОстатка;
	ДелатьПроводкуНаРазницу = ПараметрыСчетов.ДелатьПроводкуНаРазницу;
	
	Для каждого ГруппаСчетов Из ГруппыСчетовПоСубконто Цикл
		Если НЕ ГруппаСчетов.Ключ.Найти(СчетУчета) = Неопределено Тогда
			ТаблицаОстатков = ГруппаСчетов.Значение.ТаблицаОстатков;
			Прервать;
		КонецЕсли; 
	КонецЦикла;
	
	СтруктураПоиска = Новый Структура("Счет" + ПостфиксОстатка + ", ДополнительнаяАналитика", 
			СчетУчета, ДополнительнаяАналитика);
			
	НомерСубконто = 1;
	Для каждого Субконто Из ГруппаСчетов.Значение.МассивСубконто Цикл
	
		СтруктураПоиска.Вставить("Субконто" + НомерСубконто, Запись["Субконто" + ПостфиксСчета][Субконто]);
		НомерСубконто = НомерСубконто + 1;
	
	КонецЦикла;
	
	НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	СтрокаПарныхСчетов = НайденныеСтроки[0];
	
	Если СтрокаПарныхСчетов.СуммаОстатокА <> 0 И СтрокаПарныхСчетов.СуммаОстатокП <> 0 Тогда
		
		ТекстСубконто = "";
		Для каждого Субконто Из ГруппаСчетов.Значение.МассивСубконто Цикл
			ТекстСубконто = ТекстСубконто + ?(ТекстСубконто="","",", ") + Запись["Субконто" + ПостфиксСчета][Субконто];
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены остатки одновременно на двух парных счетах: " + СтрокаПарныхСчетов.СчетА + " и " + СтрокаПарныхСчетов.СчетП + " (" + ТекстСубконто + ")", ОбъектДокумента.Ссылка, , , Отказ);
	
	КонецЕсли; 
	
	СуммаПроводки = 0;
	
	ОстатокПарногоСчета = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксПарногоОстатка];
	ОстатокВалютныйПарногоСчета = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксПарногоОстатка];
	ОстатокТекущегоСчета = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксОстатка];
	ОстатокВалютныйТекущегоСчета = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксОстатка];
	
	Если ОстатокПарногоСчета > 0 Или (ОстатокПарногоСчета + ОстатокТекущегоСчета = 0 и ЗнакОперации = -1) Тогда
		
		// получаем сумму для дополнительной проводки
		СуммаПроводки = ?(ЗнакОперации = -1, 0, Запись.Сумма - Мин(ОстатокПарногоСчета, Запись.Сумма));
		
		ВалютнаяСуммаПроводки = 0;
		Если ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
			Если ЗнакОперации = -1 Тогда
				ВалютнаяСуммаПроводки = 0;
			Иначе
				ВалютнаяСуммаПроводки = Запись["ВалютнаяСумма" + ПостфиксСчета];
				Если Запись["ВалютнаяСумма" + ПостфиксСчета] < 0 Тогда
					ВалютнаяСуммаПроводки = ВалютнаяСуммаПроводки - ОстатокВалютныйПарногоСчета;
				Иначе
					ВалютнаяСуммаПроводки = ВалютнаяСуммаПроводки - Мин(ОстатокВалютныйПарногоСчета, Запись["ВалютнаяСумма" + ПостфиксСчета]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ДелатьПроводкуНаРазницу Тогда
			
			Если СуммаПроводки > 0 Тогда
			
				// добавляем проводку на разницу
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПроводки, "Закрытие парных счетов");
				
				ЗаполнитьЗначенияСвойств(Проводка, Запись, , "Содержание, Сумма");
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксСчета].ВидыСубконто Цикл
					Проводка.СубконтоДт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
					Проводка.СубконтоКт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				
				Проводка.Организация = Запись.Организация;
				Проводка.СчетДоверительногоУправления = Запись.СчетДоверительногоУправления;
				
				Проводка["Счет" + ПостфиксПарного] = СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка];
				Проводка["Валюта" + ПостфиксПарного] = Запись["Валюта" + ПостфиксСчета];
				
				Проводка["ДополнительнаяАналитика" + ПостфиксПарного] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
				
				Если Запись["Счет" + ПостфиксСчета].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка["ВалютнаяСумма" + ПостфиксСчета] = ВалютнаяСуммаПроводки;
				Иначе
					Проводка["ВалютнаяСумма" + ПостфиксСчета] = 0;
				КонецЕсли;
				Если СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка["ВалютнаяСумма" + ПостфиксПарного] = ВалютнаяСуммаПроводки;
				Иначе
					Проводка["ВалютнаяСумма" + ПостфиксПарного] = 0;
				КонецЕсли;
			
			КонецЕсли;
			
			// меняем счет в исходной проводке
			Запись["Счет" + ПостфиксСчета] = СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка];
			Запись["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
			
			СуммаИзмененияПарногоОстатка = Запись.Сумма - СуммаПроводки;
			ВалютнаяСуммаИзмененияПарногоОстатка = Запись["ВалютнаяСумма" + ПостфиксСчета] - ВалютнаяСуммаПроводки;
			
		Иначе
			
			Если СуммаПроводки > 0 Тогда
			
				// добавляем проводку на разницу
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПроводки, "Закрытие парных счетов");
				
				ЗаполнитьЗначенияСвойств(Проводка, Запись, , "Содержание, Сумма");
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксСчета].ВидыСубконто Цикл
					Проводка["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксПарного].ВидыСубконто Цикл
					Проводка["Субконто" + ПостфиксПарного][ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксПарного][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				
				Проводка.Организация = Запись.Организация;
				Проводка.СчетДоверительногоУправления = Запись.СчетДоверительногоУправления;
				
				Если Запись["Счет" + ПостфиксСчета].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка["ВалютнаяСумма" + ПостфиксСчета] = ВалютнаяСуммаПроводки;
				Иначе
					Проводка["ВалютнаяСумма" + ПостфиксСчета] = 0;
				КонецЕсли;
				Если Проводка["Счет" + ПостфиксПарного].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка["ВалютнаяСумма" + ПостфиксПарного] = ВалютнаяСуммаПроводки;
				Иначе
					Проводка["ВалютнаяСумма" + ПостфиксПарного] = 0;
				КонецЕсли;
				
			КонецЕсли;
			
			// меняем счет в исходной проводке
			Запись["Счет" + ПостфиксСчета] = СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка];
			Запись["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
			
			Запись.Сумма = Запись.Сумма - СуммаПроводки;
			
			Если Запись["Счет" + ПостфиксСчета].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
				Запись["ВалютнаяСумма" + ПостфиксСчета] = Запись["ВалютнаяСумма" + ПостфиксСчета] - ВалютнаяСуммаПроводки;
			КонецЕсли;
			
			Если Запись["Счет" + ПостфиксПарного].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксПарного]) Тогда
				Запись["ВалютнаяСумма" + ПостфиксПарного] = Запись["ВалютнаяСумма" + ПостфиксПарного] - ВалютнаяСуммаПроводки;
			КонецЕсли;
			
			СуммаИзмененияПарногоОстатка = Запись.Сумма;
			ВалютнаяСуммаИзмененияПарногоОстатка = Запись["ВалютнаяСумма" + ПостфиксСчета];
			
		КонецЕсли;
		
		СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксОстатка] = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксОстатка] + ЗнакОперации * СуммаПроводки;
		СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксОстатка] = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксОстатка] + ЗнакОперации * ВалютнаяСуммаПроводки;
		СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксПарногоОстатка] - ЗнакОперации * СуммаИзмененияПарногоОстатка;
		СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксПарногоОстатка] - ЗнакОперации * ВалютнаяСуммаИзмененияПарногоОстатка;
		
	Иначе
		
		СуммаПроводки = ?(ЗнакОперации = 1, 0, Запись.Сумма - Мин(ОстатокТекущегоСчета, Запись.Сумма));

		ВалютнаяСуммаПроводки = 0;
		Если ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
			Если ЗнакОперации = 1 Тогда
				ВалютнаяСуммаПроводки = 0;
			Иначе
				ВалютнаяСуммаПроводки = Запись["ВалютнаяСумма" + ПостфиксСчета];
				Если Запись["ВалютнаяСумма" + ПостфиксСчета] < 0 Тогда
					ВалютнаяСуммаПроводки = ВалютнаяСуммаПроводки - ОстатокВалютныйТекущегоСчета;
				Иначе
					ВалютнаяСуммаПроводки = ВалютнаяСуммаПроводки - Мин(ОстатокВалютныйТекущегоСчета, Запись["ВалютнаяСумма" + ПостфиксСчета]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ДелатьПроводкуНаРазницу Тогда
			
			Если СуммаПроводки > 0 Тогда
			
				// добавляем проводку на разницу
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПроводки, "Закрытие парных счетов");
				
				ЗаполнитьЗначенияСвойств(Проводка, Запись, , "Содержание, Сумма");
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксСчета].ВидыСубконто Цикл
					Проводка.СубконтоДт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
					Проводка.СубконтоКт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				
				Проводка.Организация = Запись.Организация;
				Проводка.СчетДоверительногоУправления = Запись.СчетДоверительногоУправления;
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка];
				Проводка["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
				
				Проводка["Счет" + ПостфиксПарного] = СтрокаПарныхСчетов["Счет" + ПостфиксОстатка];
				Проводка["Валюта" + ПостфиксПарного] = Запись["Валюта" + ПостфиксСчета];
				
				Проводка["ДополнительнаяАналитика" + ПостфиксПарного] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
				
				Если Проводка["Счет" + ПостфиксПарного].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка.ВалютнаяСуммаДт = ВалютнаяСуммаПроводки;
					Проводка.ВалютнаяСуммаКт = ВалютнаяСуммаПроводки;
				Иначе
					Проводка.ВалютнаяСуммаДт = 0;
					Проводка.ВалютнаяСуммаКт = 0;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе			
			
			Если СуммаПроводки > 0 Тогда
			
				// добавляем проводку на разницу
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПроводки, "Закрытие парных счетов");
				
				ЗаполнитьЗначенияСвойств(Проводка, Запись, , "Содержание, Сумма");
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксСчета].ВидыСубконто Цикл
					Проводка.СубконтоДт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
					Проводка.СубконтоКт[ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				
				Проводка.Организация = Запись.Организация;
				Проводка.СчетДоверительногоУправления = Запись.СчетДоверительногоУправления;
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка];
				Проводка["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
				
				Проводка["Счет" + ПостфиксПарного] = СтрокаПарныхСчетов["Счет" + ПостфиксОстатка];
				Проводка["Валюта" + ПостфиксПарного] = Запись["Валюта" + ПостфиксСчета];
				
				Проводка["ДополнительнаяАналитика" + ПостфиксПарного] = СтрокаПарныхСчетов.ДополнительнаяАналитика;
				
				Если Запись["Счет" + ПостфиксСчета].Валютный И ЗначениеЗаполнено(Запись["ВалютнаяСумма" + ПостфиксСчета]) Тогда
					Проводка.ВалютнаяСуммаДт = ВалютнаяСуммаПроводки;
					Проводка.ВалютнаяСуммаКт = ВалютнаяСуммаПроводки;
				Иначе
					Проводка.ВалютнаяСуммаДт = 0;
					Проводка.ВалютнаяСуммаКт = 0;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксОстатка] = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксОстатка] + ЗнакОперации * (Запись.Сумма - СуммаПроводки);
		Если СтрокаПарныхСчетов["Счет" + ПостфиксОстатка].Валютный Тогда
			СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксОстатка] = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксОстатка] + ЗнакОперации * (Запись["ВалютнаяСумма" + ПостфиксСчета] - ВалютнаяСуммаПроводки);
		КонецЕсли;
		СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаПарныхСчетов["СуммаОстаток" + ПостфиксПарногоОстатка] - ЗнакОперации * СуммаПроводки;
		Если СтрокаПарныхСчетов["Счет" + ПостфиксПарногоОстатка].Валютный Тогда
			СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаПарныхСчетов["ВалютнаяСуммаОстаток" + ПостфиксПарногоОстатка] - ЗнакОперации * ВалютнаяСуммаПроводки;
		КонецЕсли;
		
	КонецЕсли; 

КонецПроцедуры

Функция ОбработатьЗаписьПоСчетамПереоценки(ПараметрыОбработки)

	РезультатРаботы = Новый Структура("НичегоНеДелали, ИзменилиСчет, ДобавилиПроводку, ДобавилиПроводкуЗакрытия", Ложь, Ложь, Ложь, Ложь);	
	
	ЗакрытиеДоходовРасходовОтПереоценкиПоСтаройСхеме = (ПараметрыОбработки.ОбъектДокумента.Дата < '20221001');
	
	ОбъектДокумента 	= ПараметрыОбработки.ОбъектДокумента;
	НаборЗаписей 		= ПараметрыОбработки.НаборЗаписей;
	ВидСубконтоГФУДоходовРасходов 	= ПараметрыОбработки.ВидСубконтоГФУДоходовРасходов;
	ВидСубконтоЦенныеБумаги			= ПараметрыОбработки.ВидСубконтоЦенныеБумаги;
	СтрокаОстатков 		= ПараметрыОбработки.СтрокаОстатков;
	Запись 				= ПараметрыОбработки.Запись;
	УвеличениеОстатка 	= ПараметрыОбработки.УвеличениеОстатка;
	ПостфиксСчета 		= ПараметрыОбработки.ПостфиксСчета;
	ПостфиксОстатка 	= ПараметрыОбработки.ПостфиксОстатка;
	ПостфиксПарногоСчета 	= ПараметрыОбработки.ПостфиксПарногоСчета;
	ПостфиксПарногоОстатка 	= ПараметрыОбработки.ПостфиксПарногоОстатка;
	
	ЭтоЗакрытие7огоРаздела = (Запись["Счет" + ПостфиксПарногоСчета] = ПланыСчетов.Единый.АктивыВДУ03);
	
	Если ЭтоЗакрытие7огоРаздела И НЕ ЗакрытиеДоходовРасходовОтПереоценкиПоСтаройСхеме Тогда // тут специфика состоит в том, что нельзя менять свет в проводке, только переброски 
		
		ЭтоНачисление = (ПостфиксСчета = "Дт");
		ЭтоСписание = (ПостфиксСчета = "Кт");
		
		Если (ПостфиксОстатка = "А" И ЭтоНачисление) ИЛИ (ПостфиксОстатка = "П" И ЭтоСписание) Тогда // совпадает остаток и движение
																										  
			Если СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] > 0 Тогда 
				// остаток есть - ничего делать не нужно, будем только увеличивать его
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] + Запись.Сумма;
				
			    // проводки не добавляем
				РезультатРаботы.НичегоНеДелали = Истина;
			Иначе
				// остаток не на нужном счете
				СуммаПереброски = Мин(Запись.Сумма, СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка]);
				СуммаУвеличения = Запись.Сумма - СуммаПереброски;
				// строка остаток - уменьшаем остаток на парном счете на СуммаПереброски и увеличиваем остаток на нашем счете на СуммаУвеличения
				СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] - СуммаПереброски;
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] + СуммаУвеличения;	
				
				// проводка - делаем переброску на СуммаПереброски
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПереброски, "Перенос начисленной переоценки после закрытия 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксПарногоСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксПарногоСчета] = 0;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксСчета] = 0;
				
				РезультатРаботы.ДобавилиПроводку = Истина;
				
			КонецЕсли;
			
		Иначе // смотрим остаток по Дт, а движение по Кт или наоборот
			
			Если СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] > Запись.Сумма Тогда 
				//	Сумма остатка своего больше или равна сумме проводки и если мы его уменьшим ничего не случится
				//		проводка - ничего не делаем
				//		строка остатков - уменьшаем остаток на совем счете	
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] - Запись.Сумма;
				
			    // проводки не добавляем
				РезультатРаботы.НичегоНеДелали = Истина;
				
			Иначе
				// остаток не на нужном счете
				СуммаПереброски = Запись.Сумма - СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка];
				// строка остаток - уменьшаем остаток на парном счете на СуммаПереброски и увеличиваем остаток на нашем счете на СуммаУвеличения
				СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] + СуммаПереброски;
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = 0;	
				
				// проводка - делаем переброску на СуммаПереброски
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаПереброски, "Перенос начисленной переоценки после закрытия 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксПарногоСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксПарногоСчета] = 0;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксСчета] = 0;
				
				РезультатРаботы.ДобавилиПроводку = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли УвеличениеОстатка Тогда
		// Счет на своем месте
		Если (СтрокаОстатков.СуммаОстатокА = 0 И СтрокаОстатков.СуммаОстатокП = 0)
			Или СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] > 0 Тогда
	        //	Остатков нет или есть остаток своего счета
			// 		проводка - ничего не делаем
			//		строка остатков - увеличиваем остаток на совем счете
			СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] + Запись.Сумма;
			
			РезультатРаботы.НичегоНеДелали = Истина;
			
		ИначеЕсли СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] >= Запись.Сумма Тогда
			//	Сумма остатка парного больше или равна сумме проводки
			Если НЕ ЭтоЗакрытие7огоРаздела Тогда
				//		проводка - меняем счет
				Запись["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				
				РезультатРаботы.ИзменилиСчет = Истина;
				
			Иначе
				//		проводка - не меняем счет
				//		добавляем проводку перекидки
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, Запись.Сумма, "Перенос начисленной переоценки перед закрытием 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,ВалютнаяСуммаДт,ВалютнаяСуммаКт,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;				
				//Проводка["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаОстатков["ДополнительнаяАналитика" + ПостфиксОстатка];
				
				РезультатРаботы.ДобавилиПроводку = Истина;
				
			КонецЕсли;
			//		строка остатков - уменьшаем остаток парного на сумму проводки
			СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] - Запись.Сумма;
		Иначе
			//	Сумма остатка парного меньше суммы проводки
			//		СуммаВторойПроводки = исходная сумма проводки - остаток парного
			Коэффициент = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] / Запись.Сумма;
			СуммаВторойПроводки = Запись.Сумма - СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка];
			СуммаВторойПроводкиВал = 0;
			Если Запись["Счет"+ПостфиксПарногоСчета].Валютный Тогда
				СуммаВторойПроводкиВал = Окр(Запись["ВалютнаяСумма"+ПостфиксПарногоСчета] * (1 - Коэффициент), 2);
			КонецЕсли;
			
			//		проводка - меняем сумму на сумму остатка парного
			Запись.Сумма = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка];
			Если Запись["Счет"+ПостфиксПарногоСчета].Валютный Тогда
				Запись["ВалютнаяСумма"+ПостфиксПарногоСчета] = Запись["ВалютнаяСумма"+ПостфиксПарногоСчета] - СуммаВторойПроводкиВал;
			КонецЕсли;
			
			Если НЕ ЭтоЗакрытие7огоРаздела Тогда
				//		проводка - меняем счет, меняем сумму на сумму остатка парного
				Запись["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				
				РезультатРаботы.ИзменилиСчет = Истина;
				
			Иначе
				//		проводка - не меняем счет
				//		добавляем проводку перекидки
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, Запись.Сумма, "Перенос начисленной переоценки перед закрытием 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				//Проводка["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаОстатков["ДополнительнаяАналитика" + ПостфиксОстатка];
				
				РезультатРаботы.ДобавилиПроводку = Истина;
				
			КонецЕсли;
			
			СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = 0;
			                                                                      
			//		доп. проводка - копия первой с исходным счетом, сумма = СуммаВторойПроводки
			//		строка остатков - остаток текущего = СуммаВторойПроводки
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаВторойПроводки, Запись.Содержание);
			ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,ВалютнаяСуммаДт,ВалютнаяСуммаКт");
			
			Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксОстатка];
			Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксОстатка];
			Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
			
			Если Проводка["Счет"+ПостфиксПарногоСчета].Валютный Тогда
				Проводка["ВалютнаяСумма" + ПостфиксПарногоСчета] = СуммаВторойПроводкиВал;
			КонецЕсли; 
			
			Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксПарногоСчета].ВидыСубконто Цикл
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксПарногоСчета][ВидСубконтоСтрока.ВидСубконто];
			КонецЦикла;
			
			//		строка остатков - остаток парного = 0
			СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СуммаВторойПроводки;
			
			РезультатРаботы.ДобавилиПроводкуЗакрытия = Истина;
			
		КонецЕсли
	Иначе
		// Счет не на своем месте
		Если (СтрокаОстатков.СуммаОстатокА = 0 И СтрокаОстатков.СуммаОстатокП = 0) ИЛИ СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] > 0 Тогда
			//	Остатков нет или есть остаток парного
			//		проводка - меняем счет
			//	    строка остатков - увеличиваем остаток парного
			Запись["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
			Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
			СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксПарногоОстатка] + Запись.Сумма;
			
			РезультатРаботы.ИзменилиСчет = Истина;
			
		ИначеЕсли СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] >= Запись.Сумма Тогда	
			//	Сумма остатка своего больше или равна сумме прводки
			//		проводка - ничего не делаем
			//		строка остатков - уменьшаем остаток на совем счете	
			СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] - Запись.Сумма;
			
			РезультатРаботы.НичегоНеДелали = Истина;
			
		Иначе
			//	Сумма остатка своего меньше суммы прводки
			//		СуммаВторойПроводки = исходная сумма проводки - остаток своего
			Коэффициент = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] / Запись.Сумма;
			СуммаВторойПроводки = Запись.Сумма - СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка];
			
			СуммаВторойПроводкиВал = 0;
			Если Запись["Счет"+ПостфиксСчета].Валютный Тогда
				СуммаВторойПроводкиВал = Окр(Запись["ВалютнаяСумма"+ПостфиксСчета] * (1 - Коэффициент), 2);
			КонецЕсли;
			
			Если НЕ ЭтоЗакрытие7огоРаздела Тогда
				//		проводка - меняем сумму на сумму остатка своего
				//		строка остатков - остаток тек счета = 0
				Запись.Сумма = СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка];
				
				Если Запись["Счет" + ПостфиксСчета].Валютный Тогда
					Запись["ВалютнаяСумма" + ПостфиксСчета] = Запись.Сумма;
				КонецЕсли; 
				
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = 0;
				
				//		доп. проводка - копия первой с заменой счета, сумма = СуммаВторойПроводки
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаВторойПроводки, Запись.Содержание);
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,ВалютнаяСуммаДт,ВалютнаяСуммаКт");
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				
				Если Проводка["Счет" + ПостфиксПарногоСчета].Валютный Тогда
					Проводка["ВалютнаяСумма" + ПостфиксПарногоСчета] = СуммаВторойПроводкиВал;
				КонецЕсли; 
				
				Для каждого ВидСубконтоСтрока Из Запись["Счет" + ПостфиксПарногоСчета].ВидыСубконто Цикл
					Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоСтрока.ВидСубконто] = Запись["Субконто" + ПостфиксПарногоСчета][ВидСубконтоСтрока.ВидСубконто];
				КонецЦикла;
				
				РезультатРаботы.ДобавилиПроводку = Истина;
				
			Иначе
				СтрокаОстатков["СуммаОстаток" + ПостфиксОстатка] = 0;
				//		доп. проводка - прекидка на парный счет, сумма = СуммаВторойПроводки
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, НаборЗаписей, СуммаВторойПроводки, "Перенос начисленной переоценки перед закрытием 7 раздела");
				ЗаполнитьЗначенияСвойств(Проводка, Запись,, "Сумма,Содержание");
				
				Проводка["Счет" + ПостфиксПарногоСчета] = Запись["Счет" + ПостфиксСчета];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоГФУДоходовРасходов] = Запись["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов];
				Проводка["Субконто" + ПостфиксПарногоСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксПарногоСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксПарногоСчета] = 0;
				Проводка["ДополнительнаяАналитика" + ПостфиксПарногоСчета] = Запись["ДополнительнаяАналитика" + ПостфиксСчета];
				
				Проводка["Счет" + ПостфиксСчета] = СтрокаОстатков["Счет" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоГФУДоходовРасходов] = СтрокаОстатков["Аналитика" + ПостфиксПарногоОстатка];
				Проводка["Субконто" + ПостфиксСчета][ВидСубконтоЦенныеБумаги] = СтрокаОстатков.ЦеннаяБумага;
				Проводка["Валюта" + ПостфиксСчета] = Null;
				Проводка["ВалютнаяСумма" + ПостфиксСчета] = 0;
				//Проводка["ДополнительнаяАналитика" + ПостфиксСчета] = СтрокаОстатков["ДополнительнаяАналитика" + ПостфиксПарногоОстатка];
				
