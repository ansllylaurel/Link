	//31310	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным негосударственным финансовым организациям
	//31311	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным негосударственным коммерческим организациям
	//31312	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным негосударственным некоммерческим организациям
	//31313	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным юридическим лицам - нерезидентам
	//31314	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным кредитным организациям
	//31315	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным банкам-нерезидентам
	
	//31316	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным физическим лицам
	//31317	Комиссионные расходы и затраты по сделке, уменьшающие процентные доходы: По прочим средствам, предоставленным физическим лицам - нерезидентам
	
	Возврат Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("3131" + ОпределитьПостфиксГФУ(Контрагент, НаДату));

КонецФункции // ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту

Функция ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам(Контрагент, НаДату) Экспорт

	//44212	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам негосударственных финансовых организаций
	//44213	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам негосударственных коммерческих организаций
	//44214	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам негосударственных некоммерческих организаций
	//44215	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам юридических лиц - нерезидентов
	//44216	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам (кроме кредитов) кредитных организаций
	//44217	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам (кроме кредитов) банков-нерезидентов
	
	//44218	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам физических лиц
	//44219	Комиссионные расходы и затраты по сделке, увеличивающие процентные расходы: по привлеченным средствам физических лиц - нерезидентов
	
	Возврат Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("4421" + ОпределитьПостфиксГФУДляРасходов(Контрагент, НаДату));

КонецФункции // ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам

Функция ПолучитьЦенныеБумагиЯвляющиесяДефолтнымиПоМнениюКлиента(Дата, Организация, СчетДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК ПризнатьВыпускДефолтным
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПризнатьДефолтной)
		|				И Клиент В
		|					(ВЫБРАТЬ
		|						КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|					ИЗ
		|						РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
		|ГДЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки = ИСТИНА
		|	И НЕ ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Отключить";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
КонецФункции

Функция ПолучитьСчетГФУУчетногоАктиваЕПСИзПартии(Дата,Организация, СчетДоверительногоУправления, ЦеннаяБумага) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций КАК СчетУчетаРасходовОтОпераций,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.АналитикаРасходовОтОпераций КАК АналитикаРасходовОтОпераций,
	|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ЦеннаяБумага = &ЦеннаяБумага
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	
	Результат =  Запрос.Выполнить().Выгрузить();
		
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьРыночнуюЭСПиОтклонениеПоМетодикеСНГ(Облигация, ДатаПереоценки, РасшифровкаРасчета, СчетДоверительногоУправления, НастройкиУчета)

	Если Облигация.ДатаПогашения = '00010101' Тогда // бессрочная бумага
		ДатаПогашения = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(Облигация, НачалоДня(ДатаПереоценки), НачалоДня(ДатаПереоценки), СчетДоверительногоУправления,
			НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении).ДатаВыкупа;
	Иначе
		ДатаПогашения = Облигация.ДатаПогашения;
	КонецЕсли;

	ПолныхЛетДоПогашения = Цел((ДатаПогашения - ДатаПереоценки) / (365 * 86400));
	
	Если Облигация.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
		Если ПолныхЛетДоПогашения = 0 Тогда
			КодИндекса = "RUGBITR1Y";
		ИначеЕсли ПолныхЛетДоПогашения < 3 Тогда
			КодИндекса = "RUGBITR3Y";
		ИначеЕсли ПолныхЛетДоПогашения < 5 Тогда
			КодИндекса = "RUGBITR5Y";
		ИначеЕсли ПолныхЛетДоПогашения < 10 Тогда
			КодИндекса = "RUGBITR10Y";
		Иначе
			КодИндекса = "RUGBITR5+";
		КонецЕсли;
	Иначе
		Если ПолныхЛетДоПогашения = 0 Тогда
			Если Облигация.Категория = Перечисления.КатегорииОблигаций.Муниципальная ИЛИ Облигация.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда
				КодИндекса = "RUMBITR1Y";
			Иначе // корп, евро и проч.
				КодИндекса = "RUCBITR1Y";
			КонецЕсли;
		Иначе
			// Определим уровень рейтинга актива
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	МИНИМУМ(ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления, 5)) КАК СтрокаСопоставления
				|ИЗ
				|	РегистрСведений.Рейтинги.СрезПоследних(
				|			&Период,
				|			Субъект = &Субъект
				|				ИЛИ Субъект = &СубъектЭмитент) КАК РейтингиСрезПоследних
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(&Период, Источник = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПереченьЦБ_РФДляОтчетности)) КАК СопоставлениеРейтинговыхШкалСрезПоследних
				|		ПО РейтингиСрезПоследних.Шкала = СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная
				|			И (РейтингиСрезПоследних.ЗначениеРейтинга.Оценка МЕЖДУ СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное.Оценка И СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное.Оценка)";
			
			Запрос.УстановитьПараметр("Период", НачалоДня(ДатаПереоценки));
			Запрос.УстановитьПараметр("Субъект", Облигация);
			Запрос.УстановитьПараметр("СубъектЭмитент", Облигация.Эмитент);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			    УровеньРейтинга = ВыборкаДетальныеЗаписи.СтрокаСопоставления;
			Иначе
				УровеньРейтинга = 5;
			КонецЕсли;

			Если Облигация.Категория = Перечисления.КатегорииОблигаций.Муниципальная ИЛИ Облигация.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда
				Если ПолныхЛетДоПогашения < 3 Тогда
					Если УровеньРейтинга < 3 Тогда
						КодИндекса = "RUMBITRBBB3Y";
					Иначе
						КодИндекса = "RUMBITRBB3Y";
					КонецЕсли;
				Иначе
					КодИндекса = "RUMBITRBBB3+";
				КонецЕсли;
			Иначе // корп
				Если ПолныхЛетДоПогашения < 3 Тогда
					Если УровеньРейтинга < 3 Тогда
						КодИндекса = "RUCBITRBBB3Y";
					ИначеЕсли УровеньРейтинга = 3 Тогда
						КодИндекса = "RUCBITRBB3Y";
					Иначе
						КодИндекса = "RUCBITRB3Y";
					КонецЕсли;
				ИначеЕсли ПолныхЛетДоПогашения < 5 Тогда
					Если УровеньРейтинга < 3 Тогда
						КодИндекса = "RUCBITRBBB5Y";
					Иначе
						КодИндекса = "RUCBITRBB5Y";
					КонецЕсли;
				Иначе
					Если УровеньРейтинга < 3 Тогда
						КодИндекса = "RUCBITRBBB3+";
					Иначе
						КодИндекса = "RUCBITRBB3+";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	БиржевойИндекс = Справочники.БиржевыеИндексы.НайтиПоКоду(КодИндекса);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияБиржевыхИндексовСрезПоследних.YIELD КАК Доходность
		|ПОМЕСТИТЬ _Доходность
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(&Период, БиржевойИндекс = &БиржевойИндекс) КАК ЗначенияБиржевыхИндексовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 КАК Количество,
		|	ЗначенияБиржевыхИндексов.YIELD КАК Доходность
		|ПОМЕСТИТЬ _ЗначенияИндексов
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|ГДЕ
		|	ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс
		|	И ЗначенияБиржевыхИндексов.Период >= &НачалоПериода
		|	И ЗначенияБиржевыхИндексов.Период <= &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Итог.РазмерВыборки КАК РазмерВыборки,
		|	_Итог.СуммаВыборки / _Итог.РазмерВыборки КАК СреднееЗначение
		|ПОМЕСТИТЬ _Итоги
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(_ЗначенияИндексов.Количество) КАК РазмерВыборки,
		|		СУММА(_ЗначенияИндексов.Доходность) КАК СуммаВыборки
		|	ИЗ
		|		_ЗначенияИндексов КАК _ЗначенияИндексов) КАК _Итог
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РасчетОтклонения.КвадратичноеОтклонение / (_Итоги.РазмерВыборки - 1) КАК СреднееКвадратичноеОтклонение,
		|	_Доходность.Доходность КАК Доходность
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА((_ЗначенияИндексов.Доходность - _Итоги.СреднееЗначение) * (_ЗначенияИндексов.Доходность - _Итоги.СреднееЗначение)) КАК КвадратичноеОтклонение
		|	ИЗ
		|		_ЗначенияИндексов КАК _ЗначенияИндексов,
		|		_Итоги КАК _Итоги) КАК _РасчетОтклонения,
		|	_Итоги КАК _Итоги,
		|	_Доходность КАК _Доходность";
	
	ГлубинаВзятияДоходностиИндексовЛет = 1;
	Если ДатаПереоценки >= '20230420' Тогда
		ГлубинаВзятияДоходностиИндексовЛет = 3;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("БиржевойИндекс", БиржевойИндекс);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоДня(ДатаПереоценки), -12 * ГлубинаВзятияДоходностиИндексовЛет));
	Запрос.УстановитьПараметр("Период", НачалоДня(ДатаПереоценки));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Новый Структура("БезрисковаяСтавкаДоходности, СтандартноеОтклонение", ВыборкаДетальныеЗаписи.Доходность, SQRT(ВыборкаДетальныеЗаписи.СреднееКвадратичноеОтклонение));
	Иначе
	     Возврат Неопределено
	КонецЕсли;
	
КонецФункции

// Функция - Проверить ЭСПНа рыночность
//
// Параметры:
//  Облигация					 - Справочник.Облигации 
//  ЭСП							 - ОпределяемыеТипы.ЭффективнаяПроцентнаяСтавка -
//  ДатаПереоценки				 - Дата (начало дня) 
//  СчетДоверительногоУправления - Справочник.СчетаДоверительногоУправления 
//  Расшифровка					 - Структура	 
//  ПараметрыПроверки			 - Структура
//   НомерСтроки - Число - всегда 1
//   ЦеннаяБумага - Справочник.Облигации - совпадается с параметром Облигация
//   Партия - ОпределяемыеТипы.Партия - партия покупки ценной бумаги, если нет исполнения допустимо использовать сделку
//   СтрокаПартии - ОпределяемыеТипы.СтрокаПартии - строка партии покупки ценной бумаги, почти всегда 1 
//  Отказ						 - Булево
// 
// Возвращаемое значение:
//  Истина		 - ЭСП соответствует критерию рыночности
//  Ложь		 - ЭСП не соответствует критерию рыночности
//  Неопределено - Не удалось провести проверку ЭСП на рыночность
//
Функция ПроверитьЭСПНаРыночность(Облигация, ЭСП, ДатаПереоценки, СчетДоверительногоУправления, Расшифровка = Неопределено, ПараметрыПроверки, Отказ) Экспорт

	Организация = СчетДоверительногоУправления.Организация;
	ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ВидУчета);
	НастройкиЦелиРасчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиЦелиРасчета(ДатаПереоценки, Организация, СчетДоверительногоУправления, ЦельРасчета);
	ВариантРасчетаОценочнойСтоимости = НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости;
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаПереоценки, Организация, СчетДоверительногоУправления);
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("Организация",							Организация);
	ПараметрыОценки.Вставить("Клиент",								Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки));
	ПараметрыОценки.Вставить("СчетДоверительногоУправления",		СчетДоверительногоУправления);
	ПараметрыОценки.Вставить("ВидУчета",							ВидУчета);
	ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	ВариантРасчетаОценочнойСтоимости);
	ПараметрыОценки.Вставить("ПараметрыПолученияПартий",			РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(ЦельРасчета, ВидУчета, ВариантРасчетаОценочнойСтоимости, ДатаПереоценки));
	
	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("Операции",						Новый Массив);
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",					Облигация);
	РасшифровкаРасчета.Вставить("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	РасшифровкаРасчета.Вставить("ДатаРасчета",					ДатаПереоценки);
	
	ПараметрыМетодики = РаботаСКоллекциями.СкопироватьСтруктуру(ПараметрыОценки,,, "ПараметрыПолученияПартий");
	РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ПараметрыМетодики", ПараметрыМетодики, "Параметры методики",, Истина);
	
	Отказ = Ложь;
	
	ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, ДатаПереоценки, Облигация, Отказ);
	Если Отказ Тогда
	    Возврат Неопределено;
	КонецЕсли;
	
	ОшибкаРасчета = Ложь;
	
	ДенежныеПотоки = Справочники.Облигации.ПолучитьДенежныйПоток(Облигация, ПараметрыДенежногоПотока, ПараметрыОценки, ОшибкаРасчета, РасшифровкаРасчета);
					
	Если ОшибкаРасчета Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	Если ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Сургутнефтегаз2020 Тогда // все по-своему
		
		ДанныеРасчетаРыночнойЭСП = ПолучитьРыночнуюЭСПиОтклонениеПоМетодикеСНГ(Облигация, ДатаПереоценки, РасшифровкаРасчета, СчетДоверительногоУправления, НастройкиУчета);
		
		БезрисковаяСтавкаДоходности	= ДанныеРасчетаРыночнойЭСП.БезрисковаяСтавкаДоходности;
		
		НижняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности - ДанныеРасчетаРыночнойЭСП.СтандартноеОтклонение;
		ВерхняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности + ДанныеРасчетаРыночнойЭСП.СтандартноеОтклонение;
		
		Если ЭСП >= НижняяГраницаКоридораЭСП И ЭСП <= ВерхняяГраницаКоридораЭСП Тогда
			РезультатПроверкиСтавкиЭСП = "ЭСП рыночная";
			ПринимаемаяЭСП = ЭСП;
		Иначе
			РезультатПроверкиСтавкиЭСП = "ЭСП нерыночная";
			ПринимаемаяЭСП = ?(ЭСП < НижняяГраницаКоридораЭСП, НижняяГраницаКоридораЭСП, ВерхняяГраницаКоридораЭСП);
		КонецЕсли;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория2022
		 ИЛИ ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Югория Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Клиент не предоставил методику проверки ЭСП на рыночность",,,, Отказ);
		Возврат Неопределено;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Перспектива2020 Тогда // у них не используется кредитный спред для поределения корридора
		
		БезрисковаяСтавкаДоходности	= РаботаСПоказателямиФинансовыхИнструментов.РассчитатьБезрисковуюСтавкуДоходности(Облигация, ДатаПереоценки, ДенежныеПотоки, ОшибкаРасчета, РасшифровкаРасчета);
		Если ОшибкаРасчета Тогда
			Возврат Неопределено;
		КонецЕсли;		
		
		НижняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности * 0.8;
		ВерхняяГраницаКоридораЭСП	= БезрисковаяСтавкаДоходности * 1.2;
		
		Если ЭСП >= НижняяГраницаКоридораЭСП И ЭСП <= ВерхняяГраницаКоридораЭСП Тогда
			РезультатПроверкиСтавкиЭСП = "ЭСП рыночная";
			ПринимаемаяЭСП = ЭСП;
		Иначе
			РезультатПроверкиСтавкиЭСП = "ЭСП нерыночная";
			ПринимаемаяЭСП = ?(ЭСП < НижняяГраницаКоридораЭСП, НижняяГраницаКоридораЭСП, ВерхняяГраницаКоридораЭСП);
		КонецЕсли;
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Атомфонд2020 Тогда
		
		Партия = ПараметрыПроверки.Партия;
		
		Если ТипЗнч(Партия) = Тип("ДокументСсылка.Сделка") Тогда
			МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "МестоХранения");
		ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") ИЛИ ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
			Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "Основание");
			МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "МестоХранения");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для методики Атомов не предусмотрен расчет для вводов бумаг",,,, Отказ);
			Возврат Неопределено;
		КонецЕсли;
			
		ЦенныеБумаги = Новый ТаблицаЗначений();
		ЦенныеБумаги.Колонки.Добавить("НомерСтроки",					Новый ОписаниеТипов("Число"));
		ЦенныеБумаги.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ЦенныеБумаги.Колонки.Добавить("Партия",							Метаданные.ОпределяемыеТипы.Партия.Тип);
		ЦенныеБумаги.Колонки.Добавить("СтрокаПартии",					Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
		ЦенныеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ЦенныеБумаги.Колонки.Добавить("Количество",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ЦенныеБумаги.Колонки.Добавить("Рынок",							Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		ЦенныеБумаги.Колонки.Добавить("ВидДвижения",					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
		ЦенныеБумаги.Колонки.Добавить("ТипЗадолженности",				Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		ЦенныеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		
		СтрокаЦенныеБумаги = ЦенныеБумаги.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, ПараметрыПроверки);
		
		СтрокаЦенныеБумаги.Количество = 1;
		СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
		СтрокаЦенныеБумаги.ВидДвижения = Перечисления.ВидыДвижений.Приход;
		
		Попытка
			ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
			ПереоценкаЦБ.Организация					= Организация;
			ПереоценкаЦБ.СчетДоверительногоУправления	= СчетДоверительногоУправления;
			ПереоценкаЦБ.ЦельРасчета					= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
			ПереоценкаЦБ.Дата							= КонецДня(ДатаПереоценки);
			ПереоценкаЦБ.ВидУчета						= ВидУчета;
			ПереоценкаЦБ.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
			ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ЦенныеБумаги, Истина);
			ТаблицаСтоимостей = ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить();
			
			СтрокиСтоимостей = ТаблицаСтоимостей.НайтиСтроки(Новый Структура("Рынок,ЦеннаяБумага", Перечисления.РынкиЦенныхБумаг.Облигации, Облигация));
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют права на расчет справделивой стоимости",,,, Отказ);
			Возврат Неопределено;
		КонецПопытки;
		
		ПокупнаяСтоимость = ПараметрыПроверки.ЦенаПокупки;
		СправедливаяСтоимость = СтрокиСтоимостей[0].Цена;
		БезрисковаяСтавкаДоходности = "<Не используется>";		
		НижняяГраницаКоридораЭСП			= "не проверяется";
		ВерхняяГраницаКоридораЭСП			= "не проверяется";
		
		Если МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда // внебиржа
			МинимумДиапазонаСС = СправедливаяСтоимость * 0.95;
			МаксимумДиапазонаСС = СправедливаяСтоимость * 1.05;
			Если ПокупнаяСтоимость >= МинимумДиапазонаСС И ПокупнаяСтоимость <= МаксимумДиапазонаСС Тогда
				РезультатПроверкиПокупнойСтоимости	= "покупная = справедливая";
				РезультатПроверкиСтавкиЭСП			 = "ЭСП рыночная";
				ПринимаемаяЭСП = ЭСП;
			Иначе
				Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
				РезультатПроверкиПокупнойСтоимости	= "покупная <> справедливая";
				РезультатПроверкиСтавкиЭСП			 = "ЭСП не рыночная";
				ПринимаемаяЭСП = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
					Облигация,
					ПараметрыДенежногоПотока.ДоДатыПогашения,
					ДатаПереоценки,
					СправедливаяСтоимость,
					СчетДоверительногоУправления,
					Биржа).Доходность;
			КонецЕсли;
		Иначе // биржа
			МинимумДиапазонаСС					= "не проверяется";
			МаксимумДиапазонаСС					= "не проверяется";
		    РезультатПроверкиПокупнойСтоимости	= "покупная = справедливая";
			
			РезультатПроверкиСтавкиЭСП			 = "ЭСП рыночная";
			ПринимаемаяЭСП = ЭСП;
		КонецЕсли;
		
		РасшифровкаРасчета.Вставить("КритерийРыночностиЭСП",				"ЭСП признается рыночной, если покупная стоимость является справедливой: для сделок на бирже - всегда, для внебиржевых при попадании в 5% коридор от СС");
		РасшифровкаРасчета.Вставить("МестоСовершенияСделки",				МестоХранения);
		РасшифровкаРасчета.Вставить("ПокупнаяСтоимость",					ПокупнаяСтоимость);
		РасшифровкаРасчета.Вставить("СправедливаяСтоимость",				СправедливаяСтоимость);
		РасшифровкаРасчета.Вставить("МинимумДиапазонаСС",					МинимумДиапазонаСС);
		РасшифровкаРасчета.Вставить("МаксимумДиапазонаСС",					МинимумДиапазонаСС);
		РасшифровкаРасчета.Вставить("РезультатПроверкиПокупнойСтоимости",	РезультатПроверкиПокупнойСтоимости);
		
	ИначеЕсли ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ХантыМансийский2020 Тогда
		
		Партия = ПараметрыПроверки.Партия;
		
		Если ТипЗнч(Партия) = Тип("ДокументСсылка.Сделка") Тогда
			РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Партия, "РежимПереговорныхСделок, ПервичноеРазмещение, МестоХранения, ВалютаСделки, РежимБиржевыхТоргов");
		ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") ИЛИ ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
			Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "Основание");
			РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "РежимПереговорныхСделок, ПервичноеРазмещение, МестоХранения, ВалютаСделки, РежимБиржевыхТоргов");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для методики Ханты-Мансийский НПФ не предусмотрен расчет для документов " + ТипЗнч(Партия),,,, Отказ);
			Возврат Неопределено;
		КонецЕсли;
		
		МестоХранения = Строка(РеквизитыСделки.МестоХранения) + ", " + Строка(РеквизитыСделки.РежимБиржевыхТоргов);
		
		ЦенныеБумаги = Новый ТаблицаЗначений();
		ЦенныеБумаги.Колонки.Добавить("НомерСтроки",					Новый ОписаниеТипов("Число"));
		ЦенныеБумаги.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
		ЦенныеБумаги.Колонки.Добавить("Партия",							Метаданные.ОпределяемыеТипы.Партия.Тип);
		ЦенныеБумаги.Колонки.Добавить("СтрокаПартии",					Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
		ЦенныеБумаги.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		ЦенныеБумаги.Колонки.Добавить("Количество",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ЦенныеБумаги.Колонки.Добавить("Рынок",							Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
		ЦенныеБумаги.Колонки.Добавить("ВидДвижения",					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвижений"));
		ЦенныеБумаги.Колонки.Добавить("ТипЗадолженности",				Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		ЦенныеБумаги.Колонки.Добавить("СуммаРезервовПодОбесценение",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		
		СтрокаЦенныеБумаги = ЦенныеБумаги.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, ПараметрыПроверки);
		
		СтрокаЦенныеБумаги.Количество = 1;
		СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
		СтрокаЦенныеБумаги.ВидДвижения = Перечисления.ВидыДвижений.Приход;
		
		Попытка
			ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
			ПереоценкаЦБ.Организация					= Организация;
			ПереоценкаЦБ.СчетДоверительногоУправления	= СчетДоверительногоУправления;
			ПереоценкаЦБ.ЦельРасчета					= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
			ПереоценкаЦБ.Дата							= КонецДня(ДатаПереоценки);
			ПереоценкаЦБ.ВидУчета						= ВидУчета;
			ПереоценкаЦБ.ДополнительныеСвойства.Вставить("ОчиститьКупоныСуммыИКоличество", Ложь);
			ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Неопределено, Ложь, Неопределено, ЦенныеБумаги, Истина);
			ТаблицаСтоимостей = ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить();
			
