			КонецЕсли;
			
			// ОПЛАТИТЬ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ВидКомиссии.Наименование + " списание");
			
