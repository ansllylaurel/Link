			ПереоценкаОтрицательная = Окр(ВыборкаДетальныеЗаписи.ПереоценкаОтрицательная * ДоляЗакрытия, 2);
			Если ПереоценкаОтрицательная <> 0 Тогда
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда // у них сначала идет перенос с со счетов 106ХХ (аналитика переоценки)на счета 7ХХ (аналитика операции)
					
					ПереносПереоценкиСоСчетовДобавочногоКапиталаНаСчетаДоходовРасходов(ЭтотОбъект, УчетныйАктив, ЦеннаяБумага, ВалютаДохода, ПереоценкаОтрицательная);// и только потом со счетов 7ХХ (аналитика операции) на 47903
					
					ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтОпераций;
					СчетУчетаДоходов = УчетныйАктив.СчетУчетаДоходовОтОпераций;
				Иначе
					ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтПереоценки;
					СчетУчетаДоходов = БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Ложь);
				КонецЕсли;
				БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по доходам от операций", Неопределено, ПереоценкаОтрицательная);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(-БухПартииЦенныхБумаг.ДисконтПремияНачисленныйСНачалаГода) КАК ДисконтПремияНачисленный,
	|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки >= 0
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ДисконтИлиПремия
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|ГДЕ
	|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
	|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|
	|СГРУППИРОВАТЬ ПО
	|	БухПартииЦенныхБумаг.ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумаг.ДисконтПремияПокупки >= 0
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ЦенныеБумаги = Запрос.Выполнить().Выгрузить();
	
	//Все суммы с начала года в валюте учета и их пересчитывать не надо
	ВалютаДохода  = ЭтотОбъект.Организация.ВалютаУчета;
	
	Для Каждого СтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
		ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
		Попытка
			УчетныйАктив = СтрокаЦенныеБумаги.УчетныйАктивЕПС;	
		Исключение
			УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ЭтотОбъект, Рынок, ЦеннаяБумага, УчетныйСчетДоверительногоУправления);
		КонецПопытки;
		
		ДисконтПремияНачисленный = 0;
		
		Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			ДисконтПремияНачисленный = Окр(СтрокаЦенныеБумаги.ДисконтПремияНачисленный * ДоляЗакрытия, 2);
			
			// у тут делаем закрытия по дисконту/премии, тут они не смешиваются
			Если СтрокаЦенныеБумаги.ДисконтПремияНачисленный < 0 Тогда
				СчетУчетаДоходов = ПланыСчетов.Единый.ПроцентныеДоходы01;
				ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
				Если ДисконтПремияНачисленный <> 0 Тогда
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по дисконту", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт, ДисконтПремияНачисленный);
				КонецЕсли;
			ИначеЕсли СтрокаЦенныеБумаги.ДисконтПремияНачисленный > 0 Тогда
				СчетУчетаДоходов = ПланыСчетов.Единый.ПроцентныеДоходы04;
				ГруппаФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаСписанияПремии;
				Если ДисконтПремияНачисленный <> 0 Тогда
					БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по премии", Неопределено, ДисконтПремияНачисленный);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
			
    КонецЦикла;
	
	// к сожалению для резервов у нас нет ресурса "...СНачалаГода" 
	// и вдобавок они могут гулять туда сюда произвольно, 
	// приходится просто считать по выводимому коэффициенту - увы, но лучше ничего нет

	// приходится записывать движения документа т.к. он сам еще начисляет резерв
	Движения = ЭтотОбъект.Движения;
	НаборЗаписей = Движения.ЕдиныйБухгалтерскийУчет;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И ЭтотОбъект.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		НаборЗаписей.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество
		|ПОМЕСТИТЬ _ВыводБумагПоАС
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумагОстатки.КоличествоОстаток) КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ОстаткиВыводимыхБумаг
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ВыводБумагПоАС.ЦеннаяБумага
		|					ИЗ
		|						_ВыводБумагПоАС КАК _ВыводБумагПоАС)) КАК БухПартииЦенныхБумагОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВыводБумагПоАС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВыводБумагПоАС.Количество КАК Количество,
		|	_ОстаткиВыводимыхБумаг.КоличествоОстаток КАК КоличествоОстаток,
		|	ЕдиныйБухгалтерскийУчетОстаткиДоход.Субконто1 КАК ГФУДоход,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстаткиДоход.СуммаОстатокКт, 0) КАК СуммаОстатокДоход,
		|	ЕдиныйБухгалтерскийУчетОстаткиРасход.Субконто1 КАК ГФУРасход,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстаткиРасход.СуммаОстатокДт, 0) КАК СуммаОстатокРасход
		|ИЗ
		|	_ВыводБумагПоАС КАК _ВыводБумагПоАС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОстаткиВыводимыхБумаг КАК _ОстаткиВыводимыхБумаг
		|		ПО _ВыводБумагПоАС.ЦеннаяБумага = _ОстаткиВыводимыхБумаг.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&ПериодВключая,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам01),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Субконто2 В
		|						(ВЫБРАТЬ
		|							_ВыводБумагПоАС.ЦеннаяБумага
		|						ИЗ
		|							_ВыводБумагПоАС КАК _ВыводБумагПоАС)) КАК ЕдиныйБухгалтерскийУчетОстаткиДоход
		|		ПО _ВыводБумагПоАС.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстаткиДоход.Субконто2
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&ПериодВключая,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам02),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Субконто2 В
		|						(ВЫБРАТЬ
		|							_ВыводБумагПоАС.ЦеннаяБумага
		|						ИЗ
		|							_ВыводБумагПоАС КАК _ВыводБумагПоАС)) КАК ЕдиныйБухгалтерскийУчетОстаткиРасход
		|		ПО _ВыводБумагПоАС.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстаткиРасход.Субконто2";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",	Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодВключая",	Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КоэффициентЗакрытияРезерва = ВыборкаДетальныеЗаписи.Количество / ВыборкаДетальныеЗаписи.КоличествоОстаток;
		
		Если ВыборкаДетальныеЗаписи.СуммаОстатокДоход > 0 Тогда
	    	БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
				ЭтотОбъект,
				ПланыСчетов.Единый.ДоходыРасходыПоРезервам01,
				ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
				ВыборкаДетальныеЗаписи.ГФУДоход,
				ВалютаДохода, 
				"Закрытие доначисления по резервам",
				Неопределено,
				- ВыборкаДетальныеЗаписи.СуммаОстатокДоход * КоэффициентЗакрытияРезерва);
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.СуммаОстатокРасход > 0 Тогда
	    	БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
				ЭтотОбъект,
				ПланыСчетов.Единый.ДоходыРасходыПоРезервам02,
				ВыборкаДетальныеЗаписи.ЦеннаяБумага, 
				ВыборкаДетальныеЗаписи.ГФУРасход,
				ВалютаДохода, 
				"Закрытие доначисления по резервам",
				Неопределено,
				ВыборкаДетальныеЗаписи.СуммаОстатокРасход * КоэффициентЗакрытияРезерва);
		КонецЕсли;
		
	КонецЦикла;
	
	ОтнесениеНачисленныхДоходовНаАктивыВДУПоКурсовымРазницамЦенныхБумаг(ЭтотОбъект, ДоляЗакрытия);
	
КонецПроцедуры

Процедура ОтнесениеНачисленныхДоходовНаАктивыВДУПоКурсовымРазницамЦенныхБумаг(ЭтотОбъект, ДоляЗакрытия = 1, Регистратор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Организация КАК Организация,
		|	БухПартииЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Количество КАК Количество,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ТаблицаПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ПериодОстатков,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Организация = БухПартииЦенныхБумагОстатки.Организация
		|			И БухПартииЦенныхБумаг.СчетДоверительногоУправления = БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления
		|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|			И БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.КурсовыеРазницыСНачалаГода <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.СтоимостьВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.СтоимостьВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета < 0
		|					ТОГДА 0
		|				ИНАЧЕ БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета
		|			КОНЕЦ, 0)) КАК ПоложительныеРазницы,
		|	СУММА(ЕСТЬNULL(ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.СтоимостьВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.СтоимостьВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|			КОНЕЦ + ВЫБОР
		|				КОГДА БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета > 0
		|					ТОГДА 0
		|				ИНАЧЕ -БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета
		|			КОНЕЦ, 0)) КАК ОтрицательныеРазницы,
		|	ТаблицаПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаПартий.Партия КАК Партия,
		|	ТаблицаПартий.СтрокаПартии КАК СтрокаПартии,
		|	ТаблицаПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТаблицаПартий.Количество КАК Количество,
		|	ТаблицаПартий.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	ТаблицаПартий КАК ТаблицаПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ПО ТаблицаПартий.Организация = БухПартииЦенныхБумаг.Организация
		|			И ТаблицаПартий.СчетДоверительногоУправления = БухПартииЦенныхБумаг.СчетДоверительногоУправления
		|			И ТаблицаПартий.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага
		|			И ТаблицаПартий.Партия = БухПартииЦенныхБумаг.Партия
		|			И ТаблицаПартий.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага
		|			И ТаблицаПартий.СтрокаПартии = БухПартииЦенныхБумаг.СтрокаПартии
		|			И ТаблицаПартий.УчетныйАктивЕПС = БухПартииЦенныхБумаг.УчетныйАктивЕПС
		|			И (БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода)
		|			И (БухПартииЦенныхБумаг.КурсовыеРазницыСНачалаГода <> 0)
		|			И (БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПартий.ЦеннаяБумага,
		|	ТаблицаПартий.Партия,
		|	ТаблицаПартий.СтрокаПартии,
		|	ТаблицаПартий.УчетныйАктивЕПС,
		|	ТаблицаПартий.Количество,
		|	ТаблицаПартий.КоличествоОстаток";
	
	Запрос.УстановитьПараметр("НачалоПериода", ОпределитьДатуНачалаБухгалтерскогоПериода(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ОкончаниеПериода", ЭтотОбъект.Дата);
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Если Регистратор = Неопределено Тогда
	
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("ПериодОстатков", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		
	Иначе // погашение
		
		Запрос.УстановитьПараметр("Регистратор", Регистратор);
		Запрос.УстановитьПараметр("ПериодОстатков", Новый Граница(Регистратор.МоментВремени(), ВидГраницы.Исключая));
		
	КонецЕсли;
	
	ВалютаДохода  = ЭтотОбъект.Организация.ВалютаУчета;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Регистратор <> Неопределено И ВыборкаДетальныеЗаписи.Количество = 0 Тогда // погашение, гасим все
			ДоляЗакрытия = 1;	
		Иначе
			ДоляЗакрытия = ВыборкаДетальныеЗаписи.КоличествоОстаток / ВыборкаДетальныеЗаписи.Количество;
		КонецЕсли;
		
		КурсовыеРазницыСНачалаГода = Окр(ВыборкаДетальныеЗаписи.ПоложительныеРазницы * ДоляЗакрытия, 2);
		Если КурсовыеРазницыСНачалаГода <> 0 Тогда
			СчетУчетаДоходов = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			ГруппаФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(СчетУчетаДоходов, ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала);
	    	БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по курсовым разницам", Неопределено, -КурсовыеРазницыСНачалаГода);
		КонецЕсли;
		
		КурсовыеРазницыСНачалаГода = Окр(ВыборкаДетальныеЗаписи.ОтрицательныеРазницы * ДоляЗакрытия, 2);
		Если КурсовыеРазницыСНачалаГода <> 0 Тогда
			СчетУчетаДоходов = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			ГруппаФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(СчетУчетаДоходов, ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала);
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(ЭтотОбъект, СчетУчетаДоходов, ВыборкаДетальныеЗаписи.ЦеннаяБумага, ГруппаФинансовогоУчетаДоходовРасходов, ВалютаДохода, "Закрытие доначисления по курсовым разницам", Неопределено, КурсовыеРазницыСНачалаГода);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗакрытьКорректировки710(ЭтотОбъект, ЦеннаяБумага, НаДату = "", УчетныйАктивВходящий = Неопределено, УчитыватьПартииНаСчетахУчета = Ложь, ЗакрыватьКорректировкуЭСП = Истина) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И ЭтотОбъект.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
	КонецЕсли;
	
	ЭтотОбъект.Движения.Записать();
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ЭтотОбъект.Дата;
	КонецЕсли;
	
	Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		УчетныйАктив = Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(ЦеннаяБумага, НаДату);
		Валюта = ЦеннаяБумага.БанковскийСчет.Валюта;
	Иначе
		УчетныйАктив = УчетныйАктивВходящий;
		Валюта = ЦеннаяБумага.ВалютаНоминала;
	КонецЕсли;
	
	Если ЗакрыватьКорректировкуЭСП Тогда
	
		АналитикаДоходов = УчетныйАктив.АналитикаДоходовОтКорректировки;
		АналитикаРасходов = УчетныйАктив.АналитикаРасходовОтКорректировки;
		
	Иначе // закрываем корректировку ПП
		
		АналитикаДоходов = УчетныйАктив.АналитикаДоходовПервоначальногоПризнания;
		АналитикаРасходов = УчетныйАктив.АналитикаРасходовПервоначальногоПризнания;
		
	КонецЕсли;
	
	СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаДоходов.НомерСчетаБухгалтерскогоУчета);
	СчетУчетаРасходов = ПланыСчетов.Единый.НайтиПоКоду(АналитикаРасходов.НомерСчетаБухгалтерскогоУчета);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокДт - ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СуммаКорректировкиА,
		|	0 КАК СуммаКорректировкиП
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&Период,
		|			Период,
		|			,
		|			Счет = &СчетУчетаКорректировокА,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &АналитикаРасходов
		|				И Субконто2 = &ЦеннаяБумага) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт - ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&Период,
		|			Период,
		|			,
		|			Счет = &СчетУчетаКорректировокП,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &АналитикаДоходов
		|				И Субконто2 = &ЦеннаяБумага) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты";
	
	
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"	, УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГода"						, Новый Граница(НачалоГода(НаДату), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период"							, Новый Граница(НаДату, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВидыСубконто"					, ВидыСубконто);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокА"			, СчетУчетаРасходов);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокП"			, СчетУчетаДоходов);
	Запрос.УстановитьПараметр("АналитикаРасходов"				, АналитикаРасходов);
	Запрос.УстановитьПараметр("АналитикаДоходов"				, АналитикаДоходов);
	Запрос.УстановитьПараметр("ЦеннаяБумага"					, ЦеннаяБумага);
	
	Если УчитыватьПартииНаСчетахУчета Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"0 КАК СуммаКорректировкиП",
			"0 КАК СуммаКорректировкиП,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт - ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт",
			"ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт - ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет");
		
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Проводка = Неопределено;
		
		Если ВыборкаДетальныеЗаписи.СуммаКорректировкиА > 0 Тогда

			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СуммаКорректировкиА, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка");
			
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
		
			Проводка.СчетКт = СчетУчетаРасходов;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаРасходов;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СуммаКорректировкиА < 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(- ВыборкаДетальныеЗаписи.СуммаКорректировкиА, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка");
			
			Проводка.СчетДт = СчетУчетаРасходов;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаРасходов;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СуммаКорректировкиП > 0 Тогда
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.СуммаКорректировкиП, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка");
			
			Проводка.СчетДт = СчетУчетаДоходов;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаДоходов;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.СуммаКорректировкиП < 0 Тогда
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(- ВыборкаДетальныеЗаписи.СуммаКорректировкиП, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Корректировка");
			
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			
			Проводка.СчетКт = СчетУчетаДоходов;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
	    КонецЕсли;
		
		Если Проводка <> Неопределено И УчитыватьПартииНаСчетахУчета Тогда
		
			Проводка.Партия = ВыборкаДетальныеЗаписи.ЛицевойСчет.Партия;	
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.ЛицевойСчет.СтрокаПартии;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
КонецПроцедуры

Процедура ЗакрытьКорректировки206(ЭтотОбъект, КредитныйИнструмент) Экспорт
	
	// эта процедура предназначена для "заметания под коврик" корректировок ЭСП по депозитам по АС
	// дело в том, что из-за больших номиналов часто вылезают погрешности расчета ЭСП + депозиты закрываются не точно в день закрытия
	// эта процедура и списывает их на доходы/расходы
	//
	// так же прикрутил эту процедуру к МНО - т.к. там в принципе никогда не выйдет корректировка ЭСП в ноль
	// поэтому, эта процедура самое то для списания корректировок по ЭСП по МНО
	
	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И ЭтотОбъект.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
	КонецЕсли;
	
	ЭтотОбъект.Движения.Записать();

	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	ТипИнструмента = ТипЗнч(КредитныйИнструмент);
	Если ТипИнструмента = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		БанковскийСчет	= КредитныйИнструмент.БанковскийСчет;
		УчетныйАктив	= Справочники.ДепозитныеВклады.ОпределитьУчетныйАктивДепозита(КредитныйИнструмент, ЭтотОбъект.Дата);
		ВерхнийЛимит	= 1;
		НижнийЛимит		= -1;
	ИначеЕсли ТипИнструмента = Тип("ДокументСсылка.МНО") Тогда
		БанковскийСчет	= КредитныйИнструмент.РасчетныйСчет;
		УчетныйАктив	= Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО;
		ВерхнийЛимит	= КредитныйИнструмент.Сумма;
		НижнийЛимит		= -КредитныйИнструмент.Сумма;
	Иначе
		ВызватьИсключение "В настоящий момент не поддерживается начисление корректировок ЭСП по виду кредитного инструмента: " + Строка(ТипИнструмента);
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настоящий момент не поддерживается начисление корректировок ЭСП по виду кредитного инструмента: " + Строка(ТипИнструмента));
		Возврат;
	КонецЕсли;
	
	СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаДоходовОтКорректировки.НомерСчетаБухгалтерскогоУчета);
	СчетУчетаРасходов = ПланыСчетов.Единый.НайтиПоКоду(УчетныйАктив.АналитикаРасходовОтКорректировки.НомерСчетаБухгалтерскогоУчета);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт КАК ОстатокКорректировки,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК КредитныйИнструмент,
		|	""КорректировкаА"" КАК ВидКорректировки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетУчетаКорректировокА,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &БанковскиеСчета
		|				И Субконто2 = &КредитныйИнструмент) КАК БухгалтерскийУчетОстатки
		|ГДЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокДт < &ВерхнийЛимит
		|	И БухгалтерскийУчетОстатки.СуммаОстатокДт > &НижнийЛимит
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухгалтерскийУчетОстатки.СуммаОстатокКт,
		|	БухгалтерскийУчетОстатки.Субконто2,
		|	""КорректировкаП""
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетУчетаКорректировокП,
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &БанковскиеСчета
		|				И Субконто2 = &КредитныйИнструмент) КАК БухгалтерскийУчетОстатки
		|ГДЕ
		|	БухгалтерскийУчетОстатки.СуммаОстатокКт < &ВерхнийЛимит
		|	И БухгалтерскийУчетОстатки.СуммаОстатокКт > &НижнийЛимит";
		
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", УчетныйСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период"						, Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВидыСубконто"				, ВидыСубконто);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокА"		, УчетныйАктив.СчетУчетаКорректировокА);
	Запрос.УстановитьПараметр("СчетУчетаКорректировокП"		, УчетныйАктив.СчетУчетаКорректировокП);
	Запрос.УстановитьПараметр("БанковскиеСчета"				, БанковскийСчет);
	Запрос.УстановитьПараметр("КредитныйИнструмент"			, КредитныйИнструмент);
	Запрос.УстановитьПараметр("ВерхнийЛимит"				, ВерхнийЛимит);
	Запрос.УстановитьПараметр("НижнийЛимит"					, НижнийЛимит);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидКорректировки = "КорректировкаА" Тогда
			
			Если ВыборкаДетальныеЗаписи.ОстатокКорректировки > 0 Тогда
				СуммаКорректировки = ВыборкаДетальныеЗаписи.ОстатокКорректировки;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаКорректировки, "Корректировка");
				
				Проводка.СчетДт = СчетУчетаРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтКорректировки;
				Проводка.СубконтоДт.ЦенныеБумаги = КредитныйИнструмент;
				
				Проводка.СчетКт = УчетныйАктив.СчетУчетаКорректировокА;
				Проводка.СубконтоКт.БанковскиеСчета = БанковскийСчет;
				Проводка.СубконтоКт.ДепозитныеВклады = КредитныйИнструмент;
				Проводка.ВалютаКт  = БанковскийСчет.Валюта;
				Проводка.ВалютнаяСуммаКт = СуммаКорректировки;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ОстатокКорректировки < 0 Тогда
				
				СуммаКорректировки = - ВыборкаДетальныеЗаписи.ОстатокКорректировки;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаКорректировки, "Корректировка");
				
				Проводка.СчетДт = УчетныйАктив.СчетУчетаКорректировокА;
				Проводка.СубконтоДт.БанковскиеСчета = БанковскийСчет;
				Проводка.СубконтоДт.ДепозитныеВклады = КредитныйИнструмент;
				Проводка.ВалютаДт  = БанковскийСчет.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаКорректировки;
				
				Проводка.СчетКт = СчетУчетаДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтКорректировки;
				Проводка.СубконтоКт.ЦенныеБумаги = КредитныйИнструмент;
				
			КонецЕсли;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.ВидКорректировки = "КорректировкаП" Тогда
			
			Если ВыборкаДетальныеЗаписи.ОстатокКорректировки > 0 Тогда
				СуммаКорректировки = ВыборкаДетальныеЗаписи.ОстатокКорректировки;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаКорректировки, "Корректировка");
				
				Проводка.СчетДт = УчетныйАктив.СчетУчетаКорректировокП;
				Проводка.СубконтоДт.БанковскиеСчета = БанковскийСчет;
				Проводка.СубконтоДт.ДепозитныеВклады = КредитныйИнструмент;
				Проводка.ВалютаДт  = БанковскийСчет.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаКорректировки;
				
				Проводка.СчетКт = СчетУчетаДоходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтКорректировки;
				Проводка.СубконтоКт.ЦенныеБумаги = КредитныйИнструмент;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ОстатокКорректировки < 0 Тогда
				
				СуммаКорректировки = - ВыборкаДетальныеЗаписи.ОстатокКорректировки;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаКорректировки, "Корректировка");
				
				Проводка.СчетДт = СчетУчетаРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтКорректировки;
				Проводка.СубконтоДт.ЦенныеБумаги = КредитныйИнструмент;
				
				Проводка.СчетКт = УчетныйАктив.СчетУчетаКорректировокП;
				Проводка.СубконтоКт.БанковскиеСчета = БанковскийСчет;
				Проводка.СубконтоКт.ДепозитныеВклады = КредитныйИнструмент;
				Проводка.ВалютаКт  = БанковскийСчет.Валюта;
				Проводка.ВалютнаяСуммаКт = СуммаКорректировки;
				
			КонецЕсли;
			
		КонецЕсли
	
	КонецЦикла;
	
	ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
КонецПроцедуры

Процедура Закрыть7ойРазделПоПартии(ОбъектДокумента, УчетныйРегистр, ПараметрыЗакрытия) Экспорт

	//закрыть 7 раздел
	Если ПараметрыЗакрытия.ДоходРасход > 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыЗакрытия.ДоходРасход, "Закрытие дохода");
		
		// дебет
		Проводка.СчетДт = ПараметрыЗакрытия.СчетДоходов;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыЗакрытия.АналитикаДоходов;
		Проводка.СубконтоДт.ЦенныеБумаги         = ПараметрыЗакрытия.ЦеннаяБумага;
		
		Если ПараметрыЗакрытия.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт
			ИЛИ ПараметрыЗакрытия.Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный Тогда
		
			Проводка.ДополнительнаяАналитикаДт = ПараметрыЗакрытия.Аналитика;
		
		КонецЕсли;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютаДт = ПараметрыЗакрытия.ВалютаУчета;
			Проводка.ВалютнаяСуммаДт = ПараметрыЗакрытия.ДоходРасход;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = ПараметрыЗакрытия.СчетДоверительногоУправления;
		
		Проводка.Партия = ПараметрыЗакрытия.Партия;
		Проводка.СтрокаПартии = ПараметрыЗакрытия.СтрокаПартии;
	
	ИначеЕсли ПараметрыЗакрытия.ДоходРасход < 0 Тогда
						
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], -ПараметрыЗакрытия.ДоходРасход, "Закрытие расхода");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = ПараметрыЗакрытия.СчетДоверительногоУправления;
		
		// кредит
		Проводка.СчетКт = ПараметрыЗакрытия.СчетРасходов;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПараметрыЗакрытия.АналитикаРасходов;
		Проводка.СубконтоКт.ЦенныеБумаги         = ПараметрыЗакрытия.ЦеннаяБумага;
		
		Проводка.Партия = ПараметрыЗакрытия.Партия;
		Проводка.СтрокаПартии = ПараметрыЗакрытия.СтрокаПартии;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютаКт = ПараметрыЗакрытия.ВалютаУчета;
			Проводка.ВалютнаяСуммаКт = -ПараметрыЗакрытия.ДоходРасход;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьРасходы(ОбъектДокумента, ПараметрыСписания, Отказ) Экспорт

	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	ТаблицаДоговоров = ПараметрыСписания.ТаблицаДоговоров;
	ВидЗадолженности = ПараметрыСписания.ВидЗадолженности;
	ВалютаОперации 	 = ?(ПараметрыСписания.Свойство("ВалютаОперации"), ПараметрыСписания.ВалютаОперации, Неопределено);
	
	ПараметрыСписания.Вставить("ОбъектДокумента", ОбъектДокумента);
	ПараметрыСписания.Вставить("ВалютаОперации", ВалютаОперации);
	
	Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам Тогда
		СодержаниеОперации = "Закрытие доходов";
	Иначе
		СодержаниеОперации = "Закрытие расходов";
	КонецЕсли; 
	
	Выборка = ПолучитьВыборкуДляЗакрытияРасходов(ПараметрыСписания);
	
	Если ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.НачислениеЗадолженности") Тогда
		
		ГруппаФинансовогоУчетаДоходовРасходов = ПараметрыСписания.ГруппаФинансовогоУчетаДоходовРасходов;
		
		Пока Выборка.Следующий() Цикл
			
			ВалютнаяСумма = Мин(Выборка.Сумма, Выборка.ВалютнаяСуммаОстаток);
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВалютнаяСумма, ВалютаОперации, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
			
			Если СуммаОперации <= 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеОперации);
			
			//дебет
			Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры 	= УчетныйСчетДоверительногоУправления;
			
			// кредит
			Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии ИЛИ ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности02;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана группа финансового учета доходов и расходов!", ОбъектДокумента.Ссылка, "ГруппыФинансовогоУчетаДоходовРасходов",, Отказ);
				Возврат;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.НайтиПоКоду(ГруппаФинансовогоУчетаДоходовРасходов.НомерСчетаБухгалтерскогоУчета);
			КонецЕсли; 
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
			
		КонецЦикла; 
		
	ИначеЕсли ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.Оплата") Тогда	
		
		Пока Выборка.Следующий() Цикл
			
			ГруппаФинансовогоУчетаДоходовРасходов = Выборка.ГруппаФинансовогоУчетаДоходовРасходов;
			
			Если Не ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана группа финансового учета доходов и расходов!", ОбъектДокумента.Ссылка, "ГруппыФинансовогоУчетаДоходовРасходов",, Отказ);
				Возврат;	
			КонецЕсли; 
			
			СчетДоходовРасходов = ПланыСчетов.Единый.НайтиПоКоду(ГруппаФинансовогоУчетаДоходовРасходов.НомерСчетаБухгалтерскогоУчета);
			
			ВалютнаяСумма = Мин(Выборка.Сумма, Выборка.ВалютнаяСуммаОстаток);
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВалютнаяСумма, Выборка.Валюта, ОбъектДокумента.Организация, ОбъектДокумента.Дата);
			
			Если СуммаОперации <= 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, СодержаниеОперации);
			
			Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПрочимДоходам Тогда
				//дебет
				Проводка.СчетДт 				= СчетДоходовРасходов;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
				
				// кредит
				Проводка.СчетКт 				= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры 	= УчетныйСчетДоверительногоУправления;
			Иначе
				//дебет
				Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры 	= УчетныйСчетДоверительногоУправления;
				
				Проводка.СчетКт					 = СчетДоходовРасходов;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ЗакрытьПарныеСчетаДоходовРасходов(ОбъектДокумента, МассивУчетныхАктивов, ЗакрыватьПереоценки, ЗакрыватьКорректировкиЭСП, МассивЦенныхБумаг = Неопределено, Отказ) Экспорт

	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ОбъектДокумента.Дата, ОбъектДокумента.Организация, УчетныйСчетДоверительногоУправления);
	
	Если НастройкиУчета.НеСворачиватьПоПарнымСчетамДоходыРасходыОтПереоценки Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОстатков = Неопределено;
	ЕстьСвойствоТаблицаОстатков = ОбъектДокумента.ДополнительныеСвойства.Свойство("ТаблицаОстатковПоПарнымСчетамДоходовРасходов", ТаблицаОстатков);
	Если НЕ ЕстьСвойствоТаблицаОстатков Тогда
		ТаблицаОстатков = ПолучитьТаблицуОстатковПоПарнымСчетамДоходовРасходов(Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая),
																				ОбъектДокумента.Организация, 
																				УчетныйСчетДоверительногоУправления,
																				ЗакрыватьПереоценки,
																				ЗакрыватьКорректировкиЭСП,
																				МассивУчетныхАктивов,
																				МассивЦенныхБумаг,
																				ОбъектДокумента.Ссылка);
		Если ТаблицаОстатков = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВидСубконтоГФУДоходовРасходов = ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов;
	ВидСубконтоЦенныеБумаги = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;
	
	Движения = ОбъектДокумента.Движения;
	НаборЗаписей = Движения.ЕдиныйБухгалтерскийУчет;
	
	Если ОбъектДокумента.ДополнительныеСвойства.Свойство("ЗаписьВСоставеФБУ") И ОбъектДокумента.ДополнительныеСвойства.ЗаписьВСоставеФБУ Тогда
		НаборЗаписей.ДополнительныеСвойства.Вставить("ЗаписьВСоставеФБУ", Истина);
	КонецЕсли;
	
	НаборЗаписей.Записать();
		
	ВсегоЗаписей = НаборЗаписей.Количество();
	ТекИндекс = 0;
	
	ПараметрыОбработки = Новый Структура;
		
	ПараметрыОбработки.Вставить("ОбъектДокумента", 	ОбъектДокумента);
	ПараметрыОбработки.Вставить("НаборЗаписей", 	НаборЗаписей);
	ПараметрыОбработки.Вставить("ВидСубконтоГФУДоходовРасходов", 	ВидСубконтоГФУДоходовРасходов);
	ПараметрыОбработки.Вставить("ВидСубконтоЦенныеБумаги", 			ВидСубконтоЦенныеБумаги);
	
	// заглушка для валютных операций
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	
	Пока ТекИндекс < ВсегоЗаписей Цикл
	
		Запись = НаборЗаписей[ТекИндекс];
		
		// дебет
		УвеличениеОстатка 		= (Запись.СчетДт.Вид = ВидСчета.Активный);
		ПостфиксОстатка 		= ?(УвеличениеОстатка, "А", "П");
		ПостфиксПарногоОстатка 	= ?(УвеличениеОстатка, "П", "А");
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Счет" + ПостфиксОстатка, 		Запись.СчетДт);
		СтруктураОтбора.Вставить("Аналитика" + ПостфиксОстатка, Запись.СубконтоДт[ВидСубконтоГФУДоходовРасходов]);
		СтруктураОтбора.Вставить("ЦеннаяБумага", 				Запись.СубконтоДт[ВидСубконтоЦенныеБумаги]);
		НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтруктураОтбора.Вставить("ЦеннаяБумага", Неопределено);
			НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураОтбора);
			Если НайденныеСтроки.Количество() = 1 Тогда
				НоваяСтрока = ТаблицаОстатков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
				НайденныеСтроки[0].ЦеннаяБумага = Запись.СубконтоДт[ВидСубконтоЦенныеБумаги];
			КонецЕсли; 
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() = 1 Тогда
			
			// заглушка для валютных операций
			Если Запись.СчетДт.Валютный И Запись.ВалютаДт <> ВалютаУчета Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В проводке №" + Строка(ТекИндекс + 1) + " валюта дебета отличается от валюты учета. Обработка парных счетов доходов/расходов для этой проводки не выполнена", ОбъектДокумента.Ссылка);
				Продолжить;
			КонецЕсли; 
		
			СтрокаОстатков = НайденныеСтроки[0];
			ПараметрыОбработки.Вставить("СтрокаОстатков", 		СтрокаОстатков);
			ПараметрыОбработки.Вставить("Запись", 				Запись);
			ПараметрыОбработки.Вставить("УвеличениеОстатка", 	УвеличениеОстатка);
			ПараметрыОбработки.Вставить("ПостфиксСчета", 		"Дт");
			ПараметрыОбработки.Вставить("ПостфиксОстатка", 		ПостфиксОстатка);
			ПараметрыОбработки.Вставить("ПостфиксПарногоСчета", "Кт");
			ПараметрыОбработки.Вставить("ПостфиксПарногоОстатка", ПостфиксПарногоОстатка);
			
			Если СтрокаОстатков.ЭтоКорректировка Тогда
				РезультатРаботы	= ОбработатьЗаписьПоСчетамКорректировок(ПараметрыОбработки);
			Иначе
				РезультатРаботы	= ОбработатьЗаписьПоСчетамПереоценки(ПараметрыОбработки);			
			КонецЕсли; 

			// если добавляли проводку, то:
			// 	сдвигаем ее назад, чтобы была после текущей
			// 	увеличиваем ВсегоЗаписей
			//	встаем на нее - увеличиваем ТекИндекс
			//
			// Мы делаем это потому, что нам очень ВАЖЕН ПОРЯДОК ПРОВОДОК 
			// и процедура ОбработатьДвиженияДокументаПоПарнымСчетам, которую мы вызываем после этой может отработать неправильно
			
			Если РезультатРаботы.ДобавилиПроводку Тогда
				НаборЗаписей.Сдвинуть(НаборЗаписей[ВсегоЗаписей], ТекИндекс - ВсегоЗаписей + 1);
				
				ВсегоЗаписей = ВсегоЗаписей + 1; 
				ТекИндекс = ТекИндекс + 1;
			КонецЕсли;

			Если РезультатРаботы.ДобавилиПроводкуЗакрытия Тогда
				НаборЗаписей.Сдвинуть(НаборЗаписей[ВсегоЗаписей], ТекИндекс - ВсегоЗаписей + 1);
				
				ВсегоЗаписей = ВсегоЗаписей + 1;
				ТекИндекс = ТекИндекс + 1;
			КонецЕсли;
			
		ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда
			ВызватьИсключение "Ошибка при определении остатков по счетам доходов и расходов.";
		КонецЕсли;
		
		
		// кредит
		УвеличениеОстатка 		= (Запись.СчетКт.Вид = ВидСчета.Пассивный);
		ПостфиксОстатка 		= ?(УвеличениеОстатка, "П", "А");
		ПостфиксПарногоОстатка 	= ?(УвеличениеОстатка, "А", "П");
				
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Счет" + ПостфиксОстатка, 		Запись.СчетКт);
		СтруктураОтбора.Вставить("Аналитика" + ПостфиксОстатка, Запись.СубконтоКт[ВидСубконтоГФУДоходовРасходов]);
		СтруктураОтбора.Вставить("ЦеннаяБумага", 				Запись.СубконтоКт[ВидСубконтоЦенныеБумаги]);
		НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			СтруктураОтбора.Вставить("ЦеннаяБумага", Неопределено);
			НайденныеСтроки = ТаблицаОстатков.НайтиСтроки(СтруктураОтбора);
			Если НайденныеСтроки.Количество() = 1 Тогда
				НоваяСтрока = ТаблицаОстатков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);
				НайденныеСтроки[0].ЦеннаяБумага = Запись.СубконтоКт[ВидСубконтоЦенныеБумаги];
			КонецЕсли; 
		КонецЕсли;
		
		РезультатРаботы	= Неопределено;
		
		Если НайденныеСтроки.Количество() = 1 Тогда
			
			// заглушка для валютных операций
			Если Запись.СчетКт.Валютный И Запись.ВалютаКт <> ВалютаУчета Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В проводке №" + ТекИндекс + " валюта кредита отличается от валюты учета. Обработка парных счетов доходов/расходов для этой проводки не выполнена", ОбъектДокумента.Ссылка);
				Продолжить;
			КонецЕсли;
			
			СтрокаОстатков = НайденныеСтроки[0];
			ПараметрыОбработки.Вставить("СтрокаОстатков", 		СтрокаОстатков);
			ПараметрыОбработки.Вставить("Запись", 				Запись);
			ПараметрыОбработки.Вставить("УвеличениеОстатка", 	УвеличениеОстатка);
			ПараметрыОбработки.Вставить("ПостфиксСчета", 		"Кт");
			ПараметрыОбработки.Вставить("ПостфиксОстатка", 		ПостфиксОстатка);
			ПараметрыОбработки.Вставить("ПостфиксПарногоСчета", "Дт");
			ПараметрыОбработки.Вставить("ПостфиксПарногоОстатка", ПостфиксПарногоОстатка);
			
			Если СтрокаОстатков.ЭтоКорректировка Тогда
				// обрабатываем как парные: если требуется - меняем счет в проводке,
				// если после этого ушли в минус - добавляем проводку по перебросу минуса на парный счет 
				// например 71005 был кр. остаток 90, документ пришел сюда с проводкой 71006-50156 на сумму 110
				// меняем счет на парный в исходной проводке, получаем 71005-50156 (110), в результате на 71005 оразуется дт. остаток 20
				// добавляем проводку 71006-71005 (20)
				РезультатРаботы	= ОбработатьЗаписьПоСчетамКорректировок(ПараметрыОбработки);
			Иначе
				// обрабатываем иначе: если требуется - меняем счет в проводке,
				// если после этого ушли в минус - корректируем сумму в этой проводке и добавляем такую же с парным счетом на разность
				// например 71503 был кр. остаток 90, документ пришел сюда с проводкой 71504-50131 на сумму 110
				// меняем счет на парный в исходной проводке, получаем 71503-50131, чтобы не уйти в минус меняем сумму на 90
				// добавляем проводку 71504-50131 (20)
				РезультатРаботы	= ОбработатьЗаписьПоСчетамПереоценки(ПараметрыОбработки);			
			КонецЕсли;
			
			// если добавляли проводку, то:
			// 	сдвигаем ее назад, чтобы была после текущей
			// 	увеличиваем ВсегоЗаписей
			//	встаем на нее - увеличиваем ТекИндекс
			//
			// Мы делаем это потому, что нам очень ВАЖЕН ПОРЯДОК ПРОВОДОК 
			// и процедура ОбработатьДвиженияДокументаПоПарнымСчетам, которую мы вызываем после этой может отработать неправильно
			
			Если РезультатРаботы.ДобавилиПроводку Тогда
				НаборЗаписей.Сдвинуть(НаборЗаписей[ВсегоЗаписей], ТекИндекс - ВсегоЗаписей + 1);
				
				ВсегоЗаписей = ВсегоЗаписей + 1;
				ТекИндекс = ТекИндекс + 1;
			КонецЕсли;
			
			Если РезультатРаботы.ДобавилиПроводкуЗакрытия Тогда
				НаборЗаписей.Сдвинуть(НаборЗаписей[ВсегоЗаписей], ТекИндекс - ВсегоЗаписей + 1);
				
				ВсегоЗаписей = ВсегоЗаписей + 1;
				ТекИндекс = ТекИндекс + 1;
			КонецЕсли;
			
		ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда
			ВызватьИсключение "Ошибка при определении остатков по счетам доходов и расходов.";
		КонецЕсли;
		
		ТекИндекс = ТекИндекс + 1;		
		
	КонецЦикла; 
	
	Если ЕстьСвойствоТаблицаОстатков Тогда
		ОбъектДокумента.ДополнительныеСвойства.Вставить("ТаблицаОстатковПоПарнымСчетамДоходовРасходов", ТаблицаОстатков);
	КонецЕсли;
	
КонецПроцедуры

Процедура СписатьКурсовыеРазницы(ОбъектДокумента, Отказ) Экспорт
	
	//Возврат;
	ТаблицаСчетовИСубконто = Новый ТаблицаЗначений;
	
	
	СписокТиповСубконто = РаботаСМетаданнымиПовтИсп.ПолучитьСписокТиповСубконто();	
	
	ВалютаУчета = ОбъектДокумента.Организация.ВалютаУчета;
	МассивДопАналитикиПоЦБ = Новый Массив;
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
	МассивДопАналитикиПоЦБ.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА КАК Счет
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаРезервов
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКупона
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокА
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокП
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСчетовУчетаБумаг = РезультатЗапроса.Выгрузить();
	
	ТаблицаСчетовИСубконто.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.Единый"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто1", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто2", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Субконто3", Новый ОписаниеТипов(СписокТиповСубконто));
	ТаблицаСчетовИСубконто.Колонки.Добавить("ДополнительнаяАналитика", Новый ОписаниеТипов("СправочникСсылка.ДополнительныеАналитикиЛицевыхСчетов"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("СуммаВВалютеУчета", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаСчетовИСубконто.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	ВидыСубконто = Новый Массив;
	
	ДтКт = Новый Массив;
	ДтКт.Добавить("Дт");
	ДтКт.Добавить("Кт");
	
	Для Каждого Проводка из ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет Цикл
		Для Инд = 0 По ДтКт.ВГраница() Цикл
		
			// балансовые счета должны быть заполнены
			ТекДтКт = ДтКт[Инд];
			ТекСчет = Проводка["Счет" + ТекДтКт];
			ТекДопАналитика = Проводка["ДополнительнаяАналитика" + ТекДтКт];
			ТекВалюта = Проводка["Валюта" + ТекДтКт];
			//убираем счета учета ЦБ, курсовые по ним - на партиях
			Если НЕ ТекСчет.Валютный Тогда
				Продолжить;
			КонецЕсли;
			Если ТекВалюта = ВалютаУчета Тогда 
				Продолжить;
			КонецЕсли;
			Если ТаблицаСчетовУчетаБумаг.Найти(ТекСчет, "Счет") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если МассивДопАналитикиПоЦБ.Найти(ТекДопАналитика) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = ТаблицаСчетовИСубконто.Добавить();
			СтрокаТаблицы.Счет = ТекСчет;
			
			СтрокаТаблицы.Субконто1 = Неопределено;
			СтрокаТаблицы.Субконто2 = Неопределено;
			СтрокаТаблицы.Субконто3 = Неопределено;
			
			// проверим заполнение субконто
			Для каждого СтрокаВидыСубконто Из ТекСчет.ВидыСубконто Цикл
				
				Если СтрокаВидыСубконто.ТолькоОбороты 
					Тогда Продолжить; 
				КонецЕсли;
				
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					СтрокаТаблицы.Субконто1 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					СтрокаТаблицы.Субконто2 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					СтрокаТаблицы.Субконто3 = Проводка["Субконто" + ТекДтКт][СтрокаВидыСубконто.ВидСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаТаблицы.ДополнительнаяАналитика = ТекДопАналитика;
			СтрокаТаблицы.СуммаВВалютеУчета = ?(ТекДтКт = "Кт", -1, 1) * Проводка.Сумма;
			СтрокаТаблицы.Сумма = ?(ТекДтКт = "Кт", -1, 1) * Проводка["ВалютнаяСумма" + ТекДтКт];
			СтрокаТаблицы.Валюта = ТекВалюта;

		КонецЦикла;		
	КонецЦикла;
	
	ТаблицаСчетовИСубконто.Свернуть("Счет,Субконто1,Субконто2,Субконто3,ДополнительнаяАналитика,Валюта", "СуммаВВалютеУчета,Сумма");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДвижений.Счет КАК Счет,
		|	ТаблицаДвижений.Субконто1 КАК Субконто1,
		|	ТаблицаДвижений.Субконто2 КАК Субконто2,
		|	ТаблицаДвижений.Субконто3 КАК Субконто3,
		|	ТаблицаДвижений.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ТаблицаДвижений.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаДвижений.Сумма КАК Сумма,
		|	ТаблицаДвижений.Валюта КАК Валюта
		|ПОМЕСТИТЬ ТаблицаДвижений
		|ИЗ
		|	&ТаблицаДвижений КАК ТаблицаДвижений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДоДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, ЛицевойСчет.ДополнительнаяАналитика, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ТаблицаДвижений.Субконто2 = НЕОПРЕДЕЛЕНО
		|						И ТаблицаДвижений.Субконто3 = НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто1 <> НЕОПРЕДЕЛЕНО
		|	И (ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ЕСТЬ NULL
		|			ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = НЕОПРЕДЕЛЕНО)
		|	И (ЕдиныйБухгалтерскийУчетОстатки.Субконто3 ЕСТЬ NULL
		|			ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Субконто3 = НЕОПРЕДЕЛЕНО)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДоДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, ЛицевойСчет.ДополнительнаяАналитика, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ТаблицаДвижений.Субконто2 <> НЕОПРЕДЕЛЕНО
		|						И ТаблицаДвижений.Субконто3 = НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто1 <> НЕОПРЕДЕЛЕНО
		|	И НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 <> НЕОПРЕДЕЛЕНО
		|	И (ЕдиныйБухгалтерскийУчетОстатки.Субконто3 ЕСТЬ NULL
		|			ИЛИ ЕдиныйБухгалтерскийУчетОстатки.Субконто3 = НЕОПРЕДЕЛЕНО)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДоДокумента,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаДвижений.Счет КАК Счет
		|				ИЗ
		|					ТаблицаДвижений КАК ТаблицаДвижений),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (Субконто1, ЛицевойСчет.ДополнительнаяАналитика, Валюта) В
		|					(ВЫБРАТЬ
		|						ТаблицаДвижений.Субконто1 КАК Субконто1,
		|						ТаблицаДвижений.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|						ТаблицаДвижений.Валюта КАК Валюта
		|					ИЗ
		|						ТаблицаДвижений КАК ТаблицаДвижений
		|					ГДЕ
		|						ТаблицаДвижений.Субконто2 <> НЕОПРЕДЕЛЕНО
		|						И ТаблицаДвижений.Субконто3 <> НЕОПРЕДЕЛЕНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто1 <> НЕОПРЕДЕЛЕНО
		|	И НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 <> НЕОПРЕДЕЛЕНО
		|	И НЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто3 ЕСТЬ NULL
		|	И ЕдиныйБухгалтерскийУчетОстатки.Субконто3 <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Вид КАК ВидСчета,
		|	Остатки.Субконто1 КАК Субконто1,
		|	Остатки.Субконто2 КАК Субконто2,
		|	Остатки.Субконто3 КАК Субконто3,
		|	Остатки.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	Остатки.Валюта КАК Валюта,
		|	Остатки.СуммаОстаток КАК СуммаОстаток,
		|	Остатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ТаблицаДвижений.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаДвижений.Сумма КАК Сумма
		|ИЗ
		|	Остатки КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДвижений КАК ТаблицаДвижений
		|		ПО Остатки.Счет = ТаблицаДвижений.Счет
		|			И Остатки.Субконто1 = ТаблицаДвижений.Субконто1
		|			И Остатки.Субконто2 = ТаблицаДвижений.Субконто2
		|			И Остатки.Субконто3 = ТаблицаДвижений.Субконто3
		|			И Остатки.ДополнительнаяАналитика = ТаблицаДвижений.ДополнительнаяАналитика
		|			И Остатки.Валюта = ТаблицаДвижений.Валюта";
	
	
	Запрос.Параметры.Вставить("Организация", ОбъектДокумента.Организация);
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
	Запрос.Параметры.Вставить("ДоДокумента", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.Параметры.Вставить("ТаблицаДвижений", ТаблицаСчетовИСубконто);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВидСубконтоЦеннаяБумага = ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги;
	
	//в результирующей таблице должно быть:
	//Дебетовые остатки остатки по активным счетам > 0, кредитовые остатки не обрабатываем. Кредитовый оборот по активному счету <0, 
	//Кредитовые остатки по пассивынм счетам >0, дебетовые остатки не обрабатываем
	//Процедура списывает курсовые разницы по счетам с остаткамив случае расхода (кредитовый оборот по активному счету и дебетовый - по пассивному).
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаКурсовойРазницы = 0;
		Если ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Активный И ВыборкаДетальныеЗаписи.СуммаОстаток > 0 И ВыборкаДетальныеЗаписи.Сумма < 0
			ИЛИ ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Пассивный И ВыборкаДетальныеЗаписи.СуммаОстаток < 0 И ВыборкаДетальныеЗаписи.Сумма > 0 Тогда
			СуммаКурсовойРазницы = ВыборкаДетальныеЗаписи.Сумма * ВыборкаДетальныеЗаписи.СуммаОстаток / ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстаток - ВыборкаДетальныеЗаписи.СуммаВВалютеУчета;
		КонецЕсли;
		
		Если СуммаКурсовойРазницы <> 0 ТОгда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ?(СуммаКурсовойРазницы<0,-1,1) * СуммаКурсовойРазницы, "Курсовая разница");
			
			ВалютаКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Валюта;
			СчетКурсовойРазницы 	= ВыборкаДетальныеЗаписи.Счет;
			Субконто1				= ВыборкаДетальныеЗаписи.Субконто1;
			Субконто2				= ВыборкаДетальныеЗаписи.Субконто2;
			Субконто3				= ВыборкаДетальныеЗаписи.Субконто3;
			
			УчетКурсовойРазницы = ПолучитьСчетДоходаРасходаПоКурсовойРазнице(ОбъектДокумента, СчетКурсовойРазницы, Субконто1, Субконто2, Субконто3, ВыборкаДетальныеЗаписи.ДополнительнаяАналитика, ВалютаКурсовойРазницы, СуммаКурсовойРазницы, Отказ);			
			
			ВидСубконто1 = Неопределено;
			ВидСубконто2 = Неопределено;
			ВидСубконто3 = Неопределено;
			
			Для каждого СтрокаВидыСубконто Из СчетКурсовойРазницы.ВидыСубконто Цикл
				Если СтрокаВидыСубконто.НомерСтроки = 1 Тогда
					ВидСубконто1 = СтрокаВидыСубконто.ВидСубконто;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 2 Тогда
					ВидСубконто2 = СтрокаВидыСубконто.ВидСубконто;
				ИначеЕсли СтрокаВидыСубконто.НомерСтроки = 3 Тогда
					ВидСубконто3 = СтрокаВидыСубконто.ВидСубконто;
				КонецЕсли;
			КонецЦикла;
			
			Если СуммаКурсовойРазницы > 0 Тогда
				Если ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Активный Тогда
					Проводка.СчетДт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоДт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоДт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоДт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаДт = ВалютаКурсовойРазницы;
					Проводка.ДополнительнаяАналитикаДт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитика;
					
					Проводка.СчетКт = УчетКурсовойРазницы.Счет;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
						Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаКурсовойРазницы);
					КонецЕсли;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
						Проводка.СубконтоКт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
					КонецЕсли;
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано списание курсовых разниц для пассивных счетов", ОбъектДокумента.Ссылка,,,Отказ);
				КонецЕсли;
			Иначе
				Если ВыборкаДетальныеЗаписи.ВидСчета = ВидСчета.Активный Тогда
					Проводка.СчетДт = УчетКурсовойРазницы.Счет;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов) Тогда
						Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетКурсовойРазницы.ГруппаФинансовогоУчетаДоходовРасходов;//ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаКурсовойРазницы);
					КонецЕсли;
					Если ЗначениеЗаполнено(УчетКурсовойРазницы.ЦеннаяБумага) Тогда
						Проводка.СубконтоДт.ЦенныеБумаги = УчетКурсовойРазницы.ЦеннаяБумага;
					КонецЕсли;
					
					Проводка.СчетКт = СчетКурсовойРазницы;
					Если ЗначениеЗаполнено(Субконто1) Тогда
						Проводка.СубконтоКт[ВидСубконто1] = Субконто1;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто2) Тогда
						Проводка.СубконтоКт[ВидСубконто2] = Субконто2;
					КонецЕсли;
					Если ЗначениеЗаполнено(Субконто3) Тогда
						Проводка.СубконтоКт[ВидСубконто3] = Субконто3;
					КонецЕсли;
					Проводка.ВалютаКт = ВалютаКурсовойРазницы;
					Проводка.ДополнительнаяАналитикаКт = ВыборкаДетальныеЗаписи.ДополнительнаяАналитика;
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано списание курсовых разниц для пассивных счетов", ОбъектДокумента.Ссылка,,,Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УчестьПредварительныеЗатраты(ОбъектДокумента, Сделка, ВидСделки, УчетныйАктив, ЦеннаяБумага, КонтрагентПоКомиссии, ВалютаУчета, ТаблицаПредварительныхЗатрат, Отказ) 
	
	Для каждого СтрокаПредварительныеЗатраты Из ТаблицаПредварительныхЗатрат Цикл
	
		КПогашению 			= СтрокаПредварительныеЗатраты.Сумма;
		КПогашениюВал 		= СтрокаПредварительныеЗатраты.ВалютнаяСумма;
		
		Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, КПогашению, "Списание предварительных затрат");
			
			// дебет
			Если УчетныйАктив.ВключатьРасходыПоПокупкеВСтоимость Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
				
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
				Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
				
				Проводка.ВалютаДт  = СтрокаПредварительныеЗатраты.Валюта;
				Проводка.ВалютнаяСуммаДт = КПогашениюВал;
			Иначе
				Проводка.СчетДт = УчетныйАктив.СчетУчетаРасходовОтОпераций;
				
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт        = СтрокаПредварительныеЗатраты.Валюта;
			Проводка.ВалютнаяСуммаКт = КПогашениюВал;
			
		ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, КПогашению, "Списание предварительных затрат");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ВыбытиеИРеализация10;
			
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт        = СтрокаПредварительныеЗатраты.Валюта;
			Проводка.ВалютнаяСуммаКт = КПогашениюВал;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ПереносПереоценкиСоСчетовДобавочногоКапиталаНаСчетаДоходовРасходов(ЭтотОбъект, УчетныйАктив, ЦеннаяБумага, ВалютаУчета, ДоходРасход, Партия = Неопределено, СтрокаПартии = Неопределено) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления);
	
	// все наоборот из-за запроса с минусами в функции ОтнесениеНачисленныхДоходовНаАктивыВДУПоЦеннымБумагам
	// кто-то когда-то так сделал, с тех пор и живем, хотя его мотивы вполне понятны - он хотел, чтобы суммы на 715ХХ совпадали с партиями по знаку, но все равно путаюсь
	
	// ДоходРасход > 0 означает ОТРИЦАТЕЛЬНУЮ переоценку, которая отражается по ДЕБЕТУ на счете 106ХХ и мы делаем Дт:715ХХ - Кт:106ХХ - везде аналитики РАСХОДОВ
	Если ДоходРасход > 0 Тогда 

		СчетУчетаДоходовРасходовОтПереоценки = ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Ложь);
		АналитикаПереноса = ОпределитьАналитикуПереноса(УчетныйАктив.АналитикаРасходовОтПереоценки);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ДоходРасход, "Перенос переоценки со счета добавочного капитала на счет доходов/расходов");
		
		Проводка.СчетДт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаПереноса;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаДт  = ВалютаУчета;
		Проводка.ВалютнаяСуммаДт = ДоходРасход;
		
		Проводка.СчетКт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтПереоценки;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаКт  = ВалютаУчета;
		Проводка.ВалютнаяСуммаКт = ДоходРасход;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ДоходРасход, "Перенос переоценки со счета добавочного капитала на счет доходов/расходов");
		
		Проводка.СчетДт = УчетныйАктив.СчетУчетаРасходовОтОпераций;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.СчетКт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаПереноса;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаКт  = ВалютаУчета;
		Проводка.ВалютнаяСуммаКт = ДоходРасход;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
	// ДоходРасход < 0 означает ПОЛОЖИТЕЛЬНУЮ переоценку, которая отражается по КРЕДИТУ на счете 106ХХ и мы делаем Дт:106ХХ - Кт:715ХХ - везде аналитики ДОХОДОВ
	ИначеЕсли ДоходРасход < 0 Тогда

		СчетУчетаДоходовРасходовОтПереоценки = ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив);
		АналитикаПереноса = ОпределитьАналитикуПереноса(УчетныйАктив.АналитикаДоходовОтПереоценки);
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ДоходРасход, "Перенос переоценки со счета добавочного капитала на счет доходов/расходов");
		
		Проводка.СчетДт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтПереоценки;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаДт = ВалютаУчета;
		Проводка.ВалютнаяСуммаДт = -ДоходРасход;
		
		Проводка.СчетКт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаПереноса;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаКт = ВалютаУчета;
		Проводка.ВалютнаяСуммаКт = -ДоходРасход;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ДоходРасход, "Перенос переоценки со счета добавочного капитала на счет доходов/расходов");
		
		Проводка.СчетДт = СчетУчетаДоходовРасходовОтПереоценки;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = АналитикаПереноса;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаДт = ВалютаУчета;
		Проводка.ВалютнаяСуммаДт = -ДоходРасход;
		
		Проводка.СчетКт = УчетныйАктив.СчетУчетаДоходовОтОпераций;
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтОпераций;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		
		Если Партия <> Неопределено Тогда
		
			Проводка.Партия = Партия;	
			Проводка.СтрокаПартии = СтрокаПартии;	
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура НачислитьКомиссию(ОбъектДокумента, ПараметрыНачисления, Отказ) Экспорт
	
	ЦБ 										= ПараметрыНачисления.ЦБ;
	УчетныйАктив							= ПараметрыНачисления.УчетныйАктив;
	ВидСделки								= ПараметрыНачисления.ВидСделки;
	СуммаКомисии 							= ПараметрыНачисления.СуммаКомисии;
	ВалютаКомиссии 							= ПараметрыНачисления.ВалютаКомиссии;
	СуммаОперации 							= ПараметрыНачисления.СуммаОперации;
	ВидКомиссии 							= ПараметрыНачисления.ВидКомиссии;
	КонтрагентПоКомиссии					= ПараметрыНачисления.КонтрагентПоКомиссии;
	Контрагент								= ?(ПараметрыНачисления.Свойство("Контрагент"), ПараметрыНачисления.Контрагент, КонтрагентПоКомиссии);
	ДоговорПоКомиссии						= ?(ПараметрыНачисления.Свойство("ДоговорПоКомиссии"), ПараметрыНачисления.ДоговорПоКомиссии, Неопределено);
	ВключатьРасходыПоПокупкеВСтоимость 		= ?(ПараметрыНачисления.Свойство("ВключатьРасходыПоПокупкеВСтоимость", ВключатьРасходыПоПокупкеВСтоимость), ВключатьРасходыПоПокупкеВСтоимость, Ложь);
	ГруппаФинансовогоУчетаДоходовРасходов	= ?(ПараметрыНачисления.Свойство("ГруппаФинансовогоУчетаДоходовРасходов",ГруппаФинансовогоУчетаДоходовРасходов),ГруппаФинансовогоУчетаДоходовРасходов,Справочники.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка());
	Сделка									= ?(ПараметрыНачисления.Свойство("Сделка"), ПараметрыНачисления.Сделка, Неопределено);
	ПроводитьЧерезРасчеты					= ?(ПараметрыНачисления.Свойство("ПроводитьЧерезРасчеты"), ПараметрыНачисления.ПроводитьЧерезРасчеты, Истина);
	ПредварительныеЗатратыПоСделке 			= ?(ПараметрыНачисления.Свойство("ПредварительныеЗатратыПоСделке"), ПараметрыНачисления.ПредварительныеЗатратыПоСделке, Ложь);
	СуммаЧерезРасчеты						= ?(ПараметрыНачисления.Свойство("СуммаЧерезРасчеты"), ПараметрыНачисления.СуммаЧерезРасчеты, 0);
	СуммаЧерезРасчетыВал					= ?(ПараметрыНачисления.Свойство("СуммаЧерезРасчетыВал"), ПараметрыНачисления.СуммаЧерезРасчетыВал, 0);
	
	Если ЦБ = Неопределено и Сделка = Неопределено Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Поступление услуг");
		
		Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии ИЛИ ВидКомиссии.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
			Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности02;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходов) Тогда
			
			Проводка.СчетДт = ПланыСчетов.Единый.НайтиПоКоду(ГруппаФинансовогоУчетаДоходовРасходов.НомерСчетаБухгалтерскогоУчета);
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГруппаФинансовогоУчетаДоходовРасходов;
			
		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана группа финансового учета доходов и расходов!", ОбъектДокумента, "ГруппыФинансовогоУчетаДоходовРасходов",, Отказ);
			Возврат;
		
		КонецЕсли; 
		
		// кредит
		ДопАналитика = Неопределено;
		
		Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего
			ИЛИ ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
			СчетУчетаЗадолженности 	= ПланыСчетов.Единый.АктивыВДУ03;
			СчетУчетаАвансов 		= ПланыСчетов.Единый.АктивыВДУ02; 			
			Если ОбъектДокумента.Дата > Дата(2020,5,1) Тогда
				Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
					ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
				ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда		
					ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего;
				КонецЕсли;
			Иначе 
				Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
					ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего;
				КонецЕсли;
			КонецЕсли;	
		Иначе
			СчетУчетаЗадолженности 			= ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами11;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
			СчетУчетаАвансов 				= ПланыСчетов.Единый.РасчетыСДебиторамиИКредиторами12;
			
			Если ВидКомиссии = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария Тогда
				ДопАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеСпецдепозитария;
			КонецЕсли;
			
			СчетУчетаКомиссии = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(ОбъектДокумента.Дата, 
																					ОбъектДокумента.Организация, 
																					ОбъектДокумента.СчетДоверительногоУправления, 
																					ВидКомиссии, 
																					Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, 
																					"СчетУчета");
																					
			Если ЗначениеЗаполнено(СчетУчетаКомиссии) Тогда
			
				СчетУчетаЗадолженности = СчетУчетаКомиссии;	
				
				ЕстьСубконтоОснованиеРасчетов = (СчетУчетаЗадолженности.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов) <> Неопределено);
				
				Если ЕстьСубконтоОснованиеРасчетов Тогда
					
					Проводка.СубконтоКт.ОснованиеРасчетов = ОбъектДокумента.Ссылка;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЕстьСубконтоКонтрагенты 			= (СчетУчетаЗадолженности.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
		ЕстьСубконтоКонтрагентыАванс 		= (СчетУчетаАвансов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);

		Проводка.СчетКт  					= СчетУчетаЗадолженности;
		Проводка.ДополнительнаяАналитикаКт 	= ДопАналитика;
		
		Если (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено) Тогда
			Проводка.СубконтоКт.Договоры 		= ДоговорПоКомиссии;
		КонецЕсли;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютаКт  					= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт 			= СуммаКомисии;
		КонецЕсли;
		
		//Проверим на аванс. Пока только для вознаграждения.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = &СчетУчетаАвансов,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 = &ДоговорПоКомиссии
		|				И ЛицевойСчет.ДополнительнаяАналитика = &ДопАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки";
		
		Запрос.УстановитьПараметр("Организация", 					ОбъектДокумента.Организация);
		Запрос.УстановитьПараметр("Период", 						Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления));
		Запрос.УстановитьПараметр("СчетУчетаАвансов", 				СчетУчетаАвансов);
		Запрос.УстановитьПараметр("ДоговорПоКомиссии", 				ДоговорПоКомиссии);
		Запрос.УстановитьПараметр("ДопАналитика", 					ДопАналитика);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		СуммаАвансаВВалюте = 0;
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СуммаАвансаВВалюте 	= ВыборкаДетальныеЗаписи.ВалютнаяСуммаОстатокДт;
		КонецЕсли;
			
		Если СуммаАвансаВВалюте > 0  Тогда
			
			Проводка 							= РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, Мин(СуммаАвансаВВалюте, СуммаКомисии), "Зачет аванса");
			Проводка.СчетДт 					= СчетУчетаЗадолженности;
			Проводка.ДополнительнаяАналитикаДт 	= ДопАналитика;
			Проводка.СубконтоДт.Договоры 		= ДоговорПоКомиссии;
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютаДт  					= ВалютаКомиссии;
				Проводка.ВалютнаяСуммаДт 			= Мин(СуммаАвансаВВалюте, СуммаКомисии);
			КонецЕсли;
			Проводка.СчетКт 					= СчетУчетаАвансов;
			Проводка.ДополнительнаяАналитикаКт 	= ДопАналитика;
			Проводка.СубконтоКт.Договоры 		= ДоговорПоКомиссии;
			Если Проводка.СчетКт.Валютный Тогда
				Проводка.ВалютаКт  					= ВалютаКомиссии;
				Проводка.ВалютнаяСуммаКт 			= Мин(СуммаАвансаВВалюте, СуммаКомисии);
			КонецЕсли;
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
			КонецЕсли;
			Если ЕстьСубконтоКонтрагентыАванс Тогда
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;		
			КонецЕсли; 
		ИначеЕсли ЕстьСубконтоКонтрагенты Тогда
			Проводка.СубконтоКт.Контрагенты 	= КонтрагентПоКомиссии;		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаСПФИ") Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Комиссия брокера");
		
		Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеДоходыРасходы02;
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("53105");
		Проводка.СубконтоДт.ЦенныеБумаги = ОбъектДокумента.Ссылка;
		
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты22;
		Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
		
		Проводка.ВалютаКт = ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт = СуммаКомисии;
		
	ИначеЕсли ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		
		ВалютаСделки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сделка, "Валюта");
		
		КлиентДУ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ОбъектДокумента.СчетДоверительногоУправления, ОбъектДокумента.Дата);
		
		Если КлиентДУ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ППА") И ОбъектДокумента.Дата < '20240731' Тогда
			
			ГФУ = Кэширование.ПолучитьГФУ_РасходовСделкамСВалютой(ВалютаСделки);
			
		ИначеЕсли ЗначениеЗаполнено(ГруппаФинансовогоУчетаДоходовРасходов) Тогда
			
			ГФУ = ГруппаФинансовогоУчетаДоходовРасходов;
			
		Иначе
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана группа финансового учета доходов и расходов!", ОбъектДокумента, "ГруппыФинансовогоУчетаДоходовРасходов",, Отказ);
			Возврат;
		
		КонецЕсли; 
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Поступление услуг");
		
		Проводка.СчетДт = ПланыСчетов.Единый.НайтиПоКоду(ГФУ.НомерСчетаБухгалтерскогоУчета);
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		
		// кредит
		Проводка.СчетКт  					= ПланыСчетов.Единый.Расчеты22;
		
		Проводка.СубконтоКт.Контрагенты 		= КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов 	= Сделка;
		
		Проводка.ВалютаКт  					= ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт 			= СуммаКомисии;
		
	ИначеЕсли ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		
		Если БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
									ОбъектДокумента.Дата, 
									ОбъектДокумента.Организация,
									ОбъектДокумента.СчетДоверительногоУправления,
									Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
									"МетодПризнанияРасходовПоСделкамРЕПО") = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО Тогда
									
			// Методика Перечисления.МетодыПризнанияРасходовПоСделкам.ПриОткрытииРЕПО была сделана для счетов ДУ
			// "ГСК Югория АО" и "НПФ Достойное БУДУЩЕЕ  АО РОПС" 
			// клиенты были недовольны, что по торговой комиссии комиссии по РЕПО используются ОФР кредитных организаций (т.к. контрагент НЦК)
			// а по брокерской комиссии по РЕПО используются ОФР некредитных организаций (т.к. берется брокер БК)
			// и написали письма чтобы ОФРы были единые, поэтому теперь по сделкам РЕПО для этой методики берем контрагента по сделке РЕПО, а не брокера
			ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(Контрагент, ОбъектДокумента.Дата);
									
			// ПРИЗНАНИЕ КОМИССИИ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Начисление брокерской комиссия");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы03;
			
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦБ;
			
			// кредит
			Если Сделка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства18;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
			КонецЕсли;	
			
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт = ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт = СуммаКомисии;
			
			// СВЕРНЕМ 18 и 19
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Признание брокерской комиссия");
			
			// дебет
			Если Сделка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства18;
			Иначе
				Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
			КонецЕсли;	
			
			
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
			Проводка.СубконтоДт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаДт = ВалютаКомиссии;
			Проводка.ВалютнаяСуммаДт = СуммаКомисии;
			
			// кредит
			Если Сделка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства19;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19;
			КонецЕсли;	
			
			
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
			Проводка.СубконтоКт.ОснованиеРасчетов = Сделка;
			
			Проводка.ВалютаКт = ВалютаКомиссии;
			Проводка.ВалютнаяСуммаКт = СуммаКомисии;
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;
		
		КонецЕсли;
		
		// Новое веяние от Ани: неоплаченную комиссию все же проводим через предварительные расчеты
		Если ПроводитьЧерезРасчеты И НЕ ПредварительныеЗатратыПоСделке Тогда
			
			Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
				ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия;
			ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
				ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;
				
				// Хардкорд для ППА, еще 1 хардкод в модуле БухгалтерскийУчетЕПС
				ПризнаватьКомиссию = Ложь;
				
				МассивСчетовППА = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																							ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ППА"),
																							ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																							ОбъектДокумента.Дата);
				
				ЭтоКлиентППА = (МассивСчетовППА.Найти(ОбъектДокумента.СчетДоверительногоУправления) <> Неопределено);
				
				Если ЭтоКлиентППА И ОбъектДокумента.Дата >= '20200622' И ОбъектДокумента.Дата < '20200701' Тогда
					ПризнаватьКомиссию = Истина;
				КонецЕсли;
				
				Если ПризнаватьКомиссию Тогда
				
					БухгалтерскийУчетЕПС.ПроводкиПризнанияКомиссииПоРЕПО(ОбъектДокумента, 
						Сделка,
						СуммаЧерезРасчеты,
						СуммаЧерезРасчетыВал,
						ВалютаКомиссии,
						Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО,
						ЦБ,
						Сделка.Контрагент,
						КонтрагентПоКомиссии,
						ДополнительнаяАналитика,
						Ложь);
						
				КонецЕсли;
				// конец хардкода
				
			Иначе
				ДополнительнаяАналитика = "";
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаЧерезРасчеты, ВидКомиссии.Наименование + " начисление");
			// дебет
			Если Сделка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства19;
			Иначе
				Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19;
			КонецЕсли;	
			
			
			Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
			Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			
			Проводка.ВалютаДт						= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаДт 				= СуммаЧерезРасчетыВал;
			
			Если ДополнительнаяАналитика <> "" Тогда
				Проводка.ДополнительнаяАналитикаДт = ДополнительнаяАналитика;
			КонецЕсли;
			
			// кредит
	 		Проводка.СчетКт 						= ПланыСчетов.Единый.Расчеты22;
			Проводка.СубконтоКт.Контрагенты 		= КонтрагентПоКомиссии;
			Проводка.СубконтоКт.ОснованиеРасчетов 	= Сделка;
			
			Проводка.ВалютаКт  						= ВалютаКомиссии;		
			Проводка.ВалютнаяСуммаКт 				= СуммаЧерезРасчетыВал;
			
			Если ДополнительнаяАналитика <> "" Тогда
				Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитика;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Покупка и ПроводитьЧерезРасчеты Тогда
		
		Если ПредварительныеЗатратыПоСделке Тогда
			Проводка 	= РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ВидКомиссии.Наименование + " начисление");
			Проводка.СчетДт 						= ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
			Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
			Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
			Проводка.ВалютнаяСуммаДт 				= СуммаКомисии;	
			Проводка.ВалютаДт  		 				= ВалютаКомиссии;
			
			ВалютнаяСуммаКт 						= СуммаКомисии;	
		Иначе
			
			Проводка 	= РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаЧерезРасчеты, ВидКомиссии.Наименование + " начисление");
			
			// дебет
			Если ВключатьРасходыПоПокупкеВСтоимость Тогда // это бумаги по а/с и в стоимость пойдет позднее
			
		 		Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты08;
				
				Проводка.СубконтоДт.Контрагенты 		= КонтрагентПоКомиссии;
				Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
				
				Проводка.ВалютнаяСуммаДт		= СуммаЧерезРасчетыВал;
				Проводка.ВалютаДт				= ВалютаКомиссии;
				
			Иначе
				
				Проводка.СчетДт 					= УчетныйАктив.СчетУчетаРасходовОтОпераций;
				
				Проводка.СубконтоДт.ЦенныеБумаги 	= Цб;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтОпераций;
				
			КонецЕсли;
			
			ВалютнаяСуммаКт = СуммаЧерезРасчетыВал;
			
		КонецЕсли;
		
		// кредит
 		Проводка.СчетКт 						= ПланыСчетов.Единый.Расчеты22;
		Проводка.СубконтоКт.Контрагенты 		= КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов 	= Сделка;
		Проводка.ВалютаКт  						= ВалютаКомиссии;		
		Проводка.ВалютнаяСуммаКт 				= ВалютнаяСуммаКт;	
		
	ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Продажа и ПроводитьЧерезРасчеты Тогда
		//начисление комиссии
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации,  ВидКомиссии.Наименование + " начисление");
		
		// дебет
		Если ПредварительныеЗатратыПоСделке Тогда
			Проводка.СчетДт 					= ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05;
			Проводка.СубконтоДт.Контрагенты 	= КонтрагентПоКомиссии;
		Иначе
			Проводка.СчетДт 					= ПланыСчетов.Единый.ВыбытиеИРеализация10;
			Проводка.СубконтоДт.ЦенныеБумаги 	= ЦБ;
		КонецЕсли; 
		Проводка.СубконтоДт.ОснованиеРасчетов 	= Сделка;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютаДт  					= ВалютаКомиссии;
			Проводка.ВалютнаяСуммаДт 			= СуммаКомисии;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт 						= ПланыСчетов.Единый.Расчеты22;
		Проводка.СубконтоКт.Контрагенты 		= КонтрагентПоКомиссии;
		Проводка.СубконтоКт.ОснованиеРасчетов 	= Сделка;
		
		Проводка.ВалютаКт  			= ВалютаКомиссии;
		Проводка.ВалютнаяСуммаКт 	= СуммаКомисии;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОплатитьКомиссиюНаЦБ(ОбъектДокумента, ПараметрыСписания, Отказ) Экспорт
	
	ЦБ 						= ПараметрыСписания.ЦБ;
	УчетныйАктив			= ПараметрыСписания.УчетныйАктив;
	ВидСделки				= ПараметрыСписания.ВидСделки;
	СуммаКомисии 			= ПараметрыСписания.СуммаКомисии;
	ВалютаКомиссии 			= ПараметрыСписания.ВалютаКомиссии;
	СуммаОперации 			= ПараметрыСписания.СуммаОперации;
	ВидКомиссии 			= ПараметрыСписания.ВидКомиссии;
	КонтрагентПоКомиссии	= ПараметрыСписания.КонтрагентПоКомиссии;
	ДоговорПоКомиссии		= ?(ПараметрыСписания.Свойство("ДоговорПоКомиссии"), ПараметрыСписания.ДоговорПоКомиссии, Неопределено);
	НачислениеДокумент		= ?(ПараметрыСписания.Свойство("НачислениеДокумент"), ПараметрыСписания.НачислениеДокумент, Неопределено);
	СчетДС					= ПараметрыСписания.СчетДС;
	СубконтоДС				= ПараметрыСписания.СубконтоДС;
	ВидСубконтоДС 			= ПараметрыСписания.ВидСубконтоДС;
	ОплатаВДеньПокупки		= ?(ВидСделки = Перечисления.ВидыСделок.Покупка, ПараметрыСписания.ОплатаВДеньПокупки, Неопределено);
	Сделка					= ?(ПараметрыСписания.Свойство("Сделка"), ПараметрыСписания.Сделка, Неопределено);
	ОплатаВДеньПокупки		= ?(ПараметрыСписания.Свойство("ОплатаВДеньПокупки"), ПараметрыСписания.ОплатаВДеньПокупки, Ложь);
	ПроводитьЧерезРасчеты	= ?(ПараметрыСписания.Свойство("ПроводитьЧерезРасчеты"), ПараметрыСписания.ПроводитьЧерезРасчеты, Ложь);
	НачислениеВПрошломГоду  = ?(ПараметрыСписания.Свойство("НачислениеВПрошломГоду"), ПараметрыСписания.НачислениеВПрошломГоду, Ложь);
	ВключатьРасходыПоПокупкеВСтоимость		= ?(ПараметрыСписания.Свойство("ВключатьРасходыПоПокупкеВСтоимость", ВключатьРасходыПоПокупкеВСтоимость), ВключатьРасходыПоПокупкеВСтоимость, Ложь);
	ГруппаФинансовогоУчетаДоходовРасходов 	= ?(ПараметрыСписания.Свойство("ГруппаФинансовогоУчетаДоходовРасходов",ГруппаФинансовогоУчетаДоходовРасходов),ГруппаФинансовогоУчетаДоходовРасходов,Справочники.ГруппыФинансовогоУчетаДоходовРасходов.ПустаяСсылка());
	ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты = ?(ПараметрыСписания.Свойство("ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты"), ПараметрыСписания.ОтражатьПредварительныеЗатратыПоСделкамТПлюсПоФактуОплаты, Ложь);
	НеОтражатьЗадолженностьПоБанковскойКомиссии	= ?(ПараметрыСписания.Свойство("НеОтражатьЗадолженностьПоБанковскойКомиссии"), ПараметрыСписания.НеОтражатьЗадолженностьПоБанковскойКомиссии, Ложь);
	ОтражатьПартииНаЛицевыхСчетах = ?(ПараметрыСписания.Свойство("ОтражатьПартииНаЛицевыхСчетах"), ПараметрыСписания.ОтражатьПартииНаЛицевыхСчетах, Ложь);
	Закрывать7ойРазделПриПоступленииДенежныхСредств = ?(ПараметрыСписания.Свойство("Закрывать7ойРазделПриПоступленииДенежныхСредств"), ПараметрыСписания.Закрывать7ойРазделПриПоступленииДенежныхСредств, Ложь);
	
	Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда 
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ОплатаВознагражденияУК;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего
		ИЛИ ВидКомиссии = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ОплатаВозмещенияРасходовУК;
