			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаНоминала);
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаНоминала);
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.СчетКт = УчетныйАктивЕПС.СчетУчета;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
		КонецЕсли;
		
		Если ОтражатьПартииНаЛицевыхСчетах Тогда
		
			Проводка.Партия			= Параметры.Партия;
			Проводка.СтрокаПартии	= Параметры.СтрокаПартии;
		
		КонецЕсли;
		
	КонецЕсли;

	
	Если КорректировкаЭСПВВалютеУчета <> 0 Тогда
		
		КорректировкаЭСПВВалютеУчетаМодуль = Макс(КорректировкаЭСПВВалютеУчета, -КорректировкаЭСПВВалютеУчета);
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, КорректировкаЭСПВВалютеУчетаМодуль, "Перекурсовка корректировки ЭСП");
		
		Если КорректировкаЭСПВВалютеУчета > 0 Тогда
			Проводка.СчетДт = ?(КорректировкаЭСПОстаток<0, УчетныйАктивЕПС.СчетУчетаКорректировокП, УчетныйАктивЕПС.СчетУчетаКорректировокА);
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаНоминала);
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаНоминала);
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.СчетКт = ?(КорректировкаЭСПОстаток<0, УчетныйАктивЕПС.СчетУчетаКорректировокП, УчетныйАктивЕПС.СчетУчетаКорректировокА);
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
		Если ОтражатьПартииНаЛицевыхСчетах Тогда
		
			Проводка.Партия			= Параметры.Партия;
			Проводка.СтрокаПартии	= Параметры.СтрокаПартии;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета <> 0 Тогда
		
		РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаМодуль = Макс(РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, -РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаМодуль, "Перекурсовка разницы первоначального признания");
		
		Если РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета > 0 Тогда
			Проводка.СчетДт = ?(РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток<0, УчетныйАктивЕПС.УчетныйАктив.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт, УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт);
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ВалютаДт = ВалютаНоминала;
			
			Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций11;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетКт, ВалютаНоминала);
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыОтОпераций12;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ПолучитьГФУПоВалюте(Проводка.СчетДт, ВалютаНоминала);
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.СчетКт = ?(РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток<0, УчетныйАктивЕПС.УчетныйАктив.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Дт, УчетныйАктивЕПС.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт);
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
		Если ОтражатьПартииНаЛицевыхСчетах Тогда
		
			Проводка.Партия			= Параметры.Партия;
			Проводка.СтрокаПартии	= Параметры.СтрокаПартии;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДвижениеКорректировки(ОбъектДокумента, ПараметрыСписания, Отказ) Экспорт 
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	СуммаВал 		= ПараметрыСписания.СуммаВал; // Это сумма в валюте номинала
	Если СуммаВал = 0 Тогда // немного странное условие, но мы все эти годы жили с ним - вытащил его в начало
		Возврат;
	КонецЕсли;
	
	СуммаУчета 		= ПараметрыСписания.СуммаУчета;
	УчетныйАктив 	= ПараметрыСписания.УчетныйАктив;
	ЦеннаяБумага 	= ПараметрыСписания.ЦеннаяБумага;
	Сделка			= ПараметрыСписания.Сделка;
	
	Партия			= ?(ПараметрыСписания.Свойство("Партия"), ПараметрыСписания.Партия, Неопределено);	
	СтрокаПартии	= ?(ПараметрыСписания.Свойство("СтрокаПартии"), ПараметрыСписания.СтрокаПартии, Неопределено);	
	
	АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка();
	
	ЭтоРасход = (СуммаУчета < 0);
	
	Показатель		= ПараметрыСписания.Показатель;
	Если Показатель = "КорректировкаЭСП" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаКорректировокП, УчетныйАктив.СчетУчетаКорректировокА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтКорректировки, УчетныйАктив.АналитикаДоходовОтКорректировки);
		Счет700		= ?(ЭтоРасход, ПланыСчетов.Единый.ПроцентныеДоходы06, ПланыСчетов.Единый.ПроцентныеДоходы05);
	ИначеЕсли Показатель = "Переоценка" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаПереоценкиП, УчетныйАктив.СчетУчетаПереоценкиА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтПереоценки, УчетныйАктив.АналитикаДоходовОтПереоценки);
		АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
		Счет700		= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, НЕ ЭтоРасход);
	ИначеЕсли Показатель = "ИндексацияНоминала" Тогда
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаПереоценкиП, УчетныйАктив.СчетУчетаПереоценкиА);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовОтПереоценки, УчетныйАктив.АналитикаДоходовОтПереоценки);
		АналитикаЦБ	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
		Счет700		= ?(ЭтоРасход, УчетныйАктив.СчетУчетаРасходовОтОпераций, УчетныйАктив.СчетУчетаДоходовОтОпераций);
	ИначеЕсли Показатель = "РазницаПервоначальногоПризнания" Тогда
		
		// пока, увы, затыка потом разберусь - бывают ситуации списания отрицательной корректировки ПП + и зачисления
		// позже сделаю именно по виду движения
		НастройкиУчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиУчета(
									ОбъектДокумента.Дата,
									ОбъектДокумента.Организация,
									ОбъектДокумента.СчетДоверительногоУправления);
									
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчета,
			ЦеннаяБумага,
			УчетныйАктив,
			Партия,
			СтрокаПартии);
		
		Если Не НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнанияДляКорректировок
			И ТипЗнч(ПараметрыСписания.Сделка) <> Тип("ДокументСсылка.ВыводЦенныхБумаг")
			И ТипЗнч(ПараметрыСписания.Сделка) <> Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда 
			ЭтоРасход = НЕ ЭтоРасход;
		КонецЕсли;
		
		СчетУчета	= ?(ЭтоРасход, УчетныйАктив.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт, УчетныйАктив.СчетУчетаПоложительнойРазницыПервоначальногоПризнанияУровень3Кт);
		Аналитика	= ?(ЭтоРасход, УчетныйАктив.АналитикаРасходовПервоначальногоПризнания, УчетныйАктив.АналитикаДоходовПервоначальногоПризнания);
		Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") ИЛИ ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Векселя") Тогда
			АналитикаЦБ = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
		КонецЕсли;
		Счет700		= ?(ЭтоРасход, УчетныйАктив.СчетУчетаРасходовОтОпераций, УчетныйАктив.СчетУчетаДоходовОтОпераций);
		
		Если ТипЗнч(Сделка) <> Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
			Сделка = Неопределено; //всегда списываем на доходы/расходы, см. положение 494-П п.3.13, 3.14
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счетов учета показателя " + Показатель, ,,, Отказ);
		Возврат;
	КонецЕсли;
	
	СторонаЦБ	= ?(ЭтоРасход, "Кт", "Дт");
	СторонаНеЦБ = ?(ЭтоРасход, "Дт", "Кт");
	
	МеняемЗнак = (СуммаУчета <> МатематическиеФункции.МодульЧисла(СуммаУчета));
	Если МеняемЗнак Тогда
		СуммаВал 	= -СуммаВал;
		СуммаУчета 	= -СуммаУчета;
	КонецЕсли;
	
	Если Сделка = Неопределено Тогда // это переоценка бумаги
		Корреспонденция = "Доходы/расходы";
		
		ПереоценкаПослеВводаНачальныхОстатков = ?(ПараметрыСписания.Свойство("ПереоценкаПослеВводаНачальныхОстатков", ПереоценкаПослеВводаНачальныхОстатков), ПереоценкаПослеВводаНачальныхОстатков, Ложь);
		НачисленоВПрошломГоду = ?(ПараметрыСписания.Свойство("НачисленоВПрошломГоду", НачисленоВПрошломГоду), НачисленоВПрошломГоду, Ложь);
		Если ПереоценкаПослеВводаНачальныхОстатков ИЛИ НачисленоВПрошломГоду Тогда // прошлогодняя переоценка
			Корреспонденция = "Активы в ДУ";
		КонецЕсли;
	ИначеЕсли ТипЗнч(Сделка) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		Корреспонденция = "Активы в ДУ";
	ИначеЕсли ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		Корреспонденция = "Активы в РЕПО";
		
		СторонаЦБ	= ?(ЭтоРасход, "Дт", "Кт");
		СторонаНеЦБ = ?(ЭтоРасход, "Кт", "Дт");
		
	Иначе // продажа/погашение
		Корреспонденция = "Реализация";
	КонецЕсли;
	
	Содержание = ?(Сделка <> Неопределено, "Списание по ЦБ(" + Показатель + ")", Показатель);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, Содержание);
	
	// со стороны бумаги (счета 5ХХ)
	Проводка["Счет" + СторонаЦБ] = СчетУчета;	
	Проводка["Субконто" + СторонаЦБ].ЦенныеБумаги = ЦеннаяБумага;
	
	Проводка["Количество" + СторонаЦБ] = 0;
	Проводка["Валюта" + СторонаЦБ] = ПараметрыСписания.ВалютаНоминала;
	Проводка["ВалютнаяСумма" + СторонаЦБ] = СуммаВал;
	
	Проводка["ДополнительнаяАналитика" + СторонаЦБ] = АналитикаЦБ;
	
	// Корреспонденция
	Если Корреспонденция = "Активы в ДУ" Тогда
		Проводка["Счет" + СторонаНеЦБ] = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка["Субконто" + СторонаНеЦБ].Договоры = УчетныйСчетДоверительногоУправления;
	ИначеЕсли Корреспонденция = "Реализация" Тогда
		Проводка["Счет" + СторонаНеЦБ] = ПланыСчетов.Единый.ВыбытиеИРеализация10;
		Проводка["Субконто" + СторонаНеЦБ].ЦенныеБумаги = ЦеннаяБумага;
		Проводка["Субконто" + СторонаНеЦБ].ОснованиеРасчетов = Сделка;
		Проводка["Количество" + СторонаНеЦБ] = 0;
	ИначеЕсли Корреспонденция = "Доходы/расходы" Тогда
		Проводка["Счет" + СторонаНеЦБ] = Счет700;
		Проводка["Субконто" + СторонаНеЦБ].ГруппыФинансовогоУчетаДоходовРасходов = Аналитика;
		Проводка["Субконто" + СторонаНеЦБ].ЦенныеБумаги = ЦеннаяБумага;
		Если Проводка["Счет" + СторонаНеЦБ].Валютный Тогда // для счетов 106ХХ
			Проводка["Валюта" + СторонаНеЦБ] = ПараметрыСписания.ВалютаУчета;
			Проводка["ВалютнаяСумма" + СторонаНеЦБ] = СуммаУчета;
		КонецЕсли;
	ИначеЕсли Корреспонденция = "Активы в РЕПО" Тогда
		АналитикаУчетногоАктиваВРЕПО = Справочники.УчетныеАктивыЕПС.ПолучитьДанныеУчетногоАктиваЕПСДляБумагВРЕПО(УчетныйАктив, Отказ);
		
		Если Показатель = "КорректировкаЭСП" Тогда
			СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаКорректировокП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаКорректировокА);
		ИначеЕсли Показатель = "Переоценка" Тогда
			СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
		ИначеЕсли Показатель = "ИндексацияНоминала" Тогда
			СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
		ИначеЕсли Показатель = "РазницаПервоначальногоПризнания" Тогда
			СчетУчетаСторонаНеЦБ	= ?(ЭтоРасход, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиП, АналитикаУчетногоАктиваВРЕПО.СчетУчетаПереоценкиА);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Счетов учета показателя " + Показатель, ,,, Отказ);
			Возврат;
		КонецЕсли;
		
		Проводка["Счет" + СторонаНеЦБ] = СчетУчетаСторонаНеЦБ;
		Проводка["Субконто" + СторонаНеЦБ].ЦенныеБумаги = ЦеннаяБумага;
		Проводка["ДополнительнаяАналитика" + СторонаНеЦБ] = АналитикаЦБ;
		Проводка["Количество" + СторонаНеЦБ] = 0;
		Если Проводка["Счет" + СторонаНеЦБ].Валютный Тогда
			Проводка["Валюта" + СторонаНеЦБ] = ПараметрыСписания.ВалютаУчета;
			Проводка["ВалютнаяСумма" + СторонаНеЦБ] = СуммаУчета;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Партия <> Неопределено Тогда
		Проводка.Партия = Партия;
		Проводка.СтрокаПартии = СтрокаПартии;
	КонецЕсли;
	
КонецПроцедуры

Процедура НачислитьДисконтПремию(ОбъектДокумента, ПараметрыНачисления, Отказ) Экспорт
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	СуммаУчета = ПараметрыНачисления.СуммаУчета;//обычное движения начисления для дисконта - >0, для премии - <0
	СуммаВал	= ПараметрыНачисления.СуммаВал;
	ВалютаУчета		= ПараметрыНачисления.ВалютаУчета;
	УчетныйАктив = ПараметрыНачисления.УчетныйАктив;
	ЦеннаяБумага = ПараметрыНачисления.ЦеннаяБумага;
	ВалютаНоминала = ПараметрыНачисления.ВалютаНоминала;
	ПереоценкаПослеВводаНачальныхОстатков = ?(ПараметрыНачисления.Свойство("ПереоценкаПослеВводаНачальныхОстатков",ПереоценкаПослеВводаНачальныхОстатков),ПереоценкаПослеВводаНачальныхОстатков,Ложь);
	Аналитика = ПараметрыНачисления.Аналитика;
	
	Если Аналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия Тогда
		Если СуммаУчета > 0 Тогда //не обычно - списываем ранее ошибочно начисленный?
			//на доходы
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, "Списание премии");
			
			// дебет
			Проводка.СчетДт = УчетныйАктив.СчетУчета;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаДт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт = СуммаВал;
			
			Проводка.ДополнительнаяАналитикаДт = Аналитика;
			
			// кредит
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
			КонецЕсли;
			
		ИначеЕсли СуммаУчета < 0 Тогда //как обычно - начисляем 
			//на расходы
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, -СуммаУчета, "Начисление премии");
			
			// дебет
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы04;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаСписанияПремии;
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчета;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаКт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = -СуммаВал;
			
			Проводка.ДополнительнаяАналитикаКт = Аналитика;
			
		КонецЕсли;
	Иначе    //дисконт
		Если СуммаУчета > 0 Тогда //как обычно - начисляем
			//дисконт
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, "Начисление дисконта");
			
			// дебет
			Проводка.СчетДт = УчетныйАктив.СчетУчета;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаДт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаДт = СуммаВал;
			
			Проводка.ДополнительнаяАналитикаДт = Аналитика;
			
			// кредит
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
			КонецЕсли;
			
		ИначеЕсли СуммаУчета < 0 Тогда //не обычно - возвращаем излишне начисленное?
			//премия
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, -СуммаУчета, "Начисление премии");
			
			// дебет
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = УчетныйСчетДоверительногоУправления;
			Иначе
				Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы04;
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаСписанияПремии;
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчета;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			
			Проводка.ВалютаКт  = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = -СуммаВал;
			
			Проводка.ДополнительнаяАналитикаКт = Аналитика;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура НачислитьНКД(ОбъектДокумента, ПараметрыНачисления, Отказ) Экспорт 
	
	УчетныйСчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ОбъектДокумента.СчетДоверительногоУправления);
	
	СуммаУчета = ПараметрыНачисления.СуммаУчета;
	СуммаВал	= ПараметрыНачисления.СуммаВал;
	ВалютаУчета		= ПараметрыНачисления.ВалютаУчета;
	УчетныйАктив = ПараметрыНачисления.УчетныйАктив;
	ЦеннаяБумага = ПараметрыНачисления.ЦеннаяБумага;
	ВалютаНоминала = ПараметрыНачисления.ВалютаНоминала;
	ПереоценкаПослеВводаНачальныхОстатков = ?(ПараметрыНачисления.Свойство("ПереоценкаПослеВводаНачальныхОстатков",ПереоценкаПослеВводаНачальныхОстатков),ПереоценкаПослеВводаНачальныхОстатков,Ложь);
	АналитикаКупонНачисленный = ?(ПараметрыНачисления.Свойство("Аналитика",АналитикаКупонНачисленный),АналитикаКупонНачисленный,Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный); 
	
	Если СуммаВал > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, "Переоценка купона");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = СуммаВал;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
		
		// кредит
		Если ПереоценкаПослеВводаНачальныхОстатков Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
		КонецЕсли;
		
	ИначеЕсли СуммаВал < 0 Тогда
		
		//Так не бывает!!!
		// увы, но бывает
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаУчета, "Переоценка купона");
		
		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
		Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
		
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = СуммаВал;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
		
		// кредит
		Если ПереоценкаПослеВводаНачальныхОстатков Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = УчетныйСчетДоверительногоУправления;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаПроцентныхДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция проверяет было ли до конца дня погашения ЦБ списание бумаг со счета ДЕПО и оплата задолженности.
// Используется для переноса аналитики НКД по счетам 501-504
Функция НеобходимоФормироватьПроводкуПереносаНКДНаАналитикуЗадолженности(ДокументПогашения) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПогашения, "Дата, Ссылка, Организация, СчетДоверительногоУправления, ЦеннаяБумага");
	
	// действовать должно с 01.11.25, были случаи и ранее, но их уже править не станем, так оговорено в задаче #696814
	// а для того чтобы не разыменовывать ДокументПогашения для получения даты в общем модуле проверяем уже тут, когда получили запросом необходимые реквизиты.
	Если РеквизитыДокумента.Дата >= '20251101' Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(ЗадолженностиПоДенежнымСредствам.Сумма), 0) КАК ЗадолженностиПоДенежнымСредствамСумма
		|ПОМЕСТИТЬ _ДвиженияЗадолженностиПоДенежнымСредствам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Активность
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Основание = &Основание
		|	И ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(ОстаткиЦенныхБумагЗаблокированные.Количество), 0) КАК ОстаткиЦенныхБумагЗаблокированныеКоличество
		|ПОМЕСТИТЬ _ДвиженияОстаткиЦенныхБумагЗаблокированные
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные КАК ОстаткиЦенныхБумагЗаблокированные
		|ГДЕ
		|	ОстаткиЦенныхБумагЗаблокированные.Активность
		|	И ОстаткиЦенныхБумагЗаблокированные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ОстаткиЦенныхБумагЗаблокированные.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиЦенныхБумагЗаблокированные.Организация = &Организация
		|	И ОстаткиЦенныхБумагЗаблокированные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиЦенныхБумагЗаблокированные.ЦеннаяБумага = &ЦеннаяБумага
		|	И ОстаткиЦенныхБумагЗаблокированные.ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияЗадолженностиПоДенежнымСредствам.ЗадолженностиПоДенежнымСредствамСумма > 0 КАК ЕстьОплатаЗадолженности,
		|	_ДвиженияОстаткиЦенныхБумагЗаблокированные.ОстаткиЦенныхБумагЗаблокированныеКоличество > 0 КАК ЕстьПогашениеЦенныхБумаг
		|ИЗ
		|	_ДвиженияЗадолженностиПоДенежнымСредствам КАК _ДвиженияЗадолженностиПоДенежнымСредствам,
		|	_ДвиженияОстаткиЦенныхБумагЗаблокированные КАК _ДвиженияОстаткиЦенныхБумагЗаблокированные";
		
		Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
		Запрос.УстановитьПараметр("Период", РеквизитыДокумента.Дата);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", РеквизитыДокумента.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦеннаяБумага", РеквизитыДокумента.ЦеннаяБумага);
		Запрос.УстановитьПараметр("Основание", ДокументПогашения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если ВыборкаДетальныеЗаписи.ЕстьОплатаЗадолженности Или ВыборкаДетальныеЗаписи.ЕстьПогашениеЦенныхБумаг Тогда	
				
				Возврат Ложь;
				
			Иначе	
				// Не погашалась задолженность и бумаги не списывали со счета ДЕПО
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции	

Процедура ЗакрытьДоходыРасходыпоРезервамСПартиямиНаЛицевыхСчетах(ОбъектДокумента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаНачисленияРезервов КАК АналитикаНачисленияРезервов,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаСписанияРезервов КАК АналитикаСписанияРезервов
		|ПОМЕСТИТЬ _ВыбытиеПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаНачисленияРезервов,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаСписанияРезервов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВыбытиеПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВыбытиеПартий.Партия КАК Партия,
		|	_ВыбытиеПартий.СтрокаПартии КАК СтрокаПартии,
		|	_ВыбытиеПартий.АналитикаНачисленияРезервов КАК АналитикаНачисленияРезервов,
		|	_ВыбытиеПартий.АналитикаСписанияРезервов КАК АналитикаСписанияРезервов,
		|	_ВыбытиеПартий.Количество КАК КоличествоСписано,
		|	ВЫБОР
		|		КОГДА &РезервВыводится
		|			ТОГДА 0
		|		ИНАЧЕ _ВыбытиеПартий.СуммаРезервовПодОбесценение
		|	КОНЕЦ КАК ВосстановленоРезервовПриПродаже,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстаткиДоход.СуммаОстатокКт, 0) КАК ВосстановленоРезервовВсего,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстаткиРасход.СуммаОстатокДт, 0) КАК НачисленоРезервовВсего
		|ИЗ
		|	_ВыбытиеПартий КАК _ВыбытиеПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость) КАК БухПартииЦенныхБумагОстатки
		|		ПО _ВыбытиеПартий.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И _ВыбытиеПартий.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И _ВыбытиеПартий.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам01),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиДоход
		|		ПО _ВыбытиеПартий.АналитикаСписанияРезервов = ЕдиныйБухгалтерскийУчетОстаткиДоход.Субконто1
		|			И _ВыбытиеПартий.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстаткиДоход.Субконто2
		|			И _ВыбытиеПартий.Партия = ЕдиныйБухгалтерскийУчетОстаткиДоход.ЛицевойСчет.Партия
		|			И _ВыбытиеПартий.СтрокаПартии = ЕдиныйБухгалтерскийУчетОстаткиДоход.ЛицевойСчет.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам02),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиРасход
		|		ПО _ВыбытиеПартий.АналитикаНачисленияРезервов = ЕдиныйБухгалтерскийУчетОстаткиРасход.Субконто1
		|			И _ВыбытиеПартий.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстаткиРасход.Субконто2
		|			И _ВыбытиеПартий.Партия = ЕдиныйБухгалтерскийУчетОстаткиРасход.ЛицевойСчет.Партия
		|			И _ВыбытиеПартий.СтрокаПартии = ЕдиныйБухгалтерскийУчетОстаткиРасход.ЛицевойСчет.СтрокаПартии";
	
	Запрос.УстановитьПараметр("Организация", ОбъектДокумента.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ОбъектДокумента.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", Новый Граница(ОбъектДокумента.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Регистратор", ОбъектДокумента.Ссылка);
	// при продаже и пр. резерв восстанавливается, а при выводе - выводится (ВосстановленоРезервовПриПродаже = 0)
	Запрос.УстановитьПараметр("РезервВыводится", ТипЗнч(ОбъектДокумента) = Тип("ДокументОбъект.ВыводЦенныхБумаг")); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.НачисленоРезервовВсего > 0 Тогда
			
			Если ВыборкаДетальныеЗаписи.КоличествоСписано = ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда // списали все
				ЗакрытьНачислениеРезервов = ВыборкаДетальныеЗаписи.НачисленоРезервовВсего;
			Иначе // списали часть партии
				ЗакрытьНачислениеРезервов = ВыборкаДетальныеЗаписи.НачисленоРезервовВсего * ВыборкаДетальныеЗаписи.КоличествоСписано / ВыборкаДетальныеЗаписи.КоличествоОстаток;
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ЗакрытьНачислениеРезервов, "Закрытие резервов");
			
			Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоДт.Договоры = ОбъектДокумента.СчетДоверительногоУправления;
			
			Проводка.СчетКт = ПланыСчетов.Единый.ДоходыРасходыПоРезервам02;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.АналитикаНачисленияРезервов;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			
			Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;

		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ВосстановленоРезервовВсего > 0 ИЛИ ВыборкаДетальныеЗаписи.ВосстановленоРезервовПриПродаже > 0 Тогда
			
			Если ВыборкаДетальныеЗаписи.КоличествоСписано = ВыборкаДетальныеЗаписи.КоличествоОстаток Тогда // списали все
				ЗакрытьВосстановлениеРезервов = ВыборкаДетальныеЗаписи.ВосстановленоРезервовВсего;
			Иначе // списали часть партии
				ЗакрытьВосстановлениеРезервов = ВыборкаДетальныеЗаписи.ВосстановленоРезервовВсего * ВыборкаДетальныеЗаписи.КоличествоСписано / ВыборкаДетальныеЗаписи.КоличествоОстаток;
			КонецЕсли;
			ЗакрытьВосстановлениеРезервов = ЗакрытьВосстановлениеРезервов + ВыборкаДетальныеЗаписи.ВосстановленоРезервовПриПродаже; 
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, ЗакрытьВосстановлениеРезервов, "Закрытие резервов");
			
			Проводка.СчетДт = ПланыСчетов.Единый.ДоходыРасходыПоРезервам01;
			Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ВыборкаДетальныеЗаписи.АналитикаСписанияРезервов;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = ОбъектДокумента.СчетДоверительногоУправления;
			
			Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
			
		КонецЕсли;
		
	КонецЦикла;
	

КонецПроцедуры

Процедура ОтнесениеНачисленныхДоходовНаАктивыВДУПоКурсовымРазницамЦенныхБумагСПартиямиНаЛицевыхСчетах(ЭтотОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.Организация КАК Организация,
		|	БухПартииЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Количество КАК Количество,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ТаблицаПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ПериодОстатковПартии,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Организация = БухПартииЦенныхБумагОстатки.Организация
		|			И БухПартииЦенныхБумаг.СчетДоверительногоУправления = БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления
		|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС
		|			И БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.КурсовыеРазницыСНачалаГода <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаПартий.Партия КАК Партия,
		|	ТаблицаПартий.СтрокаПартии КАК СтрокаПартии,
		|	ТаблицаПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТаблицаПартий.Количество КАК Количество,
		|	ТаблицаПартий.КоличествоОстаток КАК КоличествоОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	ТаблицаПартий КАК ТаблицаПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&ПериодОстатковСчета,
		|				Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций11), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций12)),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО ТаблицаПартий.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ЦеннаяБумага
		|			И ТаблицаПартий.Партия = ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия
		|			И ТаблицаПартий.СтрокаПартии = ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);

	Запрос.УстановитьПараметр("ПериодОстатковПартии", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодОстатковСчета", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	
	ВалютаДохода  = ЭтотОбъект.Организация.ВалютаУчета;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДоляЗакрытия = ВыборкаДетальныеЗаписи.КоличествоОстаток / ВыборкаДетальныеЗаписи.Количество;
		КурсовыеРазницыСНачалаГода = Окр(ВыборкаДетальныеЗаписи.СуммаОстаток * ДоляЗакрытия, 2);
		
		Если КурсовыеРазницыСНачалаГода <> 0 Тогда
			
			СчетУчетаДоходов = ВыборкаДетальныеЗаписи.ЛицевойСчет.СчетУчета;
			
			БухгалтерскийУчетЕПС.ОтнесениеНачисленныхДоходовНаАктивыВДУПоФиксированнойСумме(
				ЭтотОбъект,
				СчетУчетаДоходов,
				ВыборкаДетальныеЗаписи.ЦеннаяБумага,
				ПолучитьГФУПоВалюте(СчетУчетаДоходов, ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала),
				ВалютаДохода,
				"Закрытие доначисления по курсовым разницам",
				ВыборкаДетальныеЗаписи.ЛицевойСчет.ДополнительнаяАналитика,
				КурсовыеРазницыСНачалаГода,
				ВыборкаДетальныеЗаписи.Партия,
				ВыборкаДетальныеЗаписи.СтрокаПартии);
				
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаПогашения) Экспорт

	ТаблицаАмортизаций = Новый ТаблицаЗначений;
	
	ТаблицаАмортизаций.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаАмортизаций.Колонки.Добавить("Поток", Новый ОписаниеТипов("Число"));
	ТаблицаАмортизаций.Колонки.Добавить("Номинал", Новый ОписаниеТипов("Число"));
	
	ЗапросАмортизации = Новый Запрос;
	ЗапросАмортизации.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумаг.Период КАК Дата,
		|	НоминалыЦенныхБумаг.СуммаИзменения КАК Поток,
		|	НоминалыЦенныхБумаг.Номинал КАК Номинал
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|ГДЕ
		|	НоминалыЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	ЗапросАмортизации.УстановитьПараметр("ЦеннаяБумага", Облигация);
	
	ТекущийНоминал = 0;
	
	ВыборкаДетальныеЗаписи = ЗапросАмортизации.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Дата <= НачалоДня(ДатаПокупки) Тогда
		
			ТекущийНоминал = ВыборкаДетальныеЗаписи.Номинал;
			
		ИначеЕсли ВыборкаДетальныеЗаписи.Дата >= НачалоДня(ДатаПокупки)
			И ВыборкаДетальныеЗаписи.Дата < НачалоДня(ДатаПогашения) Тогда
		
			НоваяСтрока = ТаблицаАмортизаций.Добавить();
			НоваяСтрока.Дата = ВыборкаДетальныеЗаписи.Дата;
			НоваяСтрока.Поток = ВыборкаДетальныеЗаписи.Поток;
			НоваяСтрока.Номинал = ВыборкаДетальныеЗаписи.Номинал;
			
			ТекущийНоминал = ТекущийНоминал - ВыборкаДетальныеЗаписи.Поток;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекущийНоминал <> 0 Тогда // нет последнего (окончательного) погашения - добавим
	
		НоваяСтрока = ТаблицаАмортизаций.Добавить();
		НоваяСтрока.Дата = ДатаПогашения;
		НоваяСтрока.Поток = ТекущийНоминал;
		НоваяСтрока.Номинал = 0;
	
	КонецЕсли;
	
	Возврат ТаблицаАмортизаций;
	
КонецФункции

Функция ОпределитьНоминалИДатуПогашения(Облигация, ДатаПереоценки, ДатаПокупки, СчетДоверительногоУправления, НастройкиУчета, ОпределенияКлиентов, ДанныеПереоценки)

	// разберемся до какого момента считаем и какой номинал будет НА ЭТОТ МОМЕНТ
	ДатаОпределенияПогашения = НачалоДня(ДатаПереоценки);
	Если НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
	
		ДатаПогашения = Облигация.ДатаПогашения;
		Номинал = Справочники.Облигации.ПолучитьНоминал(Облигация, ДатаПогашения);
		
		// #Хардкоды по письмам клиентов
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_ПраймФБО2") Тогда
			ДатаПогашения = '20260202';
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Роснефть_004") И НачалоДня(ДатаПокупки) = '20190424' Тогда
			ДатаПогашения = '20230214';
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПочтаРФ_009") Тогда
			
			Если ОпределенияКлиентов.ЭтоКлиентБудущее ИЛИ ОпределенияКлиентов.ЭтоКлиентТелеком
				ИЛИ ДатаПереоценки >= '20250801' И (ОпределенияКлиентов.ЭтоКлиентБольшой ИЛИ ОпределенияКлиентов.ЭтоКлиентСАФМАР) Тогда // с 1.8.25 бумага может оказаться у Большого или ДБ
				ДатаПогашения = '20271122';
			КонецЕсли;
		ИначеЕсли Облигация.ДатаПогашения = '00010101' Тогда // бессрочная бумага - у УГМК до оферты #362218, #465058 - вся группа Будущее перешла на расчет до погашения и стрельнуло
			
			// небольшой трюк: в ДатеПереоценки лежит конец дня (для СЧА и переоценки ЕПС) и время документа (для расчета партий). Если конец дня, то берем уже со следующего дня
			ДатаОпределенияПогашения = НачалоДня(ДатаПереоценки + 1); 
			
			ДатаИЦенаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(Облигация, НачалоДня(ДатаОпределенияПогашения), ДатаПокупки, СчетДоверительногоУправления,
									НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении);
			
			ДатаПогашения = ДатаИЦенаВыкупа.ДатаВыкупа;
			Номинал = ДатаИЦенаВыкупа.ЦенаВыкупа;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АФКСистема_022") // #392732 - будущее и телеком и федерация решили 2 бумаги до оферты считать
				ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_НГКСлавнефть_02")
				ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СегежаГрупп_002") Тогда // #404611 - и еще 1 бумагу решили
				
			Если НЕ НастройкиУчета.Свойство("РассчитыватьДисконтПремиюДо_Переопределена")
				И (ОпределенияКлиентов.ЭтоКлиентБудущее ИЛИ ОпределенияКлиентов.ЭтоКлиентТелеком ИЛИ ОпределенияКлиентов.ЭтоКлиентФедерация) Тогда
				
				// небольшой трюк: в ДатеПереоценки лежит конец дня (для СЧА и переоценки ЕПС) и время документа (для расчета партий). Если конец дня, то берем уже со следующего дня
				ДатаОпределенияПогашения = НачалоДня(ДатаПереоценки + 1);
				
				ДатаИЦенаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(Облигация, НачалоДня(ДатаОпределенияПогашения), ДатаПокупки, СчетДоверительногоУправления,
									НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении);
				
				ДатаПогашения = ДатаИЦенаВыкупа.ДатаВыкупа;
				Номинал = ДатаИЦенаВыкупа.ЦенаВыкупа;
				
			КонецЕсли;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ИНГРАДПАО_003") Тогда // #431578 - профсуждение от Будущего
			
			Если НЕ НастройкиУчета.Свойство("РассчитыватьДисконтПремиюДо_Переопределена") И ОпределенияКлиентов.ЭтоКлиентБудущее Тогда
				ДатаПогашения = '20230531';
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении
			ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_431")
				И ОпределенияКлиентов.ЭтоКлиентСАФМАР
				И НЕ НастройкиУчета.Свойство("РассчитыватьДисконтПремиюДо_Переопределена") Тогда
			
			ПараметрыОферты = Справочники.Облигации.ОбъявленаОбязательнаяДосрочнаяОферта(Облигация, ДатаПереоценки);
			Если ПараметрыОферты.Объявлена Тогда
			
				ДатаПогашения = ПараметрыОферты.ДатаВыкупа;
				Номинал = ПараметрыОферты.Цена;
			
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты Тогда
		
		// по задаче #384775 - все клиенты считают со следующего дня после публикации
		
		ДатаОпределенияПогашения = НачалоДня(ДатаПереоценки) - 86400; // предыдущий день, т.е. чтобы оферту объявленую 16го начать учитывать 17го
		Если НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении Тогда // для этих клиентов начинаем учитывать оферту только в день когда она случится
			ДатаОпределенияПогашения = НачалоДня(ДатаПереоценки);
		КонецЕсли;
		
		ДатаИЦенаВыкупа = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(Облигация, НачалоДня(ДатаОпределенияПогашения), ДатаПокупки, СчетДоверительногоУправления,
									НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона, НастройкиУчета.ИгнорироватьИнформациюОбОбязательномДосрочномПогашении);
		
		ДатаПогашения = ДатаИЦенаВыкупа.ДатаВыкупа;
		Номинал = ДатаИЦенаВыкупа.ЦенаВыкупа;
		
		// #411671 -  хардкодом "отключить" оферту по санкт-петербургу для транснефти
		Если ОпределенияКлиентов.ЭтоКлиентТранснефть 
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_СПетербург_003")
			И НачалоДня(ДатаПереоценки) >= '20211221' // объявили
		Тогда
		
			ДатаПогашения = '20270413';
			Номинал = 300;
		
		КонецЕсли;
		
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Свердл_Обл_005") // тут реально тяжелый случай
			И ОпределенияКлиентов.ЭтоКлиентБольшой 
			И НачалоДня(ДатаПереоценки) = '20211223' Тогда
		
			ДатаПогашения = '20261023';
			Номинал = 50;
		
		КонецЕсли;
		
	КонецЕсли;

	// #Хардкод - другого варианта не вижу
	Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")
		И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084")
		И ДатаПереоценки < '20240331' Тогда
		Если ДатаПереоценки >= '20190704' // В бэк-офисе так только после 04.07.2019
			ИЛИ Не ДанныеПереоценки.Свойство("ЦельРасчета")
			ИЛИ ДанныеПереоценки.ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении 
		Тогда
			ДатаПогашения = Дата(2024, 3, 29);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ДатаПогашения, Номинал, ДатаОпределенияПогашения", ДатаПогашения, Номинал, ДатаОпределенияПогашения);
	
КонецФункции 

Функция РассчитатьАмортизациюДисконтаПремии(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, Отказ,  РасшифровкаРасчета = Неопределено) Экспорт

	//ПараметрыРасчета
	СчетДоверительногоУправления	= ДанныеПереоценки.СчетДоверительногоУправления;
	ДатаПереоценки					= ДанныеПереоценки.ДатаПереоценки;
	Количество						= ДанныеПереоценки.Количество;
	УчетныйАктивЕПС					= ДанныеПереоценки.УчетныйАктивЕПС; 

	ДатаПокупки						= ДанныеПокупки.ДатаПокупки; 
	ЦенаПокупки						= ДанныеПокупки.ЦенаПокупки; 
	НачальныйДисконт				= ДанныеПокупки.НачальныйДисконт;
			
	#Область Проверка_входящих_параметров
	
	Если ТипЗнч(Облигация) <> Тип("СправочникСсылка.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет дисконта/премии возможен только по облигациям!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
			
	Если ТипЗнч(НачальныйДисконт) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан начальный дисконт!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДатаПереоценки) <> Тип("Дата") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата переоценки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДатаПокупки) <> Тип("Дата") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата покупки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ТребуетсяЦенаПокупки = НачальныйДисконт <> 0 И (Облигация.Амортизационная 
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке 
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности);	
			
	Если ТребуетсяЦенаПокупки И (ТипЗнч(ЦенаПокупки) <> Тип("Число") ИЛИ ЦенаПокупки = 0) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана цена покупки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчета.РассчитыватьДисконтПремиюДо) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках не указан вариант расчета доходности по облигациям",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;	
	
	#КонецОбласти
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеПереоценки", ДанныеПереоценки, "Данные переоценки", Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеПокупки", ДанныеПокупки, "Данные покупки", Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "НастройкиУчета", НастройкиУчета, "Настройки учета", Истина, Истина);
		
	КонецЕсли;
	
	#Область Определения_Клиентов
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки);
	
	ОпределенияКлиентов = Новый Структура();
	
	ОпределенияКлиентов.Вставить("ЭтоКлиентСАФМАР", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентЮгория", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентБольшой", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Большой")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентОПФ", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентТелеком", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентБудущее", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентТранснефть", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Транснефть")));
	ОпределенияКлиентов.Вставить("ЭтоКлиентФедерация", (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация")));
