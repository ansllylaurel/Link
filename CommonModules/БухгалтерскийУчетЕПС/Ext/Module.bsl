			ИзменениеДисконтаПремии = РезультатРасчетаДисконтаПремии.ТекущийДисконтНаПакет - Окр(НачальныйДисконт * Количество, 2);
		
		ИначеЕсли ОпределенияКлиентов.ЭтоКлиентСАФМАР Тогда
			
			ОценочныеДисконтПремия = Окр(РезультатРасчетаДисконтаПремии.ТекущийДисконт * Количество, 2);
			ИзменениеДисконтаПремии = Окр(РезультатРасчетаДисконтаПремии.ТекущийДисконт * Количество, 2) - Окр(НачальныйДисконт * Количество, 2);
			
		ИначеЕсли НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетодСПолнымСписаниемПриАмортизациИПересчетомПриОфертах Тогда
			
			ОценочныеДисконтПремия = РезультатРасчетаДисконтаПремии.ОценочныйДисконтНаПакет;
			ИзменениеДисконтаПремии = РезультатРасчетаДисконтаПремии.ИзменениеДисконтаНаПакет;
			
		КонецЕсли;
		
	Иначе // купили по номиналу - сделал эту ветку, чтобы копейки из-за округления не лезли
	
		ОценочныеДисконтПремия = 0;
		ИзменениеДисконтаПремии = 0;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		ДанныеРасчета = Новый Структура;
		ДанныеРасчета.Вставить("НачальныйДисконт",				НачальныйДисконт);
		ДанныеРасчета.Вставить("ДатаПогашения",					ДатаПогашения);
		ДанныеРасчета.Вставить("Номинал",						Номинал);
		ДанныеРасчета.Вставить("ДнейОтПереоценкиДоПогашения",	ДнейОтПереоценкиДоПогашения);
		ДанныеРасчета.Вставить("ДнейОтПокупкиДоПогашения",		ДнейОтПокупкиДоПогашения);
		ДанныеРасчета.Вставить("ДнейОтПокупкиДоПереоценки",		ДнейОтПокупкиДоПереоценки);
		ДанныеРасчета.Вставить("ЭтоДеньПокупки",				НачалоДня(ДатаПокупки) = НачалоДня(ДатаПереоценки));
		ДанныеРасчета.Вставить("ЭтоДеньПогашения",				НачалоДня(ДатаПогашения) = НачалоДня(ДатаПереоценки));
		ДанныеРасчета.Вставить("ВариантУчетаДисконтаПремии",	НастройкиУчета.ВариантУчетаДисконтаПремии);
		ДанныеРасчета.Вставить("ТекущийДисконт",				РезультатРасчетаДисконтаПремии.ТекущийДисконт);
		ДанныеРасчета.Вставить("ПогашенияДисконтов",			РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
		ДанныеРасчета.Вставить("ОценочныеДисконтПремия",		ОценочныеДисконтПремия);
		ДанныеРасчета.Вставить("ИзменениеДисконтаПремии",		ИзменениеДисконтаПремии);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеРасчета", ДанныеРасчета, "Данные расчета", Истина, Истина);
		
	КонецЕсли;
	
	//Дополнительные данные, которые понадобятся при расчете корректировки ЭСП
	ДанныеРасчетаДисконтаПремии = Новый Структура;
	
	ДанныеРасчетаДисконтаПремии.Вставить("ОценочныеДисконтПремия",		ОценочныеДисконтПремия);
	ДанныеРасчетаДисконтаПремии.Вставить("ИзменениеДисконтаПремии",		ИзменениеДисконтаПремии);
	ДанныеРасчетаДисконтаПремии.Вставить("ДнейОтПокупкиДоПогашения",	ДнейОтПокупкиДоПогашения);
	ДанныеРасчетаДисконтаПремии.Вставить("ПогашенияДисконтов",			РезультатРасчетаДисконтаПремии.ПогашенияДисконтов);
	ДанныеРасчетаДисконтаПремии.Вставить("ДатаПогашения",				ДатаПогашения);
	ДанныеРасчетаДисконтаПремии.Вставить("Номинал",						Номинал);
	ДанныеРасчетаДисконтаПремии.Вставить("ДнейОтПереоценкиДоПогашения",	ДнейОтПереоценкиДоПогашения);
	
	Возврат ДанныеРасчетаДисконтаПремии;

КонецФункции 

Функция ПолучитьДниНачисленияКорректировкиЭСП(ПервыйДень, ПоследнийДень, Облигация, СчетДоверительногоУправления, НастройкиУчета, НастройкиУчетаАктива)

	Если НастройкиУчетаАктива.ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать Тогда
		Возврат	Новый Массив;
	КонецЕсли;
	
	МассивДнейОпераций = Новый Массив;
	Если НастройкиУчетаАктива.НачислятьКорректировкуЭСПВДеньОперации Тогда // получим операции за период
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Период, ДЕНЬ) КАК День
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|ГДЕ
			|	БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
			|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И БухПартииЦенныхБумаг.Период >= &ПервыйДень
			|	И БухПартииЦенныхБумаг.Период <= &ПоследнийДень
			|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И БухПартииЦенныхБумаг.Активность
			|	И (БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
			|				И НЕ &НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
			|				И НЕ &НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПогашениеКупона
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПогашениеЦеннойБумаги
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.Сделка
			|			ИЛИ БухПартииЦенныхБумаг.Регистратор ССЫЛКА Документ.СделкаРЕПО)
			|
			|УПОРЯДОЧИТЬ ПО
			|	День";
		
		Запрос.УстановитьПараметр("ПервыйДень", ПервыйДень);
		Запрос.УстановитьПараметр("ПоследнийДень", ПоследнийДень);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
		Запрос.УстановитьПараметр("НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода", НастройкиУчета.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода);
		
		МассивДнейОпераций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("День");
		
	КонецЕсли;
	
	МассивНерабочихДней = Новый Массив;
	Если НастройкиУчетаАктива.ПериодичностьНачисленияКорректировкиЭСП = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно
		И НЕ НастройкиУчетаАктива.НачислятьПроцентныеДоходыВНерабочиеДни Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеКалендаря.Дата КАК День
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|	И ДанныеКалендаря.ВидДня <> ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
			|	И ДанныеКалендаря.Дата >= &ПервыйДень
			|	И ДанныеКалендаря.Дата <= &ПоследнийДень
			|	И НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ), ДЕНЬ) <> ДанныеКалендаря.Дата"; // конец месяца не может быть нерабочим днем
		
		Запрос.УстановитьПараметр("ПервыйДень", ПервыйДень);
		Запрос.УстановитьПараметр("ПоследнийДень", ПоследнийДень);
		
		МассивНерабочихДней = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("День");
			
	КонецЕсли;
	
	МассивДнейПереоценки = Новый Массив;
	ТекущаяДата = ПоследнийДеньПериода(ПервыйДень, НастройкиУчетаАктива.ПериодичностьНачисленияКорректировкиЭСП);
	Пока ТекущаяДата <= ПоследнийДень Цикл
		
		Если МассивНерабочихДней.Найти(ТекущаяДата) = Неопределено Тогда 
			МассивДнейПереоценки.Добавить(ТекущаяДата);
		КонецЕсли;
		
		ТекущаяДата = ПоследнийДеньПериода(ТекущаяДата + 86400, НастройкиУчетаАктива.ПериодичностьНачисленияКорректировкиЭСП);
		
	КонецЦикла;
	
	Если НастройкиУчетаАктива.НачислятьКорректировкуЭСПВДеньОперации Тогда
		Возврат СлитьУпорядоченныеМассивы(МассивДнейОпераций, МассивДнейПереоценки);	
	Иначе
		Возврат МассивДнейПереоценки;
	КонецЕсли;

КонецФункции 

Функция ПолучитьСтоимостьСУчетомАмортизацииНоминала(Цена, Облигация, ДатаНачальная, ДатаКонечная, НеАмортизироватьПремию = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК НоминалНачальный,
		|	НоминалыЦенныхБумагСрезПоследних1.Номинал КАК НоминалКонечный
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаНачальная, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних,
		|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаКонечная, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних1";
	
	Запрос.УстановитьПараметр("ДатаКонечная", ДатаКонечная);
	Запрос.УстановитьПараметр("ДатаНачальная", ДатаНачальная);
	Запрос.УстановитьПараметр("ЦеннаяБумага", Облигация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если НеАмортизироватьПремию И Цена > ВыборкаДетальныеЗаписи.НоминалНачальный Тогда
			
			Возврат ВыборкаДетальныеЗаписи.НоминалКонечный + (Цена - ВыборкаДетальныеЗаписи.НоминалНачальный);
			
		Иначе
			
			Возврат Цена / ВыборкаДетальныеЗаписи.НоминалНачальный * ВыборкаДетальныеЗаписи.НоминалКонечный;
			
		КонецЕсли;
		
	Иначе
		
		Возврат Цена;
		
	КонецЕсли;

КонецФункции  

Функция НайтиДатыИзмененияПотоковПоРешениюКлиента(СчетДоверительногоУправления, Облигация, ДатаПокупки, ДатаПереоценки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумаг.Период КАК Дата
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
		|ГДЕ
		|	ЗначенияНастроекУчетаЦенныхБумаг.Организация = &Организация
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Клиент = &Клиент
		|	И ЗначенияНастроекУчетаЦенныхБумаг.ЦеннаяБумага = &Облигация
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период >= &ДатаПокупки
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Период <= &ДатаПереоценки
		|	И ЗначенияНастроекУчетаЦенныхБумаг.Настройка = &Настройка";
	
	Запрос.УстановитьПараметр("ДатаПереоценки", ДатаПереоценки);
	Запрос.УстановитьПараметр("ДатаПокупки", ДатаПокупки);
	Запрос.УстановитьПараметр("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки));
	Запрос.УстановитьПараметр("Настройка", ПланыВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ДенежныйПотокПоОблигации);
	Запрос.УстановитьПараметр("Организация", СчетДоверительногоУправления.Организация);
	Запрос.УстановитьПараметр("Облигация", Облигация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОпределитьНеобходимостьИспользованияМетодикиЦБПриРасчетеЭСПДоОферты(НастройкиУчета, Облигация, ДатаПокупки, ДатаПереоценки, СчетДоверительногоУправления, ДатыИзмененийИнформацииОДенежныхПотоках)

	ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты = Ложь;
	
	Если НастройкиУчета.ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты Тогда
		
		ДатыИзмененийИнформацииОДенежныхПотоках = НайтиДатыИзмененияПотоковПоРешениюКлиента(СчетДоверительногоУправления, Облигация, ДатаПокупки, ДатаПереоценки);
		
		Если ДатыИзмененийИнформацииОДенежныхПотоках.Количество() = 0 Тогда
		
			Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты Тогда
			
				ДатыИзмененийИнформацииОДенежныхПотоках = Справочники.Облигации.ПолучитьОфертыЗаПериод(Облигация, НачалоДня(ДатаПокупки), КонецДня(ДатаПереоценки));
				
			Иначе // если до погашения, то так 
				
				ДатыИзмененийИнформацииОДенежныхПотоках = Справочники.Облигации.ПолучитьДатыИзмененийИнформацииОДенежныхПотоках(Облигация, НачалоДня(ДатаПокупки), КонецДня(ДатаПереоценки));	
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если ДатыИзмененийИнформацииОДенежныхПотоках.Количество() > 0 Тогда
			
			ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты = Истина;
		
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты;

КонецФункции

Функция РассчитатьКорректировкуПоЭСП(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, ДанныеРасчетаДисконтаПремии, Биржа, Отказ, РасшифровкаРасчета = Неопределено)  
	
	СчетДоверительногоУправления									= ДанныеПереоценки.СчетДоверительногоУправления;
	ДатаПереоценки													= ДанныеПереоценки.ДатаПереоценки;
	Количество														= ДанныеПереоценки.Количество;
	ОценочнаяСуммаКупона											= ДанныеПереоценки.ОценочнаяСуммаКупона;
	УчетныйАктивЕПС													= ДанныеПереоценки.УчетныйАктивЕПС; 
	Партия															= ДанныеПереоценки.Партия;
	СтрокаПартии													= ДанныеПереоценки.СтрокаПартии;
	Стоимость														= ДанныеПереоценки.Стоимость;
	
	РешенияКлиентовПоЗначениямЭСП									= Неопределено;
	ДанныеПереоценки.Свойство("РешенияКлиентовПоЗначениямЭСП", РешенияКлиентовПоЗначениямЭСП);

	КэшированныйДенежныйПоток										= Неопределено;
	ДанныеПереоценки.Свойство("ДенежныйПоток", КэшированныйДенежныйПоток);
	Если КэшированныйДенежныйПоток = Неопределено Тогда
		ДенежныйПоток = Неопределено;
	Иначе
		ДенежныйПоток = КэшированныйДенежныйПоток.Скопировать();
	КонецЕсли;
	
	НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные		= ДанныеПокупки.НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные; 
	ДатаПокупки														= ДанныеПокупки.ДатаПокупки; 
	ЦенаПокупки														= ДанныеПокупки.ЦенаПокупки; 
	ЦенаПокупкиКупона												= ДанныеПокупки.ЦенаПокупкиКупона; 
			
	ОценочныеДисконтПремия											= ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия;
	ИзменениеДисконтаПремии											= ДанныеРасчетаДисконтаПремии.ИзменениеДисконтаПремии;
	ПогашенияДисконтов												= ДанныеРасчетаДисконтаПремии.ПогашенияДисконтов;
	ДнейОтПокупкиДоПогашения										= ДанныеРасчетаДисконтаПремии.ДнейОтПокупкиДоПогашения;
	ДатаПогашения													= ДанныеРасчетаДисконтаПремии.ДатаПогашения;
	Номинал															= ДанныеРасчетаДисконтаПремии.Номинал;
	
	ДанныеПереоценки.Вставить("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", НастройкиУчета.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеПереоценки", ДанныеПереоценки, "Данные переоценки", Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеПокупки", ДанныеПокупки, "Данные покупки", Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДанныеРасчетаДисконтаПремии", ДанныеРасчетаДисконтаПремии, "Данные расчета дисконта/премии", Истина);
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "НастройкиУчета", НастройкиУчета, "Настройки учета", Истина, Истина);
		
	КонецЕсли;
	
	// завели в конце 2021 по просьбе Достойного Будущего (Сафмара) по больщей части для успокояния совести т.к. никогда не было такого большого пакета бумаг, чтобы сказалась 15ая цифра после запятой, и не будет, я думаю
	ТочностьОкругленияДисконтируемыхСуммДенежныхПотоковПриРасчетеАС = 14;

	МассивСчетовРОСТЕХа = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Ростех"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
																				ДатаПереоценки);
	ЭтоКлиентРОСТЕХ = (МассивСчетовРОСТЕХа.Найти(СчетДоверительногоУправления) <> Неопределено);
	
	Если ЭтоКлиентРОСТЕХ Тогда
		ТочностьОкругленияДисконтируемыхСуммДенежныхПотоковПриРасчетеАС = 2; // 2!!! Карл!!! 
		                                                                     // Эта штука используется в расчете РасчетСтоимостиПоЭСПМетодомЧИСТНЗ 
																			 // И там для этого случая есть хардкод т.к. РОСТЕХ "тут округляем, а тут нет"
																			 // Поэтому, если менять тут, то нужно не забыть поменять еще и в РасчетСтоимостиПоЭСПМетодомЧИСТНЗ
	КонецЕсли;
	
	
	// отрабатываем ситуацию: переоценка в день покупки + если только не нужна визуализация
	Если НачалоДня(ДатаПокупки) = НачалоДня(ДатаПереоценки) И РасшифровкаРасчета = Неопределено Тогда
		Возврат Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП", 0, 0, 0);
	КонецЕсли;
	
	Если НастройкиУчета.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ЛинейныйМетод Тогда 
		Возврат Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП", 0, 0, 0);
	КонецЕсли;
	
	// исходим из предположения, что если клиент однажды отказался от использования ЭСП, то он к ней уже не вернется
	// а то РешенияКлиентовПоЗначениямЭСП входло в конфликт с ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты
	Если РешенияКлиентовПоЗначениямЭСП = Неопределено Тогда
		РешениеКлиентаПоЭСП = РегистрыСведений.РешенияКлиентовПоЗначениямЭСП.ПолучитьПоПартии(Облигация, Партия, СтрокаПартии, ДатаПереоценки);
	Иначе
		СтрокиРешений = РешенияКлиентовПоЗначениямЭСП.НайтиСтроки(Новый Структура("ЦеннаяБумага, Партия, СтрокаПартии", Облигация, Партия, СтрокаПартии));
		Если СтрокиРешений.Количество() > 0 Тогда
			РешениеКлиентаПоЭСП = Новый Структура("Используется, ЭСП", СтрокиРешений[0].Используется, СтрокиРешений[0].ЭСП);
		Иначе	
			РешениеКлиентаПоЭСП = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если РешениеКлиентаПоЭСП <> Неопределено И НЕ РешениеКлиентаПоЭСП.Используется Тогда
		Возврат Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП", 0, 0, 0);
	КонецЕсли;			
	
	// нам нужно понять, до какого момента мы ищем - до оферты или до погашения
	Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
		СчитаемДоПогашения = Истина;
	Иначе
		СчитаемДоПогашения = Ложь;
	КонецЕсли;
	
	МассивСчетовБудущего = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
	ЭтоКлиентБудущее = (МассивСчетовБудущего.Найти(СчетДоверительногоУправления) <> Неопределено);
				
		
	// #Хардкод №3 - т.к. уже 3й то пишем #ТехническийДолг и ставим задачу на общую схему
	Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПочтаРФ_009") Тогда
		
		МассивСчетовТелеком = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																					ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"),
																					ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																					ДатаПереоценки);
		ЭтоКлиентТелеком = (МассивСчетовТелеком.Найти(СчетДоверительногоУправления) <> Неопределено);
		
		// #ОбъединениеБудущего. Тут при объединении Будущего проблем не возникнет. На данный момент эта бумага только у Будущего, Телекома и Эволюции. Будущее и Телеком объединятся, а Эволюция сама по себе.
		Если ЭтоКлиентБудущее ИЛИ ЭтоКлиентТелеком Тогда
		
			СчитаемДоПогашения = Ложь;
		
		КонецЕсли;
	
	КонецЕсли;
	
	ЭтоАвтодорУОПФ = Ложь;
	Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002")
		И ДатаПереоценки >= '20220707' 
		И ДатаПереоценки <= '20220831' Тогда
	
		МассивСчетовОПФ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФОПФ"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				ДатаПереоценки);
		ЭтоКлиентОПФ = (МассивСчетовОПФ.Найти(СчетДоверительногоУправления) <> Неопределено);
		
		ЭтоАвтодорУОПФ = ЭтоКлиентОПФ;
		
	КонецЕсли;
	
	// Точность расчета ЭСП может быть увеличена клиентом
	
	ТочностьРасчетаЭСП = Неопределено;
	ЭтоКлиентСАФМАР = Ложь;
	
	Если ДатаПереоценки >= '20230101' И ЭтоКлиентГруппыБудущее(СчетДоверительногоУправления, ДатаПереоценки) Тогда
		ТочностьРасчетаЭСП = 0.0000000001; // #462467 группа Будущее стандартизировали все
	ИначеЕсли ДатаПереоценки >= '20210412' Тогда // #Хардкод #371436
	
		МассивСчетовСАФМАР = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
			ДатаПереоценки);
	
		ЭтоКлиентСАФМАР = (МассивСчетовСАФМАР.Найти(СчетДоверительногоУправления) <> Неопределено);

		Если ЭтоКлиентСАФМАР Тогда
			ТочностьРасчетаЭСП = 0.000000001;
		КонецЕсли;

	КонецЕсли;
	
	ДатыИзмененийИнформацииОДенежныхПотоках = Новый ТаблицаЗначений;
	
	// если в данный момент используется решение клиента по ЭСП,
	// или же по бумаге пришел денежный поток (а он приходит только для бумаг с постоянной ставкой без оферт и настроек)
	// то и нет никакого смысла считать по методике	ЦБ
	Если ДенежныйПоток <> Неопределено ИЛИ РешениеКлиентаПоЭСП <> Неопределено Тогда
	    ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты = Ложь;
	Иначе		
		ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты = ОпределитьНеобходимостьИспользованияМетодикиЦБПриРасчетеЭСПДоОферты(
			НастройкиУчета, Облигация, ДатаПокупки, ДатаПереоценки, СчетДоверительногоУправления, ДатыИзмененийИнформацииОДенежныхПотоках);
	КонецЕсли;
	
	
	Если ДенежныйПоток <> Неопределено Тогда
		// убрать потоки ранее даты покупки т.к. брали от ДатаНачалаРазмещения
		КоличествоПотоков = ДенежныйПоток.Количество();
		Для Инд = 0 По КоличествоПотоков - 1 Цикл
			СтрокаПотока = ДенежныйПоток[КоличествоПотоков - 1 - Инд];
			Если СтрокаПотока.Дата <= НачалоДня(ДатаПокупки) Тогда
				ДенежныйПоток.Удалить(СтрокаПотока);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТекущаяДатаПокупки			= НачалоДня(ДатаПокупки);
	ТекущаяЦенаПокупки			= ЦенаПокупки;
	ТекущаяЦенаПокупкиКупона	= ЦенаПокупкиКупона;
	
	ТекущаяДатаПереоценки		= НачалоДня(ДатаПокупки);	
	
	Если ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты Тогда
		
		#Область Методика_ЦБ_при_расчете_ЭСП_до_оферты
		
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ЭСП", Новый ОписаниеТипов("Число"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ТекущаяЦенаПокупки", Новый ОписаниеТипов("Число"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ТекущаяЦенаПокупкиКупона", Новый ОписаниеТипов("Число"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("СтоимостьПоЭСП", Новый ОписаниеТипов("Число"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ТекущаяДатаПокупки", Новый ОписаниеТипов("Дата"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ТекущаяДатаПереоценки", Новый ОписаниеТипов("Дата"));
		ДатыИзмененийИнформацииОДенежныхПотоках.Колонки.Добавить("ТекущаяДатаНачалаДенежныхПотоков", Новый ОписаниеТипов("Дата"));
		
		ТекущаяДатаНачалаДенежныхПотоков = НачалоДня(ДатаПокупки);
		ДатаОпределенияЭСП = НачалоДня(Партия.Дата);
		
		Для каждого ДатаИзмененийИнформации Из ДатыИзмененийИнформацииОДенежныхПотоках Цикл
			
			РезультатыРасчета = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
				Облигация, СчитаемДоПогашения, ТекущаяДатаПокупки, ТекущаяЦенаПокупки, СчетДоверительногоУправления, Биржа, ТекущаяДатаПереоценки,
				НастройкиУчета.УчитыватьКупонКОферте, ТекущаяЦенаПокупкиКупона, ТочностьРасчетаЭСП, ДанныеПереоценки);
			ЭСП = РезультатыРасчета.Доходность;
			ДенежныйПоток = РезультатыРасчета.ДенежныйПоток;
			
			ИсторическаяРазрядностьОкругленияЭСП = БухгалтерскийУчет.ОпределитьНастройкуУчета(
				ДатаИзмененийИнформации.Дата,
				СчетДоверительногоУправления.Организация,
				СчетДоверительногоУправления,
				"РазрядностьОкругленияЭСП");
				
			Если ИсторическаяРазрядностьОкругленияЭСП > 0 Тогда
				ЭСП = Окр(ЭСП, ИсторическаяРазрядностьОкругленияЭСП);
			КонецЕсли;
			
			СтоимостьПоЭСП = РасчетСтоимостиПоЭСПМетодомЧИСТНЗ(
									Облигация,
									НачалоДня(ДатаИзмененийИнформации.Дата),
									ТекущаяДатаНачалаДенежныхПотоков,
									СчитаемДоПогашения,
									ЭСП,
									СчетДоверительногоУправления,
									НастройкиУчета,
									ДанныеПереоценки,
									ТочностьОкругленияДисконтируемыхСуммДенежныхПотоковПриРасчетеАС,
									ДенежныйПоток,
									Отказ,
									РасшифровкаРасчета);
			
			ТекущаяДатаПокупки = ДатаИзмененийИнформации.Дата;
			ТекущаяЦенаПокупки = СтоимостьПоЭСП;
			ТекущаяЦенаПокупкиКупона = Справочники.Облигации.ПолучитьКупон(Облигация, ДатаИзмененийИнформации.Дата, , Биржа);
			ТекущаяЦенаПокупки = ТекущаяЦенаПокупки - ТекущаяЦенаПокупкиКупона;
			
			ТекущаяДатаПереоценки = НачалоДня(ДатаИзмененийИнформации.Дата);
			ТекущаяДатаНачалаДенежныхПотоков = НачалоДня(ДатаИзмененийИнформации.Дата);
			
			 // При расчете до оферты в датах изменения будут даты оферт,
			 // а при расчете до погашения - даты публикации купонов. Это неочевидно.
			 // #Техдолг
			
			Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты Тогда
				ТекущаяДатаНачалаДенежныхПотоков = ТекущаяДатаНачалаДенежныхПотоков - 86400; // связано с тем, что в этот день может быть оферта и мы должны ее взять
			КонецЕсли;	
			
			ДатаИзмененийИнформации.ЭСП = ЭСП;
			ДатаИзмененийИнформации.ТекущаяЦенаПокупки = ТекущаяЦенаПокупки;
			ДатаИзмененийИнформации.ТекущаяЦенаПокупкиКупона = ТекущаяЦенаПокупкиКупона;
			ДатаИзмененийИнформации.СтоимостьПоЭСП = СтоимостьПоЭСП;
			ДатаИзмененийИнформации.ТекущаяДатаПокупки = ТекущаяДатаПокупки;
			ДатаИзмененийИнформации.ТекущаяДатаПереоценки = ТекущаяДатаПереоценки;
			ДатаИзмененийИнформации.ТекущаяДатаНачалаДенежныхПотоков = ТекущаяДатаНачалаДенежныхПотоков;
			
		КонецЦикла;
		
		ДенежныйПоток = Неопределено;
		
		Если РасшифровкаРасчета <> Неопределено Тогда
		
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(
					РасшифровкаРасчета,
					"МетодикаЦБ",
					Новый Структура("ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты", ИспользоватьМетодикуЦБПриРасчетеЭСПДоОферты),
					"Использовать методику ЦБ при расчете ЭСП до оферты",
					Ложь);
			РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "ДатыИзмененийИнформацииОДенежныхПотоках", ДатыИзмененийИнформацииОДенежныхПотоках, "Даты изменений информации о денежных потоках", Истина);
			
		КонецЕсли;
		
		#КонецОбласти
		
	Иначе
		// иначе неправильно опеределяются решения клиентов при вводе бумаг - их вводят датой ввода, а не датой покупки
		ТекущаяДатаПереоценки = ДатаПереоценки;
		
	КонецЕсли;
	
	Если ТекущаяДатаПереоценки <> ДатаПереоценки Тогда
		РешениеКлиентаПоЭСП = РегистрыСведений.РешенияКлиентовПоЗначениямЭСП.ПолучитьПоПартии(Облигация, Партия, СтрокаПартии, ТекущаяДатаПереоценки);
	КонецЕсли;	
	
	// Нам нужно понять, начиная с какой даты мы ищем ближайшую оферту (погашение) 
	
	ДатаОпределенияПогашения = НачалоДня(ТекущаяДатаПереоценки);
	Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты Тогда
		ДатаОпределенияПогашения = КонецДня(ТекущаяДатаПереоценки); // мы переоцениваем вечером, после не прошедшей оферты
	КонецЕсли;
	
	// Получим ЭСП
	Если РешениеКлиентаПоЭСП = Неопределено Тогда
		
		ДанныеРасчета = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
			Облигация, СчитаемДоПогашения, ТекущаяДатаПокупки, ТекущаяЦенаПокупки, СчетДоверительногоУправления, Биржа, ДатаОпределенияПогашения,
			НастройкиУчета.УчитыватьКупонКОферте, ТекущаяЦенаПокупкиКупона, ТочностьРасчетаЭСП, ДанныеПереоценки, ДенежныйПоток);
			
		ЭСП = ДанныеРасчета.Доходность;
		Если ДенежныйПоток = Неопределено Тогда
			ДенежныйПоток = ДанныеРасчета.ДенежныйПоток;
		КонецЕсли;
		
			
		// возник прецедент: согласованная НКСД и клиентом ЭСП имеет точность 10 знаков, а по УП точность 7 знаков
		// решено применять РазрядностьОкругленияЭСП только для расчетной ЭСП
		Если ТекущаяДатаПокупки	= НачалоДня(ДатаПокупки) Тогда
			ДатаОпределенияРазрядностиОкругленияЭСП = НачалоДня(Партия.Дата); // если вводили
		Иначе
			ДатаОпределенияРазрядностиОкругленияЭСП = НачалоДня(ТекущаяДатаПокупки);
		КонецЕсли;
		ИсторическаяРазрядностьОкругленияЭСП = БухгалтерскийУчет.ОпределитьНастройкуУчета(
			ДатаОпределенияРазрядностиОкругленияЭСП,
			СчетДоверительногоУправления.Организация,
			СчетДоверительногоУправления,
			"РазрядностьОкругленияЭСП");
		
		Если ИсторическаяРазрядностьОкругленияЭСП > 0 Тогда
			ЭСП = Окр(ЭСП, ИсторическаяРазрядностьОкругленияЭСП);
		КонецЕсли;
		
	ИначеЕсли РешениеКлиентаПоЭСП.Используется Тогда
		
		// для ЭСП, предоставленной клиентом настройку РазрядностьОкругленияЭСП не применяем
		ЭСП = РешениеКлиентаПоЭСП.ЭСП;
		
	Иначе
		Возврат Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП", 0, 0, 0);
	КонецЕсли;
	
	НачальнаяСтоимость = ЦенаПокупки + ЦенаПокупкиКупона;
	
	// считаем линейные проценты 
	ЛинейныеПроценты = - ЦенаПокупкиКупона;
	
	Если НЕ НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД Тогда
		ПогашенияКупонов = Справочники.Облигации.ПолучитьПогашенияКупонов(Облигация, СчитаемДоПогашения, ДатаПокупки, НачалоДня(ДатаПереоценки));
		Для каждого СтрокаПогашенияКупонов Из ПогашенияКупонов Цикл
			Если СтрокаПогашенияКупонов.Дата <= НачалоДня(ДатаПереоценки) Тогда
				ЛинейныеПроценты = ЛинейныеПроценты + СтрокаПогашенияКупонов.Поток;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
		НастройкиУчета,
		Облигация,
		УчетныйАктивЕПС,
		Партия,
		СтрокаПартии);
	
	// считаем стоимость по ЭСП тем или иным методом
	Если НЕ НастройкиУчета.РасчетСтоимостиМетодомЧИСТНЗ И НЕ ЭтоАвтодорУОПФ Тогда
		
		// #ТехДолг #371436
		// Впервые столкнулись с необходимостью расчета стоимости по ЭСП итерационным методом с учетом разницы ПП,
		// нужно будет проверить для остальных вариантов учета ПП
		
		НачальнаяСтоимостьСУчетомРазницыПП = НачальнаяСтоимость + НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;  
		
		ДанныеРасчета = РасчетСтоимостиПоЭСПИтерационнымМетодом(
								Облигация, 
								УчетныйАктивЕПС, 
								ТекущаяДатаПокупки, 
								НачальнаяСтоимостьСУчетомРазницыПП, 
								ДатаПереоценки, 
								СчитаемДоПогашения, 
								ЭСП, 
								СчетДоверительногоУправления, 
								НастройкиУчета, 
								ДанныеПереоценки, 
								Количество, 
								РасшифровкаРасчета);
								
		СтоимостьПоЭСП = ДанныеРасчета.СтоимостьПоЭСП;
		ПроцентыПоЭСП = ДанныеРасчета.ПроцентыПоЭСП - ПогашенияДисконтов;
		ПроцентыПоЭСПНаПакет = Окр(ПроцентыПоЭСП * Количество, 2);
		
	Иначе
		
		Если ЗначениеЗаполнено(НастройкиУчета.ДенежныйПотокПоОблигации) Тогда
			ДенежныйПоток = НастройкиУчета.ДенежныйПотокПоОблигации.Поток.Выгрузить();
			ДенежныйПоток.Колонки.Сумма.Имя = "Поток";
		КонецЕсли;
		
		// убираем из денежного потока уже прошедшие выплаты купонов - они уже не участвуют в расчете АС (а для ЭСП были нужны)
		Если ДенежныйПоток <> Неопределено Тогда
			КоличествоПотоков = ДенежныйПоток.Количество();
			Для Инд = 0 По КоличествоПотоков - 1 Цикл
				СтрокаПотока = ДенежныйПоток[КоличествоПотоков - 1 - Инд];
				Если СтрокаПотока.Дата <= НачалоДня(ДатаПереоценки) Тогда
					ДенежныйПоток.Удалить(СтрокаПотока);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		СтоимостьПоЭСП = РасчетСтоимостиПоЭСПМетодомЧИСТНЗ(
								Облигация, 
								ДатаПереоценки, 
								ДатаПереоценки, 
								СчитаемДоПогашения, 
								ЭСП, 
								СчетДоверительногоУправления, 
								НастройкиУчета, 
								ДанныеПереоценки, 
								ТочностьОкругленияДисконтируемыхСуммДенежныхПотоковПриРасчетеАС,
								ДенежныйПоток,
								Отказ,
								РасшифровкаРасчета);
		
		// воткнул вот такое условие т.к. надо быстро
		// вообще мы с Сашей Т. это момент еще обсудим
		// ситуация такая: идет расчет АС для полного погашения
		// в данном случае АС = Номинал
		Если СтоимостьПоЭСП = 0 И НачалоДня(ДатаПогашения) = НачалоДня(ДатаПереоценки + 1) Тогда
			СтоимостьПоЭСП = Номинал;
		КонецЕсли;
		
		НеАмортизироватьПремию = Истина; // вынес на случай если у кого-то все же амортизировать
		НачальнаяСтоимость = ПолучитьСтоимостьСУчетомАмортизацииНоминала(ЦенаПокупки, Облигация, ДатаПокупки, ДатаПереоценки, НеАмортизироватьПремию) + ЦенаПокупкиКупона;		
		
		#Область Многочисленные_хардкоды_по_изменению_НачальнаяСтоимость_или_ИзменениеДисконтаПремии
		
		МассивСчетовЮгория = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
			ДатаПереоценки);

		ЭтоКлиентЮгория = (МассивСчетовЮгория.Найти(СчетДоверительногоУправления) <> Неопределено);
		
		// хардкод для бумаг прошедших реклассификацию, увы, но по-другому никак
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс") Тогда
			// #ОбъединениеБудущего. Эта бумага есть только у Будущего и Эволюции
			НачальнаяСтоимость = 863.929274101238;
			ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
			
			УчестьРеструктуризациюКупона = Ложь;
			Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PR116") 
				Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Телеком-Союз_ПР") //#698380
				Тогда
				НачальнаяСтоимость = 871.501393974676;
				УчестьРеструктуризациюКупона = Истина;
			ИначеЕсли СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN118")
				Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") //#698380
				Тогда
				НачальнаяСтоимость = 881.35;
				ИзменениеДисконтаПремии = 0; // этот клиент включил дисконт в тело
				УчестьРеструктуризациюКупона = Истина;
			КонецЕсли;
			
			// вот эта добавка связано с особенностями бумаги Вейл Финанс, и его учета у Будущего 
			// вейл провел реструктуризацию купонов и по каждому погашению из 46,86 выплачивает лишь 14,96
			// а разница 34,9 зависает ввиде задолженности
			// но на партиях этой 34,9 нигде нет! Поэтому прилось захардкодить все "зависшие" задолженности
			Если УчестьРеструктуризациюКупона И ДатаПереоценки >= '20210310' Тогда
				НачальнаяСтоимость = НачальнаяСтоимость + 34.9;
				Если ДатаПереоценки >= '20210908' Тогда
					НачальнаяСтоимость = НачальнаяСтоимость + 34.9;
					Если ДатаПереоценки >= '20220309' Тогда
						НачальнаяСтоимость = НачальнаяСтоимость + 34.9;
						Если ДатаПереоценки >= '20220907' Тогда
							НачальнаяСтоимость = НачальнаяСтоимость + 34.9;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Магистраль_002") Тогда	
			Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN112")
				Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") //#698380
				Тогда //НПФ Телеком-Союз АО ПН 250219-11 или НПФ БУДУЩЕЕ АО ПН 030518-2
				НачальнаяСтоимость = 928.806422303991;
				ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
			ИначеЕсли СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN118")
				Или СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") //#698380
				Тогда //НПФ БУДУЩЕЕ АО ПН 040319-4 или НПФ БУДУЩЕЕ АО ПН 030518-2
				Если Количество = 1000000 Тогда
					НачальнаяСтоимость = 929.2432738100;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				ИначеЕсли Количество = 1499294 Тогда
					НачальнаяСтоимость = 929.3433012805;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				ИначеЕсли Количество = 351138 Тогда
					НачальнаяСтоимость = 929.3766437697;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				ИначеЕсли Количество = 167732 Тогда
					НачальнаяСтоимость = 929.3766437531;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				ИначеЕсли Количество = 226432 Тогда
					НачальнаяСтоимость = 928.5987226187;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				ИначеЕсли Количество = 226434 Тогда
					НачальнаяСтоимость = 928.5987226742;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				// #ОбъединениеБудущего. Из //НПФ Телеком-Союз АО ПН 250219-11	
				ИначеЕсли Количество = 28264 И ДатаПереоценки >= ДатаНачалаОбъединенияПортфелейГруппыБудущее() Тогда
					НачальнаяСтоимость = 928.806422303991;
					ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Пересвет") Тогда	
			НачальнаяСтоимость = 1.302094295;
			ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун") Тогда	
			НачальнаяСтоимость = 566.03;
			ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
			Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PR116") Тогда 
				// #ОбъединениеБудущего. Финстоуна больше нет.	
				ИзменениеДисконтаПремии = 0; // этот клиент включил дисконт в тело
			КонецЕсли;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291") И НачалоДня(ДатаПокупки) = '20201117' Тогда
			МассивСчетовФедерации = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																						ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация"),
																						ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																						ДатаПереоценки);
			ЭтоКлиентФедерация = (МассивСчетовФедерации.Найти(СчетДоверительногоУправления) <> Неопределено);
				
			Если ЭтоКлиентФедерация Тогда
				НачальнаяСтоимость = 1019.52;
				Если НЕ НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД Тогда
					НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0;
				КонецЕсли;
			ИначеЕсли ЭтоКлиентБудущее И ДатаПереоценки >= ДатаНачалаОбъединенияПортфелейГруппыБудущее() Тогда
				// #ОбъединениеБудущего. Понаехалы из Федерации	
				Если Количество = 400 Или Количество = 1300 Или Количество = 600 Или Количество = 200000 Тогда
					НачальнаяСтоимость = 1019.52;
					Если НЕ НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД Тогда
						НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		// #Техдолг #Хардкод #348229 Начальную стоимость Финконсалт, прошедшего реклассификацию, считаем по данным на 01.12.2020
		ИначеЕсли ДатаПереоценки >= '20201201'
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт")				// ООО Финконсалт, 4B02-02-00342-R-001P, 1000.00 RUB
			И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN110")	// Эволюция  НПФ АО  ПН 250219-9(Образование 250219-9)
		Тогда	
			НачальнаяСтоимость = (364844000.00 - 36120.31 - 1240000.00 + 36432120.31) / 400000; // СС - Дисконт - Купон, взятые на 01.12.2020
			ИзменениеДисконтаПремии = ОценочныеДисконтПремия;
			
		// в процессе нескольких частичных переводов из этого портфеля этих бумаг
		// произошла потеря копейки из начальной стоимости, приходится корректировать
		// #561740
		ИначеЕсли СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Перспектива_ПР")
			И (Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26221") И НачалоДня(ДатаПереоценки) >= '20240930' И НачалоДня(ДатаПереоценки) < '20241101'
				ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26225") И Количество = 8588
				ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26236") И Количество = 113035 И НачалоДня(ДатаПереоценки) >= '20241031')
		Тогда
			 НачальнаяСтоимость = (Окр(НачальнаяСтоимость * Количество, 2) - 0.01) / Количество;
			 
		ИначеЕсли (СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Перспектива_ПР")
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26233") И Количество = 16377 И НачалоДня(ДатаПереоценки) >= '20241031')
			Или (СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Телеком-Союз_ПР")
			И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Минфин26233") И Количество = 16377 И НачалоДня(ДатаПереоценки) >= ДатаНачалаОбъединенияПортфелейГруппыБудущее())
		Тогда
			// #ОбъединениеБудущего. А это поедит в НПФ Телеком-Союз АО ПР
			 НачальнаяСтоимость = (Окр(НачальнаяСтоимость * Количество, 2) + 0.01) / Количество;
			
		// не нужно амортизировать начальную стоимость т.к. Югория амортизацию считает ЛИНЕЙНО(!!!) и период не учитывает 
		ИначеЕсли ЭтоКлиентЮгория Тогда 
			
			НачальнаяСтоимость = ЦенаПокупки + ЦенаПокупкиКупона;
			
			Если ДатаПереоценки >= '20230223' И ДатаПереоценки < '20240223' Тогда
				ДатаОкончанияВзятияАмортизаций = ДатаПереоценки; // на этом промежутке работал неправильный вариант
			Иначе
				ДатаОкончанияВзятияАмортизаций = ДатаПогашения;
			КонецЕсли;
			
			ТаблицаАмортизаций = ПолучитьТаблицуАмортизаций(Облигация, ДатаПокупки, ДатаОкончанияВзятияАмортизаций);
			Для каждого СтрокаТаблицыАмортизаций Из ТаблицаАмортизаций Цикл
				Если СтрокаТаблицыАмортизаций.Дата < ДатаПереоценки Тогда
					НачальнаяСтоимость = НачальнаяСтоимость - СтрокаТаблицыАмортизаций.Поток;
				КонецЕсли;
			КонецЦикла;
			
			ОценочнаяСуммаКупона = Справочники.Облигации.ПолучитьКупон(Облигация, НачалоДня(ДатаПереоценки), СчетДоверительногоУправления, Биржа) * Количество;
			
		КонецЕсли;
		
		#КонецОбласти
		
		ПроцентыПоЭСП			= СтоимостьПоЭСП - НачальнаяСтоимость + ЛинейныеПроценты + ЦенаПокупкиКупона;
		ПроцентыПоЭСПНаПакет	= Окр(СтоимостьПоЭСП * Количество, 2) - Окр(НачальнаяСтоимость * Количество, 2) + (ЛинейныеПроценты + ЦенаПокупкиКупона) * Количество;
		
		Если Не НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания ИЛИ ДатаПереоценки < '20200401' Тогда // 31.03.2020 я (коля) сделал корректировку, чтобы ПП стало правильно
			ПроцентыПоЭСП		 = ПроцентыПоЭСП		- НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
			ПроцентыПоЭСПНаПакет = ПроцентыПоЭСПНаПакет - НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * Количество;
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002") Тогда
			ПроцентыПоЭСП		 = ПроцентыПоЭСП		- МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
			ПроцентыПоЭСПНаПакет = ПроцентыПоЭСПНаПакет - МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) * Количество;
		Иначе
			ПроцентыПоЭСП		 = ПроцентыПоЭСП		+ МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
			ПроцентыПоЭСПНаПакет = ПроцентыПоЭСПНаПакет + МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) * Количество;
		КонецЕсли;

	КонецЕсли;
	

	Если НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД Тогда
		
		АСНаПакет = Окр(СтоимостьПоЭСП * Количество, 2);
		
		ТелоНаПакет = Окр(Стоимость, 2);
		
		ОценочнаяКорректировкаЭСП = АСНаПакет - ТелоНаПакет - Окр(ОценочныеДисконтПремия, 2) - Окр(ОценочнаяСуммаКупона, 2);

		//Если СчетаДУСПравильнымУчетомПП.Найти(Партия.СчетДоверительногоУправления) = Неопределено ИЛИ ДатаПереоценки < '20200401' Тогда
		Если Не НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания ИЛИ ДатаПереоценки < '20200401' Тогда
			// 31.03.2020 я (коля) сделал корректировку, чтобы ПП стало правильно
			ОценочнаяКорректировкаЭСП = ОценочнаяКорректировкаЭСП - Окр(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * Количество, 2);
		ИначеЕсли Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002")
			ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291")
				И НачалоДня(ДатаПокупки) = '20201117'
				И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки) = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Федерация") 
			// #ОбъединениеБудущего. Понаехалы из Федерации	
			Или Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВЭБ.РФ_291")
				И НачалоДня(ДатаПокупки) = '20201117'
				И ЭтоКлиентБудущее И ДатаПереоценки >= ДатаНачалаОбъединенияПортфелейГруппыБудущее() И (Количество = 400 Или Количество = 1300 Или Количество = 600 Или Количество = 200000)
		Тогда
			ОценочнаяКорректировкаЭСП = ОценочнаяКорректировкаЭСП - Окр(МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) * Количество, 2);
		Иначе
			ОценочнаяКорректировкаЭСП = ОценочнаяКорректировкаЭСП + Окр(МатематическиеФункции.МодульЧисла(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) * Количество, 2);
		КонецЕсли;
	
	ИначеЕсли НастройкиУчета.РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением Тогда 
		// методика УГМК: не округляем дисконт/премию, округляем всю корректировку (см. #363141)
		ОценочнаяКорректировкаЭСП = Окр(ПроцентыПоЭСП * Количество - (ИзменениеДисконтаПремии + ОценочнаяСуммаКупона + ЛинейныеПроценты * Количество), 2);
	Иначе
		// нормальные клиенты: округляем дисконт/премию (остальные части стоимости уже округлены) - собираем корректировку из сумм, округленных до 2х знаков
		ОценочнаяКорректировкаЭСП = ПроцентыПоЭСПНаПакет - (Окр(ИзменениеДисконтаПремии, 2) + ОценочнаяСуммаКупона + ЛинейныеПроценты * Количество);
		
		// #423823 - многострадальная бумага в портфелях Эволюции - купили за 1000.125, затем перевели 28.01.22 в другой портфель нечетное количество и т.к. фонд и СД считают "на пакет", а наш расчет на бумагу не совпадает сделал "как у фонда и СД"
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ПочтаРФ_009") И ДатаПереоценки >= '20220128' Тогда
		
			ПроцентыПоЭСПНаПакет = Окр(СтоимостьПоЭСП * Количество, 2) + (- НачальнаяСтоимость + ЛинейныеПроценты + ЦенаПокупкиКупона) * Количество;
			ОценочнаяКорректировкаЭСП = ПроцентыПоЭСПНаПакет - (Окр(ИзменениеДисконтаПремии, 2) + ОценочнаяСуммаКупона + ЛинейныеПроценты * Количество);
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		РасчетКорректировкиЭСП = Новый Структура;
		
		РасчетКорректировкиЭСП.Вставить("СчитаемДоПогашения", СчитаемДоПогашения);
		РасчетКорректировкиЭСП.Вставить("ЭСП", ЭСП);
		РасчетКорректировкиЭСП.Вставить("ВидЭСП", ?(РешениеКлиентаПоЭСП = Неопределено, "Расчетная", "От клиента"));
		РасчетКорректировкиЭСП.Вставить("НачальнаяСтоимость", НачальнаяСтоимость);
		РасчетКорректировкиЭСП.Вставить("ЛинейныеПроценты", ЛинейныеПроценты);
		РасчетКорректировкиЭСП.Вставить("ПроцентыПоЭСП", ПроцентыПоЭСП);
		РасчетКорректировкиЭСП.Вставить("ПроцентыПоЭСПНаПакет", ПроцентыПоЭСПНаПакет);
		РасчетКорректировкиЭСП.Вставить("ИзменениеДисконтаПремии", ИзменениеДисконтаПремии);
		РасчетКорректировкиЭСП.Вставить("ОценочнаяСуммаКупона", ОценочнаяСуммаКупона);
		РасчетКорректировкиЭСП.Вставить("ОценочнаяСуммаКупонаНа1шт", Окр(ОценочнаяСуммаКупона / Количество, 4));
		РасчетКорректировкиЭСП.Вставить("ОценочнаяКорректировкаЭСП", ОценочнаяКорректировкаЭСП);
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаРасчета, "РасчетКорректировкиЭСП", РасчетКорректировкиЭСП, "РасчетКорректировкиЭСП", Ложь, Истина);
		
	КонецЕсли;
	
	Возврат Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП", ОценочнаяКорректировкаЭСП, ЭСП, СтоимостьПоЭСП);

КонецФункции

// Считаем жуткие показатели по ЭСП
//
// Параметры:
//  Облигация															- Справочник.Облигации			- облигация по которой считаем
//	ДанныеПереоценки													- Любая коллекция с именованными реквизитами
//		ДатаПереоценки													- Дата							- для СЧА и переоценки нужно передавать конец дня, для остальных - дату и время расчета
//  	Количество														- Число							- количество облигаций
//  	ОценочнаяСуммаКупона											- Число							- стоимость купона на расчетную дату
//  	БалансовыйДисконт												- Число							- начисленный дисконт/премия на расчетную дату
//  	БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные	- Число							- начисленная корректировка ПП на расчетную дату
//  	УчетныйАктивЕПС													- Справочник.УчетныеАктивыЕПС	- на каком активе облигация на расчетную дату
//		Партия															- ДокументСсылка				- по некоторым видам документов проверяем отклонение от рыночной, по другим - нет
//	ДанныеПокупки   													- Любая коллекция с именованными реквизитами
//  	НачальныйДисконт												- Число							- дисконт/премия при покупке
//  	НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные		- Число							- корректировка ПП при покупке
//  	ДатаПокупки														- Дата							- дата покупки
//  	ЦенаПокупки														- Число							- цена покупки
//  	ЦенаПокупкиКупона												- Число							- цена покупки купона
//  НастройкиУчета														- Структура						- НастройкиУчетаОбщие
//  РасшифровкаРасчета													- Структура						- возвращаемый параметр для вывода на печать
//
// Возвращаемое значение:
//   Структура							- Содержит два ключа ОценочныеДисконтПремия и ОценочнаяКорректировкаЭСП
//
Функция РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(Облигация, ДанныеПереоценки, ДанныеПокупки, НастройкиУчета, Отказ, РасшифровкаРасчета = Неопределено) Экспорт
	
	ДатаПереоценки													= ДанныеПереоценки.ДатаПереоценки;
	Количество														= ДанныеПереоценки.Количество;
	ОценочнаяСуммаКупона											= ДанныеПереоценки.ОценочнаяСуммаКупона;
	БалансовыйДисконт												= ДанныеПереоценки.БалансовыйДисконт; 
	БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные	= ДанныеПереоценки.БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные; 
	УчетныйАктивЕПС													= ДанныеПереоценки.УчетныйАктивЕПС; 
	Партия															= ДанныеПереоценки.Партия;
	СтрокаПартии													= ДанныеПереоценки.СтрокаПартии;
	СчетДоверительногоУправления									= ДанныеПереоценки.СчетДоверительногоУправления;
	
	НачальныйДисконт												= ДанныеПокупки.НачальныйДисконт; 
	НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные		= ДанныеПокупки.НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные; 
	ДатаПокупки														= ДанныеПокупки.ДатаПокупки; 
	ДатаПокупкиНачальная											= ДанныеПокупки.ДатаПокупкиНачальная;
	КорректировкаЭСПНачальная										= ДанныеПокупки.КорректировкаЭСПНачальная;
	ЦенаПокупки														= ДанныеПокупки.ЦенаПокупки; 
	ЦенаПокупкиКупона												= ДанныеПокупки.ЦенаПокупкиКупона; 
	ЦенаПокупкиНачальная											= ДанныеПокупки.ЦенаПокупкиНачальная; 
	
	Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	// Проверка входящих параметров
	Если ТипЗнч(Облигация) <> Тип("СправочникСсылка.Облигации") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчет процентных показателей возможен только по облигациям!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
			
	Если ТипЗнч(НачальныйДисконт) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан начальный дисконт!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(БалансовыйДисконт) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан балансовый дисконт!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана начальная разница первоначального признания!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана балансовая разница первоначального признания!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДатаПереоценки) <> Тип("Дата") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата переоценки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДатаПокупки) <> Тип("Дата") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата покупки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Количество) <> Тип("Число") ИЛИ Количество = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указано количество ценных бумаг!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ТребуетсяЦенаПокупки = (Облигация.Амортизационная 
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке 
		ИЛИ НастройкиУчета.ВариантУчетаДисконтаПремии = Перечисления.ВариантыУчетаПроцентныхДоходов.ВЗависимостиОтКритерияСущественности);	
			
	Если ТребуетсяЦенаПокупки И (ТипЗнч(ЦенаПокупки) <> Тип("Число") ИЛИ ЦенаПокупки = 0) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана цена покупки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
			
	Если ТребуетсяЦенаПокупки И ТипЗнч(ЦенаПокупкиКупона) <> Тип("Число") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана цена покупки!",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	
	Если РасшифровкаРасчета <> Неопределено Тогда
	
		РасшифровкаВходныеДанные = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Исходные данные", , , Истина);	
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаВходныеДанные, "Облигация", Новый Структура("Облигация, Амортизационная", Облигация, Облигация.Амортизационная), "Данные облигации");
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаВходныеДанные, "ДанныеПереоценки", ДанныеПереоценки, "Данные переоценки");
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаВходныеДанные, "ДанныеПокупки", ДанныеПокупки, "Данные покупки");
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(РасшифровкаВходныеДанные, "НастройкиУчета", НастройкиУчета, "Настройки учета", Истина, Истина);
		
		
		РасшифровкаРазницыПервоначальногоПризнания = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет разницы первоначального признания", , , Истина);
		РасшифровкаДисконтаПремии = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет дисконта/премии", , , Истина);
		РасшифровкаКорректировкиЭСП = РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, "Расчет корректировки ЭСП", , , Истина);
		
	КонецЕсли;
	
	
	//разница первоначального признания. как будто премия
	ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0;
	ИзменениеРазницыПервоначальногоПризнанияНеНаблюдаемыеДанные = 0;
	
	ЗнакНачальнойРазницыПервоначальногоПризнания = ?(НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные > 0, 1, -1);
	
	НачальнаяРазницаПервоначальногоПризнанияПлюс 	= НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * ЗнакНачальнойРазницыПервоначальногоПризнания;
	БалансоваяРазницаПервоначальногоПризнанияПлюс	= БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * ЗнакНачальнойРазницыПервоначальногоПризнания;
	
	ДатаНачалаРасчетаРазницыПП = ДатаПокупки;
	
	НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
		НастройкиУчета,
		Облигация,
		УчетныйАктивЕПС,
		Партия,
		СтрокаПартии);
	
	Если Не НастройкиУчетаЦеннойБумаги.ПравильныйУчетПервоначальногоПризнания 
		ИЛИ (Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финконсалт") И СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN118")) Тогда
	 	// теперь такая хрень только для БУДУЩЕЕ ПН, которое пока по-старому
		// плясать надо не от начальной, а от балансовой. пишу это потому, что не уверен до конца, но будущее утверждает так
		// #ОбъединениеБудущего. Финконсалта больше нет.	
		НачальнаяРазницаПервоначальногоПризнанияПлюс = БалансоваяРазницаПервоначальногоПризнанияПлюс / Количество;
		
		НачалоРасчета = НачалоКвартала(ДатаПереоценки);
		Если ДатаПереоценки >= '20210101' Тогда // с 01.01.2021 будущее перешли на ежемесячный расчет корректировки ПП
			НачалоРасчета = НачалоМесяца(ДатаПереоценки);
		КонецЕсли;
		
		Если ДатаНачалаРасчетаРазницыПП < НачалоРасчета Тогда
			ДатаНачалаРасчетаРазницыПП = НачалоДня(НачалоРасчета - 1); // считаем с конца прошлого отчетного периода (месяца или квартала)
		КонецЕсли;
		
	КонецЕсли;
	
	НеРасчитыватьРазностьПП = ОтключенаОценкаРазницыПервоначальногоПризнания(НастройкиУчетаЦеннойБумаги, Партия, СтрокаПартии, Облигация, УчетныйАктивЕПС, ДатаПереоценки);
	
	Если НеРасчитыватьРазностьПП ИЛИ НачальнаяРазницаПервоначальногоПризнанияПлюс = 0 Тогда
		ДанныеРасчетаРазницыПервоначальногоПризнания = Новый Структура("ОценочныеДисконтПремия, ИзменениеДисконтаПремии", БалансоваяРазницаПервоначальногоПризнанияПлюс, 0);
	Иначе
		ДанныеПокупки.НачальныйДисконт = НачальнаяРазницаПервоначальногоПризнанияПлюс;
		ДанныеПокупки.ДатаПокупки = ДатаНачалаРасчетаРазницыПП;
		ДанныеРасчетаРазницыПервоначальногоПризнания = РассчитатьАмортизациюДисконтаПремии(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, Отказ,  РасшифровкаРазницыПервоначальногоПризнания);
		Если ДанныеРасчетаРазницыПервоначальногоПризнания = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия > БалансоваяРазницаПервоначальногоПризнанияПлюс Тогда
	
		ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия = БалансоваяРазницаПервоначальногоПризнанияПлюс;
		ДанныеРасчетаРазницыПервоначальногоПризнания.ИзменениеДисконтаПремии =  БалансоваяРазницаПервоначальногоПризнанияПлюс - НачальнаяРазницаПервоначальногоПризнанияПлюс * Количество;
		
		ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия * ЗнакНачальнойРазницыПервоначальногоПризнания;
		ИзменениеРазницыПервоначальногоПризнанияНеНаблюдаемыеДанные = ДанныеРасчетаРазницыПервоначальногоПризнания.ИзменениеДисконтаПремии * ЗнакНачальнойРазницыПервоначальногоПризнания;
	
	КонецЕсли;
	
	ОценочнаяРазницаПервоначальногоПризнания = ДанныеРасчетаРазницыПервоначальногоПризнания.ОценочныеДисконтПремия * ЗнакНачальнойРазницыПервоначальногоПризнания;
	
	// #ТехническийДолг
	//
	// Проблема: бумаги были заведены вводом из другой УК, где их считали "до оферты"
	// причем ППА у нас всегда считает "до погашения"
	// было оф. письмо с просьбой именно эти бумаги считать "до оферты"
	// сделал хардкод т.к. они вот-вот погясятся (оферта обязательная) и лепить настройки не вижу смысла
	//
	Если СокрЛП(СчетДоверительногоУправления.КодСчета) = "DU_NPF232" Тогда // НПФ Первый промышленный альянс ПН АО
		Если СокрЛП(Облигация.ГосударственныйРегистрационныйНомер) = "4B02-01-32432-H" // ГТЛК ПАО, 4B02-01-32432-H, 1000.00 RUB
			ИЛИ СокрЛП(Облигация.ГосударственныйРегистрационныйНомер) = "4B02-02-32432-H" Тогда // ГТЛК ПАО, 4B02-02-32432-H, 1000.00 RUB 
			
			НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты;
			
		Иначе
			
			НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения;
			
		КонецЕсли;
	ИначеЕсли СокрЛП(СчетДоверительногоУправления.КодСчета) = "DU_NPF276" Тогда // НПФ Первый промышленный альянс
		Если СокрЛП(Облигация) = "ФПК, 4-01-55465-E, 1000.00 RUB" И НачалоДня(ДатаПереоценки) = '20190613' Тогда 
		
			НастройкиУчета.РассчитыватьДисконтПремиюДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты;
		
		КонецЕсли;
	КонецЕсли;
	// #ТехническийДолг
	
	ДанныеПокупки.НачальныйДисконт = НачальныйДисконт;
	Если НастройкиУчета.РассчитыватьДисконтПремиюОтДатыРеклассификации Тогда
		ДанныеПокупки.ДатаПокупки = ДатаПокупки;
		ДанныеПокупки.ЦенаПокупки = ЦенаПокупки;
	Иначе
		ДанныеПокупки.ДатаПокупки = ДатаПокупкиНачальная;
		ДанныеПокупки.ЦенаПокупки = ЦенаПокупкиНачальная;
	КонецЕсли;
	ДанныеРасчетаДисконтаПремии = РассчитатьАмортизациюДисконтаПремии(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, Отказ, РасшифровкаДисконтаПремии);
	
	ДанныеПокупки.ДатаПокупки = ДатаПокупки;
	ДанныеПокупки.ЦенаПокупки = ЦенаПокупки;
	
	Если ДанныеРасчетаДисконтаПремии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПогашенияПройдена = (НачалоДня(ДанныеРасчетаДисконтаПремии.ДатаПогашения) < НачалоДня(ДатаПереоценки));
			
	Если НачальныйДисконт > 0 Тогда
		
		Если Окр(ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия, 2) > БалансовыйДисконт            // недосписали премии
			ИЛИ ДатаПогашенияПройдена Тогда
			
			ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия = БалансовыйДисконт;
			ДанныеРасчетаДисконтаПремии.ИзменениеДисконтаПремии = БалансовыйДисконт - НачальныйДисконт * Количество;
			
		КонецЕсли;
		
	ИначеЕсли НачальныйДисконт < 0 Тогда
		
		Если (Окр(ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия, 2) < БалансовыйДисконт            // недоначислили дисконта
			ИЛИ ДатаПогашенияПройдена) И
			Не (СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ГСК_ЮГОРИЯ") 
				И ДатаПереоценки = НачалоДня(ДанныеРасчетаДисконтаПремии.ДатаПогашения) 
				И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТрансНефть_0081"))
			// Югория передала эту облигацию с кривым дисконтом. Анна сказала что править ввод нельзя, в день погашения добивать до номинала.
			Тогда
			
			ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия = БалансовыйДисконт;
			ДанныеРасчетаДисконтаПремии.ИзменениеДисконтаПремии = БалансовыйДисконт;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// для реклассифицированных амортизационных бумаг может вылезти погрешность раздельной амортизации изменения дисконта/премии и корректировки  
	ПогрешностьРаздельнойАмортизации = 0;
	Если ТипЗнч(Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС") Тогда
	
		// у нас есть расчет 2х показателей: ОценочныеДисконтПремия и ИзменениеДисконтаПремии
		// связь этих показателей можно записать формулой ОценочныеДисконтПремия = НачальныйДисконтПремия + ИзменениеДисконтаПремии
		// оба этих показателя (ОценочныеДисконтПремия и ИзменениеДисконтаПремии) считаются линейно с даты покупки (и реклассификация ничего не меняет)
		// показатель ИзменениеДисконтаПремии используется при расчете корректировки ЭСП
		// но вот в чем фишка для реклассифицированных бумаг - для расчета корректировки ЭСП они не должны использовать ИзменениеДисконтаПремии с даты покупки
		// им нужно ИзменениеДисконтаПремии только с даты реклассификации!
		// поэтому мы делаем еще 1 расчет на ДатаПокупки (в ней лежит дата рекласса)
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(РеклассификацияАктивовЕПСПартии.ДисконтПремияНачисленный / РеклассификацияАктивовЕПСПартии.Количество * &Количество КАК ЧИСЛО(21, 2)) КАК ДисконтПремияНачисленный,
			|	ВЫРАЗИТЬ(РеклассификацияАктивовЕПСПартии.ДисконтПремия / РеклассификацияАктивовЕПСПартии.Количество * &Количество КАК ЧИСЛО(21, 2)) КАК ДисконтПремия
			|ИЗ
			|	Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
			|ГДЕ
			|	РеклассификацияАктивовЕПСПартии.Ссылка = &Партия
			|	И РеклассификацияАктивовЕПСПартии.НомерСтроки = &СтрокаПартии";
		
		Запрос.УстановитьПараметр("СтрокаПартии", СтрокаПартии);
		Запрос.УстановитьПараметр("Партия", Партия);
		Запрос.УстановитьПараметр("Количество", Количество);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если НастройкиУчета.СтоимостьТелаРавнаНоминалу Тогда // УГМК - они не такие как все
				ДисконтПремияВНачальнойСтоимости = ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный;
			Иначе
				ДисконтПремияВНачальнойСтоимости = ПолучитьСтоимостьСУчетомАмортизацииНоминала(ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный, Облигация, ДатаПокупки, ДатаПереоценки);
			КонецЕсли;
			
			Если НачальныйДисконт <= 0 И ДатаПереоценки >= '20230101' И ДатаПокупки < '20230101'
				И (Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ДатаПереоценки)
					= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_УГМК")) // УГМК перенесли дисконт в тело, поэтому для них изменение еще меньше
			Тогда
				ДисконтПремияВНачальнойСтоимости = ДисконтПремияВНачальнойСтоимости - ВыборкаДетальныеЗаписи.ДисконтПремия;
			КонецЕсли;
			
			ПогрешностьРаздельнойАмортизации = Окр(ДисконтПремияВНачальнойСтоимости, 2) - ДисконтПремияВНачальнойСтоимости;
			ДанныеРасчетаДисконтаПремии.ИзменениеДисконтаПремии = ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия - Окр(ДисконтПремияВНачальнойСтоимости, 2);
		
		КонецЕсли;
	
	КонецЕсли;		
	
	ОценочныеДисконтПремия = ДанныеРасчетаДисконтаПремии.ОценочныеДисконтПремия;
	ИзменениеДисконтаПремии = ДанныеРасчетаДисконтаПремии.ИзменениеДисконтаПремии;
	ПогашенияДисконтов = ДанныеРасчетаДисконтаПремии.ПогашенияДисконтов;
	
	Если НастройкиУчета.РассчитыватьДисконтПремиюОтДатыРеклассификации Тогда
		ПереоценкаВДеньПокупки = (НачалоДня(ДатаПокупки) = НачалоДня(ДатаПереоценки));
	Иначе
		ПереоценкаВДеньПокупки = (НачалоДня(ДатаПокупкиНачальная) = НачалоДня(ДатаПереоценки));
	КонецЕсли;
	
	ДатаПогашенияПройдена = (НачалоДня(ДанныеРасчетаДисконтаПремии.ДатаПогашения) <= ДатаПереоценки);
	
	Если ДатаПогашенияПройдена ИЛИ ПереоценкаВДеньПокупки Тогда
		
		Если ПереоценкаВДеньПокупки И РасшифровкаРасчета <> Неопределено Тогда // в день покупки делаем расчет если нужна визуализация
			ДанныеРасчета = РассчитатьКорректировкуПоЭСП(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, ДанныеРасчетаДисконтаПремии, Биржа, Отказ, РасшифровкаКорректировкиЭСП);
		КонецЕсли;
		
		ОценочнаяКорректировкаЭСП	= 0;
		ЭСПКорректировка			= 0;
		Если ДатаПогашенияПройдена Тогда
			СтоимостьПоЭСП			= ДанныеРасчетаДисконтаПремии.Номинал + Окр(ОценочнаяСуммаКупона / Количество, 2);
		Иначе
		    СтоимостьПоЭСП			= ЦенаПокупки;
		КонецЕсли;
		
		// если погашаем бумагу по АС, которая был приобретена с корректировкой ПП
		Если ДатаПогашенияПройдена И ДанныеПокупки.НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0 Тогда
			// И по этой бумаге у нас 'Правильный учет' (на языке закона это 'наличие наблюдаемых данных при ПП')
			// то КорректировкаЭСП должна стать равной КорректировкеПП с обратным знаком, что бы их сумма стала равна 0 и мы вышли на номинал
			
			// старый хардкод, облигация Роснефти покупалась очень давно
			ПриравнятьЭСПкППсОбратнымЗнаком = (Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_Роснфт2P7")
												И (ДатаПереоценки = '20240329235959' ИЛИ ДатаПереоценки = '20240403235959'));
												
			// у Национального 15.11.2024 было погашение бумаги с ПП
			ПриравнятьЭСПкППсОбратнымЗнаком = ПриравнятьЭСПкППсОбратнымЗнаком
				ИЛИ	(СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_NPF375"));
			
			// а с 01.11.25 все бумаги идут по этой схеме
			ПриравнятьЭСПкППсОбратнымЗнаком = ПриравнятьЭСПкППсОбратнымЗнаком
				ИЛИ (НастройкиУчета.ПравильныйУчетПервоначальногоПризнания И ДатаПереоценки >= '20251101');
				
			Если ПриравнятьЭСПкППсОбратнымЗнаком Тогда
				ОценочнаяКорректировкаЭСП = - ДанныеПокупки.НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные * Количество;	
			КонецЕсли;
		
		КонецЕсли;
		
	Иначе
		ДанныеРасчета = РассчитатьКорректировкуПоЭСП(Облигация, НастройкиУчета, ДанныеПереоценки, ДанныеПокупки, ДанныеРасчетаДисконтаПремии, Биржа, Отказ, РасшифровкаКорректировкиЭСП);
		
		ОценочнаяКорректировкаЭСП	= ДанныеРасчета.ОценочнаяКорректировкаЭСП;
		ЭСПКорректировка			= ДанныеРасчета.ЭСПКорректировка;
		СтоимостьПоЭСП				= ДанныеРасчета.СтоимостьПоЭСП;
				
		Если ТипЗнч(Партия) = Тип("ДокументСсылка.РеклассификацияАктивовЕПС")
			И НЕ НастройкиУчета.РасчетКорректировкиЭСПМетодомОтНСД Тогда
			
			Если НастройкиУчета.СтоимостьТелаРавнаНоминалу Тогда // УГМК - они не такие как все
				КорректировкаВНачальнойСтоимости = КорректировкаЭСПНачальная;
			Иначе
				КорректировкаВНачальнойСтоимости = ПолучитьСтоимостьСУчетомАмортизацииНоминала(КорректировкаЭСПНачальная, Облигация, ДатаПокупки, ДатаПереоценки);
			КонецЕсли;
			
			ОценочнаяКорректировкаЭСП = ОценочнаяКорректировкаЭСП + КорректировкаВНачальнойСтоимости - ПогрешностьРаздельнойАмортизации;
		КонецЕсли;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(
			РасшифровкаВходныеДанные, 
			"ДополнительныеДанные", 
			Новый Структура("ДатаПогашенияПройдена, ПереоценкаВДеньПокупки, НеРасчитыватьРазностьПП", ДатаПогашенияПройдена, ПереоценкаВДеньПокупки, НеРасчитыватьРазностьПП),
			"Дополнительные данные");
		
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(
			РасшифровкаРазницыПервоначальногоПризнания,
			"РезультатРасчета",
			Новый Структура("ОценочнаяРазницаПП, ИзменениеРазницыПП", ОценочнаяРазницаПервоначальногоПризнания, ИзменениеРазницыПервоначальногоПризнанияНеНаблюдаемыеДанные),
			"Результат расчета первоначального признания");
			
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(
			РасшифровкаДисконтаПремии,
			"РезультатРасчета",
			Новый Структура("ОценочныеДисконтПремия, ИзменениеДисконтаПремии, ПогашенияДисконтов", ОценочныеДисконтПремия, ИзменениеДисконтаПремии, ПогашенияДисконтов),
			"Результат расчета дисконта/премии");
			
		Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_RT_PN084") И Облигация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002") Тогда
			ЦенаПП = - ОценочнаяРазницаПервоначальногоПризнания / Количество;
		Иначе
			ЦенаПП = ОценочнаяРазницаПервоначальногоПризнания / Количество;
		КонецЕсли;
			
		РаботаСДокументами.ДобавитьРасшифровкуРезультатаОперации(
			РасшифровкаКорректировкиЭСП,
			"РезультатРасчета",
			Новый Структура("ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП, СтоимостьПоЭСПБезНКД, СтоимостьПоЭСПсУчетомКорректировкиПП", 
				ОценочнаяКорректировкаЭСП, ЭСПКорректировка, СтоимостьПоЭСП, СтоимостьПоЭСП - Окр(ОценочнаяСуммаКупона / Количество, 4), СтоимостьПоЭСП + ЦенаПП),
			"Результат расчета корректировки ЭСП");
			
	КонецЕсли;
	
	РезультатыРасчета = Новый Структура;
	РезультатыРасчета.Вставить("ОценочныеДисконтПремия",										Окр(ОценочныеДисконтПремия, 2));
	РезультатыРасчета.Вставить("ОценочнаяКорректировкаЭСП",										Окр(ОценочнаяКорректировкаЭСП, 2));
	РезультатыРасчета.Вставить("ОценочнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные",	Окр(ОценочнаяРазницаПервоначальногоПризнания, 2));
	
	РезультатыРасчета.Вставить("СтоимостьПоЭСП",												СтоимостьПоЭСП);
	РезультатыРасчета.Вставить("ЭСПКорректировка",												ЭСПКорректировка);
	
	Возврат РезультатыРасчета;

КонецФункции

Функция ПолучитьДатыИЦеныПокупки(ЦенныеБумаги, СчетДоверительногоУправления, ДатаПереоценки, ВключатьКомиссиюВСтоимость = Неопределено, РассчитанныеНастройкиДляПартии = Неопределено) Экспорт

	#Область Текст_запроса	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравильныеПремииНачальные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПравильныеПремииНачальные.Партия КАК Партия,
		|	ПравильныеПремииНачальные.СтрокаПартии КАК СтрокаПартии,
		|	ПравильныеПремииНачальные.НачальныйДисконт КАК НачальныйДисконт
		|ПОМЕСТИТЬ ПравильныеПремииНачальные
		|ИЗ
		|	&ПравильныеПремииНачальные КАК ПравильныеПремииНачальные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.НомерСтроки КАК НомерСтроки,
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Партия КАК Партия,
		|	ЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	ЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ЦенныеБумаги.Количество КАК Количество
		|ПОМЕСТИТЬ ПереоценкаЦенныхБумагЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|ГДЕ
		|	ЦенныеБумаги.Количество > 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ОблигацииПДпоАС
		|ИЗ
		|	ПереоценкаЦенныхБумагЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага = Облигации.Ссылка
		|			И (Облигации.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыОблигаций.КупоннаяПД))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|		ПО ПереоценкаЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС = УчетныеАктивыЕПС.Ссылка
		|			И (УчетныеАктивыЕПС.ВключатьРасходыПоПокупкеВСтоимость)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОблигацииПДпоАС.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ОблигацииПоКоторымМожноИНужноКэшироватьДенежныйПоток
		|ИЗ
		|	_ОблигацииПДпоАС КАК _ОблигацииПДпоАС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО _ОблигацииПДпоАС.ЦеннаяБумага = УсловияОферт.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
		|		ПО _ОблигацииПДпоАС.ЦеннаяБумага = ЗначенияНастроекУчетаЦенныхБумаг.ЦеннаяБумага
		|			И (ЗначенияНастроекУчетаЦенныхБумаг.Организация = &Организация)
		|			И (ЗначенияНастроекУчетаЦенныхБумаг.Клиент = &Клиент)
		|			И (ЗначенияНастроекУчетаЦенныхБумаг.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ДенежныйПотокПоОблигации))
		|ГДЕ
		|	УсловияОферт.Облигация ЕСТЬ NULL
		|	И ЗначенияНастроекУчетаЦенныхБумаг.ЦеннаяБумага ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумаг.Ссылка КАК Ссылка,
		|	ВводЦенныхБумагЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ВводЦенныхБумагЦенныеБумаги.Сумма КАК Сумма,
		|	ВводЦенныхБумагЦенныеБумаги.Количество КАК Количество,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаПокупки КАК СуммаПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.ДисконтПремия КАК ДисконтПремия,
		|	ВводЦенныхБумаг.Дата КАК Дата,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаПокупкиКупона КАК СуммаПокупкиКупона,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок КАК СуммаКупонаРынок,
		|	ВводЦенныхБумагЦенныеБумаги.ДатаПокупки КАК ДатаПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.ДатаРеклассификации КАК ДатаРеклассификации,
		|	ВводЦенныхБумагЦенныеБумаги.ДисконтПремияПокупки КАК ДисконтПремияПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.КорректировкаЭСППриРеклассификации КАК КорректировкаЭСППриРеклассификации,
		|	ВводЦенныхБумагЦенныеБумаги.ЦенаРеклассификации КАК ЦенаРеклассификации
		|ПОМЕСТИТЬ _ВВодыЦенныхБумаг
		|ИЗ
		|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ВводЦенныхБумаг.Ссылка = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|ГДЕ
		|	ВводЦенныхБумаг.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ПереоценкаЦенныхБумагЦенныеБумаги.Партия
		|			ИЗ
		|				ПереоценкаЦенныхБумагЦенныеБумаги
		|			ГДЕ
		|				ТИПЗНАЧЕНИЯ(ПереоценкаЦенныхБумагЦенныеБумаги.Партия) = ТИП(Документ.ВводЦенныхБумаг))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВводЦенныхБумаг.Ссылка,
		|	ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеклассификацияАктивовЕПС.Ссылка КАК Ссылка,
		|	РеклассификацияАктивовЕПС.Дата КАК Дата,
		|	РеклассификацияАктивовЕПСПартии.НомерСтроки КАК НомерСтроки,
		|	РеклассификацияАктивовЕПСПартии.КорректировкаЭСП КАК КорректировкаЭСП,
		|	РеклассификацияАктивовЕПСПартии.Количество КАК Количество,
		|	РеклассификацияАктивовЕПСПартии.СуммаПокупки КАК СуммаПокупки,
		|	РеклассификацияАктивовЕПСПартии.ДатаПокупки КАК ДатаПокупки,
		|	РеклассификацияАктивовЕПСПартии.Стоимость КАК Стоимость,
		|	РеклассификацияАктивовЕПСПартии.Переоценка КАК Переоценка,
		|	РеклассификацияАктивовЕПСПартии.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	РеклассификацияАктивовЕПСПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	РеклассификацияАктивовЕПСПартии.СтоимостьКупона КАК СтоимостьКупона,
		|	РеклассификацияАктивовЕПСПартии.ПереоценкаКупона КАК ПереоценкаКупона,
		|	РеклассификацияАктивовЕПСПартии.ДисконтПремияПокупки КАК ДисконтПремияПокупки
		|ПОМЕСТИТЬ _РеклассификацииАктивовЕПС
		|ИЗ
		|	Документ.РеклассификацияАктивовЕПС КАК РеклассификацияАктивовЕПС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО РеклассификацияАктивовЕПС.Ссылка = РеклассификацияАктивовЕПСПартии.Ссылка
		|ГДЕ
		|	РеклассификацияАктивовЕПС.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ПереоценкаЦенныхБумагЦенныеБумаги.Партия
		|			ИЗ
		|				ПереоценкаЦенныхБумагЦенныеБумаги
		|			ГДЕ
		|				ТИПЗНАЧЕНИЯ(ПереоценкаЦенныхБумагЦенныеБумаги.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	РеклассификацияАктивовЕПС.Ссылка,
		|	РеклассификацияАктивовЕПСПартии.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Ссылка КАК Ссылка,
		|	СделкаРЕПО.Дата КАК Дата,
		|	СделкаРЕПОЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	СделкаРЕПОЦенныеБумаги.Цена КАК Цена,
		|	СделкаРЕПОЦенныеБумаги.ЦенаКупона КАК ЦенаКупона
		|ПОМЕСТИТЬ _СделкиРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|		ПО СделкаРЕПО.Ссылка = СделкаРЕПОЦенныеБумаги.Ссылка
		|ГДЕ
		|	СделкаРЕПО.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ПереоценкаЦенныхБумагЦенныеБумаги.Партия
		|			ИЗ
		|				ПереоценкаЦенныхБумагЦенныеБумаги
		|			ГДЕ
		|				ТИПЗНАЧЕНИЯ(ПереоценкаЦенныхБумагЦенныеБумаги.Партия) = ТИП(Документ.СделкаРЕПО))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПОЦенныеБумаги.СтрокаПартии
		|;
