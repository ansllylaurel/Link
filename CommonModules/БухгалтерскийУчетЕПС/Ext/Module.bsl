КонецФункции

// В группу БУДУЩЕЕ входят следующие фонды:
// 	АО МНПФ БОЛЬШОЙ
// 	НПФ БУДУЩЕЕ АО
// 	НПФ Достойное БУДУЩЕЕ АО
// 	НПФ ОПФ
// 	НПФ Телеком-Союз АО
// 	НПФ ФЕДЕРАЦИЯ АО
// 	НПФ Эволюция АО
// 	ПЕРСПЕКТИВА НПФ АО
//
// Параметры:
//	Клиент	- СправочникСсылка.СчетаДоверительногоУправления - счет д/у 
//			- СправочникСсылка.ЮрФизЛица					 - юр./физ.лицо клиента
//	Дата	- Дата, Неопределено							 - дата, на которую определеятся клиент, связанный со счетом д/у
//
// Возвращаемое значение:
//	ЭтоКлиентГруппыБудущее - Булево - Истина, если это так
//
Функция ЭтоКлиентГруппыБудущее(Клиент, Дата = Неопределено) Экспорт

	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Клиент, Дата);
	Иначе
		КлиентДоверительногоУправления = Клиент;
	КонецЕсли;
	
	КлиентыГруппы = Кэширование.КлиентыГруппыБудущее();
	
	Возврат КлиентыГруппы.Найти(КлиентДоверительногоУправления) <> Неопределено;

КонецФункции

Функция ОтключенаОценкаРазницыПервоначальногоПризнания(НастройкиУчета, Партия, СтрокаПартии, Облигация, УчетныйАктивЕПС, ДатаПереоценки) Экспорт
	
	ОтключенаОценкаРазницыПП = Истина;
	
	// Есть вызовы когда в НастройкиУчета передаются НастройкиУчетаОбщие а нам нужно ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги.
	НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
		НастройкиУчета,
		Облигация,
		УчетныйАктивЕПС,
		Партия,
		СтрокаПартии);
	
	Если НастройкиУчетаЦеннойБумаги.ПартииСОценкойРазницыПервоначальногоПризнания Тогда
		ОтключенаОценкаРазницыПП = Ложь;	
	ИначеЕсли НастройкиУчетаЦеннойБумаги.ПартииСОценкойРазницыПервоначальногоПризнанияВДатуПогашенияКупона Тогда
	    // нужно проверить - не день ли погашения купонного дохода
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупона
			|ИЗ
			|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
			|ГДЕ
			|	КупонныйДоходПоОблигациям.Облигация = &Облигация
			|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &ДатаОкончанияКупона";
		
		Запрос.УстановитьПараметр("ДатаОкончанияКупона", НачалоДня(ДатаПереоценки));
		Запрос.УстановитьПараметр("Облигация", Облигация);
		
		Если Не Запрос.Выполнить().Пустой() Тогда
			ОтключенаОценкаРазницыПП = Истина;
		Иначе
			ОтключенаОценкаРазницыПП = Ложь;
		КонецЕсли;
	КонецЕсли;	

	Возврат ОтключенаОценкаРазницыПП;
	
КонецФункции

Функция ПереопределениеНачальногоДисконта(НачальныйДисконт, Облигация, Количество, ДатаПереоценки, ДатаПокупки, ОпределенияКлиентов)

	Если ДатаПереоценки >= '20210412' И ОпределенияКлиентов.ЭтоКлиентСАФМАР И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Пересвет") Тогда
			
		// приходится делать так из-за точности
		_НачальныйДисконт = (1 - Количество * 329) / Количество; // все пересветы были куплены за 1руб (независимо от партии), 329 это номинал пересвета
		Если Количество = 2019320 Тогда // Сафмар посчитал эту партию так и переделывать не будет, а я не знаю как её идентифицировать, кроме как через количество
		    _НачальныйДисконт = 0.000000495213513782534908839 - 329; 
		КонецЕсли;

	ИначеЕсли ДатаПереоценки >= ДатаНачалаОбъединенияПортфелейГруппыБудущее() И ОпределенияКлиентов.ЭтоКлиентБудущее И Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Пересвет")  Тогда
		
		// По этой бумаге Пересвета всего 5 партий. 1 - Это "старое Будущее", остальные бывший Сафмар, которые в Будущее переезжают т.е. это "новое Будущее".
		// Будем дейстровать от противного. Отделим единственную партию "старое Будущее", всё что не она - это понаехалы.
		// Партия увы до этой функции уже не прокидывается. По-этому отделяем по кол-ву, иначе тут уже никак. Старое Будущее это 13 499 815,0000000
		Если Количество <> 13499815 Тогда
			// приходится делать так из-за точности
			_НачальныйДисконт = (1 - Количество * 329) / Количество; // все пересветы были куплены за 1руб (независимо от партии), 329 это номинал пересвета
			Если Количество = 2019320 Тогда // Сафмар посчитал эту партию так и переделывать не будет, а я не знаю как её идентифицировать, кроме как через количество
				_НачальныйДисконт = 0.000000495213513782534908839 - 329; 
			КонецЕсли;
			
		Иначе
			
			_НачальныйДисконт = НачальныйДисконт;
			
		КонецЕсли;	
		
	ИначеЕсли ОпределенияКлиентов.ЭтоКлиентЮгория
		И ДатаПокупки < '20210101'
		И ДатаПереоценки < '20251011' Тогда // #394630 - 9.10.25 погасилась, а 10.10.25 оплатилась последняя из этих кривых бумаг
	
		БумагиСОкругленнойЦенойПриобретения = Новый Массив;
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОФЗ_26212RMFS"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОФЗ_46020RMFS"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГПНефть_003003Р"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Газпром_023"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РосНефть_002001"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РосНефть_009"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТрансНефть_0051"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ТрансНефть_0081"));
		БумагиСОкругленнойЦенойПриобретения.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ГТЛК_09"));
		
		Если БумагиСОкругленнойЦенойПриобретения.Найти(Облигация) <> Неопределено Тогда
		
			Если НачальныйДисконт > 0 Тогда
				_НачальныйДисконт = Окр(НачальныйДисконт, 2);
			ИначеЕсли НачальныйДисконт < 0 Тогда
				_НачальныйДисконт = Окр(НачальныйДисконт, 2, РежимОкругления.Окр15как10);
			КонецЕсли;
			
		Иначе
			
			_НачальныйДисконт = НачальныйДисконт;
			
		КонецЕсли;
		
	Иначе
		
		_НачальныйДисконт = НачальныйДисконт;
		
	КонецЕсли;
	
	Возврат _НачальныйДисконт;

КонецФункции 

Функция ПолучитьОблигацииСРеструктуризациейПлатежей(Дата) Экспорт

	ТаблицаЦенныхБумаг = Новый ТаблицаЗначений;
	
	ТаблицаЦенныхБумаг.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("Эмитент", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	
	Если Дата >= '20171113' Тогда
	
		СтрокаРеструктуризации = ТаблицаЦенныхБумаг.Добавить();
		СтрокаРеструктуризации.Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_БизнесКонсалтиг");
		СтрокаРеструктуризации.Эмитент = СтрокаРеструктуризации.Облигация.Эмитент.ЮрФизЛицо;
	
	КонецЕсли;

	Если Дата >= '20201118' Тогда
	
		СтрокаРеструктуризации = ТаблицаЦенныхБумаг.Добавить();
		СтрокаРеструктуризации.Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_ПропертизФин");
		СтрокаРеструктуризации.Эмитент = СтрокаРеструктуризации.Облигация.Эмитент.ЮрФизЛицо;
	
	КонецЕсли;
	
	Если Дата >= '20180301' Тогда
	
		СтрокаРеструктуризации = ТаблицаЦенныхБумаг.Добавить();
		СтрокаРеструктуризации.Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_Дол");
		СтрокаРеструктуризации.Эмитент = СтрокаРеструктуризации.Облигация.Эмитент.ЮрФизЛицо;
		
		СтрокаРеструктуризации = ТаблицаЦенныхБумаг.Добавить();
		СтрокаРеструктуризации.Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2");
		СтрокаРеструктуризации.Эмитент = СтрокаРеструктуризации.Облигация.Эмитент.ЮрФизЛицо;
		
	КонецЕсли;
	
	Возврат ТаблицаЦенныхБумаг;
	
КонецФункции

Функция ПолучитьОблигацииНаБалансеСПрошедшимПогашением() Экспорт

	ОблигацииНаБалансеСПрошедшимПогашением = Новый Массив;
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_РисЛэнд01"));
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВнешпрБО-3"));
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстандарт"));
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДомашниеДеньги1"));
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОВКФинанс"));
	ОблигацииНаБалансеСПрошедшимПогашением.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс"));
	
	Возврат ОблигацииНаБалансеСПрошедшимПогашением;
	
КонецФункции

Функция ПолучитьБлижайшуюРаннююДатуОбъединенияВГруппеБудущее(Дата) Экспорт

	МассивДатОбъединений = Новый Массив();
	МассивДатОбъединений.Добавить('20250818');	// Телеком перешел в Будущее
	МассивДатОбъединений.Добавить('20250916');  // все перешли в Будущее
	
	БлижайшаяРанняяДатаОбъединенияВГруппеБудущее = '00010101';
	
	Для каждого ДатаОбъединения Из МассивДатОбъединений Цикл
		Если ДатаОбъединения < Дата Тогда
			БлижайшаяРанняяДатаОбъединенияВГруппеБудущее = ДатаОбъединения;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат БлижайшаяРанняяДатаОбъединенияВГруппеБудущее;
	
КонецФункции

