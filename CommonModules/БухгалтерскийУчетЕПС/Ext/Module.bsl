			Если ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияРЕПО;
			ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Покупка Тогда	
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПокупка;
			Иначе
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссияПродажа;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссия;
		Если Сделка <> Неопределено Тогда
			Если ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияРЕПО;
			ИначеЕсли ВидСделки = Перечисления.ВидыСделок.Покупка Тогда	
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПокупка;
			Иначе
				ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.БрокерскаяКомиссияПродажа;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии  Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.ДепозитарнаяКомиссия;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария  Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.НеобходимыеРасходыСпецДепозитария;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария  Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоВознаграждениюСпецДепозитария;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария  Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамДепозитария;
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария  Тогда
		ВидДвиженияДенежныхСредств	= Справочники.ВидыДвиженияДенежныхСредств.РасходыПоУслугамСпецДепозитария;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить вид движения денежных средств для вида задолженности """ + ВидКомиссии + """ в документе " + ОбъектДокумента);
	КонецЕсли;
	
	Если ЦБ = Неопределено Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Поступление услуг");
		//дебет
		ДопАналитика = Неопределено;
		
		Если (ВидКомиссии = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии 
				ИЛИ ВидКомиссии.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия))
