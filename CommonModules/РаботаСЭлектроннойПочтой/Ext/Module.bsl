Функция ПолучитьHTMLФорматированногоДокументаДляПисьма(ФорматированныйДокумент) Экспорт
	
	// Выгрузка форматированного документа в HTML текст и картинки.
	ТекстHTML = "";
	Картинки = Новый Структура;
	ФорматированныйДокумент.ПолучитьHTML(ТекстHTML, Картинки);
	
	// Конвертация HTML текста в ДокументHTML.
	Построитель = Новый ПостроительDOM;
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.УстановитьСтроку(ТекстHTML);
	ДокументHTML = Построитель.Прочитать(ЧтениеHTML);
	
	// Замена имен картинок в документе HTML на идентификаторы.
	Для Каждого Картинка Из ДокументHTML.Картинки Цикл
		АтрибутИсточникКартинки = Картинка.Атрибуты.ПолучитьИменованныйЭлемент("src");
		АтрибутИсточникКартинки.ТекстовоеСодержимое = "cid:" + АтрибутИсточникКартинки.ТекстовоеСодержимое;
	КонецЦикла;
	
	// Конвертация ДокументHTML обратно в текст HTML.
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	ЗаписьDOM.Записать(ДокументHTML, ЗаписьHTML);
	ТекстHTML = ЗаписьHTML.Закрыть();
	
	// Подготовка результата.
	Результат = Новый Структура;
	Результат.Вставить("ТекстHTML", ТекстHTML);
	Результат.Вставить("Картинки", Картинки);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокуПолучателей(Получатели) Экспорт
	
	МассивАдресов = Новый Массив;
	
	Для Каждого Получатель Из Получатели Цикл
		МассивАдресов.Добавить(Получатель.Адрес);	
	КонецЦикла;
	
	Возврат СтрСоединить(МассивАдресов, "; ");
	
КонецФункции

// Преобразовывает внутренние форматы вложений к двоичным данным.
//
Функция ПривестиВложениеДляВставкиВПисьмо(Вложение)
	
	Если ТипЗнч(Вложение) = Тип("Строка") И ЭтоАдресВременногоХранилища(Вложение) Тогда
		Вложение = ПолучитьИзВременногоХранилища(Вложение);
		ПривестиВложениеДляВставкиВПисьмо(Вложение);
		Возврат Истина;
	ИначеЕсли ТипЗнч(Вложение) = Тип("Картинка") Тогда
		Вложение = Вложение.ПолучитьДвоичныеДанные();
		Возврат Истина;
	ИначеЕсли ТипЗнч(Вложение) = Тип("Файл") И Вложение.Существует() И Вложение.ЭтоФайл() Тогда
		Вложение = Новый ДвоичныеДанные(Вложение.ПолноеИмя);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Функция отправления - непосредственная реализация механики отправления
// электронного сообщения
//
// Функция, реализующая механику отправки сообщения электронной почты
//
// Параметры:
// УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты - ссылка на
//                 учетную запись электронной почты
// ПараметрыПисьма - структура - содержит всю необходимую информацию о письме:
//                   содержит следующие ключи:
//    Кому*      - Массив структур, строка - Интернет адрес получателя письма
//                 Адрес         - строка - почтовый адрес
//                 Представление - строка - имя адресата
//    Копии      - массив структур, строка - Интернет адреса получателей письма
//                 используется при формировании письма для поля копий
//                 в случае массива структур, формат каждой структуры:
//                 Адрес         - строка - почтовый адрес (должно быть обязательно заполнено)
//                 Представление - строка - имя адресата
//    СлепыеКопии - массив структур, строка - Интернет адреса получателей письма
//                 используется при формировании письма для поля скрытых копий
//                 в случае массива структур, формат каждой структуры:
//                 Адрес         - строка - почтовый адрес (должно быть обязательно заполнено)
//                 Представление - строка - имя адресата
//
//    Тема*      - Строка - тема почтового сообщения
//    Тело*      - тело почтового сообщения (простой текст в кодировке win-1251)
//    Важность   - ВажностьИнтернетПочтовогоСообщения
//    Вложения   - Соответствие
//                 ключ     - наименованиеВложения - строка - наименование вложения
//                 значение - ДвоичныеДанные,Структура - либо двоичные данные вложения, либо структура,
//                            содержащая следующие свойства:
//                            "ДвоичныеДанные" - ДвоичныеДанные - двоичные данные вложения
//                            "Идентификатор" - Строка - идентификатор вложения, используется для хранения картинок, отображаемых в теле письма
//
// дополнительные ключи структуры, которые могут использоваться:
//    АдресОтвета - Соответствие - см. такие же поля как и кому
//    Пароль      - Строка - пароль для доступа учетной записи
//    ИдентификаторыОснований - строка - идентификаторы оснований данного письма
//    ОбрабатыватьТексты  - Булево - необходимость обрабатывать тексты письма при отправке
//    УведомитьОДоставке  - Булево - необходимость запроса уведомления о доставке
//    УведомитьОПрочтении - Булево - необходимость запроса уведомления о прочтении
//    ТипТекста   - Строка / Перечисление.ТипыТекстовЭлектронныхПисем/ТипТекстаПочтовогоСообщения  определяет тип переданного теста
//                  допустимые значения:
//                  HTML/ТипыТекстовЭлектронныхПисем.HTML - текст почтового сообщения в формате HTML
//                  ПростойТекст/ТипыТекстовЭлектронныхПисем.ПростойТекст - простой текст почтового сообщения. Отображается "как есть" (значение по умолчанию)
//                  РазмеченныйТекст/ТипыТекстовЭлектронныхПисем.РазмеченныйТекст - текст почтового сообщения в формате Rich Text
//
//    прим.: параметры письма помеченные символом '*' являются обязательными
//           т.е. к началу работы функции считается что они уже заполнены
//Соединение - ИнтернетПочта - существующее соединение с почтовым сервером, если не указано, то соединение устанавливается в теле функции.
//
// Возвращаемое значение:
// Строка - идентификатор отправленного почтового сообщения на smtp сервере
//
// ПРИМЕЧАНИЕ: функция может вызвать исключение, которое требуется обработать
//
Функция ОтправитьСообщение(Знач УчетнаяЗапись, Знач ПараметрыПисьма, Соединение = Неопределено, ОтложеннаяОтправка = Ложь, Организация = Неопределено)
	
	ПараметрыПакетаДанных = Новый Структура;
	
	Если Организация <> Неопределено Тогда
		ПараметрыПакетаДанных.Вставить("Организация", Организация);
	КонецЕсли;
	
	ПараметрыПакетаДанных.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	
	// Получатели
	Если НЕ ПараметрыПисьма.Свойство("Кому")
		ИЛИ ТипЗнч(ПараметрыПисьма.Кому) <> Тип("Массив")
		ИЛИ ПараметрыПисьма.Кому.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		
		ПараметрыПакетаДанных.Вставить("Получатели", Новый Массив);
		
		Для Каждого Получатель Из ПараметрыПисьма.Кому Цикл
			
			НовыйПолучатель = Новый Структура;
			
			НовыйПолучатель.Вставить("Адрес",			Получатель.Адрес);
			НовыйПолучатель.Вставить("Представление",	Получатель.Представление);
			
			ПараметрыПакетаДанных.Получатели.Добавить(НовыйПолучатель);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Копии
	Если ПараметрыПисьма.Свойство("Копии") Тогда
		
		Если ТипЗнч(ПараметрыПисьма.Копии) = Тип("Массив")
			И ПараметрыПисьма.Копии.Количество() > 0 Тогда
			
			ПараметрыПакетаДанных.Вставить("ПолучателиКопии", Новый Массив);
			
			Для Каждого Получатель Из ПараметрыПисьма.Копии Цикл
				
				НовыйПолучатель = Новый Структура;
				
				НовыйПолучатель.Вставить("Адрес",			Получатель.Адрес);
				НовыйПолучатель.Вставить("Представление",	Получатель.Представление);
				
				ПараметрыПакетаДанных.ПолучателиКопии.Добавить(НовыйПолучатель);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Слепые копии
	Если ПараметрыПисьма.Свойство("СлепыеКопии") Тогда
		
		Если ТипЗнч(ПараметрыПисьма.СлепыеКопии) = Тип("Массив")
			И ПараметрыПисьма.СлепыеКопии.Количество() > 0 Тогда
			
			ПараметрыПакетаДанных.Вставить("ПолучателиСлепыхКопий", Новый Массив);
			
			Для Каждого Получатель Из ПараметрыПисьма.СлепыеКопии Цикл
				
				НовыйПолучатель = Новый Структура;
				
				НовыйПолучатель.Вставить("Адрес",			Получатель.Адрес);
				НовыйПолучатель.Вставить("Представление",	Получатель.Представление);
				
				ПараметрыПакетаДанных.ПолучателиСлепыхКопий.Добавить(НовыйПолучатель);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("РеквизитыОтправителя") Тогда
		ПараметрыПакетаДанных.Вставить("АдресОтправителя",			ПараметрыПисьма.РеквизитыОтправителя.АдресЭлектроннойПочты);
		ПараметрыПакетаДанных.Вставить("ПредставлениеОтправителя",	ПараметрыПисьма.РеквизитыОтправителя.ИмяПользователя);
	Иначе
		
		РеквизитыОтправителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "ИмяПользователя, АдресЭлектроннойПочты");
		
		ПараметрыПакетаДанных.Вставить("АдресОтправителя",			РеквизитыОтправителя.АдресЭлектроннойПочты);
		ПараметрыПакетаДанных.Вставить("ПредставлениеОтправителя",	РеквизитыОтправителя.ИмяПользователя);
		
	КонецЕсли; 
	
	Если ПараметрыПисьма.Свойство("АдресОтвета") Тогда
		
		ПараметрыПакетаДанных.Вставить("ОбратныеАдреса", Новый Массив);
		
		Для Каждого Получатель Из ПараметрыПисьма.АдресОтвета Цикл
			
			НовыйПолучатель = Новый Структура;
			
			НовыйПолучатель.Вставить("Адрес",			Получатель.Адрес);
			НовыйПолучатель.Вставить("Представление",	Получатель.Представление);
			
			ПараметрыПакетаДанных.ОбратныеАдреса.Добавить(НовыйПолучатель);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("УведомитьОДоставке") Тогда
		
		ПараметрыПакетаДанных.Вставить("УведомитьОДоставке",				ПараметрыПисьма.УведомитьОДоставке);
		ПараметрыПакетаДанных.Вставить("ПолучателиУведомленияОДоставке",	Новый Массив);
		
		НовыйПолучатель = Новый Структура;
		
		НовыйПолучатель.Вставить("Адрес",			ПараметрыПакетаДанных.АдресОтправителя);
		НовыйПолучатель.Вставить("Представление",	Неопределено);
		
		ПараметрыПакетаДанных.ПолучателиУведомленияОДоставке.Добавить(НовыйПолучатель);
		
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("УведомитьОПрочтении") Тогда
		
		ПараметрыПакетаДанных.Вставить("УведомитьОПрочтении",				ПараметрыПисьма.УведомитьОПрочтении);
		ПараметрыПакетаДанных.Вставить("ПолучателиУведомленияОПрочтении",	Новый Массив);
		
		НовыйПолучатель = Новый Структура;
		
		НовыйПолучатель.Вставить("Адрес",			ПараметрыПакетаДанных.АдресОтправителя);
		НовыйПолучатель.Вставить("Представление",	ПараметрыПакетаДанных.ПредставлениеОтправителя);
		
		ПараметрыПакетаДанных.ПолучателиУведомленияОПрочтении.Добавить(НовыйПолучатель);
		
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("Тема") Тогда
		ПараметрыПакетаДанных.Вставить("Тема", ПараметрыПисьма.Тема);
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("Тело") Тогда
		
		Если ТипЗнч(ПараметрыПисьма.Тело) = Тип("ФорматированныйДокумент") Тогда
			
			СодержимоеПисьма = ПолучитьHTMLФорматированногоДокументаДляПисьма(ПараметрыПисьма.Тело);
			
			ПараметрыПакетаДанных.Вставить("Текст", СодержимоеПисьма.ТекстHTML);
			
			Картинки = СодержимоеПисьма.Картинки;
			
			Если Картинки.Количество() > 0 Тогда
				
				ПараметрыПакетаДанных.Вставить("Файлы", Новый Массив);
				
				Для Каждого Картинка Из Картинки Цикл
					
					ДанныеФайла = Новый Структура;
					
					ДанныеФайла.Вставить("ДвоичныеДанные",	Картинка.Значение.ПолучитьДвоичныеДанные());
					ДанныеФайла.Вставить("Имя",				Картинка.Ключ);
					ДанныеФайла.Вставить("ПривязанКТексту",	Истина);
					ДанныеФайла.Вставить("Идентификатор",	Картинка.Ключ);
					
					ПараметрыПакетаДанных.Файлы.Добавить(ДанныеФайла);
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			ПараметрыПакетаДанных.Вставить("Текст", ПараметрыПисьма.Тело);
		КонецЕсли;
		
		Если ПараметрыПисьма.Свойство("ТипТекста") Тогда
			
			Если ТипЗнч(ПараметрыПисьма.ТипТекста) = Тип("Строка") Тогда
				
				Если ПараметрыПисьма.ТипТекста = "HTML" Тогда
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML;
				ИначеЕсли ПараметрыПисьма.ТипТекста = "RichText" Тогда
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.РазмеченныйТекст;
				Иначе
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ПараметрыПисьма.ТипТекста) = Тип("ТипТекстаПочтовогоСообщения") Тогда
				
				Если ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML Тогда
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML;
				ИначеЕсли ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.РазмеченныйТекст Тогда
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.РазмеченныйТекст;
				Иначе
					ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
				КонецЕсли;
				
			Иначе
				ТипТекста = ПараметрыПисьма.ТипТекста;
			КонецЕсли;
			
		Иначе
			
			Попытка
				ПервыеШестьСимволов = НРег(Лев(СокрЛ(ПараметрыПакетаДанных.Текст), 6));
			Исключение
				ПервыеШестьСимволов = "";
			КонецПопытки;
			
			Если ПервыеШестьСимволов = "<html>" Тогда
				ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML;
			Иначе
				ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
			КонецЕсли;
			
		КонецЕсли;
		
		ПараметрыПакетаДанных.Вставить("ТипТекста", ТипТекста);
		
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("ИдентификаторыОснований") Тогда
		ПараметрыПакетаДанных.Вставить("ИдентификаторыОснований", ПараметрыПисьма.ИдентификаторыОснований);
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("Важность") Тогда
		ПараметрыПакетаДанных.Вставить("Важность", ПараметрыПисьма.Важность);
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("Кодировка") Тогда
		ПараметрыПакетаДанных.Вставить("Кодировка", ПараметрыПисьма.Кодировка);
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("ОбрабатыватьТексты") Тогда
		ПараметрыПакетаДанных.Вставить("ОбрабатыватьТексты", ПараметрыПисьма.ОбрабатыватьТексты);
	КонецЕсли;
	
	Если ПараметрыПисьма.Свойство("Вложения") Тогда
		
		Если НЕ ПараметрыПакетаДанных.Свойство("Файлы") Тогда
			ПараметрыПакетаДанных.Вставить("Файлы", Новый Массив);
		КонецЕсли;
		
		Для Каждого ЭлементВложение Из ПараметрыПисьма.Вложения Цикл
			
			ДанныеФайла = Новый Структура;
			
			Вложение = ЭлементВложение.Значение;
			
			Если ТипЗнч(Вложение) = Тип("Структура") И Вложение.Свойство("ИдентификаторВерсии") Тогда
				ДанныеФайла.Вставить("ИдентификаторВерсии", Вложение.ИдентификаторВерсии);
			ИначеЕсли ТипЗнч(Вложение) = Тип("Структура") Тогда
				ДанныеФайла.Вставить("ДанныеФайла", Вложение.ДвоичныеДанные);
			Иначе
				ДанныеФайла.Вставить("ДанныеФайла", Вложение);
			КонецЕсли;
			
			ДанныеФайла.Вставить("Имя", ЭлементВложение.Ключ);
			
			ПараметрыПакетаДанных.Файлы.Добавить(ДанныеФайла);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РаботаСПакетамиДанныхКОбработке.СоздатьПакетДанных(Перечисления.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо, ПараметрыПакетаДанных, ОтложеннаяОтправка);
	
КонецФункции

// Функция подготавливает письмо к отправке на почтовый сервер. Если превышен максимальный размер письма, обрабатываются вложения:
// 1. файлы архивируются;
// 2. при необходимости архивы разбиваются на тома и рассылаются в нескольких письмах с модификацией темы. 
//
// Параметры:
//	Письмо - ИнтернетПочтовоеСообщение - Обрабатываемое письмо
//	МаксимальныйРазмерПисьма - Число - Максимальный размер письма в байтах, если 0 проверка не выполняется
//
// Возвращаемое значение:
//	ТаблицаЗначений - подготовленные к отправке письма с колонками Идентификатор, Письмо
//
Функция ПодготовитьПисьмоКОтправке(Письмо, МаксимальныйРазмерПисьма) Экспорт
	
	ПодготовленныеПисьма = Новый ТаблицаЗначений;
	ПодготовленныеПисьма.Колонки.Добавить("Идентификатор",	Новый ОписаниеТипов("УникальныйИдентификатор"));
	ПодготовленныеПисьма.Колонки.Добавить("Письмо",			Новый ОписаниеТипов("ИнтернетПочтовоеСообщение"));
	
	РазмерПисьма = Письмо.ПолучитьИсходныеДанные().Размер();
	
	Если МаксимальныйРазмерПисьма = 0
		ИЛИ РазмерПисьма < МаксимальныйРазмерПисьма
		ИЛИ Письмо.Вложения.Количество() = 0
	Тогда
		
		ПисьмоКОтправке = ПодготовленныеПисьма.Добавить();
		ПисьмоКОтправке.Идентификатор	= Новый УникальныйИдентификатор;
		ПисьмоКОтправке.Письмо			= Письмо;
		
	Иначе

		// Обрабатываем вложения
		
		ВоВложенииАрхив = Ложь;
		
		Если Письмо.Вложения.Количество() = 1 Тогда
			
			Если СтрЗаканчиваетсяНа(НРег(Письмо.Вложения[0].ИмяФайла), ".zip") Тогда
				
				ВоВложенииАрхив	= Истина;
				
			Иначе
				
				Файл = Новый Файл(Письмо.Вложения[0].ИмяФайла);		
				
				Если СтрЗаканчиваетсяНа(НРег(Файл.ИмяБезРасширения), ".zip") Тогда // том архива
					ВоВложенииАрхив	= Истина;
				Иначе
					ИмяАрхива = Файл.ИмяБезРасширения + ".zip";
				КонецЕсли;
				
			КонецЕсли;

		Иначе
			
			ИмяАрхива = "Архив.zip";
		
		КонецЕсли;
		
		// Архивируем файлы
		
		Если Не ВоВложенииАрхив Тогда
		
			ВременныйКаталог = КаталогВременныхФайлов() + XMLСтрока(Новый УникальныйИдентификатор) + "\";
			
			КаталогАрхива = ВременныйКаталог + XMLСтрока(Новый УникальныйИдентификатор) + "\"; // архив размещаем в отдельном каталоге для защиты от одноименных вложений
			СоздатьКаталог(КаталогАрхива);
			
			ФайлАрхива = КаталогАрхива + ИмяАрхива;
			
			ЗаписьZipФайла = Новый ЗаписьZipФайла(ФайлАрхива, , , , , , КодировкаИменФайловВZipФайле.OSEncodingWithUTF8);

			Для Каждого Вложение Из Письмо.Вложения Цикл
			
				ИсходныйФайл = ВременныйКаталог + Вложение.ИмяФайла;
				
				Вложение.Данные.Записать(ИсходныйФайл);		
				
				ЗаписьZipФайла.Добавить(ИсходныйФайл);
				
			КонецЦикла;
			
			ЗаписьZipФайла.Записать();
			
			Письмо.Вложения.Очистить();
			Письмо.Вложения.Добавить(Новый ДвоичныеДанные(ФайлАрхива), ИмяАрхива);
			
			Попытка
				УдалитьФайлы(ВременныйКаталог);
			Исключение
				ТекстОшибки = СтрШаблон(
					"Ошибка удаления временного каталога '%1' и вложенных файлов из-за ошибки:
					|%2",
					ВременныйКаталог,
					ОписаниеОшибки());
					
				РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Удаление временных файлов");
			КонецПопытки;
			
			РазмерПисьма = Письмо.ПолучитьИсходныеДанные().Размер();
			
		КонецЕсли;
		
		// К этому моменту во вложениях должен остаться всего один архив.
		// Если письмо с ним все равно превышает размер, разбиваем его на тома и рассылаем в несколько письмах
		
		Если РазмерПисьма >= МаксимальныйРазмерПисьма Тогда
			
			ТемаПисьма		= Письмо.Тема;
			ИмяАрхива		= Письмо.Вложения[0].ИмяФайла;
			ДанныеАрхива	= Письмо.Вложения[0].Данные;
			
			МассивЧастей = РазделитьДвоичныеДанные(ДанныеАрхива, МаксимальныйРазмерПисьма * 0.7); // т.к. base64 увеличивает размер вложения примерно на треть 
	
			ВсегоЧастей	= МассивЧастей.Количество();
			НомерЧасти	= 0;
			
			Для Каждого ЧастьАрхива Из МассивЧастей Цикл
				
				НомерЧасти = НомерЧасти + 1;
				
				НовоеПисьмо = ?(НомерЧасти = 1, Письмо, СкопироватьПисьмо(Письмо));
				
				НовоеПисьмо.Тема = СтрШаблон("%1 (%2 из %3)", ТемаПисьма, НомерЧасти, ВсегоЧастей);
				
				НовоеПисьмо.Вложения.Очистить();
				НовоеПисьмо.Вложения.Добавить(ЧастьАрхива, ИмяАрхива + Формат(НомерЧасти, "ЧЦ='3'; ЧФ='.Ч'; ЧВН=''"));
				
				ПисьмоКОтправке = ПодготовленныеПисьма.Добавить();
				ПисьмоКОтправке.Идентификатор	= Новый УникальныйИдентификатор;
				ПисьмоКОтправке.Письмо			= НовоеПисьмо;
				
			КонецЦикла;
			
		Иначе
			
			ПисьмоКОтправке = ПодготовленныеПисьма.Добавить();
			ПисьмоКОтправке.Идентификатор	= Новый УникальныйИдентификатор;
			ПисьмоКОтправке.Письмо			= Письмо;
			
		КонецЕсли;

	КонецЕсли;		
	
	Возврат ПодготовленныеПисьма; 
	
КонецФункции

