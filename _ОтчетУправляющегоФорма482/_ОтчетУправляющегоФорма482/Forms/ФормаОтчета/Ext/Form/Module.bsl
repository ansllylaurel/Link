
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);	
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Отчет.Период.ДатаНачала    = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), - 1));
	Отчет.Период.ДатаОкончания = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), - 1));
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	ИнициализироватьПараметрыНауфорНаСервере();
	
КонецПроцедуры

	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если      ТипЗнч(Отчет.КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		ЭтаФорма.ВидКлиентаДоверительногоУправления = 0;
	ИначеЕсли ТипЗнч(Отчет.КлиентДоверительногоУправления) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ЭтаФорма.ВидКлиентаДоверительногоУправления = 1;
	КонецЕсли;
	
	ВидКлиентаДоверительногоУправленияПриИзменении(Неопределено);
	
	Отчет.ДокументПодписанЭЦП = Истина;
	
	Если ЗначениеЗаполнено(Отчет.Подписант) Тогда
		ЗаполнитьСертификатКлючаЭЦПНаСервере();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ); 	
	КонецЕсли;
	
	Если Отчет.ДокументПодписанЭЦП И Не ЗначениеЗаполнено(Отчет.СертификатКлючаЭЦП) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Сертификат ключа ЭЦП"" не заполнено", ЭтаФорма, "Отчет.СертификатКлючаЭЦП",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКлиентаДоверительногоУправленияПриИзменении(Элемент)
	
	Если      ЭтаФорма.ВидКлиентаДоверительногоУправления = 0 Тогда
		ОграничениеТипаКлиента = Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления");
	ИначеЕсли ЭтаФорма.ВидКлиентаДоверительногоУправления = 1 Тогда
		ОграничениеТипаКлиента = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
	КонецЕсли;
	
	Элементы.КлиентДоверительногоУправления.ОграничениеТипа = ОграничениеТипаКлиента;
	
	Отчет.КлиентДоверительногоУправления = ОграничениеТипаКлиента.ПривестиЗначение(Отчет.КлиентДоверительногоУправления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокКонтактныхЛиц = ПолучитьСписокКонтактныхЛицНаСервере();
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		
		Отчет.Подписант = РезультатВыбора.Значение;
		
		Если Отчет.ДокументПодписанЭЦП Тогда
			ЗаполнитьСертификатКлючаЭЦПНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументПодписанЭЦППриИзменении(Элемент)
	
	Если Не Отчет.ДокументПодписанЭЦП Тогда
		Отчет.СертификатКлючаЭЦП = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(Отчет.Подписант) Тогда
		ЗаполнитьСертификатКлючаЭЦПНаСервере();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
	
	ПолучитьДанныеПоФинПоказателямНаСервере();
	
	Если НужноФормироватьГодовойОтчетНаСервере() Тогда
		
		СформироватьГодовойОтчетНаСервере();
		
		Элементы.СтраницаОтчета.Заголовок          = "Форма 482 кварт";
		Элементы.СтраницаОтчетаГодовой.Видимость   = Истина;
		
		Сообщить("Дополнительно сформирован годовой отчет за " + Формат(Год(Отчет.Период.ДатаОкончания), "ЧГ=0") + " год");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЛКК(Команда)
	
	РеквизитыОтчета = Новый Структура;
	РеквизитыОтчета.Вставить("Подписант",           Отчет.Подписант);
	РеквизитыОтчета.Вставить("СертификатКлючаЭЦП",  Отчет.СертификатКлючаЭЦП);
	
	ПараметрыФормы = Новый Структура("РеквизитыОтчета", РеквизитыОтчета);
	
	ОткрытьФормуМодально("ВнешнийОтчет._ОтчетУправляющегоФорма482.Форма.ФормаОтчетыДляЛКК", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьНауфор(Команда)
	
	Если Не ПроверитьЗаполнениеНауфор() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьОтчетНауфорНаСервере();
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаНауфор;
	
КонецПроцедуры

&НаКлиенте
Процедура НауфорВидКлиентаПриИзменении(Элемент)
	
	Если НауфорВидКлиента = 0 Тогда
		ОграничениеТипаКлиента = Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления");
	Иначе
		ОграничениеТипаКлиента = Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица");
	КонецЕсли;
	
	Элементы.НауфорКлиент.ОграничениеТипа = ОграничениеТипаКлиента;
	НауфорКлиент = ОграничениеТипаКлиента.ПривестиЗначение(НауфорКлиент);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНауфор()
	
	Отказ = Ложь;
	ТекстСообщения = "";
	
	Если Не ЗначениеЗаполнено(НауфорОрганизация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена организация", ЭтаФорма, "НауфорОрганизация",, Отказ);
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(НауфорПериод,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "НауфорПериод", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НауфорКлиент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен клиент доверительного управления", ЭтаФорма, "НауфорКлиент",, Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ИнициализироватьПараметрыНауфорНаСервере()
	
	НауфорПериод = Отчет.Период;
	НауфорОрганизация = Отчет.Организация;
	НауфорВидКлиента = 0;
	НауфорКлиент = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНауфорНаСервере()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ПараметрыНауфор = Новый Структура;
	ПараметрыНауфор.Вставить("Организация", НауфорОрганизация);
	ПараметрыНауфор.Вставить("Период", НауфорПериод);
	ПараметрыНауфор.Вставить("ВидКлиента", НауфорВидКлиента);
	ПараметрыНауфор.Вставить("КлиентДоверительногоУправления", НауфорКлиент);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ОтчетОбъект.СформироватьОтчетНауфор(ДокументРезультат, ПараметрыНауфор);
	ТаблицаОтчетаНауфор = ДокументРезультат;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура АвтоматическоеФормирование() Экспорт

	ЗаполнитьЗначенияСвойств(Отчет, ЭтаФорма.НастройкиОтчета);
	
	Если ЭтаФорма.НастройкиОтчета.Свойство("Подписант")
		И ТипЗнч(ЭтаФорма.НастройкиОтчета.Подписант) = Тип("Структура")
		И ЭтаФорма.НастройкиОтчета.Подписант.Свойство("КонтактноеЛицо")
	Тогда
		Отчет.Подписант = ЭтаФорма.НастройкиОтчета.Подписант.КонтактноеЛицо;	
	КонецЕсли; 
	
	Если      Число(ЭтаФорма.НастройкиОтчета.ВидКлиентаДоверительногоУправления) = 0 Тогда
		Отчет.КлиентДоверительногоУправления = ЭтаФорма.НастройкиОтчета.СчетДоверительногоУправления; 
	ИначеЕсли Число(ЭтаФорма.НастройкиОтчета.ВидКлиентаДоверительногоУправления) = 1 Тогда
		Отчет.КлиентДоверительногоУправления = ПолучитьКлиентаДоверительногоУправления(ЭтаФорма.НастройкиОтчета.СчетДоверительногоУправления, ЭтаФорма.НастройкиОтчета.Период.ДатаОкончания);
		Если Отчет.КлиентДоверительногоУправления = Неопределено Тогда
			ВызватьИсключение "Не удалось определить юр/физ лицо по счету д/у";
		КонецЕсли; 
	КонецЕсли;
	
	СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
	
	РаботаСОтчетамиКлиент.АвтоматическоеФормированиеОтчета(ЭтаФорма, ЭтаФорма.ТаблицаОтчета); 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Форма.Элементы.СертификатКлючаЭЦП.Видимость = Форма.Отчет.ДокументПодписанЭЦП;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлиентаДоверительногоУправления(СчетДоверительногоУправления, Период)

	Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);

КонецФункции

&НаСервере
Процедура ПолучитьДанныеПоФинПоказателямНаСервере()
	
	ЭтаФорма.СЧА = 0;
	ЭтаФорма.РегистраторПоказателейСЧА = Неопределено;
	
	// СЧА
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК Значение,
		|	ФинансовыеПоказатели.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
	
	Запрос.УстановитьПараметр("Период", Отчет.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	Запрос.УстановитьПараметр("СубъектАналитики", Отчет.КлиентДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтаФорма.СЧА = Выборка.Значение;
		ЭтаФорма.РегистраторПоказателейСЧА = Выборка.Регистратор;
	КонецЕсли;
	
	// Стоимость ценных бумаг
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК СуммаСЧА
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.КлиентДоверительногоУправления);
	
	СтоимостьПереоценкиЦенныхБумаг = Запрос.Выполнить().Выгрузить();
	СтоимостьПереоценкиЦенныхБумаг.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));
	
	Для каждого Элемент Из Отчет.РасшифровкаСтоимостиПортфеля Цикл
		
		СтрокаСтоимостьПереоценкиЦенныхБумаг = СтоимостьПереоценкиЦенныхБумаг.Найти(Элемент.Актив, "ЦеннаяБумага");
		
		Если СтрокаСтоимостьПереоценкиЦенныхБумаг <> Неопределено Тогда
			Элемент.СуммаСЧА   = СтрокаСтоимостьПереоценкиЦенныхБумаг.СуммаСЧА;
			Элемент.Расхождение = ?(Элемент.Сумма = Элемент.СуммаСЧА, 1, 2);
			
			СтрокаСтоимостьПереоценкиЦенныхБумаг.Обработано = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // НайтиДокументыРегистрацииФинПоказателей

&НаСервере
Процедура ЗаполнитьСертификатКлючаЭЦПНаСервере()
	
	Отчет.СертификатКлючаЭЦП = РеквизитФормыВЗначение("Отчет").ПолучитьОсновнойСертификатКлючаЭЦП();
	
КонецПроцедуры // ПолучитьОсновнойСертификатКлючаЭЦПНаСервере

&НаСервере
Функция ПолучитьСписокКонтактныхЛицНаСервере()
	
	Возврат РеквизитФормыВЗначение("Отчет").ПолучитьСписокКонтактныхЛиц();
	
КонецФункции // ПолучитьСписокКонтактныхЛицНаСервере

&НаСервере
Функция НужноФормироватьГодовойОтчетНаСервере()
	
	Элементы.СтраницаОтчетаГодовой.Видимость = Ложь;
	ТаблицаОтчетаГодовой.Очистить();
	
	Если НачалоКвартала(Отчет.Период.ДатаОкончания) <> Отчет.Период.ДатаНачала
		ИЛИ КонецКвартала(Отчет.Период.ДатаОкончания) <> Отчет.Период.ДатаОкончания
		ИЛИ Месяц(Отчет.Период.ДатаОкончания) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат РеквизитФормыВЗначение("Отчет").ЦелевойКапиталТребуетГодовогоОтчета(Отчет.Период.ДатаОкончания);

КонецФункции

&НаСервере
Процедура СформироватьГодовойОтчетНаСервере()
	
	ОбъектОтчета = РеквизитФормыВЗначение("Отчет");
	
	ГодовойПериод = Новый СтандартныйПериод;
	ГодовойПериод.ДатаНачала    = НачалоГода(Отчет.Период.ДатаОкончания);
	ГодовойПериод.ДатаОкончания = КонецГода(Отчет.Период.ДатаОкончания);
	
	ОбъектОтчета.Период = ГодовойПериод;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ОбъектОтчета.СкомпоноватьРезультат(ДокументРезультат);
	
	ТаблицаОтчетаГодовой = ДокументРезультат;
	
КонецПроцедуры
