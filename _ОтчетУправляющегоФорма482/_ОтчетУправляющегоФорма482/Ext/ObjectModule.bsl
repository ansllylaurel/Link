		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ТаблицаДвижений";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Сделки РЕПО"));
