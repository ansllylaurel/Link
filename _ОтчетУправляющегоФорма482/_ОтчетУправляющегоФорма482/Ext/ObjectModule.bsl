// ИНТЕРФЕЙС ДЛЯ ВКЛЮЧЕНИЯ В ДОП. ОТЧЕТЫ И ОБРАБОТКИ

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//         |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//         |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительныйОтчет",
		"Отчет управляющего, форма 482",
		"2.24",
		"",
		Истина);
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	Возврат РегистрационныеДанные;
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	Если НастройкиОтчета.Свойство("Подписант")
		И ТипЗнч(НастройкиОтчета.Подписант) = Тип("Структура")
		И НастройкиОтчета.Подписант.Свойство("КонтактноеЛицо")
	Тогда
		ЭтотОбъект.Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;	
	КонецЕсли;
	
	Если Число(НастройкиОтчета.ВидКлиентаДоверительногоУправления) = 0 Тогда
		ЭтотОбъект.КлиентДоверительногоУправления = НастройкиОтчета.СчетДоверительногоУправления; 
	ИначеЕсли Число(НастройкиОтчета.ВидКлиентаДоверительногоУправления) = 1 Тогда
		ЭтотОбъект.КлиентДоверительногоУправления = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(НастройкиОтчета.СчетДоверительногоУправления, НастройкиОтчета.Период.ДатаОкончания);
		
		Если ЭтотОбъект.КлиентДоверительногоУправления = Неопределено Тогда
			ВызватьИсключение "Не удалось определить юр/физ лицо по счету д/у!";
		КонецЕсли; 
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("АктивыБолее45млнПоЦК") И Не ЦелевойКапиталТребуетГодовогоОтчета(Период.ДатаОкончания) Тогда
		ВызватьИсключение "Условия формирования отчета с настройкой ""Активы более 45 млн. по ЦК"" не соблюдены";
	КонецЕсли;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СкомпоноватьРезультат(ДокументРезультат);
	
	Если ДокументРезультат.ВысотаТаблицы > 0 Тогда
		НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВидКлиентаДоверительногоУправления");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

#Область ФормированиеОтчета

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	Перем Запрос;
	Перем ТаблицаОтчета;
	Перем МакетОтчета;
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
		ЭтотОбъект, "Период, Организация, КлиентДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтандартнаяОбработка = Ложь;
	
	ДокументРезультат.Очистить();
	РасшифровкаСтоимостиПортфеля.Очистить();
	
	ТаблицаОтчета = ДокументРезультат;
	МакетОтчета = ПолучитьМакет("Макет");
	
	НачалоПериодаОтчета = ПолучитьНачалоПериодаОтчета(Период.ДатаНачала, Период.ДатаОкончания);
	
	Если Не ИнициализироватьЗапрос(Запрос, НачалоПериодаОтчета, Период.ДатаОкончания) Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
	// Проверяем наличие зарегистрированной СЧА
	ПроверитьРегистрациюСЧАПоВыбраннымСчетам(Запрос);
	
	// Шапка отчета
	ВывестиШапкуОтчета(МакетОтчета, ТаблицаОтчета, Запрос, НачалоПериодаОтчета);
	
	// Остатки
	ВывестиГруппуСоставАктивов(МакетОтчета, ТаблицаОтчета, Запрос);
	
	// Сделки
	ВывестиГруппуСделки(МакетОтчета, ТаблицаОтчета, Запрос);
	
	// Движения
 	ВывестиГруппуДвижения(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиГруппуРасходы(МакетОтчета, ТаблицаОтчета, Запрос);
	
	// Расчет вознаграждения 
	// Если в периоде отчета была смена стратегии, вознаграждение не рассчитывается и не выводится
	
	Если Не КлиентИИСНаИндивидуальнойСтратегии() Тогда
		
		Отказ = Ложь;
		ВывестиГруппуРасчетВознаграждения(МакетОтчета, ТаблицаОтчета, Запрос, Отказ);
		
		Если Отказ Тогда
			ТаблицаОтчета.Очистить();
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Информация об осуществлении прав голоса по ценным бумагам
	Если Период.ДатаОкончания >= ДатаДобавленияБлокаОБОсуществленииПраваГолосаПоЦеннымБумагам() Тогда
		ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Информация об осуществлении прав голоса по ценным бумагам")));
		Если Не ВывестиТаблицуГолосованийПоЦеннымБумагам(МакетОтчета, ТаблицаОтчета, Запрос) Тогда
			// Данных о голосовании нет - выводим типовой текст макета
			ОбластьМакета = МакетОтчета.ПолучитьОбласть("ОсуществлениеПраваГолосаПоЦеннымБумагам");
			ДокументРезультат.Вывести(ОбластьМакета);
		КонецЕсли;
	КонецЕсли;
	
	// Информация, предоставляемая при прекращении договора Д/У (если клиент является ИИС)
	Если ЗначениеЗаполнено(ЭтотОбъект.КлиентДоверительногоУправления)
		И ТипЗнч(ЭтотОбъект.КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления")
		И Период.ДатаОкончания >= Дата(2024, 1, 1)
	Тогда
		СвойстваСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.КлиентДоверительногоУправления,
			"ВидДоговораДоверительногоУправления, ДатаРасторжения, НомерДоговора");
		Если СвойстваСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет
			И СвойстваСчетаДУ.ДатаРасторжения <= Период.ДатаОкончания
		Тогда
			ОбластьМакета = МакетОтчета.ПолучитьОбласть("ПриПрекращенииДоговораДУ");
			ОбластьМакета.Параметры.НомерДоговораДУ = СвойстваСчетаДУ.НомерДоговора;
			ОбластьМакета.Параметры.ДатаРасторжения = СвойстваСчетаДУ.ДатаРасторжения;
			ДокументРезультат.Вывести(ОбластьМакета);
		КонецЕсли;
	КонецЕсли;
	
	// Подвал отчета
	ВывестиПодвалОтчета(МакетОтчета, ТаблицаОтчета, Запрос);
	
	// Заполняем настройки печати
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТаблицаОтчета, ЭтотОбъект.Метаданные().ПолноеИмя());
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
КонецПроцедуры

Функция ИнициализироватьЗапрос(Запрос, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",        КонецПериода + 1); // Для "Остатки"
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);        
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);     // Для "Остатки и обороты" и "Срез последних"
	Запрос.УстановитьПараметр("КонецПериодаНачалоДня",  НачалоДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("ВалютаУчета",   Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ЦельРасчета",   Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		
		Если ТипЗнч(КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			СчетДоверительногоУправления = КлиентДоверительногоУправления;
		Иначе
			СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(КлиентДоверительногоУправления,КонецПериода);
		КонецЕсли;
		
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(КонецПериода, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
		Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
			Запрос.УстановитьПараметр("ОпределятьЗадолженностьРЕПОВидуСделки", Ложь);
		Иначе
			
			НастройкиРЕПО = Справочники.ВариантыРасчетаОценочнойСтоимости.ПараметрыРасчетаЗадолженностиПоСделкамРЕПО(Организация, СчетДоверительногоУправления, НастройкиОценки.ВариантРасчетаОценочнойСтоимости, КонецПериода);
			
			Если НастройкиРЕПО = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("ОпределятьЗадолженностьРЕПОВидуСделки", НастройкиРЕПО.ВариантРасчетаЗадолженности = "ОсновнойДолгПлюсПроцент");
			
		КонецЕсли;
		
	Иначе
		Запрос.УстановитьПараметр("ОпределятьЗадолженностьРЕПОВидуСделки", Ложь);
	КонецЕсли;
	
	// Получаем счета ДУ и помещаем в ВТ
	Если Не ПолучитьСчетаДоверительногоУправления(Запрос) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного клиента не открыты счета доверительного управления в '" + Строка(Организация) + "'");
		Возврат Ложь;
	КонецЕсли;
	
	// Общие временные таблицы
	ПолучитьРыночнуюСтоимостьАктивов(Запрос);
	ПолучитьКурсыВалют(Запрос);
	
	Возврат Истина;
КонецФункции

// Группы отчета

Процедура ВывестиШапкуОтчета(МакетОтчета, ТаблицаОтчета, Запрос, НачалоПериодаОтчета)
	
	Область = МакетОтчета.ПолучитьОбласть("Шапка");
	Область.Параметры.Заполнить(ПолучитьРеквизитыШапки(Запрос));
	Область.Параметры.Период     = "с " + Формат(НачалоПериодаОтчета, "ДФ=dd.MM.yyyy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаОтчета = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	
	ТаблицаОтчета.Вывести(Область);
	
	ТаблицаОтчета.НачатьГруппуСтрок();
	ВывестиКонтрагентов(МакетОтчета, ТаблицаОтчета, Запрос);
	ТаблицаОтчета.ЗакончитьГруппуСтрок();
	
КонецПроцедуры // ВывестиШапкуОтчета

Функция ПолучитьНачалоПериодаОтчета(НачалоПериода, КонецПериода)
	
	ДатаПервогоВвода = ПолучитьДатуПервогоВводаАктивов(КонецПериода);
	
	Если ЗначениеЗаполнено(ДатаПервогоВвода) И ДатаПервогоВвода > НачалоПериода Тогда
		Возврат НачалоДня(ДатаПервогоВвода);
	КонецЕсли;
	
	Возврат НачалоПериода;
	
КонецФункции

Функция ПолучитьДатуПервогоВводаАктивов(КонецПериода)
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.КлиентДоверительногоУправления) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ЭтотОбъект.КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МИНИМУМ(НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ)) КАК ДатаПервогоВвода
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			|ГДЕ
			|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &Счет
			|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|	И ВводыВыводыАктивовВВалютеУчета.Активность = ИСТИНА
			|	И ВводыВыводыАктивовВВалютеУчета.Период <= &КонецПериода";
		
		Запрос.УстановитьПараметр("Счет", ЭтотОбъект.КлиентДоверительногоУправления);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		
	Иначе
		
		// Выбран ЮрФизЛицо — берём минимальную дату первого ввода по действующим счетам ДУ клиента
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МИНИМУМ(НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ)) КАК ДатаПервогоВвода
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, ) КАК КлиентыДУСрезПоследних
			|		ПО ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = КлиентыДУСрезПоследних.СчетДоверительногоУправления
			|ГДЕ
			|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
			|	И КлиентыДУСрезПоследних.Клиент = &Клиент
			|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|	И ВводыВыводыАктивовВВалютеУчета.Активность = ИСТИНА
			|	И ВводыВыводыАктивовВВалютеУчета.Период <= &КонецПериода";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.КлиентДоверительногоУправления);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ДатаПервогоВвода) Тогда
		Возврат Выборка.ДатаПервогоВвода;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЦелевойКапиталТребуетГодовогоОтчета(ДатаОкончания, МассивСчетовДУ = Неопределено) Экспорт
	
	Если КонецГода(ДатаОкончания) <> ДатаОкончания Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если МассивСчетовДУ = Неопределено Тогда
		МассивДляПроверки = Новый Массив;
		МассивДляПроверки.Добавить(ЭтотОбъект.КлиентДоверительногоУправления);
	Иначе
		МассивДляПроверки = МассивСчетовДУ;
	КонецЕсли;
	
	Возврат ПолучитьСчетаЦКТребующиеГодовогоОтчета(
		ЭтотОбъект.Организация, ДатаОкончания, МассивДляПроверки).Количество() > 0;
	
КонецФункции

Функция ПолучитьСчетаЦКТребующиеГодовогоОтчета(Организация, ДатаОкончания, МассивСчетовДУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФП
		|		ПО ФП.СубъектАналитики = СчетаДУ.Ссылка
		|			И ФП.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|			И ФП.Организация = &Организация
		|			И ФП.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|ГДЕ
		|	СчетаДУ.Ссылка В (&МассивСчетов)
		|	И СчетаДУ.ВидДоговораДоверительногоУправления =
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов)
		|	И ЕСТЬNULL(ФП.Значение, 0) > 45000000";
	
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("МассивСчетов",  МассивСчетовДУ);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьСтоимостьАктивовНаДату(Организация, СчетДоверительногоУправления, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СубъектАналитики", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ВывестиГруппуСоставАктивов(МакетОтчета, ТаблицаОтчета, Запрос)
	ОбластиТаблицыАктивов = Новый Структура;
	ОбластиТаблицыАктивов.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Состав и стоимость активов учредителя управления на конец отчетного периода")));
	ОбластиТаблицыАктивов.Вставить("Подзаголовок", ПолучитьЗаголовок(МакетОтчета, 3, "Оценочная стоимость финансовых вложений отображается с учетом резерва на возможные потери(обесценение) в случае его наличия"));
	ОбластиТаблицыАктивов.Вставить("ОбластьОбщегоИтога", МакетОтчета.ПолучитьОбласть("Итог_Уровень0"));
	ОбластиТаблицыАктивов.Вставить("ОбластьТело", Новый ТабличныйДокумент);
	
	ОбщаяСтоимостьАктивов = 0;
	
	ВывестиОстаткиДенежныхСредств(МакетОтчета, ОбластиТаблицыАктивов.ОбластьТело, Запрос, ОбщаяСтоимостьАктивов);
	ВывестиОстаткиЦенныхБумаг(МакетОтчета, ОбластиТаблицыАктивов.ОбластьТело, Запрос, ОбщаяСтоимостьАктивов);
	ВывестиЗадолженностиПоДенежнымСредствам(МакетОтчета, ОбластиТаблицыАктивов.ОбластьТело, Запрос, ОбщаяСтоимостьАктивов);
	ВывестиЗадолженностиЦенныхБумаг(МакетОтчета, ОбластиТаблицыАктивов.ОбластьТело, Запрос, ОбщаяСтоимостьАктивов);
	
	ВывестиПоказателиЗаГод(МакетОтчета, ТаблицаОтчета);
	
	// Вывод области активов
	ТаблицаОтчета.Вывести(ОбластиТаблицыАктивов.Заголовок);
	ТаблицаОтчета.Вывести(ОбластиТаблицыАктивов.Подзаголовок);
	
	СтрСуммаВВалютеДоговора = ПолучитьОписаниеСуммыВВалютеДоговора(ОбщаяСтоимостьАктивов);
	ОбластиТаблицыАктивов.ОбластьОбщегоИтога.Параметры.Итог = "ИТОГО: " + Формат(ОбщаяСтоимостьАктивов, "ЧДЦ=2") + " руб." + СтрСуммаВВалютеДоговора;
	ТаблицаОтчета.Вывести(ОбластиТаблицыАктивов.ОбластьОбщегоИтога);
	
	ТаблицаОтчета.НачатьГруппуСтрок();
	ТаблицаОтчета.Вывести(ОбластиТаблицыАктивов.ОбластьТело);
	ТаблицаОтчета.ЗакончитьГруппуСтрок();
КонецПроцедуры // ВывестиСоставАктивов

// Если пересчет в валюту не требуется, возвращает "",
// иначе - строка "/" + отформатированная сумма в валюте и наименование валюты
Функция ПолучитьОписаниеСуммыВВалютеДоговора(ОбщаяСтоимостьАктивов)
	
	// Валюту отчета можем определить только для режима, когда выбран счет доверительного управления
	Если ТипЗнч(ЭтотОбъект.КлиентДоверительногоУправления) <> Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Возврат "";
	КонецЕсли;
	
	ВалютаДоговора = Неопределено;
	
	// Когда будут изменены метаданные, нужно раскомментировать строку и 
	// доработать функцию
	//ВалютаДоговора = ПолучитьВалютуДоговора();
	                     	
	// Рубли пропускаем
	Если (Не ЗначениеЗаполнено(ВалютаДоговора)) Или ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета") Тогда
		Возврат "";
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсыВалют.Курс * КурсыВалют.Кратность КАК Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Период = &Период
	|	И КурсыВалют.Валюта = &ВалютаДоговора
	|	И КурсыВалют.Курс <> 0";
	
	Запрос.УстановитьПараметр("Период", 				НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ВалютаДоговора", 		ВалютаДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат " / " + Формат(ОбщаяСтоимостьАктивов / Выборка.Курс, "ЧДЦ=2") + " " + СокрЛП(ВалютаДоговора);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату отчета не задан курс валюты " + СокрЛП(ВалютаДоговора));
		Возврат "";
	КонецЕсли;	
	          	
КонецФункции // ПолучитьОписаниеСуммыВВалютеДоговора()

Функция ПолучитьВалютуДоговора()
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
КонецФункции

Процедура ВывестиГруппуСделки(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Сделки за отчетный период")));
	
	ТаблицаОтчета.НачатьГруппуСтрок();
	
	ВывестиСделки(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиСделкиРЕПО(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиСделкиСВалютой(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиФорварды(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиСвопы(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиСделкиДепозитнымВкладам(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиСделкиПоМНО(МакетОтчета, ТаблицаОтчета, Запрос);
	
	ТаблицаОтчета.ЗакончитьГруппуСтрок();

КонецПроцедуры // ВывестиГруппуСделки

Процедура ВывестиГруппуДвижения(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Движения денежных средств и ценных бумаг за отчетный период")));
	
	ТаблицаОтчета.НачатьГруппуСтрок();
	
	ВывестиДвижениеДенежныхСредств(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиДвижениеАктивов(МакетОтчета, ТаблицаОтчета, Запрос);
		
	ТаблицаОтчета.ЗакончитьГруппуСтрок();

КонецПроцедуры // ВывестиГруппуДвижения

Процедура ВывестиГруппуРасходы(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Начисленные расходы за отчетный период")));
	
	ТаблицаОтчета.НачатьГруппуСтрок();
	
	ВывестиРасходыПоСделке(МакетОтчета, ТаблицаОтчета, Запрос);
	ВывестиРасходы(МакетОтчета, ТаблицаОтчета, Запрос);
	
	ТаблицаОтчета.ЗакончитьГруппуСтрок();

КонецПроцедуры // ВывестиГруппуДвижения

Процедура ВывестиГруппуРасчетВознаграждения(МакетОтчета, ТаблицаОтчета, Запрос, Отказ = Ложь)
	
	ОбластьВознаграждениеУправляющего = Неопределено;
	ОбластьПлатаЗаРазмещение          = Неопределено;
	
	КлиентЯвляетсяИИС = ТипЗнч(ЭтотОбъект.КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления")
		И ЭтотОбъект.КлиентДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет;
	
	Если КлиентЯвляетсяИИС Тогда
		
		// По согласованию с Надей, проверка удалена. Иначе отчет не строится на промежуточные даты (или на даты расторжения)
		//Если (ЭтотОбъект.Период.ДатаНачала = НачалоКвартала(ЭтотОбъект.Период.ДатаНачала))
		//		И (ЭтотОбъект.Период.ДатаОкончания = КонецКвартала(ЭтотОбъект.Период.ДатаНачала))
		//Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		РасчетВознагражденияУправляющего = Обработки.РасчетВознагражденияУправляющего.Создать();
		РасчетВознагражденияУправляющего.Организация          = ЭтотОбъект.Организация;
		
		// Определим дату, на которую нужно рассчитать вознаграждение
		РасчетВознагражденияУправляющего.ДатаРасчета = ПолучитьДатуРасчетаВознагражденияПоИИС();
		
		Отбор = Новый Структура("СчетДоверительногоУправления", ЭтотОбъект.КлиентДоверительногоУправления);
		
		ПакетДанныхПоРасчетуВознаграждения = РасчетВознагражденияУправляющего.ВыбратьДанныеПоРасчетуВознагражденияУправляющегоПоИИС(Отбор, Ложь, Ложь);
		
		Если ПакетДанныхПоРасчетуВознаграждения = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
			
		_ДанныеПоРасчетуВознаграждения = Новый Структура;
		_ДанныеПоРасчетуВознаграждения.Вставить("Вознаграждения", 											ПакетДанныхПоРасчетуВознаграждения.Вознаграждения.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВознагражденияПлатаЗаРазмещение", 							ПакетДанныхПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение.Выгрузить());	
		_ДанныеПоРасчетуВознаграждения.Вставить("ВводыАктивовЗаРасчетныйПериод", 							ПакетДанныхПоРасчетуВознаграждения.ВводыАктивовЗаРасчетныйПериод.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ВводыАктивовЗаПредрасчетныйПериод", 						ПакетДанныхПоРасчетуВознаграждения.ВводыАктивовЗаПредрасчетныйПериод.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("ОстаткиАктивовНаНачалоРасчетногоПериода", 					ПакетДанныхПоРасчетуВознаграждения.ОстаткиАктивовНаНачалоРасчетногоПериода.Выгрузить());
		_ДанныеПоРасчетуВознаграждения.Вставить("НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета",	ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийПлатаЗаРазмещениеДоДатыРасчета.Выгрузить());
		
		ЕстьНачисленияПоВознаграждению 					= ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийЗаРасчетныйПериод.Выгрузить().Количество() > 0;
		ЕстьНачисленияПоВознаграждениюПлатаЗаРазмещение = ПакетДанныхПоРасчетуВознаграждения.НачисленияВознагражденийПлатаЗаРазмещениеЗаРасчетныйПериод.Выгрузить().Количество() > 0; 
		
		ХранилищеДанныхРасшифровки = Новый ХранилищеЗначения(_ДанныеПоРасчетуВознаграждения);
		
		Если ЕстьНачисленияПоВознаграждению Тогда								
			ОбластьВознаграждениеУправляющего = РасчетВознагражденияУправляющего.СформироватьФормуРасчетаВознагражденияПоИИСДляФормы482(ЭтотОбъект.КлиентДоверительногоУправления, ХранилищеДанныхРасшифровки);
			ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Вознаграждение управляющего")));					
		КонецЕсли;	
		
		Если _ДанныеПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение.Количество() > 0 И ЕстьНачисленияПоВознаграждениюПлатаЗаРазмещение Тогда			
			Если Не ЕстьНачисленияПоВознаграждению Тогда
				ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Вознаграждение управляющего")));
			КонецЕсли;
			
			ОбластьПлатаЗаРазмещение = РасчетВознагражденияУправляющего.СформироватьФормуРасчетаВознагражденияПлатаЗаРазмещение(_ДанныеПоРасчетуВознаграждения.ВознагражденияПлатаЗаРазмещение, ХранилищеДанныхРасшифровки, Ложь);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
				
	Иначе		
		
		ОбластьВознаграждениеУправляющего = МакетОтчета.ПолучитьОбласть("РасчетВознагражденияУправляющего_ВПриложении");
		ОбластьВознаграждениеУправляющего.Параметры.ТекстОРасчетеВознаграждения = 
				?(ЭтотОбъект.Период.ДатаОкончания > ДатаДобавленияБлокаОБОсуществленииПраваГолосаПоЦеннымБумагам(), 
				"Расчет вознаграждения прилагается (при наличии)",
				"Расчет вознаграждения представлен в приложении N1 ""Расчет вознаграждения""");
		
	КонецЕсли;
	
	Если ОбластьПлатаЗаРазмещение <> Неопределено Тогда
		
		ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ВРег("Плата за размещение")));
		ТаблицаОтчета.НачатьГруппуСтрок();
		
		ТаблицаОтчета.Вывести(ОбластьПлатаЗаРазмещение);
		
		ТаблицаОтчета.ЗакончитьГруппуСтрок();
		
	КонецЕсли;

	Если ОбластьВознаграждениеУправляющего <> Неопределено Тогда
		
		ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 0, ?(КлиентЯвляетсяИИС, ВРег("Плата за управление"), ВРег("Вознаграждение управляющего"))));
				
		ТаблицаОтчета.НачатьГруппуСтрок();
		
		ТаблицаОтчета.Вывести(ОбластьВознаграждениеУправляющего);
		
		ТаблицаОтчета.ЗакончитьГруппуСтрок();
				
	КонецЕсли;	
		
КонецПроцедуры // ВывестиГруппуРасчетВознаграждения

Процедура ВывестиПодвалОтчета(МакетОтчета, ТаблицаОтчета, Запрос)
	
	НеотъемлемаяЧастьТребуется = ТребуетсяНеотъемлемаяЧасть(Запрос);
	ИмяОбластиНеотъемлемаяЧасть = "ПодвалНеотъемлемаяЧасть";
	
	Если ЭтотОбъект.ДокументПодписанЭЦП Тогда
		ОбластьПодвал = МакетОтчета.ПолучитьОбласть("ПодвалСЭЦП");
		
		РеквизитыСертификата = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.СертификатКлючаЭЦП, "СерийныйНомер, Субъект, НачалоДействия, ОкончаниеДействия, Организация");
		
		ОбластьПодвал.Параметры.СертификатЭЦП      = РеквизитыСертификата.СерийныйНомер;
		ОбластьПодвал.Параметры.СрокСертификатаЭЦП = "с " + Формат(РеквизитыСертификата.НачалоДействия, "ДФ=dd.MM.yyyy")
			+ " по " + Формат(РеквизитыСертификата.ОкончаниеДействия, "ДФ=dd.MM.yyyy");
		
		// Получим ФИО субъекта
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
			|	РеквизитыФизическихЛицСрезПоследних.Имя КАК Имя,
			|	РеквизитыФизическихЛицСрезПоследних.Отчество КАК Отчество
			|ИЗ
			|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних";
		
		Запрос.УстановитьПараметр("Период",    РеквизитыСертификата.НачалоДействия);
		Запрос.УстановитьПараметр("Организация",    РеквизитыСертификата.Организация);
		Запрос.УстановитьПараметр("ЮрФизЛицо", РеквизитыСертификата.Субъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОбластьПодвал.Параметры.ВладелецСертификатаЭЦП = Выборка.Фамилия + " " + Выборка.Имя + " " + Выборка.Отчество;
		КонецЕсли;
	Иначе
		ОбластьПодвал = МакетОтчета.ПолучитьОбласть("ПодвалБезЭЦП");
	КонецЕсли;
	
	ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант;
	ТаблицаОтчета.Вывести(ОбластьПодвал);
	
	Если НеотъемлемаяЧастьТребуется Тогда
		ТаблицаОтчета.Вывести(МакетОтчета.ПолучитьОбласть(ИмяОбластиНеотъемлемаяЧасть));
	КонецЕсли;
КонецПроцедуры // ВывестиПодвалОтчета

Функция ТребуетсяНеотъемлемаяЧасть(Запрос)
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ИСТИНА КАК Флаг
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, ) КАК КлиентыДУСрезПоследних
		|		ПО (КлиентыДУСрезПоследних.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|ГДЕ
		|	_СчетаДоверительногоУправления.Организация = &Организация
		|	И КлиентыДУСрезПоследних.Клиент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|	И _СчетаДоверительногоУправления.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			ИЗ
		|				РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(&КонецПериода, Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|					И Организация = &Организация) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних)";
	
	Запрос.УстановитьПараметр("Организация",  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // ТребуетсяНеотъемлемаяЧасть

Процедура ВывестиКонтрагентов(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ОбластьСтрока = МакетОтчета.ПолучитьОбласть("Контрагент");
	
	РезультатЗапроса = ВыбратьДействующихКонтрагентов(Запрос);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ТаблицаОтчета.Вывести(ОбластьСтрока);
	КонецЦикла;
	
КонецПроцедуры // ВывестиКонтрагентов

Процедура ВывестиПоказателиЗаГод(МакетОтчета, ТаблицаОтчета)
	
	// подготовим структуры данных для заполнения
	ТипПоляЗначения = Новый ОписаниеТипов("Строка"); //Метаданные.РегистрыСведений.ФинансовыеПоказатели.Ресурсы.Значение.Тип;
	
	СведенияОДинамикеДоходности = Новый ТаблицаЗначений;
	СведенияОДинамикеДоходности.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	СведенияОДинамикеДоходности.Колонки.Добавить("Значение", ТипПоляЗначения);
	
	СведенияОСтоимостиПортфеля  = Новый ТаблицаЗначений;
	СведенияОСтоимостиПортфеля.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	СведенияОСтоимостиПортфеля.Колонки.Добавить("Значение", ТипПоляЗначения);
	
	// подготовим общие наборы данных
	КлиентЯвляетсяИИС = ТипЗнч(ЭтотОбъект.КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления")
			И ЭтотОбъект.КлиентДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет;
			
	//Если КлиентЯвляетсяИИС Тогда
		// определим дату первого ввода д/с, с момента которого и будем считать показатели
		ДатаПервогоВвода = Дата(1,1,1);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыВыводыАктивовВВалютеУчета.Период), ДЕНЬ) КАК ДатаПервогоВвода
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			|ГДЕ
			|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
			|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|	И ВводыВыводыАктивовВВалютеУчета.Активность";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.КлиентДоверительногоУправления);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДатаПервогоВвода = Выборка.ДатаПервогоВвода;
		КонецЕсли;
		
	//КонецЕсли;		
			
	// отобразим наборы данных
	ДатаРасчета = ?(КонецМесяца(Период.ДатаОкончания) = Период.ДатаОкончания, КонецМесяца(Период.ДатаОкончания), ДобавитьМесяц(КонецМесяца(Период.ДатаОкончания), -1));
	ПредРезультатРасчета = Неопределено;
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
	Для Инд = 1 По 12 Цикл
		
		РезультатРасчета = Неопределено;
		
		Если ЗначениеЗаполнено(ДатаПервогоВвода) И ДатаПервогоВвода <= КонецМесяца(ДатаРасчета) Тогда //КлиентЯвляетсяИИС И
			
			Попытка
				// т.к. метод вываливается с ошибкой, если по клиенту не зарегистрирована стоимость активов на дату
				ПараметрыРасчета = Новый Структура;
				ПараметрыРасчета.Вставить("Организация",					ЭтотОбъект.Организация);
				ПараметрыРасчета.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.КлиентДоверительногоУправления);
				ПараметрыРасчета.Вставить("ДатаНачала",						Макс(ДатаПервогоВвода, НачалоМесяца(ДатаРасчета)));
				ПараметрыРасчета.Вставить("ДатаОкончания",					ДатаРасчета);
				ПараметрыРасчета.Вставить("РасшифровкаРасчета",				Истина);
				ПараметрыРасчета.Вставить("ВалютаРасчета",					ВалютаУчета);
				
				РезультатРасчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьУправления(ПараметрыРасчета);
				
			Исключение	
				
			КонецПопытки;
			
		КонецЕсли;
		
		// пересчитаем доходность в %-годовых в абс. доходность:
		Если РезультатРасчета <> Неопределено Тогда
			ДнейВГоду = (НачалоДня(КонецГода(ДатаРасчета)) - НачалоГода(ДатаРасчета)) / 86400 + 1;
			ДоходностьВПроцентахГодовых = РезультатРасчета.Доходность;
			АбсолютнаяДоходность = ДоходностьВПроцентахГодовых / ДнейВГоду * РезультатРасчета.КоличествоДнейВПериоде;
		Иначе
			ДоходностьВПроцентахГодовых = 0;
			АбсолютнаяДоходность = 0;
		КонецЕсли;
		
		НоваяСтрокаТаблицыПоказателей = СведенияОДинамикеДоходности.Добавить();
		НоваяСтрокаТаблицыПоказателей.Период   = ДатаРасчета;
		НоваяСтрокаТаблицыПоказателей.Значение = Формат(АбсолютнаяДоходность, "ЧДЦ=2; ЧН=-"); //Формат(ДоходностьВПроцентахГодовых, "ЧДЦ=2") + " / " + Формат(АбсолютнаяДоходность, "ЧДЦ=2");
		
		НоваяСтрокаТаблицыПоказателей = СведенияОСтоимостиПортфеля.Добавить();
		НоваяСтрокаТаблицыПоказателей.Период   = ДатаРасчета;
		
		Если РезультатРасчета <> Неопределено Тогда
			НоваяСтрокаТаблицыПоказателей.Значение = РезультатРасчета.СтоимостьАктивовНаКонец;
		Иначе
			Если ПредРезультатРасчета = Неопределено Тогда
				НоваяСтрокаТаблицыПоказателей.Значение = 0;
			Иначе
				НоваяСтрокаТаблицыПоказателей.Значение = ПредРезультатРасчета.СтоимостьАктивовНаНачало;
			КонецЕсли;
		КонецЕсли;
			
		ДатаРасчета = КонецМесяца(ДобавитьМесяц(ДатаРасчета, -1));
		
		ПредРезультатРасчета = РезультатРасчета;
				
	КонецЦикла;
	
	ВывестиТаблицуПоказателейЗаГод(МакетОтчета, ТаблицаОтчета, "Сведения о динамике доходности", СведенияОДинамикеДоходности);
	ВывестиТаблицуПоказателейЗаГод(МакетОтчета, ТаблицаОтчета, "Сведения о стоимости инвестиционного портфеля", СведенияОСтоимостиПортфеля);
	
КонецПроцедуры // ВывестиПоказателиЗаГод

Процедура ВывестиТаблицуПоказателейЗаГод(МакетОтчета, ТаблицаОтчета, Заголовок, ТаблицаПоказателей)
	
	ОбластьЗаголовка = ПолучитьЗаголовок(МакетОтчета, 1);
	ОбластьЗаголовка.Параметры.Заголовок = Заголовок;
	ТаблицаОтчета.Вывести(ОбластьЗаголовка);
	
	ОбластьШапка  = МакетОтчета.ПолучитьОбласть("ПоказателиЗаГод_ШапкаТаблицы|Показатель");
	ОбластьСтрока = МакетОтчета.ПолучитьОбласть("ПоказателиЗаГод_СтрокаТаблицы|Показатель");
	ОбластьПустая = МакетОтчета.ПолучитьОбласть("ПоказателиЗаГод_ШапкаТаблицы|Пустая");
	
	ТаблицаПоказателей.Сортировать("Период");
	
	// шапка
	ТаблицаОтчета.Вывести(ОбластьПустая);
	
	Для каждого СтрокаТаблицаПоказателей Из ТаблицаПоказателей Цикл
		ОбластьШапка.Параметры.Месяц = Формат(СтрокаТаблицаПоказателей.Период, "ДФ='ММММ гггг'");
		ТаблицаОтчета.Присоединить(ОбластьШапка);
	КонецЦикла;
	
	// строки
	ТаблицаОтчета.Вывести(ОбластьПустая);
	
	Для каждого СтрокаТаблицаПоказателей Из ТаблицаПоказателей Цикл
		ОбластьСтрока.Параметры.Значение = СтрокаТаблицаПоказателей.Значение;
		ТаблицаОтчета.Присоединить(ОбластьСтрока);
	КонецЦикла;
	
КонецПроцедуры // ВывестиТаблицуПоказателейЗаГод

Процедура ВывестиОстаткиДенежныхСредств(МакетОтчета, ТаблицаОтчета, Запрос, ОбщаяСтоимостьАктивов)
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДС.КлючМестаХранения КАК КлючМестаХранения,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК МестоХранения,
		|	ОстаткиДС.Валюта КАК Валюта,
		|	_КурсыВалют.Курс,
		|	СУММА(ОстаткиДС.СуммаВалюта) КАК СуммаВВалюте,
		|	СУММА(ОстаткиДС.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|ИЗ
		|	(
		|		ВЫБРАТЬ
		|			0 КАК КлючМестаХранения,
		|			ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|			_СтоимостьАктивовНеЦБ.Валюта КАК Валюта,
		|			СУММА(_СтоимостьАктивовНеЦБ.СуммаРынок) КАК СуммаВалюта,
		|			СУММА(_СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета) КАК СуммаВВалютеУчета
		|		ИЗ
		|			_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
		|		ГДЕ
		|			_СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|		СГРУППИРОВАТЬ ПО
		|			ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо,		
		|			_СтоимостьАктивовНеЦБ.Валюта
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			1 КАК КлючМестаХранения,
		|			ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.БрокерскиеКомпании).ЮрФизЛицо КАК ЮрФизЛицо,
		|			_СтоимостьАктивовНеЦБ.Валюта КАК Валюта,
		|			СУММА(_СтоимостьАктивовНеЦБ.СуммаРынок) КАК СуммаВалюта,
		|			СУММА(_СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета) КАК СуммаРубли
		|		ИЗ
		|			_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
		|		ГДЕ
		|			_СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.БрокерскиеКомпании
		|		СГРУППИРОВАТЬ ПО
		|			ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.БрокерскиеКомпании).ЮрФизЛицо,
		|			_СтоимостьАктивовНеЦБ.Валюта
		|	) КАК ОстаткиДС
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _КурсыВалют.Валюта = ОстаткиДС.Валюта
		|			И _КурсыВалют.Период = &КонецПериодаНачалоДня
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&КонецПериода, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ОстаткиДС.ЮрФизЛицо
		|
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу,
		|	ОстаткиДС.КлючМестаХранения,
		|	ОстаткиДС.Валюта,
		|	_КурсыВалют.Курс
		|
		|УПОРЯДОЧИТЬ ПО
		|	КлючМестаХранения,
		|	Валюта,
		|	МестоХранения
		|ИТОГИ ПО
		|	КлючМестаХранения
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если ТаблицаОтчета <> Неопределено Тогда
		ОбластьЗаголовка = ПолучитьЗаголовок(МакетОтчета, 1);
		ОбластьЗаголовка.Параметры.Заголовок = ВРег("Денежные средства");
		ТаблицаОтчета.Вывести(ОбластьЗаголовка);
		
		ОбластьИтога = МакетОтчета.ПолучитьОбласть("Итог_Уровень1");
		ОбластьИтога.Параметры.Итог = "Итого: ??? руб.";
		ТаблицаОтчета.Вывести(ОбластьИтога);
		
		НомерСтрокиИтогаПоДенежнымСредствам = ТаблицаОтчета.ВысотаТаблицы;
	КонецЕсли;
	
	ИтогоДенежныхСредствВВалютеУчета = 0;
	
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок");
	ОбластиТаблицы.Вставить("ШапкаТаблицы",  МакетОтчета.ПолучитьОбласть("ДенежныеСредства_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("ДенежныеСредства_СтрокаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаИтого",   МакетОтчета.ПолучитьОбласть("ДенежныеСредства_Итого"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОписаниеМестаХранения = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОписаниеМестаХранения.Следующий() Цикл
		
		Если ВыборкаОписаниеМестаХранения.КлючМестаХранения = 0 Тогда
			ОбластиТаблицы.ШапкаТаблицы.Параметры.МестоХранения = "Банк";
			ОбластиТаблицы.Заголовок = ПолучитьЗаголовок(МакетОтчета, 3, "На расчетных счетах");
		Иначе
			ОбластиТаблицы.ШапкаТаблицы.Параметры.МестоХранения = "Брокер";
			ОбластиТаблицы.Заголовок = ПолучитьЗаголовок(МакетОтчета, 3, "На брокерских счетах");
		КонецЕсли;
		
		ИтогоДенежныхСредствВВалютеУчета = ИтогоДенежныхСредствВВалютеУчета
			+ ВывестиТаблицуОтчета(ВыборкаОписаниеМестаХранения.Выбрать(), ТаблицаОтчета, ОбластиТаблицы).СуммаВВалютеУчета;
		
		Если РасшифровкаСтоимостиПортфеля <> Неопределено Тогда
			Выборка = ВыборкаОписаниеМестаХранения.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ВыборкаОписаниеМестаХранения.КлючМестаХранения = 0 Тогда
					ДобавитьСтрокуВРасшифровкаСтоимостиПортфеля("Денежные ср-ва на расчетных счетах", Выборка.Валюта, Выборка.СуммаВВалютеУчета, "" + Выборка.МестоХранения + ", " + Выборка.СуммаВВалюте);
				ИначеЕсли ВыборкаОписаниеМестаХранения.КлючМестаХранения = 1 Тогда
					ДобавитьСтрокуВРасшифровкаСтоимостиПортфеля("Денежные ср-ва на брокерских счетах", Выборка.Валюта, Выборка.СуммаВВалютеУчета, "" + Выборка.МестоХранения + ", " + Выборка.СуммаВВалюте);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщаяСтоимостьАктивов = ОбщаяСтоимостьАктивов + ИтогоДенежныхСредствВВалютеУчета;
	
	Если ТаблицаОтчета <> Неопределено Тогда
		ТаблицаОтчета.Область(НомерСтрокиИтогаПоДенежнымСредствам, 2).Текст = "Итого: " + Формат(ИтогоДенежныхСредствВВалютеУчета, "ЧДЦ=2") + " руб.";
	КонецЕсли;
КонецПроцедуры //ВывестиОстаткиДенежныхСредств

Процедура ВывестиОстаткиЦенныхБумаг(МакетОтчета, ТаблицаОтчета, Запрос, ОбщаяСтоимостьАктивов)
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НЕОПРЕДЕЛЕНО КАК ПодгруппаУчета,
		|	_СтоимостьЦБ.ЦеннаяБумага КАК ФинВложение,
		|	НЕОПРЕДЕЛЕНО КАК ОснованиеЗадолженности,
		|	ВЫБОР
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акции""
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				И ВЫРАЗИТЬ(_СтоимостьЦБ.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала <> &ВалютаУчета
		|			ТОГДА ""Еврооблигации""
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигации""
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""Паи""
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ""ДепозитарныеРасписки""
		|		КОГДА _СтоимостьЦБ.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|				И ВЫРАЗИТЬ(_СтоимостьЦБ.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|			ТОГДА ""Фьючерсы""
		|	КОНЕЦ КАК ВидФинВложения,
		|	_СтоимостьЦБ.ЦеннаяБумага.Эмитент КАК Эмитент,
		|	_СтоимостьЦБ.ЦеннаяБумага.ВалютаНоминала КАК ВалютаКотировки,
		|	_СтоимостьЦБ.Количество КАК Количество,
		|	_СтоимостьЦБ.СправедливаяЦена КАК Цена,
		|	_СтоимостьЦБ.Сумма КАК Стоимость,
		|	_СтоимостьЦБ.СуммаВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	_СтоимостьЦБ.СуммаКупона / _СтоимостьЦБ.Количество КАК ЦенаНКД,
		|	_СтоимостьЦБ.СуммаКупона КАК СтоимостьКупона,
		|	_СтоимостьЦБ.СуммаКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	NULL КАК СтоимостьПроцентов,
		|	NULL КАК СтоимостьПроцентовВВалютеУчета,
		|	_СтоимостьЦБ.СуммаКупона + _СтоимостьЦБ.Сумма КАК СтоимостьВсего,
		|	_СтоимостьЦБ.СуммаКупонаВВалютеУчета + _СтоимостьЦБ.СуммаВВалютеУчета КАК СтоимостьВсегоВВалютеУчета
		|ИЗ
		|	_СтоимостьЦБ КАК _СтоимостьЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО,
		|	_СтоимостьАктивовНеЦБ.СубъектАналитики,
		|	НЕОПРЕДЕЛЕНО,
		|	""Депозиты"",
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				ТОГДА _СтоимостьАктивовНеЦБ.СуммаРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				ТОГДА _СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	NULL,
		|	NULL,
		|	NULL,
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладуПроценты)
		|				ТОГДА _СтоимостьАктивовНеЦБ.СуммаРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладуПроценты)
		|				ТОГДА _СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(_СтоимостьАктивовНеЦБ.СуммаРынок),
		|	СУММА(_СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета)
		|ИЗ
		|	_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
		|ГДЕ
		|	_СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьАктивовНеЦБ.СубъектАналитики
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО,
		|	_СтоимостьАктивовНеЦБ.СубъектАналитики,
		|	НЕОПРЕДЕЛЕНО,
		|	""СВОП"",
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	1,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	NULL,
		|	NULL,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
		|ГДЕ
		|	_СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ПрочиеАктивы)
		|	И _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Документ.СделкаСПФИ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидФинВложения,
		|	Эмитент,
		|	ФинВложение
		|ИТОГИ ПО
		|	ПодгруппаУчета,
		|	ВидФинВложения
		|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецОбласти
	ОбщаяСтоимостьАктивов = ОбщаяСтоимостьАктивов
		+ ВывестиОбластиФинВложений("Финансовые вложения", МакетОтчета, ТаблицаОтчета, Запрос);
КонецПроцедуры // ВывестиОстаткиИЗадолженностиЦенныхБумаг

Процедура ВывестиЗадолженностиПоДенежнымСредствам(МакетОтчета, ТаблицаОтчета, Запрос, ОбщаяСтоимостьАктивов)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	               |	КОНЕЦ КАК ТипЗадолженности,
	               |	_СтоимостьАктивовНеЦБ.ВидЗадолженности КАК ВидЗадолженности,
	               |	_СтоимостьАктивовНеЦБ.Валюта КАК Валюта,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
	               |			ТОГДА _СтоимостьАктивовНеЦБ.Контрагент
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Документ.МНО
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Документ.МНО).РасчетныйСчет.Банк.ЮрФизЛицо
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание ССЫЛКА Документ.СделкаРЕПО
	               |				И ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.СделкаРЕПО).Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.СделкаРЕПО).Контрагент
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание ССЫЛКА Документ.СделкаРЕПО
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.СделкаРЕПО).КонтрагентНаБирже
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание ССЫЛКА Документ.Сделка
	               |				И ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.Сделка).Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.Сделка).Контрагент
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание ССЫЛКА Документ.Сделка
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.Сделка).КонтрагентНаБирже
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание ССЫЛКА Документ.НачислениеЗадолженности
	               |			ТОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.Основание КАК Документ.НачислениеЗадолженности).Контрагент
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Комиссия))
	               |			ТОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Документ.МНО
	               |			ТОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики
	               |		КОГДА _СтоимостьАктивовНеЦБ.Основание = НЕОПРЕДЕЛЕНО
	               |			ТОГДА _СтоимостьАктивовНеЦБ.ВидЗадолженности
	               |		ИНАЧЕ _СтоимостьАктивовНеЦБ.Основание
	               |	КОНЕЦ КАК ОснованиеЗадолженности,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА _СтоимостьАктивовНеЦБ.СуммаРынок
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОжидаемыеСредства,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
	               |			ТОГДА -_СтоимостьАктивовНеЦБ.СуммаРынок
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК БлокированныеСредства,
	               |	_СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета КАК СредстваВВалютеУчета
	               |ПОМЕСТИТЬ _ЗадолженностиПоДенежнымСредствам
	               |ИЗ
	               |	_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
	               |		ПО _СтоимостьАктивовНеЦБ.Основание = СделкаРЕПО.Ссылка
	               |ГДЕ
	               |	_СтоимостьАктивовНеЦБ.ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
	               |	И НЕ(_СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.БрокерскиеКомпании
	               |				И _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность))
	               |	И НЕ(_СтоимостьАктивовНеЦБ.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке))
	               |				И ВЫБОР
	               |					КОГДА &ОпределятьЗадолженностьРЕПОВидуСделки
	               |							И _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
	               |						ТОГДА НЕ(ЕСТЬNULL(СделкаРЕПО.ВидСделки, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	               |										И _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |									ИЛИ ЕСТЬNULL(СделкаРЕПО.ВидСделки, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	               |										И _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
	               |					ИНАЧЕ НЕ _СтоимостьАктивовНеЦБ.СубъектАналитики = НЕОПРЕДЕЛЕНО
	               |				КОНЕЦ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.ОснованиеЗадолженности КАК ОснованиеЗадолженностиРасшифровка,
	               |	_ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
	               |	_ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
	               |	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, _ЗадолженностиПоДенежнымСредствам.Контрагент) КАК КонтрагентКраткоеНаименованиеПоУставу,
	               |	СУММА(_ЗадолженностиПоДенежнымСредствам.ОжидаемыеСредства) КАК ОжидаемыеСредства,
	               |	СУММА(_ЗадолженностиПоДенежнымСредствам.БлокированныеСредства) КАК БлокированныеСредства,
	               |	СУММА(_ЗадолженностиПоДенежнымСредствам.СредстваВВалютеУчета) КАК СредстваВВалютеУчета
	               |ИЗ
	               |	_ЗадолженностиПоДенежнымСредствам КАК _ЗадолженностиПоДенежнымСредствам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	               |				&КонецПериода,
	               |				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	               |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	               |					И ЮрФизЛицо В
	               |						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |							_ЗадолженностиПоДенежнымСредствам.Контрагент
	               |						ИЗ
	               |							_ЗадолженностиПоДенежнымСредствам)) КАК РеквизитыЮридическихЛицСрезПоследних
	               |		ПО (РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = _ЗадолженностиПоДенежнымСредствам.Контрагент)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ЗадолженностиПоДенежнымСредствам.ТипЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.ВидЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.ОснованиеЗадолженности,
	               |	_ЗадолженностиПоДенежнымСредствам.Валюта,
	               |	_ЗадолженностиПоДенежнымСредствам.Контрагент,
	               |	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, _ЗадолженностиПоДенежнымСредствам.Контрагент),
	               |	_ЗадолженностиПоДенежнымСредствам.ОснованиеЗадолженности
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОснованиеЗадолженности";
	
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, ВРег("Задолженность по денежным средствам")));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("ЗадолженностиПоДенежнымСредствам_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("ЗадолженностиПоДенежнымСредствам_СтрокаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаИтого", МакетОтчета.ПолучитьОбласть("ЗадолженностиПоДенежнымСредствам_Итого"));
	
	Выборка = ПолучитьИсточникДанных(Запрос, ТекстЗапроса);
	
	ОбщаяСтоимостьАктивов = ОбщаяСтоимостьАктивов +
		ВывестиТаблицуОтчета(Выборка, ТаблицаОтчета, ОбластиТаблицы).СредстваВВалютеУчета;
		
	Выборка.Сбросить();
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуВРасшифровкаСтоимостиПортфеля(Выборка.ВидЗадолженности, Выборка.Контрагент, Выборка.СредстваВВалютеУчета, "" + Выборка.Валюта + ", +" + Выборка.ОжидаемыеСредства + ", -" + Выборка.БлокированныеСредства);
	КонецЦикла;
	
КонецПроцедуры // ВывестиЗадолженностиПоДенежнымСредствам

Процедура ВывестиЗадолженностиЦенныхБумаг(МакетОтчета, ТаблицаОтчета, Запрос, ОбщаяСтоимостьАктивов)
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	               |	КОНЕЦ КАК ТипЗадолженности,
	               |	_СтоимостьАктивовНеЦБ.СубъектАналитики КАК ЦеннаяБумага,
	               |	_СтоимостьАктивовНеЦБ.СубъектАналитики.Эмитент КАК Эмитент,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.Акции
	               |			ТОГДА ""Акции""
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.Облигации
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.Облигации).ВалютаНоминала <> &ВалютаУчета
	               |						ТОГДА ""Еврооблигации""
	               |					ИНАЧЕ ""Облигации""
	               |				КОНЕЦ
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.Паи
	               |			ТОГДА ""Паи""
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.ДепозитарныеРасписки
	               |			ТОГДА ""ДепозитарныеРасписки""
	               |		КОГДА _СтоимостьАктивовНеЦБ.СубъектАналитики ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
	               |				И ВЫРАЗИТЬ(_СтоимостьАктивовНеЦБ.СубъектАналитики КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
	               |			ТОГДА ""Фьючерсы""
	               |	КОНЕЦ КАК ВидЦенныхБумаг,
	               |	_СтоимостьАктивовНеЦБ.Валюта КАК Валюта,
	               |	_СтоимостьАктивовНеЦБ.Основание КАК ОснованиеЗадолженности,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА 1
	               |		ИНАЧЕ -1
	               |	КОНЕЦ * _СтоимостьАктивовНеЦБ.СуммаРынок КАК Стоимость,
	               |	ВЫБОР
	               |		КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА 1
	               |		ИНАЧЕ -1
	               |	КОНЕЦ * _СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета КАК СтоимостьВВалютеУчета
	               |ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагам
	               |ИЗ
	               |	_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
	               |		ПО _СтоимостьАктивовНеЦБ.Основание = СделкаРЕПО.Ссылка
	               |ГДЕ
	               |	_СтоимостьАктивовНеЦБ.ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность))
	               |	И _СтоимостьАктивовНеЦБ.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке))
	               |	И НЕ _СтоимостьАктивовНеЦБ.СубъектАналитики = НЕОПРЕДЕЛЕНО
	               |	И ВЫБОР
	               |			КОГДА &ОпределятьЗадолженностьРЕПОВидуСделки
	               |					И _СтоимостьАктивовНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
	               |				ТОГДА ЕСТЬNULL(СделкаРЕПО.ВидСделки, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	               |							И _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |						ИЛИ ЕСТЬNULL(СделкаРЕПО.ВидСделки, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	               |							И _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ЗадолженностиПоЦеннымБумагам.ТипЗадолженности КАК ПодгруппаУчета,
	               |	_ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага КАК ФинВложение,
	               |	_ЗадолженностиПоЦеннымБумагам.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
	               |	_ЗадолженностиПоЦеннымБумагам.ВидЦенныхБумаг КАК ВидФинВложения,
	               |	_ЗадолженностиПоЦеннымБумагам.Валюта КАК ВалютаКотировки,
	               |	_ЗадолженностиПоЦеннымБумагам.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
	               |	_ЗадолженностиПоЦеннымБумагам.СтоимостьВВалютеУчета КАК СтоимостьВсегоВВалютеУчета,
	               |	ЕСТЬNULL(ЗадолженностиПоЦБОстатки.КоличествоОстаток, ЗадолженностиПоРЕПООстатки.КоличествоОстаток) КАК Количество,
	               |	_ЗадолженностиПоЦеннымБумагам.СтоимостьВВалютеУчета / ЕСТЬNULL(ЗадолженностиПоЦБОстатки.КоличествоОстаток, ЗадолженностиПоРЕПООстатки.КоличествоОстаток) КАК Цена
	               |ИЗ
	               |	_ЗадолженностиПоЦеннымБумагам КАК _ЗадолженностиПоЦеннымБумагам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
	               |				&Период,
	               |				Организация = &Организация
	               |					И СчетДоверительногоУправления В
	               |						(ВЫБРАТЬ
	               |							Т.СчетДоверительногоУправления
	               |						ИЗ
	               |							_СчетаДоверительногоУправления КАК Т)) КАК ЗадолженностиПоЦБОстатки
	               |		ПО (ЗадолженностиПоЦБОстатки.Основание = _ЗадолженностиПоЦеннымБумагам.ОснованиеЗадолженности)
	               |			И (ЗадолженностиПоЦБОстатки.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага)
	               |			И (ЗадолженностиПоЦБОстатки.ТипЗадолженности = _ЗадолженностиПоЦеннымБумагам.ТипЗадолженности)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
	               |				&Период,
	               |				Организация = &Организация
	               |					И СчетДоверительногоУправления В
	               |						(ВЫБРАТЬ
	               |							Т.СчетДоверительногоУправления
	               |						ИЗ
	               |							_СчетаДоверительногоУправления КАК Т)) КАК ЗадолженностиПоРЕПООстатки
	               |		ПО (ЗадолженностиПоРЕПООстатки.СделкаРЕПО = _ЗадолженностиПоЦеннымБумагам.ОснованиеЗадолженности)
	               |			И (ЗадолженностиПоРЕПООстатки.ЦеннаяБумага = _ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага)
	               |			И (ЗадолженностиПоРЕПООстатки.ТипЗадолженности = _ЗадолженностиПоЦеннымБумагам.ТипЗадолженности)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидФинВложения,
	               |	_ЗадолженностиПоЦеннымБумагам.Эмитент,
	               |	_ЗадолженностиПоЦеннымБумагам.ЦеннаяБумага
	               |ИТОГИ ПО
	               |	ПодгруппаУчета,
	               |	ВидФинВложения
	               |АВТОУПОРЯДОЧИВАНИЕ";

	ОбщаяСтоимостьАктивов = ОбщаяСтоимостьАктивов 
		+ ВывестиОбластиФинВложений("Задолженность по ценным бумагам", МакетОтчета, ТаблицаОтчета, Запрос);
	
КонецПроцедуры // ВывестиЗадолженностиЦенныхБумаг

Процедура ВывестиСделки(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделок.Сделка КАК Сделка,
		|	УсловияСделок.ЦеннаяБумага КАК ФинВложение,
		|	УсловияСделок.Период КАК ДатаСделки,
		|	ВЫБОР
		|		КОГДА УсловияСделок.Регистратор ССЫЛКА Документ.ИзменениеУсловийСделки
		|			ТОГДА УсловияСделок.Период
		|		КОГДА УсловияСделок.Сделка.ВремяСделки = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА УсловияСделок.Сделка.Дата
		|		ИНАЧЕ УсловияСделок.Сделка.ВремяСделки
		|	КОНЕЦ КАК ВремяСделки,
		|	УсловияСделок.Сделка.ВидСделки КАК ВидСделки,
		|	УсловияСделок.Сделка.МестоХранения КАК МестоЗаключенияСделки,
		|	УсловияСделок.Сделка.ВалютаСделки КАК ВалютаСделки,
		|	УсловияСделок.ВалютаОплаты КАК ВалютаОплаты,
		|	УсловияСделок.Количество КАК Количество,
		|	УсловияСделок.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделок.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделок.Цена КАК Цена,
		|	ВЫБОР
		|		КОГДА УсловияСделок.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА УсловияСделок.ЦенаКупона
		|	КОНЕЦ КАК ЦенаКупона,
		|	УсловияСделок.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА УсловияСделок.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА УсловияСделок.СуммаКупона
		|	КОНЕЦ КАК СуммаКупона,
		|	УсловияСделок.Сумма + УсловияСделок.СуммаКупона КАК СуммаВсего,
		|	(УсловияСделок.Сумма + УсловияСделок.СуммаКупона) * _КурсыВалютыСделки.Курс / _КурсыВалютыОплаты.Курс КАК СуммаВсегоВВалютеОплаты,
		|	ВЫБОР
		|		КОГДА УсловияСделок.Регистратор ССЫЛКА Документ.ИзменениеУсловийСделки
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоИзменениеСделки,
		|	УсловияСделок.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.УсловияСделок КАК УсловияСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыСделки
		|		ПО УсловияСделок.Сделка.ВалютаСделки = _КурсыВалютыСделки.Валюта
		|			И (НАЧАЛОПЕРИОДА(УсловияСделок.ДатаОплаты, ДЕНЬ) = _КурсыВалютыСделки.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыОплаты
		|		ПО УсловияСделок.ВалютаОплаты = _КурсыВалютыОплаты.Валюта
		|			И (НАЧАЛОПЕРИОДА(УсловияСделок.ДатаОплаты, ДЕНЬ) = _КурсыВалютыОплаты.Период)
		|ГДЕ
		|	УсловияСделок.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И УсловияСделок.Организация = &Организация
		|	И НЕ УсловияСделок.Отменено
		|	И УсловияСделок.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияСделок.Период,
		|	УсловияСделок.Регистратор";
	
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Сделки"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_Сделки_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_Сделки_СтрокаТаблицы"));
	
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиСделки

Процедура ВывестиСделкиРЕПО(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокРЕПО.Организация КАК Организация,
		|	УсловияСделокРЕПО.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПО.Рынок КАК Рынок,
		|	УсловияСделокРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокРЕПО.Период КАК Период,
		|	УсловияСделокРЕПО.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ _ВсеЗаписиБезПериода
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|ГДЕ
		|	УсловияСделокРЕПО.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ УсловияСделокРЕПО.Отменено
		|	И УсловияСделокРЕПО.Активность
		|	И УсловияСделокРЕПО.Организация = &Организация
		|	И УсловияСделокРЕПО.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	СделкаРЕПО,
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЗаписи.Организация КАК Организация,
		|	_ВсеЗаписи.СделкаРЕПО КАК СделкаРЕПО,
		|	_ВсеЗаписи.Рынок КАК Рынок,
		|	_ВсеЗаписи.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеЗаписи.Период КАК Период,
		|	_ВсеЗаписи.Регистратор КАК Регистратор,
		|	МИНИМУМ(ЕСТЬNULL(_ВсеЗаписиДляСоединения.Период, &Период)) КАК СледующийПериод
		|ПОМЕСТИТЬ _ВсеЗаписи
		|ИЗ
		|	_ВсеЗаписиБезПериода КАК _ВсеЗаписи
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЗаписиБезПериода КАК _ВсеЗаписиДляСоединения
		|		ПО _ВсеЗаписи.Организация = _ВсеЗаписиДляСоединения.Организация
		|			И _ВсеЗаписи.СделкаРЕПО = _ВсеЗаписиДляСоединения.СделкаРЕПО
		|			И _ВсеЗаписи.Рынок = _ВсеЗаписиДляСоединения.Рынок
		|			И _ВсеЗаписи.ЦеннаяБумага = _ВсеЗаписиДляСоединения.ЦеннаяБумага
		|			И _ВсеЗаписи.Период < _ВсеЗаписиДляСоединения.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЗаписи.Организация,
		|	_ВсеЗаписи.СделкаРЕПО,
		|	_ВсеЗаписи.Рынок,
		|	_ВсеЗаписи.ЦеннаяБумага,
		|	_ВсеЗаписи.Период,
		|	_ВсеЗаписи.Регистратор
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	СделкаРЕПО,
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СделкаРЕПО КАК СделкаРЕПО,
		|	ВложенныйЗапрос.Рынок КАК Рынок,
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.Период КАК Период,
		|	ВложенныйЗапрос.Регистратор КАК Регистратор,
		|	ВложенныйЗапрос.ПериодПервойЧасти КАК ПериодПервойЧасти,
		|	МАКСИМУМ(УсловияСделокРЕПО.Регистратор) КАК РегистраторПервойЧасти
		|ПОМЕСТИТЬ _СделкиПервойЧасти
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеЗаписи.Организация КАК Организация,
		|		_ВсеЗаписи.СделкаРЕПО КАК СделкаРЕПО,
		|		_ВсеЗаписи.Рынок КАК Рынок,
		|		_ВсеЗаписи.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ВсеЗаписи.Период КАК Период,
		|		_ВсеЗаписи.Регистратор КАК Регистратор,
		|		МАКСИМУМ(УсловияСделокРЕПО.Период) КАК ПериодПервойЧасти
		|	ИЗ
		|		_ВсеЗаписи КАК _ВсеЗаписи
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|			ПО _ВсеЗаписи.Организация = УсловияСделокРЕПО.Организация
		|				И _ВсеЗаписи.СделкаРЕПО = УсловияСделокРЕПО.СделкаРЕПО
		|				И (УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1)
		|				И _ВсеЗаписи.Рынок = УсловияСделокРЕПО.Рынок
		|				И _ВсеЗаписи.ЦеннаяБумага = УсловияСделокРЕПО.ЦеннаяБумага
		|				И _ВсеЗаписи.СледующийПериод > УсловияСделокРЕПО.Период
		|				И (НЕ УсловияСделокРЕПО.Отменено)
		|				И (УсловияСделокРЕПО.Активность)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеЗаписи.Регистратор,
		|		_ВсеЗаписи.Период,
		|		_ВсеЗаписи.ЦеннаяБумага,
		|		_ВсеЗаписи.Рынок,
		|		_ВсеЗаписи.СделкаРЕПО,
		|		_ВсеЗаписи.Организация) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|		ПО ВложенныйЗапрос.Организация = УсловияСделокРЕПО.Организация
		|			И ВложенныйЗапрос.СделкаРЕПО = УсловияСделокРЕПО.СделкаРЕПО
		|			И (УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1)
		|			И ВложенныйЗапрос.Рынок = УсловияСделокРЕПО.Рынок
		|			И ВложенныйЗапрос.ЦеннаяБумага = УсловияСделокРЕПО.ЦеннаяБумага
		|			И ВложенныйЗапрос.ПериодПервойЧасти = УсловияСделокРЕПО.Период
		|			И (НЕ УсловияСделокРЕПО.Отменено)
		|			И (УсловияСделокРЕПО.Активность)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.ПериодПервойЧасти,
		|	ВложенныйЗапрос.Регистратор,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.СделкаРЕПО,
		|	ВложенныйЗапрос.Рынок,
		|	ВложенныйЗапрос.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	СделкаРЕПО,
		|	Рынок,
		|	ЦеннаяБумага,
		|	Регистратор,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СделкаРЕПО КАК СделкаРЕПО,
		|	ВложенныйЗапрос.Рынок КАК Рынок,
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.Период КАК Период,
		|	ВложенныйЗапрос.Регистратор КАК Регистратор,
		|	ВложенныйЗапрос.ПериодВторойЧасти КАК ПериодВторойЧасти,
		|	МАКСИМУМ(УсловияСделокРЕПО.Регистратор) КАК РегистраторВторойЧасти
		|ПОМЕСТИТЬ _СделкиВторойЧасти
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеЗаписи.Организация КАК Организация,
		|		_ВсеЗаписи.СделкаРЕПО КАК СделкаРЕПО,
		|		_ВсеЗаписи.Рынок КАК Рынок,
		|		_ВсеЗаписи.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ВсеЗаписи.Период КАК Период,
		|		_ВсеЗаписи.Регистратор КАК Регистратор,
		|		МАКСИМУМ(УсловияСделокРЕПО.Период) КАК ПериодВторойЧасти
		|	ИЗ
		|		_ВсеЗаписи КАК _ВсеЗаписи
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|			ПО _ВсеЗаписи.Организация = УсловияСделокРЕПО.Организация
		|				И _ВсеЗаписи.СделкаРЕПО = УсловияСделокРЕПО.СделкаРЕПО
		|				И (УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2)
		|				И _ВсеЗаписи.Рынок = УсловияСделокРЕПО.Рынок
		|				И _ВсеЗаписи.ЦеннаяБумага = УсловияСделокРЕПО.ЦеннаяБумага
		|				И _ВсеЗаписи.СледующийПериод > УсловияСделокРЕПО.Период
		|				И (НЕ УсловияСделокРЕПО.Отменено)
		|				И (УсловияСделокРЕПО.Активность)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеЗаписи.Регистратор,
		|		_ВсеЗаписи.Период,
		|		_ВсеЗаписи.ЦеннаяБумага,
		|		_ВсеЗаписи.Рынок,
		|		_ВсеЗаписи.СделкаРЕПО,
		|		_ВсеЗаписи.Организация) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|		ПО ВложенныйЗапрос.Организация = УсловияСделокРЕПО.Организация
		|			И ВложенныйЗапрос.СделкаРЕПО = УсловияСделокРЕПО.СделкаРЕПО
		|			И (УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2)
		|			И ВложенныйЗапрос.Рынок = УсловияСделокРЕПО.Рынок
		|			И ВложенныйЗапрос.ЦеннаяБумага = УсловияСделокРЕПО.ЦеннаяБумага
		|			И ВложенныйЗапрос.ПериодВторойЧасти = УсловияСделокРЕПО.Период
		|			И (НЕ УсловияСделокРЕПО.Отменено)
		|			И (УсловияСделокРЕПО.Активность)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.ПериодВторойЧасти,
		|	ВложенныйЗапрос.Регистратор,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.СделкаРЕПО,
		|	ВложенныйЗапрос.Рынок,
		|	ВложенныйЗапрос.ЦеннаяБумага
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	СделкаРЕПО,
		|	Рынок,
		|	ЦеннаяБумага,
		|	Период,
		|	Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЗаписи.Организация КАК Организация,
