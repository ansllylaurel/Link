Функция ПолучитьДатуРасчетаВознагражденияПоИИС()
	
	// Если ИИС не закрыт, возвращаем текущую дату расчета
	ДатаРасторжения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.КлиентДоверительногоУправления, "ДатаРасторжения");
	Если ДатаРасторжения > ЭтотОбъект.Период.ДатаОкончания Или ДатаРасторжения = '00010101' Тогда
		Возврат ЭтотОбъект.Период.ДатаОкончания;
	КонецЕсли;
	
	// Определим дату последнего начисления задолженности по вознаграждению управляющего 	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(МАКСИМУМ(ЗадолженностиПоДенежнымСредствамОбороты.Период), &КонецПериода) КАК Дата
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			&КонецПериода,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.Типызадолженности.Кредиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)) КАК ЗадолженностиПоДенежнымСредствамОбороты";
	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.КлиентДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат НачалоДня(Выборка.Дата);
	КонецЕсли;
	
	Возврат ЭтотОбъект.Период.ДатаОкончания;
	
КонецФункции

