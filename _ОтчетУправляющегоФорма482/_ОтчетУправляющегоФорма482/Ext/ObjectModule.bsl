Процедура ПроверитьРегистрациюСЧАПоВыбраннымСчетам(Запрос)
	Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Организация,
		|	Т.СчетДоверительногоУправления,
		|	Т.ЦельРасчета,
		|	Т.ВидУчета
		|ИЗ
		|	_СчетаДоверительногоУправления КАК Т
		|"; 
	СчетаДУКлиента = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СчетДУ Из СчетаДУКлиента Цикл
		Если Не ПроверитьРегистрациюСЧА(СчетДУ.Организация, СчетДУ.СчетДоверительногоУправления, СчетДУ.ЦельРасчета, СчетДУ.ВидУчета, Запрос.Параметры.КонецПериодаНачалоДня) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На " + Формат(Запрос.Параметры.КонецПериода, "ДФ=dd.MM.yyyy") + " не выполнена регистрация стоимости активов для '" + Строка(СчетДУ.СчетДоверительногоУправления) + "'. Данные об остатках выведены не будут.");		
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

// Должна быть хоть одна запись в регистрах либо проведенные документы
Функция ПроверитьРегистрациюСЧА(Организация, СчетДоверительногоУправления, ЦельРасчета, ВидУчета, Период)
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	""ЦенныеБумаги""
		|ИЗ
		|	(
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть данные в регистре"" КАК Запись 
		|		ИЗ
		|			РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки 
		|		ГДЕ
		|			СтоимостьПереоценки.Организация = &Организация
		|			И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|			И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|			И СтоимостьПереоценки.Период = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть проведенный документ"" КАК Запись 
		|		ИЗ
		|			Документ.РегистрацияСтоимостиПереоценки КАК СтоимостьПереоценки 
		|		ГДЕ
		|			СтоимостьПереоценки.Организация = &Организация
		|			И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|			И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|			И НАЧАЛОПЕРИОДА(СтоимостьПереоценки.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|			И СтоимостьПереоценки.Проведен
		|	) КАК ЦенныеБумаги
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	""АктивыНеЦБ""
		|ИЗ
		|	(
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть данные в регистре"" КАК Запись 
		|		ИЗ
		|			РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеЦБ 
		|		ГДЕ
		|			СтоимостьАктивовНеЦБ.Организация = &Организация
		|			И СтоимостьАктивовНеЦБ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И СтоимостьАктивовНеЦБ.Период = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ ПЕРВЫЕ 1 
		|			""Есть проведенный документ"" КАК Запись 
		|		ИЗ
		|			Документ.РегистрацияСтоимостиАктивов КАК СтоимостьАктивовНеЦБ 
		|		ГДЕ
		|			СтоимостьАктивовНеЦБ.Организация = &Организация
		|			И СтоимостьАктивовНеЦБ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И НАЧАЛОПЕРИОДА(СтоимостьАктивовНеЦБ.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|			И СтоимостьАктивовНеЦБ.Проведен
		|	) КАК АктивыНеЦБ
		|");
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата",							Период);
	Запрос.УстановитьПараметр("ЦельРасчета",					ЦельРасчета);	
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	
	Возврат (Запрос.Выполнить().Выгрузить().Количество() = 2); // должно быть 2 записи - и бумаги, и активы не ЦБ
КонецФункции

