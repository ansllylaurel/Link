		|		ПО _ТаблицаДвижений.Организация = УсловияСделокРЕПО1.Организация
		|			И _ТаблицаДвижений.СделкаРЕПО = УсловияСделокРЕПО1.СделкаРЕПО
		|			И (УсловияСделокРЕПО1.ЧастьСделкиРЕПО = 1)
		|			И _ТаблицаДвижений.Рынок = УсловияСделокРЕПО1.Рынок
		|			И _ТаблицаДвижений.ЦеннаяБумага = УсловияСделокРЕПО1.ЦеннаяБумага
		|			И _ТаблицаДвижений.ПериодПервойЧасти = УсловияСделокРЕПО1.Период
		|			И _ТаблицаДвижений.РегистраторПервойЧасти = УсловияСделокРЕПО1.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО2
		|		ПО _ТаблицаДвижений.Организация = УсловияСделокРЕПО2.Организация
		|			И _ТаблицаДвижений.СделкаРЕПО = УсловияСделокРЕПО2.СделкаРЕПО
		|			И (УсловияСделокРЕПО2.ЧастьСделкиРЕПО = 2)
		|			И _ТаблицаДвижений.Рынок = УсловияСделокРЕПО2.Рынок
		|			И _ТаблицаДвижений.ЦеннаяБумага = УсловияСделокРЕПО2.ЦеннаяБумага
		|			И _ТаблицаДвижений.ПериодВторойЧасти = УсловияСделокРЕПО2.Период
		|			И _ТаблицаДвижений.РегистраторВторойЧасти = УсловияСделокРЕПО2.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыСделки1
		|		ПО (УсловияСделокРЕПО1.СделкаРЕПО.ВалютаСделки = _КурсыВалютыСделки1.Валюта)
		|			И (НАЧАЛОПЕРИОДА(УсловияСделокРЕПО1.ДатаОплаты, ДЕНЬ) = _КурсыВалютыСделки1.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыСделки2
