		|	СделкаСПФИ.Проведен
		|	И СделкаСПФИ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаСПФИ.Организация = &Организация
		|	И СделкаСПФИ.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаСВалютой.Ссылка КАК Сделка,
		|	СделкаСВалютой.Дата КАК ДатаСделки,
		|	СделкаСВалютой.ВидСделки КАК ВидСделки,
		|	СделкаСВалютой.ДатаИсполнения КАК ДатаИсполнения,
		|	СделкаСВалютой.Валюта КАК Валюта,
		|	СделкаСВалютой.Контрвалюта КАК Контрвалюта,
		|	СделкаСВалютой.Курс КАК Курс,
		|	СделкаСВалютой.Сумма КАК Сумма,
		|	СделкаСВалютой.СуммаКонтрвалюты КАК СуммаКонтрвалюты,
		|	НЕОПРЕДЕЛЕНО КАК КомиссияБиржи,
		|	НЕОПРЕДЕЛЕНО КАК КомиссияБрокера,
		|	НЕОПРЕДЕЛЕНО КАК СтавкаFIX,
		|	НЕОПРЕДЕЛЕНО КАК СтавкаПлавающая
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|ГДЕ
		|	СделкаСВалютой.Проведен
		|	И СделкаСВалютой.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаСВалютой.Организация = &Организация
		|	И СделкаСВалютой.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И СделкаСВалютой.ТипСделки В (ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопПерваяЧасть), ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопВтораяЧасть))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкиСПФИ.Ссылка,
		|	СделкиСПФИ.Дата,
		|	ВЫБОР
		|		КОГДА СделкиСПФИ.СтавкаИсходящихПлатежей ССЫЛКА Справочник.БазовыеСтавкиОблигаций
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|	КОНЕЦ,
		|	СделкиСПФИ.ДатаИсполнения,
		|	СделкиСПФИ.Валюта,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	ЕСТЬNULL(КомиссияБиржи.Сумма, 0),
		|	ЕСТЬNULL(КомиссияБрокера.Сумма, 0),
		|	СделкиСПФИ.СтавкаВходящихПлатежей,
		|	СделкиСПФИ.СтавкаИсходящихПлатежей
		|ИЗ
		|	_СделкиСПФИ КАК СделкиСПФИ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗадолженностиПоДенежнымСредствам.Регистратор КАК Ссылка,
		|			СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) КАК Сумма
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ГДЕ
		|			ЗадолженностиПоДенежнымСредствам.Регистратор В
		|					(ВЫБРАТЬ
		|						_СделкиСПФИ.Ссылка
		|					ИЗ
		|						_СделкиСПФИ)
		|			И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗадолженностиПоДенежнымСредствам.Регистратор) КАК КомиссияБиржи
		|		ПО СделкиСПФИ.Ссылка = КомиссияБиржи.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НачислениеЗадолженностиОснования.Основание КАК Ссылка,
		|			СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) КАК Сумма
		|		ИЗ
		|			Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|				ПО (ЗадолженностиПоДенежнымСредствам.Основание В
		|						(ВЫБРАТЬ
		|							_СделкиСПФИ.Ссылка
		|						ИЗ
		|							_СделкиСПФИ))
		|					И НачислениеЗадолженностиОснования.Ссылка = ЗадолженностиПоДенежнымСредствам.Регистратор
		|					И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|		
		|		СГРУППИРОВАТЬ ПО
		|			НачислениеЗадолженностиОснования.Основание) КАК КомиссияБрокера
		|		ПО СделкиСПФИ.Ссылка = КомиссияБрокера.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиСПФИ";
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Фьючерсы/Опционы/СВОП"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_Свопы_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_Свопы_СтрокаТаблицы"));
	
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
КонецПроцедуры // ВывестиСделки

Процедура ВывестиСделкиДепозитнымВкладам(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Регистратор,
		|	ДенежныеСредстваВКредитныхИнструментах.Период КАК Дата,
		|	ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваВКредитныхИнструментах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ""Размещение""
		|		ИНАЧЕ ""Закрытие""
		|	КОНЕЦ КАК ВидСделки,
		|	ДенежныеСредстваВКредитныхИнструментах.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ТаблицаДвижений
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДенежныеСредстваВКредитныхИнструментах
		|ГДЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДенежныеСредстваВКредитныхИнструментах.Активность
		|	И ДенежныеСредстваВКредитныхИнструментах.Организация = &Организация
		|	И ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ДенежныеСредстваВКредитныхИнструментах.ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Дата,
		|	ДепозитныйВклад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДвижений.Регистратор КАК Регистратор,
		|	_ТаблицаДвижений.Дата КАК Дата,
		|	_ТаблицаДвижений.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ТаблицаДвижений.ВидСделки КАК ВидСделки,
		|	_ТаблицаДвижений.Сумма КАК Сумма,
		|	_ТаблицаДвижений.ДепозитныйВклад.БанковскийСчет.Валюта КАК Валюта,
		|	УсловияКредитныхИнструментов.Процент КАК Ставка,
		|	РАЗНОСТЬДАТ(_ТаблицаДвижений.ДепозитныйВклад.ДатаРегистрации, УсловияКредитныхИнструментов.ДатаПогашения, ДЕНЬ) КАК Срок,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК МестоХранения
		|ИЗ
		|	_ТаблицаДвижений КАК _ТаблицаДвижений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ) КАК УсловияКредитныхИнструментов
		|		ПО _ТаблицаДвижений.ДепозитныйВклад = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И (УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий
		|				ИЗ
		|					РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода) КАК УсловияКредитныхИнструментов
		|				ГДЕ
		|					УсловияКредитныхИнструментов.КредитныйИнструмент = _ТаблицаДвижений.ДепозитныйВклад
		|					И УсловияКредитныхИнструментов.Действует
		|					И УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий <= _ТаблицаДвижений.Дата
		|				УПОРЯДОЧИТЬ ПО
		|					ДатаНачалаДействияУсловий УБЫВ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ТаблицаДвижений.ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ТаблицаДвижений";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Депозитные вклады"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_ДепозитныеВклады_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_ДепозитныеВклады_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиСделкиДепозитнымВкладам

Процедура ВывестиСделкиПоМНО(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваМНО.Регистратор КАК Регистратор,
		|	ДенежныеСредстваМНО.Период КАК Дата,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваМНО.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ""Размещение""
		|		ИНАЧЕ ""Закрытие""
		|	КОНЕЦ КАК ВидСделки,
		|	ДенежныеСредстваМНО.Сумма КАК Сумма,
		|	ДенежныеСредстваМНО.МНО КАК МНО,
		|	ДенежныеСредстваМНО.МНО.Процент КАК Ставка,
		|	ДенежныеСредстваМНО.МНО.РасчетныйСчет.Валюта КАК Валюта,
		|	РАЗНОСТЬДАТ(ДенежныеСредстваМНО.МНО.Дата, ДенежныеСредстваМНО.МНО.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК МестоХранения
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО КАК ДенежныеСредстваМНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ДенежныеСредстваМНО.МНО.РасчетныйСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СторнированиеМНО КАК ДенежныеСредстваМНО_Сторнирование
		|		ПО ДенежныеСредстваМНО.Организация = ДенежныеСредстваМНО_Сторнирование.Организация
		|			И ДенежныеСредстваМНО.СчетДоверительногоУправления = ДенежныеСредстваМНО_Сторнирование.СчетДоверительногоУправления
		|			И ДенежныеСредстваМНО.МНО = ДенежныеСредстваМНО_Сторнирование.МНО
		|			И (НАЧАЛОПЕРИОДА(ДенежныеСредстваМНО.МНО.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДенежныеСредстваМНО_Сторнирование.Дата, ДЕНЬ))
		|			И (ДенежныеСредстваМНО_Сторнирование.Проведен)
		|ГДЕ
		|	ДенежныеСредстваМНО.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДенежныеСредстваМНО.Активность
		|	И ДенежныеСредстваМНО.Организация = &Организация
		|	И ДенежныеСредстваМНО.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ВЫБОР
		|			КОГДА ДенежныеСредстваМНО_Сторнирование.Ссылка ЕСТЬ НЕ NULL 
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Регистратор";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "МНО"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_МНО_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_МНО_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиСделкиПоМНО

Процедура ВывестиПолученныеДоходыПоФинансовымВложениям(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Период КАК Дата,
		|	ОстаткиДенежныхСредств.Период КАК Время,
		|	ОстаткиДенежныхСредств.Регистратор КАК Операция,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредств.Сумма КАК Сумма,
		|	ОстаткиДенежныхСредств.Сумма * _КурсыВалют.Курс КАК СуммаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО ОстаткиДенежныхСредств.Валюта = _КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(ОстаткиДенежныхСредств.Период, ДЕНЬ) = _КурсыВалют.Период)
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И (ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО)
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу)
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона))
		|	И (ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи)
		|			ИЛИ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = НЕОПРЕДЕЛЕНО)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Поступившие купоны, дивиденды, % по депозитам"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_ДоходыПоФинансовымВложениям_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Операции_ДоходыПоФинансовымВложениям_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиПолученныеДоходыПоФинансовымВложениям

Процедура ВывестиДвижениеДенежныхСредств(МакетОтчета, ТаблицаОтчета, Запрос)
	// Денежные средства
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛОЖЬ КАК Наличные,
		|	ОстаткиДенежныхСредств.Период КАК Дата,
		|	ОстаткиДенежныхСредств.Регистратор КАК Операция,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ОстаткиДенежныхСредств.Сумма
		|		ИНАЧЕ -ОстаткиДенежныхСредств.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ОстаткиДенежныхСредств.Сумма * КурсыВалют.Курс
		|		ИНАЧЕ -ОстаткиДенежныхСредств.Сумма * КурсыВалют.Курс
		|	КОНЕЦ КАК СуммаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Комиссия))
		|			ТОГДА ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДополнительнаяИнформация
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
		|		ПО ОстаткиДенежныхСредств.Валюта = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(ОстаткиДенежныхСредств.Период, ДЕНЬ) = КурсыВалют.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Маржа КАК Маржа
		|		ПО ОстаткиДенежныхСредств.Регистратор = Маржа.Ссылка
		|			И (Маржа.РынокСПФИ)
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ОстаткиДенежныхСредств.Активность
		|	И Маржа.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИСТИНА,
		|	ДенежныеСредстваНаличные.Период,
		|	ДенежныеСредстваНаличные.Регистратор,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваНаличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ДенежныеСредстваНаличные.Сумма
		|		ИНАЧЕ -ДенежныеСредстваНаличные.Сумма
		|	КОНЕЦ,
		|	ДенежныеСредстваНаличные.Касса.ВалютаДенежныхСредств,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваНаличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ДенежныеСредстваНаличные.Сумма * КурсыВалют.Курс
		|		ИНАЧЕ -ДенежныеСредстваНаличные.Сумма * КурсыВалют.Курс
		|	КОНЕЦ,
		|	""""
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные КАК ДенежныеСредстваНаличные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
		|		ПО ДенежныеСредстваНаличные.Касса.ВалютаДенежныхСредств = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(ДенежныеСредстваНаличные.Период, ДЕНЬ) = КурсыВалют.Период)
		|ГДЕ
		|	ДенежныеСредстваНаличные.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДенежныеСредстваНаличные.Организация = &Организация
		|	И ДенежныеСредстваНаличные.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ДенежныеСредстваНаличные.Активность
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	Маржа.Дата,
		|	Маржа.Ссылка,
		|	МаржаИнструменты.Сумма,
		|	Маржа.ВалютаОплаты,
		|	МаржаИнструменты.Сумма * КурсыВалют.Курс,
		|	""Вариационная маржа""
		|ИЗ
		|	Документ.Маржа КАК Маржа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
		|		ПО Маржа.ВалютаОплаты = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(Маржа.Дата, ДЕНЬ) = КурсыВалют.Период)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Маржа.Инструменты КАК МаржаИнструменты
		|		ПО Маржа.Ссылка = МаржаИнструменты.Ссылка
		|			И (МаржаИнструменты.Инструмент ССЫЛКА Документ.СделкаСПФИ)
		|ГДЕ
		|	Маржа.Проведен
		|	И Маржа.РынокСПФИ
		|	И Маржа.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Маржа.Организация = &Организация
		|	И Маржа.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И МаржаИнструменты.Сумма <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	Маржа.Дата,
		|	Маржа.Ссылка,
		|	МаржаИнструменты.Процент,
		|	Маржа.ВалютаОплаты,
		|	МаржаИнструменты.Процент * КурсыВалют.Курс,
		|	""Процент на вариационную маржу""
		|ИЗ
		|	Документ.Маржа КАК Маржа
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК КурсыВалют
		|		ПО Маржа.ВалютаОплаты = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(Маржа.Дата, ДЕНЬ) = КурсыВалют.Период)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Маржа.Инструменты КАК МаржаИнструменты
		|		ПО Маржа.Ссылка = МаржаИнструменты.Ссылка
		|			И (МаржаИнструменты.Инструмент ССЫЛКА Документ.СделкаСПФИ)
		|ГДЕ
		|	Маржа.Проведен
		|	И Маржа.РынокСПФИ
		|	И Маржа.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Маржа.Организация = &Организация
		|	И Маржа.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И МаржаИнструменты.Процент <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	// !!! В запросе вместо записей РегистрНакопления.ОстаткиДенежныхСредств с регистратором Документ.Маржа (только РынокСПФИ = ИСТИНА)
	//	достаются суммы проведённого документа, что НЕПРАВИЛЬНО.
	// Беда может наступить тогда, когда при проведении документа суммы изменяются и не соответствуют тому, что в документе.
	// Чтобы это исправить, нужно заменить у части движений вид движения денежных средств у таких марж
	//	с "Вариационная маржа" на "Процент на вариационную маржу", а затем передавать эту информацию в функцию ПолучитьОписаниеОперации()
	//	для типа Документ.Маржа, чтобы можно было определить, как назвать эту операцию.
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Движение денежных средств"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("ДвиженияАктивов_ДенежныеСредства_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("ДвиженияАктивов_ДенежныеСредства_СтрокаТаблицы"));
	
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
КонецПроцедуры

Процедура ВывестиДвижениеАктивов(МакетОтчета, ТаблицаОтчета, Запрос)
	
	// ценные бумаги (переводы здесь не учитываются)
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумаг.Период КАК Дата,
		|	ОстаткиЦенныхБумаг.Регистратор КАК Операция,
		|	ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ФинВложение,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ОстаткиЦенныхБумаг.Количество
		|		ИНАЧЕ -ОстаткиЦенныхБумаг.Количество
		|	КОНЕЦ КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|ГДЕ
		|	ОстаткиЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОстаткиЦенныхБумаг.Организация = &Организация
		|	И ОстаткиЦенныхБумаг.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И ОстаткиЦенныхБумаг.Активность
		|	И НЕ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПереводЦенныхБумаг
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Движение ценных бумаг"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("ДвиженияАктивов_ЦенныеБумаги_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("ДвиженияАктивов_ЦенныеБумаги_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры

Процедура ВывестиРасходыПоСделке(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходыПоСделкеОбороты.Период КАК Дата,
		|	РасходыПоСделкеОбороты.Регистратор КАК Регистратор,
		|	РасходыПоСделкеОбороты.ВидЗадолженности КАК СтатьяРасхода,
		|	РасходыПоСделкеОбороты.Сделка КАК Сделка,
		|	РасходыПоСделкеОбороты.СуммаОборот КАК Сумма,
		|	РасходыПоСделкеОбороты.Валюта КАК Валюта
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						Т.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК Т)) КАК РасходыПоСделкеОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Начисленные расходы по сделкам"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("РасходыПоСделкам_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("РасходыПоСделкам_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиРасходыПоСделке

Процедура ВывестиРасходы(МакетОтчета, ТаблицаОтчета, Запрос)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК СтатьяРасхода,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						Т.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК Т)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И НЕ ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Сделки))) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтатьяРасхода
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	ОбластиТаблицы = Новый Структура;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 1, "Начисленные расходы"));
	ОбластиТаблицы.Вставить("ШапкаТаблицы", МакетОтчета.ПолучитьОбласть("Расходы_ШапкаТаблицы"));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть("Расходы_СтрокаТаблицы"));
		
	ВывестиТаблицуОтчета(ПолучитьИсточникДанных(Запрос, ТекстЗапроса), ТаблицаОтчета, ОбластиТаблицы);
	
КонецПроцедуры // ВывестиРасходы

// Служебные

Процедура ПолучитьКурсыВалют(Запрос)
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|ИНДЕКСИРОВАТЬ ПО
		|	Валюта,
		|	Период
		|";
	
	Запрос.Выполнить();
		
КонецПроцедуры // ПолучитьКурсыВалют

Функция ПолучитьСчетаДоверительногоУправления(Запрос)
	
	Если ТипЗнч(КлиентДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда // счет доверительного управления
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	&ЦельРасчета КАК ЦельРасчета,
			|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчета
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления 
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних
			|		ПО НастройкиЦелейРасчетаСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка  
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления	
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетДоверительногоУправления";
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	КлиентДоверительногоУправления);
		Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период",							ЭтотОбъект.Период.ДатаОкончания);
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация КАК Организация,
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	&ЦельРасчета КАК ЦельРасчета,
			|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчета
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, Клиент = &Клиент) КАК КлиентыДоверительногоУправленияСрезПоследних
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних
			|		ПО НастройкиЦелейРасчетаСрезПоследних.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления  
			|ГДЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация = &Организация 	
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетДоверительногоУправления";
		Запрос.УстановитьПараметр("Клиент",			КлиентДоверительногоУправления);
		Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период",			ЭтотОбъект.Период.ДатаОкончания);
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ";
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.СчетДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК Т	
		|";
	
	Возврат (Не Запрос.Выполнить().Пустой());
	
КонецФункции // ПолучитьСчетаДоверительногоУправления

Процедура ПолучитьРыночнуюСтоимостьАктивов(Запрос)
	Запрос.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.Цена КАК СправедливаяЦена,
		|	СтоимостьПереоценки.Источник КАК ИсточникЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОпределенияЦены,
		|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
		|	СУММА(СтоимостьПереоценки.Сумма) КАК Сумма,
		|	СУММА(СтоимостьПереоценки.СуммаКупона) КАК СуммаКупона,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК СуммаКупонаВВалютеУчета
		|ПОМЕСТИТЬ _СтоимостьЦБ
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления 
		|		ПО _СчетаДоверительногоУправления.Организация = СтоимостьПереоценки.Организация
		|			И _СчетаДоверительногоУправления.СчетДоверительногоУправления = СтоимостьПереоценки.СчетДоверительногоУправления
		|			И _СчетаДоверительногоУправления.ЦельРасчета = СтоимостьПереоценки.ЦельРасчета
		|			И _СчетаДоверительногоУправления.ВидУчета = СтоимостьПереоценки.ВидУчета
		|ГДЕ
		|	СтоимостьПереоценки.Период = &КонецПериодаНачалоДня
		|СГРУППИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	ДатаЦены,
		|	Цена,
		|	Источник,
		|	УровеньОценки
		|;		
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеЦБ.*
		|ПОМЕСТИТЬ
		|	_СтоимостьАктивовНеЦБ
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеЦБ 
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления 
		|		ПО _СчетаДоверительногоУправления.Организация = СтоимостьАктивовНеЦБ.Организация
		|			И _СчетаДоверительногоУправления.СчетДоверительногоУправления = СтоимостьАктивовНеЦБ.СчетДоверительногоУправления
		|ГДЕ
		|	СтоимостьАктивовНеЦБ.Период = &КонецПериодаНачалоДня
		|;
		|";
	
	Запрос.Выполнить();
КонецПроцедуры

Функция ПолучитьРеквизитыШапки(Запрос)
	
	РеквизитыШапки = Новый Структура();
		
	// сначала получим представления юр./физ. лиц
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Ссылка,
		|	""УчредительУправления"" КАК РольЮрФизЛица,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ЮрФизЛица
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			СчетДоверительногоУправления В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					Т.СчетДоверительногоУправления
		|				ИЗ
		|					_СчетаДоверительногоУправления КАК Т)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Организации.ЮрФизЛицо,
		|	""УправляющаяКомпания"",
		|	Организации.ЮрФизЛицо.ВидЮрФизЛица,
		|	NULL
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЮрФизЛица.РольЮрФизЛица КАК РольЮрФизЛица,
		|	ВЫБОР
		|		КОГДА _ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу
		|		КОГДА _ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество
		|	КОНЕЦ КАК Представление,
		|	_ЮрФизЛица.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_ЮрФизЛица КАК _ЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_ЮрФизЛица.Ссылка
		|						ИЗ
		|							_ЮрФизЛица
		|						ГДЕ
		|							_ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо))) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО _ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_ЮрФизЛица.Ссылка
		|						ИЗ
		|							_ЮрФизЛица
		|						ГДЕ
		|							_ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _ЮрФизЛица.Ссылка = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	_ЮрФизЛица.РольЮрФизЛица = ""УправляющаяКомпания""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЮрФизЛица.РольЮрФизЛица,
		|	"""",
		|	_ЮрФизЛица.СчетДоверительногоУправления
		|ИЗ
		|	_ЮрФизЛица КАК _ЮрФизЛица
		|ГДЕ
		|	_ЮрФизЛица.РольЮрФизЛица = ""УчредительУправления""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЮрФизЛица";
		
	Результаты = Запрос.ВыполнитьПакет();
		
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.РольЮрФизЛица = "УчредительУправления" Тогда
			РеквизитыШапки.Вставить(Выборка.РольЮрФизЛица, РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(Выборка.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания).ПолноеНаименование);
		Иначе	
			РеквизитыШапки.Вставить(Выборка.РольЮрФизЛица, Выборка.Представление);
		КонецЕсли;		
	КонецЦикла;
	
	// дополним реквизитами счета д/у
	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результаты[2].Выгрузить()[0].СчетДоверительногоУправления, "НомерДоговора, ДатаЗаключения");
		
	РеквизитыШапки.Вставить("НомерДоговора", РеквизитыСчетаДУ.НомерДоговора);
	РеквизитыШапки.Вставить("ДоговорДУ",  РеквизитыСчетаДУ.НомерДоговора + " от " + Формат(РеквизитыСчетаДУ.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
	
	Возврат РеквизитыШапки;
	
КонецФункции // ПолучитьРеквизитыШапки

Функция ВыбратьДействующихКонтрагентов(Запрос)
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	""Брокер"" КАК Роль,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо КАК Контрагент
		|ПОМЕСТИТЬ _Контрагенты
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						Т.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК Т)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&КонецПериода, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &КонецПериода)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""Банк"",
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &КонецПериода)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""Депозитарий"",
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.Организация = &Организация
		|	И ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				Т.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления КАК Т)
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &КонецПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Контрагенты.Роль КАК Роль,
		|	_Контрагенты.Контрагент КАК Контрагент,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Адрес
		|ИЗ
		|	_Контрагенты КАК _Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_Контрагенты.Контрагент
		|						ИЗ
		|							_Контрагенты)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _Контрагенты.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&КонецПериода,
		|				Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)
		|					И Объект В
		|						(ВЫБРАТЬ
		|							_Контрагенты.Контрагент
		|						ИЗ
		|							_Контрагенты)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО _Контрагенты.Контрагент = КонтактнаяИнформацияСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				(ЮрФизЛицо, Подразделение, Язык, Вид) В
		|					(ВЫБРАТЬ
		|						_Контрагенты.Контрагент КАК ЮрФизЛицо,
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык,
		|						ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации) КАК Вид
		|					ИЗ
		|						_Контрагенты КАК _Контрагенты)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО _Контрагенты.Контрагент = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &КонецПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Роль,
		|	Контрагент
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	Возврат Запрос.Выполнить();	
		
КонецФункции // ВыбратьДействующихКонтрагентов

Функция ПолучитьИсточникДанных(Запрос, ТекстЗапроса)
	
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПолучитьЗаголовок(МакетОтчета, Уровень, ТекстЗаголовка = "")
	
	ОбластьЗаголовка = МакетОтчета.ПолучитьОбласть("Заголовок_Уровень" + Уровень);
	ОбластьЗаголовка.Параметры.Заголовок = ТекстЗаголовка;
	
	Возврат ОбластьЗаголовка;
	
КонецФункции

Функция ВывестиОбластиФинВложений(ГруппаУчета, МакетОтчета, ТаблицаОтчета, Запрос)
	ФинВложения = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ФинВложения.Колонки.Добавить("РеквизитыФинВложения");
	
	НеВыведенЗаголовок = Истина;
	СтоимостьАктивов = 0;
	Для Каждого СтрокаПодгруппаУчета Из ФинВложения.Строки Цикл
		Если НеВыведенЗаголовок Тогда
			Если ТаблицаОтчета <> Неопределено Тогда
				ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 1, ВРег(ГруппаУчета)));
			КонецЕсли;
			НеВыведенЗаголовок = Ложь;
		КонецЕсли;
		
		Если СтрокаПодгруппаУчета.ПодгруппаУчета <> Неопределено Тогда
			Если ТаблицаОтчета <> Неопределено Тогда
				ТаблицаОтчета.Вывести(ПолучитьЗаголовок(МакетОтчета, 2, ВРег(СтрокаПодгруппаУчета.ПодгруппаУчета)));
			КонецЕсли;
			Если СтрокаПодгруппаУчета.ПодгруппаУчета = Перечисления.ТипыЗадолженности.Дебиторская Тогда
				ЗнакИтогов = 1;
			Иначе
				ЗнакИтогов = -1;
			КонецЕсли;
		Иначе
			ЗнакИтогов = 1;
		КонецЕсли;
		
		Для Каждого СтрокаВидФинВложения Из СтрокаПодгруппаУчета.Строки Цикл
			Если Не ЗначениеЗаполнено(СтрокаВидФинВложения.ВидФинВложения) Тогда
				Для Каждого СтрокаФинВложения Из СтрокаВидФинВложения.Строки Цикл
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не поддерживается обработка фин. вложения '" + СтрокаФинВложения.ФинВложение + "'");
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			
			ОбластиТаблицы = ПолучитьОбластиФинВложений(ГруппаУчета, МакетОтчета, СтрокаВидФинВложения.ВидФинВложения);
			
			Итоги = ВывестиТаблицуОтчета(СтрокаВидФинВложения.Строки, ТаблицаОтчета, ОбластиТаблицы);
			
			Для Каждого СтрокаФинВлождения Из СтрокаВидФинВложения.Строки Цикл
				ДобавитьСтрокуВРасшифровкаСтоимостиПортфеля(
					СтрокаФинВлождения.ВидФинВложения,
					СтрокаФинВлождения.ФинВложение,
					?(ЗначениеЗаполнено(СтрокаФинВлождения.СтоимостьВсегоВВалютеУчета),
						СтрокаФинВлождения.СтоимостьВсегоВВалютеУчета,
						СтрокаФинВлождения.СтоимостьВВалютеУчета),
					"");
			КонецЦикла;
			
			Если Итоги.Количество() = 1 Тогда
				Для Каждого КлючЗнач Из Итоги Цикл
					СтоимостьАктивов = СтоимостьАктивов + ЗнакИтогов * КлючЗнач.Значение;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СтоимостьАктивов;
КонецФункции

Функция ПолучитьОбластиФинВложений(ГруппаУчета, МакетОтчета, ВидФинВложения)
	ОбластиТаблицы = Новый Структура;
	
	Если ВидФинВложения = "ДепозитарныеРасписки" Тогда
		ЗаголовокТаблицы = "Депозитарные расписки";
	ИначеЕсли ВидФинВложения = "Еврооблигации" Тогда
		ЗаголовокТаблицы = "Облигации, номинированные в ин. валюте";
	ИначеЕсли (ВидФинВложения = "Фьючерсы" Или ВидФинВложения = "СВОП") Тогда
		ЗаголовокТаблицы = "Фьючерсы, СВОП (информация предоставляется справочно)";
	Иначе
		ЗаголовокТаблицы = ВидФинВложения;
	КонецЕсли;
	ОбластиТаблицы.Вставить("Заголовок", ПолучитьЗаголовок(МакетОтчета, 3, ЗаголовокТаблицы));
	
	ИмяОбласти = "ФинВложения_" + ВидФинВложения;
	
	// Вид финансового вложения "СВОП" находится в одной таблице с "Фьючерсы"
	Если ВидФинВложения = "СВОП" Тогда
		ИмяОбласти = "ФинВложения_Фьючерсы";
	КонецЕсли;
	
	Если ГруппаУчета = "Задолженность по ценным бумагам"
		И (ВидФинВложения = "Облигации" Или ВидФинВложения = "Еврооблигации")
	Тогда
		// Для задолженности данные с НКД не выводим
		ИмяОбласти = ИмяОбласти + "_Задолженности";
	КонецЕсли;
	
	Если ВидФинВложения = "Депозиты" Тогда
		// Количество ячеек в таблице облигаций и депозитов одинаковое, в результате
		//	пришлось создать 2 гор. области одинаковой ширины; однако, при таком раскладе
		//	пересечение со 2-й областью смещает таблицу на одну ячейку вправо;
		//	почему - непонятно!
		ОбластьПересечения = ?(ГруппаУчета = "Финансовые вложения", "|ФинВложения_Облигации_Остатки", "");
	Иначе
		ОбластьПересечения = ?(ГруппаУчета = "Финансовые вложения", "|" + ИмяОбласти + "_Остатки", "");
	КонецЕсли;
	
	ОбластиТаблицы.Вставить("ШапкаТаблицы",  МакетОтчета.ПолучитьОбласть(ИмяОбласти + "_ШапкаТаблицы" + ОбластьПересечения));
	ОбластиТаблицы.Вставить("СтрокаТаблицы", МакетОтчета.ПолучитьОбласть(ИмяОбласти + "_СтрокаТаблицы" + ОбластьПересечения));
	
	Если МакетОтчета.Области.Найти(ИмяОбласти + "_Итого") <> Неопределено Тогда
		ОбластиТаблицы.Вставить("СтрокаИтого", МакетОтчета.ПолучитьОбласть(ИмяОбласти + "_Итого"));
	КонецЕсли;
	
	Возврат ОбластиТаблицы;
КонецФункции

Функция ПолучитьВариантПереводаДенежныхСредств(Операция)
	
	СтрукрураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, "ВариантПеревода, Основание, Брокер, БрокерПолучатель, МестоХранения, МестоХраненияПолучатель, РасчетныйСчет, РасчетныйСчетПолучатель");
	
	Если СтрукрураРеквизитов.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводВПуть Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ВПуть;
		
	ИначеЕсли СтрукрураРеквизитов.ВариантПеревода = Перечисления.ВариантыПереводаДенежныхСредств.ПереводИзПути Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ИзПути;
		
	ИначеЕсли ЗначениеЗаполнено(СтрукрураРеквизитов.Основание) И ТипЗнч(СтрукрураРеквизитов.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ПоЗаявкеПайщика;
		
	ИначеЕсли ЗначениеЗаполнено(СтрукрураРеквизитов.Брокер) И ЗначениеЗаполнено(СтрукрураРеквизитов.БрокерПолучатель) Тогда
		Возврат СокрЛП(Перечисления.ВидыПереводовДенежныхСредств.МеждуСчетамиБрокера) + " " + СокрЛП(СтрукрураРеквизитов.Брокер) + " (" + СокрЛП(СтрукрураРеквизитов.МестоХранения) + " --> " + СокрЛП(СтрукрураРеквизитов.МестоХраненияПолучатель) + ")";
		
	ИначеЕсли ЗначениеЗаполнено(СтрукрураРеквизитов.Брокер) И Не ЗначениеЗаполнено(СтрукрураРеквизитов.БрокерПолучатель) Тогда
		Возврат СокрЛП(Перечисления.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет) + " " + СокрЛП(СтрукрураРеквизитов.Брокер) + " (" + СокрЛП(СтрукрураРеквизитов.МестоХранения) + " --> " + СокрЛП(СтрукрураРеквизитов.РасчетныйСчетПолучатель) + ")";
		
	ИначеЕсли Не ЗначениеЗаполнено(СтрукрураРеквизитов.Брокер) И ЗначениеЗаполнено(СтрукрураРеквизитов.БрокерПолучатель) Тогда
		Возврат СокрЛП(Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера) + " " + СокрЛП(СтрукрураРеквизитов.БрокерПолучатель) + " (" + СокрЛП(СтрукрураРеквизитов.РасчетныйСчет) + " --> " + СокрЛП(СтрукрураРеквизитов.МестоХраненияПолучатель) + ")";;
			
	ИначеЕсли Не ЗначениеЗаполнено(СтрукрураРеквизитов.Брокер) И Не ЗначениеЗаполнено(СтрукрураРеквизитов.БрокерПолучатель) Тогда
		Возврат СокрЛП(Перечисления.ВидыПереводовДенежныхСредств.МеждуРасчетнымиСчетами) + " (" + СокрЛП(СтрукрураРеквизитов.РасчетныйСчет) + " --> " + СокрЛП(СтрукрураРеквизитов.РасчетныйСчетПолучатель) + ")";
	Иначе 
		Возврат Перечисления.ВидыПереводовДенежныхСредств.ПустаяСсылка();
	КонецЕсли;
		
КонецФункции

// Вывод отчета

Функция ПолучитьОписаниеОперации(Операция, Отказ = Ложь, ДополнительнаяИнформация = Неопределено)
	ОписаниеОперации = "";
	
	// Сделка
	#Область Сделка
	Если ТипЗнч(Операция) = Тип("ДокументСсылка.Сделка") Тогда
		ВремЗапрос = Новый Запрос;
		ВремЗапрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СделкаЦенныеБумаги.ЦеннаяБумага,
			|	СделкаЦенныеБумаги.Количество,
			|	СделкаЦенныеБумаги.Ссылка.Дата,
			|	СделкаЦенныеБумаги.Ссылка.ВидСделки,
			|	СделкаЦенныеБумаги.Ссылка.Рынок,
			|	СделкаЦенныеБумаги.Ссылка.МестоХранения,
			|	СделкаЦенныеБумаги.Ссылка.НомерСделки
			|ИЗ
			|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|ГДЕ
			|	СделкаЦенныеБумаги.Ссылка = &Ссылка";
			
		ВремЗапрос.УстановитьПараметр("Ссылка", Операция);
		
		РеквизитыСделки = ВремЗапрос.Выполнить().Выгрузить();
		
		Если РеквизитыСделки.Количество() <> 1 Тогда
			ОписаниеОперации = Строка(Операция);
		Иначе
			РеквизитыСделки = РеквизитыСделки[0];
			РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(РеквизитыСделки.ЦеннаяБумага);
			Если РеквизитыФинВложения.ВидВложения = "Фьючерс" Тогда
				ОписаниеФинВложения = РеквизитыФинВложения.НаименованиеКонтракта + ", " + РеквизитыФинВложения.ДатаИсполненияКонтракта + ", " + РеквизитыФинВложения.ВидКонтракта;
			Иначе
				ОписаниеФинВложения = ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
					+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
					+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
			КонецЕсли;
			
			//Вид комиссии
			Если ТипЗнч(ДополнительнаяИнформация) = Тип("СправочникСсылка.ВидыЗадолженности") Тогда
				ВидКомиссии = " (" + ДополнительнаяИнформация + ")";
			Иначе
				ВидКомиссии = "";
			КонецЕсли;
			
			Если РеквизитыСделки.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
				ОписаниеОперации = "Сделка от " + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy") + ", " + РеквизитыСделки.ВидСделки + ", " + РеквизитыСделки.Рынок
					+ ", " + ОписаниеФинВложения + ", " + РеквизитыСделки.Количество + " шт." + ВидКомиссии;
			Иначе
				ОписаниеОперации = "Бирж. сделка № " + РеквизитыСделки.НомерСделки + " от " + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy") + ", " + РеквизитыСделки.ВидСделки
					+ ", " + РеквизитыСделки.Рынок + ", " + ОписаниеФинВложения + ", " + РеквизитыСделки.Количество + " шт." + ВидКомиссии;
			КонецЕсли;
		КонецЕсли;
	#КонецОбласти
	// Сделка РЕПО
	#Область СделкаРЕПО
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		ВремЗапрос = Новый Запрос;
		ВремЗапрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага,
			|	СделкаРЕПОЦенныеБумаги.Количество,
			|	СделкаРЕПОЦенныеБумаги.Ссылка.Дата,
			|	СделкаРЕПОЦенныеБумаги.Ссылка.ВидСделки,
			|	СделкаРЕПОЦенныеБумаги.Ссылка.Рынок,
			|	СделкаРЕПОЦенныеБумаги.Ссылка.МестоХранения,
			|	ВЫБОР
			|		КОГДА СделкаРЕПОЦенныеБумаги.Ссылка.СделкаСЦентральнымКонтрагентом
			|			ТОГДА СделкаРЕПОЦенныеБумаги.Ссылка.НомерСделкиСЦентральнымКонтрагентом
			|		ИНАЧЕ СделкаРЕПОЦенныеБумаги.Ссылка.НомерСделки
			|	КОНЕЦ КАК НомерСделки
			|ИЗ
			|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
			|ГДЕ
			|	СделкаРЕПОЦенныеБумаги.Ссылка = &Ссылка";
			
		ВремЗапрос.УстановитьПараметр("Ссылка", Операция);
		
		РеквизитыСделки = ВремЗапрос.Выполнить().Выгрузить();
		
		Если РеквизитыСделки.Количество() <> 1 Тогда
			ОписаниеОперации = Строка(Операция);
		Иначе
			РеквизитыСделки = РеквизитыСделки[0];
			РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(РеквизитыСделки.ЦеннаяБумага);
			Если РеквизитыФинВложения.ВидВложения = "Фьючерс" Тогда
				ОписаниеФинВложения = РеквизитыФинВложения.НаименованиеКонтракта + ", " + РеквизитыФинВложения.ДатаИсполненияКонтракта + ", " + РеквизитыФинВложения.ВидКонтракта;
			Иначе
				ОписаниеФинВложения = ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
					+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
					+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
			КонецЕсли;
			
			//Вид комиссии
			Если ТипЗнч(ДополнительнаяИнформация) = Тип("СправочникСсылка.ВидыЗадолженности") Тогда
				ВидКомиссии = " (" + ДополнительнаяИнформация + ")";
			Иначе
				ВидКомиссии = "";
			КонецЕсли;
			
			Если РеквизитыСделки.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
				ОписаниеОперации = "Сделка РЕПО от " + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy") + ", " + РеквизитыСделки.ВидСделки + ", " + РеквизитыСделки.Рынок
					+ ", " + ОписаниеФинВложения + ", " + РеквизитыСделки.Количество + " шт." + ВидКомиссии;
			Иначе
				ОписаниеОперации = "Бирж. сделка РЕПО № " + РеквизитыСделки.НомерСделки + " от " + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy")
					+ ", " + РеквизитыСделки.ВидСделки + ", " + РеквизитыСделки.Рынок + ", " + ОписаниеФинВложения + ", " + РеквизитыСделки.Количество + " шт." + ВидКомиссии;
			КонецЕсли;
		КонецЕсли;
	#КонецОбласти
	// Сделка с валютой
	#Область сделкаСВалютой
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, "Дата, ТипСделки, ВидСделки, Валюта, Сумма, Контрвалюта, СуммаКонтрвалюты");
		
		Если РеквизитыСделки.ТипСделки = Перечисления.ТипыСделокСВалютой.ФорвардПоставочный Тогда
			ОписаниеОперации = "Поставочный форвард ";
		ИначеЕсли РеквизитыСделки.ТипСделки = Перечисления.ТипыСделокСВалютой.СвопПерваяЧасть Тогда
			ОписаниеОперации = "Своп (первая часть) ";
		ИначеЕсли РеквизитыСделки.ТипСделки = Перечисления.ТипыСделокСВалютой.СвопВтораяЧасть Тогда
			ОписаниеОперации = "Своп (вторая часть) ";
		Иначе
			ОписаниеОперации = "Сделка с вал. от ";
		КонецЕсли;
		
		//Вид комиссии
		Если ТипЗнч(ДополнительнаяИнформация) = Тип("СправочникСсылка.ВидыЗадолженности") Тогда
			ВидКомиссии = " (" + ДополнительнаяИнформация + ")";
		Иначе
			ВидКомиссии = "";
		КонецЕсли;
		
		ОписаниеОперации = ОписаниеОперации + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy") + ", " + РеквизитыСделки.ВидСделки + ", " + РеквизитыСделки.Сумма
			+ " " + РеквизитыСделки.Валюта + " / " + РеквизитыСделки.СуммаКонтрвалюты + " " + РеквизитыСделки.Контрвалюта + ВидКомиссии;
	#КонецОбласти
	// Сделка СПФИ
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.СделкаСПФИ") Тогда
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, "Дата, НомерСделки, СтавкаИсходящихПлатежей");
		
		ОписаниеОперации = "Сделка " + "Процентный СВОП_" + СокрЛП(РеквизитыСделки.СтавкаИсходящихПлатежей) + " -FIX_" + СокрЛП(РеквизитыСделки.НомерСделки)
			+ "_" + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy");
	// Ввод ценных бумаг / Вывод ценных бумаг
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ВводЦенныхБумаг") Или ТипЗнч(Операция) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		ОписаниеОперации = Операция.Метаданные().Представление() + ", " + Операция.Рынок;
	// Ввод денежных средств / Вывод денежных средств
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ВводДенежныхСредств") Или ТипЗнч(Операция) = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
		ОписаниеОперации = Операция.Метаданные().Представление() + ", " + ?(ЗначениеЗаполнено(Операция.Касса), "наличные", "безналичные");
	// Перевод денежных средств
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереводДенежныхСредств") Тогда
		ОписаниеОперации = Операция.Метаданные().Представление() + " " + ПолучитьВариантПереводаДенежныхСредств(Операция)
	// Закрытие кредитного инструмента
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента")
		И ТипЗнч(Операция.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады")
	Тогда
		ОписаниеОперации = "Закрытие депозитного вклада, " + ПредставлениеДепозитногоВклада(Операция.КредитныйИнструмент);
	// Оплата
	#Область Оплата
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.Оплата") Тогда
		РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция, "ВидДвижения, ВидЗадолженности, ВалютаОплаты, Основания");
		ОснованияОперации = РеквизитыОперации.Основания.Выгрузить();
		ОписаниеОперации = "Оплата " + НРег(РеквизитыОперации.ВидЗадолженности) + ", " + РеквизитыОперации.ВалютаОплаты;
		
		Если РеквизитыОперации.ВидДвижения = Перечисления.ВидыДвижений.Приход
			И (РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего
				Или РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение)
		Тогда
			ОписаниеОперации = "Возврат ранее удержанного вознаграждения, " + РеквизитыОперации.ВалютаОплаты;
		
		ИначеЕсли РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке
			Или РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО
			Или РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО
		Тогда
			Для Каждого СтрокаОснования Из ОснованияОперации Цикл
				ОписаниеОперации = ОписаниеОперации + Символы.ПС + ПолучитьОписаниеОперации(СтрокаОснования.Основание, Отказ);
			КонецЦикла;
			
		ИначеЕсли РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона Тогда
			Для каждого СтрокаОснования Из ОснованияОперации Цикл
				РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(СтрокаОснования.Основание.Облигация);
				ОписаниеФинВложения = РеквизитыФинВложения.ВидВложения + " " + РеквизитыФинВложения.НаименованиеЭмитента
					+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
					+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
				ОписаниеОперации = ОписаниеОперации + Символы.ПС + ОписаниеФинВложения;
			КонецЦикла;
			
		ИначеЕсли РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Тогда
			Для каждого СтрокаОснования Из ОснованияОперации Цикл
				РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(СтрокаОснования.Основание.ЦеннаяБумага);
				ОписаниеФинВложения = РеквизитыФинВложения.ВидВложения + " "
					+ ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
					+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
					+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
				ОписаниеОперации = ОписаниеОперации + Символы.ПС + ОписаниеФинВложения;
			КонецЦикла;
			
		ИначеЕсли РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции
				Или РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки
				Или РеквизитыОперации.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи
		Тогда
			Для каждого СтрокаОснования Из ОснованияОперации Цикл
				РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(СтрокаОснования.Основание.ЦеннаяБумага);
				ОписаниеФинВложения = РеквизитыФинВложения.ВидВложения + " "
					+ ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
					+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
					+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
				ОписаниеОперации = ОписаниеОперации + Символы.ПС + ОписаниеФинВложения;
			КонецЦикла;
			
		ИначеЕсли РеквизитыОперации.ВидДвижения = Перечисления.ВидыДвижений.Приход И ЭтоРасходныйВидЗадолженности(РеквизитыОперации.ВидЗадолженности) Тогда
				ОписаниеОперации = "Возврат (" + НРег(РеквизитыОперации.ВидЗадолженности) + "), " + РеквизитыОперации.ВалютаОплаты;
		КонецЕсли;
	#КонецОбласти
	// Поставка ценных бумаг
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
		ОписаниеОперации = ПолучитьОписаниеОперации(Операция.Основание, Отказ);
		ОписаниеОперации = СтрЗаменить(ОписаниеОперации, "Тикет", "сделке");
		ОписаниеОперации = СтрЗаменить(ОписаниеОперации, "Бирж. сделка", "бирж. сделке");
		ОписаниеОперации = "Поставка по " + ОписаниеОперации;
	// Приход процентов МНО
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПриходПроцентовМНО") Тогда
		ОписаниеОперации = "Приход % по МНО от " + Формат(Операция.МНО.Дата, "ДФ=dd.MM.yyyy");
	// МНО
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.МНО") Тогда
		ОписаниеОперации = "% по МНО";
	// Погашение купона
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
		РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(Операция.Облигация);
		ОписаниеФинВложения = РеквизитыФинВложения.НаименованиеЭмитента + ", "
			+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
			+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
		ОписаниеОперации = "Погашение купона от " + Формат(Операция.Дата, "ДФ=dd.MM.yyyy") + ", " + ОписаниеФинВложения;
	// Погашение ценной бумаги
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(Операция.ЦеннаяБумага);
		ОписаниеФинВложения = ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
			+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
			+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
		ОписаниеОперации = "Погашение ценной бумаги от " + Формат(Операция.Дата, "ДФ=dd.MM.yyyy") + ", " + ОписаниеФинВложения;
	// Начисление задолженности
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
		ОписаниеОперации = "" + Операция.ВидЗадолженности + " от " + Формат(Операция.Дата, "ДФ=dd.MM.yyyy");
	// Начисление дивидентов
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.НачислениеДивидендов") Тогда
		РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(Операция.ЦеннаяБумага);
		ОписаниеФинВложения = ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
			+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
			+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
		ОписаниеОперации = "Начисление дивидендов от " + Формат(Операция.Дата, "ДФ=dd.MM.yyyy") + ", " + ОписаниеФинВложения;
	// Исполнение обязательств по сделке
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		ОписаниеОперации = "Исполнение сделки " + ПолучитьОписаниеОперации(Операция.Основание, Отказ);
	// Исполнение обязательств по сделке СПФИ
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделкеСПФИ") Тогда
		РеквизитыСделки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Операция.Основание, "Дата, НомерСделки, СтавкаИсходящихПлатежей");
		
		ОписаниеОперации = "Исполнение сделки " + "Процентный СВОП_" + СокрЛП(РеквизитыСделки.СтавкаИсходящихПлатежей) + " -FIX_" + СокрЛП(РеквизитыСделки.НомерСделки)
			+ "_" + Формат(РеквизитыСделки.Дата, "ДФ=dd.MM.yyyy");
	// Списание ценной бумаги
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
		РеквизитыФинВложения = ПолучитьРеквизитыФинВложения(Операция.ЦеннаяБумага);
		Если РеквизитыФинВложения.ВидВложения = "Фьючерс" Тогда
			ОписаниеФинВложения = РеквизитыФинВложения.НаименованиеКонтракта + ", " + РеквизитыФинВложения.ДатаИсполненияКонтракта + ", " + РеквизитыФинВложения.ВидКонтракта;
		Иначе
			ОписаниеФинВложения = ?(РеквизитыФинВложения.ВидВложения = "Пай", РеквизитыФинВложения.НаименованиеФонда, РеквизитыФинВложения.НаименованиеЭмитента)
				+ ", " + ?(ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер), РеквизитыФинВложения.РегНомер, РеквизитыФинВложения.ISIN)
				+ ?(ЗначениеЗаполнено(РеквизитыФинВложения.ВалютаНоминала), ", " + РеквизитыФинВложения.ВалютаНоминала, "");
		КонецЕсли;
		
		ОписаниеОперации = "Списание ценной бумаги от " + Формат(Операция.Дата, "ДФ=dd.MM.yyyy") + ", " + ОписаниеФинВложения;
	// Маржа
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.Маржа") Тогда
		ВремЗапрос = Новый Запрос;
		ВремЗапрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МаржаИнструменты.Инструмент КАК Фьючерс
			|ИЗ
			|	Документ.Маржа.Инструменты КАК МаржаИнструменты
			|ГДЕ
			|	МаржаИнструменты.Ссылка = &Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	МаржаИнструменты.НомерСтроки";
		ВремЗапрос.УстановитьПараметр("Ссылка", Операция);
		
		ТекстФьючерсов = "";
		ТаблицаФьючерсов = ВремЗапрос.Выполнить().Выгрузить();
		Для Каждого СтрокаФьючерс Из ТаблицаФьючерсов Цикл // Уже не только фьючерсы, но и сделки СПФИ
			ТекстФьючерсов = ТекстФьючерсов + ", " + СтрокаФьючерс.Фьючерс;
		КонецЦикла;
		
		НазваниеОперации = "Вариационная маржа за ";
		Если Операция.РынокСПФИ И ТипЗнч(ДополнительнаяИнформация) = Тип("Строка") И ДополнительнаяИнформация = "Процент на вариационную маржу" Тогда
			НазваниеОперации = "Процент на вариационную маржу за ";
		КонецЕсли;
		ОписаниеОперации = НазваниеОперации + Формат(Операция.Дата, "ДФ=dd.MM.yyyy") + ТекстФьючерсов;
	// Размещение кредитного инструмента
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.РазмещениеКредитногоИнструмента") Тогда
		Если ТипЗнч(Операция.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
			ОписаниеОперации = "Размещение депозитного вклада, " + ПредставлениеДепозитногоВклада(Операция.КредитныйИнструмент);
		Иначе
			ОписаниеОперации = "Размещение займа, " + Операция.КредитныйИнструмент;
		КонецЕсли;
	// Корректировка регистров
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
		ОписаниеОперации = "Корректировка " + Операция.Номер + " от " + Операция.Дата;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Описание операции оформленной документом " + Операция + " автоматически не определено",,,, Отказ);
	// Остальное
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка операций '" + Операция + "' не поддерживается",,,, Отказ);
		//ВызватьИсключение "Обработка операциий '" + Операция + "' не поддерживается"
	КонецЕсли;
	
	Возврат ОписаниеОперации;
КонецФункции // ПолучитьОписаниеОперации

Функция ПолучитьРеквизитыФинВложения(ФинВложение)
	РеквизитыФинВложения = Новый Структура("ФинВложение, ВидВложения, Эмитент, НаименованиеЭмитента, НаименованиеФонда, ДатаРегистрации, "
			+ "ДатаПогашения, РегНомер, ISIN, Номинал, ВалютаНоминала, БазовыйАктив, НаименованиеКонтракта, ВидКонтракта, ДатаИсполненияКонтракта, НомерДоговора",
		ФинВложение,
		ФинВложение.Метаданные().ПредставлениеОбъекта);
	
	Если      ТипЗнч(ФинВложение) = Тип("СправочникСсылка.Акции") Тогда
		РеквизитыФинВложения.Эмитент        = ФинВложение.Эмитент.ЮрФизЛицо;
		РеквизитыФинВложения.РегНомер       = ФинВложение.ГосударственныйРегистрационныйНомер;
		РеквизитыФинВложения.ВалютаНоминала = ФинВложение.ВалютаНоминала;
		РеквизитыФинВложения.Номинал        = ФинВложение.Номинал;
		
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("СправочникСсылка.Облигации") Тогда
		РеквизитыФинВложения.Эмитент         = ФинВложение.Эмитент.ЮрФизЛицо;
		РеквизитыФинВложения.РегНомер        = ФинВложение.ГосударственныйРегистрационныйНомер;
		РеквизитыФинВложения.ДатаРегистрации = Формат(ФинВложение.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		РеквизитыФинВложения.ДатаПогашения   = Формат(ФинВложение.ДатаПогашения, "ДФ=dd.MM.yyyy");
		РеквизитыФинВложения.ВалютаНоминала  = ФинВложение.ВалютаНоминала;
		
		Отбор = Новый Структура("ЦеннаяБумага", ФинВложение);
		НоминалыЦенныхБумаг = РегистрыСведений.НоминалыЦенныхБумаг.СрезПоследних(Период.ДатаОкончания, Отбор);
		Если НоминалыЦенныхБумаг.Количество() > 0 Тогда
			РеквизитыФинВложения.Номинал = НоминалыЦенныхБумаг[0].Номинал;
		КонецЕсли;
		
	// Паи
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("СправочникСсылка.Паи") Тогда
		СтруктураРеквизитовПая = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФинВложение, "ПаевойИнвестиционныйФонд, ВалютаНоминала, ГосударственныйРегистрационныйНомер");
		СтруктураРеквизитовПИФ = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(СтруктураРеквизитовПая.ПаевойИнвестиционныйФонд, ЭтотОбъект.Период.ДатаОкончания);
		РеквизитыФинВложения.Эмитент           = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРеквизитовПИФ.УправляющаяКомпания, "ЮрФизЛицо");
		РеквизитыФинВложения.РегНомер          = СтруктураРеквизитовПая.ГосударственныйРегистрационныйНомер;
		РеквизитыФинВложения.НаименованиеФонда = СтруктураРеквизитовПИФ.ПолноеНаименованиеФонда;
		РеквизитыФинВложения.ВалютаНоминала    = СтруктураРеквизитовПая.ВалютаНоминала;
	// Депозитарные расписки
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("СправочникСсылка.ДепозитарныеРасписки") Тогда
		РеквизитыФинВложения.Эмитент      = ФинВложение.Эмитент.ЮрФизЛицо;
		РеквизитыФинВложения.РегНомер     = ФинВложение.РегистрационныйНомер;
		РеквизитыФинВложения.БазовыйАктив = ФинВложение.БазоваяЦБ;
	// Фьючерсы
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("СправочникСсылка.ПроизводныеФинансовыеИнструменты") 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФинВложение, "ТипПроизводногоФинансовогоИнструмента") = Перечисления.ТипыПроизводныхФинансовыхИнструментов.Фьючерс Тогда
		
		РеквизитыФинВложения.НаименованиеКонтракта   = СокрЛП(ФинВложение);
		РеквизитыФинВложения.ДатаИсполненияКонтракта = Формат(ФинВложение.Исполнение, "ДФ=dd.MM.yyyy");
		РеквизитыФинВложения.ВидКонтракта            = ?(ФинВложение.Поставочный, "Поставочный", "Расчетный");
		
	// Сделка СПФИ
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("ДокументСсылка.СделкаСПФИ") Тогда
		РеквизитыФинВложения.НаименованиеКонтракта   = "Процентный СВОП_"
			+ ?(ЗначениеЗаполнено(ФинВложение.СтавкаИсходящихПлатежей), СокрЛП(Строка(ФинВложение.СтавкаИсходящихПлатежей)), "<>") + " -FIX"
				+ "_" + ?(ЗначениеЗаполнено(ФинВложение.НомерСделки), СокрЛП(Строка(ФинВложение.НомерСделки)), "<>");
		РеквизитыФинВложения.ДатаИсполненияКонтракта = Формат(ФинВложение.ДатаИсполнения, "ДФ=dd.MM.yyyy");
		РеквизитыФинВложения.ВидКонтракта            = "Процентный СВОП";
	// Депозитарные вклады
	ИначеЕсли ТипЗнч(ФинВложение) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		РеквизитыФинВложения.Эмитент        = ФинВложение.БанковскийСчет.Банк.ЮрФизЛицо;
		РеквизитыФинВложения.НомерДоговора  = ФинВложение.БанковскийСчет.Договор.НомерДоговора;
		РеквизитыФинВложения.ВалютаНоминала = ФинВложение.БанковскийСчет.Валюта;
	// Остальное
	Иначе
		ВызватьИсключение "Обработка фин. вложения '" + ФинВложение + "' не поддерживается";
	КонецЕсли;
	
	Отбор = Новый Структура("ЮрФизЛицо, Язык, Подразделение", РеквизитыФинВложения.Эмитент, ПредопределенноеЗначение("Справочник.Языки.Русский"), ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	РеквизитыЭмитента = РегистрыСведений.РеквизитыЮридическихЛиц.СрезПоследних(Период.ДатаОкончания, Отбор);
	Если РеквизитыЭмитента.Количество() > 0 Тогда
		РеквизитыФинВложения.НаименованиеЭмитента = РеквизитыЭмитента[0].КраткоеНаименованиеПоУставу;
		Если ТипЗнч(ФинВложение) = Тип("СправочникСсылка.Облигации") Тогда
			РеквизитыФинВложения.НаименованиеЭмитента = РеквизитыФинВложения.НаименованиеЭмитента;
		КонецЕсли;
	КонецЕсли;
	
	Отбор = Новый Структура("Объект, ВидКода", ФинВложение, Перечисления.ВидыКодовВТорговыхСистемах.ISIN);
	КодыВТорговыхСистемах = РегистрыСведений.КодыВТорговыхСистемах.СрезПоследних(Период.ДатаОкончания, Отбор);
	Если КодыВТорговыхСистемах.Количество() > 0 Тогда
		РеквизитыФинВложения.ISIN = КодыВТорговыхСистемах[0].Код;
		
		Если Не ЗначениеЗаполнено(РеквизитыФинВложения.РегНомер) Тогда // Для еврооблигаций, у которых нет рег. номера, выводим ISIN
			РеквизитыФинВложения.РегНомер = РеквизитыФинВложения.ISIN;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РеквизитыФинВложения;
КонецФункции // ПолучитьРеквизитыФинВложения

Функция ПолучитьИменаПараметровОбластиТабличногоДокумента(Область) Экспорт
	
    ИменаПараметров = Новый Массив;
    
    Для НомерСтроки = 1 По Область.ВысотаТаблицы Цикл
        Для НомерКолонки = 1 По Область.ШиринаТаблицы Цикл
            Ячейка = Область.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
    		
    		Если Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр Тогда
                Если ИменаПараметров.Найти(Ячейка.Параметр) = Неопределено тогда
                    ИменаПараметров.Добавить(Ячейка.Параметр);
                КонецЕсли;
    			
    		ИначеЕсли Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон Тогда
                ТекстШаблона = Ячейка.Текст;
                ТекстШаблона = СтрЗаменить(ТекстШаблона, "[", Символы.ПС + "[");
                ТекстШаблона = СтрЗаменить(ТекстШаблона, "]", Символы.ПС);
    			
    			Для Счетчик = 1 По СтрЧислоСтрок(ТекстШаблона) Цикл
                    ТекСтрока = СтрПолучитьСтроку(ТекстШаблона, Счетчик);
                    Если Лев(ТекСтрока, 1) = "[" тогда
                        ИмяПараметра = Сред(ТекСтрока, 2);
                        Если ИменаПараметров.Найти(ИмяПараметра) = Неопределено тогда
                            ИменаПараметров.Добавить(ИмяПараметра);
                        КонецЕсли;
                    КонецЕсли;
    			КонецЦикла; 
    			
    		КонецЕсли; 
        КонецЦикла; 
    КонецЦикла;
 
    Возврат ИменаПараметров;
	
КонецФункции // ПолучитьИменаПараметровОбластиТабличногоДокумента

Процедура ЗаполнитьПараметрыОбластиСтрокиТаблицы(Область, ЗначенияПараметров, Отказ)
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	// Дополним параметры новыми значениями
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ФинВложение") Тогда
		Область.Параметры.Заполнить(ПолучитьРеквизитыФинВложения(ЗначенияПараметров.ФинВложение));
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "Операция") Тогда
		ДополнительнаяИнформация = Неопределено;
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ДополнительнаяИнформация") Тогда
			ДополнительнаяИнформация = ЗначенияПараметров.ДополнительнаяИнформация;
		КонецЕсли;
		Область.Параметры.ОписаниеОперации = ПолучитьОписаниеОперации(ЗначенияПараметров.Операция, Отказ, ДополнительнаяИнформация);
	КонецЕсли;
	
	// Представление пустых данных
	Для каждого ИмяПоля Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Валюта, ВалютаСделки, ВалютаНоминала, Номинал, Цена, ЦенаКупона",, Истина, Истина) Цикл
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, ИмяПоля)
			И Не ЗначениеЗаполнено(Область.Параметры[ИмяПоля])
			И Область.Параметры[ИмяПоля] <> 0
		Тогда
			Область.Параметры[ИмяПоля] = "-";
		КонецЕсли;
	КонецЦикла;
	
	ОснованиеЗадолженности = Неопределено;
	ВидЗадолженности = Неопределено;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ОснованиеЗадолженности", ОснованиеЗадолженности) И ЗначениеЗаполнено(ОснованиеЗадолженности) Тогда
		Если ТипЗнч(ОснованиеЗадолженности) = Тип("СправочникСсылка.ВидыЗадолженности")
			Или ТипЗнч(ОснованиеЗадолженности) = Тип("СправочникСсылка.Резервы")
		Тогда       
		
			ЭтоДефолтныйДепозитСмоленскогоБанка = ОснованиеЗадолженности = Справочники.ВидыЗадолженности.ПоПравамТребованияККредиторам И ЗначенияПараметров.Контрагент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрЛицо_СмоленскийБанк");
			
			Область.Параметры.ОснованиеЗадолженности = Строка(ОснованиеЗадолженности)
				+ ?(ЗначениеЗаполнено(ЗначенияПараметров.КонтрагентКраткоеНаименованиеПоУставу), ", " + ЗначенияПараметров.КонтрагентКраткоеНаименованиеПоУставу, "")
				+ ?(ЭтоДефолтныйДепозитСмоленскогоБанка,
					" (сумма требования " + Формат(ЗначенияПараметров.ОжидаемыеСредства, "ЧДЦ=2") + ")",
					"");
			Если ЭтоДефолтныйДепозитСмоленскогоБанка Тогда
				Область.Параметры.ОжидаемыеСредства = Неопределено;	
			КонецЕсли;
					
		Иначе
			Область.Параметры.ОснованиеЗадолженности = ПолучитьОписаниеОперации(ОснованиеЗадолженности, Отказ);
			Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ВидЗадолженности", ВидЗадолженности) И ЗначениеЗаполнено(ВидЗадолженности) Тогда
				Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода Тогда
					Область.Параметры.ОснованиеЗадолженности = "Возврат купона, "+ Область.Параметры.ОснованиеЗадолженности;
				КонецЕсли;
			КонецЕсли;
			Если ТипЗнч(ОснованиеЗадолженности) = Тип("ДокументСсылка.МНО") Тогда
				Область.Параметры.ОснованиеЗадолженности = Область.Параметры.ОснованиеЗадолженности
					+ ?(ЗначениеЗаполнено(ЗначенияПараметров.КонтрагентКраткоеНаименованиеПоУставу), ", " + ЗначенияПараметров.КонтрагентКраткоеНаименованиеПоУставу, "");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Переопределим значения параметров
	Для Каждого ИмяПоля Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		"Дата, ДатаСделки, ДатаОплаты, ДатаОплаты1, ДатаОплаты2, ДатаПоставки, ДатаПоставки1, ДатаПоставки2, ДатаИсполнения",, Истина, Истина
	) Цикл
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, ИмяПоля) Тогда
			Область.Параметры[ИмяПоля] = Формат(ЗначенияПараметров[ИмяПоля], "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	
	//Для Каждого ИмяПоля Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("Время, ВремяСделки",, Истина, Истина) Цикл
	//	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, ИмяПоля) Тогда
	//		Область.Параметры[ИмяПоля] = Формат(ЗначенияПараметров[ИмяПоля], "ДФ=ЧЧ:мм:сс");
	//	КонецЕсли;
	//КонецЦикла;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "МестоЗаключенияСделки") Тогда
		Если ЗначенияПараметров.МестоЗаключенияСделки = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			Область.Параметры.МестоЗаключенияСделки = "Внеб. рынок";
		Иначе
			Область.Параметры.МестоЗаключенияСделки = Область.Параметры.МестоЗаключенияСделки.Биржа;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "Сделка")
		И ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, "ПредставлениеСделки")
	Тогда
		Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ЭтоИзменениеСделки") Тогда
			ЭтоИзменениеСделки = ЗначенияПараметров.ЭтоИзменениеСделки;
		Иначе
			ЭтоИзменениеСделки = Ложь;
		КонецЕсли;
		
		Область.Параметры.ПредставлениеСделки = ?(ЭтоИзменениеСделки, "Изменение. ","") + ПолучитьОписаниеОперации(ЗначенияПараметров.Сделка);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "ДепозитныйВклад")
		И ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, "ДепозитныйВкладПредставление")
	Тогда
		Область.Параметры.ДепозитныйВкладПредставление = ПредставлениеДепозитногоВклада(ЗначенияПараметров.ДепозитныйВклад);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(ЗначенияПараметров, "МНО")
		И ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, "МНОПредставление")
	Тогда
		Область.Параметры.МНОПредставление =  ПредставлениеМНО(ЗначенияПараметров.МНО); 
	КонецЕсли;
КонецПроцедуры // ЗаполнитьПараметрыОбластиСтрокиТаблицы

Функция ПредставлениеДепозитногоВклада(ДепозитныйВклад)
	
	ПредставлениеДепозита = "";
	
	ВремЗапрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДепозитныеВклады.НомерПодтверждения КАК НомерПодтверждения,
	|	ДепозитныеВклады.ДатаПодтверждения КАК ДатаПодтверждения,
	|	ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора КАК НомерДоговора,
	|	ДепозитныеВклады.БанковскийСчет.Договор.ДатаЗаключения КАК ДатаЗаключения,
	|	ДепозитныеВклады.БанковскийСчет.Договор.ВидДоговора КАК ВидДоговора,
	|	ДепозитныеВклады.БанковскийСчет.ДоговорМНО.НомерДоговора КАК МНОНомерДоговора,
	|	ДепозитныеВклады.БанковскийСчет.ДоговорМНО.ДатаЗаключения КАК МНОДатаЗаключения
	|ИЗ
	|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	|ГДЕ
	|	ДепозитныеВклады.Ссылка = &Ссылка");
	
	ВремЗапрос.УстановитьПараметр("Ссылка", ДепозитныйВклад);
	
	Выборка = ВремЗапрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.МНОНомерДоговора <> NULL Тогда
			ПредставлениеДепозита = "Договор МНО " + Выборка.МНОНомерДоговора + " от " + Формат(Выборка.МНОДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
		ИначеЕсли Выборка.НомерДоговора <> NULL Тогда
			//Если Выборка.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания Тогда 
			//	ПредставлениеДепозита = "Договор банк. обслуживания " + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
			//ИначеЕсли Выборка.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоДепозита Тогда
			//	ПредставлениеДепозита = "Договор банк. депозита " + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
			//Иначе
				ПредставлениеДепозита = "Договор " + НРег(Выборка.ВидДоговора) + " " + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
			//КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.НомерПодтверждения) Тогда
				ПредставлениеДепозита = ПредставлениеДепозита + ", подтверждение " + Выборка.НомерПодтверждения + " от " + Формат(Выборка.ДатаПодтверждения, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ПредставлениеДепозита; 

КонецФункции

Функция ПредставлениеМНО(МНО)
	
	ПредставлениеМНО = "";
	
	ВремЗапрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомераОбъектов.Номер КАК НомерПодтверждения,
	|	МНО.Дата КАК ДатаПодтверждения,
	|	МНО.РасчетныйСчет.Договор.НомерДоговора КАК НомерДоговора,
	|	МНО.РасчетныйСчет.Договор.ДатаЗаключения КАК ДатаЗаключения,
	|	МНО.РасчетныйСчет.ДоговорМНО.НомерДоговора КАК МНОНомерДоговора,
	|	МНО.РасчетныйСчет.ДоговорМНО.ДатаЗаключения КАК МНОДатаЗаключения
	|ИЗ
	|	Документ.МНО КАК МНО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
	|		ПО МНО.Организация = НомераОбъектов.Организация
	|			И МНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
	|			И МНО.Основание = НомераОбъектов.Объект
	|			И (ГОД(МНО.Дата) = НомераОбъектов.Год)
	|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
	|ГДЕ
	|	МНО.Ссылка = &Ссылка");
	
	ВремЗапрос.УстановитьПараметр("Ссылка", МНО);
	
	Выборка = ВремЗапрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.МНОНомерДоговора <> NULL Тогда
			ПредставлениеМНО = "Договор МНО " + Выборка.МНОНомерДоговора + " от " + Формат(Выборка.МНОДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
		ИначеЕсли Выборка.НомерДоговора <> NULL Тогда
			ПредставлениеМНО = "Договор банк. обслуживания " + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " ";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерПодтверждения) Тогда
			ПредставлениеМНО = ПредставлениеМНО + ", подтверждение " + РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(Выборка.НомерПодтверждения) + " от " + Формат(Выборка.ДатаПодтверждения, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	КонецЕсли;

	Возврат ПредставлениеМНО;
	
КонецФункции

Функция ВывестиТаблицуОтчета(ИсточникДанных, ТаблицаОтчета, Области, ВыводитьПустуюТаблицу = Ложь)
	// Определимся со строкой "Итого"
	ЕстьСтрокаИтого = Области.Свойство("СтрокаИтого");
	ЗначПолейИтого  = Новый Структура;
	
	Если ЕстьСтрокаИтого Тогда
		Для Каждого ИмяПараметра Из ПолучитьИменаПараметровОбластиТабличногоДокумента(Области.СтрокаИтого) Цикл
			ЗначПолейИтого.Вставить(ИмяПараметра, 0);
		КонецЦикла;
	КонецЕсли;
	
	Если ИсточникДанных.Количество() = 0 И Не ВыводитьПустуюТаблицу Тогда
		Возврат ЗначПолейИтого;
	КонецЕсли;
	
	Если ТаблицаОтчета <> Неопределено Тогда
		// Заголовок таблицы
		Если Области.Свойство("Заголовок") Тогда
			ТаблицаОтчета.Вывести(Области.Заголовок);
		КонецЕсли;
		
		// Шапка таблицы
		ТаблицаОтчета.НачатьГруппуСтрок();
		ТаблицаОтчета.Вывести(Области.ШапкаТаблицы);
	КонецЕсли;
	
	Если ВыводитьПустуюТаблицу И ИсточникДанных.Количество() = 0 Тогда
		Возврат ЗначПолейИтого;
	КонецЕсли;
	
	// Строки таблицы
	Если ТипЗнч(ИсточникДанных) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Пока ИсточникДанных.Следующий() Цикл
			ВывестиЭлементКоллекции(ТаблицаОтчета, Области, ИсточникДанных, ЗначПолейИтого);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ИсточникДанных) = Тип("ТаблицаЗначений") Или ТипЗнч(ИсточникДанных) = Тип("КоллекцияСтрокДереваЗначений") Тогда
		Для Каждого СтрокаИсточникДанных Из ИсточникДанных Цикл
			ВывестиЭлементКоллекции(ТаблицаОтчета, Области, СтрокаИсточникДанных, ЗначПолейИтого);
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаОтчета <> Неопределено Тогда
		// Итого
		Если ЕстьСтрокаИтого Тогда
			Области.СтрокаИтого.Параметры.Заполнить(ЗначПолейИтого);
			ТаблицаОтчета.Вывести(Области.СтрокаИтого);
		КонецЕсли;
		
		ТаблицаОтчета.ЗакончитьГруппуСтрок();
	КонецЕсли;
	
	Возврат ЗначПолейИтого;
КонецФункции // ВывестиТаблицуОтчета

Процедура ВывестиЭлементКоллекции(ТаблицаОтчета, Области, ЭлементКоллекции, ЗначПолейИтого)
	Отказ = Ложь;
	
	Если ТаблицаОтчета <> Неопределено Тогда
		ЗаполнитьПараметрыОбластиСтрокиТаблицы(Области["СтрокаТаблицы"], ЭлементКоллекции, Отказ);
		ОбластьЯчеек = ТаблицаОтчета.Вывести(Области["СтрокаТаблицы"]);
		
		Если Отказ Тогда
			ОбластьЯчеек.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗнач Из ЗначПолейИтого Цикл
		ЗначПолейИтого[КлючЗнач.Ключ] = КлючЗнач.Значение + ?(ЭлементКоллекции[КлючЗнач.Ключ] = NULL, 0, ЭлементКоллекции[КлючЗнач.Ключ]);
	КонецЦикла;
КонецПроцедуры // ВывестиЭлементКоллекции
Функция ВывестиТаблицуГолосованийПоЦеннымБумагам(МакетОтчета, ТаблицаОтчета, Запрос)

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧКлиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументГолосования.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДокументГолосования.ДатаГолосования КАК ДатаГолосования,
		|	ДокументГолосования.ДатаСобранияНачало КАК ДатаСобранияНачало,
		|	ДокументГолосования.ДатаСобранияОкончание КАК ДатаСобранияОкончание,
		|	ТЧВопросы.ВопросПовесткиДня КАК ВопросПовесткиДня,
		|	ТЧВопросы.ВариантГолосования КАК ВариантГолосования,
		|	ТЧВопросы.НомерСтроки КАК НомерВопроса
		|ИЗ
		|	Документ.ОсуществлениеПраваГолосаПоЦеннымБумагам КАК ДокументГолосования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОсуществлениеПраваГолосаПоЦеннымБумагам.Клиенты КАК ТЧКлиенты
		|		ПО ДокументГолосования.Ссылка = ТЧКлиенты.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОсуществлениеПраваГолосаПоЦеннымБумагам.ВопросыПовестки КАК ТЧВопросы
		|		ПО ДокументГолосования.Ссылка = ТЧВопросы.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК СчетаДУ
		|		ПО СчетаДУ.Организация = ДокументГолосования.Организация
		|			И СчетаДУ.СчетДоверительногоУправления = ТЧКлиенты.СчетДоверительногоУправления
		|ГДЕ
		|	ДокументГолосования.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА ДокументГолосования.ДатаГолосования = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ДокументГолосования.Дата
		|			ИНАЧЕ ДокументГолосования.ДатаГолосования
		|		КОНЕЦ МЕЖДУ &ДатаНачалаГолосований И &ДатаОкончанияГолосований
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТЧКлиенты.СчетДоверительногоУправления,
		|	ДокументГолосования.ЦеннаяБумага,
		|	ДокументГолосования.ДатаГолосования,
		|	ДокументГолосования.ДатаСобранияНачало,
		|	ТЧВопросы.НомерСтроки
		|ИТОГИ ПО
		|	ТЧКлиенты.СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("ДатаНачалаГолосований",    НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончанияГолосований", КонецДня(ЭтотОбъект.Период.ДатаОкончания));

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбластьКлиента = МакетОтчета.ПолучитьОбласть("ГолосованияПоЦБ_СтрокаКлиент");
	ОбластьШапки   = МакетОтчета.ПолучитьОбласть("ГолосованияПоЦБ_ШапкаТаблицы");
	ОбластьСтроки  = МакетОтчета.ПолучитьОбласть("ГолосованияПоЦБ_СтрокаТаблицы");

	ВыборкаСчет = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСчет.Следующий() Цикл

		ТаблицаОтчета.Вывести(ОбластьКлиента);

		// Шапка таблицы + строки данных в одну сворачиваемую группу
		ТаблицаОтчета.НачатьГруппуСтрок();
		ТаблицаОтчета.Вывести(ОбластьШапки);

		ВыборкаСтрока = ВыборкаСчет.Выбрать();
		Пока ВыборкаСтрока.Следующий() Цикл
			ОбластьСтроки.Параметры.ЦеннаяБумага       = Строка(ВыборкаСтрока.ЦеннаяБумага);
			ОбластьСтроки.Параметры.Собрание            = ПредставлениеСобранияГолосования(ВыборкаСтрока);
			ОбластьСтроки.Параметры.ВопросПовесткиДня  = Строка(ВыборкаСтрока.ВопросПовесткиДня);
			ОбластьСтроки.Параметры.ВариантГолосования = Строка(ВыборкаСтрока.ВариантГолосования);
			ТаблицаОтчета.Вывести(ОбластьСтроки);
		КонецЦикла;

		ТаблицаОтчета.ЗакончитьГруппуСтрок();

	КонецЦикла;

	Возврат Истина;

КонецФункции // ВывестиТаблицуГолосованийПоЦеннымБумагам
Функция ПредставлениеСобранияГолосования(Выборка)

	Если ЗначениеЗаполнено(Выборка.ДатаСобранияОкончание)
		И Выборка.ДатаСобранияОкончание <> Выборка.ДатаСобранияНачало Тогда
		Возврат "с " + Формат(Выборка.ДатаСобранияНачало, "ДФ=dd.MM.yyyy")
			+ " по " + Формат(Выборка.ДатаСобранияОкончание, "ДФ=dd.MM.yyyy");
	ИначеЕсли ЗначениеЗаполнено(Выборка.ДатаСобранияНачало) Тогда
		Возврат Формат(Выборка.ДатаСобранияНачало, "ДФ=dd.MM.yyyy");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции // ПредставлениеСобранияГолосования

#КонецОбласти

