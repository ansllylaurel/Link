Функция ПолучитьОсновнойСертификатКлючаЭЦП() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СертификатыКлючейЭЦП.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СертификатыКлючейЭЦП КАК СертификатыКлючейЭЦП
		|ГДЕ
		|	СертификатыКлючейЭЦП.Организация = &Организация
		|	И СертификатыКлючейЭЦП.Субъект = &Субъект
		|	И &ТекущаяДата МЕЖДУ СертификатыКлючейЭЦП.НачалоДействия И СертификатыКлючейЭЦП.ОкончаниеДействия
		|
		|УПОРЯДОЧИТЬ ПО
		|	СертификатыКлючейЭЦП.ОкончаниеДействия УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Субъект", ЭтотОбъект.Подписант);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.СертификатыКлючейЭЦП.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции // ПолучитьОсновнойСертификатКлючаЭЦП

Функция ПолучитьСписокКонтактныхЛиц() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО Организации.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И КонтактныеЛица.КонтактноеЛицо ССЫЛКА Справочник.ЮрФизЛица
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтактноеЛицо.Наименование";
		
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	СписокКонтактныхЛиц = Новый СписокЗначений;
	СписокКонтактныхЛиц.ЗагрузитьЗначения(
			Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо"));
			
	Возврат СписокКонтактныхЛиц;
	
КонецФункции

#КонецОбласти
