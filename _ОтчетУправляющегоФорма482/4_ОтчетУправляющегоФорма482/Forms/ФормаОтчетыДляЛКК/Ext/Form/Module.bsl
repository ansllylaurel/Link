&НаСервере
Функция ЗаполнитьСчетаДоверительногоУправленияНаСервере()
	
	ЭтаФорма.СчетаДоверительногоУправления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК МатрихИд,
		|	СУММА(ЕСТЬNULL(ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот, 0)) КАК РыночнаяСтоимостьОборот,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК СтоимостьАктивовНаКонецГода
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончанияПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаОкончанияПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодыВоВнешнихСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
		|				,
		|				&ДатаОкончанияПериода,
		|				,
		|				Организация = &Организация
		|					И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|					И ВидОперацииВводаВыводаДС = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
		|		ПО СчетаДоверительногоУправления.Ссылка = ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончанияПериода, ДЕНЬ)
		|			И ФинансовыеПоказатели.Организация = &Организация
		|			И ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка
		|			И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет),
		|		ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончанияПериода
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачалаПериода
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|
		|СГРУППИРОВАТЬ ПО
		|	СчетаДоверительногоУправления.Ссылка,
		|	СчетаДоверительногоУправления.КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления,
		|	КодыВоВнешнихСистемахСрезПоследних.Код,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0)
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕСТЬNULL(ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот, 0)) > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДоверительногоУправления.Наименование";
	
	Если ЭтаФорма.ИсключатьСчетаДоверительногоУправленияЗакрытыеЗаПериод Тогда
		Запрос.Текст = СтрЗаменить(
				Запрос.Текст,
				"СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачалаПериода",
				"СчетаДоверительногоУправления.ДатаРасторжения > &ДатаОкончанияПериода");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	Запрос.УстановитьПараметр("ДатаНачалаПериода", Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", Отчет.Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.СчетаДоверительногоУправления.Добавить(), Выборка);
	КонецЦикла;
	
КонецФункции // ЗаполнитьСчетаДоверительногоУправленияНаСервере

&НаКлиенте
Процедура УстановитьФлажкиВТаблицеНаФорме(ИмяТаблицы, Флажок, ИмяКолонки = "Флажок")
	
	Для каждого СтрокаТаблицы Из ЭтаФорма[ИмяТаблицы] Цикл
		СтрокаТаблицы[ИмяКолонки] = Флажок;
	КонецЦикла;
	
КонецПроцедуры // УстановитьФлажкиВТаблицеНаФорме

&НаКлиенте
Процедура СохранитьРеестр()
	
	Date_report = Формат(Отчет.Период.ДатаОкончания, "ДФ=ггггММдд");
	
	XML = Новый ЗаписьXML;
	
	Попытка
		XML.ОткрытьФайл(ЭтаФорма.КаталогФайлов + ?(Прав(ЭтаФорма.КаталогФайлов, 1) = "\", "", "\") + "Reports_482_" + Date_report + "_" + Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс") + ".xml");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	XML.ЗаписатьОбъявлениеXML();
	XML.ЗаписатьНачалоЭлемента("Reports");
	
	Для каждого СтрокаСчетаДоверительногоУправления Из СчетаДоверительногоУправления Цикл
		
		Если Не СтрокаСчетаДоверительногоУправления.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		XML.ЗаписатьНачалоЭлемента("Report");
		XML.ЗаписатьАтрибут("Date_report", Date_report);
		XML.ЗаписатьАтрибут("Matrix_User_ID", СтрокаСчетаДоверительногоУправления.МатрихИд);
		XML.ЗаписатьАтрибут("ReportType", "Report.482");
		XML.ЗаписатьАтрибут("subdir", "");
		XML.ЗаписатьАтрибут("type", "pdf");
		XML.ЗаписатьАтрибут("type_file", "application/pdf");
		XML.ЗаписатьАтрибут("Name", СтрокаСчетаДоверительногоУправления.ИмяФайла + ".pdf");
		XML.ЗаписатьКонецЭлемента(); // Report
		
	КонецЦикла;
	
	XML.ЗаписатьКонецЭлемента(); // Reports
	
	XML.Закрыть()
	
КонецПроцедуры // СохранитьРеестр

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Отчет.Период.ДатаНачала    = НачалоКвартала(ДобавитьМесяц(ТекущаяДата(), -1));
	Отчет.Период.ДатаОкончания = КонецКвартала(ДобавитьМесяц(ТекущаяДата(), -1));
	
	Отчет.ДокументПодписанЭЦП = Истина; // для ЛКК отчеты должны быть подписаны
	
	Если ЭтаФорма.Параметры.Свойство("РеквизитыОтчета") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Отчет, ЭтаФорма.Параметры.РеквизитыОтчета);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Отчет"));
	
	Если Не ЗначениеЗаполнено(Отчет.Подписант) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Подписант"" не заполнено", ЭтаФорма, "Отчет.Подписант",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.СертификатКлючаЭЦП) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Сертификат ключа ЭЦП"" не заполнено", ЭтаФорма, "Отчет.СертификатКлючаЭЦП",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ЗаполнитьСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключатьСчетаДоверительногоУправленияЗакрытыеЗаПериодПриИзменении(Элемент)
	
	ЗаполнитьСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры


&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокКонтактныхЛиц = ПолучитьСписокКонтактныхЛицНаСервере();
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		
		Отчет.Подписант = РезультатВыбора.Значение;
		
		Если Отчет.ДокументПодписанЭЦП Тогда
			ЗаполнитьСертификатКлючаЭЦПНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ЭтаФорма.КаталогФайлов) Тогда
		ЗапуститьПриложение(ЭтаФорма.КаталогФайлов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьОтчеты(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ЭтаФорма.КаталогФайлов, Отказ);
	
	Если Отказ Тогда
		Сообщить("Сохранение отчетов прервано");
		Возврат;
	КонецЕсли; 
	
	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить("Организация",       Отчет.Организация);
	НастройкиОтчета.Вставить("Период",             Отчет.Период);
	НастройкиОтчета.Вставить("Подписант",          Отчет.Подписант);
	НастройкиОтчета.Вставить("ДокументПодписанЭЦП", Отчет.ДокументПодписанЭЦП);
	НастройкиОтчета.Вставить("СертификатКлючаЭЦП",  Отчет.СертификатКлючаЭЦП);
	
	// Q4: период заканчивается последним днём декабря квартала
	ЭтоЧетвертыйКвартал = (КонецКвартала(Отчет.Период.ДатаОкончания) = Отчет.Период.ДатаОкончания)
		И (Месяц(Отчет.Период.ДатаОкончания) = 12);
		
	Для каждого СтрокаСчетаДоверительногоУправления Из СчетаДоверительногоУправления Цикл
		
		Если Не СтрокаСчетаДоверительногоУправления.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиОтчета.Вставить("КлиентДоверительногоУправления", СтрокаСчетаДоверительногоУправления.СчетДоверительногоУправления);
				
		ИмяФайла = "Report_482_" + Формат(Отчет.Период.ДатаОкончания, "ДФ='кк_''Quarter''_гггг'") + "_" + СтрокаСчетаДоверительногоУправления.НомерДоговора;
		ИмяФайла = СтрЗаменить(ИмяФайла, "\", "_");
		ИмяФайла = СтрЗаменить(ИмяФайла, "/", "_");
		
		СтрокаСчетаДоверительногоУправления.ИмяФайла = ИмяФайла;
		
		ИмяФайла = ЭтаФорма.КаталогФайлов + ?(Прав(ЭтаФорма.КаталогФайлов, 1) = "\", "", "\") + ИмяФайла + ".pdf";
		
		ФормаОтчета = ПолучитьФорму("ВнешнийОтчет._ОтчетУправляющегоФорма482.Форма.ФормаОтчета",, ЭтаФорма);
		
		ЗаполнитьЗначенияСвойств(ФормаОтчета.Отчет, НастройкиОтчета);
		
		Если Не ФормаОтчета.ПроверитьЗаполнение() Тогда
			Прервать;
		КонецЕсли;
			
		ФормаОтчета.СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
		
		Попытка 
			ФормаОтчета.ТаблицаОтчета.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + ". Сохранение отчетов прервано",,,, Отказ);
			Прервать;
		КонецПопытки;
		
		// Для целевых капиталов при Q4 + активы > 45 млн — дополнительно сохранить годовой отчёт
		Если ЭтоЧетвертыйКвартал
			И СтрокаСчетаДоверительногоУправления.ВидДоговора
				= ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов")
			И СтрокаСчетаДоверительногоУправления.СтоимостьАктивовНаКонецГода > 45000000 Тогда
			
			НастройкиГодовой = Новый Структура;
			ЗаполнитьЗначенияСвойств(НастройкиГодовой, НастройкиОтчета);
			ГодовойПериод = Новый СтандартныйПериод;
			ГодовойПериод.ДатаНачала    = НачалоГода(Отчет.Период.ДатаОкончания);
			ГодовойПериод.ДатаОкончания = КонецГода(Отчет.Период.ДатаОкончания);
			НастройкиГодовой.Период = ГодовойПериод;
			
			ИмяФайлаГодовой = "Report_482_Annual_" + Формат(КонецГода(Отчет.Период.ДатаОкончания), "ДФ=гггг") + "_" + СтрокаСчетаДоверительногоУправления.НомерДоговора;
			ИмяФайлаГодовой = СтрЗаменить(ИмяФайлаГодовой, "\", "_");
			ИмяФайлаГодовой = СтрЗаменить(ИмяФайлаГодовой, "/", "_");
			ИмяФайлаГодовой = ЭтаФорма.КаталогФайлов + ?(Прав(ЭтаФорма.КаталогФайлов, 1) = "\", "", "\") + ИмяФайлаГодовой + ".pdf";
			
			ФормаОтчетаГодовой = ПолучитьФорму("ВнешнийОтчет._ОтчетУправляющегоФорма482.Форма.ФормаОтчета",, ЭтаФорма);
			ЗаполнитьЗначенияСвойств(ФормаОтчетаГодовой.Отчет, НастройкиГодовой);
			ФормаОтчетаГодовой.СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
			
			Попытка
				ФормаОтчетаГодовой.ТаблицаОтчета.Записать(ИмяФайлаГодовой, ТипФайлаТабличногоДокумента.PDF);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + ". Сохранение годового отчёта прервано",,,, Отказ);
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Если Не Отказ Тогда
		СохранитьРеестр();	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выполнение завершено");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ЗаполнитьСчетаДоверительногоУправленияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	УстановитьФлажкиВТаблицеНаФорме("СчетаДоверительногоУправления", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	УстановитьФлажкиВТаблицеНаФорме("СчетаДоверительногоУправления", Ложь);
	
КонецПроцедуры

