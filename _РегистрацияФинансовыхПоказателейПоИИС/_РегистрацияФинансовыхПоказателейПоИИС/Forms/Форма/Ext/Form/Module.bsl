
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	
	Объект.КоличествоПоказателей = 1;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	КаталогСохранения = ОбъектНаСервере.ПолучитьБазовыйКаталогДоходности();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УстановитьУсловноеОформлениеПоказателей();
	
	Если Элементы.Найти("ГруппаОтчетОРасхождениях") <> Неопределено Тогда
		Элементы.ГруппаОтчетОРасхождениях.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ДанныеОбновлены = КомандаОбновитьНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если ДанныеОбновлены Тогда
		Предупреждение("Показатели обновлены");
	Иначе
		Предупреждение("Обновление показателей не требуется");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаОбновитьНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ДанныеОбновлены = ОбъектНаСервере.ОбновитьФинансовыеПоказатели();
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	Возврат ДанныеОбновлены;
	
КонецФункции

&НаКлиенте
Процедура КомандаЗарегистрировать(Команда)
	
	Количество = КомандаЗарегистрироватьНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если Количество > 0 Тогда
		Предупреждение("Зарегистрировано документов: " + Количество);
	Иначе
		Предупреждение("Регистрация не требуется");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаЗарегистрироватьНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Количество = ОбъектНаСервере.ЗарегистрироватьФинансовыеПоказателиПоРасхождениям();
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	Возврат Количество;
	
КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПоказателей()
	
	Для Номер = 1 По 10 Цикл
	
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Текущее" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Расчетное" + Номер);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ЭтоНовыйДокумент");
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Ложь;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
		
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ВидПоказателя" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиВидПоказателя" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	ДанныеОбъекта = Форма.Объект;
	Элементы = Форма.Элементы;

	Для Номер = 1 По 10 Цикл
		Элементы["ФинансовыеПоказателиВидПоказателя" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Текущее" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Расчетное" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Вопрос(
		"Обновить показатели за " + Формат(Объект.Период, "ДФ=dd.MM.yyyy") + "?",
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Да) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура КомандаОтправитьОтчетНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ОтправитьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтправитьОтчет(Команда)
	
	РезультатВопроса = Вопрос("Сформированный отчет по доходностям будет отправлен на почту указанным получателям и выгружен на сайт", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		КомандаОтправитьОтчетНаСервере();			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаСформироватьИСохранитьXML(Команда)
	
	БазовыйКаталог = КаталогСохранения;
	Если ПустаяСтрока(БазовыйКаталог) Тогда
		Предупреждение("Не задан каталог сохранения");
		Возврат;
	КонецЕсли;
	
	СуществующиеФайлы = ПолучитьСуществующиеФайлыXMLНаСервере(БазовыйКаталог);
	Если СуществующиеФайлы.Количество() > 0 Тогда
		Если Вопрос(
			"В каталоге уже есть файлы (" + СуществующиеФайлы.Количество() + " шт.). Будут перезаписаны. Продолжить?",
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КомандаСформироватьИСохранитьXMLНаСервере(БазовыйКаталог, Истина);
	Предупреждение("XML сформированы и сохранены");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуществующиеФайлыXMLНаСервере(БазовыйКаталог)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектНаСервере.ПолучитьИменаСуществующихФайловXML(БазовыйКаталог);
	
КонецФункции

&НаСервере
Процедура КомандаСформироватьИСохранитьXMLНаСервере(БазовыйКаталог, Перезаписывать)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.СформироватьИСохранитьXML(БазовыйКаталог, Перезаписывать);
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНайтиРасхождения(Команда)
	
	БазовыйКаталог = КаталогСохранения;
	Если ПустаяСтрока(БазовыйКаталог) Тогда
		Предупреждение("Не задан каталог сохранения");
		Возврат;
	КонецЕсли;
	
	СуществующиеФайлы = ПолучитьСуществующиеФайлыXMLНаСервере(БазовыйКаталог);
	Если СуществующиеФайлы.Количество() > 0 Тогда
		Если Вопрос(
			"В каталоге уже есть файлы (" + СуществующиеФайлы.Количество() + " шт.). Будут перезаписаны. Продолжить?",
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КомандаНайтиРасхожденияНаСервере(БазовыйКаталог);
	
	Если ПустаяСтрока(ОтчетОРасхожденияхHTML) Тогда
		Предупреждение("Расхождений не найдено. XML отправлены на сайт.");
	Иначе
		Предупреждение("Найдены расхождения. Отчет отображен на форме.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаНайтиРасхожденияНаСервере(БазовыйКаталог)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектНаСервере.НайтиРасхожденияИПриОтсутствииОпубликовать(БазовыйКаталог, Истина);
	
	ЭтотОбъект.ОтчетОРасхожденияхHTML = Результат.HTML;
	
	Если Элементы.Найти("ГруппаОтчетОРасхождениях") <> Неопределено Тогда
		Элементы.ГруппаОтчетОРасхождениях.Видимость = Не ПустаяСтрока(ОтчетОРасхожденияхHTML);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
КонецПроцедуры

