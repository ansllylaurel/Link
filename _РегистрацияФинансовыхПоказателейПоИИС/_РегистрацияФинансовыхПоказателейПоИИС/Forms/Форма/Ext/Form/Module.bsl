
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	
	Объект.КоличествоПоказателей = 1;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УстановитьУсловноеОформлениеПоказателей();
	УстановитьОтборСтрок(Элементы, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаЗарегистрироватьФинансовыеПоказатели(Команда)
	
	ДанныеОбновлены = КомандаЗарегистрироватьФинансовыеПоказателиНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если ДанныеОбновлены Тогда
		Предупреждение("Показатели зарегистрированы");
	Иначе
		Предупреждение("Обновление показателей не требуется");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаЗарегистрироватьФинансовыеПоказателиНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	//ДанныеОбновлены = ОбъектНаСервере.РассчитатьИЗарегистрироватьФинансовыеПоказатели();
	//ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	ОбъектНаСервере.ВыполнитьРазмещениеДоходностиНаСайте("de.tarasov@region.ru");
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура КомандаПоказатьВсе(Команда)
	
	УстановитьОтборСтрок(Элементы, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьТолькоИзмененные(Команда)
	
	УстановитьОтборСтрок(Элементы, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПоказателей()
	
	Для Номер = 1 По 10 Цикл
	
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Текущее" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Расчетное" + Номер);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ЭтоНовыйДокумент");
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Ложь;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
		
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ВидПоказателя" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиВидПоказателя" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	ДанныеОбъекта = Форма.Объект;
	Элементы = Форма.Элементы;

	Для Номер = 1 По 10 Цикл
		Элементы["ФинансовыеПоказателиВидПоказателя" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Текущее" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Расчетное" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтрок(Элементы, ПоказатьТолькоИзмененные)

	Если ПоказатьТолькоИзмененные Тогда
		ОтборСтрок = Новый Структура("ЕстьРасхождения", Истина);
	Иначе
		ОтборСтрок = Новый Структура;
	КонецЕсли;
	
	Элементы.ФинансовыеПоказателиКомандаПоказатьВсе.Пометка = Не ПоказатьТолькоИзмененные;
	Элементы.ФинансовыеПоказателиКомандаПоказатьТолькоИзмененные.Пометка = ПоказатьТолькоИзмененные;
	
	Элементы.ПодменюПоказать.Заголовок = "Показать " + ?(ПоказатьТолькоИзмененные, "только измененные", "все");
	
	Элементы.ФинансовыеПоказатели.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

КонецПроцедуры

#КонецОбласти

