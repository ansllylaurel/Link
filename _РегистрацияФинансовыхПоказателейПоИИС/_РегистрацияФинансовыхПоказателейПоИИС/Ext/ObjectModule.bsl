// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Регистрация финансовых показателей по ИИС", 
		"0.15", 
		"", 
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтправитьОтчет", "Отправить отчет",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "РегистрацияФинансовыхПоказателей", "Регистрация финансовых показателей",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.Период = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
	Попытка
	Если ИдентификаторКоманды = "ОтправитьОтчет" Тогда
		Если Не ОтправитьОтчет() Тогда
			ДобавитьТекстОшибки(ПараметрыСессии, "Не задан базовый каталог доходности");
		КонецЕсли;
	Иначе
		Календари = Справочники.Календари;
		Если Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, НачалоМесяца(ТекущаяДата()), 5) = НачалоДня(ТекущаяДата()) Тогда
			РассчитатьИЗарегистрироватьФинансовыеПоказатели();
		КонецЕсли;
		
	КонецЕсли;
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры // ВыполнитьКоманду

Функция ОтправитьОтчет() Экспорт
	
	БазовыйКаталог = ПолучитьБазовыйКаталогДоходности();
	Если Не ПроверитьБазовыйКаталог(БазовыйКаталог) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СформироватьИСохранитьXML(БазовыйКаталог, Истина);
	
	РезультатВыполнения = ОтправитьИОпубликоватьНаСайте(БазовыйКаталог);
	
	// При расхождениях публикация не выполняется – отдельным письмом отправляется
	// оповещение о расхождениях и оповещение с отчётом о доходностях.
	Если Не РезультатВыполнения.Успех Тогда
		ОтправитьОповещениеОРасхождениях(РезультатВыполнения.РезультатСверки);
		ОтправитьОповещениеОДоходностях(БазовыйКаталог);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОтправитьОповещениеОДоходностях(БазовыйКаталог)
	
	ДанныеДоходности = ПолучитьДанныеДляДоходности();
	
	Макет = ПолучитьМакет("РегистрацияФинансовыхПоказателей");
	
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтратегия    = Макет.ПолучитьОбласть("Стратегия");
	ОбластьРезультат    = Макет.ПолучитьОбласть("Результат");
	ОбластьОшибка       = Макет.ПолучитьОбласть("Ошибка");
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ОбластьШапка.Параметры.Период = Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ВыборкаСтратегии = ДанныеДоходности.ПоказателиОтчёта.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтратегии.Следующий() Цикл
		
		ОбластьСтратегия.Параметры.Заполнить(ВыборкаСтратегии);
		ТабличныйДокумент.Вывести(ОбластьСтратегия);
		
		Выборка = ВыборкаСтратегии.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ВидПоказателя = Null Тогда
				ОбластьОшибка.Параметры.ТекстОшибки = "Показатели не зарегистрированы";
				ТабличныйДокумент.Вывести(ОбластьОшибка);
			Иначе
				ОбластьРезультат.Параметры.Результат = Строка(Выборка.ВидПоказателя) + ": " + Выборка.Значение;
				ТабличныйДокумент.Вывести(ОбластьРезультат);
			КонецЕсли;
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("htm");
	ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяВременногоФайла);
	
	КаталогПериода = ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог);
	Вложения = ПрочитатьВложенияXMLИзКаталога(КаталогПериода);
	
	РеквизитыОповещения = Новый Структура;
	РеквизитыОповещения.Вставить("Организация", ЭтотОбъект.Организация);
	РеквизитыОповещения.Вставить("Период",      ЭтотОбъект.Период);
	РеквизитыОповещения.Вставить("Текст",       ТелоПисьма.ПолучитьТекст());
	РеквизитыОповещения.Вставить("Вложения",    Вложения);
	
	Справочники.Оповещения.СформироватьОповещения(
		"ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОповещениеОДоходностях()",
		Перечисления.ТипыСобытий.ВнешнийВызов,
		РеквизитыОповещения);
	
КонецПроцедуры

Функция ПолучитьДанныеДляДоходности()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",      ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Показатели",  ПолучитьПоказателиСтандартнойСтратегии());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия
		|ПОМЕСТИТЬ _СтандартныеСтратегии
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестирования.Организация = &Организация
		|	И НЕ СтратегииИндивидуальногоИнвестирования.ПометкаУдаления
		|	И СтратегииИндивидуальногоИнвестирования.Стандартная
		|	И СтратегииИндивидуальногоИнвестирования.НачалоДействияСтратегии <= &Период
		|	И (СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ФинансовыеПоказатели.ВидПоказателя ЕСТЬ NULL
		|			ТОГДА ""0""
		|		ИНАЧЕ _СтандартныеСтратегии.Стратегия.Наименование
		|	КОНЕЦ КАК ПорядокСтратегия,
		|	_СтандартныеСтратегии.Стратегия КАК Стратегия,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ПоказателиОтчёта
		|ИЗ
		|	_СтандартныеСтратегии КАК _СтандартныеСтратегии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _СтандартныеСтратегии.Стратегия = ФинансовыеПоказатели.СубъектАналитики
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = &Период)
		|			И (ФинансовыеПоказатели.ВидПоказателя В (&Показатели))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.СубъектАналитики КАК Стратегия,
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.ВидПоказателя.ИмяПредопределенныхДанных КАК ИмяПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ПоказателиXML
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, МЕСЯЦ)
		|	И ФинансовыеПоказатели.ВидПоказателя В(&Показатели)
		|	И ФинансовыеПоказатели.СубъектАналитики В
		|			(ВЫБРАТЬ
		|				_СтандартныеСтратегии.Стратегия
		|			ИЗ
		|				_СтандартныеСтратегии КАК _СтандартныеСтратегии)";
	
	Запрос.Выполнить();
	
	ПоказателиОтчёта = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос, "_ПоказателиОтчёта",,,, "ПорядокСтратегия, ВидПоказателя.ИмяПредопределенныхДанных", "Стратегия");
	
	ПоказателиXML = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос, "_ПоказателиXML",,,, "Стратегия, Период, ИмяПоказателя", "Стратегия, Период");
	
	Результат = Новый Структура;
	Результат.Вставить("ПоказателиОтчёта", ПоказателиОтчёта);
	Результат.Вставить("ПоказателиXML",    ПоказателиXML);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьXMLВложенияПоСтратегиям(РезультатЗапросаXML)
	
	Вложения = Новый Соответствие;
	
	ВыборкаСтратегии = РезультатЗапросаXML.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтратегии.Следующий() Цикл
	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		ИмяВложения = СтрЗаменить(Строка(ВыборкаСтратегии.Стратегия), " ", "_")
			+ "_" + Формат(ЭтотОбъект.Период, "ДФ=yyyy_MM") + ".xml";
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ДоходностьПоСтратегии");
		ЗаписьXML.ЗаписатьАтрибут("Стратегия", Строка(ВыборкаСтратегии.Стратегия));
		ЗаписьXML.ЗаписатьАтрибут("ДатаФормирования", Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss"));
		ЗаписьXML.ЗаписатьАтрибут("Версия", "0.01");
		
		ВыборкаПериод = ВыборкаСтратегии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПериод.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПоказателиЗаПериод");
			ЗаписьXML.ЗаписатьАтрибут("Период", Формат(ВыборкаПериод.Период, "ДФ=dd.MM.yyyy"));
			
			ВыборкаПоказатели = ВыборкаПериод.Выбрать();
			Пока ВыборкаПоказатели.Следующий() Цикл
				ЗаписьXML.ЗаписатьАтрибут(
					СтрЗаменить(ВыборкаПоказатели.ИмяПоказателя, "СтандартныеСтратегии_", ""),
					Строка(ВыборкаПоказатели.Значение));
			КонецЦикла;
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.Закрыть();
		
		Вложения.Вставить(ИмяВложения, Новый ДвоичныеДанные(ИмяВременногоФайла));
		
	КонецЦикла;
	
	Возврат Вложения;
	
КонецФункции

#Область РазмещениеДоходностиНаСайте

Функция ПолучитьБазовыйКаталогДоходности() Экспорт
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(,
		"КаталогФайловДоходности", ЭтотОбъект.Организация);
	
КонецФункции

// Единственная точка валидации базового каталога: при пустом значении
// выводит сообщение пользователю/в журнал и возвращает Ложь.
// Используется во всех экспортных операциях, требующих заполненный каталог.
Функция ПроверитьБазовыйКаталог(БазовыйКаталог)
	
	Если ЗначениеЗаполнено(БазовыйКаталог) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СообщитьПользователю(
		"РазмещениеДоходностиНаСайте",
		УровеньЖурналаРегистрации.Ошибка,
		"Не задан базовый каталог доходности");
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог)
	
	Возврат БазовыйКаталог + "\" + Формат(ЭтотОбъект.Период, "ДФ=yyyy-MM");
	
КонецФункции

Функция ПолучитьКоличествоФайловXMLВКаталоге(БазовыйКаталог) Экспорт
	
	КаталогПериода = ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог);
	Файл = Новый Файл(КаталогПериода);
	Если Не Файл.Существует() Тогда
		Возврат 0;
	КонецЕсли;
	
	НайденныеФайлы = НайтиФайлы(КаталогПериода, "*.xml", Ложь);
	Возврат НайденныеФайлы.Количество();
	
КонецФункции

Функция ПрочитатьВложенияXMLИзКаталога(КаталогПериода)
	
	Вложения = Новый Соответствие;
	Файл = Новый Файл(КаталогПериода);
	Если Не Файл.Существует() Тогда
		Возврат Вложения;
	КонецЕсли;
	
	НайденныеФайлы = НайтиФайлы(КаталогПериода, "*.xml", Ложь);
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		Вложения.Вставить(НайденныйФайл.Имя, Новый ДвоичныеДанные(НайденныйФайл.ПолноеИмя));
	КонецЦикла;
	
	Возврат Вложения;
	
КонецФункции

Процедура СформироватьИСохранитьXML(БазовыйКаталог, Перезаписывать = Ложь) Экспорт
	
	Если Не ПроверитьБазовыйКаталог(БазовыйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Перезаписывать И ПолучитьКоличествоФайловXMLВКаталоге(БазовыйКаталог) > 0 Тогда
		ВызватьИсключение "В каталоге уже есть XML-файлы за данный период";
	КонецЕсли;
	
	КаталогПериода = ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог);
	
	ДанныеДоходности = ПолучитьДанныеДляДоходности();
	Вложения = СформироватьXMLВложенияПоСтратегиям(ДанныеДоходности.ПоказателиXML);
	
	СохранитьXMLФайлыВСеть(Вложения, КаталогПериода);
	
КонецПроцедуры

Функция НайтиРасхожденияВСохраненныхФайлах(БазовыйКаталог) Экспорт
	
	Если Не ПроверитьБазовыйКаталог(БазовыйКаталог) Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатСверки = ПолучитьРезультатСверкиСохраненныхФайлов(БазовыйКаталог);
	Возврат СформироватьHTMLОтчетОРасхождениях(РезультатСверки);
	
КонецФункции

Функция ОтправитьИОпубликоватьНаСайте(БазовыйКаталог) Экспорт
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("Успех", Ложь);
	РезультатВыполнения.Вставить("HTMLРасхождений", "");
	РезультатВыполнения.Вставить("РезультатСверки", Неопределено);
	
	Если Не ПроверитьБазовыйКаталог(БазовыйКаталог) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	КаталогПериода = ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог);
	
	РезультатСверки = ПолучитьРезультатСверкиСохраненныхФайлов(БазовыйКаталог);
	РезультатВыполнения.РезультатСверки = РезультатСверки;
	
	Если Не СверкаФайловУспешна(РезультатСверки) Тогда
		РезультатВыполнения.HTMLРасхождений = СформироватьHTMLОтчетОРасхождениях(РезультатСверки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	Вложения = ПрочитатьВложенияXMLИзКаталога(КаталогПериода);
	ПараметрыПодключения = Обработки.ОтправкаДанныхПИФНаСайт.ПрочитатьПараметрыПодключения(ЭтотОбъект.Организация);
	
	// Публикация может не выполниться (копия базы / нет параметров подключения):
	// в этом случае оповещение о доходностях не отправляем и возвращаем неуспех
	Если Не ОтправитьXMLФайлыНаСайт(Вложения, ПараметрыПодключения) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ОтправитьОповещениеОДоходностях(БазовыйКаталог);
	
	РезультатВыполнения.Успех = Истина;
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьРезультатСверкиСохраненныхФайлов(БазовыйКаталог)
	
	КаталогПериода = ПолучитьКаталогПериодаПоБазовому(БазовыйКаталог);
	РезультатСохранения = СформироватьРезультатИзФайловКаталога(КаталогПериода);
	
	Возврат ПроверитьРасхожденияПоСохраненнымФайлам(РезультатСохранения, ЭтотОбъект.Период, БазовыйКаталог);
	
КонецФункции

Функция СформироватьРезультатИзФайловКаталога(КаталогПериода)
	
	РезультатСохранения = Новый ТаблицаЗначений;
	РезультатСохранения.Колонки.Добавить("ИмяФайла");
	РезультатСохранения.Колонки.Добавить("ПолныйПуть");
	
	Файл = Новый Файл(КаталогПериода);
	Если Не Файл.Существует() Тогда
		Возврат РезультатСохранения;
	КонецЕсли;
	
	Для Каждого НайденныйФайл Из НайтиФайлы(КаталогПериода, "*.xml", Ложь) Цикл
		Строка = РезультатСохранения.Добавить();
		Строка.ИмяФайла   = НайденныйФайл.Имя;
		Строка.ПолныйПуть = НайденныйФайл.ПолноеИмя;
	КонецЦикла;
	
	Возврат РезультатСохранения;
	
КонецФункции

Функция СформироватьHTMLОтчетОРасхождениях(РезультатСверки)
	
	Текст = СформироватьТекстРасхождений(РезультатСверки);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "<html><head><meta charset=""utf-8""></head><body><pre>"
		+ Текст
		+ "</pre></body></html>";
	
КонецФункции

Функция СформироватьТекстРасхождений(РезультатСверки)
	
	Текст = "";
	Для Каждого СтрокаСверки Из РезультатСверки Цикл
		Если СтрокаСверки.ЕстьРасхождения Тогда
			Текст = Текст
				+ "Путь к текущему файлу: " + СтрокаСверки.ИмяТекущегоФайла + Символы.ПС
				+ "Путь к предыдущему файлу: " + СтрокаСверки.ИмяПредыдущегоФайла + Символы.ПС
				+ СтрокаСверки.ОписаниеРасхождений + Символы.ПС + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Процедура СохранитьXMLФайлыВСеть(Вложения, КаталогНазначения)
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогНазначения, Отказ, Истина);
	
	Для Каждого ЭлементВложения Из Вложения Цикл
		
		ПолныйПуть = КаталогНазначения + "\" + ЭлементВложения.Ключ;
		
		Попытка
			ЭлементВложения.Значение.Записать(ПолныйПуть);
		Исключение
			Информация = ИнформацияОбОшибке();
			СообщитьПользователю(
				"РазмещениеДоходностиНаСайте",
				УровеньЖурналаРегистрации.Ошибка,
				"Ошибка сохранения файла " + ПолныйПуть + Символы.ПС + ПодробноеПредставлениеОшибки(Информация));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьРасхожденияПоСохраненнымФайлам(РезультатСохранения, Период, БазовыйКаталог)
	
	РезультатСверки = Новый ТаблицаЗначений;
	РезультатСверки.Колонки.Добавить("ИмяТекущегоФайла",	Новый ОписаниеТипов("Строка"));
	РезультатСверки.Колонки.Добавить("ИмяПредыдущегоФайла",	Новый ОписаниеТипов("Строка"));
	РезультатСверки.Колонки.Добавить("ЕстьРасхождения",     Новый ОписаниеТипов("Булево"));
	РезультатСверки.Колонки.Добавить("ОписаниеРасхождений", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаСохранения Из РезультатСохранения Цикл
		
		СтрокаСверки = РезультатСверки.Добавить();
		СтрокаСверки.ИмяТекущегоФайла = СтрокаСохранения.ПолныйПуть;
		
		СтрокаСверки.ИмяПредыдущегоФайла = ПолучитьПутьПредыдущегоФайлаСтратегии(СтрокаСохранения.ИмяФайла, Период, БазовыйКаталог);
		Если ПустаяСтрока(СтрокаСверки.ИмяПредыдущегоФайла) Тогда
			СтрокаСверки.ЕстьРасхождения = Истина;
			СтрокаСверки.ОписаниеРасхождений = "Файл за предыдущий период не найден – сверка невозможна.";
			Продолжить;
		КонецЕсли;
		
		Расхождения = СравнитьXMLФайлыПоПериодам(СтрокаСохранения.ПолныйПуть, СтрокаСверки.ИмяПредыдущегоФайла);
		Если Расхождения.Количество() > 0 Тогда
			СтрокаСверки.ЕстьРасхождения = Истина;
			СтрокаСверки.ОписаниеРасхождений = СтрСоединить(Расхождения, Символы.ПС);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатСверки;
	
КонецФункции

Функция ПолучитьПутьПредыдущегоФайлаСтратегии(ИмяФайла, Период, БазовыйКаталог)
	
	ПредыдущийПериод = ДобавитьМесяц(Период, -1);
	
	СуффиксТекущий    = "_" + Формат(Период,           "ДФ=yyyy_MM") + ".xml";
	СуффиксПредыдущий = "_" + Формат(ПредыдущийПериод, "ДФ=yyyy_MM") + ".xml";
	
	ИмяПредыдущегоФайла  = СтрЗаменить(ИмяФайла, СуффиксТекущий, СуффиксПредыдущий);
	ПутьПредыдущегоФайла = БазовыйКаталог + "\" + Формат(ПредыдущийПериод, "ДФ=yyyy-MM") + "\" + ИмяПредыдущегоФайла;
	
	Файл = Новый Файл(ПутьПредыдущегоФайла);
	Если Файл.Существует() Тогда
		Возврат ПутьПредыдущегоФайла;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СравнитьXMLФайлыПоПериодам(ПутьТекущегоФайла, ПутьПредыдущегоФайла)
	
	Расхождения = Новый Массив;
	
	ПоказателиТекущегоФайла 	= ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьТекущегоФайла);
	ПоказателиПредыдущегоФайла 	= ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьПредыдущегоФайла);
	
	Для Каждого ЭлементПредыдущегоФайла Из ПоказателиПредыдущегоФайла Цикл
		
		ПериодИзФайла = ЭлементПредыдущегоФайла.Ключ;
		ПоказателиПредыдущегоПериода = ЭлементПредыдущегоФайла.Значение;
		ПоказателиТекущегоПериода 	 = ПоказателиТекущегоФайла.Получить(ПериодИзФайла);
		
		Если ПоказателиТекущегоПериода = Неопределено Тогда
			Расхождения.Добавить("Период " + ПериодИзФайла + " отсутствует в текущем файле.");
			Продолжить;
		КонецЕсли;
		
		Для Каждого Показатель Из ПоказателиПредыдущегоПериода Цикл
			
			ИмяПоказателя 		= Показатель.Ключ;
			ЗначениеПредыдущее 	= НормализоватьЗначениеПоказателя(Показатель.Значение);
			ЗначениеТекущее 	= НормализоватьЗначениеПоказателя(ПоказателиТекущегоПериода.Получить(ИмяПоказателя));
			
			Если ПоказателиТекущегоПериода.Получить(ИмяПоказателя) = Неопределено Тогда
				Расхождения.Добавить("Период " + ПериодИзФайла + ", показатель " + ИмяПоказателя + " отсутствует в текущем файле.");
			ИначеЕсли ЗначениеТекущее <> ЗначениеПредыдущее Тогда
				Расхождения.Добавить(
					"Период " + ПериодИзФайла + ", показатель " + ИмяПоказателя
					+ ": было " + ЗначениеПредыдущее + ", стало " + ЗначениеТекущее);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Расхождения;
	
КонецФункции

Функция ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьФайла)
	
	ДанныеПериодов = Новый Соответствие;
	
	Файл = Новый Файл(ПутьФайла);
	
	Если Не ЗначениеЗаполнено(ПутьФайла) Или Не Файл.Существует() Тогда
		Возврат ДанныеПериодов;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ПутьФайла);
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента
				Или ЧтениеXML.Имя <> "ПоказателиЗаПериод" Тогда
				Продолжить;
			КонецЕсли;
			
			ПериодИзФайла 	= "";
			АтрибутыПериода = Новый Соответствие;
			
			Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
				Если ЧтениеXML.Имя = "Период" Тогда
					ПериодИзФайла = ЧтениеXML.Значение;
				Иначе
					АтрибутыПериода.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ПериодИзФайла) Тогда
				ДанныеПериодов.Вставить(ПериодИзФайла, АтрибутыПериода);
			КонецЕсли;
			
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
		
	Исключение
		Информация = ИнформацияОбОшибке();
		ЧтениеXML.Закрыть();
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Ошибка,
			"Ошибка чтения XML файла """ + ПутьФайла + """:" + Символы.ПС + ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Возврат ДанныеПериодов;
	
КонецФункции

Функция НормализоватьЗначениеПоказателя(ЗначениеПоказателя)
	
	Если ЗначениеПоказателя = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СокрЛП(Строка(ЗначениеПоказателя));
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьОповещениеОРасхождениях(РезультатСверки)
	
	ТекстПисьма = СформироватьТекстРасхождений(РезультатСверки);
	Если ПустаяСтрока(ТекстПисьма) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура;
	РеквизитыОповещения.Вставить("Организация", ЭтотОбъект.Организация);
	РеквизитыОповещения.Вставить("Период",      ЭтотОбъект.Период);
	РеквизитыОповещения.Вставить("Текст",       ТекстПисьма);
	
	Справочники.Оповещения.СформироватьОповещения(
		"ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОповещениеОРасхождениях()",
		Перечисления.ТипыСобытий.ВнешнийВызов,
		РеквизитыОповещения);
	
КонецПроцедуры

Функция ОтправитьXMLФайлыНаСайт(Вложения, ПараметрыПодключения)
	
	Если Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Предупреждение,
			"Отправка данных из копии информационной базы запрещена");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыПодключения = Неопределено Тогда
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Предупреждение,
			"Не заданы параметры подключения для отправки данных на сайт");
		Возврат Ложь;
	КонецЕсли;
	
	ОписанияФайлов = Новый Массив;
	Для Каждого ЭлементВложения Из Вложения Цикл
		ОписаниеФайла = Новый Структура("ИмяФайла, АдресВХранилище, ИдентификаторОбменаДанными");
		ОписаниеФайла.ИмяФайла                   = ЭлементВложения.Ключ;
		ОписаниеФайла.АдресВХранилище            = ПоместитьВоВременноеХранилище(ЭлементВложения.Значение, Новый УникальныйИдентификатор);
		ОписаниеФайла.ИдентификаторОбменаДанными = Новый УникальныйИдентификатор;
		ОписанияФайлов.Добавить(ОписаниеФайла);
	КонецЦикла;
	
	Обработки.ОтправкаДанныхПИФНаСайт.ОтправитьФайлы(ОписанияФайлов, ПараметрыПодключения);
	
	ОтправитьОповещениеОРазмещенииНаСайте(Вложения, ПараметрыПодключения);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПоказателиСтандартнойСтратегии()
	
	ВидыФинансовыхПоказателей = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыФинансовыхПоказателей");
	
	ПоказателиСтандартнойСтратегии = Новый Массив;
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность);
	
	Возврат ПоказателиСтандартнойСтратегии;	
	
КонецФункции

Функция СверкаФайловУспешна(РезультатСверки)
	
	Если РезультатСверки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаСверки Из РезультатСверки Цикл
		Если СтрокаСверки.ЕстьРасхождения Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ОтправитьОповещениеОРазмещенииНаСайте(Вложения, ПараметрыПодключения)
	
	ТекстПисьма = "";
	НомерСтроки = 0;
	Для Каждого ЭлементВложения Из Вложения Цикл
		НомерСтроки = НомерСтроки + 1;
		ИмяФайла = ЭлементВложения.Ключ;
		ИмяСтратегии = СтрЗаменить(ИмяФайла, ".xml", "");
		ТекстПисьма = ТекстПисьма
			+ Строка(НомерСтроки) + ". " + ИмяСтратегии + Символы.ПС
			+ ПараметрыПодключения.ТекущийКаталог
			+ Символы.ПС + Символы.ПС;
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстПисьма) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура;
    РеквизитыОповещения.Вставить("Организация",  ЭтотОбъект.Организация);
    РеквизитыОповещения.Вставить("Период",       ЭтотОбъект.Период);
    РеквизитыОповещения.Вставить("Текст",  		 ТекстПисьма);

    Справочники.Оповещения.СформироватьОповещения(
        "ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОповещениеОРазмещенииНаСайте()",
        Перечисления.ТипыСобытий.ВнешнийВызов,
        РеквизитыОповещения);
			
КонецПроцедуры

Процедура СообщитьПользователю(ИмяСобытия = "", Уровень = Неопределено, Комментарий)
	
	Если ПараметрыСеанса.ЭтоФоновоеЗадание Тогда
		Если Уровень = УровеньЖурналаРегистрации.Ошибка Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Комментарий, ЭтотОбъект.Метаданные().ПолноеИмя());	
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Комментарий);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция РассчитатьИЗарегистрироватьФинансовыеПоказатели() Экспорт
	
	ДанныеОбновлены = ОбновитьФинансовыеПоказатели();
	Если ДанныеОбновлены Тогда
		ЗарегистрироватьФинансовыеПоказателиПоРасхождениям();
	КонецЕсли;
	
	Возврат ДанныеОбновлены;
	
КонецФункции

Функция ОбновитьФинансовыеПоказатели() Экспорт

	ДанныеОбновлены = Ложь;
	
	ЭтотОбъект.КоличествоПоказателей = 0;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия
		|ПОМЕСТИТЬ _СтандартныеСтратегии
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестирования.Организация = &Организация
		|	И НЕ СтратегииИндивидуальногоИнвестирования.ПометкаУдаления
		|	И СтратегииИндивидуальногоИнвестирования.Стандартная
		|	И СтратегииИндивидуальногоИнвестирования.НачалоДействияСтратегии <= &Период
		|	И (СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия,
		|	РегистрацияФинансовыхПоказателей.Ссылка КАК РегистрацияФинансовыхПоказателей,
		|	&Период КАК Дата
		|ПОМЕСТИТЬ _СтандартныеСтратегииИРФА
		|ИЗ
		|	(ВЫБРАТЬ
		|		СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Ссылка
		|	ИЗ
		|		РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтандартныеСтратегии КАК _СтандартныеСтратегии
		|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = _СтандартныеСтратегии.Стратегия
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация = ФинансовыеПоказатели.Организация
		|				И СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		|				И (ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|				И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ФинансовыеПоказатели.Значение) > 0) КАК СтратегииИндивидуальногоИнвестирования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияФинансовыхПоказателей КАК РегистрацияФинансовыхПоказателей
		|		ПО СтратегииИндивидуальногоИнвестирования.Ссылка = РегистрацияФинансовыхПоказателей.СубъектАналитики
		|			И (НАЧАЛОПЕРИОДА(РегистрацияФинансовыхПоказателей.Дата, ДЕНЬ) = &Период)
		|			И (НЕ РегистрацияФинансовыхПоказателей.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Регистратор КАК РегистрацияФинансовыхПоказателей,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ЗначениеПоказателей
		|ИЗ
		|	_СтандартныеСтратегииИРФА КАК _СтандартныеСтратегииИРФА
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _СтандартныеСтратегииИРФА.РегистрацияФинансовыхПоказателей = ФинансовыеПоказатели.Регистратор
		|			И (ФинансовыеПоказатели.Активность)";
#КонецОбласти	
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
	
	Запрос.Выполнить();
	
	ЭтотОбъект.ФинансовыеПоказатели.Загрузить(СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_СтандартныеСтратегииИРФА").Выгрузить());
	
	ЗначенияПоказателей = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос, 
		"_ЗначениеПоказателей",
		Ложь,
		Неопределено,
		Неопределено,
		"РегистрацияФинансовыхПоказателей,ВидПоказателя").Выгрузить();
	
	Для Каждого СтрокаФинансовыеПоказатели Из ЭтотОбъект.ФинансовыеПоказатели Цикл
		
		СтрокаФинансовыеПоказатели.ЕстьРасхождения = Ложь;
		
		ФинансовыеПоказателиСтандартнойСтратегии = Документы.РегистрацияФинансовыхПоказателей.РассчитатьФинансовыеПоказателиСтандартнойСтратегии(
			ЭтотОбъект.Организация, 
			СтрокаФинансовыеПоказатели.Стратегия, 
			СтрокаФинансовыеПоказатели.Дата);
		
		Для каждого Элемент Из ФинансовыеПоказателиСтандартнойСтратегии Цикл
			Для Номер = 1 По 11 Цикл
				Если СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = Элемент.Ключ 
					Или НЕ ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
					
					СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = Элемент.Ключ;
					СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер] = Элемент.Значение;
					
					Если ЭтотОбъект.КоличествоПоказателей < Номер Тогда
						ЭтотОбъект.КоличествоПоказателей = Номер;
					КонецЕсли;
					
					Прервать;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого СтрокаЗначенияПоказателей Из ЗначенияПоказателей Цикл
			Если СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей = СтрокаЗначенияПоказателей.РегистрацияФинансовыхПоказателей Тогда
				Для Номер = 1 По 11 Цикл
					Если СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = СтрокаЗначенияПоказателей.ВидПоказателя 
						Или НЕ ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
						
						СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = СтрокаЗначенияПоказателей.ВидПоказателя;
						СтрокаФинансовыеПоказатели["Значение_Текущее" + Номер] = СтрокаЗначенияПоказателей.Значение;
						
						Если ЭтотОбъект.КоличествоПоказателей < Номер Тогда
							ЭтотОбъект.КоличествоПоказателей = Номер;
						КонецЕсли;
						
						Прервать;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Для Номер = 1 По 10 Цикл
			Если СтрокаФинансовыеПоказатели["Значение_Текущее" + Номер] <> СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер] Тогда 
				ДанныеОбновлены = Истина; 
				СтрокаФинансовыеПоказатели.ЕстьРасхождения = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ДанныеОбновлены;

КонецФункции

Функция ЗарегистрироватьФинансовыеПоказателиПоРасхождениям() Экспорт
	
	КоличествоЗарегистрированных = 0;
	
	Ответственный = РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(
		ЭтотОбъект.Организация,
		Метаданные.Документы.РегистрацияФинансовыхПоказателей.Имя,
		Неопределено,
		ЭтотОбъект.Период,
		РаботаСПользователями.ТекущийПользователь());
	
	Для Каждого СтрокаФинансовыеПоказатели Из ЭтотОбъект.ФинансовыеПоказатели Цикл
		Если СтрокаФинансовыеПоказатели.ЕстьРасхождения Тогда
			Попытка
				ЗарегистрироватьФинансовыеПоказатели(СтрокаФинансовыеПоказатели, Ответственный);
				КоличествоЗарегистрированных = КоличествоЗарегистрированных + 1;
			Исключение
				Информация = ИнформацияОбОшибке();
				СообщитьПользователю(
					"РегистрацияФинансовыхПоказателей",
					УровеньЖурналаРегистрации.Ошибка,
					"Ошибка регистрации финансовых показателей: " + Символы.ПС + ПодробноеПредставлениеОшибки(Информация));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоЗарегистрированных;
	
КонецФункции

Процедура ЗарегистрироватьФинансовыеПоказатели(СтрокаФинансовыеПоказатели, Ответственный)

	Если Не ЗначениеЗаполнено(СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей) Тогда
		РегистрацияФинансовыхПоказателей = Документы.РегистрацияФинансовыхПоказателей.СоздатьДокумент();
		РегистрацияФинансовыхПоказателей.Дата = СтрокаФинансовыеПоказатели.Дата;
		РегистрацияФинансовыхПоказателей.Организация = ЭтотОбъект.Организация;
		РегистрацияФинансовыхПоказателей.СубъектАналитики = СтрокаФинансовыеПоказатели.Стратегия;
	Иначе
		РегистрацияФинансовыхПоказателей = СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей.ПолучитьОбъект();
		РегистрацияФинансовыхПоказателей.ФинансовыеПоказатели.Очистить();
	КонецЕсли;
	
	РегистрацияФинансовыхПоказателей.Ответственный = Ответственный;
	
	Для Номер = 1 По 10 Цикл
		Если ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
			СтрокаДокументаФинансовыеПоказатели = РегистрацияФинансовыхПоказателей.ФинансовыеПоказатели.Добавить();
			СтрокаДокументаФинансовыеПоказатели.ВидПоказателя = СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер];
			СтрокаДокументаФинансовыеПоказатели.Значение = СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер];
		КонецЕсли;
	КонецЦикла;
	
	РегистрацияФинансовыхПоказателей.Записать(РежимЗаписиДокумента.Проведение);
	
	Если Не ЗначениеЗаполнено(СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей) Тогда
		
		СтрокаФинансовыеПоказатели.ЭтоНовыйДокумент = Истина;
		СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей = РегистрацияФинансовыхПоказателей.Ссылка;
		
	КонецЕсли;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки) Экспорт

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",       Сессия);
	ПараметрыСессии.Вставить("ДопПараметры", Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",  Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
