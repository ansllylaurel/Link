Функция СохранитьXMLФайлыВСеть(Вложения, КаталогНазначения)
	
	РезультатСохранения = Новый ТаблицаЗначений;
	РезультатСохранения.Колонки.Добавить("ИмяФайла");
	РезультатСохранения.Колонки.Добавить("ПолныйПуть");
	РезультатСохранения.Колонки.Добавить("Успешно", Новый ОписаниеТипов("Булево"));
	РезультатСохранения.Колонки.Добавить("ТекстОшибки");
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогНазначения, Отказ, Истина);
	
	Для Каждого ЭлементВложения Из Вложения Цикл
		
		ИмяФайла = ЭлементВложения.Ключ;
		ПолныйПуть = КаталогНазначения + "\" + ИмяФайла;
		
		СтрокаРезультата = РезультатСохранения.Добавить();
		СтрокаРезультата.ИмяФайла = ИмяФайла;
		СтрокаРезультата.ПолныйПуть = ПолныйПуть;
		СтрокаРезультата.Успешно = Ложь;
		
		Попытка
			ЭлементВложения.Значение.Записать(ПолныйПуть);
			СтрокаРезультата.Успешно = Истина;
		Исключение
			Информация = ИнформацияОбОшибке();
			СтрокаРезультата.ТекстОшибки = ПодробноеПредставлениеОшибки(Информация);
			СообщитьПользователю(
				"РазмещениеДоходностиНаСайте",
				УровеньЖурналаРегистрации.Ошибка,
				"Ошибка сохранения файла " + ПолныйПуть + Символы.ПС + СтрокаРезультата.ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат РезультатСохранения;
	
КонецФункции

Функция ПроверитьРасхожденияПоСохраненнымФайлам(РезультатСохранения, Период)
	
	РезультатСверки = Новый ТаблицаЗначений;
	РезультатСверки.Колонки.Добавить("ИмяФайла");
	РезультатСверки.Колонки.Добавить("ЕстьРасхождения", Новый ОписаниеТипов("Булево"));
	РезультатСверки.Колонки.Добавить("ОписаниеРасхождений");
	
	Для Каждого СтрокаСохранения Из РезультатСохранения Цикл
		
		СтрокаСверки = РезультатСверки.Добавить();
		СтрокаСверки.ИмяФайла = СтрокаСохранения.ИмяФайла;
		СтрокаСверки.ЕстьРасхождения = Ложь;
		СтрокаСверки.ОписаниеРасхождений = "";
		
		Если Не СтрокаСохранения.Успешно Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьПредыдущегоФайла = ПолучитьПутьПредыдущегоФайлаСтратегии(СтрокаСохранения.ИмяФайла, Период);
		Если ПустаяСтрока(ПутьПредыдущегоФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		Расхождения = СравнитьXMLФайлыПоПериодам(СтрокаСохранения.ПолныйПуть, ПутьПредыдущегоФайла);
		Если Расхождения.Количество() > 0 Тогда
			СтрокаСверки.ЕстьРасхождения = Истина;
			СтрокаСверки.ОписаниеРасхождений = СтрСоединить(Расхождения, Символы.ПС);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатСверки;
	
КонецФункции

Функция ПолучитьПутьПредыдущегоФайлаСтратегии(ИмяФайла, Период)
	
	СуффиксТекущегоПериода = "_" + Формат(Период, "ДФ=yyyy_MM") + ".xml";
	СуффиксПредыдущегоПериода = "_" + Формат(ДобавитьМесяц(Период, -1), "ДФ=yyyy_MM") + ".xml";
	
	ИмяФайлаПредыдущегоПериода = СтрЗаменить(ИмяФайла, СуффиксТекущегоПериода, СуффиксПредыдущегоПериода);
	КаталогПредыдущегоПериода = ПолучитьКаталогПериода(ДобавитьМесяц(Период, -1));
	ПутьПредыдущегоФайла = КаталогПредыдущегоПериода + "\" + ИмяФайлаПредыдущегоПериода;
	
	НовыйФайл = Новый Файл(ПутьПредыдущегоФайла);
	ФайлСуществует = НовыйФайл.Существует();
	
	Если ФайлСуществует Тогда
		Возврат ПутьПредыдущегоФайла;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СравнитьXMLФайлыПоПериодам(ПутьТекущегоФайла, ПутьПредыдущегоФайла)
	
	Расхождения = Новый Массив;
	
	ПоказателиТекущегоФайла = ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьТекущегоФайла);
	ПоказателиПредыдущегоФайла = ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьПредыдущегоФайла);
	
	Для Каждого ЭлементПредыдущегоФайла Из ПоказателиПредыдущегоФайла Цикл
		
		ПериодИзФайла = ЭлементПредыдущегоФайла.Ключ;
		ПоказателиПредыдущегоПериода = ЭлементПредыдущегоФайла.Значение;
		ПоказателиТекущегоПериода = ПоказателиТекущегоФайла.Получить(ПериодИзФайла);
		
		Если ПоказателиТекущегоПериода = Неопределено Тогда
			Расхождения.Добавить("Период " + ПериодИзФайла + " отсутствует в текущем файле.");
			Продолжить;
		КонецЕсли;
		
		Для Каждого Показатель Из ПоказателиПредыдущегоПериода Цикл
			
			ИмяПоказателя = Показатель.Ключ;
			ЗначениеПредыдущее = НормализоватьЗначениеПоказателя(Показатель.Значение);
			ЗначениеТекущее = НормализоватьЗначениеПоказателя(ПоказателиТекущегоПериода.Получить(ИмяПоказателя));
			
			Если ПоказателиТекущегоПериода.Получить(ИмяПоказателя) = Неопределено Тогда
				Расхождения.Добавить("Период " + ПериодИзФайла + ", показатель " + ИмяПоказателя + " отсутствует в текущем файле.");
			ИначеЕсли ЗначениеТекущее <> ЗначениеПредыдущее Тогда
				Расхождения.Добавить(
					"Период " + ПериодИзФайла + ", показатель " + ИмяПоказателя
					+ ": было " + ЗначениеПредыдущее + ", стало " + ЗначениеТекущее);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Расхождения;
	
КонецФункции

Функция ПрочитатьПоказателиПоПериодамИзФайлаXML(ПутьФайла)
	
	ДанныеПериодов = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ПутьФайла) Тогда
		Возврат ДанныеПериодов;
	КонецЕсли;
	
	НовыйФайл = Новый Файл(ПутьФайла);
	ФайлСуществует = НовыйФайл.Существует();
	
	Если Не ФайлСуществует Тогда
		Возврат ДанныеПериодов;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ПутьФайла);
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЧтениеXML.Имя <> "ПоказателиЗаПериод" Тогда
				Продолжить;
			КонецЕсли;
			
			ПериодИзФайла = "";
			АтрибутыПериода = Новый Соответствие;
			
			Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
				Если ЧтениеXML.Имя = "Период" Тогда
					ПериодИзФайла = ЧтениеXML.Значение;
				Иначе
					АтрибутыПериода.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ПериодИзФайла) Тогда
				ДанныеПериодов.Вставить(ПериодИзФайла, АтрибутыПериода);
			КонецЕсли;
			
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
		
	Исключение
		Информация = ИнформацияОбОшибке();
		ЧтениеXML.Закрыть();
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Ошибка,
			"Ошибка чтения XML файла """ + ПутьФайла + """:" + Символы.ПС + ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Возврат ДанныеПериодов;
	
КонецФункции

Функция НормализоватьЗначениеПоказателя(ЗначениеПоказателя)
	
	Если ЗначениеПоказателя = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СокрЛП(Строка(ЗначениеПоказателя));
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьОповещениеОРасхождениях(РезультатСверки)
	
	ТекстПисьма = "";
	
	Для Каждого СтрокаСверки Из РезультатСверки Цикл
		Если СтрокаСверки.ЕстьРасхождения Тогда
			ТекстПисьма = ТекстПисьма
				+ "Файл: " + СтрокаСверки.ИмяФайла + Символы.ПС
				+ СтрокаСверки.ОписаниеРасхождений + Символы.ПС + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстПисьма) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура;
	РеквизитыОповещения.Вставить("Организация", ЭтотОбъект.Организация);
	РеквизитыОповещения.Вставить("Период",      ЭтотОбъект.Период);
	РеквизитыОповещения.Вставить("Текст",       ТекстПисьма);
	
	Справочники.Оповещения.СформироватьОповещения(
		"ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОповещениеОРасхождениях()",
        Перечисления.ТипыСобытий.ВнешнийВызов,
        РеквизитыОповещения);
	
КонецПроцедуры

Процедура ОтправитьXMLФайлыНаСайт(Вложения, ПараметрыПодключения)
	
	Если Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Предупреждение,
			"Отправка данных из копии информационной базы запрещена");
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПодключения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем массив описаний файлов в формате, ожидаемом процедурой ОтправитьФайлы
	ОписанияФайлов = Новый Массив;
	Для Каждого ЭлементВложения Из Вложения Цикл
		ОписаниеФайла = Новый Структура("ИмяФайла, АдресВХранилище, ИдентификаторОбменаДанными");
		ОписаниеФайла.ИмяФайла                  = ЭлементВложения.Ключ;
		ОписаниеФайла.АдресВХранилище            = ПоместитьВоВременноеХранилище(ЭлементВложения.Значение, Новый УникальныйИдентификатор);
		ОписаниеФайла.ИдентификаторОбменаДанными = Новый УникальныйИдентификатор;
		ОписанияФайлов.Добавить(ОписаниеФайла);
	КонецЦикла;
	
	Обработки.ОтправкаДанныхПИФНаСайт.Создать().ОтправитьФайлы(ОписанияФайлов, ПараметрыПодключения);
	
КонецПроцедуры

Функция ПолучитьПараметрыОтправкиНаСайт()
	
	Значение = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "_ПараметрыОтправкиДанныхПИФНаСайт", ЭтотОбъект.Организация);
	НеЗаданыПараметры = Ложь;
	
	Если Значение <> Неопределено Тогда
		Попытка
			XMLЗначение = XMLЗначение(Тип("ХранилищеЗначения"), Значение);
			ПараметрыПодключения = XMLЗначение.Получить();
			Значение = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "_ПараметрыОтправкиДанныхПИФНаСайтКлюч", ЭтотОбъект.Организация);
			Если Значение <> Неопределено Тогда
				Попытка
					XMLЗначение = XMLЗначение(Тип("ХранилищеЗначения"), Значение);
					ПараметрыПодключения.Ключ = XMLЗначение.Получить();
				Исключение
					ПараметрыПодключения.Ключ = "";
				КонецПопытки;
			КонецЕсли;
			
			Возврат ПараметрыПодключения;
		Исключение
			НеЗаданыПараметры = Истина;
		КонецПопытки;
	Иначе
		НеЗаданыПараметры = Истина;
	КонецЕсли;
	
	Если НеЗаданыПараметры Тогда
		СообщитьПользователю(
			"РазмещениеДоходностиНаСайте",
			УровеньЖурналаРегистрации.Предупреждение,
			"Для организации " + ЭтотОбъект.Организация + " не заданы параметры выгрузки на сайт");
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПоказателиСтандартнойСтратегии()
	
	ВидыФинансовыхПоказателей = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыФинансовыхПоказателей");
	
	ПоказателиСтандартнойСтратегии = Новый Массив;
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СтоимостьПортфеля);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доход);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_Доходность);
	ПоказателиСтандартнойСтратегии.Добавить(ВидыФинансовыхПоказателей.СтандартныеСтратегии_СреднемесячнаяДоходность);
	
	Возврат ПоказателиСтандартнойСтратегии;	
	
КонецФункции

Функция СверкаФайловУспешна(РезультатСверки)
	
	Если РезультатСверки <> Неопределено Тогда
		Для Каждого СтрокаСверки Из РезультатСверки Цикл
			Если СтрокаСверки.ЕстьРасхождения Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОтправитьОповещениеОРазмещенииНаСайте(Вложения, ПараметрыПодключения)
	
	ТекстПисьма = "";
	НомерСтроки = 0;
	Для Каждого ЭлементВложения Из Вложения Цикл
		НомерСтроки = НомерСтроки + 1;
		ИмяФайла = ЭлементВложения.Ключ;
		ИмяСтратегии = СтрЗаменить(ИмяФайла, ".xml", "");
		ТекстПисьма = ТекстПисьма
			+ Строка(НомерСтроки) + ". " + ИмяСтратегии + Символы.ПС
			+ ПараметрыПодключения.ТекущийКаталог
			+ Символы.ПС + Символы.ПС;
	КонецЦикла;
	
	Если ПустаяСтрока(ТекстПисьма) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура;
    РеквизитыОповещения.Вставить("Организация",  ЭтотОбъект.Организация);
    РеквизитыОповещения.Вставить("Период",       ЭтотОбъект.Период);
    РеквизитыОповещения.Вставить("Текст",  		 ТекстПисьма);

    Справочники.Оповещения.СформироватьОповещения(
        "ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОповещениеОРазмещенииНаСайте()",
        Перечисления.ТипыСобытий.ВнешнийВызов,
        РеквизитыОповещения);
			
КонецПроцедуры

Процедура СообщитьПользователю(ИмяСобытия, Уровень, Комментарий)
	
	Если ПараметрыСеанса.ЭтоФоновоеЗадание Тогда
		Если УровеньЖурналаРегистрации.Ошибка Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Комментарий, ЭтотОбъект.Метаданные().ПолноеИмя());
		Иначе
			
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Комментарий);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция РассчитатьИЗарегистрироватьФинансовыеПоказатели() Экспорт

	ДанныеОбновлены = Ложь;
	
	ЭтотОбъект.КоличествоПоказателей = 0;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия
		|ПОМЕСТИТЬ _СтандартныеСтратегии
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестирования.Организация = &Организация
		|	И НЕ СтратегииИндивидуальногоИнвестирования.ПометкаУдаления
		|	И СтратегииИндивидуальногоИнвестирования.Стандартная
		|	И СтратегииИндивидуальногоИнвестирования.НачалоДействияСтратегии <= &Период
		|	И (СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия,
		|	РегистрацияФинансовыхПоказателей.Ссылка КАК РегистрацияФинансовыхПоказателей,
		|	&Период КАК Дата
		|ПОМЕСТИТЬ _СтандартныеСтратегииИРФА
		|ИЗ
		|	(ВЫБРАТЬ
		|		СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Ссылка
		|	ИЗ
		|		РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтандартныеСтратегии КАК _СтандартныеСтратегии
		|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = _СтандартныеСтратегии.Стратегия
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация = ФинансовыеПоказатели.Организация
		|				И СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		|				И (ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|				И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ФинансовыеПоказатели.Значение) > 0) КАК СтратегииИндивидуальногоИнвестирования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияФинансовыхПоказателей КАК РегистрацияФинансовыхПоказателей
		|		ПО СтратегииИндивидуальногоИнвестирования.Ссылка = РегистрацияФинансовыхПоказателей.СубъектАналитики
		|			И (НАЧАЛОПЕРИОДА(РегистрацияФинансовыхПоказателей.Дата, ДЕНЬ) = &Период)
		|			И (НЕ РегистрацияФинансовыхПоказателей.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Регистратор КАК РегистрацияФинансовыхПоказателей,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ЗначениеПоказателей
		|ИЗ
		|	_СтандартныеСтратегииИРФА КАК _СтандартныеСтратегииИРФА
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _СтандартныеСтратегииИРФА.РегистрацияФинансовыхПоказателей = ФинансовыеПоказатели.Регистратор
		|			И (ФинансовыеПоказатели.Активность)";
#КонецОбласти	
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
	
	Запрос.Выполнить();
	
	ЭтотОбъект.ФинансовыеПоказатели.Загрузить(СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_СтандартныеСтратегииИРФА").Выгрузить());

	ЗначенияПоказателей = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос, 
		"_ЗначениеПоказателей",
		Ложь,
		Неопределено,
		Неопределено,
		"РегистрацияФинансовыхПоказателей,ВидПоказателя").Выгрузить();
		
	Ответственный = РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(
		ЭтотОбъект.Организация,
		Метаданные.Документы.РегистрацияФинансовыхПоказателей.Имя,
		Неопределено,
		ЭтотОбъект.Период,
		РаботаСПользователями.ТекущийПользователь());
		
	Для Каждого СтрокаФинансовыеПоказатели Из ЭтотОбъект.ФинансовыеПоказатели Цикл
		
		ФинансовыеПоказателиСтандартнойСтратегии = Документы.РегистрацияФинансовыхПоказателей.РассчитатьФинансовыеПоказателиСтандартнойСтратегии(
			ЭтотОбъект.Организация, 
			СтрокаФинансовыеПоказатели.Стратегия, 
			СтрокаФинансовыеПоказатели.Дата);
		
		Для каждого Элемент Из ФинансовыеПоказателиСтандартнойСтратегии Цикл
			Для Номер = 1 По 11 Цикл
				Если СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = Элемент.Ключ 
					Или НЕ ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
					
					СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = Элемент.Ключ;
					СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер] = Элемент.Значение;
					
					Если ЭтотОбъект.КоличествоПоказателей < Номер Тогда
						ЭтотОбъект.КоличествоПоказателей = Номер;
					КонецЕсли;
					
					Прервать;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для Каждого СтрокаЗначенияПоказателей Из ЗначенияПоказателей Цикл
			Если СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей = СтрокаЗначенияПоказателей.РегистрацияФинансовыхПоказателей Тогда
				Для Номер = 1 По 11 Цикл
					Если СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = СтрокаЗначенияПоказателей.ВидПоказателя 
						Или НЕ ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
						
						СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер] = СтрокаЗначенияПоказателей.ВидПоказателя;
						СтрокаФинансовыеПоказатели["Значение_Текущее" + Номер] = СтрокаЗначенияПоказателей.Значение;
						
						Если ЭтотОбъект.КоличествоПоказателей < Номер Тогда
							ЭтотОбъект.КоличествоПоказателей = Номер;
						КонецЕсли;
						
						Прервать;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Для Номер = 1 По 10 Цикл
			Если СтрокаФинансовыеПоказатели["Значение_Текущее" + Номер] <> СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер] Тогда 
				
				ДанныеОбновлены = Истина; 
				СтрокаФинансовыеПоказатели.ЕстьРасхождения = Истина;
				ЗарегистрироватьФинансовыеПоказатели(СтрокаФинансовыеПоказатели, Ответственный);
				Прервать
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ДанныеОбновлены;

КонецФункции

Процедура ЗарегистрироватьФинансовыеПоказатели(СтрокаФинансовыеПоказатели, Ответственный)

	Если Не ЗначениеЗаполнено(СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей) Тогда
		РегистрацияФинансовыхПоказателей = Документы.РегистрацияФинансовыхПоказателей.СоздатьДокумент();
		РегистрацияФинансовыхПоказателей.Дата = СтрокаФинансовыеПоказатели.Дата;
		РегистрацияФинансовыхПоказателей.Организация = ЭтотОбъект.Организация;
		РегистрацияФинансовыхПоказателей.СубъектАналитики = СтрокаФинансовыеПоказатели.Стратегия;
	Иначе
		РегистрацияФинансовыхПоказателей = СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей.ПолучитьОбъект();
		РегистрацияФинансовыхПоказателей.ФинансовыеПоказатели.Очистить();
	КонецЕсли;
	
	РегистрацияФинансовыхПоказателей.Ответственный = Ответственный;
	
	Для Номер = 1 По 10 Цикл
		Если ЗначениеЗаполнено(СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер]) Тогда
			СтрокаДокументаФинансовыеПоказатели = РегистрацияФинансовыхПоказателей.ФинансовыеПоказатели.Добавить();
			СтрокаДокументаФинансовыеПоказатели.ВидПоказателя = СтрокаФинансовыеПоказатели["ВидПоказателя" + Номер];
			СтрокаДокументаФинансовыеПоказатели.Значение = СтрокаФинансовыеПоказатели["Значение_Расчетное" + Номер];
		КонецЕсли;
	КонецЦикла;
	
	РегистрацияФинансовыхПоказателей.Записать(РежимЗаписиДокумента.Проведение);
	
	Если Не ЗначениеЗаполнено(СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей) Тогда
		
		СтрокаФинансовыеПоказатели.ЭтоНовыйДокумент = Истина;
		СтрокаФинансовыеПоказатели.РегистрацияФинансовыхПоказателей = РегистрацияФинансовыхПоказателей.Ссылка;
		
	КонецЕсли;
	
КонецПроцедуры

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;












