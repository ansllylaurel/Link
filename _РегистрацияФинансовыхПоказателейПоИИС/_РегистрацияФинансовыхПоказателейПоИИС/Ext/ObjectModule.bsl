// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Регистрация финансовых показателей по ИИС", 
		"0.11", 
		"", 
		Истина, );
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтправитьОтчет", "Отправить отчет",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "РегистрацияФинансовыхПоказателей", "Регистрация финансовых показателей",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.Период = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
		
	Если ИдентификаторКоманды = "ОтправитьОтчет" Тогда
		
		ОтправитьОтчет(ПараметрыКоманды.ПолучателиОповещения);
		
	Иначе
		
		Календари = Справочники.Календари;
		Если Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, НачалоМесяца(ТекущаяДата()), 5) = НачалоДня(ТекущаяДата()) Тогда
		
			РассчитатьИЗарегистрироватьФинансовыеПоказатели();
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКоманду

Процедура ОтправитьОтчет(ПолучателиОповещения) Экспорт
	
#Область ПечатнаяФормаШапка
	
	Макет = ПолучитьМакет("РегистрацияФинансовыхПоказателей");
	
	ОбластьШапка				= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтратегия			= Макет.ПолучитьОбласть("Стратегия");
	ОбластьРезультат			= Макет.ПолучитьОбласть("Результат");
	ОбластьОшибка		 		= Макет.ПолучитьОбласть("Ошибка");
	ОбластьПустаяСтрока 		= Макет.ПолучитьОбласть("ПустаяСтрока");

	Результат = Новый ТабличныйДокумент;
	
	ОбластьШапка.Параметры.Период = Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");
	Результат.Вывести(ОбластьШапка);
	
#КонецОбласти	

	ДанныеДоходности = ПолучитьДанныеДляДоходности();

#Область ПечатнаяФормаСтроки

	ВыборкаСтратегии = ДанныеДоходности.ПоказателиОтчёта.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтратегии.Следующий() Цикл
	
		ОбластьСтратегия.Параметры.Заполнить(ВыборкаСтратегии);
		Результат.Вывести(ОбластьСтратегия);
		
		Выборка = ВыборкаСтратегии.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ВидПоказателя = null Тогда
				ОбластьОшибка.Параметры.ТекстОшибки = "Показатели не зарегистрированы";
				Результат.Вывести(ОбластьОшибка);
			Иначе
				ОбластьРезультат.Параметры.Результат = Строка(Выборка.ВидПоказателя) + ": " + Выборка.Значение;
				Результат.Вывести(ОбластьРезультат);
			КонецЕсли;
		КонецЦикла;
		
		Результат.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;
	
#КонецОбласти

	Вложения = СформироватьXMLВложенияПоСтратегиям(ДанныеДоходности.ПоказателиXML);

#Область СохранениеВПапкуИСверка

	КаталогПериода = ПолучитьКаталогПериода(ЭтотОбъект.Период);
	РезультатСохранения = СохранитьXMLФайлыВСеть(Вложения, КаталогПериода);
	РезультатСверки = ПроверитьРасхожденияПоСохраненнымФайлам(РезультатСохранения, ЭтотОбъект.Период);
	ОтправитьОповещениеОРасхождениях(РезультатСверки);

#КонецОбласти

#Область ПубликацияНаСайте

	Если СверкаФайловУспешна(РезультатСверки) Тогда
		ПараметрыПодключения = ПолучитьПараметрыОтправкиНаСайт();
		ОтправитьXMLФайлыНаСайт(Вложения, ПараметрыПодключения);
		ОтправитьОповещениеОРазмещенииНаСайте(Вложения, ПараметрыПодключения);
	КонецЕсли;
	
#КонецОбласти

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("htm");
	Результат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
    ТелоПисьма.Прочитать(ИмяВременногоФайла);

    РеквизитыОповещения = Новый Структура;
    РеквизитыОповещения.Вставить("Организация", ЭтотОбъект.Организация);
    РеквизитыОповещения.Вставить("Период",      ЭтотОбъект.Период);
    РеквизитыОповещения.Вставить("Текст",       ТелоПисьма.ПолучитьТекст());
    РеквизитыОповещения.Вставить("Вложения",    Вложения);

    Справочники.Оповещения.СформироватьОповещения(
        "ВнешняяОбработка._РегистрацияФинансовыхПоказателейПоИИС.ОтправитьОтчет()",
        Перечисления.ТипыСобытий.ВнешнийВызов,
        РеквизитыОповещения);
	
КонецПроцедуры	

Функция ПолучитьДанныеДляДоходности()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",      ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Показатели",  ПолучитьПоказателиСтандартнойСтратегии());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.Ссылка КАК Стратегия
		|ПОМЕСТИТЬ _СтандартныеСтратегии
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестирования.Организация = &Организация
		|	И НЕ СтратегииИндивидуальногоИнвестирования.ПометкаУдаления
		|	И СтратегииИндивидуальногоИнвестирования.Стандартная
		|	И СтратегииИндивидуальногоИнвестирования.НачалоДействияСтратегии <= &Период
		|	И (СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СтратегииИндивидуальногоИнвестирования.ОкончаниеДействияСтратегии >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ФинансовыеПоказатели.ВидПоказателя ЕСТЬ NULL
		|			ТОГДА ""0""
		|		ИНАЧЕ _СтандартныеСтратегии.Стратегия.Наименование
		|	КОНЕЦ КАК ПорядокСтратегия,
		|	_СтандартныеСтратегии.Стратегия КАК Стратегия,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ПоказателиОтчёта
		|ИЗ
		|	_СтандартныеСтратегии КАК _СтандартныеСтратегии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _СтандартныеСтратегии.Стратегия = ФинансовыеПоказатели.СубъектАналитики
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = &Период)
		|			И (ФинансовыеПоказатели.ВидПоказателя В (&Показатели))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.СубъектАналитики КАК Стратегия,
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.ВидПоказателя.ИмяПредопределенныхДанных КАК ИмяПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _ПоказателиXML
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = КОНЕЦПЕРИОДА(ФинансовыеПоказатели.Период, МЕСЯЦ)
		|	И ФинансовыеПоказатели.ВидПоказателя В(&Показатели)
		|	И ФинансовыеПоказатели.СубъектАналитики В
		|			(ВЫБРАТЬ
		|				_СтандартныеСтратегии.Стратегия
		|			ИЗ
		|				_СтандартныеСтратегии КАК _СтандартныеСтратегии)";
	
	Запрос.Выполнить();
	
	ПоказателиОтчёта = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос,
		"_ПоказателиОтчёта",
		Ложь,
		Неопределено,
		Неопределено,
		"ПорядокСтратегия, ВидПоказателя.ИмяПредопределенныхДанных",
		"Стратегия",
		"");
	
	ПоказателиXML = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос,
		"_ПоказателиXML",
		Ложь,
		Неопределено,
		Неопределено,
		"Стратегия, Период, ИмяПоказателя",
		"Стратегия, Период",
		"");
	
	Результат = Новый Структура;
	Результат.Вставить("ПоказателиОтчёта", ПоказателиОтчёта);
	Результат.Вставить("ПоказателиXML",    ПоказателиXML);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьXMLВложенияПоСтратегиям(РезультатЗапросаXML)
	
	Вложения = Новый Соответствие;
	
	ВыборкаСтратегии = РезультатЗапросаXML.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтратегии.Следующий() Цикл
	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		ИмяВложения = СтрЗаменить(Строка(ВыборкаСтратегии.Стратегия), " ", "_")
			+ "_" + Формат(ЭтотОбъект.Период, "ДФ=yyyy_MM") + ".xml";
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ДоходностьПоСтратегии");
		ЗаписьXML.ЗаписатьАтрибут("Стратегия", Строка(ВыборкаСтратегии.Стратегия));
		ЗаписьXML.ЗаписатьАтрибут("ДатаФормирования", Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss"));
		ЗаписьXML.ЗаписатьАтрибут("Версия", "0.01");
		
		ВыборкаПериод = ВыборкаСтратегии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПериод.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ПоказателиЗаПериод");
			ЗаписьXML.ЗаписатьАтрибут("Период", Формат(ВыборкаПериод.Период, "ДФ=dd.MM.yyyy"));
			
			ВыборкаПоказатели = ВыборкаПериод.Выбрать();
			Пока ВыборкаПоказатели.Следующий() Цикл
				ЗаписьXML.ЗаписатьАтрибут(
					СтрЗаменить(ВыборкаПоказатели.ИмяПоказателя, "СтандартныеСтратегии_", ""),
					Строка(ВыборкаПоказатели.Значение));
			КонецЦикла;
			
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.Закрыть();
		
		Вложения.Вставить(ИмяВложения, Новый ДвоичныеДанные(ИмяВременногоФайла));
		
	КонецЦикла;
	
	Возврат Вложения;
	
КонецФункции

