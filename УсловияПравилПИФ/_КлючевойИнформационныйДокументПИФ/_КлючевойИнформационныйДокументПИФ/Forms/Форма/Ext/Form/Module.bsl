	КонецЕсли;
	
	#КонецОбласти
	
	СтруктураДанных.Вставить("ЭтоПриостановленныйПИФ", 	ЭтоПриостановленныйПИФ);
	СтруктураДанных.Вставить("ПериодПриостановкиПИФ", 	ПериодПриостановкиПИФ);
	
