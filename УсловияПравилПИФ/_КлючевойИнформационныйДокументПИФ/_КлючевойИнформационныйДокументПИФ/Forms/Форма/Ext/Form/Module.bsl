		|			(ВЫБРАТЬ
		|				_ДатаОкончанияФормированияПИФ.Год
		|			ИЗ
		|				_ДатаОкончанияФормированияПИФ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Годы"",
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	МАКСИМУМ(ДанныеКалендаря.Дата)
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, ГОД, -5), ГОД) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, ГОД, -5), ГОД)
		|
		|ИМЕЮЩИЕ
		|	НЕ КОНЕЦПЕРИОДА(МАКСИМУМ(ДанныеКалендаря.Дата), ГОД) В
		|			(ВЫБРАТЬ
		|				_ДатаОкончанияФормированияПИФ.Год
		|			ИЗ
		|				_ДатаОкончанияФормированияПИФ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Годы"",
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	МАКСИМУМ(ДанныеКалендаря.Дата)
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, ГОД, -6), ГОД) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, ГОД, -6), ГОД)
		|
		|ИМЕЮЩИЕ
		|	НЕ КОНЕЦПЕРИОДА(МАКСИМУМ(ДанныеКалендаря.Дата), ГОД) В
		|			(ВЫБРАТЬ
		|				_ДатаОкончанияФормированияПИФ.Год
		|			ИЗ
		|				_ДатаОкончанияФормированияПИФ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления КАК СчетДУ,
		|	_ДатыСведений.Дата КАК Дата,
		|	_ДатыСведений.ВидИнтервала КАК ВидИнтервала,
		|	СЧА.Значение КАК СЧА,
		|	РСА.Значение КАК РСА,
		|	СтоимостьПая.Значение КАК СтоимостьПая
		|ПОМЕСТИТЬ _СтоимостьПаяИСЧА
		|ИЗ
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыСведений КАК _ДатыСведений
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК СЧА
		|		ПО (СЧА.Организация = &Организация)
		|			И (СЧА.СубъектАналитики = _КлиентДоверительногоУправления.СчетДоверительногоУправления)
		|			И (СЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (СЧА.Период = _ДатыСведений.ДатаСЧА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК РСА
		|		ПО (РСА.Организация = &Организация)
		|			И (РСА.СубъектАналитики = _КлиентДоверительногоУправления.СчетДоверительногоУправления)
		|			И (РСА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов))
		|			И (РСА.Период = _ДатыСведений.ДатаСЧА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК СтоимостьПая
		|		ПО (СтоимостьПая.Организация = &Организация)
		|			И (СтоимостьПая.СубъектАналитики = _КлиентДоверительногоУправления.СчетДоверительногоУправления)
		|			И (СтоимостьПая.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая))
		|			И (СтоимостьПая.Период = _ДатыСведений.ДатаСЧА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК Дата,
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) КАК Месяц
		|ПОМЕСТИТЬ _ДатыИнфляции
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -60), МЕСЯЦ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -1), МЕСЯЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПроцентныеПоказателиСрезПоследних.ДатаЗначения КАК ДатаЗначения,
		|	ПроцентныеПоказателиСрезПоследних.ЗначениеПоказателя / 100 КАК Значение,
		|	ПроцентныеПоказателиСрезПоследних.ЗначениеПоказателя КАК ИПЦ
		|ПОМЕСТИТЬ _Инфляция
		|ИЗ
		|	РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|			&ТекущаяДата,
		|			Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца)
		|				И ДатаЗначения В
		|					(ВЫБРАТЬ
		|						_ДатыИнфляции.Дата
		|					ИЗ
		|						_ДатыИнфляции)
		|				И Прогноз = ЛОЖЬ
		|				И Источник = &ЮрФизЛицо_Росстат) КАК ПроцентныеПоказателиСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&ДатаРезультатовИнвестирования, МЕСЯЦ), ДЕНЬ),
		|	ЕСТЬNULL(ПроцентныеПоказателиТекущегоМесяца.ЗначениеПоказателя, ПроцентныеПоказателиПрошлогоМесяца.ЗначениеПоказателя) / 100,
		|	ЕСТЬNULL(ПроцентныеПоказателиТекущегоМесяца.ЗначениеПоказателя, ПроцентныеПоказателиПрошлогоМесяца.ЗначениеПоказателя)
		|ИЗ
		|	РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|			&ТекущаяДата,
		|			Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца)
		|				И ДатаЗначения = НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&ДатаРезультатовИнвестирования, МЕСЯЦ), ДЕНЬ)
		|				И Прогноз = ЛОЖЬ
		|				И Источник = &ЮрФизЛицо_Росстат) КАК ПроцентныеПоказателиТекущегоМесяца
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|				&ТекущаяДата,
		|				Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца)
		|					И ДатаЗначения = НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -1), МЕСЯЦ), ДЕНЬ)
		|					И Прогноз = ЛОЖЬ
		|					И Источник = &ЮрФизЛицо_Росстат) КАК ПроцентныеПоказателиПрошлогоМесяца
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДатаОкончанияФормированияПИФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДатыИнфляции";
	
	#КонецОбласти
	
	Запрос.Выполнить();
	
	#Область Доход_по_паям
	
	ДатыСведений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДатыСведений"].ПолучитьДанные().Выгрузить();
	
	// Добавляем в отдельные временные таблицы обороты по доходам пайщиков в расчете на пай за период для каждой строки	
	НомерСтроки = 1;
	Запрос.Текст = "";
	Для Каждого СтрокаСведений Из ДатыСведений Цикл
		
		//Строку вида "ДатаРезультатовИнвестирования" пропускаем
		Если СтрокаСведений.ВидИнтервала = "ДатаРезультатовИнвестирования" Тогда
			Продолжить;
		КонецЕсли;
				
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ВидИнтервала КАК ВидИнтервала,
			|	&НачалоПериода КАК НачалоПериода,			
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток, 0) = 0
			|			ТОГДА 0
			|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход / ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток
			|	КОНЕЦ КАК Сумма
			|ПОМЕСТИТЬ _ДоходПоПаям
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|			ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, 1),
			|			&КонецПериода,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_КлиентДоверительногоУправления.СчетДоверительногоУправления
			|					ИЗ
			|						_КлиентДоверительногоУправления)
			|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям)) КАК ЗадолженностиПоДенежнымСредствамОбороты,
			|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
			|			&КонецПериода,
			|			Организация = &Организация
			|				И ПаевойИнвестиционныйФонд В
			|					(ВЫБРАТЬ
			|						_КлиентДоверительногоУправления.Клиент
			|					ИЗ
			|						_КлиентДоверительногоУправления)) КАК ДолиПайщиковВИнвестиционномФондеОстатки";
		
		Если Не ПустаяСтрока(Запрос.Текст) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ _ДоходПоПаям", ""); 
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
			
			Запрос.Текст = Запрос.Текст + "
				|ОБЪЕДИНИТЬ ВСЕ
				|";
					
		КонецЕсли;	
		
		СтрНомер = Формат(НомерСтроки, "ЧГ=0");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,	"&НачалоПериода",	"&НачалоПериода" + СтрНомер);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,	"&КонецПериода",	"&КонецПериода" + СтрНомер);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,	"&ВидИнтервала",	"&ВидИнтервала" + СтрНомер);
		
		Запрос.Текст = Запрос.Текст + ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ВидИнтервала" + СтрНомер,	СтрокаСведений.ВидИнтервала);
		Запрос.УстановитьПараметр("НачалоПериода" + СтрНомер,	СтрокаСведений.ДатаСЧА);
		Запрос.УстановитьПараметр("КонецПериода"+ СтрНомер,		КонецГода(СтрокаСведений.ДатаСЧА + 864000));
		Дат = СтрокаСведений.Дата;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Запрос.Выполнить();
	
	Запрос.Текст = "УНИЧТОЖИТЬ _ДатыСведений"; 
	
	Запрос.Выполнить();
	
	#КонецОбласти
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ОчиститьДанные();
	Если Не (ЗначениеЗаполнено(Объект.ПаевойИнвестиционныйФонд) И Объект.ДатаКлючевогоИнформационногоДокумента <> '00010101') Тогда		
		Возврат;
	КонецЕсли;
	
	ДанныеДляЗаполнения = Неопределено;
	ТаблицаРисков.Очистить();
		
	Отказ = Ложь;
	ПолучитьСтруктуруДанныхНаСервере(Отказ);
	
	Если ДанныеДляЗаполнения = Неопределено Или Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные для заполнения документа");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДляЗаполнения.Реквизиты);
	
	НомерЛицензииУК = НомерЛицензииУК + " от " + ДанныеДляЗаполнения.Реквизиты.ДатаВыдачиЛицензииУК;
	
	Для Сч = 1 По 5 Цикл
				
		СтруктураЗначений = "";
		Если ДанныеДляЗаполнения.ИнвестиционныеРиски.Свойство("Строка"+СокрЛП(Сч), СтруктураЗначений) Тогда
			НоваяСтрока = ТаблицаРисков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураЗначений);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
			
	Отказ = Ложь;
				
	Если ДанныеДляЗаполнения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо нажать 'Обновить'");
		Возврат;
	КонецЕсли;
	
	СессияСбораСтатистики 	= "";
	ПолноеИмяОтчета 		= "";
	
	ЗарегистрироватьНачалоСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики);
	
	ПолучитьСтруктуруДанныхНаСервере(Отказ, Истина);
	
	ИмяФайлаШаблонаКИД = ПолучитьИмяВременногоФайла("docx");
	ШаблонКИД.Записать(ИмяФайлаШаблонаКИД);
		
	Отказ = Ложь;
	
	Попытка
		
		// создадим документ MS Word на основании сохраненного шаблона
		WordApp = Новый COMОбъект("Word.Application");
					
		Реквизиты = ДанныеДляЗаполнения.Реквизиты;
		
		NewDoc = WordApp.Application.Documents.Add(ИмяФайлаШаблонаКИД, False, , Истина);
		
		WordVars = NewDoc.Variables;
		Для Каждого Реквизит Из Реквизиты Цикл
			WordVars.Item(Реквизит.Ключ).Value = Реквизит.Значение;
		КонецЦикла;
		
		// Выводим таблицу рисков
		ИнвестиционныеРиски = ДанныеДляЗаполнения.ИнвестиционныеРиски;
						
		Content = NewDoc.Content;
		
		НомерДобавляемойСтроки = 3;
		Для Каждого ТекСтрокаРисков Из ИнвестиционныеРиски Цикл
			
			Если ТекСтрокаРисков.Ключ = "Строка1" Тогда
				
				// Строка есть в шаблоне, только заполняем текст
				Content.Tables(2).Cell(2,1).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ВидРиска);
				Content.Tables(2).Cell(2,2).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ВероятностьРеализации);
				Content.Tables(2).Cell(2,3).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ОбъемПотерь);
				
			Иначе
				
				// добавляем строку в конец таблицы
				Content.Tables(2).Rows.Add();        
				Content.Tables(2).Cell(НомерДобавляемойСтроки,1).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ВидРиска);
				Content.Tables(2).Cell(НомерДобавляемойСтроки,2).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ВероятностьРеализации);
				Content.Tables(2).Cell(НомерДобавляемойСтроки,3).Range.Text = СокрЛП(ТекСтрокаРисков.Значение.ОбъемПотерь);
				
				НомерДобавляемойСтроки = НомерДобавляемойСтроки + 1;
			
			КонецЕсли;
			
		КонецЦикла;
					
		NewDoc.Bookmarks("КартинкаДиаграммы").Range.Select();
		Selection = WordApp.Application.Selection;
		
		ЕстьВтораяСноска = Ложь;
		ЕстьТретьяСноска = Ложь;
		Если ДанныеДляЗаполнения.ВыводитьДиаграмму Тогда		
			ИмяФайлаКартинки = ПолучитьИмяВременногоФайла(".bmp");
			ПолучитьИзВременногоХранилища(ДанныеДляЗаполнения.АдресКартинкиВХранилище).Записать(ИмяФайлаКартинки);
			Picture = Selection.InlineShapes.AddPicture(ИмяФайлаКартинки, Ложь, Истина);
			Если ДанныеДляЗаполнения.ДобавитьСноскуПодДиаграммой Тогда
				Если ДанныеДляЗаполнения.ПериодПриостановкиПИФ <> Неопределено Тогда
					
					// 2022 год присутствует в диаграмме в течение 5 лет
					Если Объект.ДатаКлючевогоИнформационногоДокумента >= '20230131' И Объект.ДатаКлючевогоИнформационногоДокумента < '20280101' Тогда							
						Selection.TypeText(Символы.ПС + "* Доходность за 2022 год отражает результат за период с 01.01.2022 г. по 28.02.2022 г. по причине временного приостановления выдачи и погашения инвестиционных паёв Фонда и в связи с тем, что в результате этого стоимость активов Фонда не рассчитывалась за период с 01.03.2022 г. по 31.12.2022 г." + Символы.ВК);
						ЕстьВтораяСноска = Истина;
					КонецЕсли;					
					
					// 2023 год присутствует в диаграмме в течение 5 лет
					Если Объект.ДатаКлючевогоИнформационногоДокумента >= '20240131' И Объект.ДатаКлючевогоИнформационногоДокумента < '20290101' Тогда							
						Selection.TypeText(Символы.ПС + "** Доходность за 2023 год отражает результат за период с 17.03.2023 г. по 29.12.2023 г. в связи с возобновлением выдачи и погашения инвестиционных паёв Фонда. Стоимость активов Фонда не рассчитывалась в период с 01.01.2023 г. по 16.03.2023 г." + Символы.ВК);
						ЕстьТретьяСноска = Истина;
					КонецЕсли;
					
				Иначе
					Selection.TypeText(Символы.ПС + "(*) Доходность за " + Формат(ДанныеДляЗаполнения.ДатаФормированияПИФ, "ДФ=yyyy") + " г. за период с " + Формат(ДанныеДляЗаполнения.ДатаФормированияПИФ, "ДФ=dd.MM.yyyy") + " г. по " + Формат(КонецГода(ДанныеДляЗаполнения.ДатаФормированияПИФ), "ДФ=dd.MM.yyyy") + " г.");
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Selection.TypeText("Доходность за календарный год не указывается, с даты формирования Фонда прошло менее года.");
		КонецЕсли; 
		
		Если ДанныеПоИнфляцииНеАктуальны Тогда
			NewDoc.Bookmarks("ШрифтОтклоненияОтИнфляции").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.Font.ColorIndex = 6;
		КонецЕсли;
		
		Если Реквизиты.Звездочка = "*" Тогда
			
			NewDoc.Bookmarks("Разрыв2").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.InsertBreak(6);
			
			Если Не (ЕстьВтораяСноска Или ЕстьТретьяСноска) Тогда
				Selection.InsertBreak(6);
			КонецЕсли;
			
			NewDoc.Bookmarks("Разрыв4").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.InsertBreak(6);
			
		Иначе
			
			NewDoc.Bookmarks("Разрыв5").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.InsertBreak(6);

			NewDoc.Bookmarks("Разрыв1").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.InsertBreak(7);
			
			NewDoc.Bookmarks("Разрыв2").Range.Select();
			Selection = WordApp.Application.Selection;
			Selection.InsertBreak(6);
			
			Если Не (ЕстьВтораяСноска Или ЕстьТретьяСноска) Тогда
				Selection.InsertBreak(6);
			КонецЕсли;
			
			Если Не ЕстьТретьяСноска Тогда
				NewDoc.Bookmarks("Разрыв3").Range.Select();
				Selection = WordApp.Application.Selection;
				Selection.InsertBreak(7);
			КонецЕсли; 
			
		КонецЕсли;
			
		NewDoc.Fields.Update();
		
		WordApp.Application.Visible = Истина;
		
		ОбработкаПрерыванияПользователя();
				
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);	
	КонецПопытки;
	
	// удалим файл шаблона
	Попытка
		УдалитьФайлы(ИмяФайлаШаблонаКИД);
		УдалитьФайлы(ИмяФайлаКартинки);
	Исключение
	КонецПопытки;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Печать документа завершилась с ошибкой");
	Иначе
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		WordApp.Application.Activate();
	КонецЕсли;  
	
	ЗарегистрироватьОкончаниеСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики);
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаКлючевогоИнформационногоДокументаПриИзменении(Элемент)
		
	ОбновитьДатуРезультатовИнвестированияНаСервере();
	
	ОбновитьВидимостьАктуальностиИнфляции();
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ОчиститьДанные()
	
	ДанныеДляЗаполнения = Неопределено;
	
	ТаблицаРисков.Очистить();
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ВебСтраницаПИФ");
	МассивРеквизитов.Добавить("ВебСтраницаСД");
	МассивРеквизитов.Добавить("ВебСтраницаУК");
	МассивРеквизитов.Добавить("МинимальнаяСуммаЗачисления");
	МассивРеквизитов.Добавить("ПолноеНаименованиеПИФ");
	МассивРеквизитов.Добавить("ПолноеНаименованиеСД");
	МассивРеквизитов.Добавить("ПолноеНаименованиеУК");
	МассивРеквизитов.Добавить("ПроцентВознагражденияСД");
	МассивРеквизитов.Добавить("ПроцентВознагражденияПрочие");
	МассивРеквизитов.Добавить("ПроцентВознагражденияУК");
	МассивРеквизитов.Добавить("СтоимостьПая");
	МассивРеквизитов.Добавить("СЧА");
	МассивРеквизитов.Добавить("ТелефонУК");
	МассивРеквизитов.Добавить("ФактическийАдресУК");
	МассивРеквизитов.Добавить("ЮридическийАдресУК");
	МассивРеквизитов.Добавить("НомерЛицензииУК");
		
	Для Каждого ТекЭлемент Из МассивРеквизитов Цикл
		ЭтаФорма[ТекЭлемент] = "";
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ПаевойИнвестиционныйФонд = "";
	ОчиститьДанные();
			
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьАктуальностиИнфляции()
	
	Этаформа.Элементы.ДекорацияАктуальность.Видимость		= ДанныеПоИнфляцииНеАктуальны;
	ЭтаФорма.Элементы.КомандаЗагрузитьДанныеИПЦ.Видимость	= ДанныеПоИнфляцииНеАктуальны;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДатуРезультатовИнвестированияНаСервере()
	
	Если Объект.ДатаКлючевогоИнформационногоДокумента = '00010101' Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, является ли дата КИД последним рабочим днем месяца
	Если Объект.ДатаКлючевогоИнформационногоДокумента = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(Объект.ДатаКлючевогоИнформационногоДокумента)) Тогда
		Объект.ДатаРезультатовИнвестирования = Объект.ДатаКлючевогоИнформационногоДокумента;
	Иначе
		Объект.ДатаРезультатовИнвестирования = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(Объект.ДатаКлючевогоИнформационногоДокумента, -1)));
	КонецЕсли;
	
	ОбновитьАктуальностьИнфляцииНаСервере();	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктуальностьИнфляцииНаСервере()
	
	ЗначениеИнфляции = РегистрыСведений.ПроцентныеПоказатели.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Показатель,Прогноз,Источник,ДатаЗначения", Перечисления.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца, Ложь, ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Росстат"), НачалоДня(КонецМесяца(Объект.ДатаРезультатовИнвестирования)))).ЗначениеПоказателя;	
	ДанныеПоИнфляцииНеАктуальны = ЗначениеИнфляции = 0;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтоимостьАктивовНаДатуВЗапрос(Запрос, Дата, СчетДоверительногоУправления, ВыводитьАктивыКакВПеречнеИмуществаПИФ, Отказ)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе, переданном в ДобавитьСтоимостьАктивовНаДатуВЗапрос, не определен менеджер временных таблиц",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК СуммаНаКонец,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК СуммаКупонаНаКонец,
		|	СУММА(СтоимостьПереоценки.Количество) КАК КоличествоНаКонец,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	НастройкиФормированияСЧАСрезПоследних.НКДВСправедливойСтоимостиЦБ КАК НКДВСправедливойСтоимостиЦБ,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки
		|ПОМЕСТИТЬ _СтоимостьПереоценки
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки,
		|	РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиФормированияСЧАСрезПоследних
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.Активность
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.Источник,
		|	НастройкиФормированияСЧАСрезПоследних.НКДВСправедливойСтоимостиЦБ,
		|	СтоимостьПереоценки.ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки,
		|	СтоимостьПереоценки.Рынок";
	
	Запрос.Выполнить();

	Если ВыводитьАктивыКакВПеречнеИмуществаПИФ Тогда
		
		Запрос.Текст = 	
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
			|	ВЫБОР
			|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ИмущественныеПрава)
			|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.СделкаСНедвижимостью)
			|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
			|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ПраваАренды)
			|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.ОбъектыНедвижимости)
			|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
			|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.НачислениеЗадолженности)
			|			ТОГДА ""- прочая дебиторская задолженность""
			|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.БанковскиеСчета)
			|			ТОГДА ""- денежные средства в пути""
			|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.Оплата)
			|			ТОГДА ""- прочая дебиторская задолженность""
			|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
			|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Справочник.Договоры)
			|			ТОГДА ""- прочая дебиторская задолженность""
			|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.ПогашениеКупона)
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.ПогашениеКупона).Облигация
			|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
			|				И (ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК Справочник.ВидыЗадолженности)) = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага
			|		КОГДА (ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК Справочник.ВидыЗадолженности)) = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюРаспределяемойПрибылиООО)
