	КонецЕсли;
		
	// Добавляем крупнейшие объекты
	Сч = 1;
	Для Каждого СтрокаОбъекта Из КрупнейшиеОбъекты Цикл
		СтруктураПолейФайла.Вставить(КрупнейшиеОбъекты.Колонки[0].Имя + СокрЛП(Сч), Формат(СтрокаОбъекта[0], "ЧДЦ=2; ЧН=0,00"));
		СтруктураПолейФайла.Вставить(КрупнейшиеОбъекты.Колонки[1].Имя + СокрЛП(Сч), ?(СтрокаОбъекта[2] = '00010101', СокрЛП(СтрокаОбъекта[1]), СтрЗаменить(СокрЛП(СтрокаОбъекта[1]), "'ДатаСделки'", Формат(СтрокаОбъекта[2], "ДФ=dd.MM.yyyy"))));
		Сч = Сч + 1;
	КонецЦикла;

	Пока Сч <= 5 Цикл
		СтруктураПолейФайла.Вставить(КрупнейшиеОбъекты.Колонки[0].Имя + СокрЛП(Сч), "-");
		СтруктураПолейФайла.Вставить(КрупнейшиеОбъекты.Колонки[1].Имя + СокрЛП(Сч), "-");
		Сч = Сч + 1;
	КонецЦикла;

	КоличествоОбъектов = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КоличествоОбъектов").ПолучитьДанные().Выгрузить();
	
	СтруктураПолейФайла.Вставить("КоличествоОбъектовИнвестирования",  ?(КоличествоОбъектов.Количество() = 0, 0, КоличествоОбъектов[0].КоличествоОбъектовИнвестирования));
	
	Реквизиты = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Реквизиты").ПолучитьДанные().Выгрузить();
	
	Если Реквизиты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для вывода!",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	СтрокаРеквизитов = Реквизиты[0];
	Для Каждого ТекКолонка Из Реквизиты.Колонки Цикл
		
		Если ТекКолонка.Имя = "ПИФ" Или ТекКолонка.Имя = "СчетДоверительногоУправления" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекКолонка.Имя = "ДатаФормированияПИФ" Тогда
			СтруктураДанных.Вставить("ДатаФормированияПИФ", СтрокаРеквизитов[ТекКолонка.Имя]);
		ИначеЕсли ТекКолонка.Имя = "ДатаВозникнованияОснованияДляПрекращенияПИФ" Тогда
			СтруктураДанных.Вставить("ДатаВозникнованияОснованияДляПрекращенияПИФ", СтрокаРеквизитов[ТекКолонка.Имя]);	
		ИначеЕсли СтрНайти(ТекКолонка.Имя, "_ДатаПрописью") > 0 Тогда
			СтруктураПолейФайла.Вставить(СтрЗаменить(ТекКолонка.Имя, "_ДатаПрописью", ""), Формат(СтрокаРеквизитов[ТекКолонка.Имя], "ДФ='dd MMMM yyyy'"));
		ИначеЕсли СтрНайти(ТекКолонка.Имя, "_Дата") > 0 Тогда
			СтруктураПолейФайла.Вставить(СтрЗаменить(ТекКолонка.Имя, "_Дата", ""), Формат(СтрокаРеквизитов[ТекКолонка.Имя], "ДФ=dd.MM.yyyy"));
		ИначеЕсли СтрНайти(ТекКолонка.Имя, "_Число") > 0 Тогда
			СтруктураПолейФайла.Вставить(СтрЗаменить(ТекКолонка.Имя, "_Число", ""), Формат(СтрокаРеквизитов[ТекКолонка.Имя], "ЧРД=,"));	
		ИначеЕсли СтрНачинаетсяС(ТекКолонка.Имя, "НастройкаВознаграждения") Тогда	
			СтруктураПолейФайла.Вставить(СтрЗаменить(ТекКолонка.Имя, "Настройка", "Процент"), 
					Справочники.НастройкиРасчета.Рассчитать(СтрокаРеквизитов[ТекКолонка.Имя], Новый Структура("Период", Объект.ДатаКлючевогоИнформационногоДокумента)));
		ИначеЕсли ТекКолонка.Имя = "ПроцентВознагражденияВсего" Тогда
			СтруктураПолейФайла.Вставить(ТекКолонка.Имя, СтруктураПолейФайла.ПроцентВознагражденияУК + СтруктураПолейФайла.ПроцентВознагражденияСД + СтруктураПолейФайла.ПроцентВознагражденияПрочие);			
		ИначеЕсли СтрНачинаетсяС(ТекКолонка.Имя, "ПроцентВознаграждения") Тогда
			Продолжить;					
		Иначе
			Если ТекКолонка.Имя = "ОписаниеИнвестиционнойСтратегии" И ПустаяСтрока(СтрокаРеквизитов[ТекКолонка.Имя]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните доп.свойство фонда ""Описание инвестиционной стратегии""!");
			ИначеЕсли ТекКолонка.Имя = "ВидИнвестиционнойСтратегии" И ПустаяСтрока(СтрокаРеквизитов[ТекКолонка.Имя]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните доп.свойство фонда ""Вид инвестиционной стратегии""!");
			ИначеЕсли ТекКолонка.Имя = "ОписаниеАктивовИнвестирования" И ПустаяСтрока(СтрокаРеквизитов[ТекКолонка.Имя]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните доп.свойство фонда ""Виды активов для инвестирования""!");
			КонецЕсли;
			СтруктураПолейФайла.Вставить(ТекКолонка.Имя, СтрокаРеквизитов[ТекКолонка.Имя]);
		КонецЕсли;
		
	КонецЦикла;
	
	ИнвестиционныеРиски = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИнвестиционныеРиски").ПолучитьДанные().Выгрузить();
			
	Если ИнвестиционныеРиски.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют сведения об инвестиционных рисках",,,, Отказ);		
		Возврат;
	КонецЕсли;

	ИнвестиционныеРиски.Сортировать("НомерСтроки");
	
	СтруктураИнвестиционныхРисков = Новый Структура;
	Сч = 1;
	Для Каждого СтрокаРиска Из ИнвестиционныеРиски Цикл
		СтруктураИнвестиционныхРисков.Вставить("Строка" + СокрЛП(Сч), Новый Структура("ВидРиска, ВероятностьРеализации, ОбъемПотерь", СтрокаРиска.ВидРиска, СтрокаРиска.ВероятностьРеализации, СтрокаРиска.ОбъемПотерь));
		Сч = Сч + 1;
	КонецЦикла;
	СтруктураДанных.Вставить("ИнвестиционныеРиски", СтруктураИнвестиционныхРисков);
	
	ВыводитьДиаграмму = Год(Объект.ДатаРезультатовИнвестирования) <> Год(СтрокаРеквизитов.ДатаОкончанияФормированияПИФ_Дата);	
	СтруктураДанных.Вставить("ВыводитьДиаграмму", ВыводитьДиаграмму);
	
	// Если дата КИД и дата результатов инвестирования совпадают, то дату результатов показывать не нужно
	Если Объект.ДатаКлючевогоИнформационногоДокумента = Объект.ДатаРезультатовИнвестирования Тогда
		СтруктураПолейФайла.Вставить("ДатаРезультатовИнвестирования", " ");
	КонецЕсли;
	
	// Минимальную сумму зачисления нужно указать числом и прописью
	СтруктураПолейФайла.Вставить("МинимальнаяСуммаЗачисления", Формат(СтрокаРеквизитов["МинимальнаяСуммаЗачисления_Число"], "ЧРД=,") + " (" + ЧислоПрописью(СтрокаРеквизитов["МинимальнаяСуммаЗачисления_Число"], "L=ru_RU;SN=false;FN=false;FS=false", ",,,,,,,,0") + ")");
	
	ВебСтраницаПИФ 	= ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "Обработка.ОтправкаДанныхПИФНаСайт", СтрокаРеквизитов["СчетДоверительногоУправления"]);
	ВебСтраницаУК 	= СтруктураПолейФайла.ВебСтраницаУК;
	НайдТочкаРуУК 	= СтрНайти(ВебСтраницаУК, ".ru");
	НайдТочкаРуПИФ 	= СтрНайти(ВебСтраницаПИФ, ".ru");
	
	
	//Заменяем в кусочек адресе ПИФ на правильную страницу УК
	ВебСтраницаПИФ = СтрЗаменить(ВебСтраницаПИФ, Лев(ВебСтраницаПИФ, НайдТочкаРуПИФ), Лев(ВебСтраницаУК, НайдТочкаРуУК));
	
	СтруктураПолейФайла.Вставить("ВебСтраницаПИФ", ВебСтраницаПИФ);
		
	СтрокаСтоимости = СтоимостьПаяИСЧА[0];
	СтруктураПолейФайла.Вставить("СтоимостьПая", Формат(СтрокаСтоимости.СтоимостьПая, "ЧДЦ=2; ЧРД=,; ЧН=0,00"));
	СтруктураПолейФайла.Вставить("СЧА", Формат(СтрокаСтоимости.СЧА, "ЧДЦ=2; ЧРД=,; ЧН=0,00"));

	Инфляция = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Инфляция").ПолучитьДанные().Выгрузить();
	Инфляция.Сортировать("ДатаЗначения Убыв");
	
	// Собираем инфляцию для заданных периодов (1, 3, 6 месяцев, 1, 3, 5 лет);
	Инфляция1Месяц 		= 1;
	Инфляция3Месяца 	= 1;
	Инфляция6Месяцев 	= 1;
	Инфляция1Год 		= 1;
	Инфляция3Года	 	= 1;
	Инфляция5Лет 		= 1;
	
	ИндексПоследнейСтроки = Инфляция.Количество() - 1;
	Накоплено = 1;
	Для Сч = 0 По ИндексПоследнейСтроки Цикл
		Накоплено = Накоплено * Инфляция[Сч].Значение;
		Если Сч = 0 Тогда
			Инфляция1Месяц = Накоплено;
		ИначеЕсли Сч = 2 Тогда
			Инфляция3Месяца = Накоплено;
		ИначеЕсли Сч = 5 Тогда
			Инфляция6Месяцев = Накоплено;	
		ИначеЕсли Сч = 11 Тогда
			Инфляция1Год = Накоплено;		
		ИначеЕсли Сч = 35 Тогда
			Инфляция3Года = Накоплено;	
		ИначеЕсли Сч = 59 Тогда
			Инфляция5Лет = Накоплено;		
		КонецЕсли;		
	КонецЦикла;
	
	Инфляция1Месяц	 	= Окр((Инфляция1Месяц - 1) * 100, 2, 1);
	Инфляция3Месяца 	= Окр((Инфляция3Месяца - 1) * 100, 2, 1);
	Инфляция6Месяцев 	= Окр((Инфляция6Месяцев - 1) * 100, 2, 1);
	Инфляция1Год 		= Окр((Инфляция1Год - 1) * 100, 2, 1);
	Инфляция3Года 		= Окр((Инфляция3Года - 1) * 100, 2, 1);
	Инфляция5Лет		= Окр((Инфляция5Лет - 1) * 100, 2, 1);
	
	ДоходностьДляТаблицы = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДоходностьДляТаблицы").ПолучитьДанные().Выгрузить();
	ДоходностьДляТаблицы.Сортировать("Дата Убыв");
	
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 0, Инфляция1Месяц, 	"Доходность1Месяц", 	"ОтклонениеОтИнфляции1Месяц",	"ОтклонениеОтИндекса1Месяц");
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 1, Инфляция3Месяца, 	"Доходность3Месяца", 	"ОтклонениеОтИнфляции3Месяца", 	"ОтклонениеОтИндекса3Месяца");
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 2, Инфляция6Месяцев, 	"Доходность6Месяцев", 	"ОтклонениеОтИнфляции6Месяцев", "ОтклонениеОтИндекса6Месяцев");
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 3, Инфляция1Год, 		"Доходность1Год", 		"ОтклонениеОтИнфляции1Год", 	"ОтклонениеОтИндекса1Год");
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 4, Инфляция3Года, 	"Доходность3Года", 		"ОтклонениеОтИнфляции3Года", 	"ОтклонениеОтИндекса3Года");
	ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, 5, Инфляция5Лет, 		"Доходность5Лет", 		"ОтклонениеОтИнфляции5Лет", 	"ОтклонениеОтИндекса5Лет");
	
	ПолучитьДиаграммуНаСервере(Запрос, СтруктураДанных, ТолькоДиаграмма, Отказ,, ПоложениеПодписей);		
	
	СтруктураДанных.Реквизиты.Вставить("Звездочка", Символы.НПП);
	СтруктураДанных.Реквизиты.Вставить("ТекстПриостановленногоПИФ", Символы.НПП);
	
	// Для приостановленного ПИФ очищаем отдельные поля и таблицы	
	Если ПериодПриостановкиПИФ <> Неопределено Тогда
		ПодготовитьДанныеДляПриостановленногоПИФ(СтруктураДанных, Объект.ДатаКлючевогоИнформационногоДокумента, Объект.ДатаРезультатовИнвестирования);
	КонецЕсли;	
	
	ИнформацияОВозникновенииОснованияДляПрекращенияФонда = " ";
	Если ЗначениеЗаполнено(СтруктураДанных.ДатаВозникнованияОснованияДляПрекращенияПИФ) Тогда
		ИнформацияОВозникновенииОснованияДляПрекращенияФонда = СтрШаблон("9. Паевой инвестиционный фонд находится в стадии прекращения. Дата возникновения основания прекращения фонда %1 г. Прекращение паевого инвестиционного фонда осуществляется управляющей компанией.",
			Формат(СтруктураДанных.ДатаВозникнованияОснованияДляПрекращенияПИФ, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	СтруктураДанных.Реквизиты.Вставить("ИнформацияОВозникновенииОснованияДляПрекращенияФонда", ИнформацияОВозникновенииОснованияДляПрекращенияФонда);
	
	ДанныеДляЗаполнения = СтруктураДанных;
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьДиаграммуНаСервере(Запрос, СтруктураДанных, ТолькоДиаграмма, Отказ, ПериодПриостановкиПИФ = Неопределено, ПоложениеПодписей = Неопределено)
	
	ВыводитьДиаграмму = СтруктураДанных.ВыводитьДиаграмму;
	
	Если Не ВыводитьДиаграмму Тогда 
		Возврат;
	КонецЕсли;
	
	// Определяем год с датой окончания формирования, добавляем (*) в подпись года
	Если ТолькоДиаграмма Тогда
		
		Реквизиты = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Реквизиты").ПолучитьДанные().Выгрузить();
		
		Если Реквизиты.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для вывода!",,,, Отказ);		
			Возврат;			
		КонецЕсли;
		ГодФормированияПИФ = Год(Реквизиты[0].ДатаФормированияПИФ);
		ВыводитьДиаграмму = Год(Объект.ДатаРезультатовИнвестирования) <> ГодФормированияПИФ;
		
	Иначе
		
		ГодФормированияПИФ = Год(СтруктураДанных.ДатаФормированияПИФ);    		
		
	КонецЕсли;                                                            
	
	ДоходностьДляДиаграммы = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДоходностьДляДиаграммы").ПолучитьДанные().Выгрузить();
	
	ДоходностьДляДиаграммы.Сортировать("ГодЧислом");
	ДоходностьДляДиаграммы.Колонки.Вставить(0, "Год", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(8)));
	Для Каждого СтрокаДоходности Из ДоходностьДляДиаграммы Цикл     		
		СтрокаДоходности.Год = Формат(СтрокаДоходности.ГодЧислом, "ЧГ=0");
	КонецЦикла;                                                    
	  
	ДобавитьСноскуПодДиаграммой = Ложь;
	НайдСтрокиДоходности = ДоходностьДляДиаграммы.НайтиСтроки(Новый Структура("ГодЧислом", ГодФормированияПИФ));
	Если НайдСтрокиДоходности.Количество() > 0 Тогда
		НайдСтрокиДоходности[0].Год = НайдСтрокиДоходности[0].Год + " (*)";
		ДобавитьСноскуПодДиаграммой = Истина;
	КонецЕсли;
	
	// Редактируем подписи к диаграмме для приостановленного ПИФ
	Если ПериодПриостановкиПИФ <> Неопределено Тогда
		
		// 2022 и 2023 годы помечаем звездочками
		НайдСтрокиДоходности = ДоходностьДляДиаграммы.НайтиСтроки(Новый Структура("ГодЧислом", 2022));
		Если НайдСтрокиДоходности.Количество() > 0 Тогда
			НайдСтрокиДоходности[0].Год = НайдСтрокиДоходности[0].Год + " *";
			ДобавитьСноскуПодДиаграммой = Истина;
		КонецЕсли;
		
		НайдСтрокиДоходности = ДоходностьДляДиаграммы.НайтиСтроки(Новый Структура("ГодЧислом", 2023));
		Если НайдСтрокиДоходности.Количество() > 0 Тогда
			НайдСтрокиДоходности[0].Год = НайдСтрокиДоходности[0].Год + " **";
			ДобавитьСноскуПодДиаграммой = Истина;
		КонецЕсли;
		
	КонецЕсли;	
	
	СтруктураДанных.Вставить("ДобавитьСноскуПодДиаграммой", ДобавитьСноскуПодДиаграммой);
	
	ДоходностьДляДиаграммы.Колонки.Удалить(1);
	
	ДиаграммаДоходности.Очистить();
	
	Если ВыводитьДиаграмму Тогда
		
		ДиаграммаДоходности.Обновление = Ложь;
		
		ДиаграммаДоходности.ТипДиаграммы 				= ТипДиаграммы.Гистограмма;
		ДиаграммаДоходности.ВидПодписей 				= ВидПодписейКДиаграмме.Нет;
		ДиаграммаДоходности.ОбластьЗаголовка.Текст 		= "Доходность за календарный год, %";
		ДиаграммаДоходности.ОбластьЗаголовка.Шрифт 		= Новый Шрифт("Times New Roman", 14, Ложь);
		ДиаграммаДоходности.ОбластьЛегенды.Расположение = РасположениеЛегендыДиаграммы.Нет;	
		ДиаграммаДоходности.СерииВСтроках 				= Ложь;
		ДиаграммаДоходности.ОсьЗначений.БазовоеЗначение = 0;
		ДиаграммаДоходности.ОсьТочек.БазовоеЗначение 	= 0;
		ДиаграммаДоходности.ПоложениеПодписей 			= ПоложениеПодписей;
		
		МассивЦветов = Новый Массив;
		МассивЦветов.Добавить(Новый Цвет(79, 129, 189));	
		ДиаграммаДоходности.ОписаниеПалитрыЦветов.УстановитьПалитру(МассивЦветов);
		ДиаграммаДоходности.ВидПодписей = ВидПодписейКДиаграмме.Значение;

		ДиаграммаДоходности.ИсточникДанных = ДоходностьДляДиаграммы;
		
		ДиаграммаДоходности.ОбластьПостроения.Шрифт 						= Новый Шрифт("Times New Roman", 9, Ложь);
		ДиаграммаДоходности.ОбластьПостроения.ШкалаТочек.ШрифтПодписей 		= Новый Шрифт("Times New Roman", 7, Ложь);
		ДиаграммаДоходности.ОбластьПостроения.ШкалаСерий.ШрифтПодписей 		= Новый Шрифт("Times New Roman", 7, Ложь);
		ДиаграммаДоходности.ОбластьПостроения.ШкалаЗначений.ШрифтПодписей 	= Новый Шрифт("Times New Roman", 7, Ложь);
		ДиаграммаДоходности.ОбластьПостроения.ШкалаЗначений.ШагШкалы 		= 5;
		ДиаграммаДоходности.ОбластьПостроения.ШкалаЗначений.ПоложениеШкалы 	= ПоложениеШкалыДиаграммы.Край;
		ДиаграммаДоходности.ОбластьПостроения.ШкалаТочек.ПоложениеШкалы 	= ПоложениеШкалыДиаграммы.Край;
		ДиаграммаДоходности.ОбластьПостроения.ШкалаСерий.ПоложениеШкалы 	= ПоложениеШкалыДиаграммы.Край;
				
		ДиаграммаДоходности.Обновление = Истина;
				
		АдресКартинкиВХранилище = ПоместитьВоВременноеХранилище(ДиаграммаДоходности.ПолучитьКартинку(600,400,ФорматКартинки.BMP).ПолучитьДвоичныеДанные());
		
		СтруктураДанных.Вставить("АдресКартинкиВХранилище", АдресКартинкиВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПоляДоходности(СтруктураПолейФайла, ДоходностьДляТаблицы, ИндексСтроки, Инфляция, ИмяПоляДоходности, ИмяПоляОтклонения, ИмяПоляИндекса)
	
	Доходность = ДоходностьДляТаблицы[ИндексСтроки].Доходность;
	Если ТипЗнч(Доходность) = Тип("Число") Тогда
		ОтклонениеОтИнфляции = Доходность - Инфляция;		
	Иначе
		ОтклонениеОтИнфляции = "-";
		Доходность = "-";
	КонецЕсли;
	
	СтруктураПолейФайла.Вставить(ИмяПоляДоходности, Доходность);
	СтруктураПолейФайла.Вставить(ИмяПоляОтклонения, ОтклонениеОтИнфляции);
	СтруктураПолейФайла.Вставить(ИмяПоляИндекса,	"-");
		
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНачалоСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики)
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	
	ПолноеИмяОтчета = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();
	СессияСбораСтатистики   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		ПолноеИмяОтчета,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики)

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики); 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	СтрСохраняемыеДанные = "ДатаКлючевогоИнформационногоДокумента,Организация,ПаевойИнвестиционныйФонд";
	ПараметрыОтчета = Новый Структура(СтрСохраняемыеДанные);
	ЗаполнитьЗначенияСвойств(ПараметрыОтчета, Объект);
	
	Описание = "";
	
	Для каждого Реквизит Из СтрРазделить(СтрСохраняемыеДанные, ",") Цикл
	
		Описание = Описание + Символы.ПС + Реквизит + ": " + ПараметрыОтчета[Реквизит];
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

&НаСервереБезКонтекста
Процедура КомандаЗагрузитьДанныеИПЦНаСервере()
	
	ИмпортПроцентныхПоказателей = Обработки.ИмпортПроцентныхПоказателей.Создать();
	ИмпортПроцентныхПоказателей.ДатаЗагрузки = ТекущаяДата();
	ИмпортПроцентныхПоказателей.ИмпортИндексовПотребительскихЦен();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьДанныеИПЦ(Команда)
	
	КомандаЗагрузитьДанныеИПЦНаСервере();
	ОбновитьАктуальностьИнфляцииНаСервере();
	ОбновитьВидимостьАктуальностиИнфляции();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодготовитьДанныеДляПриостановленногоПИФ(СтруктураДанных, ДатаДокумента, ДатаРезультатовИнвестирования)
	
	// Если ПИФ приостановлен, в основных таблицах нужно вывести прочерки	
	Если СтруктураДанных.ЭтоПриостановленныйПИФ Тогда
		
		ТаблицаРисков = Новый Структура("Строка1", Новый Структура("ВидРиска,ОбъемПотерь,ВероятностьРеализации", "-", "-", "-"));
		СтруктураДанных.Вставить("ИнвестиционныеРиски", ТаблицаРисков);
		      		
		МассивКлючей = Новый Массив;
		Для Каждого ТекРеквизит Из СтруктураДанных.Реквизиты Цикл
			Если СтрНачинаетсяС(ТекРеквизит.Ключ, "ОтклонениеОтИнфляции")
				Или СтрНачинаетсяС(ТекРеквизит.Ключ, "Доходность")
				Или ТекРеквизит.Ключ = "СЧА"
				Или ТекРеквизит.Ключ = "СтоимостьПая"
				Тогда
				
				МассивКлючей.Добавить(ТекРеквизит.Ключ);
			КонецЕсли;
			
		КонецЦикла;
			
		Для Сч = 1 По 5 Цикл
			МассивКлючей.Добавить("ДоляКрупнейшегоОбъектаИнвестирования" + СокрЛП(Сч)); 	
			МассивКлючей.Добавить("КрупнейшийОбъектИнвестирования" + СокрЛП(Сч)); 	
		КонецЦикла;
				
		Для Каждого Ключ Из МассивКлючей Цикл             		
			СтруктураДанных.Реквизиты.Вставить(Ключ, "-");
		КонецЦикла;
		
		СтруктураДанных.Реквизиты.Вставить("ДатаРезультатовИнвестирования", " ");

		СтруктураДанных.Реквизиты.Вставить("Звездочка", "*");
		СтруктураДанных.Реквизиты.Вставить("ТекстПриостановленногоПИФ", "____________________________" + Символы.ВК +
								"* Информация не заполняется в соответствии с разъяснениями Банка России от 11.03.2022 №38-3-8/630 по причине временного приостановления с 02.03.2022 г. выдачи и погашения инвестиционных паёв и в связи с тем, что в результате этого стоимость активов Фонда не рассчитывается.");
		
	Иначе
		
		// Если у ПИФ был период приостановки, таблицу доходности нужно заполнять постепенно от даты окончания периода приостановки
		ДатаОкончанияПриостановки = СтруктураДанных.ПериодПриостановкиПИФ.ДатаОкончания;
		
		// Через 13 месяцев заполняются все показатели
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДобавитьМесяц(ДатаОкончанияПриостановки, 13)) Тогда
			Возврат;
		КонецЕсли; 			
		
		МассивИнтервалов = Новый Массив;
		
		// 3 года, 5 лет отражаем с месяца, в котором у ПИФа закончился период приостановки		
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДатаОкончанияПриостановки) Тогда
			МассивИнтервалов.Добавить("3Года");
			МассивИнтервалов.Добавить("5Лет");
		КонецЕсли;
		
		// 1 месяц - со следующего месяца от даты окончания периода приостановки
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДобавитьМесяц(ДатаОкончанияПриостановки, 1)) Тогда
			МассивИнтервалов.Добавить("1Месяц");
		КонецЕсли;
		
		// 3 месяц - через четыре месяца от даты окончания периода приостановки
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДобавитьМесяц(ДатаОкончанияПриостановки, 3)) Тогда
			МассивИнтервалов.Добавить("3Месяца");
		КонецЕсли;
		
		// 6 месяцев - через семь месяцев от даты окончания периода приостановки
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДобавитьМесяц(ДатаОкончанияПриостановки, 6)) Тогда
			МассивИнтервалов.Добавить("6Месяцев");
		КонецЕсли;
		
		// 1 год - через двенадцать месяцев от даты окончания периода приостановки
		Если НачалоМесяца(ДатаРезультатовИнвестирования) >= НачалоМесяца(ДобавитьМесяц(ДатаОкончанияПриостановки, 12)) Тогда
			МассивИнтервалов.Добавить("1Год");
		КонецЕсли;
				
		МассивКлючей = Новый Массив;
		Для Каждого ТекРеквизит Из СтруктураДанных.Реквизиты Цикл
			
			Если Не (СтрНачинаетсяС(ТекРеквизит.Ключ, "ОтклонениеОтИнфляции")
				Или СтрНачинаетсяС(ТекРеквизит.Ключ, "Доходность"))	Тогда				
				Продолжить;
			КонецЕсли;	
			
			ДобавитьКлюч = Истина;
			Для Каждого Интервал Из МассивИнтервалов Цикл 
				Если СтрЗаканчиваетсяНа(ТекРеквизит.Ключ, Интервал) Тогда
					ДобавитьКлюч = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ДобавитьКлюч Тогда
				МассивКлючей.Добавить(ТекРеквизит.Ключ);
			КонецЕсли;
			
		КонецЦикла;
						
		Для Каждого Ключ Из МассивКлючей Цикл             		
			СтруктураДанных.Реквизиты.Вставить(Ключ, "-");
		КонецЦикла;
				
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти



