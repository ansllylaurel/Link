
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	// начальное заполнение формы
	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ШаблонКИД = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ШаблонКИД");
	
	Объект.ДатаКлючевогоИнформационногоДокумента = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1)));
	ОбновитьДатуРезультатовИнвестированияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьАктуальностиИнфляции();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаСервере
Процедура ДобавитьДанныеДляРасчетаДоходностиПИФИОтклоненияОтИнфляцииВЗапрос(Запрос, Дата, Отказ) Экспорт
	
	// Процедура используется во внешней обработке _КлючевойИнформационныйДокумент и внешнем отчете _РасчетДоходностиПИФиОтклоненияОтИнфляции
	
	// Запрос помещает в менеджер временных таблиц:
	//	1. Данные по стоимости пая, СЧА и РСА ПИФ:
	//		- на дату, переданную в параметре Дата
	//		- на конец предыдущих 6 календарных лет (по рабочим датам) от этой даты; при этом, если дата окончания формирования ПИФ не ранее 5го года,
	//        то на последний рабочий день месяца даты окончания формирования ПИФ (строка предыдущего года заменяется на эту).
	//	 	- на конец предыдущих 1, 3, 6, 12, 36, 60 месяцев (по рабочим дням) от этой даты
	//
	//	2. Данные по месячной инфляции (ИПЦкКонцуПредыдущегоМесяца) за месяц даты из параметра, а также за 60 предыдущих месяцев
	// 	   При этом, если данные по инфляции за месяц даты из параметра отсутствуют, для этого месяца используются данные за предыдущий месяц
	//
	//  3. Данные по доходам к выплате пайщикам за периоды из п. 1
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе, переданном в ДобавитьДанныеДляРасчетаДоходностиПИФИОтклоненияОтИнфляцииВЗапрос, не определен менеджер временных таблиц",,,, Отказ);
		Возврат;
	КонецЕсли;
			
	Запрос.УстановитьПараметр("ДатаРезультатовИнвестирования", 	Дата);
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
	
	#Область Текст_запроса
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ДатаОкончанияФормированияПИФ.Значение КАК ДАТА) КАК Дата,
		|	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ВЫРАЗИТЬ(ДатаОкончанияФормированияПИФ.Значение КАК ДАТА), ГОД, -1), ГОД) КАК Год
		|ПОМЕСТИТЬ _ДатаОкончанияФормированияПИФ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
		|ГДЕ
		|	ДатаОкончанияФормированияПИФ.Объект В
		|			(ВЫБРАТЬ
		|				_КлиентДоверительногоУправления.Клиент
		|			ИЗ
		|				_КлиентДоверительногоУправления)
		|	И ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ДатаРезультатовИнвестирования"" КАК ВидИнтервала,
		|	&ДатаРезультатовИнвестирования КАК Дата,
		|	&ДатаРезультатовИнвестирования КАК ДатаСЧА
		|ПОМЕСТИТЬ _ДатыСведений
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Месяцы"",
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	МАКСИМУМ(ДанныеКалендаря.Дата)
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -1), МЕСЯЦ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -1), МЕСЯЦ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Месяцы"",
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	МАКСИМУМ(ДанныеКалендаря.Дата)
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -3), МЕСЯЦ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаРезультатовИнвестирования, МЕСЯЦ, -3), МЕСЯЦ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Месяцы"",
