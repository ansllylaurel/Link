			|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ";
		
	Иначе	
	
		Запрос.Текст = 		
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент КАК Контрагент,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Основание,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта КАК Валюта,
			|	СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК СуммаНаКонец
			|ПОМЕСТИТЬ _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
			|ИЗ
			|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
			|ГДЕ
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
			|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
			|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность
			|
			|СГРУППИРОВАТЬ ПО
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание,
			|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта
			|";
	
	КонецЕсли;

	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВложенныйЗапрос.СуммаНаКонец) КАК СуммаНаКонец
		|ПОМЕСТИТЬ _ОбщаяДебиторскаяЗадолженность
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаНаКонец КАК СуммаНаКонец
		|	ИЗ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|	ГДЕ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|		И ВЫБОР
		|				КОГДА &ОтражатьРЕПОВРазделе = ""Займы""
		|					ТОГДА _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_СтоимостьПереоценки.СуммаКупонаНаКонец
		|	ИЗ
		|		_СтоимостьПереоценки КАК _СтоимостьПереоценки
		|	ГДЕ
		|		НЕ _СтоимостьПереоценки.НКДВСправедливойСтоимостиЦБ) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВложенныйЗапрос.СуммаНаКонец) КАК СуммаНаКонец
		|ПОМЕСТИТЬ _ОбщаяСтоимостьАктивов
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаНаКонец КАК СуммаНаКонец
		|	ИЗ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|	ГДЕ
		|		_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива <> ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_СтоимостьПереоценки.СуммаНаКонец + _СтоимостьПереоценки.СуммаКупонаНаКонец
		|	ИЗ
		|		_СтоимостьПереоценки КАК _СтоимостьПереоценки) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_СтоимостьПереоценки.СуммаНаКонец + ВЫБОР
		|			КОГДА _СтоимостьПереоценки.НКДВСправедливойСтоимостиЦБ
		|				ТОГДА _СтоимостьПереоценки.СуммаКупонаНаКонец
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаНаКонец
		|ПОМЕСТИТЬ _СтоимостьПереоценки_Итоговая
		|ИЗ
		|	_СтоимостьПереоценки КАК _СтоимостьПереоценки
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьПереоценки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_СтоимостьПереоценки.СуммаКупонаНаКонец) КАК СуммаКупонаНаКонец
		|ПОМЕСТИТЬ _СтоимостьКупона
		|ИЗ
		|	_СтоимостьПереоценки КАК _СтоимостьПереоценки,
		|	_ОбщаяДебиторскаяЗадолженность КАК _ОбщаяДебиторскаяЗадолженность
		|ГДЕ
		|	НЕ _СтоимостьПереоценки.НКДВСправедливойСтоимостиЦБ
		|	И ВЫБОР
		|			КОГДА НЕ &ВыводитьАктивыКакВПеречнеИмуществаПИФ
		|				ТОГДА _СтоимостьПереоценки.СуммаКупонаНаКонец / _ОбщаяДебиторскаяЗадолженность.СуммаНаКонец * 100 > 1
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И _СтоимостьПереоценки.СуммаКупонаНаКонец <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьПереоценки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент КАК Контрагент,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Основание,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта КАК Валюта,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаНаКонец КАК СуммаНаКонец
		|ПОМЕСТИТЬ _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам_Итоговая
		|ИЗ
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам,
		|	_ОбщаяДебиторскаяЗадолженность КАК _ОбщаяДебиторскаяЗадолженность
		|ГДЕ
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|	И ВЫБОР
		|			КОГДА &ОтражатьРЕПОВРазделе = ""Займы""
		|				ТОГДА _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА НЕ &ВыводитьАктивыКакВПеречнеИмуществаПИФ
		|				ТОГДА _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаНаКонец / _ОбщаяДебиторскаяЗадолженность.СуммаНаКонец * 100 > 1
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта,
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаНаКонец
		|ИЗ
		|	_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	(_СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива <> ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ ВЫБОР
		|				КОГДА _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|						И &ОтражатьРЕПОВРазделе = ""Займы""
		|					ТОГДА _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СтоимостьПереоценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СтоимостьАктивовНеОтносящихсяКЦеннымБумагам";
	
	Запрос.Выполнить();
	
КонецПроцедуры
	
&НаСервере
Процедура ПолучитьСтруктуруДанныхНаСервере(Отказ, ТолькоДиаграмма = Ложь)
	
	Если ТолькоДиаграмма Тогда
		СтруктураДанных = ДанныеДляЗаполнения;
	Иначе	
		СтруктураДанных = Новый Структура;	
		СтруктураПолейФайла = Новый Структура;
		СтруктураДанных.Вставить("Реквизиты", СтруктураПолейФайла);
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", Объект.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("ДатаКИД", Объект.ДатаКлючевогоИнформационногоДокумента);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ЮрФизЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	&ЮрФизЛицо КАК ЮрФизЛицоОрганизации,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо КАК СпецДеп
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаКИД, СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &ПаевойИнвестиционныйФонд";
	
	Запрос.Выполнить();
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КлиентДоверительногоУправления").ПолучитьДанные().Выбрать();
	
	СчетДоверительногоУправления = Неопределено;   	
	
	ВыводитьАктивыКакВПеречнеИмуществаПИФ = Объект.ДатаКлючевогоИнформационногоДокумента >= '20231001';
	
	Если Выборка.Следующий() Тогда		
	                            		
		Запрос.УстановитьПараметр("ОтражатьРЕПОВРазделе", РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройки(Объект.ДатаКлючевогоИнформационногоДокумента, Выборка.СчетДоверительногоУправления, "_ОтчетностьЦБ", "ОтражатьРЕПОВРазделе"));
		Запрос.УстановитьПараметр("ДатаРезультатовИнвестирования", Объект.ДатаРезультатовИнвестирования);
		Запрос.УстановитьПараметр("ЮрФизЛицо_Росстат", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Росстат"));
		Запрос.УстановитьПараметр("ВыводитьАктивыКакВПеречнеИмуществаПИФ", ВыводитьАктивыКакВПеречнеИмуществаПИФ);
		
		СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		ДобавитьСтоимостьАктивовНаДатуВЗапрос(Запрос, Объект.ДатаКлючевогоИнформационногоДокумента, СчетДоверительногоУправления, ВыводитьАктивыКакВПеречнеИмуществаПИФ, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные о ПИФе " + СокрЛП(Объект.ПаевойИнвестиционныйФонд) + " в " + СокрЛП(Объект.Организация),,,, Отказ);		
		Возврат;
	КонецЕсли;
	
	ПериодПриостановкиПИФ = Справочники.ПаевыеИнвестиционныеФонды.ПериодПриостановкиОперацийСПаями(СчетДоверительногоУправления);
	ЭтоПриостановленныйПИФ = БухгалтерскийУчет.ОпределитьНастройкиУчета(Объект.ДатаРезультатовИнвестирования, Объект.Организация, СчетДоверительногоУправления).ПриостановленРасчетСЧА;
	ДобавитьДанныеДляРасчетаДоходностиПИФИОтклоненияОтИнфляцииВЗапрос(Запрос, Объект.ДатаРезультатовИнвестирования, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	#Область Текст_запроса

	Если ТолькоДиаграмма Тогда
		
		Запрос.УстановитьПараметр("ЕстьПериодПриостановки", ПериодПриостановкиПИФ <> Неопределено);
		
		Запрос.Текст = 
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	ДатаОкончанияФормированияПИФ.Значение КАК ДатаФормированияПИФ
		    |ПОМЕСТИТЬ _Реквизиты
		    |ИЗ
		    |	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
		    |		ПО (ДатаОкончанияФормированияПИФ.Объект = _КлиентДоверительногоУправления.Клиент)
		    |			И (ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
