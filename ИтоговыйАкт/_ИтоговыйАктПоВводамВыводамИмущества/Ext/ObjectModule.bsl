  
 #Область Регистрационные_данные 
  
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Итоговый акт по вводам-выводам имущества",
		"1.36",
		"",
		Истина,
		"СкриншотФормы");
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Стандартные_процедуры_и_функции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРезультат.Очистить();
	
	ЭтоФилантроп = ЭтотОбъект.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Филантроп");
	
	Если ЭтотОбъект.ЕжемесячныйАкт Тогда
		
		// Проверим период: должен быть календарный месяц
		Если Не (ЭтотОбъект.Период.ДатаНачала = НачалоМесяца(ЭтотОбъект.Период.ДатаНачала) 
				И ЭтотОбъект.Период.ДатаОкончания = КонецМесяца(ЭтотОбъект.Период.ДатаОкончания) 
				И ЭтотОбъект.Период.ДатаНачала = НачалоМесяца(ЭтотОбъект.Период.ДатаОкончания)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Периодом отчета может быть только календарный месяц. Укажите корректный период");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	СтруктураПодписантаКлиента = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураПодписантаКлиента", СтруктураПодписантаКлиента);
	
	Если Не ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан подписант");
		Возврат;
	КонецЕсли;                                                                  
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ВидыОперацийВводаВыводаДенежныхСредствПоДУ = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВидыОперацийСАктивамиДоверительногоУправления();
	
	Если ЭтотОбъект.Выгрузить Тогда
		Отказ = Ложь;
		РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ЭтотОбъект.КаталогВыгрузки, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ЕжемесячныйАкт Тогда
					
		#Область Новые_Формы_НПФ
				
		Макет = ПолучитьМакет("МакетНПФ");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
				
		Запрос = Новый Запрос;	
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
		
		ВыборкаСчетаДУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выбрать();
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			ТекРезультат = Новый ТабличныйДокумент;
			
			ТекСчетДоверительногоУправления = ВыборкаСчетаДУ.СчетДоверительногоУправления;
			ВидДоговора 					= ВыборкаСчетаДУ.ВидДоговораДоверительногоУправления;
			
			#Область Текст_Запроса
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Регистратор,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Организация КАК Организация,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива КАК ВидАктива,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидОперацииВводаВыводаДС КАК ВидОперацииВводаВыводаДС,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения КАК НаправлениеДвижения,
				|	ВЫБОР
				|		КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|			ТОГДА ВЫБОР
				|					КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|						ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).СтрокаБанковскойВыписки
				|					КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|						ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).СтрокаБанковскойВыписки
				|					ИНАЧЕ ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.)
				|				КОНЕЦ
				|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.)
				|	КОНЕЦ КАК СтрокаБанковскойВыписки,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот КАК Сумма,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|			ТОГДА ВЫБОР
				|					КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание) = ТИП(Документ.ПоручениеНаДвижениеДенежныхСредств)
				|							И ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание <> ЗНАЧЕНИЕ(Документ.ПоручениеНаДвижениеДенежныхСредств.)
				|						ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание.НомерВходящегоДокумента
				|					ИНАЧЕ ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).НомерВходящегоДокумента
				|				КОНЕЦ
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).Основание.НомерВходящегоДокумента
				|	КОНЕЦ КАК НомерУведомления,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|			ТОГДА ВЫБОР
				|					КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание) = ТИП(Документ.ПоручениеНаДвижениеДенежныхСредств)
				|							И ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание <> ЗНАЧЕНИЕ(Документ.ПоручениеНаДвижениеДенежныхСредств.)
				|						ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание.ДатаВходящегоДокумента
				|					ИНАЧЕ ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).ДатаВходящегоДокумента
				|				КОНЕЦ
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).Основание.ДатаВходящегоДокумента
				|	КОНЕЦ КАК ДатаУведомления,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).КонтрагентДоговорТекстом
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).КонтрагентДоговорТекстом
				|		ИНАЧЕ """"
				|	КОНЕЦ КАК РеквизитыУККонтрагента,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).СтрокаБанковскойВыписки
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).СтрокаБанковскойВыписки
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК Платежка,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Контрагент
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
				|			ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВыводДенежныхСредств).Контрагент
				|	КОНЕЦ КАК Контрагент,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВыводДенежныхСредств))
				|			ТОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента
				|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
				|	КОНЕЦ КАК РасчетныйСчетКонтрагента,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК ДатаВводаВывода
				|ПОМЕСТИТЬ _ВводыВыводыЗаПериод
				|ИЗ
				|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
				|			&ДатаНачала,
				|			&ДатаОкончания,
				|			Регистратор,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|				И ВидОперацииВводаВыводаДС В (&ВидыОперацийВводаВыводаДС, ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка))) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
				|				&ДатаОкончания,
				|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
				|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
				|		ПО (ВЫБОР
				|				КОГДА ТИПЗНАЧЕНИЯ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
				|					ТОГДА ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Контрагент
