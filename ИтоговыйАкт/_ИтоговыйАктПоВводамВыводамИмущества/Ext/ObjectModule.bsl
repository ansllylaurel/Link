				|	И _ВводыВыводыЗаПериод.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
				|
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(_ВводыВыводыЗаПериод.Период, ДЕНЬ)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Порядок,
				|	ДатаПлатежногоДокумента
				|ИТОГИ
				|	СУММА(Сумма)
				|ПО
				|	ОБЩИЕ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	1 КАК Порядок,
				|	_ВводыВыводыЗаПериод.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
				|	_ВводыВыводыЗаПериод.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
				|	ЕСТЬNULL(_ВводыВыводыЗаПериод.Сумма, 0) КАК Сумма
				|ИЗ
				|	_ВводыВыводыЗаПериод КАК _ВводыВыводыЗаПериод
				|ГДЕ
				|	_ВводыВыводыЗаПериод.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
				|	И _ВводыВыводыЗаПериод.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	2,
				|	""Депозитные вклады"",
				|	НАЧАЛОПЕРИОДА(_ВводыВыводыЗаПериод.Период, ДЕНЬ),
				|	ЕСТЬNULL(СУММА(_ВводыВыводыЗаПериод.Сумма), 0)
				|ИЗ
				|	_ВводыВыводыЗаПериод КАК _ВводыВыводыЗаПериод
				|ГДЕ
				|	_ВводыВыводыЗаПериод.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
				|	И _ВводыВыводыЗаПериод.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
				|
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(_ВводыВыводыЗаПериод.Период, ДЕНЬ)
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	3,
				|	""Ценные бумаги"",
				|	НАЧАЛОПЕРИОДА(_ВводыВыводыЗаПериод.Период, ДЕНЬ),
				|	ЕСТЬNULL(СУММА(_ВводыВыводыЗаПериод.СуммаБалансовая), 0)
				|ИЗ
				|	_ВводыВыводыЗаПериод КАК _ВводыВыводыЗаПериод
				|ГДЕ
				|	_ВводыВыводыЗаПериод.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
				|	И _ВводыВыводыЗаПериод.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
				|
				|СГРУППИРОВАТЬ ПО
				|	НАЧАЛОПЕРИОДА(_ВводыВыводыЗаПериод.Период, ДЕНЬ)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Порядок,
				|	ДатаПлатежногоДокумента
				|ИТОГИ
				|	СУММА(Сумма)
				|ПО
				|	ОБЩИЕ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ВводыВыводыЗаПериод
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ВводыВыводы
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ВводыВыводы_ПредыдущийГод
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ ВТ_Данные";
			
			#КонецОбласти
			
			Запрос.УстановитьПараметр("ДатаНачала", 					ЭтотОбъект.Период.ДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
			Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);		
			Запрос.УстановитьПараметр("ВидПоказателя", 					Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
			Запрос.УстановитьПараметр("ДатаНачалаПредыдущегоГода",		ДобавитьМесяц(ЭтотОбъект.Период.ДатаНачала, -12));
			Запрос.УстановитьПараметр("ДатаОкончанияПредыдущегоГода", 	КонецДня(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -12)));
			Запрос.УстановитьПараметр("ДатаСЧАНаКонецПериода", 			ДатаСЧАНаКонецПериода);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ВыборкаСчетаДУ.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ВидыОперацийВводаВыводаДС",		ВидыОперацийВводаВыводаДенежныхСредствПоДУ);
			
			ПакетЗапросов = Запрос.ВыполнитьПакет();
			ИндексПоследнегозапроса = ПакетЗапросов.ВГраница() - 4;
			
			// Шапка
			Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 3].Выбрать();

			НаименованиеКлиента = "";
			НаименованиеУК		= "";
			ВидДоговораДоверительногоУправления = Неопределено;
			Если Выборка.Следующий() Тогда                		
				НаименованиеКлиента 						= Выборка.НаименованиеКлиента;
				НаименованиеУК								= Выборка.НаименованиеУК;
				ОбластьШапка.Параметры.НаименованиеКлиента 	= ВРег(НаименованиеКлиента);		
				ОбластьШапка.Параметры.НаименованиеУК 		= ВРег(НаименованиеУК);		
				ОбластьШапка.Параметры.НомерДоговораДУ 		= ВРег(Выборка.НомерДоговораДУ);		
				ОбластьШапка.Параметры.ДатаДоговораДУ 		= Формат(Выборка.ДатаДоговораДУ, "ДЛФ=DD");
				ОбластьШапка.Параметры.ОтчетныйПериод 		= ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
				
				ВидДоговораДоверительногоУправления = Выборка.ВидДоговораДоверительногоУправления;
				Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
					ОбластьШапка.Параметры.ВидСредств = "СРЕДСТВ ПЕНСИОННЫХ НАКОПЛЕНИЙ";
					ОбластьШапка.Параметры.ВидСредствТП = "СРЕДСТВАМИ ПЕНСИОННЫХ НАКОПЛЕНИЙ";
				ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
					ОбластьШапка.Параметры.ВидСредств = "СРЕДСТВ ПЕНСИОННЫХ РЕЗЕРВОВ";
					ОбластьШапка.Параметры.ВидСредствТП = "СРЕДСТВАМИ ПЕНСИОННЫХ РЕЗЕРВОВ";
				ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда
					ОбластьШапка.Параметры.ВидСредств = "СОБСТВЕННЫХ СРЕДСТВ ПЕНСИОННОГО ФОНДА";
					ОбластьШапка.Параметры.ВидСредствТП = "СОБСТВЕННЫМИ СРЕДСТВАМИ ПЕНСИОННОГО ФОНДА";
				Иначе
					ОбластьШапка.Параметры.ВидСредств = "";
					ОбластьШапка.Параметры.ВидСредствТП = "";
				КонецЕсли;
				
			КонецЕсли;
			
			ТекРезультат.Вывести(ОбластьШапка);
			
			Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса].Выбрать();
			
			ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
			ПараметрыПрописиНаРусском = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаУчета, "ПараметрыПрописиНаРусском");
			
			ЕстьСтроки = Ложь;
			
			СтрНомерРаздела = "1";
			ВывестиРаздел(ТекРезультат, Макет, Выборка, СтрНомерРаздела, ПараметрыПрописиНаРусском,,, ВидДоговораДоверительногоУправления, ЕстьСтроки);
			
			Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 1].Выбрать();
			СтрНомерРаздела = "2";
			ВывестиРаздел(ТекРезультат, Макет, Выборка, СтрНомерРаздела, ПараметрыПрописиНаРусском,,, ВидДоговораДоверительногоУправления, ЕстьСтроки); 
			
			Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 2].Выбрать();
			СтрНомерРаздела = "3";
			ВывестиРаздел(ТекРезультат, Макет, Выборка, СтрНомерРаздела, ПараметрыПрописиНаРусском, Ложь,, ВидДоговораДоверительногоУправления, ЕстьСтроки); 
			
			// Подписи			
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
			
			ОбластьПодвал.Параметры.НаименованиеУК 		= НаименованиеУК;
			ОбластьПодвал.Параметры.НаименованиеКлиента = НаименованиеКлиента;
					
			ОбластьПодвал.Параметры.Ответственный = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
			
			Если СтруктураПодписантаКлиента <> Неопределено Тогда
				ОбластьПодвал.Параметры.ПодписантКлиента = СтруктураПодписантаКлиента.Подписант;				
			КонецЕсли;
			
			ТекРезультат.Вывести(ОбластьПодвал);
			
			Если ЭтотОбъект.Выгрузить И ЕстьСтроки Тогда
				//Сохраняем в Word
				ТекРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
				ИмяФайла = ЭтотОбъект.КаталогВыгрузки + "\" + ПолучитьИмяФайла(НаименованиеКлиента) + ".docx";			
				ТекРезультат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);
			КонецЕсли;
			
			ДокументРезультат.Вывести(ТекРезультат);
			ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла;
		
		#КонецОбласти
			
	КонецЕсли;

	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя() + ?(ЭтотОбъект.ЕжемесячныйАкт, "Ежемесячный", ""),, ?(ЭтотОбъект.ЕжемесячныйАкт, ОриентацияСтраницы.Ландшафт, ОриентацияСтраницы.Портрет));
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВариантФормирования = 0 Тогда
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
	Иначе
		ПроверяемыеРеквизиты.Добавить("Клиент");
	КонецЕсли;
	
	Если ЭтотОбъект.Выгрузить Тогда
		ПроверяемыеРеквизиты.Добавить("КаталогВыгрузки");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

Процедура ВывестиРаздел(ДокументРезультат, Макет, Выборка, СтрНомерРаздела, ПараметрыПрописиВалютыНаРусском, ЕстьПодвал = Истина, НовыеФормыНПФ = Ложь, ВидДоговора = Неопределено, ЕстьСтроки = Ложь)
	
	ЦветКрасный = Новый Цвет(255, 0, 0);
	
	Если НовыеФормыНПФ Тогда
		
		НомерРазделаВМакете = ?(СтрНомерРаздела = "1" Или СтрНомерРаздела = "2", "1", "2");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка_Раздел" + НомерРазделаВМакете);

		СоответствиеРазделовИТекстовШапки = Новый Соответствие;
		СоответствиеРазделовИТекстовШапки.Вставить("1", "переданные Фондом в доверительное управление Управляющему");
		СоответствиеРазделовИТекстовШапки.Вставить("2", "переданные Управляющим Фонду");
				
		СоответствиеРазделовИТекстовКолонкиУведомление = Новый Соответствие;
		СоответствиеРазделовИТекстовКолонкиУведомление.Вставить("1", "Уведомление о передаче в ДУ");
		СоответствиеРазделовИТекстовКолонкиУведомление.Вставить("2", "Требование о выводе из ДУ");
		СоответствиеРазделовИТекстовКолонкиУведомление.Вставить("3", "Требование (Уведомление)");
		СоответствиеРазделовИТекстовКолонкиУведомление.Вставить("4", "Требование (Уведомление)");
		
		ТекстВидДоговора = "";						
		Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ТекстВидДоговора = "Средства пенсионных накоплений";			
			СоответствиеРазделовИТекстовШапки.Вставить("3", "принятые Управляющим в доверительное управление из состава средств пенсионных накоплений,  доверительное управление которыми осуществляется Управляющим по иному договору доверительного управления средствами пенсионных накоплений");
			СоответствиеРазделовИТекстовШапки.Вставить("4", "переданные Управляющим в доверительное управление, осуществляемое Управляющим по иному договору доверительного управления средствами пенсионных накоплений");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ТекстВидДоговора = "Средства пенсионных резервов";			
			СоответствиеРазделовИТекстовШапки.Вставить("3", "принятые Управляющим в доверительное управление из состава средств пенсионных резервов, доверительное управление которыми осуществляется Управляющим по иному договору доверительного управления средствами пенсионных резервов");
			СоответствиеРазделовИТекстовШапки.Вставить("4", "переданные Управляющим в доверительное управление, осуществляемое Управляющим по иному договору доверительного управления средствами пенсионных резервов");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда
			ТекстВидДоговора = "Собственные средства";
			СоответствиеРазделовИТекстовШапки.Вставить("3", "принятые Управляющим в доверительное управление из состава собственных средств, доверительное управление которыми осуществляется Управляющим по иному договору доверительного управления собственными средствами");
			СоответствиеРазделовИТекстовШапки.Вставить("4", "переданные Управляющим в доверительное управление, осуществляемое Управляющим по иному договору доверительного управления собственными средствами");
		КонецЕсли;	
		
		ОбластьШапка.Параметры.ТекстРаздела = СтрНомерРаздела + ". " + ТекстВидДоговора + ", " + СоответствиеРазделовИТекстовШапки.Получить(СтрНомерРаздела);
		ОбластьШапка.Параметры.КолонкаУведомление = СоответствиеРазделовИТекстовКолонкиУведомление.Получить(СтрНомерРаздела);
				
		Если НомерРазделаВМакете = "2" Тогда
			ОбластьШапка.Параметры.ОтправительПолучатель = ?(СтрНомерРаздела = "3", "отправителя", "получателя");
		КонецЕсли;
		
		// Итоги 
		ИтогоРынок = 0;		
		Если Выборка.Следующий() И ЕстьПодвал Тогда			
			ИтогоРынок = Выборка.РыночнаяСтоимость;			
		КонецЕсли;
					
		ДокументРезультат.Вывести(ОбластьШапка);
				
		Если ЕстьПодвал Тогда
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка_Раздел" + НомерРазделаВМакете);
			
			Сч = 1;
			// Элементы выборки
			Пока Выборка.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(Выборка.РыночнаяСтоимость) Тогда 
					Продолжить;
				КонецЕсли;
				
				ЕстьСтроки = Истина;
				
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				
				СтрКонтрагент = "";				
				Если НомерРазделаВМакете = "2" И ЗначениеЗаполнено(Выборка.Платежка) И ПустаяСтрока(ОбластьСтрока.Параметры.РеквизитыУККонтрагента) Тогда
					
					// Получаем текст контрагента из платежки				
					ИсходныеДанные = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Платежка, "ИсходныеДанные");
					
					Для НомерСтроки = 1 По СтрЧислоСтрок(ИсходныеДанные) Цикл
						ТекСтрока = СтрПолучитьСтроку(ИсходныеДанные, НомерСтроки);						
						ИскомаяСтрока = ?(СтрНомерРаздела = "1" Или СтрНомерРаздела = "3", "Плательщик1", "Получатель1"); 
						Если Найти(ТекСтрока, ИскомаяСтрока) > 0 Тогда
							СтрКонтрагент = СтрЗаменить(ТекСтрока, ИскомаяСтрока + "=", "");
							Прервать;
						КонецЕсли;
					КонецЦикла;  					
					
					Если НомерРазделаВМакете = "2" Тогда
						ОбластьСтрока.Параметры.РеквизитыУККонтрагента = СтрКонтрагент;
					КонецЕсли;
										
				ИначеЕсли СтрНомерРаздела = "3" И СтрДлина(ОбластьСтрока.Параметры.РеквизитыУККонтрагента) < 20 Тогда
					
					ОбластьСтрока.Параметры.РеквизитыУККонтрагента = РаботаСДокументами.ПолучитьТекстКонтрагентаДляВводовВыводовДенежныхСредств(
																ЭтотОбъект.Организация,
																Выборка.Контрагент,
																Выборка.РасчетныйСчетКонтрагента,
																Истина,
																ЭтотОбъект.Период.ДатаНачала);
					
				КонецЕсли;
				
				Если НомерРазделаВМакете = "2" И ПустаяСтрока(ОбластьСтрока.Параметры.РеквизитыУККонтрагента) Тогда
					// Не хватает данных по контрагенту, подсвечиваем
					ОбластьСтрока.Область("R1C8:R1C8").ЦветФона = ЦветКрасный;
				КонецЕсли;	
				
				ОбластьСтрока.Параметры.ПорядковыйНомер = Сч;
				ДокументРезультат.Вывести(ОбластьСтрока);	
				Сч = Сч + 1;
				
			КонецЦикла;                	
			
			// Подвал                                     	
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал_Раздел" + НомерРазделаВМакете);
			ОбластьПодвал.Параметры.РыночнаяСтоимость = ИтогоРынок;
					
			ДокументРезультат.Вывести(ОбластьПодвал);
			
		КонецЕсли;	
		
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов И Не ЕстьПодвал Тогда
		
		//Филантроп
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка_Раздел1");
		
		Если Не Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка_Раздел1");
		ДокументРезультат.Вывести(ОбластьШапка);	
		
		
		Сч = 1;
		// Элементы выборки
		Пока Выборка.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.РыночнаяСтоимость) Тогда 
				Продолжить;
			КонецЕсли;
			
			ЕстьСтроки = Истина;
			
			ОбластьСтрока.Параметры.Заполнить(Выборка);
					
			ОбластьСтрока.Параметры.ПорядковыйНомер = Сч;
			ДокументРезультат.Вывести(ОбластьСтрока);	
			Сч = Сч + 1;
			
		КонецЦикла;
		
	Иначе
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка_Раздел" + СтрНомерРаздела);
		
		// Итоги 
		Итого = 0;
		Если ЕстьПодвал Тогда
			Если Выборка.Следующий() Тогда
				Итого = Выборка.Сумма;		
			КонецЕсли;
		Иначе
			// Заполняем раздел
			Если Выборка.Следующий() Тогда
				ОбластьШапка.Параметры.Заполнить(Выборка);
				ОбластьШапка.Параметры.НачалоГода = Формат(ЭтотОбъект.Период.ДатаНачала, "ДЛФ=DD");
				ОбластьШапка.Параметры.КонецГода = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДЛФ=DD");								
			КонецЕсли;
		КонецЕсли;	
		
		Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			
			ОбластьШапка.Параметры.ВидСредств = "Средства пенсионных накоплений";
						
			Если СтрНомерРаздела = "1" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственным пенсионным фондом ";
			ИначеЕсли СтрНомерРаздела = "2" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственному пенсионному фонду";
			ИначеЕсли СтрНомерРаздела = "3" Тогда
				ОбластьШапка.Параметры.ВидСредствРП = "средств пенсионных накоплений";				
			КонецЕсли;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			
			ОбластьШапка.Параметры.ВидСредств = "Средства пенсионных резервов";
			
			Если СтрНомерРаздела = "1" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственным пенсионным фондом ";
			ИначеЕсли СтрНомерРаздела = "2" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственному пенсионному фонду";
			ИначеЕсли СтрНомерРаздела = "3" Тогда
				ОбластьШапка.Параметры.ВидСредствРП = "средств пенсионных резервов";
			КонецЕсли;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда
			
			ОбластьШапка.Параметры.ВидСредств = "Собственные средства пенсионного фонда";
			
			Если СтрНомерРаздела = "1" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственным пенсионным фондом ";
			ИначеЕсли СтрНомерРаздела = "2" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "негосударственному пенсионному фонду";
			ИначеЕсли СтрНомерРаздела = "3" Тогда
				ОбластьШапка.Параметры.ВидСредствРП = "собственных средств пенсионного фонда";
			КонецЕсли;
			
		Иначе
			
			ОбластьШапка.Параметры.ВидСредств = "Средства";
			
			Если СтрНомерРаздела = "1" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "";
			ИначеЕсли СтрНомерРаздела = "2" Тогда
				ОбластьШапка.Параметры.ТипКлиента = "";
			ИначеЕсли СтрНомерРаздела = "3" Тогда
				ОбластьШапка.Параметры.ВидСредствРП = "средств";
			КонецЕсли;	
			
		КонецЕсли;
				
		ДокументРезультат.Вывести(ОбластьШапка);
				
		Если ЕстьПодвал Тогда
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка_Раздел" + СтрНомерРаздела);
			
			Сч = 1;
			// Элементы выборки
			Пока Выборка.Следующий() Цикл
				Если Не ЗначениеЗаполнено(Выборка.Сумма) Тогда 
					Продолжить;
				КонецЕсли;
				
				ЕстьСтроки = Истина;
				
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ОбластьСтрока.Параметры.ПорядковыйНомер = Сч;
				ДокументРезультат.Вывести(ОбластьСтрока);	
				Сч = Сч + 1;
			КонецЦикла;
			
			// Подвал                                     	
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал_Раздел" + СтрНомерРаздела);
			ОбластьПодвал.Параметры.ИтогоПрописью = "ИТОГО: " + Формат(Итого, "ЧДЦ=2; ЧРГ=' '") + " (" + ЧислоПрописью(Итого,, ПараметрыПрописиВалютыНаРусском) + ")";
			ДокументРезультат.Вывести(ОбластьПодвал);
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаОкончания,
		|			ВЫБОР
		|					КОГДА &РежимФормирования = 0
		|						ТОГДА СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &ДатаНачала)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &РежимФормирования = 1
		|				ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("РежимФормирования", 				ЭтотОбъект.ВариантФормирования);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент", 						ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ДатаОкончания", 					ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаНачала",						ЭтотОбъект.Период.ДатаНачала);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьИмяФайла(ТекСчетДоверительногоУправления)
	
	ИмяФайла = "Акт ";
		
	ИмяФайла = ИмяФайла + РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(СокрЛП(ТекСчетДоверительногоУправления));
		
	ИмяФайла = ИмяФайла + " " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ='MMMM yyyy'");	
	
	Возврат ИмяФайла;
	
КонецФункции

#КонецОбласти

#Область Экспортные_процедуры_и_функции

Функция ЭтоНПФ() Экспорт
	
	Если Не (ЗначениеЗаполнено(ЭтотОбъект.Клиент) И ЭтотОбъект.Период.ДатаНачала <> '00010101' И ЭтотОбъект.Период.ДатаОкончания <> '00010101') Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|ГДЕ
		|	_СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов))";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ТаблицаПодписантовКлиента() Экспорт
	
	Если Не ((ЗначениеЗаполнено(ЭтотОбъект.Клиент) Или ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)) 
			И ЭтотОбъект.Период.ДатаНачала <> '00010101' 
			И ЭтотОбъект.Период.ДатаОкончания <> '00010101') Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	МАКСИМУМ(АнкетаЮридическогоЛица.Дата) КАК Дата
	    |ПОМЕСТИТЬ _ДатыАнкет
	    |ИЗ
	    |	Документ.АнкетаЮридическогоЛица КАК АнкетаЮридическогоЛица
	    |ГДЕ
	    |	АнкетаЮридическогоЛица.ЮрФизЛицо В
	    |			(ВЫБРАТЬ
	    |				_СчетаДоверительногоУправления.Клиент
	    |			ИЗ
	    |				_СчетаДоверительногоУправления)
	    |	И НЕ АнкетаЮридическогоЛица.ПометкаУдаления
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	АнкетаЮридическогоЛица.Ссылка КАК Анкета
	    |ПОМЕСТИТЬ _Анкеты
	    |ИЗ
	    |	Документ.АнкетаЮридическогоЛица КАК АнкетаЮридическогоЛица
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыАнкет КАК _ДатыАнкет
	    |		ПО АнкетаЮридическогоЛица.Дата = _ДатыАнкет.Дата
	    |ГДЕ
	    |	АнкетаЮридическогоЛица.ЮрФизЛицо В
	    |			(ВЫБРАТЬ
	    |				_СчетаДоверительногоУправления.Клиент
	    |			ИЗ
	    |				_СчетаДоверительногоУправления)
	    |	И НЕ АнкетаЮридическогоЛица.ПометкаУдаления
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Должность КАК Должность,
	    |	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо КАК Подписант,
	    |	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка КАК Ссылка
	    |ИЗ
	    |	Документ.АнкетаЮридическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Анкеты КАК _Анкеты
	    |		ПО АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка = _Анкеты.Анкета
	    |ГДЕ
	    |	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ВидУчастника = ЗНАЧЕНИЕ(Перечисление.ВидыУчастниковАнкет.Представитель)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти
