				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ _ВводыВыводыЗаПериод";
			
			#КонецОбласти
			
			Запрос.УстановитьПараметр("ДатаНачала", 					ЭтотОбъект.Период.ДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
			Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);		
						
			Запрос.УстановитьПараметр("ЮрЛицоОрганизации", 				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо"));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",   ТекСчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ВидыОперацийВводаВыводаДС",		ВидыОперацийВводаВыводаДенежныхСредствПоДУ);
			
			ПакетЗапросов = Запрос.ВыполнитьПакет();
			ИндексПоследнегозапроса = ПакетЗапросов.ВГраница() - 1;
							
			// Шапка
			Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 2].Выбрать();

			НаименованиеКлиента = "";
			НаименованиеУК		= "";
			НаименованиеЦК		= "";
			Если Выборка.Следующий() Тогда
				
				НаименованиеКлиента 						= Выборка.НаименованиеКлиента;
				НаименованиеУК								= Выборка.НаименованиеУК;
				НаименованиеЦК								= Выборка.НаименованиеЦК;
				
						
				ОбластьШапка.Параметры.НомерДоговораДУ 		= ВРег(Выборка.НомерДоговораДУ);
				ОбластьШапка.Параметры.ДатаДоговораДУ 		= Формат(Выборка.ДатаДоговораДУ, "ДЛФ=DD");
				ОбластьШапка.Параметры.ОтчетныйПериод		= ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
				ОбластьШапка.Параметры.ДатаОтчета			= Формат(ТекущаяДатаСеанса(), "ДЛФ=DD");
			КонецЕсли;
						
			ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
			ПараметрыПрописиНаРусском = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаУчета, "ПараметрыПрописиНаРусском");
			
			Сч = 1;			
		Пока Сч >= 0 Цикл
			
			ЕстьСтроки = Ложь;
			ОбластьШапка.Параметры.НаименованиеЦК = НаименованиеЦК;
			ОбластьШапка.Параметры.ПередалПринял = ?(Сч = 1, "передал",	"принял");
			ОбластьШапка.Параметры.ПринялПередал = ?(Сч = 1, "принял",	"передал");
			
			ТекРезультат.Вывести(ОбластьШапка);
				
				Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - Сч].Выбрать();			
				СтрНомерРаздела = СокрЛП(2 - Сч);
				ВывестиРаздел(ТекРезультат, Макет, Выборка, СтрНомерРаздела, ПараметрыПрописиНаРусском, Ложь, Ложь, ВидДоговора, ЕстьСтроки);
				
				Сч = Сч - 1;					
				
				// Подписи					
				ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
				
			ОбластьПодвал.Параметры.Ответственный           = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
			//ОбластьПодвал.Параметры.ДолжностьОтветственного = СтруктураДанныхКонтактногоЛица.Должность;
			
			Если СтруктураПодписантаКлиента <> Неопределено Тогда
				ОбластьПодвал.Параметры.ПодписантКлиента           = СтруктураПодписантаКлиента.Подписант;
				//ОбластьПодвал.Параметры.ДолжностьПодписантаКлиента = СтруктураПодписантаКлиента.Должность;
			КонецЕсли;
				
				ТекРезультат.Вывести(ОбластьПодвал);
				
				Если ЭтотОбъект.Выгрузить И ЕстьСтроки Тогда
					//Сохраняем в Word
					ТекРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
					ИмяФайла = ЭтотОбъект.КаталогВыгрузки + "\" + ПолучитьИмяФайла(ТекСчетДоверительногоУправления) + ".docx";			
					ТекРезультат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);
				КонецЕсли;	
				
				Если ЕстьСтроки Тогда
					ДокументРезультат.Вывести(ТекРезультат);
					ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;
			
			КонецЦикла;
		
		КонецЦикла;
		
		#КонецОбласти

	Иначе
		
		#Область Стандартная_форма
	
		Макет = ПолучитьМакет("Макет");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
				
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
		
		ВыборкаСчетаДУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выбрать();
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			ТекРезультат = Новый ТабличныйДокумент;
			
			// Получим дату СЧА на конец периода
			ТекДатаНачала = ЭтотОбъект.Период.ДатаНачала;
			ТекДатаОкончания = НачалоДня(ЭтотОбъект.Период.ДатаОкончания);
			МассивДатСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ВыборкаСчетаДУ.СчетДоверительногоУправления, ТекДатаНачала, ТекДатаОкончания, Истина); 
			
			ДатаСЧАНаКонецПериода = '00010101';
			Если МассивДатСЧА.Количество() = 1 Тогда
				ДатаСЧАНаКонецПериода = МассивДатСЧА[0];
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить календарь дат для формирования СЧА. Данные о СЧА и доходности за текущий год не будут выведены в отчет");	
			КонецЕсли;
		
			#Область Текст_Запроса
			
			Запрос.Текст = 	
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Регистратор,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.Организация КАК Организация,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива КАК ВидАктива,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.ВидОперацииВводаВыводаДС КАК ВидОперацииВводаВыводаДС,
				|	ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения КАК НаправлениеДвижения,
				|	ВЫБОР
				|		КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|			ТОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор.СтрокаБанковскойВыписки.НазначениеПлатежа
				|		ИНАЧЕ """"
				|	КОНЕЦ КАК НазначениеПлатежа,
				|	ВЫБОР
				|		КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|			ТОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор.СтрокаБанковскойВыписки.НомерПлатежногоДокумента
				|		ИНАЧЕ ""-""
				|	КОНЕЦ КАК НомерПлатежногоДокумента,
				|	ВЫБОР
				|		КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				|			ТОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента
				|		ИНАЧЕ ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор.Дата
				|	КОНЕЦ КАК ДатаПлатежногоДокумента,
