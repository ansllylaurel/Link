
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Ожидаемые погашения ценных бумаг",
		"1.96",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ВариантОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);	
	
	// Фиксируем старт операции
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетаДоверительногоУправления,ДетализироватьПоСчетамДоверительногоУправления,КлючТекущегоВарианта", Новый Структура("ВариантОтчета",ВариантОтчета));
	
	Попытка
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
		
	КонецПопытки;
		
	Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	МВТ = Новый МенеджерВременныхТаблиц;

	МинимальнаяДатаФиксации = ПолучитьМинимальнуюДатуФиксации(МВТ, ВариантОтчета);
			
	Параметры.УстановитьЗначениеПараметра("МинимальнаяДатаФиксации", 						МинимальнаяДатаФиксации);	
	Параметры.УстановитьЗначениеПараметра("НачалоПериода", 									ЭтотОбъект.Период.ДатаНачала);
	Параметры.УстановитьЗначениеПараметра("КонецПериода", 									ЭтотОбъект.Период.ДатаОкончания);
	Параметры.УстановитьЗначениеПараметра("ДетализироватьПоСчетамДоверительногоУправления", ЭтотОбъект.ДетализироватьПоСчетамДоверительногоУправления);
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

	Запрос.УстановитьПараметр("МинимальнаяДатаФиксации", 								МинимальнаяДатаФиксации);	
	Запрос.УстановитьПараметр("Организация", 											ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", 											Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 											Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ОтборПоВидамДоговоровИСчетаДоверительногоУправления",	ЭтотОбъект.ОтборПоВидамДоговоровИСчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", 							ЭтотОбъект.СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("ИсключитьВидыДоговоровИСчетаДоверительногоУправления",	ЭтотОбъект.ИсключитьВидыДоговоровИСчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("ИсключаемыеСчетаДоверительногоУправления", 				ЭтотОбъект.ИсключаемыеСчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("ДетализироватьПоСчетамДоверительногоУправления", 		ЭтотОбъект.ДетализироватьПоСчетамДоверительногоУправления);
			
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДниПериода
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &МинимальнаяДатаФиксации И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага,
		|	КодыВТорговыхСистемахСрезПоследних.ВидКода КАК ВидКода,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыВТорговыхСистемах
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода В (ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN), ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ), ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий))) КАК КодыВТорговыхСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (НЕ &ОтборПоВидамДоговоровИСчетаДоверительногоУправления
		|			ИЛИ СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления))
		|	И НЕ(&ИсключитьВидыДоговоровИСчетаДоверительногоУправления
		|				И СчетаДоверительногоУправления.Ссылка В (&ИсключаемыеСчетаДоверительногоУправления))
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &МинимальнаяДатаФиксации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.Организация КАК Организация,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО КАК СделкаРЕПО
		|ПОМЕСТИТЬ _ЕстьВтораяЧастьРЕПО
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.Ссылка
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ВыплатыЗаПериод.ЦеннаяБумага
		|					ИЗ
		|						_ВыплатыЗаПериод КАК _ВыплатыЗаПериод)
		|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.Организация = УсловияСделокРЕПОСрезПоследних.Организация
		|			И ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|			И (УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = 2)
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО <= &КонецПериода
		|	И ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоОстаток <= 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.Организация КАК Организация,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО КАК СделкаРЕПО
		|ПОМЕСТИТЬ _НетВторойЧастиРЕПО
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.Ссылка
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ВыплатыЗаПериод.ЦеннаяБумага
		|					ИЗ
		|						_ВыплатыЗаПериод КАК _ВыплатыЗаПериод)
		|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.Организация = УсловияСделокРЕПОСрезПоследних.Организация
		|			И ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|			И (УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = 2)
		|ГДЕ
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоОстаток > 0
		|	И НЕ ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО В
		|				(ВЫБРАТЬ
		|					_ЕстьВтораяЧастьРЕПО.СделкаРЕПО
		|				ИЗ
		|					_ЕстьВтораяЧастьРЕПО КАК _ЕстьВтораяЧастьРЕПО)
		|	И УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО <= &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.Период КАК Период,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоОборот КАК КоличествоОборот,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.Брокер КАК Брокер
		|ПОМЕСТИТЬ _ОстаткиИОборотыЦенныхБумаг
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
		|			&МинимальнаяДатаФиксации,
		|			&КонецПериода,
		|			День,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.Ссылка
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						_ВыплатыЗаПериод.ЦеннаяБумага
		|					ИЗ
		|						_ВыплатыЗаПериод КАК _ВыплатыЗаПериод)
		|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))) КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СчетДоверительногоУправления,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО,
		|	0,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоКонечныйОстаток,
		|	-ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоКонечныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СделкаРЕПО.Брокер
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.ОстаткиИОбороты(
		|			&МинимальнаяДатаФиксации,
		|			&КонецПериода,
		|			День,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.Ссылка
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)
		|				И ЦеннаяБумага В
