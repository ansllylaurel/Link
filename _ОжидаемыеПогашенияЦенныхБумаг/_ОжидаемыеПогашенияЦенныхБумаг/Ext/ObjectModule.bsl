		|		_ВсеКодыУБрокеров.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = _ВсеКодыУБрокеров.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Период = _ВсеКодыУБрокеров.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаИзОстатковСБрокером.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаИзОстатковСБрокером.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	_СчетаИзОстатковСБрокером.Брокер КАК Брокер,
		|	_ВсеКодыУБрокеров.Код КАК Код
		|ПОМЕСТИТЬ _КодыУБрокеров
		|ИЗ
		|	_СчетаИзОстатковСБрокером КАК _СчетаИзОстатковСБрокером
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|		ПО _СчетаИзОстатковСБрокером.СчетДоверительногоУправления = _ВсеКодыУБрокеров.СчетДоверительногоУправления
		|			И _СчетаИзОстатковСБрокером.Брокер = _ВсеКодыУБрокеров.Брокер
		|ГДЕ
		|	_СчетаИзОстатковСБрокером.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СчетаИзОстатковБезБрокера.СчетДоверительногоУправления,
		|	_СчетаИзОстатковБезБрокера.СчетДоверительногоУправления.КодСчета,
		|	ЕСТЬNULL(_ЕдиничныеКодыУБрокеров.Брокер, _КодыБрокеровСМаксимальнымПериодом.Брокер),
		|	ЕСТЬNULL(_ЕдиничныеКодыУБрокеров.Код, _КодыБрокеровСМаксимальнымПериодом.Код)
		|ИЗ
		|	_СчетаИзОстатковБезБрокера КАК _СчетаИзОстатковБезБрокера
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЕдиничныеКодыУБрокеров КАК _ЕдиничныеКодыУБрокеров
		|		ПО _СчетаИзОстатковБезБрокера.СчетДоверительногоУправления = _ЕдиничныеКодыУБрокеров.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыБрокеровСМаксимальнымПериодом КАК _КодыБрокеровСМаксимальнымПериодом
		|		ПО _СчетаИзОстатковБезБрокера.СчетДоверительногоУправления = _КодыБрокеровСМаксимальнымПериодом.СчетДоверительногоУправления";
	
	#КонецОбласти
	
	Запрос.Выполнить();
	
	ВыборкаДепозитов = МВТ.Таблицы["_ДепозитныеВкладыСУсловиями"].ПолучитьДанные().Выбрать();

	ТаблицаПроцентовПоДепозитам = Новый ТаблицаЗначений;
	
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("КредитныйИнструмент", Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады, СправочникСсылка.Займы"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Проценты", Новый ОписаниеТипов("Число"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("ДатаДенежногоПотока", Новый ОписаниеТипов("Дата"));
	
	Пока ВыборкаДепозитов.Следующий() Цикл
		
		Попытка
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РаботаСКредитнымиИнструментами.ПолучитьПроцентыКредитныхИнструментовПоСчетуДоверительногоУправления(ВыборкаДепозитов.СчетДоверительногоУправления, ВыборкаДепозитов.ДатаРасчетаПроцентов,,,,,ВыборкаДепозитов.ДепозитныйВклад), ТаблицаПроцентовПоДепозитам);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВыборкаДепозитов.ПериодичностьВыплатыПроцентов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В условиях депозита [" + ВыборкаДепозитов.ДепозитныйВклад + "] не указана периодичность выплаты процентов.");
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("ТаблицаПроцентовПоДепозитам", ТаблицаПроцентовПоДепозитам);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПроцентовПоДепозитам.КредитныйИнструмент КАК КредитныйИнструмент,
		|	ТаблицаПроцентовПоДепозитам.Проценты КАК Проценты,
		|	ТаблицаПроцентовПоДепозитам.Операция КАК Операция,
		|	ТаблицаПроцентовПоДепозитам.ДатаДенежногоПотока КАК ДатаДенежногоПотока
		|ПОМЕСТИТЬ _ПроцентыПоДепозитнымВкладам
		|ИЗ
		|	&ТаблицаПроцентовПоДепозитам КАК ТаблицаПроцентовПоДепозитам";
	
	Запрос.Выполнить();
	
	// Выполняем програмную компоновку
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,,,,, Новый Структура("МенеджерВременныхТаблиц, РегистрацияСтатистики", МВТ, Ложь));
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
		
КонецПроцедуры // ПриКомпоновкеРезультата

Функция ПолучитьМинимальнуюДатуФиксации(МВТ, ВариантОтчета)
	
	МинимальнаяДатаФиксации = Период.ДатаОкончания; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ; 
	Запрос.УстановитьПараметр("НачалоПериода",		Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 		Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПечатьЗаявлений",	ВариантОтчета = "ПодачаЗаявленийНаОферту");
	Запрос.УстановитьПараметр("Облигация",			ЭтотОбъект.Облигация);
	
	Если ВариантОтчета = "ОплатыПоПогашениям" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДОБАВИТЬКДАТЕ(МАКСИМУМ(ДанныеКалендаря.Дата), ДЕНЬ, 1) КАК Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
		|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата < &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
