		|			И _КупоныОфертыНоминалыДивидендыВекселя.ДатаПогашения > ОфертыДосрочногоПогашения.ДатаВыкупа
		|			И (ОфертыДосрочногоПогашения.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО _КупоныОфертыНоминалыДивидендыВекселя.ВалютаНоминала = КурсыВалют.Валюта
		|			И (_КупоныОфертыНоминалыДивидендыВекселя.ДатаВыплатыПлан = ДАТАВРЕМЯ(1, 1, 1)
		|					И _КупоныОфертыНоминалыДивидендыВекселя.ДатаПогашения = КурсыВалют.Период
		|				ИЛИ _КупоныОфертыНоминалыДивидендыВекселя.ДатаВыплатыПлан = КурсыВалют.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
		|		ПО _КупоныОфертыНоминалыДивидендыВекселя.ВалютаНоминала = КурсыВалютСрезПоследних.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АмортизационныеОблигацииСИндексируемымНоминалом КАК _АмортизационныеОблигацииСИндексируемымНоминалом
		|		ПО _КупоныОфертыНоминалыДивидендыВекселя.ЦеннаяБумага = _АмортизационныеОблигацииСИндексируемымНоминалом.ЦеннаяБумага
		|ГДЕ
		|	ОфертыДосрочногоПогашения.Облигация ЕСТЬ NULL
		|	И _АмортизационныеОблигацииСИндексируемымНоминалом.ЦеннаяБумага ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ВыплатыЗаПериод.ДатаФиксацииОстатков) КАК МинимальнаяДатаФиксации
		|ИЗ
		|	_ВыплатыЗаПериод КАК _ВыплатыЗаПериод";
	
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.МинимальнаяДатаФиксации) Тогда
			МинимальнаяДатаФиксации = Выборка.МинимальнаяДатаФиксации;
		КонецЕсли;
		
	КонецЦикла;
	
	ОшибкиНоминала = МВТ.Таблицы["_АмортизационныеОблигацииСИндексируемымНоминалом"].ПолучитьДанные().Выбрать();
	
	Пока ОшибкиНоминала.Следующий() Цикл
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для амортизационных облигаций с индексируемым номиналом не определен расчет выплаты. Облигация [" + ОшибкиНоминала.ЦеннаяБумага + "]");
		
	КонецЦикла;
	
	Возврат МинимальнаяДатаФиксации;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	ВариантОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);	
	
	ТекстСообщения = "";
	Если ВариантОтчета <> "ПодачаЗаявленийНаОферту" Тогда
		
		Если ПроверяемыеРеквизиты.Найти("Облигация") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Облигация"));
		КонецЕсли;		
		
	КонецЕсли;
	
	Если ЭтотОбъект.Период.ДатаНачала = '00010101' Или ЭтотОбъект.Период.ДатаОкончания = '00010101' Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(ВариантОтчета = "ПодачаЗаявленийНаОферту", "Не заполнена дата оферты",  "Неверно указан период отчета"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

