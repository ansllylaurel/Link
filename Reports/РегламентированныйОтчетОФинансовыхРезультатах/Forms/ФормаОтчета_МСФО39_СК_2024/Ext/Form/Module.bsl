&НаСервере
Процедура ДобавитьВ_КешТаблицаДляСчетовОбесценение(мТаблицаСчетов)
	
	Если Адрес_КешТаблицаДляСчетовОбесценение = "" Тогда
		мКешТаблицаДляСчетовОбесценение = Новый ТаблицаЗначений;
		мКешТаблицаДляСчетовОбесценение.Колонки.Добавить("Строка");
		мКешТаблицаДляСчетовОбесценение.Колонки.Добавить("Счет");
	Иначе
		мКешТаблицаДляСчетовОбесценение = ПолучитьИзВременногоХранилища(Адрес_КешТаблицаДляСчетовОбесценение);
	КонецЕсли;
	
	Для Каждого стр_мТаблицаСчетов из мТаблицаСчетов Цикл
		стр_мКешТаблицаДляСчетовОбесценение = мКешТаблицаДляСчетовОбесценение.Добавить();
		стр_мКешТаблицаДляСчетовОбесценение.Строка = Лев(стр_мТаблицаСчетов.ИмяЯчейки, 3);
		стр_мКешТаблицаДляСчетовОбесценение.Счет = стр_мТаблицаСчетов.Счет; 
	КонецЦикла;
	
	Адрес_КешТаблицаДляСчетовОбесценение = ПоместитьВоВременноеХранилище(мКешТаблицаДляСчетовОбесценение, УникальныйИдентификатор);
	
КонецПроцедуры

// 49.1 
&НаСервере
Процедура ЗаполнитьРаздел_ПроцентныеДоходыСКСервер(ТекРаздел, ИмяРаздела)
	//#450528
	//Описание измененеий в задаче.
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	//мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	Запрос.Выполнить();
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;     
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	вэУправленческий.Счет.Код КАК Счет,
	|	вэУправленческий.КорСчет.Код КАК КорСчет,
	|	вэУправленческий.Субконто1.Код КАК ГФУ,
	|	ВЫБОР
	|		КОГДА вэУправленческий.Организация.ВалютаУчета = &ВалютаДокумента
	|			ТОГДА вэУправленческий.СуммаОборотДт
	|		ИНАЧЕ вэУправленческий.СуммаОборотДт * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
	|	КОНЕЦ КАК СуммаОборотДт,
	|	ВЫБОР
	|		КОГДА вэУправленческий.Организация.ВалютаУчета = &ВалютаДокумента
	|			ТОГДА вэУправленческий.СуммаОборотКт
	|		ИНАЧЕ вэУправленческий.СуммаОборотКт * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
	|	КОНЕЦ КАК СуммаОборотКт,
	|	вэУправленческий.Организация.ВалютаУчета КАК ВалютаУправленческогоУчета
	|ПОМЕСТИТЬ _Данные
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(&НачалоПериода, &грКонецПериода, , Счет В ИЕРАРХИИ (&СписокСчетов), &ВидыСубконто, СчетДоверительногоУправления = &СчетДоверительногоУправления, НЕ КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ)), ) КАК вэУправленческий
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
	|		ПО вэУправленческий.Организация.ВалютаУчета = КурсВалютыПроводки.Валюта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	вэУправленческий.Счет.Код,
	|	вэУправленческий.КорСчет.Код,
	|	вэУправленческий.Субконто1.Код,
	|	ВЫБОР
	|		КОГДА вэУправленческий.Организация.ВалютаУчета = &ВалютаДокумента
	|			ТОГДА вэУправленческий.СуммаОборотДт
	|		ИНАЧЕ вэУправленческий.СуммаОборотДт * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА вэУправленческий.Организация.ВалютаУчета = &ВалютаДокумента
	|			ТОГДА вэУправленческий.СуммаОборотКт
	|		ИНАЧЕ вэУправленческий.СуммаОборотКт * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
	|	КОНЕЦ,
	|	вэУправленческий.Организация.ВалютаУчета
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
	|			&НачалоПериода,
