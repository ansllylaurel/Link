// 49.1 
&НаСервере
Процедура РасчетРаздела_ПроцентныеДоходыСК2020(ТекРаздел, ИмяРаздела)

	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П0103", ТекРаздел, "П0203, П0303, П0403, П0503, П0603, П0703, П0803, П0903", 1);
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П0104", ТекРаздел, "П0204, П0304, П0404, П0504, П0604, П0704, П0804, П0904", 1);
	
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П1003", ТекРаздел, "П1103, П1203, П1303, П1403, П1503, П1603, П1703", 1);
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П1004", ТекРаздел, "П1104, П1204, П1304, П1404, П1504, П1604, П1704", 1);
	
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П1803", ТекРаздел, "П0103, П1003", 1);
	ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П1804", ТекРаздел, "П0104, П1004", 1);
	
	Если СтруктураРеквизитовФормы.НестандартныйПериод
		И СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета <> НачалоГода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета)
	Тогда
	
		КонсолидированнаяОтчетность.ОчиститьОбластьТабличногоДокумента(ТекРаздел, 1, 18, 4, 4);
		
	КонецЕсли;

КонецПроцедуры

// 50.1
&НаСервере
Процедура РасчетРаздела_ДоходыЗаВычетомРасходов2024(ТекРаздел, ИмяРаздела)
	
	Для НомКол = 2 По 4 Цикл
		
		СтрНомКол = Формат(НомКол, "ЧЦ=2; ЧВН=");
		
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П01" + СтрНомКол, ТекРаздел, СтрЗаменить("П02%1, П03%1, П04%1, П10%1, П11%1, П12%1", "%1", СтрНомКол), 1);
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П05" + СтрНомКол, ТекРаздел, СтрЗаменить("П06%1, П07%1", "%1", СтрНомКол), 1);
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П09" + СтрНомКол, ТекРаздел, СтрЗаменить("П01%1, П05%1", "%1", СтрНомКол), 1);
		
	КонецЦикла;
	
	Для НомСтр = 1 По 12 Цикл
		
		Если НомСтр = 8 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрНомСтр = Формат(НомСтр, "ЧЦ=2; ЧВН=");
		
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П" + СтрНомСтр + "05", ТекРаздел, СтрЗаменить("П%102, П%103, П%104", "%1", СтрНомСтр), 1);
		
