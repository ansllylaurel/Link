&НаКлиенте
Процедура скИзменитьСтруктуруОтчетаКлиент()
	
	скИзменитьСтруктуруОтчета();
	
КонецПроцедуры	

&НаСервере
Процедура скИзменитьСтруктуруОтчета()
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.Найти("ОсновнойНаборДанных") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,", 	"");
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "(ЛицевойСчет).* КАК ЛицевойСчет,", 	"");	
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, " ЛицевойСчет.*, ", "");
		

		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда		 		
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления,", 	"(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления, (ЛицевойСчет).* КАК ЛицевойСчет,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНаборДанных.Запрос, "СчетДоверительногоУправления.*,", 	"СчетДоверительногоУправления.*, ЛицевойСчет.*, ");		
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
	
	// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Основной") Тогда 
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Основной.ПустаяСсылка");
		КонецЕсли;
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
		
		МассивЭлементовКУдалению = Новый Массив;
		
		// Группировка
		Для Каждого ЭлементГруппировки Из Отчет.Группировка Цикл 			
			Если СтрЧислоВхождений(ЭлементГруппировки.Поле ,"ЛицевойСчет") > 0 Тогда 
				МассивЭлементовКУдалению.Добавить(ЭлементГруппировки);	
			КонецЕсли;			
		КонецЦикла;
		
		Для Каждого ЭлементГруппировкиУдаление Из МассивЭлементовКУдалению Цикл
			Отчет.Группировка.Удалить(ЭлементГруппировкиУдаление);
		КонецЦикла;
		
	Иначе
		Если ТипЗнч(Отчет.Счет) <> Тип("ПланСчетовСсылка.Единый") Тогда
			Отчет.Счет = ПредопределенноеЗначение("ПланСчетов.Единый.ПустаяСсылка");
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры		

