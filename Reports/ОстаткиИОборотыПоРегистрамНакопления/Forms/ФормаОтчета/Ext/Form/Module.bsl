&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Форма.Период = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		Форма.ВидПериода, Форма.НачалоПериода, Форма.КонецПериода);
		
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПереключитьТекущуюСтраницуВыбораПериода(Форма.ВидПериода, Элементы.ГруппаПоляВводаПериода);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, ВидРесурса)
	Поле = Схема.ПоляИтога.Добавить();
	Поле.Выражение = "Сумма("+РесурсРегистраНакопления.Имя + ВидРесурса + ")";
	Поле.ПутьКДанным = РесурсРегистраНакопления.Имя+ВидРесурса;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппировки(КомпоновщикНастроек)

	ЭтаФорма.ДополнительныеПоля.Очистить();
	ЭтаФорма.Группировки.Очистить();
	
	ЕстьВалюта = Ложь;
	
	Для каждого ПолеГрупировки Из ИсполняемыйКомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.Элементы Цикл
		
		Если ПолеГрупировки.Заголовок = "Валюта" Тогда
			ЕстьВалюта = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ПолеГрупировки.Заголовок = "Регистратор" Тогда
			Продолжить;
		КонецЕсли; 
		
		ЭтоРесурс = Найти(ПолеГрупировки.Заголовок, " Конечный остаток") + 
					Найти(ПолеГрупировки.Заголовок, " Начальный остаток") + 
					Найти(ПолеГрупировки.Заголовок, " Оборот") + 
					Найти(ПолеГрупировки.Заголовок, " Приход") + 
					Найти(ПолеГрупировки.Заголовок, " Расход"); 
					
		Если НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка()
			И ПолеГрупировки.Заголовок = "Счет доверительного управления" Тогда
				Продолжить;
		КонецЕсли;					
					
		Если ЭтоРесурс = 0 Тогда
			НоваяГруппировка 				= Этаформа.Группировки.Добавить();
			НоваяГруппировка.Использование 	= Истина;
			НоваяГруппировка.Поле 			= ПолеГрупировки.Поле;
			НоваяГруппировка.Представление 	= ПолеГрупировки.Заголовок;
			НоваяГруппировка.ТипГруппировки = "Без групп";
			//Если НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка()
			//		И ПолеГрупировки.Заголовок = "Счет доверительного управления" Тогда
			//	НоваяГруппировка.Использование = Ложь;
			//КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьВалюта Тогда
		НоваяГруппировка 				= Этаформа.Группировки.Добавить();
		НоваяГруппировка.Использование 	= Истина;
		НоваяГруппировка.Поле 			= "Валюта";
		НоваяГруппировка.Представление 	= "Валюта";
		НоваяГруппировка.ТипГруппировки = "Без групп";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляВГруппировку(НоваяГруппировка, Заголовок, Вид)

