&НаСервере
Процедура ПрименитьРучнуюНастройкуПолей()
	
	ИсполняемыйКомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	ЭлементыВыбораИсполняемогоКомпоновщика = ИсполняемыйКомпоновщикНастроек.Настройки.Выбор.Элементы;
	
 	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Нач.остаток", "НачальныйОстаток");
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Приход", "Приход");
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Расход", "Расход");
	ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, "Кон.остаток", "КонечныйОстаток");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыВыбора(ЭлементыВыбораИсполняемогоКомпоновщика, Заголовок, Вид)

	НоваяГруппа = ЭлементыВыбораИсполняемогоКомпоновщика.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	НоваяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;
	НоваяГруппа.Заголовок = Заголовок;
	
	ЗаполнитьСвойстваПолей(НоваяГруппа, КомпоновщикНастройкиПолей.Настройки.Выбор, Вид);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваПолей(ПриемникПолей, ИсточникПолей, Вид)

	Для каждого ЭлементВыбора Из ИсточникПолей.Элементы Цикл
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") И ЭлементВыбора.Заголовок = "Остаток" Тогда
			ВыбранноеПоле = ПриемникПолей;
		Иначе
			ВыбранноеПоле = ПриемникПолей.Элементы.Добавить(ТипЗнч(ЭлементВыбора));
			ЗаполнитьЗначенияСвойств(ВыбранноеПоле, ЭлементВыбора);
		КонецЕсли; 
		
		Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Строка(ЭлементВыбора.Поле) + Вид);
		ИначеЕсли ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			ЗаполнитьСвойстваПолей(ВыбранноеПоле, ЭлементВыбора, Вид);
		КонецЕсли; 
		
	КонецЦикла;	

КонецПроцедуры
 

&НаКлиенте
Процедура ПеренестиВВыбранныеПоля(Команда)
	
	ПрименитьРучнуюНастройкуПолей();

КонецПроцедуры

&НаСервере
Функция ДобавитьПолеНабораДанных(НаборДанных, Поле, Заголовок = "", ПутьКДанным = "")

	ПолеНабораДанных = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	      
	Если Не ЗначениеЗаполнено(ПутьКДанным) Тогда
		ПутьКДанным = Поле;
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = ПутьКДанным;
	КонецЕсли; 
	
	ПолеНабораДанных.Поле = Поле;
	ПолеНабораДанных.ПутьКДанным = ПутьКДанным;
	ПолеНабораДанных.Заголовок = Заголовок;
	
	Возврат ПолеНабораДанных;

КонецФункции

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НачалоПериода > КонецПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала периода не может быть больше даты конца периода!", , "НачалоПериода",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	
	Элементы.НастройкиИКомпоновщик.Видимость = Не Элементы.НастройкиИКомпоновщик.Видимость;
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ИзменитьЗаголовокКнопкиПанельНастроек(
		Элементы.ПанельНастроек, Элементы.НастройкиИКомпоновщик.Видимость);
	
КонецПроцедуры
