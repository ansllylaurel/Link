//Сохранение настроек
&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если Настройки.ДополнительныеСвойства.Свойство("ДанныеОтчета") Тогда
		ДополнительныеСвойства = Настройки.ДополнительныеСвойства.ДанныеОтчета.Получить();
		Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
			Если ЭлементСтруктуры.Ключ = "Периодичность" Тогда
				ЭтаФорма.Периодичность = ЭлементСтруктуры.Значение;
			ИначеЕсли ЭлементСтруктуры.Ключ = "МакетОформления" Тогда
				ЭтаФорма.МакетОформления = ЭлементСтруктуры.Значение;
			ИначеЕсли ЭлементСтруктуры.Ключ = "РазмещениеДополнительныхПолей" Тогда
				ЭтаФорма.РазмещениеДополнительныхПолей = ЭлементСтруктуры.Значение;
			ИначеЕсли ЭлементСтруктуры.Ключ = "Регистр" Тогда
				ЭтаФорма.Регистр = ЭлементСтруктуры.Значение;
			ИначеЕсли ЭлементСтруктуры.Ключ = "ДополнительныеПоля" Тогда
				ЭтаФорма.ДополнительныеПоля.Загрузить(ЭлементСтруктуры.Значение);
			ИначеЕсли ЭлементСтруктуры.Ключ = "Группировки" Тогда
				ЭтаФорма.Группировки.Загрузить(ЭлементСтруктуры.Значение);
			ИначеЕсли ЭлементСтруктуры.Ключ = "СчетДоверительногоУправления" Тогда
				ЭтаФорма.СчетДоверительногоУправления = ЭлементСтруктуры.Значение;
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьСхемуКомпоновкиДанных(Ложь);
		
		Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
			Если ЭлементСтруктуры.Ключ = "НастройкиКомпоновки" Тогда
				ЭтаФорма.ИсполняемыйКомпоновщикНастроек.ЗагрузитьНастройки(ЭлементСтруктуры.Значение);
			ИначеЕсли ЭлементСтруктуры.Ключ = "НастройкиПолей" Тогда
				ЭтаФорма.КомпоновщикНастройкиПолей.ЗагрузитьНастройки(ЭлементСтруктуры.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	ДополнительныеСвойства = Новый Структура;
	
	ДополнительныеСвойства.Вставить("Периодичность",					ЭтаФорма.Периодичность);
	ДополнительныеСвойства.Вставить("МакетОформления",					ЭтаФорма.МакетОформления);
	ДополнительныеСвойства.Вставить("РазмещениеДополнительныхПолей",	ЭтаФорма.РазмещениеДополнительныхПолей);
	ДополнительныеСвойства.Вставить("Регистр",							ЭтаФорма.Регистр);
	ДополнительныеСвойства.Вставить("СчетДоверительногоУправления",		ЭтаФорма.СчетДоверительногоУправления);
	ДополнительныеСвойства.Вставить("ДополнительныеПоля",				ЭтаФорма.ДополнительныеПоля.Выгрузить());
	ДополнительныеСвойства.Вставить("Группировки",						ЭтаФорма.Группировки.Выгрузить());
	
	ДополнительныеСвойства.Вставить("НастройкиКомпоновки",				ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки());
	ДополнительныеСвойства.Вставить("НастройкиПолей",					КомпоновщикНастройкиПолей.ПолучитьНастройки());
	
	Настройки.ДополнительныеСвойства.Вставить("ДанныеОтчета", Новый ХранилищеЗначения(ДополнительныеСвойства));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРодителей(ЭлементРасшифровки, ЗначениеРасшифровки, ЗапрещенныеПоля)
	
	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		//Если ЭлементРасшифровки.ОсновноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
			ЗначанияПолейРасшифровки = ЭлементРасшифровки.ПолучитьПоля();
			Если ЗапрещенныеПоля.Найти(ЗначанияПолейРасшифровки[0].Поле) = Неопределено Тогда
				СвойстваОтбора = Новый Структура;
				СвойстваОтбора.Вставить("ЛевоеЗначение", ЗначанияПолейРасшифровки[0].Поле);
				СвойстваОтбора.Вставить("ПравоеЗначение", ЗначанияПолейРасшифровки[0].Значение);
				СвойстваОтбора.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.Равно);
				СвойстваОтбора.Вставить("Использование", Истина);
				ЗначениеРасшифровки.Вставить(СтрЗаменить(ЗначанияПолейРасшифровки[0].Поле, ".", ""), СвойстваОтбора);
			КонецЕсли;
		//КонецЕсли;
	КонецЕсли;
	
	Для каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ДобавитьРодителей(Родитель, ЗначениеРасшифровки, ЗапрещенныеПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВернутьЗначениеРасшифровки(Расшифровка, ЗапрещенныеПоля)
	
	ДанныеРасшифровкиОбъект = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки);
	
	ЗначанияПолейРасшифровки = ДанныеРасшифровкиОбъект.Элементы[Расшифровка].ПолучитьПоля();
	Если ЗначанияПолейРасшифровки.Количество() > 1 Тогда
	     Индекс = 1;
	Иначе
	     Индекс = 0;
	 КонецЕсли; 
	 
	ЗначениеРасшифровки = ЗначанияПолейРасшифровки[Индекс].Значение;
	
	Если ЗначениеРасшифровки = NULL Тогда
		ЗначениеРасшифровки = Новый Структура;
		ДобавитьРодителей(ДанныеРасшифровкиОбъект.Элементы[Расшифровка], ЗначениеРасшифровки, ЗапрещенныеПоля);
	КонецЕсли;
	
	Возврат ЗначениеРасшифровки;
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапрещенныеПоля = ПолучитьЗапрещенныеПоля("Группировка");
	
	ЗначениеРасшифровки = ВернутьЗначениеРасшифровки(Расшифровка, ЗапрещенныеПоля);
	
	Если ТипЗнч(ЗначениеРасшифровки) = Тип("Структура") Тогда
		
		Для каждого ТекущийОтбор Из ЭтаФорма.ИсполняемыйКомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			Если ТекущийОтбор.Использование Тогда
				ИмяОтбора = СтрЗаменить(Строка(ТекущийОтбор.ЛевоеЗначение), ".", "");
				Если НЕ ЗначениеРасшифровки.Свойство(ИмяОтбора) Тогда
					СвойстваОтбора = Новый Структура("ВидСравнения, ПравоеЗначение, Использование");
					СвойстваОтбора.Вставить("ЛевоеЗначение", Строка(ТекущийОтбор.ЛевоеЗначение));
					ЗаполнитьЗначенияСвойств(СвойстваОтбора, ТекущийОтбор, "ВидСравнения, ПравоеЗначение, Использование");
					ЗначениеРасшифровки.Вставить(ИмяОтбора, СвойстваОтбора);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		НачалоПериодаДляРасшифровки = ЭтаФорма.НачалоПериода;
		КонецПериодаДляРасшифровки = ЭтаФорма.КонецПериода;
		
		Если ЗначениеРасшифровки.Свойство("Период") Тогда
			
			Если ЭтаФорма.Периодичность = "Период" Тогда
				// ничего не делаем, пусть период остается тем же
			ИначеЕсли ЭтаФорма.Периодичность = "Регистратор" Тогда
				// ничего не делаем, пусть регистратор уйдет в отбор
			ИначеЕсли ЭтаФорма.Периодичность = "День" Тогда
				НачалоПериодаДляРасшифровки = ЗначениеРасшифровки.Период.ПравоеЗначение;
				КонецПериодаДляРасшифровки = НачалоПериодаДляРасшифровки;
			ИначеЕсли ЭтаФорма.Периодичность = "Месяц" Тогда
				НачалоПериодаДляРасшифровки = ЗначениеРасшифровки.Период.ПравоеЗначение;
				КонецПериодаДляРасшифровки = ДобавитьМесяц(НачалоПериодаДляРасшифровки, 1) - 24 * 60 * 60;
			ИначеЕсли ЭтаФорма.Периодичность = "Квартал" Тогда
				НачалоПериодаДляРасшифровки = ЗначениеРасшифровки.Период.ПравоеЗначение;
				КонецПериодаДляРасшифровки = ДобавитьМесяц(НачалоПериодаДляРасшифровки, 3) - 24 * 60 * 60;
			ИначеЕсли ЭтаФорма.Периодичность = "Год" Тогда
				НачалоПериодаДляРасшифровки = ЗначениеРасшифровки.Период.ПравоеЗначение;
				КонецПериодаДляРасшифровки = ДобавитьМесяц(НачалоПериодаДляРасшифровки, 12) - 24 * 60 * 60;
			КонецЕсли;
			
			ЗначениеРасшифровки.Удалить("Период");
			
		ИначеЕсли ЗначениеРасшифровки.Свойство("ПериодСекунда") Тогда
			
			НачалоПериодаДляРасшифровки = ЗначениеРасшифровки.ПериодСекунда.ПравоеЗначение;
			КонецПериодаДляРасшифровки = НачалоПериодаДляРасшифровки;
			
			ЗначениеРасшифровки.Удалить("ПериодСекунда");
			
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода, Регистр, Отбор, Расшифровка", НачалоПериодаДляРасшифровки, КонецПериодаДляРасшифровки, ЭтаФорма.Регистр, ЗначениеРасшифровки, Истина);
		
		ПараметрыФормы.Вставить("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
		
		ОткрытьФорму("Отчет.ДвиженияПоРегистрамНакопления.Форма", ПараметрыФормы, , Новый УникальныйИдентификатор);
	Иначе
		ОткрытьЗначение(ЗначениеРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

