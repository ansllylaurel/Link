		Если ЕстьКоличество Тогда
		
			НоваяГруппа = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
			НоваяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;
			НоваяГруппа.Заголовок = Заголовок;
			
			НоваяГруппаКолво = НоваяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
			НоваяГруппаКолво.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
			НоваяГруппаКолво.Заголовок = " ";
			
			НоваяГруппаСуммы = НоваяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
			НоваяГруппаСуммы.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
			НоваяГруппаСуммы.Заголовок = "  ";
			
			Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
				Если РесурсРегистраНакопления.Имя = "Количество" Тогда
					ВыбранноеПоле = НоваяГруппаКолво.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				Иначе	
					ВыбранноеПоле = НоваяГруппаСуммы.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				КонецЕсли;
				ВыбранноеПоле.Заголовок = РесурсРегистраНакопления.Синоним;
				ВыбранноеПоле.Использование = Истина;
				ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(РесурсРегистраНакопления.Имя+Вид);
			КонецЦикла;
		Иначе	
			НоваяГруппа = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
			НоваяГруппа.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;
			НоваяГруппа.Заголовок = Заголовок;
			Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
				ВыбранноеПоле = НоваяГруппа.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ВыбранноеПоле.Заголовок = РесурсРегистраНакопления.Синоним;
				ВыбранноеПоле.Использование = Истина;
				ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(РесурсРегистраНакопления.Имя+Вид);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппировку(НоваяГруппировка, ТекущаяГруппировка, ОборотныйРегистр, ТипГруппировки = "")

	ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Использование = Истина;
	//Если ТекущаяГруппировка = "Валюта" Тогда
	//	ПолеГруппировки.Использование = Ложь;
	//КонецЕсли;
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ТекущаяГруппировка);
	Если ТипГруппировки = "С группами" Тогда
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
	ИначеЕсли ТипГруппировки = "Только группы" Тогда
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
	Иначе
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	КонецЕсли;
	
	АвтоПоле = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоПоле.Использование = Истина;
	
	ПолеПорядка = НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядка.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Функция ВернутьПоляПоРегистру(Регистр, ОборотныйРегистр, ЕстьСчетДУ, ИмяТаблицы, Цель)

	Поля = "";
	
	Если Этаформа.Периодичность = "Период" Тогда
		//ничего
	ИначеЕсли Этаформа.Периодичность = "Регистратор" Тогда
		Поля = Поля + "Регистратор" + ?(Цель <> "ЗАПРОС" И Цель <> "СКД_СГРУППИРОВАТЬ", ".*", "") +  ",";
		Поля = Поля + "ПериодСекунда" + ",";
	Иначе
		
		Если Цель = "ЗАПРОС" Тогда
			Поля = Поля + ИмяТаблицы + ".Период" + " КАК Период,";
		ИначеЕсли Цель = "СКД_ВЫБРАТЬ" Тогда
			Поля = Поля + "Период.*,";
		ИначеЕсли Цель = "СКД_ГДЕ" Тогда
			Поля = Поля + ИмяТаблицы + ".Период.*,";
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого ИзмерениеРегистраНакопления Из Метаданные.РегистрыНакопления[Регистр].Измерения Цикл
		Если ИзмерениеРегистраНакопления.Имя = "Организация" ИЛИ ИзмерениеРегистраНакопления.Имя = "Клиент" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Цель = "ЗАПРОС" Тогда
			
			Поля = Поля + ИмяТаблицы + "." + ИзмерениеРегистраНакопления.Имя + " КАК " + ИзмерениеРегистраНакопления.Имя + ",";
			
		ИначеЕсли Цель = "СКД_ВЫБРАТЬ" Тогда
			
			Поля = Поля + ИзмерениеРегистраНакопления.Имя + ".*,";
			
		ИначеЕсли Цель = "СКД_ГДЕ" Тогда
			
			Поля = Поля + ИмяТаблицы + "." + ИзмерениеРегистраНакопления.Имя + ".*,";
			
		ИначеЕсли Цель = "СКД_СГРУППИРОВАТЬ" Тогда
			
			Поля = Поля + ИмяТаблицы + "." + ИзмерениеРегистраНакопления.Имя + ",";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Цель <> "СКД_СГРУППИРОВАТЬ" Тогда
		
		Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Регистр].Ресурсы Цикл
			
			Если Этаформа.Периодичность = "Регистратор" Тогда
				АгрегацияНачало	= ?(Цель = "СКД_ГДЕ" ИЛИ Цель = "СКД_ВЫБРАТЬ", "", "СУММА(");
				АгегацияКонец	= ?(Цель = "СКД_ГДЕ" ИЛИ Цель = "СКД_ВЫБРАТЬ", "", ")");
			Иначе
				АгрегацияНачало	= "";
				АгегацияКонец	= "";
			КонецЕсли;
			
			Если ОборотныйРегистр Тогда
				Поля = Поля + АгрегацияНачало + РесурсРегистраНакопления.Имя + "Оборот" + АгегацияКонец + ",";
			Иначе
				Поля = Поля + АгрегацияНачало + РесурсРегистраНакопления.Имя + "НачальныйОстаток" + АгегацияКонец + ",";
				Поля = Поля + АгрегацияНачало + РесурсРегистраНакопления.Имя + "Приход" + АгегацияКонец + ",";
				Поля = Поля + АгрегацияНачало + РесурсРегистраНакопления.Имя + "Расход" + АгегацияКонец + ",";
				Поля = Поля + АгрегацияНачало + РесурсРегистраНакопления.Имя + "КонечныйОстаток" + АгегацияКонец + ",";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьСчетДУ Тогда
		
		Если Цель = "ЗАПРОС" Тогда
			
			Поля = Поля + "КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент, СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия,";
			
		ИначеЕсли Цель = "СКД_ВЫБРАТЬ" Тогда
			
			Поля = Поля + "Клиент.*, Стратегия.*,"	
			
		ИначеЕсли Цель = "СКД_ГДЕ" Тогда
			
			Поля = Поля + "КлиентыДоверительногоУправленияСрезПоследних.Клиент.*, СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.*,";
			
		ИначеЕсли Цель = "СКД_СГРУППИРОВАТЬ" Тогда
			
			Поля = Поля + "КлиентыДоверительногоУправленияСрезПоследних.Клиент, СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия,";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Регистр = "БухПартииЦенныхБумаг" Тогда
		
		Если Цель = "ЗАПРОС" Тогда
		
			Поля = Поля + "
			|	ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.Сделка)
			|		ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.Сделка).НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|		ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ВводЦенныхБумаг)
			|		ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|		ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
			|	ИНАЧЕ """"
			|	КОНЕЦ КАК НомерСделки,";
		
		ИначеЕсли Цель = "СКД_ВЫБРАТЬ" Тогда
			
			Поля = Поля + "НомерСделки,"	
			
		ИначеЕсли Цель = "СКД_ГДЕ" Тогда
			
			Поля = Поля + "
			|	(ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.Сделка)
			|		ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.Сделка).НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|		ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ВводЦенныхБумаг)
			|		ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
			|	КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|		ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
			|	ИНАЧЕ """"
			|	КОНЕЦ) КАК НомерСделки,";
			
		ИначеЕсли Цель = "СКД_СГРУППИРОВАТЬ" Тогда
			
			Поля = Поля + "ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.Сделка)
			|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.Сделка).НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.ВводЦенныхБумаг)
			|			ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиИОбороты.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|			ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
			|		ИНАЧЕ """"
			|	КОНЕЦ,";
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Лев(Поля, СтрДлина(Поля) - 1);
	
КонецФункции

&НаСервере
Процедура ДобавитьОформляемоеПоле(КоллекцияПолей, ИмяПоля)

	ПолеОформления = КоллекцияПолей.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура ИзменитьСхемуКомпоновкиДанных(ПерезаполнитьГруппировки, ПерезаполнятьНастройкуПолей = Истина)
	
	ОборотныйРегистр = (Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].ВидРегистра =  Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
	
	УсловиеСчетДУ = "";
	ЕстьСчетДУ = Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].Измерения.Найти("СчетДоверительногоУправления") <> Неопределено;
	Если ЕстьСчетДУ	и НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		УсловиеСчетДУ = " И СчетДоверительногоУправления = &СчетДоверительногоУправления";
	ИначеЕсли НЕ ЕстьСчетДУ Тогда
		СчетДоверительногоУправления = Неопределено;
	КонецЕсли;
	
	Элементы.СчетДоверительногоУправления.Доступность = ЕстьСчетДУ;
	
	Схема = Новый СхемаКомпоновкиДанных;
    
    //1.1 определяем источник данных для схемы 
    Источник = Схема.ИсточникиДанных.Добавить();
    Источник.Имя = "ЛокальнаяБаза";
    Источник.СтрокаСоединения = "";
    Источник.ТипИсточникаДанных = "Local";
    
    //1.2 определяем набор данных 
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
    НаборДанных.Имя = "Продажи";
    НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
    НаборДанных.АвтоЗаполнениеДоступныхПолей = Ложь;
    //НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	ИмяРегистраЗапрос = "РегистрНакопления." + Этаформа.Регистр + "." + ?(ОборотныйРегистр, "", "ОстаткиИ") + "Обороты";
	ИмяТаблицы = Этаформа.Регистр + ?(ОборотныйРегистр, "", "ОстаткиИ") + "Обороты";
	
	ПоляРегистра_Запрос				= ВернутьПоляПоРегистру(ЭтаФорма.Регистр, ОборотныйРегистр, ЕстьСчетДУ, ИмяТаблицы, "ЗАПРОС");
	ПоляРегистра_СКД_Выбрать		= ВернутьПоляПоРегистру(ЭтаФорма.Регистр, ОборотныйРегистр, ЕстьСчетДУ, ИмяТаблицы, "СКД_ВЫБРАТЬ");
	ПоляРегистра_СКД_ГДЕ			= ВернутьПоляПоРегистру(ЭтаФорма.Регистр, ОборотныйРегистр, ЕстьСчетДУ, ИмяТаблицы, "СКД_ГДЕ");
	ПоляРегистра_СКД_Сгруппировать	= ВернутьПоляПоРегистру(ЭтаФорма.Регистр, ОборотныйРегистр, ЕстьСчетДУ, ИмяТаблицы, "СКД_СГРУППИРОВАТЬ");
	
    НаборДанных.Запрос = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ " + ПоляРегистра_Запрос + "{ВЫБРАТЬ " + ПоляРегистра_СКД_Выбрать + "} " + 
			"ИЗ " + ИмяРегистраЗапрос + 
				"(&НачалоПериода, &КонецПериода, "+?(ЭтаФорма.Периодичность = "Регистратор", "Авто", ЭтаФорма.Периодичность)+", " + 
					?(ОборотныйРегистр, "", ",") + " Организация = &Организация" + УсловиеСчетДУ + ") КАК " + ИмяТаблицы + " " +
			?(ЕстьСчетДУ, "ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних " + 
				"ПО " + ИмяТаблицы + ".СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления " +
				"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних " +
				"ПО " + ИмяТаблицы + ".СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления ", "") +
			?(Этаформа.Регистр = "БухПартииЦенныхБумаг", " ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги " + 
				"ПО " + ИмяТаблицы + ".Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка И " + ИмяТаблицы + ".СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии" , "") +
			?(Этаформа.Регистр = "БухПартииЦенныхБумаг", " ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии " + 
				"ПО " + ИмяТаблицы + ".Партия = РеклассификацияАктивовЕПСПартии.Ссылка И " + ИмяТаблицы + ".СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки" , "") +
			"{ГДЕ " + ПоляРегистра_СКД_ГДЕ + "}" + 
			?(Этаформа.Периодичность = "Регистратор", "СГРУППИРОВАТЬ ПО " + ПоляРегистра_СКД_Сгруппировать, "");
			
	Если ЭтаФорма.Периодичность = "Регистратор" Тогда
		
		Поле = ДобавитьПолеНабораДанных(НаборДанных, "НомерСтроки", "Номер строки");
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.Роль.НомерПериода = 1;
		
		Поле = ДобавитьПолеНабораДанных(НаборДанных, "Регистратор");
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		
		Поле.Роль.НомерПериода = 2;
		
		Поле = ДобавитьПолеНабораДанных(НаборДанных, "ПериодСекунда", "Период (секунда)");
		Поле.ОграничениеИспользования.Группировка = Истина;
		Поле.Роль.НомерПериода = 3;
		
	КонецЕсли; 
			
    //1.3 определяем ресурсы 
	Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
		Если ОборотныйРегистр Тогда
			ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "Оборот");
		Иначе
			
			ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "НачальныйОстаток");
			ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "Приход");
			ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "Расход");
			ДобавитьПолеРесурса(Схема, РесурсРегистраНакопления, "КонечныйОстаток");
			
			Поле = ДобавитьПолеНабораДанных(НаборДанных, РесурсРегистраНакопления.Имя + "НачальныйОстаток", РесурсРегистраНакопления.Синоним + " Начальный остаток");
			Поле.Роль.ТипОстатка = ТипОстаткаКомпоновкиДанных.НачальныйОстаток;
			Поле.Роль.ГруппаОстатка = РесурсРегистраНакопления.Имя;
			Поле.Роль.Остаток = Истина;
			Поле.ОграничениеИспользования.Группировка = Истина;

			Поле = ДобавитьПолеНабораДанных(НаборДанных, РесурсРегистраНакопления.Имя + "Приход", РесурсРегистраНакопления.Синоним + " Приход");
			Поле.ОграничениеИспользования.Группировка = Истина;
			
			Поле = ДобавитьПолеНабораДанных(НаборДанных, РесурсРегистраНакопления.Имя + "Расход", РесурсРегистраНакопления.Синоним + " Расход");
			Поле.ОграничениеИспользования.Группировка = Истина;
			
			Поле = ДобавитьПолеНабораДанных(НаборДанных, РесурсРегистраНакопления.Имя + "КонечныйОстаток", РесурсРегистраНакопления.Синоним + " Конечный остаток");
			Поле.Роль.ТипОстатка = ТипОстаткаКомпоновкиДанных.КонечныйОстаток;
			Поле.Роль.ГруппаОстатка = РесурсРегистраНакопления.Имя;
			Поле.Роль.Остаток = Истина;
			Поле.ОграничениеИспользования.Группировка = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	ОтборПользователя = ИсполняемыйКомпоновщикНастроек.Настройки.Отбор;
	
    //2. создаем настройки для схемы 
    НастройкиКомпоновкиДанных = Схема.НастройкиПоУмолчанию;
	НастройкиКомпоновкиДанных.Структура.Очистить();
	
    //2.1 определяем структуру
	ЕстьВалюта = Ложь;
	НоваяГруппировка = НастройкиКомпоновкиДанных;
	
	Если ОборотныйРегистр Тогда
		ДобавитьПоляВГруппировку(НоваяГруппировка, "Оборот", "Оборот");
	Иначе
		ДобавитьПоляВГруппировку(НоваяГруппировка, "Нач.остаток", "НачальныйОстаток");
		ДобавитьПоляВГруппировку(НоваяГруппировка, "Приход", "Приход");
		ДобавитьПоляВГруппировку(НоваяГруппировка, "Расход", "Расход");
		ДобавитьПоляВГруппировку(НоваяГруппировка, "Кон.остаток", "КонечныйОстаток");
	КонецЕсли;
	
	Элементы.НастройкаПолей.Видимость = Не ОборотныйРегистр;
	Если Не ОборотныйРегистр и ПерезаполнятьНастройкуПолей Тогда
		
		СхемаНастройкиПолей = Новый СхемаКомпоновкиДанных;
    
	    ЗаполнитьЗначенияСвойств(СхемаНастройкиПолей.ИсточникиДанных.Добавить(), Источник);
		НаборДанныхНастройкиПолей = СхемаНастройкиПолей.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанныхНастройкиПолей.Имя = "Продажи";
		НаборДанныхНастройкиПолей.ИмяОбъекта = "Продажи";
	    НаборДанныхНастройкиПолей.ИсточникДанных = "ЛокальнаяБаза";
		
		Для каждого РесурсРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Ресурсы Цикл
			Поле = НаборДанныхНастройкиПолей.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.Поле = РесурсРегистраНакопления.Имя;
			Поле.ПутьКДанным = РесурсРегистраНакопления.Имя;
			Поле.Заголовок = РесурсРегистраНакопления.Имя;
			Поле.ТипЗначения = РесурсРегистраНакопления.Тип;
			ДобавитьПолеРесурса(СхемаНастройкиПолей, РесурсРегистраНакопления, "Остаток");
		КонецЦикла;
		
		НастройкиПолей = СхемаНастройкиПолей.НастройкиПоУмолчанию;
		ДобавитьПоляВГруппировку(НастройкиПолей, "Остаток", "");
		
		АдресСхемыНастройкиПолей = ПоместитьВоВременноеХранилище(СхемаНастройкиПолей, ?(АдресСхемыНастройкиПолей <> "", АдресСхемыНастройкиПолей, УникальныйИдентификатор));
		КомпоновщикНастройкиПолей.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыНастройкиПолей));
		КомпоновщикНастройкиПолей.ЗагрузитьНастройки(НастройкиПолей);
	
	КонецЕсли; 
	
	Для каждого ИзмерениеРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Измерения Цикл
		Если ИзмерениеРегистраНакопления.Имя = "Организация" ИЛИ ИзмерениеРегистраНакопления.Имя = "Клиент" Тогда
			Продолжить;
		ИначеЕсли ИзмерениеРегистраНакопления.Имя = "Валюта" Тогда
			ЕстьВалюта = Истина;
			Продолжить;
		ИначеЕсли ИзмерениеРегистраНакопления.Имя = "СчетДоверительногоУправления"
			И НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
				Продолжить;
		КонецЕсли;
		
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, ИзмерениеРегистраНакопления.Имя, ОборотныйРегистр);
	КонецЦикла;
	Если ЕстьВалюта Тогда
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, "Валюта", ОборотныйРегистр);
	КонецЕсли;
	
	Если Этаформа.Периодичность = "Период" Тогда
		//ничего
	ИначеЕсли Этаформа.Периодичность = "Регистратор" Тогда
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, "Регистратор", ОборотныйРегистр);
	Иначе
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, "Период", ОборотныйРегистр);
	КонецЕсли;
	
	//Оформление
	Если ЭтаФорма.Регистр = "БухПартииЦенныхБумаг" Тогда
		
		ЭлементОформления = НастройкиКомпоновкиДанных.УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ЗначениеОформления = ЭлементОформления.Оформление.Элементы[5]; //шрифт
		ЗначениеОформления.Значение = Новый Шрифт("",8,Истина,Неопределено,Неопределено,Неопределено);
		ЗначениеОформления.Использование = Истина;
		
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "КоличествоНачальныйОстаток");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "КоличествоПриход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "КоличествоРасход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "КоличествоКонечныйОстаток");
	
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьНачальныйОстаток");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьПриход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьРасход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьКонечныйОстаток");
	
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьКупонаНачальныйОстаток");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьКупонаПриход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьКупонаРасход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "СтоимостьКупонаКонечныйОстаток");
		
		
		ЭлементОформления = НастройкиКомпоновкиДанных.УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ЗначениеОформления = ЭлементОформления.Оформление.Элементы[1]; //цвет текста
		ЗначениеОформления.Значение = Новый Цвет(0, 0, 255); // синий
		ЗначениеОформления.Использование = Истина;
		
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаНачальныйОстаток");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаПриход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаРасход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаКонечныйОстаток");
	
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаКупонаНачальныйОстаток");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаКупонаПриход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаКупонаРасход");
		ДобавитьОформляемоеПоле(ЭлементОформления.Поля.Элементы, "ПереоценкаКупонаКонечныйОстаток");
		
	Иначе
		
		НастройкиКомпоновкиДанных.УсловноеОформление.Элементы.Очистить();
		
	КонецЕсли;
	
	АдресСхемыИсполненногоОтчета = ПоместитьВоВременноеХранилище(Схема, ?(АдресСхемыИсполненногоОтчета <> "", АдресСхемыИсполненногоОтчета, УникальныйИдентификатор));
	
	ИсполняемыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыИсполненногоОтчета));
	ИсполняемыйКомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	Если ПерезаполнитьГруппировки Тогда
		ЗаполнитьГруппировки(ИсполняемыйКомпоновщикНастроек);
	КонецЕсли;
	
	Для каждого ИзмерениеРегистраНакопления Из Метаданные.РегистрыНакопления[Этаформа.Регистр].Измерения Цикл
		
		Поле = ДобавитьПолеНабораДанных(НаборДанных, ИзмерениеРегистраНакопления.Имя, ИзмерениеРегистраНакопления.Синоним);
		Поле.Роль.Измерение = Истина;
		
		Если (ИзмерениеРегистраНакопления.Имя = "Организация" ИЛИ ИзмерениеРегистраНакопления.Имя = "Клиент") Тогда
			Продолжить;
		ИначеЕсли ИзмерениеРегистраНакопления.Имя = "СчетДоверительногоУправления"
			И НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементОтбора = ИсполняемыйКомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = ИсполняемыйКомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(ИзмерениеРегистраНакопления.Имя)).Поле;
		ЭлементОтбора.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование = Ложь;
		
	КонецЦикла;
	
	//восстановление пользовательских отборов
	Для Каждого ЭлементОтбора Из ИсполняемыйКомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Для Каждого ЭлементОтбораПользователя Из ОтборПользователя.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ЭлементОтбораПользователя.ЛевоеЗначение Тогда
				ЗаполнитьЗначенияСвойств(ЭлементОтбора, ЭлементОтбораПользователя, "ВидСравнения,Использование,ПравоеЗначение");
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	// #501219 - убираем из доступных полей параметры СКД, т.к. использование в глобальном отборе параметра может вызвать ошибку.
	РаботаСОтчетами.ОбработатьПараметрыСхемыКомпоновкиИДобавитьПараметрыИзКомпоновщика(Схема, ИсполняемыйКомпоновщикНастроек);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, Параметр, Значение, СхемаКомпоновкиДанных)

	ЗначениеПараметра = ИсполняемыйКомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(Параметр); 
	
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Использование = Истина; 
		ЗначениеПараметра.Значение = Значение;
	КонецЕсли;
	
	//НовыйПараметр = СхемаКомпоновкиДанных.НастройкиПоУмолчанию.ПараметрыДанных.Элементы.Добавить();
	//НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(Параметр);
	//НовыйПараметр.Значение = Значение;
	//НовыйПараметр.Использование = Истина;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, Параметр, Значение)

	ЗначениеПараметра = ИсполняемыйКомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы.Найти(Параметр); 
	ЗначениеПараметра.Использование = Истина; 
	ЗначениеПараметра.Значение = Значение;

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	Перем ДанныеРасшифровкиОбъект;
	
	Механизм = "Отчет.ОстаткиИОборотыПоРегистрамНакопления.Форма.СформироватьНаСервере()";
	ДопПараметрыВыполнения = Новый Структура("Период,Организация,СчетДоверительногоУправления,Регистр");
	ЗаполнитьЗначенияСвойств(ДопПараметрыВыполнения, ЭтаФорма);

	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(РеквизитФормыВЗначение("Отчет"),, ДопПараметрыВыполнения);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ОборотныйРегистр = (Метаданные.РегистрыНакопления[ЭтаФорма.Регистр].ВидРегистра =  Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСхемыИсполненногоОтчета);
	
	//УстановитьПараметрСхемы(СхемаКомпоновкиДанных, "НачалоПериода", НачалоДня(ЭтаФорма.НачалоПериода));
	//УстановитьПараметрСхемы(СхемаКомпоновкиДанных, "КонецПериода", КонецДня(ЭтаФорма.КонецПериода));
	//УстановитьПараметрСхемы(СхемаКомпоновкиДанных, "Организация", ЭтаФорма.Организация);
	
    //2.1 определяем структуру 
	ИсполняемыйКомпоновщикНастроек.Настройки.Структура.Очистить();
	
	НоваяГруппировка = ИсполняемыйКомпоновщикНастроек.Настройки;
	Для каждого ТекущаяГруппировка Из ЭтаФорма.Группировки Цикл
		Если НЕ ТекущаяГруппировка.Использование Тогда
			Продолжить;
		КонецЕсли;
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, ТекущаяГруппировка.Поле, ОборотныйРегистр, ТекущаяГруппировка.ТипГруппировки);
	КонецЦикла;
	
	Если Этаформа.Периодичность = "Период" Тогда
		//ничего
	ИначеЕсли Этаформа.Периодичность = "Регистратор" Тогда
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, "Регистратор", ОборотныйРегистр);
	Иначе
		НоваяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ЗаполнитьГруппировку(НоваяГруппировка, "Период", ОборотныйРегистр);
	КонецЕсли;
	
	//4. Параметры
	ПараметрНачалоПериода	= НачалоДня(ЭтаФорма.НачалоПериода);
	ПараметрКонецПериода	= ?(ЗначениеЗаполнено(ЭтаФорма.КонецПериода), КонецДня(ЭтаФорма.КонецПериода), ЭтаФорма.КонецПериода);
	
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "НачалоПериода", ПараметрНачалоПериода, СхемаКомпоновкиДанных);
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "КонецПериода", ПараметрКонецПериода, СхемаКомпоновкиДанных);
	УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "Организация", ЭтаФорма.Организация, СхемаКомпоновкиДанных);
	Если НЕ ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		УстановитьПараметр(ИсполняемыйКомпоновщикНастроек, "СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления, СхемаКомпоновкиДанных);
	КонецЕсли;
	
	ДругиеНастройки = ИсполняемыйКомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы;
	
	ВыводитьЗаголовок = ДругиеНастройки.Найти("ВыводитьЗаголовок");
    ВыводитьЗаголовок.Использование = Истина;
    ВыводитьЗаголовок.Значение = ТипВыводаТекстаКомпоновкиДанных.Выводить;
	
	ВыводитьЗаголовок = ДругиеНастройки.Найти("Заголовок");
    ВыводитьЗаголовок.Использование = Истина;
    ВыводитьЗаголовок.Значение = "Остатки и обороты по """ + Метаданные.РегистрыНакопления[Этаформа.Регистр].Синоним + """" + Символы.ПС +
		"за " + ПредставлениеПериода(ПараметрНачалоПериода, ПараметрКонецПериода) + " " + Этаформа.Организация;
		
	//ВыводитьПараметры = ДругиеНастройки.Найти("ВыводитьПараметрыДанных");
	//ВыводитьПараметры.Использование = Истина;
	//ВыводитьПараметры.Значение = ТипВыводаТекстаКомпоновкиДанных.Выводить;
	
	Если ЭтаФорма.СчетДоверительногоУправления <> Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		
		ПримернаяДлинаСтрокиЗаголовка = 50;
		СчетДУСтрокой = Строка(ЭтаФорма.СчетДоверительногоУправления);
		Если СтрДлина(СчетДУСтрокой) < ПримернаяДлинаСтрокиЗаголовка Тогда
			ВыводитьЗаголовок.Значение = ВыводитьЗаголовок.Значение + Символы.ПС + "Счет д/у: " + ЭтаФорма.СчетДоверительногоУправления;
		Иначе
			
			ЗаголовокСчетДУ = "";
			ТекущаяСтрокаЗаголовка = "Счет д/у: ";
			СчетДУПодстроки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СчетДУСтрокой, " ",, Истина);
			
			Для каждого СчетДУПодстрока Из СчетДУПодстроки Цикл
			
				Если СтрДлина(ТекущаяСтрокаЗаголовка) + СтрДлина(СчетДУПодстрока) > ПримернаяДлинаСтрокиЗаголовка Тогда
					
					ЗаголовокСчетДУ = ЗаголовокСчетДУ + ТекущаяСтрокаЗаголовка + Символы.ПС;
					ТекущаяСтрокаЗаголовка = "";
					
				КонецЕсли;
				
				ТекущаяСтрокаЗаголовка = ТекущаяСтрокаЗаголовка + " " + СчетДУПодстрока;
			
			КонецЦикла;
			
			ЗаголовокСчетДУ = ЗаголовокСчетДУ + ТекущаяСтрокаЗаголовка + Символы.ПС;
			
			ВыводитьЗаголовок.Значение = ВыводитьЗаголовок.Значение + Символы.ПС + ЗаголовокСчетДУ;
			
		КонецЕсли;
		
	КонецЕсли;
		
		
	//ВыводитьПараметрыДанных = ДругиеНастройки.Найти("ВыводитьПараметрыДанных");
	//ВыводитьПараметрыДанных.Использование = Истина;
	//ВыводитьПараметрыДанных.Значение = ТипВыводаТекстаКомпоновкиДанных.Выводить;
	
	ВыводитьОтбор = ДругиеНастройки.Найти("ВыводитьОтбор");
    ВыводитьОтбор.Использование = Истина;
    ВыводитьОтбор.Значение = ТипВыводаТекстаКомпоновкиДанных.Выводить;
	
	Если НЕ ЭтаФорма.МакетОформления = "" Тогда
		УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, "МакетОформления", ЭтаФорма.МакетОформления);
	КонецЕсли;
	
	Если НЕ ОборотныйРегистр Тогда
	
		ПрименитьРучнуюНастройкуПолей();
	
	КонецЕсли; 
	
	Если ЭтаФорма.РазмещениеДополнительныхПолей = "В одной колонке" Тогда
		УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, "РасположениеРеквизитов", РасположениеРеквизитовКомпоновкиДанных.ВместеСВладельцем);
	ИначеЕсли ЭтаФорма.РазмещениеДополнительныхПолей = "В отдельных колонках" Тогда
		УстановитьПараметрВывода(ИсполняемыйКомпоновщикНастроек, "РасположениеРеквизитов", РасположениеРеквизитовКомпоновкиДанных.Отдельно);
	КонецЕсли;
	
	Для каждого ДополнительноеПоле Из ДополнительныеПоля Цикл
		ВыбранныеПоля = ИсполняемыйКомпоновщикНастроек.Настройки.Выбор;
		Поле = Новый ПолеКомпоновкиДанных(ДополнительноеПоле.Поле);
		ВыбранноеПоле = ВыбранныеПоля.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Поле;
		ВыбранноеПоле.Заголовок = ДополнительноеПоле.Представление;
	КонецЦикла;
	
	//"РасположениеРеквизитов"
	
    //3. готовим макет 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровкиОбъект = Новый ДанныеРасшифровкиКомпоновкиДанных;
	ДанныеРасшифровкиОбъект.Настройки = ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки();
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыйКомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровкиОбъект);
	АдресСхемыИсполненногоОтчета = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ?(АдресСхемыИсполненногоОтчета <> "", АдресСхемыИсполненногоОтчета, УникальныйИдентификатор));
	
    //4. исполняем макет 
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , ДанныеРасшифровкиОбъект, Ложь);
	
    //5. выводим результат 
	Результат.Очистить();
	
	Если МакетКомпоновкиДанных.НаборыДанных.Количество() > 0
		И СтрНайти(МакетКомпоновкиДанных.НаборыДанных[0].Запрос, "&СчетДоверительногоУправления") <> 0
		И МакетКомпоновкиДанных.ЗначенияПараметров.Найти("СчетДоверительногоУправления") = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задано значение параметра 'Счет доверительного управления'!");
		Возврат;
	КонецЕсли;
	
	ПроцессорВыводаРезультатаОтчета = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВыводаРезультатаОтчета.УстановитьДокумент(Результат);
	ПроцессорВыводаРезультатаОтчета.НачатьВывод();
	ПроцессорВыводаРезультатаОтчета.Вывести(ПроцессорКомпоновкиДанных);
	ПроцессорВыводаРезультатаОтчета.ЗакончитьВывод();
	
	Если ДанныеРасшифровкиОбъект <> Неопределено Тогда
		АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОбъект, УникальныйИдентификатор);
	КонецЕсли;
	
	//Элементы.ИсполняемыйКомпоновщикНастроекНастройки.ТекущаяСтрока = ИсполняемыйКомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(ИсполняемыйКомпоновщикНастроек.Настройки.Структура[0]);
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя());
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ОчиститьСообщения();
	
	Отказ = Ложь;
	
	Для каждого ЭлементОтбора Из ИсполняемыйКомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.Использование И НЕ ЗначениеЗаполнено(ЭлементОтбора.ЛевоеЗначение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неправильно заполнен отбор",,,, Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	
	Если НЕ Отказ И ПроверитьЗаполнение() Тогда
		СформироватьНаСервере();
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеИспользовать");
	КонецЕсли;
	
КонецПроцедуры

//Форма
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.Элементы.НастройкиИКомпоновщик.ТекущаяСтраница = ЭтаФорма.Элементы.Настройки;
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
	
	ЭтаФорма.ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ПараметрыФО = Новый Структура("Организация", ЭтаФорма.Организация);
	ЭтаФорма.УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);
	
	ЭтаФорма.НачалоПериода = НачалоМесяца(ТекущаяДата());
	ЭтаФорма.КонецПериода  = КонецМесяца(ТекущаяДата());
	ЭтаФорма.ВидПериода    = Перечисления.ДоступныеПериодыОтчета.Месяц;
		
	Для каждого МетаданныеРегистрНакопления Из Метаданные.РегистрыНакопления Цикл
		Если НЕ ПравоДоступа("Просмотр", МетаданныеРегистрНакопления) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтаФорма.Элементы.Регистр.СписокВыбора.Добавить(МетаданныеРегистрНакопления.Имя, МетаданныеРегистрНакопления.Представление());
		Если ЭтаФорма.Регистр = "" Тогда
			ЭтаФорма.Регистр = МетаданныеРегистрНакопления.Имя;
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.Элементы.Регистр.СписокВыбора.СортироватьПоПредставлению();
	
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Основной", "Основной");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Яркий", "Яркий");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Море", "Море");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Арктика", "Арктика");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Зеленый", "Зеленый");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("Античный", "Античный");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("МакетОформленияОтчетовЗеленый", "По умолчанию");
	ЭтаФорма.Элементы.МакетОформления.СписокВыбора.Добавить("МакетОформленияОтчетовЧерноБелый", "Черно-белый");
	
	ЭтаФорма.Периодичность = "Период";
	ЭтаФорма.РазмещениеДополнительныхПолей = "В одной колонке";
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ЗаполнитьСписокВыбораВидПериода(Перечисления.ДоступныеПериодыОтчета.День,
		ЭтаФорма.Элементы.ВидПериода.СписокВыбора, ЭтаФорма.ВидПериода);
		
	ПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	ЭтаФорма.Элементы.НастройкиИКомпоновщик.ОтображениеСтраниц = ?(ПолноправныйПользователь, ОтображениеСтраницФормы.ЗакладкиСверху, ОтображениеСтраницФормы.Нет);
	ЭтаФорма.Элементы.КомпоновщикНастройкиПолейНастройкиВыборПеренестиВВыбранныеПоля.Видимость = ПолноправныйПользователь;
	
	УправлениеФормой(ЭтаФорма);
	
	ИзменитьСхемуКомпоновкиДанных(Ложь);
	
	РаботаСОтчетами.ЗаполнитьВариантОтчета(ЭтаФорма);
	
КонецПроцедуры

//Актуальность и схема
&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	ИзменитьСхемуКомпоновкиДанных(Истина, Ложь);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");
КонецПроцедуры

&НаКлиенте
Процедура РегистрПриИзменении(Элемент)
	
	Если ПустаяСтрока(ЭтаФорма.Регистр) Тогда
		ЭтаФорма.Регистр = Элементы.Регистр.СписокВыбора.Получить(0).Значение;
	КонецЕсли;

	ИзменитьСхемуКомпоновкиДанных(Истина);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Этаформа.Элементы.Результат, "НеАктуальность");

КонецПроцедуры

