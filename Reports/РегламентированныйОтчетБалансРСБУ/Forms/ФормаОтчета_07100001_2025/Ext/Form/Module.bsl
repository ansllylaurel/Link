				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетная сумма долгосрочных и краткосрочных вложений не совпадает с балансовой стоимостью. Разделение не произведено.");				
			КонецЕсли;
		Иначе
			
			Если сц=1 Тогда
				ДатаПо = КонецГода(ДобавитьМесяц(ЭтаФорма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, -12));
				ИмяЯчейкиЗаголовка = "ДатаПрошлыйГод";
				ИмяРеквизитаОтчета = "ОтчетНаКонецПрошлогоГода";
				НазваниеГода = "прошлого";
				
			ИначеЕсли сц=2 Тогда
				ДатаПо = КонецГода(ДобавитьМесяц(ЭтаФорма.СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, -24));
				ИмяЯчейкиЗаголовка = "ДатаПозапрошлыйГод";
				ИмяРеквизитаОтчета = "ОтчетНаКонецПозапрошлогоГода";
				НазваниеГода = "позапрошлого";
			КонецЕсли;
			
			ТекРаздел.Области[ИмяЯчейкиЗаголовка].Значение = "На "+Формат(ДатаПо,"ДФ='dd MMMM yyyy'") +" г.";		
			ТекРаздел.Области[ИмяЯчейкиЗаголовка + "1"].Значение = "На "+Формат(ДатаПо,"ДФ='dd MMMM yyyy'") +" г.";		
			
			ПоказателиОтчета = Новый Структура;
			Для каждого Показатель из ЭтаФорма.мТаблицаСоставПоказателей Цикл
				Если Прав(Показатель.КодПоказателяПоСоставу,2) = "03" Тогда
					//убираем расчетные ячейки
					Если СтрНайти("П10,П17,П18,П25,П30,П36,П37", Лев(Показатель.КодПоказателяПоСоставу,3))>0 Тогда
						//ТекРаздел.Области[Лев(Показатель.КодПоказателяПоСоставу,3) + "0" + (сц + 3)].Значение = 0;
						Продолжить;
					КонецЕсли;
					ПоказателиОтчета.Вставить(Показатель.КодПоказателяПоСоставу);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтруктураРеквизитовФормы[ИмяРеквизитаОтчета]) Тогда
				
				ТаблицаПоказателиОтчета = Неопределено;
				ДанныеОтчета = СтруктураРеквизитовФормы[ИмяРеквизитаОтчета].ДанныеОтчета.Получить();
				
				Если ДанныеОтчета.Свойство("ПоказателиОтчета", ТаблицаПоказателиОтчета) Тогда
					НайденныеСтроки = ТаблицаПоказателиОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", "Баланс"));
					Для каждого СтрокаПоказателей Из НайденныеСтроки Цикл
						Если ПоказателиОтчета.Свойство(СтрокаПоказателей.ИмяПоказателя) Тогда
							ТекРаздел.Области[Лев(СтрокаПоказателей.ИмяПоказателя,3) + "0" + (сц + 3)].Значение = СтрокаПоказателей.Значение;
						КонецЕсли; 
					КонецЦикла; 
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчете на конец " + НазваниеГода + " года отсутствуют данные для заполнения");
				КонецЕсли;
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить отчет на конец " + НазваниеГода + " года");
			КонецЕсли; 
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

