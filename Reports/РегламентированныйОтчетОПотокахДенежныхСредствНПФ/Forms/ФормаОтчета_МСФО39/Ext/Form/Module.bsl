&НаСервере
Процедура ЗаполнитьРаздел_ДенежныеСредстваСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	мПредставлениеНачалаТекущегоПериода    = "На " + Формат(НачалоГода(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета), "ДФ=dd.MM.yyyy");
	мПредставлениеНачалаПредыдущегоПериода = "На " + Формат(НачалоГода(СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета), "ДФ=dd.MM.yyyy");
	ТекРаздел.Области.ТекущийПериод2.Значение    = мПредставлениеНачалаТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод2.Значение = мПредставлениеНачалаПредыдущегоПериода;
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
