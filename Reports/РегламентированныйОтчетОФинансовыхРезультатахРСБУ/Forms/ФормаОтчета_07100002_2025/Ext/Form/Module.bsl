	ТекСтрока  = ЭтаФорма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", "ОтчетОФинансовыхРезультатах2025"))[0];	
	
	РасчетРаздела_ОтчетОФинансовыхРезультатах2025(ТекСтрока.ТабличныйДокумент, ТекСтрока.ИмяРаздела);

КонецПроцедуры

