Процедура ЗаполнитьРаздел_РасшифровкаСервер(ТекРаздел, ИмяРаздела)
	
	ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет;
	СтрокаВидУчета = "БухгалтерскийУчет";
	
	ТипЧисло = Новый ОписаниеТипов("Число");   
		
	ОбластиИЗначения = Новый Структура;
	
	//таблицы с расшифровками прочих доходов и Расходов
	ПрочиеДоходы = Новый ТаблицаЗначений;
	ПрочиеДоходы.Колонки.Добавить("ПрочиеДоходыРасходы");
	ПрочиеДоходы.Колонки.Добавить("Сумма", ТипЧисло);
	
	ПрочиеРасходы = Новый ТаблицаЗначений;
	ПрочиеРасходы.Колонки.Добавить("ПрочиеДоходыРасходы");
	ПрочиеРасходы.Колонки.Добавить("Сумма", ТипЧисло);	
	
	ПрочиеДоходыПрошлыйГод = Новый ТаблицаЗначений;
	ПрочиеДоходыПрошлыйГод.Колонки.Добавить("ПрочиеДоходыРасходы");
	ПрочиеДоходыПрошлыйГод.Колонки.Добавить("Сумма", ТипЧисло);
	
	ПрочиеРасходыПрошлыйГод = Новый ТаблицаЗначений;
	ПрочиеРасходыПрошлыйГод.Колонки.Добавить("ПрочиеДоходыРасходы");
	ПрочиеРасходыПрошлыйГод.Колонки.Добавить("Сумма", ТипЧисло);	
	
	//колонки как запросе к 91-му. кроме Фильтра и Строки Отчета
	ТабРасшифровки = Новый ТаблицаЗначений;
	ТабРасшифровки.Колонки.Добавить("СтрокаОтчета");
	ТабРасшифровки.Колонки.Добавить("Счет");
	ТабРасшифровки.Колонки.Добавить("КорСчет");
	ТабРасшифровки.Колонки.Добавить("ПрочиеДоходыРасходы");
	ТабРасшифровки.Колонки.Добавить("ЦенныеБумаги");
	ТабРасшифровки.Колонки.Добавить("ЦенныеБумагиНаименование");
	ТабРасшифровки.Колонки.Добавить("ОбращаетсяНаОРЦБ");
	ТабРасшифровки.Колонки.Добавить("Фильтр");
	ТабРасшифровки.Колонки.Добавить("СуммаОборотКт");
	ТабРасшифровки.Колонки.Добавить("СуммаОборотДт");
	ТабРасшифровки.Колонки.Добавить("Регистратор");
	
	
	Если СтруктураРеквизитовФормы.ОтчетЗаПоследнийКвартал Тогда 
		ДатаНачальная = СтруктураРеквизитовФормы.мДатаНачалаПоследнегоКвартала;
		ДатаКонечная = СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета; 
	Иначе	
		ДатаНачальная = СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета;
		ДатаКонечная = СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета; 
	КонецЕсли;
	
	ОбщиеФункции = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ОтчетыДоходыРасходыОбщиеФункции");
		
	НастройкиУчетаАктивов = ОбщиеФункции.ПолучитьНастройкиУчетаАктивов(ЭтаФорма.СтруктураРеквизитовФормы.Организация, ЭтаФорма.СтруктураРеквизитовФормы.СчетДоверительногоУправления, ДатаКонечная, ВидУчета);
	НастройкиУчетаКомиссии = ОбщиеФункции.ПолучитьНастройкиУчетаКомиссии(ЭтаФорма.СтруктураРеквизитовФормы.Организация, ЭтаФорма.СтруктураРеквизитовФормы.СчетДоверительногоУправления, ДатаКонечная, ВидУчета);

	МакетНастройка = Отчеты.РегламентированныйОтчетОФинансовыхРезультатахРСБУ.ПолучитьМакет("Настройка");
	ТаблицаНастройки = ОбщиеФункции.ПолучитьТаблицуНастроекИзМакета(МакетНастройка, "Заголовки", "ДанныеРасшифровка", "Колонки", НастройкиУчетаАктивов, НастройкиУчетаКомиссии);
	
	ТаблицаНастройкиПрошлыйГод = ТаблицаНастройки.Скопировать();  
	Для Каждого СтрокаНастройки из ТаблицаНастройкиПрошлыйГод Цикл
		СтрокаНастройки.ИмяПараметра = Лев(СтрокаНастройки.ИмяПараметра, 3) + "03";
	КонецЦикла;
	
	ТаблицаРезультат = ОбщиеФункции.ЗапросДоходыРасходы(ЭтаФорма.СтруктураРеквизитовФормы.Организация, ЭтаФорма.СтруктураРеквизитовФормы.СчетДоверительногоУправления, ДатаКонечная, СтрокаВидУчета, ДатаНачальная);	
	ОбщиеФункции.РаспределениеРезультата(ТаблицаРезультат, ТаблицаНастройки, "П5402", "П7202", ОбластиИЗначения, ТабРасшифровки, ПрочиеДоходы, ПрочиеРасходы, Ложь);
	
	РаспределитьДоходыРасходыРасшифровкаПоНастройке(ОбщиеФункции, ОбластиИЗначения, ЭтаФорма.СтруктураРеквизитовФормы, Ложь);  
	
	//прошлый год
	Если СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета = НачалоГода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) Тогда 
		//все  нормально, реформации в этом году не было 
		
		Если СтруктураРеквизитовФормы.ОтчетЗаПоследнийКвартал Тогда
			ДатаКонечнаяПрошлыйГод = СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета;
			ДатаНачальнаяПрошлыйГод = СтруктураРеквизитовФормы.мДатаНачалаПоследнегоКварталаПрошлогоПериодаОтчета;    
		Иначе	
			ДатаКонечнаяПрошлыйГод = СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета;
			ДатаНачальнаяПрошлыйГод = СтруктураРеквизитовФормы.мДатаНачалаПрошлогоПериодаОтчета;    
		КонецЕсли;
		
		ТаблицаРезультат = ОбщиеФункции.ЗапросДоходыРасходы(ЭтаФорма.СтруктураРеквизитовФормы.Организация, ЭтаФорма.СтруктураРеквизитовФормы.СчетДоверительногоУправления, ДатаКонечнаяПрошлыйГод, СтрокаВидУчета, ДатаНачальнаяПрошлыйГод);	
		ОбщиеФункции.РаспределениеРезультата(ТаблицаРезультат, ТаблицаНастройкиПрошлыйГод, "П5403", "П7203", ОбластиИЗначения, ТабРасшифровки, ПрочиеДоходыПрошлыйГод, ПрочиеРасходыПрошлыйГод, Ложь);	
		
		РаспределитьДоходыРасходыРасшифровкаПоНастройке(ОбщиеФункции, ОбластиИЗначения, ЭтаФорма.СтруктураРеквизитовФормы, Истина);
	КонецЕсли;	
	
    ОбщиеФункции.ЗаполнениеОбластиЗначениями(ТекРаздел, ОбластиИЗначения);
		
КонецПроцедуры

#КонецОбласти 

#Область ПодключаемыеПроцедуры

&НаКлиенте
