			Если ПараметрыОтчета.скПоЛицевомуСчету И ПараметрыОтчета.скПоПартиям Тогда
				Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос = 
				СтрЗаменить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет, ОстаткиИОбороты.ЛицевойСчет.Партия КАК Партия,");
			ИначеЕсли ПараметрыОтчета.скПоЛицевомуСчету Тогда 	
				Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос = 
				СтрЗаменить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,");
			ИначеЕсли ПараметрыОтчета.скПоПартиям Тогда 	
				Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос = 
				СтрЗаменить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ОстаткиИОбороты.ЛицевойСчет.Партия КАК Партия,");
			КонецЕсли;
			
		КонецЕсли;
		
		
		Если Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.Найти("ПоСубконтоРазвернутое") <> Неопределено Тогда
			
