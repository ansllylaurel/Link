				Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое.Запрос = 
				СтрЗаменить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,");
				
				Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое.Запрос = 
