#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	РаботаСБухгалтерскимиОтчетами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	Механизм = "Отчет.ОборотноСальдоваяВедомость.АвтоматическоеФормирование()";
	Форма = Новый Структура;
	
	МенеджерОтчета = Отчеты[ЭтотОбъект.Метаданные().Имя];
	
	Форма.Вставить("НаборПоказателей", МенеджерОтчета.ПолучитьНаборПоказателей());
	Форма.Вставить("Результат", Новый ТабличныйДокумент);
	Форма.Вставить("ВыводитьПодвал", Ложь);
	Форма.Вставить("ВыводитьЗаголовок", Ложь);
	Форма.Вставить("ВыводитьЕдиницуИзмерения", Ложь);
	Форма.Вставить("МакетОформления", "");
	Форма.Вставить("Отчет", ЭтотОбъект);
	
	// ПриЗагрузкеПользовательскихНастроекНаСервере
	Если НастройкиОтчета.Свойство("ВариантОтчета") И ТипЗнч(НастройкиОтчета.ВариантОтчета) = Тип("УникальныйИдентификатор") Тогда
		ВариантОтчета = Справочники.ВариантыОтчетов.ПолучитьСсылку(НастройкиОтчета.ВариантОтчета);
		Настройки = ВариантОтчета.Настройки.Получить();
	КонецЕсли;
	
	ПриЗагрузкеПользовательскихНастроекНаСервере(Форма, Настройки);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	Настройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	Настройки.ДополнительныеСвойства.Свойство("ВыводитьПодвал", Форма.ВыводитьПодвал);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	КонецЕсли;
			
	// АвтоматическоеФормирование
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.НачалоПериода = НастройкиОтчета.Период.ДатаНачала; 
	ЭтотОбъект.КонецПериода = НастройкиОтчета.Период.ДатаОкончания; 
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
		ЭтотОбъект,
		"НачалоПериода,КонецПериода,Организация,СчетДоверительногоУправления,ПоСубсчетам,
		|ВыводитьЗабалансовыеСчета,РазмещениеДополнительныхПолей,ПоказательБУ,
		|ПоказательВалютнаяСумма,РежимРасшифровки,УчетныйРегистр,скПоЛицевомуСчету,скПоПартиям",
		Новый Структура("ВариантОтчета", ВариантОтчета.Наименование));
		
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	// АвтоматическоеФормированиеНаСервере
	АдресХранилища = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);
	ДополнительныеСвойства = ЭтотОбъект.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", 	Форма.ВыводитьЗаголовок);
	ДополнительныеСвойства.Вставить("ВыводитьПодвал", 		Форма.ВыводитьПодвал);

	
	ПараметрыОтчета = ПодготовитьПараметрыОтчета(Форма);
	РаботаСБухгалтерскимиОтчетами.СформироватьОтчет(ПараметрыОтчета, АдресХранилища);
	РезультатВыполнения 	= ПолучитьИзВременногоХранилища(АдресХранилища);
	Форма.Результат     	= РезультатВыполнения.Результат;

	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Форма.Результат, ЭтотОбъект.Метаданные().ПолноеИмя());
	НастройкиОтчета.Вставить("Результат", Форма.Результат);
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		УдалитьИзВременногоХранилища(АдресХранилища);
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры
 
Функция ПодготовитьПараметрыОтчета(Форма)

	МакетОформления = "";
	ПараметрМакетОформления = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПараметрВывода(ЭтотОбъект.КомпоновщикНастроек.Настройки, "МакетОформления");
	Если ПараметрМакетОформления.Использование И Не ПустаяСтрока(ПараметрМакетОформления.Значение) Тогда
		МакетОформления = ПараметрМакетОформления.Значение;
	КонецЕсли;
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация"                      , ЭтотОбъект.Организация);
	ПараметрыОтчета.Вставить("НачалоПериода"                    , ЭтотОбъект.НачалоПериода);
	ПараметрыОтчета.Вставить("КонецПериода"                     , ЭтотОбъект.КонецПериода);
	ПараметрыОтчета.Вставить("СчетДоверительногоУправления"     , ЭтотОбъект.СчетДоверительногоУправления);
	ПараметрыОтчета.Вставить("ПоказательБУ"                     , ЭтотОбъект.ПоказательБУ);
	ПараметрыОтчета.Вставить("ПоказательВалютнаяСумма"          , ЭтотОбъект.ПоказательВалютнаяСумма);
	ПараметрыОтчета.Вставить("ВыводитьЗабалансовыеСчета"        , ЭтотОбъект.ВыводитьЗабалансовыеСчета);
	ПараметрыОтчета.Вставить("РазмещениеДополнительныхПолей"    , ЭтотОбъект.РазмещениеДополнительныхПолей);
	ПараметрыОтчета.Вставить("ПоСубсчетам"                      , ЭтотОбъект.ПоСубсчетам);
	ПараметрыОтчета.Вставить("Группировка"                      , ЭтотОбъект.Группировка.Выгрузить());
	ПараметрыОтчета.Вставить("ДополнительныеПоля"               , ЭтотОбъект.ДополнительныеПоля.Выгрузить());
	ПараметрыОтчета.Вставить("РазвернутоеСальдо"                , ЭтотОбъект.РазвернутоеСальдо.Выгрузить());
	ПараметрыОтчета.Вставить("РежимРасшифровки"                 , ЭтотОбъект.РежимРасшифровки);
	ПараметрыОтчета.Вставить("ВыводитьЗаголовок"                , Форма.ВыводитьЗаголовок);
	ПараметрыОтчета.Вставить("ВыводитьПодвал"                   , Форма.ВыводитьПодвал);
	ПараметрыОтчета.Вставить("ДанныеРасшифровки"                , Новый ДанныеРасшифровкиКомпоновкиДанных);
	ПараметрыОтчета.Вставить("МакетОформления"                  , Форма.МакетОформления);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных"            , ЭтотОбъект.СхемаКомпоновкиДанных);
	ПараметрыОтчета.Вставить("ИдентификаторОтчета"              , "ОборотноСальдоваяВедомость");
	ПараметрыОтчета.Вставить("НастройкиКомпоновкиДанных"        , ЭтотОбъект.КомпоновщикНастроек.ПолучитьНастройки());
	ПараметрыОтчета.Вставить("НаборПоказателей"                 , Отчеты[ПараметрыОтчета.ИдентификаторОтчета].ПолучитьНаборПоказателей());
    ПараметрыОтчета.Вставить("ВыводитьЕдиницуИзмерения"         , Форма.ВыводитьЕдиницуИзмерения);
	ПараметрыОтчета.Вставить("УчетныйРегистр"                   , ЭтотОбъект.УчетныйРегистр);
	ПараметрыОтчета.Вставить("скПоЛицевомуСчету"                , ЭтотОбъект.скПоЛицевомуСчету);
	ПараметрыОтчета.Вставить("скПоПартиям"                		, ЭтотОбъект.скПоПартиям);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица); 	
	ПараметрыОтчета.Вставить("СтруктураДанныхКонтактногоЛица"	, СтруктураДанныхКонтактногоЛица);
	
	Возврат ПараметрыОтчета;

КонецФункции

Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(ФормаОтчета, Настройки, ЗагружатьТолькоРеквизиты = Ложь) Экспорт

	Если Настройки = Неопределено Тогда
		// Установка настроек по умолчанию
		УстановитьНастройкиПоУмолчанию(ФормаОтчета);		
	Иначе 
		// Восстановление сохраненных настроек
		Если Настройки.ДополнительныеСвойства.Свойство("ДанныеОтчета") Тогда
			ДополнительныеСвойства = Настройки.ДополнительныеСвойства.ДанныеОтчета.Получить();
			МетаданныеОтчета = ЭтотОбъект.Метаданные();
			Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
				
				//организация должна текущая браться
				Если ЭлементСтруктуры.Ключ = "Организация" Тогда
					Продолжить;
				КонецЕсли;
				
				// Восстановление реквизитов отчета
				Если Не (МетаданныеОтчета.Реквизиты.Найти(ЭлементСтруктуры.Ключ) = Неопределено И 
					МетаданныеОтчета.ТабличныеЧасти.Найти(ЭлементСтруктуры.Ключ) = Неопределено) Тогда
					Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
						ФормаОтчета.Отчет[ЭлементСтруктуры.Ключ].Загрузить(ЭлементСтруктуры.Значение);
					ИначеЕсли ЭлементСтруктуры.Ключ <> "РежимРасшифровки" Тогда
						ФормаОтчета.Отчет[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
					КонецЕсли;
				КонецЕсли;
				
				// Восстановление реквизитов формы
				Если ЭлементСтруктуры.Ключ = "ВыводитьЗаголовок" И ФормаОтчета.Свойство("ВыводитьЗаголовок") Тогда
					ФормаОтчета.ВыводитьЗаголовок = ЭлементСтруктуры.Значение;
				ИначеЕсли ЭлементСтруктуры.Ключ = "ВыводитьПодвал" И ФормаОтчета.Свойство("ВыводитьПодвал") Тогда
					ФормаОтчета.ВыводитьПодвал = ЭлементСтруктуры.Значение;
				ИначеЕсли ЭлементСтруктуры.Ключ = "ВыводитьЕдиницуИзмерения" И ФормаОтчета.Свойство("ВыводитьЕдиницуИзмерения") Тогда
					ФормаОтчета.ВыводитьЕдиницуИзмерения = ЭлементСтруктуры.Значение;
				ИначеЕсли ЭлементСтруктуры.Ключ = "ВыводитьДиаграмму" И ФормаОтчета.Свойство("ВыводитьДиаграмму") Тогда
					ФормаОтчета.ВыводитьДиаграмму = ЭлементСтруктуры.Значение;
				ИначеЕсли ЭлементСтруктуры.Ключ = "МакетОформления" И ФормаОтчета.Свойство("МакетОформления") Тогда
					ФормаОтчета.МакетОформления = ЭлементСтруктуры.Значение;
					РаботаСБухгалтерскимиОтчетамиКлиентСервер.УстановитьПараметрВывода(
						ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки, 
						"МакетОформления", ФормаОтчета.МакетОформления);
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ДополнительныеСвойства.Свойство("ВыводитьДиаграмму") И ФормаОтчета.Свойство("ВыводитьДиаграмму") Тогда
				
				ФормаОтчета.ВыводитьДиаграмму = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		Если Не ЗагружатьТолькоРеквизиты Тогда
			ТекущиеНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки;
			
			// Установка пользовательских настроек
			ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "Отбор";
			ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "Порядок";
			ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "УсловноеОформление";
			
			// Перенос пользовательских настроек в основные
			ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Настройки);
			ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ФормаОтчета.Отчет.КомпоновщикНастроек.ПолучитьНастройки());
			
			// Очистка пользовательских настроек
			ТекущиеНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки;
			ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "";
			ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "";
			ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "";
		КонецЕсли;		
	КонецЕсли;
	
	Если ФормаОтчета.Свойство("МинимальныйВидПериода") Тогда
		МинимальныйВидПериода = ФормаОтчета.МинимальныйВидПериода;
	Иначе
		МинимальныйВидПериода = Неопределено;
	КонецЕсли;
	
	Если ФормаОтчета.Отчет.ДополнительныеПоля.НайтиСтроки(Новый Структура("Поле", "Счет.Наименование")).Количество() = 0 Тогда
		НоваяСтрока = ФормаОтчета.Отчет.ДополнительныеПоля.Добавить();
		НоваяСтрока.Представление = "Выводить наименование счета";
		НоваяСтрока.Поле          = "Счет.Наименование";
		НоваяСтрока.Использование = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьНастройкиПоУмолчанию(ФормаОтчета) Экспорт
	
	Отчет = ФормаОтчета.Отчет;
	
	Если Отчет.Свойство("НачалоПериода") Тогда
		Отчет.НачалоПериода = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если Отчет.Свойство("КонецПериода") Тогда
		Отчет.КонецПериода  = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	Если Отчет.Свойство("Организация") Тогда
		Отчет.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	Если Отчет.Свойство("СальдоНаНачалоДт") Тогда
		Отчет.СальдоНаНачалоДт   = Истина;	
		Отчет.СальдоНаНачалоКт   = Истина;
		Отчет.СальдоНаКонецДт    = Истина;
		Отчет.СальдоНаКонецКт    = Истина;
		Отчет.ОборотыЗаПериодДт  = Истина;
		Отчет.ОборотыЗаПериодКт  = Истина;
		Отчет.ОборотыСоСчетамиДт = Истина;
		Отчет.ОборотыСоСчетамиКт = Истина;
	КонецЕсли;
	
	ИдентификаторОбъекта = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьИдентификаторОбъекта(ФормаОтчета);
	Если ИдентификаторОбъекта = "ОборотноСальдоваяВедомость" Тогда
		Если Отчет.ДополнительныеПоля.НайтиСтроки(Новый Структура("Поле", "Счет.Наименование")).Количество() = 0 Тогда
			НоваяСтрока = ФормаОтчета.Отчет.ДополнительныеПоля.Добавить();
			НоваяСтрока.Представление = "Выводить наименование счета";
			НоваяСтрока.Поле          = "Счет.Наименование";
			НоваяСтрока.Использование = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Установка начальных значений Группировки
	Если Отчет.Свойство("Группировка") Тогда
		Отчет.Группировка.Очистить();
		Для Каждого ЭлементСтруктуры Из Отчет.КомпоновщикНастроек.Настройки.Структура Цикл
			Если ТипЗнч(ЭлементСтруктуры) = Тип("ДиаграммаКомпоновкиДанных") Тогда
				Для Каждого Серия Из ЭлементСтруктуры.Серии Цикл
					Если Серия.Имя = "Группировка" Тогда
						РаботаСБухгалтерскимиОтчетами.ЗаполнитьГруппировкиИзНастроек(Отчет.КомпоновщикНастроек, Серия, Отчет.Группировка);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Для Каждого Точка Из ЭлементСтруктуры.Точки Цикл
					Если Точка.Имя = "Группировка" Тогда
						РаботаСБухгалтерскимиОтчетами.ЗаполнитьГруппировкиИзНастроек(Отчет.КомпоновщикНастроек, Точка, Отчет.Группировка);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
				Для Каждого Колонка Из ЭлементСтруктуры.Колонки Цикл
					Если Колонка.Имя = "Группировка" Тогда
						РаботаСБухгалтерскимиОтчетами.ЗаполнитьГруппировкиИзНастроек(Отчет.КомпоновщикНастроек, Колонка, Отчет.Группировка);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Для Каждого Строка Из ЭлементСтруктуры.Строки Цикл
					Если Строка.Имя = "Группировка" Тогда
						РаботаСБухгалтерскимиОтчетами.ЗаполнитьГруппировкиИзНастроек(Отчет.КомпоновщикНастроек, Строка, Отчет.Группировка);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда
				Если ЭлементСтруктуры.Имя = "Группировка" Тогда
					Отчет.Группировка.Очистить();
					РаботаСБухгалтерскимиОтчетами.ЗаполнитьГруппировкиИзНастроек(Отчет.КомпоновщикНастроек, ЭлементСтруктуры, Отчет.Группировка);
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Отчет.Свойство("Интервалы") Тогда
		Отчет.Интервалы.Очистить();
		
		НоваяСтрока = Отчет.Интервалы.Добавить();
