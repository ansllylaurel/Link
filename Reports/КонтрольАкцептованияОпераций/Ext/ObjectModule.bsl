Процедура УстановитьЗначениеПараметраСКД(ИмяПараметра, Значение)
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Параметр.Значение		= Значение;
    Параметр.Использование	= Истина;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	УстановитьЗначениеПараметраСКД("НачалоПериода",							Период.ДатаНачала);
	УстановитьЗначениеПараметраСКД("КонецПериода",							КонецДня(Период.ДатаОкончания));
	УстановитьЗначениеПараметраСКД("Организация",							Организация);
	УстановитьЗначениеПараметраСКД("СчетаДоверительногоУправления",			СчетаДоверительногоУправления.ВыгрузитьЗначения());
	УстановитьЗначениеПараметраСКД("ВидыДоговоровДоверительногоУправления",	ВидыДоговоровДоверительногоУправления.ВыгрузитьЗначения());
	УстановитьЗначениеПараметраСКД("ВыводитьАкцептованныеДокументы",		ВыводитьАкцептованныеДокументы);
	УстановитьЗначениеПараметраСКД("ВалютаУчета",							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
КонецПроцедуры
