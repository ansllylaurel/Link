&НаСервере
Процедура скИзменитьСтруктуруОтчета()
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.Найти("ОсновнойНабор") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос, "ЕдиныйБухгалтерскийУчетОборотыДтКт.ЛицевойСчетДт,", "");
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос, "ЕдиныйБухгалтерскийУчетОборотыДтКт.ЛицевойСчетКт,", "");
		
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда	
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.ОсновнойНабор.Запрос, "ЕдиныйБухгалтерскийУчетОборотыДтКт.СчетДт," 
														,"ЕдиныйБухгалтерскийУчетОборотыДтКт.СчетДт, ЕдиныйБухгалтерскийУчетОборотыДтКт.ЛицевойСчетДт, ЕдиныйБухгалтерскийУчетОборотыДтКт.ЛицевойСчетКт,");
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
	
// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
		
		// Сортировка
			
		МассивЭлементовКУдалению = Новый Массив;
		
		Для Каждого ЭлементПорядка Из Отчет.КомпоновщикНастроек.Настройки.Порядок.Элементы Цикл 
			Если СтрЧислоВхождений(Строка(ЭлементПорядка.Поле) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементПорядка);	
			КонецЕсли;			
		КонецЦикла;	
		
		Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
			Отчет.КомпоновщикНастроек.Настройки.Порядок.Элементы.Удалить(УдаляемыйЭлемент);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры	


