&НаСервере
Процедура ЗаполнитьРаздел_ОтчетТитульнаяСтраницаСервер(ТекРаздел, ИмяРаздела)
		
	// странное дело - выводим данные напрямую в титульный лист, минуюя листы расшифровки, но именно так сказано в задаче #388929
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	мТаблицаСчетов.Очистить();
	ДобавитьСчетВТаблицуСчетов("П32", "Обязательство по текущему налогу на прибыль", "+", "!СКК", "60328", "Сальдо на конец периода #Период# по кредиту счета 60328");
	ЗаполнитьРазделПоСпискуСчетовЗаОтчетныйИПредыдущийПериоды(Запрос, "НаКонец", ТекРаздел, "02", "03");
	
