Процедура Подключаемый_ЗаполнитьРаздел_СверкаСуммВОтчетеОДенежныхПотокахСоСтатьями2017()
	
	ТекСтрока  = ЭтаФорма.РазделыОтчета.НайтиСтроки(Новый Структура("ИмяРаздела", "СверкаСуммВОтчетеОДенежныхПотокахСоСтатьями2017"))[0];
	
	ТекРаздел  = ТекСтрока.ТабличныйДокумент;
	ИмяРаздела = ТекСтрока.ИмяРаздела;
	
