	ЗаполнитьРаздел_ОтчетТитульнаяСтраницаСервер(ТекРаздел, ИмяРаздела);
	
	РасчетРаздела_ОтчетТитульнаяСтраница(ТекРаздел, ИмяРаздела);
	ТекСтрока.ТабличныйДокумент = ТекРаздел;
	
