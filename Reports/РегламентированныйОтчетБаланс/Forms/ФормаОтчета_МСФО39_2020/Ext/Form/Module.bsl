// 51.10
&НаСервере
Процедура ЗаполнитьРаздел_ИнформацияОКредитномКачествеПрочихРазмещенныхСредствИДЗСервер(ТекРаздел, ИмяРаздела)
	// Этот раздел заполняется только у Большой ПР. 
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""14"" КАК НомерСтроки,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт КАК Сумма,
		|	ВЫБОР
		|		КОГДА &СчетДоверительногоУправления = &БольшойПР
		|				И НАЧАЛОПЕРИОДА(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Регистратор.Дата, ДЕНЬ) = &ДатаВводаБольшой
		|			ТОГДА 365
		|		ИНАЧЕ РАЗНОСТЬДАТ(ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Регистратор.Дата, &КонецПериода, ДЕНЬ)
		|	КОНЕЦ КАК ДнейЗадолженности
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			,
		|			&грКонецПериода,
		|			Регистратор,
		|			Движения,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ05)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ДнейЗадолженности < 30
		|			ТОГДА ""02""
		|		КОГДА _ИтоговаяТаблица.ДнейЗадолженности >= 30
		|				И _ИтоговаяТаблица.ДнейЗадолженности < 90
		|			ТОГДА ""03""
		|		КОГДА _ИтоговаяТаблица.ДнейЗадолженности >= 90
		|				И _ИтоговаяТаблица.ДнейЗадолженности < 180
		|			ТОГДА ""04""
		|		КОГДА _ИтоговаяТаблица.ДнейЗадолженности >= 180
		|				И _ИтоговаяТаблица.ДнейЗадолженности < 360
		|			ТОГДА ""05""
		|		КОГДА _ИтоговаяТаблица.ДнейЗадолженности >= 180
		|			ТОГДА ""06""
		|	КОНЕЦ КАК НомерКолонки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА _ИтоговаяТаблица.Сумма
		|		ИНАЧЕ _ИтоговаяТаблица.Сумма * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
		|		ПО (&ВалютаУчета = КурсВалютыПроводки.Валюта)"; 
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);	
	Запрос.УстановитьПараметр("БольшойПР", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Большой_ПР"));	
	Запрос.УстановитьПараметр("ДатаВводаБольшой", Дата(2021, 7, 22));  // ввод в ду Большой ПР. Реальную дату возникновения мы не знаем. Но давно
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;
	
	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание51_10";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);			
	
