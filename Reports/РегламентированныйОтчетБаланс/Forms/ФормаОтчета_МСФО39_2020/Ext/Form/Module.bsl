		Запрос.УстановитьПараметр("БрокерЭтоДС", Ложь);
	КонецЕсли;
	
	// Отбор по кредитным организациям и банкам-нерезидент
	стрОтборКредитныеОрганизации	= "ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ИСТИНА";		
	стрОтборКредитныеОрганизации_НЕ	= "ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ЛОЖЬ";		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТолькоКредитныеОрганизации", стрОтборКредитныеОрганизации);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсключаяКредитныеОрганизации", стрОтборКредитныеОрганизации_НЕ);		
	
	// Отбор по банкротам
	Запрос.УстановитьПараметр("Банкроты", РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаБанкроты(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));		
	
	
	Если СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета > '20220301'
		И НЕ БухгалтерскийУчет.ОпределитьНастройкуУчета(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.СчетДоверительногоУправления, "ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО") Тогда
		
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Истина);
	Иначе
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Ложь);
	КонецЕсли;	
	
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("УчетныйАктив", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивы"));
	
	МассивДопАналитикКупонов = Новый Массив;
	МассивДопАналитикКупонов.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
	МассивДопАналитикКупонов.Добавить(Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный);
	
	Для каждого ТекСтрока Из Результат Цикл
	
		Если ЗначениеЗаполнено(ТекСтрока.НомерКолонки) 
			ИЛИ ЗначениеЗаполнено(ТекСтрока.АнализируемаяДата)
			ИЛИ Не ЗначениеЗаполнено(ТекСтрока.ЦеннаяБумага) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если ТипЗнч(ТекСтрока.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда
			ТекСтрока.УчетныйАктив = Справочники.УчетныеАктивы.ПроцентыНаМНО;
		Иначе
			Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ТекСтрока.ЦеннаяБумага);
			ЭтоКупон = МассивДопАналитикКупонов.Найти(ТекСтрока.ДополнительнаяАналитика) <> Неопределено;
			ТекСтрока.УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, Рынок, ТекСтрока.ЦеннаяБумага, ЭтоКупон);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&КонецПериода КАК ОтчетнаяДата,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 1), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 1)
		|	КОНЕЦ КАК Год,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, МЕСЯЦ, 3), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, МЕСЯЦ, 3)
		|	КОНЕЦ КАК ТриМесяца
		|ПОМЕСТИТЬ _Периоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИсточник.НомерСтроки КАК НомерСтроки,
		|	ТаблицаИсточник.НомерКолонки КАК НомерКолонки,
		|	ТаблицаИсточник.Сумма КАК Сумма,
		|	ТаблицаИсточник.АнализируемаяДата КАК АнализируемаяДата,
		|	ТаблицаИсточник.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаИсточник.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ТаблицаИсточник.УчетныйАктив КАК УчетныйАктив
		|ПОМЕСТИТЬ _ТаблицаИсточник
		|ИЗ
		|	&ТаблицаИсточник КАК ТаблицаИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаИсточник.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаИсточник.НомерКолонки КАК НомерКолонки,
		|	СУММА(_ТаблицаИсточник.Сумма) КАК Сумма,
		|	_ТаблицаИсточник.АнализируемаяДата КАК АнализируемаяДата,
		|	_ТаблицаИсточник.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаИсточник.УчетныйАктив КАК УчетныйАктив
		|ПОМЕСТИТЬ _ТаблицаИсточникСгруппированная
		|ИЗ
		|	_ТаблицаИсточник КАК _ТаблицаИсточник
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаИсточник.УчетныйАктив,
		|	_ТаблицаИсточник.ЦеннаяБумага,
		|	_ТаблицаИсточник.АнализируемаяДата,
		|	_ТаблицаИсточник.НомерКолонки,
		|	_ТаблицаИсточник.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаИсточникСгруппированная.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаИсточникСгруппированная.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|				И РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо В (&ДочерниеПредприятияТП)
		|			ТОГДА ""04""
		|		КОГДА ВЫРАЗИТЬ(_ТаблицаИсточникСгруппированная.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо В (&ДочерниеПредприятияТП)
		|			ТОГДА ""04""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ДоТрехМесяцев)
		|			ТОГДА ""02""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ОтТрехМесяцевДоГода)
		|			ТОГДА ""03""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.СвышеГода)
		|			ТОГДА ""04""
		|		ИНАЧЕ _ТаблицаИсточникСгруппированная.НомерКолонки
		|	КОНЕЦ КАК НомерКолонки,
		|	_ТаблицаИсточникСгруппированная.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.МетодикаРасчетаСрокаКупона = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ПоСрокуПогашенияКупона)
		|			ТОГДА КупонныйДоходПоОблигациямСрезПоследних.ДатаОкончанияКупона
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.МетодикаРасчетаСрокаКупона = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ПоСрокуПогашенияТела)
		|				ИЛИ НастройкиУчетаАктивовСрезПоследних.МетодикаРасчетаСрокаКупона = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА НастройкиУчетаОбщиеСрезПоследних.РассчитыватьЭСПДо = ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаДоходностиПоОблигациям.ДоОферты)
		|						ТОГДА ЕСТЬNULL(МИНИМУМ(УсловияОферт.ДатаВыкупа), Облигации.ДатаПогашения)
		|					ИНАЧЕ Облигации.ДатаПогашения
		|				КОНЕЦ
		|		ИНАЧЕ _ТаблицаИсточникСгруппированная.АнализируемаяДата
		|	КОНЕЦ КАК АнализируемаяДата,
		|	_ТаблицаИсточникСгруппированная.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_ТаблицаИсточникСгруппированная КАК _ТаблицаИсточникСгруппированная
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(_ТаблицаИсточникСгруппированная.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК НастройкиУчетаАктивовСрезПоследних
		|		ПО _ТаблицаИсточникСгруппированная.УчетныйАктив = НастройкиУчетаАктивовСрезПоследних.УчетныйАктив
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(
		|				&КонецПериода,
		|				Облигация В
		|					(ВЫБРАТЬ
		|						_ТаблицаИсточникСгруппированная.ЦеннаяБумага
		|					ИЗ
		|						_ТаблицаИсточникСгруппированная КАК _ТаблицаИсточникСгруппированная)) КАК КупонныйДоходПоОблигациямСрезПоследних
		|		ПО _ТаблицаИсточникСгруппированная.ЦеннаяБумага = КупонныйДоходПоОблигациямСрезПоследних.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаИсточникСгруппированная.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО _ТаблицаИсточникСгруппированная.ЦеннаяБумага = УсловияОферт.Облигация
		|			И (&КонецПериода < УсловияОферт.ДатаВыкупа
		|				И НЕ УсловияОферт.ТолькоДляФизическихЛиц),
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТаблицаИсточникСгруппированная.НомерСтроки,
		|	_ТаблицаИсточникСгруппированная.Сумма,
		|	_ТаблицаИсточникСгруппированная.ЦеннаяБумага,
		|	_ТаблицаИсточникСгруппированная.АнализируемаяДата,
		|	НастройкиУчетаАктивовСрезПоследних.МетодикаРасчетаСрокаКупона,
		|	КупонныйДоходПоОблигациямСрезПоследних.ДатаОкончанияКупона,
		|	Облигации.ДатаПогашения,
		|	НастройкиУчетаОбщиеСрезПоследних.РассчитыватьЭСПДо,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ТаблицаИсточникСгруппированная.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|				И РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо В (&ДочерниеПредприятияТП)
		|			ТОГДА ""04""
		|		КОГДА ВЫРАЗИТЬ(_ТаблицаИсточникСгруппированная.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо В (&ДочерниеПредприятияТП)
		|			ТОГДА ""04""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ДоТрехМесяцев)
		|			ТОГДА ""02""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.ОтТрехМесяцевДоГода)
		|			ТОГДА ""03""
		|		КОГДА НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности = ЗНАЧЕНИЕ(Справочник.КлассификаторАктивовПоСрочности.СвышеГода)
		|			ТОГДА ""04""
		|		ИНАЧЕ _ТаблицаИсточникСгруппированная.НомерКолонки
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.НомерКолонки <> НЕОПРЕДЕЛЕНО
		|			ТОГДА _ИтоговаяТаблица.НомерКолонки
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.Год
		|			ТОГДА ""04""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриМесяца
		|			ТОГДА ""03""
		|		ИНАЧЕ ""02""
		|	КОНЕЦ КАК НомерКолонки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА СУММА(_ИтоговаяТаблица.Сумма)
		|		ИНАЧЕ СУММА(_ИтоговаяТаблица.Сумма) * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
		|		ПО (&ВалютаУчета = КурсВалютыПроводки.Валюта),
		|	_Периоды КАК _Периоды
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.НомерКолонки <> НЕОПРЕДЕЛЕНО
		|			ТОГДА _ИтоговаяТаблица.НомерКолонки
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.Год
		|			ТОГДА ""04""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриМесяца
		|			ТОГДА ""03""
		|		ИНАЧЕ ""02""
		|	КОНЕЦ,
		|	КурсВалютыПроводки.Курс";
	Запрос.УстановитьПараметр("ТаблицаИсточник", Результат);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла; 
	
	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание51_13";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Портрет);		
	
