		|			ЛЕВОЕ СОЕДИНЕНИЕ СтраныОЭСР КАК СтраныОЭСР
		|			ПО РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации = СтраныОЭСР.Объект
		|		ПО _ИтоговаяТаблица.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.НомерСтроки,
		|	КурсВалютыПроводки.Курс,
		|	ВЫБОР
		|		КОГДА РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|				ИЛИ _ИтоговаяТаблица.ЮрФизЛицо = ""РОССИЯ""
		|			ТОГДА ""02""
		|		КОГДА НЕ СтраныОЭСР.Объект ЕСТЬ NULL
		|			ТОГДА ""03""
		|		ИНАЧЕ ""04""
		|	КОНЕЦ";
	
	ДатаПеречня = КонсолидированнаяОтчетность.ПолучитьДатуПеречняФинансовыхОрганизаций(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ДатаПеречня", ДатаПеречня);	
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	
	Запрос.УстановитьПараметр("ДепозитныеВкладыДолгосрочные", ПолучитьДепозитныеВкладыДолгосрочные());
	Запрос.УстановитьПараметр("ДепозитныеВкладыКраткосрочные", ПолучитьДепозитныеВкладыКраткосрочные());
	
	Если ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС = Неопределено ИЛИ НЕ ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС Тогда
		Запрос.УстановитьПараметр("МНОэтоДепозит", Истина);
	Иначе	
		Запрос.УстановитьПараметр("МНОэтоДепозит", Ложь);
	КонецЕсли;
	
	Если ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС <> Неопределено И ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС Тогда
		Запрос.УстановитьПараметр("БрокерЭтоДС", Истина);
	Иначе
		Запрос.УстановитьПараметр("БрокерЭтоДС", Ложь);
	КонецЕсли;
	
	
	// Отбор по кредитным организациям и банкам-нерезидент
	стрОтборКредитныеОрганизации	= "ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ИСТИНА";		
	стрОтборКредитныеОрганизации_НЕ	= "ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом = ЛОЖЬ";		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТолькоКредитныеОрганизации", стрОтборКредитныеОрганизации);		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсключаяКредитныеОрганизации", стрОтборКредитныеОрганизации_НЕ);		
	
	// Отбор по банкротам
	Запрос.УстановитьПараметр("Банкроты", РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаБанкроты(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета));		
	
	
	Если СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета > '20220301'
		И НЕ БухгалтерскийУчет.ОпределитьНастройкуУчета(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.СчетДоверительногоУправления, "ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО") Тогда
		
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Истина);
	Иначе
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Ложь);
	КонецЕсли;	
	
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;
	
	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание51_11";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);		
	
	
КонецПроцедуры

// 51.12 
&НаСервере
Процедура ЗаполнитьРаздел_АнализФинансовыхОбязательствВРазрезеСроковНаОсновеНедискДенПотоковСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;

	// Шапка
	ТекРаздел.Области.ТекущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	// Расчетные поля
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	Запрос.МенеджерВременныхТаблиц = Неопределено;
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРеквизитовФормы.Организация, "ВалютаУчета"));
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	// Получение данных раздела
	Запрос.Текст = Запрос.Текст + ";" + Символы.ПС + "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""06"" КАК НомерСтроки,
		|	""03"" КАК НомерКолонки,
		|	НЕОПРЕДЕЛЕНО КАК АнализируемаяДата,
		|	вэУправленческий.СуммаРазвернутыйОстатокКт КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(&грКонецПериода, Счет.Код В (""60311"", ""60322""), , СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК вэУправленческий
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""06"",
		|	ВЫБОР
		|		КОГДА вэУправленческий.ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего))
		|			ТОГДА ""03""
		|		КОГДА вэУправленческий.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ""09""
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА НЕ вэУправленческий.ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего))
		|				И вэУправленческий.СчетДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА вэУправленческий.СчетДоверительногоУправления.ДатаРасторжения
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	вэУправленческий.СуммаРазвернутыйОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(&грКонецПериода, Счет.Код В (""47903""), , СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК вэУправленческий
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""06"",
		|	""03"",
		|	НЕОПРЕДЕЛЕНО,
		|	вэУправленческий.СуммаРазвернутыйОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&грКонецПериода,
		|			Счет.Код В (""47422""),
		|			,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Документ.СделкаРЕПО)
		|					ИЛИ ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Документ.Сделка)
		|						И ВЫРАЗИТЬ(Субконто2 КАК Документ.Сделка).ОтложенноеИсполнение)) КАК вэУправленческий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 15), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 15)
		|	КОНЕЦ КАК ПятнадцатьЛет,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 5), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 5)
		|	КОНЕЦ КАК ПятьЛет,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 3), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 3)
		|	КОНЕЦ КАК ТриГода,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 1), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, ГОД, 1)
		|	КОНЕЦ КАК Год,
		|	ВЫБОР
		|		КОГДА КОНЕЦПЕРИОДА(&КонецПериода, МЕСЯЦ) = КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, МЕСЯЦ, 3), МЕСЯЦ)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(&КонецПериода, МЕСЯЦ, 3)
		|	КОНЕЦ КАК ТриМесяца
		|ПОМЕСТИТЬ _Периоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.НомерКолонки <> НЕОПРЕДЕЛЕНО
		|			ТОГДА _ИтоговаяТаблица.НомерКолонки
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ПятнадцатьЛет
		|			ТОГДА ""08""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ПятьЛет
		|			ТОГДА ""07""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриГода
		|			ТОГДА ""06""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.Год
		|			ТОГДА ""05""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриМесяца
		|			ТОГДА ""04""
		|		ИНАЧЕ ""03""
		|	КОНЕЦ КАК НомерКолонки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА СУММА(_ИтоговаяТаблица.СуммаВВалютеУчета)
		|		ИНАЧЕ СУММА(_ИтоговаяТаблица.СуммаВВалютеУчета) * ЕСТЬNULL(КурсВалютыУчета.Курс, 1)
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыУчета
		|		ПО (КурсВалютыУчета.Валюта = &ВалютаУчета),
		|	_Периоды КАК _Периоды
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.НомерКолонки <> НЕОПРЕДЕЛЕНО
		|			ТОГДА _ИтоговаяТаблица.НомерКолонки
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ПятнадцатьЛет
		|			ТОГДА ""08""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ПятьЛет
		|			ТОГДА ""07""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриГода
		|			ТОГДА ""06""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.Год
		|			ТОГДА ""05""
		|		КОГДА _ИтоговаяТаблица.АнализируемаяДата > _Периоды.ТриМесяца
		|			ТОГДА ""04""
		|		ИНАЧЕ ""03""
		|	КОНЕЦ,
		|	КурсВалютыУчета.Курс";
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;

	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание51_12";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);		
	
КонецПроцедуры

// 51.13
&НаСервере
Процедура ЗаполнитьРаздел_АнализФинансовыхАктивовИФинансовыхОбязательствВРазрезеСроковСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО) КАК ПризнатьВыпускДефолтным
		|ПОМЕСТИТЬ _ДефолтныеЦБ
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
		|			&грКонецПериода,
		|			Организация = &Организация
		|				И Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПризнатьДефолтной)
		|				И Клиент В
		|					(ВЫБРАТЬ
		|						КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|					ИЗ
		|						РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&грКонецПериода, Организация = &Организация
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
