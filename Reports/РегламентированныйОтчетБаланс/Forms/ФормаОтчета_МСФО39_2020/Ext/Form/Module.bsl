// 55.2
&НаСервере
Процедура ЗаполнитьРаздел_МетодыОценкиИИсходныеДанныеУровня2Сервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("Организация", СтруктураРеквизитовФормы.Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", СтруктураРеквизитовФормы.Организация.ВалютаУчета);
	
	СчетаЦБ = Новый Массив;
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
	Запрос.УстановитьПараметр("СчетаЦБ", СчетаЦБ);
	
	АктивыСС = Новый Массив;
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
	АктивыСС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
	Запрос.УстановитьПараметр("АктивыСС", АктивыСС);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	СтоимостьПереоценки.Партия КАК Партия,
		|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии
		|ПОМЕСТИТЬ _ПереоценкаЦенныхБумаг
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(СтоимостьПереоценки.Период) КАК Период,
		|		СтоимостьПереоценки.Организация КАК Организация,
		|		СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		СтоимостьПереоценки.ЦельРасчета КАК ЦельРасчета,
		|		СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки
		|	ИЗ
		|		РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
