//55.4 
&НаСервере
Процедура ЗаполнитьРаздел_ИнформацияОСверкеИзмененийПоУровню3ИерархииСССервер(ТекРаздел, ИмяРаздела)
	// в МСФО 39 2020 СК есть аналог 66.4
	// при изменениии макета надо следить зя тем, чтобы адреса областей совпадали
	
	
	ТекРаздел.Области.Строка1.Значение = "Справедливая стоимость на " + Формат(СтруктураРеквизитовФормы.мДатаКонцаПрошлогоПериодаОтчета, "ДФ=dd.MM.yyyy"); 
	ТекРаздел.Области.Строка10.Значение = "Справедливая стоимость на " + Формат(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, "ДФ=dd.MM.yyyy"); 
	ТекРаздел.Области.Строка11.Значение = "Нереализованные доходы за вычетом расходов от переоценки, отраженные в составе прибыли или убытка за год, для активов, удерживаемых на " + Формат(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, "ДФ=dd.MM.yyyy"); 
	ТекРаздел.Области.ПериодОтчета.Значение = СтруктураРеквизитовФормы.СтрПериодОтчета; 
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("НачалоПериода", СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета);
	ПараметрыЗапроса.Вставить("КонецПериода", СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета);
	ПараметрыЗапроса.Вставить("Организация", СтруктураРеквизитовФормы.Организация);
	ПараметрыЗапроса.Вставить("СчетДоверительногоУправления", СтруктураРеквизитовФормы.СчетДоверительногоУправления);
	РезультатЗапроса = РаботаСОтчетами.ПолучитьДанныеОСверкеИзмененийПоУровнюИерархии3(ПараметрыЗапроса);
		
	ПоказателиОтчета = РезультатЗапроса._Показатели;
	
	Для каждого СтрокаРезультат Из ПоказателиОтчета Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;
	
	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание55_4";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);		
	
КонецПроцедуры

