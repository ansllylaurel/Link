		|					ТОГДА _РейтингиМеждународные.Шкала.ТипШкалы = ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.МеждународнаяНацВалюта)
		|				ИНАЧЕ _РейтингиМеждународные.Шкала.ТипШкалы = ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.МеждународнаяИнВалюта)
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Рейтинги КАК _РейтингиНациональные
		|		ПО _Расчеты.УК = _РейтингиНациональные.Субъект
		|			И (_РейтингиМеждународные.Субъект ЕСТЬ NULL
		|				ИЛИ _РейтингиМеждународные.СтрокаСопоставления = 5)
		|			И (_РейтингиНациональные.Шкала.Владелец = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.RAEX)
		|				ИЛИ _РейтингиНациональные.Шкала.Владелец = ЗНАЧЕНИЕ(Справочник.РейтинговыеАгентства.АКРА))
		|			И (_РейтингиНациональные.Шкала.ТипШкалы = ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.Национальная))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 1
		|			ТОГДА ""02""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 2
		|			ТОГДА ""03""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 3
		|			ТОГДА ""04""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 4
		|			ТОГДА ""05""
		|		ИНАЧЕ ""06""
		|	КОНЕЦ КАК НомерКолонки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА СУММА(_ИтоговаяТаблица.Сумма)
		|		ИНАЧЕ СУММА(_ИтоговаяТаблица.Сумма * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1))
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
		|		ПО (&ВалютаУчета = КурсВалютыПроводки.Валюта)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.НомерСтроки,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 1
		|			ТОГДА ""02""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 2
		|			ТОГДА ""03""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 3
		|			ТОГДА ""04""
		|		КОГДА _ИтоговаяТаблица.Рейтинг = 4
		|			ТОГДА ""05""
		|		ИНАЧЕ ""06""
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("КонтрагентНКЦ", ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
	Запрос.УстановитьПараметр("БрокерыКредитныеОрганизации", ПолучитьМассивБрокеровКредитныхОрганизаций());

	Если ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС = Неопределено ИЛИ НЕ ЭтаФорма.НастройкиОтчета.НеУчитыватьПроцентыМНОВДС Тогда
		Запрос.УстановитьПараметр("МНОэтоДепозит", Истина);
	Иначе	
		Запрос.УстановитьПараметр("МНОэтоДепозит", Ложь);
	КонецЕсли;
	
	Если ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС <> Неопределено И ЭтаФорма.НастройкиОтчета.УчитыватьБрокерскиеСчетаВДС Тогда
		Запрос.УстановитьПараметр("БрокерЭтоДС", Истина);
	Иначе
		Запрос.УстановитьПараметр("БрокерЭтоДС", Ложь);
	КонецЕсли;
	
	Если СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета > '20220301'
		И НЕ БухгалтерскийУчет.ОпределитьНастройкуУчета(СтруктураРеквизитовФормы.мДатаКонцаПериодаОтчета, СтруктураРеквизитовФормы.Организация, СтруктураРеквизитовФормы.СчетДоверительногоУправления, "ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО") Тогда
		
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Истина);
	Иначе
		Запрос.УстановитьПараметр("КомиссияРЕПОПоКонтрагенту", Ложь);
	КонецЕсли;	
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + СтрокаРезультат.НомерКолонки, СтрокаРезультат.Сумма);
	КонецЦикла;
	
	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание51_5";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);		
	
КонецПроцедуры

