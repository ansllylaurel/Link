// 14.1
&НаСервере
Процедура ЗаполнитьРаздел_ИнвестицииВДочерниеПредприятияСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	УстановитьТекстЗапросаДляПолученияВременныхТаблиц(Запрос);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ Клиенты
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо КАК ЮридическоеЛицо
		|ПОМЕСТИТЬ ДочерниеЭмитенты
		|ИЗ
		|	Клиенты КАК Клиенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&КонецПериода, ) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Клиенты.Клиент = СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&УК_РВМКапитал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка КАК ДочернееПредприятие,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток, 0) КАК Сумма,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиПП.СтоимостьВВалютеУчетаОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстаткиПП.ПереоценкаВВалютеУчетаОстаток, 0) КАК СуммаПП,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.Код КАК СтранаРегистрации,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.КоличествоОстаток, 0) / ЕСТЬNULL(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).РазмерЭмиссииШт, 1) * 100 КАК Процент,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиПП.КоличествоОстаток, 0) / ЕСТЬNULL(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиПП.ЦеннаяБумага КАК Справочник.Акции).РазмерЭмиссииШт, 1) * 100 КАК ПроцентПП
		|ИЗ
		|	ДочерниеЭмитенты КАК ДочерниеЭмитенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&грКонецПериода,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И (Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК БухПартииЦенныхБумагОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|			ПО (ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка = БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|				ИНАЧЕ ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка = РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&грКонецПредыдущегоПериода,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И (Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК БухПартииЦенныхБумагОстаткиПП
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследнихПП
		|			ПО (ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиПП.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследнихПП.ПаевойИнвестиционныйФонд)
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиПП.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка = БухПартииЦенныхБумагОстаткиПП.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|				ИНАЧЕ ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка = РеквизитыПИФСрезПоследнихПП.УправляющаяКомпания.ЮрФизЛицо
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&грКонецПериода, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ДочерниеЭмитенты.ЮридическоеЛицо.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток, 0) <> 0
		|			ИЛИ ЕСТЬNULL(БухПартииЦенныхБумагОстаткиПП.СтоимостьВВалютеУчетаОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстаткиПП.ПереоценкаВВалютеУчетаОстаток, 0) <> 0)";
	
	// #ТЕХНИЧЕСКИЙДОЛГ
	Если СокрЛП(СтруктураРеквизитовФормы.СчетДоверительногоУправления.КодСчета) = "DU_NPF315" Тогда
		Запрос.УстановитьПараметр("УК_РВМКапитал", ОбщегоНазначения.ПолучитьИменованныйОбъект("УК_РВМКапитал"));
	Иначе
		Запрос.УстановитьПараметр("УК_РВМКапитал", Справочники.ЮрФизЛица.ПустаяСсылка());
	КонецЕсли;
	
	Инд = 0;
	ИтоговаяСумма = 0;
	ИтоговаяСуммаПП = 0;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Инд = Инд + 1;
		Если Инд <= 3 Тогда
			УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "01", ВыборкаДетальныеЗаписи.ДочернееПредприятие);			
			УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "02", ВыборкаДетальныеЗаписи.Сумма);
			//УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "03", ВыборкаДетальныеЗаписи.Процент);
			УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "04", ВыборкаДетальныеЗаписи.СуммаПП);
			//УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "05", ВыборкаДетальныеЗаписи.ПроцентПП);
			УстановитьЗначениеПоказателя(ТекРаздел, "П0" + СокрЛП(Инд)+ "06", ВыборкаДетальныеЗаписи.СтранаРегистрации);
		КонецЕсли;
		ИтоговаяСумма = ИтоговаяСумма + ВыборкаДетальныеЗаписи.Сумма;
		ИтоговаяСуммаПП = ИтоговаяСуммаПП + ВыборкаДетальныеЗаписи.СуммаПП;
	КонецЦикла;
	УстановитьЗначениеПоказателя(ТекРаздел, "П0402", ИтоговаяСумма);
	УстановитьЗначениеПоказателя(ТекРаздел, "П0404", ИтоговаяСуммаПП);
	
	Если Инд > 3 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество дочерних организаций больше 3х! Показаны только первые 3!");
	КонецЕсли;

	КлючПараметровПечати = "Отчет.РегламентированныйОтчетБаланс.ФормаОтчета_МСФО39_2020.Примечание14_1";
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТекРаздел, КлючПараметровПечати, , ОриентацияСтраницы.Ландшафт);			
	
КонецПроцедуры

// 20
&НаСервере
Процедура ЗаполнитьРаздел_ПрочиеАктивыСервер(ТекРаздел, ИмяРаздела)
	
	мИмяЗаполняемогоРаздела = ИмяРаздела;
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	ТекРаздел.Области.ТекущийПериод.Значение    = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	ТекРаздел.Области.ПредыдущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеПредыдущегоПериода;
	

