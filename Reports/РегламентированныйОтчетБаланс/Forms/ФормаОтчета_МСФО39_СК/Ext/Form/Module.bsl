	ТекРаздел.Области.ТекущийПериод.Значение = СтруктураРеквизитовФормы.мПредставлениеТекущегоПериода;
	
	// Расчетные поля
	Запрос = ПодготовитьВременныеТаблицыДокумента();
	
	мТаблицаСчетов = ПолучитьИзВременногоХранилища(Адрес_мТаблицаСчетов);
	
	мТаблицаСчетов.Очистить();
	ДобавитьСчетВТаблицуСчетов("П0903", "Расчеты по начисленным доходам по акциям, долям, паям (просроченные)", "+", "!СКД", "60347", "Сальдо на конец периода #Период# по дебету счета 60347");
	ЗаполнитьРазделПоСпискуСчетовЗаПериод(Запрос, "НаКонец", "ЗаТекущийПериод", ТекРаздел);	
	
