&НаСервере
Процедура РасчетРаздела_ДенежныеСредства(ТекРаздел, ИмяРаздела)
	
	Для НомКол = 2 По 3 Цикл
		
		СтрНомКол = "0" + НомКол;
		
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П01" + СтрНомКол, );
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П02" + СтрНомКол, );
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П03" + СтрНомКол, );
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П04" + СтрНомКол, );
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П05" + СтрНомКол, );
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П07" + СтрНомКол, ТекРаздел, "П06" + СтрНомКол, );
		
	КонецЦикла;	
	
	// Чистим прошлый год если не сначала года
	Если СтруктураРеквизитовФормы.НестандартныйПериод
		И СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета <> НачалоГода(СтруктураРеквизитовФормы.мДатаНачалаПериодаОтчета) Тогда
	
		Для НомСтр = 1 По 7 Цикл
			Ячейка = ТекРаздел.Области["П" + Прав("0" + НомСтр, 2) + "03"];
			Ячейка.Значение = 0;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

