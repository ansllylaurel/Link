// 67.1 
&НаСервере
Процедура РасчетРаздела_ФинансовыеИнструментыПодлежащиеВзаимозачетуСК(ТекРаздел, ИмяРаздела)
	
	Для НомСтр = 2 По 11 Цикл
		Если НомСтр = 8 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрНомСтр = Формат(НомСтр, "ЧЦ=2; ЧВН=");
		
		МассивЯчеек = Новый Массив;
		Для НомКол = 3 По 7 Цикл
			МассивЯчеек.Добавить("П" + СтрНомСтр + Формат(НомКол, "ЧЦ=2; ЧВН="));	
		КонецЦикла;
		
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П" + СтрНомСтр + "08", ТекРаздел, МассивЯчеек, 1);
	КонецЦикла;

	Для НомКол = 3 По 8 Цикл
		СтрНомКол = Формат(НомКол, "ЧЦ=2; ЧВН=");
		
		МассивЯчеек = Новый Массив;
		Для НомСтр = 2 По 7 Цикл
			МассивЯчеек.Добавить("П" + Формат(НомСтр, "ЧЦ=2; ЧВН=") + СтрНомКол);	
		КонецЦикла;
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П01" + СтрНомКол, ТекРаздел, МассивЯчеек, 1);
		
		МассивЯчеек = Новый Массив;
		Для НомСтр = 9 По 11 Цикл
			МассивЯчеек.Добавить("П" + Формат(НомСтр, "ЧЦ=2; ЧВН=") + СтрНомКол);	
		КонецЦикла;
		ДобавитьЗначениеВИтоговуюЯчейку(ИмяРаздела, ТекРаздел, "П08" + СтрНомКол, ТекРаздел, МассивЯчеек, 1);
	КонецЦикла;	

КонецПроцедуры

