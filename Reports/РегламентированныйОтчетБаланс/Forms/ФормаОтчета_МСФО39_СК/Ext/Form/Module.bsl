		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СрезПоследних(&грКонецПериода, ) КАК ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ПереопределениеКлассификацииУчетныхАктивовЦБСрезПоследних.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ПереопределенияАктивов.НовыйУчетныйАктивЦБ, _ИтоговаяТаблицаПредварительная.УчетныйАктивЦБРФ) КАК УчетныйАктивЦБРФ,
		|	_ИтоговаяТаблицаПредварительная.Сумма КАК Сумма,
		|	_ИтоговаяТаблицаПредварительная.ЭтоОблигации КАК ЭтоОблигации,
		|	_ИтоговаяТаблицаПредварительная.ВидЦены КАК ВидЦены,
		|	_ИтоговаяТаблицаПредварительная.Источник КАК Источник,
		|	_ИтоговаяТаблицаПредварительная.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_ИтоговаяТаблицаПредварительная КАК _ИтоговаяТаблицаПредварительная
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределенияАктивов КАК ПереопределенияАктивов
		|		ПО _ИтоговаяТаблицаПредварительная.УчетныйАктивЦБРФ = ПереопределенияАктивов.ИсходныйУчетныйАктивЦБ
		|			И _ИтоговаяТаблицаПредварительная.Эмитент = ПереопределенияАктивов.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АкцииБанковНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АкцииБанковНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИБанков), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИБанков))
		|			ТОГДА ""005""
		|		КОГДА НЕ _ИтоговаяТаблица.ЭтоОблигации
		|				И _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИ), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИ), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПаиФондов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПаиФондовНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.Иное), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПрочиеАкцииНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПрочиеАкцииНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПустаяСсылка))
		|			ТОГДА ВЫБОР
		|					КОГДА _ИтоговаяТаблица.Эмитент В (&ФинансовыеОрганизацииТП)
		|						ТОГДА ""006""
		|					ИНАЧЕ ""007""
		|				КОНЕЦ
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства))
		|			ТОГДА ""008""
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные))
		|			ТОГДА ""009""
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииИностранныхГосударств))
		|			ТОГДА ""010""
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов))
		|			ТОГДА ""011""
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЦБРФ В (ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентовНеБумаги), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.Иное), ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ПустаяСсылка))
		|			ТОГДА ВЫБОР
		|					КОГДА _ИтоговаяТаблица.Эмитент В (&ФинансовыеОрганизацииТП)
		|						ТОГДА ""012""
		|					ИНАЧЕ ""013""
		|				КОНЕЦ
		|	КОНЕЦ КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА &ВалютаУчета = &ВалютаДокумента
		|			ТОГДА _ИтоговаяТаблица.Сумма
		|		ИНАЧЕ _ИтоговаяТаблица.Сумма * ЕСТЬNULL(КурсВалютыПроводки.Курс, 1)
		|	КОНЕЦ КАК _02,
		|	_ИтоговаяТаблица.ВидЦены КАК _03,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК _04
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ КоэффициентыВалютТП КАК КурсВалютыПроводки
		|		ПО (&ВалютаУчета = КурсВалютыПроводки.Валюта)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ИтоговаяТаблица.Источник = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	_ИтоговаяТаблица.Сумма <> 0";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРезультат Из Результат Цикл
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + "02", СтрокаРезультат._02);
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + "03", СтрокаРезультат._03);
		УстановитьЗначениеПоказателя(ТекРаздел, "П" + СтрокаРезультат.НомерСтроки + "04", СтрокаРезультат._04);
	КонецЦикла;
	
КонецПроцедуры

