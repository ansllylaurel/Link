#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
КонецПроцедуры


#КонецОбласти

#Область СобытияРеквизитовФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	Диалог.Каталог            	= Отчет.ИмяФайла; 
	Диалог.Фильтр				= "Файл XML (*.xml)|*.xml";
	Диалог.МножественныйВыбор 	= Ложь; 
	Диалог.Заголовок          	= "Выберите файл"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет.ИмяФайла = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Отчет.ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	Если НЕ ПроверкаЗаполнения() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаИмпортировать");
	
	Попытка
		ВыполнитьИмпортФайла(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не загружен. " + ПараметрыСессии.ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИмпортФайла(ПараметрыСессии)
	
	Период         = "";
	МассивСтрок    = Новый Массив;
	ДвоичныеДанные = "";
	
	Если НЕ ПрочитатьФайл(Период, МассивСтрок, ДвоичныеДанные) Тогда
		ПараметрыСессии.ТекстОшибки = "Файл не прочитан";
		Возврат;
	КонецЕсли;
	
	МассивПолногоИмениФайла = СтрРазделить(Отчет.ИмяФайла, "\", Ложь);
	ИмяФайла = МассивПолногоИмениФайла[МассивПолногоИмениФайла.Количество() - 1];
	ШаблонИмениФайла = ВРЕГ("CB_ES550P_" + Формат(Период, "ДФ=yyyyMMdd") + "_");
	
	Если НЕ ПроверкаИмениФайла(Период) Тогда
		ПараметрыСессии.ТекстОшибки = "Имя файла не соответствует формату: " + ШаблонИмениФайла + "_XXX.xml";
		Возврат;
	КонецЕсли;
	
	Если ФайлУжеЗагружался() Тогда
		Если Вопрос("Файл с таким именем уже загружался. Всё равно загрузить?", РежимДиалогаВопрос.ДаНет, 60) <> КодВозвратаДиалога.Да Тогда
			ПараметрыСессии.ТекстОшибки = "Файл """ + ИмяФайла + """ уже загружался — пользователь отказался от повторной загрузки";
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда
		ПараметрыСессии.ТекстОшибки = "Файл пустой";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл пустой!");
		Возврат;
	КонецЕсли;
	
	СохранитьДанныеВExternals(Период, МассивСтрок, ДвоичныеДанные);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл загружен");
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаИмениФайла(Период)
	
	МассивПолногоИмениФайла = СтрРазделить(Отчет.ИмяФайла, "\", Ложь);
	ИмяФайла = МассивПолногоИмениФайла[МассивПолногоИмениФайла.Количество() - 1];
	
	ШаблонИмениФайла = ВРЕГ("CB_ES550P_" + Формат(Период, "ДФ=yyyyMMdd") + "_");
	Если НЕ СтрНачинаетсяС(ВРЕГ(ИмяФайла), ШаблонИмениФайла) ИЛИ ВРЕГ(Прав(ИмяФайла, 4)) <> ВРЕГ(".xml") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Имя файла не соответствует формату: " + ШаблонИмениФайла + "_XXX.xml");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ФайлУжеЗагружался()
	
	УжеЗагружался = Ложь;
	
	СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
	
	МассивПолногоИмениФайла = СтрРазделить(Отчет.ИмяФайла, "\", Ложь);
	ИмяФайла = МассивПолногоИмениФайла[МассивПолногоИмениФайла.Количество() - 1];
	
	УникальныйИдентификаторОрганизации = Строка(Отчет.Организация.УникальныйИдентификатор());
	
	ТекстЗапроса =
		"SELECT TOP (1) 
		|	[Id]
		|FROM 
		|	[Externals].[dbo].[Files]
		|Where 
		|	[File_Name] = '&ИмяФайла'
		|	AND [Organization] = '&Organization'";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяФайла"		, ИмяФайла);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Organization"	, УникальныйИдентификаторОрганизации);
	
	НаборЗаписей = Соединение.Execute(ТекстЗапроса);
	
	УжеЗагружался = НЕ (НаборЗаписей.EOF И НаборЗаписей.BOF); 
	
	НаборЗаписей = "";
	
	Возврат УжеЗагружался;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьФайл(Период, МассивСтрок, ДвоичныеДанные)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(Отчет.ИмяФайла);
	
	ДанныеXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	СвойстваОбъекта = ДанныеXDTO.Свойства();
	
	ОбщиеДанные = Новый Структура;
	
	Если СвойстваОбъекта.Получить("СлужЧасть") <> Неопределено Тогда
		Период = ДатаИзДДММГГГГ(ДанныеXDTO.СлужЧасть.ДатаСообщения);
		ОбщиеДанные.Вставить("Period", Период);
	КонецЕсли;
	
	Если СвойстваОбъекта.Получить("ИнформЧасть") <> Неопределено Тогда
		Если ТипЗнч(ДанныеXDTO.ИнформЧасть.Раздел2) = Тип("ОбъектXDTO") Тогда
			ПрочитатьРаздел2(ДанныеXDTO.ИнформЧасть.Раздел2, МассивСтрок, ДвоичныеДанные, ОбщиеДанные);
		Иначе
			Для Каждого СтрокаРаздела2 Из ДанныеXDTO.ИнформЧасть.Раздел2 Цикл
				ПрочитатьРаздел2(СтрокаРаздела2, МассивСтрок, ДвоичныеДанные, ОбщиеДанные);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(Отчет.ИмяФайла);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПрочитатьРаздел2(СтрокаРаздела2, МассивСтрок, ДвоичныеДанные, ОбщиеДанные)
	
	Если ТипЗнч(СтрокаРаздела2.Участник) = Тип("СписокXDTO") Тогда
		Для Каждого УчастникXDTO Из СтрокаРаздела2.Участник Цикл
			ДобавитьДанныеЮрФизЛица(УчастникXDTO, МассивСтрок, ОбщиеДанные);
		КонецЦикла;
	Иначе
		ДобавитьДанныеЮрФизЛица(СтрокаРаздела2.Участник, МассивСтрок, ОбщиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДанныеЮрФизЛица(УчастникXDTO, МассивСтрок, ОбщиеДанные)
	
	РеквизитыЮрФизЛицаСтрокой = "Is_Firm,Name,LastName,FirstName,MiddleName,BirthDate,INN,RegistrationNumber,Period,LegalAddress,PlaceOfBirth";
	СтруктураNull = Новый Структура(РеквизитыЮрФизЛицаСтрокой, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null);
	
	СвойстваУчастника	= УчастникXDTO.Свойства();
	
	Если СвойстваУчастника.Получить("СведФЛИП") <> Неопределено Тогда
		СведФЛИП = УчастникXDTO.СведФЛИП;
		
		ДанныеЮрФизЛица = Новый Структура(РеквизитыЮрФизЛицаСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, СтруктураNull);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, ОбщиеДанные);
		
		ДанныеЮрФизЛица.Is_Firm = 0;
		
		ФИО = Новый Структура("Фам,Имя,Отч");
		ЗаполнитьЗначенияСвойств(ФИО, СведФЛИП.ФИОФЛИП);
		
		Фамилия		= ТРег(ФИО.Фам);
		Имя			= ТРег(ФИО.Имя);
		Отчество	= ТРег(ФИО.Отч);
		
		ДанныеЮрФизЛица.Name		= Фамилия + " " + Имя + " " + Отчество;
		ДанныеЮрФизЛица.LastName	= Фамилия;
		ДанныеЮрФизЛица.FirstName	= Имя;
		ДанныеЮрФизЛица.MiddleName	= Отчество;
		
		Если СведФЛИП.Свойства().Получить("ДатаРождения") <> Неопределено Тогда
			ДанныеЮрФизЛица.BirthDate	= ДатаИзДДММГГГГ(СведФЛИП.ДатаРождения);
		КонецЕсли;
		
		ДанныеЮрФизЛица.INN			= ПреобразоватьXDTOКСтроке(СведФЛИП.ИННФЛИП);
		
		ДанныеЮрФизЛица.RegistrationNumber = ПреобразоватьXDTOКСтроке(СведФЛИП.СведДокУдЛичн.СерияДок) + ПреобразоватьXDTOКСтроке(СведФЛИП.СведДокУдЛичн.НомДок);
		
		МассивСтрок.Добавить(ДанныеЮрФизЛица);
		
	ИначеЕсли СвойстваУчастника.Получить("СведЮЛ") <> Неопределено Тогда
		СведЮЛ = УчастникXDTO.СведЮЛ;
		
		ДанныеЮрФизЛица = Новый Структура(РеквизитыЮрФизЛицаСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, СтруктураNull);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, ОбщиеДанные);
		
		ДанныеЮрФизЛица.Is_Firm = 1;
		
		ДанныеЮрФизЛица.Name				= ПреобразоватьXDTOКСтроке(СведЮЛ.НаимЮЛ);
		ДанныеЮрФизЛица.RegistrationNumber	= ПреобразоватьXDTOКСтроке(СведЮЛ.ОГРНЮЛ);
		ДанныеЮрФизЛица.INN					= ПреобразоватьXDTOКСтроке(СведЮЛ.ИННЮЛ);
		
		МассивСтрок.Добавить(ДанныеЮрФизЛица);
		
	Иначе
		Пер = Ложь;
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьXDTOКСтроке(Значение)
	
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		Возврат "";
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ДатаИзДДММГГГГ(Значение)
	
	МассивЧастейДаты = СтрРазделить(Значение, "/");
	Возврат Дата(МассивЧастейДаты[2], МассивЧастейДаты[1], МассивЧастейДаты[0]);
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполнения()
	
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ИмяФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Имя файла"" не заполнено",,, "КаталогДанных", Отказ);
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервере
Процедура СохранитьДанныеВExternals(Период, МассивСтрок, ДвоичныеДанные)
	
	ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(Отчет.ИмяФайла);
	ДанныеФайла.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	
	РаботаСВнешнимиСистемами.СохранитьСписокДляСверкиВExternals(Отчет.Организация, 6, Период, МассивСтрок, ДанныеФайла);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьИмпортированныеСпискиНаСервере()
	
	ЭтаФорма.ИмпортированныеСписки.Очистить();
	
	УникальныйИдентификаторОрганизации = Строка(Отчет.Организация.УникальныйИдентификатор());
	Source_Id = 6;
	
	СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("ИмяФайла"		, Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ДатаИмпорта"	, Новый ОписаниеТипов("Дата"));
	
	ТекстЗапроса = 
		"SELECT 
		|	Files.File_Name AS ИмяФайла,
		|	MAX(Files.Upload_Time) AS ДатаИмпорта
		|FROM
		|	[Externals].[dbo].[Files] AS Files
		|Where
		|	[Organization] = '&Organization'
		|	AND [Source_Id] = &Source_Id
		|GROUP BY
		|	[File_Name]
		|ORDER BY
		|	MAX(Files.Upload_Time)";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Organization"	, УникальныйИдентификаторОрганизации);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Source_Id"		, Source_Id);
	
	РезультатЗапроса = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
	
	Если РезультатЗапроса <> Неопределено Тогда
		ЭтаФорма.ИмпортированныеСписки.Загрузить(РезультатЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИмпортированныеСписки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОбновитьИмпортированныеСписки");
	
	Попытка
		ОбновитьИмпортированныеСпискиНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось обновить список импортированных файлов. " + ПараметрыСессии.ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	РеквизитФормыОтчет = РеквизитФормыВЗначение("Отчет");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(РеквизитФормыОтчет);
	
	Механизм = РеквизитФормыОтчет.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм", 	 Механизм);
	ПараметрыСессии.Вставить("Сессия", 		 Сессия);
	ПараметрыСессии.Вставить("ДопПараметры", Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",  Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, 
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);	
	
КонецПроцедуры

#КонецОбласти
