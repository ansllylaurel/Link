&НаСервере
Функция СоздатьТаблицуСроков(вхДата)    
	
	ЧислоГод = Год(вхДата);
	
//  226.1 НК 
//   9. Если иное не установлено статьями 214.6 и 214.9 настоящего Кодекса, налоговые агенты обязаны перечислять суммы исчисленного и удержанного 
//   налога за период с 1-го по 22-е число текущего месяца не позднее 28-го числа текущего месяца, за период с 23-го числа по последнее число текущего
//   месяца - не позднее 5-го числа следующего месяца, а за период с 23 по 31 декабря - не позднее последнего рабочего дня текущего года.
	
	
	ТаблицаСроков = Новый ТаблицаЗначений;
	ТаблицаСроков.Колонки.Добавить("Квартал", Новый ОписаниеТипов("Число"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода1", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода2", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода3", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода4", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода5", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("НачалоПериода6", Новый ОписаниеТипов("Дата")); 
	
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты1", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты2", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты3", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты4", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты5", Новый ОписаниеТипов("Дата"));
	ТаблицаСроков.Колонки.Добавить("ПериодОплаты6", Новый ОписаниеТипов("Дата"));
	
	ЧислоМесяц = 0;
	Для Квартал = 1 по 4 Цикл 
		НоваяСтрока = ТаблицаСроков.Добавить();
		НоваяСтрока.Квартал = Квартал;
		
		НомерПериода = 0;
		Для Месяц = 1 по 3 Цикл
			ЧислоМесяц = ЧислоМесяц + 1;
			Для ПолуМесяц = 1 по 2 Цикл
				НомерПериода = НомерПериода + 1; 
				Если ПолуМесяц = 1 Тогда 
					ЧислоДата = 1; 
					ЧислоДатаОплата = 28;
					ЧислоМесяцОплата = ЧислоМесяц;
				Иначе
					ЧислоДата = 23;
					Если Квартал = 4 и Месяц = 3 Тогда 
						ЧислоДатаОплата = 31;
						ЧислоМесяцОплата = ЧислоМесяц;
					Иначе
						ЧислоДатаОплата = 5;
						ЧислоМесяцОплата = ЧислоМесяц + 1;
					КонецЕсли;
				КонецЕсли;    
				НоваяСтрока["НачалоПериода" + НомерПериода] = Дата(ЧислоГод, ЧислоМесяц, ЧислоДата);  
				НоваяСтрока["ПериодОплаты" + НомерПериода] = Дата(ЧислоГод, ЧислоМесяцОплата, ЧислоДатаОплата); 
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;    
	
	Возврат ТаблицаСроков;
	
КонецФункции

&НаСервере
Процедура СформироватьНаСервере(ДокументРезультат, Документ6НДФЛ)
	
	Перем Запрос;
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию();
	
	Попытка
	
	ДокументРезультат.Очистить(); 
	Документ6НДФЛ.Очистить();

	ЗаполнитьВременныеТаблицы(Запрос); 
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	_ДанныеДляОтчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеДляОтчета.ВидДоговора КАК ВидДоговора,
		|	_ДанныеДляОтчета.Клиент КАК Клиент,
		|	_ДанныеДляОтчета._110 КАК _110,
		|	_ДанныеДляОтчета.СтавкаНДФЛ КАК СтавкаНДФЛ,
		|	_ДанныеДляОтчета.КБК КАК КБК,
		|	_ДанныеДляОтчета.ЭтоДивиденды КАК ЭтоДивиденды,
		|	_ДанныеДляОтчета.ДатаВыплатыДохода КАК ДатаВыплатыДохода,
		|	_ДанныеДляОтчета.ДатаОплатыФакт КАК ДатаОплатыФакт,
		|	_ДанныеДляОтчета._020 КАК _020,
		|	_ДанныеДляОтчета._021 КАК _021,
		|	_ДанныеДляОтчета._022 КАК _022,
		|	_ДанныеДляОтчета._023 КАК _023,
		|	_ДанныеДляОтчета._024 КАК _024,
		|	_ДанныеДляОтчета._025 КАК _025,
		|	_ДанныеДляОтчета._026 КАК _026,
		|	_ДанныеДляОтчета._030 КАК _030,
		|	_ДанныеДляОтчета._031 КАК _031,
		|	_ДанныеДляОтчета._032 КАК _032,
		|	_ДанныеДляОтчета._033 КАК _033,
		|	_ДанныеДляОтчета._034 КАК _034,
		|	_ДанныеДляОтчета._035 КАК _035,
		|	_ДанныеДляОтчета._036 КАК _036,
		|	_ДанныеДляОтчета._120 КАК _120,
		|	_ДанныеДляОтчета._130 КАК _130,
		|	_ДанныеДляОтчета._131 КАК _131,
		|	_ДанныеДляОтчета._140 КАК _140,
		|	_ДанныеДляОтчета._155 КАК _155,
		|	_ДанныеДляОтчета._160 КАК _160,
		|	_ДанныеДляОтчета._161 КАК _161,
		|	_ДанныеДляОтчета._162 КАК _162,
		|	_ДанныеДляОтчета._163 КАК _163,
		|	_ДанныеДляОтчета._164 КАК _164,
		|	_ДанныеДляОтчета._165 КАК _165,
		|	_ДанныеДляОтчета._166 КАК _166
		|ИЗ
		|	_ДанныеДляОтчета КАК _ДанныеДляОтчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭтоДивиденды,
		|	ВидДоговора УБЫВ,
		|	КБК,
		|	ДатаВыплатыДохода
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _110),
		|	МАКСИМУМ(КБК),
		|	СУММА(_020),
		|	СУММА(_021),
		|	СУММА(_022),
		|	СУММА(_023),
		|	СУММА(_024),
		|	СУММА(_025),
		|	СУММА(_026),
		|	СУММА(_030),
		|	СУММА(_031),
		|	СУММА(_032),
		|	СУММА(_033),
		|	СУММА(_034),
		|	СУММА(_035),
		|	СУММА(_036),
		|	СУММА(_120),
		|	СУММА(_130),
		|	СУММА(_131),
		|	СУММА(_140),
		|	СУММА(_155),
		|	СУММА(_160),
		|	СУММА(_161),
		|	СУММА(_162),
		|	СУММА(_163),
		|	СУММА(_164),
		|	СУММА(_165),
		|	СУММА(_166)
		|ПО
		|	ЭтоДивиденды,
		|	ВидДоговора,
		|	СтавкаНДФЛ";
	
	
	Макет = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("Свод");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка"); 
	ОбластьСтрокаПрошлыйГод = Макет.ПолучитьОбласть("СтрокаПрошлыйГод"); 
	ОбластьИтог = Макет.ПолучитьОбласть("Итог"); 
	
	
	ТаблицаКоличестваФЛ = Новый ТаблицаЗначений;
	ТаблицаКоличестваФЛ.Колонки.Добавить("КБК");
	ТаблицаКоличестваФЛ.Колонки.Добавить("Количество");
	
	ВыборкаДивиденды = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДивиденды.Следующий() Цикл 
		ВыборкаВидДоговора = ВыборкаДивиденды.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидДоговора.Следующий() Цикл
			ВыборкаСтавкиНДФЛ = ВыборкаВидДоговора.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			Пока ВыборкаСтавкиНДФЛ.Следующий() Цикл  
				
				ОбластьШапка.Параметры.Период = ПредставлениеПериода(Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания, "ФП = Истина"); 
				ОбластьШапка.Параметры.ВидДоговора = ВыборкаСтавкиНДФЛ.ВидДоговора;
				ОбластьШапка.Параметры.СтавкаНДФЛ = ВыборкаСтавкиНДФЛ.СтавкаНДФЛ;
				ОбластьШапка.Параметры.КБК = ВыборкаСтавкиНДФЛ.КБК;
				ДокументРезультат.Вывести(ОбластьШапка);
				
				ДокументРезультат.НачатьГруппуСтрок(, Ложь);
				
				МассивФизлица = Новый Массив; 
				ВыборкаКлиенты = ВыборкаСтавкиНДФЛ.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока ВыборкаКлиенты.Следующий() Цикл
					Если ВыборкаКлиенты.ДатаВыплатыДохода < НачалоГода(Отчет.Период.ДатаНачала) Тогда
						ЗаполнитьЗначенияСвойств(ОбластьСтрокаПрошлыйГод.Параметры, ВыборкаКлиенты); 
						ОбластьСтрокаПрошлыйГод.Параметры.КоличествоФизлиц = 0;
						ДокументРезультат.Вывести(ОбластьСтрокаПрошлыйГод); 
					Иначе   
						Если МассивФизлица.Найти(ВыборкаКлиенты._110) = Неопределено Тогда 
							МассивФизлица.Добавить(ВыборкаКлиенты._110);
							КоличествоФизлиц = 1;
						Иначе
							КоличествоФизлиц = 0;
						КонецЕсли;  
						ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаКлиенты); 
						ОбластьСтрока.Параметры.КоличествоФизлиц = КоличествоФизлиц;
						ДокументРезультат.Вывести(ОбластьСтрока); 
					КонецЕсли;
				КонецЦикла; 
				ДокументРезультат.ЗакончитьГруппуСтрок();
				
				ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаСтавкиНДФЛ); 
				ОбластьИтог.Параметры.КоличествоФизлиц = МассивФизлица.Количество();
				ДокументРезультат.Вывести(ОбластьИтог);       
				
				НоваяСтрока = ТаблицаКоличестваФЛ.Добавить();
				НоваяСтрока.КБК = ВыборкаСтавкиНДФЛ.КБК;
				НоваяСтрока.Количество = МассивФизлица.Количество();
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;                   
	
	ДокументРезультат.Область(, 5, ,10).Сгруппировать();
	ДокументРезультат.Область(, 12, ,17).Сгруппировать();
	ДокументРезультат.Область(, 26, ,31).Сгруппировать();
	ДокументРезультат.ПоказатьУровеньГруппировокКолонок(0);
	
	ТаблицаКоличестваФЛ.Свернуть("КБК", "Количество");
	
	//по каждому КБК строим отчет.  В запросе данные уже свернуты по КБК и ставке
	//ДанныеДля6НДФЛ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Для6НДФЛ").ПолучитьДанные().Выгрузить();
	Заполнить6НДФЛ(Запрос.МенеджерВременныхТаблиц, Документ6НДФЛ, ТаблицаКоличестваФЛ);
	
	Исключение
		ПараметрыСессииСбораСтатистики.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
		ВызватьИсключение;
	КонецПопытки;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаСервере
Процедура Заполнить6НДФЛ(МенеджерВременныхТаблиц, Документ6НДФЛ, ТаблицаКоличестваФЛ) 
	
	МакетТитульнаяСтраница = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ТитульнаяСтраница");
	МакетРаздел1 = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("Раздел1");
	МакетРаздел2 = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("Раздел2");
	
	ОбластьТитульнаяСтраница = МакетТитульнаяСтраница.ПолучитьОбласть("ОсновнаяЧасть");
	ОбластьРаздел1 = МакетРаздел1.ПолучитьОбласть("ОсновнаяЧасть");
	ОбластьРаздел2 = МакетРаздел2.ПолучитьОбласть("ОсновнаяЧасть");
	
	// Заполнение Титульной страницы  
	// тягаем три виртуальные таблицы. Нам они нужны для выгрузки в xml 
	ТаблицаРеквизитыОрганизации = МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();  
	Для Каждого СтрокаРеквизиты Из ТаблицаРеквизитыОрганизации Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьТитульнаяСтраница.Параметры, СтрокаРеквизиты);
	КонецЦикла;
	
	ТаблицаДокумент = МенеджерВременныхТаблиц.Таблицы.Найти("_Документ").ПолучитьДанные().Выгрузить();  
	
	Для Каждого СтрокаДокумент из ТаблицаДокумент Цикл
		ЗаполнитьЗначенияСвойств(ОбластьТитульнаяСтраница.Параметры, СтрокаДокумент);
	КонецЦикла;
	
	ТаблицаПодписант = МенеджерВременныхТаблиц.Таблицы.Найти("_ПодписантФИО").ПолучитьДанные().Выгрузить();  
	
	Для Каждого СтрокаПодписант из ТаблицаПодписант Цикл
		ЗаполнитьЗначенияСвойств(ОбластьТитульнаяСтраница.Параметры, СтрокаПодписант);	
	КонецЦикла;
	
	Документ6НДФЛ.Вывести(ОбластьТитульнаяСтраница);
	
	
	ДанныеДля6НДФЛ = МенеджерВременныхТаблиц.Таблицы.Найти("_Для6НДФЛ").ПолучитьДанные().Выгрузить();
	
	Для Каждого СтрокаДанные из ДанныеДля6НДФЛ Цикл  
		
		СтрокаТЗКоличества = ТаблицаКоличестваФЛ.Найти(СтрокаДанные._010, "КБК");
		
		ЗаполнитьЗначенияСвойств(ОбластьРаздел1.Параметры, СтрокаДанные); 
		ЗаполнитьЗначенияСвойств(ОбластьРаздел2.Параметры, СтрокаДанные);  
		ОбластьРаздел2.Параметры._110 = СтрокаТЗКоличества.Количество;
		

		Документ6НДФЛ.Вывести(ОбластьРаздел1);
		Документ6НДФЛ.Вывести(ОбластьРаздел2);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере(ЭтаФорма.Результат, ЭтаФорма.Результат6НДЛФ);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат6НДЛФ);
КонецПроцедуры


&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	// сделать проверку, что это квартал
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат6НДЛФ, "НеАктуальность");

КонецПроцедуры

#Область ЗаимствованиеИзВыгрузки2НДФЛ     

&НаКлиенте
Функция КаталогУказанВерно()
	
	Если НЕ ЗначениеЗаполнено(Отчет.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Каталог данных"" не заполнено", ЭтаФорма, "КаталогДанных", "Отчет");
		Возврат Ложь;
	КонецЕсли;
	
	Каталог = Новый Файл(Отчет.КаталогДанных);
	Если НЕ Каталог.Существует() ИЛИ НЕ Каталог.ЭтоКаталог() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно указан каталог данных", ЭтаФорма, "КаталогДанных", "Отчет");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции


&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Отчет.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет.КаталогДанных = Диалог.Каталог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Отчет.КаталогДанных + ?(Прав(Отчет.КаталогДанных, 1) = "\", "", "\"));

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВКонтур(Команда)
	
	// берем за образец  выгрузку 2-НДФЛ в контур

	Если НЕ КаталогУказанВерно() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию();
	
	Попытка
		
		ДанныеXML = СформироватьXML();
		
		Если ДанныеXML = Неопределено Тогда
			ВызватьИсключение "Файл не сформирован: отсутствуют данные для выгрузки";
		КонецЕсли;
		
		ПолныйПутьФайла = Отчет.КаталогДанных + "\" + ДанныеXML.ИмяФайла;
		ДанныеXML.ДвоичныеДанные.Записать(ПолныйПутьФайла);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл сохранён: " + ПолныйПутьФайла);
		
	Исключение
		
		ПараметрыСессииСбораСтатистики.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не сохранён. " + ПараметрыСессииСбораСтатистики.ТекстОшибки);
		Возврат;
		
	КонецПопытки;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

#Область ПолучениеДанных

&НаСервере
Процедура ЗаполнитьВременныеТаблицы(Запрос)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСроков.Квартал КАК Квартал,
	|	ТаблицаСроков.НачалоПериода1 КАК НачалоПериода1,
	|	ТаблицаСроков.НачалоПериода2 КАК НачалоПериода2,
	|	ТаблицаСроков.НачалоПериода3 КАК НачалоПериода3,
	|	ТаблицаСроков.НачалоПериода4 КАК НачалоПериода4,
	|	ТаблицаСроков.НачалоПериода5 КАК НачалоПериода5,
	|	ТаблицаСроков.НачалоПериода6 КАК НачалоПериода6,
	|	ТаблицаСроков.ПериодОплаты1 КАК ПериодОплаты1,
	|	ТаблицаСроков.ПериодОплаты2 КАК ПериодОплаты2,
	|	ТаблицаСроков.ПериодОплаты3 КАК ПериодОплаты3,
	|	ТаблицаСроков.ПериодОплаты4 КАК ПериодОплаты4,
	|	ТаблицаСроков.ПериодОплаты5 КАК ПериодОплаты5,
	|	ТаблицаСроков.ПериодОплаты6 КАК ПериодОплаты6
	|ПОМЕСТИТЬ _ТаблицаСроков
	|ИЗ
	|	&ТаблицаСроков КАК ТаблицаСроков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИСТИНА КАК ЭтоДивиденды,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка13) КАК СтавкаНДФЛ,
	|	""18210102130011000110"" КАК КБК
	|ПОМЕСТИТЬ _КБК
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИСТИНА,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка15),
	|	""18210102140011000110""
