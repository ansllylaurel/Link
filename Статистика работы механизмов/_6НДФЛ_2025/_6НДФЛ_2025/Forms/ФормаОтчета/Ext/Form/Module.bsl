	|	ЛОЖЬ,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка13),
	|	""18210102010011000110""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛОЖЬ,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка15),
	|	""18210102180011000110""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КВАРТАЛ(БазаНачисленияНДФЛОбороты.Период) КАК Квартал,
	|	БазаНачисленияНДФЛОбороты.ФизЛицо КАК Клиент,
	|	ВЫБОР
	|		КОГДА БазаНачисленияНДФЛОбороты.ВидНалогооблагаемойБазы = ЗНАЧЕНИЕ(Перечисление.ВидыНалогооблагаемыхБаз.ПоДивидендам)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоДивиденды,
	|	БазаНачисленияНДФЛОбороты.Регистратор КАК ДокументРасчет,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(БазаНачисленияНДФЛОбороты.Регистратор) = ТИП(Документ.РасчетНДФЛ)
	|			ТОГДА ВЫРАЗИТЬ(БазаНачисленияНДФЛОбороты.Регистратор КАК Документ.РасчетНДФЛ).ДатаРасчета
	|		КОГДА ТИПЗНАЧЕНИЯ(БазаНачисленияНДФЛОбороты.Регистратор) = ТИП(Документ.РасчетНДФЛПайщиков)
	|			ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БазаНачисленияНДФЛОбороты.Регистратор КАК Документ.РасчетНДФЛПайщиков).Дата, ДЕНЬ)
