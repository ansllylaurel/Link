Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"ОКУД0420431 ""Список неактивных клиентов""",
		"0.03",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповеститьОНаступленииКрайнегоСрокаСдачиОтчетности", "Оповестить о наступлении крайнего срока сдачи отчетности", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Если ЭтотОбъект.ПроверитьЗаполнение() Тогда
		
		Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	   
	    Параметры.УстановитьЗначениеПараметра("ДатаНачала",    ЭтотОбъект.Период.ДатаНачала);
	    Параметры.УстановитьЗначениеПараметра("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
		Параметры.УстановитьЗначениеПараметра("Организация",   ЭтотОбъект.Организация);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтотОбъект.Период, Ложь, Ложь, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , , Отказ); 	
	КонецЕсли;

КонецПроцедуры
