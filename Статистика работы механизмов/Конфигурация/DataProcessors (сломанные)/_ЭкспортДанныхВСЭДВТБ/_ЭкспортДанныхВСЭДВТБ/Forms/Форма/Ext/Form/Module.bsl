&НаСервере
Процедура ЗаполнитьСписокКонтактныхЛиц()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо И СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = КонтактныеЛица.Объект)
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И КонтактныеЛица.КонтактноеЛицо ССЫЛКА Справочник.ЮрФизЛица
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтактноеЛицо
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	СписокКонтактныхЛиц.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо"));
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьФИО(КонтактноеЛицо, Организация, ИмяРеквизитаФормы = "")
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСотрудниковОрганизации.Фамилия + "" "" + РеквизитыСотрудниковОрганизации.Имя + "" "" + РеквизитыСотрудниковОрганизации.Отчество КАК Подписант,
		|	КонтактныеЛица.Должность КАК ДолжностьПодписанта
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &КонтактноеЛицо) КАК РеквизитыСотрудниковОрганизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО РеквизитыСотрудниковОрганизации.Организация.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (КонтактныеЛица.КонтактноеЛицо = &КонтактноеЛицо)";
	
	Если ИмяРеквизитаФормы <> "" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Подписант", "КАК " + ИмяРеквизитаФормы);	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ДолжностьПодписанта", "КАК " + ИмяРеквизитаФормы + "Должность");
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("КонтактноеЛицо"	, КонтактноеЛицо);
	Запрос.УстановитьПараметр("Период"			, ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыФормыНаСервере(ФормаПервичныхДокументовСЭД, СписокФормДляСозданияЭлементов = Неопределено, ИмяГруппыФормы)
	
	Если ФормаПервичныхДокументовСЭД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеФлажкаФормы = Элементы.Добавить(ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы[ИмяГруппыФормы]);
	ПолеФлажкаФормы.Вид                = ВидПоляФормы.ПолеФлажка;
	ПолеФлажкаФормы.ПутьКДанным        = ФормаПервичныхДокументовСЭД.Значение;
	ПолеФлажкаФормы.Заголовок          = ФормаПервичныхДокументовСЭД.Представление;
	ПолеФлажкаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	Если ФормаПервичныхДокументовСЭД.Пометка 
		Или (СписокФормДляСозданияЭлементов <> Неопределено И СписокФормДляСозданияЭлементов.Найти(ФормаПервичныхДокументовСЭД.Значение) <> Неопределено) Тогда
		
		Если ФормаПервичныхДокументовСЭД.Значение = "Форма685" Тогда
			ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииФорма685");
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "Форма220" Тогда
			ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииФорма220");	
		Иначе
			ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ФлажкиФормПриИзменении");
		КонецЕсли;                                                                                    	

		ПолеФлажкаТаблицы = Элементы.Вставить("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.АктивныеСчетаДоверительногоУправления, Элементы.АктивныеСчетаДоверительногоУправленияФлажок);
		ПолеФлажкаТаблицы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаТаблицы.ПутьКДанным        = "АктивныеСчетаДоверительногоУправления." + ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаТаблицы.Заголовок          = СтрЗаменить(ФормаПервичныхДокументовСЭД.Значение, "Форма", "Форма ");
		ПолеФлажкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажкаТаблицы.ТолькоПросмотр     = Истина;
		ПолеФлажкаТаблицы.Видимость			 = ФормаПервичныхДокументовСЭД.Пометка;
					
		ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = ФормаПервичныхДокументовСЭД.Пометка;
		
				
	Иначе
		ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзменении" + ФормаПервичныхДокументовСЭД.Значение);
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтактныеЛицаСД(Дата, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Дата",			Дата);		
		
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РеквизитыСотрудниковОрганизации.Фамилия + "" "" + РеквизитыСотрудниковОрганизации.Имя + "" "" + РеквизитыСотрудниковОрганизации.Отчество КАК ФИО
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Дата,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизации
		|		ПО (КонтактныеЛица.КонтактноеЛицо = РеквизитыСотрудниковОрганизации.ЮрФизЛицо)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Дата
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Дата)
		|	И НЕ РеквизитыСотрудниковОрганизации.Фамилия ЕСТЬ NULL";
		
	Выборка = Запрос.Выполнить().Выбрать();	
	
	СписокКонтактныхЛиц = Новый СписокЗначений;
			
	Пока Выборка.Следующий() Цикл		
		СписокКонтактныхЛиц.Добавить(Выборка.ФИО);
	КонецЦикла;
	
	Возврат СписокКонтактныхЛиц;
	
КонецФункции

