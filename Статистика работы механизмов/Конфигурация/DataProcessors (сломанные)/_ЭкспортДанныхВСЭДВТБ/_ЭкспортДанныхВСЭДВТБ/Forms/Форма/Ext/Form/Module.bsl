&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогФайлов;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогФайлов = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаСоСписокомЛицНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	Если ЭтаФорма.ВидФормы233 = "АффилированныеЛица" Тогда
		Диалог.Фильтр				= "Файл ""XML"" (*.xml)|*.xml";
		Диалог.Заголовок			= "Файл со списком аффилированных лиц:"; 
	ИначеЕсли ЭтаФорма.ВидФормы233 = "СвязанныеЛица" Тогда
		Диалог.Фильтр				= "Файл ""Excel"" (*.xlsx)|*.xlsx";
		Диалог.Заголовок			= "Файл со списком связанных лиц:"; 
	КонецЕсли;		
		
	Диалог.ПолноеИмяФайла		= ИмяФайлаСоСписокомЛиц;
	Диалог.МножественныйВыбор	= Ложь; 
	
	Если Диалог.Выбрать() Тогда 
		ИмяФайлаСоСписокомЛиц = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		ЗаполнитьФИО(РезультатВыбора.Значение, Объект.Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РуководительПИФНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		ЗаполнитьФИО(РезультатВыбора.Значение, Объект.Организация, "РуководительПИФ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНеиспользуемыеПриИзменении(Элемент)
	
	Если ПоказатьНеиспользуемые Тогда
		
		Для Каждого НеиспользуемаяФорма Из ЭтаФорма.НеиспользуемыеФормы Цикл
			ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить(НеиспользуемаяФорма.Значение, НеиспользуемаяФорма.Представление, Истина);
		КонецЦикла;
		
		ОбработатьНеиспользуемыеЭлементыНаСервере(ПоказатьНеиспользуемые);
		
	Иначе  		
		
		Для Каждого НеиспользуемаяФорма Из ЭтаФорма.НеиспользуемыеФормы Цикл
			ЭтаФорма.ФормыПервичныхДокументовСЭД.Удалить(ЭтаФорма.ФормыПервичныхДокументовСЭД.НайтиПоЗначению(НеиспользуемаяФорма.Значение));
		КонецЦикла;	
		
		ОбработатьНеиспользуемыеЭлементыНаСервере(ПоказатьНеиспользуемые);
		
	КонецЕсли;
	
	ОбновитьАктивныеСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура УполномоченноеЛицоСДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокДляВыбора = КонтактныеЛицаСД(Объект.Период, Объект.Организация);
	РезультатВыбора = СписокДляВыбора.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		УполномоченноеЛицоСД = РезультатВыбора		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидФормы233ПриИзменении(Элемент)
	
	ЭтаФорма.ИмяФайлаСоСписокомЛиц = "";
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_Процедуры_и_Функции

&НаКлиенте
Процедура НастроитьВидимостьИДоступность()
	
	ЭтоКонецКвартала = КонецДня(Объект.Период) = КонецКвартала(Объект.Период);
	ЭтаФорма.Форма923 													= ЭтоКонецКвартала;
	Элементы.АктивныеСчетаДоверительногоУправленияФорма923.Видимость 	= ЭтоКонецКвартала; 
	
	ЭтаФорма.Форма922 													= ЭтоКонецКвартала;
	Элементы.АктивныеСчетаДоверительногоУправленияФорма922.Видимость 	= ЭтоКонецКвартала; 
	
	ЭтаФорма.Форма220 													= ЭтоКонецКвартала;
	Элементы.АктивныеСчетаДоверительногоУправленияФорма220.Видимость 	= ЭтоКонецКвартала; 
	Элементы.ГруппаПодписант.Видимость									= ЭтоКонецКвартала;
	
КонецПроцедуры
	
&НаСервере
Процедура ДобавитьРеквизитФормыНаСервере(ФормаПервичныхДокументовСЭД, НовыеРеквизитыФормы, СписокФормДляСозданияЭлементов = Неопределено)
	
	НовыеРеквизитыФормы.Добавить(Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево")));
	Если ФормаПервичныхДокументовСЭД.Пометка 
		Или (СписокФормДляСозданияЭлементов <> Неопределено И СписокФормДляСозданияЭлементов.Найти(ФормаПервичныхДокументовСЭД.Значение) <> Неопределено) Тогда
		НовыеРеквизитыФормы.Добавить(Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево"), "АктивныеСчетаДоверительногоУправления"));
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбработатьНеиспользуемыеЭлементыНаСервере(Показать)
	
	Если Показать Тогда
		
		НовыеРеквизитыФормы = Новый Массив;
		
		Для Каждого НеиспользуемаяФорма Из ЭтаФорма.НеиспользуемыеФормы Цикл
			НоваяФорма = ЭтаФорма.ФормыПервичныхДокументовСЭД.НайтиПоЗначению(НеиспользуемаяФорма.Значение);			
			ДобавитьРеквизитФормыНаСервере(НоваяФорма, НовыеРеквизитыФормы);
		КонецЦикла;
		
		Если НовыеРеквизитыФормы.Количество() > 0 Тогда
			ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, Новый Массив);
		КонецЕсли;
		
		Для Каждого НеиспользуемаяФорма Из ЭтаФорма.НеиспользуемыеФормы Цикл
			ДобавитьЭлементыФормыНаСервере(НоваяФорма,,"ГруппаНеиспользуемыеФормы");
		КонецЦикла;
		
	Иначе
		
		УдаляемыеРеквизиты = Новый Массив;
		
		Для Каждого НеиспользуемаяФорма Из ЭтаФорма.НеиспользуемыеФормы Цикл
			ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы[НеиспользуемаяФорма.Значение]);
			ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправления" + СокрЛП(НеиспользуемаяФорма.Значение)]);
			
			УдаляемыеРеквизиты.Добавить(НеиспользуемаяФорма.Значение);
			УдаляемыеРеквизиты.Добавить("АктивныеСчетаДоверительногоУправления."+ СокрЛП(НеиспользуемаяФорма.Значение));
		КонецЦикла;
		
		Если УдаляемыеРеквизиты.Количество() > 0 Тогда
			ЭтаФорма.ИзменитьРеквизиты(Новый Массив, УдаляемыеРеквизиты);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКаталогиФорм(ИмяКаталога = Неопределено, НомерФормы = Неопределено)
	
	Если ИмяКаталога = Неопределено Тогда
	
		Для Каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
			
			Если Не ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] Тогда
				Продолжить;
			КонецЕсли;
			
			НомерФормы = СтрЗаменить(ФормаПервичныхДокументовСЭД.Значение, "Форма", "");
			КаталогФайловФормы = Объект.КаталогФайлов + ?(Прав(Объект.КаталогФайлов, 1) = "\", "", "\") + НомерФормы;
			ОчиститьКаталогиФорм(КаталогФайловФормы, НомерФормы);
			
			Если НомерФормы = "530" Тогда
				ОчиститьКаталогиФорм(КаталогФайловФормы + "\Депозиты", НомерФормы);
	            ОчиститьКаталогиФорм(КаталогФайловФормы + "\МНО", НомерФормы);
			Конецесли;
			
		КонецЦикла;
		
	Иначе
			
		НайденныеФайлы = НайтиФайлы(ИмяКаталога, "*.xml", Ложь);
		
		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
			
			ЭтоФайлТекущейФормы = Ложь;
			
			// прочитаем XML, чтобы удалить только подходящие файлы
			ЧтениеXML = Новый ЧтениеXML;
			
			Попытка
				ЧтениеXML.ОткрытьФайл(НайденныйФайл.ПолноеИмя);
				Если ЧтениеXML.Прочитать() Тогда
					ЭтоФайлТекущейФормы = (ЧтениеXML.Имя = "EDO_ODKF" + ?(НомерФормы = Неопределено, "", НомерФормы));
				КонецЕсли;
				ЧтениеXML.Закрыть(); // иначе будет ошибка совместного доступа к файлу
				
				Если ЭтоФайлТекущейФормы Тогда
					УдалитьФайлы(НайденныйФайл.ПолноеИмя);
				КонецЕсли;
					
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось удалить файл " + НайденныйФайл.ПолноеИмя + ". Система сообщает " + ОписаниеОшибки());
			КонецПопытки;
						
		КонецЦикла;
		
	КонецЕсли;
				
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктивныеСчетаДоверительногоУправления()
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
#Область ТЕКСТ_ЗАПРОСА
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
