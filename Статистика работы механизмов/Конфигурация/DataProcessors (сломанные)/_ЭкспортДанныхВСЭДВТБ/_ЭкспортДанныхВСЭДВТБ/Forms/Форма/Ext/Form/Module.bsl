#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период        = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		Объект.КаталогФайлов = ПолучитьКаталогФайлов(Объект.Организация, Объект.Период, Объект.КаталогФайлов);
	КонецЕсли;
	
	//пометка - добавить в АктивныеСчетаДоверительногоУправления
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма520", "520 - Выписка по расчетному счету"								, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма522", "522 - Биржевой отчет брокера"									, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма527", "527 - Платежные документы"										, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма530", "530 - Подтверждения МНО и депозитов"								, Истина);	
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма029", "029 - Сверка СЧА"												, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма685", "685 - Активы, составляющие ПИФ"									, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма301", "301 - Сверка стоимости активов компенсационного фонда"			, Ложь);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма233", "233 - Сведения о составе аффилированных лиц"						, Ложь);	
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма922", "922 - Сведения о собственных средствах и активах в управлении"	, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма923", "923 - Сведения о доходности ПФР"									, Истина);
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("Форма220", "220 - Сведения о минимальной достаточности и активах ПФР"		, Истина);
	// Если форма становится неиспользуемой, то надо добавить её в список "НеиспользуемыеФормы"
	//	по аналогии с тем, как используемые формы добавляются в список "ФормыПервичныхДокументовСЭД"
	
	// создадим реквизиты формы
	НовыеРеквизитыФормы = Новый Массив;
	
	// Определим список форм, для которых элементы нужно создать в любом случае (даже если форма без пометки)
	СписокФормДляСозданияЭлементов = Новый Массив;
	СписокФормДляСозданияЭлементов.Добавить("Форма301");
	
	Для Каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		ДобавитьРеквизитФормыНаСервере(ФормаПервичныхДокументовСЭД, НовыеРеквизитыФормы, СписокФормДляСозданияЭлементов);	
	КонецЦикла;
	
	Если НовыеРеквизитыФормы.Количество() > 0 Тогда
		ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, Новый Массив);
	КонецЕсли;
	
	// создадим элементы управления, соотв. новым реквизитам формы
	Для Индекс = 0 По ЭтаФорма.ФормыПервичныхДокументовСЭД.Количество() - 1 Цикл
		ДобавитьЭлементыФормыНаСервере(ЭтаФорма.ФормыПервичныхДокументовСЭД[Индекс], СписокФормДляСозданияЭлементов, ?(Индекс < 6, "ГруппаФормыПерваяКолонка", "ГруппаФормыВтораяКолонка"));				
	КонецЦикла;
	
	ЗаполнитьСписокКонтактныхЛиц();
	
	ЭтаФорма.ВидФормы233 = "АффилированныеЛица";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьИДоступность();	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область События_Элементов_Формы

&НаКлиенте
Процедура Подключаемый_ФлажкиФормПриИзменении(Элемент)
	
	Элементы["АктивныеСчетаДоверительногоУправления" + Элемент.Имя].Видимость = ЭтаФорма[Элемент.Имя];
	ТекЭлементСпискаФорм = ЭтаФорма.ФормыПервичныхДокументовСЭД.НайтиПоЗначению(Элемент.Имя);
	Если ТекЭлементСпискаФорм <> Неопределено И ЭтаФорма[Элемент.Имя] Тогда
		ТекЭлементСпискаФорм.Пометка = Истина;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииФорма233(Элемент)
	
	Элементы.ГруппаНастройкиСпискаЛиц.Видимость = ЭтаФорма.Форма233;
	Элементы.ГруппаПодписант.Видимость = Не ЭтаФорма.Форма233;
	
	Для Каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение <> Элемент.Имя Тогда
			
			ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = НЕ ЭтаФорма[Элемент.Имя];
			
			Если Элементы.Найти("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение) <> Неопределено Тогда
				Элементы["АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение].Видимость = ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение];
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ЭтаФорма.Форма233 Тогда
		Объект.КаталогФайлов = "";
	ИначеЕсли ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		Объект.КаталогФайлов = ПолучитьКаталогФайлов(Объект.Организация, Объект.Период, Объект.КаталогФайлов);
	КонецЕсли;
	
	Элементы.ГруппаОтветственныеДляФормы685.Видимость = ЭтаФорма.Форма685;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииФорма220(Элемент)
	
	Элементы.ГруппаПодписант.Видимость = ЭтаФорма.Форма220;
	
	Подключаемый_ФлажкиФормПриИзменении(Элемент);
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииФорма685(Элемент)
	
	Элементы.ГруппаОтветственныеДляФормы685.Видимость = ЭтаФорма.Форма685;
	Элементы.ГруппаНастройкиСпискаЛиц.Видимость = ЭтаФорма.Форма233;
	
	Элементы["АктивныеСчетаДоверительногоУправления" + Элемент.Имя].Видимость = ЭтаФорма[Элемент.Имя];
	ТекЭлементСпискаФорм = ЭтаФорма.ФормыПервичныхДокументовСЭД.НайтиПоЗначению(Элемент.Имя);
	Если ТекЭлементСпискаФорм <> Неопределено И ЭтаФорма[Элемент.Имя] Тогда
		ТекЭлементСпискаФорм.Пометка = Истина;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность();
	ОбновитьАктивныеСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура АктивныеСчетаДоверительногоУправленияПередНачаломИзменения(Элемент, Отказ)

	ТекущиеДанные = Элементы.АктивныеСчетаДоверительногоУправления.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.АктивныеСчетаДоверительногоУправления.ТекущийЭлемент = Элементы.АктивныеСчетаДоверительногоУправленияСчетДоверительногоУправления Тогда
		Отказ = Истина;
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновить");
	Попытка
			
		ОбновитьАктивныеСчетаДоверительногоУправления();
			
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	Попытка
		
		ВыполнитьКомандаЭкспортировать(ПараметрыСессии, Команда);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьФлажки");
