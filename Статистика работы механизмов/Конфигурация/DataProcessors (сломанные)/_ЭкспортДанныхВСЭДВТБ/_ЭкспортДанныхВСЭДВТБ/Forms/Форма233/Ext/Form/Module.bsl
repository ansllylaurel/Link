
&НаКлиенте
Функция СфомироватьДокументыСЭД(Организация, ИмяФайлаСоСписокомЛиц, Период, КаталогФайлов, Подписант, ДолжностьПодписанта, ВидФормы233) Экспорт
	
	Если ПустаяСтрока(ИмяФайлаСоСписокомЛиц) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан путь к файлу со списком аффилированных лиц");
		Возврат Ложь;
	КонецЕсли;
	
	Файл = Новый Файл(ИмяФайлаСоСписокомЛиц);
	Если НЕ Файл.Существует() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указан неверный путь к файлу со списком аффилированных лиц");
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогФайлов, Отказ);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ВидФормы233 = "АффилированныеЛица" Тогда
		
		ДанныеXDTO = ПолучитьДанныеXDTOСпискаАффилированныхЛиц(Организация, ИмяФайлаСоСписокомЛиц);
		
		ВыгруженФайлВТБ = СохранитьСписокАффилированныхЛиц(ДанныеXDTO, КаталогФайлов, Подписант, ДолжностьПодписанта, Ложь, "АЛ_ВТБ");
		ВыгруженФайлПФР = СохранитьСписокАффилированныхЛиц(ДанныеXDTO, КаталогФайлов, Подписант, ДолжностьПодписанта, Истина, "ПФР");
		Результат = ВыгруженФайлВТБ И ВыгруженФайлПФР;
		
		ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
		ОрганизацияТраст = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
		
		Если Организация = ОрганизацияРЭМ Или Организация = ОрганизацияТраст Тогда
		
			ДанныеДляЗаписи = ПолучитьДанныеДляЗаписиСпискаАффилированныхЛицВExcel(ДанныеXDTO);
			ВыгруженФайлАФиАГ = СохранитьСписокАффилированныхЛицВExcel(ДанныеДляЗаписи, КаталогФайлов, "АГ");
			ВыгруженФайлАФиАГ = СохранитьСписокАффилированныхЛицВExcel(ДанныеДляЗаписи, КаталогФайлов, "АФ");
			
			Результат = Результат И ВыгруженФайлАФиАГ;
		
		КонецЕсли;
		
		Возврат Результат;
		
	ИначеЕсли ВидФормы233 = "СвязанныеЛица" Тогда
		Возврат СохранитьСписокСвязанныхЛиц(Организация, ИмяФайлаСоСписокомЛиц, Период, КаталогФайлов, Подписант, ДолжностьПодписанта);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неизвестный вид формы 233");
		Возврат Ложь;
	КонецЕсли;		
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеДляЗаписиСпискаАффилированныхЛицВExcel(ДанныеXDTO)

	ДанныеФайла = Новый Массив;
	
	Для Каждого Affiliate Из ДанныеXDTO.Partner.Affiliates.Affiliate Цикл
		
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("НомерСтроки", Число(Affiliate.Pos));
		СтрокаДанных.Вставить("КодТипаАЛ", ?(Affiliate.Is_Firm = "1", "Ю", "Ф"));
		СтрокаДанных.Вставить("НаименованиеАЛ", Affiliate.Partner_Name_Full_Official);
		СтрокаДанных.Вставить("КодМатрих", СтрЗаменить(Affiliate.Matrix_Partner_Code, "MX1/", ""));
		
		ДанныеФайла.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	Период = XMLЗначение(Тип("Дата"), ДанныеXDTO.Partner.Report_Date);
	ТабличныйДокумент = ЗаполнитьТабличныйДокументАЛ(ДанныеФайла, Период, МакетАЛ_Атом);
	
	Возврат Новый Структура("ТабличныйДокумент, Период", ТабличныйДокумент, Период);
	
КонецФункции

&НаКлиенте
Функция СохранитьСписокАффилированныхЛицВExcel(ДанныеДляЗаписи, КаталогФайлов, ПрефиксИмениФайла)
	
	ИмяФайлаXLS = КаталогФайлов + "\АЛ_" + ПрефиксИмениФайла + "_на " + Формат(ДанныеДляЗаписи.Период, "ДФ=dd.MM.yyyy") + ".xlsx";
	
	Попытка
		ДанныеДляЗаписи.ТабличныйДокумент.Записать(ИмяФайлаXLS, ТипФайлаТабличногоДокумента.XLSX);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 сохранена в файл: " + ИмяФайлаXLS);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 не выгружена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;	
		
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьТабличныйДокументАЛ(ДанныеФайла, Период, Макет)

	ДанныеФайлаТаблица = Новый ТаблицаЗначений;
	ДанныеФайлаТаблица.Колонки.Добавить("НомерСтроки", 		Новый ОписаниеТипов("Число"));
	ДанныеФайлаТаблица.Колонки.Добавить("КодТипаАЛ", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1)));
	ДанныеФайлаТаблица.Колонки.Добавить("НаименованиеАЛ", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1024)));
	ДанныеФайлаТаблица.Колонки.Добавить("КодМатрих", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	
	Для каждого ЗначенияКолонок Из ДанныеФайла Цикл
		ЗаполнитьЗначенияСвойств(ДанныеФайлаТаблица.Добавить(), ЗначенияКолонок);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеФайла.НомерСтроки КАК НомерСтроки,
		|	ДанныеФайла.КодТипаАЛ КАК КодТипаАЛ,
		|	ДанныеФайла.НаименованиеАЛ КАК НаименованиеАЛ,
		|	ДанныеФайла.КодМатрих КАК КодМатрих,
		|	ВЫБОР
		|		КОГДА ДанныеФайла.КодТипаАЛ = ""Ю""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)
		|	КОНЕЦ КАК ГруппаОбъектов
		|ПОМЕСТИТЬ _ДанныеФайла
		|ИЗ
		|	&ДанныеФайла КАК ДанныеФайла
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДанныеФайла.НомерСтроки КАК НомерСтроки,
		|	_ДанныеФайла.КодТипаАЛ КАК КодТипаАЛ,
		|	_ДанныеФайла.НаименованиеАЛ КАК НаименованиеАЛ,
		|	_ДанныеФайла.КодМатрих КАК КодМатрих,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект
		|ПОМЕСТИТЬ _ОбъектыПоКодамМатрих
		|ИЗ
		|	_ДанныеФайла КАК _ДанныеФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _ДанныеФайла.КодМатрих = КодыВоВнешнихСистемахСрезПоследних.Код
		|			И _ДанныеФайла.ГруппаОбъектов = КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ОбъектыПоКодамМатрих.НомерСтроки КАК НомерСтроки,
		|	_ОбъектыПоКодамМатрих.КодТипаАЛ КАК КодТипаАЛ,
		|	_ОбъектыПоКодамМатрих.НаименованиеАЛ КАК НаименованиеАЛ,
		|	ЕСТЬNULL(АффилированныеЛицаСрезПоследних.Гражданство.Код, """") КАК СтранаРегистрацииАЛ,
		|	ЕСТЬNULL(АффилированныеЛицаСрезПоследних.ИНН, """") КАК РегНомерАЛ
		|ИЗ
		|	_ОбъектыПоКодамМатрих КАК _ОбъектыПоКодамМатрих
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АффилированныеЛица.СрезПоследних(
		|				&Период,
		|				АффилированноеЛицо В
		|					(ВЫБРАТЬ
		|						_ОбъектыПоКодамМатрих.Объект
		|					ИЗ
		|						_ОбъектыПоКодамМатрих)) КАК АффилированныеЛицаСрезПоследних
		|		ПО _ОбъектыПоКодамМатрих.Объект = АффилированныеЛицаСрезПоследних.АффилированноеЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";		
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ДанныеФайла", ДанныеФайлаТаблица);
	Запрос.УстановитьПараметр("Период", Период);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл
	
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДанныеXDTOСпискаАффилированныхЛиц(Организация, ИмяФайлаСоСписокомЛиц)

	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайлаСоСписокомЛиц);
	Исключение
	    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка открытия списка аффилированных лиц: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	ДанныеXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	ИННОрганизации = ПолучитьИННОрганизации(Организация);
	Если НЕ ЗначениеЗаполнено(ИННОрганизации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить ИНН для организации: " + Организация);
		Возврат Неопределено;
	ИначеЕсли ДанныеXDTO.Свойства().Получить("Partner")	= Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверный формат файла!");
		Возврат Неопределено;
	ИначеЕсли ДанныеXDTO.Partner.INN <> ИННОрганизации Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ИНН организации в списке аффилированных лиц не равен ИНН текущей организации!");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеXDTO;

КонецФункции

&НаКлиенте
Функция СохранитьСписокАффилированныхЛиц(ДанныеXDTO, КаталогФайлов, Подписант, ДолжностьПодписанта, ОчищатьПолеАЛАЛВ233, ПрефиксИмениФайла)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Схема.Записать(ИмяВременногоФайла);
	
	МассивXSD = Новый Массив;
	МассивXSD.Добавить(ИмяВременногоФайла);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(МассивXSD);
	EDO_ODKF233 = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип("VTB", "EDO_ODKF233"));
	
	EDO_ODKF233.ReportOnDate	= Формат(XMLЗначение(Тип("Дата"), ДанныеXDTO.Partner.Report_Date), "ДФ='dd.MM.yyyy HH:mm:ss'");
	EDO_ODKF233.SDName			= ДанныеXDTO.Partner.Partner_Name;
	EDO_ODKF233.INNKPP			= ДанныеXDTO.Partner.INN + "/" + ДанныеXDTO.Partner.KPP;
	EDO_ODKF233.Qty				= ДанныеXDTO.Partner.Affiliates.Affiliate.Количество();
	EDO_ODKF233.RespPersonPost	= ДолжностьПодписанта;
	EDO_ODKF233.RespPersonFIO	= Подписант;
	EDO_ODKF233.LinkedPers		= 0; //тип списка "Аффилированные"
	
	МассивАффилированныхЛиц = Новый Массив;
	
	МаксимальнаяДлинаПоляAffilPersonsList = 0;
	
	Для Каждого Affiliate Из ДанныеXDTO.Partner.Affiliates.Affiliate Цикл
		
		Company = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип("VTB", "Company"));
		Company.Name					= Affiliate.Partner_Name_Full_Official;
		
		Если ТипЗнч(Affiliate.Address) = Тип("Строка") Тогда
			Company.Address = Affiliate.Address;
		КонецЕсли;
			
		Company.SharesProcByCategory	= Affiliate.Share;
		Company.ListChangesAndDate		= Affiliate.Change_Description;
		
		МассивАффилированныхЛиц.Добавить(Affiliate.Pos + ". " + Affiliate.Partner_Name_Full_Official);
		
		ДатаОснования = "";
		
		Если ТипЗнч(Affiliate.Grounds.Ground) = Тип("ОбъектXDTO") Тогда
			Ground = Affiliate.Grounds.Ground;
			Company.Basement = Ground.Ground_Name;
			ДатаОснования = XMLЗначение(Тип("Дата"), Ground.Date_From);
			
		Иначе
			Для Каждого Ground Из Affiliate.Grounds.Ground Цикл
				Company.Basement = ?(ЗначениеЗаполнено(Company.Basement), Company.Basement + Символы.ПС, "") + Строка(Ground.Ground_Pos) + ". " + Ground.Ground_Name;
				ДатаОснования = ?(ЗначениеЗаполнено(ДатаОснования), Мин(XMLЗначение(Тип("Дата"), Ground.Date_From), ДатаОснования), XMLЗначение(Тип("Дата"), Ground.Date_From));
			КонецЦикла;
		КонецЕсли;
		
		Company.BasementStartDate = Формат(ДатаОснования, "ДФ='dd.MM.yyyy HH:mm:ss'");
		
		Company.RowNum	= Affiliate.Pos;
		
		Если Affiliate.Свойства().Получить("INN") <> Неопределено Тогда
			Company.INN	= Affiliate.INN;
		КонецЕсли;
		
		Если Affiliate.Свойства().Получить("KPP") <> Неопределено Тогда
			Company.KPP = Affiliate.KPP;
		КонецЕсли;
		
		Если НЕ ОчищатьПолеАЛАЛВ233
			И Affiliate.Свойства().Получить("ALALs") <> Неопределено Тогда
			Если ТипЗнч(Affiliate.ALALs.ALAL) = Тип("ОбъектXDTO") Тогда
				ALAL = Affiliate.ALALs.ALAL;
				
				ИнформацияОбАЛ = "";	
				
				ДополнитьИнформациюОбАЛ(ИнформацияОбАЛ, ALAL, "INN");
				ДополнитьИнформациюОбАЛ(ИнформацияОбАЛ, ALAL, "KPP");
				
				ИнформацияОбАЛ = ALAL.Partner_Name_Full_Official + " " + ИнформацияОбАЛ;	
				
			Иначе
				МассивАЛАЛ = Новый Массив;
				
				Для Каждого ALAL Из Affiliate.ALALs.ALAL Цикл
					ИнформацияОбАЛ = "";	
					
					ДополнитьИнформациюОбАЛ(ИнформацияОбАЛ, ALAL, "INN");
					ДополнитьИнформациюОбАЛ(ИнформацияОбАЛ, ALAL, "KPP");
					
					ИнформацияОбАЛ = ALAL.Partner_Name_Full_Official + " " + ИнформацияОбАЛ;	
					
					Если МассивАЛАЛ.Найти(ИнформацияОбАЛ) = Неопределено Тогда
						МассивАЛАЛ.Добавить(ИнформацияОбАЛ);
					КонецЕсли;
				КонецЦикла;
				
				Company.AffilPersonsList = СтрСоединить(МассивАЛАЛ, Символы.ПС);
				
				МаксимальнаяДлинаПоляAffilPersonsList = Макс(МаксимальнаяДлинаПоляAffilPersonsList, СтрДлина(Company.AffilPersonsList));
			КонецЕсли;
		КонецЕсли;
		
		EDO_ODKF233.Company.Добавить(Company);
		
	КонецЦикла;
	
	Если МаксимальнаяДлинаПоляAffilPersonsList > 8000 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Максимальная длина поля AffilPersonsList: " + Формат(МаксимальнаяДлинаПоляAffilPersonsList, "ЧГ=0"));
	КонецЕсли;
	
	EDO_ODKF233.Staff = СтрСоединить(МассивАффилированныхЛиц, Символы.ПС);
	
	ИмяФайлаXML = КаталогФайлов + "\" + ПрефиксИмениФайла + "_F233_" + Формат(XMLЗначение(Тип("Дата"), ДанныеXDTO.Partner.Report_Date), "ДФ=yyyyMMdd") + ".xml";
	
	ЗаписьXML = Новый ЗаписьXML;
	
	Попытка
		ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "UTF-8");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 не выгружена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
		
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, EDO_ODKF233);
	ЗаписьXML.Закрыть();
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяФайлаXML,"windows-1251");
	ТекстовыйФайл.ЗаменитьСтроку(2, "<EDO_ODKF233>");
	
	Попытка
		ТекстовыйФайл.Записать(ИмяФайлаXML,"windows-1251");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 сохранена в файл: " + ИмяФайлаXML);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 не выгружена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;	
		
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция СохранитьСписокСвязанныхЛиц(Организация, ИмяФайлаСоСписокомЛиц, Период, КаталогФайлов, Подписант, ДолжностьПодписанта)
	
	Если Прав(ИмяФайлаСоСписокомЛиц, 4) <> "xlsx" Тогда
		Предупреждение("Указан не верный путь к файлу со списокм аффилированных лиц");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмяФайлаСоСписокомЛиц);
		Excel.Sheets(1).Select();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	ВсегоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count;
	ВсегоКолонок = Excel.ActiveSheet.UsedRange.Columns.Count;
	
	МассивДанныхExcel = Excel.ActiveSheet.Range(Excel.Cells(1,1), Excel.ActiveSheet.Cells(ВсегоСтрок,ВсегоКолонок)).Value.Выгрузить(); 
	
	Если НЕ ФайлСоответсвуетШаблону(МассивДанныхExcel) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Схема.Записать(ИмяВременногоФайла);
	
	МассивXSD = Новый Массив;
	МассивXSD.Добавить(ИмяВременногоФайла);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(МассивXSD);
	EDO_ODKF233 = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип("VTB", "EDO_ODKF233"));
	
	РеквизитыОрганизации = ПолучитьРеквизитыОрганизации(Организация, Период);
	
	EDO_ODKF233.ReportOnDate	= Период;
	EDO_ODKF233.SDName			= РеквизитыОрганизации.ПолноеНаименованиеПоУставу;
	EDO_ODKF233.INNKPP			= РеквизитыОрганизации.ИНН + "/" + РеквизитыОрганизации.КПП;
	EDO_ODKF233.RespPersonPost	= ДолжностьПодписанта;
	EDO_ODKF233.RespPersonFIO	= Подписант;
	EDO_ODKF233.LinkedPers		= 1; //тип списка "Связанные"
	
	МассивАффилированныхЛиц = Новый Массив;
	КоличествоЛиц = 0;
	
	Для Индекс = 2 По МассивДанныхExcel[0].Количество() - 1 Цикл	
		Если ЗначениеЗаполнено(ПреобразоватьЗначение(МассивДанныхExcel[1][Индекс])) Тогда
			КоличествоЛиц = КоличествоЛиц + 1;
			
			Company = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип("VTB", "Company"));
			Company.Name					= ПреобразоватьЗначение(МассивДанныхExcel[1][Индекс]); //Affiliate.Partner_Name_Full_Official;

			Если ТипЗнч(МассивДанныхExcel[4][Индекс]) = Тип("Дата") Тогда
				Company.DateModify		= МассивДанныхExcel[4][Индекс];
			Иначе
				МассивДатОснования = СтрРазделить(МассивДанныхExcel[4][Индекс], ",");
				СписокДатОснования = Новый СписокЗначений; 
				
				Для Каждого ДатаОснования Из МассивДатОснования Цикл
					Если ЗначениеЗаполнено(ДатаОснования) Тогда
						СписокДатОснования.Добавить(РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ДатаОснования));
					КонецЕсли;
				КонецЦикла;
				
				Если СписокДатОснования.Количество() Тогда
					СписокДатОснования.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
					Company.DateModify		= СписокДатОснования[0].Значение;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипЗнч(МассивДанныхExcel[5][Индекс]) = Тип("Дата") Тогда
				Company.BasementStartDate		= МассивДанныхExcel[5][Индекс];
			Иначе
				МассивДатОснования = СтрРазделить(МассивДанныхExcel[5][Индекс], ",");
				СписокДатОснования = Новый СписокЗначений; 
				
				Для Каждого ДатаОснования Из МассивДатОснования Цикл
					Если ЗначениеЗаполнено(ДатаОснования) Тогда
						СписокДатОснования.Добавить(РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ДатаОснования));
					КонецЕсли;
				КонецЦикла;
				
				Если СписокДатОснования.Количество() Тогда
					СписокДатОснования.СортироватьПоЗначению();
					Company.BasementStartDate		= СписокДатОснования[0].Значение;
				КонецЕсли;
			КонецЕсли;
			
			МассивАффилированныхЛиц.Добавить(ПреобразоватьЗначение(КоличествоЛиц) + ". " + Company.Name);
			
			Company.RowNum	= КоличествоЛиц;
			Company.INN	= ПреобразоватьЗначение(МассивДанныхExcel[2][Индекс]);
			
			EDO_ODKF233.Company.Добавить(Company);
		КонецЕсли;
	КонецЦикла;
	
	EDO_ODKF233.Staff	= СтрСоединить(МассивАффилированныхЛиц, Символы.ПС);
	EDO_ODKF233.Qty		= КоличествоЛиц;
	
	ИмяФайлаXML = КаталогФайлов + "\" + "F233_" + Формат(XMLЗначение(Тип("Дата"), EDO_ODKF233.ReportOnDate), "ДФ=yyyyMMdd") + ".xml";
	
	ЗаписьXML = Новый ЗаписьXML;
	
	Попытка
		ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "UTF-8");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 не выгружена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, EDO_ODKF233);
	ЗаписьXML.Закрыть();
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяФайлаXML,"windows-1251");
	ТекстовыйФайл.ЗаменитьСтроку(2, "<EDO_ODKF233>");
	
	Попытка
		ТекстовыйФайл.Записать(ИмяФайлаXML,"windows-1251");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма 233 не выгружена: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыОрганизации(Организация, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Период"		, Период);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			(Организация, ЮрФизЛицо, Язык) В
		|				(ВЫБРАТЬ
		|					Организации.Ссылка,
		|					Организации.ЮрФизЛицо,
		|					ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				ИЗ
		|					Справочник.Организации КАК Организации
		|				ГДЕ
		|					Организации.Ссылка = &Организация)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	РеквизитыОрганизации = Новый Структура("ПолноеНаименованиеПоУставу,ИНН, КПП");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

&НаКлиенте
Функция ФайлСоответсвуетШаблону(МассивДанныхExcel)
	
	Отказ = Ложь;
	
	Шаблон = Новый Соответствие;
	
	Колонки = Новый Массив;
	Колонки.Добавить("A");
	Колонки.Добавить("B");
	Колонки.Добавить("C");
	Колонки.Добавить("D");
	Колонки.Добавить("E");
	Колонки.Добавить("F");
	Колонки.Добавить("G");
	Колонки.Добавить("H");
	
	//Титул
	Шаблон.Вставить("A,2", "№ 
 							| п/п");
	
	Шаблон.Вставить("B,2", "Полное наименование
							|компании");
	Шаблон.Вставить("C,2", "ИНН/TIN");
	Шаблон.Вставить("D,2", "ОГРН (регистрационный номер в стране регистрации)");
	Шаблон.Вставить("E,2", "Дата включения лица в список связанных лиц, дата внесения изменений информации о связанном лице");
	
	Для Каждого ЭлементШаблона Из Шаблон Цикл
		ЧастиАдреса = СтрРазделить(ЭлементШаблона.Ключ, ",");
		Если МассивДанныхExcel[Колонки.Найти(ЧастиАдреса[0])][Число(ЧастиАдреса[1]) - 1] <> ЭлементШаблона.Значение Тогда
			Сообщить("Файл не соответвует шаблону. В ячейке " + ЭлементШаблона.Ключ + " ожидается текст: " + ЭлементШаблона.Значение);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьЗначение(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Значение = Формат(Значение, "ЧГ=0");
	КонецЕсли;
	
	Значение = СокрЛП(Строка(Значение));
	
	Возврат Значение;

КонецФункции

&НаКлиенте
Процедура ДополнитьИнформациюОбАЛ(ИнформацияОбАЛ, ALAL, ИмяРеквизита)
	
	Если ALAL.Свойства().Получить(ИмяРеквизита) <> Неопределено Тогда
		Если ТипЗнч(ALAL[ИмяРеквизита]) = Тип("Строка") Тогда
			ИнформацияОбАЛ = ИнформацияОбАЛ + ?(ЗначениеЗаполнено(ИнформацияОбАЛ), "/", "") + ALAL[ИмяРеквизита];
		Иначе
			Для Каждого Значение Из ALAL[ИмяРеквизита] Цикл
				Если Найти(ИнформацияОбАЛ, Значение) = 0 Тогда
					ИнформацияОбАЛ = ИнформацияОбАЛ + ?(ЗначениеЗаполнено(ИнформацияОбАЛ), "/", "") + Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	Схема = ОбъектОбработки.ПолучитьМакет("Схема");
	МакетАЛ_Атом = ОбъектОбработки.ПолучитьМакет("МакетАЛ_Атом");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИННОрганизации(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|					ИЗ
		|						Справочник.Организации КАК Организации
		|					ГДЕ
		|						Организации.Ссылка = &Организация)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИНН;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции
#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

