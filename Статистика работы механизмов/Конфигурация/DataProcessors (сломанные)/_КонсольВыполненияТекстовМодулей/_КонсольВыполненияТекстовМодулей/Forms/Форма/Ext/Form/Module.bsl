	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнятьВПопытке");
	Попытка
		Элементы.ВыполнятьВПопытке.Пометка = Не Элементы.ВыполнятьВПопытке.Пометка
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузить(ПараметрыСессии)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр             = "Данные в формате XML (*.xml)|*.xml";
	Диалог.МножественныйВыбор = Истина;
	
	Если Диалог.Выбрать() Тогда
		ПутьКФайлу = Диалог.ВыбранныеФайлы[0];
		ЗагрузитьНаСервере(ПутьКФайлу);
		ОбновитьПредставлениеФайла();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоказатьСправку(ПараметрыСессии)
	
	Элементы.ПоказатьСправку.Пометка = Не Элементы.ПоказатьСправку.Пометка;
	Элементы.Справка.Видимость = Элементы.ПоказатьСправку.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДобавитьКомментарий(ПараметрыСессии)
	
    НачалоСтроки = 0; НачалоКолонки = 0; КонецСтроки = 0; КонецКолонки = 0;
	Элементы.ТекстМодуля.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстМодуля.ПолучитьТекст());
	
	ПоследняяСтрока = ТекстовыйДокумент.ПолучитьСтроку(КонецСтроки);
	ВыделеноСимволовНаПоследнейСтроке = СтрДлина(Лев(ПоследняяСтрока, КонецКолонки - 1));
	ЗакомментироватьПоследнююСтроку = Истина;
	Если (НачалоСтроки <> КонецСтроки) И ВыделеноСимволовНаПоследнейСтроке = 0 Тогда
		ЗакомментироватьПоследнююСтроку = Ложь;
	КонецЕсли;
    
    МаксимальныйОтступ = 0;
    МинимальныйОтступ = 0;
    Для i = НачалоСтроки По КонецСтроки Цикл
        Строка = ТекстовыйДокумент.ПолучитьСтроку(i);
        Строка = СтрЗаменить(Строка, "  ", "    ");
        СимволовСлева = Найти(Строка, СокрЛП(Строка));
        МаксимальныйОтступ = Макс(СимволовСлева, МаксимальныйОтступ);
        МинимальныйОтступ = ?(МинимальныйОтступ = 0, МаксимальныйОтступ, МинимальныйОтступ);
        МинимальныйОтступ  = Мин(МаксимальныйОтступ, МинимальныйОтступ );
    КонецЦикла;
    
    ТексДляВыделения = "";
	КонСтроки = ?(ЗакомментироватьПоследнююСтроку, КонецСтроки, КонецСтроки - 1); 
    Для i = НачалоСтроки По КонСтроки Цикл
        Строка = ТекстовыйДокумент.ПолучитьСтроку(i);
        Строка = СтрЗаменить(Строка, "  ", "    ");
        Строка = Лев(Строка, МинимальныйОтступ-1) + "//" + Сред(Строка, МинимальныйОтступ);
        ТекстовыйДокумент.ЗаменитьСтроку(i, Строка);
        ТексДляВыделения = ТексДляВыделения + Символы.ПС + Строка;
    КонецЦикла;
    
    ТекстМодуля.УстановитьТекст(ТекстовыйДокумент.ПолучитьТекст());
    
    ЭтаФорма.ТекущийЭлемент = Элементы.ТекстМодуля;	
	ЭтаФорма.ОбновитьОтображениеДанных();    
    Элементы.ТекстМодуля.УстановитьГраницыВыделения(НачалоСтроки, 1, КонецСтроки + ?(ЗакомментироватьПоследнююСтроку, 1, 0), 1); 

	ТекстМодуляПриИзменении(Неопределено);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдалитьКомментарий(ПараметрыСессии)
	
    НачалоСтроки = 0; НачалоКолонки = 0; КонецСтроки = 0; КонецКолонки = 0;
    Элементы.ТекстМодуля.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);		
    
    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.УстановитьТекст(ТекстМодуля.ПолучитьТекст());
	
	ПоследняяСтрока = ТекстовыйДокумент.ПолучитьСтроку(КонецСтроки);
	ВыделеноСимволовНаПоследнейСтроке = СтрДлина(Лев(ПоследняяСтрока, КонецКолонки - 1));
	ЗакомментироватьПоследнююСтроку = Истина;
	Если (НачалоСтроки <> КонецСтроки) И ВыделеноСимволовНаПоследнейСтроке = 0 Тогда
		ЗакомментироватьПоследнююСтроку = Ложь;
	КонецЕсли;
    
	КонСтроки = ?(ЗакомментироватьПоследнююСтроку, КонецСтроки, КонецСтроки - 1); 
    Для i = НачалоСтроки По КонСтроки Цикл
        Строка = ТекстовыйДокумент.ПолучитьСтроку(i);
        Вхождение = Найти(Строка, "//");
        Если Вхождение > 0 Тогда
            Строка = Лев(Строка, Вхождение-1) + Сред(Строка, Вхождение + 2);
        КонецЕсли; 
        ТекстовыйДокумент.ЗаменитьСтроку(i, Строка);
    КонецЦикла;
    
    ТекстМодуля.УстановитьТекст(ТекстовыйДокумент.ПолучитьТекст());
	
    ЭтаФорма.ТекущийЭлемент = Элементы.ТекстМодуля;	
	ЭтаФорма.ОбновитьОтображениеДанных();    
	Элементы.ТекстМодуля.УстановитьГраницыВыделения(НачалоСтроки, 1, КонецСтроки + ?(ЗакомментироватьПоследнююСтроку, 1, 0), 1);

	ТекстМодуляПриИзменении(Неопределено);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКонструкторФорматнойСтроки(ПараметрыСессии)
	
	Текст = Элементы.ТекстМодуля.ВыделенныйТекст;
	Кавычки = "";
	Если СтрНачинаетсяС(Текст, """") И СтрЗаканчиваетсяНа(Текст, """") Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст)-2);
		Кавычки = """";
	КонецЕсли; 
	ОписаниеОповещения = Новый ОписаниеОповещения("СконструированаФорматнаяСтрока", ЭтаФорма, Новый Структура("Кавычки", Кавычки));
	Конструктор = Новый КонструкторФорматнойСтроки(Текст);
	Конструктор.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКонструкторЗапроса(ПараметрыСессии)
	
	Кавычки = "";
	Если ЗначениеЗаполнено(Элементы.ТекстМодуля.ВыделенныйТекст) Тогда
		ТекстЗапроса = СтрЗаменить(СтрЗаменить(Элементы.ТекстМодуля.ВыделенныйТекст, """""", """"), "|", "");
		Если СтрНачинаетсяС(ТекстЗапроса, """") И СтрЗаканчиваетсяНа(ТекстЗапроса, """") Тогда
			ТекстЗапроса = Сред(ТекстЗапроса, 2, СтрДлина(ТекстЗапроса)-2);
			Кавычки = """";
		КонецЕсли; 
		Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);
	Иначе
		Кавычки = """";
		Конструктор = Новый КонструкторЗапроса();
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СконструированЗапрос", ЭтаФорма, Новый Структура("Кавычки", Кавычки));
	Конструктор.Показать(ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВставитьПараметрыМодуля(ПараметрыСессии)
	
	ИмяПараметра = Элементы.ТекстМодуля.ВыделенныйТекст;
	Элементы.ТекстМодуля.ВыделенныйТекст = "ПараметрыМодуля." + ИмяПараметра;
	
	Если ЗначениеЗаполнено(ИмяПараметра) Тогда
		
		ТекИдентификатор = Элементы.Тексты.ТекущиеДанные.ИдентификаторТекста;
		
		НайденныеСтроки = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторТекста, Параметр", ТекИдентификатор, ИмяПараметра));
		Если НайденныеСтроки.Количество() = 0 Тогда
		
			НоваяСтрока = ТаблицаПараметров.Добавить();
			НоваяСтрока.Параметр = ИмяПараметра;
			НоваяСтрока.ИдентификаторТекста = ТекИдентификатор;			
						
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВставитьВывестиКоллекцию(ПараметрыСессии)
	ИмяКоллекции = Элементы.ТекстМодуля.ВыделенныйТекст;
	Если ЗначениеЗаполнено(ИмяКоллекции) Тогда
		Элементы.ТекстМодуля.ВыделенныйТекст = "ВывестиКоллекцию(" + ИмяКоллекции + ");";
	Иначе
		Элементы.ТекстМодуля.ВыделенныйТекст = "ВывестиКоллекцию(";
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВставитьСообщение(ПараметрыСессии)
	
	Сообщение = "Сообщить(" + Элементы.ТекстМодуля.ВыделенныйТекст + ");";
	
	НачалоСтроки = 0; НачалоКолонки = 0; КонецСтроки = 0; КонецКолонки = 0;
	Элементы.ТекстМодуля.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	
	ЭтаФорма.ТекстМодуля.ВставитьСтроку(КонецСтроки + 1, Сообщение);
	
	ЭтаФорма.ТекущийЭлемент = Элементы.ТекстМодуля;	
	ЭтаФорма.ОбновитьОтображениеДанных();    
    
	Элементы.ТекстМодуля.УстановитьГраницыВыделения(КонецСтроки + 1, 1, КонецСтроки + 1, 1); 
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция
&НаКлиенте
Процедура ВыполнитьВставитьВнешнийМодуль(ПараметрыСессии, Команда)

	ИмяМетода = Элементы.ТекстМодуля.ВыделенныйТекст;
	Элементы.ТекстМодуля.ВыделенныйТекст = "ВнешнийМодуль." + ИмяМетода;


КонецПроцедуры
 ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("ЭтаОбработка");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

