
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	ОбработкаНаСервере = РеквизитФормыВЗначение("ЭтаОбработка");
	ЭтаФорма.ВерсияДополнительногоОтчетаИлиОбработки = ОбработкаНаСервере.СведенияОВнешнейОбработке().Версия;
		
	Если Метаданные.ПараметрыСеанса.Найти("ЭтоРабочаяИнформационнаяБаза") <> Неопределено 
		И ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза 
		И Не РольДоступна("ПолныеПрава") Тогда
		Отказ = Истина;
	КонецЕсли; 
	
	ЭтаФорма.Справка.УстановитьHTML(ОбработкаНаСервере.ПолучитьМакет("Справка").ПолучитьТекст(), Новый Структура);
	Элементы.КомментарийКТекстуМодуля.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.Тексты.Количество() = 0 Тогда
		НоваяСтрока = ЭтаФорма.Тексты.Добавить();
		НоваяСтрока.ИдентификаторТекста = Новый УникальныйИдентификатор;
		НоваяСтрока.Наименование = "Текст";
	КонецЕсли; 
	ТребуетсяОбновлениеВнешнегоМодуля = ЗначениеЗаполнено(ТекстВнешнегоМодуля);
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ТекстМодуляПриИзменении(Элемент)
	ТекДанные = Элементы.Тексты.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		ТекДанные.ТекстМодуля = ТекстМодуля.ПолучитьТекст();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекстыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Тексты.ТекущиеДанные;
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекДанные.ИдентификаторТекста = Новый УникальныйИдентификатор;
		ТекДанные.Наименование = "Текст";
	КонецЕсли; 
	
	Если Копирование Тогда
		
		МассивПараметров = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторТекста", ТекДанные.ИдентификаторТекста));
		ТекДанные.ИдентификаторТекста = Новый УникальныйИдентификатор;
		
		Для каждого Параметр Из МассивПараметров Цикл
			НоваяСтрока = ЭтаФорма.ТаблицаПараметров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметр,, "ИдентификаторТекста");
			НоваяСтрока.ИдентификаторТекста = ТекДанные.ИдентификаторТекста;
		КонецЦикла;
		
	КонецЕсли; 
	
	Элементы.ТаблицаПараметров.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторТекста", ТекДанные.ИдентификаторТекста));
	ТекстМодуля.УстановитьТекст(ТекДанные.ТекстМодуля);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.Тексты.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		Элементы.ТаблицаПараметров.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторТекста", ТекДанные.ИдентификаторТекста));
		ТекстМодуля.УстановитьТекст(ТекДанные.ТекстМодуля);
	Иначе
		Элементы.ТаблицаПараметров.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторТекста", Неопределено));
		ТекстМодуля.УстановитьТекст("");
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Тексты.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		ТекДанныеПараметры = Элементы.ТаблицаПараметров.ТекущиеДанные;
		ТекДанныеПараметры.ИдентификаторТекста = ТекДанные.ИдентификаторТекста;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстыПередУдалением(Элемент, Отказ)
	
	ТекИдентификатор = Элементы.Тексты.ТекущиеДанные.ИдентификаторТекста;
	НайденныеСтроки = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторТекста", ТекИдентификатор));
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		ЭтаФорма.ТаблицаПараметров.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровСписокЗначенийПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	Если ТекДанные.СписокЗначений Тогда
		
		ТекЗначение = ТекДанные.ЗначениеПараметра;
		ТекДанные.ЗначениеПараметра = Новый СписокЗначений;
		Если ТекЗначение <> Неопределено Тогда
		
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ТипЗнч(ТекЗначение));
			ТекДанные.ЗначениеПараметра.ТипЗначения = Новый ОписаниеТипов(МассивТипов);
			ТекДанные.ЗначениеПараметра.Добавить(ТекЗначение);			
		
		КонецЕсли; 
		
	ИначеЕсли ТекДанные.ЗначениеПараметра.Количество() > 0 Тогда
		ТекДанные.ЗначениеПараметра = ТекДанные.ЗначениеПараметра[0].Значение;
	Иначе
		ТекДанные.ЗначениеПараметра = Неопределено;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровЗначениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	Элемент.ВыбиратьТип = (ТекДанные.ЗначениеПараметра = Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровЗначениеПараметраОчистка(Элемент, СтандартнаяОбработка)
	Элемент.ВыбиратьТип = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровЗначениеПараметраПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	ТекДанные.СписокЗначений = (ТипЗнч(ТекДанные.ЗначениеПараметра) = Тип("СписокЗначений"));
КонецПроцедуры

#КонецОбласти 

