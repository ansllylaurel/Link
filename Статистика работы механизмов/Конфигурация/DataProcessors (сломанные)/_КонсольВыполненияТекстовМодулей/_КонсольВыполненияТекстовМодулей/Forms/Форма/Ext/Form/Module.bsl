&НаКлиенте
Процедура СконструированЗапрос(Текст, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Текст) = Тип("Строка") Тогда
		ПолучитьПараметрыИзТекстаЗапросаНаСервере(Текст);
		Элементы.ТекстМодуля.ВыделенныйТекст = ДополнительныеПараметры.Кавычки + СтрЗаменить(СтрЗаменить(Текст, """", """"""), Символы.ПС, Символы.ПС + Символы.Таб + "|") + ДополнительныеПараметры.Кавычки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПараметрыИзТекстаЗапросаНаСервере(ТекстЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	ОписаниеПараметров = Запрос.НайтиПараметры();
	
	ТекСтрока = ЭтаФорма.Тексты.НайтиПоИдентификатору(Элементы.Тексты.ТекущаяСтрока);
	Если ТекСтрока <> Неопределено Тогда
	
		Для каждого Параметр Из ОписаниеПараметров Цикл
			
			НайденныеСтроки = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("Параметр, ИдентификаторТекста", Параметр.Имя, ТекСтрока.ИдентификаторТекста));
			Если НайденныеСтроки.Количество() = 0 Тогда
			
				НоваяСтрока = ЭтаФорма.ТаблицаПараметров.Добавить();
				НоваяСтрока.Параметр = Параметр.Имя;
				НоваяСтрока.ИдентификаторТекста = ТекСтрока.ИдентификаторТекста;
				НоваяСтрока.ЗначениеПараметра = Параметр.ТипЗначения.ПривестиЗначение();
			
			КонецЕсли; 
			
		КонецЦикла;		
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

&НаСервереБезКонтекста
Процедура ВывестиТаблицуЗначений(МассивТаблицЗначенийДляВывода, ТаблицаЗначений, НаименованиеТаблицы = Неопределено)

	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаЗначений, , , , Истина);    
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	МассивТаблицЗначенийДляВывода.Добавить(ПараметрыВывода.ДокументРезультат, НаименованиеТаблицы);
	
КонецПроцедуры 

&НаКлиенте 
Процедура ОбновитьПредставлениеФайла()
	
	Файл = Новый Файл(ПутьКФайлу);
	
	Элементы.ПредставлениеФайла.Заголовок = Файл.Имя;
	Элементы.ПредставлениеФайла.Подсказка = ПутьКФайлу;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Процедура ВывестиКоллекцию(МассивТаблицЗначенийДляВывода, Коллекция, ВыводитьТипыЗначений = Истина, НаименованиеКоллекции = Неопределено)

	ЭтоМассив 			= (ТипЗнч(Коллекция) = Тип("Массив") Или ТипЗнч(Коллекция) = Тип("ФиксированныйМассив"));
	ЭтоСписокЗначений 	= (ТипЗнч(Коллекция) = Тип("СписокЗначений"));
	ЭтоСтруктура 		= (ТипЗнч(Коллекция) = Тип("Структура") Или ТипЗнч(Коллекция) = Тип("ФиксированнаяСтруктура"));
	ЭтоСоответствие 	= (ТипЗнч(Коллекция) = Тип("Соответствие") Или ТипЗнч(Коллекция) = Тип("ФиксированноеСоответствие"));
		
	Если Не ЗначениеЗаполнено(НаименованиеКоллекции) Тогда 	
		НаименованиеКоллекции = Строка(ТипЗнч(Коллекция));
	КонецЕсли;	
	
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
	
		ВывестиТаблицуЗначений(МассивТаблицЗначенийДляВывода, Коллекция, НаименованиеКоллекции);
		Возврат;
	
	КонецЕсли; 
	
	ТаблицаДляВывода = Новый ТаблицаЗначений; 
	КолонкиСозданы = Ложь;
	
	Для Каждого Эл Из Коллекция Цикл 
		
		Если Не КолонкиСозданы Тогда
		
			КолонкиСозданы = Истина;
			
			Если ЭтоМассив Тогда
				
				ТаблицаДляВывода.Колонки.Добавить("Значение");
				Если ВыводитьТипыЗначений Тогда
					ТаблицаДляВывода.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка"));
				КонецЕсли; 
				
			ИначеЕсли ЭтоСписокЗначений Тогда
				
				ТаблицаДляВывода.Колонки.Добавить("Представление");
				ТаблицаДляВывода.Колонки.Добавить("Значение");
				Если ВыводитьТипыЗначений Тогда
					ТаблицаДляВывода.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка"));
				КонецЕсли; 
				ТаблицаДляВывода.Колонки.Добавить("Пометка");
				
			ИначеЕсли ЭтоСтруктура Тогда
				ТаблицаДляВывода.Колонки.Добавить("Ключ");
				ТаблицаДляВывода.Колонки.Добавить("Значение");
				Если ВыводитьТипыЗначений Тогда
					ТаблицаДляВывода.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка"));
				КонецЕсли; 
			ИначеЕсли ЭтоСоответствие Тогда
				ТаблицаДляВывода.Колонки.Добавить("Ключ");
				Если ВыводитьТипыЗначений Тогда
					ТаблицаДляВывода.Колонки.Добавить("ТипКлюча");
				КонецЕсли;
				ТаблицаДляВывода.Колонки.Добавить("Значение");
				Если ВыводитьТипыЗначений Тогда
					ТаблицаДляВывода.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("Строка"));
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли; 
		
		НоваяСтрока = ТаблицаДляВывода.Добавить();
		
		Если ЭтоМассив Тогда
			
			НоваяСтрока.Значение = Эл;
			Если ВыводитьТипыЗначений Тогда
				НоваяСтрока.ТипЗначения = ТипЗнч(Эл);
			КонецЕсли; 
			
		ИначеЕсли ЭтоСписокЗначений Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Эл);
			Если ВыводитьТипыЗначений Тогда
				НоваяСтрока.ТипЗначения = ТипЗнч(Эл.Значение);
			КонецЕсли; 
			
		ИначеЕсли ЭтоСтруктура Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Эл);
			Если ВыводитьТипыЗначений Тогда
				НоваяСтрока.ТипЗначения = ТипЗнч(Эл.Значение);
			КонецЕсли; 
			
		ИначеЕсли ЭтоСоответствие Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Эл);
			Если ВыводитьТипыЗначений Тогда
				НоваяСтрока.ТипЗначения = ТипЗнч(Эл.Значение);
			КонецЕсли; 
			Если ВыводитьТипыЗначений Тогда
				НоваяСтрока.ТипКлюча = ТипЗнч(Эл.Ключ);
			КонецЕсли; 
			
		КонецЕсли; 
				
	КонецЦикла;
	
	ВывестиТаблицуЗначений(МассивТаблицЗначенийДляВывода, ТаблицаДляВывода, НаименованиеКоллекции);
		
КонецПроцедуры

&НаКлиенте
Процедура КомментарийКТекстуМодуляНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Элементы[ОписаниеОшибкиЭлемент].УстановитьГраницыВыделения(
		ОписаниеОшибкиНомерСтроки, 
		ОписаниеОшибкиНачалоСтроки, 
		ОписаниеОшибкиНомерСтроки, 
		ОписаниеОшибкиНачалоСтроки + СтрДлина(ОписаниеОшибкиТекстОшибки));
	ЭтаФорма.ТекущийЭлемент = Элементы[ОписаниеОшибкиЭлемент];
	
КонецПроцедуры

