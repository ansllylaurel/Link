#Область Параметры_модулей

&НаКлиенте
Процедура ОбновитьТаблицуПараметров()
	
	ИсходныеПараметры.Очистить();
	Для каждого СтрокаПараметров Из ТаблицаПараметров Цикл
		ЗаполнитьЗначенияСвойств(ИсходныеПараметры.Добавить(), СтрокаПараметров);
	КонецЦикла; 
	
	ТекИдентификатор = Элементы.Тексты.ТекущиеДанные.ИдентификаторТекста;
	НайденныеСтроки = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторТекста", ТекИдентификатор));
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		ЭтаФорма.ТаблицаПараметров.Удалить(ТекСтрока);
	КонецЦикла; 
	
	МассивПараметров = ПолучитьПараметрыМодуля();
		
	Для каждого Элемент Из МассивПараметров Цикл
		
		НайденныеСтроки = ИсходныеПараметры.НайтиСтроки(Новый Структура("Параметр, ИдентификаторТекста", Элемент, ТекИдентификатор));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаПараметров.Добавить(), НайденныеСтроки[0]);
		Иначе
			НоваяСтрока = ТаблицаПараметров.Добавить();
			НоваяСтрока.Параметр = Элемент;
			НоваяСтрока.ИдентификаторТекста = ТекИдентификатор;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыМодуля()
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	
	RegExp.Global     = Истина;
	RegExp.IgnoreCase = Истина;
	RegExp.MultiLine  = Истина;
	
	RegExp.Pattern = "\ПараметрыМодуля.*?[\;\+\-\*\\\s\)]";
	НайденныеСтроки = RegExp.Execute(ЭтаФорма.ТекстМодуля.ПолучитьТекст());
	
	Спецсимволы = СтрРазделить("ПараметрыМодуля|)|.|,|""|;|+|-|*|/", "|", Ложь);
	МассивПараметров = Новый Массив;
	
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл	
		
		Параметр = ТекСтрока.Value;
		
		Для каждого Спецсимвол Из Спецсимволы Цикл
			Параметр = СтрЗаменить(Параметр, Спецсимвол, "");
		КонецЦикла;
		
		Если МассивПараметров.Найти(Параметр) = Неопределено Тогда
			МассивПараметров.Добавить(Параметр);
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат МассивПараметров;
	
КонецФункции

#КонецОбласти 

#Область Выполнение_текста_модуля

&НаСервереБезКонтекста
Процедура ВыполнитьНаСервереБезКонтекста(_ТекстМодуля, ПараметрыМодуля, _ТекстВнешнегоМодуля, _МассивТаблицЗначенийДляВывода, _ТребуетсяОбновлениеВнешнегоМодуля)
	
	ВнешнийМодуль = Неопределено;
	
	ПодключитьВнешнийМодуль(_ТекстМодуля, ВнешнийМодуль, _ТекстВнешнегоМодуля, _ТребуетсяОбновлениеВнешнегоМодуля);
	
	Выполнить(_ТекстМодуля);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодключитьВнешнийМодуль(ТекстМодуля, ВнешнийМодуль, ТекстВнешнегоМодуля, ТребуетсяОбновлениеВнешнегоМодуля, ВызовСКлиента = Ложь)

	ЕстьОбращениеКВнешнемуМодулю = (СтрНайти(НРег(ТекстМодуля), "внешниймодуль.") > 0);
	
	Если ЕстьОбращениеКВнешнемуМодулю И ТребуетсяОбновлениеВнешнегоМодуля Тогда
		ВнешнийМодуль = СоздатьВнешнийМодуль(ТекстВнешнегоМодуля);
		ТребуетсяОбновлениеВнешнегоМодуля = Ложь;
	ИначеЕсли ЕстьОбращениеКВнешнемуМодулю Тогда
		ВнешнийМодуль = ВнешниеОбработки.Создать("ВнешнийМодуль");
	КонецЕсли; 
	
	Если ВызовСКлиента Тогда
		ВнешнийМодуль = Неопределено;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаменитьВызовВыводаКоллекции(ТекстМодуля)

	ТекстМодуляНРег = НРег(ТекстМодуля);
	
	ПодстрокаПоиска = "вывестиколлекцию(";
	ДлинаПодстрокиПоиска = СтрДлина(ПодстрокаПоиска);
	ЧислоВхождений = СтрЧислоВхождений(ТекстМодуляНРег, ПодстрокаПоиска);
	
	Для НомерВхождения = 1 По ЧислоВхождений Цикл
		ПозицияВызова = СтрНайти(ТекстМодуляНРег, ПодстрокаПоиска, НаправлениеПоиска.СКонца,, НомерВхождения);
		МестоВставки = ПозицияВызова + ДлинаПодстрокиПоиска;
		ТекстМодуля = Лев(ТекстМодуля, МестоВставки-1) + "_МассивТаблицЗначенийДляВывода, " + Сред(ТекстМодуля, МестоВставки);
	КонецЦикла; 

КонецПроцедуры
 
&НаКлиенте
Процедура ПодготовитьИВыполнитьТекстМодуля(_НаСервере)

	ПараметрыМодуля = ПолучитьПарамметрыМодуля(Элементы.Тексты.ТекущиеДанные.ИдентификаторТекста);
	
	ВыполняемыйТекст = ТекстМодуля.ПолучитьТекст();
	ЗаменитьВызовВыводаКоллекции(ВыполняемыйТекст);
	
	_МассивТаблицЗначенийДляВывода = Новый СписокЗначений;
	
	Если Элементы.ВыполнятьВПопытке.Пометка Тогда
	
		Попытка
			
			ВыполнитьТекстМодуля(_НаСервере, ВыполняемыйТекст, ПараметрыМодуля, _МассивТаблицЗначенийДляВывода);
			
		Исключение
			
			Элементы.ТекстМодуля.ЦветТекста = Новый Цвет(255, 0, 0);
			Элементы.КомментарийКТекстуМодуля.Видимость = Истина;
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ОписаниеОшибкиНачалоСтроки = 1;
			
			Если СтрНайти(ИнформацияОбОшибке.ИмяМодуля, "ВнешняяОбработка.ВнешнийМодуль") > 0
				Или СтрНайти(ПодробноеПредставлениеОшибки, "ВнешняяОбработка.ВнешнийМодуль") > 0 Тогда
				ОписаниеОшибкиЭлемент = "ТекстВнешнегоМодуля";
				ПодстрокаЗамены = "{ВнешняяОбработка.ВнешнийМодуль.МодульОбъекта";
			Иначе
				ОписаниеОшибкиЭлемент = "ТекстМодуля";
				ПодстрокаЗамены = "{<Неизвестный модуль>";
			КонецЕсли;
						
			Если СтрНачинаетсяС(КраткоеПредставлениеОшибки, ПодстрокаЗамены) Тогда
				// Синтаксическая ошибка в модуле
				КомментарийКТекстуМодуля = СтрЗаменить(КраткоеПредставлениеОшибки, ПодстрокаЗамены, "{");
				
				ПозицияСкобки = СтрНайти(КомментарийКТекстуМодуля, "}");
				
				Координаты = СтрЗаменить(СтрЗаменить(Лев(КомментарийКТекстуМодуля, ПозицияСкобки), "{(", ""), ")}", "");
				МассивКоординат = СтрРазделить(Координаты, ",");
				
				ОписаниеОшибкиНомерСтроки = МассивКоординат[0];
				ОписаниеОшибкиНачалоСтроки = МассивКоординат[1] - ?(СтрНайти(ПодробноеПредставлениеОшибки, "_МассивТаблицЗначенийДляВывода, ") > 0, 32, 0);
				
				ОписаниеОшибкиТекстОшибки = "";
			
			ИначеЕсли СтрНачинаетсяс(ПодробноеПредставлениеОшибки, "Итератор для значения не определен") 
				И СтрНайти(ПодробноеПредставлениеОшибки, "ВывестиКоллекцию") > 0 Тогда
				// Ошибка вывода в коллекцию
				ИсходнаяСтрока = СтрЗаменить(СтрПолучитьСтроку(ПодробноеПредставлениеОшибки, 3), "_МассивТаблицЗначенийДляВывода, ", "");
				ПозицияДвоеточия = СтрНайти(ИсходнаяСтрока, ":");
				
				КомментарийКТекстуМодуля = СтрШаблон("%1 %2 (%3)",
					СтрЗаменить(Лев(ИсходнаяСтрока, ПозицияДвоеточия), ")}", ", 1)}"),
					КраткоеПредставлениеОшибки,
					Сред(ИсходнаяСтрока, ПозицияДвоеточия + 1));
					
				ОписаниеОшибкиНомерСтроки = СтрЗаменить(СтрЗаменить(Лев(ИсходнаяСтрока, ПозицияДвоеточия - 1), "{(", ""), ")}", "");
				ОписаниеОшибкиТекстОшибки = Сред(ИсходнаяСтрока, ПозицияДвоеточия + 1);
				
			ИначеЕсли ТипЗнч(ИнформацияОбОшибке.Причина) = Тип("ИнформацияОбОшибке") Тогда
				
				КомментарийКТекстуМодуля = СтрШаблон("{(%1, %2)}: %3 (%4)",
					ИнформацияОбОшибке.НомерСтроки,
					1,
					ИнформацияОбОшибке.Описание + "; " + ИнформацияОбОшибке.ИсходнаяСтрока,
					КраткоеПредставлениеОшибки);
					
				ОписаниеОшибкиНомерСтроки = ИнформацияОбОшибке.НомерСтроки;
				ОписаниеОшибкиТекстОшибки = ИнформацияОбОшибке.ИсходнаяСтрока;
					
			Иначе
				
				КомментарийКТекстуМодуля = "{(" + ИнформацияОбОшибке.НомерСтроки + ", 1)}: " + ИнформацияОбОшибке.Описание + " (" + ИнформацияОбОшибке.ИсходнаяСтрока + ")";
				
				ОписаниеОшибкиНомерСтроки = ИнформацияОбОшибке.НомерСтроки;
				ОписаниеОшибкиТекстОшибки = ИнформацияОбОшибке.ИсходнаяСтрока;
				
			КонецЕсли; 
						
		КонецПопытки;
		
	Иначе
		
		ВыполнитьТекстМодуля(_НаСервере, ВыполняемыйТекст, ПараметрыМодуля, _МассивТаблицЗначенийДляВывода);
	
	КонецЕсли; 
	
	Для каждого ЭлементКоллекции Из _МассивТаблицЗначенийДляВывода Цикл
		ЭлементКоллекции.Значение.Показать(ЭлементКоллекции.Представление);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТекстМодуля(_НаСервере, ВыполняемыйТекст, ПараметрыМодуля, _МассивТаблицЗначенийДляВывода)

	Если _НаСервере Тогда
		ВыполнитьНаСервереБезКонтекста(
			ВыполняемыйТекст, 
			ПараметрыМодуля, 
			ТекстВнешнегоМодуля, 
			_МассивТаблицЗначенийДляВывода, 
			ТребуетсяОбновлениеВнешнегоМодуля);
	Иначе
		
		ПодключитьВнешнийМодуль(ВыполняемыйТекст, , ТекстВнешнегоМодуля, ТребуетсяОбновлениеВнешнегоМодуля, Истина);
		
		ЗаменитьВызовВнешнегоМодуля(ВыполняемыйТекст, ТекстВнешнегоМодуля);
		
		Выполнить(ВыполняемыйТекст);
		
	КонецЕсли;
	
	Элементы.ТекстМодуля.ЦветТекста = Новый Цвет(0, 0, 0);
	Элементы.КомментарийКТекстуМодуля.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПарамметрыМодуля(ИдентификаторТекста)

	ПараметрыМодуля = Новый Структура;
	НайденныеСтроки = ЭтаФорма.ТаблицаПараметров.НайтиСтроки(Новый Структура("ИдентификаторТекста", ИдентификаторТекста));
	
	Для каждого ПараметрСтрока Из НайденныеСтроки Цикл
		ПараметрыМодуля.Вставить(ПараметрСтрока.Параметр, ПараметрСтрока.ЗначениеПараметра);
	КонецЦикла;
	
	Возврат ПараметрыМодуля;

КонецФункции

&НаКлиенте
Процедура ЗаменитьВызовВнешнегоМодуля(ТекстМодуля, ТекстВнешнегоМодуля)

	ТекстВнешнегоМодуляНРег = НРег(ТекстВнешнегоМодуля);
	ТекстМодуляНРег = НРег(ТекстМодуля);
	
	ПодстрокаПоиска = "внешниймодуль.";
	ДлинаПодстрокиПоиска = СтрДлина(ПодстрокаПоиска);
	ЧислоВхождений = СтрЧислоВхождений(ТекстМодуляНРег, ПодстрокаПоиска);
	
	Для НомерВхождения = 1 По ЧислоВхождений Цикл
		
		ПозицияВызова = СтрНайти(ТекстМодуляНРег, ПодстрокаПоиска, НаправлениеПоиска.СКонца,, НомерВхождения);
		ПозицияПараметров = СтрНайти(ТекстМодуляНРег, "(", НаправлениеПоиска.СНачала, ПозицияВызова);
		
		// Если текст "функция" ближе текста "процедура", то это функция
		ИмяФункции = Сред(ТекстМодуля, ПозицияВызова + ДлинаПодстрокиПоиска, ПозицияПараметров - ПозицияВызова - ДлинаПодстрокиПоиска);
		ПозицияФункции = СтрНайти(ТекстВнешнегоМодуляНРег, " " + НРег(ИмяФункции) + "(");
		ЭтоФункция = (СтрНайти(ТекстВнешнегоМодуляНРег, "функция", НаправлениеПоиска.СКонца, ПозицияФункции) > СтрНайти(ТекстВнешнегоМодуляНРег, "процедура", НаправлениеПоиска.СКонца, ПозицияФункции));
		
		ТекстМодуля = Лев(ТекстМодуля, ПозицияВызова-1) + "ВыполнитьФункциюВнешнегоМодуля(""" + ИмяФункции + """, " + Формат(ЭтоФункция, "БЛ=Ложь; БИ=Истина") + ", " + Сред(ТекстМодуля, ПозицияПараметров + 1);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьФункциюВнешнегоМодуляОтМассиваПараметров(Имя, Параметры, ВозвращатьРезультат = Истина) Экспорт
	
	Перем РезультатФункци;
	
	ВнешнийМодуль = ВнешниеОбработки.Создать("ВнешнийМодуль");
	
	СтрокаПараметров = Новый Массив;
	Для н = 1 По Параметры.Количество() Цикл
		СтрокаПараметров.Добавить(?(Параметры[н-1] = "#ЗначениеНеПередано#", "", СтрШаблон("Параметры[%1]", н-1)));		
	КонецЦикла;
	
	СтрокаКоманды = ?(ВозвращатьРезультат, "РезультатФункци = ", "") + "ВнешнийМодуль." + Имя + "(" + СтрСоединить(СтрокаПараметров, ", ") + ")";
	
	Выполнить(СтрокаКоманды);
	
	Возврат РезультатФункци;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьФункциюВнешнегоМодуля(Имя, ВозвращатьРезультат = Истина,
		Параметр1 = "#ЗначениеНеПередано#", Параметр2 = "#ЗначениеНеПередано#", Параметр3 = "#ЗначениеНеПередано#", Параметр4 = "#ЗначениеНеПередано#", Параметр5 = "#ЗначениеНеПередано#",
		Параметр6 = "#ЗначениеНеПередано#", Параметр7 = "#ЗначениеНеПередано#", Параметр8 = "#ЗначениеНеПередано#", Параметр9 = "#ЗначениеНеПередано#") Экспорт

	МассивПараметров	= Новый Массив;
	ВсегоПараметров		= 9;
	
	Если	  Параметр9 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 9
	ИначеЕсли Параметр8 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 8
	ИначеЕсли Параметр7 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 7
	ИначеЕсли Параметр6 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 6
	ИначеЕсли Параметр5 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 5
	ИначеЕсли Параметр4 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 4
	ИначеЕсли Параметр3 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 3
	ИначеЕсли Параметр2 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 2
	ИначеЕсли Параметр1 <> "#ЗначениеНеПередано#" Тогда ВсегоПараметров = 1
	Иначе												ВсегоПараметров = 0		
	КонецЕсли;
	
	Если ВсегоПараметров > 0 Тогда
		МассивПараметров.Добавить(Параметр1);
		Если ВсегоПараметров > 1 Тогда
			МассивПараметров.Добавить(Параметр2);
			Если ВсегоПараметров > 2 Тогда
				МассивПараметров.Добавить(Параметр3);
				Если ВсегоПараметров > 3 Тогда
					МассивПараметров.Добавить(Параметр4);
					Если ВсегоПараметров > 4 Тогда
						МассивПараметров.Добавить(Параметр5);
						Если ВсегоПараметров > 5 Тогда
							МассивПараметров.Добавить(Параметр6);
							Если ВсегоПараметров > 6 Тогда
								МассивПараметров.Добавить(Параметр7);
								Если ВсегоПараметров > 7 Тогда
									МассивПараметров.Добавить(Параметр8);
									Если ВсегоПараметров > 8 Тогда
										МассивПараметров.Добавить(Параметр9)
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВыполнитьФункциюВнешнегоМодуляОтМассиваПараметров(Имя, МассивПараметров, ВозвращатьРезультат);
	
КонецФункции

#КонецОбласти 

#Область Сохранение_и_загрузка_текстов

&НаСервере
Процедура СохранитьНаСервере(ИмяФайла)

	// формирование файла
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Данные");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Тексты");
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(ЭтаФорма.Тексты.Выгрузить()));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТаблицаПараметров");
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(ЭтаФорма.ТаблицаПараметров.Выгрузить()));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ТекстВнешнегоМодуля");
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(ЭтаФорма.ТекстВнешнегоМодуля));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();

КонецПроцедуры
 
&НаСервере
Процедура ЗагрузитьНаСервере(ИмяФайла)

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	
	ИмяТекущегоУзла = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяТекущегоУзла = ЧтениеXML.Имя;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Если ИмяТекущегоУзла = "Тексты" Тогда
				ЭтаФорма.Тексты.Загрузить(ДесериализоватьЗначение(ЧтениеXML.Значение));
			ИначеЕсли ИмяТекущегоУзла = "ТаблицаПараметров" Тогда
				ЭтаФорма.ТаблицаПараметров.Загрузить(ДесериализоватьЗначение(ЧтениеXML.Значение));
			ИначеЕсли ИмяТекущегоУзла = "ТекстВнешнегоМодуля" Тогда
				ЭтаФорма.ТекстВнешнегоМодуля = ДесериализоватьЗначение(ЧтениеXML.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СериализоватьЗначение(Знач Значение, ПоместитьЗначениеВХранилище = Истина)
	
	Если ПоместитьЗначениеВХранилище Тогда
		Значение = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписатьXML(ЗаписьXML, Значение);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции // СериализоватьЗначение

&НаСервереБезКонтекста
Функция ДесериализоватьЗначение(СериализованноеЗначение, ВосстановитьИзХранилища = Истина)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СериализованноеЗначение);
	
	Значение = ПрочитатьXML(ЧтениеXML);
	
	Если ВосстановитьИзХранилища Тогда
		Значение = Значение.Получить();
	КонецЕсли;	
	
	Возврат Значение;
	
КонецФункции // ДесериализоватьЗначение

#КонецОбласти 

#Область Внешний_модуль

&НаСервереБезКонтекста
