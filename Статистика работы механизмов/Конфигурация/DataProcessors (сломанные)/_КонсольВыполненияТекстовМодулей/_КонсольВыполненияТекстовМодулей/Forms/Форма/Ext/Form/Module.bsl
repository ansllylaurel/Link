&НаСервереБезКонтекста
Функция СоздатьВнешнийМодуль(ТекстВнешнегоМодуля)
	
	Файл = Новый Файл(ПолучитьИмяВременногоФайла());
	КаталогВыгрузки = КаталогВременныхФайлов() + "ВнешнийМодуль_" + Файл.ИмяБезРасширения + "\";
	
	Файл = Новый Файл(КаталогВыгрузки);
	Если Не Файл.Существует() Тогда
		СоздатьКаталог(КаталогВыгрузки);
	КонецЕсли; 
	
	ПутьККорневомуФайлуВыгрузки = КаталогВыгрузки + "ВнешнийМодуль.xml";
	ПутьКФайлуВнешнейОбработкиИлиОтчета = КаталогВыгрузки + "ВнешнийМодуль.epf";
	
	ФайлХМЛ = Новый ЗаписьТекста(ПутьККорневомуФайлуВыгрузки);
	ФайлХМЛ.Записать(ПолучитьТекстФайлаХМЛ());
	ФайлХМЛ.Закрыть();
	
	КаталогМодуля = КаталогВыгрузки + "ВнешнийМодуль\Ext\";
	
	Файл = Новый Файл(КаталогМодуля);
	Если Не Файл.Существует() Тогда
		СоздатьКаталог(КаталогМодуля);
	КонецЕсли; 
	
	ФайлМодуля = Новый ЗаписьТекста(КаталогМодуля + "ObjectModule.bsl");
	ФайлМодуля.Записать(ТекстВнешнегоМодуля);
	ФайлМодуля.Закрыть();
	
	// В ИТС:
	// Если внешняя обработка (отчет) не содержит ссылок на объекты конфигурации,
	// то выгрузку/загрузку таких объектов можно выполнять без указания параметров подключения к информационной базе
	// По факту:
	// Нужно базу указывать, да еще и следить, чтобы в конфиге не сидел никто
	
	//СтрокаСоединения = " /IBConnectionString """ + СтрЗаменить(СтрокаСоединенияИнформационнойБазы(), """", """""") + """";
	//СтрокаСоединения = СтрЗаменить(СтрокаСоединения, "RedPill", "RedPillExtFAR");
	//СтрокаСоединения = " /S ap35\AssetManagementDemo1";
	СтрокаСоединения = " /S ap69\RedPillTest"; // Использую для дин. обновления, т.е. очень редко и недолго
	//СтрокаСоединения = "";
	
	СтрокаКоманды = КаталогПрограммы() + "1cv8.exe DESIGNER " + СтрокаСоединения + " /LoadExternalDataProcessorOrReportFromFiles """ + ПутьККорневомуФайлуВыгрузки + """ """ + ПутьКФайлуВнешнейОбработкиИлиОтчета + """";
	
	КодВозврата = Неопределено;
	ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
	
	Если ТипЗнч(КодВозврата) = Тип("Число") И КодВозврата = 0 Тогда
		ВнешнийМодуль = ВнешниеОбработки.Создать(ПутьКФайлуВнешнейОбработкиИлиОтчета, Ложь);
	КонецЕсли; 
	
	УдалитьФайлы(КаталогВыгрузки);
	
	Возврат ВнешнийМодуль;
	
КонецФункции

