

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры


&НаСервере
Процедура ПриОткрытииНаСервере()
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период=ТекущаяДата();
КонецПроцедуры


&НаКлиенте
Процедура ЗагрузитьФайлКоманда(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ЗагрузитьФайлКоманда");
	Попытка
		ВыполнитьЗагрузитьФайлКоманда(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры
&НаКлиенте
Процедура ВыполнитьЗагрузитьФайлКоманда(ПараметрыСессии)

		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогВыбора.МножественныйВыбор=Ложь;
		ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls)|*.xls";
		Если Не ДиалогВыбора.Выбрать() Тогда
			Возврат;
		КонецЕсли;

		Объект.СписокПерестраховщиков.Очистить();
		ТаблицаXLS.Очистить();

		НазваниеФайла=СтрЗаменить(ДиалогВыбора.ПолноеИмяФайла,ДиалогВыбора.Каталог,"");
		ПерваяТочка=СтрНайти(НазваниеФайла,".",,,1);

		СчетДоверительногоУправленияСтрока = Сред(НазваниеФайла,1,ПерваяТочка-1);
		//"000000099" - жизнь 240
		//"000000082" - иное 250
		//"000000091" - иное 255
		СчетДоверительногоУправленияСсылка=ОпределениеСчетаДоверительногоУправления(СчетДоверительногоУправленияСтрока,Объект.Организация);

		Если ЗначениеЗаполнено(СчетДоверительногоУправленияСсылка) Тогда
			Объект.СчетДоверительногоУправления=СчетДоверительногоУправленияСсылка;
		КонецЕсли;

		Excel = Новый COMОбъект("Excel.Application");
		//Excel.WindowState = -4140;
		//Excel.Visible = True;
		WorkBooks=Excel.WorkBooks.Open(ДиалогВыбора.ПолноеИмяФайла);

		СчетчикСтрок=8;

		ЭтоЧисло=Истина;
		Попытка
			ЧислоВрм=Число(WorkBooks.Worksheets(1).Cells(СчетчикСтрок,2).Value);
			Исключение
			ЭтоЧисло=Ложь;
		КонецПопытки;

		Пока ЭтоЧисло Цикл
			Строка=ТаблицаXLS.Добавить();
			Строка.ИНН=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,2).Text;
			Строка.КодСтраны=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,3).Text;
			Строка.Перестраховщик=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,4).Text;
			Строка.КодДоли=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,5).Text;
			Строка.СуммаЖизнь=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,6).Value;
			Строка.СуммаИное=WorkBooks.Worksheets(1).Cells(СчетчикСтрок,7).Value;
			Результат=ПроверкаКодДоли(Строка.КодДоли,СчетчикСтрок);
			Если Результат="240" Тогда
				Строка.СуммаЖизнь240=Строка.СуммаЖизнь+Строка.СуммаИное;
				Строка.СуммаИное250=0;
				Строка.СуммаИное255=0;
				ИначеЕсли Результат="250" Тогда
					Строка.СуммаЖизнь240=0;
					Строка.СуммаИное250=Строка.СуммаЖизнь+Строка.СуммаИное;
					Строка.СуммаИное255=0;
					ИначеЕсли Результат="255" Тогда
						Строка.СуммаЖизнь240=0;
						Строка.СуммаИное250=0;
						Строка.СуммаИное255=Строка.СуммаЖизнь+Строка.СуммаИное;
					КонецЕсли;

					СчетчикСтрок=СчетчикСтрок+1;
					ЭтоЧисло=Истина;
					Попытка
						ЧислоВрм=Число(WorkBooks.Worksheets(1).Cells(СчетчикСтрок,1).Text);
						Исключение
						ЭтоЧисло=Ложь;
					КонецПопытки;
				КонецЦикла;
				Excel.Quit();
				ЗаполнитьОсновнуюТаблицу();
				ЗаполнитьОстатки();

КонецПроцедуры




&НаСервере
Функция ПроверкаКодДоли(КодДоли,СчетчикСтрок)
	Результат="";
	КодДолиФункция=";"+СокрЛП(КодДоли)+";";
	Если Найти(";11100;", КодДолиФункция)>=1 Тогда
		Результат="240";
	ИначеЕсли Найти(";11104;11102;11204;41104;41102;", КодДолиФункция)>=1 Тогда
		Результат="250";
	ИначеЕсли Найти(";11103;11101;11203;41103;41101;", КодДолиФункция)>=1 Тогда
		Результат="255";
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Непонятен код доли('"+КодДоли+"') в строке - "+Строка(СчетчикСтрок);
		Сообщение.Сообщить();
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьОсновнуюТаблицу()
	
	Объект.СписокПерестраховщиков.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаXLS.КодСтраны КАК КодСтраны,
		|	ТаблицаXLS.КодДоли КАК КодДоли,
		|	ТаблицаXLS.ИНН КАК ИНН,
		|	ТаблицаXLS.Перестраховщик КАК Перестраховщик,
		|	ТаблицаXLS.СуммаЖизнь240 КАК СуммаЖизнь240,
		|	ТаблицаXLS.СуммаИное250 КАК СуммаИное250,
		|	ТаблицаXLS.СуммаИное255 КАК СуммаИное255
		|ПОМЕСТИТЬ _ТаблицаXLS
		|ИЗ
		|	&ТаблицаXLS КАК ТаблицаXLS
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаXLS.КодДоли КАК КодДоли,
		|	ТаблицаXLS.ИНН КАК ИНН,
		|	КОЛИЧЕСТВО(*) КАК КоличествоЮФ
		|ПОМЕСТИТЬ _ТаблицаXLS_Кол
		|ИЗ
		|	_ТаблицаXLS КАК ТаблицаXLS
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаXLS.КодДоли,
		|	ТаблицаXLS.ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА РеквизитыГоловныхОрганизацийСрезПоследних.ИНН = """"
		|				ТОГДА РеквизитыГоловныхОрганизацийСрезПоследних.TIN
		|			ИНАЧЕ РеквизитыГоловныхОрганизацийСрезПоследних.ИНН
		|		КОНЕЦ, ВЫБОР
		|			КОГДА РеквизитыЮридическихЛицСрезПоследних.ИНН = """"
		|				ТОГДА РеквизитыЮридическихЛицСрезПоследних.TIN
		|			ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ИНН
		|		КОНЕЦ) КАК ИНН
		|ПОМЕСТИТЬ _МассивЮФ_ГолОрг
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&Период,
		|				ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|					И Действует = ИСТИНА) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО (ЮрФизЛица.Ссылка = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыГоловныхОрганизацийСрезПоследних
		|		ПО (СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо = РеквизитыГоловныхОрганизацийСрезПоследних.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_МассивЮФ_ГолОрг.ИНН КАК ИНН,
		|	КОЛИЧЕСТВО(*) КАК КоличествоЮФ
		|ПОМЕСТИТЬ _МассивЮФ_КолГолОрг
		|ИЗ
		|	_МассивЮФ_ГолОрг КАК _МассивЮФ_ГолОрг
		|
		|СГРУППИРОВАТЬ ПО
		|	_МассивЮФ_ГолОрг.ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН
		|ПОМЕСТИТЬ _МассивЮФ
		|ИЗ
		|	_МассивЮФ_ГолОрг КАК РеквизитыЮридическихЛицСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаXLS КАК Табл
		|		ПО РеквизитыЮридическихЛицСрезПоследних.ИНН = Табл.ИНН
		|ГДЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Табл1.КодСтраны КАК КодСтраны,
		|	Табл1.КодДоли КАК КодДоли,
		|	Табл1.ИНН КАК ИНН,
		|	Табл1.Перестраховщик КАК Перестраховщик,
		|	Табл1.СуммаЖизнь240 КАК СуммаЖизнь240,
		|	Табл1.СуммаИное250 КАК СуммаИное250,
		|	Табл1.СуммаИное255 КАК СуммаИное255,
		|	Табл2.ЮрФизЛицо КАК ПерестраховщикСправочник,
		|	Табл2.ИНН КАК ИННСправочник,
		|	Табл3.КоличествоЮФ КАК ПерестраховщикКоличество,
		|	Табл4.КоличествоЮФ КАК ПерестраховщикСправочникКоличество
		|ИЗ
		|	_ТаблицаXLS КАК Табл1
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МассивЮФ КАК Табл2
		|		ПО Табл1.ИНН = Табл2.ИНН
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаXLS_Кол КАК Табл3
		|		ПО Табл1.ИНН = Табл3.ИНН
		|			И Табл1.КодДоли = Табл3.КодДоли
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МассивЮФ_КолГолОрг КАК Табл4
		|		ПО (Табл2.ИНН = Табл4.ИНН)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Табл2.ИНН, """") = """"
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	Табл3.КоличествоЮФ УБЫВ,
		|	Табл1.ИНН,
		|	Табл1.КодДоли,
		|	Табл1.Перестраховщик";

	Запрос.УстановитьПараметр("ТаблицаXLS", ТаблицаXLS.Выгрузить());
	Запрос.УстановитьПараметр("Период", Объект.Период);
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка=Объект.СписокПерестраховщиков.Добавить();
		Строка.ИНН=ВыборкаДетальныеЗаписи.ИНН;
		Строка.КодСтраны=ВыборкаДетальныеЗаписи.КодСтраны;
		Строка.КодДоли=ВыборкаДетальныеЗаписи.КодДоли;
		Строка.Перестраховщик=ВыборкаДетальныеЗаписи.Перестраховщик;
		Строка.СуммаЖизнь240=ВыборкаДетальныеЗаписи.СуммаЖизнь240;
		Строка.СуммаИное250=ВыборкаДетальныеЗаписи.СуммаИное250;
		Строка.СуммаИное255=ВыборкаДетальныеЗаписи.СуммаИное255;
		Строка.ПерестраховщикКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикКоличество;
		Строка.ПерестраховщикСправочникКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикСправочникКоличество;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПерестраховщикСправочник) Тогда
			Строка.ПерестраховщикСправочник=ВыборкаДетальныеЗаписи.ПерестраховщикСправочник;
			Строка.ИННСправочник=ВыборкаДетальныеЗаписи.ИННСправочник;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстатки()
	
Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Массив.НомерСтроки КАК НомерСтроки,
		|	Массив.ПерестраховщикСправочник КАК ПерестраховщикСправочник
		|ПОМЕСТИТЬ _Массив
		|ИЗ
		|	&Массив КАК Массив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	ОстаткиПрочихАктивовОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиЖизнь240
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Актив = &СтрахованиеЖизнь240) КАК ОстаткиПрочихАктивовОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	ОстаткиПрочихАктивовОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиИное250
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Актив = &СтрахованиеИное250) КАК ОстаткиПрочихАктивовОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	ОстаткиПрочихАктивовОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиИное255
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Актив = &СтрахованиеИное255) КАК ОстаткиПрочихАктивовОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(Перестраховщики.НомерСтроки, 0) КАК НомерСтроки,
		|	ПерестраховщикиВсе.ПерестраховщикСправочник КАК ПерестраховщикСправочник
		|ПОМЕСТИТЬ _МассивВсе
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТАБ1.ПерестраховщикСправочник КАК ПерестраховщикСправочник
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ТАБ1.ПерестраховщикСправочник КАК ПерестраховщикСправочник
		|		ИЗ
		|			_Массив КАК ТАБ1
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ТАБ2.ПерестраховщикСправочник
		|		ИЗ
		|			_ОстаткиЖизнь240 КАК ТАБ2
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ТАБ3.ПерестраховщикСправочник
		|		ИЗ
		|			_ОстаткиИное250 КАК ТАБ3
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ТАБ4.ПерестраховщикСправочник
		|		ИЗ
		|			_ОстаткиИное255 КАК ТАБ4) КАК ТАБ1
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ТАБ1.ПерестраховщикСправочник) КАК ПерестраховщикиВсе
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Массив КАК Перестраховщики
		|		ПО ПерестраховщикиВсе.ПерестраховщикСправочник = Перестраховщики.ПерестраховщикСправочник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	ОстаткиПрочихАктивовОстатки.Период КАК Период
		|ПОМЕСТИТЬ _ОстаткиСодержаниеВсе
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивовОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _МассивВсе КАК Массив
		|		ПО (Массив.ПерестраховщикСправочник = (ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)))
		|ГДЕ
		|	ОстаткиПрочихАктивовОстатки.Период < &Период
		|	И ОстаткиПрочихАктивовОстатки.Организация = &Организация
		|	И ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиПрочихАктивовОстатки.Актив В (&СтрахованиеЖизнь240, &СтрахованиеИное250, &СтрахованиеИное255)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиСодержаниеВсе.ПерестраховщикСправочник КАК ПерестраховщикСправочник,
		|	_ОстаткиСодержаниеВсе.Период КАК Период
		|ПОМЕСТИТЬ _ОстаткиСодержаниеОдин
		|ИЗ
		|	_ОстаткиСодержаниеВсе КАК _ОстаткиСодержаниеВсе
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиСодержаниеВсе.ПерестраховщикСправочник,
		|	_ОстаткиСодержаниеВсе.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОстаткиСодержаниеВсе
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Табл2.ПерестраховщикСправочник КАК ПерестраховщикСправочник,
		|	Табл2.Период КАК Период
		|ПОМЕСТИТЬ _ОстаткиСодержание
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОстаткиСодержаниеОдин.ПерестраховщикСправочник КАК ПерестраховщикСправочник,
		|		МАКСИМУМ(_ОстаткиСодержаниеОдин.Период) КАК Период
		|	ИЗ
		|		_ОстаткиСодержаниеОдин КАК _ОстаткиСодержаниеОдин
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОстаткиСодержаниеОдин.ПерестраховщикСправочник) КАК Табл1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОстаткиСодержаниеОдин КАК Табл2
		|		ПО Табл1.Период = Табл2.Период
		|			И Табл1.ПерестраховщикСправочник = Табл2.ПерестраховщикСправочник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОстаткиСодержаниеОдин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Табл1.НомерСтроки КАК НомерСтроки,
		|	Табл1.ПерестраховщикСправочник КАК ПерестраховщикСправочник,
		|	ЕСТЬNULL(Табл2.СуммаОстаток, 0) КАК СуммаЖизньПред240,
		|	ЕСТЬNULL(Табл3.СуммаОстаток, 0) КАК СуммаИноеПред250,
		|	ЕСТЬNULL(Табл4.СуммаОстаток, 0) КАК СуммаИноеПред255,
		|	Табл5.Период КАК ДатаПред,
		|	1 КАК ПерестраховщикСправочникКоличество,
		|	1 КАК ПерестраховщикКоличество,
		|	ЕСТЬNULL(Табл1_1.ИНН, ВЫБОР
		|			КОГДА РеквизитыЮридическихЛицСрезПоследних.ИНН = """"
		|				ТОГДА РеквизитыЮридическихЛицСрезПоследних.TIN
		|			ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ИНН
		|		КОНЕЦ) КАК ИННСправочник
		|ИЗ
		|	_МассивВсе КАК Табл1
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ПерестраховщикСправочник,
		|			ВЫБОР
		|				КОГДА РеквизитыЮридическихЛицСрезПоследних.ИНН = """"
		|					ТОГДА РеквизитыЮридическихЛицСрезПоследних.TIN
		|				ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ИНН
		|			КОНЕЦ КАК ИНН
		|		ИЗ
		|			РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&Период,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|				ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|		ГДЕ
		|			ЮрФизЛица.Ссылка В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК РодительскоеЮридическоеЛицо
		|					ИЗ
		|						РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|					ГДЕ
		|						СвязанныеЮридическиеЛицаСрезПоследних.Действует)) КАК Табл1_1
		|		ПО Табл1.ПерестраховщикСправочник = Табл1_1.ПерестраховщикСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = Табл1.ПерестраховщикСправочник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиЖизнь240 КАК Табл2
		|		ПО Табл1.ПерестраховщикСправочник = Табл2.ПерестраховщикСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиИное250 КАК Табл3
		|		ПО Табл1.ПерестраховщикСправочник = Табл3.ПерестраховщикСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиИное255 КАК Табл4
		|		ПО Табл1.ПерестраховщикСправочник = Табл4.ПерестраховщикСправочник
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиСодержание КАК Табл5
		|		ПО Табл1.ПерестраховщикСправочник = Табл5.ПерестраховщикСправочник
		|ГДЕ
		|	(Табл1.НомерСтроки > 0
		|			ИЛИ Табл1.НомерСтроки = 0
		|				И (ЕСТЬNULL(Табл2.СуммаОстаток, 0) <> 0
		|					ИЛИ ЕСТЬNULL(Табл3.СуммаОстаток, 0) <> 0
		|					ИЛИ ЕСТЬNULL(Табл4.СуммаОстаток, 0) <> 0))";
		
	Запрос.УстановитьПараметр("Массив", Объект.СписокПерестраховщиков.Выгрузить());
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СтрахованиеЖизнь240",Справочники.ПрочиеАктивы.НайтиПоКоду("000000099"));
	Запрос.УстановитьПараметр("СтрахованиеИное250",Справочники.ПрочиеАктивы.НайтиПоКоду("000000082"));
	Запрос.УстановитьПараметр("СтрахованиеИное255",Справочники.ПрочиеАктивы.НайтиПоКоду("000000091"));
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПараметрыОтбора=Новый Структура;
		Если ВыборкаДетальныеЗаписи.НомерСтроки>0 Тогда
				ПараметрыОтбора.Вставить("НомерСтроки", ВыборкаДетальныеЗаписи.НомерСтроки);
				Строки=Объект.СписокПерестраховщиков.НайтиСтроки(ПараметрыОтбора);
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СуммаЖизньПред240) Тогда
						Строки[0].СуммаЖизньПред240=ВыборкаДетальныеЗаписи.СуммаЖизньПред240;
					Иначе
						Строки[0].СуммаЖизньПред240=0;
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СуммаИноеПред250) Тогда
						Строки[0].СуммаИноеПред250=ВыборкаДетальныеЗаписи.СуммаИноеПред250;
					Иначе
						Строки[0].СуммаИноеПред250=0;
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СуммаИноеПред255) Тогда
						Строки[0].СуммаИноеПред255=ВыборкаДетальныеЗаписи.СуммаИноеПред255;
					Иначе
						Строки[0].СуммаИноеПред255=0;
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаПред) Тогда
						Строки[0].ДатаПред=ВыборкаДетальныеЗаписи.ДатаПред;
					Иначе
					    Строки[0].ДатаПред=ВыборкаДетальныеЗаписи.ДатаПред;
				КонецЕсли;
			Иначе
				Строка=Объект.СписокПерестраховщиков.Добавить();
				Строка.ПерестраховщикКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикКоличество;
				Строка.ПерестраховщикСправочникКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикСправочникКоличество;
				Строка.ПерестраховщикСправочник=ВыборкаДетальныеЗаписи.ПерестраховщикСправочник;
				Строка.ИННСправочник=ВыборкаДетальныеЗаписи.ИННСправочник;
				Строка.ДатаПред=ВыборкаДетальныеЗаписи.ДатаПред;
				Строка.СуммаЖизньПред240=ВыборкаДетальныеЗаписи.СуммаЖизньПред240;
				Строка.СуммаИноеПред250=ВыборкаДетальныеЗаписи.СуммаИноеПред250;
				Строка.СуммаИноеПред255=ВыборкаДетальныеЗаписи.СуммаИноеПред255;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределениеСчетаДоверительногоУправления(СчетДоверительногоУправленияСтрока,Организация)
	СчетДоверительногоУправленияСсылка=Справочники.СчетаДоверительногоУправления.ПустаяСсылка();	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияСтрока", СчетДоверительногоУправленияСтрока);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если СтрЗаменить(ВыборкаДетальныеЗаписи.КодСчета,"/","")=СчетДоверительногоУправленияСтрока Тогда
			СчетДоверительногоУправленияСсылка=ВыборкаДетальныеЗаписи.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетДоверительногоУправленияСсылка;
КонецФункции

&НаКлиенте
Процедура СохранитьЗакрыть(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СохранитьЗакрыть");
	Попытка
		ВыполнитьСохранитьЗакрыть(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры
&НаКлиенте
Процедура ВыполнитьСохранитьЗакрыть(ПараметрыСессии)

		Если СохранитьЗакрытьНаСервере() Тогда
			ЭтаФорма.Закрыть();
		КонецЕсли;

КонецПроцедуры



&НаСервере
Функция СохранитьЗакрытьНаСервере()
	//Проверки
	
	//Заполнение СДУ
	Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не выбран счет доверительного управления!!!";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	//Несопоставленные страховщики
	КоличествоЗаписей=0;
	Для Каждого Строка Из Объект.СписокПерестраховщиков Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ПерестраховщикСправочник) Тогда
			КоличествоЗаписей=КоличествоЗаписей+1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоЗаписей>1 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Несопоставлены перестраховщики ("+Формат(КоличествоЗаписей) +" поз.) со справочником!!! Может быть не больше одного.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	//Проверим дубляж перестраховщиков
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 	ПерестраховщикСправочник
		|ПОМЕСТИТЬ	_Массив
		|ИЗ			&Массив КАК Массив
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Массив.ПерестраховщикСправочник КАК ПерестраховщикСправочник,
		|	Массив.КоличествоКод КАК КоличествоКод
		|ИЗ
		|	(ВЫБРАТЬ
		|		Массив.ПерестраховщикСправочник,
		|		КОЛИЧЕСТВО(Массив.ПерестраховщикСправочник) КАК КоличествоКод
		|	ИЗ
		|		_Массив КАК Массив
		|	СГРУППИРОВАТЬ ПО
		|		Массив.ПерестраховщикСправочник
		|	) КАК Массив
		|ГДЕ
		|	Массив.КоличествоКод > 1
		|;";

		
	Запрос.УстановитьПараметр("Массив", Объект.СписокПерестраховщиков.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КоличествоЗаписей=0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КоличествоЗаписей=КоличествоЗаписей+1;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "По перестраховщику '"+Формат(ВыборкаДетальныеЗаписи.ПерестраховщикСправочник) +"' количество записей - "+Формат(ВыборкаДетальныеЗаписи.КоличествоКод)+" !!!";
		Сообщение.Сообщить();
	КонецЦикла;
	
	Если КоличествоЗаписей>0 Тогда
		Возврат Ложь;
	КонецЕсли;

	//Проверим если операции в будущих числах
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 	НомерСтроки,
		|			ПерестраховщикСправочник
		|ПОМЕСТИТЬ	_Массив
		|ИЗ			&Массив КАК Массив
		|;
		|
		//Страхование жизни 240
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихстаткиЖизнь240
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивовОстатки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	_Массив КАК Массив
		|	ПО  Массив.ПерестраховщикСправочник=ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|ГДЕ
		|	ОстаткиПрочихАктивовОстатки.Период>=&Период
		|	И
		|	ОстаткиПрочихАктивовОстатки.Организация=&Организация
		|	И
		|	ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления=&СчетДоверительногоУправления
		|	И
		|	ОстаткиПрочихАктивовОстатки.Актив=&СтрахованиеЖизнь240
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|;
		|
		//Страхование иное 250
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	МИНИМУМ(ОстаткиПрочихАктивовОстатки.Период)	КАК Период
		|ПОМЕСТИТЬ	_ОстаткиИное250
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивовОстатки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	_Массив КАК Массив
		|	ПО  Массив.ПерестраховщикСправочник=ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|ГДЕ
		|	ОстаткиПрочихАктивовОстатки.Период>=&Период
		|	И
		|	ОстаткиПрочихАктивовОстатки.Организация=&Организация
		|	И
		|	ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления=&СчетДоверительногоУправления
		|	И
		|	ОстаткиПрочихАктивовОстатки.Актив=&СтрахованиеИное250
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|;
		|
		|
		//Страхование иное 255
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица) КАК ПерестраховщикСправочник,
		|	МИНИМУМ(ОстаткиПрочихАктивовОстатки.Период)	КАК Период
		|ПОМЕСТИТЬ	_ОстаткиИное255
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивовОстатки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	_Массив КАК Массив
		|	ПО  Массив.ПерестраховщикСправочник=ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|ГДЕ
		|	ОстаткиПрочихАктивовОстатки.Период>=&Период
		|	И
		|	ОстаткиПрочихАктивовОстатки.Организация=&Организация
		|	И
		|	ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления=&СчетДоверительногоУправления
		|	И
		|	ОстаткиПрочихАктивовОстатки.Актив=&СтрахованиеИное255
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ОстаткиПрочихАктивовОстатки.Субъект КАК Справочник.ЮрФизЛица)
		|;
		|
		//Итог
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|		Табл1.НомерСтроки
		|ИЗ
		|	_Массив 	КАК Табл1
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|   _ОстаткиЖизнь240 		КАК Табл2
		|   ПО Табл1.ПерестраховщикСправочник=Табл2.ПерестраховщикСправочник
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|   _ОстаткиИное250 		КАК Табл3
		|   ПО Табл1.ПерестраховщикСправочник=Табл3.ПерестраховщикСправочник
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|   _ОстаткиИное255 		КАК Табл4
		|   ПО Табл1.ПерестраховщикСправочник=Табл4.ПерестраховщикСправочник
		|ГДЕ
		|	НЕ
		|	(
		|		Табл2.Период ЕСТЬ NULL
		|		И
		|		Табл3.Период ЕСТЬ NULL
		|		И
		|		Табл4.Период ЕСТЬ NULL
		|	)
		|;
		|";
		
	Запрос.УстановитьПараметр("Массив", Объект.СписокПерестраховщиков.Выгрузить());
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СтрахованиеЖизнь240",Справочники.ПрочиеАктивы.НайтиПоКоду("000000099"));
	Запрос.УстановитьПараметр("СтрахованиеИное250",Справочники.ПрочиеАктивы.НайтиПоКоду("000000082"));
	Запрос.УстановитьПараметр("СтрахованиеИное255",Справочники.ПрочиеАктивы.НайтиПоКоду("000000091"));
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КоличествоЗаписей=0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КоличествоЗаписей=КоличествоЗаписей+1;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "По строке "+Формат(ВыборкаДетальныеЗаписи.НомерСтроки) +" есть проводки в будущих числах!!!";
		Сообщение.Сообщить();
	КонецЦикла;
	
	Если КоличествоЗаписей>0 Тогда
		Возврат Ложь;
	КонецЕсли;

	//Проводки
	КоличествоЗаписей=0;
	Для Каждого Строка Из Объект.СписокПерестраховщиков Цикл

		Если Строка.СуммаЖизнь240<>Строка.СуммаЖизньПред240 Тогда
			КоличествоЗаписей=КоличествоЗаписей+1;
		КонецЕсли;

		Если Строка.СуммаИное250<>Строка.СуммаИноеПред250 Тогда
			КоличествоЗаписей=КоличествоЗаписей+1;
		КонецЕсли;

		Если Строка.СуммаИное255<>Строка.СуммаИноеПред255 Тогда
			КоличествоЗаписей=КоличествоЗаписей+1;
		КонецЕсли;

	КонецЦикла;

	Если КоличествоЗаписей>0 Тогда
		НовыйДокумент=Документы.КорректировкаРегистров.СоздатьДокумент();
		НовыйДокумент.Дата=Объект.Период;
		НовыйДокумент.Ответственный=РаботаСПользователями.ТекущийПользователь();;
		НовыйДокумент.СчетДоверительногоУправления=Объект.СчетДоверительногоУправления;
		НовыйДокумент.Организация=Объект.Организация;
		НовыйДокумент.Комментарий="Импорт перестраховщиков";
		НоваяСтрока=НовыйДокумент.ТаблицаРегистров.Добавить();
		НоваяСтрока.Имя="ОстаткиПрочихАктивов";
		//НовыйДокумент.УстановитьНовыйНомер();
		НовыйДокумент.Записать();
		КоличествоЗаписей=КоличествоЗаписей+1;
		Список=РегистрыНакопления.ОстаткиПрочихАктивов.СоздатьНаборЗаписей();
		Список.Отбор.Регистратор.Установить(НовыйДокумент.Ссылка);
		Список.Прочитать();

		Для Каждого Строка Из Объект.СписокПерестраховщиков Цикл

			Если Строка.СуммаЖизнь240<>Строка.СуммаЖизньПред240 Тогда
				НоваяЗапись=Список.Добавить();
				НоваяЗапись.Активность=Истина;
				Если Строка.СуммаЖизнь240>=Строка.СуммаЖизньПред240 Тогда
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
					Иначе
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Расход;
				КонецЕсли;
				НоваяЗапись.Период=Объект.Период;
				НоваяЗапись.Регистратор=НовыйДокумент.Ссылка;
				НоваяЗапись.Организация=Объект.Организация;
				НоваяЗапись.СчетДоверительногоУправления=Объект.СчетДоверительногоУправления;
				НоваяЗапись.Актив=Справочники.ПрочиеАктивы.НайтиПоКоду("000000099",Ложь);
				НоваяЗапись.Валюта=Справочники.Валюты.НайтиПоКоду("643",Ложь);
				НоваяЗапись.Количество=1;
				НоваяЗапись.Сумма=Макс(Строка.СуммаЖизнь240-Строка.СуммаЖизньПред240,-(Строка.СуммаЖизнь240-Строка.СуммаЖизньПред240));
				НоваяЗапись.Субъект=Строка.ПерестраховщикСправочник;
			КонецЕсли;

			Если Строка.СуммаИное250<>Строка.СуммаИноеПред250 Тогда
				НоваяЗапись=Список.Добавить();
				НоваяЗапись.Активность=Истина;
				Если Строка.СуммаИное250>=Строка.СуммаИноеПред250 Тогда
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
					Иначе
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Расход;
				КонецЕсли;
				НоваяЗапись.Период=Объект.Период;
				НоваяЗапись.Регистратор=НовыйДокумент.Ссылка;
				НоваяЗапись.Организация=Объект.Организация;
				НоваяЗапись.СчетДоверительногоУправления=Объект.СчетДоверительногоУправления;
				НоваяЗапись.Актив=Справочники.ПрочиеАктивы.НайтиПоКоду("000000082",Ложь);
				НоваяЗапись.Валюта=Справочники.Валюты.НайтиПоКоду("643",Ложь);
				НоваяЗапись.Количество=1;
				НоваяЗапись.Сумма=Макс(Строка.СуммаИное250-Строка.СуммаИноеПред250,-(Строка.СуммаИное250-Строка.СуммаИноеПред250));
				НоваяЗапись.Субъект=Строка.ПерестраховщикСправочник;
			КонецЕсли;

			Если Строка.СуммаИное255<>Строка.СуммаИноеПред255 Тогда
				НоваяЗапись=Список.Добавить();
				НоваяЗапись.Активность=Истина;
				Если Строка.СуммаИное255>=Строка.СуммаИноеПред255 Тогда
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
					Иначе
						НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Расход;
				КонецЕсли;
				НоваяЗапись.Период=Объект.Период;
				НоваяЗапись.Регистратор=НовыйДокумент.Ссылка;
				НоваяЗапись.Организация=Объект.Организация;
				НоваяЗапись.СчетДоверительногоУправления=Объект.СчетДоверительногоУправления;
				НоваяЗапись.Актив=Справочники.ПрочиеАктивы.НайтиПоКоду("000000091",Ложь);
				НоваяЗапись.Валюта=Справочники.Валюты.НайтиПоКоду("643",Ложь);
				НоваяЗапись.Количество=1;
				НоваяЗапись.Сумма=Макс(Строка.СуммаИное255-Строка.СуммаИноеПред255,-(Строка.СуммаИное255-Строка.СуммаИноеПред255));
				НоваяЗапись.Субъект=Строка.ПерестраховщикСправочник;
			КонецЕсли;

		КонецЦикла;
		Список.Записать(Истина);
		НовыйДокумент.Записать();
		
		Если ЗначениеЗаполнено(Объект.ОснованиеОперации) Тогда
			  ДокументОснование = Объект.ОснованиеОперации.ПолучитьОбъект();				
			  НоваяОперация = ДокументОснование.Операции.Добавить();
			  НоваяОперация.Операция = НовыйДокумент.Ссылка;
			  ДокументОснование.Записать(РежимЗаписиДокумента.Проведение);			
		КонецЕсли;

		Возврат Истина;
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Список корректировок будет пустой!!!";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

//Изменение перестраховщика
&НаКлиенте
Процедура СписокПерестраховщиковПерестраховщикСправочникПриИзменении(Элемент)
	СписокПерестраховщиковПерестраховщикСправочникПриИзмененииНаСервере
			(
			Элементы.СписокПерестраховщиков.ТекущиеДанные.ИНН,
			Элементы.СписокПерестраховщиков.ТекущиеДанные.КодСтраны,
			Элементы.СписокПерестраховщиков.ТекущиеДанные.ПерестраховщикСправочник
			);
	ЗаполнитьОстатки();
КонецПроцедуры

&НаСервере
Процедура СписокПерестраховщиковПерестраховщикСправочникПриИзмененииНаСервере(ИНН,КодСтраны,ПерестраховщикСправочник)
	ИННСправочник="";	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР КОГДА РеквизитыЮридическихЛицСрезПоследних.ИНН="""" ТОГДА РеквизитыЮридическихЛицСрезПоследних.TIN ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ИНН КОНЕЦ КАК ИНН
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, ЮрФизЛицо = &ПерестраховщикСправочник И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
	
	Запрос.УстановитьПараметр("ПерестраховщикСправочник", ПерестраховщикСправочник);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИННСправочник=ВыборкаДетальныеЗаписи.ИНН;
	КонецЦикла;
	
	Для Каждого Строка из Объект.СписокПерестраховщиков Цикл
		Если ИНН=Строка.ИНН И КодСтраны=Строка.КодСтраны Тогда
			Строка.ПерестраховщикСправочник=ПерестраховщикСправочник;
			Строка.ИННСправочник=ИННСправочник;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЗаполнитьОстатки();
КонецПроцедуры


&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	ЗаполнитьОстатки();
КонецПроцедуры


&НаСервере
Процедура СгруппироватьДанныеНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ 	
		|		ИНН,КодСтраны,КодДоли,СуммаЖизнь240,СуммаИное250,СуммаИное255,ПерестраховщикСправочник,
		|		Перестраховщик,ПерестраховщикСправочникКоличество,ПерестраховщикКоличество,ИННСправочник,ДатаПред,
		|		СуммаЖизньПред240,СуммаИноеПред250,СуммаИноеПред255
		|ПОМЕСТИТЬ	_СписокПерестраховщиковСтарые
		|ИЗ			&СписокПерестраховщиков КАК СписокПерестраховщиков
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ	МАКСИМУМ(Перестраховщик)	КАК Перестраховщик,
		|           """"						КАК КодСтраны,
		|			МАКСИМУМ(ИНН)				КАК ИНН,
		|           """"						КАК	КодДоли,
		|           СУММА(СуммаЖизнь240)    	КАК СуммаЖизнь240,
		|           СУММА(СуммаИное250)    		КАК СуммаИное250,
		|           СУММА(СуммаИное255)    		КАК СуммаИное255,
		|           ПерестраховщикСправочник	КАК ПерестраховщикСправочник,
		|           1							КАК	ПерестраховщикКоличество,
		|           МАКСИМУМ(ПерестраховщикСправочникКоличество)				КАК	ПерестраховщикСправочникКоличество,
		|			ИННСправочник				КАК	ИННСправочник,
		|           МАКСИМУМ(ДатаПред)			КАК	ДатаПред,
		|           СуммаЖизньПред240			КАК	СуммаЖизньПред240,
		|           СуммаИноеПред250            КАК	СуммаИноеПред250,
		|           СуммаИноеПред255			КАК	СуммаИноеПред255
		|ИЗ
		|  			_СписокПерестраховщиковСтарые
		|СГРУППИРОВАТЬ ПО
		|            ПерестраховщикСправочник,
		|            ИННСправочник,
		|            СуммаЖизньПред240,
		|            СуммаИноеПред250,
		|            СуммаИноеПред255
		|;
		|";


	Запрос.УстановитьПараметр("СписокПерестраховщиков", Объект.СписокПерестраховщиков.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Объект.СписокПерестраховщиков.Очистить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка=Объект.СписокПерестраховщиков.Добавить();
		Строка.ИНН=ВыборкаДетальныеЗаписи.ИНН;
		Строка.КодСтраны=ВыборкаДетальныеЗаписи.КодСтраны;
		Строка.КодДоли=ВыборкаДетальныеЗаписи.КодДоли;
		Строка.Перестраховщик=ВыборкаДетальныеЗаписи.Перестраховщик;
		Строка.СуммаЖизнь240=ВыборкаДетальныеЗаписи.СуммаЖизнь240;
		Строка.СуммаИное250=ВыборкаДетальныеЗаписи.СуммаИное250;
		Строка.СуммаИное255=ВыборкаДетальныеЗаписи.СуммаИное255;
		Строка.ПерестраховщикСправочник=ВыборкаДетальныеЗаписи.ПерестраховщикСправочник;
		Строка.ПерестраховщикСправочникКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикСправочникКоличество;
		Строка.ПерестраховщикКоличество=ВыборкаДетальныеЗаписи.ПерестраховщикКоличество;
		Строка.ИННСправочник=ВыборкаДетальныеЗаписи.ИННСправочник;
		Строка.ДатаПред=ВыборкаДетальныеЗаписи.ДатаПред;
		Строка.СуммаЖизньПред240=ВыборкаДетальныеЗаписи.СуммаЖизньПред240;
		Строка.СуммаИноеПред250=ВыборкаДетальныеЗаписи.СуммаИноеПред250;
		Строка.СуммаИноеПред255=ВыборкаДетальныеЗаписи.СуммаИноеПред255;
		Строка.СуммаИное255=ВыборкаДетальныеЗаписи.СуммаИное255;
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура СгруппироватьДанные(Команда)
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СгруппироватьДанные");
	Попытка
		СгруппироватьДанныеНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
