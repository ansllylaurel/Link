
&НаСервере
Процедура ПровестиПереклассификациюНаСервере()
	
	Если ЗначениеЗаполнено(ЭтаФорма.Корректировка) Тогда
	
		ДокументКорректировки = ЭтаФорма.Корректировка.ПолучитьОбъект();
		
	Иначе
		
		ДокументКорректировки = Документы.КорректировкаРегистров.СоздатьДокумент();
		
		ДокументКорректировки.Дата = ЭтаФорма.ДатаПереклассификации;
		
		ДокументКорректировки.Организация = ЭтаФорма.СчетДоверительногоУправления.Организация;
		ДокументКорректировки.СчетДоверительногоУправления = ЭтаФорма.СчетДоверительногоУправления;
		ДокументКорректировки.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		ДокументКорректировки.Комментарий = "Реклассификация активов";
		
		ДокументКорректировки.ТаблицаРегистров.Очистить();
		
		ДокументКорректировки.ТаблицаРегистров.Добавить().Имя = "ЕдиныйБухгалтерскийУчет";
		ДокументКорректировки.ТаблицаРегистров.Добавить().Имя = "БухПартииЦенныхБумаг";
		
		Попытка
			ДокументКорректировки.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки()); 
			Возврат;
		КонецПопытки;
		
		ЭтаФорма.Корректировка = ДокументКорректировки.Ссылка;
	
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Актив КАК Актив,
		|	&НовыйУчетныйАктив КАК НовыйУчетныйАктивЕПС
		|ПОМЕСТИТЬ ТаблицаПереклассификации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	БухПартииЦенныхБумагОстатки.Организация КАК Организация,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ВидУчета КАК ВидУчета,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупки,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток КАК СтоимостьПокупкиКупона,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимости,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток КАК РасходыПриПокупкеВСтоимостиВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеСНачалаГодаОстаток КАК РасходыПриПокупкеСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимости,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимости,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаСНачалаГодаОстаток КАК ПереоценкаКупонаСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток КАК ДисконтПремия,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупки,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток КАК ДисконтПремияНачисленныйСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияСНачалаГодаОстаток КАК РазницаПервоначальногоПризнанияСНачалаГода,
		|	БухПартииЦенныхБумагОстатки.СуммаЧастичногоПогашенияОстаток КАК СуммаЧастичногоПогашения,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеКупонаОстаток КАК СуммаРезервовПодОбесценениеКупона,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПоСомнительнымДолгамОстаток КАК СуммаРезервовПоСомнительнымДолгам,
		|	БухПартииЦенныхБумагОстатки.КурсовыеРазницыСНачалаГодаОстаток КАК КурсовыеРазницыСНачалаГода,
		|	ТаблицаПереклассификации.НовыйУчетныйАктивЕПС КАК НовыйУчетныйАктивЕПС
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ПериодОстатки,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага В
		|					(ВЫБРАТЬ
		|						ТаблицаПереклассификации.Актив
		|					ИЗ
		|						ТаблицаПереклассификации КАК ТаблицаПереклассификации)) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПереклассификации КАК ТаблицаПереклассификации
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ТаблицаПереклассификации.Актив";
	
	Запрос.УстановитьПараметр("Период", НачалоДня(ДокументКорректировки.Дата));
	Запрос.УстановитьПараметр("ПериодОстатки", Новый Граница(НачалоДня(ДокументКорректировки.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументКорректировки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НовыйУчетныйАктив", ЭтаФорма.НовыйУчетныйАктив);
	Запрос.УстановитьПараметр("Актив", ЭтаФорма.Актив);
	
	НаборЗаписейПартии = РегистрыНакопления.БухПартииЦенныхБумаг.СоздатьНаборЗаписей();
	НаборЗаписейПартии.Отбор.Регистратор.Установить(ДокументКорректировки.Ссылка);
	
	НаборЗаписейПартии.Прочитать();
	НаборЗаписейПартии.Очистить();
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаписьРасход = НаборЗаписейПартии.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьРасход, ВыборкаДетальныеЗаписи);
		
		ЗаписьПриход = НаборЗаписейПартии.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьПриход, ВыборкаДетальныеЗаписи);
		ЗаписьПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
		ЗаписьПриход.УчетныйАктивЕПС = ВыборкаДетальныеЗаписи.НовыйУчетныйАктивЕПС;
		
		СтарыйУчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		
	КонецЦикла;
	
	Попытка
		НаборЗаписейПартии.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Актив КАК Актив,
		|	&СтарыйУчетныйАктив КАК СтарыйУчетныйАктивЕПС,
		|	&НовыйУчетныйАктив КАК НовыйУчетныйАктивЕПС
		|ПОМЕСТИТЬ ТаблицаПереклассификации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаПереклассификации.СтарыйУчетныйАктивЕПС КАК СтарыйУчетныйАктивЕПС,
		|	ТаблицаПереклассификации.НовыйУчетныйАктивЕПС КАК НовыйУчетныйАктивЕПС
		|ПОМЕСТИТЬ ТаблицаУчетныхАктивовЕПС
		|ИЗ
		|	ТаблицаПереклассификации КАК ТаблицаПереклассификации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчета КАК СтарыйСчетУчета,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчета КАК НовыйСчетУчета
		|ПОМЕСТИТЬ ТаблицаСчетов
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКупона,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКупона
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаПереоценкиА,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаПереоценкиА
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаПереоценкиП,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаПереоценкиП
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКорректировокА,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКорректировокА
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.СтарыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКорректировокП,
		|	ВЫРАЗИТЬ(ТаблицаУчетныхАктивовЕПС.НовыйУчетныйАктивЕПС КАК Справочник.УчетныеАктивыЕПС).СчетУчетаКорректировокП
		|ИЗ
		|	ТаблицаУчетныхАктивовЕПС КАК ТаблицаУчетныхАктивовЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК СчетКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Организация КАК Организация,
		|	ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК ВалютаДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК ВалютаКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитикаДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитикаКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстаток КАК КоличествоДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.КоличествоОстаток КАК КоличествоКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК Сумма,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаКт,
		|	ТаблицаСчетов.НовыйСчетУчета КАК СчетДт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ПериодОстатки,
		|			Счет В
		|				(ВЫБРАТЬ
		|					ТаблицаСчетов.СтарыйСчетУчета
		|				ИЗ
		|					ТаблицаСчетов КАК ТаблицаСчетов),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ТаблицаПереклассификации.Актив
		|					ИЗ
		|						ТаблицаПереклассификации КАК ТаблицаПереклассификации)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСчетов КАК ТаблицаСчетов
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Счет = ТаблицаСчетов.СтарыйСчетУчета";
	
	Запрос.УстановитьПараметр("Период", НачалоДня(ДокументКорректировки.Дата));
	Запрос.УстановитьПараметр("ПериодОстатки", Новый Граница(НачалоДня(ДокументКорректировки.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументКорректировки.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Актив", ЭтаФорма.Актив);
	Запрос.УстановитьПараметр("НовыйУчетныйАктив", ЭтаФорма.НовыйУчетныйАктив);
	Запрос.УстановитьПараметр("СтарыйУчетныйАктив", СтарыйУчетныйАктив);
	
	НаборЗаписейБух = РегистрыБухгалтерии.ЕдиныйБухгалтерскийУчет.СоздатьНаборЗаписей();
	НаборЗаписейБух.Отбор.Регистратор.Установить(ДокументКорректировки.Ссылка);
	
	НаборЗаписейБух.Прочитать();
	НаборЗаписейБух.Очистить();
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Запись = НаборЗаписейБух.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаДетальныеЗаписи);
		
		Запись.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Субконто1;
		Запись.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Субконто1;
		
	КонецЦикла;
	
	Попытка
		НаборЗаписейБух.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПереклассификацию(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПровестиПереклассификацию");
	Попытка
		ПровестиПереклассификациюНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти