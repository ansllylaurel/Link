		|				ИЛИ ЕСТЬNULL(_СводныеСуммыДвижения.СуммаРасход, 0) <> 0
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ,
		|	ЕСТЬNULL(_СводныеСуммыКомиссии.КомиссияБрокера + _СводныеСуммыКомиссии.КомиссияТорговая, 0),
		|	ЕСТЬNULL(_СводныеСуммыДвижения.Валюта, ""   "")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриоритетСтрокВалют";
		
	Запрос.УстановитьПараметр("ДатаОтчета",						ТекущаяДата());
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",							Брокер);
	Запрос.УстановитьПараметр("Валюта",							Валюта);
	Запрос.УстановитьПараметр("ОтветственноеЛицо",				ОтветственноеЛицо);
	Запрос.УстановитьПараметр("ВалютаПервойСделки", 			ВалютаПервойСделки);
	Запрос.УстановитьПараметр("ВалютаУчета", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("РазделFX", 						ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьДанныеШапки

&НаСервереБезКонтекста
Функция ПолучитьДанныеСделок(Организация, СчетДоверительногоУправления, Брокер, Валюта, Период)

	МестоСовершенияСделок = "Брокерский ""ТОРГИ""(&Брокер)";
	
	Если      Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
		МестоСовершенияСделок = СтрЗаменить(МестоСовершенияСделок, "&Брокер", "РЕГИОН");
	ИначеЕсли Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") Тогда
		МестоСовершенияСделок = СтрЗаменить(МестоСовершенияСделок, "&Брокер", "ГПБ");
	ИначеЕсли Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_КИТ_Финанс") Тогда
		МестоСовершенияСделок = СтрЗаменить(МестоСовершенияСделок, "&Брокер", "КИТ");
	Иначе
		МестоСовершенияСделок = СтрЗаменить(МестоСовершенияСделок, "&Брокер", Строка(Брокер));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПокупкиПродажиЦБ.ВидСделки КАК ВидСделки,
		|	ПокупкиПродажиЦБ.Дата КАК ДатаСделки,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА ПокупкиПродажиЦБ.ДепозитарныйСчет.Родитель.НомерСчета
		|		ИНАЧЕ ПокупкиПродажиЦБ.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ КАК НомерСчетаДепо,
		|	&МестоСовершенияСделок КАК МестоСовершенияСделки,
		|	""ДКК"" КАК Депозитарий,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.Сделка.РежимПереговорныхСделок
		|			ТОГДА ""ММВБ-РПС""
		|		ИНАЧЕ ""ММВБ""
		|	КОНЕЦ КАК Биржа,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК КодЦБНаММВБ,
		|	РеквизитыЭмитентов.КраткоеНаименованиеПоУставу КАК Эмитент,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ""Облигация""
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ""Пай""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК КодЦБНаММВБ1,
		|	ПокупкиПродажиЦБ.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК РегНомерЦБ,
		|	ЕСТЬNULL(ПокупкиПродажиЦБ.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ПокупкиПродажиЦБ.Цена, 0) КАК Цена,
		|	ПокупкиПродажиЦБ.ВалютаСделки КАК ВалютаЦены,
		|	ЕСТЬNULL(ПокупкиПродажиЦБ.Сумма, 0) КАК Сумма,
		|	ПокупкиПродажиЦБ.ВалютаСделки КАК ВалютаСуммы,
		|	ЕСТЬNULL(ПокупкиПродажиЦБ.СуммаКупона, 0) КАК СуммаКупона,
		|	ПокупкиПродажиЦБ.ВалютаСделки КАК ВалютаКупона,
		|	СУММА(ЕСТЬNULL(РасходыПоТорговойКомиссии.СуммаОборот, 0)) КАК ТорговаяКомиссия,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаТорговойКомиссии,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаТорговаяКомиссия,
		|	СУММА(ЕСТЬNULL(РасходыПоБрокерскойКомиссии.СуммаОборот, 0)) КАК КомиссияБрокера,
		|	РасходыПоБрокерскойКомиссии.Валюта КАК ВалютаКомиссииБрокера,
		|	ПлановыеДатыОплатПоБрокерскойКомиссии.ДатаОплаты КАК ДатаКомиссияБрокера,
		|	0 КАК КлинговаяКомиссия,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаКлинговойКомиссии,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаКлинговаяКомиссия,
		|	0 КАК ДепозитарнаяКомиссия,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаДепозитарнойКомиссии,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаДепозитарнаяКомиссия,
		|	0 КАК КомиссияПосредника,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаКомиссииПосредника,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаКомиссияПосредника,
		|	0 КАК КомиссияПрочая,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаКомиссииПрочей,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаКомиссияПрочая,
		|	ПокупкиПродажиЦБ.ДатаОплаты КАК ДатаОплаты,
		|	ПокупкиПродажиЦБ.ДатаПеререгистрации КАК ДатаПеререгистрации,
		|	ПокупкиПродажиЦБ.НомерСделки КАК НомерСделки,
		|	ПокупкиПродажиЦБ.ДатаОплатыФакт КАК ДатаОплатыФакт,
		|	ПокупкиПродажиЦБ.ДатаПеререгистрацииФакт КАК ДатаПеререгистрацииФакт,
		|	"""" КАК ИдентификаторПортфеляСЭД,
		|	ПокупкиПродажиЦБ.РодСделкиРЕПО КАК РодСделкиРЕПО,
		|	ПокупкиПродажиЦБ.НомерСделкиРЕПО КАК НомерСделкиРЕПО,
		|	ПокупкиПродажиЦБ.ДатаИВремяСделкиРЕПО КАК ДатаИВремяСделкиРЕПО,
		|	ЕСТЬNULL(ПокупкиПродажиЦБ.ПроцентПоСделкеРЕПО, 0) КАК ПроцентПоСделкеРЕПО,
		|	ПокупкиПродажиЦБ.Сделка КАК Сделка,
		|	ПокупкиПродажиЦБ.Сделка.КонтрагентНаБирже КАК КонтрагентНаБирже,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.МестоХранения <> &РазделFX
		|				И ПокупкиПродажиЦБ.ВалютаСделки <> &ВалютаУчета
		|			ТОГДА &РазделFX
		|		ИНАЧЕ ПокупкиПродажиЦБ.МестоХранения
		|	КОНЕЦ КАК МестоХранения
		|ИЗ
		|	(ВЫБРАТЬ
		|		Сделка.Ссылка КАК Сделка,
		|		Сделка.Ссылка КАК Ссылка,
		|		Сделка.Дата КАК Дата,
		|		Сделка.ВидСделки КАК ВидСделки,
		|		Сделка.НомерСделки КАК НомерСделки,
		|		Сделка.Рынок КАК Рынок,
		|		Сделка.ВалютаСделки КАК ВалютаСделки,
		|		ВЫБОР
		|			КОГДА Сделка.РаздельноеИсполнение
		|				ТОГДА Сделка.ДатаОплаты
		|			КОГДА Сделка.ОтложенноеИсполнение
		|				ТОГДА Сделка.ДатаИсполнения
		|			ИНАЧЕ Сделка.Дата
		|		КОНЕЦ КАК ДатаОплаты,
		|		ВЫБОР
		|			КОГДА Сделка.РаздельноеИсполнение
		|				ТОГДА Сделка.ДатаПоставки
		|			КОГДА Сделка.ОтложенноеИсполнение
		|				ТОГДА Сделка.ДатаИсполнения
		|			ИНАЧЕ Сделка.Дата
		|		КОНЕЦ КАК ДатаПеререгистрации,
		|		"""" КАК ДатаОплатыФакт,
		|		"""" КАК ДатаПеререгистрацииФакт,
		|		СделкаЦенныеБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|		СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|		СделкаЦенныеБумаги.ЦеннаяБумага.Эмитент КАК Эмитент,
		|		СделкаЦенныеБумаги.Количество КАК Количество,
		|		СделкаЦенныеБумаги.Цена КАК Цена,
		|		СделкаЦенныеБумаги.Сумма КАК Сумма,
		|		СделкаЦенныеБумаги.СуммаКупона КАК СуммаКупона,
		|		0 КАК ЧастьСделкиРЕПО,
		|		"""" КАК РодСделкиРЕПО,
		|		"""" КАК НомерСделкиРЕПО,
		|		"""" КАК ДатаИВремяСделкиРЕПО,
		|		"""" КАК ПроцентПоСделкеРЕПО,
		|		Сделка.МестоХранения КАК МестоХранения
		|	ИЗ
		|		Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|			ПО (Сделка.Ссылка = СделкаЦенныеБумаги.Ссылка)
		|	ГДЕ
		|		Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|		И Сделка.Проведен
		|		И Сделка.Организация = &Организация
		|		И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И Сделка.Брокер = &Брокер
		|		И ВЫБОР
		|				КОГДА &Валюта <> НЕОПРЕДЕЛЕНО
		|					ТОГДА Сделка.ВалютаСделки = &Валюта
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИсполнениеОбязательствПоСделке.Основание,
		|		ИсполнениеОбязательствПоСделке.Ссылка,
		|		ИсполнениеОбязательствПоСделке.Основание.Дата,
		|		ИсполнениеОбязательствПоСделке.ВидСделки,
		|		ИсполнениеОбязательствПоСделке.Основание.НомерСделки,
		|		ИсполнениеОбязательствПоСделке.Рынок,
		|		ИсполнениеОбязательствПоСделке.ВалютаСделки,
		|		ИсполнениеОбязательствПоСделке.Дата,
		|		ИсполнениеОбязательствПоСделке.Дата,
		|		ИсполнениеОбязательствПоСделке.Дата,
		|		ИсполнениеОбязательствПоСделке.Дата,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.ДепозитарныйСчет,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага.Эмитент,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Цена,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма,
		|		ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона,
		|		0,
		|		"""",
		|		"""",
		|		"""",
		|		"""",
		|		ИсполнениеОбязательствПоСделке.МестоХранения
		|	ИЗ
		|		Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|			ПО (ИсполнениеОбязательствПоСделке.Ссылка = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка)
		|	ГДЕ
		|		ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|		И ИсполнениеОбязательствПоСделке.Проведен
		|		И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|		И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|		И ВЫБОР
		|				КОГДА &Валюта <> НЕОПРЕДЕЛЕНО
		|					ТОГДА ИсполнениеОбязательствПоСделке.ВалютаСделки = &Валюта
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		СделкаРЕПО.Ссылка,
		|		СделкаРЕПО.Ссылка,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПО.ВидСделки,
		|		СделкаРЕПО.НомерСделки,
		|		СделкаРЕПО.Рынок,
		|		СделкаРЕПО.ВалютаСделки,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПОЦенныеБумаги.ДепозитарныйСчет,
		|		СделкаРЕПОЦенныеБумаги.ЦеннаяБумага,
		|		СделкаРЕПОЦенныеБумаги.ЦеннаяБумага.Эмитент,
		|		СделкаРЕПОЦенныеБумаги.Количество,
		|		СделкаРЕПОЦенныеБумаги.Цена,
		|		СделкаРЕПОЦенныеБумаги.Сумма,
		|		СделкаРЕПОЦенныеБумаги.СуммаКупона,
		|		1,
		|		""Первая часть РЕПО"",
		|		СделкаРЕПО.НомерСделки,
		|		СделкаРЕПО.Дата,
		|		СделкаРЕПО.СтавкаРЕПО,
		|		СделкаРЕПО.МестоХранения
		|	ИЗ
		|		Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|			ПО (СделкаРЕПО.Ссылка = СделкаРЕПОЦенныеБумаги.Ссылка)
		|	ГДЕ
		|		СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|		И СделкаРЕПО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|		И СделкаРЕПО.Проведен
		|		И СделкаРЕПО.Организация = &Организация
		|		И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И СделкаРЕПО.Брокер = &Брокер
		|		И ВЫБОР
		|				КОГДА &Валюта <> НЕОПРЕДЕЛЕНО
		|					ТОГДА СделкаРЕПО.ВалютаСделки = &Валюта
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		УсловияСделокРЕПОСрезПоследних.СделкаРЕПО,
		|		ВтораяЧастьРЕПО.Ссылка,
		|		УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата,
		|		ВтораяЧастьРЕПО.ВидСделки,
		|		ВтораяЧастьРЕПО.НомерСделки,
		|		УсловияСделокРЕПОСрезПоследних.Рынок,
		|		УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВалютаСделки,
		|		УсловияСделокРЕПОСрезПоследних.ДатаОплаты,
		|		УсловияСделокРЕПОСрезПоследних.ДатаПоставки,
		|		"""",
		|		"""",
		|		УсловияСделокРЕПОСрезПоследних.ДепозитарныйСчет,
		|		УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага,
		|		УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага.Эмитент,
		|		УсловияСделокРЕПОСрезПоследних.Количество,
		|		УсловияСделокРЕПОСрезПоследних.Цена,
		|		УсловияСделокРЕПОСрезПоследних.Сумма,
		|		УсловияСделокРЕПОСрезПоследних.СуммаКупона,
		|		2,
		|		""Вторая часть РЕПО"",
		|		УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделки,
		|		УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата,
		|		УсловияСделокРЕПОСрезПоследних.СтавкаРЕПО,
		|		ВтораяЧастьРЕПО.МестоХранения
		|	ИЗ
		|		РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				ЧастьСделкиРЕПО = 2
		|					И НЕ Отменено
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ДатаВторойЧастиРЕПО >= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|					И СделкаРЕПО.Брокер = &Брокер
		|					И ВЫБОР
		|						КОГДА &Валюта <> НЕОПРЕДЕЛЕНО
		|							ТОГДА СделкаРЕПО.ВалютаСделки = &Валюта
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ
		|					И СделкаРЕПО.Дата <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)) КАК УсловияСделокРЕПОСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК ВтораяЧастьРЕПО
		|			ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = ВтораяЧастьРЕПО.ПерваяЧастьРЕПО
		|				И (НЕ ВтораяЧастьРЕПО.ПометкаУдаления)) КАК ПокупкиПродажиЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО (КодыВТорговыхСистемахСрезПоследних.Объект = ПокупкиПродажиЦБ.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитентов
		|		ПО (РеквизитыЭмитентов.ЮрФизЛицо = ПокупкиПродажиЦБ.Эмитент.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(КОНЕЦПЕРИОДА(&Период, ДЕНЬ), Организация = &Организация) КАК УсловияСделокСрезПоследних
		|		ПО (УсловияСделокСрезПоследних.Сделка = ПокупкиПродажиЦБ.Сделка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(КОНЕЦПЕРИОДА(&Период, ДЕНЬ), Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО (УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = ПокупкиПродажиЦБ.Сделка)
		|			И (УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = ПокупкиПродажиЦБ.ЧастьСделкиРЕПО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				День,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоТорговойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК ПлановыеДатыОплатТорговойКомиссии
		|			ПО РасходыПоТорговойКомиссии.Сделка = ПлановыеДатыОплатТорговойКомиссии.Основание
		|				И РасходыПоТорговойКомиссии.Валюта = ПлановыеДатыОплатТорговойКомиссии.Валюта
		|		ПО ПокупкиПродажиЦБ.Сделка = РасходыПоТорговойКомиссии.Сделка
		|			И ПокупкиПродажиЦБ.ЦеннаяБумага = РасходыПоТорговойКомиссии.ЦеннаяБумага
		|			И (ВЫБОР
		|				КОГДА ПокупкиПродажиЦБ.ЧастьСделкиРЕПО = 2
		|					ТОГДА НАЧАЛОПЕРИОДА(РасходыПоТорговойКомиссии.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(ПокупкиПродажиЦБ.Ссылка.Дата, ДЕНЬ)
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				День,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоБрокерскойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК ПлановыеДатыОплатПоБрокерскойКомиссии
		|			ПО РасходыПоБрокерскойКомиссии.Сделка = ПлановыеДатыОплатПоБрокерскойКомиссии.Основание
		|				И РасходыПоБрокерскойКомиссии.Валюта = ПлановыеДатыОплатПоБрокерскойКомиссии.Валюта
		|		ПО ПокупкиПродажиЦБ.Сделка = РасходыПоБрокерскойКомиссии.Сделка
		|			И ПокупкиПродажиЦБ.ЦеннаяБумага = РасходыПоБрокерскойКомиссии.ЦеннаяБумага
		|			И (ВЫБОР
		|				КОГДА ПокупкиПродажиЦБ.ЧастьСделкиРЕПО = 2
		|					ТОГДА НАЧАЛОПЕРИОДА(РасходыПоБрокерскойКомиссии.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(ПокупкиПродажиЦБ.Ссылка.Дата, ДЕНЬ)
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПокупкиПродажиЦБ.СуммаКупона,
		|	ПокупкиПродажиЦБ.Сумма,
		|	ПокупкиПродажиЦБ.ВидСделки,
		|	ПокупкиПродажиЦБ.Дата,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА ПокупкиПродажиЦБ.ДепозитарныйСчет.Родитель.НомерСчета
		|		ИНАЧЕ ПокупкиПродажиЦБ.ДепозитарныйСчет.НомерСчета
		|	КОНЕЦ,
		|	РеквизитыЭмитентов.КраткоеНаименованиеПоУставу,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ""Облигация""
		|		КОГДА ПокупкиПродажиЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ""Пай""
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ПокупкиПродажиЦБ.ЦеннаяБумага.ГосударственныйРегистрационныйНомер,
		|	ПокупкиПродажиЦБ.Количество,
		|	ПокупкиПродажиЦБ.Цена,
		|	РасходыПоБрокерскойКомиссии.Валюта,
		|	ПокупкиПродажиЦБ.ДатаОплаты,
		|	ПокупкиПродажиЦБ.ДатаПеререгистрации,
		|	ПокупкиПродажиЦБ.НомерСделки,
		|	ПокупкиПродажиЦБ.ДатаОплатыФакт,
		|	ПокупкиПродажиЦБ.ДатаПеререгистрацииФакт,
		|	ПокупкиПродажиЦБ.РодСделкиРЕПО,
		|	ПокупкиПродажиЦБ.НомерСделкиРЕПО,
		|	ПокупкиПродажиЦБ.ДатаИВремяСделкиРЕПО,
		|	ПокупкиПродажиЦБ.Сделка,
		|	КодыВТорговыхСистемахСрезПоследних.Код,
		|	ПокупкиПродажиЦБ.ВалютаСделки,
		|	РасходыПоТорговойКомиссии.Валюта,
		|	ПокупкиПродажиЦБ.ПроцентПоСделкеРЕПО,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты,
		|	ПлановыеДатыОплатПоБрокерскойКомиссии.ДатаОплаты,
		|	ПокупкиПродажиЦБ.Сделка.КонтрагентНаБирже,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.Сделка.РежимПереговорныхСделок
		|			ТОГДА ""ММВБ-РПС""
		|		ИНАЧЕ ""ММВБ""
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ПокупкиПродажиЦБ.МестоХранения <> &РазделFX
		|				И ПокупкиПродажиЦБ.ВалютаСделки <> &ВалютаУчета
		|			ТОГДА &РазделFX
		|		ИНАЧЕ ПокупкиПродажиЦБ.МестоХранения
		|	КОНЕЦ,
		|	КодыВТорговыхСистемахСрезПоследних.Код,
		|	ПокупкиПродажиЦБ.ВалютаСделки,
		|	ПокупкиПродажиЦБ.ВалютаСделки,
		|	РасходыПоТорговойКомиссии.Валюта,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты,
		|	РасходыПоТорговойКомиссии.Валюта,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты,
		|	РасходыПоТорговойКомиссии.Валюта,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты,
		|	РасходыПоТорговойКомиссии.Валюта,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСделки";

	Запрос.УстановитьПараметр("Период",                       	Период);
	Запрос.УстановитьПараметр("Организация",                  	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       	Брокер);
	Запрос.УстановитьПараметр("Валюта",                       	Валюта);
	Запрос.УстановитьПараметр("МестоСовершенияСделок",        	МестоСовершенияСделок);	
	Запрос.УстановитьПараметр("ВалютаУчета",			        ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("РазделFX", 						ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX")); 								

	Данные			= Запрос.Выполнить().Выгрузить();
	МассивСделок	= Данные.ВыгрузитьКолонку("Сделка");
	Данные.Колонки.Удалить("Сделка");
	
	РаботаСОтчетами.КонтрольМультивалютностиРасходовПоСделкам(СчетДоверительногоУправления, Неопределено, Неопределено, МассивСделок);
	
	Возврат Данные;

КонецФункции // ПолучитьДанныеСделок

&НаСервереБезКонтекста
Функция ПолучитьЗначенияПолейПустойСделки(Организация, СчетДоверительногоУправления, Период, ПредставлениеРубля = "RUR") 

	ПериодДДММГГГГ = Формат(Период, "ДФ=dd.MM.yyyy");
	НомерСчетаДепо = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Родитель.НомерСчета КАК НомерСчетаДепо
		|ИЗ
		|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Период)
		|	И ИсполнителиПоЦеннымБумагам.Организация = &Организация";

	Запрос.УстановитьПараметр("Организация",                  Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       Период);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НомерСчетаДепо = Выборка.НомерСчетаДепо;
	КонецЕсли;
	
	ЗначенияПолейПустойСделки = Новый Структура;
	ЗначенияПолейПустойСделки.Вставить("ВидСделки",                  "-");
	ЗначенияПолейПустойСделки.Вставить("ДатаСделки",                 ПериодДДММГГГГ + " 10:00:00");
	ЗначенияПолейПустойСделки.Вставить("НомерСчетаДепо",             НомерСчетаДепо);
	ЗначенияПолейПустойСделки.Вставить("МестоСовершенияСделки",      "Брокерский ""ТОРГИ""(РЕГИОН)");
	ЗначенияПолейПустойСделки.Вставить("Депозитарий",                "ДКК");
	ЗначенияПолейПустойСделки.Вставить("Биржа",                      "-");
	ЗначенияПолейПустойСделки.Вставить("КодЦБНаММВБ",                "-");
	ЗначенияПолейПустойСделки.Вставить("Эмитент",                    "-");
	ЗначенияПолейПустойСделки.Вставить("ТипЦБ",                      "-");
	ЗначенияПолейПустойСделки.Вставить("КодЦБНаММВБ1",               "");
	ЗначенияПолейПустойСделки.Вставить("РегНомерЦБ",                 "-");
	ЗначенияПолейПустойСделки.Вставить("Количество",                 "");
	ЗначенияПолейПустойСделки.Вставить("Цена",                       "");
	ЗначенияПолейПустойСделки.Вставить("ВалютаЦены",                 ПредставлениеРубля);
	ЗначенияПолейПустойСделки.Вставить("Сумма",                      "");
	ЗначенияПолейПустойСделки.Вставить("ВалютаСуммы",                "ВалютаСуммы");
	ЗначенияПолейПустойСделки.Вставить("СуммаКупона",                "");
	ЗначенияПолейПустойСделки.Вставить("ВалютаКупона",               ПредставлениеРубля);
	ЗначенияПолейПустойСделки.Вставить("ТорговаяКомиссия",           "");
	ЗначенияПолейПустойСделки.Вставить("ВалютаТорговойКомиссии",     ПредставлениеРубля);
	ЗначенияПолейПустойСделки.Вставить("КомиссияБрокера",            "");
	ЗначенияПолейПустойСделки.Вставить("ВалютаКомиссииБрокера",      ПредставлениеРубля);
	ЗначенияПолейПустойСделки.Вставить("КлинговаяКомиссия",          "");
