
#Область Экспортные_функции

&НаСервере
Функция СформироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов, ОтветственноеЛицо, ПредставлениеРубля = "RUR") Экспорт
	
	// Общий комментарий
	// 
	// По брокеру ГПБ нужно выгружать отдельный файл по каждому счету, указанному в исполнителях
	// 
	// По брокеру БК нужно выгружать только один файл, в котором остатки по секциям объединены в общие ячейки через разделитель $
	// 
	
	// получим наборы полей, попадающие в отчет
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("ПоляОтчетаБрокера");
	
	ГруппыПолейОтчетаБрокера = Новый Структура("Шапка, Сделка, Подвал", Новый Массив, Новый Массив, Новый Массив);
	
	ТекущаяГруппаПолей = "";
	
	Для НомСтр = 1 По Макет.ВысотаТаблицы Цикл
		Если Не ПустаяСтрока(Макет.Область(НомСтр, 1).Текст) Тогда
			ТекущаяГруппаПолей = Макет.Область(НомСтр, 1).Текст;
		КонецЕсли;
		ГруппыПолейОтчетаБрокера[ТекущаяГруппаПолей].Добавить(Макет.Область(НомСтр, 2).Текст);
	КонецЦикла;
	
	// даже если сделка не задана, часть данных всё равно нужно заполнять
	ЗначенияПолейПустойСделки = ПолучитьЗначенияПолейПустойСделки(СчетДоверительногоУправления, Организация, Период, ПредставлениеРубля);

	СтрокаПустаяСделка = "";
	
	Для каждого Поле Из ГруппыПолейОтчетаБрокера.Сделка Цикл
		СтрокаПустаяСделка = СтрокаПустаяСделка + СериализоватьЗнчПоля(ЗначенияПолейПустойСделки[Поле], Поле) + ";";
	КонецЦикла;
	
	// отдельный файл на каждого брокера
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Брокер КАК Брокер,
		|	Валюты.Ссылка КАК Валюта,
		|	ИменованныеОбъекты.Имя КАК ИмяБрокера
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|		ПО ИсполнителиПоДенежнымСредствамБрокерские.Брокер = ИменованныеОбъекты.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО (ВЫБОР
		|				КОГДА ИменованныеОбъекты.Имя = ""Брокер_БК_Регион""
		|					ТОГДА Валюты.Код = ""643""
		|				ИНАЧЕ ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет.Валюта = Валюты.Ссылка
		|			КОНЕЦ)
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       Период);
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыгружатьВОдинФайл 	= Ложь;
	ФайлОткрыт 			= Ложь;
	ТекущийБрокер 		= "";
	
	CSVФайлЗапись = Неопределено;
	
	ЭтоПерваяСтрока = Истина;
	
	Пока Выборка.Следующий() Цикл
		ТекстОтчета = "";
		
		Если ТекущийБрокер = "" Тогда
			ТекущийБрокер = Выборка.ИмяБрокера;
		КонецЕсли;
		
		Если Выборка.ИмяБрокера <> ТекущийБрокер Тогда
			
			Если ВыгружатьВОдинФайл Тогда
				CSVФайлЗапись.Закрыть();    
				ВыгружатьВОдинФайл 	= Ложь;
				ФайлОткрыт 			= Ложь;
			КонецЕсли;
	
			ТекущийБрокер = Выборка.ИмяБрокера;
			
		КонецЕсли;
		
		ВыгружатьВОдинФайл = ?(ТекущийБрокер = "Брокер_БК_Регион", Истина, Ложь);
		
		// сделки                                                      
		ДанныеПоСделкам = ПолучитьДанныеСделок(Организация, СчетДоверительногоУправления, Выборка.Брокер, ?(ТекущийБрокер = "Брокер_БК_Регион", Неопределено, Выборка.Валюта), Период);
		
		ВалютаПервойСделки = ?(ДанныеПоСделкам.Количество() > 0, ДанныеПоСделкам[0].ВалютаСуммы, Неопределено);
		
		// шапка
		ТаблицаДанныхШапки = ПолучитьДанныеШапки(Организация, СчетДоверительногоУправления, Выборка.Брокер, ?(ТекущийБрокер = "Брокер_БК_Регион", Неопределено, Выборка.Валюта), Период, ОтветственноеЛицо, ВалютаПервойСделки);
		
		КоличествоСтрокШапки = ТаблицаДанныхШапки.Количество();
		Если КоличествоСтрокШапки = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СчетДоверительногоУправления + " нет договора с брокером " + Выборка.Брокер + "! Вероятно, в документе неправильно выбран брокер.");
			Продолжить;
 		КонецЕсли;
				
		КопияТаблицаДанныхШапки = ТаблицаДанныхШапки.Скопировать();
		ТаблицаСводныхДвиженийИВалют = ТаблицаДанныхШапки.Скопировать(,"МестоХранения, Приход, Расход, ВалютаДСЗачисление");
		ТаблицаСводныхДвиженийИВалют.Свернуть("МестоХранения, Приход, Расход, ВалютаДСЗачисление");
		
		// Удалим строки без валюты
		СтрокиКУдалению = Новый Массив;
		Для Каждого ТекСтрока Из ТаблицаСводныхДвиженийИВалют Цикл
			Если Не ЗначениеЗаполнено(ТекСтрока.ВалютаДСЗачисление) Тогда
				СтрокиКУдалению.Добавить(ТекСтрока);
			КонецЕсли;				
		КонецЦикла;
		
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ТаблицаСводныхДвиженийИВалют.Удалить(СтрокаКУдалению)
		КонецЦикла;
		
		Если ТаблицаСводныхДвиженийИВалют.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаСводныхДвиженийИВалют.Добавить();
			НоваяСтрока.Приход 				= "0.00";
			НоваяСтрока.Расход				= "0.00";
			НоваяСтрока.ВалютаДСЗачисление 	= "RUR";			
		КонецЕсли;
		
		СтруктураЗаменыДвижений = Новый Структура("Приход, Расход", "0.00", "0.00");
		Если КоличествоСтрокШапки > 1 Тогда
			
			// Нужно свернуть колонки c остатками и валютами остатков в строки с разделителем $
			МассивОстатковНаНачало	= ТаблицаДанныхШапки.ВыгрузитьКолонку("ВходящийОстаток");
			МассивОстатковНаКонец	= ТаблицаДанныхШапки.ВыгрузитьКолонку("ИсходящийОстаток");
			МассивПриходов			= ТаблицаСводныхДвиженийИВалют.ВыгрузитьКолонку("Приход");
			МассивРасходов			= ТаблицаСводныхДвиженийИВалют.ВыгрузитьКолонку("Расход");
			МассивВалютОстатков		= ТаблицаДанныхШапки.ВыгрузитьКолонку("ВалютаОстатка");
			МассивВалютДвижений		= ТаблицаСводныхДвиженийИВалют.ВыгрузитьКолонку("ВалютаДСЗачисление");
						
			СериализоватьДанныеВМассиве(МассивОстатковНаНачало, "ВходящийОстаток");
			СериализоватьДанныеВМассиве(МассивОстатковНаКонец, 	"ИсходящийОстаток");
			СериализоватьДанныеВМассиве(МассивПриходов,		 	"Приход");
			СериализоватьДанныеВМассиве(МассивРасходов,		 	"Расход");
			СериализоватьДанныеВМассиве(МассивВалютОстатков,	"ВалютаОстатка");
			СериализоватьДанныеВМассиве(МассивВалютДвижений,	"ВалютаДвижения");
						
			КопияТаблицаДанныхШапки.Колонки.Удалить("ВходящийОстаток");
			КопияТаблицаДанныхШапки.Колонки.Удалить("ИсходящийОстаток");
			КопияТаблицаДанныхШапки.Колонки.Удалить("Приход");
			КопияТаблицаДанныхШапки.Колонки.Удалить("Расход");
			КопияТаблицаДанныхШапки.Колонки.Удалить("ВалютаОстатка");
			КопияТаблицаДанныхШапки.Колонки.Удалить("ВалютаДСЗачисление");
			КопияТаблицаДанныхШапки.Колонки.Удалить("ВалютаДССписание");
						
			КопияТаблицаДанныхШапки.Колонки.Добавить("ВходящийОстаток",		Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("ИсходящийОстаток", 	Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("Приход", 				Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("Расход", 				Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("ВалютаОстатка", 		Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("ВалютаДСЗачисление",	Новый ОписаниеТипов("Строка"));
			КопияТаблицаДанныхШапки.Колонки.Добавить("ВалютаДССписание",	Новый ОписаниеТипов("Строка"));
						
			КопияТаблицаДанныхШапки[0].ВходящийОстаток		= СтрСоединить(МассивОстатковНаНачало, "$");			
			КопияТаблицаДанныхШапки[0].ИсходящийОстаток		= СтрСоединить(МассивОстатковНаКонец, "$");
			КопияТаблицаДанныхШапки[0].Приход				= СтрСоединить(МассивПриходов, "$");
			КопияТаблицаДанныхШапки[0].Расход				= СтрСоединить(МассивРасходов, "$");
			КопияТаблицаДанныхШапки[0].ВалютаОстатка		= СтрСоединить(МассивВалютОстатков, "$"); 
			КопияТаблицаДанныхШапки[0].ВалютаДСЗачисление	= СтрСоединить(МассивВалютДвижений, "$"); 
			КопияТаблицаДанныхШапки[0].ВалютаДССписание		= СтрСоединить(МассивВалютДвижений, "$"); 
			
			Если ЭтоПерваяСтрока Тогда
				ДанныеШапки = КопияТаблицаДанныхШапки[0];
				СтруктураЗаменыДвижений = Новый Структура("Приход, Расход", ДанныеШапки.Приход, ДанныеШапки.Расход);
			КонецЕсли;

		Иначе  			
			ДанныеШапки = ТаблицаДанныхШапки[0];
			СтруктураЗаменыДвижений = Новый Структура("Приход, Расход", СериализоватьЗнчПоля(ДанныеШапки["Приход"], "Приход"), СериализоватьЗнчПоля(ДанныеШапки["Расход"], "Расход"));			
		КонецЕсли;		
				
		СтрокаШапка = "";		
		ДополнитьСтрокуЗначениями(СтрокаШапка, ГруппыПолейОтчетаБрокера.Шапка, ДанныеШапки);
		
		ДанныеШапки.ВалютаДСЗачисление	= ?(ПустаяСтрока(ДанныеШапки.ВалютаДСЗачисление), "RUR", ДанныеШапки.ВалютаДСЗачисление);
		ДанныеШапки.ВалютаДССписание	= ?(ПустаяСтрока(ДанныеШапки.ВалютаДССписание), "RUR", ДанныеШапки.ВалютаДССписание);
		
		СтрокаПодвал = "";
		ДополнитьСтрокуЗначениями(СтрокаПодвал, ГруппыПолейОтчетаБрокера.Подвал, ДанныеШапки);
				    		           		
		Если ДанныеПоСделкам.Количество() > 0 Тогда
			
			Для каждого ДанныеПоСделке Из ДанныеПоСделкам Цикл
				
				Если Не ЭтоПерваяСтрока Тогда
					
					НайдСтроки = ТаблицаДанныхШапки.НайтиСтроки(Новый Структура("МестоХранения, ВалютаОстатка", ДанныеПоСделке.МестоХранения, ДанныеПоСделке.ВалютаСуммы));
					ДанныеШапки = НайдСтроки[0];
					
					СтрокаШапка = "";
				    ДополнитьСтрокуЗначениями(СтрокаШапка, ГруппыПолейОтчетаБрокера.Шапка, ДанныеШапки, СтруктураЗаменыДвижений);
					
				КонецЕсли;  
				
				ТекстОтчета = ТекстОтчета + СтрокаШапка;
				
				Для каждого Поле Из ГруппыПолейОтчетаБрокера.Сделка Цикл
					Если Поле = "ВалютаСуммы" Тогда
						СтрокаВалюты = ?(ЭтоПерваяСтрока, СтрЗаменить(ДанныеШапки.ВалютаОстатка, "RUB", "RUR"), СериализоватьЗнчПоля(ДанныеПоСделке[Поле], Поле)) + ";";						
						ТекстОтчета = ТекстОтчета + СтрокаВалюты; 
						ЭтоПерваяСтрока = Ложь;					
					Иначе	
						ТекстОтчета = ТекстОтчета + СериализоватьЗнчПоля(ДанныеПоСделке[Поле], Поле) + ";";
					КонецЕсли;
				КонецЦикла;
				
				ТекстОтчета = ТекстОтчета + СтрокаПодвал + Символы.ПС;
			КонецЦикла;
					
		Иначе
			ТекстОтчета = СтрокаШапка + СтрЗаменить(СтрЗаменить(СтрокаПустаяСделка, "ВалютаСуммы", ДанныеШапки.ВалютаОстатка), "RUB", "RUR") + СтрокаПодвал;
							
		КонецЕсли;
		
		Если Не ФайлОткрыт Тогда
			
			Попытка
				CSVФайлЗапись = Новый ЗаписьТекста(КаталогФайлов + "\" + СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + ", " + СтрЗаменить(СокрЛП(Выборка.Брокер), """", "") + ?(ТекущийБрокер = "Брокер_БК_Регион", "", ", " + Выборка.Валюта) + ".csv", КодировкаТекста.ANSI);
				ФайлОткрыт = Истина;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки отчета брокера по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
			
	    CSVФайлЗапись.ЗаписатьСтроку(ТекстОтчета); 
		
		Если Не ВыгружатьВОдинФайл Тогда
			CSVФайлЗапись.Закрыть();
			ФайлОткрыт = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыгружатьВОдинФайл Тогда
		CSVФайлЗапись.Закрыть();    
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервереБезКонтекста
Функция ПолучитьДанныеШапки(Организация, СчетДоверительногоУправления, Брокер, Валюта, Период, ОтветственноеЛицо, ВалютаПервойСделки = Неопределено)
	
	// после долгих дебатов было решено, что комиссия начисляется в тот же день, что и списывается;
	// и торговая и брокерская комиссии пишутся в поле "комиссия брокера"
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредств.ВидДвижения КАК ВидДвижения,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
		|				ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
		|			ТОГДА ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств
		|		ИНАЧЕ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств
		|	КОНЕЦ КАК ВидДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма,
		|	ОстаткиДенежныхСредств.МестоХранения КАК МестоХранения
		|ПОМЕСТИТЬ _СводныеДвиженияДенежныхСредств
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
