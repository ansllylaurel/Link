// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Печать заявления в БК на открытие портфелей",
		"1.16",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ВыбратьДанныеДляЗаполнения(СчетДоверительногоУправления = Неопределено, ИсключатьЗакрытыеСчета = Истина) Экспорт
	
	МассивДанныхДляРасчета = Новый Массив;
	
	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("НачалоПериода",  	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",  		КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация",   		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Стратегия", 			ЭтотОбъект.Стратегия);
		
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия, ЗНАЧЕНИЕ(Справочник.СтратегииИндивидуальногоИнвестирования.ПустаяСсылка)) КАК Стратегия,
	|	ЕСТЬNULL(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код, """") КАК КодСчетаДУ,
	|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокер КАК ОсновнойБрокер,
	|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
	|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойКодУБрокера КАК ОсновнойКодУБрокера,
	|	ВводДенежныхСредств.Ссылка КАК Ссылка,
	|	ВводДенежныхСредств.Дата КАК Дата
	|ПОМЕСТИТЬ _ВводыДС
	|ИЗ
	|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
	|		ПО ВводДенежныхСредств.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&КонецПериода, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
	|		ПО ВводДенежныхСредств.Организация = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация
	|			И ВводДенежныхСредств.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
	|ГДЕ
	|	ВводДенежныхСредств.Дата <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
	|	И ВводДенежныхСредств.Организация = &Организация
	|	И ВводДенежныхСредств.Проведен
	|	И ВводДенежныхСредств.СчетДоверительногоУправления.ДатаЗаключения <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
	|	И ВводДенежныхСредств.ВидОперации В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПайщика), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР))
	|	И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = &Стратегия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВводыДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	МИНИМУМ(_ВводыДС.Дата) КАК Дата
	|ПОМЕСТИТЬ _ПервыеВводыДСПоДате
	|ИЗ
	|	_ВводыДС КАК _ВводыДС
	|
	|СГРУППИРОВАТЬ ПО
	|	_ВводыДС.СчетДоверительногоУправления
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(_ВводыДС.Дата) >= &НачалоПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПервыеВводыДСПоДате.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ПервыеВводыДСПоДате.Дата КАК Дата,
	|	МИНИМУМ(_ВводыДС.Ссылка) КАК ВводДенежныхСредств
	|ПОМЕСТИТЬ _ПервыеВводыДС
	|ИЗ
	|	_ПервыеВводыДСПоДате КАК _ПервыеВводыДСПоДате
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыДС КАК _ВводыДС
	|		ПО _ПервыеВводыДСПоДате.СчетДоверительногоУправления = _ВводыДС.СчетДоверительногоУправления
	|			И _ПервыеВводыДСПоДате.Дата = _ВводыДС.Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	_ПервыеВводыДСПоДате.СчетДоверительногоУправления,
	|	_ПервыеВводыДСПоДате.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПервыеВводыДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_ПервыеВводыДС.Дата КАК Дата,
	|	_ВводыДС.Стратегия КАК Стратегия,
	|	_ВводыДС.КодСчетаДУ КАК КодСчетаДУ,
	|	_ВводыДС.Ссылка КАК ВводДенежныхСредств,
	|	_ВводыДС.ОсновнойБрокер КАК ОсновнойБрокер,
	|	_ВводыДС.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
	|	_ВводыДС.ОсновнойКодУБрокера КАК ОсновнойКодУБрокера
	|ИЗ
	|	_ПервыеВводыДС КАК _ПервыеВводыДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыДС КАК _ВводыДС
	|		ПО _ПервыеВводыДС.СчетДоверительногоУправления = _ВводыДС.СчетДоверительногоУправления
	|			И _ПервыеВводыДС.ВводДенежныхСредств = _ВводыДС.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСчетаДУ,
	|	_ВводыДС.СчетДоверительногоУправления.Наименование";
	                            	
	Запрос.Текст		= ТекстЗапроса;
	РезультатЗапроса	= Запрос.Выполнить();

	Возврат РезультатЗапроса; 
	
КонецФункции // ВыбратьДанныеДляЗаполнения
