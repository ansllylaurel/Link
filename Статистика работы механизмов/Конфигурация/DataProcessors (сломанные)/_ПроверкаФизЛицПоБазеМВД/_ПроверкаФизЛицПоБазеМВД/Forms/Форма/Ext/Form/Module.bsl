
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Период = ТекущаяДата();
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ПолныеПрава = РольДоступна("ПолныеПрава");
	Элементы.Организация.Видимость = ПолныеПрава;
	Элементы.ОрганизацияСсылка.Видимость = Не ПолныеПрава;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСведенияОФайлах();
	УстановитьОтборСпискаФизЛиц();
	ЗаполнитьСписокФизЛицНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Если ЭтаФорма.ФизЛица.Количество() > 0 И Вопрос("Таблица физических лиц уже содержит данные. Перезаполнить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписокФизЛицНаСервере();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Если ЭтаФорма.ФизЛица.Количество() > 0 И Вопрос("Таблица физических лиц уже содержит данные. Перезаполнить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписокФизЛицНаСервере();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	УстановитьОтборСпискаФизЛиц();
КонецПроцедуры

&НаКлиенте
Процедура ФизЛицаФизЛицоПриИзменении(Элемент)
	ЗаполнитьСписокФизЛицНаСервере(Элементы.ФизЛица.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаСайтНажатие(Элемент)
	ЗапуститьПриложение("http://services.fms.gov.ru/info-service.htm?sid=2000");
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            	= ЭтаФорма.ПутьККаталогу;
	Диалог.МножественныйВыбор 	= Ложь; 
	Диалог.Заголовок          	= "Выберите каталог"; 
	
	Диалог.Показать(Новый ОписаниеОповещения("ПутьКФайлуНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда 
		ЭтаФорма.ПутьККаталогу = Диалог.Каталог;
		ОбновитьСведенияОФайлах();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(ЭтаФорма.ПутьККаталогу);
КонецПроцедуры


#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗагрузитьФайл(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗагрузитьФайл");
	Попытка
		ВыполнитьКомандаЗагрузитьФайл();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаЗагрузитьФайл()
	
		ТекстСообщения = "";
		Если ЗначениеЗаполнено(ЭтаФорма.ПутьККаталогу) Тогда
			Файл = Новый Файл(ЭтаФорма.ПутьККаталогу);
			Если Не Файл.Существует() Тогда
				ТекстСообщения = "Указанный каталог не существует";
			ИначеЕсли Не Файл.ЭтоКаталог() Тогда
				ТекстСообщения = "Указанный путь не является каталогом";
			КонецЕсли; 
		Иначе
			ТекстСообщения = "Не заполнен путь к каталогу";
		КонецЕсли; 
	
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ПутьККаталогу");
			Возврат;
	
		КонецЕсли; 	
	
		Состояние("Скачивание списка недействительных паспортов...");
	
		Путь = ЭтаФорма.ПутьККаталогу + ?(Прав(ЭтаФорма.ПутьККаталогу, 1) = "\", "", "\");
	
		//КопироватьФайл("https://guvm.mvd.ru/upload/expired-passports/list_of_expired_passports.csv.bz2", Путь + "list_of_expired_passports.csv.bz2");
		
		АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
		ПолучитьДвоичныеДанные7zip(АдресВоВременномХранилище);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		
			Состояние("Распаковка списка...");
		
			ДвоичныеДанные.Записать(Путь + "7za.exe");
		
			СтрокаЗапуска = Путь + "7za.exe x -y list_of_expired_passports.csv.bz2";
			ЗапуститьПриложение(СтрокаЗапуска, Путь, Истина);
		
			ОбновитьСведенияОФайлах();
		
			Состояние("Файл обновлен");
		
			//УдалитьФайлы(Путь + "list_of_expired_passports.csv.bz2");
			УдалитьФайлы(Путь + "7za.exe");
		
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать архиватор 7za.exe");
		КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьСписокФизЛиц(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗаполнитьСписокФизЛиц");
	Попытка
		ВыполнитьКомандаЗаполнитьСписокФизЛиц();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаЗаполнитьСписокФизЛиц()
	
		ЗаполнитьСписокФизЛицНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьСписокФизЛиц(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПроверитьСписокФизЛиц");
	Попытка
		ВыполнитьКомандаПроверитьСписокФизЛиц();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПроверитьСписокФизЛиц()
	
		Путь = ЭтаФорма.ПутьККаталогу + ?(Прав(ЭтаФорма.ПутьККаталогу, 1) = "\", "", "\");
		Файл = Новый Файл(Путь + "list_of_expired_passports.csv");
	
		Если Не Файл.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден файл списка недействительных паспортов",, "ПутьККаталогу");
			Возврат;
		КонецЕсли; 
	
		Состояние("Выполняется поиск по списку недействительных паспортов...");
	
		УдалитьФайлы(ЭтаФорма.ПутьККаталогу, "РезультатПроверки?.txt");
	
		СтрокаПоискаПолная = ПолучитьСтрокуПоиска();
	
		МассивДляПоиска = СтрРазделить(СтрокаПоискаПолная, " ");
		НомерПроверки = 0;
		СтрокаПоиска = "";
	
		Для Индекс = 0 По МассивДляПоиска.Количество()-1 Цикл

			СерияНомер = МассивДляПоиска[Индекс];
			СтрокаПоиска = СтрокаПоиска + " " + СерияНомер;

			Если (Индекс > 0 И Индекс%300 = 0) 
				Или Индекс = МассивДляПоиска.Количество()-1 Тогда
			
				НомерПроверки = НомерПроверки + 1;
			
				СтрокаПоиска = Сред(СтрокаПоиска, 2);		
				СтрокаКоманды = "findstr /B /L """ + СтрокаПоиска + """ """ + Путь + "list_of_expired_passports.csv"" > """ + Путь + "РезультатПроверки" + НомерПроверки + ".txt""";
				КомандаСистемы(СтрокаКоманды);
			
				СтрокаПоиска = "";

			КонецЕсли;

		КонецЦикла;
	
		МассивНедействительных = Новый Массив;
		Для НомерФайла = 1 По НомерПроверки Цикл

		 	Текст = Новый ЧтениеТекста(Путь + "РезультатПроверки" + НомерФайла + ".txt");
			Стр = Текст.ПрочитатьСтроку();
			Пока Стр <> Неопределено Цикл
			    МассивНедействительных.Добавить(Стр);
			    Стр = Текст.ПрочитатьСтроку();
			КонецЦикла;

		КонецЦикла; 
	
		Для каждого СтрокаФизЛица Из ЭтаФорма.ФизЛица Цикл
			СтрокаФизЛица.ПаспортДействителен = МассивНедействительных.Найти(СтрокаФизЛица.СерияНомер) = Неопределено;
			СтрокаФизЛица.ПроверкаВыполнена = Истина;
		КонецЦикла;
	
		Состояние("Поиск завершен");
	
		Недействительные = ЭтаФорма.ФизЛица.НайтиСтроки(Новый Структура("ПаспортДействителен", Ложь));
		Если Недействительные.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недействительных паспортов не обнаружено");
			ЭтаФорма.РежимОтбора = 2;
		Иначе
			ЭтаФорма.РежимОтбора = 0;
		КонецЕсли; 
		УстановитьОтборСпискаФизЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСкрытьДействительные(Команда)
	
