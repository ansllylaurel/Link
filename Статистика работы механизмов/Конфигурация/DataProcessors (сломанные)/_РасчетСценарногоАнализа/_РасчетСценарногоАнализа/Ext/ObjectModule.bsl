Процедура ЗагрузитьРеперныеДаты() Экспорт
	Если Не ЗначениеЗаполнено(КалендарьТорговыхДней) Тогда
		Сообщить("Не найден календарь торговых дней (""Котировки"") в справочнике ""Календари"".");
		Возврат;
	КонецЕсли;
	
	// Заполнение реперных точек по данным значений сценарных индексов
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	T_Scenario_Indexes_Values.IndexID КАК СценарныйИндекс,
		|	T_Scenario_Indexes_Values.Date КАК РепернаяДата
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Indexes_Values КАК T_Scenario_Indexes_Values
		|ГДЕ
		|	T_Scenario_Indexes_Values.AssetDate = &AssetDate
		|	И T_Scenario_Indexes_Values.CalcID = &CalcID
		|
		|УПОРЯДОЧИТЬ ПО
		|	СценарныйИндекс,
		|	РепернаяДата";
	#КонецОбласти
	Запрос.УстановитьПараметр("AssetDate", ЭтотОбъект.ДатаРасчета);
	Запрос.УстановитьПараметр("CalcID", ЭтотОбъект.НомерРасчета);
	ЭтотОбъект.РеперныеДаты.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРеперныхДат = ЭтотОбъект.РеперныеДаты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРеперныхДат, Выборка);
		СтрокаРеперныхДат.ДнейСНачала = (Выборка.РепернаяДата - ЭтотОбъект.ДатаРасчета) / (60 * 60 * 24);
	КонецЦикла;
	// Расчёт количества торговых дней
	КлючиКоличестваРабочихДней = Новый Соответствие; // Соответствие(Строка ("<ДатаНачала>|<ДатаОкончания>"), Число (Количество рабочих дней))
	МаксимальнаяДата = ЭтотОбъект.ДатаРасчета;
	КалендарьНедозаполнен = Ложь; // Истина - не удалось рассчитать количество рабочих дней через календарь
	Для Каждого СтрокаРеперныхДат Из ЭтотОбъект.РеперныеДаты Цикл
		ТорговыеДниРассчитаны = Ложь;
		// На дату расчёта ни одного дня ещё не прошло
		Если СтрокаРеперныхДат.РепернаяДата = ЭтотОбъект.ДатаРасчета Тогда
			СтрокаРеперныхДат.ТорговыхДнейСНачала = 0;
			ТорговыеДниРассчитаны = Истина;
		КонецЕсли;
		// Расчёт по календарю
		Если Не ТорговыеДниРассчитаны Тогда
			ДатаОкончания = НачалоДня(СтрокаРеперныхДат.РепернаяДата - 1);
			ТекущийКлюч = Формат(ЭтотОбъект.ДатаРасчета, "ДФ=yyyy-MM-dd") + "|" + Формат(ДатаОкончания, "ДФ=yyyy-MM-dd");
			Если МаксимальнаяДата < ДатаОкончания Тогда
				МаксимальнаяДата = ДатаОкончания;
			КонецЕсли;
			НайденноеКоличествоТорговыхДней = КлючиКоличестваРабочихДней.Получить(ТекущийКлюч);
			Если НайденноеКоличествоТорговыхДней <> Неопределено Тогда
				СтрокаРеперныхДат.ТорговыхДнейСНачала = НайденноеКоличествоТорговыхДней;
				ТорговыеДниРассчитаны = Истина;
			ИначеЕсли ЗначениеЗаполнено(КалендарьТорговыхДней) Тогда
				Попытка
					СтрокаРеперныхДат.ТорговыхДнейСНачала = Справочники.Календари.КоличествоРабочихДней(
						КалендарьТорговыхДней, ЭтотОбъект.ДатаРасчета, ДатаОкончания);
					КлючиКоличестваРабочихДней.Вставить(ТекущийКлюч, СтрокаРеперныхДат.ТорговыхДнейСНачала);
					ТорговыеДниРассчитаны = Истина;
				Исключение
					КалендарьНедозаполнен = Истина;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		Если Не ТорговыеДниРассчитаны Тогда
			КалендарьНедозаполнен = Истина;
		КонецЕсли;
		// Приблизительный расчёт
		Если Не ТорговыеДниРассчитаны Тогда
			// Учитывается рассчитанное значение для прошлой реперной точки в разрезе измерений.
			//	Строки уже отсортированы по измерениям и реперным датам.
			ПрошлаяСтрокаПоИзмерениям = Неопределено;
			Если СтрокаРеперныхДат.НомерСтроки > 1 Тогда
				ПрошлаяСтрокаПоИзмерениям = ЭтотОбъект.РеперныеДаты[СтрокаРеперныхДат.НомерСтроки - 2]; // Прошлая строка
				Если ПрошлаяСтрокаПоИзмерениям.СценарныйИндекс <> СтрокаРеперныхДат.СценарныйИндекс Тогда
					ПрошлаяСтрокаПоИзмерениям = Неопределено;
				КонецЕсли;
			КонецЕсли;
			Если ПрошлаяСтрокаПоИзмерениям <> Неопределено Тогда
				СтрокаРеперныхДат.ТорговыхДнейСНачала = ПрошлаяСтрокаПоИзмерениям.ТорговыхДнейСНачала
					+ Цел((СтрокаРеперныхДат.ДнейСНачала - ПрошлаяСтрокаПоИзмерениям.ДнейСНачала) * 5 / 7);
			Иначе
				СтрокаРеперныхДат.ТорговыхДнейСНачала = Цел(СтрокаРеперныхДат.ДнейСНачала * 5 / 7);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если КалендарьНедозаполнен Тогда
		Сообщить("Не удалось рассчитать количество торговых дней в периоде с "
				+ Формат(ЭтотОбъект.ДатаРасчета, "ДФ=dd.MM.yyyy") + " по " + Формат(МаксимальнаяДата, "ДФ=dd.MM.yyyy") + Символы.ПС
			+ "Количество торговых дней между реперными датами, для которых не удалось рассчитать их через календарь, будет рассчитано приблизительно.");
	КонецЕсли;
КонецПроцедуры

