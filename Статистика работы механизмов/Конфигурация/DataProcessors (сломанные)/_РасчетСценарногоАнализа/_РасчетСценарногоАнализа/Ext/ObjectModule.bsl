Функция ПолучитьГруппуСценариев(ДатаРасчета, НомерРасчета) Экспорт
	// Заполнение используемой группы сценариев по данным используемых сценариев
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	T_Scenario_Groups.ID КАК ID
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Indexes_Values КАК T_Scenario_Indexes_Values
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenarios КАК T_Scenarios
		|		ПО T_Scenario_Indexes_Values.ScenarioID = T_Scenarios.ID
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Groups КАК T_Scenario_Groups
		|		ПО T_Scenarios.ScenarioGroupID = T_Scenario_Groups.ID
		|ГДЕ
		|	T_Scenario_Indexes_Values.AssetDate = &AssetDate
		|	И T_Scenario_Indexes_Values.CalcID = &CalcID
		|УПОРЯДОЧИТЬ ПО
		|	T_Scenario_Groups.ID";
	Запрос.УстановитьПараметр("AssetDate", ДатаРасчета);
	Запрос.УстановитьПараметр("CalcID", НомерРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 1 Тогда
		Сообщить("Используемые в расчёте сценарии принадлежат разным группам сценариев. Будет выбрана первая группа сценариев из найденных.");
	КонецЕсли;
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ID;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Получение сценариев по идентификатору группы сценариев
//
// Параметры:
//	ГруппаСценариев - Число - ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Groups.ID
//
// Возвращаемое значение:
//	Массив(Структура(
//		Идентификатор - Число,
//		ГруппаСценариев - Число,
//		Порядок - Число,
//		Наименование - Строка
//	))
Функция ПолучитьСценарии(ГруппаСценариев) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	T_Scenarios.ID КАК Идентификатор,
		|	T_Scenarios.ScenarioGroupID КАК ГруппаСценариев,
		|	T_Scenarios.OrderNumber КАК Порядок,
		|	T_Scenarios.Name КАК Наименование
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenarios КАК T_Scenarios
		|ГДЕ
		|	T_Scenarios.ScenarioGroupID = &ScenarioGroupID
		|	И НЕ T_Scenarios.IsDeleted
		|
		|УПОРЯДОЧИТЬ ПО
		|	OrderNumber";
	Запрос.УстановитьПараметр("ScenarioGroupID", ГруппаСценариев);
	Выборка = Запрос.Выполнить().Выбрать();
	ПолученныеСценарии = Новый Массив; // Возвращаемое значение
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Новый Структура("Идентификатор, ГруппаСценариев, Порядок, Наименование");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ПолученныеСценарии.Добавить(НоваяСтрока);
	КонецЦикла;
	Возврат ПолученныеСценарии;
КонецФункции

Функция ОтфильтроватьСценарииПоИспользуемым(ФильтруемыеСценарии, ПроверяемаяДатаРасчета, ПроверяемыйНомерРасчета) Экспорт
	// Получение активных сценариев
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	T_Scenario_Indexes_Values.ScenarioID КАК Идентификатор
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenarios КАК T_Scenarios,
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Indexes_Values КАК T_Scenario_Indexes_Values
		|ГДЕ
		|	T_Scenario_Indexes_Values.AssetDate = &AssetDate
		|	И T_Scenario_Indexes_Values.CalcID = &CalcID";
	Запрос.УстановитьПараметр("AssetDate", ПроверяемаяДатаРасчета);
	Запрос.УстановитьПараметр("CalcID", ПроверяемыйНомерРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	УникальныеАктивныеСценарии = Новый Соответствие; // Соответствие(Число (Идентификатор сценария))
	Пока Выборка.Следующий() Цикл
		УникальныеАктивныеСценарии.Вставить(Выборка.Идентификатор, Истина);
	КонецЦикла;
	
	Итератор = ФильтруемыеСценарии.Количество() - 1;
	Пока Итератор >= 0 Цикл
		ПолученныйСценарий = ФильтруемыеСценарии[Итератор];
		// Пропуск сценариев без наличия приращений доходности
		Если УникальныеАктивныеСценарии.Получить(ПолученныйСценарий.Идентификатор) = Неопределено Тогда
			ФильтруемыеСценарии.Удалить(Итератор);
		КонецЕсли;
		Итератор = Итератор - 1;
	КонецЦикла;
	
	Возврат ФильтруемыеСценарии;
КонецФункции

// Получение нового информационного текста и пометка его, как прочитанного
//
// Возвращаемое значение:
//	Массив(Структура(
//		"Идентификатор": Число,
//		"Описание": Строка,
//		"ОписаниеОшибки": Строка
//	)
Функция ПолучитьМассивНовогоИнформационныйТекста()
	// Получение ещё не прочитанных логов
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	T_Log.Ссылка КАК Ссылка,
		|	T_Log.ID КАК Идентификатор,
		|	T_Log.Comments КАК Описание,
		|	T_Log.ErrMessage КАК ОписаниеОшибки
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Log КАК T_Log
		|ГДЕ
		|	T_Log.SessionID = &ИдентификаторСессии
		|	И НЕ T_Log.IsRead
		|
		|УПОРЯДОЧИТЬ ПО
		|	T_Log.ID";
	Запрос.УстановитьПараметр("ИдентификаторСессии", ЭтотОбъект.ИдентификаторСессии);
	Выборка = Запрос.Выполнить().Выбрать();
	// Пометка полученных непрочитанных логов
	Результат = Новый Массив; // Возвращаемое значение
	ТекущаяДатаСОформлением = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	ВнешниеИсточникиДанных.RiskControl.НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл //НовыйИнформационныйТекст
			Если Не ПустаяСтрока(Выборка.Описание) Тогда
				Результат.Добавить(ТекущаяДатаСОформлением + Выборка.Описание);
			КонецЕсли;
			Если Не ПустаяСтрока(Выборка.ОписаниеОшибки) Тогда
				Результат.Добавить(ТекущаяДатаСОформлением + Выборка.ОписаниеОшибки);
			КонецЕсли;
			ОбъектЛога = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектЛога.IsRead = Истина;
			ОбъектЛога.Записать();
		КонецЦикла;
		ВнешниеИсточникиДанных.RiskControl.ЗафиксироватьТранзакцию();
	Исключение
		Сообщить(ОписаниеОшибки());
		ВнешниеИсточникиДанных.RiskControl.ОтменитьТранзакцию();
		Результат.Очистить();
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура ПолучитьИВывестиИнформационныйТекст(ТакжеСообщить = Ложь) Экспорт
	МассивНовогоИнформационныйТекста = ПолучитьМассивНовогоИнформационныйТекста();
	Для Каждого СтрокаНовогоИнформационногоТекста Из МассивНовогоИнформационныйТекста Цикл
		ДобавляемыйТекст = СтрЗаменить(СтрокаНовогоИнформационногоТекста, Символы.ПС, Символы.ПС + Символы.Таб);
		ЭтотОбъект.ИнформационныйТекст = ЭтотОбъект.ИнформационныйТекст + Символы.ПС + ДобавляемыйТекст;
		Если ТакжеСообщить Тогда
			Сообщить(ДобавляемыйТекст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОчиститьОписаниеОшибкиSQL(Знач ОписаниеОшибки) Экспорт
	ИндексДляОчистки = СтрНайти(ОписаниеОшибки, "[Microsoft][ODBC SQL Server Driver][SQL Server]");
	Если ИндексДляОчистки <> 0 Тогда
		ОписаниеОшибки = Прав(ОписаниеОшибки, СтрДлина(ОписаниеОшибки) - ИндексДляОчистки + 1);
	КонецЕсли;
	ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "[Microsoft][ODBC SQL Server Driver][SQL Server]", "Ошибка SQL: ");
	Возврат ОписаниеОшибки;
КонецФункции

// Формирование и возврат таблицы, полученной в результате выполнения указанной функции SQL внешних источников данных.
//
// Параметры:
//	МетаданныеТабличнойФункции - ВнешнийИсточникДанныхТаблицаМенеджер.<Имя внешнего источника>.<Имя таблицы внешнего источника данных>
//	ПараметрыТабличнойФункции - Массив
Функция ВыполнитьТабличнуюФункциюВнешнегоИсточникаДанных(МетаданныеТабличнойФункции, ПараметрыТабличнойФункции = Неопределено) Экспорт
	Если Метаданные.НайтиПоПолномуИмени(МетаданныеТабличнойФункции.ПолноеИмя()) = Неопределено Тогда
		Возврат Неопределено; // Метаданные некорректны (нужно проверить на тип метаданных)
	ИначеЕсли МетаданныеТабличнойФункции.ВидТаблицы <> Метаданные.СвойстваОбъектов.ВидТаблицыВнешнегоИсточникаДанных.Выражение Тогда
		Возврат Неопределено; // Это не табличная функция или табличная функция без параметров
	ИначеЕсли МетаданныеТабличнойФункции.Поля.Количество() = 0 Тогда
		Возврат Неопределено; // Нет полей в таблице
	КонецЕсли;
	Если ПараметрыТабличнойФункции = Неопределено Тогда
		ПараметрыТабличнойФункции = Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	<ПоляТаблицыРезультата>
		|ИЗ
		|	<ПолноеИмяТабличнойФункции><(>
		|		<ЗначенияПараметровТабличнойФункции>
		|	<)>
		|";
	// Поля таблицы результата
	ПоляТаблицыРезультата = "";
	Для Каждого ДанныеПоляТаблицы Из МетаданныеТабличнойФункции.Поля Цикл
		ПоляТаблицыРезультата = ПоляТаблицыРезультата + ДанныеПоляТаблицы.Имя + ", ";
	КонецЦикла;
	ПоляТаблицыРезультата = Лев(ПоляТаблицыРезультата, СтрДлина(ПоляТаблицыРезультата) - 2);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ПоляТаблицыРезультата>", ПоляТаблицыРезультата);
	// Параметры табличной функции
	ЗначенияПараметровТабличнойФункции = "";
	ЕстьПараметрыТабличнойФункции = ПараметрыТабличнойФункции.Количество() > 0;
	Для Итератор = 1 По ПараметрыТабличнойФункции.Количество() Цикл
		ЗначенияПараметровТабличнойФункции = ЗначенияПараметровТабличнойФункции + "&Параметр" + Строка(Итератор) + ", ";
	КонецЦикла;
	ЗначенияПараметровТабличнойФункции = Лев(ЗначенияПараметровТабличнойФункции, СтрДлина(ЗначенияПараметровТабличнойФункции) - 2);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ЗначенияПараметровТабличнойФункции>", ЗначенияПараметровТабличнойФункции);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<(>", ?(ЕстьПараметрыТабличнойФункции, "(", ""));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<)>", ?(ЕстьПараметрыТабличнойФункции, ")", ""));
	// Прочее
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ПолноеИмяТабличнойФункции>", МетаданныеТабличнойФункции.ПолноеИмя());
	Для Итератор = 1 По ПараметрыТабличнойФункции.Количество() Цикл
		Запрос.УстановитьПараметр("Параметр" + Строка(Итератор), ПараметрыТабличнойФункции[Итератор - 1]);
	КонецЦикла;
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
КонецФункции

