Процедура ЗагрузитьВидыКлиентов() Экспорт
	// Заполнение списка видов клиентов
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ
		|	VW_Clients.ClientType КАК Наименование
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.VW_Clients КАК VW_Clients
		|ГДЕ
		|	VW_Clients.ClientType <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	VW_Clients.ClientType
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	#КонецОбласти
	Выборка = Запрос.Выполнить().Выбрать();
	ЭтотОбъект.ВидыКлиентов.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЭтотОбъект.ВидыКлиентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьКлиентов(СохранятьВыбранные = Истина) Экспорт
	// Сохранение выбранных строк
	ВыбранныеСтроки = Новый Соответствие; // Соответствие(Строка (Ключ таблицы), Истина)
	Если СохранятьВыбранные Тогда
		Для Каждого СтрокаКлиенты Из ЭтотОбъект.Клиенты Цикл
			Если СтрокаКлиенты.Выбрано Тогда
				ВыбранныеСтроки.Вставить(СтрокаКлиенты.Код, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Заполнение списка клиентов
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ
		|	VW_Clients.ClientCode КАК Код,
		|	МАКСИМУМ(VW_Clients.ClientName) КАК Наименование,
		|	МАКСИМУМ(VW_Clients.ClientType) КАК Вид
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.VW_Clients КАК VW_Clients
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.RiskControl.Таблица.VW_Assets1C8 КАК VW_Assets1C8
		|		ПО VW_Assets1C8.AssetDate = &AssetDate
		|			И VW_Clients.ClientCode = VW_Assets1C8.ClientCode
		|
		|СГРУППИРОВАТЬ ПО
		|	VW_Clients.ClientCode
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	#КонецОбласти
	Запрос.УстановитьПараметр("AssetDate", ЭтотОбъект.ДатаРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	ЭтотОбъект.Клиенты.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЭтотОбъект.Клиенты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если ВыбранныеСтроки.Получить(Выборка.Код) <> Неопределено Тогда
			НоваяСтрока.Выбрано = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

