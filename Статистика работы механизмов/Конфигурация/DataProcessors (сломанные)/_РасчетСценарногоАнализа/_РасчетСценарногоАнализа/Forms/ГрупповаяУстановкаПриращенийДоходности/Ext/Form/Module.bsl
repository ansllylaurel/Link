// Параметры формы:
//	ПриращенияДоходности - Структура:
//		Сценарий - Число(10, 0, +)
//		ГибридноеНаименованиеСценария - Строка(120)
//		СценарныйИндекс - Число(10, 0, +)
//		ГибридноеНаименованиеСценарногоИндекса - Строка(120)
//		Дюрация - Число(8, 3, +)
//		РепернаяДата - Дата
//		ПриращениеДоходности - Число(18, 2)
//		Формула - Строка(100)
//		Выбрано - Булево

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УникальныеСценарии = Новый Соответствие; // Соответствие(Число (Сценарий), Структура (Строка))
	УникальныеСценарныеИндексы = Новый Соответствие; // Соответствие(Число (Сценарный индекс), Структура (Строка))
	УникальныеДюрации = Новый Соответствие; // Соответствие(Число (Дюрация), Структура (Строка))
	УникальныеРеперныеДаты = Новый Соответствие; // Соответствие(Дата (Реперная дата), Структура (Строка))
	Для Каждого СтрокаПриращенийДоходности Из Параметры.ПриращенияДоходности Цикл
		НоваяСтрока = ПриращенияДоходности.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПриращенийДоходности);
		УникальныеСценарии.Вставить(СтрокаПриращенийДоходности.Сценарий, СтрокаПриращенийДоходности);
		УникальныеСценарныеИндексы.Вставить(СтрокаПриращенийДоходности.СценарныйИндекс, СтрокаПриращенийДоходности);
		УникальныеДюрации.Вставить(Формат(СтрокаПриращенийДоходности.Дюрация, "ЧЦ=8; ЧДЦ=3; ЧН=0,000; ЧГ="), СтрокаПриращенийДоходности);
		УникальныеРеперныеДаты.Вставить(СтрокаПриращенийДоходности.РепернаяДата, СтрокаПриращенийДоходности);
	КонецЦикла;
	СортированныеСценарии = Новый СписокЗначений; // СписокЗначений(Число (Сценарий))
	СортированныеСценарныеИндексы = Новый СписокЗначений; // СписокЗначений(Число (Сценарный индекс))
	СортированныеДюрации = Новый СписокЗначений; // СписокЗначений(Число (Дюрация))
	СортированныеРеперныеДаты = Новый СписокЗначений; // СписокЗначений(Дата (Реперная дата))
	Для Каждого КлючЗначение Из УникальныеСценарии Цикл
		СортированныеСценарии.Добавить(КлючЗначение.Ключ, КлючЗначение.Значение.ГибридноеНаименованиеСценария); // !!! Добавить из данных дерева, а потом выставлять Выбрано тем, кого заменяю
	КонецЦикла;
	Для Каждого КлючЗначение Из УникальныеСценарныеИндексы Цикл
		СортированныеСценарныеИндексы.Добавить(КлючЗначение.Ключ, КлючЗначение.Значение.ГибридноеНаименованиеСценарногоИндекса);
	КонецЦикла;
	Для Каждого КлючЗначение Из УникальныеДюрации Цикл
		СортированныеДюрации.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Для Каждого КлючЗначение Из УникальныеРеперныеДаты Цикл
		СортированныеРеперныеДаты.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	СортированныеСценарии.СортироватьПоЗначению();
	СортированныеСценарныеИндексы.СортироватьПоЗначению();
	СортированныеДюрации.СортироватьПоЗначению();
	СортированныеРеперныеДаты.СортироватьПоЗначению();
	Для Каждого Сценарий Из СортированныеСценарии Цикл
		Элементы.ФильтрСценарий.СписокВыбора.Добавить(Сценарий.Значение, Сценарий.Представление);
	КонецЦикла;
	Для Каждого СценарныйИндекс Из СортированныеСценарныеИндексы Цикл
		Элементы.ФильтрСценарныйИндекс.СписокВыбора.Добавить(СценарныйИндекс.Значение, СценарныйИндекс.Представление);
	КонецЦикла;
	Для Каждого Дюрация Из СортированныеДюрации Цикл
		Элементы.ФильтрДюрация.СписокВыбора.Добавить(Дюрация.Значение);
	КонецЦикла;
	Для Каждого РепернаяДата Из СортированныеРеперныеДаты Цикл
		Элементы.ФильтрРепернаяДата.СписокВыбора.Добавить(РепернаяДата.Значение);
	КонецЦикла;
	Элементы.ДекорацияКоличествоСтрок.Заголовок =
		СтрЗаменить("Количество строк: <КоличествоСтрок>", "<КоличествоСтрок>", ПриращенияДоходности.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОтфильтрованныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ФлагЗакрытияФормы Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	// Подтверждение закрытия формы
	Если ЭтаФорма.Модифицированность Тогда
		Ответ = Вопрос("При закрытии формы изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Продолжение закрытия формы
	СтандартнаяОбработка = Истина;
	Отказ = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ФильтрСценарийПриИзменении(Элемент)
	ОбновитьОтфильтрованныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСценарныйИндексПриИзменении(Элемент)
	ОбновитьОтфильтрованныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрДюрацияПриИзменении(Элемент)
	ФильтрДюрация.Очистить();
	Для Каждого СтрокаФильтраДюрацияСтрокой Из ФильтрДюрацияСтрокой Цикл
		ФильтрДюрация.Добавить(Число(СтрокаФильтраДюрацияСтрокой.Значение));
	КонецЦикла;
	ОбновитьОтфильтрованныеСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрРепернаяДатаПриИзменении(Элемент)
	ОбновитьОтфильтрованныеСтроки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаПрименить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрименить");
	Попытка
		ВыполнитьКомандаПрименить();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрименить()
	
		Если ЭтаФорма.Модифицированность Тогда
			ПриращенияДоходностиМассивом = Новый Массив; // Массив(Структура: ПриращенияДоходности[])
			Для Каждого СтрокаПриращенийДоходности Из ПриращенияДоходности Цикл
				СтруктураПриращенийДоходности = Новый Структура(
					"Сценарий, ГибридноеНаименованиеСценария, СценарныйИндекс, ГибридноеНаименованиеСценарногоИндекса,
					|Дюрация, РепернаяДата, ПриращениеДоходности, Формула, Выбрано");
				ЗаполнитьЗначенияСвойств(СтруктураПриращенийДоходности, СтрокаПриращенийДоходности);
				ПриращенияДоходностиМассивом.Добавить(СтруктураПриращенийДоходности);
			КонецЦикла;
			ЭтаФорма.Модифицированность = Ложь;
			Закрыть(ПриращенияДоходностиМассивом);
		Иначе
			Закрыть(); // Не нужно ничего возвращать, если не было изменений
		КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаменить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗаменить");
	Попытка
		ВыполнитьКомандаЗаменить();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаЗаменить()
	
		ЗамененоСтрок = 0;
		ВыбраноСтрок = 0;
		Для Каждого ИндексОтфильтрованнойСтроки Из ОтфильтрованныеСтроки Цикл
			ОтфильтрованнаяСтрока = ПриращенияДоходности[ИндексОтфильтрованнойСтроки.Значение];
			Если ОтфильтрованнаяСтрока.ПриращениеДоходности <> УстанавливаемоеПриращениеДоходности Тогда
				ОтфильтрованнаяСтрока.ПриращениеДоходности = УстанавливаемоеПриращениеДоходности;
				ЗамененоСтрок = ЗамененоСтрок + 1;
				ЭтаФорма.Модифицированность = Истина;
			КонецЕсли;
			Если Не ОтфильтрованнаяСтрока.Выбрано Тогда
				ОтфильтрованнаяСтрока.Выбрано = Истина;
				ВыбраноСтрок = ВыбраноСтрок + 1;
				ЭтаФорма.Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла;
		Предупреждение("Заменено (" + ЗамененоСтрок + ") приращений доходности и выбрано ("
			+ ВыбраноСтрок + ") отфильтрованных строк (установлена галка ""Выбрано"").",, "Результат выполнения");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФормулу(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьФормулу");
	Попытка
		ВыполнитьКомандаУстановитьФормулу();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаУстановитьФормулу()
	
		ОписаниеОповещенияОЗакрытииДочернейФормы = Новый ОписаниеОповещения("УстановкаФормулыПриращенияДоходностиПриЗакрытии", ЭтаФорма);
		ПараметрыФормы = Новый Структура("Объект", Объект);
		ОткрытьФорму("ВнешняяОбработка._РасчетСценарногоАнализа.Форма.УстановкаФормулыПриращенияДоходности",
			ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗакрытииДочернейФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтфильтрованныеСтроки()
	ОтфильтрованныеСтроки.Очистить();
	ТекущийИндекс = -1;
	КоличествоВыбранныхСтрок = 0;
	Для Каждого СтрокаПриращенийДоходности Из ПриращенияДоходности Цикл
		ТекущийИндекс = ТекущийИндекс + 1;
		Если (ФильтрСценарий.Количество() = 0 Или ФильтрСценарий.НайтиПоЗначению(СтрокаПриращенийДоходности.Сценарий) <> Неопределено)
			И (ФильтрСценарныйИндекс.Количество() = 0 Или ФильтрСценарныйИндекс.НайтиПоЗначению(СтрокаПриращенийДоходности.СценарныйИндекс) <> Неопределено)
			И (ФильтрДюрация.Количество() = 0 Или ФильтрДюрация.НайтиПоЗначению(СтрокаПриращенийДоходности.Дюрация) <> Неопределено)
			И (ФильтрРепернаяДата.Количество() = 0 Или ФильтрРепернаяДата.НайтиПоЗначению(СтрокаПриращенийДоходности.РепернаяДата) <> Неопределено)
		Тогда
			ОтфильтрованныеСтроки.Добавить(ТекущийИндекс);
			Если СтрокаПриращенийДоходности.Выбрано Тогда
				КоличествоВыбранныхСтрок = КоличествоВыбранныхСтрок + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Элементы.ДекорацияКоличествоОтфильтрованныхСтрок.Заголовок =
		СтрЗаменить("Количество отфильтрованных строк: <КоличествоОтфильтрованныхСтрок>",
			"<КоличествоОтфильтрованныхСтрок>", ОтфильтрованныеСтроки.Количество());
	Элементы.ДекорацияКоличествоВыбранныхСтрок.Заголовок =
		СтрЗаменить("Количество выбранных строк: <КоличествоВыбранныхСтрок>",
			"<КоличествоВыбранныхСтрок>", КоличествоВыбранныхСтрок);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйИнтерфейс

// Результат - Строка, Неопределено - Формула
&НаКлиенте
Процедура УстановкаФормулыПриращенияДоходностиПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	Если Не ЭтаФорма.Открыта() Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Применение изменений
	ЗамененоСтрок = 0;
	ВыбраноСтрок = 0;
	Для Каждого ИндексОтфильтрованнойСтроки Из ОтфильтрованныеСтроки Цикл
		ОтфильтрованнаяСтрока = ПриращенияДоходности[ИндексОтфильтрованнойСтроки.Значение];
		Если ОтфильтрованнаяСтрока.Формула <> Результат Тогда
			ОтфильтрованнаяСтрока.Формула = Результат;
			ЗамененоСтрок = ЗамененоСтрок + 1;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
		Если Не ОтфильтрованнаяСтрока.Выбрано Тогда
			ОтфильтрованнаяСтрока.Выбрано = Истина;
			ВыбраноСтрок = ВыбраноСтрок + 1;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	Предупреждение("Заменено (" + ЗамененоСтрок + ") формул приращений доходности на """ + Результат + """ и выбрано ("
		+ ВыбраноСтрок + ") отфильтрованных строк (установлена галка ""Выбрано"").",, "Результат выполнения");
КонецПроцедуры

#КонецОбласти
#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
