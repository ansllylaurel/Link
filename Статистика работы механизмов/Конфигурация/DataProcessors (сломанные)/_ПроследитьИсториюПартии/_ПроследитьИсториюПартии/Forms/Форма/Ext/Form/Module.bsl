
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	Если ЗаполнитьПартии() Тогда
		ЭтаФорма.Элементы.Партии.ТекущаяСтрока = ЭтаФорма.Партии[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Только9999999999999999ПриИзменении(Элемент)
	Если ЗаполнитьПартии() Тогда
		ЭтаФорма.Элементы.Партии.ТекущаяСтрока = ЭтаФорма.Партии[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПартии()
	
	Если ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	ВводЦенныхБумагЦенныеБумаги.ДатаПокупки КАК ДатаПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.НомерСделки КАК НомерСделки,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС = ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС
		|			И БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|			И (ВводЦенныхБумагЦенныеБумаги.НомерСделки = ""9999999999999999""
		|				ИЛИ &Все)
		|			И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг))";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.СчетДоверительногоУправления.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ТекущаяДата()), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Все", НЕ ЭтаФорма.Только9999999999999999);
	
	ЭтаФорма.Партии.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Возврат (ЭтаФорма.Партии.Количество() > 0);
	
КонецФункции

&НаКлиенте
Процедура ПроследитьИсторию(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПроследитьИсторию");
	Попытка
		ВыполнитьПроследитьИсторию();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроследитьИсторию()
	
		ДанныеПартий = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
		Если ДанныеПартий = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
			Возврат;
		КонецЕсли;
	
		ЕстьПроблемыСНомеромСделки = Ложь;
		ИсторияПартии = ПроследитьИсториюНаСервере(ДанныеПартий.ЦеннаяБумага, ДанныеПартий.Партия, ДанныеПартий.СтрокаПартии, ЕстьПроблемыСНомеромСделки);
		Если ТипЗнч(ИсторияПартии) = Тип("ТабличныйДокумент") Тогда
			ИсторияПартии.ТолькоПросмотр = Истина;
			ИсторияПартии.ОтображатьСетку = Ложь;
			ИсторияПартии.Показать("История партии: " + ДанныеПартий.ЦеннаяБумага + ", " + ДанныеПартий.Партия + ", " + ДанныеПартий.СтрокаПартии);
		КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроследитьИсториюНаСервере(ЦеннаяБумага, Партия, СтрокаПартии, ЕстьПроблемыСНомеромСделки)
	
	ТаблицаИсторииПартии = Новый ТаблицаЗначений;
	
	ТаблицаИсторииПартии.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаИсторииПартии.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ТаблицаИсторииПартии.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ТаблицаИсторииПартии.Колонки.Добавить("Партия",							Метаданные.ОпределяемыеТипы.Партия.Тип);
	ТаблицаИсторииПартии.Колонки.Добавить("СтрокаПартии",					Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
	ТаблицаИсторииПартии.Колонки.Добавить("Вывод",							Новый ОписаниеТипов("ДокументСсылка.ВыводЦенныхБумаг"));
	ТаблицаИсторииПартии.Колонки.Добавить("Количество",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаИсторииПартии.Колонки.Добавить("ДатаПокупки",					Новый ОписаниеТипов("Дата"));
	ТаблицаИсторииПартии.Колонки.Добавить("НомерСделки",					Новый ОписаниеТипов("Строка"));
	ТаблицаИсторииПартии.Колонки.Добавить("ПозицияПоКоличеству",			Новый ОписаниеТипов("Число"));
	
	ТекущаяПартия = Партия;
	ТекущаяСтрокаПартии = СтрокаПартии;
	ТекущийНомерСделки = "";
	
	Пока ТекущаяПартия <> Неопределено Цикл
	
		СтрокаИстории = ТаблицаИсторииПартии.Добавить();
		
		СтрокаИстории.СчетДоверительногоУправления = ТекущаяПартия.СчетДоверительногоУправления;
		СтрокаИстории.ЦеннаяБумага = ЦеннаяБумага;
		СтрокаИстории.Партия = ТекущаяПартия;
		СтрокаИстории.СтрокаПартии = ТекущаяСтрокаПартии;
		
		ЗаполнитьДанныеПартии(СтрокаИстории, ТекущаяПартия, ТекущаяСтрокаПартии);
		
		Если ТекущийНомерСделки = "" Тогда
			ТекущийНомерСделки = СтрокаИстории.НомерСделки;
		ИначеЕсли ТекущийНомерСделки  = "9999999999999999" И СтрокаИстории.НомерСделки = "" Тогда // переход с пустого номера на 9999999999999999
			ТекущийНомерСделки = СтрокаИстории.НомерСделки;
		ИначеЕсли ТекущийНомерСделки <> СтрокаИстории.НомерСделки Тогда
			ЕстьПроблемыСНомеромСделки = Истина;
		КонецЕсли;
		
		Если ТипЗнч(ТекущаяПартия) <> Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
			Прервать;
		КонецЕсли;
		
		ДанныеВывода = НайтиВывод(СтрокаИстории);
		Если СтрокаИстории.Вывод = Неопределено Тогда
			ТекущаяПартия = Неопределено;
		Иначе
			ТекущаяПартия = ДанныеВывода.Партия;
			ТекущаяСтрокаПартии = ДанныеВывода.СтрокаПартии;
		КонецЕсли;
	
	КонецЦикла;
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаИсторииПартии, , , , Истина);    
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	Возврат ПараметрыВывода.ДокументРезультат;       
	
КонецФункции

&НаСервере
Функция НайтиВывод(СтрокаИстории);

	ДанныеВывода = Новый Структура("Партия, СтрокаПартии");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумаг.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Период МЕЖДУ &Дата1 И &Дата2
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага
		|	И БухПартииЦенныхБумаг.ВидДвижения = &ВидДвижения
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) = ТИП(Документ.ВыводЦенныхБумаг)
		|	И БухПартииЦенныхБумаг.Количество = &Количество";
	
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("Дата1", НачалоДня(СтрокаИстории.Партия.Дата));
	Запрос.УстановитьПараметр("Дата2", КонецДня(СтрокаИстории.Партия.Дата));
	Запрос.УстановитьПараметр("Количество", СтрокаИстории.Количество);
	Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаИстории.ЦеннаяБумага);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтрокаИстории.Вывод = ВыборкаДетальныеЗаписи.Регистратор;
	Иначе		
		СтрокаИстории.Вывод = Неопределено;
	КонецЕсли;

	Если СтрокаИстории.Вывод <> Неопределено И ЗначениеЗаполнено(СтрокаИстории.Вывод) Тогда
	
		ТекущаяПозицияПоКоличеству = 0;
		
		ДвижениеПоПозиции = Неопределено;
		
		ДокументВывод = СтрокаИстории.Вывод.ПолучитьОбъект();
		ДвиженияПартий = ДокументВывод.Движения.БухПартииЦенныхБумаг;
		ДвиженияПартий.Прочитать();
		Для каждого Движение Из ДвиженияПартий Цикл
		
			Если Движение.ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет
				ИЛИ Движение.ВидДвижения <> ВидДвиженияНакопления.Расход
				ИЛИ Движение.ЦеннаяБумага <> СтрокаИстории.ЦеннаяБумага
				ИЛИ Движение.Количество <> СтрокаИстории.Количество
			Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяПозицияПоКоличеству = СтрокаИстории.ПозицияПоКоличеству Тогда
				
				ДвижениеПоПозиции = Движение;
				
			ИначеЕсли ОпределитьНомерСделки(Движение.Партия, Движение.СтрокаПартии) = СтрокаИстории.НомерСделки Тогда
				
				ДанныеВывода.Партия = Движение.Партия;
				ДанныеВывода.СтрокаПартии = Движение.СтрокаПартии;
				
				Возврат ДанныеВывода;
			Иначе
				ТекущаяПозицияПоКоличеству = ТекущаяПозицияПоКоличеству + 1;
			КонецЕсли;
			
			Если ДвижениеПоПозиции <> Неопределено Тогда
			
				ДанныеВывода.Партия = ДвижениеПоПозиции.Партия;
				ДанныеВывода.СтрокаПартии = ДвижениеПоПозиции.СтрокаПартии;
			
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат ДанныеВывода;
	
КонецФункции 

&НаСервере
Функция ОпределитьНомерСделки(Партия, СтрокаПартии)

	Если ТипЗнч(Партия) = Тип("ДокументСсылка.Сделка") Тогда
		Возврат Партия.НомерСделки;
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		Возврат Партия.Основание.НомерСделки;
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		Возврат Партия.ЦенныеБумаги.Найти(СтрокаПартии, "СтрокаПартии").НомерСделки;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ЗаполнитьДанныеПартии(СтрокаИстории, Партия, СтрокаПартии)

	Если ТипЗнч(Партия) = Тип("ДокументСсылка.Сделка") Тогда
		
		СтрокаИстории.ДатаПокупки = НачалоДня(Партия.Дата);
		СтрокаИстории.НомерСделки = Партия.НомерСделки;
		СтрокаИстории.Количество = Партия.ЦенныеБумаги.Итог("Количество");
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		
		СтрокаИстории.ДатаПокупки = НачалоДня(Партия.Дата);
		СтрокаИстории.НомерСделки = Партия.Основание.НомерСделки;	
		СтрокаИстории.Количество = Партия.ЦенныеБумаги.Итог("Количество");
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
	
		СтрокаВвода = Партия.ЦенныеБумаги.Найти(СтрокаПартии, "СтрокаПартии");
		ЗаполнитьЗначенияСвойств(СтрокаИстории, СтрокаВвода, "УчетныйАктивЕПС, Количество, ДатаПокупки, НомерСделки");
		
		ПозицияПоКоличеству = 0;
		Для каждого СтрокаЦенныеБумаги Из Партия.ЦенныеБумаги Цикл
		
			Если СтрокаЦенныеБумаги.ЦеннаяБумага <> СтрокаИстории.ЦеннаяБумага ИЛИ СтрокаЦенныеБумаги.Количество <> СтрокаИстории.Количество Тогда
				Продолжить;
			КонецЕсли;	
			
			Если СтрокаЦенныеБумаги.СтрокаПартии = СтрокаИстории.СтрокаПартии Тогда
				СтрокаИстории.ПозицияПоКоличеству = ПозицияПоКоличеству;
				Прервать;
			Иначе
				ПозицияПоКоличеству = ПозицияПоКоличеству + 1;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ПроверитьВсеНаСервере()
	
	БылиОшибки = Ложь;
	Для каждого СтрокаПартии Из ЭтаФорма.Партии Цикл
		ПроследитьИсториюНаСервере(СтрокаПартии.ЦеннаяБумага, СтрокаПартии.Партия, СтрокаПартии.СтрокаПартии, СтрокаПартии.Ошибка);
		Если СтрокаПартии.Ошибка Тогда
		    БылиОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(БылиОшибки, "Есть ошибки!", "Ошибок нет"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПроверитьВсе");
	Попытка
		ВыполнитьПроверитьВсе();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверитьВсе()
	
		ПроверитьВсеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
	
	ЭтаФорма.Партии.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	ВводЦенныхБумагЦенныеБумаги.ДатаПокупки КАК ДатаПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.НомерСделки КАК НомерСделки,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС = ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС
		|			И БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|			И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг))";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ТекущаяДата()), ВидГраницы.Включая));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЕстьОшибка = Ложь;
		ПроследитьИсториюНаСервере(ВыборкаДетальныеЗаписи.ЦеннаяБумага, ВыборкаДетальныеЗаписи.Партия, ВыборкаДетальныеЗаписи.СтрокаПартии, ЕстьОшибка);
		Если ЕстьОшибка Тогда
			СтрокаПартии = ЭтаФорма.Партии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПартии, ВыборкаДетальныеЗаписи);
			СтрокаПартии.Ошибка = ЕстьОшибка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Проверить");
	Попытка
		ВыполнитьПроверить();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверить()
	
		ПроверитьНаСервере();
	
КонецПроцедуры
#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
