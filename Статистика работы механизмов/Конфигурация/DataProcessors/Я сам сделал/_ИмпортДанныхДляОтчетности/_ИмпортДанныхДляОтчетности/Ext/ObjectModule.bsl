
#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Импорт данных для отчетности",
		"0.07",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	Для Каждого Настройка Из ПолучитьТаблицуИзМакета("ВидимостьРеквизитов") Цикл
		РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, Настройка.ВариантИмпорта, Настройка.Представление,,  Ложь, "ВызовСерверногоМетода");
	КонецЦикла;

	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;

	
КонецПроцедуры // ОповеститьОбОшибках

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнитьКоманду");
		
			ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	
	//заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ПараметрыКоманды.Вставить("ВариантИмпорта", ИдентификаторКоманды);
	ПараметрыКоманды.Вставить("СохранитьФайл",	Истина);
	
	ЗначенияРеквизитовПоУмолчанию = ПолучитьЗначенияРеквизитовПоУмолчанию()[ИдентификаторКоманды];
	РаботаСКоллекциями.ДополнитьСтруктуру(ПараметрыКоманды, ЗначенияРеквизитовПоУмолчанию, Истина);
	
	НастройкиВидимостиРеквизитов = ПолучитьНастройкиВидимостиРеквизитов()[ИдентификаторКоманды];
	//НастройкиВидимостиРеквизитов.Представление;
	
	Если НастройкиВидимостиРеквизитов["ДатаПубликации"] Тогда
		ПараметрыКоманды.Вставить("ДатаПубликации", ПолучитьДатуПубликации(ПараметрыКоманды, ПараметрыСессии));
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("РеквизитыФайла", УпаковатьФайл(ПараметрыКоманды.СсылкаНаФайл));
	
	ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды, ПараметрыСессии);
	
	Если ПараметрыКоманды.Свойство("ИдентификаторФайла") Тогда //этот Файл уже загружался
	ИначеЕсли ПараметрыКоманды.Свойство("НаДатуПубликацииЕстьДругиеФайлы") Тогда
		ВызватьИсключение "Изменился файл " + ЗначенияРеквизитовПоУмолчанию.СсылкаНаФайл + ", но дата публикации осталась прежней " + Формат(ПараметрыКоманды.ДатаПубликации, "ДФ=dd.MM.yyyy") + " на сайте " + ЗначенияРеквизитовПоУмолчанию.АдресСайта + ". Нужно идти к контролёрам и спросить что с этим делать?";
	Иначе //новая дата публикации
		ВыполнитьИмпорт(ПараметрыКоманды, ПараметрыСессии);	
		
		Вложения = Новый Соответствие;
		Вложения.Вставить(ПараметрыКоманды.РеквизитыФайла.ИмяФайла, ПолучитьИзВременногоХранилища(ПараметрыКоманды.РеквизитыФайла.АдресФайлаВХ));
		
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("Тема",		"Загружен " + НастройкиВидимостиРеквизитов.Представление + ?(ПараметрыКоманды.Свойство("ДатаПубликации"), " за " + Формат(ПараметрыКоманды.ДатаПубликации, "ДФ=dd.MM.yyyy"), ""));
		РеквизитыОповещения.Вставить("Тело",		"Загружен " + НастройкиВидимостиРеквизитов.Представление + ?(ПараметрыКоманды.Свойство("ДатаПубликации"), " за " + Формат(ПараметрыКоманды.ДатаПубликации, "ДФ=dd.MM.yyyy"), ""));
		РеквизитыОповещения.Вставить("Вложения",	Вложения);
		
		Справочники.Оповещения.СформироватьОповещения("Обработка._ИмпортДанныхДляОтчетности", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьИмпорт(ПараметрыКоманды, ПараметрыСессии) Экспорт
	
	Если ПараметрыКоманды.Свойство("СохранитьФайл") И ПараметрыКоманды.СохранитьФайл Тогда
		Попытка
			СохранитьФайл(ПараметрыКоманды);
		Исключение
			ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
			ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	Выполнить ПараметрыКоманды.ВариантИмпорта + "(ПараметрыКоманды, ПараметрыСессии)";
		
КонецПроцедуры

#Область ОКУД0420416_ПереченьЦенныхБумаг

Процедура ОКУД0420416_ПереченьЦенныхБумаг(ПараметрыКоманды, ПараметрыСессии) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	Если ПараметрыКоманды.Свойство("РеквизитыФайла") Тогда
		Файл = ПолучитьИзВременногоХранилища(ПараметрыКоманды.РеквизитыФайла.АдресФайлаВХ);
		ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды);
	Иначе	
		Файл = ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Files.НайтиПоПолю("Id", ПараметрыКоманды.ИдентификаторФайла).File_Data;
	КонецЕсли;
	
	Файл.Записать(ИмяВременногоФайла);
	
	Таблица = Новый ТабличныйДокумент;
	Таблица.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение, ТипФайлаТабличногоДокумента.XLSX);
	
	Попытка
		Source_Id	= ВнешниеИсточникиДанных.Externals.Таблицы.Data_Sources.НайтиПоПолю("Id", ПараметрыКоманды.ИдентификаторИсточника);
		File_Id		= ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Files.НайтиПоПолю("Id", ПараметрыКоманды.ИдентификаторФайла);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки; 
	
	НаборЗаписей416 = ВнешниеИсточникиДанных.Externals.Таблицы.dbo_OKUD0420416_Isin_List.СоздатьНаборЗаписей();
	НаборЗаписей416.Отбор.Period.Установить(ПараметрыКоманды.ДатаПубликации);
	
	Для НомерСтроки = 2 По Таблица.ВысотаТаблицы Цикл
		Запись = НаборЗаписей416.Добавить();
		Запись.Source_Id	= Source_Id;
		Запись.File_Id		= File_Id;
		Запись.Isin			= Таблица.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		Запись.Period		= ПараметрыКоманды.ДатаПубликации;
	КонецЦикла;
	
	НаборЗаписей416.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

Функция ПолучитьНастройкиВидимостиРеквизитов() Экспорт
	
	НастройкиВидимостиРеквизитов = Новый Структура;
	
	МакетВидимостьРеквизитов = ПолучитьМакет("ВидимостьРеквизитов");
	
	Для НомерСтроки = 2 По МакетВидимостьРеквизитов.ВысотаТаблицы Цикл
		ТекИмяПакета = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		НастройкиВидимостиРеквизитов.Вставить(ТекИмяПакета, Новый Структура);
		
		НастройкиВидимостиРеквизитов[ТекИмяПакета].Вставить("Представление", СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, 2, НомерСтроки, 2).Текст));
		
		Для НомерКолонки = 3 По МакетВидимостьРеквизитов.ШиринаТаблицы Цикл
			ИмяРеквизита	= СокрЛП(МакетВидимостьРеквизитов.Область(1, НомерКолонки, 1, НомерКолонки).Текст);

			Видимость = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
			Если ВРЕГ(Видимость) = "ДА" Тогда
				Видимость = Истина;
			ИначеЕсли ВРЕГ(Видимость) = "НЕТ" ИЛИ ПустаяСтрока(Видимость) Тогда
				Видимость = Ложь;
			Иначе
				//Если ни нет, ни да, тогда параметр формы 
			КонецЕсли;

			НастройкиВидимостиРеквизитов[ТекИмяПакета].Вставить(ИмяРеквизита, Видимость);
		КонецЦикла;
	КонецЦикла;
	
	Возврат НастройкиВидимостиРеквизитов;
	
КонецФункции

Функция ПолучитьЗначенияРеквизитовПоУмолчанию() Экспорт
	
	ЗначенияРеквизитовПоУмолчанию = Новый Структура;
	
	Данные = ПолучитьТаблицуИзМакета("ЗначенияРеквизитовПоУмолчанию");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗначенияРеквизитовПоУмолчанию.Вставить(СтрокаДанных.ВариантИмпорта, Новый Структура);	
		Для Каждого Колонка Из Данные.Колонки Цикл
			Если Колонка.Имя <> "ВариантИмпорта" Тогда
				ЗначенияРеквизитовПоУмолчанию[СтрокаДанных.ВариантИмпорта].Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ЗначенияРеквизитовПоУмолчанию;
	
КонецФункции

Функция ПолучитьМассивРеквизитовБулево() Экспорт
	
	МассивРеквизитовБулево = Новый Массив;
	
	МассивИсключений = Новый Массив;
	
	Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
		Если МассивИсключений.Найти(Реквизит.Имя) = Неопределено
		   И Реквизит.Тип = Новый ОписаниеТипов("Булево") Тогда
			МассивРеквизитовБулево.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(МассивРеквизитовБулево);
	
КонецФункции

Процедура ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды, ПараметрыСессии = неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_Files.Id КАК Id,
		|	dbo_Files.File_Data КАК File_Data,
		|	dbo_Files.Upload_Time КАК Upload_Time,
		|	dbo_Files.Id В
		|		(ВЫБРАТЬ
		|			dbo_OKUD0420416_Isin_List.File_Id КАК File_Id
		|		ИЗ
		|			ВнешнийИсточникДанных.Externals.Таблица.dbo_OKUD0420416_Isin_List КАК dbo_OKUD0420416_Isin_List
		|		ГДЕ
		|			dbo_OKUD0420416_Isin_List.Source_Id.Id = &ИдентификаторИсточника
		|			И dbo_OKUD0420416_Isin_List.Period = &ДатаПубликации) КАК Используется
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|ГДЕ
		|	dbo_Files.Source_Id.Id = &ИдентификаторИсточника
		|	И dbo_Files.Publication_Date = &ДатаПубликации";
	
	Запрос.УстановитьПараметр("ИдентификаторИсточника", ПараметрыКоманды.ИдентификаторИсточника);
	
	Если ПараметрыКоманды.Свойство("ДатаПубликации") Тогда
		Запрос.УстановитьПараметр("ДатаПубликации", ПараметрыКоманды.ДатаПубликации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И dbo_OKUD0420416_Isin_List.Period = &ДатаПубликации", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И dbo_Files.Publication_Date = &ДатаПубликации", "");
	КонецЕсли;
	
	Файл = ПолучитьИзВременногоХранилища(ПараметрыКоманды.РеквизитыФайла.АдресФайлаВХ);
	
	Попытка
		ФайлВExternals = Запрос.Выполнить().Выбрать();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
        ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Пока ФайлВExternals.Следующий() Цикл
		Если Файл = ФайлВExternals.File_Data Тогда
			ПараметрыКоманды.Вставить("ИдентификаторФайла", ФайлВExternals.Id);
			ПараметрыКоманды.Вставить("ВремяЗагрузки",		ФайлВExternals.Upload_Time);
			ПараметрыКоманды.Вставить("Используется",		ФайлВExternals.Используется);
		ИначеЕсли ПараметрыКоманды.Свойство("ДатаПубликации") Тогда
			ПараметрыКоманды.Вставить("НаДатуПубликацииЕстьДругиеФайлы", Истина);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура СохранитьФайл(ПараметрыКоманды)
	
	ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПараметрыКоманды.РеквизитыФайла.АдресФайла);
	ДанныеФайла.Вставить("ДвоичныеДанные", ПолучитьИзВременногоХранилища(ПараметрыКоманды.РеквизитыФайла.АдресФайлаВХ));
	
	ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДанныеФайла.ДвоичныеДанные, ХешФункция.SHA256);
	
	РаботаСВнешнимиСистемами.СохранитьФайлВExternals(
		ДанныеФайла.Имя, 
		ПараметрыКоманды.ИдентификаторИсточника, 
		ДанныеФайла.ДвоичныеДанные,
		ПараметрыКоманды.ДатаПубликации, 
		Null, 
		ХешСумма);
	
КонецПроцедуры

Функция ПолучитьТаблицуИзМакета(ИмяМакета, Отказ = Ложь)
	
	Таблица = Новый ТаблицаЗначений;
	Макет	= ПолучитьМакет(ИмяМакета);
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "()", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			НоваяСтрока[КолонкаМакета.Ключ]	= СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
		КонецЦикла;	
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДатуПубликации(ПараметрыКоманды, ПараметрыСессии)
	
	Соединение = Новый HTTPСоединение("");
	СтраницаФормы = Соединение.Получить(Новый HTTPЗапрос(ПараметрыКоманды.АдресСайта)).ПолучитьТелоКакСтроку();
	
	НомерСимволаДата= СтрНайти(СтраницаФормы, ПараметрыКоманды.ТегДатыПубликации) + СтрДлина(ПараметрыКоманды.ТегДатыПубликации);
	ДатаПубликации	= РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтраницаФормы, НомерСимволаДата, 10)); 
	
	Если ТипЗнч(ДатаПубликации) <> Тип("Дата") Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось получить с сайта Банка России дату обновления списка ISIN для формы ОКУД0420416");
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		ВызватьИсключение "Не удалось получить с сайта Банка России дату обновления списка ISIN для формы ОКУД0420416";
	КонецЕсли;
		
	Возврат ДатаПубликации;
	
КонецФункции

Функция УпаковатьФайл(АдресФайла)
	
	ЧастиАдресаФайла	= СтрРазделить(АдресФайла, "/\");
	ИмяВременногоФайла	= ПолучитьИмяВременногоФайла();
	
	КопироватьФайл(АдресФайла, ИмяВременногоФайла);
	
	РеквизитыФайла = Новый Структура();
	РеквизитыФайла.Вставить("АдресФайла",	АдресФайла);
	РеквизитыФайла.Вставить("АдресФайлаВХ",	ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), Новый УникальныйИдентификатор));
	РеквизитыФайла.Вставить("ИмяФайла",		ЧастиАдресаФайла[ЧастиАдресаФайла.ВГраница()]);
	
	Возврат РеквизитыФайла;
	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
