
#Область ПрограммныйИнтерфейс

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Импорт текущей ключевой ставки ЦБ РФ", 
		"0.02", 
		"", 
		Истина,
		);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортироватьКлючевуюСтавку", "Импортировать ключевую ставку",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = "ИмпортироватьКлючевуюСтавку" Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортироватьКлючевуюСтавку");
		Попытка
			ИмпортироватьКлючевуюСтавку(Истина, ПараметрыСессии);
		Исключение
			ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		КонецПопытки;
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКоманду

Функция ИмпортироватьКлючевуюСтавку(АвтоматическийЗапуск = Ложь, ПараметрыСессии) Экспорт
	
 	SSL = Новый ЗащищенноеСоединениеOpenSSL(); 
	
	Определения = Новый WSОпределения("https://www.cbr.ru/DailyInfoWebServ/DailyInfo.asmx?WSDL",,,,,SSL); 
	
	Прокси = Новый WSПрокси(Определения,"http://web.cbr.ru/","DailyInfo","DailyInfoSoap",,,SSL);
	
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить("http://web.cbr.ru/").Получить("AllDataInfoXML"); 
	
	WSПараметр = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра); 
	
	РезультатXDTO = Прокси.AllDataInfoXML(WSПараметр);
	
	ДанныеОКлючевойСтавке = РезультатXDTO.AllDataInfoXMLResult.AllData.KEY_RATE;
	
	Если НЕ ЗначениеЗаполнено(ДанныеОКлючевойСтавке.date)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеОКлючевойСтавке.val) Тогда
		
		ТекстСообщения = "В данных, полученных от веб-сервиса ЦБ РФ отсутствуют данные о текущей ключевой ставке!";
		
		Если АвтоматическийЗапуск Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, "Импорт ключевой ставки ЦБ РФ");
		КонецЕсли;
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстСообщения);
		
		Возврат ТекстСообщения;
		
	КонецЕсли;
	
	Дата		= Дата(Прав(ДанныеОКлючевойСтавке.date, 4) + Сред(ДанныеОКлючевойСтавке.date, 4, 2) + Лев(ДанныеОКлючевойСтавке.date, 2));
	Значение	= Число(ДанныеОКлючевойСтавке.val);
	
	ЦБРФ = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрЛицо_ЦБРФ");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата",	Дата);
	Запрос.УстановитьПараметр("ЦБРФ",	ЦБРФ);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПроцентныеПоказателиСрезПоследних.Период КАК Период,
		|	ПроцентныеПоказателиСрезПоследних.ЗначениеПоказателя КАК ЗначениеПоказателя
		|ИЗ
		|	РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
		|			,
		|			Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
		|				И Источник = &ЦБРФ
		|				И Прогноз = ЛОЖЬ
		|				И ДатаЗначения = &Дата) КАК ПроцентныеПоказателиСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		// Сверяем значение ставки
		Если Выборка.ЗначениеПоказателя <> Значение Тогда
			
			ТекстСообщения = СтрШаблон("Импорт ключевой ставки не выполнен! Имеющиеся в системе данные о ключевой ставке (%1) на %2 не соответствуют данным, полученным от веб-сервиса ЦБ РФ (%3)!",
										Формат(Выборка.ЗначениеПоказателя,	"ЧН=0%; ЧГ=0; ЧФ=Ч%"),
										Формат(Дата,						"ДФ=dd.MM.yy"),
										Формат(Значение,					"ЧН=0%; ЧГ=0; ЧФ=Ч%"));
			
			Если АвтоматическийЗапуск Тогда
				РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, "Импорт ключевой ставки ЦБ РФ");
			КонецЕсли;
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстСообщения);
			
			Возврат ТекстСообщения;
			
		Иначе
			Возврат СтрШаблон("Значение ключевой ставки (%1) на %2 ранее уже загружено или установлено вручную.",
								Формат(Значение,	"ЧН=0%; ЧГ=0; ЧФ=Ч%"),
								Формат(Дата,		"ДФ=dd.MM.yy"));
		КонецЕсли;
		
	Иначе
		
		// Добавляем новую запись
		Запись = РегистрыСведений.ПроцентныеПоказатели.СоздатьМенеджерЗаписи();
		
		Запись.Период				= Дата;
		Запись.Показатель			= Перечисления.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ;
		Запись.Прогноз				= Ложь;
		Запись.Источник				= ЦБРФ;
		Запись.ДатаЗначения			= Дата;
		Запись.ЗначениеПоказателя	= Значение;
		
		Попытка
			Запись.Записать();
		Исключение
			
			ТекстСообщения = СтрШаблон("Импорт ключевой ставки ЦБ РФ на %1 не выполнен из-за ошибки:%2",
										Формат(Дата, "ДФ=dd.MM.yy"),
										Символы.ПС + ОписаниеОшибки());
			
			Если АвтоматическийЗапуск Тогда
				РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, "Импорт ключевой ставки ЦБ РФ");
			КонецЕсли;
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстСообщения);
			
			Возврат ТекстСообщения;
			
		КонецПопытки;
		
		ТекстСообщения = СтрШаблон("Загружена информация о новом значении ключевой ставки (%1) на %2.",
									Формат(Значение,	"ЧН=0%; ЧГ=0; ЧФ=Ч%"),
									Формат(Дата,		"ДФ=dd.MM.yy"));
		
		РеквизитыОповещения = Новый Структура;
		
		РеквизитыОповещения.Вставить("Тема",	"Загрузка нового значения ключевой ставки ЦБ РФ");
		РеквизитыОповещения.Вставить("Текст",	ТекстСообщения);
		
		Справочники.Оповещения.СформироватьОповещения("Обработка._ИмпортТекущейКлючевойСтавкиЦБРФ",
														Перечисления.ТипыСобытий.ВнешнийВызов,
														РеквизитыОповещения);
		
		Возврат ТекстСообщения;
		
	КонецЕсли;
	          	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки) Экспорт

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти