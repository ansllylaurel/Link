		|			ТОГДА ДенежныеСредстваМНООстаткиИОбороты.МНО.ДатаВозврата
		|	КОНЕЦ,
		|	ЛОЖЬ,
		|	ДенежныеСредстваМНООстаткиИОбороты.МНО,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваМНООстаткиИОбороты.СуммаКонечныйОстаток = 0
		|			ТОГДА &НачалоДня
		|	КОНЕЦ,
		|	NULL,
		|	NULL,
		|	ЕСТЬNULL(_ПроцентыЕПС.Сумма, 0),
		|	ЕСТЬNULL(_КорректировкиЕПС.Сумма, 0),
		|	ЕСТЬNULL(_ПоказателиБЭКПроценты.Сумма, 0),
		|	_ПоказателиБЭКПроценты.Валюта,
		|	РАЗНОСТЬДАТ(ДенежныеСредстваМНООстаткиИОбороты.МНО.Дата, ДенежныеСредстваМНООстаткиИОбороты.МНО.ДатаВозврата, ДЕНЬ),
		|	РАЗНОСТЬДАТ(&НачалоДня, ДенежныеСредстваМНООстаткиИОбороты.МНО.ДатаВозврата, ДЕНЬ),
		|	_КорректировкиЕПС.Валюта,
		|	_ПроцентыЕПС.Валюта,
		|	КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.ОстаткиИОбороты(&НачалоДня, &КонецДняГраница, День, , Организация = &Организация) КАК ДенежныеСредстваМНООстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоказателиБЭКПроценты КАК _ПоказателиБЭКПроценты
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления = _ПоказателиБЭКПроценты.СчетДоверительногоУправления
		|			И ДенежныеСредстваМНООстаткиИОбороты.МНО = _ПоказателиБЭКПроценты.Депозит
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&НачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.МНО.РасчетныйСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МатрихКодыЮрЛиц КАК МатрихКодыБанков
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ДенежныеСредстваМНООстаткиИОбороты.МНО.РасчетныйСчет.Банк.ЮрФизЛицо) = МатрихКодыБанков.ЮрЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КорректировкиЕПС КАК _КорректировкиЕПС
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления = _КорректировкиЕПС.СчетДоверительногоУправления
		|			И ДенежныеСредстваМНООстаткиИОбороты.МНО = _КорректировкиЕПС.ДепозитныйВклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПроцентыЕПС КАК _ПроцентыЕПС
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления = _ПроцентыЕПС.СчетДоверительногоУправления
		|			И ДенежныеСредстваМНООстаткиИОбороты.МНО = _ПроцентыЕПС.ДепозитныйВклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&НачалоДня, Период = &НачалоДня) КАК КурсыВалютСрезПоследних
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.МНО.РасчетныйСчет.Валюта = КурсыВалютСрезПоследних.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПоказателиБЭКПроценты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _МатрихКодыЮрЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПоказателиБЭКНоминалыРезервы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _КорректировкиЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПроцентыЕПС";
#КонецОбласти
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаФормированияОстатков));
	Запрос.УстановитьПараметр("КонецДняГраница", Новый Граница(ДатаКонецДня, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("УсловияДепозитов", ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов); 
	Запрос.УстановитьПараметр("Депозиты", ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады);
	Запрос.УстановитьПараметр("ВалютаУчета", Организация.ВалютаУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ЭтотОбъект.Активы Тогда
		
		ВыборкаЗаписей = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеПоДепозитам"].ПолучитьДанные().Выбрать();
		
		Пока ВыборкаЗаписей.Следующий() Цикл
			
			Если Не ПустаяСтрока(ВыборкаЗаписей.ДатаФактическогоЗакрытия) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыборкаЗаписей.СуммаПроцентыЕПС > 0 И ВыборкаЗаписей.Валюта <> ВыборкаЗаписей.ВалютаНачисленныхПроцентовЕПС Тогда
				
				ЗарегистрироватьОшибку("Не выгружен депозит [" + ВыборкаЗаписей.Договор + "], Счет доверительного управления [" + ВыборкаЗаписей.НаименованиеСчетаДУ + "]. Т.к. валюта [" + ВыборкаЗаписей.Валюта + "] р/с отличается от валюты [" + ВыборкаЗаписей.ВалютаНачисленныхПроцентовЕПС + "] начисленных процентов ЕПС.");
				Продолжить;
 
			ИначеЕсли ВыборкаЗаписей.КорректировкаЕПС > 0 И ВыборкаЗаписей.Валюта <> ВыборкаЗаписей.ВалютаКорректировкиЕПС Тогда
				
				ЗарегистрироватьОшибку("Не выгружен депозит [" + ВыборкаЗаписей.Договор + "], Счет доверительного управления [" + ВыборкаЗаписей.НаименованиеСчетаДУ + "]. Т.к. валюта [" + ВыборкаЗаписей.Валюта + "] р/с отличается от валюты [" + ВыборкаЗаписей.ВалютаКорректировкиЕПС + "] корректировки ЕПС.");
				Продолжить;
				
			ИначеЕсли ВыборкаЗаписей.СуммаПроцентыБЭК > 0 И ВыборкаЗаписей.Валюта <> ВыборкаЗаписей.ВалютаНачисленныхПроцентовБЭК Тогда
				
				ЗарегистрироватьОшибку("Не выгружен депозит [" + ВыборкаЗаписей.Договор + "], Счет доверительного управления [" + ВыборкаЗаписей.НаименованиеСчетаДУ + "]. Т.к. валюта [" + ВыборкаЗаписей.Валюта + "] р/с отличается от валюты [" + ВыборкаЗаписей.ВалютаНачисленныхПроцентовБЭК + "] начисленных процентов.");
				Продолжить;
				
			КонецЕсли;
			
			НоваяСтрока = ТаблицаДанных.Добавить();
			НоваяСтрока.AssetDate  = ДатаКонецДня;
			НоваяСтрока.ClientCode = ВыборкаЗаписей.КодСчетаДУ;
			НоваяСтрока.ClientName = ВыборкаЗаписей.НаименованиеСчетаДУ;
			НоваяСтрока.AssetType  = ВыборкаЗаписей.ТипДепозита;
			НоваяСтрока.Quantity   = 1;
			НоваяСтрока.AccintBack = ВыборкаЗаписей.СуммаПроцентыБЭК;
			НоваяСтрока.AccintEPS  = ВыборкаЗаписей.СуммаПроцентыЕПС;
			НоваяСтрока.YTM        = ВыборкаЗаписей.Ставка;
			НоваяСтрока.DTM        = ВыборкаЗаписей.КоличествоДнейДоПогашения;
			НоваяСтрока.IssuerID   = ВыборкаЗаписей.МатрихКодБанка;
			НоваяСтрока.RegistrationCode = СокрЛП(ВыборкаЗаписей.Договор);
			НоваяСтрока.FaceValue        = ВыборкаЗаписей.Номинал;
			НоваяСтрока.Overvalue        = ВыборкаЗаписей.КорректировкаЕПС;
			НоваяСтрока.CurrencyCode     = ВыборкаЗаписей.Валюта;
			НоваяСтрока.EvaluationDate   = ВыборкаЗаписей.ДатаРазмещения;
			НоваяСтрока.EvaluationPriceCurrency = ВыборкаЗаписей.СтоимостьАктива;
			НоваяСтрока.CurrRate         = ВыборкаЗаписей.Курс;
			НоваяСтрока.DocumentNumber   = СокрЛП(ВыборкаЗаписей.Депозит.УникальныйИдентификатор());
					
		КонецЦикла;
			
	КонецЕсли;
	
	Если СтатистикаВыполнения <> Неопределено Тогда 
		СтатистикаВыполнения.Процедура_ПолучитьДанныеПоДепозитам = РассчитатьВремя(СтатистикаВыполнения.Процедура_ПолучитьДанныеПоДепозитам);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьДатыПервыхПартий(ДатаФормированияОстатков, МВТ, СтатистикаВыполнения)
	
	Если СтатистикаВыполнения <> Неопределено Тогда
		
		Если СтатистикаВыполнения.Свойство("Процедура_ПолучитьДатыПервыхПартий") Тогда
			СтатистикаВыполнения.Процедура_ПолучитьДатыПервыхПартий = СтатистикаВыполнения.Процедура_ПолучитьДатыПервыхПартий + ", " + ТекущаяДатаСеанса();
		Иначе
			СтатистикаВыполнения.Вставить("Процедура_ПолучитьДатыПервыхПартий", "Время выполнения: " + ТекущаяДатаСеанса());
		КонецЕсли;
		
	КонецЕсли;

	ОшибкаФормированияДанных = Ложь;
		
	ТаблицаДатПокупки = Новый ТаблицаЗначений;
	ТаблицаДатПокупки.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДатПокупки.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ТаблицаДатПокупки.Колонки.Добавить("ДатаПокупки" , Новый ОписаниеТипов("Дата"));
		
	Если ДополнительныеСвойства.Свойство("ЗаполнитьДатыПервыхПартий") И Не ДополнительныеСвойства.Свойство("ЭкспортДанныхРПИ") Тогда
		
#Область Заполнение_даты_первых_партий
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МВТ;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ОстаткиБЭК.СчетДУ КАК СчетДУ
			|ИЗ
			|	_ОстаткиБЭК КАК _ОстаткиБЭК
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|		ПО _ОстаткиБЭК.СчетДУ = ФинансовыеПоказатели.СубъектАналитики
			|			И (ФинансовыеПоказатели.Организация = &Организация)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (ФинансовыеПоказатели.Период = &Дата)";
		
		Запрос.УстановитьПараметр("Дата", ДатаФормированияОстатков);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Не ОшибкаФормированияДанных Тогда 
		
			УстановитьПривилегированныйРежим(Истина);
			
			Пока Выборка.Следующий() Цикл
				
				Попытка
				
					НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ДатаФормированияОстатков, ЭтотОбъект.Организация, Выборка.СчетДУ, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, Истина);
					
					ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, НастройкиОценки.ВидУчетаДляОстатковПартий, НастройкиОценки.ВариантРасчетаОценочнойСтоимости, ДатаФормированияОстатков, Выборка.СчетДУ);
				
					ОписаниеОбъекта = Новый Структура("ЦельРасчета, ВидУчета, Организация, СчетДоверительногоУправления, Ссылка, Дата",
							Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении,
							НастройкиОценки.ВидУчетаДляОстатковПартий,
							ЭтотОбъект.Организация,
							Выборка.СчетДУ,
							Документы.РегистрацияСтоимостиПереоценки.ПустаяСсылка(),
							ДатаФормированияОстатков);
							
					МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
					РаботаСПереоценкой.ПолучитьЦенныеБумаги(ОписаниеОбъекта, МенеджерВременныхТаблиц, "_ТаблицаПартийЦБ", ПараметрыПолученияПартий);
					
				Исключение
					
					ЗарегистрироватьОшибку("По счету ДУ [" + Выборка.СчетДУ + "] не удалось получить таблицу ценных бумаг с партиями на дату [" + Формат(ДатаФормированияОстатков, "ДФ=dd.MM.yyyy") + "]." + Символы.ПС + ОписаниеОшибки());
					Продолжить;
		
				КонецПопытки;
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	0 КАК НомерСтроки,
					|	_ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	_ТаблицаПартийЦБ.Партия КАК Партия,
					|	_ТаблицаПартийЦБ.СтрокаПартии КАК СтрокаПартии,
					|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка) КАК УчетныйАктивЕПС,
					|	_ТаблицаПартийЦБ.Количество КАК Количество
					|ИЗ
					|	_ТаблицаПартийЦБ КАК _ТаблицаПартийЦБ";
				
				ЦенныеБумагиСПартиями = Запрос.Выполнить().Выгрузить();
				
				Попытка
					ДатыПокупкиПартий = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумагиСПартиями, Выборка.СчетДУ, ДатаФормированияОстатков);
				Исключение
					
					ЗарегистрироватьОшибку("По счету ДУ [" + Выборка.СчетДУ + "] не удалось получить таблицу дат покупок партий." + Символы.ПС + ОписаниеОшибки());
					Продолжить;
					
				КонецПопытки;
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.Текст =
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДатыПокупкиПартий.СтрокаПартии КАК СтрокаПартии,
					|	ДатыПокупкиПартий.Партия КАК Партия,
					|	ДатыПокупкиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
					|	ДатыПокупкиПартий.ДатаПокупки КАК ДатаПокупки
					|ПОМЕСТИТЬ _ДатыПокупкиПартий
					|ИЗ
					|	&ДатыПокупкиПартий КАК ДатыПокупкиПартий
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	&СчетДУ КАК СчетДоверительногоУправления,
					|	_ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
					|	МИНИМУМ(ВЫБОР
					|			КОГДА &ЭтоПФР
					|				ТОГДА ЕСТЬNULL(_ДатыПокупкиПартий.ДатаПокупки, ДАТАВРЕМЯ(1980, 1, 1))
					|			ИНАЧЕ _ДатыПокупкиПартий.ДатаПокупки
					|		КОНЕЦ) КАК ДатаПокупки
					|ИЗ
					|	_ТаблицаПартийЦБ КАК _ТаблицаПартийЦБ
					|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПокупкиПартий КАК _ДатыПокупкиПартий
					|		ПО _ТаблицаПартийЦБ.ЦеннаяБумага = _ДатыПокупкиПартий.ЦеннаяБумага
					|			И _ТаблицаПартийЦБ.Партия = _ДатыПокупкиПартий.Партия
					|			И _ТаблицаПартийЦБ.СтрокаПартии = _ДатыПокупкиПартий.СтрокаПартии
					|
					|СГРУППИРОВАТЬ ПО
					|	_ТаблицаПартийЦБ.ЦеннаяБумага";
		
				Запрос.УстановитьПараметр("ДатыПокупкиПартий", ДатыПокупкиПартий.Выгрузить());
				Запрос.УстановитьПараметр("СчетДУ", Выборка.СчетДУ);
				Запрос.УстановитьПараметр("ЭтоПФР", (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СчетДУ, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР));
				
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(Запрос.Выполнить().Выгрузить(), ТаблицаДатПокупки)
							
			КонецЦикла;
			
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
		
#КонецОбласти
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДатПокупки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ТаблицаДатПокупки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаДатПокупки.ДатаПокупки КАК ДатаПокупки
			|ПОМЕСТИТЬ _ДатыПокупкиПартий
			|ИЗ
			|	&ТаблицаДатПокупки КАК ТаблицаДатПокупки";
			
	Запрос.УстановитьПараметр("ТаблицаДатПокупки", ТаблицаДатПокупки);
	
	Запрос.Выполнить();
	
	Если СтатистикаВыполнения <> Неопределено Тогда
		СтатистикаВыполнения.Процедура_ПолучитьДатыПервыхПартий = РассчитатьВремя(СтатистикаВыполнения.Процедура_ПолучитьДатыПервыхПартий);
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьВремя(СтартЗапускаТекст)
	
	СтартЗапуска = Дата(Прав(СтартЗапускаТекст, 19)); //20.01.2023 13:45:36
	
	Финиш = ТекущаяДатаСеанса();
	СтартЗапускаСек = Час(СтартЗапуска) * 60 * 60 + Минута(СтартЗапуска) * 60 + Секунда(СтартЗапуска) ;
	ФинишСек = Час(Финиш) * 60 * 60 + Минута(Финиш) * 60 + Секунда(Финиш);
	ВремяВМинутах = (ФинишСек - СтартЗапускаСек) / 60;
	
	Возврат СтартЗапускаТекст + " - " + ?(День(СтартЗапуска) + День(Финиш), Формат(Финиш, "ДЛФ=В"), Финиш) + " (" + Строка(Цел(ВремяВминутах)) + " м. " + Строка(Цел((ВремяВМинутах - Цел(ВремяВМинутах)) * 60)) + " с.)";
	
КонецФункции

Функция СверитьДанныеВ_Assets1C8() Экспорт
	КодКомпании = "";
	Расхождения = "";
	СтатистикаВыполнения = Новый Структура();
	
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		ДополнительныеСвойства.Вставить("ЭкспортДанныхРПИ", Истина);
	КонецЕсли;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,Период", ПолучитьДопПараметры(Истина));
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СверитьДанныеВ_Assets1C8()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТаблицаДанных1С = ПолучитьТаблицуДляДанных();
	ТипыКолонок = Новый Структура;
	Для Каждого КолонкаТаблицы Из ТаблицаДанных1С.Колонки Цикл
		ТипыКолонок.Вставить(КолонкаТаблицы.Имя, КолонкаТаблицы.ТипЗначения);
	КонецЦикла;
	
	ТипыКолонок.Вставить("Securities", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10)));
	
	СоединениеПолученияДанных = НастроитьСоединение();
	ДатаСверки = ЭтотОбъект.Период.ДатаНачала;
	
	Пока ДатаСверки < ЭтотОбъект.Период.ДатаОкончания Цикл
		ОшибкаФормированияДанных = Ложь;
		ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЭтотОбъект.Организация.ЮрФизЛицо, ДатаСверки);
		
		Если Не ЗначениеЗаполнено(ГоловнаяОрганизация) Или ДатаСверки < Дата(2018, 8, 10) Тогда
			ЮрЛицо = ЭтотОбъект.Организация.ЮрФизЛицо;
		Иначе
			ЮрЛицо = ГоловнаяОрганизация;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
			|ИЗ
			|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|			&ДатаСверки,
			|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
			|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
			|				И Объект = &ЮрЛицо) КАК КодыВоВнешнихСистемахСрезПоследних";
		Запрос.УстановитьПараметр("ДатаСверки", ДатаСверки);
		Запрос.УстановитьПараметр("ЮрЛицо", ЮрЛицо);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			КодКомпании = Выборка.Код;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(КодКомпании) Тогда
			ЗарегистрироватьОшибку("Не удалось получить матрикс код юр лица [" + ЮрЛицо + "].");
			ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения);
			Возврат "";
		КонецЕсли;
		
		TableID = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
		
		ЗапросВРепозиторий =
			"SET NOCOUNT ON
			|
			|IF OBJECT_ID('tempdb..#ChosenData_" + TableID + "') IS NOT NULL
			|	DROP TABLE #ChosenData_" + TableID + "
			|;
			|
			|SELECT *
			|	INTO #ChosenData_" + TableID + "
			|FROM [dbo].[Assets1C8]
			|	WHERE CompanyID = '" + СокрЛП(КодКомпании) + "' -- AND AssetType IN ('Stocks', 'Bills', 'DR', 'Bills of sale', 'MPC', 'Bonds', 'Options', 'Shares', 'Futures', 'Parts', 'Default')
			|	AND AssetDate = " + ДатаSQL(ДатаСверки) + ?(ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)," AND ClientCode = '" + СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) + "'" ,"") + "	
			|;
			|SELECT DISTINCT
			|	 [AssetDate]
			|	,[ClientCode]
			|	,[ClientName]
			|	,CASE WHEN AssetType IN ('Stocks', 'Bills', 'DR', 'Bills of sale', 'MPC', 'Bonds', 'Options', 'Shares', 'Futures', 'Parts', 'Default')
			|			THEN 'Securities'
			|			ELSE ''
			|		END AS Securities
			|	,CASE WHEN AssetType = 'Default'
			|			THEN ''
			|			ELSE AssetType
			|		END AS AssetType
			|	,CASE WHEN AssetID = 0
			|			THEN NULL
			|			ELSE CAST([AssetID] AS varchar(55))
			|		END AS AssetID
			|	,[Class]
			|	,[Quantity]
			|	,[REPOQuantity]
			|	,CASE WHEN IssuerID = 0
			|			THEN NULL
			|			ELSE CAST([IssuerID] AS varchar(55))
			|		END AS IssuerID
			|	,[CurrencyCode]
			|	,[AccintBack]
			|	,[AccintEPS]
			|	,[EvaluationPriceCurrency]
			|	,[EvaluationPriceCurrencyEPS]
			|	,[Overvalue]
			|	,CAST([EvaluationDate] AS datetime) AS EvaluationDate
			|	,[CurrRate]
			|	," + ?(ДополнительныеСвойства.Свойство("ЭкспортДанныхРПИ"), "NULL", "[PurchaseDate]") + " AS PurchaseDate
			|	,CASE WHEN AssetType LIKE 'Debit%' OR AssetType LIKE 'Credit%' OR AssetType IN ('Deposits', 'DepositsREZ', 'MBP')
			|			THEN [YTM]
			|			ELSE NULL
			|		END AS YTM --Депозиты, МНО, дебиторка
			|	,CASE WHEN AssetType IN ('Deposits', 'DepositsREZ', 'MBP')
			|			THEN [FaceValue] --Депозиты, МНО
			|			ELSE NULL
			|	END AS FaceValue
			|	,CASE WHEN AssetType IN ('Deposits', 'DepositsREZ', 'MBP')
			|			THEN [RegistrationCode] --Депозиты, МНО
			|			ELSE NULL
			|		END AS RegistrationCode
			|	,CASE WHEN AssetType IN ('Deposits', 'DepositsREZ', 'MBP')
			|			THEN [DTM] --Депозиты, МНО,
			|			ELSE NULL
			|		END AS DTM
			|	,CASE WHEN AssetType IN ('Deposits', 'DepositsREZ', 'MBP')
			|			THEN [DocumentNumber] --Депозиты, МНО,
			|			ELSE NULL
			|		END AS DocumentNumber
			|FROM #ChosenData_" + TableID + "
			|;
			|DROP TABLE #ChosenData_" + TableID + "";
		
		НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(СоединениеПолученияДанных, ЗапросВРепозиторий);  
		
		Если НаборЗаписей = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаДанныхАссетс = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок, Новый Структура("ВозвращатьПустуюТаблицу", Истина));
		
		Если ТаблицаДанныхАссетс = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		МВТ = Новый МенеджерВременныхТаблиц;
		
		ПолучитьСчетаДУ(ДатаСверки, МВТ, ОшибкаФормированияДанных, ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления));
		
		Если ОшибкаФормированияДанных Тогда
			Прервать;
		КонецЕсли;
		
		ПолучитьДанныеСтоимостиАктивов(ДатаСверки, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
		
		Если ОшибкаФормированияДанных Тогда
			Прервать;
		КонецЕсли;
		
		ПолучитьДанныеПоДепозитам(ДатаСверки, ТаблицаДанных1С, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);

		Если ОшибкаФормированияДанных Тогда
			Прервать;
		КонецЕсли;
		
		ПолучитьОстаткиАктивов(ДатаСверки, ТаблицаДанных1С, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			
		Если ОшибкаФормированияДанных Тогда
			Прервать;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МВТ;
		
		Запрос.Текст =
		#Область ТекстЗапроса
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДанныхАссетс.ClientCode КАК ClientCode,
			|	ТаблицаДанныхАссетс.ClientName КАК ClientName,
			|	ТаблицаДанныхАссетс.AssetType КАК AssetType,
			|	ТаблицаДанныхАссетс.Securities КАК Securities,
			|	ТаблицаДанныхАссетс.AssetID КАК AssetID,
			|	ТаблицаДанныхАссетс.Quantity КАК Quantity,
			|	ТаблицаДанныхАссетс.REPOQuantity КАК REPOQuantity,
			|	ТаблицаДанныхАссетс.IssuerID КАК IssuerID,
			|	ТаблицаДанныхАссетс.CurrencyCode КАК CurrencyCode,
			|	ТаблицаДанныхАссетс.AccintBack КАК AccintBack,
			|	ТаблицаДанныхАссетс.AccintEPS КАК AccintEPS,
			|	ТаблицаДанныхАссетс.EvaluationPriceCurrency КАК EvaluationPriceCurrency,
			|	ТаблицаДанныхАссетс.EvaluationPriceCurrencyEPS КАК EvaluationPriceCurrencyEPS,
			|	ТаблицаДанныхАссетс.Overvalue КАК Overvalue,
			|	ТаблицаДанныхАссетс.EvaluationDate КАК EvaluationDate,
			|	ТаблицаДанныхАссетс.CurrRate КАК CurrRate,
			|	ТаблицаДанныхАссетс.YTM КАК YTM,
			|	ТаблицаДанныхАссетс.FaceValue КАК FaceValue,
			|	ТаблицаДанныхАссетс.RegistrationCode КАК RegistrationCode,
			|	ТаблицаДанныхАссетс.DTM КАК DTM,
			|	ТаблицаДанныхАссетс.Class КАК Class,
			|	ТаблицаДанныхАссетс.DocumentNumber КАК DocumentNumber,
			|	ТаблицаДанныхАссетс.PurchaseDate КАК PurchaseDate
			|ПОМЕСТИТЬ _ТаблицаДанныхАссетс
			|ИЗ
			|	&ТаблицаДанныхАссетс КАК ТаблицаДанныхАссетс
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДанных1С.AssetDate КАК AssetDate,
			|	ТаблицаДанных1С.ClientCode КАК ClientCode,
			|	ТаблицаДанных1С.ClientName КАК ClientName,
			|	ТаблицаДанных1С.AssetType КАК AssetType,
			|	ТаблицаДанных1С.AssetID КАК AssetID,
			|	ТаблицаДанных1С.Quantity КАК Quantity,
			|	ТаблицаДанных1С.REPOQuantity КАК REPOQuantity,
			|	ТаблицаДанных1С.IssuerID КАК IssuerID,
			|	ТаблицаДанных1С.CurrencyCode КАК CurrencyCode,
			|	ТаблицаДанных1С.AccintBack КАК AccintBack,
			|	ТаблицаДанных1С.AccintEPS КАК AccintEPS,
			|	ТаблицаДанных1С.EvaluationPriceCurrency КАК EvaluationPriceCurrency,
			|	ТаблицаДанных1С.EvaluationPriceCurrencyEPS КАК EvaluationPriceCurrencyEPS,
			|	ТаблицаДанных1С.Overvalue КАК Overvalue,
			|	ТаблицаДанных1С.EvaluationDate КАК EvaluationDate,
			|	ТаблицаДанных1С.CurrRate КАК CurrRate,
			|	ТаблицаДанных1С.YTM КАК YTM,
			|	ТаблицаДанных1С.FaceValue КАК FaceValue,
			|	ТаблицаДанных1С.RegistrationCode КАК RegistrationCode,
			|	ТаблицаДанных1С.DTM КАК DTM,
			|	ТаблицаДанных1С.Class КАК Class,
			|	ТаблицаДанных1С.DocumentNumber КАК DocumentNumber,
			|	ТаблицаДанных1С.PurchaseDate КАК PurchaseDate
			|ПОМЕСТИТЬ _ТаблицаДанных1С
			|ИЗ
			|	&ТаблицаДанных1С КАК ТаблицаДанных1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_ТаблицаДанных1С.ClientName, СчетаДоверительногоУправления.Наименование) КАК НаименованиеСчетаДУ,
			|	ЕСТЬNULL(_ТаблицаДанных1С.ClientCode, _ТаблицаДанныхАссетс.ClientCode) КАК КодСчетаДУ,
			|	ЕСТЬNULL(_ТаблицаДанных1С.AssetType, _ТаблицаДанныхАссетс.AssetType) КАК ТипАктива,
			|	ЕСТЬNULL(_ТаблицаДанных1С.AssetID, _ТаблицаДанныхАссетс.AssetID) КАК КодАктива,
			|	ЕСТЬNULL(_ТаблицаДанных1С.IssuerID, _ТаблицаДанныхАссетс.IssuerID) КАК КодЭмитента,
			|	ЕСТЬNULL(_ТаблицаДанных1С.DocumentNumber, _ТаблицаДанныхАссетс.DocumentNumber) КАК КодДепозита,
			|	ВЫБОР
			|		КОГДА _ТаблицаДанныхАссетс.ClientCode ЕСТЬ NULL
			|				ИЛИ _ТаблицаДанных1С.ClientCode ЕСТЬ NULL
			|			ТОГДА ""ClientCode,ClientName,AssetType,AssetID,Quantity,REPOQuantity,IssuerID,CurrencyCode,AccintBack,AccintEPS,EvaluationPriceCurrency,EvaluationPriceCurrencyEPS,Overvalue,EvaluationDate,CurrRate,YTM,FaceValue,RegistrationCode,DTM,Class,PurchaseDate""
			|		ИНАЧЕ ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.ClientName, """") <> ЕСТЬNULL(_ТаблицаДанныхАссетс.ClientName, """")
			|					ТОГДА ""ClientName,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА (ВЫРАЗИТЬ(ЕСТЬNULL(_ТаблицаДанных1С.Quantity, 0) КАК ЧИСЛО(18, 2))) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.Quantity, 0)
			|					ТОГДА ""Quantity,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.AssetType, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.AssetType, 0)
			|					ТОГДА ""AssetType,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.ClientCode, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.ClientCode, 0)
			|					ТОГДА ""ClientCode,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.REPOQuantity, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.REPOQuantity, 0)
			|					ТОГДА ""REPOQuantity,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА _ТаблицаДанных1С.EvaluationDate <> ЕСТЬNULL(_ТаблицаДанныхАссетс.EvaluationDate, НЕОПРЕДЕЛЕНО)
			|					ТОГДА ""EvaluationDate,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.EvaluationPriceCurrency, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.EvaluationPriceCurrency, 0)
			|					ТОГДА ""EvaluationPriceCurrency,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.EvaluationPriceCurrencyEPS, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.EvaluationPriceCurrencyEPS, 0)
			|					ТОГДА ""EvaluationPriceCurrencyEPS,""
			|				ИНАЧЕ """"
			|			КОНЕЦ + ВЫБОР
			|				КОГДА ЕСТЬNULL(_ТаблицаДанных1С.AccintBack, 0) <> ЕСТЬNULL(_ТаблицаДанныхАссетс.AccintBack, 0)
			|					ТОГДА ""AccintBack,""
