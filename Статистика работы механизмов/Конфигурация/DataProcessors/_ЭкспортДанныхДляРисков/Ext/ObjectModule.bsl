		|	_ИнвестПрофилиСчетов.Цель.ОжидаемаяДоходностьВПроцентах,
		|	_ИнвестПрофилиСчетов.Цель.ДопустимыйРискВПроцентах,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ИнвестПрофилиСчетов.Цель.ДопустимыйРиск, """") = """"
		|			ТОГДА ""не заполнено""
		|		ИНАЧЕ _ИнвестПрофилиСчетов.Цель.ДопустимыйРиск
		|	КОНЕЦ
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИнвестПрофилиСчетов КАК _ИнвестПрофилиСчетов
		|		ПО _СчетаДоверительногоУправления.Ссылка = _ИнвестПрофилиСчетов.Ссылка
		|			И _СчетаДоверительногоУправления.Организация = _ИнвестПрофилиСчетов.Организация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
		|		ПО _СчетаДоверительногоУправления.Ссылка = _Клиенты.СчетДоверительногоУправления
		|			И _СчетаДоверительногоУправления.Организация = _Клиенты.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КвалИнвесторы КАК _КвалИнвесторы
		|		ПО _СчетаДоверительногоУправления.Ссылка = _КвалИнвесторы.СчетДоверительногоУправления";
	#КонецОбласти
	
	НеопределенныеСчета = Новый Массив;
	НеопределенныеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_Траст"));
	НеопределенныеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_РЭМ"));
	
	Запрос.УстановитьПараметр("Период", Период.ДатаОкончания); 
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Индивидуальная", ОбщегоНазначения.ПолучитьИменованныйОбъект("Стратегия_Индивидуальная"));
	Запрос.УстановитьПараметр("Ключ", "УчетНеВедется");
	Запрос.УстановитьПараметр("НеопределенныеСчета", НеопределенныеСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчетчикОшибок = 0;
	Пока Выборка.Следующий() Цикл
		ЗапросSQL =
			"EXEC dbo.P_ClientProfiles1С8_add
			|	@ClientName       = '"+ Выборка.НаименованиеСчетаДУ +"',
			|	@ClientCode       = '"+ Выборка.КодСчетаДУ +"',
			|	@DateProfileBegin =  "+ ДатаSQL(Выборка.ДатаЗаключенияДоговораДУ) +",
			|	@DateHorizonBegin =  "+ ДатаSQL(Выборка.ГоризонтНачало) +",
			|	@DateHorizonEnd   =  "+ ДатаSQL(Выборка.ГоризонтОкончание) +",
			|	@CurrencyCode     = '"+ Выборка.ЦельВалютаНаименование +"',
			|	@is_legal_QI      = '"+ Выборка.КвалВСилуЗакона +"',
			|	@is_uk_QI         = '"+ Выборка.КвалДляУК +"',
			|	@Is_Firm          = '"+ Выборка.ФлагЮрФизЛицо +"',
			|	@Strategy         = '"+ Выборка.Стратегия +"',
			|	@InvestPurpose    = '"+ Выборка.ЦельНаименование +"',
			|	@YeildProfile     = '"+ ЧислоSQL(Выборка.ЦельДоходностьВПроцентах) +"',
			|	@RiskProfile      = '"+ ЧислоSQL(Выборка.ЦельРискВПроцентах) +"',
			|	@RiskProfileType  = '"+ Выборка.ЦельДопустимыйРиск +"'";
			
		Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение, "Не удалось выгрузить характеристику о клиенте : "+ Выборка.НаименованиеСчетаДУ +" в ClientProfiles1С8") Тогда
			СчетчикОшибок = СчетчикОшибок + 1;
		КонецЕсли;
		
		Если СчетчикОшибок = 3 Тогда
			ЗарегистрироватьОшибку("Выгрузка данных в ClientProfiles1С8 была прервана из-за ошибки выполнения запросов. Возможно возникли неполадки с соединением.");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_ClientProfiles1С8 = РассчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_ClientProfiles1С8);
КонецПроцедуры

Процедура ВыгрузитьДанныеВ_Quotes1C8(Соединение, СтатистикаВыполнения)
	Если СтатистикаВыполнения.Свойство("Процедура_ВыгрузитьДанныеВ_Quotes1C8") Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8 = СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8 + ", " + ТекущаяДатаСеанса();
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ВыгрузитьДанныеВ_Quotes1C8", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.Период КАК Период,
		|	КотировкиТорговыхПлощадок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.Биржа КАК Биржа,
		|	КотировкиТорговыхПлощадок.РежимТоргов.Код КАК РежимТорговКод,
		|	КотировкиТорговыхПлощадок.ACCINT КАК ACCINT,
		|	КотировкиТорговыхПлощадок.CLOSE КАК CLOSE,
		|	КотировкиТорговыхПлощадок.WAPRICE КАК WAPRICE,
		|	КотировкиТорговыхПлощадок.BID КАК BID,
		|	КотировкиТорговыхПлощадок.OFFER КАК OFFER,
		|	КотировкиТорговыхПлощадок.ADMITTEDQUOTE КАК ADMITTEDQUOTE,
		|	КотировкиТорговыхПлощадок.LEGALCLOSEPRICE КАК LEGALCLOSEPRICE,
		|	КотировкиТорговыхПлощадок.HIGH КАК HIGH,
		|	КотировкиТорговыхПлощадок.LOW КАК LOW,
		|	КотировкиТорговыхПлощадок.VOLUME КАК VOLUME,
		|	КотировкиТорговыхПлощадок.VALUE КАК VALUE,
		|	КотировкиТорговыхПлощадок.NUMTRADES КАК NUMTRADES,
		|	КотировкиТорговыхПлощадок.Валюта.Наименование КАК ВалютаНаименование
		|ПОМЕСТИТЬ _Котировки
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И &ДопУсловиеОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Котировки.Период КАК Date,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN,
		|	КодыМатрихЦБСрезПоследних.Код КАК Matrix_id,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 5, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 4)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 6, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 5)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 7, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 6)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 8, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 7)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 9, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 8)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 10, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 9)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 11, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 10)
		|		КОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 12, 1) = ""(""
		|			ТОГДА ПОДСТРОКА(_Котировки.Биржа.Наименование, 1, 11)
		|		ИНАЧЕ _Котировки.Биржа.Наименование
		|	КОНЕЦ КАК Exchange,
		|	КодыМатрихЮрЛицБиржСрезПоследних.Код КАК Exchange_id,
		|	ВЫБОР
		|		КОГДА _Котировки.РежимТорговКод В (""BGN"", ""BVAL"")
		|			ТОГДА _Котировки.РежимТорговКод
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК TradingMode,
		|	_Котировки.ACCINT КАК Accint,
		|	ВЫБОР
		|		КОГДА _Котировки.РежимТорговКод = ""BGN""
		|				ИЛИ _Котировки.РежимТорговКод = ""BVAL""
		|			ТОГДА _Котировки.CLOSE
		|		ИНАЧЕ _Котировки.LEGALCLOSEPRICE
		|	КОНЕЦ КАК px_Last,
		|	_Котировки.WAPRICE КАК px_Mid,
		|	_Котировки.BID КАК px_Bid,
		|	_Котировки.OFFER КАК px_Ask,
		|	_Котировки.HIGH КАК px_High,
		|	_Котировки.LOW КАК px_Low,
		|	_Котировки.VOLUME КАК Volume,
		|	_Котировки.VALUE КАК TurnOver,
		|	_Котировки.NUMTRADES КАК Num_Trades,
		|	_Котировки.ВалютаНаименование КАК Currency
		|ИЗ
		|	_Котировки КАК _Котировки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И (ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ДепозитарныеРасписки)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Векселя)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Паи)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия))) КАК КодыМатрихЦБСрезПоследних
		|		ПО _Котировки.ЦеннаяБумага = КодыМатрихЦБСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&НачалоПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _Котировки.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыМатрихЮрЛицБиржСрезПоследних
		|		ПО _Котировки.Биржа.ЮрФизЛицо = КодыМатрихЮрЛицБиржСрезПоследних.Объект";
	#КонецОбласти
	
	Если ЭтотОбъект.ЦеннаяБумага = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловиеОтбора", "НЕ КотировкиТорговыхПлощадок.Биржа = &Биржа");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловиеОтбора", "НЕ КотировкиТорговыхПлощадок.Биржа = &Биржа
													|И КотировкиТорговыхПлощадок.ЦеннаяБумага = &ЦеннаяБумага");
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПереченьКолонок = РезультатЗапроса.Колонки;
	
	ПоляЗапросаSQL = "(";
	КоличествоПолей = ПереченьКолонок.Количество() - 1;
	
	Для Номер = 0 По КоличествоПолей Цикл
		ПоляЗапросаSQL = ПоляЗапросаSQL + ПереченьКолонок[Номер].Имя + ?(Номер < КоличествоПолей, ", ", ") ");
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8 = РасСчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
		ЗапросISIN = Новый Запрос;
		ЗапросISIN.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	КодыВТорговыхСистемахСрезПоследних.Код КАК Код
			|ИЗ
			|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
			|			&Период,
			|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
			|				И Объект = &ЦеннаяБумага) КАК КодыВТорговыхСистемахСрезПоследних";
		ЗапросISIN.УстановитьПараметр("Период"      , ЭтотОбъект.Период.ДатаНачала);
		ЗапросISIN.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага); 
		
		ВыборкаISIN = ЗапросISIN.Выполнить().Выбрать();
		
		Пока ВыборкаISIN.Следующий() Цикл
			
			Если Не ВыполнитьЗапрос("BEGIN TRANSACTION Quotes
				                    |DELETE FROM dbo.Quotes1C8 WHERE ISIN = '" + СокрЛП(ВыборкаISIN.Код) + "' AND Date BETWEEN " + ДатаSQL(ЭтотОбъект.Период.ДатаНачала) + " AND " + ДатаSQL(ЭтотОбъект.Период.ДатаОкончания) + "", Соединение, "Перед загрузкой котировок в б/д Repository не удалось очистить таблицу!") Тогда
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Если Не ВыполнитьЗапрос("BEGIN TRANSACTION Quotes
			                    |DELETE FROM dbo.Quotes1C8 WHERE Date BETWEEN " + ДатаSQL(ЭтотОбъект.Период.ДатаНачала) + " AND " + ДатаSQL(ЭтотОбъект.Период.ДатаОкончания) + "", Соединение, "Перед загрузкой котировок в б/д Repository не удалось очистить таблицу!") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаЗапроса = "";
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		ЗначениеПолейЗапросаSQL = "(";
		
		Для Номер = 0 По КоличествоПолей Цикл
			Значение = Выборка[Номер];
			
			Если ТипЗнч(Значение) = Тип("Дата") Тогда
				Значение = ДатаSQL(Значение);
			ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
				Значение = "'" + ЧислоSQL(Значение) + "'";
			Иначе
				Значение = "'" + Значение + "'";
			КонецЕсли;
			
			ЗначениеПолейЗапросаSQL = ЗначениеПолейЗапросаSQL + Значение + ?(Номер < КоличествоПолей, ", ", ")");
		КонецЦикла;
		
		ЗапросSQL = "INSERT dbo.Quotes1C8 " + ПоляЗапросаSQL + " VALUES " + ЗначениеПолейЗапросаSQL;
		
		СтрокаЗапроса = СтрокаЗапроса + ?(ПустаяСтрока(СтрокаЗапроса), "", Символы.ПС) + ЗапросSQL;
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 100 Тогда
			Если Не ВыполнитьЗапрос(СтрокаЗапроса, Соединение, "Не удалось выгрузить котировки в б/д Repository AP18 (риск-менеджмент).") Тогда
				ВыполнитьЗапрос("ROLLBACK TRANSACTION Quotes", Соединение);
				Возврат;
			КонецЕсли;
			
			СтрокаЗапроса = "";
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаЗапроса <> "" Тогда
		Если Не ВыполнитьЗапрос(СтрокаЗапроса, Соединение, "Не удалось выгрузить котировки в б/д Repository AP18 (риск-менеджмент)") Тогда
			ВыполнитьЗапрос("ROLLBACK TRANSACTION Quotes", Соединение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьЗапрос("COMMIT TRANSACTION Quotes", Соединение);
	
	СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8 = РассчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Quotes1C8);
КонецПроцедуры

Процедура ВыгрузитьДанныеВ_Deposits1C8(МВТ, Соединение, КодКомпании, СтатистикаВыполнения)
	Если СтатистикаВыполнения.Свойство("ВыгрузитьДанныеВ_Deposits1C8") Тогда
		СтатистикаВыполнения.ВыгрузитьДанныеВ_Deposits1C8 = СтатистикаВыполнения.ВыгрузитьДанныеВ_Deposits1C8 + ", " + ТекущаяДатаСеанса();
	Иначе
		СтатистикаВыполнения.Вставить("ВыгрузитьДанныеВ_Deposits1C8", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	ВыборкаЗаписей = МВТ.Таблицы["_ДанныеПоДепозитам"].ПолучитьДанные().Выбрать();
	
	СчетчикОшибок = 0;
	
	Пока ВыборкаЗаписей.Следующий() Цикл
		Если ПустаяСтрока(ВыборкаЗаписей.МатрихКодБанка) Или ПустаяСтрока(ВыборкаЗаписей.ДатаРазмещения) 
			Или ПустаяСтрока(ВыборкаЗаписей.ДатаПогашения) Или ПустаяСтрока(ВыборкаЗаписей.Номинал) Тогда
			ЗарегистрироватьОшибку("Не выгружен депозит " + ВыборкаЗаписей.Договор + ". Не полные данные по депозиту.");
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект.Депозиты И ВыборкаЗаписей.ТипДепозита <> "DepositsREZ" Тогда
			ЗапросSQL = "EXEC dbo.P_Deposits1C8_add
				|@ClientCode               = '"+ ВыборкаЗаписей.КодСчетаДУ +"',
				|@ClientName               = '"+ ВыборкаЗаписей.НаименованиеСчетаДУ +"',
				|@IssuerName               = '"+ ВыборкаЗаписей.НаименованиеБанка +"',
				|@MatrixIssuerID           = '"+ ВыборкаЗаписей.МатрихКодБанка +"',
				|@CompanyID                = " + КодКомпании +",
				|@AgreementNumber          = '"+ СокрЛП(ВыборкаЗаписей.Договор) +"',
				|@AgreementDate            = " + ДатаSQL(ВыборкаЗаписей.ДатаДоговора) +",
				|@AssetType                = '"+ ВыборкаЗаписей.ТипДепозита +"',
				|@CurrencyCode             = '"+ ВыборкаЗаписей.Валюта +"',
				|@StartDate                = " + ДатаSQL(ВыборкаЗаписей.ДатаРазмещения) +",
				|@EndDate                  = " + ДатаSQL(ВыборкаЗаписей.ДатаПогашения) +",
				|@FaceValue                = '"+ ЧислоSQL(ВыборкаЗаписей.Номинал) +"', 
				|@Interest                 = '"+ ЧислоSQL(ВыборкаЗаписей.Ставка) +"',    
				|@holddays                 = '"+ ЧислоSQL(ВыборкаЗаписей.СрокМНО) +"',            
				|@LastDateAccrualPay       = " + ДатаSQL(ВыборкаЗаписей.ДатаВыплаты) +", 
				|@isReinvest               = '"+ ?(ВыборкаЗаписей.ФлагРеинвестирования = Истина,1,0) +"',
				|@DocumentNumber           = '"+ СокрЛП(ВыборкаЗаписей.Депозит.УникальныйИдентификатор()) +"',
				|@CloseDate                = " + ДатаSQL(ВыборкаЗаписей.ДатаФактическогоЗакрытия) +",
				|@InterestPaymentFrequency = '"+ ВыборкаЗаписей.ПериодичностьВыплатыПроцентов +"',
				|@EarlyTerminate           = '"+ ЧислоSQL(ВыборкаЗаписей.ДоВостребования) +"'";
			
			Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение, "Не удалось выгрузить депозит: "+ ВыборкаЗаписей.Договор +" в Deposits1C8!") Тогда
				СчетчикОшибок = СчетчикОшибок + 1;
			КонецЕсли;
			
			Если СчетчикОшибок = 3 Тогда
				ЗарегистрироватьОшибку("Выгрузка данных в Deposits1C8 была прервана из-за ошибки выполнения запросов. Возможно возникли неполадки с соединением.");
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СтатистикаВыполнения.ВыгрузитьДанныеВ_Deposits1C8 = РассчитатьВремя(СтатистикаВыполнения.ВыгрузитьДанныеВ_Deposits1C8);
КонецПроцедуры

Процедура ПроверитьНаличиеЦенОценки(МВТ, КодКомпании, ТекстОтчета, ДатаОтчета, СтатистикаВыполнения)
		
	Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ДатаОтчета) Тогда
		Возврат;	
	КонецЕсли;
	
	Если СтатистикаВыполнения.Свойство("Процедура_ПроверитьНаличиеЦенОценки") Тогда
		СтатистикаВыполнения.Процедура_ПроверитьНаличиеЦенОценки = СтатистикаВыполнения.Процедура_ПроверитьНаличиеЦенОценки + ", " + ТекущаяДатаСеанса(); 
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ПроверитьНаличиеЦенОценки", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
		
	ТабличнаяЧастьФайла = "";
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиБЭК.КодСчетаДУ КАК КодСчетаДУ,
		|	_ОстаткиБЭК.СчетДУ КАК СчетДУ,
		|	_ОстаткиБЭК.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КодыМатрихЦБ.Код КАК МатрихКодЦБ
		|ИЗ
		|	_ОстаткиБЭК КАК _ОстаткиБЭК
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныАктивов КАК _ЦеныАктивов
		|		ПО _ОстаткиБЭК.СчетДУ = _ЦеныАктивов.СчетДоверительногоУправления
		|			И _ОстаткиБЭК.ЦеннаяБумага = _ЦеныАктивов.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрихЦБ КАК _КодыМатрихЦБ
		|		ПО _ОстаткиБЭК.ЦеннаяБумага = _КодыМатрихЦБ.Объект
		|ГДЕ
		|	_ЦеныАктивов.ЦенаПереоценки ЕСТЬ NULL
		|ИТОГИ ПО
		|	СчетДУ,
		|	КодСчетаДУ";
	
	ВыборкаГруппировкаПоСчетуДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СчетДУ");
		
	Пока ВыборкаГруппировкаПоСчетуДУ.Следующий() Цикл
		
		Если БухгалтерскийУчет.ОпределитьНастройкуУчета(ДатаОтчета, Организация, ВыборкаГруппировкаПоСчетуДУ.СчетДУ, "ПриостановленРасчетСЧА") Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаГруппировкаПоКоду = ВыборкаГруппировкаПоСчетуДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КодСчетаДУ");
	
		Пока ВыборкаГруппировкаПоКоду.Следующий() Цикл
				
			ВыборкаЗаписей = ВыборкаГруппировкаПоКоду.Выбрать();
			
			ТабличнаяЧастьФайла = ТабличнаяЧастьФайла +
			"<tr><td rowspan=""" + ВыборкаЗаписей.Количество() + """>" + СокрЛП(ВыборкаГруппировкаПоКоду.СчетДУ) + " (" + СокрЛП(ВыборкаГруппировкаПоКоду.КодСчетаДУ) + ")</td>";
			
			Инд = 0;
			Пока ВыборкаЗаписей.Следующий() Цикл
				
				ТабличнаяЧастьФайла = ТабличнаяЧастьФайла + ?(Инд = 0, "", "<tr>") + "<td>" + ВыборкаЗаписей.ЦеннаяБумага + "</td><td>" + ВыборкаЗаписей.МатрихКодЦБ + "</td></tr>";	
				Инд = Инд + 1;
				
			КонецЦикла;
			
		    ТабличнаяЧастьФайла = ТабличнаяЧастьФайла;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Если ТабличнаяЧастьФайла <> "" Тогда
		
		ТекстОтчета = ТекстОтчета + ?(ТекстОтчета = "", "", "<br>") + "<p>Дата " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy")  + "</p>
					|<table cols=""3"">
					|<tr class=""mc""><td colspan=""3"">УК " + Организация.Наименование + " (CompanyID: " + КодКомпании + ")</td></tr>
					|<tr class=""mc""><td>Клиент (ClientCode)</td><td>Ценная бумага</td><td>AssetID</td></tr>" + ТабличнаяЧастьФайла + "</table>";
		
	КонецЕсли;
	
	СтатистикаВыполнения.Процедура_ПроверитьНаличиеЦенОценки = РассчитатьВремя(СтатистикаВыполнения.Процедура_ПроверитьНаличиеЦенОценки);
				
КонецПроцедуры

Функция ПолучитьДопПараметры(СверкаДанных = Ложь)
	
	ДопПараметрыСтатистики = Новый Структура;
	
	Если ЭтотОбъект.Активы И Не СверкаДанных Тогда
		ДопПараметрыСтатистики.Вставить("Выгрузка_в_Assets1C8", Истина);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
		ДопПараметрыСтатистики.Вставить("СчетДоверительногоУправления", Строка(ЭтотОбъект.СчетДоверительногоУправления) + ?(СверкаДанных, "", " (Assets1C8)"));	
	КонецЕсли;
	
	Если ЭтотОбъект.СделкиРепо Тогда
		ДопПараметрыСтатистики.Вставить("Выгрузка_в_Repo1C8", Истина);
	КонецЕсли;
	
	Если ЭтотОбъект.Депозиты Тогда
		ДопПараметрыСтатистики.Вставить("Выгрузка_в_Deposits1C8", Истина);
	КонецЕсли;
	
	Если ЭтотОбъект.СправочникСчетов Тогда
		ДопПараметрыСтатистики.Вставить("Выгрузка_в_Clients1C8", Истина);
	КонецЕсли;
	
	Если ЭтотОбъект.Котировки Тогда
		ДопПараметрыСтатистики.Вставить("Выгрузка_в_Quotes1C8", Истина);
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
			ДопПараметрыСтатистики.Вставить("ЦеннаяБумага", Строка(ЭтотОбъект.ЦеннаяБумага) + " (Quotes1C8)");	
		КонецЕсли;
	КонецЕсли;
											 
	Для Каждого ДопСвойство Из ДополнительныеСвойства Цикл
												 
		Если Не (ДопСвойство.Ключ = "Источник" Или ДопСвойство.Ключ = "ЭкспортДанныхРПИ" Или ДопСвойство.Ключ = "Ошибки") Тогда
			ДопПараметрыСтатистики.Вставить(ДопСвойство.Ключ, ДопСвойство.Значение);	
		КонецЕсли; 
		 
	КонецЦикла;
	
	Возврат ДопПараметрыСтатистики;
	
КонецФункции

Функция Выгрузить() Экспорт
	КодКомпании = "";
	ТекстОтчета = "";
	СтатистикаВыполнения = Новый Структура();
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		ДополнительныеСвойства.Вставить("ЭкспортДанныхРПИ", Истина);
	КонецЕсли;
	
	// Открываем сессию
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
		ЭтотОбъект, "Организация,Период", ПолучитьДопПараметры());
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Выгрузить()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	// 10.08.2018 закрыт филиал Траст, портфели переехали на головную организацию.
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") И (Период.ДатаНачала < Дата("10.08.2018 00:00:00"))
		И (Период.ДатаОкончания > Дата("10.08.2018 23:59:59")) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("10.08.2018 закрыт Московский филиал Траст." + Символы.ПС
			+ "До 10.08 данные выгружаются с кодом филиала, после 10.08 данные выгружаются с кодом головной организации Траст.
				 |Необходимо указать период либо для Филиала, либо для головной организации.");
		Возврат Неопределено;
	КонецЕсли;
		
	ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Организация.ЮрФизЛицо, Период.ДатаНачала);
	
	Если Не ЗначениеЗаполнено(ГоловнаяОрганизация) Или НачалоДня(Период.ДатаНачала) < Дата(2018, 8, 10) Тогда
		ЮрЛицо = Организация.ЮрФизЛицо;
	Иначе
		ЮрЛицо = ГоловнаяОрганизация;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				И Объект = &ЮрЛицо) КАК КодыВоВнешнихСистемахСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ЮрЛицо", ЮрЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодКомпании = СокрЛП(Выборка.Код);	
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(КодКомпании) Тогда
		ЗарегистрироватьОшибку("У юр.лица организации: " + Организация.ЮрФизЛицо.Наименование + " отсутствует код МАТРИХ!");
		ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения);
		Возврат Неопределено;
	КонецЕсли;
	
	Соединение = НастроитьСоединение();
	
	Если Соединение = Неопределено Тогда
		ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтотОбъект.СправочникСчетов Тогда
		ВыгрузитьДанныеВ_Clients1C8(Соединение, СтатистикаВыполнения);
	КонецЕсли;
	
	Если ЭтотОбъект.СделкиРепо Тогда
		ВыгрузитьДанныеВ_Repo1C8(Соединение, КодКомпании, СтатистикаВыполнения);
	КонецЕсли;
	
	Если ЭтотОбъект.Котировки И Не ДополнительныеСвойства.Свойство("ЭкспортДанныхРПИ") Тогда
		ВыгрузитьДанныеВ_Quotes1C8(Соединение, СтатистикаВыполнения);
	КонецЕсли;
	
	// Выгрузка данных в Assets
	ФильтрПоСчетуДУ = ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления);
	
	Если ЭтотОбъект.Активы Тогда
		ТаблицаДанныхДляВыгрузки = ПолучитьТаблицуДляДанных();
		ДатаФормированияОстатков = Период.ДатаНачала;
		
		Пока ДатаФормированияОстатков <= Период.ДатаОкончания Цикл
			МВТ = Новый МенеджерВременныхТаблиц;
			ОшибкаФормированияДанных = Ложь;
			
			ПолучитьСчетаДУ(ДатаФормированияОстатков, МВТ, ОшибкаФормированияДанных, ФильтрПоСчетуДУ);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			ПолучитьДанныеСтоимостиАктивов(ДатаФормированияОстатков, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			ПолучитьДанныеПоДепозитам(ДатаФормированияОстатков, ТаблицаДанныхДляВыгрузки, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			// Получаем остатки по денежным средствам, ЦБ, депозитам и МНО, дебиторской/кредиторской задолженности
			ПолучитьОстаткиАктивов(ДатаФормированияОстатков, ТаблицаДанныхДляВыгрузки, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			Если ДополнительныеСвойства.Свойство("ПроверитьНаличиеЦенОценки") Тогда
				ПроверитьНаличиеЦенОценки(МВТ, КодКомпании, ТекстОтчета, ДатаФормированияОстатков, СтатистикаВыполнения);
			КонецЕсли;
			
			ВыгрузитьДанныеВ_Assets1C8(?(ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления), ЭтотОбъект.СчетДоверительногоУправления.КодСчета, ""),
				ДатаФормированияОстатков, КодКомпании, ТаблицаДанныхДляВыгрузки, Соединение, СтатистикаВыполнения);
			
			// Если не установлен фильтр по счету ДУ - сразу выгружаем данные в Deposits - чтобы повторно не формировать данные
			//	Фильтр по счету ДУ используется только для выгрузки в Assets1C8
			Если ЭтотОбъект.Депозиты И Не ФильтрПоСчетуДУ Тогда
				ВыгрузитьДанныеВ_Deposits1C8(МВТ, Соединение, КодКомпании, СтатистикаВыполнения);
			КонецЕсли;
			
			ТаблицаДанныхДляВыгрузки.Очистить();
			ДатаФормированияОстатков = ДатаФормированияОстатков + 86400;
		КонецЦикла;
		
		Если ДополнительныеСвойства.Свойство("ПроверитьНаличиеЦенОценки") И ТекстОтчета <> "" Тогда
			ТекстОтчета = 
				"<html>
				|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
				|	<style>
				|		body  { font: 10pt sans-serif; }
				|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
				|		td    { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
				|		.client_shares { font-weight: bolder; font-size: 12px; background: #F4ECC5; }
				|		.mc   { font-size: 14px; background: #F4ECC5; }
				|	</style>
				|</head>
				|<body>" + ТекстОтчета + "</body></html>";
			
			Если ДополнительныеСвойства.Свойство("ОтправитьОтчетОбОтсутствииЦен") Тогда
				ОтправитьОтчет("Выгрузка данных в Assets1C8. Отчет о бумагах без цен переоценки ("
					+ Организация.Наименование + "). Дата " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"), ТекстОтчета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.Депозиты И (ЭтотОбъект.Активы И ФильтрПоСчетуДУ ИЛИ Не ЭтотОбъект.Активы) Тогда
		ДатаФормированияОстатков = Период.ДатаНачала;
		Пока ДатаФормированияОстатков <= Период.ДатаОкончания Цикл
			МВТ = Новый МенеджерВременныхТаблиц;
			ОшибкаФормированияДанных = Ложь;
			
			ПолучитьСчетаДУ(ДатаФормированияОстатков, МВТ, ОшибкаФормированияДанных);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			ПолучитьДанныеСтоимостиАктивов(ДатаФормированияОстатков, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			ПолучитьДанныеПоДепозитам(ДатаФормированияОстатков, ТаблицаДанныхДляВыгрузки, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения);
			Если ОшибкаФормированияДанных Тогда
				Прервать;
			КонецЕсли;
			
			ВыгрузитьДанныеВ_Deposits1C8(МВТ, Соединение, КодКомпании, СтатистикаВыполнения);
			ДатаФормированияОстатков = ДатаФормированияОстатков + 86400;
		КонецЦикла;
	КонецЕсли;
	
	НастроитьСоединение(Соединение); // Закрываем соединение
	ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения);
	Возврат ТекстОтчета;
КонецФункции

Процедура ПолучитьСчетаДУ(Дата, МВТ, ОшибкаФормированияДанных, ФильтрПоСчетуДУ = Ложь)
			
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаИсключеныИзЗагрузки
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Организация = &Организация
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И СчетаДоверительногоУправления.ДатаРасторжения < &КонецДня
		|			ТОГДА СчетаДоверительногоУправления.ДатаРасторжения
		|		ИНАЧЕ &КонецДня
		|	КОНЕЦ КАК ДатаСрезаДанных,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.Наименование КАК Наименование
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаИсключеныИзЗагрузки.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &КонецДня
		|	И НЕ СчетаДоверительногоУправления.Ссылка В (&Неопределен_Траст, &Неопределен_РЭМ)
		|	И _СчетаИсключеныИзЗагрузки.Ссылка ЕСТЬ NULL
		|	И &ОтборПоСчету";	
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Дата));
	Запрос.УстановитьПараметр("Неопределен_Траст", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_Траст"));
	Запрос.УстановитьПараметр("Неопределен_РЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_РЭМ"));
	Запрос.УстановитьПараметр("Ключ", "УчетНеВедется");
	
	Если ФильтрПосчетуДУ Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчету", "СчетаДоверительногоУправления.Ссылка = &СчетУчета");
		Запрос.УстановитьПараметр("СчетУчета", ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСчету", "Истина");	
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПолучитьДанныеСтоимостиАктивов(ДатаФормированияОстатков, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения)
	
	Если МВТ.Таблицы.Найти("_СчетаДоверительногоУправления") = Неопределено Тогда
		
		ЗарегистрироватьОшибку("Не удалось получить данные стоимости активов. Отсутствует таблица [_СчетаДоверительногоУправления]");
		ОшибкаФормированияДанных = Истина;
		Возврат;
		
	КонецЕсли;
	
	Если СтатистикаВыполнения.Свойство("Процедура_ПолучитьДанныеСтоимостиАктивов") Тогда
		СтатистикаВыполнения.Процедура_ПолучитьДанныеСтоимостиАктивов = СтатистикаВыполнения.Процедура_ПолучитьДанныеСтоимостиАктивов + ", " + ТекущаяДатаСеанса();
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ПолучитьДанныеСтоимостиАктивов", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.*
		|ПОМЕСТИТЬ _РегистрСведенийСтоимостьПереоценки
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО СтоимостьПереоценки.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|			И (СтоимостьПереоценки.Организация = &Организация)
		|			И (СтоимостьПереоценки.ЦельРасчета В (&ЦелиРасчетов))
		|			И (СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки))
		|			И (СтоимостьПереоценки.Период = &НачалоДня)
		|			И (СтоимостьПереоценки.Активность)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтоимостьПереоценки.СчетДоверительногоУправления,
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.Партия,
		|	СтоимостьПереоценки.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.*
		|ПОМЕСТИТЬ _РегистрСведенийСтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &НачалоДня)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаФормированияОстатков)); 
		
	ЦелиРасчетов = Новый Массив;
	ЦелиРасчетов.Добавить(Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
	Если ДатаФормированияОстатков > Дата(2022, 9, 27) Тогда 
		ЦелиРасчетов.Добавить(Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации);
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ЦелиРасчетов", ЦелиРасчетов);

	Запрос.Выполнить();
	
	СтатистикаВыполнения.Процедура_ПолучитьДанныеСтоимостиАктивов = РассчитатьВремя(СтатистикаВыполнения.Процедура_ПолучитьДанныеСтоимостиАктивов);
	
КонецПроцедуры

Процедура ПолучитьОстаткиАктивов(ДатаФормированияОстатков, ТаблицаДанных, МВТ, ОшибкаФормированияДанных, СтатистикаВыполнения = Неопределено) Экспорт
	Если СтатистикаВыполнения <> Неопределено Тогда
		Если СтатистикаВыполнения.Свойство("Процедура_ПолучитьОстаткиАктивов") Тогда
			СтатистикаВыполнения.Процедура_ПолучитьОстаткиАктивов = СтатистикаВыполнения.Процедура_ПолучитьОстаткиАктивов + ", " + ТекущаяДатаСеанса();
		Иначе
			СтатистикаВыполнения.Вставить("Процедура_ПолучитьОстаткиАктивов", "Время выполнения: " + ТекущаяДатаСеанса());
		КонецЕсли;
	КонецЕсли;
	
	ДатаКонецДня = КонецДня(ДатаФормированияОстатков);
	
	// Остатки денежных средств
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ,
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.Наименование КАК НаименованиеСчетаДУ,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваМНООстатки.СуммаОстаток ЕСТЬ NULL
		|			ТОГДА ОстаткиДенежныхСредствОстатки.СуммаОстаток
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.СуммаОстаток - ДенежныеСредстваМНООстатки.СуммаОстаток
		|	КОНЕЦ КАК Сумма,
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Банк.ЮрФизЛицо КАК Банк,
		|	ОстаткиДенежныхСредствОстатки.Брокер.ЮрФизЛицо КАК Брокер
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&ДатаКонецДня, Организация = &Организация) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваМНО.Остатки(&ДатаКонецДня, Организация = &Организация) КАК ДенежныеСредстваМНООстатки
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = ДенежныеСредстваМНООстатки.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.РасчетныйСчет = ДенежныеСредстваМНООстатки.РасчетныйСчет
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДенежныеСредстваПереданныеВОплатуПаевОстатки.СчетДоверительногоУправления.КодСчета,
		|	ДенежныеСредстваПереданныеВОплатуПаевОстатки.СчетДоверительногоУправления.Наименование,
		|	ДенежныеСредстваПереданныеВОплатуПаевОстатки.СуммаОстаток,
		|	ДенежныеСредстваПереданныеВОплатуПаевОстатки.РасчетныйСчет.Валюта,
		|	ДенежныеСредстваПереданныеВОплатуПаевОстатки.РасчетныйСчет.Банк.ЮрФизЛицо,
		|	NULL
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваПереданныеВОплатуПаев.Остатки(&ДатаКонецДня, Организация = &Организация) КАК ДенежныеСредстваПереданныеВОплатуПаевОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ДенежныеСредстваПереданныеВОплатуПаевОстатки.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК ЮрЛицо,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _МатрихКодыЮрЛиц
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&ДатаКонецДня,
		|			ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				И ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Остатки.КодСчетаДУ КАК КодСчетаДУ,
		|	_Остатки.НаименованиеСчетаДУ КАК НаименованиеСчетаДУ,
		|	_Остатки.Сумма КАК Сумма,
		|	_Остатки.Валюта КАК Валюта,
		|	_Остатки.Валюта.Наименование КАК ВалютаНаименование,
		|	ВЫБОР
		|		КОГДА НЕ _МатрихКодыБК.Код ЕСТЬ NULL
		|			ТОГДА ""Money_B""
		|		КОГДА НЕ _МатрихКодыБанков.Код ЕСТЬ NULL
		|			ТОГДА ""Money_R""
		|		ИНАЧЕ ""Money_T""
		|	КОНЕЦ КАК ТипМестаХранения,
		|	ЕСТЬNULL(_МатрихКодыБанков.Код, _МатрихКодыБК.Код) КАК КодБанка,
		|	КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК Курс
		|ИЗ
		|	_Остатки КАК _Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МатрихКодыЮрЛиц КАК _МатрихКодыБанков
		|		ПО _Остатки.Банк = _МатрихКодыБанков.ЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МатрихКодыЮрЛиц КАК _МатрихКодыБК
		|		ПО _Остатки.Брокер = _МатрихКодыБК.ЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаКонецДня, Период = НАЧАЛОПЕРИОДА(&ДатаКонецДня, ДЕНЬ)) КАК КурсыВалютСрезПоследних
		|		ПО _Остатки.Валюта = КурсыВалютСрезПоследних.Валюта";
	#КонецОбласти
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаКонецДня", ДатаКонецДня);
	
	ВыборкаЗаписей = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗаписей.Следующий() Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.AssetDate               = ДатаКонецДня;
		НоваяСтрока.ClientCode              = ВыборкаЗаписей.КодСчетаДУ;
		НоваяСтрока.ClientName              = ВыборкаЗаписей.НаименованиеСчетаДУ;
		НоваяСтрока.AssetType               = ВыборкаЗаписей.ТипМестаХранения;
		НоваяСтрока.CurrencyCode            = ?(ЗначениеЗаполнено(ВыборкаЗаписей.ВалютаНаименование), ВыборкаЗаписей.ВалютаНаименование, "");
		НоваяСтрока.EvaluationPriceCurrency = ВыборкаЗаписей.Сумма;
		НоваяСтрока.IssuerID                = ВыборкаЗаписей.КодБанка;
		НоваяСтрока.CurrRate                = ВыборкаЗаписей.Курс;
	КонецЦикла;
	
	// Остатки дебиторской/кредиторской задолженности
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент КАК Контрагент,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|				И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание
		|		ИНАЧЕ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
		|	КОНЕЦ КАК Основание,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|				И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Валюта
		|		ИНАЧЕ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))
		|				И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаНачальныйОстаток + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаПриход
		|		ИНАЧЕ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынок
		|	КОНЕЦ КАК СуммаРынок
		|ПОМЕСТИТЬ _СтоимостьАктивов
		|ИЗ
		|	_РегистрСведенийСтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
		|				&НачалоДня,
		|				&КонецДня,
		|				Период,
