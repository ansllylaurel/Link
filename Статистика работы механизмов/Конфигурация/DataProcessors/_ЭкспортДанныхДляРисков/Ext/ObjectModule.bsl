Процедура ВыгрузитьДанныеВ_Assets1C8(КодСчетаДУ = "", ДатаФормированияОстатков, КодКомпании, ДанныеДляВыгрузки, Соединение, СтатистикаВыполнения)
	Если СтатистикаВыполнения.Свойство("Процедура_ВыгрузитьДанныеВ_Assets1C8") Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Assets1C8 = СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Assets1C8 + ", " + ТекущаяДатаСеанса();
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ВыгрузитьДанныеВ_Assets1C8", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	//В РПИ не выгружаем это значение
	НетКолонкиДляДатыПартий = ДополнительныеСвойства.Свойство("ЭкспортДанныхРПИ");
	ТекДата = ТекущаяДатаСеанса();
	ИмяТранзакции = "Export_" + ?(КодСчетаДУ = "", КодКомпании, КодСчетаДУ) + "_" + Час(ТекДата) + "_" + Минута(ТекДата) + "_" + Секунда(ТекДата);
	ПрефиксЖурналаРегистрации = ПрефиксЖурналаРегистрации();
	
	ЗапросОчисткиSQL =
		"BEGIN TRANSACTION " + ИмяТранзакции + "
		|
		|EXEC dbo.P_Assets1C8_del
		|	@CompanyID  = " + КодКомпании + ",
		|	@AssetDate  = " + ДатаSQL(ДатаФормированияОстатков) + "";
	
	Если ЗначениеЗаполнено(КодСчетаДУ) Тогда
		ЗапросОчисткиSQL = ЗапросОчисткиSQL + ", @ClientCode = '" + КодСчетаДУ + "'";
	КонецЕсли;
	
	// Отладка очистки Assets1C8 (начало)
	УниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекущаяДата = ТекущаяДата();
	УниверсальнаяДата = Цел(УниверсальнаяДатаВМиллисекундах / 1000);
	РазницаДатВСекундах = ТекущаяДата - (Дата(1, 1, 1) + УниверсальнаяДата);
	Миллисекунды = УниверсальнаяДатаВМиллисекундах - УниверсальнаяДата * 1000;
	ТекущаяДатаВМиллисекундах = Цел((УниверсальнаяДатаВМиллисекундах / 1000. + РазницаДатВСекундах) * 1000);
	ТекущаяДатаСМиллисекундамиСтрокой = "" + Формат(Дата(1, 1, 1) + Цел(ТекущаяДатаВМиллисекундах / 1000.), "ДФ='yyyy-MM-dd hh:mm:ss'")
		+ "." + Формат(Миллисекунды, "ЧЦ=3; ЧВН=");
	КомментарийЗаписи = "Начало в (" + ТекущаяДатаСМиллисекундамиСтрокой + "):" + Символы.ПС + ЗапросОчисткиSQL;
	ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Очистка Assets1C8", УровеньЖурналаРегистрации.Предупреждение,,, КомментарийЗаписи);
	//Сообщить(КомментарийЗаписи);
	
	Попытка
		Command = Новый COMОбъект("ADODB.Command");
		Command.CommandTimeout   = 600; // 10 минут
		Command.CommandText      = ЗапросОчисткиSQL;
		Command.CommandType      = 1;
		Command.ActiveConnection = Соединение;
		Command.Execute();
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Очистка Assets1C8", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		ЗарегистрироватьОшибку("Перед выгрузкой не удалось очистить таблицу "
			+ "Assets1C8 на дату [" + ДатаФормированияОстатков + "]. Данные не будут перевыгружены." + ОписаниеОшибки);
		Возврат;
	КонецПопытки;
	
	// Отладка очистки Assets1C8 (завершение)
	УниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекущаяДата = ТекущаяДата();
	УниверсальнаяДата = Цел(УниверсальнаяДатаВМиллисекундах / 1000);
	РазницаДатВСекундах = ТекущаяДата - (Дата(1, 1, 1) + УниверсальнаяДата);
	Миллисекунды = УниверсальнаяДатаВМиллисекундах - УниверсальнаяДата * 1000;
	ТекущаяДатаВМиллисекундах = Цел((УниверсальнаяДатаВМиллисекундах / 1000. + РазницаДатВСекундах) * 1000);
	ТекущаяДатаСМиллисекундамиСтрокой = "" + Формат(Дата(1, 1, 1) + Цел(ТекущаяДатаВМиллисекундах / 1000.), "ДФ='yyyy-MM-dd hh:mm:ss'")
		+ "." + Формат(Миллисекунды, "ЧЦ=3; ЧВН=");
	КомментарийЗаписи = "Завершение в (" + ТекущаяДатаСМиллисекундамиСтрокой + "):" + Символы.ПС + ЗапросОчисткиSQL;
	ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Очистка Assets1C8", УровеньЖурналаРегистрации.Предупреждение,,, КомментарийЗаписи);
	//Сообщить(КомментарийЗаписи);
	
	Для Каждого Стр из ДанныеДляВыгрузки Цикл
		ЗапросSQL =
		#Область ТекстЗапроса
			"INSERT dbo.Assets1C8(
			|	ClientCode, AssetDate, ClientName, AssetType, AssetID, Class, Quantity, EvaluationDate,
			|	YTM, DTM, AccintEPS, AccintBack, IssuerID, RegistrationCode, FaceValue, Overvalue,
			|	CompanyID, REPOQuantity, CurrencyCode, EvaluationPriceCurrency, EvaluationPriceCurrencyEPS, CurrRate, DocumentNumber
			|	<Column-PurchaseDate>
			|)
			|VALUES (
			|	<ClientCode>, <AssetDate>, <ClientName>, <AssetType>, <AssetID>, <Class>, <Quantity>, <EvaluationDate>,
			|	<YTM>, <DTM>, <AccintEPS>, <AccintBack>, <IssuerID>, <RegistrationCode>, <FaceValue>, <Overvalue>,
			|	<CompanyID>, <REPOQuantity>, <CurrencyCode>, <EvaluationPriceCurrency>, <EvaluationPriceCurrencyEPS>, <CurrRate>, <DocumentNumber>
			|	<Value-PurchaseDate>
			|)";
		#КонецОбласти
		// Подстановка значений колонок
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<ClientCode>", СтрокаSQL(Стр.ClientCode));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<AssetDate>", ДатаSQL(Стр.AssetDate));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<ClientName>", СтрокаSQL(Стр.ClientName));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<AssetType>", СтрокаSQL(Стр.AssetType));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<AssetID>", СтрокаSQL(Стр.AssetID));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<Class>", ЧислоSQL(Стр.Class));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<Quantity>", ЧислоSQL(Стр.Quantity));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<EvaluationDate>", ДатаSQL(Стр.EvaluationDate));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<YTM>", ЧислоSQL(Стр.YTM));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<DTM>", ЧислоSQL(Стр.DTM));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<AccintEPS>", ЧислоSQL(Стр.AccintEPS));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<AccintBack>", ЧислоSQL(Стр.AccintBack));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<IssuerID>", СтрокаSQL(Стр.IssuerID));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<RegistrationCode>", СтрокаSQL(Стр.RegistrationCode));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<FaceValue>", ЧислоSQL(Стр.FaceValue));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<Overvalue>", ЧислоSQL(Стр.Overvalue));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<CompanyID>", СтрокаSQL(КодКомпании));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<REPOQuantity>", ЧислоSQL(Стр.REPOQuantity));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<CurrencyCode>", СтрокаSQL(Стр.CurrencyCode));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<EvaluationPriceCurrency>", ЧислоSQL(Стр.EvaluationPriceCurrency));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<EvaluationPriceCurrencyEPS>", ЧислоSQL(Стр.EvaluationPriceCurrencyEPS));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<CurrRate>", ЧислоSQL(Стр.CurrRate));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<DocumentNumber>", СтрокаSQL(Стр.DocumentNumber));
		// Подстановка необязательных колонок и их значений
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<Column-PurchaseDate>", ?(НетКолонкиДляДатыПартий, "", ", " + "PurchaseDate"));
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "<Value-PurchaseDate>", ?(НетКолонкиДляДатыПартий, "", ", " + ДатаSQL(Стр.PurchaseDate)));
		
		Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение, "Не удалось выгрузить данные актива: " + Стр.AssetType
			+ "(" + Стр.AssetID + ") у клиента: " + Стр.ClientName + " в Assets1C8 ")
		Тогда
			ВыполнитьЗапрос("ROLLBACK TRANSACTION " + ИмяТранзакции, Соединение);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// Фиксация очистки и испорта Assets1C8 перед обновлением прочих колонок
	ВыполнитьЗапрос("COMMIT TRANSACTION " + ИмяТранзакции, Соединение);
	
	// Из 1С выгружаются не все данные. Для загрузки недостающих данных необходимо запустить процедуру "P_Assets1C8_upd".
	//	Есть точка сохранения (COMMIT + BEGIN) для того, чтобы выгруженные данные не пропали из-за их неуспешной последующей обработки.
	ЗапросОбновления =
		"BEGIN TRANSACTION " + ИмяТранзакции + "
		|
		|EXEC dbo.P_Assets1C8_upd
		|	@CompanyID = " + КодКомпании + ",
		|	@AssetDate = " + ДатаSQL(ДатаФормированияОстатков);
	
	Если ЗначениеЗаполнено(КодСчетаДУ) Тогда
		ЗапросОбновления = ЗапросОбновления + ", @ClientCode = '" + КодСчетаДУ + "'";
	КонецЕсли;
	
	НомерПопытки = 0;
	МаксимумПопыток = 3;
	Пока НомерПопытки < МаксимумПопыток Цикл
		НомерПопытки = НомерПопытки + 1;
		Попытка
			// Отладка обновления Assets1C8 (начало)
			УниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ТекущаяДата = ТекущаяДата();
			УниверсальнаяДата = Цел(УниверсальнаяДатаВМиллисекундах / 1000);
			РазницаДатВСекундах = ТекущаяДата - (Дата(1, 1, 1) + УниверсальнаяДата);
			Миллисекунды = УниверсальнаяДатаВМиллисекундах - УниверсальнаяДата * 1000;
			ТекущаяДатаВМиллисекундах = Цел((УниверсальнаяДатаВМиллисекундах / 1000. + РазницаДатВСекундах) * 1000);
			ТекущаяДатаСМиллисекундамиСтрокой = "" + Формат(Дата(1, 1, 1) + Цел(ТекущаяДатаВМиллисекундах / 1000.), "ДФ='yyyy-MM-dd hh:mm:ss'")
				+ "." + Формат(Миллисекунды, "ЧЦ=3; ЧВН=");
			КомментарийЗаписи = "Начало в (" + ТекущаяДатаСМиллисекундамиСтрокой + "), попытка #" + НомерПопытки + ":" + Символы.ПС + ЗапросОбновления;
			ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Обновление Assets1C8", УровеньЖурналаРегистрации.Предупреждение,,, КомментарийЗаписи);
			//Сообщить(КомментарийЗаписи);
			
			Command = Новый COMОбъект("ADODB.Command");
			Command.CommandTimeout   = 600; // 10 минут
			Command.CommandText      = ЗапросОбновления;
			Command.CommandType      = 1;
			Command.ActiveConnection = Соединение;
			Command.Execute();
			Прервать;
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Обновление Assets1C8", УровеньЖурналаРегистрации.Ошибка,,,
				"Попытка #" + НомерПопытки + ". Описание Ошибки: " + ОписаниеОшибки);
			ЗарегистрироватьОшибку("Ошибка возникла при выполнении процедуры dbo.P_Assets1C8_upd " + ОписаниеОшибки);
			ВыполнитьЗапрос("IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION " + ИмяТранзакции, Соединение);
			Если НомерПопытки = МаксимумПопыток Тогда
				Возврат;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
	// Отладка обновления Assets1C8 (завершение)
	УниверсальнаяДатаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТекущаяДата = ТекущаяДата();
	УниверсальнаяДата = Цел(УниверсальнаяДатаВМиллисекундах / 1000);
	РазницаДатВСекундах = ТекущаяДата - (Дата(1, 1, 1) + УниверсальнаяДата);
	Миллисекунды = УниверсальнаяДатаВМиллисекундах - УниверсальнаяДата * 1000;
	ТекущаяДатаВМиллисекундах = Цел((УниверсальнаяДатаВМиллисекундах / 1000. + РазницаДатВСекундах) * 1000);
	ТекущаяДатаСМиллисекундамиСтрокой = "" + Формат(Дата(1, 1, 1) + Цел(ТекущаяДатаВМиллисекундах / 1000.), "ДФ='yyyy-MM-dd hh:mm:ss'")
		+ "." + Формат(Миллисекунды, "ЧЦ=3; ЧВН=");
	КомментарийЗаписи = "Завершение в (" + ТекущаяДатаСМиллисекундамиСтрокой + "), за (" + НомерПопытки + ") попыток:" + Символы.ПС + ЗапросОбновления;
	ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации + "Обновление Assets1C8", УровеньЖурналаРегистрации.Предупреждение,,, КомментарийЗаписи);
	//Сообщить(КомментарийЗаписи);
	
	Если Не ВыполнитьЗапрос("IF @@TRANCOUNT > 0 COMMIT TRANSACTION " + ИмяТранзакции, Соединение, "Не удалось зафиксировать транзакцию выгрузки данных.") Тогда
		Возврат;
	КонецЕсли;
	
	СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Assets1C8 = РассчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Assets1C8);
КонецПроцедуры

Процедура ВыгрузитьДанныеВ_Repo1C8(Соединение, КодКомпании, СтатистикаВыполнения)
	Если СтатистикаВыполнения.Свойство("Процедура_ВыгрузитьДанныеВ_Repo1C8") Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8 = СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8 + ", " + ТекущаяДатаСеанса();
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ВыгрузитьДанныеВ_Repo1C8", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Репо_1,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК clientCode,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Наименование КАК clientName,
		|	КодыМатрихЭмитентовЦБ.Код КАК issuerId,
		|	КодыМатрихЦБ.Код КАК assetId,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Stocks""
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Bonds""
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""Shares""
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|						ТОГДА ""Futures""
		|					КОГДА ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
		|						ТОГДА ""Options""
		|				КОНЕЦ
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ""DR""
		|		КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ""ИСУ""
		|	КОНЕЦ КАК assetType,
		|	ОперацииСЦеннымиБумагами.Количество КАК quantity,
		|	ОперацииСЦеннымиБумагами.Цена КАК marketPrice,
		|	ОперацииСЦеннымиБумагами.ЦенаКупона КАК marketAccint,
		|	ОперацииСЦеннымиБумагами.ДатаОперации КАК dateFirstPart,
		|	ОперацииСЦеннымиБумагами.Сумма + ОперацииСЦеннымиБумагами.СуммаКупона КАК sumFirstPart,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО = ДАТАВРЕМЯ(1, 1, 1)
		|				И УсловияСделокРЕПОСрезПоследних.ДатаОплаты = УсловияСделокРЕПОСрезПоследних.ДатаПоставки
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.ДатаОплаты
		|		ИНАЧЕ УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО
		|	КОНЕЦ КАК dateSecondPart,
		|	УсловияСделокРЕПОСрезПоследних.Сумма + УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК sumSecondPart,
		|	ОперацииСЦеннымиБумагами.Регистратор.СтавкаРЕПО КАК rateRepo,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор.НомерСделки = """"
		|			ТОГДА ВЫБОР
		|					КОГДА ОперацииСЦеннымиБумагами.Регистратор.НомерСделкиСЦентральнымКонтрагентом = """"
		|						ТОГДА ОперацииСЦеннымиБумагами.Регистратор.Номер
		|					ИНАЧЕ ОперацииСЦеннымиБумагами.Регистратор.НомерСделкиСЦентральнымКонтрагентом
		|				КОНЕЦ
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.Регистратор.НомерСделки
		|	КОНЕЦ КАК transactionId_1,
		|	ВЫБОР
		|		КОГДА ДокументСделкаРЕПО_2.НомерСделки = """"
		|			ТОГДА ВЫБОР
		|					КОГДА ДокументСделкаРЕПО_2.НомерСделкиСЦентральнымКонтрагентом = """"
		|						ТОГДА ДокументСделкаРЕПО_2.Номер
		|					ИНАЧЕ ДокументСделкаРЕПО_2.НомерСделкиСЦентральнымКонтрагентом
		|				КОНЕЦ
		|		ИНАЧЕ ДокументСделкаРЕПО_2.НомерСделки
		|	КОНЕЦ КАК transactionId_2,
		|	ОперацииСЦеннымиБумагами.Валюта.Наименование КАК currencyFirstPart,
		|	УсловияСделокРЕПОСрезПоследних.ВалютаОплаты.Наименование КАК currencySecondPart,
		|	ОперацииСЦеннымиБумагами.Регистратор.КодРасчетовНаБирже КАК marketDealCode,
		|	ОперацииСЦеннымиБумагами.Регистратор.Контрагент.Наименование КАК contragent,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ""Прямое""
		|		ИНАЧЕ ""Обратное""
		|	КОНЕЦ КАК operType,
		|	КодыКонтрагентов.Код КАК contragentId,
		|	РежимыБиржевыхТоргов.Код КАК КодРежимаБиржевыхТоргов
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК ДокументСделкаРЕПО_2
		|		ПО ОперацииСЦеннымиБумагами.Регистратор = ДокументСделкаРЕПО_2.ПерваяЧастьРЕПО.Ссылка
		|			И (ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Регистратор КАК Документ.СделкаРЕПО).МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (ДокументСделкаРЕПО_2.ПометкаУдаления = ЛОЖЬ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&НачалоПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыМатрихЭмитентовЦБ
		|		ПО (ВЫБОР
		|				КОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|						ИЛИ ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|						ИЛИ ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|						ИЛИ ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|						ИЛИ ОперацииСЦеннымиБумагами.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ОперацииСЦеннымиБумагами.ЦеннаяБумага.Эмитент.ЮрФизЛицо = КодыМатрихЭмитентовЦБ.Объект
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И (ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Векселя)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Паи)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ДепозитарныеРасписки)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия))) КАК КодыМатрихЦБ
		|		ПО ОперацииСЦеннымиБумагами.ЦеннаяБумага = КодыМатрихЦБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ОперацииСЦеннымиБумагами.Регистратор = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыКонтрагентов
		|		ПО ОперацииСЦеннымиБумагами.Регистратор.Контрагент = КодыКонтрагентов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|		ПО ОперацииСЦеннымиБумагами.Регистратор.РежимБиржевыхТоргов.Ссылка = РежимыБиржевыхТоргов.Ссылка
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 1
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = 2";	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8 = РассчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8);
		Возврат;
	Конецесли;
		
	Если Не ВыполнитьЗапрос("BEGIN TRANSACTION DealsRepo", Соединение) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаУдаления = Период.ДатаНачала;
	
	Пока ДатаУдаления <= Период.ДатаОкончания Цикл
		
		ЗапросУдаления = Символы.ПС + "EXEC dbo.P_Repo1C8_del @CompanyID = '" + КодКомпании + "',@AssetDate = " + ДатаSQL(ДатаУдаления) + "";
		
		Если Не ВыполнитьЗапрос(ЗапросУдаления, Соединение, "Перед выгрузкой не удалось удалить записи в таблице Repo1C8 по CompanyID: " + КодКомпании + "  на дату: " + ДатаУдаления + ". Данные не будут перевыгружены.") Тогда
			ВыполнитьЗапрос("ROLLBACK TRANSACTION DealsRepo", Соединение);
			Возврат;
		КонецЕсли;
		
		ДатаУдаления = ДатаУдаления + 86400;
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		ЗапросSQL = "EXEC dbo.P_Repo1C8_add
		|@AssetDate          = " + ДатаSQL(Выборка.dateFirstPart) +",
		|@ClientCode         = '"+ Выборка.clientCode +"',
		|@ClientName         = '"+ Выборка.clientName +"',
		|@IssuerID           = '"+ Выборка.issuerId +"',
		|@AssetID            = '"+ Выборка.assetId +"',
		|@AssetType          = '"+ Выборка.assetType +"',
		|@OperType           = '"+ Выборка.operType +"',
		|@Quantity           = '"+ ЧислоSQL(Выборка.quantity) +"',
		|@MarketPrice        = '"+ ЧислоSQL(Выборка.marketPrice) +"',
		|@MarketAccint       = '"+ ЧислоSQL(Выборка.marketAccint) +"',
		|@DateFirstPart      = " + ДатаSQL(Выборка.dateFirstPart) +",
		|@TimeFirstPart      = " + ДатаSQL(Выборка.dateFirstPart, 1) +",
		|@SumFirstPart       = '"+ ЧислоSQL(Выборка.sumFirstPart) +"',
		|@DateSecondPart     = " + ДатаSQL(Выборка.dateSecondPart) +",
		|@SumSecondPart      = '"+ ЧислоSQL(Выборка.sumSecondPart) +"',
		|@RateREPO           = '"+ ЧислоSQL(Выборка.rateRepo) +"',
		|@Contragent         = '"+ Выборка.contragent +"',
		|@ContragentID       = '"+ Выборка.contragentId +"',
		|@CompanyID          = '"+ КодКомпании +"',
		|@CurrencyFirstPart  = '"+ Выборка.currencyFirstPart +"',
		|@CurrencySecondPart = '"+ Выборка.currencySecondPart +"',
		|@TransactionID1     = '"+ Выборка.transactionId_1 +"',
		|@TransactionID2     = '"+ Выборка.transactionId_2 +"',
		|@MarketDealCode     = '"+ Выборка.marketDealCode +"',
		|@BoardCode			 = '"+ Выборка.КодРежимаБиржевыхТоргов +"'";
		
		Сообщить("" + Выборка.ClientCode + ", " + Выборка.AssetID + ", " + Выборка.OperType);
		
		Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение, "Не удалось выгрузить данные по сделке Репо № "+ Выборка.transactionId_1 +"!") Тогда
			ВыполнитьЗапрос("ROLLBACK TRANSACTION DealsRepo", Соединение);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыполнитьЗапрос("COMMIT TRANSACTION DealsRepo", Соединение);
	
	СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8 = РассчитатьВремя(СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Repo1C8);
	
КонецПроцедуры

Процедура ВыгрузитьДанныеВ_Clients1C8(Соединение, СтатистикаВыполнения)
	Если СтатистикаВыполнения.Свойство("Процедура_ВыгрузитьДанныеВ_Clients1C8") Тогда
		СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Clients1C8 = СтатистикаВыполнения.Процедура_ВыгрузитьДанныеВ_Clients1C8 + ", " + ТекущаяДатаСеанса(); 
	Иначе
		СтатистикаВыполнения.Вставить("Процедура_ВыгрузитьДанныеВ_Clients1C8", "Время выполнения: " + ТекущаяДатаСеанса());
	КонецЕсли;
	
	ОшибкаФормированияДанных = Ложь;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ПолучитьСчетаДУ(Период.ДатаОкончания, МВТ, ОшибкаФормированияДанных);
	
	Если ОшибкаФормированияДанных Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.ДатаСрезаДанных КАК ДатаСрезаДанных,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправления.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
		|			ТОГДА ВЫРАЗИТЬ(КлиентыДоверительногоУправления.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).НомерПравил
		|		ИНАЧЕ КлиентыДоверительногоУправления.СчетДоверительногоУправления.НомерДоговора
		|	КОНЕЦ КАК НомерДоговора
		|ПОМЕСТИТЬ _КлиентыДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|		_СчетаДоверительногоУправления.Организация КАК Организация,
		|		МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК Период,
		|		_СчетаДоверительногоУправления.ДатаСрезаДанных КАК ДатаСрезаДанных
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|			ПО _СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|				И _СчетаДоверительногоУправления.ДатаСрезаДанных >= КлиентыДоверительногоУправления.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.Ссылка,
		|		_СчетаДоверительногоУправления.Организация,
		|		_СчетаДоверительногоУправления.ДатаСрезаДанных) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Период = КлиентыДоверительногоУправления.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.ДатаСрезаДанных КАК ДатаСрезаДанных,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛица.РодительскоеЮридическоеЛицо, ВложенныйЗапрос.Клиент) КАК Клиент
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	(ВЫБРАТЬ
		|		_КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_КлиентыДоверительногоУправления.Организация КАК Организация,
		|		_КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|		_КлиентыДоверительногоУправления.ДатаСрезаДанных КАК ДатаСрезаДанных,
		|		МАКСИМУМ(СвязанныеЮридическиеЛица.Период) КАК Период
		|	ИЗ
		|		_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|			ПО ((ВЫРАЗИТЬ(_КлиентыДоверительногоУправления.Клиент КАК Справочник.ЮрФизЛица)) = СвязанныеЮридическиеЛица.ЮридическоеЛицо)
		|				И _КлиентыДоверительногоУправления.ДатаСрезаДанных >= СвязанныеЮридическиеЛица.Период
		|				И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_КлиентыДоверительногоУправления.СчетДоверительногоУправления,
		|		_КлиентыДоверительногоУправления.Организация,
		|		_КлиентыДоверительногоУправления.Клиент,
		|		_КлиентыДоверительногоУправления.ДатаСрезаДанных) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|		ПО ((ВЫРАЗИТЬ(ВложенныйЗапрос.Клиент КАК Справочник.ЮрФизЛица)) = СвязанныеЮридическиеЛица.ЮридическоеЛицо)
		|			И ВложенныйЗапрос.Период = СвязанныеЮридическиеЛица.Период
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|			И (СвязанныеЮридическиеЛица.Действует = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ДатаСрезаДанных КАК ДатаСрезаДанных,
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛица.РодительскоеЮридическоеЛицо, ВложенныйЗапрос.ЮрФизЛицо) КАК ЮридическоеЛицо
		|ПОМЕСТИТЬ _ЮрЛицаОрганизаций
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|		_СчетаДоверительногоУправления.Организация КАК Организация,
		|		_СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрФизЛицо,
		|		_СчетаДоверительногоУправления.ДатаСрезаДанных КАК ДатаСрезаДанных,
		|		МАКСИМУМ(СвязанныеЮридическиеЛица.Период) КАК Период
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|			ПО _СчетаДоверительногоУправления.Организация.ЮрФизЛицо = СвязанныеЮридическиеЛица.ЮридическоеЛицо
		|				И _СчетаДоверительногоУправления.ДатаСрезаДанных >= СвязанныеЮридическиеЛица.Период
		|				И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.Ссылка,
		|		_СчетаДоверительногоУправления.Организация,
		|		_СчетаДоверительногоУправления.Организация.ЮрФизЛицо,
		|		_СчетаДоверительногоУправления.ДатаСрезаДанных
		|	) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|		ПО ВложенныйЗапрос.ЮрФизЛицо = СвязанныеЮридическиеЛица.ЮридическоеЛицо
		|			И ВложенныйЗапрос.Период = СвязанныеЮридическиеЛица.Период
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|			И (СвязанныеЮридическиеЛица.Действует = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ЛицензииДоговоровДоверительногоУправления.Лицензия КАК Лицензия
		|ПОМЕСТИТЬ _ВсеЛицензииДоговоровДУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|		_СчетаДоверительногоУправления.Организация КАК Организация,
		|		МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Период) КАК Период
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|			ПО _СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|				И _СчетаДоверительногоУправления.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
		|				И _СчетаДоверительногоУправления.ДатаСрезаДанных >= ЛицензииДоговоровДоверительногоУправления.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.Ссылка,
		|		_СчетаДоверительногоУправления.Организация) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
		|			И ВложенныйЗапрос.Период = ЛицензииДоговоровДоверительногоУправления.Период
		|			И (ЛицензииДоговоровДоверительногоУправления.Действует = ИСТИНА)
		|ГДЕ
		|	НЕ ЛицензииДоговоровДоверительногоУправления.Лицензия ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЛицензииДоговоровДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеЛицензииДоговоровДУ.Лицензия.Номер КАК ЛицензияНомер
		|ПОМЕСТИТЬ _ЛицензииДоговоровДУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеЛицензииДоговоровДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЛицензииДоговоровДУ.Лицензия) КАК КоличествоЛицензий
		|	ИЗ
		|		_ВсеЛицензииДоговоровДУ КАК _ВсеЛицензииДоговоровДУ
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеЛицензииДоговоровДУ.СчетДоверительногоУправления
		|	
		|	ИМЕЮЩИЕ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЛицензииДоговоровДУ.Лицензия) = 1) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеЛицензииДоговоровДУ КАК _ВсеЛицензииДоговоровДУ
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = _ВсеЛицензииДоговоровДУ.СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
