		|					ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
		|					ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия))) КАК КодыВоВнешнихСистемахСрезПоследних";
	#КонецОбласти
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонецДня", ДатаКонецДня);
	Запрос.УстановитьПараметр("КонецДняГраница", Новый Граница(ДатаКонецДня, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаКонецДня));
	
	Запрос.Выполнить();
	
	ПолучитьДатыПервыхПартий(ДатаФормированияОстатков, МВТ, СтатистикаВыполнения);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиБЭК.КодСчетаДУ КАК КодСчетаДУ,
		|	_ОстаткиБЭК.НаименованиеСчетаДУ КАК НаименованиеСчетаДУ,
		|	_ОстаткиБЭК.ТипЦБ КАК ТипЦБ,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоКлассовБумагПоЕПС.КоличествоКлассов, 1) = 1
		|			ТОГДА _ОстаткиБЭК.Количество
		|		ИНАЧЕ _ЦеныАктивов.КоличествоЕПС + ЕСТЬNULL(_ЦенныеБумагиКупленныеПоРепоЕПС.Количество, 0)
		|	КОНЕЦ КАК Количество,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоКлассовБумагПоЕПС.КоличествоКлассов, 1) = 1
		|			ТОГДА ЕСТЬNULL(_ЦенныеБумагиКупленныеПоРепо.Количество, 0)
		|		ИНАЧЕ ЕСТЬNULL(_ЦенныеБумагиКупленныеПоРепоЕПС.Количество, 0)
		|	КОНЕЦ КАК КоличествоКупленныхПоРепо,
		|	_КодыМатрихЦБ.Код КАК МатрихКодЦБ,
		|	_КодыМатрихЭмитентов.Код КАК МатрихКодЭмитента,
		|	_ЦеныАктивов.ДатаПереоценки КАК ДатаПереоценки,
		|	ЕСТЬNULL(_ЦеныАктивов.ЦенаПереоценки, 0) КАК ЦенаОценкиБЭК,
		|	ЕСТЬNULL(_ЦеныАктивов.ЦенаЕПС, 0) КАК ЦенаОценкиЕПС,
		|	ЕСТЬNULL(_ЦеныАктивов.СуммаКупонаИзПереоценки, 0) КАК СуммаКупонаБЭК,
		|	_ЦеныАктивов.ВалютаКотировкиИзПереоценки КАК ВалютаКотировки,
		|	ЕСТЬNULL(_ЦеныАктивов.СуммаКупонаЕПС, 0) КАК СуммаКупонаЕПС,
		|	ЕСТЬNULL(_ЦеныАктивов.КлассификацияЦенныхБумагЕПС, 0) КАК КлассификацияЦенныхБумаг,
		|	ЕСТЬNULL(_ЦеныАктивов.ДисконтПремияЕПС, 0) + ЕСТЬNULL(_ЦеныАктивов.КорректировкаЕПС, 0) + ЕСТЬNULL(_ЦеныАктивов.ПереоценкаЕПС, 0) КАК ДисконтПремияКорректировкаПереоценка,
		|	_ОстаткиБЭК.ВалютаНоминала.Наименование КАК ВалютаНоминала,
		|	_ДатыПокупкиПартий.ДатаПокупки КАК ДатаПокупкиПервойПартии,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦеныАктивов.КурсВалютыНоминалаИзПереоценки, 0) = 0
		|			ТОГДА ВЫРАЗИТЬ(КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК ЧИСЛО(10, 4))
		|		ИНАЧЕ _ЦеныАктивов.КурсВалютыНоминалаИзПереоценки
		|	КОНЕЦ КАК Курс
		|ИЗ
		|	_ОстаткиБЭК КАК _ОстаткиБЭК
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныАктивов КАК _ЦеныАктивов
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиКупленныеПоРепоЕПС КАК _ЦенныеБумагиКупленныеПоРепоЕПС
		|			ПО _ЦеныАктивов.СчетДоверительногоУправления = _ЦенныеБумагиКупленныеПоРепоЕПС.СчетДоверительногоУправления
		|				И _ЦеныАктивов.ЦеннаяБумага = _ЦенныеБумагиКупленныеПоРепоЕПС.ЦеннаяБумага
		|				И _ЦеныАктивов.КлассификацияЦенныхБумагЕПС = _ЦенныеБумагиКупленныеПоРепоЕПС.КлассификацияЦенныхБумагЕПС
		|		ПО _ОстаткиБЭК.СчетДУ = _ЦеныАктивов.СчетДоверительногоУправления
		|			И _ОстаткиБЭК.ЦеннаяБумага = _ЦеныАктивов.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоличествоКлассовБумагПоЕПС КАК _КоличествоКлассовБумагПоЕПС
		|		ПО _ОстаткиБЭК.СчетДУ = _КоличествоКлассовБумагПоЕПС.СчетДоверительногоУправления
		|			И _ОстаткиБЭК.ЦеннаяБумага = _КоличествоКлассовБумагПоЕПС.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиКупленныеПоРепо КАК _ЦенныеБумагиКупленныеПоРепо
		|		ПО _ОстаткиБЭК.СчетДУ = _ЦенныеБумагиКупленныеПоРепо.СчетДоверительногоУправления
		|			И _ОстаткиБЭК.ЦеннаяБумага = _ЦенныеБумагиКупленныеПоРепо.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрихЦБ КАК _КодыМатрихЦБ
		|		ПО _ОстаткиБЭК.ЦеннаяБумага = _КодыМатрихЦБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрихЮрЛиц КАК _КодыМатрихЭмитентов
		|		ПО _ОстаткиБЭК.Эмитент = _КодыМатрихЭмитентов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПокупкиПартий КАК _ДатыПокупкиПартий
		|		ПО _ОстаткиБЭК.СчетДУ = _ДатыПокупкиПартий.СчетДоверительногоУправления
		|			И _ОстаткиБЭК.ЦеннаяБумага = _ДатыПокупкиПартий.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&НачалоДня, Период = &НачалоДня) КАК КурсыВалютСрезПоследних
		|		ПО _ОстаткиБЭК.ВалютаНоминала = КурсыВалютСрезПоследних.Валюта";
	#КонецОбласти
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаКонецДня));
	
	ВыборкаЗаписей = Запрос.Выполнить().Выбрать();

	Пока ВыборкаЗаписей.Следующий() Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.AssetDate    = ДатаКонецДня;
		НоваяСтрока.ClientCode   = ВыборкаЗаписей.КодСчетаДУ;
		НоваяСтрока.ClientName   = ВыборкаЗаписей.НаименованиеСчетаДУ;
		НоваяСтрока.AssetType    = ВыборкаЗаписей.ТипЦБ;
		НоваяСтрока.AssetID      = ВыборкаЗаписей.МатрихКодЦБ;
		НоваяСтрока.Class        = ВыборкаЗаписей.КлассификацияЦенныхБумаг;
		НоваяСтрока.Quantity     = ВыборкаЗаписей.Количество;
		НоваяСтрока.REPOQuantity = ВыборкаЗаписей.КоличествоКупленныхПоРепо;
		НоваяСтрока.IssuerID     = ВыборкаЗаписей.МатрихКодЭмитента;
		НоваяСтрока.CurrencyCode = ?(ЗначениеЗаполнено(ВыборкаЗаписей.ВалютаНоминала), ВыборкаЗаписей.ВалютаНоминала, "");
		НоваяСтрока.AccintBack   = ВыборкаЗаписей.СуммаКупонаБЭК;
		НоваяСтрока.AccintEPS    = ВыборкаЗаписей.СуммаКупонаЕПС;
		
		НоваяСтрока.EvaluationPriceCurrency    = ВыборкаЗаписей.ЦенаОценкиБЭК;
		НоваяСтрока.EvaluationPriceCurrencyEPS = ВыборкаЗаписей.ЦенаОценкиЕПС;
		НоваяСтрока.Overvalue                  = ВыборкаЗаписей.ДисконтПремияКорректировкаПереоценка;
		НоваяСтрока.EvaluationDate             = ВыборкаЗаписей.ДатаПереоценки;
		НоваяСтрока.PurchaseDate               = ВыборкаЗаписей.ДатаПокупкиПервойПартии;
		НоваяСтрока.CurrRate                   = ВыборкаЗаписей.Курс;
	КонецЦикла;
	
	Если СтатистикаВыполнения <> Неопределено Тогда
		СтатистикаВыполнения.Процедура_ПолучитьОстаткиАктивов = РассчитатьВремя(СтатистикаВыполнения.Процедура_ПолучитьОстаткиАктивов);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьЗадолженностьПоЕПС()
	
	//вынес запрос получения дебиторской/кредиторской задолженности из бух остатков отдельно на случай если понадобится в будущем.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто3 КАК Субконто3,
		|	ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.Валюта, &РоссийскийРубль) КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт
		|ПОМЕСТИТЬ _ОстаткиЕПС
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(&КонецДняГраница, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства), ЗНАЧЕНИЕ(ПланСчетов.Единый.РезервыОценочныеОбязательства), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами), ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеПрибыльУбыток), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеДляПродажи), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеДляПродажиИДоПогашения)), , Организация = &Организация) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""COM"" КАК ТипАссетс,
		|	_ОстаткиЕПС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиЕПС.Субконто1 КАК Контрагент,
		|	_ОстаткиЕПС.Валюта КАК Валюта,
		|	NULL КАК ЦеннаяБумага,
		|	СУММА(ВЫБОР
		|			КОГДА _ОстаткиЕПС.Валюта = &РоссийскийРубль
		|				ТОГДА _ОстаткиЕПС.СуммаОстатокДт
		|			ИНАЧЕ _ОстаткиЕПС.ВалютнаяСуммаОстатокДт
		|		КОНЕЦ) КАК СуммаДт,
		|	СУММА(ВЫБОР
		|			КОГДА _ОстаткиЕПС.Валюта = &РоссийскийРубль
		|				ТОГДА _ОстаткиЕПС.СуммаОстатокКт
		|			ИНАЧЕ _ОстаткиЕПС.ВалютнаяСуммаОстатокКт
		|		КОНЕЦ) КАК СуммаКт
		|ПОМЕСТИТЬ _ЗадолженностьЕПС
		|ИЗ
		|	_ОстаткиЕПС КАК _ОстаткиЕПС
		|ГДЕ
		|	_ОстаткиЕПС.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами11), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами12))
		|	И (_ОстаткиЕПС.Субконто1 В (&СубконтоКонтрагентыДоговоры)
		|			ИЛИ _ОстаткиЕПС.Субконто2 В (&СубконтоКонтрагентыДоговоры)
		|			ИЛИ _ОстаткиЕПС.Субконто3 В (&СубконтоКонтрагентыДоговоры))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиЕПС.СчетДоверительногоУправления,
		|	_ОстаткиЕПС.Субконто1,
		|	_ОстаткиЕПС.Валюта
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА _ОстаткиЕПС.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами47)
		|			ТОГДА ""DIV""
		|		КОГДА НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности ЕСТЬ NULL
		|			ТОГДА """"
		|		ИНАЧЕ ""COM""
		|	КОНЕЦ,
		|	_ОстаткиЕПС.СчетДоверительногоУправления,
		|	_ОстаткиЕПС.Субконто1,
		|	_ОстаткиЕПС.Валюта,
		|	NULL,
		|	СУММА(ВЫБОР
		|			КОГДА _ОстаткиЕПС.Валюта = &РоссийскийРубль
		|				ТОГДА _ОстаткиЕПС.СуммаОстатокДт
		|			ИНАЧЕ _ОстаткиЕПС.ВалютнаяСуммаОстатокДт
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА _ОстаткиЕПС.Валюта = &РоссийскийРубль
		|				ТОГДА _ОстаткиЕПС.СуммаОстатокКт
		|			ИНАЧЕ _ОстаткиЕПС.ВалютнаяСуммаОстатокКт
		|		КОНЕЦ)
		|ИЗ
		|	_ОстаткиЕПС КАК _ОстаткиЕПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&НачалоДня,
		|				Организация = &Организация
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария)) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО _ОстаткиЕПС.СчетДоверительногоУправления = НастройкиУчетаКомиссииСрезПоследних.СчетДоверительногоУправления
		|			И _ОстаткиЕПС.Счет = НастройкиУчетаКомиссииСрезПоследних.СчетУчета
		|ГДЕ
		|	_ОстаткиЕПС.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами22), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами23), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами24), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами47))
		|	И (_ОстаткиЕПС.Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			ИЛИ _ОстаткиЕПС.Субконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			ИЛИ _ОстаткиЕПС.Субконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА _ОстаткиЕПС.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами47)
		|			ТОГДА ""DIV""
		|		КОГДА НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности ЕСТЬ NULL
		|			ТОГДА """"
		|		ИНАЧЕ ""COM""
