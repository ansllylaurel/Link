				КонецЦикла;
				
				Если ДетальныеЗаписи <> "" Тогда
					Расхождения = Расхождения + "<tr class=""top2""><td>" + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + "</td><td colspan=""6"">" + ГруппировкаПоНаименованию.НаименованиеСчетаДУ + " (" + ГруппировкаПоНаименованию.КодСчетаДУ + ")</td>" + Символы.ПС + Символы.Таб + ДетальныеЗаписи;	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ДополнительныеСвойства.Свойство("ВыгрузитьДанныеПриРасхождении") Тогда
		
			ДанныеДляВыгрузки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляВыгрузки"].ПолучитьДанные().Выгрузить();
			
			Если ДанныеДляВыгрузки.Количество() = 0 Тогда
				ДатаСверки = ДатаСверки + 24 * 60 * 60;
				Продолжить;
			КонецЕсли;
			
			СоединениеВыгрузкиДанных = НастроитьСоединение();
			
			Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
				ВыгрузитьДанныеВ_Assets1C8(ЭтотОбъект.СчетДоверительногоУправления.КодСчета, ДатаСверки, КодКомпании, ДанныеДляВыгрузки, СоединениеВыгрузкиДанных, СтатистикаВыполнения);
			Иначе
			
				СчетаДоверительногоУправления = ДанныеДляВыгрузки.Скопировать(,"ClientCode, ЕстьЗапись1С");
				СчетаДоверительногоУправления.Свернуть("ClientCode", "ЕстьЗапись1С");
				
				Для Каждого СтрокаСчета Из СчетаДоверительногоУправления Цикл
					
					Если СтрокаСчета.ЕстьЗапись1С = 0 Тогда
						
						ЗарегистрироватьОшибку("В таблице Assets1C8 присутствуют записи активов клиента " + СтрокаСчета.ClientCode + " на дату " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + ". В 1С нет этих данных.");
						Продолжить;
						
					КонецЕсли;
					
					ДанныеСчетаДУДляВыгрузки = ДанныеДляВыгрузки.Скопировать(Новый Структура("ClientCode, ФлЕстьЗапись1С", СтрокаСчета.ClientCode, Истина));
						
					Если ДанныеСчетаДУДляВыгрузки.Количество() > 0 Тогда
						ВыгрузитьДанныеВ_Assets1C8(СтрокаСчета.ClientCode, ДатаСверки, КодКомпании, ДанныеСчетаДУДляВыгрузки, СоединениеВыгрузкиДанных, СтатистикаВыполнения);
					КонецЕсли;
			
				КонецЦикла;
				
			КонецЕсли;
			
			НастроитьСоединение(СоединениеВыгрузкиДанных);
			
		КонецЕсли;
		
		ТаблицаДанных1С.Очистить();
		ТаблицаДанныхАссетс.Очистить();
		
		ДатаСверки = ДатаСверки + 24 * 60 * 60;
		
	КонецЦикла;
	
	Если Расхождения <> "" Тогда
		
		Расхождения =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style>
			|		body       { font: 10pt sans-serif; }
			|		table      { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td         { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
			|		.top       { font-size: 14px; background: #F4ECC5; }
			|		.top2      { font-size: 14px; background: #F8F2D8; }
			|		.redtext   { color: #DC143C; }
			|		.greentext { color: #009646; }
			|	</style>
			|</head>
			|<body>
			|<table cols = ""7"">
			|<tr class = ""top"">
			|	<td>Дата</td>
			|	<td colspan = ""6"">Счет доверительного управления</td>
			|</tr>
			|<tr class = ""top"">
			|	<td rowspan = ""2"">AssetType</td>
			|	<td rowspan = ""2"">AssetID / DocumentNumber</td>
			|	<td rowspan = ""2"">Наименование</td>
			|	<td rowspan = ""2"">IssuerID</td>
			|	<td rowspan = ""2"">Поле</td>
			|	<td colspan = ""2"">" + ?(ДополнительныеСвойства.Свойство("ВыгрузитьДанныеПриРасхождении"), "Изменение", "Расхождение") + "</td>
			|</tr><tr class = ""top""><td>" + ?(ДополнительныеСвойства.Свойство("ВыгрузитьДанныеПриРасхождении"), "Было</td><td>Стало" , "Assets</td><td>1C") + "</td></tr>
			|" + Расхождения + "</table></body></html>";
		
		Если ДополнительныеСвойства.Свойство("ОтправитьОтчетОРасхождении") Тогда
				
			ОтправитьОтчет("Экспорт данных для рисков. Отчет " + ?(ДополнительныеСвойства.Свойство("ВыгрузитьДанныеПриРасхождении"), "об измененных данных.", "о расхождении данных.") + ? (ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления), " Клиент " + СокрЛП(ЭтотОбъект.СчетДоверительногоУправления), ""), Расхождения);
			
		КонецЕсли;
			
	КонецЕсли;
	
	НастроитьСоединение(СоединениеПолученияДанных);
	
	Если ДополнительныеСвойства.Свойство("ЗаполнитьДатыПервыхПартий") Тогда
		ДополнительныеСвойства.Удалить("ЗаполнитьДатыПервыхПартий");
	КонецЕсли;
	
	ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения);
	
	Возврат Расхождения;
		
КонецФункции

Процедура ОтправитьОтчет(Тема, Текст)
			
	Справочники.Оповещения.СформироватьОповещения("Обработка._ЭкспортДанныхДляРисков", Перечисления.ТипыСобытий.ВнешнийВызов, Новый Структура("Тема, Текст", Тема, Текст));
	
КонецПроцедуры

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;