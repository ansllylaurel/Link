// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Экспорт данных для рисков",
		"2.6.6",
		"",
		Истина
	);
	
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ВыгрузитьДанныеВАссетсБезДатПервыхПартий", "Экспорт данных в Assets без дат первых партий",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ВыгрузитьСправочникКлиентовДепозитыСделкиРепо", "Экспорт данных в Deposits, Clients, Repo",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ВыгрузитьВсеДанныеПроверитьЦены", "Экспорт всех данных и проверка цен",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ВыгрузитьВсеДанныеБезПроверкиЦен", "Экспорт всех данных без проверки цен",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ЭкспортКотировок", "Экспорт котировок",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДатаСеанса())) Тогда
		УстановитьПериодВыгрузки();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды = "ЭкспортКотировок" Тогда
		
		ЭтотОбъект.СделкиРепо = Ложь;
		ЭтотОбъект.СправочникСчетов = Ложь;
		ЭтотОбъект.Депозиты   = Ложь;
		ЭтотОбъект.Активы     = Ложь;
		ЭтотОбъект.Котировки  = Истина;
				
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьСправочникКлиентовДепозитыСделкиРепо" Тогда //Траст, РЭМ - Запуск утром		
		ЭтотОбъект.СделкиРепо = Истина;
		ЭтотОбъект.СправочникСчетов = Истина;
		ЭтотОбъект.Депозиты   = Истина;
		ЭтотОбъект.Активы     = Ложь;
		ЭтотОбъект.Котировки  = Ложь;
		
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьВсеДанныеПроверитьЦены" Тогда //Траст, РЭМ - запуск в 18:00
		
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЗаполнитьДатыПервыхПартий", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ПроверитьНаличиеЦенОценки", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ОтправитьОтчетОбОтсутствииЦен", Истина);
	
		ЭтотОбъект.СделкиРепо = Истина;
		ЭтотОбъект.СправочникСчетов = Истина;
		ЭтотОбъект.Депозиты   = Истина;
		ЭтотОбъект.Активы     = Истина;
		ЭтотОбъект.Котировки  = Ложь;
					
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьВсеДанныеБезПроверкиЦен" Тогда //РПИ, МД Траст
					
		ЭтотОбъект.СделкиРепо = Истина;
		ЭтотОбъект.СправочникСчетов = Истина;
		ЭтотОбъект.Депозиты   = Истина;
		ЭтотОбъект.Активы     = Истина;
		ЭтотОбъект.Котировки  = Ложь;
		
	ИначеЕсли ИдентификаторКоманды = "ВыгрузитьДанныеВАссетсБезДатПервыхПартий" Тогда //Траст, РЭМ в 15:00
				
		ЭтотОбъект.СделкиРепо = Ложь;
		ЭтотОбъект.СправочникСчетов = Ложь;
		ЭтотОбъект.Депозиты   = Ложь;
		ЭтотОбъект.Активы     = Истина;
		ЭтотОбъект.Котировки  = Ложь;
		
	Иначе
		Возврат;		
	КонецЕсли;
	
	Выгрузить();
	
КонецПроцедуры

// Интерфейс для запуска отложенного задания
//
// Параметры:
//  Команда			 - Строка - Идентификатор выполняемого метода
//  ПараметрыКоманды - Структура - Содержит параметры запуска метода
//
Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт

	Если Метод <> "ЭкспортДанныхВ_Assets1C8" Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ЭкспортДанныхДляРисков");
	ТекНачалоДня = НачалоДня(ТекущаяДатаСеанса());
	 //тут -1 день, функция берет в расчет и текущий рабочий день, не знаю почему так. 
	ПрошлыйРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекНачалоДня, ?(Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекНачалоДня), -2, -1));
	МассивОрганизаций = Новый Массив;
	
	ДополнительныеСвойства.Вставить("Источник", ОбработкаСсылка);
	ДополнительныеСвойства.Вставить("ЗаполнитьДатыПервыхПартий", Истина);

	ЭтотОбъект.СделкиРепо = Ложь;
	ЭтотОбъект.СправочникСчетов = Ложь;
	ЭтотОбъект.Депозиты = Ложь;
	ЭтотОбъект.Активы = Истина;
	ЭтотОбъект.Котировки = Ложь;
	
	Если ОбработкаСсылка = Неопределено Тогда
		
		ЗарегистрироватьОшибку("В справочнике дополнительных отчетов и обработок отсутствует обработка с именем [_ЭкспортДанныхДляРисков]");
		
	Иначе
								
		МассивКоманд = ОбработкаСсылка.Команды.НайтиСтроки(Новый Структура("Идентификатор", "ВыгрузитьДанныеВАссетсБезДатПервыхПартий"));

		Для Каждого КомандаВыгрузки из МассивКоманд Цикл
			
			ПараметрыКомандыВыгрузки = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ОбработкаСсылка, "ВыгрузитьДанныеВАссетсБезДатПервыхПартий", КомандаВыгрузки.ГруппаПараметров);
			
			Если ПараметрыКомандыВыгрузки.Свойство("Организация") Тогда
				
				РегламентноеЗадание = РаботаСДополнительнымиОтчетамиИОбработками.НайтиЗадание(КомандаВыгрузки.РегламентноеЗаданиеGUID);
								
				СвойстваПоследнегоФоновогоЗадания = РаботаСРегламентнымиЗаданиямиСлужебный.ПолучитьСвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(РегламентноеЗадание);
				
				//Не выгружаем данные пока не завершено регламентное задание (по расписанию в 15:00).
				Если СвойстваПоследнегоФоновогоЗадания <> Неопределено И СвойстваПоследнегоФоновогоЗадания.Состояние = СостояниеФоновогоЗадания.Завершено И НачалоДня(СвойстваПоследнегоФоновогоЗадания.Начало) = ТекНачалоДня Тогда
					МассивОрганизаций.Добавить(ПараметрыКомандыВыгрузки.Организация);					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЕсли;

	Ключи = Новый ТаблицаЗначений;

	Ключи.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Ключи.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Ключи.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	Ключи.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
		
	Для Каждого Экземпляр Из Экземпляры Цикл
	
		НовыйКлюч = Ключи.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, Экземпляр.Параметры);
		НовыйКлюч.Идентификатор = Экземпляр.Идентификатор;
	
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Организация КАК Организация,
		|	КлючиЗапуска.Дата КАК Дата,
		|	КлючиЗапуска.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Экземпляры.Дата КАК Дата,
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Экземпляры.Идентификатор КАК Идентификатор,
		|	&ОшибкаНетОбработки КАК ОшибкаНетОбработки,
		|	_Экземпляры.Организация В (&МассивОрганизаций) КАК ВыполненоРегламентноеЗадание,
		|	СтоимостьПереоценки.СчетДоверительногоУправления ЕСТЬ NULL КАК ОтсутствуетСЧА
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ПО _Экземпляры.Дата = СтоимостьПереоценки.Период
		|			И _Экземпляры.Организация = СтоимостьПереоценки.Организация
		|			И _Экземпляры.СчетДоверительногоУправления = СтоимостьПереоценки.СчетДоверительногоУправления
		|			И (СтоимостьПереоценки.Активность = ИСТИНА)
		|			И (СтоимостьПереоценки.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|					И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))
		|				ИЛИ СтоимостьПереоценки.Регистратор ССЫЛКА Документ.РегистрацияСтоимостиПереоценки
		|					И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|ИТОГИ ПО
		|	Дата,
		|	Организация";
	
	Запрос.УстановитьПараметр("КлючиЗапуска", Ключи);
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	Запрос.УстановитьПараметр("ОшибкаНетОбработки", (ОбработкаСсылка = Неопределено));
	
	ВыборкаГруппировкаПоДате = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Дата");
		
	Пока ВыборкаГруппировкаПоДате.Следующий() Цикл
		
		МассивСчетовДУ = Новый Массив;

		ВыборкаГруппировкаПоОрганизации = ВыборкаГруппировкаПоДате.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Организация");
		
		Пока ВыборкаГруппировкаПоОрганизации.Следующий() Цикл
			
			Выборка = ВыборкаГруппировкаПоОрганизации.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если МассивСчетовДУ.Найти(Выборка.СчетДоверительногоУправления) = Неопределено Тогда
					МассивСчетовДУ.Добавить(Выборка.СчетДоверительногоУправления);
				Иначе
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
					Продолжить;
				КонецЕсли;
				
				Если Выборка.ОшибкаНетОбработки Тогда
					
					ТекстОшибки = "В справочнике дополнительных отчетов и обработок отсутствует обработка с именем [_ЭкспортДанныхДляРисков]"; 
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор, Истина, ТекстОшибки);
					ЗарегистрироватьОшибку(ТекстОшибки);
					
				ИначеЕсли Выборка.ОтсутствуетСЧА Тогда
					
					//Если отменили проведение документа 
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
					
				ИначеЕсли Выборка.Дата < ПрошлыйРабочийДень Тогда 
					
					//Сверяем данные и, если есть расхождения, перевыгружаем данные, информируем об изменениях.
					ЭтотОбъект.Организация = Выборка.Организация;
					ЭтотОбъект.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
					ЭтотОбъект.Период = Новый СтандартныйПериод(Выборка.Дата, КонецДня(Выборка.Дата));
					
					ДополнительныеСвойства.Вставить("ОтправитьОтчетОРасхождении", Истина);
					ДополнительныеСвойства.Вставить("ВыгрузитьДанныеПриРасхождении", Истина);
					
					СверитьДанныеВ_Assets1C8();
					
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);

				ИначеЕсли Не Выборка.ВыполненоРегламентноеЗадание Тогда
					
					//Если попали на выполнение регламентного задания. Сдвигаем отложенное задание на 15 мин.
					РаботаСРегламентнымиЗаданиями.ОтменитьОтложенноеЗадание(Выборка.Идентификатор, "На момент запуска еще не завершено регламентное задание [ВыгрузитьДанныеВАссетсБезДатПервыхПартий]. Организация [" + Выборка.Организация + "]");
					
					ПараметрыОбработки = Новый Структура("Дата,Организация,СчетДоверительногоУправления,ИсточникОшибки");
					ЗаполнитьЗначенияСвойств(ПараметрыОбработки, Выборка);
					ПараметрыОбработки.ИсточникОшибки = "Экспорт данных для рисков";
				
					РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ОбработкаСсылка, "ЭкспортДанныхВ_Assets1C8", ПараметрыОбработки, 15, Истина, ТекущаяДатаСеанса() + 15 * 60);
									
				Иначе							
						
					ЭтотОбъект.Организация = Выборка.Организация;
					ЭтотОбъект.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
					ЭтотОбъект.Период = Новый СтандартныйПериод(Выборка.Дата, КонецДня(Выборка.Дата));
					
					Выгрузить();
					
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
										
				КонецЕсли;
										
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПрефиксЖурналаРегистрации(ВключаяПлавающуюТочку = Истина)
	Возврат "Внешние отчёты и обработки._ЭкспортДанныхДляРисков" + ?(ВключаяПлавающуюТочку, ".", "");
КонецФункции

Процедура УстановитьПериодВыгрузки()
	
	//Если текущий день первый рабочий после выходных необходимо выгрузить данные и за выходные и за предшествующий выходным рабочий день
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаНачала
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата < &Дата
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата > ДОБАВИТЬКДАТЕ(&Дата, ДЕНЬ, -15)
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	
	Результат = Запрос.Выполнить().Выгрузить();
		
	Период.ДатаНачала 	 = Результат[0].ДатаНачала; 
	Период.ДатаОкончания = НачалоДня(ТекущаяДатаСеанса()) - 1;
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда		
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ОповеститьОбОшибкахИЗакрытьСессию(Механизм, Сессия, СтатистикаВыполнения, ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ДополнительныеСвойства.Свойство("Ошибки");
	ТекстОшибки = Неопределено;
	
	Если ЕстьОшибки Тогда
		
		ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ДополнительныеСвойства.Ошибки, Символы.ПС);
		
		Если ДополнительныеСвойства.Свойство("Источник") Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ДополнительныеСвойства.Ошибки, ДополнительныеСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		
		ДополнительныеСвойства.Удалить("Ошибки");
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, Ложь, СтатистикаВыполнения, ТекстОшибки);
		
КонецПроцедуры

Процедура Timeout(Секунды)
    
    КомандаWindows = "Timeout /T " + Строка(Секунды) + " /NoBreak";
    ЗапуститьПриложение(КомандаWindows, , Истина);
    
КонецПроцедуры

Функция НастроитьСоединение(Соединение = Неопределено)
				
	Если Соединение = Неопределено Тогда
		
		Если ДополнительныеСвойства.Свойство("ЭкспортДанныхРПИ") Тогда
			СтрокаСоединения = "Driver={SQL Server};Server=AP49.G1.LAN;UID=Risk1C;PWD=Risk1C;Database=Risk_RPI"; 	
		Иначе
			СтрокаСоединения = "Driver={SQL Server};Server=AP18.G1.LAN;UID=Nikolay;PWD=11111;Database=Repository";	
		КонецЕсли;
		
		Для НомерПопытки = 1 По 3 Цикл

			Попытка
				
				Соединение = Новый COMОбъект("ADODB.Connection");			
				Соединение.ConnectionString = СтрокаСоединения;
				Соединение.Open();
				Прервать;
				
			Исключение
				
				Если НомерПопытки = 3 Тогда
					ЗарегистрироватьОшибку("Не удалось установить соединение с сервером SQL. Система сообщает: " + ОписаниеОшибки());
					Возврат Неопределено;
				Иначе
					Timeout(5); // 5 сек
				КонецЕсли;
				
			КонецПопытки;
			
		КонецЦикла;

		Возврат Соединение;
		
	Иначе
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);	
	КонецЕсли
		
КонецФункции

Функция ВыполнитьЗапрос(ТекстЗапроса, Соединение, ТекстОшибки = "")
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса, ДополнительныеСвойства);
	
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибку(ТекстОшибки);
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция СтрокаSQL(Строка1С)
	Возврат "'" + СтрЗаменить(Строка1С, "'", "''") + "'";
КонецФункции

Функция ЧислоSQL(Число1С)
	ЧислоSQL = Формат(Число1С, "ЧРД=.; ЧГ=0");
	Если ПустаяСтрока(ЧислоSQL) Тогда
		Возврат "0";
	КонецЕсли;
	Возврат ЧислоSQL;
КонецФункции

Функция ДатаSQL(Дата1С, Время = Неопределено)
	Если ЗначениеЗаполнено(Дата1С) Тогда
		Если Время = Неопределено Тогда
			Возврат "'" + Формат(Дата1С, "ДФ=ггггММдд") + "'"; //YYYYMMDD
		Иначе
			Возврат "'" + Формат(Дата1С, "ДЛФ=В") + "'";
		КонецЕсли;
	Иначе
		Возврат "NULL";
	КонецЕсли;
КонецФункции

