
&НаСервереБезКонтекста
Функция ПолучитьОсновногоПодписанта()
	
	Возврат Справочники.ЮрФизЛица.НайтиПоНаименованию("Зайцева Е. А.");
	
КонецФункции // ПолучитьОсновногоПодписанта

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.Подписант = ПолучитьОсновногоПодписанта();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("НомерПоследнегоРаспоряжения", ЭтаФорма.НомерПоследнегоРаспоряжения);
	ПараметрыЗакрытия.Вставить("Подписант", ЭтаФорма.Подписант);
	
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры
