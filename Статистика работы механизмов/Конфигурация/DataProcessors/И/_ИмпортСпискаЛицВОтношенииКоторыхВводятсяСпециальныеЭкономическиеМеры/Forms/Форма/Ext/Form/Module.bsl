&НаКлиенте
Процедура ИмпортироватьСписок(Команда)
	
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортироватьСписок");
	Попытка
		ВыполнитьИмпортироватьСписок();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИмпортироватьСписок()
	Объект.СписокЮрФизЛиц.Очистить();
	
	Месяцы = Новый Массив;
	Месяцы.Добавить("");
	Месяцы.Добавить("января");
	Месяцы.Добавить("февраля");
	Месяцы.Добавить("марта");
	Месяцы.Добавить("апреля");
	Месяцы.Добавить("мая");
	Месяцы.Добавить("июня");
	Месяцы.Добавить("июля");
	Месяцы.Добавить("августа");
	Месяцы.Добавить("сентября");
	Месяцы.Добавить("октября");
	Месяцы.Добавить("ноября");
	Месяцы.Добавить("декабря");
	
	МассивДанных = Новый Массив;
	
	
	Для Стр = 1 По Объект.ТекстФизЛица.КоличествоСтрок() Цикл
		СтрокаСписка = Объект.ТекстФизЛица.ПолучитьСтроку(Стр);
		СтрокаСписка = Сред(СтрокаСписка, Найти(СтрокаСписка, символы.Таб) + 1);
		
		МассивЗначениеСтроки = СтрРазделить(СтрокаСписка, ",", Ложь);
		
		ФИО = СтрЗаменить(МассивЗначениеСтроки[0], "(", "");
		
		МассивФИО = СтрРазделить(ФИО, " ", Ложь);
		
		ДатаРождения = "";
		
		МассивМестоРождения = Новый Массив;
		
		Для Каждого ЧастьСтроки Из МассивЗначениеСтроки Цикл
			Если Найти(ЧастьСтроки, "дата рождения - ") > 0 Тогда
				МассивДатыРождения = СтрРазделить(СтрЗаменить(ЧастьСтроки, "дата рождения - ", "")," ", Ложь);
				
				Если МассивДатыРождения.Количество() > 2 И Месяцы.Найти(МассивДатыРождения[1]) > 0 Тогда
					ДатаРождения = Дата(МассивДатыРождения[2], Месяцы.Найти(МассивДатыРождения[1]),МассивДатыРождения[0]);
				КонецЕсли;
				
			КонецЕсли;
			
			Если МассивМестоРождения.Количество() > 0 ИЛИ Найти(ЧастьСтроки, "место рождения - ") > 0 Тогда
				МассивМестоРождения.Добавить(СтрЗаменить(ЧастьСтроки, "место рождения - ", ""));
			КонецЕсли;
		КонецЦикла;
		
		МестоРождения = СтрСоединить(МассивМестоРождения, ", ");
		
		НоваяСтрока = Объект.СписокЮрФизЛиц.Добавить();
		НоваяСтрока.ВидЮрФизЛица = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
		НоваяСтрока.Фамилия		= МассивФИО[0];
		НоваяСтрока.Имя			= МассивФИО[1];
		
		Если МассивФИО.Количество() > 2 Тогда
			НоваяСтрока.Отчество 	= МассивФИО[2];
		КонецЕсли;
		
		НоваяСтрока.ДатаРождения= ДатаРождения;
		НоваяСтрока.МестоРождения= МестоРождения;
	
	КонецЦикла;
	
	
	Для Стр = 1 По Объект.ТекстЮрЛица.КоличествоСтрок() Цикл
		СтрокаСписка = Объект.ТекстЮрЛица.ПолучитьСтроку(Стр);
		СтрокаСписка = Сред(СтрокаСписка, Найти(СтрокаСписка, символы.Таб) + 1);
		
		НомерПервойЗапятой = Найти(СтрокаСписка, ",");
		ПолноеНаименование = Лев(СтрокаСписка, НомерПервойЗапятой - 1);
		
		НомерСкобки = Найти(ПолноеНаименование, "(");
		Если НомерСкобки > 0 Тогда
			Наименование = Лев(ПолноеНаименование, НомерСкобки - 1);
		Иначе
			Наименование = ПолноеНаименование;
		КонецЕсли;
		
		Адрес = Сред(СтрокаСписка, НомерПервойЗапятой + 1);
		
		РегНомер = "";
		
		МассивАдрес = СтрРазделить(Адрес, ",", Ложь);
		Для Каждого ЧастьАдреса Из МассивАдрес Цикл
			Если Найти(ЧастьАдреса, "ЕГРПОУ") > 0 Тогда
				РегНомер = СокрЛП(СтрЗаменить(ЧастьАдреса, "ЕГРПОУ", ""));
				МассивАдрес.Удалить(МассивАдрес.Найти(ЧастьАдреса));
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Адрес = СтрСоединить(МассивАдрес, ",");
		
		НоваяСтрока = Объект.СписокЮрФизЛиц.Добавить();
		НоваяСтрока.ВидЮрФизЛица		= ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
		НоваяСтрока.Наименование		= Наименование;
		НоваяСтрока.ПолноеНаименование	= ПолноеНаименование;		
		НоваяСтрока.Адрес				= Адрес;		
		НоваяСтрока.РегНомер			= РегНомер;		
		
	КонецЦикла;
	
	
КонецПроцедуры



#Область Команды

&НаКлиенте
Процедура СохранитьДанные(Команда)
	
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СохранитьДанные");
	Попытка
		ВыполнитьСохранитьДанные(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСохранитьДанные(ПараметрыСессии)
	ТекущаяУниверсальнаяДата = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если НЕ ПроверкаЗаполнения() Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Поле ""Имя файла"" не заполнено");
		Возврат;
	КонецЕсли;	
	
	МассивСтрок		= Новый Массив;
	ДвоичныеДанные	= Новый ДвоичныеДанные(Объект.ИмяФайла);

	РеквизитыЮрФизЛицаСтрокой = "Is_Firm,Name,LastName,FirstName,MiddleName,BirthDate,INN,RegistrationNumber,LegalAddress,PlaceOfBirth";
	СтруктураNull = Новый Структура(РеквизитыЮрФизЛицаСтрокой, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null);
	
	Для Каждого СтрокаЮрФизЛиц Из Объект.СписокЮрФизЛиц Цикл
		ДанныеЮрФизЛица = Новый Структура(РеквизитыЮрФизЛицаСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, СтруктураNull);
		
		ДанныеЮрФизЛица.Вставить("Period", Объект.Период);
		
		Если СтрокаЮрФизЛиц.ВидЮрФизЛица = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо") Тогда
			ДанныеЮрФизЛица.Is_Firm = 0;
			ДанныеЮрФизЛица.Name			= СтрокаЮрФизЛиц.Фамилия + " " + СтрокаЮрФизЛиц.Имя;
			ДанныеЮрФизЛица.LastName		= СтрокаЮрФизЛиц.Фамилия;
			ДанныеЮрФизЛица.FirstName		= СтрокаЮрФизЛиц.Имя;
			
			Если ЗначениеЗаполнено(СтрокаЮрФизЛиц.ДатаРождения) Тогда
				ДанныеЮрФизЛица.BirthDate		= СтрокаЮрФизЛиц.ДатаРождения;
			КонецЕсли;
			
			ДанныеЮрФизЛица.PlaceOfBirth	= СтрокаЮрФизЛиц.МестоРождения;
			
			Если ЗначениеЗаполнено(СтрокаЮрФизЛиц.Отчество) Тогда
				ДанныеЮрФизЛица.Name		= ДанныеЮрФизЛица.Name +  " " + СтрокаЮрФизЛиц.Отчество;
				ДанныеЮрФизЛица.MiddleName	= СтрокаЮрФизЛиц.Отчество;
			КонецЕсли;
			
		Иначе
			
			ДанныеЮрФизЛица.Is_Firm = 1;
			
			ДанныеЮрФизЛица.Name				= СтрокаЮрФизЛиц.Наименование;
			ДанныеЮрФизЛица.RegistrationNumber	= СтрокаЮрФизЛиц.РегНомер;
			ДанныеЮрФизЛица.LegalAddress		= СтрокаЮрФизЛиц.Адрес;
			
		КонецЕсли;	
		
		МассивСтрок.Добавить(ДанныеЮрФизЛица);
	
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество строк 0!");
		ДобавитьТекстОшибки(ПараметрыСессии, "Количество строк 0!");
		Возврат;
	КонецЕсли;

	СохранитьДанныеВExternals(Объект.Период, МассивСтрок, ДвоичныеДанные);
	
	Сообщить("Время выполнения: " + Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ТекущаяУниверсальнаяДата) / 1000) + " секунд");
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполнения()
	
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Имя файла"" не заполнено",,, "КаталогДанных", Отказ);
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервере
Процедура СохранитьДанныеВExternals(Период, МассивСтрок, ДвоичныеДанные)
	
	ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(Объект.ИмяФайла);
	ДанныеФайла.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	
	РаботаСВнешнимиСистемами.СохранитьСписокДляСверкиВExternals(Объект.Организация, 7, Период, МассивСтрок, ДанныеФайла);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИнициироватьПроверкуНаСервере()
	
	ТекущаяУниверсальнаяДата = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если ЗначениеЗаполнено(Объект.ЮрФизЛицо) Тогда
		ПроверяемыеЛица = Новый Массив;
		ПроверяемыеЛица.Добавить(Объект.ЮрФизЛицо);
		РезультатСверки = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиССанкционнымСписком(ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"), ТекущаяДата(), ПроверяемыеЛица);
	Иначе
		РезультатСверки = РаботаСВнешнимиСистемами.ПолучитьРезультатСверкиССанкционнымСписком(ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"), ТекущаяДата());
	КонецЕсли;
	
	Сообщить("Время выполнения: " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - ТекущаяУниверсальнаяДата) / 1000, "ЧДЦ=3") + " секунд");
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициироватьПроверку(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИнициироватьПроверку");
	Попытка
		ИнициироватьПроверкуНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
 
 ОбъектОбработки = РеквизитФормыВЗначение("Объект");
 
 ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
 
 Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
 Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
  Механизм,
  ПараметрыВыполненияДляСбораСтатистики.Хранилище,
  ПараметрыВыполненияДляСбораСтатистики.Описание);
  
 ПараметрыСессии = Новый Структура;
 ПараметрыСессии.Вставить("Механизм",     Механизм);
 ПараметрыСессии.Вставить("Сессия",        Сессия);
 ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
 ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
  
 Возврат ПараметрыСессии;
 
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
 
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
 
 РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
  ПараметрыСессии.Механизм,
  ПараметрыСессии.Сессия,,
  ПараметрыСессии.ДопПараметры,
  ПараметрыСессии.ТекстОшибки);
 
КонецПроцедуры

#КонецОбласти
