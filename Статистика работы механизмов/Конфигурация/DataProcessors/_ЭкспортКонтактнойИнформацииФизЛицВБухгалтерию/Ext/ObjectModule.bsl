Функция КонтактнаяИнформацияФизиковВыгруженаВБухгалтерию(Результат = Неопределено) Экспорт
	
	Период = ТекущаяДата();
	
	Если Результат <> Неопределено Тогда 
		Результат.Очистить();
		
		Макет = ПолучитьМакет("РасхожденияСБухгалтерией");
		
		ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	КонецЕсли;
	
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(ЭтотОбъект.Организация);
	Если Бухгалтерия = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка подключения к бухгалтерской базе!"); 
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail КАК ЕМайл,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ТелефонДляОповещения КАК Телефон,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодМатрикс
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(&Период, ) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КодыВоВнешнихСистемахСрезПоследних.Объект
		|			И (КодыВоВнешнихСистемахСрезПоследних.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих))
		|			И (КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|ГДЕ
		|	((ПОДСТРОКА(РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail, 1, 1) <> """"
		|		И ПОДСТРОКА(РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail, 2, 1) <> ""@"")
		|			ИЛИ ПОДСТРОКА(РеквизитыФизическихЛицАнкетныеСрезПоследних.ТелефонДляОповещения, 1, 1) <> """")";
	
	Запрос.УстановитьПараметр("Организация"	, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период"		, Период);
	
	КодыМатрикс = Новый Соответствие;
	
	КвалификаторСтроки	= Бухгалтерия.NewObject("КвалификаторыСтроки", "100");
	ОписаниеТипов		= Бухгалтерия.NewObject("ОписаниеТипов", "Строка", КвалификаторСтроки);
	
	КонтактнаяИнформация = Бухгалтерия.NewObject("ТаблицаЗначений");
	КонтактнаяИнформация.Колонки.Добавить("Представление"	, ОписаниеТипов);
	КонтактнаяИнформация.Колонки.Добавить("КодМатрикс"		, ОписаниеТипов);
	КонтактнаяИнформация.Колонки.Добавить("ЕМайл"			, ОписаниеТипов);
	КонтактнаяИнформация.Колонки.Добавить("Телефон"			, ОписаниеТипов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрокаКонтактнойИнформации = КонтактнаяИнформация.Добавить();
		
		НоваяСтрокаКонтактнойИнформации.Представление	= Строка(Выборка.ЮрФизЛицо);
		НоваяСтрокаКонтактнойИнформации.КодМатрикс		= Выборка.КодМатрикс;
		НоваяСтрокаКонтактнойИнформации.ЕМайл			= ?(Сред(Выборка.ЕМайл, 2, 1) = "@" ИЛИ Найти(Выборка.ЕМайл, "@") = 0, "", Выборка.ЕМайл);
		НоваяСтрокаКонтактнойИнформации.Телефон			= Выборка.Телефон;
		
		КодыМатрикс.Вставить(Выборка.КодМатрикс, Выборка.ЮрФизЛицо);
	КонецЦикла;
	
	ЗапросБух = Бухгалтерия.NewObject("Запрос");
	ЗапросБух.УстановитьПараметр("Период"					, Период);
	ЗапросБух.УстановитьПараметр("КонтактнаяИнформацияУФО"	, КонтактнаяИнформация);
	
	ЗапросБух.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(_КонтактнаяИнформация.Представление КАК СТРОКА(100)) КАК Представление,
		|	ВЫРАЗИТЬ(_КонтактнаяИнформация.КодМатрикс КАК СТРОКА(100)) КАК КодМатрикс,
		|	ВЫРАЗИТЬ(_КонтактнаяИнформация.ЕМайл КАК СТРОКА(250)) КАК ЕМайл,
		|	ВЫРАЗИТЬ(_КонтактнаяИнформация.Телефон КАК СТРОКА(250)) КАК Телефон
		|ПОМЕСТИТЬ _КонтактнаяИнформацияУФО
		|ИЗ
		|	&КонтактнаяИнформацияУФО КАК _КонтактнаяИнформация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
