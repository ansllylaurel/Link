
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Экспорт контактной информации физ. лиц в Бухгалтерию",
		"0.08",
		"",
		Истина,
		"");
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортКонтактнойИнформации", "Экспорт контактной информации",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = Неопределено;
	Если НЕ ПараметрыОбработки.Свойство("ПараметрыКоманды", ПараметрыКоманды) Тогда
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);	
		
	Если ИдентификаторКоманды = "ЭкспортКонтактнойИнформации" Тогда
		Если ПараметрыКоманды.Свойство("МассивАнкет") Тогда
			МассивАнкет = ПараметрыКоманды.МассивАнкет;
		Иначе
			МассивАнкет = Новый Массив;
			МассивАнкет.Добавить(ПараметрыКоманды.АнкетаФизическогоЛица);
		КонецЕсли;
		
		ЭкспортКонтактнойИнформации(МассивАнкет);
		
		ОповеститьОбОшибках();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьМетод(ИдентификаторКоманды, Экземпляры) Экспорт
	
	Если ИдентификаторКоманды = "ЭкспортКонтактнойИнформации" Тогда
		
		МассивАнкет = Новый Массив;

		Для Каждого ТекЭкземпляр Из Экземпляры Цикл
			МассивАнкет.Добавить(ТекЭкземпляр.Параметры.АнкетаФизическогоЛица);
		КонецЦикла;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	АнкетаФизическогоЛица.Организация КАК Организация,
			|	АнкетаФизическогоЛица.Ссылка КАК Анкета
			|ИЗ
			|	Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
			|ГДЕ
			|	АнкетаФизическогоЛица.Ссылка В(&МассивАнкет)
			|ИТОГИ ПО
			|	Организация";
		
		Запрос.УстановитьПараметр("МассивАнкет", МассивАнкет);
		
		ВыборкаОрганизаций = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОрганизаций.Следующий() Цикл
			
			ЕстьОшибки = Ложь;
			ТекстОшибки = "";
			
			ЭтотОбъект.Организация = ВыборкаОрганизаций.Организация;
			
			МассивАнкетОрганизации = Новый Массив;
			
			Выборка = ВыборкаОрганизаций.Выбрать();
			Пока Выборка.Следующий() Цикл
				МассивАнкетОрганизации.Добавить(Выборка.Анкета);
			КонецЦикла;
		
			ЭкспортКонтактнойИнформации(МассивАнкетОрганизации, ЕстьОшибки, ТекстОшибки);
			
			Для Каждого ТекЭкземпляр Из Экземпляры Цикл
				Если МассивАнкетОрганизации.Найти(ТекЭкземпляр.Параметры.АнкетаФизическогоЛица) <> Неопределено Тогда
					РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ТекЭкземпляр.Идентификатор, ЕстьОшибки, ТекстОшибки);
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспортКонтактнойИнформации(МассивАнкет, ЕстьОшибки = Ложь, ТекстОшибки = "") Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	Если МассивАнкет.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивДанных = ПолучитьКонтакнуюИнформацию(МассивАнкет);
	
	ЭкспортДанных(МассивДанных, ЕстьОшибки, ТекстОшибки);
	
КонецПроцедуры

Функция ПолучитьКонтакнуюИнформацию(МассивАнкет)
	
	МассивДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АнкетаФизическогоЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК IDMX,
		|	АнкетаФизическогоЛица.EMail КАК Email,
		|	АнкетаФизическогоЛица.ТелефонДляОповещения КАК Phone
		|ИЗ
		|	Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО АнкетаФизическогоЛица.ЮрФизЛицо = КодыВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	АнкетаФизическогоЛица.Ссылка В(&МассивАнкет)
		|	И (АнкетаФизическогоЛица.EMail <> """"
		|			ИЛИ АнкетаФизическогоЛица.ТелефонДляОповещения <> """")";
	
	Запрос.УстановитьПараметр("МассивАнкет"	, МассивАнкет);
	Запрос.УстановитьПараметр("Период"		, ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.IDMX) Тогда
			ЗарегистрироватьОшибку("Для физ. лица '" + Выборка.ЮрФизЛицо + "' не задан код матрикс");	
			Продолжить;
		КонецЕсли;
		
		ЭлементДанных = Новый Структура("IDMX, Email, Phone");	
		ЭлементДанных.IDMX = Выборка.IDMX;
		
		Если ЗначениеЗаполнено(Выборка.Phone) И РаботаСКонтактнойИнформациейКлиентСервер.ПроверкаТелефонаДляОповещения(Выборка.Phone, "") Тогда
			ЭлементДанных.Phone = Выборка.Phone;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Email) И Сред(Выборка.Email, 2, 1) <> "@" Тогда //если второй символ @, то в поле будет что-то вроде "-@mail.ru"
			ЭлементДанных.Email = Выборка.Email;
		КонецЕсли;
		
		МассивДанных.Добавить(ЭлементДанных);	
		
	КонецЦикла;
	
	Возврат МассивДанных;
	
КонецФункции

Процедура ЭкспортДанных(МассивДанных, ЕстьОшибки, ТекстОшибки)
	
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(ЭтотОбъект.Организация);
	Если Бухгалтерия = Неопределено Тогда
		ТекстОшибки = "Ошибка подключения к бухгалтерской базе! "; 
		ЗарегистрироватьОшибку(ТекстОшибки);
		ЕстьОшибки = Истина;
		Возврат;
	КонецЕсли;
	
	МассивCOM = Бухгалтерия.NewObject("Массив");
	Для Каждого ЭлементДанных Из МассивДанных Цикл
		МассивCOM.Добавить(ЭлементДанных);
	КонецЦикла;
	
	Если НЕ Бухгалтерия.Region_ОбщегоНазначения.ПринятьДанныеКонтрагентов(МассивCOM, ТекстОшибки) Тогда
		ЕстьОшибки = Истина;
		ЗарегистрироватьОшибку(ТекстОшибки);
	КонецЕсли;
	
	Бухгалтерия = "";
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках()
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = СтрСоединить(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры // ОповеститьОбОшибках

