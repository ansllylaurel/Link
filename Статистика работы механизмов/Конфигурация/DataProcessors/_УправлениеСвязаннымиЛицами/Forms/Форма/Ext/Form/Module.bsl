
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступноРедактированиеСписков = (РольДоступна("ПолныеПрава") Или РольДоступна("КонтрольУправляющихКомпаний"));
	НастроитьДоступностьРедактированияСписков();
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Организация, "ЮрФизЛицо");
	ЭтаФорма.КодМатрихОрганизации = ПолучитьКодМатрих(ЭтаФорма.ЮрЛицоОрганизации);
		
	ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	Элементы.Организация.Видимость = ЭтоПолноправныйПользователь;
	Элементы.ОрганизацияГиперссылка.Видимость = Не ЭтоПолноправныйПользователь;
	Элементы.СтраницаОбновлениеСписков.Видимость = ЭтоПолноправныйПользователь;
	Элементы.КомандаИмпортироватьСвязанныеЛицаИнфинитум.Видимость = ЭтоПолноправныйПользователь;
		
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);	
	
	ЭтаФорма.НаправлениеСортировки = "Убыв";
	ЭтаФорма.ПоисковыйЗапрос = "";
	ЭтаФорма.РежимПоиска = 1;
	ЭтаФорма.ДатаАктуальности = ТекущаяДатаСеанса();
	ЭтаФорма.ДатаАктуальностиСпискаСвязанных1С = ЭтаФорма.ДатаАктуальности;
	
	ЭтаФорма.СвязанныеЛицаИнфинитум.Параметры.УстановитьЗначениеПараметра("Организация", ЭтаФорма.Организация);
		
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ЮрФизЛицоПриИзменении(Элемент)
	ЮрФизЛицоПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатыСписковПриАктивизацииСтроки(Элемент)
	
	ТекСписок = Элементы.ДатыСписков.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ЭтаФорма.КодМатрихЮрЛица) 
			И ЗначениеЗаполнено(ЭтаФорма.КодМатрихОрганизации) 
			И ТекСписок <> Неопределено 
			И ЗначениеЗаполнено(ТекСписок.ДатаСведений) Тогда
			
		СформироватьОтчетНаСервере(ТекСписок.ДатаСведений);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатыСписковПередНачаломИзменения(Элемент, Отказ)
	
	ТекСтрока = Элементы.ДатыСписков.ТекущиеДанные;
	Отказ = Не ТекСтрока.ДобавленоВручную;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатыСписковПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элементы.ДатыСписков.ТекущиеДанные;
	Отказ = Не ТекСтрока.ДобавленоВручную;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатыСписковПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Не (ЗначениеЗаполнено(ЭтаФорма.Организация) И ЗначениеЗаполнено(ЭтаФорма.ЮрФизЛицо)) Тогда
		Возврат;
	КонецЕсли; 
	
	НоваяДата = ТекущаяДата();
	Если ВвестиДату(НоваяДата, "Введите дату списка", ЧастиДаты.Дата) Тогда
		
		Если ДобавитьНовуюДатуСпискаСвязанных(НоваяДата) Тогда
		
			КомандаИмпортировать(Неопределено);
		
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда 
		
		СтандартнаяОбработка = Ложь;
		Значение = ПолучитьЗначениеРасшифровки(ЭтаФорма.АдресДанныхРасшифровки, Расшифровка);
		ПростыеТипы = Новый ОписаниеТипов("Строка, Число, Дата, Булево, Неопределено");
		Если ЗначениеЗаполнено(Значение) И Не ПростыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
			
			ОткрытьЗначение(Значение);
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПоисковогоЗапросаПриИзменении(Элемент)
	
	Если ЭтаФорма.ТипПоисковогоЗапроса = 0 Тогда
		ЭтаФорма.ПоисковыйЗапрос = "";
	ИначеЕсли ЭтаФорма.ТипПоисковогоЗапроса = 1 Тогда
		ЭтаФорма.ПоисковыйЗапрос = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "НЕАКТУАЛЬНОСТЬ");
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПоискаПриИзменении(Элемент)
	Элементы.ДатаАктуальности.Видимость = (РежимПоиска = 1);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "НЕАКТУАЛЬНОСТЬ");
КонецПроцедуры

&НаКлиенте
Процедура НайденныеСвязанныеЛицаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда 
		
		СтандартнаяОбработка = Ложь;
		Значение = ПолучитьЗначениеРасшифровки(ЭтаФорма.АдресДанныхРасшифровкиРезультатыПоиска, Расшифровка);
		ПростыеТипы = Новый ОписаниеТипов("Строка, Число, Дата, Булево, Неопределено");
		Если ЗначениеЗаполнено(Значение) И Не ПростыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
			
			ОткрытьЗначение(Значение);
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоисковыйЗапросПриИзменении(Элемент)
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "НЕАКТУАЛЬНОСТЬ");
КонецПроцедуры

&НаКлиенте
Процедура ДатаАктуальностиПриИзменении(Элемент)
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "НЕАКТУАЛЬНОСТЬ");
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраСпискаСвязанных1СПриИзменении(Элемент)
	
	Элементы.ДатаАктуальностиСпискаСвязанных1С.Видимость = (ЭтаФорма.РежимПросмотраСпискаСвязанных1С = 1);
	ЗаполнитьСвязанныеЛица1СНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаАктуальностиСпискаСвязанных1СПриИзменении(Элемент)
	
	ЗаполнитьСвязанныеЛица1СНаСервере();
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаОбновитьСпискиСвязанныхЛиц(Команда)
	
	ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
	ПараметрыВызова.Организация = ЭтаФорма.Организация;
	ПараметрыВызова.ЮрФизЛицо = ЭтаФорма.ЮрФизЛицо;
	
	ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьВсеСписки(Команда)
	
	ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
	
	ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСвязанноеЛицо(Команда)
	
	ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
	ПараметрыВызова.СвязанноеЛицо = ЭтаФорма.ЮрФизЛицо;
	
	ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	ОткрытьФормуИмпорта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИмпорта(ИмпортируемыеДанные = Неопределено)

	ТекСписок = Элементы.ДатыСписков.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ЭтаФорма.КодМатрихЮрЛица) 
		И ЗначениеЗаполнено(ЭтаФорма.КодМатрихОрганизации) 
		И ТекСписок <> Неопределено 
		И ЗначениеЗаполнено(ТекСписок.ДатаСведений) Тогда
			
		ПараметрыФормы = Новый Структура("КодМатрихОрганизации,КодМатрихЮрЛица,Организация,ЮрЛицоОрганизации,ЮрФизЛицо");
		ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтаФорма);
		ПараметрыФормы.Вставить("ДатаСведений", ТекСписок.ДатаСведений);
		ПараметрыФормы.Вставить("ИмпортируемыеДанные", ИмпортируемыеДанные);
		Результат = ОткрытьФормуМодально("ВнешняяОбработка._УправлениеСвязаннымиЛицами.Форма.ФормаИмпортаСписка", ПараметрыФормы);
		
		Если ТипЗнч(Результат) = Тип("Строка") Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат);
			
		ИначеЕсли Результат = Истина Тогда
			
			ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
			ПараметрыВызова.Организация = ЭтаФорма.Организация;
			ПараметрыВызова.ЮрФизЛицо = ЭтаФорма.ЮрФизЛицо;
			
			ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
			
			ЗаполнитьДатыСписковНаСервере();
				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортИзXML(Команда)
		
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		
		Файл = Новый Файл(ДиалогВыбораКаталога.ПолноеИмяФайла);
		АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ДиалогВыбораКаталога.ПолноеИмяФайла), ЭтаФорма.УникальныйИдентификатор);
		Результат = ПрочитатьФайлXML(АдресФайла, ДиалогВыбораКаталога.ПолноеИмяФайла);
		
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат, "ЮрФизЛицо, КодМатрихЮрЛица");
			ЗаполнитьДатыСписковНаСервере();
			
			//ДобавитьНовуюДатуСпискаСвязанных(Результат.ДатаСведений);
			ДобавитьНовуюДатуСпискаСвязанных(Файл.ПолучитьВремяИзменения());
			
			ОткрытьФормуИмпорта(Результат.ИмпортируемыеДанные);
			
		ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
			
			Предупреждение(Результат, "Ошибка импорта");
			
		Иначе
			
			Предупреждение("Непредвиденная ошибка импорта файла", "Ошибка импорта");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСортироватьСписокДатПоВозрастанию(Команда)
	ЭтаФорма.НаправлениеСортировки = "Возр";
	ЭтаФорма.ДатыСписков.Сортировать("ДатаСведений " + ЭтаФорма.НаправлениеСортировки);
КонецПроцедуры

&НаКлиенте
Процедура КомандаСортироватьСписокДатПоУбыванию(Команда)
	ЭтаФорма.НаправлениеСортировки = "Убыв";
	ЭтаФорма.ДатыСписков.Сортировать("ДатаСведений " + ЭтаФорма.НаправлениеСортировки);
КонецПроцедуры

&НаКлиенте
Процедура КомандаНайти(Команда)
	Если ЗначениеЗаполнено(ЭтаФорма.ПоисковыйЗапрос) Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "ФОРМИРОВАНИЕОТЧЕТА");
		КомандаНайтиНаСервере();
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.НайденныеСвязанныеЛица, "НЕИСПОЛЬЗОВАТЬ");
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьСписок(Команда)
	
	ТекущийСписок = Элементы.ДатыСписков.ТекущиеДанные;
	
	Если ТекущийСписок <> Неопределено И ЗначениеЗаполнено(ТекущийСписок.ДатаСведений) Тогда
		
		ДатаСведений = ТекущийСписок.ДатаСведений;
		ТекстВопроса = "Внимание! Будут удалены все данные списка за " + Формат(ДатаСведений, "ДФ=dd.MM.yyyy");
		
		Если Не ТекущийСписок.ДобавленоВручную И Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			
			УдалитьСписокНаСервере(ДатаСведений);
			ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
			ПараметрыВызова.Организация = ЭтаФорма.Организация;
			ПараметрыВызова.ЮрФизЛицо = ЭтаФорма.ЮрФизЛицо;
				
			ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
			ЗаполнитьДатыСписковНаСервере();
			
		ИначеЕсли ТекущийСписок.ДобавленоВручную Тогда
			ЭтаФорма.ДатыСписков.Удалить(ТекущийСписок);
		КонецЕсли; 
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСравнитьСписки(Команда)
	
	ВыделенныеСтроки = Элементы.ДатыСписков.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 2 Тогда
		
		ПерваяДата = ЭтаФорма.ДатыСписков.НайтиПоИдентификатору(ВыделенныеСтроки[0]).ДатаСведений;
		ВтораяДата = ЭтаФорма.ДатыСписков.НайтиПоИдентификатору(ВыделенныеСтроки[1]).ДатаСведений;
		
		БолееРанняяДата = ?(ПерваяДата < ВтораяДата, ПерваяДата, ВтораяДата);
		БолееПоздняяДата = ?(ВтораяДата < ПерваяДата, ПерваяДата, ВтораяДата);
		
		ОтчетОСравнении = СравнитьСпискиНаСервере(БолееРанняяДата, БолееПоздняяДата);
		
		ОтчетОСравнении.Показать(СтрШаблон("Отличия списков связанных лиц %1 от %2 и %3", ЭтаФорма.ЮрФизЛицо, Формат(БолееРанняяДата, "ДФ=dd.MM.yyyy"), Формат(БолееПоздняяДата, "ДФ=dd.MM.yyyy")));
	Иначе
		ПоказатьПредупреждение(, "Для сравнения необходимо выделить две даты");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Импорт_из_Externals

&НаСервере
Процедура ИмпортироватьСведенияОСвязанныхЛицах(ПараметрыВызова)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ОбработкаНаСервере.ИмпортироватьСведенияОСвязанныхЛицах(
		ПараметрыВызова.Организация,
		ПараметрыВызова.ЮрФизЛицо, 
		ПараметрыВызова.СвязанноеЛицо,
		ПараметрыВызова.Отчет);
		
	ЗаполнитьСвязанныеЛица1СНаСервере();
		
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруПараметровВызова()

	Возврат Новый Структура("Организация, ЮрФизЛицо, СвязанноеЛицо");
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова)

	Отчет = Новый ТабличныйДокумент;
	ПараметрыВызова.Вставить("Отчет", Отчет);
	
	ИмпортироватьСведенияОСвязанныхЛицах(ПараметрыВызова);
	
	Если ТипЗнч(ПараметрыВызова.Отчет) = Тип("ТабличныйДокумент") Тогда
		ПараметрыВызова.Отчет.Показать("Отчет об обновлении списков связанных лиц");
	Иначе
		Предупреждение("Не удалось обновить данные о связанных лицах в 1С", , "Ошибка обновления");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ПолучитьКодМатрих(ЮрФизЛицо)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаНаСервере.ПолучитьКодМатрих(ЮрФизЛицо);

КонецФункции

&НаСервере
Процедура ЮрФизЛицоПриИзмененииНаСервере()

	ЭтаФорма.КодМатрихЮрЛица = ПолучитьКодМатрих(ЭтаФорма.ЮрФизЛицо);
	
	ЗаполнитьДатыСписковНаСервере();
	ЗаполнитьСвязанныеЛица1СНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()

	ЭтаФорма.ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Организация, "ЮрФизЛицо");
	ЭтаФорма.КодМатрихОрганизации = ПолучитьКодМатрих(ЭтаФорма.ЮрЛицоОрганизации);
	ЗаполнитьДатыСписковНаСервере();
	ЗаполнитьСвязанныеЛица1СНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатыСписковНаСервере()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	dbo_Related_Companies.date КАК ДатаСведений
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
		|ГДЕ
		|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
		|	И dbo_Related_Companies.matrix_firm_id = &matrix_firm_id
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСведений Убыв";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("matrix_organization_id", ЭтаФорма.КодМатрихОрганизации);
	Запрос.УстановитьПараметр("matrix_firm_id", ЭтаФорма.КодМатрихЮрЛица);
	
	Результат = Запрос.Выполнить();
	
	ЭтаФорма.ДатыСписков.Загрузить(Результат.Выгрузить()); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвязанныеЛица1СНаСервере() 

	#Область Текст_запроса
	Если ЭтаФорма.РежимПросмотраСпискаСвязанных1С = 0 Тогда
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеЛицаНачалоПериода.СвязанноеЮрФизЛицо КАК СвязанноеЛицо,
			|	СвязанныеЛицаНачалоПериода.ТипСвязи КАК ТипСвязи,
			|	СвязанныеЛицаНачалоПериода.Период КАК НачалоПериода,
			|	МИНИМУМ(СвязанныеЛицаОкончаниеПериода.Период) КАК ОкончаниеПериода
			|ПОМЕСТИТЬ _СписокСвязанныхЛиц
			|ИЗ
			|	РегистрСведений.СвязанныеЛица КАК СвязанныеЛицаНачалоПериода
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица КАК СвязанныеЛицаОкончаниеПериода
			|		ПО СвязанныеЛицаНачалоПериода.Организация = СвязанныеЛицаОкончаниеПериода.Организация
			|			И СвязанныеЛицаНачалоПериода.ЮрФизЛицо = СвязанныеЛицаОкончаниеПериода.ЮрФизЛицо
			|			И СвязанныеЛицаНачалоПериода.ТипСвязи = СвязанныеЛицаОкончаниеПериода.ТипСвязи
			|			И СвязанныеЛицаНачалоПериода.СвязанноеЮрФизЛицо = СвязанныеЛицаОкончаниеПериода.СвязанноеЮрФизЛицо
			|			И (НЕ СвязанныеЛицаОкончаниеПериода.Действует)
			|			И СвязанныеЛицаНачалоПериода.Период < СвязанныеЛицаОкончаниеПериода.Период
			|ГДЕ
			|	СвязанныеЛицаНачалоПериода.Действует
			|	И СвязанныеЛицаНачалоПериода.Организация = &Организация
			|	И СвязанныеЛицаНачалоПериода.ЮрФизЛицо = &ЮрФизЛицо
			|	И СвязанныеЛицаНачалоПериода.ТипСвязи.КонтрольПоУказанию5343У
			|	И НЕ СвязанныеЛицаНачалоПериода.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)
			|
			|СГРУППИРОВАТЬ ПО
			|	СвязанныеЛицаНачалоПериода.СвязанноеЮрФизЛицо,
			|	СвязанныеЛицаНачалоПериода.Период,
			|	СвязанныеЛицаНачалоПериода.ТипСвязи";
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеЛицаСрезПоследних.СвязанноеЮрФизЛицо КАК СвязанноеЛицо,
			|	СвязанныеЛицаСрезПоследних.ТипСвязи КАК ТипСвязи,
			|	СвязанныеЛицаСрезПоследних.Период КАК НачалоПериода,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ОкончаниеПериода
			|ПОМЕСТИТЬ _СписокСвязанныхЛиц
			|ИЗ
			|	РегистрСведений.СвязанныеЛица.СрезПоследних(
			|			&ДатаАктуальностиСпискаСвязанных1С,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И ТипСвязи.КонтрольПоУказанию5343У
			|				И НЕ ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)) КАК СвязанныеЛицаСрезПоследних
			|ГДЕ
			|	СвязанныеЛицаСрезПоследних.Действует";
		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СписокСвязанныхЛиц.СвязанноеЛицо КАК СвязанноеЛицо,
		|	_СписокСвязанныхЛиц.ТипСвязи КАК ТипСвязи,
		|	_СписокСвязанныхЛиц.НачалоПериода КАК НачалоПериода,
		|	_СписокСвязанныхЛиц.ОкончаниеПериода КАК ОкончаниеПериода,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН,
		|	РеквизитыЮридическихЛицСрезПоследних.TIN КАК TIN
		|ИЗ
		|	_СписокСвязанныхЛиц КАК _СписокСвязанныхЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _СписокСвязанныхЛиц.СвязанноеЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ВИД = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО _СписокСвязанныхЛиц.СвязанноеЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	_СписокСвязанныхЛиц.СвязанноеЛицо,
		|	_СписокСвязанныхЛиц.НачалоПериода
		|АВТОУПОРЯДОЧИВАНИЕ";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтаФорма.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ДатаАктуальностиСпискаСвязанных1С", ЭтаФорма.ДатаАктуальностиСпискаСвязанных1С);
	
	ЭтаФорма.СвязанныеЛица.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Элементы.СтраницаСвязанныеЛица.Заголовок = "Связанные лица 1С";
	Если ЭтаФорма.СвязанныеЛица.Количество() > 0 Тогда
		Элементы.СтраницаСвязанныеЛица.Заголовок = Элементы.СтраницаСвязанныеЛица.Заголовок + " (" + ЭтаФорма.СвязанныеЛица.Количество() + ")";
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРедактированияСписков()

	Элементы.ДатыСписковКомандаИмпортировать.Видимость = ДоступноРедактированиеСписков;
	Элементы.ТабличныйДокументКомандаУдалитьСписок.Видимость = ДоступноРедактированиеСписков;
	Элементы.ДатыСписков.ИзменятьСоставСтрок = ДоступноРедактированиеСписков;

КонецПроцедуры

&НаКлиенте
Функция ДобавитьНовуюДатуСпискаСвязанных(НоваяДата) 

	НайденныеСтроки = ЭтаФорма.ДатыСписков.НайтиСтроки(Новый Структура("ДатаСведений", НоваяДата));
		
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		СтрокаДобавлена = Ложь;
		ТекСтрока = НайденныеСтроки[0];
		
	Иначе
		
		СтрокаДобавлена = Истина;
		ТекСтрока = ЭтаФорма.ДатыСписков.Добавить();
		ТекСтрока.ДатаСведений = НоваяДата;
		ТекСтрока.ДобавленоВручную = Истина;
		ЭтаФорма.ДатыСписков.Сортировать("ДатаСведений " + ЭтаФорма.НаправлениеСортировки);
	
	КонецЕсли; 
	
	Элементы.ДатыСписков.ТекущаяСтрока = ТекСтрока.ПолучитьИдентификатор();
	
	Возврат СтрокаДобавлена;

КонецФункции

#КонецОбласти 

#Область Просмотр_данных_Externals

&НаСервере
Процедура СформироватьОтчетНаСервере(ДатаСведений)

	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	dbo_Related_Companies.date КАК date,
		|	dbo_Related_Companies.INN КАК INN,
		|	dbo_Related_Companies.OGRN КАК OGRN,
		|	dbo_Related_Companies.name КАК name,
		|	dbo_Related_Companies.date_from КАК date_from,
		|	dbo_Related_Companies.date_basement КАК date_basement,
		|	dbo_Related_Companies.relation КАК relation,
		|	dbo_Related_Companies.comment КАК comment,
		|	dbo_Related_Companies.id КАК id
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
		|ГДЕ
		|	dbo_Related_Companies.matrix_firm_id = &matrix_firm_id
		|	И dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
		|	И dbo_Related_Companies.date = &date";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("matrix_firm_id", ЭтаФорма.КодМатрихЮрЛица);
	Запрос.УстановитьПараметр("matrix_organization_id", ЭтаФорма.КодМатрихОрганизации);
	Запрос.УстановитьПараметр("date", ДатаСведений);
	
	Попытка
		ТаблицаСвязанныхЛиц = Запрос.Выполнить().Выгрузить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выполнить запрос к базе Extenals. Система сообщает: " + Символы.ПС + ОписаниеОшибки()); 
		Возврат;
	КонецПопытки; 
			 
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСвязанныхЛиц.date КАК date,
		|	ВЫБОР
		|		КОГДА ТаблицаСвязанныхЛиц.INN В (&ПустыеЗначенияКодов)
		|			ТОГДА """"
		|		ИНАЧЕ ТаблицаСвязанныхЛиц.INN
		|	КОНЕЦ КАК INN,
		|	ВЫБОР
		|		КОГДА ТаблицаСвязанныхЛиц.OGRN В (&ПустыеЗначенияКодов)
		|			ТОГДА """"
		|		ИНАЧЕ ТаблицаСвязанныхЛиц.OGRN
		|	КОНЕЦ КАК OGRN,
		|	ТаблицаСвязанныхЛиц.INN КАК ИНН,
		|	ТаблицаСвязанныхЛиц.OGRN КАК ОГРН,
		|	ТаблицаСвязанныхЛиц.name КАК name,
		|	ТаблицаСвязанныхЛиц.date_from КАК date_from,
		|	ТаблицаСвязанныхЛиц.date_basement КАК date_basement,
		|	ТаблицаСвязанныхЛиц.relation КАК relation,
		|	ТаблицаСвязанныхЛиц.comment КАК comment,
		|	ТаблицаСвязанныхЛиц.id КАК id
		|ПОМЕСТИТЬ _ТаблицаСвязанныхЛиц
		|ИЗ
		|	&ТаблицаСвязанныхЛиц КАК ТаблицаСвязанныхЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЛица1С.СвязанноеЛицо КАК СвязанноеЛицо,
		|	СвязанныеЛица1С.НачалоПериода КАК НачалоПериода,
		|	СвязанныеЛица1С.ОкончаниеПериода КАК ОкончаниеПериода,
		|	СвязанныеЛица1С.ТипСвязи КАК ТипСвязи,
		|	СвязанныеЛица1С.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	СвязанныеЛица1С.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	СвязанныеЛица1С.СокращенноеНаименование КАК СокращенноеНаименование,
		|	СвязанныеЛица1С.ИНН КАК ИНН,
		|	СвязанныеЛица1С.ОГРН КАК ОГРН,
		|	СвязанныеЛица1С.TIN КАК TIN,
		|	СвязанныеЛица1С.КраткоеНаименованиеПоУставу + СвязанныеЛица1С.ПолноеНаименованиеПоУставу + СвязанныеЛица1С.СокращенноеНаименование КАК Наименование
		|ПОМЕСТИТЬ _СвязанныеЛица1С
		|ИЗ
		|	&СвязанныеЛица1С КАК СвязанныеЛица1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаСвязанныхЛиц.ИНН КАК ИНН,
		|	_ТаблицаСвязанныхЛиц.ОГРН КАК ОГРН,
		|	_ТаблицаСвязанныхЛиц.name КАК Наименование,
		|	_ТаблицаСвязанныхЛиц.date_from КАК ДатаВключения,
		|	_ТаблицаСвязанныхЛиц.date_basement КАК ДатаОснования,
		|	_ТаблицаСвязанныхЛиц.relation КАК ТипСвязи,
		|	_ТаблицаСвязанныхЛиц.comment КАК Комментарий,
		|	_СвязанныеЛица1С.СвязанноеЛицо КАК СвязанноеЛицо1С
		|ПОМЕСТИТЬ _СписокСвязанныхЛиц
		|ИЗ
		|	_ТаблицаСвязанныхЛиц КАК _ТаблицаСвязанныхЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СвязанныеЛица1С КАК _СвязанныеЛица1С
		|		ПО (_ТаблицаСвязанныхЛиц.INN <> _ТаблицаСвязанныхЛиц.OGRN
		|					И (_СвязанныеЛица1С.ИНН = _ТаблицаСвязанныхЛиц.INN
		|							И _СвязанныеЛица1С.ОГРН = _ТаблицаСвязанныхЛиц.OGRN
		|						ИЛИ _ТаблицаСвязанныхЛиц.INN <> """"
		|							И (_СвязанныеЛица1С.ИНН = _ТаблицаСвязанныхЛиц.INN
		|								ИЛИ _СвязанныеЛица1С.TIN = _ТаблицаСвязанныхЛиц.INN)
		|						ИЛИ _ТаблицаСвязанныхЛиц.OGRN <> """"
		|							И (_СвязанныеЛица1С.ОГРН = _ТаблицаСвязанныхЛиц.OGRN
		|								ИЛИ _СвязанныеЛица1С.TIN = _ТаблицаСвязанныхЛиц.OGRN))
		|				ИЛИ _ТаблицаСвязанныхЛиц.INN = _ТаблицаСвязанныхЛиц.OGRN
		|					И _ТаблицаСвязанныхЛиц.name <> """"
		|					И _СвязанныеЛица1С.Наименование ПОДОБНО ""%"" + _ТаблицаСвязанныхЛиц.name + ""%"")";		
	#КонецОбласти 
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ПустыеЗначенияКодов = Обработка.ПустыеЗначенияКодов();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаСвязанныхЛиц", 	ТаблицаСвязанныхЛиц);
	Запрос.УстановитьПараметр("СвязанныеЛица1С", 		ЭтаФорма.СвязанныеЛица.Выгрузить());
	Запрос.УстановитьПараметр("ПустыеЗначенияКодов", 	ПустыеЗначенияКодов);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Результат = Запрос.Выполнить();
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, , "_СписокСвязанныхЛиц");
	
	Обработка = РеквизитФормыВЗначение("Объект");
	СКД = Обработка.ПолучитьМакет("СписокСвязанныхЛиц");
	
	Если Ложь Тогда
	
		СКД = Новый СхемаКомпоновкиДанных;
	
	КонецЕсли; 
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокумент, "ФОРМИРОВАНИЕОТЧЕТА");
	
	Настройки = СКД.НастройкиПоУмолчанию;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СвязанныеЛицаОрганизации", ЭтаФорма.ЮрЛицоОрганизации = ЭтаФорма.ЮрФизЛицо);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки, Истина, , Запрос.МенеджерВременныхТаблиц);
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки) Тогда
		ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.АдресДанныхРасшифровки);
	Иначе
		ЭтаФорма.АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 	
	
	Результат = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ЭтаФорма.ТабличныйДокумент = Результат;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокумент, "НЕИСПОЛЬЗОВАТЬ");	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРасшифровки(АдресВХарилище, Расшифровка)

	Значение = ПолучитьИзВременногоХранилища(АдресВХарилище);
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
	    // расшифровка результатов проверки
		ДанныеРасшифровки = Значение.ДанныеРасшифровки;
	Иначе
		// расшифровка отчета по базису
		ДанныеРасшифровки = Значение;
	КонецЕсли; 
	
	Возврат ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля()[0].Значение;

КонецФункции 

&НаСервере
Процедура УдалитьСписокНаСервере(ДатаСведений)

	ТекстЗапроса = 
		"DELETE FROM [Externals].[dbo].[Related_Companies]
		|WHERE [matrix_firm_id] = 'КодМатриксЮрЛица'
		|  AND [matrix_organization_id] = 'КодМатриксОрганизации'
		|  AND [date] = 'ДатаСведений'";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КодМатриксЮрЛица", 		ЭтаФорма.КодМатрихЮрЛица);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КодМатриксОрганизации", 	ЭтаФорма.КодМатрихОрганизации);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДатаСведений", 			Формат(ДатаСведений, "ДФ=yyyy-MM-dd"));
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(Обработка.СтрокаСоединения());
	РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура КомандаНайтиНаСервере()

	Если ЭтаФорма.РежимПоиска = 0 Тогда
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	dbo_Related_Companies.matrix_firm_id КАК matrix_firm_id,
			|	dbo_Related_Companies.date КАК date,
			|	dbo_Related_Companies.date_from КАК date_from,
			|	dbo_Related_Companies.date_basement КАК date_basement,
			|	dbo_Related_Companies.name КАК name,
			|	dbo_Related_Companies.comment КАК comment,
			|	dbo_Related_Companies.INN КАК INN,
			|	dbo_Related_Companies.OGRN КАК OGRN,
			|	dbo_Related_Companies.relation КАК relation
			|ИЗ
			|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
			|ГДЕ
			|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
			|	И (dbo_Related_Companies.name В (&name)
			|			ИЛИ dbo_Related_Companies.name ПОДОБНО ""%"" + &name + ""%""
			|			ИЛИ dbo_Related_Companies.INN = &INN
			|			ИЛИ dbo_Related_Companies.OGRN = &OGRN)";
		
	Иначе
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	dbo_Related_Companies.matrix_organization_id КАК matrix_organization_id,
			|	dbo_Related_Companies.matrix_firm_id КАК matrix_firm_id,
			|	МАКСИМУМ(dbo_Related_Companies.date) КАК date
			|ПОМЕСТИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ДатыСписков
			|ИЗ
			|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
			|ГДЕ
			|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
			|
			|СГРУППИРОВАТЬ ПО
			|	dbo_Related_Companies.matrix_firm_id,
			|	dbo_Related_Companies.matrix_organization_id
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	matrix_organization_id,
			|	matrix_firm_id,
			|	date
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	dbo_Related_Companies.matrix_firm_id КАК matrix_firm_id,
			|	dbo_Related_Companies.date КАК date,
			|	dbo_Related_Companies.date_from КАК date_from,
			|	dbo_Related_Companies.date_basement КАК date_basement,
			|	dbo_Related_Companies.name КАК name,
			|	dbo_Related_Companies.comment КАК comment,
			|	dbo_Related_Companies.INN КАК INN,
			|	dbo_Related_Companies.OGRN КАК OGRN,
			|	dbo_Related_Companies.relation КАК relation
			|ИЗ
			|	ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ДатыСписков КАК ExternalsВременнаяТаблицаДатыСписков
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
			|		ПО ExternalsВременнаяТаблицаДатыСписков.matrix_firm_id = dbo_Related_Companies.matrix_firm_id
			|			И ExternalsВременнаяТаблицаДатыСписков.date = dbo_Related_Companies.date
			|			И ExternalsВременнаяТаблицаДатыСписков.matrix_organization_id = dbo_Related_Companies.matrix_organization_id
			|ГДЕ
			|	(dbo_Related_Companies.name В (&name)
			|			ИЛИ dbo_Related_Companies.name ПОДОБНО ""%"" + &name + ""%""
			|			ИЛИ dbo_Related_Companies.INN = &INN
			|			ИЛИ dbo_Related_Companies.INN = &TIN
			|			ИЛИ dbo_Related_Companies.OGRN = &OGRN)";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("matrix_organization_id", ЭтаФорма.КодМатрихОрганизации);
	
	Если ТипЗнч(ЭтаФорма.ПоисковыйЗапрос) = Тип("Строка") Тогда
		Запрос.УстановитьПараметр("name", ЭтаФорма.ПоисковыйЗапрос);
		Запрос.УстановитьПараметр("INN", ЭтаФорма.ПоисковыйЗапрос);
		Запрос.УстановитьПараметр("TIN", ЭтаФорма.ПоисковыйЗапрос);
		Запрос.УстановитьПараметр("OGRN", ЭтаФорма.ПоисковыйЗапрос);
	Иначе 
		
		Обработка = РеквизитФормыВЗначение("Объект");
		СведенияОСвязанномЛице = Обработка.ПолучитьСведенияОСвязанномЛице(ЭтаФорма.ПоисковыйЗапрос);
		Для каждого Сведение Из СведенияОСвязанномЛице Цикл
		
			СведенияОСвязанномЛице[Сведение.Ключ] = СтрЗаменить(Сведение.Значение, """", """""");
			СведенияОСвязанномЛице[Сведение.Ключ] = СтрЗаменить(Сведение.Значение, "'", "");
		
		КонецЦикла; 
		
		Запрос.УстановитьПараметр("name", СведенияОСвязанномЛице.Наименование);
		Запрос.УстановитьПараметр("INN", СведенияОСвязанномЛице.ИНН);
		Запрос.УстановитьПараметр("TIN", СведенияОСвязанномЛице.TIN);
		Запрос.УстановитьПараметр("OGRN", СведенияОСвязанномЛице.ОГРН);
		
	КонецЕсли; 
	
	ВнешниеДанные = Запрос.Выполнить().Выгрузить();
	
	Запрос.УстановитьПараметр("ВнешниеДанные", ВнешниеДанные);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнешниеДанные.matrix_firm_id КАК КодЮрЛица,
		|	ВнешниеДанные.date КАК ДатаСписка,
		|	ВнешниеДанные.date_from КАК ДатаВключения,
		|	ВнешниеДанные.date_basement КАК ДатаОснования,
		|	ВнешниеДанные.name КАК Наименование,
		|	ВнешниеДанные.comment КАК Комментарий,
		|	ВнешниеДанные.INN КАК ИНН,
		|	ВнешниеДанные.OGRN КАК ОГРН,
		|	ВнешниеДанные.relation КАК ТипСвязи
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК ВнешниеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВнешниеДанные.КодЮрЛица КАК КодЮрЛица,
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК ВладелецСписка
		|ПОМЕСТИТЬ _КодыВоВнешнихСистемах
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _ВнешниеДанные.КодЮрЛица = КодыВоВнешнихСистемахСрезПоследних.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЛицаСрезПоследних.ЮрФизЛицо КАК ИсточникСвязи,
		|	СвязанныеЛицаСрезПоследних.ТипСвязи КАК ТипСвязи,
		|	СвязанныеЛицаСрезПоследних.СвязанноеЮрФизЛицо КАК ВладелецСписка
		|ПОМЕСТИТЬ _ИсполнителиРолей
		|ИЗ
		|	_КодыВоВнешнихСистемах КАК _КодыВоВнешнихСистемах
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица.СрезПоследних(
		|				,
		|				Организация = &Организация
		|					И ТипСвязи В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ИсполнителиРолей))) КАК СвязанныеЛицаСрезПоследних
		|		ПО _КодыВоВнешнихСистемах.ВладелецСписка = СвязанныеЛицаСрезПоследних.СвязанноеЮрФизЛицо
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсполнителиРолей.ИсточникСвязи КАК ИсточникСвязи,
		|	_ИсполнителиРолей.ТипСвязи КАК Роль,
		|	_КодыВоВнешнихСистемах.ВладелецСписка КАК ВладелецСписка,
		|	_ВнешниеДанные.ДатаСписка КАК ДатаСписка,
		|	_ВнешниеДанные.Наименование КАК Наименование,
		|	_ВнешниеДанные.ИНН КАК ИНН,
		|	_ВнешниеДанные.ОГРН КАК ОГРН,
		|	_ВнешниеДанные.ДатаВключения КАК ДатаВключения,
		|	_ВнешниеДанные.ДатаОснования КАК ДатаОснования,
		|	_ВнешниеДанные.Комментарий КАК Комментарий,
		|	_ВнешниеДанные.ТипСвязи КАК ТипСвязи
		|ПОМЕСТИТЬ _РезультатыПоиска
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВоВнешнихСистемах КАК _КодыВоВнешнихСистемах
		|		ПО _ВнешниеДанные.КодЮрЛица = _КодыВоВнешнихСистемах.КодЮрЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИсполнителиРолей КАК _ИсполнителиРолей
		|		ПО (_КодыВоВнешнихСистемах.ВладелецСписка = _ИсполнителиРолей.ВладелецСписка)";
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = Запрос.Выполнить();
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, , "_РезультатыПоиска");
	
	Обработка = РеквизитФормыВЗначение("Объект");
	СКД = Обработка.ПолучитьМакет("РезультатыПоиска");
	
	Если Ложь Тогда
	
		СКД = Новый СхемаКомпоновкиДанных;
	
	КонецЕсли; 
	
	Настройки = СКД.НастройкиПоУмолчанию;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки, Истина, , Запрос.МенеджерВременныхТаблиц);
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровкиРезультатыПоиска) Тогда
		ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.АдресДанныхРасшифровкиРезультатыПоиска);
	Иначе
		ЭтаФорма.АдресДанныхРасшифровкиРезультатыПоиска = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 	
	
	Результат = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ЭтаФорма.РезультатыПоиска = Результат;
	
КонецПроцедуры

&НаСервере
Функция СравнитьСпискиНаСервере(ПерваяДата, ВтораяДата)

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	dbo_Related_Companies.name КАК Наименование,
	|	dbo_Related_Companies.INN КАК ИНН,
	|	dbo_Related_Companies.OGRN КАК ОГРН,
	|	dbo_Related_Companies.date_from КАК ДатаВключения,
	|	dbo_Related_Companies.comment КАК Комментарий,
	|	dbo_Related_Companies.relation КАК ТипСвязи
	|ПОМЕСТИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ПервыйСписок
	|ИЗ
	|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
	|ГДЕ
	|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
	|	И dbo_Related_Companies.matrix_firm_id = &matrix_firm_id
	|	И dbo_Related_Companies.date = &ПерваяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	dbo_Related_Companies.name КАК Наименование,
	|	dbo_Related_Companies.INN КАК ИНН,
	|	dbo_Related_Companies.OGRN КАК ОГРН,
	|	dbo_Related_Companies.date_from КАК ДатаВключения,
	|	dbo_Related_Companies.comment КАК Комментарий,
	|	dbo_Related_Companies.relation КАК ТипСвязи
	|ПОМЕСТИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ВторойСписок
	|ИЗ
	|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
	|ГДЕ
	|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
	|	И dbo_Related_Companies.matrix_firm_id = &matrix_firm_id
	|	И dbo_Related_Companies.date = &ВтораяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ПервыйСписок.Наименование, """") КАК Наименование1,
	|	ЕСТЬNULL(ПервыйСписок.ИНН, ВторойСписок.ИНН) КАК ИНН,
	|	ЕСТЬNULL(ПервыйСписок.ОГРН, ВторойСписок.ОГРН) КАК ОГРН,
	|	ЕСТЬNULL(ПервыйСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВключения1,
	|	ЕСТЬNULL(ПервыйСписок.Комментарий, """") КАК Комментарий1,
	|	ЕСТЬNULL(ПервыйСписок.ТипСвязи, """") КАК ТипСвязи1,
	|	ЕСТЬNULL(ВторойСписок.Наименование, """") КАК Наименование2,
	|	ЕСТЬNULL(ВторойСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВключения2,
	|	ЕСТЬNULL(ВторойСписок.Комментарий, """") КАК Комментарий2,
	|	ЕСТЬNULL(ВторойСписок.ТипСвязи, """") КАК ТипСвязи2,
	|	ВЫБОР
	|		КОГДА ПервыйСписок.Наименование ЕСТЬ NULL
	|			ТОГДА ""Есть только во втором списке""
	|		КОГДА ВторойСписок.Наименование ЕСТЬ NULL
	|			ТОГДА ""Есть только в первом списке""
	|		КОГДА ЕСТЬNULL(ПервыйСписок.Наименование, """") <> ЕСТЬNULL(ВторойСписок.Наименование, """")
	|				ИЛИ ЕСТЬNULL(ПервыйСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1)) <> ЕСТЬNULL(ВторойСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1))
	|				ИЛИ ЕСТЬNULL(ПервыйСписок.Комментарий, """") <> ЕСТЬNULL(ВторойСписок.Комментарий, """")
	|				ИЛИ ЕСТЬNULL(ПервыйСписок.ТипСвязи, """") <> ЕСТЬNULL(ВторойСписок.ТипСвязи, """")
	|			ТОГДА ""Данные различаются""
	|		ИНАЧЕ ""Без отличий""
	|	КОНЕЦ КАК Статус,
	|	НЕ(ПервыйСписок.Наименование ЕСТЬ НЕ NULL 
	|			И ВторойСписок.Наименование ЕСТЬ НЕ NULL 
	|			И ЕСТЬNULL(ПервыйСписок.Наименование, """") = ЕСТЬNULL(ВторойСписок.Наименование, """")
	|			И ЕСТЬNULL(ПервыйСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1)) = ЕСТЬNULL(ВторойСписок.ДатаВключения, ДАТАВРЕМЯ(1, 1, 1))
	|			И ЕСТЬNULL(ПервыйСписок.Комментарий, """") = ЕСТЬNULL(ВторойСписок.Комментарий, """")
	|			И ЕСТЬNULL(ПервыйСписок.ТипСвязи, """") = ЕСТЬNULL(ВторойСписок.ТипСвязи, """")) КАК ЕстьОтличия
	|ПОМЕСТИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.РезультатСравнения
	|ИЗ
	|	ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ПервыйСписок КАК ПервыйСписок
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ВторойСписок КАК ВторойСписок
	|		ПО (ВЫБОР
	|				КОГДА ПервыйСписок.ИНН = ПервыйСписок.ОГРН
	|					ТОГДА ПервыйСписок.Наименование = ВторойСписок.Наименование
	|				ИНАЧЕ ПервыйСписок.ИНН = ВторойСписок.ИНН
	|						И ПервыйСписок.ОГРН = ВторойСписок.ОГРН
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ПервыйСписок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВнешнийИсточникДанных.Externals.ВременнаяТаблица.ВторойСписок";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("matrix_organization_id", КодМатрихОрганизации);
	Запрос.УстановитьПараметр("matrix_firm_id", КодМатрихЮрЛица);
	Запрос.УстановитьПараметр("ПерваяДата", ПерваяДата);
	Запрос.УстановитьПараметр("ВтораяДата", ВтораяДата);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Выполнить();
	
	Обработка = РеквизитФормыВЗначение("Объект");
	СКД = Обработка.ПолучитьМакет("РезультатСравнения");
	
	Если Ложь Тогда
	
		СКД = Новый СхемаКомпоновкиДанных;
	
	КонецЕсли; 
	
	Настройки = СКД.НастройкиПоУмолчанию;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПерваяДата", ПерваяДата);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВтораяДата", ВтораяДата);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки, Истина, , Запрос.МенеджерВременныхТаблиц);
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхРасшифровки) Тогда
		ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.АдресДанныхРасшифровки);
	Иначе
		ЭтаФорма.АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 	
	
	Результат = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура КомандаИмпортироватьСвязанныеЛицаИнфинитумНаСервере(Отчет)
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ОбработкаНаСервере.ИмпортСрезаСвязанныхЛицИнфинитум(Отчет);
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортироватьСвязанныеЛицаИнфинитум(Команда)
	
	Отчет = Новый ТабличныйДокумент;
	КомандаИмпортироватьСвязанныеЛицаИнфинитумНаСервере(Отчет);
	Отчет.Показать("Отчет об обновлении списков связанных лиц из Инфинитум");
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПрочитатьФайлXML(АдресФайла, ПолноеИмяФайла)

	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	УдалитьИзВременногоХранилища(АдресФайла);
	
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаНаСервере.ПрочитатьФайлXML(ДанныеФайла, ПолноеИмяФайла, ЭтаФорма.Организация);

КонецФункции

