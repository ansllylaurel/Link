
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не (РольДоступна("ПолныеПрава") Или РольДоступна("КонтрольУправляющихКомпаний")) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ДатаСведений, КодМатрихОрганизации, КодМатрихЮрЛица, Организация, ЮрЛицоОрганизации, ЮрФизЛицо");
	
	ЭтаФорма.ЭтоНациональный = (ЭтаФорма.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"));
	
	Если ЭтаФорма.ЭтоНациональный Тогда
	
		Элементы.КомандаПрочитать.Видимость = Истина;
		Элементы.КомандаПрочитать.КнопкаПоУмолчанию = Истина;
		Элементы.КомандаИмпортировать.Видимость = Ложь;
		
		ЭтаФорма.АдресИмпортируемыхДанныхНациональный = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
		ЭтаФорма.АдресИмпортируемыхДанныхНациональныйПоЮрЛицу = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	
	КонецЕсли; 
	
	Если Параметры.ИмпортируемыеДанные = Неопределено Тогда
		ПоказатьПустуюТаблицуИмпортаНаСервере();
	Иначе
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		
		Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
		
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Строка = Макет.ПолучитьОбласть("Строка");
		
		ЭтаФорма.ИмпортируемыеДанные = Новый ТабличныйДокумент;
		
		Шапка.Область("C4").Видимость = Ложь;
		
		ЭтаФорма.ИмпортируемыеДанные.Вывести(Шапка);
		
		Для каждого СтрокаСвязанныхЛиц Из Параметры.ИмпортируемыеДанные Цикл
			Строка.Параметры.Заполнить(СтрокаСвязанныхЛиц);
			ЭтаФорма.ИмпортируемыеДанные.Вывести(Строка);
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ЮрФизЛицо) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено юр. физ. лицо",, "ЮрФизЛицо",, Отказ); 
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтаФорма.ДатаСведений) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена дата сведений",, "ДатаСведений",, Отказ); 
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтаФорма.КодМатрихЮрЛица) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить код клиента в Матрикс",,,, Отказ); 
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(ЭтаФорма.КодМатрихОрганизации) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить код организации в Матрикс",,,, Отказ); 
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	Результат = ИмпортироватьСписок();
	Если ЗначениеЗаполнено(Результат) Тогда
		Закрыть(Результат);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчистить(Команда)
	ПоказатьПустуюТаблицуИмпортаНаСервере();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПоказатьПустуюТаблицуИмпортаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ЭтаФорма.ЮрЛицоОрганизации = ЭтаФорма.ЮрФизЛицо Тогда
		ИмяМакета = "МакетОрганизации";
	Иначе
		ИмяМакета = "Макет";
	КонецЕсли; 
	
	Макет = ОбработкаОбъект.ПолучитьМакет(ИмяМакета);
	
	ЭтаФорма.ИмпортируемыеДанные.Очистить();
	ЭтаФорма.ИмпортируемыеДанные.Вывести(Макет);
	ЭтаФорма.ИмпортируемыеДанные.ТекущаяОбласть = ЭтаФорма.ИмпортируемыеДанные.Область(1,1,1,1);
	
	Если ЭтаФорма.ЭтоНациональный Тогда
	
		ЭтаФорма.ИмпортируемыеДанные.Область(1,5,1,5).Текст = "Классификация связанной стороны";
		ЭтаФорма.ИмпортируемыеДанные.Область(1,6,1,6).Текст = "Комментарии";
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ИмпортироватьСписок(ЮрЛицо = Неопределено)

	Если ПроверитьЗаполнение() Тогда
		
		ОчиститьСообщения();
			
		Результат = ПоместитьТаблицуСравненияВХранилище(ЮрЛицо);
		
		Если Результат.Свойство("ОшибкиЧтения") Тогда
		
			Подстрока = ?(Результат.ОшибкиЧтения.Количество() = 1, "В строке ", "В строках ");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Подстрока + СтрСоединить(Результат.ОшибкиЧтения, ", ") + " не заполнена колонка ""Тип связи"""); 
			Возврат Неопределено;
		
		КонецЕсли; 
		
		Если Результат.Свойство("ОбновлениеНеТребуется") Тогда
			Возврат "Обновление не требуется";
		КонецЕсли;
		
		Если Результат.Свойство("АдресТаблицыСравнения") И Результат.СравнитьПередЗагрузкой Тогда
		
			КодВозврата = ОткрытьФормуМодально("ВнешняяОбработка._УправлениеСвязаннымиЛицами.Форма.ФормаСравнения", Новый Структура("АдресТаблицыСравнения", Результат.АдресТаблицыСравнения));
			
			Если КодВозврата <> КодВозвратаДиалога.ОК Тогда
				Возврат Неопределено;
			КонецЕсли; 
		
		КонецЕсли;
			
		Возврат КомандаИмпортироватьНаСервере(Результат.АдресТаблицыСравнения);
	
	КонецЕсли;

КонецФункции
 
#Область ОбменСExternals

&НаСервере
Функция СтрокаСоединения()

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаНаСервере.СтрокаСоединения();
	
КонецФункции
 
&НаСервере
Функция КомандаИмпортироватьНаСервере(АдресТаблицыИмпортируемыхДанных)
	
	ТаблицаИмпортируемыхДанных = ПолучитьИзВременногоХранилища(АдресТаблицыИмпортируемыхДанных);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ТаблицаИмпортируемыхДанных", ТаблицаИмпортируемыхДанных);
	Контекст.Вставить("ДатаСведений", ЭтаФорма.ДатаСведений);
	Контекст.Вставить("КодМатрихОрганизации", ЭтаФорма.КодМатрихОрганизации);
	Контекст.Вставить("КодМатрихЮрЛица", ЭтаФорма.КодМатрихЮрЛица);
	
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаНаСервере.ВыгрузитьДанныеВExternals(Контекст);
	
	Возврат Результат;
		
КонецФункции

&НаСервере
Функция ПоместитьТаблицуСравненияВХранилище(ЮрЛицо)
	
	ОшибкиЧтения = Новый Массив;
	
	Если ЮрЛицо = Неопределено Тогда
		ТаблицаИмпортируемыхДанных = ПрочитатьИмпортируемыеДанные(ОшибкиЧтения);
	Иначе
		ТаблицаИмпортируемыхДанных = ПолучитьТаблицуДанныхПоЮрЛицу(ЮрЛицо)
	КонецЕсли; 	
	
	Результат = Новый Структура;
	Если ОшибкиЧтения.Количество() > 0 Тогда
		Результат.Вставить("ОшибкиЧтения", ОшибкиЧтения);
		Возврат Результат;
	КонецЕсли; 
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИмпортируемыхДанных.name КАК name,
		|	ТаблицаИмпортируемыхДанных.INN КАК INN,
		|	ТаблицаИмпортируемыхДанных.OGRN КАК OGRN,
		|	ТаблицаИмпортируемыхДанных.date_from КАК date_from,
		|	ТаблицаИмпортируемыхДанных.comment КАК comment,
		|	ТаблицаИмпортируемыхДанных.relation КАК relation,
		|	ТаблицаИмпортируемыхДанных.date_basement КАК date_basement
		|ПОМЕСТИТЬ _ТаблицаИмпортируемыхДанных
		|ИЗ
		|	&ТаблицаИмпортируемыхДанных КАК ТаблицаИмпортируемыхДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ВнешниеДанные.id, 0) КАК id,
		|	ЕСТЬNULL(_ВнешниеДанные.name, """") КАК НаименованиеТекущее,
		|	ЕСТЬNULL(_ТаблицаИмпортируемыхДанных.name, """") КАК name,
		|	ЕСТЬNULL(_ВнешниеДанные.INN, _ТаблицаИмпортируемыхДанных.INN) КАК INN,
		|	ЕСТЬNULL(_ВнешниеДанные.OGRN, _ТаблицаИмпортируемыхДанных.OGRN) КАК OGRN,
		|	ЕСТЬNULL(_ВнешниеДанные.date_from, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВключенияТекущая,
		|	ЕСТЬNULL(_ТаблицаИмпортируемыхДанных.date_from, ДАТАВРЕМЯ(1, 1, 1)) КАК date_from,
		|	ЕСТЬNULL(_ВнешниеДанные.date_basement, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснованияТекущая,
		|	ЕСТЬNULL(_ТаблицаИмпортируемыхДанных.date_basement, ДАТАВРЕМЯ(1, 1, 1)) КАК date_basement,
		|	ЕСТЬNULL(_ВнешниеДанные.comment, """") КАК КомментарийТекущий,
		|	ЕСТЬNULL(_ТаблицаИмпортируемыхДанных.comment, """") КАК comment,
		|	ЕСТЬNULL(_ВнешниеДанные.relation, """") КАК ТипСвязиТекущий,
		|	ЕСТЬNULL(_ТаблицаИмпортируемыхДанных.relation, """") КАК relation,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.name ЕСТЬ NULL
		|			ТОГДА ""Есть только в файле""
		|		КОГДА _ТаблицаИмпортируемыхДанных.name ЕСТЬ NULL
		|			ТОГДА ""Отсутствует в файле""
		|		КОГДА _ВнешниеДанные.name <> _ТаблицаИмпортируемыхДанных.name
		|				ИЛИ _ВнешниеДанные.date_from <> _ТаблицаИмпортируемыхДанных.date_from
		|				ИЛИ _ВнешниеДанные.date_basement <> _ТаблицаИмпортируемыхДанных.date_basement
		|				ИЛИ _ВнешниеДанные.comment <> _ТаблицаИмпортируемыхДанных.comment
		|				ИЛИ _ВнешниеДанные.relation <> _ТаблицаИмпортируемыхДанных.relation
		|			ТОГДА ""Данные различаются""
		|		ИНАЧЕ ""Без отличий""
		|	КОНЕЦ КАК Статус,
		|	НЕ( _ВнешниеДанные.name ЕСТЬ НЕ NULL 
		|			И _ТаблицаИмпортируемыхДанных.name ЕСТЬ НЕ NULL И _ВнешниеДанные.name = _ТаблицаИмпортируемыхДанных.name
		|			И _ВнешниеДанные.date_from = _ТаблицаИмпортируемыхДанных.date_from
		|			И _ВнешниеДанные.date_basement = _ТаблицаИмпортируемыхДанных.date_basement
		|			И _ВнешниеДанные.comment = _ТаблицаИмпортируемыхДанных.comment
		|			И _ВнешниеДанные.relation = _ТаблицаИмпортируемыхДанных.relation
		|			) КАК ЕстьОтличия,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.name ЕСТЬ NULL
		|			ТОГДА ""Взять из файла""
		|		КОГДА _ТаблицаИмпортируемыхДанных.name ЕСТЬ NULL
		|			ТОГДА ""Удалить""
		|		КОГДА _ВнешниеДанные.name <> _ТаблицаИмпортируемыхДанных.name
		|				ИЛИ _ВнешниеДанные.date_from <> _ТаблицаИмпортируемыхДанных.date_from
		|				ИЛИ _ВнешниеДанные.date_basement <> _ТаблицаИмпортируемыхДанных.date_basement
		|				ИЛИ _ВнешниеДанные.comment <> _ТаблицаИмпортируемыхДанных.comment
		|				ИЛИ _ВнешниеДанные.relation <> _ТаблицаИмпортируемыхДанных.relation
		|			ТОГДА ""Взять из файла""
		|		ИНАЧЕ ""Оставить без изменений""
		|	КОНЕЦ КАК Действие
		|ИЗ
		|	_ТаблицаИмпортируемыхДанных КАК _ТаблицаИмпортируемыхДанных
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|		ПО (ВЫБОР
		|				КОГДА _ТаблицаИмпортируемыхДанных.INN = _ТаблицаИмпортируемыхДанных.OGRN
		|					ТОГДА _ТаблицаИмпортируемыхДанных.name = _ВнешниеДанные.name
		|				ИНАЧЕ _ТаблицаИмпортируемыхДанных.INN = _ВнешниеДанные.INN
		|						И _ТаблицаИмпортируемыхДанных.OGRN = _ВнешниеДанные.OGRN
		|			КОНЕЦ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	INN,
		|	OGRN";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СравнитьПередЗагрузкой = Ложь;
	ПоместитьВнешниеДанныеВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ЭтаФорма.КодМатрихОрганизации, ЭтаФорма.КодМатрихЮрЛица, ЭтаФорма.ДатаСведений, СравнитьПередЗагрузкой);
	Результат.Вставить("СравнитьПередЗагрузкой", СравнитьПередЗагрузкой);
	
	Запрос.УстановитьПараметр("ТаблицаИмпортируемыхДанных", ТаблицаИмпортируемыхДанных);
	
	ТаблицаСравнения = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаСравнения.НайтиСтроки(Новый Структура("ЕстьОтличия", Истина)).Количество() > 0 Тогда
		Результат.Вставить("АдресТаблицыСравнения", ПоместитьВоВременноеХранилище(ТаблицаСравнения, ЭтаФорма.УникальныйИдентификатор));
	Иначе
		Результат.Вставить("ОбновлениеНеТребуется");
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПоместитьВнешниеДанныеВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, КодМатрихОрганизации, КодМатрихЮрЛица, ДатаСведений, СравнитьПередЗагрузкой)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_Related_Companies.id КАК id,
		|	dbo_Related_Companies.date_from КАК date_from,
		|	dbo_Related_Companies.date_basement КАК date_basement,
		|	dbo_Related_Companies.name КАК name,
		|	dbo_Related_Companies.comment КАК comment,
		|	dbo_Related_Companies.INN КАК INN,
		|	dbo_Related_Companies.OGRN КАК OGRN,
		|	dbo_Related_Companies.relation КАК relation
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Related_Companies КАК dbo_Related_Companies
		|ГДЕ
		|	dbo_Related_Companies.matrix_organization_id = &matrix_organization_id
		|	И dbo_Related_Companies.matrix_firm_id = &matrix_firm_id
		|	И dbo_Related_Companies.date = &date";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("matrix_organization_id", КодМатрихОрганизации);
	Запрос.УстановитьПараметр("matrix_firm_id", КодМатрихЮрЛица);
	Запрос.УстановитьПараметр("date", ДатаСведений);
	
	Результат = Запрос.Выполнить();
	ВнешниеДанные = Результат.Выгрузить();
	
	СравнитьПередЗагрузкой = Не Результат.Пустой();
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.id КАК id,
		|	ЕСТЬNULL(_ВнешниеДанные.date_from, ДАТАВРЕМЯ(1, 1, 1)) КАК date_from,
		|	ЕСТЬNULL(_ВнешниеДанные.date_basement, ДАТАВРЕМЯ(1, 1, 1)) КАК date_basement,
		|	ЕСТЬNULL(_ВнешниеДанные.name, """") КАК name,
		|	ЕСТЬNULL(_ВнешниеДанные.comment, """") КАК comment,
		|	ЕСТЬNULL(_ВнешниеДанные.INN, """") КАК INN,
		|	ЕСТЬNULL(_ВнешниеДанные.OGRN, """") КАК OGRN,
		|	ЕСТЬNULL(_ВнешниеДанные.relation, """") КАК relation
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК _ВнешниеДанные";	
	Запрос.УстановитьПараметр("ВнешниеДанные", ВнешниеДанные);
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьИмпортируемыеДанные(МассивОшибок)

	ВысотаТаблицы = ЭтаФорма.ИмпортируемыеДанные.ВысотаТаблицы;
	
	ТаблицаИмпортируемыхДанных = Новый ТаблицаЗначений;
	
	МассивКопируемыхПолей = СтрРазделить("INN,OGRN,name,date_from,date_basement,comment,relation", ",");
	ПоляВнешнейТаблицы = Метаданные.ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Related_Companies.Поля;
	
	Для каждого Поле Из ПоляВнешнейТаблицы Цикл
		Если МассивКопируемыхПолей.Найти(Поле.Имя) <> Неопределено Тогда
			ТаблицаИмпортируемыхДанных.Колонки.Добавить(Поле.Имя, Поле.Тип);
		КонецЕсли; 
	КонецЦикла; 
	
	Для НомерСтроки = 1 По ВысотаТаблицы Цикл
		
		Наименование = ЭтаФорма.ИмпортируемыеДанные.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		Если Наименование = "Наименование компании" Тогда
			// это заголовок, идем дальше
			Продолжить;
		КонецЕсли; 
		
		НомераКолонок = ПолучитьСтруктуруНомеровКолонок();
		
		ИНН 			= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.ИНН);
		ОГРН 			= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.ОГРН);
		ДатаВключения 	= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.ДатаВключения);
		ДатаОснования 	= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.ДатаОснования);
		Комментарий 	= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.Комментарий);
		ТипСвязи 		= ПолучитьТекстОбласти(НомерСтроки, НомераКолонок.ТипСвязи);
		
		Если СтрДлина(Наименование + ИНН + ОГРН) > 0 Тогда
		
			НоваяСтрока = ТаблицаИмпортируемыхДанных.Добавить();
			НоваяСтрока.name 			= Наименование;
			НоваяСтрока.INN 			= ИНН;
			НоваяСтрока.OGRN 			= ОГРН;
			НоваяСтрока.date_from 		= ПолучитьДатуИзСтроки(ДатаВключения);
			НоваяСтрока.date_basement 	= ПолучитьДатуИзСтроки(ДатаОснования);
			НоваяСтрока.comment 		= Комментарий;
			НоваяСтрока.relation		= ТипСвязи;
			
			Если ЭтаФорма.ЮрЛицоОрганизации = ЭтаФорма.ЮрФизЛицо И Не ЗначениеЗаполнено(ТипСвязи) Тогда
				МассивОшибок.Добавить(НомерСтроки);
			КонецЕсли; 
		
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат ТаблицаИмпортируемыхДанных;

КонецФункции

&НаСервере
Функция ПолучитьДатуИзСтроки(ДатаСтрока)

	Результат = NULL;
	
	Если ЗначениеЗаполнено(ДатаСтрока) Тогда
	
		Попытка
			Результат = Дата(ДатаСтрока + " 00:00:00");
		Исключение
		КонецПопытки; 	
	
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьТекстОбласти(НомерСтроки, НомерКолонки)

	Возврат СокрЛП(ЭтаФорма.ИмпортируемыеДанные.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);

КонецФункции 

&НаКлиенте
Процедура КомандаПрочитать(Команда)
	
	КомандаПрочитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомандаПрочитатьНаСервере()

	ОшибкиЧтения = Новый Массив;
	ТаблицаИмпортируемыхДанных = ПрочитатьИмпортируемыеДанные(ОшибкиЧтения);
	
	ПоместитьВоВременноеХранилище(ТаблицаИмпортируемыхДанных, ЭтаФорма.АдресИмпортируемыхДанныхНациональный);
	
	Комментарии = ТаблицаИмпортируемыхДанных.Скопировать(, "comment");
	Комментарии.Свернуть("comment");
	Комментарии.Сортировать("comment");
	
	Элементы.КонтрагентыНациональный.Видимость = Истина;
	
	ИсходныеКонтрагенты = ЭтаФорма.КонтрагентыНациональный.Выгрузить();
	ЭтаФорма.КонтрагентыНациональный.Очистить();
	
	Для каждого СтрокаКомментарий Из Комментарии Цикл
	
		НоваяСтрока = ЭтаФорма.КонтрагентыНациональный.Добавить();
		НоваяСтрока.Комментарий = СтрокаКомментарий.comment;
		НоваяСтрока.Статус = "Импортировать";
		
		ИсходнаяСтрока = ИсходныеКонтрагенты.Найти(НоваяСтрока.Комментарий, "Комментарий");
		Если ИсходнаяСтрока <> Неопределено Тогда
			НоваяСтрока.ЮрЛицо = ИсходнаяСтрока.ЮрЛицо;
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруНомеровКолонок()

	НомераКолонок = Новый Структура;
	
	НомераКолонок.Вставить("ИНН", 			2);
	НомераКолонок.Вставить("ОГРН", 			3);	
	НомераКолонок.Вставить("ДатаВключения", 4);
	НомераКолонок.Вставить("Комментарий", 	5);
	НомераКолонок.Вставить("ТипСвязи", 		6);
	НомераКолонок.Вставить("ДатаОснования", 7);
	
	Если ЭтаФорма.ЭтоНациональный Тогда
		НомераКолонок.Вставить("ТипСвязи", 		5);
		НомераКолонок.Вставить("Комментарий", 	6);
	ИначеЕсли ЭтаФорма.ЮрЛицоОрганизации = ЭтаФорма.ЮрФизЛицо Тогда 	
		НомераКолонок.Вставить("ТипСвязи", 		4);
		НомераКолонок.Вставить("ДатаВключения", 5);
		НомераКолонок.Вставить("ДатаОснования", 6);
		НомераКолонок.Вставить("Комментарий", 	7);
	КонецЕсли; 
	
	Возврат НомераКолонок;
	
КонецФункции

&НаКлиенте
Процедура КонтрагентыНациональныйВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = ЭтаФорма.КонтрагентыНациональный.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекСтрока <> Неопределено Тогда
		
		ТекЮрЛицо = ТекСтрока.ЮрЛицо;
		// проверка на Неопределено срабатывает при двойном клике по гиперссылке в таблицйе группового контроля
		Если Поле.Имя = "КонтрагентыНациональныйСтатус" И ТекСтрока.Статус = "Импортировать" И ЗначениеЗаполнено(ТекЮрЛицо) Тогда
			
			ЭтаФорма.КодМатрихЮрЛица = ПолучитьКодМатрих(ТекЮрЛицо);
			
			Результат = ИмпортироватьСписок(ТекЮрЛицо);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				
				Если ТипЗнч(Результат) = Тип("Строка") Тогда
					
					ТекСтрока.Статус = Результат;
					
				ИначеЕсли Результат Тогда 
					
					ТекСтрока.Статус = "Готово";
					ПараметрыВызова = ПолучитьСтруктуруПараметровВызова();
					ПараметрыВызова.Организация = ЭтаФорма.Организация;
					ПараметрыВызова.ЮрФизЛицо = ТекЮрЛицо;
					ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова);
					
				Иначе
					
					ТекСтрока.Статус = "Данных для импорта не обнаружено";
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКодМатрих(ЮрФизЛицо)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаНаСервере.ПолучитьКодМатрих(ЮрФизЛицо);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруПараметровВызова()

	Возврат Новый Структура("Организация, ЮрФизЛицо, СвязанноеЛицо");
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьИмпортИПоказатьОтчет(ПараметрыВызова)

	Отчет = Новый ТабличныйДокумент;
	ПараметрыВызова.Вставить("Отчет", Отчет);
	
	ИмпортироватьСведенияОСвязанныхЛицах(ПараметрыВызова);
	
	Если ТипЗнч(ПараметрыВызова.Отчет) = Тип("ТабличныйДокумент") Тогда
		ПараметрыВызова.Отчет.Показать("Отчет об обновлении списков связанных лиц");
	Иначе
		Предупреждение("Не удалось обновить данные о связанных лицах в 1С", , "Ошибка обновления");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ИмпортироватьСведенияОСвязанныхЛицах(ПараметрыВызова)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ОбработкаНаСервере.ИмпортироватьСведенияОСвязанныхЛицах(
		ПараметрыВызова.Организация,
		ПараметрыВызова.ЮрФизЛицо, 
		ПараметрыВызова.СвязанноеЛицо,
		ПараметрыВызова.Отчет);
		
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуДанныхПоЮрЛицу(ЮрЛицо)

	ТаблицаНациональный = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресИмпортируемыхДанныхНациональный);
	ТаблицаПоЮрЛицу = ТаблицаНациональный.СкопироватьКолонки();
	
	Контрагенты = ЭтаФорма.КонтрагентыНациональный.НайтиСтроки(Новый Структура("ЮрЛицо", ЮрЛицо));
	
	Для каждого СтрокаКонтрагенты Из Контрагенты Цикл
	
		НайденныеСтроки = ТаблицаНациональный.НайтиСтроки(Новый Структура("comment", СтрокаКонтрагенты.Комментарий));
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаПоЮрЛицу.Добавить(), НайденнаяСтрока);
		КонецЦикла; 
	
	КонецЦикла; 
	
	Возврат ТаблицаПоЮрЛицу

КонецФункции

#КонецОбласти