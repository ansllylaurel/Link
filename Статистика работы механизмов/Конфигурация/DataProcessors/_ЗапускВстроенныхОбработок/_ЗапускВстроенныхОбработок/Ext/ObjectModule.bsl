
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Запуск встроенных обработок",
		"0.33",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортРейтингов", "Импорт рейтингов",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортНовыхКотировковММВБЗаВчера", "Импорт новых котировки ММВБ за вчера",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОбновлениеНормативноСправочнойИнформацииИзМатрих", "Обновление НСИ из Матрих",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольСЧАЗаМесяц", "Контроль СЧА за предыдущий месяц",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольОтклоненияСЧАЗаПредыдущийРабочийДень", "Контроль отклонения СЧА за предыдущий рабочий день",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортКотировковБлумбергЗаВчера", "Импорт котировки Блумберг за вчера",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЗапуститьОтложенныеЗадания", "Запустить отложенные задания",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортРасчетныхЦенПоСтаройМетодикеНРДЗаВчерашнийДень", "Автоимпорт расчетных цен НРД за вчерашний день",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортРасчетныхЦенПоНовойМетодикеНРДЗаВчерашнийДень", "Автоимпорт расчетных цен по новой методике НРД за вчерашний день",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортРасчетныхЦенRUDataЗаВчерашнийДень", "Автоимпорт расчетных цен RU Data за вчерашний день",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольКотировокБлумбергРЭМ", "Контроль наличия котировок блумберг по еврооблигациям РЭМ за вчерашний день", 	, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольКотировокБлумбергТраст", "Контроль наличия котировок блумберг по еврооблигациям Траст за вчерашний день",	, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольКотировокБлумбергРПИ", "Контроль наличия котировок блумберг по еврооблигациям РПИ за вчерашний день",		, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортСредневзвешенныхПроцентныхСтавок", 	"Импорт средневзвешенных процентных ставок", 	, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортИндексовПотребительскихЦен", 		"Импорт индексов потребительских цен", 			, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортПрогнозныхЗначенийОтНИУВШЭ", 		"Импорт прогнозных значений от НИУ ВШЭ", 		, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АктСверкиПоВнутреннемуУчету", 			"Акт сверки по внутреннему учету", 				, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольОтправкиДанныхПИФНаСайт", 		"Контроль отправки данных ПИФ на сайт",			, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортЗаявокПайщиковИзЛКК", 				"Импорт заявок пайщиков из ЛКК",				, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОбработкаЗадачСистемногоПользователяПоПИФ", "Обработка задач для системного пользователя по рознице ПИФ",	, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СверкаЗаявокПайщиковСДКРегионПоИтогамДня", "Сверка заявок пайщиков с ДК Регион по итогам дня (выгрузка заявок в Excel)",	, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЗагрузкаСводногоОтчетаПоОперациямЗаДеньОтДКРегион", "Загрузка сводного отчета по исполненным операциям за день от ДК Регион (DKRA_05)",	, Ложь, "ВызовСерверногоМетода");
						
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки прайс-листа по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
	Попытка
		ВыполнитьКомандуБезСтатистики(ИдентификаторКоманды, ПараметрыОбработки, ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

Процедура ВыполнитьКомандуБезСтатистики(ИдентификаторКоманды, ПараметрыОбработки, ПараметрыСессии)
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Если ИдентификаторКоманды = "ИмпортРейтингов" Тогда

		ИмпортРейтингов = Обработки.ИмпортРейтингов.Создать();
		ИмпортРейтингов.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды);

		ЗаполнитьЗначенияСвойств(ИмпортРейтингов, ПараметрыКоманды, "ПолучателиПротоколаОбИзмененияхРейтингов");
		
		ИмпортРейтингов.ВыполнитьКоманду("КомандаИмпортировать");
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортНовыхКотировковММВБЗаВчера" Тогда
		
		ИмпортКотировокММВБ = Обработки.ИмпортКотировокММВБ.Создать();
		
		ИмпортКотировокММВБ.РежимИмпорта = 1; // импорт новых котировок
		ИмпортКотировокММВБ.Период       = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
	
		ИмпортКотировокММВБ.СкрыватьВОтчетеНовыеКотировки = Истина; // иначе будет строиться очень долго
		
		ИмпортКотировокММВБ.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды);
		
		ИмпортКотировокММВБ.ИмпортироватьКотировки();
		
	ИначеЕсли ИдентификаторКоманды = "ОбновлениеНормативноСправочнойИнформацииИзМатрих" Тогда
		
		ПолучателиОтчета = Неопределено;
		ГруппаОбъектов = Неопределено;
		ПараметрыКоманды.Свойство("ПолучателиОтчета", ПолучателиОтчета); // т.к. его может и не быть
		ПараметрыКоманды.Свойство("ГруппаОбъектов", ГруппаОбъектов);
		
		Обработки.ИмпортНормативноСправочнойИнформации.АвтоматическоеОбновлениеИзМатрих(ПолучателиОтчета, ГруппаОбъектов);
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольСЧАЗаМесяц" Тогда 
		
		Если Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоМесяца(ТекущаяДата()), ПараметрыКоманды.НомерРабочегоДняЗапуска) = НачалоДня(ТекущаяДата()) Тогда
	
			ПериодКонтроля = Новый СтандартныйПериод;
			ПериодКонтроля.ДатаОкончания = НачалоМесяца(ТекущаяДатаСеанса()) - 1;
			ПериодКонтроля.ДатаНачала    = НачалоМесяца(ПериодКонтроля.ДатаОкончания);
			
			ПараметрыКоманды.Вставить("ПериодКонтроля", ПериодКонтроля);
			
			КонтрольСЧА = Обработки.КонтрольСЧА.Создать();
			КонтрольСЧА.ВыполнитьМетод("ВыполнитьКонтрольЗаМесяц", ПараметрыКоманды);
		
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольОтклоненияСЧАЗаПредыдущийРабочийДень" Тогда
		
		ПараметрыКоманды.Вставить("ДатаНачала",		Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса() - 86400));
		ПараметрыКоманды.Вставить("ДатаОкончания",	ПараметрыКоманды.ДатаНачала);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период",				ПараметрыКоманды.ДатаНачала);
		Запрос.УстановитьПараметр("Организация",		ПараметрыКоманды.Организация);
		Запрос.УстановитьПараметр("СубъектАналитики",	ПараметрыКоманды.СчетДоверительногоУправления);

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ФинансовыеПоказатели.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = &Период
			|	И ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
			|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
		
		Если Запрос.Выполнить().Пустой() Тогда
			ТемаПисьма = 
				СтрШаблон("Ошибка проверки отклонения СЧА за %1 по договору %2: отсутствует СЧА",
					ПредставлениеПериода(НачалоДня(ПараметрыКоманды.ДатаНачала), КонецДня(ПараметрыКоманды.ДатаНачала)),
					ПараметрыКоманды.СчетДоверительногоУправления);
			ДобавитьТекстОшибки(ПараметрыСессии, ТемаПисьма);
			
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", ПараметрыКоманды.ПолучателиОповещения, ТемаПисьма, ТемаПисьма);
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
			
		Иначе
			Экземпляры = Новый Массив;
			Экземпляры.Добавить(Новый Структура("Параметры", ПараметрыКоманды));
			
			КонтрольОтклоненияСЧА = Обработки.КонтрольОтклоненияСЧА.Создать();
			КонтрольОтклоненияСЧА.ВыполнитьМетод("ВыполнитьОповещение", Экземпляры);
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортКотировковБлумбергЗаВчера" Тогда
		
		Если Не ПараметрыКоманды.Свойство("Организация") Или Не ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
			ТекстОшибки = "Не заполнен параметр 'Организация'";
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Импорт котировок Блумберг");
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Иначе
			ИмпортКотировокБлумберг = Обработки.ИмпортКотировокБлумберг.Создать();
			ИмпортКотировокБлумберг.ИмпортироватьКотировки(ПараметрыКоманды.Организация,,,,, ПараметрыКоманды.ПолучателиОповещения);
		КонецЕсли;
			
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортРасчетныхЦенПоСтаройМетодикеНРДЗаВчерашнийДень" Тогда
		
		ИмпортРасчетныхЦен = Обработки.ИмпортРасчетныхЦен.Создать();
		ИмпортРасчетныхЦен.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды);
		
		ИмпортРасчетныхЦен.Период			 = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
		ИмпортРасчетныхЦен.Период.ДатаНачала = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ИмпортРасчетныхЦен.Период.ДатаНачала);
		
		ИмпортРасчетныхЦен.ЗагрузитьРасчетныеЦеныПоСтаройМетодикеНРДизЭкстерналс();
		
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортРасчетныхЦенПоНовойМетодикеНРДЗаВчерашнийДень" Тогда
		
		ИмпортРасчетныхЦен = Обработки.ИмпортРасчетныхЦен.Создать();
		ИмпортРасчетныхЦен.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды);
		
		ИмпортРасчетныхЦен.Период			 = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
		ИмпортРасчетныхЦен.Период.ДатаНачала = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ИмпортРасчетныхЦен.Период.ДатаНачала);
		
		ИмпортРасчетныхЦен.ЗагрузитьРасчетныеЦеныПоНовойМетодикеНРД();
		
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортРасчетныхЦенRUDataЗаВчерашнийДень" Тогда
		
		ИмпортРасчетныхЦен = Обработки.ИмпортРасчетныхЦен.Создать();
		ИмпортРасчетныхЦен.ДополнительныеСвойства.Вставить("Источник", ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды);
		
		ИмпортРасчетныхЦен.Период			 = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
		ИмпортРасчетныхЦен.Период.ДатаНачала = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ИмпортРасчетныхЦен.Период.ДатаНачала);
		
		ИмпортРасчетныхЦен.ЗагрузитьРасчетныеЦеныRUData();
		
	ИначеЕсли Найти(ИдентификаторКоманды, "КонтрольКотировокБлумберг") > 0 Тогда
		
		Если Не ПараметрыКоманды.Свойство("Организация") Или Не ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
			ТекстОшибки = "Не заполнен параметр 'Организация'";
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, "Контроль котировок Блумберг.");
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Иначе
			
			КалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
			ТД = ТекущаяДата(); 
		
			// Котировки за последний рабочий день / предпраздничный появляются на следующий рабочий (торговый) день.
			// Следовательно, выполнять автозагрузку или контроль наличия котировок в выходной день бессмыслено.
			Если Справочники.Календари.ЭтоРабочийДень(КалендарьКотировок, ТД) Тогда
				
				ПредыдущийДеньКотировок = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ТД - 60 * 60 * 24);
				
				ИмпортКотировокБлумберг = Обработки.ИмпортКотировокБлумберг.Создать();
				ИмпортКотировокБлумберг.КонтрольКотировокБлумберг(ПараметрыКоманды.Организация, НачалоДня(ПредыдущийДеньКотировок), ПараметрыКоманды.ПолучателиОповещения);
				
			Иначе
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "ЗапуститьОтложенныеЗадания") > 0 Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			ОбработкаМОЗ = Обработки.МенеджерОтложенныхЗаданий.Создать();
			ОбработкаМОЗ.ЗапуститьОтложенныеЗадания();
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "ИмпортСредневзвешенныхПроцентныхСтавок") > 0 Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			ОбработкаИмпортПроцентныхПоказателей = Обработки.ИмпортПроцентныхПоказателей.Создать();
			ОбработкаИмпортПроцентныхПоказателей.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки);
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "ИмпортИндексовПотребительскихЦен") > 0 Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			ОбработкаИмпортПроцентныхПоказателей = Обработки.ИмпортПроцентныхПоказателей.Создать();
			ОбработкаИмпортПроцентныхПоказателей.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки);
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "ИмпортПрогнозныхЗначенийОтНИУВШЭ") > 0 Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			ОбработкаИмпортПроцентныхПоказателей = Обработки.ИмпортПроцентныхПоказателей.Создать();
			ОбработкаИмпортПроцентныхПоказателей.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки);
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "АктСверкиПоВнутреннемуУчету") > 0 Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ДатаСверки = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2);
			
			// Ответственный из регистра ответственных за операции
			Ответственный = РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(ПараметрыКоманды.Организация, "РегистрацияСтоимостиПереоценки", Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, ДатаСверки, Справочники.Пользователи.ПустаяСсылка());
			
			ФИООтветственного = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ответственный, "ИдентификаторПользователяИБ")).Имя;
			
			СверкаУспешна = Ложь;
			АктСверки = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ПолучитьАктСверки(ПараметрыКоманды.Организация, ДатаСверки, ФИООтветственного, СверкаУспешна);
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".docx");
			
			АктСверки.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.DOCX);
			
			ПараметрыОповещения = Новый Структура;
			
			Тема = "Акт сверки за " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + " " + СокрЛП(ПараметрыКоманды.Организация);
			Текст = Тема + ?(СверкаУспешна, "", Символы.ПС + "Есть несверенные операции!");
			Если Не СверкаУспешна Тогда
				ДобавитьТекстОшибки(ПараметрыСессии, Текст);
			КонецЕсли;
			Вложения = Новый Соответствие;
			Вложения.Вставить(Тема + ".docx", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)));
			
			РеквизитыОповещения = Новый Структура("Организация, Тема, Текст, Вложения", ПараметрыКоманды.Организация, Тема, Текст, Вложения);
			
			Справочники.Оповещения.СформироватьОповещения("РегистрСведений.ЖурналСверокПоВнутреннемуУчету.АктСверки", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
			УдалитьФайлы(ИмяВременногоФайла);
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольОтправкиДанныхПИФНаСайт" Тогда
		
		Календари = Справочники.Календари;
		
		Если Календари.ЭтоРабочийДень(Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ДатаСЧА = Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, ТекущаяДатаСеанса(), -2);
			
			ТаблицаПаевыхИнвестиционныхФондов = Обработки.ОтправкаДанныхПИФНаСайт.ПолучитьТаблицуПаевыхИнвестиционныхФондов(ПараметрыКоманды.Организация, ДатаСЧА, Ложь, Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Открытый);
			Обработки.ОтправкаДанныхПИФНаСайт.ПолучитьИнформациюССайта(ПараметрыКоманды.Организация, ДатаСЧА, ТаблицаПаевыхИнвестиционныхФондов);

			Для каждого Строка Из ТаблицаПаевыхИнвестиционныхФондов Цикл
			
				Если Строка.СЧАСайт + Строка.СтоимостьПаяСайт = -2 Тогда
				
					РеквизитыОповещения = Новый Структура("Организация, ПИФ, Ссылка", ПараметрыКоманды.Организация, Строка.СчетДоверительногоУправления, Строка.АдресСайта);
					Справочники.Оповещения.СформироватьОповещения("Обработки.ОтправкаДанныхПИФНаСайт.КонтрольОтправкиДанныхПИФНаСайт", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
				
				КонецЕсли; 
			
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ИмпортЗаявокПайщиковИзЛКК" Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
			
			ОбменДаннымиСЛКК = Обработки.ОбменДаннымиСЛККЕСИАФинанс.Создать();
			ОбменДаннымиСЛКК.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки);
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ОбработкаЗадачСистемногоПользователяПоПИФ" Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
			
			ОбработкаЗадач = Обработки.ОбработкаЗадачПоЗаявкамПайщиков.Создать();
						
			ОбработкаЗадач.Дата			= ТекущаяДатаСеанса();
			ОбработкаЗадач.Организация	= ПараметрыКоманды.Организация;
			
			ОбработкаЗадач.ОбработатьЗадачи();
			
		КонецЕсли;	
		
	ИначеЕсли ИдентификаторКоманды = "СверкаЗаявокПайщиковСДКРегионПоИтогамДня" Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ОбменДаннымиСДК = Обработки.ОбменДаннымиСДКРегион.Создать();
		
			ОбменДаннымиСДК.Дата						= ТекущаяДатаСеанса();
			ОбменДаннымиСДК.Организация					= ПараметрыКоманды.Организация;
			ОбменДаннымиСДК.ПаевойИнвестиционныйФонд	= ПараметрыКоманды.ПаевойИнвестиционныйФонд;
			
			Отказ = Ложь;
			ОбменДаннымиСДК.ВыгрузитьСверкуЗаявокЗаДень(Отказ);
			Если Отказ Тогда
				ДобавитьТекстОшибки(ПараметрыСессии, "Сверка заявок пайщиков с ДК Регион завершилась с ошибкой");
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ЗагрузкаСводногоОтчетаПоОперациямЗаДеньОтДКРегион" Тогда
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
			
			ОбменДаннымиСДК = Обработки.ОбменДаннымиСДКРегион.Создать();
		
			ОбменДаннымиСДК.Дата						= ТекущаяДатаСеанса();
			ОбменДаннымиСДК.Организация					= ПараметрыКоманды.Организация;
						
			Отказ = Ложь;
			ОбменДаннымиСДК.ЗагрузитьСводныеОтчетыПоОперациямЗаДень(Отказ);
			Если Отказ Тогда
				ДобавитьТекстОшибки(ПараметрыСессии, "Загрузка сводного отчета по операциям за день от ДК Регион завершилась с ошибкой");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки) Экспорт
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	
	Механизм = Справочники.Механизмы.ПолучитьМеханизмПоКлючу("ВнешняяОбработка._ЗапускВстроенныхОбработок");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		Строка(ИмяКоманды));
	
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",       Сессия);
	ПараметрыСессии.Вставить("ДопПараметры", Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",  Неопределено);
	
	Возврат ПараметрыСессии;
	
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
