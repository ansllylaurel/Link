&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.Объект, Объект);
	
	// Заполнение локальных замещений сценарных индексов для дальнейшего редактирования
	Для Каждого СтрокаЗамещенийСценарныхИндексов Из Объект.ЗамещенияСценарныхИндексов Цикл
		НоваяСтрока = ЗамещенияСценарныхИндексов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗамещенийСценарныхИндексов);
	КонецЦикла;
	
	// Список выбора сценарного индекса
	Для Каждого СтрокаСценарногоИндекса Из Объект.СценарныеИндексы Цикл
		Элементы.ЗамещенияСценарныхИндексовИдентификаторСценарногоИндекса.СписокВыбора.Добавить(
			СтрокаСценарногоИндекса.Идентификатор, СтрокаСценарногоИндекса.Наименование + " (" + Строка(СтрокаСценарногоИндекса.Идентификатор) + ")");
		Элементы.ЗамещенияСценарныхИндексовИдентификаторЗамещающегоСценарногоИндекса.СписокВыбора.Добавить(
			СтрокаСценарногоИндекса.Идентификатор, СтрокаСценарногоИндекса.Наименование + " (" + Строка(СтрокаСценарногоИндекса.Идентификатор) + ")");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ФлагЗакрытияФормы Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	// Подтверждение закрытия формы
	Если ЭтаФорма.Модифицированность Тогда
		Ответ = Вопрос("При закрытии формы изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Продолжение закрытия формы
	СтандартнаяОбработка = Истина;
	Отказ = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ЗамещенияСценарныхИндексовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ТекущиеДанные = Элементы.ЗамещенияСценарныхИндексов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// При копировании неизменяемые поля не копируются
	Если Копирование Тогда
		Отказ = Истина;
		НоваяСтрока = ЗамещенияСценарныхИндексов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
		НоваяСтрока.Ссылка = Неопределено;
		НоваяСтрока.Идентификатор = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрименить");
	Попытка
		ВыполнитьКомандаПрименить();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрименить()
	// Проверка введённых данных на уникальность (строки уже отсортированы)
	СтрокиНаУдаление = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
	ПрошлаяСтрока = Неопределено;
	Для Каждого ЗамещениеСценарныхИндексов Из ЗамещенияСценарныхИндексов Цикл
		Если ПрошлаяСтрока = Неопределено Тогда
			ПрошлаяСтрока = ЗамещениеСценарныхИндексов;
			Продолжить;
		КонецЕсли;
		Если ЗамещениеСценарныхИндексов.ТипАктива = ПрошлаяСтрока.ТипАктива
			И ЗамещениеСценарныхИндексов.КодВалюты = ПрошлаяСтрока.КодВалюты
			И ЗамещениеСценарныхИндексов.СценарныйИндекс = ПрошлаяСтрока.СценарныйИндекс
		Тогда
			СтрокиНаУдаление.Добавить(ЗамещениеСценарныхИндексов);
		КонецЕсли;
	КонецЦикла;
	КоличествоУдаляемыхСтрок = СтрокиНаУдаление.Количество();
	Для Каждого СтрокаНаУдаление Из СтрокиНаУдаление Цикл
		ЗамещенияСценарныхИндексов.Удалить(СтрокаНаУдаление);
	КонецЦикла;
	Если КоличествоУдаляемыхСтрок > 0 Тогда
		Предупреждение("Удалено (" + Формат(КоличествоУдаляемыхСтрок, "ЧГ=") + ") дубликатов строк.",,
			"Проверка введённых данных");
	КонецЕсли;
	
	// Сохранение локальных замещений сценарных индексов
	Объект.ЗамещенияСценарныхИндексов.Очистить();
	Для Каждого ЛокальныеЗамещениеСценарныхИндексов Из ЗамещенияСценарныхИндексов Цикл
		НоваяСтрока = Объект.ЗамещенияСценарныхИндексов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЛокальныеЗамещениеСценарныхИндексов);
	КонецЦикла;
	
	// Закрытие формы
	ЭтаФорма.Модифицированность = Ложь;
	Закрыть(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ЗамещенияСценарныхИндексовПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	ЗамещенияСценарныхИндексов.Сортировать("ТипАктива, КодВалюты, СценарныйИндекс, Идентификатор УБЫВ");
	ТекущиеДанные = Элементы.ЗамещенияСценарныхИндексов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Для проверки уникальности отсортированных строк
	ИндексТекущейСтроки = ЗамещенияСценарныхИндексов.Индекс(ТекущиеДанные);
	Если ИндексТекущейСтроки > 1 Тогда
		ПрошлаяСтрока = ЗамещенияСценарныхИндексов[ИндексТекущейСтроки - 1];
		Если ТекущиеДанные.ТипАктива = ПрошлаяСтрока.ТипАктива
			И ТекущиеДанные.КодВалюты = ПрошлаяСтрока.КодВалюты
			И ТекущиеДанные.СценарныйИндекс = ПрошлаяСтрока.СценарныйИндекс
		Тогда
			Отказ = Истина;
			Предупреждение("Строка с указанным типом актива, кодом валюты и сценарным индексом уже существует.",,
				"Проверка введённых данных");
		КонецЕсли;
	КонецЕсли;
	Если ИндексТекущейСтроки < ЗамещенияСценарныхИндексов.Количество() - 1 Тогда
		СледующаяСтрока = ЗамещенияСценарныхИндексов[ИндексТекущейСтроки + 1];
		Если ТекущиеДанные.ТипАктива = СледующаяСтрока.ТипАктива
			И ТекущиеДанные.КодВалюты = СледующаяСтрока.КодВалюты
			И ТекущиеДанные.СценарныйИндекс = СледующаяСтрока.СценарныйИндекс
		Тогда
			Отказ = Истина;
			Предупреждение("Строка с указанным типом актива, кодом валюты и сценарным индексом уже существует.",,
				"Проверка введённых данных");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗамещенияСценарныхИндексовПриИзменении(Элемент)
	// Сортировка поля "Идентификатор" идёт по убыванию, потому что новые элементы имеют значение 0,
	//	но должны быть в конце списка в рамках своего разреза.
	ЗамещенияСценарныхИндексов.Сортировать("ТипАктива, КодВалюты, СценарныйИндекс, Идентификатор УБЫВ");
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
 
 ОбъектОбработки = РеквизитФормыВЗначение("Объект");
 
 ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
 
 Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
 Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
  Механизм,
  ПараметрыВыполненияДляСбораСтатистики.Хранилище,
  ПараметрыВыполненияДляСбораСтатистики.Описание);
  
 ПараметрыСессии = Новый Структура;
 ПараметрыСессии.Вставить("Механизм",     Механизм);
 ПараметрыСессии.Вставить("Сессия",        Сессия);
 ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
 ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
  
 Возврат ПараметрыСессии;
 
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
 
 РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
  ПараметрыСессии.Механизм,
  ПараметрыСессии.Сессия,,
  ПараметрыСессии.ДопПараметры,
  ПараметрыСессии.ТекстОшибки);
 
КонецПроцедуры

#КонецОбласти
