#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	// Подпись на обновление при изменении текущей организации происходит автоматически
	//	при наличии клиентской экспортной процедуры "ПриСменеТекущейОрганизации"
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	// Добавление возможности сохранения настроек формы
	АдресПриЗагрузкеДанныхИзНастроекНаСервере = Неопределено;
	Если Параметры.Свойство("АдресПриЗагрузкеДанныхИзНастроекНаСервере", АдресПриЗагрузкеДанныхИзНастроекНаСервере) Тогда
		ПоместитьВоВременноеХранилище(Истина, АдресПриЗагрузкеДанныхИзНастроекНаСервере);
	КонецЕсли;
	
	// Календарь торговых дней
	Попытка
		Объект.КалендарьТорговыхДней = Справочники.Календари.НайтиПоНаименованию("Котировки");
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Объект.КалендарьТорговыхДней) Тогда
		Сообщить("Не найден календарь торговых дней (""Котировки"") в справочнике ""Календари"".");
	КонецЕсли;
	
	#Область ПоляПоУмолчанию
	// "Объект.Организации" по умолчанию
	Если Объект.Организации.Количество() = 0 Тогда
		// АО "РЕГИОН Траст"
		НоваяСтрока = Объект.Организации.Добавить();
		НоваяСтрока.Код = 220007;
		НоваяСтрока.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"); // РЕГИОН Траст
		// АО "РЕГИОН ЭсМ"
		НоваяСтрока = Объект.Организации.Добавить();
		НоваяСтрока.Код = 227027;
		НоваяСтрока.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"); // РЕГИОН ЭсМ
		// ООО УК "МД Траст"
		НоваяСтрока = Объект.Организации.Добавить();
		НоваяСтрока.Код = 232012;
		НоваяСтрока.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст"); // МД ТРАСТ
	КонецЕсли;
	// "Объект.ИспользуемаяБазаДанных" по умолчанию
	Если Не ЗначениеЗаполнено(Объект.ИспользуемаяБазаДанных)
		Или Элементы.ИспользуемаяБазаДанных.СписокВыбора.НайтиПоЗначению(Объект.ИспользуемаяБазаДанных) = Неопределено
	Тогда
		Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
			Объект.ИспользуемаяБазаДанных = "Рабочая";
		Иначе
			Объект.ИспользуемаяБазаДанных = "Тестовая";
		КонецЕсли;
	КонецЕсли;
	// "ВключатьАмортизируемыеОблигацииРыночногоVaR" по умолчанию
	ВключатьАмортизируемыеОблигацииРыночногоVaR = Ложь;
	// "ВидКлиентовРыночногоVaR" по умолчанию
	Если Не ЗначениеЗаполнено(ВидКлиентовРыночногоVaR)
		Или Элементы.ВидКлиентовРыночногоVaR.СписокВыбора.НайтиПоЗначению(ВидКлиентовРыночногоVaR) = Неопределено
	Тогда
		ВидКлиентовРыночногоVaR = "Индивидуальные";
	КонецЕсли;
	// "ИспользуемыеПоказатели" по умолчанию
	Если Не ЗначениеЗаполнено(ИспользуемыеПоказатели)
		Или Элементы.ИспользуемыеПоказатели.СписокВыбора.НайтиПоЗначению(ИспользуемыеПоказатели) = Неопределено
	Тогда
		ИспользуемыеПоказатели = "Учетные";
	КонецЕсли;
	// "ПоведениеРасчета" по умолчанию
	Если Не ЗначениеЗаполнено(ПоведениеРасчета)
		Или Элементы.ПоведениеРасчета.СписокВыбора.НайтиПоЗначению(ПоведениеРасчета) = Неопределено
	Тогда
		ПоведениеРасчета = "Быстрый";
	КонецЕсли;
	// "ПорядокКлиентов" по умолчанию
	Если Не ЗначениеЗаполнено(ПорядокКлиентов)
		Или Элементы.ПорядокКлиентов.СписокВыбора.НайтиПоЗначению(ПорядокКлиентов) = Неопределено
	Тогда
		ПорядокКлиентов = "Наименование";
	КонецЕсли;
	// "КоличествоИтерацийДляКредитногоVaR" по умолчанию
	Если Не ЗначениеЗаполнено(КоличествоИтерацийДляКредитногоVaR) Тогда
		КоличествоИтерацийДляКредитногоVaR = 10000;
	КонецЕсли;
	#КонецОбласти
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИдентификаторСессииПриИзменении(Неопределено);
	НестандартнаяДатаОкончанияКредитногоVaRПриИзменении(Неопределено);
	НестандартнаяДатаОкончанияСценарногоАнализаПриИзменении(Неопределено);
	КоличествоИтерацийДляКредитногоVaRРегулирование();
	ВключитьАмортизируемыеОблигацииПриИзменении(Неопределено);
	КомандаВидыКлиентовВыделитьВсе(Неопределено);
	ФильтрованныеКлиентыПослеИзмененияПометки();
	ПорядокКлиентовПриИзменении(Неопределено);
	
	// Обновление полей нужно производить после загрузки сохранённых настроек, чтобы не происходило повторного обновления параметров
	ИспользуемаяБазаДанныхПриИзмененииНаСервере(); // ДатаРасчетаПриИзмененииНаСервере() включена внутрь
	// Удаление лишнего переноса строки в начале информационного текста
	Объект.ИнформационныйТекст = СокрЛ(Объект.ИнформационныйТекст);
КонецПроцедуры

// В этой процедуре неверный формат простителен, т.к. может подтягиваться от старых версий обработки, поэтому ошибки загрузки надо обрабатывать.
//	После загрузки настроек обновление параметров формы происходит в процедуре "ПриОткрытии".
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	// При ошибке в этой процедуре кладётся весь клиент, поэтому нужно обработать
	Попытка
		Если Настройки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ОшибкиЗагрузкиДанныхИзНастроек = Новый Соответствие; // Соответствие(Строка (Ключ), Строка (Описание))
		Маршрутизация = ПолучитьМаршрутизациюДанныхИзНастроек();
		Для Каждого СтрокаМаршрутизации Из Маршрутизация Цикл
			СохраненныйРеквизит = Настройки.Получить(СтрокаМаршрутизации.Ключ);
			// Проверка наличия сохранённого значения реквизита:
			//	Не нужно выводить ошибку, потому что реквизиты в новых версиях могут переименовываться.
			Если СохраненныйРеквизит = Неопределено Тогда
				//ОшибкиЗагрузкиДанныхИзНастроек.Вставить(СтрокаМаршрутизации.Реквизит, "Значение реквизита отсутствует в последнем сохранении.");
				Продолжить;
			КонецЕсли;
			// Проверка существования реквизита, для которого сохранено значение
			Попытка
				НачалоИменКолонок = СтрНайти(СтрокаМаршрутизации.Реквизит, "(");
				Если НачалоИменКолонок <> 0 Тогда
					Реквизит = Лев(СтрокаМаршрутизации.Реквизит, НачалоИменКолонок - 1);
					ТекущийРеквизит = СтрокаМаршрутизации.Объект[Реквизит];
				Иначе
					ТекущийРеквизит = СтрокаМаршрутизации.Объект[СтрокаМаршрутизации.Реквизит];
				КонецЕсли;
			Исключение
				ОшибкиЗагрузкиДанныхИзНастроек.Вставить(СтрокаМаршрутизации.Реквизит, "Реквизит, для которого сохранено значение, отсутствует или переименован.");
				Продолжить;
			КонецПопытки;
			// Проверка совместимости типов данных реквизита и его сохранённого значения
			Если ТипЗнч(ТекущийРеквизит) <> ТипЗнч(СохраненныйРеквизит) И ТипЗнч(ТекущийРеквизит) <> Тип("ДанныеФормыКоллекция") Тогда
				ОшибкиЗагрузкиДанныхИзНастроек.Вставить(СтрокаМаршрутизации.Реквизит,
					"Сохранённый реквизит имеет другой тип данных - """ + ТипЗнч(СохраненныйРеквизит) + """. Требуется тип """ + ТипЗнч(ТекущийРеквизит) + """.");
				Продолжить;
			КонецЕсли;
			// Установка значения реквизита
			Если ТипЗнч(ТекущийРеквизит) = Тип("ДанныеФормыКоллекция") Тогда
				Если СохраненныйРеквизит.Количество() > 0 Тогда
					ТекущийРеквизит.Очистить();
				КонецЕсли;
				Для Каждого СохраненнаяСтрокаКоллекции Из СохраненныйРеквизит Цикл
					НоваяСтрока = ТекущийРеквизит.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СохраненнаяСтрокаКоллекции);
				КонецЦикла;
			Иначе
				СтрокаМаршрутизации.Объект[СтрокаМаршрутизации.Реквизит] = СохраненныйРеквизит;
			КонецЕсли;
		КонецЦикла;
		Если ОшибкиЗагрузкиДанныхИзНастроек.Количество() > 0 Тогда
			ТекстУведомления = "Произошли следующий ошибки при загрузке данных из сохранённых настроек:" + Символы.ПС;
			Для Каждого ТекущаяОшибка Из ОшибкиЗагрузкиДанныхИзНастроек Цикл
				ТекстУведомления = ТекстУведомления + Символы.Таб + """" + ТекущаяОшибка.Ключ + """: " + ТекущаяОшибка.Значение + Символы.ПС;
			КонецЦикла;
			Сообщить(СокрП(ТекстУведомления));
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	// При ошибке в этой процедуре кладётся весь клиент, поэтому нужно обработать
	Попытка
		Маршрутизация = ПолучитьМаршрутизациюДанныхИзНастроек();
		Для Каждого СтрокаМаршрутизации Из Маршрутизация Цикл
			// Поиск реквизита по маршрутизации
			НачалоИменКолонок = СтрНайти(СтрокаМаршрутизации.Реквизит, "(");
			Если НачалоИменКолонок <> 0 Тогда
				Реквизит = Лев(СтрокаМаршрутизации.Реквизит, НачалоИменКолонок - 1);
				СохраняемыйРеквизит = СтрокаМаршрутизации.Объект[Реквизит];
			Иначе
				СохраняемыйРеквизит = СтрокаМаршрутизации.Объект[СтрокаМаршрутизации.Реквизит];
			КонецЕсли;
			// Сохранение значения реквизита
			Если ТипЗнч(СохраняемыйРеквизит) = Тип("ДанныеФормыКоллекция") Тогда
				КонецИменКолонок = СтрНайти(СтрокаМаршрутизации.Реквизит, ")");
				Если НачалоИменКолонок > 0 И КонецИменКолонок > НачалоИменКолонок Тогда
					Реквизит = Лев(СтрокаМаршрутизации.Реквизит, НачалоИменКолонок - 1);
					ИменаКолонок = Сред(СтрокаМаршрутизации.Реквизит, НачалоИменКолонок + 1, КонецИменКолонок - НачалоИменКолонок - 1);
				Иначе
					Сообщить("Неверно указана маршрутизация реквизита """ + СтрокаМаршрутизации.Ключ + """.");
					Продолжить;
				КонецЕсли;
				СохраняемыйМассив = Новый Массив; // Массив(Структура(...))
				Для Каждого СохраняемаяСтрокаКоллекции Из СохраняемыйРеквизит Цикл
					СохраняемаяСтруктура = Новый Структура(ИменаКолонок);
					ЗаполнитьЗначенияСвойств(СохраняемаяСтруктура, СохраняемаяСтрокаКоллекции);
					СохраняемыйМассив.Добавить(СохраняемаяСтруктура);
				КонецЦикла;
				Настройки.Вставить(СтрокаМаршрутизации.Ключ, СохраняемыйМассив);
			Иначе
				Настройки.Вставить(СтрокаМаршрутизации.Ключ, СохраняемыйРеквизит);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИспользуемаяБазаДанныхПриИзменении(Элемент)
	ИспользуемаяБазаДанныхПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИспользуемаяБазаДанныхПриИзмененииНаСервере()
	// Окончание текущей сессии
	Объект.ИдентификаторСессии = 0;
	ИдентификаторСессииПриИзмененииНаСервере();
	
	// Изменение параметров соединения с SQL
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.УстановитьПараметрыСоединенияСSQL();
	
	// Старт новой сессии
	НачатьСессиюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторСессииПриИзменении(Элемент)
	ЕстьИдентификаторСессии = Объект.ИдентификаторСессии <> 0;
	Элементы.ГруппаКнопкиРасчета.Доступность = ЕстьИдентификаторСессии;
	Элементы.ФильтрованныеКлиенты.Доступность = ЕстьИдентификаторСессии;
КонецПроцедуры

// Копия процедуры "ИдентификаторСессииПриИзменении" на сервере
&НаСервере
Процедура ИдентификаторСессииПриИзмененииНаСервере()
	ЕстьИдентификаторСессии = Объект.ИдентификаторСессии <> 0;
	Элементы.ГруппаКнопкиРасчета.Доступность = ЕстьИдентификаторСессии;
	Элементы.ФильтрованныеКлиенты.Доступность = ЕстьИдентификаторСессии;
КонецПроцедуры

&НаКлиенте
Процедура ДатаРасчетаПриИзменении(Элемент)
	Если Объект.ИдентификаторСессии = 0 Тогда
		Возврат;
	КонецЕсли;
	ДатаРасчетаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаРасчетаПриИзмененииНаСервере()
	// Копия проверок из процедуры "ДатаРасчетаПриИзменении"
	Если Объект.ИдентификаторСессии = 0 Тогда
		Возврат;
	КонецЕсли;
	ШаблонЗаголовкаСпискаКлиентов = "Список клиентов на <ДатаРасчета>";
	Элементы.ФильтрованныеКлиенты.Заголовок = СтрЗаменить(ШаблонЗаголовкаСпискаКлиентов,
		"<ДатаРасчета>", Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy"));
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.ЗагрузитьВидыКлиентов();
	ОбъектЗначение.ЗагрузитьКлиентов();
	ЗначениеВРеквизитФормы(ОбъектЗначение, "Объект");
	ОбъектВидыКлиентовПриИзмененииСоставаНаСервере();
	ОбъектКлиентыПриИзмененииСоставаНаСервере();
	
	Элементы.ДекорацияСтандартнаяДатаОкончанияКредитногоVaR.Заголовок =
		СтрЗаменить("Дата окончания: <ДатаОкончания>", "<ДатаОкончания>", Формат(ДобавитьМесяц(Объект.ДатаРасчета, 12), "ДФ=dd.MM.yyyy"));
КонецПроцедуры

&НаКлиенте
Процедура НестандартнаяДатаОкончанияКредитногоVaRПриИзменении(Элемент)
	Элементы.ДатаОкончанияКредитногоVaR.Видимость = ИспользоватьНестандартнуюДатуОкончанияКредитногоVaR;
	Элементы.ДекорацияСтандартнаяДатаОкончанияКредитногоVaR.Видимость = Не ИспользоватьНестандартнуюДатуОкончанияКредитногоVaR;
КонецПроцедуры

&НаКлиенте
Процедура КоличествоИтерацийДляКредитногоVaRРегулирование(Элемент = Неопределено, Направление = 0, СтандартнаяОбработка = Истина)
	СтандартнаяОбработка = Ложь;
	КоличествоИтерацийДляКредитногоVaR = КоличествоИтерацийДляКредитногоVaR + Направление * 1000;
	Если КоличествоИтерацийДляКредитногоVaR > Элементы.КоличествоИтерацийДляКредитногоVaR.МаксимальноеЗначение Тогда
		КоличествоИтерацийДляКредитногоVaR = Элементы.КоличествоИтерацийДляКредитногоVaR.МаксимальноеЗначение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВключитьАмортизируемыеОблигацииПриИзменении(Элемент)
	Элементы.ВключатьАмортизируемыеОблигацииСценарногоАнализа.Заголовок = ?(ВключатьАмортизируемыеОблигацииСценарногоАнализа,
		"Аморт. обл.", "Включать в расчёт амортизируемые облигации");
	Элементы.ВключатьАмортизируемыеОблигацииСценарногоАнализа.ПоложениеЗаголовка = ?(ВключатьАмортизируемыеОблигацииСценарногоАнализа,
