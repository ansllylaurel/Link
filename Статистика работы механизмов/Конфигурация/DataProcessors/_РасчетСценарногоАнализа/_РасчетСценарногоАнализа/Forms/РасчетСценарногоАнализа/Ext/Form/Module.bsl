&НаСервере
Функция ПолучитьМаршрутизациюДанныхИзНастроек()
	// Маршрутизация загрузки данных из настроек:
	//	Для реквизитов-коллекций используются массивы структур, а после
	//	названия реквизита в скобках указываются сохраняемые колонки через запятую.
	Маршрутизация = Новый Массив; // Массив(Структура("Ключ": Строка, "Объект": Произвольный, "Реквизит": Строка))
	Ключи = "Ключ, Объект, Реквизит";
	Маршрутизация.Добавить(Новый Структура(Ключи, "ИспользуемаяБазаДанных", Объект, "ИспользуемаяБазаДанных"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ДатаРасчета", Объект, "ДатаРасчета"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "НомерРасчета", Объект, "НомерРасчета"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ПоведениеРасчета", ЭтаФорма, "ПоведениеРасчета"));
	// Кредитный VaR
	Маршрутизация.Добавить(Новый Структура(Ключи, "ИспользоватьНестандартнуюДатуОкончанияКредитногоVaR", ЭтаФорма, "ИспользоватьНестандартнуюДатуОкончанияКредитногоVaR"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ДатаОкончанияКредитногоVaR", ЭтаФорма, "ДатаОкончанияКредитногоVaR"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "КоличествоИтерацийДляКредитногоVaR", ЭтаФорма, "КоличествоИтерацийДляКредитногоVaR"));
	// Рыночный VaR
	Маршрутизация.Добавить(Новый Структура(Ключи, "ВключатьАмортизируемыеОблигацииРыночногоVaR", ЭтаФорма, "ВключатьАмортизируемыеОблигацииРыночногоVaR"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ВидКлиентовРыночногоVaR", ЭтаФорма, "ВидКлиентовРыночногоVaR"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ВключатьАмортизируемыеОблигацииСценарногоАнализа", ЭтаФорма, "ВключатьАмортизируемыеОблигацииСценарногоАнализа"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ИспользуемыеПоказатели", ЭтаФорма, "ИспользуемыеПоказатели"));
	// Сценарный VaR
	Маршрутизация.Добавить(Новый Структура(Ключи, "ИспользоватьНестандартнуюДатуОкончанияСценарногоАнализа", ЭтаФорма, "ИспользоватьНестандартнуюДатуОкончанияСценарногоАнализа"));
	Маршрутизация.Добавить(Новый Структура(Ключи, "ДатаОкончанияСценарногоАнализа", ЭтаФорма, "ДатаОкончанияСценарногоАнализа"));
	// Организации будут настраиваться хардкодом, чтобы не подтягивались старые настройки при изменении кодов организаций
	//Маршрутизация.Добавить(Новый Структура(Ключи, "Организации", Объект, "Организации(Код, Организация)"));
	Возврат Маршрутизация;
КонецФункции

&НаСервере
Процедура ПолучитьИВывестиИнформационныйТекст()
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.ПолучитьИВывестиИнформационныйТекст();
