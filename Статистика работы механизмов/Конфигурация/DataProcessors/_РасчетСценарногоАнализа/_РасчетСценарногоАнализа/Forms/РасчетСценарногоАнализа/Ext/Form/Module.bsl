&НаКлиенте
Процедура ДобавитьИнформационныйТекст(ДобавляемыйТекст, НоваяСтрока = Истина)
	ТекущаяДатаСОформлением = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Объект.ИнформационныйТекст = Объект.ИнформационныйТекст + ?(НоваяСтрока, Символы.ПС + ТекущаяДатаСОформлением, "")
		+ СтрЗаменить(ДобавляемыйТекст, Символы.ПС, Символы.ПС + Символы.Таб);
КонецПроцедуры

// Копия процедуры "ДобавитьИнформационныйТекст" на сервере
&НаСервере
Процедура ДобавитьИнформационныйТекстНаСервере(ДобавляемыйТекст, НоваяСтрока = Истина)
	ТекущаяДатаСОформлением = "[" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "] ";
	Объект.ИнформационныйТекст = Объект.ИнформационныйТекст + ?(НоваяСтрока, Символы.ПС + ТекущаяДатаСОформлением, "")
		+ СтрЗаменить(ДобавляемыйТекст, Символы.ПС, Символы.ПС + Символы.Таб);
КонецПроцедуры

// Т.к. фильтрованные клиенты не обязательно содержат весь текущий список клиентов,
//		то и пометки мы узнать не сможем, если список клиентов был обновлён.
//	При обновлении списка клиентов у объекта пометки автоматически переносятся.
//	Всё, что нам остаётся, - обновить список выбранных клиентов.
//
// Счётчик фильтрованных клиентов здесь не изменяется, - для этого есть обработчик "ФильтрованныеКлиентыПослеИзмененияПометки"
&НаСервере
Процедура ОбъектВидыКлиентовПриИзмененииСоставаНаСервере()
	// Перенос пометок со старых видов клиентов
	УникальныеВидыКлиентов = Новый Соответствие; // Соответствие(Строка (Вид клиента), Булево (Выбрано))
	Для Каждого СтрокаВидыКлиентов Из Объект.ВидыКлиентов Цикл
		УникальныеВидыКлиентов.Вставить(СтрокаВидыКлиентов.Наименование, Ложь);
	КонецЦикла;
	Для Каждого СтрокаФильтрВидыКлиентов Из ФильтрВидыКлиентов Цикл
		Если Не СтрокаФильтрВидыКлиентов.Выбрано Тогда
			Продолжить;
		КонецЕсли;
		Если УникальныеВидыКлиентов.Получить(СтрокаФильтрВидыКлиентов.Наименование) <> Неопределено Тогда
			УникальныеВидыКлиентов.Вставить(СтрокаФильтрВидыКлиентов.Наименование, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// Добавление новых видов клиентов
	ФильтрВидыКлиентов.Очистить();
	Для Каждого КлючЗначение Из УникальныеВидыКлиентов Цикл
		НоваяСтрока = ФильтрВидыКлиентов.Добавить();
		НоваяСтрока.Наименование = КлючЗначение.Ключ;
		НоваяСтрока.Выбрано = КлючЗначение.Значение;
	КонецЦикла;
	ФильтрВидыКлиентов.Сортировать("Наименование");
	
	ФильтрВидыКлиентовВыбраноПриИзмененииНаСервере();
	ФильтрованныеКлиентыПослеИзмененияПометкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбъектКлиентыПриИзмененииСоставаНаСервере()
	// Расчёт количества клиентов по видам клиентов
	КоличествоКлиентовПоВидамКлиентов = Новый Соответствие; // Соответствие(Строка (Вид клиента), Число (Количество клиентов))
	Для Каждого СтрокаКлиенты Из Объект.Клиенты Цикл
		ТекущееЗначение = КоличествоКлиентовПоВидамКлиентов.Получить(СтрокаКлиенты.Вид);
		Если ТекущееЗначение = Неопределено Тогда
			КоличествоКлиентовПоВидамКлиентов.Вставить(СтрокаКлиенты.Вид, 1);
		Иначе
			КоличествоКлиентовПоВидамКлиентов.Вставить(СтрокаКлиенты.Вид, ТекущееЗначение + 1);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаФильтрВидыКлиентов из ФильтрВидыКлиентов Цикл
		НайденноеКоличество = КоличествоКлиентовПоВидамКлиентов.Получить(СтрокаФильтрВидыКлиентов.Наименование);
		Если НайденноеКоличество <> Неопределено Тогда
			СтрокаФильтрВидыКлиентов.КоличествоКлиентов = НайденноеКоличество;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуКодовВыбранныхКлиентов()
	КодыКлиентов = "";
	Для Каждого СтрокаКлиентов Из Объект.Клиенты Цикл
		Если Не СтрокаКлиентов.Выбрано Тогда
			Продолжить;
		КонецЕсли;
		КодыКлиентов = КодыКлиентов + ", " + СтрокаКлиентов.Код;
	КонецЦикла;
	Если СтрНачинаетсяС(КодыКлиентов, ", ") Тогда
		КодыКлиентов = Прав(КодыКлиентов, СтрДлина(КодыКлиентов) - 2);
	КонецЕсли;
	КодыКлиентов = СокрЛП(КодыКлиентов);
	Возврат КодыКлиентов;
КонецФункции

&НаКлиенте
Процедура ФильтрованныеКлиентыПриИзмененииПометки(СтрокаФильтрованныеКлиенты)
	Если СтрокаФильтрованныеКлиенты <> Неопределено Тогда
		СтрокаКлиенты = Объект.Клиенты.НайтиПоИдентификатору(СтрокаФильтрованныеКлиенты.ИдентификаторОригинальнойСтроки);
		СтрокаКлиенты.Выбрано = СтрокаФильтрованныеКлиенты.Выбрано;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрованныеКлиентыПослеИзмененияПометки()
	// Перерасчёт количества клиентов
	КоличествоКлиентов = 0;
	КоличествоВыбранныхКлиентов = 0;
	Для Каждого ТекущийКлиент Из Объект.Клиенты Цикл
		КоличествоКлиентов = КоличествоКлиентов + 1;
		Если ТекущийКлиент.Выбрано Тогда
			КоличествоВыбранныхКлиентов = КоличествоВыбранныхКлиентов + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Копия процедуры "ФильтрованныеКлиентыПослеИзмененияПометки" на сервере
&НаСервере
Процедура ФильтрованныеКлиентыПослеИзмененияПометкиНаСервере()
	// Перерасчёт количества клиентов
	КоличествоКлиентов = 0;
	КоличествоВыбранныхКлиентов = 0;
	Для Каждого ТекущийКлиент Из Объект.Клиенты Цикл
		КоличествоКлиентов = КоличествоКлиентов + 1;
		Если ТекущийКлиент.Выбрано Тогда
			КоличествоВыбранныхКлиентов = КоличествоВыбранныхКлиентов + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

