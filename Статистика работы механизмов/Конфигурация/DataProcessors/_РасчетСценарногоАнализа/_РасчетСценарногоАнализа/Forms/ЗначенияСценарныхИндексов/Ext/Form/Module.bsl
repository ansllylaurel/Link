	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДеревоЗначенийСценарныхИндексовКонтекстноеМенюСвернутьДоДюраций()
	
		СтрокиСценариев = ДеревоЗначенийСценарныхИндексов.ПолучитьЭлементы();
		Для Каждого СтрокаСценариев Из СтрокиСценариев Цикл
			Элементы.ЗначенияСценарныхИндексов.Развернуть(СтрокаСценариев.ПолучитьИдентификатор());
			СтрокиСценарныхИндексов = СтрокаСценариев.ПолучитьЭлементы();
			Для Каждого СтрокаСценарныхИндексов Из СтрокиСценарныхИндексов Цикл
				СтрокиДюраций = СтрокаСценарныхИндексов.ПолучитьЭлементы();
				ЕстьРазныеДюрации = Ложь;
				Для Каждого СтрокаДюраций Из СтрокиДюраций Цикл
					Если СтрокаДюраций.Дюрация <> 0 Тогда
						ЕстьРазныеДюрации = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				// Строки без разреза по дюрации не разворачиваются
				Если Не ЕстьРазныеДюрации Тогда
					Элементы.ЗначенияСценарныхИндексов.Свернуть(СтрокаСценарныхИндексов.ПолучитьИдентификатор());
					Продолжить;
				КонецЕсли;
				Элементы.ЗначенияСценарныхИндексов.Развернуть(СтрокаСценарныхИндексов.ПолучитьИдентификатор());
				Для Каждого СтрокаДюраций Из СтрокиДюраций Цикл
					Если СтрокаДюраций.ПолучитьЭлементы().Количество() > 0 Тогда
						Элементы.ЗначенияСценарныхИндексов.Свернуть(СтрокаДюраций.ПолучитьИдентификатор());
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	
КонецПроцедуры

