&НаКлиенте
Процедура СценарииПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Применение изменений
	ДанныеОтличаются = Объект.ГруппаСценариев <> Результат.ГруппаСценариев
		Или ТаблицыОтличаются(Объект.Сценарии, Результат.Сценарии, "Идентификатор, Наименование");
	Если ДанныеОтличаются Тогда
		Объект.ГруппаСценариев = Результат.ГруппаСценариев;
		Объект.Сценарии.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.Сценарии Цикл
			НоваяСтрока = Объект.Сценарии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
		ОбновитьДеревоЗначенийСценарныхИндексов();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДюрацииИРеперныеДатыПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Применение изменений
	ДюрацииОтличаются = ТаблицыОтличаются(Объект.Дюрации, Результат.Дюрации, "СценарныйИндекс, Дюрация");
	РеперныеДатыОтличаются = ТаблицыОтличаются(Объект.РеперныеДаты, Результат.РеперныеДаты, "СценарныйИндекс, РепернаяДата, ДнейСНачала, ТорговыхДнейСНачала");
	СценарныеИндексыОтличаются = ТаблицыОтличаются(Объект.СценарныеИндексы, Результат.СценарныеИндексы, "ЕстьРазрезПоДюрации");
	МодельныеДоходностиИДюрацииОтличаются = ТаблицыОтличаются(Объект.МодельныеДоходностиИДюрации, Результат.МодельныеДоходностиИДюрации,
		"СценарныйИндекс, Дюрация, МодельнаяДюрация, МодельнаяДоходность, Формула");
	ПриращенияДоходностиОтличаются = ТаблицыОтличаются(Объект.ПриращенияДоходности, Результат.ПриращенияДоходности,
		"Сценарий, СценарныйИндекс, РепернаяДата, Дюрация, ПриращениеДоходности, Формула");
	ДанныеОтличаются = ДюрацииОтличаются Или РеперныеДатыОтличаются Или СценарныеИндексыОтличаются
		Или МодельныеДоходностиИДюрацииОтличаются Или ПриращенияДоходностиОтличаются;
	Если ДюрацииОтличаются Тогда
		Объект.Дюрации.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.Дюрации Цикл
			НоваяСтрока = Объект.Дюрации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
	КонецЕсли;
	Если РеперныеДатыОтличаются Тогда
		Объект.РеперныеДаты.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.РеперныеДаты Цикл
			НоваяСтрока = Объект.РеперныеДаты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
	КонецЕсли;
	Если СценарныеИндексыОтличаются Тогда
		Объект.СценарныеИндексы.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.СценарныеИндексы Цикл
			НоваяСтрока = Объект.СценарныеИндексы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
	КонецЕсли;
	Если МодельныеДоходностиИДюрацииОтличаются Тогда
		Объект.МодельныеДоходностиИДюрации.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.МодельныеДоходностиИДюрации Цикл
			НоваяСтрока = Объект.МодельныеДоходностиИДюрации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
	КонецЕсли;
	Если ПриращенияДоходностиОтличаются Тогда
		Объект.ПриращенияДоходности.Очистить();
		Для Каждого ДобавляемаяСтрока Из Результат.ПриращенияДоходности Цикл
			НоваяСтрока = Объект.ПриращенияДоходности.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемаяСтрока);
		КонецЦикла;
	КонецЕсли;
	Если ДанныеОтличаются Тогда
		ОбновитьДеревоЗначенийСценарныхИндексов();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

