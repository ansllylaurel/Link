&НаКлиенте
Процедура КомандаСкопироватьЗначения(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСкопироватьЗначения");
	Попытка
		ВыполнитьКомандаСкопироватьЗначения();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
