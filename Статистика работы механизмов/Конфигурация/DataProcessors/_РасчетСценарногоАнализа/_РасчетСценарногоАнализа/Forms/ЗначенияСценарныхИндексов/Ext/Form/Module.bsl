&НаКлиенте
Процедура ВыполнитьКомандаЗаписать()
	
		Если КомандаЗаписатьНаСервере() Тогда
			Предупреждение("Значения сценарных индексов успешно записаны.",, "Результат");
			ЭтаФорма.Модифицированность = Ложь;
		КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаЗаписатьНаСервере()
	// Дополнительная проверка во избежание удаления всех значений сценарных индексов
	Если Не ЗначениеЗаполнено(Объект.ДатаРасчета)
		Или Не ЗначениеЗаполнено(Объект.НомерРасчета)
	Тогда
		Сообщить("Не заполнены дата и/или номер расчёта.");
		Возврат Ложь;
	КонецЕсли;
	
	ВнешниеИсточникиДанных.RiskControl.НачатьТранзакцию();
	
	Попытка
		ЕстьРазрезПоДюрацииПоСценарнымИндексам = Новый Соответствие; // Соответствие(Число (Сценарный индекс), Булево (Есть разрез по дюрации))
		Для Каждого СтрокаСценарныхИндексов Из Объект.СценарныеИндексы Цикл
			ЕстьРазрезПоДюрацииПоСценарнымИндексам.Вставить(СтрокаСценарныхИндексов.Идентификатор, СтрокаСценарныхИндексов.ЕстьРазрезПоДюрации);
		КонецЦикла;
		
		// Изменение приращений доходностей в базе
		НаборЗаписей = ВнешниеИсточникиДанных.RiskControl.Таблицы.T_Scenario_Indexes_Values.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.AssetDate.Установить(Объект.ДатаРасчета);
		НаборЗаписей.Отбор.CalcID.Установить(Объект.НомерРасчета);
		Для Каждого СтрокаПриращенийДоходности Из Объект.ПриращенияДоходности Цикл
			НоваяСтрокаЗаписей = НаборЗаписей.Добавить();
			НоваяСтрокаЗаписей.AssetDate = Объект.ДатаРасчета;
			НоваяСтрокаЗаписей.CalcID = Объект.НомерРасчета;
			НоваяСтрокаЗаписей.ScenarioID = СтрокаПриращенийДоходности.Сценарий;
			НоваяСтрокаЗаписей.IndexID = СтрокаПриращенийДоходности.СценарныйИндекс;
			ЕстьРазрезПоДюрации = ЕстьРазрезПоДюрацииПоСценарнымИндексам.Получить(СтрокаПриращенийДоходности.СценарныйИндекс);
			НоваяСтрокаЗаписей.DurationYears = ?(ЕстьРазрезПоДюрации, СтрокаПриращенийДоходности.Дюрация, NULL);
			НоваяСтрокаЗаписей.Date = СтрокаПриращенийДоходности.РепернаяДата;
			НоваяСтрокаЗаписей.DeltaValue = СтрокаПриращенийДоходности.ПриращениеДоходности;
			НоваяСтрокаЗаписей.Formula = ?(ПустаяСтрока(СтрокаПриращенийДоходности.Формула), NULL, СтрокаПриращенийДоходности.Формула);
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
		
		// Изменение модельных доходностей и дюрации в базе
		НаборЗаписей = ВнешниеИсточникиДанных.RiskControl.Таблицы.T_Scenario_Model_Yields.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.AssetDate.Установить(Объект.ДатаРасчета);
		НаборЗаписей.Отбор.CalcID.Установить(Объект.НомерРасчета);
		Для Каждого СтрокаМодельныхДоходностейИДюраций Из Объект.МодельныеДоходностиИДюрации Цикл
			НоваяСтрокаЗаписей = НаборЗаписей.Добавить();
			НоваяСтрокаЗаписей.AssetDate = Объект.ДатаРасчета;
			НоваяСтрокаЗаписей.CalcID = Объект.НомерРасчета;
			НоваяСтрокаЗаписей.IndexID = СтрокаМодельныхДоходностейИДюраций.СценарныйИндекс;
			ЕстьРазрезПоДюрации = ЕстьРазрезПоДюрацииПоСценарнымИндексам.Получить(СтрокаМодельныхДоходностейИДюраций.СценарныйИндекс);
			НоваяСтрокаЗаписей.DurationYears = ?(ЕстьРазрезПоДюрации, СтрокаМодельныхДоходностейИДюраций.Дюрация, NULL);
			НоваяСтрокаЗаписей.CurrencyCode = "RUB";
			НоваяСтрокаЗаписей.ModelDurationYears = СтрокаМодельныхДоходностейИДюраций.МодельнаяДюрация;
			НоваяСтрокаЗаписей.YTM = СтрокаМодельныхДоходностейИДюраций.МодельнаяДоходность;
			НоваяСтрокаЗаписей.Formula = ?(ПустаяСтрока(СтрокаМодельныхДоходностейИДюраций.Формула), NULL, СтрокаМодельныхДоходностейИДюраций.Формула);
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
		
		// Изменение замещений сценарных индексов в базе
		НеобработанныеИдентификаторы = Новый Соответствие; // Соответствие(Число (Идентификатор), Истина)
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	T_Scenario_Indexes_Reinvestment_Replacement.ID КАК Идентификатор
			|ИЗ
			|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Indexes_Reinvestment_Replacement КАК T_Scenario_Indexes_Reinvestment_Replacement
			|ГДЕ
			|	T_Scenario_Indexes_Reinvestment_Replacement.AssetDate = &AssetDate
			|	И T_Scenario_Indexes_Reinvestment_Replacement.CalcID = &CalcID";
		Запрос.УстановитьПараметр("AssetDate", Объект.ДатаРасчета);
		Запрос.УстановитьПараметр("CalcID", Объект.НомерРасчета);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НеобработанныеИдентификаторы.Вставить(Выборка.Идентификатор, Истина);
		КонецЦикла;
		Для Каждого СтрокаЗамещенийСценарныхИндексов Из Объект.ЗамещенияСценарныхИндексов Цикл
			РедактируемыйОбъект = ?(ЗначениеЗаполнено(СтрокаЗамещенийСценарныхИндексов.Ссылка),
				СтрокаЗамещенийСценарныхИндексов.Ссылка.ПолучитьОбъект(),
				ВнешниеИсточникиДанных.RiskControl.Таблицы.T_Scenario_Indexes_Reinvestment_Replacement.СоздатьОбъект());
			РедактируемыйОбъект.AssetDate = Объект.ДатаРасчета;
			РедактируемыйОбъект.CalcID = Объект.НомерРасчета;
			РедактируемыйОбъект.AssetType = СтрокаЗамещенийСценарныхИндексов.ТипАктива;
			РедактируемыйОбъект.CurrencyCode = СтрокаЗамещенийСценарныхИндексов.КодВалюты;
			РедактируемыйОбъект.IndexID = СтрокаЗамещенийСценарныхИндексов.СценарныйИндекс;
			РедактируемыйОбъект.ReinvestmentIndexID = СтрокаЗамещенийСценарныхИндексов.ЗамещающийСценарныйИндекс;
			РедактируемыйОбъект.Записать();
			Если ЗначениеЗаполнено(РедактируемыйОбъект.ID) Тогда
				Если Не ЗначениеЗаполнено(СтрокаЗамещенийСценарныхИндексов.Ссылка) Тогда
					СтрокаЗамещенийСценарныхИндексов.Ссылка = РедактируемыйОбъект.Ссылка;
					СтрокаЗамещенийСценарныхИндексов.Идентификатор = РедактируемыйОбъект.ID;
				КонецЕсли;
				НеобработанныеИдентификаторы.Удалить(РедактируемыйОбъект.ID);
			КонецЕсли;
		КонецЦикла;
		Для Каждого НеобработанныйИдентификатор Из НеобработанныеИдентификаторы Цикл
			УдаляемаяСсылка = ВнешниеИсточникиДанных.RiskControl.Таблицы.T_Scenario_Indexes_Reinvestment_Replacement.НайтиПоПолю("ID", НеобработанныйИдентификатор.Ключ);
			Если ЗначениеЗаполнено(УдаляемаяСсылка) Тогда
				УдаляемыйОбъект = УдаляемаяСсылка.ПолучитьОбъект();
				УдаляемыйОбъект.Удалить();
			КонецЕсли;
		КонецЦикла;
		
		// Пометка прошлого сценарного анализа, как устаревшего
		ОписаниеОшибки = "";
		ПометитьСценарныйАнализКакУстаревший(Объект.ДатаРасчета, Объект.НомерРасчета, NULL, NULL, ОписаниеОшибки);
		Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
		
		ВнешниеИсточникиДанных.RiskControl.ЗафиксироватьТранзакцию();
	Исключение
		ВнешниеИсточникиДанных.RiskControl.ОтменитьТранзакцию();
		Сообщить(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

