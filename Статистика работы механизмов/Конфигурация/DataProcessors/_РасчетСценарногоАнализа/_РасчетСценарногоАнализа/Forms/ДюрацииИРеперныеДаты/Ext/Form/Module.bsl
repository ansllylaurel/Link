&НаКлиенте
Функция СгруппироватьЗначенияРеперныхДат(СтрокиТаблицы)
	Если СтрокиТаблицы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ЗначенияРеперныхДат = Новый СписокЗначений; // СписокЗначений(Дата / Строка (Реперная дата))
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		ЗначенияРеперныхДат.Добавить(СтрокаТаблицы.РепернаяДата);
	КонецЦикла;
	ЗначенияРеперныхДат.СортироватьПоЗначению();
	Для Итератор = 0 По ЗначенияРеперныхДат.Количество() - 1 Цикл
		ЗначенияРеперныхДат[Итератор].Значение = Формат(ЗначенияРеперныхДат[Итератор].Значение, "ДФ=yyyy-MM-dd");
	КонецЦикла;
	Возврат СтрСоединить(ЗначенияРеперныхДат.ВыгрузитьЗначения(), ", ");
КонецФункции

