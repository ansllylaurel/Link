#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.Объект, Объект);
	
	// Заполнение копий таблиц для изменений
	Для Каждого СтрокаДюраций Из Объект.Дюрации Цикл
		НоваяСтрока = Дюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДюраций);
	КонецЦикла;
	Для Каждого СтрокаРеперныхДат Из Объект.РеперныеДаты Цикл
		НоваяСтрока = РеперныеДаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеперныхДат);
	КонецЦикла;
	Для Каждого СтрокаМодельныхДоходностейИДюраций Из Объект.МодельныеДоходностиИДюрации Цикл
		НоваяСтрока = МодельныеДоходностиИДюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМодельныхДоходностейИДюраций);
	КонецЦикла;
	Для Каждого СтрокаПриращенийДоходности Из Объект.ПриращенияДоходности Цикл
		НоваяСтрока = ПриращенияДоходности.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПриращенийДоходности);
	КонецЦикла;
	
	// Формирование локальных сгруппированных дюраций и реперных дат
	СтрокиСценарныхИндексов = ДюрацииИРеперныеДаты.ПолучитьЭлементы();
	Для Каждого СтрокаСценарныхИндексов Из Объект.СценарныеИндексы Цикл
		НоваяСтрокаСценарныхИндексов = СтрокиСценарныхИндексов.Добавить();
		НоваяСтрокаСценарныхИндексов.СценарныйИндекс = СтрокаСценарныхИндексов.Идентификатор;
		НоваяСтрокаСценарныхИндексов.ГибридноеНаименованиеСценарногоИндекса =
			СтрокаСценарныхИндексов.Наименование + " (" + Формат(СтрокаСценарныхИндексов.Идентификатор, "ЧГ=") + ")";
		// Значения дюрации
		НайденныеСтрокиДюраций = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
		Для Каждого СтрокаДюраций Из Дюрации Цикл
			Если СтрокаДюраций.СценарныйИндекс = НоваяСтрокаСценарныхИндексов.СценарныйИндекс Тогда
				НайденныеСтрокиДюраций.Добавить(СтрокаДюраций);
			КонецЕсли;
		КонецЦикла;
		НоваяСтрокаСценарныхИндексов.ЗначенияДюрации = СгруппироватьЗначенияДюрацийНаСервере(НайденныеСтрокиДюраций);
		// Значения реперных дат
		НайденныеСтрокиРеперныхДат = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
		Для Каждого СтрокаРеперныхДат Из РеперныеДаты Цикл
			Если СтрокаРеперныхДат.СценарныйИндекс = НоваяСтрокаСценарныхИндексов.СценарныйИндекс Тогда
				НайденныеСтрокиРеперныхДат.Добавить(СтрокаРеперныхДат);
			КонецЕсли;
		КонецЦикла;
		НоваяСтрокаСценарныхИндексов.ЗначенияРеперныхДат = СгруппироватьЗначенияРеперныхДатНаСервере(НайденныеСтрокиРеперныхДат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ФлагЗакрытияФормы Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	// Подтверждение закрытия формы
	Если ЭтаФорма.Модифицированность Тогда
		Ответ = Вопрос("При закрытии формы изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Продолжение закрытия формы
	СтандартнаяОбработка = Истина;
	Отказ = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДюрацииИРеперныеДатыПриАктивизацииСтроки(Элемент = Неопределено)
	// Обновление таймера обработчика ожидания обновляется
	Если Не ЗапущенОбработчикОжидания Тогда
		ПрошлаяВозможностьРежимаРедактирования = ВозможностьРежимаРедактирования;
		УстановитьВозможностьСменыРежимаРедактирования(Ложь);
	КонецЕсли;
	ПодключитьОбработчикОжидания("ДюрацииИРеперныеДатыПослеАктивизацииСтроки", 0.1, Истина);
	ЗапущенОбработчикОжидания = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеДюрацииПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВыбранныеДюрации.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Дюрация < 0.001 Тогда
		ТекущиеДанные.Дюрация = 0.001;
	КонецЕсли;
	ВыбранныеДюрации.Сортировать("Дюрация");
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеДюрацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	// Фильтрация уникальных строк
	УникальныеВыбранныеДюрации = Новый Соответствие; // Соответствие(Число (Дюрация), ДанныеФормыЭлементКоллекции (ВыбранныеДюрации[]))
	Для Каждого СтрокаВыбранныхДюраций Из ВыбранныеДюрации Цикл
		НайденнаяСтрока = УникальныеВыбранныеДюрации.Получить(СтрокаВыбранныхДюраций.Дюрация);
		Если НайденнаяСтрока = Неопределено Тогда
			УникальныеВыбранныеДюрации.Вставить(СтрокаВыбранныхДюраций.Дюрация, СтрокаВыбранныхДюраций);
		ИначеЕсли Не ЗначениеЗаполнено(НайденнаяСтрока.ДюрацияДляПереноса) И ЗначениеЗаполнено(СтрокаВыбранныхДюраций.ДюрацияДляПереноса) Тогда
			УникальныеВыбранныеДюрации.Вставить(СтрокаВыбранныхДюраций.Дюрация, СтрокаВыбранныхДюраций);
		КонецЕсли;
	КонецЦикла;
	// Поиск лишних строк
	СтрокиНаУдаление = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции (ВыбранныеДюрации[]))
	Для Каждого СтрокаВыбранныхДюраций Из ВыбранныеДюрации Цикл
		Если УникальныеВыбранныеДюрации.Получить(СтрокаВыбранныхДюраций.Дюрация) <> СтрокаВыбранныхДюраций Тогда
			СтрокиНаУдаление.Добавить(СтрокаВыбранныхДюраций);
		КонецЕсли;
	КонецЦикла;
	// Удаление лишних строк
	Для Каждого СтрокаНаУдаление Из СтрокиНаУдаление Цикл
		ВыбранныеДюрации.Удалить(СтрокаНаУдаление);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеРеперныеДатыПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВыбранныеРеперныеДаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Проверка корректности введённых данных
	Если Не ЗначениеЗаполнено(ТекущиеДанные.РепернаяДата) Тогда
		Возврат;
	КонецЕсли;
	ИндексСтрокиВыбранныхРеперныхДат = ВыбранныеРеперныеДаты.Индекс(ТекущиеДанные);
	Для Каждого СтрокаВыбранныхРеперныхДат Из ВыбранныеРеперныеДаты Цикл
		Если ВыбранныеРеперныеДаты.Индекс(СтрокаВыбранныхРеперныхДат) <> ИндексСтрокиВыбранныхРеперныхДат
			И ТекущиеДанные.РепернаяДата = СтрокаВыбранныхРеперныхДат.РепернаяДата
		Тогда
			ПредупреждениеАсинх("Указанная реперная дата уже существует.",, "Проверка корректности введённых данных");
			ВыбранныеРеперныеДаты.Удалить(ТекущиеДанные);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	// Обновление полей строки
	ВыбранныеРеперныеДаты.Сортировать("РепернаяДата");
	ИндексПоследнейСтрокиРеперныхДат = ВыбранныеРеперныеДаты.Индекс(ТекущиеДанные) - 1;
	ТекущиеДанные.ДнейСНачала = (ТекущиеДанные.РепернаяДата - Объект.ДатаРасчета) / (60 * 60 * 24);
	ТорговыеДниРассчитаны = Ложь;
	// На дату расчёта ни одного дня ещё не прошло
	Если ТекущиеДанные.РепернаяДата = Объект.ДатаРасчета Тогда
		ТекущиеДанные.ТорговыхДнейСНачала = 0;
		ТорговыеДниРассчитаны = Истина;
	КонецЕсли;
	// Расчёт по календарю
	Если Не ТорговыеДниРассчитаны Тогда
		// Нельзя отлавливать исключения на клиенте, т.к. любые дальнейшие изменения таблицы будут отброшены
		КоличествоТорговыхДней = КоличествоТорговыхДней(Объект.ДатаРасчета, НачалоДня(ТекущиеДанные.РепернаяДата - 1));
		Если КоличествоТорговыхДней <> Неопределено Тогда
			ТекущиеДанные.ТорговыхДнейСНачала = КоличествоТорговыхДней;
			ТорговыеДниРассчитаны = Истина;
		Иначе
			Сообщить("Не удалось рассчитать количество торговых дней с " + Формат(Объект.ДатаРасчета, "ДФ=dd.MM.yyyy")
					+ " по " + Формат(НачалоДня(ТекущиеДанные.РепернаяДата - 1), "ДФ=dd.MM.yyyy") + "." + Символы.ПС
				+ "Расчёт будет произведёт приблизительно.");
		КонецЕсли;
	КонецЕсли;
	// Приблизительный расчёт
	Если Не ТорговыеДниРассчитаны Тогда
		ПоследняяСтрокаРеперныхДат = Неопределено;
		Если ИндексПоследнейСтрокиРеперныхДат >= 0 Тогда
			ПоследняяСтрокаРеперныхДат = ВыбранныеРеперныеДаты[ИндексПоследнейСтрокиРеперныхДат];
		КонецЕсли;
		// Учитывается рассчитанное значение для прошлой реперной даты
		Если ПоследняяСтрокаРеперныхДат <> Неопределено Тогда
			ТекущиеДанные.ТорговыхДнейСНачала = ПоследняяСтрокаРеперныхДат.ТорговыхДнейСНачала
				+ Цел((ТекущиеДанные.ДнейСНачала - ПоследняяСтрокаРеперныхДат.ДнейСНачала) * 5 / 7);
		Иначе
			ТекущиеДанные.ТорговыхДнейСНачала = Цел(ТекущиеДанные.ДнейСНачала * 5 / 7);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеРеперныеДатыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекущиеДанные = Элементы.ВыбранныеРеперныеДаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.РепернаяДата) Тогда
		ВыбранныеРеперныеДаты.Удалить(ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаРедактировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаРедактировать");
	Попытка
		ВыполнитьКомандаРедактировать(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаРедактировать(ПараметрыСессии)
	УстановитьРежимРедактирования(Истина);
	// Наполнение списка выбора дюраций для переноса
	Элементы.ВыбранныеДюрацииДюрацияДляПереноса.СписокВыбора.Очистить();
	Элементы.ВыбранныеДюрацииДюрацияДляПереноса.СписокВыбора.Добавить(0, "");
	Для Каждого СтрокаВыбранныхДюраций Из ВыбранныеДюрации Цикл
		Элементы.ВыбранныеДюрацииДюрацияДляПереноса.СписокВыбора.Добавить(СтрокаВыбранныхДюраций.Дюрация);
	КонецЦикла;
	// Наполнение списка выбора реперных дат для переноса
	Элементы.ВыбранныеРеперныеДатыРепернаяДатаДляПереноса.СписокВыбора.Очистить();
	Элементы.ВыбранныеРеперныеДатыРепернаяДатаДляПереноса.СписокВыбора.Добавить(Дата(1, 1, 1), "");
	Для Каждого СтрокаВыбранныхРеперныхДат Из ВыбранныеРеперныеДаты Цикл
		Элементы.ВыбранныеРеперныеДатыРепернаяДатаДляПереноса.СписокВыбора.Добавить(СтрокаВыбранныхРеперныхДат.РепернаяДата);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьРедактирование(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОтменитьРедактирование");
	Попытка
		ВыполнитьКомандаОтменитьРедактирование(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаОтменитьРедактирование(ПараметрыСессии)
	УстановитьРежимРедактирования(Ложь);
	// Возврат оригинальных строк в таблицы выбранных дюраций и выбранных реперных дат
	ДюрацииИРеперныеДатыПриАктивизацииСтроки();
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершитьРедактирование(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗавершитьРедактирование");
	Попытка
		ВыполнитьКомандаЗавершитьРедактирование(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаЗавершитьРедактирование(ПараметрыСессии)
	УстановитьРежимРедактирования(Ложь);
	// Проверка корректности данных
	Если ВыбранныеДюрации.Количество() = 1 Тогда
		ПредупреждениеАсинх("Наличие только одного значения дюрации не позволит сформировать сетку"
				+ " для трилинейной интерполяции модельной доходности и приращения доходности." + Символы.ПС + Символы.ПС
			+ "Значения дюрации очищены.",, "Предупреждение");
		ВыбранныеДюрации.Очистить();
	КонецЕсли;
	// Фильтрация выделенных строк
	ВсеВыделенныеСтроки = Элементы.ДюрацииИРеперныеДаты.ВыделенныеСтроки; // Без фильтрации от неподходящих строк
	ДанныеВыделенныхСтрок = Новый Массив; // Массив(Структура("СценарныйИндекс": Число, "ИдентификаторСтроки": Число (для ДюрацииИРеперныеДаты)))
	Для Каждого ВыделеннаяСтрока Из ВсеВыделенныеСтроки Цикл
		СтрокаСценарногоИндекса = ДюрацииИРеперныеДаты.НайтиПоИдентификатору(ВыделеннаяСтрока);
		ДанныеВыделенныхСтрок.Добавить(Новый Структура("СценарныйИндекс, ИдентификаторСтроки",
			СтрокаСценарногоИндекса.СценарныйИндекс, СтрокаСценарногоИндекса.ПолучитьИдентификатор()));
	КонецЦикла;
	// Подготовка ключей по измерениям для поиска строк (для их удаления и добавления)
	КлючиПоИзмерениям = Новый Соответствие; // Соответствие(Число (Сценарный индекс),
											//	Структура("СценарныйИндекс": Число, "ИдентификаторСтроки": Число (для ДюрацииИРеперныеДаты)))
	Для Каждого ДанныеВыделеннойСтроки Из ДанныеВыделенныхСтрок Цикл
		КлючиПоИзмерениям.Вставить(
			ДанныеВыделеннойСтроки.СценарныйИндекс,
			Новый Структура("ИдентификаторСтроки", ДанныеВыделеннойСтроки.ИдентификаторСтроки));
	КонецЦикла;
	// Удаление оригинальных строк дюраций, для которых предназначаются изменения
	СтрокиНаУдаление = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
	Для Каждого СтрокаДюраций Из Дюрации Цикл
		Если КлючиПоИзмерениям.Получить(СтрокаДюраций.СценарныйИндекс) <> Неопределено Тогда
			СтрокиНаУдаление.Добавить(СтрокаДюраций);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаДюраций Из СтрокиНаУдаление Цикл
		Дюрации.Удалить(СтрокаДюраций);
	КонецЦикла;
	// Удаление оригинальных строк реперных дат, для которых предназначаются изменения
	СтрокиНаУдаление = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
	Для Каждого СтрокаРеперныхДат Из РеперныеДаты Цикл
		Если КлючиПоИзмерениям.Получить(СтрокаРеперныхДат.СценарныйИндекс) <> Неопределено Тогда
			СтрокиНаУдаление.Добавить(СтрокаРеперныхДат);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаРеперныхДат Из СтрокиНаУдаление Цикл
		РеперныеДаты.Удалить(СтрокаРеперныхДат);
	КонецЦикла;
	// Добавление выбранных строк к оригинальным
	ЗначенияДюрации = СгруппироватьЗначенияДюраций(ВыбранныеДюрации);
	ЗначенияРеперныхДат = СгруппироватьЗначенияРеперныхДат(ВыбранныеРеперныеДаты);
	Для Каждого КлючЗначение Из КлючиПоИзмерениям Цикл
		Для Каждого СтрокаВыбранныхДюраций Из ВыбранныеДюрации Цикл
			НоваяСтрока = Дюрации.Добавить();
			НоваяСтрока.СценарныйИндекс = КлючЗначение.Ключ;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыбранныхДюраций);
		КонецЦикла;
		Для Каждого СтрокаВыбранныхРеперныхДат Из ВыбранныеРеперныеДаты Цикл
			НоваяСтрока = РеперныеДаты.Добавить();
			НоваяСтрока.СценарныйИндекс = КлючЗначение.Ключ;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыбранныхРеперныхДат);
		КонецЦикла;
		ДанныеВыделеннойСтроки = ДюрацииИРеперныеДаты.НайтиПоИдентификатору(КлючЗначение.Значение.ИдентификаторСтроки);
		ДанныеВыделеннойСтроки.ЗначенияДюрации = ЗначенияДюрации;
		ДанныеВыделеннойСтроки.ЗначенияРеперныхДат = ЗначенияРеперныхДат;
	КонецЦикла;
	// Подготовка к переносу значений
	ВыделенныеСценарныеИндексы = Новый Массив; // Массив(Число (Сценарный индекс))
	Для Каждого ДанныеВыделеннойСтроки Из ДанныеВыделенныхСтрок Цикл
		ВыделенныеСценарныеИндексы.Добавить(ДанныеВыделеннойСтроки.СценарныйИндекс);
	КонецЦикла;
	ПараметрыПереносаДюраций = Новый Массив; // Массив(Структура("Откуда": Число, "Куда": Число))
	Для Каждого СтрокаВыбранныхДюраций Из ВыбранныеДюрации Цикл
		Если СтрокаВыбранныхДюраций.ДюрацияДляПереноса > 0 Тогда
			ПараметрыПереносаДюраций.Добавить(Новый Структура("Откуда, Куда",
				СтрокаВыбранныхДюраций.ДюрацияДляПереноса, СтрокаВыбранныхДюраций.Дюрация));
		Иначе
			ПараметрыПереносаДюраций.Добавить(Новый Структура("Откуда, Куда",
				СтрокаВыбранныхДюраций.Дюрация, СтрокаВыбранныхДюраций.Дюрация));
		КонецЕсли;
	КонецЦикла;
	Если ПараметрыПереносаДюраций.Количество() = 0 Тогда
		// Пустые дюрации используются для тех сценарных индексов, у приращений доходности которых нет разреза по дюрации
		ПараметрыПереносаДюраций.Добавить(Новый Структура("Откуда, Куда", 0, 0));
	КонецЕсли;
	ПараметрыПереносаРеперныхДат = Новый Массив; // Массив(Структура("Откуда": Дата, "Куда": Дата))
	Для Каждого СтрокаВыбранныхРеперныхДат Из ВыбранныеРеперныеДаты Цикл
		Если ЗначениеЗаполнено(СтрокаВыбранныхРеперныхДат.РепернаяДатаДляПереноса) Тогда
			ПараметрыПереносаРеперныхДат.Добавить(Новый Структура("Откуда, Куда",
				СтрокаВыбранныхРеперныхДат.РепернаяДатаДляПереноса, СтрокаВыбранныхРеперныхДат.РепернаяДата));
		Иначе
			ПараметрыПереносаРеперныхДат.Добавить(Новый Структура("Откуда, Куда",
				СтрокаВыбранныхРеперныхДат.РепернаяДата, СтрокаВыбранныхРеперныхДат.РепернаяДата));
		КонецЕсли;
	КонецЦикла;
	// Сбор данных для переноса модельных доходностей и дюраций
	ПереносМодельныхДоходностейИДюраций = Новый Массив; // Массив(Структура("СценарныйИндекс": Число, "Дюрация": Число,
														//	"МодельнаяДюрация": Число, "МодельнаяДоходность": Число, "Формула": Строка))
	СтрокиНаУдалениеМодельныхДоходностейИДюраций = Новый Соответствие; // Массив(ДанныеФормыЭлементКоллекции, Истина)
	Для Каждого ТекущиеПараметрыПереносаДюраций Из ПараметрыПереносаДюраций Цикл
		// Фильтрация по полю "Дюрация"
		НайденныеСтроки = МодельныеДоходностиИДюрации.НайтиСтроки(Новый Структура("Дюрация", ТекущиеПараметрыПереносаДюраций.Откуда));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			// Фильтрация по полю "СценарныйИндекс"
			Если ВыделенныеСценарныеИндексы.Найти(НайденнаяСтрока.СценарныйИндекс) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаНовыхМодельныхДоходностейИДюраций = Новый Структура(
				"СценарныйИндекс, Дюрация, МодельнаяДюрация, МодельнаяДоходность, Формула");
			ЗаполнитьЗначенияСвойств(СтрокаНовыхМодельныхДоходностейИДюраций, НайденнаяСтрока);
			СтрокаНовыхМодельныхДоходностейИДюраций.Дюрация = ТекущиеПараметрыПереносаДюраций.Куда;
			ПереносМодельныхДоходностейИДюраций.Добавить(СтрокаНовыхМодельныхДоходностейИДюраций);
			// Строки с теми же измерениями, что и в переносимых строках, нужно удалить
			НайденныеСтрокиДляУдаления = МодельныеДоходностиИДюрации.НайтиСтроки(СтрокаНовыхМодельныхДоходностейИДюраций);
			Для Каждого НайденнаяСтрокаДляУдаления Из НайденныеСтрокиДляУдаления Цикл
				СтрокиНаУдалениеМодельныхДоходностейИДюраций.Вставить(НайденнаяСтрокаДляУдаления, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// Удаление замещённых модельных доходностей и дюраций
	Для Каждого УдаляемаяСтрока Из СтрокиНаУдалениеМодельныхДоходностейИДюраций Цикл
		МодельныеДоходностиИДюрации.Удалить(УдаляемаяСтрока.Ключ);
	КонецЦикла;
	// Добавление переносимых модельных доходностей и дюрации
	Для Каждого СтрокаПереноса Из ПереносМодельныхДоходностейИДюраций Цикл
		НоваяСтрока = МодельныеДоходностиИДюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереноса);
	КонецЦикла;
	// Сбор данных для переноса приращений доходности
	ПереносПриращенийДоходности = Новый Массив; // Массив(Структура("СценарныйИндекс": Число, "Дюрация": Число, "РепернаяДата": Дата,
												//	"ПриращениеДоходности": Число, "Формула": Строка))
	СтрокиНаУдалениеПриращенийДоходности = Новый Соответствие; // Массив(ДанныеФормыЭлементКоллекции, Истина)
	Для Каждого ТекущиеПараметрыПереносаРеперныхДат Из ПараметрыПереносаРеперныхДат Цикл
		Для Каждого ТекущиеПараметрыПереносаДюраций Из ПараметрыПереносаДюраций Цикл
			// Перенос требует отличных от прошлых значений измерений
			Если ТекущиеПараметрыПереносаРеперныхДат.Откуда = ТекущиеПараметрыПереносаРеперныхДат.Куда
				И ТекущиеПараметрыПереносаДюраций.Откуда = ТекущиеПараметрыПереносаДюраций.Куда
			Тогда
				Продолжить;
			КонецЕсли;
			// Фильтрация по полям "РепернаяДата" и "Дюрация"
			НайденныеСтроки = ПриращенияДоходности.НайтиСтроки(Новый Структура("РепернаяДата, Дюрация",
				ТекущиеПараметрыПереносаРеперныхДат.Откуда, ТекущиеПараметрыПереносаДюраций.Откуда));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				// Фильтрация по полю "СценарныйИндекс"
				Если ВыделенныеСценарныеИндексы.Найти(НайденнаяСтрока.СценарныйИндекс) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаНовыхПриращенийДоходности = Новый Структура(
					"Сценарий, СценарныйИндекс, РепернаяДата, Дюрация, ПриращениеДоходности, Формула");
				ЗаполнитьЗначенияСвойств(СтрокаНовыхПриращенийДоходности, НайденнаяСтрока);
				СтрокаНовыхПриращенийДоходности.РепернаяДата = ТекущиеПараметрыПереносаРеперныхДат.Куда;
				СтрокаНовыхПриращенийДоходности.Дюрация = ТекущиеПараметрыПереносаДюраций.Куда;
				ПереносПриращенийДоходности.Добавить(СтрокаНовыхПриращенийДоходности);
				// Строки с теми же измерениями, что и в переносимых строках, нужно удалить
				НайденныеСтрокиДляУдаления = ПриращенияДоходности.НайтиСтроки(СтрокаНовыхПриращенийДоходности);
				Для Каждого НайденнаяСтрокаДляУдаления Из НайденныеСтрокиДляУдаления Цикл
					СтрокиНаУдалениеПриращенийДоходности.Вставить(НайденнаяСтрокаДляУдаления, Истина);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// Удаление замещённых приращений доходности
	Для Каждого УдаляемаяСтрока Из СтрокиНаУдалениеПриращенийДоходности Цикл
		ПриращенияДоходности.Удалить(УдаляемаяСтрока.Ключ);
	КонецЦикла;
	// Добавление переносимых приращений доходности
	Для Каждого СтрокаПереноса Из ПереносПриращенийДоходности Цикл
		НоваяСтрока = ПриращенияДоходности.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереноса);
	КонецЦикла;
	// Завершение изменений
	Дюрации.Сортировать("СценарныйИндекс, Дюрация");
	РеперныеДаты.Сортировать("СценарныйИндекс, РепернаяДата");
	МодельныеДоходностиИДюрации.Сортировать("СценарныйИндекс, Дюрация");
	ПриращенияДоходности.Сортировать("Сценарий, СценарныйИндекс, РепернаяДата, Дюрация");
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрименить");
	Попытка
		ВыполнитьКомандаПрименить(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрименить(ПараметрыСессии)
	// Сохранение локальных дюраций
	КоличествоДюрацийПоСценарнымИндексам = Новый Соответствие; // Соответствие(Число (Сценарный индекс), Число (Количество дюраций))
	Объект.Дюрации.Очистить();
	Для Каждого СтрокаЛокальныхДюраций Из Дюрации Цикл
		НоваяСтрока = Объект.Дюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛокальныхДюраций);
		КоличествоДюраций = КоличествоДюрацийПоСценарнымИндексам.Получить(СтрокаЛокальныхДюраций.СценарныйИндекс);
		КоличествоДюрацийПоСценарнымИндексам.Вставить(
			СтрокаЛокальныхДюраций.СценарныйИндекс,
			?(КоличествоДюраций <> Неопределено, КоличествоДюраций, 0) + 1);
	КонецЦикла;
	// Сохранение локальных реперных дат
	Объект.РеперныеДаты.Очистить();
	Для Каждого СтрокаЛокальныхРеперныхДат Из РеперныеДаты Цикл
		НоваяСтрока = Объект.РеперныеДаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛокальныхРеперныхДат);
	КонецЦикла;
	// Обновление поля "ЕстьРазрезПоДюрации" у сценарных индексов
	Для Каждого СтрокаСценарногоИндекса Из Объект.СценарныеИндексы Цикл
		КоличествоДюраций = КоличествоДюрацийПоСценарнымИндексам.Получить(СтрокаСценарногоИндекса.Идентификатор);
		Если КоличествоДюраций = Неопределено Тогда
			КоличествоДюраций = 0;
		КонецЕсли;
		СтрокаСценарногоИндекса.ЕстьРазрезПоДюрации = КоличествоДюраций > 1;
	КонецЦикла;
	// Сохранение локальных модельных доходностей и дюраций
	Объект.МодельныеДоходностиИДюрации.Очистить();
	Для Каждого СтрокаЛокальныхМодельныхДоходностейИДюраций Из МодельныеДоходностиИДюрации Цикл
		НоваяСтрока = Объект.МодельныеДоходностиИДюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛокальныхМодельныхДоходностейИДюраций);
	КонецЦикла;
	// Сохранение локальных приращений доходности
	Объект.ПриращенияДоходности.Очистить();
	Для Каждого СтрокаЛокальныхПриращенийДоходности Из ПриращенияДоходности Цикл
		НоваяСтрока = Объект.ПриращенияДоходности.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛокальныхПриращенийДоходности);
	КонецЦикла;
	// Закрытие формы
	ЭтаФорма.Модифицированность = Ложь;
	Закрыть(Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВозможностьСменыРежимаРедактирования(Значение)
	ВозможностьРежимаРедактирования = Значение;
	Элементы.КомандаРедактировать.Доступность = ВозможностьРежимаРедактирования;
	Элементы.КомандаРедактироватьВыделенныеСтроки.Доступность = ВозможностьРежимаРедактирования;
	Элементы.КомандаЗавершитьРедактирование.Доступность = ВозможностьРежимаРедактирования;
	Элементы.КомандаОтменитьРедактирование.Доступность = ВозможностьРежимаРедактирования;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимРедактирования(Значение)
	Если Не ВозможностьРежимаРедактирования Тогда
		Возврат;
	КонецЕсли;
	РежимРедактирования = Значение;
	НесколькоПодходящихСтрок = Элементы.ДюрацииИРеперныеДаты.ВыделенныеСтроки.Количество() > 1;
	Элементы.КомандаРедактировать.Видимость = Не РежимРедактирования И Не НесколькоПодходящихСтрок;
	Элементы.КомандаРедактироватьВыделенныеСтроки.Видимость = Не РежимРедактирования И НесколькоПодходящихСтрок;
	Элементы.КомандаЗавершитьРедактирование.Видимость = РежимРедактирования;
	Элементы.КомандаОтменитьРедактирование.Видимость = РежимРедактирования;
	Элементы.КомандаПрименить.Видимость = Не РежимРедактирования;
	Элементы.ВыбранныеДюрации.ТолькоПросмотр = Не РежимРедактирования;
	Элементы.ВыбранныеРеперныеДаты.ТолькоПросмотр = Не РежимРедактирования;
	Элементы.ДюрацииИРеперныеДаты.Доступность = Не РежимРедактирования;
	// Поля для переноса значений
	Элементы.ВыбранныеДюрацииДюрацияДляПереноса.Видимость = РежимРедактирования;
	Элементы.ВыбранныеРеперныеДатыРепернаяДатаДляПереноса.Видимость = РежимРедактирования;
КонецПроцедуры

&НаСервере
Функция КоличествоТорговыхДней(ДатаНачала, ДатаОкончания)
	Попытка
		Возврат Справочники.Календари.КоличествоРабочихДней(Объект.КалендарьТорговыхДней, ДатаНачала, ДатаОкончания);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ДюрацииИРеперныеДатыПослеАктивизацииСтроки()
	ЗапущенОбработчикОжидания = Ложь;
	// Проверка наличия изменений списка выбранных строк
	БылиИзменения = Ложь;
	ВыделенныеСтроки = Элементы.ДюрацииИРеперныеДаты.ВыделенныеСтроки;
	Если ПоследниеВыделенныеСтроки.Количество() <> ВыделенныеСтроки.Количество() Тогда
		БылиИзменения = Истина;
	ИначеЕсли НажатаКнопкаОтменитьРедактирование Тогда
		НажатаКнопкаОтменитьРедактирование = Ложь; // Одноразовое использование для обновления дюраций и реперных дат
		БылиИзменения = Истина;
	Иначе
		// Идентификаторы строк должны находиться в том же порядке, т.к. это копия прошлого состояния массива
		Для Итератор = 0 По ПоследниеВыделенныеСтроки.Количество() - 1 Цикл
			Если ПоследниеВыделенныеСтроки[Итератор].Значение <> ВыделенныеСтроки[Итератор] Тогда
				БылиИзменения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не БылиИзменения Тогда
		УстановитьВозможностьСменыРежимаРедактирования(ПрошлаяВозможностьРежимаРедактирования);
		Возврат;
	КонецЕсли;
	ПоследниеВыделенныеСтроки.ЗагрузитьЗначения(ВыделенныеСтроки);
	ДанныеВыделенныхСтрок = Новый Массив; // Массив(ДанныеФормыЭлементКоллекции)
	Для Каждого ВыделеннаяСтрокаСценарныхИндексов Из ВыделенныеСтроки Цикл
		ДанныеВыделенныхСтрок.Добавить(ДюрацииИРеперныеДаты.НайтиПоИдентификатору(ВыделеннаяСтрокаСценарныхИндексов));
	КонецЦикла;
	// Проверка возможности редактирования
	СписокДляСортировки = Новый СписокЗначений;
	ВыбранныеСценарныеИндексы = Новый Массив; // Массив(Число (Сценарный индекс))
	Для Каждого ДанныеВыделеннойСтроки Из ДанныеВыделенныхСтрок Цикл
		СписокДляСортировки.Добавить(ДанныеВыделеннойСтроки.СценарныйИндекс);
	КонецЦикла;
	СписокДляСортировки.СортироватьПоЗначению();
	Для Каждого Элемент Из СписокДляСортировки Цикл
		ВыбранныеСценарныеИндексы.Добавить(Элемент.Значение);
	КонецЦикла;
	УстановитьРежимРедактирования(РежимРедактирования);
	НесколькоПодходящихСтрок = Элементы.ДюрацииИРеперныеДаты.ВыделенныеСтроки.Количество() > 1;
	Элементы.КомандаРедактировать.Видимость = Не РежимРедактирования И Не НесколькоПодходящихСтрок;
	Элементы.КомандаРедактироватьВыделенныеСтроки.Видимость = Не РежимРедактирования И НесколькоПодходящихСтрок;
	УстановитьВозможностьСменыРежимаРедактирования(Истина);
	ЗаполнитьВыбранныеДюрации(ВыбранныеСценарныеИндексы);
	ЗаполнитьВыбранныеРеперныеДаты(ВыбранныеСценарныеИндексы);
	// Формирование надписи с предупреждением при редактировании
	Элементы.НадписьПредупреждениеПриРедактировании.Заголовок = "";
	Если РазныйСоставДюраций Тогда
		Элементы.НадписьПредупреждениеПриРедактировании.Заголовок = Элементы.НадписьПредупреждениеПриРедактировании.Заголовок
			+ "Выбраны строки с разным составом дюраций; ";
	КонецЕсли;
	Если РазныйСоставРеперныхДат Тогда
		Элементы.НадписьПредупреждениеПриРедактировании.Заголовок = Элементы.НадписьПредупреждениеПриРедактировании.Заголовок
			+ "Выбраны строки с разным составом реперных дат; ";
	КонецЕсли;
	Если Не ПустаяСтрока(Элементы.НадписьПредупреждениеПриРедактировании.Заголовок) Тогда
		Элементы.НадписьПредупреждениеПриРедактировании.Заголовок =
			"ВНИМАНИЕ: " + СокрЛП(Элементы.НадписьПредупреждениеПриРедактировании.Заголовок);
	КонецЕсли;
КонецПроцедуры

// Заполнение уникальных дюраций из выбранных строк таблицы "ДюрацииИРеперныеДаты" в таблицу "ВыбранныеДюрации" на форме
//
// Параметры:
//	СценарныеИндексы - Массив(Число) - Отсортированный массив сценарных индексов
&НаКлиенте
Процедура ЗаполнитьВыбранныеДюрации(СценарныеИндексы)
	ВыбранныеДюрации.Очистить();
	КоличествоЗначенийПервойИтерации = Неопределено; // Количество дюраций первого выбранного сценарного индекса
	// Фильтрация уникальных значений дюрации
	УникальныеЗначения = Новый Соответствие; // Соответствие(Число (Дюрация), СтрокаТаблицыЗначений)
	РазныйСоставДюраций = Ложь;
	Для Каждого ТекущийСценарныйИндекс Из СценарныеИндексы Цикл
		// Таблица "Дюрации" отсортирована по сценарному индексу, но поиск всё равно будет упрощённый
		НайденныеСтроки = Дюрации.НайтиСтроки(Новый Структура("СценарныйИндекс", ТекущийСценарныйИндекс));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			УникальныеЗначения.Вставить(НайденнаяСтрока.Дюрация, НайденнаяСтрока);
		КонецЦикла;
		// Проверка идентичности дюраций у сценарных индексов
		Если КоличествоЗначенийПервойИтерации = Неопределено Тогда
			КоличествоЗначенийПервойИтерации = УникальныеЗначения.Количество();
		ИначеЕсли КоличествоЗначенийПервойИтерации <> УникальныеЗначения.Количество() // Проверка на отсутствие новых уникальных значений
			Или КоличествоЗначенийПервойИтерации <> НайденныеСтроки.Количество() // Проверка на иное (меньшее) количество значений при отсутствии новых
		Тогда
			РазныйСоставДюраций = Истина;
		КонецЕсли;
	КонецЦикла;
	// Сортировка уникальных значений дюраций
	СписокДляСортировки = Новый СписокЗначений; // СписокЗначений(Число (Дюрация))
	Для Каждого КлючЗначение Из УникальныеЗначения Цикл
		СписокДляСортировки.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	СписокДляСортировки.СортироватьПоЗначению();
	// Добавление дюраций в таблицу формы
	Для Каждого Элемент Из СписокДляСортировки Цикл
		СтрокаДюраций = УникальныеЗначения.Получить(Элемент.Значение);
		НоваяСтрока = ВыбранныеДюрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДюраций);
	КонецЦикла;
КонецПроцедуры

// Заполнение уникальных реперных дат из выбранных строк таблицы "ДюрацииИРеперныеДаты" в таблицу "ВыбранныеРеперныеДаты" на форме
//
// Параметры:
//	СценарныеИндексы - Массив(Число) - Отсортированный массив сценарных индексов
&НаКлиенте
Процедура ЗаполнитьВыбранныеРеперныеДаты(СценарныеИндексы)
	ВыбранныеРеперныеДаты.Очистить();
	КоличествоЗначенийПервойИтерации = Неопределено; // Количество реперных дат первого выбранного сценарного индекса
	// Фильтрация уникальных значений реперных дат
	УникальныеЗначения = Новый Соответствие; // Соответствие(Дата (Реперная дата), СтрокаТаблицыЗначений)
	РазныйСоставРеперныхДат = Ложь;
	Для Каждого ТекущийСценарныйИндекс Из СценарныеИндексы Цикл
		// Таблица "РеперныеДаты" отсортирована по сценарному индексу, но поиск всё равно будет упрощённый
		НайденныеСтроки = РеперныеДаты.НайтиСтроки(Новый Структура("СценарныйИндекс", ТекущийСценарныйИндекс));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			УникальныеЗначения.Вставить(НайденнаяСтрока.РепернаяДата, НайденнаяСтрока);
		КонецЦикла;
		// Проверка идентичности реперных дат у сценарных индексов
		Если КоличествоЗначенийПервойИтерации = Неопределено Тогда
			КоличествоЗначенийПервойИтерации = УникальныеЗначения.Количество();
		ИначеЕсли КоличествоЗначенийПервойИтерации <> УникальныеЗначения.Количество() // Проверка на отсутствие новых уникальных значений
			Или КоличествоЗначенийПервойИтерации <> НайденныеСтроки.Количество() // Проверка на иное (меньшее) количество значений при отсутствии новых
		Тогда
			РазныйСоставРеперныхДат = Истина;
		КонецЕсли;
	КонецЦикла;
	// Сортировка уникальных значений реперных дат
	СписокДляСортировки = Новый СписокЗначений; // СписокЗначений(Дата (Реперная дата))
	Для Каждого КлючЗначение Из УникальныеЗначения Цикл
		СписокДляСортировки.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	СписокДляСортировки.СортироватьПоЗначению();
	// Добавление реперных дат в таблицу формы
	Для Каждого Элемент Из СписокДляСортировки Цикл
		СтрокаРеперныхДат = УникальныеЗначения.Получить(Элемент.Значение);
		НоваяСтрока = ВыбранныеРеперныеДаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеперныхДат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция СгруппироватьЗначенияДюраций(СтрокиТаблицы)
	Если СтрокиТаблицы.Количество() <= 1 Тогда // Одно значение дюрации не отличается от отсутствия значений
		Возврат "";
	КонецЕсли;
	ЗначенияДюрации = Новый СписокЗначений; // СписокЗначений(Число (Дюрация))
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		ЗначенияДюрации.Добавить(СтрокаТаблицы.Дюрация);
	КонецЦикла;
	ЗначенияДюрации.СортироватьПоЗначению();
	Возврат СтрСоединить(ЗначенияДюрации.ВыгрузитьЗначения(), ", ");
КонецФункции

