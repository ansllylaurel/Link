#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.Объект, Объект);
	
	// Заполнение локальных модельных доходностей/дюрации для дальнейшего редактирования
	Объект.МодельныеДоходностиИДюрации.Сортировать("СценарныйИндекс, Дюрация");
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ
		|	СценарныеИндексы.Идентификатор КАК Идентификатор,
		|	СценарныеИндексы.Наименование КАК Наименование,
		|	СценарныеИндексы.ЕстьРазрезПоДюрации КАК ЕстьРазрезПоДюрации
		|ПОМЕСТИТЬ _СценарныеИндексы
		|ИЗ
		|	&СценарныеИндексы КАК СценарныеИндексы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Дюрации.СценарныйИндекс КАК СценарныйИндекс,
		|	Дюрации.Дюрация КАК Дюрация
		|ПОМЕСТИТЬ _Дюрации
		|ИЗ
		|	&Дюрации КАК Дюрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МодельныеДоходностиИДюрации.СценарныйИндекс КАК СценарныйИндекс,
		|	МодельныеДоходностиИДюрации.Дюрация КАК Дюрация,
		|	МодельныеДоходностиИДюрации.МодельнаяДюрация КАК МодельнаяДюрация,
		|	МодельныеДоходностиИДюрации.МодельнаяДоходность КАК МодельнаяДоходность,
		|	МодельныеДоходностиИДюрации.Формула КАК Формула
		|ПОМЕСТИТЬ _МодельныеДоходностиИДюрации
		|ИЗ
		|	&МодельныеДоходностиИДюрации КАК МодельныеДоходностиИДюрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СценарныеИндексы.Идентификатор КАК СценарныйИндекс,
		|	МАКСИМУМ(_СценарныеИндексы.Наименование) КАК НаименованиеСценарногоИндекса,
		|	_Дюрации.Дюрация КАК Дюрация,
		|	МАКСИМУМ(_МодельныеДоходностиИДюрации.МодельнаяДюрация) КАК МодельнаяДюрация,
		|	МАКСИМУМ(_МодельныеДоходностиИДюрации.МодельнаяДоходность) КАК МодельнаяДоходность,
		|	МАКСИМУМ(_МодельныеДоходностиИДюрации.Формула) КАК Формула,
		|	ВЫБОР
		|		КОГДА НЕ МАКСИМУМ(_МодельныеДоходностиИДюрации.МодельнаяДоходность) ЕСТЬ NULL
		|				ИЛИ НЕ МАКСИМУМ(_МодельныеДоходностиИДюрации.МодельнаяДюрация) ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Выбрано
		|ИЗ
		|	_СценарныеИндексы КАК _СценарныеИндексы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дюрации КАК _Дюрации
		|		ПО _СценарныеИндексы.Идентификатор = _Дюрации.СценарныйИндекс
		|			И (_СценарныеИндексы.ЕстьРазрезПоДюрации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МодельныеДоходностиИДюрации КАК _МодельныеДоходностиИДюрации
		|		ПО _СценарныеИндексы.Идентификатор = _МодельныеДоходностиИДюрации.СценарныйИндекс
		|			И (НЕ _СценарныеИндексы.ЕстьРазрезПоДюрации
		|				ИЛИ _Дюрации.Дюрация = _МодельныеДоходностиИДюрации.Дюрация)
		|
		|СГРУППИРОВАТЬ ПО
		|	_СценарныеИндексы.Идентификатор,
		|	_Дюрации.Дюрация
		|
		|УПОРЯДОЧИТЬ ПО
		|	СценарныйИндекс,
		|	Дюрация
		|ИТОГИ ПО
		|	СценарныйИндекс";
	#КонецОбласти
	Запрос.УстановитьПараметр("СценарныеИндексы", Объект.СценарныеИндексы.Выгрузить());
	Запрос.УстановитьПараметр("Дюрации", Объект.Дюрации.Выгрузить());
	Запрос.УстановитьПараметр("МодельныеДоходностиИДюрации", Объект.МодельныеДоходностиИДюрации.Выгрузить());
	ВыборкаСценарныйИндекс = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Сценарные индексы
	СтрокиСценарныхИндексов = ДеревоМодельныхДоходностейИДюрации.ПолучитьЭлементы();
	Пока ВыборкаСценарныйИндекс.Следующий() Цикл
		НоваяСтрокаСценарныхИндексов = СтрокиСценарныхИндексов.Добавить();
		НоваяСтрокаСценарныхИндексов.СценарныйИндекс = ВыборкаСценарныйИндекс.СценарныйИндекс;
		НоваяСтрокаСценарныхИндексов.ГибридноеНаименованиеСценарногоИндекса =
			ВыборкаСценарныйИндекс.НаименованиеСценарногоИндекса + " (" + Формат(ВыборкаСценарныйИндекс.СценарныйИндекс, "ЧГ=") + ")";
		// Дюрация
		СтрокиДюрации = НоваяСтрокаСценарныхИндексов.ПолучитьЭлементы();
		Выборка = ВыборкаСценарныйИндекс.Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			НоваяСтрокаСценарныхИндексов.МодельнаяДюрация = Выборка.МодельнаяДюрация;
			НоваяСтрокаСценарныхИндексов.МодельнаяДоходность = Выборка.МодельнаяДоходность;
			НоваяСтрокаСценарныхИндексов.Формула = Выборка.Формула;
			НоваяСтрокаСценарныхИндексов.Выбрано = Выборка.Выбрано;
			Продолжить;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			НоваяСтрокаДюрации = СтрокиДюрации.Добавить();
			НоваяСтрокаДюрации.Дюрация = Выборка.Дюрация;
			НоваяСтрокаДюрации.МодельнаяДюрация = Выборка.МодельнаяДюрация;
			НоваяСтрокаДюрации.МодельнаяДоходность = Выборка.МодельнаяДоходность;
			НоваяСтрокаДюрации.Формула = Выборка.Формула;
			НоваяСтрокаДюрации.Выбрано = Выборка.Выбрано;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Для Каждого СтрокаДерева1Уровня Из ДеревоМодельныхДоходностейИДюрации.ПолучитьЭлементы() Цикл
		Элементы.ДеревоМодельныхДоходностейИДюрации.Развернуть(СтрокаДерева1Уровня.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ФлагЗакрытияФормы Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	// Подтверждение закрытия формы
	Если ЭтаФорма.Модифицированность Тогда
		Ответ = Вопрос("При закрытии формы изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Продолжение закрытия формы
	СтандартнаяОбработка = Истина;
	Отказ = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоМодельныхДоходностейИДюрацииПередНачаломИзменения(Элемент, Отказ)
	ТекущиеДанные = Элементы.ДеревоМодельныхДоходностейИДюрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Можно изменять строку только на самом низшем доступном уровне
	Если ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМодельныхДоходностейИДюрацииПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМодельныхДоходностейИДюрацииПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМодельныхДоходностейИДюрацииМодельнаяДоходностьПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоМодельныхДоходностейИДюрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Выбрано = Истина;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМодельныхДоходностейИДюрацииМодельнаяДюрацияПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоМодельныхДоходностейИДюрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Выбрано = Истина;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаПрименить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрименить");
	Попытка
		ВыполнитьКомандаПрименить(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрименить(ПараметрыСессии)
	// Сохранение локальных модельных доходностей/дюрации
	Объект.МодельныеДоходностиИДюрации.Очистить();
	Для Каждого СтрокаДерева1Уровня Из ДеревоМодельныхДоходностейИДюрации.ПолучитьЭлементы() Цикл
		СтрокиДерева2Уровня = СтрокаДерева1Уровня.ПолучитьЭлементы();
		Если СтрокиДерева2Уровня.Количество() = 0 Тогда
			Если СтрокаДерева1Уровня.Выбрано Тогда
				НоваяСтрока = Объект.МодельныеДоходностиИДюрации.Добавить();
				НоваяСтрока.СценарныйИндекс = СтрокаДерева1Уровня.СценарныйИндекс;
				НоваяСтрока.МодельнаяДюрация = СтрокаДерева1Уровня.МодельнаяДюрация;
				НоваяСтрока.МодельнаяДоходность = СтрокаДерева1Уровня.МодельнаяДоходность;
				НоваяСтрока.Формула = СтрокаДерева1Уровня.Формула;
			КонецЕсли;
		Иначе
			Для Каждого СтрокаДерева2Уровня Из СтрокиДерева2Уровня Цикл
				Если СтрокаДерева2Уровня.Выбрано Тогда
					НоваяСтрока = Объект.МодельныеДоходностиИДюрации.Добавить();
					НоваяСтрока.СценарныйИндекс = СтрокаДерева1Уровня.СценарныйИндекс;
					НоваяСтрока.Дюрация = СтрокаДерева2Уровня.Дюрация;
					НоваяСтрока.МодельнаяДоходность = СтрокаДерева2Уровня.МодельнаяДоходность;
					НоваяСтрока.МодельнаяДюрация = СтрокаДерева2Уровня.МодельнаяДюрация;
					НоваяСтрока.Формула = СтрокаДерева2Уровня.Формула;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	// Закрытие формы
	ЭтаФорма.Модифицированность = Ложь;
	Закрыть(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриращенийДоходностиКонтекстноеМенюСвернутьДоСценарныхИндексов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ДеревоПриращенийДоходностиКонтекстноеМенюСвернутьДоСценарныхИндексов");
	Попытка
		ВыполнитьДеревоПриращенийДоходностиКонтекстноеМенюСвернутьДоСценарныхИндексов(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДеревоПриращенийДоходностиКонтекстноеМенюСвернутьДоСценарныхИндексов(ПараметрыСессии)
	СтрокиСценариев = ДеревоМодельныхДоходностейИДюрации.ПолучитьЭлементы();
	Для Каждого СтрокаСценариев Из СтрокиСценариев Цикл
		Элементы.ДеревоМодельныхДоходностейИДюрации.Свернуть(СтрокаСценариев.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриращенийДоходностиКонтекстноеМенюРазвернутьВсеСтроки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ДеревоПриращенийДоходностиКонтекстноеМенюРазвернутьВсеСтроки");
	Попытка
