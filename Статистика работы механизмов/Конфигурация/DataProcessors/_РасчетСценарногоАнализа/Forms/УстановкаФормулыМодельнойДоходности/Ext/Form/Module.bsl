&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.Объект, Объект);
	
	// Список выбора "Функция"
	Элементы.ИспользуемаяФункция.СписокВыбора.Добавить("", "<Без формулы>");
	Элементы.ИспользуемаяФункция.СписокВыбора.Добавить("GCurve_Yield", "G-Curve Yield");
	Элементы.ИспользуемаяФункция.СписокВыбора.Добавить("MOEX_Index_Yield", "MOEX Index Yield");
	// Список выбора "Биржевой индекс"
	Элементы.БиржевойИндекс.СписокВыбора.Добавить(475, "RUCBTR3A3YNS (1 группа ликвидности)");
	Элементы.БиржевойИндекс.СписокВыбора.Добавить(481, "RUCBTRAA3YNS (2 группа ликвидности)");
	Элементы.БиржевойИндекс.СписокВыбора.Добавить(479, "RUCBTRA3YNS (3 группа ликвидности)");
	
	// Значения по умолчанию
	ИспользуемаяДата = "ДатаРасчета";
	Дюрация = 1;
	МножительРезультата = 1;
	
	// Параметр "Формула"
	Попытка
		Если Параметры.Свойство("Формула") Тогда
			ПараметрыФормулы = СтрРазделить(Параметры.Формула, " ", Ложь);
			Если ПараметрыФормулы.Количество() > 0 Тогда
				ИмяФормулы = ПараметрыФормулы[0];
				ПараметрыФормулы.Удалить(0);
				// G-Curve Yield
				Если ИмяФормулы = "GCurve_Yield" И (ПараметрыФормулы.Количество() = 2 Или ПараметрыФормулы.Количество() = 3) Тогда
					#Область GCurve_Yield
					// Имя формулы
					ИспользуемаяФункция = ИмяФормулы;
					// Используемая дата
					Если ПараметрыФормулы[0] <> "<ДатаРасчета>" Тогда
						ИспользуемаяДата = "Другое";
						ПользовательскаяДата = Дата(
							Число(Сред(ПараметрыФормулы[0], 1, 4)),
							Число(Сред(ПараметрыФормулы[0], 6, 2)),
							Число(Сред(ПараметрыФормулы[0], 9, 2)));
					КонецЕсли;
					// Дюрация
					Если ПараметрыФормулы[1] <> "DEF" Тогда
						ИспользоватьДюрация = Истина;
						Дюрация = Число(ПараметрыФормулы[1]);
					КонецЕсли;
					// Множитель результата (необязательный параметр)
					Если ПараметрыФормулы.Количество() = 3 Тогда
						ИспользоватьМножительРезультата = Истина;
						МножительРезультата = Число(СтрЗаменить(ПараметрыФормулы[2], "*", ""));
					КонецЕсли;
					#КонецОбласти
				// MOEX Index Yield
				ИначеЕсли ИмяФормулы = "MOEX_Index_Yield"
					И (ПараметрыФормулы.Количество() = 2 Или ПараметрыФормулы.Количество() = 3)
				Тогда
					#Область Bond_Index_VaR_Или_Stock_Index_VaR
					// Имя формулы
					ИспользуемаяФункция = ИмяФормулы;
					// Используемая дата
					Если ПараметрыФормулы[0] <> "<ДатаРасчета>" Тогда
						ИспользуемаяДата = "Другое";
						ПользовательскаяДата = Дата(
							Число(Сред(ПараметрыФормулы[0], 1, 4)),
							Число(Сред(ПараметрыФормулы[0], 6, 2)),
							Число(Сред(ПараметрыФормулы[0], 9, 2)));
					КонецЕсли;
					// Биржевой индекс
					БиржевойИндекс = Число(ПараметрыФормулы[1]);
					// Множитель результата (необязательный параметр)
					Если ПараметрыФормулы.Количество() = 3 Тогда
						ИспользоватьМножительРезультата = Истина;
						МножительРезультата = Число(СтрЗаменить(ПараметрыФормулы[2], "*", ""));
					КонецЕсли;
					#КонецОбласти
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Не удалось разобрать переданную формулу: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// События после инициализации
	ИспользуемаяФункцияПриИзменении();
	ИспользуемаяДатаПриИзменении();
	ИспользоватьДюрацияПриИзменении();
	ИспользоватьМножительРезультатаПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемаяФункцияПриИзменении(Элемент = Неопределено)
	// Главные элементы
	Элементы.ГруппаПараметры.Видимость = Истина;
	Элементы.НадписьОписаниеИспользуемойФункции.Видимость = Истина;
	Элементы.НадписьОписаниеИспользуемойФункции.Заголовок = "Описание: ";
	// Параметры
	Элементы.ГруппаДата.Видимость = Ложь;
	Элементы.ГруппаДюрация.Видимость = Ложь;
	Элементы.БиржевойИндекс.Видимость = Ложь;
	Элементы.ГруппаМножительРезультата.Видимость = Ложь;
	// Включение видимости параметров в зависимости от используемой функции
	Если ИспользуемаяФункция = "GCurve_Yield" Тогда
		Элементы.НадписьОписаниеИспользуемойФункции.Заголовок =
			Элементы.НадписьОписаниеИспользуемойФункции.Заголовок + "Значение кривой бескупонной доходности";
		Элементы.ГруппаДата.Видимость = Истина;
		Элементы.ГруппаДюрация.Видимость = Истина;
		Элементы.ГруппаМножительРезультата.Видимость = Истина;
	ИначеЕсли ИспользуемаяФункция = "MOEX_Index_Yield" Тогда
		Элементы.НадписьОписаниеИспользуемойФункции.Заголовок =
			Элементы.НадписьОписаниеИспользуемойФункции.Заголовок + "Доходность биржевого индекса";
		Элементы.ГруппаДата.Видимость = Истина;
		Элементы.БиржевойИндекс.Видимость = Истина;
		Элементы.ГруппаМножительРезультата.Видимость = Истина;
	Иначе
		Элементы.ГруппаПараметры.Видимость = Ложь;
		Элементы.НадписьОписаниеИспользуемойФункции.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемаяДатаПриИзменении(Элемент = Неопределено)
	Элементы.ПользовательскаяДата.Видимость = (ИспользуемаяДата = "Другое");
КонецПроцедуры

&НаКлиенте
Процедура МножительРезультатаПриИзменении(Элемент)
	Если Не ИспользоватьМножительРезультата Тогда
		ИспользоватьМножительРезультата = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьДюрацияПриИзменении(Элемент = Неопределено)
	Если ИспользоватьДюрация Тогда
		Элементы.ИспользоватьДюрация.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элементы.Дюрация.Видимость = Истина;
	Иначе
		Элементы.ИспользоватьДюрация.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		Элементы.Дюрация.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьМножительРезультатаПриИзменении(Элемент = Неопределено)
	Если ИспользоватьМножительРезультата Тогда
		Элементы.ИспользоватьМножительРезультата.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элементы.МножительРезультата.Видимость = Истина;
	Иначе
		Элементы.ИспользоватьМножительРезультата.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		Элементы.МножительРезультата.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	Результат = ИспользуемаяФункция;
	// G-Curve Yield
	Если ИспользуемаяФункция = "GCurve_Yield" Тогда
		Результат = Результат
			+ " " + ?(ИспользуемаяДата = "ДатаРасчета", "<ДатаРасчета>", Формат(ПользовательскаяДата, "ДФ=yyyy-MM-dd; ДП=")) // @Date DATE
			+ " " + ?(ИспользоватьДюрация, Формат(Дюрация, "ЧРД=.; ЧН=; ЧГ="), "DEF") // @DurationYears DECIMAL(8, 2) = 1.
			+ ?(ИспользоватьМножительРезультата, " *" + Формат(МножительРезультата, "ЧРД=.; ЧН=; ЧГ="), ""); // Множитель результата
	// MOEX Index Yield
	ИначеЕсли ИспользуемаяФункция = "MOEX_Index_Yield" Тогда
		Если БиржевойИндекс = 0 Тогда
			Сообщить("Биржевой индекс должен быть заполнен.");
			Возврат;
		КонецЕсли;
		Результат = Результат
			+ " " + ?(ИспользуемаяДата = "ДатаРасчета", "<ДатаРасчета>", Формат(ПользовательскаяДата, "ДФ=yyyy-MM-dd; ДП=")) // @Date DATE
			+ " " + Формат(БиржевойИндекс, "ЧДЦ=0; ЧН=; ЧГ=") // @MOEXIndexID INT
			+ ?(ИспользоватьМножительРезультата, " *" + Формат(МножительРезультата, "ЧРД=.; ЧН=; ЧГ="), ""); // Множитель результата
	ИначеЕсли Не ПустаяСтрока(ИспользуемаяФункция) Тогда
		Предупреждение("Выбрана неизвестная функция");
		Возврат;
	КонецЕсли;
	
	Закрыть(Результат);
КонецПроцедуры
