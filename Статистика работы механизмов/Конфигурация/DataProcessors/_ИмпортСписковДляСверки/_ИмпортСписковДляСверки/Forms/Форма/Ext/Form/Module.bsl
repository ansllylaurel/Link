
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Элементы.КомандаОтладкаКоманд.Видимость = Не ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза");
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	Диалог.Каталог            	= ЭтаФорма.ИмяФайла; 
	Диалог.Фильтр				= "Файл XML, ZIP-архив (*.xml;*.zip)|*.xml;*.zip";
	Диалог.МножественныйВыбор 	= Ложь; 
	Диалог.Заголовок          	= "Выберите файл"; 
	
	Диалог.Показать(Новый ОписаниеОповещения("ИмяФайлаНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда 
		
		ЭтаФорма.ИмяФайла = Диалог.ПолноеИмяФайла;
		КомандаПрочитатьФайл(Неопределено);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(ЭтаФорма.ИмяФайла);
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаПрочитатьФайл(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрочитатьФайл");
	Попытка
		ВыполнитьКомандаПрочитатьФайл(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрочитатьФайл(ПараметрыСессии)
	
	Файл = Новый Файл(ЭтаФорма.ИмяФайла);
	
	Если Файл.Существует() Тогда
		
		АдресДанных = УпаковатьФайл();
		ПрочитатьФайлНаСервере(АдресДанных);
		
	Иначе
		ПараметрыСессии.ТекстОшибки = "Файл не существует.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаИмпортировать");
	Попытка
		ВыполнитьКомандаИмпортировать(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаИмпортировать(ПараметрыСессии)
	
	Если Объект.ВидСписка = ПредопределенноеЗначение("Справочник.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН")
		И Не ЗначениеЗаполнено(Объект.ДатаПубликации) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата публикации"" не заполнено",,, "ДатаПубликации");
		ПараметрыСессии.ТекстОшибки = "Поле ""Дата публикации"" не заполнено";
		Возврат;
		
	КонецЕсли;	
	
	Файл = Новый Файл(ЭтаФорма.ИмяФайла);
	
	Если Объект.СписокЮрФизЛиц.Количество() > 0 И Файл.Существует() Тогда
		
		АдресДанных = УпаковатьФайл();
		ИмпортироватьНаСервере(АдресДанных);
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьСверкуПослеИмпорта", ЭтаФорма), 
			"Выполнить сверку со списокм?", 
			РежимДиалогаВопрос.ДаНет,
			,
			,
			"Загрузка завершена");
		
	Иначе
		ПараметрыСессии.ТекстОшибки = "Список пуст или файл не существует.";
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура НастроитьВидимостьИДоступность()

	Элементы.ВерсияФормата.Видимость 	= (Объект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК Или Объект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокФРОМУ);
	Элементы.Идентификатор.Видимость 	= (Объект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов);
	Элементы.НомерСписка.Видимость 		= (Объект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов);
	Элементы.ДатаПубликации.Видимость	= (Объект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция УпаковатьФайл()

	ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ЭтаФорма.ИмяФайла);
	ДанныеФайла.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ЭтаФорма.ИмяФайла));
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресДанных)

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если ОбъектНаСервере.ПрочитатьФайл(АдресДанных) Тогда
		ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
		НастроитьВидимостьИДоступность();
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(АдресДанных);

КонецПроцедуры

&НаСервере
Процедура ИмпортироватьНаСервере(АдресДанных)

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНасервере.СохранитьСписокДляСверкиВExternals(АдресДанных);
	УдалитьИзВременногоХранилища(АдресДанных);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверкуПослеИмпорта(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да  Тогда
		
		РезультатСверки = ВыполнитьСверкуСоСпискомНаСервере();
		
		Если РезультатСверки = Неопределено Тогда
			ПоказатьПредупреждение(, "При выполнении сверки прозошли ошибки!");
		Иначе
			РезультатСверки.ОтчетОСверке.Показать(РезультатСверки.Заголовок);
		КонецЕсли; 
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьСверкуСоСпискомНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектНаСервере.ВыполнитьСверкуСоСписком();
	
КонецФункции
 
#КонецОбласти 

&НаКлиенте
Процедура КомандаОтладкаКоманд(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОтладкаКоманд");
	Попытка
		ВыполнитьКомандаОтладкаКоманд(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаОтладкаКоманд(ПараметрыСессии)

	СписокКоманд = ПолучитьСписокКоманд();
	ПараметрыКоманды = СписокКоманд.ВыбратьЭлемент();
	Если ПараметрыКоманды <> Неопределено Тогда
		ОтладкаКомандНаСервере(ПараметрыКоманды.Значение);
	Иначе
		ПараметрыСессии.ТекстОшибки = "Команда не выбрана.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокКоманд()

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта(ОбъектНаСервере.Метаданные().Имя);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработкиКоманды.Ссылка КАК ДополнительнаяОбработкаСсылка,
		|	ДополнительныеОтчетыИОбработкиКоманды.Идентификатор КАК ИдентификаторКоманды,
		|	ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров КАК ГруппаПараметров,
		|	ДополнительныеОтчетыИОбработкиКоманды.Представление + "" ("" + ЕСТЬNULL(ДополнительныеОтчетыИОбработкиГруппыПараметров.Имя, """") + "")"" КАК Представление
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.ГруппыПараметров КАК ДополнительныеОтчетыИОбработкиГруппыПараметров
		|		ПО ДополнительныеОтчетыИОбработкиКоманды.Ссылка = ДополнительныеОтчетыИОбработкиГруппыПараметров.Ссылка
		|			И ДополнительныеОтчетыИОбработкиКоманды.ГруппаПараметров = ДополнительныеОтчетыИОбработкиГруппыПараметров.Идентификатор
		|ГДЕ
		|	ДополнительныеОтчетыИОбработкиКоманды.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДополнительнаяОбработкаСсылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СписокКоманд = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		ПараметрыКоманды = Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ГруппаПараметров");
		
		ЗаполнитьЗначенияСвойств(ПараметрыКоманды, Выборка);
		СписокКоманд.Добавить(ПараметрыКоманды, Выборка.Представление)
	
	КонецЦикла;

	Возврат СписокКоманд;

КонецФункции

&НаСервере
Процедура ОтладкаКомандНаСервере(ПараметрыКоманды)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ВыполнитьКоманду(ПараметрыКоманды.ИдентификаторКоманды, ПараметрыКоманды);
		
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
 
