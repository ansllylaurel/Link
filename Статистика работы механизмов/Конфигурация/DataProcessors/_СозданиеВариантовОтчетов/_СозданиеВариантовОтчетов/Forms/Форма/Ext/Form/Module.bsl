

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидОтчетаПриИзменении(Неопределено);
КонецПроцедуры
	
#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
	
	ЭтаФорма.ПредопределенныеВарианты.Очистить();
	ЭтаФорма.СохраненныеВарианты.Очистить();
	ЭтаФорма.СохраненныеНастройки.Очистить();
	ЭтаФорма.СистемныеНастройки.Очистить();
	
	ЭтаФорма.КоличествоПредопределенныхВариантов = 0;
	ЭтаФорма.КоличествоСохраненныхВариантов = 0;
	ЭтаФорма.КоличествоСохраненныхНастроек = 0;
	ЭтаФорма.КоличествоКлючей = 0;
	
	ЭлементКлюч = ЭтаФорма.Элементы.КлючОтчета;
	
	Если ЭтаФорма.ВидОтчета = 0 Тогда
		
		ОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255));
		
		ЭлементКлюч.РежимВыбораИзСписка = Истина;
		СписокОтчетов = ПолучитьСписокОтчетов();
		Для каждого Отчет Из СписокОтчетов Цикл
			ЗаполнитьЗначенияСвойств(ЭлементКлюч.СписокВыбора.Добавить(), Отчет);
		КонецЦикла; 		
		
	ИначеЕсли ЭтаФорма.ВидОтчета = 1 Тогда
		
		ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.ДополнительныеОтчетыИОбработки");
		ЭлементКлюч.РежимВыбораИзСписка = Ложь;
		ЭлементКлюч.СписокВыбора.Очистить();
		
	КонецЕсли; 
	
	ЭлементКлюч.ОграничениеТипа = ОписаниеТипов;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючОтчетаПриИзменении(Элемент)
	ЗаполнитьПредопределенныеВарианты();
	ЗаполнитьСохраненныеВарианты();
	ЗаполнитьСохраненныеНастройки();
	ЗаполнитьКлючиТекущихВариантов();
КонецПроцедуры


#КонецОбласти 

#Область КомандыФормы

&НаКлиенте
Процедура Создать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Создать");
	Попытка
		УстановитьДействиеДляВыделенныхСтрок("Создать");
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

