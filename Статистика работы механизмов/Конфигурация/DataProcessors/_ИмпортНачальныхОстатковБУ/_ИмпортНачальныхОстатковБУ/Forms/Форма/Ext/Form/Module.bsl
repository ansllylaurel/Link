Функция СообщитьОбИсточнике(Источник)
	
	Возврат " Клиент: " + Источник.Клиент + ". Счет: " + Источник.БухСчет + ". Субконто № " + Источник.НомерСубконто;
	
КонецФункции // СообщитьОбИсточнике

&НаСервереБезКонтекста
Функция ВыделитьРеквизитыДоговораИзНаименования(Знач Наименование)

	// обычно наименование соотв. шаблону "{Договор }№{ }[НомерДоговора]{ }от{ }[ДатаДоговора]{ года}"
	
	РеквизитыДоговора = Новый Структура("Номер, ДатаЗаключения", "", "");
	
	ПозНомер = Найти(Наименование, "№");
	ПозОт    = Найти(Наименование, "от");
	
	Если ПозОт = 0 Тогда
		Сообщить("Не удалось выделить дату договора из строки '" + Наименование + "'");
		РеквизитыДоговора.Номер = СокрЛП(Сред(Наименование, ПозНомер + 1));
		Возврат РеквизитыДоговора;
	КонецЕсли;
	
	РеквизитыДоговора.Номер = СокрЛП(Сред(Наименование, ПозНомер + 1, ПозОт - ПозНомер - 1));
	
	Для Инд = ПозОт + 2 По СтрДлина(Наименование) Цикл
		ТекСимв = Сред(Наименование, Инд, 1);
		
		Если ТекСимв = " " Тогда
			Продолжить;
		ИначеЕсли Найти("0123456789.", ТекСимв) = 0 Тогда
			Прервать;
		КонецЕсли;
		
		РеквизитыДоговора.ДатаЗаключения = РеквизитыДоговора.ДатаЗаключения + ТекСимв;
	КонецЦикла;
	
	РеквизитыДоговора.ДатаЗаключения = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(РеквизитыДоговора.ДатаЗаключения);
	
	Возврат РеквизитыДоговора;
	
КонецФункции // ВыделитьРеквизитыДоговораИзНаименования

&НаСервереБезКонтекста
Функция НайтиОбъектПоКодуМатрих(КэшОбъектов, ВидОбъекта, Идрб, Источник)
	
	Если Идрб = "0" Тогда
		Сообщить("Поиск объектов '" + ВидОбъекта + "' по коду Матрих '" + Идрб + "' не поддерживается." + СообщитьОбИсточнике(Источник));
		Возврат Неопределено;
	КонецЕсли;

	Ключ       = ВидОбъекта + "." + Идрб;
	СтрокаКэша = КэшОбъектов.Найти(Ключ, "Ключ");
	
	Если СтрокаКэша <> Неопределено Тогда
		Возврат СтрокаКэша.Знч;
	КонецЕсли;
	
	ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию(ВидОбъекта, Истина, Ложь);
	
	Если Не ЗначениеЗаполнено(ГруппаОбъектов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемах.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах КАК КодыВоВнешнихСистемах
		|ГДЕ
		|	КодыВоВнешнихСистемах.ВнешняяСистема = &ВнешняяСистема
		|	И КодыВоВнешнихСистемах.ГруппаОбъектов = &ГруппаОбъектов
		|	И КодыВоВнешнихСистемах.Код = &Код";
		
	Запрос.Параметры.Вставить("ВнешняяСистема", Справочники.ВнешниеСистемы.Матрих);
	Запрос.Параметры.Вставить("ГруппаОбъектов", ГруппаОбъектов);
	Запрос.Параметры.Вставить("Код",            Идрб);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Знч = Выборка.Объект;
		
	Иначе
		// попытаемся загрузить объект из Х-Компани
		ОбработкаИмпортНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
		
		Если Не РаботаСПользователями.ПраваДоступны(ОбработкаИмпортНСИ, "Использование") Тогда
			Сообщить("Не удалось найти объект '" + ВидОбъекта + "' по коду Матрих '" + Идрб + "'" + СообщитьОбИсточнике(Источник));
			Знч = Справочники[?(ВидОбъекта = "ЮридическиеЛица" Или ВидОбъекта = "ФизическиеЛица", "ЮрФизЛица", ВидОбъекта)].ПустаяСсылка();
			
		Иначе
			ОбработкаИмпортНСИ.Организация    = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
			ОбработкаИмпортНСИ.ГруппаПравил   = "Матрих";
			ОбработкаИмпортНСИ.ГруппаОбъектов = ГруппаОбъектов;
			
			ОбработкаИмпортНСИ.Подразделение = Справочники.Подразделения.ГруппаКомпаний;
			ОбработкаИмпортНСИ.Язык          = Справочники.Языки.Русский;
			
			СтрокаИмпортируемыеОбъекты = ОбработкаИмпортНСИ.ИмпортируемыеОбъекты.Добавить();
			СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме = Идрб;
			
			ОбработкаИмпортНСИ.ИмпортироватьДанные();
			
			// повторно проверим наличие объекта
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Знч = Выборка.Объект;
			Иначе
				Сообщить("Не удалось найти объект '" + ВидОбъекта + "' по коду Матрих '" + Идрб + "'" + СообщитьОбИсточнике(Источник));
				Знч = Справочники[?(ВидОбъекта = "ЮридическиеЛица" Или ВидОбъекта = "ФизическиеЛица", "ЮрФизЛица", ВидОбъекта)].ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	СтрокаКэша = КэшОбъектов.Добавить();
	СтрокаКэша.Ключ = Ключ;
	СтрокаКэша.Знч  = Знч;
	
	Возврат Знч;
	
КонецФункции // НайтиОбъектПоКодуМатрих

&НаСервереБезКонтекста
Функция НайтиДепозитныйВклад(КэшОбъектов, Ид, Источник)
	
	Ключ       = "ДепозитныйВклад." + Ид;
	СтрокаКэша = КэшОбъектов.Найти(Ключ, "Ключ");
	
	Если СтрокаКэша <> Неопределено Тогда
		Возврат СтрокаКэша.Знч;
	КонецЕсли;
	
	ПозРазд = Найти(Ид, "/");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ДепозитныеВклады.НомерПодтверждения = """"
		|				ТОГДА ДепозитныеВклады.БанковскийСчет.Договор.ДатаЗаключения
		|			ИНАЧЕ ДепозитныеВклады.ДатаПодтверждения
		|		КОНЕЦ = &ДатаДоговора
		|	И ВЫБОР
		|			КОГДА ДепозитныеВклады.НомерПодтверждения = """"
		|				ТОГДА ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора
		|			ИНАЧЕ ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора + "" ("" + ДепозитныеВклады.НомерПодтверждения + "")""
		|		КОНЕЦ = &НомерДоговора";
		
	Запрос.УстановитьПараметр("ДатаДоговора",  РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(Ид, ПозРазд - 1)));
	Запрос.УстановитьПараметр("НомерДоговора", Сред(Ид, ПозРазд + 1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Сообщить("Не удалось найти депозитный вклад по ИД '" + Ид + "'" + СообщитьОбИсточнике(Источник));
		Знч = Справочники.ДепозитныеВклады.ПустаяСсылка();
	Иначе
		Знч = Выборка.Ссылка;
	КонецЕсли;

	СтрокаКэша = КэшОбъектов.Добавить();
	СтрокаКэша.Ключ = Ключ;
	СтрокаКэша.Знч  = Знч;
	
	Возврат Знч;
	
КонецФункции // НайтиДепозитныйВклад

