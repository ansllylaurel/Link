
#Область Регистрационные_Данные

Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Печать и выгрузка уведомления о движении ЦБ (Инфинитум)", "0.18", "", Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Прочие_Процедуры_и_Функции

Процедура СформироватьПечатнуюФормуУведомления(ТабДокумент, Отказ) Экспорт
	
	ВыборкаШапки = ПолучитьВыборкуШапки();
	Если Не ВыборкаШапки.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по счету доверительного управления",,,, Отказ);
		Возврат;
	КонецЕсли;	
	
	ВыборкаДанных = ПолучитьВыборкуДанных();
	Если ВыборкаДанных.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по ценным бумагам",,,, Отказ);		
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(ВыборкаШапки);
	ОбластьШапка.Параметры.НомерИДатаДоговораДУ = ВыборкаШапки.НомерДоговора + " от " + Формат(ВыборкаШапки.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	
	ВидСделки = "Передача средств пенсионных " + ВыборкаШапки.ПН_ПР + "  по Требованию фонда";	
	Вставка_ПН_ПР = ?(ВыборкаШапки.ПН_ПР = "накоплений", "средствами пенсионных накоплений для финансирования накопительной пенсии", "средствами пенсионных резервов");
	
	ОбластьШапка.Параметры.НаименованиеКлиента = Сред(ЭтотОбъект.НаименованиеДепонента, СтрНайти(ЭтотОбъект.НаименованиеДепонента, "Д.У.") + 5);
	ОбластьШапка.Параметры.ДатаИВремяФормирования = ДатаИВремяФормирования;
	ОбластьШапка.Параметры.Ответственный = СокрЛП(Подписант);
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	КонтрагентПоСделке = ВыборкаШапки.НаименованиеКонтрагента;
	Если Не ПустаяСтрока(КонтрагентПоСделке) Тогда
		КонтрагентПоСделке = КонтрагентПоСделке + " Д.У. " + Вставка_ПН_ПР + " " +  ВыборкаШапки.КраткоеНаименованиеКлиента;
	КонецЕсли;
	
	СрокПеререгистрации = Формат(СрокПеререгистрацииПрав, "ДФ=dd.MM.yyyy");
	ДатаТребования = Формат(ДатаТребованияФонда, "ДФ=dd.MM.yyyy");
	
	Пока ВыборкаДанных.Следующий() Цикл    
		
		ОбластьСтрока.Параметры.Заполнить(ВыборкаДанных);
		ОбластьСтрока.Параметры.ВидСделки = ВидСделки;
		ОбластьСтрока.Параметры.КонтрагентПоСделке = КонтрагентПоСделке;
		ОбластьСтрока.Параметры.СрокПеререгистрацииПрав = СрокПеререгистрации;
		ОбластьСтрока.Параметры.НомерТребованияФонда = СокрЛП(НомерТребованияФонда);
		ОбластьСтрока.Параметры.ДатаТребованияФонда = ДатаТребования;
		
		ОбластьСтрока.Параметры.ПредметСделки = "Наименование эмитента: " + ВыборкаДанных.НаименованиеЭмитента + "; Тип ц/б: " + ВыборкаДанных.Рынок + ?(ПустаяСтрока(ВыборкаДанных.ВидАкции), "", " " + ВыборкаДанных.ВидАкции) + "; Гос. номер: " + ВыборкаДанных.ГосударственныйРегистрационныйНомер + "; номинал: " + СокрЛП(ВыборкаДанных.Номинал) + " " + СокрЛП(ВыборкаДанных.ВалютаНоминала);
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьПодвал);	
	
КонецПроцедуры

Функция ПолучитьДанныеДляВыгрузки(Отказ, ТекНомерСообщения) Экспорт 
	
	ДанныеДляВыгрузки = Новый Массив;
	
	ИменаКолонокШапки = Неопределено;
	ВыборкаШапки = ПолучитьВыборкуШапки(ИменаКолонокШапки);
	Если Не ВыборкаШапки.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по счету доверительного управления",,,, Отказ);
		Возврат ДанныеДляВыгрузки;
	КонецЕсли;	
	
	ИменаКолонокДанных = Неопределено;
	ВыборкаДанных = ПолучитьВыборкуДанных(ИменаКолонокДанных);
	Если ВыборкаДанных.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по ценным бумагам",,,, Отказ);		
		Возврат ДанныеДляВыгрузки;
	КонецЕсли;
		
	// Помещаем данные в структуру
	СтруктураДанных = Новый Структура;
	Для Каждого ТекКолонка Из ИменаКолонокШапки Цикл
		СтруктураДанных.Вставить(ТекКолонка, ВыборкаШапки[ТекКолонка]);
	КонецЦикла;
	
	СтруктураДанных.Вставить("НомерДепозитарногоДоговораКонтрагента", ЭтотОбъект.НомерДепозитарногоДоговораКонтрагента);
	СтруктураДанных.Вставить("ДатаДепозитарногоДоговораКонтрагента",  ЭтотОбъект.ДатаДепозитарногоДоговораКонтрагента);
	
	// Собираем имя файла
	ИмяФайла = Формат(ЭтотОбъект.ДатаИВремяФормирования, "ДФ=yyyy_MM_dd_");
	Если ЭтотОбъект.ВидДвижения = 0 Тогда 
		// Поступление ЦБ
		ИмяФайла = ИмяФайла + "(R03-1)_"
	ИначеЕсли ЭтотОбъект.ВидДвижения = 1 Тогда 
		// Выбытие ЦБ
		ИмяФайла = ИмяФайла + "(R03-2)_"		
	ИначеЕсли ЭтотОбъект.ВидДвижения = 3 Тогда 
		// Перевод ЦБ
		ИмяФайла = ИмяФайла + "(R03-4)_"			
	КонецЕсли;
	
	НомерСообщения = ТекНомерСообщения;
	
	Пока ВыборкаДанных.Следующий() Цикл
		
		СтруктураРезультата = Новый Структура;
		Для Каждого ТекЭлементСтруктуры Из СтруктураДанных Цикл
			СтруктураРезультата.Вставить(ТекЭлементСтруктуры.Ключ, ТекЭлементСтруктуры.Значение);
		КонецЦикла;
		
		Для Каждого ТекКолонка Из ИменаКолонокДанных Цикл
			СтруктураРезультата.Вставить(ТекКолонка, ВыборкаДанных[ТекКолонка]);
		КонецЦикла;
		СтрНомерСообщения = Формат(НомерСообщения, "ЧГ=0");
		СтрНомерСообщения = ?(СтрДлина(СтрНомерСообщения) = 1, "0" + СтрНомерСообщения, СтрНомерСообщения);
		
		// Перевод ЦБ
		Если ЭтотОбъект.ВидДвижения = 2 Тогда
			Если СтруктураРезультата.ВидПеревода = "Перевод_Поступление" Тогда
				ТекИмяФайла = ИмяФайла + "(R03-1)_" + "[" + СтрНомерСообщения + "].xml"
			Иначе
				ТекИмяФайла = ИмяФайла + "(R03-2)_" + "[" + СтрНомерСообщения + "].xml"
			КонецЕсли;
		Иначе		
			ТекИмяФайла = ИмяФайла + "[" + СтрНомерСообщения + "].xml";
		КонецЕсли;
		
		СтруктураРезультата.Вставить("ИмяФайла", ТекИмяФайла);
		СтруктураРезультата.Вставить("НомерСообщения", СтрНомерСообщения);
		
		ДанныеДляВыгрузки.Добавить(СтруктураРезультата);
		
		НомерСообщения = НомерСообщения + 1;
		
	КонецЦикла;
	
	ТекНомерСообщения = НомерСообщения;
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции	

Функция ПолучитьВыборкуШапки(ИменаКолонок = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.ПолноеНаименованиеПоУставу + "" Д.У."" КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизации,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РеквизитыЮридическихЛицКлиента.ПолноеНаименованиеПоУставу КАК НаименованиеКлиента,
		|	РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеКлиента,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _КлиентДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА ""накоплений""
		|		ИНАЧЕ ""резервов""
		|	КОНЕЦ КАК ПН_ПР,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеКонтрагента.КраткоеНаименованиеПоУставу, РеквизитыЮридическихЛицКонтрагента.КраткоеНаименованиеПоУставу) КАК НаименованиеКонтрагента,
		|	РеквизитыЮридическихЛицОрганизации.ОГРН КАК ОГРНОрганизации,
		|	РеквизитыЮридическихЛицСД.ОГРН КАК ОГРН_СД,
		|	РеквизитыЮридическихЛицСД.ДатаВыдачиОГРН КАК ДатаОГРН_СД,
		|	РеквизитыЮридическихЛицСД.ОрганВыдавшийОГРН КАК ОрганОГРН_СД,
		|	РеквизитыЮридическихЛицНРД.ОГРН КАК ОГРН_НРД,
		|	РеквизитыЮридическихЛицСД.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСД,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.НомерТорговогоСчета КАК МестоХранения,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.Идентификатор КАК ИдентификаторСД
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &Контрагент
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКонтрагента
		|		ПО (РеквизитыЮридическихЛицКонтрагента.ЮрФизЛицо = &Контрагент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &Контрагент
		|					И Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеКонтрагента
		|		ПО _КлиентДоверительногоУправления.Организация = РеквизитыЮридическихЛицАнкетныеКонтрагента.Организация,
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &Спецдепозитарий
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСД,
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &НРД
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицНРД,
		|	РегистрСведений.ДоговорыСЦентральнымДепозитарием.СрезПоследних(&Период, ДепозитарнаяКомпания.ЮрФизЛицо = &СпецдепозитарийИнфинитум) КАК ДоговорыСЦентральнымДепозитариемСрезПоследних";
	
	ЮрФизЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо");
	Запрос.УстановитьПараметр("Период", 						КонецДня(ЭтотОбъект.ДатаИВремяФормирования));
	Запрос.УстановитьПараметр("ЮрФизЛицо", 						ЮрФизЛицоОрганизации);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("Контрагент", 					?(ЭтотОбъект.ВидДвижения >= 2, ЮрФизЛицоОрганизации, ЭтотОбъект.Контрагент));
	ДепозитарийИнфинитум = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум");
	Запрос.УстановитьПараметр("СпецдепозитарийИнфинитум", 		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДепозитарийИнфинитум, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("НРД", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("НРД"));
	
	Запрос.УстановитьПараметр("Спецдепозитарий", 				Запрос.Параметры.СпецдепозитарийИнфинитум);
	Если ЭтотОбъект.ВидДвижения = 2 Тогда
		// Для перевода указываем спецдеп неИнфинитум
		ПервыйДокумент = ЭтотОбъект.ДокументыДвиженияЦБ[0].Документ;
		ПереводИзИнфинитума = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервыйДокумент, "ДепозитарныйСчет.Депозитарий") = ДепозитарийИнфинитум;
		
		Если ПереводИзИнфинитума Тогда
			Запрос.УстановитьПараметр("Спецдепозитарий", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервыйДокумент, "ДепозитарныйСчетПолучатель.Депозитарий.ЮрФизЛицо"));	
		Иначе
			Запрос.УстановитьПараметр("Спецдепозитарий", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервыйДокумент, "ДепозитарныйСчет.Депозитарий.ЮрФизЛицо"));	
		КонецЕсли;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ИменаКолонок = Новый Массив;
	Для Каждого ТекКолонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(ТекКолонка.Имя);
	КонецЦикла;	
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

