		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Доли)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Закладные)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, """"),
		|	ЕСТЬNULL(ДокументЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, """"),
		|	ЕСТЬNULL(КодыISIN.Код, """"),
		|	ЕСТЬNULL(КодыCFI.Код, """"),
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.НомерТорговогоСчета,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.Идентификатор,
		|	_ТаблицаДокументов.ДатаПеререгистрации";	
	
	Если ЭтотОбъект.ВидДвижения = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг.ЦенныеБумаги", "Документ.ВводЦенныхБумаг.ЦенныеБумаги");
	ИначеЕсли ЭтотОбъект.ВидДвижения >= 2 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг.ЦенныеБумаги", "Документ.ПереводЦенныхБумаг.ЦенныеБумаги");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДепозитарныйСчетПолучатель", 				?(ВидДвижения >= 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель", 						"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РазделМестаХраненияПолучатель", 				?(ВидДвижения >= 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.НомерСчета", 			"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомерДепозитарногоДоговораПолучатель", 		?(ВидДвижения >= 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Договор.НомерДоговора", 	"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаДепозитарногоДоговораПолучатель", 		?(ВидДвижения >= 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Договор.ДатаЗаключения", """""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомерСчетаПолучатель", 						?(ВидДвижения >= 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Родитель.НомерСчета", 	"""""")); 	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПеревода", 								?(ВидДвижения >= 2, "ВЫБОР КОГДА ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = &Инфинитум ТОГДА ""Перевод_Поступление"" ИНАЧЕ ""Перевод_Передача"" КОНЕЦ", 	"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДоговорСЦентральнымДепозитариемКонтрагента", ?(ВидДвижения >= 2, "ВЫБОР КОГДА ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = &Инфинитум ТОГДА (ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания) ИНАЧЕ (ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания) КОНЕЦ", 	"(ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания)")); 
	
	Запрос.УстановитьПараметр("ТаблицаДокументов", ЭтотОбъект.ДокументыДвиженияЦБ.Выгрузить());
	Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.ДатаИВремяФормирования));	
	Запрос.УстановитьПараметр("Инфинитум", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));	
		
	РезультатЗапроса = Запрос.Выполнить();
	ИменаКолонок = Новый Массив;
	Для Каждого ТекКолонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(ТекКолонка.Имя);
	КонецЦикла;	
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидДвижения < 2 Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");		
	КонецЕсли;     
	
КонецПроцедуры

