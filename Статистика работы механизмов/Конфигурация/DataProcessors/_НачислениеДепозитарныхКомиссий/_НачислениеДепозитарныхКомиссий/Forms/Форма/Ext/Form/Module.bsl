#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ДекорацияКомиссияБрокераРазница.Заголовок           = "";
	Элементы.ДекорацияКомиссияСтороннегоБрокераРазница.Заголовок = "";
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ДатаНачисленияКомиссии = ТекущаяДата();
	Объект.ДатаОплатыКомиссии	  = ТекущаяДата();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	Объект.НачалоПериода = НачалоМесяца(Объект.КонецПериода);
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссияБрокераПриИзменении(Элемент)
	
	ОбновитьНадписиКомиссии();
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссияСтороннегоБрокераПриИзменении(Элемент)
	
	Если Объект.КомиссияСтороннегоБрокера <> 0 Тогда
		РаспределитьКомиссиюСтороннегоБрокера();
	КонецЕсли;
	
	ОбновитьНадписиКомиссии(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Объект.Организация, Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ПодписантДолжность = СтруктураДанныхКонтактногоЛица.Должность;
	ВыбранноеЗначение  = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыКомиссии

&НаКлиенте
Процедура КомиссииКомиссияСтороннегоБрокераПриИзменении(Элемент)
	
	РассчитатьИтоговуюКомиссию();
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссииКомиссияБрокераПриИзменении(Элемент)
	
	РассчитатьИтоговуюКомиссию();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Заполнить");
	Попытка
		ВыполнитьЗаполнение(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнение(ПараметрыСессии)
	
	Если Не ЗначениеЗаполнено(Объект.Брокер) Тогда		
		Предупреждение("Не указан брокер!");
		ДобавитьТекстОшибки(ПараметрыСессии, "Не указан брокер");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
	ОбновитьНадписиКомиссии();  
	ОбновитьНадписиКомиссии(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОтметитьВсе");
	Попытка
		УстановитьСнятьФлажки(Истина);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СнятьВсе");
	Попытка
		УстановитьСнятьФлажки(Ложь);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыНачисления(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СоздатьДокументыНачисления");
	Попытка
		ВыполнитьСозданиеДокументовНачисления(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСозданиеДокументовНачисления(ПараметрыСессии)
	
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	Для Каждого СтрокаКомиссии Из Объект.Комиссии Цикл
		
		Если (Не СтрокаКомиссии.Обрабатывать) ИЛИ СтрокаКомиссии.КомиссияИтого = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыДокумента = Новый Структура;
		ПараметрыДокумента.Вставить("Организация", 				    Объект.Организация);
		ПараметрыДокумента.Вставить("СчетДоверительногоУправления", СтрокаКомиссии.СчетДоверительногоУправления);
		ПараметрыДокумента.Вставить("Период", 					    Объект.КонецПериода);
		ПараметрыДокумента.Вставить("Валюта", 					    Валюта);
		ПараметрыДокумента.Вставить("Сумма", 					    СтрокаКомиссии.КомиссияИтого);
		ПараметрыДокумента.Вставить("Документ", 					СтрокаКомиссии.ДокументНачисления); 
		ПараметрыДокумента.Вставить("ДатаНачисления", 				Объект.ДатаНачисленияКомиссии);
		
		РезультатОбработки = СоздатьОбновитьДокументНачисленияЗадолженности(ПараметрыДокумента, ПараметрыСессии);
		
		Если Не РезультатОбработки.Результат Тогда
			СтрокаКомиссии.КомментарийНачисления = РезультатОбработки.Комментарий;			
		Иначе
			ДокументЗаписан = ЗначениеЗаполнено(РезультатОбработки.Документ);
			СтрокаКомиссии.КомментарийНачисления = "";
			СтрокаКомиссии.ДокументНачисления    = РезультатОбработки.Документ;
			СтрокаКомиссии.Обрабатывать          = Ложь;			
			ОтобразитьИзменениеДанных(РезультатОбработки.Документ, ?(ДокументЗаписан, ВидИзмененияДанных.Изменение, ВидИзмененияДанных.Добавление));
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыОплаты(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СоздатьДокументыОплаты");
	Попытка
		ВыполнитьСозданиеДокументовОплаты(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСозданиеДокументовОплаты(ПараметрыСессии)
	
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	Для Каждого СтрокаКомиссии Из Объект.Комиссии Цикл
		
		Если Не СтрокаКомиссии.Обрабатывать Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыДокумента = Новый Структура;
		ПараметрыДокумента.Вставить("Организация", 				    Объект.Организация);
		ПараметрыДокумента.Вставить("СчетДоверительногоУправления", СтрокаКомиссии.СчетДоверительногоУправления);
		ПараметрыДокумента.Вставить("Контрагент", 				    Объект.Брокер);
		ПараметрыДокумента.Вставить("Период", 					    Объект.КонецПериода);
		ПараметрыДокумента.Вставить("Валюта", 					    Валюта);
		ПараметрыДокумента.Вставить("Сумма", 					    СтрокаКомиссии.КомиссияИтого);
		ПараметрыДокумента.Вставить("ДокументНачисления", 			СтрокаКомиссии.ДокументНачисления);
		ПараметрыДокумента.Вставить("Документ", 					СтрокаКомиссии.ДокументОплаты);
		ПараметрыДокумента.Вставить("ДатаОплаты", 					Объект.ДатаОплатыКомиссии);
		
		РезультатОбработки = СоздатьОбновитьДокументОплаты(ПараметрыДокумента, ПараметрыСессии);
		
		Если Не РезультатОбработки.Результат Тогда
			СтрокаКомиссии.КомментарийОплаты = РезультатОбработки.Комментарий;			
		Иначе
			ДокументЗаписан = ЗначениеЗаполнено(РезультатОбработки.Документ);
			СтрокаКомиссии.КомментарийОплаты = "";
			СтрокаКомиссии.ДокументОплаты    = РезультатОбработки.Документ;
			СтрокаКомиссии.Обрабатывать          = Ложь;			
			ОтобразитьИзменениеДанных(РезультатОбработки.Документ, ?(ДокументЗаписан, ВидИзмененияДанных.Изменение, ВидИзмененияДанных.Добавление));
		КонецЕсли;
		
	КонецЦикла; 	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РаспределитьКомиссиюСтороннегоБрокера()
	
	
	ТаблицаКомиссий = Новый ТаблицаЗначений;
	ТаблицаКомиссий.Колонки.Добавить("СчетДоверительногоУправления");
	ТаблицаКомиссий.Колонки.Добавить("ЦеннаяБумага");
	ТаблицаКомиссий.Колонки.Добавить("КомиссияБрокера");
	ТаблицаКомиссий.Колонки.Добавить("КомиссияСтороннегоБрокера");
	
	Для Каждого СтрокаКомиссии Из Объект.Расчет Цикл
		НоваяСтрока = ТаблицаКомиссий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКомиссии);
	КонецЦикла;
	
	РаспределитьСуммуПоКолонкеТаблицы(Объект.КомиссияСтороннегоБрокера, ТаблицаКомиссий, "КомиссияСтороннегоБрокера", "КомиссияБрокера");
	
	Для Каждого СтрокаКомиссии Из Объект.Расчет Цикл
		НайдСтроки = ТаблицаКомиссий.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, ЦеннаяБумага", СтрокаКомиссии.СчетДоверительногоУправления, СтрокаКомиссии.ЦеннаяБумага));
		Если НайдСтроки.Количество() > 0 Тогда
			// Одна строка
			СтрокаКомиссии.КомиссияСтороннегоБрокера = НайдСтроки[0].КомиссияСтороннегоБрокера;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКомиссий.Свернуть("СчетДоверительногоУправления", "КомиссияСтороннегоБрокера");
	Для Каждого СтрокаКомиссии Из Объект.Комиссии Цикл
		НайдСтроки = ТаблицаКомиссий.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаКомиссии.СчетДоверительногоУправления));
		Если НайдСтроки.Количество() > 0 Тогда
			// Одна строка
			СтрокаКомиссии.КомиссияСтороннегоБрокера = НайдСтроки[0].КомиссияСтороннегоБрокера;
			СтрокаКомиссии.КомиссияИтого = СтрокаКомиссии.КомиссияБрокера + СтрокаКомиссии.КомиссияСтороннегоБрокера; 			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // РаспределитьКомиссиюСтороннегоБрокера()

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат       = ОбработкаОбъект.ВыполнитьЗапросВСКД();
	Результат.Колонки.Добавить("КомиссияБрокера");
	Результат.ЗаполнитьЗначения(0, "КомиссияБрокера");
	Результат.Колонки.Добавить("КомиссияСтороннегоБрокера");
	Результат.ЗаполнитьЗначения(0, "КомиссияСтороннегоБрокера");
	МассивЦБЗаДень = Новый Массив;
	
	// Распределям комиссии за каждый день по счетам ДУ по каждой бумаге
	ВремТаблица     = Результат.СкопироватьКолонки();
		
	ТекДата = Объект.НачалоПериода;
	Пока ТекДата <= Объект.КонецПериода Цикл		
			
		ТекОтбор = Новый Структура("Период", КонецДня(ТекДата));
		НайдСтроки = Результат.НайтиСтроки(ТекОтбор);
		Если НайдСтроки.Количество() = 0 Тогда
			ТекДата = ТекДата + 86400;
			Продолжить;
		КонецЕсли;
		
		МассивЦБЗаДень.Очистить();
		Для Каждого НайдСтрока Из НайдСтроки Цикл
			Если МассивЦБЗаДень.Найти(НайдСтрока.ЦеннаяБумага) = Неопределено Тогда
				МассивЦБЗаДень.Добавить(НайдСтрока.ЦеннаяБумага);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЦБЗаДень Из МассивЦБЗаДень Цикл
			
			ВремТаблица.Очистить();
			
			ТекОтбор = Новый Структура("Период, ЦеннаяБумага", КонецДня(ТекДата), ЦБЗаДень);
			НайдСтроки = Результат.НайтиСтроки(ТекОтбор);
			Для Каждого НайдСтрока Из НайдСтроки Цикл
				НоваяСтрока = ВремТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			КонецЦикла;
			
			РаспределитьСуммуПоКолонкеТаблицы(ВремТаблица.Итог("КомиссияБрокераРасчетная"), ВремТаблица, "КомиссияБрокера", "БазаРаспределенияКомиссии");
			
			Сч = 0;
			Для Каждого НайдСтрока Из НайдСтроки Цикл
				ВремСтрока = ВремТаблица.Получить(Сч);
				ЗаполнитьЗначенияСвойств(НайдСтрока, ВремСтрока);
				Сч = Сч + 1;
			КонецЦикла;
		
		КонецЦикла;
					
		ТекДата = ТекДата + 86400;
		
	КонецЦикла;	
	
	// Удалим служебные строки с пустым счетом ДУ
	ТекОтбор = Новый Структура("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.ПустаяСсылка());
	СтрокиКУдалению = Результат.НайтиСтроки(ТекОтбор);
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл  		
		Результат.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	РезультатСвернуто = Результат.Скопировать();
	
	РезультатСвернуто.Свернуть("СчетДоверительногоУправления, Ценнаябумага", "КомиссияБрокера, КомиссияСтороннегоБрокера");
	РезультатСвернуто.Сортировать("СчетДоверительногоУправления");
	
	ТаблицаКомиссийСтороннегоБрокера = Новый ТаблицаЗначений;
	Если Объект.КомиссияСтороннегоБрокера > 0 Тогда
		РаспределитьСуммуПоКолонкеТаблицы(Объект.КомиссияСтороннегоБрокера, РезультатСвернуто, "КомиссияСтороннегоБрокера", "КомиссияБрокера");
		ТаблицаКомиссийСтороннегоБрокера = РезультатСвернуто.Скопировать();
		ТаблицаКомиссийСтороннегоБрокера.Свернуть("СчетДоверительногоУправления", "КомиссияСтороннегоБрокера");
	КонецЕсли;
	
	Объект.Расчет.Очистить();
	Объект.Комиссии.Очистить();
	
	Для Каждого СтрокаРезультата Из РезультатСвернуто Цикл
		НоваяСтрока = Объект.Расчет.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
		НоваяСтрока.КомиссияИтого = НоваяСтрока.КомиссияБрокера + НоваяСтрока.КомиссияСтороннегоБрокера;
	КонецЦикла;
	
	РезультатСвернуто = Результат.Скопировать();
	РезультатСвернуто.Свернуть("СчетДоверительногоУправления, ДокументНачисления, ДокументОплаты", "КомиссияБрокера, КомиссияСтороннегоБрокера");
	
	Для Каждого СтрокаРезультата Из РезультатСвернуто Цикл
		
		Если ТаблицаКомиссийСтороннегоБрокера.Количество() > 0 Тогда 
			НайдСтроки = ТаблицаКомиссийСтороннегоБрокера.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаРезультата.СчетДоверительногоУправления));	
			Если НайдСтроки.Количество() > 0 Тогда
				// Строка одна
				СтрокаРезультата.КомиссияСтороннегоБрокера = НайдСтроки[0].КомиссияСтороннегоБрокера;				
			КонецЕсли;
		КонецЕсли;			
			
		НоваяСтрока = Объект.Комиссии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
		НоваяСтрока.КомиссияИтого = НоваяСтрока.КомиссияБрокера + НоваяСтрока.КомиссияСтороннегоБрокера;
		НоваяСтрока.Обрабатывать = Истина;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьФлажки(Режим)
	
	Для Каждого ТекСтрока Из Объект.Комиссии Цикл		
		ТекСтрока.Обрабатывать = Режим;
	КонецЦикла;
	
КонецПроцедуры // УстановитьСнятьФлажки	

