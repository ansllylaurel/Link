
&НаСервере
Процедура СформироватьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ОбработкаОбъект.Эмитенты = Эмитенты;
	
	ОбработкаОбъект.ЗаполнитьОтчет(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		СформироватьНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	БлижайшийТорговыйДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"), НачалоДня(ТекущаяДатаСеанса() - 86400));
	
	Объект.Период		= БлижайшийТорговыйДень;
	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Эмитенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_МКБ"));
	Эмитенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Сафмар"));
	Эмитенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_ОВКФинанс"));
	Эмитенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_МВидео"));
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
