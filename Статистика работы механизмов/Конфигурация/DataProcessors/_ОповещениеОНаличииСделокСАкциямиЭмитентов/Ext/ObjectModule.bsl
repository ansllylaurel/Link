
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Оповещение о наличии сделок с акциями эмитентов", 
		"0.08", 
		"", 
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповещениеОНаличииСделокСАкциямиЭмитентовРЭМ",	"Оповещение о наличии сделок с акциями эмитентов РЭМ",,		Ложь,	"ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповещениеОНаличииСделокСАкциямиЭмитентовТраст",	"Оповещение о наличии сделок с акциями эмитентов Траст",,	Ложь,	"ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповещениеОНаличииСделокСАкциямиЭмитентовРПИ",	"Оповещение о наличии сделок с акциями эмитентов РПИ",,		Ложь,	"ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если Найти(ИдентификаторКоманды, "ОповещениеОНаличииСделокСАкциямиЭмитентов") = 1  Тогда
		
		ТД = ТекущаяДатаСеанса();
		
		// Обработка запускается только в рабочие дни по общеросссийскому календарю.
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТД) Тогда
			
			ЭтотОбъект.Организация	= ПараметрыКоманды.Организация;
			Получатели				= ПараметрыКоманды.Получатели;
			
			СписокЭмитентов = Новый Массив;
			СписокИменованныхОбъектовЭмитентов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыКоманды.Эмитенты, ";", Истина, Истина);
			
			Если СписокИменованныхОбъектовЭмитентов.Количество() = 0 Тогда
				ЗарегистрироватьОшибку("Нет данных об эмитентах для проверки!");
				Возврат;
			КонецЕсли;
			
			Для Каждого ТекОбъект Из СписокИменованныхОбъектовЭмитентов Цикл
				ЭтотОбъект.Эмитенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект(ТекОбъект));
			КонецЦикла;
			
			// Обрабатываем все рабочие дни по календарю котировок с последнего рабочего дня по общероссийскому календарю.
			// Сегодняшний день не обрабатывается, т.к. не все документы могут быть разнесены.
			КонецПериода = НачалоДня(ТД - 86400);
			// Т.к. документы разносятся только в рабочие дни, то и первый проверяемый день определяем по общероссийскому календарю.
			НачалоПериода = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецПериода);
			
			// Получаем массив торговых дней.
			// После обновления заменить на вызов метода модуля менеджера справочника Календари.
			ОбрабатываемыеДни = Справочники.Календари.ПолучитьРабочиеДниПериода(ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"), НачалоПериода, КонецПериода);
			
			// Формируем отчет по каждому торговому дню.
			Для Каждого ТекДень Из ОбрабатываемыеДни Цикл
				
				ЭтотОбъект.Период = ТекДень;
				
				ОповеститьОНаличииСделок(Получатели);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОНаличииСделок(Получатели) Экспорт
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ЗаполнитьОтчет(ДокументРезультат);
	
	Если ДокументРезультат.ВысотаТаблицы > 0 Тогда
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("htm");
		ДокументРезультат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
		
		ТемаПисьма = "Оповещение о наличии сделок с акциями эмитентов " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yy");
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяВременногоФайла);
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", Получатели, ТемаПисьма, ТелоПисьма.ПолучитьТекст(), ТипТекстаПочтовогоСообщения.HTML);
		
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
		
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ЗаполнитьОтчет(ДокументРезультат) Экспорт
	
	ДокументРезультат.Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Эмитенты",		ЭтотОбъект.Эмитенты.ВыгрузитьЗначения());
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаДокумент.Ссылка КАК Ссылка,
		|	СделкаДокумент.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаДокумент.Дата КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА УсловияСделок.ДатаПоставки > УсловияСделок.ДатаОплаты
		|			ТОГДА УсловияСделок.ДатаПоставки
		|		ИНАЧЕ УсловияСделок.ДатаОплаты
		|	КОНЕЦ КАК ДатаРасчетов,
		|	СделкаДокумент.ВидСделки КАК ВидОперации,
		|	УсловияСделок.Рынок КАК Рынок,
		|	УсловияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделок.Цена КАК Цена,
		|	УсловияСделок.ЦенаКупона КАК ЦенаКупона,
		|	УсловияСделок.Количество КАК Количество,
		|	УсловияСделок.Сумма + УсловияСделок.СуммаКупона КАК Сумма,
		|	0 КАК КоличествоДней,
		|	0 КАК Ставка,
		|	СделкаДокумент.ВалютаСделки КАК ВалютаСделки,
		|	СделкаДокумент.Ссылка КАК Основание,
		|	0 КАК ЧастьСделкиРЕПО
		|ПОМЕСТИТЬ _СделкиДокументы
		|ИЗ
		|	Документ.Сделка КАК СделкаДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок КАК УсловияСделок
		|		ПО СделкаДокумент.Ссылка = УсловияСделок.Регистратор
		|ГДЕ
		|	СделкаДокумент.Проведен
		|	И СделкаДокумент.Организация = &Организация
		|	И СделкаДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И УсловияСделок.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|	И УсловияСделок.ЦеннаяБумага.Эмитент В(&Эмитенты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПОДокумент.Ссылка,
		|	СделкаРЕПОДокумент.СчетДоверительногоУправления,
		|	СделкаРЕПОДокумент.Дата,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ДатаПоставки > УсловияСделокРЕПО.ДатаОплаты
		|			ТОГДА УсловияСделокРЕПО.ДатаПоставки
		|		ИНАЧЕ УсловияСделокРЕПО.ДатаОплаты
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаРЕПОДокумент.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|						ТОГДА ""Покупка (РЕПО)""
		|					ИНАЧЕ ""Продажа (РЕПО)""
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА СделкаРЕПОДокумент.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|					ТОГДА ""Продажа (РЕПО ч.2)""
		|				ИНАЧЕ ""Покупка (РЕПО ч.2)""
		|			КОНЕЦ
		|	КОНЕЦ,
		|	УсловияСделокРЕПО.Рынок,
		|	УсловияСделокРЕПО.ЦеннаяБумага,
		|	УсловияСделокРЕПО.Цена,
		|	УсловияСделокРЕПО.ЦенаКупона,
		|	УсловияСделокРЕПО.Количество,
		|	УсловияСделокРЕПО.Сумма + УсловияСделокРЕПО.СуммаКупона,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2
		|			ТОГДА 0
		|		КОГДА УсловияСделокРЕПО.ДатаВторойЧастиРЕПО = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА РАЗНОСТЬДАТ(УсловияСделокРЕПО.ДатаПоставки, СделкаРЕПОДокумент.ДатаПоставкиВторойЧасти, ДЕНЬ)
		|		ИНАЧЕ РАЗНОСТЬДАТ(УсловияСделокРЕПО.ДатаПоставки, УсловияСделокРЕПО.ДатаВторойЧастиРЕПО, ДЕНЬ)
		|	КОНЕЦ,
		|	УсловияСделокРЕПО.СтавкаРЕПО,
		|	СделкаРЕПОДокумент.ВалютаСделки,
		|	СделкаРЕПОДокумент.Ссылка,
		|	УсловияСделокРЕПО.ЧастьСделкиРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПОДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО КАК УсловияСделокРЕПО
		|		ПО СделкаРЕПОДокумент.Ссылка = УсловияСделокРЕПО.Регистратор
		|			И (СделкаРЕПОДокумент.ЧастьСделкиРЕПО < 2)
		|ГДЕ
		|	СделкаРЕПОДокумент.Проведен
		|	И СделкаРЕПОДокумент.Организация = &Организация
		|	И СделкаРЕПОДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И УсловияСделокРЕПО.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|	И УсловияСделокРЕПО.ЦеннаяБумага.Эмитент В(&Эмитенты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Регистратор,
		|	ВложенныйЗапрос.СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.ДатаРасчетов,
		|	ВложенныйЗапрос.ВидОперации,
		|	ВложенныйЗапрос.Рынок,
		|	ВложенныйЗапрос.ЦеннаяБумага,
		|	ВложенныйЗапрос.Цена - УсловияСделок.Цена,
		|	ВложенныйЗапрос.ЦенаКупона - УсловияСделок.ЦенаКупона,
		|	ВложенныйЗапрос.Количество - УсловияСделок.Количество,
		|	ВложенныйЗапрос.СуммаСделкиСУчетомНКД - (УсловияСделок.Сумма + УсловияСделок.СуммаКупона),
		|	ВложенныйЗапрос.КоличествоДней,
		|	ВложенныйЗапрос.Ставка,
		|	ВложенныйЗапрос.ВалютаСделки,
		|	ВложенныйЗапрос.Основание,
		|	0
		|ИЗ
		|	(ВЫБРАТЬ
		|		УсловияСделок.Период КАК Период,
		|		УсловияСделок.Регистратор КАК Регистратор,
		|		УсловияСделок.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ВЫБОР
		|			КОГДА УсловияСделок.ДатаПоставки > УсловияСделок.ДатаОплаты
		|				ТОГДА УсловияСделок.ДатаПоставки
		|			ИНАЧЕ УсловияСделок.ДатаОплаты
		|		КОНЕЦ КАК ДатаРасчетов,
		|		СделкаДокумент.ВидСделки КАК ВидОперации,
		|		УсловияСделок.Рынок КАК Рынок,
		|		УсловияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|		ВЫБОР
		|			КОГДА УсловияСделок.Отменено
		|				ТОГДА 0
		|			ИНАЧЕ УсловияСделок.Цена
		|		КОНЕЦ КАК Цена,
		|		ВЫБОР
		|			КОГДА УсловияСделок.Отменено
		|				ТОГДА 0
		|			ИНАЧЕ УсловияСделок.ЦенаКупона
		|		КОНЕЦ КАК ЦенаКупона,
		|		ВЫБОР
		|			КОГДА УсловияСделок.Отменено
		|				ТОГДА 0
		|			ИНАЧЕ УсловияСделок.Количество
		|		КОНЕЦ КАК Количество,
		|		ВЫБОР
		|			КОГДА УсловияСделок.Отменено
		|				ТОГДА 0
		|			ИНАЧЕ УсловияСделок.Сумма + УсловияСделок.СуммаКупона
		|		КОНЕЦ КАК СуммаСделкиСУчетомНКД,
		|		0 КАК КоличествоДней,
		|		0 КАК Ставка,
		|		СделкаДокумент.ВалютаСделки КАК ВалютаСделки,
		|		СделкаДокумент.Ссылка КАК Основание,
		|		МАКСИМУМ(УсловияСделокСрез.Период) КАК ПериодПоследнихУсловий
		|	ИЗ
		|		РегистрСведений.УсловияСделок КАК УсловияСделок
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК СделкаДокумент
		|			ПО (УсловияСделок.Активность)
		|				И УсловияСделок.Сделка = СделкаДокумент.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок КАК УсловияСделокСрез
		|			ПО (УсловияСделокСрез.Активность)
		|				И УсловияСделок.Организация = УсловияСделокСрез.Организация
		|				И УсловияСделок.Сделка = УсловияСделокСрез.Сделка
		|				И УсловияСделок.Рынок = УсловияСделокСрез.Рынок
		|				И УсловияСделок.ЦеннаяБумага = УсловияСделокСрез.ЦеннаяБумага
		|				И УсловияСделок.Период > УсловияСделокСрез.Период
		|	ГДЕ
		|		ТИПЗНАЧЕНИЯ(УсловияСделок.Регистратор) <> ТИП(Документ.Сделка)
		|		И УсловияСделок.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|		И УсловияСделок.Организация = &Организация
		|		И УсловияСделок.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|		И УсловияСделок.ЦеннаяБумага.Эмитент В(&Эмитенты)
		|	
