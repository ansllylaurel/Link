		|		ПО ВыводЦенныхБумагЦенныеБумаги.Ссылка = ВыводЦенныхБумаг.Ссылка
		|ГДЕ
		|	ВыводЦенныхБумаг.Проведен
		|	И ВыводЦенныхБумаг.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВыводЦенныхБумаг.Организация = &Организация
		|	И ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|	И ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Эмитент В(&Эмитенты)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыводЦенныхБумаг.Ссылка,
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления,
		|	ВыводЦенныхБумаг.Дата,
		|	ВыводЦенныхБумаг.Рынок,
		|	ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
		|	ВыводЦенныхБумагЦенныеБумаги.СуммаРынок / ВыводЦенныхБумагЦенныеБумаги.Количество,
		|	ВыводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок / ВыводЦенныхБумагЦенныеБумаги.Количество,
		|	ВыводЦенныхБумаг.Организация.ВалютаУчета,
		|	ВыводЦенныхБумаг.Дата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеДивидендов.Ссылка,
		|	НачислениеДивидендов.СчетДоверительногоУправления,
		|	НачислениеДивидендов.Дата,
		|	НачислениеДивидендов.ДатаОплатыПлановая,
		|	""Начисление дивидендов"",
		|	НачислениеДивидендов.Рынок,
		|	НачислениеДивидендов.ЦеннаяБумага,
		|	НачислениеДивидендов.Количество,
		|	НачислениеДивидендов.Сумма / НачислениеДивидендов.Количество,
		|	0,
		|	НачислениеДивидендов.Сумма,
		|	НачислениеДивидендов.ВалютаОплаты
		|ИЗ
		|	Документ.НачислениеДивидендов КАК НачислениеДивидендов
		|ГДЕ
		|	НачислениеДивидендов.Проведен
		|	И НачислениеДивидендов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НачислениеДивидендов.Организация = &Организация
		|	И НачислениеДивидендов.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|	И НачислениеДивидендов.ЦеннаяБумага.Эмитент В(&Эмитенты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиДокументы.Ссылка КАК Ссылка,
		|	_СделкиДокументы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СделкиДокументы.ДатаОперации КАК ДатаОперации,
		|	_СделкиДокументы.ДатаРасчетов КАК ДатаРасчетов,
		|	_СделкиДокументы.ВидОперации КАК ВидОперации,
		|	_СделкиДокументы.Рынок КАК Рынок,
		|	_СделкиДокументы.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СделкиДокументы.Цена КАК Цена,
		|	_СделкиДокументы.ЦенаКупона КАК ЦенаКупона,
		|	_СделкиДокументы.Количество КАК Количество,
		|	_СделкиДокументы.Сумма КАК Сумма,
		|	_СделкиДокументы.КоличествоДней КАК КоличествоДней,
		|	_СделкиДокументы.Ставка КАК Ставка,
		|	_СделкиДокументы.ВалютаСделки КАК ВалютаСделки,
		|	_СделкиДокументы.Основание КАК Основание,
		|	"""" КАК РегНомер,
		|	0 КАК Номинал,
		|	НЕОПРЕДЕЛЕНО КАК Банк,
		|	_СделкиДокументы.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО
		|ПОМЕСТИТЬ _Объединение
		|ИЗ
		|	_СделкиДокументы КАК _СделкиДокументы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦенныеБумагиДокументы.Ссылка,
		|	_ЦенныеБумагиДокументы.СчетДоверительногоУправления,
		|	_ЦенныеБумагиДокументы.Дата,
		|	_ЦенныеБумагиДокументы.ДатаРасчетов,
		|	_ЦенныеБумагиДокументы.ВидОперации,
		|	_ЦенныеБумагиДокументы.Рынок,
		|	_ЦенныеБумагиДокументы.ЦеннаяБумага,
		|	_ЦенныеБумагиДокументы.Цена,
		|	_ЦенныеБумагиДокументы.ЦенаКупона,
		|	_ЦенныеБумагиДокументы.Количество,
		|	_ЦенныеБумагиДокументы.Сумма,
		|	0,
		|	0,
		|	_ЦенныеБумагиДокументы.Валюта,
		|	_ЦенныеБумагиДокументы.Ссылка,
		|	"""",
		|	0,
		|	НЕОПРЕДЕЛЕНО,
		|	0
		|ИЗ
		|	_ЦенныеБумагиДокументы КАК _ЦенныеБумагиДокументы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Объединение.Ссылка КАК Ссылка,
		|	_Объединение.СчетДоверительногоУправления КАК Портфель,
		|	_Объединение.СчетДоверительногоУправления.КодСчета КАК КодПортфеля,
		|	_Объединение.ДатаОперации КАК ДатаОперации,
		|	_Объединение.ДатаОперации КАК ВремяОперации,
		|	_Объединение.ДатаРасчетов КАК ДатаРасчетов,
		|	_Объединение.ВидОперации КАК ВидОперации,
		|	_Объединение.Рынок КАК Рынок,
		|	_Объединение.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФ.УправляющаяКомпания
		|		ИНАЧЕ _Объединение.Банк
		|	КОНЕЦ КАК Эмитент,
		|	ЕСТЬNULL(КодыВТорговыхСистемах.Код, _Объединение.РегНомер) КАК КодММВБ,
		|	ЕСТЬNULL(НоминалыЦенныхБумаг.Номинал, _Объединение.Номинал) КАК Номинал,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ _Объединение.РегНомер
		|	КОНЕЦ КАК РегНомер,
		|	_Объединение.Цена КАК Цена,
		|	_Объединение.ЦенаКупона КАК ЦенаКупона,
		|	_Объединение.Количество КАК Количество,
		|	_Объединение.Сумма КАК Сумма,
		|	_Объединение.КоличествоДней КАК КоличествоДней,
		|	_Объединение.Ставка КАК Ставка,
		|	_Объединение.ВалютаСделки КАК ВалютаСделки,
		|	_Объединение.Основание КАК Основание,
		|	_Объединение.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО
		|ИЗ
		|	_Объединение КАК _Объединение
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Объединение.ДатаОперации КАК ДатаОперации,
		|			_Объединение.ЦеннаяБумага КАК ЦеннаяБумага,
		|			КодыВТорговыхСистемах.ВидКода КАК ВидКода,
		|			ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|			МАКСИМУМ(КодыВТорговыхСистемах.Период) КАК ПериодКодаММВБ,
		|			МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК ПериодНоминала,
		|			МАКСИМУМ(РеквизитыПИФ.Период) КАК ПериодУправляющейКомпании
		|		ИЗ
		|			_Объединение КАК _Объединение
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах КАК КодыВТорговыхСистемах
		|				ПО _Объединение.ЦеннаяБумага = КодыВТорговыхСистемах.Объект
		|					И (ВЫБОР
		|						КОГДА ТИПЗНАЧЕНИЯ(_Объединение.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|							ТОГДА КодыВТорговыхСистемах.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)
		|						ИНАЧЕ КодыВТорговыхСистемах.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)
		|					КОНЕЦ)
		|					И _Объединение.ДатаОперации >= КодыВТорговыхСистемах.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|				ПО _Объединение.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|					И _Объединение.ДатаОперации >= НоминалыЦенныхБумаг.Период
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|				ПО (ВЫРАЗИТЬ(_Объединение.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|					И _Объединение.ДатаОперации >= РеквизитыПИФ.Период
		|		ГДЕ
		|			НЕ(КодыВТорговыхСистемах.Период ЕСТЬ NULL
		|						И НоминалыЦенныхБумаг.Период ЕСТЬ NULL
		|						И РеквизитыПИФ.Период ЕСТЬ NULL)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Объединение.ЦеннаяБумага,
		|			_Объединение.ДатаОперации,
		|			КодыВТорговыхСистемах.ВидКода) КАК ВложенныйЗапрос
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах КАК КодыВТорговыхСистемах
		|			ПО ВложенныйЗапрос.ЦеннаяБумага = КодыВТорговыхСистемах.Объект
		|				И ВложенныйЗапрос.ВидКода = КодыВТорговыхСистемах.ВидКода
		|				И ВложенныйЗапрос.ПериодКодаММВБ = КодыВТорговыхСистемах.Период
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|			ПО ВложенныйЗапрос.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|				И ВложенныйЗапрос.ПериодНоминала = НоминалыЦенныхБумаг.Период
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|			ПО ВложенныйЗапрос.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд
		|				И ВложенныйЗапрос.ПериодУправляющейКомпании = РеквизитыПИФ.Период
		|		ПО _Объединение.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумага
		|			И _Объединение.ДатаОперации = ВложенныйЗапрос.ДатаОперации";
	#КонецОбласти
	
	Операции = Запрос.Выполнить().Выгрузить();
	
	Если Операции.Количество() > 0 Тогда
		ВыестиСделки(Операции, ДокументРезультат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыестиСделки(Операции, ДокументРезультат)
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьЗаголовок.Параметры.ДатаОтчета	= Формат(Период, "ДФ=dd.MM.yyyy");
	ОбластьЗаголовок.Параметры.Организация	= Организация;
	
	ДокументРезультат.Вывести(ОбластьЗаголовок);
	
	Для Каждого Операция Из Операции Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Операция);
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

// Функция возвращает массив дат, состоящий из рабочих и предпраздничных дней.
// указанного календаря
//
// Параметры:
//	- Календарь		- тип СправочникСсылка.Календари
//	- НачалоПериода	- тип Дата
//	- КонецПериода	- тип Дата
//
Функция ПолучитьРабочиеДниПериода(Календарь, НачалоПериода, КонецПериода) Экспорт
	
	Если НЕ Справочники.Календари.КалендарьЗаполненЗаПериод(Календарь, НачалоПериода, КонецПериода) Тогда
		ВызватьИсключение "Календарь " + Календарь + " не заполнен за период с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеКалендаря.Дата КАК РабочийДень
	|ИЗ
	|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
	|ГДЕ
	|	ДанныеКалендаря.Календарь = &Календарь
	|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))"
	);
	
	Запрос.УстановитьПараметр("Календарь",     Календарь);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("РабочийДень");
	
КонецФункции

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;