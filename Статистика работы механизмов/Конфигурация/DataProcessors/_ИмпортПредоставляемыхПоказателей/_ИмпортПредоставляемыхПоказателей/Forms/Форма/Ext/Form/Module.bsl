
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период=ТекущаяДата();

	
	// Заполнение соотвествия кодов клиента и предоставляемых показателей.
	НастройкиСопоставления = "10;СтраховыеРезервыВсего
	|11;СтраховыеРезервыПоСтрахованиюЖизни
	|12;РезервДополнительныхВыплатСтраховыхБонусов
	|13;РезервОпцийИГарантий
	|15;СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни
	|16;РезервЗаявленныхНоНеурегулированныхУбытков
	|17;РезервНезаработаннойПремии
	|18;РезервНезаработаннойПремииПоДоговорамВСфереГосЗакупок
	|19;ДополнительнаяЧастьРезерваНезаработаннойПремии
	|20;СтраховыеРезервыПоСтрахованиюТранспортныхСредствИОтвественностиВладельцев
	|21;РезервЗаявленныхНоНеУрегулированныхУбытковПоСтрахованиюТранспортныхСредств
	|22;ДополниительнаяЧастьРезерваНезаработаннойПремииПоСтрахованиюТранспортныхСредств
	|30;СтраховойРезервДляКомпенсацииОСАГО
	|31;ДополнительнаяЧастьРезерваНезаработаннойПремииОСАГО
	|41;УставныйКапитал
	|42;ДобавочныйКапитал
	|43;РезервныйКапитал
	|44;НераспределеннаяПрибыль
	|45;НепокрытыйУбыток
	|46;СобственныеВыкупленныеДолиИАкции
	|48;ВсегоСобственныхСредств
	|49;ВеличинаКорректировкиСтраховыхРезервов
	|50;МинимальныйРазмерУставногоКапитала
	|60;НормативныйРазмерМаржиПлатежеспособности
	|61;АктивыПолученныеПоДоговорамРЕПО
	|65;СобственныеСредстваСУчетомАктивовРЕПО
	|66;ПревышенияРазмераСобственныхСредствНадНаибольшимПоказателем";	
	
	Для ПозицияСтроки = 1 по СтрЧислоСтрок(НастройкиСопоставления) Цикл
		
		НоваяНастройкаСоотвествия = Объект.НастройкиСоотвествияКодовСтроки.Добавить();
		ТекстСопоставления = СтрПолучитьСтроку(НастройкиСопоставления, ПозицияСтроки);
		КодЗначение = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстСопоставления, ";"); 
		НоваяНастройкаСоотвествия.КодСтрокиКлиента = КодЗначение[0];
		НоваяНастройкаСоотвествия.ПредоставляемыйПоказатель = Перечисления.ВидыПоказателейСтраховыхКомпаний[КодЗначение[1]];
		
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьФайл(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортироватьФайл");
	Попытка
		ВыполнитьИмпортФайла(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИмпортФайла(ПараметрыСессии)
	
	Если НЕ(ЗначениеЗаполнено(Объект.Период)) Или НЕ (ЗначениеЗаполнено(Объект.СчетДоверительногоУправления)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходиммо указать период и Счет учета");
		ПараметрыСессии.ТекстОшибки = "Не указан период или счет учета";
		Возврат;		
	КонецЕсли;
	
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.МножественныйВыбор = Ложь;
	ДиалогВыбора.Фильтр = "Документ Excel (*.xls, *.xlsx)|*.xls;*.xlsx|";
	
	Если Не ДиалогВыбора.Выбрать() Тогда
		ПараметрыСессии.ТекстОшибки = "Файл не выбран";
		Возврат;
	КонецЕсли;

	Объект.ИмяФайла = СтрЗаменить(ДиалогВыбора.ПолноеИмяФайла,  ДиалогВыбора.Каталог,"");

	Объект.Показатели.Очистить();
	
	Excel = Новый COMОбъект("Excel.Application");
	
	WorkBooks = Excel.WorkBooks.Open(ДиалогВыбора.ПолноеИмяФайла);
	WorkSheet = Workbooks.Worksheets(1);
	
	НомерСтроки = 2;
	
	Объект.ЗаголовокФайлаКлиента = WorkSheet.Cells(НомерСтроки, 1).Text;
	НомерСтроки = 3;
	Объект.ДатаСоставленияКлиентаТекст = WorkSheet.Cells(НомерСтроки, 3).Text;

	Для НомерСтроки = 6 По WorkSheet.UsedRange.Rows.Count() Цикл
		
		Наименование = WorkSheet.Cells(НомерСтроки, 1).Text;
		КодСтроки = WorkSheet.Cells(НомерСтроки, 2).Text;	
		
		Если Наименование <> "" Или КодСтроки <> "" Тогда
		
			НоваяСтрокаПоказатели = ТаблицаXLS.Добавить();
			НоваяСтрокаПоказатели.НаименованиеПоказателяКлиент = Наименование;
			НоваяСтрокаПоказатели.КодСтрокиКлиент = КодСтроки;	
			НоваяСтрокаПоказатели.СуммаКлиент = WorkSheet.Cells(НомерСтроки, 3).Value;

		КонецЕсли 
		
	КонецЦикла;
	
	Excel.Quit();
	
	ЗаполнитьПоказателиНаСервере();
	
	ЭтаФорма.Элементы.ФормаЗаписатьРегистр.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоказателиНаСервере()
	
	Объект.Показатели.Очистить();
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаXLS.НаименованиеПоказателяКлиент КАК НаименованиеКлиент,
		|	ТаблицаXLS.КодСтрокиКлиент КАК КодСтроки,
		|	ТаблицаXLS.СуммаКлиент КАК Сумма
		|ПОМЕСТИТЬ _ПоказателиКлиента
		|ИЗ
		|	&ТаблицаXLS КАК ТаблицаXLS
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиСоотвествияКодовСтроки.КодСтрокиКлиента КАК КодСтроки,
		|	НастройкиСоотвествияКодовСтроки.ПредоставляемыйПоказатель КАК Показатель
		|ПОМЕСТИТЬ _Настройки
		|ИЗ
		|	&НастройкиСоотвествияКодовСтроки КАК НастройкиСоотвествияКодовСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПоказателиКлиента.НаименованиеКлиент КАК НаименованиеПоказателя,
		|	_ПоказателиКлиента.КодСтроки КАК КодСтроки,
		|	_ПоказателиКлиента.Сумма КАК СуммаРуб,
		|	ВидыПоказателейСтраховыхКомпаний.Ссылка КАК ПоказательПеречисление,
		|	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ЗначениеПоказателя КАК ПоказательСуммаПоследняя,
		|	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.Период КАК ДатаЗаписи
		|ИЗ
		|	_ПоказателиКлиента КАК _ПоказателиКлиента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Настройки КАК _Настройки
		|			ЛЕВОЕ СОЕДИНЕНИЕ Перечисление.ВидыПоказателейСтраховыхКомпаний КАК ВидыПоказателейСтраховыхКомпаний
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
		|						&Период,
		|						Организация = &Организация
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних
		|				ПО ВидыПоказателейСтраховыхКомпаний.Ссылка = ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ВидПоказателя
		|			ПО _Настройки.Показатель = ВидыПоказателейСтраховыхКомпаний.Ссылка
		|		ПО _ПоказателиКлиента.КодСтроки = _Настройки.КодСтроки";
	
	Запрос.УстановитьПараметр("ТаблицаXLS", ТаблицаXLS.Выгрузить());
	Запрос.УстановитьПараметр("НастройкиСоотвествияКодовСтроки", Объект.НастройкиСоотвествияКодовСтроки.Выгрузить());
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ДанныеКлиента = Запрос.Выполнить().Выбрать();
	
	Пока ДанныеКлиента.Следующий() Цикл
		
		Показатель = Объект.Показатели.Добавить();
		
		ЗаполнитьЗначенияСвойств(Показатель, ДанныеКлиента);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРегистрНаСервере()
	
	КоличествоЗаписей = 0;
	
	НачатьТранзакцию();
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний");
	ЭлементБлокировки.УстановитьЗначение("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	БлокировкаДанных.Заблокировать();
	
	Для Каждого Показатель Из Объект.Показатели Цикл
		
		Если  Показатель.СуммаРуб > 0 И ЗначениеЗаполнено( Показатель.ПоказательПеречисление ) Тогда
		
			МенеджерЗаписи = РегистрыСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Организация = Объект.Организация;
			МенеджерЗаписи.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
			МенеджерЗаписи.ВидПоказателя = Показатель.ПоказательПеречисление;
			МенеджерЗаписи.ЗначениеПоказателя = Показатель.СуммаРуб;
			МенеджерЗаписи.Период = Объект.Период;		
			
			МенеджерЗаписи.Записать();
			
			КоличествоЗаписей = КоличествоЗаписей + 1;
		
		КонецЕсли;
		
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Импорт завершен. Импортировано " + КоличествоЗаписей +" показателей.");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРегистр(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ЗаписатьРегистр");
	Попытка
		ЗаписатьРегистрНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
