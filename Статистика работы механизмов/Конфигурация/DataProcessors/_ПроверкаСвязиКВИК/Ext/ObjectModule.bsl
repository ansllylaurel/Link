// ОСНОВНОЙ ФУНКЦИОНАЛ
Функция ЭтоРабочийИлиТорговыйДень(НачалоДня)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ДанныеКалендаряКотировок.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ИЛИ ДанныеОбщероссийскогоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагРабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаряКотировок,
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеОбщероссийскогоКалендаря
		|ГДЕ
		|	ДанныеКалендаряКотировок.Календарь = &КалендарьКотировок
		|	И ДанныеОбщероссийскогоКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаряКотировок.Дата = &НачалоДня
		|	И ДанныеОбщероссийскогоКалендаря.Дата = &НачалоДня";
	
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат[0].ФлагРабочийДень;
	
КонецФункции

Функция ПреобразованиеДаты(Дт)
	
	Если Не ЗначениеЗаполнено(Дт) = 1 Тогда
        Возврат "NULL";
    Иначе
        Возврат "DATEADD(dd, " + День(Дт) + "-1, DATEADD(mm, " + Месяц(Дт) + "-1, DATEADD(yyyy, " + Формат(Год(Дт), "ЧЦ=4; ЧГ=0") + "-1900, 0)))";
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьСвязьВСистемеКВИК() Экспорт
	
	СоединениеРЭМ  = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportRam";
	СоединениеТраст = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportTrast";
	СоединениеРПИ = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportRpi";
	СоединениеМдТраст = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportMdTrast";
	
	ТекстЗапроса = 	
		"SELECT TOP 1
		|	MessDisconnect.MessTime,
		|	MessDisconnect.Message
		|FROM 
		|	(SELECT TOP 1 
		|		Mess.MessTime, 
		|		CAST(REPLACE(Mess.MessTime, ':', '') AS int) MessTimeAsInt,
		|		Mess.Message
		|	FROM [bc].[Messages] Mess 
		|	WHERE Mess.MessDate = @Date
		|		AND CAST(REPLACE (Mess.MessTime, ':', '') AS int) BETWEEN 93000 AND 210000 -- '09:30:00' AND '21:00:00'
		|		AND	(Mess.Message LIKE '%Неверный пароль%' 
		|			OR Mess.Message LIKE '%Соединение разорвано%' 
		|			OR Mess.Message LIKE '%Соединение установить не удалось%' 
		|			OR Mess.Message LIKE '%Net error%')
		|	ORDER BY MessTimeAsInt DESC) MessDisconnect
		|LEFT JOIN [bc].[Messages] MessConnect
		|ON MessDisconnect.MessTimeAsInt >= CAST(REPLACE(MessConnect.MessTime, ':', '') AS int) 
		|	AND MessConnect.MessDate = @Date
		|	AND MessConnect.Message LIKE'%Соединение установлено%'
		|WHERE MessConnect.Message IS NULL ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@Date", ПреобразованиеДаты(ЭтотОбъект.Период));
	
	ТипыДанныхКВИК = Новый Структура("MessTime, Message", 
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(8)),
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	ОбрывыСвязиРЭМ_БК = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеРЭМ, ТекстЗапроса, ТипыДанныхКВИК);
	ОбрывыСвязиТраст_БК  = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеТраст, ТекстЗапроса, ТипыДанныхКВИК);
	ОбрывыСвязиРПИ_БК = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеРПИ, ТекстЗапроса, ТипыДанныхКВИК);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[bc]", "[gpb]"); 
	
	ОбрывыСвязиРЭМ_ГПБ = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеРЭМ, ТекстЗапроса, ТипыДанныхКВИК);
	ОбрывыСвязиТраст_ГПБ  = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеТраст, ТекстЗапроса, ТипыДанныхКВИК);

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[gpb]", "[rshb]");
	
    ОбрывыСвязиМдТраст_РСХБ = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеМдТраст, ТекстЗапроса, ТипыДанныхКВИК);
	
	ТекстПисьма = "";
	//а если не удалось?
	Если ОбрывыСвязиРЭМ_БК <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK РЭМ БК [" + ОбрывыСвязиРЭМ_БК[0].MessTime + "] " + ОбрывыСвязиРЭМ_БК[0].Message + Символы.ПС;
	КонецЕсли;
	
	Если ОбрывыСвязиТраст_БК <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK ТРАСТ БК [" + ОбрывыСвязиТраст_БК[0].MessTime + "] " + ОбрывыСвязиТраст_БК[0].Message + Символы.ПС;
	КонецЕсли;
	
	Если ОбрывыСвязиРПИ_БК <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK РПИ БК [" + ОбрывыСвязиРПИ_БК[0].MessTime + "] " + ОбрывыСвязиРПИ_БК[0].Message + Символы.ПС;
	КонецЕсли;
	
	Если ОбрывыСвязиРЭМ_ГПБ <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK РЭМ ГПБ [" + ОбрывыСвязиРЭМ_ГПБ[0].MessTime + "] " + ОбрывыСвязиРЭМ_ГПБ[0].Message + Символы.ПС;
	КонецЕсли;
	
	Если ОбрывыСвязиТраст_ГПБ <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK ТРАСТ ГПБ [" + ОбрывыСвязиТраст_ГПБ[0].MessTime + "] " + ОбрывыСвязиТраст_ГПБ[0].Message + Символы.ПС;
	КонецЕсли;

	Если ОбрывыСвязиМдТраст_РСХБ <> Неопределено Тогда
		ТекстПисьма = ТекстПисьма + "QUIK МД ТРАСТ РСХБ [" + ОбрывыСвязиМдТраст_РСХБ[0].MessTime + "] " + ОбрывыСвязиМдТраст_РСХБ[0].Message + Символы.ПС;
	КонецЕсли;

	Если ТекстПисьма <> "" Тогда
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстПисьма, ЭтотОбъект.ДополнительныеСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПисьма);
		КонецЕсли;
		
		ЭтотОбъект.ДополнительныеСвойства.Очистить();
		
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;