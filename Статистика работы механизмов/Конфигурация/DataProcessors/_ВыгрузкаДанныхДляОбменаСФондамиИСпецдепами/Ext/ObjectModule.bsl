	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьРейтинги") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	Рейтинги.Субъект КАК FICode,
		|	Рейтинги.Период КАК Date,
		|	Рейтинги.РейтинговоеАгентство КАК RACode,
		|	Рейтинги.Шкала КАК ScaleCode,
		|	Рейтинги.Рейтинг КАК Рейтинг,
		|	NULL КАК ForecastRVCode
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(&Период, Субъект В (&МассивСубъектов)) КАК Рейтинги";	
		
	МассивСубъектов = Новый Массив;
		
	Для Каждого СправочникДляВыгрузки Из СписокСправочниковФИ Цикл
		Если СправочникиКВыгрузке.Свойство(СправочникДляВыгрузки.Ключ) Тогда
			Для Каждого Субъект Из СправочникиКВыгрузке[СправочникДляВыгрузки.Ключ] Цикл
				МассивСубъектов.Добавить(Субъект);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Период"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("МассивСубъектов", МассивСубъектов);
	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	Данные.Колонки.Добавить("RValueCode");
	СоздатьСоставнойИдентификатор(Данные, "RACode,ScaleCode,Рейтинг", "RValueCode", Ложь);
	
	Данные.Колонки.Добавить("ExtCode");
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.ExtCode = Строка(СтрокаДанных.FICode.УникальныйИдентификатор()) + Строка(СтрокаДанных.RACode.УникальныйИдентификатор()) + Строка(СтрокаДанных.ScaleCode.УникальныйИдентификатор()) + Формат(СтрокаДанных.Date, "ДФ=yyyyMMdd");
	КонецЦикла;
	
	ДобавитьДанныеВПакет("РейтингиФИ,РейтингФИ", Данные);		
	
КонецПроцедуры	

Процедура ВыгрузитьРейтингиКонтрагентов()
	
