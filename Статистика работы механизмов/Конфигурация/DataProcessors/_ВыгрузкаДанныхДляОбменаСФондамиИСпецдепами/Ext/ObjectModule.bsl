	ВыгрузитьБанковскиеСчета();
	ВыгрузитьДоговораКонтрагентов();
	ВыгрузитьБрокерскиеСчета();
	ВыгрузитьКонтрагентов();
	
	ВыгрузитьРейтинговыеАгентства();
	ВыгрузитьШкалыРейтингов();
	ВыгрузитьЗначенияРейтингов();
	
	ВыгрузитьВидыОпераций();
	
	ВыгрузитьАналитическиеПризнакиБухгалтерскихСчетов();
	
	ВыгрузитьРеквизитыВыгрузки();
	
КонецПроцедуры

Процедура ДобавитьДанныеВПакет(СписокИменДанных, Данные)
	
	КонрольУникальностиExtCode(СписокИменДанных, Данные);
	
	Если Данные.Колонки.Найти("КонтрольОбязательныхРеквизитов") <> Неопределено Тогда
		КонтрольОбязательныхРеквизитов(Данные);
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Для Каждого Колонка Из Данные.Колонки Цикл
			ИсходноеЗнч = СтрокаДанных[Колонка.Имя];
			ТипИсходногоЗнч = ТипЗнч(ИсходноеЗнч);
			
			Если ИсходноеЗнч = "00x0xx0x-xxx0-00x0-xx0x-000x0000x0xx" Тогда //Центральный контрагент
				ДобавитьЭлементСправочникаКВыгрузке(ИсходноеЗнч, "ЮрФизЛица");
			ИначеЕсли ИсходноеЗнч = "00x0xx0x-xxx0-00x0-xx0x-000x0000x1xx" Тогда //Договор с центральным контрагентом
				ДобавитьЭлементСправочникаКВыгрузке(ИсходноеЗнч, "Договоры");
			ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) ИЛИ Справочники.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) Тогда
				ДобавитьЭлементСправочникаКВыгрузке(ИсходноеЗнч);
			ИначеЕсли Колонка.Имя = "OperTypeCode" Тогда
				ДобавитьИдентификаторКВыгрузке(Колонка.Имя, ИсходноеЗнч);
			ИначеЕсли Колонка.Имя = "AccDebit" ИЛИ Колонка.Имя = "AccCredit" Тогда
				ДобавитьИдентификаторКВыгрузке("СчетаУчета", ИсходноеЗнч);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Данные.Колонки.Найти("Log") = Неопределено Тогда
		Данные.Колонки.Добавить("Log");
		Данные.ЗаполнитьЗначения(0, "Log");
	КонецЕсли;
	
	МассивИмен = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокИменДанных);
	
	Для Каждого ИмяДанных Из МассивИмен Цикл 
		ПакетДанных.Вставить(ИмяДанных, Данные);
	КонецЦикла;
	
	Если ЭтотОбъект.ПоказыватьВремяФормированияПакетов Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СписокИменДанных + ": " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоФормированияПакета)/ 1000, "ЧДЦ=0; ЧГ=0") + " сек.");
		НачалоФормированияПакета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;
	
КонецПроцедуры

Процедура КонрольУникальностиExtCode(СписокИменДанных, Данные)
	
	Если Данные.Колонки.Найти("ExtCode") <> Неопределено Тогда
		
		КопияДанных = Данные.Скопировать();
		КопияДанных.Колонки.Добавить("ФлагУникальности");
		КопияДанных.ЗаполнитьЗначения(1, "ФлагУникальности");
		КопияДанных.Свернуть("ExtCode", "ФлагУникальности");
		
		Для Каждого СтрокаДанных Из КопияДанных Цикл
			Если СтрокаДанных.ФлагУникальности > 1 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нарушение контроля уникальности в данных '" + СписокИменДанных + "', ExtCode=" + СтрокаДанных.ExtCode);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольОбязательныхРеквизитов(Данные)
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.КонтрольОбязательныхРеквизитов = "#НомерВходящегоДокументаВНачисленииЗадолженности"
		   И НЕ ЗначениеЗаполнено(СтрокаДанных.DocumentNo) Тогда
			ЗарегистрироватьОшибку(СтрШаблон("В документе %1 не заполнен номер входящего документа", СтрокаДанных.Регистратор), МассивОшибок);		
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ДобавитьЭлементСправочникаКВыгрузке(Элемент, ИмяМД = "")
	
	Если Элемент = Неопределено Тогда Возврат; КонецЕсли;
	
	Если ПустаяСтрока(ИмяМД) Тогда
		ИмяМД = Элемент.Метаданные().Имя;
	КонецЕсли;
	
	Если НЕ СправочникиКВыгрузке.Свойство(ИмяМД) Тогда
		СправочникиКВыгрузке.Вставить(ИмяМД, Новый Массив);
	КонецЕсли;
	
	Если СправочникиКВыгрузке[ИмяМД].Найти(Элемент) = Неопределено Тогда
		СправочникиКВыгрузке[ИмяМД].Добавить(Элемент);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьШаблонИмениФайла()
	
	ШаблонИмениФайла = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(КлиентыДоверительногоУправленияСрезПоследних.Клиент.Ссылка КАК Справочник.ЮрФизЛица)) = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)";

	Запрос.УстановитьПараметр("Организация"					, Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОкончания"				, Период.ДатаОкончания);

	Попытка Пакет = Запрос.ВыполнитьПакет(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	ВыборкаОрганизации = Пакет[0].Выбрать();
	Если ВыборкаОрганизации.Следующий() Тогда
		ШаблонИмениФайла = ШаблонИмениФайла + ВыборкаОрганизации.КраткоеНаименованиеПоУставу + "_";
	КонецЕсли;
	
	ВыборкаСчетовДУ = Пакет[1].Выбрать();
	Если ВыборкаСчетовДУ.Следующий() Тогда
		ШаблонИмениФайла = ШаблонИмениФайла + ВыборкаСчетовДУ.КраткоеНаименованиеПоУставу + "_";
	КонецЕсли;
	
	ШаблонИмениФайла = ШаблонИмениФайла + "ТегДанных_";
	ШаблонИмениФайла = ШаблонИмениФайла + СчетДоверительногоУправления.НомерДоговора + "_";
	ШаблонИмениФайла = ШаблонИмениФайла + Формат(Период.ДатаНачала, "ДФ=dd-MM-yyyy") + "_";
	ШаблонИмениФайла = ШаблонИмениФайла + Формат(Период.ДатаОкончания, "ДФ=dd-MM-yyyy");
	
	ШаблонИмениФайла = СтрЗаменить(ШаблонИмениФайла, "/", "_");
	ШаблонИмениФайла = СтрЗаменить(ШаблонИмениФайла, """", "");
	ШаблонИмениФайла = СтрЗаменить(ШаблонИмениФайла, " ", "_");
		
КонецПроцедуры	

Процедура ЗарегистрироватьОшибку(ТекстОшибки, ВходящийМассивОшибок)
	
	Если ВходящийМассивОшибок.Найти(ТекстОшибки) = Неопределено Тогда
		ВходящийМассивОшибок.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ВходящийМассивОшибок)
	
	Для Каждого ТекстОшибки Из ВходящийМассивОшибок Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЦикла;
	
	ВходящийМассивОшибок.Очистить();
	
КонецПроцедуры

Функция ПредставлениеДополнительныхПараметровВыгрузки()
	
	ДополнительныеПараметры = РаботаСОтчетами.ИсключитьИзНастроекОбщиеНастройки(ЭтотОбъект.ДополнительныеПараметрыВыгрузки);

	Если ДополнительныеПараметры.Количество() = 0 Тогда
		Возврат	Неопределено;
	Иначе
		Возврат Новый Структура("ДополнительныеПараметрыВыгрузкиПредставление", РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(ДополнительныеПараметры));
	КонецЕсли;
	
КонецФункции

