		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, , "Posting_Date, Agreement_Date");
		НоваяСтрока.Posting_Date = Формат(ТекСтрока.Posting_Date, "ДФ=dd.MM.yyyy");
		
		Если ЗначениеЗаполнено(ТекСтрока.Agreement_Date) Тогда
			НоваяСтрока.Agreement_Date = Формат(ТекСтрока.Agreement_Date, "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьДанныеВПакет("ОстаткиБУНаДату", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьЭффективныеПроцентныеСтавкиИнфинитум()
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Если НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения Тогда
		СчитаемДоПогашения = Истина;
	Иначе
		СчитаемДоПогашения = Ложь;
	КонецЕсли;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Ext_UK_AgrCode");
	Данные.Колонки.Добавить("Ext_FI_Code");
	Данные.Колонки.Добавить("State_Registration_No");
	Данные.Колонки.Добавить("ISIN");
	Данные.Колонки.Добавить("Series");
	Данные.Колонки.Добавить("Trade_Date");
	Данные.Колонки.Добавить("Trade_Time");
	Данные.Колонки.Добавить("TF_Document_No");
	Данные.Колонки.Добавить("Payment_Day");
	Данные.Колонки.Добавить("Delivery_Day");
	Данные.Колонки.Добавить("Ext_Trade_Code");
	Данные.Колонки.Добавить("Date");
	Данные.Колонки.Добавить("Effective_Interest_Rate");
	Данные.Колонки.Добавить("Prof_judgment_From");
	Данные.Колонки.Добавить("Prof_judgment_To");
	Данные.Колонки.Добавить("Comment");
	Данные.Колонки.Добавить("Log");
	
	Запрос = Новый Запрос;
	Запрос.Текст ="
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	0 КАК НомерСтроки,
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Дата,
			|			СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|				И УчетныйАктивЕПС В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД))) КАК БухПартииЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата"						, ЭтотОбъект.Период.ДатаОкончания);
	
	Отказ = Ложь;
	
	НастройкиУчетаПартий = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа;
	
	Попытка ЦенныеБумаги = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	ВыборкаДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумаги, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания).Выбрать();
	
	ISINЦенныхБумаг = ПолучитьISIN(ЦенныеБумаги.ВыгрузитьКолонку("ЦеннаяБумага"), НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	
	Пока ВыборкаДатыИЦеныПокупки.Следующий() Цикл
		Если ВыборкаДатыИЦеныПокупки.ЦенаПокупки = 0 Тогда Продолжить; КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ВыборкаДатыИЦеныПокупки.ДатаПокупки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для облигации: " + ВыборкаДатыИЦеныПокупки.ЦеннаяБумага + ", партия: " + ВыборкаДатыИЦеныПокупки.Партия + " не указана дата покупки!");
			Продолжить;
		КонецЕсли;
		
		ДоходностьДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(ВыборкаДатыИЦеныПокупки.ЦеннаяБумага, 
		НастройкиУчета.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения, 
		ВыборкаДатыИЦеныПокупки.ДатаПокупки, 
		ВыборкаДатыИЦеныПокупки.ЦенаПокупки,
		ЭтотОбъект.СчетДоверительногоУправления,
		Биржа, 
		ЭтотОбъект.Период.ДатаОкончания);
		
		СтрокаДанных = Данные.Добавить();
		СтрокаДанных.Ext_UK_AgrCode			= ЭтотОбъект.СчетДоверительногоУправления;
		СтрокаДанных.Ext_FI_Code			= ВыборкаДатыИЦеныПокупки.ЦеннаяБумага;
		СтрокаДанных.State_Registration_No	= ВыборкаДатыИЦеныПокупки.ЦеннаяБумага.ГосударственныйРегистрационныйНомер;
		СтрокаДанных.ISIN					= ISINЦенныхБумаг.Получить(ВыборкаДатыИЦеныПокупки.ЦеннаяБумага);
		СтрокаДанных.Series					= ВыборкаДатыИЦеныПокупки.ЦеннаяБумага.НомерВыпуска;
		
		Если ТипЗнч(ВыборкаДатыИЦеныПокупки.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
			СтрокаДанных.Ext_Trade_Code = ВыборкаДатыИЦеныПокупки.Партия.Основание;
			Сделка = ВыборкаДатыИЦеныПокупки.Партия.Основание;
		Иначе
			СтрокаДанных.Ext_Trade_Code = ВыборкаДатыИЦеныПокупки.Партия;
			Сделка = ВыборкаДатыИЦеныПокупки.Партия;
		КонецЕсли;
		
		СтрокаДанных.Trade_Date		= Формат(ВыборкаДатыИЦеныПокупки.ДатаПокупки, "ДФ=dd.MM.yyyy");
		СтрокаДанных.Trade_Time		= Формат(ВыборкаДатыИЦеныПокупки.ДатаПокупки, "ДФ=HH:mm:ss");
		
		Если ТипЗнч(Сделка) = Тип("ДокументСсылка.Сделка")
		 ИЛИ ТипЗнч(Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
			СтрокаДанных.TF_Document_No	= Сделка.НомерСделки;
			
			Если Сделка.ОтложенноеИсполнение Тогда
				СтрокаДанных.Payment_Day	= Формат(Сделка.ДатаОплаты, "ДФ=dd.MM.yyyy");
				СтрокаДанных.Delivery_Day	= Формат(Сделка.ДатаПоставки, "ДФ=dd.MM.yyyy");
			Иначе
				СтрокаДанных.Payment_Day	= Формат(Сделка.Дата, "ДФ=dd.MM.yyyy");
				СтрокаДанных.Delivery_Day	= Формат(Сделка.Дата, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДанных.Date						= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		СтрокаДанных.Effective_Interest_Rate	= Окр(ДоходностьДюрация.Доходность, 9);
		
	КонецЦикла;
	
	СоздатьСоставнойИдентификатор(Данные, "Ext_FI_Code,Ext_Trade_Code,Date", "ExtCode");
	
	ДобавитьДанныеВПакет("ЭСПНаДату", Данные);
	
КонецПроцедуры

#Область ПроцедурыДляСхемы_NAPF_DIASOFT_УдалитьКогдаСНГПерестанетЗапрашивать

Процедура ВыгрузитьОстатки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОбороты.Организация КАК Организация,
		|	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОбороты.Партия КАК Партия,
		|	БухПартииЦенныхБумагОбороты.СтрокаПартии КАК СтрокаПартии,
		|	МАКСИМУМ(БухПартииЦенныхБумагОбороты.Период) КАК ДатаПереоценкиКупона
		|ПОМЕСТИТЬ ВТ_ПоследняяПереоценкаКупона
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(
		|			,
		|			&ДатаНачала,
		|			День,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОбороты
		|ГДЕ
		|	БухПартииЦенныхБумагОбороты.ПереоценкаКупонаОборот <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОбороты.Организация,
		|	БухПартииЦенныхБумагОбороты.ЦеннаяБумага,
		|	БухПартииЦенныхБумагОбороты.Партия,
		|	БухПартииЦенныхБумагОбороты.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ДепозитныйВклад КАК ДепозитныйВклад,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор КАК Партия,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.ВводКредитногоИнструмента
		|			ТОГДА ""ВводДепозитногоВклада""
		|		ИНАЧЕ ""РазмещениеДепозитногоВклада""
		|	КОНЕЦ КАК ТипОперации
		|ПОМЕСТИТЬ ВТ_ПартииДепозитов
		|ИЗ
		|	(ВЫБРАТЬ
		|		МИНИМУМ(ДенежныеСредстваВКредитныхИнструментахОбороты.Период) КАК Период,
		|		ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент КАК ДепозитныйВклад
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Обороты(
		|				,
		|				&ДатаНачала,
		|				Регистратор,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОбороты
		|	ГДЕ
		|		(ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента
		|				ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.ВводКредитногоИнструмента
		|				ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров)
		|		И ДенежныеСредстваВКредитныхИнструментахОбороты.СуммаОборот <> 0
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Обороты(
		|				,
		|				&ДатаНачала,
		|				Регистратор,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОбороты
		|		ПО ВложенныйЗапрос.Период = ДенежныеСредстваВКредитныхИнструментахОбороты.Период
		|			И ВложенныйЗапрос.ДепозитныйВклад = ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент
		|ГДЕ
		|	(ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента
		|			ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.ВводКредитногоИнструмента
		|			ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров)
		|	И ДенежныеСредстваВКредитныхИнструментахОбороты.СуммаОборот <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) КАК PostingDate,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК ExtUKAgrCode,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ExtFondCode,
		|	БухПартииЦенныхБумагОстатки.Организация КАК ExtUKСode,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ExtFICode,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Партия ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				И (БухПартииЦенныхБумагОстатки.Партия.Основание ССЫЛКА Документ.Сделка
		|					ИЛИ БухПартииЦенныхБумагОстатки.Партия.Основание ССЫЛКА Документ.СделкаРЕПО)
		|			ТОГДА БухПартииЦенныхБумагОстатки.Партия.Основание
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.Партия
		|	КОНЕЦ КАК ExtTradeCode,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК ExtFIBlockNo,
		|	ВТ_ПоследняяПереоценкаКупона.ДатаПереоценкиКупона КАК PeriodicOperationLastPostingDate,
		|	NULL КАК ExtBankCode,
		|	NULL КАК ExtCounteragentCode,
		|	NULL КАК ExtCounteragentAgreementCode,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Партия ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ""ВводЦенныхБумаг""
		|		КОГДА БухПартииЦенныхБумагОстатки.Партия ССЫЛКА Документ.Сделка
		|				ИЛИ БухПартииЦенныхБумагОстатки.Партия ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ""ПокупкаЦенныхБумаг""
		|	КОНЕЦ КАК OperTypeCode,
		|	NULL КАК AmountOperationsTypes,
		|	""58"" КАК FinAccount,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Quantity,
		|	БухПартииЦенныхБумагОстатки.Организация.ВалютаУчета.Код КАК CurrencyCode,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК AmountBU,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК AmountNU,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК AmountZ,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК AmountBU_LCY,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК AmountNU_LCY,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК AmountZ_LCY,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК RevaluationAmount,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК AcquisitionCost,
		|	БухПартииЦенныхБумагОстатки.Партия.Дата КАК AcquisitionDate,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК CommissionPaid
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаНачала,
