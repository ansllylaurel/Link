#Область Конвертация_проводок

Процедура КонвертироватьПроводки(Данные)
	
	Если Ложь Тогда
		Данные = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если ТипЗнч(АнлитическиеПризнакиБухгалтерскихСчетовКлиента) <> Тип("ТаблицаЗначений") Тогда
		
		АнлитическиеПризнакиБухгалтерскихСчетовКлиента = Новый ТаблицаЗначений;
		АнлитическиеПризнакиБухгалтерскихСчетовКлиента.Колонки.Добавить("НомерСчета");
		АнлитическиеПризнакиБухгалтерскихСчетовКлиента.Колонки.Добавить("ИсходящийСчет");
		АнлитическиеПризнакиБухгалтерскихСчетовКлиента.Колонки.Добавить("НомерСубконто");
		АнлитическиеПризнакиБухгалтерскихСчетовКлиента.Колонки.Добавить("СоответствиеАналитики");
		
		Макет = ПолучитьМакет(ДополнительныеПараметрыВыгрузки.ПланСчетовДляНАПФ);
		
		Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
			НоваяСтрока = АнлитическиеПризнакиБухгалтерскихСчетовКлиента.Добавить();
			НоваяСтрока.НомерСчета				= Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
			НоваяСтрока.ИсходящийСчет			= Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
			НоваяСтрока.НомерСубконто			= Число(Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
			НоваяСтрока.СоответствиеАналитики	= Макет.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
		КонецЦикла;
	КонецЕсли;	
	
	Для НомерСубконто = 1 По 5 Цикл
		Данные.Колонки.Найти("SubcDebit" + НомерСубконто).Имя = "СубконтоДт" + НомерСубконто;	
		Данные.Колонки.Добавить("SubcDebit" + НомерСубконто);
		
		Данные.Колонки.Найти("SubcCredit" + НомерСубконто).Имя = "СубконтоКт" + НомерСубконто;	
		Данные.Колонки.Добавить("SubcCredit" + НомерСубконто);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Для НомерСубконто = 1 По 5 Цикл
			СтрокаДанных["SubcDebit"	+ НомерСубконто] = ПолучитьАналитику(СтрокаДанных, "Дт", СтрокаДанных.AccDebit, НомерСубконто);
			СтрокаДанных["SubcCredit"	+ НомерСубконто] = ПолучитьАналитику(СтрокаДанных, "Кт", СтрокаДанных.AccCredit, НомерСубконто);
		КонецЦикла;
		
		СтрокаДанных.AccDebit	= ПолучитьСоответствиеСчета(СтрокаДанных.AccDebit);
		СтрокаДанных.AccCredit	= ПолучитьСоответствиеСчета(СтрокаДанных.AccCredit);
	КонецЦикла;
	
	Для НомерСубконто = 1 По 5 Цикл
		Данные.Колонки.Удалить("СубконтоДт" + НомерСубконто);	
		Данные.Колонки.Удалить("СубконтоКт" + НомерСубконто);	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСоответствиеСчета(НомерСчета)
	
	ПараметрыПоиска = Новый Структура("НомерСчета", НомерСчета);
	НайденныеСтроки = АнлитическиеПризнакиБухгалтерскихСчетовКлиента.НайтиСтроки(ПараметрыПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(НайденныеСтроки[0].ИсходящийСчет) Тогда
			Возврат НайденныеСтроки[0].ИсходящийСчет;
		Иначе
			Возврат НомерСчета;
		КонецЕсли;
	Иначе
		Возврат НомерСчета;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьАналитику(СтрокаДанных, Направление, НомерСчета, НомерСубконто)
	
	ДатаОперации	= СтрокаДанных.TransDate;
	Субконто1		= СтрокаДанных["Субконто" + Направление + 1];
	Субконто2		= СтрокаДанных["Субконто" + Направление + 2];
	Субконто3		= СтрокаДанных["Субконто" + Направление + 3];
	Субконто4		= СтрокаДанных["Субконто" + Направление + 4];
	Субконто5		= СтрокаДанных["Субконто" + Направление + 5];
	Регистратор		= СтрокаДанных.Регистратор;
	
	Выражение = ПолучитьСоответствиеАналитики(НомерСчета, НомерСубконто);
	
	Если ПустаяСтрока(Выражение) Тогда
		Возврат СтрокаДанных["Субконто" + Направление + НомерСубконто];
		//ЗарегистрироватьОшибку("Не задано выражение для получения аналитики по счету! Обратитесь к разработчикам. Счет: " + НомерСчета + ", Субконто" + НомерСубконто, МассивОшибок);
		//Возврат "";
	ИначеЕсли Выражение = "Неприменимо" ИЛИ Выражение = "ВРАЗРАБОТКЕ" Тогда
		Возврат "";
	Иначе
		НомерСчетаПриВычисленииСубкнонто = НомерСчета;
		Возврат Вычислить(Выражение);
	КонецЕсли;

КонецФункции

Функция ПолучитьСоответствиеАналитики(НомерСчета, НомерСубконто)
	
	//ищем счет
	ПараметрыПоиска = Новый Структура("НомерСчета, НомерСубконто", НомерСчета, НомерСубконто);
	НайденныеСтроки = АнлитическиеПризнакиБухгалтерскихСчетовКлиента.НайтиСтроки(ПараметрыПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].СоответствиеАналитики;
	ИначеЕсли АнлитическиеПризнакиБухгалтерскихСчетовКлиента.НайтиСтроки(Новый Структура("НомерСчета", НомерСчета)).Количество() > 0 Тогда
		Возврат "Неприменимо"
	КонецЕсли;
	
	//ищем группу счетов
	ПараметрыПоиска = Новый Структура("НомерСчета, НомерСубконто", Лев(НомерСчета, 3), НомерСубконто);
	НайденныеСтроки = АнлитическиеПризнакиБухгалтерскихСчетовКлиента.НайтиСтроки(ПараметрыПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].СоответствиеАналитики;
	ИначеЕсли АнлитическиеПризнакиБухгалтерскихСчетовКлиента.НайтиСтроки(Новый Структура("НомерСчета", Лев(НомерСчета, 3))).Количество() > 0 Тогда
		Возврат "Неприменимо"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции	

Функция ПолучитьБанковскийСчетИзУсловийЗаймов(УсловиеЗаймов)
	
	Если ТипЗнч(УсловиеЗаймов) = Тип("ДокументСсылка.МНО") Тогда
		Возврат УсловиеЗаймов.РасчетныйСчет;
	ИначеЕсли ТипЗнч(УсловиеЗаймов) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		Возврат УсловиеЗаймов.БанковскийСчет;
	Иначе
