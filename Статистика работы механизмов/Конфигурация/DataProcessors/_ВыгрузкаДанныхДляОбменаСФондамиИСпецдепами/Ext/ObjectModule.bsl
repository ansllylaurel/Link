Процедура УстановитьДополнительныеПараметрыВыгрузки(ОтчетНАПФ)
	
	Если ДополнительныеПараметрыВыгрузки.Свойство("АвтоматическоеФормирование") Тогда
		//Настройки считались при в обработке "Формирование отчётности"
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ПринудительноВыгрузитьНачальныеОстатки Тогда
		ПериодНастроек = ТекущаяДата();
	Иначе
		ПериодНастроек = ЭтотОбъект.Период.ДатаОкончания;
	КонецЕсли;
	
	НастройкиОтчета = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьНастройкиОтчета(ПериодНастроек, ЭтотОбъект.СчетДоверительногоУправления, ОтчетНАПФ);

	Для Каждого ЗначениеНастройки Из НастройкиОтчета Цикл
		Если ТипЗнч(ЗначениеНастройки.Значение) = Тип("СправочникСсылка.ЗначенияНастроекОтчетов") Тогда
			ДополнительныеПараметрыВыгрузки.Вставить(ЗначениеНастройки.Ключ, ЗначениеНастройки.Значение.Ключ);
		Иначе
			ДополнительныеПараметрыВыгрузки.Вставить(ЗначениеНастройки.Ключ, ЗначениеНастройки.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ВключатьДанныеВСоставВыгрузки(ИмяДанных)
	
	МассивНастроекОтклченныхПоУмолчанию = Новый Массив;
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ВыгружатьВидыОперацийБухПроводок");
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ВыгружатьБСВСоставеФИКакНСО");
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ВыгружатьВсеРегистраторыБухгалтерскогоУчета");
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ВыгружатьКотировкиНаКаждыйДень");
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ВыгружатьНачисленияЗадолженностиПоСделкам");
	МассивНастроекОтклченныхПоУмолчанию.Добавить("ДополнитьПереводСчетаБрокераНаРасчетныйНомеромОпер");
	
	Включить = (МассивНастроекОтклченныхПоУмолчанию.Найти(ИмяДанных) = Неопределено);
	
	Если ДополнительныеПараметрыВыгрузки.Свойство(ИмяДанных) Тогда
		Включить = ДополнительныеПараметрыВыгрузки[ИмяДанных] = Истина;
	КонецЕсли;
	
	Возврат Включить;
	
КонецФункции

Функция МассивКлиентскихОтчетовНАПФ()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отчеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|ГДЕ
		|	Отчеты.Ключ = &Ключ
		|	И НЕ Отчеты.ПометкаУдаления");
	
	Запрос.УстановитьПараметр("Ключ", ОбщегоНазначения.ПолучитьИменованныйОбъект("ВнешОбр_ОбменВФорматеНАПФ"));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция НастроенныйОтчетНАПФ()
	
	КлиентскиеОтчеты = МассивКлиентскихОтчетовНАПФ();
	МассивФормировать = Новый Массив;	
	Для Каждого ТекОтчетНАПФ Из КлиентскиеОтчеты Цикл
		Формировать = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройки(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.СчетДоверительногоУправления, ТекОтчетНАПФ, "Формировать", ЭтотОбъект.Периодичность);
		Если Формировать = Истина Тогда
			МассивФормировать.Добавить(ТекОтчетНАПФ);		
		КонецЕсли;
	КонецЦикла;
		
	Если МассивФормировать.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счета ДУ """ + ЭтотОбъект.СчетДоверительногоУправления + """ в настройках нет действующей выгрузки НАПФ");
		Возврат Неопределено;
	ИначеЕсли МассивФормировать.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счета ДУ """ + ЭтотОбъект.СчетДоверительногоУправления + """ настроено формирование выгрузки НАПФ из обеих групп 'Бухгалтерия УК' и 'Бэк-офис УК'. Необходимо настроить формирование только одного отчета");
		Возврат Неопределено;
	КонецЕсли;

	Возврат МассивФормировать[0];
	
КонецФункции

Функция КлассифицироватьУчетныйАктив(УчетныйАктив, ВидКлассификатора)
	
	Если НЕ ЗначениеЗаполнено(УчетныйАктив) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(КлассификаторыУчетныхАктивов) <> Тип("ТаблицаЗначений") Тогда
		КлассификаторыУчетныхАктивов = ЗаполнитьКлассификаторыУчетныхАктивов();
	КонецЕсли;
	
	НайденнаяСтрока = КлассификаторыУчетныхАктивов.Найти(УчетныйАктив, "УчетныйАктив");
	Если НайденнаяСтрока = Неопределено Тогда
		ВызватьИсключение "Не задан классификатор " + ВидКлассификатора + " для учётного актива " + УчетныйАктив;
	Иначе
		Возврат НайденнаяСтрока[ВидКлассификатора];
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьКлассификаторыУчетныхАктивов()
	
	ДанныеМакета = Новый ТаблицаЗначений;
	ДанныеМакета.Колонки.Добавить("УчетныйАктив"	, Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ДанныеМакета.Колонки.Добавить("CategoryFIIAS39" , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ДанныеМакета.Колонки.Добавить("SubCategoryIAS39", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ДанныеМакета.Колонки.Добавить("CategoryFIIFRS9" , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ДанныеМакета.Колонки.Добавить("SubCategoryIFRS9", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	
	Макет = ПолучитьМакет("КлассификаторыУчетныхАктивов");
	
	Для НомерСтроки = 3 По Макет.ВысотаТаблицы Цикл
		НоваяСтрока = ДанныеМакета.Добавить();
		НоваяСтрока.УчетныйАктив		= Справочники.УчетныеАктивыЕПС[СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст)];
		НоваяСтрока.CategoryFIIAS39		= СокрЛП(Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		НоваяСтрока.SubCategoryIAS39	= СокрЛП(Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);
		НоваяСтрока.CategoryFIIFRS9		= СокрЛП(Макет.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);
		НоваяСтрока.SubCategoryIFRS9	= СокрЛП(Макет.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеМакета.УчетныйАктив КАК УчетныйАктив,
		|	ДанныеМакета.CategoryFIIAS39 КАК CategoryFIIAS39,
		|	ДанныеМакета.SubCategoryIAS39 КАК SubCategoryIAS39,
		|	ДанныеМакета.CategoryFIIFRS9 КАК CategoryFIIFRS9,
		|	ДанныеМакета.SubCategoryIFRS9 КАК SubCategoryIFRS9
		|ПОМЕСТИТЬ _ДанныеМакета
		|ИЗ
		|	&ДанныеМакета КАК ДанныеМакета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.Ссылка КАК УчетныйАктив,
		|	_ДанныеМакета.CategoryFIIAS39 КАК CategoryFIIAS39,
		|	_ДанныеМакета.SubCategoryIAS39 КАК SubCategoryIAS39,
		|	_ДанныеМакета.CategoryFIIFRS9 КАК CategoryFIIFRS9,
		|	_ДанныеМакета.SubCategoryIFRS9 КАК SubCategoryIFRS9
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеМакета КАК _ДанныеМакетаЭлементы
		|		ПО (УчетныеАктивыЕПС.Ссылка = _ДанныеМакетаЭлементы.УчетныйАктив)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеМакета КАК _ДанныеМакета
		|		ПО (ЕСТЬNULL(_ДанныеМакетаЭлементы.УчетныйАктив, УчетныеАктивыЕПС.Родитель) = _ДанныеМакета.УчетныйАктив)
		|ГДЕ
		|	_ДанныеМакета.УчетныйАктив ЕСТЬ НЕ NULL ";
	
	Запрос.УстановитьПараметр("ДанныеМакета", ДанныеМакета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьВПакетДанныеСправочникаИзМакета(ИмяМакета, ИмяДанных)
	
	Данные = Новый ТаблицаЗначений;
	
	Макет = ПолучитьМакет(ИмяМакета);

	Реквизиты = Новый Структура;
	Для Кол = 1 По Макет.ШиринаТаблицы Цикл
		ИмяКолонки = СокрЛП(Макет.Область(1, Кол, 1, Кол).Текст);
		Данные.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;	
	
	Для Стр = 2 По Макет.ВысотаТаблицы Цикл	
		СтрокаДанных = Данные.Добавить();
		Для Кол = 1 По Макет.ШиринаТаблицы Цикл
			СтрокаДанных[Кол-1] = Макет.Область(Стр, Кол, Стр, Кол).Текст;
		КонецЦикла;
	КонецЦикла;
	
	ДобавитьДанныеВПакет(ИмяДанных, Данные);
	
КонецПроцедуры

Функция ЭтоКэшируемыйТип(ТипЗначения)
	
	Если ТипЗначения = Тип("ДокументСсылка.МНО") Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") 
		Или ТипЗначения = Тип("Число") 
		Или ТипЗначения = Тип("Дата")
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) // кэшируется средствами платформы
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) // вероятность повторного использовния пренебрежимо мала
	Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СериализоватьЗначение(ИсходноеЗнч, ТипПриемника = "")
	
	Если ТипЗнч(КэшЗнчУзла) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Ошибка выполнения функции СериализоватьЗначениеУзла(). Переданный кэш объектов не является соответствием.";
	КонецЕсли;
	
	ТипИсходногоЗнч = ТипЗнч(ИсходноеЗнч);
	
	Если ЗначениеЗаполнено(ИсходноеЗнч) И ЭтоКэшируемыйТип(ТипИсходногоЗнч) Тогда
		ЗнчУзла = КэшЗнчУзла.Получить(ИсходноеЗнч);
		
		Если ЗнчУзла <> Неопределено И ЗнчУзла <> Null Тогда
			Возврат ЗнчУзла;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИсходноеЗнч) Тогда
		Если ТипПриемника = ТипыЗначенийXML.date Тогда
			ЗнчУзла = "0001-01-01";
		ИначеЕсли ТипПриемника = ТипыЗначенийXML.dateTime Тогда
			ЗнчУзла = "0001-01-01T00:00:00.000";	
		ИначеЕсли ТипПриемника = ТипыЗначенийXML.time Тогда
			ЗнчУзла = "00:00:00";	
		ИначеЕсли ТипПриемника = ТипыЗначенийXML.integer Тогда
			ЗнчУзла = "0";	
		Иначе
			ЗнчУзла = "";	
		КонецЕсли;
	ИначеЕсли ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.ГруппыФинансовогоУчетаДоходовРасходов") Тогда
		ЗнчУзла = СокрЛП(ИсходноеЗнч.Код);
	ИначеЕсли ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры")
		И (ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания
			ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоДепозита
			ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)
	Тогда
		ЗнчУзла = "ba-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания")
			ИЛИ (ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры") И ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания) 
	Тогда
		ЗнчУзла = "br-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли (ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры") 
				И (ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ОтветственногоХранения
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ВеденияРеестра
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания)) 
	Тогда
		ЗнчУзла = "de-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) ИЛИ Справочники.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) Тогда
		ЗнчУзла = Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли ЗнчУзла = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания Тогда
		ЗнчУзла = "Договор брокерского обслуживания";
	ИначеЕсли ЗнчУзла = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания Тогда
		ЗнчУзла = "Договор депозитарного обслуживания";
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) Тогда
		ЗнчУзла = XMLСтрока(ИсходноеЗнч);
	ИначеЕсли ТипИсходногоЗнч = Тип("Дата") Тогда
		Если ТипПриемника = ТипыЗначенийXML.date Тогда
			ЗнчУзла = Формат(ИсходноеЗнч, "ДФ=yyyy-MM-dd; ДП=0001-01-01");
		ИначеЕсли ТипПриемника = ТипыЗначенийXML.time Тогда
			ЗнчУзла = Формат(ИсходноеЗнч, "ДФ=ЧЧ:мм:сс; ДП=00:00:00");
		Иначе
			ЗнчУзла = XMLСтрока(ИсходноеЗнч);	
		КонецЕсли;
	ИначеЕсли ТипИсходногоЗнч = Тип("Число") Тогда
		ЗнчУзла = Формат(ИсходноеЗнч, "ЧРД=.; ЧРГ=; ЧН=0; ЧГ=");
		
	ИначеЕсли ТипИсходногоЗнч = Тип("Булево") Тогда
		ЗнчУзла = ?(ИсходноеЗнч, "1", "0");
		
	Иначе
		ЗнчУзла = Строка(ИсходноеЗнч);
		
	КонецЕсли;
	
	// закэшируем
	Если ЗначениеЗаполнено(ИсходноеЗнч) И ЭтоКэшируемыйТип(ТипИсходногоЗнч) Тогда
		КэшЗнчУзла.Вставить(ИсходноеЗнч, ЗнчУзла);
	КонецЕсли;
	
	Возврат ЗнчУзла;
	
КонецФункции // СериализоватьЗначениеУзла

Функция СериализоватьЗначениеУзла(ИсходноеЗнч, ТипПриемника = "")
	
	Если ТипЗнч(КэшЗнчУзла) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Ошибка выполнения функции СериализоватьЗначениеУзла(). Переданный кэш объектов не является соответствием.";
	КонецЕсли;
	
	ТипИсходногоЗнч = ТипЗнч(ИсходноеЗнч);
	
	Если ТипИсходногоЗнч = Тип("Неопределено") Тогда
		ЗнчУзла = "";	
	ИначеЕсли ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры")
		И (ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания
			ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоДепозита
			ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)
	Тогда
		ЗнчУзла = "ba-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания")
			ИЛИ (ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры") И ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания) 
	Тогда
		ЗнчУзла = "br-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли (ТипЗнч(ИсходноеЗнч) = Тип("СправочникСсылка.Договоры") 
				И (ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ОтветственногоХранения
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.ВеденияРеестра
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания
					ИЛИ ИсходноеЗнч.ВидДоговора = Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания)) 
	Тогда
		ЗнчУзла = "de-" + Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли ТипИсходногоЗнч = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
		ДобавитьЭлементСправочникаКВыгрузке(ИсходноеЗнч);
		ЗнчУзла = Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) ИЛИ Справочники.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) Тогда
		ЗнчУзла = Строка(ИсходноеЗнч.УникальныйИдентификатор());
	ИначеЕсли ЗнчУзла = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания Тогда
		ЗнчУзла = "Договор брокерского обслуживания";
	ИначеЕсли ЗнчУзла = Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания Тогда
		ЗнчУзла = "Договор депозитарного обслуживания";
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипИсходногоЗнч) Тогда
		ЗнчУзла = XMLСтрока(ИсходноеЗнч);
	ИначеЕсли ТипИсходногоЗнч = Тип("Дата") Тогда
		Если ТипПриемника = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "date") Тогда
			ЗнчУзла = Формат(ИсходноеЗнч, "ДФ=yyyy-MM-dd; ДП=0001-01-01");
		Иначе
			ЗнчУзла = XMLСтрока(ИсходноеЗнч);	
		КонецЕсли;
	ИначеЕсли ТипИсходногоЗнч = Тип("Число") Тогда
		ЗнчУзла = Формат(ИсходноеЗнч, "ЧРД=.; ЧРГ=; ЧН=0; ЧГ=");
		
	ИначеЕсли ТипИсходногоЗнч = Тип("Булево") Тогда
		ЗнчУзла = ?(ИсходноеЗнч, "1", "0");
		
	Иначе
		ЗнчУзла = Строка(ИсходноеЗнч);
		
	КонецЕсли;
	
	Возврат ЗнчУзла;
	
КонецФункции // СериализоватьЗначениеУзла

Процедура ДобавитьИдентификаторКВыгрузке(ИмяИдентификатора, Идентификатор)
	
	Если НЕ СправочникиКВыгрузке.Свойство(ИмяИдентификатора) Тогда
		СправочникиКВыгрузке.Вставить(ИмяИдентификатора, Новый Массив);
	КонецЕсли;

	Если СправочникиКВыгрузке[ИмяИдентификатора].Найти(Идентификатор) = Неопределено Тогда
		СправочникиКВыгрузке[ИмяИдентификатора].Добавить(Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивЭлементов(ИмяМассива)
	
	Если СправочникиКВыгрузке.Свойство(ИмяМассива) Тогда
		Возврат СправочникиКВыгрузке[ИмяМассива];
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
КонецФункции	

Процедура СоздатьСоставнойИдентификатор(Данные, ИсходныеРеквизиты, ИмяИдентификатора, УдалятьИсходныеРеквизиты = Ложь)
	
	ИсходныеРеквизиты = Новый Структура(ИсходныеРеквизиты);
	
	Если Данные.Колонки.Найти(ИмяИдентификатора) = Неопределено Тогда
		Данные.Колонки.Добавить(ИмяИдентификатора);
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Идентификатор = "";
		Для Каждого Реквизит Из ИсходныеРеквизиты Цикл
			Идентификатор = Идентификатор + СериализоватьЗначениеУзла(СтрокаДанных[Реквизит.Ключ]);
		КонецЦикла;
		СтрокаДанных[ИмяИдентификатора] = Лев(СокрЛП(Идентификатор), 200);
	КонецЦикла;
	
	Если УдалятьИсходныеРеквизиты Тогда
		Для Каждого Реквизит Из ИсходныеРеквизиты Цикл
			Если Реквизит.Ключ <> ИмяИдентификатора Тогда
				Данные.Колонки.Удалить(Реквизит.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

