	Если ЗначениеЗаполнено(ДополнительныеПараметрыВыгрузки.ПланСчетовДляНАПФ) Тогда
		КонвертироватьПроводки(Данные);
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Для НомерСубконто = 1 По 5 Цикл
			СтрокаДанных["SubcDebit" + НомерСубконто]	= ФильтрВыгружаемыеДанные(СтрокаДанных["SubcDebit" + НомерСубконто]);
			СтрокаДанных["SubcCredit" + НомерСубконто]	= ФильтрВыгружаемыеДанные(СтрокаДанных["SubcCredit" + НомерСубконто]);
		КонецЦикла;
	КонецЦикла;	
	
	МассивРегистраторовПоБухУчету = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РегистраторыПоБухУчету").ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	СоздатьСоставнойИдентификатор(Данные, "НомерСтрокиДвижения,Регистратор", "ExtCode", Истина);
	
	ДобавитьДанныеВПакет("БухгалтПроводки,БухПроводка", Данные);

КонецПроцедуры

Процедура ВыгрузитьВидыКотировок()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьРейтинги") Тогда
		Возврат;
	КонецЕсли;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ExtCode");
	Данные.Колонки.Добавить("Name");
	Данные.Колонки.Добавить("Log");
	
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.КотировкиТорговыхПлощадокСводные.Ресурсы Цикл
		Если Ресурс.Имя = "Валюта" Тогда Продолжить; КонецЕсли;
		Если Прав(ВРЕГ(Ресурс.Имя), 5) = "_DATE" Тогда Продолжить; КонецЕсли;
		
		СтрокаДанных = Данные.Добавить();
		СтрокаДанных.ExtCode = Ресурс.Имя;
		СтрокаДанных.Name = ?(ЗначениеЗаполнено(Ресурс.Синоним), Ресурс.Синоним, Ресурс.Имя);

	КонецЦикла;	
	
	ДобавитьДанныеВПакет("ВидыКотировок,ВидКотировки", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьВидыФинансовыхИнструментов()
	
	ДобавитьВПакетДанныеСправочникаИзМакета("ВидыФинансовыхИнструментов", "ВидыФИ,ВидФИ");
	
КонецПроцедуры

Процедура ВыгрузитьГрафикиДенежногоПотока()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьГрафикиДенежногоПотока") Тогда
		Возврат;
	КонецЕсли;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ExtCode");
	Данные.Колонки.Добавить("FICode");
	Данные.Колонки.Добавить("RateType");
	Данные.Колонки.Добавить("Rate");
	Данные.Колонки.Добавить("StartDate");
	Данные.Колонки.Добавить("ExpireDate");
	Данные.Колонки.Добавить("PaymentType");
	Данные.Колонки.Добавить("Amount");
	
	Запрос = Новый Запрос;
	
	//очень странно, почему на 08.02.2021 был не срез условий, а все записи. Если записей несколько, то будет косяк.
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВкладыПлановыеВыплаты.Ссылка КАК Вклад,
		|	ДепозитныеВкладыПлановыеВыплаты.Период КАК ДатаНачала,
		|	ВЫБОР
		|		КОГДА ДепозитныеВкладыПлановыеВыплаты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыВыплатПоДепозитнымВкладам.Проценты)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ТипВыплаты,
		|	0 КАК ТипСтавки,
		|	УсловияКредитныхИнструментов.Процент КАК Ставка,
		|	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаОкончания,
		|	СУММА(ДепозитныеВкладыПлановыеВыплаты.Сумма) КАК СуммаВыплаты
		|ИЗ
		|	Справочник.ДепозитныеВклады.ПлановыеВыплаты КАК ДепозитныеВкладыПлановыеВыплаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(, ) КАК УсловияКредитныхИнструментов
		|		ПО ДепозитныеВкладыПлановыеВыплаты.Ссылка = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И ДепозитныеВкладыПлановыеВыплаты.Период = УсловияКредитныхИнструментов.ДатаПогашения
		|			И (УсловияКредитныхИнструментов.Действует)
		|ГДЕ
		|	ДепозитныеВкладыПлановыеВыплаты.Ссылка В(&МассивДепозитныеВклады)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДепозитныеВкладыПлановыеВыплаты.Ссылка,
		|	ДепозитныеВкладыПлановыеВыплаты.Период,
		|	УсловияКредитныхИнструментов.Процент,
		|	УсловияКредитныхИнструментов.ДатаПогашения,
		|	ВЫБОР
		|		КОГДА ДепозитныеВкладыПлановыеВыплаты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыВыплатПоДепозитнымВкладам.Проценты)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("МассивДепозитныеВклады", ПолучитьМассивЭлементов("ДепозитныеВклады"));
	
	Выборка = Неопределено;
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("Нет доступа:" + Символы.ПС + Запрос.Текст);
	КонецПопытки;
	
	Если Выборка <> Неопределено Тогда
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Данные.Добавить();
			
			GUIDВклада = Строка(Выборка.Вклад.УникальныйИдентификатор());
			
			НоваяСтрока.ExtCode 	= GUIDВклада + Формат(Выборка.ДатаНачала, "ДФ=ddMMyyyy") + Строка(Выборка.ТипВыплаты);
			НоваяСтрока.FICode		= GUIDВклада;
			НоваяСтрока.RateType	= Выборка.ТипСтавки;
			НоваяСтрока.Rate		= Выборка.Ставка;
			НоваяСтрока.StartDate	= Выборка.ДатаНачала;
			НоваяСтрока.ExpireDate	= Выборка.ДатаОкончания;
			НоваяСтрока.PaymentType	= Выборка.ТипВыплаты;
			НоваяСтрока.Amount		= Выборка.СуммаВыплаты;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДобавитьДанныеВПакет("ГрафикиДенежногоПотока", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьДоговорыДоверительногоУправления()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	СчетаДоверительногоУправления.Ссылка КАК ExtCode,
		|	СчетаДоверительногоУправления.Наименование КАК Name,
		|	СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК UKCode,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ExtFundCode,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК FundName,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|			ТОГДА ""ПР""
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА ""ПН""
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов)
		|			ТОГДА ""СС""
		|	КОНЕЦ КАК FundsKind,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	(СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов))
		|	И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("Период"						, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);

	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.Name = СтрокаДанных.Name + " №" + СтрокаДанных.НомерДоговора + " от " + Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy"); 
	КонецЦикла;
	
	ОбезличитьДанные(Данные, "Name,ExtFundCode,FundName,FundsKind", "НомерДоговора");
	
	ДобавитьДанныеВПакет("ДоговорыДУ,ДоговорДУ", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьДоговораКонтрагентов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Документ,
		|	МАКСИМУМ(ДепозитныеВклады.НомерПодтверждения) КАК НомерПодтверждения
		|ПОМЕСТИТЬ _ДепозитарныеВкладыПоДокументам
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО (ДепозитныеВклады.НомерПодтверждения <> """")
		|			И Договоры.Ссылка = ДепозитныеВклады.БанковскийСчет.Договор
		|ГДЕ
		|	Договоры.Ссылка В(&МассивДоговоры)
		|	И Договоры.Организация = &ТекущаяОрганизация
		|
		|СГРУППИРОВАТЬ ПО
		|	Договоры.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДоговорыБрокерскогоОбслуживания.Ссылка,
		|	МАКСИМУМ(ДепозитныеВклады.НомерПодтверждения)
		|ИЗ
		|	Справочник.ДоговорыБрокерскогоОбслуживания КАК ДоговорыБрокерскогоОбслуживания
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО (ДепозитныеВклады.НомерПодтверждения <> """")
		|			И ДоговорыБрокерскогоОбслуживания.Ссылка = ДепозитныеВклады.БанковскийСчет.Договор
		|ГДЕ
		|	ДоговорыБрокерскогоОбслуживания.Ссылка В(&МассивДоговорыБрокерскогоОбслуживания)
		|	И ДоговорыБрокерскогоОбслуживания.Организация = &ТекущаяОрганизация
		|	И НЕ ДоговорыБрокерскогоОбслуживания.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ДоговорыБрокерскогоОбслуживания.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыБанковскогоОбслуживания.Ссылка КАК ExtCode,
		|	ДоговорыБанковскогоОбслуживания.Контрагент КАК ContractorCode,
		|	&СчетДоверительногоУправления КАК TrustAgrCode,
		|	ЛОЖЬ КАК TransType,
		|	0 КАК AgrSupplType,
		|	""Договор банковского обслуживания"" КАК Description,
		|	ЕСТЬNULL(ДепозитарныеВкладыПоДокументам.НомерПодтверждения, ДоговорыБанковскогоОбслуживания.НомерДоговора) КАК AgreementNo,
		|	ДоговорыБанковскогоОбслуживания.ДатаЗаключения КАК AgreementDate,
		|	ДоговорыБанковскогоОбслуживания.ДатаЗаключения КАК StartDate,
		|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ExpireDate,
		|	NULL КАК ExtAgrementGroup,
		|	643 КАК AgrCurrencyCode,
		|	NULL КАК PayTermsCode,
		|	NULL КАК PrePayTermsCode,
		|	643 КАК PayCurrencyCode
		|ИЗ
		|	Справочник.Договоры КАК ДоговорыБанковскогоОбслуживания
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &ТекущаяОрганизация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ДоговорыБанковскогоОбслуживания.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеВкладыПоДокументам КАК ДепозитарныеВкладыПоДокументам
		|		ПО ДоговорыБанковскогоОбслуживания.Ссылка = ДепозитарныеВкладыПоДокументам.Документ
		|ГДЕ
		|	ДоговорыБанковскогоОбслуживания.Ссылка В(&МассивДоговоры)
		|	И ДоговорыБанковскогоОбслуживания.ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БанковскогоОбслуживания), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БанковскогоДепозита), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДоговорыБрокерскогоОбслуживания.Ссылка,
		|	ДоговорыБрокерскогоОбслуживания.Контрагент,
		|	&СчетДоверительногоУправления,
		|	ЛОЖЬ,
		|	0,
		|	""Договор брокерского обслуживания"",
		|	ЕСТЬNULL(ДепозитарныеВкладыПоДокументам.НомерПодтверждения, ДоговорыБрокерскогоОбслуживания.НомерДоговора),
		|	ДоговорыБрокерскогоОбслуживания.ДатаЗаключения,
		|	ДоговорыБрокерскогоОбслуживания.ДатаЗаключения,
		|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения,
		|	NULL,
		|	643,
		|	NULL,
		|	NULL,
		|	643
		|ИЗ
		|	Справочник.ДоговорыБрокерскогоОбслуживания КАК ДоговорыБрокерскогоОбслуживания
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &ТекущаяОрганизация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ДоговорыБрокерскогоОбслуживания.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеВкладыПоДокументам КАК ДепозитарныеВкладыПоДокументам
		|		ПО ДоговорыБрокерскогоОбслуживания.Ссылка = ДепозитарныеВкладыПоДокументам.Документ
		|ГДЕ
		|	ДоговорыБрокерскогоОбслуживания.Ссылка В(&МассивДоговорыБрокерскогоОбслуживания)
