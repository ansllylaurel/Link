		СтрокаДанных.Name = Строка(Выборка.OperTypeCode) + " " + Нрег(Строка(Выборка.OperSubTypeCode)) + " " + Нрег(Строка(Выборка.OperSubTypeCode2)); 
		
	КонецЦикла;
	
	ФиксированныеТипыОпераций = Новый Структура;
