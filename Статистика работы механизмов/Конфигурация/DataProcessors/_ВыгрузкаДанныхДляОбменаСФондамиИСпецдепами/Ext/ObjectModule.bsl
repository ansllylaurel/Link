Процедура ВыгрузитьЗначенияПрогнозовРейтингов()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьРейтинги") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьДанныеВПакет("ЗначенияПрогнозовРейтингов", Новый ТаблицаЗначений);
	
КонецПроцедуры

Процедура ВыгрузитьЗначенияРейтингов()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьРейтинги") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	Рейтинги.РейтинговоеАгентство КАК RACode,
		|	Рейтинги.Шкала КАК ScaleCode,
		|	Рейтинги.Рейтинг КАК RatingValue,
		|	NULL КАК UnifRating
		|ИЗ
		|	РегистрСведений.Рейтинги КАК Рейтинги
		|ГДЕ
		|	Рейтинги.Субъект В(&МассивСубъектов)
		|
		|СГРУППИРОВАТЬ ПО
		|	Рейтинги.РейтинговоеАгентство,
		|	Рейтинги.Шкала,
		|	Рейтинги.Рейтинг";	
		
	МассивСубъектов = Новый Массив;
		
	Для Каждого ТипСубъектаРейтингов Из Метаданные.ОпределяемыеТипы.СубъектыРейтингов.Тип.Типы() Цикл
		МетаданныеСубъектаРейтингов = Метаданные.НайтиПоТипу(ТипСубъектаРейтингов);
		Если СправочникиКВыгрузке.Свойство(МетаданныеСубъектаРейтингов.Имя) Тогда
			Для Каждого Субъект Из СправочникиКВыгрузке[МетаданныеСубъектаРейтингов.Имя] Цикл
				МассивСубъектов.Добавить(Субъект);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("МассивСубъектов", МассивСубъектов);
	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	СоздатьСоставнойИдентификатор(Данные, "RACode,ScaleCode,RatingValue", "ExtCode", Ложь);
	
	ДобавитьДанныеВПакет("ЗначенияРейтингов,Рейтинг", Данные);		
	
КонецПроцедуры	

