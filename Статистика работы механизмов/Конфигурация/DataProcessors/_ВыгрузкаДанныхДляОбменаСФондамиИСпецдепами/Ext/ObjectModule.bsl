	ФиксированныеТипыОпераций.Вставить("ПриходПроцентовПоДепозитномуВкладуЦК", "Приход процентов по депозитному вкладу ЦК");
	
	Для Каждого ТипОперации Из ФиксированныеТипыОпераций Цикл
		Если Не СправочникиКВыгрузке.Свойство("OperTypeCode") ИЛИ СправочникиКВыгрузке.OperTypeCode.Найти(ТипОперации.Ключ) = Неопределено Тогда Продолжить; КонецЕсли;	
		
		СтрокаДанных = Данные.Добавить();
		СтрокаДанных.ExtCode = ТипОперации.Ключ;
		СтрокаДанных.Name = ТипОперации.Значение; 
		
	КонецЦикла;
	
	Если ВключатьДанныеВСоставВыгрузки("ВыгружатьВидыОперацийБухПроводок") Тогда
		
		ВидыОпераций = ПолучитьДанныеИзТабличногоДокумента(ПолучитьМакет("ВидыОперацийБухгалтерскихПроводок"));
		
		Для Каждого ВидОперации Из ВидыОпераций Цикл
			
			Если НЕ СправочникиКВыгрузке.Свойство("OperTypeCode")
				ИЛИ СправочникиКВыгрузке.OperTypeCode.Найти(ВидОперации.ExtCode) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Данные.Добавить(), ВидОперации);
		КонецЦикла;
		
	КонецЕсли;
	
	ДобавитьДанныеВПакет("ВидыОпераций,ВидОперации", Данные);
	
КонецПроцедуры	

