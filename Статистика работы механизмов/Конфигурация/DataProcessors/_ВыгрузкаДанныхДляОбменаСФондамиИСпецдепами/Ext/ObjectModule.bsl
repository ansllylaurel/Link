Функция ПолучитьСчетУчетаИзПроводок(Регистратор, ЦеннаяБумага)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчета.Код КАК СчетУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)";
	
	Запрос.УстановитьПараметр("Регистратор"	, Регистратор);
	
	Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
		Запрос.Текст = Запрос.Текст + "
		|И БухПартииЦенныхБумаг.ЦеннаяБумага = &ЦеннаяБумага";
	КонецЕсли;
	
	СчетаУчета = Запрос.Выполнить().Выгрузить();
	
	Если СчетаУчета.Количество() = 1 Тогда
		Возврат СчетаУчета[0].СчетУчета;
	Иначе
		//ЗарегистрироватьОшибку("Не удалось определить счет учета Ценной бумаги. Регистратор: " + Регистратор + ?(ЗначениеЗаполнено(ЦеннаяБумага), "Ценная бумага: " + ЦеннаяБумага,""), МассивОшибок);
		Возврат "";
	КонецЕсли;
	
