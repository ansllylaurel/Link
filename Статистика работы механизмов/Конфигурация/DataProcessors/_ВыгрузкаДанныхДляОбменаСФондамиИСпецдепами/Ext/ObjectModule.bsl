	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.ДополнительныеПараметрыВыгрузки = Новый Структура;
	
	Для Каждого ЗначениеНастройки Из НастройкиОтчета Цикл
		ЭтотОбъект.ДополнительныеПараметрыВыгрузки.Вставить(ЗначениеНастройки.Ключ, ЗначениеНастройки.Значение);
	КонецЦикла;
	
	ЭтотОбъект.КаталогДанных = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + "." + НастройкиОтчета.Расширение;
	
	//Помещаем двоичные данные файла во временное хранилище
	ИмяФайла = ВыгрузитьДанные();
	
	Если ИмяФайла = Неопределено Тогда
		ВызватьИсключение "При формировании выгрузки произошла ошибка! Файл выгрузки не сформирован.";
	Иначе
		
		Если НастройкиОтчета.Расширение <> Прав(ИмяФайла, 3) Тогда
			ВызватьИсключение "Расширение файла-результата не соответствует настройкам!";
		КонецЕсли;
		
		АдресРезультатаВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), Новый УникальныйИдентификатор());
		
		НастройкиОтчета.Вставить("Результат", АдресРезультатаВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ВыгрузитьДанные() Экспорт

	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, , ПредставлениеДополнительныхПараметровВыгрузки()); 
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыгрузитьДанные()";
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	ВремяНачалаВыгрузки			= ТекущаяДата();	
	АвтоматическоеФормирование	= ЭтотОбъект.ДополнительныеПараметрыВыгрузки.Свойство("АвтоматическоеФормирование");
	ОшибкаВыгрузки				= Не ПроверитьЗаполнение();
	
	Если Не ОшибкаВыгрузки Тогда
	
		ЗаполнитьЮрЛицаСАнкетнымиДанными();
		
		#Область Фабрика_XDTO
		
		Если Не АвтоматическоеФормирование Тогда
			
			ОтчетНАПФ = НастроенныйОтчетНАПФ();
			
			Если ОтчетНАПФ = Неопределено Тогда
				ОшибкаВыгрузки = Истина;
			Иначе
				УстановитьДополнительныеПараметрыВыгрузки(ОтчетНАПФ);
				РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(Механизм, Сессия, ПредставлениеДополнительныхПараметровВыгрузки()); 
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ОшибкаВыгрузки Тогда
		
			Если НЕ ЭтотОбъект.ВыгрузкаВИнфинитум Тогда
				ИмяПакетаXDTO = ДополнительныеПараметрыВыгрузки.ФорматВыгрузкиНАПФ;
			Иначе
				ИмяПакетаXDTO = "NAPF_Infinitum";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяПакетаXDTO) Тогда
				СформироватьПакетДанных(ИмяПакетаXDTO); // Формируем данные для выгрузки
			Иначе	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счета ДУ """ + ЭтотОбъект.СчетДоверительногоУправления + """ не указан формат выгрузки НАПФ!", , , , ОшибкаВыгрузки);
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
		Если Не ОшибкаВыгрузки Тогда
		
			// Создаем временный каталог для последующего создания временных файлов.
			Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + XMLСтрока(Новый УникальныйИдентификатор) + "\";
			СоздатьКаталог(Каталог);
			
			// Записываем данные во временные файлы.
			Файлы = СформироватьФайлы(ИмяПакетаXDTO, ДополнительныеПараметрыВыгрузки.НеторговыеОперацииВОтдельныйФайл, Каталог);
			
			#Область Определяем_имя_файла_результата
			
			Если АвтоматическоеФормирование Тогда
				ПутьКФайлу = ЭтотОбъект.КаталогДанных;
			Иначе
					
				ИмяФайла = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройки(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.СчетДоверительногоУправления, ОтчетНАПФ, "ИмяФайла", ЭтотОбъект.Периодичность);
						
				ПараметрыЗаполнения = Новый Структура;
				
				ПараметрыЗаполнения.Вставить("Субъект",							ЭтотОбъект.СчетДоверительногоУправления);
				ПараметрыЗаполнения.Вставить("Отчет",							ОтчетНАПФ);
				ПараметрыЗаполнения.Вставить("Периодичность",					Неопределено);
				ПараметрыЗаполнения.Вставить("ДатаНачала",						Период.ДатаНачала);
				ПараметрыЗаполнения.Вставить("ДатаОкончания",					Период.ДатаОкончания);
					
				ИмяФайла = РегистрыСведений.СоставИНастройкиОтчетов.ОбработатьПутьКФайлу(ИмяФайла, ПараметрыЗаполнения);
				
				ПутьКФайлу = ЭтотОбъект.КаталогДанных + ?(СтрЗаканчиваетсяНа(ЭтотОбъект.КаталогДанных, "\"), "", "\") + ИмяФайла;
				
			КонецЕсли;
			
			#КонецОбласти
			
			#Область Сохраняем_файл_результата
			
			// Если файлов несколько, или на выходе должен быть архив - создаем архив и пишем в него все файлы.
			Если Файлы.Количество() > 1
				ИЛИ НРег(Прав(ПутьКФайлу, 3)) = "zip"
			Тогда
				
				// Если по настройкам должен получиться XML-файл, а мы формируем архив, меняем расширение.
				Если НРег(Прав(ПутьКФайлу, 3)) = "xml" Тогда
					ПутьКФайлу = Лев(ПутьКФайлу, СтрДлина(ПутьКФайлу) - 3) + "zip";
				КонецЕсли;
				
				Архив = Новый ЗаписьZipФайла(ПутьКФайлу);
				
				Для Каждого ТекФайл Из Файлы Цикл
					Архив.Добавить(ТекФайл);
				КонецЦикла;
				
				Если АвтоматическоеФормирование Тогда
					Архив.Записать();
				Иначе
					
					Попытка
						Архив.Записать();
					Исключение
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							"Выгрузка прервана из-за ошибки!
							|Не удалось записать файл '" + ПутьКФайлу + "'.
							|Ошибка:" + ОписаниеОшибки(), , , , ОшибкаВыгрузки);
					КонецПопытки;
					
				КонецЕсли;
				
			Иначе // Если файл один и на выходе должны получить XML-файл - копируем
				
				Если АвтоматическоеФормирование Тогда
					КопироватьФайл(Файлы[0], ПутьКФайлу);
				Иначе
					
					Попытка
						КопироватьФайл(Файлы[0], ПутьКФайлу);
					Исключение
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							"Выгрузка прервана из-за ошибки!
							|Не удалось записать файл '" + ПутьКФайлу + "'.
							|Ошибка:" + ОписаниеОшибки(), , , , ОшибкаВыгрузки);
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
			#КонецОбласти
			
			Попытка
				УдалитьФайлы(Каталог); // Удаляем временные файлы вместе с каталогом
			Исключение
				// Не удалили - ничего криминального, удалится на следующий день
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если МассивОшибок.Количество() Тогда
		ОповеститьОбОшибках(МассивОшибок);
	КонецЕсли;
	
	Если Не ОшибкаВыгрузки И Не АвтоматическоеФормирование Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Продолжительность выгрузки: " + Строка(ТекущаяДата() - ВремяНачалаВыгрузки) + " сек.");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные выгружены в файл: " + ПутьКФайлу);
	КонецЕсли;
	
	ДополнительныеПараметрыСтатистикиПоРезультатамРаботы = Новый Структура("РезультатВыгрузки", ?(ОшибкаВыгрузки, "Ошибка выгрузки", ПутьКФайлу)); 
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , ДополнительныеПараметрыСтатистикиПоРезультатамРаботы);	
	
	Возврат ?(ОшибкаВыгрузки, Неопределено, ПутьКФайлу); // Возвращаем имя файла результата при успешной выгрузке
	
КонецФункции

#Область Выгрузка_данных

Процедура ВыгрузитьДанныеСправочника(Список, ИмяДанных, Данные)
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементДанных = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, ИмяДанных));
	Для Каждого Атрибут Из ЭлементДанных.Свойства() Цикл
		Если Данные.Колонки.Найти(Атрибут.Имя) = Неопределено Тогда
			ЗарегистрироватьОшибку("Для данных " + ИмяДанных + " нет атрибута " + Атрибут.Имя, МассивОшибок);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЭлементДанных = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, ИмяДанных));
		
		Для Каждого Атрибут Из ЭлементДанных.Свойства() Цикл
			ИсходноеЗнч = СтрокаДанных[Атрибут.Имя];
			
			Если НЕ ЗначениеЗаполнено(ИсходноеЗнч) И Атрибут.НижняяГраница = 0 Тогда 
				Продолжить; 
			КонецЕсли;
			
			СериализованноеЗначение = СериализоватьЗначение(ИсходноеЗнч, Атрибут.Тип);
			
			Попытка
				ЭлементДанных[Атрибут.Имя] = СериализованноеЗначение;
			Исключение
				Если Атрибут.НижняяГраница <> 0 Тогда
					ЗарегистрироватьОшибку("Для данных " + ИмяДанных + " атрибут " + Атрибут.Имя + " не совпадение типов: " + СериализованноеЗначение, МассивОшибок);
				КонецЕсли;
			КонецПопытки;
			
			Если ИмяДанных = "СделкаТорговыеФИ"
				И ВключатьДанныеВСоставВыгрузки("ВыгружатьНКДПоВторойЧастиРЕПО")
				И Атрибут.Имя = "REPO2Amount"
				И ЭлементДанных.Свойства().Получить("REPO2ACI") = Неопределено
			Тогда  
				ПользовательскоеСвойство = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "decimal"));
				ЭлементДанных.Добавить(ФормаXML.Элемент, URIПространстваИмен, "REPO2ACI", ПользовательскоеСвойство);
			КонецЕсли;
			
		КонецЦикла;
		
		Список.Добавить(ЭлементДанных);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьАналитическиеПризнакиБухгалтерскихСчетов()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьДанныеБухгалтерскогоУчета") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеПараметрыВыгрузки.ПланСчетовДляНАПФ) Тогда

		МассивСчетовУчета = ПолучитьМассивЭлементов("СчетаУчета");
		
		Данные = Новый ТаблицаЗначений;
		Данные.Колонки.Добавить("AccountNo");
		Данные.Колонки.Добавить("SubcountCode");
		Данные.Колонки.Добавить("SubcObjectName");
		Данные.Колонки.Добавить("SubcOrder");
		Данные.Колонки.Добавить("SubcPositionBegin");
		Данные.Колонки.Добавить("SubcPositionEnd");
		
		Макет = ПолучитьМакет(ДополнительныеПараметрыВыгрузки.ПланСчетовДляНАПФ);
		
		//аналитики счетов
		Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
			ИсходящийСчет = Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
			Если ЗначениеЗаполнено(ИсходящийСчет) Тогда Продолжить; КонецЕсли;
			
			НомерСчета				= Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
			НомерСубконто			= Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;
			НаименованиеСубконто	= Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст;
			
			Если СтрДлина(НомерСчета) <> 3 Тогда
				
				Если Число(НомерСубконто) <> 0 Тогда	
					НоваяСтрока = Данные.Добавить();
					НоваяСтрока.AccountNo		= НомерСчета;
					НоваяСтрока.SubcountCode	= НаименованиеСубконто;
					НоваяСтрока.SubcObjectName	= НаименованиеСубконто;
					НоваяСтрока.SubcOrder		= Число(НомерСубконто);
				КонецЕсли;
				
				Если МассивСчетовУчета.Найти(НомерСчета) <> Неопределено Тогда
					МассивСчетовУчета.Удалить(МассивСчетовУчета.Найти(НомерСчета));
				КонецЕсли;	
				
			КонецЕсли;
		КонецЦикла;
		
		МассивСчетовУчетаДляУдаления = Новый Массив;
		
		//аналитики гурппы счетов
		Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
			ИсходящийСчет = Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
			Если ЗначениеЗаполнено(ИсходящийСчет) Тогда Продолжить; КонецЕсли;
			
			НомерСчета				= Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
			НомерСубконто			= Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;
			НаименованиеСубконто	= Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст;
			
			Если СтрДлина(НомерСчета) = 3 Тогда //это группа счетов
				
				Для Каждого СчетУчета Из МассивСчетовУчета Цикл
					Если Лев(СчетУчета, 3) = НомерСчета Тогда
						
						Если Число(НомерСубконто) <> 0 Тогда 
							НоваяСтрока = Данные.Добавить();
							НоваяСтрока.AccountNo		= СчетУчета;
							НоваяСтрока.SubcountCode	= НаименованиеСубконто;
							НоваяСтрока.SubcObjectName	= НаименованиеСубконто;
							НоваяСтрока.SubcOrder		= Число(НомерСубконто);
						КонецЕсли;
						
						Если МассивСчетовУчетаДляУдаления.Найти(СчетУчета) = Неопределено Тогда
							МассивСчетовУчетаДляУдаления.Добавить(СчетУчета);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СчетУчета Из МассивСчетовУчетаДляУдаления Цикл
			МассивСчетовУчета.Удалить(МассивСчетовУчета.Найти(СчетУчета));
		КонецЦикла;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйВидыСубконто.Ссылка.Код КАК AccountNo,
			|	ЕдиныйВидыСубконто.ВидСубконто.Ссылка КАК SubcountCode,
			|	ЕдиныйВидыСубконто.ВидСубконто.Наименование КАК SubcObjectName,
			|	ЕдиныйВидыСубконто.НомерСтроки КАК SubcOrder
			|ИЗ
			|	ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто
			|ГДЕ
			|	ЕдиныйВидыСубконто.Ссылка.Код В(&МассивСчетовУчета)
			|	И НЕ ЕдиныйВидыСубконто.Ссылка.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЛицевыеСчета.СчетУчета.Код,
			|	""Дополнительные аналитики лицевых счетов"",
			|	""Дополнительные аналитики лицевых счетов"",
			|	4
			|ИЗ
			|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
			|ГДЕ
			|	ЛицевыеСчета.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка)
			|	И ЛицевыеСчета.СчетУчета.Код В(&МассивСчетовУчета)
			|	И НЕ ЛицевыеСчета.СчетУчета.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("МассивСчетовУчета", МассивСчетовУчета);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Данные.Добавить(), Выборка);
		КонецЦикла;
	
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйВидыСубконто.Ссылка КАК ВидСубконто,
			|	ЕдиныйВидыСубконто.Ссылка.Код КАК AccountNo,
			|	ЕдиныйВидыСубконто.ВидСубконто.Ссылка КАК SubcountCode,
			|	ЕдиныйВидыСубконто.ВидСубконто.Наименование КАК SubcObjectName,
			|	ЕдиныйВидыСубконто.НомерСтроки КАК SubcOrder,
			|	NULL КАК SubcPositionBegin,
			|	NULL КАК SubcPositionEnd
			|ИЗ
			|	ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто
			|ГДЕ
			|	НЕ ЕдиныйВидыСубконто.Ссылка.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЛицевыеСчета.СчетУчета,
			|	ЛицевыеСчета.СчетУчета.Код,
			|	""Дополнительные аналитики лицевых счетов"",
			|	""Дополнительные аналитики лицевых счетов"",
			|	4,
			|	NULL,
			|	NULL
			|ИЗ
			|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
			|ГДЕ
			|	ЛицевыеСчета.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка)
			|	И НЕ ЛицевыеСчета.СчетУчета.ПометкаУдаления";
		
		Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
		
	КонецЕсли;
	
	Данные.Колонки.Добавить("ExtCode");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.ExtCode = Строка(СтрокаДанных.AccountNo) + Строка(СтрокаДанных.SubcOrder);
	КонецЦикла;
	
	Данные.Сортировать("AccountNo,SubcOrder");
	ДобавитьДанныеВПакет("АналитичПризнакиСчетов", Данные);		
	
КонецПроцедуры

Процедура ВыгрузитьБанковскиеСчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК ExtCode,
		|	&СчетДоверительногоУправления КАК TrustAgrCode,
		|	1 КАК AccKindCode,
		|	БанковскиеСчета.Банк.Код КАК BIC,
		|	БанковскиеСчета.НомерСчета КАК AccountNo,
		|	БанковскиеСчета.Валюта.Код КАК CurrencyCode,
		|	БанковскиеСчета.Договор.ДатаЗаключения КАК OpeningDate,
		|	БанковскиеСчета.ДатаЗакрытия КАК ClosingDate,
		|	БанковскиеСчета.Банк.ЮрФизЛицо КАК ContractorCode
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка В(&МассивБанковскиеСчета)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БрокерскиеКомпании.Ссылка,
		|	&СчетДоверительногоУправления,
		|	2,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	БрокерскиеКомпании.ЮрФизЛицо
		|ИЗ
		|	Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
		|ГДЕ
		|	БрокерскиеКомпании.Ссылка В(&МассивБрокерскиеКомпании)";	
		
	Запрос.УстановитьПараметр("МассивБанковскиеСчета"		, ПолучитьМассивЭлементов("БанковскиеСчета"));		
	Запрос.УстановитьПараметр("МассивБрокерскиеКомпании"	, ПолучитьМассивЭлементов("БрокерскиеКомпании"));//в операциях когда деньги идут через брокера, в качестве счёта указывается ссылка на Брокера.
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	ОбезличитьДанные(Данные, "", "AccountNo");
	
	ДобавитьДанныеВПакет("БанковскиеСчета,БанковскийСчет", Данные);		
	
	
	
КонецПроцедуры	

Процедура ВыгрузитьБрокерскиеСчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК ExtCode1,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК ExtCode2,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК AccountNo,
		|	""643"" КАК CurrencyCode,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК OpeningDate,
		|	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ClosingDate,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо КАК ContractorCode
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаОкончания,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Брокер В (&МассивБрокерскиеКомпании)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаОкончания, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)";
	
	
	Запрос.УстановитьПараметр("МассивБрокерскиеКомпании"	, ПолучитьМассивЭлементов("БрокерскиеКомпании"));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);
	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	СоздатьСоставнойИдентификатор(Данные, "ExtCode1,ExtCode2", "ExtCode", Истина);
	
	ОбезличитьДанные(Данные, "", "AccountNo");
	
	ДобавитьДанныеВПакет("БрокерскиеСчета,БрокерскийСчет", Данные);		
	
КонецПроцедуры

Процедура ВыгрузитьБухгалтерскиеПроводки()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьДанныеБухгалтерскогоУчета") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВключатьДанныеВСоставВыгрузки("ВыгружатьВидыОперацийБухПроводок") Тогда
		ВидыОпераций = ПолучитьДанныеИзТабличногоДокумента(ПолучитьМакет("СоответствиеВидовОперацийБухгалтерскихПроводок"));
	Иначе
		ВидыОпераций = Новый ТаблицаЗначений;
		ВидыОпераций.Колонки.Добавить("СчетДт",			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
		ВидыОпераций.Колонки.Добавить("СчетКт",			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
		ВидыОпераций.Колонки.Добавить("Description",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
		ВидыОпераций.Колонки.Добавить("ExtCode",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыОпераций.СчетДт КАК СчетДт,
		|	ВидыОпераций.СчетКт КАК СчетКт,
		|	ВидыОпераций.Description КАК Description,
		|	ВидыОпераций.ExtCode КАК ExtCode
		|ПОМЕСТИТЬ _ВидыОпераций
		|ИЗ
		|	&ВидыОпераций КАК ВидыОпераций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Период КАК TransDate,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Регистратор.Дата КАК DocumDate,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Сумма КАК Amount,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт.Код = ""000""
		|			ТОГДА ""00000""
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт.Код
		|	КОНЕЦ КАК AccDebit,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт.Код = ""000""
		|			ТОГДА ""00000""
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетКт.Код
		|	КОНЕЦ КАК AccCredit,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ЛицевойСчетДт.ГруппаФинансовогоУчетаДоходовРасходов.Код КАК SymbSFPDebit,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ЛицевойСчетКт.ГруппаФинансовогоУчетаДоходовРасходов.Код КАК SymbSFPCredit,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ЛицевойСчетДт.Код КАК LedgerAccDebit,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.ЛицевойСчетКт.Код КАК LedgerAccCredit,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Содержание КАК Description,
		|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.Регистратор.Номер КАК DocumentNo,
		|	_ВидыОпераций.ExtCode КАК OperTypeCode,
		|	ВЫБОР
		|		КОГДА НЕ &КурсВалютыВБухПроводкахИзКонверсионныхСделок
		|			ТОГДА ЕСТЬNULL(КурсыВалютДт.Курс / КурсыВалютДт.Кратность, 1)
		|		КОГДА ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаДт = СделкаСВалютой.Валюта
		|			ТОГДА СделкаСВалютой.Курс
		|		КОГДА ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаДт = СделкаСВалютой.Контрвалюта
		|			ТОГДА 1
		|		ИНАЧЕ ЕСТЬNULL(КурсыВалютДт.Курс / КурсыВалютДт.Кратность, 1)
		|	КОНЕЦ КАК CurrRateDebit,
		|	ВЫБОР
		|		КОГДА НЕ &КурсВалютыВБухПроводкахИзКонверсионныхСделок
		|			ТОГДА ЕСТЬNULL(КурсыВалютКт.Курс / КурсыВалютКт.Кратность, 1)
		|		КОГДА ЕдиныйБухгалтерскийУчетДвиженияССубконто.ВалютаКт = СделкаСВалютой.Валюта
		|			ТОГДА СделкаСВалютой.Курс
