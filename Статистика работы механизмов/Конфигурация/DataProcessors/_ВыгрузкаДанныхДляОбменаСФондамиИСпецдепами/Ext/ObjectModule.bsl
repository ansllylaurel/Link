Функция ПолучитьКонтрагентаИзДоговора(Договор)
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Возврат РегистрыСведений.КлиентыДоверительногоУправления.СрезПоследних(ЭтотОбъект.Период.ДатаОкончания, Новый Структура("СчетДоверительногоУправления", Договор))[0].Клиент;
	ИначеЕсли ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры") Тогда
		Возврат Договор.Контрагент;
	ИначеЕсли ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") Тогда
		Возврат Договор.Контрагент;
	Иначе
		ЗарегистрироватьОшибку("Ошибка вычисления Субконто в функции ""ПолучитьКонтрагентаИзДоговора"" для счёта " + НомерСчетаПриВычисленииСубкнонто + ", Тип договора: " + ТипЗнч(Договор), МассивОшибок);
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКонтрагентаИзОснованияРасчетов(ОснованиеРасчетов)
	
	Если ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаРЕПО")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.Сделка") 
		Тогда
		Если ЗначениеЗаполнено(ОснованиеРасчетов.Брокер) Тогда
			Возврат ОснованиеРасчетов.Брокер.ЮрФизЛицо;
		Иначе
			Возврат ОснованиеРасчетов.Договор.Контрагент;
		КонецЕсли;
	
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		Возврат ОснованиеРасчетов.ДепозитарныйСчет.Брокер.ЮрФизЛицо;
			
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		Если ЗначениеЗаполнено(ОснованиеРасчетов.Брокер) Тогда
			Возврат ОснованиеРасчетов.Брокер.ЮрФизЛицо;
		Иначе
			Возврат ОснованиеРасчетов.РасчетныйСчет.Банк.ЮрФизЛицо;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
		Если ЗначениеЗаполнено(ОснованиеРасчетов.Брокер) Тогда
			Возврат ОснованиеРасчетов.Брокер.ЮрФизЛицо;
		Иначе
			Возврат ОснованиеРасчетов.Облигация.Эмитент.ЮрФизЛицо;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		Если ЗначениеЗаполнено(ОснованиеРасчетов.Брокер) Тогда
			Возврат ОснованиеРасчетов.Брокер.ЮрФизЛицо;
		Иначе
			Возврат ОснованиеРасчетов.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
		КонецЕсли;
			
	//ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("СправочникСсылка.Договоры") Тогда
	//ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСПФИ") Тогда
		Возврат ОснованиеРасчетов.Контрагент;
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Возврат ОснованиеРасчетов;
	Иначе
		ЗарегистрироватьОшибку("Ошибка вычисления Субконто в функции ""ПолучитьКонтрагентаИзОснованияРасчетов"" для счёта " + НомерСчетаПриВычисленииСубкнонто + ", Тип основания расчетов: " + ТипЗнч(ОснованиеРасчетов), МассивОшибок);
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДоговорИзОснованияРасчетов(ОснованиеРасчетов, ДатаОперации)
	
	Если ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаРЕПО")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.Сделка")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ВводЦенныхБумаг")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеКупона")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСВалютой")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСПФИ")
		ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.Маржа")
		Тогда
		Если ЗначениеЗаполнено(ОснованиеРасчетов.Брокер) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания
				|ИЗ
				|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
				|			&ДатаОперации,
				|			Брокер = &Брокер
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";
				
			Запрос.УстановитьПараметр("ДатаОперации"				, ДатаОперации);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Брокер"						, ОснованиеРасчетов.Брокер);
			Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.ДоговорБрокерскогоОбслуживания;
			Иначе
				Возврат "";
			КонецЕсли;
		ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ВводЦенныхБумаг")
			ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеКупона")
			ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги")
			ИЛИ ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
			Возврат "";
		Иначе
			Возврат ОснованиеРасчетов.Договор;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("СправочникСсылка.Договоры") Тогда
		Возврат ОснованиеРасчетов;
		
	//ИначеЕсли ТипЗнч(ОснованиеРасчетов) = Тип("ДокументСсылка.МНО") Тогда
	Иначе
		ЗарегистрироватьОшибку("Ошибка вычисления Субконто в функции ""ПолучитьДоговорИзОснованияРасчетов"" для счёта " + НомерСчетаПриВычисленииСубкнонто + ", Тип основания расчетов: " + ТипЗнч(ОснованиеРасчетов) + ", Значение основания " + Строка(ОснованиеРасчетов), МассивОшибок);
		Возврат "";
	КонецЕсли;
	
КонецФункции

