Процедура ВыгрузитьКотировки()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьКотировки") Тогда
		Возврат;
	КонецЕсли;
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ExtCode");
	Данные.Колонки.Добавить("FICode");
	Данные.Колонки.Добавить("Date");
	Данные.Колонки.Добавить("SourceCode");
	Данные.Колонки.Добавить("CalculationsType");
	Данные.Колонки.Добавить("QuotKindCode");
	Данные.Колонки.Добавить("QuotValue");
	Данные.Колонки.Добавить("Currency");
	Данные.Колонки.Добавить("Log");
	
	МассивРесурсов = Новый Массив;
	
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.КотировкиТорговыхПлощадокСводные.Ресурсы Цикл
		Если Ресурс.Имя = "Валюта" Тогда Продолжить; КонецЕсли;
		Если Прав(ВРЕГ(Ресурс.Имя), 5) = "_DATE" Тогда Продолжить; КонецЕсли;
		
		МассивРесурсов.Добавить(Ресурс.Имя);
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РежимыБиржевыхТоргов.Ссылка КАК РежимТоргов,
		|	ПОДСТРОКА(РежимыБиржевыхТоргов.НаименованиеРежимаТоргов, 1, 24) = ""Режим основных торгов Т+"" КАК Т_Плюс
		|ПОМЕСТИТЬ ВТ_РежимыТоргов
		|ИЗ
		|	Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|ГДЕ
		|	(ПОДСТРОКА(РежимыБиржевыхТоргов.НаименованиеРежимаТоргов, 1, 24) = ""Режим основных торгов Т+""
		|			ИЛИ ПОДСТРОКА(РежимыБиржевыхТоргов.НаименованиеРежимаТоргов, 1, 21) = ""Режим основных торгов"")
		|;
