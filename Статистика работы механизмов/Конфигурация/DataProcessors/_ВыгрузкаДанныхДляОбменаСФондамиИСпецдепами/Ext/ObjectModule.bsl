Процедура ВыгрузитьРеквизитыВыгрузки()
	
	РеквизитыВыгрузки = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	NULL КАК FileVersion,
		|	РеквизитыУК.ПолноеНаименованиеПоУставу КАК CompanyName,
		|	РеквизитыУК.ИНН КАК CompanyINN,
		|	РеквизитыУК.КПП КАК CompanyKPP,
		|	СчетаДоверительногоУправления.НомерДоговора КАК AgreementNo,
		|	РеквизитыКлиента.ПолноеНаименованиеПоУставу КАК ClientName,
		|	РеквизитыКлиента.ИНН КАК ClientINN,
		|	РеквизитыКлиента.КПП КАК ClientKPP,
		|	&ТекущаяДата КАК DateCreate,
		|	&ДатаНачала КАК DateStart,
		|	&ДатаОкончания КАК DateEnd,
		|	РеквизитыУК.ЮрФизЛицо КАК ExtCode,
		|	РеквизитыУК.КраткоеНаименованиеПоУставу КАК ShortName,
		|	РеквизитыУК.ПолноеНаименованиеПоУставу КАК Name,
		|	РеквизитыУК.ИНН КАК INN,
		|	РеквизитыУК.КПП КАК KPP
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&ДатаОкончания,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиента
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыКлиента.ЮрФизЛицо
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыУК
		|		ПО СчетаДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыУК.ЮрФизЛицо
		|ГДЕ
		|	(СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов))
		|	И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДата"					, ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Заголовок = Новый Структура("FileVersion,CompanyName,CompanyINN,CompanyKPP,AgreementNo,ClientName,ClientINN,ClientKPP,DateCreate,DateStart,DateEnd,Log");
		ЗаполнитьЗначенияСвойств(Заголовок, Выборка);
		
		ОбезличитьДанные(Заголовок, "ClientName,ClientINN,ClientKPP", "AgreementNo,");
		
		РеквизитыВыгрузки.Вставить("Заголовок", Заголовок);
		
		УправляющаяКомпания = Новый Структура("ExtCode,ShortName,Name,INN,KPP,Log");
		ЗаполнитьЗначенияСвойств(УправляющаяКомпания, Выборка);
		РеквизитыВыгрузки.Вставить("УправляющаяКомпания", УправляющаяКомпания);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьСправедливуюСтоимость()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьСправедливуюСтоимость") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК TrustAgrCode,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК FICode,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК Ext_FI_Code,
		|	СтоимостьПереоценки.Период КАК Date,
		|	СтоимостьПереоценки.ДатаЦены КАК Quote_Date,
		|	СтоимостьПереоценки.ДатаЦены КАК SourceDate,
		|	СтоимостьПереоценки.Цена КАК Value,
		|	СтоимостьПереоценки.Цена КАК QuotValue,
		|	СтоимостьПереоценки.УровеньОценки КАК Fair_Value_Level,
		|	СтоимостьПереоценки.УровеньОценки КАК FairValueLevel,
		|	СтоимостьПереоценки.Источник.Наименование КАК SourceCode,
		|	СтоимостьПереоценки.ВидЦены КАК SourceQuotKindCode
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
		|	И СтоимостьПереоценки.Период >= &ДатаНачала
		|	И СтоимостьПереоценки.Период <= &ДатаОкончания
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)";
	
	Если ВключатьДанныеВСоставВыгрузки("ВыгружатьРасчетнуюСтоимостьСобственныхПаев") Тогда
		Запрос.Текст = Запрос.Текст  + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	0 КАК Log,
		|	&СчетДоверительногоУправления КАК TrustAgrCode,
		|	Паи.Ссылка КАК FICode,
		|	Паи.Ссылка КАК Ext_FI_Code,
		|	ФинансовыеПоказатели.Период КАК Date,
		|	ФинансовыеПоказатели.Период КАК Quote_Date,
		|	ФинансовыеПоказатели.Период КАК SourceDate,
		|	ФинансовыеПоказатели.Значение КАК Value,
		|	ФинансовыеПоказатели.Значение КАК QuotValue,
		|	1 КАК Fair_Value_Level,
		|	1 КАК FairValueLevel,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК SourceCode,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.РасчетнаяЦена) КАК SourceQuotKindCode
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОкончания, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ФинансовыеПоказатели.Организация.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = Паи.ПаевойИнвестиционныйФонд
		|		ПО ФинансовыеПоказатели.СубъектАналитики = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ФинансовыеПоказатели.Организация.ЮрФизЛицо) = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	ФинансовыеПоказатели.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫРАЗИТЬ(ФинансовыеПоказатели.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая)
		|	И ФинансовыеПоказатели.Организация = &Организация"		
		
		
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"					, НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания"				, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	
	Попытка 
		Данные = Запрос.Выполнить().Выгрузить(); 
	Исключение
		Сообщить("Нет доступа:" + Запрос.Текст);
	КонецПопытки;
	
	СоздатьСоставнойИдентификатор(Данные, "Ext_FI_Code,Date", "ExtCode");

	
	ДобавитьДанныеВПакет("СправедливаяСтоимость", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьТорговыеПлощадки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Log,
		|	ВложенныйЗапрос.ExtCode КАК ExtCode,
		|	ВложенныйЗапрос.Name КАК Name,
		|	ВложенныйЗапрос.StockKind КАК StockKind
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА МестаХранения.Ссылка = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				ТОГДА МестаХранения.Ссылка
		|			ИНАЧЕ МестаХранения.Биржа
		|		КОНЕЦ КАК ExtCode,
		|		ВЫБОР
		|			КОГДА МестаХранения.Ссылка = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				ТОГДА МестаХранения.Наименование
		|			ИНАЧЕ МестаХранения.Биржа.Наименование
		|		КОНЕЦ КАК Name,
		|		НЕ МестаХранения.Ссылка = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок) КАК StockKind
		|	ИЗ
		|		Справочник.МестаХранения КАК МестаХранения) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.ExtCode <> ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Name,
		|	ВложенныйЗапрос.ExtCode,
		|	ВложенныйЗапрос.StockKind";

	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	ДобавитьДанныеВПакет("ТорговыеПлощадки,ТорговаяПлощадка", Данные);		
	
КонецПроцедуры

Процедура ВыгрузитьВидыОпераций()
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК OperTypeCode,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК OperSubTypeCode,
		|	ВЫБОР
		|		КОГДА &ДополнитьВидДвиженияДСВидомДвиженияРегистра <> ИСТИНА
		|				ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
		|			ТОГДА """"
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ""Списание""
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ""Поступление""
		|	КОНЕЦ КАК OperSubTypeCode2
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""НачислениеЗадолженности"",
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности,
		|	NULL
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.НачислениеЗадолженности)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.ПогашениеКупона))
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Основание) В (ТИП(Документ.Сделка), ТИП(Документ.СделкаРЕПО))
		|	И &ВыгружатьНачисленияЗадолженности
		|	И &ДетализацияПоВидуНачисленнойЗадолженности
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""НачислениеЗадолженности"",
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности,
		|	NULL
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.НачислениеЗадолженности)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.ПогашениеКупона))
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Основание) В (ТИП(Документ.Сделка), ТИП(Документ.СделкаРЕПО))
		|	И (&ВыгружатьВсеРегистраторыБухгалтерскогоУчета
		|			ИЛИ &ВыгружатьНачисленияЗадолженностиПоСделкам)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""НачислениеДивидендов"",
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности,
		|	NULL
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.Оплата)
		|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Основание) = ТИП(Документ.НачислениеДивидендов)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНалогуНаПрибыль)
		|	И &ВыгружатьНачисленияНалога";
					
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДополнитьВидДвиженияДСВидомДвиженияРегистра"	, ВключатьДанныеВСоставВыгрузки("ДополнитьВидДвиженияДСВидомДвиженияРегистра"));					
	Запрос.УстановитьПараметр("ДетализацияПоВидуНачисленнойЗадолженности"	, ВключатьДанныеВСоставВыгрузки("ДетализацияПоВидуНачисленнойЗадолженности"));
	Запрос.УстановитьПараметр("ВыгружатьНачисленияЗадолженности"			, ВключатьДанныеВСоставВыгрузки("ВыгружатьНачисленияЗадолженности"));
	Запрос.УстановитьПараметр("ВыгружатьНачисленияНалога"					, ВключатьДанныеВСоставВыгрузки("ВыгружатьНачисленияНалога"));
	Запрос.УстановитьПараметр("ВыгружатьНачисленияЗадолженностиПоСделкам"	, ВключатьДанныеВСоставВыгрузки("ВыгружатьНачисленияЗадолженностиПоСделкам"));
	Запрос.УстановитьПараметр("ВыгружатьВсеРегистраторыБухгалтерскогоУчета"	, ВключатьДанныеВСоставВыгрузки("ВыгружатьВсеРегистраторыБухгалтерскогоУчета"));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"				, ЭтотОбъект.СчетДоверительногоУправления);
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("ExtCode");
	Данные.Колонки.Добавить("Name");
	Данные.Колонки.Добавить("ParentGroup");
	Данные.Колонки.Добавить("Log");
					
	Попытка Выборка = Запрос.Выполнить().Выбрать(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Идентификатор = СериализоватьЗначениеУзла(Выборка.OperTypeCode) + СериализоватьЗначениеУзла(Выборка.OperSubTypeCode) + СериализоватьЗначениеУзла(Выборка.OperSubTypeCode2);
		
		Если Не СправочникиКВыгрузке.Свойство("OperTypeCode") ИЛИ СправочникиКВыгрузке.OperTypeCode.Найти(Идентификатор) = Неопределено Тогда Продолжить; КонецЕсли;	
		
		СтрокаДанных = Данные.Добавить();
