Процедура ВыгрузитьКонтрагентов()
	
	Если ЭтотОбъект.ОбезличеннаяВыгрузка Тогда
		Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		Если СправочникиКВыгрузке.Свойство("ЮрФизЛица") И СправочникиКВыгрузке.ЮрФизЛица.Найти(Клиент) <> Неопределено Тогда
			СправочникиКВыгрузке.ЮрФизЛица.Удалить(СправочникиКВыгрузке.ЮрФизЛица.Найти(Клиент));
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",	 			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОкончания",	 			ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("МассивЮрФизЛица"	, 			ПолучитьМассивЭлементов("ЮрФизЛица"));
	Запрос.УстановитьПараметр("ЮрЛицаСАнкетнымиДанными",	ЮрЛицаСАнкетнымиДанными);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Эмитент.ЮрФизЛицо КАК ЮрФизЛицо,
		|	МАКСИМУМ(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)) КАК Государственные,
		|	МАКСИМУМ(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)) КАК Субфедеральные
		|ПОМЕСТИТЬ _Эмитенты
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|
		|СГРУППИРОВАТЬ ПО
		|	Облигации.Эмитент.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _Банки
		|ИЗ
		|	Справочник.Банки КАК Банки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо) КАК ВидЮрФизЛица,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.РезидентРФ КАК РезидентРФ,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес КАК ЮридическийАдрес,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ФактическийАдрес КАК ФактическийАдрес,
