	КонецЕсли;	
	
КонецФункции

Функция ПолучитьДанныеИзТабличногоДокумента(Макет)
	
	Результат = Новый ТаблицаЗначений;
	
	ИменаКолонок = Новый Соответствие;
	
	ИндексКолонки = 1;
	
	Пока Макет.Область(1, ИндексКолонки).Текст <> "" Цикл
		
		ИмяКолонки = Макет.Область(1, ИндексКолонки).Текст;
		
		ИменаКолонок.Вставить(ИндексКолонки, ИмяКолонки);
		
		Результат.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
		
		ИндексКолонки = ИндексКолонки + 1;
		
	КонецЦикла;
	
	КоличествоКолонок = ИндексКолонки - 1;
	
	ИндексСтроки = 2;
	
	Пока Макет.Область(ИндексСтроки, 1).Текст <> "" Цикл
		
		НоваяСтрока = Результат.Добавить();
		
		Для ИндексКолонки = 1 По КоличествоКолонок Цикл
			НоваяСтрока[ИменаКолонок.Получить(ИндексКолонки)] = Макет.Область(ИндексСтроки, ИндексКолонки).Текст;
		КонецЦикла;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьISIN(ЦенныеБумаги, Дата)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",			Дата);
	Запрос.УстановитьПараметр("ЦенныеБумаги",	ЦенныеБумаги);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага,
	               |	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN
	               |ИЗ
	               |	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
	               |			&Дата,
	               |			Объект В (&ЦенныеБумаги)
	               |				И ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ЦеннаяБумага, Выборка.ISIN);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьЮрЛицаСАнкетнымиДанными()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ЮрФизЛицо
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаНачала,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	КлиентыДоверительногоУправления.Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправления.Организация = &Организация
		|	И КлиентыДоверительногоУправления.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И КлиентыДоверительногоУправления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЮрФизЛица.Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОкончания, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО (Организации.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|				ИЛИ СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо = ЮрФизЛица.Ссылка)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	ЮрЛицаСАнкетнымиДанными = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЮрФизЛицо");

КонецПроцедуры

Процедура ОбезличитьДанные(Данные, ИменаКолонок, ИменаНумеруемыхКолонок = "")
	
	Если НЕ ЭтотОбъект.ОбезличеннаяВыгрузка Тогда
		Возврат;
	КонецЕсли;
	
	Колонки				= СтрРазделить(ИменаКолонок, ",", Ложь);
	НумеруемыеКолонки	= СтрРазделить(ИменаНумеруемыхКолонок, ",", Ложь);
	
	Нумераторы = Новый Структура;
	
	Для Каждого Колонка Из НумеруемыеКолонки Цикл
		Нумераторы.Вставить(Колонка, 0);
	КонецЦикла;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		
		Для Каждого Колонка Из Колонки Цикл
			Данные[Колонка] = "-";
		КонецЦикла;
		
		Для Каждого Колонка Из НумеруемыеКолонки Цикл
			Нумераторы.Вставить(Колонка, Нумераторы[Колонка] + 1);
			Данные[Колонка] = Нумераторы[Колонка];
		КонецЦикла;	
		
	Иначе
	
		Для Каждого СтрокаДанных Из Данные Цикл
			Для Каждого Колонка Из Колонки Цикл
				СтрокаДанных[Колонка] = "-";
			КонецЦикла;
			
			Для Каждого Колонка Из НумеруемыеКолонки Цикл
				Нумераторы.Вставить(Колонка, Нумераторы[Колонка] + 1);
				СтрокаДанных[Колонка] = Нумераторы[Колонка];
			КонецЦикла;	
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьФайлы(ИмяПакетаXDTO, НеторговыеОперацииВОтдельныйФайл, Каталог)
	
	Если ЭтотОбъект.ВыгрузкаВИнфинитум
		ИЛИ НЕ НеторговыеОперацииВОтдельныйФайл Тогда
		Результат = СохранитьДанныеВФайлы(ИмяПакетаXDTO, Каталог);
	Иначе
		
		Результат = Новый Массив;
		
		//Копируем полученные данные по неторговым операциям во временную структуру.
		ВременнаяСтруктураДанных = Новый Структура("ВидОперации, ВидыОпераций, Операция, Операции", ПакетДанных.ВидОперации.Скопировать(), ПакетДанных.ВидыОпераций.Скопировать(), ПакетДанных.Операция.Скопировать(), ПакетДанных.Операции.Скопировать());
		
		// Очищаем эти данные в пакете
		ПакетДанных.ВидОперации.Очистить();
		ПакетДанных.ВидыОпераций.Очистить();
		ПакетДанных.Операция.Очистить();
		ПакетДанных.Операции.Очистить();   		
		
		РаботаСКоллекциями.ДополнитьМассив(Результат, СохранитьДанныеВФайлы(ИмяПакетаXDTO, Каталог));
		
		// Возвращаем данные из временной структуры в пакет
		ПакетДанных.Вставить("ВидОперации", ВременнаяСтруктураДанных.ВидОперации.Скопировать());
		ПакетДанных.Вставить("ВидыОпераций", ВременнаяСтруктураДанных.ВидыОпераций.Скопировать());
		ПакетДанных.Вставить("Операция", ВременнаяСтруктураДанных.Операция.Скопировать());
		ПакетДанных.Вставить("Операции", ВременнаяСтруктураДанных.Операции.Скопировать());
		
		// Удаляем из пакета ранее выгруженные данные о сделках
		ПакетДанных.Удалить("СделкаТорговыеФИ");
		ПакетДанных.Удалить("СделкиТорговыеФИ");
		
		ПакетДанных.Удалить("БухгалтПроводки");
		ПакетДанных.Удалить("БухПроводка");
		ПакетДанных.Удалить("АналитичПризнакиСчетов");
		
		РаботаСКоллекциями.ДополнитьМассив(Результат, СохранитьДанныеВФайлы(ИмяПакетаXDTO, Каталог, 2));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьДанныеВФайлы(ИмяПакетаXDTO, Каталог, ПостфиксИмениФайла = Неопределено)

	Результат = Новый Массив;
	
	Если ЭтотОбъект.Метаданные().Макеты.Найти(ИмяПакетаXDTO) <> Неопределено Тогда
		МакетXSDСхемы = ПолучитьМакет(ИмяПакетаXDTO);		
		
		ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
		МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);
		
		ФайлыXSD = Новый Массив;
		ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
		
		НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
		
		Для Каждого ПакетовXDTO Из НоваяФабрикаXDTO.Пакеты Цикл
			Если ПакетовXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
				Продолжить;
			КонецЕсли;
			URIПространстваИмен = ПакетовXDTO.URIПространстваИмен;
		КонецЦикла;	
		
	ИначеЕсли Метаданные.ПакетыXDTO.Найти(ИмяПакетаXDTO) <> Неопределено Тогда
		НоваяФабрикаXDTO = ФабрикаXDTO;
		URIПространстваИмен = Метаданные.ПакетыXDTO.Найти(ИмяПакетаXDTO).ПространствоИмен; 
	Иначе
		ВызватьИсключение "Не удалось найти схему: " + ИмяПакетаXDTO;
		
	КонецЕсли;
	
	СообщениеТип = НоваяФабрикаXDTO.Тип(URIПространстваИмен, "Сообщение");
	ФайлыТип	 = НоваяФабрикаXDTO.Тип(URIПространстваИмен, "Файлы");
	
	ТипыЗначенийXML = Новый Структура;
	ТипыЗначенийXML.Вставить("date"		, НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "date"));
	ТипыЗначенийXML.Вставить("dateTime"	, НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "dateTime"));
	ТипыЗначенийXML.Вставить("time"		, НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "time"));
	ТипыЗначенийXML.Вставить("integer"	, НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "integer"));
	
	КорневыеСвойстваXDTO = НоваяФабрикаXDTO.Пакеты.Получить(URIПространстваИмен).КорневыеСвойства;
	
	Если ЭтотОбъект.ВыгрузкаВИнфинитум Тогда
		
		Для Каждого СвойствоXDTO Из КорневыеСвойстваXDTO Цикл
			
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку("UTF-8");
			
			ЗаписьXML.ЗаписатьОбъявлениеXML();
			
			// заполнение средствами XDTO
			ЭлементОбъектаXDTO	= ЗаполнитьКоллекциюСвойствXDTO(СвойствоXDTO);
			
			НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ЭлементОбъектаXDTO, СвойствоXDTO.Имя);
			// **************************
			
			СодержимоеФайла = ЗаписьXML.Закрыть();
			
			СодержимоеФайла = СтрЗаменить(СодержимоеФайла, " xmlns=""NFONAPFINFINITUM"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""", "");
			СодержимоеФайла = СтрЗаменить(СодержимоеФайла, "State_Registration_No", "State_Registration_No.");
			СодержимоеФайла = СтрЗаменить(СодержимоеФайла, "External_Agreement_No", "External_Agreement_No.");
			СодержимоеФайла = СтрЗаменить(СодержимоеФайла, "TF_Document_No", "TF_Document_No.");
			
			ТД = Новый ТекстовыйДокумент;
			ТД.УстановитьТекст(СодержимоеФайла);
			
			Если СвойствоXDTO.ЛокальноеИмя = "Balances_on_the_date" Тогда
				ИмяФайла = Каталог + ?(СтрЗаканчиваетсяНа(Каталог, "\"), "", "\") + "542_282_" + СвойствоXDTO.ЛокальноеИмя + "_" + Формат(Период.ДатаОкончания, "ДФ=yyyyMMdd") + "_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HH-mm") + ".xml";
			Иначе
				ИмяФайла = Каталог + ?(СтрЗаканчиваетсяНа(Каталог, "\"), "", "\") + СвойствоXDTO.ЛокальноеИмя + ".xml";
			КонецЕсли;
			
			ТД.Записать(ИмяФайла, КодировкаТекста.UTF8);
			
			Результат.Добавить(ИмяФайла);
			
		КонецЦикла;
		
	Иначе
		
		//ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		ИмяФайла = Каталог + "message" + ?(ПостфиксИмениФайла <> Неопределено, "_" + ПостфиксИмениФайла, "") + ".xml";
		
		ЗаписьXML = Новый ЗаписьXML;
		
		ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
		
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		// заполнение средствами XDTO
		СвойствоXDTO = КорневыеСвойстваXDTO[0];
		ЭлементОбъектаXDTO	= ЗаполнитьКоллекциюСвойствXDTO(СвойствоXDTO);
		
		НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ЭлементОбъектаXDTO, СвойствоXDTO.Имя);
		// **************************
		
		ЗаписьXML.Закрыть();
		
		Результат.Добавить(ИмяФайла);
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьКоллекциюСвойствXDTO(СвойствоXDTO)

	ОбъектXDTO = НоваяФабрикаXDTO.Создать(СвойствоXDTO.Тип);
	
	Для Каждого ЭлементСвойстваXDTO Из СвойствоXDTO.Тип.Свойства Цикл
		//исключение для Ортикон
		Если ЭлементСвойстваXDTO.Имя = "Контрагенты" И ЭлементСвойстваXDTO.Тип.Имя = "anyType" Тогда
			ВыгрузитьДанныеСправочника(ОбъектXDTO[ЭлементСвойстваXDTO.Имя], "ЮрЛицо", ПакетДанных.ЮрЛицо);
			ВыгрузитьДанныеСправочника(ОбъектXDTO[ЭлементСвойстваXDTO.Имя], "ФизЛицо", ПакетДанных.ФизЛицо);
			
		ИначеЕсли РеквизитыВыгрузки.Свойство(ЭлементСвойстваXDTO.Имя) Тогда
			ОбъектXDTO[ЭлементСвойстваXDTO.Имя] = ЗаполнитьРеквизитыВыгрузки(ЭлементСвойстваXDTO);
			
		ИначеЕсли ЭлементСвойстваXDTO.Тип.Имя = "" Тогда
			ЭлементОбъектаXDTO = ЗаполнитьКоллекциюСвойствXDTO(ЭлементСвойстваXDTO);
			
			Если ЭлементСвойстваXDTO.ВерхняяГраница = -1 Тогда
				ОбъектXDTO[ЭлементСвойстваXDTO.Имя].Добавить(ЭлементОбъектаXDTO);
			Иначе
				ОбъектXDTO[ЭлементСвойстваXDTO.Имя] = ЭлементОбъектаXDTO;
			КонецЕсли;
			
		ИначеЕсли ПакетДанных.Свойство(ЭлементСвойстваXDTO.Тип.Имя) Тогда
			ВыгрузитьДанныеСправочника(ОбъектXDTO[ЭлементСвойстваXDTO.Имя], ЭлементСвойстваXDTO.Тип.Имя, ПакетДанных[ЭлементСвойстваXDTO.Тип.Имя]);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбъектXDTO;

КонецФункции

Функция ЗаполнитьРеквизитыВыгрузки(СвойствоXDTO)
	
	ОбъектXDTO = НоваяФабрикаXDTO.Создать(СвойствоXDTO.Тип);
	
	Для Каждого ЭлементСвойстваXDTO Из СвойствоXDTO.Тип.Свойства Цикл
		ОбъектXDTO[ЭлементСвойстваXDTO.Имя] = СериализоватьЗначение(РеквизитыВыгрузки[СвойствоXDTO.Имя][ЭлементСвойстваXDTO.Имя], ЭлементСвойстваXDTO.Тип);
	КонецЦикла;
	
	Возврат ОбъектXDTO;
	
КонецФункции

