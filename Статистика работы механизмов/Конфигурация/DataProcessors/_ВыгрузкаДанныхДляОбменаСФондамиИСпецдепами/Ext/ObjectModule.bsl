		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата >= &ДатаНачала
		|	И ДанныеКалендаря.Дата <= &ДатаОкончания
		|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
		|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК ЭтоСрез,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Период КАК Date,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага КАК FICode,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа КАК SourceCode,
		|	ВТ_РежимыТоргов.Т_Плюс КАК CalculationsType,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта.Код КАК Currency,
		|	КотировкиТорговыхПлощадокСводныеСрезПоследних.*
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(&Период, 
//		|			ЦеннаяБумага В (&МассивЦБ)
		|		) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РежимыТоргов КАК ВТ_РежимыТоргов
		|		ПО КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов = ВТ_РежимыТоргов.РежимТоргов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	КотировкиТорговыхПлощадокСводные.Период КАК Date,
		|	КотировкиТорговыхПлощадокСводные.ЦеннаяБумага КАК FICode,
		|	КотировкиТорговыхПлощадокСводные.Биржа КАК SourceCode,
		|	ВТ_РежимыТоргов.Т_Плюс КАК CalculationsType,
		|	КотировкиТорговыхПлощадокСводные.Валюта.Код КАК Currency,
		|	КотировкиТорговыхПлощадокСводные.*
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадокСводные КАК КотировкиТорговыхПлощадокСводные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РежимыТоргов КАК ВТ_РежимыТоргов
		|		ПО КотировкиТорговыхПлощадокСводные.РежимТоргов = ВТ_РежимыТоргов.РежимТоргов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РабочиеДни КАК РабочиеДни
		|		ПО КотировкиТорговыхПлощадокСводные.Период = РабочиеДни.Дата
		|ГДЕ
		|	&ВыгружатьКотировкиНаКаждыйДень
		|	И КотировкиТорговыхПлощадокСводные.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
//		|	И КотировкиТорговыхПлощадокСводные.ЦеннаяБумага В(&МассивЦБ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Date";

	
	МассивЦБ = Новый Массив;
	Для Каждого СправочникДляВыгрузки Из СписокСправочниковФИ Цикл
		МассивЭлементов = ПолучитьМассивЭлементов(СправочникДляВыгрузки.Ключ);
		Для Каждого ЭлементМассива Из МассивЭлементов Цикл
			МассивЦБ.Добавить(ЭлементМассива);
		КонецЦикла;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ВыгружатьКотировкиНаКаждыйДень"	, ВключатьДанныеВСоставВыгрузки("ВыгружатьКотировкиНаКаждыйДень"));
	Запрос.УстановитьПараметр("ДатаНачала"						, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"					, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Календарь", Константы.ОсновнойКалендарьКотировок.Получить());
	
	Если ВключатьДанныеВСоставВыгрузки("ВыгружатьКотировкиНаКаждыйДень") Тогда
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаНачала);
	Иначе
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если МассивЦБ.Найти(Выборка.FICode) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Ресурс Из МассивРесурсов Цикл
			
			ДатаКотировки = Выборка[Ресурс + "_DATE"];
			ЗначениеКотировки = Выборка[Ресурс];
			
			Если НЕ ЗначениеЗаполнено(ЗначениеКотировки) ИЛИ НЕ ЗначениеЗаполнено(ДатаКотировки) Тогда Продолжить; КонецЕсли;
			
			Если ВключатьДанныеВСоставВыгрузки("ВыгружатьКотировкиНаКаждыйДень") 
				И НЕ Выборка.ЭтоСрез
				И ДатаКотировки <= Выборка.Date Тогда
				Продолжить; // эта котировка уже была!
			КонецЕсли;
			
			СтрокаДанных = Данные.Добавить();
			СтрокаДанных.ExtCode			= Строка(Выборка.FICode.УникальныйИдентификатор()) + Строка(Выборка.SourceCode.УникальныйИдентификатор()) + ?(Выборка.CalculationsType, "0", "1") + Ресурс + Формат(ДатаКотировки, "ДФ=yyyyMMdd"); 
			СтрокаДанных.FICode				= Выборка.FICode;
			СтрокаДанных.Date				= ДатаКотировки;
			СтрокаДанных.SourceCode			= Выборка.SourceCode;
			СтрокаДанных.CalculationsType	= Выборка.CalculationsType;
			СтрокаДанных.QuotKindCode		= Ресурс;
			СтрокаДанных.QuotValue			= ЗначениеКотировки;
			СтрокаДанных.Currency			= Выборка.Currency;
			
		КонецЦикла;
	КонецЦикла;
	
	ДобавитьДанныеВПакет("Котировки,Котировка", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьКупонныеРасписания()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьКупонныеРасписания") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК ЦеннаяБумага,
		|	МИНИМУМ(НАЧАЛОПЕРИОДА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.Партия.Дата, &ДатаНачала), ДЕНЬ)) КАК ДатаПартии
		|ПОМЕСТИТЬ ВТ_ДатыПриобритения
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ДатаНачала,
		|				Организация = &Организация
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага В (&МассивОблигации)) КАК БухПартииЦенныхБумагОстатки
		|		ПО Облигации.Ссылка = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|ГДЕ
		|	Облигации.Ссылка В(&МассивОблигации)
		|
		|СГРУППИРОВАТЬ ПО
		|	Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.Облигация КАК FICode,
		|	КупонныйДоходПоОблигациям.Облигация.ВалютаНоминала.Код КАК CurrencyCode,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК Date,
		|	0 КАК PaymentType,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК Rate,
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК Amount,
		|	"""" КАК Description,
		|	КупонныйДоходПоОблигациям.Период КАК CouponStartDate,
		|	0 КАК Log,
		|	КупонныйДоходПоОблигациям.Период КАК Start_Date,
		|	NULL КАК Ext_Offer_Date
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатыПриобритения КАК ВТ_ДатыПриобритения
		|		ПО КупонныйДоходПоОблигациям.Облигация = ВТ_ДатыПриобритения.ЦеннаяБумага
		|			И КупонныйДоходПоОблигациям.Период >= ВТ_ДатыПриобритения.ДатаПартии
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация В(&МассивОблигации)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УсловияОферт.Облигация,
		|	УсловияОферт.Облигация.ВалютаНоминала.Код,
		|	УсловияОферт.ДатаВыкупа,
		|	1,
		|	УсловияОферт.ЦенаПроцент,
		|	УсловияОферт.Цена,
		|	"""",
		|	NULL,
		|	0,
		|	УсловияОферт.АкцептС,
		|	УсловияОферт.ДатаВыкупа
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатыПриобритения КАК ВТ_ДатыПриобритения
		|		ПО УсловияОферт.Облигация = ВТ_ДатыПриобритения.ЦеннаяБумага
		|			И УсловияОферт.ДатаВыкупа >= ВТ_ДатыПриобритения.ДатаПартии
		|ГДЕ
		|	УсловияОферт.Облигация В(&МассивОблигации)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НоминалыЦенныхБумаг.ЦеннаяБумага,
		|	НоминалыЦенныхБумаг.ЦеннаяБумага.ВалютаНоминала.Код,
		|	НоминалыЦенныхБумаг.Период,
		|	2,
		|	НоминалыЦенныхБумаг.ПроцентОтНачальногоНоминала,
		|	НоминалыЦенныхБумаг.СуммаИзменения,
		|	"""",
		|	NULL,
		|	0,
		|	NULL,
		|	NULL
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатыПриобритения КАК ВТ_ДатыПриобритения
		|		ПО НоминалыЦенныхБумаг.ЦеннаяБумага = ВТ_ДатыПриобритения.ЦеннаяБумага
		|			И НоминалыЦенныхБумаг.Период >= ВТ_ДатыПриобритения.ДатаПартии
		|ГДЕ
		|	НоминалыЦенныхБумаг.ЦеннаяБумага В(&МассивОблигации)";
		
	Запрос.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("МассивОблигации"	, ПолучитьМассивЭлементов("Облигации"));
	
	Попытка Данные = Запрос.Выполнить().Выгрузить(); Исключение Сообщить("Нет доступа:" + Запрос.Текст); КонецПопытки;
	
	Данные.Колонки.Добавить("ExtCode");
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.ExtCode = Строка(СтрокаДанных.FICode.УникальныйИдентификатор()) + Строка(СтрокаДанных.PaymentType) + Формат(СтрокаДанных.Date, "ДФ=yyyyMMdd");
	КонецЦикла;

	ДобавитьДанныеВПакет("КупонныеРасписания,ДенежныйПотокПоОблигации", Данные);
	
КонецПроцедуры

Процедура ВыгрузитьОтрасли()
	
	Если НЕ ВключатьДанныеВСоставВыгрузки("ВыгружатьПрочиеКлассификаторы") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьДанныеВПакет("Отрасли", Новый ТаблицаЗначений);
	
КонецПроцедуры

Процедура ВыгрузитьОперацииСФинансовымиИнструментами()
	
	РаботаСОтчетами.КонтрольМультивалютностиРасходовПоСделкам(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания); 	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Ссылка,
		|	Сделка.ВидСделки КАК ВидСделки
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Сделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Сделка.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.ВидСделки
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СделкаРЕПО.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаСВалютой.Ссылка,
		|	СделкаСВалютой.ВидСделки
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|ГДЕ
		|	СделкаСВалютой.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаСВалютой.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СделкаСВалютой.Проведен
		|	И &ВыгружатьСделкиСВалютой
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сделки.Ссылка КАК Ссылка,
		|	_Сделки.ВидСделки КАК ВидСделки,
		|	_Сделки.Ссылка КАК Регистратор
		|ПОМЕСТИТЬ _ОтборПоПартиям
		|ИЗ
		|	_Сделки КАК _Сделки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Сделки.Ссылка,
		|	_Сделки.ВидСделки,
		|	ИсполнениеОбязательствПоСделке.Ссылка
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО (ИсполнениеОбязательствПоСделке.Основание = _Сделки.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Сделки.Ссылка,
		|	_Сделки.ВидСделки,
		|	ПоставкаЦенныхБумаг.Ссылка
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
		|		ПО (ПоставкаЦенныхБумаг.Основание = _Сделки.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходыПоКомиссии.Сделка КАК Сделка,
		|	РасходыПоКомиссии.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасходыПоКомиссии.Валюта КАК Валюта,
		|	РасходыПоКомиссии.ВидЗадолженности КАК ВидЗадолженности,
		|	РасходыПоКомиссии.СуммаОборот КАК Сумма,
		|	МАКСИМУМ(НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ)) КАК ДатаПоследнийОплаты
		|ПОМЕСТИТЬ _РасходыПоКомиссии
		|ИЗ
		|	РегистрНакопления.РасходыПоСделке.Обороты(
		|			,
		|			,
		|			,
		|			(Организация, СчетДоверительногоУправления, Сделка, ВидЗадолженности) В
		|				(ВЫБРАТЬ
		|					&Организация,
		|					&СчетДоверительногоУправления,
		|					_Сделки.Ссылка,
		|					ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|				ИЗ
		|					_Сделки КАК _Сделки
		|			
		|				ОБЪЕДИНИТЬ ВСЕ
		|			
		|				ВЫБРАТЬ
		|					&Организация,
		|					&СчетДоверительногоУправления,
		|					_Сделки.Ссылка,
