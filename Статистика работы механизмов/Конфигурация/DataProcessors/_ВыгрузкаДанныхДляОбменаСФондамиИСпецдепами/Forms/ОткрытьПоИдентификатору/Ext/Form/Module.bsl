
&НаСервере
Функция ПолучитьСсылку()
	
	ПравильныйИдентификатор = СокрЛП(Сред(ЭтаФорма.Идентификатор, СтрНайти(ЭтаФорма.Идентификатор, "-", НаправлениеПоиска.СНачала, 9) - 8, 36));
	
	Если СтрДлина(ПравильныйИдентификатор) <> 36 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указан некорректный идентификатор");
		Возврат "";
	КонецЕсли;	
	
	Для Каждого ОбъектМД Из Метаданные.Справочники Цикл
		Если Справочники[ОбъектМД.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(ПравильныйИдентификатор)).ПолучитьОбъект() <> Неопределено Тогда
			Возврат Справочники[ОбъектМД.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(ПравильныйИдентификатор));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОбъектМД Из Метаданные.Документы Цикл
		Если Документы[ОбъектМД.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(ПравильныйИдентификатор)).ПолучитьОбъект() <> Неопределено Тогда
			Возврат Документы[ОбъектМД.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(ПравильныйИдентификатор));
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти элемент по идентификатору");
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ОтркытьЗначение(Команда)
	
	НайденнаяСсылка = ПолучитьСсылку();
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		ОткрытьЗначение(НайденнаяСсылка);
	КонецЕсли;
	
КонецПроцедуры
