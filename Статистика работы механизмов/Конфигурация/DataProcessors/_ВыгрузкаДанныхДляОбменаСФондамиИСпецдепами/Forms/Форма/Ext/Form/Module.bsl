
&НаСервере
Процедура ВыгрузитьДанныеНаСервере()
	
	Для Каждого ЭлементСписка Из СписокСчетовДУ Цикл
		Объект.СчетДоверительногоУправления = ЭлементСписка.Значение;
		Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
			ТекущийОбъект = РеквизитФормыВЗначение("Объект");
			ТекущийОбъект.ВыгрузитьДанные();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьФайлНаСервере()
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущийОбъект.АвтоматическоеФормирование(ЭтаФорма.НастройкиОтчета);
	Если НастройкиОтчета.Свойство("Результат") Тогда
		РаботаСОтчетами.ОтправитьОтчет(ЭтаФорма.НастройкиОтчета, ЭтаФорма.НастройкиОтчета.Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДанные(Команда)
	
	Если СписокСчетовДУ.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано не одного счета ДУ!");
		Возврат;
	КонецЕсли;
	
	Объект.ДополнительныеПараметрыВыгрузки = Новый Структура;
	
	Если Объект.Период.ДатаОкончания = Дата(2016, 12, 31, 23, 59, 59)
		ИЛИ Объект.ПринудительноВыгрузитьНачальныеОстатки Тогда
		Если Вопрос("Выгрузить остатки по бухгалтерии в виде проводок с 000 счетом?", РежимДиалогаВопрос.ДаНет, 60) = КодВозвратаДиалога.Да Тогда
			Объект.ДополнительныеПараметрыВыгрузки.Вставить("ВыгрузитьОстаткиПоБухгалтерииВВидеПроводокС000Счетом", Истина);
		КонецЕсли;
	КонецЕсли;
		
	
	ВыгрузитьДанныеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогДанных + "\");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
    РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
				
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);
	
	Объект.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСчетовДУОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = СписокСчетовДУ.НайтиПоЗначению(ВыбранноеЗначение) = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоИдентификатору(Команда)
	
	ОткрытьФорму("ВнешняяОбработка._ВыгрузкаДанныхДляОбменаСФондамиИСпецдепами.Форма.ОткрытьПоИдентификатору");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
