<xs:schema xmlns:tns="NAPFEXCHANGE_AVANCORE" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="NAPFEXCHANGE_AVANCORE" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:element name="Сообщение">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Заголовок">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="FileVersion" type="xs:string" minOccurs="0"/>
							<xs:element name="CompanyName" type="xs:string"/>
							<xs:element name="CompanyINN" type="xs:decimal" minOccurs="0"/>
							<xs:element name="CompanyKPP" type="xs:decimal" minOccurs="0"/>
							<xs:element name="AgreementNo" type="xs:string" minOccurs="0"/>
							<xs:element name="ClientName" type="xs:string"/>
							<xs:element name="ClientINN" type="xs:string" minOccurs="0"/>
							<xs:element name="ClientKPP" type="xs:string" minOccurs="0"/>
							<xs:element name="DateCreate" type="xs:date" minOccurs="0"/>
							<xs:element name="DateStart" type="xs:date"/>
							<xs:element name="DateEnd" type="xs:date"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="УправляющаяКомпания">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ExtCode" type="xs:string"/>
							<xs:element name="ShortName" type="xs:string"/>
							<xs:element name="Name" type="xs:string"/>
							<xs:element name="INN" type="xs:string"/>
							<xs:element name="KPP" type="xs:string"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="СправочнаяИнформация" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ДоговорыДУ">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ДоговорДУ" type="tns:ДоговорДУ" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ВидыФИ" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ВидФИ" type="tns:ВидФИ" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ФинансовыеИнструменты" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ФинансовыйИнструмент" type="tns:ФинансовыйИнструмент" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ТорговыеПлощадки" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ТорговаяПлощадка" type="tns:ТорговаяПлощадка" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Контрагенты" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Контрагент" type="tns:Контрагент" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ДоговорыКонтрагентов" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ДоговорКонтрагента" type="tns:ДоговорКонтрагента" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="БанковскиеСчета" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="БанковскийСчет" type="tns:БанковскийСчет" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="БрокерскиеСчета" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="БрокерскийСчет" type="tns:БрокерскийСчет" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="СделкиТорговыеФИ" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Сделка" type="tns:СделкаТорговыеФИ" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="НеторговыеОперации" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ВидыОпераций" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ВидОперации" type="tns:ВидОперации" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Операции" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Операция" type="tns:Операция" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ДанныеДляРасчетов" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ВидыКотировок" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ВидКотировки" type="tns:ВидКотировки" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Котировки" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Котировка" type="tns:Котировка" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="КупонныеРасписания" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Выплата" type="tns:ДенежныйПотокПоОблигации" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ГрафикиДенежногоПотока" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Выплата" type="tns:ДенежныйПотокПрочим" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="СправедливыеСтоимости" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="СправедливаяСтоимость" type="tns:СправедливаяСтоимость" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="АмортизированныеСтоимости" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="АмортизированнаяСтоимость" type="tns:АмортизированнаяСтоимость" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ДанныеПоКредитнымРейтингам" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="РейтинговыеАгентства" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="РейтинговоеАгентство" type="tns:РейтинговоеАгентство" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ШкалыРейтингов" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ШкалаРейтинга" type="tns:ШкалаРейтинга" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ЗначенияРейтингов" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Рейтинг" type="tns:Рейтинг" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ЗначенияПрогнозовРейтингов" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ПрогнозныйРейтинг" type="tns:ПрогнозныйРейтинг" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="РейтингиФИ" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="РейтингФИ" type="tns:РейтингФИ" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="РейтингиКонтрагентов" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="РейтингКонтрагента" type="tns:РейтингКонтрагента" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="РейтингиБанков" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="РейтингБанка" type="tns:РейтингБанка" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ПрочиеКлассификаторы" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ИсторияОбъемовВыпуска" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ИзменениеОбъемаВыпуска" type="tns:ИзменениОбъемаВыпуска" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ИсторияПризнанияОРЦБ" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ПризнаниеОРЦБ" type="tns:ПризнаниеОРЦБ" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ИсторияВключенияВТорги" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ВключениеВТорги" type="tns:ВключениеВТорги" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Отрасли" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Отрасль" type="tns:Отрасли" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ДанныеБухгалтерскогоУчета" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Проводки" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="БухПроводка" type="tns:БухПроводка" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Аналитика" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="АналитичПризнакиСчетов" type="tns:АналитичПризнакиСчетов" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="АмортизированнаяСтоимость">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="TrustAgrCode" type="xs:string"/>
			<xs:element name="ExtTradeCode" type="xs:string"/>
			<xs:element name="FICode" type="xs:string"/>
			<xs:element name="Date" type="xs:date"/>
			<xs:element name="EffectiveInterestRate" type="xs:decimal"/>
			<xs:element name="AmortizedCost" type="xs:decimal" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="АналитичПризнакиСчетов">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="AccountNo" type="xs:string"/>
			<xs:element name="SubcountCode" type="xs:string"/>
			<xs:element name="SubcObjectName" type="xs:string"/>
			<xs:element name="SubcOrder">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
						<xs:enumeration value="3"/>
						<xs:enumeration value="4"/>
						<xs:enumeration value="5"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SubcPositionBegin" type="xs:integer" minOccurs="0"/>
			<xs:element name="SubcPositionEnd" type="xs:integer" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="БанковскийСчет">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="AccKindCode" type="xs:integer"/>
			<xs:element name="BIC" type="xs:string"/>
			<xs:element name="AccountNo" type="xs:string"/>
			<xs:element name="CurrencyCode" type="xs:string"/>
			<xs:element name="OpeningDate" type="xs:date"/>
			<xs:element name="ClosingDate" type="xs:date" minOccurs="0"/>
			<xs:element name="ContractorCode" type="xs:string" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="БрокерскийСчет">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="AccountNo" type="xs:string"/>
			<xs:element name="CurrencyCode" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OpeningDate" type="xs:date"/>
			<xs:element name="ClosingDate" type="xs:date" minOccurs="0"/>
			<xs:element name="ContractorCode" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="БухПроводка">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="TransDate" type="xs:date"/>
			<xs:element name="DocumDate" type="xs:date" minOccurs="0"/>
			<xs:element name="Amount" type="xs:decimal"/>
			<xs:element name="AccDebit">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="5"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AccCredit">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="5"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SymbSFPDebit" type="xs:string" minOccurs="0"/>
			<xs:element name="SymbSFPCredit" type="xs:string" minOccurs="0"/>
			<xs:element name="LedgerAccDebit" type="xs:string"/>
			<xs:element name="LedgerAccCredit" type="xs:string"/>
			<xs:element name="Description" type="xs:string"/>
			<xs:element name="DocumentNo" type="xs:string"/>
			<xs:element name="OperTypeCode" type="xs:string"/>
			<xs:element name="CurrRateDebit" type="xs:decimal" minOccurs="0"/>
			<xs:element name="CurrRateCredit" type="xs:decimal" minOccurs="0"/>
			<xs:element name="FiscalAccDate" type="xs:date" minOccurs="0"/>
			<xs:element name="FiscalAccAmount" type="xs:decimal" minOccurs="0"/>
			<xs:element name="TemporTaxDiffer" type="xs:decimal" minOccurs="0"/>
			<xs:element name="SubcDebit1" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcDebit2" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcDebit3" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcDebit4" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcDebit5" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcCredit1" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcCredit2" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcCredit3" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcCredit4" type="xs:string" minOccurs="0"/>
			<xs:element name="SubcCredit5" type="xs:string" minOccurs="0"/>
			<xs:element name="QuantityDebit" type="xs:decimal" minOccurs="0"/>
			<xs:element name="QuantityCredit" type="xs:decimal" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВидКотировки">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="Name" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВидОперации">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="ParentGroup" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВидФИ">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="ParentGroup" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВключениеВТорги">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="FICode" type="xs:string"/>
			<xs:element name="TradingFlCode" type="xs:string"/>
			<xs:element name="InDate" type="xs:date"/>
			<xs:element name="OutDate" type="xs:date"/>
			<xs:element name="QuotLevel">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
						<xs:enumeration value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ДенежныйПотокПоОблигации">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="FICode" type="xs:string"/>
			<xs:element name="CurrencyCode">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Date" type="xs:date"/>
			<xs:element name="PaymentType">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="0"/>
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Rate" type="xs:decimal"/>
			<xs:element name="Amount" type="xs:decimal"/>
			<xs:element name="Description" type="xs:decimal" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ДенежныйПотокПрочим">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="FICode" type="xs:string"/>
			<xs:element name="RateType">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="0"/>
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Rate" type="xs:decimal"/>
			<xs:element name="StartDate" type="xs:date"/>
			<xs:element name="ExpireDate" type="xs:date"/>
			<xs:element name="PaymentType">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:enumeration value="0"/>
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Amount" type="xs:decimal"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ДоговорДУ">
		<xs:sequence>
			<xs:element name="ExtCode" type="xs:string"/>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="UKCode" type="xs:string"/>
			<xs:element name="ExtFundCode" type="xs:string" minOccurs="0"/>
			<xs:element name="FundName" type="xs:string" minOccurs="0"/>
			<xs:element name="FundsKind" minOccurs="0">
				<xs:simpleType>
