<xs:schema xmlns:tns="NFONAPFEXCHANGE_DOM" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="NFONAPFEXCHANGE_DOM" attributeFormDefault="unqualified" elementFormDefault="qualified">
