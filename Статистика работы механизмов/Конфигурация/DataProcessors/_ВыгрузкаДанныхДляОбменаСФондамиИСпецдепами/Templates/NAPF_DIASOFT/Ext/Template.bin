<xs:schema xmlns:tns="NFONAPFDIASOFT" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="NFONAPFDIASOFT" attributeFormDefault="unqualified" elementFormDefault="qualified">
