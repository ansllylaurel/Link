				<xs:element name="РейтинговыеАгентства" type="tns:РейтинговыеАгентства" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="СделкиТорговыеФИ" type="tns:СделкиТорговыеФИ" minOccurs="0" maxOccurs="unbounded"/>
