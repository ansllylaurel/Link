Функция ПолучитьДанныеКлиентов()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(ЭтотОбъект.Организация), ЭтотОбъект.Организация, ПараметрыСеанса.ТекущаяОрганизация));
	
	ПолучитьСчетаДоверительногоУправления(Запрос);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail КАК EMail,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	КлиентыИСчета.Клиент КАК Клиент,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	_КлиентыИСчета КАК КлиентыИСчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаСреза,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыИСчета.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаСреза,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО КлиентыИСчета.Клиент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	
	РезультЗапроса = Запрос.Выполнить();
	
	Возврат РезультЗапроса;	

