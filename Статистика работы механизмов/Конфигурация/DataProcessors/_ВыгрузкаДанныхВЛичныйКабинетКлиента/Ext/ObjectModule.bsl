// Интерфейс для запуска отложенных заданий
Процедура ВыполнитьМетод(Команда, Экземпляры) Экспорт
	
	Перем Адресаты;
	
	Ошибки 		= Новый Массив;
		
	ПриВыполненииВозниклиОшибки = Ложь;
	
	Для Каждого Экземпляр Из Экземпляры Цикл
		
		ПараметрыКоманды = Экземпляр.Параметры;
		
		// Обрабатываем только известные команды
		Если НЕ СтрНачинаетсяС(Команда, "ОтправкаДанныхИИСВЛКК") Тогда  		
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Неизвестный метод """ + Команда + """");
		КонецЕсли;
		
		// Заполним параметры команды	
		ЭтотОбъект.Период.ДатаОкончания = КонецДня(ПараметрыКоманды.Период);
		ЭтотОбъект.Период.ДатаНачала	= НачалоДня(ПараметрыКоманды.Период);
		ЭтотОбъект.Сервер 				= "ap54.G1.LAN";
		ЭтотОбъект.ПередатьВсехКлиентов	= Истина;
		
		ЭтотОбъект.Организация			= ПараметрыКоманды.Организация;
		
		//Проверим, что все ИИС закрыты
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
					Период.ДатаОкончания, 
					Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
							ЭтотОбъект.Организация,
							Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), 
					Истина, 
					, 
					МенеджерВременныхТаблиц
				    );

		ПриВыполненииВозниклиОшибки = РаботаСОтчетами.ЕстьДатыЗапретаРедактированияСчетовДоверительногоУправленияДоДатыПроверки(
							МенеджерВременныхТаблиц, 
							ЭтотОбъект.Период.ДатаОкончания, 
							ЭтотОбъект.Организация, 
							Перечисления.ГруппыЗапретаРедактирования.БэкОфис, 
							, 
							"_ДействующиеСчетаДоверительногоУправления");
		
		// Формируем отчет
		Если Не ПриВыполненииВозниклиОшибки Тогда
			ПриВыполненииВозниклиОшибки = Не ПередатьДанныеВЛичныйКабинетКлиента();		
		КонецЕсли;
		
		// Если были ошибки, сохраняем их
		Если ПриВыполненииВозниклиОшибки И Ошибки.Количество() > 0 Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Ошибки, ПараметрыКоманды.ДополнительнаяОбработкаСсылка);
		КонецЕсли;
				
		// Фиксируем успешное выполнение задания.
		РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Экземпляр.Идентификатор);
		
		Если ПриВыполненииВозниклиОшибки Тогда
			
			// После 16-00 оповещаем пользователей
			ТекДата = ТекущаяДатаСеанса();
			Если ТекДата > НачалоДня(ТекДата) + 16 * 60 * 60 Тогда
				
				РеквизитыОповещения = Новый Структура();								
				РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
				РеквизитыОповещения.Вставить("Дата",		Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
				РеквизитыОповещения.Вставить("Тема",		"Не выгружены данные по ИИС в ЛКК за " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
				РеквизитыОповещения.Вставить("Текст", 		"Данные в ЛКК не выгружены: не по всем договорам ИИС проведены регламентные операции за " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
											
				Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
			КонецЕсли;
			
			// Создаем новое задание на полчаса позже, если такого задания нет
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Организация", 	ЭтотОбъект.Организация);
			ПараметрыЗадания.Вставить("Объект",			ПараметрыКоманды.ДополнительнаяОбработкаСсылка);
			ПараметрыЗадания.Вставить("Состояния",		Перечисления.СостоянияОтложенныхЗаданий.Ожидание);
			ПараметрыЗадания.Вставить("Команда", 		"ОтправкаДанныхИИСВЛКК");
			
			Если РегистрыСведений.ОтложенныеЗадания.ЕстьОтложенноеЗадание(ТекДата, ТекДата, ПараметрыЗадания) Тогда
				Возврат;
			КонецЕсли;
		
			Параметры = Новый Структура("Организация, Период", ЭтотОбъект.Организация, НачалоДня(ЭтотОбъект.Период.ДатаОкончания));		
					
			Параметры.Вставить("ИсточникОшибки", 				"Выгрузка данных в личный кабинет клиента");  							
			Параметры.Вставить("ТекстОшибки",					"Не удалось добавить отложенное задание 'Выгрузка данных в личный кабинет клиента'.");  
			Параметры.Вставить("ДополнительнаяОбработкаСсылка", ПараметрыКоманды.ДополнительнаяОбработкаСсылка);
							
			РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ПараметрыКоманды.ДополнительнаяОбработкаСсылка, "ОтправкаДанныхИИСВЛКК", Параметры, 15, Истина, ТекДата + 1800);

		Иначе
			
			// Оповещение об успешной выгрузке
			РеквизитыОповещения = Новый Структура();								
			РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
			РеквизитыОповещения.Вставить("Дата",		Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("Тема",		"Успешно выгружены данные по ИИС в ЛКК за " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("Текст", 		"Данные по ИИС в ЛКК выгружены успешно");
										
			Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры // ВыполнитьМетод

