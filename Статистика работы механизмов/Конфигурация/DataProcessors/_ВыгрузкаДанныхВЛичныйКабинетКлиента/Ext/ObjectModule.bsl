Функция ЗаписатьДанныеКлиентов(ДанныеДляЗаполнения)
	
	Ответ = "";
	СообщениеОбОшибках = "";
	ДанныеПоФЗ = ДанныеДляЗаполнения.Выгрузить();
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение("Provider=SQLOLEDB;Server=" + ЭтотОбъект.Сервер + ";UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=AMY");
	

	Если Соединение <> Неопределено Тогда
		Command_usp_Users_1C_Load = РаботаСВнешнимиСистемами.ADODBC_ПолучитьКомандуОбращенияКХранимойПроцедуре(Соединение, "usp_Users_1C_Load");
		Параметр = Command_usp_Users_1C_Load.CreateParameter("@x", 202, 1, -1, "");
		Command_usp_Users_1C_Load.Parameters.Append(Параметр);
		
		// записать данные всех клиентов
		
		Для каждого СтрокаФЗ Из ДанныеПоФЗ Цикл
			
			Телефон = ПреобразоватьТелефон(СтрокаФЗ.Телефоны);
			ДлинаТелефона = СтрДлина(Телефон);
			Если ДлинаТелефона < 2 Тогда
				СообщениеОбОшибках = СообщениеОбОшибках + СтрШаблон("У клиента %1 не заполнен телефон", СтрокаФЗ.Клиент) + Символы.ПС;
				Продолжить;
			Иначе
				Если ДлинаТелефона <> 11 Тогда
					СообщениеОбОшибках = СообщениеОбОшибках + СтрШаблон("У клиента %1 неправильно указан телефон %2", СтрокаФЗ.Клиент, СтрокаФЗ.Телефоны) + Символы.ПС;
					Продолжить;
				КонецЕсли; 
			КонецЕсли; 
			
			ЗаписьXML=Новый ЗаписьXML(); 
			ЗаписьXML.УстановитьСтроку(); 
			ЗаписьXML.ЗаписатьНачалоЭлемента("Users"); 
			ЗаписьXML.ЗаписатьНачалоЭлемента("User"); 
			ЗаписатьXML(ЗаписьXML,СтрокаФЗ.Код, "Matrix_ID"); 
			ЗаписатьXML(ЗаписьXML,ПреобразоватьТелефон(СтрокаФЗ.Телефоны), "Phone"); 
			ЗаписатьXML(ЗаписьXML,СтрокаФЗ.EMail, "EMail"); 
			ЗаписьXML.ЗаписатьКонецЭлемента();	
			ЗаписьXML.ЗаписатьКонецЭлемента();	
			ТекстXML = ЗаписьXML.Закрыть(); 
			
			Параметр.Value = ТекстXML;
			Попытка
				Command_usp_Users_1C_Load.Execute();
			Исключение
				Ответ = "Данные записаны с ошибками";
				ЗаписьЖурналаРегистрации("Обмен ЛКК",,,,"Ошибка записи клиента с ID " + СтрокаФЗ.Код + " по причине " + ОписаниеОшибки() + ", @x = " + ТекстXML +  ", тип @x = " + ТипЗнч(ТекстXML)); 
