Функция ПередатьДанныеВЛичныйКабинетКлиента(Сообщать = Ложь) Экспорт
	
	// Организуем сбор статистики
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, Период, Сервер");
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьМетод()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание
	);

	Ответ = ВыгрузитьКлиентов();
	
	ДатаНачала    = ЭтотОбъект.Период.ДатаНачала;
	ДатаОкончания = ЭтотОбъект.Период.ДатаОкончания;
	
	ВсеДниВыгружены = Истина;
	Пока ДатаНачала <= ДатаОкончания Цикл
		Ответ = Выгрузить(ДатаНачала, КонецДня(ДатаНачала));
		
		ВсеДниВыгружены = ?(Ответ <> "Данные записаны успешно", Ложь, ВсеДниВыгружены);
		
		Если Сообщать Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Ответ);
		КонецЕсли;
		
		ДатаНачала = ДатаНачала + 86400;
	КонецЦикла; 
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ВсеДниВыгружены;
	
КонецФункции

Функция Выгрузить(ДатаНачала, ДатаОкончанияДень) Экспорт
	
	ДанныеДляЗаполнения = ПолучитьДанныеДляЗаполнения(ДатаНачала, ДатаОкончанияДень);
	
	Возврат ЗаписатьДанные(ДанныеДляЗаполнения, ДатаНачала, ДатаОкончанияДень);
	
КонецФункции	

Функция ВыгрузитьКлиентов() Экспорт
	
	ДанныеДляЗаполнения = ПолучитьДанныеКлиентов();
	
	Возврат ЗаписатьДанныеКлиентов(ДанныеДляЗаполнения);
	
КонецФункции


Процедура ПолучитьСчетаДоверительногоУправления(Запрос)
	
	Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КлиентыИСчета
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаСреза,
		|			СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|				И СчетДоверительногоУправления.Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения > &ДатаСреза
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	
	Если Не ЭтотОбъект.ПередатьВсехКлиентов Тогда
		Текст = СтрЗаменить(Текст, "ИндивидуальныйИнвестиционныйСчет)", "ИндивидуальныйИнвестиционныйСчет) И Клиент В (&Клиенты)"); 	
		Запрос.УстановитьПараметр("Клиенты", Клиенты.ВыгрузитьКолонку("Клиент"));
	КонецЕсли; 
	
	Запрос.Текст = Текст;
	
	Запрос.Выполнить();
	
КонецПроцедуры // ПолучитьСчетаДоверительногоУправления

Функция ПолучитьДанныеДляЗаполнения(ДатаНачала, ДатаОкончанияДень)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаСреза", ДатаОкончанияДень);
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ДатаОкончанияДень);
	Запрос.УстановитьПараметр("КонецПериодаНачалоДня", НачалоДня(ДатаОкончанияДень));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	МассивАктивов = Новый Массив;
	МассивАктивов.Добавить(Перечисления.ВидыАктивов.ДебиторскаяЗадолженность);
	МассивАктивов.Добавить(Перечисления.ВидыАктивов.ДенежныеСредства);
	Запрос.УстановитьПараметр("МассивАктивов", МассивАктивов);
	
	ПолучитьСчетаДоверительногоУправления(Запрос);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыИСчета.Клиент КАК Клиент,
		|	КлиентыИСчета.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	КлиентыИСчета.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Наименование КАК Стратегия,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК Отчество,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК ДатаРождения,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности.Наименование КАК ВидДокумента,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаОкончанияДействияУдостоверенияЛичности КАК ДатаОкончанияДействияУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.РезидентРФ КАК РезидентРФ,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство КАК Гражданство,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СНИЛС КАК СНИЛС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.МестоРождения КАК МестоРождения,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрации КАК АдресРегистрации,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресМестаЖительства КАК АдресМестаЖительства,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ПочтовыйАдрес КАК ПочтовыйАдрес,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail КАК EMail,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрацииФИАС КАК АдресРегистрацииФИАС,
