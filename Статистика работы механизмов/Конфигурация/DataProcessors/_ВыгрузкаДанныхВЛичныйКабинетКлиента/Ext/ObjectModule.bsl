Функция ПреобразоватьТелефон(Телефон)
	
	ПравильныйФорматТелефона = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Телефон, " ", ""), "+", ""), "-", ""), "(", ""), ")", "");
	Если Лев(ПравильныйФорматТелефона, 1) = "8" Тогда
		ПравильныйФорматТелефона = "7" + Прав(ПравильныйФорматТелефона, СтрДлина(ПравильныйФорматТелефона) - 1);
	КонецЕсли; 
	Если СтрДлина(ПравильныйФорматТелефона) < 11 Тогда
		ПравильныйФорматТелефона = "7" + ПравильныйФорматТелефона;	
	КонецЕсли;	
	
	Возврат ПравильныйФорматТелефона;
	
КонецФункции // ПреобразоватьТелефон()
