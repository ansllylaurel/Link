
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Обслуживание информационной базы",
		"1.09a",
		"",
		Истина);
		
	// команды
	
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ОчисткаХранилищаЗначений", "Очистка хранилища значений",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ОбновлениеИсторииДанных", "Обновление истории данных",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"УстановкаМаксимальногоПериодаИПолныйПересчетИтогов", "Установка максимального периода и полный пересчет итогов",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПолныйПересчетИтогов", "Полный пересчет итогов",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПересчетТекущихИтогов", "Пересчет текущих итогов",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"УстановкаМаксимальногоПериодаРассчитанныхИтогов", "Установка максимального периода рассчитанных итогов",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ФормированиеЗадачПоОшибкамЖурналаРегистрации", "Формирование задач по ошибкам журнала регистрации",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПроверкаНаличияРезервныхКопийБазДанныхЗаСегодня", "Проверка наличия резервных копий баз данных за сегодня",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"УдалениеСтарыхВременныхФайлов", "Удаление старых временных файлов",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПометитьНаУдалениеЛицевыеБезСсылок", "Пометить на удаление элементы справочника лицевых счетов на которых нет ссылок",, Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПроверкаНаличияЗависшихСессийРаботыВнутреннихМеханизмов", "Проверка наличия зависших сессий работы внутренних механизмов",, Ложь, "ВызовСерверногоМетода");

	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"ПереносСтатистикиСтарше90ДнейВАрхив", "Перенос статистики страше 90 дней в архив",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().Имя + "." + ИдентификаторКоманды;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	ДанныеДляСтатистики = Неопределено;
	ОписаниеОшибок = "";
	
	Если ИдентификаторКоманды = "ОчисткаХранилищаЗначений" Тогда
		
		ВыполнитьКомандуОчисткаХранилищаЗначений();
		
	ИначеЕсли ИдентификаторКоманды = "ОбновлениеИсторииДанных" Тогда
		
		ВыполнитьКомандуОбновлениеИсторииДанных();
		
	ИначеЕсли ИдентификаторКоманды = "ПолныйПересчетИтогов" 
			Или ИдентификаторКоманды = "ПересчетТекущихИтогов" 
			Или ИдентификаторКоманды = "УстановкаМаксимальногоПериодаРассчитанныхИтогов"
	Тогда
	
		ВыполнитьПересчетИтогов(ИдентификаторКоманды);
		
	ИначеЕсли ИдентификаторКоманды = "УстановкаМаксимальногоПериодаИПолныйПересчетИтогов" Тогда
		
		ВыполнитьПересчетИтогов("УстановкаМаксимальногоПериодаРассчитанныхИтогов");
		ВыполнитьПересчетИтогов("ПолныйПересчетИтогов");
		
	ИначеЕсли ИдентификаторКоманды = "ФормированиеЗадачПоОшибкамЖурналаРегистрации" Тогда
		
		ВыполнитьКомандуФормированиеЗадачПоОшибкамЖурналаРегистрации();
		
	ИначеЕсли ИдентификаторКоманды = "ПроверкаНаличияРезервныхКопийБазДанныхЗаСегодня" Тогда
		
		ВыполнитьПроверкаНаличияРезервныхКопийБазДанныхЗаСегодня(ДанныеДляСтатистики);
		
	ИначеЕсли ИдентификаторКоманды = "УдалениеСтарыхВременныхФайлов" Тогда
		
		УдалениеСтарыхВременныхФайлов();
		
	ИначеЕсли ИдентификаторКоманды = "ПометитьНаУдалениеЛицевыеБезСсылок" Тогда
		
		ПометитьНаУдалениеЛицевыеБезСсылок();
		
	ИначеЕсли ИдентификаторКоманды = "ПроверкаНаличияЗависшихСессийРаботыВнутреннихМеханизмов" Тогда
		
		ПроверитьНаличиеЗависшихСессийРаботыВнутреннихМеханизмов();
		
	ИначеЕсли ИдентификаторКоманды = "ПереносСтатистикиСтарше90ДнейВАрхив" Тогда
		
		ПеренестиСтатистикуСтраше90ДнейВАрхив(ДанныеДляСтатистики);
		
	Иначе
		
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось определить действие для команды " + ИдентификаторКоманды, ЭтотОбъект.Метаданные().Имя + ".ВыполнитьКоманду()");	
		
	КонецЕсли; 
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДанныеДляСтатистики);
	
КонецПроцедуры

Процедура ВыполнитьКомандуОчисткаХранилищаЗначений()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСоздания", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -3));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	НЕ ХранилищеЗначений.НеУдалять
		|	И ХранилищеЗначений.ДатаСоздания < &ДатаСоздания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ХранилищеЗначений.СоздатьНаборЗаписей();
		Набор.Отбор.Идентификатор.Установить(Выборка.Идентификатор);
		Набор.Записать();
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();

КонецПроцедуры

Процедура ВыполнитьКомандуОбновлениеИсторииДанных()
	
	ИсторияДанных.ОбновитьИсторию();
	
КонецПроцедуры

Процедура ВыполнитьПересчетИтогов(ИдентификаторКоманды)
	
	Если ИдентификаторКоманды = "УстановкаМаксимальногоПериодаРассчитанныхИтогов" Тогда
		МаксимальныйПериодРассчитанныхИтогов = НачалоМесяца(ТекущаяДата()) - 1;
	КонецЕсли;
	
	ОбъектыРегистров = СтрРазделить("РегистрыНакопления,РегистрыБухгалтерии", ",", Ложь);
	ОшибкиВыполнения = Новый Массив;
	
	Для каждого ИмяКоллекции Из ОбъектыРегистров Цикл
	
		Для каждого МетаданныеРегистра Из Метаданные[ИмяКоллекции] Цикл
			
			Механизм = "_ОбслуживаниеИнформационнойБазы." + ИдентификаторКоманды;
			Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, , МетаданныеРегистра.ПолноеИмя());
			
			Если ИмяКоллекции = "РегистрыБухгалтерии" Тогда
				МенеджерРегистра = РегистрыБухгалтерии[МетаданныеРегистра.Имя];
			Иначе
				МенеджерРегистра = РегистрыНакопления[МетаданныеРегистра.Имя];
			КонецЕсли;
			
			Попытка
				
				Если ИмяКоллекции = "РегистрыБухгалтерии" Или МетаданныеРегистра.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
				
					Если ИдентификаторКоманды = "УстановкаМаксимальногоПериодаРассчитанныхИтогов" И МенеджерРегистра.ПолучитьМаксимальныйПериодРассчитанныхИтогов() <> МаксимальныйПериодРассчитанныхИтогов Тогда
						МенеджерРегистра.УстановитьМаксимальныйПериодРассчитанныхИтогов(МаксимальныйПериодРассчитанныхИтогов);
					ИначеЕсли ИдентификаторКоманды = "ПересчетТекущихИтогов" Тогда
						МенеджерРегистра.ПересчитатьТекущиеИтоги();
					КонецЕсли; 
				
				КонецЕсли; 
				
				Если ИдентификаторКоманды = "ПолныйПересчетИтогов" Тогда
					МенеджерРегистра.ПересчитатьИтоги();
				КонецЕсли;
				
			Исключение
				ОшибкиВыполнения.Добавить(МетаданныеРегистра.Имя);
			КонецПопытки;
							
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
			
		КонецЦикла;
	
	КонецЦикла;
	
	Если ОшибкиВыполнения.Количество() > 0 Тогда
		
		ТекстЗадачи	= "Не удалось выполнить операцию '" + ИдентификаторКоманды + "' по регистрам: " + Символы.ПС + СтрСоединить(ОшибкиВыполнения, ";" + Символы.ПС);
		
		НоваяЗадача = Задачи.ОшибкиРегламентыхЗаданий.СоздатьЗадачу();
		НоваяЗадача.Дата 				= ТекущаяДата();
		НоваяЗадача.Наименование 		= "Обслуживание информационной базы завершено с ошибками";
		НоваяЗадача.ТекстЗадачи 		= ТекстЗадачи;
		НоваяЗадача.Источник 			= "Обработка._ОбслуживаниеИнформационнойБазы.ВыполнитьПересчетИтогов()";
		НоваяЗадача.ГруппаПользователей	= Справочники.ГруппыПользователей.ВсеПользователи;
		НоваяЗадача.Записать();
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ВыполнитьКомандуФормированиеЗадачПоОшибкамЖурналаРегистрации()

	// Выгружаем ошибки
	ЖурналРегистрации = Новый ТаблицаЗначений;
	Отбор = Новый Структура("ДатаНачала, Уровень", НачалоДня(ТекущаяДата()), УровеньЖурналаРегистрации.Ошибка);
	Колонки = "Дата, ПредставлениеСобытия, Комментарий, ИмяПользователя, Данные";
	
	ВыгрузитьЖурналРегистрации(ЖурналРегистрации, Отбор, Колонки);
	
	РаботаСколлекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЖурналРегистрации, "Дата", Новый ОписаниеТипов("Дата"));
	РаботаСколлекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЖурналРегистрации, "ПредставлениеСобытия", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	РаботаСколлекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЖурналРегистрации, "Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));
	РаботаСколлекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЖурналРегистрации, "ИмяПользователя", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
	РаботаСколлекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ЖурналРегистрации, "Данные", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
	
	// Добавляем ошибки доступа
	ОшибкиДоступа = Новый ТаблицаЗначений;
	Отбор = Новый Структура("ДатаНачала, Событие", НачалоДня(ТекущаяДата()), "_$Access$_.AccessDenied");
	Колонки = "Дата, ПредставлениеСобытия, Метаданные, ИмяПользователя";

	ВыгрузитьЖурналРегистрации(ОшибкиДоступа, Отбор, Колонки);
	
	Для каждого Строка Из ОшибкиДоступа Цикл
	
		НоваяСтрока = ЖурналРегистрации.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если ТипЗнч(Строка.Метаданные) = Тип("Массив") Тогда
			
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Строка.Метаданные);
			Список.СортироватьПоЗначению();
			НоваяСтрока.Комментарий = СтрСоединить(Список.ВыгрузитьЗначения(), "; ");
			
		Иначе
			
			НоваяСтрока.Комментарий = Строка.Метаданные;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	НеРегистрируемыеСобытия = Новый Массив;
	НеРегистрируемыеСобытия.Добавить("Информационная база. Ошибка изменения конфигурации базы данных");

	ШаблоныИсключений = Новый ТаблицаЗначений;
	ШаблоныИсключений.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1024)));

	ШаблоныИсключений.Добавить().Шаблон = "%ВнешняяОбработка.КонсольЗапросов%";
	ШаблоныИсключений.Добавить().Шаблон = "%ВнешняяОбработка.QueryWizard%";
	ШаблоныИсключений.Добавить().Шаблон = "%Невозможно применить фиксированные настройки. Пересекаются элементы отбора%";
	ШаблоныИсключений.Добавить().Шаблон = "%Слишком сложный поисковый запрос%";
	ШаблоныИсключений.Добавить().Шаблон = "%Обработка.ФормированиеБухгалтерскогоУчета.МодульОбъекта(18)%";

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ШаблоныИсключений.Шаблон КАК Шаблон
		|ПОМЕСТИТЬ _ШаблоныИсключений
		|ИЗ
		|	&ШаблоныИсключений КАК ШаблоныИсключений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналРегистрации.Дата КАК Дата,
		|	ЖурналРегистрации.ПредставлениеСобытия КАК ПредставлениеСобытия,
		|	ЖурналРегистрации.Комментарий КАК Комментарий,
		|	ЖурналРегистрации.ИмяПользователя КАК Пользователь,
		|	ЖурналРегистрации.Данные КАК Данные
		|ПОМЕСТИТЬ _ЖурналРегистрацииВрем
		|ИЗ
		|	&ЖурналРегистрации КАК ЖурналРегистрации
		|ГДЕ
		|	НЕ ЖурналРегистрации.ПредставлениеСобытия В (&НеРегистрируемыеСобытия)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЖурналРегистрации.Дата КАК Дата,
		|	_ЖурналРегистрации.ПредставлениеСобытия КАК ПредставлениеСобытия,
		|	_ЖурналРегистрации.Комментарий КАК Комментарий,
		|	_ЖурналРегистрации.Пользователь КАК Пользователь,
		|	_ШаблоныИсключений.Шаблон КАК Шаблон
		|ПОМЕСТИТЬ _ЖурналРегистрации
		|ИЗ
		|	_ЖурналРегистрацииВрем КАК _ЖурналРегистрации
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ШаблоныИсключений КАК _ШаблоныИсключений
		|		ПО (_ЖурналРегистрации.Комментарий ПОДОБНО _ШаблоныИсключений.Шаблон)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЖурналРегистрацииВрем КАК _ЖурналРегистрацииОтменыФБУ
		|		ПО _ЖурналРегистрации.Данные = _ЖурналРегистрацииОтменыФБУ.Данные
		|			И (_ЖурналРегистрацииОтменыФБУ.Комментарий = ""Интерактивная отмена формирования учета"")
		|ГДЕ
		|	_ШаблоныИсключений.Шаблон ЕСТЬ NULL
		|	И _ЖурналРегистрацииОтменыФБУ.Дата ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ЖурналРегистрации.Дата) КАК Дата,
		|	_ЖурналРегистрации.ПредставлениеСобытия КАК Наименование,
		|	_ЖурналРегистрации.Комментарий КАК ТекстЗадачи,
		|	""Журнал регистрации"" КАК Источник,
		|	ЗНАЧЕНИЕ(Справочник.ГруппыПользователей.ВсеПользователи) КАК ГруппаПользователей,
		|	МИНИМУМ(_ЖурналРегистрации.Пользователь) КАК Пользователь
		|ИЗ
		|	_ЖурналРегистрации КАК _ЖурналРегистрации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ОшибкиРегламентыхЗаданий КАК ОшибкиРегламентыхЗаданий
		|		ПО (ОшибкиРегламентыхЗаданий.Источник = ""Журнал регистрации"")
		|			И ((ВЫРАЗИТЬ(_ЖурналРегистрации.ПредставлениеСобытия КАК СТРОКА(100))) = ОшибкиРегламентыхЗаданий.Наименование)
		|			И ((ВЫРАЗИТЬ(_ЖурналРегистрации.Комментарий КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ОшибкиРегламентыхЗаданий.ТекстЗадачи КАК СТРОКА(1000))))
		|			И (ОшибкиРегламентыхЗаданий.Дата >= &Дата)
		|			И (НЕ ОшибкиРегламентыхЗаданий.Выполнена
		|				ИЛИ _ЖурналРегистрации.Дата < ОшибкиРегламентыхЗаданий.ДатаВыполнения)
		|ГДЕ
		|	ОшибкиРегламентыхЗаданий.Ссылка ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЖурналРегистрации.ПредставлениеСобытия,
		|	_ЖурналРегистрации.Комментарий
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Наименование,
		|	ТекстЗадачи";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЖурналРегистрации", 			ЖурналРегистрации);
	Запрос.УстановитьПараметр("НеРегистрируемыеСобытия", 	НеРегистрируемыеСобытия);
	Запрос.УстановитьПараметр("ШаблоныИсключений", 			ШаблоныИсключений);
	Запрос.УстановитьПараметр("Дата", 						НачалоДня(ТекущаяДата()));

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		НоваяЗадача = Задачи.ОшибкиРегламентыхЗаданий.СоздатьЗадачу();
		ЗаполнитьЗначенияСвойств(НоваяЗадача, Выборка);
		НоваяЗадача.Записать();		
	
	КонецЦикла; 		
	
КонецПроцедуры

Процедура ВыполнитьПроверкаНаличияРезервныхКопийБазДанныхЗаСегодня(ДанныеДляСтатистики)
	
	ДанныеДляСтатистики = Новый Структура;
	Источник = ЭтотОбъект.Метаданные().Имя + ".ПроверкаНаличияРезервныхКопийБазДанныхЗаСегодня";
	
	#Область ТекстЗапроса
	ТекстЗапроса = "
		|SELECT
		|	ISNULL(s.database_name, b.database_name) AS database_name,
		|	s.type AS backup_type,
		|	b.backup_type AS backup_type_dest,
		|	CASE s.type
		|		WHEN 'D' THEN 'полная'
		|		WHEN 'I' THEN 'разностная'
		|		WHEN 'L' THEN 'журнала'
		|	END AS backup_type_name,
		|	CASE b.backup_type
		|		WHEN 'D' THEN 'полная'
		|		WHEN 'I' THEN 'разностная'
		|		WHEN 'L' THEN 'журнала'
		|	END AS backup_type_dest_name,
		|	IIF(s.database_name IS NULL, 0, 1) AS is_done,
		|	IIF(b.database_name IS NULL, 0, 1) AS is_known,
		|	IIF(s.type = b.backup_type, 1, 0) AS backup_type_correct,
		|	CAST(s.backup_start_date AS DATETIME) AS backup_start_date,
		|	CAST(s.backup_finish_date AS DATETIME) AS backup_finish_date,
		|	CAST(s.compressed_backup_size / 1024 AS INT) AS compressed_backup_size_kb,
		|	bm.physical_device_name AS backup_file
		|FROM (
		|	SELECT 'AssetManagement' AS database_name, 'D' AS backup_type
		|	UNION ALL SELECT 'AssetManagementArchive', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'AssetManagementMaintenance', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'CentralBankReporting', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'CRM', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'DocMng', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'Externals', IIF(DATEPART(WEEKDAY, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'QuikExportArchive', iif(datepart(weekday, @backup_date) = 7, 'D', 'I')
		|	UNION ALL SELECT 'master', 'D'
		|	UNION ALL SELECT 'model', 'D'
		|	UNION ALL SELECT 'msdb', 'D'
		|) AS b
		|	FULL JOIN (
		|		SELECT * FROM msdb.dbo.backupset
		|		WHERE backup_finish_date >= @backup_date AND user_name <> 'NT AUTHORITY\СИСТЕМА'
		|	) AS s
		|	ON s.database_name = b.database_name
		|	LEFT JOIN msdb.dbo.backupmediafamily AS bm
		|	ON s.media_set_id = bm.media_set_id
		|
		|UNION ALL
		|
		|SELECT
		|	NAME, NULL, NULL, NULL, NULL, -1, 0, NULL, NULL, NULL, NULL, NULL
		|FROM sys.databases
		|WHERE name NOT IN (
		|		'tempdb', 'QuikExportMdTrast', 'QuikExportRam', 'QuikExportRpi',
		|		'QuikExportTrast', 'QuikExport-svc-BC', 'AssetManagementMDTrust', 'AssetManagementRAMTrust'
		|	)
		|	AND name NOT IN (
		|		SELECT database_name FROM msdb.dbo.backupset
		|		WHERE backup_finish_date >= @backup_date AND user_name <> 'NT AUTHORITY\СИСТЕМА'
		|	)
		|
		|ORDER BY
		|	database_name, backup_finish_date";
	#КонецОбласти
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@backup_date", "'" + Формат(ТекущаяДата(), "ДФ=ггггММдд") + "'");
	
	ИмяСервера = "ap70.g1.lan";
	СтрокаСоединения = "Provider=sqloledb;Data Source=" + ИмяСервера + ";Initial Catalog=msdb;Integrated Security=SSPI;";
	
	ДополнительныеПараметры = Новый Структура("Источник", Источник); // так запись об ошибке уйдет в журнал регистрации с указанием источника
	БэкапыНаСервереБД = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса,,, ДополнительныеПараметры);
	
	Если БэкапыНаСервереБД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОшибкиРезервногоКопирования = Новый Массив;
	
	Для Каждого СтрокаБэкапыНаСервереБД Из БэкапыНаСервереБД Цикл
		
		// приведем имя базы данных к стандартам идентификаторов 1С, т.к. дальше это имя
		// будет ключем структуры в данных для статистики
		СтрокаБэкапыНаСервереБД.database_name = СтрЗаменить(СтрокаБэкапыНаСервереБД.database_name, "-", "_");
		
		Если СтрокаБэкапыНаСервереБД.database_name = "AssetManagement"
			И СтрокаБэкапыНаСервереБД.backup_type = "I" // разностная
		Тогда
			// разностные бэкапы AssetManagement формируются в течение дня каждые 2 часа,
			// если не нашли, то ругаться не стоит, т.к. возможно обработку запустили раньше
			// времени начала их формирования - главное, чтобы полный бэкап был на месте
			Продолжить;
		КонецЕсли;
		
		ФайлБэкапаСуществует = Ложь;
		
		Если СтрокаБэкапыНаСервереБД.is_done = 0 Тогда
			
			ОшибкиРезервногоКопирования.Добавить(
				СтрШаблон("Не сформирована %1 резервная копия базы данных %2 на сервере %3",
					СтрокаБэкапыНаСервереБД.backup_type_dest_name,
					СтрокаБэкапыНаСервереБД.database_name,
					ИмяСервера
				)
			);
			
		ИначеЕсли СтрокаБэкапыНаСервереБД.is_done = -1 Тогда
			
			ОшибкиРезервногоКопирования.Добавить(
				СтрШаблон("Отсутствуют настройки проверки и не сформирована резервная копия базы данных %1 на сервере %2",
					СтрокаБэкапыНаСервереБД.database_name,
					ИмяСервера
				)
			);
			
		ИначеЕсли СтрокаБэкапыНаСервереБД.is_done = 1 Тогда
			
			Если СтрокаБэкапыНаСервереБД.is_known = 0 Тогда
				ОшибкиРезервногоКопирования.Добавить(
					СтрШаблон("Обнаружена %1 резервная копия базы данных %2 на сервере %3 для которой не заданы настройки проверки",
						СтрокаБэкапыНаСервереБД.backup_type_name,
						СтрокаБэкапыНаСервереБД.database_name,
						ИмяСервера
					)
				);
			ИначеЕсли СтрокаБэкапыНаСервереБД.backup_type_correct = 0 Тогда
				ОшибкиРезервногоКопирования.Добавить(
					СтрШаблон("Сформирована %1 резервная копия базы данных %2 на сервере %3. Требуется %4",
						СтрокаБэкапыНаСервереБД.backup_type_name,
						СтрокаБэкапыНаСервереБД.database_name,
						ИмяСервера,
						СтрокаБэкапыНаСервереБД.backup_type_dest_name
					)
				);
			КонецЕсли;
			
			ПолноеИмяФайлаБэкапа = СтрокаБэкапыНаСервереБД.backup_file;
			ПолноеИмяФайлаБэкапа = СтрЗаменить(ПолноеИмяФайлаБэкапа, "F:\", "\\" + ИмяСервера + "\");
			
			ФайлБэкапа = Новый Файл(ПолноеИмяФайлаБэкапа);
			ФайлБэкапаСуществует = ФайлБэкапа.Существует();
			Если Не ФайлБэкапаСуществует Тогда
				ОшибкиРезервногоКопирования.Добавить(
					СтрШаблон("Отсутсвует файл %1 %2 резервной копия базы данных %3 на сервере %4",
						СтрокаБэкапыНаСервереБД.backup_file,
						СтрокаБэкапыНаСервереБД.backup_type_name,
						СтрокаБэкапыНаСервереБД.database_name,
						ИмяСервера
					)
				);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаБэкапыНаСервереБД.is_done = 1 Тогда
			ДанныеДляСтатистики.Вставить(СтрокаБэкапыНаСервереБД.database_name,
				СтрокаБэкапыНаСервереБД.backup_type_name + " резервная копия сформирована, "
					+ "тип бэкапа " + ?(СтрокаБэкапыНаСервереБД.backup_type_correct = 1, "", "НЕ") + " корректен, "
					+ СтрокаБэкапыНаСервереБД.backup_start_date + ", " + СтрокаБэкапыНаСервереБД.backup_finish_date + ", "
					+ СтрокаБэкапыНаСервереБД.compressed_backup_size_kb + " kb"
			);
		Иначе
			ДанныеДляСтатистики.Вставить(СтрокаБэкапыНаСервереБД.database_name, "резервная копия НЕ сформирована");
		КонецЕсли;

	КонецЦикла;
	
	Если ОшибкиРезервногоКопирования.Количество() > 0 Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(СтрСоединить(ОшибкиРезервногоКопирования, Символы.ПС), Источник);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ОшибкиРезервногоКопирования, Символы.ПС));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Все резервные копии баз данных на сервере " + ИмяСервера + " были сформированы. Подробнее см. в статистике");
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалениеСтарыхВременныхФайлов()
	
	ОчищаемыйКаталог = ОбщегоНазначенияКлиентСервер.ПолучитьИмяПодкаталогаДляСохраненияВременныхФайлов();
	
	Если ЗначениеЗаполнено(ОчищаемыйКаталог) Тогда
		
		Каталог = КаталогВременныхФайлов() + ОчищаемыйКаталог + ?(Прав(ОчищаемыйКаталог, 1) = "\", "", "\");
		
		ПодкаталогСегодняшнихФайлов = Каталог + Формат(ТекущаяДата(), "ДФ=yyyyMMdd");
		
		НайденныеФайлы = НайтиФайлы(Каталог, "*");
		
		СообщенияОбОшибках = Новый Массив;
		
		Для Каждого Файл Из НайденныеФайлы Цикл
			
			Если Файл.ПолноеИмя <> ПодкаталогСегодняшнихФайлов Тогда
				
				Попытка
					УдалитьФайлы(Файл.ПолноеИмя);
				Исключение
					
					ТекстСообщения = СтрШаблон("Не удалось удалить временный файл или каталог с временными файлами '%1' из-за ошибки:%2", Файл.ПолноеИмя, Символы.ПС + ОписаниеОшибки());
					
					СообщенияОбОшибках.Добавить(ТекстСообщения);
					
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если СообщенияОбОшибках.Количество() > 0 Тогда
			
			ТекстСообщения = "";
			
			Для Каждого СообщениеОбОшибке Из СообщенияОбОшибках Цикл
				ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", Символы.ПС + Символы.ПС) + СообщениеОбОшибке;
			КонецЦикла;
			
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, "Обслуживание информационной базы: удаление старых временных файлов");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеЛицевыеБезСсылок()

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчет.ЛицевойСчетДт КАК ЛицевойСчет
		|ПОМЕСТИТЬ _ЛицевыеИспользуемые
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчет.ЛицевойСчетКт
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет КАК ЕдиныйБухгалтерскийУчет
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ТаблицаПомечаемыхНаУдаление
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицевыеИспользуемые КАК _ЛицевыеИспользуемые
		|		ПО ЛицевыеСчета.Ссылка = _ЛицевыеИспользуемые.ЛицевойСчет
		|ГДЕ
		|	_ЛицевыеИспользуемые.ЛицевойСчет ЕСТЬ NULL
		|	И НЕ ЛицевыеСчета.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛицевыеСчета.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ТаблицаВосстанавливаемых
		|ИЗ
		|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицевыеИспользуемые КАК _ЛицевыеИспользуемые
		|		ПО ЛицевыеСчета.Ссылка = _ЛицевыеИспользуемые.ЛицевойСчет
		|ГДЕ
		|	НЕ _ЛицевыеИспользуемые.ЛицевойСчет ЕСТЬ NULL
		|	И ЛицевыеСчета.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаПомечаемыхНаУдаление"].ПолучитьДанные().Выбрать();
	ВыборкаДетальныеЗаписиВосстанавливаемые = Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаВосстанавливаемых"].ПолучитьДанные().Выбрать();
	
	НачатьТранзакцию();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЛицевойСчетОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ЛицевойСчетОбъект.УстановитьПометкуУдаления(Истина, Ложь);
	КонецЦикла;
	
	Пока ВыборкаДетальныеЗаписиВосстанавливаемые.Следующий() Цикл
		ЛицевойСчетОбъект = ВыборкаДетальныеЗаписиВосстанавливаемые.Ссылка.ПолучитьОбъект();
		ЛицевойСчетОбъект.УстановитьПометкуУдаления(Ложь, Ложь);
	КонецЦикла;

	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ПроверитьНаличиеЗависшихСессийРаботыВнутреннихМеханизмов()
	
	ПараметрыПроверки = Новый ТаблицаЗначений();
	ПараметрыПроверки.Колонки.Добавить("Механизм", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ПараметрыПроверки.Колонки.Добавить("ЛимитВремениВыполнения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный))); // временной интервал в секундах
	ПараметрыПроверки.Колонки.Добавить("ЛимитДляЗакрытияСессии", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный)));
	
	НоваяСтрока = ПараметрыПроверки.Добавить();
	НоваяСтрока.Механизм               = "РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией";
	НоваяСтрока.ЛимитВремениВыполнения = 120;
	НоваяСтрока.ЛимитДляЗакрытияСессии = 600; //закрываем сессию с ошибкой после истечения времени.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПараметрыПроверки.Механизм КАК Механизм,
		|	ПараметрыПроверки.ЛимитВремениВыполнения КАК ЛимитВремениВыполнения,
		|	ДОБАВИТЬКДАТЕ(&ТекущаяДатаСеанса, СЕКУНДА, -ПараметрыПроверки.ЛимитВремениВыполнения) КАК ВремяНачалаПлан,
		|	ДОБАВИТЬКДАТЕ(&ТекущаяДатаСеанса, СЕКУНДА, -ПараметрыПроверки.ЛимитДляЗакрытияСессии) КАК ВремяНачалаПланДляПринудительногоЗакрытияСессии
		|ПОМЕСТИТЬ _ПараметрыПроверки
		|ИЗ
		|	&ПараметрыПроверки КАК ПараметрыПроверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.Механизм КАК Механизм,
		|	СтатистикаРаботыВнутреннихМеханизмов.Сессия КАК Сессия,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало КАК ПериодВыполненияНачало,
		|	СтатистикаРаботыВнутреннихМеханизмов.Описание КАК Описание,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало < _ПараметрыПроверки.ВремяНачалаПланДляПринудительногоЗакрытияСессии КАК ЗавершитьСессию,
		|	_ПараметрыПроверки.ЛимитВремениВыполнения КАК ЛимитВремениВыполнения
		|ИЗ
		|	РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов КАК СтатистикаРаботыВнутреннихМеханизмов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПараметрыПроверки КАК _ПараметрыПроверки
		|		ПО СтатистикаРаботыВнутреннихМеханизмов.Механизм = _ПараметрыПроверки.Механизм
		|			И СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало < _ПараметрыПроверки.ВремяНачалаПлан
		|			И (СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончание = ДАТАВРЕМЯ(1, 1, 1))
		|			И (НАЧАЛОПЕРИОДА(СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало, ДЕНЬ) = &НачалоДня)";
	
	Запрос.УстановитьПараметр("ПараметрыПроверки", ПараметрыПроверки);
	Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Запрос.Параметры.ТекущаяДатаСеанса));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ИмяОбъекта  = ЭтотОбъект.Метаданные().Имя;
		ИмяМетода   = "ПроверитьНаличиеЗависшихСессийРаботыВнутреннихМеханизмов()";
		ТекстОшибки = "Зафиксировано длительное выполнение сессии механизма [" + Выборка.Механизм + "].
					  |Начало выполнения [" + Выборка.ПериодВыполненияНачало  + "].
					  |Лимит выполнения [" + Выборка.ЛимитВремениВыполнения + "] сек.
					  |Параметры: " + Выборка.Описание + ".";
		
		
		Ошибка = РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, ИмяОбъекта + "." + ИмяМетода);
		
		Если Ошибка <> Неопределено И Выборка.ЗавершитьСессию Тогда
			
			ТекстОшибки = "Зафиксировано превышение лимита времени выполнения сессии [" + Выборка.ЛимитВремениВыполнения + "] сек."; 
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Выборка.Механизм, Выборка.Сессия,,, ТекстОшибки);
							
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ПеренестиСтатистикуСтраше90ДнейВАрхив(ДанныеДляСтатистики)
	
	ДанныеДляСтатистики = Новый Структура;
	
	// определим дни, за которые нужно передать статистику в архив
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало, ДЕНЬ) КАК НачалоДня,
		|	КОЛИЧЕСТВО(СтатистикаРаботыВнутреннихМеханизмов.Сессия) КАК КоличествоСессий
		|ИЗ
		|	РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов КАК СтатистикаРаботыВнутреннихМеханизмов
		|ГДЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало < &Дней90Назад
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало, ДЕНЬ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоДня";
	
	Запрос.УстановитьПараметр("Дней90Назад", НачалоДня(ТекущаяДатаСеанса()) - 90*86400);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// общие параметры для статистики
	МВТ = Новый МенеджерВременныхТаблиц;
	ПередатьВЗапросСведенияОПользователяхИБ(МВТ);
	
	// перенес статистики по дням
	ДатыПереносаСтатистики = РезультатЗапроса.Выгрузить();

	Если ДатыПереносаСтатистики.Количество() > 0 Тогда
		
		ПодключитьсяКВнешнемуИсточникуСАрхивомСтатистики();
		
		ДанныеДляСтатистики.Вставить("НачальнаяДатаПереносаСтатистики", ДатыПереносаСтатистики[0].НачалоДня);
		ДанныеДляСтатистики.Вставить("КонечнаяДатаПереносаСтатистики",  КонецДня(ДатыПереносаСтатистики[ДатыПереносаСтатистики.Количество() - 1].НачалоДня));
		ДанныеДляСтатистики.Вставить("ВсегоСессийДляПереноса",          ДатыПереносаСтатистики.Итог("КоличествоСессий"));
		
		Для каждого СтрокаДатыПереносаСтатистики Из ДатыПереносаСтатистики Цикл
			
			ДобавитьВАрхивОтсутствующиеСтатистикиЗаДень(МВТ, СтрокаДатыПереносаСтатистики.НачалоДня, ДанныеДляСтатистики);
			УдалитьЗаписиСтатистикиУспешноДобавленныеВАрхивЗаДень(МВТ, СтрокаДатыПереносаСтатистики.НачалоДня, ДанныеДляСтатистики);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#Область Перенос_Статистики_В_Архив

Процедура ПодключитьсяКВнешнемуИсточникуСАрхивомСтатистики() Экспорт
	
	ВнешнийИсточник = ВнешниеИсточникиДанных.AssetManagementArchive;
	
	// Описание параметров подключения
	ПараметрыСоединения = Новый ПараметрыСоединенияВнешнегоИсточникаДанных;
	ПараметрыСоединения.СУБД             = "MSSQLServer";
	ПараметрыСоединения.АутентификацияОС = Ложь;
	ПараметрыСоединения.ИмяПользователя  = "Nikolay";
	ПараметрыСоединения.Пароль           = "11111";

	Если ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
		ПараметрыСоединения.СтрокаСоединения = "DRIVER={SQL Server};Server=AP70;Database=AssetManagementArchive;";
	Иначе
		ПараметрыСоединения.СтрокаСоединения = "DRIVER={SQL Server};Server=AP69;Database=AssetManagementArchive;";
	КонецЕсли;
	
	// Параметры соединения кэшируются. Всегда требуется повторная установка, если меняются параметры авторизации
	ВнешнийИсточник.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
	ВнешнийИсточник.УстановитьПараметрыСоединенияПользователя(ИмяПользователя(), ПараметрыСоединения);
	ВнешнийИсточник.УстановитьПараметрыСоединенияСеанса(ПараметрыСоединения);

	// Выполняем авторизацию
	ВнешнийИсточник.УстановитьСоединение();
	
КонецПроцедуры

Процедура ПередатьВЗапросСведенияОПользователяхИБ(МВТ)
	
	СведенияОПользователяхИБ = Новый ТаблицаЗначений;
	СведенияОПользователяхИБ.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	СведенияОПользователяхИБ.Колонки.Добавить("УчетнаяЗапись", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	Для каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		
		НоваяСтрокаСведенияОПользователяхИБ = СведенияОПользователяхИБ.Добавить();
		НоваяСтрокаСведенияОПользователяхИБ.Идентификатор = ПользовательИБ.УникальныйИдентификатор;
		НоваяСтрокаСведенияОПользователяхИБ.УчетнаяЗапись = ?(ПользовательИБ.АутентификацияОС, ПользовательИБ.ПользовательОС, ПользовательИБ.Имя);
		
		Если ПустаяСтрока(НоваяСтрокаСведенияОПользователяхИБ.УчетнаяЗапись) Тогда
			ВызватьИсключение "Не удалось определить учетную запись пользователя с идентификатором " + НоваяСтрокаСведенияОПользователяхИБ.Идентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СведенияОПользователяхИБ.Идентификатор КАК Идентификатор,
		|	СведенияОПользователяхИБ.УчетнаяЗапись КАК УчетнаяЗапись
		|ПОМЕСТИТЬ _СведенияОПользователяхИБ
		|ИЗ
		|	&СведенияОПользователяхИБ КАК СведенияОПользователяхИБ";
	
	Запрос.УстановитьПараметр("СведенияОПользователяхИБ", СведенияОПользователяхИБ);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПередатьВЗапросДанныеСтатистикиИзАрхиваЗаДень(МВТ, НачалоДня)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

	Запрос.УстановитьПараметр("ДатаНачала",    НачалоДня);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(НачалоДня));

	// сначала получим данные из внешнего источника (1С не дает возможности
	// их поместить во временную таблицу или соединить с таблицами 1С, поэтому
	// используем промежуточную таблицу значений)
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_Operations_Stats.Id КАК Id,
		|	dbo_Operations_Stats.Operation КАК Operation,
		|	dbo_Operations_Stats.Started_At КАК Started_At,
		|	dbo_Operations_Stats.Stopped_At КАК Stopped_At,
		|	dbo_Operations_Stats.Duration КАК Duration,
		|	dbo_Operations_Stats.Description КАК Description,
		|	dbo_Operations_Stats.Login КАК Login,
		|	dbo_Operations_Stats.Session КАК Session,
		|	dbo_Operations_Stats.Is_Error КАК Is_Error
		|ИЗ
		|	ВнешнийИсточникДанных.AssetManagementArchive.Таблица.dbo_Operations_Stats КАК dbo_Operations_Stats
		|ГДЕ
		|	dbo_Operations_Stats.Started_At МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	СтатистикаРаботыВнутреннихМеханизмовАрхив = Запрос.Выполнить().Выгрузить();
	Запрос.УстановитьПараметр("СтатистикаРаботыВнутреннихМеханизмовАрхив", СтатистикаРаботыВнутреннихМеханизмовАрхив);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Id КАК Id,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Operation КАК Operation,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Started_At КАК Started_At,
		|	ЕСТЬNULL(СтатистикаРаботыВнутреннихМеханизмовАрхив.Stopped_At, ДАТАВРЕМЯ(1, 1,1)) КАК Stopped_At,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Duration КАК Duration,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Description КАК Description,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Login КАК Login,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Session КАК Session,
		|	СтатистикаРаботыВнутреннихМеханизмовАрхив.Is_Error КАК Is_Error
		|ПОМЕСТИТЬ _СтатистикаРаботыВнутреннихМеханизмовАрхив
		|ИЗ
		|	&СтатистикаРаботыВнутреннихМеханизмовАрхив КАК СтатистикаРаботыВнутреннихМеханизмовАрхив";
	
	Запрос.Выполнить();
		
КонецПроцедуры 

Процедура ДобавитьВАрхивОтсутствующиеСтатистикиЗаДень(МВТ, НачалоДня, ДанныеДляСтатистики)
	
	ВремяНачалаВыполнения = ТекущаяДатаСеанса();
	
	ПередатьВЗапросДанныеСтатистикиИзАрхиваЗаДень(МВТ, НачалоДня);
	
	ДобавленоНовыхЗаписейВАрхив = 0;
	ОшибкиДобавленияЗаписейВАрхив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("ДатаНачалаВыполнения", НачалоДня);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.Сессия КАК Сессия,
		|	СтатистикаРаботыВнутреннихМеханизмов.Механизм КАК Механизм,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало КАК ПериодВыполненияНачало,
		|	ВЫБОР
		|		КОГДА СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончание = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА NULL
		|		ИНАЧЕ СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончание
		|	КОНЕЦ КАК ПериодВыполненияОкончание,
		|	ВЫБОР
		|		КОГДА СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончаниеМС < СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачалоМС
		|			ТОГДА NULL
		|		ИНАЧЕ (СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончаниеМС - СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачалоМС) / 1000
		|	КОНЕЦ КАК Длительность,
		|	СтатистикаРаботыВнутреннихМеханизмов.Описание КАК Описание,
		|	_СведенияОПользователяхИБ.УчетнаяЗапись КАК УчетнаяЗапись,
		|	СтатистикаРаботыВнутреннихМеханизмов.Сеанс КАК Сеанс,
		|	СтатистикаРаботыВнутреннихМеханизмов.СессияЗавершенаСОшибкой КАК СессияЗавершенаСОшибкой
		|ИЗ
		|	РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов КАК СтатистикаРаботыВнутреннихМеханизмов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОПользователяхИБ КАК _СведенияОПользователяхИБ
		|		ПО СтатистикаРаботыВнутреннихМеханизмов.Ответственный.ИдентификаторПользователяИБ = _СведенияОПользователяхИБ.Идентификатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатистикаРаботыВнутреннихМеханизмовАрхив КАК _СтатистикаРаботыВнутреннихМеханизмовАрхив
		|		ПО СтатистикаРаботыВнутреннихМеханизмов.Сессия = _СтатистикаРаботыВнутреннихМеханизмовАрхив.Id
		|ГДЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.ДатаНачалаВыполнения = &ДатаНачалаВыполнения
		|	И _СтатистикаРаботыВнутреннихМеханизмовАрхив.Id ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПериодВыполненияНачало";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ВнешниеИсточникиДанных.AssetManagementArchive.dbo_usp_Insert_Operation_Stats(
				Выборка.Сессия,
				Выборка.Механизм,
				Выборка.ПериодВыполненияНачало,
				Выборка.ПериодВыполненияОкончание,
				Выборка.Длительность,
				Выборка.Описание,
				Выборка.УчетнаяЗапись,
				Выборка.Сеанс,
				Выборка.СессияЗавершенаСОшибкой
			);
			ДобавленоНовыхЗаписейВАрхив = ДобавленоНовыхЗаписейВАрхив + 1;
		Исключение
			ОшибкиДобавленияЗаписейВАрхив.Добавить("Не удалось добавить в архив сессию статистики "
				+ Выборка.Сессия + " за " + Выборка.ПериодВыполненияНачало + ". Система сообщает: " + ОписаниеОшибки());
		КонецПопытки;
			
	КонецЦикла;
	
	Запрос.Текст =
		"УНИЧТОЖИТЬ _СтатистикаРаботыВнутреннихМеханизмовАрхив";
	Запрос.Выполнить();
	
	Постфикс = Формат(НачалоДня, "ДФ=yyyyMMdd");
	
	ДанныеДляСтатистики.Вставить("ДобавленоНовыхЗаписейВАрхив" + Постфикс,  ДобавленоНовыхЗаписейВАрхив);
	ДанныеДляСтатистики.Вставить("ВремяДобавленияВАрхивСек" + Постфикс,     ТекущаяДатаСеанса() - ВремяНачалаВыполнения);
	ДанныеДляСтатистики.Вставить("ОшибокДобавленияЗаписейВАрхив"+ Постфикс, ОшибкиДобавленияЗаписейВАрхив.Количество());

	Если ОшибкиДобавленияЗаписейВАрхив.Количество() > 0 Тогда
		ДанныеДляСтатистики.Вставить("ПримерОшибки" + Постфикс,                  ОшибкиДобавленияЗаписейВАрхив[0]);
		ДанныеДляСтатистики.Вставить("ОшибкиДобавленияЗаписейВАрхив" + Постфикс, ОшибкиДобавленияЗаписейВАрхив);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьЗаписиСтатистикиУспешноДобавленныеВАрхивЗаДень(МВТ, НачалоДня, ДанныеДляСтатистики)
	
	ВремяНачалаВыполнения = ТекущаяДатаСеанса();
	УдаленоЗаписейВРегистре = 0;
	ОписаниеРасхождений = Новый Массив;
	
	ПередатьВЗапросДанныеСтатистикиИзАрхиваЗаДень(МВТ, НачалоДня);

	// сравним данные в архиве и регистре и удалим те, по которым нет расхождений
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

	Запрос.УстановитьПараметр("ДатаНачалаВыполнения", НачалоДня);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.Сессия ЕСТЬ NULL КАК ОтсутствуютДанныеВ1С,
		|	СтатистикаРаботыВнутреннихМеханизмов.Сессия КАК Сессия,
		|	СтатистикаРаботыВнутреннихМеханизмов.Механизм КАК Механизм,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало КАК ПериодВыполненияНачало,
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончание КАК ПериодВыполненияОкончание,
		|	СтатистикаРаботыВнутреннихМеханизмов.Сеанс КАК Сеанс,
		|	СтатистикаРаботыВнутреннихМеханизмов.СессияЗавершенаСОшибкой КАК СессияЗавершенаСОшибкой,
		|	СтатистикаРаботыВнутреннихМеханизмов.Описание КАК Описание,
		|	ВЫБОР
		|		КОГДА СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончаниеМС < СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачалоМС
		|			ТОГДА NULL
		|		ИНАЧЕ (СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияОкончаниеМС - СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачалоМС) / 1000
		|	КОНЕЦ КАК Длительность,
		|	_СведенияОПользователяхИБ.УчетнаяЗапись КАК УчетнаяЗапись,
		|	_СтатистикаРаботыВнутреннихМеханизмовАрхив.Id ЕСТЬ NULL КАК ОтсутствуютДанныеВАвхиве,
		|	&СтатистикаРаботыВнутреннихМеханизмовАрхивЗвездочка КАК СтатистикаРаботыВнутреннихМеханизмовАрхивЗвездочка
		|ИЗ
		|	РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов КАК СтатистикаРаботыВнутреннихМеханизмов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СведенияОПользователяхИБ КАК _СведенияОПользователяхИБ
		|		ПО СтатистикаРаботыВнутреннихМеханизмов.Ответственный.ИдентификаторПользователяИБ = _СведенияОПользователяхИБ.Идентификатор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтатистикаРаботыВнутреннихМеханизмовАрхив КАК _СтатистикаРаботыВнутреннихМеханизмовАрхив
		|		ПО СтатистикаРаботыВнутреннихМеханизмов.Сессия = _СтатистикаРаботыВнутреннихМеханизмовАрхив.Id
		|ГДЕ
		|	СтатистикаРаботыВнутреннихМеханизмов.ДатаНачалаВыполнения = &ДатаНачалаВыполнения
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтатистикаРаботыВнутреннихМеханизмов.ПериодВыполненияНачало";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтатистикаРаботыВнутреннихМеханизмовАрхивЗвездочка КАК СтатистикаРаботыВнутреннихМеханизмовАрхивЗвездочка", "_СтатистикаРаботыВнутреннихМеханизмовАрхив.*");
	
	ДанныеСтатистикиДляПереносаВАрхив = Запрос.Выполнить().Выгрузить();
	
	ДанныеСтатистикиДляПереносаВАрхив.Колонки.Добавить("ЕстьРасхождения",     Новый ОписаниеТипов("Число"));
	ДанныеСтатистикиДляПереносаВАрхив.Колонки.Добавить("ОписаниеРасхождений", Новый ОписаниеТипов("Строка"));
	
	Для каждого СтрокаДанныеСтатистикиДляПереносаВАрхив Из ДанныеСтатистикиДляПереносаВАрхив Цикл
		
		ОписаниеРасхожденийПоСессии = Новый Массив;
		
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.Механизм <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Operation Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	Механизм: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Механизм + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Operation + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.ПериодВыполненияНачало <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Started_At Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	ПериодВыполненияНачало: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.ПериодВыполненияНачало + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Started_At + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.ПериодВыполненияОкончание <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Stopped_At Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	ПериодВыполненияОкончание: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.ПериодВыполненияОкончание + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Stopped_At + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.Длительность <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Duration Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	Длительность: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Длительность + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Duration + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.Описание <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Description Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	Описание: см. в отладчике");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.УчетнаяЗапись <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Login Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	УчетнаяЗапись: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.УчетнаяЗапись + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Login + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.Сеанс <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Session Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	Сеанс: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Сеанс + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Session + "'");
		КонецЕсли;
		Если СтрокаДанныеСтатистикиДляПереносаВАрхив.СессияЗавершенаСОшибкой <> СтрокаДанныеСтатистикиДляПереносаВАрхив.Is_Error Тогда
			ОписаниеРасхожденийПоСессии.Добавить("	СессияЗавершенаСОшибкой: [1C] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.СессияЗавершенаСОшибкой + "' <> [Архив] '" + СтрокаДанныеСтатистикиДляПереносаВАрхив.Is_Error + "'");
		КонецЕсли;
		
		Если ОписаниеРасхожденийПоСессии.Количество() > 0 Тогда
			
			СтрокаДанныеСтатистикиДляПереносаВАрхив.ЕстьРасхождения     = 1;
			СтрокаДанныеСтатистикиДляПереносаВАрхив.ОписаниеРасхождений = "Найдены расхождения между регистром 1С и архивом по сессии " + СтрокаДанныеСтатистикиДляПереносаВАрхив.Сессия + ":"
				+ Символы.ПС + СтрСоединить(ОписаниеРасхожденийПоСессии, Символы.ПС)
				
		КонецЕсли;
			
	КонецЦикла;

	Если ДанныеСтатистикиДляПереносаВАрхив.Итог("ЕстьРасхождения") = 0 Тогда
		
		// удалим сразу все записи за дату
		
		// без транзакции иногда валится ошибка при большом количестве записей
		// 	Microsoft SQL Server Native Client 11.0: Превышено время ожидания запроса на блокировку.
		// 	HRESULT=80040E31, SQLSrvr: SQLSTATE=HYT00, state=33, Severity=10, native=1222, line=1
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		
		Блокировка = Новый БлокировкаДанных;
		
		БлокировкиРегистраСтатистика = Блокировка.Добавить("РегистрСведений.СтатистикаРаботыВнутреннихМеханизмов");
		БлокировкиРегистраСтатистика.УстановитьЗначение("ДатаНачалаВыполнения", НачалоДня);
		БлокировкиРегистраСтатистика.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		НаборЗаписейСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.СоздатьНаборЗаписей();
		НаборЗаписейСтатистики.Отбор.ДатаНачалаВыполнения.Установить(НачалоДня);
		НаборЗаписейСтатистики.Прочитать();
		НаборЗаписейСтатистики.Очистить();
		НаборЗаписейСтатистики.Записать();
		
		УдаленоЗаписейВРегистре = ДанныеСтатистикиДляПереносаВАрхив.Количество();
		
		ЗафиксироватьТранзакцию();
		
	Иначе
	
		// будем удалять по одной записи
		Для каждого СтрокаДанныеСтатистикиДляПереносаВАрхив Из ДанныеСтатистикиДляПереносаВАрхив Цикл
			
			Если СтрокаДанныеСтатистикиДляПереносаВАрхив.ЕстьРасхождения = 1 Тогда
				
				ОписаниеРасхождений.Добавить(СтрокаДанныеСтатистикиДляПереносаВАрхив.ОписаниеРасхождений);
				
			Иначе
			
				НаборЗаписейСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.СоздатьНаборЗаписей();
				НаборЗаписейСтатистики.Отбор.Механизм.Установить(СтрокаДанныеСтатистикиДляПереносаВАрхив.Механизм);
				НаборЗаписейСтатистики.Отбор.Сессия.Установить(СтрокаДанныеСтатистикиДляПереносаВАрхив.Сессия);
				НаборЗаписейСтатистики.Записать();
				
				УдаленоЗаписейВРегистре = УдаленоЗаписейВРегистре + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	Запрос.Текст =
		"УНИЧТОЖИТЬ _СтатистикаРаботыВнутреннихМеханизмовАрхив";
	Запрос.Выполнить();
	
	Постфикс = Формат(НачалоДня, "ДФ=yyyyMMdd");
	
	ДанныеДляСтатистики.Вставить("УдаленоЗаписейВРегистре" + Постфикс,    УдаленоЗаписейВРегистре);
	ДанныеДляСтатистики.Вставить("ВремяУдаленияИхРегистраСек" + Постфикс, ТекущаяДатаСеанса() - ВремяНачалаВыполнения);
	ДанныеДляСтатистики.Вставить("НайденоРасхожденийСАрхивом" + Постфикс, ОписаниеРасхождений.Количество());
		
	Если ОписаниеРасхождений.Количество() > 0 Тогда
		ДанныеДляСтатистики.Вставить("ПримерРасхождения" + Постфикс, ОписаниеРасхождений[0]);
		ДанныеДляСтатистики.Вставить("ОписаниеРасхождений" + Постфикс, ОписаниеРасхождений);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
