		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУстановкуФлажков()
	
	Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
		СтрокаАктивныеСчетаДоверительногоУправления.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	Попытка
		ВыполнитьЭкспорт(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт(ПараметрыСессии)
	
	// Проверяем каталог верхнего уровня
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогФайлов, Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Экспорт данных прерван");
		ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось создать каталог файлов верхнего уровня");
		Возврат;	
	КонецЕсли;
	
	МассивСчетовДУ = Новый Массив;
	
	Для Каждого Элемент Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		МассивСчетовДУ.Очистить();
		
		Для Каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
			
			Если Не СтрокаАктивныеСчетаДоверительногоУправления.Флажок Тогда
				Продолжить;
			КонецЕсли;            			
		
			Если СтрокаАктивныеСчетаДоверительногоУправления[Элемент.Значение] Тогда
				МассивСчетовДУ.Добавить(СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления);	
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивСчетовДУ.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Элемент.Значение = "МНО" Тогда
			
			ПечатьЗапросовНаПодтверждениеМНО(МассивСчетовДУ, ПараметрыСессии);
			
		ИначеЕсли Элемент.Значение = "ФормаСогласияНаРазмещениеДепозитов" Тогда
			
			СформироватьЗапросыСогласияНаРазмещениеДепозитов(
				Объект.Организация, 
				ЭтаФорма.ЮрЛицоОрганизации, 
				МассивСчетовДУ, 
				НачалоДня(Объект.Период), 
				Объект.КаталогФайлов, 
				ЭтаФорма.Подписант, 
				ЭтаФорма.ПодписантДолжность, 
				ЭтаФорма.МакетЗапросаСогласия,
				ПараметрыСессии);
			
		ИначеЕсли Элемент.Значение = "ФормаСогласияНаПереводыСоСчетовБрокера" Тогда
			
			СформироватьЗапросыСогласияНаПереводыСоСчетовБрокера(
				Объект.Организация, 
				ЭтаФорма.ЮрЛицоОрганизации, 
				МассивСчетовДУ, 
				НачалоДня(Объект.Период), 
				Объект.КаталогФайлов, 
				ЭтаФорма.Подписант, 
				ЭтаФорма.ПодписантДолжность, 
				ЭтаФорма.МакетЗапросаСогласия,
				ПараметрыСессии);
			
		Иначе
			
			КаталогДаты = "\" + Формат(Объект.Период, "ДФ=yyyy.MM") + "\" + Формат(Объект.Период, "ДФ=yyyy.MM.dd") + "\"; 
			ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "СЧА_РСА" + КаталогДаты;
			
			Отказ = Ложь;
			РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Экспорт данных прерван");
				ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось создать каталог СЧА_РСА");
				Возврат;	
			КонецЕсли;
		    
			ПолучитьФорму("ВнешняяОбработка._ЭкспортДанныхВНСД.Форма." + Элемент.Значение)
						.СфомироватьДокументыСЭД(Объект.Организация, МассивСчетовДУ, Объект.Период, ТекКаталогФайлов, Подписант);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Экспорт данных завершен");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктивныеСчетаДоверительногоУправления()
	
	ТекНачалоДня = НачалоДня(ТекущаяДатаСеанса());
	
	Если ЭтаФорма.ФормаСогласияНаРазмещениеДепозитов Тогда 
		ЭтаФорма.ФормаСогласияНаРазмещениеДепозитов = (Объект.Период = ТекНачалоДня);	
	Конецесли;
	
	Если ЭтаФорма.ФормаСогласияНаПереводыСоСчетовБрокера Тогда 
		ЭтаФорма.ФормаСогласияНаПереводыСоСчетовБрокера = (Объект.Период = ТекНачалоДня);	
	Конецесли;

	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Очистить();
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаСпецДепаНСД
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.СпециализированныйДепозитарий = &НСД
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА) КАК ФормаСЧА,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаРСА) КАК ФормаРСА,
		|	МАКСИМУМ(ВложенныйЗапрос.МНО) КАК МНО,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаСогласияНаРазмещениеДепозитов) КАК ФормаСогласияНаРазмещениеДепозитов,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаСогласияНаПереводыСоСчетовБрокера) КАК ФормаСогласияНаПереводыСоСчетовБрокера,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		&ФормаСЧА КАК ФормаСЧА,
		|		ЛОЖЬ КАК ФормаРСА,
		|		ЛОЖЬ КАК МНО,
		|		ЛОЖЬ КАК ФормаСогласияНаРазмещениеДепозитов,
		|		ЛОЖЬ КАК ФормаСогласияНаПереводыСоСчетовБрокера,
		|		_СчетаСпецДепаНСД.Ссылка КАК СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецДепаНСД КАК _СчетаСпецДепаНСД
		|	ГДЕ
		|		&ФормаСЧА
		|		И _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления В (&УправлениеПН, &УправлениеПР)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		&ФормаРСА,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецДепаНСД.Ссылка
		|	ИЗ
		|		_СчетаСпецДепаНСД КАК _СчетаСпецДепаНСД
		|	ГДЕ
		|		&ФормаРСА
		|		И _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления В(&УправлениеПН)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		НЕ РаспоряжениеНаМНО.Ссылка ЕСТЬ NULL,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецДепаНСД.Ссылка
		|	ИЗ
		|		_СчетаСпецДепаНСД КАК _СчетаСпецДепаНСД
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК РаспоряжениеНаМНО
		|			ПО (&МНО)
		|				И _СчетаСпецДепаНСД.Ссылка = РаспоряжениеНаМНО.СчетДоверительногоУправления
		|				И (РаспоряжениеНаМНО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ))
		|				И (РаспоряжениеНаМНО.Организация = &Организация)
		|				И (РаспоряжениеНаМНО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО))
		|				И (_СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|					ИЛИ _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
		|					ИЛИ _СчетаСпецДепаНСД.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))
		|				И (НЕ РаспоряжениеНаМНО.ПометкаУдаления)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		НЕ Распоряжение.Ссылка ЕСТЬ NULL,
		|		ЛОЖЬ,
		|		_СчетаСпецДепаНСД.Ссылка
		|	ИЗ
		|		_СчетаСпецДепаНСД КАК _СчетаСпецДепаНСД
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжение
		|			ПО (&ФормаСогласияНаРазмещениеДепозитов)
		|				И _СчетаСпецДепаНСД.Ссылка = Распоряжение.СчетДоверительногоУправления
		|				И (НАЧАЛОПЕРИОДА(Распоряжение.ДатаРазмещения, ДЕНЬ) = &Период)
		|				И (Распоряжение.Организация = &Организация)
		|				И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента))
		|				И (НЕ Распоряжение.ПометкаУдаления)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		_СчетаСпецДепаНСД.Ссылка
		|	ИЗ
		|		_СчетаСпецДепаНСД КАК _СчетаСпецДепаНСД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|			ПО (&ФормаСогласияНаПереводыСоСчетовБрокера)
		|				И _СчетаСпецДепаНСД.Ссылка = ДокПоручение.СчетДоверительногоУправления
		|				И (ДокПоручение.Организация = &Организация)
		|				И (НАЧАЛОПЕРИОДА(ДокПоручение.Дата, ДЕНЬ) = &Период)
		|				И (ДокПоручение.Проведен)
		|				И (ДокПоручение.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|				И (ДокПоручение.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних КАК НастройкиАкцептованияОперацийСрезПоследних
		|			ПО (ДокПоручение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация)
		|				И (ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления)
		|				И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|	ГДЕ
		|		ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.СчетДоверительногоУправления
		|
		|ИМЕЮЩИЕ
		|	(МАКСИМУМ(ВложенныйЗапрос.ФормаСЧА) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаРСА) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.МНО) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаСогласияНаРазмещениеДепозитов) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаСогласияНаПереводыСоСчетовБрокера) = ИСТИНА)";
#КонецОбласти
		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НСД", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"));
	Запрос.УстановитьПараметр("УправлениеПН", Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	Запрос.УстановитьПараметр("УправлениеПР", Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	
	Запрос.УстановитьПараметр("ФормаСЧА", ЭтаФорма.ФормаСЧА);
	Запрос.УстановитьПараметр("ФормаРСА", ?(Объект.Период < '20231101', ЭтаФорма.ФормаРСА, Ложь));
	Запрос.УстановитьПараметр("МНО", ЭтаФорма.МНО);
	Запрос.УстановитьПараметр("ФормаСогласияНаРазмещениеДепозитов", ЭтаФорма.ФормаСогласияНаРазмещениеДепозитов);
	Запрос.УстановитьПараметр("ФормаСогласияНаПереводыСоСчетовБрокера", ЭтаФорма.ФормаСогласияНаПереводыСоСчетовБрокера);

	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Сортировать("СчетДоверительногоУправления");

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере(УстановитьКаталог = Ложь)
			
	УстановитьКаталогНаСервере();	
	ОбновитьАктивныеСчетаДоверительногоУправления();
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ФлажкиФормПриИзменении(Элемент)
	
	ТекНачалоДня = НачалоДня(ТекущаяДата());
	УстановитьКаталог = Ложь;
	
	Если Элемент.Имя = "ФормаСогласияНаРазмещениеДепозитов" Или Элемент.Имя = "ФормаСогласияНаПереводыСоСчетовБрокера" Тогда
		
		Если (ЭтаФорма["ФормаСогласияНаРазмещениеДепозитов"] Или ЭтаФорма["ФормаСогласияНаПереводыСоСчетовБрокера"]) 
			И Объект.Период <> ТекНачалоДня Тогда
		
			Если Вопрос("Запросы согласия на распоряжение имуществом должны формироваться в текущем дне. Установить для периода значение [" + Формат(ТекНачалоДня, "ДФ=dd.MM.yyyy") + "]?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
				
				Объект.Период = ТекНачалоДня;
				
				ЭтаФорма["ФормаСЧА"] = Ложь;
				ЭтаФорма["МНО"] = Ложь;
				ЭтаФорма["ФормаРСА"] = Ложь;
				
				УстановитьКаталог = Истина;
	
			Иначе
				
				ЭтаФорма["ФормаСогласияНаРазмещениеДепозитов"] = Ложь;
				ЭтаФорма["ФормаСогласияНаПереводыСоСчетовБрокера"] = Ложь;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЭтаФорма[Элемент.Имя] = Истина Тогда
		
		Если Объект.Период <> ТекНачалоДня Тогда
			ЭтаФорма["ФормаСогласияНаРазмещениеДепозитов"] = Ложь;
			ЭтаФорма["ФормаСогласияНаПереводыСоСчетовБрокера"] = Ложь;
		КонецЕсли;
	
	КонецЕсли;
	
	ОбновитьНаСервере(УстановитьКаталог);
	
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКаталогНаСервере()
	    	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		ТекКаталогФайлов = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._ЭкспортДанныхВНСД.ШаблонКаталогаФайлов", Объект.Организация, Объект.Период, Объект.КаталогФайлов);
	Иначе
		ТекКаталогФайлов = "\\ap69\Developers\Саня\xml";
	КонецЕсли;
	
	Объект.КаталогФайлов = ТекКаталогФайлов;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Объект.Период >= '20231101' Тогда
		ЭтаФорма["ФормаРСА"] = Ложь;
	КонецЕсли;
				
	ОбновитьНаСервере(Истина);
	
	НастроитьВидимостьИДоступность();
	 
КонецПроцедуры

&НаКлиенте
Процедура АктивныеСчетаДоверительногоУправленияПередНачаломИзменения(Элемент, Отказ)

	ТекущиеДанные = Элементы.АктивныеСчетаДоверительногоУправления.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.АктивныеСчетаДоверительногоУправления.ТекущийЭлемент = Элементы.АктивныеСчетаДоверительногоУправленияСчетДоверительногоУправления Тогда
		Отказ = Истина;
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗапросовНаПодтверждениеМНО(МассивСчетовДУ, ПараметрыСессии)
			
	ОбщиеДанные = ПолучитьОбщиеРеквизитыДляПечати(МассивСчетовДУ, Подписант);
	МассивДокументов = ПолучитьСтруктуруДанных(МассивСчетовДУ);
	
	Если МассивДокументов.Количество() = 0 Тогда
		ТекстОшибки = "Не выбраны данные для печати";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	КаталогДаты = "\" + Формат(Объект.Период, "ДФ=yyyy.MM") + "\" + Формат(Объект.Период, "ДФ=yyyy.MM.dd") + "\"; 
	ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "МНО" + КаталогДаты;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
	Если Отказ Тогда
		ТекстОшибки = "Выгрузка МНО прервана";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;	
	КонецЕсли;
	
	ИмяФайлаШаблона = ПолучитьИмяВременногоФайла("docx");
	ШаблонЗапросаНаПодтверждениеМНО.Записать(ИмяФайлаШаблона);
		         	
	Попытка
		
		WordApp = Новый COMОбъект("Word.Application");
		WordApp.Application.Visible = Ложь;
						
		Для каждого СтруктураРеквизитов из МассивДокументов Цикл
						
			NewDoc = WordApp.Application.Documents.Add(ИмяФайлаШаблона, False, , Ложь);
			
			WordVars = NewDoc.Variables;
			
			Для Каждого Реквизит Из ОбщиеДанные Цикл
				Если Реквизит.Ключ = "Стратегия" И Реквизит.Значение = "Заменить" Тогда
					WordVars.Item(Реквизит.Ключ).Value = СтруктураРеквизитов.НаименованиеСчетаДУБезСкобок;
				Иначе	                                 
					WordVars.Item(Реквизит.Ключ).Value = Реквизит.Значение;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Реквизит Из СтруктураРеквизитов Цикл
				WordVars.Item(Реквизит.Ключ).Value = Реквизит.Значение;
			КонецЦикла;
			
			NewDoc.Fields.Update();
							
			NewDoc.SaveAs(ТекКаталогФайлов + СтруктураРеквизитов.ИмяФайла + ".docx");
			NewDoc.Close();
							
			ОбработкаПрерыванияПользователя();
						
		КонецЦикла;
				
		WordApp.Application.Quit();
				
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);	
	КонецПопытки;
	
	// удалим файлы шаблона
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблона);
	Исключение
	КонецПопытки;
	
	Если Отказ Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Формирование документов завершилось с ошибкой");
		ПоказатьПредупреждение(,"Формирование документов завершилось с ошибкой!");
	Иначе		
		ПоказатьПредупреждение(,"Формирование документов завершено!");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруДанных(МассивСчетовДУ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РаспоряжениеНаМНО.Дата КАК Дата,
	|	РаспоряжениеНаМНО.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеПортфеля,
	|	ЕСТЬNULL(ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.НомерДоговора, ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.НомерДоговора) КАК НомерДоговораДепозитарногоОбслуживания,
	|	ЕСТЬNULL(ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.ДатаЗаключения, ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.ДатаЗаключения) КАК ДатаДоговораДепозитарногоОбслуживания,
	|	ВЫБОР
	|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000001"" И ""000009""
	|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 6, 1)
	|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000010"" И ""000099""
	|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 5, 2)
	|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000100"" И ""000999""
	|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 4, 3)
	|		КОГДА НомераОбъектов.Номер МЕЖДУ ""001000"" И ""009999""
	|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 3, 4)
	|		КОГДА НомераОбъектов.Номер МЕЖДУ ""010000"" И ""099999""
	|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 2, 5)
	|		ИНАЧЕ НомераОбъектов.Номер
	|	КОНЕЦ КАК НомерДопСоглашения,
	|	РаспоряжениеНаМНО.РасчетныйСчет.ДоговорМНО.НомерДоговора КАК НомерДоговораМНО,
	|	РаспоряжениеНаМНО.РасчетныйСчет.ДоговорМНО.ДатаЗаключения КАК ДатаДоговораМНО,
	|	РаспоряжениеНаМНО.РасчетныйСчет.Договор.НомерДоговора КАК НомерДоговораБанковскогоОбслуживания,
	|	РаспоряжениеНаМНО.РасчетныйСчет.Договор.ДатаЗаключения КАК ДатаДоговораБанковскогоОбслуживания,
	|	РаспоряжениеНаМНО.Сумма КАК Сумма,
	|	РеквизитыЮридическихЛиц.КраткоеНаименованиеПоУставу КАК НаименованиеБанка,
	|	РеквизитыЮридическихЛиц.ИНН КАК ИННБанка,
	|	РаспоряжениеНаМНО.Дата КАК DopDogDateStart,
	|	РаспоряжениеНаМНО.ДатаВозврата КАК СрокРазмещения,
	|	РаспоряжениеНаМНО.Процент КАК Ставка,
	|	РаспоряжениеНаМНО.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
	|	РаспоряжениеНаМНО.Дата КАК ИмяФайла,
	|	РаспоряжениеНаМНО.СчетДоверительногоУправления.Наименование КАК СчетДУ,
	|	РаспоряжениеНаМНО.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
	|	РаспоряжениеНаМНО.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора
	|ИЗ
	|	(ВЫБРАТЬ
	|		РаспоряжениеНаМНО.Ссылка КАК Ссылка,
	|		РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо КАК РасчетныйСчетБанкЮрФизЛицо,
	|		РаспоряжениеНаМНО.Организация КАК Организация,
	|		РаспоряжениеНаМНО.Дата КАК Дата,
	|		РаспоряжениеНаМНО.РасчетныйСчет КАК РасчетныйСчет,
	|		РаспоряжениеНаМНО.Сумма КАК Сумма,
	|		РаспоряжениеНаМНО.ДатаВозврата КАК ДатаВозврата,
	|		РаспоряжениеНаМНО.Процент КАК Процент,
	|		РаспоряжениеНаМНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|		РаспоряжениеНаМНО.Валюта КАК Валюта,
	|		МАКСИМУМ(РеквизитыЮридическихЛиц.Период) КАК Период
	|	ИЗ
	|		Документ.Распоряжение КАК РаспоряжениеНаМНО
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
	|			ПО РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛиц.ЮрФизЛицо
	|				И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|				И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|				И РаспоряжениеНаМНО.Дата >= РеквизитыЮридическихЛиц.Период
	|	ГДЕ
	|		РаспоряжениеНаМНО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	|		И РаспоряжениеНаМНО.Организация = &Организация
	|		И РаспоряжениеНаМНО.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
	|		И РаспоряжениеНаМНО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
	|		И НЕ РаспоряжениеНаМНО.ПометкаУдаления
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РаспоряжениеНаМНО.Ссылка,
	|		РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо,
	|		РаспоряжениеНаМНО.Организация,
	|		РаспоряжениеНаМНО.Дата,
	|		РаспоряжениеНаМНО.РасчетныйСчет,
	|		РаспоряжениеНаМНО.Сумма,
	|		РаспоряжениеНаМНО.ДатаВозврата,
	|		РаспоряжениеНаМНО.Процент,
	|		РаспоряжениеНаМНО.СчетДоверительногоУправления,
	|		РаспоряжениеНаМНО.Валюта) КАК РаспоряжениеНаМНО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
	|		ПО РаспоряжениеНаМНО.РасчетныйСчетБанкЮрФизЛицо = РеквизитыЮридическихЛиц.ЮрФизЛицо
	|			И РаспоряжениеНаМНО.Период = РеквизитыЮридическихЛиц.Период
	|			И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
	|			И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
	|		ПО РаспоряжениеНаМНО.Организация = НомераОбъектов.Организация
	|			И РаспоряжениеНаМНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
	|			И РаспоряжениеНаМНО.Ссылка = НомераОбъектов.Объект
	|			И (ГОД(РаспоряжениеНаМНО.Дата) = НомераОбъектов.Год)
	|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
	|		ПО РаспоряжениеНаМНО.Организация = ИсполнителиПоЦеннымБумагам.Организация
	|			И РаспоряжениеНаМНО.СчетДоверительногоУправления = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления
	|			И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
	|			И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий = &СпециализированныйДепозитарий)
	|			И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаЗакрытия > &Период)
	|			И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецдепозитарногоОбслуживания))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
	|					И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецдепозитарногоОбслуживания)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
	|			ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = УсловияДоговоровОбщиеСрезПоследних.Договор
	|		ПО РаспоряжениеНаМНО.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
	|			И (ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, &Период) >= &Период)
	|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)"; 
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления",	МассивСчетовДУ);
	Запрос.УстановитьПараметр("Период", 	 			  		Объект.Период);
	Запрос.УстановитьПараметр("Организация", 	 				Объект.Организация);
	Запрос.УстановитьПараметр("СпециализированныйДепозитарий", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"));
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДанныеДляПечати = Новый Массив();
	
	ТекДата = Формат(ТекущаяДата(), "ДЛФ=DD");
		
	//НомерСтроки = 1;
	Пока Выборка.Следующий() Цикл
		
		СтрокаДанных = Новый Структура();
		
		//СтрокаДанных.Вставить("НомерСтроки", СокрЛП(НомерСтроки) + ".");
		//НомерСтроки = НомерСтроки + 1;
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		ЭтоФилиал = СтрНайти(СокрЛП(СтрокаДанных.НаименованиеПортфеля), "ФИЛИАЛ") > 0;		
		Если ЭтоФилиал Тогда
			СтрокаДанных.Вставить("НаименованиеПортфеля" , Сред(СокрЛП(СтрокаДанных.НаименованиеПортфеля), 21));
		КонецЕсли;
		
		СтрокаДанных.Вставить("СрокРазмещения", "с " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " по " + Формат(Выборка.СрокРазмещения, "ДФ=dd.MM.yyyy"));
		СтрокаДанных.Вставить("НомерДатаДоговораСоСпецДепозитарием", СтрокаДанных.НомерДоговораДепозитарногоОбслуживания + " от " + Формат(СтрокаДанных.ДатаДоговораДепозитарногоОбслуживания, "ДЛФ=DD"));
		СтрокаДанных.Вставить("НомерДатаДоговораБанковскогоОбслуживания", СтрокаДанных.НомерДоговораБанковскогоОбслуживания + " от " + Формат(СтрокаДанных.ДатаДоговораБанковскогоОбслуживания, "ДЛФ=DD"));
		СтрокаДанных.Вставить("Сумма", Формат(Выборка.Сумма, "ЧДЦ="));
		СтрокаДанных.Вставить("СуммаПрописью", ЧислоПрописью(Выборка.Сумма, "Л = ru_RU; НП = Ложь; НД = Ложь", СтрЗаменить(Выборка.ПараметрыПрописиВалютыНаРусском, "2 знака", "0")));
		СтавкаЦелаяЧасть = Цел(Выборка.Ставка);
		СтавкаДробнаяЧасть = Выборка.Ставка - СтавкаЦелаяЧасть;
		
		Если СтрДлина(СокрЛП(СтавкаДробнаяЧасть)) = 3 Тогда
			СтрокаДанных.Вставить("СтавкаПрописью", ЧислоПрописью(Выборка.Ставка, "Л = ru_RU; ДП = Истина","целая,целых,целых,ж,десятая,десятых,десятых, ж,1"));
		Иначе
			СтрокаДанных.Вставить("СтавкаПрописью", ЧислоПрописью(Выборка.Ставка, "Л = ru_RU; ДП = Истина","целая,целых,целых,ж,сотая,сотых,сотых, ж,2"));
		КонецЕсли;	
		
		СтрокаДанных.Вставить("ДатаДоговораМНО", 					Формат(Выборка.ДатаДоговораМНО, "ДФ=dd.MM.yyyy"));
		СтрокаДанных.Вставить("НомерДатаГенСоглашения", 			Выборка.НомерДоговораМНО + " от " + Формат(Выборка.ДатаДоговораМНО, "ДФ=dd.MM.yyyy"));
		
		СтрокаДанных.Вставить("Дата", 								Формат(Выборка.Дата, "ДЛФ=DD"));
		СтрокаДанных.Вставить("НомерПодтверждения", 				Выборка.НомерДопСоглашения);
		СтрокаДанных.Вставить("ДатаПодтверждения", 					Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
		СтрокаДанных.Вставить("НомерДопСоглашения", 				СокрЛП(Выборка.НомерДоговораМНО) + "/" + Выборка.НомерДопСоглашения);
		СтрокаДанных.Вставить("ИмяФайла", 							СокрЛП(СтрокаДанных.СчетДУ) + "_" + Выборка.НомерДопСоглашения  + "_" + Формат(СтрокаДанных.ИмяФайла, "ДФ=dd.MM.yyyy"));
		СтрокаДанных.Вставить("СрокИсполненияОбязанностейСторон", 	ТекДата);
				
		ДанныеДляПечати.Добавить(СтрокаДанных);
		
	КонецЦикла;
		
	Возврат ДанныеДляПечати;  
	
КонецФункции

&НаСервере
Функция ПолучитьОбщиеРеквизитыДляПечати(МассивСчетовДУ, Подписант)
	
	РеквизитыОрганизации = Новый Структура("НаименованиеУК, ИННОрганизации, КППОрганизации, АдресОрганизации, ИмяФайла, Подписант, Основание, ПодписантДолжность");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеУК,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННОрганизации,
		|	РеквизитыЮридическихЛицСрезПоследних.КПП КАК КППОрганизации,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК АдресОрганизации,
		|	КонтактныеЛица.КонтактноеЛицо.Представление КАК Подписант,
		|	КонтактныеЛица.ОснованиеПолномочий КАК Основание,
		|	ЕСТЬNULL(КонтактныеЛица.Должность, """") КАК ПодписантДолжность
		|ИЗ
		|	Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &ЮрЛицо
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Объект = &ЮрЛицо
		|					И Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО ЮрФизЛица.Ссылка = КонтактнаяИнформацияСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО ЮрФизЛица.Ссылка = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.КонтактноеЛицо = &Подписант)
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	ЮрФизЛица.Ссылка = &ЮрЛицо";
	                       
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("ЮрЛицо", ЮрЛицоОрганизации);
	Запрос.УстановитьПараметр("Подписант", Подписант);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогФайлов;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогФайлов = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Объект.Организация, Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ПодписантДолжность = СтруктураДанныхКонтактногоЛица.Должность;
	ВыбранноеЗначение  = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьЗапросыСогласияНаРазмещениеДепозитов(Организация, ЮрЛицоОрганизации, МассивСчетовДУ, Период, КаталогФайлов, Подписант, ДолжностьПодписанта, ТекМакет, ПараметрыСессии)
	
	Если Не ЗначениеЗаполнено(Подписант) Тогда
		ТекстОшибки = "Для формирования запросов согласий на размещение депозитов необходимо указать подписанта";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;

	КаталогДаты = "\" + Формат(Период, "ДФ=yyyy.MM") + "\" + Формат(Период, "ДФ=yyyy.MM.dd") + "\"; 
	ТекКаталогФайлов = КаталогФайлов + "\" + "Согласия_на_депозиты" + КаталогДаты;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
	Если Отказ Тогда
		ТекстОшибки = "Выгрузка запросов согласий на размещение депозитов прервана.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _ДанныеРаспоряжений
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.ДатаРазмещения = &Период
		|	И Распоряжение.Организация = &Организация
		|	И Распоряжение.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	И НЕ Распоряжение.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК Объект,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыБанков
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ДанныеРаспоряжений.Банк.ЮрФизЛицо
		|					ИЗ
		|						_ДанныеРаспоряжений КАК _ДанныеРаспоряжений)
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ДоговораСпецдепа
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеРаспоряжений.Организация = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеРаспоряжений.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания))
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент = &ЮрЛицоНСД)
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеРаспоряжений.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаСписания,
		|	_ДанныеРаспоряжений.РасчетныйСчетВозвратаДенежныхСредств.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаВозврата,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговораДУ,
		|	_ДанныеРаспоряжений.ДатаРазмещения КАК ДатаРазмещения,
		|	_РеквизитыБанков.ПолноеНаименованиеПоУставу КАК НаименованиеБанка,
		|	_РеквизитыБанков.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанка,
		|	_РеквизитыБанков.ИНН КАК ИннБанка,
		|	_РеквизитыБанков.ОГРН КАК ОгрнБанка,
		|	_ДанныеРаспоряжений.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ДанныеРаспоряжений.Валюта = &Российский_рубль
		|			ТОГДА ""РФ""
		|		ИНАЧЕ _ДанныеРаспоряжений.Валюта.НаименованиеПолное
		|	КОНЕЦ КАК НаименованиеВалюты,
		|	ВЫБОР
		|		КОГДА _ДанныеРаспоряжений.Валюта = &Российский_рубль
		|			ТОГДА ""RUR""
		|		ИНАЧЕ _ДанныеРаспоряжений.Валюта.Наименование
		|	КОНЕЦ КАК СимвольныйКодВалюты,
		|	_ДанныеРаспоряжений.Валюта.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	_ДанныеРаспоряжений.Процент КАК Процент,
		|	РАЗНОСТЬДАТ(_ДанныеРаспоряжений.ДатаРазмещения, _ДанныеРаспоряжений.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	_ДоговораСпецдепа.Номер КАК НомерДоговораСпецдепа,
		|	_ДоговораСпецдепа.ДатаЗаключения КАК ДатаДоговораСпецдепа
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыБанков КАК _РеквизитыБанков
		|		ПО _ДанныеРаспоряжений.Банк.ЮрФизЛицо = _РеквизитыБанков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДоговораСпецдепа КАК _ДоговораСпецдепа
		|		ПО _ДанныеРаспоряжений.СчетДоверительногоУправления = _ДоговораСпецдепа.СчетДоверительногоУправления";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ЮрЛицоОрганизации);
	Запрос.УстановитьПараметр("ЮрЛицоНСД", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"), "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Российский_рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Количество() = 0 Тогда
		ТекстОшибки = "Отсутствуют распоряжения на размещение депозитных вкладов с датой размещения [" + Формат(Период, "ДФ=dd.MM.yyyy") + "].";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;		
	КонецЕсли;
		
	Пока Выборка.Следующий() Цикл
			
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ТекМакет.Параметры.ДатаЗапроса = Формат(Выборка.ДатаРазмещения, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.НаименованиеКлиента = ?(ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДляДокументовСчетаСписания), Выборка.НаименованиеВладельцаДляДокументовСчетаСписания, Выборка.НаименованиеВладельцаДляДокументовСчетаВозврата);

		ТекНаименованиеКлиента = ?(ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДляДокументовСчетаСписания), Выборка.НаименованиеВладельцаДляДокументовСчетаСписания, Выборка.НаименованиеВладельцаДляДокументовСчетаВозврата);
		
		ТекМакет.Параметры.НаименованиеКлиента = ТекНаименованиеКлиента + " (" + Выборка.НомерДоговораДУ + " от " + Формат(Выборка.ДатаДоговораДУ, "ДФ='dd.MM.yyyy ''г.'''") + ")";
		
		ТекМакет.Параметры.НомерДоговораСпецдепа = Выборка.НомерДоговораСпецдепа;
		ТекМакет.Параметры.ДатаДоговораСпецдепа = Формат(Выборка.ДатаДоговораСпецдепа, "ДФ='dd.MM.yyyy ''г.'''");
		
		ТекМакет.Параметры.ВидРаспоряжения = "Заключение договора срочного депозита со сроком привлечения до года/свыше года";
		ТекМакет.Параметры.НаименованиеКонтрагента = Выборка.НаименованиеБанка;
		ТекМакет.Параметры.ИннКонтрагента = Выборка.ИннБанка;
		ТекМакет.Параметры.ОгрнКонтрагента = Выборка.ОгрнБанка;
		ТекМакет.Параметры.ТипДоговора = "Договор срочного депозита со сроком привлечения до года/свыше года";
		ТекМакет.Параметры.ВладелецСчета = "клиент"; 
		
		ТекМакет.Параметры.СимвольныйКодВалюты = Выборка.СимвольныйКодВалюты;
		ТекМакет.Параметры.НаименованиеВалюты = Выборка.НаименованиеВалюты;

		ТекСумма = Формат(Выборка.Сумма, "ЧДЦ=2");
		ТекМакет.Параметры.Сумма = ТекСумма;
		
		ТекСуммаПрописью = ЧислоПрописью(Выборка.Сумма,, Выборка.ПараметрыПрописиВалютыНаРусском);
		ТекСрокПрописью = ЧислоПрописью(Выборка.Срок, "Л=ru_RU; НП=Ложь", ",,,,,,,,0");
		ТекСтавкаПрописью = ЧислоПрописью(Выборка.Процент, "Л=ru_RU; ДП=ИСТИНА", "целая, целых, целых, ж, сотая, сотой, сотых, ж, 2");
 
		ТекМакет.Параметры.УсловияСделки = 
			"Сумма размещения " + ТекСумма + " (" + ТекСуммаПрописью + ") (далее - депозит) на срок " + Выборка.Срок + " (" + ТекСрокПрописью + ")"
			+ " " + СтрокаСЧислом("; день;; дня; дней; дня", Выборка.Срок, ВидЧисловогоЗначения.Количественное, "L=ru") + ","
			+ " не может быть востребована Клиентом досрочно, за исключением случая, указанного в п.4.6 настоящего Договора,"
			+ " ставка " + Формат(Выборка.Процент, "ЧДЦ=2") + " (" + ТекСтавкаПрописью + ") % годовых";
		
		ТекМакет.Параметры.ПодписантФИО = Подписант;
		ТекМакет.Параметры.ДолжностьПодписанта = ДолжностьПодписанта;				
		ТабличныйДокумент.Вывести(ТекМакет);
		
		ТабличныйДокумент.ОтображатьСетку = Ложь;
		ТабличныйДокумент.Защита = Ложь;
		ТабличныйДокумент.ТолькоПросмотр = Ложь;
		ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(Организация) + "_"
					+ Строка(Выборка.СчетДоверительногоУправления) + "_" + Выборка.КраткоеНаименованиеБанка + "_"
					+ Формат(Выборка.Сумма, "ЧДЦ=0") + "_" + Строка(Выборка.Срок) + "_" + Формат(Выборка.ДатаРазмещения, "ДФ=ddMMyyyy")) + ".docx"; 
		
		Попытка 
			
			ТабличныйДокумент.Записать(ТекКаталогФайлов + ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);
						
		Исключение
			ТекстОшибки = "Ошибка сохранения файла " + ТекКаталогФайлов + ИмяФайла + ": " + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СформироватьЗапросыСогласияНаПереводыСоСчетовБрокера(Организация, ЮрЛицоОрганизации, МассивСчетовДУ, Период, КаталогФайлов, Подписант, ДолжностьПодписанта, ТекМакет, ПараметрыСессии)
	
	Если Не ЗначениеЗаполнено(Подписант) Тогда
		ТекстОшибки = "Для формирования запросов согласий на переводы со счетов брокера необходимо указать подписанта";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;

	КаталогДаты = "\" + Формат(Период, "ДФ=yyyy.MM") + "\" + Формат(Период, "ДФ=yyyy.MM.dd") + "\"; 
	ТекКаталогФайлов = КаталогФайлов + "\" + "Согласия_на_переводы" + КаталогДаты;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
	Если Отказ Тогда
		ТекстОшибки = "Выгрузка запросов согласий на переводы со счетов брокера прервана.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоручение.Ссылка КАК Ссылка,
		|	ДокПоручение.Организация КАК Организация,
		|	ДокПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручение.Брокер КАК Брокер,
		|	ДокПоручение.Брокер.ЮрФизЛицо КАК БрокерЮрЛицо,
		|	ДокПоручение.РасчетныйСчетПолучатель КАК СчетПолучатель,
		|	ДокПоручение.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
		|	ДокПоручение.Сумма КАК Сумма,
		|	ДокПоручение.Валюта КАК Валюта
		|ПОМЕСТИТЬ _ДанныеПоручений
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ПО ДокПоручение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация
		|			И ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления
		|			И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(, ) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
		|		ПО ДокПоручение.Ссылка = СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ДокПоручение.Дата, ДЕНЬ) = &Период
		|	И ДокПоручение.Организация = &Организация
		|	И ДокПоручение.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ДокПоручение.Проведен
		|	И ДокПоручение.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ДокПоручение.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ)
		|	И НЕ ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) В (ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК Объект,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыЮрЛиц
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ДанныеПоручений.БрокерЮрЛицо
		|					ИЗ
		|						_ДанныеПоручений КАК _ДанныеПоручений
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ДанныеПоручений.БанкЮрЛицо
		|					ИЗ
		|						_ДанныеПоручений КАК _ДанныеПоручений)
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ДоговораСпецдепа
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеПоручений.Организация = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеПоручений.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания))
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент = &ЮрЛицоНСД)
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеПоручений.СчетПолучатель.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
		|	_ДанныеПоручений.СчетПолучатель.НомерСчета КАК НомерСчета,
		|	_ДанныеПоручений.Брокер КАК Брокер,
		|	_РеквизитыБанков.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанка,
		|	_РеквизитыБК.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБК,
		|	_РеквизитыБК.ИНН КАК ИннБК,
		|	_РеквизитыБК.ОГРН КАК ОгрнБК,
		|	_ДанныеПоручений.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ДанныеПоручений.Валюта = &Российский_рубль
		|			ТОГДА ""РФ""
		|		ИНАЧЕ _ДанныеПоручений.Валюта.НаименованиеПолное
		|	КОНЕЦ КАК НаименованиеВалюты,
		|	ВЫБОР
		|		КОГДА _ДанныеПоручений.Валюта = &Российский_рубль
		|			ТОГДА ""RUR""
		|		ИНАЧЕ _ДанныеПоручений.Валюта.Наименование
		|	КОНЕЦ КАК СимвольныйКодВалюты,
		|	_ДоговораСпецдепа.Номер КАК НомерДоговораСпецдепа,
		|	_ДоговораСпецдепа.ДатаЗаключения КАК ДатаДоговораСпецдепа,
		|	КодыУБрокеров.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговораБК,
		|	КодыУБрокеров.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаДоговораБК
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанков
		|		ПО _ДанныеПоручений.БанкЮрЛицо = _РеквизитыБанков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБК
		|		ПО _ДанныеПоручений.БрокерЮрЛицо = _РеквизитыБК.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДоговораСпецдепа КАК _ДоговораСпецдепа
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = _ДоговораСпецдепа.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ДанныеПоручений.СчетДоверительногоУправления
		|						ИЗ
		|							_ДанныеПоручений КАК _ДанныеПоручений)) КАК КодыУБрокеров
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = КодыУБрокеров.СчетДоверительногоУправления
		|			И _ДанныеПоручений.Брокер = КодыУБрокеров.Брокер";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ЮрЛицоОрганизации);
	Запрос.УстановитьПараметр("ЮрЛицоНСД", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"), "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Российский_рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Количество() = 0 Тогда
		ТекстОшибки = "На дату [" + Формат(Период, "ДФ=dd.MM.yyyy") + "] отсутствуют поручения на переводы со счетов брокера.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;		
	КонецЕсли;
		
	Пока Выборка.Следующий() Цикл
			
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ТекМакет.Параметры.ДатаЗапроса = Формат(Период, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.НаименованиеКлиента = Выборка.НаименованиеВладельцаДляДокументов;
		
		ТекМакет.Параметры.НомерДоговораСпецдепа = Выборка.НомерДоговораСпецдепа;
		ТекМакет.Параметры.ДатаДоговораСпецдепа = Формат(Выборка.ДатаДоговораСпецдепа, "ДФ='dd.MM.yyyy ''г.'''");
		
		ТекМакет.Параметры.ВидРаспоряжения = "Возврат брокером денежных средств на р/с " + Выборка.НомерСчета + " в " + Выборка.КраткоеНаименованиеБанка;
		ТекМакет.Параметры.НаименованиеКонтрагента = Выборка.КраткоеНаименованиеБК;
		ТекМакет.Параметры.ИннКонтрагента = Выборка.ИннБК;
		ТекМакет.Параметры.ОгрнКонтрагента = Выборка.ОгрнБК;
		ТекМакет.Параметры.ТипДоговора = "Соглашение о брокерском обслуживании";
		ТекМакет.Параметры.НомерДоговора = СокрЛП(Выборка.НомерДоговораБК);
		ТекМакет.Параметры.ДатаДоговора = Формат(Выборка.ДатаДоговораБК, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.ДатаДействияСогласия = "по " + Формат(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Период + 1, 1), "ДФ='dd.MM.yyyy ''г.'''");
		
		ТекМакет.Параметры.ВладелецСчета = "брокер"; 
		ТекМакет.Параметры.Сумма = Формат(Выборка.Сумма, "ЧДЦ=2");
		ТекМакет.Параметры.СимвольныйКодВалюты = Выборка.СимвольныйКодВалюты;
		ТекМакет.Параметры.НаименованиеВалюты = Выборка.НаименованиеВалюты;
						
		ТекМакет.Параметры.ПодписантФИО = Подписант;
		ТекМакет.Параметры.ДолжностьПодписанта = ДолжностьПодписанта;
				
		ТабличныйДокумент.Вывести(ТекМакет);
		
		ТабличныйДокумент.ОтображатьСетку = Ложь;
		ТабличныйДокумент.Защита = Ложь;
		ТабличныйДокумент.ТолькоПросмотр = Ложь;
		ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла("Запрос_на_согласие_СД_вывод_с_брокера_" + Строка(Организация) + "_"
					+ Выборка.СчетДоверительногоУправления + "_" + Выборка.КраткоеНаименованиеБанка + "_" +
					+ Формат(Выборка.Сумма, "ЧДЦ=0") + "_" + Формат(Период, "ДФ=ddMMyyyy")) + ".docx"; 
		
		Попытка 
			
			ТабличныйДокумент.Записать(ТекКаталогФайлов + ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);
						
		Исключение
			ТекстОшибки = "Ошибка сохранения файла " + ТекКаталогФайлов + ИмяФайла + ": " + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
			Возврат;
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		ЭтаФорма.ПодписантДолжность = "";	
	КонецЕсли;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
