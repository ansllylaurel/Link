
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период      = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ЭтаФорма.МакетЗапросаСогласия = ОбъектНаСервере.ПолучитьМакет("ФормаЗапросаСогласияНаРаспоряжениеИмуществом");
	ЭтаФорма.ШаблонЗапросаНаПодтверждениеМНО = ОбъектНаСервере.ПолучитьМакет("ШаблонПодтвержденияМНО");
	ЭтаФорма.ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо");
	
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаСЧА", "Сверка СЧА (ПН, ПР)");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаРСА", "Сверка РСА (ПН)");	
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("МНО", "МНО");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаСогласияНаРазмещениеДепозитов", "Согласия на размещение депозитов"); 
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаСогласияНаПереводыСоСчетовБрокера", "Согласия на переводы со счетов брокера на р/с");
	
	// создадим реквизиты формы
	ДобавляемыеРеквизитыФормы = Новый Массив;
		
	Для каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаРСА" Тогда 
			НаименованиеРеквизита = "РСА (ПН)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаРазмещениеДепозитов" Тогда 
			НаименованиеРеквизита = "Депозиты";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаПереводыСоСчетовБрокера" Тогда 
			НаименованиеРеквизита = "Переводы"; 
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Значение;
		КонецЕсли;
				
		ДобавляемыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево")));					
		ДобавляемыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево"), "АктивныеСчетаДоверительногоУправления", НаименованиеРеквизита));
					
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизитыФормы, Новый Массив);// УдаляемыеРеквизитыФормы);
	
	// создадим элементы управления, соотв. новым реквизитам формы
	Для каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаСЧА" Тогда 
			НаименованиеРеквизита = "СЧА (ПН, ПР)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаРСА" Тогда 
			НаименованиеРеквизита = "РСА (ПН)";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаРазмещениеДепозитов" Тогда 
			НаименованиеРеквизита = "Депозиты";
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаПереводыСоСчетовБрокера" Тогда 
			НаименованиеРеквизита = "Переводы";
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Значение;
		КонецЕсли;

		ПолеФлажкаФормы = Элементы.Добавить(ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.ГруппаФормы);
		ПолеФлажкаФормы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаФормы.ПутьКДанным        = ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаФормы.Заголовок          = ФормаПервичныхДокументовСЭД.Представление;
		ПолеФлажкаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		
		ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ФлажкиФормПриИзменении");
		
		ПолеФлажкаТаблицы = Элементы.Вставить("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.АктивныеСчетаДоверительногоУправления, Элементы.АктивныеСчетаДоверительногоУправленияФлажок);
		ПолеФлажкаТаблицы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаТаблицы.ПутьКДанным        = "АктивныеСчетаДоверительногоУправления." + ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаТаблицы.Заголовок          = НаименованиеРеквизита;
		ПолеФлажкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажкаТаблицы.ТолькоПросмотр     = Истина;
		
		//Запросы согласия и МНО формируются за текущий день, СЧА и РСА за предыдущий день. 
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаРазмещениеДепозитов"
			Или ФормаПервичныхДокументовСЭД.Значение = "ФормаСогласияНаПереводыСоСчетовБрокера"
			Или ФормаПервичныхДокументовСЭД.Значение = "МНО" 
			Или ФормаПервичныхДокументовСЭД.Значение = "ФормаРСА" И Объект.Период >= '20231101' Тогда 
			
			ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = Ложь;
			
		Иначе
			ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = Истина;	
		Конецесли;
		
	КонецЦикла;
	
	ОбновитьНаСервере(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьИДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьИДоступность()
		
	ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправленияФормаСЧА"].Видимость = ЭтаФорма["ФормаСЧА"];
	ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправленияМНО"].Видимость = ЭтаФорма["МНО"];
	ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправленияФормаСогласияНаРазмещениеДепозитов"].Видимость = ЭтаФорма["ФормаСогласияНаРазмещениеДепозитов"];
	ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправленияФормаСогласияНаПереводыСоСчетовБрокера"].Видимость = ЭтаФорма["ФормаСогласияНаПереводыСоСчетовБрокера"];
	
	ЭтаФорма.Элементы["АктивныеСчетаДоверительногоУправленияФормаРСА"].Видимость = (Объект.Период < '20231101');
	ЭтаФорма.Элементы["ФормаРСА"].Видимость = (Объект.Период < '20231101'); 
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновить");
	Попытка
		ОбновитьНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
			
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСнятьФлажки");
	Попытка
