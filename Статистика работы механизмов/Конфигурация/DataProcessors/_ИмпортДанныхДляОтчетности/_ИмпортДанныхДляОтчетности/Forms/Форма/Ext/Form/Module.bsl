
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	
	ДобавитьТаблицуНастроек();
	
	РеквизитФормыОбъект = РеквизитФормыВЗначение("Объект");
	НастройкиВидимостиРеквизитов	= РеквизитФормыОбъект.ПолучитьНастройкиВидимостиРеквизитов();
	МассивРеквизитовБулево			= РеквизитФормыОбъект.ПолучитьМассивРеквизитовБулево();
	ЗначенияРеквизитовПоУмолчанию	= РеквизитФормыОбъект.ПолучитьЗначенияРеквизитовПоУмолчанию();
	
	ЗаполнитьВариантыИмпорта();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВариантИмпортаПриИзменении("");	
	
	ЭтаФорма.СохраняемыеВНастройкахДанныеМодифицированы = Истина;

КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполнения(ПараметрыСессии = Неопределено)

	Отказ = Ложь;
	
	ОбязательныеРеквизиты	= Новый Структура;
	ИспользуемыеФайлы	= Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВариантИмпорта) Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Поле ""Вариант импорта"" не заполнено");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вариант импорта"" не заполнено",,, "Объект.ВариантИмпорта", Отказ);
	КонецЕсли;
	
	Если Элементы.ГруппаИсточникДанных.Видимость Тогда
		Если ЭтаФорма.ИсточникДанных = "Интернет" Тогда
			ОбязательныеРеквизиты.Вставить("СсылкаНаФайл",	"Ссылка");
			//ИспользуемыеФайлы.Вставить("СсылкаНаФайл",	"Ссылка");	
		ИначеЕсли ЭтаФорма.ИсточникДанных = "Файл" Тогда
			ОбязательныеРеквизиты.Вставить("ИмяФайла",	"Имя файла");
			ИспользуемыеФайлы.Вставить("ИмяФайла",	"Имя файла");
		КонецЕсли;
		
		ОбязательныеРеквизиты.Вставить("ДатаПубликации", "Дата публикации");
	КонецЕсли;
	
	Для Каждого Реквизит Из ОбязательныеРеквизиты Цикл
		Если НЕ ЗначениеЗаполнено(ЭтаФорма[Реквизит.Ключ]) Тогда
			ДобавитьТекстОшибки(ПараметрыСессии, "Поле """ + Реквизит.Значение + """ не заполнено");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле """ + Реквизит.Значение + """ не заполнено",,, Реквизит.Ключ, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из ИспользуемыеФайлы Цикл
		Если ЗначениеЗаполнено(ЭтаФорма[Реквизит.Ключ]) Тогда
			Файл = Новый Файл(ЭтаФорма[Реквизит.Ключ]);
			Если НЕ Файл.Существует() Тогда
				ДобавитьТекстОшибки(ПараметрыСессии, "Файл указанный в поле """ + Реквизит.Значение + """ не обнаружен");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл указанный в поле """ + Реквизит.Значение + """ не обнаружен",,, Реквизит.Ключ, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ВидимостьРеквизитов()
	
	//видимость задаётся в макете ВидимостьРеквизитов
	
	Если ЗначениеЗаполнено(Объект.ВариантИмпорта) Тогда
		Если НастройкиВидимостиРеквизитов.Свойство(Объект.ВариантИмпорта) Тогда
			Для Каждого НастройкаВидимости Из НастройкиВидимостиРеквизитов[Объект.ВариантИмпорта] Цикл
				Если ТипЗнч(НастройкаВидимости.Значение) = Тип("Булево") Тогда
					Элементы[НастройкаВидимости.Ключ].Видимость = НастройкаВидимости.Значение;
				Иначе
					Элементы[НастройкаВидимости.Ключ].Видимость = ЭтаФорма[НастройкаВидимости.Значение];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого РеквизитБулево Из МассивРеквизитовБулево Цикл
		//Если реквизит булево и для варианта отчёта не используется установим значение ЛОЖЬ
		//реквизиты невыведенные на форму описаны в массиве исключений функции ПолучитьМассивРеквизитовБулево
		Если НЕ ВидимостьРеквизита(РеквизитБулево) Тогда
			Объект[РеквизитБулево] = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	//Для Каждого Страница Из Элементы.ГруппаПечатныеФормы.ПодчиненныеЭлементы Цикл
	//	Если Страница.Видимость Тогда
	//		Элементы.ГруппаПечатныеФормы.ТекущаяСтраница = Страница;	
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СобытияРеквизитовФормы

&НаКлиенте
Процедура ВариантИмпортаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СохранитьДанныеВНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантИмпортаПриИзменении(Элемент)
	
	ВосстановитьДанныеИзНастроек(Объект.ВариантИмпорта);	
	ВидимостьРеквизитов();
	
	Если ЗначениеЗаполнено(Объект.ВариантИмпорта) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитовПоУмолчанию[Объект.ВариантИмпорта]); 
		
		Если Элементы.ГруппаИсточникДанных.Видимость Тогда
			ОбновитьДатуПубликации(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьСписокФайлов(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	СохранитьДанныеВНастройки();
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	
	ВосстановитьДанныеИзНастроек(Объект.ВариантИмпорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр				= "(*.*)|*.*";
	Диалог.ПолноеИмяФайла		= ЭтаФорма.ИмяФайла;
	Диалог.МножественныйВыбор	= Ложь; 
	Диалог.Заголовок			= "Файл с отчётом:"; 
	
	Если Диалог.Выбрать() Тогда 
		ЭтаФорма.ИмяФайла = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(ЭтаФорма.ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникДанныхПриИзменении(Элемент)
	
	Элементы.СсылкаНаФайл.Видимость	= (ЭтаФорма.ИсточникДанных = "Интернет");
	Элементы.ИмяФайла.Видимость		= (ЭтаФорма.ИсточникДанных = "Файл");
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаФайлПриИзменении(Элемент)
	
	ОбновитьДатуПубликации(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Поле = Элементы.ТаблицаФайловИспользуется Тогда
		Если ТекущиеДанные.Используется Тогда
			Предупреждение("Отменить использование файла можно только выбрав другой файл для использования");
			
		ИначеЕсли Вопрос("Загрузить данные файла в список на " + Формат(ТекущиеДанные.ДатаПубликации, "ДФ=dd.MM.yy") + "?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			
			ПараметрыКоманды = Новый Структура("Отказ", Ложь);
			ПараметрыКоманды.Вставить("ВариантИмпорта",			Объект.ВариантИмпорта);
			ПараметрыКоманды.Вставить("ИдентификаторИсточника", ЭтаФорма.ИдентификаторИсточника);
			ПараметрыКоманды.Вставить("ИдентификаторФайла", 	ТекущиеДанные.Идентификатор);
			ПараметрыКоманды.Вставить("ДатаПубликации", 		ТекущиеДанные.ДатаПубликации);
			
			ВыполнитьИмпортНаСервере(ПараметрыКоманды);

		КонецЕсли;	
		
	ИначеЕсли Вопрос("Открыть файл?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		
		ЧастиАдресаФайла = СтрРазделить(ТекущиеДанные.ИмяФайла, "/\");
		ИмяФайла = ЧастиАдресаФайла[ЧастиАдресаФайла.ВГраница()];
		ИмяФайла = РаботаСФайламиКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
		ИмяВременногоФайла = КаталогВременныхФайлов() + ИмяФайла;
		
		ДвоичныеДанные = ПолучитьДанныеФайла(ТекущиеДанные.Идентификатор);
		
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			ЗапуститьПриложение(ИмяВременногоФайла);
		Иначе
			ВызватьИсключение "Ошибка получения файла из Externals!";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеФайла(Идентификатор)
	
	Возврат ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Files.НайтиПоПолю("id", Идентификатор).File_Data;

КонецФункции

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ВыполнитьИмпорт(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнитьИмпорт");
	Попытка
		ВыполнитьИмпортДанных(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИмпортДанных(ПараметрыСессии)
	
	Отказ = Ложь;
	
	Если Не ПроверкаЗаполнения(ПараметрыСессии) Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Проверка заполнения не пройдена");
		Возврат;
	КонецЕсли;
	
	ПараметрыКоманды = Новый Структура("Отказ", Ложь);
	ПараметрыКоманды.Вставить("ВариантИмпорта", Объект.ВариантИмпорта);
	
	Если Элементы.ГруппаИсточникДанных.Видимость Тогда
		Если ЭтаФорма.ИсточникДанных = "Интернет" Тогда
			ПараметрыКоманды.Вставить("РеквизитыФайла", УпаковатьФайл("СсылкаНаФайл"));	
		ИначеЕсли ЭтаФорма.ИсточникДанных = "Файл" Тогда
			ПараметрыКоманды.Вставить("РеквизитыФайла", УпаковатьФайл("ИмяФайла"));	
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("ИдентификаторИсточника", ЭтаФорма.ИдентификаторИсточника);
	
	Если Элементы.ДатаПубликации.Видимость Тогда
		ПараметрыКоманды.Вставить("ДатаПубликации", ЭтаФорма.ДатаПубликации);
	КонецЕсли;
	
	ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды);
	
	Если ПараметрыКоманды.Свойство("ИдентификаторФайла") Тогда
		Если ПараметрыКоманды.Используется Тогда
			Предупреждение(СтрШаблон("Файл '%1' уже загружался '%2'", ПараметрыКоманды.РеквизитыФайла.АдресФайла, ПараметрыКоманды.ВремяЗагрузки));
			ДобавитьТекстОшибки(ПараметрыСессии, "Файл уже загружался");
			Возврат;
		ИначеЕсли Вопрос(СтрШаблон(
			 "Файл '%1' уже загружался '%2', но данные файла не используются, загрузить данные файла? Текущее данные будут удалены.", 
			 ПараметрыКоманды.РеквизитыФайла.АдресФайла, 
			 ПараметрыКоманды.ВремяЗагрузки), РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да 
		Тогда
			ДобавитьТекстОшибки(ПараметрыСессии, "Пользователь отменил загрузку файла");
			Возврат;
		КонецЕсли;
		ПараметрыКоманды.Вставить("СохранитьФайл", Ложь);
	Иначе
		ПараметрыКоманды.Вставить("СохранитьФайл", Истина);
	КонецЕсли;
			
	ВыполнитьИмпортНаСервере(ПараметрыКоманды);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьИмпортНаСервере(ПараметрыКоманды)
	
	РеквизитФормыВЗначение("Объект").ВыполнитьИмпорт(ПараметрыКоманды);
	ОбновитьСписокФайловНаСервере();
	
КонецПроцедуры

&НаКлиенте
Функция УпаковатьФайл(ИмяРеквизита)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	КопироватьФайл(ЭтаФорма[ИмяРеквизита], ИмяВременногоФайла);
	
	РеквизитыФайла = Новый Структура();
	РеквизитыФайла.Вставить("АдресФайла"	, ЭтаФорма[ИмяРеквизита]);
	РеквизитыФайла.Вставить("АдресФайлаВХ"	, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), ЭтаФорма.УникальныйИдентификатор));
	РеквизитыФайла.Вставить("ИмяРеквизита"	, ИмяРеквизита);
	
	Возврат РеквизитыФайла;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокФайлов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОбновитьСписокФайлов");
	Попытка
		ОбновитьСписокФайловНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокФайловНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторИсточника", ЭтаФорма.ИдентификаторИсточника);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_Files.Id КАК Идентификатор,
		|	dbo_Files.File_Name КАК ИмяФайла,
		|	dbo_Files.Upload_Time КАК ВремяЗагрузки,
		|	dbo_Files.Publication_Date КАК ДатаПубликации,
		|	dbo_Files.Id В
		|		(ВЫБРАТЬ
		|			dbo_OKUD0420416_Isin_List.File_Id КАК File_Id
		|		ИЗ
		|			ВнешнийИсточникДанных.Externals.Таблица.dbo_OKUD0420416_Isin_List КАК dbo_OKUD0420416_Isin_List
		|		ГДЕ
		|			dbo_OKUD0420416_Isin_List.Source_Id.Id = &ИдентификаторИсточника) КАК Используется
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|ГДЕ
		|	dbo_Files.Source_Id.Id = &ИдентификаторИсточника
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПубликации";
	
	Объект.ТаблицаФайлов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуПубликации(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ОбновитьДатуПубликации");
	Попытка
		ВыполнитьОбновлениеДатыПубликации(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеДатыПубликации(ПараметрыСессии)
	
	Соединение = Новый HTTPСоединение("");
	СтраницаФормы = Соединение.Получить(Новый HTTPЗапрос(ЭтаФорма.АдресСайта)).ПолучитьТелоКакСтроку();
	
	НомерСимволаДата		= СтрНайти(СтраницаФормы, ЭтаФорма.ТегДатыПубликации) + СтрДлина(ЭтаФорма.ТегДатыПубликации);
	ЭтаФорма.ДатаПубликации	= РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтраницаФормы, НомерСимволаДата, 10)); 
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыИмпорта()

	Для Каждого НастройкаВидимости Из НастройкиВидимостиРеквизитов Цикл
		Элементы.ВариантИмпорта.СписокВыбора.Добавить(НастройкаВидимости.Ключ, НастройкаВидимости.Значение.Представление);
		НастройкаВидимости.Значение.Удалить("Представление");
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ВидимостьРеквизита(ИмяРеквизита)
	
	Элемент = Элементы[ИмяРеквизита];
	Пока ТипЗнч(Элемент) = Тип("ГруппаФормы") ИЛИ ТипЗнч(Элемент) = Тип("ПолеФормы") Цикл
		Если НЕ Элемент.Видимость Тогда
			Возврат Ложь;
		КонецЕсли;
		Элемент = Элемент.Родитель;
	КонецЦикла;	
		
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды)
	
	РеквизитФормыВЗначение("Объект").ПолучитьРеквизитыЗагруженногоФайла(ПараметрыКоманды);
	
КонецПроцедуры

#КонецОбласти

#Область СохранениеНастроек

&НаСервере
Процедура ДобавитьТаблицуНастроек()
	
	ПустаяТаблицаЗначений = Новый ТаблицаЗначений;
	ПустаяТаблицаЗначений.Колонки.Добавить("Организация",	Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ПустаяТаблицаЗначений.Колонки.Добавить("Ключ",			Новый ОписаниеТипов("Строка"));
	ПустаяТаблицаЗначений.Колонки.Добавить("Значение");
	ПустаяТаблицаЗначений.Колонки.Добавить("ВариантИмпорта", Новый ОписаниеТипов("Строка"));
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НастройкиФормы", Новый ОписаниеТипов("ТаблицаЗначений"),,, Истина));
	
	Для Каждого Колонка Из ПустаяТаблицаЗначений.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "НастройкиФормы"));	
	КонецЦикла;
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СохраняемыеРеквизиты", Новый ОписаниеТипов));	
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ЭтаФорма.СохраняемыеРеквизиты = ПолучитьСохраняемыеРеквизиты(); 
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеВНастройки()
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
	Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("НастройкиФормы") <> Неопределено Тогда
		ЭтаФорма.НастройкиФормы.Загрузить(СохраненныеНастройки.Получить("НастройкиФормы"));
	КонецЕсли;
	
	СохранитьНастройкиВТаблицу(ЭтаФорма.НастройкиФормы);
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
		
	Если СохраненныеНастройки = Неопределено Тогда
		СохраненныеНастройки = Новый Соответствие;
	КонецЕсли;
	
	СохраненныеНастройки.Вставить("НастройкиФормы", ЭтаФорма.НастройкиФормы.Выгрузить());
	ХранилищеСистемныхНастроек.Сохранить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные", "", СохраненныеНастройки);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьДанныеИзНастроек(ВариантИмпорта)
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
	Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("НастройкиФормы") <> Неопределено Тогда
		ЭтаФорма.НастройкиФормы.Загрузить(СохраненныеНастройки.Получить("НастройкиФормы"));
	КонецЕсли;
	
	СохраняемыеРеквизиты = Новый Структура;
	
	Для Каждого СтрокаНастройки Из ЭтаФорма.НастройкиФормы Цикл
		Если СтрокаНастройки.Организация = Объект.Организация И СтрокаНастройки.ВариантИмпорта = ВариантИмпорта Тогда
			Если ЗначениеЗаполнено(СтрокаНастройки.Значение) Тогда
				СохраняемыеРеквизиты.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Объект		, СохраняемыеРеквизиты);
	ЗаполнитьЗначенияСвойств(ЭтаФорма	, СохраняемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
	Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("НастройкиФормы") <> Неопределено Тогда
		ПерНастройкиФормы = СохраненныеНастройки.Получить("НастройкиФормы");
	Иначе
		ПерНастройкиФормы = ЭтаФорма.НастройкиФормы.Выгрузить();//Настройки.Получить("НастройкиФормы");
	КонецЕсли;
	
	СохранитьНастройкиВТаблицу(ПерНастройкиФормы);
	
	Настройки.Вставить("НастройкиФормы", ПерНастройкиФормы);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиВТаблицу(ПерНастройкиФормы)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма.СохраняемыеРеквизиты, Объект);
	ЗаполнитьЗначенияСвойств(ЭтаФорма.СохраняемыеРеквизиты, ЭтаФорма);
	
	ПараметрыПоиска = Новый Структура("Организация,ВариантИмпорта", Объект.Организация, Объект.ВариантИмпорта);
	НайденныеСтроки = ПерНастройкиФормы.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаНастройки Из НайденныеСтроки Цикл
		ПерНастройкиФормы.Удалить(СтрокаНастройки);
	КонецЦикла;
	
	Для Каждого Реквизит Из ЭтаФорма.СохраняемыеРеквизиты Цикл
		СтрокаНастройки = ПерНастройкиФормы.Добавить();
		СтрокаНастройки.Организация		= Объект.Организация;
		СтрокаНастройки.ВариантИмпорта	= Объект.ВариантИмпорта;
		СтрокаНастройки.Ключ			= Реквизит.Ключ;
		СтрокаНастройки.Значение		= Реквизит.Значение;
	КонецЦикла;
	
КонецПроцедуры

