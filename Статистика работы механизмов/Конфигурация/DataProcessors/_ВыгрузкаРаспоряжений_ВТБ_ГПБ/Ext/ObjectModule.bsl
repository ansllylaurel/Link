
#Область Регистрационные_данные

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Выгрузка распоряжений в клиент-банк (ГПБ, ВТБ)",
		"0.30",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Обработчики_событий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда
		ПроверяемыеРеквизиты.Добавить("Ответственный");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Выгрузка_в_XML

Функция ПолучитьДанныеДляВыгрузки(МассивРаспоряжений) Экспорт
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Ссылка КАК Ссылка,
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.Дата КАК Дата,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	Распоряжение.ДоВостребования КАК ДоВостребования,
		|	Распоряжение.ПроцентнаяСтавкаПриДосрочномЗакрытии КАК ПроцентнаяСтавкаПриДосрочномЗакрытии,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств,
		|	Распоряжение.ВидОперации КАК ВидОперации,
		|	РеквизитыЮрЛицаОрганизации.ИНН КАК ИннЮрЛицаОрганизации,
		|	РеквизитыЮрЛицаОрганизации.КПП КАК КппЮрЛицаОрганизации,
		|	РеквизитыЮрЛицаОрганизации.Телефоны КАК ТелефонЮрЛицаОрганизации,
		|	РеквизитыПодписанта.Фамилия + "" "" + РеквизитыПодписанта.Имя + "" "" + РеквизитыПодписанта.Отчество КАК ПодписантФИО
		|ПОМЕСТИТЬ _Распоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрЛицаОрганизации
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо = &Подписант) КАК РеквизитыПодписанта
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Распоряжение.Организация = &Организация
		|	И НЕ Распоряжение.ПометкаУдаления
		|	И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|				И Распоряжение.РасчетныйСчет.Банк = &Банк
		|				И НАЧАЛОПЕРИОДА(Распоряжение.Дата, ДЕНЬ) = &Период
		|			ИЛИ Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|				И Распоряжение.Банк = &Банк
		|				И Распоряжение.ДатаРазмещения = &Период)
		|	И Распоряжение.Ссылка В(&МассивРаспоряжений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокРаспоряжение.Ссылка КАК Распоряжение,
		|	ДокРаспоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	НастройкиАкцептованияОперацийСрезПоследних.Организация КАК Организация,
		|	НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта КАК ВидАкцепта,
		|	ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ) КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _НастройкиАкцептования
		|ИЗ
		|	_Распоряжения КАК ДокРаспоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(
		|				&КонецДня,
		|				Организация = &Организация
		|					И ВидАкцепта В (ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО), ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНОСрочный30Дней4ПроцентаУКПИ))) КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ПО ДокРаспоряжение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация
		|			И ДокРаспоряжение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления
		|			И (ДокРаспоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиАкцептования.Распоряжение КАК Распоряжение,
		|	ВЫБОР
		|		КОГДА _НастройкиАкцептования.ТребуетсяАкцепт
		|			ТОГДА АкцептованиеОперацийСрезПоследних.Операция ЕСТЬ NULL
		|					ИЛИ АкцептованиеОперацийСрезПоследних.Срок <> ДАТАВРЕМЯ(1, 1, 1)
		|						И АкцептованиеОперацийСрезПоследних.Срок <= &Период
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _АкцептованиеОпераций
		|ИЗ
		|	_НастройкиАкцептования КАК _НастройкиАкцептования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|				&КонецДня,
		|				(Организация, ВидАкцепта) В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.Организация,
		|							_НастройкиАкцептования.ВидАкцепта
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт)
		|					И Операция В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.Распоряжение
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт
		|				
		|						ОБЪЕДИНИТЬ
		|				
		|						ВЫБРАТЬ
		|							_НастройкиАкцептования.РасчетныйСчет
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт)) КАК АкцептованиеОперацийСрезПоследних
		|		ПО _НастройкиАкцептования.Организация = АкцептованиеОперацийСрезПоследних.Организация
		|			И _НастройкиАкцептования.ВидАкцепта = АкцептованиеОперацийСрезПоследних.ВидАкцепта
		|			И (_НастройкиАкцептования.Распоряжение = АкцептованиеОперацийСрезПоследних.Операция
		|				ИЛИ _НастройкиАкцептования.РасчетныйСчет = АкцептованиеОперацийСрезПоследних.Операция)
		|			И (_НастройкиАкцептования.ТребуетсяАкцепт)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&Банк КАК Банк,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры) КАК ДоговорСсылка,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора КАК ВидДоговора,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_Распоряжения.СчетДоверительногоУправления
		|					ИЗ
		|						_Распоряжения КАК _Распоряжения)
		|				И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).Контрагент = ВЫРАЗИТЬ(&Банк КАК Справочник.Банки).ЮрФизЛицо
		|				И ВЫРАЗИТЬ(Договор КАК Справочник.Договоры).ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДоговорМНО), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнительноеСоглашение))) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.Банк КАК Банк,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ПОМЕСТИТЬ _РеквизитыБанков
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		&Банк КАК Банк
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		_Распоряжения.РасчетныйСчет.Банк
		|	ИЗ
		|		_Распоряжения КАК _Распоряжения
		|	ГДЕ
		|		_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		_Распоряжения.РасчетныйСчетВозвратаДенежныхСредств.Банк
		|	ИЗ
		|		_Распоряжения КАК _Распоряжения
		|	ГДЕ
		|		_Распоряжения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Распоряжения.Ссылка КАК Ссылка,
		|	НАЧАЛОПЕРИОДА(_Распоряжения.Дата, ДЕНЬ) КАК Дата,
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.РасчетныйСчет КАК РасчетныйСчет,
		|	_Распоряжения.ДатаВозврата КАК ДатаВозврата,
		|	_Распоряжения.Процент КАК Процент,
		|	_Распоряжения.Сумма КАК Сумма,
		|	_Распоряжения.Валюта КАК Валюта,
		|	_Распоряжения.ИннЮрЛицаОрганизации КАК ИннЮрЛицаОрганизации,
		|	_Распоряжения.КппЮрЛицаОрганизации КАК КппЮрЛицаОрганизации,
