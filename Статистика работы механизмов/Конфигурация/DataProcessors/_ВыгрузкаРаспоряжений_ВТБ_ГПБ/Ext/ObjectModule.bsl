		|	""<accountNumber>"" + _РаспоряженияНаДепозиты.РасчетныйСчетВозвратаДенежныхСредств.НомерСчета + ""</accountNumber><bic>"" + _РаспоряженияНаДепозиты.РасчетныйСчетВозвратаДенежныхСредств.Банк.Код + ""</bic>"" КАК refundAccount,
		|	""DEPOSIT_REFUND"" КАК interestPayoutOption
		|ПОМЕСТИТЬ _РаспоряженияНаДепозитыВТБ
		|ИЗ
		|	_РаспоряженияНаДепозиты КАК _РаспоряженияНаДепозиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиРаспоряжений КАК _ОшибкиРаспоряжений
		|		ПО _РаспоряженияНаДепозиты.Ссылка = _ОшибкиРаспоряжений.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НомераПодтверждений КАК _НомераПодтверждений
		|		ПО _РаспоряженияНаДепозиты.Ссылка = _НомераПодтверждений.Распоряжение
		|			И _РаспоряженияНаДепозиты.СчетДоверительногоУправления = _НомераПодтверждений.СчетДоверительногоУправления
		|			И (_НомераПодтверждений.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.БанкКлиентВТБ)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (КодыВоВнешнихСистемахСрезПоследних.Объект = &Организация)
		|ГДЕ
		|	&РежимВыгрузки = ""ВТБ""
		|	И _ОшибкиРаспоряжений.Ссылка ЕСТЬ NULL";
#КонецОбласти

	Запрос.УстановитьПараметр("Период",	ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Это_УК_Траст", ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	Запрос.УстановитьПараметр("Это_УК_РЭМ", ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("МассивРаспоряжений", МассивРаспоряжений);
	Запрос.УстановитьПараметр("РоссийскийРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("Банк", ?(ЭтотОбъект.РежимВыгрузки = "ГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ГПБ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ")));
	Запрос.УстановитьПараметр("Подписант", ЭтотОбъект.Ответственный);
	Запрос.УстановитьПараметр("РежимВыгрузки", ЭтотОбъект.РежимВыгрузки);

	Результат = Запрос.Выполнить();
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиРаспоряжений"].ПолучитьДанные().Выбрать();
	
	Если ВыборкаОшибок.Количество() > 0 Тогда
		
		Пока ВыборкаОшибок.Следующий() Цикл	
			ДанныеДляВыгрузки.Добавить(Новый Структура("СчетДоверительногоУправления, ВидРаспоряжения, Ставка, Сумма, ВременныйФайл, ТекстСообщения", ВыборкаОшибок.СчетДоверительногоУправления, ВыборкаОшибок.ВидРаспоряжения, ВыборкаОшибок.Ставка, ВыборкаОшибок.Сумма, Неопределено, СтрШаблон(ВыборкаОшибок.ТекстСообщения, ВыборкаОшибок.Ссылка, ВыборкаОшибок.Параметр_2)));
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтотОбъект.РежимВыгрузки = "ГПБ" Тогда
		
		ТипыАтрибутов = ПолучитьТипыАтрибутов();
		
		ТалицаРаспоряжений = Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаМноГПБ"].ПолучитьДанные().Выгрузить();
	
		Если ТалицаРаспоряжений.Количество() > 0 Тогда
			
			РаботаСКоллекциями.ДополнитьМассив(ДанныеДляВыгрузки, СформироватьДанныеДляВыгрузки(ТалицаРаспоряжений, "МНО", ТипыАтрибутов));
			
		ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаМНО"].ПолучитьДанные().Выбрать().Количество() > 0 Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные распоряжений на МНО (Банк ГПБ) на дату [" + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + "].");	
		КонецЕсли;
	
		ТалицаРаспоряжений = Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаДепозитыГПБ"].ПолучитьДанные().Выгрузить();
	
		Если ТалицаРаспоряжений.Количество() > 0 Тогда
			
			РаботаСКоллекциями.ДополнитьМассив(ДанныеДляВыгрузки, СформироватьДанныеДляВыгрузки(ТалицаРаспоряжений, "Депозит", ТипыАтрибутов));
			
		ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаДепозиты"].ПолучитьДанные().Выбрать().Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные распоряжений на размещение депозитов (Банк ГПБ) на дату[" + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + "].");	
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда

		ТалицаРаспоряжений = Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаМноВТБ"].ПолучитьДанные().Выгрузить();
	
		Если ТалицаРаспоряжений.Количество() > 0 Тогда
			
			РаботаСКоллекциями.ДополнитьМассив(ДанныеДляВыгрузки, СформироватьДанныеДляВыгрузки(ТалицаРаспоряжений, "МНО"));
	
		ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаМНО"].ПолучитьДанные().Выбрать().Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные распоряжений на МНО (Банк ВТБ) на дату [" + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + "].");	
		КонецЕсли;
		
		ТалицаРаспоряжений = Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаДепозитыВТБ"].ПолучитьДанные().Выгрузить();
	
		Если ТалицаРаспоряжений.Количество() > 0 Тогда
			
			РаботаСКоллекциями.ДополнитьМассив(ДанныеДляВыгрузки, СформироватьДанныеДляВыгрузки(ТалицаРаспоряжений, "Депозит"));
			
		ИначеЕсли Запрос.МенеджерВременныхТаблиц.Таблицы["_РаспоряженияНаДепозиты"].ПолучитьДанные().Выбрать().Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные распоряжений на размещение депозитов (Банк ВТБ) на дату[" + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + "].");	
		КонецЕсли;
	
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Количество() > 0 Тогда
		Возврат ДанныеДляВыгрузки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

Функция СформироватьДанныеДляВыгрузки(ТаблицаДанных1С, ВидРаспоряжения, ТипыАтрибутов = Неопределено)
	
	МассивДанных = Новый Массив;
	
	МассивИменПолей = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаДанных1С.Колонки Цикл
		
		Если Лев(Колонка.Имя, 1) = "_" Тогда
			Продолжить;	
		КонецЕсли;
		
		МассивИменПолей.Добавить(Колонка.Имя);
			
	КонецЦикла;
	
	ИмяФайла = ПолучитьИмяФайла();
	ТекЗаписьXML = ПолучитьЗаписьXML(ИмяФайла, ВидРаспоряжения);	
	
	Для Каждого СтрокаДанных Из ТаблицаДанных1С Цикл
		
		Если ЭтотОбъект.РежимВыгрузки = "ГПБ" Тогда	
			
			ТекЗаписьXML.ЗаписатьНачалоЭлемента("doc");
			
			Если ЗначениеЗаполнено(СтрокаДанных._id) Тогда
				ТекЗаписьXML.ЗаписатьАтрибут("profile", СтрокаДанных._id);
			Иначе
				ТекЗаписьXML.ЗаписатьАтрибут("id", "");
			КонецЕсли;
				
			ТекЗаписьXML.ЗаписатьАтрибут("type", СтрокаДанных._TYPE);
	
		ИначеЕсли ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда
			
			Если ВидРаспоряжения = "МНО" Тогда
				ТекЗаписьXML.ЗаписатьНачалоЭлемента("Nso");	
			ИначеЕсли ВидРаспоряжения = "Депозит" Тогда
				ТекЗаписьXML.ЗаписатьНачалоЭлемента("Deposit");		
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ИмяПоля Из МассивИменПолей Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаДанных[ИмяПоля]) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЭтотОбъект.РежимВыгрузки = "ГПБ" Тогда
			
				ТекЗаписьXML.ЗаписатьНачалоЭлемента("field");
		
				ТекЗаписьXML.ЗаписатьАтрибут("id", ИмяПоля);
				ТекЗаписьXML.ЗаписатьАтрибут("datatype", ?(ТипыАтрибутов.Получить(ИмяПоля) = Неопределено, "string", ТипыАтрибутов[ИмяПоля]));
				
			ИначеЕсли ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда
				
				ТекЗаписьXML.ЗаписатьНачалоЭлемента(ИмяПоля);	
				
			КонецЕсли;
				
			Если ИмяПоля = "documentNumber" И ВидРаспоряжения = "Депозит" И ЗначениеЗаполнено(СтрокаДанных[ИмяПоля]) Тогда
				
				ТекЗначение = РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(СтрокаДанных[ИмяПоля]);
				
			ИначеЕсли ИмяПоля = "employeePhone" Тогда
				
				Телефон = СокрЛП(СтрокаДанных[ИмяПоля]);
				Телефон = СтрЗаменить(Телефон, "-", "");
				Телефон = СтрЗаменить(Телефон, " ", "");
				
				ТекЗначение = Телефон;
	
			ИначеЕсли ТипЗнч(СтрокаДанных[ИмяПоля]) = Тип("Дата") Тогда
				
				ТекЗначение = Формат(СтрокаДанных[ИмяПоля], СтрокаДанных._ФорматнаяСтрокаДат);
				
			ИначеЕсли ТипЗнч(СтрокаДанных[ИмяПоля]) = Тип("Число") Тогда
				
				Если ИмяПоля = "term" Тогда 
					
					ТекЗначение = Формат(СтрокаДанных[ИмяПоля], "ЧДЦ=0; ЧГ=0");
					
				ИначеЕсли (ИмяПоля <> "DC_RESTTYPE" И ИмяПоля <> "OHD_NUMBER") Тогда
					
					ТекЗначение = Формат(СтрокаДанных[ИмяПоля], "ЧДЦ=2; ЧРД=.; ЧГ=0");
					
				Иначе
					
					ТекЗначение = СтрокаДанных[ИмяПоля];
					
				КонецЕсли;
										
			Иначе
				
				ТекЗначение = СтрокаДанных[ИмяПоля];
				
			КонецЕсли;
			
			ТекЗначение = СокрЛП(ТекЗначение);
			
			Если Не ПустаяСтрока(ТекЗначение) Тогда
				
				Если ИмяПоля = "depositSources" Или ИмяПоля = "refundAccount" Тогда
					ТекЗаписьXML.ЗаписатьБезОбработки(ТекЗначение);	
				Иначе
					ТекЗаписьXML.ЗаписатьТекст(ТекЗначение);
				КонецЕсли;
				
			КонецЕсли;
			
			ТекЗаписьXML.ЗаписатьКонецЭлемента();
			
		КонецЦикла;
		
		ТекЗаписьXML.ЗаписатьКонецЭлемента(); //ГПБ: doc, ВТБ: Nso, Deposit 
		
		Если ЭтотОбъект.ВыгружатьОтдельнымиФайлами Тогда
			
			ТекЗаписьXML.ЗаписатьКонецЭлемента(); //ГПБ: xmldoc, ВТБ: PacketNso, PacketDeposit 
			ТекЗаписьXML.Закрыть();
			
			МассивДанных.Добавить(Новый Структура("СчетДоверительногоУправления, ВидРаспоряжения, Ставка, Сумма, ВременныйФайл, ТекстСообщения", СтрокаДанных._СчетДоверительногоУправления, ВидРаспоряжения, СтрокаДанных._Ставка, СтрокаДанных._Сумма, ИмяФайла));
			
			ИмяФайла = ПолучитьИмяФайла();
			ТекЗаписьXML = ПолучитьЗаписьXML(ИмяФайла, ВидРаспоряжения);
			
		Иначе
	    	МассивДанных.Добавить(Новый Структура("СчетДоверительногоУправления, ВидРаспоряжения, Ставка, Сумма, ВременныйФайл, ТекстСообщения", СтрокаДанных._СчетДоверительногоУправления, ВидРаспоряжения, СтрокаДанных._Ставка, СтрокаДанных._Сумма, Неопределено));
		КонецЕсли;
	
	КонецЦикла;
	
	Если Не ЭтотОбъект.ВыгружатьОтдельнымиФайлами Тогда
			
		ТекЗаписьXML.ЗаписатьКонецЭлемента(); //ГПБ: xmldoc, ВТБ: PacketNso, PacketDeposit
		ТекЗаписьXML.Закрыть();
			
		МассивДанных.Добавить(Новый Структура("СчетДоверительногоУправления, ВидРаспоряжения, Ставка, Сумма, ВременныйФайл, ТекстСообщения", Неопределено, ВидРаспоряжения, "", "", ИмяФайла));
		
	КонецЕсли;
		
	Возврат МассивДанных;
	
КонецФункции

Функция ПолучитьИмяФайла()
	
	Если ЭтотОбъект.РежимВыгрузки = "ГПБ" Тогда
		
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		
	ИначеЕсли ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда
		
		Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
		ИмяФайла = Каталог + Строка(Новый УникальныйИдентификатор) + ".xml";
		
	КонецЕсли;
	
	Возврат ИмяФайла;
	
КонецФункции

Функция ПолучитьЗаписьXML(ИмяФайла, ВидРаспоряжения)
	
	ЗаписьXML = Новый ЗаписьXML;
	
	Если ЭтотОбъект.РежимВыгрузки = "ГПБ" Тогда
					
		ЗаписьXML.ОткрытьФайл(ИмяФайла, "windows-1251");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("xmldoc");
 		
	ИначеЕсли ЭтотОбъект.РежимВыгрузки = "ВТБ" Тогда
				
		ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		Если ВидРаспоряжения = "МНО" Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("PacketNso");
			ЗаписьXML.ЗаписатьАтрибут("xmlns", "PacketNso");
			
		ИначеЕсли ВидРаспоряжения = "Депозит" Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("PacketDeposit");
			ЗаписьXML.ЗаписатьАтрибут("xmlns", "PacketDeposit");
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ЗаписьXML;
	
КонецФункции

Функция ПолучитьТипыАтрибутов() 
	
	ТипыАтрибутов = Новый Соответствие;
	
	ТипыАтрибутов.Вставить("DC_RECIPIENT_ACCOUNT_OWN", "boolean");
	ТипыАтрибутов.Вставить("DC_RETURN_DATE", "date");
	ТипыАтрибутов.Вставить("DC_AGREEMENT_DATE", "date");
	ТипыАтрибутов.Вставить("DC_DISPOSAL_DATE", "date");
	ТипыАтрибутов.Вставить("DC_INTEREST_RATE", "double");
	ТипыАтрибутов.Вставить("DC_RESTTYPE", "integer");
	ТипыАтрибутов.Вставить("OHD_DATE", "date");
	ТипыАтрибутов.Вставить("OHD_AMOUNT", "currency");
	
	Возврат ТипыАтрибутов;
	
КонецФункции

#КонецОбласти