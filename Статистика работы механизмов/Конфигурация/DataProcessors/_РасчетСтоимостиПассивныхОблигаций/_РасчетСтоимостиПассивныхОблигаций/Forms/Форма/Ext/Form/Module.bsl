
&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Знач СтрЧ)
	
	СтрЧ = СтрЗаменить(СтрЧ, " ", "");
	СтрЧ = СтрЗаменить(СтрЧ, ",", ".");
	
	Возврат Число(СтрЧ);
	
КонецФункции // ЧислоИзСтроки

&НаСервереБезКонтекста
Функция НайтиОблигациюПоОписанию(Описание, РегНомер)
	
	РегНомер = Описание;
	РегНомер = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(РегНомер, ",", Истина, Истина);
	
	Если РегНомер.Количество() < 2 Тогда
		ВызватьИсключение "Не удалось выделить рег. номер облигации из описания '" + Описание + "'";
	КонецЕсли;
	
	РегНомер = РегНомер[1];
	
	Облигация = Справочники.Облигации.НайтиПоРеквизиту("ГосударственныйРегистрационныйНомер", РегНомер);
	
	Если Не ЗначениеЗаполнено(Облигация) Тогда
		ВызватьИсключение "Не удалось найти облигацию по рег. номеру '" + РегНомер + "'";
	КонецЕсли;
	
	Возврат Облигация;
	
КонецФункции // НайтиОблигациюПоОписанию

&НаСервереБезКонтекста
Функция ПолучитьБиржевыеПоказателиЦенныхБумаг(НачПериода, КонПериода, ИдентификаторыЦБ, ПолеИдентификатораЦБ)
	
	СтрокаСоединения = "Driver={SQL Server};Server=AP4.G1.LAN;UID=Nikolay;PWD=11111";
	
	ТекстЗапроса =
		"SELECT
		|	[TradeDate],
		|	[BoardName],
		|	[ShortName],
		|	[RegNumber],
		|	[Value_in_money],
		|	[WAPRICE],
		|	[Volume],
		|	[NumTrades],
		|	[MarketPrc2],
		|	[BID],
		|	[OFFER],
		|	[Accint]
		|FROM	
		|	[Kotirovki].[dbo].[MICEX]
		|WHERE
		|	[TradeDate] >= '&НачПериода 00:00:00.000'	
		|		and [TradeDate] <= '&КонПериода 00:00:00.000'
		|		and [&ПолеИдентификатораЦБ] IN (&ИдентификаторыЦБ)
		|ORDER BY
		|	[TradeDate]";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачПериода", Формат(НачПериода, "ДФ=yyyy-dd-MM"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонПериода", Формат(КонПериода, "ДФ=yyyy-dd-MM"));
	
	ИдентификаторыЦБСтрокой = "";
	
	Для каждого ИдентификаторЦБ Из ИдентификаторыЦБ Цикл
		ИдентификаторыЦБСтрокой = ИдентификаторыЦБСтрокой + ?(ПустаяСтрока(ИдентификаторыЦБСтрокой), "", ", ") + "'" + ИдентификаторЦБ + "'";
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторыЦБ",     ИдентификаторыЦБСтрокой);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИдентификатораЦБ", ПолеИдентификатораЦБ);
		
	Возврат РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса);
	
КонецФункции // ПолучитьБиржевыеПоказателиЦенныхБумаг


&НаСервере
Функция ПолучитьПлатежиПоОблигациям()
	
	// их можно определять динамически; но на момент написания отчета времени было
	// совсем мало, а на все рассматриваемые даты они были одинаковые, поэтому их
	// тупо загнали в макет
	МакетДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПлатежиПоОблигациям");
	
	ПлатежиПоОблигациям = Новый ТаблицаЗначений;
	ПлатежиПоОблигациям.Колонки.Добавить("РегНомер",     Новый ОписаниеТипов("Строка"));
	ПлатежиПоОблигациям.Колонки.Добавить("ДатаПлатежа",  Новый ОписаниеТипов("Дата"));
	ПлатежиПоОблигациям.Колонки.Добавить("СуммаПлатежа", Новый ОписаниеТипов("Число"));
	
	Для НомСтр = 2 По МакетДанных.ВысотаТаблицы Цикл
		НоваяСтрокаПлатежиПоОблигациям = ПлатежиПоОблигациям.Добавить();
		НоваяСтрокаПлатежиПоОблигациям.РегНомер     = МакетДанных.Область(НомСтр, 1).Текст;
		НоваяСтрокаПлатежиПоОблигациям.ДатаПлатежа  = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(МакетДанных.Область(НомСтр, 2).Текст);
		НоваяСтрокаПлатежиПоОблигациям.СуммаПлатежа = ЧислоИзСтроки(МакетДанных.Область(НомСтр, 3).Текст);
	КонецЦикла;
	
	Возврат ПлатежиПоОблигациям;
	
КонецФункции // ПолучитьПлатежиПоОблигациям

&НаСервере
Функция ПолучитьДоходностиАналогов(НачПериода, КонПериода, ИдентификаторыЦБ, ПолеИдентификатораЦБ)
	
	СтрокаСоединения = "Driver={SQL Server};Server=SQLXC.G1.LAN;UID=Nikolay;PWD=11111";
	
	ТекстЗапроса =
		"SELECT
		|	[TRADEDATE],
		|	[ShortName],
		|	[YIELDATWAP]
		|FROM	
		|	[Quotations].[dbo].[MICEX_FB]
		|Where 
		|	[YIELDATWAP] IS NOT NULL and
		|	[TradeDate] >= '&НачПериода 00:00:00.000'	
		|		and [TradeDate] <= '&КонПериода 00:00:00.000'
		|		and [&ПолеИдентификатораЦБ] IN (&ИдентификаторыЦБ)
		|ORDER BY
		|	[TradeDate]";
		
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачПериода", Формат(НачПериода, "ДФ=yyyy-dd-MM"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонПериода", Формат(КонПериода, "ДФ=yyyy-dd-MM"));
	
	ИдентификаторыЦБСтрокой = "";
	
	Для каждого ИдентификаторЦБ Из ИдентификаторыЦБ Цикл
		ИдентификаторыЦБСтрокой = ИдентификаторыЦБСтрокой + ?(ПустаяСтрока(ИдентификаторыЦБСтрокой), "", ", ") + "'" + ИдентификаторЦБ + "'";
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторыЦБ",     ИдентификаторыЦБСтрокой);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИдентификатораЦБ", ПолеИдентификатораЦБ);
		
	Возврат РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса);
	
КонецФункции // ПолучитьДоходностиАналогов

&НаСервере
Процедура РассчитатьНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	СтоимостьПассивныхОблигаций = Новый ТаблицаЗначений;
	СтоимостьПассивныхОблигаций.Колонки.Добавить("Период",    Новый ОписаниеТипов("Дата"));
	СтоимостьПассивныхОблигаций.Колонки.Добавить("РегНомер",  Новый ОписаниеТипов("Строка"));
	СтоимостьПассивныхОблигаций.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	СтоимостьПассивныхОблигаций.Колонки.Добавить("Аналоги");
	
	ПлатежиПоОблигациям = ПолучитьПлатежиПоОблигациям();
	
	// полученим набор пассивных облигаций и их аналогов
	МакетАналогиОблигаций = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПассивныеОблигации");
	
	МаксКолАналоговОблигации = 3;
	
	КолОблигаций = Цел((МакетАналогиОблигаций.ШиринаТаблицы - 1) / 4);
	
	РегНомераОблигаций       = Новый Массив;
	КраткиеИменаММВБАналогов = Новый Массив;
	
	МинДатаПериода  = Дата(1, 1, 1);
	МаксДатаПериода = Дата(1, 1, 1);
	
	Для НомСтр = 2 По МакетАналогиОблигаций.ВысотаТаблицы Цикл
		
		ТекПериод = МакетАналогиОблигаций.Область(НомСтр, 1).Текст;
		ТекПериод = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ТекПериод);
		
		Если МинДатаПериода = Дата(1, 1, 1) Или ТекПериод < МинДатаПериода Тогда
			МинДатаПериода = ТекПериод;
		КонецЕсли;
		
		Если МаксДатаПериода = Дата(1, 1, 1) Или ТекПериод > МаксДатаПериода Тогда
			МаксДатаПериода = ТекПериод;
		КонецЕсли;
		
		Для НомОбл = 1 По КолОблигаций Цикл
			
			НомПервойКол = (НомОбл - 1) * 4 + 2;
			
			Если ПустаяСтрока(МакетАналогиОблигаций.Область(НомСтр, НомПервойКол).Текст) Тогда // значит проблем за текущую дату не было
				Продолжить;
			КонецЕсли;
			
			Попытка
				ТекРегНомер  = "";
				ТекОблигация = НайтиОблигациюПоОписанию(МакетАналогиОблигаций.Область(НомСтр, НомПервойКол).Текст, ТекРегНомер);
			Исключение
				Сообщить("Не удалось получить облигацию № " + НомОбл + " в строке № " + НомСтр);
				Продолжить;
			КонецПопытки;
			
			Если РегНомераОблигаций.Найти(ТекРегНомер) = Неопределено Тогда
				РегНомераОблигаций.Добавить(ТекРегНомер);
			КонецЕсли;
			
			НоваяСтрокаСтоимостьПассивныхОблигаций = СтоимостьПассивныхОблигаций.Добавить();
			НоваяСтрокаСтоимостьПассивныхОблигаций.Период    = ТекПериод;
			НоваяСтрокаСтоимостьПассивныхОблигаций.Облигация = ТекОблигация;
			НоваяСтрокаСтоимостьПассивныхОблигаций.РегНомер  = ТекРегНомер;
			
			// аналоги
			АналогиОблигацииЗаТекПериод = Новый Массив;
			
			Для НомАналога = 1 По МаксКолАналоговОблигации Цикл
				АналогиОблигацииЗаТекПериод.Добавить(МакетАналогиОблигаций.Область(НомСтр, НомПервойКол + НомАналога).Текст);
				
				Если КраткиеИменаММВБАналогов.Найти(АналогиОблигацииЗаТекПериод[НомАналога - 1]) = Неопределено Тогда
					КраткиеИменаММВБАналогов.Добавить(АналогиОблигацииЗаТекПериод[НомАналога - 1]);
				КонецЕсли;
			КонецЦикла;
			
			НоваяСтрокаСтоимостьПассивныхОблигаций.Аналоги = АналогиОблигацииЗаТекПериод;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ДоходностиАналогов  = ПолучитьДоходностиАналогов(МинДатаПериода, МаксДатаПериода, КраткиеИменаММВБАналогов, "ShortName");
	
	БиржевыеПоказателиОблигаций = ПолучитьБиржевыеПоказателиЦенныхБумаг(МинДатаПериода, МаксДатаПериода, РегНомераОблигаций, "RegNumber");	
	БиржевыеПоказателиАналогов  = ПолучитьБиржевыеПоказателиЦенныхБумаг(МинДатаПериода, МаксДатаПериода, КраткиеИменаММВБАналогов, "ShortName");
	
	// подготовим сводный отчет
	МакетСтоимостьПассивныхОблигаций = ОбъектНаСервере.ПолучитьМакет("СтоимостьПассивныхОблигаций");
	
	ОбластьСводнаяШапка  = МакетСтоимостьПассивныхОблигаций.ПолучитьОбласть("Шапка");
	ОбластьСводнаяСтрока = МакетСтоимостьПассивныхОблигаций.ПолучитьОбласть("Строка");	
	
	ОбластьСводнаяШапка.Параметры.НачДата = Формат(МинДатаПериода, "ДФ=dd.MM.yyyy");
	ОбластьСводнаяШапка.Параметры.КонДата = Формат(МаксДатаПериода, "ДФ=dd.MM.yyyy");
	
	ЭтаФорма.СводныйОтчет.ТолькоПросмотр      = Истина;
	ЭтаФорма.СводныйОтчет.ОтображатьЗаголовки = Ложь;
	ЭтаФорма.СводныйОтчет.ОтображатьСетку     = Ложь;
	
	ЭтаФорма.СводныйОтчет.Вывести(ОбластьСводнаяШапка);
	
	// сформируем отчеты за каждую дату периоды
	МакетСтоимостьПассивныхОблигацийНаДату = ОбъектНаСервере.ПолучитьМакет("СтоимостьПассивныхОблигацийНаДату");
	
	ОбластьОблигация                    = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("Облигация");
	ОбластьАналогиШапка                 = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("АналогиШапка");
	ОбластьАналогиСтрока                = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("АналогиСтрока");
	ОбластьАналогиСтавкаДисконтирования = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("АналогиСтавкаДисконтирования");
	ОбластьПлатежиШапка                 = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("ПлатежиШапка");
	ОбластьПлатежиСтрока                = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("ПлатежиСтрока");
	ОбластьВыборСтоимости               = МакетСтоимостьПассивныхОблигацийНаДату.ПолучитьОбласть("ВыборСтоимости");
	
	ЭтаФорма.Расшифровки = Новый Структура;
	
	ТекПериод = Дата(1, 1, 1);
	
	СтоимостьПассивныхОблигаций.Сортировать("Период");
	
	Для каждого СтрокаСтоимостьПассивныхОблигаций Из СтоимостьПассивныхОблигаций Цикл
		
		Если СтрокаСтоимостьПассивныхОблигаций.Период <> ТекПериод Тогда
			ТекПериод = СтрокаСтоимостьПассивныхОблигаций.Период;
			
			ОтчетЗаТекПериод = Новый ТабличныйДокумент;
			ОтчетЗаТекПериод.ТолькоПросмотр      = Истина;
			ОтчетЗаТекПериод.ОтображатьЗаголовки = Ложь;
			ОтчетЗаТекПериод.ОтображатьСетку     = Ложь;
			
			ЭтаФорма.Расшифровки.Вставить("Период" + Формат(ТекПериод, "ДФ=ddMMyyyy"), ОтчетЗаТекПериод);
		КонецЕсли;
		
		БиржевыеПоказателиТекОблигации = БиржевыеПоказателиОблигаций.НайтиСтроки(
			Новый Структура("TradeDate, RegNumber", ТекПериод, СтрокаСтоимостьПассивныхОблигаций.РегНомер));
			
		Если БиржевыеПоказателиТекОблигации.Количество() <> 1 Тогда
			ВызватьИсключение "Не удалось определить биржевые показатели облигации '" + СтрокаСтоимостьПассивныхОблигаций.РегНомер + "' за период '" + ТекПериод + "'";
		Иначе
			БиржевыеПоказателиТекОблигации = БиржевыеПоказателиТекОблигации[0];
		КонецЕсли;			
		
		ОбластьОблигация.Параметры.ОписаниеОблигации = Строка(СтрокаСтоимостьПассивныхОблигаций.Облигация);
		ОбластьОблигация.Параметры.ДатаОценки        = Формат(ТекПериод, "ДФ=dd.MM.yyyy");
		ОбластьОблигация.Параметры.НКДНаДатуОценки   = БиржевыеПоказателиТекОблигации.Accint;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НоминалыЦенныхБумагСрезПоследних.Номинал
			|ИЗ
			|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ЦеннаяБумага = &ЦеннаяБумага) КАК НоминалыЦенныхБумагСрезПоследних";
			
		Запрос.УстановитьПараметр("Период",       ТекПериод);
		Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаСтоимостьПассивныхОблигаций.Облигация);
			
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОбластьОблигация.Параметры.Номинал = Выборка.Номинал;
		Иначе
			ВызватьИсключение "Не удалось определить номинал облигации '" + СтрокаСтоимостьПассивныхОблигаций.Облигация + "' за период '" + ТекПериод + "'";
		КонецЕсли;
		
		ОтчетЗаТекПериод.Вывести(ОбластьОблигация);
		ОтчетЗаТекПериод.Вывести(ОбластьАналогиШапка);
		
		ОбъемАналоговИтого             = 0;
		ДоходностьНаОбъемАналоговИтого = 0;
		
		Для каждого ТекАналог Из СтрокаСтоимостьПассивныхОблигаций.Аналоги Цикл
			БиржевыеПоказателиТекАналога = БиржевыеПоказателиАналогов.НайтиСтроки(
				Новый Структура("TradeDate, ShortName", ТекПериод, ТекАналог));
				
			Если БиржевыеПоказателиТекАналога.Количество() <> 1 Тогда
				ВызватьИсключение "Не удалось определить биржевые показатели аналога '" + ТекАналог + "' за период '" + ТекПериод + "'";
			Иначе
				БиржевыеПоказателиТекАналога = БиржевыеПоказателиТекАналога[0];
			КонецЕсли;
			
			ДоходностьТекАналога = ДоходностиАналогов.НайтиСтроки(
				Новый Структура("TradeDate, ShortName", ТекПериод, ТекАналог));
				
			Если ДоходностьТекАналога.Количество() = 0 Тогда
				ВызватьИсключение "Не удалось определить доходность аналога '" + ТекАналог + "' за период '" + ТекПериод + "'";
			Иначе
				ДоходностьТекАналога = ДоходностьТекАналога[0];
			КонецЕсли;
						
			ОбластьАналогиСтрока.Параметры.Аналог            = БиржевыеПоказателиТекАналога.ShortName;
			ОбластьАналогиСтрока.Параметры.РегНомер          = БиржевыеПоказателиТекАналога.RegNumber;
			ОбластьАналогиСтрока.Параметры.Объем             = Число(БиржевыеПоказателиТекАналога.Value_in_money);
			ОбластьАналогиСтрока.Параметры.Цена              = Число(БиржевыеПоказателиТекАналога.WAPRICE);
			ОбластьАналогиСтрока.Параметры.Доходность        = ДоходностьТекАналога.YIELDATWAP;
			ОбластьАналогиСтрока.Параметры.ДоходностьНаОбъем = Окр(ОбластьАналогиСтрока.Параметры.Объем * ОбластьАналогиСтрока.Параметры.Доходность / 100, 2);
			
			ОбъемАналоговИтого             = ОбъемАналоговИтого + ОбластьАналогиСтрока.Параметры.Объем;
			ДоходностьНаОбъемАналоговИтого = ДоходностьНаОбъемАналоговИтого + ОбластьАналогиСтрока.Параметры.ДоходностьНаОбъем;
			
			ОтчетЗаТекПериод.Вывести(ОбластьАналогиСтрока);
		КонецЦикла;
		
		ОбластьАналогиСтавкаДисконтирования.Параметры.ОбъемИтого             = ОбъемАналоговИтого;
		ОбластьАналогиСтавкаДисконтирования.Параметры.ДоходностьНаОбъемИтого = ДоходностьНаОбъемАналоговИтого;
		ОбластьАналогиСтавкаДисконтирования.Параметры.СтавкаДисконтирования  = Окр(ДоходностьНаОбъемАналоговИтого / ОбъемАналоговИтого, 7);
		
		ОтчетЗаТекПериод.Вывести(ОбластьАналогиСтавкаДисконтирования);
		ОтчетЗаТекПериод.Вывести(ОбластьПлатежиШапка);
		
		// платежи
		СтрокиПлатежиПоОблигациям = ПлатежиПоОблигациям.НайтиСтроки(
			Новый Структура("РегНомер", ТекРегНомер));
			
		СуммаНаСтепеньИтого = 0;
			
		Для Инд = 1 По СтрокиПлатежиПоОблигациям.Количество() Цикл
			СтрокаПлатежиПоОблигациям = СтрокиПлатежиПоОблигациям[Инд - 1];
				
			ОбластьПлатежиСтрока.Параметры.НомерПлатежа      = Инд;
			ОбластьПлатежиСтрока.Параметры.ДатаПлатежа       = Формат(СтрокаПлатежиПоОблигациям.ДатаПлатежа, "ДФ=dd.MM.yyyy");
			ОбластьПлатежиСтрока.Параметры.СуммаПлатежа      = СтрокаПлатежиПоОблигациям.СуммаПлатежа;
			ОбластьПлатежиСтрока.Параметры.ДнейДоПлатежа     = Цел((СтрокаПлатежиПоОблигациям.ДатаПлатежа - ТекПериод) / 86400);
			ОбластьПлатежиСтрока.Параметры.ДоляДнейДоПлатежа = Окр(ОбластьПлатежиСтрока.Параметры.ДнейДоПлатежа / 365, 7);
			ОбластьПлатежиСтрока.Параметры.Степень           = Окр(Pow(1 + ОбластьАналогиСтавкаДисконтирования.Параметры.СтавкаДисконтирования, ОбластьПлатежиСтрока.Параметры.ДоляДнейДоПлатежа), 7);
			ОбластьПлатежиСтрока.Параметры.СуммаНаСтепень    = Окр(ОбластьПлатежиСтрока.Параметры.СуммаПлатежа / ОбластьПлатежиСтрока.Параметры.Степень, 7);
			
			ОтчетЗаТекПериод.Вывести(ОбластьПлатежиСтрока);
			
			СуммаНаСтепеньИтого = СуммаНаСтепеньИтого + ОбластьПлатежиСтрока.Параметры.СуммаНаСтепень;
		КонецЦикла;
		
		// выбор стоимости
		ОбластьВыборСтоимости.Параметры.ПриведеннаяСтоимость        = СуммаНаСтепеньИтого - ОбластьОблигация.Параметры.НКДНаДатуОценки;
		ОбластьВыборСтоимости.Параметры.ПриведеннаяСтоимостьПроцент = Окр(ОбластьВыборСтоимости.Параметры.ПриведеннаяСтоимость / ОбластьОблигация.Параметры.Номинал * 100, 2);
		
		ЗаполнитьЗначенияСвойств(ОбластьВыборСтоимости.Параметры, БиржевыеПоказателиТекОблигации, "BID, OFFER");
		
		ОтчетЗаТекПериод.Вывести(ОбластьВыборСтоимости);
		
		// строка сводного отчета
		ОбластьСводнаяСтрока.Параметры.Дата      = Формат(ТекПериод, "ДФ=dd.MM.yyyy");
		ОбластьСводнаяСтрока.Параметры.Облигация = СтрокаСтоимостьПассивныхОблигаций.Облигация;
		ОбластьСводнаяСтрока.Параметры.BID       = Число(ОбластьВыборСтоимости.Параметры.BID);
		ОбластьСводнаяСтрока.Параметры.OFFER     = Число(ОбластьВыборСтоимости.Параметры.OFFER);
		ОбластьСводнаяСтрока.Параметры.ПС        = ОбластьВыборСтоимости.Параметры.ПриведеннаяСтоимостьПроцент;
		
		Если      ОбластьСводнаяСтрока.Параметры.ПС > ОбластьСводнаяСтрока.Параметры.OFFER Тогда
			ОбластьСводнаяСтрока.Параметры.ИтоговаяСтоимость = ОбластьСводнаяСтрока.Параметры.OFFER;
			ОбластьСводнаяСтрока.Параметры.Источник          = "OFFER";
		ИначеЕсли ОбластьСводнаяСтрока.Параметры.ПС < ОбластьСводнаяСтрока.Параметры.BID Тогда
			ОбластьСводнаяСтрока.Параметры.ИтоговаяСтоимость = ОбластьСводнаяСтрока.Параметры.BID;
			ОбластьСводнаяСтрока.Параметры.Источник          = "BID";
		Иначе
			ОбластьСводнаяСтрока.Параметры.ИтоговаяСтоимость = ОбластьСводнаяСтрока.Параметры.ПС;
			ОбластьСводнаяСтрока.Параметры.Источник          = "ПС";
		КонецЕсли;
		
		ЭтаФорма.СводныйОтчет.Вывести(ОбластьСводнаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры // РассчитатьНаСервере



&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РассчитатьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРассчитать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаРассчитать");
	Попытка
		РассчитатьНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СводныйОтчетОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЭтаФорма.Расшифровки["Период" + СтрЗаменить(Расшифровка, ".", "")].Показать(Расшифровка);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
