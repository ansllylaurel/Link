	КонтрольMosPrime();
	
	// Оповещаем пользователя
	ОповеститьОбОшибках();

	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ставки MosPrime успешно загружены.");
	КонецЕсли;	
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры 

Процедура КонтрольMosPrime()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ЗначенияБиржевыхИндексов.VALUE ЕСТЬ НЕ NULL  КАК ЕстьСтавка,
