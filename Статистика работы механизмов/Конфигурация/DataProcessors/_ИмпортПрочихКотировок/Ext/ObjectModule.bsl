	ТипыКолонок.Вставить("MOSPRIME1MD",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("MOSPRIME1WD",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("MOSPRIME2MD",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("MOSPRIME2WD",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("MOSPRIME3MD",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
