			// Записываем
			Запись = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьМенеджерЗаписи();
			
			Запись.Период = СтрокаСтавки.Период;
			
			Запись.Биржа = БиржаНФА;
			Запись.БиржевойИндекс = ИндексMosPrime.Ссылка;
			
			//Запись.CLOSE = СтрокаСтавки[ИндексMosPrime.Код];
			//Запись.OPEN = СтрокаСтавки[ИндексMosPrime.Код];
			//Запись.HIGH = СтрокаСтавки[ИндексMosPrime.Код];
			//Запись.LOW = СтрокаСтавки[ИндексMosPrime.Код];
			Запись.VALUE = СтрокаСтавки[ИндексMosPrime.Код];
			
			Попытка
				Запись.Записать();
			Исключение
				ЗарегистрироватьОшибку(ОписаниеОшибки());
				ОтменитьТранзакцию();
				Прервать;
			КонецПопытки;
			
		КонецЦикла;
	
