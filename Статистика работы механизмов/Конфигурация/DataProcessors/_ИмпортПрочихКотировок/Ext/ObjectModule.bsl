		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|	КОНЕЦ КАК Рынок,
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага,
		|	_ИнформацияОВнебиржевыхСделках.КоличествоСделок КАК КоличествоСделок,
		|	_ИнформацияОВнебиржевыхСделках.КоличествоЦенныхБумаг КАК КоличествоЦенныхБумаг,
		|	_ИнформацияОВнебиржевыхСделках.КрупныеСделки КАК КрупныеСделки,
		|	_ИнформацияОВнебиржевыхСделках.МаксимальнаяЦена КАК МаксимальнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.МинимальнаяЦена КАК МинимальнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.ОбъемСделок КАК ОбъемСделок,
		|	_ИнформацияОВнебиржевыхСделках.Период КАК Период,
		|	_ИнформацияОВнебиржевыхСделках.РасчетнаяЦена КАК РасчетнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.СрокИсполнения КАК СрокИсполнения,
		|	_ИнформацияОВнебиржевыхСделках.ТорговыйДень КАК ТорговыйДень
		|ПОМЕСТИТЬ _ИнформацияОВнебиржевыхСделкахНаДатуЗагрузки
		|ИЗ
		|	_ИнформацияОВнебиржевыхСделках
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ИнформацияОВнебиржевыхСделках.SECID = КодыВТорговыхСистемахСрезПоследних.Код
		|ГДЕ 
		|	_ИнформацияОВнебиржевыхСделках.Период = &Период
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Источник КАК Источник,
		|	ВЫБОР
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.Облигации
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.Паи
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|	КОНЕЦ КАК Рынок,
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага,
		|	_ИнформацияОВнебиржевыхСделках.КоличествоСделок КАК КоличествоСделок,
		|	_ИнформацияОВнебиржевыхСделках.КоличествоЦенныхБумаг КАК КоличествоЦенныхБумаг,
		|	_ИнформацияОВнебиржевыхСделках.КрупныеСделки КАК КрупныеСделки,
		|	_ИнформацияОВнебиржевыхСделках.МаксимальнаяЦена КАК МаксимальнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.МинимальнаяЦена КАК МинимальнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.ОбъемСделок КАК ОбъемСделок,
		|	_ИнформацияОВнебиржевыхСделках.Период КАК Период,
		|	_ИнформацияОВнебиржевыхСделках.РасчетнаяЦена КАК РасчетнаяЦена,
		|	_ИнформацияОВнебиржевыхСделках.СрокИсполнения КАК СрокИсполнения,
		|	_ИнформацияОВнебиржевыхСделках.ТорговыйДень КАК ТорговыйДень
		|ИЗ
		|	_ИнформацияОВнебиржевыхСделках
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ИнформацияОВнебиржевыхСделках.SECID = КодыВТорговыхСистемахСрезПоследних.Код
		|ГДЕ 
		|	_ИнформацияОВнебиржевыхСделках.Период <> &Период";
		
	Запрос.УстановитьПараметр("ИнформацияОВнебиржевыхСделках", ИнформацияОВнебиржевыхСделках);
	Запрос.УстановитьПараметр("Период"	, НачалоДня(ДатаЗагрузки));
	Запрос.УстановитьПараметр("Источник", Источник);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаДанныхНаДатуЗагрузки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ИнформацияОВнебиржевыхСделкахНаДатуЗагрузки"].ПолучитьДанные().Выгрузить();

	НаборИнформацияОВнебиржевыхСделках = РегистрыСведений.ИнформацияОВнебиржевыхСделках.СоздатьНаборЗаписей();
	НаборИнформацияОВнебиржевыхСделках.Отбор.Период.Установить(ДатаЗагрузки);
	НаборИнформацияОВнебиржевыхСделках.Отбор.Источник.Установить(Источник);
	НаборИнформацияОВнебиржевыхСделках.Прочитать();
		
	Если Не ТолькоОтсутствующие Тогда
		
		НаборИнформацияОВнебиржевыхСделках.Загрузить(ТаблицаДанныхНаДатуЗагрузки);
		
	Иначе
		
		Для Каждого СтрокаТаблицыДанных Из ТаблицаДанныхНаДатуЗагрузки Цикл
		
			НаборИнформацияОВнебиржевыхСделках = РегистрыСведений.ИнформацияОВнебиржевыхСделках.СоздатьНаборЗаписей();
			НаборИнформацияОВнебиржевыхСделках.Отбор.Период.Установить(СтрокаТаблицыДанных.Период);
			НаборИнформацияОВнебиржевыхСделках.Отбор.Источник.Установить(СтрокаТаблицыДанных.Источник);
			НаборИнформацияОВнебиржевыхСделках.Отбор.ТорговыйДень.Установить(СтрокаТаблицыДанных.ТорговыйДень);
			НаборИнформацияОВнебиржевыхСделках.Отбор.ЦеннаяБумага.Установить(СтрокаТаблицыДанных.ЦеннаяБумага);
			НаборИнформацияОВнебиржевыхСделках.Отбор.СрокИсполнения.Установить(СтрокаТаблицыДанных.СрокИсполнения);
			НаборИнформацияОВнебиржевыхСделках.Отбор.КрупныеСделки.Установить(СтрокаТаблицыДанных.КрупныеСделки);
			НаборИнформацияОВнебиржевыхСделках.Прочитать();
			
			Если НаборИнформацияОВнебиржевыхСделках.Количество() <> 0 Тогда Продолжить; КонецЕсли;
			
			НаборИнформацияОВнебиржевыхСделках.Очистить();
			
			ЗаполнитьЗначенияСвойств(НаборИнформацияОВнебиржевыхСделках.Добавить(), СтрокаТаблицыДанных);
			
			НаборИнформацияОВнебиржевыхСделках.Записать();
			
			Сообщить("Загружена инф. по внеб. сделке по ц/б '" + СтрокаТаблицыДанных.ЦеннаяБумага + "' за '" + Формат(СтрокаТаблицыДанных.Период, "ДФ=dd.MM.yyyy"));
			
		КонецЦикла;
			
	КонецЕсли;
	
	НаборИнформацияОВнебиржевыхСделках.Записать();
	
	ВыборкаДанныхНеНаДатуЗагрузки = Результат.Выбрать();
	
	Пока ВыборкаДанныхНеНаДатуЗагрузки.Следующий() Цикл
		
		НаборИнформацияОВнебиржевыхСделках = РегистрыСведений.ИнформацияОВнебиржевыхСделках.СоздатьНаборЗаписей();
		НаборИнформацияОВнебиржевыхСделках.Отбор.Период.Установить(ВыборкаДанныхНеНаДатуЗагрузки.Период);
		НаборИнформацияОВнебиржевыхСделках.Отбор.Источник.Установить(ВыборкаДанныхНеНаДатуЗагрузки.Источник);
		НаборИнформацияОВнебиржевыхСделках.Отбор.ТорговыйДень.Установить(ВыборкаДанныхНеНаДатуЗагрузки.ТорговыйДень);
		НаборИнформацияОВнебиржевыхСделках.Отбор.ЦеннаяБумага.Установить(ВыборкаДанныхНеНаДатуЗагрузки.ЦеннаяБумага);
		НаборИнформацияОВнебиржевыхСделках.Отбор.СрокИсполнения.Установить(ВыборкаДанныхНеНаДатуЗагрузки.СрокИсполнения);
		НаборИнформацияОВнебиржевыхСделках.Отбор.КрупныеСделки.Установить(ВыборкаДанныхНеНаДатуЗагрузки.КрупныеСделки);
		НаборИнформацияОВнебиржевыхСделках.Прочитать();
		
		Если ТолькоОтсутствующие И НаборИнформацияОВнебиржевыхСделках.Количество() <> 0 Тогда Продолжить; КонецЕсли;
		
		НаборИнформацияОВнебиржевыхСделках.Очистить();
		
		ЗаполнитьЗначенияСвойств(НаборИнформацияОВнебиржевыхСделках.Добавить(), ВыборкаДанныхНеНаДатуЗагрузки);
		
		НаборИнформацияОВнебиржевыхСделках.Записать();
		
		Сообщить("Загружена инф. по внеб. сделке по ц/б '" + ВыборкаДанныхНеНаДатуЗагрузки.ЦеннаяБумага + "' за '" + Формат(ВыборкаДанныхНеНаДатуЗагрузки.Период, "ДФ=dd.MM.yyyy"));
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьДанныеИзCSV

#КонецОбласти

#Область Параметры_кривой_бескупонной_доходности

Процедура ЗагрузитьПараметрыКривойБескупоннойДоходности(ТолькоОтсутствующие = Ложь) Экспорт

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период", Новый ОписаниеТипов("Дата"));
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.ПараметрыКривойБескупоннойДоходности.Ресурсы Цикл
		ТипыКолонок.Вставить(Ресурс.Имя, Ресурс.Тип);
	КонецЦикла;
	
	ИмяФайлаZIP = КаталогВременныхФайлов() + "zcyc_parameters_archive.csv.zip";
	ИмяФайлаCSV = КаталогВременныхФайлов() + "zcyc_parameters_archive.csv";
	
	Попытка
		УдалитьФайлы(ИмяФайлаZIP);
	    УдалитьФайлы(ИмяФайлаCSV);
	Исключение
	КонецПопытки;
	
	// Качаем
	Соединение = Новый HTTPСоединение("iss.moex.com");
	//Соединение = Новый HTTPСоединение("www.micex.ru");
	
	Запрос = Новый HTTPЗапрос;
	Запрос.АдресРесурса = "download/zcyc/zcyc_parameters_archive.csv.zip";
	//Запрос.Заголовки.Вставить("Authorization", "Basic YmtyZWdpb246SzByYWNhdGl6YQ==");
	//Запрос.Заголовки.Вставить("Authorization", Base64);
		
	Соединение.Получить(Запрос, ИмяФайлаZIP);
	
	Ф = Новый Файл(ИмяФайлаZIP);
	
	Попытка
		ЧтениеZIP = Новый ЧтениеZipФайла(ИмяФайлаZIP);
		ЧтениеZIP.ИзвлечьВсе(КаталогВременныхФайлов(), РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Читаем
	ФайлCSV = Новый ТекстовыйДокумент;
	ФайлCSV.Прочитать(ИмяФайлаCSV);
	
	Для НомерСтроки = 4 По ФайлCSV.КоличествоСтрок() Цикл
		
		ДанныеCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(НомерСтроки), ";");
		
		ПериодСтр = СокрЛП(ДанныеCSV[0]);
		
		ПериодДата = Дата(Прав(ПериодСтр, 4), Сред(ПериодСтр, 4, 2), Лев(ПериодСтр, 2));
		
		ВидПараметраСтр = СокрЛП(ДанныеCSV[2]);
		Если ВидПараметраСтр = "prev_wa" Тогда
			ВидПараметра = Перечисления.ВидыКривойБескупоннойДоходности.СреднееЗаПредыдущийДень;
		ИначеЕсли ВидПараметраСтр = "prev" Тогда
			ВидПараметра = Перечисления.ВидыКривойБескупоннойДоходности.НаКонецПредыдущегоДня;
		ИначеЕсли ВидПараметраСтр = "curr" Тогда
			ВидПараметра = Перечисления.ВидыКривойБескупоннойДоходности.Текущее;
		Иначе
			Продолжить;
		КонецЕсли;
		
		НаборПараметров = РегистрыСведений.ПараметрыКривойБескупоннойДоходности.СоздатьНаборЗаписей();
		
		НаборПараметров.Отбор.Период.Установить(ПериодДата);
		НаборПараметров.Отбор.ВидПараметра.Установить(ВидПараметра);
		
		НаборПараметров.Прочитать();
		НаборПараметров.Очистить();
		
		НоваяЗапись = НаборПараметров.Добавить();
		
		НоваяЗапись.Период = ПериодДата;
		НоваяЗапись.ВидПараметра = ВидПараметра;
		НоваяЗапись.beta0 = Число(СокрЛП(ДанныеCSV[3]));
		НоваяЗапись.beta1 = Число(СокрЛП(ДанныеCSV[4]));
		НоваяЗапись.beta2 = Число(СокрЛП(ДанныеCSV[5]));
		НоваяЗапись.tau = Число(СокрЛП(ДанныеCSV[6]));
		НоваяЗапись.g1 = Число(СокрЛП(ДанныеCSV[7]));
		НоваяЗапись.g2 = Число(СокрЛП(ДанныеCSV[8]));
		НоваяЗапись.g3 = Число(СокрЛП(ДанныеCSV[9]));
		
		НаборПараметров.Записать();
		
	КонецЦикла;

	
	// Качаем
	Соединение = Новый HTTPСоединение("iss.moex.com");
	//Соединение = Новый HTTPСоединение("www.micex.ru");
	
	Запрос = Новый HTTPЗапрос;
	
	Запрос.АдресРесурса = "/iss/downloads/engines/stock/zcyc/dynamic.csv.zip";
	//Запрос.Заголовки.Вставить("Authorization", "Basic YmtyZWdpb246SzByYWNhdGl6YQ==");
	//Запрос.Заголовки.Вставить("Authorization", Base64);
	
	ИмяФайлаZIP = КаталогВременныхФайлов() + "dynamic.csv.zip";
	ИмяФайлаCSV = КаталогВременныхФайлов() + "dynamic.csv";
	
	Соединение.Получить(Запрос, ИмяФайлаZIP);
	
	Попытка
	    УдалитьФайлы(ИмяФайлаCSV);
	Исключение
	КонецПопытки;
	
	Попытка
		ЧтениеZIP = Новый ЧтениеZipФайла(ИмяФайлаZIP);
		ЧтениеZIP.ИзвлечьВсе(КаталогВременныхФайлов(), РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Читаем
	ФайлCSV = Новый ТекстовыйДокумент;
	ФайлCSV.Прочитать(ИмяФайлаCSV);
	
	ВидПараметра = Перечисления.ВидыКривойБескупоннойДоходности.Текущее2017;
		
	Для НомерСтроки = 4 По ФайлCSV.КоличествоСтрок() Цикл
		
		ДанныеCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(НомерСтроки), ";");
		
		Если ДанныеCSV.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПериодСтр = СокрЛП(ДанныеCSV[0]);
		
		ПериодДата = Дата(Прав(ПериодСтр, 4), Сред(ПериодСтр, 4, 2), Лев(ПериодСтр, 2));
		
		НаборПараметров = РегистрыСведений.ПараметрыКривойБескупоннойДоходности.СоздатьНаборЗаписей();
		
		НаборПараметров.Отбор.Период.Установить(ПериодДата);
		НаборПараметров.Отбор.ВидПараметра.Установить(ВидПараметра);
		
		НаборПараметров.Прочитать();
		НаборПараметров.Очистить();
		
		НоваяЗапись = НаборПараметров.Добавить();
		
		НоваяЗапись.Период = ПериодДата;
		НоваяЗапись.ВидПараметра = ВидПараметра;
		НоваяЗапись.beta0 = Число(СокрЛП(ДанныеCSV[2]));
		НоваяЗапись.beta1 = Число(СокрЛП(ДанныеCSV[3]));
		НоваяЗапись.beta2 = Число(СокрЛП(ДанныеCSV[4]));
		НоваяЗапись.tau = Число(СокрЛП(ДанныеCSV[5]));
		НоваяЗапись.g1 = Число(СокрЛП(ДанныеCSV[6]));
		НоваяЗапись.g2 = Число(СокрЛП(ДанныеCSV[7]));
		НоваяЗапись.g3 = Число(СокрЛП(ДанныеCSV[8]));
		НоваяЗапись.g4 = Число(СокрЛП(ДанныеCSV[9]));
		НоваяЗапись.g5 = Число(СокрЛП(ДанныеCSV[10]));
		НоваяЗапись.g6 = Число(СокрЛП(ДанныеCSV[11]));
		НоваяЗапись.g7 = Число(СокрЛП(ДанныеCSV[12]));
		НоваяЗапись.g8 = Число(СокрЛП(ДанныеCSV[13]));
		НоваяЗапись.g9 = Число(СокрЛП(ДанныеCSV[14]));
		
		НаборПараметров.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область RUONIA

Процедура ЗагрузитьRUONIA() Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	БиржаНФА 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА");
	ИндексРУОНИА 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Индекс_РУОНИА");
	
	БлокировкаСтавок = Новый БлокировкаДанных;
	ЭлементБлокировкиСтавок = БлокировкаСтавок.Добавить("РегистрСведений.ЗначенияБиржевыхИндексов");
	ЭлементБлокировкиСтавок.УстановитьЗначение("Биржа", БиржаНФА);
	ЭлементБлокировкиСтавок.УстановитьЗначение("БиржевойИндекс", ИндексРУОНИА);
	ЭлементБлокировкиСтавок.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаСтавок.Заблокировать();
	
	// Инициализация вспомогательных переменных
	СтрокаСоединения	= РаботаСВнешнимиСистемамиСтрокаСоединенияСExternals();
	ТекстЗапроса		= "
		|SELECT
		|	CAST(RUONIA.IndexDate AS DateTime) [Период],
		|	RUONIA.Value [ПроцентнаяСтавка]
		|FROM
		|	Externals.dbo.RUONIA [RUONIA]
		|WHERE
		|	IndexDate BETWEEN &ДатаНачала AND &ДатаОкончания";
	ДатаНачалаSQL		= "'" + Формат(ЭтотОбъект.Период.ДатаНачала,    "ДФ=yyyyMMdd") + "'";
	ДатаОкончанияSQL	= "'" + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyyMMdd") + "'";
	
	// Подготавливаем запрос
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаНачала", ДатаНачалаSQL);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаОкончания", ДатаОкончанияSQL);
	
	// Получаем котировки с сервера
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период",				Новый ОписаниеТипов("Дата", , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("ПроцентнаяСтавка",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.CLOSE.Тип);
	
	Попытка
		Ставки = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
	Исключение
	КонецПопытки;
	Если Ставки = Неопределено Тогда
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для загрузки ставок РУОНИА.");
		Иначе
			ЗарегистрироватьОшибку("Нет данных для загрузки ставок РУОНИА.");
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаСтавки Из Ставки Цикл
	
		// Записываем
		Запись = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьМенеджерЗаписи();
		
		Запись.Период = СтрокаСтавки.Период;
		
		Запись.Биржа = БиржаНФА;
		Запись.БиржевойИндекс = ИндексРУОНИА;
		
		Запись.CLOSE = СтрокаСтавки.ПроцентнаяСтавка;
		Запись.OPEN = СтрокаСтавки.ПроцентнаяСтавка;
		Запись.HIGH = СтрокаСтавки.ПроцентнаяСтавка;
		Запись.LOW = СтрокаСтавки.ПроцентнаяСтавка;
		
		Попытка
			Запись.Записать();
		Исключение
			ЗарегистрироватьОшибку(ОписаниеОшибки());
			ОтменитьТранзакцию();
			Прервать;
		КонецПопытки;
	
	КонецЦикла;
	
	КонтрольСтавкиRUONIA(ИндексРУОНИА);
	
	// Оповещаем пользователя
	ОповеститьОбОшибках();

	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ставки РУОНИА успешно загружены.");
	КонецЕсли;	
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры 

Процедура КонтрольСтавкиRUONIA(ИндексРУОНИА) 
	
	//Из сверки исключил крайний рабочий день года, т.к. на этот день ставка не публикуется.
	//в годы 2021 - 2025 она не публиковалась.  
	Запрос = Новый Запрос;
	
#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ДанныеКалендаря.ВидДня КАК ВидДня
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И (МЕСЯЦ(&ДатаОкончания) = 12
		|				И (ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И КОНЕЦПЕРИОДА(&ДатаОкончания, ГОД))
		|			ИЛИ ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеКалендаря.Дата КАК Дата,
		|	ЗначенияБиржевыхИндексов.CLOSE ЕСТЬ НЕ NULL  КАК ЕстьСтавка,
		|	_ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)) КАК РабочийДень
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(_ДанныеКалендаря.Дата) КАК Дата
		|		ИЗ
		|			_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ГДЕ
		|			_ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			И МЕСЯЦ(_ДанныеКалендаря.Дата) = 12
		|		
		|		ИМЕЮЩИЕ
		|			НЕ МАКСИМУМ(_ДанныеКалендаря.Дата) ЕСТЬ NULL) КАК КрайнийРабочийДеньГода
		|		ПО _ДанныеКалендаря.Дата = КрайнийРабочийДеньГода.Дата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО _ДанныеКалендаря.Дата = ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &ИндексРУОНИА)
		|ГДЕ
		|	_ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И КрайнийРабочийДеньГода.Дата ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА _ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ТОГДА ЗначенияБиржевыхИндексов.CLOSE ЕСТЬ NULL
		|			ИНАЧЕ ЗначенияБиржевыхИндексов.CLOSE ЕСТЬ НЕ NULL 
		|		КОНЕЦ";
#КонецОбласти
		
	Запрос.УстановитьПараметр("ИндексРУОНИА", ИндексРУОНИА);
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = СтрШаблон(
			"%1 ставка РУОНИА на %2 (%3 день)",
			Формат(Выборка.ЕстьСтавка, "БЛ=Отсутствует; БИ=Есть"),
			Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"),
			Формат(Выборка.РабочийДень, "БЛ=выходной; БИ=рабочий"));
			
		ЗарегистрироватьОшибку(ТекстОшибки);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СрочнаяRUONIA

Процедура ЗагрузитьСрочнуюRUONIA() Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	БиржаНФА 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА");
	СрочноеРУОНИА 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Срочное_РУОНИА");
	
	БлокировкаСтавок = Новый БлокировкаДанных;
	ЭлементБлокировкиСтавок = БлокировкаСтавок.Добавить("РегистрСведений.ЗначенияБиржевыхИндексов");
	ЭлементБлокировкиСтавок.УстановитьЗначение("Биржа", БиржаНФА);
	ЭлементБлокировкиСтавок.УстановитьЗначение("БиржевойИндекс", СрочноеРУОНИА);
	ЭлементБлокировкиСтавок.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаСтавок.Заблокировать();
	
	// Инициализация вспомогательных переменных
	СтрокаСоединения	= РаботаСВнешнимиСистемамиСтрокаСоединенияСExternals();
	ТекстЗапроса		= "
		|SELECT
		|	CAST(RUONIA_AVG.[Date] AS DateTime) [Период],
		|	RUONIA_AVG.[Index] [Индекс],
		|	RUONIA_AVG.Rate_1M [Срочная1М],
		|	RUONIA_AVG.Rate_3M [Срочная3М],
		|	RUONIA_AVG.Rate_6M [Срочная6М]
		|FROM
		|	Externals.dbo.RUONIA_AVG [RUONIA_AVG]
		|WHERE
		|	[Date] BETWEEN &ДатаНачала AND &ДатаОкончания";
	ДатаНачалаSQL		= "'" + Формат(ЭтотОбъект.Период.ДатаНачала,    "ДФ=yyyyMMdd") + "'";
	ДатаОкончанияSQL	= "'" + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyyMMdd") + "'";
	
	// Подготавливаем запрос
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаНачала", ДатаНачалаSQL);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаОкончания", ДатаОкончанияSQL);
	
	// Получаем котировки с сервера
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период",				Новый ОписаниеТипов("Дата", , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("Индекс",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.CLOSE.Тип);
	ТипыКолонок.Вставить("Срочная1М",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.OPEN.Тип);
	ТипыКолонок.Вставить("Срочная3М",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.HIGH.Тип);
	ТипыКолонок.Вставить("Срочная6М",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.LOW.Тип);
	
	Попытка
		Ставки = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
	Исключение
	КонецПопытки;
	Если Ставки = Неопределено Тогда
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для загрузки срочной РУОНИА.");
		Иначе
			ЗарегистрироватьОшибку("Нет данных для загрузки срочной РУОНИА.");
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаСтавки Из Ставки Цикл
	
		// Записываем
		Запись = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьМенеджерЗаписи();
		
		Запись.Период = СтрокаСтавки.Период;
		
		Запись.Биржа = БиржаНФА;
		Запись.БиржевойИндекс = СрочноеРУОНИА;
		
		Запись.CLOSE = СтрокаСтавки.Индекс;
		Запись.OPEN = СтрокаСтавки.Срочная1М;
		Запись.HIGH = СтрокаСтавки.Срочная3М;
		Запись.LOW = СтрокаСтавки.Срочная6М;
		
		Попытка
			Запись.Записать();
		Исключение
			ЗарегистрироватьОшибку(ОписаниеОшибки());
			ОтменитьТранзакцию();
			Прервать;
		КонецПопытки;
	
	КонецЦикла;
	
	КонтрольСрочнойRUONIA(СрочноеРУОНИА);
	
	// Оповещаем пользователя
	ОповеститьОбОшибках();

	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Срочные РУОНИА успешно загружены.");
	КонецЕсли;	
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры 

Процедура КонтрольСрочнойRUONIA(СрочноеРУОНИА)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ЗначенияБиржевыхИндексов.CLOSE ЕСТЬ НЕ NULL  КАК ЕстьСтавка,
		|	ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)) КАК РабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО ДанныеКалендаря.Дата = ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс = &ИндексРУОНИА)
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ ДанныеКалендаря.Дата В (&ДатыИсключеныИзСверки)
		|	И ЗначенияБиржевыхИндексов.CLOSE ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ИндексРУОНИА",	СрочноеРУОНИА);
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
	
	//ЦБ не расчитал ставку на 30.12.21. Об этом опубликована новость на сайте ЦБ.
	//Что бы при проверке не сыпались ошибки (когда нет ставки), исключаем дату из сверки.
	МассивДат = Новый Массив;
	МассивДат.Добавить(Дата(2021,12,30));
	МассивДат.Добавить(Дата(2022,12,30));
	МассивДат.Добавить(Дата(2023,12,29));
	
	Запрос.УстановитьПараметр("ДатыИсключеныИзСверки", МассивДат);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = СтрШаблон(
			"%1 срочная РУОНИА на %2 (%3 день)",
			Формат(Выборка.ЕстьСтавка, "БЛ=Отсутствует; БИ=Есть"),
			Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"),
			Формат(Выборка.РабочийДень, "БЛ=выходной; БИ=рабочий"));
			
		ЗарегистрироватьОшибку(ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура КонтрольЗагрузкиДанных()
	
	ПредыдущийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата())-1);
	
	СтрокаСообщений = "";
	
	Если Не РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(ПредыдущийРабочийДень,, СтрокаСообщений) Тогда
		
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Отсутствуют загружаемые данные." + Символы.ПС + СтрокаСообщений, "Импорт прочих котировок.");
				
	КонецЕсли;

КонецПроцедуры

#Область Вспомогательные_функции

Функция ВернутьАдресРесурса(Рынок, ДатаЗагрузки, РежимСверки = Ложь)

	Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		СтрокаАдреса = "/iss/downloads/engines/stock/markets/bonds/years/@YYYY/months/@MM/days/@DD/securities_micex_stock_bonds_@YYYY_@MM_@DD.csv.zip"
		
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Акции
		Или Рынок = Перечисления.РынкиЦенныхБумаг.Паи
		Или Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия
		Или Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки
	Тогда
		СтрокаАдреса = "/iss/downloads/engines/stock/markets/shares/years/@YYYY/months/@MM/days/@DD/securities_micex_stock_shares_@YYYY_@MM_@DD.csv.zip"
		
	ИначеЕсли Рынок = "ЗначенияИндексов" Тогда
		Если (ДатаЗагрузки < ТекущаяДата() - 30 * 60 * 60) Или РежимСверки Тогда
			СтрокаАдреса = "/iss/downloads/engines/stock/markets/index/years/@YYYY/months/@MM/securities_micex_stock_index_@YYYY_@MM.csv.zip";
		Иначе
			СтрокаАдреса = "/iss/downloads/engines/stock/markets/index/years/@YYYY/months/@MM/days/@DD/securities_micex_stock_index_@YYYY_@MM_@DD.csv.zip";
		КонецЕсли;
		
	ИначеЕсли Рынок = "ИнформацияОВнебиржевыхСделкахПАОМосковскаяБиржа" Тогда
		СтрокаАдреса = "https://www.moex.com/ru/expit/trades-csv.aspx?day1=@YYYYMMDD&type=2";
		
	ИначеЕсли Рынок = "ИнформацияОВнебиржевыхСделкахЗАОФБММВБ" Тогда
		СтрокаАдреса = "https://www.moex.com/ru/expit/trades-csv-f.aspx?day1=@YYYYMMDD&type=2";
		
	ИначеЕсли Рынок = "КотировкиБлумберг" Тогда
		СтрокаАдреса = "\\am-1c00\Рома\Blumberg\@DD@MM@YY.xlsx";
		
	ИначеЕсли Рынок = "ROISfix" Тогда
		СтрокаАдреса = "/files/csv/fr_roisfix/@DD.@MM.@YYYY.xlsx";
		
	КонецЕсли;	

	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "@YYYYMMDD", Формат(ДатаЗагрузки ,"ДФ=yyyyMMdd"));
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "@YYYY", Формат(ДатаЗагрузки ,"ДФ=yyyy"));
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "@YY", Формат(ДатаЗагрузки ,"ДФ=yy"));
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "@MM", Формат(ДатаЗагрузки ,"ДФ=MM"));
	СтрокаАдреса = СтрЗаменить(СтрокаАдреса, "@DD", Формат(ДатаЗагрузки ,"ДФ=dd"));
	
	Возврат СтрокаАдреса;
	
КонецФункции // ВернутьАдресРесурса

Функция СкачатьФайл(ИмяХоста, АдресРесурса)

	Соединение = Новый HTTPСоединение(ИмяХоста);
	
	Запрос              = Новый HTTPЗапрос;
	Запрос.АдресРесурса = АдресРесурса;
	
	ИмяФайла = "";
	
	Если ИмяХоста = "iss.moex.com" Тогда
		
		//Запрос.Заголовки.Вставить("Authorization", Base64);
		ИмяФайла = КаталогВременныхФайлов() + "securities.zip"; 
		
	ИначеЕсли ИмяХоста = "roisfix.ru" Тогда
		
		ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
		
	КонецЕсли;
	
	Если ИмяФайла <> "" Тогда
		Соединение.Получить(Запрос, ИмяФайла);
	Конецесли;
	
	Возврат ИмяФайла;
	
КонецФункции // СкачатьФайл

Функция ИзвлечьФайлCSV(ИмяФайлаZIP)

	ИмяФайлаCSV = КаталогВременныхФайлов() + "securities.csv";
	
	Попытка
	    УдалитьФайлы(ИмяФайлаCSV);
	Исключение
	КонецПопытки;
	
	Попытка
		ЧтениеZIP = Новый ЧтениеZipФайла(ИмяФайлаZIP);
		ЧтениеZIP.ИзвлечьВсе(КаталогВременныхФайлов(), РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Исключение
		Сообщить(ОписаниеОшибки());
		
		ИмяФайлаCSV = "";
	КонецПопытки;
	
	Возврат ИмяФайлаCSV;
	
КонецФункции // ИзвлечьФайлCSV

Функция ПолучитьЗначениеЯчейки(Ячейка, РазрядностьОкругления = 0)
	
	Если Ячейка.СодержитЗначение Тогда
		Если РазрядностьОкругления = 0 Тогда
			Возврат Ячейка.Значение;
		Иначе
			Возврат Окр(Ячейка.Значение, РазрядностьОкругления);
		КонецЕсли;
		
	Иначе
		Возврат Ячейка.Текст;
	КонецЕсли;
	
КонецФункции

Функция УдалитьСпецСимволы(Знач Значение)
	
	Значение = СтрЗаменить(Значение, Символы.НПП, "");
	
	Возврат Значение;
	
КонецФункции

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Функция ОповеститьОбОшибках()
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если ЕстьОшибки Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ЕстьОшибки;
	
КонецФункции

Функция РаботаСВнешнимиСистемамиСтрокаСоединенияСExternals()
	
	Возврат РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	
