#Область Получение_индексов_ROISfix

Процедура ЗагрузитьЗначенияROISfix(ТолькоОтсутствующие = Ложь, ТолькоРасхождения = Ложь) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	БиржаНФА 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("СРО_НФА");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БиржевыеИндексы.Ссылка КАК Ссылка,
		|	БиржевыеИндексы.Код КАК Код
		|ИЗ
		|	Справочник.БиржевыеИндексы КАК БиржевыеИндексы
		|ГДЕ
		|	БиржевыеИндексы.Код ПОДОБНО ""RUB__OISFIX""";
	
	ИндексыROISfix = Запрос.Выполнить().Выгрузить();
	
	БлокировкаСтавок = Новый БлокировкаДанных;
	ЭлементБлокировкиСтавок = БлокировкаСтавок.Добавить("РегистрСведений.ЗначенияБиржевыхИндексов");
	ЭлементБлокировкиСтавок.УстановитьЗначение("Биржа", БиржаНФА);
	ЭлементБлокировкиСтавок.ИсточникДанных = ИндексыROISfix;
	ЭлементБлокировкиСтавок.ИспользоватьИзИсточникаДанных("БиржевойИндекс", "Ссылка");
	ЭлементБлокировкиСтавок.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаСтавок.Заблокировать();
	
	// Инициализация вспомогательных переменных
	СтрокаСоединения	= РаботаСВнешнимиСистемамиСтрокаСоединенияСExternals();
	ТекстЗапроса		= "
		|SELECT DISTINCT CAST([Date] AS DateTime) [Период]
		|      ,[ROISFIX_1W_Value]
		|      ,[ROISFIX_2W_Value]
		|      ,[ROISFIX_1M_Value]
		|      ,[ROISFIX_2M_Value]
		|      ,[ROISFIX_3M_Value]
		|      ,[ROISFIX_6M_Value]
		|      ,[ROISFIX_1Y_Value]
		|      ,[ROISFIX_2Y_Value]
		|  FROM [Externals].[dbo].[ROISFIX] 
		|WHERE
		|	Date BETWEEN &ДатаНачала AND &ДатаОкончания";
	ДатаНачалаSQL		= "'" + Формат(ЭтотОбъект.Период.ДатаНачала,    "ДФ=yyyyMMdd") + "'";
	ДатаОкончанияSQL	= "'" + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyyMMdd") + "'";
	
	// Подготавливаем запрос
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаНачала", ДатаНачалаSQL);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаОкончания", ДатаОкончанияSQL);
	                             
	// Получаем котировки с сервера
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период",				Новый ОписаниеТипов("Дата", , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("ROISFIX_1W_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_2W_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_1M_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_2M_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_3M_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_6M_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_1Y_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	ТипыКолонок.Вставить("ROISFIX_2Y_Value",	Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы.VALUE.Тип);
	
	Попытка
		Ставки = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
	Исключение
	КонецПопытки;
	
	Если Ставки = Неопределено Тогда
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для загрузки ставок ROISFIX.");
		Иначе
			ЗарегистрироватьОшибку("Нет данных для загрузки ставок ROISFIX.");
			ОтменитьТранзакцию();
