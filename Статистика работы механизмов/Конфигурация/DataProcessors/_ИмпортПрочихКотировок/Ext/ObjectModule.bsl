Процедура ЗагрузитьСписокИндексаММВБ() Экспорт

	СтрокаСоединения 	= "Driver={SQL Server};Server=AP15.G1.LAN;UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=MatriX_External";
	ТипыКолонок 		= Новый Структура("Security_Code", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
	ТекстЗапроса 		= 
		"SELECT [Security_Code]
		|FROM [MatriX_External].[dbo].[MICEX_Indexes_Structure] 
		|Where [Index_Code] = 'MICEXINDEXCF' 
		|  and [Valid_From] <= 'ТекущаяДата' 
		|  and [Valid_To] > 'ТекущаяДата'";
	
	ПараметрыЗагрузки = Новый Структура;
	ПараметрыЗагрузки.Вставить("СтрокаСоединения", 	СтрокаСоединения);
	ПараметрыЗагрузки.Вставить("ТекстЗапроса", 		ТекстЗапроса);
	ПараметрыЗагрузки.Вставить("ТипыКолонок", 		ТипыКолонок);
	
	МассивДат = Новый Массив;
		
	Если ЭтотОбъект.Период.ДатаНачала <> НачалоДня(ЭтотОбъект.Период.ДатаОкончания) Тогда
	    // получим даты изменений списка
		ТекстЗапросаДат = 
			"SELECT DISTINCT [Valid_From]
			|FROM [MatriX_External].[dbo].[MICEX_Indexes_Structure] 
			|WHERE [Index_Code] = 'MICEXINDEXCF' 
			|	AND [Valid_From] BETWEEN 'ДатаНачала' AND 'ДатаОкончания'
			|ORDER BY [Valid_From]";
		ТекстЗапросаДат = СтрЗаменить(ТекстЗапросаДат, "ДатаНачала", Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=yyyy-MM-dd"));
		ТекстЗапросаДат = СтрЗаменить(ТекстЗапросаДат, "ДатаОкончания", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy-MM-dd"));
		
		ДатыСписка = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапросаДат,,, Новый Структура("ВозвращатьПустуюТаблицу", Истина));
		
		Для каждого Строка Из ДатыСписка Цикл
			МассивДат.Добавить(Дата(СтрЗаменить(Строка.Valid_From, "-", "")));
		КонецЦикла; 
		
	Иначе
		МассивДат.Добавить(НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	КонецЕсли; 
	
	Для Каждого ДатаЗагрузки ИЗ МассивДат Цикл
		
		ПараметрыЗагрузки.Вставить("ДатаЗагрузки", ДатаЗагрузки);
		Выборка = ПолучитьИзмененияСпискаИндексовММВБ(ПараметрыЗагрузки);
		
		Если Выборка = Неопределено Тогда
		
			ЗарегистрироватьОшибку("Не удалось загрузить список акций для расчета Индекса ММВБ на " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
			Продолжить;
		
		КонецЕсли; 
		
		Пока Выборка.Следующий() Цикл
		
			Запись = РегистрыСведений.ПеречниОбъектов.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Записать();
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИзмененияСпискаИндексовММВБ(ПараметрыЗагрузки)

	СтрокаСоединения 	= ПараметрыЗагрузки.СтрокаСоединения;
	ТекстЗапроса 		= ПараметрыЗагрузки.ТекстЗапроса;
	ТипыКолонок 		= ПараметрыЗагрузки.ТипыКолонок;
	ДатаЗагрузки 		= ПараметрыЗагрузки.ДатаЗагрузки;
	
	КодыММВБ = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, СтрЗаменить(ТекстЗапроса, "ТекущаяДата", Формат(ДатаЗагрузки, "ДФ=yyyy-MM-dd")), ТипыКолонок);
	
	Если КодыММВБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыММВБ.Security_Code КАК КодНаММВБ
		|ПОМЕСТИТЬ _КодыММВБ
		|ИЗ
		|	&КодыММВБ КАК КодыММВБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК Объект,
		|	ИСТИНА КАК Включен
		|ПОМЕСТИТЬ _НовыеЗначения
		|ИЗ
		|	_КодыММВБ КАК _КодыММВБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _КодыММВБ.КодНаММВБ = КодыВТорговыхСистемахСрезПоследних.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПеречниОбъектовСрезПоследних.Объект КАК Объект,
		|	ПеречниОбъектовСрезПоследних.Включен КАК Включен
		|ПОМЕСТИТЬ _ТекущиеЗначения
		|ИЗ
		|	РегистрСведений.ПеречниОбъектов.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ММВБ)
		|				И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СоставИндексаММВБ)) КАК ПеречниОбъектовСрезПоследних
		|ГДЕ
		|	ПеречниОбъектовСрезПоследних.Включен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТекущиеЗначения.Объект КАК Объект,
		|	ЛОЖЬ КАК Включен
		|ПОМЕСТИТЬ _ИзмененныеЗначения
		|ИЗ
		|	_ТекущиеЗначения КАК _ТекущиеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НовыеЗначения КАК _НовыеЗначения
		|		ПО _ТекущиеЗначения.Объект = _НовыеЗначения.Объект
		|ГДЕ
		|	_НовыеЗначения.Включен ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НовыеЗначения.Объект,
		|	_НовыеЗначения.Включен
		|ИЗ
		|	_НовыеЗначения КАК _НовыеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТекущиеЗначения КАК _ТекущиеЗначения
		|		ПО (_ТекущиеЗначения.Объект = _НовыеЗначения.Объект)
		|ГДЕ
		|	_ТекущиеЗначения.Включен ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ММВБ) КАК ВнешняяСистема,
		|	ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СоставИндексаММВБ) КАК ВидПеречня,
		|	_ИзмененныеЗначения.Объект КАК Объект,
		|	_ИзмененныеЗначения.Включен КАК Включен,
		|	&ТекущаяДата КАК ДатаОбновления,
		|	&Ответственный КАК Ответственный,
		|	""MatriX_External"" КАК Источник
		|ИЗ
		|	_ИзмененныеЗначения КАК _ИзмененныеЗначения";
	
	Запрос.УстановитьПараметр("КодыММВБ", 		КодыММВБ);
	Запрос.УстановитьПараметр("Период", 		ДатаЗагрузки);
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Ответственный", 	РаботаСПользователями.ТекущийПользователь());
	
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

#КонецОбласти

#Область Информация_о_внебиржевых_сделках

Процедура ЗагрузитьИнформациюОВнебиржевыхСделках(ТолькоОтсутствующие = Ложь) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	 КонецЕсли;
	 
	ОтборПоКодуНаММВБ = "";
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ЦеннаяБумага) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВТорговыхСистемахСрезПоследних.Код КАК Код
			|ИЗ
			|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
			|			&Период,
			|			Объект = &ЦеннаяБумага
			|				И ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних";

		Запрос.УстановитьПараметр("Период",       ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			ОтборПоКодуНаММВБ = Выборка.Код;
		КонецЕсли;
	КонецЕсли;
	
	
	Источники = Новый Соответствие;				   
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				И Объект В (&ПАО_ММВБ, &ЗАО_ФБММВБ)) КАК КодыВоВнешнихСистемахСрезПоследних";
				   
	Запрос.УстановитьПараметр("Период"	  , ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПАО_ММВБ"  , ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПАО_ММВБ"));
	Запрос.УстановитьПараметр("ЗАО_ФБММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ЗАО_ФБММВБ"));
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Источники.Вставить(Выборка.Код, Выборка.Объект); 
	КонецЦикла;
	 
	ДатаЗагрузки = КонецДня(ЭтотОбъект.Период.ДатаНачала) - 86400;
	
	Пока ДатаЗагрузки < ЭтотОбъект.Период.ДатаОкончания Цикл
		
		ДатаЗагрузки = ДатаЗагрузки + 86400;
		
		// ПАО Московская Биржа
		ИнформацияОВнебиржевыхСделкахПАОМосковскаяБиржа = ПолучитьСтруктуруТаблицыИнформацииОВнебиржевыхСделках();
		
		ИмяФайлаCSV = СкачатьФайлCMoex(ВернутьАдресРесурса("ИнформацияОВнебиржевыхСделкахПАОМосковскаяБиржа", ДатаЗагрузки));
		
		Если Не ЗначениеЗаполнено(ИмяФайлаCSV) Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлCSV = Новый ТекстовыйДокумент;
		ФайлCSV.Прочитать(ИмяФайлаCSV);
		
		Если ФайлCSV.КоличествоСтрок() <= 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьТаблицуИнформацииОВнебиржевыхСделках(ИнформацияОВнебиржевыхСделкахПАОМосковскаяБиржа, ФайлCSV, ИмяФайлаCSV, ОтборПоКодуНаММВБ);
		ЗагрузитьИнформациюОВнебиржевыхСделкахИзТаблицы(ИнформацияОВнебиржевыхСделкахПАОМосковскаяБиржа, ДатаЗагрузки, ТолькоОтсутствующие, Источники.Получить("221727"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружен файл с информацей о внебиржевых сделках ПАО Московская Биржа за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		
		// ЗАО ФБ ММВБ
		ИнформацияОВнебиржевыхСделкахЗАОФБММВБ = ПолучитьСтруктуруТаблицыИнформацииОВнебиржевыхСделках();
		
		ИмяФайлаCSV = СкачатьФайлCMoex(ВернутьАдресРесурса("ИнформацияОВнебиржевыхСделкахЗАОФБММВБ", ДатаЗагрузки));
		
		Если Не ЗначениеЗаполнено(ИмяФайлаCSV) Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлCSV = Новый ТекстовыйДокумент;
		ФайлCSV.Прочитать(ИмяФайлаCSV);
		
		Если ФайлCSV.КоличествоСтрок() <= 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьТаблицуИнформацииОВнебиржевыхСделках(ИнформацияОВнебиржевыхСделкахЗАОФБММВБ, ФайлCSV, ИмяФайлаCSV, ОтборПоКодуНаММВБ);
		ЗагрузитьИнформациюОВнебиржевыхСделкахИзТаблицы(ИнформацияОВнебиржевыхСделкахЗАОФБММВБ, ДатаЗагрузки, ТолькоОтсутствующие, Источники.Получить("225801"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружен файл с информацей о внебиржевых сделках ЗАО ФБ ММВБ за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		
	КонецЦикла;
	
	ОповеститьОбОшибках();

КонецПроцедуры

Функция ПолучитьСтруктуруТаблицыИнформацииОВнебиржевыхСделках()
	
	ЗначенияИндексов = Новый ТаблицаЗначений;
	ЗначенияИндексов.Колонки.Добавить("SECID"		,	Метаданные.РегистрыСведений.КодыВТорговыхСистемах.Ресурсы.Код.Тип);
	ЗначенияИндексов.Колонки.Добавить("ТорговыйДень",	Метаданные.РегистрыСведений.ИнформацияОВнебиржевыхСделках.Измерения.ТорговыйДень.Тип);
	ЗначенияИндексов.Колонки.Добавить("СрокИсполнения",	Метаданные.РегистрыСведений.ИнформацияОВнебиржевыхСделках.Измерения.СрокИсполнения.Тип);
	ЗначенияИндексов.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата"));
	ЗначенияИндексов.Колонки.Добавить("КрупныеСделки",	Метаданные.РегистрыСведений.ИнформацияОВнебиржевыхСделках.Измерения.КрупныеСделки.Тип);
	
	Для каждого РесурсМетаданных Из Метаданные.РегистрыСведений.ИнформацияОВнебиржевыхСделках.Ресурсы Цикл
		ЗначенияИндексов.Колонки.Добавить(РесурсМетаданных.Имя, РесурсМетаданных.Тип);
	КонецЦикла;
	
	Возврат ЗначенияИндексов;
	
КонецФункции

Функция СкачатьФайлCMoex(АдресРесурса)

	ИмяФайлаCSV = КаталогВременныхФайлов() + "OTCtransactions.csv";
	
	Попытка
	    УдалитьФайлы(ИмяФайлаCSV);
	Исключение
	КонецПопытки;
	
	Для НомерПопытки = 1 По 3 Цикл
		
		Попытка
			КопироватьФайл(АдресРесурса, КаталогВременныхФайлов() + "OTCtransactions.csv");
			Прервать;
		Исключение
			
			Если НомерПопытки = 3 Тогда
				
				ЗарегистрироватьОшибку("Не удалось получить данные с реурса " + АдресРесурса + ". Система сообщает: " + ОписаниеОшибки());
				Возврат Неопределено;
				
			Иначе
				
				ВремяТаймаута = 5;
    			ЗапуститьПриложение("Timeout /T " + Строка(ВремяТаймаута) + " /NoBreak", , Истина);

			КонецЕсли;
				
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ИмяФайлаCSV;

КонецФункции // СкачатьФайл

Процедура ЗаполнитьТаблицуИнформацииОВнебиржевыхСделках(ИнформацияОВнебиржевыхСделках, ФайлCSV, АдресФайла, ОтборПоКодуНаММВБ)
	
	СоответствиеПолей = Новый Соответствие;
	СоответствиеПолей.Вставить("Дата отчета сделок", "Период");
	СоответствиеПолей.Вставить("Торговый день", "ТорговыйДень");
	СоответствиеПолей.Вставить("Код ц/б", "SECID");
	СоответствиеПолей.Вставить("Срок исполнения, дней", "СрокИсполнения");
	СоответствиеПолей.Вставить("Кол-во сделок", "КоличествоСделок");
	СоответствиеПолей.Вставить("Объем сделок, руб.", "ОбъемСделок");
	СоответствиеПолей.Вставить("Кол-во ц/б", "КоличествоЦенныхБумаг");
	СоответствиеПолей.Вставить("Макс. цена", "МаксимальнаяЦена");
	СоответствиеПолей.Вставить("Мин. цена", "МинимальнаяЦена");
	СоответствиеПолей.Вставить("Расчетная цена", "РасчетнаяЦена");
	СоответствиеПолей.Вставить("Крупные сделки", "КрупныеСделки");
	
	ЗаголовокCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(1), ";");
	
	Для Каждого Поле Из СоответствиеПолей Цикл
		Если ЗаголовокCSV.Найти(Поле.Ключ) = Неопределено Тогда
			ЗарегистрироватьОшибку("В файле " + АдресФайла + " не обнаружено поле: """ + Поле.Ключ + """");
		КонецЕсли;
	КонецЦикла;
	
	Для НомерСтроки = 2 По ФайлCSV.КоличествоСтрок() Цикл
		
		ДанныеCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(НомерСтроки), ";");
		
		Если ДанныеCSV.Найти("Дата отчета сделок") <> Неопределено Тогда //это заголовок
			Продолжить;
		КонецЕсли;
		
		Информация = Новый Структура();
		
		Для Инд = 0 По ЗаголовокCSV.Количество() - 1 Цикл
			ИмяПоляФайла	= ЗаголовокCSV[Инд];
			ИмяПоля			= СоответствиеПолей.Получить(ИмяПоляФайла);
			
			Если ИнформацияОВнебиржевыхСделках.Колонки.Найти(ИмяПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Информация.Вставить(ИмяПоля, СокрЛП(ДанныеCSV[Инд]));
			
			Если ИмяПоля = "SECID" Тогда
				Информация.Вставить(ИмяПоля, СокрЛП(ДанныеCSV[Инд]));
			ИначеЕсли ИмяПоля = "СрокИсполнения" Тогда
				Если СокрЛП(ДанныеCSV[Инд]) = "Более 30" Тогда
					Информация.Вставить(ИмяПоля, Перечисления.СрокиИсполненияПоВнебиржевымСделкам.Более30Дней);
				ИначеЕсли СокрЛП(ДанныеCSV[Инд]) = "От 6 до 30" Тогда
					Информация.Вставить(ИмяПоля, Перечисления.СрокиИсполненияПоВнебиржевымСделкам.От6До30Дней);
				ИначеЕсли СокрЛП(ДанныеCSV[Инд]) = "До 5" Тогда
					Информация.Вставить(ИмяПоля, Перечисления.СрокиИсполненияПоВнебиржевымСделкам.До5Дней);
				КонецЕсли;
			ИначеЕсли ИмяПоля = "Период" Тогда
				Информация.Вставить(ИмяПоля, РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(СокрЛП(ДанныеCSV[Инд])));
			ИначеЕсли ИмяПоля = "ТорговыйДень" Тогда
				Информация.Вставить(ИмяПоля, ВРЕГ(СокрЛП(ДанныеCSV[Инд])) = "Y");
			ИначеЕсли ИмяПоля = "КрупныеСделки" Тогда
				Информация.Вставить(ИмяПоля, ВРЕГ(СокрЛП(ДанныеCSV[Инд])) = "ДА");
			ИначеЕсли Не ПустаяСтрока(ДанныеCSV[Инд]) Тогда
				Попытка
					Информация.Вставить(ИмяПоля, Число(СокрЛП(ДанныеCSV[Инд])));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОтборПоКодуНаММВБ) И ОтборПоКодуНаММВБ <> Информация.SECID Тогда Продолжить; КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ИнформацияОВнебиржевыхСделках.Добавить(), Информация);
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьТаблицуИнформацииОВнебиржевыхСделках

Процедура ЗагрузитьИнформациюОВнебиржевыхСделкахИзТаблицы(ИнформацияОВнебиржевыхСделках, ДатаЗагрузки, ТолькоОтсутствующие = Ложь, Источник)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнформацияОВнебиржевыхСделках.SECID КАК SECID,
		|	ИнформацияОВнебиржевыхСделках.КоличествоСделок КАК КоличествоСделок,
		|	ИнформацияОВнебиржевыхСделках.КоличествоЦенныхБумаг КАК КоличествоЦенныхБумаг,
		|	ИнформацияОВнебиржевыхСделках.КрупныеСделки КАК КрупныеСделки,
		|	ИнформацияОВнебиржевыхСделках.МаксимальнаяЦена КАК МаксимальнаяЦена,
		|	ИнформацияОВнебиржевыхСделках.МинимальнаяЦена КАК МинимальнаяЦена,
