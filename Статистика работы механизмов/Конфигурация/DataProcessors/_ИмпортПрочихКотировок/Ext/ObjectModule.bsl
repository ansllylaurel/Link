			Запись = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьМенеджерЗаписи();
			
			Запись.Биржа			= Биржа;
			Запись.БиржевойИндекс	= Индекс;
			
			ЗаполнитьЗначенияСвойств(Запись, СтрокаСтавки); 
			
			Попытка
				Запись.Записать();
			Исключение
				ЗарегистрироватьОшибку(ОписаниеОшибки());
				ОтменитьТранзакцию();
				Прервать;
			КонецПопытки;
		
		КонецЦикла;		

		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	КонецЕсли;
	
	// Сообщаем о результатах
	
