//Процедура может грузить любые вычисляемые на Risk_Management индексы, нужно переименовать процедуру и команду
Процедура ЗаполнитьТаблицуЗначенияКБДММВБ(ДатаЗагрузки, ЗначенияИндексов, Индексы, Валюты = Неопределено, БиржаИндексов)

	СтрокаСоединения = "Driver={SQL Server};Server=AP18.G1.LAN;UID=Nikolay;PWD=11111;Database=Risk_Management";
	
	ТаблицаРасчетныхИндексов = Новый ТаблицаЗначений;
	ТаблицаРасчетныхИндексов.Колонки.Добавить("Код");
	ТаблицаРасчетныхИндексов.Колонки.Добавить("Наименование");
	ТаблицаРасчетныхИндексов.Колонки.Добавить("НаименованиеПолное");
	ТаблицаРасчетныхИндексов.Колонки.Добавить("Функция");
	
	НоваяСтрока = ТаблицаРасчетныхИндексов.Добавить();
	НоваяСтрока.Код					= "MOEX GCURVE 1.5Y";
	НоваяСтрока.Наименование		= "КБД Московской биржи 1,5 года";
	НоваяСтрока.НаименованиеПолное	= "КБД Московской биржи со сроком до погашения 1,5 года";
	НоваяСтрока.Функция				= "[dbo].[get_indexGKO_value]('&Период&', 1.5)";
	
	НоваяСтрока = ТаблицаРасчетныхИндексов.Добавить();
	НоваяСтрока.Код					= "MOEX GCURVE 1Y";
	НоваяСтрока.Наименование		= "КБД Московской биржи 1 год";
	НоваяСтрока.НаименованиеПолное	= "КБД Московской биржи со сроком до погашения 1 год";
	НоваяСтрока.Функция				= "[dbo].[get_indexGKO_value]('&Период&', 1)";
	
	МассивЗапросов = Новый Массив;
	
	Для Каждого СтрокаИндексов Из ТаблицаРасчетныхИндексов Цикл
		ШаблонЗапроса	= "
			|SELECT
			|	'&Период&' AS [Период],
			|	'&Код&' AS [SECID],
			|	'&Наименование&' AS [SHORTNAME],
			|	'&НаименованиеПолное&' AS [NAME],
			|	'' as CURRENCYID,
			|	T.value AS [CLOSE],
			|	T.value AS [OPEN],
			|	T.value AS [HIGH],
			|	T.value AS [LOW]
			|FROM
			|	(SELECT
			|		&Функция& AS [value]) AS T";
		
		Для Каждого Колонка Из ТаблицаРасчетныхИндексов.Колонки Цикл
			ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "&" + Колонка.Имя + "&", СтрокаИндексов[Колонка.Имя]);
		КонецЦикла;
		
		МассивЗапросов.Добавить(ШаблонЗапроса);
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(МассивЗапросов, Символы.ПС + "Union all" + Символы.ПС);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период&", Формат(ДатаЗагрузки, "ДФ=yyyyMMdd"));	
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период",		Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("SECID",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТипыКолонок.Вставить("SHORTNAME",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("NAME", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТипыКолонок.Вставить("CURRENCYID",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	
	Для каждого РесурсМетаданных Из Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы Цикл
		ТипыКолонок.Вставить(РесурсМетаданных.Имя, РесурсМетаданных.Тип);
	КонецЦикла;
	
	ТаблицаИндексов = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
		
	Если ТаблицаИндексов = Неопределено Тогда 
		ЗарегистрироватьОшибку("Не удалось загрузить КБД Московской биржи за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗначенияИндекса Из ТаблицаИндексов Цикл
		ОбработатьЗначенияИндекса(ЗначенияИндексов, ЗначенияИндекса, Индексы, Валюты, БиржаИндексов);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЗначенияКБДММВБ(ТолькоОтсутствующие = Ложь) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код,
		|	Валюты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Валюты КАК Валюты";
	
	Валюты = Запрос.Выполнить().Выгрузить();
	
	ДатаЗагрузки = КонецДня(ЭтотОбъект.Период.ДатаНачала) - 86400;
	
	Пока ДатаЗагрузки < ЭтотОбъект.Период.ДатаОкончания Цикл
		
		ДатаЗагрузки = ДатаЗагрузки + 86400;
		
		ЗначенияИндексов = ПолучитьСтруктуруТаблицыИндексов();

		БиржаИндексов = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		
		Индексы = ПолучитьИндексы(БиржаИндексов);
		ЗаполнитьТаблицуЗначенияКБДММВБ(ДатаЗагрузки, ЗначенияИндексов, Индексы, Валюты, БиржаИндексов);
		
		ЕстьДанные = (ЗначенияИндексов.Количество() <> 0);
		
		Если ЕстьДанные Тогда
			ЗагрузитьЗначенияИндексовИзТаблицы(ЗначенияИндексов, ДатаЗагрузки, БиржаИндексов, ТолькоОтсутствующие);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружены КБД Московской биржи за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЦикла;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

#КонецОбласти

#Область Получение_КБД_государственных_облигаций_США

Процедура ЗагрузитьКБДГосударственныхОблигацийСША(ТолькоОтсутствующие = Ложь) Экспорт
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Биржа		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_USDT");
	ИндексыКБД	= Справочники.БиржевыеИндексы.ИндексыГосударственныхОблигацийСША();
	
	БлокировкаСтавок = Новый БлокировкаДанных;
	ЭлементБлокировкиСтавок = БлокировкаСтавок.Добавить("РегистрСведений.ЗначенияБиржевыхИндексов");
	ЭлементБлокировкиСтавок.Режим			= РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировкиСтавок.ИсточникДанных	= ИндексыКБД;
	ЭлементБлокировкиСтавок.УстановитьЗначение("Биржа", Биржа);
	ЭлементБлокировкиСтавок.ИспользоватьИзИсточникаДанных("БиржевойИндекс", "Индекс");
	БлокировкаСтавок.Заблокировать();
	
	// Инициализация вспомогательных переменных
	
	СтрокаСоединения = РаботаСВнешнимиСистемамиСтрокаСоединенияСExternals();
	
	ТекстЗапроса = 
		"SELECT
		|	CAST(Rates.Date AS DATETIME) [Период],
		|	Rate_1M,
		|	Rate_2M,
		|	Rate_3M,
		|	Rate_4M,
		|	Rate_6M,
		|	Rate_1Y,
		|	Rate_2Y,
		|	Rate_3Y,
		|	Rate_5Y,
		|	Rate_7Y,
		|	Rate_10Y,
		|	Rate_20Y,
		|	Rate_30Y
		|FROM
		|	Externals.dbo.USDT_Yield_Curve_Rates [Rates]
		|WHERE
		|	Date BETWEEN &ДатаНачала AND &ДатаОкончания";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаНачала",  "'" + Формат(ЭтотОбъект.Период.ДатаНачала,    "ДФ=yyyyMMdd") + "'");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаОкончания", "'" + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyyMMdd") + "'");
	
	// Получаем котировки с сервера
	
	Попытка
		Ставки = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса);
	Исключение
	КонецПопытки;
	
	Если Ставки = Неопределено Тогда
		
		ЗарегистрироватьОшибку("Нет данных для загрузки значений КБД государственных облигаций США за " + ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));
		ОтменитьТранзакцию();

	Иначе
		
		// Записываем их в регистр
		
		Для каждого СтрокаСтавки Из Ставки Цикл
			
			Для каждого СтрокаИндекса Из ИндексыКБД Цикл
			
				Запись = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьМенеджерЗаписи();
				
				Запись.Биржа			= Биржа;
				Запись.БиржевойИндекс	= СтрокаИндекса.Индекс;
				Запись.Период			= СтрокаСтавки.Период;
				Запись.YIELD			= СтрокаСтавки["Rate_" + Сред(СтрокаИндекса.Код, СтрДлина("Индекс_UST_Yield_") + 1)];
				
				Попытка
					Запись.Записать();
				Исключение
					ЗарегистрироватьОшибку(ОписаниеОшибки());
					ОтменитьТранзакцию();
					Прервать;
				КонецПопытки;				
			
			КонецЦикла; 
		
		КонецЦикла;		

		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
	КонецЕсли;
	
	// Сообщаем о результатах
	
	ЕстьОшибки = ОповеститьОбОшибках();

	Если Не ЕстьОшибки И Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значения КБД государственных облигаций США успешно загружены.");
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

