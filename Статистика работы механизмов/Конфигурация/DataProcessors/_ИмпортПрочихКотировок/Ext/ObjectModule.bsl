КонецПроцедуры

Процедура КонтрольROISFIX()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	ЗначенияБиржевыхИндексов.OPEN ЕСТЬ НЕ NULL КАК ЕстьСтавка,
		|	ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)) КАК РабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|		ПО ДанныеКалендаря.Дата = ЗначенияБиржевыхИндексов.Период
		|			И (ЗначенияБиржевыхИндексов.БиржевойИндекс.Код В (""RUB1MOISFIX"", ""RUB1WOISFIX"", ""RUB1YOISFIX"", ""RUB2MOISFIX"", ""RUB2WOISFIX"", ""RUB2YOISFIX"", ""RUB3MOISFIX"", ""RUB6MOISFIX""))
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВЫБОР
		|			КОГДА ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ТОГДА ЗначенияБиржевыхИндексов.OPEN ЕСТЬ NULL
		|			ИНАЧЕ ЗначенияБиржевыхИндексов.OPEN ЕСТЬ НЕ NULL 
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = СтрШаблон(
			"%1 ставка ROISFIX на %2 (%3 день)",
			Формат(Выборка.ЕстьСтавка, "БЛ=Отсутствует; БИ=Есть"),
			Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"),
			Формат(Выборка.РабочийДень, "БЛ=выходной; БИ=рабочий"));
			
		ЗарегистрироватьОшибку(ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

