Перем Base64; // см. в конце

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Импорт прочих котировок",
		"1.17",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийИндексовЗаВчерашнийДень", "Автоимпорт значений индексов за вчерашний день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийИндексовИзМатриксЗаВчерашнийДень", "Автоимпорт значений индексов из Матрикс за вчерашний день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийКБДММВБЗаВчерашнийДень", "Автоимпорт значений КБД Московской Биржи за вчерашний день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийИндексовROISfixЗаВчерашнийДень", "Автоимпорт значений индексов ROISfix за вчерашний день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийИндексовROISfixЗаТекущийДень", "Автоимпорт значений индексов ROISfix за текущий день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСтавокMosPrimeЗаТекущийДень", "Автоимпорт ставок MosPrime за текущий день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСпискаИндексаММВБ", "Автоимпорт списка акций для расчета Индекса ММВБ", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортИнформацииОВнебиржевыхСделкахЗаВчерашнийДень", "Автоимпорт информации о внебиржевых сделках за вчерашний день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортПараметровКривойБескупоннойДоходностиЗаВчерашнийДень", "Автоимпорт параметров кривой бескупонной доходности за вчерашний день", , Ложь, "ВызовСерверногоМетода");	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортРУОНИАЗаМесяцПоПредыдущийРабочийДень", "Автоимпорт РУОНИА за месяц по предыдущий рабочий день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийКБДГосударственныхОблигацийСШАЗаВчерашнийДень", "Автоимпорт значений КБД государственных облигаций США за вчерашний день", , Ложь, "ВызовСерверногоМетода");	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортЗначенийКБДГосударственныхОблигацийЗоныЕвроЗаВчерашнийДень", "Автоимпорт значений КБД государственных облигаций зоны евро за вчерашний день", , Ложь, "ВызовСерверногоМетода");	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоИмпортСрочнойРУОНИАЗаМесяцПоПредыдущийРабочийДень", "Автоимпорт срочной РУОНИА за месяц по предыдущий рабочий день", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольЗагрузкиДанных", "Контроль загрузки данных",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;	
	
	ТекущаяДата = ТекущаяДата(); 
	
	Если Найти(ИдентификаторКоманды, "АвтоИмпортЗначенийИндексовROISfixЗаВчерашнийДень") > 0 Тогда
	
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			ДатаКотировок = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДата - 60 * 60 * 24);
			ЭтотОбъект.Период = Новый СтандартныйПериод(НачалоДня(ДатаКотировок), КонецДня(ДатаКотировок));
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "АвтоИмпортЗначенийИндексовROISfixЗаТекущийДень") > 0 Тогда
		
		//после 13:00 на сайте появляются значения индексов
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			ЭтотОбъект.Период = Новый СтандартныйПериод(НачалоДня(ТекущаяДата), КонецДня(ТекущаяДата));
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Найти(ИдентификаторКоманды, "АвтоИмпортСтавокMosPrimeЗаТекущийДень") > 0 Тогда
	
		// Котировки за текущий рабочий день / предпраздничный появляются в 12:30 текущего дня.
		// Следовательно, выполнять автозагрузку или контроль наличия котировок в выходной день бессмыслено.
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДата);
			ЭтотОбъект.Период = Новый СтандартныйПериод(НачалоДня(ПоследнийРабочийДень), КонецДня(ПоследнийРабочийДень));
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовИзМатриксЗаВчерашнийДень" Тогда
	
	    // от последнего рабочего до вчерашнего дня
		
		ЭтотОбъект.Период				= Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
		ЭтотОбъект.Период.ДатаНачала	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала);
				
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовЗаВчерашнийДень" Тогда
		
		// В неторговые дни на сайте moex отсутствуют файлы с индексами
		
		КалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
		
		Если Справочники.Календари.ЭтоРабочийДень(КалендарьКотировок, ТекущаяДата - 60 * 60 * 24) Тогда 
			ЭтотОбъект.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортРУОНИАЗаМесяцПоПредыдущийРабочийДень"
			ИЛИ ИдентификаторКоманды = "АвтоИмпортСрочнойРУОНИАЗаМесяцПоПредыдущийРабочийДень" Тогда
		
		ЭтотОбъект.Период.ДатаОкончания	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата, -2);
		ЭтотОбъект.Период.ДатаНачала	= ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -1);
		
	ИначеЕсли ИдентификаторКоманды = "АвтоИмпортЗначенийКБДГосударственныхОблигацийСШАЗаВчерашнийДень"
		ИЛИ ИдентификаторКоманды = "АвтоИмпортЗначенийКБДГосударственныхОблигацийЗоныЕвроЗаВчерашнийДень"
	Тогда
		
	    // По рабочим дням от последнего рабочего до вчерашнего дня
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			ЭтотОбъект.Период				= Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
			ЭтотОбъект.Период.ДатаНачала	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала);
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ЭтотОбъект.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);	
		
	КонецЕсли;	
	
	// Организуем сбор статистики
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды, ПараметрыКоманды);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание
	);
				
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовЗаВчерашнийДень" Тогда
		ЗагрузитьЗначенияИндексов();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовИзМатриксЗаВчерашнийДень" Тогда
		ЗагрузитьЗначенияИндексовИзМатрикс();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийКБДММВБЗаВчерашнийДень" Тогда
		ЗагрузитьЗначенияКБДММВБ();      
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовROISfixЗаТекущийДень"
		ИЛИ ИдентификаторКоманды = "АвтоИмпортЗначенийИндексовROISfixЗаВчерашнийДень" Тогда
		ЗагрузитьЗначенияROISfix();      
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортСтавокMosPrimeЗаТекущийДень" Тогда
		ЗагрузитьЗначенияMosPrime();      
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортСпискаИндексаММВБ" Тогда
		ЗагрузитьСписокИндексаММВБ();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортИнформацииОВнебиржевыхСделкахЗаВчерашнийДень" Тогда
		ЗагрузитьИнформациюОВнебиржевыхСделках();
	КонецЕсли;
		
	Если ИдентификаторКоманды = "АвтоИмпортПараметровКривойБескупоннойДоходностиЗаВчерашнийДень" Тогда
		ЗагрузитьПараметрыКривойБескупоннойДоходности();
	КонецЕсли;
				
	Если ИдентификаторКоманды = "АвтоИмпортРУОНИАЗаМесяцПоПредыдущийРабочийДень" Тогда
		ЗагрузитьRUONIA();
	КонецЕсли;

	Если ИдентификаторКоманды = "АвтоИмпортСрочнойРУОНИАЗаМесяцПоПредыдущийРабочийДень" Тогда
		ЗагрузитьСрочнуюRUONIA();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийКБДГосударственныхОблигацийСШАЗаВчерашнийДень" Тогда
		ЗагрузитьКБДГосударственныхОблигацийСША();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "АвтоИмпортЗначенийКБДГосударственныхОблигацийЗоныЕвроЗаВчерашнийДень" Тогда
		ЗагрузитьКБДГосударственныхОблигацийЗоныЕвро();
	КонецЕсли;
	
	Если ИдентификаторКоманды = "КонтрольЗагрузкиДанных" Тогда
		КонтрольЗагрузкиДанных();	
	КонецЕсли;
	
	// Завершаем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры // ВыполнитьКоманду

// Возвращает параметры выполняемой по регламентному заданию команды для подключения к механизму регистрации работы
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды  
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды, ПараметрыКоманды)
	
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	ПараметрыОтчета.Вставить("Период", ЭтотОбъект.Период);

	Если ПараметрыКоманды.Свойство("Организация") Тогда
		ПараметрыОтчета.Вставить("Организация", ПараметрыКоманды.Организация);
	КонецЕсли;
	
	Если ПараметрыКоманды.Свойство("ПолучателиОповещения") Тогда
		ПараметрыОтчета.Вставить("ПолучателиОповещения", ПараметрыКоманды.ПолучателиОповещения);
	КонецЕсли;
	
	Описание = "";
	Для Каждого ПараметрОтчета Из ПараметрыОтчета Цикл
		Описание = Описание + ПараметрОтчета.Ключ + ": " + ПараметрОтчета.Значение + Символы.ПС;		
	КонецЦикла;
	Описание = Лев(Описание, СтрДлина(Описание) - СтрДлина(Символы.ПС));	
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета);
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

#Область Значения_биржевых_индексов

Процедура СверитьЗначенияИндексовПередЗагрузкой()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код,
		|	Валюты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Валюты КАК Валюты";
	
	Валюты = Запрос.Выполнить().Выгрузить();
	
	ДатаЗагрузки = КонецДня(ЭтотОбъект.Период.ДатаНачала);
	
	ЗначенияИндексов = ПолучитьСтруктуруТаблицыИндексов();
	ЗначенияИндексов.Колонки.Добавить("TRADEDATE", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	ЕстьCSV = Истина;
	
	ИмяФайлаCSV = ИзвлечьФайлCSV(СкачатьФайл("iss.moex.com", ВернутьАдресРесурса("ЗначенияИндексов", ДатаЗагрузки, Истина)));
	ИмяФайлаCSVПрошлыйМесяц = ИзвлечьФайлCSV(СкачатьФайл("iss.moex.com", ВернутьАдресРесурса("ЗначенияИндексов", ДобавитьМесяц(ДатаЗагрузки, -1), Истина)));
	
	
	Если ПустаяСтрока(ИмяФайлаCSV) Тогда
		ЕстьCSV = Ложь;
	Иначе
		ФайлCSV = Новый ТекстовыйДокумент;
		ФайлCSV.Прочитать(ИмяФайлаCSV);
		
		Если Не ПустаяСтрока(ИмяФайлаCSV) Тогда
			ФайлCSVПрошлыйМесяц = Новый ТекстовыйДокумент;
			ФайлCSVПрошлыйМесяц.Прочитать(ИмяФайлаCSVПрошлыйМесяц);
		КонецЕсли;	
		
		Если ФайлCSV.КоличествоСтрок() <= 9 Тогда
			ЕстьCSV = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьCSV Тогда
		БиржаИндексов = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		
		Индексы = ПолучитьИндексы(БиржаИндексов);
		
		ЗаполнитьТаблицуЗначенияИндексовИзCSV(ДатаЗагрузки, ЗначенияИндексов, ФайлCSV, Индексы, Валюты, БиржаИндексов, Истина);
		ЗаполнитьТаблицуЗначенияИндексовИзCSV(ДатаЗагрузки, ЗначенияИндексов, ФайлCSVПрошлыйМесяц, Индексы, Валюты, БиржаИндексов, Истина);
		
		Для Каждого СтрокаЗначенияИндексов Из ЗначенияИндексов Цикл
			СтрокаЗначенияИндексов.Период = СтрокаЗначенияИндексов.TRADEDATE;	
		КонецЦикла;	
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияИндексов.Период КАК Период,
			|	ЗначенияИндексов.Индекс КАК Индекс,
			|	ЗначенияИндексов.Валюта КАК Валюта,
			|	ЗначенияИндексов.SECID КАК SECID,
			|	ЗначенияИндексов.SHORTNAME КАК SHORTNAME,
			|	ЗначенияИндексов.NAME КАК NAME,
			|	ЗначенияИндексов.CURRENCYID КАК CURRENCYID,
			|	ЗначенияИндексов.CLOSE КАК CLOSE,
			|	ЗначенияИндексов.OPEN КАК OPEN,
			|	ЗначенияИндексов.HIGH КАК HIGH,
			|	ЗначенияИндексов.LOW КАК LOW,
			|	ЗначенияИндексов.VALUE КАК VALUE,
			|	ЗначенияИндексов.DURATION КАК DURATION,
			|	ЗначенияИндексов.YIELD КАК YIELD,
			|	ЗначенияИндексов.DECIMALS КАК DECIMALS,
			|	ЗначенияИндексов.CAPITALIZATION КАК CAPITALIZATION,
			|	ЗначенияИндексов.DIVISOR КАК DIVISOR
			|ПОМЕСТИТЬ _ЗначенияИндексов
			|ИЗ
			|	&ЗначенияИндексов КАК ЗначенияИндексов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗначенияБиржевыхИндексов.Период КАК Период,
			|	ЗначенияБиржевыхИндексов.Биржа КАК Биржа,
			|	ЗначенияБиржевыхИндексов.БиржевойИндекс КАК БиржевойИндекс,
			|	ЗначенияБиржевыхИндексов.Валюта КАК Валюта,
			|	ЗначенияБиржевыхИндексов.CLOSE КАК CLOSE,
			|	ЗначенияБиржевыхИндексов.OPEN КАК OPEN,
			|	ЗначенияБиржевыхИндексов.HIGH КАК HIGH,
			|	ЗначенияБиржевыхИндексов.LOW КАК LOW,
			|	ЗначенияБиржевыхИндексов.VALUE КАК VALUE,
			|	ЗначенияБиржевыхИндексов.DURATION КАК DURATION,
			|	ЗначенияБиржевыхИндексов.YIELD КАК YIELD,
			|	ЗначенияБиржевыхИндексов.DECIMALS КАК DECIMALS,
			|	ЗначенияБиржевыхИндексов.CAPITALIZATION КАК CAPITALIZATION,
			|	ЗначенияБиржевыхИндексов.DIVISOR КАК DIVISOR
			|ПОМЕСТИТЬ _РанееЗагруженныеЗначенияИндексов
			|ИЗ
			|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|ГДЕ
			|	ЗначенияБиржевыхИндексов.Период В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_ЗначенияИндексов.Период
			|			ИЗ
			|				_ЗначенияИндексов КАК _ЗначенияИндексов)
			|	И ЗначенияБиржевыхИндексов.Биржа = &Биржа
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_ЗначенияИндексов.Период, _РанееЗагруженныеЗначенияИндексов.Период) КАК Период,
			|	&Биржа КАК Биржа,
			|	ЕСТЬNULL(Индексы.Ссылка, _РанееЗагруженныеЗначенияИндексов.БиржевойИндекс) КАК БиржевойИндекс,
			|	_ЗначенияИндексов.Валюта КАК Валюта,
			|	_ЗначенияИндексов.CLOSE КАК CLOSE,
			|	_ЗначенияИндексов.OPEN КАК OPEN,
			|	_ЗначенияИндексов.HIGH КАК HIGH,
			|	_ЗначенияИндексов.LOW КАК LOW,
			|	_ЗначенияИндексов.VALUE КАК VALUE,
			|	_ЗначенияИндексов.DURATION КАК DURATION,
			|	_ЗначенияИндексов.YIELD КАК YIELD,
			|	_ЗначенияИндексов.DECIMALS КАК DECIMALS,
			|	_ЗначенияИндексов.CAPITALIZATION КАК CAPITALIZATION,
			|	_ЗначенияИндексов.DIVISOR КАК DIVISOR,
			|	_РанееЗагруженныеЗначенияИндексов.Валюта КАК ВалютаЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.CLOSE КАК CLOSEЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.OPEN КАК OPENЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.HIGH КАК HIGHЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.LOW КАК LOWЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.VALUE КАК VALUEЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.DURATION КАК DURATIONЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.YIELD КАК YIELDЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.DECIMALS КАК DECIMALSЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.CAPITALIZATION КАК CAPITALIZATIONЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.DIVISOR КАК DIVISORЗагруженныеРанее,
			|	_РанееЗагруженныеЗначенияИндексов.БиржевойИндекс ЕСТЬ NULL КАК Отсутствует
			|ИЗ
			|	_ЗначенияИндексов КАК _ЗначенияИндексов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК Индексы
			|		ПО _ЗначенияИндексов.SECID = Индексы.Код
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РанееЗагруженныеЗначенияИндексов КАК _РанееЗагруженныеЗначенияИндексов
			|		ПО (Индексы.Ссылка = _РанееЗагруженныеЗначенияИндексов.БиржевойИндекс)
			|			И _ЗначенияИндексов.Период = _РанееЗагруженныеЗначенияИндексов.Период
			|			И (_РанееЗагруженныеЗначенияИндексов.Биржа = &Биржа)
			|ГДЕ
			|	(_ЗначенияИндексов.Валюта <> _РанееЗагруженныеЗначенияИндексов.Валюта
			|			ИЛИ _ЗначенияИндексов.CLOSE <> _РанееЗагруженныеЗначенияИндексов.CLOSE
			|			ИЛИ _ЗначенияИндексов.OPEN <> _РанееЗагруженныеЗначенияИндексов.OPEN
			|			ИЛИ _ЗначенияИндексов.HIGH <> _РанееЗагруженныеЗначенияИндексов.HIGH
			|			ИЛИ _ЗначенияИндексов.LOW <> _РанееЗагруженныеЗначенияИндексов.LOW
			|			ИЛИ _ЗначенияИндексов.VALUE <> _РанееЗагруженныеЗначенияИндексов.VALUE
			|			ИЛИ _ЗначенияИндексов.DURATION <> _РанееЗагруженныеЗначенияИндексов.DURATION
			|			ИЛИ _ЗначенияИндексов.YIELD <> _РанееЗагруженныеЗначенияИндексов.YIELD
			|			ИЛИ _ЗначенияИндексов.DECIMALS <> _РанееЗагруженныеЗначенияИндексов.DECIMALS
			|			ИЛИ _ЗначенияИндексов.CAPITALIZATION <> _РанееЗагруженныеЗначенияИндексов.CAPITALIZATION
			|			ИЛИ _ЗначенияИндексов.DIVISOR <> _РанееЗагруженныеЗначенияИндексов.DIVISOR)
			|	И _ЗначенияИндексов.Период < &Период";
		
		Запрос.УстановитьПараметр("ЗначенияИндексов"   , ЗначенияИндексов);
		Запрос.УстановитьПараметр("Период"             , ДатаЗагрузки);
		Запрос.УстановитьПараметр("Биржа"              , БиржаИндексов);
		
		РезультатЗапросаЗначенийИндексовСРасхождениями = Запрос.Выполнить();
		
		Если РезультатЗапросаЗначенийИндексовСРасхождениями.Пустой() Тогда
			Возврат;
		Иначе	
			// готовим рассылку.
			РеквизитыОповещения = Новый Структура("Период, ТекстОповещения", ПредставлениеПериода(НачалоДня(ДатаЗагрузки), КонецДня(ДатаЗагрузки)), "");
			
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;""><span style=""font-size: 10pt;"">Обнаружены расхождения ранее загруженных индексов из ММВБ</span></p>";
			
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<table border=""1"" cellspacing=""0"" CELLPADDING=""1"" WIDTH=""80%"" bordercolor = ""#000000"">
			|<tr bgcolor=""#FFFFFF"">
			|<th rowspan=""4"" align=""center"" width=60><b>Период</b></th>
			|<th rowspan=""4"" align=""center"" width=100><b>Биржевой индекс</b></th>
			|<th colspan=""11"" align=""center""<b>Новые значения</b></th>
			|<th rowspan=""4"" align=""center"" width=40><b>Отсутствует</b></th>
			|</tr>
			|
			|<tr bgcolor=""#FFFFFF"">
			|<th align=""center"" width=60><b>Валюта</b></th>
			|<th align=""center"" width=60><b>CLOSE</b></th>
			|<th align=""center"" width=60><b>OPEN</b></th>
			|<th align=""center"" width=60><b>HIGH</b></th>
			|<th align=""center"" width=60><b>LOW</b></th>
			|<th align=""center"" width=60><b>VALUE</b></th>
			|<th align=""center"" width=60><b>DURATION</b></th>
			|<th align=""center"" width=60><b>YIELD</b></th>
			|<th align=""center"" width=60><b>DECIMALS</b></th>
			|<th align=""center"" width=60><b>CAPITALIZATION</b></th>
			|<th align=""center"" width=60><b>DIVISOR</b></th> 
			|</tr>
			|
			|<tr bgcolor=""#FFFFFF"">
            |<th colspan=""11"" align=""center""<b>Прошлые значения</b></th>
            |</tr>
			|
			|<tr bgcolor=""#FFFFFF"">
			|<th align=""center"" width=60><b>Валюта</b></th>
			|<th align=""center"" width=60><b>CLOSE</b></th>
			|<th align=""center"" width=60><b>OPEN</b></th>
			|<th align=""center"" width=60><b>HIGH</b></th>
			|<th align=""center"" width=60><b>LOW</b></th>
			|<th align=""center"" width=60><b>VALUE</b></th>
			|<th align=""center"" width=60><b>DURATION</b></th>
			|<th align=""center"" width=60><b>YIELD</b></th>
			|<th align=""center"" width=60><b>DECIMALS</b></th>
			|<th align=""center"" width=60><b>CAPITALIZATION</b></th>
			|<th align=""center"" width=60><b>DIVISOR</b></th>
			|
			|</tr>";
			
			ВыборкаЗапросаЗначенийИндексовСРасхождениями = РезультатЗапросаЗначенийИндексовСРасхождениями.Выбрать();
			
			Пока ВыборкаЗапросаЗначенийИндексовСРасхождениями.Следующий() Цикл
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<tr>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td rowspan=""2"" align = ""left"" valign = ""top"" nowrap  bgcolor=""#FFFFFF"">" + Формат(ВыборкаЗапросаЗначенийИндексовСРасхождениями.Период, "ДФ=dd.MM.yyyy") + "</td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td rowspan=""2"" align = ""left"" valign = ""top"" nowrap  bgcolor=""#FFFFFF"">" + ВыборкаЗапросаЗначенийИндексовСРасхождениями.БиржевойИндекс + "</td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""left"" valign = ""top"" nowrap" + ?(ВыборкаЗапросаЗначенийИндексовСРасхождениями.Валюта <> ВыборкаЗапросаЗначенийИндексовСРасхождениями.ВалютаЗагруженныеРанее, " bgcolor=""#FF0000""", "  bgcolor=""#FFFFFF""") + ">" + ВыборкаЗапросаЗначенийИндексовСРасхождениями.Валюта + "</td>";
				
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"" nowrap" + ?(ВыборкаЗапросаЗначенийИндексовСРасхождениями.CLOSE <> ВыборкаЗапросаЗначенийИндексовСРасхождениями.CLOSEЗагруженныеРанее, " bgcolor=""#FF0000""", "  bgcolor=""#FFFFFF""") + ">" + Формат(ВыборкаЗапросаЗначенийИндексовСРасхождениями.CLOSE, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"" nowrap" + ?(ВыборкаЗапросаЗначенийИндексовСРасхождениями.OPEN <> ВыборкаЗапросаЗначенийИндексовСРасхождениями.OPENЗагруженныеРанее, " bgcolor=""#FF0000""", "  bgcolor=""#FFFFFF""") + ">" + Формат(ВыборкаЗапросаЗначенийИндексовСРасхождениями.OPEN, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"" nowrap" + ?(ВыборкаЗапросаЗначенийИндексовСРасхождениями.HIGH <> ВыборкаЗапросаЗначенийИндексовСРасхождениями.HIGHЗагруженныеРанее, " bgcolor=""#FF0000""", "  bgcolor=""#FFFFFF""") + ">" + Формат(ВыборкаЗапросаЗначенийИндексовСРасхождениями.HIGH, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
