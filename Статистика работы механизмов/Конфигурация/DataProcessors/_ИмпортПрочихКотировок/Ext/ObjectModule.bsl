Процедура ЗагрузитьЗначенияИндексов(ТолькоОтсутствующие = Ложь) Экспорт
	
	СверитьЗначенияИндексовПередЗагрузкой();
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код,
		|	Валюты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Валюты КАК Валюты";
	
	Валюты = Запрос.Выполнить().Выгрузить();
	
	ДатаЗагрузки = КонецДня(ЭтотОбъект.Период.ДатаНачала) - 86400;
	
	Пока ДатаЗагрузки < ЭтотОбъект.Период.ДатаОкончания Цикл
		
		ДатаЗагрузки = ДатаЗагрузки + 86400;
		
		ЗначенияИндексов = ПолучитьСтруктуруТаблицыИндексов();
		
		ЕстьCSV = Истина;
				
		ИмяФайлаCSV = ИзвлечьФайлCSV(СкачатьФайл("iss.moex.com", ВернутьАдресРесурса("ЗначенияИндексов", ДатаЗагрузки)));
		
		Если ПустаяСтрока(ИмяФайлаCSV) Тогда
			ЗарегистрироватьОшибку("Не удалось загрузить файл индексов за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
			ЕстьCSV = Ложь;
			
		Иначе
			ФайлCSV = Новый ТекстовыйДокумент;
			ФайлCSV.Прочитать(ИмяФайлаCSV);
			
			Если ФайлCSV.КоличествоСтрок() <= 9 Тогда
				ЗарегистрироватьОшибку("Загружен пустой файл индексов за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
				ЕстьCSV = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьCSV Тогда
			БиржаИндексов = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
		
			Индексы = ПолучитьИндексы(БиржаИндексов);
			
			ЗаполнитьТаблицуЗначенияИндексовИзCSV(ДатаЗагрузки, ЗначенияИндексов, ФайлCSV, Индексы, Валюты, БиржаИндексов);
			
			ЗагрузитьЗначенияИндексовИзТаблицы(ЗначенияИндексов, ДатаЗагрузки, БиржаИндексов, ТолькоОтсутствующие);
			
			Если ЗначенияИндексов.Количество() = 0 Тогда
				ЗарегистрироватьОшибку("Значения индексов не были загружены, т.к. в файле MOEX отсутствуют значения индексов за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружены биржевые индексы за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Функция ПолучитьИндексы(БиржаИндексов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Индексы.Ссылка КАК Ссылка,
		|	Индексы.Код КАК Код
		|ИЗ
		|	Справочник.БиржевыеИндексы КАК Индексы
		|ГДЕ
		|	Индексы.Владелец = &Биржа";
	
	Запрос.УстановитьПараметр("Биржа", БиржаИндексов);
	
	// Преобразуем в верхний регистр
	Индексы = Запрос.Выполнить().Выгрузить();
	Для Каждого Индекс Из Индексы Цикл
		Индекс.Код = ВРег(Индекс.Код);		
	КонецЦикла;
	
	Возврат Индексы;
	
КонецФункции

Функция ПолучитьСтруктуруТаблицыИндексов()
	
	Возврат РегистрыСведений.ЗначенияБиржевыхИндексов.ПолучитьСтруктуруТаблицыИндексов();
	
КонецФункции // ПолучитьСтруктуруТаблицыИндексов

Процедура ЗаполнитьТаблицуЗначенияИндексовИзCSV(ДатаЗагрузки, ЗначенияИндексов, ФайлCSV, Индексы, Валюты = Неопределено, БиржаИндексов, РежимСверки = Ложь)
	
	ЗаголовокCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(3), ";");
	
	Для НомерСтроки = 4 По ФайлCSV.КоличествоСтрок() Цикл
		
		ДанныеCSV = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлCSV.ПолучитьСтроку(НомерСтроки), ";");
		
		Если Не РежимСверки И ДанныеCSV[2] <> Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy") Тогда Продолжить; КонецЕсли;
		
		ЗначенияИндекса = Новый Структура();
		
		Для Инд = 0 По ЗаголовокCSV.Количество() - 1 Цикл
			ИмяПоля = ЗаголовокCSV[Инд];
			
			Если ЗначенияИндексов.Колонки.Найти(ИмяПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИмяПоля = "SECID" Или ИмяПоля = "SHORTNAME" Или ИмяПоля = "CURRENCYID" Тогда
				ЗначенияИндекса.Вставить(ИмяПоля, СокрЛП(ДанныеCSV[Инд]));
			ИначеЕсли ИмяПоля = "TRADEDATE" Тогда
				ЗначенияИндекса.Вставить(ИмяПоля, РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(СокрЛП(ДанныеCSV[Инд])));
			ИначеЕсли ИмяПоля = "NAME"	Тогда
				Значение = СокрЛП(ДанныеCSV[Инд]);
				Если СокрЛП(нрег(Значение)) = "null" Тогда
					ЗначенияИндекса.Вставить(ИмяПоля, "");
				Иначе
					ЗначенияИндекса.Вставить(ИмяПоля, Значение);
				КонецЕсли;
			ИначеЕсли Не ПустаяСтрока(ДанныеCSV[Инд]) Тогда
				Попытка
					ЗначенияИндекса.Вставить(ИмяПоля, Число(СокрЛП(ДанныеCSV[Инд])));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		ОбработатьЗначенияИндекса(ЗначенияИндексов, ЗначенияИндекса, Индексы, Валюты, БиржаИндексов);
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьТаблицуЗначенияИндексовИзCSV

Функция ОбработатьЗначенияИндекса(ЗначенияИндексов, ЗначенияИндекса, Индексы, Валюты, БиржаИндексов)
	
	КодИндекса				= ЗначенияИндекса.SECID;
	НаименованиеИндекса		= ЗначенияИндекса.SHORTNAME; // BOARDNAME
	ПолнНаименованиеИндекса = ЗначенияИндекса.NAME; 
	КодВалюты 				= ЗначенияИндекса.CURRENCYID;
	
	Индекс = Индексы.Найти(ВРег(КодИндекса), "Код");
	Если Индекс = Неопределено Тогда
		Индекс = Индексы.Найти(КодИндекса, "Код");
	КонецЕсли;
	
	Если Индекс = Неопределено Тогда
		Индекс = Справочники.БиржевыеИндексы.СоздатьЭлемент();
		Индекс.Владелец             = БиржаИндексов;
		Индекс.Код					= КодИндекса;
		Индекс.Наименование			= НаименованиеИндекса;
		Индекс.НаименованиеПолное	= ПолнНаименованиеИндекса;
		Индекс.Записать();

		Индексы = ПолучитьИндексы(БиржаИндексов);
	КонецЕсли;
	
	Если КодВалюты = "SUR" ИЛИ КодВалюты = "RUR" Тогда
		Валюта = Валюты.Найти("RUB", "Наименование");	
	Иначе
		Валюта = Валюты.Найти(КодВалюты, "Наименование");
	КонецЕсли;
	
	Если Валюта = Неопределено Тогда 
		Валюта = Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	СтрокаДанных = ЗначенияИндексов.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаДанных, ЗначенияИндекса);
	
	СтрокаДанных.Индекс = Индекс.Ссылка;
	СтрокаДанных.Валюта = Валюта.Ссылка;
	
	Возврат Истина;
	
КонецФункции // ОбработатьЗначенияИндекса

Процедура ЗагрузитьЗначенияИндексовИзТаблицы(ЗначенияИндексов, ДатаЗагрузки, БиржаИндексов, ТолькоОтсутствующие = Ложь, ТолькоРасхождения = Ложь)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияИндексов.Период КАК Период,
		|	ЗначенияИндексов.Индекс КАК Индекс,
		|	ЗначенияИндексов.Валюта КАК Валюта,
		|	ЗначенияИндексов.SECID КАК SECID,
		|	ЗначенияИндексов.SHORTNAME КАК SHORTNAME,
		|	ЗначенияИндексов.NAME КАК NAME,
		|	ЗначенияИндексов.CURRENCYID КАК CURRENCYID,
		|	ЗначенияИндексов.CLOSE КАК CLOSE,
		|	ЗначенияИндексов.OPEN КАК OPEN,
		|	ЗначенияИндексов.HIGH КАК HIGH,
		|	ЗначенияИндексов.LOW КАК LOW,
		|	ЗначенияИндексов.VALUE КАК VALUE,
		|	ЗначенияИндексов.DURATION КАК DURATION,
		|	ЗначенияИндексов.YIELD КАК YIELD,
		|	ЗначенияИндексов.DECIMALS КАК DECIMALS,
		|	ЗначенияИндексов.CAPITALIZATION КАК CAPITALIZATION,
		|	ЗначенияИндексов.DIVISOR КАК DIVISOR
		|ПОМЕСТИТЬ _ЗначенияИндексов
		|ИЗ
		|	&ЗначенияИндексов КАК ЗначенияИндексов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияБиржевыхИндексов.Период КАК Период,
		|	ЗначенияБиржевыхИндексов.Биржа КАК Биржа,
		|	ЗначенияБиржевыхИндексов.БиржевойИндекс КАК БиржевойИндекс,
		|	ЗначенияБиржевыхИндексов.Валюта КАК Валюта,
		|	ЗначенияБиржевыхИндексов.CLOSE КАК CLOSE,
		|	ЗначенияБиржевыхИндексов.OPEN КАК OPEN,
		|	ЗначенияБиржевыхИндексов.HIGH КАК HIGH,
		|	ЗначенияБиржевыхИндексов.LOW КАК LOW,
		|	ЗначенияБиржевыхИндексов.VALUE КАК VALUE,
		|	ЗначенияБиржевыхИндексов.DURATION КАК DURATION,
		|	ЗначенияБиржевыхИндексов.YIELD КАК YIELD,
		|	ЗначенияБиржевыхИндексов.DECIMALS КАК DECIMALS,
		|	ЗначенияБиржевыхИндексов.CAPITALIZATION КАК CAPITALIZATION,
		|	ЗначенияБиржевыхИндексов.DIVISOR КАК DIVISOR
		|ПОМЕСТИТЬ _РанееЗагруженныеЗначенияИндексов
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|ГДЕ
		|	ЗначенияБиржевыхИндексов.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ЗначенияБиржевыхИндексов.Биржа = &Биржа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	&Биржа КАК Биржа,
		|	Индексы.Ссылка КАК БиржевойИндекс,
		|	_ЗначенияИндексов.Валюта КАК Валюта,
		|	_ЗначенияИндексов.CLOSE КАК CLOSE,
		|	_ЗначенияИндексов.OPEN КАК OPEN,
		|	_ЗначенияИндексов.HIGH КАК HIGH,
		|	_ЗначенияИндексов.LOW КАК LOW,
		|	_ЗначенияИндексов.VALUE КАК VALUE,
		|	_ЗначенияИндексов.DURATION КАК DURATION,
		|	_ЗначенияИндексов.YIELD КАК YIELD,
		|	_ЗначенияИндексов.DECIMALS КАК DECIMALS,
		|	_ЗначенияИндексов.CAPITALIZATION КАК CAPITALIZATION,
		|	_ЗначенияИндексов.DIVISOR КАК DIVISOR,
		|	_РанееЗагруженныеЗначенияИндексов.БиржевойИндекс ЕСТЬ NULL КАК Отсутствует
		|ИЗ
		|	_ЗначенияИндексов КАК _ЗначенияИндексов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БиржевыеИндексы КАК Индексы
		|		ПО _ЗначенияИндексов.SECID = Индексы.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РанееЗагруженныеЗначенияИндексов КАК _РанееЗагруженныеЗначенияИндексов
		|		ПО (Индексы.Ссылка = _РанееЗагруженныеЗначенияИндексов.БиржевойИндекс)
		|ГДЕ
		|	(_РанееЗагруженныеЗначенияИндексов.БиржевойИндекс ЕСТЬ NULL
		|			ИЛИ НЕ &ТолькоОтсутствующие)
		|	И (_ЗначенияИндексов.Валюта <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|			ИЛИ _ЗначенияИндексов.CLOSE <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.CLOSE, 0)
		|			ИЛИ _ЗначенияИндексов.OPEN <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.OPEN, 0)
		|			ИЛИ _ЗначенияИндексов.HIGH <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.HIGH, 0)
		|			ИЛИ _ЗначенияИндексов.LOW <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.LOW, 0)
		|			ИЛИ _ЗначенияИндексов.VALUE <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.VALUE, 0)
		|			ИЛИ _ЗначенияИндексов.DURATION <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.DURATION, 0)
		|			ИЛИ _ЗначенияИндексов.YIELD <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.YIELD, 0)
		|			ИЛИ _ЗначенияИндексов.DECIMALS <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.DECIMALS, 0)
		|			ИЛИ _ЗначенияИндексов.CAPITALIZATION <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.CAPITALIZATION, 0)
		|			ИЛИ _ЗначенияИндексов.DIVISOR <> ЕСТЬNULL(_РанееЗагруженныеЗначенияИндексов.DIVISOR, 0)
		|			ИЛИ НЕ &ТолькоРасхождения)";
		
	Запрос.УстановитьПараметр("ЗначенияИндексов"   , ЗначенияИндексов);
	Запрос.УстановитьПараметр("Период"             , ДатаЗагрузки);
	Запрос.УстановитьПараметр("Биржа"              , БиржаИндексов);
	Запрос.УстановитьПараметр("ТолькоОтсутствующие", ТолькоОтсутствующие);
	Запрос.УстановитьПараметр("ТолькоРасхождения"  , ТолькоРасхождения);
	
	ТаблицаЗначенийИндексовДляЗагрузки = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗначенийИндексовДляЗагрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Если Запрос.МенеджерВременныхТаблиц.Таблицы["_РанееЗагруженныеЗначенияИндексов"].ПолучитьДанные().Выбрать().Количество() = 0 Тогда 
	
		НаборЗначенияИндексов = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьНаборЗаписей();
		НаборЗначенияИндексов.Отбор.Период.Установить(ДатаЗагрузки);
		НаборЗначенияИндексов.Отбор.Биржа.Установить(БиржаИндексов);
		НаборЗначенияИндексов.Загрузить(ТаблицаЗначенийИндексовДляЗагрузки);
	    НаборЗначенияИндексов.Записать();
		
		Если ТолькоОтсутствующие Тогда
			Сообщить("Загружены значения биржевых индексов [" + ТаблицаЗначенийИндексовДляЗагрузки.Количество() + " шт.] за '" + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	Иначе
		
		Для Каждого СтрокаТаблицыЗначенийИндексов Из ТаблицаЗначенийИндексовДляЗагрузки Цикл
			
			НаборЗначенияИндексов = РегистрыСведений.ЗначенияБиржевыхИндексов.СоздатьНаборЗаписей();
			НаборЗначенияИндексов.Отбор.Период.Установить(ДатаЗагрузки);
			НаборЗначенияИндексов.Отбор.Биржа.Установить(БиржаИндексов);
			НаборЗначенияИндексов.Отбор.БиржевойИндекс.Установить(СтрокаТаблицыЗначенийИндексов.БиржевойИндекс);
			
			ЗаполнитьЗначенияСвойств(НаборЗначенияИндексов.Добавить(), СтрокаТаблицыЗначенийИндексов);
			
			НаборЗначенияИндексов.Записать();	
			
			Если ТолькоОтсутствующие Тогда
				Сообщить("Загружен биржевой индекс '" + СтрокаТаблицыЗначенийИндексов.БиржевойИндекс + "' за '" + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Получение_индексов_из_Матрикс

Процедура ЗагрузитьЗначенияИндексовИзМатрикс(ТолькоОтсутствующие = Ложь) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК Ссылка,
		|	Валюты.Код КАК Код,
		|	Валюты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Валюты КАК Валюты";
	
	Валюты = Запрос.Выполнить().Выгрузить();
	
	ДатаЗагрузки = КонецДня(ЭтотОбъект.Период.ДатаНачала) - 86400;
	
	Пока ДатаЗагрузки < ЭтотОбъект.Период.ДатаОкончания Цикл
		
		ДатаЗагрузки = ДатаЗагрузки + 86400;
		
		ЗначенияИндексов = ПолучитьСтруктуруТаблицыИндексов();

		БиржаИндексов = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_Cbonds");
		
		Индексы = ПолучитьИндексы(БиржаИндексов);
		ЗаполнитьТаблицуЗначенияИндексовИзМатрикс(ДатаЗагрузки, ЗначенияИндексов, Индексы, Валюты, БиржаИндексов);
		
		ЕстьДанныеМатрикс = (ЗначенияИндексов.Количество() <> 0);
		
		Если ЕстьДанныеМатрикс Тогда
			ЗагрузитьЗначенияИндексовИзТаблицы(ЗначенияИндексов, ДатаЗагрузки, БиржаИндексов, ТолькоОтсутствующие);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружены биржевые индексы из Матрикс за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЦикла;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуЗначенияИндексовИзМатрикс(ДатаЗагрузки, ЗначенияИндексов, Индексы, Валюты = Неопределено, БиржаИндексов)

	СтрокаСоединения = "Driver={SQL Server};Server=AP15.G1.LAN;UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=MatriX_External";
	
	ТекстЗапроса	= "
		|SELECT
		|	[CBONDS_index_value].[date] as [Период],
		|	REPLACE([CBONDS_index_type].name_eng, ' ','') as SECID,
		|	[CBONDS_index_type].name_eng as SHORTNAME,
		|	[CBONDS_index_type].name_rus as [NAME],
		|	CASE [CBONDS_index_type].[name_eng]
		//|		WHEN 'Euro-Cbonds IG Russia EUR'
		//|			THEN 'EUR'
		//|		WHEN 'Euro-Cbonds IG 3Y Russia'
		//|			THEN 'USD'
		//|		WHEN 'Euro-Cbonds IG Russia'
		//|			THEN 'USD'
		|		WHEN 'S&P 500'
		|			THEN 'USD'
		|		WHEN 'Gold (Bank of Russia)'
		|			THEN 'RUB'
		|		ELSE ''
		|	END as CURRENCYID,
		|	[CBONDS_index_value].[value] as [CLOSE],
		|	[CBONDS_index_value].[value] as [OPEN],
		|	[CBONDS_index_value].[value] as [HIGH],
		|	[CBONDS_index_value].[value] as [LOW]
		|FROM 
		|	[MatriX_External].[dbo].[CBONDS_index_value] AS [CBONDS_index_value]
		|LEFT JOIN [MatriX_External].[dbo].[CBONDS_index_type] AS [CBONDS_index_type] 
		|	ON [CBONDS_index_type].id =  [CBONDS_index_value].type_id
		|Where
		|	[CBONDS_index_type].[name_eng] IN ('S&P 500', 'Gold (Bank of Russia)') -- 'Euro-Cbonds IG Russia EUR', 'Euro-Cbonds IG 3Y Russia', 'Euro-Cbonds IG Russia', 
		|	and [date] = '&Период&'";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период&", Формат(ДатаЗагрузки, "ДФ=yyyyMMdd"));	
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период",		Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("SECID",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ТипыКолонок.Вставить("SHORTNAME",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("NAME", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТипыКолонок.Вставить("CURRENCYID",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	
	Для каждого РесурсМетаданных Из Метаданные.РегистрыСведений.ЗначенияБиржевыхИндексов.Ресурсы Цикл
		ТипыКолонок.Вставить(РесурсМетаданных.Имя, РесурсМетаданных.Тип);
	КонецЦикла;
	
	ЗагрузкаВРабочийДень = Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата());
	
	ТаблицаИндексов = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
		
	Если ТаблицаИндексов = Неопределено Тогда
		
		//#279665. Если в субботу и воскресенье нет котировок - ошибку не регистрируем,
		//т.к. чаще всего их действительно нет.
		Если ДеньНедели(ДатаЗагрузки) < 6 И ЗагрузкаВРабочийДень Тогда 
			ЗарегистрироватьОшибку("Не удалось загрузить индексы из Матрикс за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
#Область КонтрольКоличестваИндексов	
	//1. 'Euro-Cbonds IG Russia EUR - не рассчитывается как непопулярный
	//2. 'Euro-Cbonds IG 3Y Russia - не рассчитывается как непопулярный
	//3. 'Euro-Cbonds IG Russia' - Заменен на Cbonds Russia Corporate IG. В матрикс нет данных 
	//4. 'S&P 500'
	//5. 'Gold (Bank of Russia)'
	//1-3 грузятся по рабочим дням котировок
	//4 - по рабочим дням США
	//5 - в день следующий за рабочим днём по произв. календарю
	
	КоличествоИндексов = 0;
	
	//Если Справочники.Календари.ЭтоРабочийДень(Константы.ОсновнойКалендарьКотировок.Получить(), ДатаЗагрузки) Тогда
	//	КоличествоИндексов = КоличествоИндексов + 3;
	//КонецЕсли;
	
	Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ДатаЗагрузки - 60 * 60 * 24) Тогда
		КоличествоИндексов = КоличествоИндексов + 1;
	КонецЕсли;
	
	Если ТаблицаИндексов.Найти("S&P500", "SECID") = Неопределено Тогда
		Если НЕ КонтрольНаличияИндексаЗаПоследниеДни("S&P500", ДатаЗагрузки, 4) Тогда
			ЗарегистрироватьОшибку("Индекс S&P 500 на " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy") + " не загружался более 4-х дней");
		КонецЕсли;
	Иначе
		КоличествоИндексов = КоличествоИндексов + 1;
	КонецЕсли;

	Если ТаблицаИндексов.Количество() < КоличествоИндексов Тогда
		ЗарегистрироватьОшибку("При загрузке индексов из Матрикс за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy") + " получены не все индексы. Возможно один из индексов переименован.");
	КонецЕсли;
#КонецОбласти
	
	Для Каждого ЗначенияИндекса Из ТаблицаИндексов Цикл
		ОбработатьЗначенияИндекса(ЗначенияИндексов, ЗначенияИндекса, Индексы, Валюты, БиржаИндексов);
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрольНаличияИндексаЗаПоследниеДни(Код, Период, КоличествоДней)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код"				, Код);
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.УстановитьПараметр("КоличествоДней"	, КоличествоДней);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РАЗНОСТЬДАТ(ЗначенияБиржевыхИндексовСрезПоследних.Период, &Период, ДЕНЬ) КАК Период
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов.СрезПоследних(&Период, БиржевойИндекс.Код = &Код) КАК ЗначенияБиржевыхИндексовСрезПоследних
		|ГДЕ
		|	РАЗНОСТЬДАТ(ЗначенияБиржевыхИндексовСрезПоследних.Период, &Период, ДЕНЬ) < &КоличествоДней";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

