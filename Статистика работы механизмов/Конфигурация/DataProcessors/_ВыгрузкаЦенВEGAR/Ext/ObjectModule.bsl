// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Выгрузка цен в ЕГАР",
		"0.30",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВыгрузитьПредварительныеЦены", "Выгрузить предварительные цены",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//     элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ТекущаяДатаСеанса())) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды = "ВыгрузитьПредварительныеЦены" Тогда
	
		Сервер = ПолучитьИмяСервера();
		ЭтотОбъект.ДатаВыгрузки = ТекущаяДатаСеанса();
		ВыгрузитьПредварительныеЦены(Сервер, Истина);
	
	КонецЕсли; 
	
КонецПроцедуры 

// Интерфейс для запуска отложенного задания
//
// Параметры:
//  Команда			 - Строка - Идентификатор выполняемого метода
//  ПараметрыКоманды - Структура - Содержит параметры запуска метода
//
Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт

	Если Метод = "ВыгрузитьЦеныОценки" Тогда
		
		Сервер = ПолучитьИмяСервера();
		
		Экземпляры = ПолучитьЭкземпляры(Экземпляры);
		
		ВыборкаОрганизации = Экземпляры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// Устанавливаем соединение с ЕГАР
		Отладка = Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
		Если Не Отладка Тогда
		
			Соединение = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(Сервер);
			
			Если ТипЗнч(Соединение) = Тип("Строка") Тогда
				
				ОтправитьОповещение("Ошибка подключения к серверу EGAR", "Выгрузка цен оценки в EGAR не выполнена. Система сообщает:" + Символы.ПС + Соединение);
				Возврат;
				
			КонецЕсли; 	
		
		КонецЕсли; 		
	
		Пока ВыборкаОрганизации.Следующий() Цикл
			
			ВыборкаДаты = ВыборкаОрганизации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДаты.Следующий() Цикл
				
				ВыборкаСДУ = ВыборкаДаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаСДУ.Следующий() Цикл
					
					ПараметрыКоманды = Новый Структура("ВыполнятьПроверки, Организация, СчетДоверительногоУправления, Дата");
					ЗаполнитьЗначенияСвойств(ПараметрыКоманды, ВыборкаСДУ);
					
					ВыгрузитьЦеныОценки(ПараметрыКоманды, Истина, Соединение, Отладка);
					
					Выборка = ВыборкаСДУ.Выбрать();
					Пока Выборка.Следующий() Цикл
						// Фиксируем успешное выполнение задания.
						РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Выборка.Идентификатор);
					КонецЦикла;
				КонецЦикла;			
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли; 

КонецПроцедуры

Функция ПолучитьЭкземпляры(Экземпляры)

	КлючиЗапуска = Новый ТаблицаЗначений;
	
	КлючиЗапуска.Колонки.Добавить("Организация",					Новый ОписаниеТипов("СправочникСсылка.Организации"));
	КлючиЗапуска.Колонки.Добавить("Дата",							Новый ОписаниеТипов("Дата"));
	КлючиЗапуска.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",					Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	// Фиксируем запуск.
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Организация КАК Организация,
		|	КлючиЗапуска.Дата КАК Дата,
		|	КлючиЗапуска.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.Дата КАК Дата,
		|	_Экземпляры.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Экземпляры.Идентификатор КАК Идентификатор
		|ИЗ
		|	_Экземпляры КАК _Экземпляры
		|ИТОГИ ПО
		|	Организация,
		|	Дата,
		|	СчетДоверительногоУправления";
	
	Возврат Запрос.Выполнить();

КонецФункции

Процедура ВыгрузитьПредварительныеЦены(Сервер, ОтправлятьОповещения, ВыводитьОшибкиПользователю = Ложь, Ошибки = Неопределено) Экспорт

	Отладка = Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
	
	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Структура;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("Сервер, ОтправлятьОповещения, ВыводитьОшибкиПользователю, Отладка", Сервер, ОтправлятьОповещения, ВыводитьОшибкиПользователю, Отладка);
	Механизм = "_ВыгрузкаЦенВEGAR.ВыгрузитьПредварительныеЦены()";
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект,, ДопПараметры);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	#Область Проверки_перед_выполнением_расчета
	// проверяем загружаемые данные на предыдущий рабочий день, т.к. это подходит для большинства клиентов
	ПредыдущийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата())-1);
	СтрокаСообщений = "";
	
	СписокПроверкиКотировок = Новый Структура;
	СписокПроверкиКотировок.Вставить("КотировкиММВБ",			Истина);
	СписокПроверкиКотировок.Вставить("КотировкиБлумберг",		Истина);
	СписокПроверкиКотировок.Вставить("ИндексыММВБ",				Истина);
	СписокПроверкиКотировок.Вставить("ССРасчетныеНРД",			Истина);
	СписокПроверкиКотировок.Вставить("ПараметрыКривойБД",		Истина);
	СписокПроверкиКотировок.Вставить("РасчетныеЦеныRUData",		Истина);
	СписокПроверкиКотировок.Вставить("КурсыВалют",				Истина);
	СписокПроверкиКотировок.Вставить("КлиринговыеОтчетыСПФИ",	Ложь);
	
	Если Не РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(ПредыдущийРабочийДень, СписокПроверкиКотировок, СтрокаСообщений) Тогда
		
		ТекстСообщения = "Система сообщает:" + Символы.ПС + СтрокаСообщений;
		
		Если ОтправлятьОповещения Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Отсутствуют загружаемые данные" + Символы.ПС + ТекстСообщения, "Выгрузка цен в EGAR");
		КонецЕсли;
		
		Если ВыводитьОшибкиПользователю Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли; 
		
	КонецЕсли;
	
	// Устанавливаем соединение с ЕГАР
	Если Не Отладка Тогда
	
		Соединение = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(Сервер);
		
		Если ТипЗнч(Соединение) = Тип("Строка") Тогда
			
			ТекстСообщения = "Выгрузка предварительных цен в EGAR не выполнена. Система сообщает:" + Символы.ПС + Соединение;
			
			Если ОтправлятьОповещения Тогда
				ОтправитьОповещение("Ошибка подключения к серверу EGAR", ТекстСообщения);
			КонецЕсли;
		
			Если ВыводитьОшибкиПользователю Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
			КонецЕсли;	
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("ТекстСообщения", ТекстСообщения));
			Возврат;
			
		КонецЕсли; 	
	
	КонецЕсли;		
	#КонецОбласти 
	
	#Область Инициализация_служебных_таблиц
	ТаблицаПлановыхЦен = Неопределено;
	ТаблицаОшибокОценки = Неопределено;
	СтоимостиСобсвенныхПаев = Новый ТаблицаЗначений;
	СтоимостиСобсвенныхПаев.Колонки.Добавить("Пай", Новый ОписаниеТипов("СправочникСсылка.Паи"));
	СтоимостиСобсвенныхПаев.Колонки.Добавить("Стоимость", Метаданные.Документы.РегистрацияСтоимостиАктивов.Реквизиты.СтоимостьПая.Тип);
	
	ОшибкиФормирования = Новый ТаблицаЗначений;
	ОшибкиФормирования.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ОшибкиФормирования.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ОшибкиФормирования.Колонки.Добавить("ОписаниеОшибки", Новый ОписаниеТипов("Строка"));		
	#КонецОбласти 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаВыгрузки", 					ЭтотОбъект.ДатаВыгрузки);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("МассивОрганизаций", 				РаботаСВнешнимиСистемами.EGAR_ОрганизацииДляВыгрузки());
	Запрос.УстановитьПараметр("Стратегия",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Стратегия_Индивидуальная"));
	
	#Область Текст_запроса_по_счетам_ДУ
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаВыгрузки КАК Дата,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении) КАК ЦельРасчета,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокФормирования,
		|	Паи.Ссылка КАК Пай
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузки, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаВыгрузки, ) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО (СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = Паи.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ФинансовыеПоказатели.Организация = СчетаДоверительногоУправления.Организация
		|				И ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка
		|				И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|				И ФинансовыеПоказатели.Период = &ДатаВыгрузки)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация В(&МассивОрганизаций)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаВыгрузки
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузки
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И (СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия ЕСТЬ NULL
		|			ИЛИ СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = &Стратегия)
		|	И СчетаДоверительногоУправления.КодСчета <> ""О""
		|	И (&СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|			ИЛИ СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокФормирования,
		|	Организация,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";		
	#КонецОбласти 
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаСчетовДляПолученияСтоимостиИзРегистра = Новый ТаблицаЗначений;
	ТаблицаСчетовДляПолученияСтоимостиИзРегистра.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаСчетовДляПолученияСтоимостиИзРегистра.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаСчетовДляПолученияСтоимостиИзРегистра.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	
	Пока Выборка.Следующий() Цикл
		
		#Область Получение_настроек_и_проверка
		// определяем крайнюю дату формирования СЧА
		ДатаФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			Выборка.Организация, 
			Выборка.СчетДоверительногоУправления, 
			Выборка.Дата - 3600*24);
			
		Если Не ЗначениеЗаполнено(ДатаФормированияСЧА) Тогда
			
			ЗарегистрироватьОшибку(ОшибкиФормирования, Выборка, "Не заполнены настройки формирования СЧА");
			Продолжить;
		
		КонецЕсли; 
			
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ДатаФормированияСЧА, Выборка.Организация, Выборка.СчетДоверительногоУправления, Выборка.ЦельРасчета, Истина);
		
		Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Неопределено Тогда
		
			// здесь будут партии, как по ним выгружать мы не договорились
			ЗарегистрироватьОшибку(ОшибкиФормирования, Выборка, "Не заполнены настройки оценки");
			Продолжить;			
		
		КонецЕсли; 
								
		Если НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 И
			Не (Выборка.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_Траст")
				Или Выборка.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_РЭМ")) Тогда
		
			// здесь будут партии, как по ним выгружать мы не договорились
			ЗарегистрироватьОшибку(ОшибкиФормирования, Выборка, "Клиент использует расчет по указанию ЦБ 5419.");
			Продолжить;			
		
		КонецЕсли;
		
		// заполняем таблицу счетов для проверки наличия цен непосредственно перед выгрузкой
		НоваяСтрока = ТаблицаСчетовДляПолученияСтоимостиИзРегистра.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Организация, СчетДоверительногоУправления"); 
		НоваяСтрока.Период = ДатаФормированияСЧА;
					
		// проверим, может уже есть цены
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ФинансовыеПоказатели.Регистратор КАК Регистратор
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Период = &ДатаФормированияСЧА
			|	И ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
			|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)";
		
		Запрос.УстановитьПараметр("Организация", 					Выборка.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Выборка.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаФормированияСЧА", 			ДатаФормированияСЧА);
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			// получим эти цены, когда закончим с формированием остальных документов
			Продолжить;
		КонецЕсли; 
				
		#КонецОбласти
				
		#Область Заполнение_документа_РСА_РСП
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		
		СтоимостиПереоценки = Неопределено;
		Попытка			
			СтоимостиПереоценки = ПолучитьРасчетныеДанные(ДатаФормированияСЧА, Выборка, НастройкиОценки, СтоимостиСобсвенныхПаев, Отказ);
			Если Отказ Тогда
				ОписаниеОшибки = СтоимостиПереоценки;
			КонецЕсли; 
		Исключение
			
			Отказ = Истина;
			ОписаниеОшибки = ОписаниеОшибки();
			
			Задача = Задачи.ОшибкиРегламентыхЗаданий.СоздатьЗадачу();
			Задача.Дата = ТекущаяДатаСеанса();
			Задача.Наименование = "Ошибка выполнения";
			Задача.ТекстЗадачи = ОписаниеОшибки;
			Задача.Источник = "Выгрузка цен в ЕГАР";
			Задача.ГруппаПользователей = Справочники.ГруппыПользователей.ВсеПользователи;
			Задача.Пользователь = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущийПользователь");
			Задача.Записать();
			
		КонецПопытки; 
		
		ЦенаПредоставленаКлиентом = (НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом);
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ДатаЦены", 						ДатаФормированияСЧА);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Выборка.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Организация", 					Выборка.Организация);
		Запрос.УстановитьПараметр("ЦенаПредоставленаКлиентом", 		ЦенаПредоставленаКлиентом);
		Запрос.УстановитьПараметр("ПредыдущаяДатаРасчетаСЧА", 		РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			Выборка.Организация, 
			Выборка.СчетДоверительногоУправления, 
			ДатаФормированияСЧА - 3600*24));
			
		//Если Не РезультатРасчета.Свойство("СтомостьПая") И СтоимостиСобсвенныхПаев.Количество() > 0 Тогда
		// плохо
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СтоимостиСобсвенныхПаев.Пай КАК Пай,
			|	СтоимостиСобсвенныхПаев.Стоимость КАК Стоимость
			|ПОМЕСТИТЬ _СтоимостиСобсвенныхПаев
			|ИЗ
			|	&СтоимостиСобсвенныхПаев КАК СтоимостиСобсвенныхПаев";
		Запрос.УстановитьПараметр("СтоимостиСобсвенныхПаев", СтоимостиСобсвенныхПаев);
		Запрос.Выполнить();
		//	СтоимостиСобсвенныхПаев.Очистить();
		
		//КонецЕсли; 
		
		Если Отказ Тогда
			
			// сюда попали, если РСП упала или вышла с отказом. Получаем цены всех бумаг на более ранний день формирования СЧА
			ТекстОшибки = "";
			// добавляем сообщения об ошибках формирования в таблицу ошибок оценки
			Для каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
				ТекстОшибки = ТекстОшибки + Символы.ПС + Сообщение.Текст;
			КонецЦикла; 
			
			ОписаниеОшибки = "Не удалось сформировать документ регистрация стоимости переоценки. Система сообщает: " + ?(ЗначениеЗаполнено(ОписаниеОшибки), ОписаниеОшибки, ТекстОшибки);
			ЗарегистрироватьОшибку(ОшибкиФормирования, Выборка, ОписаниеОшибки);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтоимостьПереоценки.Рынок КАК Рынок,
				|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СтоимостьПереоценки.Количество КАК Количество,
				|	0 КАК Цена,
				|	0 КАК Сумма,
				|	0 КАК КурсВалютыНоминала,
				|	ЛОЖЬ КАК ДопустимаНулеваяЦена
				|ПОМЕСТИТЬ _СтоимостиПереоценкиПолная
				|ИЗ
				|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
				|ГДЕ
				|	СтоимостьПереоценки.Период = &ПредыдущаяДатаРасчетаСЧА
				|	И СтоимостьПереоценки.Организация = &Организация
				|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
				|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))";
				
			Запрос.Выполнить();
			
		Иначе
			
			// РСП сформирована успешно - загружаем цены в МВТ запроса
			//СтоимостиПереоценки = ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить(, "Рынок, ЦеннаяБумага, Количество, Цена, Сумма, ВидЦены, КурсВалютыНоминала");
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтоимостиПереоценки.Рынок КАК Рынок,
				|	СтоимостиПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СтоимостиПереоценки.Количество КАК Количество,
				|	СтоимостиПереоценки.Цена КАК Цена,
				|	СтоимостиПереоценки.Сумма КАК Сумма,
				|	СтоимостиПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
				|	СтоимостиПереоценки.ДопустимаНулеваяЦена КАК ДопустимаНулеваяЦена
				|ПОМЕСТИТЬ _СтоимостиПереоценкиПолная
				|ИЗ
				|	&СтоимостиПереоценки КАК СтоимостиПереоценки";
				
			Запрос.УстановитьПараметр("СтоимостиПереоценки", СтоимостиПереоценки);
			Запрос.Выполнить();
				
		КонецЕсли;
		
		#КонецОбласти  
		
		#Область Текст_запроса_получение_цен
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СтоимостиПереоценкиПолная.Рынок КАК Рынок,
			|	_СтоимостиПереоценкиПолная.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_СтоимостиПереоценкиПолная.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА НЕ _СтоимостиСобсвенныхПаев.Стоимость ЕСТЬ NULL
			|				И СРЕДНЕЕ(_СтоимостиПереоценкиПолная.Сумма) = 0
			|			ТОГДА _СтоимостиСобсвенныхПаев.Стоимость
			|		ИНАЧЕ ВЫБОР
			|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СтоимостиПереоценкиПолная.Цена) > 1
			|					ТОГДА СУММА(_СтоимостиПереоценкиПолная.Сумма) / СУММА(_СтоимостиПереоценкиПолная.Количество)
			|				ИНАЧЕ СРЕДНЕЕ(_СтоимостиПереоценкиПолная.Цена)
			|			КОНЕЦ
			|	КОНЕЦ КАК Цена,
			|	_СтоимостиПереоценкиПолная.ДопустимаНулеваяЦена КАК ДопустимаНулеваяЦена
			|ПОМЕСТИТЬ _СредневзвешенныеЦены
			|ИЗ
			|	_СтоимостиПереоценкиПолная КАК _СтоимостиПереоценкиПолная
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СтоимостиСобсвенныхПаев КАК _СтоимостиСобсвенныхПаев
			|		ПО (_СтоимостиПереоценкиПолная.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
			|			И _СтоимостиПереоценкиПолная.ЦеннаяБумага = _СтоимостиСобсвенныхПаев.Пай
			|ГДЕ
			|	_СтоимостиПереоценкиПолная.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|
			|СГРУППИРОВАТЬ ПО
			|	_СтоимостиПереоценкиПолная.Рынок,
			|	_СтоимостиПереоценкиПолная.ЦеннаяБумага,
			|	_СтоимостиПереоценкиПолная.КурсВалютыНоминала,
			|	_СтоимостиПереоценкиПолная.ДопустимаНулеваяЦена,
			|	_СтоимостиСобсвенныхПаев.Стоимость
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СредневзвешенныеЦены.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_СредневзвешенныеЦены.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА _СредневзвешенныеЦены.Цена
			|		ИНАЧЕ ВЫБОР
			|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтоимостьПереоценки.Цена) > 1
			|					ТОГДА СУММА(СтоимостьПереоценки.Сумма) / СУММА(СтоимостьПереоценки.Количество)
			|				ИНАЧЕ СРЕДНЕЕ(СтоимостьПереоценки.Цена)
			|			КОНЕЦ
			|	КОНЕЦ КАК Цена,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА &ДатаЦены
			|		ИНАЧЕ &ПредыдущаяДатаРасчетаСЧА
			|	КОНЕЦ КАК ДатаЦены,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА ""inter""
			|		ИНАЧЕ ""T-2""
			|	КОНЕЦ КАК ТипЦены,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА _СредневзвешенныеЦены.ДопустимаНулеваяЦена
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ДопустимаНулеваяЦена
			|ПОМЕСТИТЬ _ПредварительныеЦены
			|ИЗ
			|	_СредневзвешенныеЦены КАК _СредневзвешенныеЦены
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ПО (СтоимостьПереоценки.Период = &ПредыдущаяДатаРасчетаСЧА)
			|			И (СтоимостьПереоценки.Организация = &Организация)
			|			И (СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)))
			|			И (СтоимостьПереоценки.Рынок = _СредневзвешенныеЦены.Рынок)
			|			И (СтоимостьПереоценки.ЦеннаяБумага = _СредневзвешенныеЦены.ЦеннаяБумага)
			|			И (_СредневзвешенныеЦены.Цена = 0)
			|			И (НЕ _СредневзвешенныеЦены.ДопустимаНулеваяЦена)
			|
			|СГРУППИРОВАТЬ ПО
			|	_СредневзвешенныеЦены.ЦеннаяБумага,
			|	_СредневзвешенныеЦены.КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА _СредневзвешенныеЦены.ДопустимаНулеваяЦена
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ,
			|	СтоимостьПереоценки.ЦеннаяБумага,
			|	_СредневзвешенныеЦены.Цена
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПредварительныеЦены.ЦеннаяБумага КАК ЦеннаяБумага,
			|	&Организация КАК Организация,
			|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА _ПредварительныеЦены.Цена = 0
			|				И НЕ _ПредварительныеЦены.ДопустимаНулеваяЦена
			|			ТОГДА ""Цена не определена""
			|		ИНАЧЕ ""Цена Т-2""
			|	КОНЕЦ КАК ОписаниеОшибки
			|ПОМЕСТИТЬ _ОшибкиОценки
			|ИЗ
			|	_ПредварительныеЦены КАК _ПредварительныеЦены
			|ГДЕ
			|	(_ПредварительныеЦены.Цена = 0
			|				И НЕ _ПредварительныеЦены.ДопустимаНулеваяЦена
			|			ИЛИ _ПредварительныеЦены.ДатаЦены = &ПредыдущаяДатаРасчетаСЧА
			|				И НЕ &ЦенаПредоставленаКлиентом)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПредварительныеЦены.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ПредварительныеЦены.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.Акции
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.Векселя
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.Облигации
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.Паи
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
			|		КОГДА _ПредварительныеЦены.ЦеннаяБумага ССЫЛКА Справочник.Доли
			|			ТОГДА ВЫРАЗИТЬ(_ПредварительныеЦены.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
			|	КОНЕЦ КАК ВалютаНоминала,
			|	ВЫБОР
			|		КОГДА _ПредварительныеЦены.Цена = 0
			|				И НЕ _ПредварительныеЦены.ДопустимаНулеваяЦена
			|			ТОГДА НЕОПРЕДЕЛЕНО
			|		ИНАЧЕ _ПредварительныеЦены.Цена
			|	КОНЕЦ КАК Цена,
			|	_ПредварительныеЦены.ДатаЦены КАК ДатаЦены,
			|	_ПредварительныеЦены.ТипЦены КАК ТипЦены,
			|	_ПредварительныеЦены.ДопустимаНулеваяЦена КАК ДопустимаНулеваяЦена,
			|	&Организация КАК Организация,
			|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	_ПредварительныеЦены КАК _ПредварительныеЦены";
		#КонецОбласти 
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если ТаблицаПлановыхЦен = Неопределено Тогда
			ТаблицаПлановыхЦен = РезультатЗапроса.Выгрузить();
		Иначе
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатЗапроса.Выгрузить(), ТаблицаПлановыхЦен);
		КонецЕсли; 
		
		ОшибкиОценки = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ОшибкиОценки").ПолучитьДанные();
		Если Не ОшибкиОценки.Пустой() Тогда
			Если ТаблицаОшибокОценки = Неопределено Тогда
				ТаблицаОшибокОценки = ОшибкиОценки.Выгрузить();
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ОшибкиОценки.Выгрузить(), ТаблицаОшибокОценки);
			КонецЕсли; 
		КонецЕсли;
			
	КонецЦикла;
	
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	Если ТаблицаСчетовДляПолученияСтоимостиИзРегистра.Количество() > 0 Тогда
	
		#Область Текст_запроса_Получение_цен_из_регистра
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаСчетов.Период КАК Период,
			|	ТаблицаСчетов.Организация КАК Организация,
			|	ТаблицаСчетов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ТаблицаСчетов
			|ИЗ
			|	&ТаблицаСчетов КАК ТаблицаСчетов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Доли
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
			|	КОНЕЦ КАК ВалютаНоминала,
			|	ВЫБОР
			|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтоимостьПереоценки.Цена) > 1
			|			ТОГДА СУММА(СтоимостьПереоценки.Сумма) / СУММА(СтоимостьПереоценки.Количество)
			|		ИНАЧЕ СРЕДНЕЕ(СтоимостьПереоценки.Цена)
			|	КОНЕЦ КАК Цена,
			|	_ТаблицаСчетов.Период КАК ДатаЦены,
			|	""T-1"" КАК ТипЦены,
			|	СтоимостьПереоценки.Организация КАК Организация,
			|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ТаблицаОкончательныхЦен
			|ИЗ
			|	_ТаблицаСчетов КАК _ТаблицаСчетов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ПО _ТаблицаСчетов.Период = СтоимостьПереоценки.Период
			|			И _ТаблицаСчетов.Организация = СтоимостьПереоценки.Организация
			|			И _ТаблицаСчетов.СчетДоверительногоУправления = СтоимостьПереоценки.СчетДоверительногоУправления
			|ГДЕ
			|	СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРАсчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРАсчета.КонтрольИнвестиционнойДекларации))
			|	И СтоимостьПереоценки.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|
			|СГРУППИРОВАТЬ ПО
			|	СтоимостьПереоценки.ЦеннаяБумага,
			|	СтоимостьПереоценки.КурсВалютыНоминала,
			|	ВЫБОР
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
			|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Доли
			|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
			|	КОНЕЦ,
			|	_ТаблицаСчетов.Период,
			|	СтоимостьПереоценки.Организация,
			|	СтоимостьПереоценки.СчетДоверительногоУправления";				
		#КонецОбласти 
		Запрос.УстановитьПараметр("ТаблицаСчетов", ТаблицаСчетовДляПолученияСтоимостиИзРегистра);
		Запрос.Выполнить();
		
	КонецЕсли; 
	
	Если Не (ТаблицаПлановыхЦен = Неопределено И Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаОкончательныхЦен") = Неопределено) Тогда
		
		#Область Помещаем_ТаблицаПлановыхЦен_в_МВТ
		Запрос.УстановитьПараметр("ТаблицаПлановыхЦен", ТаблицаПлановыхЦен);
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаПлановыхЦен.Организация КАК Организация,
			|	ТаблицаПлановыхЦен.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ТаблицаПлановыхЦен.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаПлановыхЦен.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	ТаблицаПлановыхЦен.ВалютаНоминала КАК ВалютаНоминала,
			|	ТаблицаПлановыхЦен.Цена КАК Цена,
			|	ТаблицаПлановыхЦен.ДатаЦены КАК ДатаЦены,
			|	ТаблицаПлановыхЦен.ТипЦены КАК ТипЦены
			|ПОМЕСТИТЬ _ТаблицаПлановыхЦен
			|ИЗ
			|	&ТаблицаПлановыхЦен КАК ТаблицаПлановыхЦен
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаПлановыхЦен.Организация КАК Организация,
			|	_ТаблицаПлановыхЦен.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ТаблицаПлановыхЦен.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ТаблицаПлановыхЦен.КурсВалютыНоминала КАК КурсВалютыНоминала,
			|	_ТаблицаПлановыхЦен.ВалютаНоминала КАК ВалютаНоминала,
			|	_ТаблицаПлановыхЦен.Цена КАК Цена,
			|	_ТаблицаПлановыхЦен.ДатаЦены КАК ДатаЦены,
			|	_ТаблицаПлановыхЦен.ТипЦены КАК ТипЦены
			|ПОМЕСТИТЬ _ЦеныВВалюте
			|ИЗ
			|	_ТаблицаПлановыхЦен КАК _ТаблицаПлановыхЦен
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаОкончательныхЦен КАК _ТаблицаОкончательныхЦен
			|		ПО _ТаблицаПлановыхЦен.Организация = _ТаблицаОкончательныхЦен.Организация
			|			И _ТаблицаПлановыхЦен.СчетДоверительногоУправления = _ТаблицаОкончательныхЦен.СчетДоверительногоУправления
			|ГДЕ
			|	_ТаблицаОкончательныхЦен.Организация ЕСТЬ NULL
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ТаблицаОкончательныхЦен.Организация,
			|	_ТаблицаОкончательныхЦен.СчетДоверительногоУправления,
			|	_ТаблицаОкончательныхЦен.ЦеннаяБумага,
			|	_ТаблицаОкончательныхЦен.КурсВалютыНоминала,
			|	_ТаблицаОкончательныхЦен.ВалютаНоминала,
			|	_ТаблицаОкончательныхЦен.Цена,
			|	_ТаблицаОкончательныхЦен.ДатаЦены,
			|	_ТаблицаОкончательныхЦен.ТипЦены
			|ИЗ
			|	_ТаблицаОкончательныхЦен КАК _ТаблицаОкончательныхЦен
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ТаблицаОкончательныхЦен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ТаблицаСчетов";
			
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);

		Если ТаблицаПлановыхЦен = Неопределено Тогда
			СхемаЗапроса.ПакетЗапросов.Удалить(0);
			СхемаЗапроса.ПакетЗапросов[0].Операторы.Удалить(0);
		КонецЕсли;

		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаОкончательныхЦен") = Неопределено Тогда
			СхемаЗапроса.ПакетЗапросов.Удалить(3);
			СхемаЗапроса.ПакетЗапросов.Удалить(2);
			СхемаЗапроса.ПакетЗапросов.Удалить(1);
			СхемаЗапроса.ПакетЗапросов[0].ТаблицаДляПомещения = "_ЦеныВВалюте";
		КонецЕсли;

		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		Запрос.Выполнить();			
		#КонецОбласти 
		
	КонецЕсли; 
	
	ПодготовитьИВыгрузитьДанные(Запрос, Соединение, Отладка, Ошибки);

	#Область Оповещения_об_ошибках
	
	Если Ошибки.Свойство("ОшибкаПодключения") Тогда
		// формируем задачу
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Ошибка выгрузки предварительных цен в ЕГАР. Система сообщает: " + Символы.ПС + Ошибки.ОшибкаПодключения, 
			РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ВыгрузкаЦенВEGAR"));
	Иначе
		
		ОтсутствуютОшибкиРасчетаПредварительныхЦен = Истина;
		
		Если ОшибкиФормирования.Количество() > 0 Тогда
			
			Ошибки.Вставить("ОшибкиФормирования", СформироватьТабличныйДокументОшибок(ОшибкиФормирования));
			
			Если ОтправлятьОповещения Тогда
				ОтправитьОповещение("Ошибки формирования документов", Ошибки.ОшибкиФормирования);
			КонецЕсли;
			
			ОтсутствуютОшибкиРасчетаПредварительныхЦен = Ложь;
		
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ТаблицаОшибокОценки) И ТаблицаОшибокОценки.Количество() > 0 Тогда
		
			Ошибки.Вставить("ТаблицаОшибокОценки", СформироватьТабличныйДокументОшибок(ТаблицаОшибокОценки));
			
			Если ОтправлятьОповещения Тогда
				ОтправитьОповещение("Ошибки оценки", Ошибки.ТаблицаОшибокОценки);
			КонецЕсли;
			
			ОтсутствуютОшибкиРасчетаПредварительныхЦен = Ложь;
		
		КонецЕсли;
		
		Если ОтсутствуютОшибкиРасчетаПредварительныхЦен И ОтправлятьОповещения Тогда
			
			Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
				Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "Организация"); 
				ТекстОповещения = СтрШаблон("Выгрузка по клиенту %1 (%2) успешно завершена", ЭтотОбъект.СчетДоверительногоУправления, Организация);
			Иначе
				ТекстОповещения = "Выгрузка успешно завершена";
			КонецЕсли; 
			
			ОтправитьОповещение("", ТекстОповещения + ". Ошибок расчета предварительных цен не обнаружено");
		
		КонецЕсли; 
		
	КонецЕсли; 
	
	#КонецОбласти
	
	УстановитьПривилегированныйРежим(Ложь);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("ОшибкаПодключения, ОтсутствуютОшибкиРасчетаПредварительныхЦен", Ошибки.Свойство("ОшибкаПодключения"), ОтсутствуютОшибкиРасчетаПредварительныхЦен));
	
КонецПроцедуры

Процедура ВыгрузитьЦеныОценки(ПараметрыКоманды, ОтправлятьОповещения, Соединение, Отладка, ВыводитьОшибкиПользователю = Ложь) Экспорт
	
	ДопПараметры = Новый Структура("ОтправлятьОповещения, Отладка, ВыводитьОшибкиПользователю", ОтправлятьОповещения, Отладка, ВыводитьОшибкиПользователю);
	Механизм = "_ВыгрузкаЦенВEGAR.ВыгрузитьЦеныОценки()";
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыКоманды, "Дата, Организация, СчетДоверительногоУправления, ВыполнятьПроверки", ДопПараметры);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", 						НачалоДня(ПараметрыКоманды.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ПараметрыКоманды.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 					ПараметрыКоманды.Организация);
		
	Если ПараметрыКоманды.Свойство("ВыполнятьПроверки") Тогда
		
		ДатаФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			ПараметрыКоманды.Организация, 
			ПараметрыКоманды.СчетДоверительногоУправления, 
			НачалоДня(ТекущаяДатаСеанса())-1);
				
		Если НачалоДня(ПараметрыКоманды.Дата) > НачалоДня(ДатаФормированияСЧА) Тогда
			
			// изменили документ с датой больше даты последнего СЧА. Это нестандартная ситуация - сообщаем
			ТемаСообщения = "Изменен документ с датой больше даты последнего СЧА";
			ТекстСообщения = "Организация: " + ПараметрыКоманды.Организация + Символы.ПС + 
				"Счет доверительного управления: " + ПараметрыКоманды.СчетДоверительногоУправления + Символы.ПС + 
				"Дата документа: " + Формат(ПараметрыКоманды.Дата, "ДФ=dd.MM.yyyy");
				
			Если ОтправлятьОповещения Тогда
				ОтправитьОповещение(ТемаСообщения, ТекстСообщения);
			КонецЕсли;
		
			Если ВыводитьОшибкиПользователю Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
			КонецЕсли;	
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("ТекстСообщения", ТекстСообщения));
			Возврат;
			
		ИначеЕсли НачалоДня(ПараметрыКоманды.Дата) < НачалоДня(ДатаФормированияСЧА) Тогда 
			// изменили документ в прошлом - ничего не делаем, выходим
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("ТекстСообщения", "Выгрузка цен не производилась. Дата формирования СЧА [" + ДатаФормированияСЧА + "]."));
			Возврат;
		КонецЕсли;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегистрацияСтоимостиПереоценки.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РегистрацияСтоимостиПереоценки КАК РегистрацияСтоимостиПереоценки
			|ГДЕ
			|	РегистрацияСтоимостиПереоценки.Проведен
			|	И НАЧАЛОПЕРИОДА(РегистрацияСтоимостиПереоценки.Дата, ДЕНЬ) = &Период
			|	И РегистрацияСтоимостиПереоценки.Организация = &Организация
			|	И РегистрацияСтоимостиПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И РегистрацияСтоимостиПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	КорректировкаРегистров.Ссылка
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
			|		ПО СтоимостьПереоценки.Регистратор = КорректировкаРегистров.Ссылка
			|			И (СтоимостьПереоценки.Активность)
			|			И (СтоимостьПереоценки.Организация = &Организация)
			|			И (СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (СтоимостьПереоценки.Период = &Период)
			|			И (СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации)))";
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			// это отмена проведения - сообщаем
			ТемаСообщения = "Удален документ оценки";
			ТекстСообщения = "Организация: " + ПараметрыКоманды.Организация + Символы.ПС + 
				"Счет доверительного управления: " + ПараметрыКоманды.СчетДоверительногоУправления + Символы.ПС + 
				"Дата документа: " + Формат(ПараметрыКоманды.Дата, "ДФ=dd.MM.yyyy");
				
			Если ОтправлятьОповещения Тогда
				ОтправитьОповещение(ТемаСообщения, ТекстСообщения);
			КонецЕсли;
		
			Если ВыводитьОшибкиПользователю Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
			КонецЕсли;	
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("ТекстСообщения", ТекстСообщения));
			Возврат;
			
		КонецЕсли;		
	
	КонецЕсли; 
	
	// получение данных из регистра
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	// вставить нормальные даты расчета СЧА
	#Область Текст_запроса_получения_цен
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала,
		|	ВЫБОР
		|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтоимостьПереоценки.Цена) > 1
		|			ТОГДА СУММА(СтоимостьПереоценки.Сумма) / СУММА(СтоимостьПереоценки.Количество)
		|		ИНАЧЕ СРЕДНЕЕ(СтоимостьПереоценки.Цена)
		|	КОНЕЦ КАК Цена,
		|	&Период КАК ДатаЦены,
		|	""T-1"" КАК ТипЦены,
		|	СтоимостьПереоценки.Организация КАК Организация,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ЦеныВВалюте
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.Период = &Период
		|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРАсчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРАсчета.КонтрольИнвестиционнойДекларации))
		|	И СтоимостьПереоценки.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.КурсВалютыНоминала,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Доли).ВалютаНоминала
		|	КОНЕЦ,
		|	СтоимостьПереоценки.Организация,
		|	СтоимостьПереоценки.СчетДоверительногоУправления";		
	#КонецОбласти 
	
	Запрос.Выполнить();
	
	Ошибки = Новый Структура;
	ПодготовитьИВыгрузитьДанные(Запрос, Соединение, Отладка, Ошибки);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

Процедура ВыгрузитьЦеныОценкиПоСписку(Сервер, СписокДокументов, ОтправлятьОповещения) Экспорт
	
	// Устанавливаем соединение с ЕГАР
	Отладка = Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
	
	Если Не Отладка Тогда
	
		Соединение = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(Сервер);
		
		Если ТипЗнч(Соединение) = Тип("Строка") Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка предварительных цен в EGAR не выполнена. Система сообщает:" + Символы.ПС + Соединение);
			Возврат;
			
		КонецЕсли; 	
	
	КонецЕсли; 		
	
	Для каждого Документ Из СписокДокументов Цикл
	
		ПараметрыКоманды = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Организация, СчетДоверительногоУправления, Дата");
		ВыгрузитьЦеныОценки(ПараметрыКоманды, ОтправлятьОповещения, Соединение, Отладка, Истина);
	
	КонецЦикла; 
	
КонецПроцедуры
	
