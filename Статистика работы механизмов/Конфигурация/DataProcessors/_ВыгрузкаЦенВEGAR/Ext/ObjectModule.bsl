Функция СформироватьТабличныйДокументОшибок(ТаблицаОшибок)

	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаОшибок, , , , Истина);    
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	Возврат ПараметрыВывода.ДокументРезультат;

КонецФункции
 
Процедура ОтправитьОповещение(Тема, Содержимое)

	Если ТипЗнч(Содержимое) = Тип("ТабличныйДокумент") Тогда
	
		ИмяФайла = ПолучитьИмяВременногоФайла("htm");
		Содержимое.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяФайла);
		
		УдалитьФайлы(ИмяФайла);
		
	ИначеЕсли ТипЗнч(Содержимое) = Тип("Строка") Тогда 
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.ДобавитьСтроку(Содержимое);
	
	КонецЕсли; 
	
	ТемаПисьма = ?(Тема = "", Тема, ": " + Тема);
	
	РеквизитыОповещения = Новый Структура("Тема, Текст", ТемаПисьма, ТелоПисьма.ПолучитьТекст());
	Справочники.Оповещения.СформироватьОповещения("Обработка._ВыгрузкаЦенВEGAR", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры 

Процедура ЗарегистрироватьОшибку(ТаблицаОшибок, ДанныеЗаполнения, ОписаниеОшибки)

	НоваяСтрока = ТаблицаОшибок.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения);
	НоваяСтрока.ОписаниеОшибки = ОписаниеОшибки;

КонецПроцедуры

Функция ЭтоРабочийИлиТорговыйДень(Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Календарь КАК Календарь
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата = &Дата
		|	И ДанныеКалендаря.Календарь В (&КалендарьКотировок, ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))";
	
	Запрос.УстановитьПараметр("Дата", 				Дата);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
	
КонецФункции
 
#КонецОбласти 

#Область Получение_предварительных_данных

Функция ПолучитьРасчетныеДанные(ДатаФормированияСЧА, Выборка, НастройкиОценки, СтоимостиСобсвенныхПаев, Отказ)

	Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
	
		Отказ = Истина;
		Возврат "Вариант расчета справедливой стоимости '" + НастройкиОценки.ВариантРасчетаОценочнойСтоимости + "' не реализован.";
	
	КонецЕсли; 
	
	ПараметрыРасчета = Новый Структура("Организация, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ЦельРасчета");
	ЗаполнитьЗначенияСвойств(ПараметрыРасчета, Выборка);
	ПараметрыРасчета.Вставить("ВидУчета", 							НастройкиОценки.ВидУчетаДляОстатковПартий);
	ПараметрыРасчета.Вставить("Дата",								КонецДня(ДатаФормированияСЧА));
	ПараметрыРасчета.Вставить("Период",								НачалоДня(ДатаФормированияСЧА));
	ПараметрыРасчета.Вставить("ВалютаУчета",						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Организация, "ВалютаУчета"));
	ПараметрыРасчета.Вставить("ВалютаРубли",						ПараметрыРасчета.ВалютаУчета);
	ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", 	НастройкиОценки.ВариантРасчетаОценочнойСтоимости); 
	ПараметрыРасчета.Вставить("АдресТаблицыСтоимостей", 			Неопределено);
	ПараметрыРасчета.Вставить("ВидУчета", 							НастройкиОценки.ВидУчетаДляОстатковПартий);
	
	ПараметрыРасчета.Вставить("КонтрольСЧА");
		
	// очищаем накопленные сообщения
	ПолучитьСообщенияПользователю(Истина);
	
	Если Выборка.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		
		РезультатРасчета = СформироватьРСА(Выборка, ПараметрыРасчета, Отказ);
		Если Не Отказ Тогда
		
			НоваяСтрока = СтоимостиСобсвенныхПаев.Добавить();
			НоваяСтрока.Пай = Выборка.Пай;
			НоваяСтрока.Стоимость = РезультатРасчета.СтоимостьПая;				
		
		КонецЕсли; 

	Иначе
		
		РезультатРасчета = СформироватьРСП(Выборка, ПараметрыРасчета, Отказ);
		
	КонецЕсли; 
	
	Если Не Отказ Тогда
		
		Колонки = "Рынок, ЦеннаяБумага, Количество, Цена, Сумма, КурсВалютыНоминала, ВидЦены";
		
		Если РезультатРасчета.СтоимостиПереоценки <> Неопределено Тогда
			СтоимостиПереоценки = РезультатРасчета.СтоимостиПереоценки.Скопировать(, Колонки);
		КонецЕсли; 
		
		Если РезультатРасчета.СтоимостиПрочихЦенныхБумаг <> Неопределено Тогда
			Если СтоимостиПереоценки = Неопределено Тогда
				СтоимостиПереоценки = РезультатРасчета.СтоимостиПрочихЦенныхБумаг.Скопировать(, Колонки);
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатРасчета.СтоимостиПрочихЦенныхБумаг, СтоимостиПереоценки);
			КонецЕсли; 
		КонецЕсли;
		
		СтоимостиПереоценки.Колонки.Добавить("ДопустимаНулеваяЦена", Новый ОписаниеТипов("Булево"));
		СтрокиСНулевойЦеной = СтоимостиПереоценки.НайтиСтроки(Новый Структура("Цена", 0));
		Для Каждого СтрокаСНулевойЦеной Из СтрокиСНулевойЦеной Цикл
			СтрокаСНулевойЦеной.ДопустимаНулеваяЦена = Документы.РегистрацияСтоимостиПереоценки.ДопустимаНулеваяЦена(СтрокаСНулевойЦеной);
		КонецЦикла;
		
		Возврат СтоимостиПереоценки;
		
	ИначеЕсли ТипЗнч(РезультатРасчета) = Тип("Структура") И РезультатРасчета.Свойство("ОписаниеОшибки") Тогда
		
		Возврат РезультатРасчета.ОписаниеОшибки;
		
	КонецЕсли;

КонецФункции

Функция СформироватьРСА(Выборка, ПараметрыРасчета, Отказ)

	РегистрацияСтоимостиАктивов = Документы.РегистрацияСтоимостиАктивов.СоздатьДокумент();				
	РегистрацияСтоимостиАктивов.Дата                         	= КонецДня(ПараметрыРасчета.Дата);
	РегистрацияСтоимостиАктивов.Организация                  	= Выборка.Организация;
	РегистрацияСтоимостиАктивов.Ответственный                	= РаботаСПользователями.ТекущийПользователь();
	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления 	= Выборка.СчетДоверительногоУправления;
	РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки 		= ПараметрыРасчета.ЦельРасчета;				

	Попытка
	
		РегистрацияСтоимостиАктивов.ЗаполнитьДокументыРегистрацииСтоимости(ПараметрыРасчета, Ложь, Отказ);
		
		РезультатРасчета = Новый Структура;
		РезультатРасчета.Вставить("СтоимостьПая", 				РегистрацияСтоимостиАктивов.СтоимостьПая);
		РезультатРасчета.Вставить("СтоимостиПереоценки", 		РегистрацияСтоимостиАктивов.ДополнительныеСвойства.РегистрацияСтоимости.СтоимостиПереоценки.Выгрузить());
		РезультатРасчета.Вставить("СтоимостиПрочихЦенныхБумаг", РегистрацияСтоимостиАктивов.ДополнительныеСвойства.РегистрацияСтоимости.СтоимостиПрочихЦенныхБумаг.Выгрузить());
	
	Исключение
		Отказ = Истина;
		РезультатРасчета = Новый Структура("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат РезультатРасчета;

КонецФункции

Функция СформироватьРСП(Выборка, ПараметрыРасчета, Отказ)

	ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ПереоценкаЦБ, Выборка);
	ПереоценкаЦБ.Дата = ПараметрыРасчета.Дата;
	ПереоценкаЦБ.ВидУчета = ПараметрыРасчета.ВидУчета;
	
	Попытка
		РезультатРасчета = ПереоценкаЦБ.ПолучитьСтоимостиПереоценкиДляОценкиОбъектовВУправлении(Неопределено, Отказ);
	Исключение
		
		Отказ = Истина;
		
		ТекстОшибки = "";
		// добавляем сообщения об ошибках формирования в таблицу ошибок оценки
		Для каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			ТекстОшибки = ТекстОшибки + Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		
		ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + ОписаниеОшибки();
		
		РезультатРасчета = Новый Структура("ОписаниеОшибки", ТекстОшибки);
		
	КонецПопытки; 
	
	Возврат РезультатРасчета;

КонецФункции

#КонецОбласти

#Область Выгрузка_в_ЕГАР

Процедура ПодготовитьИВыгрузитьДанные(Запрос, Соединение, Отладка, Ошибки)

	// пересчет по курсам и номиналам текущего дня
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВложенныйЗапрос.ДатаЦены КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА Облигации.ДатаПогашения <= &ТекущаяДата
		|			ТОГДА 0
		|		ИНАЧЕ НоминалыЦенныхБумагСрезПоследних.Номинал / НоминалыЦенныхБумаг.Номинал
		|	КОНЕЦ КАК Коэффициент
		|ПОМЕСТИТЬ _Номиналы
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЦеныВВалюте.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ЦеныВВалюте.ДатаЦены КАК ДатаЦены,
		|		МАКСИМУМ(НоминалыЦенныхБумагНаДатуЦены.Период) КАК ПериодНоминалаНаДатуЦены
		|	ИЗ
		|		_ЦеныВВалюте КАК _ЦеныВВалюте
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумагНаДатуЦены
		|			ПО _ЦеныВВалюте.ЦеннаяБумага = НоминалыЦенныхБумагНаДатуЦены.ЦеннаяБумага
		|				И _ЦеныВВалюте.ДатаЦены >= НоминалыЦенныхБумагНаДатуЦены.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ЦеныВВалюте.ЦеннаяБумага,
		|		_ЦеныВВалюте.ДатаЦены) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|		ПО ВложенныйЗапрос.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
		|			И ВложенныйЗапрос.ПериодНоминалаНаДатуЦены = НоминалыЦенныхБумаг.Период
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО ВложенныйЗапрос.ЦеннаяБумага = Облигации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ТекущаяДата, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ВложенныйЗапрос.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦеныВВалюте.Организация КАК Организация,
		|	_ЦеныВВалюте.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦеныВВалюте.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ЦеныВВалюте.Цена = НЕОПРЕДЕЛЕНО
		|			ТОГДА _ЦеныВВалюте.Цена
		|		ИНАЧЕ (ВЫРАЗИТЬ(_ЦеныВВалюте.Цена КАК ЧИСЛО)) * ЕСТЬNULL(_Номиналы.Коэффициент, 1) * ВЫБОР
		|				КОГДА _ЦеныВВалюте.КурсВалютыНоминала = 0
		|					ТОГДА _КурсыВалют.Курс / _КурсыВалют.Кратность
		|				ИНАЧЕ _ЦеныВВалюте.КурсВалютыНоминала
		|			КОНЕЦ
		|	КОНЕЦ КАК Цена,
		|	_ЦеныВВалюте.ТипЦены КАК ТипЦены
		|ПОМЕСТИТЬ _ЦеныНаТекущийДень
		|ИЗ
		|	_ЦеныВВалюте КАК _ЦеныВВалюте
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК _КурсыВалют
		|		ПО _ЦеныВВалюте.ВалютаНоминала = _КурсыВалют.Валюта
		|			И (_КурсыВалют.Период = &ТекущаяДата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Номиналы КАК _Номиналы
		|		ПО _ЦеныВВалюте.ЦеннаяБумага = _Номиналы.ЦеннаяБумага
		|			И _ЦеныВВалюте.ДатаЦены = _Номиналы.ДатаЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦеныНаТекущийДень.Организация КАК Организация,
		|	_ЦеныНаТекущийДень.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦеныНаТекущийДень.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код + ""#"" + КодыВоВнешнихСистемахСрезПоследних.Код, НЕОПРЕДЕЛЕНО) КАК externalId,
		|	_ЦеныНаТекущийДень.Цена КАК accPrice,
		|	_ЦеныНаТекущийДень.ТипЦены КАК priceType
		|ИЗ
		|	_ЦеныНаТекущийДень КАК _ЦеныНаТекущийДень
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&ТекущаяДата, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|			ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|		ПО _ЦеныНаТекущийДень.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И (КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ОсновнойБрокер)
		|			И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения <= &ТекущаяДата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(&ТекущаяДата, ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _ЦеныНаТекущийДень.ЦеннаяБумага = КодыВоВнешнихСистемахСрезПоследних.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	СчетДоверительногоУправления,
		|	ЦеннаяБумага
		|ИТОГИ
		|	МИНИМУМ(Организация)
		|ПО
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";		
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	ВыборкаСчетДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Отладка Тогда
	
		ВТ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЦеныНаТекущийДень");
		Результат = ВТ.ПолучитьДанные().Выгрузить();
		
		Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор 		= Новый УникальныйИдентификатор;
		Запись.НеУдалять 			= Ложь;
		Запись.Источник 			= "РасчетПредварительныхЦен";
		Запись.Комментарий 			= ТекущаяДата();
		Запись.ХранилищеЗначения 	= Новый ХранилищеЗначения(Результат, Новый СжатиеДанных(9));
		Запись.Записать();
		
		Сообщить(Запись.Идентификатор);
		
		Возврат;		
	
	КонецЕсли; 
	
	ДанныеДляВыгрузки = Новый Массив;
	
	Пока ВыборкаСчетДУ.Следующий() Цикл
	
		Выборка = ВыборкаСчетДУ.Выбрать();
		
		ДанныеПоСчету = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			ДанныеПоСчету.Добавить(ПолучитьСтруктуруСтроки(Выборка));
		
		КонецЦикла;
		
		Попытка
		
			ДанныеДляВыгрузки.Добавить(ПолучитьСтрокуJSON(ДанныеПоСчету));
		
		Исключение
			
			ТекстОшибки = СтрШаблон("Не удалось выгрузить предварительные цены по клиенту %1 (%2)", ВыборкаСчетДУ.СчетДоверительногоУправления, ВыборкаСчетДУ.Организация);
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ВыгрузкаЦенВEGAR"));
			
		КонецПопытки;		
		
	КонецЦикла;
	
	// выгрузка
	ВыгрузитьДанные(ДанныеДляВыгрузки, Соединение, Ошибки);
	
КонецПроцедуры

Функция ПолучитьСтруктуруСтроки(Выборка)

	СтруктураПолей = Новый Структура("externalId, accPrice, priceType");
	ЗаполнитьЗначенияСвойств(СтруктураПолей, Выборка);
			
	Возврат СтруктураПолей

КонецФункции
 
Функция ПолучитьСтрокуJSON(ДанныеПоСчету)

	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, ДанныеПоСчету);
	Возврат ЗаписьJSON.Закрыть();				

КонецФункции

Процедура ВыгрузитьДанные(ДанныеДляВыгрузки, Соединение, Ошибки)

	Для каждого СтрокаJSON Из ДанныеДляВыгрузки Цикл
	
		ЗапросHTTP = Новый HTTPЗапрос(Соединение.AccountingPrices, Соединение.ЗаголовкиHTTP);
		ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		ЗапросВыполненУспешно = Ложь;
		ОписаниеОшибки = "";
		
		Для НомерПопытки = 1 По 3 Цикл
			
			Попытка
				
				ОтветHTTP = Соединение.СоединениеHTTP.Записать(ЗапросHTTP);
				Если ОтветHTTP.КодСостояния = 200 Тогда
					ЗапросВыполненУспешно = Истина;
					Прервать;
				Иначе
					ОписаниеОшибки = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
					ЗапуститьПриложение("Timeout /T 5 /NoBreak", , Истина);
				КонецЕсли;
				
			Исключение
				
				Если НомерПопытки < 3 Тогда
					ЗапуститьПриложение("Timeout /T 5 /NoBreak", , Истина);
				КонецЕсли; 
				ОписаниеОшибки = ОписаниеОшибки();
				
			КонецПопытки;
			
		КонецЦикла;
		
		Если Не ЗапросВыполненУспешно Тогда
			Ошибки.Вставить("ОшибкаПодключения", ОписаниеОшибки);
			Прервать;
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти 

