
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеЭтотОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаЭтотОбъектаМетаданного>.[*|<ИмяЭтотОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Облигации, не имеющие активного рынка",
		"1.14",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповеститьОбОблигацияхНеИмеющихАктивногоРынкаЗаВчерашнийДень", "Оповестить об облигациях, не имеющих активного рынка за вчерашний день",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповеститьОбОблигацияхНеИмеющихАктивногоРынкаЗаВчерашнийДень1", "Оповестить об облигациях, не имеющих активного рынка за вчерашний день",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповеститьОбОблигацияхНеИмеющихАктивногоРынкаЗаВчерашнийДень2", "Оповестить об облигациях, не имеющих активного рынка за вчерашний день",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
	Попытка
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.Организация                         = ПараметрыКоманды.Организация;
	ЭтотОбъект.Период                              = ТекущаяДата() - 86400;
	ЭтотОбъект.ГлубинаПериодаПроверки              = ПараметрыКоманды.ГлубинаПериодаПроверки;
	ЭтотОбъект.МинимальноеКоличествоСделокЗаПериод = ПараметрыКоманды.МинЧислоСделокЗаПериод;
	ЭтотОбъект.МинимальнаяСуммаСделокЗаПериод      = ПараметрыКоманды.МинСуммаСделокЗаПериод;
	ЭтотОбъект.МинимальноеКоличествоКотировокЗаПериодНаВнебирже = ПараметрыКоманды.МинЧислоКотировокЗаПериод;
	ЭтотОбъект.ПолучателиОповещения                = ПараметрыКоманды.ПолучателиОповещения;
	ЭтотОбъект.ПериодПроверкиВТорговыхДнях         = Ложь;
	ЭтотОбъект.ВключатьВОтчетТолькоОблигации	   = Ложь;	
	
	Если ПараметрыКоманды.Свойство("ПифыСОтборомПоОрганизации") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК КлиентДоверительногоУправления
				|ИЗ
				|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаПроверки, ) КАК КлиентыДоверительногоУправленияСрезПоследних
				|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
				|ГДЕ
				|	(СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
				|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))
				|	И (СчетаДоверительногоУправления.ДатаРасторжения > &ДатаПроверки
				|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
				|	И СчетаДоверительногоУправления.Организация = &Организация";
			
			Запрос.УстановитьПараметр("ДатаПроверки", ЭтотОбъект.Период);
			Запрос.УстановитьПараметр("Организация"	, ЭтотОбъект.Организация);
			
			ЭтотОбъект.КлиентыДоверительногоУправления.Загрузить(Запрос.Выполнить().Выгрузить());

	Иначе
		НоваяСтрокаКлиентыДоверительногоУправления = ЭтотОбъект.КлиентыДоверительногоУправления.Добавить();
		НоваяСтрокаКлиентыДоверительногоУправления.КлиентДоверительногоУправления = ПараметрыКоманды.КлиентДУ;
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста",
		ЭтотОбъект.ПолучателиОповещения,
		"Облигации, не имеющие активного рынка на " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"),
		СформироватьОтчетОЦенныхБумагахНеИмеющихАктивногоРынка(),
		"HTML");

	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры // ВыполнитьКоманду


Функция СформироватьОтчетОЦенныхБумагахНеИмеющихАктивногоРынка() Экспорт
	
	Если ЭтотОбъект.ПериодПроверкиВТорговыхДнях Тогда
		
		НачалоПериодаПроверки = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтотОбъект.Период, - 90);
		
		// в какой-то момент народ стукнуло, что считать нужно не календарные, а торговые дни;
		// торговые дни, типа, есть на бирже, но создавать календарь под это дело всем было
		// лень - решили, что можно будет проверить торговые дни по наличию котировок
		//Запрос = Новый Запрос;
		//Запрос.Текст =
		//	"ВЫБРАТЬ ПЕРВЫЕ 90
		//	|	КотировкиТорговыхПлощадок.Период КАК Период
		//	|ПОМЕСТИТЬ _РазличныеПериодыНаГлубинуПроверки
		//	|ИЗ
		//	|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		//	|ГДЕ
		//	|	КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		//	|	И КотировкиТорговыхПлощадок.Период <= &Период
		//	|
		//	|СГРУППИРОВАТЬ ПО
		//	|	КотировкиТорговыхПлощадок.Период
		//	|
		//	|УПОРЯДОЧИТЬ ПО
		//	|	Период УБЫВ
		//	|;
		//	|
		//	|////////////////////////////////////////////////////////////////////////////////
		//	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		//	|	_РазличныеПериодыНаГлубинуПроверки.Период
		//	|ИЗ
		//	|	_РазличныеПериодыНаГлубинуПроверки КАК _РазличныеПериодыНаГлубинуПроверки
		//	|
		//	|УПОРЯДОЧИТЬ ПО
		//	|	_РазличныеПериодыНаГлубинуПроверки.Период";
		//	
		//Запрос.Текст = СтрЗаменить(Запрос.Текст, "90", Формат(ЭтотОбъект.ГлубинаПериодаПроверки, "ЧГ="));
		//
		//Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
		//
		//Выборка = Запрос.Выполнить().Выбрать();
		//
		//Если Выборка.Следующий() Тогда
		//	НачалоПериодаПроверки = Выборка.Период;
		//Иначе
		//	НачалоПериодаПроверки = ЭтотОбъект.Период - ЭтотОбъект.ГлубинаПериодаПроверки * 86400;
		//КонецЕсли;	
		
	Иначе
		
		НачалоПериодаПроверки = ЭтотОбъект.Период - ЭтотОбъект.ГлубинаПериодаПроверки * 86400;
		
	КонецЕсли;
		
	// а вот и сами "пассивные" бумажки	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Клиент В (&КлиентыДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
		|ПОМЕСТИТЬ _ОстаткиЦенныхБумаг
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Рынок В (&Рынок)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления)) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.Период, ОценкиСтоимостиЦенныхБумагСрезПоследних.Период) КАК Период,
		|	ВЫРАЗИТЬ(КотировкиТорговыхПлощадок.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.NUMTRADES, 0) КАК КоличествоСделокЗаПериод,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.VALUE, 0) * ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.Валюта = &Рубли
		|			ТОГДА 1
		|		КОГДА КурсыВалют.Кратность <> 0
		|			ТОГДА ЕСТЬNULL(КурсыВалют.Курс / КурсыВалют.Кратность, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаСделокЗаПериод,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.BID, 0) КАК Bid,
		|	ЕСТЬNULL(КотировкиТорговыхПлощадок.CLOSE, 0) КАК CLOSE,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.BID ЕСТЬ NULL 
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК КоличествоBid,
		|	ВЫБОР
		|		КОГДА КотировкиТорговыхПлощадок.CLOSE ЕСТЬ NULL 
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК КоличествоCLOSE,
		|	НЕ ОценкиСтоимостиЦенныхБумагСрезПоследних.Стоимость ЕСТЬ NULL  КАК ЕстьКотировокаОценщика,
		|	ЕСТЬNULL(ОценкиСтоимостиЦенныхБумагСрезПоследних.Стоимость, 0) КАК КотировкаОценщика
		|ИЗ
		|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО КотировкиТорговыхПлощадок.Валюта = КурсыВалют.Валюта
		|				И КотировкиТорговыхПлощадок.Период = КурсыВалют.Период
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ОстаткиЦенныхБумаг.ЦеннаяБумага)
		|			И (КотировкиТорговыхПлощадок.Период МЕЖДУ &НачалоПериодаПроверки И &Период)
		|			И (КотировкиТорговыхПлощадок.Рынок В (&Рынок))
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим
		|				ИЛИ КотировкиТорговыхПлощадок.Биржа = &Bloomberg)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиЦенныхБумаг.СрезПоследних КАК ОценкиСтоимостиЦенныхБумагСрезПоследних
		|		ПО _ОстаткиЦенныхБумаг.СчетДоверительногоУправления = ОценкиСтоимостиЦенныхБумагСрезПоследних.СчетДоверительногоУправления
		|			И _ОстаткиЦенныхБумаг.ЦеннаяБумага = ОценкиСтоимостиЦенныхБумагСрезПоследних.ЦеннаяБумага
		|			И (КОНЕЦПЕРИОДА(ОценкиСтоимостиЦенныхБумагСрезПоследних.ДатаОкончанияДействия, ДЕНЬ) >= &Период)
		|ИТОГИ
		|	СУММА(КоличествоСделокЗаПериод),
		|	СУММА(СуммаСделокЗаПериод),
		|	СУММА(КоличествоBid),
		|	СУММА(КоличествоCLOSE),
		|	МАКСИМУМ(ЕстьКотировокаОценщика)
		|ПО
		|	СчетДоверительногоУправления,
		|	ЦеннаяБумага";		
		
	_КлиентыДоверительногоУправления = Новый Массив;
		
	Для каждого СтрокаКлиентДоверительногоУправления Из ЭтотОбъект.КлиентыДоверительногоУправления Цикл
		_КлиентыДоверительногоУправления.Добавить(СтрокаКлиентДоверительногоУправления.КлиентДоверительногоУправления);
	КонецЦикла;	
		
	МассивРынков = Новый Массив;
	МассивРынков.Добавить(Перечисления.РынкиЦенныхБумаг.Облигации);
	Если Не ЭтотОбъект.ВключатьВОтчетТолькоОблигации Тогда
		МассивРынков.Добавить(Перечисления.РынкиЦенныхБумаг.Акции);
		МассивРынков.Добавить(Перечисления.РынкиЦенныхБумаг.Паи);
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Период",								ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("НачалоПериодаПроверки",				НачалоПериодаПроверки);
	Запрос.УстановитьПараметр("КлиентыДоверительногоУправления",	_КлиентыДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Рынок",								МассивРынков);
	Запрос.УстановитьПараметр("Рубли",								ЭтотОбъект.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("Bloomberg",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	
	КотировкиЦенныхБумагHTML = "";
	НеактивыеЦенныхБумагHTML = "";
	
	ОбработанныеЦенныеБумаги = Новый Массив; // нужно их фиксировать, т.к. между разными клиентами списки будут пересекаться 
	
	ВыборкаСчетаДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСчетаДУ.Следующий() Цикл
		
		ВыборкаЦБ = ВыборкаСчетаДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЦБ.Следующий() Цикл
			
			Если (ВыборкаЦБ.КоличествоСделокЗаПериод < ЭтотОбъект.МинимальноеКоличествоСделокЗаПериод
				Или ВыборкаЦБ.СуммаСделокЗаПериод < ЭтотОбъект.МинимальнаяСуммаСделокЗаПериод)
				И ВыборкаЦБ.КоличествоBid < ЭтотОбъект.МинимальноеКоличествоКотировокЗаПериодНаВнебирже 
				И ВыборкаЦБ.КоличествоCLOSE < ЭтотОбъект.МинимальноеКоличествоКотировокЗаПериодНаВнебирже 
				И НЕ ВыборкаЦБ.ЕстьКотировокаОценщика
			Тогда
				Если ПустаяСтрока(НеактивыеЦенныхБумагHTML) Тогда
					НеактивыеЦенныхБумагHTML = НеактивыеЦенныхБумагHTML + "
						|<tr class=""DU"">
						|	<td colspan=""6"">" + СокрЛП(ВыборкаЦБ.СчетДоверительногоУправления) + "</td>
						|</tr>";
				КонецЕсли;
					
				НеактивыеЦенныхБумагHTML = НеактивыеЦенныхБумагHTML + "	
						|<tr>
						|	<td>" + ВыборкаЦБ.ЦеннаяБумага + "</td>
						|	<td id=""numbers"">" + ВыборкаЦБ.КоличествоСделокЗаПериод + "</td>
						|	<td id=""numbers"">" + ВыборкаЦБ.СуммаСделокЗаПериод + "</td>
						|	<td id=""numbers"">" + ВыборкаЦБ.КоличествоBid + "</td>
						|	<td id=""numbers"">" + ВыборкаЦБ.КоличествоCLOSE + "</td>
						|	<td id=""numbers"">" + Формат(ВыборкаЦБ.ЕстьКотировокаОценщика, "БЛ=нет; БИ=есть") + "</td>
						|</tr>";
				
				Если ПустаяСтрока(КотировкиЦенныхБумагHTML) Тогда
					КотировкиЦенныхБумагHTML = КотировкиЦенныхБумагHTML + "
						|<br>
						|<h3>Котировки</h3>
						|<table>
						|<tr class=""caption"">
						|	<td>Период</td>
						|	<td>NUMTRADES</td>
						|	<td>VALUE</td>
						|	<td>bid</td>
						|	<td>last price</td>
						|	<td>кот.оценщика</td>
						|</tr>";
				КонецЕсли;
				
				КотировкиЦенныхБумагHTML = КотировкиЦенныхБумагHTML + "
					|<tr class=""DU"">
					|	<td colspan=""6"">" + СокрЛП(ВыборкаЦБ.ЦеннаяБумага) + "</td>
					|</tr>";
						
				Выборка = ВыборкаЦБ.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					КотировкиЦенныхБумагHTML = КотировкиЦенныхБумагHTML + "
						|<tr>
						|	<td>" + Формат(Выборка.Период, "ДФ=dd.MM.yyyy") + "</td>
						|	<td id=""numbers"">" + Выборка.КоличествоСделокЗаПериод + "</td>
						|	<td id=""numbers"">" + Выборка.СуммаСделокЗаПериод + "</td>
						|	<td id=""numbers"">" + Выборка.Bid + "</td>
						|	<td id=""numbers"">" + Выборка.CLOSE + "</td>
						|	<td id=""numbers"">" + Выборка.КотировкаОценщика + "</td>
						|</tr>";
				КонецЦикла;
					
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Не ПустаяСтрока(КотировкиЦенныхБумагHTML) Тогда
		КотировкиЦенныхБумагHTML = КотировкиЦенныхБумагHTML + "
			|</table>";
	КонецЕсли;
	
	// сформируем письмо
	ОтчетHTML =
		"<html>
		|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style>
		|		body {
		|			font: 12pt sans-serif;
