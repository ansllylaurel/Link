&НаСервере
Функция ПолучитьСписокПараметровНаСервере()
	
	Если НЕ (ЗначениеЗаполнено(ЭтаФорма.СчетДонор) И ЗначениеЗаполнено(ЭтаФорма.СчетРеципиент)) Тогда
		Возврат Неопределено;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст =                 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Донор.ВестиБухгалтерскийУчет
		|		И ЕСТЬNULL(Реципиент.ВестиБухгалтерскийУчет, ИСТИНА) КАК ВестиБухгалтерскийУчет,
		|	Донор.ВестиЕдиныйБухгалтерскийУчет
		|		И ЕСТЬNULL(Реципиент.ВестиЕдиныйБухгалтерскийУчет, ИСТИНА) КАК ВестиЕдиныйБухгалтерскийУчет,
		|	Донор.ВестиНалоговыйУчет
		|		И ЕСТЬNULL(Реципиент.ВестиНалоговыйУчет, ИСТИНА) КАК ВестиНалоговыйУчет,
		|	КлиентыДоверительногоУправленияДонор.Клиент КАК КлиентДонор,
		|	КлиентыДоверительногоУправленияРеципиент.Клиент КАК КлиентРеципиент
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) КАК ВестиБухгалтерскийУчет,
		|		ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет, ЛОЖЬ) КАК ВестиЕдиныйБухгалтерскийУчет,
		|		ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ЛОЖЬ) КАК ВестиНалоговыйУчет
		|	ИЗ
		|		РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&ДатаВзятия, СчетДоверительногоУправления = &СчетДонор) КАК НастройкиУчетаОбщиеСрезПоследних) КАК Донор
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) КАК ВестиБухгалтерскийУчет,
		|			ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет, ЛОЖЬ) КАК ВестиЕдиныйБухгалтерскийУчет,
		|			ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ЛОЖЬ) КАК ВестиНалоговыйУчет
		|		ИЗ
		|			РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&ДатаУстановки, СчетДоверительногоУправления = &СчетРеципиент) КАК НастройкиУчетаОбщиеСрезПоследних) КАК Реципиент
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВзятия, СчетДоверительногоУправления = &СчетДонор) КАК КлиентыДоверительногоУправленияДонор
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаУстановки, СчетДоверительногоУправления = &СчетРеципиент) КАК КлиентыДоверительногоУправленияРеципиент
		|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("ДатаВзятия", ЭтаФорма.ДатаВзятия);
	Запрос.УстановитьПараметр("СчетДонор", ЭтаФорма.СчетДонор);
	Запрос.УстановитьПараметр("ДатаУстановки", ЭтаФорма.ДатаУстановки);
	Запрос.УстановитьПараметр("СчетРеципиент", ЭтаФорма.СчетРеципиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		
		СписокПараметров = Новый Структура;
		СписокПараметров.Вставить("ВестиБухгалтерскийУчет", Выборка.ВестиБухгалтерскийУчет);
		СписокПараметров.Вставить("ВестиЕдиныйБухгалтерскийУчет", Выборка.ВестиЕдиныйБухгалтерскийУчет);
		СписокПараметров.Вставить("ВестиНалоговыйУчет", Выборка.ВестиНалоговыйУчет);
		СписокПараметров.Вставить("КлиентДонор", Выборка.КлиентДонор);
		СписокПараметров.Вставить("КлиентРеципиент", Выборка.КлиентРеципиент);
		
		ЭтаФорма.КлиентДонор = Выборка.КлиентДонор;
		ЭтаФорма.КлиентРеципиент = Выборка.КлиентРеципиент; 
				
		Возврат СписокПараметров;
			
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У донорского счета ДУ нет настроек учета на указанную дату!");
		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции	

&НаКлиенте
Процедура Перенос(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Перенос");
	Попытка
		ВыполнитьПеренос(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры
&НаКлиенте
Процедура ВыполнитьПеренос(ПараметрыСессии)

	Если ЭтаФорма.ОграничениеПоВидуАктива И
		НЕ ЗначениеЗаполнено(ЭтаФорма.УчетныйАктив) Тогда 
		ПараметрыСессии.ТекстОшибки = "Заполните учетный актив, для которого вы хотите перенести настройки";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните учетный актив, для которого вы хотите перенести настройки",,УчетныйАктив);
		Возврат;
	КонецЕсли;
	
	ПереносНаСервере();

КонецПроцедуры


&НаСервере
Процедура ПереносНастроекПоРегистру(ИмяРегистра, ФильтрПоВидуУчета = "", ОтборУчетныйАктив = Неопределено, Отказ)

	ОчищатьСтарыеНастройки = Истина;
	Если ЭтаФорма.НеУдалятьСтарыеНастройки Тогда
	    // возможно, что уже есть значения на ДатаУстановки - почистим
		ЗаписиКУдалению = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		
		ЗаписиКУдалению.Отбор.Период.Установить(ЭтаФорма.ДатаУстановки);
		ЗаписиКУдалению.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
		ЗаписиКУдалению.Отбор.СчетДоверительногоУправления.Установить(ЭтаФорма.СчетРеципиент); 
		Если ИмяРегистра = "НастройкиУчетаАктивов" И ОтборУчетныйАктив <> Неопределено Тогда 
			ЗаписиКУдалению.Отбор.УчетныйАктив.Установить(ОтборУчетныйАктив);
		КонецЕсли;
				
		Если ФильтрПоВидуУчета <> "" Тогда
			ЗаписиКУдалению.Отбор.ВидУчета.Установить(ФильтрПоВидуУчета);
		КонецЕсли;
		
		Попытка
			ЗаписиКУдалению.Прочитать();
			ЗаписиКУдалению.Очистить();
			ЗаписиКУдалению.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		ОчищатьСтарыеНастройки = Ложь;
	КонецЕсли;
	
	ЗаписиПриемник = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	ЗаписиПриемник.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
	ЗаписиПриемник.Отбор.СчетДоверительногоУправления.Установить(ЭтаФорма.СчетРеципиент); 
	Если ИмяРегистра = "НастройкиУчетаАктивов" И ОтборУчетныйАктив <> Неопределено Тогда 
		ЗаписиПриемник.Отбор.УчетныйАктив.Установить(ОтборУчетныйАктив);
	КонецЕсли;
	
	Если ФильтрПоВидуУчета <> "" Тогда
		ЗаписиПриемник.Отбор.ВидУчета.Установить(ФильтрПоВидуУчета);
	КонецЕсли;
	
	Попытка
		ЗаписиПриемник.Прочитать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	Если ОчищатьСтарыеНастройки Тогда
		ЗаписиПриемник.Очистить();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ИмяРегистра = "НастройкиУчетаАктивов" И ОтборУчетныйАктив <> Неопределено Тогда 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.*
		|ИЗ
		|	РегистрСведений.%ИмяРегистра%.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления И УчетныйАктив В (&ОтборУчетныйАктив)) КАК Настройки"; 
		
		Запрос.УстановитьПараметр("ОтборУчетныйАктив", ОтборУчетныйАктив);
	Иначе	
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.*
		|ИЗ
		|	РегистрСведений.%ИмяРегистра%.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК Настройки"; 
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИмяРегистра%", ИмяРегистра);
	
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаВзятия);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДонор);
	
	Если ФильтрПоВидуУчета <> "" Тогда
		Запрос.УстановитьПараметр("ВидУчета", ФильтрПоВидуУчета);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Период,", "&Период, ВидУчета = &ВидУчета И");
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		СтрокаЗаписиПриемник = ЗаписиПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаписиПриемник, ВыборкаДетальныеЗаписи);
		СтрокаЗаписиПриемник.СчетДоверительногоУправления = ЭтаФорма.СчетРеципиент;
		СтрокаЗаписиПриемник.Организация = ЭтаФорма.СчетРеципиент.Организация;
		Если ФильтрПоВидуУчета <> "" Тогда
			СтрокаЗаписиПриемник.ВидУчета = ФильтрПоВидуУчета;
		КонецЕсли;
		СтрокаЗаписиПриемник.Период = ЭтаФорма.ДатаУстановки;  
		
		Если ИмяРегистра = "НастройкиУчетаАктивов" И ЭтаФорма.ДатаУстановки > Дата(2025, 1, 1) Тогда
			Если СтрокаЗаписиПриемник.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет 
				И СтрокаЗаписиПриемник.УчетныйАктив = Справочники.УчетныеАктивы.Паи 
				И СтрокаЗаписиПриемник.КлассификацияАктиваПоСрочности = Справочники.КлассификаторАктивовПоСрочности.СвышеГода Тогда
				СтрокаЗаписиПриемник.КлассификацияАктиваПоСрочности = Справочники.КлассификаторАктивовПоСрочности.СвышеПятиЛет;  
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид учета Единый бухгалтерский учет, вид актива Паи: Классификация актива по срочности 'Свыше года' заменена на 'Свыше пяти лет'");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка
		ЗаписиПриемник.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПереносНастроекПоРегиструПереопределениеКлассификации(Отказ)
	// версия процедуры  ПереносНастроекПоРегистру()
	// нет измерения Счет доверительного управления, есть измерение Клиент
	// не нужен фильтр на вид учета
	
	ОчищатьСтарыеНастройки = Истина;
	Если ЭтаФорма.НеУдалятьСтарыеНастройки Тогда
	    // возможно, что уже есть значения на ДатаУстановки - почистим
		ЗаписиКУдалению = РегистрыСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СоздатьНаборЗаписей();
		
		ЗаписиКУдалению.Отбор.Период.Установить(ЭтаФорма.ДатаУстановки);
		ЗаписиКУдалению.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
		ЗаписиКУдалению.Отбор.Клиент.Установить(ЭтаФорма.КлиентРеципиент);
		
		Попытка
			ЗаписиКУдалению.Прочитать();
			ЗаписиКУдалению.Очистить();
			ЗаписиКУдалению.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		ОчищатьСтарыеНастройки = Ложь;
	КонецЕсли;
	
	ЗаписиПриемник = РегистрыСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СоздатьНаборЗаписей();
	
	ЗаписиПриемник.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
	ЗаписиПриемник.Отбор.Клиент.Установить(ЭтаФорма.КлиентРеципиент);
	
	Попытка
		ЗаписиПриемник.Прочитать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	Если ОчищатьСтарыеНастройки Тогда
		ЗаписиПриемник.Очистить();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.*
		|ИЗ
		|	РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СрезПоследних(&Период, Клиент = &Клиент И Организация = &Организация) КАК Настройки";
	
	
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаВзятия);
	Запрос.УстановитьПараметр("Клиент", ЭтаФорма.КлиентДонор);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.СчетДонор.Организация);
		
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		СтрокаЗаписиПриемник = ЗаписиПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаписиПриемник, ВыборкаДетальныеЗаписи);
		СтрокаЗаписиПриемник.Клиент = ЭтаФорма.КлиентРеципиент;
		СтрокаЗаписиПриемник.Организация = ЭтаФорма.СчетРеципиент.Организация;
		СтрокаЗаписиПриемник.Период = ЭтаФорма.ДатаУстановки;
		
	КонецЦикла;
	
	Попытка
		ЗаписиПриемник.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	ОчищатьСтарыеНастройки = Истина;
	Если ЭтаФорма.НеУдалятьСтарыеНастройки Тогда
	    // возможно, что уже есть значения на ДатаУстановки - почистим
		ЗаписиКУдалению = РегистрыСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СоздатьНаборЗаписей();
		
		ЗаписиКУдалению.Отбор.Период.Установить(ЭтаФорма.ДатаУстановки);
		ЗаписиКУдалению.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
		ЗаписиКУдалению.Отбор.Клиент.Установить(ЭтаФорма.КлиентРеципиент);
		
		Попытка
			ЗаписиКУдалению.Прочитать();
			ЗаписиКУдалению.Очистить();
			ЗаписиКУдалению.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		ОчищатьСтарыеНастройки = Ложь;
	КонецЕсли;
	
	ЗаписиПриемник = РегистрыСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СоздатьНаборЗаписей();
	
	ЗаписиПриемник.Отбор.Организация.Установить(ПараметрыСеанса.ТекущаяОрганизация);
	ЗаписиПриемник.Отбор.Клиент.Установить(ЭтаФорма.КлиентРеципиент);
	
	Попытка
		ЗаписиПриемник.Прочитать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	Если ОчищатьСтарыеНастройки Тогда
		ЗаписиПриемник.Очистить();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Настройки.*
		|ИЗ
		|	РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ.СрезПоследних(&Период, Клиент = &Клиент И Организация = &Организация) КАК Настройки";
	
	
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаВзятия);
	Запрос.УстановитьПараметр("Клиент", ЭтаФорма.КлиентДонор);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.СчетДонор.Организация);
		
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		СтрокаЗаписиПриемник = ЗаписиПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаписиПриемник, ВыборкаДетальныеЗаписи);
		СтрокаЗаписиПриемник.Клиент = ЭтаФорма.КлиентРеципиент;
		СтрокаЗаписиПриемник.Организация = ЭтаФорма.СчетРеципиент.Организация;
		СтрокаЗаписиПриемник.Период = ЭтаФорма.ДатаУстановки;
		
	КонецЦикла;
	
	Попытка
		ЗаписиПриемник.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());	
		Отказ = Истина;
		Возврат;
	КонецПопытки;
		
КонецПроцедуры	

&НаСервере
Процедура ПереносНаСервере()

	Отказ = Ложь;
	
	Если ПараметрыСеанса.ТекущаяОрганизация <> СчетРеципиент.Организация Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Текущая организация должна быть равна организации счета-приёмника");
		Возврат;
		
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
		// блокировка
		БлокировкаДанных = Новый БлокировкаДанных;
		
		Если ЭтаФорма.Общие Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиУчетаОбщие");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.ПоВидуЕПС ИЛИ ЭтаФорма.ПоВидуБУ ИЛИ ЭтаФорма.ПоВидуНУ Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиПоВидуУчета");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.АктивыЕПС Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиУчетаАктивовЕПС");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.АктивыБУ ИЛИ ЭтаФорма.АктивыНУ ИЛИ ЭтаФорма.АктивыПоСрочности Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиУчетаАктивов");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.КомиссияЕПС ИЛИ ЭтаФорма.КомиссияБУ ИЛИ ЭтаФорма.КомиссияНУ Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиУчетаКомиссии");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.ЗакрытиеЕПС ИЛИ ЭтаФорма.ЗакрытиеБУ ИЛИ ЭтаФорма.ЗакрытиеНУ Тогда
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НастройкиЗакрытияБухгалтерскихСчетов");
			ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтаФорма.СчетРеципиент);
		КонецЕсли;
		
		Если ЭтаФорма.ПереопределениеКлассификации Тогда 
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ПереопределениеКлассификацииУчетныхАктивовЦБ");
			ЭлементБлокировкиДанных.УстановитьЗначение("Клиент", ЭтаФорма.КлиентРеципиент);
		КонецЕсли;	
		
		БлокировкаДанных.Заблокировать();
	
	
		Если ЭтаФорма.Общие Тогда
			ПереносНастроекПоРегистру("НастройкиУчетаОбщие", , , Отказ);
		КонецЕсли;
		
		Если ЭтаФорма.ПоВидуЕПС Тогда
			ПереносНастроекПоРегистру("НастройкиПоВидуУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.ПоВидуБУ Тогда
			ПереносНастроекПоРегистру("НастройкиПоВидуУчета", Перечисления.ВидыУчета.БухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.ПоВидуНУ Тогда
			ПереносНастроекПоРегистру("НастройкиПоВидуУчета", Перечисления.ВидыУчета.НалоговыйУчет, , Отказ);
		КонецЕсли;
		
		Если ЭтаФорма.АктивыЕПС Тогда
			ПереносНастроекПоРегистру("НастройкиУчетаАктивовЕПС",,, Отказ);
		КонецЕсли;
		Если ЭтаФорма.АктивыБУ Тогда
			Если НЕ ЭтаФорма.ОграничениеПоВидуАктива Тогда 
				ПереносНастроекПоРегистру("НастройкиУчетаАктивов", Перечисления.ВидыУчета.БухгалтерскийУчет, , Отказ);
			Иначе 
				Для Каждого Элемент из ЭтаФорма.УчетныйАктив Цикл
					ПереносНастроекПоРегистру("НастройкиУчетаАктивов", Перечисления.ВидыУчета.БухгалтерскийУчет, Элемент.Значение, Отказ);
				КонецЦикла
			КонецЕсли;
		КонецЕсли;
		Если ЭтаФорма.АктивыНУ Тогда   
			Если НЕ ЭтаФорма.ОграничениеПоВидуАктива Тогда 
				ПереносНастроекПоРегистру("НастройкиУчетаАктивов", Перечисления.ВидыУчета.НалоговыйУчет, , Отказ);
			Иначе 
				Для Каждого Элемент из ЭтаФорма.УчетныйАктив Цикл
					ПереносНастроекПоРегистру("НастройкиУчетаАктивов", Перечисления.ВидыУчета.НалоговыйУчет, Элемент.Значение, Отказ);
				КонецЦикла
			КонецЕсли;
		КонецЕсли;
		Если ЭтаФорма.АктивыПоСрочности Тогда 
			ПереносНастроекПоРегистру("НастройкиУчетаАктивов", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, , Отказ);
		КонецЕсли;	
		Если ЭтаФорма.ПереопределениеКлассификации Тогда 
			ПереносНастроекПоРегиструПереопределениеКлассификации(Отказ);
		КонецЕсли;
		
		Если ЭтаФорма.КомиссияЕПС Тогда
			ПереносНастроекПоРегистру("НастройкиУчетаКомиссии", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.КомиссияБУ Тогда
			ПереносНастроекПоРегистру("НастройкиУчетаКомиссии", Перечисления.ВидыУчета.БухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.КомиссияНУ Тогда
			ПереносНастроекПоРегистру("НастройкиУчетаКомиссии", Перечисления.ВидыУчета.НалоговыйУчет, , Отказ);
		КонецЕсли;
		
		Если ЭтаФорма.ЗакрытиеЕПС Тогда
			ПереносНастроекПоРегистру("НастройкиЗакрытияБухгалтерскихСчетов", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.ЗакрытиеБУ Тогда
			ПереносНастроекПоРегистру("НастройкиЗакрытияБухгалтерскихСчетов", Перечисления.ВидыУчета.БухгалтерскийУчет, , Отказ);
		КонецЕсли;
		Если ЭтаФорма.ЗакрытиеНУ Тогда
			ПереносНастроекПоРегистру("НастройкиЗакрытияБухгалтерскихСчетов", Перечисления.ВидыУчета.НалоговыйУчет, , Отказ);
		КонецЕсли;
		
	Если Отказ Тогда 
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();   
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДетализироватьПриИзменении(Элемент)
	
	ЭтаФорма.Элементы.НастройкиДетализации.Видимость = ЭтаФорма.Детализировать;
		
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьНастройкиПереноса(СписокПараметров)
	
	Если СписокПараметров = Неопределено Тогда 
		ВестиБухгалтерскийУчет = Ложь;
		ВестиЕдиныйБухгалтерскийУчет = Ложь;
		ВестиНалоговыйУчет = Ложь;
		ЭтоОдинКлиент = Ложь;
	Иначе 
		ВестиБухгалтерскийУчет = СписокПараметров.ВестиБухгалтерскийУчет;
		ВестиЕдиныйБухгалтерскийУчет = СписокПараметров.ВестиЕдиныйБухгалтерскийУчет;
		ВестиНалоговыйУчет = СписокПараметров.ВестиНалоговыйУчет;		
		ЭтоОдинКлиент = (СписокПараметров.КлиентДонор = СписокПараметров.КлиентРеципиент);
	Конецесли;	
		
	ЭтаФорма.Общие = Истина;
	
	ЭтаФорма.ПоВидуЕПС = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.ПоВидуБУ = ВестиБухгалтерскийУчет;
	ЭтаФорма.ПоВидуНУ = ВестиНалоговыйУчет;
	
	ЭтаФорма.АктивыЕПС = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.АктивыБУ = ВестиБухгалтерскийУчет;
	ЭтаФорма.АктивыНУ = ВестиНалоговыйУчет;
	
	ЭтаФорма.КомиссияЕПС = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.КомиссияБУ = ВестиБухгалтерскийУчет;
	ЭтаФорма.КомиссияНУ = ВестиНалоговыйУчет;
	
	ЭтаФорма.ЗакрытиеЕПС = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.ЗакрытиеБУ = ВестиБухгалтерскийУчет;
	ЭтаФорма.ЗакрытиеНУ = ВестиНалоговыйУчет;
	
	ЭтаФорма.АктивыПоСрочности = ВестиЕдиныйБухгалтерскийУчет;
	
	Если ВестиЕдиныйБухгалтерскийУчет И Не ЭтоОдинКлиент Тогда 
		ЭтаФорма.ПереопределениеКлассификации = Истина;
	Иначе	
		ЭтаФорма.ПереопределениеКлассификации = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьДоступностьНастроекПереноса(СписокПараметров)
	
	Если СписокПараметров = Неопределено Тогда 
		ВестиБухгалтерскийУчет = Ложь;
		ВестиЕдиныйБухгалтерскийУчет = Ложь;
		ВестиНалоговыйУчет = Ложь;
		ЭтоОдинКлиент = Ложь;
	Иначе 
		ВестиБухгалтерскийУчет = СписокПараметров.ВестиБухгалтерскийУчет;
		ВестиЕдиныйБухгалтерскийУчет = СписокПараметров.ВестиЕдиныйБухгалтерскийУчет;
		ВестиНалоговыйУчет = СписокПараметров.ВестиНалоговыйУчет;		
		ЭтоОдинКлиент = (СписокПараметров.КлиентДонор = СписокПараметров.КлиентРеципиент);
	Конецесли;	
		
	ЭтаФорма.Элементы.ПоВидуЕПС.Доступность = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.Элементы.ПоВидуБУ.Доступность = ВестиБухгалтерскийУчет;
	ЭтаФорма.Элементы.ПоВидуНУ.Доступность = ВестиНалоговыйУчет;
	
	ЭтаФорма.Элементы.АктивыЕПС.Доступность = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.Элементы.АктивыБУ.Доступность = ВестиБухгалтерскийУчет;
	ЭтаФорма.Элементы.АктивыНУ.Доступность = ВестиНалоговыйУчет;
	
	ЭтаФорма.Элементы.КомиссияЕПС.Доступность = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.Элементы.КомиссияБУ.Доступность = ВестиБухгалтерскийУчет;
	ЭтаФорма.Элементы.КомиссияНУ.Доступность = ВестиНалоговыйУчет;
	
	ЭтаФорма.Элементы.ЗакрытиеЕПС.Доступность = ВестиЕдиныйБухгалтерскийУчет;
	ЭтаФорма.Элементы.ЗакрытиеБУ.Доступность = ВестиБухгалтерскийУчет;
	ЭтаФорма.Элементы.ЗакрытиеНУ.Доступность = ВестиНалоговыйУчет;
	
	ЭтаФорма.Элементы.АктивыПоСрочности.Доступность = ВестиЕдиныйБухгалтерскийУчет;
		
	Если ВестиЕдиныйБухгалтерскийУчет И Не ЭтоОдинКлиент Тогда 
		ЭтаФорма.Элементы.ПереопределениеКлассификации.Доступность = Истина;
	Иначе	
		ЭтаФорма.Элементы.ПереопределениеКлассификации.Доступность = Ложь;
	КонецЕсли;	
	
	ЭтаФорма.Элементы.ОграничениеПоВидуАктива.Доступность = Ложь;
	ЭтаФорма.ОграничениеПоВидуАктива = Ложь;
	Элементы.УчетныйАктив.Видимость = ЭтаФорма.ОграничениеПоВидуАктива;
	
	Если ВестиБухгалтерскийУчет ИЛИ ВестиНалоговыйУчет Тогда 
		ЭтаФорма.Элементы.ОграничениеПоВидуАктива.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПроставитьНастройкиПереноса(Неопределено);
	ПроставитьДоступностьНастроекПереноса(Неопределено);
	ЭтаФорма.Детализировать = Ложь;
	ЭтаФорма.Элементы.НастройкиДетализации.Видимость = ЭтаФорма.Детализировать;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСчетаИлиДаты(Элемент)
	
	Если ЗначениеЗаполнено(ДатаВзятия) Тогда
		
		СписокПараметров = ПолучитьСписокПараметровНаСервере();
		ПроставитьНастройкиПереноса(СписокПараметров);
		ПроставитьДоступностьНастроекПереноса(СписокПараметров);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничениеПоВидуАктиваПриИзменении(Элемент)
	
	Если ОграничениеПоВидуАктива Тогда 
		ЭтаФорма.Элементы.УчетныйАктив.Видимость = Истина; 
		
		//снимем все флажки кроме Активы НУ и БУ  
		ЭтаФорма.Общие = Ложь;
		ЭтаФорма.ПоВидуЕПС = Ложь;
		ЭтаФорма.ПоВидуБУ = Ложь;
		ЭтаФорма.ПоВидуНУ = Ложь;
	    ЭтаФорма.АктивыЕПС = Ложь;
		ЭтаФорма.АктивыПоСрочности = Ложь;
		ЭтаФорма.ПереопределениеКлассификации = Ложь;
		ЭтаФорма.КомиссияЕПС = Ложь;
		ЭтаФорма.КомиссияБУ = Ложь;
		ЭтаФорма.КомиссияНУ = Ложь;
		ЭтаФорма.ЗакрытиеЕПС = Ложь;
		ЭтаФорма.ЗакрытиеБУ = Ложь;
		ЭтаФорма.ЗакрытиеНУ = Ложь;
	Иначе
		ЭтаФорма.Элементы.УчетныйАктив.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти