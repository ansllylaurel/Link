&НаСервереБезКонтекста
Процедура ВыгрузитьСведенияОбОснованииБиржевойСделки(ЗаписьXML, Брокер, Период, РеквизитыСторон)
	
	РеквизитыБрокера = РеквизитыСторон.Получить(Брокер);
	
	Если РеквизитыБрокера = Неопределено Тогда
		РеквизитыБрокера = Новый Структура("Имя, КраткоеИмя");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Имя,
			|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК КраткоеИмя
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|			&Период,
			|			ЮрФизЛицо = &ЮрФизЛицо
			|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
			
		Запрос.УстановитьПараметр("Период",    Период);
		Запрос.УстановитьПараметр("ЮрФизЛицо", Брокер.ЮрФизЛицо);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(РеквизитыБрокера, Выборка);
		КонецЕсли;
		
		РеквизитыСторон.Вставить(
			Брокер, РеквизитыБрокера);
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("основание_операции");
	
	ЗаписатьЭлементXML(ЗаписьXML, "имя",      "ОТЧЕТ БРОКЕРА");
	ЗаписатьЭлементXML(ЗаписьXML, "номер",    "б/н");
	ЗаписатьЭлементXML(ЗаписьXML, "дата",     СериализоватьЗначение(Период));
	ЗаписатьЭлементXML(ЗаписьXML, "источник", РеквизитыБрокера.КраткоеИмя);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // основание_операции
	
КонецПроцедуры // ВыгрузитьСведенияОбОснованииБиржевойСделки

&НаСервереБезКонтекста
Функция ВыгрузитьПорученияПоБиржевымСделкам(ЗаписьXML, Организация, СчетДоверительногоУправления, Период, РеквизитыСторон, СправочикЦенныхБумагПРСД)
	
	Ошибки = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Дата,
		|	Сделка.Брокер,
		|	Сделка.ВидСделки,
		|	ВЫБОР
		|		КОГДА Сделка.ОтложенноеИсполнение
		|			ТОГДА ВЫБОР
		|					КОГДА Сделка.РаздельноеИсполнение
		|						ТОГДА Сделка.ДатаПоставки
		|					ИНАЧЕ Сделка.ДатаИсполнения
		|				КОНЕЦ
		|		ИНАЧЕ Сделка.Дата
		|	КОНЕЦ КАК ДатаИсполнения,
		|	СделкаЦенныеБумаги.Количество,
		|	СделкаЦенныеБумаги.Сумма,
		|	СделкаЦенныеБумаги.ЦеннаяБумага,
		|	СделкаЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК РегНомер
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка
		|ГДЕ
		|	Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И Сделка.Проведен
		|	И Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       Период);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("поручение_депо");
		ЗаписьXML.ЗаписатьАтрибут("дата", СериализоватьЗначение(Выборка.Дата));
		
		Если      Выборка.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			ЗаписьXML.ЗаписатьАтрибут("тип", "З");
		ИначеЕсли Выборка.ВидСделки = Перечисления.ВидыСделок.Продажа Тогда
			ЗаписьXML.ЗаписатьАтрибут("тип", "С");
		КонецЕсли;
		
		ЗаписатьЭлементXML(ЗаписьXML, "дата_сделки",     СериализоватьЗначение(Выборка.Дата));
		ЗаписатьЭлементXML(ЗаписьXML, "дата_исполнения", СериализоватьЗначение(Выборка.ДатаИсполнения));
		
		ВыгрузитьСведенияОКлиенте(ЗаписьXML, Организация, СчетДоверительногоУправления, РеквизитыСторон);
		ВыгрузитьСведенияОКонтрагенте(ЗаписьXML);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ценная_бумага");
				
		РеквизитыЦеннойБумагиПРСД = СправочикЦенныхБумагПРСД.Найти(Выборка.РегНомер, "isin");
		
		Если РеквизитыЦеннойБумагиПРСД = Неопределено Тогда
			ТекстОшибки = "Не удалось определить реквизиты ц/б " + Выборка.ЦеннаяБумага + " в справочнике ПРСД.";
			
			Если Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Ошибки.Добавить(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьАтрибут("тип", РеквизитыЦеннойБумагиПРСД.type_code);
		
		ЗаписатьЭлементXML(ЗаписьXML, "имя",        РеквизитыЦеннойБумагиПРСД.issuer_name);
		ЗаписатьЭлементXML(ЗаписьXML, "номер",      РеквизитыЦеннойБумагиПРСД.isin);
		ЗаписатьЭлементXML(ЗаписьXML, "выпуск",     РеквизитыЦеннойБумагиПРСД.issue_num);
		ЗаписатьЭлементXML(ЗаписьXML, "количество", СериализоватьЗначение(Выборка.Количество));
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ценная_бумага
		
		ВыгрузитьСведенияОбОснованииБиржевойСделки(ЗаписьXML, Выборка.Брокер, Период, РеквизитыСторон);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("стоимость_цб");
		ЗаписьXML.ЗаписатьАтрибут("валюта", "РУБ");
		ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(Выборка.Сумма));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // стоимость_цб
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // поручение_депо
	КонецЦикла;
	
	Возврат (Ошибки.Количество() = 0);
	
КонецФункции // ВыгрузитьПорученияПоБиржевымСделкам

&НаСервереБезКонтекста
Процедура ВыгрузитьПакетДанных(Организация, СчетДоверительногоУправления, Период, ПолноеИмяФайла)
	
	СправочикЦенныхБумагПРСД = ПолучитьСправочикЦенныхБумагПРСД();
	
	Если СправочикЦенныхБумагПРСД.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить справочник ценных бумаг ПРСД. Пакет данных не сформирован.");
		Возврат;
	КонецЕсли;
	
	РеквизитыСторон = ПолучитьРеквизитыСторон(Организация, СчетДоверительногоУправления, Период);
	
	ЗаписьXML = Новый ЗаписьXML;
	
	Попытка
		ЗаписьXML.ОткрытьФайл(ПолноеИмяФайла, "WINDOWS-1251");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
		
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("пакет");
	ЗаписьXML.ЗаписатьАтрибут("дата", СериализоватьЗначение(ТекущаяДата(), "TIMESTAMP"));
	ЗаписьXML.ЗаписатьАтрибут("uuid", СериализоватьЗначение(Новый УникальныйИдентификатор()));
	
	ВыгрузитьСведенияОФонде(ЗаписьXML, Организация, СчетДоверительногоУправления, РеквизитыСторон);
	
	Если Не ВыгрузитьПорученияПоБиржевымСделкам(ЗаписьXML, Организация, СчетДоверительногоУправления, Период, РеквизитыСторон, СправочикЦенныхБумагПРСД) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пакет данных не сформирован.");
		Возврат
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // пакет
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пакет данных сформирован.");
	
КонецПроцедуры // ВыгрузитьПакетДанных 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Организация                  = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Период                       = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	ЭтаФорма.СчетДоверительногоУправления = ПолучитьСчетДоверительногоУправленияФОГФ(Организация);
	ЭтаФорма.ПолноеИмяФайла               = СформироватьИмяФайла(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления,ЭтаФорма.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ЭтаФорма.ПолноеИмяФайла = СформироватьИмяФайла(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ЭтаФорма.ПолноеИмяФайла = СформироватьИмяФайла(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолноеИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.ПолноеИмяФайла     = ЭтаФорма.ПолноеИмяФайла;
	ДиалогВыбораФайла.Фильтр             = "Пакеты данных СЭД ПРСД (*.ufm)|*.ufm";
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ЭтаФорма.ПолноеИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьПакетДанных(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСформироватьПакетДанных");
	Попытка
		ВыполнитьФормированиеПакетаДанных(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьФормированиеПакетаДанных(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ПараметрыСессии.ТекстОшибки = "Не заполнены обязательные реквизиты формы";
		Возврат;
	КонецЕсли;
	
	ТекФайл = Новый Файл(ЭтаФорма.ПолноеИмяФайла);
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекФайл.Путь, Отказ);
	Если Отказ Тогда
		Сообщить("Экспорт данных прерван");
	КонецЕсли;
	
	ВыгрузитьПакетДанных(ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Период, ЭтаФорма.ПолноеИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НовыйПараметр	= Новый ПараметрВыбора("Отбор.СпециализированныйДепозитарий", ПолучитьМассивДепозитариев());
	ПараметрыВыбора	= Новый Массив;
	ПараметрыВыбора.Добавить(НовыйПараметр);
	Элементы.СчетДоверительногоУправления.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивДепозитариев()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеКомпании.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДепозитарныеКомпании КАК ДепозитарныеКомпании
		|ГДЕ
		|	ДепозитарныеКомпании.СистемаЭлектронногоДокументооборота = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.СЭД_ПРСД)";
	
	Возврат Новый ФиксированныйМассив(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
