
&НаСервереБезКонтекста
Функция СформироватьИмяФайла(Период, СчетДоверительногоУправления, Организация, КаталогФайла = "")
	
	ПрефиксИмениФайла = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ВнешняяОбработка._ЭкспортДанныхВСЭДПРСД.ПрефиксИмениФайла", СчетДоверительногоУправления);
	
	Если Не ЗначениеЗаполнено(ПрефиксИмениФайла) Тогда
		ПрефиксИмениФайла = "";
	КонецЕсли;
	
	Если ПустаяСтрока(КаталогФайла) Тогда
		Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
			КаталогФайла = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._ЭкспортДанныхВСЭДПРСД.ШаблонКаталогаФайлов", Организация, Период, КаталогФайла);
		Иначе
			КаталогФайла = "\\am-1c00\InfoBases8\Арчи\СЭД ПРСД";
		КонецЕсли;
	КонецЕсли;
	
	Возврат КаталогФайла + ПрефиксИмениФайла + Формат(Период, "ДФ=ddMMyy") + ".ufm";
	
КонецФункции // СформироватьИмяФайла

&НаСервереБезКонтекста
Функция ПолучитьСчетДоверительногоУправленияФОГФ(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СчетаДоверительногоУправления.Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ)
		|	И Организация = &Организация";
		
	Запрос.УстановитьПараметр("Организация", Организация);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
	
КонецФункции // ПолучитьСчетДоверительногоУправленияФОГФ

&НаСервереБезКонтекста
Функция ПолучитьСправочикЦенныхБумагПРСД()

	АдресРесурса = "ds.frsd.ru";
	
	// загрузим файла справочника
	Соединение = Новый HTTPСоединение(АдресРесурса);
	
	Запрос = Новый HTTPЗапрос;
	Запрос.АдресРесурса = "/frsdagent3/update/secur-list.xml";
	
	ИмяФайла = КаталогВременныхФайлов() + "frsd-secur-list.xml";
	
	Соединение.Получить(Запрос, ИмяФайла);
	
	// загрузка данных из xml
	СправочикЦенныхБумагПРСД = Новый ТаблицаЗначений;
	СправочикЦенныхБумагПРСД.Колонки.Добавить("id");
	СправочикЦенныхБумагПРСД.Колонки.Добавить("issuer_name");
	СправочикЦенныхБумагПРСД.Колонки.Добавить("type_code");
	СправочикЦенныхБумагПРСД.Колонки.Добавить("isin");
	СправочикЦенныхБумагПРСД.Колонки.Добавить("issue_num");
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);	
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат СправочикЦенныхБумагПРСД;
	КонецПопытки;


	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "secur" Тогда
			НоваяСтрокаСправочикЦенныхБумагПРСД = СправочикЦенныхБумагПРСД.Добавить();
			
			Для каждого Колонка Из СправочикЦенныхБумагПРСД.Колонки Цикл
				НоваяСтрокаСправочикЦенныхБумагПРСД[Колонка.Имя] = ЧтениеXML.ЗначениеАтрибута(СтрЗаменить(Колонка.Имя, "_", "-"));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	
	// удалим временный файл
	УдалитьФайлы(ИмяФайла);
	
	Возврат СправочикЦенныхБумагПРСД;

КонецФункции // ПолучитьСправочикЦенныхБумагПРСД


&НаСервереБезКонтекста
Процедура ЗаписатьЭлементXML(ЗаписьXML, Имя, Значение)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры // ЗаписатьЭлементXML

&НаСервереБезКонтекста
Функция СериализоватьЗначение(Значение, Модификатор = Неопределено)
	
	Если      ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Модификатор = "TIMESTAMP" Тогда
			Возврат Формат(Значение, "ДФ=yyyyMMddTЧЧММ");
		Иначе
			Возврат Формат(Значение, "ДФ=yyyyMMdd");
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=");
	Иначе
		Возврат СокрЛП(Значение);
	КонецЕсли;
	
КонецФункции // СериализоватьЗначение


&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСторон(Организация, СчетДоверительногоУправления, Период)
	
	РеквизитыСторон = Новый Соответствие();
		
	// фонд
	РеквизитыСтороны = Новый Структура("Имя, КраткоеИмя");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",    Период);
	Запрос.УстановитьПараметр("ЮрФизЛицо", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		РеквизитыСтороны.Имя = Выборка.КраткоеНаименованиеПоУставу;
	КонецЕсли;
	
	РеквизитыСтороны.КраткоеИмя = "ФОГФ. " + СокрЛП(Организация.Наименование);
	
	РеквизитыСторон.Вставить(
		СчетДоверительногоУправления, РеквизитыСтороны);
	
	// упр. компания
	РеквизитыСтороны = Новый Структура("Имя, КраткоеИмя");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеИмя,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Имя
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
	Запрос.УстановитьПараметр("Период",    Период);
	Запрос.УстановитьПараметр("ЮрФизЛицо", Организация.ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыСтороны, Выборка);
	КонецЕсли;
	
	РеквизитыСторон.Вставить(
		Организация, РеквизитыСтороны);
	
	Возврат РеквизитыСторон;
	
КонецФункции // ВыгрузитьСведенияОФонде

&НаСервереБезКонтекста
Процедура ВыгрузитьСведенияОФонде(ЗаписьXML, Организация, СчетДоверительногоУправления, РеквизитыСторон)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("фонд");
	ЗаписьXML.ЗаписатьАтрибут("номер", "841");
	ЗаписьXML.ЗаписатьАтрибут("тип",   "ФОГФ");
	
	ЗаписатьЭлементXML(ЗаписьXML, "имя",         РеквизитыСторон[СчетДоверительногоУправления].Имя);
	ЗаписатьЭлементXML(ЗаписьXML, "имя_краткое", РеквизитыСторон[СчетДоверительногоУправления].КраткоеИмя);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("упр_компания");
	
	ЗаписатьЭлементXML(ЗаписьXML, "имя",         РеквизитыСторон[Организация].Имя);
	ЗаписатьЭлементXML(ЗаписьXML, "имя_краткое", РеквизитыСторон[Организация].КраткоеИмя);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // упр_компания
	ЗаписьXML.ЗаписатьКонецЭлемента(); // фонд

КонецПроцедуры // ВыгрузитьСведенияОФонде

&НаСервереБезКонтекста
Процедура ВыгрузитьСведенияОКлиенте(ЗаписьXML, Организация, СчетДоверительногоУправления, РеквизитыСторон)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("клиент");
	
	ЗаписатьЭлементXML(ЗаписьXML, "имя", РеквизитыСторон[Организация].Имя);
		
	ВыгрузитьСведенияОФонде(ЗаписьXML, Организация, СчетДоверительногоУправления, РеквизитыСторон);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("кл_счет");
	ЗаписьXML.ЗаписатьАтрибут("номер", "3710");
	ЗаписьXML.ЗаписатьКонецЭлемента(); // кл_счет
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // клиент
	
КонецПроцедуры // ВыгрузитьСведенияОКлиенте

&НаСервереБезКонтекста
