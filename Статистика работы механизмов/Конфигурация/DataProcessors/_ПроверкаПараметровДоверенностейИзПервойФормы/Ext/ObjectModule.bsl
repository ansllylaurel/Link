
////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Проверка параметров доверенностей из первой формы", "0.06","", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВыполнитьПроверку", "Выполнить проверку",,  Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	
	Если ИдентификаторКоманды = "ВыполнитьПроверку" Тогда
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда 
			
			ИсключитьИзСверки = Неопределено;
			
			Если ПараметрыКоманды.Свойство("ИсключитьИзСверки") Тогда
				ИсключитьИзСверки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПараметрыКоманды.ИсключитьИзСверки, ",", Истина, Истина);
			КонецЕсли;
			
			ВыполнитьПроверку(Истина, ИсключитьИзСверки);
			
		Иначе
			ЗарегистрироватьОшибку("Не удалось выполнить команду [" + ИдентификаторКоманды + "]. Не указано значение параметра [Организация].");	
		КонецЕсли;
					
	Иначе
		ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Функция ВыполнитьПроверку(РегламентноеЗадание = Ложь, ИсключитьИзСверки = Неопределено) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьПроверку()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация", Новый Структура("РегламентноеЗадание", РегламентноеЗадание));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	Сервер_1Ф = ?(ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза, "1f", "test1f") + ".g1.lan";
	
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения(Сервер_1Ф);
	
	Если ПараметрыПодключения = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось установить соединение с первой формой.", Механизм, Сессия);
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 9999);
	СтруктураЗапроса.Вставить("sortModel", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("sort, colId", "desc", "taskId")));
	
	//проверяем с 01.07.2025, далее проверяем последние 6 месяцев.
	ДатаНачало = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -6));
	ДатаНачало = Макс(ДатаНачало, Дата(2025, 07, 01));
	
	ОтборПоДате = Новый Структура;
	ОтборПоДате.Вставить("dateFrom", Формат(ДатаНачало, "ДФ=yyyy-MM-ddT00:00:00"));
	ОтборПоДате.Вставить("dateTo"); 
	ОтборПоДате.Вставить("filterType", "date");
	ОтборПоДате.Вставить("type", "greaterThan");
	
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("modifiedDate", ОтборПоДате)); 
	
	ВыборПараметров = Новый Массив;
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "task", "task"));
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "taskId", "numberValue"));
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam51", "extParam", "LookUpField")); //компания (Рэм, траст)
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam123", "extParam", "Text")); //номер доверенности - может быть несколько номеров через запятую
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam1374", "extParam", "Checkbox")); //ответственное лицо по 5511-У
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam1530", "extParam", "Checkbox")); //ответственное лицо по 5899-У
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam1015", "extParam", "Date")); //дата выдачи доверенности
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam1017", "extParam", "Date")); //дата окончания действия

	СтруктураЗапроса.Вставить("select", ВыборПараметров);
		
	ТелоЗапроса = ПолучитьЗаписьJSON(СтруктураЗапроса);
		
	ТекстСообщения = "Не удалось получить данные доверенностей из 1-ой формы";
		
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/405/data", ТелоЗапроса, ТекстСообщения); 
	
	Если HTTPОтвет = Неопределено Тогда
		
		ЗарегистрироватьОшибку(ТекстСообщения, Механизм, Сессия);
		Возврат Неопределено;
		
	КонецЕсли;     

	РезультатЗапроса = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
		
	Если РезультатЗапроса.Свойство("totalCount") И РезультатЗапроса.totalCount = 0 Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеПервойФормы = Новый ТаблицаЗначений;
	ДанныеПервойФормы.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДанныеПервойФормы.Колонки.Добавить("КодУК", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ДанныеПервойФормы.Колонки.Добавить("НомерДоверенности", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ДанныеПервойФормы.Колонки.Добавить("ОтветственноеЛицоПо5511У", Новый ОписаниеТипов("Булево"));
	ДанныеПервойФормы.Колонки.Добавить("ОтветственноеЛицоПо5899У", Новый ОписаниеТипов("Булево"));
	ДанныеПервойФормы.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
	ДанныеПервойФормы.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	Если Не РезультатЗапроса.Свойство("tasksDataSourceResponse") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ТекЗадача Из РезультатЗапроса.tasksDataSourceResponse Цикл
		
		Если ТекЗадача.Свойство("isRejected") И ТекЗадача.isRejected Тогда
			Продолжить;	
		КонецЕсли;
		
		Если Не (ТекЗадача.Свойство("taskId") И ТекЗадача.Свойство("extParams")) Тогда
			Продолжить;
		КонецЕсли;
		
		extParams = ТекЗадача.extParams;
		
		Если Не (extParams.Свойство("ExtParam51") И extParams.Свойство("ExtParam123") И extParams.Свойство("ExtParam1374")
				И extParams.Свойство("ExtParam1530") И extParams.Свойство("ExtParam1015") И extParams.Свойство("ExtParam1017")) Тогда
			Продолжить;			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(extParams.ExtParam123.stringValue) Тогда
			Продолжить;	
		КонецЕсли;
		
		НомераДоверенностей = СтрЗаменить(ТекЗадача.extParams.ExtParam123.stringValue, "_", "/");
		
		Дефис = СтрНайти(НомераДоверенностей, "-");
		
		Если Дефис > 0 Тогда 
			
			//Если номера уазаны через дефис ЭМ270125/1-ЭМ270125/16
			//нужно получить все номера из диапазона
			
			ПервыйНомерДоверенности = Сред(НомераДоверенностей, 1, Дефис - 1);
			ПоследнийНомерДоверенности = Сред(НомераДоверенностей, Дефис + 1);
			
			Префикс = Сред(ПервыйНомерДоверенности, 1, СтрНайти(ПервыйНомерДоверенности, "/"));
			
			Попытка
				ПервыйЧисловойНомер = Число(Сред(ПервыйНомерДоверенности, СтрНайти(ПервыйНомерДоверенности, "/") + 1));
				ПоследнийЧисловойНомер = Число(Сред(ПоследнийНомерДоверенности, СтрНайти(ПоследнийНомерДоверенности, "/") + 1));
			Исключение
				ЗарегистрироватьОшибку("Не удалось получить диапазон номеров доверенностей [" + НомераДоверенностей + "] из задачи [" + Формат(ТекЗадача.taskId, "ЧГ=0") + "].");		
				Продолжить;
			КонецПопытки;
			
			НомераДоверенностей = Новый Массив;
			
			Для Инд = ПервыйЧисловойНомер По ПоследнийЧисловойНомер Цикл
				НомераДоверенностей.Добавить(Префикс + Инд);
			КонецЦикла;
			
			Если НомераДоверенностей.Найти(ПервыйНомерДоверенности) = Неопределено
				Или НомераДоверенностей.Найти(ПоследнийНомерДоверенности) = Неопределено Тогда 
				
				ЗарегистрироватьОшибку("Не удалось получить диапазон номеров доверенностей [" + НомераДоверенностей + "] из задачи [" + Формат(ТекЗадача.taskId, "ЧГ=0") + "].");
				Продолжить;
			КонецЕсли;	
				
		Иначе
			НомераДоверенностей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НомераДоверенностей, ",", Истина, Истина);	
		КонецЕсли;
			
		Для Каждого ТекНомер Из НомераДоверенностей Цикл 
		
			НоваяСтрока = ДанныеПервойФормы.Добавить();
			
			НоваяСтрока.НомерЗадачи = Формат(ТекЗадача.taskId, "ЧГ=0");
			НоваяСтрока.КодУК = Формат(ТекЗадача.extParams.ExtParam51.intValue, "ЧГ=0");
			НоваяСтрока.НомерДоверенности = ТекНомер;
			НоваяСтрока.ОтветственноеЛицоПо5511У = ТекЗадача.extParams.ExtParam1374.boolValue;
			НоваяСтрока.ОтветственноеЛицоПо5899У = ТекЗадача.extParams.ExtParam1530.boolValue;
			
			Если ЗначениеЗаполнено(ТекЗадача.extParams.ExtParam1015.dateTimeValue) Тогда
				НоваяСтрока.ДатаНачалаДействия = Дата(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ТекЗадача.extParams.ExtParam1015.dateTimeValue));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекЗадача.extParams.ExtParam1017.dateTimeValue) Тогда
				НоваяСтрока.ДатаОкончанияДействия = Дата(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(ТекЗадача.extParams.ExtParam1017.dateTimeValue));
			КонецЕсли;
	
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|	ДанныеПервойФормы.КодУК КАК КодУК,
		|	ДанныеПервойФормы.НомерДоверенности КАК НомерДоверенности,
		|	ДанныеПервойФормы.ОтветственноеЛицоПо5511У КАК ОтветственноеЛицоПо5511У,
		|	ДанныеПервойФормы.ОтветственноеЛицоПо5899У КАК ОтветственноеЛицоПо5899У,
		|	ДанныеПервойФормы.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ДанныеПервойФормы.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		|ПОМЕСТИТЬ _ДанныеПервойФормы
		|ИЗ
		|	&ДанныеПервойФормы КАК ДанныеПервойФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Доверенности.Ссылка КАК Ссылка,
		|	Доверенности.Организация КАК Организация,
		|	Доверенности.Номер КАК Номер,
		|	Доверенности.Дата КАК Дата,
		|	Доверенности.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	Доверенности.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	Доверенности.ОтветственноеЛицоПо5511У КАК ОтветственноеЛицоПо5511У,
		|	Доверенности.ОтветственноеЛицоПо5899У КАК ОтветственноеЛицоПо5899У
		|ПОМЕСТИТЬ _Доверенности1С
		|ИЗ
		|	Справочник.Доверенности КАК Доверенности
		|ГДЕ
		|	Доверенности.Организация = &Организация
		|	И Доверенности.Дата >= &ДатаНачало
		|	И Доверенности.ВидДоверенности = ЗНАЧЕНИЕ(Перечисление.ВидыДоверенностей.Исходящая)
		|	И НЕ Доверенности.ПометкаУдаления
		|	И НЕ Доверенности.Номер В (&ИсключитьИзСверки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Организация,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыОрганизацийВПервойФорме
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|	_ДанныеПервойФормы.КодУК КАК КодУК,
