		|	_Доверенности1С.Организация КАК Организация,
		|	""Не удалось определенить код организации в первой форме [%1]."" КАК ТекстСообщения
		|ПОМЕСТИТЬ _ОшибкиОпределенияКодов
		|ИЗ
		|	_Доверенности1С КАК _Доверенности1С
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыОрганизацийВПервойФорме КАК _КодыОрганизацийВПервойФорме
		|		ПО _Доверенности1С.Организация = _КодыОрганизацийВПервойФорме.Организация
		|ГДЕ
		|	_КодыОрганизацийВПервойФорме.Код ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Доверенности1С.Ссылка КАК Ссылка,
		|	_Доверенности1С.Номер КАК Номер,
		|	_Доверенности1С.Дата КАК ДатаДоверенности,
		|	_Доверенности1С.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	_Доверенности1С.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	_Доверенности1С.ОтветственноеЛицоПо5511У КАК ОтветственноеЛицоПо5511У,
		|	_Доверенности1С.ОтветственноеЛицоПо5899У КАК ОтветственноеЛицоПо5899У,
		|	_ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|	_ДанныеПервойФормы.ДатаНачалаДействия КАК ДатаНачалаДействия_1Ф,
		|	_ДанныеПервойФормы.ДатаОкончанияДействия КАК ДатаОкончанияДействия_1Ф,
		|	_ДанныеПервойФормы.ОтветственноеЛицоПо5511У КАК ОтветственноеЛицоПо5511У_1Ф,
		|	_ДанныеПервойФормы.ОтветственноеЛицоПо5899У КАК ОтветственноеЛицоПо5899У_1Ф,
		|	""<tr><td>%1</td><td>%2</td><tdfields_3_7>%3</td><tdfields_4_8>%4</td><tdfields_5_9>%5</td><td>%6</td><tdfields_3_7>%7</td><tdfields_4_8>%8</td><tdfields_5_9>%9</td></tr>"" КАК Строка
		|ИЗ
		|	_Доверенности1С КАК _Доверенности1С
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеПервойФормы КАК _ДанныеПервойФормы
		|		ПО _Доверенности1С.Номер = _ДанныеПервойФормы.НомерДоверенности
		|ГДЕ
		|	(_Доверенности1С.ОтветственноеЛицоПо5511У <> ЕСТЬNULL(_ДанныеПервойФормы.ОтветственноеЛицоПо5511У, НЕОПРЕДЕЛЕНО)
		|			ИЛИ _Доверенности1С.ОтветственноеЛицоПо5899У <> ЕСТЬNULL(_ДанныеПервойФормы.ОтветственноеЛицоПо5899У, НЕОПРЕДЕЛЕНО)
		|			ИЛИ _Доверенности1С.ДатаНачалаДействия <> ЕСТЬNULL(_ДанныеПервойФормы.ДатаНачалаДействия, ДАТАВРЕМЯ(1, 1, 1))
		|			ИЛИ _Доверенности1С.ДатаОкончанияДействия <> ЕСТЬNULL(_ДанныеПервойФормы.ДатаОкончанияДействия, ДАТАВРЕМЯ(1, 1, 1))
		|			ИЛИ _Доверенности1С.Дата <> ЕСТЬNULL(_ДанныеПервойФормы.ДатаНачалаДействия, ДАТАВРЕМЯ(1, 1, 1)))";
#КонецОбласти
	
    Запрос.УстановитьПараметр("ДатаНачало", ДатаНачало);
	Запрос.УстановитьПараметр("ДанныеПервойФормы", ДанныеПервойФормы);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ИсключитьИзСверки", ИсключитьИзСверки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекОшибки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияОрганизации"].ПолучитьДанные().Выбрать();
	
	Пока ТекОшибки.Следующий() Цикл
		ЗарегистрироватьОшибку(СтрШаблон(ТекОшибки.ТекстСообщения, ТекОшибки.НомерЗадачи, ТекОшибки.КодУК));	
	КонецЦикла;
	
	ТекОшибки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияКодов"].ПолучитьДанные().Выбрать();
	
	Пока ТекОшибки.Следующий() Цикл
		ЗарегистрироватьОшибку(СтрШаблон(ТекОшибки.ТекстСообщения, ТекОшибки.Организация));	
	КонецЦикла;

	ТекстСообщения = "";
	
	Пока Выборка.Следующий() Цикл
		
		П1 = ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка, Выборка.Номер); 
		П2 = Формат(Выборка.ДатаДоверенности, "ДФ=dd.MM.yyyy");
		П3 = Формат(Выборка.ДатаНачалаДействия, "ДФ=dd.MM.yyyy") + " - " + Формат(Выборка.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy");
		П4 = Формат(Выборка.ОтветственноеЛицоПо5511У, "БЛ=Нет; БИ=Да");
		П5 = Формат(Выборка.ОтветственноеЛицоПо5899У, "БЛ=Нет; БИ=Да");
		
		Если ЗначениеЗаполнено(Выборка.НомерЗадачи) Тогда
			
			Если РегламентноеЗадание Тогда
				П6 = "<A href=""http://" + Сервер_1Ф + "/maintaskform.aspx?TaskID=" + Выборка.НомерЗадачи + """>" + Выборка.НомерЗадачи + "</A>";
			Иначе
				П6 = Выборка.НомерЗадачи;	
			КонецЕсли; 
				
		Иначе
			 П6 = "Отсутствует";	
		КонецЕсли;
		 
		П7 = Формат(Выборка.ДатаНачалаДействия_1Ф, "ДФ=dd.MM.yyyy") + " - " + Формат(Выборка.ДатаОкончанияДействия_1Ф, "ДФ=dd.MM.yyyy");
		П8 = Формат(Выборка.ОтветственноеЛицоПо5511У_1Ф, "БЛ=Нет; БИ=Да");
		П9 = Формат(Выборка.ОтветственноеЛицоПо5899У_1Ф, "БЛ=Нет; БИ=Да"); 
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтрШаблон(Выборка.Строка, П1, П2, П3, П4, П5, П6, П7, П8, П9);
		
		Если ЗначениеЗаполнено(Выборка.НомерЗадачи) Тогда
			
			ТекстСообщения = ?(П3 = П7, СтрЗаменить(ТекстСообщения, "fields_3_7", ""), СтрЗаменить(ТекстСообщения, "fields_3_7", " class=""error"""));  	
			ТекстСообщения = ?(П4 = П8, СтрЗаменить(ТекстСообщения, "fields_4_8", ""), СтрЗаменить(ТекстСообщения, "fields_4_8", " class=""error"""));
			ТекстСообщения = ?(П5 = П9, СтрЗаменить(ТекстСообщения, "fields_5_9", ""), СтрЗаменить(ТекстСообщения, "fields_5_9", " class=""error"""));
			
		Иначе
			
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "fields_3_7", "");  	
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "fields_4_8", "");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "fields_5_9", "");
				
		КонецЕсли;
		
	КонецЦикла;

	Если ТекстСообщения <> "" Тогда
		
		ТекстСообщения =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body     { font-family: ""Arial""; font-size: 12px; }
			|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td       { border: 1px solid #ACC8BD; padding: 5px; }
			|		.top     { background: #E4F0DD; }
			|		.top2    { background: #F0F6EF; }
			|		.error   { background: #FFA07A; }
			|	</style>
			|</head><body><table cols=""9"">
			|<tr class=""top""><td colspan=""5"">1С</td><td colspan=""4"">Первая форма</td></tr>
			|<tr class=""top2""><td colspan=""2"">Доверенность</td><td rowspan=""2"">Срок полномочий</td><td colspan=""2"">Ответственное лицо</td>
			|	<td rowspan=""2"">Задача</td><td rowspan=""2"">Срок полномочий</td><td colspan=""2"">Отчетственное лицо</td></tr>
			|<tr class=""top2""><td>№</td><td>Дата</td><td>5511-У</td><td>5899-У</td><td>5511-У</td><td>5899-У</td></tr>" + ТекстСообщения + "</table></body></html>";
       
		Если РегламентноеЗадание Тогда
			
			РеквизитыОповещения = Новый Структура("Организация, Текст", ЭтотОбъект.Организация, ТекстСообщения);
			Справочники.Оповещения.СформироватьОповещения("Обработка._ПроверкаПараметровДоверенностейИзПервойФормы", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ТекстСообщения;
			
КонецФункции 

Процедура ЗарегистрироватьОшибку(ТекстОшибки, Механизм = Неопределено, Сессия = Неопределено)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
	Если Механизм <> Неопределено И Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, ТекстОшибки);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках() Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры

Функция ПолучитьЗаписьJSON(СтруктураДанных)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции 

Функция ДесериализоватьJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

