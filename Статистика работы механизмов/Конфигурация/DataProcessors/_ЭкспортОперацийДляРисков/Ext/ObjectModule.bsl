		|	_Операции.КодРежимаБиржевыхТоргов КАК КодРежимаБиржевыхТоргов,
		|	_ДанныеЭмитентов.Наименование КАК НаименованиеЭмитента,
		|	_ДанныеЭмитентов.КодМатрих КАК КодМатрихЭмитента
		|ИЗ
		|	_Операции КАК _Операции
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&НачалоПериода, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|			ПО (ВЫРАЗИТЬ(_КодыСчетовВнутреннегоУчета.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Ссылка = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ПО _Операции.СчетДоверительногоУправления = _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыЮрЛицаОрганизации
		|		ПО _Операции.ОрганизацияЮрФизЛицо = _РеквизитыЮрЛицаОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыЮрЛицБирж
		|		ПО _Операции.МестоХранения.Биржа.ЮрФизЛицо = _РеквизитыЮрЛицБирж.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО _Операции.ЦеннаяБумага = ДепозитныеВклады.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МНО КАК МНО
		|		ПО _Операции.ЦеннаяБумага = МНО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСМО КАК СделкаСМО
		|		ПО _Операции.ЦеннаяБумага = СделкаСМО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&НачалоПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _Операции.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И (ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Векселя)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Паи)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
		|						ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ДепозитарныеРасписки))) КАК КодыМатрихЦБ
		|		ПО _Операции.ЦеннаяБумага = КодыМатрихЦБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&НачалоПериода, Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО _Операции.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И _Операции.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеЭмитентов КАК _ДанныеЭмитентов
		|		ПО _Операции.ЦеннаяБумага = _ДанныеЭмитентов.ЦеннаяБумага"
		;
#КонецОбласти
	Запрос.УстановитьПараметр("Организация"      , Организация);
	Запрос.УстановитьПараметр("ДатаМинусМесяц"   , ДобавитьМесяц(Период.ДатаНачала, -1));
	Запрос.УстановитьПараметр("НачалоПериода"    , Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода"     , Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Неопределен_Траст", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_Траст"));
	Запрос.УстановитьПараметр("Неопределен_РЭМ"  , ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Неопределен_РЭМ"));

	Попытка
		ВыборкаЗаписей = Запрос.Выполнить().Выбрать();
	Исключение
		ЗарегистрироватьОшибку("Не удалось выполнить запрос к базе 1С." + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
	
	Если ВыборкаЗаписей.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Соединение = УстановитьСоединение(ЭтоРПИ);
		
	Если ФлагУдаления Тогда
		
		Если Не ВыполнитьЗапрос("BEGIN TRANSACTION ExportOperations", Соединение) Тогда
			Возврат 0;
		КонецЕсли;
		
		ЗапросУдаления = "DELETE FROM Operations1C8 WHERE OperDate BETWEEN " + ДатаSQL(ЭтотОбъект.Период.ДатаНачала) + " AND " + ДатаSQL(ЭтотОбъект.Период.ДатаОкончания) + "
						 |AND Company = '" + МатрихКодКомпании + "' AND OperType <> 'Hold'";
		
		Если Не ВыполнитьЗапрос(ЗапросУдаления, Соединение) Тогда
			Возврат 0;
		КонецЕсли;
			
	Иначе
		
		ЗапросSQL = "SELECT CAST (CAST (TransactionId AS DEC(25)) AS NVARCHAR) AS TransactionId FROM Operations1C8 WHERE OperDate BETWEEN " + ДатаSQL(Период.ДатаНачала) + " AND " + ДатаSQL(Период.ДатаОкончания) + "
				    |AND Company = '" + МатрихКодКомпании + "'  AND TransactionId <> 0 AND OperType <> 'Hold'";
		
		НаборЗаписей = Неопределено;
		
		Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение,  НаборЗаписей) Тогда
			Возврат 0;
		Иначе
		 	ТаблицаНомеровСделок = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей);
		КонецЕсли;
		
		//тут происходит закрытие соединение и установка нового.
		//если выполнить SELECT и INSERT в одном соединении с открытием транзакции, то при закрытии транзакции (commit) возникает ошибка: commit transaction request has no corresponding begin transaction
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		Соединение = УстановитьСоединение(ЭтоРПИ);
		
		Если Не ВыполнитьЗапрос("BEGIN TRANSACTION ExportOperations", Соединение) Тогда
			Возврат 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Инд = 0;
	Пока ВыборкаЗаписей.Следующий() Цикл
		
		НомерСделки = ПолучитьНомер(ВыборкаЗаписей.НомерСделки, ВыборкаЗаписей.НомерСтроки, ВыборкаЗаписей.КодСчетаДУ);  // Сразу ПолучитьНомерСделки
		
		Если ПустаяСтрока(НомерСделки) Тогда
			ЗарегистрироватьОшибку("У организации: " + ВыборкаЗаписей.НаименованиеУК + " не выгружена операция т.к. отсутствует TransactionId");
			Продолжить;
		КонецЕсли;
		
		Если Не ТаблицаНомеровСделок = Неопределено Тогда
			Если ПроверитьСделкуКакВыгруженную(НомерСделки, ТаблицаНомеровСделок) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПустаяСтрока(ВыборкаЗаписей.ТипОперации) Тогда
			ЗарегистрироватьОшибку("В 1С8 присутствует новый тип операций. Сделка: " + ВыборкаЗаписей.НомерСделки + " выгружена в Operations1C8 без заполнения поля OperType!");
		КонецЕсли;
		
		Если ПустаяСтрока(ВыборкаЗаписей.КодМатрихКлиентаДУ) Тогда
			ЗарегистрироватьОшибку("Сделка: " + ВыборкаЗаписей.НомерСделки + " не выгружена в Operations1C8. У клиента: " + ВыборкаЗаписей.СчетДУНаименование + " отсутствует код МАТРИХ!");
			Продолжить;
		КонецЕсли;
		
#Область ТЕКСТ_ЗАПРОСА_SQL
		ЗапросSQL =
			"INSERT Operations1C8 (
			|ManagCompany,
			|AgreementNumber,
			|TransactionId,
			|ExchangeName,
			|OperDate,
			|RegDate,
			|OperTime,
			|PaymentDay,
			|OperType,
			|AssetType,
			|RegNumber,
			|MicexCode,
			|Quantity,
			|Price,
			|OperCurrency,
			|OperVolume,
			|ACI,
			|BrokerComission,
			|BrokerComissionCurrency,
			|PaymentBrokerComissionDate,
			|ExchangeComission,
			|ExchangeComissionCurrency,
			|ExchangeBrokerComissionDate,
			|ClientMatrixID,
			|ClientName,                                                 
			|Company,
			|Matrix_AssetID,
			|ClientCode1C,
			|Account,
			|MarketDealCode,
			|isRPS,
			|OperNum,
			|Issuer,
			|IssuerID,
			|BankAccount,
			|BoardCode)
			|VALUES 
			|('"+ СокрЛП(ВыборкаЗаписей.НаименованиеУК) +"',
			|'" + ВыборкаЗаписей.НомерДоговора +"',
			|'" + НомерСделки +"',
			|'" + ВыборкаЗаписей.Биржа +"',
			|"  + ДатаSQL(ВыборкаЗаписей.ДатаОперации) +",
			|"  + ДатаSQL(ВыборкаЗаписей.ДатаПоставки) +",
			|'" + Формат(ВыборкаЗаписей.ДатаОперации, "ДФ=HH:mm:ss") +"',
			|"  + ДатаSQL(ВыборкаЗаписей.ДатаОплаты) +",
			|'" + ВыборкаЗаписей.ТипОперации +"',
			|'" + ВыборкаЗаписей.ВидАктива +"',
			|'" + СокрЛП(ВыборкаЗаписей.НомерГосРегистрации) +"',
			|'" + ВыборкаЗаписей.КодISIN +"',
			|'" + ЧислоSQL(ВыборкаЗаписей.Количество) +"',
			|'" + ЧислоSQL(ВыборкаЗаписей.Цена) +"',
			|'" + ВыборкаЗаписей.ВалютаСделки +"',
			|'" + ЧислоSQL(ВыборкаЗаписей.СуммаСделки) +"',
			|'" + ЧислоSQL(ВыборкаЗаписей.НКД) +"',
			|'" + ЧислоSQL(ВыборкаЗаписей.КомиссияБрокера) +"',
			|'" + ВыборкаЗаписей.ВалютаБрокерскойКомиссии +"',
			|"  + ДатаSQL(ВыборкаЗаписей.ДатаОплатыБрокерскойКомисии) +",
			|'" + ЧислоSQL(ВыборкаЗаписей.ТорговаяКомиссия) +"',
			|'" + ВыборкаЗаписей.ВалютаТорговойКомиссии +"',
			|"  + ДатаSQL(ВыборкаЗаписей.ДатаОплатыТорговойКомиссии) +",
			|'" + ВыборкаЗаписей.КодМатрихКлиентаДУ +"',
			|'" + ВыборкаЗаписей.СчетДУНаименование +"',
			|'" + МатрихКодКомпании +"',
			|'" + ВыборкаЗаписей.КодМатрихЦБ +"',
			|'" + ВыборкаЗаписей.КодСчетаДУ +"',
			|'" + ВыборкаЗаписей.КодУБрокера +"',
			|'" + ВыборкаЗаписей.КодРасчетовНаБирже +"',
			|'" + ВыборкаЗаписей.РежимПереговорныхСделок +"',
			|'" + ВыборкаЗаписей.НомерСделки +"',
			|'" + ВыборкаЗаписей.НаименованиеЭмитента +"',
			|'" + ВыборкаЗаписей.КодМатрихЭмитента +"',
			|'" + ВыборкаЗаписей.РасчетныйСчетНомер +"',
			|'" + ВыборкаЗаписей.КодРежимаБиржевыхТоргов +"')";	
#КонецОбласти
		
		Если ВыполнитьЗапрос(ЗапросSQL, Соединение) Тогда
			Инд = Инд + 1;
		Иначе
			ВыполнитьЗапрос("ROLLBACK TRANSACTION ExportOperations", Соединение);
			Возврат 0;
		КонецЕсли;
					
	КонецЦикла;
	
	ВыполнитьЗапрос("COMMIT TRANSACTION ExportOperations", Соединение);	
				
	Если Не ЭтоРПИ Тогда
		
		//Вызов процедуры проверки дублей 
		ЗапросПроверки = "EXEC P_Operations1C8_cntl @OperDate_beg = " + ДатаSQL(Период.ДатаНачала) + ", @OperDate_end = " + ДатаSQL(Период.ДатаОкончания) + "";
		ВыполнитьЗапрос(ЗапросПроверки, Соединение);
		
	КонецЕсли;
	
	Если Не Соединение = Неопределено Тогда
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	КонецЕсли;
	
	Возврат Инд;
		
КонецФункции

Функция СформироватьДанныеДляСверки()Экспорт
	 
	МассивОрганизаций = Новый Массив;
 
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда		
		МассивОрганизаций.Добавить(ЭтотОбъект.Организация);
	Иначе		
		МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
		МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
		МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст"));
 	КонецЕсли;
		
	ТаблицаСКоличествомОпераций = ПолучитьКоличествоВыгруженныхСделокЗаПериод();
	
	Если ТаблицаСКоличествомОпераций = Неопределено Тогда
		Возврат Неопределено;	
	Конецесли;
	
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	(СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаМинусМесяц
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &КонецПериода
		|	И СчетаДоверительногоУправления.Организация В(&Организация)
		|	И НЕ СчетаДоверительногоУправления.Ссылка В (&Неопределен_Траст, &Неопределен_РЭМ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Организация КАК Организация,
		|	1 КАК Количество,
		|	ОперацииСЦеннымиБумагами.НомерСтроки КАК НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Регистратор.Номер КАК РегистраторНомер,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления.КодСчета КАК СчетДоверительногоУправленияКодСчета
		|ПОМЕСТИТЬ _Операции
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация В(&Организация)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
		|	И (ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ОтменаСделки
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Сделка
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|			ИЛИ ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Маржа)
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДУ.Ссылка
		|			ИЗ
		|				_СчетаДУ КАК _СчетаДУ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(ОстаткиДенежныхСредств.Период, ДЕНЬ),
		|	ОстаткиДенежныхСредств.Организация,
		|	1,
		|	ОстаткиДенежныхСредств.НомерСтроки,
		|	ОстаткиДенежныхСредств.Регистратор.Номер,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления.КодСчета
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
