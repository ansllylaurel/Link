// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Экспорт операций для рисков",
		"0.62",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортОперацийЗаПрошлыйДень", "Экспорт операций за прошлый день",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортОперацийТекущегоДня", "Экспорт операций текущего дня",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "Сверка", "Сверка выгруженных данных",, Ложь, "ВызовСерверногоМетода");
		
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Организация          = ПараметрыКоманды.Организация;
	ПолучателиОповещений = ПараметрыКоманды.ПолучателиОповещения;
	
	УстановитьПериодИВыполнитьКоманду(ИдентификаторКоманды);
	
КонецПроцедуры

Функция УстановитьСоединение(ЭтоРПИ = Неопределено)
	
	Если ЭтоРПИ = Неопределено Тогда
		ЭтоРПИ = (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	КонецЕсли;
	
	//Данные РПИ выгружаем в другую базу.  
	Если ЭтоРПИ Тогда
		СтрокаСоединения = "Driver={SQL Server};Server=AP49.G1.LAN;UID=Risk1C;PWD=Risk1C;Database=Risk_RPI";
	Иначе
		СтрокаСоединения = "Driver={SQL Server};Server=AP18.G1.LAN;UID=Nikolay;PWD=11111;Database=Repository";
	КонецЕсли;

	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
	
	Возврат Соединение;
	
КонецФункции

Функция ВыполнитьЗапрос(ТекстЗапроса, Соединение, НаборЗаписей = Неопределено)
	
	Если Соединение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса, ЭтотОбъект.ДополнительныеСвойства);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
		
КонецФункции

Процедура Timeout(Секунды)
    
    КомандаWindows = "Timeout /T " + Строка(Секунды) + " /NoBreak";
    ЗапуститьПриложение(КомандаWindows, , Истина);
    
КонецПроцедуры

Процедура УстановитьПериодИВыполнитьКоманду(Команда) Экспорт
	
	//Начало сессии
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "/" + Команда;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	КоличествоВыгруженныхОпераций = 0;
	
	Если Команда = "ИнтерактивныйВызов" Тогда
		
		КоличествоВыгруженныхОпераций = ВыгрузитьОперации();
		
	ИначеЕсли Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата())) Тогда
			
		Если Команда = "ЭкспортОперацийТекущегоДня" Тогда
			
			Период.Вариант = ВариантСтандартногоПериода.Сегодня;
			КоличествоВыгруженныхОпераций = ВыгрузитьОперации(Ложь);
			
		ИначеЕсли Команда = "ЭкспортОперацийЗаПрошлыйДень" Тогда
			 //выгружаем данные за предыдущий рабочий день
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаНачала,
			|	ДОБАВИТЬКДАТЕ(&Дата, СЕКУНДА, -1) КАК ДатаОкончания
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Дата < &Дата";
			
			Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
			
			Результат            = Запрос.Выполнить().Выгрузить();
			Период.ДатаНачала    = Результат.Получить(0).ДатаНачала;
			Период.ДатаОкончания = Результат.Получить(0).ДатаОкончания;

			КоличествоВыгруженныхОпераций = ВыгрузитьОперации();
			
		ИначеЕсли Команда = "Сверка" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА &Дата = ПервыйРабочийДеньМесяца.Дата
			|			ТОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -1), МЕСЯЦ)
			|		КОГДА &Дата = ПервыйРабочийДеньНедели.Дата
			|				И &Дата <> ПервыйРабочийДеньМесяца.Дата
			|			ТОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, НЕДЕЛЯ, -1), НЕДЕЛЯ)
			|		ИНАЧЕ NULL
			|	КОНЕЦ КАК ДатаНачала,
			|	ВЫБОР
			|		КОГДА &Дата = ПервыйРабочийДеньМесяца.Дата
			|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -1), МЕСЯЦ)
			|		КОГДА &Дата = ПервыйРабочийДеньНедели.Дата
			|				И &Дата <> ПервыйРабочийДеньМесяца.Дата
			|			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, НЕДЕЛЯ, -1), НЕДЕЛЯ)
			|		ИНАЧЕ NULL
			|	КОНЕЦ КАК ДатаОкончания
			|ПОМЕСТИТЬ _Период
			|ИЗ
			|	(ВЫБРАТЬ
			|		МИНИМУМ(ДанныеКалендаря.Дата) КАК Дата
			|	ИЗ
			|		РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|	ГДЕ
			|		ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|		И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|		И ДанныеКалендаря.Дата >= НАЧАЛОПЕРИОДА(&Дата, НЕДЕЛЯ)) КАК ПервыйРабочийДеньНедели,
			|	(ВЫБРАТЬ
			|		МИНИМУМ(ДанныеКалендаря.Дата) КАК Дата
			|	ИЗ
			|		РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|	ГДЕ
			|		ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|		И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|		И ДанныеКалендаря.Дата >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)) КАК ПервыйРабочийДеньМесяца
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Период.ДатаНачала КАК ДатаНачала,
			|	_Период.ДатаОкончания КАК ДатаОкончания
			|ИЗ
			|	_Период КАК _Период
			|ГДЕ
			|	НЕ _Период.ДатаНачала ЕСТЬ NULL
			|	И НЕ _Период.ДатаОкончания ЕСТЬ NULL";
			
			Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
			
			Если Не Запрос.Выполнить().Пустой() Тогда
				
				ПериодСверки         = Запрос.Выполнить().Выгрузить();
				Период.ДатаНачала    = ПериодСверки.Получить(0).ДатаНачала;
				Период.ДатаОкончания = ПериодСверки.Получить(0).ДатаОкончания;
				
				ДанныеДляСверки = СформироватьДанныеДляСверки();
				
				Если ДанныеДляСверки <> Неопределено И ДанныеДляСверки.Количество() > 0 И ЗначениеЗаполнено(ПолучателиОповещений) Тогда
					СформироватьИОтправитьОтчет(ДанныеДляСверки);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
	//Закрываем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, Новый Структура("Период, КоличествоВыгруженныхОпераций", ЭтотОбъект.Период, КоличествоВыгруженныхОпераций));
		
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;

	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ПолучателиОповещений) Тогда
		СтрокаСообщения = "";
		Для каждого ЭлементМассива Из ЭтотОбъект.ДополнительныеСвойства.Ошибки Цикл
			СтрокаСообщения = СтрокаСообщения + ?(ЗначениеЗаполнено(СтрокаСообщения), Символы.ПС, "") + ЭлементМассива;
		КонецЦикла; 
		ТемаПисьма = "Предупреждение! При выгрузке операций возникли ошибки!";
		РаботаСЭлектроннойПочтой.ОтправитьПростоеЭлектронноеПисьмо(ПолучателиОповещений, ТемаПисьма, СтрокаСообщения);
	КонецЕсли;	
		
КонецПроцедуры

Процедура СформироватьИОтправитьОтчет(Выборка)
	
	ТекстПисьма =""; 
	Пока Выборка.Следующий() Цикл
		ТекстПисьма = ТекстПисьма + 
			"<tr class=""company"">
			|	<td colspan=""3"">" + Выборка.НаименованиеУК + "</td>
			|</tr>";
		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекстПисьма = ТекстПисьма + //&nbsp; 
				"<tr class = """+ ?(ВыборкаДетальныеЗаписи.Количество_1С = ВыборкаДетальныеЗаписи.Количество_SQL, "true","false")+""">
				|	<td>" + Формат(ВыборкаДетальныеЗаписи.Дата, "ДЛФ=Д") + "</td>
				|	<td>" + ВыборкаДетальныеЗаписи.Количество_1С + "</td>
				|	<td>" + ВыборкаДетальныеЗаписи.Количество_SQL + "</td> 
				|</tr>";
		КонецЦикла;
	КонецЦикла;
	
	ТекстПисьма =
	"<html>
	|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
	|	<style>
	|		body {
	|			font: 10pt sans-serif;
	|		}
	|		table {
	|			text-align: center;
	|			border-spacing: 0;
	|			border-collapse: collapse;
	|		}
	|		td {
	|			font-size: 1em;
	|			border: 1px solid black;
	|			padding: 5px 20px 5px 20px;
	|		}
	|		.company {
	|			background: lightgrey;
	|			color: black;
	|			font-size: 14px;
	|		}
	|		.top {
	|			color: black;
	|			font-size: 15px;
	|			background: lightgrey;
	|		}
	|		.true {
	|			color: green;
	|			font-size: 12px;
	|		}
	|		.false {
	|			color: red;
	|			font-size: 12px;
	|		}
	|	</style>
	|</head>
	|<body>
	|Отчет за период с " + Формат(Период.ДатаНачала, "ДЛФ=Д") + " по " + Формат(Период.ДатаОкончания, "ДЛФ=Д") + "
	|<table cols=""3""> 
	|<tr class=""top"">
	|<td rowspan=""2"">Дата</td>
	|<td colspan=""2"">Количество</td>
	|</tr>
	|<tr class=""top"">
	|	<td>1C</td>
	|	<td>SQL</td>
	|</tr>"
	+ ТекстПисьма + "</table></body></html>";
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста",
		ПолучателиОповещений,
		"Отчет по сверке выгруженных операций в Operations_1С8!",
		ТекстПисьма,
		"HTML");
	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	
КонецПроцедуры

Функция ПолучитьКоличествоВыгруженныхСделокЗаПериод()
	
	НаборЗаписей = Неопределено; 
	
	Соединение = УстановитьСоединение();
			
    ЗапросSQL = "SELECT DISTINCT(OperDate),  CAST(Company AS nvarchar(6)) AS Company,  CAST (COUNT(DISTINCT(ID)) AS DEC(5)) AS Operations
 				|FROM [Operations1C8] where OperDate BETWEEN "+ ДатаSQL(Период.ДатаНачала) +" AND "+ ДатаSQL(Период.ДатаОкончания) +"
				|AND Company IN ('227027', '220007', '225420', '222581', '232012') AND OperType <> 'Hold' -- в таблицу так же выгружаются данные УКРИ(223002) 
 				|GROUP BY OperDate,  Company
  				|ORDER BY OperDate";
	
	Если Не ВыполнитьЗапрос(ЗапросSQL, Соединение, НаборЗаписей) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НаборЗаписей = Неопределено Или (НаборЗаписей.EOF И НаборЗаписей.BOF) Тогда
		
		ТаблицаОпераций = Новый ТаблицаЗначений;
		ТаблицаОпераций.Колонки.Добавить("OperDate"	 , Новый ОписаниеТипов("Дата")	, "OperDate");
		ТаблицаОпераций.Колонки.Добавить("Company"   , Новый ОписаниеТипов("Строка"), "Company");
		ТаблицаОпераций.Колонки.Добавить("Operations", Новый ОписаниеТипов("Число") , "Operations");
		
	Иначе
		
		ТипыКолонок = Новый Структура;
		ТипыКолонок.Вставить("OperDate"	 , Новый ОписаниеТипов("Дата"));
		ТипыКолонок.Вставить("Company"   , Новый ОписаниеТипов("Строка"));
		ТипыКолонок.Вставить("Operations", Новый ОписаниеТипов("Число"));
		
		ТаблицаОпераций = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
		
	КонецЕсли;
		
	Возврат ТаблицаОпераций;
	
КонецФункции

Функция ПроверитьСделкуКакВыгруженную(НомерСделки, РанееВыгруженныеСделки)
	
	СтрокаСНомером = РанееВыгруженныеСделки.Найти(НомерСделки, "TransactionId");
	Если СтрокаСНомером = Неопределено Тогда
		НоваяСтрока = РанееВыгруженныеСделки.Добавить();
		НоваяСтрока.TransactionId = НомерСделки;
		Возврат Ложь;
	Иначе
	    Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНомер(ВыборкаНомерСделки, ВыборкаНомерСтроки, КодСчетаДУ)
	
	НомерСделки = ВыборкаНомерСделки;
	НомерСделки = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(НомерСделки);
	ДопКод      = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(КодСчетаДУ);

	Пока Лев(НомерСделки, 1) = "0" Цикл
		НомерСделки = Прав(НомерСделки, СтрДлина(НомерСделки) - 1);
		Продолжить;
	КонецЦикла;
	Если ВыборкаНомерСтроки = 1 Тогда
		Возврат Строка(НомерСделки) + Строка(ДопКод);
	Иначе
		Возврат Строка(ВыборкаНомерСтроки) + Строка(НомерСделки) + Строка(ДопКод);
	КонецЕсли;
					
КонецФункции

Функция ДатаSQL(ДатаВх)
	
	Если ЗначениеЗаполнено(ДатаВх) Тогда
		Возврат "'" + Формат(ДатаВх, "ДФ=ггггММдд") + "'"; // "ДФ=yyyy-MM-dd","ДЛФ=Д"
	Иначе
		Возврат "NULL";
	КонецЕсли;
	
КонецФункции

Функция ЧислоSQL(ЧислоВх)
	
	ЧислоSQL = Формат(ЧислоВх, "ЧРД=.; ЧГ=0");
	Если ПустаяСтрока(ЧислоSQL) Тогда
		Возврат "0";
	КонецЕсли;
	Возврат ЧислоSQL;               
	
КонецФункции

Функция ВыгрузитьОперации(ФлагУдаления = Истина)
			
	ТаблицаНомеровСделок = Неопределено;
		
	ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Организация.ЮрФизЛицо);
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	НЕ ИменованныйОбъектРПИ.Объект ЕСТЬ NULL КАК ЭтоРПИ
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				И Объект = &ЮрЛицо) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныйОбъектРПИ
		|		ПО (КодыВоВнешнихСистемахСрезПоследних.Объект = ВЫРАЗИТЬ(ИменованныйОбъектРПИ.Объект КАК Справочник.Организации).ЮрФизЛицо)
		|			И (ИменованныйОбъектРПИ.Имя = ""Организация_РПИ"")";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ЮрЛицо", ?(ЗначениеЗаполнено(ГоловнаяОрганизация), ГоловнаяОрганизация, Организация.ЮрФизЛицо));
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗарегистрироватьОшибку("Не удалось выполнить запрос к базе 1С." + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		МатрихКодКомпании = СокрЛП(Выборка.Код);
		ЭтоРПИ            = Выборка.ЭтоРПИ;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(МатрихКодКомпании) Тогда
		ЗарегистрироватьОшибку("Не удалось получить код Матрикс для юр.лица компании: " + Организация.ЮрФизЛицо.Наименование + "!");
		Возврат 0;	
	КонецЕсли;
			 
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	(СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаМинусМесяц
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &КонецПериода
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И НЕ СчетаДоверительногоУправления.Ссылка В (&Неопределен_Траст, &Неопределен_РЭМ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаОперации,
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОперацииСЦеннымиБумагами.Регистратор.МестоХранения КАК МестоХранения,
		|	ДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаОплатыТорговойКомиссии,
		|	СУММА(РасходыПоТорговойКомиссии.СуммаОборот) КАК СуммаТорговойКомиссии,
		|	ДатыОплатБрокерскойКомиссии.ДатаОплаты КАК ДатаОплатыБрокерскойКомисии,
		|	СУММА(РасходыПоБрокерскойКомиссии.СуммаОборот) КАК СуммаБрокерскойКомиссии,
		|	ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая КАК ДатаПоставки,
		|	ОперацииСЦеннымиБумагами.ДатаОплатыПлановая КАК ДатаОплаты,
		|	СУММА(ОперацииСЦеннымиБумагами.Количество) КАК Количество,
		|	СРЕДНЕЕ(ВЫБОР
		|			КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|				ТОГДА ВыводЦенныхБумагЦенныеБумаги.ЦенаКотировки
		|			ИНАЧЕ ОперацииСЦеннымиБумагами.Цена
		|		КОНЕЦ) КАК Цена,
		|	СУММА(ВЫБОР
		|			КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Маржа
		|					И ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|				ТОГДА -ОперацииСЦеннымиБумагами.Сумма
		|			КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|				ТОГДА ВыводЦенныхБумагЦенныеБумаги.СуммаРынок
		|			ИНАЧЕ ОперацииСЦеннымиБумагами.Сумма
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|				ТОГДА ВыводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок
		|			ИНАЧЕ ОперацииСЦеннымиБумагами.СуммаКупона
		|		КОНЕЦ) КАК СуммаКупона,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|			ТОГДА ВыводЦенныхБумагЦенныеБумаги.ВалютаКотировки
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.Валюта
		|	КОНЕЦ КАК ВалютаСделки,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаТорговойКомиссии,
		|	РасходыПоБрокерскойКомиссии.Валюта КАК ВалютаБрокерскойКомиссии,
		|	NULL КАК РасчетныйСчетНомер,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Маржа
		|			ТОГДА ""Вариационная маржа""
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|			ТОГДА ""Вывод ЦБ""
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.ОтменаСделки
		|			ТОГДА ""Отмена сделки""
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.Сделка
		|			ТОГДА ВЫБОР
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|						ТОГДА ""Покупка""
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|						ТОГДА ""Продажа""
		|				КОНЕЦ
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ВЫБОР
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|							И ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 1
		|						ТОГДА ""Обратное_репо_1""
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|							И ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 1
		|						ТОГДА ""Прямое_репо_1""
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|							И ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 2
		|						ТОГДА ""Прямое_репо_2""
		|					КОГДА ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|							И ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 2
		|						ТОГДА ""Обратное_репо_2""
		|				КОНЕЦ
		|	КОНЕЦ КАК ТипОперации,
		|	ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|	ОперацииСЦеннымиБумагами.Организация.ЮрФизЛицо КАК ОрганизацияЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.Регистратор.НомерСделки = """"
		|				ИЛИ ОперацииСЦеннымиБумагами.Регистратор.НомерСделки ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ОперацииСЦеннымиБумагами.Регистратор.НомерСделкиСЦентральнымКонтрагентом = """"
		|							ИЛИ ОперацииСЦеннымиБумагами.Регистратор.НомерСделкиСЦентральнымКонтрагентом ЕСТЬ NULL
		|						ТОГДА ОперацииСЦеннымиБумагами.Регистратор.Номер
		|					ИНАЧЕ ОперацииСЦеннымиБумагами.Регистратор.НомерСделкиСЦентральнымКонтрагентом
		|				КОНЕЦ
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.Регистратор.НомерСделки
		|	КОНЕЦ КАК НомерСделки,
		|	ОперацииСЦеннымиБумагами.Регистратор.Брокер КАК Брокер,
		|	ОперацииСЦеннымиБумагами.Регистратор.КодРасчетовНаБирже КАК РегистраторКодРасчетовНаБирже,
		|	ОперацииСЦеннымиБумагами.Регистратор.РежимПереговорныхСделок КАК РегистраторРежимПереговорныхСделок,
		|	ОперацииСЦеннымиБумагами.НомерСтроки КАК НомерСтроки,
		|	РежимыБиржевыхТоргов.Код КАК КодРежимаБиржевыхТоргов
		|ПОМЕСТИТЬ _Операции
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&НачалоПериода,
		|				,
		|				Регистратор,
		|				Организация = &Организация
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоТорговойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&КонецПериода,
		|					Организация = &Организация
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК ДатыОплатТорговойКомиссии
		|			ПО РасходыПоТорговойКомиссии.Сделка = ДатыОплатТорговойКомиссии.Основание
		|				И РасходыПоТорговойКомиссии.Валюта = ДатыОплатТорговойКомиссии.Валюта
		|		ПО (ВЫБОР
		|				КОГДА ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО = 2
		|					ТОГДА ОперацииСЦеннымиБумагами.Основание = РасходыПоТорговойКомиссии.Сделка
		|				ИНАЧЕ ОперацииСЦеннымиБумагами.Регистратор = РасходыПоТорговойКомиссии.Сделка
		|			КОНЕЦ)
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = РасходыПоТорговойКомиссии.ЦеннаяБумага
		|			И (НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) = НАЧАЛОПЕРИОДА(РасходыПоТорговойКомиссии.Период, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&НачалоПериода,
		|				,
		|				Регистратор,
		|				Организация = &Организация
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоБрокерскойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&КонецПериода,
		|					Организация = &Организация
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК ДатыОплатБрокерскойКомиссии
		|			ПО РасходыПоБрокерскойКомиссии.Сделка = ДатыОплатБрокерскойКомиссии.Основание
