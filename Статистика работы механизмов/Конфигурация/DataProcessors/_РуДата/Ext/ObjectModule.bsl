
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Тестирование подключения к RU DATA",
		"0.01",
		"",
		Истина);
		
	// Команды
	
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция СоединениеРуДата(Сервер)
	
	Возврат Новый HTTPСоединение(Сервер, 443, , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
КонецФункции

Функция УчетнаяЗаписьJson(Логин, Пароль)
	
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	
	УчетнаяЗапись = Новый Структура;
	УчетнаяЗапись.Вставить("login", Логин);
	УчетнаяЗапись.Вставить("password", Пароль);
	
	ЗаписатьJSON(Запись, УчетнаяЗапись);
	
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ЗапросТокена(Логин, Пароль)
	
	Запрос = ЗапросРудата();
	
	Запрос.АдресРесурса = "/v2/Account/Login";
	Запрос.УстановитьТелоИзСтроки(УчетнаяЗаписьJson(Логин, Пароль), КодировкаТекста.UTF8);
	
	Возврат Запрос;
	
КонецФункции

Процедура ПолучитьТокен(Сервер, Логин, Пароль) Экспорт
	
	Соединение = СоединениеРуДата(Сервер);
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросТокена(Логин, Пароль));
		Если Ответ.КодСостояния = 200 Тогда
			Результат = ОбъектИзОтвета(Ответ);
			Токен = Результат["token"];
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция СтрокаJson(Структура)
	
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	ЗаписатьJSON(Запись, Структура, Настройки);
	
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ЗапросРудата(Токен = Неопределено)
	
	Запрос = Новый HTTPЗапрос;
	
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	Если Токен <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ЗапросИстории(Токен, ПараметрыЗапроса)
	
	ПараметрыЗапросаJson = СтрокаJson(ПараметрыЗапроса);
	Запрос = ЗапросРудата(Токен);
	Запрос.АдресРесурса = "/v2/Moex/History";
	Запрос.УстановитьТелоИзСтроки(ПараметрыЗапросаJson, КодировкаТекста.UTF8);
	
	Возврат Запрос;
	
КонецФункции

Функция МассивЗначений(Значение) Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
	
КонецФункции

Функция ОбъектИзОтвета(Ответ, ПрочитатьВСоответствие = Истина, ИменаСвойствСоЗначениямиДата = "tradedate")
	
	МассивСвойствСоЗначениямиДата =
		?(ИменаСвойствСоЗначениямиДата = Неопределено,
			Неопределено,
			СтрРазделить(ИменаСвойствСоЗначениямиДата, ", ", Ложь));		
	
	Чтение = Новый ЧтениеJSON();
	
	Чтение.ОткрытьПоток(Ответ.ПолучитьТелоКакПоток());
	
	Возврат ПрочитатьJSON(Чтение, ПрочитатьВСоответствие, МассивСвойствСоЗначениямиДата, ФорматДатыJSON.ISO);
	
КонецФункции

Функция ТаблицаИсторииИзМассива(Массив)
	
	Таблица = Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("secid");
	Таблица.Колонки.Добавить("boardid");
	Таблица.Колонки.Добавить("isin");
	Таблица.Колонки.Добавить("shortname");
	Таблица.Колонки.Добавить("tradedate");
	Таблица.Колонки.Добавить("open");
	Таблица.Колонки.Добавить("high");
	Таблица.Колонки.Добавить("low");
	Таблица.Колонки.Добавить("close");
	
	Для каждого Элемент Из Массив Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.secid = Элемент["secid"];
		СтрокаТаблицы.boardid = Элемент["boardid"];
		СтрокаТаблицы.isin = Элемент["isin"];
		СтрокаТаблицы.shortname = Элемент["shortname"];
		СтрокаТаблицы.tradedate = Элемент["tradedate"];
		СтрокаТаблицы.open = Элемент["open"];
		СтрокаТаблицы.high = Элемент["high"];
		СтрокаТаблицы.low = Элемент["low"];
		СтрокаТаблицы.close = Элемент["close"];
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция История(Сервер, Параметры) Экспорт
	
	Соединение = СоединениеРуДата(Сервер);
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросИстории(Токен, Параметры));
		Если Ответ.КодСостояния = 200 Тогда
			Результат = ОбъектИзОтвета(Ответ);
			Сообщить("Ответ = " + Результат);
			Возврат ТаблицаИсторииИзМассива(Результат);
		Иначе
			Сообщить("Ошибка при запросе истории по инструменту. Код ответа = " + Ответ.КодСостояния);
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

