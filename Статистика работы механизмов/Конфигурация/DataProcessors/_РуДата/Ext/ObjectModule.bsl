		|yield_cwa	number(decimal(16,8))		Доходность текущая по средневзвешенной
		|yield_high	number(decimal(16,8))		Максимальная доходность
		|yield_low	number(decimal(16,8))		Минимальная доходность
		|yield_o_cwa	number(decimal(16,8))		Доходность к оферте текущая по средневзвешенной
		|yield_o_swa	number(decimal(16,8))		Доходность к оферте простая по средневзвешенной
		|yield_open	number(decimal(16,8))		Доходность первой сделки
		|yield_prev	number(decimal(16,8))		Доходность к погашению по цене пред. дня
		|yield_swa	number(decimal(16,8))		Доходность простая по средневзвешенной
		|z_spread_ofz	number(decimal(20,8))		Z-спрэд к ОФЗ";
	
	#КонецОбласти
	
	МассивСтрок = СтрРазделить(СтрокаОписания, Символы.ПС, Ложь);
	
	Для каждого СтрокаПоля Из МассивСтрок Цикл
		
		// ИмяПоля [Таб] ТипПоля [Таб] Описание
		
		Свойства = СтрРазделить(СтрокаПоля, Символы.Таб, Ложь);
		
		Поле		= Свойства[0];
		Описание	= ?(Свойства.Количество() > 2, Свойства[2], ""); 
		
		ОписаниеРезультата.Добавить(Поле, Описание); 
		
	КонецЦикла;
	
	Возврат ОписаниеРезультата;
	
КонецФункции

// Получить данные о торгах за указанный период
Функция ДанныеОТоргах(Сервер, ПараметрыЗапроса, ОписаниеРезультата = Неопределено) Экспорт
	
	РезультатФункции = Неопределено;
	
	ПрефиксОшибки = "Ошибка получения данных о торгах. ";
	
	Попытка
		
		Запрос = ЗапросРудата(Токен);
		
		Запрос.АдресРесурса = "/v2/Archive/History";
		Запрос.УстановитьТелоИзСтроки(СтрокаJson(ПараметрыЗапроса), КодировкаТекста.UTF8);
		
		Соединение = СоединениеРуДата(Сервер);
		
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Результат = ОбъектИзОтвета(Ответ, Ложь);

			РезультатФункции = ТаблицаЗначенийИзМассиваСтруктур(Результат);
			
		Иначе
			
			Сообщить(ПрефиксОшибки + "Код ответа = " + Ответ.КодСостояния);
			
		КонецЕсли;
		
	Исключение
		
		Сообщить(ПрефиксОшибки + ОписаниеОшибки());
		
	КонецПопытки;
	
	// Формируем описание полей результата
	
	Если РезультатФункции <> Неопределено И ОписаниеРезультата <> Неопределено Тогда
		
		ОжидаемыеПоля = ПолучитьОписаниеРезультатаЗапросаДанныхПоРезультатамТоргов();
		
		Для Каждого Колонка Из РезультатФункции.Колонки Цикл
			
			ОписаниеПоля = ОжидаемыеПоля.НайтиПоЗначению(Колонка.Имя); 
			
			ОписаниеРезультата.Добавить(Колонка.Имя, ?(ОписаниеПоля = Неопределено, Неопределено, ОписаниеПоля.Представление));	
			
		КонецЦикла;	
			
	КонецЕсли;
	
	Возврат РезультатФункции;	
	
КонецФункции

Функция ТаблицаЗначенийИзМассиваСтруктур(Массив)
	
	Таблица = Новый ТаблицаЗначений;
	
	Если Массив.Количество() > 0 Тогда
		
		Структура = Массив[0]; 
	
		Для Каждого Элемент Из Структура Цикл
			Таблица.Колонки.Добавить(Элемент.Ключ);
		КонецЦикла; 
		
		Для Каждого Элемент Из Массив Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Элемент); 
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции
