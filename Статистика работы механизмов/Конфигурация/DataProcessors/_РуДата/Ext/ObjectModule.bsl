// Получить иерархию торговых площадок/источников, используемых Интерфакс
Функция ТорговыеПлощадки(Сервер) Экспорт
	
	РезультатФункции = Неопределено;
	
	ПрефиксОшибки = "Ошибка получения списка торговых площадок, используемых Интерфакс. ";
	
	Попытка
		
		Запрос = ЗапросРудата(Токен);
		
		Запрос.АдресРесурса = "/v2/Info/ExchangeTree";
		
		Соединение = СоединениеРуДата(Сервер);
		
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Результат = ОбъектИзОтвета(Ответ, Ложь, "update_date");

			РезультатФункции = ТаблицаЗначенийИзМассиваСтруктур(Результат);
			
		Иначе
			
			Сообщить(ПрефиксОшибки + "Код ответа = " + Ответ.КодСостояния);
			
		КонецЕсли;
		
	Исключение
		
		Сообщить(ПрефиксОшибки + ОписаниеОшибки());
		
	КонецПопытки;
		
	Возврат РезультатФункции;
	
КонецФункции

// Получить данные по результатам торгов на заданную дату:
//
// Результат:
//
Функция ДанныеПоРезультатамТоргов(Сервер, ПараметрыЗапроса, ОписаниеРезультата = Неопределено) Экспорт 
	
	РезультатФункции = Неопределено;
	
	ПрефиксОшибки = "Ошибка получения данных по результатам торгов на заданную дату. ";
	
	Попытка
		
		Запрос = ЗапросРудата(Токен);
		
		Запрос.АдресРесурса = "/v2/Archive/EndOfDay";
		Запрос.УстановитьТелоИзСтроки(СтрокаJson(ПараметрыЗапроса), КодировкаТекста.UTF8);
		
		Соединение = СоединениеРуДата(Сервер);
		
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			
			Результат = ОбъектИзОтвета(Ответ, Ложь, "time");

			РезультатФункции = ТаблицаЗначенийИзМассиваСтруктур(Результат);
			
		Иначе
			
			Сообщить(ПрефиксОшибки + "Код ответа = " + Ответ.КодСостояния);
			
		КонецЕсли;
		
	Исключение
		
		Сообщить(ПрефиксОшибки + ОписаниеОшибки());
		
	КонецПопытки;
	
	// Формируем описание полей результата
	
	Если РезультатФункции <> Неопределено И ОписаниеРезультата <> Неопределено Тогда
		
		ОжидаемыеПоля = ПолучитьОписаниеРезультатаЗапросаДанныхПоРезультатамТоргов();
		
		Для Каждого Колонка Из РезультатФункции.Колонки Цикл
			
			ОписаниеПоля = ОжидаемыеПоля.НайтиПоЗначению(Колонка.Имя); 
			
			ОписаниеРезультата.Добавить(Колонка.Имя, ?(ОписаниеПоля = Неопределено, Неопределено, ОписаниеПоля.Представление));	
			
		КонецЦикла;	
			
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьОписаниеРезультатаЗапросаДанныхПоРезультатамТоргов()
	
	ОписаниеРезультата = Новый СписокЗначений;
	
	#Область Строка_описания	
	
	СтрокаОписания =
		"accruedint	number(decimal(20,8))		Накопленный купонный доход (= ставка купона * количество дней с момента начала очередного купонного периода)
		|admquote	number(decimal(16,8))		Признаваемая котировка, рассчитываемая в соответствии Положением о порядке и сроках определения стоимости чистых активов акционерных инвестиционных фондов, стоимости чистых активов паевых инвестиционных фондов, расчетной стоимости инвестиционных паев паевых инвестиционных фондов, а также стоимости чистых активов акционерных инвестиционных фондов в расчете на одну акцию (утв. приказом Федеральной службы по финансовым рынкам от 15 июня 2005 г. № 05-21/пз-н)
