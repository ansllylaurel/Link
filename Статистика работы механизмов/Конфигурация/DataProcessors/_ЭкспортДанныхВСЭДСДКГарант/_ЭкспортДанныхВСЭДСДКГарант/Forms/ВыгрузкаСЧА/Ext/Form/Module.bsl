&НаСервере
Функция СформироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов, Ответственный) Экспорт
	
	СтруктураОтветственного = Новый Структура("Объект, Язык, Подразделение, КонтактноеЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"), Справочники.Языки.Русский, Справочники.Подразделения.ГруппаКомпаний, Ответственный);
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураОтветственного);
	
	ПодписантДолжность = СтруктураДанныхКонтактногоЛица.Должность;

	// Подготовим параметры для передачи в обработку выгрузки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ФинансовыеПоказатели.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
	|ГДЕ
	|	ФинансовыеПоказатели.Период = &Период
	|	И ФинансовыеПоказатели.Организация = &Организация
	|	И (ВЫРАЗИТЬ(ФинансовыеПоказатели.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления)) = &СчетДоверительногоУправления
	|	И ТИПЗНАЧЕНИЯ(ФинансовыеПоказатели.Регистратор) = ТИП(Документ.РегистрацияСтоимостиАктивов)";
	
	Запрос.УстановитьПараметр("Период", 					  Период);
	Запрос.УстановитьПараметр("Организация", 				  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ТекДокумент = Выборка.Регистратор;
		ОбработкаВыгрузки = Обработки.ПечатьИВыгрузка_СЧА_РСА.Создать();  		
		ОбработкаВыгрузки.ДатаИВремяФормирования = ТекущаяДата();
		
		// С 01.07.2019 - в рублях и копейках
		Если Период >= '20190628' Тогда
			Разрядность = 2;
		Иначе
			Разрядность = 5;
		КонецЕсли;	
				
		// сформируем файл данных
		ПолноеИмяФайла = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + "(расчет СЧА) " + Формат(Период, "ДФ=dd.MM.yyyy") + ".csv";
	
		МассивДокументов = Новый Массив;			
		МассивДокументов.Добавить(ТекДокумент);
			
		Результат = ОбработкаВыгрузки.ПолучитьВыгрузкиСЧА_СДКГарант(МассивДокументов, Разрядность, Ответственный, ПодписантДолжность);

		Если Результат.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Попытка
			Результат[0].ТекстОтчета.Записать(ПолноеИмяФайла, "windows-1251");		
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки СЧА по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции
#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

