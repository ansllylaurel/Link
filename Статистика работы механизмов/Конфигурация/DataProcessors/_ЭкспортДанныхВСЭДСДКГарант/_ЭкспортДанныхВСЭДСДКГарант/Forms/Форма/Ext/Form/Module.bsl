
&НаКлиенте
Процедура ОчиститьКаталогиФорм()
	
	ИменаКаталогов = Новый Массив;
	
	Для Каждого Элемент Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
				
		Если ЭтаФорма[Элемент.Значение] Тогда
			
			Если Элемент.Значение = "ФормаУведомленияОНамеренииРазмещенияДепозита" Тогда
				ИменаКаталогов.Добавить("Уведомления о намерении размещения депозитов");
			ИначеЕсли Элемент.Значение = "ФормаПереводыСоСчетовБрокераНаРасчетныеСчета" Тогда 
				ИменаКаталогов.Добавить("Переводы со счетов брокера");
			Иначе
				ИменаКаталогов.Добавить(Элемент.Представление);
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
		
	Для Каждого Элемент Из ИменаКаталогов Цикл	
				
		КаталогФайловФормы = Объект.КаталогФайлов + ?(Прав(Объект.КаталогФайлов, 1) = "\", "", "\") + Элемент;
		
		НайденныеФайлы = НайтиФайлы(КаталогФайловФормы, "*.csv", Ложь);
		
		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
			
			Попытка
				УдалитьФайлы(НайденныйФайл.ПолноеИмя);
			Исключение
				Сообщить("Не удалось удалить файл " + НайденныйФайл.ПолноеИмя + ". Система сообщает " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктивныеСчетаДоверительногоУправления()
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Очистить();
	Запрос = Новый Запрос;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДУ
		|ПОМЕСТИТЬ _СчетаСпецдепаСдкГарант
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.СпециализированныйДепозитарий.СистемаЭлектронногоДокументооборота = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.СЭД_СДК_Гарант)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &Период
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Флажок,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаВыпискаВФормате1С) КАК ФормаВыпискаВФормате1С,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаОтчетБрокера) КАК ФормаОтчетБрокера,
		|	МАКСИМУМ(ВложенныйЗапрос.МНО) КАК МНО,
		|	МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаСЧА) КАК ВыгрузкаСЧА,
		|	МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаРСА) КАК ВыгрузкаРСА,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленияОНамеренииРазмещенияДепозита) КАК ФормаУведомленияОНамеренииРазмещенияДепозита,
		|	МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаРасшифровкиРасчетаРезервов) КАК ВыгрузкаРасшифровкиРасчетаРезервов,
		|	МАКСИМУМ(ВложенныйЗапрос.ФормаПереводыСоСчетовБрокераНаРасчетныеСчета) КАК ФормаПереводыСоСчетовБрокераНаРасчетныеСчета,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	(ВЫБРАТЬ
		|		ИСТИНА КАК ФормаВыпискаВФормате1С,
		|		ЛОЖЬ КАК ФормаОтчетБрокера,
		|		ЛОЖЬ КАК МНО,
		|		ЛОЖЬ КАК ВыгрузкаСЧА,
		|		ЛОЖЬ КАК ВыгрузкаРСА,
		|		ЛОЖЬ КАК ФормаУведомленияОНамеренииРазмещенияДепозита,
		|		ЛОЖЬ КАК ВыгрузкаРасшифровкиРасчетаРезервов,
		|		ЛОЖЬ КАК ФормаПереводыСоСчетовБрокераНаРасчетныеСчета,
		|		_СчетаСпецдепаСдкГарант.Ссылка КАК СчетДоверительногоУправления
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|			ПО (&ФормаВыпискаВФормате1С)
		|				И (ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
		|				И (_СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))
		|				И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Период
		|					ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|				И (ВЫРАЗИТЬ(ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК Справочник.БанковскиеСчета).ДатаЗакрытия >= &Период
		|					ИЛИ ВЫРАЗИТЬ(ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК Справочник.БанковскиеСчета).ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|			ПО (&ФормаОтчетБрокера)
		|				И (ИсполнителиПоДенежнымСредствамБрокерские.Организация = &Организация)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления
		|				И (_СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))
		|				И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &Период
		|					ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|				И (ВЫРАЗИТЬ(ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет КАК Справочник.БанковскиеСчета).ДатаЗакрытия >= &Период
		|					ИЛИ ВЫРАЗИТЬ(ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет КАК Справочник.БанковскиеСчета).ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК РаспоряжениеНаМНО
		|			ПО (&МНО)
		|				И (НАЧАЛОПЕРИОДА(РаспоряжениеНаМНО.Дата, ДЕНЬ) = &Период)
		|				И (РаспоряжениеНаМНО.Организация = &Организация)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = РаспоряжениеНаМНО.СчетДоверительногоУправления
		|				И (РаспоряжениеНаМНО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО))
		|				И (НЕ РаспоряжениеНаМНО.ПометкаУдаления)
		|				И (_СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
		|					ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов))
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		&ВыгрузкаСЧА,
		|		&ВыгрузкаРСА,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|	ГДЕ
		|		(&ВыгрузкаСЧА
		|				ИЛИ &ВыгрузкаРСА)
		|		И (_СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|				ИЛИ _СчетаСпецдепаСдкГарант.ВидДоговораДУ = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами))
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжение
		|			ПО (&ФормаУведомленияОНамеренииРазмещенияДепозита)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = Распоряжение.СчетДоверительногоУправления
		|				И (НАЧАЛОПЕРИОДА(Распоряжение.ДатаРазмещения, ДЕНЬ) = &Период)
		|				И (Распоряжение.Организация = &Организация)
		|				И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента))
		|				И (НЕ Распоряжение.ПометкаУдаления)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		ЛОЖЬ,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
		|			ПО (&ВыгрузкаРасшифровкиРасчетаРезервов)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = НачислениеСписаниеРезервов.СчетДоверительногоУправления
		|				И (НачислениеСписаниеРезервов.Организация = &Организация)
		|				И (НАЧАЛОПЕРИОДА(НачислениеСписаниеРезервов.Дата, ДЕНЬ) = &Период)
		|				И (НачислениеСписаниеРезервов.Проведен)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ЛОЖЬ,
		|		ИСТИНА,
		|		_СчетаСпецдепаСдкГарант.Ссылка
		|	ИЗ
		|		_СчетаСпецдепаСдкГарант КАК _СчетаСпецдепаСдкГарант
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|			ПО (&ФормаПереводыСоСчетовБрокераНаРасчетныеСчета)
		|				И _СчетаСпецдепаСдкГарант.Ссылка = ДокПоручение.СчетДоверительногоУправления
		|				И (ДокПоручение.Организация = &Организация)
		|				И (НАЧАЛОПЕРИОДА(ДокПоручение.Дата, ДЕНЬ) = &Период)
		|				И (ДокПоручение.Проведен)
		|				И (ДокПоручение.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|				И (ДокПоручение.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних КАК НастройкиАкцептованияОперацийСрезПоследних
		|			ПО (ДокПоручение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация)
		|				И (ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления)
		|				И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|	ГДЕ
		|		ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.СчетДоверительногоУправления
		|
		|ИМЕЮЩИЕ
		|	(МАКСИМУМ(ВложенныйЗапрос.ФормаВыпискаВФормате1С) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаОтчетБрокера) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.МНО) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаСЧА) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаРСА) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаУведомленияОНамеренииРазмещенияДепозита) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ВыгрузкаРасшифровкиРасчетаРезервов) = ИСТИНА
		|		ИЛИ МАКСИМУМ(ВложенныйЗапрос.ФормаПереводыСоСчетовБрокераНаРасчетныеСчета) = ИСТИНА)";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	
	Запрос.УстановитьПараметр("ФормаВыпискаВФормате1С", ЭтаФорма.ФормаВыпискаВФормате1С);
	Запрос.УстановитьПараметр("ФормаОтчетБрокера", ЭтаФорма.ФормаОтчетБрокера);
	Запрос.УстановитьПараметр("МНО", ЭтаФорма.МНО);
	Запрос.УстановитьПараметр("ВыгрузкаСЧА", ЭтаФорма.ВыгрузкаСЧА);
	Запрос.УстановитьПараметр("ВыгрузкаРСА", ЭтаФорма.ВыгрузкаРСА);
	Запрос.УстановитьПараметр("ФормаУведомленияОНамеренииРазмещенияДепозита", ЭтаФорма.ФормаУведомленияОНамеренииРазмещенияДепозита);
	Запрос.УстановитьПараметр("ВыгрузкаРасшифровкиРасчетаРезервов", ЭтаФорма.ВыгрузкаРасшифровкиРасчетаРезервов);
	Запрос.УстановитьПараметр("ФормаПереводыСоСчетовБрокераНаРасчетныеСчета", ЭтаФорма.ФормаПереводыСоСчетовБрокераНаРасчетныеСчета);

	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭтаФорма.АктивныеСчетаДоверительногоУправления.Сортировать("СчетДоверительногоУправления");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ФлажкиФормПриИзменении(Элемент)
	
	ОбновитьАктивныеСчетаДоверительногоУправления();
	
	НастроитьВидимостьИДоступность(Элемент);
	
КонецПроцедуры

&НаСервере
Функция ОтветственныеЛицаОрганизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО Организации.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо");
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		Объект.Период        = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
		Объект.КаталогФайлов = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._ЭкспортДанныхВСЭДСДКГарант.ШаблонКаталогаФайлов", Объект.Организация, Объект.Период, Объект.КаталогФайлов);
	Иначе
		Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");		
		Объект.КаталогФайлов = "\\ap69\Developers\Саня\xml\";
	КонецЕсли;
	
	Элементы.ОтветственноеЛицо.СписокВыбора.ЗагрузитьЗначения(ОтветственныеЛицаОрганизации());   	
	
	Для Каждого Форма Из РеквизитФормыВЗначение("Объект").Метаданные().Формы Цикл
		
		Если Форма.Имя <> "Форма" Тогда
			ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить(Форма.Имя, Форма.Синоним);
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаУведомленияОНамеренииРазмещенияДепозита", "Уведомления о намерении размещения депозитов");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаПереводыСоСчетовБрокераНаРасчетныеСчета", "Уведомления о переводах со счетов брокера на р/с");
	
	// создадим реквизиты формы
	НовыеРеквизитыФормы = Новый Массив;
	
	Для Каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево")));
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево"), "АктивныеСчетаДоверительногоУправления"));
			
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, Новый Массив);
	
	// создадим элементы управления, соотв. новым реквизитам формы
	Для Индекс = 0 По ЭтаФорма.ФормыПервичныхДокументовСЭД.Количество() - 1 Цикл
		
		ФормаПервичныхДокументовСЭД = ЭтаФорма.ФормыПервичныхДокументовСЭД[Индекс]; 
		
		ПолеФлажкаФормы = Элементы.Добавить(ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), ?(Индекс < 4, Элементы.ГруппаФормыПерваяКолонка, Элементы.ГруппаФормыВтораяКолонка));
		ПолеФлажкаФормы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаФормы.ПутьКДанным        = ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаФормы.Заголовок          = ФормаПервичныхДокументовСЭД.Представление;
		ПолеФлажкаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		
		ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ФлажкиФормПриИзменении");
		
		ПолеФлажкаТаблицы = Элементы.Вставить("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.АктивныеСчетаДоверительногоУправления, Элементы.АктивныеСчетаДоверительногоУправленияФлажок);
		ПолеФлажкаТаблицы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаТаблицы.ПутьКДанным        = "АктивныеСчетаДоверительногоУправления." + ФормаПервичныхДокументовСЭД.Значение;
		
		ТекЗаголовок = "";
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаУведомленияОНамеренииРазмещенияДепозита" Тогда
			ТекЗаголовок = "Уведомления"; 	
		ИначеЕсли ФормаПервичныхДокументовСЭД.Значение = "ФормаПереводыСоСчетовБрокераНаРасчетныеСчета" Тогда
			ТекЗаголовок = "Переводы"; 	
		Иначе	
			ТекЗаголовок = ФормаПервичныхДокументовСЭД.Представление;	
		КонецЕсли;
		
		ПолеФлажкаТаблицы.Заголовок          = ТекЗаголовок;
		ПолеФлажкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажкаТаблицы.ТолькоПросмотр     = Истина;
		
		ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = Истина;
		
	КонецЦикла;
	
	ОбновитьАктивныеСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьИДоступность()
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьИДоступность(Элемент = Неопределено)
	
	Если Элемент = Неопределено Тогда
		
		Для Каждого ФормаПервичныхДокументов Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
			Элементы["АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументов.Значение].Видимость = ЭтаФорма[ФормаПервичныхДокументов.Значение];
		КонецЦикла;
	
	Иначе
		Элементы["АктивныеСчетаДоверительногоУправления" + Элемент.Имя].Видимость = ЭтаФорма[Элемент.Имя];	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	 ОбновитьАктивныеСчетаДоверительногоУправления();
	
КонецПроцедуры

&НаКлиенте
Процедура АктивныеСчетаДоверительногоУправленияПередНачаломИзменения(Элемент, Отказ)

	ТекущиеДанные = Элементы.АктивныеСчетаДоверительногоУправления.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.АктивныеСчетаДоверительногоУправления.ТекущийЭлемент = Элементы.АктивныеСчетаДоверительногоУправленияСчетДоверительногоУправления Тогда
		Отказ = Истина;
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбора.Каталог = Объект.КаталогФайлов;
	
	Если ДиалогВыбора.Выбрать() Тогда
		Объект.КаталогФайлов = ДиалогВыбора.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновить");
	Попытка
		ОбновитьАктивныеСчетаДоверительногоУправления();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	Попытка
		ВыполнитьЭкспорт(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт(ПараметрыСессии)
	
	ОчиститьКаталогиФорм();
	
	МассивСчетовПоДепозитам = Новый Массив;
	МассивСчетовПоПереводам = Новый Массив;
	
	Для Каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
		
		Если Не СтрокаАктивныеСчетаДоверительногоУправления.Флажок Тогда
			Продолжить;
		КонецЕсли;
		
		Отказ = Ложь;
		
		РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогФайлов, Отказ);
		
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка отменена");
			ПараметрыСессии.ТекстОшибки = "Выгрузка отменена: не удалось создать каталог файлов";
			Возврат;
		КонецЕсли;
		
		Если СтрокаАктивныеСчетаДоверительногоУправления["ФормаУведомленияОНамеренииРазмещенияДепозита"] Тогда 
			
			МассивСчетовПоДепозитам.Добавить(СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления);
			
		ИначеЕсли СтрокаАктивныеСчетаДоверительногоУправления["ФормаПереводыСоСчетовБрокераНаРасчетныеСчета"] Тогда  
			
			МассивСчетовПоПереводам.Добавить(СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления);
			
		Иначе
			
			Для Каждого Элемент Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
				
				Если СтрокаАктивныеСчетаДоверительногоУправления[Элемент.Значение] Тогда
					
					ПолучитьФорму("ВнешняяОбработка._ЭкспортДанныхВСЭДСДКГарант.Форма." + Элемент.Значение)
						.СформироватьДокументыСЭД(Объект.Организация, СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления, Объект.Период, Объект.КаталогФайлов + ?(Прав(Объект.КаталогФайлов, 1) = "\", "", "\") + Элемент.Представление, Объект.ОтветственноеЛицо);
						
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивСчетовПоДепозитам.Количество() > 0 Тогда
		СформироватьУведомленияОНамеренииРазмещенияДепозитов(Объект.Организация, МассивСчетовПоДепозитам, Объект.Период, Объект.КаталогФайлов, Объект.ОтветственноеЛицо);	
	КонецЕсли;
	
	Если МассивСчетовПоПереводам.Количество() > 0 Тогда
		СформироватьУведомленияПоПереводам(Объект.Организация, МассивСчетовПоПереводам, Объект.Период, Объект.КаталогФайлов, Объект.ОтветственноеЛицо);	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Экспорт данных завершен");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьФлажки");
	Попытка
		ВыполнитьУстановкуФлажков(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУстановкуФлажков(ПараметрыСессии)
	
	Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
		СтрокаАктивныеСчетаДоверительногоУправления.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСнятьФлажки");
	Попытка
		ВыполнитьСнятиеФлажков(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСнятиеФлажков(ПараметрыСессии)
	
	Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
		СтрокаАктивныеСчетаДоверительногоУправления.Флажок = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьУведомленияОНамеренииРазмещенияДепозитов(Организация, МассивСчетовДУ, Период, КаталогФайлов, ОтветственноеЛицо)
	
	Отказ = Ложь;
	ТекКаталогФайлов = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "Уведомления о намерении размещения депозитов";
	
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка уведомлений о намерении размещения депозитов прервана. Не удалось создать папку для сохранения для файлов.");
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Ссылка КАК Ссылка,
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов
		|ПОМЕСТИТЬ _ДанныеРаспоряжений
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.ДатаРазмещения = &Период
		|	И Распоряжение.Организация = &Организация
		|	И Распоряжение.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	И НЕ Распоряжение.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеРаспоряжений.БанкЮрЛицо КАК ЮрЛицо
		|ПОМЕСТИТЬ _ЮрЛицаБанковОрганизаций
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&ЮрЛицоОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо КАК Филиал,
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК Родитель
		|ПОМЕСТИТЬ _ГоловныеОрганизации
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Период,
		|			ЮридическоеЛицо В
		|					(ВЫБРАТЬ
		|						_ЮрЛицаБанковОрганизаций.ЮрЛицо
		|					ИЗ
		|						_ЮрЛицаБанковОрганизаций КАК _ЮрЛицаБанковОрганизаций)
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ЮрЛицо КАК ЮрЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	СвидетельстваОГосРегистрации.Номер КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыЮрЛиц
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЮрЛицаБанковОрганизаций.ЮрЛицо КАК ЮрЛицо
		|	ИЗ
		|		_ЮрЛицаБанковОрганизаций КАК _ЮрЛицаБанковОрганизаций
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ГоловныеОрганизации.Родитель
		|	ИЗ
		|		_ГоловныеОрганизации КАК _ГоловныеОрганизации) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.ЮрЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК СвидетельстваОГосРегистрации
		|		ПО ВложенныйЗапрос.ЮрЛицо = СвидетельстваОГосРегистрации.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРаспоряжений.Ссылка КАК Распоряжение,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеРаспоряжений.БанкЮрЛицо КАК БанкЮрЛицо,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеРаспоряжений.Организация = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеРаспоряжений.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
		|			И (_ДанныеРаспоряжений.БанкЮрЛицо = ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент)
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ГенСоглашения.Распоряжение КАК Распоряжение,
		|	_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|	_ГенСоглашения.Номер КАК Номер,
		|	_ГенСоглашения.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ЕдиничныеГенСоглашения
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ГенСоглашения.Распоряжение КАК Распоряжение,
		|		_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|		МАКСИМУМ(_ГенСоглашения.ДатаЗаключения) КАК ДатаЗаключения
		|	ИЗ
		|		_ГенСоглашения КАК _ГенСоглашения
		|	ГДЕ
		|		НЕ _ГенСоглашения.Номер ЕСТЬ NULL
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ГенСоглашения.Распоряжение,
		|		_ГенСоглашения.СчетДоверительногоУправления,
