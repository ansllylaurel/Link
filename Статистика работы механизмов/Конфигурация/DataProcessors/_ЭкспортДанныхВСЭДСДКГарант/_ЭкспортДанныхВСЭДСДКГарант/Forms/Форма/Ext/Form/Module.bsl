		|		ИНАЧЕ НомераОбъектов.Номер
		|	КОНЕЦ КАК НомерПодтверждения
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыОрганизации
		|		ПО (_РеквизитыОрганизации.ЮрЛицо = &ЮрЛицоОрганизации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловнойОрганизации
		|			ПО _ГоловныеОрганизации.Родитель = _РеквизитыГоловнойОрганизации.ЮрЛицо
		|		ПО (_ГоловныеОрганизации.Филиал = &ЮрЛицоОрганизации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанков
		|		ПО _ДанныеРаспоряжений.БанкЮрЛицо = _РеквизитыБанков.ЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанков
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловныхОрганизацийБанков
		|			ПО _ГоловныеОрганизацииБанков.Родитель = _РеквизитыГоловныхОрганизацийБанков.ЮрЛицо
		|		ПО _ДанныеРаспоряжений.БанкЮрЛицо = _ГоловныеОрганизацииБанков.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ИдентификаторыПортфелейВСЭД
		|		ПО _ДанныеРаспоряжений.СчетДоверительногоУправления = ИдентификаторыПортфелейВСЭД.Объект
		|			И (ИдентификаторыПортфелейВСЭД.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДСДКГарант.ИдентификаторПортфеля"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЕдиничныеГенСоглашения КАК _ЕдиничныеГенСоглашения
		|		ПО _ДанныеРаспоряжений.Ссылка = _ЕдиничныеГенСоглашения.Распоряжение
		|			И _ДанныеРаспоряжений.СчетДоверительногоУправления = _ЕдиничныеГенСоглашения.СчетДоверительногоУправления
		|			И _ДанныеРаспоряжений.БанкЮрЛицо = _ЕдиничныеГенСоглашения.БанкЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО _ДанныеРаспоряжений.Ссылка = НомераОбъектов.Объект
		|			И (НомераОбъектов.Организация = &Организация)
		|			И (НомераОбъектов.ВидНумерации В (ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ)))";	
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("ОтветственноеЛицо", ОтветственноеЛицо);
	
	СтруктураБанков = Обработки.Распоряжения.ПолучитьСтруктуруБанковДляКоторыхНастроеныФормыПодтверждений();
	
	Запрос.УстановитьПараметр("Банк_ГПБ", СтруктураБанков.Банк_ГПБ);
	Запрос.УстановитьПараметр("Банк_Сбер", СтруктураБанков.Банк_Сбер);
	Запрос.УстановитьПараметр("Банк_ДомРФ", СтруктураБанков.Банк_ДомРФ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(Выборка.СчетДоверительногоУправления) + "_" + Выборка.Контрагент_6 + "_"
					+ Формат(Выборка.Цена_20, "ЧДЦ=0") + "_" + Строка(Выборка.Срок) + "_" + Формат(Выборка.ДатаУведомления_1, "ДФ=ddMMyyyy"));
		
		Попытка
			ФайлВФормате1С = Новый ЗаписьТекста(ТекКаталогФайлов + "\" + ИмяФайла + ".csv", КодировкаТекста.ANSI, ";");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла уведомления о намерении размещения депозита по счету ДУ " + СокрЛП(Выборка.СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		МассивПараметров = Новый Массив();
		
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			
			ПозицияЗнака = СтрНайти(Колонка.Имя, "_"); 
			
			Если ПозицияЗнака = 0 Тогда
				Продолжить;
			Иначе
				ТекИндекс = Число(Сред(Колонка.Имя, ПозицияЗнака + 1));	
			КонецЕсли;
			
			Если ТекИндекс = 17 Тогда
				
				Если ЗначениеЗаполнено(Выборка.НомерГенСоглашения) Тогда
					
					ТекЗначение = СтрШаблон(Выборка[Колонка.Имя], Выборка.НомерПодтверждения, Формат(Выборка.ДатаУведомления_1, "ДФ='dd.MM.yyyy ''г.'''"), Формат(Выборка.ДатаГенСоглашения, "ДЛФ=DD"), Выборка.НомерГенСоглашения);
					
					Если Не ЗначениеЗаполнено(Выборка.НомерПодтверждения) Тогда
						ТекЗначение = СтрШаблон(Выборка[Колонка.Имя], " НОМЕР БАНКОВСКОГО ПОДТВЕРЖДЕНИЯ", Формат(Выборка.ДатаУведомления_1, "ДФ='dd.MM.yyyy ''г.'''"), Формат(Выборка.ДатаГенСоглашения, "ДЛФ=DD"), Выборка.НомерГенСоглашения);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке данных депозита в СЭД укажите [номер банковского подтверждения] в форме Уведомления о намерении в поле [Описание предмета сделки] для счета ДУ [" + СокрЛП(Выборка.СчетДоверительногоУправления) + "]");
					КонецЕсли;
										
				Иначе
					ТекЗначение = СтрШаблон(Выборка[Колонка.Имя], "", "", "", ""); 	
				Конецесли;
				
			ИначеЕсли ТекИндекс = 31 Тогда
				
				ТекЗначение = СтрШаблон(Выборка[Колонка.Имя], Строка(Выборка.Срок) + " (" + ЧислоПрописью(Выборка.Срок, "Л=ru_RU; НП=Ложь", ",,,,,,,,0") + ")", НРег(Выборка.ПериодичностьВыплатыПроцентов), Формат(Выборка.Процент, "ЧДЦ=2; ЧРД=.; ЧРГ=0"));
					
			Иначе
				ТекЗначение = СериализоватьЗнчПоля(Выборка[Колонка.Имя], Сред(Колонка.Имя, 1, ПозицияЗнака - 1));	
			КонецЕсли;
			
			МассивПараметров.Вставить(ТекИндекс - 1, ТекЗначение);
				
		КонецЦикла;
		
		Для Каждого ЗначениеПараметра Из МассивПараметров Цикл
			ФайлВФормате1С.ЗаписатьСтроку(ЗначениеПараметра);	
		КонецЦикла;
		
		ФайлВФормате1С.Закрыть();
		
	КонецЦикла;	
	
КонецПроцедуры 

&НаСервере
Процедура СформироватьУведомленияПоПереводам(Организация, МассивСчетовДУ, Период, КаталогФайлов, ОтветственноеЛицо) 
	
	Отказ = Ложь;
	ТекКаталогФайлов = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "Переводы со счетов брокера";
	
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка уведомлений о переводах со счетов брокера прервана. Не удалось создать папку для сохранения для файлов.");
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоручение.Ссылка КАК Ссылка,
		|	ДокПоручение.Организация КАК Организация,
		|	ДокПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручение.Брокер КАК Брокер,
		|	ДокПоручение.Брокер.ЮрФизЛицо КАК БрокерЮрЛицо,
		|	ДокПоручение.РасчетныйСчетПолучатель КАК СчетПолучатель,
		|	ДокПоручение.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
		|	ДокПоручение.Сумма КАК Сумма,
		|	ДокПоручение.Валюта КАК Валюта
		|ПОМЕСТИТЬ _ДанныеПоручений
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ПО ДокПоручение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация
		|			И ДокПоручение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления
		|			И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ДокПоручение.Дата, ДЕНЬ) = &Период
		|	И ДокПоручение.Организация = &Организация
		|	И ДокПоручение.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ДокПоручение.Проведен
		|	И ДокПоручение.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ДокПоручение.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПоручений.БанкЮрЛицо КАК Ссылка
		|ПОМЕСТИТЬ _ЮрЛица
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&ЮрЛицоОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо КАК Филиал,
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК Ссылка
		|ПОМЕСТИТЬ _ГоловныеОрганизации
		|ИЗ
		|	РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|			&Период,
		|			ЮридическоеЛицо В
		|					(ВЫБРАТЬ
		|						_ЮрЛица.Ссылка
		|					ИЗ
		|						_ЮрЛица КАК _ЮрЛица)
		|				И ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.Ссылка КАК ЮрЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	СвидетельстваОГосРегистрации.Номер КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыЮрЛиц
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЮрЛица.Ссылка КАК Ссылка
		|	ИЗ
		|		_ЮрЛица КАК _ЮрЛица
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ГоловныеОрганизации.Ссылка
		|	ИЗ
		|		_ГоловныеОрганизации КАК _ГоловныеОрганизации) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК СвидетельстваОГосРегистрации
		|		ПО ВложенныйЗапрос.Ссылка = СвидетельстваОГосРегистрации.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеПоручений.Брокер КАК Брокер,
		|	&Период КАК ДатаУведомления_1,
		|	&Период КАК СрокСогласия_2,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.КраткоеНаименованиеПоУставу, _РеквизитыОрганизации.КраткоеНаименованиеПоУставу) КАК УправляющаяКомпания_3,
		|	_ДанныеПоручений.СчетПолучатель.Договор.НаименованиеВладельцаДляДокументов КАК Контрагент_6,
		|	&ОтветственноеЛицо КАК ОтветственноеЛицоУК_7,
		|	ЕСТЬNULL(_РеквизитыГоловныхОрганизацийБанков.КраткоеНаименованиеПоУставу, _РеквизитыБанков.КраткоеНаименованиеПоУставу) КАК БанкНаименование_8,
		|	_ДанныеПоручений.СчетПолучатель.Банк.Код КАК Бик_9,
		|	_ДанныеПоручений.СчетПолучатель.НомерСчета КАК НомерСчета_10,
		|	КодыУБрокеров.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговора_11,
		|	_ДанныеПоручений.Сумма КАК Сумма_17,
		|	_ДанныеПоручений.Валюта КАК Валюта_18,
		|	ЕСТЬNULL(_РеквизитыГоловнойОрганизации.ОГРН, _РеквизитыОрганизации.ОГРН) КАК ОгрнКонтрагента_19,
		|	""1. Операции с имуществом"" КАК ФормаУведомленияОНомерении_20,
		|	""Перевод с брокерского счета на расчетный счет"" КАК ВидОперации_23,
		|	""Договор на брокерское обслуживание"" КАК ТипДокумента_24,
		|	КодыУБрокеров.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаДоговора_25
		|ИЗ
		|	_ДанныеПоручений КАК _ДанныеПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыОрганизации
		|		ПО (_РеквизитыОрганизации.ЮрЛицо = &ЮрЛицоОрганизации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловнойОрганизации
		|			ПО _ГоловныеОрганизации.Ссылка = _РеквизитыГоловнойОрганизации.ЮрЛицо
		|		ПО (_ГоловныеОрганизации.Филиал = &ЮрЛицоОрганизации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыБанков
		|		ПО _ДанныеПоручений.БанкЮрЛицо = _РеквизитыБанков.ЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизацииБанков
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛиц КАК _РеквизитыГоловныхОрганизацийБанков
		|			ПО _ГоловныеОрганизацииБанков.Ссылка = _РеквизитыГоловныхОрганизацийБанков.ЮрЛицо
		|		ПО _ДанныеПоручений.БанкЮрЛицо = _ГоловныеОрганизацииБанков.Филиал
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ДанныеПоручений.СчетДоверительногоУправления
		|						ИЗ
		|							_ДанныеПоручений КАК _ДанныеПоручений)) КАК КодыУБрокеров
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = КодыУБрокеров.СчетДоверительногоУправления
		|			И _ДанныеПоручений.Брокер = КодыУБрокеров.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ИдентификаторыПортфелейВСЭД
		|		ПО _ДанныеПоручений.СчетДоверительногоУправления = ИдентификаторыПортфелейВСЭД.Объект
		|			И (ИдентификаторыПортфелейВСЭД.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДСДКГарант.ИдентификаторПортфеля"")";	
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("ОтветственноеЛицо", ОтветственноеЛицо);
		
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(
			Строка(Выборка.УправляющаяКомпания_3) + "_перевод_ДС_с_брокера_" + Строка(Выборка.Брокер) + "_" + Выборка.СчетДоверительногоУправления + "_"
			+ Формат(Выборка.Сумма_17, "ЧДЦ=0") + "_" + Формат(Выборка.ДатаУведомления_1, "ДФ=ddMMyyyy"));
		
		Попытка
			ФайлВФормате1С = Новый ЗаписьТекста(ТекКаталогФайлов + "\" + ИмяФайла + ".csv", КодировкаТекста.ANSI, ";");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла уведомления о намерении размещения депозита по счету ДУ " + СокрЛП(Выборка.СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		МассивПараметров = Новый Массив();
		
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			
			ПозицияЗнака = СтрНайти(Колонка.Имя, "_"); 
			
			Если ПозицияЗнака = 0 Тогда
				Продолжить;
			Иначе
				ТекИндекс = Число(Сред(Колонка.Имя, ПозицияЗнака + 1));	
			КонецЕсли;
			
			ТекЗначение = СериализоватьЗнчПоля(Выборка[Колонка.Имя], Сред(Колонка.Имя, 1, ПозицияЗнака - 1));	
			
			МассивПараметров.Вставить(ТекИндекс - 1, ТекЗначение);
				
		КонецЦикла;
		
		Для Каждого ЗначениеПараметра Из МассивПараметров Цикл
			ФайлВФормате1С.ЗаписатьСтроку(ЗначениеПараметра);	
		КонецЦикла;
		
		ФайлВФормате1С.Закрыть();
		
	КонецЦикла;	

КонецПроцедуры

&НаСервереБезКонтекста
Функция СериализоватьЗнчПоля(ЗнчПоля, ИмяПоля)
	
	Если ТипЗнч(ЗнчПоля) = Тип("Дата") Тогда
		
		Возврат Формат(ЗнчПоля, "ДФ=dd.MM.yyyy");
		
	ИначеЕсли ТипЗнч(ЗнчПоля) = Тип("СправочникСсылка.Валюты") Тогда
		
		Валюта = СокрЛП(ЗнчПоля.Наименование);
		
		Если Валюта = "RUB" Тогда
			Валюта = "RUR";
		КонецЕсли;
		
		Возврат Валюта;
		
	ИначеЕсли ТипЗнч(ЗнчПоля) = Тип("Число") Тогда
		
		ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=2; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		
		Если ИмяПоля = "Количество" Тогда
			ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		ИначеЕсли ИмяПоля = "Цена" Тогда
			ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=9; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		КонецЕсли;
		
		Если Цел(ЗнчПоля) <> ЗнчПоля Тогда
			ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "ЧДЦ=;", "");
		КонецЕсли;	
		
		Возврат Формат(ЗнчПоля, ФорматнаяСтрока);

	Иначе
		
		Возврат Строка(ЗнчПоля);
		
	КонецЕсли;
	
КонецФункции

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
