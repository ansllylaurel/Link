		|			И ВложенныйЗапрос.БанкЮрЛицо = _ГенСоглашения.БанкЮрЛицо
		|			И ВложенныйЗапрос.ДатаЗаключения = _ГенСоглашения.ДатаЗаключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
