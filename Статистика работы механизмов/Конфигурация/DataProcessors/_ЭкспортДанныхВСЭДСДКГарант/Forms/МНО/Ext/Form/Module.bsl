
&НаСервереБезКонтекста
Функция СериализоватьЗнчПоля(ЗнчПоля, ИмяПоля)
	
	Если      ТипЗнч(ЗнчПоля) = Тип("Дата") Тогда
		Если ИмяПоля = "ДатаСделки" Тогда
			Возврат Формат(ЗнчПоля, "dd.MM.yyyy ЧЧ:ММ:сс");
		Иначе
			Возврат Формат(ЗнчПоля, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЗнчПоля) = Тип("СправочникСсылка.Валюты") Тогда
		Валюта = СокрЛП(ЗнчПоля.Наименование);
		
		Если Валюта = "RUB" Тогда
			Валюта = "RUR";
		КонецЕсли;
		
		Возврат Валюта;
		
	ИначеЕсли ТипЗнч(ЗнчПоля) = Тип("Число") Тогда
		ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=2; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		
		Если      ИмяПоля = "Количество" Тогда
			ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		ИначеЕсли ИмяПоля = "Цена" Тогда
			ФорматнаяСтрока = "ЧЦ=19; ЧДЦ=9; ЧДЦ=; ЧРД=.; ЧН=0.00; ЧГ=0";
		КонецЕсли;
		
		Если Цел(ЗнчПоля) <> ЗнчПоля Тогда
			ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "ЧДЦ=;", "");
		КонецЕсли;	
		
		Возврат Формат(ЗнчПоля, ФорматнаяСтрока);

	Иначе
		Возврат Строка(ЗнчПоля);
		
	КонецЕсли;
	
КонецФункции // СериализоватьЗнчПоля

&НаСервере
Функция СформироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов, ОтветственноеЛицо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	
#Область Текст_Запроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РаспоряжениеНаМНО.Дата КАК Датауведомления,
		|	РаспоряжениеНаМНО.Дата КАК Сроксогласия,
		|	РеквизитыУК.КраткоеНаименованиеПоУставу КАК УправляющаяКомпания,
		|	NULL КАК УчредительУправления,
		|	NULL КАК ИнвестиционныйПортфель,
		|	РеквизитыБанка.КраткоеНаименованиеПоУставу КАК Контрагент,
		|	&ОтветственноеЛицо КАК ОтветственноеЛицоУК,
		|	ВЫБОР
		|		КОГДА РаспоряжениеНаМНО.РасчетныйСчет.Банк = &Банк_Зенит
		|			ТОГДА ""Размещение денежных средств в форме НСО""
		|		ИНАЧЕ ""Заключение Подтверждения о порядке поддержания минимального неснижаемого остатка на счетах клиента""
		|	КОНЕЦ КАК ВидОперации,
		|	NULL КАК Брокер,
		|	NULL КАК НомерБрокерскогоДоговора,
		|	NULL КАК ДатаБрокерскогоДоговора,
		|	1 КАК ВидИмущества,
		|	NULL КАК Эмитент,
		|	NULL КАК ТипЦБ,
		|	NULL КАК РегНомерЦБ,
		|	NULL КАК КодЦБ,
		|	NULL КАК ОписаниеИногоИмущества,
		|	1 КАК Количество,
		|	""шт."" КАК ЕдиницаИзмерения,
		|	РаспоряжениеНаМНО.Сумма КАК Цена,
		|	РаспоряжениеНаМНО.Валюта КАК ВалютаЦены,
		|	ВЫБОР
		|		КОГДА РаспоряжениеНаМНО.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|			ТОГДА """"
		|		ИНАЧЕ РаспоряжениеНаМНО.Дата
		|	КОНЕЦ КАК ПланируемаяДатаОплаты,
		|	NULL КАК ПланируемаяДатаПеререгистрации,
		|	NULL КАК СчетДепо,
		|	NULL КАК ТипРазделаСчета,
		|	NULL КАК МестоХраненияБумаг,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРНКонтрагента,
		|	""1. Операции с имуществом"" КАК ФормаУведомленияОНамерении,
		|	ИдентификаторыПортфелей.Значение КАК ИдентификаторПортфеляВСЭД,
		|	NULL КАК ВнешнийНомер,
		|	NULL КАК СущественныеУсловияСделки,
		|	NULL КАК КомментарийКОперациямСИмуществомИЦБ,
		|	NULL КАК ВнешняяДата,
		|	ВЫБОР
		|		КОГДА РаспоряжениеНаМНО.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|			ТОГДА """"
		|		ИНАЧЕ ""Точно""
		|	КОНЕЦ КАК УсловиеПланируемойДатыОплаты,
		|	ВЫБОР
		|		КОГДА РаспоряжениеНаМНО.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|			ТОГДА """"
		|		ИНАЧЕ ""Точно""
		|	КОНЕЦ КАК УсловиеПланируемойДатыПеререгистрации,
		|	NULL КАК УсловиеДляСуммы,
		|	РаспоряжениеНаМНО.Дата КАК _ДатаНачала,
		|	РаспоряжениеНаМНО.ДатаВозврата КАК _ДатаВозврата,
		|	ВЫБОР
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000001"" И ""000009""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 6, 1)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000010"" И ""000099""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 5, 2)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000100"" И ""000999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 4, 3)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""001000"" И ""009999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 3, 4)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""010000"" И ""099999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 2, 5)
		|		ИНАЧЕ НомераОбъектов.Номер
		|	КОНЕЦ КАК _НомерПодтверждения,
		|	РаспоряжениеНаМНО.Процент КАК _Процент,
		|	РаспоряжениеНаМНО.РасчетныйСчет.Банк = &Банк_Зенит КАК _ЭтоБанкЗенит
		|ИЗ
		|	Документ.Распоряжение КАК РаспоряжениеНаМНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО РаспоряжениеНаМНО.Организация.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыУК
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, РаспоряжениеНаМНО.Организация.ЮрФизЛицо) = РеквизитыУК.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыБанка
		|		ПО РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо = РеквизитыБанка.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ИдентификаторыПортфелей
		|		ПО РаспоряжениеНаМНО.СчетДоверительногоУправления = ИдентификаторыПортфелей.Объект
		|			И (ИдентификаторыПортфелей.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДСДКГарант.ИдентификаторПортфеля"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО РаспоряжениеНаМНО.Организация = НомераОбъектов.Организация
		|			И РаспоряжениеНаМНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
		|			И РаспоряжениеНаМНО.Ссылка = НомераОбъектов.Объект
		|			И (ГОД(РаспоряжениеНаМНО.Дата) = НомераОбъектов.Год)
		|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)
		|ГДЕ
		|	РаспоряжениеНаМНО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И РаспоряжениеНаМНО.Организация = &Организация
		|	И РаспоряжениеНаМНО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|	И РаспоряжениеНаМНО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НЕ РаспоряжениеНаМНО.ПометкаУдаления";
#КонецОбласти	
	
	Запрос.УстановитьПараметр("Период",                       	Период);
	Запрос.УстановитьПараметр("НачалоПериода",                	Новый Граница(НачалоДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода",                	Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОтветственноеЛицо", 				ОтветственноеЛицо);
	Запрос.УстановитьПараметр("Банк_Зенит",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_Зенит"));
	
	ВидыДоговоров = Новый Массив;
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);	
	
	Запрос.УстановитьПараметр("ВидыДоговоров", 					ВидыДоговоров);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НомерФайла = 0;
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ФайлВФормате1С = Новый ЗаписьТекста(КаталогФайлов + "\" + СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + Формат(НомерФайла, "ЧГ=0") + ".csv", КодировкаТекста.ANSI, ";");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки МНО по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;
		
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если Лев(Колонка.Имя, 1) = "_" Тогда
				Продолжить;	
			ИначеЕсли Колонка.Имя = "ОписаниеИногоИмущества" Тогда
				ФайлВФормате1С.ЗаписатьСтроку(
					СтрШаблон("%1 %2 от %3. Процентная ставка - %4 годовых. Дата начала срока - %5 г. Дата окончания срока - %6 г.",
				    	?(Выборка._ЭтоБанкЗенит, "Проект дополнительного соглашения №", "Подтверждение о порядке поддержания минимального неснижаемого остатка на счетах клиента №"),				
				  		Выборка._НомерПодтверждения,
						Формат(Выборка._ДатаНачала, "ДФ=dd.MM.yy"),
						Формат(Выборка._Процент, "ЧДЦ=2") + "%",
						Формат(Выборка._ДатаНачала, "ДФ=dd.MM.yy"),
						Формат(Выборка._ДатаВозврата, "ДФ=dd.MM.yy")));
			Иначе	
				ФайлВФормате1С.ЗаписатьСтроку(СериализоватьЗнчПоля(Выборка[Колонка.Имя],Колонка.Имя));	
			КонецЕсли;
		КонецЦикла;
		                                
		НомерФайла = НомерФайла + 1;
	КонецЦикла;
	
КонецФункции
