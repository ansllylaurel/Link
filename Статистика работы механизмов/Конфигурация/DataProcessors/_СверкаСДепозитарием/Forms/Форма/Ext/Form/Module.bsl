
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");		
	Объект.ДатаСверки	= ТекущаяДата() - 86400;	
		
	ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений	= Ложь;
	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях						= Ложь;	
	ЭтаФорма.ВремяСверки												= ТекущаяДата();	
	
	// Обработка параметров	
	
	Если Параметры.Свойство("Организация") Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаСверки") Тогда
		Объект.ДатаСверки = Параметры.ДатаСверки;
	КонецЕсли;	
	
	ЭтаФорма.БКРегион = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион");
		
	Объект.Депозитарий = ЭтаФорма.БКРегион;
	
	УстановитьСоответствиеДепозитариевИОтчетовНаСервере();
	
	Элементы.СтраницаОтчетОПодтвержденныхОперациях.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ПроверяемыеРеквизиты.Добавить("ВремяСверки");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаСверкиПриИзменении(Элемент)

	СверенныеВручнуюДепозитарныеСчета.Очистить();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхожденийПриИзменении(Элемент)

	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях = ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений;
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ФиксироватьРезультатСверкиПриИзменении(Элемент)
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ЭтаФорма.ВремяСверки = ТекущаяДата();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВремяСверкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ВыбранноеЗначение = ВыбранноеЗначение + (ЭтаФорма.ВремяСверки - НачалоДня(ЭтаФорма.ВремяСверки));		
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	// Если найден деп.счет, то отображаем команду добавления в сверенные вручную

	НайденДепозитарныйСчет = Ложь;

	Для каждого Область Из Результат.ВыделенныеОбласти Цикл
		
		Для ИндексСтрока = Область.Верх По Область.Низ Цикл
			
			Для ИндексКолонка = Область.Лево По Область.Право Цикл
				
				Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка);
				
				Если Ячейка.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(Ячейка.Расшифровка) = Тип("СправочникСсылка.ДепозитарныеСчета") Тогда
					НайденДепозитарныйСчет = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Элементы.РезультатДобавитьВСверенныеВручную.Видимость = НайденДепозитарныйСчет;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	УстановитьСоответствиеДепозитариевИОтчетовНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаОткрытьКарточку(Команда)

	Если ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.ДепозитарныеСчета")
		ИЛИ ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.Облигации")
		ИЛИ ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.Акции")
		ИЛИ ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.Паи")
		ИЛИ ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.ДепозитарныеРасписки")
		ИЛИ ТипЗнч(Результат.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.Векселя")
	Тогда
		ОткрытьЗначение(Результат.ТекущаяОбласть.Расшифровка);
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьВСверенныеВручную(Команда)

	ДепозитарныеСчета = Новый Массив;

	Для каждого Область Из Результат.ВыделенныеОбласти Цикл
		
		Для ИндексСтрока = Область.Верх По Область.Низ Цикл
			
			Для ИндексКолонка = Область.Лево По Область.Право Цикл
				
				Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка);
				
				Если Ячейка.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(Ячейка.Расшифровка) = Тип("СправочникСсылка.ДепозитарныеСчета") Тогда
					ДепозитарныеСчета.Добавить(Ячейка.Расшифровка);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ДепозитарныеСчета.Количество() > 0 Тогда
		ДобавитьВСверенныеВручную(ДепозитарныеСчета);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСверить(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	// Сверка должна быть на следующий рабочий день после сверяемой даты
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
	
		СледующийРабочийДень = ДобавитьКДатеРабочиеДни(КонецДня(Объект.ДатаСверки) + 1, 1);
		
		Если НачалоДня(ВремяСверки) <> СледующийРабочийДень Тогда
			
			Ответ = Вопрос("Сверка будет зафиксирована не на следующий рабочий день после сверяемой даты. Продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если Ответ <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	// Очищаем результаты предыдущей сверки
	
	Результат						= Неопределено;
	ОтчетОПодтвержденныхОперациях	= Неопределено;
		
	ВывестиИнформациюНаКлиенте("Заголовок",		"");
	ВывестиИнформациюНаКлиенте("ПустаяСтрока",	"");	
	ВывестиИнформациюНаКлиенте("Отбор",			Новый Структура("ИмяОтбора, ЗначениеОтбора", "Организация", Объект.Организация));
	ВывестиИнформациюНаКлиенте("Отбор",			Новый Структура("ИмяОтбора, ЗначениеОтбора", "ДатаСверки", Формат(Объект.ДатаСверки,"ДФ=dd.MM.yyyy")));
	ВывестиИнформациюНаКлиенте("ПустаяСтрока",	"");	
	
	СписокДепозитарныхКомпаний = ПолучитьСписокДепозитарныхКомпаний(Объект.ДатаСверки, Объект.Организация, Объект.Депозитарий, ЭтоТраст);
	
	Для Каждого ЭлементСписка Из СписокДепозитарныхКомпаний Цикл
		
		СессияСбораСтатистики 	= "";
		ПолноеИмяОтчета 		= "";
		
		ЗарегистрироватьНачалоСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики);
	
		Объект.ЦенныеБумаги.Очистить();
		
		ВывестиИнформациюНаКлиенте("Депозитарий", ЭлементСписка.Значение, 1);
		
		ЗагрузитьДанныеИзФайлов(ЭлементСписка.Значение, ЭлементСписка.Представление);
		
		СверитьОстаткиЦенныхБумагНаСервере(ЭлементСписка.Значение);
		
		ВывестиИнформациюНаКлиенте("ПустаяСтрока", "", 2);
		
		ЗарегистрироватьОкончаниеСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики);
		
	КонецЦикла;
	
	ВывестиИнформацию("ПустаяСтрока", "");
	
	// Отображаем результаты сверки
	
	Элементы.СтраницаОтчетОПодтвержденныхОперациях.Видимость = ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_и_вспомогательные_функции

&НаСервере
Процедура УстановитьСоответствиеДепозитариевИОтчетовНаСервере()
		
	ЭтаФорма.ЭтоРЭМ   = Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	
	// Заполним соответствие депозитарных компаний и их отчетов
	НСД 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД");
	ДК			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ДК_Регион");
	ВТБ 		= ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_ВТБ");
	Инфинитум	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум");
	РСД			= ОбщегоНазначения.ПолучитьИменованныйОбъект("СпецДепозитарий_Сбербанка");
	НРК			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Регистратор_НРК");
	ГПБ			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ГПБ");
		
	СоответствиеДепозитарныхКомпанийИОтчетов = Новый Соответствие;
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(ЭтаФорма.БКРегион,	Справочники.ВнешниеСистемы.ОтчетДепозитарияБКРегион);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(НСД,					Справочники.ВнешниеСистемы.ОтчетДепозитарияНСД);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(ДК,					Справочники.ВнешниеСистемы.ОтчетДепозитарияДКРегион);	
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(ВТБ,					Справочники.ВнешниеСистемы.ОтчетДепозитарияВТБ);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(Инфинитум,			Справочники.ВнешниеСистемы.ОтчетДепозитарияИнфинитум);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(РСД,					Справочники.ВнешниеСистемы.ОтчетДепозитарияСбербанка);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(НРК,					Справочники.ВнешниеСистемы.ОтчетРегистратораНРК);
	СоответствиеДепозитарныхКомпанийИОтчетов.Вставить(ГПБ,					Справочники.ВнешниеСистемы.ОтчетДепозитарияГПБ);
		
	ОтчетыДепозитарныхКомпаний = Новый ФиксированноеСоответствие(СоответствиеДепозитарныхКомпанийИОтчетов);
	
	// Видимость элементов по умолчанию
	МассивДепозитариев = Новый Массив;
	МассивДепозитариев.Добавить(ЭтаФорма.БКРегион);
	МассивДепозитариев.Добавить(ГПБ);
		
	Если ЭтоРЭМ Тогда		
		МассивДепозитариев.Добавить(ДК);		
		МассивДепозитариев.Добавить(Инфинитум);
		МассивДепозитариев.Добавить(ВТБ);	
		МассивДепозитариев.Добавить(РСД);
		МассивДепозитариев.Добавить(НСД);
	КонецЕсли;
	
	Элементы.Депозитарий.СписокВыбора.ЗагрузитьЗначения(МассивДепозитариев);			
	
КонецПроцедуры

&НаСервере
Функция СверитьОстаткиЦенныхБумагНаСервере(ДепозитарнаяКомпания)
	
	// Запрос сверяемых данных
	
	Запрос = Новый Запрос;
	
	ПоместитьДепозитарныеСчетаКлиентовВМенеджерВременныхТаблиц(Запрос, Объект.ДатаСверки, Объект.Организация, ЭтоТраст, ДепозитарнаяКомпания, Истина);
	
	ПоместитьЦенныеБумагиДепозитарияВМенеджерВременныхТаблиц(Запрос, Объект.ДатаСверки, Объект.Организация, ДепозитарнаяКомпания, Объект.ЦенныеБумаги.Выгрузить());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитарныеСчетаКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДепозитарныеСчетаКлиентов.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	_ДепозитарныеСчетаКлиентов.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ЛОЖЬ КАК СверкаВыполнена,
		|	ЛОЖЬ КАК ЕстьРасхождения,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(1024)) КАК Примечание
		|ПОМЕСТИТЬ _СверяемыеДепозитарныеСчетаКлиентов
		|ИЗ
		|	_ДепозитарныеСчетаКлиентов КАК _ДепозитарныеСчетаКлиентов
		|ГДЕ
		|	(_ДепозитарныеСчетаКлиентов.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _ДепозитарныеСчетаКлиентов.ДатаРасторжения > &ДатаСверки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДепозитарныеСчетаКлиентов.ДепозитарныйСчет КАК ДепозитарныйСчет
		|ПОМЕСТИТЬ _ДепозитарныеСчета
		|ИЗ
		|	_ДепозитарныеСчетаКлиентов КАК _ДепозитарныеСчетаКлиентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитарныеСчета.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага, НЕОПРЕДЕЛЕНО) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(СУММА(ОстаткиЦенныхБумагОстатки.КоличествоОстаток), 0) КАК Количество
		|ПОМЕСТИТЬ _ЦенныеБумаги1С
		|ИЗ
		|	_ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(&ДатаСверкиВключая, Организация = &Организация) КАК ОстаткиЦенныхБумагОстатки
		|		ПО (_ДепозитарныеСчета.ДепозитарныйСчет = ВЫБОР
		|				КОГДА ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|					ТОГДА ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.Родитель
		|				ИНАЧЕ ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДепозитарныеСчета.ДепозитарныйСчет,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага, НЕОПРЕДЕЛЕНО)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбъединенныеОстатки.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ОбъединенныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ОбъединенныеОстатки.КоличествоДепозитарий) КАК КоличествоДепозитарий,
		|	СУММА(ОбъединенныеОстатки.Количество1С) КАК Количество1С
		|ПОМЕСТИТЬ _СопоставленныеОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЦенныеБумагиДепозитарий.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|		_ЦенныеБумагиДепозитарий.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_ЦенныеБумагиДепозитарий.Количество КАК КоличествоДепозитарий,
		|		0 КАК Количество1С
		|	ИЗ
		|		_ЦенныеБумагиДепозитарий КАК _ЦенныеБумагиДепозитарий
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ЦенныеБумаги1С.ДепозитарныйСчет,
		|		_ЦенныеБумаги1С.ЦеннаяБумага,
		|		0,
		|		_ЦенныеБумаги1С.Количество
		|	ИЗ
		|		_ЦенныеБумаги1С КАК _ЦенныеБумаги1С) КАК ОбъединенныеОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбъединенныеОстатки.ДепозитарныйСчет,
		|	ОбъединенныеОстатки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ЗаполненныеСсылки.ЦеннаяБумага) КАК Количество,
		|	_ЗаполненныеСсылки.КодБумаги КАК КодБумаги
		|ПОМЕСТИТЬ _ПроверкаДублейЦенныхБумаг
		|ИЗ
		|	_ЗаполненныеСсылки КАК _ЗаполненныеСсылки
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗаполненныеСсылки.КодБумаги
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ЗаполненныеСсылки.ЦеннаяБумага) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СопоставленныеОстатки.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	_СопоставленныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СопоставленныеОстатки.КоличествоДепозитарий КАК КоличествоДепозитарий,
		|	_СопоставленныеОстатки.Количество1С КАК Количество1С,
		|	ВЫБОР
		|		КОГДА _СопоставленныеОстатки.ДепозитарныйСчет В (&СверенныеВручнуюДепозитарныеСчета)
		|			ТОГДА ""0_РасхожденийНетСвереноВручную""
		|		КОГДА СверкаДепозитарныхСчетов.НетВ1С
		|			ТОГДА ""4_НетСчетаВ1С""
		|		КОГДА СверкаДепозитарныхСчетов.НетВВыгрузке
		|				И &СверятьПриОтсутствииВВыгрузке
		|			ТОГДА ""1_РасхожденийНет""
		|		КОГДА СверкаДепозитарныхСчетов.НетВВыгрузке
		|			ТОГДА ""3_НетСчетаВВыгрузке""
		|		КОГДА _СопоставленныеОстатки.КоличествоДепозитарий = _СопоставленныеОстатки.Количество1С
		|			ТОГДА ""1_РасхожденийНет""
		|		ИНАЧЕ ""2_Расхождения""
		|	КОНЕЦ КАК ИмяОбласти,
		|	ВЫБОР
		|		КОГДА _СверяемыеДепозитарныеСчетаКлиентов.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|			ТОГДА ""ИИС""
		|		ИНАЧЕ _СверяемыеДепозитарныеСчетаКлиентов.СчетДоверительногоУправления
		|	КОНЕЦ КАК СчетДоверительногоУправления
		|ИЗ
		|	_СопоставленныеОстатки КАК _СопоставленныеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СопоставленныеОстатки.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|			МАКСИМУМ(_СопоставленныеОстатки.КоличествоДепозитарий) ЕСТЬ NULL КАК НетВВыгрузке,
		|			МАКСИМУМ(_СопоставленныеОстатки.Количество1С) ЕСТЬ NULL КАК НетВ1С
		|		ИЗ
		|			_СопоставленныеОстатки КАК _СопоставленныеОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СопоставленныеОстатки.ДепозитарныйСчет) КАК СверкаДепозитарныхСчетов
		|		ПО (СверкаДепозитарныхСчетов.ДепозитарныйСчет = _СопоставленныеОстатки.ДепозитарныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СверяемыеДепозитарныеСчетаКлиентов КАК _СверяемыеДепозитарныеСчетаКлиентов
		|		ПО _СопоставленныеОстатки.ДепозитарныйСчет = _СверяемыеДепозитарныеСчетаКлиентов.ДепозитарныйСчет
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДепозитарныйСчет,
		|	ЦеннаяБумага
		|ИТОГИ
		|	ПОДСТРОКА(МАКСИМУМ(ИмяОбласти), 3, 100) КАК ИмяОбласти
		|ПО
		|	ОБЩИЕ,
		|	ДепозитарныйСчет,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";		
	
	Запрос.УстановитьПараметр("Организация",						Объект.Организация);
	Запрос.УстановитьПараметр("ДатаСверки",							КонецДня(Объект.ДатаСверки));
	Запрос.УстановитьПараметр("ДатаСверкиВключая",					Новый Граница(КонецДня(Объект.ДатаСверки), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СверенныеВручнуюДепозитарныеСчета",	СверенныеВручнуюДепозитарныеСчета.Выгрузить().ВыгрузитьКолонку("ДепозитарныйСчет"));
	Запрос.УстановитьПараметр("СверятьПриОтсутствииВВыгрузке",
			ДепозитарнаяКомпания = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_ГПБ") И Объект.ЦенныеБумаги.Количество() > 0);
	
	ВыборкаДепозитариев = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДепозитарныеСчетаКлиентов = Запрос.МенеджерВременныхТаблиц.Таблицы["_СверяемыеДепозитарныеСчетаКлиентов"].ПолучитьДанные().Выгрузить();
	ДепозитарныеСчетаКлиентов.Индексы.Добавить("ДепозитарныйСчет");
	ДепозитарныеСчетаКлиентов.Индексы.Добавить("СчетДоверительногоУправления");
	
	ДублиЦенныхБумаг = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПроверкаДублейЦенныхБумаг"].ПолучитьДанные().Выгрузить();	
	Для Каждого СтрокаДублей Из ДублиЦенныхБумаг Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Найдено " + СтрокаДублей.Количество + " ценных бумаги с одинаковым государственным регистрационным номером " + СтрокаДублей.КодБумаги);
	КонецЦикла;
	
	// Формируем отчет о результатах сверки	
	
	НетСчетаВ1С = Ложь;
	
	Пока ВыборкаДепозитариев.Следующий() Цикл
		Если ВыборкаДепозитариев.ИмяОбласти = "НетСчетаВ1С" Тогда
			НетСчетаВ1С = Истина;
		КонецЕсли;
		
		ВыборкаСчетовДУ = ВыборкаДепозитариев.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчетовДУ.Следующий() Цикл
		
			ДанныеОтчетаОСверке = ВыборкаСчетовДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			
			Пока ДанныеОтчетаОСверке.Следующий() Цикл
				Если Не (Объект.ВыводитьТолькоРасхождения И ДанныеОтчетаОСверке.ИмяОбласти = "РасхожденийНет") Тогда
					ВывестиИнформацию(ДанныеОтчетаОСверке.ИмяОбласти, ДанныеОтчетаОСверке);
				КонецЕсли;
				
				Если ЭтаФорма.ФиксироватьРезультатСверки ИЛИ ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений Тогда
					ЗаполнитьРасхожденияПоДепозитарнымСчетамКлиентов(ДепозитарныеСчетаКлиентов, ДанныеОтчетаОСверке.ДепозитарныйСчет, ДанныеОтчетаОСверке);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;	
	
	Если ЭтаФорма.ФиксироватьРезультатСверки ИЛИ ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений Тогда
		ЗафиксироватьРезультатыСверки(ДепозитарныеСчетаКлиентов, ДепозитарнаяКомпания, НетСчетаВ1С);
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ВыводитьОтчетОПодтвержденныхОперациях.Доступность	= Форма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений;
	Элементы.ВремяСверки.Доступность							= Форма.ФиксироватьРезультатСверки;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКаталогДанных(Организация, КодДепозитарнойКомпании, ДатаСверки, ТекущийКаталог)
	
	НовыйКаталог = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._СверкаСДепозитарием." + КодДепозитарнойКомпании, Организация, ДатаСверки, ТекущийКаталог);
	
	Если ЗначениеЗаполнено(НовыйКаталог) Тогда
		Возврат НовыйКаталог;
	Иначе	
		Возврат ТекущийКаталог;
	КонецЕсли;
	
КонецФункции // ПолучитьКаталогДанных

&НаСервереБезКонтекста
Функция ПолучитьСписокДепозитарныхКомпаний(ДатаСверки, Организация, Депозитарий, ЭтоТраст)
	
	Запрос = Новый Запрос;
	
	ПоместитьДепозитарныеСчетаКлиентовВМенеджерВременныхТаблиц(Запрос, ДатаСверки, Организация, ЭтоТраст); 
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДепозитарныеСчетаКлиентов.ДепозитарнаяКомпания КАК ДепозитарнаяКомпания,
		|	_ДепозитарныеСчетаКлиентов.КодДепозитарнойКомпании КАК КодДепозитарнойКомпании
		|ИЗ
		|	_ДепозитарныеСчетаКлиентов КАК _ДепозитарныеСчетаКлиентов
		|ГДЕ
		|	_ДепозитарныеСчетаКлиентов.ДепозитарнаяКомпания = &Депозитарий";
	
	Запрос.УстановитьПараметр("Депозитарий", Депозитарий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Заполняем список
	
	СписокДепозитарныхКомпаний = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		СписокДепозитарныхКомпаний.Добавить(Выборка.ДепозитарнаяКомпания, Выборка.КодДепозитарнойКомпании);
	КонецЦикла;
	
	Возврат СписокДепозитарныхКомпаний;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПоместитьДепозитарныеСчетаКлиентовВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ДатаСверки, Организация, ЭтоТраст, ДепозитарнаяКомпания = Неопределено, ВключаяРасторгнутыеДоговорыДУ = Ложь)
	
	// Определяем источник временных таблиц		
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ИсточникВременныхТаблиц) = Тип("Запрос") Тогда
		Если ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Неопределено Тогда
			ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
		Запрос.МенеджерВременныхТаблиц = ИсточникВременныхТаблиц.МенеджерВременныхТаблиц;
	ИначеЕсли ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = ИсточникВременныхТаблиц;
	КонецЕсли;	
	
	// Получаем депозитарные счета из исполнителей
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаПоЛицензииДУ
		|ИЗ
		|	РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(
		|			&ДатаСверки,
		|			Организация = &Организация
		|				И ВЫБОР
		|					КОГДА &ЭтоТраст
		|						ТОГДА Лицензия.ВидДеятельности В (ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами), ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
		|					ИНАЧЕ Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|				КОНЕЦ) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий КАК ДепозитарнаяКомпания,
		|	ВЫБОР
		|		КОГДА ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|			ТОГДА ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Родитель
		|		ИНАЧЕ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет
		|	КОНЕЦ КАК ДепозитарныйСчет,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодДепозитарнойКомпании
		|ПОМЕСТИТЬ _ДепозитарныеСчетаКлиентов
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаПоЛицензииДУ КАК _СчетаПоЛицензииДУ
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаПоЛицензииДУ.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(&ДатаСверки, ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.СверкаСДепозитарием)) КАК КодыВоВнешнихСистемахСрезПоследних
		|			ПО ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий = КодыВоВнешнихСистемахСрезПоследних.Объект
		|		ПО СчетаДоверительногоУправления.Организация = ИсполнителиПоЦеннымБумагам.Организация
		|			И СчетаДоверительногоУправления.Ссылка = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаСверки, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ПометкаУдаления = ЛОЖЬ
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаСверки
		|	И НЕ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ПометкаУдаления
		|	И (&ВключаяРасторгнутыеДоговорыДУ
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &ДатаСверки)
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &ДатаСверки)
		|	И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаЗакрытия > &ДатаСверки)
		|	И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаОткрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаОткрытия <= &ДатаСверки)
		|	И (ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.ДатаЗаключения ЕСТЬ NULL
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.ДатаЗаключения <= &ДатаСверки)
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ДатаСверки)
		|	И &ДепозитарнаяКомпания В (НЕОПРЕДЕЛЕНО, ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий)";
	
	Запрос.УстановитьПараметр("ДатаСверки",						КонецДня(ДатаСверки));
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ДепозитарнаяКомпания",			ДепозитарнаяКомпания);
	Запрос.УстановитьПараметр("ВключаяРасторгнутыеДоговорыДУ",	ВключаяРасторгнутыеДоговорыДУ);
	Запрос.УстановитьПараметр("ЭтоТраст", 						ЭтоТраст);
	
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПоместитьЦенныеБумагиДепозитарияВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, ДатаСверки, Организация, ДепозитарнаяКомпания, ЦенныеБумаги)
	
	// Определяем источник временных таблиц		
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ИсточникВременныхТаблиц) = Тип("Запрос") Тогда
		Если ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Неопределено Тогда
			ИсточникВременныхТаблиц.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
		Запрос.МенеджерВременныхТаблиц = ИсточникВременныхТаблиц.МенеджерВременныхТаблиц;
	ИначеЕсли ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = ИсточникВременныхТаблиц;
	КонецЕсли;	
	
	// Заполняем ссылки
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.Depo_Account_Number КАК НомерСчета,
		|	ЦенныеБумаги.Depo_Account_Division_Number КАК НомерРаздела,
		|	ЦенныеБумаги.Security_Type КАК ТипБумаги,
		|	ЦенныеБумаги.Security_Reg_No КАК КодБумаги,
		|	ЦенныеБумаги.Количество КАК Количество
		|ПОМЕСТИТЬ _ЗагруженныеДанные
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка КАК ДепозитарныйСчет,
		|	_ЗагруженныеДанные.НомерСчета КАК НомерСчета,
		|	_ЗагруженныеДанные.НомерРаздела КАК НомерРаздела,
		|	ВЫБОР
		|		КОГДА _ЗагруженныеДанные.КодБумаги В ("""", ""-"")
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЕСТЬNULL(Облигации.Ссылка, ЕСТЬNULL(Акции.Ссылка, ЕСТЬNULL(Векселя.Ссылка, ЕСТЬNULL(ДепозитарныеРасписки.Ссылка, ЕСТЬNULL(Паи.Ссылка, КодыISIN.Объект)))))
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	_ЗагруженныеДанные.ТипБумаги КАК ТипБумаги,
		|	_ЗагруженныеДанные.КодБумаги КАК КодБумаги,
		|	_ЗагруженныеДанные.Количество КАК Количество
		|ПОМЕСТИТЬ _ЗаполненныеСсылки
		|ИЗ
		|	_ЗагруженныеДанные КАК _ЗагруженныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|		ПО (ДепозитарныеСчета.Организация = &Организация)
		|			И (ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Депозитарный))
		|			И (ДепозитарныеСчета.НомерСчета = _ЗагруженныеДанные.НомерСчета
		|				ИЛИ ДепозитарныеСчета.НомерСчета = ""00000000000000000_"" + _ЗагруженныеДанные.НомерСчета)
		|			И (НЕ ДепозитарныеСчета.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (_ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%облигаци%""
		|				ИЛИ _ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%государственные цб%""
		|				ИЛИ _ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%BOND%"")
		|			И (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И (_ЗагруженныеДанные.КодБумаги В (Облигации.ГосударственныйРегистрационныйНомер, Облигации.ГосударственныйРегистрационныйНомер + ""/"" + Облигации.НомерВыпуска))
		|			И (НЕ Облигации.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО (_ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%акция%""
		|				ИЛИ _ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%акции%""
		|				ИЛИ _ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%ORDN%"")
		|			И (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И _ЗагруженныеДанные.КодБумаги = Акции.ГосударственныйРегистрационныйНомер
		|			И (НЕ Акции.ПометкаУдаления)
		|			И (ВЫБОР
		|				КОГДА Акции.ГосударственныйРегистрационныйНомер = &ГРНАкция_ИнтерРАО
		|					ТОГДА Акции.Ссылка = &Акция_ИнтерРАО
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО (_ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%вексель%"")
		|			И (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И _ЗагруженныеДанные.КодБумаги = Векселя.Номер
		|			И (НЕ Векселя.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО (_ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%депозитарная расписка%"")
		|			И (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И _ЗагруженныеДанные.КодБумаги = ДепозитарныеРасписки.РегистрационныйНомер
		|			И (НЕ ДепозитарныеРасписки.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (_ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%пай%""
		|				ИЛИ _ЗагруженныеДанные.ТипБумаги ПОДОБНО ""%паи%"")
		|			И (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И _ЗагруженныеДанные.КодБумаги = Паи.ГосударственныйРегистрационныйНомер
		|			И (НЕ Паи.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|				&Период,
		|				ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|					И НЕ Объект.ПометкаУдаления) КАК КодыISIN
		|		ПО (НЕ _ЗагруженныеДанные.КодБумаги В ("""", ""-""))
		|			И _ЗагруженныеДанные.КодБумаги = КодыISIN.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ЗаполненныеСсылки.ДепозитарныйСчет ЕСТЬ NULL
		|			ТОГДА ""Депозитарный счет № "" + _ЗаполненныеСсылки.НомерСчета
		|		ИНАЧЕ _ЗаполненныеСсылки.ДепозитарныйСчет
		|	КОНЕЦ КАК ДепозитарныйСчет,
		|	ВЫБОР
		|		КОГДА _ЗаполненныеСсылки.ЦеннаяБумага ЕСТЬ NULL
		|			ТОГДА ""Ценная бумага ("" + _ЗаполненныеСсылки.ТипБумаги + "" "" + _ЗаполненныеСсылки.КодБумаги + "")""
		|		ИНАЧЕ _ЗаполненныеСсылки.ЦеннаяБумага
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	СУММА(_ЗаполненныеСсылки.Количество) КАК Количество
		|ПОМЕСТИТЬ _ЦенныеБумагиДепозитарий
		|ИЗ
		|	_ЗаполненныеСсылки КАК _ЗаполненныеСсылки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА _ЗаполненныеСсылки.ДепозитарныйСчет ЕСТЬ NULL
		|			ТОГДА ""Депозитарный счет № "" + _ЗаполненныеСсылки.НомерСчета
		|		ИНАЧЕ _ЗаполненныеСсылки.ДепозитарныйСчет
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _ЗаполненныеСсылки.ЦеннаяБумага ЕСТЬ NULL
		|			ТОГДА ""Ценная бумага ("" + _ЗаполненныеСсылки.ТипБумаги + "" "" + _ЗаполненныеСсылки.КодБумаги + "")""
		|		ИНАЧЕ _ЗаполненныеСсылки.ЦеннаяБумага
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ЦенныеБумагиДепозитарий.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	_ЦенныеБумагиДепозитарий.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	_ЦенныеБумагиДепозитарий КАК _ЦенныеБумагиДепозитарий
		|ГДЕ
		|	(ТИПЗНАЧЕНИЯ(_ЦенныеБумагиДепозитарий.ДепозитарныйСчет) = ТИП(СТРОКА)
		|			ИЛИ ТИПЗНАЧЕНИЯ(_ЦенныеБумагиДепозитарий.ЦеннаяБумага) = ТИП(СТРОКА))
		|ИТОГИ ПО
		|	ДепозитарныйСчет";
	
	Запрос.УстановитьПараметр("Период",					КонецДня(ДатаСверки));
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ДепозитарнаяКомпания",	ДепозитарнаяКомпания);
	Запрос.УстановитьПараметр("ЦенныеБумаги",			ЦенныеБумаги);
	
	АкцияИнтерРАО = ОбщегоНазначения.ПолучитьИменованныйОбъект("Акция_ИнтерРАО");
	ГРН	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АкцияИнтерРАО, "ГосударственныйРегистрационныйНомер");
	
	Запрос.УстановитьПараметр("Акция_ИнтерРАО", АкцияИнтерРАО);
	Запрос.УстановитьПараметр("ГРНАкция_ИнтерРАО", ГРН);
	
	// Получим результаты и оповестим об ошибках сопоставления
	
	ВыборкаОшибокСчета = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОшибокСчета.Следующий() Цикл
		
		//Если ТипЗнч(ВыборкаОшибокСчета.ДепозитарныйСчет) = Тип("Строка") Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось получить депозитарный счет '%1'", ВыборкаОшибокСчета.ДепозитарныйСчет));
		//КонецЕсли;	
		
		ВыборкаОшибокБумаг = ВыборкаОшибокСчета.Выбрать();
		
		Пока ВыборкаОшибокБумаг.Следующий() Цикл
		
			Если ТипЗнч(ВыборкаОшибокБумаг.ЦеннаяБумага) = Тип("Строка") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1: не удалось получить ценную бумагу '%2'", ВыборкаОшибокСчета.ДепозитарныйСчет, ВыборкаОшибокБумаг.ЦеннаяБумага));
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДатуИзСтрокиДДММГГГГ(ДатаТекст)
	
	Возврат Дата(Число(Прав(ДатаТекст, 4)), Число(Сред(ДатаТекст, 4, 2)), Число(Лев(ДатаТекст, 2)));
	
КонецФункции

&НаКлиенте
Функция ПолучитьДатуИзСтрокиГГГГ_ММ_ДД(ДатаТекст)
	
	СтрДата = СтрЗаменить(ДатаТекст, "-", "");
	Возврат Дата(Число(Лев(СтрДата, 4)), Число(Сред(СтрДата, 5, 2)), Число(Прав(СтрДата, 2)));
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьТабличныйДокумент(ДанныеФайла, РасширениеФайла, Отказ = Ложь)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	ДанныеФайла.Записать(ИмяВременногоФайла);	
	
	Попытка
		Результат = Новый ТабличныйДокумент;
		Результат.Прочитать(ИмяВременногоФайла);	
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
		ВызватьИсключение;		
	КонецПопытки;		
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьНомерДепозитарногоСчетаИДатуСверки(Знач ЗаголовокОтчета, ПутьКФайлуОстатков)
	
	ПараметрыСверки = Новый Структура("НомерСчета, ДатаСверки");
	
	Строка1 = "ВЫПИСКА О СОСТОЯНИИ СЧЕТА/СЧЕТА ДЕПО № ";
	Строка2 = "на конец операционного дня ";
	
	Если Найти(ЗаголовокОтчета, Строка1) = 0 ИЛИ Найти(ЗаголовокОтчета, Строка2) = 0 Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Изменился формат заголовка отчёта, не возможно прочитать файл: " + ПутьКФайлуОстатков);
		Возврат ПараметрыСверки;
	КонецЕсли;
	
	ПараметрыСверки.НомерСчета = Сред(ЗаголовокОтчета, Найти(ЗаголовокОтчета, Строка1) + СтрДлина(Строка1), 10);
	ПараметрыСверки.ДатаСверки = ПолучитьДатуИзСтрокиДДММГГГГ(Сред(ЗаголовокОтчета, Найти(ЗаголовокОтчета, Строка2) + СтрДлина(Строка2), 10));
	
	Возврат ПараметрыСверки;	
	
КонецФункции

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_БК_Регион(ПутьКФайлуОстатков)
	
	ДобавитьПустуюСтроку = Истина;
	
	Кэш = Новый Соответствие;
	ЖурналОшибок = Новый Массив;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Организация", Объект.Организация);
	ДополнительныеПараметры.Вставить("Кэш", Кэш);
	ДополнительныеПараметры.Вставить("ЖурналОшибок", ЖурналОшибок);	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	ИмяКорневогоУзла = "";
	Depo_Account_Number = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		
		Если ПустаяСтрока(ИмяКорневогоУзла) Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "DEPO_ACC_STATEMENT" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Выбранный файл не содержит остатки ценных бумаг у депозитария");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяУзла = "Header" И ЧтениеXML.ЗначениеАтрибута("q_date") <> Неопределено Тогда
			
			// Если в одном файле несколько деп.счетов 
			Если ЗначениеЗаполнено(Depo_Account_Number) Тогда
				Если ДобавитьПустуюСтроку Тогда
					СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
					СтрокаЦБ.Depo_Account_Number = Depo_Account_Number;
				КонецЕсли;
				
				ДобавитьПустуюСтроку = Истина;
			КонецЕсли;
			
			Объект.ДатаСверки = ПолучитьДатуИзСтрокиДДММГГГГ(ЧтениеXML.ЗначениеАтрибута("q_date"));
			ДополнительныеПараметры.Вставить("ДатаСверки", Объект.ДатаСверки);
			
			Depo_Account_Number = ЧтениеXML.ЗначениеАтрибута("acc_no");
			
		ИначеЕсли ИмяУзла = "Detail" И ЧтениеXML.ЗначениеАтрибута("stock_qty") <> Неопределено Тогда
			
			ДобавитьПустуюСтроку = Ложь;
			
			СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
			
			СтрокаЦБ.Security_Type                      = ЧтениеXML.ЗначениеАтрибута("stock_type");
