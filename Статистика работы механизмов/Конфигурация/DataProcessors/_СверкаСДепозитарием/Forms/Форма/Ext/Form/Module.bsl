&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_ВТБ(ПутьКФайлуОстатков)
	
	ИмяКорневогоУзла		= Неопределено;
	НомерДепозитарногоСчета	= Неопределено;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		
		// Проверяем корневой узел
		
		Если ИмяКорневогоУзла = Неопределено Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "EDO_ODKF750" Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Неверный заголовок файла: " + ПутьКФайлуОстатков);				
				Возврат;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		// Читаем остальные узлы
		
		Если ИмяУзла = "ReportOnDate" Тогда
			
			// Дата выписки
			
			ЧтениеXML.Прочитать();
			
			ДатаВыписки = ПолучитьДатуИзСтрокиДДММГГГГ(Лев(ЧтениеXML.Значение, 10));
			
			Если ДатаВыписки <> Объект.ДатаСверки Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Дата выписки не соответствует дате сверки: " + ПутьКФайлуОстатков);
				Возврат;
			КонецЕсли;			
			
		ИначеЕсли ИмяУзла = "AccountCode" Тогда
			
			// Депозитарный счет	
			
			ДобавитьПустуюСтроку = Истина;
			
			ЧтениеXML.Прочитать();
			
			НомерДепозитарногоСчета = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "Details" И НомерДепозитарногоСчета <> Неопределено  Тогда
			
			// Фиксируем начало таблицы ЦБ	
			
			ДобавитьПустуюСтроку = Ложь;
			
			СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
			СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
			
		ИначеЕсли ИмяУзла = "CBName" И СтрокаЦБ <> Неопределено И НомерДепозитарногоСчета <> Неопределено Тогда
			
			// Категория ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Type = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "GRN" И СтрокаЦБ <> Неопределено Тогда
			
			// Рег. номер ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Reg_No = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "TotalQty" И СтрокаЦБ <> Неопределено Тогда
			
			// Количество ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Количество = ЧтениеXML.Значение;
			
		КонецЕсли;

	КонецЦикла;
	
	// Если на счету нет бумаг, фиксируем, что по нему была выписка	
	
	Если ДобавитьПустуюСтроку = Истина Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_ДК_Регион(ПутьКФайлуОстатков)
	
	ИмяКорневогоУзла		= Неопределено;
	НомерДепозитарногоСчета	= Неопределено;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	СекцияНомераДепо = Ложь;

	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		
		// Проверяем корневой узел
		
		Если ИмяКорневогоУзла = Неопределено Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "DEPOACCOUNT_BALANCE_REPORT" Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Неверный заголовок файла: " + ПутьКФайлуОстатков);				
				Возврат;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		// Читаем остальные узлы
		
		Если ИмяУзла = "ReportDate" Тогда
			
			// Дата выписки
			
			ЧтениеXML.Прочитать();
			
			ДатаВыписки = ПолучитьДатуИзСтрокиГГГГ_ММ_ДД(ЧтениеXML.Значение);
			
			Если ДатаВыписки <> Объект.ДатаСверки Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Дата выписки не соответствует дате сверки: " + ПутьКФайлуОстатков);
				Возврат;
			КонецЕсли;			
			
		ИначеЕсли ИмяУзла = "DepoAccount" И Не СекцияНомераДепо Тогда
			
			// Депозитарный счет
			СекцияНомераДепо = Истина;
			Продолжить;
			
		ИначеЕсли ИмяУзла = "DepoAccount" И СекцияНомераДепо Тогда	
			
			ДобавитьПустуюСтроку = Истина;
			
			ЧтениеXML.Прочитать();
					
			НомерДепозитарногоСчета = ЧтениеXML.Значение;
						
		ИначеЕсли ИмяУзла = "Position" И НомерДепозитарногоСчета <> Неопределено  Тогда
			
			// Фиксируем начало таблицы ЦБ	
			
			ДобавитьПустуюСтроку = Ложь;
			
			СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
			СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
			
		ИначеЕсли ИмяУзла = "TypeSecurity" И СтрокаЦБ <> Неопределено И НомерДепозитарногоСчета <> Неопределено Тогда
			
			// Категория ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Type = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "RegistrationNumber" И СтрокаЦБ <> Неопределено Тогда
			
			// Рег. номер ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Reg_No = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "QuantityTotal" И СтрокаЦБ <> Неопределено Тогда
			
			// Количество ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Количество = ЧтениеXML.Значение;
			
		КонецЕсли;

	КонецЦикла;
	
	// Если на счету нет бумаг, фиксируем, что по нему была выписка	
	
	Если ДобавитьПустуюСтроку = Истина Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_Инфинитум(ПутьКФайлуОстатков)
	
	ИмяКорневогоУзла		= Неопределено;
	НомерДепозитарногоСчета	= Неопределено;
	ЭтоСекцияРаздела = Ложь;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		
		// Проверяем корневой узел
		
		Если ИмяКорневогоУзла = Неопределено Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "STATEMENT_OF_ACCOUNT" Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Неверный заголовок файла: " + ПутьКФайлуОстатков);				
				Возврат;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		// Читаем остальные узлы
		
		Если ИмяУзла = "datetime" Тогда
			
			// Дата выписки
			
			ЧтениеXML.Прочитать();
			
			ДатаВыписки = ПолучитьДатуИзСтрокиГГГГ_ММ_ДД(Лев(ЧтениеXML.Значение, 10));
			
			Если ДатаВыписки <> Объект.ДатаСверки Тогда
				ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Дата выписки не соответствует дате сверки: " + ПутьКФайлуОстатков);
				Возврат;
			КонецЕсли;			
			
		ИначеЕсли ИмяУзла = "id" И НомерДепозитарногоСчета = Неопределено Тогда
			
			// Депозитарный счет	
			
			ДобавитьПустуюСтроку = Истина;
			
			ЧтениеXML.Прочитать();
			
			НомерДепозитарногоСчета = ЧтениеXML.Значение;
							
		ИначеЕсли ИмяУзла = "security" И НомерДепозитарногоСчета <> Неопределено  Тогда
			
			// Фиксируем начало таблицы ЦБ	
			
			ДобавитьПустуюСтроку = Ложь;
			
			СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
			СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
						
		ИначеЕсли ИмяУзла = "account_section_storage_id" Тогда	
			
			ЭтоСекцияРаздела = Истина;
			Продолжить;
			
		ИначеЕсли ИмяУзла = "id" И НомерДепозитарногоСчета <> Неопределено И ЭтоСекцияРаздела Тогда	
			
			// Номер раздела
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Depo_Account_Division_Number = ЧтениеXML.Значение;
			ЭтоСекцияРаздела = Ложь;
			
		ИначеЕсли ИмяУзла = "financial_instrument_type" И СтрокаЦБ <> Неопределено И НомерДепозитарногоСчета <> Неопределено Тогда
			
			// Категория ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Type = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "state_reg_num" И СтрокаЦБ <> Неопределено Тогда
			
			// Рег. номер ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Security_Reg_No = ЧтениеXML.Значение;
			
		ИначеЕсли ИмяУзла = "units" И СтрокаЦБ <> Неопределено Тогда
			
			// Количество ЦБ	
			
			ЧтениеXML.Прочитать();
			СтрокаЦБ.Количество = ЧтениеXML.Значение;
			
		КонецЕсли;

	КонецЦикла;
	
	// Если на счету нет бумаг, фиксируем, что по нему была выписка	
	
	Если ДобавитьПустуюСтроку = Истина Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_ГПБ(ПутьКФайлуОстатков)
	
	Попытка
		ФайлДанных = Новый ТекстовыйДокумент;
		ФайлДанных.Прочитать(ПутьКФайлуОстатков);
	Исключение
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла: " + ПутьКФайлуОстатков);
		Возврат;
	КонецПопытки;
	             	
	СтрокаКлиента = ФайлДанных.ПолучитьСтроку(1);
	
	МассивПодстрок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКлиента, ";", Истина, Истина);
	Если МассивПодстрок.Количество() = 0 Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. В первой строке отсутствуют данные: " + ПутьКФайлуОстатков);
		Возврат;                                                                                                                              
	КонецЕсли;	
		
	ПозицияКодаКлиента = СтрНайти(МассивПодстрок[0], "ClientID:");
	
	Если ПозицияКодаКлиента = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить клиента: " + ПутьКФайлуОстатков);
		Возврат;
	КонецЕсли;
	
	КодКлиента = Сред(МассивПодстрок[0], ПозицияКодаКлиента);
	       
	// Определяем дату выписки                               
	СтрокаДатыВыписки = ФайлДанных.ПолучитьСтроку(7);
	
	ДатаВыписки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтрокаДатыВыписки, СтрДлина("ReportDate:") + 1, 10));
			
	Если ДатаВыписки <> Объект.ДатаСверки Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Дата выписки не соответствует дате сверки: " + ПутьКФайлуОстатков);
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовка		= ФайлДанных.ПолучитьСтроку(9);
	МассивКолонок		= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаЗаголовка, ";", Ложь, Истина); 
    КоличествоКолонок	= МассивКолонок.Количество();
		
	Для НомерСтроки = 10 По ФайлДанных.КоличествоСтрок() Цикл
		
		ДанныеСтроки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФайлДанных.ПолучитьСтроку(НомерСтроки), ";");
		
		СтруктураДанныхОбОстаткахЦБ = Новый Структура();
		
		Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
			ИмяПоля = МассивКолонок[ИндексКолонки];
									
			Если ИмяПоля = "ISIN" Или ИмяПоля = "Счет" Тогда
				СтруктураДанныхОбОстаткахЦБ.Вставить(ИмяПоля, СокрЛП(ДанныеСтроки[ИндексКолонки]));
			ИначеЕсли ИмяПоля = "Тип/вид/категория" Тогда
				СтруктураДанныхОбОстаткахЦБ.Вставить("Категория", СокрЛП(ДанныеСтроки[ИндексКолонки]));
			ИначеЕсли ИмяПоля = "Количество" Тогда
				Попытка
					СтруктураДанныхОбОстаткахЦБ.Вставить(ИмяПоля, Число(СокрЛП(ДанныеСтроки[ИндексКолонки])));
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
				
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Security_Type			= СтруктураДанныхОбОстаткахЦБ.Категория;
		СтрокаЦБ.Security_Reg_No		= СтруктураДанныхОбОстаткахЦБ.ISIN;
		СтрокаЦБ.Depo_Account_Number	= СтруктураДанныхОбОстаткахЦБ.Счет;
		СтрокаЦБ.Количество				= СтруктураДанныхОбОстаткахЦБ.Количество;
				
	КонецЦикла;
			 	
КонецПроцедуры

&НаКлиенте
Функция Контроль_ФорматаФайла(ПутьКФайлуОстатков, ДепозитарнаяКомпания, КодДепозитарнойКомпании)
	
	СтруктураПроверки = Новый Структура;
	
	Если КодДепозитарнойКомпании = "БК_Регион" Тогда
		
		СтруктураПроверки.Вставить("DEPO_ACC_STATEMENT");
		СтруктураПроверки.Вставить("Header", "q_date");
		
	ИначеЕсли КодДепозитарнойКомпании = "СДК_Гарант" Тогда
		
		СтруктураПроверки.Вставить("Report");
		СтруктураПроверки.Вставить("TablixHeader", "Header");
		
	ИначеЕсли КодДепозитарнойКомпании = "ВТБ_СпецДеп" Тогда
		
		СтруктураПроверки.Вставить("EDO_ODKF750");
		СтруктураПроверки.Вставить("ReportOnDate");
		СтруктураПроверки.Вставить("AccountCode");
		
	ИначеЕсли КодДепозитарнойКомпании = "ДК_Регион" Тогда
		
		СтруктураПроверки.Вставить("DEPOACCOUNT_BALANCE_REPORT");	
		
	ИначеЕсли КодДепозитарнойКомпании = "Инфинитум_СпецДеп" Тогда	
		
		СтруктураПроверки.Вставить("datetime");	
		
	ИначеЕсли (КодДепозитарнойКомпании = "РСД" Или КодДепозитарнойКомпании = "НСД")
		И НРег(Прав(ПутьКФайлуОстатков, 4)) = "xlsx"	
		
	Тогда
	
	ИначеЕсли КодДепозитарнойКомпании = "ГПБ"
		И НРег(Прав(ПутьКФайлуОстатков, 3)) = "csv"		
				
	Тогда
	
		Возврат Истина; // контроль формата XLSX и csv не выполняем
		
	Иначе
		
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Не описана схема загрузки: " + ПутьКФайлуОстатков);
		Возврат Ложь;
		
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла		= ЧтениеXML.Имя;
		ИмяАтрибута = "";
		Если СтруктураПроверки.Свойство(ИмяУзла, ИмяАтрибута) Тогда
			Если ЗначениеЗаполнено(ИмяАтрибута) Тогда
				Если ЧтениеXML.ЗначениеАтрибута(ИмяАтрибута) <> Неопределено Тогда
					СтруктураПроверки.Удалить(ИмяУзла);
				КонецЕсли;
			Иначе
				СтруктураПроверки.Удалить(ИмяУзла);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	ПрошелПроверку =  СтруктураПроверки.Количество() = 0;
	
	Если НЕ ПрошелПроверку Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Обнаружен файл с неизвестным форматом: " + ПутьКФайлуОстатков);
	КонецЕсли;
	
	Возврат ПрошелПроверку;
	
КонецФункции

&НаКлиенте
Функция Контроль_КодаДепозитарнойКомпании(ДепозитарнаяКомпания, КодДепозитарнойКомпании)
	
	Если НЕ ЗначениеЗаполнено(КодДепозитарнойКомпании) Тогда
		 ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Не заполнен код во внешней системе!");
	КонецЕсли;
	 
	Возврат ЗначениеЗаполнено(КодДепозитарнойКомпании);
	
КонецФункции	

&НаКлиенте
Функция Контроль_СуществованияКаталога(ДепозитарнаяКомпания, КаталогДанных)
	
	Если Не ЗначениеЗаполнено(КаталогДанных) Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "В дополнительных сведениях организации не указан каталог выгрузки!");
		Возврат Ложь;
	КонецЕсли;
	
	Каталог = Новый Файл(КаталогДанных);
	КаталогСуществует = Каталог.Существует();
	
	Если НЕ КаталогСуществует Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Не найден каталог: '" + КаталогДанных + "'");
	КонецЕсли;
	
	Возврат КаталогСуществует;
	
КонецФункции	

&НаКлиенте
Функция НайтиФайлыВыписок(КаталогДанных, КодДепозитарнойКомпании)
	
	Если КодДепозитарнойКомпании = "РСД" Или КодДепозитарнойКомпании = "НСД" Тогда
		НайденныеФайлы = НайтиФайлы(КаталогДанных, "*.xlsx", Ложь);
	ИначеЕсли КодДепозитарнойКомпании = "ГПБ" Тогда
		НайденныеФайлы = НайтиФайлы(КаталогДанных, "*.csv", Ложь);
	Иначе
		НайденныеФайлы = НайтиФайлы(КаталогДанных, "*.xml", Ложь);
	КонецЕсли;
	
	Возврат НайденныеФайлы;	
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьДанныеИзФайлов(ДепозитарнаяКомпания, КодДепозитарнойКомпании)
	
	ДанныеЗагружены = Ложь;
	
	Если Контроль_КодаДепозитарнойКомпании(ДепозитарнаяКомпания, КодДепозитарнойКомпании) Тогда
		КаталогДанных = ПолучитьКаталогДанных(Объект.Организация, КодДепозитарнойКомпании, Объект.ДатаСверки, КаталогДанных);
		
		Если Контроль_СуществованияКаталога(ДепозитарнаяКомпания, КаталогДанных) Тогда
			ВывестиИнформациюНаКлиенте("КаталогДанных", КаталогДанных);
			
			НайденныеФайлы = НайтиФайлыВыписок(КаталогДанных, КодДепозитарнойКомпании);
			
			Для Каждого Файл Из НайденныеФайлы Цикл
				
				Если Контроль_ФорматаФайла(Файл.ПолноеИмя, ДепозитарнаяКомпания, КодДепозитарнойКомпании) Тогда
					
					Если КодДепозитарнойКомпании = "БК_Регион" Тогда
						
						ПрочитатьОстаткиИзФайлов_БК_Регион(Файл.ПолноеИмя);
						
					ИначеЕсли КодДепозитарнойКомпании = "СДК_Гарант" Тогда
						
						ПрочитатьОстаткиИзФайлов_СДК_Гарант(Файл.ПолноеИмя);
						
					ИначеЕсли КодДепозитарнойКомпании = "РСД" Тогда
						
						ПрочитатьОстаткиИзФайлов_РСД(Файл.ПолноеИмя);
						
					ИначеЕсли КодДепозитарнойКомпании = "НСД" Тогда
						
						ПрочитатьОстаткиИзФайлов_НСД(Файл.ПолноеИмя);						
						
					ИначеЕсли КодДепозитарнойКомпании = "ДК_Регион" Тогда
						
						ПрочитатьОстаткиИзФайлов_ДК_Регион(Файл.ПолноеИмя);
												
					ИначеЕсли КодДепозитарнойКомпании = "ВТБ_СпецДеп" Тогда
						
						ПрочитатьОстаткиИзФайлов_ВТБ(Файл.ПолноеИмя);
						
					ИначеЕсли КодДепозитарнойКомпании = "Инфинитум_СпецДеп" Тогда
						
						ПрочитатьОстаткиИзФайлов_Инфинитум(Файл.ПолноеИмя); 
						
					ИначеЕсли КодДепозитарнойКомпании = "ГПБ" Тогда
						
						ПрочитатьОстаткиИзФайлов_ГПБ(Файл.ПолноеИмя);	
						
					КонецЕсли;
					
					ДанныеЗагружены = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДанныеЗагружены;
	
КонецФункции

&НаКлиенте
Процедура ВывестиИнформациюНаКлиенте(Ключ, Источник = "", ГруппировкаСтрок = 0)
	
	НоваяСтрока = ИнформацияДляВывода.Добавить();
	НоваяСтрока.Ключ				= Ключ;
	НоваяСтрока.Источник			= Источник;
	НоваяСтрока.ГруппировкаСтрок	= ГруппировкаСтрок;
	
КонецПроцедуры	

&НаСервере
Процедура ВывестиИнформацию(Ключ, Источник, ГруппировкаСтрок = 0, ВыводИзТаблицы = Ложь)
	
	Если НЕ ВыводИзТаблицы Тогда
		Для Каждого СтрокаИнформацииДляВывода Из ИнформацияДляВывода Цикл
			ВывестиИнформацию(СтрокаИнформацииДляВывода.Ключ, СтрокаИнформацииДляВывода.Источник, СтрокаИнформацииДляВывода.ГруппировкаСтрок, Истина)
		КонецЦикла;	
		ИнформацияДляВывода.Очистить();
	КонецЕсли;
	
	Макет	= РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	Область = Макет.ПолучитьОбласть(Ключ);
	
	Если Ключ = "ОписаниеОшибки"
		ИЛИ Ключ = "ОписаниеВажнойОшибки"	
		ИЛИ Ключ = "Депозитарий"
		ИЛИ Ключ = "КаталогДанных"
	Тогда
		Область.Параметры.Параметр = Источник;
	ИначеЕсли Ключ = "Заголовок" Тогда
		Результат.Очистить();
	ИначеЕсли Ключ <> "ПустаяСтрока" И Ключ <> "РасхожденияПодвал" Тогда
		ЗаполнитьЗначенияСвойств(Область.Параметры, Источник);
	КонецЕсли;
	
	Результат.Вывести(Область);		
	
	Если Ключ = "Расхождения" Тогда
		ВыборкаЦенныеБумаги = Источник.Выбрать();
		Пока ВыборкаЦенныеБумаги.Следующий() Цикл
			Если ВыборкаЦенныеБумаги.ИмяОбласти <> "1_РасхожденийНет" Тогда
				ВывестиИнформацию("Строка", ВыборкаЦенныеБумаги)
			КонецЕсли;
		КонецЦикла;
		ВывестиИнформацию("РасхожденияПодвал", "");
	КонецЕсли;
	
	Если ГруппировкаСтрок = 1 Тогда
		Результат.НачатьГруппуСтрок();
	ИначеЕсли ГруппировкаСтрок = 2 Тогда
		Результат.ЗакончитьГруппуСтрок();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасхожденияПоДепозитарнымСчетамКлиентов(ДепозитарныеСчетаКлиентов, ДепозитарныйСчет, ДанныеОтчетаОСверке)
	
	// СТРОКА или НЕОПРЕДЕЛЕНО
	Если Не (ТипЗнч(ДепозитарныйСчет) = Тип("СправочникСсылка.ДепозитарныеСчета") И ЗначениеЗаполнено(ДепозитарныйСчет)) Тогда
		Возврат;
	КонецЕсли;
	
	КлиентыСДепозитарнымСчетом = ДепозитарныеСчетаКлиентов.НайтиСтроки(Новый Структура("ДепозитарныйСчет", ДанныеОтчетаОСверке.ДепозитарныйСчет));
	
	Для Каждого ДанныеКлиента Из КлиентыСДепозитарнымСчетом Цикл
		
		ДанныеКлиента.СверкаВыполнена = Истина;
		
		Если ДанныеОтчетаОСверке.ИмяОбласти <> "РасхожденийНет" Тогда
			
			ПредставлениеРасхождений = "";
			
			Если ДанныеОтчетаОСверке.ИмяОбласти = "РасхожденийНетСвереноВручную" Тогда
				
				ПредставлениеРасхождений = "сверен вручную";
				
			Иначе	
				
				ДанныеКлиента.ЕстьРасхождения = Истина;
				
				Если ДанныеОтчетаОСверке.ИмяОбласти = "НетСчетаВВыгрузке" Тогда
					ПредставлениеРасхождений = "не обнаружен в выгрузке депозитария";
				ИначеЕсли ДанныеОтчетаОСверке.ИмяОбласти = "Расхождения" Тогда
					ПредставлениеРасхождений = "расхождения по остаткам ";		
					
					ВыборкаЦенныеБумаги = ДанныеОтчетаОСверке.Выбрать();
					Пока ВыборкаЦенныеБумаги.Следующий() Цикл
						Если ВыборкаЦенныеБумаги.ИмяОбласти <> "1_РасхожденийНет" Тогда
							ПредставлениеРасхождений = ПредставлениеРасхождений + Строка(ВыборкаЦенныеБумаги.ЦеннаяБумага);
							
							Если ВыборкаЦенныеБумаги.Следующий() Тогда
								ПредставлениеРасхождений = ПредставлениеРасхождений + " и др."		
							КонецЕсли;
							
							Прервать;
						КонецЕсли;
					КонецЦикла;
				Иначе
					ПредставлениеРасхождений = ДанныеОтчетаОСверке.ИмяОбласти;
				КонецЕсли;
				
			КонецЕсли;
			
			ДанныеКлиента.Примечание = Строка(ДанныеОтчетаОСверке.ДепозитарныйСчет) + ": " + ПредставлениеРасхождений;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьРезультатыСверки(ДепозитарныеСчетаКлиентов, ДепозитарнаяКомпания, НетСчетаВ1С)
	
	// Считаем клиента сверенным по депозитарию,
	// если все его депозитарные счета сверены и ни по одному из них нет расхождений.
	// Но если в отчете депозитария есть депозитарные счета не найденные в 1С,
	// сверка не будет пройдена ни по кому.
		
	ПараметрыОтчетаОПодтвержденныхОперациях = Неопределено;
	
	Если ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений И ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда 
		
		ПараметрыОтчетаОПодтвержденныхОперациях = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(ДепозитарнаяКомпания, , , ЭтаФорма.ОтчетОПодтвержденныхОперациях);
		
		ЭтаФорма.ОтчетОПодтвержденныхОперациях.НачатьГруппуСтрок();
		
	КонецЕсли;	
	
	ДепозитарныеСчетаКлиентов.Сортировать("СчетДоверительногоУправления, ЕстьРасхождения УБЫВ", Новый СравнениеЗначений);
	
	Клиенты = ДепозитарныеСчетаКлиентов.Скопировать(Неопределено, "СчетДоверительногоУправления");
	Клиенты.Свернуть("СчетДоверительногоУправления");

	Для Каждого Клиент Из Клиенты Цикл
		
		СверкаПройденаУспешно	= Истина;
		Примечание				= "";
		
		Если НетСчетаВ1С Тогда
			СверкаПройденаУспешно	= Ложь;
			Примечание				= "Ошибка сверки: не все депозитарные счета из отчета депозитария найдены в 1С";
		Иначе
			ДепозитарныеСчетаКлиента = ДепозитарныеСчетаКлиентов.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", Клиент.СчетДоверительногоУправления));
			Для Каждого ДанныеКлиента Из ДепозитарныеСчетаКлиента Цикл
				Если ДанныеКлиента.ЕстьРасхождения Тогда 
					СверкаПройденаУспешно = Ложь;
				КонецЕсли;
				Если ЗначениеЗаполнено(ДанныеКлиента.Примечание) Тогда
					Примечание = ?(ПустаяСтрока(Примечание), "", Примечание + "; ") + ДанныеКлиента.Примечание;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ОснованиеСверки = ОтчетыДепозитарныхКомпаний.Получить(ДепозитарнаяКомпания);
		Если ОснованиеСверки = Неопределено Тогда
			ОснованиеСверки = ДепозитарнаяКомпания;
		КонецЕсли;
		
		// Результат сверки
		
		Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
			РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
				Объект.Организация,
				Клиент.СчетДоверительногоУправления,
				Объект.ДатаСверки,
				ОснованиеСверки,
				СверкаПройденаУспешно,
				Ложь,
				ЭтаФорма.ВремяСверки,
				Примечание
			);
		КонецЕсли;
		
		// Подтверждение операций депозитария
		
		Если СверкаПройденаУспешно И ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений Тогда
			ПодтвердитьОперацииСДепозитарием(
				Объект.Организация,
				Клиент.СчетДоверительногоУправления,
				ДепозитарнаяКомпания,
				Объект.ДатаСверки,
				ПараметрыОтчетаОПодтвержденныхОперациях
			);		
		КонецЕсли;
		
	КонецЦикла;	
	
	Если ЭтаФорма.ПодтвердитьОперацииСДепозитариямиПриОтсутствииРасхождений И ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда 
		ЭтаФорма.ОтчетОПодтвержденныхОперациях.ЗакончитьГруппуСтрок();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодтвердитьОперацииСДепозитарием(Организация, СчетДоверительногоУправления, ДепозитарнаяКомпания, ДатаОпераций, ПараметрыОтчета = Неопределено)
	
	ПодтвержденныеОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПодтвердитьОперацииСДепозитарием(Организация, СчетДоверительногоУправления, ДепозитарнаяКомпания, ДатаОпераций, КонецДня(ДатаОпераций));  	
	
	Если ПараметрыОтчета = Неопределено ИЛИ ПодтвержденныеОперации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТаблицы = Новый Структура("ПредставлениеОперации, ДатаПодтверждения, Примечание", "Операция", "Время подтверждения", "Примечание");
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(
			"Отчет о подтвержденных операциях",,, ПараметрыОтчета.ДокументРезультат);
			
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
		ПараметрыВывода,
		ПодтвержденныеОперации,
		СтруктураТаблицы,
		Строка(СчетДоверительногоУправления),
		Ложь,
		Истина
	);
	
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьКДатеРабочиеДни(Дата, РабочиеДни)
	
	Возврат Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Дата, РабочиеДни);
	
КонецФункции

&НаСервере
Процедура ДобавитьВСверенныеВручную(ДепозитарныеСчета)
	
	МассивСчетов = Новый Массив;
	
	РаботаСКоллекциями.ДополнитьМассив(МассивСчетов, ДепозитарныеСчета, Истина);
	
	Для каждого ДепозитарныйСчет Из МассивСчетов Цикл
		Если СверенныеВручнуюДепозитарныеСчета.НайтиСтроки(Новый Структура("ДепозитарныйСчет", ДепозитарныйСчет)).Количество() = 0 Тогда 	
			СверенныеВручнуюДепозитарныеСчета.Добавить().ДепозитарныйСчет = ДепозитарныйСчет;	
		КонецЕсли;		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНачалоСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики)
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	
	ПолноеИмяОтчета = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя();
	СессияСбораСтатистики   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		ПолноеИмяОтчета,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессииНаСервере(ПолноеИмяОтчета, СессияСбораСтатистики)

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики); 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	СтрСохраняемыеДанные = "ДатаСверки,Организация,Депозитарий";
	ПараметрыОтчета = Новый Структура(СтрСохраняемыеДанные);
	ЗаполнитьЗначенияСвойств(ПараметрыОтчета, Объект);
	
	Описание = "";
	
	Для каждого Реквизит Из СтрРазделить(СтрСохраняемыеДанные, ",") Цикл
	
		Описание = Описание + Символы.ПС + Реквизит + ": " + ПараметрыОтчета[Реквизит];
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

#КонецОбласти