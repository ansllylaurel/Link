			СтрокаЦБ.Количество                         = Число(ЧтениеXML.ЗначениеАтрибута("stock_qty"));
			
		КонецЕсли;

	КонецЦикла;
	
	Если ДобавитьПустуюСтроку Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = Depo_Account_Number;
