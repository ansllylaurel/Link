КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_СДК_Гарант(ПутьКФайлуОстатков)
	
	ДобавитьПустуюСтроку = Истина;
	
	Кэш = Новый Соответствие;
	ЖурналОшибок = Новый Массив;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Организация", Объект.Организация);
	ДополнительныеПараметры.Вставить("Кэш", Кэш);
	ДополнительныеПараметры.Вставить("ЖурналОшибок", ЖурналОшибок);	
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуОстатков);
	
	ИмяКорневогоУзла = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = ЧтениеXML.Имя;
		
		Если ПустаяСтрока(ИмяКорневогоУзла) Тогда
			ИмяКорневогоУзла = ИмяУзла;
			
			Если ИмяКорневогоУзла <> "Report" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Выбранный файл не содержит остатки ценных бумаг у депозитария");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяУзла = "TablixHeader" Тогда
			
			ПараметрыСверки = ПолучитьНомерДепозитарногоСчетаИДатуСверки(ЧтениеXML.ЗначениеАтрибута("Header"), ПутьКФайлуОстатков);
			
			Объект.ДатаСверки = ПараметрыСверки.ДатаСверки;
			ДополнительныеПараметры.Вставить("ДатаСверки", Объект.ДатаСверки);
			
			Depo_Account_Number = ПараметрыСверки.НомерСчета;
			
		ИначеЕсли ИмяУзла = "Information" И ЧтениеXML.ЗначениеАтрибута("FinToolCount") <> Неопределено И ЧтениеXML.ЗначениеАтрибута("FinToolCount") <> "0" Тогда
			
			ДобавитьПустуюСтроку = Ложь;
			
			СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
			
			СтрокаЦБ.Security_Type                      = ЧтениеXML.ЗначениеАтрибута("StockType");
			СтрокаЦБ.Security_Reg_No                    = ЧтениеXML.ЗначениеАтрибута("StockNumber");
			СтрокаЦБ.Depo_Account_Number                = Depo_Account_Number;
			СтрокаЦБ.Количество                         = Число(ЧтениеXML.ЗначениеАтрибута("FinToolCount"));
			
		КонецЕсли;

	КонецЦикла;
	
	Если ДобавитьПустуюСтроку Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = Depo_Account_Number;
	КонецЕсли;
	
	Для каждого ТекстОшибки Из ДополнительныеПараметры.ЖурналОшибок Цикл
		Сообщить(ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОстаткиИзФайлов_РСД(ПутьКФайлуОстатков)
	
	Попытка
		ФайлДанных = ПрочитатьТабличныйДокумент(Новый ДвоичныеДанные(ПутьКФайлуОстатков), "xlsx");  
	Исключение
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла: " + ПутьКФайлуОстатков);
		Возврат;
	КонецПопытки;
	
	// Определяем дату выписки и депозитарный счет	
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("по состоянию на ", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить дату выписки: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		ДатаВыписки = Дата(Сред(ОбластьПоЗначению.Текст, СтрДлина("по состоянию на ") + 1) + " 00:00:00");
		
		Если ДатаВыписки <> Объект.ДатаСверки Тогда
			ВывестиИнформациюНаКлиенте("ОписаниеОшибки", "Дата выписки не соответствует дате сверки: " + ПутьКФайлуОстатков);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("Счет депо:", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить номер счета депо: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		НомерДепозитарногоСчета = ФайлДанных.Область(ОбластьПоЗначению.Верх, ОбластьПоЗначению.Право + 1, ОбластьПоЗначению.Верх, ОбластьПоЗначению.Право + 1).Текст;
		ДобавитьПустуюСтроку	= Истина;	
	КонецЕсли;
	
	// Ищем ключевые колонки таблицы ЦБ
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("Вид/категория (тип) ценных бумаг", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить столбец 'Вид/категория (тип) ценных бумаг' таблицы ценных бумаг: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		КолонкаКатегория	= ОбластьПоЗначению.Лево;
		НачалоТаблицыЦБ		= ОбластьПоЗначению.Низ + 1;
	КонецЕсли;	
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("Гос. рег. № выпуска", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить столбец 'Гос. рег. № выпуска' таблицы ценных бумаг: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		КолонкаРегНомер	= ОбластьПоЗначению.Лево;
	КонецЕсли;	
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("ISIN", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить столбец 'ISIN' таблицы ценных бумаг: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		КолонкаISIN		= ОбластьПоЗначению.Лево;
	КонецЕсли;
	
	ОбластьПоЗначению = ФайлДанных.НайтиТекст("Количество ЦБ, шт.", , , Истина, Ложь, Истина, Истина);
	Если ОбластьПоЗначению = Неопределено Тогда
		ВывестиИнформациюНаКлиенте("ОписаниеВажнойОшибки", "Ошибка формата файла. Не удалось определить столбец 'Количество' таблицы ценных бумаг: " + ПутьКФайлуОстатков);
		Возврат;
	Иначе
		КолонкаКоличество = ОбластьПоЗначению.Лево;
	КонецЕсли;
	
	// Читаем таблицу ЦБ	
	
	ВысотаТаблицы = ФайлДанных.ВысотаТаблицы;
	
	Пока НачалоТаблицыЦБ < ВысотаТаблицы Цикл		
		Категория	= ФайлДанных.Область(НачалоТаблицыЦБ, КолонкаКатегория).Текст;
		РегНомер	= ФайлДанных.Область(НачалоТаблицыЦБ, КолонкаРегНомер).Текст;
		ISIN		= ФайлДанных.Область(НачалоТаблицыЦБ, КолонкаISIN).Текст;
		Количество	= ФайлДанных.Область(НачалоТаблицыЦБ, КолонкаКоличество).Текст;
		
		Если ПустаяСтрока(Категория) Тогда
			Прервать;
		КонецЕсли;
		
		ДобавитьПустуюСтроку = Ложь;
		
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Security_Type			= Категория;
		СтрокаЦБ.Security_Reg_No		= ?(ПустаяСтрока(РегНомер), ISIN, РегНомер);
		СтрокаЦБ.Depo_Account_Number	= НомерДепозитарногоСчета;
		СтрокаЦБ.Количество				= Число(Количество);
		
		НачалоТаблицыЦБ = НачалоТаблицыЦБ + 1;	
	КонецЦикла;
	
	// Если на счету нет бумаг, фиксируем, что по нему была выписка	
	
	Если ДобавитьПустуюСтроку Тогда
		СтрокаЦБ = Объект.ЦенныеБумаги.Добавить();
		СтрокаЦБ.Depo_Account_Number = НомерДепозитарногоСчета;
	КонецЕсли;
	
КонецПроцедуры

