
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ТекущаяОрганизация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Если ТекущаяОрганизация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации [" + ТекущаяОрганизация.Наименование + "] не предусмотренно создание поручений для клиентов ИИС.");
		Возврат;
	Иначе
		Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.Организация = ТекущаяОрганизация;
		КонецЕсли;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	Если Объект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации [" + Объект.Организация.Наименование + "] не предусмотренно создание поручений для клиентов ИИС.");
		Возврат;
	КонецЕсли;
	
	//Если у клиента на р/счетах отсутствуют ДС по умолчанию выбираем счет ГПБ РС_Клиентов_ИИС
	Если Не ЗначениеЗаполнено(Объект.РасчетныйСчетПоУмолчанию) Тогда
		Объект.РасчетныйСчетПоУмолчанию = ОбщегоНазначения.ПолучитьИменованныйОбъект("РС_Клиентов_ИИС");
		
		Если Не ЗначениеЗаполнено(Объект.РасчетныйСчетПоУмолчанию) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить расчетный счет для клиентов ИИС по наименованию [РС_Клиентов_ИИС].");
		КонецЕсли;
	КонецЕсли;
		
	Объект.ВидЗадолженности.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ВидыЗадолженности");
	Объект.ВидЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
		
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда	
		ЗаполнитьТаблицуДанныхФормыНаСервере();
	КонецЕсли;
	
КонецПроцедуры //ПриСозданииНаСервере

&НаСервере
Процедура ЗаполнитьТаблицуДанныхФормыНаСервере();
	
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = &ИндивидуальнаяСтратегия
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ИндивидуальнаяСтратегия
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|			ИЛИ СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И (&Стратегия = ЗНАЧЕНИЕ(Справочник.СтратегииИндивидуальногоИнвестирования.)
		|			ИЛИ &Стратегия = СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия)
		|
		|СГРУППИРОВАТЬ ПО
		|	СчетаДоверительногоУправления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	_СчетаДУ.ИндивидуальнаяСтратегия КАК ИндивидуальнаяСтратегия
		|ПОМЕСТИТЬ _ЗадолженностиПоДенежнымСредствам
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И ВидЗадолженности В (&ЗадолженностиПоВознаграждению, &ЗадолженностиПоСделкам)
		|					И Валюта = &РоссийскийРубль) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО _СчетаДУ.Ссылка = ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплатыПлановая,
		|	СУММА(ЗадолженностиПоДенежнымСредствам.СуммаОстаток) КАК СуммаОстаток,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.СуммаКупонаОстаток, 0)) КАК СуммаКупонаОстаток
		|ПОМЕСТИТЬ _СуммыКПоступлению
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И ВалютаОплаты = &РоссийскийРубль) КАК УсловияСделокСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = УсловияСделокСрезПоследних.СчетДоверительногоУправления
		|			И ЗадолженностиПоДенежнымСредствам.Основание = УсловияСделокСрезПоследних.Сделка
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В(&ЗадолженностиПоСделкам)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.ДатаОплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СуммыКПоступлениюТПлюс1.СчетДоверительногоУправления, СуммыКПоступлениюТПлюс2.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	СуммыКПоступлениюТПлюс1.Сумма КАК СуммаПоступленияТПлюс1,
		|	СуммыКПоступлениюТПлюс1.ДатаОплатыПлановая КАК ДатаТПлюс1,
		|	СуммыКПоступлениюТПлюс2.Сумма КАК СуммаПоступленияТПлюс2,
		|	СуммыКПоступлениюТПлюс2.ДатаОплатыПлановая КАК ДатаТПлюс2
		|ПОМЕСТИТЬ _СуммыКПоступлениюПоДатам
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СуммыКПоступлению.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_СуммыКПоступлению.ДатаОплатыПлановая КАК ДатаОплатыПлановая,
		|		_СуммыКПоступлению.СуммаОстаток + _СуммыКПоступлению.СуммаКупонаОстаток КАК Сумма
		|	ИЗ
		|		_СуммыКПоступлению КАК _СуммыКПоступлению
		|	ГДЕ
		|		_СуммыКПоступлению.ДатаОплатыПлановая = &ДатаТПлюс1) КАК СуммыКПоступлениюТПлюс1
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СуммыКПоступлению.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			_СуммыКПоступлению.ДатаОплатыПлановая КАК ДатаОплатыПлановая,
		|			_СуммыКПоступлению.СуммаОстаток + _СуммыКПоступлению.СуммаКупонаОстаток КАК Сумма
		|		ИЗ
		|			_СуммыКПоступлению КАК _СуммыКПоступлению
		|		ГДЕ
		|			_СуммыКПоступлению.ДатаОплатыПлановая = &ДатаТПлюс2) КАК СуммыКПоступлениюТПлюс2
		|		ПО СуммыКПоступлениюТПлюс1.СчетДоверительногоУправления = СуммыКПоступлениюТПлюс2.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ЕСТЬNULL(_ЗадолженностиПоДенежнымСредствам.СуммаОстаток, 0) + ЕСТЬNULL(_ЗадолженностиПоДенежнымСредствам.СуммаКупонаОстаток, 0)) КАК СуммаОстаток
		|ПОМЕСТИТЬ _СуммыКСписанию
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствам КАК _ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	_ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	И _ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В(&ЗадолженностиПоСделкам)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЗадолженностиПоДенежнымСредствам.СуммаОстаток КАК СуммаОстаток,
		|	ВЫБОР
		|		КОГДА НЕ _ЗадолженностиПоДенежнымСредствам.СуммаОстаток ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА _ЗадолженностиПоДенежнымСредствам.СуммаОстаток <= 100
		|						ТОГДА _ЗадолженностиПоДенежнымСредствам.СуммаОстаток * 0.2
		|					ИНАЧЕ 100
		|				КОНЕЦ
		|	КОНЕЦ КАК ФиксированныйОстаток,
		|	_ЗадолженностиПоДенежнымСредствам.ИндивидуальнаяСтратегия КАК ИндивидуальнаяСтратегия
		|ПОМЕСТИТЬ _ЗадолженностиПоВознаграждению
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствам КАК _ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	_ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	И _ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В(&ЗадолженностиПоВознаграждению)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет КАК Расчетныйсчет,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(ДенежныеСредстваМНООстатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиНаСчетах
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				И Валюта = &РоссийскийРубль
		|				И Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_Задолженности.СчетДоверительногоУправления
		|					ИЗ
		|						_ЗадолженностиПоВознаграждению КАК _Задолженности)) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_Задолженности.СчетДоверительногоУправления
		|						ИЗ
		|							_ЗадолженностиПоВознаграждению КАК _Задолженности)) КАК ДенежныеСредстваМНООстатки
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = ДенежныеСредстваМНООстатки.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.РасчетныйСчет = ДенежныеСредстваМНООстатки.РасчетныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(_СуммыКСписанию.СуммаОстаток, 0) КАК ДоступнаяСумма,
		|	ЕСТЬNULL(_СуммыКСписанию.СуммаОстаток, 0) КАК Заблокировано,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК ОбщаяСумма
		|ПОМЕСТИТЬ _ОстаткиУБрокера
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И МестоХранения = &ММВБ_ТПлюс
		|				И Валюта = &РоссийскийРубль
		|				И Брокер = &БрокерБКРегион
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_Задолженности.СчетДоверительногоУправления
		|					ИЗ
		|						_ЗадолженностиПоВознаграждению КАК _Задолженности)) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СуммыКСписанию КАК _СуммыКСписанию
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = _СуммыКСписанию.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиНаСчетах.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиНаСчетах.Расчетныйсчет КАК Расчетныйсчет,
		|	_ОстаткиНаСчетах.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиМаксимумНаСчетах
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОстаткиНаСчетах.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МАКСИМУМ(_ОстаткиНаСчетах.СуммаОстаток) КАК МаксимальнаяСумма
		|	ИЗ
		|		_ОстаткиНаСчетах КАК _ОстаткиНаСчетах
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОстаткиНаСчетах.СчетДоверительногоУправления) КАК ОстаткиМаксимум
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиНаСчетах КАК _ОстаткиНаСчетах
		|		ПО ОстаткиМаксимум.СчетДоверительногоУправления = _ОстаткиНаСчетах.СчетДоверительногоУправления
		|			И ОстаткиМаксимум.МаксимальнаяСумма = _ОстаткиНаСчетах.СуммаОстаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Задолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ОстаткиМаксимумНаСчетах.СуммаОстаток, 0) >= _Задолженности.СуммаОстаток
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК НедостаточноСредствНаСчете,
		|	_Задолженности.СуммаОстаток - ЕСТЬNULL(_ОстаткиМаксимумНаСчетах.СуммаОстаток, 0) КАК СуммаПеревода,
		|	_Задолженности.СуммаОстаток + _Задолженности.ФиксированныйОстаток - ЕСТЬNULL(_ОстаткиМаксимумНаСчетах.СуммаОстаток, 0) КАК НеобходимаяСуммаУБрокера,
		|	_Задолженности.ФиксированныйОстаток КАК ФиксированныйОстаток,
		|	ВЫБОР
		|		КОГДА _ОстаткиМаксимумНаСчетах.Расчетныйсчет ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА _Задолженности.ИндивидуальнаяСтратегия
		|						ТОГДА ЕСТЬNULL(ИсполнителиДляИндивидуальнойСтратегии.РасчетныйСчет, ИсполнителиПоДС.РасчетныйСчет)
		|					ИНАЧЕ ИсполнителиПоДС.РасчетныйСчет
		|				КОНЕЦ
		|		ИНАЧЕ _ОстаткиМаксимумНаСчетах.Расчетныйсчет
		|	КОНЕЦ КАК РасчетныйСчет,
		|	_Задолженности.СуммаОстаток КАК СуммаЗадолженности,
		|	_ОстаткиМаксимумНаСчетах.СуммаОстаток КАК СуммаМаксимумНаСчетах
		|ПОМЕСТИТЬ _ДанныеДляПоручений
		|ИЗ
		|	_ЗадолженностиПоВознаграждению КАК _Задолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиМаксимумНаСчетах КАК _ОстаткиМаксимумНаСчетах
		|		ПО _Задолженности.СчетДоверительногоУправления = _ОстаткиМаксимумНаСчетах.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|		ИЗ
		|			РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ГДЕ
		|			ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|			И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &СчетПоУмолчанию
		|			И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &ДатаНачала
		|					ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))) КАК ИсполнителиПоДС
		|		ПО _Задолженности.СчетДоверительногоУправления = ИсполнителиПоДС.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|		ИЗ
		|			РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ГДЕ
		|			ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|			И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &СчетИндивидуальнойСтратегии
		|			И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &ДатаНачала
		|					ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))) КАК ИсполнителиДляИндивидуальнойСтратегии
		|		ПО _Задолженности.СчетДоверительногоУправления = ИсполнителиДляИндивидуальнойСтратегии.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоручениеНаПереводДенежныхСредств.Ссылка КАК Ссылка,
		|	ПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПоручениеНаПереводДенежныхСредств.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ПоручениеНаПереводДенежныхСредств.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ПорученияНаПеревод
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ПоручениеНаПереводДенежныхСредств
		|ГДЕ
		|	ПоручениеНаПереводДенежныхСредств.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ПоручениеНаПереводДенежныхСредств.Организация = &Организация
		|	И ПоручениеНаПереводДенежныхСредств.Брокер = &БрокерБКРегион
		|	И ПоручениеНаПереводДенежныхСредств.МестоХранения = &ММВБ_ТПлюс
		|	И ПоручениеНаПереводДенежныхСредств.Валюта = &РоссийскийРубль
		|	И НЕ ПоручениеНаПереводДенежныхСредств.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДляПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеДляПоручений.СчетДоверительногоУправления.Наименование КАК СчетДоверительногоУправленияНаименование,
		|	_ДанныеДляПоручений.РасчетныйСчет КАК Расчетныйсчет,
		|	_ДанныеДляПоручений.СуммаПеревода КАК СуммаПеревода,
		|	ЕСТЬNULL(_ОстаткиУБрокера.ДоступнаяСумма, 0) КАК СвободныйОстатокУБрокера,
		|	ЕСТЬNULL(_ОстаткиУБрокера.ОбщаяСумма, 0) КАК ОбщийОстатокУБрокера,
		|	ЕСТЬNULL(_ОстаткиУБрокера.Заблокировано, 0) КАК ЗаблокированоУБрокера,
		|	_ДанныеДляПоручений.НеобходимаяСуммаУБрокера КАК НеобходимаяСуммаУБрокера,
		|	ВЫБОР
		|		КОГДА _ДанныеДляПоручений.НеобходимаяСуммаУБрокера > ЕСТЬNULL(_ОстаткиУБрокера.ДоступнаяСумма, 0)
		|			ТОГДА _ДанныеДляПоручений.НеобходимаяСуммаУБрокера - ЕСТЬNULL(_ОстаткиУБрокера.ДоступнаяСумма, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Недостаточно,
		|	ВЫБОР
		|		КОГДА _ДанныеДляПоручений.НеобходимаяСуммаУБрокера > ЕСТЬNULL(_ОстаткиУБрокера.ДоступнаяСумма, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагНедостаточноСредств,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ОстаткиУБрокера.ДоступнаяСумма, 0) > _ДанныеДляПоручений.НеобходимаяСуммаУБрокера
		|				И _ПорученияНаПеревод.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФормироватьПоручение,
		|	_ДанныеДляПоручений.СуммаЗадолженности КАК СуммаЗадолженности,
		|	ЕСТЬNULL(_ДанныеДляПоручений.СуммаМаксимумНаСчетах, 0) КАК ОстатокНаСчете,
		|	_ДанныеДляПоручений.ФиксированныйОстаток КАК ФиксированныйОстаток,
		|	_ПорученияНаПеревод.Ссылка КАК Поручение,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК КодУБрокера,
		|	ЕСТЬNULL(_СуммыКПоступлениюПоДатам.СуммаПоступленияТПлюс1, 0) КАК СуммаПоступленияТПлюс1,
		|	_СуммыКПоступлениюПоДатам.ДатаТПлюс1 КАК ДатаТПлюс1,
		|	ЕСТЬNULL(_СуммыКПоступлениюПоДатам.СуммаПоступленияТПлюс2, 0) КАК СуммаПоступленияТПлюс2,
		|	_СуммыКПоступлениюПоДатам.ДатаТПлюс2 КАК ДатаТПлюс2
		|ИЗ
		|	_ДанныеДляПоручений КАК _ДанныеДляПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиУБрокера КАК _ОстаткиУБрокера
		|		ПО _ДанныеДляПоручений.СчетДоверительногоУправления = _ОстаткиУБрокера.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПорученияНаПеревод КАК _ПорученияНаПеревод
		|		ПО _ДанныеДляПоручений.СчетДоверительногоУправления = _ПорученияНаПеревод.СчетДоверительногоУправления
		|			И _ДанныеДляПоручений.РасчетныйСчет = _ПорученияНаПеревод.РасчетныйСчетПолучатель
		|			И _ДанныеДляПоручений.СуммаПеревода <= _ПорученияНаПеревод.Сумма
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&ДатаНачала,
		|				Организация = &Организация
		|					И Брокер = &БрокерБКРегион) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО _ДанныеДляПоручений.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СуммыКПоступлениюПоДатам КАК _СуммыКПоступлениюПоДатам
		|		ПО _ДанныеДляПоручений.СчетДоверительногоУправления = _СуммыКПоступлениюПоДатам.СчетДоверительногоУправления
		|ГДЕ
		|	_ДанныеДляПоручений.НедостаточноСредствНаСчете
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправленияНаименование";
#КонецОбласти

	ЗадолженностиПоСделкам = Новый Массив;
	ЗадолженностиПоСделкам.Добавить(Справочники.ВидыЗадолженности.ПоСделке);
	ЗадолженностиПоСделкам.Добавить(Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО);
	ЗадолженностиПоСделкам.Добавить(Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО);
		
	Запрос.УстановитьПараметр("Организация"                  , Объект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"                   , НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаОкончания"                , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаТПлюс1"                   , Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(Объект.Дата), 1));
	Запрос.УстановитьПараметр("ДатаТПлюс2"                   , Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(Объект.Дата), 2));
	Запрос.УстановитьПараметр("ЗадолженностиПоВознаграждению", Объект.ВидЗадолженности);
	Запрос.УстановитьПараметр("ЗадолженностиПоСделкам"       , ЗадолженностиПоСделкам);
	Запрос.УстановитьПараметр("БрокерБКРегион"               , ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("ММВБ_ТПлюс"                   , ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
	Запрос.УстановитьПараметр("РоссийскийРубль"              , ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("СчетПоУмолчанию"              , Объект.РасчетныйСчетПоУмолчанию);
	Запрос.УстановитьПараметр("СчетИндивидуальнойСтратегии"  , ОбщегоНазначения.ПолучитьИменованныйОбъект("РС_Индивид_Стратегии"));
	Запрос.УстановитьПараметр("Стратегия"					 , Объект.Стратегия);
	Запрос.УстановитьПараметр("ИндивидуальнаяСтратегия"      , ОбщегоНазначения.ПолучитьИменованныйОбъект("Стратегия_Индивидуальная"));
		
	ТаблицаДанныхДляПоручений = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДанныхДляПоручений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.ТаблицаДанных.Загрузить(ТаблицаДанныхДляПоручений);
	
	НедостающиеСредства = ТаблицаДанныхДляПоручений.Скопировать(Новый Структура("ФлагНедостаточноСредств", Истина), "Недостаточно, СчетДоверительногоУправления, ОбщийОстатокУБрокера, СвободныйОстатокУБрокера, ЗаблокированоУБрокера, НеобходимаяСуммаУБрокера, ФиксированныйОстаток, КодУБрокера");
	ЭтотОбъект.ТаблицаНедостающиеСредства.Загрузить(НедостающиеСредства);

КонецПроцедуры //ЗаполнитьТаблицуДанныхНаФорме

&НаСервере
Процедура СоздатьПорученияНаСервере()
		
	ТекущаяДата             = ТекущаяДатаСеанса();
	РасчетныйСчет           = ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");
	Брокер                  = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	БрокерПолучатель        = ПредопределенноеЗначение("Справочник.БрокерскиеКомпании.ПустаяСсылка");
	МестоХранения           = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+");
	МестоХраненияПолучатель = ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок");
	Валюта                  = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	Ответственный           = РаботаСПользователями.ТекущийПользователь();
	Комментарий             = "Создан аппаратно-техническими средствами " + ТекущаяДата;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
				
		Если Не СтрокаДанных.ФормироватьПоручение Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.РасчетныйСчет = NULL Тогда
			Сообщить("Для клиента [" + СтрокаДанных.СчетДоверительногоУправления + "] не удалось определить расчетный счет, т.к. на счетах сумма остатка = 0 и отсутствует исполнитель для р/с " + Объект.РасчетныйСчетПоУмолчанию + "!");
			Продолжить;
		КонецЕсли;
				
		ПоручениеНаПеревод = Документы.ПоручениеНаПереводДенежныхСредств.СоздатьДокумент();
		
		ПоручениеНаПеревод.Дата                         = ТекущаяДата;
		ПоручениеНаПеревод.Организация                  = Объект.Организация;
		ПоручениеНаПеревод.СчетДоверительногоУправления = СтрокаДанных.СчетДоверительногоУправления;
		ПоручениеНаПеревод.РасчетныйСчет                = РасчетныйСчет;
		ПоручениеНаПеревод.Брокер                       = Брокер;
		ПоручениеНаПеревод.МестоХранения                = МестоХранения;
		ПоручениеНаПеревод.МестоХраненияСтрокой         = "Биржевые_ФондоваяТПлюс";
		ПоручениеНаПеревод.РасчетныйСчетПолучатель      = СтрокаДанных.РасчетныйСчет;
		ПоручениеНаПеревод.БрокерПолучатель             = БрокерПолучатель;
		ПоручениеНаПеревод.МестоХраненияПолучатель      = МестоХраненияПолучатель;
		ПоручениеНаПеревод.СрочныйПереводБЭСП           = Ложь;
		ПоручениеНаПеревод.Сумма                        = СтрокаДанных.СуммаПеревода;
		ПоручениеНаПеревод.Валюта                       = Валюта;
		ПоручениеНаПеревод.Ответственный                = Ответственный;
		ПоручениеНаПеревод.Комментарий                  = Комментарий;
		
		Попытка
			ПоручениеНаПеревод.Записать(РежимЗаписиДокумента.Проведение);			
		Исключение
			ПоручениеНаПеревод.Записать();
			Сообщить("Не удалось провести Поручение на перевод денежных по счету " + СтрокаДанных.СчетДоверительногоУправления + ". Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры //СоздатьПорученияНаСервере

&НаСервере
Функция СформироватьТабличныйДокументДляСохранения(ТЗ, СтраницаФормы)
	
	ТабДок = Новый ТабличныйДокумент;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если СтраницаФормы = 1 Тогда
		Макет = ОбработкаОбъект.ПолучитьМакет("Остатки");
	ИначеЕсли СтраницаФормы = 2 Тогда
		Макет = ОбработкаОбъект.ПолучитьМакет("НедостающиеСредства");
	КонецЕсли;

	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	Для Каждого СтрокаТЗОстатки Из ТЗ Цикл
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(СтрокаТЗОстатки);
		ТабДок.Вывести(Область);
	КонецЦикла;
	Возврат ТабДок;
	
КонецФункции //СформироватьТабличныйДокументДляСохранения

