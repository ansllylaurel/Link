<?xml version="1.0" encoding="UTF-8"?>
<!-- AVANCORE 1.3.30: $Author: asorokin в документ "Списание с р/с" в вид операции "Прочее списание" добавлен элемент СтатьяДоходовИРасходов-->
<xs:schema xmlns:pr="www.avancore.ru/periodic_reference" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:altova="http://www.altova.com/xml-schema-extensions" targetNamespace="www.avancore.ru/periodic_reference" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Пакет" type="pr:Пакет">
		<xs:annotation>
			<xs:documentation>Корневой элемент</xs:documentation>
		</xs:annotation>
		<xs:key name="Портфель_УИД">
			<xs:selector xpath="pr:НСИ/pr:Портфели/pr:Портфель"/>
			<xs:field xpath="pr:UID"/>
		</xs:key>
		<xs:keyref name="ПортфельСуществует" refer="pr:Портфель_УИД">
			<xs:selector xpath="pr:Операции/*/*|pr:СостояниеПортфеляНаКонецПериода|pr:СостояниеПортфеляНаНачалоПериода"/>
			<xs:field xpath="pr:Портфель"/>
		</xs:keyref>
		<xs:key name="Контрагент_УИД">
			<xs:selector xpath="pr:НСИ/pr:Контрагенты/pr:Контрагент"/>
			<xs:field xpath="pr:UID"/>
		</xs:key>
		<xs:keyref name="КонтрагентВОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*"/>
			<xs:field xpath="pr:Контрагент"/>
		</xs:keyref>
		<xs:keyref name="КонтрагентВСверкеСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:СостояниеПортфеляНаНачалоПериода/*/*/*|pr:СостояниеПортфеляНаКонецПериода/*/*/*"/>
			<xs:field xpath="pr:Контрагент"/>
		</xs:keyref>
		<xs:keyref name="БрокерВОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*"/>
			<xs:field xpath="pr:Брокер"/>
		</xs:keyref>
		<xs:keyref name="ПолучательВОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*"/>
			<xs:field xpath="pr:Получатель"/>
		</xs:keyref>
		<xs:keyref name="ПлательщикВОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*"/>
			<xs:field xpath="pr:Плательщик"/>
		</xs:keyref>
		<xs:keyref name="КонтрагентВВидеОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*/pr:ВидОперации/*"/>
			<xs:field xpath="pr:Контрагент"/>
		</xs:keyref>
		<xs:keyref name="КонтрагентПрочееВВидеОперацииСуществует" refer="pr:Контрагент_УИД">
			<xs:selector xpath="pr:Операции/*/*/pr:ВидОперации/*"/>
			<xs:field xpath="pr:КонтрагентПрочее"/>
		</xs:keyref>
		<xs:key name="СчетБрокера_УИД">
			<xs:selector xpath="pr:НСИ/pr:Портфели/pr:Портфель/pr:СчетаБрокеров/pr:СчетБрокера"/>
			<xs:field xpath="pr:UID"/>
		</xs:key>
		<xs:keyref name="СчетБрокераСуществует" refer="pr:СчетБрокера_УИД">
			<xs:selector xpath="pr:Операции/*/*/pr:МестоХраненияЦБ/pr:ТипМестаХранения|pr:Операции/*/*/pr:МестоХранения/pr:ТипМестаХранения|pr:Операции/*/*/pr:ВидОперации/*|pr:Операции/pr:ОперацииПоСчетуБрокера/pr:ОперацияПоСчетуБрокера|pr:Операции/*/*/pr:СчетБрокера"/>
			<xs:field xpath="pr:СчетБрокера|pr:СчетБрокераЗачисления"/>
		</xs:keyref>
		<xs:key name="СчетДепо_УИД">
			<xs:selector xpath="pr:НСИ/pr:Портфели/pr:Портфель/pr:СчетаДЕПО/pr:СчетДЕПО"/>
			<xs:field xpath="pr:UID"/>
		</xs:key>
		<xs:keyref name="СчетДепоСуществует" refer="pr:СчетДепо_УИД">
			<xs:selector xpath="pr:Операции/*/*/pr:МестоХраненияЦБ/pr:ТипМестаХранения|pr:Операции/*/*/pr:МестоХранения/pr:ТипМестаХранения"/>
			<xs:field xpath="pr:СчетДепо"/>
		</xs:keyref>
	</xs:element>
	<xs:complexType name="АктивСсылка">
		<xs:annotation>
			<xs:documentation>Содержит УИД и тип актива</xs:documentation>
		</xs:annotation>
		<xs:attribute name="UID" use="required">
			<xs:annotation>
				<xs:documentation>Уникальный идентификатор актива</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="50"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="ТипАктива" use="required">
			<xs:annotation>
				<xs:documentation>Акция, Облигация, Паи ПИФ, Фьючерс, Опцион, Структурная нота</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Акция"/>
					<xs:enumeration value="Облигация"/>
					<xs:enumeration value="ПаиПИФ"/>
					<xs:enumeration value="Фьючерс"/>
					<xs:enumeration value="Опцион"/>
					<xs:enumeration value="СтрНота"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="ISIN_Код" use="required">
			<xs:annotation>
				<xs:documentation>ISIN или краткий код для срочных инсрументов</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string"/>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="Наименование" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string"/>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="ЗадолженностьКонтрагентов">
		<xs:sequence>
			<xs:element name="Запись" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Контрагент" type="pr:UID">
							<xs:annotation>
								<xs:documentation>Уникальный идентификатор контрагента</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="ДоговорКонтрагента" type="pr:UID" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Уникальный идентификатор договора контрагента</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Валюта" type="pr:Валюта"/>
						<xs:element name="Сумма" type="pr:Сумма">
							<xs:annotation>
								<xs:documentation>Остаток валютной суммы (Сальдо конечное) на счете после регистрации всех операций. </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="БанковскийСчетКонтрагента">
		<xs:annotation>
			<xs:documentation>Справочник "Банковские счета"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор элемента.По этому полю происходит синхронизация</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:UID">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Наименование">
				<xs:annotation>
					<xs:documentation>Наименование</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="120"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="НомерСчета">
				<xs:annotation>
					<xs:documentation>Номер счета</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="34"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Банк" type="pr:БИК">
				<xs:annotation>
					<xs:documentation>БИК Банка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ВерсияЭлемента">
			<xs:annotation>
				<xs:documentation>Уникальный идентификатор версии передаваемого элемента</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="БанковскийСчетФонда">
		<xs:annotation>
			<xs:documentation>Справочник "Банковские счета"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор элемента.По этому полю происходит синхронизация</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:UID">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Наименование">
				<xs:annotation>
					<xs:documentation>Наименование</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="120"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="НомерСчета">
				<xs:annotation>
					<xs:documentation>Номер счета</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="34"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ВидСчета">
				<xs:annotation>
					<xs:documentation>Вид банковского счета</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Депозитный"/>
						<xs:enumeration value="Расчетный"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Банк" type="pr:БИК">
				<xs:annotation>
					<xs:documentation>БИК Банка</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Валюта" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта денежных средств</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Договор" type="pr:ДоговорКонтрагента" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор Договора открытия банковского счета</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="НачислениеПроцентов" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак начисления процентов</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ПараметрыРасчетаПроцентовПоДепозиту" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Запись" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Запись Параметры расчета %% по банковским счетам </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Договор" type="pr:UID">
										<xs:annotation>
											<xs:documentation>Уникальный идентификатор депозитного договора, может не совпадать с основаным договором</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаНачалаДействия" type="xs:date">
										<xs:annotation>
											<xs:documentation>Дата начала действия параметров расчета дохода по депозиту</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаОткрытия" type="xs:date">
										<xs:annotation>
											<xs:documentation>Дата открытия</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаЗакрытия" type="xs:date">
										<xs:annotation>
											<xs:documentation>Дата закрытия</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ПервоначальнаяСуммаВклада" type="xs:decimal">
										<xs:annotation>
											<xs:documentation>Первоначальная сумма вклада</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ПериодичностьВыплаты" type="pr:ПериодичностьВыплаты">
										<xs:annotation>
											<xs:documentation>Периодичность выплаты %</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ПроцентнаяСтавкаДоВостребования" type="xs:decimal" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Cтавка до востребования</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ПополненияВклада" type="xs:boolean">
										<xs:annotation>
											<xs:documentation>Возможность частичного пополения</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ЧастичноеСнятие" type="xs:boolean">
										<xs:annotation>
											<xs:documentation>Депозит допускает частичное снятие</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Капитализация" type="xs:boolean">
										<xs:annotation>
											<xs:documentation>Признак Капитализация</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:choice>
										<xs:element name="ПроцентнаяСтавка" type="xs:decimal">
											<xs:annotation>
												<xs:documentation>Процентная ставка</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ШкалаПроцентов">
											<xs:annotation>
												<xs:documentation>Указывается если ставка зависит от суммы вклада</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="ШкалаПоСрокуВклада" type="xs:boolean">
														<xs:annotation>
															<xs:documentation>Признак Шкала по сроку вклада</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="Запись" maxOccurs="unbounded">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="ПроцентнаяСтавка" type="xs:decimal">
																	<xs:annotation>
																		<xs:documentation>Процентная ставка</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:element name="НижняяГраницаВклада" type="xs:decimal">
																	<xs:annotation>
																		<xs:documentation>Это либо сумма вклада, либо срок вклада в днях, если признак ШкалаПоСрокуВклада установлен</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:choice>
									<xs:element name="ГрафикВыплат" minOccurs="0">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Запись" maxOccurs="unbounded">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="ДатаВыплаты" type="xs:date"/>
															<xs:element name="СуммаВыплаты" type="xs:decimal"/>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ДосрочноеРасторжение" type="xs:boolean" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Депозит можно досрочно расторгнуть</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаРасторжения" type="xs:date" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Признак Дата расторжения</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ЭСП" type="pr:СтавкаЭСП" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Эффективная Ставка Процента (%)</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="ВерсияЭлемента">
									<xs:annotation>
										<xs:documentation>Уникальный идентификатор версии передаваемого элемента</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ВерсияЭлемента">
			<xs:annotation>
				<xs:documentation>Уникальный идентификатор версии передаваемого элемента</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="ВводЦенныхБумагВДУ">
		<xs:annotation>
			<xs:documentation>Документ "Ввод ценных бумаг из ДУ"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор документа.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата и время операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Номер" type="xs:string">
				<xs:annotation>
					<xs:documentation>Номер операции по порядку - участвует в поиске операции (если операция не найдена по Уникальному идентификатору)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор портфеля. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Договор" type="pr:UID" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор договора</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ТипПортфеля" type="pr:ТипыПортфелей">
				<xs:annotation>
					<xs:documentation>Тип портфеля для поступающих в ДУ активов</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="МестоХраненияЦБ" type="pr:МестоХраненияЦБ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Место хранения ценной бумаги</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ПервичныйДокумент" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="Акт приема-передачи от 08.06.2017"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>Описание документа-основания</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Активы">
				<xs:annotation>
					<xs:documentation>Список активов</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Запись" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Строка таб. части</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Актив" type="pr:АктивСсылка">
										<xs:annotation>
											<xs:documentation>Содержит Уникальный идентификатор и тип актива</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ВалютаНоминала" type="pr:Валюта">
										<xs:annotation>
											<xs:documentation>Валюта номинальной стоимости</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="КурсВалютыНоминальнойСтоимости" type="pr:КурсВалюты" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Если не заполнено - заполняется автоматически по курсу ЦБ РФ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="КратностьВалютыНоминальнойСтоимости" type="pr:КратностьВалюты" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Если не заполнено - заполняется автоматически по курсу ЦБ РФ</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Количество" type="pr:Количество">
										<xs:annotation>
											<xs:documentation>Количество</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Цена" type="pr:Цена">
										<xs:annotation>
											<xs:documentation>Цена</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Сумма" type="pr:Сумма">
										<xs:annotation>
											<xs:documentation>Балансовая стоимость в валюте номинальной стоимости</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="УКД" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Сумма купленного купонного дохода в валюте номинальной стоимости</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="НКД" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Сумма накопленного купонного дохода в валюте номинальной стоимости</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="СуммаПереоценки" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>
												Накопленная переоценка в рублях
												Если больше 0 - переоценка положительная.
												Если меньше 0 - переоценка отрицательная
											</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаПартии" type="xs:date" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Если заполнена, создается операция партии для расчетов с контрагентами</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДатаПриобретения" type="xs:date" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Используется для расчета ЭСП и амортизации премии или дисконта. устанавливается, если отличается от даты партии</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ЦенаПокупки" type="pr:Цена" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Обязательное поле для амортизационных облигаций в валюте номинальной стоимости</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="СуммаКорректировки" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Суммав корректировки в рублях</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="СуммаАмПремииДисконта" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>
												Сумма амортизации премии/дисконта в валюте номинальной стоимости.
												Отрицательная сумма - амортизация премии.
												Положительная сумма - амортизация дисконта.
											</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="СуммаИндексацииНоминала" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Накопленная сумма индексированного номинала с момента приобретения облигации</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ЭСП" type="pr:СтавкаЭСП" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Эффективная ставка процента</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="СуммаНУ" type="pr:Сумма" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Сумма по налоговму учету в валюте регламентированного учета</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ПортфельВывода" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер портфеля вывода, это не идентификатор портфеля. Заполняется, если активы получены в результате перевода</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Комментарий" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Комментарий к операции</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВыводЦенныхБумагИзДУ">
		<xs:annotation>
			<xs:documentation>Документ "Вывод ценных бумаг из ДУ"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата и время операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Номер" type="xs:string">
				<xs:annotation>
					<xs:documentation>Номер операции участвует в поиске операции (если по идентификатору операция не была найдена)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор портфеля. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Договор" type="pr:UID" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор Договора</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ТипПортфеля" type="pr:ТипыПортфелей">
				<xs:annotation>
					<xs:documentation>Тип портфеля выводимых из ДУ ценных бумаг</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="МестоХраненияЦБ" type="pr:МестоХраненияЦБ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Место хранения ценных бумаг</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Активы">
				<xs:annotation>
					<xs:documentation>Списак активов</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Запись" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Строка с данными по активу</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Актив" type="pr:АктивСсылка">
										<xs:annotation>
											<xs:documentation>Содержит Уникальный идентификатор и тип актива</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Количество" type="pr:Количество">
										<xs:annotation>
											<xs:documentation>Количество</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ПервичныйДокумент" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="Акт приема-передачи от 08.06.2017"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>Описание документа основания</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ПортфельВвода" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер портфеля ввода, это не идентификатор портфеля, заполняется при переводе между портфелями</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Комментарий" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Комментарий к операции</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ДепозитнаяСделка">
		<xs:annotation>
			<xs:documentation>Документ "Депозитная сделка"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата и время операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Номер" type="xs:string">
				<xs:annotation>
					<xs:documentation>Номер операции участвует в поиске операции (если по идентификатору операция не была найдена)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор портфеля. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаКомиссииБиржи" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта комиссии биржи</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаКомиссииКлиринговогоЦентра" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта комиссии клирингового центра</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаСделки" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта сделки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВключатьКомиссииВАмортизированнуюСтоимость" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Включать комиссии в амортизированную стоимость</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДатаЗакрытия" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата закрытия. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Контрагент" type="pr:UID">
				<xs:annotation>
					<xs:documentation>УИД Контрагент</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДоговорКонтрагента" type="pr:UID">
				<xs:annotation>
					<xs:documentation>УИД Договор</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КороткийДепозит" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак короткого депозита</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КратностьВалютыКомиссииБиржи" type="pr:КратностьВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Кратность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КратностьВалютыКомиссииКлиринговогоЦентра" type="pr:КратностьВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Кратность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КратностьВалютыСделки" type="pr:КратностьВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Кратность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КурсВалютыКомиссииБиржи" type="pr:КурсВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Курс</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КурсВалютыКомиссииКлиринговогоЦентра" type="pr:КурсВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Курс</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КурсВалютыСделки" type="pr:КурсВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Курс</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="НеКорректироватьПоЭСП" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Не корректировать по ЭСП</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="НомерСделки">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="32"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ПериодичностьВыплаты" type="pr:ПериодичностьВыплаты">
				<xs:annotation>
					<xs:documentation>Периодичность выплаты процентов</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ПроцентнаяСтавка" type="xs:decimal">
				<xs:annotation>
					<xs:documentation>Процентная ставка</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммаКомиссииБиржи" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма комиссии биржи</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммаКомиссииКлиринговогоЦентра" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма комиссии клиринга</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммаСделки" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма сделки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СчетКлиринговогоЦентра" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Счет клиринга УИД</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СчетКлиринговогоЦентраОплатыКомиссииБиржи" type="pr:UID" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Счет клиринга комиссии биржи УИД</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СчетКлиринговогоЦентраОплатыКомиссииКлиринговогоЦентра" type="pr:UID" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Счет клиринга УИД</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ЭСП" type="pr:СтавкаЭСП" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ЭСП</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммыКВыплате">
				<xs:annotation>
					<xs:documentation>График выплат</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Запись" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Строка с данными по сумме выплаты</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ДатаВыплаты" type="xs:dateTime">
										<xs:annotation>
											<xs:documentation>Дата и время операции. </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДнейВГоду" type="pr:Количество">
										<xs:annotation>
											<xs:documentation>Дней в году</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ДнейВПериоде" type="pr:Количество">
										<xs:annotation>
											<xs:documentation>Дней в периоде</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ВалютнаяСуммаВклада" type="pr:Сумма">
										<xs:annotation>
											<xs:documentation>Сумма вклада (вал)</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="ВалютнаяСуммаПроцентов" type="pr:Сумма">
										<xs:annotation>
											<xs:documentation>Сумма процентов (вал)</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Комментарий" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Комментарий к операции</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ДоговорКонтрагента">
		<xs:annotation>
			<xs:documentation>Справочник "Договоры контрагентов"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор элемента.По этому полю происходит синхронизация</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:UID">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор портфеля</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Наименование">
				<xs:annotation>
					<xs:documentation>Наименование </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="НомерДоговора">
				<xs:annotation>
					<xs:documentation>Номер договора</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ДатаДоговора" type="xs:date">
				<xs:annotation>
					<xs:documentation>Дата договора</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element name="МультивалютныйДоговор">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Валюта" type="pr:Валюта" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Валюта" type="pr:Валюта">
					<xs:annotation>
						<xs:documentation>Валюта взаиморасчетов</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element name="РольДоговора" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Роль договора. Если не заполнена, то устанавливается роль "Прочий"</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Спец. депозитария"/>
						<xs:enumeration value="Аудиторский"/>
						<xs:enumeration value="Депозитного счета"/>
						<xs:enumeration value="Соглашение о вознаграждении"/>
						<xs:enumeration value="Договор ДУ"/>
						<xs:enumeration value="Междепозитарный"/>
						<xs:enumeration value="Страхования"/>
						<xs:enumeration value="Депозитарный"/>
						<xs:enumeration value="Брокерский"/>
						<xs:enumeration value="Банковского счета"/>
						<xs:enumeration value="Прочий"/>
						<xs:enumeration value="Депозитной сделки с НКЦ"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ДатаОкончания" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата окончания договора</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ИсполнениеСделкиTn">
		<xs:annotation>
			<xs:documentation>Перечень пройденных точек бизнес-процессом СделкаTn, ВнебиржеваяСделка</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Внебиржевая" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак внебиржевой сделки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДатаИсполнения" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Заполняется для внебиржевых сделок</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Операция">
				<xs:annotation>
					<xs:documentation>Выполняемая операция</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="Перерегистрация"/>
						<xs:enumeration value="ОплатаСделки"/>
						<xs:enumeration value="ОплатаКомиссий"/>
						<xs:enumeration value="ОплатаКомиссииБрокера"/>
						<xs:enumeration value="ОплатаИнойКомиссии"/>
						<xs:enumeration value="ОплатаКомиссииБиржи"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ИсполнениеСделкиРЕПО">
		<xs:annotation>
			<xs:documentation>Перечень пройденных точек бизнес-процессом СделкаРЕПО</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Операция">
				<xs:annotation>
					<xs:documentation>Текущая операция</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ПерваяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаПервойЧастиРЕПО"/>
						<xs:enumeration value="ОплатаКомиссииБрокераПерваяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаКомиссииБиржиПерваяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаКомиссийПервойЧастиРЕПО"/>
						<xs:enumeration value="ВтораяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаВторойЧастиРЕПО"/>
						<xs:enumeration value="ОплатаКомиссииБрокераВтораяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаКомиссииБиржиВтораяЧастьРЕПО"/>
						<xs:enumeration value="ОплатаКомиссийВторойЧастиРЕПО"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ИсполнениеСделкиСВалютой">
		<xs:annotation>
			<xs:documentation>Перечень пройденных точек бизнес-процессом СделкаРЕПО</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Операция">
				<xs:annotation>
					<xs:documentation>Текущая операция</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="СписаниеДенежныхСредств"/>
						<xs:enumeration value="ПоступлениеДенежныхСредств"/>
						<xs:enumeration value="ОплатаКомиссииБрокера"/>
						<xs:enumeration value="ОплатаКомиссииБиржи"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="КлирингОткрытыхПозиций">
		<xs:annotation>
			<xs:documentation>Элемент содержит описание всей вариационной маржи в пределах брокера</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор элемент</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:UID">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime"/>
			<xs:element name="Номер">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID"/>
			<xs:element name="Контрагент" type="pr:UID"/>
			<xs:element name="ДоговорКонтрагента" type="pr:UID"/>
			<xs:element name="СчетБрокера" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор счета брокера</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаДокумента" type="pr:Валюта"/>
			<xs:element name="ГарантированноеОбеспечение" type="pr:Сумма"/>
			<xs:element name="КратностьВзаиморасчетов" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="КурсВзаиморасчетов" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="10"/>
						<xs:fractionDigits value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Контракты">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Запись" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Контракт" type="pr:АктивСсылка"/>
									<xs:element name="ВидОбращаемости" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="pr:ВидОбращаемости">
												<xs:enumeration value="ОбращающиесяЦБВРублях"/>
												<xs:enumeration value="НеОбращающиесяЦБВРублях"/>
												<xs:enumeration value="НеОбращающиесяЦБОтвечавшиеТребованиямНаМоментПриобретения"/>
												<xs:enumeration value="ОбращающиесяФинансовыеИнструментыСрочныхСделокСБазиснымАктивомЦБ"/>
												<xs:enumeration value="НеОбращающиесяФинансовыеИнструментыСрочныхСделок"/>
												<xs:enumeration value="ОбращающиесяФинансовыеИнструментыСрочныхСделокСБазиснымАктивомНеЦБ"/>
												<xs:enumeration value="СделкаРЕПО"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="ВариационнаяМаржа" type="pr:Сумма"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="КомиссииПоСделкеРЕПО">
		<xs:annotation>
			<xs:documentation>Суммы комиссий по бизнес-процессу СделкаРЕПО</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="КомиссияБрокера" type="pr:Комиссия" minOccurs="0"/>
			<xs:element name="КомиссияБиржи" type="pr:Комиссия" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Комиссия">
		<xs:sequence>
			<xs:element name="ВалютаКомиссии" type="pr:Валюта"/>
			<xs:element name="СуммаКомиссии" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма комиссии</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДатаОплатыКомиссии" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата оплаты комисии</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="БрокерскийСчет" type="pr:UID" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор счета брокера</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Контрагент">
		<xs:annotation>
			<xs:documentation>Справочник "Контрагенты"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор элемента.По этому полю происходит синхронизация</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:UID">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Наименование" type="xs:string">
				<xs:annotation>
					<xs:documentation>Наименование</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ИНН_TIN">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="7708045687"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>ИНН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="КПП" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="765432190"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>КПП</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="9"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ДоговорыКонтрагентов" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список договоров</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ДоговорКонтрагента" type="pr:ДоговорКонтрагента" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="БанковскиеСчета" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список банковских счетов</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="БанковскийСчет" type="pr:БанковскийСчетКонтрагента" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="МестоХраненияЦБ">
		<xs:annotation>
			<xs:documentation>Справочник "Счета брокера" или Справочник "Счета ДЕПО"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ТипМестаХранения">
				<xs:annotation>
					<xs:documentation>Если расчеты производятся через брокера, то указывается счет брокера. Для расчетов через банк указывается счет ДЕПО</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:choice>
						<xs:element name="СчетБрокера" type="pr:UID">
							<xs:annotation>
								<xs:documentation>Уникальный идентификатор Счета брокера</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="СчетДепо" type="pr:UID">
							<xs:annotation>
								<xs:documentation>Уникальный идентификатор Счета ДЕПО</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="НачислениеВознаграждения">
		<xs:annotation>
			<xs:documentation>Документ "Начисление вознаграждения"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата и время операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Номер" type="xs:string">
				<xs:annotation>
					<xs:documentation>Номер операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор портфеля.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаДокумента" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВидКонтагента">
				<xs:annotation>
					<xs:documentation>Вид вознаграждения</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="УправляющаяКомпания"/>
						<xs:enumeration value="СпецДепозитарий"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ЗаУспех" type="xs:boolean">
				<xs:annotation>
					<xs:documentation>Признак За успех</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Контрагент" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор Контрагента</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДоговорКонтрагента" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор  договора</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммаВознаграждения" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма вознаграждения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДатаВходящегоДокумента" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата входящего документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="НомерВходящегоДокумента" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Номер входящего документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Комментарий" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Комментарий к операции</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СтатьяДоходовИРасходов" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Статья доходов и расходов</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="НачислениеЗадолженности">
		<xs:annotation>
			<xs:documentation>Документ "Начисление задолженности"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UID" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дата" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Дата и время операции. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Номер" type="xs:string">
				<xs:annotation>
					<xs:documentation>Номер операции </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Портфель" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор  портфеля</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Контрагент" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор контрагента</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДоговорКонтрагента" type="pr:UID">
				<xs:annotation>
					<xs:documentation>Уникальный идентификатор  договора контрагента</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ВалютаВзаиморасчетов" type="pr:Валюта">
				<xs:annotation>
					<xs:documentation>Валюта документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КурсВзаиморасчетов" type="pr:КурсВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Если не заполнено - заполняется автоматически по курсу ЦБ РФ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КратностьВзаиморасчетов" type="pr:КратностьВалюты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Если не заполнено - заполняется автоматически по курсу ЦБ РФ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СуммаДокумента" type="pr:Сумма">
				<xs:annotation>
					<xs:documentation>Сумма документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СтатьяДоходовИРасходов" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Статья доходов и расходов</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Комментарий" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Комментарий к опериции</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="НСИ">
		<xs:annotation>
			<xs:documentation>Контейнер, в котором содержится выгружаемая/загружаемая справочная информация</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Портфели" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список портфелей</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Портфель" type="pr:Портфель" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные портфеля</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Контрагенты" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список контрагентов</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Контрагент" type="pr:Контрагент" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные контрагента</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Операции">
		<xs:annotation>
			<xs:documentation>Контейнер, в котором содержатся выгружаемые/загружаемые документы</xs:documentation>
		</xs:annotation>
		<xs:sequence minOccurs="0">
			<xs:element name="ВводыЦенныхБумагВДУ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Ввода ценных бумаг в Доверительное управление</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ВводЦенныхБумагИзДУ" type="pr:ВводЦенныхБумагВДУ" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций Ввода ценных бумаг в Доверительное управление</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ВыводыЦенныхБумагИзДУ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Вывода ценных бумаг из доверительного управления </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ВыводЦенныхБумагИзДУ" type="pr:ВыводЦенныхБумагИзДУ" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операции Вывода ценных бумаг из доверительного управления</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Сделки" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций  по Сделкам с ценными бумагами</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Сделка" type="pr:Сделка" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций по сделкам</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ДепозитныеСделки" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список депозитных сделок</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ДепозитнаяСделка" type="pr:ДепозитнаяСделка" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций по депозитным сделкам</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ИсполнениеСделокTn" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список исполненных операций по Сделкам T+n</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ИсполнениеСделкиTn" type="pr:ИсполнениеСделкиTn" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные исполнения Сделок T+n</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="СделкиРЕПО" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список Сделки РЕПО</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="СделкаРЕПО" type="pr:СделкаРЕПО" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные Сделок РЕПО</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ИсполнениеСделокРЕПО" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список исполненных операций по сделкам РЕПО</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ИсполнениеСделкиРЕПО" type="pr:ИсполнениеСделкиРЕПО" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные исполнеиня операций</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ОперацииПоСчетуБрокера" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список Операций по счету брокера</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ОперацияПоСчетуБрокера" type="pr:ОперацияПоСчетуБрокера" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные Операции по счету брокера</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ПоступленияНаРасчетныйСчет" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Поступление на расчетный счет</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ПоступлениеНаРасчетныйСчет" type="pr:ПоступлениеНаРасчетныйСчет" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операции Поступление на расчетный счет</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="СписанияСрасчетногоСчета" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Списания с расчетного счета</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="СписаниеСРасчетногоСчета" type="pr:СписаниеСРасчетногоСчета" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций Списание с расчетного счета</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="НачисленияЗадолженностей" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Начисления задолженности</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="НачислениеЗадолженности" type="pr:НачислениеЗадолженности" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операции Начисление задолженности</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="НачисленияВознаграждения" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций Начисления вознаграждения</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="НачислениеВознаграждения" type="pr:НачислениеВознаграждения" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операции Начисление вознаграждения</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="СрочныеСделки" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="СрочнаяСделка" type="pr:СделкаНаСрочномРынке" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="КлирингСрочныхИнструментов" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="КлирингОткрытойПозиции" type="pr:КлирингОткрытыхПозиций" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="СделкиМНО" type="pr:СделкиМНО" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список параметров Сделок с Минимальным неснижаемым остатком</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="БиржевыеСделкиСВалютой" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций  по биржевым сделкам с валютой</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="БиржеваяСделкаСВалютой" type="pr:БиржеваяСделкаСВалютой" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций по сделкам</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ИсполнениеСделокСВалютой" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список исполненных операций по сделкам РЕПО</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ИсполнениеСделкиСВалютой" type="pr:ИсполнениеСделкиСВалютой" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные исполнеиня операций</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="НачислениеДопРасходовПоСделке" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список операций  по биржевым сделкам с валютой</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="НачислениеДопРасходовПоСделке" type="pr:НачислениеДопРасходовПоСделке" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Данные операций по сделкам</xs:documentation>
							</xs:annotation>
