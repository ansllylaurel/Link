КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНеактуальностьСводногоОтчета(ЭтаФорма)

	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.СводныйОтчетТабличныйДокумент, "НЕАКТУАЛЬНОСТЬ", "Отчет не сформирован. Нажмите ""Выполнить анализ"" для получения отчета.");

КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРасшифровки(АдресВХарилище, Расшифровка)

	Значение = ПолучитьИзВременногоХранилища(АдресВХарилище);
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
	    // расшифровка результатов проверки
		ДанныеРасшифровки = Значение.ДанныеРасшифровки;
	Иначе
		// расшифровка отчета по базису
		ДанныеРасшифровки = Значение;
	КонецЕсли; 
	
	Возврат ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля()[0].Значение;

КонецФункции

&НаКлиенте
Процедура УстановитьВидимость()
	
	ИмяПредопределенного = "Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У";
	Видимость = (Объект.ГруппаОбстоятельств = ПредопределенноеЗначение(ИмяПредопределенного));
	Элементы.Клиент.Видимость = Видимость;
	Элементы.СтраницаЖурнал.Видимость = Видимость;
	Элементы.СчетаДоверительногоУправления.Видимость = Не Видимость;

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьЗначения(Команда)
	
	ТекущаяКолонка = Элементы.КонфликтыИнтересов.ТекущийЭлемент.Имя;
	
	Если ТекущаяКолонка = "КонфликтыИнтересовДатаВыявления" 
		Или ТекущаяКолонка = "КонфликтыИнтересовРешениеОбОтказеОтПредотвращения" 
		Или ТекущаяКолонка = "КонфликтыИнтересовСпособРаскрытияИнформации" 
		Или ТекущаяКолонка = "КонфликтыИнтересовДатаРаскрытияИнформации" Тогда
		
		ИмяКолонки = СтрЗаменить(ТекущаяКолонка, "КонфликтыИнтересов", "");
		
		Значение = Элементы.КонфликтыИнтересов.ТекущиеДанные[ИмяКолонки];
		Если ВвестиЗначение(Значение, "Новое значение") Тогда
		
			Для каждого Строка Из Элементы.КонфликтыИнтересов.ВыделенныеСтроки Цикл
			
				ДанныеСтроки = ЭтаФорма.КонфликтыИнтересов.НайтиПоИдентификатору(Строка);
				ДанныеСтроки[ИмяКолонки] = Значение;
			
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаАнализСвязанныхНаНачалоПериода(Команда)

	Элементы.ФормаКомандаАнализСвязанныхНаНачалоПериода.Пометка = Не Элементы.ФормаКомандаАнализСвязанныхНаНачалоПериода.Пометка;
	Объект.АнализОстатковНаНачалоПериода = Элементы.ФормаКомандаАнализСвязанныхНаНачалоПериода.Пометка;
	Элементы.НадписьАнализОстатковНаНачало.Видимость = Объект.АнализОстатковНаНачалоПериода;
	
КонецПроцедуры

#КонецОбласти 

#Область Журнал_КИ

&НаСервере
Процедура СформироватьЖурналКИНаСервере()

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Результат = ОбъектНаСервере.СформироватьЖурналКИ(, ЭтаФорма.ВключитьДействующиеКИ);

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЭтаФорма.Журнал = Результат.ДокументРезультат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьЖурнал(Команда)
	СформироватьЖурналКИНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаГрупповаяОбработка(Команда)
	ПараметрыФормы = Новый Структура("Организация, ГруппаОбстоятельств");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ОткрытьФорму("ВнешняяОбработка._ВыявлениеКонфликтовИнтересов.Форма.ГрупповаяОбработка", 
		ПараметрыФормы, 
		ЭтаФорма, 
		ЭтаФорма,,,, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти