		|			ТОГДА ВЫРАЗИТЬ(Выявление.КонфликтИнтересов.ПредметКонфликта КАК Справочник.Займы).НомерДоговора + "" от "" + ПОДСТРОКА(СТРОКА(ВЫРАЗИТЬ(Выявление.КонфликтИнтересов.ПредметКонфликта КАК Справочник.Займы).ДатаЗаключения), 1, 10)
		|		КОГДА ТИП(Справочник.ДепозитныеВклады)
		|			ТОГДА ВЫРАЗИТЬ(Выявление.КонфликтИнтересов.ПредметКонфликта КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора + "" от "" + ПОДСТРОКА(СТРОКА(ВЫРАЗИТЬ(Выявление.КонфликтИнтересов.ПредметКонфликта КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.ДатаЗаключения), 1, 10)
		|	КОНЕЦ КАК РеквизитыАктива,
		|	Выявление.КонфликтИнтересов.ПредметКонфликта КАК ПредметКонфликта,
		|	Выявление.КонфликтИнтересов.СвязанноеЛицо КАК СвязанноеЛицо,
		|	Выявление.СодержаниеКонфликтаИнтересов КАК СодержаниеКонфликтаИнтересов
		|ИЗ
		|	ДействующиеСчетаДУ КАК ДействующиеСчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК Выявление
		|		ПО (Выявление.Организация = &Организация)
		|			И ДействующиеСчетаДУ.Ссылка = Выявление.СчетДоверительногоУправления
		|			И (Выявление.Проведен)
		|			И (Выявление.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Выявление))
		|			И (Выявление.КонфликтИнтересов.Обстоятельство В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК Прекращение
		|		ПО (Выявление.КонфликтИнтересов = Прекращение.КонфликтИнтересов)
		|			И (Прекращение.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение))
		|			И (Прекращение.Проведен)
		|ГДЕ
		|	(&УсловиеОтбораВыявленныхКИ
		|			ИЛИ Прекращение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				
		|
		|УПОРЯДОЧИТЬ ПО
		|	НАЧАЛОПЕРИОДА(Выявление.Дата, ДЕНЬ),
		|	ДатаВозникновения,
		|	СчетДоверительногоУправления,
		|	ОбстоятельствоНомер,
		|	СвязанноеЛицо,
		|	ПредметКонфликта";		
	#КонецОбласти
	
	Если ВключитьДействующиеКИ Тогда
		УсловиеОтбораВыявленныхКИ = "Прекращение.Ссылка ЕСТЬ NULL";
	Иначе
		УсловиеОтбораВыявленныхКИ = "Выявление.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораВыявленныхКИ", УсловиеОтбораВыявленныхКИ);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	
	Если СчетДоверительногоУправления = Неопределено Тогда
		Субъект = ЭтотОбъект.Клиент;
	Иначе
		Субъект = СчетДоверительногоУправления;
		ЭтотОбъект.Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Субъект, ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;
	
	ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Субъект, Запрос.МенеджерВременныхТаблиц);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Журнал = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Журнал");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка_6883");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка_6883");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал_6883");
	
	НомерПП = 0;
	
	ОбластьШапка.Параметры.Клиент = ПолучитьПредставлениеКлиента();
	Журнал.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл
		
		НомерПП = НомерПП + 1;
		
		ОбластьСтрока.Параметры.НомерПП = НомерПП;
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		
		Если Выборка.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЭмитентСвязанноеЛицо_6883 Тогда
			
			ОбластьСтрока.Параметры.Содержание1 = Выборка.СодержаниеКонфликтаИнтересов;
			ОбластьСтрока.Параметры.Содержание2 = "-";
			ОбластьСтрока.Параметры.Содержание3 = "-";
			ОбластьСтрока.Параметры.Содержание4 = "-";
			
		ИначеЕсли Выборка.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЦенныеБумагиНаРазмещении_6883 Тогда
			
			ОбластьСтрока.Параметры.Содержание1 = "-";
			ОбластьСтрока.Параметры.Содержание2 = Выборка.СодержаниеКонфликтаИнтересов;
			ОбластьСтрока.Параметры.Содержание3 = "-";
			ОбластьСтрока.Параметры.Содержание4 = "-";
			
		ИначеЕсли Выборка.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорОСтабилизацииЦен_6883 Тогда
			
			ОбластьСтрока.Параметры.Содержание1 = "-";
			ОбластьСтрока.Параметры.Содержание2 = "-";
			ОбластьСтрока.Параметры.Содержание3 = Выборка.СодержаниеКонфликтаИнтересов;
			ОбластьСтрока.Параметры.Содержание4 = "-";
			
		ИначеЕсли Выборка.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСоСвязаннымЛицом_6883 Тогда
			
			ОбластьСтрока.Параметры.Содержание1 = "-";
			ОбластьСтрока.Параметры.Содержание2 = "-";
			ОбластьСтрока.Параметры.Содержание3 = "-";
			ОбластьСтрока.Параметры.Содержание4 = Выборка.СодержаниеКонфликтаИнтересов;
						
		КонецЕсли;
		
		Журнал.Вывести(ОбластьСтрока);
	
	КонецЦикла;
	
	Журнал.Вывести(ОбластьПодвал);
	
	Возврат Новый Структура("ДокументРезультат, НеОбрабатыватьПакет", Журнал, Результат.Пустой());

КонецФункции

Функция СформироватьЖурнал5511У()

	Журнал = Новый ТабличныйДокумент;
	
	Возврат Новый Структура("ДокументРезультат", Журнал);

КонецФункции

Процедура ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Субъект, МенеджерВременныхТаблиц)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ЭтотОбъект.Организация);
	
	Если ТипЗнч(Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Отбор.Вставить("ВключаяСчетаДУ", Субъект);
		Отбор.Вставить("Клиент", Справочники.ЮрФизЛица.ПустаяСсылка());
	Иначе
		Отбор.Вставить("Клиент", Субъект);
		Отбор.Вставить("ВидДеятельности", Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ);
	КонецЕсли;
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		МенеджерВременныхТаблиц, 
		ЭтотОбъект.Период, 
		Отбор);
	
КонецПроцедуры

Функция ПроверитьВыполнениеПоискаКонфликтовИнтересов(СчетДоверительногоУправления, ДатаНачалаПроверки, ДатаОкончанияПроверки)
	
	Отказ = Ложь;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеКалендаря.Дата КАК Дата,
		|	ЕСТЬNULL(ЖурналСверокПоВнутреннемуУчетуСрезПоследних.Пройдена, ЛОЖЬ) КАК Пройдена
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверокПоВнутреннемуУчету.СрезПоследних(
		|				,
		|				(Организация, СчетДоверительногоУправления, Основание, ПериодСверки) В
		|					(ВЫБРАТЬ
		|						&Организация КАК Организация,
		|						&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|						ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.КонфликтИнтересов_6883У) КАК Основание,
		|						_ДанныеКалендаря.Дата КАК ПериодСверки
		|					ИЗ
		|						_ДанныеКалендаря КАК _ДанныеКалендаря)) КАК ЖурналСверокПоВнутреннемуУчетуСрезПоследних
		|		ПО _ДанныеКалендаря.Дата = ЖурналСверокПоВнутреннемуУчетуСрезПоследних.ПериодСверки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаПроверки);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияПроверки);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Ошибки = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
	
		Если Не Выборка.Пройдена Тогда
			Ошибки.Добавить(Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
		КонецЕсли;		
	
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		
		ТекстОшибки = СтрШаблон("Не выполнен поиск конфликтов интересов по счету ВУ %1 за следующие даты:%2%3",
			СчетДоверительногоУправления,
			Символы.ПС,
			СтрСоединить(Ошибки, ", "));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
		
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

Функция ПолучитьПредставлениеКлиента()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КраткоеНаименованиеПоУставу;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#Область Получение_исходных_данных_для_выполнения_анализа
	
Процедура ЗаполнитьТаблицуСчетовДУ(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ДействующиеСчетаДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
		|	И (НЕОПРЕДЕЛЕНО В (&СчетаДоверительногоУправления)
		|			ИЛИ СчетаДоверительногоУправления.Ссылка В (&СчетаДоверительногоУправления))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаНачала КАК Период,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия КАК Лицензия,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует КАК Действует
		|ПОМЕСТИТЬ _Лицензии
		|ИЗ
		|	РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(
		|			&ДатаНачала,
		|			(Организация, СчетДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					_ДействующиеСчетаДУ.Организация КАК Организация,
		|					_ДействующиеСчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|				ИЗ
		|					_ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ)) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует
		|	И ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛицензииДоговоровДоверительногоУправления.Период,
		|	ЛицензииДоговоровДоверительногоУправления.Организация,
		|	ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления,
		|	ЛицензииДоговоровДоверительногоУправления.Лицензия,
		|	ЛицензииДоговоровДоверительногоУправления.Действует
		|ИЗ
		|	_ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ
