Процедура ВыявлениеКонфликтов_6883(ПараметрыКоманды, ТекущаяДата)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды);
	
	Отбор = Новый Структура("ГруппаОтчетов, СписокОтчетов", Справочники.Отчеты.БэкОфис, Новый СписокЗначений);
	Отбор.СписокОтчетов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("_Отчет_ВыявлениеКонфликтовИнтересов"));
	
	НастройкиОтчетов = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьСоставИНастройкиОтчетовНаДату(
				ЭтотОбъект.Организация, 
				ТекущаяДата, 
				Истина, 
				Отбор, 
				Неопределено, 
				Ложь, 
				Ложь);
				
	СчетаДоверительногоУправления = НастройкиОтчетов.ВыгрузитьКолонку("Субъект");
				
	Если СчетаДоверительногоУправления.Количество() > 0 Тогда
		
		ЭтотОбъект.ГруппаОбстоятельств = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У;
		
		Календари = Справочники.Календари;
	    ЭтотОбъект.Период.ДатаОкончания = ТекущаяДата - 1;
		ЭтотОбъект.Период.ДатаНачала = Календари.ПолучитьБлижайшуюРабочуюДату(Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания);
		
		КонфликтыИнтересов = ПолучитьКонликтыИнтересов(Неопределено, Неопределено, СчетаДоверительногоУправления);
		
		СоздатьОбъектыКИ(КонфликтыИнтересов);	

		ЗафиксироватьРезультатСверки(НастройкиОтчетов);
	
	КонецЕсли;

