		|	ЕСТЬNULL(Договоры.Контрагент, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)),
		|	НЕОПРЕДЕЛЕНО,
		|	_ОстаткиДенежныхСредств.НачальныйОстаток,
		|	_ОстаткиДенежныхСредств.КонечныйОстаток
		|ИЗ
		|	_ОстаткиДенежныхСредств КАК _ОстаткиДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|			ПО БанковскиеСчета.Договор = Договоры.Ссылка
		|		ПО _ОстаткиДенежныхСредств.РасчетныйСчет = БанковскиеСчета.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ДатаОперации КАК ДатаОперации,
		|	ДоговорыСчетовДоверительногоУправления.Договор.ДатаЗаключения КАК ДатаЗаключения,
		|	ДоговорыСчетовДоверительногоУправления.Договор КАК Договор,
		|	ДоговорыСчетовДоверительногоУправления.Договор.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ _ДоговорыОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.ДатаОперации КАК ДатаОперации,
		|		_СчетаДоверительногоУправления.Организация КАК Организация,
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ДоговорыСчетовДоверительногоУправления.Договор КАК Договор,
		|		МАКСИМУМ(ДоговорыСчетовДоверительногоУправления.Период) КАК ПериодДоговорыДУ,
		|		МАКСИМУМ(УсловияДоговоровОбщие.Период) КАК ПериодУсловияДоговоров
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|			ПО _СчетаДоверительногоУправления.Организация = ДоговорыСчетовДоверительногоУправления.Организация
		|				И _СчетаДоверительногоУправления.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления
		|				И _СчетаДоверительногоУправления.ДатаОперации >= ДоговорыСчетовДоверительногоУправления.Период
		|				И (ТИПЗНАЧЕНИЯ(ДоговорыСчетовДоверительногоУправления.Договор) = ТИП(Справочник.ДоговорыБрокерскогоОбслуживания)
		|					ИЛИ ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправления.Договор КАК Справочник.Договоры).ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДепозитарногоОбслуживания), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СпецДепозитарногоОбслуживания), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БанковскогоОбслуживания), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БрокерскогоОбслуживания)))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие КАК УсловияДоговоровОбщие
		|			ПО _СчетаДоверительногоУправления.Организация = УсловияДоговоровОбщие.Организация
		|				И (ДоговорыСчетовДоверительногоУправления.Договор = УсловияДоговоровОбщие.Договор)
		|				И _СчетаДоверительногоУправления.ДатаОперации >= УсловияДоговоровОбщие.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.Организация,
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления,
		|		_СчетаДоверительногоУправления.ДатаОперации,
		|		ДоговорыСчетовДоверительногоУправления.Договор) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|		ПО ВложенныйЗапрос.Организация = ДоговорыСчетовДоверительногоУправления.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Договор = ДоговорыСчетовДоверительногоУправления.Договор
		|			И ВложенныйЗапрос.ПериодДоговорыДУ = ДоговорыСчетовДоверительногоУправления.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие КАК УсловияДоговоровОбщие
		|		ПО ВложенныйЗапрос.Организация = УсловияДоговоровОбщие.Организация
		|			И ВложенныйЗапрос.Договор = УсловияДоговоровОбщие.Договор
		|			И ВложенныйЗапрос.ПериодУсловияДоговоров = УсловияДоговоровОбщие.Период
		|ГДЕ
		|	ДоговорыСчетовДоверительногоУправления.Активный
		|	И (ЕСТЬNULL(УсловияДоговоровОбщие.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщие.ДатаРасторжения >= ВложенныйЗапрос.ДатаОперации)";		
	#КонецОбласти
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ЗаполнитьДействующиеКонфликты(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаДоверительногоУправления.ДатаОперации КАК ДатаОперации,
		|	КонфликтыИнтересов.Ссылка КАК КонфликтИнтересов,
		|	КонфликтыИнтересов.Обстоятельство КАК Обстоятельство,
		|	КонфликтыИнтересов.СвязанноеЛицо КАК СвязанноеЛицо,
		|	КонфликтыИнтересов.ПредметКонфликта КАК ПредметКонфликта,
		|	РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Ссылка КАК ПрекращениеКонфликтаИнтересов,
		|	ЕСТЬNULL(РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Проведен, ЛОЖЬ) КАК ПрекращениеКонфликтаИнтересовПроведен
		|ПОМЕСТИТЬ _ДействующиеКонфликты
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонфликтыИнтересов КАК КонфликтыИнтересов
		|		ПО _СчетаДоверительногоУправления.Организация = КонфликтыИнтересов.Организация
		|			И _СчетаДоверительногоУправления.СчетДоверительногоУправления = КонфликтыИнтересов.СчетДоверительногоУправления
		|			И (КонфликтыИнтересов.ДатаВозникновения <= _СчетаДоверительногоУправления.ДатаОперации)
		|			И (КонфликтыИнтересов.Обстоятельство В ИЕРАРХИИ (&ГруппаОбстоятельств))
		|			И НЕ КонфликтыИнтересов.ПометкаУдаления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересовВыявление
		|		ПО (КонфликтыИнтересов.Ссылка = РегистрацияИнформацииОКонфликтеИнтересовВыявление.КонфликтИнтересов)
		|			И (РегистрацияИнформацииОКонфликтеИнтересовВыявление.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Выявление))
		|			И (РегистрацияИнформацииОКонфликтеИнтересовВыявление.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересовПрекращение
		|		ПО (КонфликтыИнтересов.Ссылка = РегистрацияИнформацииОКонфликтеИнтересовПрекращение.КонфликтИнтересов)
		|			И (РегистрацияИнформацииОКонфликтеИнтересовПрекращение.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение))
		|			//И (НАЧАЛОПЕРИОДА(РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Дата, ДЕНЬ) <= _СчетаДоверительногоУправления.ДатаОперации)
		|			И (НЕ РегистрацияИнформацииОКонфликтеИнтересовПрекращение.ПометкаУдаления)";
	
	Запрос.Выполнить();

КонецПроцедуры

#КонецОбласти

#Область Запросы_для_определения_конфликтов

Процедура АнализОбстоятельстваЭмитентСвязанноеЛицо(Контекст)

	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;
	
	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЭмитентСвязанноеЛицо);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов КАК ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен КАК ПрекращениеКонфликтаИнтересовПроведен,
		|	МИНИМУМ(_ДействующиеКонфликты.ДатаОперации) КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ПрекращенныеКонфликты
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеОстатки КАК _ВсеОстатки
		|		ПО _ДействующиеКонфликты.Организация = _ВсеОстатки.Организация
		|			И _ДействующиеКонфликты.СчетДоверительногоУправления = _ВсеОстатки.СчетДоверительногоУправления
		|			И _ДействующиеКонфликты.СвязанноеЛицо = _ВсеОстатки.ОбязанноеЛицо
		|			И _ДействующиеКонфликты.ПредметКонфликта = _ВсеОстатки.ЦеннаяБумага
		|			И _ДействующиеКонфликты.ДатаОперации = _ВсеОстатки.ДатаОперации
		|ГДЕ
		|	_ДействующиеКонфликты.Обстоятельство = &Обстоятельство
		|	И НЕ _ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|	И ЕСТЬNULL(_ВсеОстатки.КонечныйОстаток, 0) = 0
		|	И &УсловияОтбораОстатков
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеОперации.Организация КАК Организация,
		|	_ВсеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеОперации.ДатаОперации КАК ДатаОперации,
		|	_ВсеОперации.Операция КАК Операция,
		|	_ВсеОперации.ВидОперации КАК ВидОперации,
		|	_ВсеОперации.Рынок КАК Рынок,
		|	_ВсеОперации.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеОперации.ОбязанноеЛицо КАК ОбязанноеЛицо,
		|	ЛОЖЬ КАК ЭтоОстаток,
		|	0 КАК НачальныйОстаток,
		|	0 КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_ВсеОперации КАК _ВсеОперации
		|ГДЕ
		|	&УсловияОтбора
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ВсеОстатки.Организация,
		|	_ВсеОстатки.СчетДоверительногоУправления,
		|	_ВсеОстатки.ДатаОперации,
		|	""Остаток на дату включения в список связанных"",
		|	_ВсеОстатки.ВидОперации,
		|	_ВсеОстатки.Рынок,
		|	_ВсеОстатки.ЦеннаяБумага,
		|	_ВсеОстатки.ОбязанноеЛицо,
		|	ИСТИНА,
		|	_ВсеОстатки.НачальныйОстаток,
		|	_ВсеОстатки.КонечныйОстаток
		|ИЗ
		|	_ВсеОстатки КАК _ВсеОстатки
		|ГДЕ
		|	&УсловияОтбораОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ОперацииДляОбстоятельства.ОбязанноеЛицо КАК ОбязанноеЛицо,
		|	_ОперацииДляОбстоятельства.ОбязанноеЛицо КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_СвязанныеЛица.ДатаОснования КАК ДатаОснования,
		|	_СвязанныеЛица.АнализОстатковНаНачало КАК АнализОстатковНаНачало,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПрекращения
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СвязанныеЛица КАК _СвязанныеЛица
		|		ПО _ОперацииДляОбстоятельства.Организация = _СвязанныеЛица.Организация
		|			И (_ОперацииДляОбстоятельства.СчетДоверительногоУправления = _СвязанныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _СвязанныеЛица.ДатаОперации
		|			И _ОперацииДляОбстоятельства.ОбязанноеЛицо = _СвязанныеЛица.СвязанноеЮрФизЛицо
		|			И (НЕ _ОперацииДляОбстоятельства.ЭтоОстаток
		|				ИЛИ _СвязанныеЛица.АнализОстатковНаНачало
		|					И _ОперацииДляОбстоятельства.НачальныйОстаток <> 0)";
	
	#КонецОбласти 	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "_ВсеОстатки.ВидОперации В (""ОстаткиЦенныхБумаг"", ""ДенежныеСредстваВКредитныхИнструментах"")");
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЭмитентСвязанноеЛицо, НастройкиОтбораОбстоятельств);
		
	Результат = Запрос.Выполнить();
	
	#Область Поиск_даты_возникновения_конфликта
	
	ОбстоятельстваВозникновенияКонфликта = Результат.Выгрузить();
		
	Для каждого СтрокаВыявленныхОбстоятельств Из ОбстоятельстваВозникновенияКонфликта Цикл
	
		// Лицо включили в список в дату операции, но дата основания находится раньше
		// Необходимо получить ближайшую дату нулевого остатка в прошлом 
		Если СтрокаВыявленныхОбстоятельств.АнализОстатковНаНачало И 
			СтрокаВыявленныхОбстоятельств.ДатаОснования < СтрокаВыявленныхОбстоятельств.ДатаВозникновения Тогда
		
			Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	НАЧАЛОПЕРИОДА(ОстаткиЦенныхБумагОстаткиИОбороты.Период, ДЕНЬ) КАК Дата
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
				|			&ДатаОснования,
				|			&ДатаОперации,
				|			Регистратор,
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстаткиИОбороты
				|ГДЕ
				|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток = 0
				|
				|УПОРЯДОЧИТЬ ПО
				|	ОстаткиЦенныхБумагОстаткиИОбороты.Период УБЫВ";

			Запрос.УстановитьПараметр("ДатаОснования", Новый Граница(СтрокаВыявленныхОбстоятельств.ДатаОснования, ВидГраницы.Включая));
			Запрос.УстановитьПараметр("ДатаОперации", Новый Граница(СтрокаВыявленныхОбстоятельств.ДатаВозникновения, ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтрокаВыявленныхОбстоятельств.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаВыявленныхОбстоятельств.ПредметКонфликта);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				СтрокаВыявленныхОбстоятельств.ДатаВозникновения = Выборка.Дата;
			Иначе
				СтрокаВыявленныхОбстоятельств.ДатаВозникновения = СтрокаВыявленныхОбстоятельств.ДатаОснования;
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
		
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ОбстоятельстваВозникновенияКонфликта, 
		"_ВыявленныеОбстоятельства",
		Запрос);
	
	#КонецОбласти
	
	ОбработатьРезультатЗапроса(Контекст);
	
КонецПроцедуры

Процедура АнализОбстоятельстваЦенныеБумагиНаРазмещении(Контекст)
	
	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;
	
	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЦенныеБумагиНаРазмещении);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеОперации.Организация КАК Организация,
		|	_ВсеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеОперации.ДатаОперации КАК ДатаОперации,
		|	_ВсеОперации.Операция КАК Операция,
		|	_ВсеОперации.ВидОперации КАК ВидОперации,
		|	_ВсеОперации.Рынок КАК Рынок,
		|	_ВсеОперации.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_ВсеОперации КАК _ВсеОперации
		|ГДЕ
		|	&УсловияОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОрганизаторыРазмещенияЦенныхБумаг.ЮрЛицо КАК Агент,
		|	_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЦенныеБумагиНаРазмещении
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ЦеннаяБумага,
		|			ЕСТЬNULL(НачалоПериодаРазмещения.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК НачалоПериодаРазмещения,
		|			ЕСТЬNULL(ОкончаниеПериодаРазмещения.Период, ДАТАВРЕМЯ(3999, 12, 31)) КАК ОкончаниеПериодаРазмещения
		|		ИЗ
		|			_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг КАК НачалоПериодаРазмещения
		|				ПО _ОперацииДляОбстоятельства.Рынок = НачалоПериодаРазмещения.Рынок
		|					И _ОперацииДляОбстоятельства.ЦеннаяБумага = НачалоПериодаРазмещения.ЦеннаяБумага
		|					И (НачалоПериодаРазмещения.Биржа = ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка))
		|					И (НачалоПериодаРазмещения.Статус = ЗНАЧЕНИЕ(Перечисление.ЖизненныйЦиклЦенныхБумаг.ВРазмещении))
		|					И (НачалоПериодаРазмещения.Активен)
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЦенныхБумаг КАК ОкончаниеПериодаРазмещения
		|				ПО _ОперацииДляОбстоятельства.Рынок = ОкончаниеПериодаРазмещения.Рынок
		|					И _ОперацииДляОбстоятельства.ЦеннаяБумага = ОкончаниеПериодаРазмещения.ЦеннаяБумага
		|					И (ОкончаниеПериодаРазмещения.Биржа = ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка))
		|					И (ОкончаниеПериодаРазмещения.Статус = ЗНАЧЕНИЕ(Перечисление.ЖизненныйЦиклЦенныхБумаг.ВРазмещении))
		|					И (НЕ ОкончаниеПериодаРазмещения.Активен)) КАК ПериодыРазмещения
		|		ПО _ОперацииДляОбстоятельства.ЦеннаяБумага = ПериодыРазмещения.ЦеннаяБумага
		|			И (_ОперацииДляОбстоятельства.ДатаОперации МЕЖДУ ПериодыРазмещения.НачалоПериодаРазмещения И ПериодыРазмещения.ОкончаниеПериодаРазмещения)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОрганизаторыРазмещенияЦенныхБумаг КАК ОрганизаторыРазмещенияЦенныхБумаг
		|		ПО _ОперацииДляОбстоятельства.ЦеннаяБумага = ОрганизаторыРазмещенияЦенныхБумаг.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ЦенныеБумагиНаРазмещении.Агент КАК АгентПоРазмещению,
		|	_ЦенныеБумагиНаРазмещении.Агент КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_СвязанныеЛица.ДатаОснования КАК ДатаОснования,
		|	_СвязанныеЛица.АнализОстатковНаНачало КАК АнализОстатковНаНачало,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ВыявленныеОбстоятельства
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СвязанныеЛица КАК _СвязанныеЛица
		|		ПО _ОперацииДляОбстоятельства.Организация = _СвязанныеЛица.Организация
		|			И (_ОперацииДляОбстоятельства.СчетДоверительногоУправления = _СвязанныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _СвязанныеЛица.ДатаОперации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЦенныеБумагиНаРазмещении КАК _ЦенныеБумагиНаРазмещении
		|		ПО _ОперацииДляОбстоятельства.ЦеннаяБумага = _ЦенныеБумагиНаРазмещении.ЦеннаяБумага
		|			И (_СвязанныеЛица.СвязанноеЮрФизЛицо = _ЦенныеБумагиНаРазмещении.Агент)";
		
	#КонецОбласти 	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "_ВсеОстатки.ВидОперации В (""ОстаткиЦенныхБумаг"")");
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЦенныеБумагиНаРазмещении, НастройкиОтбораОбстоятельств);
	
	Запрос.Выполнить();
	
	ОбработатьРезультатЗапроса(Контекст);
	
КонецПроцедуры

Процедура АнализОбстоятельстваДоговорОСтабилизацииЦен(Контекст)

	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;

	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорОСтабилизацииЦен);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);
	
	РегистрыСведений.ОбязательстваМаркетМейкеров.ЗаполнитьТаблицуСоответствияРежимовТоргов(Запрос.МенеджерВременныхТаблиц);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов КАК ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен КАК ПрекращениеКонфликтаИнтересовПроведен,
		|	МИНИМУМ(_ДействующиеКонфликты.ДатаОперации) КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ПрекращенныеКонфликты
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеОстатки КАК _ВсеОстатки
		|		ПО _ДействующиеКонфликты.Организация = _ВсеОстатки.Организация
		|			И _ДействующиеКонфликты.СчетДоверительногоУправления = _ВсеОстатки.СчетДоверительногоУправления
		|			И _ДействующиеКонфликты.СвязанноеЛицо = _ВсеОстатки.ОбязанноеЛицо
		|			И _ДействующиеКонфликты.ПредметКонфликта = _ВсеОстатки.ЦеннаяБумага
		|			И _ДействующиеКонфликты.ДатаОперации = _ВсеОстатки.ДатаОперации
		|			И (&УсловияОтбораОстатков)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|			_ДействующиеКонфликты.ДатаОперации КАК ДатаОперации,
		|			МАКСИМУМ(ОбязательстваМаркетМейкеров.Период) КАК Период
		|		ИЗ
		|			_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбязательстваМаркетМейкеров КАК ОбязательстваМаркетМейкеров
		|				ПО _ДействующиеКонфликты.ПредметКонфликта = ОбязательстваМаркетМейкеров.ЦеннаяБумага
		|					И _ДействующиеКонфликты.СвязанноеЛицо = ОбязательстваМаркетМейкеров.ЮрФизЛицо
		|					И (ОбязательстваМаркетМейкеров.Период <= _ДействующиеКонфликты.ДатаОперации)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ДействующиеКонфликты.КонфликтИнтересов,
		|			_ДействующиеКонфликты.ДатаОперации) КАК ПериодыОбязательств
		|		ПО _ДействующиеКонфликты.КонфликтИнтересов = ПериодыОбязательств.КонфликтИнтересов
		|			И _ДействующиеКонфликты.ДатаОперации = ПериодыОбязательств.ДатаОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбязательстваМаркетМейкеров КАК ОбязательстваМаркетМейкеров
		|		ПО _ДействующиеКонфликты.ПредметКонфликта = ОбязательстваМаркетМейкеров.ЦеннаяБумага
		|			И _ДействующиеКонфликты.СвязанноеЛицо = ОбязательстваМаркетМейкеров.ЮрФизЛицо
		|			И (ОбязательстваМаркетМейкеров.Период = ОбязательстваМаркетМейкеров.Период)
		|ГДЕ
		|	_ДействующиеКонфликты.Обстоятельство = &Обстоятельство
		|	И НЕ _ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|	И (ЕСТЬNULL(_ВсеОстатки.КонечныйОстаток, 0) = 0
		|			ИЛИ НЕ ЕСТЬNULL(ОбязательстваМаркетМейкеров.Действует, ЛОЖЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеОперации.Организация КАК Организация,
		|	_ВсеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеОперации.ДатаОперации КАК ДатаОперации,
		|	_ВсеОперации.Операция КАК Операция,
		|	_ВсеОперации.ВидОперации КАК ВидОперации,
		|	_ВсеОперации.Рынок КАК Рынок,
		|	_ВсеОперации.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеОперации.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	ЛОЖЬ КАК ЭтоОстаток,
		|	0 КАК НачальныйОстаток,
		|	0 КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_ВсеОперации КАК _ВсеОперации
		|ГДЕ
		|	&УсловияОтбора
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ВсеОстатки.Организация,
		|	_ВсеОстатки.СчетДоверительногоУправления,
		|	_ВсеОстатки.ДатаОперации,
		|	_ВсеОстатки.Операция,
		|	_ВсеОстатки.ВидОперации,
		|	_ВсеОстатки.Рынок,
		|	_ВсеОстатки.ЦеннаяБумага,
		|	_ВсеОстатки.РежимБиржевыхТоргов,
		|	ИСТИНА,
		|	_ВсеОстатки.НачальныйОстаток,
		|	_ВсеОстатки.КонечныйОстаток
		|ИЗ
		|	_ВсеОстатки КАК _ВсеОстатки
		|ГДЕ
		|	&УсловияОтбораОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбязательстваМаркетМейкеровПоДатамОпераций.ДатаОперации КАК ДатаОперации,
		|	ОбязательстваМаркетМейкеровПоДатамОпераций.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОбязательстваМаркетМейкеровПоДатамОпераций.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	ОбязательстваМаркетМейкеровПоДатамОпераций.ЮрФизЛицо КАК ЮрФизЛицоМаркетМейкер,
		|	ОбязательстваМаркетМейкеровПоДатамОпераций.Период КАК ДатаДоговора
		|ПОМЕСТИТЬ _ОбязательстваМаркетМейкеров
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаОперации,
		|		_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ЦеннаяБумага,
		|		ОбязательстваМаркетМейкеров.ЮрФизЛицо КАК ЮрФизЛицо,
		|		ОбязательстваМаркетМейкеров.РежимТоргов КАК РежимТорговСтрока,
		|		МАКСИМУМ(ОбязательстваМаркетМейкеров.Период) КАК Период,
		|		_ОперацииДляОбстоятельства.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов
		|	ИЗ
		|		_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СоответствиеРежимовТоргов КАК _СоответствиеРежимовТоргов
		|			ПО (ВЫБОР
		|					КОГДА _ОперацииДляОбстоятельства.РежимБиржевыхТоргов ЕСТЬ NULL
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ _ОперацииДляОбстоятельства.РежимБиржевыхТоргов = _СоответствиеРежимовТоргов.РежимТорговСсылка
		|				КОНЕЦ)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбязательстваМаркетМейкеров КАК ОбязательстваМаркетМейкеров
		|			ПО _ОперацииДляОбстоятельства.ЦеннаяБумага = ОбязательстваМаркетМейкеров.ЦеннаяБумага
		|				И (ОбязательстваМаркетМейкеров.РежимТоргов = _СоответствиеРежимовТоргов.РежимТорговСтрока)
		|				И (ОбязательстваМаркетМейкеров.Период <= _ОперацииДляОбстоятельства.ДатаОперации)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОперацииДляОбстоятельства.ДатаОперации,
		|		_ОперацииДляОбстоятельства.ЦеннаяБумага,
		|		ОбязательстваМаркетМейкеров.ЮрФизЛицо,
		|		ОбязательстваМаркетМейкеров.РежимТоргов,
		|		_ОперацииДляОбстоятельства.РежимБиржевыхТоргов) КАК ОбязательстваМаркетМейкеровПоДатамОпераций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбязательстваМаркетМейкеров КАК ОбязательстваМаркетМейкеров
		|		ПО ОбязательстваМаркетМейкеровПоДатамОпераций.Период = ОбязательстваМаркетМейкеров.Период
		|			И ОбязательстваМаркетМейкеровПоДатамОпераций.ЦеннаяБумага = ОбязательстваМаркетМейкеров.ЦеннаяБумага
		|			И ОбязательстваМаркетМейкеровПоДатамОпераций.ЮрФизЛицо = ОбязательстваМаркетМейкеров.ЮрФизЛицо
		|			И ОбязательстваМаркетМейкеровПоДатамОпераций.РежимТорговСтрока = ОбязательстваМаркетМейкеров.РежимТоргов
		|			И (ОбязательстваМаркетМейкеров.Действует)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДатаОперации,
		|	ЮрФизЛицоМаркетМейкер,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ОперацииДляОбстоятельства.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	_ОбязательстваМаркетМейкеров.ЮрФизЛицоМаркетМейкер КАК МаркетМейкер,
		|	_ОбязательстваМаркетМейкеров.ДатаДоговора КАК ДатаДоговора,
		|	_ОбязательстваМаркетМейкеров.ЮрФизЛицоМаркетМейкер КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_СвязанныеЛица.ДатаОснования КАК ДатаОснования,
		|	_СвязанныеЛица.АнализОстатковНаНачало КАК АнализОстатковНаНачало,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПрекращения
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СвязанныеЛица КАК _СвязанныеЛица
		|		ПО _ОперацииДляОбстоятельства.Организация = _СвязанныеЛица.Организация
		|			И (_ОперацииДляОбстоятельства.СчетДоверительногоУправления = _СвязанныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _СвязанныеЛица.ДатаОперации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОбязательстваМаркетМейкеров КАК _ОбязательстваМаркетМейкеров
		|		ПО _ОперацииДляОбстоятельства.ДатаОперации = _ОбязательстваМаркетМейкеров.ДатаОперации
		|			И _ОперацииДляОбстоятельства.ЦеннаяБумага = _ОбязательстваМаркетМейкеров.ЦеннаяБумага
		|			И (ВЫБОР
		|				КОГДА _ОперацииДляОбстоятельства.РежимБиржевыхТоргов ЕСТЬ NULL
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ _ОперацииДляОбстоятельства.РежимБиржевыхТоргов = _ОбязательстваМаркетМейкеров.РежимБиржевыхТоргов
		|			КОНЕЦ)
		|			И (_СвязанныеЛица.СвязанноеЮрФизЛицо = _ОбязательстваМаркетМейкеров.ЮрФизЛицоМаркетМейкер)";
		
	#КонецОбласти 	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "_ВсеОстатки.ВидОперации В (""ОстаткиЦенныхБумаг"")");
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорОСтабилизацииЦен, НастройкиОтбораОбстоятельств);
	
	Результат = Запрос.Выполнить();
	
	#Область Поиск_даты_возникновения_конфликта
	
	ОбстоятельстваВозникновенияКонфликта = Результат.Выгрузить();
		
	Для каждого СтрокаВыявленныхОбстоятельств Из ОбстоятельстваВозникновенияКонфликта Цикл
		
		// Необходимо получить более позднюю из 3х дат:
		// Дата возникновения остатка (получаем в запросе ниже)
		// Дата возникновения основания для включения в список связанных (ДатаВозникновения)
		// Дата заключения договора о стабилизации цен (ДатаДоговора)
		
		Если СтрокаВыявленныхОбстоятельств.АнализОстатковНаНачало И 
			СтрокаВыявленныхОбстоятельств.ДатаОснования < СтрокаВыявленныхОбстоятельств.ДатаВозникновения Тогда
		
			Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	НАЧАЛОПЕРИОДА(ОстаткиЦенныхБумагОстаткиИОбороты.Период, ДЕНЬ) КАК Дата
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
				|			&ДатаОснования,
				|			&ДатаОперации,
				|			Регистратор,
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстаткиИОбороты
				|ГДЕ
				|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток = 0
				|
				|УПОРЯДОЧИТЬ ПО
				|	ОстаткиЦенныхБумагОстаткиИОбороты.Период УБЫВ";

			Запрос.УстановитьПараметр("ДатаОснования", Новый Граница(СтрокаВыявленныхОбстоятельств.ДатаОснования, ВидГраницы.Включая));
			Запрос.УстановитьПараметр("ДатаОперации", Новый Граница(СтрокаВыявленныхОбстоятельств.ДатаВозникновения, ВидГраницы.Исключая));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", СтрокаВыявленныхОбстоятельств.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ЦеннаяБумага", СтрокаВыявленныхОбстоятельств.ПредметКонфликта);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				Если Выборка.Дата > СтрокаВыявленныхОбстоятельств.ДатаДоговора Тогда
				    СтрокаВыявленныхОбстоятельств.ДатаВозникновения = Выборка.Дата;
				Иначе
					СтрокаВыявленныхОбстоятельств.ДатаВозникновения = СтрокаВыявленныхОбстоятельств.ДатаДоговора;
				КонецЕсли;
			Иначе
				СтрокаВыявленныхОбстоятельств.ДатаВозникновения = СтрокаВыявленныхОбстоятельств.ДатаОснования;
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
		
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(
		ОбстоятельстваВозникновенияКонфликта, 
		"_ВыявленныеОбстоятельства",
		Запрос);
	
	#КонецОбласти
	
	ОбработатьРезультатЗапроса(Контекст);
	
КонецПроцедуры

Процедура АнализОбстоятельстваСделкаСУправляющейКомпаниейДоговоры(Контекст)

	Запрос = Контекст.Запрос; 
	
	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСУправляющейКомпанией);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);

	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов КАК ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен КАК ПрекращениеКонфликтаИнтересовПроведен,
		|	МИНИМУМ(_ДействующиеКонфликты.ДатаОперации) КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ПрекращенныеКонфликты
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДоговорыОстатки КАК _ДоговорыОстатки
		|		ПО _ДействующиеКонфликты.Организация = _ДоговорыОстатки.Организация
		|			И _ДействующиеКонфликты.СчетДоверительногоУправления = _ДоговорыОстатки.СчетДоверительногоУправления
		|			И _ДействующиеКонфликты.СвязанноеЛицо = _ДоговорыОстатки.Контрагент
		|			И _ДействующиеКонфликты.ПредметКонфликта = _ДоговорыОстатки.Договор
		|			И _ДействующиеКонфликты.ДатаОперации = _ДоговорыОстатки.ДатаОперации
		|ГДЕ
		|	_ДействующиеКонфликты.Обстоятельство = &Обстоятельство
		|	И НЕ _ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|	И _ДоговорыОстатки.СчетДоверительногоУправления ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Договоры.Организация КАК Организация,
		|	_Договоры.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Договоры.Договор КАК Договор,
		|	_Договоры.ДатаОперации КАК ДатаОперации,
		|	""Заключение договора"" КАК Операция,
		|	_Договоры.Контрагент КАК Контрагент,
		|	_Договоры.ДатаЗаключения КАК ДатаЗаключения,
		|	ЛОЖЬ КАК ЭтоОстаток
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_Договоры КАК _Договоры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДоговорыОстатки.Организация,
		|	_ДоговорыОстатки.СчетДоверительногоУправления,
		|	_ДоговорыОстатки.Договор,
		|	_ДоговорыОстатки.ДатаОперации,
		|	""Заключение договора"",
		|	_ДоговорыОстатки.Контрагент,
		|	_ДоговорыОстатки.ДатаЗаключения,
		|	ИСТИНА
		|ИЗ
		|	_ДоговорыОстатки КАК _ДоговорыОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ОперацииДляОбстоятельства.ЭтоОстаток
		|			ТОГДА ВЫБОР
		|					КОГДА _ОперацииДляОбстоятельства.ДатаЗаключения > _СвязанныеИОтветственныеЛица.ДатаОснования
		|						ТОГДА _ОперацииДляОбстоятельства.ДатаЗаключения
		|					ИНАЧЕ _СвязанныеИОтветственныеЛица.ДатаОснования
		|				КОНЕЦ
		|		ИНАЧЕ _ОперацииДляОбстоятельства.ДатаОперации
		|	КОНЕЦ КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ОперацииДляОбстоятельства.Контрагент КАК Контрагент,
		|	_ОперацииДляОбстоятельства.Контрагент КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.Договор КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_СвязанныеИОтветственныеЛица.ДатаОснования КАК ДатаОснования,
		|	_СвязанныеИОтветственныеЛица.АнализОстатковНаНачало КАК АнализОстатковНаНачало,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ВыявленныеОбстоятельства
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СвязанныеИОтветственныеЛица КАК _СвязанныеИОтветственныеЛица
		|		ПО _ОперацииДляОбстоятельства.Организация = _СвязанныеИОтветственныеЛица.Организация
		|			И (_ОперацииДляОбстоятельства.СчетДоверительногоУправления = _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _СвязанныеИОтветственныеЛица.ДатаОперации
		|			И _ОперацииДляОбстоятельства.Контрагент = _СвязанныеИОтветственныеЛица.ЮрФизЛицо
		|			И (НЕ _ОперацииДляОбстоятельства.ЭтоОстаток
		|				ИЛИ _СвязанныеИОтветственныеЛица.АнализОстатковНаНачало)";
		
	#КонецОбласти
		
	Запрос.Выполнить();
	
	ОбработатьРезультатЗапроса(Контекст);	

КонецПроцедуры

Процедура АнализОбстоятельстваСделкаСУправляющейКомпанией(Контекст)

	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;

	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСУправляющейКомпанией);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);

	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеОперации.Организация КАК Организация,
		|	_ВсеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеОперации.ДатаОперации КАК ДатаОперации,
		|	_ВсеОперации.Операция КАК Операция,
		|	_ВсеОперации.Контрагент КАК Контрагент,
		|	_ВсеОперации.ВидОперации КАК ВидОперации,
		|	_ВсеОперации.Рынок КАК Рынок,
		|	_ВсеОперации.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеОперации.МестоХранения КАК МестоХранения,
		|	_ВсеОперации.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	_ВсеОперации.РежимПереговорныхСделок КАК РежимПереговорныхСделок
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_ВсеОперации КАК _ВсеОперации
		|ГДЕ
		|	&УсловияОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ОперацииДляОбстоятельства.МестоХранения КАК МестоХранения,
		|	_ОперацииДляОбстоятельства.Контрагент КАК Контрагент,
		|	_ОперацииДляОбстоятельства.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	_ОперацииДляОбстоятельства.Контрагент КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.ЦеннаяБумага КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_СвязанныеИОтветственныеЛица.ДатаОснования КАК ДатаОснования,
		|	_СвязанныеИОтветственныеЛица.АнализОстатковНаНачало КАК АнализОстатковНаНачало,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ВыявленныеОбстоятельства
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СвязанныеИОтветственныеЛица КАК _СвязанныеИОтветственныеЛица
		|		ПО _ОперацииДляОбстоятельства.Организация = _СвязанныеИОтветственныеЛица.Организация
		|			И (_ОперацииДляОбстоятельства.СчетДоверительногоУправления = _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления = Неопределено)
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _СвязанныеИОтветственныеЛица.ДатаОперации
		|			И _ОперацииДляОбстоятельства.Контрагент = _СвязанныеИОтветственныеЛица.ЮрФизЛицо";
		
	#КонецОбласти
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "_ВсеОстатки.ВидОперации В (""ДенежныеСредстваВКредитныхИнструментах"", ""ОстаткиДенежныхСредств"")");
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСУправляющейКомпанией, НастройкиОтбораОбстоятельств);
	
	Запрос.Выполнить();
	
	ОбработатьРезультатЗапроса(Контекст);	

КонецПроцедуры

Процедура АнализОбстоятельстваИспользованиеИнформации(Контекст)

	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;

	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ИспользованиеИнформации);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);
	
	Возврат;
	
	Запрос.Текст = "";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "ЛОЖЬ"); // Удалить
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ИспользованиеИнформации, НастройкиОтбораОбстоятельств);
	
	Запрос.Выполнить();
	
	ОбработатьРезультатЗапроса(Контекст);
	
КонецПроцедуры

Процедура АнализОбстоятельстваЧастотаСделок(Контекст)

	Запрос = Контекст.Запрос; 
	НастройкиОтбораОбстоятельств = Контекст.НастройкиОтбораОбстоятельств;

	Обстоятельство = ПолучитьОбстоятельствоПоУказанию(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЧастотаСделок);
	Запрос.УстановитьПараметр("Обстоятельство", Обстоятельство);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеОперации.Организация КАК Организация,
		|	_ВсеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеОперации.ДатаОперации КАК ДатаОперации,
		|	_ВсеОперации.Операция КАК Операция,
		|	_ВсеОперации.Контрагент КАК Контрагент,
		|	_ВсеОперации.ВидОперации КАК ВидОперации,
		|	_ВсеОперации.Рынок КАК Рынок,
		|	_ВсеОперации.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВсеОперации.МестоХранения КАК МестоХранения,
		|	_ВсеОперации.Брокер КАК Брокер,
		|	_ВсеОперации.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	_ВсеОперации.ВидСделки КАК ВидСделки,
		|	_ВсеОперации.ВремяСделки КАК ВремяСделки,
		|	_ВсеОперации.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО
		|ПОМЕСТИТЬ _ОперацииДляОбстоятельства
		|ИЗ
		|	_ВсеОперации КАК _ВсеОперации
		|ГДЕ
		|	&УсловияОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаря.Дата) КАК СрокРЕПО
		|ПОМЕСТИТЬ _СрокиСделокРЕПО
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (_ОперацииДляОбстоятельства.ВидОперации = ""СделкаРЕПО"")
		|			И (ДанныеКалендаря.Календарь = &КалендарьКотировок)
		|			И _ОперацииДляОбстоятельства.ДатаОперации < ДанныеКалендаря.Дата
		|			И _ОперацииДляОбстоятельства.ДатаВторойЧастиРЕПО >= ДанныеКалендаря.Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОперацииДляОбстоятельства.Операция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаВозникновения,
		|	_ОперацииДляОбстоятельства.Операция КАК Операция,
		|	_ОперацииДляОбстоятельства.МестоХранения КАК МестоХранения,
		|	_ОперацииДляОбстоятельства.Брокер КАК Брокер,
		|	_ОперацииДляОбстоятельства.Контрагент КАК Контрагент,
		|	_ОперацииДляОбстоятельства.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	НЕОПРЕДЕЛЕНО КАК СвязанноеЛицо,
		|	_ОперацииДляОбстоятельства.Операция КАК ПредметКонфликта,
		|	&Обстоятельство КАК Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация КАК Организация,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаОснования,
		|	ЛОЖЬ КАК АнализОстатковНаНачало,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаПрекращения
		|ПОМЕСТИТЬ _ВыявленныеОбстоятельства
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства1
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства2
		|			ПО _ОперацииДляОбстоятельства1.Организация = _ОперацииДляОбстоятельства2.Организация
		|				И _ОперацииДляОбстоятельства1.СчетДоверительногоУправления = _ОперацииДляОбстоятельства2.СчетДоверительногоУправления
		|				И _ОперацииДляОбстоятельства1.ДатаОперации = _ОперацииДляОбстоятельства2.ДатаОперации
		|				И _ОперацииДляОбстоятельства1.ВидОперации = _ОперацииДляОбстоятельства2.ВидОперации
		|				И _ОперацииДляОбстоятельства1.Рынок = _ОперацииДляОбстоятельства2.Рынок
		|				И _ОперацииДляОбстоятельства1.ЦеннаяБумага = _ОперацииДляОбстоятельства2.ЦеннаяБумага
		|				И _ОперацииДляОбстоятельства1.ВидСделки <> _ОперацииДляОбстоятельства2.ВидСделки
		|				И _ОперацииДляОбстоятельства1.ВремяСделки >= _ОперацииДляОбстоятельства2.ВремяСделки
		|		ПО _ОперацииДляОбстоятельства.Организация = _ОперацииДляОбстоятельства1.Организация
		|			И _ОперацииДляОбстоятельства.СчетДоверительногоУправления = _ОперацииДляОбстоятельства1.СчетДоверительногоУправления
		|			И _ОперацииДляОбстоятельства.ДатаОперации = _ОперацииДляОбстоятельства1.ДатаОперации
		|			И _ОперацииДляОбстоятельства.ВидОперации = _ОперацииДляОбстоятельства1.ВидОперации
		|			И _ОперацииДляОбстоятельства.Рынок = _ОперацииДляОбстоятельства1.Рынок
		|			И _ОперацииДляОбстоятельства.ЦеннаяБумага = _ОперацииДляОбстоятельства1.ЦеннаяБумага
		|			И _ОперацииДляОбстоятельства.ВидСделки <> _ОперацииДляОбстоятельства1.ВидСделки
		|			И _ОперацииДляОбстоятельства.ВремяСделки >= _ОперацииДляОбстоятельства1.ВремяСделки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ОперацииДляОбстоятельства.СчетДоверительногоУправления,
		|	_ОперацииДляОбстоятельства.ДатаОперации,
		|	_ОперацииДляОбстоятельства.Операция,
		|	_ОперацииДляОбстоятельства.МестоХранения,
		|	_ОперацииДляОбстоятельства.Брокер,
		|	_ОперацииДляОбстоятельства.Контрагент,
		|	_ОперацииДляОбстоятельства.РежимБиржевыхТоргов,
		|	НЕОПРЕДЕЛЕНО,
		|	_ОперацииДляОбстоятельства.Операция,
		|	&Обстоятельство,
		|	_ОперацииДляОбстоятельства.Организация,
		|	_ОперацииДляОбстоятельства.ДатаОперации КАК ДатаОснования,
		|	ЛОЖЬ КАК АнализОстатковНаНачало,
		|	_ОперацииДляОбстоятельства.ДатаОперации
		|ИЗ
		|	_ОперацииДляОбстоятельства КАК _ОперацииДляОбстоятельства
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СрокиСделокРЕПО КАК _СрокиСделокРЕПО
		|		ПО _ОперацииДляОбстоятельства.Операция = _СрокиСделокРЕПО.Операция
		|ГДЕ
		|	_ОперацииДляОбстоятельства.ВидОперации = ""СделкаРЕПО""
		|	И (_ОперацииДляОбстоятельства.ДатаОперации = _ОперацииДляОбстоятельства.ДатаВторойЧастиРЕПО
		|			ИЛИ &ЭтоОрганизацияРПИ
		|				И ЕСТЬNULL(_СрокиСделокРЕПО.СрокРЕПО, 0) = 1)";
		
	#КонецОбласти 	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораОстатков", "ЛОЖЬ"); // Удалить
	ЗаполнитьУсловияОтбора(Запрос, Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЧастотаСделок, НастройкиОтбораОбстоятельств);
	
	Запрос.Выполнить();
	
	ОбработатьРезультатЗапроса(Контекст);
	
КонецПроцедуры

#КонецОбласти

#Область Общие_процедуры_выполнения_запросов_и_обработки_результатов

Процедура ОбработатьРезультатЗапроса(Контекст)

	Запрос = Контекст.Запрос;
	ИменаВременныхТаблицЗапроса = Контекст.ИменаВременныхТаблицЗапроса;
	КонфликтыИнтересов = Контекст.КонфликтыИнтересов;
		
	Если Контекст.Свойство("ТаблицаСведений") Тогда
		ДобавитьСтрокиВТаблицуСведений(Запрос, "_ВыявленныеОбстоятельства", Контекст.ТаблицаСведений);
	КонецЕсли;
	
	#Область Выявленные_конфликты
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонфликтыИнтересов.Ссылка КАК КонфликтИнтересов,
		|	_ВыявленныеОбстоятельства.Обстоятельство КАК Обстоятельство,
		|	_ВыявленныеОбстоятельства.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВыявленныеОбстоятельства.ДатаВозникновения КАК ДатаВозникновения,
		|	_ВыявленныеОбстоятельства.ПредметКонфликта КАК ПредметКонфликта,
		|	_ВыявленныеОбстоятельства.СвязанноеЛицо КАК СвязанноеЛицо,
		|	РегистрацияИнформацииОКонфликтеИнтересов.Ссылка КАК РегистрацияИнформацииОКонфликтеИнтересов,
		|	ЕСТЬNULL(РегистрацияИнформацииОКонфликтеИнтересов.Проведен, Ложь) КАК РегистрацияИнформацииОКонфликтеИнтересовПроведен,
		|	РегистрацияИнформацииОКонфликтеИнтересов.Дата КАК ДатаСобытия,
		|	ПрекращениеКонфликта.Дата КАК ДатаСобытияПрекращение,
		|	ПрекращениеКонфликта.Ссылка КАК РегистрацияИнформацииОПрекращенииКонфликта,
		|	ЕСТЬNULL(ПрекращениеКонфликта.Проведен, Ложь) КАК РегистрацияИнформацииОПрекращенииКонфликтаПроведен,
		|	ЕСТЬNULL(ПрекращениеКонфликта.Дата, _ВыявленныеОбстоятельства.ДатаПрекращения) КАК ДатаПрекращения,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Выявление) КАК ВидСобытия
		|ИЗ
		|	_ВыявленныеОбстоятельства КАК _ВыявленныеОбстоятельства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонфликтыИнтересов КАК КонфликтыИнтересов
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересов
		|			ПО КонфликтыИнтересов.Ссылка = РегистрацияИнформацииОКонфликтеИнтересов.КонфликтИнтересов
		|				И (РегистрацияИнформацииОКонфликтеИнтересов.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Выявление))
		|				И НЕ РегистрацияИнформацииОКонфликтеИнтересов.ПометкаУдаления
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК ПрекращениеКонфликта
		|			ПО КонфликтыИнтересов.Ссылка = ПрекращениеКонфликта.КонфликтИнтересов
		|				И (ПрекращениеКонфликта.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение))
		|				И НЕ ПрекращениеКонфликта.ПометкаУдаления
		|		ПО _ВыявленныеОбстоятельства.Организация = КонфликтыИнтересов.Организация
		|			И _ВыявленныеОбстоятельства.СчетДоверительногоУправления = КонфликтыИнтересов.СчетДоверительногоУправления
		|			И _ВыявленныеОбстоятельства.Обстоятельство = КонфликтыИнтересов.Обстоятельство
		|			И _ВыявленныеОбстоятельства.СвязанноеЛицо = КонфликтыИнтересов.СвязанноеЛицо
		|			И _ВыявленныеОбстоятельства.ПредметКонфликта = КонфликтыИнтересов.ПредметКонфликта
		|			И _ВыявленныеОбстоятельства.ДатаВозникновения = КонфликтыИнтересов.ДатаВозникновения
		|			И (НЕ КонфликтыИнтересов.ПометкаУдаления)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ВыявленныеОбстоятельства.ДатаВозникновения,
		|	СчетДоверительногоУправления,
		|	Обстоятельство,
		|	ПредметКонфликта,
		|	КонфликтИнтересов
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВыявлениеКонфликта = КонфликтыИнтересов.Добавить();
		ЗаполнитьЗначенияСвойств(ВыявлениеКонфликта, Выборка); 
		ВыявлениеКонфликта.Создать = Не Выборка.РегистрацияИнформацииОКонфликтеИнтересовПроведен;
		
		Если Не ЗначениеЗаполнено(ВыявлениеКонфликта.КонфликтИнтересов) Тогда
			ВыявлениеКонфликта.КонфликтИнтересов = КонфликтыИнтересов.Индекс(ВыявлениеКонфликта);
		КонецЕсли;
		
		// Для однодневных добавляем сразу прекращение конфликта
		Если ЗначениеЗаполнено(Выборка.ДатаПрекращения) Тогда
		
			ПрекращениеКонфликта = КонфликтыИнтересов.Добавить();
			ЗаполнитьЗначенияСвойств(ПрекращениеКонфликта, Выборка); 
			ПрекращениеКонфликта.Создать = ПрекращениеКонфликта.Создать Или Не Выборка.РегистрацияИнформацииОПрекращенииКонфликтаПроведен;
			ПрекращениеКонфликта.ДатаПрекращения = Выборка.ДатаПрекращения; 
			ПрекращениеКонфликта.ДатаСобытия = Выборка.ДатаСобытияПрекращение;
			ПрекращениеКонфликта.РегистрацияИнформацииОКонфликтеИнтересов = Выборка.РегистрацияИнформацииОПрекращенииКонфликта;
			ПрекращениеКонфликта.ВидСобытия = Перечисления.ВидыИнформацииОКонфликтеИнтересов.Прекращение;
			ПрекращениеКонфликта.КонфликтИнтересов = ВыявлениеКонфликта.КонфликтИнтересов;
					
		КонецЕсли;
		
	КонецЦикла;		
	#КонецОбласти 

	#Область Прекращенные_конфликты_по_обстоятельству
	ПрекращенныеКонфликты = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПрекращенныеКонфликты");
	Если ПрекращенныеКонфликты <> Неопределено Тогда
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПрекращенныеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ПрекращенныеКонфликты.ПрекращениеКонфликтаИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересов,
			|	_ПрекращенныеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
			|	КонфликтыИнтересов.Обстоятельство КАК Обстоятельство,
			|	КонфликтыИнтересов.ДатаВозникновения КАК ДатаВозникновения,
			|	КонфликтыИнтересов.ПредметКонфликта КАК ПредметКонфликта,
			|	КонфликтыИнтересов.СвязанноеЛицо КАК СвязанноеЛицо,
			|	_ПрекращенныеКонфликты.ДатаПрекращения КАК ДатаСобытия,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение) КАК ВидСобытия,
			|	""Отсутствует предмет конфликта"" КАК СодержаниеКонфликтаИнтересов,
			|	_ПрекращенныеКонфликты.ПрекращениеКонфликтаИнтересовПроведен КАК Создать
			|ИЗ
			|	_ПрекращенныеКонфликты КАК _ПрекращенныеКонфликты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонфликтыИнтересов КАК КонфликтыИнтересов
			|		ПО _ПрекращенныеКонфликты.КонфликтИнтересов = КонфликтыИнтересов.Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	СчетДоверительногоУправления,
			|	Обстоятельство,
			|	ПредметКонфликта
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ПрекращениеКонфликта = КонфликтыИнтересов.Добавить();
			ЗаполнитьЗначенияСвойств(ПрекращениеКонфликта, Выборка);
			
		КонецЦикла;
	
	КонецЕсли;		
	#КонецОбласти
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, , ИменаВременныхТаблицЗапроса);

КонецПроцедуры

Процедура ОпределитьПрекращенияКонфликтов(Контекст)
	
	Запрос = Контекст.Запрос;
	ИменаВременныхТаблицЗапроса = Контекст.ИменаВременныхТаблицЗапроса;
	КонфликтыИнтересов = Контекст.КонфликтыИнтересов;
	
	#Область Исключение_лица_из_списка_связанных
	
	Обстоятельства = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов;
	МногодневныеКонфликты = Новый Массив;
	МногодневныеКонфликты.Добавить(ПолучитьОбстоятельствоПоУказанию(Обстоятельства.ЭмитентСвязанноеЛицо));
	МногодневныеКонфликты.Добавить(ПолучитьОбстоятельствоПоУказанию(Обстоятельства.ДоговорОСтабилизацииЦен));
	
	Запрос.УстановитьПараметр("МногодневныеКонфликты", МногодневныеКонфликты);
	Запрос.УстановитьПараметр("СделкаСУправляющейКомпанией", ПолучитьОбстоятельствоПоУказанию(Обстоятельства.СделкаСУправляющейКомпанией));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МИНИМУМ(_ДействующиеКонфликты.ДатаОперации) КАК ДатаОперации
		|ПОМЕСТИТЬ _ПрекращенныеКонфликты
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СвязанныеЛица КАК _СвязанныеЛица
		|		ПО _ДействующиеКонфликты.Организация = _СвязанныеЛица.Организация
		|			И (_ДействующиеКонфликты.СчетДоверительногоУправления = _СвязанныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ДействующиеКонфликты.ДатаОперации = _СвязанныеЛица.ДатаОперации
		|			И _ДействующиеКонфликты.СвязанноеЛицо = _СвязанныеЛица.СвязанноеЮрФизЛицо
		|ГДЕ
		|	_СвязанныеЛица.ДатаОперации ЕСТЬ NULL
		|	И _ДействующиеКонфликты.Обстоятельство В (&МногодневныеКонфликты)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления,
		|	МИНИМУМ(_ДействующиеКонфликты.ДатаОперации)
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СвязанныеИОтветственныеЛица КАК _СвязанныеИОтветственныеЛица
		|		ПО _ДействующиеКонфликты.Организация = _СвязанныеИОтветственныеЛица.Организация
		|			И (_ДействующиеКонфликты.СчетДоверительногоУправления = _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления
		|				ИЛИ _СвязанныеИОтветственныеЛица.СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО)
		|			И _ДействующиеКонфликты.ДатаОперации = _СвязанныеИОтветственныеЛица.ДатаОперации
		|			И _ДействующиеКонфликты.СвязанноеЛицо = _СвязанныеИОтветственныеЛица.ЮрФизЛицо
		|ГДЕ
		|	_СвязанныеИОтветственныеЛица.ДатаОперации ЕСТЬ NULL
		|	И _ДействующиеКонфликты.Обстоятельство = &СделкаСУправляющейКомпанией
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДействующиеКонфликты.КонфликтИнтересов,
		|	_ДействующиеКонфликты.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДействующиеКонфликты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДействующиеКонфликты.ПрекращениеКонфликтаИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересов,
		|	_ДействующиеКонфликты.КонфликтИнтересов КАК КонфликтИнтересов,
		|	_ДействующиеКонфликты.Обстоятельство КАК Обстоятельство,
		|	_ДействующиеКонфликты.КонфликтИнтересов.ДатаВозникновения КАК ДатаВозникновения,
		|	_ДействующиеКонфликты.ПредметКонфликта КАК ПредметКонфликта,
		|	_ДействующиеКонфликты.СвязанноеЛицо КАК СвязанноеЛицо,
		|	_ПрекращенныеКонфликты.ДатаОперации КАК ДатаПрекращения,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение) КАК ВидСобытия,
		|	""Лицо исключено из списка связанных"" КАК СодержаниеКонфликтаИнтересов,
		|	НЕ _ДействующиеКонфликты.ПрекращениеКонфликтаИнтересовПроведен КАК Создать
		|ИЗ
		|	_ДействующиеКонфликты КАК _ДействующиеКонфликты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПрекращенныеКонфликты КАК _ПрекращенныеКонфликты
		|		ПО (_ПрекращенныеКонфликты.КонфликтИнтересов = _ДействующиеКонфликты.КонфликтИнтересов)
		|			И _ДействующиеКонфликты.ДатаОперации = _ПрекращенныеКонфликты.ДатаОперации
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправления,
		|	Обстоятельство,
		|	ПредметКонфликта
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПрекращениеКонфликта = КонфликтыИнтересов.Добавить();
		ЗаполнитьЗначенияСвойств(ПрекращениеКонфликта, Выборка);
	КонецЦикла; 
	
	#КонецОбласти  
	
	#Область Прекращение_действия_договора_ДУ
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонфликтыИнтересов.Организация КАК Организация,
		|	КонфликтыИнтересов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Ссылка КАК РегистрацияИнформацииОКонфликтеИнтересов,
		|	КонфликтыИнтересов.Ссылка КАК КонфликтИнтересов,
		|	КонфликтыИнтересов.Обстоятельство КАК Обстоятельство,
		|	КонфликтыИнтересов.ДатаВозникновения КАК ДатаВозникновения,
		|	КонфликтыИнтересов.ПредметКонфликта КАК ПредметКонфликта,
		|	КонфликтыИнтересов.СвязанноеЛицо КАК СвязанноеЛицо,
		|	СчетаДоверительногоУправленияСправочник.ДатаРасторжения КАК ДатаПрекращения, 
		|	РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Дата КАК ДатаСобытия,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение) КАК ВидСобытия,
		|	""Расторжение договора доверительного управления"" КАК СодержаниеКонфликтаИнтересов,
		|	НЕ ЕСТЬNULL(РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Проведен, ЛОЖЬ) КАК Создать
		|ИЗ
		|	Справочник.КонфликтыИнтересов КАК КонфликтыИнтересов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправленияСправочник
		|		ПО КонфликтыИнтересов.Организация = СчетаДоверительногоУправленияСправочник.Организация
		|			И КонфликтыИнтересов.СчетДоверительногоУправления = СчетаДоверительногоУправленияСправочник.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересовВыявление
		|		ПО КонфликтыИнтересов.Ссылка = РегистрацияИнформацииОКонфликтеИнтересовВыявление.КонфликтИнтересов
		|			И (РегистрацияИнформацииОКонфликтеИнтересовВыявление.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Выявление))
		|			И (РегистрацияИнформацииОКонфликтеИнтересовВыявление.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияИнформацииОКонфликтеИнтересов КАК РегистрацияИнформацииОКонфликтеИнтересовПрекращение
		|		ПО КонфликтыИнтересов.Ссылка = РегистрацияИнформацииОКонфликтеИнтересовПрекращение.КонфликтИнтересов
		|			И (РегистрацияИнформацииОКонфликтеИнтересовПрекращение.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыИнформацииОКонфликтеИнтересов.Прекращение))
		|			И (НЕ РегистрацияИнформацииОКонфликтеИнтересовПрекращение.ПометкаУдаления)
		|ГДЕ
		|	КонфликтыИнтересов.Обстоятельство В ИЕРАРХИИ(&ГруппаОбстоятельств)
		|	И НЕ КонфликтыИнтересов.ПометкаУдаления
		|	И СчетаДоверительногоУправленияСправочник.ДатаРасторжения <= &ДатаОкончания
		|	И СчетаДоверительногоУправленияСправочник.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЕСТЬNULL(РегистрацияИнформацииОКонфликтеИнтересовПрекращение.Проведен, ЛОЖЬ)";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПрекращениеКонфликта = КонфликтыИнтересов.Добавить();
		ЗаполнитьЗначенияСвойств(ПрекращениеКонфликта, Выборка);
	КонецЦикла;
		
	#КонецОбласти
	
КонецПроцедуры

Процедура ЗаполнитьУсловияОтбора(Запрос, Обстоятельство, НастройкиОтбораОбстоятельств)

	ТаблицаНастроек = НастройкиОтбораОбстоятельств.НайтиСтроки(Новый Структура("Обстоятельство", Обстоятельство));
	
	Если ТаблицаНастроек.Количество() = 1 Тогда
		
		Настройки = ТаблицаНастроек[0];
		
		ТипыДокументовДС = Новый Массив;
		ОстальныеТипыДокументов = Новый Массив;
		
		ОтборПоРеквизитамСделки = "";
		Если Настройки.Сделка И (Настройки.МестоХранения <> "Любое" Или Настройки.РежимПереговорныхСделок <> "Любой") Тогда
		
			ОтборПоРеквизитамСделки = "
				|			(_ВсеОперации.ТипОперации = Тип(Документ.Сделка) И _ВсеОперации.ВидОперации <> ""РасчетныйСчет""
				|				И (_ВсеОперации.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
				|					ИЛИ _ВсеОперации.РежимПереговорныхСделок))";
		
		КонецЕсли; 
		
		ОтборПоРеквизитамСделки = "";
		Если Настройки.СделкаРЕПО И (Настройки.МестоХранения <> "Любое" Или Настройки.СделкаСЦентральнымКонтрагентом <> "Любой") Тогда
		
			ОтборПоРеквизитамСделкиРЕПО = "
				|			(_ВсеОперации.ТипОперации = Тип(Документ.СделкаРЕПО) И _ВсеОперации.ВидОперации <> ""РасчетныйСчет""
				|				И (_ВсеОперации.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
				|					ИЛИ НЕ _ВсеОперации.СделкаСЦентральнымКонтрагентом))";
		
		КонецЕсли; 
		
		Для каждого Колонка Из ТаблицаНастроек[0].Владелец().Колонки Цикл
		
			Если СтрНачинаетсяС(Колонка.Имя, "ДС_") Тогда
			
				Если Настройки[Колонка.Имя] Тогда
				
					ТипыДокументовДС.Добавить(Тип("ДокументСсылка." + Сред(Колонка.Имя, 4)));
				
				КонецЕсли; 				
				
			ИначеЕсли ТипЗнч(Настройки[Колонка.Имя]) = Тип("Булево") Тогда
				
				Если (Колонка.Имя = "Сделка" И ЗначениеЗаполнено(ОтборПоРеквизитамСделки))
					Или (Колонка.Имя = "СделкаРЕПО" И ЗначениеЗаполнено(ОтборПоРеквизитамСделкиРЕПО)) Тогда
					Продолжить;
				КонецЕсли; 
				
				Если Настройки[Колонка.Имя] Тогда
					ОстальныеТипыДокументов.Добавить(Тип("ДокументСсылка." + Колонка.Имя));
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		МассивУсловий = Новый Массив;
		
		Если ТипыДокументовДС.Количество() > 0 Тогда
			
			УсловияПоДС = "(_ВсеОперации.ВидОперации = ""РасчетныйСчет"" И _ВсеОперации.ТипОперации В (&ТипыДокументовДС))";
			Запрос.УстановитьПараметр("ТипыДокументовДС", ТипыДокументовДС);
			
		Иначе
			
			УсловияПоДС = "ЛОЖЬ";
		
		КонецЕсли;
		
		Если ОстальныеТипыДокументов.Количество() > 0 Тогда
			
			УсловияПоДокументам = "(_ВсеОперации.ВидОперации <> ""РасчетныйСчет"" И _ВсеОперации.ТипОперации В (&ОстальныеТипыДокументов))";
			Запрос.УстановитьПараметр("ОстальныеТипыДокументов", ОстальныеТипыДокументов);
			
		Иначе
			
			УсловияПоДокументам = "ЛОЖЬ";
		
		КонецЕсли;
		
		МассивУсловий.Добавить(УсловияПоДС);
		МассивУсловий.Добавить(УсловияПоДокументам);
		
		Если ЗначениеЗаполнено(ОтборПоРеквизитамСделки) Тогда
		
			МассивУсловий.Добавить(ОтборПоРеквизитамСделки);
		
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ОтборПоРеквизитамСделкиРЕПО) Тогда
		
			МассивУсловий.Добавить(ОтборПоРеквизитамСделкиРЕПО);
		
		КонецЕсли; 
		
		УсловияОтбора = СтрСоединить(МассивУсловий, Символы.ПС + " ИЛИ " + Символы.ПС);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", УсловияОтбора);		
	
	КонецЕсли; 
	
КонецПроцедуры

Процедура ДобавитьКолонкуТаблицыСведений(ТаблицаСведений, Имя, Тип)

	Если ТаблицаСведений.Колонки.Найти(Имя) = Неопределено Тогда
		ТаблицаСведений.Колонки.Добавить(Имя, Тип);
	КонецЕсли; 

КонецПроцедуры

Процедура ДобавитьСтрокиВТаблицуСведений(Запрос, ИмяВременнойТаблицы, ТаблицаСведений)

	ДанныеВременнойТаблицы = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы).ПолучитьДанные();
	Для каждого Колонка Из ДанныеВременнойТаблицы.Колонки Цикл
		ДобавитьКолонкуТаблицыСведений(ТаблицаСведений, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла; 
	Выборка = ДанныеВременнойТаблицы.Выбрать();
	Пока Выборка.Следующий() Цикл
		// удалить новый код, оставить старый?
		//ЗаполнитьЗначенияСвойств(ТаблицаСведений.Добавить(), Выборка);
		НоваяСтрока = ТаблицаСведений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ТипОперации = ТипЗнч(НоваяСтрока.Операция);
		
		Если ТипОперации = Тип("ДокументСсылка.Оплата") Тогда
			
			Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Операция, "Ссылка, ВидДвижения, ВидЗадолженности, Аванс"); 
			
			Если Данные.ВидДвижения = Перечисления.ВидыДвижений.Приход И ЭтоОплатаНаОснованииОплаты(Данные.Ссылка) Тогда
				ТипОперации = "Возврат аванса " + НРег(Данные.ВидЗадолженности);
			Иначе
				ТипОперации = ?(Данные.Аванс, "Аванс ", "Оплата ") + НРег(Данные.ВидЗадолженности);
			КонецЕсли;			
		
		КонецЕсли; 
		
		НоваяСтрока.ТипОперации = ?(ТипОперации = Тип("Строка"), "", ТипОперации);
		
	КонецЦикла; 

КонецПроцедуры

Функция ЭтоОплатаНаОснованииОплаты(Оплата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Основание КАК Основание
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И ОплатаОснования.НомерСтроки = 1
		|	И ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.Оплата)";
	
	Запрос.УстановитьПараметр("Ссылка", Оплата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПолучитьОбстоятельствоПоУказанию(Обстоятельство)
	
	ОбстоятельстваМенеджер = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов;
	
	Если ЭтотОбъект.ГруппаОбстоятельств = ОбстоятельстваМенеджер.УказаниеБанкаРоссии5511У Тогда
	
		Возврат Обстоятельство;
		
	ИначеЕсли ЭтотОбъект.ГруппаОбстоятельств = ОбстоятельстваМенеджер.УказаниеБанкаРоссии6883У Тогда
		
		Если Обстоятельство = ОбстоятельстваМенеджер.ЭмитентСвязанноеЛицо Тогда
			Возврат ОбстоятельстваМенеджер.ЭмитентСвязанноеЛицо_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.АктивыПереданныеВПользование Тогда
			Возврат Неопределено;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.ЦенныеБумагиНаРазмещении Тогда
			Возврат ОбстоятельстваМенеджер.ЦенныеБумагиНаРазмещении_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.ДоговорОСтабилизацииЦен Тогда
			Возврат ОбстоятельстваМенеджер.ДоговорОСтабилизацииЦен_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.НеНаилучшиеУсловияСделок Тогда
			Возврат Неопределено;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.СделкаСУправляющейКомпанией Тогда
			Возврат ОбстоятельстваМенеджер.СделкаСоСвязаннымЛицом_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.ИспользованиеИнформации Тогда
			Возврат ОбстоятельстваМенеджер.ИспользованиеИнформации_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.ЧастотаСделок Тогда
			Возврат ОбстоятельстваМенеджер.ЧастотаСделок_6883;
		ИначеЕсли Обстоятельство = ОбстоятельстваМенеджер.ДоговорыСТретьимиЛицами Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

#КонецОбласти

