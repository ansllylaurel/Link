// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Выявление конфликтов интересов (5511-У)",
		"2.14",
		"",
		Истина
	);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(
		Команды, 
		"ОповещениеОРасходныхОперациях", 
		"Оповещение о расходных операциях",
		Неопределено, 
		Ложь, 
		"ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(
		Команды, 
		"ВыявлениеКонфликтов_6883", 
		"Выявление конфликтов клиентов 6883",
		Неопределено, 
		Ложь, 
		"ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыКоманды, "", ПараметрыКоманды);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Календари = Справочники.Календари;
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	ЭтоРабочийДень = Календари.ЭтоРабочийДень(Календари.Общероссийский, ТекущаяДата);
		
	Если ИдентификаторКоманды = "ОповещениеОРасходныхОперациях" Тогда
		
		Если ЭтоРабочийДень Тогда
		
			ОповещениеОРасходныхОперациях(ПараметрыКоманды, ТекущаяДата);
		
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ВыявлениеКонфликтов_6883" Тогда	
		
		Если ЭтоРабочийДень Тогда
		
			ВыявлениеКонфликтов_6883(ПараметрыКоманды, ТекущаяДата);
		
		КонецЕсли;
		
	КонецЕсли;   
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	ЭтотОбъект.Период.ДатаНачала = НастройкиОтчета.Период.ДатаНачала;
	ЭтотОбъект.Период.ДатаОкончания = НастройкиОтчета.Период.ДатаОкончания;
	
	Календари = Справочники.Календари;
	ЭтоРабочийДень = Календари.ЭтоРабочийДень(Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала);
	
	Если ЭтоРабочийДень Тогда
		ДатаОкончанияПроверки = ЭтотОбъект.Период.ДатаНачала - 1;
	Иначе
		ДатаОкончанияПроверки = Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала, 1)-1;
	КонецЕсли;
	
	ДатаНачалаПроверки = Календари.ПолучитьБлижайшуюРабочуюДату(Календари.Общероссийский, ДатаОкончанияПроверки);
		
	ЭтотОбъект.ГруппаОбстоятельств = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У;
	
	Если ПроверитьВыполнениеПоискаКонфликтовИнтересов(НастройкиОтчета.СчетДоверительногоУправления, ДатаНачалаПроверки, ДатаОкончанияПроверки) Тогда
		
		Результат = СформироватьЖурналКИ(НастройкиОтчета.СчетДоверительногоУправления, Ложь);
		НастройкиОтчета.Вставить("Результат", Результат.ДокументРезультат);
		
		Если Результат.НеОбрабатыватьПакет Тогда
			НастройкиОтчета.Вставить("НеОбрабатыватьПакет");
		КонецЕсли;
		
	Иначе
		НастройкиОтчета.Вставить("Отказ");
		НастройкиОтчета.Вставить("ИмяОповещенияОбОтказе", "ВнешняяОбработка._ФормированиеОтчетности.ВыявлениеКонфликтаИнтересов");	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКонликтыИнтересов(НастройкиОтбораОбстоятельств, АдресТаблицыСведений = Неопределено, СчетаДоверительногоУправления = Неопределено) Экспорт

	НастройкиОтбораОбстоятельств = ЗаполнитьНастройкиПоУмолчанию();
	
	ЭтоУказание6883 = ЭтотОбъект.ГруппаОбстоятельств = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("ЭтоУказание6883", ЭтоУказание6883);
	Запрос.УстановитьПараметр("ЭтоОрганизацияРПИ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") = ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КалендарьКотировок", Константы.ОсновнойКалендарьКотировок.Получить());
	
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаОкончанияНачалоДня", НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("АнализОстатковНаНачалоПериода", ЭтотОбъект.АнализОстатковНаНачалоПериода);
	Запрос.УстановитьПараметр("ГруппаОбстоятельств", ЭтотОбъект.ГруппаОбстоятельств);
	
	ЗаполнитьТаблицуСчетовДУ(Запрос);
	ЗаполнитьТаблицыОперацийПоОстаткам(Запрос);
	ЗаполнитьТаблицыОпераций(Запрос);	
	
	Если ЭтоУказание6883 Тогда
		ЗаполнитьТаблицуСвязанныхЛицКлиента(Запрос);
	Иначе
		ЗаполнитьТаблицуСвязанныхЛиц(Запрос);	
	КонецЕсли;
	
	ЗаполнитьДействующиеКонфликты(Запрос);
	
	ИменаВременныхТаблицЗапроса = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(Запрос.МенеджерВременныхТаблиц);
	
	КонфликтыИнтересов = Справочники.КонфликтыИнтересов.ПолучитьТаблицуДанныеКонфликтов();
	КонфликтыИнтересов.Колонки.Добавить("Создать", Новый ОписаниеТипов("Булево"));
		
	Контекст = Новый Структура;
	Контекст.Вставить("Запрос", Запрос);
	Контекст.Вставить("ИменаВременныхТаблицЗапроса", ИменаВременныхТаблицЗапроса);
	Контекст.Вставить("КонфликтыИнтересов", КонфликтыИнтересов);
	Контекст.Вставить("НастройкиОтбораОбстоятельств", НастройкиОтбораОбстоятельств);
	
	Если ЭтоАдресВременногоХранилища(АдресТаблицыСведений) Тогда
	
		ТаблицаСведений = ПолучитьИзВременногоХранилища(АдресТаблицыСведений);
		ТаблицаСведений.Очистить();
		Контекст.Вставить("ТаблицаСведений", ТаблицаСведений);
	
	КонецЕсли;
	
	АнализОбстоятельстваЭмитентСвязанноеЛицо(Контекст); // Обстоятельство 1	
	// Обстоятельство 2 (Переданные в пользование активы) не контролируем
	АнализОбстоятельстваЦенныеБумагиНаРазмещении(Контекст); // Обстоятельство 3
	АнализОбстоятельстваДоговорОСтабилизацииЦен(Контекст); // Обстоятельство 4
	// Обстоятельство 5 (Наилучшие условия) не контролируем
	АнализОбстоятельстваСделкаСУправляющейКомпаниейДоговоры(Контекст); // Обстоятельство 6
	АнализОбстоятельстваСделкаСУправляющейКомпанией(Контекст); // Обстоятельство 6
	Если ЭтоУказание6883 Тогда
		АнализОбстоятельстваИспользованиеИнформации(Контекст); // Обстоятельство 7
	КонецЕсли;
	АнализОбстоятельстваЧастотаСделок(Контекст); // Обстоятельство 8
	// Обстоятельство 9 (Договоры с третьими лицами) не контролируем
	
	ОпределитьПрекращенияКонфликтов(Контекст);
	
	Если ЭтоАдресВременногоХранилища(АдресТаблицыСведений) Тогда
		ПоместитьВоВременноеХранилище(ТаблицаСведений, АдресТаблицыСведений);
	КонецЕсли;	
	
	КонфликтыИнтересов.ЗаполнитьЗначения(ЭтотОбъект.Организация, "Организация");
	
	ПараметрыКИ = Справочники.КонфликтыИнтересов.ПодобратьПараметрыКонфликтовИнтересов(КонфликтыИнтересов);
	РеквизитыКИ = Справочники.КонфликтыИнтересов.ПолучитьРеквизитыКонфликтовИнтересов(КонфликтыИнтересов);
	
	Для каждого СтрокаКонфликтыИнтересов Из КонфликтыИнтересов Цикл
		
		Отбор = Новый Структура("КонфликтИнтересов", СтрокаКонфликтыИнтересов.КонфликтИнтересов);
		НайденныеСтроки = ПараметрыКИ.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаКонфликтыИнтересов, НайденныеСтроки[0]);
		КонецЕсли;
		
		НайденныеСтроки = РеквизитыКИ.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 1 Тогда
		
			Если ЗначениеЗаполнено(СтрокаКонфликтыИнтересов.СодержаниеКонфликтаИнтересов) Тогда
			
				//СтрокаКонфликтыИнтересов.СодержаниеКонфликтаИнтересов = СтрокаКонфликтыИнтересов.СодержаниеКонфликтаИнтересов + " "
				//	+ НайденныеСтроки[0].СодержаниеКонфликтаИнтересов;
				СтрокаКонфликтыИнтересов.СведенияОКлиенте = НайденныеСтроки[0].СведенияОКлиенте;
				
			Иначе
				ЗаполнитьЗначенияСвойств(СтрокаКонфликтыИнтересов, НайденныеСтроки[0]);
			КонецЕсли;
            
		КонецЕсли;
	
	КонецЦикла;
	
	КонфликтыИнтересов.Колонки.Добавить("КонфликтИнтересовСсылка", Новый ОписаниеТипов("СправочникСсылка.КонфликтыИнтересов"));
	КонфликтыИнтересов.ЗагрузитьКолонку(КонфликтыИнтересов.ВыгрузитьКолонку("КонфликтИнтересов"), "КонфликтИнтересовСсылка");
	
	Возврат КонфликтыИнтересов;

КонецФункции

Функция ЗаполнитьНастройкиПоУмолчанию() Экспорт

	НастройкиОтбораОбстоятельств = Новый ТаблицаЗначений;
	НастройкиОтбораОбстоятельств.Колонки.Добавить("ВводЦенныхБумаг", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("ВводКредитногоИнструмента", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("ВыводЦенныхБумаг", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("МНО", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("РазмещениеКредитногоИнструмента", Новый ОписаниеТипов("Булево"));
	
	НастройкиОтбораОбстоятельств.Колонки.Добавить("МестоХранения", Новый ОписаниеТипов("Строка"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("Сделка", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("РежимПереговорныхСделок", Новый ОписаниеТипов("Строка"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("СделкаРЕПО", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("СделкаСЦентральнымКонтрагентом", Новый ОписаниеТипов("Строка"));
	
	НастройкиОтбораОбстоятельств.Колонки.Добавить("СделкаСВалютой", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("СделкаСМО", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("СделкаСПФИ", Новый ОписаниеТипов("Булево"));
	НастройкиОтбораОбстоятельств.Колонки.Добавить("Обстоятельство", Новый ОписаниеТипов("СправочникСсылка.ОбстоятельстваВозникновенияКонфликтаИнтересов"));
	
	ТипыРегистраторов = Метаданные.РегистрыНакопления.ОстаткиДенежныхСредств.СтандартныеРеквизиты.Регистратор.Тип.Типы();
	
	Для каждого ТипРегистратора Из ТипыРегистраторов Цикл
		
		ДокументМД = Метаданные.НайтиПоТипу(ТипРегистратора);
		НастройкиОтбораОбстоятельств.Колонки.Добавить("ДС_" + ДокументМД.Имя, Новый ОписаниеТипов("Булево"));
		
	КонецЦикла; 
	
	#Область Эмитент_связанное_лицо
	
	НоваяСтрока = НастройкиОтбораОбстоятельств.Добавить();
	
	НоваяСтрока.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЭмитентСвязанноеЛицо;
	
	НоваяСтрока.ВводЦенныхБумаг = Истина;
	НоваяСтрока.ВыводЦенныхБумаг = Истина;
	НоваяСтрока.Сделка = Истина;
	НоваяСтрока.РежимПереговорныхСделок = "Любой";
	НоваяСтрока.МестоХранения = "Любое";
	НоваяСтрока.СделкаРЕПО = Истина;
	НоваяСтрока.СделкаСЦентральнымКонтрагентом = "Любой";
	НоваяСтрока.ВводКредитногоИнструмента = Истина;
	НоваяСтрока.РазмещениеКредитногоИнструмента = Истина;
	НоваяСтрока.МНО = Истина;
	НоваяСтрока.СделкаСМО = Истина;
		
	Для каждого Колонка Из НастройкиОтбораОбстоятельств.Колонки Цикл
	
		Если СтрНачинаетсяС(Колонка.Имя, "ДС_") Тогда
			НоваяСтрока[Колонка.Имя] = Истина;
		КонецЕсли; 
	
	КонецЦикла;	
	
	#КонецОбласти  
	
	#Область Ценные_бумаги_на_размещении
	
	НоваяСтрока = НастройкиОтбораОбстоятельств.Добавить();
	
	НоваяСтрока.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЦенныеБумагиНаРазмещении;
	
	НоваяСтрока.Сделка = Истина;
	НоваяСтрока.РежимПереговорныхСделок = "Любой";
	НоваяСтрока.МестоХранения = "Любое";
	
	#КонецОбласти
	
	#Область Договор_о_стабилизации_цен
	
	НоваяСтрока = НастройкиОтбораОбстоятельств.Добавить();
	
	НоваяСтрока.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорОСтабилизацииЦен;
	
	НоваяСтрока.Сделка = Истина;
	НоваяСтрока.РежимПереговорныхСделок = "Любой";
	НоваяСтрока.МестоХранения = "Любое";
	НоваяСтрока.СделкаРЕПО = Истина;
	НоваяСтрока.СделкаСЦентральнымКонтрагентом = "Любой";
	
	#КонецОбласти 
	
	#Область Сделка_с_управляющей_компанией
	
	НоваяСтрока = НастройкиОтбораОбстоятельств.Добавить();
	
	НоваяСтрока.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСУправляющейКомпанией;
	
	//НоваяСтрока.ВводЦенныхБумаг = Истина;
	//НоваяСтрока.ВыводЦенныхБумаг = Истина;
	НоваяСтрока.Сделка = Истина;
	НоваяСтрока.РежимПереговорныхСделок = "Истина";
	НоваяСтрока.МестоХранения = "ВнебиржевойРынок";
	НоваяСтрока.СделкаРЕПО = Истина;
	НоваяСтрока.СделкаСЦентральнымКонтрагентом = "Ложь";
	НоваяСтрока.ВводКредитногоИнструмента = Истина;
	НоваяСтрока.РазмещениеКредитногоИнструмента = Истина;
	НоваяСтрока.МНО = Истина;
	НоваяСтрока.СделкаСМО = Истина;
	НоваяСтрока.СделкаСПФИ = Истина;
	//НоваяСтрока.СделкаСВалютой = Истина;
	
	Для каждого Колонка Из НастройкиОтбораОбстоятельств.Колонки Цикл
	
		Если СтрНачинаетсяС(Колонка.Имя, "ДС_") Тогда
			НоваяСтрока[Колонка.Имя] = Истина
		КонецЕсли; 
	
	КонецЦикла;
	
	#КонецОбласти 
	
	#Область Частота_сделок
	
	НоваяСтрока = НастройкиОтбораОбстоятельств.Добавить();
	
	НоваяСтрока.Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЧастотаСделок;
	
	НоваяСтрока.Сделка = Истина;
	НоваяСтрока.РежимПереговорныхСделок = "Любой";
	НоваяСтрока.МестоХранения = "Любое";
	НоваяСтрока.СделкаРЕПО = Истина;
	НоваяСтрока.СделкаСЦентральнымКонтрагентом = "Любой";
		
	#КонецОбласти
	
	Возврат НастройкиОтбораОбстоятельств;

КонецФункции

Процедура ОповещениеОРасходныхОперациях(ПараметрыКоманды, НачалоДня)

	Календари = Справочники.Календари;
	
	ДатаОкончания = НачалоДня - 1;
	ДатаНачала = Календари.ПолучитьБлижайшуюРабочуюДату(Календари.Общероссийский, ДатаОкончания);
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.Организация КАК Организация,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
		|	ОперацииСЦеннымиБумагами.Количество КАК Количество,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) КАК Остаток
		|ПОМЕСТИТЬ _ДанныеОтчета
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|				&ПериодОстатков,
		|				Организация = &Организация
		|					И ЦеннаяБумага В (&ЦеннаяБумага)) КАК ОстаткиЦенныхБумагОстатки
		|		ПО ОперацииСЦеннымиБумагами.Организация = ОстаткиЦенныхБумагОстатки.Организация
		|			И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления
		|			И ОперацииСЦеннымиБумагами.Рынок = ОстаткиЦенныхБумагОстатки.Рынок
		|			И ОперацииСЦеннымиБумагами.ЦеннаяБумага = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.ЦеннаяБумага В(&ЦеннаяБумага)
		|	И ОперацииСЦеннымиБумагами.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) <> ТИП(Документ.НачислениеСписаниеРезервов)
		|	И ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.Регистратор) <> ТИП(Документ.ПогашениеКупона)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|			ТОГДА ""ДУ""
		|		КОГДА ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)
		|			ТОГДА ""УК""
		|	КОНЕЦ КАК ВидЛицензии
		|ПОМЕСТИТЬ _Лицензии
		|ИЗ
		|	РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(
		|			&ДатаОкончания,
		|			(Организация, СчетДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					_ДанныеОтчета.Организация,
		|					_ДанныеОтчета.СчетДоверительногоУправления
		|				ИЗ
		|					_ДанныеОтчета КАК _ДанныеОтчета)) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует
		|	И ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности В (ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами), ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОтчета.Организация КАК Организация,
		|	_ДанныеОтчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеОтчета.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеОтчета.Регистратор КАК Регистратор,
		|	_ДанныеОтчета.Количество КАК Количество,
		|	_ДанныеОтчета.Остаток КАК Остаток,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Учредитель,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Векселя).Эмитент
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
		|		КОГДА _ДанныеОтчета.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|	КОНЕЦ КАК РегНомер
		|ИЗ
		|	_ДанныеОтчета КАК _ДанныеОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеОтчета.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеОтчета.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО _ДанныеОтчета.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(_ДанныеОтчета.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ИТОГИ
		|	МИНИМУМ(Остаток),
		|	МИНИМУМ(Учредитель),
		|	МИНИМУМ(НомерДоговора),
		|	МИНИМУМ(ДатаДоговора)
		|ПО
		|	ЦеннаяБумага,
		|	СчетДоверительногоУправления";			
	#КонецОбласти
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПериодОстатков", Новый Граница(ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ПараметрыКоманды.Организация);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ПолучитьЦенныеБумагиПоISIN(ПараметрыКоманды.СписокISIN));
	
	Результат = Запрос.Выполнить();
	
	Лицензии = ПолучитьЛицензииПоСчетамДУ(Запрос);
		
	ВыборкаЦБ = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЭлементыОтчета = Новый Массив;
	
	Пока ВыборкаЦБ.Следующий() Цикл

		ЭлементыОтчета.Добавить(ВыборкаЦБ.ЦеннаяБумага);
		
		ВыборкаСчетДУ = ВыборкаЦБ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетДУ.Следующий() Цикл
		
			ПредставлениеСчетаДУ = СтрШаблон("%1, %2, Договор ДУ №%3 от %4, лицензия %5",
				ВыборкаСчетДУ.СчетДоверительногоУправления,
				ВыборкаСчетДУ.Учредитель,
				ВыборкаСчетДУ.НомерДоговора,
				Формат(ВыборкаСчетДУ.ДатаДоговора, "ДФ=dd.MM.yyyy"),
				Лицензии[ВыборкаСчетДУ.СчетДоверительногоУправления]);
			ЭлементыОтчета.Добавить(Символы.Таб + ПредставлениеСчетаДУ);
			
			Выборка = ВыборкаСчетДУ.Выбрать();
			
			Операции = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
			
				ПредставлениеОперации = СтрШаблон("%1, количество %2",
					Выборка.Регистратор, 
					Выборка.Количество);
				Операции.Добавить(ПредставлениеОперации);
			
			КонецЦикла;
			
			ЭлементыОтчета.Добавить(Символы.Таб + Символы.Таб + СтрСоединить(Операции, Символы.ПС + Символы.Таб + Символы.Таб));
			ЭлементыОтчета.Добавить(Символы.Таб + "Остаток на конец дня: " + ВыборкаСчетДУ.Остаток);
		
		КонецЦикла;
	
	КонецЦикла;
	
	Если ЭлементыОтчета.Количество() > 0 Тогда
		
		ЭлементыОтчета.Добавить(Символы.ПС + "Проверьте необходимость формирования Уведомления о прекращении КИ");
		
		ПараметрыОповещения = Новый Структура("Организация, Текст", 
			ПараметрыКоманды.Организация,
			СтрСоединить(ЭлементыОтчета, Символы.ПС));
			
		ПолноеИмяИсточника = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + "ОповещениеОРасходныхОперациях";
	    Справочники.Оповещения.СформироватьОповещения(ПолноеИмяИсточника, Перечисления.ТипыСобытий.ВнешнийВызов, ПараметрыОповещения);			
	
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСчетаДУПоКодам(КодыСчетовДоверительногоУправления)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
