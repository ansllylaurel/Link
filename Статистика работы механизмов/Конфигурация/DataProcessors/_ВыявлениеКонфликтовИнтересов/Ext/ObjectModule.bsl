Процедура СоздатьОбъектыКИ(КонфликтыИнтересов, ВыявлениеКонфликтовВТекущейДате = Истина) Экспорт

	Для Каждого Строка Из КонфликтыИнтересов Цикл
	
		Если Строка.Создать Тогда
		
			Если ТипЗнч(Строка.КонфликтИнтересов) = Тип("Число") Тогда
				
				КонфликтИнтересов = Справочники.КонфликтыИнтересов.СоздатьЭлемент();
				КонфликтИнтересов.Заполнить(Неопределено);
				
			ИначеЕсли ЗначениеЗаполнено(Строка.КонфликтИнтересов) Тогда
				
				КонфликтИнтересов = Строка.КонфликтИнтересов.ПолучитьОбъект();
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(КонфликтИнтересов, Строка);
			КонфликтИнтересов.Наименование = СтрШаблон("%1 %2 от %3",
				КонфликтИнтересов.Обстоятельство,
				КонфликтИнтересов.СчетДоверительногоУправления,
				Формат(КонфликтИнтересов.ДатаВозникновения, "ДФ=dd.MM.yyyy"));;
			КонфликтИнтересов.Записать();
			
			Если ТипЗнч(Строка.КонфликтИнтересов) = Тип("Число") Тогда
				
				СтрокиКИ = КонфликтыИнтересов.НайтиСтроки(Новый Структура("КонфликтИнтересов", Строка.КонфликтИнтересов));
				Для каждого СтрокаТекКИ Из СтрокиКИ Цикл
					СтрокаТекКИ.КонфликтИнтересов = КонфликтИнтересов.Ссылка;
					СтрокаТекКИ.КонфликтИнтересовСсылка = КонфликтИнтересов.Ссылка;
				КонецЦикла;
				
			КонецЕсли;
			
			Если ВыявлениеКонфликтовВТекущейДате Тогда
				ДатаВыявления = ТекущаяДатаСеанса();
			Иначе
				КоличествоДней = ?(Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, Строка.ДатаВозникновения), 2, 1);
				ДатаВыявления = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Строка.ДатаВозникновения, КоличествоДней);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.РегистрацияИнформацииОКонфликтеИнтересов) Тогда
				Документ = Строка.РегистрацияИнформацииОКонфликтеИнтересов.ПолучитьОбъект();
			Иначе
				Документ = Документы.РегистрацияИнформацииОКонфликтеИнтересов.СоздатьДокумент();
				Документ.Заполнить(Неопределено);
				Документ.Дата = ДатаВыявления;
			КонецЕсли;
			
			Реквизиты = "Организация, СчетДоверительногоУправления, КонфликтИнтересов, СведенияОКлиенте, СодержаниеКонфликтаИнтересов, ВидСобытия";
			ЗаполнитьЗначенияСвойств(Документ, Строка, Реквизиты);
						
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			
			Если Не ЗначениеЗаполнено(Строка.РегистрацияИнформацииОКонфликтеИнтересов) Тогда
				Строка.РегистрацияИнформацииОКонфликтеИнтересов = Документ.Ссылка;
			КонецЕсли;
			
		КонецЕсли; 
	
	КонецЦикла;

КонецПроцедуры

Функция СформироватьЖурналКИ(СчетДоверительногоУправления = Неопределено, ВключитьДействующиеКИ) Экспорт
	
	Если ЭтотОбъект.ГруппаОбстоятельств = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии6883У Тогда
		Возврат СформироватьЖурнал6883У(СчетДоверительногоУправления, ВключитьДействующиеКИ);
	ИначеЕсли ЭтотОбъект.ГруппаОбстоятельств = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии5511У Тогда
		Возврат СформироватьЖурнал5511У();
	КонецЕсли;
	
