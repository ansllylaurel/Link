Процедура ЗафиксироватьРезультатСверки(НастройкиОтчетов)
	
	СчетаДоверительногоУправления = НастройкиОтчетов.Скопировать(, "Субъект, ДатаНачала");
	СчетаДоверительногоУправления.Колонки.Найти("Субъект").Имя = "СчетДоверительногоУправления";
	СчетаДоверительногоУправления.Колонки.Найти("ДатаНачала").Имя = "НачалоПериодаДействия";
	СчетаДоверительногоУправления.Колонки.Добавить("КонецПериодаДействия", Новый ОписаниеТипов("Дата"));
	СчетаДоверительногоУправления.ЗаполнитьЗначения(ЭтотОбъект.Период.ДатаНачала, "НачалоПериодаДействия");
	СчетаДоверительногоУправления.ЗаполнитьЗначения(ЭтотОбъект.Период.ДатаОкончания, "КонецПериодаДействия");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
