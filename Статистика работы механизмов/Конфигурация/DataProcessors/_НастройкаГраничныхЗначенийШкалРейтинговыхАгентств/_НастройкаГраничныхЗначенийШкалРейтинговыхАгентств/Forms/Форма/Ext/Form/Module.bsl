&НаКлиенте
Процедура СопоставленияРШПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СопоставленияРШ.ТекущиеДанные;

	если ЗначениеЗаполнено(ТекущиеДанные.ЗначениеМинимальное) тогда
		если не ЗначениеЗаполнено(ТекущиеДанные.ЗначениеМаксимальное) тогда
			  ТекущиеДанные.ЗначениеМаксимальное =    ТекущиеДанные.ЗначениеМинимальное;
		конецесли;
		если   ТекущиеДанные.Выбор = ложь тогда
			      ТекущиеДанные.Выбор = Истина;      			   
				  ТекущиеДанные.Активно = Истина;
			
			конецесли
	конецесли
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Период = ТекущаяДата();
	
	Объект.Источник				= Справочники.ВнешниеСистемы.ПереченьЦБ_РФДляРезидентов;
	Объект.СтрокаСопоставления	= 1;
	
	ЗаполнитьТаблицу(Объект.Период, Объект.Источник, Объект.СтрокаСопоставления);
	
КонецПроцедуры
	

Процедура ЗаполнитьТаблицу(Период, Источникъ, СтрокаСопоставления)
	             	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	ЭтаФорма.Объект.СопоставленияРШ.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ШкалыРейтинговыхАгентств.ТипШкалы КАК ТипШкалы,
		|	ШкалыРейтинговыхАгентств.ВидРейтинга КАК ВидРейтинга,
		|	ШкалыРейтинговыхАгентств.Срок КАК Срок,
		|	ШкалыРейтинговыхАгентств.Агрегатор КАК Агрегатор,
		|	ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.Активно, ЛОЖЬ) КАК Активно,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное,
		|	ЛОЖЬ КАК Выбрано,
		|	ШкалыРейтинговыхАгентств.Владелец КАК Владелец,
		|	МАКСИМУМ(ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.ШкалаРейтингаЭталонная, ШкалыРейтинговыхАгентств.Ссылка)) КАК ШкалаРейтингаЭталонная
		|ИЗ
		|	Справочник.ШкалыРейтинговыхАгентств КАК ШкалыРейтинговыхАгентств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СопоставлениеРейтинговыхШкал.СрезПоследних(
		|				&Период,
		|				Источник = &Источник
		|					И СтрокаСопоставления = &СтрокаСопоставления) КАК СопоставлениеРейтинговыхШкалСрезПоследних
		|		ПО (СопоставлениеРейтинговыхШкалСрезПоследних.ТипШкалы = ШкалыРейтинговыхАгентств.ТипШкалы)
		|			И (СопоставлениеРейтинговыхШкалСрезПоследних.Срок = ШкалыРейтинговыхАгентств.Срок)
		|			И (СопоставлениеРейтинговыхШкалСрезПоследних.РейтинговоеАгенство = ШкалыРейтинговыхАгентств.Владелец)
		|			И (СопоставлениеРейтинговыхШкалСрезПоследних.Агрегатор = ШкалыРейтинговыхАгентств.Агрегатор)
		|			И (СопоставлениеРейтинговыхШкалСрезПоследних.СтрокаСопоставления = &СтрокаСопоставления)
		|			И (СопоставлениеРейтинговыхШкалСрезПоследних.Источник = &Источник)
		|			И ШкалыРейтинговыхАгентств.ВидРейтинга = СопоставлениеРейтинговыхШкалСрезПоследних.ВидРейтинга
		|ГДЕ
		|	(ШкалыРейтинговыхАгентств.ТипШкалы <> ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.Национальная)
		|			ИЛИ ШкалыРейтинговыхАгентств.Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия))
		|	И ШкалыРейтинговыхАгентств.ВидРейтинга = &ВидРейтинга
		|	И ШкалыРейтинговыхАгентств.ТипШкалы <> ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.ПустаяСсылка)
		|	И ШкалыРейтинговыхАгентств.Срок = &Срок
		|
		|СГРУППИРОВАТЬ ПО
		|	ШкалыРейтинговыхАгентств.ТипШкалы,
		|	ШкалыРейтинговыхАгентств.ВидРейтинга,
		|	ШкалыРейтинговыхАгентств.Срок,
		|	ШкалыРейтинговыхАгентств.Агрегатор,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМинимальное,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное,
		|	ЕСТЬNULL(СопоставлениеРейтинговыхШкалСрезПоследних.Активно, ЛОЖЬ),
		|	ШкалыРейтинговыхАгентств.Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Агрегатор,
		|	Владелец,
		|	ВидРейтинга,
		|	ТипШкалы,
		|	Срок";
		
		
	Запрос.УстановитьПараметр("Период", Период); 
	Запрос.УстановитьПараметр("Источник", Источникъ); 	
	Запрос.УстановитьПараметр("Срок", Перечисления.СрокиРейтингов.Долгосрочный); 		
	Запрос.УстановитьПараметр("ВидРейтинга", Перечисления.ВидыРейтингов.Кредитный);  	
	Запрос.УстановитьПараметр("СтрокаСопоставления", СтрокаСопоставления);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		НовоеСтрокаСопоставление =ЭтаФорма.Объект.СопоставленияРШ.Добавить();
		// НовоеСтрокаСопоставление.ШкалаРейтингаЭталонная =  ВыборкаДетальныеЗаписи.Ссылка;		 
		         НовоеСтрокаСопоставление.РейтинговоеАгенство =  ВыборкаДетальныеЗаписи.Владелец;
		ЗаполнитьЗначенияСвойств(  НовоеСтрокаСопоставление,  ВыборкаДетальныеЗаписи);
		НовоеСтрокаСопоставление.Выбор =         ВыборкаДетальныеЗаписи.Выбрано;
		 

		 
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	      ЗаполнитьТаблицу(       Объект.Период, Объект.Источник,      Объект.СтрокаСопоставления );

КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()
	Для каждого строкаСопоставления из ЭтаФорма.Объект.СопоставленияРШ       цикл
		если строкаСопоставления.выбор=истина тогда
			Сопоставления = РегистрыСведений.СопоставлениеРейтинговыхШкал.СоздатьНаборЗаписей();
			Сопоставления.отбор.Источник.Установить(Этаформа.Объект.Источник);
			Сопоставления.отбор.период.установить(этаформа.объект.период);
			            Сопоставления.отбор.СтрокаСопоставления.Установить(Этаформа.Объект.СтрокаСопоставления);

						Сопоставления.отбор.Агрегатор.установить(строкаСопоставления.Агрегатор);
						Сопоставления.отбор.ТипШкалы.установить(строкаСопоставления. ТипШкалы);

						Сопоставления.отбор.Срок .установить(строкаСопоставления. Срок);
						Сопоставления.отбор.РейтинговоеАгенство .установить(строкаСопоставления. РейтинговоеАгенство);

					сопоставления.Прочитать();
					сопоставления.Очистить();
					новоесопоставление = сопоставления.Добавить();
					новоесопоставление.ЗначениеМаксимальное =   строкаСопоставления.  ЗначениеМаксимальное;
					новоесопоставление.Агрегатор=строкаСопоставления.Агрегатор   ;
					новоесопоставление. период = этаформа.объект.период;
					  новоесопоставление.Источник =  Этаформа.Объект.Источник;
					          новоесопоставление.СтрокаСопоставления = Этаформа.Объект.СтрокаСопоставления;
						новоесопоставление.ТипШкалы = 	строкаСопоставления. ТипШкалы;
						новоесопоставление.Срок = 	строкаСопоставления. Срок;      
						новоесопоставление.РейтинговоеАгенство = 	строкаСопоставления. РейтинговоеАгенство;

					новоесопоставление.ЗначениеМинимальное =  строкаСопоставления   .ЗначениеМинимальное    ;
					новоесопоставление.активно = строкаСопоставления. активно;
					новоесопоставление.ШкалаРейтингаЭталонная =  строкаСопоставления.ШкалаРейтингаЭталонная;
					Сопоставления.Записать();					
		конецесли;
		конеццикла;                                               
	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	СохранитьИзмененияНаСервере();
КонецПроцедуры

&НаСервере
Процедура КопироватьСодержаниеНаСервере()
	Для каждого строкаСопоставления из ЭтаФорма.Объект.СопоставленияРШ       цикл
		если строкаСопоставления.выбор=истина тогда
			Сопоставления = РегистрыСведений.СопоставлениеРейтинговыхШкал.СоздатьНаборЗаписей();
			Сопоставления.отбор.Источник.Установить(Этаформа.ОбъектКопированияИсточник);
			Сопоставления.отбор.период.установить(этаформа.ОбъектКопированияПериод);
			            Сопоставления.отбор.СтрокаСопоставления.Установить(Этаформа.ОбъектКопированияСтрокаСопоставления);

						Сопоставления.отбор.Агрегатор.установить(строкаСопоставления.Агрегатор);
						Сопоставления.отбор.ТипШкалы.установить(строкаСопоставления. ТипШкалы);

						Сопоставления.отбор.Срок .установить(строкаСопоставления. Срок);
						Сопоставления.отбор.РейтинговоеАгенство .установить(строкаСопоставления. РейтинговоеАгенство);

					сопоставления.Прочитать();
					сопоставления.Очистить();
					новоесопоставление = сопоставления.Добавить();
					новоесопоставление.ЗначениеМаксимальное =   строкаСопоставления.  ЗначениеМаксимальное;
					новоесопоставление.Агрегатор=строкаСопоставления.Агрегатор   ;
					новоесопоставление. период = этаформа.ОбъектКопированияПериод;
					  новоесопоставление.Источник =  Этаформа.ОбъектКопированияИсточник;
					          новоесопоставление.СтрокаСопоставления = Этаформа.ОбъектКопированияСтрокаСопоставления;
						новоесопоставление.ТипШкалы = 	строкаСопоставления. ТипШкалы;
						новоесопоставление.Срок = 	строкаСопоставления. Срок;      
						новоесопоставление.РейтинговоеАгенство = 	строкаСопоставления. РейтинговоеАгенство;
новоесопоставление.ВидРейтинга = строкаСопоставления.ВидРейтинга;
					новоесопоставление.ЗначениеМинимальное =  строкаСопоставления   .ЗначениеМинимальное    ;
					новоесопоставление.активно = строкаСопоставления. активно;
					новоесопоставление.ШкалаРейтингаЭталонная =  строкаСопоставления.ШкалаРейтингаЭталонная;
					Сопоставления.Записать();					
		конецесли;
		конеццикла;   
КонецПроцедуры

