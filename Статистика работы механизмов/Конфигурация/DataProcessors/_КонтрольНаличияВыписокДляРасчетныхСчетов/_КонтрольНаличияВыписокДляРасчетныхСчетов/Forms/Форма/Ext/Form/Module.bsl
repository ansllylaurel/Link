
&НаСервере
Процедура ЗаполнитьНаСервере()
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Ссылка КАК РасчетныйСчет,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Банк КАК Банк,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК ОстатокНаСчете,
		|	СУММА(СтоимостьАктивовСтраховыхКомпанийСрезПервых.Сумма) КАК Распределено,
		|	МИНИМУМ(СтоимостьАктивовСтраховыхКомпанийСрезПервых.Период) КАК ДатаРаспределено,
		|	ЕСТЬNULL(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен, ЛОЖЬ) КАК ИсключенИсходный,
		|	ЕСТЬNULL(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен, ЛОЖЬ) КАК Исключен,
		|	МАКСИМУМ(ВЫРАЗИТЬ(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Комментарий КАК СТРОКА(1000))) КАК КомментарийИсходный,
		|	МАКСИМУМ(ВЫРАЗИТЬ(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Комментарий КАК СТРОКА(1000))) КАК Комментарий,
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И НЕ РасчетныйСчет.Банк ЕСТЬ NULL) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних
		|		ПО ОстаткиДенежныхСредствОстатки.Организация = ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Организация
		|			И (ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления)
		|			И (ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Актив = ОстаткиДенежныхСредствОстатки.РасчетныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьАктивовСтраховыхКомпаний.СрезПервых(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправленияИсходный = &СчетДоверительногоУправления) КАК СтоимостьАктивовСтраховыхКомпанийСрезПервых
		|		ПО ОстаткиДенежныхСредствОстатки.Организация = СтоимостьАктивовСтраховыхКомпанийСрезПервых.Организация
		|			И ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = СтоимостьАктивовСтраховыхКомпанийСрезПервых.СчетДоверительногоУправленияИсходный
		|			И ОстаткиДенежныхСредствОстатки.РасчетныйСчет = СтоимостьАктивовСтраховыхКомпанийСрезПервых.Актив
		|			И ОстаткиДенежныхСредствОстатки.Валюта = СтоимостьАктивовСтраховыхКомпанийСрезПервых.Валюта
		|			И (СтоимостьАктивовСтраховыхКомпанийСрезПервых.Сумма <> 0)
		|			И (СтоимостьАктивовСтраховыхКомпанийСрезПервых.СчетДоверительногоУправления <> СтоимостьАктивовСтраховыхКомпанийСрезПервых.СчетДоверительногоУправленияИсходный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО ОстаткиДенежныхСредствОстатки.РасчетныйСчет = БанковскиеСчета.Ссылка
		|ГДЕ
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Ссылка,
		|	ЕСТЬNULL(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен, ЛОЖЬ),
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Банк,
		|	БанковскиеСчета.Ссылка,
		|	ЕСТЬNULL(ИсключаемыеАктивыСтраховыхКомпанийСрезПоследних.Исключен, ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	
	Результат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Объект.ИсключаемыеАктивы.Очистить();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрокаТаблицы =  Объект.ИсключаемыеАктивы.Добавить();
		НоваяСтрокаТаблицы.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
		НоваяСтрокаТаблицы.ДатаИсключения = Объект.Период;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, Результат);    
		
	КонецЦикла

	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Заполнить");
	Попытка
		ВыполнитьЗаполнение(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнение(ПараметрыСессии)
	
	ЗаполнитьНаСервере();
	УстановитьДоступностьКоманд();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоманд()

	Если ПроверитьДатыЗапретаРедактированияНаСервере() Тогда
		ЭтаФорма.Элементы.Сохранить.Доступность = Истина;
		ЭтаФорма.Элементы.ПредупреждениеОДатеЗапрета.Видимость = Ложь;
	Иначе		
		ЭтаФорма.Элементы.Сохранить.Доступность = Ложь;
		ЭтаФорма.Элементы.ПредупреждениеОДатеЗапрета.Видимость = Истина;		
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключаемыеАктивыИсключенПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИсключаемыеАктивы.ТекущиеДанные;
	
	Если ТекущиеДанные.Исключен <> ТекущиеДанные.ИсключенИсходный Тогда
		
		Если ТекущиеДанные.Исключен Тогда
			ТекущиеДанные.Комментарий = "Не получена выписка или отчет брокера";			   
		Иначе  
			ТекущиеДанные.Комментарий = "";
		КонецЕсли; 		
	
	Иначе  		
		ТекущиеДанные.Комментарий = ТекущиеДанные.КомментарийИсходный;		
	КонецЕсли;
	
	УстановитьДоступностьКоманд(); 
		
КонецПроцедуры

&НаСервере 
Функция ПроверитьРаспределенныеАктивыНаСервере() 	
	
	// Проверить, активы не используются в распределениях.
	Запрос =  ПодготовитьЗапросПолучитьРаспределенныеАктивы( 
				Объект.СчетДоверительногоУправления, Объект.Организация, 
				Объект.ИсключаемыеАктивы.Выгрузить(), Объект.Период);
				
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция ПроверитьДатыЗапретаРедактированияНаСервере()
	
	// Проверить, даты документов, подлежащих изменению не меньше даты запрета редактирования.
	Запрос =  ПодготовитьЗапросПолучитьРаспределенныеАктивы( 
				Объект.СчетДоверительногоУправления, Объект.Организация, 
				Объект.ИсключаемыеАктивы.Выгрузить(), Объект.Период);

	ВыборкаРегистраторы = Запрос.Выполнить().Выбрать( ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистраторы.Следующий() Цикл
		
		ТекстОшибки = "";
		Если РаботаСДокументами.ЗапретРедактированияДокумента(ВыборкаРегистраторы.Регистратор, Неопределено, Неопределено, Ложь, ) Тогда		
			Возврат Ложь;
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Истина;
	 	
КонецФункции

&НаСервере
Функция ПодготовитьЗапросПолучитьРаспределенныеАктивы( СчетДоверительногоУправления, Организация, ИсключаемыеАктивы, Период )
	
	Запрос = Новый Запрос();
	Запрос.Текст  = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсключаемыеАктивы.РасчетныйСчет КАК РасчетныйСчет,
		|	ИсключаемыеАктивы.Исключен КАК Исключен,
		|	ИсключаемыеАктивы.ИсключенИсходный КАК ИсключенИсходный,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&Период КАК Период,
		|	&Организация КАК Организация
		|ПОМЕСТИТЬ _ИсключаемыеАктивыДокумента
		|ИЗ
		|	&ИсключаемыеАктивы КАК ИсключаемыеАктивы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсключаемыеАктивыДокумента.РасчетныйСчет КАК РасчетныйСчет,
		|	_ИсключаемыеАктивыДокумента.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ИсключаемыеАктивыДокумента.Период КАК ПериодОт,
		|	ИсключаемыеАктивыСтраховыхКомпанийСрезПервых.Период КАК ПериодДо
		|ПОМЕСТИТЬ _ДиапазонИсключаемыеАктивы
		|ИЗ
		|	_ИсключаемыеАктивыДокумента КАК _ИсключаемыеАктивыДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсключаемыеАктивыСтраховыхКомпаний.СрезПервых(
		|				&Период,
		|				СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Организация = &Организация
		|					И Исключен = ЛОЖЬ) КАК ИсключаемыеАктивыСтраховыхКомпанийСрезПервых
		|		ПО _ИсключаемыеАктивыДокумента.РасчетныйСчет = ИсключаемыеАктивыСтраховыхКомпанийСрезПервых.Актив
		|			И _ИсключаемыеАктивыДокумента.СчетДоверительногоУправления = ИсключаемыеАктивыСтраховыхКомпанийСрезПервых.СчетДоверительногоУправления
		|			И _ИсключаемыеАктивыДокумента.Организация = ИсключаемыеАктивыСтраховыхКомпанийСрезПервых.Организация
		|ГДЕ
		|	_ИсключаемыеАктивыДокумента.Исключен = ИСТИНА
		|	И _ИсключаемыеАктивыДокумента.Исключен <> _ИсключаемыеАктивыДокумента.ИсключенИсходный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовСтраховыхКомпаний.Регистратор КАК Регистратор,
		|	СтоимостьАктивовСтраховыхКомпаний.Период КАК Период,
		|	СтоимостьАктивовСтраховыхКомпаний.Организация КАК Организация,
		|	СтоимостьАктивовСтраховыхКомпаний.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовСтраховыхКомпаний.Актив КАК Актив,
		|	СтоимостьАктивовСтраховыхКомпаний.Валюта КАК Валюта,
		|	СтоимостьАктивовСтраховыхКомпаний.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправленияИсходный
		|ИЗ
		|	_ДиапазонИсключаемыеАктивы КАК _ДиапазонИсключаемыеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьАктивовСтраховыхКомпаний КАК СтоимостьАктивовСтраховыхКомпаний
		|		ПО _ДиапазонИсключаемыеАктивы.РасчетныйСчет = СтоимостьАктивовСтраховыхКомпаний.Актив
		|			И _ДиапазонИсключаемыеАктивы.СчетДоверительногоУправления = СтоимостьАктивовСтраховыхКомпаний.СчетДоверительногоУправленияИсходный
		|			И (СтоимостьАктивовСтраховыхКомпаний.Период >= _ДиапазонИсключаемыеАктивы.ПериодОт)
		|			И (_ДиапазонИсключаемыеАктивы.ПериодДо ЕСТЬ NULL
		|				ИЛИ _ДиапазонИсключаемыеАктивы.ПериодДо > СтоимостьАктивовСтраховыхКомпаний.Период)
		|ГДЕ
		|	ЕСТЬNULL(СтоимостьАктивовСтраховыхКомпаний.Сумма, 0) <> 0
		|ИТОГИ ПО
		|	Регистратор";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Организация);      	
	Запрос.УстановитьПараметр("Период", Период );  	
	Запрос.УстановитьПараметр("ИсключаемыеАктивы", ИсключаемыеАктивы);

	Возврат Запрос;
	
КонецФункции
	
&НаСервере
Процедура СохранитьНаСервере()
	
	
	НачатьТранзакцию(); 
	Для Каждого Актив из Объект.ИсключаемыеАктивы Цикл 
		Если Актив.Исключен <> Актив.ИсключенИсходный Тогда 
			
			МенеджерЗаписи = РегистрыСведений.ИсключаемыеАктивыСтраховыхКомпаний.СоздатьМенеджерЗаписи(); 
			МенеджерЗаписи.Организация = Объект.Организация;               
			МенеджерЗаписи.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
			МенеджерЗаписи.Актив = Актив.РасчетныйСчет;                    
			МенеджерЗаписи.Исключен = Актив.Исключен;        
			МенеджерЗаписи.Период = Объект.Период;        
			МенеджерЗаписи.Комментарий  = Актив.Комментарий;
			
			МенеджерЗаписи.Записать();               
				
		КонецЕсли; 
	КонецЦикла; 
	
	// Удаление исключаемых счетов из распределений
	
	Запрос = ПодготовитьЗапросПолучитьРаспределенныеАктивы( Объект.СчетДоверительногоУправления, Объект.Организация, Объект.ИсключаемыеАктивы.Выгрузить(), Объект.Период);
	
	ВыборкаРегистраторы = Запрос.Выполнить().Выбрать( ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистраторы.Следующий() Цикл
		
		ИсключаемыеАктивы = ВыборкаРегистраторы.Выбрать();
		
		ДокументРаспределение = ВыборкаРегистраторы.Регистратор.ПолучитьОбъект();

		Пока ИсключаемыеАктивы.Следующий() Цикл
			
			СтруктураПоиска = Новый Структура( "Актив", ИсключаемыеАктивы.Актив);
			СтрокаИсключаемыйАктив =  ДокументРаспределение.АктивыСтраховойКомпании.НайтиСтроки(СтруктураПоиска)[0];
			СтрокаИсключаемыйАктив.Нераспределено = 
							СтрокаИсключаемыйАктив.Нераспределено + 
							СтрокаИсключаемыйАктив.РезервыПоСтрахованиюЖизни + 
							СтрокаИсключаемыйАктив.РезервыПоСтрахованиюИномуЧемЖизни + 
							СтрокаИсключаемыйАктив.СобственныеСредстваВРазмереНорматива +
							СтрокаИсключаемыйАктив.СобственныеСредстваСверхНорматива;
			СтрокаИсключаемыйАктив.РезервыПоСтрахованиюЖизни = 0; 
			СтрокаИсключаемыйАктив.РезервыПоСтрахованиюИномуЧемЖизни = 0;
			СтрокаИсключаемыйАктив.СобственныеСредстваВРазмереНорматива = 0;
			СтрокаИсключаемыйАктив.СобственныеСредстваСверхНорматива = 0;
			
			
		КонецЦикла;			
		
		ДокументРаспределение.Записать( РежимЗаписиДокумента.ОтменаПроведения );
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отменено проведение документа Распределение Активов СК №" + ДокументРаспределение.Номер + " от " + Формат(ДокументРаспределение.Дата, "гг.ММ.дд")
						, ДокументРаспределение.Ссылка,,,);
 	
	КонецЦикла;

	
	ЗафиксироватьТранзакцию();      
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Сохранить");
	Попытка
		ВыполнитьСохранение(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСохранение(ПараметрыСессии)
	
	Если Не ПроверитьРаспределенныеАктивыНаСервере() Тогда
		Если Вопрос("Внимание! Расчетные счета, отмеченные как исключаемые из распределения, используются в документах. Подтвердите исключение данных активов?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			ПараметрыСессии.ТекстОшибки = "Отменено пользователем";
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СохранитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()
	Объект.ИсключаемыеАктивы.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ПараметрЗапросаНаФормеПриИзменении(Элемент)
		 ПериодПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИсключитьВсе");
	Попытка
		ВыполнитьИсключениеВсех(ПараметрыСессии);
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИсключениеВсех(ПараметрыСессии)
	
	Для Каждого РасчетныйСчет из Объект.ИсключаемыеАктивы Цикл
		РасчетныйСчет.Исключен = ИСТИНА;
		РасчетныйСчет.Комментарий = "Не получена выписка или отчет брокера";
	КонецЦикла;
	
	УстановитьДоступностьКоманд();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период      = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.Элементы.Сохранить.Доступность = Ложь;
	ЭтаФорма.Элементы.ПредупреждениеОДатеЗапрета.Видимость = Ложь;   
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
