&НаКлиенте
Процедура СписокСчетовДУСчетДоверительногоУправленияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.СписокСчетовДУ.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.СчетДоверительногоУправления = ПредопределенноеЗначение("Справочник.СчетаДоверительногоУправления.ПустаяСсылка") Тогда
		
		ТекущаяСтрока.Флажок 					= Ложь;
		ТекущаяСтрока.КодСчетаДУ 				= "";
		ТекущаяСтрока.ВводДенежныхСредств 		= "";
		ТекущаяСтрока.ОсновнойБрокерскийДоговор = "";
		ТекущаяСтрока.ОсновнойКодУБрокера 		= Ложь;
		
	Иначе
		
		// Запомним ввод ДС. Если счет ДУ не изменен, ввод ДС не будем очищать
		ВводДС = ТекущаяСтрока.ВводДенежныхСредств;
		СчетДУ = "";
		Если ЗначениеЗаполнено(ВводДС) Тогда
			СчетДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВводДС, "СчетДоверительногоУправления");
		КонецЕсли;	
			
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПолучитьДанныеСчетаДУ(Объект.Организация, ТекущаяСтрока.СчетДоверительногоУправления, Объект.Период.ДатаНачала, Объект.Период.ДатаОкончания));
		
		Если СчетДУ = ТекущаяСтрока.СчетДоверительногоУправления Тогда
			ТекущаяСтрока.ВводДенежныхСредств = ВводДС;
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеСчетаДУ(Организация, СчетДоверительногоУправления, НачалоПериода, НаДату)
	
	СтруктураРезультата = Новый Структура("Флажок, СчетДоверительногоУправления, Стратегия, КодСчетаДУ, ОсновнойБрокерскийДоговор, ОсновнойКодУБрокера, ВводДенежныхСредств");
	Запрос = Новый Запрос;
		
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("НачалоПериода",					НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(НаДату));
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| 	ИСТИНА КАК Флажок,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия, ЗНАЧЕНИЕ(Справочник.СтратегииИндивидуальногоИнвестирования.ПустаяСсылка)) КАК Стратегия,
		|	ЕСТЬNULL(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код, """") КАК КодСчетаДУ,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокер КАК ОсновнойБрокер,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.ОсновнойКодУБрокера КАК ОсновнойКодУБрокера,
		|	ЗНАЧЕНИЕ(Документ.ВводДенежныхСредств.ПустаяСсылка) КАК ВводДенежныхСредств
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|			&КонецПериода,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&КонецПериода, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация
		|			И СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления";
		
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		СтруктураРезультата.Вставить("Флажок", 						 	Выборка.Флажок);
		СтруктураРезультата.Вставить("СчетДоверительногоУправления", 	Выборка.СчетДоверительногоУправления);
		СтруктураРезультата.Вставить("Стратегия", 						Выборка.Стратегия);
		СтруктураРезультата.Вставить("КодСчетаДУ", 						Выборка.КодСчетаДУ);
		СтруктураРезультата.Вставить("ОсновнойБрокерскийДоговор", 		Выборка.ОсновнойБрокерскийДоговор);
		СтруктураРезультата.Вставить("ОсновнойКодУБрокера", 			Выборка.ОсновнойКодУБрокера);
		СтруктураРезультата.Вставить("ВводДенежныхСредств", 			Выборка.ВводДенежныхСредств);
				
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции // ПолучитьДанныеСчетаДУ

