&НаСервереБезКонтекста
Функция ОпределитьКодПортфеля(Организация, Брокер, БрокерскийДоговор, КодИнвестСчета)
	
	// в соответствии с утвержденной схемой взаимодействия с брокером, мы сами нумеруем портфели;
	// портфели нумеруются последовательно в рамках инвест. счета через разделитель "_",
	// например: 2000_1, 2000_2, 2000_3,…
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И ДоговорБрокерскогоОбслуживания = &ДоговорБрокерскогоОбслуживания) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|ГДЕ
		|	ПОДСТРОКА(КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код, 1, &ДлинаКодаИнвестСчета) = &КодИнвестСчета";
	
	Запрос.УстановитьПараметр("Организация",                    Организация);
	Запрос.УстановитьПараметр("Брокер",                         Брокер);
	Запрос.УстановитьПараметр("ДоговорБрокерскогоОбслуживания", БрокерскийДоговор);
	Запрос.УстановитьПараметр("КодИнвестСчета",                 КодИнвестСчета + "_");
	Запрос.УстановитьПараметр("ДлинаКодаИнвестСчета",           СтрДлина(КодИнвестСчета) + 1);
	
	КодыПортфелей = Запрос.Выполнить().Выгрузить();
	
	Если КодыПортфелей.Количество() = 0 Тогда
		Возврат КодИнвестСчета + "_1";
	КонецЕсли;
	
	// чтобы сортировка работала корректно, дополним коды портфелей спереди "0" до макс. длины
	МаксДлинаКодаПортфеля = 0;
	
	Для каждого СтрокаКодыПортфелей Из КодыПортфелей Цикл
		// первым проходом выделим коды портфелей и определим макс. длину
		СтрокаКодыПортфелей.Код = Сред(СтрокаКодыПортфелей.Код, Запрос.Параметры.ДлинаКодаИнвестСчета + 1);
		
		Если Макс(МаксДлинаКодаПортфеля) < СтрДлина(СтрокаКодыПортфелей.Код) Тогда
			МаксДлинаКодаПортфеля = СтрДлина(СтрокаКодыПортфелей.Код);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаКодыПортфелей Из КодыПортфелей Цикл
		// вторым проходом дополним коды портфелей лид. нулями, чтобы подготовить к сортировке
		Пока СтрДлина(СтрокаКодыПортфелей.Код) < МаксДлинаКодаПортфеля Цикл
			СтрокаКодыПортфелей.Код = "0" + СтрокаКодыПортфелей.Код;
		КонецЦикла;
	КонецЦикла;
	
	КодыПортфелей.Сортировать("Код УБЫВ");
	
	Возврат КодИнвестСчета + "_" + Строка(Число(КодыПортфелей[0].Код) + 1);
	
КонецФункции // ОпределитьКодПортфеля

