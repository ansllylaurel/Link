&НаСервере
Процедура НазначитьКодыСчетовДУ(ПараметрыСессии = Неопределено)
	
	Для Каждого СтрокаСчетаДУ Из ЭтотОбъект.СписокСчетовДУ Цикл
		
		Если Не СтрокаСчетаДУ.Флажок Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСчетаДУ.КодСчетаДУ) Тогда
			Продолжить;
		КонецЕсли;
				
		КодСчетаДУ = ОпределитьКодПортфеля(Объект.Организация, Объект.Брокер, СтрокаСчетаДУ.ОсновнойБрокерскийДоговор, СтрокаСчетаДУ.ОсновнойКодУБрокера); 
				
		НаборЗаписей = РегистрыСведений.КодыСчетовДоверительногоУправленияУБрокеров.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Объект.Организация);
		НаборЗаписей.Отбор.СчетДоверительногоУправления.Установить(СтрокаСчетаДУ.СчетДоверительногоУправления);
		НаборЗаписей.Отбор.Брокер.Установить(Объект.Брокер);
		НаборЗаписей.Прочитать();
		
		ТаблицаЗаписей = НаборЗаписей.Выгрузить();
		Если НаборЗаписей.Количество() = 0 Тогда
			
			// Создаем новую запись о договоре
			НоваяЗапись = ТаблицаЗаписей.Добавить();
			НоваяЗапись.Организация 					= Объект.Организация;
			НоваяЗапись.СчетДоверительногоУправления 	= СтрокаСчетаДУ.СчетДоверительногоУправления;
			НоваяЗапись.Брокер 							= Объект.Брокер;
			НоваяЗапись.Код 							= КодСчетаДУ;
			НоваяЗапись.ДоговорБрокерскогоОбслуживания 	= СтрокаСчетаДУ.ОсновнойБрокерскийДоговор;
			НоваяЗапись.Период 							= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСчетаДУ.СчетДоверительногоУправления, "ДатаЗаключения");
			
		Иначе
				
			ТаблицаЗаписей.Сортировать("Период УБЫВ");			
			ТаблицаЗаписей[0].Код = КодСчетаДУ;
			
		КонецЕсли;	
				
		НаборЗаписей.Загрузить(ТаблицаЗаписей);
		Попытка
			НаборЗаписей.Записать(Истина);
		Исключение
			ДобавитьТекстОшибки(ПараметрыСессии, "Не записан код счета ДУ " + СокрЛП(СтрокаСчетаДУ.СчетДоверительногоУправления) + " " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не записан код счета ДУ " + СокрЛП(СтрокаСчетаДУ.СчетДоверительногоУправления) + " " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		СтрокаСчетаДУ.КодСчетаДУ = КодСчетаДУ;
		
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьКодыСчетовДУ(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьКодыСчетовДУ");
	Попытка
		НазначитьКодыСчетовДУ(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

