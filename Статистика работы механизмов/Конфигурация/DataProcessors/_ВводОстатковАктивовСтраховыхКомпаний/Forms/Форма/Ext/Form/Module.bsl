
&НаСервереБезКонтекста
Функция ПолучитьКлиентаДоверительногоУправления(Период, СчетДоверительногоУправления)
	
	Возврат Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
КонецФункции // ПолучитьЮрФизЛицоКлиентаДоверительногоУправления

&НаСервереБезКонтекста
Функция ПолучитьКлючОсновногоРегистратор(Период, СчетДоверительногоУправления)
	
	Возврат Формат(Период, "ДФ=ггггММдд") + "/" + СчетДоверительногоУправления.КодСчета;
	
КонецФункции // ПолучитьКлючОсновногоРегистратор

&НаСервереБезКонтекста
Функция ПолучитьОсновнойРегистратор(Период, СчетДоверительногоУправления)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КодыВоВнешнихСистемах.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах КАК КодыВоВнешнихСистемах
		|ГДЕ
		|	КодыВоВнешнихСистемах.Период = ДАТАВРЕМЯ(1980, 1, 1)
		|	И КодыВоВнешнихСистемах.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Фенси)
		|	И КодыВоВнешнихСистемах.ГруппаОбъектов = &ГруппаОбъектов
		|	И КодыВоВнешнихСистемах.Код = &Код
		|	И КодыВоВнешнихСистемах.Объект.ПометкаУдаления = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("ГруппаОбъектов", Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Ручные вводы денежных средств", Истина, Ложь));
	Запрос.УстановитьПараметр("Код",            ПолучитьКлючОсновногоРегистратор(Период, СчетДоверительногоУправления));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;
	
	Возврат Документы.КорректировкаРегистров.ПустаяСсылка();
	
КонецФункции // ПолучитьОсновнойРегистратор

&НаСервереБезКонтекста
Функция ЕстьПрочиеРегистраторы(Период, СчетДоверительногоУправления, Организация, ОсновнойРегистратор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОстаткиДенежныхСредств.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.Регистратор <> &ОсновнойРегистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОстаткиПрочихАктивов.Регистратор
		|ИЗ
		|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
		|ГДЕ
		|	ОстаткиПрочихАктивов.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиПрочихАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиПрочихАктивов.Организация = &Организация
		|	И ОстаткиПрочихАктивов.Регистратор <> &ОсновнойРегистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДенежныеСредстваВКредитныхИнструментах.Регистратор
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДенежныеСредстваВКредитныхИнструментах
		|ГДЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДенежныеСредстваВКредитныхИнструментах.Организация = &Организация
		|	И ДенежныеСредстваВКредитныхИнструментах.Регистратор <> &ОсновнойРегистратор
		|	И ДенежныеСредстваВКредитныхИнструментах.ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)";
		
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",                  Организация);
	//Запрос.УстановитьПараметр("ОсновнойРегистратор",          ОсновнойРегистратор);
		
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // ПроверитьНаличиеПрочихРегистраторов

&НаКлиенте
Процедура ПроверитьДатуЗапретаРедактирования()
		
	Если НЕ ПроверитьДатыЗапретаРедактированияНаСервере() Тогда 		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя импортировать остатки - редактирование запрещено (см. дату запрета редактирования)");
		ЭтаФорма.Элементы.ФормаКомандаСохранить.Доступность = Ложь;
	Иначе
		ЭтаФорма.Элементы.ФормаКомандаСохранить.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьДатыЗапретаРедактированияНаСервере()
	
	ГруппыЗапретаРедактирования = Новый Массив();
	ГруппыЗапретаРедактирования.Добавить(Перечисления.ГруппыЗапретаРедактирования.Партии);	
	ГруппыЗапретаРедактирования.Добавить(Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
	ГруппыЗапретаРедактирования.Добавить(Перечисления.ГруппыЗапретаРедактирования.Проводки);            
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования) КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета В(&ГруппаЗапрета)
		|	И ДатыЗапретаРедактирования.ВидУчета = &ВидУчета
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования) >= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";

	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("ГруппаЗапрета",                ГруппыЗапретаРедактирования);
	Запрос.УстановитьПараметр("ВидУчета",                	  Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);   
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь; 
	Иначе
		Возврат Истина;
	КонецЕсли;   
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОстаткиДенежныхСредствНаСервере(ФиксироватьСтатистику = Истина)
	
	Если ФиксироватьСтатистику Тогда
		
		ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтаФорма, "Период, Организация, СчетДоверительногоУправления, ПредПериод, ПредСчетДоверительногоУправления"); 
		Механизм			= "_ВводОстатковАктивовСтраховыхКомпаний.Форма.ЗаполнитьОстаткиДенежныхСредствНаСервере()";
		Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
		
	КонецЕсли;
	
	ДополнительноеСвойствоКассы = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "ПрочиеАктивы.Кассы.Собственник");
	
	Если Не ЗначениеЗаполнено(ДополнительноеСвойствоКассы) Тогда
		Сообщить("Не найдено дополнительное свойство прочего актива по ключу 'ПрочиеАктивы.Кассы.Собственник'");
	КонецЕсли;
	
	ЭтаФорма.ОстаткиДенежныхСредств.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеАктивы.ВидАктива КАК ВидАктива,
		|	ДенежныеАктивы.Актив КАК Актив,
		|	ДенежныеАктивы.Валюта КАК Валюта,
		|	ДенежныеАктивы.МестоХранения КАК МестоХранения,
		|	ДенежныеАктивы.ВходящийОстаток КАК ВходящийОстаток,
		|	ДенежныеАктивы.Сумма КАК Сумма,
		|	ДенежныеАктивы.ИсходящийОстаток КАК ИсходящийОстаток,
		|	ДенежныеАктивы.Сумма КАК ИсходнаяСумма,
		|	ДенежныеАктивы.Основание КАК Основание,
		|	ДенежныеАктивы.Основание КАК ИсходноеОснование
		|ИЗ
		|	(ВЫБРАТЬ
		|		""Расчетные счета, "" + ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта.Наименование КАК ВидАктива,
		|		ЕСТЬNULL(ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет, ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет) КАК Актив,
		|		ЕСТЬNULL(ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения, ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)) КАК МестоХранения,
		|		ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта КАК Валюта,
		|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК ВходящийОстаток,
		|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК Сумма,
		|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК ИсходящийОстаток,
		|		ОснованияДляДвижений.Основание КАК Основание
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|			ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|					НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					,
		|					,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстаткиИОбороты
		|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание КАК Основание,
		|					ОстаткиДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
		|					ОстаткиДенежныхСредств.Валюта КАК Валюта
		|				ИЗ
		|					РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|							ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияОперацийСАктивамиСтраховыхКомпаний КАК ОснованияОперацийСАктивамиСтраховыхКомпаний
		|							ПО КорректировкаРегистров.Ссылка = ОснованияОперацийСАктивамиСтраховыхКомпаний.Операция
		|						ПО ОстаткиДенежныхСредств.Регистратор = КорректировкаРегистров.Ссылка
		|				ГДЕ
		|					ОстаткиДенежныхСредств.Организация = &Организация
		|					И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|				
		|				СГРУППИРОВАТЬ ПО
		|					ОстаткиДенежныхСредств.РасчетныйСчет,
		|					ОстаткиДенежныхСредств.Валюта,
		|					ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание) КАК ОснованияДляДвижений
		|				ПО ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет = ОснованияДляДвижений.РасчетныйСчет
		|					И (ОснованияДляДвижений.Валюта = ОстаткиДенежныхСредствОстаткиИОбороты.Валюта)
		|			ПО ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет
		|	ГДЕ
		|		ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		""Депозитные вклады"",
		|		ДепозитныеВклады.Ссылка,
		|		ДепозитныеВклады.БанковскийСчет,
		|		ДепозитныеВклады.БанковскийСчет.Валюта,
		|		ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаНачальныйОстаток,
		|		ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаОборот,
		|		ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаКонечныйОстаток,
		|		ОснованияДляДвижений.Основание
		|	ИЗ
		|		Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|					НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					,
		|					,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ВЫРАЗИТЬ(КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.ЮрФизЛицо В
		|							(ВЫБРАТЬ
		|								КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|							ИЗ
		|								РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		|			ПО ДепозитныеВклады.Ссылка = ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание КАК Основание,
		|				ОстаткиДенежныхСредств.КредитныйИнструмент КАК ДепозитныйВклад
		|			ИЗ
		|				РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ОстаткиДенежныхСредств
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияОперацийСАктивамиСтраховыхКомпаний КАК ОснованияОперацийСАктивамиСтраховыхКомпаний
		|						ПО КорректировкаРегистров.Ссылка = ОснованияОперацийСАктивамиСтраховыхКомпаний.Операция
		|					ПО ОстаткиДенежныхСредств.Регистратор = КорректировкаРегистров.Ссылка
		|			ГДЕ
		|				ОстаткиДенежныхСредств.Организация = &Организация
		|				И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание,
		|				ОстаткиДенежныхСредств.КредитныйИнструмент) КАК ОснованияДляДвижений
		|			ПО (ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент = ОснованияДляДвижений.ДепозитныйВклад)
		|	ГДЕ
		|		ДепозитныеВклады.БанковскийСчет.ЮрФизЛицо В
		|				(ВЫБРАТЬ
		|					КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|				ИЗ
		|					РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		""Кассы"",
		|		ЕСТЬNULL(ЗначенияДополнительныхСведений.Объект, ОстаткиПрочихАктивовОстаткиИОбороты.Актив),
		|		НЕОПРЕДЕЛЕНО,
		|		ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Валюта, Организации.ВалютаУчета),
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток,
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот,
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток,
		|		ОснованияДвижений.Основание
		|	ИЗ
		|		РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
		|					НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					,
		|					,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстаткиИОбороты
		|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					ОстаткиПрочихАктивов.Актив КАК Актив,
		|					ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание КАК Основание
		|				ИЗ
		|					РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|							ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияОперацийСАктивамиСтраховыхКомпаний КАК ОснованияОперацийСАктивамиСтраховыхКомпаний
		|							ПО КорректировкаРегистров.Ссылка = ОснованияОперацийСАктивамиСтраховыхКомпаний.Операция
		|						ПО ОстаткиПрочихАктивов.Регистратор = КорректировкаРегистров.Ссылка
		|				ГДЕ
		|					ОстаткиПрочихАктивов.Организация = &Организация
		|					И ОстаткиПрочихАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ОстаткиПрочихАктивов.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|				
		|				СГРУППИРОВАТЬ ПО
		|					ОстаткиПрочихАктивов.Актив,
		|					ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание) КАК ОснованияДвижений
		|				ПО ОстаткиПрочихАктивовОстаткиИОбороты.Актив = ОснованияДвижений.Актив
		|			ПО ЗначенияДополнительныхСведений.Объект = ОстаткиПрочихАктивовОстаткиИОбороты.Актив,
		|		Справочник.Организации КАК Организации
		|	ГДЕ
		|		ЗначенияДополнительныхСведений.Свойство = &ДополнительноеСвойствоКассы
		|		И ЗначенияДополнительныхСведений.Значение = &СчетДоверительногоУправления
		|		И Организации.Ссылка = &Организация
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВидыПрочихАктивов.Наименование,
		|		ПрочиеАктивы.Ссылка,
		|		НЕОПРЕДЕЛЕНО,
		|		ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Валюта, Организации.ВалютаУчета),
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток,
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот,
		|		ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток,
		|		ОснованияДвижений.Основание
		|	ИЗ
		|		Справочник.ПрочиеАктивы КАК ПрочиеАктивы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыПрочихАктивов КАК ВидыПрочихАктивов
		|			ПО ПрочиеАктивы.ВидПрочегоАктива = ВидыПрочихАктивов.Ссылка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
		|					НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					,
		|					,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстаткиИОбороты
		|			ПО ПрочиеАктивы.Ссылка = ОстаткиПрочихАктивовОстаткиИОбороты.Актив
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ПО (Организации.Ссылка = &Организация)
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ОстаткиПрочихАктивов.Актив КАК Актив,
		|				ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание КАК Основание
		|			ИЗ
		|				РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияОперацийСАктивамиСтраховыхКомпаний КАК ОснованияОперацийСАктивамиСтраховыхКомпаний
		|						ПО КорректировкаРегистров.Ссылка = ОснованияОперацийСАктивамиСтраховыхКомпаний.Операция
		|					ПО ОстаткиПрочихАктивов.Регистратор = КорректировкаРегистров.Ссылка
		|			ГДЕ
		|				ОстаткиПрочихАктивов.Организация = &Организация
		|				И ОстаткиПрочихАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ОстаткиПрочихАктивов.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ОстаткиПрочихАктивов.Актив,
		|				ОснованияОперацийСАктивамиСтраховыхКомпаний.Основание) КАК ОснованияДвижений
		|			ПО (ОстаткиПрочихАктивовОстаткиИОбороты.Актив = ОснованияДвижений.Актив)
		|	ГДЕ
		|		ПрочиеАктивы.ВидПрочегоАктива <> ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.ДолиПерестраховщиков)) КАК ДенежныеАктивы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДенежныеАктивы.ВидАктива,
		|	ДенежныеАктивы.Актив
		|ИТОГИ ПО
		|	ВидАктива";
		
	Запрос.УстановитьПараметр("Период",                       ЭтаФорма.Период);
	Запрос.УстановитьПараметр("Организация",                  ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       ЭтаФорма.Период);
	Запрос.УстановитьПараметр("ДополнительноеСвойствоКассы",  ДополнительноеСвойствоКассы);
	
	ВыборкаВидАктива = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Ключ = 1;
	
	Пока ВыборкаВидАктива.Следующий() Цикл
		
		НоваяСтрокаВидАктива = ЭтаФорма.ОстаткиДенежныхСредств.ПолучитьЭлементы().Добавить();
		НоваяСтрокаВидАктива.ВидАктива = ВыборкаВидАктива.ВидАктива;
		НоваяСтрокаВидАктива.Ключ      = Ключ; 
		
		Ключ = Ключ + 1;
		
		ВыборкаОстатки = ВыборкаВидАктива.Выбрать();
		
		Пока ВыборкаОстатки.Следующий() Цикл
			
			НоваяСтрокаАктив = НоваяСтрокаВидАктива.ПолучитьЭлементы().Добавить();
			НоваяСтрокаАктив.Ключ = Ключ;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаАктив, ВыборкаОстатки);
			
			//НоваяСтрокаАктив.Регистратор = ПолучитьРегистраторАктива(ЭтаФорма.Период, СчетДоверительногоУправления, Организация,    ВыборкаОстатки.Актив);
			
			Ключ = Ключ + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//ЭтаФорма.ОсновнойРегистратор = ПолучитьОсновнойРегистратор(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления);
	
	//Если ЕстьПрочиеРегистраторы(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Организация, ЭтаФорма.ОсновнойРегистратор) Тогда
	//	Элементы.КомандаПрочиеРегистраторы.Заголовок = "Прочие вводы денежных средств";
	//Иначе
	//	Элементы.КомандаПрочиеРегистраторы.Заголовок = "Прочие вводы денежных средств (отсутствуют)";
	//КонецЕсли;
	
	ЭтаФорма.Модифицированность = Ложь;
	
	Если ФиксироватьСтатистику Тогда
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтаФорма, "Период, Организация, СчетДоверительногоУправления, ПредПериод, ПредСчетДоверительногоУправления"); 
	Механизм			= "_ВводОстатковАктивовСтраховыхКомпаний.Форма.СохранитьИзмененияНаСервере()";
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
	
	НачатьТранзакцию();
	
	Для каждого СтрокаВидАктива Из ЭтаФорма.ОстаткиДенежныхСредств.ПолучитьЭлементы() Цикл
		
		Для каждого СтрокаАктив Из СтрокаВидАктива.ПолучитьЭлементы() Цикл
			
			Если СтрокаАктив.ИсходнаяСумма <> СтрокаАктив.Сумма или СтрокаАктив.ИсходноеОснование <> СтрокаАктив.Основание Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	ВсеАктивы.Период КАК Период,
				               |	ВсеАктивы.Актив КАК Актив,
				               |	ВсеАктивы.Регистратор КАК Регистратор,
				               |	ВсеАктивы.Валюта КАК Валюта
				               |ИЗ
				               |	(ВЫБРАТЬ
				               |		ОстаткиДенежныхСредств.Период КАК Период,
				               |		ОстаткиДенежныхСредств.РасчетныйСчет КАК Актив,
				               |		ОстаткиДенежныхСредств.Регистратор КАК Регистратор,
				               |		ОстаткиДенежныхСредств.Валюта КАК Валюта,
				               |		NULL КАК ДепозитныйВкладБанковскийСчетВалюта
				               |	ИЗ
				               |		РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
				               |	
				               |	ОБЪЕДИНИТЬ ВСЕ
				               |	
				               |	ВЫБРАТЬ
				               |		ДенежныеСредстваВКредитныхИнструментах.Период,
				               |		ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент,
				               |		ДенежныеСредстваВКредитныхИнструментах.Регистратор,
				               |		NULL,
				               |		ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта
				               |	ИЗ
				               |		РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДенежныеСредстваВКредитныхИнструментах
				               |	ГДЕ
				               |		ДенежныеСредстваВКредитныхИнструментах.ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
				               |	
				               |	ОБЪЕДИНИТЬ ВСЕ
				               |	
				               |	ВЫБРАТЬ
				               |		ОстаткиПрочихАктивов.Период,
				               |		ОстаткиПрочихАктивов.Актив,
				               |		ОстаткиПрочихАктивов.Регистратор,
				               |		ОстаткиПрочихАктивов.Валюта,
				               |		NULL
				               |	ИЗ
				               |		РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
				               |	
				               |	ОБЪЕДИНИТЬ ВСЕ
				               |	
				               |	ВЫБРАТЬ
				               |		НоминалыКредитныхИнструментов.Период,
				               |		НоминалыКредитныхИнструментов.КредитныйИнструмент,
				               |		НоминалыКредитныхИнструментов.Регистратор,
				               |		NULL,
				               |		ВЫРАЗИТЬ(НоминалыКредитныхИнструментов.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта
				               |	ИЗ
				               |		РегистрСведений.НоминалыКредитныхИнструментов КАК НоминалыКредитныхИнструментов
				               |	ГДЕ
				               |		ТИПЗНАЧЕНИЯ(НоминалыКредитныхИнструментов.КредитныйИнструмент) = ТИП(Справочник.ДепозитныеВклады)) КАК ВсеАктивы
				               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров КАК КорректировкаРегистров
				               |		ПО ВсеАктивы.Регистратор = КорректировкаРегистров.Ссылка
				               |ГДЕ
				               |	ВсеАктивы.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
				               |	И ВсеАктивы.Актив = &Актив
				               |	И КорректировкаРегистров.Организация = &Организация
				               |	И КорректировкаРегистров.СчетДоверительногоУправления = &СчетДоверительногоУправления
				               |	И ВсеАктивы.Валюта = &Валюта";
							   
				Запрос.УстановитьПараметр("Период", ЭтаФорма.Период);				
				Запрос.УстановитьПараметр("Актив", СтрокаАктив.Актив);			
				Запрос.УстановитьПараметр("Валюта", СтрокаАктив.Валюта);
				Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);  
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
				Выборка = Запрос.Выполнить().Выбрать();				
				
				Пока Выборка.Следующий() Цикл
					
					НаборОстаткиДенежныхСредств = РегистрыНакопления.ОстаткиДенежныхСредств.СоздатьНаборЗаписей();
					НаборОстаткиДенежныхСредств.Отбор.Регистратор.Установить(Выборка.Регистратор);
					НаборОстаткиДенежныхСредств.Прочитать();
					ВсегоЗаписей = НаборОстаткиДенежныхСредств.Количество();
					
					Для НомерЗаписи = 1 По ВсегоЗаписей Цикл
						
					    ТекущаяЗапись = НаборОстаткиДенежныхСредств[ВсегоЗаписей - НомерЗаписи];
						Если ТекущаяЗапись.РасчетныйСчет = Выборка.Актив Тогда					   
							 НаборОстаткиДенежныхСредств.Удалить(ТекущаяЗапись);
							 НаборОстаткиДенежныхСредств.Записать();
						КонецЕсли;

