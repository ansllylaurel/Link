					Запись.ВариантДвиженияДенежныхСредств = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы;
				КонецЕсли;
				
			ИначеЕсли Найти(СтрокаАктив.ВидАктива, "Депозитные вклады") = 1 Тогда
				
				Запись = НаборДенежныеСредстваВКредитныхИнструментах.Добавить();
				Запись.КредитныйИнструмент = СтрокаАктив.Актив;
				Запись.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный;
				Запись.ТипКредитногоИнструмента = Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад;
				
			ИначеЕсли Найти(СтрокаАктив.ВидАктива, "ДолиПерестраховщиков") = 0 Тогда
				
				Запись = НаборОстаткиПрочихАктивов.Добавить();
				
			КонецЕсли;
			
			Запись.Период                       = Регистратор.Дата;
			Запись.Организация                  = Регистратор.Организация;
			Запись.СчетДоверительногоУправления = Регистратор.СчетДоверительногоУправления;
			
			ЗаполнитьЗначенияСвойств(Запись, СтрокаАктив);
			
			Запись.ВидДвижения = ?(Запись.Сумма < 0, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			Запись.Сумма       = ?(Запись.Сумма < 0, -Запись.Сумма, Запись.Сумма);
			
		КонецЦикла;
		
	КонецЦикла;
	
	НаборОстаткиДенежныхСредств.Записать();
	НаборОстаткиПрочихАктивов.Записать();
	НаборДенежныеСредстваВКредитныхИнструментах.Записать();
	
	ЗафиксироватьТранзакцию();
	
	ЗаполнитьОстаткиДенежныхСредствНаСервере();
	
КонецПроцедуры // СохранитьСуммыНаСервере

&НаКлиенте
Процедура ЗаполнитьОстаткиОстаткиДенежныхСредств()
	
	Перем КлючиРазвернутыхСтрок;
	
	Если ЭтаФорма.Модифицированность
		И Вопрос("Внесенные изменения будут безвозвратно утеряны. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
	
		ЭтаФорма.Период                       = ЭтаФорма.ПредПериод;
		ЭтаФорма.СчетДоверительногоУправления = ЭтаФорма.ПредСчетДоверительногоУправления;
	
		Возврат;
		
	КонецЕсли;
	
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств, "Ключ", КлючиРазвернутыхСтрок);
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ОстаткиДенежныхСредств, "Ключ");
	
	ЭтаФорма.ПредПериод                       = ЭтаФорма.Период;
	ЭтаФорма.ПредСчетДоверительногоУправления = ЭтаФорма.СчетДоверительногоУправления;
	
	ЗаполнитьОстаткиДенежныхСредствНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств, "Ключ", КлючиРазвернутыхСтрок);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств, "Ключ", КлючТекущейСтроки);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаКоманды.Видимость = Ложь; // временно, т.к. текущая отработка сложна
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Период      = ТекущаяДата();
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.ПредПериод                       = ЭтаФорма.Период;
	ЭтаФорма.ПредСчетДоверительногоУправления = ЭтаФорма.СчетДоверительногоУправления;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Период) И ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ЗаполнитьОстаткиОстаткиДенежныхСредств();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	РаботаСФормамиКлиент.ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка, Модифицированность);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "_ВводДенежныхСредствСтраховыхКомпаний.НовыйРасчетныйСчет" Тогда
		
		НовыйРасчетныйСчет = Параметр;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ЗаполнитьОстаткиОстаткиДенежныхСредств();
	ПроверитьДатуЗапретаРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ЗаполнитьОстаткиОстаткиДенежныхСредств();
	ПроверитьДатуЗапретаРедактирования(); 	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОстаткиДенежныхСредств.ТекущиеДанные;
	
	ТекущиеДанные.ИсходящийОстаток = ТекущиеДанные.ВходящийОстаток + ТекущиеДанные.Сумма;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствИсходящийОстатокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОстаткиДенежныхСредств.ТекущиеДанные;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.ИсходящийОстаток - ТекущиеДанные.ВходящийОстаток;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ЗаполнитьОстаткиОстаткиДенежныхСредств();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьСуммы(Команда)
	
		Перем КлючиРазвернутыхСтрок;

	Если НЕ ПроверитьДатыЗапретаРедактированияНаСервере() Тогда 		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя импортировать остатки - редактирование запрещено (см. дату запрета редактирования)");
		ЭтаФорма.Элементы.ФормаКомандаСохранить.Доступность = Ложь;
		Возврат;	
	КонецЕсли;
	                         	
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств, 
	"Ключ", КлючиРазвернутыхСтрок);
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ОстаткиДенежныхСредств, "Ключ");

	//СохранитьСуммыНаСервере();
	СохранитьИзмененияНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств,
	"Ключ", КлючиРазвернутыхСтрок);
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ОстаткиДенежныхСредств, Элементы.ОстаткиДенежныхСредств, "Ключ", КлючТекущейСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНовыйРасчетныйСчет(Команда)
	
	ЗначенияЗаполнения = Новый Структура("ЮрФизЛицо",
		ПолучитьКлиентаДоверительногоУправления(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления));
	
	ОткрытьФорму("Справочник.БанковскиеСчета.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьНовыйДепозитныйВклад(Команда)
	
	ЗначенияЗаполнения = Новый Структура("Владелец",
		ПолучитьКлиентаДоверительногоУправления(ЭтаФорма.Период, ЭтаФорма.СчетДоверительногоУправления));
	
	ОткрытьФорму("Справочник.ДепозитныеВклады.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрочиеРегистраторы(Команда)
	
	Отбор = Новый Структура("СчетДоверительногоУправления",
		ЭтаФорма.СчетДоверительногоУправления);
	
	ОткрытьФорму("Документ.КорректировкаРегистров.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСчетДУОснованияСовпадаетСДокументом(Организация, СчетДоверительногоУправления, Основание)
	
	Запрос = Новый Запрос;
    Запрос.Текст =
    	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
    	|	ВходящийДокумент.Ссылка КАК Ссылка
    	|ИЗ
    	|	Документ.ВходящийДокумент КАК ВходящийДокумент
    	|ГДЕ
    	|	ВходящийДокумент.Договоры.Договор = &СчетДоверительногоУправления
    	|	И ВходящийДокумент.Организация = &Организация
    	|	И ВходящийДокумент.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ссылка", Основание);    
	
	Если Запрос.Выполнить().Выбрать().Следующий() тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	 	
КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствПолеДокументОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ПроверитьСчетДУОснованияСовпадаетСДокументом( Организация, СчетДоверительногоУправления, ВыбранноеЗначение) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя выбрать документ в качестве основания. Не совпадают счета ДУ.");
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;             	
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствПолеДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
    ПараметрыОтбора = Новый Структура
		("ФильтрПоСчетуДоверительногоУправления, ФильтрПоДатеДокумента, ФильтрПоОрганизации", 
			СчетДоверительногоУправления, ЭтаФорма.Период, ЭтаФорма.Организация);
    ОткрытьФорму("Документ.ВходящийДокумент.Форма.ФормаВыбораДатаСчетДУ", ПараметрыОтбора, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиДенежныхСредствПолеДокументОснованиеПриИзменении(Элемент)
	
	// После выбора Основания для операции для всех позиций с известной суммой и тем же типом актива
	// нужно проставить то же основание
	ТекущиеДанные = Элементы.ОстаткиДенежныхСредств.ТекущиеДанные;

	Если ЗначениеЗаполнено(ТекущиеДанные.Основание) Тогда	
		
		Для Каждого Группа Из ОстаткиДенежныхСредств.ПолучитьЭлементы() Цикл
			Для Каждого Строка из Группа.ПолучитьЭлементы() Цикл
				Если Не ЗначениеЗаполнено(Строка.Основание) И 
					Строка.ВидАктива = ТекущиеДанные.ВидАктива
					И ЗначениеЗаполнено(Строка.Сумма) Тогда
					Строка.Основание = ТекущиеДанные.Основание;	
				КонецЕсли;		
			КонецЦикла;  
		КонецЦикла;
			
	КонецЕсли;

КонецПроцедуры

