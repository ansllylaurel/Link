		|			ПО ФинансовыеПоказателиСрезПоследних.СубъектАналитики = _ПредстоящиеОплаты.СчетДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ПорученияНаВывод КАК _ПорученияНаВывод
		|			ПО ФинансовыеПоказателиСрезПоследних.СубъектАналитики = _ПорученияНаВывод.СчетДоверительногоУправления
		|		ПО _СчетаДУФЛ.Ссылка = ФинансовыеПоказателиСрезПоследних.СубъектАналитики
		|ГДЕ
		|	НЕ ФинансовыеПоказателиСрезПоследних.СубъектАналитики ЕСТЬ NULL";
#КонецОбласти

	Если РегламентноеЗадание Тогда
		Запрос.Текст = Запрос.Текст + " И _ПорученияНаВывод.ДатаПорученияНаВывод ЕСТЬ NULL";
	КонецЕсли;

	Если ПараметрыОтчета.Управляющий <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " И _СчетаДУФЛ.Управляющий = &Управляющий";
		Запрос.УстановитьПараметр("Управляющий", ПараметрыОтчета.Управляющий);
	КонецЕсли;
	
	Если ПараметрыОтчета.УпорядочитьПо = 2 Тогда
	
		Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО КодУБрокера " + ?(ПараметрыОтчета.ПорядокВозрУбыв = 1, "ВОЗР", "УБЫВ");
		
	ИначеЕсли ПараметрыОтчета.УпорядочитьПо = 3 Тогда
		
		Если ПараметрыОтчета.ОтобразитьБиржевойРаздел = Истина Тогда
			Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО СуммаНаБиржеПроцентОтСЧА " + ?(ПараметрыОтчета.ПорядокВозрУбыв = 1, "ВОЗР", "УБЫВ")
		Иначе
			Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО СуммаУБрокераОбщаяПроцентОтСЧА " + ?(ПараметрыОтчета.ПорядокВозрУбыв = 1, "ВОЗР", "УБЫВ");
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоДня"  , НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("КонецДня"   , КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаТПлюс1" , Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ЭтотОбъект.Дата), 1));
	Запрос.УстановитьПараметр("ДатаТПлюс2" , Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ЭтотОбъект.Дата), 2));
	Запрос.УстановитьПараметр("Брокер"     , ЭтотОбъект.Брокер);
	Запрос.УстановитьПараметр("ММВБ_ТПлюс" , ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
	
	Запрос.УстановитьПараметр("НижняяГраницаОстатка" , ПараметрыОтчета.НижняяГраницаОстатка);
	Запрос.УстановитьПараметр("ВерхняяГраницаОстатка", ПараметрыОтчета.ВерхняяГраницаОстатка);
	Запрос.УстановитьПараметр("ПроцентОтСЧА"         , ПараметрыОтчета.ПроцентОтСЧА);
		
	ТаблицаДанных =  Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьДатуФормированияОтчета(ДеньНедели)
	
	//отчет рассылается по вторникам
	//если вторник - выходной, отчет рассылается в последний рабочий день до выходного и в первый рабочий день после выходного.
	//если вторник предпрадничный день, отчет рассылается еще в понедельник.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ВыходныеПредпраздничныеДатыОтчета
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДЕНЬНЕДЕЛИ(ДанныеКалендаря.Дата) = &ДеньНедели
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Суббота), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Воскресенье), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Праздник))
		|	И ДанныеКалендаря.Дата МЕЖДУ &МинусМесяц И &ПлюсМесяц
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеКалендаря.Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря1
		|		ПО (ДОБАВИТЬКДАТЕ(ДанныеКалендаря.Дата, ДЕНЬ, 1) = ДанныеКалендаря1.Дата)
		|			И (ДанныеКалендаря1.Календарь = &Календарь)
		|			И (ДанныеКалендаря1.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Суббота), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Воскресенье), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Праздник)))
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДЕНЬНЕДЕЛИ(ДанныеКалендаря.Дата) = &ДеньНедели
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И НЕ ДанныеКалендаря1.Дата ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК ДатаОтчетаФакт,
		|	ДанныеКалендаря.Дата КАК ДатаОтчетаПлан
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДЕНЬНЕДЕЛИ(ДанныеКалендаря.Дата) = &ДеньНедели
		|	И ДанныеКалендаря.Дата = &ТекущаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	МАКСИМУМ(ДанныеКалендаря.Дата),
		|	_ВыходныеПредпраздничныеДатыОтчета.Дата
		|ИЗ
		|	_ВыходныеПредпраздничныеДатыОтчета КАК _ВыходныеПредпраздничныеДатыОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО _ВыходныеПредпраздничныеДатыОтчета.Дата > ДанныеКалендаря.Дата
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВыходныеПредпраздничныеДатыОтчета.Дата
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) = &ТекущаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	МИНИМУМ(ДанныеКалендаря.Дата),
		|	_ВыходныеПредпраздничныеДатыОтчета.Дата
		|ИЗ
		|	_ВыходныеПредпраздничныеДатыОтчета КАК _ВыходныеПредпраздничныеДатыОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО _ВыходныеПредпраздничныеДатыОтчета.Дата < ДанныеКалендаря.Дата
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВыходныеПредпраздничныеДатыОтчета.Дата
		|
		|ИМЕЮЩИЕ
		|	МИНИМУМ(ДанныеКалендаря.Дата) = &ТекущаяДата";
	
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос.УстановитьПараметр("Календарь"  , Справочники.Календари.Общероссийский);
	Запрос.УстановитьПараметр("ДеньНедели" , ДеньНедели); // 2 - вторник
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.УстановитьПараметр("МинусМесяц" , ДобавитьМесяц(ТекущаяДата, -1));
	Запрос.УстановитьПараметр("ПлюсМесяц"  , ДобавитьМесяц(ТекущаяДата, 1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаОтчетаФакт;	
	Иначе
		Возврат Неопределено;	
	КонецЕсли;

КонецФункции

Процедура ОтправитьОповещение(ТабличныйДокумент)
	
	Вложения = Новый Соответствие;
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Вложения.Вставить("ОтчетКонтрольОстатков.xlsx", новый Файл(ИмяФайла));
	
	Письмо = Новый Структура("Текст, Вложения", "Отчет об остатках денежных средств клиентов (физ. лиц) на брокерских и расчетных счетах. Организация " + ЭтотОбъект.Организация + ". Информация во вложении.", Вложения);
		
	Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._КонтрольОстатковФЛ.СформироватьИОтправитьОтчет", Перечисления.ТипыСобытий.ВнешнийВызов, Письмо);
	
	УдалитьФайлы(ИмяФайла);
	
КонецПроцедуры //ОтправитьОповещение

