// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Контроль остатков ИИС",
		"0.12",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СформироватьИОтправитьОтчетРЭМ", "Формирование отчета для отправки (РЭМ).",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СформироватьИОтправитьОтчетТраст", "Формирование отчета для отправки (Траст).",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции //СведенияОВнешнейОбработке()

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
		
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	ПараметрыОтчета = Новый Структура();

	Если ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
		ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [Организация].");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКоманды.Брокер) Тогда
		ЭтотОбъект.Брокер = ПараметрыКоманды.Брокер;	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [Брокер].");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКоманды.ДеньНедели) Тогда
		ПараметрыОтчета.Вставить("ДеньНедели", ПараметрыКоманды.ДеньНедели); //параметр используется только на регламенте.	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [День недели]. Пн - 1, Вт - 2 и т.д.");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКоманды.НижняяГраницаОстатка) Тогда
		ПараметрыОтчета.Вставить("НижняяГраницаОстатка", ПараметрыКоманды.НижняяГраницаОстатка);	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [Нижняя граница остатка].");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКоманды.ВерхняяГраницаОстатка) Тогда
		ПараметрыОтчета.Вставить("ВерхняяГраницаОстатка", ПараметрыКоманды.ВерхняяГраницаОстатка);	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [Верхняя граница остатка].");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКоманды.ПроцентОтСЧА) Тогда
		ПараметрыОтчета.Вставить("ПроцентОтСЧА", ПараметрыКоманды.ПроцентОтСЧА);	
	Иначе
		ЗарегистрироватьОшибку("Для формирования и отправки отчета необходимо заполнить параметр команды [Процент от СЧА].");	
	КонецЕсли;
			
	Если СтрНайти(ИдентификаторКоманды, "СформироватьИОтправитьОтчет") = 0 Тогда 
		ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		СформироватьИОтправитьОтчет(ПараметрыОтчета);
	КонецЕсли;
		
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры // ВыполнитьКоманду

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры // ОповеститьОбОшибках

Процедура СформироватьИОтправитьОтчет(ПараметрыОтчета)
	
	ПараметрыОтчета.Вставить("Управляющий"             , Неопределено);
	ПараметрыОтчета.Вставить("УпорядочитьПо"           , 3);
	ПараметрыОтчета.Вставить("ПорядокВозрУбыв"         , 2);
	ПараметрыОтчета.Вставить("ОтобразитьБиржевойРаздел", Истина);
	
	ДатаОтчета = ПолучитьДатуФормированияОтчета(ПараметрыОтчета.ДеньНедели);  
	
	Если ДатаОтчета = Неопределено Тогда
		Возврат;
	Иначе
		ЭтотОбъект.Дата = ДатаОтчета;	
	КонецЕсли;
	
	//Открываем сессию
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,Брокер,Дата,ДеньНедели,НижняяГраницаОстатка,ВерхняяГраницаОстатка,ПроцентОтСЧА,Управляющий");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьИОтправитьОтчет()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТаблицаДанныхДляОтчета = СформироватьДанныеДляОтчета(ПараметрыОтчета, Истина);
	
	Если ТаблицаДанныхДляОтчета <> Неопределено И ТаблицаДанныхДляОтчета.Количество() > 0 Тогда
		
		ТаблДок = Новый ТабличныйДокумент;
		
		Макет = ЭтотОбъект.ПолучитьМакет("МакетОтчета");
			
		ТаблДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
		
		Для Каждого СтрокаДанных Из ТаблицаДанныхДляОтчета Цикл
			Область = Макет.ПолучитьОбласть("Строка");
			Область.Параметры.Заполнить(СтрокаДанных);
			ТаблДок.Вывести(Область);
		КонецЦикла;
		
		ОтправитьОповещение(ТаблДок);

	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры //СформироватьИОтправитьОтчет

Функция СформироватьДанныеДляОтчета(ПараметрыОтчета, РегламентноеЗадание = Ложь) Экспорт
		
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК Ссылка,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Наименование КАК Наименование,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаСмерти = ДАТАВРЕМЯ(1, 1, 1) КАК ФлЖив,
		|	ЕСТЬNULL(УправляющиеСчетовДоверительногоУправленияСрезПоследних.Управляющий, УправляющиеСтратегиямиСрезПоследних.Управляющий) КАК Управляющий
		|ПОМЕСТИТЬ _СчетаДУФЛ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецДня,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица))
		|				И СчетДоверительногоУправления.ДатаЗаключения <= &КонецДня
		|				И (СчетДоверительногоУправления.ДатаРасторжения >= &КонецДня
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&КонецДня, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УправляющиеСчетовДоверительногоУправления.СрезПоследних(
		|					&КонецДня,
		|					Организация = &Организация
		|						И СубъектАналитики ССЫЛКА Справочник.СтратегииИндивидуальногоИнвестирования) КАК УправляющиеСтратегиямиСрезПоследних
		|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = УправляющиеСтратегиямиСрезПоследних.СубъектАналитики
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УправляющиеСчетовДоверительногоУправления.СрезПоследних(
		|				&КонецДня,
		|				Организация = &Организация
		|					И СубъектАналитики ССЫЛКА Справочник.СчетаДоверительногоУправления) КАК УправляющиеСчетовДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = УправляющиеСчетовДоверительногоУправленияСрезПоследних.СубъектАналитики
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(&КонецДня, Организация = &Организация) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПоручениеНаДвижениеДенежныхСредств.Дата КАК ДатаПорученияНаВывод
		|ПОМЕСТИТЬ _ПорученияНаВывод
		|ИЗ
		|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
		|		ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = СписаниеЗадолженностейПоПоручению.Поручение
		|ГДЕ
		|	ПоручениеНаДвижениеДенежныхСредств.Организация = &Организация
		|	И ПоручениеНаДвижениеДенежныхСредств.Проведен
		|	И ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов = ИСТИНА
		|	И ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				СчетаДУФЛ.Ссылка
		|			ИЗ
		|				_СчетаДУФЛ КАК СчетаДУФЛ)
		|	И СписаниеЗадолженностейПоПоручению.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалютСрезПоследних.Валюта КАК Валюта,
		|	КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК Курс
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(&КонецДня, ) КАК КурсыВалютСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
