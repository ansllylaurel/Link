&НаКлиенте
Процедура ДатаИмпортаПриИзменении(Элемент)
	
	ТекДата = НачалоДня(ТекущаяДата());
	
	Если Объект.ДатаИмпорта > НачалоДня(ТекущаяДата()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата импорта [" + Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy") + "] не может быть больше текущей даты",, "Объект.ДатаИмпорта");
		Объект.ДатаИмпорта = Текдата;
	КонецЕсли; 
	
	Если Объект.ТипИсточника = 2 Тогда
		Объект.ДатаПараметров = Объект.ДатаИмпорта;	
	КонецЕсли;
		
	ЭтаФорма.Элементы.ДекорацияАрхив.Видимость = (Объект.ТипИсточника = 1 И Объект.ДатаИмпорта < ТекДата); 
	ЭтаФорма.Элементы.ДатаПараметров.Видимость = (Объект.ТипИсточника = 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИмпорта1ПриИзменении(Элемент)
	
	ТекДата = НачалоДня(ТекущаяДата());
	
	Если Объект.ДатаИмпорта > НачалоДня(ТекущаяДата()) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата сверки [" + Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy") + "] не может быть больше текущей даты",, "Объект.ДатаИмпорта");
		Объект.ДатаИмпорта = Текдата;
	КонецЕсли;
	
КонецПроцедуры
