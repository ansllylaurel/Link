
Функция ПолучитьРеквизитыЦенныхБумагНаСервере()
	
	НаименованияЦенныхБумаг = Новый Массив;
	
	Для НомСтр = 1 По ЭтаФорма.ТабличныйДокумент.ВысотаТаблицы Цикл
		НаименованиеЦБ = ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 1).Текст;
		Если Не ПустаяСтрока(НаименованиеЦБ) Или НаименованияЦенныхБумаг.Найти(НаименованиеЦБ) <> Неопределено Тогда
			НаименованияЦенныхБумаг.Добавить(НаименованиеЦБ);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Акции.Ссылка КАК ЦеннаяБумага,
		|	Акции.Наименование,
		|	Акции.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	Акции.Номинал,
		|	Акции.ГосударственныйРегистрационныйНомер КАК РегНомер
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.Наименование В(&Наименование)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка,
		|	Облигации.Наименование,
		|	Облигации.Эмитент.ЮрФизЛицо,
		|	0,
		|	Облигации.ГосударственныйРегистрационныйНомер
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.Наименование В(&Наименование)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага,
		|	_ЦенныеБумаги.Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Эмитент,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		|		ИНАЧЕ _ЦенныеБумаги.Номинал
		|	КОНЕЦ КАК Номинал,
		|	_ЦенныеБумаги.РегНомер,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ЦенныеБумаги.Эмитент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект";
		
	Запрос.УстановитьПараметр("Наименование", НаименованияЦенныхБумаг);
	Запрос.УстановитьПараметр("Период", ЭтаФорма.ДатаОтчета);
	
	РеквизитыЦенныхБумаг = Запрос.Выполнить().Выгрузить();
	
	Для НомСтр = 1 По ЭтаФорма.ТабличныйДокумент.ВысотаТаблицы Цикл
		НаименованиеЦБ = ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 1).Текст;
		
		СтрокаРеквизитыЦенныхБумаг = РеквизитыЦенныхБумаг.Найти(НаименованиеЦБ, "Наименование");
		Если СтрокаРеквизитыЦенныхБумаг <> Неопределено Тогда
			ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 2).Текст = СтрокаРеквизитыЦенныхБумаг.Эмитент;
			ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 3).Текст = СтрокаРеквизитыЦенныхБумаг.РегНомер;
			ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 4).Текст = СтрокаРеквизитыЦенныхБумаг.ISIN;
			ЭтаФорма.ТабличныйДокумент.Область(НомСтр, 5).Текст = СтрокаРеквизитыЦенныхБумаг.Номинал;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ПолучитьРеквизитыЦенныхБумаг

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаВыполнить");
	Попытка
		ПолучитьРеквизитыЦенныхБумагНаСервере();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчистить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОчистить");
	Попытка
		ЭтаФорма.ТабличныйДокумент.Очистить();
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.ДатаОтчета = ТекущаяДата();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
