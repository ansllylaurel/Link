&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	Если ЭтаФорма.СверкаЗаПериод Тогда
		
		ЭтаФорма.ДанныеСверкиЗаПериод.Очистить();

		Объект.ДатаИмпорта = ЭтаФорма.ПериодСверки.ДатаНачала;
		
		Пока Объект.ДатаИмпорта <= ЭтаФорма.ПериодСверки.ДатаОкончания Цикл
			
			ВыполнитьДействие(Команда);
			Объект.ДатаИмпорта = Объект.ДатаИмпорта + 86400;
			
		КонецЦикла;
		
		Объект.ДатаИмпорта = ЭтаФорма.ПериодСверки.ДатаНачала; //Вернем дате импорта начальное значение.
		
		Если ЭтаФорма.ПериодСверки.ДатаНачала <> НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
			СформироватьОтчетСверкиЗаПериод();
			Элементы.ДекорацияРасхожденияОтсутствуют.Видимость = ЭтаФорма.ДанныеСверкиЗаПериод.Количество() = 0;	
		КонецЕсли;
		
		Элементы.СтраницыРасхождения.Видимость       = (ЭтаФорма.ПериодСверки.ДатаНачала = НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания));
		Элементы.ГруппаОтчетСверкиЗаПериод.Видимость = (ЭтаФорма.ПериодСверки.ДатаНачала <> НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) И ЭтаФорма.ДанныеСверкиЗаПериод.Количество() > 0);
		
	Иначе
		ВыполнитьДействие(Команда);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	Если ЭтотОбъект.СверкаЗаПериод И ЭтотОбъект.ПериодСверки.ДатаНачала <> НачалоДня(ЭтотОбъект.ПериодСверки.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Команда [Импортировать] недоступна при заданном периоде. Импорт операций осуществляется только за один день.");//, ЭтотОбъект, "ПериодСверки");
		Возврат;
	КонецЕсли;
	
	ФлагНаличияДокументов = ПроверитьНаличиеДокументовДляУдаления();
	
	Если ЭтотОбъект.УдаляемыеДокументы.Количество() > 0 Тогда
		
		ПрерватьИмпорт = ОткрытьФормуМодально("ВнешняяОбработка._ИмпортОперацийБрокераБКРегион.Форма.УдаляемыеДокументы", Новый Структура("УдаляемыеДокументы", ЭтотОбъект.УдаляемыеДокументы));
		
		Если ПрерватьИмпорт = Неопределено Или ПрерватьИмпорт = Истина Тогда
			ЭтотОбъект.УдаляемыеДокументы.Очистить();
			Возврат;
		Иначе
			ВыполнитьДействие(Команда);
		КонецЕсли;
				
	Иначе
		
		ВыполнитьДействие(Команда);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьЗагрузкиПриИзменении(Элемент)
	
	Объект.КаталогФайловОТБР = ПолучитьКаталогФайловOTBR(Объект.Организация, ?(ЭтаФорма.СверкаЗаПериод, ЭтаФорма.ПериодСверки, Объект.ДатаИмпорта), Объект.ОчередьЗагрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветПользователя", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Получить данные из файлов OTBR?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

