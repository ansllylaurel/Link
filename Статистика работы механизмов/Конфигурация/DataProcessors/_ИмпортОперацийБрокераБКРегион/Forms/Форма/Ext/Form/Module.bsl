&НаКлиенте
Процедура ИзменитьВсеФлажкиТекущейТаблицы(ИмяТаблицы, Флаг)
	
	ПолныеПрава = ПраваПользователя();
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма[ИмяТаблицы] Цикл
		
		Если СтрокаТаблицы.Статус = "Отсутствует" Тогда // под полными правами отмечаем сразу все документы для удаления. 
			
			СтрокаТаблицы.Флаг = ?((ПолныеПрава Или Флаг = Ложь), Флаг, СтрокаТаблицы.Флаг);
			
		ИначеЕсли СтрокаТаблицы.Статус = "Ошибка чтения" Или СтрокаТаблицы.Статус = "Нет расхождений" Или СтрокаТаблицы.Статус = "Требуется ручной ввод" Тогда
			
			СтрокаТаблицы.Флаг = Ложь;
			
		Иначе
			
			СтрокаТаблицы.Флаг = Флаг;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВсеФлажки(Команда)
	
	ИмяТаблицы = СтрЗаменить(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя, "");
	ИзменитьВсеФлажкиТекущейТаблицы(ИмяТаблицы, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьВсеФлажки(Команда)
	
	ИмяТаблицы = СтрЗаменить(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя, "");
	ИзменитьВсеФлажкиТекущейТаблицы(ИмяТаблицы, Истина);
	
КонецПроцедуры 

&НаКлиенте
Функция ПроверитьНаличиеДокументовДляУдаления()
	
	ФлагНаличияДокументов = Ложь;
	Для Каждого Элемент Из ЭтаФорма.ОтображаемыеТаблицы Цикл
		
		Для Каждого СтрокаТаблицы  Из ЭтаФорма[Элемент.Значение] Цикл
			
			Если СтрокаТаблицы.Статус = "Отсутствует" Тогда
				
				ФлагНаличияДокументов = Истина;
				Если СтрокаТаблицы.Флаг = Истина Тогда
					ЭтаФорма.УдаляемыеДокументы.Добавить(СтрокаТаблицы.Ссылка);
				КонецЕсли;
				
			КонецЕсли;	

		КонецЦикла;
			
	КонецЦикла;
	Возврат ФлагНаличияДокументов;
	
КонецФункции
