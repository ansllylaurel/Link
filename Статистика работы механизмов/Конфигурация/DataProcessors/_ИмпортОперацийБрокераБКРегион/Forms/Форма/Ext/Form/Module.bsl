&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ОтображаемыеТаблицы.Добавить("БиржевыеСделки"          , "Бирж. сделки");
	ОтображаемыеТаблицы.Добавить("ИзмененияСделок"         , "Изм. сделок");
	ОтображаемыеТаблицы.Добавить("БиржевыеСделкиРЕПО1"     , "Бирж. сделки РЕПО #1");
	ОтображаемыеТаблицы.Добавить("БиржевыеСделкиРЕПО2"     , "Бирж. сделки РЕПО #2");
	ОтображаемыеТаблицы.Добавить("ИзмененияСделокРЕПО2"    , "Изм. сделок РЕПО #2");
	ОтображаемыеТаблицы.Добавить("ВнебиржевыеСделки"       , "Внебирж. сделки");
	ОтображаемыеТаблицы.Добавить("ВнебиржевыеСделкиРЕПО"   , "Внебирж. сделки РЕПО");
	ОтображаемыеТаблицы.Добавить("СделкиСВалютой"          , "Сделки с вал.");
	ОтображаемыеТаблицы.Добавить("ФорвардыПоставочные"     , "Форварды поставочные");
	ОтображаемыеТаблицы.Добавить("ИсполненияБиржевыхСделок", "Исполн. бирж. сделок");
	ОтображаемыеТаблицы.Добавить("НачисленияКомиссии"      , "Начисл. комиссии");
	ОтображаемыеТаблицы.Добавить("ОплатыКомиссии"          , "Оплаты комиссии");
	ОтображаемыеТаблицы.Добавить("ПоставкиЦенныхБумаг"     , "Поставки ц/б");
	ОтображаемыеТаблицы.Добавить("ОплатыВнебиржевыхСделок" , "Оплаты внеб. сделок");
	ОтображаемыеТаблицы.Добавить("ОплатыБиржевыхСделок"    , "Оплаты бирж. сделок");
	ОтображаемыеТаблицы.Добавить("ВариационнаяМаржа"       , "Вар. маржа");
	ОтображаемыеТаблицы.Добавить("ПереводыДенежныхСредств" , "Переводы д/с");
	ОтображаемыеТаблицы.Добавить("ОплатыПоПогашениям"      , "Оплаты по погашениям");
	ОтображаемыеТаблицы.Добавить("ОплатыПоВозвратуКупона"  , "Возвраты купона");
	ОтображаемыеТаблицы.Добавить("ОтменыСделок"            , "Отмены сделок");
	ОтображаемыеТаблицы.Добавить("СписанияЦенныхБумаг"     , "Списания ц/б");
	ОтображаемыеТаблицы.Добавить("СделкиСПФИ"              , "Сделки СПФИ");
	ОтображаемыеТаблицы.Добавить("МаржаСПФИ"               , "Маржа СПФИ");
		
	// заполним значения по умолчанию
	Если Не ЗначениеЗаполнено(Объект.ДатаИмпорта) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОбщероссийскогоКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _ТорговыеРабочиеДни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеОбщероссийскогоКалендаря
			|ГДЕ
			|	ДанныеОбщероссийскогоКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|	И ДанныеОбщероссийскогоКалендаря.Дата < &Дата
			|	И ДанныеОбщероссийскогоКалендаря.Дата > &МинусМесяц
			|	И ДанныеОбщероссийскогоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ДанныеКалендаряКотировок.Дата
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаряКотировок
			|ГДЕ
			|	ДанныеКалендаряКотировок.Календарь = &КалендарьКотировок
			|	И ДанныеКалендаряКотировок.Дата < &Дата
			|	И ДанныеКалендаряКотировок.Дата > &МинусМесяц
			|	И ДанныеКалендаряКотировок.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(_ТорговыеРабочиеДни.Дата) КАК ДатаИмпорта
			|ИЗ
			|	_ТорговыеРабочиеДни КАК _ТорговыеРабочиеДни";
	
		Запрос.УстановитьПараметр("Дата"              , НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("МинусМесяц"        , ДобавитьМесяц(ТекущаяДата(), -1));
		Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
		Результат = Запрос.Выполнить().Выгрузить();
			
		Объект.ДатаИмпорта = Результат[0].ДатаИмпорта; //ТекущаяДата() - 86400;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;
	
	ОбработатьОчередиЗагрузкиНаСервере();

	Если РольДоступна("ПолныеПрава") Тогда
		ЭтаФорма.ПериодСверки.ДатаНачала    = Объект.ДатаИмпорта;
		ЭтаФорма.ПериодСверки.ДатаОкончания = КонецДня(Объект.ДатаИмпорта);
	КонецЕсли;
	
	ЭтаФорма.СверкаЗаПериод              = РольДоступна("ПолныеПрава");
	ЭтаФорма.ОтображатьТолькоРасхождения = Истина;
	
	Элементы.ДекорацияРасхожденияОтсутствуют.Видимость = Ложь;
	Элементы.ГруппаОтчетСверкиЗаПериод.Видимость       = Ложь;
	Элементы.ПериодСверки.Видимость                    = ЭтаФорма.СверкаЗаПериод;
	Элементы.ДатаИмпорта.Видимость                     = Не ЭтаФорма.СверкаЗаПериод;

КонецПроцедуры

&НаСервере
Процедура ОбработатьОчередиЗагрузкиНаСервере()
		 
	ИмпортироватьИзНесколькихФайлов = РаботаСВнешнимиСистемами.ИмпортРазделенПоОчередям(Объект.Организация); 	
		
	Если ИмпортироватьИзНесколькихФайлов Тогда
		Объект.ОчередьЗагрузки = 2;
	Иначе
		Объект.ОчередьЗагрузки = 0;
	КонецЕсли;
	
	Элементы.ОчередьЗагрузки.Видимость = ИмпортироватьИзНесколькихФайлов;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДатаИмпортаПриИзменении(Неопределено);
		
