
&НаСервереБезКонтекста
Функция ПолучитьОбщийВерхнийУровень(Каталог1, Каталог2)
	
	ОбщийВерхнийУровень = "";
	Уровень = "";
	Пока Лев(Каталог1, 1) = Лев(Каталог2, 1) Цикл
		
		Уровень = Уровень + Лев(Каталог1, 1);
		
		Каталог1 = Сред(Каталог1, 2);
		Каталог2 = Сред(Каталог2, 2);
		
		Если Прав(Уровень, 1) = "\" Или Прав(Уровень, 1) = "/" Тогда
			ОбщийВерхнийУровень = ОбщийВерхнийУровень + Уровень;
			Уровень = "";
		КонецЕсли;
		
		Если Каталог1 = "" И Каталог2 = "" Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщийВерхнийУровень;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКаталогФайловOTBR(Организация, Период, ОчередьЗагрузки)
	
	Ключ = "КаталогЕжедневныхОтчетовБрокераРегион";

	Если ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда
		
		Если НачалоДня(Период.ДатаНачала) = НачалоДня(Период.ДатаОкончания) Тогда
			
			Если ОчередьЗагрузки > 0 Тогда
				
				МассивКаталогов = СтрРазделить(ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаНачала), Символ(0182));
			
				Если МассивКаталогов.Количество() = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить путь по ключу [КаталогЕжедневныхОтчетовБрокераРегион] для организации [" + Организация + "].");
					Возврат "";
				Иначе
					Возврат МассивКаталогов[ОчередьЗагрузки - 1];
				КонецЕсли;
				
			Иначе
				Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаНачала);
			КонецЕсли;
			
		Иначе
			
			Если ОчередьЗагрузки > 0 Тогда
				
				МассивКаталогов1 = СтрРазделить(ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаНачала), Символ(0182));
				МассивКаталогов2 = СтрРазделить(ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаОкончания), Символ(0182));
				
				Если МассивКаталогов1.Количество() = 0 Или МассивКаталогов2.Количество() = 0 Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить путь по ключу [КаталогЕжедневныхОтчетовБрокераРегион] для организации [" + Организация + "].");
					Возврат "";
					
				КонецЕсли;

				Возврат ПолучитьОбщийВерхнийУровень(МассивКаталогов1[ОчередьЗагрузки - 1], МассивКаталогов2[ОчередьЗагрузки - 1]);	
	
			Иначе

				Каталог1 = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаНачала);
				Каталог2 = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период.ДатаОкончания);
				
				Возврат ПолучитьОбщийВерхнийУровень(Каталог1, Каталог2);
				
			КонецЕсли;
		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Период) = Тип("Дата") Тогда
		
		Если ОчередьЗагрузки > 0 Тогда
			
			МассивКаталогов = СтрРазделить(ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период), Символ(0182));
			
			Если МассивКаталогов.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить путь по ключу [КаталогЕжедневныхОтчетовБрокераРегион] для организации [" + Организация + "].");
				Возврат "";
			Иначе
				Возврат МассивКаталогов[ОчередьЗагрузки - 1];
			КонецЕсли;
			
		Иначе
			Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки.ФайловаяСверкаСБрокеромБКРегион." + Ключ, Организация, Период);
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьТаблицыНаОснованииДанныхСФормы(Форма)
	
	ДанныеСФормы = Новый Структура();
	
	Для Каждого Элемент Из Форма.ОтображаемыеТаблицы Цикл
		
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("Ссылка");
		ТаблицаДанных.Колонки.Добавить("Описание");
		ТаблицаДанных.Колонки.Добавить("Статус");
		ТаблицаДанных.Колонки.Добавить("НовыеРеквизиты");
		ТаблицаДанных.Колонки.Добавить("ТекущиеРеквизиты");
		ТаблицаДанных.Колонки.Добавить("КодВоВнешнейСистеме");
		ТаблицаДанных.Колонки.Добавить("Флаг");
						
		Для Каждого Строка Из Форма[Элемент.Значение] Цикл
			
			Если Строка.Флаг = Истина Тогда
				
				НоваяСтрока                     = ТаблицаДанных.Добавить();
				НоваяСтрока.Ссылка              = Строка.Ссылка;
				НоваяСтрока.Описание            = Строка.Описание;
				НоваяСтрока.Статус              = Строка.Статус;
				НоваяСтрока.НовыеРеквизиты      = Строка.НовыеРеквизиты;
				НоваяСтрока.ТекущиеРеквизиты    = Строка.ТекущиеРеквизиты;
				НоваяСтрока.КодВоВнешнейСистеме = Строка.КодВоВнешнейСистеме;
				НоваяСтрока.Флаг                = Строка.Флаг;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТаблицаДанных.Количество() > 0 Тогда
			ДанныеСФормы.Вставить(Элемент.Значение, ТаблицаДанных);
		КонецЕСли;
		
	КонецЦикла;
	
	Возврат ДанныеСФормы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьОтображаемыеТаблицы(Форма)
	
	Для каждого Элемент Из Форма.ОтображаемыеТаблицы Цикл
		Форма[Элемент.Значение].Очистить();
		ЗаголовокТекст = Форма.Элементы["Страница" + Элемент.Значение].Заголовок;
		Форма.Элементы["Страница" + Элемент.Значение].Заголовок = ?(СтрНайти(ЗаголовокТекст, " (") > 0, Лев(ЗаголовокТекст, СтрНайти(ЗаголовокТекст, " (")), ЗаголовокТекст);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПраваПользователя()
	
	Возврат РольДоступна("ПолныеПрава");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаФормеНаСервере(ИмяТаблицы, Заголовок, ИмпортируемыеДанные, ДанныеСФормы)
	
	Если Не ИмпортируемыеДанные.Свойство(ИмяТаблицы) Или ТипЗнч(ИмпортируемыеДанные[ИмяТаблицы]) <> Тип("ТаблицаЗначений") Тогда
		Элементы["Страница" + ИмяТаблицы].Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	КоличествоРасхождений = 0;
	
	Если Объект.ОчередьЗагрузки <> 0 Тогда
		ВидыДоговоровТекущейОчереди = РаботаСВнешнимиСистемами.ПолучитьВидыДоговорДоверительногоУправленияДляОчереди(Объект.Организация, Объект.ОчередьЗагрузки);
	КонецЕсли;
		
	Для Каждого СтрокаИмпортирумыеДанные Из ИмпортируемыеДанные[ИмяТаблицы] Цикл
		
		Если СтрокаИмпортирумыеДанные.Статус = "Нет расхождений" И ЭтаФорма.ОтображатьТолькоРасхождения Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаИмпортирумыеДанные.Статус <> "Нет расхождений" Тогда
			КоличествоРасхождений = КоличествоРасхождений + 1;
		КонецЕсли;
		
		НоваяСтрокаТаблицыНаФорме = ЭтаФорма[ИмяТаблицы].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицыНаФорме, СтрокаИмпортирумыеДанные,, "НовыеРеквизиты, ТекущиеРеквизиты");
		
		НоваяСтрокаТаблицыНаФорме.НовыеРеквизиты      = Новый ХранилищеЗначения(СтрокаИмпортирумыеДанные.НовыеРеквизиты);
		НоваяСтрокаТаблицыНаФорме.ТекущиеРеквизиты    = Новый ХранилищеЗначения(СтрокаИмпортирумыеДанные.ТекущиеРеквизиты);
		НоваяСтрокаТаблицыНаФорме.КодВоВнешнейСистеме = Новый ХранилищеЗначения(СтрокаИмпортирумыеДанные.КодВоВнешнейСистеме);
		
		Если ТипЗнч(СтрокаИмпортирумыеДанные.ОшибкиЧтения) = Тип("Массив") Тогда
			НоваяСтрокаТаблицыНаФорме.ОшибкиЧтения.ЗагрузитьЗначения(СтрокаИмпортирумыеДанные.ОшибкиЧтения);
		КонецЕсли;
		
		НоваяСтрокаТаблицыНаФорме.ЕстьРасхождение = (НоваяСтрокаТаблицыНаФорме.Статус <> "Нет расхождений");
		
		Если СтрокаИмпортирумыеДанные.Статус = "Отсутствует" Или СтрокаИмпортирумыеДанные.Статус = "Ошибка чтения" Или СтрокаИмпортирумыеДанные.Статус = "Нет расхождений" Или СтрокаИмпортирумыеДанные.Статус = "Требуется ручной ввод"  Тогда 
			НоваяСтрокаТаблицыНаФорме.Флаг = Ложь;
		Иначе
			
			Если ДанныеСФормы <> Неопределено И ДанныеСФормы.Свойство(ИмяТаблицы) Тогда
				СтрокаДанныхСФормы = ДанныеСФормы[ИмяТаблицы].Найти(СтрокаИмпортирумыеДанные.Описание, "Описание");
				Если СтрокаДанныхСФормы <> Неопределено Тогда
					НоваяСтрокаТаблицыНаФорме.Флаг = СтрокаДанныхСФормы.Флаг;
				КонецЕсли;
			Иначе
				НоваяСтрокаТаблицыНаФорме.Флаг = Истина;
			КонецЕсли;
			
		КонецЕсли;
			
		Если Объект.ОчередьЗагрузки <> 0 
			И СтрокаИмпортирумыеДанные.Статус = "Новый" И СтрокаИмпортирумыеДанные.СчетДоверительногоУправления <> Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
			Если ВидыДоговоровТекущейОчереди.Найти(СтрокаИмпортирумыеДанные.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У документа " + СтрокаИмпортирумыеДанные.Описание + " отличается вид договора счета ДУ от выбранного.");
				НоваяСтрокаТаблицыНаФорме.Флаг = Ложь;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	
	Если КоличествоРасхождений = 0 И ЭтаФорма.ОтображатьТолькоРасхождения Тогда
		Элементы["Страница" + ИмяТаблицы].Видимость = Ложь;
	Иначе
		Элементы["Страница" + ИмяТаблицы].Видимость = Истина;
		
		Если ЭтаФорма.ОтображатьТолькоРасхождения Тогда
			Элементы["Страница" + ИмяТаблицы].Заголовок = Заголовок + " (" + КоличествоРасхождений + ")";
		Иначе
			Элементы["Страница" + ИмяТаблицы].Заголовок = Заголовок + " (" + КоличествоРасхождений + "/" + ЭтаФорма[ИмяТаблицы].Количество() + ")";
		КонецЕсли;
		
		ЭтаФорма[ИмяТаблицы].Сортировать("ЕстьРасхождение УБЫВ");
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействиеНаСервере()
	
	Механизм = "_ИмпортОперацийБрокераБКРегион." + ?(Объект.РежимИмпорта = 1, "КомандаОбновить()", "КомандаИмпортировать()");
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Объект, "Организация, ДатаИмпорта, РежимИмпорта, ОчередьЗагрузки");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Объект.ДополнительныеСвойства.Удалить("Ошибки");
	
	Если Объект.РежимИмпорта = 2 Тогда
		СтруктураДанныеСФормы = СформироватьТаблицыНаОснованииДанныхСФормы(ЭтаФорма);	
	КонецЕсли;
	
	ОчиститьОтображаемыеТаблицы(ЭтаФорма);
				
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектНаСервере.ЗагружатьКонтрагентаПоВнебиржевымСделкам = ОбъектНаСервере.ОпределитьЗагрузкуКонтрагентаПоВнебиржевымСделкам(ОбъектНаСервере.Организация);
	
	ТаблицаФайловРЕПО_М = ЭтаФорма.ФайлыИмпорта.Выгрузить(Новый Структура("ТипФайла", ".xlsx"));
	ТаблицаСделокРЕПО_М = ОбъектНаСервере.ИмпортироватьТаблицуСделокРЕПО_М(ТаблицаФайловРЕПО_М);
	
	ТаблицаФайловИмпортаXML = ЭтаФорма.ФайлыИмпорта.Выгрузить(Новый Структура("ТипФайла", ".xml"));
	
	Если Не ОбъектНаСервере.ФайлИмпортаСоответствуетСхемеXSD(ТаблицаФайловИмпортаXML, "Схема_OTBR") Тогда
		Возврат;	
	КонецЕсли;

	ИмпортируемыеДанные = ОбъектНаСервере.ИмпортироватьИзXMLФайлов_ФорматOTBR(ТаблицаФайловИмпортаXML, ТаблицаСделокРЕПО_М, СтруктураДанныеСФормы);
	
	ЭтаФорма.ФайлыИмпорта.Очистить();
		
	Если ТипЗнч(ИмпортируемыеДанные) = Тип("Структура") Тогда
		
		Если Объект.РежимИмпорта = 1 И ЭтаФорма.СверкаЗаПериод И ЭтаФорма.ПериодСверки.ДатаНачала <> НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
			
			Расхождения = Ложь;
			Для Каждого Таблица Из ИмпортируемыеДанные Цикл
				
				Если Расхождения = Истина Тогда
					Прервать;
				КонецЕсли;
				
				Для Каждого СтрокаТаблицы Из Таблица.Значение Цикл
					
					Если СтрокаТаблицы.Статус <> "Нет расхождений" Тогда
						
						Расхождения = Истина;
						
						НоваяСтрока = ЭтаФорма.ДанныеСверкиЗаПериод.Добавить();
						НоваяСтрока.ДатаСверки = Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy");
						НоваяСтрока.ЕстьРасхождения = Истина;
						Прервать;
							
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
			Возврат;
			
		Иначе
		
			Для Каждого Элемент Из ЭтаФорма.ОтображаемыеТаблицы Цикл
				ЗаполнитьТаблицуНаФормеНаСервере(Элемент.Значение, Элемент.Представление, ИмпортируемыеДанные, СтруктураДанныеСФормы);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// отобразим гламурную надпись, если нет расхождений
	Если ЭтаФорма.ОтображатьТолькоРасхождения Тогда
		
		ЕстьРасхождения = Ложь;
		
		Для Каждого Элемент Из Элементы.СтраницыРасхождения.ПодчиненныеЭлементы Цикл
			Если Элемент.Видимость Тогда
				ЕстьРасхождения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Элементы.ДекорацияРасхожденияОтсутствуют.Видимость = Не ЕстьРасхождения;
		
	Иначе
		Элементы.ДекорацияРасхожденияОтсутствуют.Видимость = Ложь;	
	КонецЕсли;
	
	Если Объект.РежимИмпорта = 2 Тогда // поиск и устранение расхождений
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Импорт данных завершен");
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетСверкиЗаПериод()
	
	ЭтаФорма.ОтчетСверкиЗаПериод.Очистить();
	
	Если ЭтаФорма.ДанныеСверкиЗаПериод.Количество() > 0 Тогда
			
		СтруктураТаблицы = Новый Структура("ДатаСверки, ЕстьРасхождения", "Дата", "Есть расхождения");
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Отчет за период " + Формат(ЭтаФорма.ПериодСверки.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ПериодСверки.ДатаОкончания, "ДФ=dd.MM.yyyy") + " г.", , , ЭтаФорма.ОтчетСверкиЗаПериод);
		
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ЭтаФорма.ДанныеСверкиЗаПериод, СтруктураТаблицы,, Ложь, Истина);
								
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
				
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеФайловНаСервере(ПутьКФайламOTBR)
	
	ФайлыКаталога = НайтиФайлы(ПутьКФайламOTBR, "*", Истина);
		
	Для Каждого Файл Из ФайлыКаталога Цикл
		
		ПодстрокаПериод = Формат(Объект.ДатаИмпорта, "ДФ=дд.ММ.гг") + "_-_" + Формат(Объект.ДатаИмпорта, "ДФ=дд.ММ.гг");
		
		Если (Лев(Файл.Имя, 32) = "BrokerReport_" + ПодстрокаПериод И Прав(Файл.Имя, 4) = ".xml") //BrokerReport
			Или (Лев(Файл.Имя, 37) = "BrokerReportREPOM_" + ПодстрокаПериод И Прав(Файл.Имя, 5) = ".xlsx" ) Тогда //BrokerReportREPOM_
			НоваяСтрока = Этаформа.ФайлыИмпорта.Добавить();
			НоваяСтрока.ИмяФайла    = Файл.Имя;
			НоваяСтрока.ТипФайла	= файл.Расширение;
			НоваяСтрока.ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатийНаГиперссылку(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИмяТаблицы    = Элемент.Имя;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если       Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "Ссылка" Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
				ОткрытьЗначение(ТекущиеДанные.Ссылка);
			КонецЕсли;
			
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "Статус" Тогда
			
			Если ТекущиеДанные.Статус = "Ошибка чтения" Тогда
				Для каждого ЭлементСписка Из ТекущиеДанные.ОшибкиЧтения Цикл
					Сообщить(РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(ЭлементСписка.Значение, ТекущиеДанные.Описание));
				КонецЦикла;
				
			ИначеЕсли ТекущиеДанные.Статус = "Требуется ручной ввод" Тогда
				СообщениеТекст = "";
				Для каждого ЭлементСписка Из ТекущиеДанные.ОшибкиЧтения Цикл
					СообщениеТекст = СообщениеТекст + РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(ЭлементСписка.Значение, ТекущиеДанные.Описание);
				КонецЦикла;
				
				ОткрытьЗначение(ТекущиеДанные.Ссылка);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеТекст, ТекущиеДанные.Ссылка);

			Иначе
				ОбновленныеДанные = ОткрытьФормуМодально("ВнешняяОбработка._ИмпортОперацийБрокераБКРегион.Форма.Расхождения",
					Новый Структура("Организация, ДатаИмпорта, НовыеРеквизиты, ТекущиеРеквизиты, ОтображатьТолькоРасхождения",
						Объект.Организация,
						Объект.ДатаИмпорта,
						ТекущиеДанные.НовыеРеквизиты,
						ТекущиеДанные.ТекущиеРеквизиты,
						(ТекущиеДанные.Статус <> "Нет расхождений")));
						
				Если ОбновленныеДанные <> Неопределено Тогда
					ТекущиеДанные.НовыеРеквизиты = ОбновленныеДанные.НовыеРеквизиты;
				КонецЕсли;
			КонецЕсли;
				
		ИначеЕсли Элемент.ТекуЩийЭлемент.Имя = ИмяТаблицы + "Флаг" Тогда
			
			Если ТекущиеДанные.Статус = "Нет расхождений" Или ТекущиеДанные.Статус = "Ошибка чтения" Или ТекущиеДанные.Статус = "Требуется ручной ввод" Тогда
				ТекущиеДанные.Флаг = Ложь;
			Иначе
				ТекущиеДанные.Флаг = Не ТекущиеДанные.Флаг;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Отказ = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.УдаляемыеДокументы.Очистить();
	ЭтаФорма.ФайлыИмпорта.Очистить();
			
	Если Команда = ЭтаФорма.Команды.КомандаИмпортировать Тогда
		Объект.РежимИмпорта = 2; // поиск и устранение расхождений
	Иначе
		Объект.РежимИмпорта = 1; // только поиск расхождений
	КонецЕсли;
		
	Если ЭтаФорма.СверкаЗаПериод И ЭтаФорма.ПериодСверки.ДатаНачала <> НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания) Тогда
		ПутьКФайламOTBR = ПолучитьКаталогФайловOTBR(Объект.Организация, Объект.ДатаИмпорта, Объект.ОчередьЗагрузки);
	Иначе
		ПутьКФайламOTBR = Объект.КаталогФайловОТБР;
	КонецЕсли;
	
	ПолучитьДанныеФайловНаСервере(ПутьКФайламOTBR);
				
	Если ЭтаФорма.ФайлыИмпорта.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В папке [" + Объект.КаталогФайловОТБР + "] отсутствуют файлы за период [" + Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy")  + "]. Или наименования файлов не соостветствуют формату [BrokerReport_ДД.ММ.ГГ_-_ДД.ММ.ГГ_КодКлиента.xml]");
		Возврат;
	КонецЕсли;
		
	ВыполнитьДействиеНаСервере();
			
КонецПроцедуры

