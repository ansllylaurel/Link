	//Объект.ИмяФайлаДанных = "\\am-1c00\Арчи\Data\MX_Operations_2018-12-05_2018-12-05.xml";
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если РольДоступна("ПолныеПрава") Тогда
		ПроверяемыеРеквизиты.Добавить("ПериодСверки");
	КонецЕсли;
	
	Если ЭтаФорма.ПериодСверки.ДатаНачала > ЭтаФорма.ПериодСверки.ДатаОкончания Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректно указан период сверки", ЭтаФорма, "ПериодСверки",, Отказ);	
	КонецЕсли;
	
КонецПроцедуры

