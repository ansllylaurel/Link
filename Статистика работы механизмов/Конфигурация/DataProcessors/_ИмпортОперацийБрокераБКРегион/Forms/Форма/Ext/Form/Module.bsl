&НаКлиенте
Процедура ПоказатьВопросИПолучитьКаталогФайловOTBR(Организация, Период)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос("Изменить путь к каталогу с файлами?", Режим, 0);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	//Объект.КаталогФайловОТБР = ПолучитьКаталогФайловOTBR(Организация, Период);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбработатьОчередиЗагрузкиНаСервере();
	
	Объект.КаталогФайловОТБР = ПолучитьКаталогФайловOTBR(Объект.Организация, ?(ЭтаФорма.СверкаЗаПериод, ЭтаФорма.ПериодСверки, Объект.ДатаИмпорта), Объект.ОчередьЗагрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветПользователя", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Получить данные из файлов OTBR?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаИмпортаПриИзменении(Элемент)
	
	Объект.КаталогФайловОТБР = ПолучитьКаталогФайловOTBR(Объект.Организация, Объект.ДатаИмпорта, Объект.ОчередьЗагрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветПользователя", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Получить данные из файлов OTBR?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСверкиПриИзменении(Элемент)
	
	Объект.КаталогФайловОТБР = ПолучитьКаталогФайловOTBR(Объект.Организация, ЭтаФорма.ПериодСверки, Объект.ОчередьЗагрузки);
		
	Элементы.ОтображатьТолькоРасхождения.Доступность = (ЭтаФорма.ПериодСверки.ДатаНачала = НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания));
	ЭтаФорма.ОтображатьТолькоРасхождения = ?(ЭтаФорма.ПериодСверки.ДатаНачала <> НачалоДня(ЭтаФорма.ПериодСверки.ДатаОкончания), Истина, ЭтаФорма.ОтображатьТолькоРасхождения); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветПользователя", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, "Получить данные из файлов OTBR?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтображатьТолькоРасхожденияПриИзменении(Элемент)
	
