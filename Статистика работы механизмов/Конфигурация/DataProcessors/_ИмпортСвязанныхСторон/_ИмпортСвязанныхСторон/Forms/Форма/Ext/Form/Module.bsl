
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
	РазвертываниеУзлов();
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Дата=ТекущаяДата();
	ЗаполнениеТабличнойЧастиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТабличнойЧастиНаСервере()

	Запрос = Новый Запрос;

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _БанкДС
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&Период, Организация = &Организация) КАК ОстаткиДенежныхСредствОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ПО БанковскиеСчета.Банк = Банки.Ссылка
		|		ПО ОстаткиДенежныхСредствОстатки.РасчетныйСчет = БанковскиеСчета.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _БанкДВ
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|				ПО БанковскиеСчета.Банк = Банки.Ссылка
		|			ПО ДепозитныеВклады.БанковскийСчет = БанковскиеСчета.Ссылка
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЦеннаяБумага
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(&Период, Организация = &Организация) КАК БухПартииЦенныхБумагОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦеннаяБумага.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _ЦеннаяБумагаЦБ
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО Акции.Эмитент = Эмитенты.Ссылка
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.Акции)) = Акции.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО Облигации.Эмитент = Эмитенты.Ссылка
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.Облигации)) = Облигации.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО Векселя.Эмитент = Эмитенты.Ссылка
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.Векселя)) = Векселя.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Закладные КАК Закладные
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Эмитенты
		|			ПО (Закладные.Банк = Закладные.Банк.Ссылка)
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.Закладные)) = Закладные.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО ИпотечныеСертификатыУчастия.Эмитент = Эмитенты.Ссылка
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия)) = ИпотечныеСертификатыУчастия.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЦеннаяБумага.СчетДоверительногоУправления,
		|	Эмитенты.ЮрФизЛицо
		|ИЗ
		|	_ЦеннаяБумага КАК _ЦеннаяБумага
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО ДепозитарныеРасписки.Эмитент = Эмитенты.Ссылка
		|		ПО ((ВЫРАЗИТЬ(_ЦеннаяБумага.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки)) = ДепозитарныеРасписки.Ссылка)
		|ГДЕ
		|	_ЦеннаяБумага.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Банки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _Банки
		|ИЗ
		|	(ВЫБРАТЬ
		|		_БанкДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_БанкДС.ЮрФизЛицо КАК ЮрФизЛицо
		|	ИЗ
		|		_БанкДС КАК _БанкДС
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_БанкДВ.СчетДоверительногоУправления,
		|		_БанкДВ.ЮрФизЛицо
		|	ИЗ
		|		_БанкДВ КАК _БанкДВ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ЦеннаяБумагаЦБ.СчетДоверительногоУправления,
		|		_ЦеннаяБумагаЦБ.ЮрФизЛицо
		|	ИЗ
		|		_ЦеннаяБумагаЦБ КАК _ЦеннаяБумагаЦБ) КАК Банки
		|
		|СГРУППИРОВАТЬ ПО
		|	Банки.СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления) КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка
		|ГДЕ
		|	ДополнительныеСведения.Код = ""000000014""
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Банки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	_Банки.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЕСТЬNULL(СвязанныеСтороныСрезПоследних.Связанные, ЛОЖЬ) КАК СвязаннаяСторона,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СвязанныеСтороныСрезПоследних.Связанные, -2) = -2
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ НЕ ЕСТЬNULL(СвязанныеСтороныСрезПоследних.Связанные, ЛОЖЬ)
		|	КОНЕЦ КАК НеСвязаннаяСторона,
		|	ЕСТЬNULL(СвязанныеСтороныСрезПоследних.Связанные, -1) КАК НовыйКонтрагент,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчетДУ
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Банки КАК _Банки
		|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = _Банки.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетДоверительногоУправления КАК _СчетДоверительногоУправления
		|		ПО (_СчетДоверительногоУправления.СчетДоверительногоУправления = _Банки.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО (_Банки.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеСтороны.СрезПоследних(&Период, Организация = &Организация) КАК СвязанныеСтороныСрезПоследних
		|		ПО (СвязанныеСтороныСрезПоследних.СчетДоверительногоУправления = _Банки.СчетДоверительногоУправления)
		|			И (СвязанныеСтороныСрезПоследних.Контрагент = _Банки.ЮрФизЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_Банки.СчетДоверительногоУправления,
		|	СокращенноеНаименование
		|ИТОГИ ПО
		|	СчетДоверительногоУправления";
		
		
		
		
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("Период",                       КонецДня(?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата())));
	
	ВыборкаГруппа = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЭтаФорма.ДеревоЗначений.ПолучитьЭлементы().Очистить();
	
	Пока ВыборкаГруппа.Следующий() Цикл
		
		НоваяСтрокаГруппа = ЭтаФорма.ДеревоЗначений.ПолучитьЭлементы().Добавить();

		НоваяСтрокаГруппа.Ключ = ВыборкаГруппа.СчетДоверительногоУправления;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаГруппа, ВыборкаГруппа);

		НоваяСтрокаГруппа.Узел=Истина;
		
		Выборка = ВыборкаГруппа.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = НоваяСтрокаГруппа.ПолучитьЭлементы().Добавить();
			
			НоваяСтрока.Ключ = Выборка.ЮрФизЛицо;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			НоваяСтрока.СвязаннаяСторона=Выборка.СвязаннаяСторона;
			
			НоваяСтрока.НеСвязаннаяСторона=Выборка.НеСвязаннаяСторона;
			
			НоваяСтрока.ИНН=Выборка.ИНН;
			
			Если Выборка.НовыйКонтрагент=-1 Тогда
				НоваяСтрокаГруппа.РазвернутьУзел=Истина;
			КонецЕсли;
			Если НоваяСтрокаГруппа.КодСчетДУ="" Тогда
				НоваяСтрокаГруппа.КодСчетДУ=Выборка.КодСчетДУ;
			КонецЕсли;
			        
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеСтороныПередНачаломИзменения(Элемент, Отказ)
	Если ТипЗнч(Элементы.СвязанныеСтороны.ТекущиеДанные.Ключ) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Отказ=Истина;
	Иначе
		Если 	Элементы.СвязанныеСтороны.ТекущийЭлемент<>Элементы.СвязанныеСтороныСвязаннаяСторона 
				И
				Элементы.СвязанныеСтороны.ТекущийЭлемент<>Элементы.СвязанныеСтороныНеСвязаннаяСторона Тогда
			Отказ=Истина;
		  Иначе
			  	Если Элементы.СвязанныеСтороны.ТекущийЭлемент=Элементы.СвязанныеСтороныСвязаннаяСторона Тогда
				  	Если  Элементы.СвязанныеСтороны.ТекущиеДанные.СвязаннаяСторона=Ложь Тогда
					  	Элементы.СвязанныеСтороны.ТекущиеДанные.НеСвязаннаяСторона=Ложь
					КонецЕсли;
				КонецЕсли;
				Если Элементы.СвязанныеСтороны.ТекущийЭлемент=Элементы.СвязанныеСтороныНеСвязаннаяСторона Тогда
				  	Если  Элементы.СвязанныеСтороны.ТекущиеДанные.НеСвязаннаяСторона=Ложь Тогда
					  	Элементы.СвязанныеСтороны.ТекущиеДанные.СвязаннаяСторона=Ложь
				  	КонецЕсли;
			  КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеНаСервере()
	//Проверка
	КоличествоПроблем=0;
	Для Каждого СтрокаГруппа Из ЭтаФорма.ДеревоЗначений.ПолучитьЭлементы() Цикл
		Для Каждого Строка Из СтрокаГруппа.ПолучитьЭлементы() Цикл
			Если Строка.СвязаннаяСторона=Строка.НеСвязаннаяСторона Тогда
				КоличествоПроблем=КоличествоПроблем+1;
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Незаполненная позиция", ЭтаФорма, "СвязанныеСтороны[1].СвязаннаяСторона", "СвязаннаяСторона");
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сообщение к реквизиту формы №1 таб.ч. формы ТчФ1 на закладке ТчФ1",, "ТчФ1[1].Реквизит1");
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("55555",, "СвязанныеСтороны[1].СвязанныеСтороныСвязаннаяСторона");
			КонецЕсли;
		КонецЦикла;					
	КонецЦикла;
	Если КоличествоПроблем>0 Тогда
		 Сообщить("Количество неопределенных позиций - "+Строка(КоличествоПроблем));
		Возврат;
	КонецЕсли;
	Набор = РегистрыСведений.СвязанныеСтороны.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Объект.Дата);
	Набор.Прочитать();
	Набор.Очистить();
	Для Каждого СтрокаГруппа Из ЭтаФорма.ДеревоЗначений.ПолучитьЭлементы() Цикл
		Для Каждого Строка Из СтрокаГруппа.ПолучитьЭлементы() Цикл
			Запись = Набор.Добавить();
			Запись.Период=Объект.Дата;
			Запись.Организация=Объект.Организация;
			Запись.СчетДоверительногоУправления=Строка.СчетДоверительногоУправления;
			Запись.Контрагент=Строка.Ключ;
			Запись.Связанные=Строка.СвязаннаяСторона;
		КонецЦикла;					
	КонецЦикла;			
	Набор.Записать();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанные(Команда)
	СохранитьДанныеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеИЗакрыть(Команда)
	СохранитьДанныеНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ЗаполнениеТабличнойЧастиНаСервере();
	РазвертываниеУзлов();
КонецПроцедуры

&НаКлиенте
Процедура РазвертываниеУзлов()

	Выгрузка=ДеревоЗначений.ПолучитьЭлементы();

	Для Каждого Строка Из Выгрузка Цикл
		Если Строка.РазвернутьУзел Тогда
			ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
			Элементы.СвязанныеСтороны.Развернуть(ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеИзФайла(Команда)
	Логирование = Новый Массив;
	СписокЛистов = Новый Массив;
	
	ТаблицаИмпорта.Очистить();
	ТаблицаИмпортаШапка.Очистить();

	КаталогСтрока=СокрЛП(Строка(Объект.Папка));
	Если Прав(КаталогСтрока,1)<>"\" Тогда
		 КаталогСтрока=КаталогСтрока+"\";
	КонецЕсли;

	Каталог = Новый Файл(КаталогСтрока);
	   
	Если Каталог.Существует() Тогда
		Выгрузка=ДеревоЗначений.ПолучитьЭлементы();
		СчетчикФайловТекущий=1;
		СчетчикФайловИтого=Выгрузка.Количество();
		Для Каждого Строка Из Выгрузка Цикл
			ФайлСтрока=СтрЗаменить(Строка.КодСчетДУ,"/","")+".xls";
			ФайлПроверка=Новый Файл(КаталогСтрока+ФайлСтрока);
			Состояние("Обработка файла ("+Строка(СчетчикФайловТекущий)+" из "+Строка(СчетчикФайловИтого)+") - "+ФайлСтрока);
			Если ФайлПроверка.Существует() Тогда
				СписокЛистов.Очистить();
				Попытка
					Excel = Новый COMОбъект("Excel.Application");
					//Excel.WindowState = -4140;
					//Excel.Visible = True;
					WorkBooks=Excel.WorkBooks.Open(КаталогСтрока+ФайлСтрока);
					Для СчетчикСтраниц=1 По WorkBooks.Worksheets.Count Цикл
						ЭтоДата=Истина;
						Попытка
							ДатаСтрока=WorkBooks.Worksheets(СчетчикСтраниц).Name;
							ДатаЛиста=Дата(ПреобразованиеДатаСтрока(ДатаСтрока));
						Исключение
							ЭтоДата=Ложь;
						КонецПопытки;
						Если ЭтоДата Тогда
							СписокЛистов.Добавить(WorkBooks.Worksheets(СчетчикСтраниц).Name);
						КонецЕсли;
					КонецЦикла;
					Если СписокЛистов.Количество()>0 Тогда
						//Отсортируем дату по возрастанию
						Для СчетчикЛистов=1 По СписокЛистов.Количество()-1 Цикл
							Для СчетчикИтерраций=0 По СписокЛистов.Количество()-СчетчикЛистов-1 Цикл
								Если ПреобразованиеДатаСтрока(СписокЛистов[СчетчикИтерраций])>ПреобразованиеДатаСтрока(СписокЛистов[СчетчикИтерраций+1]) Тогда
									СписокЛистовВрем=СписокЛистов[СчетчикИтерраций];
									СписокЛистов[СчетчикИтерраций]=СписокЛистов[СчетчикИтерраций+1];
									СписокЛистов[СчетчикИтерраций+1]=СписокЛистовВрем;
								КонецЕсли;
							КонецЦикла;
						КонецЦикла;

						//Найдем для текущей даты две ближайшие даты в файле
						ДатаКонтроляТекущая=Дата(1, 1, 1);
						ДатаКонтроляПредыдущая=Дата(1, 1, 1);
						Для СчетчикЛистов=0 По СписокЛистов.Количество()-1  Цикл
							Если Объект.Дата>=Дата(ПреобразованиеДатаСтрока(СписокЛистов[СписокЛистов.Количество()-1-СчетчикЛистов])) Тогда
								Если ДатаКонтроляТекущая=Дата(1, 1, 1) Тогда
									ДатаКонтроляТекущая=Дата(ПреобразованиеДатаСтрока(СписокЛистов[СписокЛистов.Количество()-1-СчетчикЛистов]));
								Иначе
									Если ДатаКонтроляПредыдущая=Дата(1, 1, 1) Тогда
										ДатаКонтроляПредыдущая=Дата(ПреобразованиеДатаСтрока(СписокЛистов[СписокЛистов.Количество()-1-СчетчикЛистов]));
									Иначе
										Прервать;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
						СтрокаИмпортаШапка = ТаблицаИмпортаШапка.Добавить();
						СтрокаИмпортаШапка.КодСчетДУ=Строка.КодСчетДУ;
						СтрокаИмпортаШапка.ДатаКонтроляТекущая=ДатаКонтроляТекущая;
						СтрокаИмпортаШапка.ДатаКонтроляПредыдущая=ДатаКонтроляПредыдущая;
						СтрокаИмпортаШапка.СчетДоверительногоУправления=Строка.СчетДоверительногоУправления;

						//Загрузим данные для двух ближайших дат
						Если ДатаКонтроляТекущая<>Дата(1, 1, 1) Тогда
							СчетчикСтрок=1;
							Данные=WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляТекущая),1,10)).Cells(СчетчикСтрок,1).Value;
							Пока Данные<>"" И Данные<>Неопределено Цикл
								СтрокаИмпорта = ТаблицаИмпорта.Добавить();
								СтрокаИмпорта.КодСчетДУ=Строка.КодСчетДУ;
								ДанныеВрем=Строка(WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляТекущая),1,10)).Cells(СчетчикСтрок,1).Value);
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(160),Символ(32));
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(10),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(13),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(9),"");
								СтрокаИмпорта.Контрагент=СокрЛП(ДанныеВрем);
								ДанныеВрем=Строка(WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляТекущая),1,10)).Cells(СчетчикСтрок,2).Value);
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(10),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(13),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(9),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(32),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(160),"");
								СтрокаИмпорта.ИНН=ДанныеВрем;
								СтрокаИмпорта.Дата=ДатаКонтроляТекущая;
								СтрокаИмпорта.СчетДоверительногоУправления=Строка.СчетДоверительногоУправления;
								СчетчикСтрок=СчетчикСтрок+1;
								Данные=WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляТекущая),1,10)).Cells(СчетчикСтрок,1).Value;
							КонецЦикла;
						КонецЕсли;
						Если ДатаКонтроляПредыдущая<>Дата(1, 1, 1) Тогда
							СчетчикСтрок=1;
							Данные=WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляПредыдущая),1,10)).Cells(СчетчикСтрок,1).Value;
							Пока Данные<>"" И Данные<>Неопределено Цикл
								СтрокаИмпорта = ТаблицаИмпорта.Добавить();
								СтрокаИмпорта.КодСчетДУ=Строка.КодСчетДУ;
								ДанныеВрем=Строка(WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляПредыдущая),1,10)).Cells(СчетчикСтрок,1).Value);
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(160),Символ(32));
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(10),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(13),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(9),"");
								СтрокаИмпорта.Контрагент=СокрЛП(ДанныеВрем);
								ДанныеВрем=Строка(WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляПредыдущая),1,10)).Cells(СчетчикСтрок,2).Value);
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(10),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(13),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(9),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(32),"");
								ДанныеВрем=СтрЗаменить(ДанныеВрем ,Символ(160),"");
								СтрокаИмпорта.ИНН=ДанныеВрем;
								СтрокаИмпорта.Дата=ДатаКонтроляПредыдущая;
								СтрокаИмпорта.СчетДоверительногоУправления=Строка.СчетДоверительногоУправления;
								СчетчикСтрок=СчетчикСтрок+1;
								Данные=WorkBooks.Worksheets(Сред(Строка(ДатаКонтроляПредыдущая),1,10)).Cells(СчетчикСтрок,1).Value;
							КонецЦикла;
						КонецЕсли;
					Иначе 
						Логирование=Лог(Логирование,1,"В файле '" + ФайлСтрока + "' не найдено листов для обработки!!!");
					КонецЕсли;
					Excel.Quit();
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
					Возврат;
				КонецПопытки;
			Иначе
				Логирование=Лог(Логирование,1,"Файл '" + ФайлСтрока + "' не существует!!!");
			КонецЕсли;
			СчетчикФайловТекущий=СчетчикФайловТекущий+1;
		КонецЦикла;
	Иначе
		Логирование=Лог(Логирование,1,"Каталог '" + КаталогСтрока + "' не существует!!!");
	КонецЕсли;
	
	Если ТаблицаИмпортаШапка.Количество()>0 Тогда
		Состояние("Финишный анализ и обработка");
		ЗагруженныеДанные = Новый Массив;
		КорневойНаборСтрок=ДеревоЗначений.ПолучитьЭлементы();
		Для Каждого КорневаяСтрока Из КорневойНаборСтрок Цикл
			//Найдем парметры отбора - ДатаКонтроляТекущая,СчетДоверительногоУправления
			ДатаКонтроля=ПолучитьДатаКонтроля(КорневаяСтрока.СчетДоверительногоУправления);
		 	ДатаКонтроляТекущая=ДатаКонтроля.ДатаКонтроляТекущая;
			ДатаКонтроляПредыдущая=ДатаКонтроля.ДатаКонтроляПредыдущая;
	 		//Проставим галочки
			Если ДатаКонтроляТекущая<>Дата(1,1,1) Тогда
				Логирование=Лог(Логирование,1,Строка(КорневаяСтрока.СчетДоверительногоУправления)); 
				Логирование=Лог(Логирование,2,"Дата текущая - "+?(ДатаКонтроляТекущая=Дата(1,1,1),"Пустая",Сред(Строка(ДатаКонтроляТекущая),1,10))); 
				Логирование=Лог(Логирование,2,"Дата предыдущая - "+?(ДатаКонтроляПредыдущая=Дата(1,1,1),"Пустая",Сред(Строка(ДатаКонтроляПредыдущая),1,10))); 
				//Загрузим в массив структур данные из Excel
				ЗагруженныеДанные=МассивДанныхИзФайла(ДатаКонтроляТекущая,КорневаяСтрока.СчетДоверительногоУправления);
				ПодчиненныйНаборСтрок=КорневаяСтрока.ПолучитьЭлементы();
				Для Каждого ПодчиненнаяСтрока Из ПодчиненныйНаборСтрок Цикл
					Для  Счетчик=0 По ЗагруженныеДанные.Количество()-1 Цикл
						Если ПодчиненнаяСтрока.ИНН=ЗагруженныеДанные[Счетчик].ИНН И ПодчиненнаяСтрока.ИНН<>"" Тогда
							ДопСтрока=0;
							Если ПодчиненнаяСтрока.СвязаннаяСторона=Ложь Тогда
								//Сообщить("Количество неопределенных позиций - "+Строка(КоличествоПроблем));
								ДопСтрока=1;
								КорневаяСтрока.РазвернутьУзел=Истина;
							КонецЕсли;
							ПодчиненнаяСтрока.СвязаннаяСторона=Истина;
							ПодчиненнаяСтрока.НеСвязаннаяСторона=Ложь;
							ПодчиненнаяСтрока.СвязаннаяСторонаИзФайла=?(ДопСтрока=1,"[СМЕНА СТАТУСА]","")+ЗагруженныеДанные[Счетчик].Контрагент;
							Прервать;
						 КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				ЗагруженныеДанные.Очистить();
				//Выгрузим различия в данных связанных
				Логирование=РазличияВДанныхСвязанных(Логирование,КорневаяСтрока.СчетДоверительногоУправления,ДатаКонтроляТекущая,ДатаКонтроляПредыдущая);
			КонецЕсли;
			ДатаКонтроляТекущая=Дата("00010101000000");
			ДатаКонтроляПредыдущая=Дата("00010101000000");
		КонецЦикла;
		РазвертываниеУзлов();
	КонецЕсли;
	
	//Выгрузка журнала лога
	Если Логирование.Количество()>0 Тогда
		 ВыгрузкаЛога(Логирование).Показать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыгрузкаЛога(Массив)
	Макет=РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетЛог");
	ТаблицаДанных=Новый ТабличныйДокумент;
	ТаблицаДанных.Очистить();
	ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Детали");
	Для Счетчик=0 По Массив.Количество()-1 Цикл
		ОбластьДетальныхЗаписей.Параметры.Уровень1="";
		ОбластьДетальныхЗаписей.Параметры.Уровень2="";
		ОбластьДетальныхЗаписей.Параметры.Уровень3="";
		Если Массив[Счетчик].Уровень=1 Тогда
			ОбластьДетальныхЗаписей.Параметры.Уровень1=Массив[Счетчик].Сообщение;
		КонецЕсли;
		Если Массив[Счетчик].Уровень=2 Тогда
			ОбластьДетальныхЗаписей.Параметры.Уровень2=Массив[Счетчик].Сообщение;
		КонецЕсли;
		Если Массив[Счетчик].Уровень=3 Тогда
			ОбластьДетальныхЗаписей.Параметры.Уровень3=Массив[Счетчик].Сообщение;
		КонецЕсли;
		ТаблицаДанных.Вывести(ОбластьДетальныхЗаписей);
	КонецЦикла;
	ТаблицаДанных.ТолькоПросмотр = Истина;
	//ТаблицаДанных.ОтображатьЗаголовки = Истина;
	ТаблицаДанных.ОтображатьСетку = Ложь;
	Возврат  ТаблицаДанных;
КонецФункции

&НаСервере
Функция РазличияВДанныхСвязанных(Массив,СчетДоверительногоУправления,ДатаКонтроляТекущая,ДатаКонтроляПредыдущая)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагент,
		|	Дата
		|ПОМЕСТИТЬ 
		|	_ТаблицаИмпорта
		|ИЗ
		|  	&ТаблицаИмпорта КАК ТаблицаИмпорта
		|ГДЕ
		|  	СчетДоверительногоУправления=&СчетДоверительногоУправления	
		|	И
		|	(
		|		Дата=&ДатаКонтроляТекущая
		|		ИЛИ
		|		Дата=&ДатаКонтроляПредыдущая
		|	)
		|	И
		|	ЕСТЬNULL(Контрагент,"""")<>""""
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагент
		|ПОМЕСТИТЬ 
		|	_ТаблицаИмпортаДТек
		|ИЗ
		|  	_ТаблицаИмпорта КАК ТаблицаИмпорта
		|ГДЕ
		|	Дата=&ДатаКонтроляТекущая
		|СГРУППИРОВАТЬ ПО
		|		Контрагент
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагент
		|ПОМЕСТИТЬ 
		|	_ТаблицаИмпортаДПред
		|ИЗ
		|  	_ТаблицаИмпорта КАК ТаблицаИмпорта
		|ГДЕ
		|	Дата=&ДатаКонтроляПредыдущая
		|СГРУППИРОВАТЬ ПО
		|		Контрагент
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   ЕСТЬNULL(ДТек.Контрагент,"""") 		КАК ДТекКонтрагент,
		|   ЕСТЬNULL(ДПред.Контрагент,"""") 	КАК ДПредКонтрагент,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ДТек.Контрагент,"""")=""""
		|			ТОГДА -1
		|			ИНАЧЕ 1
		|	КОНЕЦ  								 КАК Направление
		|ИЗ
		|  	_ТаблицаИмпортаДТек		КАК	ДТек	
		|   ПОЛНОЕ СОЕДИНЕНИЕ
		|   _ТаблицаИмпортаДПред	КАК	ДПред
		|   ПО	ДТек.Контрагент=ДПред.Контрагент
		|ГДЕ
		|   ЕСТЬNULL(ДТек.Контрагент,"""")=""""
		|	ИЛИ
		|   ЕСТЬNULL(ДПред.Контрагент,"""")=""""
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ДТек.Контрагент,"""")=""""
		|			ТОГДА -1
		|			ИНАЧЕ 1
		|	КОНЕЦ,  
		|	ЕСТЬNULL(ДТек.Контрагент,ДПред.Контрагент)
		|";

	Запрос.УстановитьПараметр("ТаблицаИмпорта",					ТаблицаИмпорта.Выгрузить());
	Запрос.УстановитьПараметр("ДатаКонтроляТекущая",			ДатаКонтроляТекущая);
	Запрос.УстановитьПараметр("ДатаКонтроляПредыдущая",			ДатаКонтроляПредыдущая);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);	

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Направление=0;	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Направление<>ВыборкаДетальныеЗаписи.Направление Тогда
			 Направление=ВыборкаДетальныеЗаписи.Направление;
			 Если Направление=-1 Тогда
				 Массив=Лог(Массив,2,"Ушли");
			 Иначе
				 Массив=Лог(Массив,2,"Пришли");
			 КонецЕсли;
		КонецЕсли;
		Массив=Лог(Массив,3,?(ВыборкаДетальныеЗаписи.ДТекКонтрагент="",ВыборкаДетальныеЗаписи.ДПредКонтрагент,ВыборкаДетальныеЗаписи.ДТекКонтрагент));
	КонецЦикла;

	Возврат Массив;
	
КонецФункции

&НаСервере
Функция ПолучитьДатаКонтроля(СчетДоверительногоУправления)
	СтруктураДата=Новый Структура;
	Нашли=Ложь;
	Для Каждого Строка Из ТаблицаИмпортаШапка.Выгрузить() Цикл
		Если Строка.СчетДоверительногоУправления=СчетДоверительногоУправления Тогда
			СтруктураДата.Вставить("ДатаКонтроляТекущая",Строка.ДатаКонтроляТекущая);
			СтруктураДата.Вставить("ДатаКонтроляПредыдущая",Строка.ДатаКонтроляПредыдущая);	
			Нашли=Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не Нашли Тогда
		СтруктураДата.Вставить("ДатаКонтроляТекущая",Дата(1,1,1));
		СтруктураДата.Вставить("ДатаКонтроляПредыдущая",Дата(1,1,1));	
	КонецЕсли;
	Возврат СтруктураДата;
КонецФункции
	
&НаСервере
Функция МассивДанныхИзФайла(ДатаКонтроляТекущая,СчетДоверительногоУправления)
	ЗагруженныеДанные = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|		Контрагент,
		|		ИНН
		|ПОМЕСТИТЬ _ТаблицаИмпорта
		|ИЗ
		|	&ТаблицаИмпорта КАК ТаблицаИмпорта
		|ГДЕ
		|	 Контрагент<>"" И ИНН<>"" И  Дата=&ДатаКонтроляТекущая И СчетДоверительногоУправления=&СчетДоверительногоУправления
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 	Контрагент,ИНН
		|ИЗ    		_ТаблицаИмпорта
		|";
	
	Запрос.УстановитьПараметр("ТаблицаИмпорта",					ТаблицаИмпорта.Выгрузить());
	Запрос.УстановитьПараметр("ДатаКонтроляТекущая",			ДатаКонтроляТекущая);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗагруженныеДанныеСтруктура=Новый Структура;
		ЗагруженныеДанныеСтруктура.Вставить("Контрагент",ВыборкаДетальныеЗаписи.Контрагент);
		ЗагруженныеДанныеСтруктура.Вставить("ИНН",ВыборкаДетальныеЗаписи.ИНН);	
		ЗагруженныеДанные.Добавить(ЗагруженныеДанныеСтруктура);
	КонецЦикла;
	Возврат ЗагруженныеДанные;
КонецФункции
 
&НаКлиентеНаСервереБезКонтекста
Функция Лог(Массив,Уровень,Сообщение)
	ЛогированиеСтруктура=Новый Структура;
	ЛогированиеСтруктура.Вставить("Уровень",Уровень);
	ЛогированиеСтруктура.Вставить("Сообщение",Сообщение);	
	Массив.Добавить(ЛогированиеСтруктура);
	Возврат Массив;
КонецФункции

&НаКлиенте
Функция ПреобразованиеДатаСтрока(ДатаСтрока)
	ДатаСтрока=СокрЛП(ДатаСтрока);
	Если СтрДлина(ДатаСтрока)=10 Тогда
		Результат=Сред(ДатаСтрока,7,4)+Сред(ДатаСтрока,4,2)+Сред(ДатаСтрока,1,2);
	Иначе
		Результат=ДатаСтрока;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПапкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
