	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.Выбрать();
	Если ДиалогОткрытияФайла.Каталог<>"" Тогда
		Объект.Папка=ДиалогОткрытияФайла.Каталог+"\";
	КонецЕсли;
КонецПроцедуры

