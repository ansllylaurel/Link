
&НаСервере
Процедура РасчитатьНаСервере()
	
	ЭтаФорма.Доходность = БухгалтерскийУчет.РассчитатьДоходностьИДюрациюПоПотоку(ЭтаФорма.ДенежныйПоток.Выгрузить(), ЭтаФорма.Дата, ЭтаФорма.Цена, ЭтаФорма.Точность).Доходность;
	
КонецПроцедуры

&НаКлиенте
Процедура Расчитать(Команда)
	
	Если ЭтаФорма.Дата = '00010101' Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата");
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Цена = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Цена не может быть нолевой");
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаДенежныйПоток Из ЭтаФорма.ДенежныйПоток Цикл
	
		Если СтрокаДенежныйПоток.Дата = '00010101' Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указана дата потока");
			Возврат;
		КонецЕсли;	
		
		Если СтрокаДенежныйПоток.Поток = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сумма потока не может быть нолевой");
			Возврат;
		КонецЕсли;	
		
	КонецЦикла;
	
	РасчитатьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Точность = 0.0000000001;
	
КонецПроцедуры

&НаКлиенте
Функция РасчетИзДокументаРегистрации() Экспорт
	
	РасчитатьНаСервере();
	ЭтаФорма.Открыть();
	
КонецФункции 
