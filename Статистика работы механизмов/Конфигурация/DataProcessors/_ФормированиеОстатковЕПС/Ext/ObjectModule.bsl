
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Формирование остатков ЕПС",
		"0.01",
		"",
		Истина
	);
		
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьКорректировкуРегистров(Период, Организация, Клиент, ИмяРегистра, Знач Комментарий = "")
	
	Если Комментарий="" Тогда
		Комментарий = "Ввод начальных остатков ЕПС, " + Клиент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КорректировкаРегистров.Ссылка
		|ИЗ
		|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|ГДЕ
		|	КорректировкаРегистров.Организация = &Организация
		|	И КорректировкаРегистров.Дата = &Дата
		|	И КорректировкаРегистров.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И КорректировкаРегистров.Комментарий ПОДОБНО &Комментарий
		|	И НЕ КорректировкаРегистров.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("Дата",                         Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Клиент);
	Запрос.УстановитьПараметр("Комментарий",                  Комментарий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		КорректировкаРегистров = Документы.КорректировкаРегистров.СоздатьДокумент();
		КорректировкаРегистров.Дата                         = Период;
		КорректировкаРегистров.Организация                  = Организация;
		КорректировкаРегистров.СчетДоверительногоУправления = Клиент;
		КорректировкаРегистров.Ответственный                = РаботаСПользователями.ТекущийПользователь();
		КорректировкаРегистров.Комментарий                  = Комментарий;
		
		СтрокаТаблицаРегистров = КорректировкаРегистров.ТаблицаРегистров.Добавить();
		СтрокаТаблицаРегистров.Имя = ИмяРегистра;
		
		КорректировкаРегистров.Записать();
		
		Сообщить("Создан документ " + КорректировкаРегистров);
		
	Иначе
		КорректировкаРегистров = Выборка.Ссылка;
		
		Если КорректировкаРегистров.ТаблицаРегистров.Найти(ИмяРегистра, "Имя") = Неопределено Тогда
			КорректировкаРегистров = КорректировкаРегистров.ПолучитьОбъект();
						
			СтрокаТаблицаРегистров = КорректировкаРегистров.ТаблицаРегистров.Добавить();
			СтрокаТаблицаРегистров.Имя = ИмяРегистра;
			
			КорректировкаРегистров.Записать();
			Сообщить("Изменен состав регистров в документе " + КорректировкаРегистров + ". Клиент: " + Клиент + ".");
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат КорректировкаРегистров.Ссылка;
	
КонецФункции // ПолучитьКорректировкуРегистров

Функция ПолучитьНаборЗаписейРегистраДляЗаписи(Период, Организация, Клиент, ИмяРегистра, Очищать = Истина)
	
	Регистратор = ПолучитьКорректировкуРегистров(Период, Организация, Клиент, ИмяРегистра);
	
	Если ИмяРегистра = "БухПартииЦенныхБумаг" Тогда
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
	Иначе
		НаборЗаписей = РегистрыБухгалтерии[ИмяРегистра].СоздатьНаборЗаписей();
	КонецЕсли;
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();
	Если Очищать Тогда
		НаборЗаписей.Очистить();
	КонецЕсли;
	
	Возврат НаборЗаписей;
	
КонецФункции // ПолучитьНаборЗаписейРегистраДляЗаписи

Процедура ДобавитьЗаписьВНабор(НаборЗаписей, РеквизитыСчета, Период, Организация, Клиент, ИмяРегистра)
	
	Если Не ЗначениеЗаполнено(РеквизитыСчета.Счет) Тогда
		Возврат;
	КонецЕсли;
		
	ВидыСубконто = РеквизитыСчета.Счет.ВидыСубконто;
	
	МенеджерЗаписи = НаборЗаписей.Добавить();
	
	МенеджерЗаписи.Период                       = Период;
	МенеджерЗаписи.Организация                  = Организация;
	МенеджерЗаписи.СчетДоверительногоУправления = Клиент;
	МенеджерЗаписи.Содержание                   = "Ввод начальных остатков";
	МенеджерЗаписи.Регистратор = НаборЗаписей.Отбор.Регистратор;
	
	Если РеквизитыСчета.Счет.Вид = ВидСчета.Активный
		Или (РеквизитыСчета.Счет.Вид = ВидСчета.АктивноПассивный И РеквизитыСчета.Сумма > 0)
	Тогда
		МенеджерЗаписи.СчетДт          = РеквизитыСчета.Счет;
		МенеджерЗаписи.ДополнительнаяАналитикаДт   = РеквизитыСчета.ДополнительнаяАналитика;
		
		Если РеквизитыСчета.Счет.Количественный Тогда
			МенеджерЗаписи.КоличествоДт    = РеквизитыСчета.Количество;
		КонецЕсли;
		
		Если РеквизитыСчета.Счет.Валютный Тогда
			МенеджерЗаписи.ВалютаДт        = РеквизитыСчета.Валюта;
			МенеджерЗаписи.ВалютнаяСуммаДт = ?(РеквизитыСчета.ВалютнаяСумма<>0, РеквизитыСчета.ВалютнаяСумма, РеквизитыСчета.Сумма);
		КонецЕсли;
		
		МенеджерЗаписи.СчетКт = ПланыСчетов.Единый.Вспомогательный;
		
		МенеджерЗаписи.Сумма = РеквизитыСчета.Сумма;
		
		Для НомСубк = 0 По ВидыСубконто.Количество() - 1 Цикл
			МенеджерЗаписи.СубконтоДт[ВидыСубконто[НомСубк].ВидСубконто] = РеквизитыСчета["Субконто" + (НомСубк + 1)];
		КонецЦикла;
		
	ИначеЕсли РеквизитыСчета.Счет.Вид = ВидСчета.Пассивный
		Или (РеквизитыСчета.Счет.Вид = ВидСчета.АктивноПассивный И РеквизитыСчета.Сумма < 0)
	Тогда
		МенеджерЗаписи.СчетКт          = РеквизитыСчета.Счет;
		МенеджерЗаписи.ДополнительнаяАналитикаКт   = РеквизитыСчета.ДополнительнаяАналитика;
		
		Если РеквизитыСчета.Счет.Количественный Тогда
			МенеджерЗаписи.КоличествоКт    = -РеквизитыСчета.Количество;
		КонецЕсли;
		
		Если РеквизитыСчета.Счет.Валютный Тогда
			МенеджерЗаписи.ВалютаКт        = РеквизитыСчета.Валюта;
			МенеджерЗаписи.ВалютнаяСуммаКт = -?(РеквизитыСчета.ВалютнаяСумма<>0, РеквизитыСчета.ВалютнаяСумма, РеквизитыСчета.Сумма);
		КонецЕсли;
		
		МенеджерЗаписи.СчетДт = ПланыСчетов.Единый.Вспомогательный;
		
		МенеджерЗаписи.Сумма = -РеквизитыСчета.Сумма;
		
		Для НомСубк = 0 По ВидыСубконто.Количество() - 1 Цикл
			МенеджерЗаписи.СубконтоКт[ВидыСубконто[НомСубк].ВидСубконто] = РеквизитыСчета["Субконто" + (НомСубк + 1)];
		КонецЦикла;
		
	Иначе
		НаборЗаписей.Удалить(НаборЗаписей.Количество() - 1);
		
		Сообщить("Некорректный остаток " + РеквизитыСчета.Сумма + " по счету " + РеквизитыСчета.Счет);
		
	КонецЕсли;	
	
	Если МенеджерЗаписи.СчетДт.Валютный Тогда
		Если МенеджерЗаписи.ВалютаДт = Справочники.Валюты.ПустаяСсылка() Тогда
			МенеджерЗаписи.ВалютаДт = Организация.ВалютаУчета;	
		КонецЕсли;
	КонецЕсли;
	
	Если МенеджерЗаписи.СчетКт.Валютный Тогда
		Если МенеджерЗаписи.ВалютаКт = Справочники.Валюты.ПустаяСсылка() Тогда
			МенеджерЗаписи.ВалютаКт = Организация.ВалютаУчета;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ДобавитьЗаписьВНабор

Процедура СформироватьОстаткиПоБумагам() Экспорт
	
	Период 		= КонецДня(ДатаОстатков);
	Организация = СчетДУ.Организация;
	
	НаборЗаписейРегистра 		= ПолучитьНаборЗаписейРегистраДляЗаписи(Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет", Ложь);
	НаборЗаписейРегистраПартий 	= ПолучитьНаборЗаписейРегистраДляЗаписи(Период, Организация, СчетДУ, "БухПартииЦенныхБумаг", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета = НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК ПереоценкаВместе
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаОстатков,
		|			СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = &Бух) КАК НастройкиУчетаАктивовСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОстатков)+1);
	Запрос.УстановитьПараметр("Бух",  Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	
	НастройкиУчетаАктивовБух = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаПартийСрезПоследних.ВидУчета,
		|	НастройкиУчетаПартийСрезПоследних.ВключатьРасходыПоПокупкеВСтоимость
		|ИЗ
		|	РегистрСведений.НастройкиУчетаПартий.СрезПоследних(&ДатаОстатков, СчетДоверительногоУправления = &СчетДУ) КАК НастройкиУчетаПартийСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОстатков)+1);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВключатьРасходыБух 		= Неопределено;
	ВключатьРасходыНалог 	= Неопределено;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
			ВключатьРасходыБух = ВыборкаДетальныеЗаписи.ВключатьРасходыПоПокупкеВСтоимость;
		ИначеЕсли ВыборкаДетальныеЗаписи.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
			ВключатьРасходыНалог = ВыборкаДетальныеЗаписи.ВключатьРасходыПоПокупкеВСтоимость;
		КонецЕсли;			
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.ВидУчета КАК ВидУчета,
		|	БухПартииЦенныхБумагОстатки.Рынок,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупкиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток КАК СтоимостьПокупкиКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаОстатков,
		|			СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = &Бух) КАК БухПартииЦенныхБумагОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	ВидУчета УБЫВ";
		
		
	Запрос.УстановитьПараметр("Бух", 			Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("ДатаОстатков", 	Новый Граница(КонецДня(ДатаОстатков),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДУ", 		СчетДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АналитикаПремия 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконт 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	
	РеквизитыСчета = Новый Структура("Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2", "", 0, 0, "", 0, Неопределено, 0, 0);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
		ТекЦБ 		= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		//Сообщить("Цб="+ТекЦБ+", Партия = "+ВыборкаДетальныеЗаписи.Партия+", строка партии = "+ВыборкаДетальныеЗаписи.СтрокаПартии);
		
		Для каждого ЗаписьПартии  Из НаборЗаписейРегистраПартий Цикл
			Если ЗаписьПартии.ЦеннаяБумага = ТекЦБ И ЗаписьПартии.Партия = ВыборкаДетальныеЗаписи.Партия И ЗаписьПартии.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗаписьПартии.ЦеннаяБумага = ТекЦБ И ЗаписьПартии.Партия = ВыборкаДетальныеЗаписи.Партия И ЗаписьПартии.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии Тогда
		Иначе
			Сообщить("Не нашли партию для корректировки");
			Возврат;
		КонецЕсли;
		
		//Партии у нас в валюте номинала. И если вдруг мы встретили ту, что не в валюте учета - надо отрабатывать отдельно
		Если ТекЦБ.ВалютаНоминала <> Организация.ВалютаУчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У ценной бумаги " + ТекЦБ + " валюта номинала отлична от учетной. Надо разбираться!");
		КонецЕсли;

		УчетныйАктивЕПС = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		УчетныйАктивБух = БухгалтерскийУчет.ОпределитьУчетныйАктив(ДатаОстатков, ВыборкаДетальныеЗаписи.Рынок, ТекЦБ, Ложь);
		ТекНастройкиУчетаАктиваБух = НастройкиУчетаАктивовБух.Найти(УчетныйАктивБух, "УчетныйАктив"); 
		
		Если ТекНастройкиУчетаАктиваБух = Неопределено Тогда
			Сообщить("Не определены настройки бухгалтерского учета для вида актива " + УчетныйАктивБух);
			Возврат;
		КонецЕсли;
				
		ПереоценкаКупона = ВыборкаДетальныеЗаписи.ПереоценкаКупонаВСтоимостиОстаток + ВыборкаДетальныеЗаписи.ПереоценкаКупонаОстаток;
		
		Если ПереоценкаКупона <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 					= ПереоценкаКупона;
			РеквизитыСчета.Количество				= 0;
			РеквизитыСчета.Валюта 		 			= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма			= ПереоценкаКупона;
			РеквизитыСчета.Субконто1 				= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			РеквизитыСчета.Счет						= УчетныйАктивЕПС.СчетУчетаКупона;
			РеквизитыСчета.ДополнительнаяАналитика 	= АналитикаКупонНачисленный;			
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
		КонецЕсли;
		
		СтоимостьКупона = ВыборкаДетальныеЗаписи.СтоимостьКупонаОстаток - ВыборкаДетальныеЗаписи.ПереоценкаКупонаВСтоимостиОстаток; 
		
		Если СтоимостьКупона <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 					= СтоимостьКупона;
			РеквизитыСчета.Количество				= 0;
			РеквизитыСчета.Валюта 		 			= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 			= СтоимостьКупона;
			РеквизитыСчета.Субконто1 				= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			РеквизитыСчета.Счет						= УчетныйАктивЕПС.СчетУчетаКупона;
			РеквизитыСчета.ДополнительнаяАналитика	= АналитикаКупонПриобретенный;			
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
		КонецЕсли;
		
		ДисконтПремия = ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйОстаток;
		
		Если ДисконтПремия > 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 					= ДисконтПремия;
			РеквизитыСчета.Количество				= 0;
			РеквизитыСчета.Валюта 		 			= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 			= ДисконтПремия;
			РеквизитыСчета.Субконто1 				= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			РеквизитыСчета.Счет						= УчетныйАктивЕПС.СчетУчета;
			РеквизитыСчета.ДополнительнаяАналитика	= АналитикаПремия;			
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток > 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 			= -ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток;
			РеквизитыСчета.Количество		= 0;
			РеквизитыСчета.Валюта 		 	= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 	= ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток;
			РеквизитыСчета.Субконто1 		= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			РеквизитыСчета.Счет				= УчетныйАктивЕПС.СчетУчетаРезервов;
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
			
			//Для тех бумаг, по которым делаем - РСБУ нет
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 			= ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток;
			РеквизитыСчета.Количество		= 0;
			РеквизитыСчета.Валюта 		 	= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 	= ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток;
			РеквизитыСчета.Счет 			= ПланыСчетов.Единый.АктивыВДУ03;
			РеквизитыСчета.Субконто1		= СчетДУ;
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СтоимостьОстаток > 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 					= ВыборкаДетальныеЗаписи.СтоимостьОстаток;
			РеквизитыСчета.Количество				= ВыборкаДетальныеЗаписи.КоличествоОстаток;
			РеквизитыСчета.Валюта 		 			= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 			= ВыборкаДетальныеЗаписи.СтоимостьОстаток;
			РеквизитыСчета.Субконто1 				= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			РеквизитыСчета.Счет						= УчетныйАктивЕПС.СчетУчета;
			РеквизитыСчета.ДополнительнаяАналитика	= АналитикаТела;	
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
		КонецЕсли;
		
		//в переоценку сохраняем разницу между балансовой стоимостью РСБУ и ЕПС для отнесения на 479 счет.
		Если ВыборкаДетальныеЗаписи.ПереоценкаОстаток <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 			= ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
			РеквизитыСчета.Количество		= 0;
			РеквизитыСчета.Валюта 		 	= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма 	= ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
			РеквизитыСчета.Субконто1 		= СчетДУ;
			РеквизитыСчета.Счет				= ПланыСчетов.Единый.АктивыВДУ03;
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");			
			ЗаписьПартии.Переоценка = 0;
		КонецЕсли;
		
		Если ТекНастройкиУчетаАктиваБух.ПереоценкаВместе и ВыборкаДетальныеЗаписи.ПереоценкаВСтоимостиОстаток <> 0 Тогда
			//ПереоценкаВСтоимостиОстаток заполнено только когда сумма переоценки в бух.регистре зафиксирована не полностью
			ОбщегоНазначенияКлиентСервер.ОчиститьПоля(РеквизитыСчета, "Счет, Сумма, Количество, Валюта, ВалютнаяСумма, ДополнительнаяАналитика, Субконто1, Субконто2");
			РеквизитыСчета.Сумма 			= ВыборкаДетальныеЗаписи.ПереоценкаВСтоимостиОстаток;
			РеквизитыСчета.Количество		= 0;
			РеквизитыСчета.Валюта 		 	= Организация.ВалютаУчета;
			РеквизитыСчета.ВалютнаяСумма	= ВыборкаДетальныеЗаписи.ПереоценкаВСтоимостиОстаток;
			РеквизитыСчета.Субконто1 		= СчетДУ;
			РеквизитыСчета.Счет				= ПланыСчетов.Единый.АктивыВДУ03;
			ДобавитьЗаписьВНабор(НаборЗаписейРегистра, РеквизитыСчета, Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
			ЗаписьПартии.ПереоценкаВСтоимости = 0;			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписейРегистра.Записать();
	НаборЗаписейРегистраПартий.Записать();
	
КонецПроцедуры

Процедура СформироватьОстаткиЕПС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета = НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК ПереоценкаВместе
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаОстатков,
		|			СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = &Бух) КАК НастройкиУчетаАктивовСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОстатков)+1);
	Запрос.УстановитьПараметр("Бух",  Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	
	НастройкиУчетаАктивовБух = Запрос.Выполнить().Выгрузить();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет,
		|	БухгалтерскийУчетОстатки.Субконто1,
		|	БухгалтерскийУчетОстатки.Субконто2,
		|	БухгалтерскийУчетОстатки.Субконто3,
		|	БухгалтерскийУчетОстатки.Организация,
		|	БухгалтерскийУчетОстатки.СчетДоверительногоУправления,
		|	БухгалтерскийУчетОстатки.Валюта,
		|	БухгалтерскийУчетОстатки.СуммаОстаток,
		|	БухгалтерскийУчетОстатки.КоличествоОстаток,
		|	БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(&ДатаОстатков, , , СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки";
	
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(ДатаОстатков),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Организация = СчетДУ.Организация;
	Период = КонецДня(ДатаОстатков);
	
	СтараяКорректировкаПартий = ПолучитьКорректировкуРегистров(Период,Организация,СчетДУ,"БухПартииЦенныхБумаг","Ввод начальных остатков партий ц/б");
	Если СтараяКорректировкаПартий<>Неопределено Тогда
		НаборЗаписей = РегистрыНакопления["БухПартииЦенныхБумаг"].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СтараяКорректировкаПартий);
		НаборЗаписей.Прочитать();
		кол = НаборЗаписей.Количество();
		Для сц=-кол+1 по 0 Цикл
			Запись = НаборЗаписей.Получить(-сц);
			Если Запись.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
				НаборЗаписей.Удалить(Запись);
			КонецЕсли;
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	
	НаборЗаписейРегистра = ПолучитьНаборЗаписейРегистраДляЗаписи(Период, Организация, СчетДУ, "ЕдиныйБухгалтерскийУчет");
	НаборЗаписейРегистраПартий = ПолучитьНаборЗаписейРегистраДляЗаписи(Период, Организация, СчетДУ, "БухПартииЦенныхБумаг");
	
	СчетаИзПартий = Новый Массив;
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.Акции);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.КорпоративныеОблигацииТело);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.КорпоративныеОблигацииКупон);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.КорпоративныеОблигацииКупонНачисленный);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.КупонУплаченныйПриПокупкеКорпоративныеОблигации);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ПереоценкаЦенныхБумагКорпоративныеОблигацииКупонНачисленный);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ГосударственныеОблигацииТело);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ГосударственныеОблигацииКупон);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.КупонУплаченныйПриПокупкеГосударственныеОблигации);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ПереоценкаЦенныхБумагГосударственныеОблигацииКупонНачисленный);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ПереоценкаКорпоративныхОблигацийТело);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.ПереоценкаГосударственныхОблигацийТело);
	СчетаИзПартий.Добавить(ПланыСчетов.Основной.Паи);
	
	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	РеквизитыСчета = Новый Структура("Счет, Сумма, Количество, Валюта, ВалютнаяСумма, Субконто1, Субконто2, ДополнительнаяАналитика", "", 0, 0, "", 0, 0, 0, Неопределено);	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		РеквизитыСчета.Сумма 			= ВыборкаДетальныеЗаписи.СуммаОстаток;
