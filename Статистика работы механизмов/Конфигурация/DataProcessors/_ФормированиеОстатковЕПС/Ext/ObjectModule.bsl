		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаОстатков,
		|			СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = &Бух) КАК БухПартииЦенныхБумагОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага";
		
		
	Запрос.УстановитьПараметр("Бух", ДанныеБратьИз);
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(ДатаОстатков),ВидГраницы.Включая));
	//Запрос.УстановитьПараметр("Налог", Перечисления.ВидыУчета.НалоговыйУчет);
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивЦБ = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал
		|ИЗ
		|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПереоценки, ЦеннаяБумага В (&МассивЦБ)) КАК НоминалыЦенныхБумагСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаПереоценки", КонецДня(ДатаОстатков));
	Запрос.УстановитьПараметр("МассивЦБ", МассивЦБ);
	
	ТаблицаНоминаловЦБ = Запрос.Выполнить().Выгрузить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекЦБ 			= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		ТекРынок 		= ВыборкаДетальныеЗаписи.Рынок;		
		СтрокаНоминала 	= ТаблицаНоминаловЦБ.Найти(ТекЦБ,"ЦеннаяБумага");
						
		УчетныйАктивБух 			= БухгалтерскийУчет.ОпределитьУчетныйАктив(ДатаОстатков,ТекРынок,ТекЦБ,Ложь);
		ТекНастройкиУчетаАктиваБух 	= НастройкиУчетаАктивовБух.Найти(УчетныйАктивБух,"УчетныйАктив"); 
		
		Если ТекНастройкиУчетаАктиваБух=Неопределено Тогда
			Сообщить("Не определены настройки учета РСБУ для вида актива " + УчетныйАктивБух);
			Возврат;
		КонецЕсли;
		
		УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(ДатаОстатков, ТекРынок, ТекЦБ);
		
		//Хардкод! Коля для ввода цб сделал через реквизиты! Это зло
		Если (СчетДУ.КодСчета = "DU_NPF315")
		 или ((СчетДУ.КодСчета = "DU_NPF008") и ((ТекЦБ.ГосударственныйРегистрационныйНомер = "4-05-60939-H") или (ТекЦБ.ГосударственныйРегистрационныйНомер = "4-01-05741-A")))  Тогда
			УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов;
		КонецЕсли;	
			
		Переоценка = ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
		ПереоценкаКупона = ВыборкаДетальныеЗаписи.ПереоценкаКупонаВСтоимостиОстаток+ВыборкаДетальныеЗаписи.ПереоценкаКупонаОстаток;
		МенеджерЗаписиПартий = НаборЗаписейРегистраПартий.Добавить();
		МенеджерЗаписиПартий.Период 			= КонецДня(ДатаОстатков);
		МенеджерЗаписиПартий.Организация		= СчетДУ.Организация;
		МенеджерЗаписиПартий.СчетДоверительногоУправления = СчетДУ;
		МенеджерЗаписиПартий.ВидУчета			= Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		МенеджерЗаписиПартий.Рынок 				= ВыборкаДетальныеЗаписи.Рынок;
		МенеджерЗаписиПартий.ЦеннаяБумага 		= ТекЦБ;
		МенеджерЗаписиПартий.УчетныйАктивЕПС 	= УчетныйАктивЕПС;
		МенеджерЗаписиПартий.Партия 			= ВыборкаДетальныеЗаписи.Партия;
		МенеджерЗаписиПартий.СтрокаПартии 		= ВыборкаДетальныеЗаписи.СтрокаПартии;
		МенеджерЗаписиПартий.Количество 		= ВыборкаДетальныеЗаписи.КоличествоОстаток;
		МенеджерЗаписиПартий.Стоимость 			= ВыборкаДетальныеЗаписи.СтоимостьОстаток;
		
		//корректируем переоценку, если отражено неверно
		Если НЕ ТекНастройкиУчетаАктиваБух.ПереоценкаВместе и (МенеджерЗаписиПартий.ПереоценкаВСтоимости <> 0) Тогда
			//фиксируем разницу между суммами учета бух и ЕПС
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для бумаги " + ТекЦБ + " заполнена сумма переоценки в стоимости, а в настройках учета переоценка отдельно от актива!");
		Иначе
			МенеджерЗаписиПартий.Стоимость  			= МенеджерЗаписиПартий.Стоимость -  ВыборкаДетальныеЗаписи.ПереоценкаВСтоимостиОстаток;
			МенеджерЗаписиПартий.ПереоценкаВСтоимости  	= ВыборкаДетальныеЗаписи.ПереоценкаВСтоимостиОстаток;
		КонецЕсли;
		
		МенеджерЗаписиПартий.СтоимостьПокупки 					= ВыборкаДетальныеЗаписи.СтоимостьПокупкиОстаток;
		МенеджерЗаписиПартий.СтоимостьПокупкиКупона 			= ВыборкаДетальныеЗаписи.СтоимостьПокупкиКупонаОстаток;
		МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости 		= 0;
		МенеджерЗаписиПартий.ПереоценкаКупонаВСтоимости 		= 0;
		МенеджерЗаписиПартий.Стоимость 							= МенеджерЗаписиПартий.Стоимость - ВыборкаДетальныеЗаписи.РасходыПриПокупкеВСтоимостиОстаток;
		МенеджерЗаписиПартий.СтоимостьКупона 					= ВыборкаДетальныеЗаписи.СтоимостьКупонаостаток - ВыборкаДетальныеЗаписи.ПереоценкаКупонаВСтоимостиОстаток; 
		Если ТекРынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			МенеджерЗаписиПартий.Переоценка = ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
		Иначе
			МенеджерЗаписиПартий.Переоценка = ВыборкаДетальныеЗаписи.ПереоценкаОстаток +  ВыборкаДетальныеЗаписи.РасходыПриПокупкеВСтоимостиОстаток;
		КонецЕсли; 
		МенеджерЗаписиПартий.ПереоценкаКупона 					= ПереоценкаКупона;
		МенеджерЗаписиПартий.СуммаЧастичногоПогашения 			= ВыборкаДетальныеЗаписи.СуммаЧастичногоПогашенияОстаток;
		МенеджерЗаписиПартий.СуммаРезервовПодОбесценение 		= ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеОстаток;
		МенеджерЗаписиПартий.СуммаРезервовПодОбесценениеКупона 	= ВыборкаДетальныеЗаписи.СуммаРезервовПодОбесценениеКупонаОстаток;
		МенеджерЗаписиПартий.СуммаРезервовПоСомнительнымДолгам 	= ВыборкаДетальныеЗаписи.СуммаРезервовПоСомнительнымДолгамОстаток;
		
		//Эта ветка для облигаций
		
		Если СтрокаНоминала <> Неопределено Тогда
			
			ТекущийНоминал 	= СтрокаНоминала.Номинал * ВыборкаДетальныеЗаписи.КоличествоОстаток;
			ДатаПартии 		= ВыборкаДетальныеЗаписи.Партия.Дата;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	НоминалыЦенныхБумагСрезПоследних.Номинал
				|ИЗ
				|	РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаПартии, ЦеннаяБумага = &ЦБ) КАК НоминалыЦенныхБумагСрезПоследних";

			Запрос.УстановитьПараметр("ДатаПартии", КонецДня(ДатаПартии));
			Запрос.УстановитьПараметр("ЦБ", ТекЦБ);

			НоминалПокупки = СтрокаНоминала.Номинал;
			ВыборкаНоминалаПокупки = Запрос.Выполнить().Выбрать();
			Пока ВыборкаНоминалаПокупки.Следующий() Цикл
				НоминалПокупки = ВыборкаНоминалаПокупки.Номинал;
			КонецЦикла;
			
			НоминалПокупки 		= НоминалПокупки * ВыборкаДетальныеЗаписи.КоличествоОстаток;
			СтоимостьПокупки 	= 0;
			ТекПартия 			= ВыборкаДетальныеЗаписи.Партия;
			
			Если ТипЗнч(ТекПартия) = Тип("ДокументСсылка.Сделка")
				ИЛИ ТипЗнч(ТекПартия) = Тип("ДокументСсылка.СделкаРЕПО")
				ИЛИ ТипЗнч(ТекПартия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке")
				ИЛИ ТипЗнч(ТекПартия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") 
				ИЛИ ТипЗнч(ТекПартия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
				
				ТекСтрокаПартии = ТекПартия.ЦенныеБумаги.Найти(ВыборкаДетальныеЗаписи.СтрокаПартии,"СтрокаПартии");
				
				Если ТекСтрокаПартии <> Неопределено Тогда
					СтоимостьПокупки 		= ВыборкаДетальныеЗаписи.КоличествоОстаток * ТекСтрокаПартии.Сумма / ТекСтрокаПартии.Количество;
					СтоимостьПокупкиКупона 	= ВыборкаДетальныеЗаписи.КоличествоОстаток * ТекСтрокаПартии.СуммаКупона / ТекСтрокаПартии.Количество;
					
					МенеджерЗаписиПартий.СтоимостьПокупки 		= СтоимостьПокупки;				
					МенеджерЗаписиПартий.СтоимостьПокупкиКупона = СтоимостьПокупкиКупона;
					
					Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов Тогда
						//Из ввода цб не выделить расходы при покупке, а надо. А сидят они в стоимости при покупке.
						Если  ТипЗнч(ТекПартия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
							МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости = МенеджерЗаписиПартий.СтоимостьПокупки - НоминалПокупки;
						ИначеЕсли СчетДУ.КодСчета = "DU_NPF008" Тогда
							//а тут знаем, что была только торговая комиссия, ее и вытащим
							МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости = ВыборкаДетальныеЗаписи.КоличествоОстаток * ТекСтрокаПартии.ТорговаяКомиссия / ТекСтрокаПартии.Количество;
							МенеджерЗаписиПартий.СтоимостьПокупки 			 = МенеджерЗаписиПартий.СтоимостьПокупки + МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости;
						Иначе	
							МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости = ВыборкаДетальныеЗаписи.РасходыПриПокупкеВСтоимостиОстаток;
							МенеджерЗаписиПартий.СтоимостьПокупки 			 = МенеджерЗаписиПартий.СтоимостьПокупки + МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости;
						КонецЕсли;
						
						Если СчетДУ.КодСчета = "DU_NPF008" Тогда
							МенеджерЗаписиПартий.СуммаРезервовПодОбесценение = МенеджерЗаписиПартий.СтоимостьПокупки;	
						КонецЕсли; 
					КонецЕсли; 
					
				Иначе
					Сообщить("Не определена строка партии "+ВыборкаДетальныеЗаписи.СтрокаПартии+" для партии "+ТекПартия);
				КонецЕсли;
				
			Иначе
				Сообщить("Не определена цена покупки для партии "+ТекПартия);
			КонецЕсли;	
						
			//ДолговыеДляПродажиИДоПогашенияПрочихРезидентов для них учитывается стоимость при покупке
			Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов Тогда
				МенеджерЗаписиПартий.ДисконтПремия = МенеджерЗаписиПартий.СтоимостьПокупки - НоминалПокупки - МенеджерЗаписиПартий.РасходыПриПокупкеВСтоимости;
			Иначе
				МенеджерЗаписиПартий.ДисконтПремия = МенеджерЗаписиПартий.СтоимостьПокупки - НоминалПокупки;
			КонецЕсли;
			
			Если МенеджерЗаписиПартий.ДисконтПремия > 0 Тогда
				ТекСтоимость 								  = ТекущийНоминал;
				МенеджерЗаписиПартий.ДисконтПремияНачисленный = МенеджерЗаписиПартий.ДисконтПремия;
			Иначе
				ТекСтоимость = МенеджерЗаписиПартий.СтоимостьПокупки * ТекущийНоминал / НоминалПокупки;
			КонецЕсли;
			
			Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов и СчетДУ.КодСчета = "DU_NPF008" Тогда
				МенеджерЗаписиПартий.СуммаРезервовПодОбесценение = ТекСтоимость;
			КонецЕсли; 
			
			//в переоценку сохраняем разницу между балансовой стоимостью РСБУ и ЕПС для отнесения на 479 счет.
			Если УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажиИДоПогашенияПрочихРезидентов Тогда
				МенеджерЗаписиПартий.Переоценка = МенеджерЗаписиПартий.Стоимость + МенеджерЗаписиПартий.Переоценка - ТекСтоимость - МенеджерЗаписиПартий.ДисконтПремияНачисленный;
			Иначе	
				МенеджерЗаписиПартий.Переоценка = (МенеджерЗаписиПартий.Стоимость + МенеджерЗаписиПартий.Переоценка + ВыборкаДетальныеЗаписи.РасходыПриПокупкеВСтоимостиОстаток) - ТекСтоимость - МенеджерЗаписиПартий.ДисконтПремияНачисленный;
			КонецЕсли;
			Если ТекРынок  = Перечисления.РынкиЦенныхБумаг.Акции Тогда
				Сообщить(МенеджерЗаписиПартий.Переоценка);
			КонецЕсли; 
			МенеджерЗаписиПартий.Стоимость  = ТекСтоимость;
	
		ИначеЕсли ТекРынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда 
			Сообщить("Не найден номинал ЦБ "+ТекЦБ);
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписейРегистра.Записать();
	НаборЗаписейРегистраПартий.Записать();

КонецПроцедуры
