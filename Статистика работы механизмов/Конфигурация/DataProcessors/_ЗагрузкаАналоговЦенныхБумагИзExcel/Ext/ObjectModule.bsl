// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Загрузка аналогов для ценных бумаг из Excel", 
		"0.13", 
		"", 
		Истина);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура НайтиИЗагрузитьЦенныеБумаги(ВнешниеДанные, Организация, Дата) Экспорт
			
	Запрос = Новый Запрос;
	
#Область Текст_Запроса

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаАналогов.Код КАК Код,
	|	_ТаблицаАналогов.ВидСправочника КАК ВидСправочника
	|ПОМЕСТИТЬ _Аналоги
	|ИЗ
	|	&ТаблицаАналогов КАК _ТаблицаАналогов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Аналоги.Код КАК КодБумаги,
	|	ВЫБОР
	|		КОГДА _Аналоги.ВидСправочника = ""Акции""
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)
	|		КОГДА _Аналоги.ВидСправочника = ""Облигации""
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
	|		КОГДА _Аналоги.ВидСправочника = ""Паи""
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Паи)
	|		КОГДА _Аналоги.ВидСправочника = ""ПроизводныеФинансовыеИнструменты""
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПустаяСсылка)
	|	КОНЕЦ КАК ГруппаОбъектов,
	|	_Аналоги.ВидСправочника = ""ПроизводныеФинансовыеИнструменты"" КАК ЭтоДериватив,
	|	_Аналоги.ВидСправочника КАК ВидСправочника
	|ИЗ
	|	_Аналоги КАК _Аналоги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
	|				&Период,
	|				ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)
	|					И Код В (&ТаблицаКодов)) КАК КодыВТорговыхСистемахСрезПоследних
	|		ПО _Аналоги.Код = КодыВТорговыхСистемахСрезПоследних.Код
	|ГДЕ
	|	КодыВТорговыхСистемахСрезПоследних.Код ЕСТЬ NULL";
	
#КонецОбласти

	Запрос.УстановитьПараметр("ТаблицаАналогов", 	ВнешниеДанные);
	Запрос.УстановитьПараметр("Период", 			Дата);                                                   	
	Запрос.УстановитьПараметр("ТаблицаКодов", 		ВнешниеДанные.Скопировать(,"Код"));
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Права на импорт есть не у всех
	УстановитьПривилегированныйРежим(Истина);
	
	ОбработкаИНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
	
	ОбработкаИНСИ.Организация    = Организация;
	ОбработкаИНСИ.Подразделение  = Справочники.Подразделения.ГруппаКомпаний;
	ОбработкаИНСИ.Язык           = Справочники.Языки.Русский;
	ОбработкаИНСИ.ГруппаПравил   = "Матрих";
	
	ОбработкаИНСИ.НеСообщатьОСозданииНовыхОбъектов = Истина;
	
	МассивКодовВыгруженныхБумаг = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//Бумага может торговаться в разных режимах. Исключим повторную попытку загрузки.
		Если Не МассивКодовВыгруженныхБумаг.Найти(Выборка.КодБумаги) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПустаяСсылка() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось загрузить ценную бумагу [" + Выборка.КодБумаги + "]. Не удалось определить рынок для ценной бумаги по виду справочника [" + Выборка.ВидСправочника + "]!");
			Продолжить;
		КонецЕсли;
		
		ОбработкаИНСИ.ГруппаОбъектов = Выборка.ГруппаОбъектов;		
		ДанныеНовогоОбъекта = ОбработкаИНСИ.ПолучитьДанныеДляВыбора(Выборка.КодБумаги);
		
		Если ДанныеНовогоОбъекта.Количество() > 0 Тогда
			
			Для Каждого НовыйОбъект Из ДанныеНовогоОбъекта Цикл
								
				Если Выборка.ЭтоДериватив Тогда
					Код = НовыйОбъект.Наименование;
				Иначе 
					Код = НовыйОбъект.Код;
				КонецЕсли;
				
				Если Код = Выборка.КодБумаги Тогда 
					
					СтрокаИмпортируемыйОбъект = ОбработкаИНСИ.ИмпортируемыеОбъекты.Добавить();
					СтрокаИмпортируемыйОбъект.КодВоВнешнейСистеме = НовыйОбъект.Идентификатор;
					СтрокаИмпортируемыйОбъект.Объект			  = НовыйОбъект.Объект;
					ЗагруженныйОбъект = ОбработкаИНСИ.ИмпортироватьДанные();
					
					Если ЗагруженныйОбъект.Количество() = 1 Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружена новая ценная бумага [" + ЗагруженныйОбъект[0].Наименование + "]. " + ?(Выборка.ЭтоДериватив, "", "Дата регистрации [" + Формат(ЗагруженныйОбъект[0].ДатаРегистрации, "ДЛФ =Д")  + " г]. Код [" + Выборка.КодБумаги + "]. ") + "Возможно, необходимо загрузить котировки!");
						МассивКодовВыгруженныхБумаг.Добавить(Выборка.КодБумаги);
						ОбработкаИНСИ.ИмпортируемыеОбъекты.Очистить();
					Иначе
						
						Для Каждого Объект Из ЗагруженныйОбъект Цикл
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке ценной бумаги. По коду [" + Выборка.КодБумаги + "] загружено " + ЗагруженныйОбъект.Количество() + " бумаг. [" + ЗагруженныйОбъект[0].Наименование + "]"); 
						КонецЦикла; 
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти ценную бумагу по коду [" + Выборка.КодБумаги + "].");
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //НайтиИЗагрузитьЦенныеБумаги()
