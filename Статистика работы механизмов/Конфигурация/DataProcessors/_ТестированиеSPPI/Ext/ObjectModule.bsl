// Получение области таблицы условий договора табличного документа
Функция ПолучитьОбластьТаблицыУсловийДоговора(Макет, НомерОписанияТабличногоДокумента, ПриоритетныйОтвет)
	ОбластьЗаголовкиУсловийДоговора = Макет.ПолучитьОбласть("ЗаголовкиУсловийДоговора");
	ОбластьСтрокаУсловийДоговора = Макет.ПолучитьОбласть("СтрокаУсловийДоговора");
	ТекущиеНастройкиОтветов = НастройкиОтветов.НайтиСтроки(
		Новый Структура("НомерОписанияТабличногоДокумента", НомерОписанияТабличногоДокумента));
	ПриоритетныйОтвет = 0; // Приоритет: ПометкаНет (0) -> ПометкаВопросКОбсуждению (1) -> ПометкаДа (2) (самый приоритетный)
	ОбластиТаблицыУсловийДоговора = Новый ТабличныйДокумент;
	ОбластиТаблицыУсловийДоговора.Вывести(ОбластьЗаголовкиУсловийДоговора);
	Для Каждого СтрокаНастройкиОтветов Из ТекущиеНастройкиОтветов Цикл
		ТекущийОтвет = КритерииТестирования[СтрокаНастройкиОтветов.НомерКритерияТестирования - 1];
		ОбластьСтрокаУсловийДоговора.Параметры.Номер = СтрокаНастройкиОтветов.Порядок;
		ОбластьСтрокаУсловийДоговора.Параметры.УсловияДоговора = ТекущийОтвет.УсловияДоговора;
		ОбластьСтрокаУсловийДоговора.Параметры.Описание = ТекущийОтвет.Описание;
		ОбластьСтрокаУсловийДоговора.Параметры.ПометкаДа =
			?(СтрокаНастройкиОтветов.Ответ = ПредопределенноеЗначение("Перечисление.ОтветыТестированияSPPI.Да"), "v", "");
		ОбластьСтрокаУсловийДоговора.Параметры.ПометкаНет =
			?(СтрокаНастройкиОтветов.Ответ = ПредопределенноеЗначение("Перечисление.ОтветыТестированияSPPI.Нет"), "v", "");
		ОбластьСтрокаУсловийДоговора.Параметры.ПометкаВопросКОбсуждению =
			?(СтрокаНастройкиОтветов.Ответ = ПредопределенноеЗначение("Перечисление.ОтветыТестированияSPPI.ВопросКОбсуждению"), "v", "");
		Если ПриоритетныйОтвет < 2 И СтрокаНастройкиОтветов.Ответ = ПредопределенноеЗначение("Перечисление.ОтветыТестированияSPPI.Да") Тогда
			ПриоритетныйОтвет = 2;
		ИначеЕсли ПриоритетныйОтвет < 1 И СтрокаНастройкиОтветов.Ответ = ПредопределенноеЗначение("Перечисление.ОтветыТестированияSPPI.ВопросКОбсуждению") Тогда
			ПриоритетныйОтвет = 1;
		КонецЕсли;
		ОбластиТаблицыУсловийДоговора.Вывести(ОбластьСтрокаУсловийДоговора);
	КонецЦикла;
	Возврат ОбластиТаблицыУсловийДоговора;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Команды

Процедура АвтоматическаяОтправкаРезультатаТестирования(Ошибки = Неопределено)
	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Массив;
	КонецЕсли;
	Если ПустаяСтрока(ЭтотОбъект.АдресаЭлектроннойПочты) Тогда
		Ошибки.Добавить("Параметр ""АдресаЭлектроннойПочты"" не заполнен.");
		Возврат;
	КонецЕсли;
	Попытка
		// Подготовка данных для создания отчёта
		ЭтотОбъект.СформироватьДанныеОЦенныхБумагах(Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат;
		КонецЕсли;
		// Создание и сохранение отчёта в папку (табличных документов, распределённых по Excel-файлам)
		ВыгруженныеФайлы = ВыгрузитьВExcel();
		Если ВыгруженныеФайлы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		// Отправка уведомлений на почту
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Кому", ЭтотОбъект.АдресаЭлектроннойПочты);
		ПараметрыПисьма.Вставить("Тема", "Произведено тестирование SPPI");
		ПараметрыПисьма.Вставить("Тело", "Сформированные документы сохранены в директории: """ + ЭтотОбъект.ПутьВыгрузкиВExcel + """");
		ПараметрыПисьма.Вставить("ТипТекста", ПредопределенноеЗначение("Перечисление.ТипыТекстовЭлектронныхПисем.ПростойТекст"));
		Вложения = Новый Соответствие;
		Для Каждого ВыгруженныйФайл Из ВыгруженныеФайлы Цикл
			ВременноеХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВыгруженныйФайл.ПолноеИмя));
			Вложения.Вставить(ВыгруженныйФайл.Имя, ВременноеХранилище);
		КонецЦикла;
		ПараметрыПисьма.Вставить("Вложения", Вложения);
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(
			РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	Исключение
		Ошибки.Добавить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура АвтоматическаяОтправкаУведомления(Ошибки = Неопределено)
	// Параметр "Организация"
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		Ошибки.Добавить("Параметр ""Организация"" не заполнен.");
	КонецЕсли;
	// Параметр "Период" ("ДатаНачала", "ДатаОкончания")
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаНачала) Или Не ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаОкончания) Тогда
		Ошибки.Добавить("Параметр ""Период"" не заполнен.");
	КонецЕсли;
	// Параметр "СчетаДоверительногоУправления"
	Если ЭтотОбъект.СчетаДоверительногоУправления.Количество() = 0
		Или Не ЗначениеЗаполнено(ЭтотОбъект.СчетаДоверительногоУправления[0].Ссылка)
	Тогда
		Ошибки.Добавить("Параметр ""СчетаДоверительногоУправления"" не заполнен.");
	КонецЕсли;
	// Параметр "АдресаЭлектроннойПочты"
	Если ПустаяСтрока(ЭтотОбъект.АдресаЭлектроннойПочты) Тогда
		Ошибки.Добавить("Параметр ""АдресаЭлектроннойПочты"" не заполнен.");
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область Запрос
		"ВЫБРАТЬ
		|	УчетныеАктивыЕПС.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _УчетныеАктивыЕПСУдерживаемыеДоПогашения
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	УчетныеАктивыЕПС.Родитель В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	УчетныеАктивыЕПС.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОбороты.Период, ДЕНЬ) КАК ДатаПокупки,
		|	БухПартииЦенныхБумагОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК Облигация
		|ПОМЕСТИТЬ _ОблигацииДляТестирования
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(
		|			НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ),
		|			ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ), ДЕНЬ, 14),
		|			РЕГИСТРАТОР,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И УчетныйАктивЕПС В
		|					(ВЫБРАТЬ
		|						_УчетныеАктивыЕПСУдерживаемыеДоПогашения.Ссылка
		|					ИЗ
		|						_УчетныеАктивыЕПСУдерживаемыеДоПогашения)) КАК БухПартииЦенныхБумагОбороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОбороты.Регистратор) В (ТИП(Документ.Сделка), ТИП(Документ.ИсполнениеОбязательствПоСделке), ТИП(Документ.ПоставкаЦенныхБумаг))
		|	И (НЕ БухПартииЦенныхБумагОбороты.Регистратор ССЫЛКА Документ.Сделка
		|			ИЛИ ВЫРАЗИТЬ(БухПартииЦенныхБумагОбороты.Регистратор КАК Документ.Сделка).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка))
		|	И (НЕ БухПартииЦенныхБумагОбороты.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|			ИЛИ ВЫРАЗИТЬ(БухПартииЦенныхБумагОбороты.Регистратор КАК Документ.ИсполнениеОбязательствПоСделке).ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка))
		|	И (НЕ БухПартииЦенныхБумагОбороты.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ИЛИ ВЫРАЗИТЬ(БухПартииЦенныхБумагОбороты.Регистратор КАК Документ.ПоставкаЦенныхБумаг).ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход))
		|	И БухПартииЦенныхБумагОбороты.КоличествоПриход > 0
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ОблигацииДляТестированияSPPI.ДатаПокупки,
		|	ОблигацииДляТестированияSPPI.СчетДоверительногоУправления,
		|	ОблигацииДляТестированияSPPI.Облигация
		|ИЗ
		|	РегистрСведений.ОблигацииДляТестированияSPPI КАК ОблигацииДляТестированияSPPI
		|ГДЕ
		|	ОблигацииДляТестированияSPPI.Организация = &Организация
		|	И ОблигацииДляТестированияSPPI.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
		|	И ОблигацииДляТестированияSPPI.ДатаПокупки >= НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
		|	И ОблигацииДляТестированияSPPI.ДатаПокупки <= КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(УсловияСделок.Период, ДЕНЬ) КАК ДатаПокупки,
		|	УсловияСделок.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделок.ЦеннаяБумага КАК Облигация
		|ИЗ
		|	РегистрСведений.УсловияСделок КАК УсловияСделок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОблигацииДляТестирования КАК _ОблигацииДляТестирования
		|		ПО (НАЧАЛОПЕРИОДА(УсловияСделок.Период, ДЕНЬ) = _ОблигацииДляТестирования.ДатаПокупки)
		|			И УсловияСделок.СчетДоверительногоУправления = _ОблигацииДляТестирования.СчетДоверительногоУправления
		|			И ((ВЫРАЗИТЬ(УсловияСделок.ЦеннаяБумага КАК Справочник.Облигации)) = _ОблигацииДляТестирования.Облигация)
		|ГДЕ
		|	УсловияСделок.Период >= НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
		|	И УсловияСделок.Период <= КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И УсловияСделок.Организация = &Организация
		|	И УсловияСделок.СчетДоверительногоУправления В(&СчетаДоверительногоУправления)
		|	И УсловияСделок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|	И УсловияСделок.Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|	И УсловияСделок.Количество > 0
		|	И _ОблигацииДляТестирования.Облигация ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПокупки,
		|	СчетДоверительногоУправления,
		|	Облигация";
	#КонецОбласти
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", ЭтотОбъект.СчетаДоверительногоУправления.ВыгрузитьКолонку("Ссылка"));
	Выборка = Запрос.Выполнить().Выбрать();
	ПериодОднодневный = ЭтотОбъект.Период.ДатаНачала = ЭтотОбъект.Период.ДатаОкончания;
	ПериодТекстом = ?(ПериодОднодневный,
		Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"),
		"период с " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по "
			+ Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	ТелоПисьма = "За " + ПериодТекстом + " произошли покупки облигаций, для которых нужно проверить, нужно ли включать их в тестирование SPPI:";
	КоличествоСтрокОблигаций = 0;
	Пока Выборка.Следующий() Цикл
		ТелоПисьма = ТелоПисьма + Символы.ПС + Символы.Таб + ?(ПериодОднодневный, "[" + Формат(Выборка.ДатаПокупки, "ДФ=dd.MM.yyyy") + "] - ", "")
			+ Строка(Выборка.СчетДоверительногоУправления) + " - " + Строка(Выборка.Облигация);
		КоличествоСтрокОблигаций = КоличествоСтрокОблигаций + 1;
	КонецЦикла;
	// Отправка уведомлений на почту
	Если КоличествоСтрокОблигаций > 0 Тогда
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Кому", ЭтотОбъект.АдресаЭлектроннойПочты);
		ПараметрыПисьма.Вставить("Тема", "Нужно проверить облигации для тестирования SPPI");
		ПараметрыПисьма.Вставить("Тело", ТелоПисьма);
		ПараметрыПисьма.Вставить("ТипТекста", ПредопределенноеЗначение("Перечисление.ТипыТекстовЭлектронныхПисем.ПростойТекст"));
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(
			РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
		Сообщить("Уведомление о необходимости проверки (" + КоличествоСтрокОблигаций + ") облигаций успешно отправлено.");
	Иначе
		Сообщить("Нет облигаций, которые необходимо проверить. Уведомление не требуется.");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
