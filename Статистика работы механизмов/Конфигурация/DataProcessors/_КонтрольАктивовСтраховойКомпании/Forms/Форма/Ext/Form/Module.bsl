&НаСервере
Процедура ДоляНедвижимогоИмуществаНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив
		|ПОМЕСТИТЬ _РаспределенныеАктивыСтраховойКомпании
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.НедвижимоеИмущество)
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета, 0) > ЕСТЬNULL(ОценкиСтоимостьИмуществаСрезПоследних.Стоимость, 0)
		|				И ЕСТЬNULL(ОценкиСтоимостьИмуществаСрезПоследних.Стоимость, 0) > 0
		|			ТОГДА ЕСТЬNULL(ОценкиСтоимостьИмуществаСрезПоследних.Стоимость, 11)
		|		ИНАЧЕ ЕСТЬNULL(РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета, 12)
		|	КОНЕЦ КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	_РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостьИмущества.СрезПоследних(&Период, ) КАК ОценкиСтоимостьИмуществаСрезПоследних
		|		ПО (ОценкиСтоимостьИмуществаСрезПоследних.Имущество = РаспределенныеАктивыСтраховойКомпании.Актив)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_ПрочиеАктивы.СуммаВВалютеУчета), 0) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_ПрочиеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_ПрочиеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ
		|	&ОбъемСредств > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Актив,
		|	_ПрочиеАктивы.СуммаВВалютеУчета
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Недвижимое имущество");
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
			СтатусПроверки = 3;
	КонецЕсли; 
		
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении для указанных разделов на выбранную дату не фигурирует недвижимое имущество";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
