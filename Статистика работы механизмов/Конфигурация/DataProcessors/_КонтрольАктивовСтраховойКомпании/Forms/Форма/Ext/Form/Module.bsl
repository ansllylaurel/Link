&НаКлиенте
Процедура КомандаСформироватьОтчетXTDD(Команда)
	
	Если ЭтаФорма.КаталогДанных = "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран каталог для файла отчетности");
		Возврат;
	КонецЕсли;
	
	ИнициализироватьXSDСхему();
	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);

	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаXSDСхемы);

	// Чтение документа из схемы
	RegExp = Новый COMОбъект("VBScript.RegExp");	
	XSDСхема = Новый COMОбъект("Msxml2.DOMDocument");
	XSDСхема.Load(ИмяФайлаXSDСхемы);
	
	СтруктураДокумента = Новый Структура();
	
	
	СтруктураДокумента.Вставить("ИмяОтчета"			, "ОКУД0420871");
	СтруктураДокумента.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420871_ОКУД0420871");
	СтруктураДокумента.Вставить("ВерсияОтчета"			, "2.16.3");
	СтруктураДокумента.Вставить("Отчет"				, Новый Структура);

	
	ПакетОтчетность = Новый Структура();
	ПакетОтчетность.Вставить("ДатаПредоставленияОтчета", Формат(Объект.Период, "ДФ=yyyy-MM-dd"));
	
	СтруктураДокумента.Отчет.Вставить("Лист_СведОВыполненТребов", ПолучитьШапкуОтчетаДК(ПакетОтчетность));
	
	НаименованиеРаздела = "Раздел1"; 
	Раздел = Новый Структура();
	
	ЭлементРаздел = ПолучитьЭлементТипаПоИмениЭкземпляраЭлемента(НаименованиеРаздела, XSDСхема,  RegExp);
	
	ЗаполнитьЭкземплярТипа(
			НаименованиеРаздела, 
			Раздел, 
			ЭлементРаздел, XSDСхема, RegExp);
			
	ПолучитьДанныеРаздела1(Раздел);
	
	СтруктураДокумента.Отчет.Лист_СведОВыполненТребов.Вставить(НаименованиеРаздела, Раздел);
	
	НаименованиеРаздела = "Раздел2"; 	
	Раздел = Новый Структура(); 		
	
	ЭлементРаздел = ПолучитьЭлементТипаПоИмениЭкземпляраЭлемента(НаименованиеРаздела, XSDСхема,  RegExp);
	ЗаполнитьЭкземплярТипа(
			НаименованиеРаздела, 
			Раздел, 
			ЭлементРаздел, XSDСхема, RegExp); 
	                                           
	//выражение .+ в VB. regexp не включает переводы строк при поиске в многострочном тексте, нужно использовать [\s,\S]
	RegExp.Pattern = "";
	RegExp.Pattern = RegExp.Pattern + "";
	RegExp.Pattern = RegExp.Pattern + "<xs:complexType name=\""Таб2_3_Таб2_3_Таб2_3Стр[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""[\s,\S]+?\|([\s,\S]+?)<[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""[\s,\S]+?\|([\s,\S]+?)<[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""(\S+)?""[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""(\S+)?""[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""(\S+)?""[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""(\S+)?""[\s,\S]+?";
	RegExp.Pattern = RegExp.Pattern + "<xs:element name=\""(\S+)?""[\s,\S]+?";
	
	RegExp.Multiline = Истина;
	МакетТаблицыРаздела = ПолучитьМакетСхемыТаблицыРаздела(XSDСхема, RegExp, 7);
	RegExp.Multiline = Ложь;    	
	
	ЗначенияПолейДанных = ПолучитьДанныеРаздела22( МакетТаблицыРаздела );   	
	
	Для Каждого ПараПолеЗначение из ЗначенияПолейДанных Цикл
		
		УстановитьЗначениеЭлемента(Раздел, ПараПолеЗначение.Ключ, ПараПолеЗначение.Значение);  
		
	КонецЦикла;
	
	СтруктураДокумента.Отчет.Лист_СведОВыполненТребов.Вставить(НаименованиеРаздела, Раздел);

	
	НаименованиеРаздела = "Раздел3"; 	
	Раздел = Новый Структура();
	
	ЭлементРаздел = ПолучитьЭлементТипаПоИмениЭкземпляраЭлемента(НаименованиеРаздела, XSDСхема,  RegExp);
	ЗаполнитьЭкземплярТипа(
			НаименованиеРаздела, 
			Раздел, 
			ЭлементРаздел, XSDСхема, RegExp);
			
			
	МассивОписанийСтрок = Новый Массив();
	
	#Область ФормированиеСопоставленийИменЭлементовXML_и_РезультатовПроверок
	
	// Схема таблицы Раздела 3 слишком сложная, большое число групп, поэтому разбор схемы производится в два этапа
	// 1. Собираем массив описаний типов строк таблицы 3го раздела
	
	RegExp.Multiline = Истина;
	RegExp.Pattern = "<xs:complexType name=\""Таб3_1_Таб3_1Строка\d+[\s,\S]+?</xs:complexType>";
	МассивОписанийТиповСтрок = ПолучитьМакетСхемыТаблицыРаздела(XSDСхема, RegExp);
	
	RegExp.Pattern = "element name=\""(\S+)\""[\S,\s]+?<description>.+?\|([\S,\s]+?)</description>";	
	                 //  element name=\"(\S+)\"[\S,\s]+?<description>.+?\|([\S,\s]+?)</description>
	//1 элемент - Наименование
	//2			- Обозначение
	//3			- Номер соотношения
	//4			- Сумма 
	//5			- База
	//6			- Предельный коэффициент
	//7			- Фактический коэффициент
	//8			- Номер соотношения для СС
	//9			- Сумма в собственных средствах (СС)
	//10		- База в размере норматива
	//11		- База сверх норматива
	//12		- Предельный коэффициент (СС)
	//13		- Фактический коэффициент (СС) 
	// Есть сложности с выбором, какую именно колонку заполнять 10 или 11? 
	// Чтобы не усложнять логику, предположим, что, если в колонке 10 указано значение по умолычанию " |x", выбирать нужно колонку 11 
	 
	
	Для Каждого ОписаниеТипаСтроки из МассивОписанийТиповСтрок Цикл
		
		МассивЗначенийЭлементовТипа =  РазобратьТекстСПомощьюРегулярныхВыражений(ОписаниеТипаСтроки.Группа01, RegExp);			
		ОписаниеСтроки = Новый Структура();
		
		Позиция = 1;
		
		Для Каждого ЗначениеЭлементаТипа из МассивЗначенийЭлементовТипа Цикл 			
			
			Если Позиция = 1 Тогда
				ОписаниеСтроки.Вставить("Наименование", ЗначениеЭлементаТипа.Группа11);				
			ИначеЕсли Позиция = 2 Тогда
				ОписаниеСтроки.Вставить("КодСтроки", ЗначениеЭлементаТипа.Группа11);
			ИначеЕсли Позиция = 4 Тогда
				ОписаниеСтроки.Вставить("СтраховыеРезервыСуммаИмяПоля", ЗначениеЭлементаТипа.Группа01);
			ИначеЕсли Позиция = 5 Тогда
				ОписаниеСтроки.Вставить("СтраховыеРезервыБазаИмяПоля", ЗначениеЭлементаТипа.Группа01);
			ИначеЕсли Позиция = 7 Тогда
				ОписаниеСтроки.Вставить("СтраховыеРезервыПоказательИмяПоля", ЗначениеЭлементаТипа.Группа01);
			ИначеЕсли Позиция = 9 Тогда
				ОписаниеСтроки.Вставить("СобственныеСредстваСуммаИмяПоля", ЗначениеЭлементаТипа.Группа01);
			ИначеЕсли Позиция = 10 Тогда
				ОписаниеСтроки.Вставить("СобственныеСредстваНормативБазаИмяПоля", ЗначениеЭлементаТипа.Группа01);				
				ОписаниеСтроки.Вставить("СобственныеСредстваНормативБазаЗначение", ЗначениеЭлементаТипа.Группа11) 			
			ИначеЕсли Позиция = 11 Тогда
				ОписаниеСтроки.Вставить("СобственныеСредстваСверхНормБазаИмяПоля", ЗначениеЭлементаТипа.Группа01);
			ИначеЕсли Позиция = 13 Тогда
				ОписаниеСтроки.Вставить("СобственныеСредстваПоказательИмяПоля", ЗначениеЭлементаТипа.Группа01);
			КонецЕсли;
				
			Позиция = Позиция + 1;
			
		КонецЦикла;  			
		МассивОписанийСтрок.Добавить(ОписаниеСтроки);
		
	КонецЦикла;
	
	#КонецОбласти
	
	ЗначенияПолейДанных = ПолучитьДанныеРаздела3( МассивОписанийСтрок );
	
	Для Каждого ПараПолеЗначение из ЗначенияПолейДанных Цикл
		
		УстановитьЗначениеЭлемента(Раздел, ПараПолеЗначение.Ключ, ПараПолеЗначение.Значение);  
		
	КонецЦикла;
	
	СтруктураДокумента.Отчет.Лист_СведОВыполненТребов.Вставить(НаименованиеРаздела, Раздел);

	СформироватьXML( XSDСхема, СтруктураДокумента, КаталогДанных );

КонецПроцедуры

