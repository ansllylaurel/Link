Перем СправочныеПоказателиНаСервере;
Перем РасчетныеПоказателиНаСервере;
Перем НеФормироватьHTML;

//&НаСервереБезКонтекста
Процедура ЗарегистрироватьРейтингВТаблице(ТаблицаРейтингов, Рейтинг, Агентство, Шкала = "")
	
	НоваяСтрокаТаблицаРейтингов = ТаблицаРейтингов.Добавить();
	
	НоваяСтрокаТаблицаРейтингов.Шкала = ?(Метаданные.РегистрыСведений.Рейтинги.Измерения.Шкала.Тип.СодержитТип(Тип("СправочникСсылка.ШкалыРейтинговыхАгентств")),
		Справочники.ШкалыРейтинговыхАгентств.НайтиПоНаименованию(Шкала,,, Агентство),
		Справочники.РейтинговыеАгентства.НайтиПоНаименованию(Прав(Шкала, 25)));
		
	НоваяСтрокаТаблицаРейтингов.РейтинговоеАгентство = Агентство;
	НоваяСтрокаТаблицаРейтингов.Рейтинг              = Рейтинг;
	НоваяСтрокаТаблицаРейтингов.УровеньРейтинга      = РегистрыСведений.Рейтинги.ПолучитьУровеньРейтинга(Агентство, Рейтинг);
	
	Если Не ЗначениеЗаполнено(НоваяСтрокаТаблицаРейтингов.Шкала) Тогда
		ВызватьИсключение "Не удалось шкалу по наименованию '" + Шкала + "' агентства '" + Агентство + "'";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяСтрокаТаблицаРейтингов.УровеньРейтинга) Тогда
		ВызватьИсключение "Не удалось определить уровень рейтинга '" + Рейтинг + "' агентства '" + Агентство + "' по шкале '" + Шкала + "'";
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьРейтингВТаблице

//&НаСервереБезКонтекста
Функция СформироватьШапкуТаблицыВФорматеHTML(Колонки, Отступы)

	ШапкаТаблицыHTML = Отступы[1] + "<tr>";
	
	Для каждого Колонка Из Колонки Цикл
		ШапкаТаблицыHTML = ШапкаТаблицыHTML + Отступы[2] + "<th>" + ?(ПустаяСтрока(Колонка.Имя), Колонка.Синоним, Колонка.Имя) + "</th>"
	КонецЦикла;
		
	ШапкаТаблицыHTML = ШапкаТаблицыHTML + Отступы[1] + "</tr>";
	
	Возврат ШапкаТаблицыHTML;

КонецФункции // СформироватьШапкуТаблицыВФорматеHTML

//&НаСервереБезКонтекста
Функция СформироватьСтрокуТаблицыВФорматеHTML(Строка, Колонки, Отступы, Уровень = 0, ЕстьПодчиненныеСтроки = Ложь)
	
	СтрокаТаблицыHTML = Отступы[1] + "<tr>";
	
	Для Инд = 0 По ?(Не ЕстьПодчиненныеСтроки, Колонки.Количество() - 1, Уровень) Цикл
		
		Колонка = Колонки[Инд];
		
		ЗнчКолонки = Строка[Колонка.Имя];
		
		Если Не ЗначениеЗаполнено(ЗнчКолонки) Тогда
			ЗнчКолонки = "&nbsp;";
		КонецЕсли;
		
		ТипЗнчКолонки = ТипЗнч(ЗнчКолонки);
					
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнчКолонки) Или Документы.ТипВсеСсылки().СодержитТип(ТипЗнчКолонки) Тогда
			СтрокаТаблицыHTML = СтрокаТаблицыHTML + Отступы[2] + "<td" + ?(ЕстьПодчиненныеСтроки, " colspan='" + (Колонки.Количество() - Уровень) + "'", "") + "><A href='" + ПолучитьНавигационнуюСсылку(ЗнчКолонки) + "'>" + ЗнчКолонки + "</A></td>";
		Иначе
			СтрокаТаблицыHTML = СтрокаТаблицыHTML + Отступы[2] + "<td>" + ЗнчКолонки + "</td>";
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаТаблицыHTML = СтрокаТаблицыHTML + Отступы[1] + "</tr>";

	Возврат СтрокаТаблицыHTML;
	
КонецФункции // СформироватьСтрокуТаблицыВФорматеHTML

//&НаСервереБезКонтекста
Функция ТаблицаВФорматеHTML(Знач Таблица, Заголовок = "")
	
	Если НеФормироватьHTML <> Неопределено Тогда 
		Если НеФормироватьHTML Тогда
			Возврат "";	
		КонецЕсли;	
	КонецЕсли;	

	
	Отступы = Новый Массив;
	Отступы.Добавить(Символы.ПС);
	Отступы.Добавить(Символы.ПС + Символы.Таб);
	Отступы.Добавить(Символы.ПС + Символы.Таб + Символы.Таб);

	Если      ТипЗнч(Таблица) = Тип("ДанныеФормыКоллекция") Тогда
		Таблица = Таблица.Выгрузить();
	ИначеЕсли ТипЗнч(Таблица) = Тип("ХранилищеЗначения") Тогда
		Таблица = Таблица.Получить();
	КонецЕсли;
	
	ТаблицаВФорматеHTML = "<table border='1' cellpadding='2' cellspacing='0'>";
	
	// заголовок таблицы
	Если Не ПустаяСтрока(Заголовок) Тогда
		ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + "<caption>" + Заголовок + "</caption>";
	КонецЕсли;
	
	// шапка таблицы
	ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + СформироватьШапкуТаблицыВФорматеHTML(Таблица.Колонки, Отступы);
	
	// строки таблицы
	Для каждого СтрокаТаблицы Из Таблица Цикл
		ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + СформироватьСтрокуТаблицыВФорматеHTML(СтрокаТаблицы, Таблица.Колонки, Отступы);
	КонецЦикла;
	
	ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + "</table>";
	
	Возврат ТаблицаВФорматеHTML;
	
КонецФункции // ТаблицаВФорматеHTML

//&НаСервереБезКонтекста
Функция ДеревоВФорматеHTML(Знач Дерево, Заголовок = "", Уровень = 0, Колонки = Неопределено, ТаблицаВФорматеHTML = "")
	
	Если НеФормироватьHTML <> Неопределено Тогда 
		Если НеФормироватьHTML Тогда
			Возврат "";	
		КонецЕсли;	
	КонецЕсли;	   
	
	Отступы = Новый Массив;
	Отступы.Добавить(Символы.ПС);
	Отступы.Добавить(Символы.ПС + Символы.Таб);
	Отступы.Добавить(Символы.ПС + Символы.Таб + Символы.Таб);

	Если Колонки = Неопределено Тогда
		Колонки = Дерево.Колонки;
	КонецЕсли;
	
	Если Уровень = 0 Тогда
		
		ТаблицаВФорматеHTML = "<table border='1' cellpadding='2' cellspacing='0'>";
		
		// заголовок таблицы
		Если Не ПустаяСтрока(Заголовок) Тогда
			ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + "<caption>" + Заголовок + "</caption>";
		КонецЕсли;
		
		// шапка таблицы
		ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + СформироватьШапкуТаблицыВФорматеHTML(Колонки, Отступы);
		
	КонецЕсли;

	Для каждого Строка Из Дерево.Строки Цикл
		
		ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + СформироватьСтрокуТаблицыВФорматеHTML(Строка, Колонки, Отступы, Уровень, (Строка.Строки.Количество() > 0));
		
		ДеревоВФорматеHTML(Строка,, Уровень + 1, Колонки, ТаблицаВФорматеHTML);
		
	КонецЦикла;
	
	Если Уровень = 0 Тогда
		ТаблицаВФорматеHTML = ТаблицаВФорматеHTML + "</table>";
	КонецЕсли;
	
	Возврат ТаблицаВФорматеHTML;
	
КонецФункции // ДеревоВФорматеHTML

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОписаниеСтатусаПроверки(СтатусПроверки)
	
	Если      СтатусПроверки = 0 Тогда
		ОписаниеСтатусПроверки = "Не выполнялась";
	ИначеЕсли СтатусПроверки = 1 Тогда
		ОписаниеСтатусПроверки = "Пройдена";
	ИначеЕсли СтатусПроверки = 2 Тогда
		ОписаниеСтатусПроверки = "Не пройдена";
	ИначеЕсли СтатусПроверки = 3 Тогда
		ОписаниеСтатусПроверки = "Пройдена с предупреждениями";
	Иначе
		ОписаниеСтатусПроверки = "Ошибка определения статуса";
	КонецЕсли;	
	
	Возврат ОписаниеСтатусПроверки;
	
КонецФункции // ПолучитьОписаниеСтатусаПроверки

&НаСервере
Процедура ЗарегистрироватьРезультатПроверкиНаСервере(Ключ, СтатусПроверки, Расшифровка, СтоимостьРасчетная, СтоимостьБазовая, ФактическоеЗначение)
	
	ПроцедураНайдена = Истина;
	
	Для каждого СтрокаПроверки Из ЭтаФорма.Проверки Цикл
		Если СтрокаПроверки.Ключ = Ключ Тогда
			ПроцедураНайдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПроцедураНайдена Тогда
		ВызватьИсключение "Не удалось найти процедуру проверки по ключу '" + Ключ + "'";
	КонецЕсли;
	
	СтрокаПроверки.СтатусПроверки          = СтатусПроверки;
	СтрокаПроверки.Расшифровка             = "<h1>" + ПолучитьОписаниеСтатусаПроверки(СтатусПроверки) + "</h1>" + Расшифровка;
	СтрокаПроверки.ОписаниеСтатусаПроверки = ПолучитьОписаниеСтатусаПроверки(СтатусПроверки);
	СтрокаПроверки.СтоимостьРасчетная	   = СтоимостьРасчетная;
	СтрокаПроверки.СтоимостьБазовая	  	   = СтоимостьБазовая;
	СтрокаПроверки.ФактическоеЗначение	   = ФактическоеЗначение;
	
	
КонецПроцедуры // ЗарегистрироватьРезультатПроверкиНаСервере

&НаСервере
Функция ВывестиРезультатКонтроляНаСервере()
	// Вставить содержимое обработчика.
	
	HTML = "<h1>Контроль активов страховой компании</h1>";
	
	Для каждого СтрокаПроверки из ЭтаФорма.Проверки Цикл
		   HTML = HTML + "Контрольный показатель:<br><b>" + СтрокаПроверки.Синоним + "</b><br>Статус проверки: ";
		   HTML = HTML + СтрокаПроверки.Расшифровка;
		   HTML = HTML + "<hr>";
		
	КонецЦикла;
	
	
	возврат HTML;
	
КонецФункции

&НаСервере
Процедура ДобавитьПроверкуВТаблицуНаСервере(Ключ, ИмяПроцедуры = Неопределено, Синоним, Описание, КодПроверки, ЭтоСобственныеСредства = Ложь)
	
	НоваяСтрокаПроверка = ЭтаФорма.Проверки.Добавить();
	
	НоваяСтрокаПроверка.Ключ                    = Ключ;
	НоваяСтрокаПроверка.ИмяПроцедуры            = ?(ИмяПроцедуры = Неопределено, Ключ, ИмяПроцедуры);
	НоваяСтрокаПроверка.Синоним                 = Синоним;
	НоваяСтрокаПроверка.СтатусПроверки          = 0;
	НоваяСтрокаПроверка.ОписаниеСтатусаПроверки = ПолучитьОписаниеСтатусаПроверки(0);
	НоваяСтрокаПроверка.КодПроверки				= КодПроверки;	
	НоваяСтрокаПроверка.ЭтоСобственныеСредства	= ЭтоСобственныеСредства;
	
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		
		Для каждого КлючЗнч Из Описание Цикл
			
			Если Лев(КлючЗнч.Значение, 1) <> "$" Тогда
				НоваяСтрокаПроверка.Описание = НоваяСтрокаПроверка.Описание + ?(ПустаяСтрока(НоваяСтрокаПроверка.Описание), "", Символы.ПС) + КлючЗнч.Ключ + ": ";
				НоваяСтрокаПроверка.Описание = НоваяСтрокаПроверка.Описание + ?(ТипЗнч(КлючЗнч.Значение) = Тип("Массив"), РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(КлючЗнч.Значение, ", "), Строка(КлючЗнч.Значение));
			КонецЕсли;	
			
			НоваяСтрокаПроверка.Параметры.Добавить(КлючЗнч.Значение, КлючЗнч.Ключ);
						
		КонецЦикла;
		
	Иначе
		
		НоваяСтрокаПроверка.Описание = Описание;
		
	КонецЕсли;

КонецПроцедуры // ДобавитьПроверкуВТаблицуНаСервере

&НаСервере
Функция СправочныеПоказателиВФорматеHTMLНаСервере()
	
	СправочныеПоказателиНаСервере = ЭтаФорма.СправочныеПоказатели.Получить();
	
	ДокументHTML = "";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h1>Справочные показатели</h1>";

	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Источник биржевых котировок: " + СправочныеПоказателиНаСервере.ИсточникБиржевыхКотировок + "</h3>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Требуемый листинг ценных бумаг резидента РФ: " + СправочныеПоказателиНаСервере.ТребуемыйЛистингРезидентаРФ + "</h3>";
	
	ДокументHTML = ДокументHTML + Символы.ПС + ТаблицаВФорматеHTML(СправочныеПоказателиНаСервере.ДефолтныеРейтинги, "Дефолтные рейтинги");
	ДокументHTML = ДокументHTML + Символы.ПС + ТаблицаВФорматеHTML(СправочныеПоказателиНаСервере.МинимальноДопустимыеРейтинги, "Минимально допустимые рейтинги");
	
	Возврат ДокументHTML;
	
КонецФункции // СправочныеПоказателиВФорматеHTMLНаСервере

&НаСервере
Функция РасчетныеПоказателиВФорматеHTMLНаСервере()
	
	РасчетныеПоказателиНаСервере = ЭтаФорма.РасчетныеПоказатели.Получить();
	
	ДокументHTML = "";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h1>Расчетные показатели</h1>";
	
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Объем страховых резервов: " + Формат(РасчетныеПоказателиНаСервере.ОбъемСтраховыхРезервов, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
