Функция ПолучитьШапкуОтчетаДК( ПакетОтчет )
	
	Период = Объект.Период;
	Организация = Объект.Организация;
	СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация,
	|	Организации.ЮрФизЛицо КАК ЮрФизЛицо,
	|	Лицензии.ВидДеятельности КАК ВидДеятельности,
	|	Лицензии.Ссылка КАК Лицензия
	|ПОМЕСТИТЬ _ДействующиеЛицензииОрганизации
	|ИЗ
	|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
	|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо)
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолнНаименованиеСпецДеп,
	|	ЛицензияДепозитарнаяДеятельность.Лицензия.Номер КАК НомерЛицензииОсущДепДеят,
	|	ЛицензияСпецдепозитарий.Лицензия.Номер КАК НомерЛицензииПИФ_НПФ,
	|	""-"" КАК РегистрацНомерКредОрг,
	|	""45286596000"" КАК КодПо_ОКАТО,
	|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН1,
	|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН1,
	|	РеквизитыСтраховщиковСрезПоследних1.ПолноеНаименованиеПоУставу КАК НаименованиеСтраховщика,
	|	ДокументыСтраховщиковСрезПоследних.Номер КАК РегНомер,
	|	&Период КАК ДатаНарушения
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияСпецдепозитарий
	|		ПО Организации.Ссылка = ЛицензияСпецдепозитарий.Организация
	|			И (ЛицензияСпецдепозитарий.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиВКачествеСпециализированногоДепозитарияИнвестиционныхФондовИПИФ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияДепозитарнаяДеятельность
	|		ПО Организации.Ссылка = ЛицензияДепозитарнаяДеятельность.Организация
	|			И (ЛицензияДепозитарнаяДеятельность.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДепозитарнойДеятельности))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
	|		ПО (Организации.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|				И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)),
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСтраховщиковСрезПоследних1
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыСтраховщиковСрезПоследних1.ЮрФизЛицо
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыСтраховщиковСрезПоследних
	|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ДокументыСтраховщиковСрезПоследних.ЮрФизЛицо
	|				И (ДокументыСтраховщиковСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДокументыСтраховщиковСрезПоследних.ДействуетПо > &Период))
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", Период);	
	Запрос.УстановитьПараметр("Организация", Организация); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	ПараметрыДокумента = Запрос.Выполнить();
	ПоляДокумента = ПараметрыДокумента.Колонки;
	ВыборкаПараметрыДокумента = ПараметрыДокумента.Выбрать();
	
	Если ВыборкаПараметрыДокумента.Следующий() Тогда
		
		Для Каждого Колонка из ПоляДокумента Цикл
			ПакетОтчет.Вставить(Колонка.Имя, ВыборкаПараметрыДокумента[Колонка.Имя]);
		КонецЦикла; 		
		
	КонецЕсли;
	
	Возврат ПакетОтчет;

КонецФункции

&НаСервере
Функция ОпределитьКодыПоказателяАктива (Актив, Валюта, Организация, РезидентныйАктив, АктивВДоверительномУправлении)
	
	ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	Классификатор = Новый Массив();
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.БанковскиеСчета") Тогда			
		
		Классификатор.Добавить("080");	// Денежные средства
		
		Если Валюта = ВалютаРубли Тогда		
			Классификатор.Добавить("082");	// денежные средства в валюте Российской Федерации на счетах в кредитных организациях			
		Иначе
			Классификатор.Добавить("083");	// денежные средства в иностранной валюте на счетах в кредитных организациях
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.ПрочиеАктивы") Тогда
		
		Если Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.Кассы.Ссылка Тогда
			Классификатор.Добавить("080");	// Денежные средства
			Классификатор.Добавить("082");	// из них: наличные денежные средства в кассе
		КонецЕсли;
		
		Если Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.Займы.Ссылка Тогда
			
			Классификатор.Добавить("140");	// Предоставленные займы
			
			Если Актив.Код = "000000418" Тогда // 143. Займы СТРАХОВАТЕЛЯМ по договорам страхования жизни
				Классификатор.Добавить("143");	// страхователям - физическим лицам по договорам страхования жизни	
			Иначе
				Классификатор.Добавить("142");	//  другим организациям				
			КонецЕсли;	
				
		КонецЕсли;
		
		Если Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.ЗадолженностиСтрахованияИПерестрахования 
			ИЛИ  Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.Задолженности Тогда 			
			
			Если Актив.Код = "000000416" Тогда 			// 202. ДЗ страхователей по дог-ам ОГС и дог-ам, заключ. впорядке 44, 223, 260 ФЗ (из 200 строки)
				Классификатор.Добавить("202");			// дебиторская задолженность страхователей по договорам обязательного государственного страхования, дебиторская ...  	
			ИначеЕсли Актив.Код = "000000372" Тогда 	// 210. Дебиторская задолженность по операциям перестрахования
				Классификатор.Добавить("210");			// Дебиторская задолженность по операциям перестрахования 	
			ИначеЕсли Актив.Код = "000000080" Тогда 	// 200. Дебиторская задолженность по операциям страхования
				Классификатор.Добавить("200");			// Дебиторская задолженность по операциям страхования, сострахования
			ИначеЕсли Актив.Код = "000000368" Тогда 	// 201. ДЗ по операциям страхования, сострахования (Страхователи) (из строки 200)
				Классификатор.Добавить("201");			// из нее: страхователей
			ИначеЕсли Актив.Код = "000000369" Тогда 	// 203. ДЗ по операциям страхования, сострахования (Страховые агенты)  (из строки 200)
				Классификатор.Добавить("203");			// страховых агентов
			ИначеЕсли Актив.Код = "000000370" Тогда 	// 204. ДЗ по операциям страхования, сострахования (Страховые брокеры)  (из строки 200)
				Классификатор.Добавить("204");			// страховых брокеров
			ИначеЕсли Актив.Код = "000000371" Тогда 	// Дебиторская задолженность по операциям страхования, сострахования (Состраховщики)
				Классификатор.Добавить("205");			//состраховщиков 
			ИначеЕсли Актив.Код = "000000373" Тогда 	// 220. Дебиторская задолженность страховщиков по прямому возмещению убытков
				Классификатор.Добавить("220");			// Дебиторская задолженность страховщиков по прямому возмещению убытков
			ИначеЕсли Актив.Код = "000000002" Тогда		// 290. Отложенные налоговые активы
			    Классификатор.Добавить("290");			// Отложенные налоговые активы
			ИначеЕсли Актив.Код = "000000090" Тогда		// 330. Нематериальные активы
			    Классификатор.Добавить("330");			// Нематериальные активы			
			ИначеЕсли Актив.Код = "000000392" Тогда		// 332. Вложения в интеллектуальную собственность (из 330 строки)
			    Классификатор.Добавить("332");			//
			Иначе 
			    Классификатор.Добавить("230");			// Прочая дебиторская задолженность
			КонецЕсли;
			
		КонецЕсли;
		
		Если Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.ДолиПерестраховщиков Тогда
			
			Если Актив.Код = "000000099" Тогда  		// 240. Доля перестраховщиков в страховых резервах по страхованию жизни
				Классификатор.Добавить("240");			// Доля перестраховщиков в страховых резервах по страхованию жизни, сформированных в соответствии с регуляторными требованиями	
			ИначеЕсли Актив.Код = "000000099" Тогда  	// 250. Доля перестраховщиков в страховых резервах по страхованию иному, чем страхование жизни	
				Классификатор.Добавить("250");
			ИначеЕсли Актив.Код = "000000445" Тогда  	// 251. Доля перестраховщиков в страховых резервах по страхованию иному, чем страхование жизни 
				Классификатор.Добавить("251");
			ИначеЕсли Актив.Код = "000000091" Тогда 	// 255. Доля перестраховщиков в резерве заявленных, но неурегулированных убытков (из 250 строки)	
				Классификатор.Добавить("255");          // в резерве заявленных, но не урегулированных убытков
			КонецЕсли;	
			
		КонецЕсли;

		Если Актив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.НедвижимоеИмущество Тогда
			
			Классификатор.Добавить("300"); // Недвижимое имущество  
			
		КонецЕсли;
		
		Если Классификатор.Количество() = 0 Тогда			
			Классификатор.Добавить("340"); // Прочие активы			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.Облигации") Тогда
		
		Если Актив.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
			Классификатор.Добавить("100");	// Государственные и муниципальные ценные бумаги
			Классификатор.Добавить("101");  // в том числе: государственные ценные бумаги Российской Федерации
		ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда
			Классификатор.Добавить("100");	// Государственные и муниципальные ценные бумаги
			Классификатор.Добавить("102");  // в том числе: государственные ценные бумаги Российской Федерации
		ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
			Классификатор.Добавить("100");	// Государственные и муниципальные ценные бумаги
			Классификатор.Добавить("102");  // в том числе: государственные ценные бумаги Российской Федерации
		ИначеЕсли Актив.Категория = Перечисления.КатегорииОблигаций.Ипотечная Тогда			
			Классификатор.Добавить("170");	// Ипотечные ценные бумаги
			Классификатор.Добавить("171");  // в том числе: облигации с ипотечным покрытием			
		Иначе
			Классификатор.Добавить("120");  // Облигации (за исключением облигаций, отраженных по строкам 101, 102, 171)
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Актив.Гарант) Тогда
			Классификатор.Добавить("370");  // Из строки "Итого активов" активы, находящиеся в доверительном управлении
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.ИпотечныеСертификатыУчастия") Тогда
		Классификатор.Добавить("170");	// Ипотечные ценные бумаги
		Классификатор.Добавить("175");  // ипотечные сертификаты участия
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.ДепозитныеВклады") Тогда		
		Классификатор.Добавить("090");	// Депозиты
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.Акции") Тогда
		Классификатор.Добавить("110");	// Акции	                                  
	КонецЕсли;
	
	Если ТипЗнч(Актив) = ТИП("СправочникСсылка.Паи") Тогда		
		Классификатор.Добавить("160");	// Инвестиционные паи паевых инвестиционных фондов
		
		Если Актив.ПаевойИнвестиционныйФонд.Тип = Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Закрытый Тогда
			Классификатор.Добавить("162");	// закрытых 	
		Иначе
			Классификатор.Добавить("161");	// 	из них: открытых и интервальных
		КонецЕсли;
		
	КонецЕсли;
	
	Классификатор.Добавить("350"); 		// Итого активов
	
	Если РезидентныйАктив Тогда
		Классификатор.Добавить("351");	// в том числе: на территории России 
	Иначе
		Классификатор.Добавить("352");	// за пределами России
	КонецЕсли;
	
	Если АктивВДоверительномУправлении Тогда
		Классификатор.Добавить("360");	// Из строки "Итого активов": активы, находящиеся в доверительном управлении
	КонецЕсли;
	
	Возврат Классификатор;
	
КонецФункции

//Разделы 4..15< не реализовано
&НаСервере
Функция ЗаполнитьДанныеРазделовНарушений( Период, СчетДоверительногоУправления )
	
	Запрос = Новый Запрос();
//из таблицы _Активы удалено условие: "И НарушениеАктивы.Ссылка.ДатаУведомления ЕСТЬ NULL"
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НарушениеАктивы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НарушениеАктивы.Актив КАК Актив,
		|	НарушениеАктивы.КодАктива КАК КодАктива,
		|	НарушениеАктивы.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _Активы
		|ИЗ
		|	Документ.Нарушение.Активы КАК НарушениеАктивы
		|ГДЕ
		|	НарушениеАктивы.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НарушениеАктивы.Ссылка.ДатаВыявления = &ДатаВыявления
		|	И НарушениеАктивы.Ссылка.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивы.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления,
		|	РаспределенныеАктивы.ВидПортфеляСтраховойКомпании КАК ВидПортфеляСтраховойКомпании,
		|	РаспределенныеАктивы.Актив КАК Актив,
		|	РаспределенныеАктивы.Рынок КАК Рынок,
		|	РаспределенныеАктивы.ВидАктива КАК ВидАктива,
		|	РаспределенныеАктивы.Эмитент КАК Эмитент,
		|	РаспределенныеАктивы.ЭмитентЯвляетсяБанком КАК ЭмитентЯвляетсяБанком,
		|	РаспределенныеАктивы.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивы.Валюта КАК Валюта,
		|	РаспределенныеАктивы.Сумма КАК Сумма,
		|	РаспределенныеАктивы.КурсВалюты КАК КурсВалюты,
		|	РаспределенныеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _РаспределенныеАктивы
		|ИЗ
		|	&РаспределенныеАктивы КАК РаспределенныеАктивы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	"""" КАК Таб4_6Номер,
		|	Валюты.Код КАК Таб4_3КодВалюты,
		|	_Активы.КодАктива КАК Таб4_3ВКодДенСр,
		|	СУММА(_РаспределенныеАктивы.СуммаВВалютеУчета) КАК Таб14_3Стоим,
		|	_Активы.Комментарий КАК Таб4_3Прим
		|ПОМЕСТИТЬ _Раздел_4_1_Кассы
		|ИЗ
		|	_Активы КАК _Активы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеАктивы КАК ПрочиеАктивы
		|		ПО _Активы.Актив = ПрочиеАктивы.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РаспределенныеАктивы КАК _РаспределенныеАктивы
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|			ПО _РаспределенныеАктивы.Валюта = Валюты.Ссылка
		|		ПО _Активы.Актив = _РаспределенныеАктивы.Актив
		|			И _Активы.СчетДоверительногоУправления = _РаспределенныеАктивы.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	Валюты.Код,
		|	_Активы.Комментарий,
		|	_Активы.КодАктива
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	"""" КАК Таб4_6Номер,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК Таб4_6ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Таб4_6Наим,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.Код КАК Таб4_6КодСтраны,
		|	БанковскиеСчета.НомерСчета КАК Таб4_6НомерСчета,
		|	БанковскиеСчета.Валюта.Код КАК Таб4_6КодВалюты,
		|	_Активы.КодАктива КАК Таб4_6КодДен,
		|	СУММА(_РаспределенныеАктивы.СуммаВВалютеУчета) КАК Таб4_6Стоим,
		|	_Активы.Комментарий КАК Таб4_6Прим
		|ПОМЕСТИТЬ _Раздел4_2_РасчетныеСчета
		|ИЗ
		|	_Активы КАК _Активы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РаспределенныеАктивы КАК _РаспределенныеАктивы
		|		ПО _Активы.Актив = _РаспределенныеАктивы.Актив
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&ДатаВыявления, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО БанковскиеСчета.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО _Активы.Актив = БанковскиеСчета.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	_Активы.КодАктива,
		|	БанковскиеСчета.Валюта.Код,
		|	_Активы.Комментарий,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.Код,
		|	БанковскиеСчета.НомерСчета,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	"""" КАК Таб5_2Номер,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК Таб5_2ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Таб5_2Наим,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.Код КАК Таб5_2КодСтраны,
		|	ДепозитныеВклады.БанковскийСчет.НомерСчета КАК Таб5_2НомерСчета,
		|	ДепозитныеВклады.БанковскийСчет.Валюта.Код КАК Таб5_2КодВалюты,
		|	_Активы.КодАктива КАК Таб5_2КодДеп,
		|	СУММА(_РаспределенныеАктивы.СуммаВВалютеУчета) КАК Таб14_3СтоимДеп,
		|	ДепозитныеВклады.ДатаРегистрации КАК Таб5_2Дата1,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК Таб5_2Дата2,
		|	_Активы.Комментарий КАК Таб5_2Прим
		|ПОМЕСТИТЬ _Раздел_5_Депозиты
		|ИЗ
		|	_Активы КАК _Активы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РаспределенныеАктивы КАК _РаспределенныеАктивы
		|		ПО _Активы.Актив = _РаспределенныеАктивы.Актив
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&ДатаВыявления, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|				УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|				УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|				УсловияКредитныхИнструментовСрезПоследних.Контрагент КАК Контрагент
		|			ИЗ
		|				(ВЫБРАТЬ
		|					УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|					МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|				ИЗ
		|					РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&ДатаВыявления, ДатаНачалаДействияУсловий <= &ДатаВыявления) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ГДЕ
		|					УсловияКредитныхИнструментовСрезПоследних.Действует
		|				
		|				СГРУППИРОВАТЬ ПО
		|					УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&ДатаВыявления, ДатаНачалаДействияУсловий <= &ДатаВыявления) КАК УсловияКредитныхИнструментовСрезПоследних
		|					ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|						И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ПО ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|		ПО _Активы.Актив = ДепозитныеВклады.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ДепозитныеВклады.ДатаРегистрации,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.Код,
		|	ДепозитныеВклады.БанковскийСчет.Валюта.Код,
		|	_Активы.КодАктива,
		|	ДепозитныеВклады.БанковскийСчет.НомерСчета,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН,
		|	_Активы.Комментарий";
	
КонецФункции

#КонецОбласти

#Область Определение_Кода_Актива_В_отчетностиЦБ

// УБанкаЕстьЛицензия - счет в банке, имеющем лицензию на осуществление банковских операций
// РейтингКонтрагентаДостаточный - 
// Не, ну это нереально все предусмотреть.
Функция ОпределитьКодАктива( АктивСтраховойКомпании, НаходитсяНаТерриторииРФ, СлужитПредметомЗалога, 
	НаложенАрест, КонтрагентСвязаннаяСторона, АктивПриобретенПоДоговоруЗаймаИлиКредитномуДоговору, 
	АктивПриобретенПоДоговоруСубординированногоЗайма, РейтингКонтрагентаДостаточный, УБанкаЕстьЛицензия )
	
	Код = "";
	ПрочийАктив = Справочники.ПрочиеАктивы.ПустаяСсылка();
	БанковскийСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
	ДепозитныйВклад = Справочники.ДепозитныеВклады.ПустаяСсылка();
	
	Х1 = ""; Х2 = ""; Х3 = ""; Х4 = ""; Х5 = ""; Х6 = ""; Х7 = ""; Х8 = "";
	// Х1, Х2, Х3 - общие для всех активов
#Область X1_Первый_разряд_Нац_принадлежность	
	Если НаходитсяНаТерриторииРФ Тогда
		Если СлужитПредметомЗалога Тогда
			Х1 = "3";
		ИначеЕсли НаложенАрест Тогда
			Х1 = "2";
		Иначе
			Х1 = "1";
		КонецЕсли;
	Иначе		
		Если СлужитПредметомЗалога Тогда
			Х1 = "6";
		ИначеЕсли НаложенАрест Тогда
			Х1 = "5";
		Иначе
			Х1 = "4";
		КонецЕсли; 				
	КонецЕсли;
#КонецОбласти
#Область Х2_признак_связанной_стороны 
		Если КонтрагентСвязаннаяСторона Тогда
			Х2 = "1";
		Иначе
			Х2 = "2";
		КонецЕсли;
#КонецОбласти
#Область Х3_характер_приобретения_актива
		Если АктивПриобретенПоДоговоруСубординированногоЗайма Тогда
			Х3 = "3";
		ИначеЕсли АктивПриобретенПоДоговоруЗаймаИлиКредитномуДоговору Тогда
			Х3 = "2";
		Иначе
			Х3 = "1";
		КонецЕсли;
#КонецОбласти
		
		Если ТипЗнч( АктивСтраховойКомпании ) = Тип("СправочникСсылка.ПрочиеАктивы") Тогда
		#Область Наличные_в_кассе_подраздел_4_1
		ПрочийАктив = АктивСтраховойКомпании;
		// X1 - X2 - X3 - X4. 
		Если ПрочийАктив.ВидПрочегоАктива = Справочники.ВидыПрочихАктивов.Кассы Тогда
			
			Х2 = "0"; // Для наличных денежных средств, денежных средств (кроме денежных средств на счетах в кредитных организациях), недвижимого имущества второй разряд (X2) является резервным (проставляется ноль).
			Х4 = "0"; // X4 - резеврный для наличных в кассе.
			
			Код = Х1 + Х2 + Х3 + Х4;
			
			Возврат Код;		
			
		КонецЕсли;
		#КонецОбласти
		
	КонецЕсли;
	#Область Банковские_Счета_Подраздел_4_2
	Если ТипЗнч( АктивСтраховойКомпании ) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
		БанковскийСчет = АктивСтраховойКомпании;
		
		// X4 - категория счета в банке.		
		Если РейтингКонтрагентаДостаточный и УБанкаЕстьЛицензия Тогда
			X4 = "1";
		Иначе
			X4 = "2";
		КонецЕсли;
			
		Код = Х1 + Х2 + Х3 + Х4;			
		Возврат Код;	
	КонецЕсли;
	#КонецОбласти
	#Область Депозитные_Вклады_Раздел5
	Если ТипЗнч( АктивСтраховойКомпании ) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		//Х4 - вид депозита
		
		
	КонецЕсли;
	
	#КонецОбласти
	
КонецФункции

