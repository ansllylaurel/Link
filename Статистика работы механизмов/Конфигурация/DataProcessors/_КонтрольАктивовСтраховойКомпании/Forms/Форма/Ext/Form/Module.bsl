&НаКлиенте
Функция ПолучитьИмяФайла( КаталогДанных )

	//проверка каталога
	
	ПроверяемыйКаталог = Новый Файл(КаталогДанных);
	Если НЕ ПроверяемыйКаталог.Существует() Тогда
		СоздатьКаталог(КаталогДанных);
	КонецЕсли;	
	
	Версия = 1;
	
	Версионирование = Истина;
	
	ШаблонФайла = "ОКУД0420871" + Формат(ЭтаФорма.Объект.Период, "ДЛФ=Д") + "АО ДК РЕГИОН";
	
	ШаблонФайла =  КаталогДанных + "\" + СтрЗаменить(ШаблонФайла, """", "");
		
	Если Версионирование Тогда
		ИмяФайлаXTDD	=  ШаблонФайла + " ver." + Строка(Версия) + ".xtdd";
		
		ПроверяемыйФайл = Новый Файл(ИмяФайлаXTDD);
		Пока ПроверяемыйФайл.Существует() Цикл
			Версия = Версия + 1;
			ИмяФайлаXTDD =  ШаблонФайла + " ver." + Строка(Версия) + ".xtdd";
			ПроверяемыйФайл = Новый Файл(ИмяФайлаXTDD);
		КонецЦикла;
	Иначе
		ИмяФайлаXTDD	=  ШаблонФайла + ".xtdd";		
	КонецЕсли;
	
	
	Возврат ИмяФайлаXTDD;
	
КонецФункции

&НаКлиенте
Процедура СформироватьXML( XSDСхема, ПакетДанных, Каталог )
	
	Если ПакетДанных.Свойство("Отказ") Тогда Возврат; КонецЕсли;
	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаXSDСхемы);
	
	ИмяФайлаXML = ПолучитьИмяФайла(  Каталог );
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "UTF-8");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("av:" + ПакетДанных.ИмяОтчета);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xserializer", "http://www.it.ru/Schemas/Avior/XSerializer"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema"); 

	URLПространстваИмен = "";
	
	Для Каждого ПакетовXDTO Из НоваяФабрикаXDTO.Пакеты Цикл
		Если ПакетовXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
			Продолжить;
		КонецЕсли;
		URLПространстваИмен = ПакетовXDTO.URIПространстваИмен;
	КонецЦикла;	
	
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("av", URLПространстваИмен);
	ЗаписьXML.ЗаписатьАтрибут("appVersion", ПакетДанных.ВерсияОтчета); 
	
	ПустоеЗначение = "-";
	
	Для Каждого ЭлементыОтчета Из ПакетДанных.Отчет Цикл
		
		ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип(URLПространстваИмен, ПакетДанных.ИмяКорневогоЭлемента).Свойства.Получить(ЭлементыОтчета.Ключ).Тип;
		
		НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, 
									ПреобразоватьЗначениеВXML(XSDСхема, ЭлементыОтчета.Значение, ЭлементыОтчета.Ключ, НоваяФабрикаXDTO, ПустоеЗначение, ТипОбъектаXDTO), 
									ЭлементыОтчета.Ключ,, 
									ФормаXML.Элемент, НазначениеТипаXML.Неявное);
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаXML);
	
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьЗначениеВXML(XSDСхема, ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ПустоеЗначение, ТипОбъектаXDTO = "")
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO		= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл
			Если ТипЗнч(ЭлементПакета.Значение) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл					
					ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ПреобразоватьЗначениеВXML(XSDСхема, ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ПустоеЗначение, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип));
				КонецЦикла;
			Иначе
				ОбъектXDTO[ЭлементПакета.Ключ] = ПреобразоватьЗначениеВXML(XSDСхема, ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ПустоеЗначение, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ПакетДанных = "ЗаполнитьПустымиЗначениями" Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
		Для Каждого Свойство Из ТипОбъектаXDTO.Свойства Цикл
			ОбъектXDTO[Свойство.Имя] = ПреобразоватьЗначениеВXML(XSDСхема, ПустоеЗначение, Свойство.Имя, НоваяФабрикаXDTO, ПустоеЗначение, Свойство.Тип);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТипОбъектаXDTO) = тип("ТипОбъектаXDTO") Тогда
		ОбъектXDTO = ПолучитьЗначениеПеречисления(XSDСхема, ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, ПустоеЗначение, ПакетДанных);
	ИначеЕсли НЕ ЗначениеЗаполнено(ПакетДанных) И НЕ ПакетДанных = " " Тогда
		ОбъектXDTO = ПреобразоватьЗначениеВXML(XSDСхема, ПустоеЗначение, ИмяЭлемента, НоваяФабрикаXDTO, ПустоеЗначение, ТипОбъектаXDTO);
	ИначеЕсли ТипОбъектаXDTO.Имя = "decimal" ИЛИ ТипОбъектаXDTO.Имя = "Double" Тогда
		Если ПакетДанных = ПустоеЗначение Тогда
			ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, 0);	
		Иначе
			ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		КонецЕсли;
	Иначе
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
	КонецЕсли;
	
	Возврат ОбъектXDTO;
	
КонецФункции	

&НаКлиенте
Функция ПолучитьЗначениеПеречисления(XSDСхема, ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, ПустоеЗначение, Знач ЗначениеПеречисления)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПеречисления) Тогда 
		Возврат НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
	КонецЕсли;
	
	НомСтр = 0;
	
	ЗначениеКлюча = ИмяЭлемента + "_" + СтрЗаменить(ЗначениеПеречисления, ПустоеЗначение, "");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, " ", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, "(", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ")", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ".", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ",", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, "-", "dash");
	
	Если ЗначениеКлюча = "Кол3_Таб4НаименСубъекта_Правительство_Москвы_в_лице_Департамента_финансов_г__Москвы" Тогда
		ЗначениеПеречисления = "Москва";
	КонецЕсли;
	
	Код = "0";
	
	Если НЕ мКэшЗначенийХМЛ.Свойство(ЗначениеКлюча, Код) Тогда
		
	
		Код = "0";

		Стр = "//xs:element[@name=""" + ИмяЭлемента + """]";
		Попытка
			УзелСхемы = XSDСхема.SelectSingleNode(Стр);
		Исключение
			Сообщить(Стр);
			УзелСхемы = XSDСхема.SelectSingleNode(Стр);
		КонецПопытки;
		Тип = УзелСхемы.GetAttribute("type");
		Если Найти(Тип, ":") > 0 Тогда
			Тип = Сред(Тип, Найти(Тип, ":") + 1);
		КонецЕсли;
		УзелТипа = XSDСхема.SelectSingleNode("//xs:complexType[@name=""" + Тип + """]/xs:sequence/xs:element[@name=""Код""]");
		Тип = УзелТипа.GetAttribute("type");
		Если Найти(Тип, ":") > 0 Тогда
			Тип = Сред(Тип, Найти(Тип, ":") + 1);
		КонецЕсли;
		Стр = "//xs:simpleType[@name=""" + Тип + """]//xs:enumeration[xs:annotation/xs:documentation = """ + СокрЛП(ЗначениеПеречисления) + """]";
		Попытка
			УзелЗначения = XSDСхема.SelectSingleNode(Стр);
		Исключение
			Сообщить(Стр);
			УзелЗначения = XSDСхема.SelectSingleNode(Стр);
		КонецПопытки;
		
		Попытка
			Код = УзелЗначения.GetAttribute("value");
		Исключение
			ВызватьИсключение ОписаниеОшибки() + Символы.ПС + ИмяЭлемента + ": " + ЗначениеПеречисления;
		КонецПопытки;
		
		мКэшЗначенийХМЛ.Вставить(ЗначениеКлюча, Код);
		
	КонецЕсли;
	
	Если СокрЛП(Код) <> "0" ИЛИ СтрНачинаетсяС(ЗначениеКлюча, "Таб2Суборд") Тогда
		Возврат ПреобразоватьЗначениеВXML(XSDСхема, Новый Структура("Код, Описание, Активно", Код, ЗначениеПеречисления, "true"), ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO);
	КонецЕсли;

КонецФункции

#КонецОбласти

&НаСервере
Функция ПолучитьДанныеРаздела3( МассивОпределенийСтрокТаблицыРаздела )
		
	ЗначенияПолей = Новый Структура ();
	
	Если ДействуютПравила410П() Тогда
		
		// Раздел не заполняется
		
		Возврат ЗначенияПолей;
	КонецЕсли;
	                	
	БазаИмяПоля = "";
	СуммаИмяПоля = "";
	ПоказательИмяПоля = "";
	
	Для Каждого Проверка из ЭтаФорма.Проверки Цикл
		
		Для Каждого ОпределениеСтрокиТаблицы из МассивОпределенийСтрокТаблицыРаздела Цикл
			
			Если Проверка.КодПроверки = ОпределениеСтрокиТаблицы.КодСтроки Тогда
				
				Если Проверка.ЭтоСобственныеСредства Тогда					
					СуммаИмяПоля = ОпределениеСтрокиТаблицы.СобственныеСредстваСуммаИмяПоля;
					ПоказательИмяПоля = ОпределениеСтрокиТаблицы.СобственныеСредстваПоказательИмяПоля;
					// Значение базы расчета отображается либо в 10, либо в 11 колонке.
					// Определить это можно только по предустановленному значению ячейки колонки.
					// Если значение = "x", то база пишется в колонку "Сверх норматива", иначе в размере норматива
					Если ОпределениеСтрокиТаблицы.СобственныеСредстваНормативБазаЗначение = "x" Тогда
						БазаИмяПоля = ОпределениеСтрокиТаблицы.СобственныеСредстваСверхНормБазаИмяПоля;
					Иначе
						БазаИмяПоля = ОпределениеСтрокиТаблицы.СобственныеСредстваНормативБазаИмяПоля;
					КонецЕсли;
					
				Иначе
					БазаИмяПоля = ОпределениеСтрокиТаблицы.СтраховыеРезервыБазаИмяПоля;
					СуммаИмяПоля = ОпределениеСтрокиТаблицы.СтраховыеРезервыСуммаИмяПоля;
					ПоказательИмяПоля = ОпределениеСтрокиТаблицы.СтраховыеРезервыПоказательИмяПоля;
				КонецЕсли;
				
				ЗначенияПолей.Вставить(БазаИмяПоля, Проверка.СтоимостьБазовая);				
				ЗначенияПолей.Вставить(СуммаИмяПоля, Проверка.СтоимостьРасчетная);				
				ЗначенияПолей.Вставить(ПоказательИмяПоля, Проверка.ФактическоеЗначение); 				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ЗначенияПолей;    	
	
КонецФункции

// Прочитать схему документа из схемы XSD и сформировать вложенную структуру описания
&НаКлиенте
Функция ПолучитьЭлементТипаПоИмениЭкземпляраЭлемента(Ключ, ДокументDOM, RegExp)
	
	ВыражениеXPath = "//xs:element[@name=""" + Ключ + """]";
	Элемент = ДокументDOM.selectSingleNode(ВыражениеXPath);
	// Найти объявление типа из атрибута элемента
    ЗначениеАтрибута = Элемент.attributes.getNamedItem("type");	
	// Исключить Namespaces из имени типа
    RegExp.Pattern = "[a-z]+:";
    ВыражениеXPath = "//xs:complexType[@name=""" + regExp.Replace(ЗначениеАтрибута.text,"") + """]";
	Возврат ДокументDOM.selectSingleNode(ВыражениеXPath);	
	
КонецФункции

// Найти совпадения с регулярным выражением и преобразовать найденные элементы в массив строк описаний, в виде структуры поле-значение.
&НаКлиенте
Функция ПолучитьМакетСхемыТаблицыРаздела(ДокументDOM, RegExp, ЧислоГрупп = 0)
	
	ТекстДокумента = ДокументDOM.xml;
	
	Возврат РазобратьТекстСПомощьюРегулярныхВыражений( ТекстДокумента, RegExp, ЧислоГрупп );
	
КонецФункции

&НаКлиенте
Функция РазобратьТекстСПомощьюРегулярныхВыражений (ТекстДокумента, RegExp, ЧислоГрупп = 0)

	МассивСтрок = Новый Массив(); 	
	
	Если RegExp.Test(ТекстДокумента) Тогда
		
		Результат = RegExp.Execute(ТекстДокумента);
		Для Позиция = 0 По Результат.Count - 1 Цикл				
			
			СтрокаОписаний = Новый Структура();
			
			Если ЧислоГрупп = 0 Тогда
				
				ЧислоГрупп = Результат.Item(Позиция).Submatches.Count;
				ЧислоГрупп = ?(ЧислоГрупп = 0, 1, ЧислоГрупп);
				
			КонецЕсли; 

			Если Результат.Item(Позиция).Submatches.Count = 0 И ЧислоГрупп = 1 Тогда
				
				 // Найдено единственное совпадение и число групп = 1
				 СтрокаОписаний.Вставить("Группа01", Результат.Item(Позиция).Value );
				
			Иначе
				
				Для НомерГруппы = 0 по ЧислоГрупп - 1 Цикл
					СтрокаОписаний.Вставить("Группа" + НомерГруппы + 1, СокрЛП(Результат.Item(Позиция).Submatches(НомерГруппы)));				
				КонецЦикла;
				
			КонецЕсли;			
			
			МассивСтрок.Добавить(СтрокаОписаний);
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Возврат МассивСтрок;	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЭкземплярТипа(Ключ, ПакетДанных, УзелDOM, ДокументDOM, RegExp)
	
	Если (УзелDOM <> Неопределено) Тогда
        // Комментарии не участвуют в формировании структуры, только в поиске значения
    	Если (УзелDOM.baseName <> "annotation") Тогда
       		// Последовательности игнорируются с переходом на один уровень ниже
        	Если (УзелDOM.baseName <> "sequence") Тогда
				// Если известно описание типа элемента, имя элемента нужно взять из элемента, 
				// а содержание из описания типа элемента.  
				ЗначениеАтрибута = УзелDOM.attributes.getNamedItem("type");
                Если (ЗначениеАтрибута <> Неопределено) Тогда
					RegExp.Pattern = "[a-z]+:";
					ВыражениеXPath = "//xs:complexType[@name=""" + RegExp.Replace(ЗначениеАтрибута.text, "") + """]"; 
					УзелDOMТипа = ДокументDOM.selectSingleNode(ВыражениеXPath);
                    Если(УзелDOMТипа <> Неопределено) Тогда
                    	НовыйПакет = Новый Структура();
						НовыйКлюч = УзелDOM.attributes.getNamedItem("name").nodeValue;
                        ПакетДанных.Вставить(НовыйКлюч, НовыйПакет);
                        ЗаполнитьЭкземплярТипа(НовыйКлюч, НовыйПакет, УзелDOMТипа, ДокументDOM, RegExp);
                        // В данном случае нет дочерних узлов, которые нужно обработать.
                        Возврат;
					Иначе
						//av:String итд. Значения для элементов по умолчанию
                        КлючЗначения = УзелDOM.attributes.getNamedItem("name").nodeValue; 
						ПакетДанных.Вставить(КлючЗначения, "");
						Если(УзелDOM.childNodes.length = 1) Тогда
                        	УзелОписание = УзелDOM.selectSingleNode("xs:annotation/xs:documentation");
                            Если (УзелОписание <> Неопределено) Тогда
                            	ТекстУзла = УзелОписание.text;
                                Если (RegExp <> Неопределено) Тогда
                                	RegExp.Pattern = "^(.*\|)(.*)";
									RegExp.Global = Истина;
									Если (RegExp.Test(ТекстУзла))Тогда
                                    	Результат = RegExp.Execute(ТекстУзла);
                                        ТекстЗначения = Результат.Item(0).Submatches(1);
                                        ПакетДанных[КлючЗначения] = ТекстЗначения;
										Возврат;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;  // sequense
			// Здесь возможна последовательность sequence или элементы типа 
			Для НомерУзла = 0 По УзелDOM.childNodes.length - 1 Цикл
				
				ДочернийУзел =УзелDOM.childNodes(НомерУзла); 
				ЗаполнитьЭкземплярТипа(Ключ, ПакетДанных, ДочернийУзел, ДокументDOM, RegExp);
				
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияДокумента( СтруктураДокумента, ТаблицаЗначений, КолонкаИмяЭлемента, КолонкаИмяЗначения)
	
	Для Каждого СтрокаТаблицыЗначений из ТаблицаЗначений Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицыЗначений[КолонкаИмяЭлемента]) Тогда
		
			УстановитьЗначениеЭлемента( СтруктураДокумента, СтрокаТаблицыЗначений[КолонкаИмяЭлемента], СтрокаТаблицыЗначений[КолонкаИмяЗначения]);
		
		КонецЕсли;
		 		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьЗначениеЭлемента(СтруктураПоиска, ИмяЭлемента, ЗначениеЭлемента)
	
	Если(СтруктураПоиска.Свойство(ИмяЭлемента)) Тогда
		
		СтруктураПоиска[ИмяЭлемента] = ЗначениеЭлемента;
		Возврат Истина;
		
	КонецЕсли;
	
	Для Каждого ЭлементСтурктуры из СтруктураПоиска Цикл
		
		Если ТипЗнч(ЭлементСтурктуры.Значение) = Тип("Структура") Тогда
			
			Если УстановитьЗначениеЭлемента (ЭлементСтурктуры.Значение, ИмяЭлемента, ЗначениеЭлемента) Тогда
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЕсли;  
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеРаздела1( ПакетДанных )
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Настройки.Показатель КАК Показатель,
	|	Настройки.КодСтроки КАК КодСтроки,
	|	Настройки.НаименованиеУзла КАК НаименованиеУзла
	|ПОМЕСТИТЬ _Настройки
	|ИЗ
	|	&Настройки КАК Настройки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	СУММА(ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ЗначениеПоказателя) КАК ЗначениеПоказателя,
	|	_Настройки.КодСтроки КАК КодСтроки,
	|	_Настройки.НаименованиеУзла КАК НаименованиеУзла
	|ИЗ
	|	РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления.Родитель = (ВЫРАЗИТЬ(&СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления))) КАК ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Настройки КАК _Настройки
	|		ПО ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ВидПоказателя = _Настройки.Показатель
	|ГДЕ
	|	ЕСТЬNULL(ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ЗначениеПоказателя, 0) <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления,
	|	_Настройки.НаименованиеУзла,
	|	_Настройки.КодСтроки";
	
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Настройки", СформироватьТаблицуОбозначенийПредоставляемыхПоказателей()); 
	
	ТаблицаЗначенийРаздел1 = Запрос.Выполнить().Выгрузить();
	
	// Особые формулы расчета некоторых показателей 
	// 065 - максимум между 50 и 60
	// 048 - 040 065 + 0.66
	Показатель060 = 0;      	
	Показатель050 = 0;     	
	Показатель065 = 0;
	Показатель066 = 0;
	СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка();

	Для каждого РасчетныйПоказатель из ТаблицаЗначенийРаздел1 Цикл
		
		Если РасчетныйПоказатель.КодСтроки = "060" Тогда
			Показатель060 = РасчетныйПоказатель.ЗначениеПоказателя;
		КонецЕсли;			
		Если РасчетныйПоказатель.КодСтроки = "066" Тогда
			Показатель066 = РасчетныйПоказатель.ЗначениеПоказателя;
		КонецЕсли;	
		Если РасчетныйПоказатель.КодСтроки = "050" Тогда
			 Показатель050 = РасчетныйПоказатель.ЗначениеПоказателя;
		 КонецЕсли; 		
		 СчетДоверительногоУправления = РасчетныйПоказатель.СчетДоверительногоУправления;
	КонецЦикла;

	Если НЕ ДействуютПравила410П() Тогда
		Если  Показатель060 >  Показатель050 Тогда
			Показатель065 =  Показатель060;
		Иначе
			Показатель065 =  Показатель050; 		
		КонецЕсли;       		
	КонецЕсли;
	
	НоваяСтрока = ТаблицаЗначенийРаздел1.Добавить();
	
	НоваяСтрока.СчетДоверительногоУправления = СчетДоверительногоУправления;
	НоваяСтрока.ЗначениеПоказателя =  Показатель065;	 
	НоваяСтрока.КодСтроки =  "065";   	 
	НоваяСтрока.НаименованиеУзла =  "Cell_268";

	НоваяСтрока = ТаблицаЗначенийРаздел1.Добавить();	
	
	НоваяСтрока.СчетДоверительногоУправления = СчетДоверительногоУправления;
	НоваяСтрока.ЗначениеПоказателя =  Показатель065 + Показатель066;
	НоваяСтрока.КодСтроки = "048";
	НоваяСтрока.НаименованиеУзла = "Cell_244";    
	 
	НоваяСтрока = ТаблицаЗначенийРаздел1.Добавить();	
	
	НоваяСтрока.СчетДоверительногоУправления = СчетДоверительногоУправления;
	НоваяСтрока.ЗначениеПоказателя =  Показатель065 + Показатель066;
	НоваяСтрока.КодСтроки = "040";
	НоваяСтрока.НаименованиеУзла = "Cell_252";
	
	
	ЗаполнитьЗначенияДокумента(ПакетДанных, ТаблицаЗначенийРаздел1, "НаименованиеУзла", "ЗначениеПоказателя");
	
	
	
	Возврат ПакетДанных;	
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеРаздела22( МассивОпределенийСтрокТаблицыРаздела)
	
	ТаблицаЗначений = Новый ТаблицаЗначений();
	
	ТаблицаЗначений.Колонки.Добавить("Актив", Метаданные.ОпределяемыеТипы.АктивыСтраховыхКомпаний.Тип);
	ТаблицаЗначений.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));	
	ТаблицаЗначений.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));	
	ТаблицаЗначений.Колонки.Добавить("Валюта",  Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаЗначений.Колонки.Добавить("ВидПортфеляСтраховойКомпании",  Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПортфелейСтраховыхКомпаний"));

	
	Если ЭтаФорма.РасчетныеПоказатели <> Неопределено Тогда
		
		РасчетныеПоказателиНаСервере = ЭтаФорма.РасчетныеПоказатели.Получить();
		
		АктивыСтраховойКомпании = РасчетныеПоказателиНаСервере.РаспределенныеАктивыСтраховойКомпании;
		
		Для Каждого строка из АктивыСтраховойКомпании Цикл
			
			ДоверительноеУправление = ложь;
			
			Если строка.СчетДоверительногоУправленияИсходный = "11/DSK" Тогда    //TODO: переделать
				  ДоверительноеУправление = истина;
			КонецЕсли;
			
			КодыКлассификатора = ОпределитьКодыПоказателяАктива( 
					строка.Актив,
					строка.Валюта,
					Объект.Организация, 
					?(ЗначениеЗаполнено( строка.ЭмитентЯвляетсяРезидентомРФ ), строка.ЭмитентЯвляетсяРезидентомРФ, ДоверительноеУправление),
					Ложь);

					Для каждого КодКлассификатора из КодыКлассификатора Цикл
						
						СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
						СтрокаТаблицыЗначений.Актив = строка.Актив;
						СтрокаТаблицыЗначений.КодСтроки = КодКлассификатора;
						СтрокаТаблицыЗначений.СчетДоверительногоУправления = строка.СчетДоверительногоУправленияИсходный;
						СтрокаТаблицыЗначений.ВидПортфеляСтраховойКомпании = строка.ВидПортфеляСтраховойКомпании;
						
					КонецЦикла;
			
		КонецЦикла;
	
	КонецЕсли;
	
	Запрос = Новый Запрос ();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлассификаторАктивов.Актив КАК Актив,
	|	КлассификаторАктивов.КодСтроки КАК КодСтроки,
	|	КлассификаторАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КлассификаторАктивов.Валюта КАК Валюта,
	|	КлассификаторАктивов.ВидПортфеляСтраховойКомпании КАК ВидПортфеляСтраховойКомпании
	|ПОМЕСТИТЬ _КлассификаторАктивов
	|ИЗ
	|	&КлассификаторАктивов КАК КлассификаторАктивов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РаспределенныеАктивы.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления,
	|	РаспределенныеАктивы.ВидПортфеляСтраховойКомпании КАК ВидПортфеляСтраховойКомпании,
	|	РаспределенныеАктивы.Актив КАК Актив,
	|	РаспределенныеАктивы.Рынок КАК Рынок,
	|	РаспределенныеАктивы.ВидАктива КАК ВидАктива,
	|	РаспределенныеАктивы.Эмитент КАК Эмитент,
	|	РаспределенныеАктивы.ЭмитентЯвляетсяБанком КАК ЭмитентЯвляетсяБанком,
	|	РаспределенныеАктивы.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
	|	РаспределенныеАктивы.Валюта КАК Валюта,
	|	РаспределенныеАктивы.Сумма КАК Сумма,
	|	РаспределенныеАктивы.КурсВалюты КАК КурсВалюты,
	|	РаспределенныеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
	|ПОМЕСТИТЬ _РаспределенныеАктивы
	|ИЗ
	|	&РаспределенныеАктивы КАК РаспределенныеАктивы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлассификаторАктивов.КодСтроки КАК КодСтроки,
	|	РаспределенныеАктивы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	СУММА(РаспределенныеАктивы.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
	|	КлассификаторАктивов.ВидПортфеляСтраховойКомпании КАК ВидПортфеляСтраховойКомпании
	|ИЗ
	|	_РаспределенныеАктивы КАК РаспределенныеАктивы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлассификаторАктивов КАК КлассификаторАктивов
	|		ПО (КлассификаторАктивов.Актив = РаспределенныеАктивы.Актив)
	|			И (КлассификаторАктивов.СчетДоверительногоУправления = РаспределенныеАктивы.СчетДоверительногоУправления)
	|			И (КлассификаторАктивов.ВидПортфеляСтраховойКомпании = РаспределенныеАктивы.ВидПортфеляСтраховойКомпании)
	|
	|СГРУППИРОВАТЬ ПО
	|	РаспределенныеАктивы.СчетДоверительногоУправления,
	|	КлассификаторАктивов.КодСтроки,
	|	КлассификаторАктивов.ВидПортфеляСтраховойКомпании
	|ИТОГИ
	|	СУММА(СуммаВВалютеУчета)
	|ПО
	|	КодСтроки";
	
	Запрос.УстановитьПараметр( "КлассификаторАктивов",     ТаблицаЗначений);   	
	Запрос.УстановитьПараметр( "РаспределенныеАктивы",     АктивыСтраховойКомпании);

	СгруппированныеАктивыИтоги = Запрос.Выполнить().Выбрать( ОбходРезультатаЗапроса.ПоГруппировкам );

	ЗначенияПолей = Новый Структура ();
	
	Пока СгруппированныеАктивыИтоги.Следующий() Цикл
		
		РазметкаСтроки = Неопределено;
		
		Для Каждого ОпределениеСтрокиРаздела из МассивОпределенийСтрокТаблицыРаздела Цикл
			
			Если ОпределениеСтрокиРаздела.Группа11 = СгруппированныеАктивыИтоги.КодСтроки Тогда
				
				РазметкаСтроки = ОпределениеСтрокиРаздела;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если РазметкаСтроки <> Неопределено Тогда
			
			НаименованиеПоля = РазметкаСтроки.Группа21;
			
			ЗначенияПолей.Вставить(НаименованиеПоля, СгруппированныеАктивыИтоги.СуммаВВалютеУчета );
		
			СгруппированныеАктивы = СгруппированныеАктивыИтоги.Выбрать();
			Пока СгруппированныеАктивы.Следующий() Цикл
				//|	СхемаДокумента.Группа31 КАК СРСтрахЖизни,
				//|	СхемаДокумента.Группа41 КАК СРСтрахНеЖизни,
				//|	СхемаДокумента.Группа51 КАК ССНорм,
				//|	СхемаДокумента.Группа61 КАК СССверх  			
		
				Если СгруппированныеАктивы.ВидПортфеляСтраховойКомпании = Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни Тогда
					НаименованиеПоля = РазметкаСтроки.Группа31;
				ИначеЕсли СгруппированныеАктивы.ВидПортфеляСтраховойКомпании = Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни Тогда
					НаименованиеПоля = РазметкаСтроки.Группа41;
				ИначеЕсли СгруппированныеАктивы.ВидПортфеляСтраховойКомпании = Перечисления.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива Тогда
					НаименованиеПоля = РазметкаСтроки.Группа51;					
				ИначеЕсли  СгруппированныеАктивы.ВидПортфеляСтраховойКомпании = Перечисления.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива Тогда
					НаименованиеПоля = РазметкаСтроки.Группа61;	
				КонецЕсли;
				
				ЗначенияПолей.Вставить(НаименованиеПоля, СгруппированныеАктивы.СуммаВВалютеУчета );				
				
			КонецЦикла;
			
		КонецЕсли;		
		
	КонецЦикла; 	
	
	Возврат ЗначенияПолей;      	
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуОбозначенийПредоставляемыхПоказателей()
	
	ТаблицаЗначений = Новый ТаблицаЗначений();

	#Область Сопоставления_элементов
	
	ТаблицаЗначений.Колонки.Добавить("Показатель", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПоказателейСтраховыхКомпаний"));
	ТаблицаЗначений.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));	
	ТаблицаЗначений.Колонки.Добавить("НаименованиеУзла", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));

	СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
	СтрокаТаблицыЗначений.Показатель = Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюЖизни;
	СтрокаТаблицыЗначений.КодСтроки = "011";
	СтрокаТаблицыЗначений.НаименованиеУзла = "Cell_168";
	
	СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
	СтрокаТаблицыЗначений.Показатель = Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюЖизни;
	СтрокаТаблицыЗначений.КодСтроки = "010";
	СтрокаТаблицыЗначений.НаименованиеУзла = "Cell_164";  	
	
	СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
	СтрокаТаблицыЗначений.Показатель = Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни;
	СтрокаТаблицыЗначений.КодСтроки = "010";
	СтрокаТаблицыЗначений.НаименованиеУзла = "Cell_164";


	
	СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
	СтрокаТаблицыЗначений.Показатель = Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни;
	СтрокаТаблицыЗначений.КодСтроки = "015";
	СтрокаТаблицыЗначений.НаименованиеУзла = "Cell_180";

	СтрокаТаблицыЗначений = ТаблицаЗначений.Добавить();
	СтрокаТаблицыЗначений.Показатель = Перечисления.ВидыПоказателейСтраховыхКомпаний.РезервНезаработаннойПремии;
	СтрокаТаблицыЗначений.КодСтроки = "017";
	СтрокаТаблицыЗначений.НаименованиеУзла = "Cell_188";
	                                                     
