		КонецЕсли;	
	КонецЕсли;
	 
	РасчетныеПоказателиНаСервере.Вставить("СтраховыеРезервыИныеКромеРезерваУбытков", СтраховыеРезервыИныеКромеРезерваУбытков);
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСК.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _Эмитенты
		|ИЗ
		|	&АктивыСК КАК _АктивыСК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыЛицензийСрезПоследних.Период КАК Период,
		|	СтатусыЛицензийСрезПоследних.Лицензия КАК Лицензия,
		|	СтатусыЛицензийСрезПоследних.Статус КАК Статус,
		|	_Эмитенты.Эмитент КАК Эмитент
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, ) КАК СтатусыЛицензийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Эмитенты КАК _Эмитенты
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо = _Эмитенты.Эмитент";
		
	Запрос.УстановитьПараметр("АктивыСК", РасчетныеПоказателиНаСервере.РаспределенныеАктивыСтраховойКомпании);
	Запрос.УстановитьПараметр("Период", Объект.Период);	
	
	РасчетныеПоказателиНаСервере.Вставить("СтатусыЛицензий", Запрос.Выполнить().Выгрузить());

		// сохранение
	ЭтаФорма.РасчетныеПоказатели = Новый ХранилищеЗначения(РасчетныеПоказателиНаСервере);
			
КонецПроцедуры // ЗаполнитьРасчетныеПоказателиНаСервере

&НаСервере
Процедура ЗаполнитьПарамерыВЗапросеНаСервере(Запрос)
	
	// расчетные показатели
	
	Если РасчетныеПоказателиНаСервере = Неопределено Тогда
		РасчетныеПоказателиНаСервере = ЭтаФорма.РасчетныеПоказатели.Получить();
	КонецЕсли;
	
	
	Для каждого КлючЗначение Из РасчетныеПоказателиНаСервере Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	// справочные показатели
	Если СправочныеПоказателиНаСервере = Неопределено Тогда
		СправочныеПоказателиНаСервере = ЭтаФорма.СправочныеПоказатели.Получить();
	КонецЕсли;

	Для каждого КлючЗначение Из СправочныеПоказателиНаСервере Цикл
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	// параметры текущей процедуры
	Для каждого Элемент Из ЭтаФорма.ПараметрыТекущейПроверки Цикл
		Запрос.УстановитьПараметр(Элемент.Представление, ?(Лев(Элемент.Значение, 1) = "$", РасчетныеПоказателиНаСервере[Сред(Элемент.Значение, 2)], Элемент.Значение));
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Период", КонецДня(Объект.Период));
	
КонецПроцедуры // ЗаполнитьПарамерыВЗапросеНаСервере

&НаСервере
Процедура ОтсутствиеДефолтаЭмитентовЗаПоследние2ГодаНаСервере()
	// Рейтинги настроены
	Запрос = Новый Запрос;
	Запрос. Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеРейтингиТаблица.Субъект КАК Субъект,
		|	ВсеРейтингиТаблица.Шкала КАК Шкала,
		|	ВсеРейтингиТаблица.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВсеРейтингиТаблица.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ВсеРейтингиТаблица.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	ВсеРейтингиТаблица.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня,
		|	ВсеРейтингиТаблица.ВсеРейтингиПоУмолчанию КАК ВсеРейтингиПоУмолчанию
		|ПОМЕСТИТЬ _ВсеРейтинги0
		|ИЗ
		|	&ВсеРейтинги КАК ВсеРейтингиТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеРейтинги.Субъект КАК Субъект,
		|	ВсеРейтинги.Шкала КАК Шкала,
		|	ВсеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВсеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ВсеРейтинги.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	ВсеРейтинги.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня
		|ПОМЕСТИТЬ _ВсеРейтинги
		|ИЗ
		|	_ВсеРейтинги0 КАК ВсеРейтинги
		|ГДЕ
		|	ВсеРейтинги.ВсеРейтингиПоУмолчанию = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДефолтныеРейтинги.Субъект КАК Субъект,
		|	ДефолтныеРейтинги.Шкала КАК Шкала,
		|	ДефолтныеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ДефолтныеРейтинги.Агрегатор КАК Агрегатор,
		|	ДефолтныеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ДефолтныеРейтинги.ЗначениеМаксимальное КАК ЗначениеМаксимальное
		|ПОМЕСТИТЬ _ДефолтныеРейтинги
		|ИЗ
		|	&ДефолтныеРейтинги КАК ДефолтныеРейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании <> ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.ПортфельВДоверительномУправлении)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент КАК Эмитент,
		|	_ДефолтныеРейтинги.Шкала КАК Шкала,
		|	_ДефолтныеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_ДефолтныеРейтинги.Агрегатор КАК Агрегатор,
		|	_ДефолтныеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ВЫБОР
		|		КОГДА _ВсеРейтинги.Субъект ЕСТЬ NULL
		|			ТОГДА ""ДА""
		|		ИНАЧЕ ""НЕТ""
		|	КОНЕЦ КАК РейтингОтсутствует,
		|	ВЫБОР
		|		КОГДА _ДефолтныеРейтинги.Субъект ЕСТЬ NULL
		|			ТОГДА ""НЕТ""
		|		ИНАЧЕ ""ДА""
		|	КОНЕЦ КАК Дефолт
		|ПОМЕСТИТЬ _РейтингиРаспределенныхАктивов
		|ИЗ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК _СтоимостьЦенныхБумагСтраховыхКомпаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДефолтныеРейтинги КАК _ДефолтныеРейтинги
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент = _ДефолтныеРейтинги.Субъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеРейтинги КАК _ВсеРейтинги
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент = _ВсеРейтинги.Субъект
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент,
		|	_ДефолтныеРейтинги.Шкала,
		|	_ДефолтныеРейтинги.РейтинговоеАгентство,
		|	_ДефолтныеРейтинги.Агрегатор,
		|	_ДефолтныеРейтинги.ЗначениеРейтинга,
		|	ВЫБОР
		|		КОГДА _ВсеРейтинги.Субъект ЕСТЬ NULL
		|			ТОГДА ""ДА""
		|		ИНАЧЕ ""НЕТ""
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _ДефолтныеРейтинги.Субъект ЕСТЬ NULL
		|			ТОГДА ""НЕТ""
		|		ИНАЧЕ ""ДА""
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РейтингиРаспределенныхАктивов.Эмитент КАК Эмитент,
		|	_РейтингиРаспределенныхАктивов.Шкала КАК Шкала,
		|	_РейтингиРаспределенныхАктивов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиРаспределенныхАктивов.Агрегатор КАК Агрегатор,
		|	_РейтингиРаспределенныхАктивов.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_РейтингиРаспределенныхАктивов.РейтингОтсутствует КАК РейтингОтсутствует,
		|	_РейтингиРаспределенныхАктивов.Дефолт КАК Дефолт
		|ИЗ
		|	_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов
		|ГДЕ
		|	(_РейтингиРаспределенныхАктивов.Дефолт = ""ДА""
		|			ИЛИ _РейтингиРаспределенныхАктивов.РейтингОтсутствует = ""ДА"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент,
		|	РейтинговоеАгентство,
		|	Шкала,
		|	Дефолт
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _РейтингиРаспределенныхАктивов.Дефолт = ""ДА""
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК Дефолт,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _РейтингиРаспределенныхАктивов.РейтингОтсутствует = ""ДА""
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК НетРейтинга
		|ИЗ
		|	_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов";
			
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Ошибки         = ПакетРезультатов[6].Выгрузить();
	Показатели     = ПакетРезультатов[5].Выгрузить(); 	
	
	
	Расшифровка = "";
	СтатусПроверки = 1;
	
	
	Если (Ошибки.Количество() > 0) Тогда
		Если (Ошибки[0].Дефолт > 0) Тогда
			СтатусПроверки = 2;
		ИначеЕсли (Ошибки[0].НетРейтинга > 0 ) Тогда
			СтатусПроверки = 3;
		КонецЕсли;
	КонецЕсли;
	
	Если СтатусПроверки > 1 Тогда
		Расшифровка = Расшифровка + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Предупреждения");
	Иначе
		Расшифровка = Расшифровка + Символы.ПС + Символы.ПС + "Нет эмитентов с дефолтным рейтингом за последние 2 года.";
	КонецЕсли;
	
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, Расшифровка, 0, 0, 0);
	
КонецПроцедуры // ОтсутствиеДефолтаЭмитентовЗаПоследние2ГодаНаСервере

&НаСервере
Процедура ИспользованиеПаевИнтервальныхПаевыхФондовНаСервере() 
	
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	  	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
	  	|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок
	  	|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|ИЗ
	  	|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
	  	|ГДЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
	  	|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент КАК Эмитент,
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Актив,
	  	|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	РасчетныеЦеныПаевСрезПоследних.КоличествоПаев КАК КоличествоПаев,
	  	|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена * РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) КАК СЧА,
	  	|	Паи.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
	  	|ПОМЕСТИТЬ _СчаПаевОткрытыхИИнтервальныхФондов
	  	|ИЗ
	  	|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
	  	|		ПО ((ВЫРАЗИТЬ(СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Справочник.Паи)) = Паи.Ссылка)
	  	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних КАК РасчетныеЦеныПаевСрезПоследних
	  	|		ПО СтоимостьЦенныхБумагСтраховыхКомпаний.Актив = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	  	|ГДЕ
	  	|	Паи.ПаевойИнвестиционныйФонд.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный)
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Эмитент КАК Эмитент,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.ПаевойИнвестиционныйФонд КАК ПИФ,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Актив КАК Актив,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.КоличествоПаев КАК КоличествоПаев,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.СЧА КАК СЧА
	  	|ИЗ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов КАК _СчаПаевОткрытыхИИнтервальныхФондов"  ;
		ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		СтатусПроверки = 1;
				
		Показатели = Запрос.Выполнить().Выгрузить();
				
		Если Показатели.Количество() > 0 Тогда  			
			СтатусПроверки = 3;		
			ОтчетВФорматеHTML = "Запрещено инвестирование в паи интервальных паевых инвестиционных фондов, за исключением фондов,"
	 + Символы.ПС + "правилами доверительного управления которых предусмотрена возможность погашения инвестиционных паев " 
	  + Символы.ПС + "в течение года и которые размещают на официальном сайте управляющей компании справки о стоимости "
	   + Символы.ПС + "чистых активов фонда." + Символы.ПС + Символы.ПС;
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Инвестирование в паи интервальных ПИФов")  + Символы.ПС 
			 + Символы.ПС  + "Контроль требований, объявленных выше, не может быть осуществлен в автоматическом режиме.";
