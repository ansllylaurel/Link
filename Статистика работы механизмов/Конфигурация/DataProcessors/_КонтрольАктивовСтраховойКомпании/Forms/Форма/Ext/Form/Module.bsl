&НаСервере
Процедура УчастиеВКапиталеИностранныхОрганизацийИлиНеЯвляющихсяАкционернымиОбществамиНаСервере()
	//исправлено
	 
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент КАК Эмитент,
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Актив,
		|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма,
		|	ВЫБОР
		|		КОГДА _СтоимостьЦенныхБумагСтраховыхКомпаний.ЭмитентЯвляетсяРезидентомРФ = ЛОЖЬ
		|				ИЛИ НЕ РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма В (ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ОткрытоеАкционерноеОбщество), ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ЗакрытоеАкционерноеОбщество))
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Нарушение,
		|	ВЫБОР
		|		КОГДА _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент ЕСТЬ NULL
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЭмитентНеИзвестен
		|ИЗ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК _СтоимостьЦенныхБумагСтраховыхКомпаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент = ЮрФизЛица.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ЮрФизЛица.Ссылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ,
		|	ЭмитентНеИзвестен УБЫВ";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	Результат = Запрос.Выполнить().Выгрузить();
	 	
	Расшифровка = "";
	СтатусПроверки = 1;
	
	
	Если (Результат.Количество() > 0) Тогда
		Если (Результат[0].Нарушение = 1) Тогда
			СтатусПроверки = 2;
			Расшифровка = "Стоимость долей, иного участия в уставном капитале юридических лиц, не являющихся акционерными обществами (долей, иного участия в уставных капиталах иностранных организаций) должна быть равна нулю";
		ИначеЕсли (Результат[0].ЭмитентНеИзвестен > 0 ) Тогда
			СтатусПроверки = 3;
			Расшифровка = "Не известна правовая форма или гражданство организации, в чей уставный капитал произведен вклад.";
		КонецЕсли;
	КонецЕсли;
	
	Если СтатусПроверки > 1 Тогда
		Расшифровка =  ТаблицаВФорматеHTML(Результат, "Предупреждения") + Символы.ПС + Символы.ПС + Расшифровка;
	Иначе
		Расшифровка = Расшифровка + Символы.ПС + Символы.ПС + "Не найдены доли, иное участе в уставном капитале юридических лиц, не являющихся акционерными обществами (доли, иного участия в уставных капиталах иностранных организаций);.";
	КонецЕсли;
	
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, Расшифровка, 0, 0, 0);

