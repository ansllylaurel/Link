	РейтингиЦенныхБумаг = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтатусПроверки = 1;
	
	Если Результат.Строки.Количество() > 0 Тогда
		Если Результат.Строки[0].Ошибка Тогда
			СтатусПроверки = 2;
		КонецЕсли;
