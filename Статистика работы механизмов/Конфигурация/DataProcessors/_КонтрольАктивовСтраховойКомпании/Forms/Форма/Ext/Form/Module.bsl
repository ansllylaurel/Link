&НаСервере
Процедура ДоляДепозитныхАктивовЭмитентовСДостаточнымРейтингомНаСервере()
	//Устарело, не используется
	
	СтатусПроверки    = 1; 
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ДепозитныеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.ДепозитарныеРасписки))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МинимальноДопустимыеРейтинги.РейтинговоеАгентство,
		|	МинимальноДопустимыеРейтинги.Шкала,
		|	МинимальноДопустимыеРейтинги.Рейтинг,
		|	МинимальноДопустимыеРейтинги.УровеньРейтинга
		|ПОМЕСТИТЬ _МинимальноДопустимыеРейтинги
		|ИЗ
		|	&МинимальноДопустимыеРейтинги КАК МинимальноДопустимыеРейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивы.Эмитент,
		|	РейтингиСрезПоследних.РейтинговоеАгентство,
		|	РейтингиСрезПоследних.Шкала,
		|	РейтингиСрезПоследних.Рейтинг,
		|	РейтингиСрезПоследних.УровеньРейтинга,
		|	_МинимальноДопустимыеРейтинги.Рейтинг КАК ДопустимыйРейтинг,
		|	_МинимальноДопустимыеРейтинги.УровеньРейтинга КАК УровеньДопустимогоРейтинга,
		|	ВЫБОР
		|		КОГДА РейтингиСрезПоследних.УровеньРейтинга >= ЕСТЬNULL(_МинимальноДопустимыеРейтинги.УровеньРейтинга, 0)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК КорректныйУровеньРейтинга
		|ПОМЕСТИТЬ _ВсеРейтингиЭмитентов
		|ИЗ
		|	_ДепозитныеАктивы КАК _ДепозитныеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Рейтинги.СрезПоследних(
		|				&Период,
		|				Субъект В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ДепозитныеАктивы.Эмитент
		|					ИЗ
		|						_ДепозитныеАктивы)) КАК РейтингиСрезПоследних
		|		ПО _ДепозитныеАктивы.Эмитент = РейтингиСрезПоследних.Субъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МинимальноДопустимыеРейтинги КАК _МинимальноДопустимыеРейтинги
		|		ПО (РейтингиСрезПоследних.РейтинговоеАгентство = _МинимальноДопустимыеРейтинги.РейтинговоеАгентство)
		|			И (РейтингиСрезПоследних.Шкала = _МинимальноДопустимыеРейтинги.Шкала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВсеРейтингиЭмитентов.Эмитент,
		|	СУММА(ВЫБОР
		|			КОГДА _ВсеРейтингиЭмитентов.КорректныйУровеньРейтинга
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КорректныйУровень
		|ПОМЕСТИТЬ _ЭмитентыСКорректнымРейтингом
		|ИЗ
		|	_ВсеРейтингиЭмитентов КАК _ВсеРейтингиЭмитентов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеРейтингиЭмитентов.Эмитент
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА _ВсеРейтингиЭмитентов.КорректныйУровеньРейтинга
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивы.Эмитент,
		|	_ДепозитныеАктивы.Актив,
		|	_ДепозитныеАктивы.СуммаВВалютеУчета
		|ПОМЕСТИТЬ _РейтингиЭмитентов
		|ИЗ
		|	_ДепозитныеАктивы КАК _ДепозитныеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЭмитентыСКорректнымРейтингом КАК _ЭмитентыСКорректнымРейтингом
		|		ПО (_ЭмитентыСКорректнымРейтингом.Эмитент = _ДепозитныеАктивы.Эмитент)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_РейтингиЭмитентов КАК _РейтингиЭмитентов
		|ГДЕ
		|	&ОбъемСредств > 0";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	Результат = Запрос.Выполнить().Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	     	
	
	Если Результат.Количество() > 0 Тогда
		
		Если Результат[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат, "Доля депозитов, деп. сертификатов, размещенных в банках с достаточным рейтингом.");
		
		Сумма 		= Результат[0].СуммаВВалютеУчета;
		База  		= Результат[0].ОбъемСредств;
		Показатель	= Результат[0].ДоляСредств;
		
	Иначе
		СтатусПроверки = 1;
	КонецЕсли;
	 	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляДепозитныхАктивовЭмитентовСДостаточнымРейтингомНаСервере

