		|	И (РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.ДепозитныеСертификаты)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.БанковскиеКарты)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.Кассы))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумагиЮрЛиц.Эмитент КАК Эмитент,
		|	ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	(ВЫБРАТЬ
		|		_АктивыБанков.Эмитент КАК Эмитент,
		|		СУММА(_АктивыБанков.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|	ИЗ
		|		_АктивыБанков КАК _АктивыБанков
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_АктивыБанков.Эмитент) КАК ЦенныеБумагиЮрЛиц
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ,
		|	ЦенныеБумагиЮрЛиц.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыБанков.Эмитент КАК Эмитент,
		|	_АктивыБанков.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_АктивыБанков КАК _АктивыБанков";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Ипотечные ценные бумаги");
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляАктивовОдногоБанкаНаСервере

&НаСервере
Процедура ДоляПортфеляВГруппеПортфелейНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ВсеАктивыСтраховойКомпании
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	_ВсеАктивыСтраховойКомпании.Актив КАК Актив,
		|	_ВсеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ВсеАктивыПортфеля
		|ИЗ
		|	_ВсеАктивыСтраховойКомпании КАК _ВсеАктивыСтраховойКомпании
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО _ВсеАктивыСтраховойКомпании.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Значение В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ВсеАктивыПортфеля.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_ВсеАктивыПортфеля.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	&МаксДоляСредств КАК МаксДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_ВсеАктивыПортфеля.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ВсеАктивыПортфеля КАК _ВсеАктивыПортфеля
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеАктивыПортфеля.Эмитент КАК Эмитент,
		|	_ВсеАктивыПортфеля.Актив КАК Актив,
		|	_ВсеАктивыПортфеля.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_ВсеАктивыПортфеля КАК _ВсеАктивыПортфеля";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля портфеля в группе");
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
		СтатусПроверки = 3;

	КонецЕсли;	
	
	Если Расшифровка.Количество() = 0 Тогда		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");		
	КонецЕсли;       
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

&НаСервере
Процедура ДоляДепозитныхАктивовОдногоБанкаНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ДепозитныеАктивыБанков
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.ДепозитарныеРасписки))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумагиЮрЛиц.Эмитент,
		|	ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДепозитныеАктивыБанков.Эмитент КАК Эмитент,
		|		СУММА(_ДепозитныеАктивыБанков.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|	ИЗ
		|		_ДепозитныеАктивыБанков КАК _ДепозитныеАктивыБанков
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ДепозитныеАктивыБанков.Эмитент) КАК ЦенныеБумагиЮрЛиц
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ,
		|	ЦенныеБумагиЮрЛиц.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивыБанков.Эмитент,
		|	_ДепозитныеАктивыБанков.Актив,
		|	_ДепозитныеАктивыБанков.СуммаВВалютеУчета
		|ИЗ
		|	_ДепозитныеАктивыБанков КАК _ДепозитныеАктивыБанков";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		Если Запрос.Параметры.Свойство("Заголовок") Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля депозитных активов одного банка");
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
		СтатусПроверки = 3;
	КонецЕсли;
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляДепозитныхАктивовОдногоБанка

&НаСервере
Процедура ДоляПроизводныхАктивовНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ДепозитныеАктивыБанков
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.ДепозитарныеРасписки
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЦенныеБумагиЮрЛиц.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&РезервДопВыплат + &РезервОпций КАК ОбъемСредств,
		|	&РезервДопВыплат КАК РезервДопВыплат,
		|	&РезервОпций КАК РезервОпций,
