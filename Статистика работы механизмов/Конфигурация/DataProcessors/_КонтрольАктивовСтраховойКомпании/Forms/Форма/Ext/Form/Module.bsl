		|	_СубординированныеАктивы.Рынок КАК Рынок,
		|	_СубординированныеАктивы.Актив КАК Актив,
		|	_СубординированныеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_СубординированныеАктивы КАК _СубординированныеАктивы
		|ГДЕ
		|	_СубординированныеАктивы.Субординированность = ИСТИНА";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
		
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
