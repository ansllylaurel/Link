		|	_ЛистингиЦенныхБумаг.Эмитент КАК Эмитент,
		|	_ЛистингиЦенныхБумаг.Актив КАК Актив,
		|	_ЛистингиЦенныхБумаг.Рынок КАК Рынок,
		|	_ЛистингиЦенныхБумаг.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_ЛистингиЦенныхБумаг.Листинг КАК Листинг,
		|	_ЛистингиЦенныхБумаг.ДатаЛистинга КАК ДатаЛистинга
		|ИЗ
		|	_ЛистингиЦенныхБумаг КАК _ЛистингиЦенныхБумаг
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент,
		|	Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РейтингиРаспределенныхАктивов.Актив КАК Актив,
		|	_РейтингиРаспределенныхАктивов.Эмитент КАК Эмитент,
		|	_РейтингиРаспределенныхАктивов.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_РейтингиРаспределенныхАктивов.Рынок КАК Рынок,
		|	_РейтингиРаспределенныхАктивов.ТипРейтинга КАК ТипРейтинга,
		|	_РейтингиРаспределенныхАктивов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиРаспределенныхАктивов.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_РейтингиРаспределенныхАктивов.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	_РейтингиРаспределенныхАктивов.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня
		|ИЗ
		|	_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент,
		|	Актив,
		|	РейтинговоеАгентство";
	#КонецОбласти
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Результат           = ПакетРезультатов[ПакетРезультатов.Количество() - 3].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЛистингиЦенныхБумаг = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	РейтингиЦенныхБумаг = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтатусПроверки = 1;
	Расшифровка = "";
	Если Результат.Строки.Количество() > 0 Тогда
		Если Результат.Строки[0].Ошибка Тогда
			СтатусПроверки = 2;
		КонецЕсли;
	Иначе
		Расшифровка = "" + Символы.ПС + "Не обнаружены активы, подлежащие назначению рейтинга или включению в листинги цб.";
	КонецЕсли;
	
	Предупреждение = "";
	Для Каждого Строка Из ЛистингиЦенныхБумаг.Строки Цикл
		Если Предупреждение = "" И Строка.ЭмитентЯвляетсяРезидентомРФ = Ложь И Строка.Листинг <> "1" И СтатусПроверки = 1 Тогда
			Предупреждение = "Среди активов присутствуют ценные бумаги нерезидентов РФ с неизвестным уровнем листинга.";
			СтатусПроверки = 3;
		КонецЕсли;
	КонецЦикла;
	Если Предупреждение <> "" Тогда
		Расшифровка = Расшифровка + Символы.ПС + Предупреждение;
	КонецЕсли;
	
	// Отчёт
	Расшифровка = Расшифровка + Символы.ПС + "<h3>Требуемый уровень листинга на бирже ММВБ: " + Запрос.Параметры.ИсточникБиржевыхКотировок
		+ " - " + Запрос.Параметры.ТребуемыйЛистингРезидентаРФ + ".</h3>";
	
	Если Результат.Строки.Количество() > 0 Тогда
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(Результат, "Результат проверки");
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(ЛистингиЦенныхБумаг, "Листинги ценных бумаг.");
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(РейтингиЦенныхБумаг, "Рейтинги ценных бумаг и эмитентов ценных бумаг.");
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, Расшифровка, 0, 0, 0);
КонецПроцедуры // ВключениеЦенныхБумагВКотировальныеСпискиИлиДопустимостьРейтингаЭмитентаНаСервере

&НаСервере
Процедура ПроверкаДостаточнойСЧАДляПаевОткрытыхИИнтервальныхПИФНаСервере() 
	
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	  	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
	  	|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок
	  	|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|ИЗ
	  	|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
	  	|ГДЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
	  	|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент КАК Эмитент,
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Актив,
	  	|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	РасчетныеЦеныПаевСрезПоследних.КоличествоПаев КАК КоличествоПаев,
	  	|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена * РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) КАК СЧА,
	  	|	Паи.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
	  	|ПОМЕСТИТЬ _СчаПаевОткрытыхИИнтервальныхФондов
	  	|ИЗ
	  	|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
	  	|		ПО ((ВЫРАЗИТЬ(СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Справочник.Паи)) = Паи.Ссылка)
	  	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних КАК РасчетныеЦеныПаевСрезПоследних
	  	|		ПО СтоимостьЦенныхБумагСтраховыхКомпаний.Актив = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	  	|ГДЕ
	  	|	(Паи.ПаевойИнвестиционныйФонд.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
	  	|			ИЛИ Паи.ПаевойИнвестиционныйФонд.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный))
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Эмитент КАК Эмитент,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.ПаевойИнвестиционныйФонд КАК ПИФ,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Актив КАК Актив,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.КоличествоПаев КАК КоличествоПаев,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.СЧА КАК СЧА,
	  	|	&МинимальныйРазмерСЧА КАК МинимальныйРазмерСЧА,
	  	|	ВЫБОР
	  	|		КОГДА &МинимальныйРазмерСЧА > _СчаПаевОткрытыхИИнтервальныхФондов.СЧА
	  	|			ТОГДА ИСТИНА
	  	|		ИНАЧЕ ЛОЖЬ
	  	|	КОНЕЦ КАК Нарушение
	  	|ИЗ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов КАК _СчаПаевОткрытыхИИнтервальныхФондов
	  	|
	  	|УПОРЯДОЧИТЬ ПО
	  	|	Нарушение УБЫВ"  ;
		ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		СтатусПроверки = 1;
				
		Показатели = Запрос.Выполнить().Выгрузить();
				
		Если Показатели.Количество() > 0 Тогда
			Если Показатели[0].Нарушение Тогда
				СтатусПроверки = 2;
			КонецЕсли; 					
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Достаточность СЧА открытых и интервальных ПИФов");
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + "В распределении отсутствуют паи открытых и интервальных фондов";
		КонецЕсли; 				
		ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, 0, 0, 0);     		
	
КонецПроцедуры

&НаСервере
Процедура ПроверкаРаспределенияПроцентныхДоходовНаСервере()
	
	//  Начисленные проценты по вкладам, начисленные купоны нельзя распределять по страховым резервам, только по собственным средствам
	Запрос = Новый Запрос();			
	СтатусПроверки = 1;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива КАК ВидАктива,
		|	РаспределенныеАктивыСтраховойКомпании.КурсВалюты КАК КурсВалюты
		|ПОМЕСТИТЬ _АктивыСПроцентнымиДоходамиБезГруппировки
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.ДепозитныеВклады)
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.Актив КАК Актив,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.Эмитент КАК Эмитент,
		|	СУММА(_АктивыСПроцентнымиДоходамиБезГруппировки.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.ВидАктива КАК ВидАктива,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.КурсВалюты КАК КурсВалюты
		|ПОМЕСТИТЬ _АктивыСПроцентнымиДоходами
		|ИЗ
		|	_АктивыСПроцентнымиДоходамиБезГруппировки КАК _АктивыСПроцентнымиДоходамиБезГруппировки
		|
		|СГРУППИРОВАТЬ ПО
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.ВидАктива,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.КурсВалюты,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.Эмитент,
		|	_АктивыСПроцентнымиДоходамиБезГруппировки.Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ЛицевойСчет.ДепозитныйВклад КАК ДепозитныйВклад,
		|	ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ВалютнаяСуммаОстаток КАК Номинал,
		|	ЕдиныйБухгалтерскийУчетОстаткиПроцентов.ВалютнаяСуммаОстаток КАК Проценты
		|ПОМЕСТИТЬ _Депозиты
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиНоминалов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиПроцентов
		|		ПО ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ЛицевойСчет.ДепозитныйВклад = ЕдиныйБухгалтерскийУчетОстаткиПроцентов.Субконто1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АктивыСПроцентнымиДоходами КАК _АктивыСПроцентнымиДоходами
		|		ПО ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ЛицевойСчет.ДепозитныйВклад = _АктивыСПроцентнымиДоходами.Актив
		|ГДЕ
		|	НЕ ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ЛицевойСчет.ДепозитныйВклад ЕСТЬ NULL
		|	И НЕ ЕдиныйБухгалтерскийУчетОстаткиНоминалов.ЛицевойСчет.ДепозитныйВклад = ЗНАЧЕНИЕ(Справочник.ДепозитныеВклады.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток, 0) + ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток, 0)) КАК Купон,
		|	СУММА(БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремия,
		|	СУММА(БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток) КАК КорректировкаЭСП,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВключатьПроцентныеДоходыИКорректировкиВБалансовуюСтоимостьПриПереоценке, ИСТИНА) КАК ВключатьРасходыПоПокупкеВСтоимость,
		|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток) КАК СтоимостьОстаток,
		|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток) КАК СтоимостьПокупкиОстаток,
		|	СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) КАК ПереоценкаОстаток
		|ПОМЕСТИТЬ _Облигации
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АктивыСПроцентнымиДоходами КАК _АктивыСПроцентнымиДоходами
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = _АктивыСПроцентнымиДоходами.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВключатьПроцентныеДоходыИКорректировкиВБалансовуюСтоимостьПриПереоценке, ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСПроцентнымиДоходами.Актив КАК Облигация,
		|	_АктивыСПроцентнымиДоходами.Эмитент КАК Эмитент,
		|	_АктивыСПроцентнымиДоходами.ВидАктива КАК ВидАктива,
		|	_АктивыСПроцентнымиДоходами.СуммаВВалютеУчета КАК СуммаВРезервах,
		|	_Облигации.Купон * _АктивыСПроцентнымиДоходами.КурсВалюты КАК Купон,
		|	_Облигации.ДисконтПремия * _АктивыСПроцентнымиДоходами.КурсВалюты КАК ДисконтПремия,
		|	_Облигации.КорректировкаЭСП * _АктивыСПроцентнымиДоходами.КурсВалюты КАК КорректировкаЭСП,
		|	_Облигации.СтоимостьОстаток * _АктивыСПроцентнымиДоходами.КурсВалюты КАК Стоимость,
		|	_Облигации.СтоимостьПокупкиОстаток * _АктивыСПроцентнымиДоходами.КурсВалюты КАК СтоимостьПокупки,
		|	_Облигации.ПереоценкаОстаток * _АктивыСПроцентнымиДоходами.КурсВалюты КАК Переоценка,
		|	ВЫБОР
		|		КОГДА _Облигации.ВключатьРасходыПоПокупкеВСтоимость
		|			ТОГДА _Облигации.СтоимостьОстаток + _Облигации.ПереоценкаОстаток + _Облигации.ДисконтПремия + _Облигации.КорректировкаЭСП
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _Облигации.ДисконтПремия < 0
		|					ТОГДА _Облигации.СтоимостьОстаток + _Облигации.ПереоценкаОстаток
		|				ИНАЧЕ _Облигации.СтоимостьПокупкиОстаток + _Облигации.ПереоценкаОстаток
		|			КОНЕЦ
		|	КОНЕЦ * _АктивыСПроцентнымиДоходами.КурсВалюты КАК БалансоваяСтоимость,
		|	ВЫБОР
		|		КОГДА _Облигации.ВключатьРасходыПоПокупкеВСтоимость
		|			ТОГДА ""СТОИМОСТЬ + ПЕРЕОЦЕНКА + ДИСКОНТ/ПРЕМИЯ + КОРР.ЭСП""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _Облигации.ДисконтПремия < 0
		|					ТОГДА ""СТОИМОСТЬ + ПЕРЕОЦЕНКА""
		|				ИНАЧЕ ""СТОИМОСТЬ ПОКУПКИ + ПЕРЕОЦЕНКА""
		|			КОНЕЦ
		|	КОНЕЦ КАК ФормулаРасчета,
		|	_Облигации.ВключатьРасходыПоПокупкеВСтоимость КАК ВключатьРасходыПоПокупкеВСтоимость
		|ПОМЕСТИТЬ _ОблигацииСРасчетнойСтоимостью
		|ИЗ
		|	_АктивыСПроцентнымиДоходами КАК _АктивыСПроцентнымиДоходами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Облигации КАК _Облигации
		|		ПО _АктивыСПроцентнымиДоходами.Актив = _Облигации.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОблигацииСРасчетнойСтоимостью.Облигация КАК Облигация,
		|	СУММА(_ОблигацииСРасчетнойСтоимостью.СуммаВРезервах) КАК СуммаВРезервах,
		|	_ОблигацииСРасчетнойСтоимостью.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	_ОблигацииСРасчетнойСтоимостью.Купон КАК Купон,
		|	_ОблигацииСРасчетнойСтоимостью.ДисконтПремия КАК ДисконтПремия,
		|	_ОблигацииСРасчетнойСтоимостью.КорректировкаЭСП КАК КорректировкаЭСП,
		|	_ОблигацииСРасчетнойСтоимостью.Стоимость КАК Стоимость,
		|	_ОблигацииСРасчетнойСтоимостью.СтоимостьПокупки КАК СтоимостьПокупки,
		|	_ОблигацииСРасчетнойСтоимостью.Переоценка КАК Переоценка,
		|	ВЫБОР
		|		КОГДА _ОблигацииСРасчетнойСтоимостью.СуммаВРезервах > _ОблигацииСРасчетнойСтоимостью.БалансоваяСтоимость
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение,
		|	_ОблигацииСРасчетнойСтоимостью.ФормулаРасчета КАК ФормулаРасчета
		|ИЗ
		|	_ОблигацииСРасчетнойСтоимостью КАК _ОблигацииСРасчетнойСтоимостью
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОблигацииСРасчетнойСтоимостью.ФормулаРасчета,
		|	ВЫБОР
		|		КОГДА _ОблигацииСРасчетнойСтоимостью.СуммаВРезервах > _ОблигацииСРасчетнойСтоимостью.БалансоваяСтоимость
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	_ОблигацииСРасчетнойСтоимостью.Облигация,
		|	_ОблигацииСРасчетнойСтоимостью.ВключатьРасходыПоПокупкеВСтоимость,
		|	_ОблигацииСРасчетнойСтоимостью.БалансоваяСтоимость,
		|	_ОблигацииСРасчетнойСтоимостью.Купон,
		|	_ОблигацииСРасчетнойСтоимостью.ДисконтПремия,
		|	_ОблигацииСРасчетнойСтоимостью.КорректировкаЭСП,
		|	_ОблигацииСРасчетнойСтоимостью.Стоимость,
		|	_ОблигацииСРасчетнойСтоимостью.СтоимостьПокупки,
		|	_ОблигацииСРасчетнойСтоимостью.Переоценка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСПроцентнымиДоходами.Актив КАК Актив,
		|	_АктивыСПроцентнымиДоходами.Эмитент КАК Эмитент,
		|	_АктивыСПроцентнымиДоходами.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	_Депозиты.Номинал КАК Номинал,
		|	_Депозиты.Проценты КАК Проценты,
		|	_АктивыСПроцентнымиДоходами.КурсВалюты, 
		|	ВЫБОР
		|		КОГДА _АктивыСПроцентнымиДоходами.СуммаВВалютеУчета > _Депозиты.Номинал * _АктивыСПроцентнымиДоходами.КурсВалюты
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_АктивыСПроцентнымиДоходами КАК _АктивыСПроцентнымиДоходами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Депозиты КАК _Депозиты
		|		ПО _АктивыСПроцентнымиДоходами.Актив = _Депозиты.ДепозитныйВклад
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	Запрос.УстановитьПараметр("Организация", Объект.Организация); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);

	ПакетРезультатов = Запрос.ВыполнитьПакет();
		
	Облигации   	= ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Депозиты	    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	ОтчетВФорматеHTML = "";
		
	Если Облигации.Количество() > 0 Тогда
			
		Если Облигации[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
			
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Облигации, "Облигации"); 
			
	Иначе
			
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + "В распределении на дату контроля отсутствуют облигации";
			
	КонецЕсли;
		
	Если Депозиты.Количество() > 0 Тогда
			
		Если Депозиты[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Депозиты, "Депозиты");
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + "В распределении на дату контроля отсутствуют Депозиты";
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
		
КонецПроцедуры

&НаСервере
Процедура ДопустимостьРейтингаБанковРасчетныхИДепозитныхСчетовНаСервере()
	//исправлено
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива,
		|	РаспределенныеАктивыСтраховойКомпании.СтрокаСопоставленияРейтингов КАК СтрокаСопоставления
		|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании <> ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеРейтинги.Субъект,
		|	ВсеРейтинги.Шкала,
		|	ВсеРейтинги.РейтинговоеАгентство,
		|	ВсеРейтинги.ЗначениеРейтинга,
		|	ВсеРейтинги.МинимальноДопустимыйРейтинг,
		|	ВсеРейтинги.ВсеРейтингиПоУмолчанию,
		|	ВсеРейтинги.Дефолт,
		|	ВсеРейтинги.СубординированныеОблигации,
		|	ВсеРейтинги.СубординированныеДепозиты,
		|	ВсеРейтинги.ОблигацииСДатойВыпускаДо1307,
		|	ВсеРейтинги.РейтингДостаточногоУровня,
		|	ВсеРейтинги.РейтингВышеВерхнейГраницы,
		|	ВсеРейтинги.СтрокаСопоставления,
		|	ВсеРейтинги.РезидентРФ
		|ПОМЕСТИТЬ _ВсеРейтинги
		|ИЗ
		|	&ВсеРейтинги КАК ВсеРейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтоимостьЦенныхБумаг.Эмитент,
		|	СтоимостьЦенныхБумаг.ЭмитентЯвляетсяРезидентомРФ,
		|	СтоимостьЦенныхБумаг.Актив,
		|	СтоимостьЦенныхБумаг.ВидАктива,
		|	""Рейтинг отсутствует или уровень рейтинга ниже разрешенного"" КАК ВидНарушения
		|ИЗ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК СтоимостьЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ВсеРейтинги.Субъект КАК Субъект,
		|			_ВсеРейтинги.РезидентРФ КАК РезидентРФ,
		|			_ВсеРейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|			СУММА(ВЫБОР
		|					КОГДА _ВсеРейтинги.РейтингДостаточногоУровня
		|						ТОГДА 1
		|					ИНАЧЕ 0
		|				КОНЕЦ) КАК СчетКорректныхРейтингов
		|		ИЗ
		|			_ВсеРейтинги КАК _ВсеРейтинги
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ВсеРейтинги.Субъект,
		|			_ВсеРейтинги.РезидентРФ,
		|			_ВсеРейтинги.СтрокаСопоставления) КАК Рейтинги
		|		ПО СтоимостьЦенныхБумаг.Эмитент = Рейтинги.Субъект
		|			И СтоимостьЦенныхБумаг.СтрокаСопоставления = Рейтинги.СтрокаСопоставления
		|			И СтоимостьЦенныхБумаг.ЭмитентЯвляетсяРезидентомРФ = Рейтинги.РезидентРФ
		|ГДЕ
		|	(Рейтинги.СчетКорректныхРейтингов = 0
		|			ИЛИ Рейтинги.Субъект ЕСТЬ NULL )
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент,
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.Актив,
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.ЭмитентЯвляетсяРезидентомРФ,
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний.ВидАктива,
		|	_ВсеРейтинги.Шкала,
		|	_ВсеРейтинги.РейтинговоеАгентство,
		|	_ВсеРейтинги.ЗначениеРейтинга,
		|	_ВсеРейтинги.МинимальноДопустимыйРейтинг,
		|	_ВсеРейтинги.РейтингДостаточногоУровня
		|ИЗ
		|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК _СтоимостьЦенныхБумагСтраховыхКомпаний
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеРейтинги КАК _ВсеРейтинги
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент = _ВсеРейтинги.Субъект
		|			И _СтоимостьЦенныхБумагСтраховыхКомпаний.СтрокаСопоставления = _ВсеРейтинги.СтрокаСопоставления
		|			И _СтоимостьЦенныхБумагСтраховыхКомпаний.ЭмитентЯвляетсяРезидентомРФ = _ВсеРейтинги.РезидентРФ";


	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Ошибки              = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЛистингиЦенныхБумаг = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтатусПроверки = ?(Ошибки.Строки.Количество() > 0, 2, 1);
	
	// отчет
	Расшифровка = "";
	Если Ошибки.Строки.Количество() > 0 Тогда
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(Ошибки, "Ошибки");
	КонецЕсли;	
	
	Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(ЛистингиЦенныхБумаг, "Рейтинги банков");
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, Расшифровка, 0, 0, 0);
	
КонецПроцедуры // ДопустимостьРейтингаБанковРасчетныхИДепозитныхСчетовНаСервере

&НаСервере
Процедура ДоляАктивовНеНаходящихсяНаТерриторииРФНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _РаспределенныеАктивыСтраховойКомпании
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И НЕ РаспределенныеАктивыСтраховойКомпании.ВидАктива В (&ИсключаемыеВидыАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивыСтраховойКомпанииНаТерриторииРФ.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	АктивыСтраховойКомпанииНаТерриторииРФ.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	АктивыСтраховойКомпанииНаТерриторииРФ.СуммаВВалютеУчета / &ОбъемСредств * 100 КАК ДоляАктивовНаходящихсяНеНаТерриторииРФ,
		|	&МаксДоляСредств КАК МаксДоляСредств,
		|	ВЫБОР
		|		КОГДА АктивыСтраховойКомпанииНаТерриторииРФ.СуммаВВалютеУчета / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	(ВЫБРАТЬ
		|		_РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|		СУММА(_РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|	ИЗ
		|		_РаспределенныеАктивыСтраховойКомпании КАК _РаспределенныеАктивыСтраховойКомпании
		|	ГДЕ
		|		НЕ _РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ) КАК АктивыСтраховойКомпанииНаТерриторииРФ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _РаспределенныеАктивыСтраховойКомпании.Эмитент ЕСТЬ NULL
		|			ТОГДА _РаспределенныеАктивыСтраховойКомпании.Актив
		|		КОГДА _РаспределенныеАктивыСтраховойКомпании.Эмитент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА _РаспределенныеАктивыСтраховойКомпании.Актив
		|		ИНАЧЕ _РаспределенныеАктивыСтраховойКомпании.Эмитент
		|	КОНЕЦ КАК ЭмитентИлиГруппаАктивов,
		|	_РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	СУММА(_РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|ИЗ
		|	_РаспределенныеАктивыСтраховойКомпании КАК _РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	НЕ _РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА _РаспределенныеАктивыСтраховойКомпании.Эмитент ЕСТЬ NULL
		|			ТОГДА _РаспределенныеАктивыСтраховойКомпании.Актив
		|		КОГДА _РаспределенныеАктивыСтраховойКомпании.Эмитент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА _РаспределенныеАктивыСтраховойКомпании.Актив
		|		ИНАЧЕ _РаспределенныеАктивыСтраховойКомпании.Эмитент
		|	КОНЕЦ,
		|	_РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ";	

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;
	
	Если Показатели.Количество() > 0 Тогда
		
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма = Показатели[0].СуммаВВалютеУчета;
		База  = Показатели[0].ОбъемСредств;
		Показатель = Показатели[0].ДоляАктивовНаходящихсяНеНаТерриторииРФ;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Активы страховой компании, находящиеся не на территории РФ");
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
			СтатусПроверки = 3;
	КонецЕсли;	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы страховой компании, находящиеся не на территории РФ";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");		
	КонецЕсли; 
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляАктивовНеНаходящихсяНаТерриторииРФНаСервере

&НаСервере
Процедура ДоляСубфедеральныхИМуниципальныхОблигацийНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива
		|ПОМЕСТИТЬ _СубгосударственныеОблигации
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_СубгосударственныеОблигации.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_СубгосударственныеОблигации.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_СубгосударственныеОблигации.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_СубгосударственныеОблигации КАК _СубгосударственныеОблигации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СубгосударственныеОблигации.Эмитент,
		|	_СубгосударственныеОблигации.Актив,
		|	_СубгосударственныеОблигации.СуммаВВалютеУчета,
		|	_СубгосударственныеОблигации.ВидАктива
		|ИЗ
		|	_СубгосударственныеОблигации КАК _СубгосударственныеОблигации";
	
		
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;		
				
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
		Если Запрос.Параметры.Свойство("Заголовок") Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля субфедеральных и муниципальных облигаций");
		КонецЕсли;
		               	
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
		СтатусПроверки = 3;
	КонецЕсли;	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
		
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляСубфедеральныхИМуниципальныхОблигацийНаСервере

&НаСервере
Процедура ДоляСубфедеральныхОблигацийОдногоЭмитентаНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива
		|ПОМЕСТИТЬ _СубфедеральныеОблигации
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СубфедеральныеОблигацииЭмитента.Эмитент,
		|	СубфедеральныеОблигацииЭмитента.СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СубфедеральныеОблигацииЭмитента.СуммаВВалютеУчета / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СубфедеральныеОблигацииЭмитента.СуммаВВалютеУчета / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СубфедеральныеОблигации.Эмитент КАК Эмитент,
		|		СУММА(_СубфедеральныеОблигации.СуммаВВалютеУчета) КАК СуммаВВалютеУчета
		|	ИЗ
		|		_СубфедеральныеОблигации КАК _СубфедеральныеОблигации
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СубфедеральныеОблигации.Эмитент) КАК СубфедеральныеОблигацииЭмитента
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ,
		|	СубфедеральныеОблигацииЭмитента.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СубфедеральныеОблигации.Эмитент,
		|	_СубфедеральныеОблигации.Актив,
		|	_СубфедеральныеОблигации.СуммаВВалютеУчета Как Сумма
		|ИЗ
		|	_СубфедеральныеОблигации КАК _СубфедеральныеОблигации
		|ИТОГИ ПО
		|	Эмитент";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;
	
	Если Показатели.Количество() > 0 Тогда
		
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		Если Запрос.Параметры.Свойство("Заголовок") Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля субфедеральных облигаций одного эмитента");
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
			СтатусПроверки = 3; 
	КонецЕсли;
	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;

	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
