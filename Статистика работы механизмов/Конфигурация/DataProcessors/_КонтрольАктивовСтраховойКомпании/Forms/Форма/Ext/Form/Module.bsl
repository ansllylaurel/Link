		|						ТОГДА 1
		|					ИНАЧЕ 0
		|				КОНЕЦ) КАК КорректныеРейтингиСчет
		|		ИЗ
		|			_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_РейтингиРаспределенныхАктивов.Актив,
		|			_РейтингиРаспределенныхАктивов.Эмитент,
		|			_РейтингиРаспределенныхАктивов.Рынок) КАК СводныеРейтингиБумагИЭмитентов
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент = СводныеРейтингиБумагИЭмитентов.Эмитент
		|			И _СтоимостьЦенныхБумагСтраховыхКомпаний.Актив = СводныеРейтингиБумагИЭмитентов.Актив
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_РейтингиРаспределенныхАктивов.Актив КАК Актив,
		|			_РейтингиРаспределенныхАктивов.Эмитент КАК Эмитент
		|		ИЗ
		|			_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_РейтингиРаспределенныхАктивов.Актив,
		|			_РейтингиРаспределенныхАктивов.Эмитент) КАК АктивыДляКоторыхНазначеныРейтинги
		|		ПО (АктивыДляКоторыхНазначеныРейтинги.Эмитент = _СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент)
		|			И (АктивыДляКоторыхНазначеныРейтинги.Актив = _СтоимостьЦенныхБумагСтраховыхКомпаний.Актив)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _СтоимостьЦенныхБумагСтраховыхКомпаний.Актив = Облигации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов.Актив КАК Актив,
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов.Эмитент КАК Эмитент,
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов.Рынок КАК Рынок,
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов.КорректныйРейтинг КАК КорректныйРейтинг,
		|	ЕСТЬNULL(_ВсеПоказателиКонтроляРейтинговИЛистингов.Субординированность, ""Нет"") КАК Субординированность,
		|	ВЫБОР
		|		КОГДА _ВсеПоказателиКонтроляРейтинговИЛистингов.КорректныйРейтинг
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Ошибка
		|ИЗ
		|	_ВсеПоказателиКонтроляРейтинговИЛистингов КАК _ВсеПоказателиКонтроляРейтинговИЛистингов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ошибка УБЫВ,
		|	Эмитент,
		|	Актив
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РейтингиРаспределенныхАктивов.Актив КАК Актив,
		|	_РейтингиРаспределенныхАктивов.Эмитент КАК Эмитент,
		|	_РейтингиРаспределенныхАктивов.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_РейтингиРаспределенныхАктивов.Рынок КАК Рынок,
		|	_РейтингиРаспределенныхАктивов.ТипРейтинга КАК ТипРейтинга,
		|	_РейтингиРаспределенныхАктивов.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_РейтингиРаспределенныхАктивов.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_РейтингиРаспределенныхАктивов.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	_РейтингиРаспределенныхАктивов.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня,
		|	_РейтингиРаспределенныхАктивов.Гарант КАК Гарант
		|ИЗ
		|	_РейтингиРаспределенныхАктивов КАК _РейтингиРаспределенныхАктивов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент,
		|	Актив,
		|	РейтинговоеАгентство";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	// Из разъяснений ЦБ: В отношении Министерства финансов Российской Федерации, выступающего эмитентом по облигациям федерального займа, для целей применения пункта 3.1.8 Положения № 710-П, возможно в качестве рейтинга эмитента использовать суверенный рейтинг Российской Федерации.
	// https://www.cbr.ru/insurance/explained/finstab_ssd/
	Запрос.Параметры.Вставить("МинФин", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии"));	
	Запрос.Параметры.Вставить("ПравительствоРФ", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ПравительствоРФ"));
	
		
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Результат           = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам); 	
	РейтингиЦенныхБумаг = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтатусПроверки = 1;
	 Расшифровка = "";
	Если Результат.Строки.Количество() > 0 Тогда
		Если Результат.Строки[0].Ошибка Тогда
			СтатусПроверки = 2;
		КонецЕсли;
	иначе
			Расшифровка = "" + Символы.ПС +   "Не обнаружены активы, подлежащие назначению рейтинга или включению в листинги цб." ;
	КонецЕсли;
	
	// отчет
	Расшифровка = Расшифровка + Символы.ПС;		
	Если Результат.Строки.Количество() > 0 Тогда
			
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(Результат, "Результат проверки");
	  	
		Расшифровка = Расшифровка + Символы.ПС + ДеревоВФорматеHTML(РейтингиЦенныхБумаг, "Рейтинги ценных бумаг и эмитентов ценных бумаг.");	
		
	КонецЕсли;	


	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, Расшифровка, 0, 0, 0);
	
КонецПроцедуры // ДопустимостьРейтингаОблигацийИлиЭмитентаИлиГарантаНаСервере

&НаСервере
Процедура ИспользованиеСубординированныхДепозитовНаСервере ()
	
	Запрос = Новый Запрос;
	СтатусПроверки = 1;
	ОтчетВФорматеHTML = "";
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок
		|ПОМЕСТИТЬ _АктивыСтраховойКомпании
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСтраховойКомпании.Актив КАК Актив,
		|	_АктивыСтраховойКомпании.Рынок КАК Рынок,
		|	_АктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ЕСТЬNULL(ДепозитныеВклады.Субординированность, ЛОЖЬ) КАК Субординированность
		|ПОМЕСТИТЬ _СубординированныеАктивы
		|ИЗ
		|	_АктивыСтраховойКомпании КАК _АктивыСтраховойКомпании
		|		 СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО _АктивыСтраховойКомпании.Актив = ДепозитныеВклады.Ссылка 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_СубординированныеАктивы.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_СубординированныеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_СубординированныеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение,
		|	&МаксДоляСредств КАК МаксДоляСредств
		|ИЗ
		|	_СубординированныеАктивы КАК _СубординированныеАктивы
		|ГДЕ
		|	_СубординированныеАктивы.Субординированность = ИСТИНА
		|	И &ОбъемСредств > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СубординированныеАктивы.Рынок КАК Рынок,
		|	_СубординированныеАктивы.Актив КАК Актив,
		|	_СубординированныеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_СубординированныеАктивы КАК _СубординированныеАктивы
		|ГДЕ
		|	_СубординированныеАктивы.Субординированность = ИСТИНА";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
		
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;			
		
	Если Показатели.Количество() > 0 Тогда
			
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Стоимость субординированных облигаций и депозитных вкладов");
				
	КонецЕсли;
		
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
		
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);

КонецПроцедуры  //ДоляСубординированныхАктивовНаСервере

&НаСервере
Процедура МаксимальнаяДоляИпотечныхСертификатовНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _ИпотечныеОблигации
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИпотечныеОблигации.Актив КАК Актив,
		|	_ИпотечныеОблигации.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	_ИпотечныеОблигации.СуммаВВалютеУчета / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА _ИпотечныеОблигации.СуммаВВалютеУчета > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ИпотечныеОблигации КАК _ИпотечныеОблигации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;

		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Ипотечные ценные бумаги");
			
	КонецЕсли;
	
	Если Показатели.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	КонецЕсли;

	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры 

&НаСервере
Процедура ПроверкаКомплекснаяИнвестированиеЗапрещенныхАктивовНаСервере()
	
	СтатусПроверки    = 1;
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок,
		|	РаспределенныеАктивыСтраховойКомпании.ВидАктива,
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании
		|ПОМЕСТИТЬ _РаспределенныеАктивыСтраховойКомпании
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РаспределенныеАктивыСтраховойКомпании.Актив,
		|	_РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	_РаспределенныеАктивыСтраховойКомпании.Рынок,
		|	_РаспределенныеАктивыСтраховойКомпании.ВидАктива,
		|	_РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании,
		|	""Стоимость активов признается равной нулю (710-П)"" КАК Ошибка
		|ИЗ
		|	_РаспределенныеАктивыСтраховойКомпании КАК _РаспределенныеАктивыСтраховойКомпании
