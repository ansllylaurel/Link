	Если Показатели.Количество() > 0 Тогда
			
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Стоимость субординированных облигаций и депозитных вкладов");
				
	КонецЕсли;
		
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
		
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);

КонецПроцедуры  //ДоляСубординированныхАктивовНаСервере

&НаСервере
Процедура ДоляПерестраховщиковКромеУбытковНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	                                   
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив
		|ПОМЕСТИТЬ _ДЗ
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_ДЗ.СуммаВВалютеУчета), 0) КАК ДЗ,
		|	ЕСТЬNULL(&РезервУбытков, 0) КАК Резерв,
		|	&ОбъемСредств КАК СтраховыеРезервы,
		|	СУММА(_ДЗ.СуммаВВалютеУчета) / (&ОбъемСредств - &РезервУбытков) * 100 КАК ДоляСредств,
		|	&МаксДоляСредств КАК МаксДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_ДЗ.СуммаВВалютеУчета) / (&ОбъемСредств - &РезервУбытков) * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ДЗ КАК _ДЗ
		|ГДЕ
		|	&ОбъемСредств - &РезервУбытков > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДЗ.Актив,
		|	_ДЗ.СуммаВВалютеУчета
		|ИЗ
		|	_ДЗ КАК _ДЗ";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
			
		Сумма 		= Показатели[0].ДЗ;
		База  		= Показатели[0].СтраховыеРезервы;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
		
	КонецЕсли;  
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры //ДоляПерестраховщиковКромеУбытковНаСервере

&НаСервере
Процедура ДоляСвязанныхСторонНаСервере()
	
	СтатусПроверки    = 1; // не пройдена
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _СвязанныеСтороныПоСвойствуАктива
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.СвязаннаяСторона = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _СвязанныеСтороныПоКодуАктива
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	ВЫРАЗИТЬ(РаспределенныеАктивыСтраховойКомпании.Актив КАК Справочник.ПрочиеАктивы) В (&ПрочиеАктивыСвязанныхСторон)
		|	и РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СвязанныеСтороныПоСвойствуАктива.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	_СвязанныеСтороныПоСвойствуАктива.Актив КАК Актив
		|ПОМЕСТИТЬ _СвязанныеСтороны
		|ИЗ
		|	_СвязанныеСтороныПоСвойствуАктива КАК _СвязанныеСтороныПоСвойствуАктива
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СвязанныеСтороныПоКодуАктива.СуммаВВалютеУчета,
		|	_СвязанныеСтороныПоКодуАктива.Актив
		|ИЗ
		|	_СвязанныеСтороныПоКодуАктива КАК _СвязанныеСтороныПоКодуАктива
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_СвязанныеСтороны.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_СвязанныеСтороны.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_СвязанныеСтороны.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_СвязанныеСтороны КАК _СвязанныеСтороны
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СвязанныеСтороны.Актив КАК Актив,
		|	_СвязанныеСтороны.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_СвязанныеСтороны КАК _СвязанныеСтороны";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля связанных сторон");

		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		               	
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
		СтатусПроверки = 3;
	КонецЕсли;
	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
		
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкиНаСервере()
	
	Механизм = "_КонтрольАктивовСтраховыхКомпаний.Форма.ВыполнитьПроверкиНаСервере()";
	Сессия = ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, "Контроль распределения активов СК.", 
			"СчетДоверительногоУправления,Период"); 
	
	ЗаполнитьСправочныеПоказателиНаСервере();
	ЗаполнитьРасчетныеПоказателиНаСервере();
	
	Для каждого СтрокаПроверки Из ЭтаФорма.Проверки Цикл
		
		ЭтаФорма.ПараметрыТекущейПроверки.Очистить();
		
		Для каждого Элемент Из СтрокаПроверки.Параметры Цикл
			ЭтаФорма.ПараметрыТекущейПроверки.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
		ЭтаФорма.КлючТекущейПроверки = СтрокаПроверки.Ключ;
		
		Выполнить(СтрокаПроверки.ИмяПроцедуры + "НаСервере()");
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры // ВыполнитьПроверкиНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	    РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
		Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		Объект.Период      = ТекущаяДата();
		ЗаполнитьДокумент();  
КонецПроцедуры

&НаСервере
Функция ДействуютПравила410П()
	
	ДатаДействияПравил = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(
		, "ДатаНачалаКонтроляСтраховыхКомпанийПоПравилам710П", Объект.СчетДоверительногоУправления);  
		
	Если ДатаДействияПравил <> Неопределено Тогда
			
		возврат Объект.Период >= ДатаДействияПравил;
			
	КонецЕсли;
		
	возврат Ложь;  	

КонецФункции

&НаСервере
Процедура ЗаполнитьДокумент()
	Если ДействуютПравила410П() Тогда
		НастроитьПроверкиПоПравилам410П();
	Иначе
	      НастроитьПроверки();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НастроитьПроверкиПоПравилам410П()
	
		
	ЗаполнитьСправочныеПоказателиНаСервере();
	
	СправочныеПоказателиНаСервере = ЭтаФорма.СправочныеПоказатели.Получить();
	
	СтраховыеРезервы = Новый Массив;
	СтраховыеРезервы.Добавить(Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни);
	СтраховыеРезервы.Добавить(Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни);
	
	СобственныеСредства = Перечисления.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива;
	
	СуммарнаяСтоимостьАктивов = Новый Массив;	
	СуммарнаяСтоимостьАктивов.Добавить(Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни);
	СуммарнаяСтоимостьАктивов.Добавить(Перечисления.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни);	
	СуммарнаяСтоимостьАктивов.Добавить(Перечисления.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива);
	

	
	ДобавитьПроверкуВТаблицуНаСервере
	(
		"ОтсутствиеДефолтаЭмитентовЗаПоследние2Года",
		, 
		"О02. Отсутствие дефолта эмитентов за последние два года",
		"По всем ценным бумагам, находяхся у эмитента на отчетную дату, определяется наличие дефолтного рейтинга за последние 2 года. Если хотя бы одно рейтинговое агентство присвоило дефолтный рейтинг, то проверка считается не пройден. Эмитенты, по которым рейтинг за 2 года не был определен попадают в предупреждения."
		, "000"	
	);	
	
	КодыАктивов = Новый Массив;
	КодыАктивов.Добавить(Справочники.ПрочиеАктивы.НайтиПоКоду("000000546")); // Строка 245
	КодыАктивов.Добавить(Справочники.ПрочиеАктивы.НайтиПоКоду("000000082")); // Строка 250
	КодыАктивов.Добавить(Справочники.ПрочиеАктивы.НайтиПоКоду("000000091")); // Строка 255
	КодыАктивов.Добавить(Справочники.ПрочиеАктивы.НайтиПоКоду("000000099")); // Строка 240
	
	ДобавитьПроверкуВТаблицуНаСервере
	(	
		"ДопустимостьРейтингаБанковРасчетныхИДепозитныхСчетов",
		, 
		"О04. Допустимость рейтинга банков для средств на расчетных счетах и депозитных вкладах.",
		"Денежные средства на расчетных счетах или депозитных вкладах должны быть размещены в банках, имеющих лицензию на осуществление банковских операций и имеющих рейтинги не ниже допустимого."
		, "000"
	);
	
	ДобавитьПроверкуВТаблицуНаСервере
	(
		"КонтрольНаличияЛицензииЭмитентаПрочегоАктива",
		"КонтрольНаличияЛицензииЭмитентаПрочегоАктива",
		"О05. Контроль наличия лицензии перестраховщика для долей перестраховщиков в резерве заявленных, но не урегулированных убытков",
	    Новый Структура(
					"ВидыПортфелей, КодыАктивов, Заголовок, ВидДеятельности",
					СтраховыеРезервы, КодыАктивов, 
					"Лицензии перестраховщиков", Справочники.ВидыДеятельности.Перестрахование
		)
		, "000"
	);
	
	КодыАктивов = Новый Массив;
	// Привлеченных займов и производных финансовых инструментов нет
	// КодыАктивов.Добавить(Справочники.ПрочиеАктивы.НайтиПоКоду("000000429")); 	
	ДобавитьПроверкуВТаблицуНаСервере
	(
		"ДоляЦенныхБумагПолученныхПоДоговоруРепо", 
		"ДоляПрочегоАктиваИРепо",
		"Совокупная стоимость займов, ценных бумаг, полученных по РЕПО и лотов производных финансовых инструментов ",
		Новый Структура
		(
			"ВидыПортфелей, ОбъемСредств, МаксДоляСредств, КодыАктивов",
			СуммарнаяСтоимостьАктивов, "$СуммарнаяСтоимостьАктивов", 40, КодыАктивов
		)
		, "2.4", Истина
	);
	
	ДобавитьПроверкуВТаблицуНаСервере
		(	
			"ВключениеЦенныхБумагВКотировальныеСпискиИлиДопустимостьРейтингаЭмитентаНовый",
