Функция ТестРаспределенияНаСервере()
	
		Механизм = "_КонтрольАктивовСтраховыхКомпаний.Форма.ТестРаспределенияНаСервере()";
		Сессия = ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, "Автоматическое распределение активов СК", 
			"СчетДоверительногоУправления,Период,Порядок,ИспользоватьИсториюРаспределений,ФормироватьДокумент");
	
		ЦиклСРН = 0;
		ЦиклСРЖ = 1;
		ЦиклССН = 2;
		ЦиклССС = 3;
		ЦиклПозиция = 0;
	
	    ПорядокРаспределения = ЭтаФорма.Порядок;
		Если ЭтаФорма.Порядок = "СРЖ"  Тогда
			 ЦиклСРЖ = 0;
			 ЦиклСРН = 1;
		КонецЕсли;
	
		НеФормироватьHTML = Истина;//Не тратить ресурсы на представление проверок
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Начало распределения: " + Формат(ТекущаяДата(), "ДЛФ=HH:mm:ss"));
		
		Объект.РаспределяемыеАктивы.Очистить();
		Объект.КурсыВалютныхАктивов.Очистить();

	 	РаспределитьАктивы();

	    ЗаполнитьСправочныеПоказателиДляАвтоРаспределенияНаСервере();	  
		ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере();
		
		РасчетныеПоказателиНаСервере = ЭтаФорма.РасчетныеПоказатели.Получить();

		
		СРН_Всего =  РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни;
		СРЖ_Всего =  РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюЖизни;
		ССН_Всего =  РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствВРазмереНорматива;
		ССС_Всего =  РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствСверхНорматива;
		МинКапитал = РасчетныеПоказателиНаСервере.МинимальныйРазмерУставногоКапитала;
		
		Если МинКапитал >  ССН_Всего Тогда
			ССН_Всего = МинКапитал;
		КонецЕсли;

		СРН = 0;                                               
		СРЖ = 0;
		ССН = 0;
		ССС = 0;
		ВсегоРаспределений = 0;
		
		Для каждого РаспределяемыйАктив из Объект.РаспределяемыеАктивы Цикл
			СРН = СРН + РаспределяемыйАктив.СРН;
			Если СРН > СРН_Всего Тогда
				СРН = СРН - РаспределяемыйАктив.СРН;
				РаспределяемыйАктив.СуммаВВалютеУчета = РаспределяемыйАктив.СуммаВВалютеУчета + РаспределяемыйАктив.СРН;
				РаспределяемыйАктив.СРН = 0;				
			КонецЕсли;
			СРЖ = СРЖ + РаспределяемыйАктив.СРЖ;			
			Если СРЖ > СРЖ_Всего Тогда
				СРЖ = СРЖ - РаспределяемыйАктив.СРЖ;
				РаспределяемыйАктив.СуммаВВалютеУчета = РаспределяемыйАктив.СуммаВВалютеУчета + РаспределяемыйАктив.СРЖ;
				РаспределяемыйАктив.СРЖ = 0;
			КонецЕсли;
			ССН = ССН + РаспределяемыйАктив.ССН;
			Если ССН > ССН_Всего Тогда
				ССН = ССН - РаспределяемыйАктив.ССН;
				РаспределяемыйАктив.СуммаВВалютеУчета = РаспределяемыйАктив.СуммаВВалютеУчета + РаспределяемыйАктив.ССН;
				РаспределяемыйАктив.ССН = 0;
			КонецЕсли;
			ССС = ССС + РаспределяемыйАктив.ССС;
			Если ССС > ССС_Всего Тогда
				ССС = ССС - РаспределяемыйАктив.ССС;
				РаспределяемыйАктив.СуммаВВалютеУчета = РаспределяемыйАктив.СуммаВВалютеУчета + РаспределяемыйАктив.ССС;
				РаспределяемыйАктив.ССС = 0;
			КонецЕсли;
			//РаспределяемыйАктив.СуммаВВалютеУчета =  РаспределяемыйАктив.СуммаВВалютеУчета  - СРН - СРЖ - ССН - ССС;
		КонецЦикла;
		
		//Попытка распределить 
		ИсключаемыеПроверки = ПолучитьСписокНеПройденныхПроверок();		
		
		Для каждого ИсключаемаяПроверка из ИсключаемыеПроверки Цикл
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю( "Внимание! Некоторые проверки провалены при предварительной проверке результатов предыдущих распределений. Потребуется ручное вмешательство в документ. Отключена проверка: " + ИсключаемаяПроверка );
			
		КонецЦикла;
		
		#Область Распределение_И_Проверки
		
		Пока (СРН_Всего-СРН) +  (СРЖ_ВСЕГО-СРЖ) + (ССН_ВСЕГО-ССН) + (ССС_ВСЕГО -ССС) > 0 Цикл
			
			Счетчик = 0;
			ЦиклПозиция = ЦиклПозиция + 1;
			
			Если  (СРН_Всего-СРН) > 0 и ЦиклПозиция > ЦиклСРН Тогда		
				Объект.РаспределяемыеАктивы.Сортировать("СуммаВВалютеУчета убыв");
				
				Для каждого РаспределяемыйАктив из Объект.РаспределяемыеАктивы Цикл 
					
					Сумма = РаспределяемыйАктив.СуммаВВалютеУчета;
					
					Если Сумма > (СРН_Всего-СРН) Тогда 
						Сумма = (СРН_Всего-СРН);
					КонецЕсли;
					
					Если Сумма > 0 Тогда 
						
						РаспределяемыйАктив.СРН = РаспределяемыйАктив.СРН + Сумма;	  
						ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере();
						
						Если Не Проверить(ИсключаемыеПроверки) Тогда
							РаспределяемыйАктив.СРН = РаспределяемыйАктив.СРН - Сумма;	
						иначе
							 РаспределяемыйАктив.СуммаВВалютеУчета =  РаспределяемыйАктив.СуммаВВалютеУчета - Сумма;
							 Счетчик = Счетчик+1;
							 СРН = СРН + Сумма;
						 КонецЕсли;
					 
					КонецЕсли;
					
				КонецЦикла;				
			КонецЕсли;
		
		
			Если (СРЖ_ВСЕГО-СРЖ) > 0 и ЦиклПозиция > ЦиклСРЖ Тогда
				Объект.РаспределяемыеАктивы.Сортировать("СуммаВВалютеУчета убыв");
				
				Для каждого РаспределяемыйАктив из Объект.РаспределяемыеАктивы Цикл 
					
					Сумма = РаспределяемыйАктив.СуммаВВалютеУчета;
					
					Если Сумма > (СРЖ_ВСЕГО-СРЖ) Тогда 
						Сумма = (СРЖ_ВСЕГО-СРЖ);
					КонецЕсли;

					
					Если Сумма > 0 Тогда 
						
						РаспределяемыйАктив.СРЖ = РаспределяемыйАктив.СРЖ + Сумма;	  
						ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере();
						
						Если Не Проверить(ИсключаемыеПроверки) Тогда
							РаспределяемыйАктив.СРЖ = РаспределяемыйАктив.СРЖ - Сумма;	
						иначе
							 РаспределяемыйАктив.СуммаВВалютеУчета =  РаспределяемыйАктив.СуммаВВалютеУчета - Сумма;
							 Счетчик = Счетчик+1;
							 СРЖ = СРЖ + Сумма;
						 КонецЕсли;
					 
					КонецЕсли;
					
				КонецЦикла;				
			КонецЕсли;

			
			Если (ССН_ВСЕГО-ССН) > 0  и ЦиклПозиция > ЦиклССН Тогда
				Объект.РаспределяемыеАктивы.Сортировать("СуммаВВалютеУчета убыв");
				
				Для каждого РаспределяемыйАктив из Объект.РаспределяемыеАктивы Цикл 
					
					Сумма = РаспределяемыйАктив.СуммаВВалютеУчета;
					
					
					Если Сумма > (ССН_ВСЕГО-ССН) Тогда 
						Сумма =(ССН_ВСЕГО-ССН);
					КонецЕсли;

					
					Если Сумма > 0 Тогда 
						
						РаспределяемыйАктив.ССН = РаспределяемыйАктив.ССН + Сумма;	  
						ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере();
						
						Если Не Проверить(ИсключаемыеПроверки) Тогда
							РаспределяемыйАктив.ССН = РаспределяемыйАктив.ССН - Сумма;	
						Иначе
							 РаспределяемыйАктив.СуммаВВалютеУчета =  РаспределяемыйАктив.СуммаВВалютеУчета - Сумма;
							 Счетчик = Счетчик+1;
							 ССН = ССН+Сумма;
						 КонецЕсли;
					Иначе
						Прервать; 
					КонецЕсли;
					
				КонецЦикла;  	
			КонецЕсли;
			
			Если (ССС_ВСЕГО -ССС) > 0 и ЦиклПозиция > ЦиклССС Тогда
				Объект.РаспределяемыеАктивы.Сортировать("СуммаВВалютеУчета убыв");
				
				Для каждого РаспределяемыйАктив из Объект.РаспределяемыеАктивы Цикл 
					
					Сумма = РаспределяемыйАктив.СуммаВВалютеУчета;
					
					Если Сумма > (ССС_ВСЕГО-ССС) Тогда 
						Сумма =(ССС_ВСЕГО-ССС);
					КонецЕсли;
					
					Если Сумма > 0 Тогда 
						
						РаспределяемыйАктив.ССС = РаспределяемыйАктив.ССС + Сумма;	  
						ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере();
						
						Если Не Проверить(ИсключаемыеПроверки) Тогда
							РаспределяемыйАктив.ССС = РаспределяемыйАктив.ССС - Сумма;	
						иначе
							 РаспределяемыйАктив.СуммаВВалютеУчета =  РаспределяемыйАктив.СуммаВВалютеУчета - Сумма;
							 Счетчик = Счетчик+1;
							 ССС=ССС+Сумма;
						 КонецЕсли;
					 Иначе
						 Прервать;
					КонецЕсли;
					
				КонецЦикла;  	
			КонецЕсли;
	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Завершение цикла: " + Формат(ТекущаяДата(), "ДЛФ=HH:mm:ss"));
			
			Если Счетчик = 0 и ЦиклПозиция > 3 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно дальнейшее распределение активов, дальнейшие действия выполняйте вручную." + Формат(ТекущаяДата(), "ДЛФ=HH:mm:ss"));
				Прервать;
			КонецЕсли;
			
			ВсегоРаспределений = ВсегоРаспределений + Счетчик;
			
		КонецЦикла; // Пока
		
		#КонецОбласти
		
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Завершено: " + Формат(ТекущаяДата(), "ДЛФ=HH:mm:ss") + "; Всего действий с распределениями: " + ВсегоРаспределений);
	
	#Область Преобразование_Распределенных_Активов_В_Формат_Документа
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСК.Актив КАК Актив,
		|	_АктивыСК.ВидАктива КАК ВидАктива,
		|	_АктивыСК.Рынок КАК Рынок,
		|	_АктивыСК.Эмитент КАК Эмитент,
		|	_АктивыСК.ЭмитентЯвляетсяБанком КАК ЭмитентЯвляетсяБанком,
		|	_АктивыСК.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_АктивыСК.Валюта КАК Валюта,
		|	_АктивыСК.Сумма КАК Сумма,
		|	_АктивыСК.Нераспределено КАК Нераспределено,
		|	_АктивыСК.СРЖ КАК СРЖ,
		|	_АктивыСК.СРН КАК СРН,
		|	_АктивыСК.ССН КАК ССН,
		|	_АктивыСК.ССС КАК ССС,
		|	_АктивыСК.Распределено КАК Распределено,
		|	_АктивыСК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_АктивыСК.СвязаннаяСторона КАК СвязаннаяСторона,
		|	_АктивыСК.СтрокаСопоставленияРейтингов КАК СтрокаСопоставленияРейтингов,
		|	_АктивыСК.СубъектПрочегоАктива КАК СубъектПрочегоАктива
		|ПОМЕСТИТЬ _АктивыСК
		|ИЗ
		|	&АктивыСК КАК _АктивыСК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Валюта КАК Валюта,
		|	Валюты.Актив КАК Актив,
		|	Валюты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Валюты.Курс КАК Курс,
		|	Валюты.Кратность КАК Кратность,
		|	Валюты.ДатаКурса КАК ДатаКурса
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	&КурсыВалют КАК Валюты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_АктивыСК.Актив КАК Актив,
		|	_АктивыСК.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
		|	_АктивыСК.Валюта КАК Валюта,
		|	СУММА(ВЫРАЗИТЬ(_АктивыСК.СРЖ * ЕСТЬNULL(_КурсыВалют.Кратность, 1) / ЕСТЬNULL(_КурсыВалют.Курс, 1) КАК ЧИСЛО(18, 2))) КАК СРЖ,
		|	СУММА(ВЫРАЗИТЬ(_АктивыСК.СРН * ЕСТЬNULL(_КурсыВалют.Кратность, 1) / ЕСТЬNULL(_КурсыВалют.Курс, 1) КАК ЧИСЛО(18, 2))) КАК СРН,
		|	СУММА(ВЫРАЗИТЬ(_АктивыСК.ССН * ЕСТЬNULL(_КурсыВалют.Кратность, 1) / ЕСТЬNULL(_КурсыВалют.Курс, 1) КАК ЧИСЛО(18, 2))) КАК ССН,
		|	СУММА(ВЫРАЗИТЬ(_АктивыСК.ССС * ЕСТЬNULL(_КурсыВалют.Кратность, 1) / ЕСТЬNULL(_КурсыВалют.Курс, 1) КАК ЧИСЛО(18, 2))) КАК ССС,
		|	_КурсыВалют.ДатаКурса КАК ДатаКурса,
		|	ЕСТЬNULL(_КурсыВалют.Курс, 1) КАК Курс,
		|	_КурсыВалют.Кратность КАК Кратность,
		|	СУММА(_АктивыСК.Сумма) КАК Сумма
		|ИЗ
		|	_АктивыСК КАК _АктивыСК
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО (_КурсыВалют.Актив = _АктивыСК.Актив)
		|			И (_КурсыВалют.СчетДоверительногоУправления = _АктивыСК.СчетДоверительногоУправления)
		|			И (_КурсыВалют.Валюта = _АктивыСК.Валюта)
		|
		|СГРУППИРОВАТЬ ПО
		|	_АктивыСК.СчетДоверительногоУправления,
		|	_АктивыСК.Актив,
		|	_АктивыСК.СубъектПрочегоАктива,
		|	_АктивыСК.Валюта,
		|	_КурсыВалют.ДатаКурса,
		|	ЕСТЬNULL(_КурсыВалют.Курс, 1),
		|	_КурсыВалют.Кратность
		|ИТОГИ ПО
		|	СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("КурсыВалют", Объект.КурсыВалютныхАктивов.Выгрузить() );	
	Запрос.УстановитьПараметр("АктивыСК", Объект.РаспределяемыеАктивы.Выгрузить() ); 	
	
	// Для портфелей с доверительным управлением одновременно может быть создано несколько документов.
	ВыборкаГруппаПоСчетуДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	#КонецОбласти
	
	МассивНовыхДокументов = Новый Массив(); 	
	
	#Область Формирование_Документов
	
	Если ЭтаФорма.ФормироватьДокумент Тогда
		
		НачатьТранзакцию();
		
		ВсегоНовыхДокументов = ВыборкаГруппаПоСчетуДУ.Количество(); 
		ТекущийНовыйДокумент = 1;
			
		Пока ВыборкаГруппаПоСчетуДУ.Следующий() Цикл
			
			Запрос = Новый Запрос();
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РаспределениеАктивовСтраховыхКомпаний.Ссылка КАК Ссылка,
			|	РаспределениеАктивовСтраховыхКомпаний.Проведен КАК Проведен
			|ИЗ
			|	Документ.РаспределениеАктивовСтраховыхКомпаний КАК РаспределениеАктивовСтраховыхКомпаний
			|ГДЕ
			|	РаспределениеАктивовСтраховыхКомпаний.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И НАЧАЛОПЕРИОДА(РаспределениеАктивовСтраховыхКомпаний.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";
			
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ВыборкаГруппаПоСчетуДУ.СчетДоверительногоУправления );
			Запрос.УстановитьПараметр("Период", Объект.Период );
			
			СуществующиеДокументы = Запрос.Выполнить().Выбрать();
			
			НовыйДокумент = Документы.РаспределениеАктивовСтраховыхКомпаний.ПустаяСсылка();
			
			Если  СуществующиеДокументы.Следующий() Тогда
				
				Если СуществующиеДокументы.Проведен = Истина Тогда
				
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно создать документ. Уже проведено распределение активов на указанную дату. Отмените проведение документа и попробуйте снова ", СуществующиеДокументы.Ссылка.Ссылка, , , );
					ОтменитьТранзакцию();
					
					РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
					
					Возврат МассивНовыхДокументов;	
				
				КонецЕсли;
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для распределения будет использован существующий не проведенный документ. ", СуществующиеДокументы.Ссылка.Ссылка, , , );
					
				НовыйДокумент = СуществующиеДокументы.Ссылка.ПолучитьОбъект();
				НовыйДокумент.АктивыСтраховойКомпании.Очистить();
				
			КонецЕсли;
			
			Если НовыйДокумент = Документы.РаспределениеАктивовСтраховыхКомпаний.ПустаяСсылка() Тогда
			
				НовыйДокумент = Документы.РаспределениеАктивовСтраховыхКомпаний.СоздатьДокумент();
				НовыйДокумент.Дата = КонецДня(Объект.Период);
				НовыйДокумент.СчетДоверительногоУправления = ВыборкаГруппаПоСчетуДУ.СчетДоверительногоУправления;
				НовыйДокумент.Организация = Объект.Организация;
				УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(НовыйДокумент);
				
			КонецЕсли;
			
			ВыборкаАктивы = ВыборкаГруппаПоСчетуДУ.Выбрать();
			
			Пока ВыборкаАктивы.Следующий() Цикл

				СтрокаРаспределения = НовыйДокумент.АктивыСтраховойКомпании.Добавить();
				СтрокаРаспределения.Актив								 = ВыборкаАктивы.Актив;
				СтрокаРаспределения.ИсключенИзРаспределений				 = Ложь;
				СтрокаРаспределения.СубъектПрочегоАктива				 = ВыборкаАктивы.СубъектПрочегоАктива; 
				СтрокаРаспределения.Валюта								 = ВыборкаАктивы.Валюта;
				СтрокаРаспределения.ДатаКурса							 = ВыборкаАктивы.ДатаКурса;
				СтрокаРаспределения.Курс                     			 = ВыборкаАктивы.Курс;
				СтрокаРаспределения.Нераспределено						 = ВыборкаАктивы.Сумма - ВыборкаАктивы.СРЖ
																		   - ВыборкаАктивы.СРН - ВыборкаАктивы.ССН  - ВыборкаАктивы.ССС;
				СтрокаРаспределения.РезервыПоСтрахованиюЖизни			 = ВыборкаАктивы.СРЖ;
				СтрокаРаспределения.РезервыПоСтрахованиюИномуЧемЖизни	 = ВыборкаАктивы.СРН;
				СтрокаРаспределения.СобственныеСредстваВРазмереНорматива = ВыборкаАктивы.ССН;
				СтрокаРаспределения.СобственныеСредстваСверхНорматива	 = ВыборкаАктивы.ССС;
				СРН_Всего = СРН_Всего - ОКР(ВыборкаАктивы.СРН * ВыборкаАктивы.Курс, 2, РежимОкругления.Окр15как20);	
				СРЖ_Всего = СРЖ_Всего - ОКР(ВыборкаАктивы.СРЖ * ВыборкаАктивы.Курс, 2, РежимОкругления.Окр15как20);	 
				ССН_Всего = ССН_Всего - ОКР(ВыборкаАктивы.ССН * ВыборкаАктивы.Курс, 2, РежимОкругления.Окр15как20);	  
				ССС_Всего = ССС_Всего - ОКР(ВыборкаАктивы.ССС * ВыборкаАктивы.Курс, 2, РежимОкругления.Окр15как20);	

			КонецЦикла;			
			
			НовыйДокумент.АктивыСтраховойКомпании.Сортировать("Нераспределено");
			Позиция = НовыйДокумент.АктивыСтраховойКомпании.Количество() - 1;
			
			// Устранение накопленной погрешности из-за пересчета валют
			// Если формируется несколько документов (в случае доверительного управления) погрешности списываются на последний.
			Пока (СРН_Всего<>0 или  СРЖ_Всего<>0 или ССН_Всего<>0 или ССС_Всего <> 0) И
				Позиция > 0 И ТекущийНовыйДокумент = ВсегоНовыхДокументов И (СРН_Всего+СРЖ_Всего+ССН_Всего+ССС_Всего)>-1
				И (СРН_Всего+СРЖ_Всего+ССН_Всего+ССС_Всего)< 1 Цикл
				
				СтрокаАктив =  НовыйДокумент.АктивыСтраховойКомпании[Позиция];
				Если СтрокаАктив.Валюта = Объект.Организация.ВалютаУчета.Ссылка Тогда
					
					Если СРН_Всего < 0 И СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни > 0.01  Тогда
						СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни = СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни - 0.01;
						СРН_Всего = СРН_Всего + 0.01;
					КонецЕсли;
					
					Если СРН_Всего > 0 Тогда
						СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни = СтрокаАктив.РезервыПоСтрахованиюИномуЧемЖизни + 0.01;
						СРН_Всего = СРН_Всего - 0.01;
					КонецЕсли;
									
					Если СРЖ_Всего < 0 И СтрокаАктив.РезервыПоСтрахованиюЖизни > 0.01 Тогда
						СтрокаАктив.РезервыПоСтрахованиюЖизни = СтрокаАктив.РезервыПоСтрахованиюЖизни - 0.01;
						СРЖ_Всего = СРЖ_Всего + 0.01;
					КонецЕсли;
					
					Если СРЖ_Всего > 0 Тогда
						СтрокаАктив.РезервыПоСтрахованиюЖизни = СтрокаАктив.РезервыПоСтрахованиюЖизни + 0.01;
						СРЖ_Всего = СРЖ_Всего - 0.01;
					КонецЕсли;
					
					Если ССН_Всего < 0  И СтрокаАктив.СобственныеСредстваВРазмереНорматива > 0.01 Тогда
						СтрокаАктив.СобственныеСредстваВРазмереНорматива = СтрокаАктив.СобственныеСредстваВРазмереНорматива - 0.01;
						ССН_Всего = ССН_Всего + 0.01;
					КонецЕсли;
					
					Если ССН_Всего > 0 Тогда
						СтрокаАктив.СобственныеСредстваВРазмереНорматива = СтрокаАктив.СобственныеСредстваВРазмереНорматива + 0.01;
						ССН_Всего = ССН_Всего - 0.01;
					КонецЕсли;  				
					
					Если ССС_Всего < 0 И СтрокаАктив.СобственныеСредстваСверхНорматива > 0.01 Тогда
						СтрокаАктив.СобственныеСредстваСверхНорматива = СтрокаАктив.СобственныеСредстваСверхНорматива - 0.01;
						ССС_Всего = ССС_Всего + 0.01;
					КонецЕсли;
					
					Если ССС_Всего > 0 Тогда
						СтрокаАктив.СобственныеСредстваСверхНорматива = СтрокаАктив.СобственныеСредстваСверхНорматива + 0.01;
						ССС_Всего = ССС_Всего - 0.01;
					КонецЕсли;				
				КонецЕсли;
				
				Позиция = Позиция - 1;
				
			КонецЦикла;
			
			ТекущийНовыйДокумент = ТекущийНовыйДокумент + 1;
			
			НовыйДокумент.Записать();
			
			МассивНовыхДокументов.Добавить( НовыйДокумент.Ссылка );
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Cформирован документ Распределение активов страховых компаний " + НовыйДокумент, НовыйДокумент.Ссылка, , , );
				
		КонецЦикла;

		ЗафиксироватьТранзакцию();
	
	КонецЕсли;
	
	#КонецОбласти

	НеФормироватьHTML = Ложь;
	
	// Формирование HTML для пройденных проверок.
	Для каждого СтрокаПроверки Из ЭтаФорма.Проверки Цикл
		
		ЭтаФорма.ПараметрыТекущейПроверки.Очистить();
		
		Для каждого Элемент Из СтрокаПроверки.Параметры Цикл
			ЭтаФорма.ПараметрыТекущейПроверки.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
		ЭтаФорма.КлючТекущейПроверки = СтрокаПроверки.Ключ;
		
		Выполнить(СтрокаПроверки.ИмяПроцедуры + "НаСервере()");
	КонецЦикла;

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат МассивНовыхДокументов;
	
КонецФункции

// Функция выполняет поиск элемента в коллекции: списке значений или массиве
//
Функция НайтиВСписке(Список, Элемент)
	
	Перем ЭлементВСписке;
	
	Если ТипЗнч(Список) = Тип("СписокЗначений") Тогда
		Если ТипЗнч(Элемент) = Тип("ЭлементСпискаЗначений") Тогда
			ЭлементВСписке = Список.НайтиПоЗначению(Элемент.Значение);
		Иначе
			ЭлементВСписке = Список.НайтиПоЗначению(Элемент);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Список) = Тип("Массив") ИЛИ ТипЗнч(Список) = Тип("ФиксированныйМассив") Тогда
		ЭлементВСписке = Список.Найти(Элемент);
	КонецЕсли;
	
	Возврат ЭлементВСписке;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокНеПройденныхПроверок()
	
	// При использовании истории часть проверок могут сразу быть с ошибками. 
	// Нужно их исключать из теста, иначе дальнейшее распределение уже невозможно.
	Массив = Новый Массив;
	
	Для каждого СтрокаПроверки Из ЭтаФорма.Проверки Цикл
		
		ЭтаФорма.ПараметрыТекущейПроверки.Очистить();
		
		Для каждого Элемент Из СтрокаПроверки.Параметры Цикл
			ЭтаФорма.ПараметрыТекущейПроверки.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
		ЭтаФорма.КлючТекущейПроверки = СтрокаПроверки.Ключ;
		
		Выполнить(СтрокаПроверки.ИмяПроцедуры + "НаСервере()");
		
		Если СтрокаПроверки.СтатусПроверки = 2 Тогда
			Массив.Добавить( СтрокаПроверки.Ключ );
		КонецЕсли;
	КонецЦикла;

	
	Возврат Массив;
	
	
КонецФункции

&НаСервере
Функция Проверить ( ИсключаемыеПроверки )
	
	РасчетныеПоказателиНаСервере = ЭтаФорма.РасчетныеПоказатели.Получить();
			
	Для каждого СтрокаПроверки Из ЭтаФорма.Проверки Цикл
		
		Если НайтиВСписке( ИсключаемыеПроверки, СтрокаПроверки.Ключ)<> Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ЭтаФорма.ПараметрыТекущейПроверки.Очистить();
		
		Для каждого Элемент Из СтрокаПроверки.Параметры Цикл
			ЭтаФорма.ПараметрыТекущейПроверки.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
		ЭтаФорма.КлючТекущейПроверки = СтрокаПроверки.Ключ;
		
		Выполнить(СтрокаПроверки.ИмяПроцедуры + "НаСервере()");
		
		Если СтрокаПроверки.СтатусПроверки = 2 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ТестРаспределения(Команда)
	
	Если ИспользоватьИсториюРаспределений = Ложь Тогда
		Если Вопрос("Отключено использование истории распределений. Распределение займет много времени. Продолжить?",
			РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;		
		КонецЕсли;		
	КонецЕсли;
	
	НовыеДокументы = ТестРаспределенияНаСервере();
	Для Каждого НовыйДокумент из НовыеДокументы Цикл
		
		 ОткрытьЗначение(НовыйДокумент);
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура РаспределитьАктивы()
	
	ДатаРаспределения = КонецДня(Объект.Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Счет
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Родитель = &СчетДоверительногоУправления
		|	И СчетаДоверительногоУправления.Организация = &Организация";
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Счета = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	
#Область ПолучитьАктивы

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумагиСК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦенныеБумагиСК.Рынок КАК Рынок,
		|	_ЦенныеБумагиСК.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦенныеБумагиСК.ВалютаНоминала КАК ВалютаНоминала,
		|	ЕСТЬNULL(_ЦенныеБумагиСК.БалансоваяСтоимость, 0) КАК БалансоваяСтоимость,
		|	_ЦенныеБумагиСК.БалансоваяСтоимостьКупона КАК БалансоваяСтоимостьКупона,
		|	_ЦенныеБумагиСК.Количество КАК Количество
		|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховойКомпании
		|ИЗ
		|	&СтоимостьЦенныхБумагСтраховойКомпании КАК _ЦенныеБумагиСК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиНаДепозитныхВкладах.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ОстаткиНаДепозитныхВкладах.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиНаДепозитныхВкладах.БалансоваяСтоимостьДепозитногоВклада КАК БалансоваяСтоимостьДепозитногоВклада,
		|	_ОстаткиНаДепозитныхВкладах.Валюта КАК Валюта,
		|	_ОстаткиНаДепозитныхВкладах.НоминалЕПС КАК НоминалЕПС,
		|	_ОстаткиНаДепозитныхВкладах.ПроцентыЕПС КАК ПроцентыЕПС
		|ПОМЕСТИТЬ _ОстаткиНаДепозитныхВкладахСтраховойКомпании
		|ИЗ
		|	&ОстаткиНаДепозитныхВкладах КАК _ОстаткиНаДепозитныхВкладах
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Актив,
		|	_СтоимостьЦенныхБумагСтраховойКомпании.ВалютаНоминала КАК Валюта,
		|	_СтоимостьЦенныхБумагСтраховойКомпании.БалансоваяСтоимость КАК ОбщаяСтоимостьАктива,
		|	NULL КАК СубъектПрочегоАктива,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЛОЖЬ КАК ПроцентныйДоход
		|ПОМЕСТИТЬ _НераспределенныеАктивы
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтоимостьЦенныхБумагСтраховойКомпании КАК _СтоимостьЦенныхБумагСтраховойКомпании
		|		ПО (_СтоимостьЦенныхБумагСтраховойКомпании.СчетДоверительногоУправления = БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления)
		|			И (_СтоимостьЦенныхБумагСтраховойКомпании.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
		|	_СтоимостьЦенныхБумагСтраховойКомпании.ВалютаНоминала,
		|	_СтоимостьЦенныхБумагСтраховойКомпании.БалансоваяСтоимостьКупона,
		|	NULL,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	ИСТИНА
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СтоимостьЦенныхБумагСтраховойКомпании КАК _СтоимостьЦенныхБумагСтраховойКомпании
		|		ПО (_СтоимостьЦенныхБумагСтраховойКомпании.СчетДоверительногоУправления = БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления)
		|			И (_СтоимостьЦенныхБумагСтраховойКомпании.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет,
		|	ОстаткиДенежныхСредствОстатки.Валюта,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток,
