		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_ДЗ.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	&МаксДоляСредств Как МаксДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_ДЗ.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ДЗ КАК _ДЗ
		|ГДЕ
		|	&ОбъемСредств > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДЗ.Актив,
		|	_ДЗ.СуммаВВалютеУчета
		|ИЗ
		|	_ДЗ КАК _ДЗ";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля дебиторской задолженности");
		
		Сумма 		= Показатели[0].ДебиторскаяЗадолженность;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств
		
	КонецЕсли;
	
	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
			СтатусПроверки =3;

	КонецЕсли;

	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
		
	КонецЕсли; 
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры // ДоляДебиторскойЗадолженностиСтрахователейНаСервере 

&НаСервере
Процедура ДоляДепозитныхАктивовЭмитентовСКонтролемРейтингаНаСервере()
	
	СтатусПроверки    = 1; 
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.СтрокаСопоставленияРейтингов КАК СтрокаСопоставления
		|ПОМЕСТИТЬ _ДепозитныеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.ВидАктива = ЗНАЧЕНИЕ(Справочник.ВидыПрочихАктивов.ДепозитарныеРасписки))
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеРейтинги.Субъект КАК Субъект,
		|	ВсеРейтинги.Шкала КАК Шкала,
		|	ВсеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВсеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ВсеРейтинги.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	ВсеРейтинги.ВсеРейтингиПоУмолчанию КАК ВсеРейтингиПоУмолчанию,
		|	ВсеРейтинги.ВерхняяГраницаДопустимогоРейтинга КАК ВерхняяГраницаДопустимогоРейтинга,
		|	ВсеРейтинги.Дефолт КАК Дефолт,
		|	ВсеРейтинги.СубординированныеОблигации КАК СубординированныеОблигации,
		|	ВсеРейтинги.СубординированныеДепозиты КАК СубординированныеДепозиты,
		|	ВсеРейтинги.ОблигацииСДатойВыпускаДо1307 КАК ОблигацииСДатойВыпускаДо1307,
		|	ВсеРейтинги.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня,
		|	ВсеРейтинги.РейтингВышеВерхнейГраницы КАК РейтингВышеВерхнейГраницы,
		|	ВсеРейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|	ВсеРейтинги.РезидентРФ КАК РезидентРФ
		|ПОМЕСТИТЬ _ВсеРейтинги
		|ИЗ
		|	&ВсеРейтинги КАК ВсеРейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивы.Эмитент КАК Эмитент,
		|	СУММА(ВЫБОР
		|			КОГДА _ВсеРейтинги.РейтингДостаточногоУровня = &РейтингВышеНижнейГраницы
		|					И _ВсеРейтинги.РейтингВышеВерхнейГраницы = &РейтингВышеВерхнейГраницы
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СчетКорректныхРейтингов
		|ПОМЕСТИТЬ _ЭмитентыДепозитныхАктивов
		|ИЗ
		|	_ДепозитныеАктивы КАК _ДепозитныеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеРейтинги КАК _ВсеРейтинги
		|		ПО _ДепозитныеАктивы.Эмитент = _ВсеРейтинги.Субъект
		|			И _ДепозитныеАктивы.СтрокаСопоставления = _ВсеРейтинги.СтрокаСопоставления
		|			И _ДепозитныеАктивы.ЭмитентЯвляетсяРезидентомРФ = _ВсеРейтинги.РезидентРФ
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДепозитныеАктивы.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивы.Эмитент КАК Эмитент,
		|	_ДепозитныеАктивы.Актив КАК Актив,
		|	_ДепозитныеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ЭмитентыСЗаданнымРейтингом
		|ИЗ
		|	_ДепозитныеАктивы КАК _ДепозитныеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЭмитентыДепозитныхАктивов КАК _ЭмитентыДепозитныхАктивов
		|		ПО (_ЭмитентыДепозитныхАктивов.Эмитент = _ДепозитныеАктивы.Эмитент)
		|ГДЕ
		|	_ЭмитентыДепозитныхАктивов.СчетКорректныхРейтингов > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ЭмитентыСЗаданнымРейтингом КАК _РейтингиЭмитентов
		|ГДЕ
		|	&ОбъемСредств > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеАктивы.Эмитент КАК Эмитент,
		|	_ДепозитныеАктивы.Актив КАК Актив,
		|	_ДепозитныеАктивы.СуммаВВалютеУчета КАК Сумма,
		|	_ВсеРейтинги.Шкала КАК Шкала,
		|	_ВсеРейтинги.РейтинговоеАгентство КАК Агентство,
		|	_ВсеРейтинги.ЗначениеРейтинга КАК Рейтинг,
		|	_ВсеРейтинги.МинимальноДопустимыйРейтинг КАК Мин,
		|	_ВсеРейтинги.ВерхняяГраницаДопустимогоРейтинга КАК Макс,
		|	_ВсеРейтинги.РейтингДостаточногоУровня КАК ВышеНижнейГраницы,
		|	_ВсеРейтинги.РейтингВышеВерхнейГраницы КАК ВышеВерхнейГраницы
		|ИЗ
		|	_ДепозитныеАктивы КАК _ДепозитныеАктивы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВсеРейтинги КАК _ВсеРейтинги
		|		ПО _ДепозитныеАктивы.Эмитент = _ВсеРейтинги.Субъект
		|			И _ДепозитныеАктивы.СтрокаСопоставления = _ВсеРейтинги.СтрокаСопоставления
		|			И _ДепозитныеАктивы.ЭмитентЯвляетсяРезидентомРФ = _ВсеРейтинги.РезидентРФ
		|ГДЕ
		|	_ВсеРейтинги.РейтингДостаточногоУровня = &РейтингВышеНижнейГраницы
		|	И _ВсеРейтинги.РейтингВышеВерхнейГраницы = &РейтингВышеВерхнейГраницы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент,
		|	Актив,
		|	Агентство,
		|	Шкала
		|ИТОГИ ПО
		|	Актив";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Результат     =  ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;	
	
	Если Результат.Количество() > 0 Тогда

		Если Результат[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат, "Доля депозитов, деп. сертификатов.");
		
		Сумма 		= Результат[0].СуммаВВалютеУчета;
		База  		= Результат[0].ОбъемСредств;
		Показатель	= Результат[0].ДоляСредств;
		
	Иначе
		СтатусПроверки = 1;
	КонецЕсли;
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Депозитные активы эмитент");
		
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

