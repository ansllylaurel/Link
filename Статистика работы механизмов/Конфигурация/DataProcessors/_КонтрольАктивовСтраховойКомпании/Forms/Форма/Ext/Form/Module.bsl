		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СРЖ,
		|	СУММА(ВЫБОР
		|			КОГДА ВидыПортфелейСтраховыхКомпаний1.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни)
		|				ТОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма * _Активы.Курс
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СРН,
		|	СУММА(ВЫБОР
		|			КОГДА ВидыПортфелейСтраховыхКомпаний1.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива)
		|				ТОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма * _Активы.Курс
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ССН,
		|	СУММА(ВЫБОР
		|			КОГДА ВидыПортфелейСтраховыхКомпаний1.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|				ТОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма * _Активы.Курс
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ССС,
		|	_Активы.Распределено КАК Распределено,
		|	_Активы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Активы.СвязаннаяСторона КАК СвязаннаяСторона,
		|	_Активы.СтрокаСопоставленияРейтингов КАК СтрокаСопоставленияРейтингов,
		|	_Активы.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
		|	_Активы.Курс КАК Курс
		|ИЗ
		|	_Активы КАК _Активы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьАктивовСтраховыхКомпаний.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправленияИсходный.Родитель = &СчетДоверительногоУправления
		|					И &ИспользоватьИсторию = ИСТИНА) КАК СтоимостьАктивовСтраховыхКомпанийСрезПоследних
		|		ПО _Активы.Актив = СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив
		|			И (_Активы.ПроцентныйДоход = ЛОЖЬ)
		|			И _Активы.Валюта = СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта
		|			И _Активы.СчетДоверительногоУправления = СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный
		|			И (ЕСТЬNULL(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СубъектПрочегоАктива, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) = ЕСТЬNULL(_Активы.Эмитент, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
		|				ИЛИ НЕ СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.ПрочиеАктивы)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ВидыПортфелейСтраховыхКомпаний
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечисление.ВидыПортфелейСтраховыхКомпаний КАК ВидыПортфелейСтраховыхКомпаний1
		|			ПО ВидыПортфелейСтраховыхКомпаний.Значение = ВидыПортфелейСтраховыхКомпаний1.Ссылка
		|		ПО (СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления = ВидыПортфелейСтраховыхКомпаний.Объект)
		|			И (ВидыПортфелейСтраховыхКомпаний.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
		|
		|СГРУППИРОВАТЬ ПО
		|	_Активы.СчетДоверительногоУправления,
		|	_Активы.Рынок,
		|	_Активы.Эмитент,
		|	_Активы.ЭмитентЯвляетсяРезидентомРФ,
		|	_Активы.Валюта,
		|	_Активы.Сумма,
		|	_Активы.Нераспределено,
		|	_Активы.ЭмитентЯвляетсяБанком,
		|	_Активы.Актив,
		|	_Активы.ВидАктива,
		|	_Активы.СвязаннаяСторона,
		|	_Активы.СтрокаСопоставленияРейтингов,
		|	_Активы.Распределено,
		|	_Активы.СуммаВВалютеУчета,
		|	_Активы.СубъектПрочегоАктива,
		|	_Активы.Курс";
	
	Запрос.УстановитьПараметр("АктивыСК", АктивыСК); 	
	Запрос.УстановитьПараметр("Период", ДатаРаспределения);	 
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);	 
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("ИспользоватьИсторию",ЭтаФорма.ИспользоватьИсториюРаспределений);

	Запрос.УстановитьПараметр("КурсыВалют", Объект.КурсыВалютныхАктивов.Выгрузить());
	
	Активы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого АктивСК из Активы Цикл
		
		Пока(АктивСК.СРЖ + АктивСК.СРН + АктивСК.ССН + АктивСК.ССС > АктивСК.СуммаВВалютеУчета) Цикл
			
			Если АктивСК.ССН > 0 Тогда
				  АктивСК.ССН = 0;
				  Продолжить;
			КонецЕсли;
			
			Если АктивСК.ССС > 0 Тогда
				  АктивСК.ССС = 0;
				  Продолжить;
			КонецЕсли;

			Если АктивСК.СРН > 0 Тогда
				  АктивСК.СРН = 0;
				  Продолжить;
			КонецЕсли;

			Если АктивСК.СРЖ > 0 Тогда
				  АктивСК.СРЖ = 0;
				  Продолжить;
			КонецЕсли;   		
			
		КонецЦикла;
		
		АктивСК.СуммаВВалютеУчета = АктивСК.СуммаВВалютеУчета - АктивСК.СРЖ - АктивСК.СРН - АктивСК.ССН - АктивСК.ССС;
		Если  АктивСК.СуммаВВалютеУчета  < 0 Тогда
			 АктивСК.СуммаВВалютеУчета = 0;
		КонецЕсли;		
		
		НераспределенныйАктив = Объект.РаспределяемыеАктивы.Добавить();
		
		ЗаполнитьЗначенияСвойств( НераспределенныйАктив, АктивСК);
		
	КонецЦикла;
	
КонецПроцедуры

// Расчет рублевой стоимости валютных активов
&НаСервере
Процедура ЗаполнитьВалютыНаСервере(АктивыСтраховойКомпании)
			
		Запрос = Новый Запрос();
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		               |	_АктивыСтраховойКомпании.Валюта КАК Валюта,
		               |	_АктивыСтраховойКомпании.Актив КАК Актив,
		               |	_АктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		               |ПОМЕСТИТЬ _ВсеАктивыСтраховойКомпании
		               |ИЗ
		               |	&АктивыСтраховойКомпании КАК _АктивыСтраховойКомпании
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	_ВсеАктивыСтраховойКомпании.Валюта КАК Валюта,
		               |	_ВсеАктивыСтраховойКомпании.Актив КАК Актив,
		               |	_ВсеАктивыСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		               |ИЗ
		               |	_ВсеАктивыСтраховойКомпании КАК _ВсеАктивыСтраховойКомпании
		               |ГДЕ
		               |	_ВсеАктивыСтраховойКомпании.Валюта <> ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета";
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		Запрос.УстановитьПараметр("АктивыСтраховойКомпании", АктивыСтраховойКомпании);

		
		КурсыВалют =  Документы.РаспределениеАктивовСтраховыхКомпаний.ПолучитьКурсыВалютДляАктивовСтраховойКомпании(Запрос.Выполнить().Выгрузить(), ?(ЗначениеЗаполнено(Объект.Период),Объект.Период,КонецДня(ТекущаяДата())), объект.Организация);
		
		Для Каждого СтрокаКурсыВалют Из КурсыВалют Цикл 
			НоваяСтрокаТаблицы = Объект.КурсыВалютныхАктивов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаКурсыВалют);
			НоваяСтрокаТаблицы.ДатаКурса = СтрокаКурсыВалют.ДатаКурсаВалют;
		КонецЦикла;
		
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетныеПоказателиДляАвтоРаспределенияНаСервере()
	
	РасчетныеПоказателиНаСервере = Новый Структура("ВалютаУчета", Объект.Организация.ВалютаУчета);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыСК.Актив КАК Актив,
		|	_АктивыСК.ВидАктива КАК ВидАктива,
		|	_АктивыСК.Рынок КАК Рынок,
		|	_АктивыСК.Эмитент КАК Эмитент,
		|	_АктивыСК.ЭмитентЯвляетсяБанком КАК ЭмитентЯвляетсяБанком,
		|	_АктивыСК.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	_АктивыСК.Валюта КАК Валюта,
		|	_АктивыСК.Сумма КАК Сумма,
		|	_АктивыСК.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	_АктивыСК.Нераспределено КАК Нераспределено,
		|	_АктивыСК.СРЖ КАК СРЖ,
		|	_АктивыСК.СРН КАК СРН,
		|	_АктивыСК.ССН КАК ССН,
		|	_АктивыСК.ССС КАК ССС,
		|	_АктивыСК.Распределено КАК Распределено,
		|	_АктивыСК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_АктивыСК.СвязаннаяСторона КАК СвязаннаяСторона,
		|	_АктивыСК.СтрокаСопоставленияРейтингов КАК СтрокаСопоставленияРейтингов,
		|	_АктивыСК.Курс КАК Курс
		|ПОМЕСТИТЬ _АктивыСК
		|ИЗ
		|	&АктивыСК КАК _АктивыСК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Ссылка КАК СчетДоверительногоУправления,
		|	ПортфелиСтраховыхКомпаний.Значение КАК ВидПортфеляСтраховойКомпании,
		|	АктивыСК.Актив КАК Актив,
		|	АктивыСК.Рынок КАК Рынок,
		|	АктивыСК.ВидАктива КАК ВидАктива,
		|	АктивыСК.Эмитент КАК Эмитент,
		|	АктивыСК.ЭмитентЯвляетсяБанком КАК ЭмитентЯвляетсяБанком,
		|	АктивыСК.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	АктивыСК.Валюта КАК Валюта,
		|	АктивыСК.Курс КАК КурсВалюты,
		|	ВЫБОР
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни)
		|			ТОГДА АктивыСК.СРЖ
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни)
		|			ТОГДА АктивыСК.СРН
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива)
		|			ТОГДА АктивыСК.ССН
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|			ТОГДА АктивыСК.ССС
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни)
		|			ТОГДА АктивыСК.СРЖ
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни)
		|			ТОГДА АктивыСК.СРН
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива)
		|			ТОГДА АктивыСК.ССН
		|		КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|			ТОГДА АктивыСК.ССС
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаВВалютеУчета,
		|	АктивыСК.СвязаннаяСторона КАК СвязаннаяСторона,
		|	АктивыСК.СтрокаСопоставленияРейтингов КАК СтрокаСопоставленияРейтингов,
		|	АктивыСК.СчетДоверительногоУправления КАК СчетДоверительногоУправленияИсходный
		|ИЗ
		|	_АктивыСК КАК АктивыСК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|		ПО (СчетаДУ.Ссылка.Родитель = ВЫРАЗИТЬ(АктивыСК.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).Родитель)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ПортфелиСтраховыхКомпаний
		|		ПО (СчетаДУ.Ссылка = ПортфелиСтраховыхКомпаний.Объект)
		|			И (ПортфелиСтраховыхКомпаний.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
		|ГДЕ
		|	ПортфелиСтраховыхКомпаний.Значение В (ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни), ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни), ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива), ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива))
		|	И ВЫБОР
		|			КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни)
		|				ТОГДА АктивыСК.СРЖ > 0
		|			КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни)
		|				ТОГДА АктивыСК.СРН > 0
		|			КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива)
		|				ТОГДА АктивыСК.ССН > 0
		|			КОГДА ПортфелиСтраховыхКомпаний.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|				ТОГДА АктивыСК.ССС > 0
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("АктивыСК", Объект.РаспределяемыеАктивы.Выгрузить());
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);			
	// распределенные активы страховой компании
	РасчетныеПоказателиНаСервере.Вставить("РаспределенныеАктивыСтраховойКомпании", Запрос.Выполнить().Выгрузить());
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыПоказателейСтраховыхКомпаний.Ссылка КАК ВидПоказателя,
		|	СУММА(ЕСТЬNULL(ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ЗначениеПоказателя, 0)) КАК ЗначениеПоказателя
		|ИЗ
		|	Перечисление.ВидыПоказателейСтраховыхКомпаний КАК ВидыПоказателейСтраховыхКомпаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления) КАК ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|			ПО ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
		|				И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
		|		ПО (ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ВидПоказателя = ВидыПоказателейСтраховыхКомпаний.Ссылка)
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыПоказателейСтраховыхКомпаний.Ссылка";
	// Предоставляемые показатели нужно отбирать для основного счета клиента. Они могут быть указаны и для счета в ДУ.
	
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления); 		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ПредоставляемыеПоказатели = Запрос.Выполнить().Выгрузить();
	
	РасчетныеПоказателиНаСервере.Вставить("ОбъемРезервовПоСтрахованиюЖизни", 0); 	
	РасчетныеПоказателиНаСервере.Вставить("ОбъемРезервовПоСтрахованиюИномуЧемЖизни", 0); 	
	РасчетныеПоказателиНаСервере.Вставить("ОбъемСобственныхСредствВРазмереНорматива", 0); 	
	РасчетныеПоказателиНаСервере.Вставить("МинимальныйРазмерУставногоКапитала", 0); 	
	РасчетныеПоказателиНаСервере.Вставить("ОбъемСобственныхСредствСверхНорматива", 0); 	
	РасчетныеПоказателиНаСервере.Вставить("СтраховыеРезервыИныеКромеРезерваУбытков", 0);  	
	РасчетныеПоказателиНаСервере.Вставить("СтабилизационныйРезерв", 0);

	
	Для Каждого Показатель из ПредоставляемыеПоказатели Цикл
		
		Если НЕ Показатель.ЗначениеПоказателя = Неопределено   Тогда		
			Если Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюЖизни) Тогда
				РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюЖизни = Показатель.ЗначениеПоказателя;	
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни) Тогда
				РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни = Показатель.ЗначениеПоказателя; 	
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.НормативныйРазмерМаржиПлатежеспособности) Тогда
				РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствВРазмереНорматива = Показатель.ЗначениеПоказателя;	
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.МинимальныйРазмерУставногоКапитала) Тогда
				РасчетныеПоказателиНаСервере.МинимальныйРазмерУставногоКапитала = Показатель.ЗначениеПоказателя;	
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.ПревышенияРазмераСобственныхСредствНадНаибольшимПоказателем) Тогда
				РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствСверхНорматива=Показатель.ЗначениеПоказателя;	
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.РезервЗаявленныхНоНеурегулированныхУбытков) Тогда
				РасчетныеПоказателиНаСервере.СтраховыеРезервыИныеКромеРезерваУбытков = РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни - Показатель.ЗначениеПоказателя;
			ИначеЕсли Показатель.ВидПоказателя = (Перечисления.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыДляКомпенсацииРасходов)Тогда
			    РасчетныеПоказателиНаСервере.СтабилизационныйРезерв = Показатель.ЗначениеПоказателя;
				
			КонецЕсли;
		КонецЕсли;    	
		       
		РасчетныеПоказателиНаСервере.Вставить("ПредоставляемыйПоказатель" + XMLстрока(Показатель.ВидПоказателя), ?(Показатель.ЗначениеПоказателя = Неопределено, 0, Показатель.ЗначениеПоказателя ));
		
	КонецЦикла;	
	
	// Усложнилась формула расчета, требуется учет дебеторки при расчете суммы страховых резервов
	//15.10.19 задача 283773
		
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Активы.Актив КАК Актив,
	|	Активы.СуммаВВалютеУчета КАК Сумма
	|ПОМЕСТИТЬ _Активы
	|ИЗ
	|	&Активы КАК Активы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(_Активы.Сумма) КАК Сумма
	|ИЗ
	|	_Активы КАК _Активы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеАктивы КАК ПрочиеАктивы
	|		ПО _Активы.Актив = ПрочиеАктивы.Ссылка
	|ГДЕ
	|	ПрочиеАктивы.Код = &Код";

	Запрос.УстановитьПараметр("Активы",РасчетныеПоказателиНаСервере.РаспределенныеАктивыСтраховойКомпании);
	Запрос.УстановитьПараметр("Код","000000373" );// 220. Дебиторская задолженность страховщиков по прямому возмещению убытков

	Результат = Запрос.Выполнить().Выбрать();
	СуммаДебиторскойЗадолженности = 0;
	Если Результат.Следующий() и ЗначениеЗаполнено(Результат.Сумма) Тогда
		СуммаДебиторскойЗадолженности = Результат.Сумма;	
	КонецЕсли;
		
	РасчетныеПоказателиНаСервере.Вставить("СуммаДебиторскойЗадолженности", СуммаДебиторскойЗадолженности);
                         	
	
	РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни = РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни 
			- МИН(РасчетныеПоказателиНаСервере.СтабилизационныйРезерв, СуммаДебиторскойЗадолженности);
	Если РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни < 0 Тогда
		РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни = 0;
	КонецЕсли;
	
	РасчетныеПоказателиНаСервере.Вставить("ОбъемСтраховыхРезервов", 
				РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюЖизни + РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни);

	РасчетныеПоказателиНаСервере.Вставить("ОбъемСобственныхСредств", 
				МАКС( РасчетныеПоказателиНаСервере.МинимальныйРазмерУставногоКапитала, 
					  РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствВРазмереНорматива));	
	// сохранение
	ЭтаФорма.РасчетныеПоказатели = Новый ХранилищеЗначения(РасчетныеПоказателиНаСервере);
			
КонецПроцедуры // ЗаполнитьРасчетныеПоказателиНаСервере

#КонецОбласти

&НаСервере
Процедура ЗаполнитьРасчетныеПоказателиНаСервере()
	
	РасчетныеПоказателиНаСервере = Новый Структура("ВалютаУчета", Объект.Организация.ВалютаУчета);
	
	                      
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Актив,
		|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта КАК Валюта
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовСтраховыхКомпаний.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления
		|				И Валюта <> ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета) КАК СтоимостьАктивовСтраховыхКомпанийСрезПоследних";
	
	Запрос.УстановитьПараметр("Период",                       			Объект.Период);
	Запрос.УстановитьПараметр("Организация",                  			Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			Объект.СчетДоверительногоУправления);

	ВалютныеАктивыСтраховойКомпании = Запрос.Выполнить().Выгрузить();
	
	КурсыВалютАктивовСтраховойКомпании = Документы.РаспределениеАктивовСтраховыхКомпаний.ПолучитьКурсыВалютДляАктивовСтраховойКомпании(
		ВалютныеАктивыСтраховойКомпании, КонецДня(Объект.Период), Объект.Организация);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КурсыВалютАктивовСтраховойКомпании.Актив КАК Актив,
		|	_КурсыВалютАктивовСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Валюта,
		|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалют,
		|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК Курс,
		|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК Кратность
		|ПОМЕСТИТЬ _КурсыВалютАктивовСтраховойКомпании
		|ИЗ
		|	&КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗначенияДополнительныхСведений.Значение КАК ВидПортфеляСтраховойКомпании,
		|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Актив,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Облигации
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Векселя
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Паи
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|	КОНЕЦ КАК Рынок,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.Облигации).Категория
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.Паи).ПаевойИнвестиционныйФонд.Тип
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.БанковскиеСчета
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.ДепозитныеВклады
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.ПрочиеАктивы
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.ПрочиеАктивы).ВидПрочегоАктива
		|	КОНЕЦ КАК ВидАктива,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив ССЫЛКА Справочник.БанковскиеСчета
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Справочник.БанковскиеСчета).Банк.ЮрФизЛицо
