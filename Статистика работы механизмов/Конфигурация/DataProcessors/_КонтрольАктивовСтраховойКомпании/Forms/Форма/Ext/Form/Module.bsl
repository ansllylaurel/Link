		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК КорректныйУровеньРейтинга
		|ПОМЕСТИТЬ _ВсеРейтингиЭмитентов
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Рейтинги.СрезПоследних(
		|				&Период,
		|				Субъект В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ПрочиеАктивы.Эмитент
		|					ИЗ
		|						_ПрочиеАктивы)) КАК РейтингиСрезПоследних
		|		ПО _ПрочиеАктивы.Эмитент = РейтингиСрезПоследних.Субъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МинимальноДопустимыеРейтинги КАК _МинимальноДопустимыеРейтинги
		|		ПО (РейтингиСрезПоследних.РейтинговоеАгентство = _МинимальноДопустимыеРейтинги.РейтинговоеАгентство)
		|			И (РейтингиСрезПоследних.Шкала = _МинимальноДопустимыеРейтинги.Шкала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВсеРейтингиЭмитентов.Эмитент,
		|	СУММА(ВЫБОР
		|			КОГДА _ВсеРейтингиЭмитентов.КорректныйУровеньРейтинга
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КорректныйУровень
		|ПОМЕСТИТЬ _ЭмитентыСКорректнымРейтингом
		|ИЗ
		|	_ВсеРейтингиЭмитентов КАК _ВсеРейтингиЭмитентов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеРейтингиЭмитентов.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Эмитент,
		|	_ПрочиеАктивы.Актив,
		|	_ПрочиеАктивы.СуммаВВалютеУчета
		|ПОМЕСТИТЬ _РейтингиЭмитентов
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыСКорректнымРейтингом КАК _ЭмитентыСКорректнымРейтингом
		|		ПО (_ЭмитентыСКорректнымРейтингом.Эмитент = _ПрочиеАктивы.Эмитент)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &КорректныйУровеньРейтинга = 1
		|				ТОГДА _ЭмитентыСКорректнымРейтингом.КорректныйУровень > 0
		|			ИНАЧЕ _ЭмитентыСКорректнымРейтингом.КорректныйУровень = 0
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	&МаксДоляСредств КАК Ограничение,
		|	ВЫБОР
		|		КОГДА СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение,
		|	_РейтингиЭмитентов.Эмитент КАК СубъектПрочегоАктива
		|ИЗ
		|	_РейтингиЭмитентов КАК _РейтингиЭмитентов
		|ГДЕ
		|	&ОбъемСредств > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_РейтингиЭмитентов.Эмитент";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	Результат = Запрос.Выполнить().Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	
	Если Результат.Количество() > 0 Тогда
		

		Если Результат[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма 		= Результат[0].СуммаВВалютеУчета;
		База  		= Результат[0].ОбъемСредств;
		Показатель	= Результат[0].ДоляСредств;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат,  Запрос.Параметры.Заголовок);
	Иначе 
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";		
		СтатусПроверки = 1;
	КонецЕсли;
	 	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

&НаСервере
Процедура ДоляПрочегоАктиваОдногоЭмитентаСПроверкойРейтингаИНаличияЛицензииНаСервере()
	СтатусПроверки    = 1; 
	ОтчетВФорматеHTML = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.СтрокаСопоставленияРейтингов КАК СтрокаСопоставления
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	НЕ РаспределенныеАктивыСтраховойКомпании.Эмитент ЕСТЬ NULL
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивов)
		|	И РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ = &ЭмитентЯвляетсяРезидентомРФ
		|	И РаспределенныеАктивыСтраховойКомпании.Эмитент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЛицензий.Период КАК Период,
		|	СтатусыЛицензий.Лицензия КАК Лицензия,
		|	СтатусыЛицензий.Статус КАК Статус,
		|	СтатусыЛицензий.Эмитент КАК Эмитент
		|ПОМЕСТИТЬ _СтатусыЛицензий
		|ИЗ
		|	&СтатусыЛицензий КАК СтатусыЛицензий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеРейтинги.Субъект КАК Субъект,
		|	ВсеРейтинги.Шкала КАК Шкала,
		|	ВсеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ВсеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	ВсеРейтинги.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	ВсеРейтинги.ВерхняяГраницаДопустимогоРейтинга КАК ВерхняяГраницаДопустимогоРейтинга,
		|	ВсеРейтинги.ВсеРейтингиПоУмолчанию КАК ВсеРейтингиПоУмолчанию,
		|	ВсеРейтинги.Дефолт КАК Дефолт,
		|	ВсеРейтинги.СубординированныеОблигации КАК СубординированныеОблигации,
		|	ВсеРейтинги.СубординированныеДепозиты КАК СубординированныеДепозиты,
		|	ВсеРейтинги.ОблигацииСДатойВыпускаДо1307 КАК ОблигацииСДатойВыпускаДо1307,
		|	ВсеРейтинги.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня,
		|	ВсеРейтинги.РейтингВышеВерхнейГраницы КАК РейтингВышеВерхнейГраницы,
		|	ВсеРейтинги.СтрокаСопоставления КАК СтрокаСопоставления,
		|	ВсеРейтинги.РезидентРФ КАК РезидентРФ
		|ПОМЕСТИТЬ _ВсеРейтинги
		|ИЗ
		|	&ВсеРейтинги КАК ВсеРейтинги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Эмитент КАК Эмитент,
		|	_ВсеРейтинги.РейтингДостаточногоУровня КАК РейтингДостаточногоУровня
		|ПОМЕСТИТЬ _ВсеРейтингиЭмитентов
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеРейтинги КАК _ВсеРейтинги
		|		ПО _ПрочиеАктивы.Эмитент = _ВсеРейтинги.Субъект
		|			И _ПрочиеАктивы.СтрокаСопоставления = _ВсеРейтинги.СтрокаСопоставления
		|			И _ПрочиеАктивы.ЭмитентЯвляетсяРезидентомРФ = _ВсеРейтинги.РезидентРФ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВсеРейтингиЭмитентов.Эмитент КАК Эмитент,
		|	СУММА(ВЫБОР
		|			КОГДА _ВсеРейтингиЭмитентов.РейтингДостаточногоУровня
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КорректныйУровень
		|ПОМЕСТИТЬ _ЭмитентыСКорректнымРейтингом
		|ИЗ
		|	_ВсеРейтингиЭмитентов КАК _ВсеРейтингиЭмитентов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеРейтингиЭмитентов.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Эмитент КАК Эмитент,
		|	_ПрочиеАктивы.Актив КАК Актив,
		|	_ПрочиеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _РейтингиЭмитентов
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЭмитентыСКорректнымРейтингом КАК _ЭмитентыСКорректнымРейтингом
		|		ПО (_ЭмитентыСКорректнымРейтингом.Эмитент = _ПрочиеАктивы.Эмитент)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &КорректныйУровеньРейтинга = 1
		|				ТОГДА _ЭмитентыСКорректнымРейтингом.КорректныйУровень > 0
		|			ИНАЧЕ _ЭмитентыСКорректнымРейтингом.КорректныйУровень = 0
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПрочиеАктивы.Эмитент КАК Эмитент,
		|	_ПрочиеАктивы.СтрокаСопоставления КАК СтрокаСопоставления,
		|	_ВсеРейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	_ВсеРейтинги.Шкала КАК Шкала,
		|	_ВсеРейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	_ВсеРейтинги.МинимальноДопустимыйРейтинг КАК МинимальноДопустимыйРейтинг,
		|	_ВсеРейтинги.ВерхняяГраницаДопустимогоРейтинга КАК ВерхняяГраницаДопустимогоРейтинга
		|ИЗ
		|	_ВсеРейтинги КАК _ВсеРейтинги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПрочиеАктивы КАК _ПрочиеАктивы
		|		ПО _ВсеРейтинги.Субъект = _ПрочиеАктивы.Эмитент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	&МаксДоляСредств КАК Ограничение,
		|	ВЫБОР
		|		КОГДА СУММА(_РейтингиЭмитентов.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		КОГДА _СтатусыЛицензий.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|			ТОГДА ИСТИНА
		|		КОГДА _СтатусыЛицензий.Лицензия ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение,
		|	_РейтингиЭмитентов.Эмитент КАК СубъектПрочегоАктива
		|ИЗ
		|	_РейтингиЭмитентов КАК _РейтингиЭмитентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыЛицензий КАК _СтатусыЛицензий
		|		ПО _РейтингиЭмитентов.Эмитент = _СтатусыЛицензий.Эмитент
		|ГДЕ
		|	&ОбъемСредств > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_РейтингиЭмитентов.Эмитент,
		|	_СтатусыЛицензий.Статус,
		|	_СтатусыЛицензий.Лицензия
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ";

	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	ПакетРезультатов = Запрос.ВыполнитьПакет();
		
	Результат      = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;
	
	Если Результат.Количество() > 0 Тогда		

		Если Результат[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		Сумма 		= Результат[0].СуммаВВалютеУчета;
		База  		= Результат[0].ОбъемСредств;
		Показатель	= Результат[0].ДоляСредств;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат,  Запрос.Параметры.Заголовок);
	Иначе 
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";		
		СтатусПроверки = 1;
	КонецЕсли;
	
	ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка,  "Значения рейтингов");
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

&НаСервере
Процедура КонтрольНаличияЛицензииЭмитентаПрочегоАктиваНаСервере()
	
	СтатусПроверки    = 1;
	ОтчетВФорматеHTML =      "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
		|	РаспределенныеАктивыСтраховойКомпании.ЭмитентЯвляетсяРезидентомРФ КАК ЭмитентЯвляетсяРезидентомРФ,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	НЕ РаспределенныеАктивыСтраховойКомпании.Эмитент ЕСТЬ NULL
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивов)
		|	И РаспределенныеАктивыСтраховойКомпании.Эмитент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Актив КАК Актив,
		|	СУММА(_ПрочиеАктивы.СуммаВВалютеУчета) КАК СуммаВВалютеУчета,
		|	_ПрочиеАктивы.Эмитент КАК Эмитент,
		|	ВЫБОР
		|		КОГДА ДействующиеЛицензии.Статус ЕСТЬ НЕ NULL 
		|			ТОГДА ДействующиеЛицензии.Лицензия.Номер
		|		КОГДА СтатусыЛицензий.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|			ТОГДА ""СНЯТА "" + ЕСТЬNULL(СтатусыЛицензий.Лицензия.Номер, "" лицензия"")
		|		ИНАЧЕ ""Нет данных""
		|	КОНЕЦ КАК НомерЛицензии,
		|	ВЫБОР
		|		КОГДА ДействующиеЛицензии.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|			ТОГДА ИСТИНА
		|		КОГДА ДействующиеЛицензии.Лицензия ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних КАК ДействующиеЛицензии
		|		ПО _ПрочиеАктивы.Эмитент = ДействующиеЛицензии.Лицензия.ЮрФизЛицо
		|			И (ДействующиеЛицензии.Лицензия.ВидДеятельности = &ВидДеятельности)
		|			И (ДействующиеЛицензии.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				СтатусыЛицензий.Лицензия.ЮрФизЛицо КАК ЮрФизЛицо,
		|				МАКСИМУМ(СтатусыЛицензий.Период) КАК Период
		|			ИЗ
		|				РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|			ГДЕ
		|				СтатусыЛицензий.Лицензия.ВидДеятельности = &ВидДеятельности
		|			
		|			СГРУППИРОВАТЬ ПО
		|				СтатусыЛицензий.Лицензия.ЮрФизЛицо) КАК ПоследнийСтатус
		|			ПО СтатусыЛицензий.Лицензия.ЮрФизЛицо = ПоследнийСтатус.ЮрФизЛицо
		|				И СтатусыЛицензий.Период = ПоследнийСтатус.Период
		|		ПО _ПрочиеАктивы.Эмитент = СтатусыЛицензий.Лицензия.ЮрФизЛицо
		|			И (СтатусыЛицензий.Лицензия.ВидДеятельности = &ВидДеятельности)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПрочиеАктивы.Актив,
		|	_ПрочиеАктивы.Эмитент,
		|	ДействующиеЛицензии.Статус,
		|	ДействующиеЛицензии.Лицензия,
		|	СтатусыЛицензий.Статус,
		|	СтатусыЛицензий.Лицензия,
		|	ВЫБОР
		|		КОГДА ДействующиеЛицензии.Статус ЕСТЬ НЕ NULL 
		|			ТОГДА ДействующиеЛицензии.Лицензия.Номер
		|		КОГДА СтатусыЛицензий.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|			ТОГДА ""СНЯТА "" + ЕСТЬNULL(СтатусыЛицензий.Лицензия.Номер, "" лицензия"")
		|		ИНАЧЕ ""Нет данных""
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ";
						
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	Результат = Запрос.Выполнить().Выгрузить();

	
	Если Результат.Количество() > 0 Тогда 		

		Если Результат[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат,  Запрос.Параметры.Заголовок);
	Иначе 
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";		
		СтатусПроверки = 1;
	КонецЕсли;
	 	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, 0, 0, 0);


