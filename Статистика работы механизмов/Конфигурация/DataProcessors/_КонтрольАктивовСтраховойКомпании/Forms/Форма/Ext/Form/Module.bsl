		|	""Данные активы не допускаются к распределению в собственные средства сверх норматива.""
		|ИЗ
		|	_РаспределенныеАктивыСтраховойКомпании КАК _РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	_РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивовЗапрещенныеКРазмещениюВССверх)
		|	И _РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	_РаспределенныеАктивыСтраховойКомпании.Актив,
		|	_РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	_РаспределенныеАктивыСтраховойКомпании.Рынок,
		|	_РаспределенныеАктивыСтраховойКомпании.ВидАктива,
		|	_РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании,
		|	""Векселя могут быть распределены только в собственные средства сверх норматива""
		|ИЗ
		|	_РаспределенныеАктивыСтраховойКомпании КАК _РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	_РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|	И _РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании <> ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива)"
;
	    // параметры
		// ПроверкаКорректностиРаспределенияАктивовНаСервере,КодыАктивовЗапрещенныеКРазмещениюВСРЖизни, КодыАктивовЗапрещенныеКРазмещениюВСРИные,КодыАктивовЗапрещенныеКРазмещениюВССредств,КодыАктивовЗапрещенныеКРазмещениюВССверх
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		СтатусПроверки = 2;
		ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Результат, "Ошибки в распределении активов");
		
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Ошибок нет. Все активы распределены корректно";
		СтатусПроверки = 1;
	КонецЕсли;
	 	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, 0, 0, 0);

	
