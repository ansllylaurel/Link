&НаСервере
Процедура ДоляПрочегоАктиваСВыводомСубъектаНаСервере()
	СтатусПроверки    = 1;
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Эмитент
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.Актив В (&КодыАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_ПрочиеАктивы.СуммаВВалютеУчета), 0) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_ПрочиеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_ПрочиеАктивы.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|ГДЕ   &ОбъемСредств > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Актив,
		|	_ПрочиеАктивы.СуммаВВалютеУчета,
		|	_ПрочиеАктивы.Эмитент  Как ЮрЛицо
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База		   = 0;
	Показатель 	   = 0;		
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		Если Запрос.Параметры.Свойство("Заголовок") Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля прочего актива");
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
		СтатусПроверки = 3;
	КонецЕсли;
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
	КонецЕсли;
	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);
	
КонецПроцедуры

&НаСервере
Процедура ДоляПрочегоАктиваИРепоНаСервере()
	СтатусПроверки    = 1;
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _ПрочиеАктивы
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|	И РаспределенныеАктивыСтраховойКомпании.Актив В(&КодыАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенныеАктивыСтраховойКомпании.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
		|ГДЕ
		|	(РаспределенныеАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.Акции
		|			ИЛИ РаспределенныеАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.Облигации)
		|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеАктивы.Актив КАК Актив,
		|	_ПрочиеАктивы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ПОМЕСТИТЬ _Активы
		|ИЗ
		|	_ПрочиеАктивы КАК _ПрочиеАктивы
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ценныебумаги.Актив,
		|	ВЫБОР
		|		КОГДА _ценныебумаги.СуммаВВалютеУчета - ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьОстаток, 0) > БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток
		|			ТОГДА БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток
		|		ИНАЧЕ _ценныебумаги.СуммаВВалютеУчета - ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьОстаток, 0)
		|	КОНЕЦ
		|ИЗ
		|	_ЦенныеБумаги КАК _ценныебумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|				&КонецДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|		ПО _ценныебумаги.Актив = БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&КонецДня,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления.Родитель = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ПО _ценныебумаги.Актив = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|ГДЕ
		|	_ценныебумаги.СуммаВВалютеУчета - ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьОстаток, 0) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_Активы.СуммаВВалютеУчета), 0) КАК СуммаВВалютеУчета,
		|	&ОбъемСредств КАК ОбъемСредств,
		|	СУММА(_Активы.СуммаВВалютеУчета) / &ОбъемСредств * 100 КАК ДоляСредств,
		|	&МаксДоляСредств КАК МаксДоляСредств,
		|	ВЫБОР
		|		КОГДА СУММА(_Активы.СуммаВВалютеУчета) / &ОбъемСредств * 100 > &МаксДоляСредств
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Нарушение
		|ИЗ
		|	_Активы КАК _Активы
		|ГДЕ
		|	&ОбъемСредств > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Нарушение УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Активы.Актив КАК Актив,
		|	_Активы.СуммаВВалютеУчета КАК СуммаВВалютеУчета
		|ИЗ
		|	_Активы КАК _Активы";
	
	ЗаполнитьПарамерыВЗапросеНаСервере(Запрос); 	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Объект.Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);   

	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Показатели     = ПакетРезультатов[ПакетРезультатов.Количество() - 2].Выгрузить();
	Расшифровка    = ПакетРезультатов[ПакетРезультатов.Количество() - 1].Выгрузить();
	Сумма 		   = 0;
	База 		   = 0;
	Показатель 	   = 0;	
	
	Если Показатели.Количество() > 0 Тогда
		
		// если хотя по одному эмитенту зафиксировано нарушение -- есть общее нарушение
		Если Показатели[0].Нарушение Тогда
			СтатусПроверки = 2;
		КонецЕсли;
		Если Запрос.Параметры.Свойство("Заголовок") Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели,  Запрос.Параметры.Заголовок);
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Доля прочего актива");
		КонецЕсли;
		
		Сумма 		= Показатели[0].СуммаВВалютеУчета;
		База  		= Показатели[0].ОбъемСредств;
		Показатель	= Показатели[0].ДоляСредств;
		
	КонецЕсли;
    	
	Если СтатусПроверки = 1 И Запрос.Параметры.ОбъемСредств = 0 и Расшифровка.Количество() > 0 Тогда
			ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "Внимание! Объем средств = 0, возможны неправильные данные в представляемых показателях.";
			СтатусПроверки =3;

	КонецЕсли;
	
	
	Если Расшифровка.Количество() = 0 Тогда
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + "В распределении на выбранную дату отсутствуют активы указанного типа";
	Иначе
		ОтчетВФорматеHTML = ОтчетВФорматеHTML  + Символы.ПС + Символы.ПС + ТаблицаВФорматеHTML(Расшифровка, "Расшифровка показателя");
		
	КонецЕсли;

	
	ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, Сумма, База, Показатель);

	
