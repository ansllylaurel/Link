&НаСервере
Процедура ИспользованиеПаевЗакрытыхПаевыхФондовНаСервере() 
	
	ОтчетВФорматеHTML = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	  	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Эмитент КАК Эмитент,
	  	|	РаспределенныеАктивыСтраховойКомпании.Актив КАК Актив,
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок КАК Рынок
	  	|ПОМЕСТИТЬ _СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|ИЗ
	  	|	&РаспределенныеАктивыСтраховойКомпании КАК РаспределенныеАктивыСтраховойКомпании
	  	|ГДЕ
	  	|	РаспределенныеАктивыСтраховойКомпании.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
	  	|	И РаспределенныеАктивыСтраховойКомпании.ВидПортфеляСтраховойКомпании В(&ВидыПортфелей)
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Эмитент КАК Эмитент,
	  	|	СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Актив,
	  	|	РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	РасчетныеЦеныПаевСрезПоследних.КоличествоПаев КАК КоличествоПаев,
	  	|	ЕСТЬNULL(РасчетныеЦеныПаевСрезПоследних.РасчетнаяЦена * РасчетныеЦеныПаевСрезПоследних.КоличествоПаев, 0) КАК СЧА,
	  	|	Паи.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
	  	|ПОМЕСТИТЬ _СчаПаевОткрытыхИИнтервальныхФондов
	  	|ИЗ
	  	|	_СтоимостьЦенныхБумагСтраховыхКомпаний КАК СтоимостьЦенныхБумагСтраховыхКомпаний
	  	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
	  	|		ПО ((ВЫРАЗИТЬ(СтоимостьЦенныхБумагСтраховыхКомпаний.Актив КАК Справочник.Паи)) = Паи.Ссылка)
	  	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетныеЦеныПаев.СрезПоследних КАК РасчетныеЦеныПаевСрезПоследних
	  	|		ПО СтоимостьЦенныхБумагСтраховыхКомпаний.Актив = РасчетныеЦеныПаевСрезПоследних.ЦеннаяБумага
	  	|ГДЕ
	  	|	Паи.ПаевойИнвестиционныйФонд.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный)
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Эмитент КАК Эмитент,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.ПаевойИнвестиционныйФонд КАК ПИФ,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.Актив КАК Актив,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.РасчетнаяЦена КАК РасчетнаяЦена,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.КоличествоПаев КАК КоличествоПаев,
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов.СЧА КАК СЧА
	  	|ИЗ
	  	|	_СчаПаевОткрытыхИИнтервальныхФондов КАК _СчаПаевОткрытыхИИнтервальныхФондов"  ;
		ЗаполнитьПарамерыВЗапросеНаСервере(Запрос);
		СтатусПроверки = 1;
				
		Показатели = Запрос.Выполнить().Выгрузить();
				
		Если Показатели.Количество() > 0 Тогда  			
			СтатусПроверки = 2;		
			ОтчетВФорматеHTML = "Запрещено инвестирование в паи закрытых паевых инвестиционных фондов" + Символы.ПС + Символы.ПС;
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + ТаблицаВФорматеHTML(Показатели, "Инвестирование в паи закрытых ПИФов")  + Символы.ПС 
			 + Символы.ПС;
		Иначе
			ОтчетВФорматеHTML = ОтчетВФорматеHTML + Символы.ПС + "В распределении отсутствуют паи закрытых паевых фондов";
		КонецЕсли; 				
		ЗарегистрироватьРезультатПроверкиНаСервере(ЭтаФорма.КлючТекущейПроверки, СтатусПроверки, ОтчетВФорматеHTML, 0, 0, 0);     		
	
