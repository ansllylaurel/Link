	               |	ВЫБОР
	               |		КОГДА _ДействующиеСопоставленияРейтингов.СтрокаСопоставления = 5
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОблигацииСДатойВыпускаДо1307,	               
				   |	ВЫБОР
	               |		КОГДА _ДействующиеСопоставленияРейтингов.СтрокаСопоставления = 6
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ДолиПерестраховщиков,
	               |	ВЫБОР
	               |		КОГДА _ДействующиеСопоставленияРейтингов.Источник = &ИсточникРезиденты
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК РезидентРФ
	               |ИЗ
	               |	_ДействующиеЗначенияРейтингов КАК _ДействующиеЗначенияРейтингов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(,Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	               |		ПО _ДействующиеЗначенияРейтингов.Субъект = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДействующиеСопоставленияРейтингов КАК _ДействующиеСопоставленияРейтингов
	               |		ПО (ЕСТЬNULL(_ДействующиеСопоставленияРейтингов.ОтборПоЭталоннойШкале, ЛОЖЬ) = ИСТИНА
	               |					И _ДействующиеСопоставленияРейтингов.ШкалаРейтингаЭталонная = _ДействующиеЗначенияРейтингов.Шкала
	               |				ИЛИ ЕСТЬNULL(_ДействующиеСопоставленияРейтингов.ОтборПоЭталоннойШкале, ЛОЖЬ) = ЛОЖЬ
	               |					И _ДействующиеЗначенияРейтингов.Агрегатор = _ДействующиеСопоставленияРейтингов.Агрегатор
	               |					И _ДействующиеЗначенияРейтингов.Шкала.ВидРейтинга = _ДействующиеСопоставленияРейтингов.ВидРейтинга
	               |					И _ДействующиеСопоставленияРейтингов.ТипШкалы = _ДействующиеЗначенияРейтингов.Шкала.ТипШкалы
	               |					И _ДействующиеСопоставленияРейтингов.Срок = _ДействующиеЗначенияРейтингов.Шкала.Срок
	               |					И _ДействующиеСопоставленияРейтингов.РейтинговоеАгенство = _ДействующиеЗначенияРейтингов.РейтинговоеАгентство
	               |					И ВЫБОР
	               |						КОГДА _ДействующиеЗначенияРейтингов.Субъект ССЫЛКА Справочник.ЮрФизЛица
	               |							ТОГДА ВЫБОР
	               |									КОГДА РеквизитыЮридическихЛицСрезПоследних.РезидентРФ
	               |										ТОГДА _ДействующиеСопоставленияРейтингов.Источник = &ИсточникРезиденты
	               |									ИНАЧЕ _ДействующиеСопоставленияРейтингов.Источник = &ИсточникНеРезиденты
	               |								КОНЕЦ
	               |						ИНАЧЕ _ДействующиеСопоставленияРейтингов.Источник = &ИсточникРезиденты
	               |					КОНЕЦ
	               |					И ВЫБОР
	               |						КОГДА _ДействующиеЗначенияРейтингов.Субъект ССЫЛКА Справочник.Облигации
	               |							ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(_ДействующиеЗначенияРейтингов.Субъект КАК Справочник.Облигации).Субординированность, ЛОЖЬ) = (_ДействующиеСопоставленияРейтингов.СтрокаСопоставления = 3)
	               |						ИНАЧЕ ИСТИНА
	               |					КОНЕЦ)
	               |ГДЕ
	               |	_ДействующиеСопоставленияРейтингов.Активно = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Субъект,
	               |	СтрокаСопоставления";
	Запрос.УстановитьПараметр("Период",Объект.Период);
	Запрос.УстановитьПараметр("ИсточникРезиденты", Справочники.ВнешниеСистемы.ПереченьЦБ_РФДляРезидентов);	
	Запрос.УстановитьПараметр("ИсточникНеРезиденты", Справочники.ВнешниеСистемы.ПереченьЦБ_РФДляНерезидентов); 

	ВсеРейтинги = Запрос.Выполнить().Выгрузить();
	
	
	// сохранение
	СправочныеПоказателиНаСервере.Вставить("ДефолтныеРейтинги", ДефолтныеРейтинги);
	СправочныеПоказателиНаСервере.Вставить("ВсеРейтинги", ВсеРейтинги);  	
	
	
	
	ЭтаФорма.СправочныеПоказатели = Новый ХранилищеЗначения(СправочныеПоказателиНаСервере);

КонецПроцедуры // ЗаполнитьСправочныеПоказателиНаСервере

#Область Автоматическое_Распределение

&НаСервере
Процедура ЗаполнитьСправочныеПоказателиДляАвтоРаспределенияНаСервере()
	
	СправочныеПоказателиНаСервере = Новый Структура();
	СправочныеПоказателиНаСервере.Вставить("УровеньВнесписочногоРейтинга", 1);
	СправочныеПоказателиНаСервере.Вставить("ИсточникБиржевыхКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);	
	СправочныеПоказателиНаСервере.Вставить("ТребуемыйЛистингРезидентаРФ",                                         3);     //изменено с 1 на 3. Задача 1Ф  505841
	СправочныеПоказателиНаСервере.Вставить("МаксДоляАктивовНеНаходящихсяНаТерриторииРФВОбъемеСтраховыхРезервов",  30);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляДепозитныхАктивовОдногоБанкаВОбъемеСтраховыхРезервов",        25);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляДепозитныхАктивовВОбъемеСтраховыхРезервов",                   60);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляИнвестиционныхПаевВОбъемеРезервовПоСтрахованиюЖизни",         15);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляИнвестиционныхПаевВОбъемеРезервовПоСтрахованиюИномуЧемЖизни", 10);
	
	Активы  = Объект.РаспределяемыеАктивы.Выгрузить();
	
	Запрос = Новый Запрос();
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Субъект КАК Субъект,
		|	РейтингиСрезПоследних.Шкала КАК Шкала,
		|	РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	РейтингиСрезПоследних.Агрегатор КАК Агрегатор,
		|	РейтингиСрезПоследних.Рейтинг КАК Рейтинг,
		|	РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|	РейтингиСрезПоследних.УровеньРейтинга КАК УровеньРейтинга,
		|	СопоставлениеРейтинговыхШкалСрезПоследних.ЗначениеМаксимальное КАК ЗначениеМаксимальное
		|ПОМЕСТИТЬ _РейтингиДействующиеНаМоментНачалаОтбора
		|ИЗ
		|	(ВЫБРАТЬ
		|		РейтингиСрезПоследних.Субъект КАК Субъект,
		|		РейтингиСрезПоследних.Шкала КАК Шкала,
		|		РейтингиСрезПоследних.Агрегатор КАК Агрегатор,
		|		РейтингиСрезПоследних.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|		РейтингиСрезПоследних.Рейтинг КАК Рейтинг,
		|		РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга,
		|		РейтингиСрезПоследних.УровеньРейтинга КАК УровеньРейтинга
		|	ИЗ
		|		РегистрСведений.Рейтинги.СрезПоследних(&ПериодНачалаОтбора, ) КАК РейтингиСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЗначенияРейтингов КАК ЗначенияРейтингов
		|			ПО РейтингиСрезПоследних.РейтинговоеАгентство = ЗначенияРейтингов.Владелец.Владелец
		|				И РейтингиСрезПоследних.Шкала = ЗначенияРейтингов.Владелец
