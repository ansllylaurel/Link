	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Объем резервов по страхованию иному, чем жизни: " + Формат(РасчетныеПоказателиНаСервере.ОбъемРезервовПоСтрахованиюИномуЧемЖизни, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Объем собственных средств в размере норматива: " + Формат(РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствВРазмереНорматива, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Объем собственных средств сверх норматива: " + Формат(РасчетныеПоказателиНаСервере.ОбъемСобственныхСредствСверхНорматива, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<hr>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>Стабилизационный резерв: " + Формат(РасчетныеПоказателиНаСервере.СтабилизационныйРезерв, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
	ДокументHTML = ДокументHTML + Символы.ПС + "<h3>ДЗ страховщиков по прямому возмещению убытков: " + Формат(РасчетныеПоказателиНаСервере.СуммаДебиторскойЗадолженности, "ЧДЦ=2") + " " + РасчетныеПоказателиНаСервере.ВалютаУчета + "</h3>";
	
	
	ДокументHTML = ДокументHTML + Символы.ПС + ТаблицаВФорматеHTML(РасчетныеПоказателиНаСервере.РаспределенныеАктивыСтраховойКомпании, "Стоимость активов страховой компании");
	
	Возврат ДокументHTML;
	
КонецФункции // РасчетныеПоказателиВФорматеHTMLНаСервере

&НаСервере
Процедура ЗаполнитьСправочныеПоказателиНаСервере()
	

	СправочныеПоказателиНаСервере = Новый Структура();
	СправочныеПоказателиНаСервере.Вставить("УровеньВнесписочногоРейтинга", 1);
	СправочныеПоказателиНаСервере.Вставить("ИсточникБиржевыхКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);	
	СправочныеПоказателиНаСервере.Вставить("ТребуемыйЛистингРезидентаРФ",                                         3);  //изменено с 1 на 3. Задача 1Ф  505841
	СправочныеПоказателиНаСервере.Вставить("МаксДоляАктивовНеНаходящихсяНаТерриторииРФВОбъемеСтраховыхРезервов",  30);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляДепозитныхАктивовОдногоБанкаВОбъемеСтраховыхРезервов",        25);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляДепозитныхАктивовВОбъемеСтраховыхРезервов",                   60);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляИнвестиционныхПаевВОбъемеРезервовПоСтрахованиюЖизни",         15);
	СправочныеПоказателиНаСервере.Вставить("МаксДоляИнвестиционныхПаевВОбъемеРезервовПоСтрахованиюИномуЧемЖизни", 10);
	
	Запрос = Новый Запрос();
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	РейтингиСрезПоследних.Субъект,
