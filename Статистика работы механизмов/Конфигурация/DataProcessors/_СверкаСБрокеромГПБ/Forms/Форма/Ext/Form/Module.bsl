						ДокОплата.Комментарий = "Создан аппаратно-техническими средствами " + ТекущаяДата();
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(ДокОплата.Основания.Добавить(), СтрокаОплатыБрокерскойКомиссии);
		
