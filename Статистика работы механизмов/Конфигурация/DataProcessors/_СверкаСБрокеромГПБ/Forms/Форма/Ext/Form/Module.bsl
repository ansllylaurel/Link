				ЗадолженностиПоСделкам.Добавить(СтрокаЗадолженностиПоСделке);
				
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	
	Операции.Сделки = Сделки;
	Операции.ЗадолженностиПоСделкам = ЗадолженностиПоСделкам;
	
	Возврат Операции;
		
