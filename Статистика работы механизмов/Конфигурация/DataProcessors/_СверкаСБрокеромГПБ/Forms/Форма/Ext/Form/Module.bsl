							ДокОплата.Основания[СтрокаОплатыБрокерскойКомиссии.НомерСтроки - 1].Сумма = СтрокаОплатыБрокерскойКомиссии.Сумма;
							ДокОплата.Основания[СтрокаОплатыБрокерскойКомиссии.НомерСтроки - 1].СуммаОплаты = СтрокаОплатыБрокерскойКомиссии.СуммаОплаты;
							
