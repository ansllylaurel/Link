		Заголовки.Вставить("КомиссияБрокера", "Брокерская комиссия");
		Заголовки.Вставить("ДатаИсполнения", "Дата исполнения");
		Заголовки.Вставить("ОтложенноеИсполнение", "Отложенное исполнение");
		
		Заголовки.Вставить("СуммаЗадолженностиПоСделке", "По сделке");
		Заголовки.Вставить("СуммаЗадолженностиПоКупону", "Купон");
		Заголовки.Вставить("КоличествоЗадолженностиПоБумагам", "Бумаги (количество)");
		Заголовки.Вставить("СуммаЗадолженностиПоТорговойКомиссии", "По торговой комиссии");
		Заголовки.Вставить("СуммаЗадолженностиПоБрокерскойКомиссии", "По брокерской комиссии");

		ДанныеДляСверки = Новый Структура;
		ДанныеДляСверки.Вставить("ЗаголовокОтчета", "Сверка с отчетом брокера ГПБ");
		ДанныеДляСверки.Вставить("ПараметрыОтчета", ПараметрыОтчета);
		ДанныеДляСверки.Вставить("НаборыДанных", НаборыДанных);
		ДанныеДляСверки.Вставить("Заголовки", Заголовки);
		
		Отчет = Новый ТабличныйДокумент;
		
		ЕстьРасхожденияПоНаборамДанных = Неопределено;
		Расхождения = РаботаСОтчетами.ЗаполнитьОтчетОРасхожденияхНаборовДанных(ДанныеДляСверки, Отчет, ЕстьРасхожденияПоНаборамДанных, Истина);
		
		МассивОтчетовСверки.Добавить(Новый Структура("ИмяФайла, СчетДоверительногоУправления, ЕстьРасхожденияПоНаборамДанных, Отчет", ЭлементДанныеОтчета.ПараметрыОтчета.ИмяФайла, ПараметрыОтчета.СчетДоверительногоУправления, ЕстьРасхожденияПоНаборамДанных, Отчет));
		
		Если ОбщиеПараметры.ФиксироватьРезультатСверки Тогда
			
			#Область Добавление_результата_сверки_с_файлом
			
			// сверка успешна, если нет расхождений по д/с

			ОтсутствуютРасхождения	= Не ЕстьРасхожденияПоНаборамДанных;
			СверкаПройденаУспешно	= ОтсутствуютРасхождения;
			Примечание				= "";

			Если ЗначениеЗаполнено(Расхождения) Тогда
				
				НаборыДанных = Новый Соответствие;
				
				// Получим уникальную структуру расхождений по "Набор данных + Поле"
				
				Для Каждого СтрокаРасхождения Из Расхождения Цикл
					ЗаголовокНабораДанных = СтрокаРасхождения.НаборДанных.Заголовок;
					
					НаборДанных = НаборыДанных.Получить(ЗаголовокНабораДанных);
					Если НаборДанных = Неопределено Тогда
						НаборыДанных.Вставить(ЗаголовокНабораДанных, Новый Соответствие);
						НаборДанных = НаборыДанных.Получить(ЗаголовокНабораДанных);
					КонецЕсли;
					
					ПолеРасхождения = НаборДанных.Получить(СтрокаРасхождения.ЗаголовокПоля);
					Если ПолеРасхождения = Неопределено Тогда
						НаборДанных.Вставить(СтрокаРасхождения.ЗаголовокПоля, СтрокаРасхождения.ЗаголовокПоля);
					КонецЕсли;
				КонецЦикла;
				
				СверкаПройденаУспешно = (НаборыДанных.Получить("Остатки денежных средств") = Неопределено);
				
				Если Не СверкаПройденаУспешно Тогда
					
					НаборДанных = НаборыДанных.Получить("Остатки денежных средств");
					
					Если ВалютаРубли = Неопределено Тогда
						ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
					КонецЕсли;
					
					Примечание = СтрШаблон("Расхождения по остаткам денежных средств %1(", ?(ПараметрыОтчета.ВалютаРасчетов = ВалютаРубли, "", Строка(ПараметрыОтчета.ВалютаРасчетов) + " "));
					Для Каждого ПолеРасхождения Из НаборДанных Цикл
						Примечание = Примечание + ПолеРасхождения.Ключ + ", ";
					КонецЦикла;
					Примечание = Лев(Примечание, СтрДлина(Примечание) - 2) + ")";
					
				КонецЕсли;
				
			КонецЕсли;	

			// Запоминаем результаты сверки
		
			Если ТаблицаСверки = Неопределено Тогда	
				
				ТаблицаСверки = Новый ТаблицаЗначений;
				ТаблицаСверки.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
				ТаблицаСверки.Колонки.Добавить("СверкаПройденаУспешно",			Новый ОписаниеТипов("Булево"));
				ТаблицаСверки.Колонки.Добавить("ОтсутствуютРасхождения",		Новый ОписаниеТипов("Булево"));
				ТаблицаСверки.Колонки.Добавить("Примечание",					Новый ОписаниеТипов("Строка"));
				
			КонецЕсли;
			
			СтрокаСверки = ТаблицаСверки.Добавить();
			СтрокаСверки.СчетДоверительногоУправления	= ПараметрыОтчета.СчетДоверительногоУправления;
			СтрокаСверки.СверкаПройденаУспешно			= СверкаПройденаУспешно;
			СтрокаСверки.ОтсутствуютРасхождения			= ОтсутствуютРасхождения;
			СтрокаСверки.Примечание						= Примечание;

			#КонецОбласти
			
		КонецЕсли;

	КонецЦикла;
	
	РезультатВыполнения.Вставить("МассивОтчетовСверки", МассивОтчетовСверки);
	
	Если ОбщиеПараметры.ФиксироватьРезультатСверки И ТаблицаСверки <> Неопределено Тогда

		// Соберем всю информацию по результатам сверки.
		// Если есть расхождения или время сверки раньше времени внесения,
		// сначала спросим у пользователя перед фиксацией
		
		РезультатыСверки = Новый Структура("НепрошедшиеСверку, ИмеющиеРасхождения, ИмеющиеОперацииПозжеВремениСверки", Новый Массив, Новый Массив, Новый Массив);
	
		#Область Итог_сверки_по_счетам_внутреннего_учета
		
		ИтоговаяТаблицаСверки = ТаблицаСверки.СкопироватьКолонки();
		ИтоговаяТаблицаСверки.Колонки.Добавить("НеподтвержденныеОперации",						Новый ОписаниеТипов("ТаблицаЗначений"));
		ИтоговаяТаблицаСверки.Колонки.Добавить("НеподтвержденныеОперацииПозжеВремениСверки",	Новый ОписаниеТипов("ТаблицаЗначений"));
		
		МВТ = Новый МенеджерВременныхТаблиц;
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСверки, "_ТаблицаСверки", МВТ);
		
		ВыборкаПоТаблицеСверки = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(МВТ, "_ТаблицаСверки", , , , , "СчетДоверительногоУправления", "МИНИМУМ(СверкаПройденаУспешно), МИНИМУМ(ОтсутствуютРасхождения)").Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоТаблицеСверки.Следующий() Цикл
			
			СтрокаСверки = ИтоговаяТаблицаСверки.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаСверки, ВыборкаПоТаблицеСверки, , "Примечание");
				
			// При отсутствии расхождений с файлами получаем неподтвержденные операции,
			// а при наличии - отображаем их в примечании
			
			Если СтрокаСверки.ОтсутствуютРасхождения Тогда 
				
				СтрокаСверки.НеподтвержденныеОперации					= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьНеподтвержденныеОперацииСБрокером(ОбщиеПараметры.Организация, СтрокаСверки.СчетДоверительногоУправления, ОбщиеПараметры.Брокер, ОбщиеПараметры.ДатаСверки, КонецДня(ОбщиеПараметры.ДатаСверки), Истина);
				СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки	= РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ОперацииВнесенныеПозднее(СтрокаСверки.НеподтвержденныеОперации, ОбщиеПараметры.ВремяСверки); 
				
			Иначе
				
				Примечания = Новый Массив;
				
				ВыборкаПоПримечанию = ВыборкаПоТаблицеСверки.Выбрать();
				Пока ВыборкаПоПримечанию.Следующий() И Не ПустаяСтрока(ВыборкаПоПримечанию.Примечание) Цикл
					Примечания.Добавить(ВыборкаПоПримечанию.Примечание); 	
				КонецЦикла;

				СтрокаСверки.Примечание = СтрСоединить(Примечания, "; ");
				
			КонецЕсли;	
			
			Если Не СтрокаСверки.СверкаПройденаУспешно Тогда
				РезультатыСверки.НепрошедшиеСверку.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;

			Если Не СтрокаСверки.ОтсутствуютРасхождения Тогда
				РезультатыСверки.ИмеющиеРасхождения.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;

			Если СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки.Количество() > 0 Тогда
				РезультатыСверки.ИмеющиеОперацииПозжеВремениСверки.Добавить(СтрокаСверки.СчетДоверительногоУправления);
			КонецЕсли;
		
		КонецЦикла;
		
		РезультатыСверки.Вставить("ТаблицаСверки", ПоместитьВоВременноеХранилище(ИтоговаяТаблицаСверки, ОбщиеПараметры.УникальныйИдентификаторФормы));		
		
		#КонецОбласти
		
		РезультатВыполнения.Вставить("РезультатыСверки", РезультатыСверки);
	
	КонецЕсли;
	
	#КонецОбласти

	#Область Счета_ДУ_без_отчета_брокера

	ПараметрыОтчетаОтсутствующихФайловБрокера = Новый Структура("Организация, Брокер, СверяемыеСчетаДоверительногоУправления, НачалоПериодаОтчета, КонецПериодаОтчета", ОбщиеПараметры.Организация, ОбщиеПараметры.Брокер, ОбщиеПараметры.СверяемыеСчетаДоверительногоУправления, НачалоДня(ОбщиеПараметры.ДатаСверки), КонецДня(ОбщиеПараметры.ДатаСверки));
	
	ОтчетОтсутствующихФайловБрокера = ПолучитьОтчетОтсутствующихФайловБрокера(ПараметрыОтчетаОтсутствующихФайловБрокера);

	РезультатВыполнения.Вставить("ОтчетОтсутствующихФайловБрокера", ОтчетОтсутствующихФайловБрокера);
	
	#КонецОбласти

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии("Сверка с брокером ГПБ. (СверитьДанныеОтчетовБрокера)", Сессия);

	Возврат РезультатВыполнения;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИмпортироватьКомиссиюБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры, ИзмененияНачисленийЗадолженности, ИзмененияОплат)
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбщиеПараметры, "Организация, Брокер, ДатаСверки, ВремяСверки, ФиксироватьРезультатСверки");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		"Сверка с брокером ГПБ. (ИмпортироватьКомиссиюБрокера)",
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	СтруктураТаблицыКомиссииБрокера = ПолучитьСтруктуруТаблицы("КомиссияБрокера");
	ТаблицаДанных = Неопределено;
		
	Для Каждого ЭлементДанныеОтчета Из ДанныеОтчетовБрокера Цикл
		
		Если ЭлементДанныеОтчета.Операции <> Неопределено И ЭлементДанныеОтчета.Операции.Свойство("Сделки") Тогда  
		
			ДанныеОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(СтруктураТаблицыКомиссииБрокера, ЭлементДанныеОтчета.Операции.Сделки, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если ТаблицаДанных = Неопределено Тогда
				ТаблицаДанных = ДанныеОтчета;  	
		    Иначе 
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеОтчета, ТаблицаДанных);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаДанных <> Неопределено И ТаблицаДанных.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	#Область ТЕКСТ_ЗАПРОСА
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДанных.ИмяФайла КАК ИмяФайла,
			|	ТаблицаДанных.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
			|	ТаблицаДанных.ИмяЗаписи КАК ИмяЗаписи,
			|	ТаблицаДанных.ДатаСделки КАК ДатаСделки,
			|	ТаблицаДанных.НомерСделки КАК НомерСделки,
			|	ТаблицаДанных.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
			|	ТаблицаДанных.ВидСделки КАК ВидСделки,
			|	ТаблицаДанных.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
			|	ТаблицаДанных.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	ТаблицаДанных.ИмяМестаХранения КАК ИмяМестаХранения,
			|	ТаблицаДанных.ИмяВалютыРасчетов КАК ИмяВалютыРасчетов,
			|	ТаблицаДанных.КомиссияБрокера КАК Сумма,
			|	ТаблицаДанных.ДатаОплатыКомиссии КАК ДатаОплаты
			|ПОМЕСТИТЬ _ТаблицаДанных
			|ИЗ
			|	&ТаблицаДанных КАК ТаблицаДанных
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаДанных.ИмяФайла КАК ИмяФайла,
			|	_ТаблицаДанных.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
			|	_ТаблицаДанных.ИмяЗаписи КАК ИмяЗаписи,
			|	_ТаблицаДанных.ДатаСделки КАК ДатаСделки,
			|	_ТаблицаДанных.НомерСделки КАК НомерСделки,
			|	_ТаблицаДанных.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
			|	_ТаблицаДанных.ВидСделки КАК ВидСделки,
			|	_ТаблицаДанных.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
			|	_ТаблицаДанных.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	_ТаблицаДанных.ИмяМестаХранения КАК ИмяМестаХранения,
			|	_ТаблицаДанных.ИмяВалютыРасчетов КАК ИмяВалютыРасчетов,
			|	_ТаблицаДанных.Сумма КАК Сумма,
			|	_ТаблицаДанных.ДатаОплаты КАК ДатаОплаты
			|ПОМЕСТИТЬ _ДанныеФайлов
			|ИЗ
			|	_ТаблицаДанных КАК _ТаблицаДанных
			|ГДЕ
			|	_ТаблицаДанных.ЧастьСделкиРЕПО В (0, 1)
			|	И _ТаблицаДанных.Сумма > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Акции.Ссылка КАК Ссылка,
			|	Акции.ГосударственныйРегистрационныйНомер КАК ГосРегНомер
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	Справочник.Акции КАК Акции
			|ГДЕ
			|	Акции.ГосударственныйРегистрационныйНомер В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Данные.КодЦеннойБумаги
			|			ИЗ
			|				_ДанныеФайлов КАК _Данные)
			|	И Акции.ПометкаУдаления = ЛОЖЬ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Облигации.Ссылка,
			|	Облигации.ГосударственныйРегистрационныйНомер
			|ИЗ
			|	Справочник.Облигации КАК Облигации
			|ГДЕ
			|	Облигации.ГосударственныйРегистрационныйНомер В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Данные.КодЦеннойБумаги
			|			ИЗ
			|				_ДанныеФайлов КАК _Данные)
			|	И Облигации.ПометкаУдаления = ЛОЖЬ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Паи.Ссылка,
			|	Паи.ГосударственныйРегистрационныйНомер
			|ИЗ
			|	Справочник.Паи КАК Паи
			|ГДЕ
			|	Паи.ГосударственныйРегистрационныйНомер В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Данные.КодЦеннойБумаги
			|			ИЗ
			|				_ДанныеФайлов КАК _Данные)
			|	И Паи.ПометкаУдаления = ЛОЖЬ
			|
