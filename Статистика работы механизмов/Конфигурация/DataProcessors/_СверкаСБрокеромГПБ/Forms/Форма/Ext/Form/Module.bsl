&НаСервереБезКонтекста
Функция ПреобразоватьМассивСтруктурВТаблицуЗначений(КолонкиТаблицы, СодержимоеТаблицы, Параметры = Неопределено)
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для каждого КлючЗнач Из КолонкиТаблицы Цикл
		ТаблицаЗначений.Колонки.Добавить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	
	Для каждого ЭлементСодержимоеТаблицы Из СодержимоеТаблицы Цикл
		
		НоваяСтрока = ТаблицаЗначений.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСодержимоеТаблицы);
		
		Если Параметры <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры);
		КонецЕсли;

	КонецЦикла;
		
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруТаблицы(ИмяТаблицы)
	
	СтруктураТаблицы = Новый Структура();
	
	СтруктураТаблицы.Вставить("ИмяФайла", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(275)));
	СтруктураТаблицы.Вставить("ИмяМестаХранения", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураТаблицы.Вставить("КодСчетаДоверительногоУправления", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	СтруктураТаблицы.Вставить("ИмяВалютыРасчетов", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	СтруктураТаблицы.Вставить("ИмяЗаписи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));

	Если ИмяТаблицы = "Сделки" Тогда
	
		СделкаМД = Метаданные.Документы.Сделка;
		
		СтруктураТаблицы.Вставить("НомерСделки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(16)));
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		СтруктураТаблицы.Вставить("БумагиКоличество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		
		СтруктураТаблицы.Вставить("СуммаСделки", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		СтруктураТаблицы.Вставить("Купон", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		СтруктураТаблицы.Вставить("КомиссияБрокера", Метаданные.ОпределяемыеТипы.СуммаКомиссии.Тип);
		СтруктураТаблицы.Вставить("ТорговаяКомиссия", Метаданные.ОпределяемыеТипы.СуммаКомиссии.Тип);
		СтруктураТаблицы.Вставить("ЧастьСделкиРЕПО", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(1)));
		
		СтруктураТаблицы.Вставить("СтавкаРЕПО", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 4)));
		СтруктураТаблицы.Вставить("ОтложенноеИсполнение", Новый ОписаниеТипов("Булево"));
		СтруктураТаблицы.Вставить("ДатаИсполнения", Новый ОписаниеТипов("Дата"));
			
	ИначеЕсли ИмяТаблицы = "ЗадолженностиПоСделкам" Тогда
		
		СделкаМД = Метаданные.Документы.Сделка;
	
		СтруктураТаблицы.Вставить("НомерСделки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(16)));
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоСделке", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоКупону", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("КоличествоЗадолженностиПоБумагам", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоТорговойКомиссии", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоБрокерскойКомиссии", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		
	ИначеЕсли ИмяТаблицы = "КомиссияБрокера" Тогда
		
		СделкаМД = Метаданные.Документы.Сделка;
		 
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("НомерСделки", СделкаМД.Реквизиты.НомерСделки.Тип);
		СтруктураТаблицы.Вставить("ЧастьСделкиРЕПО", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		
		СтруктураТаблицы.Вставить("ОтложенноеИсполнение", Новый ОписаниеТипов("Булево"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("КомиссияБрокера", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("ДатаОплатыКомиссии", Новый ОписаниеТипов("Дата"));
			
	ИначеЕсли ИмяТаблицы = "ОстаткиДенежныхСредств" Тогда
	
		РегистрМД = Метаданные.РегистрыНакопления.ОстаткиДенежныхСредств;
		
		СтруктураТаблицы.Вставить("СуммаНачальныйОстаток", РегистрМД.Ресурсы.Сумма.Тип);
		СтруктураТаблицы.Вставить("СуммаКонечныйОстаток", РегистрМД.Ресурсы.Сумма.Тип);
		
	ИначеЕсли ИмяТаблицы = "ОстаткиЦенныхБумаг" Тогда
		
		РегистрМД = Метаданные.РегистрыНакопления.ОстаткиЦенныхБумаг;
	
		СтруктураТаблицы.Вставить("НомерТорговогоРаздела", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("КоличествоНачальныйОстаток", РегистрМД.Ресурсы.Количество.Тип);
		СтруктураТаблицы.Вставить("КоличествоКонечныйОстаток", РегистрМД.Ресурсы.Количество.Тип);
		
	КонецЕсли;
	
	Возврат СтруктураТаблицы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
		
	Элементы = Форма.Элементы;
	
	Элементы.ГруппаСверкаНаДату.Видимость   = (Форма.РежимСверки = 0);
	Элементы.ГруппаСверкаЗаПериод.Видимость = (Форма.РежимСверки = 1);	
	
	Элементы.ВремяСверки.Доступность                           = Форма.ФиксироватьРезультатСверки;
	Элементы.ВыводитьОтчетОПодтвержденныхОперациях.Доступность = Форма.ФиксироватьРезультатСверки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКаталогДанных()
	
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаСверки) Тогда
		ПутьНорм = ПолучитьКаталогДанных(Объект.Организация, ЭтаФорма.ДатаСверки);
		Объект.КаталогДанных = ПутьНорм + ?(СтрЗаканчиваетсяНа(ПутьНорм, "\"), "", "\");
		КомандаОбновитьСписокФайлов(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКодЦеннойБумаги(Знач ЦеннаяБумагаТекст)
	
	// рег. номер ц/б содержится справа от последней запятой
	// например, "Обл. АИЖК А18, 4-18-00739-A"
	
	КодБумаги = СокрЛ(Сред(ЦеннаяБумагаТекст, СтрНайти(ЦеннаяБумагаТекст, ",", НаправлениеПоиска.СКонца) + 1));
	Если ПустаяСтрока(КодБумаги) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выделить рег. номер из описания ценной бумаги [" + ЦеннаяБумагаТекст + "].");
	КонецЕсли;
	
	// у этих редисок русские буквы в рег. номерах
	КодБумаги = СтрЗаменить(КодБумаги, "А", "A");
	КодБумаги = СтрЗаменить(КодБумаги, "В", "B");
	КодБумаги = СтрЗаменить(КодБумаги, "С", "C");
	КодБумаги = СтрЗаменить(КодБумаги, "Е", "E");
	КодБумаги = СтрЗаменить(КодБумаги, "К", "");
	КодБумаги = СтрЗаменить(КодБумаги, "Н", "H");
	КодБумаги = СтрЗаменить(КодБумаги, "М", "M");
	КодБумаги = СтрЗаменить(КодБумаги, "О", "O");
	КодБумаги = СтрЗаменить(КодБумаги, "Р", "P");
	КодБумаги = СтрЗаменить(КодБумаги, "Т", "T");
	КодБумаги = СтрЗаменить(КодБумаги, "Х", "X");
	
	Возврат КодБумаги;
		
КонецФункции

&НаКлиенте
Функция ПолучитьНомерСделки(НомерСделки)
	
	Если Найти(НомерСделки, "В") > 0 Тогда // т.к. иногда пишется "Сделка № 000 в режиме торгов (T0)"
		НомерСделки = СокрП(Лев(НомерСделки, Найти(НомерСделки, "В") - 1)); 
	КонецЕсли;
	
	Возврат НомерСделки;
	
КонецФункции

&НаКлиенте
Функция Подстрока(Знач СтрокаТекст, Знач ПозицияС = 1, Знач ПозицияПо = 0)
	
	Если ПозицияПо = 0 Тогда
		ПозицияПо = СтрДлина(СтрокаТекст);
	КонецЕсли;
	
	Возврат Сред(СтрокаТекст, ПозицияС, ПозицияПо - ПозицияС + 1);
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьВЧисло(Знач СтрокаЧисло, ОтрицательноеЗначение = 1, ЗаменятьЗапятые = Истина)
	
	Если ТипЗнч(СтрокаЧисло) = Тип("Число") Тогда	
		Возврат ОтрицательноеЗначение * СтрокаЧисло;	
	КонецЕсли;
	
	Если ЗаменятьЗапятые Тогда	
		Значение = СтрЗаменить(СтрокаЧисло, ",", "");
	Иначе
		Значение = СокрЛП(СтрокаЧисло);
	КонецЕсли;
	
	Значение = РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(Значение); 
	
	Если Значение = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось преобразовать в число значение [" + СтрокаЧисло + "].");
		Возврат Значение;
	Иначе
		Возврат ОтрицательноеЗначение * Значение;	
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ЗначениеБольшеНуля(Значение)
	
	ЧисловоеЗначение = ПреобразоватьВЧисло(Значение);
		
	Если ЧисловоеЗначение = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Операции сравнения больше-меньше недопустимы для значения [" + Значение + "].");
		Возврат Ложь;	
	Иначе	
		Возврат (ЧисловоеЗначение > 0);
	КонецЕсли;
		
КонецФункции 

&НаКлиенте
Функция НайтиПозицииРазделовОтчета(ТекстОтчета, ИмяФайла)
	
	КлючРазделаДенежныхСредств = ВРег("2. Информация по денежным средствам:");
	КлючРазделаЦенныхБумаг     = ВРег("3. Информация по ценным бумагам [2]:");
	КлючРазделаСделок          = ВРег("1. Cделки");
	
	ПозицияРазделаДенежныхСредств = 0;
	ПозицияРазделаЦенныхБумаг = 0;
	ПозицияРазделаСделок = 0;
	
	Для НомСтр = 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Найти(ТекСтрокаОтчета, КлючРазделаДенежныхСредств) = 1 Тогда
			
			Если ПозицияРазделаДенежныхСредств = 0 Тогда
				ПозицияРазделаДенежныхСредств = НомСтр;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: найдено более одной таблицы информации по денежным средствам.");
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли Найти(ТекСтрокаОтчета, КлючРазделаЦенныхБумаг) = 1 Тогда
			
			Если ПозицияРазделаЦенныхБумаг = 0 Тогда
				ПозицияРазделаЦенныхБумаг = НомСтр;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: найдено более одной таблицы информации по ценным бумагам.");
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли Найти(ТекСтрокаОтчета, КлючРазделаСделок) = 1 Тогда
			
			Если ПозицияРазделаСделок = 0 Тогда
				ПозицияРазделаСделок = НомСтр;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: найдено более одной таблицы сделок.");
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПозицияРазделаДенежныхСредств = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: не удалось найти таблицу информации по денежным средствам.");
		Возврат Неопределено;
	ИначеЕсли ПозицияРазделаЦенныхБумаг = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: не удалось найти таблицу информации по ценным бумагам.");
		Возврат Неопределено;
	ИначеЕсли ПозицияРазделаСделок = 0 Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла [" + ИмяФайла + "]: не удалось найти таблицу информации по сделкам.");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Сделки, ДенежныеСредства, ЦенныеБумаги", ПозицияРазделаСделок, ПозицияРазделаДенежныхСредств, ПозицияРазделаЦенныхБумаг);
	
КонецФункции

&НаКлиенте
Функция ПолучитьМаксЗначениеСчетчика(НомСтр, ПозицииРазделовОтчета, КоличествоСтрокОтчета)
	
	МаксЗначение = КоличествоСтрокОтчета;
	
	Для Каждого ПозицияРаздела Из ПозицииРазделовОтчета Цикл
		
		Если ПозицияРаздела.Значение > НомСтр И ПозицияРаздела.Значение < МаксЗначение Тогда
			МаксЗначение = ПозицияРаздела.Значение;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МаксЗначение;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьТаблицуОтчета(ТекстОтчета, МаксЗначениеСчетчика, ПозицияПервойСтрокиТаблицы)
	
	ЗначПолейТаблицы = Новый Массив;
	
	// Таблицы представлены в следующем виде:
	//		+—————————————————————————+—————————————————————————+—————————————————————————+—————————————————————————+
	//		|   Фактический остаток   |    Свободный остаток    |    Сумма требований     |   Сумма обязательств*   |
	//		+—————————————————————————+—————————————————————————+—————————————————————————+—————————————————————————+
	//		|            1            |            2            |            3            |            4            |
	//		+—————————————————————————+—————————————————————————+—————————————————————————+—————————————————————————+
	//		|            508,515.85   |              4,867.80   |                  0.00   |            503,648.05   |
	//		+—————————————————————————+—————————————————————————+—————————————————————————+—————————————————————————+
	
	ГраницыКолонок   = Новый Массив;
	ЗначПолейСтрокиТаблицы = Неопределено;
	
	НомСтр = ПозицияПервойСтрокиТаблицы;
	
	Пока НомСтр <= МаксЗначениеСчетчика Цикл
		СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Лев(СтрокаОтчета, 1) <> "+" И Лев(СтрокаОтчета, 1) <> "|" Тогда
			НомСтр = НомСтр - 1; //сразу может начинаться следующий раздел
			Прервать;
		КонецЕсли;
		
		// по 1-й строке определим границы колонок таблицы
		Если НомСтр = ПозицияПервойСтрокиТаблицы Тогда
			Для ПозСимв = 1 По СтрДлина(СтрокаОтчета) Цикл
				Если Сред(СтрокаОтчета, ПозСимв, 1) = "+" Тогда
					ГраницыКолонок.Добавить(ПозСимв);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Лев(СтрокаОтчета, 1) = "+" Тогда // началась новая строка таблицы
			Если ЗначПолейСтрокиТаблицы <> Неопределено Тогда
				ЗначПолейТаблицы.Добавить(ЗначПолейСтрокиТаблицы);
			КонецЕсли;
			
			ЗначПолейСтрокиТаблицы = Новый Массив;
			Для Инд = 1 По ГраницыКолонок.Количество() - 1 Цикл
				ЗначПолейСтрокиТаблицы.Добавить("");
			КонецЦикла;
			
		ИначеЕсли Лев(СтрокаОтчета, 1) = "|" Тогда
			Для Инд = 0 По ГраницыКолонок.Количество() - 2 Цикл
				ЗначПолейСтрокиТаблицы[Инд] = ЗначПолейСтрокиТаблицы[Инд] + СокрЛП(Подстрока(СтрокаОтчета, ГраницыКолонок[Инд] + 1, ГраницыКолонок[Инд + 1] - 1));
			КонецЦикла;
			
		КонецЕсли;	
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;
	
	ПозицияПервойСтрокиТаблицы = НомСтр; 
			
	Возврат ЗначПолейТаблицы;
	
КонецФункции
		
&НаКлиенте
Функция ДесериализоватьПараметрыОтчетаБрокераXLSX(ТабличныйДокументОтчета, ИмяФайла)
		
	СтруктураПараметров = Новый Структура("ИмяФайла, КодСчетаДоверительногоУправления, ИмяМестаХранения, ИмяВалютыРасчетов, ДатаОтчета, НачалоПериодаОтчета, КонецПериодаОтчета");
	
	НайденаДатаОтчета = Ложь;
	НайденаТорговаяПлощадка = Ложь;
	НайденКлиент = Ложь;
	НайденДоговор = Ложь;
	
	КоличествоСтрок = ТабличныйДокументОтчета.ВысотаТаблицы;
	
	Для ТекСтрока = 0 По КоличествоСтрок - 1 Цикл
		
		Для ТекКолонка = 0 По 10 Цикл
			Попытка
				ЗначениеЯчейки = СокрЛП(ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка).Текст);
			Исключение
				Продолжить;
			КонецПопытки;
			
			Если ЗначениеЯчейки = "" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не НайденаДатаОтчета И СтрНачинаетсяС(ЗначениеЯчейки, "за") Тогда
				СтрокаДаты = ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка + 1).Текст;
				СтруктураПараметров.НачалоПериодаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(СтрокаДаты);
				СтруктураПараметров.КонецПериодаОтчета = КонецДня(СтруктураПараметров.НачалоПериодаОтчета);
				НайденаДатаОтчета = Истина;
			КонецЕсли;
			
			Если СтрНачинаетсяС(ЗначениеЯчейки, "Дата составления отчёта:") Тогда
				Попытка
					ЗначениеДаты = СокрЛП(ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка + 2).Текст);
					СтруктураПараметров.ДатаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗначениеДаты);
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Если Не НайденаТорговаяПлощадка И СтрНачинаетсяС(ЗначениеЯчейки, "Торговая площадка:") Тогда
				Попытка
					ЗначениеПлощадки = СокрЛП(ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка + 1).Текст);
					Если ЗначениеПлощадки = "ПАО Московская Биржа" Тогда
						СтруктураПараметров.ИмяМестаХранения = "ММВБ-РТС";
					КонецЕсли;
					НайденаТорговаяПлощадка = Истина;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Если Не НайденКлиент И СтрНачинаетсяС(ЗначениеЯчейки, "Клиент:") Тогда
				Для Смещение = 1 По 3 Цикл
					Попытка
						ЗначениеКлиента = СокрЛП(ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка + Смещение).Текст);
						Если ЗначениеКлиента <> "" Тогда
							СтруктураПараметров.КодСчетаДоверительногоУправления = ЗначениеКлиента;
							НайденКлиент = Истина;
							Прервать;
						КонецЕсли;
					Исключение
						Продолжить;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			
			Если Не НайденДоговор И СтрНачинаетсяС(ЗначениеЯчейки, "Договор от") Тогда
				Для Смещение = 1 По 3 Цикл
					Попытка
						ЗначениеДоговора = СокрЛП(ТабличныйДокументОтчета.Область(ТекСтрока, ТекКолонка + Смещение).Текст);
						Если ЗначениеДоговора <> "" Тогда
							НайденДоговор = Истина;
							Прервать;
						КонецЕсли;
					Исключение
						Продолжить;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			
			Если ЗначениеЯчейки = "RUR" Тогда
				СтруктураПараметров.ИмяВалютыРасчетов = "RUB";
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	// Проверка обязательных параметров
	Если Не ЗначениеЗаполнено(СтруктураПараметров.НачалоПериодаОтчета) Или Не ЗначениеЗаполнено(СтруктураПараметров.КонецПериодаОтчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: не удалось определить период отчета [" + ИмяФайла + "].");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров.ДатаОтчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: не удалось определить дату отчета [" + ИмяФайла + "].");
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров.КодСчетаДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: не удалось определить код счета ДУ [" + ИмяФайла + "].");
		Возврат Неопределено;
	КонецЕсли;
	
	// Проверка соответствия даты отчета дате сверки
	Если СтруктураПараметров.НачалоПериодаОтчета <> ЭтаФорма.ДатаСверки Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата отчета [" + Формат(СтруктураПараметров.НачалоПериодаОтчета, "ДФ=dd.MM.yyyy") + "] не соответствует дате сверки [" + Формат(ЭтаФорма.ДатаСверки, "ДФ=dd.MM.yyyy") + "]. Файл [" + ИмяФайла + "].");
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПараметров.ИмяФайла = ИмяФайла;
	
	Возврат СтруктураПараметров;
	
КонецФункции

