&НаКлиенте
Функция ДесериализоватьОстаткиДенежныхСредствXLSX(ТабДок)
	
	ОстаткиДенежныхСредств = Новый Массив;
		
	СтрокаОстаткиДенежныхСредств = Новый Структура("СуммаНачальныйОстаток, СуммаКонечныйОстаток", 
		ПолучитьВходящиеОстатки(ТабДок), ПолучитьИсходящиеОстатки(ТабДок));
	
	ОстаткиДенежныхСредств.Добавить(СтрокаОстаткиДенежныхСредств);
	
	Если СтрокаОстаткиДенежныхСредств.СуммаНачальныйОстаток = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: отсутствует таблица Входящие остатки");
		Возврат Неопределено;
	ИначеЕсли СтрокаОстаткиДенежныхСредств.СуммаКонечныйОстаток = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: отсутствует таблица Исходящие остатки");
		Возврат Неопределено;
	КонецЕсли;
			
	Возврат ОстаткиДенежныхСредств;

КонецФункции

&НаКлиенте
Функция ПолучитьВходящиеОстатки(ТабличныйДокументОтчета)
    
    // Ищем блок "Входящие остатки"
    ОбластьЗаголовка = ТабличныйДокументОтчета.НайтиТекст("Входящие остатки*");

	Если ОбластьЗаголовка <> Неопределено Тогда
		ТекСтрока = ОбластьЗаголовка.Низ + 3; // Пропускаем заголовки
		Пока Истина Цикл
			Попытка
