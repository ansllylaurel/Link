	//		БИК 044525823
	//		ИНН/КПП 7744001497/997950001

	//		117420, г. Москва, ул. Наметкина, д. 16, корпус 1.
	//		Телефон: +7 (495) 719-17-63
	//		Факс: +7 (495) 913-73-19
	//		SWIFT: GAZPRUMM
	//		Телекс: 412027 GAZ RU
	//		www.gazprombank.ru
	//		ОТЧЕТ ПО СДЕЛКАМ И ОПЕРАЦИЯМ С ЦЕННЫМИ БУМАГАМИ, СОВЕРШЕННЫМ В ИНТЕРЕСАХ КЛИЕНТА В ТЕЧЕНИЕ ДНЯ
	//		за 26/07/2023
	//		Дата составления отчета 27/07/2023
	//		МЕСТО ЗАКЛЮЧЕНИЯ сделки: ПАО Московская Биржа (основной рынок)
	//		ИНВЕСТОР: 32727 Y6T+00000B98 АО "РЕГИОН ЭсМ" Д.У. средствами пенсионных резервов АО "Национальный НПФ"                                                                                                            
	//		ДОГОВОР № Г000-Б-32727 ОТ 04/04/2017
	//		Валюта расчетов RUR		
#КонецОбласти

	СтруктураПараметров = Новый Структура("ИмяФайла, КодСчетаДоверительногоУправления, ИмяМестаХранения, ИмяВалютыРасчетов, ДатаОтчета, НачалоПериодаОтчета, КонецПериодаОтчета");
	НомерСтрокиНаименованияОтчета = 0;	
		
	Для Инд = 2 По 100 Цикл
		
		Если ТекстОтчета.ПолучитьСтроку(Инд) = "ОТЧЕТ ПО СДЕЛКАМ И ОПЕРАЦИЯМ С ЦЕННЫМИ БУМАГАМИ, СОВЕРШЕННЫМ В ИНТЕРЕСАХ КЛИЕНТА В ТЕЧЕНИЕ ДНЯ" Тогда
			НомерСтрокиНаименованияОтчета = Инд;
			Прервать;
		КонецЕсли;	
			
	КонецЦикла;
	
	Если НомерСтрокиНаименованияОтчета = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: файл не является отчетом брокера [" + ИмяФайла + "].");
		Возврат Неопределено;
	КонецЕсли;
			
	// дата отчета
	КлючСтроки   = "ЗА";
	СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомерСтрокиНаименованияОтчета + 1);

	Если СтрНачинаетсяС(СтрокаОтчета, КлючСтроки) Тогда
		
		СтрокаОтчета = СтрЗаменить(СокрЛП(Сред(СтрокаОтчета, СтрДлина(КлючСтроки) + 1)), "/", ".");
		
		СтруктураПараметров.НачалоПериодаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(СтрокаОтчета);
		СтруктураПараметров.КонецПериодаОтчета  = КонецДня(СтруктураПараметров.НачалоПериодаОтчета);
		
		Если Не (ЗначениеЗаполнено(СтруктураПараметров.НачалоПериодаОтчета) И ЗначениеЗаполнено(СтруктураПараметров.КонецПериодаОтчета)) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: не удалось определить период отчета [" + ИмяФайла + "].");
			Возврат Неопределено;
			
		ИначеЕсли СтруктураПараметров.НачалоПериодаОтчета <> ЭтаФорма.ДатаСверки Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата отчета [" + Формат(СтруктураПараметров.НачалоПериодаОтчета, "ДФ=dd.MM.yyyy") + "] не соответствует дате сверки [" + Формат(ЭтаФорма.ДатаСверки, "ДФ=dd.MM.yyyy") + "]. Файл [" + ИмяФайла + "].");
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;

	// период отчета
	КлючСтроки   = "ДАТА СОСТАВЛЕНИЯ ОТЧЕТА";
	СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомерСтрокиНаименованияОтчета + 2);
		
	Если СтрНачинаетсяС(СтрокаОтчета, КлючСтроки) Тогда
		
		СтрокаОтчета = СтрЗаменить(СокрЛП(Сред(СтрокаОтчета, СтрДлина(КлючСтроки) + 1)), "/", ".");
		СтруктураПараметров.ДатаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(СтрокаОтчета);
		
		Если Не ЗначениеЗаполнено(СтруктураПараметров.ДатаОтчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: не удалось определить дату отчета [" + ИмяФайла + "].");
			Возврат Неопределено;
		КонецЕсли;

	КонецЕсли;

	// место хранения
	КлючСтроки   = "МЕСТО ЗАКЛЮЧЕНИЯ СДЕЛКИ:";
	СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомерСтрокиНаименованияОтчета + 3);
	
	Если СтрНачинаетсяС(СтрокаОтчета, КлючСтроки) Тогда
		
		СтрокаОтчета = СокрЛП(Сред(СтрокаОтчета, СтрДлина(КлючСтроки) + 1));
		Если СтрокаОтчета = "ПАО МОСКОВСКАЯ БИРЖА (ОСНОВНОЙ РЫНОК)" Тогда
			СтруктураПараметров.ИмяМестаХранения = "ММВБ-РТС";
		КонецЕсли;
		
	КонецЕсли;

	// счет д/у
	КлючСтроки   = "ИНВЕСТОР:";
	СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомерСтрокиНаименованияОтчета + 4);
	
	Если СтрНачинаетсяС(СтрокаОтчета, КлючСтроки) Тогда
		
		СтрокаОтчета = СокрЛП(Сред(СтрокаОтчета, СтрДлина(КлючСтроки) + 1));
		СтрокаОтчета = Лев(СтрокаОтчета, Найти(СтрокаОтчета, " ") - 1);
		
		СтруктураПараметров.КодСчетаДоверительногоУправления = СтрокаОтчета;
		
	КонецЕсли;	
	
	// валюта расчетов
	КлючСтроки   = "ВАЛЮТА РАСЧЕТОВ";
	СтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомерСтрокиНаименованияОтчета + 6);
		
	Если СтрНачинаетсяС(СтрокаОтчета, КлючСтроки) Тогда
		
		СтрокаОтчета = СокрЛП(Сред(СтрокаОтчета, СтрДлина(КлючСтроки) + 1));
		
		Если СтрокаОтчета = "RUR" Тогда
			СтруктураПараметров.ИмяВалютыРасчетов = "RUB";
		Иначе
			СтруктураПараметров.ИмяВалютыРасчетов = СтрокаОтчета;	
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураПараметров.ИмяФайла = ИмяФайла;
	
	Возврат СтруктураПараметров;
					
КонецФункции

&НаКлиенте
Функция ДесериализоватьДанныеОтчетовБрокераXLSX(КоличествоВыбранныхФайлов)
		
	МассивДанныхОтчетовБрокера = Новый Массив();
	Сверено = 0;
	
	Для Каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		
		Если Не СтрокаФайлыОтчетов.Выбран Тогда
			Продолжить;
		КонецЕсли;
		
		Состояние("1. Чтение файлов.", ?(КоличествоВыбранныхФайлов = 0, 0, Сверено * 100 / КоличествоВыбранныхФайлов));
		Сверено = Сверено + 1;
		
		Попытка
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(Объект.КаталогДанных + "\" + СтрокаФайлыОтчетов.ИмяФайла);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла: " + ОписаниеОшибки());
			СтрокаФайлыОтчетов.РезультатСверки = 3;
			Продолжить;
		КонецПопытки;
		
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
		ТабличныйДокументОтчета = ОбработатьТабличныйДокументОтчета(АдресФайла);
		
		Если ТабличныйДокументОтчета = Неопределено Тогда
			СтрокаФайлыОтчетов.РезультатСверки = 3;
			Продолжить;
		КонецЕсли;
		
		СтруктураДанныхОтчетаБрокера = Новый Структура("ПараметрыОтчета, ОстаткиДенежныхСредств, ОстаткиЦенныхБумаг, Операции");
		СтруктураДанныхОтчетаБрокера.ПараметрыОтчета = ДесериализоватьПараметрыОтчетаБрокераXLSX(ТабличныйДокументОтчета, СтрокаФайлыОтчетов.ИмяФайла);
		
		Если СтруктураДанныхОтчетаБрокера.ПараметрыОтчета = Неопределено Тогда
			СтрокаФайлыОтчетов.РезультатСверки = 3;
			Продолжить;	
		КонецЕсли;
		
		СтруктураДанныхОтчетаБрокера.ОстаткиДенежныхСредств = ДесериализоватьОстаткиДенежныхСредствXLSX(ТабличныйДокументОтчета); 
		СтруктураДанныхОтчетаБрокера.ОстаткиЦенныхБумаг = ДесериализоватьОстаткиЦенныхБумагXLSX(ТабличныйДокументОтчета);
		СтруктураДанныхОтчетаБрокера.Операции = ДесериализоватьСделкиИЗадолженностиПоСделкамXLSX(ТабличныйДокументОтчета);
		
		Если СтруктураДанныхОтчетаБрокера.ОстаткиДенежныхСредств = Неопределено Или СтруктураДанныхОтчетаБрокера.ОстаткиЦенныхБумаг = Неопределено Или СтруктураДанныхОтчетаБрокера.Операции = Неопределено Тогда
			СтрокаФайлыОтчетов.РезультатСверки = 3;
			Продолжить;
		КонецЕсли;
		
		МассивДанныхОтчетовБрокера.Добавить(СтруктураДанныхОтчетаБрокера);
		
	КонецЦикла;
	
	Возврат МассивДанныхОтчетовБрокера;
		
КонецФункции

