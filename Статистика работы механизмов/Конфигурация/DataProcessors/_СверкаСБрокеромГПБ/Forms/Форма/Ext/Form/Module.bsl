&НаКлиенте
Функция ОбработатьТекстОтчета(ИмяФайлОтчета)
	
	ПолноеИмяФайла = Объект.КаталогДанных + "\" + ИмяФайлОтчета;
		
	Файл = Новый Файл(ПолноеИмяФайла);
	
	Если Не Файл.Существует() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл [" + ИмяФайлОтчета + "] не найден. Возможно он был удален или перемещен", "ФайлОтчетаБрокера");
		Возврат Неопределено;                                        
		
	КонецЕсли;
	
	ТекстОтчета = Новый ТекстовыйДокумент;
	ТекстОтчета.ТолькоПросмотр       = Истина;
	ТекстОтчета.ИспользуемоеИмяФайла = ПолноеИмяФайла;
	ТекстОтчета.Прочитать(ПолноеИмяФайла);
		
	// первичная обработка текста отчета:
	//	- удалим пустые строки
	//	- удалим строки по шаблону " СТРАНИЦА [Х] ИЗ [Y]"
	//	- в оставшихся строках удалим краевые пробелы и преобразуем к верхнему регистру
	
	Для Инд = -ТекстОтчета.КоличествоСтрок() По -1 Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(-Инд);
		ТекСтрокаОтчета = СокрЛП(ВРег(ТекСтрокаОтчета));
		
		Если ПустаяСтрока(ТекСтрокаОтчета) Или (Найти(ТекСтрокаОтчета, "СТРАНИЦА") > 0 И Найти(ТекСтрокаОтчета, "ИЗ") > 0) Тогда
			ТекстОтчета.УдалитьСтроку(-Инд);
		Иначе
			ТекстОтчета.ЗаменитьСтроку(-Инд, ТекСтрокаОтчета);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстОтчета;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКодСчетаДоверительногоУправленияИзИмениФайла(Знач ИмяФайла)
	
	// Примеры файлов, которые мы обрабатываем:
	//		i02_28218_k_d_170418.txt
	//		i02_28218_k_d_170418_EUR.txt
	//		i02_28218_k_d_170418_USD.txt
	
	ИмяФайла = ВРег(ИмяФайла);
	Ключ1    = ВРег("i02_");
	Ключ2    = ВРег("_k_d");
	
	КодКлиента = Подстрока(ИмяФайла, Найти(ИмяФайла, Ключ1) + СтрДлина(Ключ1), Найти(ИмяФайла, Ключ2) - 1);
	
	Возврат КодКлиента;
		
КонецФункции

&НаКлиенте
Функция Проверить(ПараметрыПроверки) Экспорт
	
	ДатаСверки = ПараметрыПроверки.ДатаСверки;
	Объект.Организация = ПараметрыПроверки.Организация;
	СчетаДУ = ПараметрыПроверки.СчетаДоверительногоУправления;
	
	ЗаполнитьКаталогДанных();
	
	ДанныеСверкиДляБухгалтерии = Новый Массив;
	
	КомандаОбновитьСписокФайлов(Неопределено);
	
	Для Каждого СтрокаТаблицыФайлыОтчетов из ФайлыОтчетов Цикл 
		Если СчетаДУ.Найти(СтрокаТаблицыФайлыОтчетов.СчетДоверительногоУправления) = Неопределено Тогда 
			СтрокаТаблицыФайлыОтчетов.Выбран = Ложь;
		КонецЕсли;					
	КонецЦикла;	
	
	ОбработатьОтчетыБрокера(Неопределено, ДанныеСверкиДляБухгалтерии);
	
	Возврат Новый Структура("СверкаСОтчетомБрокера", ДанныеСверкиДляБухгалтерии);	
	
	
КонецФункции	

