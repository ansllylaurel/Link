
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ");
	Если Не ЗначениеЗаполнено(ЭтаФорма.Брокер) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.РежимСверки = 0; // на дату
	ЭтаФорма.ТипФайлаСверки = 0; // тип файла XLSX
	ЭтаФорма.ДатаСверки  = ТекущаяДата() - 86400;
	
	ЭтаФорма.ФиксироватьРезультатСверки				= Ложь;
	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях	= Истина;
	
	Элементы.ГруппаПодтвержденныеОперации.Видимость = Ложь;	
	
	// Обработка параметров	
	
	Если Параметры.Свойство("Организация") Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("ДатаСверки") Тогда
		ЭтаФорма.ДатаСверки	 = Параметры.ДатаСверки;
		ЭтаФорма.РежимСверки = 0; // на дату
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьКаталогДанных();
		
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ПроверяемыеРеквизиты.Добавить("ВремяСверки");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимСверкиПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСверкиПриИзменении(Элемент)
	
	ЭтаФорма.ПериодСверки.ДатаНачала    = ЭтаФорма.ДатаСверки;
	ЭтаФорма.ПериодСверки.ДатаОкончания = ЭтаФорма.ДатаСверки;
	
	ЗаполнитьКаталогДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСверкиПриИзменении(Элемент)
	
	ЭтаФорма.ДатаСверки = ЭтаФорма.ПериодСверки.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогДанных;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогДанных = ДиалогВыбораКаталога.Каталог + ?(СтрЗаканчиваетсяНа(ДиалогВыбораКаталога.Каталог, "\"), "", "\");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПустаяСтрока(Объект.КаталогДанных) Тогда
		ЗапуститьПриложение(Объект.КаталогДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхПриИзменении(Элемент)
	
	КомандаОбновитьСписокФайлов(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ФиксироватьРезультатСверкиПриИзменении(Элемент)
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ЭтаФорма.ВремяСверки = ТекущаяДата();
	КонецЕсли;
	
	ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях = ЭтаФорма.ФиксироватьРезультатСверки;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВремяСверкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ВыбранноеЗначение = ВыбранноеЗначение + (ЭтаФорма.ВремяСверки - НачалоДня(ЭтаФорма.ВремяСверки));		
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ФайлыОтчетов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ФайлыОтчетовСчетДоверительногоУправления" Тогда
		
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	
	ИначеЕсли Поле.Имя = "ФайлыОтчетовРезультатСверки" Тогда
				
		Если ТекущиеДанные.Отчет = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДокументРезультат = ПолучитьОтчет(ТекущиеДанные.Отчет);
		ДокументРезультат.Показать(ТекущиеДанные.СчетДоверительногоУправления);
		
	ИначеЕсли Поле.Имя = "ФайлыОтчетовИмяФайла" И ЗначениеЗаполнено(ТекущиеДанные.ИмяФайла) Тогда
		
		ПолноеИмяФайла = Объект.КаталогДанных + "\" + ТекущиеДанные.ИмяФайла;
		
		ОбъектФайл = Новый Файл(ПолноеИмяФайла);
	
		Если ОбъектФайл.Существует() Тогда
			
			Попытка
				ЗапуститьПриложение(ПолноеИмяФайла);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось открыть файл [" + ПолноеИмяФайла + "]." + Символы.ПС + ОписаниеОшибки());	
			КонецПопытки;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден файл [" + ПолноеИмяФайла + "].");
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСверить(Команда)  Экспорт

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		
		#Область Проверка_корректности_параметров_фиксации_сверки
		
		// С момента установки флажка сверки прошло более 30 минут
		
		Если НачалоДня(ТекущаяДата()) = НачалоДня(ЭтаФорма.ВремяСверки)
			И ТекущаяДата() > (ЭтаФорма.ВремяСверки + 30 * 60)
		Тогда
		
			РезультатВопроса = Вопрос("С момента установки времени сверки прошло более 30 минут. Обновить время сверки?", РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
			
			Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
				ЭтаФорма.ВремяСверки = ТекущаяДата();		
			КонецЕсли;
			
		КонецЕсли;
		
		// Сверяем обычно на следующий рабочий день
		
		НачальнаяДатаСверки = ?(ЭтаФорма.РежимСверки = 0, ЭтаФорма.ДатаСверки, ЭтаФорма.ПериодСверки.ДатаНачала);
		
		Если НачальнаяДатаСверки <> ДобавитьКДатеРабочиеДни(НачалоДня(ЭтаФорма.ВремяСверки) - 1, -1) Тогда
		
			РезультатВопроса = Вопрос("Сверка фиксируется не на следующий рабочий день от сверяемой даты. Все равно продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	ОбработатьОтчетыБрокера(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьКомиссиюБрокера(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	//Снимаем флажок фиксации сверки, т.к. сначала нужно убедиться в отсутствии расхождений
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		
		ЭтаФорма.ФиксироватьРезультатСверки = Ложь;
		
		ФиксироватьРезультатСверкиПриИзменении(Неопределено);
		
	КонецЕсли;
	
	ОбработатьОтчетыБрокера(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)	Экспорт
	
	Этаформа.ФайлыОтчетов.Очистить();
	
	// в зависимости от ТипФайлаСверки изменяем маску поиска
	Если ЭтаФорма.ТипФайлаСверки = 0 Тогда
		НайденыеФайлы = НайтиФайлы(Объект.КаталогДанных, "*xlsx");
	Иначе
		НайденыеФайлы = НайтиФайлы(Объект.КаталогДанных, "*txt");
	КонецЕсли;
	
	МассивФайлов = Новый Массив();
	
	Для каждого НайденыйФайл Из НайденыеФайлы Цикл
		
		МассивФайлов.Добавить(Новый Структура("ИмяФайла, КодСчетаДоверительногоУправления", НайденыйФайл.Имя, ПолучитьКодСчетаДоверительногоУправленияИзИмениФайла(НайденыйФайл.ПолноеИмя)));
		
	КонецЦикла;
	
	Если МассивФайлов.Количество() > 0 Тогда
		МассивДанных = ПолучитьСчетаДоверительногоУправленияНаСервере(МассивФайлов, ЭтаФорма.ДатаСверки, Объект.Организация, ЭтаФорма.Брокер);
		
		Для Каждого ЭлементДанных Из МассивДанных Цикл
			НоваяСтрока = ЭтаФорма.ФайлыОтчетов.Добавить();
			НоваяСтрока.Выбран                       = Истина;
			НоваяСтрока.ИмяФайла                     = ЭлементДанных.ИмяФайла;
			НоваяСтрока.СчетДоверительногоУправления = ЭлементДанных.СчетДоверительногоУправления;
		КонецЦикла;
			
	КонецЕсли;
	
	Если Этаформа.ФайлыОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В указанном каталоге файлы отчетов в указанном формате не найдены.",, "КаталогДанных", "Объект.КаталогДанных", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	
	Для каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		СтрокаФайлыОтчетов.Выбран = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВыделение(Команда)
	
	Для каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		СтрокаФайлыОтчетов.Выбран = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбработатьОтчетыБрокера(Команда, ДанныеСверкиДляБухгалтерии = Неопределено)
	
	Элементы.ГруппаПодтвержденныеОперации.Видимость = Ложь;
	ЭтаФорма.ОтчетОПодтвержденныхОперациях = Неопределено;
	
	ЕстьРасхожденияПоСверке = Ложь;
	
	КоличествоВыбранныхФайлов = ЭтаФорма.ФайлыОтчетов.НайтиСтроки(Новый Структура("Выбран", Истина)).Количество();
	
	Если КоличествоВыбранныхФайлов = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите файлы отчетов для " + ?(Команда = ЭтаФорма.Команды.КомандаСверить, "сверки.", "загрузки комиссии."));
		Возврат;
	КонецЕсли;
	
	СверяемыеСчетаДоверительногоУправления = Новый Массив;
	
	Для Каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		СтрокаФайлыОтчетов.РезультатСверки	= Неопределено;
		СтрокаФайлыОтчетов.Отчет			= Неопределено;
		СверяемыеСчетаДоверительногоУправления.Добавить(СтрокаФайлыОтчетов.СчетДоверительногоУправления);
	КонецЦикла;
		
	ОбщиеПараметры = Новый Структура();
	
	ОбщиеПараметры.Вставить("Организация", Объект.Организация);
	ОбщиеПараметры.Вставить("Брокер", ЭтаФорма.Брокер);
	ОбщиеПараметры.Вставить("ДатаСверки", ЭтаФорма.ДатаСверки);
	ОбщиеПараметры.Вставить("ВремяСверки", ЭтаФорма.ВремяСверки);
	ОбщиеПараметры.Вставить("ФиксироватьРезультатСверки", ЭтаФорма.ФиксироватьРезультатСверки);
	ОбщиеПараметры.Вставить("УникальныйИдентификаторФормы", ЭтаФорма.УникальныйИдентификатор);
	ОбщиеПараметры.Вставить("СверяемыеСчетаДоверительногоУправления", СверяемыеСчетаДоверительногоУправления);
	
	Если ЭтаФорма.ТипФайлаСверки = 0 Тогда
		ДанныеОтчетовБрокера = ДесериализоватьДанныеОтчетовБрокераXLSX(КоличествоВыбранныхФайлов);
	Иначе
		ДанныеОтчетовБрокера = ДесериализоватьДанныеОтчетовБрокераTXT(КоличествоВыбранныхФайлов);
	КонецЕсли;

	Если ДанныеОтчетовБрокера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Команда = ЭтаФорма.Команды.КомандаЗагрузитьКомиссиюБрокера Тогда
		
		ИзмененияНачисленийЗадолженности = Ложь;
		ИзмененияОплат = Ложь;
		
		Состояние("2. Загрузка комиссии.");
		РезультатВыполнения = ИмпортироватьКомиссиюБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры, ИзмененияНачисленийЗадолженности, ИзмененияОплат);
		
		Если ИзмененияНачисленийЗадолженности Тогда 
			ОповеститьОбИзменении(Тип("ДокументСсылка.НачислениеЗадолженности"));
		КонецЕсли;
		
		Если ИзмененияОплат Тогда 
			ОповеститьОбИзменении(Тип("ДокументСсылка.Оплата"));
		КонецЕсли;
		
	ИначеЕсли Команда = ЭтаФорма.Команды.КомандаСверить Тогда
		
		Состояние("2. Сверка данных.");
		РезультатВыполнения = СверитьДанныеОтчетовБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры);
		
	КонецЕсли;
	
	// Счета ДУ с остатками/операциями и без отчета брокера.
	Если ЗначениеЗаполнено(РезультатВыполнения) Тогда
		
		Если РезультатВыполнения.Свойство("ОтчетОтсутствующихФайловБрокера") И РезультатВыполнения.ОтчетОтсутствующихФайловБрокера <> Неопределено Тогда
		
			ЕстьРасхожденияПоСверке = Истина;
			
			ОтчетОтсутствующихФайловБрокера = РезультатВыполнения.ОтчетОтсутствующихФайловБрокера;
				
			ОтчетОтсутствующихФайловБрокера.ОтображатьСетку     = Ложь;
			ОтчетОтсутствующихФайловБрокера.Защита              = Ложь;
			ОтчетОтсутствующихФайловБрокера.ТолькоПросмотр      = Истина;
			ОтчетОтсутствующихФайловБрокера.ОтображатьЗаголовки = Ложь;
			
			ОтчетОтсутствующихФайловБрокера.Показать("Счета ДУ без отчета брокера");
			
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("МассивОтчетовСверки") И ТипЗнч(РезультатВыполнения.МассивОтчетовСверки) = Тип("Массив") Тогда
			
			Для Каждого ЭлементОтчетСверки Из РезультатВыполнения.МассивОтчетовСверки Цикл
				
				СтрокиТаблицыФайлыОтчетов = ЭтаФорма.ФайлыОтчетов.НайтиСтроки(Новый Структура("ИмяФайла, СчетДоверительногоУправления", ЭлементОтчетСверки.ИмяФайла, ЭлементОтчетСверки.СчетДоверительногоУправления));
				
				Для Каждого СтрокаТаблицыФайлыОтчетов Из СтрокиТаблицыФайлыОтчетов Цикл	
					
					СтрокаТаблицыФайлыОтчетов.РезультатСверки = ?(ЭлементОтчетСверки.ЕстьРасхожденияПоНаборамДанных, 2, 1);
					СтрокаТаблицыФайлыОтчетов.Отчет = ЭлементОтчетСверки.Отчет;
					
					Если ЭлементОтчетСверки.ЕстьРасхожденияПоНаборамДанных Тогда
						ЕстьРасхожденияПоСверке = Истина;	
						Если ДанныеСверкиДляБухгалтерии <> Неопределено Тогда 
							ДанныеСверкиДляБухгалтерии.Добавить(СтрокиТаблицыФайлыОтчетов.СчетДоверительногоУправления)
						КонецЕсли;	
					КонецЕсли;
				
				КонецЦикла;
					
			КонецЦикла;
			
			Если ЭтаФорма.ФиксироватьРезультатСверки И РезультатВыполнения.Свойство("РезультатыСверки") Тогда
			
				Отказ = Ложь;
				
				РезультатыСверки = РезультатВыполнения.РезультатыСверки;
			
				Если РезультатыСверки.НепрошедшиеСверку.Количество() > 0
					ИЛИ РезультатыСверки.ИмеющиеРасхождения.Количество() > 0
					ИЛИ РезультатыСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() > 0
				Тогда
				
					#Область Уточняем_у_пользователя_что_следует_зафиксировать_сверку_несмотря_на_расхождения
	
				    ОписаниеРасхождений	= "";
					
					Если РезультатыСверки.НепрошедшиеСверку.Количество() > 0 Тогда
						ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "сверка не пройдена";	
					КонецЕсли;
					
					Если РезультатыСверки.ИмеющиеРасхождения.Количество() > 0 Тогда
						ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "выявлены расхождения";	
					КонецЕсли;
					
					Если РезультатыСверки.ИмеющиеОперацииПозжеВремениСверки.Количество() > 0 Тогда
						
						ОписаниеРасхождений = ?(ПустаяСтрока(ОписаниеРасхождений), "", ОписаниеРасхождений + ", ") + "имеются операции со временем внесения более поздним, чем время сверки";	
						
						// Выведем такие операции и запретим фиксацию сверки
						
						Состояние("Вывод неподтвержденных операций со временем внесения более поздним, чем время сверки");
						
						ЭтаФорма.ОтчетОПодтвержденныхОперациях = ВывестиНеподтвержденныеОперацииПозжеВремениСверки(РезультатыСверки.ТаблицаСверки);
						
						Элементы.ГруппаПодтвержденныеОперации.Видимость	= Истина;
						Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаПодтвержденныеОперации;
											
						Отказ = Истина;
						
					КонецЕсли;
					
					ТекстСообщения = "По некоторым счетам д/у " + ОписаниеРасхождений + ".";
					
					Если Отказ Тогда
						Предупреждение(ТекстСообщения + Символы.ПС + "Фиксация сверки отменена!");
					Иначе
						ОтветНаВопрос = Вопрос(ТекстСообщения + Символы.ПС + "Все равно зафиксировать результаты сверки?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
						Отказ		  = (ОтветНаВопрос <> КодВозвратаДиалога.Да);
					КонецЕсли;				
					
					#КонецОбласти
				
				КонецЕсли;
			
				Если Не Отказ Тогда
					
					Состояние("Фиксация результатов сверки и подтверждение операций");
				
					ЗафиксироватьРезультатСверки(РезультатыСверки.ТаблицаСверки);
					
				КонецЕсли;
				
			КонецЕсли
			
		КонецЕсли;
		
		Если Не ЕстьРасхожденияПоСверке Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расхождений не найдено", ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
				
	Состояние("Обработка завершена");
	
КонецПроцедуры

#Область Служебные_и_вспомогательные_функции

&НаСервере
Процедура ЗафиксироватьРезультатСверки(АдресТаблицыСверки)
	
	Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСверки) Тогда
		Возврат;
	КонецЕсли;
		
	ТаблицаСверки = ПолучитьИзВременногоХранилища(АдресТаблицыСверки);
	
	Если ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда
		ПараметрыОтчета = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Отчет о подтвержденных операциях", , , ЭтаФорма.ОтчетОПодтвержденныхОперациях);
	КонецЕсли;
	
	Для Каждого СтрокаСверки Из ТаблицаСверки Цикл
		
		РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
			Объект.Организация,
			СтрокаСверки.СчетДоверительногоУправления,
			ЭтаФорма.ДатаСверки,
			Справочники.ВнешниеСистемы.ОтчетБрокераГПБ,
			СтрокаСверки.СверкаПройденаУспешно,
			Ложь,
			ЭтаФорма.ВремяСверки,
			СтрокаСверки.Примечание);
		
		// Подтверждаем, если не было расхождений
		Если СтрокаСверки.ОтсутствуютРасхождения Тогда 
			
			ПодтвердитьОперацииСБрокером(
				СтрокаСверки.СчетДоверительногоУправления,
				СтрокаСверки.НеподтвержденныеОперации,
				ЭтаФорма.ВремяСверки,
				ПараметрыОтчета);
			
		КонецЕсли;
		
	КонецЦикла;

	// Установим ширину колонок и отобразим отчет
	Если ЭтаФорма.ВыводитьОтчетОПодтвержденныхОперациях Тогда
		
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыОтчета);
		
		Элементы.ГруппаПодтвержденныеОперации.Видимость = Истина;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПодтвержденныеОперации;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьТабличныйДокументОтчета(АдресФайла)
	Попытка
		ФайлXLSX = ПолучитьИмяВременногоФайла(".xlsx");
    	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
    	ДвоичныеДанныеФайла.Записать(ФайлXLSX);
		
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ФайлXLSX);
		Возврат ТабДок;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКодЦеннойБумагиПоISIN(ISIN, ДатаСверки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			&Период,
		|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|				И Код = &Код) КАК КодыВТорговыхСистемахСрезПоследних";
	
	Запрос.УстановитьПараметр("Код", ISIN);
	Запрос.УстановитьПараметр("Период", ДатаСверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ПустаяСтрока(ВыборкаДетальныеЗаписи.ГосударственныйРегистрационныйНомер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выделить рег. номер из описания ценной бумаги [" + ISIN + "].");
		КонецЕсли;
		Возврат ВыборкаДетальныеЗаписи.ГосударственныйРегистрационныйНомер;
	КонецЦикла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВывестиНеподтвержденныеОперацииПозжеВремениСверки(АдресТаблицыСверки)
	
	Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСверки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаСверки = ПолучитьИзВременногоХранилища(АдресТаблицыСверки);
	
	ПараметрыОтчета = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Неподтвержденные операции со временем внесения более поздним, чем время сверки");
	
	Для Каждого СтрокаСверки Из ТаблицаСверки Цикл

		Если СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
			ПараметрыОтчета,
			СтрокаСверки.НеподтвержденныеОперацииПозжеВремениСверки,
			Новый Структура("Операция, ВремяВнесения", "Операция", "Время внесения"),
			Строка(СтрокаСверки.СчетДоверительногоУправления),
			Ложь,
			Истина);					

	КонецЦикла; 

	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыОтчета);

	Возврат ПараметрыОтчета.ДокументРезультат;	
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПодтвердитьОперацииСБрокером(СчетДоверительногоУправления, Операции, ВремяПодтверждения, ПараметрыОтчета = Неопределено)
	
	// Подтверждаем операции с брокером
	
	ПодтвержденныеОперации = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПодтвердитьОперацииСБрокером(Операции, ВремяПодтверждения);
	
	Если ПараметрыОтчета = Неопределено ИЛИ ПодтвержденныеОперации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	// Выводим подтвержденные операции в отчет	
	
	СтруктураТаблицы = Новый Структура("ПредставлениеОперации, Период, Примечание", "Операция", "Время подтверждения", "Примечание");
	
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
		ПараметрыОтчета,
		Операции,
		СтруктураТаблицы,
		Строка(СчетДоверительногоУправления),
		Ложь,
		Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьКДатеРабочиеДни(Дата, РабочиеДни)
	
	Возврат Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Дата, РабочиеДни);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОтчет(Отчет)
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.Вывести(Отчет);
	
	ДокументРезультат.ОтображатьСетку     = Ложь;
	ДокументРезультат.Защита              = Ложь;
	ДокументРезультат.ТолькоПросмотр      = Истина;
	ДокументРезультат.ОтображатьЗаголовки = Ложь;
	
	Возврат ДокументРезультат;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОтчетОтсутствующихФайловБрокера(ПараметрыОтчетаБрокера)
	
	Отчет = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|ГДЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.Организация = &Организация
		|	И ОстаткиЦенныхБумагОстаткиИОбороты.Период МЕЖДУ &НачалоПериодаОтчета И &КонецПериодаОтчета
		|	И (ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|				И ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.Брокер = &Брокер
		|			ИЛИ ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыДепозитарныхСчетов.Основной)
		|				И ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо = &БрокерЮрФизЛицо)
		|	И НЕ ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления В (&СверяемыеСчетаДоверительногоУправления)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.Брокер = &Брокер
		|	И ОстаткиДенежныхСредств.Период МЕЖДУ &НачалоПериодаОтчета И &КонецПериодаОтчета
		|	И НЕ ОстаткиДенежныхСредств.СчетДоверительногоУправления В (&СверяемыеСчетаДоверительногоУправления)";
	
	Для Каждого КлючЗнач Из ПараметрыОтчетаБрокера Цикл
		Запрос.УстановитьПараметр(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("БрокерЮрФизЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчетаБрокера.Брокер, "ЮрФизЛицо"));  
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Отчет = Новый ТабличныйДокумент;
		
		// Заполняем отчет
		Макет = ПолучитьОбщийМакет("РасхожденияНаборовДанных");
		
		// заголовок отчета
		Область = Макет.ПолучитьОбласть("ЗаголовокОтчета");
		Область.Параметры.ЗаголовокОтчета = "Сверка с отчетом брокера ГПБ";
	
		Отчет.Вывести(Область);
		
		// параметры отчета
		Область = Макет.ПолучитьОбласть("ПараметрыОтчета");
		
		ИсключаемыеПараметры = Новый Структура;
		ИсключаемыеПараметры.Вставить("СверяемыеСчетаДоверительногоУправления");
		
		Для Каждого КлючЗнач Из ПараметрыОтчетаБрокера Цикл
			Если ИсключаемыеПараметры.Свойство(КлючЗнач.Ключ) Тогда
				Продолжить;	
			КонецЕсли;
			
			Область.Параметры.ИмяПараметра      = КлючЗнач.Ключ;
			Область.Параметры.ЗначениеПараметра = КлючЗнач.Значение;
			Отчет.Вывести(Область);
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		Область.Параметры.ЗаголовокТаблицы = "Счета ДУ, по которым есть операции, но без отчета брокера";
		Отчет.Вывести(Область);
		
		НомПервойСтрокиТаблицы = Отчет.ВысотаТаблицы;
		Отчет.НачатьГруппуСтрок();
				
		// отобразим шапку
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|ПустаяКолонка");
		Отчет.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Измерение");
		Область.Параметры.Заголовок = "Счет доверительного управления";
		Отчет.Присоединить(Область);

		// Выведем строки
		ОбластьПустаяКолонка	= Макет.ПолучитьОбласть("СтрокаТаблицы|ПустаяКолонка");
		ОбластьИзмерение		= Макет.ПолучитьОбласть("СтрокаТаблицы|Измерение");
	
		ТаблицаРезультата = РезультатЗапроса.Выгрузить();
		Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
			Отчет.Вывести(ОбластьПустаяКолонка);
			
			ОбластьИзмерение.Параметры.Значение = СтрокаРезультата.СчетДоверительногоУправления;
			Отчет.Присоединить(ОбластьИзмерение);
		КонецЦикла;
		
		Отчет.ЗакончитьГруппуСтрок();
		
		// Заполняем настройки печати по умолчанию
		РаботаСОтчетами.ЗаполнитьНастройкиПечати(Отчет, "ОтчетПоСчетамОтсутствующимВОтчетеБрокера");	
	КонецЕсли;		
	
	Возврат Отчет;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКаталогДанных(Знач Организация, Знач ДатаСверки)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._СверкаСБрокеромГПБ.ШаблонКаталогаОтчетов", Организация, ДатаСверки);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСчетаДоверительногоУправленияНаСервере(МассивФайлов, ДатаСверки, Организация, Брокер)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(275)));
	ТаблицаДанных.Колонки.Добавить("КодСчетаДоверительногоУправления", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	Для Каждого ЭлементФайл Из МассивФайлов Цикл
		
		НоваяСтрокаТаблицы = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, ЭлементФайл);	
		
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.ИмяФайла КАК ИмяФайла,
		|	ТаблицаДанных.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаДанных
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных
	    |;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаДанных.ИмяФайла КАК ИмяФайла,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_ТаблицаДанных КАК _ТаблицаДанных
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаСверки,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|	ПО _ТаблицаДанных.КодСчетаДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код";
		
	Запрос.УстановитьПараметр("ДатаСверки", КонецДня(ДатаСверки));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивДанных = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивДанных.Добавить(Новый Структура("ИмяФайла, СчетДоверительногоУправления", Выборка.ИмяФайла, Выборка.СчетДоверительногоУправления));	
	КонецЦикла;
	
	Возврат МассивДанных; 
	
КонецФункции

&НаСервереБезКонтекста
Функция СверитьДанныеОтчетовБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры)
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбщиеПараметры, "Организация, Брокер, ДатаСверки, ВремяСверки, ФиксироватьРезультатСверки");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		"Сверка с брокером ГПБ. (СверитьДанныеОтчетовБрокера)",
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
				
	ПараметрыОтчета = Новый Структура("Организация, Брокер, БрокерЮрФизЛицо, МестоХранения, СчетДоверительногоУправления, НачалоПериодаОтчета, КонецПериодаОтчета, ВалютаРасчетов", ОбщиеПараметры.Организация, ОбщиеПараметры.Брокер, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщиеПараметры.Брокер, "ЮрФизЛицо"));  
	
	ОстаткиДенежныхСредств	= Неопределено;
	ОстаткиЦенныхБумаг		= Неопределено;
	Сделки					= Неопределено;
	ЗадолженностиПоСделкам	= Неопределено;
	
	Для Каждого ЭлементДанныеОтчета Из ДанныеОтчетовБрокера Цикл
		
		Если ЭлементДанныеОтчета.ОстаткиДенежныхСредств <> Неопределено Тогда 
			
			ОстаткиДенежныхСредствОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(ПолучитьСтруктуруТаблицы("ОстаткиДенежныхСредств"), ЭлементДанныеОтчета.ОстаткиДенежныхСредств, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если ОстаткиДенежныхСредств = Неопределено Тогда
				ОстаткиДенежныхСредств = ОстаткиДенежныхСредствОтчета; 			
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ОстаткиДенежныхСредствОтчета, ОстаткиДенежныхСредств);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭлементДанныеОтчета.ОстаткиЦенныхБумаг <> Неопределено Тогда  
			
			ОстаткиЦенныхБумагОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(ПолучитьСтруктуруТаблицы("ОстаткиЦенныхБумаг"), ЭлементДанныеОтчета.ОстаткиЦенныхБумаг, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если ОстаткиЦенныхБумаг = Неопределено Тогда 
				ОстаткиЦенныхБумаг = ОстаткиЦенныхБумагОтчета; 
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ОстаткиЦенныхБумагОтчета, ОстаткиЦенныхБумаг);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭлементДанныеОтчета.Операции <> Неопределено Тогда 
			
			СделкиОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(ПолучитьСтруктуруТаблицы("Сделки"), ЭлементДанныеОтчета.Операции.Сделки, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если Сделки = Неопределено Тогда
				Сделки = СделкиОтчета;
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(СделкиОтчета, Сделки);	
			КонецЕсли;
			
			ЗадолженностиПоСделкамОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(ПолучитьСтруктуруТаблицы("ЗадолженностиПоСделкам"), ЭлементДанныеОтчета.Операции.ЗадолженностиПоСделкам, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если ЗадолженностиПоСделкам = Неопределено Тогда
				ЗадолженностиПоСделкам = ЗадолженностиПоСделкамОтчета; 			
			Иначе
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ЗадолженностиПоСделкамОтчета, ЗадолженностиПоСделкам);		
			Конецесли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОстаткиДенежныхСредств = Неопределено Или ОстаткиЦенныхБумаг = Неопределено Или Сделки = Неопределено Или ЗадолженностиПоСделкам = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для сверки.");
		Возврат Неопределено;	
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Текст_запроса_для_сопоставления_данных_отчетов_с_данными_базы
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.ИмяФайла КАК ИмяФайла,
		|	ОстаткиДенежныхСредств.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	ОстаткиДенежныхСредств.ИмяВалютыРасчетов КАК ИмяВалютыРасчетов,
		|	ОстаткиДенежныхСредств.ИмяМестаХранения КАК ИмяМестаХранения,
		|	ОстаткиДенежныхСредств.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ОстаткиДенежныхСредств.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредствОтчет
		|ИЗ
		|	&ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумаг.ИмяФайла КАК ИмяФайла,
		|	ОстаткиЦенныхБумаг.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	ОстаткиЦенныхБумаг.НомерТорговогоРаздела КАК НомерТорговогоРаздела,
		|	ОстаткиЦенныхБумаг.КодЦеннойБумаги КАК КодЦеннойБумаги,
		|	ОстаткиЦенныхБумаг.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	ОстаткиЦенныхБумаг.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
		|ПОМЕСТИТЬ _ОстаткиЦенныхБумагОтчет
		|ИЗ
		|	&ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.ИмяФайла КАК ИмяФайла,
		|	Сделки.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	Сделки.ИмяЗаписи КАК ИмяЗаписи,
		|	Сделки.НомерСделки КАК НомерСделки,
		|	Сделки.ДатаСделки КАК ДатаСделки,
		|	Сделки.ВидСделки КАК ВидСделки,
		|	Сделки.КодЦеннойБумаги КАК КодЦеннойБумаги,
		|	Сделки.СуммаСделки КАК СуммаСделки,
		|	Сделки.Купон КАК Купон,
		|	Сделки.БумагиКоличество КАК БумагиКоличество,
		|	Сделки.ТорговаяКомиссия КАК ТорговаяКомиссия,
		|	Сделки.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	Сделки.ДатаИсполнения КАК ДатаИсполнения,
		|	Сделки.КомиссияБрокера КАК КомиссияБрокера,
		|	Сделки.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	Сделки.СтавкаРЕПО КАК СтавкаРЕПО
		|ПОМЕСТИТЬ _ВсеСделкиОтчет
		|ИЗ
		|	&Сделки КАК Сделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоСделкам.ИмяФайла КАК ИмяФайла,
		|	ЗадолженностиПоСделкам.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	ЗадолженностиПоСделкам.ИмяЗаписи КАК ИмяЗаписи,
		|	ЗадолженностиПоСделкам.НомерСделки КАК НомерСделки,
		|	ЗадолженностиПоСделкам.ДатаСделки КАК ДатаСделки,
		|	ЗадолженностиПоСделкам.ВидСделки КАК ВидСделки,
		|	ЗадолженностиПоСделкам.КодЦеннойБумаги КАК КодЦеннойБумаги,
		|	ЗадолженностиПоСделкам.СуммаЗадолженностиПоСделке КАК СуммаЗадолженностиПоСделке,
		|	ЗадолженностиПоСделкам.СуммаЗадолженностиПоКупону КАК СуммаЗадолженностиПоКупону,
		|	ЗадолженностиПоСделкам.СуммаЗадолженностиПоТорговойКомиссии КАК СуммаЗадолженностиПоТорговойКомиссии,
		|	ЗадолженностиПоСделкам.СуммаЗадолженностиПоБрокерскойКомиссии КАК СуммаЗадолженностиПоБрокерскойКомиссии,
		|	ЗадолженностиПоСделкам.КоличествоЗадолженностиПоБумагам КАК КоличествоЗадолженностиПоБумагам
		|ПОМЕСТИТЬ _ЗадолженностиПоСделкамОтчет
		|ИЗ
		|	&ЗадолженностиПоСделкам КАК ЗадолженностиПоСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиЦенныхБумагОтчет.КодЦеннойБумаги КАК Код,
		|	_ОстаткиЦенныхБумагОтчет.ИмяФайла КАК ИмяФайла
		|ПОМЕСТИТЬ _КодыЦенныхБумаг
		|ИЗ
		|	_ОстаткиЦенныхБумагОтчет КАК _ОстаткиЦенныхБумагОтчет
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ВсеСделкиОтчет.КодЦеннойБумаги,
		|	_ВсеСделкиОтчет.ИмяФайла
		|ИЗ
		|	_ВсеСделкиОтчет КАК _ВсеСделкиОтчет
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_ЗадолженностиПоСделкамОтчет.КодЦеннойБумаги,
		|	_ЗадолженностиПоСделкамОтчет.ИмяФайла
		|ИЗ
		|	_ЗадолженностиПоСделкамОтчет КАК _ЗадолженностиПоСделкамОтчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КодыЦенныхБумаг.Код КАК Код,
		|	_КодыЦенныхБумаг.ИмяФайла КАК ИмяФайла,
		|	ВложенныйЗапрос.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	_КодыЦенныхБумаг КАК _КодыЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			Акции.Ссылка КАК Ссылка,
		|			Акции.ГосударственныйРегистрационныйНомер КАК Код
		|		ИЗ
		|			Справочник.Акции КАК Акции
		|		ГДЕ
		|			Акции.ГосударственныйРегистрационныйНомер В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_КодыЦенныхБумаг.Код
		|					ИЗ
		|						_КодыЦенныхБумаг КАК _КодыЦенныхБумаг)
		|			И Акции.ПометкаУдаления = ЛОЖЬ
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			Облигации.Ссылка,
		|			Облигации.ГосударственныйРегистрационныйНомер
		|		ИЗ
		|			Справочник.Облигации КАК Облигации
		|		ГДЕ
		|			Облигации.ГосударственныйРегистрационныйНомер В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_КодыЦенныхБумаг.Код
		|					ИЗ
		|						_КодыЦенныхБумаг КАК _КодыЦенныхБумаг)
		|			И Облигации.ПометкаУдаления = ЛОЖЬ
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			Паи.Ссылка,
		|			Паи.ГосударственныйРегистрационныйНомер
		|		ИЗ
		|			Справочник.Паи КАК Паи
		|		ГДЕ
		|			Паи.ГосударственныйРегистрационныйНомер В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_КодыЦенныхБумаг.Код
		|					ИЗ
		|						_КодыЦенныхБумаг КАК _КодыЦенныхБумаг)
		|			И Паи.ПометкаУдаления = ЛОЖЬ
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ИпотечныеСертификатыУчастия.Ссылка,
		|			ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер
		|		ИЗ
		|			Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ГДЕ
		|			ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_КодыЦенныхБумаг.Код
		|					ИЗ
		|						_КодыЦенныхБумаг КАК _КодыЦенныхБумаг)
		|			И ИпотечныеСертификатыУчастия.ПометкаУдаления = ЛОЖЬ
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			КодыВТорговыхСистемахСрезПоследних.Объект,
		|			КодыВТорговыхСистемахСрезПоследних.Код
		|		ИЗ
		|			РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|					&ДатаСверки,
		|					ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|						И Код В
		|							(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|								_КодыЦенныхБумаг.Код
		|							ИЗ
		|								_КодыЦенныхБумаг КАК _КодыЦенныхБумаг)) КАК КодыВТорговыхСистемахСрезПоследних) КАК ВложенныйЗапрос
		|		ПО _КодыЦенныхБумаг.Код = ВложенныйЗапрос.Код
		|;
		|
