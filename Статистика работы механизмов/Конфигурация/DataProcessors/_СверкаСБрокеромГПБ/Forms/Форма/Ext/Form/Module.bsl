	//		ЗА 18/04/2017
	//		ДАТА СОСТАВЛЕНИЯ ОТЧЕТА 19/04/2017
	//		МЕСТО ЗАКЛЮЧЕНИЯ СДЕЛКИ: ЗАО «ФОНДОВАЯ БИРЖА ММВБ» (ОСНОВНОЙ РЫНОК)
	//		ИНВЕСТОР: 12693 Y47-00000B11 АКЦИОНЕРНОЕ ОБЩЕСТВО "РЕГИОН ЭССЕТ МЕНЕДЖМЕНТ" ДУ ПЕНСИОННЫМИ РЕЗЕРВАМИ АО ''НПФ "ВНИИЭФ-ГАРАНТ"
	//		ДОГОВОР № Г000-Б-12693 ОТ 29/09/2008
	//		ВАЛЮТА РАСЧЕТОВ RUR
	
	// Шапка отчета полученного по ЭДО выглядит следующим образом:
	//		LANDSCAPE,0,30,0,0,Lucida Console,6, ,CYRILLIC,A4
	//		«Газпромбанк» (Акционерное общество)
	//		Банк ГПБ (АО)

