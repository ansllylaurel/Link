Функция ДесериализоватьОстаткиДенежныхСредствTXT(ТекстОтчета, ПозицииРазделовОтчета)
	
	СтрокаОстаткиДенежныхСредствШаблон = Новый ФиксированнаяСтруктура("СуммаНачальныйОстаток, СуммаКонечныйОстаток");
	ОстаткиДенежныхСредств = Новый Массив;
	
	КлючВходящийОстаток  = "ВХОДЯЩИЕ ОСТАТКИ";
	КлючИсходящийОстаток = "ИСХОДЯЩИЕ ОСТАТКИ";
	
	// в таблицах входящих и исходящих остатков содержится только одна строка
	СтрокаОстаткиДенежныхСредств = Новый Структура(СтрокаОстаткиДенежныхСредствШаблон);
	
	ОстаткиДенежныхСредств.Добавить(СтрокаОстаткиДенежныхСредств);
	
	НомСтр = ПозицииРазделовОтчета.ДенежныеСредства + 1;
	
	МаксЗначениеСчетчика = ПолучитьМаксЗначениеСчетчика(НомСтр, ПозицииРазделовОтчета, ТекстОтчета.КоличествоСтрок());
	
	Пока НомСтр <= МаксЗначениеСчетчика Цикл
		
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если СтрНачинаетсяС(ТекСтрокаОтчета, КлючВходящийОстаток) Тогда
			ТипСуммы = "СуммаНачальныйОстаток";
		ИначеЕсли СтрНачинаетсяС(ТекСтрокаОтчета, КлючИсходящийОстаток) Тогда
			ТипСуммы = "СуммаКонечныйОстаток";
		Иначе
			ТипСуммы = Неопределено;
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
		
		Если ЗначениеЗаполнено(ТипСуммы) Тогда
			
			ЗначПолейТаблицы = ПрочитатьТаблицуОтчета(ТекстОтчета, МаксЗначениеСчетчика, НомСтр);
			
			Если ЗначПолейТаблицы.Количество() <> 3 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: таблица [" + КлючВходящийОстаток + "] содержит менее 3-х строк, вкл. имена и номера колонок");
				Возврат Неопределено;
				
			КонецЕсли;
			
			СтрокаОстаткиДенежныхСредств[ТипСуммы] = ПреобразоватьВЧисло(ЗначПолейТаблицы[2][0]);
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если СтрокаОстаткиДенежныхСредств.СуммаНачальныйОстаток = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: отсутствует таблица [" + КлючВходящийОстаток + "]");
		Возврат Неопределено;
	ИначеЕсли СтрокаОстаткиДенежныхСредств.СуммаКонечныйОстаток = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла: отсутствует таблица [" + КлючИсходящийОстаток + "]");
		Возврат Неопределено;
	КонецЕсли;
			
	Возврат ОстаткиДенежныхСредств;
	
КонецФункции

&НаКлиенте
Функция ДесериализоватьОстаткиЦенныхБумагTXT(ТекстОтчета, ПозицииРазделовОтчета)
	
	СтрокаОстаткиЦенныхБумагШаблон = Новый ФиксированнаяСтруктура("НомерТорговогоРаздела, КодЦеннойБумаги, КоличествоНачальныйОстаток, КоличествоКонечныйОстаток");
	ОстаткиЦенныхБумаг = Новый Массив;
	ИмяТаблицы = "";
	
	НомСтр = ПозицииРазделовОтчета.ЦенныеБумаги + 1;
	
	МаксЗначениеСчетчика = ПолучитьМаксЗначениеСчетчика(НомСтр, ПозицииРазделовОтчета, ТекстОтчета.КоличествоСтрок());
	
	Пока НомСтр <= МаксЗначениеСчетчика Цикл
		
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если ОстаткиЦенныхБумаг.Количество() = 0 И СтрНайти(ТекСтрокаОтчета, "ОПИСАНИЕ ЦЕННОЙ БУМАГИ") > 0  Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не соответствует формату. В файле присутствует информация о ценных бумагах без указания раздела.");
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтрНачинаетсяС(ТекСтрокаОтчета, "ДВИЖЕНИЕ ПО СЧЕТУ УЧЕТА ЦЕННЫХ БУМАГ") Или СтрНачинаетсяС(ТекСтрокаОтчета, "ПО РАЗДЕЛУ В") Тогда
			ИмяТаблицы = ТекСтрокаОтчета;
			НомСтр = НомСтр + 1;
			Продолжить;
		КонецЕсли;
					
		Если ИмяТаблицы <> "" Тогда
									
			ЗначПолейТаблицы = ПрочитатьТаблицуОтчета(ТекстОтчета, МаксЗначениеСчетчика, НомСтр);
			
			Если ЗначПолейТаблицы.Количество() = 0 Тогда
				ИмяТаблицы = ""; //если таблица пустая, продолжаем поиск следующей таблицы
				НомСтр = НомСтр + 1;
				Продолжить;
			КонецЕсли;
						
			Если СтрНачинаетсяС(ИмяТаблицы, "ДВИЖЕНИЕ ПО СЧЕТУ УЧЕТА ЦЕННЫХ БУМАГ") Или СтрНачинаетсяС(ИмяТаблицы, "ПО РАЗДЕЛУ В НРД «БЛОКИРОВАНО ДЛЯ КЛИРИНГА НКЦ. ОБЕСПЕЧЕНИЕ.»") Тогда  
				ТекНомерТорговогоРаздела = "36";
			ИначеЕсли СтрНачинаетсяС(ИмяТаблицы, "ПО РАЗДЕЛУ В НРД «БЛОКИРОВАНО ДЛЯ КЛИРИНГА НКЦ. СДЕЛКИ В ВАЛЮТЕ РФ.»") Тогда
				//ТекНомерТорговогоРаздела = "31";
				Продолжить;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось опредилить номер торгового раздела из текста [" + ТекНомерТорговогоРаздела + "]");
				Возврат Неопределено;
			КонецЕсли;
			
			ИндексПоляЦБ = Неопределено;
			ИндексПоляНачОстатка = Неопределено;
			ИндексПоляКонОстатка = Неопределено;
			
			Для Инд = 0 По ЗначПолейТаблицы[0].Количество() - 1 Цикл
				
				Если СтрЗаменить(ЗначПолейТаблицы[0][Инд], " ", "") = "ОПИСАНИЕЦЕННОЙБУМАГИ" Тогда	
					ИндексПоляЦБ = Инд;	
				ИначеЕсли СтрЗаменить(ЗначПолейТаблицы[0][Инд], " ", "") = "ВХОДЯЩИЙОСТАТОК" Тогда
					ИндексПоляНачОстатка = Инд;	
				ИначеЕсли СтрЗаменить(ЗначПолейТаблицы[0][Инд], " ", "") = "ИСХОДЯЩИЙОСТАТОК" Тогда
					ИндексПоляКонОстатка = Инд;	
				КонецЕсли;
				
			КонецЦикла;
			
			Если ИндексПоляЦБ = Неопределено И ИндексПоляНачОстатка = Неопределено И ИндексПоляКонОстатка = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не соответствует формату. Не удалось определить остатки ценных бумаг.");
				Возврат Неопределено;
			КонецЕсли;
			
			Для Инд = 2 По ЗначПолейТаблицы.Количество() - 1 Цикл
				
				СтрокаОстаткиЦенныхБумаг = Новый Структура(СтрокаОстаткиЦенныхБумагШаблон);
				СтрокаОстаткиЦенныхБумаг.НомерТорговогоРаздела      = ТекНомерТорговогоРаздела;
				СтрокаОстаткиЦенныхБумаг.КодЦеннойБумаги            = ПолучитьКодЦеннойБумаги(ЗначПолейТаблицы[Инд][ИндексПоляЦБ]); 
				СтрокаОстаткиЦенныхБумаг.КоличествоНачальныйОстаток = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][ИндексПоляНачОстатка]);
				СтрокаОстаткиЦенныхБумаг.КоличествоКонечныйОстаток  = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][ИндексПоляКонОстатка]);				
				ОстаткиЦенныхБумаг.Добавить(СтрокаОстаткиЦенныхБумаг);
				
			КонецЦикла;
			
		КонецЕсли;
		
		ИмяТаблицы = "";
		НомСтр = НомСтр + 1;
		
	КонецЦикла;
		
	Возврат ОстаткиЦенныхБумаг;	
	
КонецФункции

&НаКлиенте
Функция ДесериализоватьОстаткиЦенныхБумагXLSX(ТабличныйДокументОтчета)
	
	СтрокаОстаткиЦенныхБумагШаблон = Новый ФиксированнаяСтруктура("НомерТорговогоРаздела, КодЦеннойБумаги, КоличествоНачальныйОстаток, КоличествоКонечныйОстаток");
	ОстаткиЦенныхБумаг = Новый Массив;
	
	// Получаем данные с листа "Движение ЦБ"
	ДанныеЦенныхБумаг = ПрочитатьТаблицуЦенныхБумагXLSX(ТабличныйДокументОтчета);
	
	Если ДанныеЦенныхБумаг.Количество() = 0 Тогда
		Возврат ОстаткиЦенныхБумаг;
	КонецЕсли;
	
	// Определяем индексы колонок
	ИндексПоляЦБ = НайтиИндексКолонкиXLSX(ДанныеЦенныхБумаг, "Наименование ценной бумаги");
	ИндексПоляИдентификатор = НайтиИндексКолонкиXLSX(ДанныеЦенныхБумаг, "Идентификатор ценной бумаги");
	ИндексПоляНачОстатка = НайтиИндексКолонкиXLSX(ДанныеЦенныхБумаг, "Входящий остаток");
	ИндексПоляКонОстатка = НайтиИндексКолонкиXLSX(ДанныеЦенныхБумаг, "Исходящий остаток");
	
	Если ИндексПоляЦБ = Неопределено ИЛИ ИндексПоляНачОстатка = Неопределено ИЛИ ИндексПоляКонОстатка = Неопределено Тогда
		Возврат ОстаткиЦенныхБумаг;
	КонецЕсли;
	
	// Обрабатываем строки с данными (пропускаем заголовки)
	Для Инд = 2 По ДанныеЦенныхБумаг.Количество() - 1 Цикл
		
		СтрокаДанных = ДанныеЦенныхБумаг[Инд];
		Если СтрокаДанных.Количество() <= Макс(ИндексПоляИдентификатор, ИндексПоляНачОстатка, ИндексПоляКонОстатка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторЦБ = СтрокаДанных[ИндексПоляИдентификатор];
		ВходящийОстаток = СтрокаДанных[ИндексПоляНачОстатка];
		ИсходящийОстаток = СтрокаДанных[ИндексПоляКонОстатка];
		
		СтрокаОстаткиЦенныхБумаг = Новый Структура(СтрокаОстаткиЦенныхБумагШаблон);
		СтрокаОстаткиЦенныхБумаг.НомерТорговогоРаздела      = НомерТорговогоРаздела(ТабличныйДокументОтчета);
		СтрокаОстаткиЦенныхБумаг.КодЦеннойБумаги            = ПолучитьКодЦеннойБумагиПоISIN(ИдентификаторЦБ, ЭтаФорма.ДатаСверки); 
		СтрокаОстаткиЦенныхБумаг.КоличествоНачальныйОстаток = ПреобразоватьВЧисло(ВходящийОстаток,,Ложь);
		СтрокаОстаткиЦенныхБумаг.КоличествоКонечныйОстаток  = ПреобразоватьВЧисло(ИсходящийОстаток,,Ложь);
		
		ОстаткиЦенныхБумаг.Добавить(СтрокаОстаткиЦенныхБумаг);
		
	КонецЦикла;
		
	Возврат ОстаткиЦенныхБумаг;	
	
КонецФункции

&НаКлиенте
Функция НомерТорговогоРаздела(ТабличныйДокументОтчета)
	
	// Поиск заголовков
	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("Движение по счёту учёта ценных бумаг");
	КлючевыеСлова.Добавить("По разделу в НРД");
	
	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		ОбластьЗаголовка = ТабличныйДокументОтчета.НайтиТекст(КлючевоеСлово);
		Если ОбластьЗаголовка <> Неопределено Тогда
			Заголовок = ВРег(ОбластьЗаголовка.Текст);
			Если СтрНачинаетсяС(Заголовок, "ДВИЖЕНИЕ ПО СЧЁТУ УЧЁТА ЦЕННЫХ БУМАГ") 
				Или СтрНайти(Заголовок, "БЛОКИРОВАНО ДЛЯ КЛИРИНГА НКЦ. ОБЕСПЕЧЕНИЕ.") > 0 Тогда
				Возврат "36";
			ИначеЕсли СтрНайти(Заголовок, "БЛОКИРОВАНО ДЛЯ КЛИРИНГА НКЦ. СДЕЛКИ В ВАЛЮТЕ РФ.") > 0 Тогда
				Возврат "31";
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить номер торгового раздела из текста [" + Заголовок + "]");
				Возврат Неопределено;
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьТаблицуЦенныхБумагXLSX(ТабличныйДокументОтчета)
	
	ДанныеЦенныхБумаг = Новый Массив;
	
	// Ищем начало таблицы на листе "Движение ЦБ"
	// Заголовок первой колонки начинается со строки "Движение по счёту учёта ценных бумаг"
	ОбластьЗаголовка = ТабличныйДокументОтчета.НайтиТекст("Движение по счёту учёта ценных бумаг");
	Если ОбластьЗаголовка = Неопределено Тогда
		Возврат ДанныеЦенныхБумаг;
	КонецЕсли;
	
	НачальнаяСтрока = ОбластьЗаголовка.Низ + 1;
	МаксСтрок = ТабличныйДокументОтчета.ВысотаТаблицы; // Ограничение на чтение строк
	
	// Читаем заголовки
	СтрокаЗаголовков = Новый Массив;
	Для Колонка = 1 По 14 Цикл // Предполагаем максимум 14 колонок
		Значение = ТабличныйДокументОтчета.Область(НачальнаяСтрока, Колонка).Текст;
		СтрокаЗаголовков.Добавить(СокрЛП(Значение));
	КонецЦикла;
	ДанныеЦенныхБумаг.Добавить(СтрокаЗаголовков);
	
	// Читаем данные
	Для Счетчик = 1 По МаксСтрок - 1 Цикл
		ТекСтрока = НачальнаяСтрока + Счетчик;
		
		// Проверяем, есть ли данные в первой колонке
		ТекстПервойКолонки = ТабличныйДокументОтчета.Область(ТекСтрока, 1).Текст;
		Если ТекстПервойКолонки = "" ИЛИ СтрНачинаетсяС(ТекстПервойКолонки, "Внимание!") Тогда
			// Конец таблицы
			Прервать;
		КонецЕсли;
		
		// Читаем всю строку
		СтрокаДанных = Новый Массив;
		Для Колонка = 1 По 14 Цикл
			Значение = ТабличныйДокументОтчета.Область(ТекСтрока, Колонка).Текст;
			СтрокаДанных.Добавить(СокрЛП(Значение));
		КонецЦикла;
		
		ДанныеЦенныхБумаг.Добавить(СтрокаДанных);
	КонецЦикла;
	
	Возврат ДанныеЦенныхБумаг;
	
КонецФункции

&НаКлиенте
Функция НайтиИндексКолонкиXLSX(ДанныеТаблицы, ИмяКолонки)
	
	Если ДанныеТаблицы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = ДанныеТаблицы[0]; // Первая строка - заголовки
	
	Для Инд = 0 По Заголовки.Количество() - 1 Цикл
		Если СтрЗаменить(Заголовки[Инд], " ", "") = СтрЗаменить(ИмяКолонки, " ", "") Тогда
			Возврат Инд;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ДесериализоватьСделкиИЗадолженностиПоСделкамTXT(ТекстОтчета, ПозицииРазделовОтчета)
	
	Операции = Новый Структура("Сделки, ЗадолженностиПоСделкам");
	
	СтрокаСделкиШаблон = Новый ФиксированнаяСтруктура("ИмяЗаписи, НомерСделки, ДатаСделки, КодЦеннойБумаги, ВидСделки, БумагиКоличество, СтавкаРЕПО, СуммаСделки, Купон, КомиссияБрокера, ТорговаяКомиссия, ЧастьСделкиРЕПО, ОтложенноеИсполнение, ДатаИсполнения, ДатаОплатыКомиссии");
	СтрокаЗадолженностиПоСделкеШаблон = Новый ФиксированнаяСтруктура("ИмяЗаписи, НомерСделки, ДатаСделки, КодЦеннойБумаги, ВидСделки, СуммаЗадолженностиПоСделке, СуммаЗадолженностиПоКупону, СуммаЗадолженностиПоТорговойКомиссии, СуммаЗадолженностиПоБрокерскойКомиссии, КоличествоЗадолженностиПоБумагам");
	 	
	Сделки = Новый Массив;
	ЗадолженностиПоСделкам = Новый Массив;
	
	КлючЗаключенныеСделки      = "ЗАКЛЮЧЕННЫЕ СДЕЛКИ:";
	КлючРанееЗаключенныеСделки = "РАНЕЕ ЗАКЛЮЧЕННЫЕ СДЕЛКИ, ПО КОТОРЫМ ПРОВЕДЕНЫ РАСЧЕТЫ";
	КлючСделкиРЕПО             = "CДЕЛКИ РЕПО";
	КлючЗадолженностиПоСделкам = "РАНЕЕ ЗАКЛЮЧЕННЫЕ СДЕЛКИ, НО НЕ ИСПОЛНЕННЫЕ";
		
	НомСтр = ПозицииРазделовОтчета.Сделки + 1;
		
	МаксЗначениеСчетчика = ПолучитьМаксЗначениеСчетчика(НомСтр, ПозицииРазделовОтчета, ТекстОтчета.КоличествоСтрок());
	
	Пока НомСтр <= МаксЗначениеСчетчика Цикл
		
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если СтрНачинаетсяС(ТекСтрокаОтчета, КлючЗаключенныеСделки) Тогда
			Операция = "Сделка";
		ИначеЕсли СтрНачинаетсяС(ТекСтрокаОтчета, КлючРанееЗаключенныеСделки) Тогда
			Операция = "ИсполнениеОбязательствПоСделке";
		ИначеЕсли СтрНачинаетсяС(ТекСтрокаОтчета, КлючСделкиРЕПО) Тогда
			Операция = "СделкаРЕПО";
		ИначеЕсли СтрНачинаетсяС(ТекСтрокаОтчета, КлючЗадолженностиПоСделкам) Тогда
			Операция = "ЗадолженностьПоСделке";
		Иначе
			Операция = Неопределено;
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
		
		Если ЗначениеЗаполнено(Операция) Тогда
			
			ЗначПолейТаблицы = ПрочитатьТаблицуОтчета(ТекстОтчета, МаксЗначениеСчетчика, НомСтр);
			
			Для Инд = 2 По ЗначПолейТаблицы.Количество() - 1 Цикл
				Если СтрНачинаетсяС(ЗначПолейТаблицы[Инд][0], "ИТОГО ") Тогда
					Прервать;
				КонецЕсли;
							
				Если Операция = "СделкаРЕПО" Тогда
					
					СтрокаСделкиРепо = Новый Структура(СтрокаСделкиШаблон);
					СтрокаСделкиРепо.ИмяЗаписи = Операция;
										
					ЧастьСделкиРЕПО = НРег(СокрЛП(ЗначПолейТаблицы[Инд][12]));
					
					ДатаСделки = СокрЛП(ЗначПолейТаблицы[Инд][1]);
					ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаСделки, 8), Прав(ДатаСделки, 8));
					
					ДатаРасчетов = СокрЛП(ЗначПолейТаблицы[Инд][13]);
					ДатаРасчетов = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаРасчетов, 8));
					
					СтатусИсполнения = СокрЛП(ЗначПолейТаблицы[Инд][14]);
					ДатаРасчетовФакт = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаРасчетов, 8));
					
					Если ЧастьСделкиРЕПО = "1 ч." Тогда
						
						СтрокаСделкиРепо.ЧастьСделкиРепо = 1;
						СтавкаРепо = 0;
						СтрокаСделкиРепо.ДатаОплатыКомиссии = ДатаСделки;
						СтрокаСделкиРепо.ДатаСделки = ДатаСделки;
						
						Если СтрокаСделкиРепо.ДатаСделки = Неопределено Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату 1-ой ч. сделки Репо [" + НРег(СокрЛП(ЗначПолейТаблицы[Инд][11])) + "]");
							Возврат Неопределено;
						КонецЕсли;
						
					ИначеЕсли ЧастьСделкиРЕПО = "2 ч." Тогда
						
						СтрокаСделкиРепо.ЧастьСделкиРепо = 2;
						СтавкаРепо = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][5]);
						СтрокаСделкиРепо.ДатаОплатыКомиссии = ДатаРасчетов;
						СтрокаСделкиРепо.ДатаСделки = ДатаРасчетов;
						
						Если СтрокаСделкиРепо.ДатаСделки = Неопределено Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату 2-ой ч. сделки Репо [" + НРег(СокрЛП(ЗначПолейТаблицы[Инд][11])) + "]");
							Возврат Неопределено;
						КонецЕсли;
						
					КонецЕсли;
										
					Если ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][2]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][2]);
						
					ИначеЕсли ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][3]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][3]);
						
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить вид сделки Репо [" + НРег(СокрЛП(ЗначПолейТаблицы[Инд][11])) + "] по значению полей: покупка [" + СокрЛП(ЗначПолейТаблицы[Инд][2]) + "], продажа [" + СокрЛП(ЗначПолейТаблицы[Инд][3]) + "]");
						Возврат Неопределено;	
					КонецЕсли;
					
					СтрокаСделкиРепо.НомерСделки        = НРег(СокрЛП(ЗначПолейТаблицы[Инд][11]));
					СтрокаСделкиРепо.КодЦеннойБумаги    = ПолучитьКодЦеннойБумаги(ЗначПолейТаблицы[Инд][0]);
					СтрокаСделкиРепо.ВидСделки          = ВидСделки;
					СтрокаСделкиРепо.БумагиКоличество   = Количество;
					СтрокаСделкиРепо.СтавкаРепо         = СтавкаРепо;
					СтрокаСделкиРепо.СуммаСделки        = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][6]);
					СтрокаСделкиРепо.Купон              = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][7]);
					СтрокаСделкиРепо.КомиссияБрокера    = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9]);
					СтрокаСделкиРепо.ТорговаяКомиссия   = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10]);
					
					Если ДатаРасчетов > НачалоДня(ДатаСделки) И ЧастьСделкиРЕПО = "2 ч." И СтатусИсполнения = "НЕЗАВЕРШЕНА" Тогда
					
						СтрокаСделкиРепо.ОтложенноеИсполнение = Истина;
						СтрокаСделкиРепо.ДатаИсполнения       = ДатаРасчетов;
						
						СтрокаЗадолженностиПоСделке = Новый Структура(СтрокаЗадолженностиПоСделкеШаблон);
						
						СтрокаЗадолженностиПоСделке.ДатаСделки      = ДатаСделки;
						СтрокаЗадолженностиПоСделке.НомерСделки     = СтрокаСделкиРепо.НомерСделки;
						СтрокаЗадолженностиПоСделке.ВидСделки       = СтрокаСделкиРепо.ВидСделки;
						СтрокаЗадолженностиПоСделке.КодЦеннойБумаги = СтрокаСделкиРепо.КодЦеннойБумаги;
						
						Если СтрокаСделкиРепо.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа") Тогда
							
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоСделке       = СтрокаСделкиРепо.СуммаСделки;
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоКупону       = СтрокаСделкиРепо.Купон; 
							СтрокаЗадолженностиПоСделке.КоличествоЗадолженностиПоБумагам = СтрокаСделкиРепо.БумагиКоличество;
							
						Иначе
							
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоСделке       = ПреобразоватьВЧисло(СтрокаСделкиРепо.СуммаСделки, -1);
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоКупону       = ПреобразоватьВЧисло(СтрокаСделкиРепо.Купон, -1); 
							СтрокаЗадолженностиПоСделке.КоличествоЗадолженностиПоБумагам = СтрокаСделкиРепо.БумагиКоличество;
							
						КонецЕсли;
						
						СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоБрокерскойКомиссии = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9], -1);
						СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоТорговойКомиссии   = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10], -1);
						
						ЗадолженностиПоСделкам.Добавить(СтрокаЗадолженностиПоСделке);
						
					Иначе
						
						СтрокаСделкиРепо.ОтложенноеИсполнение = Ложь;
						
					КонецЕсли;
					
					Сделки.Добавить(СтрокаСделкиРепо);
					
				ИначеЕсли Операция = "Сделка" Тогда
										
					СтрокаСделки = Новый Структура(СтрокаСделкиШаблон);
					СтрокаСделки.ИмяЗаписи = Операция;

					ДатаСделки = СокрЛП(ЗначПолейТаблицы[Инд][1]);
					ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаСделки, 8), Прав(ДатаСделки, 8));
					
					Если ДатаСделки = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату сделки [" + СокрЛП(ЗначПолейТаблицы[Инд][2]) + "]");
						Возврат Неопределено;
					КонецЕсли;
					
					Если ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][3]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][3]);
						
					ИначеЕсли ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][4]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][4]);
						
					Иначе
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить вид сделки [" + СокрЛП(ЗначПолейТаблицы[Инд][2]) + "] по значению полей полей: покупка [" + СокрЛП(ЗначПолейТаблицы[Инд][3]) + "], продажа [" + СокрЛП(ЗначПолейТаблицы[Инд][4]) + "]");
						Возврат Неопределено;	
						
					КонецЕсли;
					
					СтрокаСделки.ДатаСделки       = ДатаСделки;
					СтрокаСделки.НомерСделки      = СокрЛП(ЗначПолейТаблицы[Инд][2]);
					СтрокаСделки.КодЦеннойБумаги  = ПолучитьКодЦеннойБумаги(ЗначПолейТаблицы[Инд][0]);
					СтрокаСделки.ВидСделки        = ВидСделки;
					СтрокаСделки.БумагиКоличество = Количество;
					СтрокаСделки.СуммаСделки      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][6]);
					СтрокаСделки.Купон            = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][7]);
					СтрокаСделки.КомиссияБрокера  = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9]);
					СтрокаСделки.ТорговаяКомиссия = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10]);
										
					ДатаРасчетов = СокрЛП(ЗначПолейТаблицы[Инд][12]);
					ДатаРасчетов = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаРасчетов, 8), "00:00:00");
					
					СтрокаСделки.ДатаОплатыКомиссии = ДатаРасчетов;

					Если ДатаРасчетов = Неопределено Тогда 
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату расчетов по сделке [" + СтрокаСделки.НомерСделки + "]");
						Возврат Неопределено;
						
					ИначеЕсли ДатаРасчетов > НачалоДня(ДатаСделки) Тогда
						
						СтрокаСделки.ОтложенноеИсполнение = Истина;
						СтрокаСделки.ДатаИсполнения       = ДатаРасчетов;
						
						//Если сделка с отложенным исполнением записывает строку данных в задолженности
						СтрокаЗадолженностиПоСделке = Новый Структура(СтрокаЗадолженностиПоСделкеШаблон);
						
						СтрокаЗадолженностиПоСделке.ДатаСделки      = СтрокаСделки.ДатаСделки;
						СтрокаЗадолженностиПоСделке.НомерСделки     = СтрокаСделки.НомерСделки;
						СтрокаЗадолженностиПоСделке.ВидСделки       = СтрокаСделки.ВидСделки;
						СтрокаЗадолженностиПоСделке.КодЦеннойБумаги = СтрокаСделки.КодЦеннойБумаги;
							
						Если СтрокаСделки.ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа") Тогда
							
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоСделке       = СтрокаСделки.СуммаСделки;
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоКупону       = СтрокаСделки.Купон; 
							СтрокаЗадолженностиПоСделке.КоличествоЗадолженностиПоБумагам = ПреобразоватьВЧисло(СтрокаСделки.БумагиКоличество, -1);
							
						Иначе
							
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоСделке       = ПреобразоватьВЧисло(СтрокаСделки.СуммаСделки, -1);
							СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоКупону       = ПреобразоватьВЧисло(СтрокаСделки.Купон, -1); 
							СтрокаЗадолженностиПоСделке.КоличествоЗадолженностиПоБумагам = СтрокаСделки.БумагиКоличество;
							
						КонецЕсли;
							
				    	СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоБрокерскойКомиссии = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9], -1);
						СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоТорговойКомиссии   = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10], -1);
						
						ЗадолженностиПоСделкам.Добавить(СтрокаЗадолженностиПоСделке);

					Иначе
						
						СтрокаСделки.ОтложенноеИсполнение = Ложь;
											
					КонецЕсли;
					
					Сделки.Добавить(СтрокаСделки);
					
				ИначеЕсли Операция = "ЗадолженностьПоСделке" Тогда
									
					СтрокаЗадолженностиПоСделке = Новый Структура(СтрокаЗадолженностиПоСделкеШаблон);
					СтрокаЗадолженностиПоСделке.ИмяЗаписи = Операция;

					ДатаСделки = СокрЛП(ЗначПолейТаблицы[Инд][1]);
					ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаСделки, 8), Прав(ДатаСделки, 8));
					
					Если ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][3]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][3]);
						Сумма      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][6], -1);
						Купон      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][7], -1);
						
					ИначеЕсли ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][4]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][4], -1);
						Сумма      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][6]);
						Купон      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][7]);
						
					Иначе
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. В таблице [Ранее заключенные сделки, но не исполненные] не удалось определить количество ценных бумаг для сделки [" + СокрЛП(ЗначПолейТаблицы[Инд][2]) + "]");
						Возврат Неопределено;
						
					КонецЕсли;
					
					СтрокаЗадолженностиПоСделке.ДатаСделки                             = ДатаСделки;
					СтрокаЗадолженностиПоСделке.НомерСделки                            = СокрЛП(ЗначПолейТаблицы[Инд][2]);
					СтрокаЗадолженностиПоСделке.КодЦеннойБумаги                        = ПолучитьКодЦеннойБумаги(ЗначПолейТаблицы[Инд][0]);
					СтрокаЗадолженностиПоСделке.ВидСделки                              = ВидСделки;
					СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоСделке             = Сумма;
					СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоКупону             = Купон;
					СтрокаЗадолженностиПоСделке.КоличествоЗадолженностиПоБумагам       = Количество;
				    СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоБрокерскойКомиссии = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9], -1);
					СтрокаЗадолженностиПоСделке.СуммаЗадолженностиПоТорговойКомиссии   = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10], -1);
				
					ЗадолженностиПоСделкам.Добавить(СтрокаЗадолженностиПоСделке);
		   
				ИначеЕсли Операция = "ИсполнениеОбязательствПоСделке" Тогда
										
					СтрокаИсполненияПоСделке = Новый Структура(СтрокаСделкиШаблон);
					СтрокаИсполненияПоСделке.ИмяЗаписи = Операция;
					
					ДатаСделки = СокрЛП(ЗначПолейТаблицы[Инд][1]);
					ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаСделки, 8), Прав(ДатаСделки, 8));
									
					Если ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][3]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][3]);
						
					ИначеЕсли ЗначениеБольшеНуля(ЗначПолейТаблицы[Инд][4]) Тогда
						
						ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
						Количество = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][4]);
						
					Иначе
					
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. В таблице [Ранее заключенные сделки, по которым проведены расчеты] не удалось определить количество ценных бумаг для сделки [" + СокрЛП(ЗначПолейТаблицы[Инд][2]) + "]");
						Возврат Неопределено;
						
					КонецЕсли;
					
					СтрокаИсполненияПоСделке.ДатаСделки       = ДатаСделки;
					СтрокаИсполненияПоСделке.НомерСделки      = СокрЛП(ЗначПолейТаблицы[Инд][2]);
					СтрокаИсполненияПоСделке.КодЦеннойБумаги  = ПолучитьКодЦеннойБумаги(ЗначПолейТаблицы[Инд][0]);
					СтрокаИсполненияПоСделке.ВидСделки        = ВидСделки;
					СтрокаИсполненияПоСделке.БумагиКоличество = Количество;
					СтрокаИсполненияПоСделке.СуммаСделки      = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][6]);
					СтрокаИсполненияПоСделке.Купон            = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][7]);
					СтрокаИсполненияПоСделке.КомиссияБрокера  = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][9]);
					СтрокаИсполненияПоСделке.ТорговаяКомиссия = ПреобразоватьВЧисло(ЗначПолейТаблицы[Инд][10]);
					
					ДатаИсполнения = СокрЛП(ЗначПолейТаблицы[Инд][12]);
					ДатаИсполнения = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(ДатаИсполнения, 8));
					
					Если ДатаИсполнения = Неопределено Тогда
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату исполнения сделки [" + СтрокаИсполненияПоСделке.НомерСделки + "]");
						Возврат Неопределено;
						
					КонецЕсли;
					
					СтрокаИсполненияПоСделке.ДатаИсполнения = ДатаИсполнения;
					
					Сделки.Добавить(СтрокаИсполненияПоСделке);
															
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Операции.Сделки = Сделки;
	Операции.ЗадолженностиПоСделкам = ЗадолженностиПоСделкам;
			
	Возврат Операции;
		
КонецФункции

&НаКлиенте
Функция ДесериализоватьСделкиИЗадолженностиПоСделкамXLSX(ТабличныйДокументОтчета)
	
	Операции = Новый Структура("Сделки, ЗадолженностиПоСделкам");
	
	СтрокаСделкиШаблон = Новый ФиксированнаяСтруктура("ИмяЗаписи, НомерСделки, ДатаСделки, КодЦеннойБумаги, ВидСделки, БумагиКоличество, СтавкаРЕПО, СуммаСделки, Купон, КомиссияБрокера, ТорговаяКомиссия, ЧастьСделкиРЕПО, ОтложенноеИсполнение, ДатаИсполнения, ДатаОплатыКомиссии");
	СтрокаЗадолженностиПоСделкеШаблон = Новый ФиксированнаяСтруктура("ИмяЗаписи, НомерСделки, ДатаСделки, КодЦеннойБумаги, ВидСделки, СуммаЗадолженностиПоСделке, СуммаЗадолженностиПоКупону, СуммаЗадолженностиПоТорговойКомиссии, СуммаЗадолженностиПоБрокерскойКомиссии, КоличествоЗадолженностиПоБумагам");
	
	Сделки = Новый Массив;
	ЗадолженностиПоСделкам = Новый Массив;
	
	ЗаключенныеСделки = ПрочитатьТаблицуСделокXLSX(ТабличныйДокументОтчета);
	ЗаключенныеСделкиРЕПО = ПрочитатьТаблицуСделокРЕПОXLSX(ТабличныйДокументОтчета);
	
	Если ЗаключенныеСделкиРЕПО.Количество() > 0 Тогда
		Для Инд = 2 По ЗаключенныеСделкиРЕПО.Количество() - 1 Цикл
			Если СтрНачинаетсяС(ЗаключенныеСделкиРЕПО[Инд][0], "Итого") Тогда
				Прервать;
			КонецЕсли;
			
			СтрокаСделкиРепо = Новый Структура(СтрокаСделкиШаблон);
			СтрокаСделкиРепо.ИмяЗаписи = "СделкаРЕПО";
			
			ЧастьСделкиРЕПО = ЗаключенныеСделкиРЕПО[Инд][22];
			
			ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделкиРЕПО[Инд][2], ЗаключенныеСделкиРЕПО[Инд][3]);
			ДатаРасчетовПлан = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделкиРЕПО[Инд][18]);
			ДатаРасчетовФакт = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделкиРЕПО[Инд][19]);
			
			Если ЧастьСделкиРЕПО = "1" Тогда
				
				СтрокаСделкиРепо.ЧастьСделкиРепо = 1;
				СтавкаРепо = 0;
				СтрокаСделкиРепо.ДатаСделки = ДатаСделки;
				СтрокаСделкиРепо.ДатаОплатыКомиссии = ДатаСделки;
				
				Если СтрокаСделкиРепо.ДатаСделки = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату 1-ой ч. сделки Репо [" + НРег(СокрЛП(ЗаключенныеСделкиРЕПО[Инд][4])) + "]");
					Возврат Неопределено;
				КонецЕсли;
				
			ИначеЕсли ЧастьСделкиРЕПО = "2" Тогда
				
				СтрокаСделкиРепо.ЧастьСделкиРепо = 2;
				СтавкаРепо = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][14],,Ложь);
				СтрокаСделкиРепо.ДатаСделки = ДатаРасчетовПлан;
				СтрокаСделкиРепо.ДатаОплатыКомиссии = ДатаРасчетовПлан;
				
				Если СтрокаСделкиРепо.ДатаСделки = Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату 2-ой ч. сделки Репо [" + НРег(СокрЛП(ЗаключенныеСделкиРЕПО[Инд][4])) + "]");
					Возврат Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗаключенныеСделкиРЕПО[Инд][6] = "Покупка" Тогда
				ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
				Количество = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][7],,Ложь);
			ИначеЕсли ЗаключенныеСделкиРЕПО[Инд][6] = "Продажа" Тогда
				ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
				Количество = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][7], -1, Ложь);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить вид сделки Репо [" + НРег(СокрЛП(ЗаключенныеСделкиРЕПО[Инд][4])) + "] по значению полей: покупка [" + СокрЛП(ЗаключенныеСделкиРЕПО[Инд][7]) + "], продажа [" + СокрЛП(ЗаключенныеСделкиРЕПО[Инд][7]) + "]");
				Возврат Неопределено;	
			КонецЕсли;
			
			СтрокаСделкиРепо.НомерСделки        = НРег(СокрЛП(ЗаключенныеСделкиРЕПО[Инд][4]));
			СтрокаСделкиРепо.КодЦеннойБумаги    = ПолучитьКодЦеннойБумагиПоISIN(ЗаключенныеСделкиРЕПО[Инд][1], ЭтаФорма.ДатаСверки);
			СтрокаСделкиРепо.ВидСделки          = ВидСделки;
			СтрокаСделкиРепо.БумагиКоличество   = Количество;
			СтрокаСделкиРепо.СтавкаРепо         = СтавкаРепо;
			
			Если ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда 
				СтрокаСделкиРепо.СуммаСделки    = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][9], -1, Ложь);
			ИначеЕсли ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа") Тогда 
				СтрокаСделкиРепо.СуммаСделки    = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][9],,Ложь);
			КонецЕсли;
			
			Если ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
				СтрокаСделкиРепо.Купон          = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][10], -1, Ложь);
			ИначеЕсли ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа") Тогда
				СтрокаСделкиРепо.Купон          = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][10],,Ложь);
			КонецЕсли;
			
			СтрокаСделкиРепо.КомиссияБрокера    = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][15], -1, Ложь);
			СтрокаСделкиРепо.ТорговаяКомиссия   = ПреобразоватьВЧисло(ЗаключенныеСделкиРЕПО[Инд][17], -1, Ложь);
				
			Если ДатаРасчетовПлан > НачалоДня(ДатаСделки) И ЧастьСделкиРЕПО = "2" И НЕ ЗначениеЗаполнено(ДатаРасчетовФакт) Тогда
				
				СтрокаСделкиРепо.ОтложенноеИсполнение = Истина;
				СтрокаСделкиРепо.ДатаИсполнения       = ДатаРасчетовПлан;
				
				СтрокаЗадолженностиПоСделкеРепо = Новый Структура(СтрокаЗадолженностиПоСделкеШаблон);
				
				СтрокаЗадолженностиПоСделкеРепо.ДатаСделки      = ДатаСделки;
				СтрокаЗадолженностиПоСделкеРепо.НомерСделки     = СтрокаСделкиРепо.НомерСделки;
				СтрокаЗадолженностиПоСделкеРепо.ВидСделки       = СтрокаСделкиРепо.ВидСделки;
				СтрокаЗадолженностиПоСделкеРепо.КодЦеннойБумаги = СтрокаСделкиРепо.КодЦеннойБумаги;
				
				СтрокаЗадолженностиПоСделкеРепо.СуммаЗадолженностиПоСделке       = СтрокаСделкиРепо.СуммаСделки;
				СтрокаЗадолженностиПоСделкеРепо.СуммаЗадолженностиПоКупону       = СтрокаСделкиРепо.Купон; 
				СтрокаЗадолженностиПоСделкеРепо.КоличествоЗадолженностиПоБумагам = СтрокаСделкиРепо.БумагиКоличество;
				
				СтрокаЗадолженностиПоСделкеРепо.СуммаЗадолженностиПоБрокерскойКомиссии = СтрокаСделкиРепо.КомиссияБрокера;
				СтрокаЗадолженностиПоСделкеРепо.СуммаЗадолженностиПоТорговойКомиссии   = СтрокаСделкиРепо.ТорговаяКомиссия;
				
				ЗадолженностиПоСделкам.Добавить(СтрокаЗадолженностиПоСделкеРепо);
				
			Иначе
				СтрокаСделкиРепо.ОтложенноеИсполнение = Ложь;
			КонецЕсли;
			
			Сделки.Добавить(СтрокаСделкиРепо);
		КонецЦикла;
	КонецЕсли;
	Если ЗаключенныеСделки.Количество() > 0 Тогда
		
		Для Инд = 2 По ЗаключенныеСделки.Количество() - 1 Цикл
			
			Если СтрНачинаетсяС(ЗаключенныеСделки[Инд][0], "Итого") ИЛИ ЗаключенныеСделки[Инд][0] = "" Тогда
				Прервать;
			КонецЕсли;

			ДатаСделки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделки[Инд][2], ЗаключенныеСделки[Инд][3]);
			
			Если ДатаСделки = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить дату сделки [" + СокрЛП(ЗаключенныеСделки[Инд][4]) + "]");
				Возврат Неопределено;
			КонецЕсли;
			
			Если ЗаключенныеСделки[Инд][6] = "Покупка" Тогда
				ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
				Количество = ПреобразоватьВЧисло(ЗаключенныеСделки[Инд][7],,Ложь);
			ИначеЕсли ЗаключенныеСделки[Инд][6] = "Продажа" Тогда
				ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
				Количество = ПреобразоватьВЧисло(ЗаключенныеСделки[Инд][7], -1, Ложь);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить вид сделки [" + НРег(СокрЛП(ЗаключенныеСделки[Инд][4])) + "] по значению полей: покупка [" + СокрЛП(ЗаключенныеСделки[Инд][7]) + "], продажа [" + СокрЛП(ЗаключенныеСделки[Инд][7]) + "]");
				Возврат Неопределено;	
			КонецЕсли;
			
			ДатаРасчетовПлан = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделки[Инд][17], "00:00:00");
			ДатаРасчетовФакт = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ЗаключенныеСделки[Инд][18], "00:00:00");
			
			Если ЗначениеЗаполнено(ДатаРасчетовФакт) 
				И ДатаРасчетовФакт > НачалоДня(ДатаСделки) 
				И ДатаРасчетовПлан > НачалоДня(ЭтаФорма.ДатаСверки) Тогда
				
				ТекстСообщения = СтрШаблон("Сделка № %1 исполнена досрочно. 
					|Плановая дата расчетов (%2) больше даты сверки, но факт расчетов уже прошел (%3). 
					|Текущий алгоритм не рассчитан на этот сценарий.",
					СокрЛП(ЗаключенныеСделки[Инд][4]),
					Формат(ДатаРасчетовПлан, "ДФ=dd.MM.yyyy"),
					Формат(ДатаРасчетовФакт, "ДФ=dd.MM.yyyy"));
				
				ВызватьИсключение ТекстСообщения;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаРасчетовФакт) И ДатаРасчетовФакт > НачалоДня(ДатаСделки) Тогда
				
				СтрокаИсполненияПоСделке = Новый Структура(СтрокаСделкиШаблон);
				СтрокаИсполненияПоСделке.ИмяЗаписи = "ИсполнениеОбязательствПоСделке";
				
				Если ЗаключенныеСделки[Инд][6] = "Покупка" Тогда
					ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка");
					Количество = ПреобразоватьВЧисло(ЗаключенныеСделки[Инд][7],,Ложь);
				ИначеЕсли ЗаключенныеСделки[Инд][6] = "Продажа" Тогда
					ВидСделки  = ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа");
					Количество = ПреобразоватьВЧисло(ЗаключенныеСделки[Инд][7], -1, Ложь);
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формата файла. Не удалось определить вид сделки [" + НРег(СокрЛП(ЗаключенныеСделки[Инд][4])) + "] по значению полей: покупка [" + СокрЛП(ЗаключенныеСделки[Инд][7]) + "], продажа [" + СокрЛП(ЗаключенныеСделки[Инд][7]) + "]");
					Возврат Неопределено;	
				КонецЕсли;
				
				СтрокаИсполненияПоСделке.ДатаСделки       = ДатаСделки;
				СтрокаИсполненияПоСделке.НомерСделки      = СокрЛП(ЗаключенныеСделки[Инд][4]);
				СтрокаИсполненияПоСделке.КодЦеннойБумаги  = ПолучитьКодЦеннойБумагиПоISIN(ЗаключенныеСделки[Инд][1], ЭтаФорма.ДатаСверки);
				СтрокаИсполненияПоСделке.ВидСделки        = ВидСделки;
