&НаКлиенте
Функция ПрочитатьТаблицуСделокXLSX(ТабличныйДокументОтчета)
	
	Сделки = Новый Массив;
	
	// Ищем начало таблицы
	ОбластьЗаголовка = ТабличныйДокументОтчета.НайтиТекст("Сделки купли/продажи, заключённые в отчётном периоде, а также ранее заключённые сделки, подлежащие исполнению");
	Если ОбластьЗаголовка = Неопределено Тогда
		Возврат Сделки;
	КонецЕсли;
	
	НачальнаяСтрока = ОбластьЗаголовка.Низ + 2;
	МаксСтрок = ТабличныйДокументОтчета.ВысотаТаблицы;
	
	// Читаем заголовки
	СтрокаЗаголовков = Новый Массив;
	Для Колонка = 1 По 21 Цикл // Предполагаем максимум 21 колонка
		Значение = ТабличныйДокументОтчета.Область(НачальнаяСтрока, Колонка).Текст;
		СтрокаЗаголовков.Добавить(СокрЛП(Значение));
	КонецЦикла;
	Сделки.Добавить(СтрокаЗаголовков);
	
	// Читаем данные
	Для Счетчик = 1 По МаксСтрок - 1 Цикл
		ТекСтрока = НачальнаяСтрока + Счетчик;
		
		// Проверяем, есть ли данные в первой колонке
		ТекстПервойКолонки = ТабличныйДокументОтчета.Область(ТекСтрока, 1).Текст;
		Если ТекстПервойКолонки = "" ИЛИ СтрНачинаетсяС(ТекстПервойКолонки, "Итого") Тогда
			// Конец таблицы
			Прервать;
		КонецЕсли;
		
		// Читаем всю строку
		СтрокаДанных = Новый Массив;
		Для Колонка = 1 По 21 Цикл
			Значение = ТабличныйДокументОтчета.Область(ТекСтрока, Колонка).Текст;
			СтрокаДанных.Добавить(СокрЛП(Значение));
		КонецЦикла;
		
		Сделки.Добавить(СтрокаДанных);
	КонецЦикла;
	
	Возврат Сделки;
	
КонецФункции

