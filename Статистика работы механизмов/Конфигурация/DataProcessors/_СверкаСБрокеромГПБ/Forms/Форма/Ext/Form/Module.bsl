		СчетаДоверительногоУправленияИзОплат.Свернуть("СчетДоверительногоУправления");
			
		Для Каждого СтрокаСчетаДоверительногоУправленияИзОплат Из СчетаДоверительногоУправленияИзОплат Цикл
			
			ТаблицаСтрокОплатБрокерскойКомисссии = Оплаты.Скопировать(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления));
			
