&НаСервереБезКонтекста
Функция ПолучитьИменаВерсионируемыхБазДанных(Соединение)
	ТекстЗапроса =
		"SELECT Name
		|FROM sys.databases
		|WHERE NOT Name in ('master', 'model', 'msdb', 'tempdb', 'test', 'RepositoryTest', 'BCRM', 'Risk_Management_RH', 'Risk_model')
		|	AND state_desc <> 'OFFLINE'
		|ORDER BY Name";
	Попытка
		НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
		НаборЗаписей.Open(ТекстЗапроса, Соединение);
	Исключение
		Сообщить("Не удалось выполнить запрос: " + ТекстЗапроса);
		Сообщить("Система сообщает: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	БазыДанных = Новый Массив;
	Если Не (НаборЗаписей.EOF И НаборЗаписей.BOF) Тогда
		НаборЗаписей.MoveFirst(); // если набор пустой, эта процедура вызывает исключение
		Пока НаборЗаписей.EOF() = 0 Цикл
			БазыДанных.Добавить(НаборЗаписей.Fields.Item(0).Value);
			НаборЗаписей.MoveNext();
		КонецЦикла;
	КонецЕсли;
	
	Возврат БазыДанных;
КонецФункции

// Возвращаемое значение:
//	Булево - Добавление версионируемых объектов успешно выполнено.
&НаСервере
Функция ДобавитьВерсионируемыеОбъекты(БазаДанных, Соединение, ПереченьОбъектов = Неопределено)
	ТекстЗапроса =
	#Область ТекстЗапросаSQL
		"USE [<ИмяБазыДанных>]
		|
		|SELECT
		|	SCHEMA_NAME(schema_id) AS schema_name,
		|	object_id,
		|	name,
		|	NULL as parent,
		|	type,
		|	type_desc,
		|	create_date,
		|	modify_date
		|FROM sys.objects
		|WHERE
		|	type IN (
		|		'P', -- Процедура (Procedure)
		|		'IF', -- Встраиваемая табличная функция (Inline Table-Valued Function)
		|		'TF', -- Табличная функция (Table-Valued Function)
		|		'FN', -- Скалярная функция (Scalar Function)
		|		'V', -- Представление (View)
		|		'U' -- Пользовательская таблица (User Table)
		|	)
		|	-- Нас не интересуют индексы системных таблиц
		|	AND 1 = CASE
		|		WHEN type IN ('PK', 'UQ') AND SCHEMA_NAME(schema_id) = 'sys' THEN 0
		|		ELSE 1
		|	END
		|	AND <ИменаОбъектовДляЗапроса>
		|
		|UNION ALL
		|
		|SELECT
		|	SCHEMA_NAME([Objects].schema_id) AS schema_name,
		|	[Indexes].object_id,
		|	[Indexes].name,
		|	[Objects].name as parent,
		|	'I' AS type, -- 'I' Индекс (Index)
		|	[Indexes].type_desc,
		|	create_date,
		|	modify_date
		|FROM sys.indexes AS [Indexes]
		|	INNER JOIN sys.objects AS [Objects]
		|	ON [Indexes].object_id = [Objects].object_id
		|-- Нас интересуют индексы только пользовательских таблиц
		|WHERE SCHEMA_NAME(schema_id) <> 'sys'
		|	AND [Objects].type = 'U'
		|	AND [Indexes].name IS NOT NULL
		|	AND <ИменаИндексовДляЗапроса>
		|
		|UNION ALL
		|
		|SELECT
		|	SCHEMA_NAME([TableTypes].schema_id) AS schema_name,
		|	object_id,
		|	[TableTypes].name,
		|	[Objects].name AS parent,
		|	type, -- 'TT' - Табличный тип (Table Type)
		|	type_desc,
		|	create_date,
		|	modify_date
		|FROM sys.table_types AS [TableTypes]
		|	INNER JOIN sys.objects AS [Objects]
		|	ON [TableTypes].type_table_object_id = [Objects].object_id
		|WHERE <ИменаТабличныхТиповДляЗапроса>
		|
		|ORDER BY type";
	#КонецОбласти
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИмяБазыДанных>", БазаДанных);
	
	// Подставка в запрос отбора по именам объектов
	Если ПереченьОбъектов <> Неопределено И ТипЗнч(ПереченьОбъектов) = Тип("Массив") И ПереченьОбъектов.Количество() > 0 Тогда
		ИменаОбъектовДляЗапроса = Новый Массив;
		Для Каждого ИмяОбъекта Из ПереченьОбъектов Цикл
			ИменаОбъектовДляЗапроса.Добавить("'" + СокрЛП(ИмяОбъекта) + "'");
		КонецЦикла;
		ИменаОбъектовДляЗапроса = СтрСоединить(ИменаОбъектовДляЗапроса, ", ");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаОбъектовДляЗапроса>", "name IN (" + ИменаОбъектовДляЗапроса + ")");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаИндексовДляЗапроса>", "[Indexes].name IN (" + ИменаОбъектовДляЗапроса + ")");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаТабличныхТиповДляЗапроса>", "[TableTypes].name IN (" + ИменаОбъектовДляЗапроса + ")");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаОбъектовДляЗапроса>", "1 = 1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаИндексовДляЗапроса>", "1 = 1");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИменаТабличныхТиповДляЗапроса>", "1 = 1");
	КонецЕсли;
	
	Попытка
		НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
		НаборЗаписей.Open(ТекстЗапроса, Соединение);
	Исключение
		Сообщить("Не удалось выполнить запрос: " + ТекстЗапроса);
		Сообщить("Ошибка при попытке выполнения запроса: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Если Не (НаборЗаписей.EOF И НаборЗаписей.BOF) Тогда
		НаборЗаписей.MoveFirst(); // Если набор пустой, эта процедура вызывает исключение
		Пока НаборЗаписей.EOF() = 0 Цикл
			НоваяСтрокаВерсионируемыеОбъекты = ВерсионируемыеОбъекты.Добавить();
			НоваяСтрокаВерсионируемыеОбъекты.БазаДанных		= БазаДанных;
			НоваяСтрокаВерсионируемыеОбъекты.Схема			= НаборЗаписей.Fields.Item(0).Value; // schema_name
			НоваяСтрокаВерсионируемыеОбъекты.Идентификатор	= НаборЗаписей.Fields.Item(1).Value; // object_id
			НоваяСтрокаВерсионируемыеОбъекты.Имя			= НаборЗаписей.Fields.Item(2).Value; // name
			НоваяСтрокаВерсионируемыеОбъекты.Родитель		= НаборЗаписей.Fields.Item(3).Value; // parent
			НоваяСтрокаВерсионируемыеОбъекты.Тип			= НаборЗаписей.Fields.Item(4).Value; // type
			НоваяСтрокаВерсионируемыеОбъекты.ГруппаОбъектов	= НаборЗаписей.Fields.Item(5).Value; // type_desc
			НоваяСтрокаВерсионируемыеОбъекты.ДатаСоздания	= НаборЗаписей.Fields.Item(6).Value; // create_date
			НоваяСтрокаВерсионируемыеОбъекты.ДатаИзменения	= НаборЗаписей.Fields.Item(7).Value; // modify_date
			
			НоваяСтрокаВерсионируемыеОбъекты.Тип = СокрЛП(НоваяСтрокаВерсионируемыеОбъекты.Тип);
			
			Если СокрЛП(НоваяСтрокаВерсионируемыеОбъекты.Схема) = ""
				Или СокрЛП(НоваяСтрокаВерсионируемыеОбъекты.Имя) = ""
			Тогда
				Сообщить("Недостаточно данных или нет доступа к данным для идентификации объекта SQL:" + Символы.ПС
					+ "(База данных: " + БазаДанных
						+ ", Идентификатор: " + Формат(НоваяСтрокаВерсионируемыеОбъекты.Идентификатор, "ЧГ=")
						+ ", Схема: " + ?(НоваяСтрокаВерсионируемыеОбъекты.Схема = NULL, "NULL", НоваяСтрокаВерсионируемыеОбъекты.Схема)
						+ ", Имя: "+ НоваяСтрокаВерсионируемыеОбъекты.Имя + ")"
				);
				Возврат Неопределено;
			КонецЕсли;
			
			НаборЗаписей.MoveNext();
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции // ПолучитьВерсионируемыеОбъекты

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаКодаВерсионируемогоОбъекта(ВерсионируемыйОбъект)
	ТекстЗапроса = "";
	
	Если ВерсионируемыйОбъект.Тип = "P" // Procedure
		Или ВерсионируемыйОбъект.Тип = "IF" // Inline Table-Valued Function
		Или ВерсионируемыйОбъект.Тип = "TF" // Table-Valued Function
		Или ВерсионируемыйОбъект.Тип = "FN" // Scalar Function
		Или ВерсионируемыйОбъект.Тип = "V" // View
	Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|USE [<Database>]
			|EXEC sp_helptext '<Schema>.<ObjectName>'";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Database>", ВерсионируемыйОбъект.БазаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Schema>", ВерсионируемыйОбъект.Схема);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ObjectName>", ВерсионируемыйОбъект.Имя);
	ИначеЕсли ВерсионируемыйОбъект.Тип = "U" Тогда // User Table
		ТекстЗапроса = ТекстЗапроса + "
			|USE [master]
			|EXEC [dbo].[P_HelpTable]
			|	@Database = '<Database>',
			|	@Schema = '<Schema>',
			|	@TableName = '<TableName>',
			|	@IncludeUseDatabase = 0,
			|	@CollapseStrings = 1";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Database>", ВерсионируемыйОбъект.БазаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Schema>", ВерсионируемыйОбъект.Схема);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<TableName>", ВерсионируемыйОбъект.Имя);
	ИначеЕсли ВерсионируемыйОбъект.Тип = "I" Тогда // Index
		ТекстЗапроса = ТекстЗапроса + "
			|USE [master]
			|EXEC [dbo].[P_HelpIndex]
			|	@Database = '<Database>',
			|	@Schema = '<Schema>',
			|	@TableName = '<TableName>',
			|	@IndexName = '<IndexName>',
			|	@IncludeUseDatabase = 0,
			|	@CollapseStrings = 1";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Database>", ВерсионируемыйОбъект.БазаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Schema>", ВерсионируемыйОбъект.Схема);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<TableName>", ВерсионируемыйОбъект.Родитель);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<IndexName>", ВерсионируемыйОбъект.Имя);
	ИначеЕсли ВерсионируемыйОбъект.Тип = "TT" Тогда // Type Table
		ТекстЗапроса = ТекстЗапроса + "
			|USE [master]
			|EXEC [dbo].[P_HelpTableType]
			|	@Database = '<Database>',
			|	@Schema = '<Schema>',
			|	@TableTypeName = '<TableTypeName>',
			|	@IncludeUseDatabase = 0,
			|	@CollapseStrings = 1";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Database>", ВерсионируемыйОбъект.БазаДанных);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Schema>", ВерсионируемыйОбъект.Схема);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<TableTypeName>", ВерсионируемыйОбъект.Имя);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
КонецФункции

&НаКлиенте
Процедура КомандаВыгрузить(Команда)
	ЗаполнитьВерсионируемыеОбъекты();
	СоздатьНедостающиеКаталоги();
	СохранитьИсходныеКодыВерсионируемыхОбъектов();
	Сообщить("Выполнение обработки завершено");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВерсионируемыеОбъекты()
	Если ЭтаФорма.ТолькоУказанныеОбъекты Тогда
		ПереченьОбъектов = СтрРазделить(ЭтаФорма.УказанныеОбъекты, ",", "");
	Иначе
		ПереченьОбъектов = Неопределено;
	КонецЕсли;
	
	// Открытие соединения с SQL
	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = Объект.СтрокаСоединенияССервером;
		Соединение.Open();
	Исключение
		Сообщить("Не удалось установить соединение с сервером SQL. Система сообщает: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Получение и выгрузка кода версионируемых объектов
	ВерсионируемыеОбъекты.Очистить();
	
	Попытка
		Для Каждого СтрокаБазДанных Из СписокБазДанных Цикл
			Если Не СтрокаБазДанных.Пометка Тогда
				Продолжить;
			КонецЕсли;
			Если Не ДобавитьВерсионируемыеОбъекты(СтрокаБазДанных.Значение, Соединение, ПереченьОбъектов) Тогда
				ВерсионируемыеОбъекты.Очистить();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Произошла попытка при получении и выгрузки кода версионируемых объектов:" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	// Закрытие соединения с SQL
	Попытка
		Соединение.Close();
	Исключение
		Сообщить("Не удалось закрыть соединение с сервером SQL. Система сообщает: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры // ВыгрузитьИсходныеКоды

&НаКлиенте
Процедура СоздатьНедостающиеКаталоги()
	ВерсионируемыеОбъекты.Сортировать("БазаДанных, Схема, ГруппаОбъектов");
	
	// Создание каталогов 1 уровня: Базы данных
	ТекущаяБазаДанных = Неопределено;
	Для Каждого ТекущаяСтрока Из ВерсионируемыеОбъекты Цикл
		// Поиск следующего уникального сочетания измерений
		Если ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных Тогда
			Продолжить;
		Иначе
			ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных;
		КонецЕсли;
		
		КаталогБазыДанных = Объект.КаталогВыгрузки + ?(Прав(Объект.КаталогВыгрузки, 1) = "\", "", "\") + ТекущаяСтрока.БазаДанных;
		Файл = Новый Файл(КаталогБазыДанных);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогБазыДанных);
			Сообщить("Создан каталог: " + КаталогБазыДанных);
		КонецЕсли;
	КонецЦикла;
	
	// Создание каталогов 2 уровня: Схемы
	ТекущаяБазаДанных = Неопределено;
	ТекущаяСхема = Неопределено;
	Для Каждого ТекущаяСтрока Из ВерсионируемыеОбъекты Цикл
		// Поиск следующего уникального сочетания измерений
		Если ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных
			И ТекущаяСхема = ТекущаяСтрока.Схема
		Тогда
			Продолжить;
		Иначе
			ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных;
			ТекущаяСхема = ТекущаяСтрока.Схема;
		КонецЕсли;
		
		КаталогСхемы = Объект.КаталогВыгрузки + ?(Прав(Объект.КаталогВыгрузки, 1) = "\", "", "\") + ТекущаяСтрока.БазаДанных + "\" + ТекущаяСтрока.Схема;
		Файл = Новый Файл(КаталогСхемы);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогСхемы);
			Сообщить("Создан каталог: " + КаталогСхемы);
		КонецЕсли;
	КонецЦикла;
	
	// Создание каталогов 3 уровня: Группы объектов
	ТекущаяБазаДанных = Неопределено;
	ТекущаяСхема = Неопределено;
	ТекущаяГруппаОбъектов = Неопределено;
	Для Каждого ТекущаяСтрока Из ВерсионируемыеОбъекты Цикл
		// Поиск следующего уникального сочетания измерений
		Если ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных
			И ТекущаяСхема = ТекущаяСтрока.Схема
			И ТекущаяГруппаОбъектов = ТекущаяСтрока.ГруппаОбъектов
		Тогда
			Продолжить;
		Иначе
			ТекущаяБазаДанных = ТекущаяСтрока.БазаДанных;
			ТекущаяСхема = ТекущаяСтрока.Схема;
			ТекущаяГруппаОбъектов = ТекущаяСтрока.ГруппаОбъектов;
		КонецЕсли;
		
		КаталогГруппыОбъектов = Объект.КаталогВыгрузки + ?(Прав(Объект.КаталогВыгрузки, 1) = "\", "", "\")
			+ ТекущаяСтрока.БазаДанных + "\" + ТекущаяСтрока.Схема + "\" + ТекущаяСтрока.ГруппаОбъектов;
		Файл = Новый Файл(КаталогГруппыОбъектов);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогГруппыОбъектов);
			Сообщить("Создан каталог: " + КаталогГруппыОбъектов);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьИсходныеКодыВерсионируемыхОбъектов()
	// Открытие соединения с SQL
	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = Объект.СтрокаСоединенияССервером;
		Соединение.Open();
	Исключение
		Сообщить("Не удалось установить соединение с сервером SQL. Система сообщает: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Выгрузка исходных кодов версионируемых объектов
	Для Каждого ВерсионируемыйОбъект Из ВерсионируемыеОбъекты Цикл
		ТекстЗапроса = ПолучитьТекстЗапросаКодаВерсионируемогоОбъекта(ВерсионируемыйОбъект);
		
		Попытка
			НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
			НаборЗаписей.Open(ТекстЗапроса, Соединение);
		Исключение
			Сообщить("Не удалось выполнить запрос: " + ТекстЗапроса);
			Сообщить("Система сообщает: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		ИсходныйКод = "";
		Если Не (НаборЗаписей.EOF И НаборЗаписей.BOF) Тогда
			НаборЗаписей.MoveFirst(); // Если набор пустой, эта процедура вызывает исключение
			Пока НаборЗаписей.EOF() = 0 Цикл
				ИсходныйКод = ИсходныйКод + НаборЗаписей.Fields.Item(0).Value;
				НаборЗаписей.MoveNext();
			КонецЦикла;
		КонецЕсли;
		
		ИмяФайла = Объект.КаталогВыгрузки
			+ ?(Прав(Объект.КаталогВыгрузки, 1) = "\", "", "\") + ВерсионируемыйОбъект.БазаДанных
			+ "\" + ВерсионируемыйОбъект.Схема
			+ "\" + ВерсионируемыйОбъект.ГруппаОбъектов
			+ "\" + ВерсионируемыйОбъект.Имя + ".sql";
		
		Текст = Новый ТекстовыйДокумент;
		Текст.ДобавитьСтроку(ИсходныйКод);
		Текст.Записать(ИмяФайла, КодировкаТекста.UTF8, "");
		
		// Отловил очень странную фигню
		// на примере файла \\ap69\Developers\Арчи\Temp\RiskManagement\4060\dbo\SQL_SCALAR_FUNCTION\FT_GetBondPayments.sql
		// 	СтрДлина(ИсходныйКод) = 2120
		// 	СтрДлина(Текст.ПолучитьТекст()) = 2121
		// при записи текста 1С автоматически добавляет в конце файла символ LF
		// и всё бы ничего, но гит преобразует этот символ к CRLF, что дает постоянные расхождения
		// также возможен вариант, когда при попытке git add выдается сообщение Git fatal: LF would be replaced by CRLF
	КонецЦикла;
	
	// Закрытие соединения с SQL
	Попытка
		Соединение.Close();
	Исключение
		Сообщить("Не удалось закрыть соединение с сервером SQL. Система сообщает: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры

