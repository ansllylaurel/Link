#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Организация_РЭМ 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	Объект.Организация			= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Если ЭтаФорма.Организация_РЭМ <> Объект.Организация Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка работает только в организации РЭМ.",,,, Отказ);
	КонецЕсли;
	
	ВосстановитьШаблоныИзНастройки();
	ЗаполнитьСписокВыбораНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтаФорма.СохраняемыеВНастройкахДанныеМодифицированы = Истина;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	НастройкаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьШаблоныИзНастройки()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкаШаблоныНазначенияПлатежа = ХранилищеОбщихНастроек.Загрузить("_ВыгрузкаПлатежейВБанкКлиент", "НастройкиНазначенияПлатежа", , "ВсеПользователи");
	
	Если НастройкаШаблоныНазначенияПлатежа <> Неопределено
		И НастройкаШаблоныНазначенияПлатежа.Колонки.Количество() = 5 Тогда
		Объект.НастройкиНазначенияПлатежа.Загрузить(НастройкаШаблоныНазначенияПлатежа);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Если ЭтаФорма.Организация_РЭМ <> ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация") Тогда
		Предупреждение("Выгрузка работает только в организации РЭМ.");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СобытияЭлементовФормы

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогВыгрузки; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогВыгрузки = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогВыгрузки + "\");
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитОтбораПриИзменении(Элемент)
	
	ОбновитьОплатыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	
	НастройкаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НастройкаПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ЭтаФорма.Настройка) Тогда
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Идентификатор", Новый УникальныйИдентификатор(ЭтаФорма.Настройка));
		
		НайденныеСтроки = Объект.НастройкиНазначенияПлатежа.НайтиСтроки(ПараметрыПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Объект, НайденныеСтроки[0], "Контрагент,РасчетныйСчетПолучателя,Шаблон");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.РасчетныйСчетПолучателя.ДатаЗакрытия) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчётный счёт получателя закрыт. Исправьте настройку.",, "РасчетныйСчетПолучателя", "Объект");
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьОплатыНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаСервере
Процедура ОбновитьОплатыНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Период) Тогда
		ЭтаФорма.Оплаты.Очистить();
		Возврат;
	КонецЕсли;
	
	ПараметрыШаболона = РеквизитФормыВЗначение("Объект").ПолучитьПараметрыШаблона();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплаты.Оплата КАК Оплата,
		|	Оплаты.Выгружать КАК Выгружать,
		|	Оплаты.Сумма КАК Сумма,
		|	Оплаты.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ ВТ_Оплаты
		|ИЗ
		|	&Оплаты КАК Оплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ДепозитарныйСчетДоговор.НомерДоговора КАК НомерДоговораСпецДепа,
		|	ВложенныйЗапрос.ДепозитарныйСчетДоговор.ДатаЗаключения КАК ДатаДоговораСпецДепа
		|ПОМЕСТИТЬ ВТ_ДоговорыСоСпецДепом
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор КАК ДепозитарныйСчетДоговор
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|	ГДЕ
		|		ИсполнителиПоЦеннымБумагам.Организация = &Организация
		|		И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.Контрагент = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо
		|		И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &ДатаНачала
		|				ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ВТ_Оплаты.Выгружать, ЛОЖЬ) КАК Выгружать,
		|	ОплатаОснования.Ссылка.Дата КАК ДатаОплаты,
		|	ОплатаОснования.Ссылка КАК Оплата,
		|	ОплатаОснования.Сумма КАК Сумма,
		|	ОплатаОснования.Ссылка.Контрагент КАК Контрагент,
		|	ОплатаОснования.Валюта КАК Валюта,
		|	ОплатаОснования.Ссылка.РасчетныйСчет.Банк КАК Банк,
		|	ОплатаОснования.Ссылка.ВидЗадолженности КАК ВидЗадолженности,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОплатаОснования.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
		|	ОплатаОснования.Основание.ВидВходящегоДокумента КАК ВидВходящегоДокумента,
		|	ОплатаОснования.Основание.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ОплатаОснования.Основание.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	ОплатаОснования.Ссылка.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговораДУ,
		|	ВТ_ДоговорыСоСпецДепом.ДатаДоговораСпецДепа КАК ДатаДоговораСпецДепа,
		|	ВТ_ДоговорыСоСпецДепом.НомерДоговораСпецДепа КАК НомерДоговораСпецДепа,
		|	ОплатаОснования.Основание.Договор.ДатаЗаключения КАК ДатаДоговораНачисления,
		|	ОплатаОснования.Основание.Договор.НомерДоговора КАК НомерДоговораНачисления
		|ПОМЕСТИТЬ ВТ_Оплаты2
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оплаты КАК ВТ_Оплаты
		|		ПО ОплатаОснования.Ссылка = ВТ_Оплаты.Оплата
		|			И ОплатаОснования.Ссылка.Контрагент = ВТ_Оплаты.Контрагент
		|			И ОплатаОснования.Сумма = ВТ_Оплаты.Сумма
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДоговорыСоСпецДепом КАК ВТ_ДоговорыСоСпецДепом
		|		ПО ОплатаОснования.Ссылка.СчетДоверительногоУправления = ВТ_ДоговорыСоСпецДепом.СчетДоверительногоУправления
		|ГДЕ
		|	ОплатаОснования.Ссылка.Организация = &Организация
		|	И ОплатаОснования.Ссылка.Проведен
		|	И ОплатаОснования.Ссылка.ВидЗадолженности В(&ВидыЗадолженности)
		|	И (&Банк = ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
		|			ИЛИ ОплатаОснования.Ссылка.РасчетныйСчет.Банк = &Банк)
		|	И (&Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ИЛИ ОплатаОснования.Ссылка.Контрагент = &Контрагент)
		|	И (&СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|			ИЛИ ОплатаОснования.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И (&РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ИЛИ ОплатаОснования.Ссылка.РасчетныйСчет = &РасчетныйСчет)
		|	И ОплатаОснования.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ДатаОплаты КАК ДатаОплаты,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент
		|ПОМЕСТИТЬ ВТ_КлиентыДУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_Оплаты2.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ВТ_Оплаты2.ДатаОплаты КАК ДатаОплаты,
		|		МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК ДатаКлиента
		|	ИЗ
		|		ВТ_Оплаты2 КАК ВТ_Оплаты2
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|			ПО ВТ_Оплаты2.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|				И ВТ_Оплаты2.ДатаОплаты >= КлиентыДоверительногоУправления.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_Оплаты2.СчетДоверительногоУправления,
		|		ВТ_Оплаты2.ДатаОплаты) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.ДатаКлиента = КлиентыДоверительногоУправления.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Оплаты2.Выгружать КАК Выгружать,
		|	ВТ_Оплаты2.ДатаОплаты КАК ДатаОплаты,
		|	ВТ_Оплаты2.Оплата КАК Оплата,
		|	ВТ_Оплаты2.Сумма КАК Сумма,
		|	ВТ_Оплаты2.Контрагент КАК Контрагент,
		|	ВТ_Оплаты2.Валюта КАК Валюта,
		|	ВТ_Оплаты2.Банк КАК Банк,
		|	ВТ_Оплаты2.ВидЗадолженности КАК ВидЗадолженности,
		|	ВТ_Оплаты2.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_Оплаты2.РасчетныйСчет КАК РасчетныйСчет,
		|	ВТ_Оплаты2.ВидВходящегоДокумента КАК ВидВходящегоДокумента,
		|	ВТ_Оплаты2.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ВТ_Оплаты2.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ВТ_Оплаты2.НомерДоговораДУ КАК НомерДоговораДУ,
		|	ВТ_Оплаты2.ДатаДоговораДУ КАК ДатаДоговораДУ,
		|	ВТ_Оплаты2.ДатаДоговораСпецДепа КАК ДатаДоговораСпецДепа,
		|	ВТ_Оплаты2.НомерДоговораСпецДепа КАК НомерДоговораСпецДепа,
		|	ВТ_Оплаты2.ДатаДоговораНачисления КАК ДатаДоговораНачисления,
		|	ВТ_Оплаты2.НомерДоговораНачисления КАК НомерДоговораНачисления,
		|	ВТ_КлиентыДУ.Клиент.Наименование КАК НаименованиеКлиента
		|ИЗ
		|	ВТ_Оплаты2 КАК ВТ_Оплаты2
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КлиентыДУ КАК ВТ_КлиентыДУ
		|		ПО ВТ_Оплаты2.СчетДоверительногоУправления = ВТ_КлиентыДУ.СчетДоверительногоУправления
		|			И ВТ_Оплаты2.ДатаОплаты = ВТ_КлиентыДУ.ДатаОплаты";
	
	Запрос.УстановитьПараметр("ДатаНачала"					, Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"				, Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"					, Объект.Организация);
	Запрос.УстановитьПараметр("ВидыЗадолженности"			, ЭтаФорма.ВидыЗадолженностей.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Контрагент"					, Объект.Контрагент);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Банк"						, Объект.Банк);
	Запрос.УстановитьПараметр("РасчетныйСчет"				, Объект.РасчетныйСчет);
	Запрос.УстановитьПараметр("Оплаты"						, ЭтаФорма.Оплаты.Выгрузить());
	
	ЭтаФорма.Оплаты.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаОплаты = ЭтаФорма.Оплаты.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, Выборка);
		
		Для Каждого ПараметрШаблона Из ПараметрыШаболона Цикл
			ПараметрыШаболона[ПараметрШаблона.Ключ] = СериализоватьЗначение(ПараметрШаблона.Ключ, Выборка);
		КонецЦикла;
		
		СтрокаОплаты.НазначениеПлатежа = РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(Объект.Шаблон, ПараметрыШаболона);

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыУправлениеФлажками(Команда)
	
	Для Каждого СтрокаОплаты Из ЭтаФорма.Оплаты Цикл
		СтрокаОплаты.Выгружать = (Команда = ЭтаФорма.Команды.ОплатыУстановитьФлажки);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВыгрузкуВФормате1CClientBankExchange(Отказ, ВключитьВДанныеТекстПисьма = ЛОЖЬ)
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, СчетДоверительногоУправления, Период, Контрагент, Банк, КаталогВыгрузки, РасчетныйСчетПолучателя, РасчетныйСчет, НомерПлатежногоПоручения, НазначениеПлатежа"); 
	Механизм = "_ВыгрузкаПлатежейВБанкКлиент.Форма.ПолучитьВыгрузкуВФормате1CClientBankExchange()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	ДанныеВыгрузки = Новый Структура("Документы,Вложения", Новый Массив, Новый Массив);
	
	ПараметрыВыгрузки = ПолучитьПараметрыВыгрузки(Объект.Банк);
	
	Для Каждого СтрокаПараметра Из ПараметрыВыгрузки.НайтиСтроки(Новый Структура("Секция", "ОбщиеСведения")) Цикл
		
		ДанныеВыгрузки.Вставить(СтрокаПараметра.ИмяПараметра, СтрокаПараметра.Значение);
		
		Если СтрокаПараметра.Параметр = "ДатаНачала" Тогда
			ДанныеВыгрузки[СтрокаПараметра.ИмяПараметра] = Формат(Объект.Период.ДатаНачала, "ДФ=dd.MM.yyyy");
		ИначеЕсли СтрокаПараметра.Параметр = "ДатаОкончания" Тогда
			ДанныеВыгрузки[СтрокаПараметра.ИмяПараметра] = Формат(Объект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Оплаты.Оплата КАК Документ.Оплата) КАК Оплата,
		|	ВЫРАЗИТЬ(Оплаты.Выгружать КАК БУЛЕВО) КАК Выгружать,
		|	ВЫРАЗИТЬ(Оплаты.Сумма КАК ЧИСЛО) КАК Сумма,
		|	ВЫРАЗИТЬ(Оплаты.Контрагент КАК Справочник.ЮрФизЛица) КАК Контрагент,
		|	ВЫРАЗИТЬ(&РасчетныйСчетПолучателя КАК Справочник.БанковскиеСчета) КАК РасчетныйСчетПолучателя,
		|	ВЫРАЗИТЬ(Оплаты.НазначениеПлатежа КАК СТРОКА(200)) КАК НазначениеПлатежа
		|ПОМЕСТИТЬ ВТ_Оплаты
		|ИЗ
		|	&Оплаты КАК Оплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЮрФизЛица.Ссылка КАК Контрагент
		|ПОМЕСТИТЬ _КонтрагентыДляКППКрупнейшего
		|ИЗ
		|	РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОкончания, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ИменованныеОбъекты.Объект = СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО (ЮрФизЛица.Ссылка = ИменованныеОбъекты.Объект
		|				ИЛИ ЮрФизЛица.Ссылка = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо)
		|ГДЕ
		|	ИменованныеОбъекты.Имя = ""ЮрФизЛицо_ФНС9""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК Наименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика КАК КППКрупнейшегоНалогоплательщика
		|ПОМЕСТИТЬ _РеквизитыПлательщика
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.КПП КАК КПП
		|ПОМЕСТИТЬ _РеквизитыПолучателя
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&ДатаОкончания,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо,
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество,
		|	РеквизитыФизическихЛицСрезПоследних.ИНН,
		|	NULL
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Оплаты.Оплата.Дата КАК Дата,
		|	ВТ_Оплаты.Сумма КАК Сумма,
		|	ВТ_Оплаты.РасчетныйСчетПолучателя.Банк.Код КАК РасчетныйСчетПолучателяБанкБИК,
		|	ВТ_Оплаты.РасчетныйСчетПолучателя.НомерСчета КАК РасчетныйСчетПолучателяНомерСчета,
		|	ВТ_РеквизитыПолучателя.ИНН КАК КонтрагентИНН,
		|	ВТ_РеквизитыПолучателя.КПП КАК КонтрагентКПП,
		|	ВТ_РеквизитыПолучателя.Наименование КАК КонтрагентНаименование,
		|	ВТ_Оплаты.РасчетныйСчетПолучателя.Банк.Наименование КАК РасчетныйСчетПолучателяБанкНаименование,
		|	ВТ_Оплаты.РасчетныйСчетПолучателя.Банк.КоррСчет КАК РасчетныйСчетПолучателяБанкКоррСчет,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.НомерСчета КАК РасчетныйСчетНомерСчета,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК РасчетныйСчетНаименованиеВладельцаДляДокументов,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.Банк.Наименование КАК РасчетныйСчетБанкНаименование,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.Банк.Город КАК РасчетныйСчетБанкГород,
		|	_РеквизитыПлательщика.ИНН КАК ПлательщикИНН,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.Банк.КоррСчет КАК РасчетныйСчетБанкКоррСчет,
		|	ВЫБОР
		|		КОГДА _КонтрагентыДляКППКрупнейшего.Контрагент ЕСТЬ НЕ NULL 
		|			ТОГДА _РеквизитыПлательщика.КППКрупнейшегоНалогоплательщика
		|		ИНАЧЕ _РеквизитыПлательщика.КПП
		|	КОНЕЦ КАК ПлательщикКПП,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.Банк.Код КАК РасчетныйСчетБанкБИК,
		|	ВТ_Оплаты.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ВТ_Оплаты.РасчетныйСчетПолучателя.Банк.Город КАК РасчетныйСчетПолучателяБанкГород,
		|	ВТ_Оплаты.Оплата.РасчетныйСчет.ЮрФизЛицо КАК ПлательщикЮрФизЛицо,
		|	_КонтрагентыДляКППКрупнейшего.Контрагент ЕСТЬ НЕ NULL  КАК ДолженБытьКППКрупнейшегоНалогоплательщика
		|ИЗ
		|	ВТ_Оплаты КАК ВТ_Оплаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыПолучателя КАК ВТ_РеквизитыПолучателя
		|		ПО ВТ_Оплаты.Контрагент = ВТ_РеквизитыПолучателя.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыПлательщика КАК _РеквизитыПлательщика
		|		ПО ВТ_Оплаты.Оплата.РасчетныйСчет.ЮрФизЛицо = _РеквизитыПлательщика.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыБанкаПолучателя
		|		ПО ВТ_Оплаты.РасчетныйСчетПолучателя.Банк.ЮрФизЛицо = РеквизитыБанкаПолучателя.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КонтрагентыДляКППКрупнейшего КАК _КонтрагентыДляКППКрупнейшего
		|		ПО ВТ_Оплаты.Контрагент = _КонтрагентыДляКППКрупнейшего.Контрагент
		|ГДЕ
		|	ВТ_Оплаты.Выгружать
		|	И ВТ_Оплаты.Оплата.РасчетныйСчет.Банк = &Банк";
	
	Запрос.УстановитьПараметр("Организация"					, Объект.Организация);
	Запрос.УстановитьПараметр("ДатаОкончания"				, Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Контрагент"					, Объект.Контрагент);
	Запрос.УстановитьПараметр("Банк"						, Объект.Банк);
	Запрос.УстановитьПараметр("РасчетныйСчетПолучателя"		, Объект.РасчетныйСчетПолучателя);
	Запрос.УстановитьПараметр("Оплаты"						, ЭтаФорма.Оплаты.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ПустаяСтрока(Выборка.ПлательщикКПП) И Выборка.ДолженБытьКППКрупнейшегоНалогоплательщика Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("У плательщика %1 в анкетных данных не указан КПП крупнейшего налогоплательщика",
					Выборка.ПлательщикЮрФизЛицо),,,, Отказ);
		КонецЕсли;
		
		Документ = Новый Структура;
		
		Для Каждого СтрокаПараметра Из ПараметрыВыгрузки.НайтиСтроки(Новый Структура("Секция", "Документ")) Цикл
			Если ЗначениеЗаполнено(СтрокаПараметра.Параметр) Тогда
				Документ.Вставить(СтрокаПараметра.ИмяПараметра, СериализоватьЗначение(СтрокаПараметра.Параметр, Выборка));
			Иначе
				Документ.Вставить(СтрокаПараметра.ИмяПараметра, СтрокаПараметра.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ДанныеВыгрузки.Документы.Добавить(Документ);
		
	КонецЦикла;
	
	Если ВключитьВДанныеТекстПисьма Тогда
		
		
		РеквизитОбъект	= РеквизитФормыВЗначение("Объект");
		ШаблонЗаявки	= РеквизитОбъект.ПолучитьМакет("ШаблонЗаявки");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстПисьма = Новый ТабличныйДокумент;
			
			ЗаполнитьЗначенияСвойств(ШаблонЗаявки.Параметры, Выборка);
			
		    ШаблонЗаявки.Параметры.БанкОтправителя =	Выборка.РасчетныйСчетБанкНаименование + "
														|Р/С " + Выборка.РасчетныйСчетНомерСчета + "
														|" + Выборка.РасчетныйСчетНаименованиеВладельцаДляДокументов;
			
			ТекстПисьма.Вывести(ШаблонЗаявки);
			ТекстПисьма.АвтоМасштаб = Истина;
			
			ДанныеВыгрузки.Вложения.Добавить(ТекстПисьма);
			
		КонецЦикла;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ДанныеВыгрузки;
	
КонецФункции

&НаКлиенте
Процедура СохранитьФайлСПлатежками(ИмяФайла, ДанныеВыгрузки)
	
	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.ANSI);
	ЗаписьТекста.ЗаписатьСтроку("1CClientBankExchange");
	
	Для Каждого ЭлементДанных Из ДанныеВыгрузки Цикл
		Если ЭлементДанных.Ключ = "Документы"
			ИЛИ ЭлементДанных.Ключ = "Вложения" Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьТекста.ЗаписатьСтроку(ЭлементДанных.Ключ + "=" + ЭлементДанных.Значение);
	КонецЦикла;
	
	НомерДокумента = Объект.НомерПлатежногоПоручения;
	
	Для Каждого Документ Из ДанныеВыгрузки.Документы Цикл
		Документ.Вставить("Номер", Формат(НомерДокумента, "ЧГ=0"));
		НомерДокумента = НомерДокумента + 1;
		
		Для Каждого ЭлементДанных Из Документ Цикл
			ЗаписьТекста.ЗаписатьСтроку(ЭлементДанных.Ключ + "=" + ЭлементДанных.Значение);
		КонецЦикла;
		
		ЗаписьТекста.ЗаписатьСтроку("КонецДокумента");
	КонецЦикла;
	
	ЗаписьТекста.ЗаписатьСтроку("КонецФайла");
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

&НаСервере
Функция СериализоватьЗначение(ИмяПараметра, Выборка)
	
	Значение = Выборка[ИмяПараметра];
	
	Если ИмяПараметра = "Проверка" Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0");
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыВыгрузки(Банк)
	
	ПараметрыВыгрузки = Новый ТаблицаЗначений;
	ПараметрыВыгрузки.Колонки.Добавить("Секция");
	ПараметрыВыгрузки.Колонки.Добавить("ИмяПараметра");
	ПараметрыВыгрузки.Колонки.Добавить("Значение");
	ПараметрыВыгрузки.Колонки.Добавить("Параметр");
	
	Секции = Новый Массив;
	Секции.Добавить("ОбщиеСведения");
	Секции.Добавить("Документ");
	
	РеквизитОбъект = РеквизитФормыВЗначение("Объект");
	МакетБанка = РеквизитОбъект.ПолучитьМакет("МакетВыгрузки");
	
	Для Каждого Секция Из Секции Цикл
		Макет = МакетБанка.ПолучитьОбласть(Секция);	
		
		Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
			НоваяСтрока = ПараметрыВыгрузки.Добавить();
			НоваяСтрока.Секция = Секция;
			НоваяСтрока.ИмяПараметра	= СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
			НоваяСтрока.Значение		= СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
			НоваяСтрока.Параметр		= СокрЛП(Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
			
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ПараметрыВыгрузки;
	
КонецФункции

&НаКлиенте
Функция МожноВыгрузитьПлатежки(ПроверятьНомерПлатежногоПоручения = Истина)
	
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Банк) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Банк", , "Банк", "Объект", Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогВыгрузки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Каталог выгрузки", , "КаталогВыгрузки", "Объект", Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Контрагент", , "Контрагент", "Объект", Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.РасчетныйСчетПолучателя) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Расчетный счет получателя", , "РасчетныйСчетПолучателя", "Объект", Отказ);
	КонецЕсли;
	
	КонтрольДатыЗакрытияРасчетногоСчета(Объект.РасчетныйСчетПолучателя, Отказ);
	
	Если ПроверятьНомерПлатежногоПоручения И НЕ ЗначениеЗаполнено(Объект.НомерПлатежногоПоручения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено поле Номер платежного поручения", , "НомерПлатежногоПоручения", "Объект", Отказ);
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервереБезКонтекста
Процедура КонтрольДатыЗакрытияРасчетногоСчета(РасчетныйСчетПолучателя, Отказ)
	
	Если ЗначениеЗаполнено(РасчетныйСчетПолучателя.ДатаЗакрытия) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчётный счёт получателя закрыт",,"РасчетныйСчетПолучателя", "Объект",  Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьПлатежки(Команда)
	
	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	Если НЕ МожноВыгрузитьПлатежки() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеВыгрузки = ПолучитьВыгрузкуВФормате1CClientBankExchange(Отказ);
	
	Если НЕ Отказ Тогда
		СохранитьФайлСПлатежками(Объект.КаталогВыгрузки + "/1c_to_kl.txt", ДанныеВыгрузки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка успешно завершена!");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершилась с ошибкой!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыОтбор(Команда)
	
	ТекущиеДанные = Элементы.Оплаты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если Элементы.Оплаты.ТекущийЭлемент = Элементы.ОплатыВидЗадолженности Тогда
			ЭтаФорма.ВидыЗадолженностей.Очистить();
			ЭтаФорма.ВидыЗадолженностей.Добавить(ТекущиеДанные.ВидЗадолженности);
		Иначе
			ИмяПоля = СтрЗаменить(Элементы.Оплаты.ТекущийЭлемент.Имя, "Оплаты", "");
			Объект[ИмяПоля] = ТекущиеДанные[ИмяПоля];
		КонецЕсли;
		ОбновитьОплатыНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыПриАктивизацииПоля(Элемент)
	
	МассивЭлементовОтбора = Новый Массив;
	МассивЭлементовОтбора.Добавить(Элементы.ОплатыБанк);
	МассивЭлементовОтбора.Добавить(Элементы.ОплатыВидЗадолженности);
	МассивЭлементовОтбора.Добавить(Элементы.ОплатыКонтрагент);
	МассивЭлементовОтбора.Добавить(Элементы.ОплатыСчетДоверительногоУправления);
	МассивЭлементовОтбора.Добавить(Элементы.ОплатыРасчетныйСчет);
	
	Элементы.ОплатыКонтекстноеМенюОплатыОтбор.Доступность = (МассивЭлементовОтбора.Найти(Элемент.ТекущийЭлемент) <> Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРедактироватьНастройкиНазначенияПлатежа(Команда)
	
	АдресВоВременномХранилище = ОткрытьФормуМодально("ВнешняяОбработка._ВыгрузкаПлатежейВБанкКлиент.Форма.ШаблонНазначенияПлатежа", Новый Структура("АдресВоВременномХранилище", ПоместитьНастройкиНазначенияПлатежаВоВременноеХранилище()));
	
	Если АдресВоВременномХранилище <> Неопределено Тогда
		ПолучитьНастройкиНазначенияПлатежаИзВременногоХранилища(АдресВоВременномХранилище);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьНастройкиНазначенияПлатежаВоВременноеХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.НастройкиНазначенияПлатежа.Выгрузить(), ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиНазначенияПлатежаИзВременногоХранилища(АдресВоВременномХранилище)
	
	Объект.НастройкиНазначенияПлатежа.Очистить();
	Объект.НастройкиНазначенияПлатежа.Загрузить(ПолучитьИзВременногоХранилища(АдресВоВременномХранилище));
	ЗаполнитьСписокВыбораНастройки();

	Если ЗначениеЗаполнено(ЭтаФорма.Настройка) Тогда
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Идентификатор", Новый УникальныйИдентификатор(ЭтаФорма.Настройка));
		
		НайденныеСтроки = Объект.НастройкиНазначенияПлатежа.НайтиСтроки(ПараметрыПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Объект, НайденныеСтроки[0], "Шаблон");
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьОплатыНаСервере();
	
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораНастройки()
	
	Элементы.Настройка.СписокВыбора.Очистить();
	
	Для Каждого СтрокаНастройки Из Объект.НастройкиНазначенияПлатежа Цикл
		Элементы.Настройка.СписокВыбора.Добавить(Строка(СтрокаНастройки.Идентификатор), СтрокаНастройки.Наименование);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПисьмо(Команда)
	
	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	Если НЕ МожноВыгрузитьПлатежки(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Outlook = Новый COMОбъект("Outlook.Application");
		Письмо = Outlook.CreateItem(0);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось запустить Outlook. Отправка письма невозможна.");
		Возврат;
	КонецПопытки;
	
	ДанныеВыгрузки = ПолучитьВыгрузкуВФормате1CClientBankExchange(Отказ, Истина);
	
	Если НЕ Отказ Тогда
		ИмяВременногоФайла = КаталогВременныхФайлов() + "/1c_to_kl.txt";
		
		СохранитьФайлСПлатежками(ИмяВременногоФайла, ДанныеВыгрузки);
		
		Письмо.Subject = "Заявки на проплату по договору. " + ДанныеВыгрузки.Вложения.Количество() + " шт.";
		
		Письмо.Attachments.Add(ИмяВременногоФайла);
		
		НомерВложения = 1;
		Для Каждого Вложение Из ДанныеВыгрузки.Вложения Цикл
			ИмяВременногоФайла = КаталогВременныхФайлов() + "/Заявка на проплату " + НомерВложения + ".docx";
			Вложение.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.DOCX);
			
			Письмо.Attachments.Add(ИмяВременногоФайла);
			
			НомерВложения = НомерВложения + 1;
			
		КонецЦикла;
		
		Письмо.Display();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеОбщихНастроек.Сохранить("_ВыгрузкаПлатежейВБанкКлиент", "НастройкиНазначенияПлатежа", Объект.НастройкиНазначенияПлатежа.Выгрузить(, "Идентификатор,Наименование,Контрагент,РасчетныйСчетПолучателя,Шаблон"),, "ВсеПользователи");
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры


#КонецОбласти




