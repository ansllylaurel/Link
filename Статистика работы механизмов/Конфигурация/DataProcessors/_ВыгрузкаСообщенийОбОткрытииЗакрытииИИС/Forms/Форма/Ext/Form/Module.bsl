			КонецЕсли;
			
			ФайлОбъектXDTO.Документ.Подписант.СвПред.НаимДок = "-";
			
			ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.ФИО.Фамилия = Выборка.ФамилияВладельцаИИС;
			ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.ФИО.Имя = Выборка.ИмяВладельцаИИС;
			ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.ФИО.Отчество = Выборка.ОтчествоВладельцаИИС; 
			
			УдостоверениеЛичности = СвояФабрикаXDTO.Создать(СвояФабрикаXDTO.Тип("1C_IIS", "УдЛичнФЛТип"));
			УдостоверениеЛичности.КодВидДок = Выборка.КодВидаДокументаВладельцаИИС;
			УдостоверениеЛичности.СерНомДок = ФорматПаспорта(Выборка.СерияНомерДокументаВладельцаИИС);
			УдостоверениеЛичности.ДатаВыдач = Формат(Выборка.ДатаДокументаВладельцаИИС, "ДФ=dd.MM.yyyy");
			
			Если ЗначениеЗаполнено(Выборка.ИННВладельцаИИС) Тогда

				ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ1.ИННФЛ = Выборка.ИННВладельцаИИС; 
				ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ1.ДатаРожд = Формат(Выборка.ДатаРожденияВладельцаИИС, "ДФ=dd.MM.yyyy");
				ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ1.УдЛичн = УдостоверениеЛичности;
				
			Иначе
				
				ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ2.ДатаРожд = Формат(Выборка.ДатаРожденияВладельцаИИС, "ДФ=dd.MM.yyyy");
                ФайлОбъектXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ2.УдЛичн = УдостоверениеЛичности;
				
			КонецЕсли; 
			
			ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.ПрИИС = Выборка.ВидСообщения;
			ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.НомДог = Выборка.НомерДоговораИИС;
			ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.ДатаДог = Формат(Выборка.ДатаДоговораИИС, "ДФ=dd.MM.yyyy");
			ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.ДатаИИС = Формат(Выборка.ДатаИИС, "ДФ=dd.MM.yyyy");
			
			Если Выборка.ВидСообщения >= 3 Тогда  
				//СписокXDTO. Указываем суммы вводов за год за весь период действия доовора ИИС. Если в году вводов не было - указываем год и сумму = 0.	
				ГодЗаключенияДоговора = НачалоГода(Выборка.ДатаЗаключения);
				ГодРасторжения = НачалоГода(Выборка.ДатаЗакрытия);
				
				Пока ГодЗаключенияДоговора <= ГодРасторжения Цикл 
					
					ВводДенежныхСредствXDTO = СвояФабрикаXDTO.Создать(ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.СумВнесДенСр.ВладеющееСвойство.Тип);
					ВводДенежныхСредствXDTO.Год = Формат(ГодЗаключенияДоговора, "ДФ=yyyy");
					
					ВводЗаГод = ВводыПоГодам.НайтиСтроки(Новый Структура("СчетДоверительногоУправления, Год", Выборка.СчетДоверительногоУправления, ГодЗаключенияДоговора));
					
					Если ВводЗаГод.Количество() = 1 Тогда
						ВводДенежныхСредствXDTO.Сумма =	ВводЗаГод[0].Сумма;
					ИначеЕсли ВводЗаГод.Количество() = 0 Тогда
						ВводДенежныхСредствXDTO.Сумма = 0;	
					КонецЕсли;
					
					ФайлОбъектXDTO.Документ.СообщОткрИИС.СведИИС.СумВнесДенСр.Добавить(ВводДенежныхСредствXDTO); 
					
					ГодЗаключенияДоговора = ДобавитьМесяц(ГодЗаключенияДоговора, 12);
					
				КонецЦикла;
				
			КонецЕсли;
		
			Если Выборка.ВидСообщения = 4 Тогда
				
				ФайлОбъектXDTO.Документ.СообщОткрИИС.ЛицоВедИИСПер.НаимОрг = Выборка.НаименованиеСтороннегоКонтрагента;
				ФайлОбъектXDTO.Документ.СообщОткрИИС.ЛицоВедИИСПер.ИННЮЛ = Выборка.ИННСтороннегоКонтрагента;
				ФайлОбъектXDTO.Документ.СообщОткрИИС.ЛицоВедИИСПер.КПП = Выборка.КППСтороннегоКонтрагента;
				
			КонецЕсли;
			
			СвояФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ФайлОбъектXDTO, "Файл");
#КонецОбласти

		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка в формате " + Объект.ВерсияФормата + " не реализована",, "ВерсияФормата");
		КонецЕсли;
		
		ЗаписьXML.Закрыть();
		
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяВременногоФайла, "WINDOWS-1251");
		
		ТекстXML = СтрЗаменить(Текст.ПолучитьТекст(),
			"<Файл xmlns=""1C_IIS"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""",
			"<Файл"); 
		
		СообщенияXML.Вставить(Выборка.ИдентификаторФайла + "_" + Формат(Выборка.НомерСообщения, "ЧГ=0"), ТекстXML);
		
	КонецЦикла;	
	
	Возврат СообщенияXML;
	
КонецФункции

&НаСервереБезКонтекста
Функция ФорматПаспорта(Знач СерияНомерПаспорта)
	
	СерияНомерПаспорта = СтрЗаменить(СерияНомерПаспорта, " ", "");
	
	Результат =	Сред(СерияНомерПаспорта, 1, 2) + " " +
				Сред(СерияНомерПаспорта, 3, 2) + " " +
				Сред(СерияНомерПаспорта, 5);
				
	Возврат Результат;
	
КонецФункции	

&НаСервереБезКонтекста
Процедура ЗаписатьАтрибут(ЗаписьXML, ИмяАтрибута, Значение, НеДобавлятьПустоеЗначение = Ложь)
	
	Если НеДобавлятьПустоеЗначение и НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьАтрибут(ИмяАтрибута, СериализоватьЗначение(Значение));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЭлементыАдресаИзФИАС(АдресФИАС, СчетДоверительногоУправления, ВидАдреса)
	
	Если ТипЗнч(АдресФИАС) <> Тип("Строка") 
		ИЛИ НЕ СтрНачинаетсяС(СокрЛ(АдресФИАС), "<") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректный формат адреса '" + ВидАдреса + "' в счете ДУ '" + СчетДоверительногоУправления + "'");
		Возврат Новый Структура("Индекс,КодРегиона,Район,Город,НаселенныйПункт,Улица,Дом,Строение,Помещение");
	КонецЕсли;
	
	Возврат РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(АдресФИАС);

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьОбъектXDTO(ФабрикаXDTO, ЕстьИНН)
	
	ФайлТип = ФабрикаXDTO.Тип("1C_IIS", "Файл");
	ФайлXDTO = ФабрикаXDTO.Создать(ФайлТип);
	
	ДокументТип = ФайлТип.Свойства.Получить("Документ").Тип;
	ФайлXDTO.Документ = ФабрикаXDTO.Создать(ДокументТип);
	
	СвНПТип = ДокументТип.Свойства.Получить("СвНП").Тип;
	ФайлXDTO.Документ.СвНП = ФабрикаXDTO.Создать(СвНПТип);
	
	НПЮЛТип = СвНПТип.Свойства.Получить("НПЮЛ").Тип;
	ФайлXDTO.Документ.СвНП.НПЮЛ = ФабрикаXDTO.Создать(НПЮЛТип);
	
	ПодписантТип = ДокументТип.Свойства.Получить("Подписант").Тип; 
	ФайлXDTO.Документ.Подписант = ФабрикаXDTO.Создать(ПодписантТип);
	
	ФайлXDTO.Документ.Подписант.ФИО = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("1C_IIS", "ФИОТип"));
	
	СвПредТип = ПодписантТип.Свойства.Получить("СвПред").Тип; 
	ФайлXDTO.Документ.Подписант.СвПред = ФабрикаXDTO.Создать(СвПредТип);
	
	СообщОткрИИСТип = ДокументТип.Свойства.Получить("СообщОткрИИС").Тип;
	ФайлXDTO.Документ.СообщОткрИИС = ФабрикаXDTO.Создать(СообщОткрИИСТип);
	
	ВладелецТип = СообщОткрИИСТип.Свойства.Получить("Владелец").Тип;
	
	ФайлXDTO.Документ.СообщОткрИИС.Владелец = ФабрикаXDTO.Создать(ВладелецТип); 
	ФайлXDTO.Документ.СообщОткрИИС.Владелец.ФИО = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("1C_IIS", "ФИОТип")); 
	
	Если ЕстьИНН Тогда
		
		СведФЛ1Тип = ВладелецТип.Свойства.Получить("СведФЛ1").Тип; 
		ФайлXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ1	= ФабрикаXDTO.Создать(СведФЛ1Тип);
	
	Иначе
		
		СведФЛ2Тип = ВладелецТип.Свойства.Получить("СведФЛ2").Тип;
		ФайлXDTO.Документ.СообщОткрИИС.Владелец.СведФЛ2 = ФабрикаXDTO.Создать(СведФЛ2Тип);
		
	КонецЕсли;
	
	СведИИСТип = СообщОткрИИСТип.Свойства.Получить("СведИИС").Тип;
	ФайлXDTO.Документ.СообщОткрИИС.СведИИС = ФабрикаXDTO.Создать(СведИИСТип); 
	
	ЛицоВедИИСПерТип = СообщОткрИИСТип.Свойства.Получить("ЛицоВедИИСПер").Тип; 
	ФайлXDTO.Документ.СообщОткрИИС.ЛицоВедИИСПер = ФабрикаXDTO.Создать(ЛицоВедИИСПерТип);
	
	Возврат ФайлXDTO;
	
КонецФункции

&НаСервереБезКонтекста
Функция СериализоватьЗначение(Значение)
	
	Если  ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат СериализаторXDTO.XMLСтрока(Значение);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТелефон(Значение)
	
	Телефон = "";
	
	Цифры = "1234567890";
	ДопустимыеСимволы = "1234567890()- ";
	
	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Если Найти(ДопустимыеСимволы, Сред(Значение, НомерСимвола, 1)) = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если Найти(Цифры, Сред(Значение, НомерСимвола, 1)) > 0 Тогда
			Телефон = Телефон + Сред(Значение, НомерСимвола, 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Телефон;
	
КонецФункции

&НаСервере
Функция ПовторнаяВыгрузка()
	
	Отказ = Ложь;
	
	Для Каждого СтрокаСообщения Из Объект.СообщенияОбОткрытииЗакрытииИИС Цикл
		Если СтрокаСообщения.Выгружать И ЗначениеЗаполнено(СтрокаСообщения.Номер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Повторная выгрузка сообщения: " + СтрокаСообщения.Документ + ", строка " + СтрокаСообщения.НомерСтроки,,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Функция ПолучитьОтчетОповещения()
	
	Результат = Новый ТабличныйДокумент;
	РеквизитФормыВЗначение("Объект").СформироватьОтчет(Результат);
	
	Если Результат.ВысотаТаблицы > 0 Тогда
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьТаблицуСообщений(Команда)
	
	ОбновитьТаблицуСообщенийНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлы(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран каталог данных!");
		Возврат;
	Иначе
		Файл = Новый Файл(Объект.КаталогДанных);
		
		Если НЕ Файл.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указанный каталог данных не существует или недоступен!");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.СообщенияОбОткрытииЗакрытииИИС.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет сообщений для выгрузки!");
		Возврат;
	КонецЕсли;
	
	Если ПовторнаяВыгрузка() Тогда
		Ответ = Вопрос("Сообщениям уже присвоен номер, возможно, они выгружаются повтороно. Продолжить?", РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗарегистрироватьНомераСообщенийНаСервере();
	
	МассивСохраняемыхФайлов = Новый Массив;
	МассивСуществующихФайлов = Новый Массив;
	
	СообщенияXML = ПолучитьСообщенияXML();	
	
	Для Каждого СообщениеXML Из СообщенияXML Цикл
		
		СохраняемыйФайл = Новый Структура("Текст, ИмяФайла, Сохранить");
		
		СохраняемыйФайл.Вставить("Текст", Новый ТекстовыйДокумент);
		СохраняемыйФайл.Текст.ДобавитьСтроку(СообщениеXML.Значение);
		
		СохраняемыйФайл.Вставить("ИмяФайла", Объект.КаталогДанных + "\" + СообщениеXML.Ключ + ".xml");
		
		ПроверяемыйФайл = Новый Файл(СохраняемыйФайл.ИмяФайла);
		
		Если ПроверяемыйФайл.Существует() Тогда
			МассивСуществующихФайлов.Добавить(СохраняемыйФайл.ИмяФайла);
			СохраняемыйФайл.Вставить("Существует", Истина);
		Иначе	
			СохраняемыйФайл.Вставить("Существует", Ложь);
		КонецЕсли;
		
		МассивСохраняемыхФайлов.Добавить(СохраняемыйФайл);
		
	КонецЦикла;	
	
	ПерезаписыватьСуществующиеФайлы = Ложь;
	
	Если МассивСуществующихФайлов.Количество() Тогда
		ПерезаписыватьСуществующиеФайлы = (Вопрос("Перезаписать уже сущестсвующие файлы?" + Символы.ПС + СтрСоединить(МассивСуществующихФайлов, Символы.ПС), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да); 
	КонецЕсли;
	
	Для Каждого СохраняемыйФайл Из МассивСохраняемыхФайлов Цикл
		Если НЕ СохраняемыйФайл.Существует 
		 ИЛИ СохраняемыйФайл.Существует И ПерезаписыватьСуществующиеФайлы Тогда
		 
		 	Попытка
				СохраняемыйФайл.Текст.Записать(СохраняемыйФайл.ИмяФайла, "WINDOWS-1251");
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Выгрузка прервана!
					|При записи файла '" + СохраняемыйФайл.ИмяФайла + "' произошла ошибка:
					|" + ОписаниеОшибки());
				Возврат;
			КонецПопытки;
		
		КонецЕсли;
	КонецЦикла;
	
	Если СообщенияXML.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файлы сформированы!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетОповещения(Команда)
	
	Результат = ПолучитьОтчетОповещения();
	
	Если Результат <> Неопределено Тогда
		Результат.Показать("Отчёт оповещения на " + Формат(ТекущаяДата(), "ДФ=dd.MM.yy"));	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогДанных + "\");
	
КонецПроцедуры

&НаКлиенте
Процедура СообщенияОбОткрытииЗакрытииИИСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.СообщенияОбОткрытииЗакрытииИИСПредупреждение Тогда
		ТекущиеДанные = Элементы.СообщенияОбОткрытииЗакрытииИИС.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			Если ТекущиеДанные.Документ <> ТекущиеДанные.Регистратор Тогда
				Предупреждение("Номер зарегистрирован другим документом!" + Символы.ПС + ТекущиеДанные.Регистратор);
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщенияОбОткрытииЗакрытииИИСВыгружатьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СообщенияОбОткрытииЗакрытииИИС.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено 
	   И ТекущиеДанные.Выгружать
	   И ТекущиеДанные.ВидСообщения >= 3 Тогда
	   
	   ДатаВывода = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Регистратор, "Дата");
	   
	   Если ДатаВывода < Объект.Период.ДатаНачала ИЛИ ДатаВывода > Объект.Период.ДатаОкончания Тогда
		   
		   ТекстПредупреждения = 
				СтрШаблон("Дата вывода %1 не попадает в указанный период %2-%3. Выгрузка запрещена.",
					Формат(ДатаВывода, "ДФ=dd.MM.yyyy"),
					Формат(Объект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"),
					Формат(Объект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			
			ПоказатьПредупреждение(, ТекстПредупреждения); 
			ТекущиеДанные.Выгружать = Ложь;

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Объект.СообщенияОбОткрытииЗакрытииИИС.Количество() > 0
		И Вопрос("Таблица сообщений будет обновлена. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ОбновитьТаблицуСообщенийНаСервере(Истина);

КонецПроцедуры




















