
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЗаполнитьПериодПоУмолчанию(Объект.Период);
	
	Объект.ПризнакПодписанта = 1; //устанавливается только первый раз, потом форма запоминает значение
	
	ЗаполнитьВерсиюФормата();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПериодПоУмолчанию(Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _КалендарьНаТриРабочихДня
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата < НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_КалендарьНаТриРабочихДня.Дата) КАК ДатаНачала,
		|	МАКСИМУМ(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -1), ДЕНЬ)) КАК ДатаОкончания
		|ИЗ
		|	_КалендарьНаТриРабочихДня КАК _КалендарьНаТриРабочихДня";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Период, Выборка);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить три последних рабочих дня.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВерсиюФормата()
	
	Элементы.ВерсияФормата.СписокВыбора.Добавить("5.01");
	Элементы.ВерсияФормата.СписокВыбора.Добавить("5.02");
	Элементы.ВерсияФормата.СписокВыбора.Добавить("5.03");
	Элементы.ВерсияФормата.СписокВыбора.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	
	Объект.ВерсияФормата = Элементы.ВерсияФормата.СписокВыбора[0].Значение;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуСообщенийНаСервере(ИнтерактивныйЗапуск = Ложь)
	
#Область СтатистикаРаботыВнутреннихМеханизмовНачало
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Объект, "Организация, Период, КаталогДанных");

	Механизм = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя() + ".ОбновитьТаблицуСообщенийНаСервере()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
#КонецОбласти
	
#Область ТекстЗапроса
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ВТ_Сообщения.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ВТ_Сообщения.ВидСообщения КАК ВидСообщения,
		|	ВТ_Сообщения.Документ КАК Документ,
		|	ВТ_Сообщения.Номер КАК Номер,
		|	ВТ_Сообщения.Выгружать КАК Выгружать
		|ПОМЕСТИТЬ СообщенияОбОткрытииЗакрытииИИС
		|ИЗ
		|	&СообщенияОбОткрытииЗакрытииИИС КАК ВТ_Сообщения
		|ГДЕ
		|	НЕ &ИнтерактивныйЗапуск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводДенежныхСредств.Дата КАК Дата,
		|	ВводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВводДенежныхСредств.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Вводы
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|ГДЕ
		|	ВводДенежныхСредств.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И ВводДенежныхСредств.Проведен
		|	И ВводДенежныхСредств.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводЦенныхБумаг.Дата,
		|	ВводЦенныхБумаг.СчетДоверительногоУправления,
		|	ВводЦенныхБумаг.Ссылка
		|ИЗ
		|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|ГДЕ
		|	ВводЦенныхБумаг.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И ВводЦенныхБумаг.Проведен
		|	И ВводЦенныхБумаг.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыводДенежныхСредств.Дата КАК Дата,
		|	ВыводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВыводДенежныхСредств.Ссылка КАК Ссылка,
		|	ВыводДенежныхСредств.Основание КАК Основание
		|ПОМЕСТИТЬ ВТ_Выводы
		|ИЗ
		|	Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|ГДЕ
		|	ВыводДенежныхСредств.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И ВыводДенежныхСредств.Проведен
		|	И ВыводДенежныхСредств.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыводЦенныхБумаг.Дата,
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления,
		|	ВыводЦенныхБумаг.Ссылка,
		|	ВыводЦенныхБумаг.Поручение
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
		|ГДЕ
		|	ВыводЦенныхБумаг.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И ВыводЦенныхБумаг.Проведен
		|	И ВыводЦенныхБумаг.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АнкетаФизическогоЛица.Дата,
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления,
		|	АнкетаФизическогоЛица.Ссылка,
		|	NULL
		|ИЗ
		|	(ВЫБРАТЬ
		|		АнкетаФизическогоЛица.Организация КАК Организация,
		|		АнкетаФизическогоЛица.Ссылка КАК Ссылка,
		|		АнкетаФизическогоЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|		АнкетаФизическогоЛица.Дата КАК Дата,
		|		МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК ПериодКлиентаДУ
		|	ИЗ
		|		Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|			ПО АнкетаФизическогоЛица.Организация = КлиентыДоверительногоУправления.Организация
		|				И АнкетаФизическогоЛица.ЮрФизЛицо = КлиентыДоверительногоУправления.Клиент
		|				И АнкетаФизическогоЛица.Дата >= КлиентыДоверительногоУправления.Период
		|				И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|	ГДЕ
		|		АнкетаФизическогоЛица.Проведен
		|		И АнкетаФизическогоЛица.Организация = &Организация
		|		И НЕ АнкетаФизическогоЛица.ДатаСмерти = ДАТАВРЕМЯ(1, 1, 1)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		АнкетаФизическогоЛица.Ссылка,
		|		АнкетаФизическогоЛица.ЮрФизЛицо,
		|		АнкетаФизическогоЛица.Дата,
		|		АнкетаФизическогоЛица.Организация) КАК АнкетаФизическогоЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО АнкетаФизическогоЛица.Организация = КлиентыДоверительногоУправления.Организация
		|			И АнкетаФизическогоЛица.ЮрФизЛицо = КлиентыДоверительногоУправления.Клиент
		|			И АнкетаФизическогоЛица.ПериодКлиентаДУ = КлиентыДоверительногоУправления.Период
		|			И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Вводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_Вводы.Дата КАК Дата,
		|	МИНИМУМ(ВТ_Вводы.Ссылка) КАК Ссылка,
		|	NULL КАК Основание
		|ПОМЕСТИТЬ ВТ_ПервыеВводыВыводы
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_Вводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МИНИМУМ(ВТ_Вводы.Дата) КАК Дата
		|	ИЗ
		|		ВТ_Вводы КАК ВТ_Вводы
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_Вводы.СчетДоверительногоУправления) КАК ДатыПервыхВводов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Вводы КАК ВТ_Вводы
		|		ПО ДатыПервыхВводов.СчетДоверительногоУправления = ВТ_Вводы.СчетДоверительногоУправления
		|			И ДатыПервыхВводов.Дата = ВТ_Вводы.Дата
		|ГДЕ
		|	ДатыПервыхВводов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Вводы.СчетДоверительногоУправления,
		|	ВТ_Вводы.Дата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Выводы.СчетДоверительногоУправления,
		|	ВТ_Выводы.Дата,
		|	МИНИМУМ(ВТ_Выводы.Ссылка),
		|	МИНИМУМ(ВТ_Выводы.Основание)
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_Выводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МИНИМУМ(ВТ_Выводы.Дата) КАК Дата
		|	ИЗ
		|		ВТ_Выводы КАК ВТ_Выводы
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_Выводы.СчетДоверительногоУправления) КАК ДатаПервыхВыводов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Выводы КАК ВТ_Выводы
		|		ПО ДатаПервыхВыводов.СчетДоверительногоУправления = ВТ_Выводы.СчетДоверительногоУправления
		|			И ДатаПервыхВыводов.Дата = ВТ_Выводы.Дата
		|ГДЕ
		|	ДатаПервыхВыводов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Выводы.СчетДоверительногоУправления,
		|	ВТ_Выводы.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|			ТОГДА ВТ_ПервыеВводыВыводы.Дата
		|		ИНАЧЕ &НачалоПериода
		|	КОНЕЦ МЕЖДУ &НачалоПериода И &КонецПериода
		|		И ЕСТЬNULL(СообщенияОбОткрытииЗакрытииИИС.Выгружать, НомераОбъектов.Номер ЕСТЬ NULL) КАК Выгружать,
		|	ВТ_ПервыеВводыВыводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВводЦенныхБумаг))
		|			ТОГДА 1
		|		КОГДА НЕ ПоручениеНаВыводАктивовНаДругойИИС.Ссылка ЕСТЬ NULL
		|			ТОГДА 4
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|			ТОГДА 3
		|	КОНЕЦ КАК ВидСообщения,
		|	ВЫБОР
		|		КОГДА НЕ ПоручениеНаВыводАктивовНаДругойИИС.Ссылка ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) = ТИП(Документ.ВыводДенежныхСредств)
		|						ТОГДА ВЫРАЗИТЬ(ВТ_ПервыеВводыВыводы.Ссылка КАК Документ.ВыводДенежныхСредств).Контрагент
		|					КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) = ТИП(Документ.ВыводЦенныхБумаг)
		|						ТОГДА ВЫРАЗИТЬ(ВТ_ПервыеВводыВыводы.Ссылка КАК Документ.ВыводЦенныхБумаг).Контрагент
		|				КОНЕЦ
		|	КОНЕЦ КАК СтороннийКонтрагент,
		|	ВТ_ПервыеВводыВыводы.Ссылка КАК Документ,
		|	НомераОбъектов.Номер КАК Номер,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг))
		|			ТОГДА ВТ_ПервыеВводыВыводы.СчетДоверительногоУправления.ДатаРасторжения
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) = ТИП(Документ.АнкетаФизическогоЛица)
		|			ТОГДА ВЫРАЗИТЬ(ВТ_ПервыеВводыВыводы.Ссылка КАК Документ.АнкетаФизическогоЛица).Дата
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ДатаЗакрытия,
		|	НомераОбъектов.Ответственный КАК Ответственный,
		|	НомераОбъектов.ДатаРегистрации КАК ДатаРегистрации,
		|	ВТ_ПервыеВводыВыводы.Ссылка <> ЕСТЬNULL(НомераОбъектов.Объект, ВТ_ПервыеВводыВыводы.Ссылка) КАК Предупреждение,
		|	ЕСТЬNULL(НомераОбъектов.Объект, ВТ_ПервыеВводыВыводы.Ссылка) КАК Регистратор,
		|	ВТ_ПервыеВводыВыводы.Дата КАК ДатаРегистратора
		|ИЗ
		|	ВТ_ПервыеВводыВыводы КАК ВТ_ПервыеВводыВыводы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО (НомераОбъектов.Организация = &Организация)
		|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС))
		|			И ВТ_ПервыеВводыВыводы.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
		|			И (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВводЦенныхБумаг))
		|					ТОГДА ТИПЗНАЧЕНИЯ(НомераОбъектов.Объект) В (ТИП(Документ.ВводДенежныхСредств), ТИП(Документ.ВводЦенныхБумаг))
		|				КОГДА ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|					ТОГДА ТИПЗНАЧЕНИЯ(НомераОбъектов.Объект) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг), ТИП(Документ.АнкетаФизическогоЛица))
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ СообщенияОбОткрытииЗакрытииИИС КАК СообщенияОбОткрытииЗакрытииИИС
		|		ПО (СообщенияОбОткрытииЗакрытииИИС.Документ = ВТ_ПервыеВводыВыводы.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаВыводАктивовНаДругойИИС
		|		ПО (ТИПЗНАЧЕНИЯ(ВТ_ПервыеВводыВыводы.Ссылка) В (ТИП(Документ.ВыводДенежныхСредств), ТИП(Документ.ВыводЦенныхБумаг)))
		|			И ((ВЫРАЗИТЬ(ВТ_ПервыеВводыВыводы.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств)) = ПоручениеНаВыводАктивовНаДругойИИС.Ссылка)
		|			И (ПоручениеНаВыводАктивовНаДругойИИС.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствСПереводомВсехАктивовНаДругойИИС))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номер,
		|	Документ";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ИнтерактивныйЗапуск", ИнтерактивныйЗапуск);
	Запрос.УстановитьПараметр("СообщенияОбОткрытииЗакрытииИИС", Объект.СообщенияОбОткрытииЗакрытииИИС.Выгрузить());
	
	Объект.СообщенияОбОткрытииЗакрытииИИС.Очистить();
	Объект.СообщенияОбОткрытииЗакрытииИИС.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Открыто = 0;
	Закрыто = 0;
	
	Для Каждого ТекСтрока Из Объект.СообщенияОбОткрытииЗакрытииИИС Цикл
		Если ТекСтрока.ВидСообщения < 3 Тогда
			Открыто = Открыто + 1;
		ИначеЕсли ТекСтрока.ВидСообщения > 2 Тогда
			Закрыто = Закрыто + 1;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.СообщенияОбОткрытииЗакрытииИИСВидСообщения.ТекстПодвала = "Открыто " + Формат(Открыто, "ЧДЦ=0; ЧГ=0") + " / Закрыто " + Формат(Закрыто, "ЧДЦ=0; ЧГ=0");
	
#Область СтатистикаРаботыВнутреннихМеханизмовЗавершение
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНомераСообщенийНаСервере()
	
#Область СтатистикаРаботыВнутреннихМеханизмовНачало
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Объект, "Организация, Период, КаталогДанных");

	Механизм = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя() + ".ЗарегистрироватьНомераСообщенийНаСервере()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
#КонецОбласти

	МассивОбъектов = Новый Массив;
	Для Каждого СтрокаСообщений Из Объект.СообщенияОбОткрытииЗакрытииИИС Цикл
		Если СтрокаСообщений.Выгружать Тогда
			МассивОбъектов.Добавить(СтрокаСообщений.Регистратор);
		КонецЕсли;
	КонецЦикла;

	РегистрыСведений.НомераОбъектов.ЗарегистрироватьНовыйНомер(Объект.Организация, 
																Справочники.ВидыНумерацииОбъектов.СообщенияОбОткрытииЗакрытииИИС, 
																МассивОбъектов);
																
#Область СтатистикаРаботыВнутреннихМеханизмовЗавершение
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
#КонецОбласти
																
	ОбновитьТаблицуСообщенийНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСообщенияXML()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ВТ_Сообщения.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ВТ_Сообщения.ВидСообщения КАК ВидСообщения,
		|	ВТ_Сообщения.Регистратор КАК Регистратор,
		|	ВТ_Сообщения.ДатаРегистратора КАК ДатаРегистратора,
		|	ВТ_Сообщения.Номер КАК Номер,
		|	ВТ_Сообщения.СтороннийКонтрагент КАК СтороннийКонтрагент,
		|	ВТ_Сообщения.ДатаЗакрытия КАК ДатаЗакрытия
		|ПОМЕСТИТЬ _СообщенияОбОткрытииЗакрытииИИС
		|ИЗ
		|	&СообщенияОбОткрытииЗакрытииИИС КАК ВТ_Сообщения
		|ГДЕ
		|	ВТ_Сообщения.Выгружать
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Год,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот КАК Сумма
		|ПОМЕСТИТЬ _ВводыПоГодам
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
		|			,
		|			,
		|			Год,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						ВТ_Сообщения.СчетДоверительногоУправления
		|					ИЗ
		|						_СообщенияОбОткрытииЗакрытииИИС КАК ВТ_Сообщения
		|					ГДЕ
		|						ВТ_Сообщения.ВидСообщения В (3, 4))
		|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Сообщения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_Сообщения.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения, 
		|	ВЫБОР
		|		КОГДА ВТ_Сообщения.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ВТ_Сообщения.ДатаЗакрытия = НЕОПРЕДЕЛЕНО
		|			ТОГДА &Период
		|		ИНАЧЕ ВТ_Сообщения.ДатаЗакрытия
		|	КОНЕЦ КАК ДатаЗакрытия,
		|	ВЫБОР
		|		КОГДА РеквизитыЮридическихЛицСрезПоследних.КПП2 = """"
		|			ТОГДА ""ON_INSCHET_"" + ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП, 1, 4) + ""_"" + ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП, 1, 4) + ""_"" + РеквизитыЮридическихЛицСрезПоследних.ИНН + РеквизитыЮридическихЛицСрезПоследних.КПП + ""_"" + &ПериодСтрокой
		|		ИНАЧЕ ""ON_INSCHET_"" + ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП, 1, 4) + ""_"" + ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП2, 1, 4) + ""_"" + РеквизитыЮридическихЛицСрезПоследних.ИНН + РеквизитыЮридическихЛицСрезПоследних.КПП2 + ""_"" + &ПериодСтрокой
		|	КОНЕЦ КАК ИдентификаторФайла,
		|	""1"" КАК ВерсияПрограммы,
		|	&ВерсияФормата КАК ВерсияФормата,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИННОрганизации,
		|	ВЫБОР
		|		КОГДА РеквизитыЮридическихЛицСрезПоследних.КПП2 = """"
		|			ТОГДА РеквизитыЮридическихЛицСрезПоследних.КПП
		|		ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.КПП2
		|	КОНЕЦ КАК КППОрганизации,
		|	КонтактнаяИнформацияОрганизации.Представление КАК ТелефонОрганизации,
		|	"""" КАК ФамилияПодписанта,
		|	"""" КАК ИмяПодписанта,
		|	"""" КАК ОтчествоПодписанта,
		|	""1114605"" КАК КНД,
		|	&Период КАК ДатаФормирования,
		|	ВТ_Сообщения.Номер КАК НомерСообщения,
		|	ВЫБОР
		|		КОГДА РеквизитыЮридическихЛицСрезПоследних.КПП2 = """"
		|			ТОГДА ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП, 1, 4)
		|		ИНАЧЕ ПОДСТРОКА(РеквизитыЮридическихЛицСрезПоследних.КПП2, 1, 4)
		|	КОНЕЦ КАК КодНалоговогоОргана,
		|	""0"" КАК НомерКорректировки,
		|	ВТ_Сообщения.ВидСообщения КАК ВидСообщения,
		|	ВТ_Сообщения.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораИИС,
		|	ВТ_Сообщения.ДатаРегистратора КАК ДатаИИС,
		|	ВЫБОР
		|		КОГДА &ВерсияФормата >= ""5.02""
		|				И ВТ_Сообщения.ВидСообщения >= 3
		|			ТОГДА ВТ_Сообщения.ДатаРегистратора
		|		ИНАЧЕ ВТ_Сообщения.СчетДоверительногоУправления.ДатаЗаключения
		|	КОНЕЦ КАК ДатаДоговораИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИННВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.МестоРождения КАК МестоРожденияВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК ДатаРожденияВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия КАК ФамилияВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя КАК ИмяВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ОтчествоВладельцаИИС,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодВидаДокументаВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности + РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК СерияНомерДокументаВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаДокументаВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийДокументВладельцаИИС,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрацииФИАС КАК АдресРегистрацииФИАС,
		|	РеквизитыСтороннихКонтрагентовСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеСтороннегоКонтрагента,
		|	РеквизитыСтороннихКонтрагентовСрезПоследних.ИНН КАК ИННСтороннегоКонтрагента,
		|	РеквизитыСтороннихКонтрагентовСрезПоследних.КПП КАК КППСтороннегоКонтрагента
		|ИЗ
		|	_СообщенияОбОткрытииЗакрытииИИС КАК ВТ_Сообщения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &ОрганизацияЮрЛицо
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВТ_Сообщения.СчетДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.Телефон)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК КонтактнаяИнформацияОрганизации
		|		ПО ВТ_Сообщения.СчетДоверительногоУправления.Организация.ЮрФизЛицо = КонтактнаяИнформацияОрганизации.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							_ВТ.СтороннийКонтрагент
		|						ИЗ
		|							_СообщенияОбОткрытииЗакрытииИИС КАК _ВТ
		|						ГДЕ
		|							НЕ _ВТ.СтороннийКонтрагент ЕСТЬ NULL)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСтороннихКонтрагентовСрезПоследних
		|		ПО (ВТ_Сообщения.СтороннийКонтрагент = РеквизитыСтороннихКонтрагентовСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
