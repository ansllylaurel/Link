КонецФункции 

Функция ПрочитатьФайлы(ФайлыДляОбработки, ЧтениеФайлаДляЗагрузкиДанных = Ложь, ИдентификаторФормы = Неопределено) Экспорт
	
	СоздатьСтруктуруТаблиц();
	
	ТаблицаЦБ = Новый ТаблицаЗначений;
	ТаблицаЦБ.Колонки.Добавить("ISIN", Метаданные.РегистрыСведений.КодыВТорговыхСистемах.Ресурсы.Код.Тип);
	
	НомерСтроки = 1;
	Для каждого РеквизитыФайла Из ФайлыДляОбработки Цикл
	
		Данные = ПрочитатьФайл(РеквизитыФайла);
		СтрокаТаблицыФайлы = ЭтотОбъект.СтруктураТаблиц.Файлы.Добавить();
		
		СтрокаТаблицыФайлы.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаТаблицыФайлы.ГруппыДоговоров = ПолучитьТаблицуГруппДоговоров();
		СтрокаТаблицыФайлы.ИмяФайла = РеквизитыФайла.ИмяФайла;
		СтрокаТаблицыФайлы.ПолноеИмяФайла = РеквизитыФайла.ПолноеИмяФайла;
		Если ЧтениеФайлаДляЗагрузкиДанных Тогда
			СтрокаТаблицыФайлы.АдресДвоичныхДанныхФайла = ПоместитьВоВременноеХранилище(РеквизитыФайла.ДвоичныеДанные, ИдентификаторФормы);
		КонецЕсли;		
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
		
			СтрокаТаблицыФайлы.ИННКлиента = Данные.ПараметрыЛВ.PartnerINN;
			СтрокаТаблицыФайлы.ИННОрганизации = Данные.ПараметрыЛВ.AM;
			СтрокаТаблицыФайлы.Дата = РеквизитыФайла.ДатаСоздания;
			ЗаполнитьДанныеФайла(СтрокаТаблицыФайлы, Данные, ТаблицаЦБ);
			
		Иначе
			
			СтрокаТаблицыФайлы.СодержитОшибки = Истина;
			МассивСообщенийПользователю = Новый Массив(ПолучитьСообщенияПользователю(Истина));
			Для каждого Сообщение Из МассивСообщенийПользователю Цикл
			
				ЗарегистрироватьОшибкуПарсингаФайла(Сообщение.Текст, СтрокаТаблицыФайлы.ИмяФайла, "Файлы", СтрокаТаблицыФайлы.НомерСтроки);
			
			КонецЦикла; 
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	ОтключитьОбработкуДублейЛимитов();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗаполнитьКлиентов(МенеджерВременныхТаблиц);
	ЗаполнитьЭмитентов(МенеджерВременныхТаблиц);
	ЗаполнитьДоговоры();
	ЗаполнитьЦенныеБумаги(ТаблицаЦБ);
	Если ЧтениеФайлаДляЗагрузкиДанных Тогда
		ЗаполнитьНазначения();
		ЗаполнитьНаборы();
	КонецЕсли; 
	
	Для каждого СтрокаТаблицыФайлы Из ЭтотОбъект.СтруктураТаблиц.Файлы Цикл
		СтрокаТаблицыФайлы.Загрузить = Не (СтрокаТаблицыФайлы.СодержитОшибки Или ЗначениеЗаполнено(СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации));
	КонецЦикла; 

	Возврат ЭтотОбъект.СтруктураТаблиц;
	
КонецФункции

Процедура ЗаполнитьДанныеФайла(СтрокаФайла, Данные, ТаблицаЦБ)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаФайла,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = Организации.ЮрФизЛицо
		|			И (РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН = &ИНН)
		|			И (Организации.Ссылка = &Организация)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаФайла", 		СтрокаФайла.Дата);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ИНН", 			СтрокаФайла.ИННОрганизации);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ЗарегистрироватьОшибкуПарсингаФайла("Файл не содержит данных по текущей организации", СтрокаФайла.ИмяФайла, "Файлы", СтрокаФайла.НомерСтроки, "");
		СтрокаФайла.СодержитОшибки = Истина;
		Возврат;
	КонецЕсли;	 
	
	НомерСтроки = 1;
	Для каждого СтрокаIssuers Из Данные.Issuers Цикл
		
		НоваяСтрока = ЭтотОбъект.СтруктураТаблиц.Issuers.Добавить();
		
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока.ИмяФайла = СтрокаФайла.ИмяФайла;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаIssuers); 
		
	КонецЦикла;
	
	НомерСтроки = 1;
	Для каждого СтрокаIssuerLimits Из Данные.IssuerLimits Цикл
		
		НоваяСтрока = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.Добавить();
		
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока.ИмяФайла = СтрокаФайла.ИмяФайла;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаIssuerLimits);
		
		ПроверитьЗаполнитьСтрокуЛимитовЭмитентов(НоваяСтрока, СтрокаФайла);
		
		ДоговорыСтрокой = СтрЗаменить(СтрЗаменить(СтрокаIssuerLimits.Contracts, " ", ""), ",", ", ");
		
		НоваяСтрока.Contracts = ДоговорыСтрокой;		
		
		ОтборГруппДоговоров = Новый Структура("Представление", ДоговорыСтрокой);
		СтрокиГруппДоговоров = СтрокаФайла.ГруппыДоговоров.НайтиСтроки(ОтборГруппДоговоров);
		Если СтрокиГруппДоговоров.Количество() = 0 Тогда
			СтрокаГруппыДоговоров = СтрокаФайла.ГруппыДоговоров.Добавить();
			СтрокаГруппыДоговоров.Представление = ДоговорыСтрокой;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(СтрокаIssuerLimits.ISIN) И ТаблицаЦБ.Найти(СтрокаIssuerLimits.ISIN, "ISIN") = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаЦБ.Добавить(), СтрокаIssuerLimits);
		КонецЕсли; 
		
	КонецЦикла;
	
	Для каждого СтрокаGroupLimits Из Данные.GroupLimits Цикл
		
		НоваяСтрока = ЭтотОбъект.СтруктураТаблиц.GroupLimits.Добавить();
		НоваяСтрока.ИмяФайла = СтрокаФайла.ИмяФайла;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаGroupLimits);
		
		НоваяСтрока.КонтролируемыйПоказатель = "Сумма без РЕПО";
		НоваяСтрока.МаксимальноеЗначение = СтрокаGroupLimits.LimitSizeInCash;
		
		ДоговорыСтрокой = СтрЗаменить(СтрЗаменить(СтрокаGroupLimits.Contracts, " ", ""), ",", ", ");
		
		НоваяСтрока.Contracts = ДоговорыСтрокой;
		
		ОтборГруппДоговоров = Новый Структура("Представление", ДоговорыСтрокой);
		СтрокиГруппДоговоров = СтрокаФайла.ГруппыДоговоров.НайтиСтроки(ОтборГруппДоговоров);
		Если СтрокиГруппДоговоров.Количество() = 0 Тогда
			СтрокаГруппыДоговоров = СтрокаФайла.ГруппыДоговоров.Добавить();
			СтрокаГруппыДоговоров.Представление = ДоговорыСтрокой;
		КонецЕсли;
		
		Для каждого GroupMember Из СтрокаGroupLimits.GroupMember Цикл
		
			НоваяСтрока = ЭтотОбъект.СтруктураТаблиц.ГруппыЭмитентов.Добавить();
			НоваяСтрока.Contracts = ДоговорыСтрокой;
			НоваяСтрока.ИмяФайла = СтрокаФайла.ИмяФайла;
			НоваяСтрока.ИмяГруппы = СтрокаGroupLimits.Name;
			НоваяСтрока.IssuerID = GroupMember.Значение;
		
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Процедура ОтключитьОбработкуДублейЛимитов()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаЛимитов.НомерСтроки КАК НомерСтроки,
		|	ТаблицаЛимитов.IssuerID КАК IssuerID,
		|	ТаблицаЛимитов.LimitType КАК LimitType,
		|	ТаблицаЛимитов.InstrumentType КАК InstrumentType,
		|	ТаблицаЛимитов.Contracts КАК Contracts,
		|	ТаблицаЛимитов.ИмяФайла КАК ИмяФайла
		|ПОМЕСТИТЬ _Лимиты
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Лимиты.НомерСтроки) КАК НомерСтроки,
		|	ВложенныйЗапрос.IssuerID КАК IssuerID,
		|	ВложенныйЗапрос.Contracts КАК Contracts,
		|	ВложенныйЗапрос.ИмяФайла КАК ИмяФайла
		|ПОМЕСТИТЬ _ЛимитыКУдалению
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_Лимиты.IssuerID КАК IssuerID,
		|		_Лимиты.Contracts КАК Contracts,
		|		_Лимиты.ИмяФайла КАК ИмяФайла
		|	ИЗ
		|		_Лимиты КАК _Лимиты
		|	ГДЕ
		|		_Лимиты.LimitType = ""На объем вложений""
		|		И _Лимиты.InstrumentType = """") КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Лимиты КАК _Лимиты
		|		ПО ВложенныйЗапрос.IssuerID = _Лимиты.IssuerID
		|			И ВложенныйЗапрос.Contracts = _Лимиты.Contracts
		|			И ВложенныйЗапрос.ИмяФайла = _Лимиты.ИмяФайла
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.IssuerID,
		|	ВложенныйЗапрос.Contracts,
		|	ВложенныйЗапрос.ИмяФайла
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Лимиты.НомерСтроки) = 2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.НомерСтроки КАК НомерСтроки,
		|	_Лимиты.ИмяФайла КАК ИмяФайла
		|ИЗ
		|	_ЛимитыКУдалению КАК _ЛимитыКУдалению
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Лимиты КАК _Лимиты
		|		ПО _ЛимитыКУдалению.IssuerID = _Лимиты.IssuerID
		|			И _ЛимитыКУдалению.Contracts = _Лимиты.Contracts
		|			И _ЛимитыКУдалению.ИмяФайла = _Лимиты.ИмяФайла
		|			И (_Лимиты.LimitType = ""На объем вложений"")
		|			И (_Лимиты.InstrumentType = """")";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ЭтотОбъект.СтруктураТаблиц.IssuerLimits);
	
	ЛимитыКОтключению = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из ЭтотОбъект.СтруктураТаблиц.IssuerLimits Цикл
		
		НайденныеСтроки = ЛимитыКОтключению.НайтиСтроки(Новый Структура("НомерСтроки, ИмяФайла", Строка.НомерСтроки, Строка.ИмяФайла));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
		
			Строка.ЭтоДубльЛимита = Истина;
		
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры 

Процедура ЗаполнитьКлиентов(МенеджерВременныхТаблиц)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ИмяФайла КАК ИмяФайла,
		|	Файлы.Дата КАК Дата,
		|	Файлы.ИННКлиента КАК ИННКлиента
		|ПОМЕСТИТЬ _Файлы
		|ИЗ
		|	&Файлы КАК Файлы
		|ГДЕ
		|	НЕ Файлы.СодержитОшибки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.ИмяФайла КАК ИмяФайла,
		|	РеквизитыЮридическихЛицАнкетные.ЮрФизЛицо КАК Клиент
		|ИЗ
		|	(ВЫБРАТЬ
		|		_Файлы.ИмяФайла КАК ИмяФайла,
		|		_Файлы.Дата КАК Дата,
		|		_Файлы.ИННКлиента КАК ИННКлиента,
		|		МАКСИМУМ(РеквизитыЮридическихЛицАнкетные.Период) КАК ПериодРеквизитов
		|	ИЗ
		|		_Файлы КАК _Файлы
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
		|			ПО _Файлы.ИННКлиента = РеквизитыЮридическихЛицАнкетные.ИНН
		|				И _Файлы.Дата >= РеквизитыЮридическихЛицАнкетные.Период
		|				И (РеквизитыЮридическихЛицАнкетные.Организация = &Организация)
		|				И (РеквизитыЮридическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Файлы.ИННКлиента,
		|		_Файлы.Дата,
		|		_Файлы.ИмяФайла) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные КАК РеквизитыЮридическихЛицАнкетные
		|		ПО ВложенныйЗапрос.ПериодРеквизитов = РеквизитыЮридическихЛицАнкетные.Период
		|			И ВложенныйЗапрос.ИННКлиента = РеквизитыЮридическихЛицАнкетные.ИНН
		|			И (РеквизитыЮридическихЛицАнкетные.Организация = &Организация)
		|			И (РеквизитыЮридическихЛицАнкетные.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Файлы", ЭтотОбъект.СтруктураТаблиц.Файлы);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.Файлы.НайтиСтроки(Новый Структура("ИмяФайла", Выборка.ИмяФайла));
		Для каждого Строка Из НайденныеСтроки Цикл
			Строка.Клиент = Выборка.Клиент;
			Если Не ЗначениеЗаполнено(Выборка.Клиент) Тогда
				
				ЗарегистрироватьОшибкуПарсингаФайла(СтрШаблон("Клиент по ИНН %1 не найден", Строка.ИННКлиента), Строка.ИмяФайла, "Файлы", Строка.НомерСтроки, "");
								
			КонецЕсли; 
		КонецЦикла; 
	
	КонецЦикла; 

КонецПроцедуры
 
Процедура ЗаполнитьЭмитентов(МенеджерВременныхТаблиц)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеЭмитентов.ID КАК ID,
		|	ДанныеЭмитентов.Name КАК Name,
		|	ДанныеЭмитентов.ИмяФайла КАК ИмяФайла,
		|	ДанныеЭмитентов.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ _ДанныеЭмитентов
		|ИЗ
		|	&ДанныеЭмитентов КАК ДанныеЭмитентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Файлы.Дата КАК Дата,
		|	РеквизитыЮридическихЛиц.ЮрФизЛицо КАК ЮрФизЛицо,
		|	МАКСИМУМ(РеквизитыЮридическихЛиц.Период) КАК ДатаРеквизитов,
		|	МАКСИМУМ(ДокументыЮридическихЛиц.Период) КАК ДатаДокументов,
		|	МАКСИМУМ(СвязанныеЮридическиеЛица.Период) КАК ДатаСвязанныхЛиц,
		|	МАКСИМУМ(Поглощение.Период) КАК ДатаПоглощения
		|ПОМЕСТИТЬ _ДатыПериодическихСведений
		|ИЗ
		|	_Файлы КАК _Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|		ПО (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (РеквизитыЮридическихЛиц.Период <= _Файлы.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц КАК ДокументыЮридическихЛиц
		|		ПО (ДокументыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (ДокументыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДокументыЮридическихЛиц.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОРегистрации))
		|			И (РеквизитыЮридическихЛиц.ЮрФизЛицо = ДокументыЮридическихЛиц.ЮрФизЛицо)
		|			И (ДокументыЮридическихЛиц.Период <= _Файлы.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|		ПО (РеквизитыЮридическихЛиц.ЮрФизЛицо = СвязанныеЮридическиеЛица.ЮридическоеЛицо)
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК Поглощение
		|		ПО (РеквизитыЮридическихЛиц.ЮрФизЛицо = Поглощение.ЮридическоеЛицо)
		|			И (Поглощение.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Поглощена))
		|
		|СГРУППИРОВАТЬ ПО
		|	_Файлы.Дата,
		|	РеквизитыЮридическихЛиц.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеЭмитентов.ИмяФайла КАК ИмяФайла,
		|	_ДанныеЭмитентов.ID КАК ID,
		|	_ДанныеЭмитентов.Name КАК Name,
		|	_ДатыПериодическихСведений.Дата КАК Дата,
		|	ЕСТЬNULL(РеквизитыРодительскогоЮрЛица.ЮрФизЛицо, _ДатыПериодическихСведений.ЮрФизЛицо) КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _Эмитенты
		|ИЗ
		|	_ДанныеЭмитентов КАК _ДанныеЭмитентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Файлы КАК _Файлы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыПериодическихСведений КАК _ДатыПериодическихСведений
		|			ПО (_ДатыПериодическихСведений.Дата = _Файлы.Дата)
		|		ПО (_Файлы.ИмяФайла = _ДанныеЭмитентов.ИмяФайла)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|		ПО (_ДатыПериодическихСведений.ДатаРеквизитов = РеквизитыЮридическихЛиц.Период)
		|			И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (_ДатыПериодическихСведений.ЮрФизЛицо = РеквизитыЮридическихЛиц.ЮрФизЛицо)
		|			И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (_ДанныеЭмитентов.ID = РеквизитыЮридическихЛиц.ИНН
		|				ИЛИ _ДанныеЭмитентов.ID = РеквизитыЮридическихЛиц.TIN)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц КАК ДокументыЮридическихЛиц
		|		ПО (_ДатыПериодическихСведений.ДатаДокументов = ДокументыЮридическихЛиц.Период)
		|			И (_ДатыПериодическихСведений.ЮрФизЛицо = ДокументыЮридическихЛиц.ЮрФизЛицо)
		|			И (ДокументыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (ДокументыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (ДокументыЮридическихЛиц.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОРегистрации))
		|			И _ДанныеЭмитентов.ID = ДокументыЮридическихЛиц.Номер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК СвязанныеЮридическиеЛица
		|		ПО (_ДатыПериодическихСведений.ЮрФизЛицо = СвязанныеЮридическиеЛица.ЮридическоеЛицо)
		|			И (СвязанныеЮридическиеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|			И (_ДатыПериодическихСведений.ДатаСвязанныхЛиц = СвязанныеЮридическиеЛица.Период)
		|			И (СвязанныеЮридическиеЛица.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПериодическихСведений КАК _ДатыСведенийРодительскогоЮрЛица
		|		ПО (_ДатыСведенийРодительскогоЮрЛица.ЮрФизЛицо = СвязанныеЮридическиеЛица.РодительскоеЮридическоеЛицо)
		|			И (_ДатыСведенийРодительскогоЮрЛица.Дата = _Файлы.Дата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыРодительскогоЮрЛица
		|		ПО (РеквизитыРодительскогоЮрЛица.Период = _ДатыСведенийРодительскогоЮрЛица.ДатаРеквизитов)
		|			И (РеквизитыРодительскогоЮрЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (РеквизитыРодительскогоЮрЛица.ЮрФизЛицо = _ДатыСведенийРодительскогоЮрЛица.ЮрФизЛицо)
		|			И (РеквизитыРодительскогоЮрЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (РеквизитыРодительскогоЮрЛица.ИНН = РеквизитыЮридическихЛиц.ИНН)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица КАК Поглощение
		|		ПО (_ДатыПериодическихСведений.ЮрФизЛицо = Поглощение.ЮридическоеЛицо)
		|			И (Поглощение.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Поглощена))
		|			И (_ДатыПериодическихСведений.ДатаПоглощения = Поглощение.Период)
		|			И (Поглощение.Действует)
		|ГДЕ
		|	НЕ(РеквизитыЮридическихЛиц.ЮрФизЛицо ЕСТЬ NULL
		|				И ДокументыЮридическихЛиц.ЮрФизЛицо ЕСТЬ NULL)
		|	И Поглощение.ЮридическоеЛицо ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДанныеЭмитентов.ИмяФайла КАК ИмяФайла,
		|	_ДанныеЭмитентов.ID КАК ID,
		|	_ДанныеЭмитентов.Name КАК Name,
		|	_ДанныеЭмитентов.НомерСтроки КАК НомерСтроки,
		|	_Эмитенты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ИСТИНА КАК ВключаяФилиалы
		|ИЗ
		|	_ДанныеЭмитентов КАК _ДанныеЭмитентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Эмитенты КАК _Эмитенты
		|		ПО _ДанныеЭмитентов.ИмяФайла = _Эмитенты.ИмяФайла
		|			И _ДанныеЭмитентов.ID = _Эмитенты.ID";
	
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДанныеЭмитентов", ЭтотОбъект.СтруктураТаблиц.Issuers);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Результат = Запрос.Выполнить();
	
	ЭтотОбъект.СтруктураТаблиц.Issuers = Результат.Выгрузить(); 
	
	Для каждого СтрокаIssuers Из ЭтотОбъект.СтруктураТаблиц.Issuers Цикл
		
		СтруктураПоиска = Новый Структура("ИмяФайла, IssuerID", СтрокаIssuers.ИмяФайла, СтрокаIssuers.ID);
		НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.НайтиСтроки(СтруктураПоиска);
		
		Если Не ЗначениеЗаполнено(СтрокаIssuers.ЮрФизЛицо) Тогда
			
			ЗарегистрироватьОшибкуПарсингаФайла(СтрШаблон("Не найден эмитент по ИНН %1", СтрокаIssuers.ID), СтрокаIssuers.ИмяФайла, "Issuers", СтрокаIssuers.НомерСтроки, "ИмпортироватьЮЛ");
			
		Иначе
			
			Для каждого СтрокаIssuerLimits Из НайденныеСтроки Цикл
				СтрокаIssuerLimits.ЮрФизЛицо = СтрокаIssuers.ЮрФизЛицо;
				СтрокаIssuerLimits.ВключаяФилиалы = СтрокаIssuers.ВключаяФилиалы;
			КонецЦикла; 
			
			НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.ГруппыЭмитентов.НайтиСтроки(СтруктураПоиска);
			Для каждого СтрокаГруппыЭмитентов Из НайденныеСтроки Цикл
				СтрокаГруппыЭмитентов.ЮрФизЛицо = СтрокаIssuers.ЮрФизЛицо;
			КонецЦикла;			
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Запрос.Текст = "УНИЧТОЖИТЬ _ДанныеЭмитентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _ДатыПериодическихСведений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ _Эмитенты";
	Запрос.Выполнить();	

КонецПроцедуры

Процедура ПроверитьЗаполнитьСтрокуЛимитовЭмитентов(СтрокаЭмитентов, ОписаниеФайла)

	Отказ = Ложь;
	
	ТипыИнструментов = Новый Массив;
	ТипыИнструментов.Добавить("акции");
	ТипыИнструментов.Добавить("облигации");
	ТипыИнструментов.Добавить("депозиты");
	ТипыИнструментов.Добавить("брокерский счет");
	ТипыИнструментов.Добавить("банковский счет");
	ТипыИнструментов.Добавить("репо");
	ТипыИнструментов.Добавить("пфи");
	ТипыИнструментов.Добавить("");
	
	Если ТипыИнструментов.Найти(Нрег(СтрокаЭмитентов.InstrumentType)) = Неопределено Тогда
		ТекстОшибки = "Задан неподдерживаемый тип инструмента";
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
		ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
		СтрокаЭмитентов.ЕстьОшибкиПолученияУсловийОтбора = Истина;
	КонецЕсли; 
	
	Если СтрокаЭмитентов.LimitType = "На объем вложений" Тогда
		
		СтрокаЭмитентов.КонтролируемыйПоказатель = "Сумма без РЕПО";
		
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInCash) И ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInPercent) Тогда
		
			ТекстОшибки = "Для ограничения на объем вложений заданы одновременно лимиты в рублях и долях";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
			
		Иначе			
			
			ЗначениеВДолях = ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInPercent);
			СтрокаЭмитентов.МаксимальноеЗначение = ?(ЗначениеВДолях, СтрокаЭмитентов.LimitSizeInPercent, СтрокаЭмитентов.LimitSizeInCash);
			СтрокаЭмитентов.АбсолютнаяВеличинаМакс = Не ЗначениеВДолях;
			
		КонецЕсли; 
				
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInQuantity) Тогда
			ТекстОшибки = "Задан количественный лимит для ограничения на объем вложений";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInYears) Тогда
			ТекстОшибки = "Задан лимит в годах для ограничения на объем вложений";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли; 
	 
	ИначеЕсли СтрокаЭмитентов.LimitType = "На количество" Тогда
		
		СтрокаЭмитентов.КонтролируемыйПоказатель = "Количество";
		СтрокаЭмитентов.МаксимальноеЗначение = СтрокаЭмитентов.LimitSizeInQuantity;
		СтрокаЭмитентов.АбсолютнаяВеличинаМакс = Истина;
		
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInCash) Или ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInPercent) Тогда
			ТекстОшибки = "Задан лимит на объем вложений для ограничения на количество";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInYears) Тогда
			ТекстОшибки = "Задан лимит в годах для ограничения на количество";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли;
	 
	ИначеЕсли СтрокаЭмитентов.LimitType = "На дюрацию" Тогда 
		
		СтрокаЭмитентов.КонтролируемыйПоказатель = "Вес по дюрации (год без купленных РЕПО с ЦК)";
		СтрокаЭмитентов.МаксимальноеЗначение = СтрокаЭмитентов.LimitSizeInYears;
		СтрокаЭмитентов.ЛимитНаДюрацию = Истина;
		
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInCash) Или ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInPercent) Тогда
			ТекстОшибки = "Задан лимит на объем вложений для ограничения на дюрацию";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли; 
		Если ЗначениеЗаполнено(СтрокаЭмитентов.LimitSizeInQuantity) Тогда
			ТекстОшибки = "Задан количественный лимит для ограничения на дюрацию";
			ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
			ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		КонецЕсли;
		
	Иначе
		
		ТекстОшибки = СтрШаблон("Задан неподдерживаемый тип лимитов %1", СтрокаЭмитентов.LimitType);
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
		ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
			СтрокаЭмитентов.ЕстьОшибкиЗаполненияСтрокиИД = Истина;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СтрокаЭмитентов.IsGuaranteed) И Не ЗначениеЗаполнено(СтрокаЭмитентов.Guarantor) Тогда
	
		ТекстОшибки = "Не указан гарант";
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
		ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
		СтрокаЭмитентов.ЕстьОшибкиПолученияУсловийОтбора = Истина;
	
	КонецЕсли; 
	
	Если СтрокаЭмитентов.MaturityTo + СтрокаЭмитентов.MaturityFrom > 0 
		И Не (НРег(СтрокаЭмитентов.InstrumentType) = "облигации" Или НРег(СтрокаЭмитентов.InstrumentType) = "депозиты"
			 Или НРег(СтрокаЭмитентов.InstrumentType) = "репо") Тогда
	
		ТекстОшибки = "Задан неподдерживаемый тип инструмента вместе со сроком до погашения";
		ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеСтрокиОшибки(СтрокаЭмитентов);
		ЗарегистрироватьОшибкуПарсингаФайла(ТекстОшибки, ОписаниеФайла.ИмяФайла, "IssuerLimits", СтрокаЭмитентов.НомерСтроки);
		СтрокаЭмитентов.ЕстьОшибкиПолученияУсловийОтбора = Истина;
	
	КонецЕсли; 

	Если ЗначениеЗаполнено(СтрокаЭмитентов.SellOnly) Тогда
		СтрокаЭмитентов.ДатаЗапретаПокупки = ОписаниеФайла.Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДоговоры()

	НомераДоговоров = Новый ТаблицаЗначений;
	НомераДоговоров.Колонки.Добавить("ИмяФайла", 		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
	НомераДоговоров.Колонки.Добавить("Клиент", 			Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	НомераДоговоров.Колонки.Добавить("ДатаФайла", 		Новый ОписаниеТипов("Дата"));
	НомераДоговоров.Колонки.Добавить("ГруппаДоговоров", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));
	НомераДоговоров.Колонки.Добавить("НомерДоговора", 	Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(70)));	
	
	Для каждого СтрокаФайла Из ЭтотОбъект.СтруктураТаблиц.Файлы Цикл
	
		Для каждого ГруппаДоговоров Из СтрокаФайла.ГруппыДоговоров Цикл
		
			Для каждого НомерДоговора Из СтрРазделить(ГруппаДоговоров.Представление, ",", Ложь) Цикл
				СтрокаДоговоры = НомераДоговоров.Добавить();
				СтрокаДоговоры.ИмяФайла			= СтрокаФайла.ИмяФайла;
				СтрокаДоговоры.Клиент 			= СтрокаФайла.Клиент;
				СтрокаДоговоры.ДатаФайла 		= СтрокаФайла.Дата;
				СтрокаДоговоры.ГруппаДоговоров 	= ГруппаДоговоров.Представление;
				СтрокаДоговоры.НомерДоговора 	= СокрЛП(НомерДоговора);
			КонецЦикла; 
		
		КонецЦикла; 
			
	КонецЦикла; 
	
	#Область Текст_запроса_поиска_договоров
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераДоговоров.ИмяФайла КАК ИмяФайла,
		|	НомераДоговоров.ДатаФайла КАК ДатаФайла,
		|	НомераДоговоров.Клиент КАК Клиент,
		|	НомераДоговоров.ГруппаДоговоров КАК ГруппаДоговоров,
		|	НомераДоговоров.НомерДоговора КАК НомерДоговора,
		|	НомераДоговоров.ГруппаДоговоров + "".%"" КАК Комментарий
		|ПОМЕСТИТЬ _НомераДоговоров
		|ИЗ
		|	&НомераДоговоров КАК НомераДоговоров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НомераДоговоров.ИмяФайла КАК ИмяФайла,
		|	_НомераДоговоров.ГруппаДоговоров КАК ГруппаДоговоров,
		|	ЗначенияДополнительныхСведений.Объект КАК ИнвестиционнаяДекларация
		|ПОМЕСТИТЬ _ИнвестиционныеДекларации
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_НомераДоговоров.ИмяФайла КАК ИмяФайла,
		|		_НомераДоговоров.ГруппаДоговоров КАК ГруппаДоговоров,
		|		_НомераДоговоров.Комментарий КАК Комментарий
		|	ИЗ
		|		_НомераДоговоров КАК _НомераДоговоров) КАК _НомераДоговоров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО (ЗначенияДополнительныхСведений.Значение = _НомераДоговоров.ИмяФайла)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО (ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка)
		|			И (ДополнительныеСведения.Ключ = ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
		|		ПО (ИнвестиционныеДекларации.Ссылка = ЗначенияДополнительныхСведений.Объект)
		|			И (ИнвестиционныеДекларации.Комментарий ПОДОБНО _НомераДоговоров.Комментарий)
		|			И (НЕ ИнвестиционныеДекларации.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НомераДоговоров.ИмяФайла КАК ИмяФайла,
		|	_НомераДоговоров.ГруппаДоговоров КАК ГруппаДоговоров,
		|	_НомераДоговоров.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_ИнвестиционныеДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|ИЗ
		|	_НомераДоговоров КАК _НомераДоговоров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				,
		|				(Организация, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						СчетаДоверительногоУправления.Организация КАК Организация,
		|						СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|					ИЗ
		|						Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|							ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НомераДоговоров КАК _НомераДоговоров
		|							ПО
		|								СчетаДоверительногоУправления.НомерДоговора = _НомераДоговоров.НомерДоговора
		|									И СчетаДоверительногоУправления.Организация = &Организация)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО _НомераДоговоров.Клиент = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|			И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора = _НомераДоговоров.НомерДоговора)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныеДекларации КАК _ИнвестиционныеДекларации
		|		ПО _НомераДоговоров.ИмяФайла = _ИнвестиционныеДекларации.ИмяФайла
		|			И _НомераДоговоров.ГруппаДоговоров = _ИнвестиционныеДекларации.ГруппаДоговоров
		|ИТОГИ
		|	МАКСИМУМ(ИнвестиционнаяДекларация)
		|ПО
		|	ИмяФайла,
		|	ГруппаДоговоров";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НомераДоговоров", НомераДоговоров);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Результат = Запрос.Выполнить();
	ВыборкаИмяФайла = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИмяФайла.Следующий() Цикл
	
		ВыборкаГруппаДоговоров = ВыборкаИмяФайла.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппаДоговоров.Следующий() Цикл
			
			Выборка = ВыборкаГруппаДоговоров.Выбрать();
			СписокДоговоров = Новый Массив;
			ОшибкиДоговоров = Новый Массив;
			ВидыДоговоров = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				
				СписокДоговоров.Добавить(Выборка.СчетДоверительногоУправления);
				
				Если ВидыДоговоров.Найти(Выборка.ВидДоговораДоверительногоУправления) = Неопределено Тогда
					ВидыДоговоров.Добавить(Выборка.ВидДоговораДоверительногоУправления);
				КонецЕсли; 
				
				Если Не ЗначениеЗаполнено(Выборка.СчетДоверительногоУправления) И ОшибкиДоговоров.Найти(Выборка.НомерДоговора) = Неопределено Тогда
					ОшибкиДоговоров.Добавить(Выборка.НомерДоговора);
				КонецЕсли; 
				
			КонецЦикла; 
			
			СтрокиФайлов = ЭтотОбъект.СтруктураТаблиц.Файлы.НайтиСтроки(Новый Структура("ИмяФайла", ВыборкаГруппаДоговоров.ИмяФайла));
			
			Для каждого Строка Из СтрокиФайлов Цикл
			
				ОтборГруппДоговоров = Новый Структура("Представление", ВыборкаГруппаДоговоров.ГруппаДоговоров);
				СтрокиГруппДоговоров = Строка.ГруппыДоговоров.НайтиСтроки(ОтборГруппДоговоров);
				
				Если СтрокиГруппДоговоров.Количество() = 1 Тогда
					
					СтрокиГруппДоговоров[0].СписокДоговоров.ЗагрузитьЗначения(СписокДоговоров);
					СтрокиГруппДоговоров[0].ИнвестиционнаяДекларация = ВыборкаГруппаДоговоров.ИнвестиционнаяДекларация;
					ЗаполнитьБазисИВидДоговора(Строка, ВидыДоговоров);
					
				КонецЕсли;
				
				Для каждого НомерДоговора Из ОшибкиДоговоров Цикл
				
					ОписаниеОшибки = "Не найден договор по номеру " + НомерДоговора;
					ЗарегистрироватьОшибкуПарсингаФайла(ОписаниеОшибки, ВыборкаГруппаДоговоров.ИмяФайла, "Файлы", Строка.НомерСтроки);					
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла; 

КонецПроцедуры

Процедура ЗаполнитьБазисИВидДоговора(СтрокаТаблицыФайлов, ВидыДоговоров)

	ОписаниеОшибки = "";
	
	Если ВидыДоговоров.Количество() = 1 Тогда
		
		ВидДоговора = ВидыДоговоров[0];
		
		СтрокаТаблицыФайлов.ВидДоговораДоверительногоУправления = ВидДоговора;
		
		Если ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			СтрокаТаблицыФайлов.Базис = ОбщегоНазначения.ПолучитьИменованныйОбъект("Базис_СА_ПН_ПФР");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда 
			СтрокаТаблицыФайлов.Базис = ОбщегоНазначения.ПолучитьИменованныйОбъект("Базис_СЧА_ПР_НПФ");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда 
			СтрокаТаблицыФайлов.Базис = ОбщегоНазначения.ПолучитьИменованныйОбъект("Базис_СА_ДУ_ПИФ");
		Иначе
			ОписаниеОшибки = СтрШаблон("Импорт ЛВ по виду договоров %1 не поддерживается", ВидДоговора);
		КонецЕсли; 
		
	ИначеЕсли ВидыДоговоров.Количество() = 0 Тогда 
		ОписаниеОшибки = СтрШаблон("Не удалось определить вид договора");
	Иначе
		ОписаниеОшибки = СтрШаблон("В файле указаны договоры разных видов");		
	КонецЕсли; 
	
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		ЗарегистрироватьОшибкуПарсингаФайла(ОписаниеОшибки, СтрокаТаблицыФайлов.ИмяФайла, "Файлы", СтрокаТаблицыФайлов.НомерСтроки);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ЗаполнитьНазначения()

	ТаблицаФайлы = Новый ТаблицаЗначений;
	ТаблицаФайлы.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255)));
	ТаблицаФайлы.Колонки.Добавить("Клиент", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ТаблицаФайлы.Колонки.Добавить("ВидДоговораДоверительногоУправления", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	
	Для каждого СтрокаТаблицыФайлы Из ЭтотОбъект.СтруктураТаблиц.Файлы Цикл
		
		НоваяСтрока = ТаблицаФайлы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыФайлы);
		
	КонецЦикла; 
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ИмяФайла КАК ИмяФайла,
		|	Файлы.Клиент КАК Клиент,
		|	Файлы.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _Файлы
		|ИЗ
		|	&Файлы КАК Файлы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Файлы.ИмяФайла КАК ИмяФайла,
		|	ЗначенияДополнительныхСведений.Объект КАК НазначениеИнвестиционнойДекларации
		|ИЗ
		|	_Файлы КАК _Файлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО _Файлы.ИмяФайла = ЗначенияДополнительныхСведений.Значение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеИнвестиционнойДекларации КАК НазначениеИнвестиционнойДекларации
		|		ПО (НазначениеИнвестиционнойДекларации.Ссылка = ЗначенияДополнительныхСведений.Объект)
		|			И (НазначениеИнвестиционнойДекларации.Организация = &Организация)
		|			И (НазначениеИнвестиционнойДекларации.Субъект = _Файлы.Клиент)
		|			И (НазначениеИнвестиционнойДекларации.ВидДоговораДоверительногоУправления = _Файлы.ВидДоговораДоверительногоУправления)
		|			И (НазначениеИнвестиционнойДекларации.ТипИнвестиционнойДекларации = ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость))
		|			И (НЕ НазначениеИнвестиционнойДекларации.ПометкаУдаления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО (ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка)
		|			И (ДополнительныеСведения.Ключ = ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости"")";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Файлы", ТаблицаФайлы);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		СтрокаТаблицыФайлы = ЭтотОбъект.СтруктураТаблиц.Файлы.Найти(Выборка.ИмяФайла, "ИмяФайла");
		СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации = Выборка.НазначениеИнвестиционнойДекларации;
	
	КонецЦикла; 

КонецПроцедуры

Функция ЗаполнитьЦенныеБумаги(ТаблицаЦБ)

	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТаблицаЦБ.ISIN КАК ISIN
		|ПОМЕСТИТЬ _Коды
		|ИЗ
		|	&ТаблицаЦБ КАК ТаблицаЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Коды.ISIN КАК ISIN,
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага
		|ИЗ
		|	_Коды КАК _Коды
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _Коды.ISIN = КодыВТорговыхСистемахСрезПоследних.Код";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаЦБ", ТаблицаЦБ);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		СтруктураПоиска = Новый Структура("ISIN", Выборка.ISIN);
		НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.НайтиСтроки(СтруктураПоиска);
			
		Если Не ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			
			Для каждого СтрокаIssuerLimits Из НайденныеСтроки Цикл
				ЗарегистрироватьОшибкуПарсингаФайла(СтрШаблон("Не найдена ценная бумага по ISIN %1", Выборка.ISIN), СтрокаIssuerLimits.ИмяФайла, "IssuerLimits", СтрокаIssuerLimits.НомерСтроки, "ИмпортироватьЦБ");
			КонецЦикла; 
			
		Иначе
			
			Для каждого СтрокаIssuerLimits Из НайденныеСтроки Цикл
				СтрокаIssuerLimits.ЦеннаяБумага = Выборка.ЦеннаяБумага;
			КонецЦикла;
		
		КонецЕсли;
	
	КонецЦикла; 

КонецФункции

#Область Регистрация_ошибок
 
Функция ОписаниеСтрокиОшибки(СтрокаЭмитентов)

	Поля = "IssuerID,LimitType,InstrumentType,LimitSizeInQuantity,LimitSizeInCash,LimitSizeInPercent,LimitSizeInYears,SellOnly,MaturityFrom,MaturityTo,ISIN,IsGuaranteed,Guarantor,Contracts";
	МассивСтрок = Новый Массив;
	Для каждого ИмяПоля Из СтрРазделить(Поля, ",") Цикл
		Если ЗначениеЗаполнено(СтрокаЭмитентов[ИмяПоля]) Тогда
			МассивСтрок.Добавить(ИмяПоля + "=""" + Формат(СтрокаЭмитентов[ИмяПоля], "ЧГ=0") +  """");
		КонецЕсли; 
	КонецЦикла; 
	Возврат СтрСоединить(МассивСтрок, " ");

КонецФункции

Процедура ЗарегистрироватьОшибкуПарсингаФайла(ОписаниеОшибки, ИмяФайла, Раздел, ИдентификаторСтроки, Действие = "", ХэшСуммаУсловийОтбора = "")
	
	Ошибка = ЭтотОбъект.СтруктураТаблиц.Ошибки.Добавить();
	
	Ошибка.ОписаниеОшибки = ОписаниеОшибки;
	Ошибка.ИмяФайла = ИмяФайла;
	Ошибка.Раздел = Раздел;
	Ошибка.ИдентификаторСтроки = ИдентификаторСтроки;
	Ошибка.Действие = Действие;
	Ошибка.ХэшСуммаУсловийОтбора = ХэшСуммаУсловийОтбора;
	
	СтрокиФайлов = ЭтотОбъект.СтруктураТаблиц.Файлы.НайтиСтроки(Новый Структура("ИмяФайла, СодержитОшибки", ИмяФайла, Ложь));
	Для каждого Строка Из СтрокиФайлов Цикл
		Строка.СодержитОшибки = Истина;
	КонецЦикла; 
	
КонецПроцедуры
	
#КонецОбласти 

#Область Заполнение_набора

Процедура ЗаполнитьНаборы()

	КлючевыеПоляНабора = "InstrumentType, IsGuaranteed, Guarantor, MaturityTo, MaturityFrom, ИмяФайла, ЛимитНаДюрацию";
	
	ТаблицаНаборов = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.Скопировать(Новый Структура("IsGuaranteed, ЕстьОшибкиПолученияУсловийОтбора", Неопределено, Ложь), КлючевыеПоляНабора);
	// имя файла нужно только для поиска гаранта, добавим строки по наборам с гарантами позже
	ТаблицаНаборов.ЗаполнитьЗначения(Неопределено, "ИмяФайла");
	ТаблицаНаборов.Свернуть(КлючевыеПоляНабора);
	
	НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.НайтиСтроки(Новый Структура("IsGuaranteed, ЕстьОшибкиПолученияУсловийОтбора", Истина, Ложь));
	Для каждого Строка Из НайденныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаНаборов.Добавить(), Строка);
	КонецЦикла;
	НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.НайтиСтроки(Новый Структура("IsGuaranteed, ЕстьОшибкиПолученияУсловийОтбора", Ложь, Ложь));
	Для каждого Строка Из НайденныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаНаборов.Добавить(), Строка);
	КонецЦикла;
	
	ТаблицаНаборов.Колонки.Добавить("ХэшСуммаУсловийОтбора", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ТаблицаНаборов.Колонки.Добавить("Отбор", Новый ОписаниеТипов("ОтборКомпоновкиДанных"));
	ТаблицаНаборов.Колонки.Добавить("Набор", Новый ОписаниеТипов("СправочникСсылка.НаборыИнвестиционныхДеклараций"));
		
	Для каждого ДанныеНабора Из ТаблицаНаборов Цикл
		СоздатьНастройкиНабора(ДанныеНабора);
	КонецЦикла; 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаНаборов.ХэшСуммаУсловийОтбора КАК ХэшСуммаУсловийОтбора
		|ПОМЕСТИТЬ _ХэшСуммы
		|ИЗ
		|	&ТаблицаНаборов КАК ТаблицаНаборов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ХэшСуммы.ХэшСуммаУсловийОтбора КАК ХэшСуммаУсловийОтбора,
		|	НаборыИнвестиционныхДеклараций.Ссылка КАК Ссылка
		|ИЗ
		|	_ХэшСуммы КАК _ХэшСуммы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыИнвестиционныхДеклараций КАК НаборыИнвестиционныхДеклараций
		|		ПО _ХэшСуммы.ХэшСуммаУсловийОтбора = НаборыИнвестиционныхДеклараций.ХешСуммаУсловийОтбора";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаНаборов", ТаблицаНаборов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		НайденныеСтроки = ТаблицаНаборов.НайтиСтроки(Новый Структура("ХэшСуммаУсловийОтбора", Выборка.ХэшСуммаУсловийОтбора));
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Для каждого Строка Из НайденныеСтроки Цикл
				Строка.Набор = Выборка.Ссылка;
			КонецЦикла; 
		КонецЕсли; 
	
	КонецЦикла;
	
	Для каждого ДанныеНабора Из ТаблицаНаборов Цикл
	
		ПараметрыОтбора = Новый Структура("InstrumentType, IsGuaranteed, Guarantor, MaturityTo, MaturityFrom, ЛимитНаДюрацию");
		Если ЗначениеЗаполнено(ДанныеНабора.IsGuaranteed) Тогда
			ПараметрыОтбора.Вставить("ИмяФайла");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ДанныеНабора); 
		НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.IssuerLimits.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого СтрокаIssuerLimits Из НайденныеСтроки Цикл
		
			СтрокаIssuerLimits.НаборИнвестиционнойДекларации = ДанныеНабора.Набор;
			СтрокаIssuerLimits.ХэшСуммаУсловийОтбора = ДанныеНабора.ХэшСуммаУсловийОтбора;
			
			СтрокаIssuerLimits.ОпределяетСоставИСтруктуру = ЗначениеЗаполнено(ДанныеНабора.InstrumentType) Или ЗначениеЗаполнено(СтрокаIssuerLimits.ISIN) Или (СтрокаIssuerLimits.ЮрФизЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии"));
			
			Если Не ЗначениеЗаполнено(ДанныеНабора.Набор) Тогда
			
				СтрокаIssuerLimits.Отбор = ДанныеНабора.Отбор;
				ЗарегистрироватьОшибкуПарсингаФайла(СтрШаблон("Не найден подходящий набор: %1", ДанныеНабора.Отбор), СтрокаIssuerLimits.ИмяФайла, "IssuerLimits", СтрокаIssuerLimits.НомерСтроки, "Создать", СтрокаIssuerLimits.ХэшСуммаУсловийОтбора);
			
			КонецЕсли; 
		
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура СоздатьНастройкиНабора(ДанныеНабора)
	
	Настройки = Новый НастройкиКомпоновкиДанных;
	Отбор = Настройки.Отбор;
	Если ЗначениеЗаполнено(ДанныеНабора.InstrumentType) Тогда
	
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
		СоответствиеВидовАктивов = Новый Соответствие;
		// следующие виды активов пока не грузим: Паи;Депозитарные расписки;Ипотечные сертификаты участия;Дебиторская задолженность;Кредиторская задолженность;Доли
		СоответствиеВидовАктивов.Вставить("акции", "Акции");
		СоответствиеВидовАктивов.Вставить("облигации", "Облигации");
		СоответствиеВидовАктивов.Вставить("депозиты", "Депозиты");
		СоответствиеВидовАктивов.Вставить("брокерский счет", "Денежные средства у брокера");
		СоответствиеВидовАктивов.Вставить("банковский счет", "Денежные средства на расчетных счетах");
		СоответствиеВидовАктивов.Вставить("репо", "Дебиторская задолженность");
		СоответствиеВидовАктивов.Вставить("пфи", "СПФИ");
		ПравоеЗначение = СоответствиеВидовАктивов.Получить(НРег(ДанныеНабора.InstrumentType));
		ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
		
		Если НРег(ДанныеНабора.InstrumentType) = "репо" Тогда
		
			ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.Актив");
			ЭлементОтбора.ПравоеЗначение = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО;
		
		КонецЕсли; 
		
	КонецЕсли; 
	Если ЗначениеЗаполнено(ДанныеНабора.IsGuaranteed) Тогда
	
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.Гарант");
		ЭлементОтбора.ВидСравнения = ?(ДанныеНабора.IsGuaranteed, ВидСравненияКомпоновкиДанных.Равно, ВидСравненияКомпоновкиДанных.НеРавно);
		НайденныеСтроки = ЭтотОбъект.СтруктураТаблиц.Issuers.НайтиСтроки(Новый Структура("ID, ИмяФайла", ДанныеНабора.Guarantor, ДанныеНабора.ИмяФайла));
		Если НайденныеСтроки.Количество() = 1 Тогда
			ЭлементОтбора.ПравоеЗначение = НайденныеСтроки[0].ЮрФизЛицо;
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеНабора.MaturityTo) Тогда
	
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
		ЭлементОтбора.ПравоеЗначение = ДанныеНабора.MaturityTo;
		
		Если НРег(ДанныеНабора.InstrumentType) = "облигации" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ЛетДоОфертыПогашенияОблигации");
		ИначеЕсли НРег(ДанныеНабора.InstrumentType) = "депозиты" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Депозиты.ЛетДоПогашенияДепозита");
		ИначеЕсли НРег(ДанныеНабора.InstrumentType) = "репо" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.СрокРЕПОВГодах");
		КонецЕсли; 
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеНабора.MaturityFrom) Тогда
	
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = ДанныеНабора.MaturityFrom;
		
		Если ДанныеНабора.InstrumentType = "Облигации" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ЛетДоОфертыПогашенияОблигации");
		ИначеЕсли ДанныеНабора.InstrumentType = "Депозиты" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Депозиты.ЛетДоПогашенияДепозита");
		ИначеЕсли НРег(ДанныеНабора.InstrumentType) = "репо" Тогда
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.СрокРЕПОВГодах");
		КонецЕсли; 
	
	КонецЕсли;
	
	Если ДанныеНабора.ЛимитНаДюрацию Тогда
	
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Классификация");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.ПравоеЗначение = "По амортизированной стоимости";
		
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Классификация");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.ПравоеЗначение = "Удерживаемые до погашения";
		
	КонецЕсли; 
	
	ДанныеНабора.ХэшСуммаУсловийОтбора = Справочники.НаборыИнвестиционныхДеклараций.ПолучитьХэшСуммуУсловийОтбора(Настройки);
	ДанныеНабора.Отбор = Отбор;
	
КонецПроцедуры
	
#КонецОбласти  

#КонецОбласти 

#Область Сводный_отчет

Функция ПолучитьСводнуюТаблицуЛимитов(СтруктураТаблиц) Экспорт

	ИменаКолонок = "IssuerID, LimitType, LimitSizeInCash, InstrumentType, Contracts, SellOnly, MaturityTo, LimitSizeInQuantity, 
		|ISIN, MaturityFrom, IsGuaranteed, Guarantor, LimitSizeInYears, ЮрФизЛицо, ЦеннаяБумага, LimitSizeInPercent";
	
	СводнаяТаблица = СтруктураТаблиц.IssuerLimits.Скопировать(, ИменаКолонок);
	
	СводнаяТаблица.Колонки.Добавить("GroupName", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	Для каждого ИсходнаяСтрока Из СтруктураТаблиц.GroupLimits Цикл
		
		НоваяСтрока = СводнаяТаблица.Добавить();
		НоваяСтрока.LimitType = "На группу";
		НоваяСтрока.Contracts = ИсходнаяСтрока.Contracts;
		НоваяСтрока.GroupName = ИсходнаяСтрока.Name;
		НоваяСтрока.LimitSizeInCash = ИсходнаяСтрока.LimitSizeInCash;
		
	КонецЦикла; 
	
	Возврат СводнаяТаблица;
	
КонецФункции 

Функция ПолучитьСводныйОтчет(ГруппыЭмитентов, СводнаяТаблица) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппыЭмитентов", ГруппыЭмитентов);
	Запрос.УстановитьПараметр("ТаблицаЛимитов", СводнаяТаблица);
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыЭмитентов.ИмяГруппы КАК ИмяГруппы,
		|	ГруппыЭмитентов.Contracts КАК Contracts,
		|	ГруппыЭмитентов.IssuerID КАК IssuerID,
		|	ГруппыЭмитентов.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _ГруппыЭмитентов
		|ИЗ
		|	&ГруппыЭмитентов КАК ГруппыЭмитентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаЛимитов.IssuerID КАК IssuerID,
		|	ТаблицаЛимитов.LimitType КАК LimitType,
		|	ТаблицаЛимитов.LimitSizeInCash / 1000000 КАК LimitSizeInCash,
		|	ТаблицаЛимитов.InstrumentType КАК InstrumentType,
		|	ТаблицаЛимитов.SellOnly КАК SellOnly,
		|	ТаблицаЛимитов.MaturityTo КАК MaturityTo,
		|	ТаблицаЛимитов.LimitSizeInQuantity КАК LimitSizeInQuantity,
		|	ТаблицаЛимитов.ISIN КАК ISIN,
		|	ТаблицаЛимитов.MaturityFrom КАК MaturityFrom,
		|	ТаблицаЛимитов.IsGuaranteed КАК IsGuaranteed,
		|	ТаблицаЛимитов.Guarantor КАК Guarantor,
		|	ТаблицаЛимитов.LimitSizeInYears КАК LimitSizeInYears,
		|	ТаблицаЛимитов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаЛимитов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЛимитов.LimitSizeInPercent КАК LimitSizeInPercent,
		|	ТаблицаЛимитов.GroupName КАК GroupName,
		|	ТаблицаЛимитов.Contracts КАК Contracts
		|ПОМЕСТИТЬ _Лимиты
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash
		|ПОМЕСТИТЬ _ЛимитыДС
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""банковский счет""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash
		|ПОМЕСТИТЬ _ЛимитыБрокер
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""брокерский счет""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash
		|ПОМЕСТИТЬ _ЛимитыРЕПО
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""репо""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo,
		|	_Лимиты.MaturityTo + _Лимиты.MaturityFrom = 0 КАК ВыгрузкаРеализована
		|ПОМЕСТИТЬ _ЛимитыДепозиты
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""депозиты""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.IsGuaranteed КАК IsGuaranteed,
		|	_Лимиты.Guarantor КАК Guarantor,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.MaturityTo + _Лимиты.MaturityFrom = 0
		|		И _Лимиты.IsGuaranteed = НЕОПРЕДЕЛЕНО
		|		И _Лимиты.ISIN = """" КАК ВыгрузкаРеализована
		|ПОМЕСТИТЬ _ЛимитыОблигации
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""облигации""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Contracts КАК Contracts,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.ISIN = """" КАК ВыгрузкаРеализована
		|ПОМЕСТИТЬ _ЛимитыАкции
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""акции""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(_ЛимитыГрупп.GroupName, """") КАК Группа,
		|	_ЛимитыГрупп.GroupName ЕСТЬ NULL КАК ГруппаПорядок,
		|	ЕСТЬNULL(_ЛимитыГрупп.LimitSizeInCash, 0) КАК ЛимитНаГруппу,
		|	ЮрЛица.IssuerID КАК ИНН,
		|	ЮрЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ЛимитыСовокупные.LimitSizeInCash КАК ЛимитНаЭмитента,
		|	ЮрЛица.Contracts КАК Contracts,
		|	ЕСТЬNULL(_ЛимитыДС.LimitSizeInCash, 0) КАК ДС,
		|	ЕСТЬNULL(_ЛимитыБрокер.LimitSizeInCash, 0) КАК Брокер,
		|	ЕСТЬNULL(_ЛимитыРЕПО.LimitSizeInCash, 0) КАК РЕПО,
		|	ЕСТЬNULL(_ЛимитыДепозиты.LimitSizeInCash, 0) КАК Депозиты,
		|	ЕСТЬNULL(_ЛимитыОблигации.LimitSizeInCash, 0) КАК Облигации,
		|	ЕСТЬNULL(_ЛимитыОблигации.SellOnly, ЛОЖЬ) КАК Облигации_SellOnly,
		|	ЕСТЬNULL(_ЛимитыАкции.LimitSizeInCash, 0) КАК Акции,
		|	ЕСТЬNULL(_ЛимитыАкции.SellOnly, ЛОЖЬ) КАК Акции_SellOnly
		|ПОМЕСТИТЬ _ОсновнаяТаблица
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ГруппыЭмитентов.IssuerID КАК IssuerID,
		|		_ГруппыЭмитентов.ЮрФизЛицо КАК ЮрФизЛицо,
		|		_ГруппыЭмитентов.Contracts КАК Contracts
		|	ИЗ
		|		_ГруппыЭмитентов КАК _ГруппыЭмитентов
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_Лимиты.IssuerID,
		|		_Лимиты.ЮрФизЛицо,
		|		_Лимиты.Contracts
		|	ИЗ
		|		_Лимиты КАК _Лимиты
		|	ГДЕ
		|		_Лимиты.LimitType = ""На объем вложений""
		|		И _Лимиты.ЮрФизЛицо <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|		И _Лимиты.LimitSizeInCash > 0) КАК ЮрЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Лимиты КАК _ЛимитыСовокупные
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыСовокупные.ЮрФизЛицо
		|			И ЮрЛица.Contracts = _ЛимитыСовокупные.Contracts
		|			И (_ЛимитыСовокупные.LimitType = ""На объем вложений"")
		|			И (_ЛимитыСовокупные.InstrumentType = """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГруппыЭмитентов КАК _ГруппыЭмитентов
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Лимиты КАК _ЛимитыГрупп
		|			ПО _ГруппыЭмитентов.ИмяГруппы = _ЛимитыГрупп.GroupName
		|				И _ГруппыЭмитентов.Contracts = _ЛимитыГрупп.Contracts
		|		ПО ЮрЛица.ЮрФизЛицо = _ГруппыЭмитентов.ЮрФизЛицо
		|			И ЮрЛица.Contracts = _ГруппыЭмитентов.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыДС КАК _ЛимитыДС
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыДС.ЮрФизЛицо
		|			И ЮрЛица.Contracts = _ЛимитыДС.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыБрокер КАК _ЛимитыБрокер
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыБрокер.ЮрФизЛицо
		|			И ЮрЛица.Contracts = _ЛимитыБрокер.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыРЕПО КАК _ЛимитыРЕПО
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыРЕПО.ЮрФизЛицо
		|			И ЮрЛица.Contracts = _ЛимитыРЕПО.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыДепозиты КАК _ЛимитыДепозиты
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыДепозиты.ЮрФизЛицо
		|			И (_ЛимитыДепозиты.ВыгрузкаРеализована)
		|			И ЮрЛица.Contracts = _ЛимитыДепозиты.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыОблигации КАК _ЛимитыОблигации
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыОблигации.ЮрФизЛицо
		|			И (_ЛимитыОблигации.ВыгрузкаРеализована)
		|			И ЮрЛица.Contracts = _ЛимитыОблигации.Contracts
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыАкции КАК _ЛимитыАкции
		|		ПО ЮрЛица.ЮрФизЛицо = _ЛимитыАкции.ЮрФизЛицо
		|			И (_ЛимитыАкции.ВыгрузкаРеализована)
		|			И ЮрЛица.Contracts = _ЛимитыАкции.Contracts
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Депозиты"" КАК ВидАктива,
		|	_ЛимитыДепозиты.Contracts КАК Contracts,
		|	_ЛимитыДепозиты.IssuerID КАК IssuerID,
		|	_ЛимитыДепозиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ЛимитыДепозиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_ЛимитыДепозиты.MaturityFrom КАК MaturityFrom,
		|	_ЛимитыДепозиты.MaturityTo КАК MaturityTo,
		|	_ЛимитыДепозиты.ВыгрузкаРеализована КАК ВыгрузкаРеализована,
		|	NULL КАК ЦеннаяБумага,
		|	NULL КАК ISIN,
		|	NULL КАК IsGuaranteed,
		|	NULL КАК Guarantor,
		|	NULL КАК SellOnly
		|ПОМЕСТИТЬ _ЛимитыБезВыгрузки
		|ИЗ
		|	_ЛимитыДепозиты КАК _ЛимитыДепозиты
		|ГДЕ
		|	НЕ _ЛимитыДепозиты.ВыгрузкаРеализована
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Акции"",
		|	_ЛимитыАкции.Contracts,
		|	_ЛимитыАкции.IssuerID,
		|	_ЛимитыАкции.ЮрФизЛицо,
		|	_ЛимитыАкции.LimitSizeInCash,
		|	NULL,
		|	NULL,
		|	_ЛимитыАкции.ВыгрузкаРеализована,
		|	_ЛимитыАкции.ЦеннаяБумага,
		|	_ЛимитыАкции.ISIN,
		|	NULL,
		|	NULL,
		|	_ЛимитыАкции.SellOnly
		|ИЗ
		|	_ЛимитыАкции КАК _ЛимитыАкции
		|ГДЕ
		|	НЕ _ЛимитыАкции.ВыгрузкаРеализована
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Облигации"",
		|	_ЛимитыОблигации.Contracts,
		|	_ЛимитыОблигации.IssuerID,
		|	_ЛимитыОблигации.ЮрФизЛицо,
		|	_ЛимитыОблигации.LimitSizeInCash,
		|	_ЛимитыОблигации.MaturityFrom,
		|	_ЛимитыОблигации.MaturityTo,
		|	_ЛимитыОблигации.ВыгрузкаРеализована,
		|	_ЛимитыОблигации.ЦеннаяБумага,
		|	_ЛимитыОблигации.ISIN,
		|	_ЛимитыОблигации.IsGuaranteed,
		|	_ЛимитыОблигации.Guarantor,
		|	_ЛимитыОблигации.SellOnly
		|ИЗ
		|	_ЛимитыОблигации КАК _ЛимитыОблигации
		|ГДЕ
		|	НЕ _ЛимитыОблигации.ВыгрузкаРеализована
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.LimitType КАК LimitType,
		|	_Лимиты.InstrumentType КАК InstrumentType,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.LimitSizeInPercent КАК LimitSizeInPercent,
		|	_Лимиты.LimitSizeInQuantity КАК LimitSizeInQuantity,
		|	_Лимиты.LimitSizeInYears КАК LimitSizeInYears,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo,
		|	_Лимиты.IsGuaranteed КАК IsGuaranteed,
		|	_Лимиты.Guarantor КАК Guarantor,
		|	_Лимиты.Contracts КАК Contracts
		|ПОМЕСТИТЬ _ПрочиеЛимиты
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	(_Лимиты.LimitType = ""На объем вложений""
		|				И _Лимиты.LimitSizeInCash = 0
		|			ИЛИ НЕ _Лимиты.LimitType В (""На объем вложений"", ""На группу""))";
			
	#КонецОбласти 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = Запрос.Выполнить();
	
	ГруппыДоговоров = Новый Массив;
	
	Для каждого Строка Из СводнаяТаблица Цикл
	
		Если ГруппыДоговоров.Найти(Строка.Contracts) = Неопределено Тогда
			
			// заполняем массив уникальными договорами, отсортированными в порядке убывания длины строки. При равенстве длин строк сортируем в порядке возрастания строковых значений
			
			КоличествоДоговоров = ГруппыДоговоров.Количество();
			
			Если КоличествоДоговоров = 0 Тогда
				Индекс = 0;
			Иначе
				
				Для Индекс = 0 По КоличествоДоговоров-1 Цикл
			
					ДлинаНов = СтрДлина(Строка.Contracts);
				    ДлинаТек = СтрДлина(ГруппыДоговоров[Индекс]);
					
					Если ДлинаТек < ДлинаНов Или (ДлинаНов = ДлинаТек И ГруппыДоговоров[Индекс] > Строка.Contracts) Тогда
						Прервать;
					КонецЕсли; 
				
				КонецЦикла; 
			
			КонецЕсли; 
			
			ГруппыДоговоров.Вставить(Индекс, Строка.Contracts);
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Макет = ПолучитьМакет("ОтчетПоВыгрузкеВЕГАР");
	ОбластьДоговоры = Макет.ПолучитьОбласть("Договоры");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Строка = Макет.ПолучитьОбласть("Строка");
	
	СводныйОтчет = Новый ТабличныйДокумент;
	
	КолонкиЗначений = Новый Структура;
	КолонкиЗначений.Вставить("ЛимитНаГруппу", 4);
	КолонкиЗначений.Вставить("ЛимитНаЭмитента", 5);
	КолонкиЗначений.Вставить("ДС", 6);
	КолонкиЗначений.Вставить("Брокер", 7);
	КолонкиЗначений.Вставить("РЕПО", 8);
	КолонкиЗначений.Вставить("Депозиты", 9);
	КолонкиЗначений.Вставить("Облигации", 10);
	КолонкиЗначений.Вставить("Акции", 11);
	
	Для Каждого Договоры Из ГруппыДоговоров Цикл
		
		ОбластьДоговоры.Параметры.Договоры = Договоры;
		СводныйОтчет.Вывести(ОбластьДоговоры);
		
		СводныйОтчет.НачатьГруппуСтрок();
		
		Отборы = СтрШаблон("Contracts = ""%1""", Договоры);
		
		ОсновныеЛимиты = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_ОсновнаяТаблица",,, Отборы).Выгрузить();
		ОсновныеЛимиты.Сортировать("ГруппаПорядок, Группа, ЮрФизЛицо");
		
		ЛимитыБезВыгрузки = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_ЛимитыБезВыгрузки",,, Отборы).Выгрузить();
		
		#Область Основная_таблица
		
		Если ОсновныеЛимиты.Количество() > 0 Тогда
			СводныйОтчет.Вывести(Шапка);
		КонецЕсли;
		
		Для Каждого СтрокаОсновныеЛимиты Из ОсновныеЛимиты Цикл
			
			Строка.Параметры.Заполнить(СтрокаОсновныеЛимиты);
			
			Для каждого Колонка Из КолонкиЗначений Цикл
			
				Область = Строка.Область(1, Колонка.Значение, 1, Колонка.Значение);
				Область.ЦветТекста = Новый Цвет;
				Область.Примечание.Текст = "";
				
			КонецЦикла; 
			
			МассивСообщений = Новый Массив;
			
			Если СтрокаОсновныеЛимиты.Акции_SellOnly Или СтрокаОсновныеЛимиты.Облигации_SellOnly Тогда
	    	
	    		Если (СтрокаОсновныеЛимиты.ДС + СтрокаОсновныеЛимиты.Брокер + СтрокаОсновныеЛимиты.РЕПО + СтрокаОсновныеЛимиты.Депозиты) = 0 И 
	    			Не (СтрокаОсновныеЛимиты.Акции > 0 И СтрокаОсновныеЛимиты.Облигации > 0 И СтрокаОсновныеЛимиты.Акции_SellOnly <> СтрокаОсновныеЛимиты.Облигации_SellOnly) Тогда
	    			// доступны операции продажи только для акций или только для облигаций или для акций и облигаций одновременно
	    			// при этом не заданы лимиты по другим видам активов
	    		 	МассивСообщений.Добавить("По эмитенту допустимы только операции, связанные с реализацией/погашением");
	 
	    		Иначе
	    			Если СтрокаОсновныеЛимиты.Акции_SellOnly Тогда
	    				МассивСообщений.Добавить("По акциям эмитента допустимы только операции, связанные с реализацией/погашением");
	    			Иначе
	    				МассивСообщений.Добавить("По облигациям эмитента допустимы только операции, связанные с реализацией/погашением");
	    			КонецЕсли;
	    		КонецЕсли; 
	    	
	    	КонецЕсли; 
			
			СтрокиБезВыгрузки = ЛимитыБезВыгрузки.НайтиСтроки(Новый Структура("IssuerID, Contracts", СтрокаОсновныеЛимиты.ИНН, СтрокаОсновныеЛимиты.Contracts));
			
			Для каждого СтрокаБезВыгрузки Из СтрокиБезВыгрузки Цикл
				
				Область = Строка.Область(1, КолонкиЗначений[СтрокаБезВыгрузки.ВидАктива], 1, КолонкиЗначений[СтрокаБезВыгрузки.ВидАктива]);
				ПредставлениеОшибки = "";
				
				РазмерЛимита = " до " + СтрокаБезВыгрузки.LimitSizeInCash + " млрд руб.";
				
				Если СтрокаБезВыгрузки.ВидАктива = "Депозиты" Тогда
					
					ПредставлениеОшибки = ПолучитьПредставлениеОшибкиПоСрокуДоПогашения(СтрокаБезВыгрузки.ВидАктива, СтрокаБезВыгрузки.MaturityFrom, СтрокаБезВыгрузки.MaturityTo) + РазмерЛимита;
					
				ИначеЕсли СтрокаБезВыгрузки.ВидАктива = "Акции" И ЗначениеЗаполнено(СтрокаБезВыгрузки.ISIN) Тогда
					
					ПредставлениеОшибки = "Акции " + СтрокаБезВыгрузки.ISIN + РазмерЛимита;
					
				ИначеЕсли СтрокаБезВыгрузки.ВидАктива = "Облигации" Тогда 
					
					ОшибкиОблигаций = Новый Массив;
					
					Если ЗначениеЗаполнено(СтрокаБезВыгрузки.ISIN) Тогда
					
						ОшибкиОблигаций.Добавить("Облигации " + СтрокаБезВыгрузки.ISIN + РазмерЛимита);
						
					КонецЕсли; 
					
					Если СтрокаБезВыгрузки.MaturityFrom + СтрокаБезВыгрузки.MaturityTo > 0 Тогда
					
						ОшибкиОблигаций.Добавить(ПолучитьПредставлениеОшибкиПоСрокуДоПогашения(СтрокаБезВыгрузки.ВидАктива, СтрокаБезВыгрузки.MaturityFrom, СтрокаБезВыгрузки.MaturityTo) + РазмерЛимита);
					
					КонецЕсли; 
					
					Если ТипЗнч(СтрокаБезВыгрузки.IsGuaranteed) = Тип("Булево") Тогда
					
						ОшибкиОблигаций.Добавить("Облигации " + ?(СтрокаБезВыгрузки.IsGuaranteed, "с гарантией ", "без гарантии ") + СтрокаБезВыгрузки.Guarantor + РазмерЛимита);
					
					КонецЕсли;
					
					ПредставлениеОшибки = СтрСоединить(ОшибкиОблигаций, Символы.ПС)
					
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(ПредставлениеОшибки) Тогда
				
					Если СтрокаОсновныеЛимиты[СтрокаБезВыгрузки.ВидАктива] = 0 Тогда
						Строка.Параметры[СтрокаБезВыгрузки.ВидАктива] = СтрокаБезВыгрузки.LimitSizeInCash;//"См. примечание";//СтрокаБезВыгрузки.LimitSizeInCash;
						Область.ЦветТекста = WebЦвета.Красный;
						Область.Примечание.Текст = Область.Примечание.Текст + ПредставлениеОшибки + Символы.ПС;
						Область.Примечание.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
					КонецЕсли; 
					
					МассивСообщений.Добавить(ПредставлениеОшибки);
				
				КонецЕсли; 
			
			КонецЦикла;
			
			Строка.Параметры.Примечание = СтрСоединить(МассивСообщений, Символы.ПС);
			
			СводныйОтчет.Вывести(Строка);
				
		КонецЦикла;
			
		#КонецОбласти  
		
		ПрочиеЛимиты = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_ПрочиеЛимиты",,, Отборы).Выгрузить();
		ПрочиеЛимиты.Сортировать("ЮрФизЛицо, LimitType, ЦеннаяБумага");
		
		ШапкаПрочиеЛимиты = Макет.ПолучитьОбласть("ШапкаПрочиеЛимиты");
		СтрокаПрочиеЛимиты = Макет.ПолучитьОбласть("СтрокаПрочиеЛимиты");
		ПустыеСтроки = Макет.ПолучитьОбласть("ПустыеСтроки");
		
		Если ПрочиеЛимиты.Количество() > 0 Тогда
			Если ОсновныеЛимиты.Количество() > 0 Тогда
				СводныйОтчет.Вывести(ПустыеСтроки);
			КонецЕсли; 
			СводныйОтчет.Вывести(ШапкаПрочиеЛимиты);
		КонецЕсли; 
		
		Для Каждого ТекСтрокаПрочиеЛимиты ИЗ ПрочиеЛимиты Цикл
			
			СтрокаПрочиеЛимиты.Параметры.Заполнить(ТекСтрокаПрочиеЛимиты);
			СводныйОтчет.Вывести(СтрокаПрочиеЛимиты);
				
		КонецЦикла;
		
		СводныйОтчет.ЗакончитьГруппуСтрок();
	
	КонецЦикла; 
	
	Возврат СводныйОтчет;

КонецФункции

Функция ПолучитьПредставлениеОшибкиПоСрокуДоПогашения(ВидАктива, MaturityFrom, MaturityTo)
	
	ФорматнаяСтрока = ";%1 года;;%1 лет;%1 лет ;%1 лет";
	
	ПредставлениеОшибки = "";
	
	Если ЗначениеЗаполнено(MaturityFrom) И ЗначениеЗаполнено(MaturityTo) Тогда
		ПредставлениеОшибки = СтрШаблон("%1 от %2 до ", ВидАктива, MaturityFrom) + СтрокаСЧислом(ФорматнаяСтрока, MaturityTo, ВидЧисловогоЗначения.Количественное, );
	ИначеЕсли ЗначениеЗаполнено(MaturityFrom) Тогда 
		ПредставлениеОшибки = СтрШаблон("%1 от ", ВидАктива) + СтрокаСЧислом(ФорматнаяСтрока, MaturityFrom, ВидЧисловогоЗначения.Количественное, );
	ИначеЕсли ЗначениеЗаполнено(MaturityTo) Тогда 
		ПредставлениеОшибки = СтрШаблон("%1 до ", ВидАктива) + СтрокаСЧислом(ФорматнаяСтрока, MaturityTo, ВидЧисловогоЗначения.Количественное, );
	КонецЕсли;
	
	Возврат ПредставлениеОшибки;
	
КонецФункции

#КонецОбласти 

#Область Работа_с_XDTO

Функция ПрочитатьФайл(РеквизитыФайла) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	ОбъектXDTO = ПолучитьОбъектXDTO(РеквизитыФайла, Ложь);
	Если ОбъектXDTO = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ДесериализоватьФайл(ОбъектXDTO);
	Возврат Данные;
	
КонецФункции

Функция ДесериализоватьФайл(ОбъектXDTO)
	
	Issuers 		= Новый Массив;
	IssuerLimits 	= Новый Массив;
	GroupLimits		= Новый Массив;
	
	ПолучитьДанныеИзXDTO(ОбъектXDTO, Issuers, 		"Issuers",     	"Record", Новый ФиксированнаяСтруктура("ID, Name"));
	ПолучитьДанныеИзXDTO(ОбъектXDTO, IssuerLimits, 	"IssuerLimits", "Record", Новый ФиксированнаяСтруктура("IssuerID, LimitType, LimitSizeInCash, InstrumentType, Contracts, SellOnly, MaturityTo, LimitSizeInQuantity, ISIN, MaturityFrom, IsGuaranteed, Guarantor, LimitSizeInYears, LimitSizeInPercent"));
	ПолучитьДанныеИзXDTO(ОбъектXDTO, GroupLimits, 	"GroupLimits",  "Record", Новый ФиксированнаяСтруктура("Name, LimitSizeInCash, GroupMember, Contracts"));
	
	ПараметрыЛВ = Новый Структура("AM, Date, PartnerINN");
	ЗаполнитьЗначенияСвойств(ПараметрыЛВ, ОбъектXDTO);
	
	Возврат Новый Структура("Issuers, IssuerLimits, GroupLimits, ПараметрыЛВ", Issuers, IssuerLimits, GroupLimits, ПараметрыЛВ); 
	
КонецФункции // ДесериализоватьКлассификаторы

Функция ПолучитьОбъектXDTO(РеквизитыФайла, Отказ)
	
#Область Схема

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	ЭтотОбъект.ПолучитьМакет("Схема").Записать(ИмяВременногоФайла);
	
	МассивСхемXSD = Новый Массив;
	МассивСхемXSD.Добавить(ИмяВременногоФайла);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(МассивСхемXSD);
	
#КонецОбласти	
	
	ПутьКФайлу	= ПолучитьИмяВременногоФайла("xml");
	
	Файл = РеквизитыФайла.ДвоичныеДанные;
	Файл.Записать(ПутьКФайлу);
	
	Файл = Новый ТекстовыйДокумент;
	Файл.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);
	Файл.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	
	Если Не ВалидацияXML(ПутьКФайлу, ИмяВременногоФайла, РеквизитыФайла.ИмяФайла) Тогда
	
		Возврат Неопределено;
	
	КонецЕсли; 
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
	
	ТипXDTO = НоваяФабрикаXDTO.Тип("LIMITS", "Data");  

	Попытка
		ОбъектXDTO = НоваяФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
	Исключение
		ЗарегистрироватьОшибку("Файл [" + РеквизитыФайла.ИмяФайла + "] не соответствует схеме XSD. Система сообщает: " + ОписаниеОшибки(), "Оповещения");
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Процедура ПолучитьДанныеИзXDTO(ОбъектXDTO, МассивДанных, ИмяОбъекта, ИмяСписка, СтруктураЭлементаДанных)
	
	СписокXDTO = ПолучитьСписокXDTOИзОбъекта(ОбъектXDTO, ИмяОбъекта, ИмяСписка);
	
	Если СписокXDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСпискаXDTO Из СписокXDTO Цикл
		
		Данные = Новый Структура(СтруктураЭлементаДанных);
		
		Если ИмяОбъекта = "GroupLimits" Тогда
			
			ЗаполнитьЗначенияСвойств(Данные, ЭлементСпискаXDTO,, "GroupMember");
			Данные.GroupMember = Новый СписокЗначений;
			GroupMember = ЭлементСпискаXDTO.GroupMember;
			
			Если ТипЗнч(GroupMember) = Тип("СписокXDTO") Тогда
				Для каждого Строка Из GroupMember Цикл
					Данные.GroupMember.Добавить(Строка.IssuerID);
				КонецЦикла; 
			Иначе
				Данные.GroupMember.Добавить(GroupMember.IssuerID);
			КонецЕсли; 

		Иначе
			ЗаполнитьЗначенияСвойств(Данные, ЭлементСпискаXDTO);
		КонецЕсли;
		МассивДанных.Добавить(Данные);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокXDTOИзОбъекта(ОбъектXDTO, ИмяОбъекта, ИмяСписка)
	
	Если ОбъектXDTO.Свойства().Получить(ИмяОбъекта) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектXDTO[ИмяОбъекта].Свойства().Получить(ИмяСписка) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СвойствоXDTO = ОбъектXDTO[ИмяОбъекта][ИмяСписка];
	ТипСвойстваXDTO = ТипЗнч(СвойствоXDTO);
	
	Если      ТипСвойстваXDTO = Тип("СписокXDTO") Тогда
		Возврат СвойствоXDTO;
	ИначеЕсли ТипСвойстваXDTO = Тип("ОбъектXDTO") Тогда
		СписокXDTO = Новый Массив;
		СписокXDTO.Добавить(СвойствоXDTO);
		Возврат СписокXDTO;
	Иначе
		ВызватьИсключение "Тип " + ТипСвойстваXDTO + " свойства XDTO не поддерживается"
	КонецЕсли;
	
КонецФункции

Функция ВалидацияXML(ПутьКФайлуXML, ПутьКФайлуСхемы, ИсходноеИмяФайла)
	
	Попытка
		КомОбъектКэшСхем = Новый COMОбъект("MSXML2.XMLSchemaCache.6.0");
	Исключение
		ЗарегистрироватьОшибку("Ошибка: Не удалось создать объект XMLSchemaCache" + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка 
		КомОбъектКэшСхем.add("LIMITS", ПутьКФайлуСхемы);
	Исключение
		ЗарегистрироватьОшибку("Ошибка: Не удалось подключить схему: " + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Попытка 
		КомОбъектДок = Новый COMОбъект("MSXML2.DOMDocument.6.0");
	Исключение
		ЗарегистрироватьОшибку("Ошибка: Не удалось создать объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	КомОбъектДок.schemas            = КомОбъектКэшСхем;
	КомОбъектДок.async              = Ложь;
	КомОбъектДок.validateOnParse	= Истина;
	КомОбъектДок.resolveExternals 	= Истина;
	КомОбъектДок.SetProperty("MultipleErrorMessages", Истина);
	
	Попытка
		КомОбъектДок.load(ПутьКФайлуXML);
	Исключение
		ЗарегистрироватьОшибку("XML файл [" + ИсходноеИмяФайла + "] не прошел проверку! Ошибка: Не удалось загрузить файл в объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Если КомОбъектДок.parseError.errorCode <> 0 Тогда 
				
		ТекстСообщения = "Файл импорта [" + ИсходноеИмяФайла + "] не соответствует схеме XSD."; 

		Для Каждого Ошибка из КомОбъектДок.parseError.AllErrors Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС + СокрЛП(Ошибка.errorXPath) + " Ошибка: " + СокрЛП(Ошибка.reason);
		КонецЦикла;
		
		ЗарегистрироватьОшибку(ТекстСообщения, "Оповещения");
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
