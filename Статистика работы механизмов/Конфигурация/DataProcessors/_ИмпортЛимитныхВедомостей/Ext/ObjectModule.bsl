#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Импорт лимитных ведомостей",
		"1.43",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортЛимитныхВедомостей", "Импорт лимитных ведомостей",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = "ИмпортЛимитныхВедомостей" Тогда
		// Параметры команды: Организация, ИмяКаталога
		ИмпортироватьЛимитныеВедомости(ПараметрыКоманды, ИдентификаторКоманды);
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки, Коллекция = "Ошибки")
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство(Коллекция) Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить(Коллекция, Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства[Коллекция].Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства[Коллекция].Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках() Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Оповещения") Тогда
	
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			СформироватьОповещение(ЭтотОбъект.ДополнительныеСвойства.Оповещения);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Оповещения, Символы.ПС));
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры // ОповеститьОбОшибках

Процедура СформироватьОповещение(Оповещения)

	Источник = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ЭтотОбъект.ДополнительныеСвойства.ИдентификаторКоманды;
	РеквизитыОповещения = Новый Структура("Организация, ТекстОшибки", ЭтотОбъект.Организация, СтрСоединить(Оповещения, Символы.ПС));
	Справочники.Оповещения.СформироватьОповещения("_ИмпортЛимитныхВедомостей.ОповеститьОбОшибках()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры

#КонецОбласти

#Область Автоматический_импорт_из_каталога

Процедура ИмпортироватьЛимитныеВедомости(ПараметрыКоманды, ИдентификаторКоманды)

	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтатистикаИмпорта = Новый Массив;
	СтатистикаИмпорта.Добавить("Загружены файлы: ");
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеСведения.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Ключ = ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости""";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДопСведение = Выборка.Ссылка;
	Иначе
		ЗарегистрироватьОшибку("Не найдено доп. сведение по ключу ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости"""); 
	КонецЕсли;
	
	ФайлыДляОбработки = РаботаСФайламиКлиентСервер.ПолучитьФайлыДляОбработкиИзКаталога(ПараметрыКоманды.ИмяКаталога, "*.xml", Ложь);
	
	Если ФайлыДляОбработки = Неопределено Тогда
		ЗарегистрироватьОшибку(СтрШаблон("Каталог [%1] не найден", ПараметрыКоманды.ИмяКаталога));
	КонецЕсли;
	
	ЗаполнитьРеквизитыФайлов(ФайлыДляОбработки);
	ФайлыДляПеремещения = Новый Массив;
	
	ТекстОшибки = Неопределено;
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		
		ПрочитатьФайлы(ФайлыДляОбработки, Истина);
		
		Для каждого СтрокаТаблицыФайлы Из ЭтотОбъект.СтруктураТаблиц.Файлы Цикл
			
			Если Не СтрокаТаблицыФайлы.СодержитОшибки Тогда
		
				Ссылка = СоздатьИНазначитьЛимитныеВедомости(СтрокаТаблицыФайлы, ДопСведение);
			
				Если ЗначениеЗаполнено(Ссылка) Тогда
					ФайлыДляПеремещения.Добавить(Новый Файл(СтрокаТаблицыФайлы.ПолноеИмяФайла));
					СтатистикаИмпорта.Добавить(СтрокаТаблицыФайлы.ПолноеИмяФайла);
				КонецЕсли;
				
			Иначе
				
				Ошибки = Новый Массив;
				
				Для каждого СтрокаОшибки Из СтруктураТаблиц.Ошибки Цикл
				
					Если СтрокаОшибки.ИмяФайла = СтрокаТаблицыФайлы.ИмяФайла Тогда
						
						Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Оповещения") 
							Или ЭтотОбъект.ДополнительныеСвойства.Оповещения.Найти(СтрокаОшибки.ОписаниеОшибки) = Неопределено Тогда
						
							Ошибки.Добавить(СтрокаОшибки.ОписаниеОшибки);
						
						КонецЕсли;						
						
					КонецЕсли;
				
				КонецЦикла;
				
				Если Ошибки.Количество() > 0 Тогда
				
					Ошибки.Вставить(0, СтрШаблон("При импорте файла [%1] обнаружены ошибки:", СтрокаТаблицыФайлы.ИмяФайла));
					ЗарегистрироватьОшибку(СтрСоединить(Ошибки, Символы.ПС), "Оповещения");
					
				КонецЕсли;				
				
			КонецЕсли;
		
		КонецЦикла;
		
	Иначе
		
		ТекстОшибки = СтрСоединить(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС);
		
	КонецЕсли;
	
	РаботаСФайламиКлиентСервер.ПеренестиОбработанныеФайлыВКаталог(ФайлыДляПеремещения);
		
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , СтрСоединить(СтатистикаИмпорта, Символы.ПС), ТекстОшибки);

КонецПроцедуры

Функция СоздатьИНазначитьЛимитныеВедомости(СтрокаТаблицыФайлы, ДопСведение) Экспорт

	Файл = Новый Файл(СтрокаТаблицыФайлы.ИмяФайла);
	
	НачатьТранзакцию();
	
	Если ЗначениеЗаполнено(СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации) Тогда
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.НазначениеИнвестиционнойДекларации");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации);
		
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ИнвестиционныеДекларации");
		ЭлементБлокировки.ИсточникДанных = СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации.ИнвестиционныеДекларации;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "ИнвестиционнаяДекларация");
		
		Блокировка.Заблокировать();
		
		Назначение = СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации.ПолучитьОбъект();
		Назначение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		
	КонецЕсли;
	
	МассивСтрокТаблицыГруппыДоговоровДляОчисткиСсылок = Новый Массив;
	
	Для каждого СтрокаТаблицыГруппыДоговоров Из СтрокаТаблицыФайлы.ГруппыДоговоров Цикл
	
		Если ЗначениеЗаполнено(СтрокаТаблицыФайлы.Базис) Тогда
			
			ЗначенияЗаполнения = ПолучитьДанныеЗаполненияИД(СтрокаТаблицыФайлы.ИмяФайла, СтрокаТаблицыГруппыДоговоров.Представление, СтрокаТаблицыГруппыДоговоров.СписокДоговоров, СтрокаТаблицыФайлы.Базис);
			
			Если ЗначениеЗаполнено(СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация) Тогда
				ИД = СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация.ПолучитьОбъект();
			Иначе
				ИД = Справочники.ИнвестиционныеДекларации.СоздатьЭлемент();
			КонецЕсли; 
			
			ИД.Заполнить(ЗначенияЗаполнения);
			Попытка
				ИД.Записать();
			Исключение
				ТекстОшибки = "Не удалось записать инвестиционную декларацию." + Символы.ПС + "Система сообщает: " + ОписаниеОшибки();
				ЗарегистрироватьОшибку(ТекстОшибки, "Оповещения");
				Возврат Неопределено;
			КонецПопытки;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация) Тогда
			
				СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация = ИД.Ссылка;
				МассивСтрокТаблицыГруппыДоговоровДляОчисткиСсылок.Добавить(СтрокаТаблицыГруппыДоговоров);
			
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДопСведение) Тогда
			
				Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
				Запись.Объект = ИД.Ссылка;
				Запись.Свойство = ДопСведение;
				Запись.Значение = Файл.Имя;
				Запись.Записать();
			
			КонецЕсли;
			
			Для каждого КЗ Из ЗначенияЗаполнения Цикл
			
				Если ТипЗнч(КЗ.Значение) = Тип("Строка") И ЭтоАдресВременногоХранилища(КЗ.Значение) Тогда
					УдалитьИзВременногоХранилища(КЗ.Значение);
				КонецЕсли; 
			
			КонецЦикла;
 
		КонецЕсли;
	
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации) Тогда
	    Назначение = СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации.ПолучитьОбъект();
		Назначение.ИнвестиционныеДекларации.Очистить();
	Иначе
		Назначение = Документы.НазначениеИнвестиционнойДекларации.СоздатьДокумент();
	КонецЕсли; 
	
	Назначение.Заполнить(Новый Структура);
	Назначение.Организация = ЭтотОбъект.Организация;
	Назначение.Дата = СтрокаТаблицыФайлы.Дата;
	Назначение.ТипИнвестиционнойДекларации = Перечисления.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость;
	Назначение.Субъект = СтрокаТаблицыФайлы.Клиент;
	Назначение.ВидДоговораДоверительногоУправления = СтрокаТаблицыФайлы.ВидДоговораДоверительногоУправления;
	
	Отказ = Ложь;
	
	Для каждого СтрокаТаблицыГруппыДоговоров Из СтрокаТаблицыФайлы.ГруппыДоговоров Цикл
	
		Если ЗначениеЗаполнено(СтрокаТаблицыФайлы.Базис) И ЗначениеЗаполнено(СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация) Тогда
		
			СтрокаИД = Назначение.ИнвестиционныеДекларации.Добавить();
			СтрокаИД.ИнвестиционнаяДекларация = СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация;
			
		Иначе
			
			Отказ = Истина;
			ТекстОшибки = "Не заполнен базис и/или инвестиционная декларация"; 
			ЗарегистрироватьОшибку(ТекстОшибки, "Оповещения");
		
		КонецЕсли; 
	
	КонецЦикла; 

	Если Не Отказ Тогда
	
		Попытка
		
			Назначение.Записать(РежимЗаписиДокумента.Проведение);
			
			Если ЗначениеЗаполнено(ДопСведение) Тогда
				
				Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
				Запись.Объект = Назначение.Ссылка;
				Запись.Свойство = ДопСведение;
				Запись.Значение = Файл.Имя;
				Запись.Записать();
			
			КонецЕсли; 
		
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			Отказ = Истина;
			
			Для каждого СтрокаТаблицыГруппыДоговоров Из МассивСтрокТаблицыГруппыДоговоровДляОчисткиСсылок Цикл
				СтрокаТаблицыГруппыДоговоров.ИнвестиционнаяДекларация = Неопределено;
			КонецЦикла; 
			
			ТекстОшибки = "Не удалось провести документ Назначение ИД. Система сообщает:" + Символы.ПС + ОписаниеОшибки(); 
			ЗарегистрироватьОшибку(ТекстОшибки, "Оповещения");
			
		КонецПопытки; 
		
		Если Не Отказ Тогда
		
			ЗагрузитьВерсиюВДокументооборот(Назначение.Ссылка, Файл, СтрокаТаблицыФайлы.АдресДвоичныхДанныхФайла);
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации) Тогда
				СтрокаТаблицыФайлы.НазначениеИнвестиционнойДекларации = Назначение.Ссылка;
			КонецЕсли; 
			
			Вложения = Новый Соответствие;
			Вложения.Вставить(СтрокаТаблицыФайлы.ИмяФайла, СтрокаТаблицыФайлы.АдресДвоичныхДанныхФайла);
			
			РеквизитыОповещения = Новый Структура("Организация, Клиент, ВидДоговора, Дата, Вложения",
				Назначение.Организация,
				Назначение.Субъект,
				Назначение.ВидДоговораДоверительногоУправления,
				Формат(Назначение.Дата, "ДФ=dd.MM.yyyy"),
				Вложения);
				
			Справочники.Оповещения.СформироватьОповещения("_ИмпортЛимитныхВедомостей.СоздатьИнвестиционныеДекларации()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
			Возврат Назначение.Ссылка;
			
		КонецЕсли; 
	
	Иначе
		
		ОтменитьТранзакцию();
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеЗаполненияИД(ИмяФайла, ГруппаДоговоров, СписокДоговоров, Базис, ИдентификаторФормы = Неопределено)

	ЗначенияЗаполнения = Новый Структура("ИмпортЛимитныхВедомостей");
	
	// реквизиты шапки
	ЗначенияЗаполнения.Вставить("Организация", ЭтотОбъект.Организация);
	ЗначенияЗаполнения.Вставить("ТипИнвестиционнойДекларации", Перечисления.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость);
	ЗначенияЗаполнения.Вставить("Комментарий", ГруппаДоговоров + ".");
	ЗначенияЗаполнения.Вставить("Наименование", ИмяФайла);
	ЗначенияЗаполнения.Вставить("Родитель", Справочники.ИнвестиционныеДекларации.ЛимитныеВедомости);
	
	// счета ДУ
	СчетаДУ = Новый ТаблицаЗначений;
	СчетаДУ.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	Для каждого ЭлСписка Из СписокДоговоров Цикл
		Строка = СчетаДУ.Добавить();
		Строка.СчетДоверительногоУправления = ЭлСписка.Значение;
	КонецЦикла; 
	ЗначенияЗаполнения.Вставить("СчетаДоверительногоУправления", ПоместитьВоВременноеХранилище(СчетаДУ, ИдентификаторФормы));
	
	// группы эмитентов и показатели для групп
	ТаблицаГрупп = ПолучитьТаблицуЗначенийИзМетаданных("ГруппыЭмитентов");
	ТаблицаЭмитентов = ПолучитьТаблицуЗначенийИзМетаданных("Эмитенты");
	ТаблицаПоказателей = ПолучитьТаблицуЗначенийИзМетаданных("Показатели");
		
	ЛимитыГрупп = СтруктураТаблиц.GroupLimits.НайтиСтроки(Новый Структура("ИмяФайла, Contracts", ИмяФайла, ГруппаДоговоров));
	
	Для каждого СтрокаЛимитаГрупп Из ЛимитыГрупп Цикл
	
		СтрокаГрупп = ТаблицаГрупп.Добавить();
		СтрокаГрупп.Имя = СтрокаЛимитаГрупп.Name;
		СтрокаГрупп.Идентификатор = Новый УникальныйИдентификатор;
		
		СоставГруппы = СтруктураТаблиц.ГруппыЭмитентов.НайтиСтроки(Новый Структура("ИмяФайла, ИмяГруппы, Contracts", ИмяФайла, СтрокаЛимитаГрупп.Name, ГруппаДоговоров));
		Для каждого СтрокаСоставГруппы Из СоставГруппы Цикл
		
			СтрокаЭмитентов = ТаблицаЭмитентов.Добавить();
			СтрокаЭмитентов.Группа = СтрокаГрупп.Идентификатор;
		    СтрокаЭмитентов.Эмитент = СтрокаСоставГруппы.ЮрФизЛицо;
		
		КонецЦикла; 
		
		СтрокаПоказателей = ТаблицаПоказателей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоказателей, СтрокаЛимитаГрупп);
		СтрокаПоказателей.ГруппаЭмитентов = СтрокаГрупп.Идентификатор;
		Строкапоказателей.НаборИнвестиционнойДекларации = ПолучитьНаборВсеАктивы();
		СтрокаПоказателей.Базис = Базис;
		СтрокаПоказателей.АбсолютнаяВеличинаМин = Истина;
		СтрокаПоказателей.АбсолютнаяВеличинаМакс = Истина;
		СтрокаПоказателей.МинимальноеЗначение = 0;
		СтрокаПоказателей.ВключаяФилиалы = Истина;
	
	КонецЦикла;
	
	ЗначенияЗаполнения.Вставить("ГруппыЭмитентов", ПоместитьВоВременноеХранилище(ТаблицаГрупп, ИдентификаторФормы));
	ЗначенияЗаполнения.Вставить("Эмитенты", ПоместитьВоВременноеХранилище(ТаблицаЭмитентов, ИдентификаторФормы));
	
	// показатели для эмитентов
	ЛимитыЭмитентов = СтруктураТаблиц.IssuerLimits.НайтиСтроки(Новый Структура("ИмяФайла, Contracts", ИмяФайла, ГруппаДоговоров));
	
	Для каждого СтрокаЛимитаЭмитента Из ЛимитыЭмитентов Цикл
		
		Если Не СтрокаЛимитаЭмитента.ЭтоДубльЛимита Тогда
		
			СтрокаПоказателей = ТаблицаПоказателей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПоказателей, СтрокаЛимитаЭмитента, , "ДатаЗапретаПокупки");
			СтрокаПоказателей.Базис = Базис;
			СтрокаПоказателей.АбсолютнаяВеличинаМин = Истина;
			СтрокаПоказателей.МинимальноеЗначение = 0;
			СтрокаПоказателей.Эмитент = СтрокаЛимитаЭмитента.ЮрФизЛицо;
			
			Если СтрокаЛимитаЭмитента.SellOnly Тогда
			
				СтрокаПоказателей = ТаблицаПоказателей.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПоказателей, СтрокаЛимитаЭмитента, , "МаксимальноеЗначение, КонтролируемыйПоказатель, ОпределяетСоставИСтруктуру");
				СтрокаПоказателей.КонтролируемыйПоказатель = "Количество";
				СтрокаПоказателей.Базис = Базис;
				СтрокаПоказателей.АбсолютнаяВеличинаМин = Истина;
				СтрокаПоказателей.АбсолютнаяВеличинаМакс = Ложь;
				СтрокаПоказателей.МинимальноеЗначение = 0;
				СтрокаПоказателей.МаксимальноеЗначение = 0;
				СтрокаПоказателей.Эмитент = СтрокаЛимитаЭмитента.ЮрФизЛицо;
			
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ЗначенияЗаполнения.Вставить("Показатели", ПоместитьВоВременноеХранилище(ТаблицаПоказателей, ИдентификаторФормы));
	
	Возврат ЗначенияЗаполнения;

КонецФункции

Процедура ЗагрузитьФайлВДокументооборот(ВладелецФайла, Файл, АдресДвоичныхДанныхФайла)

	МетаданныеВладельца = ВладелецФайла.Метаданные();
	
	ТипВладельца = МетаданныеВладельца.ПолноеИмя();
	
	Организация = ЭтотОбъект.Организация;
	
	ИдентификаторВладельца = Строка(ВладелецФайла.УникальныйИдентификатор());
	НаименованиеВладельца = Строка(ВладелецФайла);
	
	ПараметрыФайла = Новый Структура;

	ПараметрыФайла.Вставить("Адрес",					АдресДвоичныхДанныхФайла);
	ПараметрыФайла.Вставить("Имя",						Файл.ИмяБезРасширения);
	ПараметрыФайла.Вставить("Расширение",				Сред(Файл.Расширение, 2));
	ПараметрыФайла.Вставить("НаименованиеВладельца",	НаименованиеВладельца);
	ПараметрыФайла.Вставить("ИдентификаторВладельца",	ИдентификаторВладельца);
	ПараметрыФайла.Вставить("ТипВладельца",				ТипВладельца);

	Попытка
		ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, Организация);
		РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(ВладелецФайла);
		ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление файла", УровеньЖурналаРегистрации.Информация, МетаданныеВладельца, ВладелецФайла, "Добавлен файл: """ + Файл.Имя + """");
	Исключение
		ТекстОшибки = СтрШаблон("Не удалось сохранить данные файла %1 в файловом хранилище из-за ошибки:%2", 
			Файл.ПолноеИмя, 
			Символы.ПС + ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры 

Процедура ЗагрузитьВерсиюВДокументооборот(ВладелецФайла, Файл, АдресДвоичныхДанныхФайла)

	ДанныеФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(ВладелецФайла);
	
	Для каждого ДанныеФайла Из ДанныеФайлов Цикл
	
		Расширение = СтрЗаменить(Файл.Расширение, ".", "");
		
		Если ДанныеФайла.Наименование = Файл.ИмяБезРасширения И ДанныеФайла.Расширение = Расширение Тогда
		
			Попытка
				ИдентификаторВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(ДанныеФайла.ИдентификаторФайла, АдресДвоичныхДанныхФайла, Расширение);
				ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление версии", 
					УровеньЖурналаРегистрации.Информация, 
					ВладелецФайла.Метаданные(), 
					ВладелецФайла, 
					"Добавлена версия: """ + Файл.Имя + """");
			Исключение
				ТекстОшибки = СтрШаблон("Не удалось обновить файл %1 в файловом хранилище из-за ошибки:%2", 
					Файл.ПолноеИмя, 
					Символы.ПС + ОписаниеОшибки());
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецПопытки;
			
			Возврат;
		
		КонецЕсли; 
			
	КонецЦикла; 
	
	// подходящий файл не нашли, загрузим новый
	ЗагрузитьФайлВДокументооборот(ВладелецФайла, Файл, АдресДвоичныхДанныхФайла);

КонецПроцедуры 

Функция ПолучитьТаблицуЗначенийИзМетаданных(ИмяТаблицы)

	МД = Метаданные.Справочники.ИнвестиционныеДекларации.ТабличныеЧасти[ИмяТаблицы];
	Если Ложь Тогда
		МД = Метаданные.Справочники.ИнвестиционныеДекларации.ТабличныеЧасти.Показатели;
	КонецЕсли; 
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	Для каждого Реквизит Из МД.Реквизиты Цикл
		ТаблицаЗначений.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла; 	
	
	Возврат ТаблицаЗначений;

КонецФункции

Функция ПолучитьНаборВсеАктивы()

	ХешСуммаУсловийОтбора = Справочники.НаборыИнвестиционныхДеклараций.ПолучитьХэшСуммуУсловийОтбора(Новый НастройкиКомпоновкиДанных);
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборыИнвестиционныхДеклараций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НаборыИнвестиционныхДеклараций КАК НаборыИнвестиционныхДеклараций
		|ГДЕ
		|	НаборыИнвестиционныхДеклараций.ХешСуммаУсловийОтбора = &ХешСуммаУсловийОтбора";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ХешСуммаУсловийОтбора", ХешСуммаУсловийОтбора);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.Ссылка;
	
	КонецЕсли;	 

КонецФункции

#КонецОбласти

