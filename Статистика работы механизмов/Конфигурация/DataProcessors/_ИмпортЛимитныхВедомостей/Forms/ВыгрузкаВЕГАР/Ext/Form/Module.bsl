&НаСервереБезКонтекста
Функция СоздатьЛокальныйКэш(ОбъектыКодов)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	ВЫБОР
		|		КОГДА КодыВоВнешнихСистемахСрезПоследних.Объект ССЫЛКА Справочник.ЮрФизЛица
		|			ТОГДА ВЫРАЗИТЬ(КодыВоВнешнихСистемахСрезПоследних.Объект КАК Справочник.ЮрФизЛица).Наименование
		|		КОГДА КодыВоВнешнихСистемахСрезПоследних.Объект ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(КодыВоВнешнихСистемахСрезПоследних.Объект КАК Справочник.Акции).Эмитент.ЮрФизЛицо.Наименование
		|		КОГДА КодыВоВнешнихСистемахСрезПоследних.Объект ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(КодыВоВнешнихСистемахСрезПоследних.Объект КАК Справочник.Облигации).Эмитент.ЮрФизЛицо.Наименование
		|	КОНЕЦ КАК ИмяЭмитента
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			Объект В (&ОбъектыКодов)
		|				И ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)) КАК КодыВоВнешнихСистемахСрезПоследних";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОбъектыКодов", ОбъектыКодов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ЛокальныйКэш = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
	
		ЛокальныйКэш.Вставить(Выборка.Объект, Новый Структура("ИмяЭмитента, Код", Выборка.ИмяЭмитента, Выборка.Код));
	
	КонецЦикла;
	
	Возврат ЛокальныйКэш;

КонецФункции
 
