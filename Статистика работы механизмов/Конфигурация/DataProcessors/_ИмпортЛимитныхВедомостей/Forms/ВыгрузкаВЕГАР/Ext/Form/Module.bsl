
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") Тогда
		ЭтаФорма.Сервер = "АП55";
	Иначе
		ЭтаФорма.Сервер = "АП91";
	КонецЕсли;
	
	ПараметрыФормы = ПолучитьИзВременногоХранилища(Параметры.АдресПараметров);
	УдалитьИзВременногоХранилища(Параметры.АдресПараметров);
	
	ЭтаФорма.ИмяФайла = ПараметрыФормы.ИмяФайла;
	
	Для каждого ИсходнаяСтрока Из ПараметрыФормы.ЛимитыГрупп Цикл
		
		НоваяСтрока = Limits.Добавить();
		НоваяСтрока.LimitType = "На группу";
		НоваяСтрока.GroupName = ИсходнаяСтрока.Name;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока, "GroupMember, LimitSizeInCash");
	
	КонецЦикла; 
	
	ОбъектыКодов = Новый Массив;
	
	Для каждого ИсходнаяСтрока Из ПараметрыФормы.ЛимитыЭмитентов Цикл
	
		НоваяСтрока = Limits.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
		Если ЗначениеЗаполнено(ИсходнаяСтрока.ЮрФизЛицо) И ОбъектыКодов.Найти(ИсходнаяСтрока.ЮрФизЛицо) = Неопределено Тогда
			ОбъектыКодов.Добавить(ИсходнаяСтрока.ЮрФизЛицо);
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ИсходнаяСтрока.ЦеннаяБумага) И ОбъектыКодов.Найти(ИсходнаяСтрока.ЦеннаяБумага) = Неопределено Тогда
			ОбъектыКодов.Добавить(ИсходнаяСтрока.ЦеннаяБумага);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого СтрокаГруппы Из ПараметрыФормы.ГруппыЭмитентов Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.ГруппыЭмитентов.Добавить(), СтрокаГруппы);
	КонецЦикла; 
	
	ПараметрыКлиента = ПолучитьПараметрыКлиента(ПараметрыФормы.Организация, ПараметрыФормы.СписокДоговоров);
	
	Если ПараметрыКлиента <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыКлиента);
		
		ЗаполнитьЛимитыЕГАР();
		
		ЗаполнитьJSON(ОбъектыКодов);
		ОтключитьВыгрузкуСовокупныхЛимитовПоЭмитенту();
		ОтключитьВыгрузкуДублируемыхЛимитов();
		
		ЗаполнитьСводныйОтчет();
		ЗаполнитьОтчетПоОшибкам();
		
		ЗаполнитьОтличия();
		
	КонецЕсли;
	
	ЭтоПолноправныйПользователь = РаботаСПользователями.ЭтоПолноправныйПользователь();
	
	//Элементы.КомандаВыгрузитьВсе.Доступность = ЭтоПолноправныйПользователь;
	//Элементы.СтраницаДанные.Видимость = ЭтоПолноправныйПользователь;
	//Элементы.СтраницаJSON.Видимость = ЭтоПолноправныйПользователь;
	//Элементы.СтраницаЛимитыЕГАР.Видимость = ЭтоПолноправныйПользователь;
	
КонецПроцедуры

#Область Параметры_клиента

&НаСервереБезКонтекста 
Функция ПолучитьПараметрыКлиента(Организация, СписокДоговоров)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ЕСТЬNULL(КодыВоВнешнихСистемахСрезПоследних.Код, """") КАК Префикс,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА ""PN""
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|			ТОГДА ""PR""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Постфикс,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА ""ПН""
		|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
		|			ТОГДА ""ПР""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидДоговораДляНаименования
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокДоговоров)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.EGAR)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодыВоВнешнихСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&СписокДоговоров)";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СообщенияОбОшибках = Новый Массив;
	КатегорияКлиента = "";
	ИмяКлиента = "";
	СчетДУКатегории = Неопределено;
	СчетДУНаименования = Неопределено;
	
	ПараметрыПроверкиКлиента = ПолучитьПараметрыПроверкиКлиента();
		
	Пока Выборка.Следующий() Цикл
		
		Отказ = Ложь;
		
		#Область Проверка_реквизитов
		Для каждого ПараметрПроверки Из ПараметрыПроверкиКлиента Цикл
		
			Если Не ЗначениеЗаполнено(Выборка[ПараметрПроверки.ИмяПоля]) Тогда
				
				ТекстОшибки = СтрШаблон(ПараметрПроверки.ТекстОшибки, Выборка[ПараметрПроверки.ИмяПоляПодстановки]);
				ДобавитьСообщениеОбОшибке(СообщенияОбОшибках, ТекстОшибки, Отказ);
			
			КонецЕсли; 
		
		КонецЦикла;			
		#КонецОбласти  
		
		#Область Получение_категории
		Если ЗначениеЗаполнено(Выборка.Префикс) И ЗначениеЗаполнено(Выборка.Постфикс) Тогда
		
			Если КатегорияКлиента = "" Тогда
			
				КатегорияКлиента = Выборка.Префикс + "_" + Выборка.Постфикс;
				СчетДУКатегории = Выборка.СчетДоверительногоУправления;
				
			ИначеЕсли КатегорияКлиента <> Выборка.Префикс + "_" + Выборка.Постфикс Тогда 
				
				ТекстОшибки = СтрШаблон("В указанных договорах обнаружены различные категории: '%1' - '%2'", СчетДУКатегории, КатегорияКлиента);
				ДобавитьСообщениеОбОшибке(СообщенияОбОшибках, ТекстОшибки, Отказ);
				
				ТекстОшибки = СтрШаблон("В указанных договорах обнаружены различные категории: '%1' - '%2'", Выборка.СчетДоверительногоУправления, Выборка.Префикс + "_" + Выборка.Постфикс);
				ДобавитьСообщениеОбОшибке(СообщенияОбОшибках, ТекстОшибки, Отказ);
			
			КонецЕсли; 
			
		КонецЕсли;			
		#КонецОбласти  
		
		#Область Получение_наименования
		СокращенноеНаименование = СтрЗаменить(Выборка.СокращенноеНаименование, """", "");
		Если ЗначениеЗаполнено(СокращенноеНаименование) И ЗначениеЗаполнено(Выборка.ВидДоговораДляНаименования) Тогда
		
			Если ИмяКлиента = "" Тогда
			
				ИмяКлиента = СокращенноеНаименование + " " + Выборка.ВидДоговораДляНаименования;
				СчетДУНаименования = Выборка.СчетДоверительногоУправления;
				
			ИначеЕсли ИмяКлиента <> СокращенноеНаименование + " " + Выборка.ВидДоговораДляНаименования Тогда 
				
				ТекстОшибки = СтрШаблон("В указанных договорах обнаружены различные наименования: '%1' - '%2'", СчетДУНаименования, ИмяКлиента);
				ДобавитьСообщениеОбОшибке(СообщенияОбОшибках, ТекстОшибки, Отказ);
				
				ТекстОшибки = СтрШаблон("В указанных договорах обнаружены различные наименования: '%1' - '%2'", Выборка.СчетДоверительногоУправления, СокращенноеНаименование + " " + Выборка.ВидДоговораДляНаименования);
				ДобавитьСообщениеОбОшибке(СообщенияОбОшибках, ТекстОшибки, Отказ);
			
			КонецЕсли; 
			
		КонецЕсли;			
		#КонецОбласти 
		
	КонецЦикла;
	
	Если Отказ Тогда
		
		Для каждого ТекстОшибки Из СообщенияОбОшибках Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки); 
		КонецЦикла;
		
		Возврат Неопределено;		
		
	КонецЕсли; 
	
	ПараметрыКлиента = Новый Структура("КатегорияКлиента, ИмяКлиента", КатегорияКлиента, ИмяКлиента);
	
	Возврат ПараметрыКлиента;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыПроверкиКлиента()

	ПараметрыПроверкиКлиента = Новый Массив;
	ПараметрыПроверкиКлиента.Добавить(Новый Структура("ИмяПоля, ТекстОшибки, ИмяПоляПодстановки", 
		"Префикс", 
		"Не задан код юр. лица в EGAR для клиента '%1'", 
		"Клиент"));
	ПараметрыПроверкиКлиента.Добавить(Новый Структура("ИмяПоля, ТекстОшибки, ИмяПоляПодстановки", 
		"Постфикс", 
		"Не задан код для выгрузки вида догоовра '%1'", 
		"ВидДоговораДоверительногоУправления"));
	ПараметрыПроверкиКлиента.Добавить(Новый Структура("ИмяПоля, ТекстОшибки, ИмяПоляПодстановки", 
		"СокращенноеНаименование", 
		"Не удалось получить сокращенное наименование клиента '%1'", 
		"Клиент"));
	ПараметрыПроверкиКлиента.Добавить(Новый Структура("ИмяПоля, ТекстОшибки, ИмяПоляПодстановки", 
		"ВидДоговораДляНаименования", 
		"Не удалось получить представление вида договора '%1'", 
		"ВидДоговораДоверительногоУправления"));
	Возврат ПараметрыПроверкиКлиента;

КонецФункции
	
#КонецОбласти 

#Область Подготовка_данных_для_выгрузки

&НаСервере
Процедура ЗаполнитьJSON(ОбъектыКодов)

	ЛокальныйКэш = СоздатьЛокальныйКэш(ОбъектыКодов);
	
	КодыГруппЭмитентов = ПолучитьКодыГруппЭмитентов();
		
	ИдентификаторыФильтров = ПолучитьИдентификаторыФильтров(ЭтаФорма.Сервер);
	
	СтандартныеПараметры = Новый Структура;
	СтандартныеПараметры.Вставить("categoryId", КатегорияКлиента);
	СтандартныеПараметры.Вставить("kind", "R");
	СтандартныеПараметры.Вставить("startDate", Формат(ТекущаяДата(), "ДФ=""гггг-ММ-дд"""));
	СтандартныеПараметры.Вставить("required", Истина);
	СтандартныеПараметры.Вставить("enabled", Истина);
	СтандартныеПараметры.Вставить("recalculateOnTrade", Истина);
	СтандартныеПараметры.Вставить("recalculateOnBod", Истина);
	СтандартныеПараметры.Вставить("useParentRecalculationTimer", Истина);
	СтандартныеПараметры.Вставить("valueRestrictionType", "LE");
	
	ИдентификаторыТиповИнструментов = Новый Соответствие;
	ИдентификаторыТиповИнструментов.Вставить("акции", "EQT");
	ИдентификаторыТиповИнструментов.Вставить("облигации", "BND");
	ИдентификаторыТиповИнструментов.Вставить("банковский счет", "PACC");
	ИдентификаторыТиповИнструментов.Вставить("депозиты", "DEPO");
	ИдентификаторыТиповИнструментов.Вставить("брокерский счет", "BACC");
	ИдентификаторыТиповИнструментов.Вставить("репо", "REPO");
	
	ЮрФизЛицо_РЕГИОН_БК = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_РЕГИОН_БК");
			
	Для каждого Строка Из ЭтаФорма.Limits Цикл
		
		СтруктураJSON = Неопределено;
		
		Если Строка.LimitType = "На группу" Тогда
			
			ИдентификаторФильтра = Неопределено;
			КодГруппыЭмитентов = КодыГруппЭмитентов.Получить(Строка.GroupName);
			Если ЗначениеЗаполнено(КодГруппыЭмитентов) Тогда
				ИдентификаторФильтра = ИдентификаторыФильтров.Получить(КодГруппыЭмитентов);
			Иначе
				Строка.Комментарий = "Не удалось определить Extarnal ID группы " + Строка.GroupName;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ИдентификаторФильтра) Тогда
				
				ПараметрыЛимита = Новый Массив;
				ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
				ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Истина));
				
				ФильтрыЛимита = Новый Массив;
				ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторФильтра));
				
				СтруктураJSON = Новый Структура;
				СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + КодГруппыЭмитентов);
				СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Группа эмитентов - " + Строка.GroupName);
				СтруктураJSON.Вставить("type", "AVG");
				СтруктураJSON.Вставить("ownValue", Строка.LimitSizeInCash);
				СтруктураJSON.Вставить("valueCurrencyCode", 25);
				СтруктураJSON.Вставить("parameters", ПараметрыЛимита);
				СтруктураJSON.Вставить("filters", ФильтрыЛимита);
				
			Иначе
				
				Строка.Комментарий = "Не удалось определить ID фильтра по группе " + КодГруппыЭмитентов;
				ЗарегистрироватьОшибку("Фильтры", "Группа эмитентов", КодГруппыЭмитентов,,,, Строка.GroupName);
				
			КонецЕсли; 
		
		ИначеЕсли Строка.LimitType = "На количество" Тогда
			
			ДанныеИнструмента = ЛокальныйКэш.Получить(Строка.ЦеннаяБумага);
			
			Если Не ЗначениеЗаполнено(ДанныеИнструмента) Тогда
				Строка.Комментарий = "Не удалось получить данные инструмента";
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Строка.Комментарий) Тогда
				
				ПараметрыЛимита = Новый Массив;
				ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
				
				СтруктураJSON = Новый Структура;
				СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеИнструмента.Код);
				СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеИнструмента.ИмяЭмитента + " - " + Строка.ISIN);
				СтруктураJSON.Вставить("type", "AVP");
				СтруктураJSON.Вставить("ownValue", Строка.LimitSizeInQuantity);
				СтруктураJSON.Вставить("parameters", ПараметрыЛимита);
				
			КонецЕсли; 
		
		ИначеЕсли Строка.LimitType = "На дюрацию" Тогда
			
			ПараметрыЛимита = Новый Массив;
			ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
			ПараметрыЛимита.Добавить(Новый Структура("name, value", "useHTM", Истина));
			
			ФильтрыЛимита = Новый Массив;
			ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторыФильтров.Получить("NOT_EQT")));
			ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторыФильтров.Получить("NOT_REPO")));
				
			СтруктураJSON = Новый Структура;
			СтруктураJSON.Вставить("id", КатегорияКлиента + "-DUR");
			СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Дюрация портфеля");
			СтруктураJSON.Вставить("type", "DURg");
			СтруктураJSON.Вставить("ownValue", Строка.LimitSizeInYears);
			СтруктураJSON.Вставить("parameters", ПараметрыЛимита);
			СтруктураJSON.Вставить("filters", ФильтрыЛимита);
		
		ИначеЕсли Строка.LimitType = "На объем вложений" Тогда
			
			ДанныеЭмитента = ЛокальныйКэш.Получить(Строка.ЮрФизЛицо);
			ТипИнструмента = НРег(Строка.InstrumentType);
			
			МассивКомментариев = Новый Массив;
			Если Не (ЗначениеЗаполнено(ДанныеЭмитента) Или ТипИнструмента = "брокерский счет" Или ТипИнструмента = "репо") Тогда
				// для брокерского счета и РЕПО данные эмитента не нужны
				МассивКомментариев.Добавить("Не удалось получить данные эмитента");
			КонецЕсли;
			//Если Строка.SellOnly И НРег(Строка.InstrumentType) = "брокерский счет" Тогда
			//	МассивКомментариев.Добавить("Выгрузка ограничений вида 'По эмитенту допустимы только операции, связанные с реализацией/погашением' не поддерживается");
			//КонецЕсли;
			Если НРег(Строка.InstrumentType) = "брокерский счет" И Не Строка.ЮрФизЛицо = ЮрФизЛицо_РЕГИОН_БК Тогда
				МассивКомментариев.Добавить("Выгрузка ограничений по брокерскому счету поддерживается только для БК РЕГИОН");
			КонецЕсли; 
			//Если ЗначениеЗаполнено(Строка.IsGuaranteed) Тогда 
			//	МассивКомментариев.Добавить("Выгрузка ограничений на облигации с фильтрацией по гаранту не поддерживается");
			//КонецЕсли;
			
			Строка.Комментарий = СтрСоединить(МассивКомментариев, Символы.ПС);
			
			Если ПустаяСтрока(Строка.Комментарий) И ЗначениеЗаполнено(Строка.LimitSizeInCash) Тогда
				
				СтруктураJSON = Новый Структура;
				ПараметрыЛимита = Новый Массив;
				ФильтрыЛимита = Новый Массив;
				
				Фильтр = ИдентификаторыТиповИнструментов.Получить(ТипИнструмента);
				
				Если ЗначениеЗаполнено(Фильтр) Тогда
				
					Если ТипИнструмента = "облигации" Или ТипИнструмента = "депозиты" Тогда
						ДополнитьФильтрСрокамиДоПогашения(Фильтр, Строка);
					КонецЕсли; 
					
					ИдентификаторТипаИнструмента = ПолучитьИдентификаторФильтра(ИдентификаторыФильтров, Строка, Фильтр);
					
					Если ИдентификаторТипаИнструмента = Неопределено Тогда
						Представление = ТипИнструмента 
							+ ?(Строка.MaturityFrom > 0, " от " + Строка.MaturityFrom, "") 
							+ ?(Строка.MaturityTo > 0, " до " + Строка.MaturityTo, "")
							+ ?(Строка.MaturityFrom + Строка.MaturityTo > 0, " лет", "");
						ЗарегистрироватьОшибку("Фильтры", "Тип инструмента", Фильтр,,,, Представление);
						Продолжить;
					КонецЕсли; 
					
					ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторТипаИнструмента));
				
				КонецЕсли; 
				
				Если Не (ТипИнструмента = "брокерский счет" Или ТипИнструмента = "репо") Тогда
				
					ИдентификаторЭмитента = ПолучитьИдентификаторФильтра(ИдентификаторыФильтров, Строка);
					// !!!
					Если ИдентификаторЭмитента = Неопределено Тогда
						ЗарегистрироватьОшибку("Фильтры", "Эмитент", Строка.IssuerID,,,, Строка.ЮрФизЛицо);
						Продолжить;
					КонецЕсли; 
					
					ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторЭмитента));
								
				КонецЕсли; 
				
				Если НРег(Строка.InstrumentType) = "акции" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеЭмитента.Код + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеЭмитента.ИмяЭмитента + " - Акции");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Ложь));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "облигации" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеЭмитента.Код + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеЭмитента.ИмяЭмитента + " - Облигации");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Истина));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "" Тогда // совокупный
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеЭмитента.Код);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеЭмитента.ИмяЭмитента);
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Истина));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "банковский счет" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеЭмитента.Код + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеЭмитента.ИмяЭмитента + " - ДС");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Ложь));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "депозиты" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + ДанныеЭмитента.Код + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - Эмитент - " + ДанныеЭмитента.ИмяЭмитента + " - Депозиты");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 1));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Ложь));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "брокерский счет" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - ДС на брокере");
					СтруктураJSON.Вставить("type", "AV");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 0));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Ложь));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useMoneyFlows", Истина));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "priceType", "MK2"));
					
				ИначеЕсли НРег(Строка.InstrumentType) = "репо" Тогда
					
					СтруктураJSON.Вставить("id", КатегорияКлиента + "-" + Фильтр);
					СтруктураJSON.Вставить("name", ИмяКлиента + " - ЛВ - ЦБ по 1ой ноге РЕПО");
					
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "daysOffset", 0));
					ПараметрыЛимита.Добавить(Новый Структура("name, value", "useAccruedInterest", Истина));
					
				КонецЕсли; 
				
				Если Строка.SellOnly Тогда
					
					//ЗарегистрироватьОшибку("ЗапретПокупки", , СтруктураJSON.id, ДанныеЭмитента.ИмяЭмитента, , Строка.InstrumentType);
					
					СтруктураJSON.name = СтруктураJSON.name + " - Техн";
					
					ИдентификаторЛимита = ИдентификаторыФильтров.Получить("NO_ORDERS");
					Если ИдентификаторЛимита = Неопределено Тогда
						ЗарегистрироватьОшибку("Фильтры",, "NO_ORDERS", ДанныеЭмитента.ИмяЭмитента,, Строка.InstrumentType, Строка.ЮрФизЛицо);
					Иначе
						ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторЛимита));
					КонецЕсли; 
					
				КонецЕсли; 
				
				Если Не СтруктураJSON.Свойство("type") Тогда
				
					СтруктураJSON.Вставить("type", "AVG");
				
				КонецЕсли; 
				
				СтруктураJSON.Вставить("ownValue", Строка.LimitSizeInCash);
				СтруктураJSON.Вставить("valueCurrencyCode", 25);
				СтруктураJSON.Вставить("parameters", ПараметрыЛимита);
				СтруктураJSON.Вставить("filters", ФильтрыЛимита);
				
				Если ЗначениеЗаполнено(Строка.IsGuaranteed) Тогда 
					
					Если Строка.IsGuaranteed Тогда
						Идентификатор = "WITH_GUARANT";
						Описание = "При наличии гарантии";
					Иначе
						Идентификатор = "NO_GUARANT";
						Описание = "Без гарантии";
					КонецЕсли; 
					
					Описание = Описание + " размер лимита " + Строка.LimitSizeInCash;
					
					ИдентификаторЛимита = ИдентификаторыФильтров.Получить(Идентификатор);
					Если ИдентификаторЛимита = Неопределено Тогда
						ЗарегистрироватьОшибку("Гарант",, Идентификатор, ДанныеЭмитента.ИмяЭмитента, Строка.Guarantor,, Описание);
					Иначе
						ФильтрыЛимита.Добавить(Новый Структура("id", ИдентификаторЛимита));
					КонецЕсли;
					
					СтруктураJSON.name = СтруктураJSON.name + "-" + Идентификатор;
					
				КонецЕсли;
				
			ИначеЕсли ПустаяСтрока(Строка.Комментарий) И ЗначениеЗаполнено(Строка.LimitSizeInPercent) Тогда 
				
				Идентификатор = КатегорияКлиента + "-" + ДанныеЭмитента.Код + "-" + Фильтр;
				ЗарегистрироватьОшибку("Проценты", , Идентификатор, ДанныеЭмитента.ИмяЭмитента, , Строка.InstrumentType);
				
			КонецЕсли; 
			
		Иначе
			
			Строка.Комментарий = СтрШаблон("Выгрузка лимитов с типом '%1' не поддерживается", Строка.LimitType);
			
		КонецЕсли; 
		
		Если ТипЗнч(СтруктураJSON) = Тип("Структура") И СтруктураJSON.Количество() > 0 Тогда
		
			// добавим стандартные параметры
			Для каждого СтандартныйПараметр Из СтандартныеПараметры Цикл
				СтруктураJSON.Вставить(СтандартныйПараметр.Ключ, СтандартныйПараметр.Значение);
			КонецЦикла; 			
			
			Строка.JSON = СтруктураJSON;
			ЗаполнитьЗначенияСвойств(Строка, СтруктураJSON, "id, name, ownvalue"); 
			
			Строка.СтрокаJSON = ПолучитьСтрокуJSON(СтруктураJSON);
			Строка.Выгружать = ПустаяСтрока(Строка.Комментарий);
			Строка.PARAMETERS = Новый Структура;
			
			Если СтруктураJSON.Свойство("parameters") Тогда
				Для каждого Параметр Из СтруктураJSON.parameters Цикл
					Строка.PARAMETERS.Вставить(Параметр.name, Параметр.value);
				КонецЦикла; 
			КонецЕсли; 
			Если СтруктураJSON.Свойство("filters") Тогда
				Для каждого Фильтр Из СтруктураJSON.filters Цикл
					Строка.FILTERS.Добавить(Фильтр.id);
				КонецЦикла; 
			КонецЕсли; 
			
			АктуальныеЛимиты = ЭтаФорма.ЛимитыЕгар.НайтиСтроки(Новый Структура("EXTERNAL_ID", Строка.ID));
			Если АктуальныеЛимиты.Количество() = 1 Тогда
			    // проверим расхождения
				
				ЛимитЕГАР = АктуальныеЛимиты[0];
				ЛимитЕГАР.Удалить = Ложь;
				
				ЕстьРасхождения = (СтруктураJSON.Name <> ЛимитЕГАР.Name) Или (СтруктураJSON.OwnValue <> ЛимитЕГАР.OwnValue)
					Или Не РаботаСКоллекциями.СтруктурыИдентичны(Строка.PARAMETERS, ЛимитЕГАР.PARAMETERS)
					Или Не РаботаСКоллекциями.СпискиЗначенийИдентичны(Строка.FILTERS, ЛимитЕГАР.FILTERS);
				
				Если Не ЕстьРасхождения Тогда
					Строка.Выгружать = Ложь;
					Строка.Комментарий = "Лимит не изменился";
				КонецЕсли; 
			
			КонецЕсли; 
			
		КонецЕсли; 

	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьВыгрузкуСовокупныхЛимитовПоЭмитенту()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ЭтаФорма.Limits.Выгрузить());
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаЛимитов.ID КАК ID,
		|	ТаблицаЛимитов.IssuerID КАК IssuerID,
		|	ТаблицаЛимитов.LimitType КАК LimitType,
		|	ТаблицаЛимитов.InstrumentType КАК InstrumentType
		|ПОМЕСТИТЬ _Лимиты
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		//|ГДЕ
		//|	ТаблицаЛимитов.Выгружать
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Лимиты.ID) КАК ID,
		|	ВложенныйЗапрос.IssuerID КАК IssuerID
		|ПОМЕСТИТЬ _ЛимитыКУдалению
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_Лимиты.IssuerID КАК IssuerID
		|	ИЗ
		|		_Лимиты КАК _Лимиты
		|	ГДЕ
		|		_Лимиты.LimitType = ""На объем вложений""
		|		И _Лимиты.InstrumentType = """") КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Лимиты КАК _Лимиты
		|		ПО ВложенныйЗапрос.IssuerID = _Лимиты.IssuerID
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.IssuerID
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Лимиты.ID) = 2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.ID КАК ID
		|ИЗ
		|	_ЛимитыКУдалению КАК _ЛимитыКУдалению
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Лимиты КАК _Лимиты
		|		ПО _ЛимитыКУдалению.IssuerID = _Лимиты.IssuerID
		|			И (_Лимиты.LimitType = ""На объем вложений"")
		|			И (_Лимиты.InstrumentType = """")";		
	#КонецОбласти 
	Идентификаторы = Запрос.Выполнить().Выгрузить(); 
	
	Для каждого Строка Из ЭтаФорма.Limits Цикл
	
		Если Идентификаторы.Найти(Строка.ID) <> Неопределено Тогда
			
			Строка.Выгружать = Ложь;
			
			НайденныеСтроки = ЭтаФорма.ЛимитыЕгар.НайтиСтроки(Новый Структура("EXTERNAL_ID", Строка.ID));
			Для каждого СтрокаЛимитыЕГАР Из НайденныеСтроки Цикл
				СтрокаЛимитыЕГАР.Удалить = Истина;
			КонецЦикла;  			
			
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ОтключитьВыгрузкуДублируемыхЛимитов()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ЭтаФорма.Limits.Выгрузить(Новый Структура("Выгружать", Истина)));
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаЛимитов.ID КАК ID
		|ПОМЕСТИТЬ _Лимиты
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.ID КАК ID,
		|	КОЛИЧЕСТВО(_Лимиты.ID) КАК КоличествоДублей
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|
		|СГРУППИРОВАТЬ ПО
		|	_Лимиты.ID
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(_Лимиты.ID) > 1";		
	#КонецОбласти 
	
	ДублиЛимитов = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из ДублиЛимитов Цикл
	
		СтрокиДублей = ЭтаФорма.Limits.НайтиСтроки(Новый Структура("ID", Строка.ID));
		
		СписокДоговоров = "";		
		
		Для каждого СтрокаДубль Из СтрокиДублей Цикл
			Если СтрДлина(СтрокаДубль.Contracts) > СтрДлина(СписокДоговоров) Тогда
				СписокДоговоров = СтрокаДубль.Contracts;
			КонецЕсли; 
		КонецЦикла; 
		
		Отметка = Ложь;
		
		Для каждого СтрокаДубль Из СтрокиДублей Цикл
			
			Если Не Отметка И СтрокаДубль.Contracts = СписокДоговоров Тогда
				Отметка = Истина;
			Иначе
				СтрокаДубль.Выгружать = Ложь;
				ЗарегистрироватьОшибку("Дубли", , СтрокаДубль.ID, СтрокаДубль.ЮрФизЛицо, , СтрокаДубль.InstrumentType, СтрокаДубль.Contracts);
			КонецЕсли; 
			
		КонецЦикла; 
	
	КонецЦикла; 

КонецПроцедуры 
	
