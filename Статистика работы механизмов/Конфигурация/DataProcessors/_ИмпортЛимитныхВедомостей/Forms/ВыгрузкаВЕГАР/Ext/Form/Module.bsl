#КонецОбласти 

&НаСервере
Процедура ЗаполнитьОтличия()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЛимитыЕгар.EXTERNAL_ID КАК ID,
		|	ЛимитыЕгар.NAME КАК Name,
		|	ЛимитыЕгар.OWNVALUE КАК OwnValue,
		|	ЛимитыЕгар.Удалить КАК Удалить
		|ПОМЕСТИТЬ _ЛимитыЕгар
		|ИЗ
		|	&ЛимитыЕгар КАК ЛимитыЕгар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Limits.ID КАК ID,
		|	Limits.Name КАК Name,
		|	Limits.OwnValue КАК OwnValue
		|ПОМЕСТИТЬ _Limits
		|ИЗ
		|	&Limits КАК Limits
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_Limits.ID, _ЛимитыЕгар.ID) КАК ID,
		|	_Limits.Name КАК НаименованиеНовое,
		|	_ЛимитыЕгар.Name КАК НаименованиеТекущее,
		|	_Limits.OwnValue КАК ЗначениеНовое,
		|	_ЛимитыЕгар.OwnValue КАК ЗначениеТекущее,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЛимитыЕгар.Удалить, ЛОЖЬ)
		|			ТОГДА ""Удалить""
		|		КОГДА _ЛимитыЕгар.ID ЕСТЬ NULL
		|			ТОГДА ""Добавить""
		|		КОГДА _Limits.ID ЕСТЬ НЕ NULL 
		|			ТОГДА ""Обновить""
		|	КОНЕЦ КАК Действие
		|ИЗ
		|	_ЛимитыЕгар КАК _ЛимитыЕгар
		|		ПОЛНОЕ СОЕДИНЕНИЕ _Limits КАК _Limits
		|		ПО _ЛимитыЕгар.ID = _Limits.ID
		|ГДЕ
		|	(_Limits.ID ЕСТЬ НЕ NULL 
		|			ИЛИ ЕСТЬNULL(_ЛимитыЕгар.Удалить, ЛОЖЬ))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Действие,
		|	НаименованиеНовое,
		|	НаименованиеТекущее";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЛимитыЕгар", ЭтаФорма.ЛимитыЕгар.Выгрузить(, "EXTERNAL_ID, NAME, OWNVALUE, Удалить"));
	Запрос.УстановитьПараметр("Limits", ЭтаФорма.Limits.Выгрузить(Новый Структура("Выгружать", Истина), "ID, Name, OwnValue"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетПоВыгрузкеВЕГАР");
	Шапка = Макет.ПолучитьОбласть("ШапкаОтличия");
	СтрокаОтличияДобавитьУдалить = Макет.ПолучитьОбласть("СтрокаОтличияДобавитьУдалить");
	СтрокаОтличияОбновить = Макет.ПолучитьОбласть("СтрокаОтличияОбновить");
	
	СводныйОтчет.Вывести(Шапка);
	
	Пока Выборка.Следующий() Цикл
	
		Если Выборка.Действие = "Обновить" Тогда
			Строка = СтрокаОтличияОбновить;
			Строка.Параметры.Заполнить(Выборка);
		Иначе
			Строка = СтрокаОтличияДобавитьУдалить;
			Строка.Параметры.Заполнить(Выборка);
			Если Выборка.Действие = "Добавить" Тогда
				Строка.Параметры.Лимит = "Новый";
				Строка.Параметры.Наименование = Выборка.НаименованиеНовое;
				Строка.Параметры.Значение = Выборка.ЗначениеНовое;
			Иначе
				Строка.Параметры.Лимит = "Текущий";
				Строка.Параметры.Наименование = Выборка.НаименованиеТекущее;
				Строка.Параметры.Значение = Выборка.ЗначениеТекущее;
			КонецЕсли; 
		КонецЕсли; 
		
		СводныйОтчет.Вывести(Строка);
	
	КонецЦикла;

КонецПроцедуры 

&НаКлиенте
Процедура КомандаВыгрузитьВсе(Команда)
	
	ВыгрузитьДанные(Сервер, ПолучитьТелоЗапросаУдаления(ЭтаФорма.ЛимитыЕгар), Истина);
	ВыгрузитьДанные(Сервер, ПолучитьТелоЗапроса(ЭтаФорма.Limits), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьВыделенные(Команда)
	ВыгрузитьДанные(Сервер, ПолучитьТелоЗапросаУдаления(Элементы.ЛимитыЕгар.ВыделенныеСтроки), Истина);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТелоЗапросаУдаления(Коллекция)

	ИскатьПоИдентификатору = Ложь;
	Если Коллекция.Количество() > 0 Тогда
		ИскатьПоИдентификатору = (ТипЗнч(Коллекция[0]) = Тип("Число"));
	КонецЕсли;
	
	МассивДляВыгрузки = Новый Массив;
	
	Для каждого ЭлементКоллекции Из Коллекция Цикл
		
		Если ИскатьПоИдентификатору Тогда
			ТекСтрока = ЭтаФорма.ЛимитыЕгар.НайтиПоИдентификатору(ЭлементКоллекции);
		Иначе
			ТекСтрока = ЭлементКоллекции;
		КонецЕсли;
		
		Если ТекСтрока.Удалить Тогда
			МассивДляВыгрузки.Добавить(Формат(ТекСтрока.EXTERNAL_ID, "ЧГ=0"));
		КонецЕсли; 
	
	КонецЦикла; 
	
	Возврат ПолучитьСтрокуJSON(МассивДляВыгрузки);

КонецФункции