&НаСервереБезКонтекста
Процедура ДополнитьФильтрСрокамиДоПогашения(Фильтр, Строка)

	Если (Строка.MaturityTo + Строка.MaturityFrom) > 0 Тогда
						
		Если Строка.MaturityFrom = 0 Тогда
			Фильтр = Фильтр + СтрШаблон("_UNDER%1Y", Строка.MaturityTo);
		ИначеЕсли Строка.MaturityTo = 0 Тогда 
			Фильтр = Фильтр + СтрШаблон("_OVER%1Y", Строка.MaturityFrom);
		Иначе
			Фильтр = Фильтр + СтрШаблон("_%1YTO%2Y", Строка.MaturityFrom, Строка.MaturityTo);
		КонецЕсли; 
		
	КонецЕсли;

