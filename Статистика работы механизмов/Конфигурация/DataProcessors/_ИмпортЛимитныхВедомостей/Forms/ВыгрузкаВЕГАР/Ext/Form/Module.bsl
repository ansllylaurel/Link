	Если ВнешнийИдентификатор = "" Тогда
		ИдентификаторФильтра = ИдентификаторыФильтров.Получить(Строка.IssuerID);
		Комментарий = "Не удалось определить ID фильтра по ИНН " + Строка.IssuerID;
	Иначе
		ИдентификаторФильтра = ИдентификаторыФильтров.Получить(ВнешнийИдентификатор);
		Комментарий = СтрШаблон("Не удалось определить ID фильтра '%1'", ВнешнийИдентификатор);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ИдентификаторФильтра) Тогда
	    Возврат ИдентификаторФильтра;
	Иначе
		Строка.Комментарий = Строка.Комментарий + ?(Строка.Комментарий = "", "", Символы.ПС) + Комментарий;
	КонецЕсли; 

