&НаСервере
Процедура ЗаполнитьЛимитыЕГАР()

	Соединение = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(ЭтаФорма.Сервер);
	
	ТекстЗапроса = СтрШаблон(
		"SELECT l.[ID]
		|,l.[EXTERNAL_ID]
		|,l.[NAME]
		|,l.[TYPE]
		|,l.[OWN_VALUE] AS OWNVALUE
		|,l.[PARAMETERS] AS PARAMETERS_STRING
		|FROM [LZ_LIMITS] l
		|INNER JOIN [LZ_LIMIT_CATEGORIES] lc 
		|  ON l.[CATEGORY_ID] = lc.[ID]
		|  AND lc.[EXTERNAL_ID] = '%1' AND l.[EXTERNAL_ID] IS NOT NULL
		|  AND l.IS_DELETED = 0", 
		ЭтаФорма.КатегорияКлиента);
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("ID",					Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный)));
	ТипыКолонок.Вставить("EXTERNAL_ID",			Новый ОписаниеТипов("Строка", 	Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("NAME",				Новый ОписаниеТипов("Строка", 	Новый КвалификаторыСтроки(100)));
	ТипыКолонок.Вставить("TYPE",				Новый ОписаниеТипов("Строка", 	Новый КвалификаторыСтроки(5)));
	ТипыКолонок.Вставить("OWNVALUE",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(21, 4)));
	ТипыКолонок.Вставить("PARAMETERS_STRING",	Новый ОписаниеТипов("Строка"));
	
	ДополнительныеПараметры = Новый Структура("ВозвращатьПустуюТаблицу", Истина);
	Попытка
		ТаблицаЛимитов = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(Соединение.СтрокаСоединенияSQL, ТекстЗапроса, ТипыКолонок,, ДополнительныеПараметры);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки; 
	
	ТаблицаЛимитов.Колонки.Добавить("FILTERS", 		Новый ОписаниеТипов("СписокЗначений"));
	ТаблицаЛимитов.Колонки.Добавить("PARAMETERS", 	Новый ОписаниеТипов("Структура"));
	ТаблицаЛимитов.Колонки.Добавить("Удалить", 		Новый ОписаниеТипов("Булево"));
	
	МассивИдентификаторов = ТаблицаЛимитов.ВыгрузитьКолонку("ID");
	
	Если МассивИдентификаторов.Количество() = 0 Тогда
		Идентификаторы = "''";
	Иначе
		Идентификаторы = "";
		Для каждого Идентификатор Из МассивИдентификаторов Цикл
			Идентификаторы = Идентификаторы + ", " + Формат(Идентификатор, "ЧГ=0");
		КонецЦикла;	
		Идентификаторы = Сред(Идентификаторы, 3);
	КонецЕсли; 
	
	ТекстЗапроса = СтрШаблон(
		"SELECT [LIMIT_ID]
		|,[FILTER_ID]
		|FROM [LZ_LIMIT_FILTERS] lf
		|  	WHERE [LIMIT_ID] in (%1)", 
		Идентификаторы);
		
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("LIMIT_ID",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный)));
	ТипыКолонок.Вставить("FILTER_ID",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный)));
	
	ТаблицаФильтров = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(Соединение.СтрокаСоединенияSQL, ТекстЗапроса, ТипыКолонок);
	
	Для каждого Строка Из ТаблицаЛимитов Цикл
		
		Строка.PARAMETERS = ПолучитьДанныеJSON(Строка.PARAMETERS_STRING);
		Если Строка.PARAMETERS.Свойство("daysOffset") Тогда
			Строка.PARAMETERS.daysOffset = Число(Строка.PARAMETERS.daysOffset);
		КонецЕсли; 
		Если Строка.PARAMETERS.Свойство("useAccruedInterest") Тогда
			Строка.PARAMETERS.useAccruedInterest = ?(НРег(Строка.PARAMETERS.useAccruedInterest) = "true", Истина, Ложь);
		КонецЕсли;
		
		ТекФильтры = ТаблицаФильтров.НайтиСтроки(Новый Структура("LIMIT_ID", Строка.ID));
		Для каждого СтрокаФильр Из ТекФильтры Цикл
			Строка.FILTERS.Добавить(СтрокаФильр.FILTER_ID);
		КонецЦикла; 
		
		Строка.Удалить = Истина;
		
	КонецЦикла;
	
	ЭтаФорма.ЛимитыЕгар.Загрузить(ТаблицаЛимитов);
	
КонецПроцедуры 

#Область Обмен_с_ЕГАР

&НаКлиенте
Процедура КомандаВыгрузитьВыделенные(Команда)
	
	ВыгрузитьДанные(Сервер, ПолучитьТелоЗапроса(Элементы.Limits.ВыделенныеСтроки), Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыгрузитьДанные(Сервер, СтрокаJSON, Удалить)

	Соединение = УстановитьСоединение(Сервер);
	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Удалить Тогда
		АдресРесурса = СтрЗаменить(Соединение.Limits, "&removeExistingFilters=true", "");
	Иначе
		АдресРесурса = Соединение.Limits;
	КонецЕсли; 
	ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Соединение.ЗаголовкиHTTP);
	ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	ВыполнитьЗапрос(ЗапросHTTP, Соединение, Удалить);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьЗапрос(ЗапросHTTP, Знач Соединение, Удалить)
	
	ЗапросВыполненУспешно = Ложь;
	ОписаниеОшибки = "";
	
	КоличествоПопытокОтправки = 1;
	
	Для НомерПопытки = 1 По КоличествоПопытокОтправки Цикл
		
		Попытка
			
			Если Удалить Тогда
				ОтветHTTP = Соединение.СоединениеHTTP.Удалить(ЗапросHTTP);
			Иначе
				ОтветHTTP = Соединение.СоединениеHTTP.Записать(ЗапросHTTP);
			КонецЕсли; 
			
			Если ОтветHTTP.КодСостояния = 200 Тогда
				ЗапросВыполненУспешно = Истина;
				Прервать;
			Иначе
				ОписаниеОшибки = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
				Если КоличествоПопытокОтправки > 1 Тогда
					ЗапуститьПриложение("Timeout /T 5 /NoBreak", , Истина);
				КонецЕсли; 
				
			КонецЕсли;
			
		Исключение
			
			Если НомерПопытки < КоличествоПопытокОтправки Тогда
				ЗапуститьПриложение("Timeout /T 5 /NoBreak", , Истина);
			КонецЕсли; 
			ОписаниеОшибки = ОписаниеОшибки();
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если Не ЗапросВыполненУспешно Тогда
		Сообщить("Ошибка подключения: " + ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьТелоЗапроса(Коллекция)

	ИскатьПоИдентификатору = Ложь;
	Если Коллекция.Количество() > 0 Тогда
		ИскатьПоИдентификатору = (ТипЗнч(Коллекция[0]) = Тип("Число"));
	КонецЕсли;
	
	МассивДляВыгрузки = Новый Массив;
	
	Для каждого ЭлементКоллекции Из Коллекция Цикл
		
		Если ИскатьПоИдентификатору Тогда
			ТекСтрока = ЭтаФорма.Limits.НайтиПоИдентификатору(ЭлементКоллекции);
		Иначе
			ТекСтрока = ЭлементКоллекции;
		КонецЕсли;
		
		Если ТекСтрока.Выгружать Тогда
			МассивДляВыгрузки.Добавить(ТекСтрока.JSON);
		КонецЕсли; 
	
	КонецЦикла; 
	
	Возврат ПолучитьСтрокуJSON(МассивДляВыгрузки);

КонецФункции

&НаСервереБезКонтекста
Функция УстановитьСоединение(Сервер)

	Соединение = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(Сервер);
			
	Если ТипЗнч(Соединение) = Тип("Строка") Тогда
		Сообщить("Ошибка подключения к серверу EGAR. Система сообщает:" + Символы.ПС + Соединение);
	Иначе
		Возврат Соединение;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура КомандаПолучитьJSON(Команда)
	ЭтаФорма.СтрокаJSON = ПолучитьТелоЗапроса(Элементы.Limits.ВыделенныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьСтроку(Команда)
	ВыгрузитьДанные(Сервер, ЭтаФорма.СтрокаJSON, Ложь);
КонецПроцедуры
 
#КонецОбласти 

#Область Отчет
	
&НаСервере
Процедура ЗаполнитьСводныйОтчет()

	ТаблицаГрупп = ЭтаФорма.ГруппыЭмитентов.Выгрузить();
	ТаблицаЛимитов = ЭтаФорма.Limits.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппыЭмитентов", ТаблицаГрупп);
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ТаблицаЛимитов);
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыЭмитентов.ИмяГруппы КАК ИмяГруппы,
		|	ГруппыЭмитентов.IssuerID КАК IssuerID,
		|	ГруппыЭмитентов.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _ГруппыЭмитентов
		|ИЗ
		|	&ГруппыЭмитентов КАК ГруппыЭмитентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаЛимитов.ID КАК ID,
		|	ТаблицаЛимитов.IssuerID КАК IssuerID,
		|	ТаблицаЛимитов.LimitType КАК LimitType,
		|	ТаблицаЛимитов.LimitSizeInCash / 1000000 КАК LimitSizeInCash,
		|	ТаблицаЛимитов.InstrumentType КАК InstrumentType,
		|	ТаблицаЛимитов.SellOnly КАК SellOnly,
		|	ТаблицаЛимитов.MaturityTo КАК MaturityTo,
		|	ТаблицаЛимитов.LimitSizeInQuantity КАК LimitSizeInQuantity,
		|	ТаблицаЛимитов.ISIN КАК ISIN,
		|	ТаблицаЛимитов.MaturityFrom КАК MaturityFrom,
		|	ТаблицаЛимитов.IsGuaranteed КАК IsGuaranteed,
		|	ТаблицаЛимитов.Guarantor КАК Guarantor,
		|	ТаблицаЛимитов.LimitSizeInYears КАК LimitSizeInYears,
		|	ТаблицаЛимитов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаЛимитов.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаЛимитов.LimitSizeInPercent КАК LimitSizeInPercent,
		|	ТаблицаЛимитов.Выгружать КАК Выгружать,
		|	ТаблицаЛимитов.GroupName КАК GroupName,
		|	ВЫРАЗИТЬ(ТаблицаЛимитов.Комментарий КАК СТРОКА(1024)) КАК Комментарий
		|ПОМЕСТИТЬ _Лимиты
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _ЛимитыДС
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""банковский счет""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _ЛимитыБрокер
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""брокерский счет""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _ЛимитыРЕПО
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""репо""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo
		|ПОМЕСТИТЬ _ЛимитыДепозиты
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""депозиты""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.IsGuaranteed КАК IsGuaranteed,
		|	_Лимиты.Guarantor КАК Guarantor,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.ISIN = """" КАК ВыгрузкаРеализована
		|ПОМЕСТИТЬ _ЛимитыОблигации
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""облигации""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.Комментарий КАК Комментарий,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.ISIN = """" КАК ВыгрузкаРеализована
		|ПОМЕСТИТЬ _ЛимитыАкции
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	_Лимиты.LimitType = ""На объем вложений""
		|	И _Лимиты.LimitSizeInCash <> 0
		|	И _Лимиты.InstrumentType = ""акции""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ЛимитыГрупп.GroupName, """") КАК Группа,
		|	_ЛимитыГрупп.GroupName ЕСТЬ NULL КАК ГруппаПорядок,
		|	ЕСТЬNULL(_ЛимитыГрупп.LimitSizeInCash, 0) КАК ЛимитНаГруппу,
		|	ЕСТЬNULL(_ЛимитыГрупп.Выгружать, ИСТИНА) КАК ЛимитНаГруппу_Выгружать,
		|	ЕСТЬNULL(_ЛимитыГрупп.Комментарий, """") КАК ЛимитНаГруппу_Комментарий,
		|	_ЛимитыСовокупные.IssuerID КАК ИНН,
		|	_ЛимитыСовокупные.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ЛимитыСовокупные.LimitSizeInCash КАК ЛимитНаЭмитента,
		|	_ЛимитыСовокупные.Выгружать КАК ЛимитНаЭмитента_Выгружать,
		|	_ЛимитыСовокупные.Комментарий КАК ЛимитНаЭмитента_Комментарий,
		|	ЕСТЬNULL(_ЛимитыДС.LimitSizeInCash, 0) КАК ДС,
		|	ЕСТЬNULL(_ЛимитыДС.Выгружать, ИСТИНА) КАК ДС_Выгружать,
		|	ЕСТЬNULL(_ЛимитыДС.Комментарий, """") КАК ДС_Комментарий,
		|	ЕСТЬNULL(_ЛимитыБрокер.LimitSizeInCash, 0) КАК Брокер,
		|	ЕСТЬNULL(_ЛимитыБрокер.Выгружать, ИСТИНА) КАК Брокер_Выгружать,
		|	ЕСТЬNULL(_ЛимитыБрокер.Комментарий, """") КАК Брокер_Комментарий,
		|	ЕСТЬNULL(_ЛимитыРЕПО.LimitSizeInCash, 0) КАК РЕПО,
		|	ЕСТЬNULL(_ЛимитыРЕПО.Выгружать, ИСТИНА) КАК РЕПО_Выгружать,
		|	ЕСТЬNULL(_ЛимитыРЕПО.Комментарий, """") КАК РЕПО_Комментарий,
		|	ЕСТЬNULL(_ЛимитыДепозиты.LimitSizeInCash, 0) КАК Депозиты,
		|	ЕСТЬNULL(_ЛимитыДепозиты.Выгружать, ИСТИНА) КАК Депозиты_Выгружать,
		|	ЕСТЬNULL(_ЛимитыДепозиты.Комментарий, """") КАК Депозиты_Комментарий,
		|	ЕСТЬNULL(_ЛимитыДепозиты.MaturityFrom, 0) КАК Депозиты_MaturityFrom,
		|	ЕСТЬNULL(_ЛимитыДепозиты.MaturityTo, 0) КАК Депозиты_MaturityTo,
		|	ЕСТЬNULL(_ЛимитыОблигации.LimitSizeInCash, 0) КАК Облигации,
		|	ЕСТЬNULL(_ЛимитыОблигации.Выгружать, ИСТИНА) КАК Облигации_Выгружать,
		|	ЕСТЬNULL(_ЛимитыОблигации.Комментарий, """") КАК Облигации_Комментарий,
		|	ЕСТЬNULL(_ЛимитыОблигации.SellOnly, ЛОЖЬ) КАК Облигации_SellOnly,
		|	ЕСТЬNULL(_ЛимитыОблигации.MaturityFrom, 0) КАК Облигации_MaturityFrom,
		|	ЕСТЬNULL(_ЛимитыОблигации.MaturityTo, 0) КАК Облигации_MaturityTo,
		|	ЕСТЬNULL(_ЛимитыОблигации.IsGuaranteed, НЕОПРЕДЕЛЕНО) КАК Облигации_IsGuaranteed,
		|	ЕСТЬNULL(_ЛимитыОблигации.Guarantor, """") КАК Облигации_Guarantor,
		|	ЕСТЬNULL(_ЛимитыАкции.LimitSizeInCash, 0) КАК Акции,
		|	ЕСТЬNULL(_ЛимитыАкции.Выгружать, ИСТИНА) КАК Акции_Выгружать,
		|	ЕСТЬNULL(_ЛимитыАкции.Комментарий, """") КАК Акции_Комментарий,
		|	ЕСТЬNULL(_ЛимитыАкции.SellOnly, ЛОЖЬ) КАК Акции_SellOnly
		|ИЗ
		|	_Лимиты КАК _ЛимитыСовокупные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГруппыЭмитентов КАК _ГруппыЭмитентов
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Лимиты КАК _ЛимитыГрупп
		|			ПО _ГруппыЭмитентов.ИмяГруппы = _ЛимитыГрупп.GroupName
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ГруппыЭмитентов.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыДС КАК _ЛимитыДС
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыДС.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыБрокер КАК _ЛимитыБрокер
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыБрокер.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыРЕПО КАК _ЛимитыРЕПО
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыРЕПО.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыДепозиты КАК _ЛимитыДепозиты
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыДепозиты.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыОблигации КАК _ЛимитыОблигации
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыОблигации.ЮрФизЛицо
		|			И (_ЛимитыОблигации.ВыгрузкаРеализована)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛимитыАкции КАК _ЛимитыАкции
		|		ПО _ЛимитыСовокупные.ЮрФизЛицо = _ЛимитыАкции.ЮрФизЛицо
		|			И (_ЛимитыАкции.ВыгрузкаРеализована)
		|ГДЕ
		|	_ЛимитыСовокупные.LimitType = ""На объем вложений""
		|	И _ЛимитыСовокупные.InstrumentType = """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГруппаПорядок,
		|	Группа,
		|	ЮрФизЛицо
		|АВТОУПОРЯДОЧИВАНИЕ";		
	#КонецОбласти 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = Запрос.Выполнить();
	
	#Область Текст_запроса_лимитов_без_выгрузки
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Акции"" КАК ВидАктива,
		|	_ЛимитыАкции.IssuerID КАК IssuerID,
		|	_ЛимитыАкции.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ЛимитыАкции.LimitSizeInCash КАК LimitSizeInCash,
		|	_ЛимитыАкции.Выгружать КАК Выгружать,
		|	_ЛимитыАкции.Комментарий КАК Комментарий,
		|	NULL КАК MaturityFrom,
		|	NULL КАК MaturityTo,
		|	_ЛимитыАкции.ВыгрузкаРеализована КАК ВыгрузкаРеализована,
		|	_ЛимитыАкции.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЛимитыАкции.ISIN КАК ISIN,
		|	NULL КАК IsGuaranteed,
		|	NULL КАК Guarantor,
		|	_ЛимитыАкции.SellOnly КАК SellOnly
		|ИЗ
		|	_ЛимитыАкции КАК _ЛимитыАкции
		|ГДЕ
		|	НЕ _ЛимитыАкции.ВыгрузкаРеализована
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Облигации"",
		|	_ЛимитыОблигации.IssuerID,
		|	_ЛимитыОблигации.ЮрФизЛицо,
		|	_ЛимитыОблигации.LimitSizeInCash,
		|	_ЛимитыОблигации.Выгружать,
		|	_ЛимитыОблигации.Комментарий,
		|	_ЛимитыОблигации.MaturityFrom,
		|	_ЛимитыОблигации.MaturityTo,
		|	_ЛимитыОблигации.ВыгрузкаРеализована,
		|	_ЛимитыОблигации.ЦеннаяБумага,
		|	_ЛимитыОблигации.ISIN,
		|	_ЛимитыОблигации.IsGuaranteed,
		|	_ЛимитыОблигации.Guarantor,
		|	_ЛимитыОблигации.SellOnly
		|ИЗ
		|	_ЛимитыОблигации КАК _ЛимитыОблигации
		|ГДЕ
		|	НЕ _ЛимитыОблигации.ВыгрузкаРеализована";		
	#КонецОбласти 
	
	ЛимитыБезВыгрузки = Запрос.Выполнить().Выгрузить();
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетПоВыгрузкеВЕГАР");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Строка = Макет.ПолучитьОбласть("Строка");
	
	ЭтаФорма.СводныйОтчет.Очистить();
	
	КолонкиЗначений = Новый Структура;
	КолонкиЗначений.Вставить("ЛимитНаГруппу", 4);
	КолонкиЗначений.Вставить("ЛимитНаЭмитента", 5);
	КолонкиЗначений.Вставить("ДС", 6);
	КолонкиЗначений.Вставить("Брокер", 7);
	КолонкиЗначений.Вставить("РЕПО", 8);
	КолонкиЗначений.Вставить("Депозиты", 9);
	КолонкиЗначений.Вставить("Облигации", 10);
	КолонкиЗначений.Вставить("Акции", 11);
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
	
		ЭтаФорма.СводныйОтчет.Вывести(Шапка);
		ЭтаФорма.СводныйОтчет.ФиксацияСверху = Шапка.ВысотаТаблицы;
	
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		Строка.Параметры.Заполнить(Выборка);
		
		Для каждого Колонка Из КолонкиЗначений Цикл
		
			Область = Строка.Область(1, Колонка.Значение, 1, Колонка.Значение);
			
			Если Выборка[Колонка.Ключ + "_Выгружать"] Тогда
			
				Область.ЦветТекста = Новый Цвет;
				Область.Примечание.Текст = "";
				
			Иначе
				
				Комментарий = СокрЛП(Выборка[Колонка.Ключ + "_Комментарий"]);
				
				Если Комментарий = "Лимит не изменился"  Тогда
					
					Область.ЦветТекста = WebЦвета.Зеленый;
					Область.Примечание.Текст = "";
					Область.Примечание.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
					
				Иначе
					
					Область.ЦветТекста = WebЦвета.Красный;
					Область.Примечание.Текст = Комментарий;
					Область.Примечание.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
				
				КонецЕсли; 
			
			КонецЕсли; 
			
		КонецЦикла; 
		
		МассивСообщений = Новый Массив;
		
		Если Выборка.Акции_SellOnly Или Выборка.Облигации_SellOnly Тогда
    	
    		Если (Выборка.ДС + Выборка.Брокер + Выборка.РЕПО + Выборка.Депозиты) = 0 И 
    			Не (Выборка.Акции > 0 И Выборка.Облигации > 0 И Выборка.Акции_SellOnly <> Выборка.Облигации_SellOnly) Тогда
    			// доступны операции продажи только для акций или только для облигаций или для акций и облигаций одновременно
    			// при этом не заданы лимиты по другим видам активов
    		 	МассивСообщений.Добавить("По эмитенту допустимы только операции, связанные с реализацией/погашением");
 
    		Иначе
    			Если Выборка.Акции_SellOnly Тогда
    				МассивСообщений.Добавить("По акциям эмитента допустимы только операции, связанные с реализацией/погашением");
    			Иначе
    				МассивСообщений.Добавить("По облигациям эмитента допустимы только операции, связанные с реализацией/погашением");
    			КонецЕсли;
    		КонецЕсли; 
    	
		КонецЕсли; 
		
		Если Выборка.Депозиты_MaturityFrom + Выборка.Депозиты_MaturityTo > 0 Тогда
			РазмерЛимита = " до " + Выборка.Депозиты + " млрд руб.";
			МассивСообщений.Добавить(ПолучитьПредставлениеОшибкиПоСрокуДоПогашения("Депозиты", Выборка.Депозиты_MaturityFrom, Выборка.Депозиты_MaturityTo) + РазмерЛимита);
		КонецЕсли; 
		
		Если Выборка.Облигации_MaturityFrom + Выборка.Облигации_MaturityTo > 0 Тогда
			РазмерЛимита = " до " + Выборка.Облигации + " млрд руб.";
			МассивСообщений.Добавить(ПолучитьПредставлениеОшибкиПоСрокуДоПогашения("Облигации", Выборка.Облигации_MaturityFrom, Выборка.Облигации_MaturityTo) + РазмерЛимита);
		КонецЕсли; 
		
		Если ТипЗнч(Выборка.Облигации_IsGuaranteed) = Тип("Булево") Тогда
			РазмерЛимита = " до " + Выборка.Облигации + " млрд руб.";
			МассивСообщений.Добавить("Облигации " + ?(Выборка.Облигации_IsGuaranteed, "с гарантией ", "без гарантии ") + Выборка.Облигации_Guarantor + РазмерЛимита);
		КонецЕсли;
		
		СтрокиБезВыгрузки = ЛимитыБезВыгрузки.НайтиСтроки(Новый Структура("IssuerID", Выборка.ИНН));
		
		Для каждого СтрокаБезВыгрузки Из СтрокиБезВыгрузки Цикл
			
			Область = Строка.Область(1, КолонкиЗначений[СтрокаБезВыгрузки.ВидАктива], 1, КолонкиЗначений[СтрокаБезВыгрузки.ВидАктива]);
			ПредставлениеОшибки = "";
			
			РазмерЛимита = " до " + СтрокаБезВыгрузки.LimitSizeInCash + " млрд руб.";
			
			Если СтрокаБезВыгрузки.ВидАктива = "Акции" И ЗначениеЗаполнено(СтрокаБезВыгрузки.ISIN) Тогда
				
				ПредставлениеОшибки = "Акции " + СтрокаБезВыгрузки.ISIN + РазмерЛимита;
				
			ИначеЕсли СтрокаБезВыгрузки.ВидАктива = "Облигации" Тогда 
				
				ПредставлениеОшибки = "Облигации " + СтрокаБезВыгрузки.ISIN + РазмерЛимита;
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ПредставлениеОшибки) Тогда
			
				Если Выборка[СтрокаБезВыгрузки.ВидАктива] = 0 Тогда
					Строка.Параметры[СтрокаБезВыгрузки.ВидАктива] = "См. примечание";//СтрокаБезВыгрузки.LimitSizeInCash;
					Область.ЦветТекста = WebЦвета.Красный;
					Область.Примечание.Текст = Область.Примечание.Текст + ПредставлениеОшибки + Символы.ПС;
					Область.Примечание.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
				КонецЕсли; 
				
				МассивСообщений.Добавить(ПредставлениеОшибки);
			
			КонецЕсли; 
		
		КонецЦикла; 
		
		Строка.Параметры.Примечание = СтрСоединить(МассивСообщений, Символы.ПС);
		
		ЭтаФорма.СводныйОтчет.Вывести(Строка);
			
	КонецЦикла; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Лимиты.Выгружать КАК Выгружать,
		|	_Лимиты.GroupName КАК GroupName,
		|	_Лимиты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_Лимиты.IssuerID КАК IssuerID,
		|	_Лимиты.LimitType КАК LimitType,
		|	_Лимиты.InstrumentType КАК InstrumentType,
		|	_Лимиты.ISIN КАК ISIN,
		|	_Лимиты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Лимиты.LimitSizeInCash КАК LimitSizeInCash,
		|	_Лимиты.LimitSizeInPercent КАК LimitSizeInPercent,
		|	_Лимиты.LimitSizeInQuantity КАК LimitSizeInQuantity,
		|	_Лимиты.LimitSizeInYears КАК LimitSizeInYears,
		|	_Лимиты.SellOnly КАК SellOnly,
		|	_Лимиты.MaturityFrom КАК MaturityFrom,
		|	_Лимиты.MaturityTo КАК MaturityTo,
		|	_Лимиты.IsGuaranteed КАК IsGuaranteed,
		|	_Лимиты.Guarantor КАК Guarantor,
		|	_Лимиты.Комментарий КАК Комментарий
		|ИЗ
		|	_Лимиты КАК _Лимиты
		|ГДЕ
		|	(_Лимиты.LimitType = ""На объем вложений""
		|				И _Лимиты.LimitSizeInCash = 0
		|			ИЛИ НЕ _Лимиты.LimitType В (""На объем вложений"", ""На группу""))";
	Результат = Запрос.Выполнить();
	
	ШапкаНевыгружаемые = Макет.ПолучитьОбласть("ШапкаНевыгружаемые");
	СтрокаНевыгружаемые = Макет.ПолучитьОбласть("СтрокаНевыгружаемые");
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		ЭтаФорма.СводныйОтчет.Вывести(ШапкаНевыгружаемые);
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаНевыгружаемые.Параметры.Заполнить(Выборка);
		ЭтаФорма.СводныйОтчет.Вывести(СтрокаНевыгружаемые);
			
	КонецЦикла 

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеОшибкиПоСрокуДоПогашения(ВидАктива, MaturityFrom, MaturityTo)
	
	ФорматнаяСтрока = ";%1 года;;%1 лет;%1 лет ;%1 лет";
	
	ПредставлениеОшибки = "";
	
	Если ЗначениеЗаполнено(MaturityFrom) И ЗначениеЗаполнено(MaturityTo) Тогда
		ПредставлениеОшибки = СтрШаблон("%1 от %2 до ", ВидАктива, MaturityFrom) + СтрокаСЧислом(ФорматнаяСтрока, MaturityTo, ВидЧисловогоЗначения.Количественное, );
	ИначеЕсли ЗначениеЗаполнено(MaturityFrom) Тогда 
		ПредставлениеОшибки = СтрШаблон("%1 от ", ВидАктива) + СтрокаСЧислом(ФорматнаяСтрока, MaturityFrom, ВидЧисловогоЗначения.Количественное, );
	ИначеЕсли ЗначениеЗаполнено(MaturityTo) Тогда 
		ПредставлениеОшибки = СтрШаблон("%1 до ", ВидАктива) + СтрокаСЧислом(ФорматнаяСтрока, MaturityTo, ВидЧисловогоЗначения.Количественное, );
	КонецЕсли;
	
	Возврат ПредставлениеОшибки;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОтчетПоОшибкам()

	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетПоВыгрузкеВЕГАР");
	Области = ПолучитьОбластиМакетаОшибок(Макет);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ошибки.КатегорияОшибки КАК КатегорияОшибки,
		|	Ошибки.Идентификатор КАК Идентификатор,
		|	Ошибки.ВидАктива КАК ВидАктива,
		|	Ошибки.Эмитент КАК Эмитент,
		|	Ошибки.Гарант КАК Гарант,
		|	Ошибки.Описание КАК Описание,
		|	Ошибки.ВидФильтра КАК ВидФильтра
		|ПОМЕСТИТЬ _Ошибки
		|ИЗ
		|	&Ошибки КАК Ошибки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Ошибки.КатегорияОшибки КАК КатегорияОшибки,
		|	_Ошибки.Идентификатор КАК Идентификатор,
		|	_Ошибки.ВидАктива КАК ВидАктива,
		|	_Ошибки.Эмитент КАК Эмитент,
		|	_Ошибки.Гарант КАК Гарант,
		|	_Ошибки.Описание КАК Описание,
		|	_Ошибки.ВидФильтра КАК ВидФильтра
		|ИЗ
		|	_Ошибки КАК _Ошибки
		|
		|УПОРЯДОЧИТЬ ПО
		|	КатегорияОшибки,
		|	ВидФильтра,
		|	Эмитент,
		|	ВидАктива,
		|	Идентификатор
		|ИТОГИ ПО
		|	КатегорияОшибки";
	
	Запрос.УстановитьПараметр("Ошибки", ЭтаФорма.Ошибки.Выгрузить());
	
	Результат = Запрос.Выполнить();
	ВыборкаКатегории = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКатегории.Следующий() Цикл
		
		ТекОбласти = Области[ВыборкаКатегории.КатегорияОшибки];
		ЭтаФорма.СводныйОтчет.Вывести(ТекОбласти.Шапка);
		
		Выборка = ВыборкаКатегории.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			ТекОбласти.Строка.Параметры.Заполнить(Выборка);
			ЭтаФорма.СводныйОтчет.Вывести(ТекОбласти.Строка);
		
		КонецЦикла; 
	
	КонецЦикла; 

КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьОбластиМакетаОшибок(Макет)

	КатегорииОшибок = СтрРазделить("Фильтры,ЗапретПокупки,Гарант,Проценты,Дубли", ",");
	
	Области = Новый Структура;
	
	Для каждого Категория Из КатегорииОшибок Цикл
		
		ТекОбласти = Новый Структура("Шапка, Строка", 
			Макет.ПолучитьОбласть("Шапка" + Категория),
			Макет.ПолучитьОбласть("Строка" + Категория));
		Области.Вставить(Категория, ТекОбласти);
			
	КонецЦикла; 
	
	Возврат Области;
	
КонецФункции 

#КонецОбласти 

