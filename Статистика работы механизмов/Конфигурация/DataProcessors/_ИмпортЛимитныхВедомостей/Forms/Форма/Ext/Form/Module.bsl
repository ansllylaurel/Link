
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеСведения.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Ключ = ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости""";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЭтаФорма.ДопСведение = Выборка.Ссылка;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено доп. сведение по ключу ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости"""); 
	КонецЕсли;
	
	Элементы.ДанныеИД.Видимость = Ложь;
	
	ЕстьПравоНаИзменениеИД = ПравоДоступа("Изменение", Метаданные.Справочники.ИнвестиционныеДекларации);
	Элементы.ФайлыКомандаСоздатьИНазначить.Доступность = ЕстьПравоНаИзменениеИД;
	
	Если РаботаСПользователями.ЭтоПолноправныйПользователь() Тогда
		Элементы.ДанныеИДКомандаВыгрузитьВЕГАР.Видимость = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Каталог) Тогда
		КомандаПрочитатьФайлы(Неопределено);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура КаталогПриИзменении(Элемент)
	КомандаПрочитатьФайлы(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	
	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;	
	
	ЭтаФорма.Каталог = ДиалогВыбора.Каталог;
	КомандаПрочитатьФайлы(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыПриАктивизацииСтроки(Элемент)
	
	СтрокаТаблицыФайлы = Элементы.Файлы.ТекущиеДанные;
	Если СтрокаТаблицыФайлы <> Неопределено Тогда
	
		Если СтрокаТаблицыФайлы.СодержитОшибки Тогда
			Элементы.ОшибкиФайла.Видимость = Истина;
			Элементы.ДанныеИД.Видимость = Ложь;
			ЗаполнитьТаблицуОшибокПоФайлу(СтрокаТаблицыФайлы.ИмяФайла);
		Иначе
			Элементы.ОшибкиФайла.Видимость = Ложь;
			Элементы.ДанныеИД.Видимость = Истина;			
		КонецЕсли; 		
	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ФайлыНазначениеИнвестиционнойДекларации" Тогда
		
		СтрокаТаблицыФайлов = ЭтаФорма.Файлы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		
		Если ЗначениеЗаполнено(СтрокаТаблицыФайлов.НазначениеИнвестиционнойДекларации) Тогда
			ОткрытьФорму("Документ.НазначениеИнвестиционнойДекларации.Форма.ФормаДокумента", Новый Структура("Ключ", СтрокаТаблицыФайлов.НазначениеИнвестиционнойДекларации));
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиФайлаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОшибкиФайлаДействие" Тогда
		
		ТекСтрока = ЭтаФорма.ОшибкиФайла.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ТекСтрока.Действие = "Создать набор" Тогда
			
			ЗначенияЗаполнения = Новый Структура("НаборДанных, ЭтоГруппа, Отбор", "Основной", Ложь, ТекСтрока.Отбор);
			ОткрытьФормуМодально("Справочник.НаборыИнвестиционныхДеклараций.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения));
			ЗаполнитьНаборыПоХэшСуммеНаСервере(ВыбраннаяСтрока);
			
		ИначеЕсли ТекСтрока.Действие = "Импортировать" Тогда
			
			ПараметрыИмпорта = Новый Структура;
			ПараметрыИмпорта.Вставить("ГруппаПравил",						"Матрих");
			ПараметрыИмпорта.Вставить("ГруппаОбъектов",						ТекСтрока.Группа);
			ПараметрыИмпорта.Вставить("ЗакрытьФормуПослеУспешногоИмпорта",	Истина);
			ПараметрыИмпорта.Вставить("ОбновитьПриОткрытии",				Истина);
			
			Форма = ПолучитьФорму("Обработка.ИмпортНормативноСправочнойИнформации.Форма", ПараметрыИмпорта);
			Форма.СтрокаПоиска = ТекСтрока.СтрокаПоиска;
			ОбработанныеОбъекты = Форма.ОткрытьМодально();
			
			Если ОбработанныеОбъекты <> Неопределено И ОбработанныеОбъекты.Количество() = 1 Тогда
				// обновим статусы ошибок
				СтрокиОшибок = ЭтаФорма.Ошибки.НайтиСтроки(Новый Структура("ОписаниеОшибки", ТекСтрока.ОписаниеОшибки));
				Для каждого Строка Из СтрокиОшибок Цикл
					ЭтаФорма.Ошибки.Удалить(Строка);
				КонецЦикла; 
				ЭтаФорма.ОшибкиФайла.Удалить(ТекСтрока);
			
			КонецЕсли; 
			
		КонецЕсли; 
		
		ОбновитьСтатусыОшибокФайлов();
		ФайлыПриАктивизацииСтроки(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаПрочитатьФайлы(Команда)
	
	ФайлыДляОбработки = РаботаСФайламиКлиентСервер.ПолучитьФайлыДляОбработкиИзКаталога(ЭтаФорма.Каталог, "*.xml", Ложь);
	
	Если ФайлыДляОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого РеквизитыФайла Из ФайлыДляОбработки Цикл
	
		Если РеквизитыФайла.Файл.Существует() Тогда
			РеквизитыФайла.Вставить("ИмяФайла", РеквизитыФайла.Файл.Имя);
			РеквизитыФайла.Вставить("ПолноеИмяФайла", РеквизитыФайла.Файл.ПолноеИмя);
			РеквизитыФайла.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(РеквизитыФайла.Файл.ПолноеИмя));
			РеквизитыФайла.Вставить("ДатаСоздания", РеквизитыФайла.Файл.ПолучитьВремяИзменения());
			РеквизитыФайла.Удалить("Файл");
		КонецЕсли;
	
	КонецЦикла;
	
	Если ФайлыДляОбработки.Количество() > 0 Тогда
	
		АдресДанных = ПоместитьВоВременноеХранилище(ФайлыДляОбработки, ЭтаФорма.УникальныйИдентификатор);
		КомандаПрочитатьФайлыНаСервере(АдресДанных);
		УдалитьИзВременногоХранилища(АдресДанных);
		
	Иначе 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В заданом каталоге нет файлов с лимитными ведомостями!",,, "Каталог"); 
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьИНазначить(Команда)
	
	Для каждого СтрокаТаблицыФайлы Из ЭтаФорма.Файлы Цикл
	
		Если СтрокаТаблицыФайлы.Загрузить И Не СтрокаТаблицыФайлы.СодержитОшибки Тогда
		
			Ссылка = СоздатьИНазначитьЛимитныеВедомости(СтрокаТаблицыФайлы.ПолучитьИдентификатор());
			
			Если ЗначениеЗаполнено(Ссылка) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведен документ " + Ссылка, Ссылка);
			КонецЕсли;			
		
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьВЕГАР(Команда)
	
	ДанныеФайла = Элементы.Файлы.ТекущиеДанные;
	ДанныеТекущейИД = Элементы.ДанныеИД.ТекущиеДанные;
	
	Если ДанныеФайла = Неопределено Или ДанныеТекущейИД = Неопределено Тогда
		Предупреждение("Сначала необходимо выделить файл и группу договоров для выгрузки");
	Иначе
		ПараметрыФормы = ПараметрыВыгрузкиВЕГАР(ДанныеФайла.ПолучитьИдентификатор(), ДанныеТекущейИД.Представление);
		ОткрытьФормуМодально("ВнешняяОбработка._ИмпортЛимитныхВедомостей.Форма.ВыгрузкаВЕГАР", Новый Структура("АдресПараметров", ПараметрыФормы));
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	ИзменитьФлажки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	ИзменитьФлажки(Ложь);
КонецПроцедуры

#КонецОбласти 

#Область Выгрузка_в_Excel

&НаКлиенте
Процедура КомандаВыгрузитьВExcel(Команда)
	
	ДатаАктуальностиДанных = ТекущаяДата();
	
	Если ВвестиДату(ДатаАктуальностиДанных, "Дата актуальности ЛВ", ЧастиДаты.Дата) Тогда
	
		Результат = ПодготовитьДанныеДляВыгрузкиВExcel(ДатаАктуальностиДанных);
		
		ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогСохраненияФайла.ПолноеИмяФайла     = Результат.Заголовок;
		ДиалогСохраненияФайла.Фильтр             = "Книга Excel 2007 (*.xlsx)|*.xlsx";
		ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
		
		Если ДиалогСохраненияФайла.Выбрать() Тогда
			Попытка
				Результат.Записать(ДиалогСохраненияФайла.ПолноеИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
			Исключение
				Предупреждение(ОписаниеОшибки());
			КонецПопытки; 
		КонецЕсли;		
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляВыгрузкиВExcel(ДатаАктуальностиДанных)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Отбор = Новый Структура("Организация", Объект.Организация);
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос, ДатаАктуальностиДанных, Отбор);
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнвестиционныеДекларацииСрезПоследних.НазначениеИнвестиционнойДекларации КАК НазначениеИнвестиционнойДекларации,
		|	ДокументНазначение.Дата КАК Дата
		|ПОМЕСТИТЬ _Назначения
		|ИЗ
		|	РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(
		|			&Период,
		|			(Организация, Субъект, ТипИнвестиционнойДекларации) В
		|				(ВЫБРАТЬ
		|					&Организация,
		|					ДействующиеСчетаДУ.Клиент,
		|					ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость)
		|				ИЗ
		|					ДействующиеСчетаДУ КАК ДействующиеСчетаДУ)) КАК ИнвестиционныеДекларацииСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеИнвестиционнойДекларации КАК ДокументНазначение
		|		ПО ИнвестиционныеДекларацииСрезПоследних.НазначениеИнвестиционнойДекларации = ДокументНазначение.Ссылка
		|ГДЕ
		|	ИнвестиционныеДекларацииСрезПоследних.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Назначения.НазначениеИнвестиционнойДекларации КАК Ссылка,
		|	_Назначения.Дата КАК ДатаСоздания,
		|	ЗначенияДополнительныхСведений.Значение КАК ИмяФайла
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка
		|			И (ДополнительныеСведения.Ключ = ""ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Назначения КАК _Назначения
		|		ПО ЗначенияДополнительныхСведений.Объект = _Назначения.НазначениеИнвестиционнойДекларации";		
	#КонецОбласти 
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", ДатаАктуальностиДанных);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ФайлыДляОбработки = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеФайла = ПолучитьДанныеФайлаИзДокументооборота(Выборка);
		Если ТипЗнч(ДанныеФайла) = Тип("Структура") Тогда
			ФайлыДляОбработки.Добавить(ДанныеФайла);
		КонецЕсли;		
		
	КонецЦикла;	 
	
	СтруктураТаблиц = ОбъектНаСервере.ПрочитатьФайлы(ФайлыДляОбработки, Ложь);
	Макет = ОбъектНаСервере.ПолучитьМакет("МакетExcel");
	
	Возврат ОбработатьДанные(СтруктураТаблиц, ДатаАктуальностиДанных, Макет);
			
КонецФункции

&НаСервереБезКонтекста
Функция ОбработатьДанные(СтруктураТаблиц, Период, Макет)

	ГруппыДоговоров = Новый ТаблицаЗначений;
	ГруппыДоговоров.Колонки.Добавить("ИмяФайла", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255)));
	ГруппыДоговоров.Колонки.Добавить("ДатаЛВ", 			Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ГруппыДоговоров.Колонки.Добавить("Клиент", 			Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ГруппыДоговоров.Колонки.Добавить("ВидДоговора", 	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	ГруппыДоговоров.Колонки.Добавить("ИмяГруппы", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ГруппыДоговоров.Колонки.Добавить("НомерДоговора", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(70)));
	ГруппыДоговоров.Колонки.Добавить("КодСчета", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ГруппыДоговоров.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	
	МассивФайлов = Новый Массив;
	
	Для каждого СтрокаФайл Из СтруктураТаблиц.Файлы Цикл
	
		Если Не СтрокаФайл.СодержитОшибки Тогда
			
			МассивФайлов.Добавить(СтрокаФайл.ИмяФайла);
			
			Для каждого СтрокаТаблицыГруппыДоговоровФайла Из СтрокаФайл.ГруппыДоговоров Цикл
			
				СписокДоговоров = СтрокаТаблицыГруппыДоговоровФайла.СписокДоговоров;
				
				Для каждого ЭлементСписка Из СписокДоговоров Цикл
				
					РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементСписка.Значение, "ВидДоговораДоверительногоУправления, КодСчета, НомерДоговора");
					
					СтрокаГруппыДоговоров = ГруппыДоговоров.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаГруппыДоговоров, СтрокаФайл);
					
					СтрокаГруппыДоговоров.ДатаЛВ = СтрокаФайл.Дата;
					СтрокаГруппыДоговоров.ИмяГруппы = СтрокаТаблицыГруппыДоговоровФайла.Представление;
					СтрокаГруппыДоговоров.ВидДоговора = РеквизитыДоговора.ВидДоговораДоверительногоУправления;
					СтрокаГруппыДоговоров.НомерДоговора = РеквизитыДоговора.НомерДоговора;
					СтрокаГруппыДоговоров.КодСчета = РеквизитыДоговора.КодСчета;
					СтрокаГруппыДоговоров.СчетДоверительногоУправления = ЭлементСписка.Значение;
				
				КонецЦикла; 
			
			КонецЦикла; 		
		КонецЕсли; 	
	КонецЦикла;
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.ИмяФайла КАК ИмяФайла,
