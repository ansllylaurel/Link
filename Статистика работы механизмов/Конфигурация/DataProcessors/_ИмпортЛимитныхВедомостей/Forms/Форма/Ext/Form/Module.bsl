		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ГруппыДоговоров КАК _ГруппыДоговоров
		|		ПО _ЛимитыНаЭмитентов.ИмяФайла = _ГруппыДоговоров.ИмяФайла
		|			И _ЛимитыНаЭмитентов.Договоры = _ГруппыДоговоров.Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыАктивов КАК _КодыАктивов
		|		ПО _ЛимитыНаЭмитентов.ЦеннаяБумага = _КодыАктивов.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЮрЛица КАК _ЮрЛица
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КодыЭмитентов КАК _КодыГарантов
		|			ПО _ЮрЛица.ЮрФизЛицо = _КодыГарантов.ЮрФизЛицо
		|		ПО _ЛимитыНаЭмитентов.Гарант = _ЮрЛица.ИНН
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыЭмитентов КАК _КодыЭмитентов
		|		ПО _ЛимитыНаЭмитентов.ЮрФизЛицо = _КодыЭмитентов.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГруппыЭмитентов КАК _ГруппыЭмитентов
		|		ПО _ЛимитыНаЭмитентов.ИмяФайла = _ГруппыЭмитентов.ИмяФайла
		|			И _ЛимитыНаЭмитентов.Договоры = _ГруппыЭмитентов.Договоры
		|			И _ЛимитыНаЭмитентов.ЮрФизЛицо = _ГруппыЭмитентов.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Файлы КАК _Файлы
		|		ПО _ЛимитыНаЭмитентов.ИмяФайла = _Файлы.ИмяФайла
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ГруппыДоговоров.Клиент,
		|	_ГруппыДоговоров.ВидДоговора,
		|	_ГруппыДоговоров.Договоры,
		|	_ГруппыДоговоров.ИмяФайла,
		|	""На объем вложений"",
		|	""Группа эмитентов"",
		|	_ЛимитыНаГруппы.ИмяГруппы,
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	_ЛимитыНаГруппы.ЛимитВРублях,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	ЛОЖЬ,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	_Файлы.Дата
		|ИЗ
		|	_ЛимитыНаГруппы КАК _ЛимитыНаГруппы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ГруппыДоговоров КАК _ГруппыДоговоров
		|		ПО _ЛимитыНаГруппы.ИмяФайла = _ГруппыДоговоров.ИмяФайла
		|			И _ЛимитыНаГруппы.Договоры = _ГруппыДоговоров.Договоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Файлы КАК _Файлы
		|		ПО _ЛимитыНаГруппы.ИмяФайла = _Файлы.ИмяФайла";		
	#КонецОбласти 

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	Запрос.УстановитьПараметр("Файлы", СтруктураТаблиц.Файлы);
	Запрос.УстановитьПараметр("ГруппыДоговоров", ГруппыДоговоров);
	Запрос.УстановитьПараметр("GroupLimits", СтруктураТаблиц.GroupLimits);
	Запрос.УстановитьПараметр("IssuerLimits", СтруктураТаблиц.IssuerLimits);
	Запрос.УстановитьПараметр("Issuers", СтруктураТаблиц.Issuers);
	Запрос.УстановитьПараметр("ГруппыЭмитентов", СтруктураТаблиц.ГруппыЭмитентов);
	
	Запрос.Выполнить();
	
	ТаблицыДляВывода = Новый Массив;
	ТаблицыДляВывода.Добавить(Новый Структура("ИмяТаблицы, Заголовок, Сортировка", "_ИтогЛимитыНаЭмитентов", "Лимиты", "ИмяФайла, Договоры, ТипЛимита, ТипИнструмента, Эмитент, ЦеннаяБумага Автоупорядочивание"));
	ТаблицыДляВывода.Добавить(Новый Структура("ИмяТаблицы, Заголовок, Сортировка", "_ГруппыДоговоров", "Договоры", "ИмяФайла, Договоры"));
	
	Пакет = Новый ПакетОтображаемыхДокументов; 
	Пакет.Заголовок = "Лимитные ведомости";
	
	Для каждого ТекТаблица Из ТаблицыДляВывода Цикл
	
		ТаблицаЗначений = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, ТекТаблица.ИмяТаблицы,,,, ТекТаблица.Сортировка).Выгрузить();
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка" + ТекТаблица.Заголовок);
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка" + ТекТаблица.Заголовок);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Для каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		КонецЦикла; 
		
		ЭлементСоставаПакета = Пакет.Состав.Добавить(ПоместитьВоВременноеХранилище(ТабличныйДокумент, Новый УникальныйИдентификатор));
		ЭлементСоставаПакета.Наименование = ТекТаблица.Заголовок;
		
	КонецЦикла; 
	
	Возврат Пакет;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьДанныеФайлаИзДокументооборота(ПараметрыФайла)

	СписокФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(ПараметрыФайла.Ссылка);
	
	Файл = Новый Файл(ПараметрыФайла.ИмяФайла);
	Расширение = СтрЗаменить(Файл.Расширение, ".", "");
			
	Для каждого ИнформацияОФайле Из СписокФайлов Цикл	
		
		Если ИнформацияОФайле.Наименование = Файл.ИмяБезРасширения И ИнформацияОФайле.Расширение = Расширение Тогда
		
			ДанныеФайла = РаботаСФайловымХранилищем.ПолучитьФайл(ИнформацияОФайле.ИдентификаторФайла);
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес);
			УдалитьИзВременногоХранилища(ДанныеФайла.Адрес);
			
			Возврат Новый Структура("ДвоичныеДанные, ИмяФайла, ПолноеИмяФайла, ДатаСоздания", ДвоичныеДанные, ПараметрыФайла.ИмяФайла, ПараметрыФайла.ИмяФайла, ПараметрыФайла.ДатаСоздания);
		
		КонецЕсли; 
			
	КонецЦикла;

КонецФункции 

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура КомандаПрочитатьФайлыНаСервере(АдресДанных)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ФайлыДляОбработки = ПолучитьИзВременногоХранилища(АдресДанных);
	
	Для каждого СтрокаТаблицыФайлы Из ЭтаФорма.Файлы Цикл
		Если ЭтоАдресВременногоХранилища(СтрокаТаблицыФайлы.АдресДвоичныхДанныхФайла) Тогда
			УдалитьИзВременногоХранилища(СтрокаТаблицыФайлы.АдресДвоичныхДанныхФайла);
		КонецЕсли;
	КонецЦикла;
	
	ОбъектНаСервере.ПрочитатьФайлы(ФайлыДляОбработки, Истина, ЭтаФорма.УникальныйИдентификатор);
	ОбъектНаСервере.ОповеститьОбОшибках();
	
	ЭтаФорма.Issuers.Загрузить(ОбъектНаСервере.СтруктураТаблиц.Issuers);
	ЭтаФорма.IssuerLimits.Загрузить(ОбъектНаСервере.СтруктураТаблиц.IssuerLimits);
	ЭтаФорма.GroupLimits.Загрузить(ОбъектНаСервере.СтруктураТаблиц.GroupLimits);
	ЭтаФорма.ГруппыЭмитентов.Загрузить(ОбъектНаСервере.СтруктураТаблиц.ГруппыЭмитентов);
	ЭтаФорма.Ошибки.Загрузить(ОбъектНаСервере.СтруктураТаблиц.Ошибки);
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере.СтруктураТаблиц.Файлы, "Файлы");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОшибокПоФайлу(ИмяФайла)

	ЭтаФорма.ОшибкиФайла.Очистить();
	НайденныеСтроки = ЭтаФорма.Ошибки.Выгрузить(Новый Структура("ИмяФайла", ИмяФайла));
	Для каждого СтрокаОшибки Из НайденныеСтроки Цикл
		СтрокиОшибки = ЭтаФорма.ОшибкиФайла.НайтиСтроки(Новый Структура("ОписаниеОшибки", СтрокаОшибки.ОписаниеОшибки));
		Если СтрокиОшибки.Количество() = 0 Тогда
			
			НоваяСтрока = ЭтаФорма.ОшибкиФайла.Добавить();
			НоваяСтрока.ОписаниеОшибки = СтрокаОшибки.ОписаниеОшибки;
			
			Отбор = Новый Структура("НомерСтроки", СтрокаОшибки.ИдентификаторСтроки);
			СтрокиДанных = ЭтаФорма[СтрокаОшибки.Раздел].НайтиСтроки(Отбор);
			СтрокаДанных = СтрокиДанных[0];
			
			Если СтрокаОшибки.Действие = "Создать" Тогда
				НоваяСтрока.Действие = "Создать набор";
				НоваяСтрока.Отбор = СтрокаДанных.Отбор;
				НоваяСтрока.ХэшСуммаУсловийОтбора = СтрокаДанных.ХэшСуммаУсловийОтбора;
			ИначеЕсли СтрокаОшибки.Действие = "ИмпортироватьЦБ" Тогда 
				НоваяСтрока.Действие = "Импортировать";
				НоваяСтрока.СтрокаПоиска = СтрокаДанных.ISIN;
				Если НРег(СтрокаДанных.InstrumentType) = "акции" Тогда
					НоваяСтрока.Группа = Справочники.ГруппыИмпортируемыхОбъектов.Акции;
				Иначе
					НоваяСтрока.Группа = Справочники.ГруппыИмпортируемыхОбъектов.Облигации;
				КонецЕсли; 
			ИначеЕсли СтрокаОшибки.Действие = "ИмпортироватьЮЛ" Тогда 
				НоваяСтрока.Действие = "Импортировать";
				НоваяСтрока.СтрокаПоиска = СтрокаДанных.ID;
				НоваяСтрока.Группа = Справочники.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица;
			КонецЕсли; 
		//Иначе
		//	СтрокаОшибки = СтрокиОшибки[0];
		КонецЕсли; 
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаборыПоХэшСуммеНаСервере(ВыбраннаяСтрока)

	ТекСтрока = ЭтаФорма.ОшибкиФайла.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборыИнвестиционныхДеклараций.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НаборыИнвестиционныхДеклараций КАК НаборыИнвестиционныхДеклараций
		|ГДЕ
		|	НаборыИнвестиционныхДеклараций.ХешСуммаУсловийОтбора = &ХешСуммаУсловийОтбора";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ХешСуммаУсловийОтбора", ТекСтрока.ХэшСуммаУсловийОтбора);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
	 	// обновим статусы ошибок
		СтрокиОшибок = ЭтаФорма.Ошибки.НайтиСтроки(Новый Структура("ХэшСуммаУсловийОтбора", ТекСтрока.ХэшСуммаУсловийОтбора));
		Для каждого Строка Из СтрокиОшибок Цикл
			ЭтаФорма.Ошибки.Удалить(Строка);
		КонецЦикла; 
		ЭтаФорма.ОшибкиФайла.Удалить(ТекСтрока);
		
		// заполним наборы в лимитах 
		СтрокиЛимитов = ЭтаФорма.IssuerLimits.НайтиСтроки(Новый Структура("ХэшСуммаУсловийОтбора", ТекСтрока.ХэшСуммаУсловийОтбора));
		Для каждого Строка Из СтрокиЛимитов Цикл
			Строка.НаборИнвестиционнойДекларации = Выборка.Ссылка;
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ОбновитьСтатусыОшибокФайлов()

	ТаблицаОшибок = ЭтаФорма.Ошибки.Выгрузить(, "ИмяФайла");
	ТаблицаОшибок.Свернуть("ИмяФайла");
	ФайлыСОшибками = ТаблицаОшибок.ВыгрузитьКолонку("ИмяФайла");
	
	СтрокиФайловСОшибками = ЭтаФорма.Файлы.НайтиСтроки(Новый Структура("СодержитОшибки", Истина));
	
	Для каждого СтрокаФайлы Из СтрокиФайловСОшибками Цикл
		
		ГрупповыеЛимиты = ЭтаФорма.GroupLimits.НайтиСтроки(Новый Структура("ИмяФайла", СтрокаФайлы.ИмяФайла));
		ЛимитыЭмитентов = ЭтаФорма.IssuerLimits.НайтиСтроки(Новый Структура("ИмяФайла", СтрокаФайлы.ИмяФайла));
		
		Если ГрупповыеЛимиты.Количество() + ЛимитыЭмитентов.Количество() > 0 Тогда
			СтрокаФайлы.СодержитОшибки = (ФайлыСОшибками.Найти(СтрокаФайлы.ИмяФайла) <> Неопределено);
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры
 
&НаСервере
Функция СоздатьИНазначитьЛимитныеВедомости(ИдентификаторСтрокиФайлов)
	
	СтрокаТаблицыФайлы = ЭтаФорма.Файлы.НайтиПоИдентификатору(ИдентификаторСтрокиФайлов);
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектНаСервере.СтруктураТаблиц = Новый Структура;
	ОбъектНаСервере.СтруктураТаблиц.Вставить("Issuers", ЭтаФорма.Issuers.Выгрузить());
	ОбъектНаСервере.СтруктураТаблиц.Вставить("IssuerLimits", ЭтаФорма.IssuerLimits.Выгрузить());
	ОбъектНаСервере.СтруктураТаблиц.Вставить("GroupLimits", ЭтаФорма.GroupLimits.Выгрузить());
	ОбъектНаСервере.СтруктураТаблиц.Вставить("ГруппыЭмитентов", ЭтаФорма.ГруппыЭмитентов.Выгрузить());
	ОбъектНаСервере.СтруктураТаблиц.Вставить("Ошибки", ЭтаФорма.Ошибки.Выгрузить());
	
	Результат = ОбъектНаСервере.СоздатьИНазначитьЛимитныеВедомости(СтрокаТаблицыФайлы, ЭтаФорма.ДопСведение);
	
	ОбъектНаСервере.ОповеститьОбОшибках();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПараметрыВыгрузкиВЕГАР(ИдентификаторСтрокиФайлов, ГруппаДоговоров)

	СтрокаФайл = ЭтаФорма.Файлы.НайтиПоИдентификатору(ИдентификаторСтрокиФайлов);
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("Организация", Объект.Организация);
	ПараметрыВыгрузки.Вставить("ИмяФайла", СтрокаФайл.ИмяФайла);
	ПараметрыВыгрузки.Вставить("ГруппаДоговоров", ГруппаДоговоров);
	ПараметрыВыгрузки.Вставить("ЛимитыГрупп", Новый Массив);
	ПараметрыВыгрузки.Вставить("ЛимитыЭмитентов", Новый Массив);
	ПараметрыВыгрузки.Вставить("ГруппыЭмитентов", Новый Массив);
	
	СтрокиГруппДоговоров = СтрокаФайл.ГруппыДоговоров.НайтиСтроки(Новый Структура("Представление", ГруппаДоговоров));
	Если СтрокиГруппДоговоров.Количество() = 1 Тогда
		ПараметрыВыгрузки.Вставить("СписокДоговоров", СтрокиГруппДоговоров[0].СписокДоговоров);
	КонецЕсли;
		
	ЛимитыГрупп = ЭтаФорма.GroupLimits.НайтиСтроки(Новый Структура("ИмяФайла", СтрокаФайл.ИмяФайла));
	Колонки = Новый ФиксированнаяСтруктура("Name, LimitSizeInCash, GroupMember");
	
	Для каждого СтрокаЛимитаГрупп Из ЛимитыГрупп Цикл
	
		ДанныеСтроки = Новый Структура(Колонки);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаЛимитаГрупп);
		ПараметрыВыгрузки.ЛимитыГрупп.Добавить(ДанныеСтроки);
	
	КонецЦикла;
	
	ЛимитыЭмитентов = ЭтаФорма.IssuerLimits.НайтиСтроки(Новый Структура("ИмяФайла", СтрокаФайл.ИмяФайла));
	Колонки = Новый ФиксированнаяСтруктура("IssuerID, LimitType, LimitSizeInCash, InstrumentType, Contracts, SellOnly, MaturityTo, LimitSizeInQuantity, ISIN, MaturityFrom, IsGuaranteed, Guarantor, LimitSizeInYears, LimitSizeInPercent, ЮрФизЛицо, ЦеннаяБумага");
	
	Для каждого СтрокаЛимитаЭмитента Из ЛимитыЭмитентов Цикл
	
		ДанныеСтроки = Новый Структура(Колонки);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаЛимитаЭмитента);
		ПараметрыВыгрузки.ЛимитыЭмитентов.Добавить(ДанныеСтроки);
		
	КонецЦикла; 
	
	Группы = ЭтаФорма.ГруппыЭмитентов.НайтиСтроки(Новый Структура("ИмяФайла", СтрокаФайл.ИмяФайла));
	Колонки = Новый ФиксированнаяСтруктура("IssuerID, ЮрФизЛицо, ИмяГруппы");
	
	Для каждого СтрокаГруппы Из Группы Цикл
	
		ДанныеСтроки = Новый Структура(Колонки);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаГруппы);
		ПараметрыВыгрузки.ГруппыЭмитентов.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыВыгрузки, ЭтаФорма.УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ИзменитьФлажки(Значение)

	Для каждого СтрокаТаблицыФайлы Из ЭтаФорма.Файлы Цикл
		СтрокаТаблицыФайлы.Загрузить = Значение;
	КонецЦикла;

КонецПроцедуры 

#КонецОбласти 
 
