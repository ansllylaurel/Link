		|	_ЛимитыНаЭмитентов.ISIN КАК ЦеннаяБумагаISIN,
		|	ВЫРАЗИТЬ(_ЛимитыНаЭмитентов.ЛимитВРублях + _ЛимитыНаЭмитентов.ЛимитВПроцентах + _ЛимитыНаЭмитентов.ЛимитНаКоличество + _ЛимитыНаЭмитентов.ЛимитВГодах КАК ЧИСЛО) КАК РазмерЛимита,
		|	_ЛимитыНаЭмитентов.СрокОт КАК СрокОт,
		|	_ЛимитыНаЭмитентов.СрокДо КАК СрокДо,
		|	_ЛимитыНаЭмитентов.СГарантией КАК СГарантией,
		|	ЕСТЬNULL(_КодыГарантов.ЮрФизЛицо, """") КАК Гарант,
		|	_ЛимитыНаЭмитентов.Гарант КАК ГарантИНН,
		|	ЕСТЬNULL(_КодыГарантов.Код, """") КАК ГарантКод,
		|	_ЛимитыНаЭмитентов.ТолькоПродажа КАК ТолькоПродажа,
		|	ВЫБОР
		|		КОГДА _ЛимитыНаЭмитентов.ТолькоПродажа
		|			ТОГДА _ЛимитыНаЭмитентов.ДатаЗапретаПокупки
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаЗапретаПокупки,
		|	_Файлы.Дата КАК ДатаЛВ
		|ПОМЕСТИТЬ _ИтогЛимитыНаЭмитентов
		|ИЗ
