Функция СоздатьНачисленияЗадолженности(ДанныеДляЗаполнения)
	
	Результат = Новый Массив;
	
	Пока ДанныеДляЗаполнения.Следующий() Цикл
		
		ДокументОбъект = Документы.НачислениеЗадолженности.СоздатьДокумент();
		
		Выборка = ДанныеДляЗаполнения.Выбрать();
		
		ЗаполнитьШапкуДокумента = Истина;
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗаполнитьШапкуДокумента Тогда
				ЗаполнитьШапкуДокумента = Ложь;
				ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект.Основания.Добавить(), Выборка);
			
		КонецЦикла;
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать начисление задолженности " + НРег(Строка(ДокументОбъект.ВидЗадолженности)) + " для " + ДокументОбъект.СчетДоверительногоУправления + "!");
			Возврат Неопределено;
		КонецПопытки;
		
		Результат.Добавить(Новый Структура("Документ, Представление", ДокументОбъект.Ссылка, Строка(ДокументОбъект.Ссылка)));
		
	КонецЦикла;
	
	Возврат Результат;
	
