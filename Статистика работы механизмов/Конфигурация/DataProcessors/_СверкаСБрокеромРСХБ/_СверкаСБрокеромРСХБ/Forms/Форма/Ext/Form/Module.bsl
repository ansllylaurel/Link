Функция ОбработатьДанныеОтчета(Организация, Брокер, Дата, ДанныеОтчета)
	
	Результат = Истина;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("КодКлиента",			Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ЭтоИсполнение",		Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("Номер",				Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("РЕПО",					Новый ОписаниеТипов("Булево"));
	ТЗ.Колонки.Добавить("ЧастьРЕПО",			Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ГосРегНомерЦБ",		Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ISIN",					Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("КомиссияБрокера",		Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ДанныеОтчета Цикл
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), ТекСтрока);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("Брокер",      			Брокер);
	Запрос.УстановитьПараметр("Период",      			Дата);
	Запрос.УстановитьПараметр("ТЗ",						ТЗ);
	Запрос.УстановитьПараметр("ТекущийПользователь",	ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Комментарий",			"Создан аппаратно-техническими средствами " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	Запрос.УстановитьПараметр("ПрочиеДоходыИРасходы",	Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам брокера"));
	
	Запрос.Текст = ПолучитьТекстЗапроса();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	НачатьТранзакцию();

	Блокировка = Новый БлокировкаДанных;
		
	БлокировкаДатЗапретаРедактирования = Блокировка.Добавить("РегистрСведений.ДатыЗапретаРедактирования");
	БлокировкаДатЗапретаРедактирования.УстановитьЗначение("Организация", Организация);
	БлокировкаДатЗапретаРедактирования.УстановитьЗначение("ГруппаЗапрета", Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
	БлокировкаДатЗапретаРедактирования.Режим = РежимБлокировкиДанных.Разделяемый;
		
	Блокировка.Заблокировать();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	УдаляемыеДокументы			   = РезультатЗапроса[10].Выбрать();
	НачисленияЗадолженности		   = РезультатЗапроса[11].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Оплаты						   = РезультатЗапроса[12].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НеопределенныеКлиенты		   = РезультатЗапроса[13].Выбрать();
	НеопределенныеСделки		   = РезультатЗапроса[14].Выбрать();
	НеопределенныеЦенныеБумаги	   = РезультатЗапроса[15].Выбрать();
	ОшибкиДатЗапретаРедактирования = РезультатЗапроса[16].Выбрать();

	Пока НеопределенныеКлиенты.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить клиента доверительного управления по коду '" + СокрЛП(НеопределенныеКлиенты.КодКлиента) + "'! Данные по клиенту загружены не будут.");
		Результат = Ложь;	
	КонецЦикла;
	
	Пока НеопределенныеСделки.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить сделку по номеру '" + СокрЛП(НеопределенныеСделки.НомерСделки) + "'! Данные по сделке загружены не будут.");
		Результат = Ложь;
	КонецЦикла;
	
	Пока НеопределенныеЦенныеБумаги.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить ценную бумагу по гос. рег. номеру '" + СокрЛП(НеопределенныеЦенныеБумаги.ГосРегНомерЦБ) + "' и ISIN '" + СокрЛП(НеопределенныеЦенныеБумаги.ISIN) + "'! Данные по сделке загружены не будут.");
		Результат = Ложь;
	КонецЦикла;
	
	Пока ОшибкиДатЗапретаРедактирования.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для загрузки/удаления операции по счету ДУ [" + СокрЛП(ОшибкиДатЗапретаРедактирования.Клиент) + "] необходимо изменить дату запрета редактирования! Дата запрета редактирования [" + Формат(ОшибкиДатЗапретаРедактирования.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy") + "] должна быть меньше даты операций [" + Формат(Дата, "ДФ=dd.MM.yyyy") + "].");
		Результат = Ложь;
	КонецЦикла;
	
	Если Результат = Ложь Тогда
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецЕсли;
		
	ПомеченныеНаУдалениеДокументы = ПометитьДокументыНаУдаление(УдаляемыеДокументы);
	
	Если ПомеченныеНаУдалениеДокументы = Неопределено Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	НачисленияЗадолженности = СоздатьНачисленияЗадолженности(НачисленияЗадолженности);
	
	Если НачисленияЗадолженности = Неопределено Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	Оплаты = СоздатьОплаты(Оплаты);
	
	Если Оплаты = Неопределено Тогда
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	Для Каждого ТекДокумент Из ПомеченныеНаУдалениеДокументы Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Помечен на удаление документ " + ТекДокумент.Представление + ".", ТекДокумент.Документ); 
	КонецЦикла;
	
	Для Каждого ТекДокумент Из НачисленияЗадолженности Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ТекДокумент.Представление + ".", ТекДокумент.Документ); 
	КонецЦикла;
	
	Для Каждого ТекДокумент Из Оплаты Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ТекДокумент.Представление + ".", ТекДокумент.Документ); 
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКаталогСОтчетамиБрокера(Организация, Дата)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._СверкаСБрокеромРСХБ.ШаблонКаталогаОтчетов", Организация, Дата);
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация		= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Дата				= НачалоДня(ТекущаяДатаСеанса()) - 24*60*60;
	Объект.Брокер			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_РСХБ");
	Объект.КаталогОтчетов	= ПолучитьКаталогСОтчетамиБрокера(Объект.Организация, Объект.Дата);
	
	Если НЕ ЗначениеЗаполнено(Объект.Брокер) Тогда
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогОтчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогФыбораФайла						= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогФыбораФайла.Каталог				= Объект.КаталогОтчетов;
	ДиалогФыбораФайла.МножественныйВыбор	= Ложь;
	ДиалогФыбораФайла.Заголовок				= "Выберите каталог с отчетами";
	
	Если ДиалогФыбораФайла.Выбрать() Тогда
		Объект.КаталогОтчетов = ДиалогФыбораФайла.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияФлажков(НовоеЗначение)
	
	Для Каждого ТекСтрока Из Объект.ОтчетыБрокера Цикл
		
		ТекСтрока.Обработать = НовоеЗначение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсе(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("УстановитьВсе");
	Попытка
	
		УстановитьЗначенияФлажков(Истина);
	
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СнятьВсе");
	Попытка
	
		УстановитьЗначенияФлажков(Ложь);
	
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьНомерДБОИзОтчета(Эксель, ИмяФайла)
	
	Попытка
		Книга = Эксель.Workbooks.Open(ИмяФайла);
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не удалось обработать файл '" + ИмяФайла + "'!
			|" + ОписаниеОшибки());
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Лист = Книга.Worksheets.Item(1);
	
	НомерДБО		= Неопределено;
	НачалоПериода	= Неопределено;
	КонецПериода	= Неопределено;
	
	// Ищем код клиента брокера.
	Для ИндексСтроки = 1 По 30 Цикл
		
		Если СтрНайти(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value), "Дата и номер договора на брокерское обслуживание:") <> 0 Тогда
			НомерДБО = СокрЛП(Лист.Cells(ИндексСтроки, 6).Value);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НомерДБО = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Ищем даты отчета.
	Для ИндексСтроки = ИндексСтроки По 30 Цикл
		
		Если СтрНайти(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value), "Дата начала периода:") <> 0 Тогда
			НачалоПериода	= СокрЛП(Лист.Cells(ИндексСтроки, 3).Value);
			КонецПериода	= СокрЛП(Лист.Cells(ИндексСтроки + 1, 3).Value);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НачалоПериода = Формат(Объект.Дата, "ДФ=dd.MM.yyyy")
		И НачалоПериода = КонецПериода Тогда
		Результат = НомерДБО;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Книга.Close();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьНомераДБООтчетовЗаПериод(Эксель, Файлы)
	
	Результат = Новый Массив;
	
	Для Каждого ТекФайл Из Файлы Цикл
		
		НомерДБО = ПолучитьНомерДБОИзОтчета(Эксель, ТекФайл);
		
		Если НомерДБО <> Неопределено Тогда
			Результат.Добавить(Новый Структура("НомерДБО, ИмяФайла", НомерДБО, ТекФайл));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокОтчетов(ДанныеОтчетов)
	
	Объект.ОтчетыБрокера.Очистить();
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("НомерДБО", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("ИмяФайла",	Новый ОписаниеТипов("Строка"));
	
	Для Каждого ТекОтчет Из ДанныеОтчетов Цикл
		ЗаполнитьЗначенияСвойств(Данные.Добавить(), ТекОтчет);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",			Объект.Дата);
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("Брокер",			Объект.Брокер);
	Запрос.УстановитьПараметр("Данные",			Данные);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Данные.НомерДБО КАК СТРОКА(100)) КАК НомерДБО,
		|	ВЫРАЗИТЬ(Данные.ИмяФайла КАК СТРОКА(255)) КАК ИмяФайла
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	&Данные КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СВУ,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ПОМЕСТИТЬ _КодыУБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Данные.НомерДБО КАК НомерДБО
		|			ИЗ
		|				_Данные КАК _Данные)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыУБрокера.СВУ КАК СВУ,
		|	_КодыУБрокера.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	_Данные.НомерДБО КАК НомерДБО,
		|	_Данные.ИмяФайла КАК ИмяФайла
		|ПОМЕСТИТЬ _ОпределенныеКлиенты
		|ИЗ
		|	_Данные КАК _Данные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыУБрокера КАК _КодыУБрокера
		|		ПО _Данные.НомерДБО = _КодыУБрокера.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОпределенныеКлиенты.СВУ КАК СВУ,
		|	КОЛИЧЕСТВО(_ОпределенныеКлиенты.СВУ) КАК Количество
		|ПОМЕСТИТЬ _КоличествоОтчетовПоСВУ
		|ИЗ
		|	_ОпределенныеКлиенты КАК _ОпределенныеКлиенты
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОпределенныеКлиенты.СВУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Обработать,
		|	_ОпределенныеКлиенты.СВУ КАК СчетВнутреннегоУчета,
		|	_ОпределенныеКлиенты.ИмяФайла КАК ИмяФайла
		|ИЗ
		|	_ОпределенныеКлиенты КАК _ОпределенныеКлиенты
		|ГДЕ
		|	_ОпределенныеКлиенты.ДатаЗапретаРедактирования < &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Данные.НомерДБО КАК НомерДБО
		|ИЗ
		|	_Данные КАК _Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОпределенныеКлиенты КАК _ОпределенныеКлиенты
		|		ПО _Данные.НомерДБО = _ОпределенныеКлиенты.НомерДБО
		|ГДЕ
		|	_ОпределенныеКлиенты.НомерДБО ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КоличествоОтчетовПоСВУ.СВУ КАК СВУ,
		|	_КоличествоОтчетовПоСВУ.Количество КАК Количество
		|ИЗ
		|	_КоличествоОтчетовПоСВУ КАК _КоличествоОтчетовПоСВУ
		|ГДЕ
		|	_КоличествоОтчетовПоСВУ.Количество > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОпределенныеКлиенты.СВУ КАК СчетВнутреннегоУчета,
		|	_ОпределенныеКлиенты.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	""Для загрузки операций счета ДУ [%1] необходимо изменить дату запрета редактирования [%2]. Она должна быть меньше даты сверки/загрузки [%3]."" КАК ТекстСообщения
		|ИЗ
		|	_ОпределенныеКлиенты КАК _ОпределенныеКлиенты
		|ГДЕ
		|	_ОпределенныеКлиенты.ДатаЗапретаРедактирования >= &Период";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Объект.ОтчетыБрокера.Загрузить(РезультатЗапроса[4].Выгрузить());
	
	НеопределенныеДоговоры = РезультатЗапроса[5].Выгрузить();
	
	Если НеопределенныеДоговоры.Количество() > 0 Тогда
		
		Сообщение = "Некоторые номера договоров брокерского обслуживания не удалось определить по номеру:";
		
		Для Каждого Договор Из НеопределенныеДоговоры Цикл
			Сообщение = Сообщение + "
				|" + Договор.НомерДБО;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		
	КонецЕсли;
	
	ВозможныеДубли = РезультатЗапроса[6].Выгрузить();
	
	Если ВозможныеДубли.Количество() > 0 Тогда
		
		Сообщение = "По некоторым договорам брокерского обслуживания обнаружено несколько отчетов за " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + ":";
		
		Для Каждого Договор Из ВозможныеДубли Цикл
			Сообщение = Сообщение + "
				|Счет внутреннего учета '" + Договор.СВУ + "' обнаружено " + Формат(Договор.Количество, "ЧДЦ=0; ЧГ=0") + " отчета(-ов)";
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		
	КонецЕсли;
	
	ОшибкиДатЗапретаРедактирования = РезультатЗапроса[7].Выбрать();
	
	Пока ОшибкиДатЗапретаРедактирования.Следующий() Цикл 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ОшибкиДатЗапретаРедактирования.ТекстСообщения, ОшибкиДатЗапретаРедактирования.СчетВнутреннегоУчета, Формат(ОшибкиДатЗапретаРедактирования.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"), Формат(Объект.Дата, "ДФ=dd.MM.yyyy")));  
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИменаФайлов(Маска)
	
	Результат = Новый Массив;
	
	НайденныеФайлы = НайтиФайлы(Объект.КаталогОтчетов, Маска);
	
	Для Каждого ТекФайл Из НайденныеФайлы Цикл
		Результат.Добавить(ТекФайл.ПолноеИмя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокФайлов()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайлов = Новый Массив;
	
	Объект.ОтчетыБрокера.Очистить();
	
	Эксель = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
	
	Если Эксель = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Приложение MS Excel отсутствует или недостаточно прав доступа!
			|Обновление списка файлов прервано.");
		
		Возврат;
		
	КонецЕсли;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(Эксель, Ложь); 
	
	Файлы = Новый Массив;
	
	РаботаСКоллекциями.ДополнитьМассив(Файлы, ПолучитьИменаФайлов("*.xls"));
	РаботаСКоллекциями.ДополнитьМассив(Файлы, ПолучитьИменаФайлов("*.xlsx"));
	
	ДанныеФайлов = ПолучитьНомераДБООтчетовЗаПериод(Эксель, Файлы);
	
	Если ДанныеФайлов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В указанном каталоге файлы отчетов за " + Формат(Объект.Дата, "ДЛФ=DD") + " не найдены");
	Иначе
		ЗаполнитьСписокОтчетов(ДанныеФайлов);
	КонецЕсли;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Эксель);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.КаталогОтчетов = ПолучитьКаталогСОтчетамиБрокера(Объект.Организация, Объект.Дата);
	
	Если ЗначениеЗаполнено(Объект.КаталогОтчетов)
		И Вопрос("Обновить список файлов с отчетами брокера?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ОбновитьСписокФайлов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогОтчетовПриИзменении(Элемент)
	
	ОбновитьСписокФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновитьСписокФайлов");
	Попытка
	
		ОбновитьСписокФайлов();
	
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Брокер)
		И ЗначениеЗаполнено(Объект.Дата)
		И ЗначениеЗаполнено(Объект.КаталогОтчетов)
		И Вопрос("Загрузить список файлов с отчетами брокера за " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + "?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ОбновитьСписокФайлов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеОтчетаДляСверки(Эксель, Отчет, ДанныеОтчетов)
	
	ИдентификаторСтроки = Отчет.ПолучитьИдентификатор();
	
	Попытка
		Книга = Эксель.Workbooks.Open(Отчет.ИмяФайла);
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не удалось обработать файл '" + Отчет.ИмяФайла + "'!
			|" + ОписаниеОшибки());
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Лист = Книга.Worksheets.Item(1);
	
	Для ИндексСтроки = 1 По 30 Цикл
		
		Если СтрНайти(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value), "Дата и номер договора на брокерское обслуживание:") <> 0 Тогда
			КодКлиента = СтрЗаменить(СокрЛП(Лист.Cells(ИндексСтроки, 6).Value), " ", "");
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ПродолжатьОбход = Истина;
	
	Пока ПродолжатьОбход Цикл
		
		// Определяем блок ДДС
		Если СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "движение по денежным средствам") <> 0 Тогда
			
			ИндексСтроки = ИндексСтроки + 2;
			
			Пока СокрЛП(Лист.Cells(ИндексСтроки, 1).Value) <> "" Цикл
				
				Если СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "входящая сумма средств на счет") <> 0 Тогда
					
					НачальныйОстатокДС = ПолучитьЧисловоеЗначениеЯчейки(Лист.Cells(ИндексСтроки, 6).Value);
					
					Если НачальныйОстатокДС = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					
					ИндексСтроки = ИндексСтроки + 1;
					
				ИначеЕсли СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "остаток средств на счете") <> 0 Тогда
					
					КонечныйОстатокДС = ПолучитьЧисловоеЗначениеЯчейки(Лист.Cells(ИндексСтроки, 6).Value);
					
					Если КонечныйОстатокДС = Неопределено Тогда
						Возврат Ложь;	
					КонецЕсли;
					
					ИндексСтроки = ИндексСтроки + 1;
					
					НоваяСтрока = Новый Структура;
					НоваяСтрока.Вставить("КодКлиента",			КодКлиента);
					НоваяСтрока.Вставить("ИмяФайла",			Отчет.ИмяФайла);
					НоваяСтрока.Вставить("ИдентификаторСтроки",	ИдентификаторСтроки);
					НоваяСтрока.Вставить("НачальныйОстаток",	НачальныйОстатокДС);
					НоваяСтрока.Вставить("КонечныйОстаток", 	КонечныйОстатокДС);
					
					ДанныеОтчетов.ОстаткиДС.Добавить(НоваяСтрока);
					
					Прервать;
					
				Иначе
					ИндексСтроки = ИндексСтроки + 1;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "отчет/выписка о движении по счету") <> 0 Тогда
			
			ИндексСтроки = ИндексСтроки + 3;
			
			Пока СокрЛП(НРег(Лист.Cells(ИндексСтроки, 1).Value)) <> "итого:" Цикл
				
				НоваяСтрока = Новый Структура;
				
				НоваяСтрока.Вставить("КодКлиента",			КодКлиента);
				НоваяСтрока.Вставить("ИмяФайла",			Отчет.ИмяФайла);
				НоваяСтрока.Вставить("ИдентификаторСтроки",	ИдентификаторСтроки);
				
				КодыЦБ = СокрЛП(Лист.Cells(ИндексСтроки, 1).Value);
				
				Если СтрНайти(КодыЦБ, "/") <> 0 Тогда
					НоваяСтрока.Вставить("ГосРегНомер", СокрЛП(Лев(КодыЦБ, СтрНайти(КодыЦБ, "/") - 1)));
					НоваяСтрока.Вставить("ISIN",		СокрЛП(Сред(КодыЦБ, СтрНайти(КодыЦБ, "/") + 1)));
				Иначе
					НоваяСтрока.Вставить("ГосРегНомер",	СокрЛП(КодыЦБ));
					НоваяСтрока.Вставить("ISIN",		"");
				КонецЕсли;
				
				НачальныйОстаток = ПолучитьЧисловоеЗначениеЯчейки(Лист.Cells(ИндексСтроки, 6).Value);
				
				Если НачальныйОстаток = Неопределено Тогда
					Возврат Ложь;
				Иначе
					НоваяСтрока.Вставить("НачальныйОстаток", НачальныйОстаток);	
				КонецЕсли;
				
				КонечныйОстаток = ПолучитьЧисловоеЗначениеЯчейки(Лист.Cells(ИндексСтроки, 9).Value);
				
				Если КонечныйОстаток = Неопределено Тогда
					Возврат Ложь;
				Иначе
					НоваяСтрока.Вставить("КонечныйОстаток", КонечныйОстаток);	
				КонецЕсли;
								
				ДанныеОтчетов.ОстаткиЦБ.Добавить(НоваяСтрока);
				
				ИндексСтроки = ИндексСтроки + 1;
				
			КонецЦикла;
			
		ИначеЕсли СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "дата составления") <> 0 Тогда
			ПродолжатьОбход = Ложь;
		Иначе
			ИндексСтроки = ИндексСтроки + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Книга.Close();
	
	Возврат Истина;	
	
КонецФункции

Функция ПолучитьЧисловоеЗначениеЯчейки(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		
		Возврат Значение;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(Значение,, Ложь) Тогда
		
		Возврат РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(Значение);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтания файла. Не удалось преобразовать значение [" + Значение + "] в число.");
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьТекстЗапросаДляСверки()
	
	Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиДС.КодКлиента КАК СТРОКА(100)) КАК КодКлиента,
		|	ВЫРАЗИТЬ(ОстаткиДС.ИмяФайла КАК СТРОКА(256)) КАК ИмяФайла,
		|	ОстаткиДС.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ОстаткиДС.НачальныйОстаток КАК НачальныйОстаток,
		|	ОстаткиДС.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ОстаткиДС
		|ИЗ
		|	&ОстаткиДС КАК ОстаткиДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОстаткиЦБ.КодКлиента КАК СТРОКА(100)) КАК КодКлиента,
		|	ВЫРАЗИТЬ(ОстаткиЦБ.ИмяФайла КАК СТРОКА(256)) КАК ИмяФайла,
		|	ОстаткиЦБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ВЫРАЗИТЬ(ОстаткиЦБ.ГосРегНомер КАК СТРОКА(21)) КАК ГосРегНомер,
		|	ВЫРАЗИТЬ(ОстаткиЦБ.ISIN КАК СТРОКА(50)) КАК ISIN,
		|	ОстаткиЦБ.НачальныйОстаток КАК НачальныйОстаток,
		|	ОстаткиЦБ.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ОстаткиЦБ
		|ИЗ
		|	&ОстаткиЦБ КАК ОстаткиЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиДС.КодКлиента КАК КодКлиента
		|ПОМЕСТИТЬ _КодыКлиентов
		|ИЗ
		|	_ОстаткиДС КАК _ОстаткиДС
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ОстаткиЦБ.КодКлиента
		|ИЗ
		|	_ОстаткиЦБ КАК _ОстаткиЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиЦБ.ГосРегНомер КАК ГосРегНомер,
		|	_ОстаткиЦБ.ISIN КАК ISIN
		|ПОМЕСТИТЬ _КодыЦБ
		|ИЗ
		|	_ОстаткиЦБ КАК _ОстаткиЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыКлиентовУБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код В
		|			(ВЫБРАТЬ
		|				_КодыКлиентов.КодКлиента КАК КодКлиента
		|			ИЗ
		|				_КодыКлиентов КАК _КодыКлиентов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Акции.Ссылка КАК ЦеннаяБумага,
		|	Акции.ГосударственныйРегистрационныйНомер КАК ГосРегНомер,
		|	NULL КАК ISIN
		|ПОМЕСТИТЬ _ЦенныеБумагиВсе
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ОстаткиЦБ.ГосРегНомер КАК ГосРегНомер
		|			ИЗ
		|				_ОстаткиЦБ КАК _ОстаткиЦБ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Облигации.Ссылка,
		|	Облигации.ГосударственныйРегистрационныйНомер,
		|	NULL
		|ИЗ
		|	Справочник.Облигации КАК Облигации
