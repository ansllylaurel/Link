
&НаКлиенте
Функция ПолучитьДанныеТаблицыСделок(Лист, ИндексСтроки, КодКлиента, Блок)
	
	Результат = Новый Массив;
	
	//С 01.04.21 изменился формат отчета. #369300
	Если Объект.Дата < Дата(2021, 4, 1) Тогда
		НомерПоляКомиссии = 16;	
	Иначе
		НомерПоляКомиссии = 17;	
	КонецЕсли;
	
	// Обходим таблицу сделок.
	Пока СокрЛП(Лист.Cells(ИндексСтроки, 1).Value) <> "" Цикл
		
		// Обнаружено разделение таблицы на блоки.
		Если СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "итого") <> 0 Тогда
			ИндексСтроки = ИндексСтроки + 1;
			Продолжить;
		КонецЕсли;
		
		// Получаем данные из строки.
		НомерСделки			= СокрЛП(Лист.Cells(ИндексСтроки, 3).Value);
		СтрокаВидСделки		= НРег(СокрЛП(Лист.Cells(ИндексСтроки, 6).Value));
		
		КомиссияБрокера		= СтрЗаменить(СокрЛП(Лист.Cells(ИндексСтроки, НомерПоляКомиссии).Value), " ", "");
		
		КодыЦБ = СокрЛП(Лист.Cells(ИндексСтроки, 8).Value);
		
		Если СтрНайти(КодыЦБ, "/") <> 0 Тогда
			
			ГосРегНомер	= СокрЛП(Лев(КодыЦБ, СтрНайти(КодыЦБ, "/") - 1));
			ISIN		= СокрЛП(Сред(КодыЦБ, СтрНайти(КодыЦБ, "/") + 1));
			
		Иначе
			ГосРегНомер	= СокрЛП(КодыЦБ);
			ISIN		= "";
		КонецЕсли;
		
		РЕПО = СтрНайти(СтрокаВидСделки, "репо") <> 0;
		
		Если РЕПО Тогда
			
			Если СтрНайти(СтрокаВидСделки, "ч. 1") Тогда
				ЧастьРЕПО = 1;
			Иначе
				//ЧастьРЕПО = 2;
				// Загружаем только по первым частям РЕПО.
				ИндексСтроки = ИндексСтроки + 1;
				Продолжить;
			КонецЕсли;
			
		Иначе
			ЧастьРЕПО = 0;
		КонецЕсли;
		
		НоваяСтрока = Новый Структура;
		
		НоваяСтрока.Вставить("КодКлиента",				КодКлиента);
		НоваяСтрока.Вставить("ЭтоИсполнение",			Блок = "Исполнение обязательств");
		НоваяСтрока.Вставить("Номер",					НомерСделки);
		НоваяСтрока.Вставить("РЕПО",					РЕПО);
		НоваяСтрока.Вставить("ЧастьРЕПО",				ЧастьРЕПО);
		НоваяСтрока.Вставить("ГосРегНомерЦБ",			ГосРегНомер);
		НоваяСтрока.Вставить("ISIN",					ISIN);
		НоваяСтрока.Вставить("КомиссияБрокера",			?(КомиссияБрокера = "", 0, Число(КомиссияБрокера)));
		
		// Добавляем данные о комиссиях по сделке только в том случае, когда хотя бы одна комиссия <> 0
		Если НоваяСтрока.КомиссияБрокера <> 0 Тогда
			Результат.Добавить(НоваяСтрока);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
		
&НаКлиенте
Функция ПолучитьДанныеОтчета(Эксель, ИмяФайла)
	
	Результат = Новый Массив;
	
	Попытка
		Книга = Эксель.Workbooks.Open(ИмяФайла);
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не удалось обработать файл '" + ИмяФайла + "'!
			|" + ОписаниеОшибки());
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Лист = Книга.Worksheets.Item(1);
	
	Для ИндексСтроки = 1 По 30 Цикл
		
		Если СтрНайти(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value), "Дата и номер договора на брокерское обслуживание:") <> 0 Тогда
			КодКлиента = СтрЗаменить(СокрЛП(Лист.Cells(ИндексСтроки, 6).Value), " ", "");
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ПродолжатьОбход = Истина;
	
	Пока ПродолжатьОбход Цикл
		
		// Пропускаем пустую строку.
		Если Лист.Cells(ИндексСтроки, 1).Value = "" Тогда
			
			ИндексСтроки = ИндексСтроки + 1;
			
			Продолжить;
			
		КонецЕсли;
		
		Если СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "движение по денежным средствам") <> 0
			ИЛИ СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 2).Value)), "состав портфеля по итогам торгов с") <> 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Определяем блок сделок.
		Если СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "сделки, заключенные в период с") <> 0 Тогда
			// Нашли первый заголовок для заключенных сделок.
			Блок = "Сделки";
		ИначеЕсли СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "сделки, заключенные ранее и не исполненные на") <> 0 Тогда
			// Нашли заголовок по неисполненным сделкам.
			Блок = "Не исполненные сделки";
		ИначеЕсли СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "сделки, заключенные ранее и исполненные на") <> 0 Тогда
			// Нашли заголовок по исполненным сделкам.
			Блок = "Исполнение обязательств";
		КонецЕсли;
		
		// Нашли заголовок таблицы.
		Если (СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "сделки, совершенные в рамках тарифного плана") <> 0
			ИЛИ СтрНайти(НРег(СокрЛП(Лист.Cells(ИндексСтроки, 1).Value)), "сделки репо, совершенные в рамках тарифного плана") <> 0)
			И Блок <> "Не исполненные сделки" Тогда
			
			// Пропускаем шапку таблицы.
			ИндексСтроки = ИндексСтроки + 2;
			
			// Получаем данные сделок.
			РаботаСКоллекциями.ДополнитьМассив(Результат, ПолучитьДанныеТаблицыСделок(Лист, ИндексСтроки, КодКлиента, Блок));
			
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Книга.Close();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьКомиссию(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ЗагрузитьКомиссию");
	Попытка
	
		Если НЕ ПроверитьЗаполнение() Тогда
			Возврат;
		КонецЕсли;
	
		Эксель = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
	
		Если Эксель = Неопределено Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Приложение MS Excel отсутствует или недостаточно прав доступа!
				|Обновление списка файлов прервано.");
		
			Возврат;
		
		КонецЕсли;
	
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(Эксель, Ложь);
	
		НайденныеСтроки = Объект.ОтчетыБрокера.НайтиСтроки(Новый Структура("Обработать", Истина));
	
		ДанныеОтчетов = Новый Массив;
	
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		
			ДанныеОтчета = ПолучитьДанныеОтчета(Эксель, ТекСтрока.ИмяФайла);
		
			Если ДанныеОтчета <> Неопределено Тогда
				РаботаСКоллекциями.ДополнитьМассив(ДанныеОтчетов, ДанныеОтчета);
			КонецЕсли;
		
		КонецЦикла;
	
		Результат = ОбработатьДанныеОтчета(Объект.Организация, Объект.Брокер, Объект.Дата, ДанныеОтчетов);
	
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Эксель);
	
		Если Результат Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка данных о комиссии успешно завершена!");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка данных о комиссии прервана из-за ошибки!");
		КонецЕсли;
	
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапроса()
	
	Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТЗ.КодКлиента КАК СТРОКА(100)) КАК КодКлиента,
		|	ВЫРАЗИТЬ(ТЗ.ЭтоИсполнение КАК БУЛЕВО) КАК ЭтоИсполнение,
		|	ВЫРАЗИТЬ(ТЗ.Номер КАК СТРОКА(16)) КАК Номер,
		|	ВЫРАЗИТЬ(ТЗ.РЕПО КАК БУЛЕВО) КАК РЕПО,
		|	ВЫРАЗИТЬ(ТЗ.ЧастьРЕПО КАК ЧИСЛО(1, 0)) КАК ЧастьРЕПО,
		|	ВЫРАЗИТЬ(ТЗ.ГосРегНомерЦБ КАК СТРОКА(21)) КАК ГосРегНомерЦБ,
		|	ВЫРАЗИТЬ(ТЗ.ISIN КАК СТРОКА(50)) КАК ISIN,
		|	ВЫРАЗИТЬ(ТЗ.КомиссияБрокера КАК ЧИСЛО) КАК КомиссияБрокера
		|ПОМЕСТИТЬ _ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	(НЕ ТЗ.РЕПО
		|			ИЛИ ТЗ.ЧастьРЕПО = 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.ВалютаУчета КАК ВалютаУчета
		|ПОМЕСТИТЬ _Организация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БрокерскиеКомпании.Ссылка КАК Брокер,
		|	БрокерскиеКомпании.ЮрФизЛицо КАК Контрагент
		|ПОМЕСТИТЬ _Брокер
		|ИЗ
		|	Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
		|ГДЕ
		|	БрокерскиеКомпании.Ссылка = &Брокер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаБэкОфисаСрезПоследних.СписаниеКомиссииБрокераПриИсполненииОтложеннойСделки КАК СписаниеКомиссииБрокераПриИсполненииОтложеннойСделки
		|ПОМЕСТИТЬ _НастройкиУчетаБэкОфиса
		|ИЗ
		|	РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК Клиент,
		|	_ТЗ.КодКлиента КАК Код,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	_ТЗ КАК _ТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Брокер = &Брокер) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО _ТЗ.КодКлиента = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО (КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления)
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТЗ.КодКлиента КАК КодКлиента
		|			ИЗ
		|				_ТЗ КАК _ТЗ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Акции.Ссылка КАК ЦеннаяБумага,
		|	Акции.ГосударственныйРегистрационныйНомер КАК ГосРегНомер,
		|	NULL КАК ISIN
		|ПОМЕСТИТЬ _ЦенныеБумагиВсе
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТЗ.ГосРегНомерЦБ КАК ГосРегНомерЦБ
		|			ИЗ
		|				_ТЗ КАК _ТЗ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Облигации.Ссылка,
		|	Облигации.ГосударственныйРегистрационныйНомер,
		|	NULL
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.ГосударственныйРегистрационныйНомер В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТЗ.ГосРегНомерЦБ КАК ГосРегНомерЦБ
		|			ИЗ
		|				_ТЗ КАК _ТЗ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Паи.Ссылка,
		|	Паи.ГосударственныйРегистрационныйНомер,
		|	NULL
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.ГосударственныйРегистрационныйНомер В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТЗ.ГосРегНомерЦБ КАК ГосРегНомерЦБ
		|			ИЗ
		|				_ТЗ КАК _ТЗ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИпотечныеСертификатыУчастия.Ссылка,
		|	ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер,
		|	NULL
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|ГДЕ
		|	ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ТЗ.ГосРегНомерЦБ КАК ГосРегНомерЦБ
		|			ИЗ
		|				_ТЗ КАК _ТЗ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Объект,
		|	NULL,
		|	КодыВТорговыхСистемахСрезПоследних.Код
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			&Период,
		|			(ВидКода, Код) В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN) КАК ВидКода,
		|					_ТЗ.ISIN КАК ISIN
		|				ИЗ
		|					_ТЗ КАК _ТЗ)) КАК КодыВТорговыхСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумагиВсе.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(_ЦенныеБумагиВсе.ГосРегНомер) КАК ГосРегНомер,
		|	МАКСИМУМ(_ЦенныеБумагиВсе.ISIN) КАК ISIN
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	_ЦенныеБумагиВсе КАК _ЦенныеБумагиВсе
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦенныеБумагиВсе.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сделка.Ссылка КАК Сделка,
		|	Сделка.НомерСделки КАК Номер,
		|	NULL КАК НомерСЦК,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.ОтложенноеИсполнение КАК ОтложенноеИсполнение
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
