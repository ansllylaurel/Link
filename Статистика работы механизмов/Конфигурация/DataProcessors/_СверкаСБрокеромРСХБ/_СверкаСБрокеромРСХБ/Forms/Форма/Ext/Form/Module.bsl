		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОтчетыСРасхождениями.ИмяФайла КАК ИмяФайла,
		|	_ОтчетыСРасхождениями.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	_ОтчетыСРасхождениями.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЛОЖЬ КАК РезультатСверки
		|ИЗ
		|	_ОтчетыСРасхождениями КАК _ОтчетыСРасхождениями
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_КлючиСверки.ИмяФайла,
		|	_КлючиСверки.ИдентификаторСтроки,
		|	_КлючиСверки.СчетДоверительногоУправления,
		|	ИСТИНА
		|ИЗ
		|	_КлючиСверки КАК _КлючиСверки
		|ГДЕ
		|	НЕ (_КлючиСверки.ИмяФайла, _КлючиСверки.ИдентификаторСтроки, _КлючиСверки.СчетДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					_ОтчетыСРасхождениями.ИмяФайла КАК ИмяФайла,
		|					_ОтчетыСРасхождениями.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|					_ОтчетыСРасхождениями.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|				ИЗ
		|					_ОтчетыСРасхождениями КАК _ОтчетыСРасхождениями)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РезультатСверкиДС.ИмяФайла КАК ИмяФайла,
		|	_РезультатСверкиДС.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	_РезультатСверкиДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_РезультатСверкиДС.НачальныйОстатокБрокер КАК НачальныйОстатокБрокер,
		|	_РезультатСверкиДС.НачальныйОстатокСистема КАК НачальныйОстатокСистема,
		|	_РезультатСверкиДС.КонечныйОстатокБрокер КАК КонечныйОстатокБрокер,
		|	_РезультатСверкиДС.КонечныйОстатокСистема КАК КонечныйОстатокСистема
		|ИЗ
		|	_РезультатСверкиДС КАК _РезультатСверкиДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РезультатСверкиЦБ.ИмяФайла КАК ИмяФайла,
		|	_РезультатСверкиЦБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	_РезультатСверкиЦБ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_РезультатСверкиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_РезультатСверкиЦБ.НачальныйОстатокБрокер КАК НачальныйОстатокБрокер,
		|	_РезультатСверкиЦБ.НачальныйОстатокСистема КАК НачальныйОстатокСистема,
		|	_РезультатСверкиЦБ.КонечныйОстатокБрокер КАК КонечныйОстатокБрокер,
		|	_РезультатСверкиЦБ.КонечныйОстатокСистема КАК КонечныйОстатокСистема
		|ИЗ
		|	_РезультатСверкиЦБ КАК _РезультатСверкиЦБ";
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатСверки(Организация, Брокер, Дата, ДанныеОтчетов)
	
	ОстаткиДС = Новый ТаблицаЗначений;
	ОстаткиДС.Колонки.Добавить("КодКлиента",			Новый ОписаниеТипов("Строка"));
	ОстаткиДС.Колонки.Добавить("ИмяФайла",				Новый ОписаниеТипов("Строка"));
	ОстаткиДС.Колонки.Добавить("ИдентификаторСтроки",	Новый ОписаниеТипов("Число"));
	ОстаткиДС.Колонки.Добавить("НачальныйОстаток",		Новый ОписаниеТипов("Число"));
	ОстаткиДС.Колонки.Добавить("КонечныйОстаток",		Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекОстаток Из ДанныеОтчетов.ОстаткиДС Цикл
		ЗаполнитьЗначенияСвойств(ОстаткиДС.Добавить(), ТекОстаток);
	КонецЦикла;
	
	ОстаткиЦБ = Новый ТаблицаЗначений;
	ОстаткиЦБ.Колонки.Добавить("КодКлиента",			Новый ОписаниеТипов("Строка"));
	ОстаткиЦБ.Колонки.Добавить("ИмяФайла",				Новый ОписаниеТипов("Строка"));
	ОстаткиЦБ.Колонки.Добавить("ИдентификаторСтроки",	Новый ОписаниеТипов("Число"));
	ОстаткиЦБ.Колонки.Добавить("ГосРегНомер",			Новый ОписаниеТипов("Строка"));
	ОстаткиЦБ.Колонки.Добавить("ISIN",					Новый ОписаниеТипов("Строка"));
	ОстаткиЦБ.Колонки.Добавить("НачальныйОстаток",		Новый ОписаниеТипов("Число"));
	ОстаткиЦБ.Колонки.Добавить("КонечныйОстаток",		Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекОстаток Из ДанныеОтчетов.ОстаткиЦБ Цикл
		ЗаполнитьЗначенияСвойств(ОстаткиЦБ.Добавить(), ТекОстаток);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = ПолучитьТекстЗапросаДляСверки();
	
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("НачалоПериода",	Дата);
	Запрос.УстановитьПараметр("КонецПериода",	Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Брокер",			Брокер);
	Запрос.УстановитьПараметр("ОстаткиДС",		ОстаткиДС);
	Запрос.УстановитьПараметр("ОстаткиЦБ",		ОстаткиЦБ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	
	Результат.Вставить("НеопределенныеКлиенты",			РезультатЗапроса[17].Выгрузить().ВыгрузитьКолонку("КодКлиента"));
	Результат.Вставить("НеопределенныеЦенныеБумаги",	Новый Массив);
	Результат.Вставить("РезультатыСверки",				Новый Массив);
	Результат.Вставить("РасшифровкаСверкиДС",			Новый Массив);
	Результат.Вставить("РасшифровкаСверкиЦБ",			Новый Массив);
	
	НеопределенныеЦенныеБумаги = РезультатЗапроса[18].Выбрать();
	
	Пока НеопределенныеЦенныеБумаги.Следующий() Цикл
		НовыйРезультат = Новый Структура("ГосРегНомер, ISIN");
		ЗаполнитьЗначенияСвойств(НовыйРезультат, НеопределенныеЦенныеБумаги);
		Результат.НеопределенныеЦенныеБумаги.Добавить(НовыйРезультат);
	КонецЦикла;
	
	РезультатыСверки = РезультатЗапроса[19].Выбрать();
	
	Пока РезультатыСверки.Следующий() Цикл
		НовыйРезультат = Новый Структура("ИмяФайла, ИдентификаторСтроки, СчетДоверительногоУправления, РезультатСверки");
		ЗаполнитьЗначенияСвойств(НовыйРезультат, РезультатыСверки);
		Результат.РезультатыСверки.Добавить(НовыйРезультат);
	КонецЦикла;
	
	РасшифровкаСверкиДС = РезультатЗапроса[20].Выбрать();
	
	Пока РасшифровкаСверкиДС.Следующий() Цикл
		НовыйРезультат = Новый Структура("ИмяФайла, ИдентификаторСтроки, СчетДоверительногоУправления, НачальныйОстатокБрокер, НачальныйОстатокСистема, КонечныйОстатокБрокер, КонечныйОстатокСистема");
		ЗаполнитьЗначенияСвойств(НовыйРезультат, РасшифровкаСверкиДС);
		Результат.РасшифровкаСверкиДС.Добавить(НовыйРезультат);
	КонецЦикла;
	
	РасшифровкаСверкиЦБ = РезультатЗапроса[21].Выбрать();
	
	Пока РасшифровкаСверкиЦБ.Следующий() Цикл
		НовыйРезультат = Новый Структура("ИмяФайла, ИдентификаторСтроки, СчетДоверительногоУправления, ЦеннаяБумага, НачальныйОстатокБрокер, НачальныйОстатокСистема, КонечныйОстатокБрокер, КонечныйОстатокСистема");
		ЗаполнитьЗначенияСвойств(НовыйРезультат, РасшифровкаСверкиЦБ);
		Результат.РасшифровкаСверкиЦБ.Добавить(НовыйРезультат);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СверитьДанныеСОтчетамиБрокера()
	
	ОбрабатываемыеОтчеты = Объект.ОтчетыБрокера.НайтиСтроки(Новый Структура("Обработать", Истина));
	
	ДанныеОтчетов = Новый Структура;
	
	ДанныеОтчетов.Вставить("ОстаткиДС", Новый Массив);
	ДанныеОтчетов.Вставить("ОстаткиЦБ", Новый Массив);
	
	Эксель = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
	
	Если Эксель = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Приложение MS Excel отсутствует или недостаточно прав доступа!
			|Обновление списка файлов прервано.");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(Эксель, Ложь);
	
	Для Каждого ТекОтчет Из ОбрабатываемыеОтчеты Цикл
		
		ТекОтчет.РезультатСверки = 0;
		ТекОтчет.СверкаПоДС.Очистить();
		ТекОтчет.СверкаПоЦБ.Очистить();
		
		Если НЕ ПолучитьДанныеОтчетаДляСверки(Эксель, ТекОтчет, ДанныеОтчетов) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сверка с отчетами брокера прервана из-за ошибки!");
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Эксель);
	
	Возврат ПолучитьРезультатСверки(Объект.Организация, Объект.Брокер, Объект.Дата, ДанныеОтчетов);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатСверки(РезультатСверки)
	
	Если РезультатСверки.НеопределенныеКлиенты.Количество() > 0 Тогда
		
		Сообщение = "По следующим номерам договоров не удалось определить счета доверительного управления:";
		
		Для Каждого ТекКлиент Из РезультатСверки.НеопределенныеКлиенты Цикл
			Сообщение = Сообщение + Символы.ПС + Строка(ТекКлиент);
		КонецЦикла;
		
	КонецЕсли;
	
	Если РезультатСверки.НеопределенныеЦенныеБумаги.Количество() > 0 Тогда
		
		Сообщение = "По следующим комбинациям гос. рег номера и ISIN не удалось определить ценныые бумаги:";
		
		Для Каждого ТекЦБ Из РезультатСверки.НеопределенныеЦенныеБумаги Цикл
			Сообщение = Сообщение + Символы.ПС + ТекЦБ.ГосРегНомер + "/" + ТекЦБ.ISIN;
		КонецЦикла;
		
	КонецЕсли;
	
	Если РезультатСверки.РезультатыСверки.Количество() > 0 Тогда
		
		Для Каждого ТекРезультат Из РезультатСверки.РезультатыСверки Цикл
			Объект.ОтчетыБрокера.НайтиПоИдентификатору(ТекРезультат.ИдентификаторСтроки).РезультатСверки = ?(ТекРезультат.РезультатСверки, 1, 2);
		КонецЦикла;
		
	КонецЕсли;
	
	Если РезультатСверки.РасшифровкаСверкиДС.Количество() > 0 Тогда
		
		Для Каждого ТекРезультат Из РезультатСверки.РасшифровкаСверкиДС Цикл
			ЗаполнитьЗначенияСвойств(Объект.ОтчетыБрокера.НайтиПоИдентификатору(ТекРезультат.ИдентификаторСтроки).СверкаПоДС.Добавить(), ТекРезультат);
		КонецЦикла;
		
	КонецЕсли;
	
	Если РезультатСверки.РасшифровкаСверкиЦБ.Количество() > 0 Тогда
		
		Для Каждого ТекРезультат Из РезультатСверки.РасшифровкаСверкиЦБ Цикл
			ЗаполнитьЗначенияСвойств(Объект.ОтчетыБрокера.НайтиПоИдентификатору(ТекРезультат.ИдентификаторСтроки).СверкаПоЦБ.Добавить(), ТекРезультат);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сверить(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Сверить");
	Попытка
	
		Если НЕ ПроверитьЗаполнение() Тогда
			Возврат;
		КонецЕсли;
	
		РезультатСверки = СверитьДанныеСОтчетамиБрокера();
	
		Если РезультатСверки <> Неопределено Тогда
			ПоказатьРезультатСверки(РезультатСверки);
		КонецЕсли;
	 
	Исключение
		ПараметрыСессии.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);

КонецПроцедуры

&НаСервере
Функция СформироватьОтчет(Дата, ИдентификаторСтроки)
	
	ДанныеСверки = Объект.ОтчетыБрокера.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	
	ОбластьШапка			= Макет.ПолучитьОбласть("Шапка");
	ОбластьНетРасхождений	= Макет.ПолучитьОбласть("ОбластьНетРасхождений");
	ОбластьЕстьРасхождения	= Макет.ПолучитьОбласть("ОбластьЕстьРасхождения");
	ОбластьШапкаДС			= Макет.ПолучитьОбласть("ШапкаДС");
	ОбластьСтрокаДС			= Макет.ПолучитьОбласть("СтрокаДС");
	ОбластьШапкаЦБ			= Макет.ПолучитьОбласть("ШапкаЦБ");
	ОбластьСтрокаЦБ			= Макет.ПолучитьОбласть("СтрокаЦБ");
	
	Результат = Новый ТабличныйДокумент;
	
	ОбластьШапка.Параметры.Дата							= Дата;
	ОбластьШапка.Параметры.ИмяФайла						= ДанныеСверки.ИмяФайла;
	ОбластьШапка.Параметры.СчетДоверительногоУправления	= ДанныеСверки.СчетВнутреннегоУчета;
	
	Результат.Вывести(ОбластьШапка);
	
	Если ДанныеСверки.РезультатСверки = 2 Тогда
		Результат.Вывести(ОбластьЕстьРасхождения);
	Иначе
		Результат.Вывести(ОбластьНетРасхождений);
	КонецЕсли;
	
	Если ДанныеСверки.СверкаПоДС.Количество() > 0 Тогда
		
		Результат.Вывести(ОбластьШапкаДС);
		
		Для Каждого ТекСтрока Из ДанныеСверки.СверкаПоДС Цикл
			ОбластьСтрокаДС.Параметры.Заполнить(ТекСтрока);
			Результат.Вывести(ОбластьСтрокаДС);
		КонецЦикла;
			
	КонецЕсли;
	
	Если ДанныеСверки.СверкаПоЦБ.Количество() > 0 Тогда
		
		Результат.Вывести(ОбластьШапкаЦБ);
		
		Для Каждого ТекСтрока Из ДанныеСверки.СверкаПоЦБ Цикл
			ОбластьСтрокаЦБ.Параметры.Заполнить(ТекСтрока);
			Результат.Вывести(ОбластьСтрокаЦБ);
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтчетыБрокераВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИдентификаторСтроки = Элементы.ОтчетыБрокера.ТекущиеДанные.ПолучитьИдентификатор();
	
	СтрокаСОтчетом = Объект.ОтчетыБрокера.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаСОтчетом.РезультатСверки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отчет = СформироватьОтчет(Объект.Дата, ИдентификаторСтроки);
	
	Отчет.ОтображатьСетку     = Ложь;
	Отчет.ТолькоПросмотр      = Истина;
	Отчет.ОтображатьЗаголовки = Ложь;
	
	Отчет.Показать(СтрокаСОтчетом.СчетВнутреннегоУчета);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

