&НаКлиенте
Процедура ВыполнитьКомандаИзменитьСоставОтборов(ПараметрыСессии)
	ДоступныеПоляОтбора = Новый СписокЗначений;
	ВыбранныеПоляОтбора = Новый Массив;	
	
	Отбор = ЭтаФорма.КомпоновщикНастроек.Настройки.Отбор;
	ДоступныеПоля = Отбор.ДоступныеПоляОтбора;
	
	Для каждого Элемент Из Отбор.Элементы Цикл
	    Если ЗначениеЗаполнено(Элемент.ИдентификаторПользовательскойНастройки) Тогда
			ВыбранныеПоляОтбора.Добавить(Элемент.ЛевоеЗначение);
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Элемент Из ДоступныеПоля.Элементы Цикл
		Если Не Элемент.Папка Тогда
			ДоступныеПоляОтбора.Добавить(Элемент.Поле, Элемент.Заголовок, Не ВыбранныеПоляОтбора.Найти(Элемент.Поле) = Неопределено);
		КонецЕсли; 
	КонецЦикла; 
	
	Если ДоступныеПоляОтбора.ОтметитьЭлементы() Тогда
		
		Для каждого Элемент Из ДоступныеПоляОтбора Цикл
		
			НайденныйЭлемент = НайтиСоздатьЭлементОтбора(Отбор, Новый ПолеКомпоновкиДанных(Элемент.Значение));
			
			Если Не Элемент.Пометка Тогда
				НайденныйЭлемент.Использование = Ложь;
				НайденныйЭлемент.ИдентификаторПользовательскойНастройки = "";
			КонецЕсли; 
		
		КонецЦикла; 
		ПриОбновленииСоставаПользовательскихНастроекНаСервере(Ложь);
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

