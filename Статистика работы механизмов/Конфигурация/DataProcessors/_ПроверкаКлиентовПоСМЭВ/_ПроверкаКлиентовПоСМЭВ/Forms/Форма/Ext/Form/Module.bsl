&НаКлиенте
Процедура ФизическиеЛицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = ЭтаФорма.ФизическиеЛица.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	СтандартнаяОбработка = Ложь;
	
	Если Не Элементы.ФизическиеЛицаГруппаРезультаты.ПодчиненныеЭлементы.Найти(Поле.Имя) = Неопределено Тогда
		
		Отбор = Новый Структура("ЮрФизЛицо, ВидПеречня", 
			ТекСтрока.ФизическоеЛицо,
			ПредопределенноеЗначение("Справочник.ВидыПеречнейОбъектов.СМЭВ")); 
		ПараметрыФормы = Новый Структура("Отбор", Отбор); 
		
		ОткрытьФорму("РегистрСведений.ЖурналСверкиСоСписками.ФормаСписка", ПараметрыФормы, ЭтаФорма, Истина, ЭтаФорма.Окно);
		
	ИначеЕсли Не Элементы.ФизическиеЛицаГруппаАнкетныеДанные.ПодчиненныеЭлементы.Найти(Поле.Имя) = Неопределено  Тогда
		
		ОткрытьЗначение(ТекСтрока.ФизическоеЛицо);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервереБезКонтекста
Функция ПолучитьРезультатКомпоновки(СКД, Настройки) Экспорт

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	ТипГенератора = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	ДанныеРасшифровки = Неопределено;
	
	Результат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
		
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки,,, ТипГенератора);

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	//ЗаписатьРезультатВФайлы(СКД, Настройки, МакетКомпоновки, "");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьСписокНаСервере(СброситьФлаги = Ложь)

	НайденныеСтроки = ЭтаФорма.ФизическиеЛица.НайтиСтроки(Новый Структура("Флаг", Истина));
	ВыбранныеФизЛица = ЭтаФорма.ФизическиеЛица.Выгрузить(НайденныеСтроки).ВыгрузитьКолонку("ФизическоеЛицо");
	
	СКД 		= ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСКД);
	Настройки 	= ЭтаФорма.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", 				Объект.Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", 					Объект.ДатаПроверки);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВыбранныеФизическиеЛица", 	ВыбранныеФизЛица);
	
	ТаблицаФизЛиц = ПолучитьРезультатКомпоновки(СКД, Настройки);
	
	Если СброситьФлаги Тогда
		ТаблицаФизЛиц.ЗаполнитьЗначения(Ложь, "Флаг");
	КонецЕсли; 
	
	ЭтаФорма.ФизическиеЛица.Загрузить(ТаблицаФизЛиц);

КонецПроцедуры

&НаКлиенте 
Процедура ИзменитьВсеФлаги(Флаг)
	
	Если Элементы.ФизическиеЛица.ВыделенныеСтроки.Количество() > 1 Тогда
		Для каждого Идентификатор Из Элементы.ФизическиеЛица.ВыделенныеСтроки Цикл
			ТекСтрока = ЭтаФорма.ФизическиеЛица.НайтиПоИдентификатору(Идентификатор);
			ТекСтрока.Флаг = Флаг;
		КонецЦикла; 
	Иначе
		Для каждого ТекСтрока Из ЭтаФорма.ФизическиеЛица Цикл
			Если Элементы.ФизическиеЛица.ПроверитьСтроку(ТекСтрока.ПолучитьИдентификатор()) Тогда
				ТекСтрока.Флаг = Флаг;
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДействияЭлементовОтбора(Элемент)

	МассивЭлементов = Новый Массив;
	Для каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
	
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
		
			УстановитьДействияЭлементовОтбора(ПодчиненныйЭлемент);
			
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ПолеФормы") Тогда
			
			ПодчиненныйЭлемент.УстановитьДействие("ПриИзменении", "ПолеОтбораПриИзменении");
			
			Если СтрЗаканчиваетсяНа(ПодчиненныйЭлемент.Имя, "Значение") Тогда
			
				Если ЭтаФорма.Команды.Найти(ПодчиненныйЭлемент.Имя + "ПоказатьВидСравнения") = Неопределено Тогда
				
					Команда = ЭтаФорма.Команды.Добавить(ПодчиненныйЭлемент.Имя + "ПоказатьВидСравнения");
					Команда.Действие = "ПоказатьВидСравнения";
					Команда.Заголовок = "Показать вид сравнения";					
				
				КонецЕсли; 

				Кнопка = Элементы.Добавить(ПодчиненныйЭлемент.Имя + "ПоказатьВидСравнения", Тип("КнопкаФормы"), ПодчиненныйЭлемент.КонтекстноеМеню);
				Кнопка.ИмяКоманды = ПодчиненныйЭлемент.Имя + "ПоказатьВидСравнения";
				
			ИначеЕсли СтрЗаканчиваетсяНа(ПодчиненныйЭлемент.Имя, "ВидСравненияЭлементаОтбора") Тогда
				
				//МассивЭлементов.Добавить(СтрЗаменить(ПодчиненныйЭлемент.Имя, "ВидСравненияЭлементаОтбора", ""));
				МассивЭлементов.Добавить(ПодчиненныйЭлемент);
				
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЦикла;
	
	Для каждого Элемент Из МассивЭлементов Цикл
		
		ИмяЭлемента = Элемент.Имя;
		
		НачалоИднекса = СтрДлина("КомпоновщикНастроекПользовательскиеНастройкиЭлемент")+1;
		КонецИндекса = СтрНайти(ИмяЭлемента, "ВидСравненияЭлементаОтбора");
		Индекс = Число(Сред(ИмяЭлемента, НачалоИднекса, КонецИндекса-НачалоИднекса));
		
		ЗначениеНастройки = ЭтаФорма.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[Индекс].ВидСравнения;
		ЗначениеВидимости = Не (ЗначениеНастройки = ВидСравненияКомпоновкиДанных.Равно);
				
		Элемент.Видимость = ЗначениеВидимости;
		
		ИмяКнопки = СтрЗаменить(ИмяЭлемента, "ВидСравненияЭлементаОтбора", "ЗначениеПоказатьВидСравнения");
		Кнопка = Элементы.Найти(ИмяКнопки);
		Если Не Кнопка = Неопределено Тогда
			Кнопка.Пометка = ЗначениеВидимости;
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Функция НайтиСоздатьЭлементОтбора(Отбор, Поле)

	НайденныйЭлемент = Неопределено;
	
	Для каждого Элемент Из Отбор.Элементы Цикл
		Если Элемент.ЛевоеЗначение = Поле Тогда
			НайденныйЭлемент = Элемент;
			Прервать;
		КонецЕсли; 
	КонецЦикла; 
	
	Если НайденныйЭлемент = Неопределено Тогда
		НайденныйЭлемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НайденныйЭлемент.ЛевоеЗначение = Поле;
		НайденныйЭлемент.Использование = Ложь;
	КонецЕсли; 
	
	Если НайденныйЭлемент.ИдентификаторПользовательскойНастройки = "" Тогда
		НайденныйЭлемент.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;
	КонецЕсли; 
	
	Возврат НайденныйЭлемент;

КонецФункции
 

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
 
 ОбъектОбработки = РеквизитФормыВЗначение("Объект");
 
 ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
 
 Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
 Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
  Механизм,
  ПараметрыВыполненияДляСбораСтатистики.Хранилище,
  ПараметрыВыполненияДляСбораСтатистики.Описание);
  
 ПараметрыСессии = Новый Структура;
 ПараметрыСессии.Вставить("Механизм",     Механизм);
 ПараметрыСессии.Вставить("Сессия",        Сессия);
 ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
 ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
  
 Возврат ПараметрыСессии;
 
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
 
 РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
  ПараметрыСессии.Механизм,
  ПараметрыСессии.Сессия,,
  ПараметрыСессии.ДопПараметры,
  ПараметрыСессии.ТекстОшибки);
 
КонецПроцедуры

#КонецОбласти
