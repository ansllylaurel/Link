#Область Взаимодействие_со_СМЭВ

&НаСервере 
Функция ОтправитьЗапросНаСервере()

	НайденныеСтроки = ЭтаФорма.ФизическиеЛица.НайтиСтроки(Новый Структура("Флаг", Истина));
	ОписаниеОшибки = "";
	
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		Результат = РегистрыСведений.ЖурналСверкиСоСписками.СверитьПоСМЭВ(Объект.Организация, ТекСтрока.ФизическоеЛицо);
		ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Результат;
	КонецЦикла; 
	
	Возврат Сред(ОписаниеОшибки, 2);
	
КонецФункции

&НаСервере 
Функция ПолучитьРезультатыНаСервере()

	НайденныеСтроки = ЭтаФорма.ФизическиеЛица.НайтиСтроки(Новый Структура("Флаг", Истина));
	ОписаниеОшибки = "";
	
	Если НайденныеСтроки.Количество() > 0 Тогда
	
		МассивФизЛиц = Новый Массив;
		Для каждого ТекСтрока Из НайденныеСтроки Цикл
			МассивФизЛиц.Добавить(ТекСтрока.ФизическоеЛицо);
		КонецЦикла; 
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация", 	Объект.Организация);
		Запрос.УстановитьПараметр("Период", 		Объект.ДатаПроверки);
		Запрос.УстановитьПараметр("ФизЛица", 		МассивФизЛиц);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналСверкиСоСпискамиСрезПоследних.ИдентификаторПакета КАК ИдентификаторПакета
			|ИЗ
			|	РегистрСведений.ЖурналСверкиСоСписками.СрезПоследних(&Период
			|			,
			|			Организация = &Организация
			|				И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СМЭВ)
			|				И ЮрФизЛицо В (&ФизЛица)) КАК ЖурналСверкиСоСпискамиСрезПоследних
			|ГДЕ
			|	НЕ ЖурналСверкиСоСпискамиСрезПоследних.Пройдена";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		МассивИдентификаторов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
		
		ОписаниеОшибки = РегистрыСведений.ЖурналСверкиСоСписками.ПроверитьСтатус(Объект.Организация, МассивИдентификаторов);
	
	КонецЕсли; 
	
	Возврат ОписаниеОшибки;
	
КонецФункции

#КонецОбласти 

