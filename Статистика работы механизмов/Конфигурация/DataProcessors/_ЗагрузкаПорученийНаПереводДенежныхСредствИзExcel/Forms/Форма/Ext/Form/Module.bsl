	    |	_ДанныеДляИмпортаПоручений.Валюта КАК Валюта,
	    |	_ДанныеДляИмпортаПоручений.ТипПеревода КАК ТипПеревода,
	    |	_ДанныеДляИмпортаПоручений.Срочно КАК Срочно,
	    |	_ДанныеДляИмпортаПоручений.СрочныйПереводБЭСП КАК СрочныйПереводБЭСП,
	    |	_ДанныеДляИмпортаПоручений.РасчетныйСчет КАК РасчетныйСчет,
	    |	_ДанныеДляИмпортаПоручений.БанкОткуда КАК БанкОткуда,
	    |	_ДанныеДляИмпортаПоручений.Брокер КАК Брокер,
	    |	_ДанныеДляИмпортаПоручений.БанкБрокерОткуда КАК БанкБрокерОткуда,
	    |	_ДанныеДляИмпортаПоручений.СчетСекцияОткуда КАК СчетСекцияОткуда,
	    |	_ДанныеДляИмпортаПоручений.БанкКуда КАК БанкКуда,
	    |	_ДанныеДляИмпортаПоручений.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
	    |	_ДанныеДляИмпортаПоручений.БрокерПолучатель КАК БрокерПолучатель,
	    |	_ДанныеДляИмпортаПоручений.БанкБрокерКуда КАК БанкБрокерКуда,
	    |	_ДанныеДляИмпортаПоручений.СчетСекцияКуда КАК СчетСекцияКуда,
	    |	_ДанныеДляИмпортаПоручений.Сумма КАК Сумма,
	    |	_ДанныеДляИмпортаПоручений.МестоХранения КАК МестоХранения,
	    |	_ДанныеДляИмпортаПоручений.МестоХраненияСтрокой КАК МестоХраненияСтрокой,
	    |	_ДанныеДляИмпортаПоручений.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
	    |	_ДанныеДляИмпортаПоручений.МестоХраненияПолучательСтрокой КАК МестоХраненияПолучательСтрокой,
	    |	_ДанныеДляИмпортаПоручений.БикОткуда КАК БикОткуда,
	    |	_ДанныеДляИмпортаПоручений.БикКуда КАК БикКуда,
	    |	_ДанныеДляИмпортаПоручений.СуммаОткуда КАК СуммаОткуда,
	    |	_ДанныеДляИмпортаПоручений.СуммаКуда КАК СуммаКуда,
	    |	_ДанныеДляИмпортаПоручений.ИмяБрокераИзФайла КАК БрокерИзФайла,
	    |	_ДанныеДляИмпортаПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ДанныеДляИмпортаПоручений.ПереводНаБиржу КАК ПереводНаБиржу,
	    |	НЕ _Поручения_1С.СчетДоверительногоУправления ЕСТЬ NULL КАК ФлПоручениеСоздано,
	    |	_Поручения_1С.Статус КАК Статус,
	    |	НЕ _ПорученияДляПроверкиПрямыхПереводов.НомерСтроки ЕСТЬ NULL КАК ФлПроверитьБрокера,
	    |	_ДанныеДляИмпортаПоручений.ОшибкаДубляЗаписей КАК ОшибкаДубляЗаписей,
	    |	ЛОЖЬ КАК ФлЕстьОшибки,
	    |	НЕОПРЕДЕЛЕНО КАК Ошибки
	    |ИЗ
	    |	_ДанныеДляИмпортаПоручений КАК _ДанныеДляИмпортаПоручений
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ПорученияДляПроверкиПрямыхПереводов КАК _ПорученияДляПроверкиПрямыхПереводов
	    |		ПО _ДанныеДляИмпортаПоручений.НомерСтроки = _ПорученияДляПроверкиПрямыхПереводов.НомерСтроки
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _Поручения_1С КАК _Поручения_1С
	    |		ПО _ДанныеДляИмпортаПоручений.СчетДоверительногоУправления = _Поручения_1С.СчетДоверительногоУправления
	    |			И _ДанныеДляИмпортаПоручений.РасчетныйСчет = _Поручения_1С.РасчетныйСчет
	    |			И _ДанныеДляИмпортаПоручений.Брокер = _Поручения_1С.Брокер
	    |			И _ДанныеДляИмпортаПоручений.МестоХранения = _Поручения_1С.МестоХранения
	    |			И _ДанныеДляИмпортаПоручений.МестоХраненияСтрокой = _Поручения_1С.МестоХраненияСтрокой
	    |			И _ДанныеДляИмпортаПоручений.РасчетныйСчетПолучатель = _Поручения_1С.РасчетныйСчетПолучатель
	    |			И _ДанныеДляИмпортаПоручений.БрокерПолучатель = _Поручения_1С.БрокерПолучатель
	    |			И _ДанныеДляИмпортаПоручений.МестоХраненияПолучатель = _Поручения_1С.МестоХраненияПолучатель
	    |			И _ДанныеДляИмпортаПоручений.МестоХраненияПолучательСтрокой = _Поручения_1С.МестоХраненияПолучательСтрокой
	    |			И _ДанныеДляИмпортаПоручений.СрочныйПереводБЭСП = _Поручения_1С.СрочныйПереводБЭСП
	    |			И _ДанныеДляИмпортаПоручений.Валюта = _Поручения_1С.Валюта
	    |			И _ДанныеДляИмпортаПоручений.Сумма = _Поручения_1С.Сумма
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	ФлПоручениеСоздано УБЫВ";
#КонецОбласти

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("MMVB_TPLUS", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
	Запрос.УстановитьПараметр("MMVB_FX", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	Запрос.УстановитьПараметр("MMVB_FORTS", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FORTS"));
	Запрос.УстановитьПараметр("MMVB_RTS", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС"));
	Запрос.УстановитьПараметр("ВнебиржевойРынок", ПредопределенноеЗначение("Справочник.МестаХранения.ВнебиржевойРынок"));
	Запрос.УстановитьПараметр("ДанныеФайла", ВнешниеДанные.Выгрузить());
	Запрос.УстановитьПараметр("РС_Клиентов_ИИС", ОбщегоНазначения.ПолучитьИменованныйОбъект("РС_Клиентов_ИИС")); //Если выводят деньги на счет в ГПБ-банке, для ИИС по умалчанию выбираем этот счет
	Запрос.УстановитьПараметр("Банк_ГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ГПБ"));
	Запрос.УстановитьПараметр("РоссийскийРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("ГСК_Югория", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ГСК_ЮГОРИЯ"));
	
	ТаблицаРезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Инд = 1 - ТаблицаРезультатЗапроса.Количество() По 0 Цикл
		
		СтрокаДанныхДляПоручения = ТаблицаРезультатЗапроса[-Инд];
		НомерСтроки = Формат(СтрокаДанныхДляПоручения.НомерСтроки, "ЧГ=");
		
		СтрокаДанныхДляПоручения.Ошибки = Новый Массив;
		
		Если СтрокаДанныхДляПоручения.ДатаПоручения > ПлюсОдинРабочийДень Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла некорректно указана дата поручения [" + Формат(СтрокаДанныхДляПоручения.ДатаПоручения, "ДФ=dd.MM.yyyy") + "]. Дата поручения не может быть больше даты следующего рабочего дня [" + Формат(ПлюсОдинРабочийДень, "ДФ=dd.MM.yyyy") + "].");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.КодСчета) Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла не указан код счета 1С. Проверьте данные в файле.");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.КодСчета) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.СчетДоверительногоУправления) Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Не удалось определить клиента по коду счета 1С [" + СтрокаДанныхДляПоручения.КодСчета  + "] в строке [" + НомерСтроки + "] файла.");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БикОткуда) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БанкОткуда) Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Для счета ДУ [" + СтрокаДанныхДляПоручения.СчетДоверительногоУправления  + "] в исполнителях по денежным средствам не удалось найти расчетный счет в валюте [" + СтрокаДанныхДляПоручения.Валюта + "] по коду БИК банка [" + СтрокаДанныхДляПоручения.БикОткуда + "] в строке [" + НомерСтроки + "] файла.");	
		КонецЕсли;
		
		Если СтрокаДанныхДляПоручения.СуммаОткуда + СтрокаДанныхДляПоручения.СуммаКуда <> 0 Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла сумма откуда [" + СтрокаДанныхДляПоручения.СуммаОткуда + "] не соответсвует сумме куда [" + СтрокаДанныхДляПоручения.СуммаКуда + "]. Проверьте данные в файле.");	
		КонецЕсли;
		
		Если СтрокаДанныхДляПоручения.Сумма = 0 Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла не удалось определить сумму перевода. Проверьте данные в файле.");	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БикОткуда) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.СчетСекцияОткуда) // если не указан БИК банка или не указан брокер (указан криво)
			Или Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БикКуда) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.СчетСекцияКуда) Тогда
			
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла не удалось определить банк/брокера. Проверьте данные в файле.");
	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БикКуда) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БанкКуда) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Для счета ДУ [" + СтрокаДанныхДляПоручения.СчетДоверительногоУправления  + "] в исполнителях по денежным средствам не удалось найти расчетный счет в валюте [" + СтрокаДанныхДляПоручения.Валюта + "] по коду БИК банка [" + СтрокаДанныхДляПоручения.БикКуда + "] в строке [" + НомерСтроки + "] файла.");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.Валюта) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла не указана валюта.");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.ВалютаКод) И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.Валюта) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Не удалось определить валюту по наименованию [" + СтрокаДанныхДляПоручения.ВалютаКод + "] в строке [" + НомерСтроки + "] файла.");	
		КонецЕсли;
		
		Если СтрокаДанныхДляПоручения.ТипПеревода = 2 И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.Брокер) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла некорректно указан тип [новый перевод = 2]. Для загрузки НТП сумма должна списываться с биржевых/брокерских секций.");	
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.БрокерПолучатель) Тогда
			
			Если РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", СтрокаДанныхДляПоручения.ДатаПоручения, Организация, СтрокаДанныхДляПоручения.БрокерПолучатель), "Брокер")
				И Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.РасчетныйСчетПолучатель) Тогда
				
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла для брокера [" + СтрокаДанныхДляПоручения.БрокерПолучатель + "] требуется детализация по расчетному счету. Поручение не будет сформировано.");
				
			КонецЕсли;
			
			//по некоторым портфелям ввод на биржу/брокера осуществляется только через внебиржу брокера.
			Если СтрокаДанныхДляПоручения.ФлПроверитьБрокера И РаботаСДокументами.НеобходимКонтрольПереводовБрокера(СтрокаДанныхДляПоручения.БрокерПолучатель) Тогда 	
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] некорректно указана секция-получатель [" + СтрокаДанныхДляПоручения.СчетСекцияКуда + "]. Для клиента [" + СтрокаДанныхДляПоручения.СчетДоверительногоУправления + "] переводы должны осуществляться через внебиржевую секцию брокера. Поручение не будет сформировано.");
			КонецЕсли;
			
			//если перевод с расчетного счета на брокера - должен быть заполнен счет получатель (даже если детализация не нужна)
			Если Не (ЗначениеЗаполнено(СтрокаДанныхДляПоручения.Брокер) Или ЗначениеЗаполнено(СтрокаДанныхДляПоручения.РасчетныйСчетПолучатель)) Тогда	
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла не удалось определить расчетный счет получателя для перевода на секцию [" + СтрокаДанныхДляПоручения.СчетСекцияКуда + "] брокера [" + СтрокаДанныхДляПоручения.БрокерПолучатель + "]. Поручение не будет сформировано.");
			КонецЕсли;
						
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаДанныхДляПоручения.Брокер) Тогда
			
			Если ТекущаяДата <> СтрокаДанныхДляПоручения.ДатаПоручения Тогда	
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] некорректно указана дата поручения [" + Формат(СтрокаДанныхДляПоручения.ДатаПоручения, "ДФ=dd.MM.yyyy") + "]. НТП должны создаваться день в день. Поручение не будет сформировано.");
			КонецЕсли;
			
			Если РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", СтрокаДанныхДляПоручения.ДатаПоручения, Организация, СтрокаДанныхДляПоручения.Брокер), "Брокер") Тогда	
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] файла для брокера [" + СтрокаДанныхДляПоручения.Брокер + "] требуется детализация по расчетному счету. Поручение не будет сформировано.");
			КонецЕсли;
			
			//по некоторым портфелям вывод с биржи/брокера на расчетные счета осуществляется только через внебиржу брокера.
			Если СтрокаДанныхДляПоручения.ФлПроверитьБрокера И РаботаСДокументами.НеобходимКонтрольПереводовБрокера(СтрокаДанныхДляПоручения.Брокер) Тогда 	
				СтрокаДанныхДляПоручения.Ошибки.Добавить("В строке [" + НомерСтроки + "] некорректно указана секция-получатель [" + СтрокаДанныхДляПоручения.СчетСекцияОткуда + "]. Для клиента [" + СтрокаДанныхДляПоручения.СчетДоверительногоУправления + "] переводы должны осуществляться через внебиржевую секцию брокера. Поручение не будет сформировано.");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.МестоХранения) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Не удалось определить Место хранения в строке файла [" + НомерСтроки + "]. Поручение не будет сформировано.");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанныхДляПоручения.МестоХраненияПолучатель) Тогда	
			СтрокаДанныхДляПоручения.Ошибки.Добавить("Не удалось определить Место хранения получателя в строке файла [" + НомерСтроки + "]. Поручение не будет сформировано.");
		КонецЕсли;
		
		Если СтрокаДанныхДляПоручения.ОшибкаДубляЗаписей Тогда
			СтрокаДанныхДляПоручения.Ошибки.Добавить("В файле обнаружены дубли записей. Строка файла [" + НомерСтроки + "]. Клиент [" + СтрокаДанныхДляПоручения.СчетДоверительногоУправления + "], сумма поручения " + ?(СтрокаДанныхДляПоручения.СуммаКуда > 0, СтрокаДанныхДляПоручения.СуммаКуда, -СтрокаДанныхДляПоручения.СуммаКуда)  + " " + СтрокаДанныхДляПоручения.ВалютаКод + ". Поручение не будут сформировано.");
		КонецЕсли;
		
		СтрокаДанныхДляПоручения.ФлЕстьОшибки = (СтрокаДанныхДляПоручения.Ошибки.Количество() > 0);

	КонецЦикла;
		
	ЭтаФорма.ВнешниеДанные.Загрузить(ТаблицаРезультатЗапроса); 	
				
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеФлажкиТекущейТаблицы(Флаг)
	
	Для Каждого СтрокаТаблицыДанных Из ЭтотОбъект.ВнешниеДанные Цикл
		
		ИдСтроки = СтрокаТаблицыДанных.ПолучитьИдентификатор(); 
			
		Если СтрокаТаблицыДанных.ФлПоручениеСоздано Тогда
						
			СтрокаТаблицыДанных.СоздатьПоручение = Ложь;
			
		ИначеЕсли Элементы.ВнешниеДанные.ВыделенныеСтроки.Найти(ИдСтроки) <> Неопределено 
			И Элементы.ВнешниеДанные.ПроверитьСтроку(ИдСтроки) Тогда

			СтрокаТаблицыДанных.СоздатьПоручение = Флаг;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменитьНадписьДекорации();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеФлажки(Команда)
	
	ИзменитьВсеФлажкиТекущейТаблицы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсеФлажки(Команда)
	
	ИзменитьВсеФлажкиТекущейТаблицы(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешниеДанныеПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент.Имя = "ВнешниеДанныеСоздатьПоручение" Тогда
			
		Если ТекущиеДанные.ФлПоручениеСоздано Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету " + ТекущиеДанные.СчетДоверительногоУправления  + " уже создано поручение на сумму " + ТекущиеДанные.Сумма + " " + ТекущиеДанные.Валюта);		
		Иначе
			ТекущиеДанные.СоздатьПоручение = Не ТекущиеДанные.СоздатьПоручение;
		КонецЕсли;
			
	КонецЕсли;
	
	Отказ = Истина;
	
	ИзменитьНадписьДекорации();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешниеДанныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные.ФлЕстьОшибки Тогда		
		СтандартнаяОбработка = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ТекущиеДанные.Ошибки, Символы.ПС),, "ВнешниеДанные[" + ЭтотОбъект.ВнешниеДанные.Индекс(ТекущиеДанные) + "].СчетДоверительногоУправления");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПереводаПриИзменении(Элемент)
	
	ИзменитьОтборСтрок();
	ИзменитьНадписьДекорации();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ИзменитьОтборСтрок();
	ИзменитьНадписьДекорации();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтборСтрок(ОчиститьОтбор = Ложь);
	
	ПоляОтбора = "";
	
	Если ОчиститьОтбор Тогда
		
		ЭтаФорма.ДатаПоручения = Дата(1, 1, 1);
		ЭтаФорма.ТипПеревода = 0;
		
	Иначе
	
		Если ЗначениеЗаполнено(ЭтаФорма.ДатаПоручения) Тогда
			
			ПоляОтбора = ?(ПоляОтбора = "", "", ПоляОтбора + ", ") + "ДатаПоручения";
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.ТипПеревода) Тогда
			
			ПоляОтбора = ?(ПоляОтбора = "", "", ПоляОтбора + ", ") + "ТипПеревода";
			
		КонецЕсли;
		
	КонецЕсли;
		
	СтруктураОтбора = Новый Структура(ПоляОтбора);
	
	Для Каждого ЭлементОтбора Из СтруктураОтбора Цикл
		
		СтруктураОтбора[ЭлементОтбора.Ключ] = ЭтаФорма[ЭлементОтбора.Ключ];
		
	КонецЦикла;

	Элементы.ВнешниеДанные.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНадписьДекорации() 
	
	ВсегоПоручений = 0;
	ВыбраноДляСоздания = 0;
	СозданоПоручений = 0;
	ОшибкиПоручений = 0;
	
	Для Каждого СтрокаТаблицыДанных Из ЭтотОбъект.ВнешниеДанные Цикл
		
		Если Элементы.ВнешниеДанные.ПроверитьСтроку(СтрокаТаблицыДанных.ПолучитьИдентификатор()) Тогда
			
			ВсегоПоручений = ВсегоПоручений + 1;
			
			Если СтрокаТаблицыДанных.ФлПоручениеСоздано Тогда
				СозданоПоручений = СозданоПоручений + 1;	
			КонецЕсли; 
			
			Если СтрокаТаблицыДанных.ФлЕстьОшибки Тогда
				ОшибкиПоручений = ОшибкиПоручений + 1;	
			КонецЕсли;
			
			Если СтрокаТаблицыДанных.СоздатьПоручение Тогда
				ВыбраноДляСоздания = ВыбраноДляСоздания + 1;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСтрок = Новый Массив;
	
	Если ВыбраноДляСоздания > 0 Тогда
		МассивСтрок.Добавить("выбрано: " + ВыбраноДляСоздания + " шт.");
	КонецЕсли;
	
	Если СозданоПоручений > 0 Тогда
		МассивСтрок.Добавить("создано: " + СозданоПоручений + " шт.");
	КонецЕсли;
	
	Если ОшибкиПоручений > 0 Тогда
		МассивСтрок.Добавить("поручения с ошибками: " + ОшибкиПоручений + " шт.");
	КонецЕсли;
	 
	ЭтаФорма.Элементы.ВнешниеДанныеСчетчикПоручений.Заголовок = "Всего поручений: " + ВсегоПоручений + " шт. " + ?(МассивСтрок.Количество() = 0, "", "(" + СтрСоединить(МассивСтрок, ", ") + ")");
			
КонецПроцедуры 

&НаКлиенте
Процедура ВывестиСообщенияОбОшибках()
	
	Для Каждого СтрокаТаблицыДанных Из ЭтотОбъект.ВнешниеДанные Цикл
		
		Если СтрокаТаблицыДанных.ФлЕстьОшибки Тогда	 			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(СтрокаТаблицыДанных.Ошибки, Символы.ПС),, "ВнешниеДанные[" + ЭтотОбъект.ВнешниеДанные.Индекс(СтрокаТаблицыДанных) + "].СчетДоверительногоУправления");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	
#КонецОбласти

