
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	// начальное заполнение формы
	Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		КодУК = "рэм";
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить код УК. Для организации [" + Организация + "] загрузка поручений не поддерживается.",,,, Отказ);	
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
	
		Файл = Новый Файл(ИмяФайла);
		Если Файл.Существует() Тогда
			
			Состояние("Выполняется чтение файла..");
			ПрочитатьФайл(Неопределено);
		
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls;*.xlsx)|*.xls;*.xlsx";

	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД 
 
&НаКлиенте
Процедура ПрочитатьФайл(Команда) 
	
	Если НЕ ЗначениеЗаполнено(КодУК) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить код УК");
		Возврат;
	КонецЕсли; 
	
	Если ВнешниеДанные.Количество() > 0
		И Вопрос("Параметры отбора и табличная часть будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ВнешниеДанные.Очистить(); 
	
	Состояние("Чтение файла.."); 
	
	ВременныйАдресФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	//копирование защищает от ошибки совместного доступа к файлу-исходнику
	КопироватьФайл(ЭтаФорма.ИмяФайла, ВременныйАдресФайла);
	
	БинарныйФайл = Новый ДвоичныеДанные(ВременныйАдресФайла);
	АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(БинарныйФайл); 
	
	ПрочитатьДанныеНаСервере(АдресФайлаВХранилище);

    Если ВнешниеДанные.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют новые поручения для загрузки!");
	Иначе
		ИзменитьОтборСтрок(Истина);
		ВывестиСообщенияОбОшибках();
	КонецЕсли;
	
	ИзменитьНадписьДекорации();
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, НомерПоследнойСтроки)
	
	Если НомерПоследнойСтроки <= НомерПервойСтроки + 1 Тогда
		Возврат НомерПоследнойСтроки;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Лист.Область(НомерПоследнойСтроки, 1).Текст) Тогда
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПоследнойСтроки, Окр(НомерПоследнойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));
	Иначе
		НомерСтроки = ПолучитьНомерПоследнейСтрокиЗаписей(Лист, НомерПервойСтроки, Окр(НомерПервойСтроки + ((НомерПоследнойСтроки - НомерПервойСтроки) / 2), 0, 1));	
	КонецЕсли;
	
	Возврат НомерСтроки;
	
КонецФункции

&НаСервере
Процедура ПрочитатьДанныеНаСервере(АдресФайлаВХранилище) 
	
	ТекущаяДата = НачалоДня(ТекущаяДата());
		
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");

	БинарныйФайл = ПолучитьИзВременногоХранилища(АдресФайлаВХранилище);
	БинарныйФайл.Записать(ИмяВременногоФайла);    
	
	ДанныеТабличногоДокумента = Новый ТабличныйДокумент;
	ДанныеТабличногоДокумента.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	Для Каждого ОбластьДокумента Из ДанныеТабличногоДокумента.Области Цикл
				
		Если ОбластьДокумента.Имя = "Лист1" Тогда
			
			ТабличныйДокументПриемник = Новый ТабличныйДокумент; 
			
			ЛистДокумента = ДанныеТабличногоДокумента.ПолучитьОбласть(ОбластьДокумента.Имя);
			
			ТабличныйДокументПриемник.ВставитьОбласть(ЛистДокумента.Область(7, 1, 7, 29), ТабличныйДокументПриемник.Область(1, 1, 1, 29));
			
			//Проверим шапку таб части документа                                                                  
			Если Не ПоляТаблицыСоответствуютФормату(ТабличныйДокументПриемник, Истина) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла!",, "ИмяФайла");
				Возврат;
			КонецЕсли;
		
			//С 8-ой строки начинаются табличные данные
			НомерПервойСтрокиЗаписей = 8;
			НомерПоследнейСтрокиЗаписей = ПолучитьНомерПоследнейСтрокиЗаписей(ЛистДокумента, НомерПервойСтрокиЗаписей, ЛистДокумента.ВысотаТаблицы);
				
			Для Индекс = 0 - НомерПоследнейСтрокиЗаписей По НомерПервойСтрокиЗаписей Цикл
				
				НомерСтроки = -Индекс;
				
				ТекЯчейка = ЛистДокумента.Область(НомерСтроки, 1);
				
				Если ЗначениеЗаполнено(ТекЯчейка.Текст) 
					И ТипЗнч(ТекЯчейка.Значение) = Тип("Дата") Тогда
						
					Если ТекЯчейка.Значение = ТекущаяДата Тогда
						НомерПервойСтрокиЗаписей = НомерСтроки;
					ИначеЕсли ТекЯчейка.Значение < ТекущаяДата Тогда
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
						
			КонецЦикла;
						
			Если НомерПервойСтрокиЗаписей <> 8 Тогда
				
				ОбластьДанных = ЛистДокумента.Область(НомерПервойСтрокиЗаписей, 1, НомерПоследнейСтрокиЗаписей, 29);
				
				//количество строк из "ОбластьДанных"  (шапка таблицы)  
				НомерПоследнейСтрокиПриемника = (НомерПоследнейСтрокиЗаписей - НомерПервойСтрокиЗаписей) + 2;  
				
				ТабличныйДокументПриемник.ВставитьОбласть(ОбластьДанных, ТабличныйДокументПриемник.Область(2, 1, НомерПоследнейСтрокиПриемника, 29));
				
				ИсточникОбластьЯчеек = ТабличныйДокументПриемник.Область(1, 1, ТабличныйДокументПриемник.ВысотаТаблицы, 29);
				
				ПостроительЗапроса = Новый ПостроительЗапроса;
				ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ИсточникОбластьЯчеек);
				ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
				ПостроительЗапроса.ЗаполнитьНастройки();
				ПостроительЗапроса.Выполнить();
				
				ТаблицаДанных = ПостроительЗапроса.Результат.Выгрузить();
				
				НомерСтроки = НомерПервойСтрокиЗаписей - 1;

				Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
					
					НомерСтроки = НомерСтроки + 1;
					//Поле "Новый перевод".
					//1 - перевод с расчетного счета на биржу
					//2 - НТП. переводы между площадками брокера, площадками биржы, переводы с биржи (брокера) на расчетный счет
					//3 - переводы с расчетного счета / на расчетный счет.
					Если Не (ТипЗнч(СтрокаДанных.НовыйПеревод) = Тип("Число") И (СтрокаДанных.НовыйПеревод = 1 Или СтрокаДанных.НовыйПеревод = 2 Или СтрокаДанных.НовыйПеревод = 3)) Тогда
						Продолжить;
					КонецЕсли;
					//НТП загружаем только в текущем дне.
					Если СтрокаДанных.НовыйПеревод = 2 И СтрокаДанных.Дата <> ТекущаяДата Тогда
						Продолжить;	
					КонецЕсли;
					//Поле "УК"
					Если Не (ЗначениеЗаполнено(СтрокаДанных.УК) И Нрег(СтрокаДанных.УК) = НРег(ЭтотОбъект.КодУК)) Тогда
						Продолжить;
					КонецЕсли;
					
					//Поле "Брокер"
					Если ЗначениеЗаполнено(СтрокаДанных.Брокер)
						И Не (ВРег(СтрокаДанных.Брокер) = "БК" Или ВРег(СтрокаДанных.Брокер) = "ГПБ") Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] в поле Брокер указано некорректное значения [" + СтрокаДанных.Брокер + "].",, "ИмяФайла");	
						Продолжить;
					КонецЕсли;
					//переводы с/на брокера ГПБ осуществляем с/на Т+. Если это не перевод с р/с на р/с
					Если ВРег(СтрокаДанных.Брокер) = "ГПБ"
						И Не (ЗначениеЗаполнено(СтрокаДанных.Сумма1) И ЗначениеЗаполнено(СтрокаДанных.Сумма2))  
						И Не (ЗначениеЗаполнено(СтрокаДанных.ФондоваяТПлюс) И ТипЗнч(СтрокаДанных.ФондоваяТПлюс) = Тип("Число")) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] некорректно указаны данные перевода. Переводы брокера [" + ВРег(СтрокаДанных.Брокер) + "] должны осуществляться с/на раздел [Биржа(Фондовая Т+)].",, "ИмяФайла");	
					КонецЕсли;
					//Если заполнен "БИК", но не указана сумма
					Если ЗначениеЗаполнено(СтрокаДанных.БИК) И Не (ЗначениеЗаполнено(СтрокаДанных.Сумма1) И ТипЗнч(СтрокаДанных.Сумма1) = Тип("Число")) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] в поле [Сумма 1] указано некорректное значение.",, "ИмяФайла");
						Продолжить;
					КонецЕсли;
					
					Если СтрокаДанных.НовыйПеревод = 1 И (Не ЗначениеЗаполнено(СтрокаДанных.Сумма1) Или ТипЗнч(СтрокаДанных.Сумма1) <> Тип("Число") Или СтрокаДанных.Сумма1 > 0) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] у поручения [Тип = 1] в поле [Сумма 1] указано некорректное значение.",, "ИмяФайла");
						Продолжить;
					КонецЕсли;
					
					Если СтрокаДанных.НовыйПеревод = 3 
						И Не (ЗначениеЗаполнено(СтрокаДанных.Сумма1) И ТипЗнч(СтрокаДанных.Сумма1) = Тип("Число") И ЗначениеЗаполнено(СтрокаДанных.Сумма2) И ТипЗнч(СтрокаДанных.Сумма2) = Тип("Число")) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] у поручения [Тип = 3] в полях [Сумма 1] и [Сумма 2] указаны некорректные значение.",, "ИмяФайла");
						Продолжить;
					КонецЕсли;

					//Поле "КодСчета" брокера
					Если Не ЗначениеЗаполнено(СтрокаДанных.КодСчета) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] в поле [Код счета] отсутствуют данные.",, "ИмяФайла");
						Продолжить;	
					КонецЕсли;

					Если ЗначениеЗаполнено(СтрокаДанных.БИК2) И Не (ЗначениеЗаполнено(СтрокаДанных.Сумма2) И ТипЗнч(СтрокаДанных.Сумма2) = Тип("Число")) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке [" + (НомерСтроки) + "] в поле [Сумма 2] указано некорректное значение.",, "ИмяФайла");
						Продолжить;
					КонецЕсли;

					НоваяСтрокаВнешниеДанные = ВнешниеДанные.Добавить();
						
					НоваяСтрокаВнешниеДанные.НомерСтроки   = НомерСтроки;
					НоваяСтрокаВнешниеДанные.ДатаПоручения = СтрокаДанных.Дата;
					НоваяСтрокаВнешниеДанные.УК            = СтрокаДанных.УК;
					НоваяСтрокаВнешниеДанные.КодУБрокера   = Формат(СтрокаДанных.Код, "ЧГ=0");
					НоваяСтрокаВнешниеДанные.ВалютаКод     = СтрокаДанных.Валюта;
					НоваяСтрокаВнешниеДанные.ТипПеревода   = СтрокаДанных.НовыйПеревод;
					НоваяСтрокаВнешниеДанные.БрокерИзФайла = ВРег(СтрокаДанных.Брокер);
					НоваяСтрокаВнешниеДанные.КодСчета      = СокрЛП(СтрокаДанных.КодСчета);
					НоваяСтрокаВнешниеДанные.Срочно	       = (ТипЗнч(СтрокаДанных.Срочно) = Тип("Число") И СтрокаДанных.Срочно = 1);
					НоваяСтрокаВнешниеДанные.СрочныйПереводБЭСП = (ТипЗнч(СтрокаДанных.БЭСП) = Тип("Число") И СтрокаДанных.БЭСП = 1);

					//расчетные 1
					Если ЗначениеЗаполнено(СтрокаДанных.Сумма1) И ТипЗнч(СтрокаДанных.Сумма1) = Тип("Число") Тогда
						
						Если СтрокаДанных.Сумма1 > 0 Тогда
							
							НоваяСтрокаВнешниеДанные.СуммаКуда = НоваяСтрокаВнешниеДанные.СуммаКуда + СтрокаДанных.Сумма1;	
							НоваяСтрокаВнешниеДанные.БикКуда = СокрЛП(СтрокаДанных.БИК);
							
						ИначеЕсли СтрокаДанных.Сумма1 < 0 Тогда
							
							НоваяСтрокаВнешниеДанные.СуммаОткуда = НоваяСтрокаВнешниеДанные.СуммаОткуда + СтрокаДанных.Сумма1;	
					    	НоваяСтрокаВнешниеДанные.БикОткуда = СокрЛП(СтрокаДанных.БИК);
							
						КонецЕсли;
						
					КонецЕсли;
					//расчетные 2
					Если ЗначениеЗаполнено(СтрокаДанных.Сумма2) И ТипЗнч(СтрокаДанных.Сумма2) = Тип("Число") Тогда
						
						Если СтрокаДанных.Сумма2 > 0 Тогда
							
							НоваяСтрокаВнешниеДанные.СуммаКуда = НоваяСтрокаВнешниеДанные.СуммаКуда + СтрокаДанных.Сумма2;
							НоваяСтрокаВнешниеДанные.БикКуда = СокрЛП(СтрокаДанных.БИК2);	
							
						ИначеЕсли СтрокаДанных.Сумма2 < 0 Тогда
							
							НоваяСтрокаВнешниеДанные.СуммаОткуда = НоваяСтрокаВнешниеДанные.СуммаОткуда + СтрокаДанных.Сумма2;	
					    	НоваяСтрокаВнешниеДанные.БикОткуда = СокрЛП(СтрокаДанных.БИК2);
							
						КонецЕсли;
						
					КонецЕсли;
					//биржевые, внебиржевые секции
					Для НомерПоля = 16 По 21 Цикл
						
						ТекЗначение = СтрокаДанных[ТаблицаДанных.Колонки[НомерПоля].Имя]; 
						
						Если ЗначениеЗаполнено(ТекЗначение) И ТипЗнч(ТекЗначение) = Тип("Число") Тогда
							
							Если ТекЗначение > 0 Тогда
								
								НоваяСтрокаВнешниеДанные.СуммаКуда = НоваяСтрокаВнешниеДанные.СуммаКуда + ТекЗначение;
								НоваяСтрокаВнешниеДанные.СчетСекцияКуда = Строка(НомерПоля);
								НоваяСтрокаВнешниеДанные.ПереводНаБиржу = (НомерПоля < 19); // 16, 17, 18 - биржевые секции (Т+, Валютная, FORTS)
								
							ИначеЕсли ТекЗначение < 0 Тогда
								
								НоваяСтрокаВнешниеДанные.СуммаОткуда = НоваяСтрокаВнешниеДанные.СуммаОткуда + ТекЗначение;
								НоваяСтрокаВнешниеДанные.СчетСекцияОткуда = Строка(НомерПоля);
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЦикла;
					
		   	КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ВнешниеДанные.Количество() > 0 Тогда
		ЗаполнитьДаннымиБазыНаСервере(ТекущаяДата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоручения(Команда) 
			
	Для Каждого СтрокаТаблицыДанных Из ЭтотОбъект.ВнешниеДанные Цикл
		
		Если СтрокаТаблицыДанных.СоздатьПоручение И Не Элементы.ВнешниеДанные.ПроверитьСтроку(СтрокаТаблицыДанных.ПолучитьИдентификатор()) Тогда
			СтрокаТаблицыДанных.СоздатьПоручение = Ложь;	
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСтрок = ЭтотОбъект.ВнешниеДанные.НайтиСтроки(Новый Структура("СоздатьПоручение", Истина));
	
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют поручения для загрузки");
	Иначе
		
		СоздатьПорученияНаСервере();
		
		ВывестиСообщенияОбОшибках();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка завершена.");
		Оповестить("ПорученияНаПереводДС.Обновить");	
		ОповеститьОбИзменении(Тип("ДокументСсылка.ПоручениеНаПереводДенежныхСредств"));
		
		ИзменитьНадписьДекорации();
		
	КонецЕсли;
					
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура СоздатьПорученияНаСервере()
	
	ТекДата = ТекущаяДатаСеанса(); 
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура("Организация, Дата", Организация, ТекДата), "Организация, Дата");
	Механизм = "ВнешняяОбработка._ЗагрузкаПорученийНаПереводДенежныхСредствИзExcel.Форма.СоздатьПорученияНаСервере()";
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПорученияДляЗагрузки = ЭтотОбъект.ВнешниеДанные.Выгрузить(ЭтотОбъект.ВнешниеДанные.НайтиСтроки(Новый Структура("СоздатьПоручение", Истина)), 
																"ДатаПоручения,СчетДоверительногоУправления,РасчетныйСчет,РасчетныйСчетПолучатель,Сумма,Валюта,
																|Брокер,БрокерПолучатель,МестоХранения,МестоХраненияПолучатель,МестоХраненияСтрокой,ТипПеревода,
																|МестоХраненияПолучательСтрокой,СрочныйПереводБЭСП,Срочно");
	
	ПорученияДляЗагрузки.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаПереводДенежныхСредств"));
	
	Для НомСтр = 1 - ПорученияДляЗагрузки.Количество() По 0 Цикл
		
		СтрокаПоручения = ПорученияДляЗагрузки[-НомСтр];
			
		ПоручениеНаПеревод = Документы.ПоручениеНаПереводДенежныхСредств.СоздатьДокумент();
				
		ЗаполнитьЗначенияСвойств(ПоручениеНаПеревод, СтрокаПоручения);
		
		ПоручениеНаПеревод.Организация   = Организация;
		ПоручениеНаПеревод.Дата          = ТекДата;
		ПоручениеНаПеревод.Ответственный = РаботаСПользователями.ТекущийПользователь();
		ПоручениеНаПеревод.ДополнительныеСвойства.Вставить("ПлановоеВремяЗапускаФормированияОповещения", ТекДата + 300);
		
		Если СтрокаПоручения.Срочно Тогда
			ПоручениеНаПеревод.ДополнительныеСвойства.Вставить("Срочно");
		КонецЕсли;

		//Поручения могут загружаться на дату Т+1
		Если ПоручениеНаПеревод.Дата < СтрокаПоручения.ДатаПоручения Тогда
			ПоручениеНаПеревод.Дата = СтрокаПоручения.ДатаПоручения;	
		КонецЕсли;
						
		Если Не ПоручениеНаПеревод.ПроверитьЗаполнение() Тогда
			
			ВывестиСообщенияПользователю();                   			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать Поручение на перевод денежных средств по клиенту " + СокрЛП(СтрокаПоручения.СчетДоверительногоУправления) + ".");
			
			Продолжить;

		КонецЕсли;
					
		Попытка	
			ПоручениеНаПеревод.Записать(РежимЗаписиДокумента.Проведение);	
		Исключение	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести Поручение на перевод денежных средств по клиенту " + СокрЛП(СтрокаПоручения.СчетДоверительногоУправления) + ". " + ОписаниеОшибки());	
		КонецПопытки;
				
	КонецЦикла;
				
	ВывестиСообщенияПользователю();
	
	ЗаполнитьДаннымиБазыНаСервере(НачалоДня(ТекДата));
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиСообщенияПользователю()
	
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Для Каждого ТекСообщение Из МассивСообщений Цикл
		
		Если ТекСообщение.Текст = "" Тогда
			Продолжить;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекСообщение.Текст);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПоляТаблицыСоответствуютФормату(ДанныеФайла, НовыйФормат = Ложь)
	
	ПоляТаблицыСоответствуютФормату = Истина;
	ИменаПолей = "ДАТА,ВРЕМЯ,УК,КЛИЕНТ,КОД,ВАЛЮТА,НОВЫЙ ПЕРЕВОД,СРОЧНО,БЭСП,БАНК 1,БИК,СУММА 1,БАНК 2,БИК,СУММА 2,БРОКЕР,ФОНДОВАЯ Т+,ВАЛЮТНАЯ,FORTS,ОСНОВНОЙ,ВАЛЮТНЫЙ_V,_VN,МНТП,КОММЕНТАРИИ,% СЧА,УПРАВЛЯЮЩИЙ,ОСОБЕННОСТИ,ДОП.ОТПРАВКА (ДА),КОД СЧЕТА";
	ПоляШапки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолей, ",", Истина, Истина);
	
	Если НовыйФормат Тогда
		
		Для НомерПоля = 0 По ПоляШапки.Количество() - 1 Цикл
			
			ЗначениеЯчейки = СокрЛП(Врег(ДанныеФайла.Область(1, НомерПоля + 1).Текст));
			
			Если ПоляШапки[НомерПоля] <> ЗначениеЯчейки Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найдено поле шапки """ + ПоляШапки[НомерПоля] + """'"));
				ПоляТаблицыСоответствуютФормату = Ложь;
			КонецЕсли;
			
			Если НомерПоля = 13 Тогда
				ДанныеФайла.Область(1, НомерПоля + 1).Текст = "БИК2";	
			ИначеЕсли НомерПоля = 16 Тогда
				ДанныеФайла.Область(1, НомерПоля + 1).Текст = "ФондоваяТПлюс";
			КонецЕсли;
				
		КонецЦикла; 
		
	Иначе
	
		Для НомерПоля = 0 По ПоляШапки.Количество() - 1 Цикл
			
			Если ПоляШапки[НомерПоля] <> СокрЛП(ВРег(ДанныеФайла[НомерПоля][6])) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найдено поле шапки """ + ПоляШапки[НомерПоля] + """'"));
				ПоляТаблицыСоответствуютФормату = Ложь;
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПоляТаблицыСоответствуютФормату;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСекциюПоИндексуПоля(Индекс)
		
	Если Индекс = 17 Тогда
		Возврат "Биржа(Фондовая Т+)";
	ИначеЕсли Индекс = 18 Тогда 
		Возврат "Биржа(Валютная)";
	ИначеЕсли Индекс = 19 Тогда
		Возврат "Биржа(FORTS)";
	ИначеЕсли Индекс = 20 Тогда
		Возврат "Внебиржа(Основная)";
	ИначеЕсли Индекс = 21 Тогда
		Возврат "Внебиржа(РЕПО)";
	ИначеЕсли Индекс = 22 Тогда
		Возврат "Внебиржа(Валютная)";
	ИначеЕсли Индекс = 23 Тогда
		Возврат "Внебиржа(VN)";	
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ЗаполнитьДаннымиБазыНаСервере(ТекущаяДата)
	
	ПлюсОдинРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата, ?(Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата), 2, 1));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ДанныеФайла.ДатаПоручения КАК ДатаПоручения,
	    |	_ДанныеФайла.НомерСтроки КАК НомерСтроки,
	    |	_ДанныеФайла.УК КАК УК,
	    |	_ДанныеФайла.КодСчета КАК КодСчета,
	    |	_ДанныеФайла.КодУБрокера КАК КодУБрокера,
	    |	_ДанныеФайла.БрокерИзФайла КАК ИмяБрокераИзФайла,
	    |	_ДанныеФайла.ВалютаКод КАК ВалютаКод,
	    |	_ДанныеФайла.ТипПеревода КАК ТипПеревода,
	    |	_ДанныеФайла.Срочно КАК Срочно,
	    |	_ДанныеФайла.СрочныйПереводБЭСП КАК СрочныйПереводБЭСП,
	    |	_ДанныеФайла.СчетСекцияОткуда КАК СчетСекцияОткуда,
	    |	_ДанныеФайла.СчетСекцияКуда КАК СчетСекцияКуда,
	    |	_ДанныеФайла.ПереводНаБиржу КАК ПереводНаБиржу,
	    |	_ДанныеФайла.БанкБрокерОткуда КАК БанкБрокерОткуда,
	    |	_ДанныеФайла.БанкБрокерКуда КАК БанкБрокерКуда,
	    |	_ДанныеФайла.БикОткуда КАК БикОткуда,
	    |	_ДанныеФайла.БикКуда КАК БикКуда,
	    |	_ДанныеФайла.СуммаОткуда КАК СуммаОткуда,
	    |	_ДанныеФайла.СуммаКуда КАК СуммаКуда
	    |ПОМЕСТИТЬ _ДанныеФайла
	    |ИЗ
	    |	&ДанныеФайла КАК _ДанныеФайла
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ДанныеФайла.НомерСтроки КАК НомерСтроки,
	    |	_ДанныеФайла.КодСчета КАК КодСчета,
	    |	_ДанныеФайла.СуммаОткуда КАК СуммаОткуда,
	    |	_ДанныеФайла.СуммаКуда КАК СуммаКуда,
	    |	_ДанныеФайла.ВалютаКод КАК ВалютаКод
	    |ПОМЕСТИТЬ _ДублиЗаписейВФайле
	    |ИЗ
	    |	(ВЫБРАТЬ
	    |		_ДанныеФайла.ДатаПоручения КАК ДатаПоручения,
	    |		_ДанныеФайла.УК КАК УК,
	    |		_ДанныеФайла.КодСчета КАК КодСчета,
	    |		_ДанныеФайла.ИмяБрокераИзФайла КАК ИмяБрокераИзФайла,
	    |		_ДанныеФайла.ВалютаКод КАК ВалютаКод,
	    |		_ДанныеФайла.ТипПеревода КАК ТипПеревода,
	    |		_ДанныеФайла.Срочно КАК Срочно,
	    |		_ДанныеФайла.СрочныйПереводБЭСП КАК СрочныйПереводБЭСП,
	    |		_ДанныеФайла.СчетСекцияОткуда КАК СчетСекцияОткуда,
	    |		_ДанныеФайла.СчетСекцияКуда КАК СчетСекцияКуда,
	    |		_ДанныеФайла.ПереводНаБиржу КАК ПереводНаБиржу,
	    |		_ДанныеФайла.БанкБрокерОткуда КАК БанкБрокерОткуда,
	    |		_ДанныеФайла.БанкБрокерКуда КАК БанкБрокерКуда,
	    |		_ДанныеФайла.БикОткуда КАК БикОткуда,
	    |		_ДанныеФайла.БикКуда КАК БикКуда,
	    |		_ДанныеФайла.СуммаОткуда КАК СуммаОткуда,
	    |		_ДанныеФайла.СуммаКуда КАК СуммаКуда
	    |	ИЗ
	    |		_ДанныеФайла КАК _ДанныеФайла
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		_ДанныеФайла.ДатаПоручения,
	    |		_ДанныеФайла.УК,
	    |		_ДанныеФайла.КодСчета,
	    |		_ДанныеФайла.ИмяБрокераИзФайла,
	    |		_ДанныеФайла.ВалютаКод,
	    |		_ДанныеФайла.ТипПеревода,
	    |		_ДанныеФайла.Срочно,
	    |		_ДанныеФайла.СрочныйПереводБЭСП,
	    |		_ДанныеФайла.СчетСекцияОткуда,
	    |		_ДанныеФайла.СчетСекцияКуда,
	    |		_ДанныеФайла.ПереводНаБиржу,
	    |		_ДанныеФайла.БанкБрокерОткуда,
	    |		_ДанныеФайла.БанкБрокерКуда,
	    |		_ДанныеФайла.БикОткуда,
	    |		_ДанныеФайла.БикКуда,
	    |		_ДанныеФайла.СуммаОткуда,
	    |		_ДанныеФайла.СуммаКуда
	    |	
	    |	ИМЕЮЩИЕ
	    |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ДанныеФайла.НомерСтроки) > 1) КАК ВложенныйЗпрос
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеФайла КАК _ДанныеФайла
	    |		ПО ВложенныйЗпрос.ДатаПоручения = _ДанныеФайла.ДатаПоручения
	    |			И ВложенныйЗпрос.УК = _ДанныеФайла.УК
	    |			И ВложенныйЗпрос.КодСчета = _ДанныеФайла.КодСчета
	    |			И ВложенныйЗпрос.ИмяБрокераИзФайла = _ДанныеФайла.ИмяБрокераИзФайла
	    |			И ВложенныйЗпрос.ВалютаКод = _ДанныеФайла.ВалютаКод
	    |			И ВложенныйЗпрос.ТипПеревода = _ДанныеФайла.ТипПеревода
	    |			И ВложенныйЗпрос.Срочно = _ДанныеФайла.Срочно
	    |			И ВложенныйЗпрос.СрочныйПереводБЭСП = _ДанныеФайла.СрочныйПереводБЭСП
	    |			И ВложенныйЗпрос.СчетСекцияОткуда = _ДанныеФайла.СчетСекцияОткуда
	    |			И ВложенныйЗпрос.СчетСекцияКуда = _ДанныеФайла.СчетСекцияКуда
	    |			И ВложенныйЗпрос.ПереводНаБиржу = _ДанныеФайла.ПереводНаБиржу
	    |			И ВложенныйЗпрос.БанкБрокерОткуда = _ДанныеФайла.БанкБрокерОткуда
	    |			И ВложенныйЗпрос.БанкБрокерКуда = _ДанныеФайла.БанкБрокерКуда
	    |			И ВложенныйЗпрос.БикОткуда = _ДанныеФайла.БикОткуда
	    |			И ВложенныйЗпрос.БикКуда = _ДанныеФайла.БикКуда
	    |			И ВложенныйЗпрос.СуммаОткуда = _ДанныеФайла.СуммаОткуда
	    |			И ВложенныйЗпрос.СуммаКуда = _ДанныеФайла.СуммаКуда
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ИменованныеОбъекты.Объект КАК Объект,
	    |	ВЫБОР
	    |		КОГДА ИменованныеОбъекты.Имя = ""Брокер_БК_Регион""
	    |			ТОГДА ""БК""
	    |		КОГДА ИменованныеОбъекты.Имя = ""Брокер_ГПБ""
	    |			ТОГДА ""ГПБ""
	    |	КОНЕЦ КАК ИмяИзФайла
	    |ПОМЕСТИТЬ _ИменованныеОбъекты
	    |ИЗ
	    |	РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
	    |ГДЕ
	    |	ИменованныеОбъекты.Имя В (""Брокер_БК_Регион"", ""Брокер_ГПБ"", ""НКО_НКЦ"")
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ДанныеФайла.ДатаПоручения КАК ДатаПоручения,
	    |	_ДанныеФайла.НомерСтроки КАК НомерСтроки,
	    |	_ДанныеФайла.УК КАК УК,
	    |	_ДанныеФайла.КодСчета КАК КодСчета,
	    |	_ДанныеФайла.КодУБрокера КАК КодУБрокера,
	    |	_ДанныеФайла.ИмяБрокераИзФайла КАК ИмяБрокераИзФайла,
	    |	_ДанныеФайла.ВалютаКод КАК ВалютаКод,
	    |	Валюты.Ссылка КАК Валюта,
	    |	_ДанныеФайла.ТипПеревода КАК ТипПеревода,
	    |	_ДанныеФайла.Срочно КАК Срочно,
	    |	_ДанныеФайла.СрочныйПереводБЭСП КАК СрочныйПереводБЭСП,
	    |	ВЫБОР
	    |		КОГДА _ДанныеФайла.СчетСекцияОткуда = ""16""
	    |			ТОГДА ""Биржа(Фондовая Т+)""
