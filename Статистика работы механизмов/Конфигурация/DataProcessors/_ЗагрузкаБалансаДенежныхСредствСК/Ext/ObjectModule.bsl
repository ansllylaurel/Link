
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
	   "ДополнительнаяОбработка",
	   "Загрузка остатков денежных средств СК в 1С",
	   "1.05",
	   "",
	   Истина);
	
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();

	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЗагрузитьДенСредстваСКв1СТест", "Загрузить остатки денежных средств СК (тест)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЗагрузитьДенСредстваСКв1СПрод", "Загрузить остатки денежных средств СК (прод)",, Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);

	Возврат РегистрационныеДанные;

КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	Если ПараметрыОбработки = Неопределено Тогда // режим тестирования
		
		ПараметрыКоманды = Новый Структура("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));
		
	Иначе
		
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);

	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
		ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	Иначе
		ЗарегистрироватьОшибку("Для импорта данных в 1С необходимо заполнить параметр команды [Организация].");	
	КонецЕсли;
	
	Если      ИдентификаторКоманды = "ЗагрузитьДенСредстваСКв1СТест" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуТест();
	ИначеЕсли ИдентификаторКоманды = "ЗагрузитьДенСредстваСКв1СПрод" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуПрод();
	КонецЕсли;
	
	ЭтотОбъект.ДатаВыгрузки = ТекущаяДата();
	
	// сессия для регистрации статистики
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаВыгрузки, Организация");
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДопДанныеДляСтатистики = Новый Структура;
	ТекстОшибки = Неопределено;
	
	// основной процесс
	ОстаткиДС_СК = ЗагрузитьОстаткиДенСредствСК(ДопДанныеДляСтатистики, ТекстОшибки);
	
	СформироватьВводОстатковДенежныхСредствСК(ДопДанныеДляСтатистики, ТекстОшибки, ОстаткиДС_СК);
	
	// закроем сессию статистики и оповестим об ошибках
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, Ложь, ДопДанныеДляСтатистики, ТекстОшибки);
		
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры

Функция ВыполнитьКонтроль(ИдентификаторКоманды, датаБаланса, ПараметрыОбработки) Экспорт

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	Если ПараметрыОбработки = Неопределено Тогда // режим тестирования
		
		ПараметрыКоманды = Новый Структура("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));
		
	Иначе
		
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);

	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
		ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	Иначе
		ЗарегистрироватьОшибку("Для контроля данных необходимо заполнить параметр команды [Организация].");	
	КонецЕсли;
	
	Если      ИдентификаторКоманды = "КонтрольТест" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуТест();
	ИначеЕсли ИдентификаторКоманды = "КонтрольПрод" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуПрод();
	КонецЕсли;
	
	// сессия для регистрации статистики
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаВыгрузки, Организация");
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДопДанныеДляСтатистики = Новый Структура;
	ТекстОшибки = Неопределено;
	
	// основной процесс
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(ЭтотОбъект.СтрокаПодключения);
	
	Если Соединение <> Неопределено Тогда
			
		ОстаткиДС_СК = ЗагрузитьОстаткиДенСредствСКНаДату(ДопДанныеДляСтатистики, ТекстОшибки, датаБаланса);
	
		Остатки = ПолучитьСуммуОстатковПоВсемВалютамВРубляхОтображение(ОстаткиДС_СК);
	Иначе
		ТекстОшибки = "Ошибка подключения к базе данных";
		ЗарегистрироватьОшибку(ТекстОшибки);
	КонецЕсли;
	
	// закроем сессию статистики и оповестим об ошибках
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, Ложь, ДопДанныеДляСтатистики, ТекстОшибки);

	ОповеститьОбОшибках(Неопределено);
	
	Возврат Остатки;
	
КонецФункции


Функция ЗагрузитьОстаткиДенСредствСК(ДопДанныеДляСтатистики, ТекстОшибки) 
	
	// данные для статистики
	ТекстОшибки = Неопределено;	
	
	// Загрузить данные из БД 
	ВремяНачалаВыполнения = ТекущаяДата();	
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(ЭтотОбъект.СтрокаПодключения);
	
	Если Соединение <> Неопределено Тогда
			
		Результат = ЗагрузитьДанныеИзБазыДанных(Соединение);
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		
		ДопДанныеДляСтатистики.Вставить("ВремяПолученияДанныхССервераСек", ТекущаяДата() - ВремяНачалаВыполнения);
		
	Иначе
		ТекстОшибки = "Ошибка подключения к базе данных";
		ЗарегистрироватьОшибку(ТекстОшибки);
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьОстаткиДенСредствСКНаДату(ДопДанныеДляСтатистики, ТекстОшибки, датаБаланса) 
	
	// данные для статистики
	ТекстОшибки = Неопределено;
	
	// Загрузить данные из БД 
	ВремяНачалаВыполнения = ТекущаяДата();	
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(ЭтотОбъект.СтрокаПодключения);
	
	Если Соединение <> Неопределено Тогда
			
		Результат = ЗагрузитьДанныеИзБазыДанных(Соединение, датаБаланса);
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		
