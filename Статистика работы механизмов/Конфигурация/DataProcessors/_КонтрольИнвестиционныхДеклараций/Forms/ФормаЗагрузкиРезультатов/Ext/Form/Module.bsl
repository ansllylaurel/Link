
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивИдентификаторов", Параметры.МассивИдентификаторов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения,
		|	ХранилищеЗначений.ДатаСоздания КАК ДатаСоздания,
		|	ХранилищеЗначений.Ответственный КАК Ответственный,
		|	ХранилищеЗначений.ПараметрыОтбора КАК ПараметрыОтбора
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Идентификатор В(&МассивИдентификаторов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания УБЫВ,
		|	Ответственный
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Пока Выборка.Следующий() Цикл
	
		НоваяСтрока = ЭтаФорма.СохраненныеРезультаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ХранилищеЗначения = Выборка.ХранилищеЗначения.Получить();
		НоваяСтрока.ДинамическийРасчетСтоимости = ХранилищеЗначения.ДинамическийРасчетСтоимости;
		
		ПараметрыОтбора = Выборка.ПараметрыОтбора.Получить();
		НоваяСтрока.СовокупнаяИнвестДекларация = ПараметрыОтбора.СовокупнаяИнвестДекларация;
				
		НоваяСтрока.Претрейд = (ХранилищеЗначения.Претрейд.Количество() > 0);
		НоваяСтрока.СоставСовокупнойИнвестиционнойДекларации.Загрузить(ХранилищеЗначения.СоставСовокупнойИнвестДекларации);
		
		Для каждого Строка Из ХранилищеЗначения.Претрейд Цикл
		
			НоваяСтрокаПретрейд = НоваяСтрока.СоставПретрейда.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПретрейд, Строка);
			НоваяСтрокаПретрейд.Представление = ОбъектНаСервере.ПолучитьПредставлениеСтрокиПретрейда(Строка);
		
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеРезультатыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		Элементы.СохраненныеРезультатыСоставПретрейда.Видимость = ТекущиеДанные.Претрейд;
		Элементы.СохраненныеРезультатыСоставСовокупнойИнвестиционнойДекларации.Видимость = ТекущиеДанные.СовокупнаяИнвестДекларация;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузить(Команда)
	
	Загрузить(); 
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеРезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Загрузить();
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить()

	ТекущиеДанные = Элементы.СохраненныеРезультаты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Закрыть(ТекущиеДанные.Идентификатор);
	КонецЕсли;

КонецПроцедуры
 