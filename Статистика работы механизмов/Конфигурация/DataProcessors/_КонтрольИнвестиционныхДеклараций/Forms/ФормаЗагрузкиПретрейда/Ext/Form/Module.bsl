
&НаКлиенте
Процедура ОК(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить поле 'Счет доверительного управления'", , "СчетДоверительногоУправления");
		Возврат;
	
	КонецЕсли; 
	
	Если ЭтаФорма.ВидОперации = 1 И Не ЗначениеЗаполнено(ЭтаФорма.БрокерРасчетныйСчет) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить поле 'Брокер/расчетный счет'", , "БрокерРасчетныйСчет");
		Возврат;
	
	КонецЕсли;
	
	Если ЭтаФорма.ВидОперации = 0 Тогда
	
		ЭтаФорма.БрокерРасчетныйСчет = Неопределено;
	
	КонецЕсли; 
	
	КоличествоПустых = 0;
	МассивСтрок = Новый Массив;
	
	Для НомерСтроки = 1 По ЭтаФорма.ТабличныйДокумент.ВысотаТаблицы Цикл
	
		РегНомер = ЭтаФорма.ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		
		Если КоличествоПустых > 20 Тогда
			Прервать;
		КонецЕсли; 
		
		Если РегНомер = "Рег. номер / ISIN" Тогда
			Продолжить;
		ИначеЕсли ПустаяСтрока(РегНомер) Тогда
			КоличествоПустых = КоличествоПустых + 1;
			Продолжить;		
		КонецЕсли; 		
		
		СтруктураКолонок = Новый Структура("Код, Количество, Цена, Купон, СчетДоверительногоУправления, БрокерРасчетныйСчет", 
			СтрЗаменить(СтрЗаменить(РегНомер, " ", ""), Символы.ПС, ""),
			СтрЗаменить(ЭтаФорма.ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 2).Текст, " ", ""),
			СтрЗаменить(ЭтаФорма.ТабличныйДокумент.Область(НомерСтроки, 3, НомерСтроки, 3).Текст, " ", ""),
			СтрЗаменить(ЭтаФорма.ТабличныйДокумент.Область(НомерСтроки, 4, НомерСтроки, 4).Текст, " ", ""),
			ЭтаФорма.СчетДоверительногоУправления,
			ЭтаФорма.БрокерРасчетныйСчет); 
		
		МассивСтрок.Добавить(СтруктураКолонок);
	
	КонецЦикла; 
	
	ЭтаФорма.Закрыть(МассивСтрок);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "СчетДоверительногоУправления, Период") ;
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	НастроитьВидимостьДоступность(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(ЭтаФорма)
	ЭтаФорма.Элементы.ЦББрокерРасчетныйСчет.Видимость = (ЭтаФорма.ВидОперации = 1);
КонецПроцедуры

&НаКлиенте
Процедура ЦББрокерРасчетныйСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ПолучитьСписокВыбораБрокерРасчетныйСчет(ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Период);
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьСписокВыбораБрокерРасчетныйСчет(СчетДоверительногоУправления, Период)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.Брокер КАК Брокер
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров КАК РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ТекущаяДата)
		|	И РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК РегистрСведенийИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	(РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &ТекущаяДата)
		|	И РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТекущаяДата", Период);
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0));
	Возврат СписокЗначений;
	
КонецФункции