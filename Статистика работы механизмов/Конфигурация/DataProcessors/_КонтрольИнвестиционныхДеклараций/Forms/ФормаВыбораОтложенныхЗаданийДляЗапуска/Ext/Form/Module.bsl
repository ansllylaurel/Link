
&НаКлиенте
Процедура КомандаВыбрать(Команда)
	Если ПроверитьВыбранныеСтроки(Элементы.Список.ВыделенныеСтроки) Тогда
		Закрыть(Элементы.Список.ВыделенныеСтроки);
	Иначе
		Предупреждение("Можно запустить несколько ОЗ только с одинаковыми командами");
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьВыбранныеСтроки(Знач Ключи)

	Идентификаторы = Новый Массив;
	Для каждого Ключ Из Ключи Цикл
		Идентификаторы.Добавить(Ключ.Идентификатор);
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОтложенныеЗадания.Команда КАК Команда
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Идентификатор В(&Идентификаторы)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат (Выборка.Количество() = 1);

КонецФункции
 