
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "АдресНастроекБазиса, Базис");
	
	Параметры.Настройки = ПолучитьИзВременногоХранилища(Параметры.АдресНастроекБазиса);
	Параметры.ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.АдресСКДБазиса);
	
КонецПроцедуры

	
#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаСохранитьИСформировать(Команда)
	СохранитьИСформироватьНаСервере();
	Закрыть(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОтборИзНабора(Команда)
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("НаборДанных", ПолучитьНаборДанныхБазиса(ЭтаФорма.Базис)));
	Набор = ОткрытьФормуМодально("Справочник.НаборыИнвестиционныхДеклараций.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	ДобавитьИзНабораНаСервере(Набор);
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура СохранитьИСформироватьНаСервере()

	ПоместитьВоВременноеХранилище(ЭтаФорма.КомпоновщикНастроекБазиса.ПолучитьНастройки(), ЭтаФорма.АдресНастроекБазиса);

КонецПроцедуры

&НаСервере
Процедура ДобавитьИзНабораНаСервере(Набор)
	
	Если ЗначениеЗаполнено(Набор) Тогда
	
		НастройкиНабора = Набор.УсловияОтбора.Получить();
		Если ТипЗнч(НастройкиНабора) = Тип("НастройкиКомпоновкиДанных") Тогда
			Справочники.ИнвестиционныеДекларации.ЗаполнитьПользовательскиеПоля(КомпоновщикНастроекБазиса.Настройки.ПользовательскиеПоля, НастройкиНабора.ПользовательскиеПоля, Ложь);
			Справочники.ИнвестиционныеДекларации.ЗаполнитьОтбор(КомпоновщикНастроекБазиса.Настройки.Отбор, НастройкиНабора.Отбор);
		КонецЕсли; 
	
	КонецЕсли;     	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаборДанныхБазиса(Базис)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Базис, "НаборДанных");
КонецФункции

#КонецОбласти 


