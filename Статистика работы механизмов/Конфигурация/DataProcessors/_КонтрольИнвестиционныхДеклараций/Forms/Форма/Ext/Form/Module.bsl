&НаСервере
Функция ПолучитьХМЛ()

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);

	Структура = СтруктураРезультатовПроверки.СтруктураФормированияОтчета;
	
	Настройки = Структура.Настройки;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Настройки, "Settings", "http://v8.1c.ru/8.1/data-composition-system/settings");
	
	Результат = Новый Структура;
	Результат.Вставить("Настройки", ЗаписьXML.Закрыть());
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Структура.СКД, "DataCompositionSchema", "http://v8.1c.ru/8.1/data-composition-system/schema");
	
	Результат.Вставить("Схема", ЗаписьXML.Закрыть());
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗаписатьРезультатВФайлы(СКД = Неопределено, Настройки = Неопределено, МакетКомпоновки = Неопределено, Постфикс = "", СохранятьРезультатВФайлы = Ложь)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаНаСервере.ЗаписатьРезультатВФайлы(СКД, Настройки, МакетКомпоновки, Постфикс, СохранятьРезультатВФайлы);

КонецФункции

#КонецОбласти 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период      = ТекущаяДата();
	
	ЭтаФорма.АдресДанныхРасшифровкиБазиса 			= ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	ЭтаФорма.АдресСтруктурыРезультатовПроверки 		= ПоместитьВоВременноеХранилище(Новый Структура, ЭтаФорма.УникальныйИдентификатор);
	ЭтаФорма.АдресМассиваРезультатовКонтроля		= ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	
	ЭтаФорма.ВалютаУчета 					= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	ЭтаФорма.ИспользоватьЦелевоеЗначение 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ИнвестиционнаяДекларация, "ИспользоватьЦелевоеЗначение");
	
	ЭтаФорма.ПериодОбновления				= 10;
	ЭтаФорма.НаименованиеЗадания = "Контроль инвестиционной декларации (" + ПолучитьТекущийСеансИнформационнойБазы().Пользователь.Имя + ")";
	ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль";
	ЭтаФорма.РежимСовокукпногоКонтроля = "Авто";
	ЭтаФорма.РежимГрупповогоКонтроля = "ПоСчетам";
	ЭтаФорма.КонтрольЗаПериодРежимЗаполнения = "ПоНастройкам";
	ЭтаФорма.МаксимумАктивныхЗаданий = 2;
	
	ЭтаФорма.ПараметрыПроверки = Новый Структура("РежимКонтроля, РежимГрупповогоКонтроля", 
		ЭтаФорма.РежимКонтроля,
		ЭтаФорма.РежимГрупповогоКонтроля); 
		
	// флаг виден всем, т.к. необходима возможность формировать совокупную ИД по счетам ДУ и в одной организации
	// в любом случае, список счетов ДУ формируется только по организациям, к которым у пользователя есть доступ
	//Элементы.СовокупнаяИнвестДекларация.Видимость = РольДоступна("МногофирменныйУчет") Или ЭтаФорма.ПолныеПрава;
	
	Элементы.ГруппаОтладка.Видимость = РольДоступна("ПолныеПрава");
	
	Если Параметры.Свойство("ИдентификаторРезультата") Тогда
		
		ЗагрузитьРезультатыПроверкиНаСервере(Параметры.ИдентификаторРезультата);
		ЭтаФорма.РеквизитыИзХранилища = Новый Структура;
		ЭтаФорма.РеквизитыИзХранилища.Вставить("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
		ЭтаФорма.РеквизитыИзХранилища.Вставить("Клиент", Объект.Клиент);
		ЭтаФорма.РеквизитыИзХранилища.Вставить("ВидДоговораДоверительногоУправления", Объект.ВидДоговораДоверительногоУправления);
		
		РеквизитыКонтроля = ПолучитьРеквизитыКонтроля(Объект.Период, Объект.Организация, Объект.СчетДоверительногоУправления);
	
		Если РеквизитыКонтроля.Свойство("ДатаПроверкиСледующейИД") Тогда
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Видимость = Истина;
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Заголовок = "Внимание! " + Формат(РеквизитыКонтроля.ДатаПроверкиСледующейИД, "ДФ=dd.MM.yyyy") + 
				" вступает в силу новая инвестиционная декларация";
		Иначе
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли; 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЭтаФорма.ВнешняяОбработка = Не СтрНачинаетсяС(ОбработкаОбъект.ИспользуемоеИмяФайла, "e1cib\tempstorage\");
	Шапка = ОбработкаОбъект.ПолучитьМакет("РезультатыКонтроля").ПолучитьОбласть("Шапка");
	ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Вывести(Шапка);
	
	УстановитьПереключательТипа(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОрганизацияСчетаДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "Организация");
	Если ОрганизацияСчетаДУ <> Объект.Организация Тогда
		Объект.СчетДоверительногоУправления = Неопределено;
	КонецЕсли; 
	
	Если ТипЗнч(ЭтаФорма.РеквизитыИзХранилища) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект, ЭтаФорма.РеквизитыИзХранилища);
	Иначе
		
		НаборДействий = Новый Массив;
		
		Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
			НаборДействий.Добавить("ЗаполнитьКлиента");
		Иначе
			НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
		КонецЕсли; 
		
		НаборДействий.Добавить("ЗаполнитьВидДоговора");
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
		НаборДействий.Добавить("ЗаполнитьСостав");
			
		НаборДействий.Добавить("ЗаполнитьДанныеРСА");
		
		ОбновитьРеквизитыКонтроля(НаборДействий);
		
	КонецЕсли; 
	
	ЭтаФорма.КлючУникальности = Новый УникальныйИдентификатор;
	УстановитьВидимость(ЭтаФорма);
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗавершениеРаботы Тогда
	
		Если Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРасшифровка Тогда
			Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРезультатПроверки;
			Отказ = Истина;
		Иначе
			Отказ = (Вопрос("Закрыть контроль инвестиционных деклараций?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если Не ЗавершениеРаботы Тогда
		ЗавершитьФоновыеЗадания();	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьФоновыеЗадания()
	ИдентификаторыЗаданий = Новый Массив;
	
	АктивныеЗадания = Объект.СоставГрупповогоКонтроля.НайтиСтроки(Новый Структура("Статус", "Задание выполняется"));	
	Для Каждого СтрокаЗадания Из АктивныеЗадания Цикл
		ИдентификаторыЗаданий.Добавить(СтрокаЗадания.ИдентификаторЗадания);	
	КонецЦикла;
	
	ЗавершитьФоновыеЗаданияНаСервере(ИдентификаторыЗаданий);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗавершитьФоновыеЗаданияНаСервере(ИдентификаторыЗаданий)
	Для Каждого ИдентификаторЗадания Из ИдентификаторыЗаданий Цикл
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
		Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ФоновоеЗадание.Отменить();	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


#КонецОбласти 

#Область ИндивидуальныйКонтроль_ЭлементыФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	НаборДействий = Новый Массив;
		
	Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		НаборДействий.Добавить("ЗаполнитьКлиента");
	Иначе
		НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
	КонецЕсли; 
	
	НаборДействий.Добавить("ЗаполнитьВидДоговора");
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Совокупно" Тогда
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
	КонецЕсли; 
	
	НаборДействий.Добавить("ЗаполнитьСостав");
	НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
	ОбновитьРеквизитыКонтроля(НаборДействий);
		
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	НаборДействий = Новый Массив;
		
	НаборДействий.Добавить("ЗаполнитьКлиента");
	НаборДействий.Добавить("ЗаполнитьВидДоговора");
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Совокупно" Тогда
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
	КонецЕсли; 
	НаборДействий.Добавить("ЗаполнитьСостав");
	НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
	ОбновитьРеквизитыКонтроля(НаборДействий);
	УстановитьПереключательТипа(ЭтаФорма);
	
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатыПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = ЭтаФорма.РезультатыПроверки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекСтрока <> Неопределено Тогда
		// проверка на Неопределено срабатывает при двойном клике по гиперссылке в таблицйе группового контроля
		Если Поле.Имя = "РезультатыПроверкиПредставлениеНабора" Тогда
			ОткрытьЗначение(ТекСтрока.УсловияОтбора);
		ИначеЕсли Поле.Имя = "РезультатыПроверкиИнвестиционнаяДекларация" Тогда
			ОткрытьЗначение(ТекСтрока.ИнвестиционнаяДекларация);
		ИначеЕсли Поле.Имя = "РезультатыПроверкиГиперссылка" Тогда
			
			ВывестиРасшифровку = Ложь;
			
			Если ТекСтрока.РезультатПроверки <> ПредопределенноеЗначение("Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена") Тогда
			
				СписокДействий = Новый СписокЗначений;
				
				СписокДействий.Добавить("ПоказатьРасшифровку", "Открыть расшифровку");
				
				Если Не ЗначениеЗаполнено(ТекСтрока.НесоответствиеИнвестиционнойДекларации)
					Или ТекСтрока.ДатаУстранения < Объект.Период Тогда 
					СписокДействий.Добавить("Создать", "Создать документ");
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(ТекСтрока.НесоответствиеИнвестиционнойДекларации) Тогда
					СписокДействий.Добавить("Открыть", "Открыть документ");
				КонецЕсли;
					
				Действие = ВыбратьИзМеню(СписокДействий);
				
				Если Действие = Неопределено Тогда
			
					Возврат;
				
				ИначеЕсли Действие.Значение = "Создать" Тогда
				                
					ЗначенияЗаполнения = ПолучитьЗначенияЗаполненияНесоответствиеИД(ТекСтрока);
					ОткрытьФорму("Документ.НесоответствиеИнвестиционнойДекларации.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения));
				
				ИначеЕсли Действие.Значение = "Открыть" Тогда
				                
					ОткрытьФорму("Документ.НесоответствиеИнвестиционнойДекларации.ФормаОбъекта", Новый Структура("Ключ", ТекСтрока.НесоответствиеИнвестиционнойДекларации));
				
				ИначеЕсли Действие.Значение = "ПоказатьРасшифровку" Тогда
				                
					ВывестиРасшифровку = Истина;
				
				КонецЕсли; 
				
			Иначе
				ВывестиРасшифровку = Истина;
			КонецЕсли; 
			
			Если ВывестиРасшифровку Тогда
				ВывестиРасшифровку(ТекСтрока.ИмяВложенногоОбъекта, ТекСтрока.НомерБазиса, ТекСтрока.ИмяПоляДоля);	
			КонецЕсли; 
			
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда 
		
		СтандартнаяОбработка = Ложь;
		Значение = ПолучитьЗначениеРасшифровки(ЭтаФорма.АдресСтруктурыРезультатовПроверки, Расшифровка);
		ПростыеТипы = Новый ОписаниеТипов("Строка, Число, Дата, Булево, Неопределено");
		Если ЗначениеЗаполнено(Значение) И Не ПростыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
			
			ОткрытьЗначение(Значение);
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументБазисОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда 
		
		СтандартнаяОбработка = Ложь;
		Значение = ПолучитьЗначениеРасшифровки(ЭтаФорма.АдресДанныхРасшифровкиБазиса, Расшифровка);
		ПростыеТипы = Новый ОписаниеТипов("Строка, Число, Дата, Булево, Неопределено");
		Если ЗначениеЗаполнено(Значение) И Не ПростыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
			
			ОткрытьЗначение(Значение);
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументРезультатПриАктивизацииОбласти(Элемент)
	
	Если ТипЗнч(ДокументРезультат.ВыделенныеОбласти) = Тип("ВыделенныеОбластиТабличногоДокумента") Тогда
		
		ПодключитьОбработчикОжидания("Подключаемый_ДокументРезультатПриАктивизацииОбластиПодключаемый", 0.2, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияСтоимостиАктивовНажатие(Элемент, СтандартнаяОбработка)
	
	Если ТипЗнч(ЭтаФорма.РегистрацияСтоимостиАктивов) = Тип("Строка") Тогда
	
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если СокрЛП(Текст) + Ожидание <> "0" Тогда
	
		СтандартнаяОбработка = Ложь;
		
	    ПараметрыПодбора = Новый Структура;
	    ПараметрыПодбора.Вставить("Отбор", ПараметрыПолученияДанных.Отбор);
	    ПараметрыПодбора.Вставить("СтрокаПоиска", Текст);
	    ПараметрыПодбора.Вставить("ВыборГруппИЭлементов", ПредопределенноеЗначение("ИспользованиеГруппИЭлементов.Элементы"));
		ПараметрыПодбора.Вставить("ТекущаяДата", НачалоДня(Объект.Период));
	    ПараметрыПодбора.Вставить("ИсключитьРасторгнутые");
	    
	    ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.СчетаДоверительногоУправления"), ПараметрыПодбора);	
	
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура СовокупнаяИнвестДекларацияПриИзменении(Элемент)
	
	ПриИзмененииСовокупногоКонтроля();
	ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСовокупногоКонтроля()

	ЗаполнитьСоставСовокупнойИнвестДекларации();
	
	КонтрольЗаПрошлыйПериод = (НачалоДня(ТекущаяДата()) > Объект.Период);
	Объект.УчитыватьПлановыеОперации = Не (КонтрольЗаПрошлыйПериод Или ЭтаФорма.СовокупнаяИнвестДекларация);

КонецПроцедуры 

#КонецОбласти 

#Область ЗаполнениеРеквизитовФормы

&НаСервере
Процедура ОбновитьРеквизитыКонтроляНаСервере(НаборДействий, Отказ)

	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Возврат;
	КонецЕсли; 
	
	ДоступныеВидыДействий = Новый Массив;
	
	ДоступныеВидыДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
	ДоступныеВидыДействий.Добавить("ЗаполнитьКлиента");
	ДоступныеВидыДействий.Добавить("ЗаполнитьВидДоговора");
	ДоступныеВидыДействий.Добавить("ЗаполнитьСостав");
	ДоступныеВидыДействий.Добавить("ЗаполнитьДанныеРСА");
	ДоступныеВидыДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
	
	РеквизитыКонтроля = Неопределено;
	МВТ = Неопределено;
	
	Для каждого ВидДействия Из НаборДействий Цикл
	
		Если РеквизитыКонтроля = Неопределено И ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
			РеквизитыКонтроля = ПолучитьРеквизитыКонтроля(Объект.Период, Объект.Организация, Объект.СчетДоверительногоУправления);
		КонецЕсли; 
		
		Если ДоступныеВидыДействий.Найти(ВидДействия) = Неопределено Тогда
			ТекстСообщения = СтрШаблон("Ошибка заполнения реквизитов. Вариант заполнения '%1' не поддерживается", ВидДействия);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ); 
			Возврат;
		ИначеЕсли ВидДействия = "ЗаполнитьСчетДоверительногоУправления" Тогда 
			ЗаполнитьСчетДоверительногоУправления(МВТ);
		ИначеЕсли ВидДействия = "ЗаполнитьКлиента" Тогда 
			ЗаполнитьКлиента(РеквизитыКонтроля);
		ИначеЕсли ВидДействия = "ЗаполнитьВидДоговора" Тогда 
			ЗаполнитьВидДоговора(РеквизитыКонтроля, МВТ);
		ИначеЕсли ВидДействия = "ЗаполнитьСостав" Тогда 
			ЗаполнитьСостав(РеквизитыКонтроля);
		ИначеЕсли ВидДействия = "ЗаполнитьДанныеРСА" Тогда 
			ЗаполнитьДанныеРСА(РеквизитыКонтроля);
		ИначеЕсли ВидДействия = "ЗаполнитьИнвестиционнуюДекларацию" Тогда 
			ЗаполнитьИнвестиционнуюДекларацию(РеквизитыКонтроля);		
		КонецЕсли; 
	
	КонецЦикла;
	
	Если ТипЗнч(РеквизитыКонтроля) = Тип("Структура") Тогда
	
		Элементы.РезультатыПроверкиИнвестиционнаяДекларация.Видимость = РеквизитыКонтроля.Консолидирующая;
		
		Если РеквизитыКонтроля.Свойство("ДатаПроверкиСледующейИД") Тогда
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Видимость = Истина;
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Заголовок = "Внимание! " + Формат(РеквизитыКонтроля.ДатаПроверкиСледующейИД, "ДФ=dd.MM.yyyy") + 
				" вступает в силу новая инвестиционная декларация";
		Иначе
			Элементы.НадписьНоваяИнвестиционнаяДекларация.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКлиента(РеквизитыКонтроля)

	Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.Клиент = РеквизитыКонтроля.Клиент;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидДоговора(РеквизитыКонтроля = Неопределено, МВТ = Неопределено)

	Если ТипЗнч(РеквизитыКонтроля) = Тип("Структура") Тогда
		// счет ДУ заполнен, берем его вид договора
		Объект.ВидДоговораДоверительногоУправления = РеквизитыКонтроля.ВидДоговораДоверительногоУправления;
	КонецЕсли; 
	
	Если МВТ = Неопределено Тогда
		МВТ = Новый МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	Если МВТ.Таблицы.Количество() = 0 Тогда
		
		Отбор = Новый Структура("Организация, Клиент");
		ЗаполнитьЗначенияСвойств(Отбор, Объект);
		Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МВТ, Объект.Период, Отбор);
	
	КонецЕсли;
		
	ТаблицаСчетов = МВТ.Таблицы.Найти("ДействующиеСчетаДУ");
		
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДействующиеСчетаДУ.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ИЗ
		|	ДействующиеСчетаДУ КАК ДействующиеСчетаДУ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МВТ;
			
	ВидыДоговоров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	Если ВидыДоговоров.Количество() = 1 Тогда
		Объект.ВидДоговораДоверительногоУправления = ВидыДоговоров[0];
	КонецЕсли; 
	
	Если ВидыДоговоров.Найти(Объект.ВидДоговораДоверительногоУправления) = Неопределено Тогда
		Объект.ВидДоговораДоверительногоУправления = Неопределено;
	КонецЕсли; 
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ВидыДоговоров)));
	Элементы.ВидДоговораДоверительногоУправления1.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетДоверительногоУправления(МВТ = Неопределено)

	Если МВТ = Неопределено Тогда
		МВТ = Новый МенеджерВременныхТаблиц;
	КонецЕсли; 
	
	Объект.СчетДоверительногоУправления = Неопределено;
	
	МассивПолей = СтрРазделить("Организация,Клиент", ",");
	Отбор = Новый Структура;
	
	Для каждого ИмяПоля Из МассивПолей Цикл
	
		Если ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
		
			Отбор.Вставить(ИмяПоля, Объект[ИмяПоля]);
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МВТ, Объект.Период, Отбор);
		
	ТаблицаСчетов = МВТ.Таблицы.Найти("ДействующиеСчетаДУ");
	
	ДействующиеСчета = ТаблицаСчетов.ПолучитьДанные().Выгрузить();
	
	Если ДействующиеСчета.Количество() = 1 Тогда 
		
		Объект.СчетДоверительногоУправления = ДействующиеСчета[0].Ссылка;
		
	Иначе
		
		СчетаПоВидуДоговора = ДействующиеСчета.НайтиСтроки(Новый Структура("ВидДоговораДоверительногоУправления", Объект.ВидДоговораДоверительногоУправления));
	
		Если СчетаПоВидуДоговора.Количество() = 1 Тогда
			Объект.СчетДоверительногоУправления = СчетаПоВидуДоговора[0].Ссылка;
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвестиционнуюДекларацию(РеквизитыКонтроля)

	Объект.ИнвестиционнаяДекларация = Неопределено;
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Авто" И ТипЗнч(РеквизитыКонтроля) = Тип("Структура") 
		И РеквизитыКонтроля.Свойство("ИнвестиционнаяДекларация") Тогда
		Объект.ИнвестиционнаяДекларация = РеквизитыКонтроля.ИнвестиционнаяДекларация;
	КонецЕсли;
	
	Комментарий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ИнвестиционнаяДекларация, "Комментарий");
	Элементы.ИнвестиционнаяДекларацияКомментарий.Видимость = ЗначениеЗаполнено(Комментарий);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостав(РеквизитыКонтроля)

	ИнвестиционнаяДекларация = Неопределено;
	Если ТипЗнч(РеквизитыКонтроля) = Тип("Структура") Тогда
		РеквизитыКонтроля.Свойство("ИнвестиционнаяДекларация", ИнвестиционнаяДекларация);
	КонецЕсли; 
	ЗаполнитьСоставСовокупнойИнвестДекларации(ИнвестиционнаяДекларация); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеРСА(РеквизитыКонтроля)

	Элементы.РегистрацияСтоимостиАктивов.Видимость = Не ЭтаФорма.СовокупнаяИнвестДекларация;
	Элементы.РегистрацияСтоимостиАктивов_СЧА.Видимость = Не ЭтаФорма.СовокупнаяИнвестДекларация;
	Элементы.РегистрацияСтоимостиАктивов_РСА.Видимость = Не ЭтаФорма.СовокупнаяИнвестДекларация;
	Элементы.РегистрацияСтоимостиАктивов_КЗ.Видимость = Не ЭтаФорма.СовокупнаяИнвестДекларация;
	
	Если Не ЭтаФорма.СовокупнаяИнвестДекларация И ТипЗнч(РеквизитыКонтроля) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, РеквизитыКонтроля, "РегистрацияСтоимостиАктивов, РегистрацияСтоимостиАктивов_СЧА, РегистрацияСтоимостиАктивов_РСА, 
			|РегистрацияСтоимостиАктивов_КЗ, ИспользоватьЦелевоеЗначение");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыКонтроля(НаборДействий)

	Отказ = Ложь;
	ОбновитьРеквизитыКонтроляНаСервере(НаборДействий, Отказ);
	
	КонтрольЗаПрошлыйПериод = (НачалоДня(ТекущаяДата()) > Объект.Период);
	Объект.УчитыватьПлановыеОперации = Не (КонтрольЗаПрошлыйПериод Или ЭтаФорма.СовокупнаяИнвестДекларация);
	
	Для каждого ГруппаРезультатов Из Элементы.ГруппаРезультатыОценкиСтраницы.ПодчиненныеЭлементы Цикл
		ГруппаРезультатов.Видимость = Ложь;
	КонецЦикла; 
	
	Элементы.ИспользованыПредварительныеЦены.Видимость = Ложь;
	Элементы.ДатаМаксДД.Видимость = Ложь;
	
	Если Объект.Претрейд.Количество() > 0 И Вопрос("Очистить претрейд?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Объект.Претрейд.Очистить();
	КонецЕсли; 
		
	ЭтаФорма.РезультатыПроверки.ПолучитьЭлементы().Очистить();
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументРезультатыКонтроля, "НЕАКТУАЛЬНОСТЬ", "Отчет не сформирован. Нажмите ""Выполнить контроль"" для получения отчета.");
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "НЕАКТУАЛЬНОСТЬ");
	
	УстановитьВидимость(ЭтаФорма);
	ОбновитьИнтерфейсПретрейда(Ложь);
	ПолучитьРезультатыКонтроляНаСервере();
	
	Элементы.ДекорацияПараметрыИндивидуальногоКонтроля.Заголовок = СтрШаблон("Контроль за: %1, %2, %3%4",
		Формат(Объект.Период, "ДФ=dd.MM.yyyy"),
		Объект.Клиент,
		Объект.ВидДоговораДоверительногоУправления,
		?(Объект.УчитыватьПлановыеОперации, " с учетом плановых операций", ""));
		
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьИнвестиционнуюДекларацию(Период, Организация, СчетДоверительногоУправления)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Субъект
		|ПОМЕСТИТЬ _Стратегии
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнвестиционныеДекларацииСрезПоследних.Период КАК Период,
		|	ИнвестиционныеДекларацииСрезПоследних.НазначениеИнвестиционнойДекларации КАК НазначениеИнвестиционнойДекларации
		|ПОМЕСТИТЬ _ИнвестДекларации
		|ИЗ
		|	РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Субъект = &СчетДоверительногоУправления
		|				И ТипИнвестиционнойДекларации = ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация)) КАК ИнвестиционныеДекларацииСрезПоследних
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИнвестиционныеДекларацииСрезПоследних.Период,
		|	ИнвестиционныеДекларацииСрезПоследних.НазначениеИнвестиционнойДекларации
		|ИЗ
		|	РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(
		|			&Период,
		|			(Организация, Субъект, ТипИнвестиционнойДекларации) В
		|				(ВЫБРАТЬ
		|					&Организация КАК Организация,
		|					Т.Субъект КАК Субъект,
		|					ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация) КАК ТипИнвестиционнойДекларации
		|				ИЗ
		|					_Стратегии КАК Т)) КАК ИнвестиционныеДекларацииСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_ИнвестДекларации.Период КАК Период,
		|	НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|ИЗ
		|	_ИнвестДекларации КАК _ИнвестДекларации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеИнвестиционнойДекларации.ИнвестиционныеДекларации КАК НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации
		|		ПО _ИнвестДекларации.НазначениеИнвестиционнойДекларации = НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.Ссылка";		
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ИнвестДекларация = Новый Структура("Период, ИнвестиционнаяДекларация"); 
	
	Если Выборка.Следующий() Тогда
		 ЗаполнитьЗначенияСвойств(ИнвестДекларация, Выборка) 
	КонецЕсли;
	 
	Возврат ИнвестДекларация;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруДокументов(Период, Организация, СчетДоверительногоУправления)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Организация КАК Организация,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&Период КАК Период,
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении) КАК ЦельРасчета
		|ПОМЕСТИТЬ _ПараметрыОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &КонтрольЗаПрошлыйПериод
		|			ТОГДА ЕСТЬNULL(РегистрацияСтоимостиАктивов.Ссылка, ""Документ 'Регистрация стоимости активов' не найден"")
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК РегистрацияСтоимостиАктивов,
		|	ЕСТЬNULL(РегистрацияСтоимостиАктивов.СЧАРынок, 0) КАК РегистрацияСтоимостиАктивов_СЧА,
		|	ЕСТЬNULL(РегистрацияСтоимостиАктивов.РСА, 0) КАК РегистрацияСтоимостиАктивов_РСА,
		|	ЕСТЬNULL(РегистрацияСтоимостиАктивов.РСА - РегистрацияСтоимостиАктивов.СЧАРынок, 0) КАК РегистрацияСтоимостиАктивов_КЗ
		|ИЗ
		|	_ПараметрыОтбора КАК _ПараметрыОтбора
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|		ПО (РегистрацияСтоимостиАктивов.Проведен)
		|			И _ПараметрыОтбора.Организация = РегистрацияСтоимостиАктивов.Организация
		|			И _ПараметрыОтбора.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
		|			И (_ПараметрыОтбора.Период = НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ))
		|			И _ПараметрыОтбора.ЦельРасчета = РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки";
	
	КонтрольЗаПрошлыйПериод = НачалоДня(Период) < НачалоДня(ТекущаяДатаСеанса());
	
	ДатаФормированияСЧА = ?(КонтрольЗаПрошлыйПериод, 
		НачалоДня(Период), 
		РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			Организация, 
			СчетДоверительногоУправления, 
			НачалоДня(ТекущаяДатаСеанса()) - 3600*24));
	
	Запрос.УстановитьПараметр("Период", ДатаФормированияСЧА);
	Запрос.УстановитьПараметр("КонтрольЗаПрошлыйПериод", КонтрольЗаПрошлыйПериод);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	СтруктураДокументов = Новый Структура("РегистрацияСтоимостиАктивов, РегистрацияСтоимостиАктивов_СЧА, РегистрацияСтоимостиАктивов_РСА, РегистрацияСтоимостиАктивов_КЗ");
	
	ЗаполнитьЗначенияСвойств(СтруктураДокументов, Выборка); 
		
	Возврат СтруктураДокументов;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыКонтроля(Период, Организация, СчетДоверительногоУправления)

	РеквизитыТекущейИД = ПолучитьИнвестиционнуюДекларацию(Период, Организация, СчетДоверительногоУправления);
	
	Если РеквизитыТекущейИД.ИнвестиционнаяДекларация <> Неопределено Тогда
	
		РеквизитыКонтроля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыТекущейИД.ИнвестиционнаяДекларация, "Консолидирующая, ИспользоватьЦелевоеЗначение");
		РеквизитыКонтроля.Вставить("ИнвестиционнаяДекларация", 	РеквизитыТекущейИД.ИнвестиционнаяДекларация);
		
		ДатаПроверкиСледующейИД = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), 7);
		РеквизитыНовойИД = ПолучитьИнвестиционнуюДекларацию(ДатаПроверкиСледующейИД, Организация, СчетДоверительногоУправления);
		
		Если РеквизитыТекущейИД.ИнвестиционнаяДекларация <> РеквизитыНовойИД.ИнвестиционнаяДекларация Тогда
			РеквизитыКонтроля.Вставить("ДатаПроверкиСледующейИД", РеквизитыНовойИД.Период);
		КонецЕсли; 		
		
	Иначе
		
		РеквизитыКонтроля = Новый Структура("ИнвестиционнаяДекларация, Консолидирующая, ИспользоватьЦелевоеЗначение", Неопределено, Ложь, Ложь);
	
	КонецЕсли; 
	
	РеквизитыКонтроля.Вставить("Клиент", Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период));
	РеквизитыКонтроля.Вставить("ВидДоговораДоверительногоУправления", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
	
	СтруктураДокументов = ПолучитьСтруктуруДокументов(Период, Организация, СчетДоверительногоУправления);
	Для каждого ЭлементСтруктуры Из СтруктураДокументов Цикл
		РеквизитыКонтроля.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла; 
	
	Возврат РеквизитыКонтроля;

КонецФункции

&НаСервере
Процедура ЗаполнитьСоставСовокупнойИнвестДекларации(ИнвестиционнаяДекларация = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период", НачалоДня(Объект.Период));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
		
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Индивидуально" Тогда
		
		Если Не (ЗначениеЗаполнено(Объект.Клиент) И ЗначениеЗаполнено(Объект.ВидДоговораДоверительногоУправления)) Тогда
			Возврат;
		КонецЕсли; 
		
		УстановитьПривилегированныйРежим(Истина);
		
		Если НачалоДня(Объект.Период) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Запрос.УстановитьПараметр("ДатаДокумента", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(Объект.Период) - 3600*24));
			Запрос.УстановитьПараметр("КонтрольЗаТекущийДень", Истина);
		Иначе
			Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(Объект.Период));
			Запрос.УстановитьПараметр("КонтрольЗаТекущийДень", Ложь);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		Запрос.УстановитьПараметр("КлиентТрадиция", ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция"));
		Запрос.УстановитьПараметр("СчетДУАтлант", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352"));
		Запрос.УстановитьПараметр("ДоступныеОрганизации", ПолучитьДоступныеОрганизации(Объект.Организация));
		Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
		Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", Объект.ВидДоговораДоверительногоУправления);
						
		#Область Текст_запроса
		РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(Объект.Клиент, Объект.Организация, Объект.Период, Истина, , Запрос.МенеджерВременныхТаблиц);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИСТИНА КАК Включен,
			|	&Период КАК Дата,
			|	_СчетаДоверительногоУправленияКлиента.Организация КАК Организация,
			|	&Клиент КАК Клиент,
			|	_СчетаДоверительногоУправленияКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ИЗ
			|	_СчетаДоверительногоУправленияКлиента КАК _СчетаДоверительногоУправленияКлиента
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО _СчетаДоверительногоУправленияКлиента.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
			|			И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления)";
		
		ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
		
		ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
		ОбработкаНаСервере.ПроверитьНастройкиПоСчетамДУ(ТаблицаСчетов);
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСчетов, "_ТаблицаСчетов", Запрос.МенеджерВременныхТаблиц);
		
		Если ЭтаФорма.РежимСовокукпногоКонтроля = "Совокупно" И ЗначениеЗаполнено(Объект.ИнвестиционнаяДекларация) Тогда
			
			Запрос.УстановитьПараметр("ИнвестиционнаяДекларация", Объект.ИнвестиционнаяДекларация);
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА _СоставСовокупнойИД.СчетДоверительногоУправления = &СчетДУАтлант
				|			ТОГДА &СчетДоверительногоУправления = &СчетДУАтлант
				|					ИЛИ &Период >= ДАТАВРЕМЯ(2021, 1, 1)
				|		ИНАЧЕ _СоставСовокупнойИД.Включен
				|	КОНЕЦ КАК Включен,
				|	_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	_СоставСовокупнойИД.Клиент КАК Клиент,
				|	_СоставСовокупнойИД.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
				|	СправочникСчетаДоверительногоУправления.Организация КАК Организация,
				|	СправочникСчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
				|	СправочникСчетаДоверительногоУправления.КодСчета КАК КодСчета,
				|	ВЫБОР
				|		КОГДА &КонтрольЗаТекущийДень
				|			ТОГДА """"
				|		ИНАЧЕ НЕ РегистрацияСтоимостиАктивов.Ссылка ЕСТЬ NULL
				|	КОНЕЦ КАК РегистрацияСтоимостиАктивов,
				|	_СоставСовокупнойИД.СчетДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
				|	СправочникСчетаДоверительногоУправления.Организация.Представление КАК ОрганизацияПредставление,
				|	РегистрацияСтоимостиАктивов.СЧАРынок КАК СЧА,
				|	РегистрацияСтоимостиАктивов.РСА КАК РСА,
				|	ИнвестиционныеДекларации.Ссылка КАК ИнвестиционнаяДекларация,
				|	ИнвестиционныеДекларации.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
				|	1 КАК ПорядокКонтроля,
				|	ИСТИНА КАК СовокупныйКонтроль,
				|	ИнвестиционныеДекларации.Наименование + (ВЫРАЗИТЬ(ИнвестиционныеДекларации.Комментарий КАК СТРОКА(1024))) КАК ИнвестиционнаяДекларацияПредставление,
				|	ЗНАЧЕНИЕ(Документ.НазначениеИнвестиционнойДекларации.ПустаяСсылка) КАК Назначение
				|ИЗ
				|	_ТаблицаСчетов КАК _СоставСовокупнойИД
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СправочникСчетаДоверительногоУправления
				|		ПО _СоставСовокупнойИД.СчетДоверительногоУправления = СправочникСчетаДоверительногоУправления.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
				|		ПО (РегистрацияСтоимостиАктивов.Проведен)
				|			И (СправочникСчетаДоверительногоУправления.Организация = РегистрацияСтоимостиАктивов.Организация)
				|			И _СоставСовокупнойИД.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
				|			И (&ДатаДокумента = НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ))
				|			И (РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
				|		ПО (ИнвестиционныеДекларации.Ссылка = &ИнвестиционнаяДекларация)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Организация,
				|	КодСчета";
			
		Иначе // режим Авто или Совокупно без указания ИД - заполняем по актуальным ИД
			
			Запрос.Текст = РегистрыСведений.ИнвестиционныеДекларации.ПолучитьТекстЗапросаДляПолученияАктуальныхИнвестиционныхДеклараций() + "
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|"
				+ 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА _СоставСовокупнойИД.СчетДоверительногоУправления = &СчетДУАтлант
				|			ТОГДА &СчетДоверительногоУправления = &СчетДУАтлант
				|					ИЛИ &Период >= ДАТАВРЕМЯ(2021, 1, 1)
				|		ИНАЧЕ _ТаблицаСчетов.Включен
				|	КОНЕЦ КАК Включен,
				|	_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	_СоставСовокупнойИД.Клиент КАК Клиент,
				|	_СоставСовокупнойИД.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
				|	СчетаДоверительногоУправления.Организация КАК Организация,
				|	СчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
				|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
				|	ВЫБОР
				|		КОГДА &КонтрольЗаТекущийДень
				|			ТОГДА """"
				|		ИНАЧЕ НЕ РегистрацияСтоимостиАктивов.Ссылка ЕСТЬ NULL
				|	КОНЕЦ КАК РегистрацияСтоимостиАктивов,
				|	_СоставСовокупнойИД.СчетДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
				|	СчетаДоверительногоУправления.Организация.Представление КАК ОрганизацияПредставление,
				|	РегистрацияСтоимостиАктивов.СЧАРынок КАК СЧА,
				|	РегистрацияСтоимостиАктивов.РСА КАК РСА,
				|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
				|	_СоставСовокупнойИД.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
				|	_СоставСовокупнойИД.ПорядокКонтроля КАК ПорядокКонтроля,
				|	_СоставСовокупнойИД.СовокупныйКонтроль КАК СовокупныйКонтроль,
				|	_СоставСовокупнойИД.ИнвестиционнаяДекларация.Наименование + (ВЫРАЗИТЬ(_СоставСовокупнойИД.ИнвестиционнаяДекларация.Комментарий КАК СТРОКА(1024))) КАК ИнвестиционнаяДекларацияПредставление,
				|	_СоставСовокупнойИД.Назначение КАК Назначение
				|ИЗ
				|	_СоставСовокупнойИД КАК _СоставСовокупнойИД
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
				|		ПО _СоставСовокупнойИД.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСчетов КАК _ТаблицаСчетов
				|		ПО _СоставСовокупнойИД.Организация = _ТаблицаСчетов.Организация
				|			И _СоставСовокупнойИД.СчетДоверительногоУправления = _ТаблицаСчетов.СчетДоверительногоУправления
				|			И _СоставСовокупнойИД.Дата = _ТаблицаСчетов.Дата
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
				|		ПО (РегистрацияСтоимостиАктивов.Проведен)
				|			И (СчетаДоверительногоУправления.Организация = РегистрацияСтоимостиАктивов.Организация)
				|			И _СоставСовокупнойИД.СчетДоверительногоУправления = РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
				|			И (&ДатаДокумента = НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ))
				|			И (РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
				|
				|УПОРЯДОЧИТЬ ПО
				|	_СоставСовокупнойИД.ПорядокКонтроля,
				|	_СоставСовокупнойИД.СовокупныйКонтроль УБЫВ,
				|	Организация,
				|	_СоставСовокупнойИД.ИнвестиционнаяДекларация,
				|	КодСчета";
		
		КонецЕсли; 
		
		
		#КонецОбласти	
		
	Иначе 
		// это режим Индивидуально. Контролим один счет ДУ по одной ИД
		// ИД из регистра не получаем, т.к. на форме должна быть заполнена
		Запрос.УстановитьПараметр("ИнвестиционнаяДекларация", Объект.ИнвестиционнаяДекларация);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИСТИНА КАК Включен,
			|	СправочникСчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
			|	СправочникСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
			|	СправочникСчетаДоверительногоУправления.Организация КАК Организация,
			|	СправочникСчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
			|	СправочникСчетаДоверительногоУправления.КодСчета КАК КодСчета,
			|	СправочникСчетаДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
			|	СправочникСчетаДоверительногоУправления.Организация.Представление КАК ОрганизацияПредставление,
			|	ИнвестиционныеДекларации.Ссылка КАК ИнвестиционнаяДекларация,
			|	ИнвестиционныеДекларации.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
			|	3 КАК ПорядокКонтроля,
			|	ЛОЖЬ КАК СовокупныйКонтроль,
			|	ИнвестиционныеДекларации.Наименование + (ВЫРАЗИТЬ(ИнвестиционныеДекларации.Комментарий КАК СТРОКА(1024))) КАК ИнвестиционнаяДекларацияПредставление,
			|	ЗНАЧЕНИЕ(Документ.НазначениеИнвестиционнойДекларации.ПустаяСсылка) КАК Назначение
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СправочникСчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
			|		ПО (ИнвестиционныеДекларации.Ссылка = &ИнвестиционнаяДекларация)
			|			И (СправочникСчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО СправочникСчетаДоверительногоУправления.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
			|			И СправочникСчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления";
		
	КонецЕсли; 
	
	ПолныйСоставИД = Запрос.Выполнить().Выгрузить();
	
	СтруктураОтбора = Новый Структура("СовокупныйКонтроль", Истина); 
	
	Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		СтруктураОтбора.Вставить("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	КонецЕсли; 
	
	СовокупныйКонтроль = ПолныйСоставИД.НайтиСтроки(СтруктураОтбора);
	Если ЭтаФорма.РежимСовокукпногоКонтроля = "Авто" Тогда
		ЭтаФорма.СовокупнаяИнвестДекларация = СовокупныйКонтроль.Количество() > 0;
		Если Не СовокупнаяИнвестДекларация Тогда
			ПолныйСоставИД = ПолныйСоставИД.Скопировать(Новый Структура("СчетДоверительногоУправления, ИнвестиционнаяДекларация", Объект.СчетДоверительногоУправления, ИнвестиционнаяДекларация));
			Объект.ИнвестиционнаяДекларация = ИнвестиционнаяДекларация;
		КонецЕсли; 
	КонецЕсли; 
	
	ПоместитьВоВременноеХранилище(ПолныйСоставИД, АдресСоставаСовокупнойИнвестДекларации);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеОрганизации(ТекущаяОрганизация)

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	
	Возврат ОбработкаНаСервере.ПолучитьДоступныеОрганизации(ТекущаяОрганизация); 

КонецФункции

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Назад(Команда)
	Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРезультатПроверки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКонтроль(Команда)
	
	Если Не ЭтаФорма.ВнешняяОбработка И ЭтаФорма.ВерсияДополнительногоОтчетаИлиОбработки <> АктуальнаяВерсияОбработки() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Версия Контроля ИД обновилась. Перезапустите Контроль ИД!");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен период контроля",,"Объект.Период", , Отказ);
	КонецЕсли; 
	
	Элементы.ПретрейдИзменен.Видимость = Ложь;
	Элементы.ИспользованыПредварительныеЦены.Видимость = Ложь;
	Элементы.ДатаМаксДД.Видимость = Ложь;
	
	Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
		
		Если ЭтаФорма.СовокупнаяИнвестДекларация Тогда
			
			Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен Клиент",,"Объект.Клиент", , Отказ);
			КонецЕсли; 
			Если Не ЗначениеЗаполнено(Объект.ВидДоговораДоверительногоУправления) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен Вид договора доверительного управления",,"Объект.ВидДоговораДоверительногоУправления", , Отказ);
			КонецЕсли; 
			
		Иначе
			
			Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет доверительного управления",,"Объект.СчетДоверительногоУправления", , Отказ);
			КонецЕсли; 
			Если Не ЗначениеЗаполнено(Объект.ИнвестиционнаяДекларация) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена инвестиционная декларация",,"Объект.ИнвестиционнаяДекларация", , Отказ);
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если Не Отказ Тогда
		
			ОчиститьСообщения();
			
			ЭтаФорма.ПараметрыПроверки = Новый Структура("Период, СчетДоверительногоУправления, РежимКонтроля, РежимГрупповогоКонтроля", 
				Объект.Период,
				Объект.СчетДоверительногоУправления,
				ЭтаФорма.РежимКонтроля,
				ЭтаФорма.РежимГрупповогоКонтроля); 
			
			ЭтаФорма.РезультатыПроверки.ПолучитьЭлементы().Очистить();
			РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументРезультатыКонтроля, "ФОРМИРОВАНИЕОТЧЕТА");
					
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРезультаты;
			Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРезультатПроверки;
			
			Состояние("Выполняется контроль инвестиционной декларации по клиенту", , СокрЛП(Объект.СчетДоверительногоУправления), БиблиотекаКартинок.КонтрольИнвестиционныхДеклараций);
			
			Если ВыполнитьКонтрольНаСервере() Тогда
				// Отчет по базису
				Если ЭтаФорма.СовокупнаяИнвестДекларация Тогда
					РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "НЕАКТУАЛЬНОСТЬ");
				Иначе
					
					ЭтаФорма.Базис = ПолучитьБазис(Объект.ИнвестиционнаяДекларация);
					ИспользуемыеБазисыПриИзменении(Неопределено);
					СформироватьБазис(Неопределено);					
				
				КонецЕсли; 

			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Отказ = Ложь;
		
		Если Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = Элементы.СтраницаГрупповойКонтроль Тогда
			ТекстСообщения = "группового контроля";
			ПараметрыОтбора = Новый Структура("Период", Объект.Период);
			НайденныеСтроки = Объект.СоставГрупповогоКонтроля.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() <> Объект.СоставГрупповогоКонтроля.Количество() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо перезаполнить состав " + ТекстСообщения,,,, Отказ);
			КонецЕсли; 
		ИначеЕсли Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = Элементы.СтраницаКонтрольЗаПериод Тогда
			ТекстСообщения = "контроля за период";
			ПараметрыОтбора = Новый Структура("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
			НайденныеСтроки = Объект.СоставГрупповогоКонтроля.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() <> Объект.СоставГрупповогоКонтроля.Количество() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо перезаполнить состав " + ТекстСообщения,,,, Отказ);
			КонецЕсли; 
		КонецЕсли;
				
		Если Объект.СоставГрупповогоКонтроля.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить таблицу " + ТекстСообщения,,,, Отказ);
		КонецЕсли; 
		
		Если Не Отказ Тогда
		
			ОчиститьСообщения();
			Объект.Претрейд.Очистить();
			
			ИзменитьДоступностьЭлементов(Ложь);
			
			ВыполнитьГрупповойКонтрольФоново();
			ЭтаФорма.ПодключитьОбработчикОжидания("ПроверитьСостояниеЗаданий", ЭтаФорма.ПериодОбновления);			
		
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчет(Команда)
	
	Если Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = Элементы.СтраницаИндивидуальныйКонтроль Тогда
		ВывестиСводныйОтчет();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСовокупнойИнвестДекларации(Команда)
	
	ПараметрыФормы = Новый Структура("АдресСоставаСовокупнойИнвестДекларации", АдресСоставаСовокупнойИнвестДекларации); 
	ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.СоставСовокупнойИнвестиционнойДекларации", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимКонтроляПриИзменении(Элемент)
	
	ЭтоИндивидуальныйКонтроль = ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль";
	Если ЭтоИндивидуальныйКонтроль Тогда
		Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = Элементы.СтраницаИндивидуальныйКонтроль;
	Иначе
		
		РежимГрупповогоКонтроляПриИзменении(Неопределено);
		Если Не Элементы.ФормаВыполнитьКонтроль.Видимость Тогда
			// контроль запущен
			ЭтаФорма.ПодключитьОбработчикОжидания("ПроверитьСостояниеЗаданий", ЭтаФорма.ПериодОбновления);
		КонецЕсли; 
		
	КонецЕсли;     	
	
	Элементы.ФормаПоказатьОтчет.Видимость = ЭтоИндивидуальныйКонтроль;
	Элементы.ФормаОтчетФидуциарнаяОтветственность.Видимость = ЭтоИндивидуальныйКонтроль;
	Элементы.ФормаОтчетФидуциарнаяОтветственностьРасшифровка.Видимость = ЭтоИндивидуальныйКонтроль;
	Элементы.ФормаОтчетФидуциарнаяОтветственностьСводный.Видимость = ЭтоИндивидуальныйКонтроль;
	Элементы.ФормаВыгрузитьОтчетФидуциарнаяОтветственность.Видимость = Не ЭтоИндивидуальныйКонтроль;
	Элементы.РежимГрупповогоКонтроля.Видимость = Не ЭтоИндивидуальныйКонтроль;
	Элементы.КомандаСкрытьНастройки.Видимость = ЭтоИндивидуальныйКонтроль;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоСоставуИД(Команда)
	ОткрытьФорму("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.ФормаОтчетаПоСоставуИД",, ЭтаФорма, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчетФидуциарнаяОтветственность(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Заголовок = "Укажите каталог выгрузки"; 
	
	Диалог.Показать(Новый ОписаниеОповещения("ВыгрузитьОтчетФидуциарнаяОтветственностьЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОтчетФидуциарнаяОтветственностьЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда 
		
		Состояние("Выгрузка отчетов...");
		
		КаталогВыгрузки = Диалог.Каталог;
		Если Не СтрЗаканчиваетсяНа(КаталогВыгрузки, "\") Тогда
			КаталогВыгрузки = КаталогВыгрузки + "\";
		КонецЕсли; 
		
		Массив = ВыгрузитьОтчетыПоФидуциарнойОтветственности();
		
		Для каждого ТекЭл Из Массив Цикл
			ТекЭл.ТабличныйДокумент.Записать(КаталогВыгрузки + ТекЭл.ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		КонецЦикла; 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена");
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

#Область ПроцедурыКонтроля

#Область ФоновоеВыполнение

&НаСервере
Процедура ВыполнитьГрупповойКонтрольФоново()

	Для каждого ТекСтрока Из Объект.СоставГрупповогоКонтроля Цикл
		ТекСтрока.ИдентификаторРезультата = Новый УникальныйИдентификатор;
		ТекСтрока.Статус	= "";
		ТекСтрока.Выполнено	= -1;
	КонецЦикла;
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("Организация", 					Объект.Организация);
	ПараметрыВыполнения.Вставить("Период", 							Объект.Период);
	ПараметрыВыполнения.Вставить("УчитыватьПлановыеОперации", 		?(ЭтаФорма.РежимГрупповогоКонтроля = "ЗаПериод", Ложь, Объект.Период >= НачалоДня(ТекущаяДатаСеанса())));
	ПараметрыВыполнения.Вставить("ДинамическийРасчетСтоимости",		Объект.ДинамическийРасчетСтоимости);
	ПараметрыВыполнения.Вставить("УниакльныйИдентификаторФормы",	ЭтаФорма.УникальныйИдентификатор);
	ПараметрыВыполнения.Вставить("СоставГрупповогоКонтроля",		Объект.СоставГрупповогоКонтроля.Выгрузить(, "СчетДоверительногоУправления, ИнвестиционнаяДекларация, Клиент, ВидДоговораДоверительногоУправления,  Период, ИдентификаторРезультата"));
	ПараметрыВыполнения.Вставить("МаксимумАктивныхЗаданий",			ЭтаФорма.МаксимумАктивныхЗаданий);
	ПараметрыВыполнения.Вставить("НаименованиеЗадания",				"Контроль инвестиционвной декларации (" + ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса + ")");
	
	СоставыСовокупныхИД = Неопределено;
	
	Для каждого Строка Из Объект.СоставГрупповогоКонтроля Цикл
	
		Если СоставыСовокупныхИД = Неопределено Тогда
		
			СоставыСовокупныхИД = Строка.СоставСовокупнойИнвестиционнойДекларации.Выгрузить();
			СоставыСовокупныхИД.Колонки.Добавить("ИдентификаторРезультата", Новый ОписаниеТипов("УникальныйИдентификатор"));
			СоставыСовокупныхИД.ЗаполнитьЗначения(Строка.ИдентификаторРезультата, "ИдентификаторРезультата")
			
		Иначе
			
			Для каждого СтрокаСовокупной Из Строка.СоставСовокупнойИнвестиционнойДекларации Цикл
			
				НоваяСтрока = СоставыСовокупныхИД.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСовокупной);
				НоваяСтрока.ИдентификаторРезультата = Строка.ИдентификаторРезультата;
			
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ПараметрыВыполнения.Вставить("СоставыСовокупныхИД", СоставыСовокупныхИД);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ЭтоВнешняяОбработка", Истина);
	
	ИспользуемоеИмяФайла = РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
	Если Лев(ИспользуемоеИмяФайла, 18) = "e1cib\tempstorage\" Тогда
		ПараметрыПроцедуры.Вставить("ДополнительнаяОбработкаСсылка", ПолучитьСсылкуНаВнешнююОбработку());
		ПараметрыПроцедуры.Вставить("ИмяОбработки", "_КонтрольИнвестиционныхДеклараций");
	Иначе
		ПараметрыПроцедуры.Вставить("ДополнительнаяОбработкаСсылка", Неопределено);
		ПараметрыПроцедуры.Вставить("ИмяОбработки", ИспользуемоеИмяФайла);
	КонецЕсли; 
	
	ПараметрыПроцедуры.Вставить("ИмяМетода", "ВыполнитьГрупповойКонтрольФоново");
	ПараметрыПроцедуры.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(ПараметрыВыполнения);
	ЭтаФорма.СессияСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		"_КонтрольИнвестиционныхДеклараций.ВыполнитьГрупповойКонтрольФоново", 
		ПараметрыВыполненияДляСбораСтатистики.Хранилище, 
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	РезультатЗапуска = РаботаСДлительнымиОперациями.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"РаботаСДлительнымиОперациями.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыПроцедуры,
		"Групповой контроль инвестиционных деклараций",
		Ложь,
		Ложь
	);
	
	ЭтаФорма.ИдентификаторЗадания = РезультатЗапуска.ИдентификаторЗадания;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСостояниеЗаданий()
	
	Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
		ОтключитьОбработчикОжидания("ПроверитьСостояниеЗаданий");
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьСостоянияЗаданийНаСервере();
	
	НезапущенныеЗадания	= Объект.СоставГрупповогоКонтроля.НайтиСтроки(Новый Структура("Статус", ""));
	НезапущенныхЗаданий	= НезапущенныеЗадания.Количество();
	
	Если НезапущенныхЗаданий = 0 Тогда 
		
		ИзменитьДоступностьЭлементов(Истина);
		
		Состояние("Выполнение группового контроля завершено",,, БиблиотекаКартинок.КонтрольИнвестиционныхДеклараций);
		ОтключитьОбработчикОжидания("ПроверитьСостояниеЗаданий");
		
		ЗарегистрироватьОкончаниеСессииСбораСтатистики(ЭтаФорма.СессияСбораСтатистики, Ложь);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДоступностьЭлементов(Доступность)

	Элементы.ФормаВыполнитьКонтроль.Видимость 				= Доступность;
	Элементы.ФормаОстановитьВыполнениеКонтроля.Видимость	= Не Доступность;
	
	Элементы.РежимГрупповогоКонтроля.Доступность 			= Доступность;
	
	Элементы.ШапкаГрупповойКонтроль.Доступность 			= Доступность;
	Элементы.ЗаполнениеСпискаГрупповойКонтроль.Доступность 	= Доступность;
	Элементы.СоставГрупповогоКонтроля.ТолькоПросмотр 		= Не Доступность;
	
	Элементы.ШапкаКонтрольЗаПериод.Доступность 				= Доступность;
	Элементы.ЗаполнениеСпискаКонтрольЗаПериод.Доступность 	= Доступность;
	Элементы.СоставКонтроляЗаПериод.ТолькоПросмотр 			= Не Доступность;
	
	Элементы.ФормаВыгрузитьОтчетФидуциарнаяОтветственность.Доступность = Доступность;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостоянияЗаданийНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СоставГрупповогоКонтроля", Объект.СоставГрупповогоКонтроля.Выгрузить(, "ИдентификаторРезультата, Статус"));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставГрупповогоКонтроля.ИдентификаторРезультата КАК ИдентификаторРезультата
		|ПОМЕСТИТЬ _СоставГрупповогоКонтроля
		|ИЗ
		|	&СоставГрупповогоКонтроля КАК СоставГрупповогоКонтроля
		|ГДЕ
		|	(ВЫРАЗИТЬ(СоставГрупповогоКонтроля.Статус КАК СТРОКА(1024))) = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения,
		|	ХранилищеЗначений.ДатаСоздания КАК ДатаСоздания
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СоставГрупповогоКонтроля КАК _СоставГрупповогоКонтроля
		|		ПО ХранилищеЗначений.Идентификатор = _СоставГрупповогоКонтроля.ИдентификаторРезультата
		|			И (ХранилищеЗначений.Источник = ""_КонтрольИнвестиционныхДеклараций"")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПроверкаПройдена = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
	Нарушение = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
	Пока Выборка.Следующий() Цикл
	
		ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиСтроки(Новый Структура("ИдентификаторРезультата", Выборка.Идентификатор))[0];
		
		Значение = Выборка.ХранилищеЗначения.Получить();
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			
			ТекстОшибки = "Не удалось выполнить проверку по клиенту " + ТекСтрока.СчетДоверительногоУправления + ?(ЗначениеЗаполнено(Значение), ". " + Значение, "");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			ТекСтрока.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля;
			ТекСтрока.РезультатПроверкиВн = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля;
			ТекСтрока.РезультатПроверкиИтог = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля;
			ТекСтрока.Гиперссылка = "";
			ТекСтрока.ОшибкиОценки = Ложь;
			ТекСтрока.Статус = "Завершено аварийно";
			ТекСтрока.ДатаПроверки = Выборка.ДатаСоздания;
			
		ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
			
			РезультатПроверкиДерева = Значение.РезультатПроверкиДерева;
			ТекСтрока.РезультатПроверки = РезультатПроверкиДерева.РезультатПроверки;
			ТекСтрока.РезультатПроверкиВн = РезультатПроверкиДерева.РезультатПроверкиВн;
			ТекСтрока.РезультатПроверкиИтог = ?(РезультатПроверкиДерева.РезультатПроверкиВн = Нарушение Или РезультатПроверкиДерева.РезультатПроверки = Нарушение, Нарушение, ПроверкаПройдена);
			ТекСтрока.Гиперссылка = "Перейти к расшифровке";
			ТекСтрока.ОшибкиОценки = Значение.ОшибкиОценки;
			ТекСтрока.Статус = "Завершено";
			ТекСтрока.ДатаПроверки = Выборка.ДатаСоздания;
			
		КонецЕсли; 
	
	КонецЦикла;  

КонецПроцедуры
 
&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаВнешнююОбработку()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = ""_КонтрольИнвестиционныхДеклараций""";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		ВызватьИсключение "Не удалось найти обработку ""Контроль инвестиционных деклараций""";
	КонецЕсли; 
	
КонецФункции
 
#КонецОбласти 

&НаСервере
Функция ВыполнитьКонтрольНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыФормирования = Новый Структура("Организация, СчетДоверительногоУправления, Период, Клиент, ВидДоговораДоверительногоУправления");
	ЗаполнитьЗначенияСвойств(ПараметрыФормирования, Объект);
	ПараметрыФормирования.Вставить("Механизм", 							"_КонтрольИнвестиционныхДеклараций.Форма.ВыполнитьКонтрольНаСервере()");
	ПараметрыФормирования.Вставить("ИнвестиционнаяДекларация", 			Объект.ИнвестиционнаяДекларация);
	ПараметрыФормирования.Вставить("УчитыватьПлановыеОперации", 		Объект.УчитыватьПлановыеОперации);
	ПараметрыФормирования.Вставить("Претрейд", 							Объект.Претрейд.Выгрузить());
	ПараметрыФормирования.Вставить("ДинамическийРасчетСтоимости",		Объект.ДинамическийРасчетСтоимости);
	ПараметрыФормирования.Вставить("СоставСовокупнойИнвестДекларации", 	ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации));
		
	СовокупныйКонтроль = ПараметрыФормирования.СоставСовокупнойИнвестДекларации.НайтиСтроки(Новый Структура("СовокупныйКонтроль, СчетДоверительногоУправления", Истина, ПараметрыФормирования.СчетДоверительногоУправления));
	ПараметрыФормирования.Вставить("СовокупнаяИнвестДекларация", СовокупныйКонтроль.Количество() > 0);
	
	Дерево = РеквизитФормыВЗначение("РезультатыПроверки");
	ОбработкаОбъект.ПроверитьИнвестДекларацию(ПараметрыФормирования, Дерево.Строки);
	
	Отказ = Ложь;
	Если ПараметрыФормирования.Свойство("ТекстОшибки") Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПараметрыФормирования.ТекстОшибки,,,, Отказ); 
		ЭтаФорма.РезультатыПроверки.ПолучитьЭлементы().Очистить();
				
	Иначе
		
		ЗначениеВРеквизитФормы(Дерево, "РезультатыПроверки");
		
		ЗаполнитьОтчетПоРезультатамКонтроляНаСервере(Дерево);
		
		СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
		СтруктураРезультатовПроверки.Вставить("РезультатыПроверки", 				Дерево);
				
		СтруктураРезультатовПроверки.Вставить("СтруктураФормированияОтчета", 		ПараметрыФормирования.СтруктураФормированияОтчета);
		СтруктураРезультатовПроверки.Вставить("ПараметрыБазисов", 					ПараметрыФормирования.ПараметрыБазисов);
		СтруктураРезультатовПроверки.Вставить("СтруктураОтчетов", 					ПараметрыФормирования.СтруктураОтчетов);
		СтруктураРезультатовПроверки.Вставить("Организация", 						ПараметрыФормирования.Организация);
		СтруктураРезультатовПроверки.Вставить("СчетДоверительногоУправления", 		ПараметрыФормирования.СчетДоверительногоУправления);
		СтруктураРезультатовПроверки.Вставить("ИнвестиционнаяДекларация", 			ПараметрыФормирования.ИнвестиционнаяДекларация);
		СтруктураРезультатовПроверки.Вставить("Период", 							ПараметрыФормирования.Период);
		СтруктураРезультатовПроверки.Вставить("ДинамическийРасчетСтоимости",		ПараметрыФормирования.ДинамическийРасчетСтоимости);
		СтруктураРезультатовПроверки.Вставить("УчитыватьПлановыеОперации",			ПараметрыФормирования.УчитыватьПлановыеОперации);
		СтруктураРезультатовПроверки.Вставить("Претрейд",							ПараметрыФормирования.Претрейд);
		СтруктураРезультатовПроверки.Вставить("СоставСовокупнойИнвестДекларации",	ПараметрыФормирования.СоставСовокупнойИнвестДекларации);
		СтруктураРезультатовПроверки.Вставить("Клиент",								ПараметрыФормирования.Клиент);
		СтруктураРезультатовПроверки.Вставить("ВидДоговораДоверительногоУправления", ПараметрыФормирования.ВидДоговораДоверительногоУправления);
		
		Если ПараметрыФормирования.Свойство("ИспользованыПредварительныеЦены") Тогда
			Элементы.ИспользованыПредварительныеЦены.Видимость = Истина;
		КонецЕсли;
		
		Если ПараметрыФормирования.Свойство("ДатаМаксДД") Тогда
			ПоказатьДекорациюДатаМаксДД(ПараметрыФормирования.ДатаМаксДД);
		КонецЕсли;
		
		ПоместитьВоВременноеХранилище(СтруктураРезультатовПроверки, ЭтаФорма.АдресСтруктурыРезультатовПроверки);
		
		ЗаполнитьТабличныйДокументЦеныПоступлений();
		ЗаполнитьТабличныйДокументОшибкиОценки();
		ЗаполнитьТабличныйДокументРазличияОценки();
		ЗаполнитьТабличныйДокументПлановыеДанные();
		ЗаполнитьТабличныйДокументЦеныТМинус2();
		
		Для каждого Группа Из Элементы.ГруппаРезультатыОценкиСтраницы.ПодчиненныеЭлементы Цикл
		
			Если Группа.Видимость Тогда
			
				Элементы.ГруппаРезультатыОценки.Показать();
				Прервать;
			
			КонецЕсли;			
		
		КонецЦикла; 
		
		ОшибкиОценки = Ложь;
		МассивТаблиц = СтрРазделить(СтрЗаменить("ТаблицаРасхожденийЦен, ТаблицаОшибокОценки, РасхожденияСтоимостейЦенныхБумаг, РасхожденияСтоимостейАктивов, ТаблицаЦенТМинус2, ТаблицаОшибокСафмар", " ", ""), ",", Ложь); 
		СтруктураОтчетов = ПараметрыФормирования.Отчеты.Получить();
		Для каждого ИмяТаблицы Из МассивТаблиц Цикл
			Если СтруктураОтчетов.Свойство(ИмяТаблицы) И ТипЗнч(СтруктураОтчетов[ИмяТаблицы]) = Тип("ТаблицаЗначений") И СтруктураОтчетов[ИмяТаблицы].Количество() > 0 Тогда
				ОшибкиОценки = Истина;
				Прервать;
			КонецЕсли; 
		КонецЦикла;
		
		РезультатПроверки = ОбработкаОбъект.ПолучитьСтруктуруРезультатаПроверки(СтруктураРезультатовПроверки, ОшибкиОценки, ОбработкаОбъект.ПолучитьРезультатПроверкиДерева(Дерево));
		РезультатПроверки.Вставить("ИспользованыПредварительныеЦены", ПараметрыФормирования.Свойство("ИспользованыПредварительныеЦены"));
		РезультатПроверки.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
		РезультатПроверки.Вставить("РежимСовокукпногоКонтроля", ЭтаФорма.РежимСовокукпногоКонтроля);
		Если ПараметрыФормирования.Свойство("ДатаМаксДД") Тогда
			РезультатПроверки.Вставить("ДатаМаксДД", ПараметрыФормирования.ДатаМаксДД);
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура("Организация, Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация");
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, Объект);
		СтруктураОтбора.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
		СтруктураОтбора.Вставить("РежимСовокукпногоКонтроля", ЭтаФорма.РежимСовокукпногоКонтроля);
		ОбработкаОбъект.ДобавитьЗаписьВХранилищеЗначений(Новый УникальныйИдентификатор, РезультатПроверки, СтруктураОтбора);
		
	КонецЕсли;
	
	ПолучитьРезультатыКонтроляНаСервере();
	
	Возврат Не Отказ;
					
КонецФункции

&НаСервере
Процедура ЗаполнитьТабличныйДокументЦеныПоступлений() 

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	СтруктураОтчетов = СтруктураРезультатовПроверки.СтруктураОтчетов.Получить(); 
	
	ТаблицаРасхожденийЦен = Неопределено;
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		СтруктураОтчетов.Свойство("ТаблицаРасхожденийЦен", ТаблицаРасхожденийЦен);
	КонецЕсли;
	
	ТабличныйДокументЦеныПоступлений.Очистить();
	
	Если Не ТаблицаРасхожденийЦен = Неопределено И ТаблицаРасхожденийЦен.Количество() > 0 Тогда
		
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		Строка = Макет.ПолучитьОбласть("Строка");
	
		Элементы.ГруппаЦеныПоступлений.Видимость = Истина;
		Элементы.ГруппаЦеныПоступлений.ЦветТекстаЗаголовка = Новый Цвет;
		
		ТабличныйДокументЦеныПоступлений.Вывести(Макет.ПолучитьОбласть("Шапка"));
		
		ТаблицаРасхожденийЦен.Свернуть("Рынок, ЦеннаяБумага, ЦенаПриобретения, СправедливаяЦена, Отклонение");
		Для каждого ТекСтрока Из ТаблицаРасхожденийЦен Цикл
			
			Строка.Параметры.Заполнить(ТекСтрока);
			
			Если ТекСтрока.Отклонение >= 5 Тогда
				Элементы.ГруппаЦеныПоступлений.ЦветТекстаЗаголовка = WebЦвета.Красный;
				Строка.Область(1,,1).ЦветТекста = WebЦвета.Красный;
			Иначе
				Строка.Область(1,,1).ЦветТекста = Новый Цвет;
			КонецЕсли; 
		    
			ТабличныйДокументЦеныПоступлений.Вывести(Строка);
			
		КонецЦикла; 
			
	Иначе
		Элементы.ГруппаЦеныПоступлений.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

