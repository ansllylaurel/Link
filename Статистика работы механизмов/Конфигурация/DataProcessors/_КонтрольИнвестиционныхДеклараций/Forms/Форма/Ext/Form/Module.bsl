&НаСервере
Процедура ЗаполнитьТабличныйДокументРазличияОценки()

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	СтруктураОтчетов = СтруктураРезультатовПроверки.СтруктураОтчетов.Получить();
	
	РасхожденияСтоимостейЦенныхБумаг = Неопределено;
	РасхожденияСтоимостейАктивов = Неопределено;
	
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		СтруктураОтчетов.Свойство("РасхожденияСтоимостейЦенныхБумаг", РасхожденияСтоимостейЦенныхБумаг);
		СтруктураОтчетов.Свойство("РасхожденияСтоимостейАктивов", РасхожденияСтоимостейАктивов);
	КонецЕсли;
	
	ТабличныйДокументРазличияОценки.Очистить();
		
	Если (Не РасхожденияСтоимостейЦенныхБумаг = Неопределено И РасхожденияСтоимостейЦенныхБумаг.Количество() > 0)
		Или (Не РасхожденияСтоимостейАктивов = Неопределено И РасхожденияСтоимостейАктивов.Количество() > 0) Тогда
		
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		
		Если Не РасхожденияСтоимостейЦенныхБумаг = Неопределено И РасхожденияСтоимостейЦенныхБумаг.Количество() > 0 Тогда
		
			ТабличныйДокументРазличияОценки.Вывести(Макет.ПолучитьОбласть("РазличияОценкиШапкаЦБ"));
		
			РасхожденияСтоимостейЦенныхБумаг.Свернуть("Рынок, ЦеннаяБумага, ЦенаИзДокумента, ЦенаКупонаИзДокумента, ЦенаРасчетная, ЦенаКупонаРасчетная");
			Строка = Макет.ПолучитьОбласть("РазличияОценкиСтрокаЦБ");
			Для каждого ТекСтрока Из РасхожденияСтоимостейЦенныхБумаг Цикл
				
				Строка.Параметры.Заполнить(ТекСтрока);
				ТабличныйДокументРазличияОценки.Вывести(Строка);
				
			КонецЦикла; 
		
		КонецЕсли; 
		
		Если Не РасхожденияСтоимостейАктивов = Неопределено И РасхожденияСтоимостейАктивов.Количество() > 0 Тогда
		
			ТабличныйДокументРазличияОценки.Вывести(Макет.ПолучитьОбласть("РазличияОценкиШапка"));
		
			РасхожденияСтоимостейАктивов.Свернуть("ВидАктива, СубъектАналитики, Контрагент, Основание, ВидЗадолженности, СуммаРынокВВалютеУчетаИзДокумента, СуммаРынокВВалютеУчетаРасчетная");
			Строка = Макет.ПолучитьОбласть("РазличияОценкиСтрока");
			Для каждого ТекСтрока Из РасхожденияСтоимостейАктивов Цикл
				
				Строка.Параметры.Заполнить(ТекСтрока);
				ТабличныйДокументРазличияОценки.Вывести(Строка);
				
			КонецЦикла; 
		
		КонецЕсли; 
		
		Элементы.ГруппаРазличияОценки.Видимость = Истина;
		
	Иначе
		Элементы.ГруппаРазличияОценки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныйДокументПлановыеДанные() 

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	СтруктураОтчетов = СтруктураРезультатовПроверки.СтруктураОтчетов.Получить();
	
	ТабличныйДокументПлановыеДанные.Очистить();
	
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПлановыеДанные");
		Для каждого Отчет Из СтруктураОтчетов Цикл
		    Если СтрНачинаетсяС(Отчет.Ключ, "_ПлановыеДанные_") И Отчет.Значение.Количество() > 0 Тогда
				
				НазваниеОтчета = СтрЗаменить(Отчет.Ключ, "_ПлановыеДанные_", "");
				Шапка 	= Макет.ПолучитьОбласть(НазваниеОтчета + "_Шапка");
				Строка 	= Макет.ПолучитьОбласть(НазваниеОтчета + "_Строка");
				
				ТабличныйДокументПлановыеДанные.Вывести(Шапка);
				
				Для каждого ТекСтрока Из Отчет.Значение Цикл
					Если Отчет.Ключ = "_ПлановыеДанные_ОстаткиДС" И ТекСтрока.РасчетныйСчет = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В плановых данных по остаткам денежных средств не удалось определить расчетный счет");
					КонецЕсли; 
					Строка.Параметры.Заполнить(ТекСтрока);
					ТабличныйДокументПлановыеДанные.Вывести(Строка);
				КонецЦикла; 
				
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

#КонецОбласти 

#Область ВыводРезультатаПроверки

&НаСервере
Процедура ВывестиСводныйОтчет(ФидуциарнаяОтветственность = Ложь, СвободныеЛимиты = Ложь, Расшифровка = Ложь)

	ЭтаФорма.ДокументРезультат = Новый ТабличныйДокумент;
	
	Если ФидуциарнаяОтветственность Тогда
		
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		Шапка = Макет.ПолучитьОбласть("ШапкаФидуциарнаяОтветственность");
		Шапка.Параметры.Заполнить(ПолучитьПараметрыЗаголовка(Объект.СчетДоверительногоУправления, Объект.Период));
		ЭтаФорма.ДокументРезультат.Вывести(Шапка);
		
	Иначе
		
		ИспользуемыеБазисы = ПолучитьСписокИспользуемыхБазисов(Объект.ИнвестиционнаяДекларация);
	
		Для каждого ТекБазис Из ИспользуемыеБазисы Цикл
		
			ИспользуемыеБазисыПриИзмененииНаСервере(ТекБазис, Истина);
		
			ПараметрыФормирования = Новый Структура("Настройка, Организация, СчетДоверительногоУправления, Период, АдресДанныхРасшифровкиБазиса, АдресСКДБазиса, Базис, АдресПараметровБазисов");  
			ЗаполнитьЗначенияСвойств(ПараметрыФормирования, Объект);
			ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ЭтаФорма);
			ПараметрыФормирования.Вставить("Базис", ТекБазис);
			ПараметрыФормирования.Вставить("АвтоматическоеФормирование", Истина);
			ПараметрыФормирования.Вставить("АдресСоставаСовокупнойИнвестДекларации", ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации);
			ПараметрыФормирования.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
			ПараметрыФормирования.Вставить("ВыводитьПараметрыДанных", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
			ПараметрыФормирования.Вставить("ВыводитьЗаголовок", ТипВыводаТекстаКомпоновкиДанных.Выводить);
			ПараметрыФормирования.Вставить("Заголовок", ТекБазис.Наименование);
			
			ЭтаФорма.ДокументРезультат.Вывести(ПолучитьТабличныйДокументБазиса(ПараметрыФормирования));
		
		КонецЦикла; 
	
	КонецЕсли; 
	
	Если СвободныеЛимиты Тогда
		Отчет = ПолучитьОтчетПоСведнымЛимитам(ПолучитьСвободныеЛимиты(), Макет, Расшифровка);
	Иначе
		Отчет = ПолучитьТабличныйДокумент("", 0, "", ФидуциарнаяОтветственность);
	КонецЕсли; 
	
	ЭтаФорма.ДокументРезультат.Вывести(Отчет);
	Элементы.ДокументРезультат.ТекущаяОбласть = ЭтаФорма.ДокументРезультат.Область(1, 1);
	Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРасшифровка;

КонецПроцедуры

&НаСервере
Функция ПолучитьСвободныеЛимиты()

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	Если Не СтруктураРезультатовПроверки.Свойство("СтруктураФормированияОтчета") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала необходимо выполнить контроль");
		Возврат Неопределено;
	КонецЕсли; 
	Структура = СтруктураРезультатовПроверки.СтруктураФормированияОтчета.Получить();
	Настройки = Структура.Настройки;
	МассивУдаляемыхЭлементовСтруктуры = Новый Массив;
	
	ИсключаемыеЗаголовки = СтрРазделить("Дельта (руб)", ",", Ложь);
	СписокДоступныхПолей = СтрРазделить("Основные.ВидАктива,Основные.Эмитент,Основные.Актив,ЦенныеБумаги.КатегорияОблигации,ЦенныеБумаги.ПодкатегорияОблигации,Основные.ГоловнаяОрганизация," +
		"Показатели.Сумма,Показатели.СуммаПоРЕПО,Показатели.СуммаБезРЕПО,ЦенныеБумаги.Количество,ЦенныеБумаги.КоличествоПоРЕПО,ЦенныеБумаги.КоличествоСвободные,СвязанныеЛицаГруппыКомпаний.Родитель," +
		"ДоляСумма,ДоляСуммаПоРЕПО,ДоляСуммаБезРЕПО,ДоляДоляКоличество,ДоляКоличествоПоРЕПО,ДоляКоличествоСвободные,СвязанныеЛицаИнфинитум.Родитель", ",", Ложь);
	Для Индекс = 0 По СписокДоступныхПолей.ВГраница() Цикл
		СписокДоступныхПолей[Индекс] = Новый ПолеКомпоновкиДанных(СписокДоступныхПолей[Индекс]);
	КонецЦикла; 
	ПолеКоличество = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Количество");
					
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТаблицаПоказателей = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьОписаниеКонтролируемыхПоказателей("Основной");
	
	МассивРезультатов = Новый Массив;
	
	ОписаниеТиповЦенныеБумаги = Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип;
	ОписаниеТиповДенежныеСуммы = Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;

	ТаблицаЛимитов = Новый ТаблицаЗначений;
	ТаблицаЛимитов.Колонки.Добавить("ВидАктива", Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
	ТаблицаЛимитов.Колонки.Добавить("Актив", ОписаниеТиповЦенныеБумаги);
	ТаблицаЛимитов.Колонки.Добавить("Эмитент", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ТаблицаЛимитов.Колонки.Добавить("Набор", Новый ОписаниеТипов("Строка"));
	ТаблицаЛимитов.Колонки.Добавить("Сумма", ОписаниеТиповДенежныеСуммы);
	ТаблицаЛимитов.Колонки.Добавить("МаксимальныйЛимит", ОписаниеТиповДенежныеСуммы);
	ТаблицаЛимитов.Колонки.Добавить("СвободныйЛимит", ОписаниеТиповДенежныеСуммы);
	
	Для каждого СтрокаРезультатыПроверки Из СтруктураРезультатовПроверки.РезультатыПроверки.Строки Цикл
	
		ИмяВложенногоОбъекта = СтрокаРезультатыПроверки.ИмяВложенногоОбъекта;
		НомерБазиса = СтрокаРезультатыПроверки.НомерБазиса;
		ИмяПоляДоля = СтрокаРезультатыПроверки.ИмяПоляДоля;
		ИмяПоказателя = ТаблицаПоказателей.Найти(СтрокаРезультатыПроверки.КонтролируемыйПоказатель, "Представление");
		
		Для каждого ВложенныйОбъект Из Настройки.Структура Цикл
		
			//Если ВложенныйОбъект.Имя = ИмяВложенногоОбъекта И Не СтрЗаканчиваетсяНа(ВложенныйОбъект.Имя, "_Пустая") Тогда
			// не пропускаем пустые для корректной работы наборов в дефолтными или не торгуемыми бумагами
			Если ВложенныйОбъект.Имя = ИмяВложенногоОбъекта Или ВложенныйОбъект.Имя = ИмяВложенногоОбъекта + " Пустая" Тогда
				
				Если СтрНачинаетсяС(ВложенныйОбъект.ИдентификаторОбъекта, "ВложеннаяСхема_") И СтрНайти(ВложенныйОбъект.ИдентификаторОбъекта, "_ДоляСумма") > 0 Тогда
				
					НастройкиВложенногоОтчета = ВложенныйОбъект.Настройки;
					НастройкиВложенногоОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
					
					НайденСвободныйЛимит = Ложь;
					НайденоКоличество = Ложь;
					
					Для каждого ПолеВыбора Из НастройкиВложенногоОтчета.Выбор.Элементы Цикл
						
						Если НайденСвободныйЛимит И НайденоКоличество Тогда
							ПолеВыбора.Использование = Ложь;
						Иначе
							Если ЗначениеЗаполнено(ПолеВыбора.Заголовок) Тогда
								ПолеВыбора.Использование = (ИсключаемыеЗаголовки.Найти(ПолеВыбора.Заголовок) = Неопределено);
								НайденСвободныйЛимит = НайденСвободныйЛимит Или ПолеВыбора.Заголовок = "Свободный лимит (руб)";
							Иначе
								ПолеВыбора.Использование = (СписокДоступныхПолей.Найти(ПолеВыбора.Поле) <> Неопределено);
								НайденоКоличество = НайденоКоличество Или ПолеВыбора.Поле = ПолеКоличество;
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;
					
					ВложеннаяСКД = Структура.СКД.ВложенныеСхемыКомпоновкиДанных.Найти(ВложенныйОбъект.ИдентификаторОбъекта);
					Результат = ОбработкаОбъект.ПолучитьРезультатКомпоновки(ВложеннаяСКД.Схема, ВложенныйОбъект.Настройки, Структура.ВнешниеНаборыДанных, Истина);
					
					ИмяПоляМаксимальныйЛимит = "";
					ИмяПоляСвободныйЛимит = "";
					
					Для каждого ПользовательскоеПоле Из ВложенныйОбъект.Настройки.ПользовательскиеПоля.Элементы Цикл
						
						Если ПользовательскоеПоле.Заголовок = "Максимальный лимит" Тогда
							ИмяПоляМаксимальныйЛимит = СтрЗаменить(ПользовательскоеПоле.ПутьКДанным, ".", "");
						ИначеЕсли ПользовательскоеПоле.Заголовок = "Свободный лимит" Тогда
							ИмяПоляСвободныйЛимит = СтрЗаменить(ПользовательскоеПоле.ПутьКДанным, ".", "");
						КонецЕсли;
						
					КонецЦикла; 
					
					Для каждого СтрокаПервогоУровня Из Результат Цикл
						Для каждого СтрокаТаблицы Из СтрокаПервогоУровня.Строки Цикл
						
							Если ЗначениеЗаполнено(СтрокаТаблицы.ОсновныеАктив) И ОписаниеТиповЦенныеБумаги.СодержитТип(ТипЗнч(СтрокаТаблицы.ОсновныеАктив)) Тогда
							
								НоваяСтрока = ТаблицаЛимитов.Добавить();
								НоваяСтрока.ВидАктива 	= РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(СтрокаТаблицы.ОсновныеАктив);
								НоваяСтрока.Актив 		= СтрокаТаблицы.ОсновныеАктив;
								НоваяСтрока.Эмитент 	= СтрокаТаблицы.ОсновныеЭмитент;
								НоваяСтрока.Набор 		= ВложенныйОбъект.Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Заголовок")).Значение;
								НоваяСтрока.Сумма 		= СтрокаПервогоУровня[СтрЗаменить(ИмяПоказателя.ПутьКДанным, ".", "")];//СтрокаПервогоУровня.ПоказателиСумма;
								НоваяСтрока.МаксимальныйЛимит 	= СтрокаПервогоУровня[ИмяПоляМаксимальныйЛимит];
								НоваяСтрока.СвободныйЛимит 		= СтрокаПервогоУровня[ИмяПоляСвободныйЛимит];
							
							КонецЕсли;								
						
						КонецЦикла; 
					КонецЦикла;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Возврат ТаблицаЛимитов;

КонецФункции

Функция ПолучитьОтчетПоСведнымЛимитам(ТаблицаЛимитов, Макет, Расшифровка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ТаблицаЛимитов);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Расшифровка", Расшифровка);
	
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаЛимитов.ВидАктива КАК ВидАктива,
		|	ТаблицаЛимитов.Актив КАК Актив,
		|	ТаблицаЛимитов.Эмитент КАК Эмитент,
		|	ТаблицаЛимитов.Набор КАК Набор,
		|	ТаблицаЛимитов.Сумма КАК Сумма,
		|	ТаблицаЛимитов.МаксимальныйЛимит КАК МаксимальныйЛимит,
		|	ТаблицаЛимитов.СвободныйЛимит КАК СвободныйЛимит
		|ПОМЕСТИТЬ _ТаблицаЛимитов
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЛимитов.ВидАктива КАК ВидАктива,
		|	_ТаблицаЛимитов.Актив КАК Актив,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Эмитент,
		|	_ТаблицаЛимитов.Набор КАК Набор,
		|	_ТаблицаЛимитов.Сумма КАК Сумма,
		|	_ТаблицаЛимитов.МаксимальныйЛимит КАК МаксимальныйЛимит,
		|	_ТаблицаЛимитов.СвободныйЛимит КАК СвободныйЛимит
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	_ТаблицаЛимитов КАК _ТаблицаЛимитов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ТаблицаЛимитов.Эмитент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.ВидАктива КАК ВидАктива,
		|	_ИтоговаяТаблица.Актив КАК Актив,
		|	_ИтоговаяТаблица.Эмитент КАК Эмитент,
		|	ВЫБОР
		|		КОГДА МИНИМУМ(_ИтоговаяТаблица.СвободныйЛимит) < 0
		|			ТОГДА 0
		|		ИНАЧЕ МИНИМУМ(_ИтоговаяТаблица.СвободныйЛимит)
		|	КОНЕЦ КАК СвободныйЛимит
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|ГДЕ
		|	НЕ &Расшифровка
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтоговаяТаблица.Актив,
		|	_ИтоговаяТаблица.Эмитент,
		|	_ИтоговаяТаблица.ВидАктива
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидАктива,
		|	Эмитент,
		|	Актив
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.ВидАктива КАК ВидАктива,
		|	_ИтоговаяТаблица.Актив КАК Актив,
		|	_ИтоговаяТаблица.Эмитент КАК Эмитент,
		|	_ИтоговаяТаблица.Набор КАК Набор,
		|	_ИтоговаяТаблица.Сумма КАК Сумма,
		|	_ИтоговаяТаблица.МаксимальныйЛимит КАК МаксимальныйЛимит,
		|	_ИтоговаяТаблица.СвободныйЛимит КАК СвободныйЛимит
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|ГДЕ
		|	&Расшифровка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидАктива,
		|	Эмитент,
		|	Актив,
		|	СвободныйЛимит
		|АВТОУПОРЯДОЧИВАНИЕ";			
	#КонецОбласти 
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ОбластьШапкаОбщие = Макет.ПолучитьОбласть("ШапкаТаблицыФидуциарнаяОтветственность|ОбщиеРеквизиты");
	ОбластьШапкаСвободныйЛимит = Макет.ПолучитьОбласть("ШапкаТаблицыФидуциарнаяОтветственность|СвободныйЛимит");
	ОбластьСтрокаОбщие = Макет.ПолучитьОбласть("СтрокаТаблицыФидуциарнаяОтветственность|ОбщиеРеквизиты");
	ОбластьСтрокаСвободныйЛимит = Макет.ПолучитьОбласть("СтрокаТаблицыФидуциарнаяОтветственность|СвободныйЛимит");
	
	Отчет = Новый ТабличныйДокумент;
	
	Отчет.Вывести(ОбластьШапкаОбщие);
	
	Если Расшифровка Тогда
		Результат = МассивРезультатов[МассивРезультатов.ВГраница()];
		ОбластьШапкаРасшифровка = Макет.ПолучитьОбласть("ШапкаТаблицыФидуциарнаяОтветственность|Расшифровка");
		ОбластьСтрокаРасшифровка = Макет.ПолучитьОбласть("СтрокаТаблицыФидуциарнаяОтветственность|Расшифровка");
		ОбластьШапкаРасшифровка.Параметры.МаксимальныйЛимит = "Максимальный лимит";
		ОбластьШапкаРасшифровка.Параметры.Сумма = "Сумма";
		Отчет.Присоединить(ОбластьШапкаРасшифровка);
	Иначе
		Результат = МассивРезультатов[МассивРезультатов.ВГраница()-1];
	КонецЕсли; 
	
	Отчет.Присоединить(ОбластьШапкаСвободныйЛимит);
	
	Выборка = Результат.Выбрать();
	
	ТекАктив = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрокаОбщие.Параметры.Заполнить(Выборка);
		
		Если Расшифровка И ТекАктив <> Выборка.Актив И ТекАктив <> Неопределено Тогда
		    Отчет.ЗакончитьГруппуСтрок();
		КонецЕсли; 
		
		Отчет.Вывести(ОбластьСтрокаОбщие);
		
		Если Расшифровка Тогда
			
			ОбластьСтрокаРасшифровка.Параметры.Заполнить(Выборка);
			Отчет.Присоединить(ОбластьСтрокаРасшифровка);
			
			Если ТекАктив <> Выборка.Актив Тогда
				ТекАктив = Выборка.Актив;
				Отчет.НачатьГруппуСтрок(Выборка.Актив);
			КонецЕсли; 
			
		КонецЕсли; 
		
		ОбластьСтрокаСвободныйЛимит.Параметры.Заполнить(Выборка);
		Отчет.Присоединить(ОбластьСтрокаСвободныйЛимит);
		
	КонецЦикла; 
	
	Если Расшифровка Тогда
		Отчет.ЗакончитьГруппуСтрок();
	КонецЕсли;

	Возврат Отчет;
	
КонецФункции

&НаКлиенте
Процедура ОтчетФидуциарнаяОтветственность(Команда)
	
	ВывестиСводныйОтчет(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетФидуциарнаяОтветственностьСводный(Команда)
	ВывестиСводныйОтчет(Истина, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетФидуциарнаяОтветственностьРасшифровка(Команда)
	ВывестиСводныйОтчет(Истина, Истина, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВывестиРасшифровку(ИмяВложенногоОбъекта = "", НомерБазиса = 0, ИмяПоляДоля = "")

	ЭтаФорма.ДокументРезультат = ПолучитьТабличныйДокумент(ИмяВложенногоОбъекта, НомерБазиса, ИмяПоляДоля);
	Элементы.ДокументРезультат.ТекущаяОбласть = ЭтаФорма.ДокументРезультат.Область(1, 1);
	Элементы.ГруппаСтраницРезультов.ТекущаяСтраница = Элементы.СтраницаРасшифровка;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТабличныйДокумент(ИмяВложенногоОбъекта, НомерБазиса, ИмяПоляДоля, ФидуциарнаяОтветственность = Ложь)

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	Структура = СтруктураРезультатовПроверки.СтруктураФормированияОтчета.Получить();
	
	Настройки = Структура.Настройки;
	МассивУдаляемыхЭлементовСтруктуры = Новый Массив;
	
	Для каждого ВложенныйОбъект Из Настройки.Структура Цикл
		
		Использование = Ложь;
		
		Если ИмяВложенногоОбъекта = "" И Не Прав(ВложенныйОбъект.Имя, 6) = "Пустая" Тогда
			Использование = Истина;
		Иначе
			Если ЗначениеЗаполнено(НомерБазиса) И 
				(СтрЗаменить(ВложенныйОбъект.Имя, " Пустая", "") = Строка(ИмяВложенногоОбъекта)
					Или ВложенныйОбъект.Имя = "ВложеннаяСхема_" + НомерБазиса) Тогда
			
				Использование = Истина;
			
			КонецЕсли;
		КонецЕсли;
		
		Если Использование И ФидуциарнаяОтветственность Тогда
			
			Использование = (СтрНачинаетсяС(ВложенныйОбъект.ИдентификаторОбъекта, "ВложеннаяСхема_") И СтрЗаканчиваетсяНа(ВложенныйОбъект.ИдентификаторОбъекта, "_ДоляСумма") 
				И Не СтрНачинаетсяС(ВложенныйОбъект.Имя, "ВложеннаяСхема_"));
		КонецЕсли; 
		
		ВложенныйОбъект.Использование = Использование;
		Если Не Использование Тогда
			МассивУдаляемыхЭлементовСтруктуры.Добавить(ВложенныйОбъект);
		КонецЕсли; 
	
	КонецЦикла; 
	
	Для каждого ВложенныйОбъект Из МассивУдаляемыхЭлементовСтруктуры Цикл
		Настройки.Структура.Удалить(ВложенныйОбъект);
	КонецЦикла; 
	
	Если ФидуциарнаяОтветственность Тогда
		
		ИсключаемыеЗаголовки = СтрРазделить("Дельта (руб)", ",", Ложь);
		СписокДоступныхПолей = СтрРазделить("Основные.ВидАктива,Основные.Эмитент,Основные.Актив,ЦенныеБумаги.КатегорияОблигации,ЦенныеБумаги.ПодкатегорияОблигации,Основные.ГоловнаяОрганизация," +
			"Показатели.Сумма,Показатели.СуммаПоРЕПО,Показатели.СуммаБезРепоРЕПО,ЦенныеБумаги.Количество,ЦенныеБумаги.КоличествоПоРЕПО,ЦенныеБумаги.КоличествоСвободные,СвязанныеЛицаГруппыКомпаний.Родитель," +
			"ДоляСумма,ДоляСуммаПоРЕПО,ДоляСуммаБезРепоРЕПО,ДоляДоляКоличество,ДоляКоличествоПоРЕПО,ДоляКоличествоСвободные,СвязанныеЛицаИнфинитум.Родитель", ",", Ложь);
		Для Индекс = 0 По СписокДоступныхПолей.ВГраница() Цикл
			СписокДоступныхПолей[Индекс] = Новый ПолеКомпоновкиДанных(СписокДоступныхПолей[Индекс]);
		КонецЦикла; 
		ПолеКоличество = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Количество");
		Для каждого Отчет Из Настройки.Структура Цикл
			НастройкиВложенногоОтчета = Отчет.Настройки;
			НайденСвободныйЛимит = Ложь;
			НайденоКоличество = Ложь;
			Для каждого ПолеВыбора Из НастройкиВложенногоОтчета.Выбор.Элементы Цикл
				Если НайденСвободныйЛимит И НайденоКоличество Тогда
					ПолеВыбора.Использование = Ложь;
				Иначе
					Если ЗначениеЗаполнено(ПолеВыбора.Заголовок) Тогда
						ПолеВыбора.Использование = (ИсключаемыеЗаголовки.Найти(ПолеВыбора.Заголовок) = Неопределено);
						НайденСвободныйЛимит = НайденСвободныйЛимит Или ПолеВыбора.Заголовок = "Свободный лимит (руб)";
					Иначе
						ПолеВыбора.Использование = (СписокДоступныхПолей.Найти(ПолеВыбора.Поле) <> Неопределено);
						НайденоКоличество = НайденоКоличество Или ПолеВыбора.Поле = ПолеКоличество;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НайтиПолеКомпоновкиДанных(НастройкиВложенногоОтчета.Структура[0].ПоляГруппировки.Элементы, "Служебные.ОбщийИтог") Тогда
				Для каждого ПолеГруппировки Из НастройкиВложенногоОтчета.Структура[0].Структура[0].ПоляГруппировки.Элементы Цикл
					ПолеГруппировки.Использование = (СписокДоступныхПолей.Найти(ПолеГруппировки.Поле) <> Неопределено);
				КонецЦикла; 
			Иначе
				НастройкиВложенногоОтчета.Структура[0].Структура[0].Использование = Ложь;
			КонецЕсли; 
			НастройкиВложенногоОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
			
			Для каждого УО Из Настройки.УсловноеОформление.Элементы Цикл
				ЗначениеПараметра = УО.Оформление.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ЦветФона"));
				Если ЗначениеПараметра.Использование Тогда
					ЗначениеПараметра.Использование = Ложь;
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла; 
	КонецЕсли; 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ПолучитьРезультатКомпоновки(Структура.СКД, Настройки, Структура.ВнешниеНаборыДанных, Ложь);
	
	//СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	СтруктураРезультатовПроверки.Вставить("ДанныеРасшифровки", Результат.ДанныеРасшифровки);
	ПоместитьВоВременноеХранилище(СтруктураРезультатовПроверки, ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	Возврат Результат.ТабличныйДокумент;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыЗаголовка(СчетДоверительногоУправления, Период)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПараметрыЗаголовка = Новый Структура;
	ПараметрыЗаголовка.Вставить("ДатаОтчета", Формат(Период, "ДФ=dd.MM.yyyy"));
	
	Если Выборка.Следующий() Тогда
		
		ПараметрыЗаголовка.Вставить("Клиент", Выборка.КраткоеНаименованиеПоУставу);
		ПараметрыЗаголовка.Вставить("Договор", "№" + Выборка.НомерДоговора + " от " + Формат(Выборка.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
			
	КонецЕсли; 
	
	Возврат ПараметрыЗаголовка;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиПолеКомпоновкиДанных(Коллекция, ПутьКДанным)

	Поле = Новый ПолеКомпоновкиДанных(ПутьКДанным);
	Для каждого ЭлементКоллекции Из Коллекция Цикл
		Если ЭлементКоллекции.Поле = Поле Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРасшифровки(АдресВХарилище, Расшифровка)

	Значение = ПолучитьИзВременногоХранилища(АдресВХарилище);
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
	    // расшифровка результатов проверки
		ДанныеРасшифровки = Значение.ДанныеРасшифровки;
	Иначе
		// расшифровка отчета по базису
		ДанныеРасшифровки = Значение;
	КонецЕсли; 
	
	Возврат ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля()[0].Значение;

КонецФункции

&НаКлиенте
Процедура Подключаемый_ДокументРезультатПриАктивизацииОбластиПодключаемый()
	
	НеобходимоВычислятьНаСервере = Ложь;
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		ПолеСумма, ДокументРезультат, КэшВыделеннойОбласти, НеобходимоВычислятьНаСервере);
	
	Если НеобходимоВычислятьНаСервере Тогда
		ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере();
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ДокументРезультатПриАктивизацииОбластиПодключаемый");
	
КонецПроцедуры
 
&НаСервере
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере()
	
	ПолеСумма = РаботаСБухгалтерскимиОтчетами.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		ДокументРезультат, КэшВыделеннойОбласти);
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьОтчетыПоФидуциарнойОтветственности()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов", Объект.СоставГрупповогоКонтроля.Выгрузить(, "Период,ИдентификаторРезультата,СчетДоверительногоУправления"));
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИдентификаторов.Период КАК Период,
		|	ТаблицаИдентификаторов.ИдентификаторРезультата КАК ИдентификаторРезультата,
		|	ТаблицаИдентификаторов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаИдентификаторов
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаИдентификаторов.Период КАК Период,
		|	_ТаблицаИдентификаторов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	_ТаблицаИдентификаторов КАК _ТаблицаИдентификаторов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|		ПО _ТаблицаИдентификаторов.ИдентификаторРезультата = ХранилищеЗначений.Идентификатор
		|			И ХранилищеЗначений.Источник = ""_КонтрольИнвестиционныхДеклараций""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";		
	#КонецОбласти 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Массив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
	
		Значение = Выборка.ХранилищеЗначения.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
		
			ПоместитьВоВременноеХранилище(Значение, ЭтаФорма.АдресСтруктурыРезультатовПроверки);
			
			Объект.Период = Выборка.Период;
			Объект.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
	
			Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
			Шапка = Макет.ПолучитьОбласть("ШапкаФидуциарнаяОтветственность");
			Шапка.Параметры.Заполнить(ПолучитьПараметрыЗаголовка(Объект.СчетДоверительногоУправления, Объект.Период));
			ТабличныйДокумент.Вывести(Шапка);
			ТабличныйДокумент.Вывести(ПолучитьОтчетПоСведнымЛимитам(ПолучитьСвободныеЛимиты(), Макет, Ложь));
			
			ИмяФайла = Строка(Выборка.СчетДоверительногоУправления) + "_" + Формат(Выборка.Период, "ДФ=yyyyMMdd") + ".xlsx";
			Структура = Новый Структура;
			Структура.Вставить("ИмяФайла", ИмяФайла);
			Структура.Вставить("ТабличныйДокумент", ТабличныйДокумент);
			Массив.Добавить(Структура);
						
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначенияЗаполненияНесоответствиеИД(ПараметрыЗаполнения)

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	Структура = СтруктураРезультатовПроверки.СтруктураФормированияОтчета.Получить();
	
	Настройки = ПолучитьНастройкиФормированияОтчета(Структура, ПараметрыЗаполнения.ИмяВложенногоОбъекта, ПараметрыЗаполнения.НомерБазиса, Ложь, Истина);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СоставНабора = ОбработкаОбъект.ПолучитьРезультатКомпоновки(Структура.СКД, Настройки, Структура.ВнешниеНаборыДанных, Истина);
	
	СтруктураДокумент = Новый Структура("Дата, Организация, ИнвестиционнаяДекларация, ИдентификаторСтрокиПоказателей");
	
	ЗаполнитьЗначенияСвойств(СтруктураДокумент, ПараметрыЗаполнения); 
	
	СовокупныйКонтроль = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗаполнения.ИнвестиционнаяДекларация, "СовокупныйКонтроль");
	
	Если СовокупныйКонтроль Тогда
		СтруктураДокумент.Вставить("Субъект", ПараметрыЗаполнения.Субъект);
		СтруктураДокумент.Вставить("ВидДоговораДоверительногоУправления", ПараметрыЗаполнения.ВидДоговораДоверительногоУправления);
	Иначе
		СтруктураДокумент.Вставить("Субъект", ПараметрыЗаполнения.Субъект);	
	КонецЕсли; 
	
	СтруктураДокумент.Вставить("СоставНабора", Новый Массив);
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить("ОсновныеВидАктива");
	ИменаКолонок.Добавить("ОсновныеАктив");
	ИменаКолонок.Добавить("ОсновныеДатаПоследнейПокупки");
	ИменаКолонок.Добавить("ЦенныеБумагиКоличество");
	ИменаКолонок.Добавить("РезультатПроверки");
	
	ИмяКолонкиГруппа = "";
	
	Для каждого СтрокаУровень1 Из СоставНабора Цикл
	
		Если Не СтрокаУровень1.РезультатПроверки Тогда
		
			Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
				
				Если ИмяКолонкиГруппа = "" Тогда
				
					Для каждого Колонка Из СтрокаУровень2.Владелец().Колонки Цикл
					
						Если ИменаКолонок.Найти(Колонка.Имя) = Неопределено Тогда
							
							ИмяКолонкиГруппа = Колонка.Имя;
							Прервать;
							
						КонецЕсли; 
					
					КонецЦикла; 
				
				КонецЕсли; 
				
				СтрокаСостава = Новый Структура;
				СтрокаСостава.Вставить("ВидАктива", 					СтрокаУровень2.ОсновныеВидАктива);
				СтрокаСостава.Вставить("СчетДоверительногоУправления", 	СтрокаУровень2.СлужебныеСчетДоверительногоУправленияСсылка);
				СтрокаСостава.Вставить("Актив", 						СтрокаУровень2.ОсновныеАктив);
				СтрокаСостава.Вставить("Классификация", 				СтрокаУровень2.ЦенныеБумагиКлассификация);
				СтрокаСостава.Вставить("ДатаПоследнейПокупки",			СтрокаУровень2.ОсновныеДатаПоследнейПокупки);
				СтрокаСостава.Вставить("Количество", 					СтрокаУровень2.ЦенныеБумагиКоличество);
				СтрокаСостава.Вставить("Группа", 						СтрокаУровень1[ИмяКолонкиГруппа]);
				
				СтруктураДокумент.СоставНабора.Добавить(СтрокаСостава);
			
			КонецЦикла;			
		
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат СтруктураДокумент;
	
КонецФункции

&НаСервере
Функция ПолучитьНастройкиФормированияОтчета(Структура, ИмяВложенногоОбъекта, НомерБазиса, ФидуциарнаяОтветственность, ТолькоДетальныеЗаписи = Ложь)

	Настройки = Структура.Настройки;
	МассивУдаляемыхЭлементовСтруктуры = Новый Массив;
	
	МассивПолейГруппировки = Новый Массив;
	МассивПолейГруппировки.Добавить("Основные.ВидАктива");
	МассивПолейГруппировки.Добавить("Основные.Актив");
	МассивПолейГруппировки.Добавить("Основные.ДатаПоследнейПокупки");
	МассивПолейГруппировки.Добавить("ЦенныеБумаги.Классификация");
	МассивПолейГруппировки.Добавить("Служебные.СчетДоверительногоУправленияСсылка");
	
	Для каждого ВложенныйОбъект Из Настройки.Структура Цикл
		
		Использование = Ложь;
		
		Если ИмяВложенногоОбъекта = "" И Не Прав(ВложенныйОбъект.Имя, 6) = "Пустая" Тогда
			Использование = Истина;
		Иначе
			Если ЗначениеЗаполнено(НомерБазиса) И 
				(СтрЗаменить(ВложенныйОбъект.Имя, " Пустая", "") = Строка(ИмяВложенногоОбъекта)
					Или ВложенныйОбъект.Имя = "ВложеннаяСхема_" + НомерБазиса) Тогда
			
				Использование = Истина;
			
			КонецЕсли;
		КонецЕсли;
		
		Если Использование Тогда
			
			Если ФидуциарнаяОтветственность Тогда
			
				Использование = (СтрНачинаетсяС(ВложенныйОбъект.ИдентификаторОбъекта, "ВложеннаяСхема_") И СтрЗаканчиваетсяНа(ВложенныйОбъект.ИдентификаторОбъекта, "_ДоляСумма") 
					И Не СтрНачинаетсяС(ВложенныйОбъект.Имя, "ВложеннаяСхема_"));				
			
			КонецЕсли; 
				
			Если ТолькоДетальныеЗаписи Тогда
				
				// оставляем только схемы по выбранному набору
				Использование = СтрЗаменить(ВложенныйОбъект.Имя, " Пустая", "") = Строка(ИмяВложенногоОбъекта);
				
				Если Использование Тогда
				
					ВложенныйОбъект.Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("РасположениеИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
					
					ВложенныйОбъект.Настройки.Выбор.Элементы.Очистить();
					
					НовоеПоле = ВложенныйОбъект.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("РезультатПроверки");
					
					НовоеПоле = ВложенныйОбъект.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Количество");
					
					ЭлементПорядка = ВложенныйОбъект.Настройки.Порядок.Элементы.Вставить(0, Тип("ЭлементПорядкаКомпоновкиДанных"));
					ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("РезультатПроверки");
					
					ВложеннаяГруппировка = ВложенныйОбъект.Настройки.Структура[0].Структура[0];
					ВложеннаяГруппировка.ПоляГруппировки.Элементы.Очистить();
					
					Для каждого Поле Из МассивПолейГруппировки Цикл
					
						НовоеПоле = ВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
						НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(Поле);					
												
					КонецЦикла;
					
				КонецЕсли; 
				
			КонецЕсли; 	

		КонецЕсли; 
		
		ВложенныйОбъект.Использование = Использование;
		Если Не Использование Тогда
			МассивУдаляемыхЭлементовСтруктуры.Добавить(ВложенныйОбъект);
		КонецЕсли; 
	
	КонецЦикла; 
	
	Для каждого ВложенныйОбъект Из МассивУдаляемыхЭлементовСтруктуры Цикл
		Настройки.Структура.Удалить(ВложенныйОбъект);
	КонецЦикла; 
	
	Возврат Настройки;

КонецФункции 
 

