&НаСервере
Процедура ЗаполнитьТабличныйДокументОшибкиОценки() 

	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
	
	СтруктураОтчетов = СтруктураРезультатовПроверки.СтруктураОтчетов.Получить(); 
	
	ТаблицаОшибокОценки = Неопределено;
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		СтруктураОтчетов.Свойство("ТаблицаОшибокОценки", ТаблицаОшибокОценки);
	КонецЕсли;
	
	ТабличныйДокументОшибкиОценки.Очистить();
	Макет = Неопределено;

	Если Не ТаблицаОшибокОценки = Неопределено И ТаблицаОшибокОценки.Количество() > 0 Тогда
		
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		Строка = Макет.ПолучитьОбласть("ОшибкиОценкиСтрока|ОбщиеОшибки");
		
		ТабличныйДокументОшибкиОценки.Вывести(Макет.ПолучитьОбласть("ОшибкиОценкиШапка|ОбщиеОшибки"));
		
		ТаблицаОшибокОценки.Свернуть("Базис, Набор, Рынок, ЦеннаяБумага");
		Для каждого ТекСтрока Из ТаблицаОшибокОценки Цикл
			
			Строка.Параметры.Заполнить(ТекСтрока);
			ТабличныйДокументОшибкиОценки.Вывести(Строка);
			
		КонецЦикла; 
	КонецЕсли;
	
	ТаблицаОшибокСафмар = Неопределено;
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		СтруктураОтчетов.Свойство("ТаблицаОшибокСафмар", ТаблицаОшибокСафмар);
	КонецЕсли;
	
	Если Не ТаблицаОшибокСафмар = Неопределено И ТаблицаОшибокСафмар.Количество() > 0 Тогда
		
		Если Макет = Неопределено Тогда
		
			Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		
		КонецЕсли; 
		
		Строка = Макет.ПолучитьОбласть("ОшибкиОценкиСтрока|ОшибкиСафмар");
		
		Шапка = Макет.ПолучитьОбласть("ОшибкиОценкиШапка|ОшибкиСафмар");
		Шапка.Область(2,1,2,1).Текст = "Использованы цены MerketPrice2";
		ТабличныйДокументОшибкиОценки.Вывести(Шапка);
						
		ТаблицаОшибокСафмар.Свернуть("Рынок, ЦеннаяБумага, Цена, ДатаЦены");
		Для каждого ТекСтрока Из ТаблицаОшибокСафмар Цикл
			
			Строка.Параметры.Заполнить(ТекСтрока);
			ТабличныйДокументОшибкиОценки.Вывести(Строка);
			
		КонецЦикла; 
		
	КонецЕсли;
	
	ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения = Неопределено;
	Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
		СтруктураОтчетов.Свойство("ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения", ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения);
	КонецЕсли;
	
	Если Не ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения = Неопределено И ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения.Количество() > 0 Тогда
		
		Если Макет = Неопределено Тогда
		
			Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
		
		КонецЕсли;
		
		Строка = Макет.ПолучитьОбласть("СтрокаДоПогашения");
		
		Шапка = Макет.ПолучитьОбласть("ШапкаДоПогашения");
		Шапка.Область(2,1,2,1).Текст = "Ценные бумаги, классифицированные одновременно в несколько категорий";
		ТабличныйДокументОшибкиОценки.Вывести(Шапка);
						
		ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения.Свернуть("Рынок, ЦеннаяБумага");
		Для каждого ТекСтрока Из ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения Цикл
			
			Строка.Параметры.Заполнить(ТекСтрока);
			ТабличныйДокументОшибкиОценки.Вывести(Строка);
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Если ТабличныйДокументОшибкиОценки.ВысотаТаблицы = 0 Тогда
	    Элементы.ГруппаОшибкиОценки.Видимость = Ложь;
	Иначе
		Элементы.ГруппаОшибкиОценки.Видимость = Истина;
	КонецЕсли; 
	
КонецПроцедуры

