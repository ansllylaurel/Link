&НаСервере 
Процедура ОтладкаСравнитьРезультатССохраненнымНаСервере(Каталог)
	
	Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = ЭтаФорма.Отладка_ИдентификаторНастроек;
	Запись.Прочитать();
	СтруктураНастроек = Запись.ХранилищеЗначения.Получить();
	
	Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
		СтруктураРезультатовПроверкиСохр = СтруктураНастроек.Результат;//.ПараметрыБазисов.Получить();
		СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(АдресСтруктурыРезультатовПроверки);//.ПараметрыБазисов.Получить();
		ИмяФайла = "_" + Формат(СтруктураНастроек.Период, "ДФ=yyyyMMdd") + "_" + СтруктураНастроек.СчетДоверительногоУправления + "_" + СтруктураНастроек.ИнвестиционнаяДекларация;
		СравнитьРезультатыПроверки(СтруктураРезультатовПроверкиСохр, СтруктураРезультатовПроверки, Каталог, ИмяФайла);
	Иначе
		
		Колонки = "Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация, РегистрацияСтоимостиАктивов, СовокупнаяИнвестДекларация, Консолидирующая, РегистрацияСтоимостиАктивов_СЧА, РегистрацияСтоимостиАктивов_РСА, РегистрацияСтоимостиАктивов_КЗ";
		СоставСохр = СтруктураНастроек.СоставГрупповогоКонтроля.Скопировать(, Колонки);
		СоставТек = Объект.СоставГрупповогоКонтроля.Выгрузить().Скопировать(, Колонки);
		
		ТаблицаОтличий = УниверсальныеМеханизмы.РазницаТаблицЗначений(СоставТек, СоставСохр);
		
		Если ТаблицаОтличий.Количество()>0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отличаются таблицы состава группового контроля");
		КонецЕсли;
		
		СоставСохр = СтруктураНастроек.СоставГрупповогоКонтроля;
		СоставТек = Объект.СоставГрупповогоКонтроля;
		
		Для каждого СтрокаСоставТек Из СоставТек Цикл
			
			Если СтрокаСоставТек.СовокупнаяИнвестДекларация Тогда
				СтруктураОтбора = Новый Структура("Период, Клиент, ВидДоговораДоверительногоУправления");
				ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаСоставТек);
			Иначе
				СтруктураОтбора = Новый Структура("Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация");
				ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаСоставТек);
			КонецЕсли;
			
			НайденныеСтроки = СоставСохр.НайтиСтроки(СтруктураОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				УИДСохр = НайденныеСтроки[0].ИдентификаторРезультата;
				УИДТек = СтрокаСоставТек.ИдентификаторРезультата;
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("УИДСохр", УИДСохр);
				Запрос.УстановитьПараметр("УИДТек", УИДТек);
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ХранилищеЗначенийСохр.ХранилищеЗначения КАК ХранилищеЗначенияСохр,
					|	ХранилищеЗначенийТек.ХранилищеЗначения КАК ХранилищеЗначенияТек
					|ИЗ
					|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначенийСохр
					|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначенийТек
					|		ПО (ИСТИНА)
					|ГДЕ
					|	ХранилищеЗначенийСохр.Идентификатор = &УИДСохр
					|	И ХранилищеЗначенийСохр.Источник = ""_КонтрольИнвестиционныхДеклараций""
					|	И ХранилищеЗначенийТек.Идентификатор = &УИДТек
					|	И ХранилищеЗначенийТек.Источник = ""_КонтрольИнвестиционныхДеклараций""";
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() И ТипЗнч(Выборка.ХранилищеЗначенияСохр) = Тип("ХранилищеЗначения") И ТипЗнч(Выборка.ХранилищеЗначенияТек) = Тип("ХранилищеЗначения") Тогда
					
					РезультатыПроверкиСохр = Выборка.ХранилищеЗначенияСохр.Получить();
					РезультатыПроверкиТек = Выборка.ХранилищеЗначенияТек.Получить();
					
					Отказ = ТипЗнч(РезультатыПроверкиСохр) = Тип("Строка") Или ТипЗнч(РезультатыПроверкиТек) = Тип("Строка");
					
					Если Не Отказ Тогда
						
						Если СтрокаСоставТек.СовокупнаяИнвестДекларация Тогда
							ИмяФайла = "_" + Формат(СтруктураОтбора.Период, "ДФ=yyyyMMdd") + "_" + СтруктураОтбора.Клиент + "_" + СтруктураОтбора.ВидДоговораДоверительногоУправления;
						Иначе
						    ИмяФайла = "_" + Формат(СтруктураОтбора.Период, "ДФ=yyyyMMdd") + "_" + СтруктураОтбора.СчетДоверительногоУправления + "_" + СтруктураОтбора.ИнвестиционнаяДекларация;
						КонецЕсли;
						
						СравнитьРезультатыПроверки(РезультатыПроверкиСохр, РезультатыПроверкиТек, Каталог, ИмяФайла);					
						
					КонецЕсли; 
					
				Иначе
					Отказ = Истина;
				КонецЕсли;
				
				Если Отказ Тогда
					Если СтрокаСоставТек.СовокупнаяИнвестДекларация Тогда
					    ТекстСообщениия = СтрШаблон("Что-то пошло не так. Клиент: %1, Период: %2", 
							Строка(СтруктураОтбора.СчетДоверительногоУправления) + " - " + СтруктураОтбора.ВидДоговораДоверительногоУправления, 
							Формат(СтруктураОтбора.Период, "ДФ=dd.MM.yyyy"));
					Иначе
						ТекстСообщениия = СтрШаблон("Что-то пошло не так. Счет ДУ: %1, Период: %2", 
						СтруктураОтбора.СчетДоверительногоУправления, 
						Формат(СтруктураОтбора.Период, "ДФ=dd.MM.yyyy"));
					КонецЕсли; 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщениия);
				КонецЕсли; 
				
			КонецЕсли; 
		
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СравнитьРезультатыПроверки(СтруктураРезультатовПроверкиСохр, СтруктураРезультатовПроверки, Каталог, ИмяФайла)

	ПараметрыБазисовСохр = СтруктураРезультатовПроверкиСохр.ПараметрыБазисов.Получить();
	ПараметрыБазисов = СтруктураРезультатовПроверки.ПараметрыБазисов.Получить();
	
	Для каждого ТекСтрока Из ПараметрыБазисов Цикл
		
		Отбор = Новый Структура("Базис, ИспользоватьМинимальноеЗначениеРейтинга, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(Отбор, ТекСтрока);
		СохрСтроки = ПараметрыБазисовСохр.НайтиСтроки(Отбор);
		
		ТекПараметры = ТекСтрока.Параметры;
		
		Если СохрСтроки.Количество() = 1 Тогда
			СохрПараметры = СохрСтроки[0].Параметры;
		Иначе
			СохрПараметры = Неопределено;
		КонецЕсли; 
				
		Если СохрПараметры = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В сохраненных результатах отсутствует базис" + ТекСтрока.Базис);
		Иначе
			
			ТаблицаБазиса = ТекПараметры.ТаблицаБазиса.Скопировать();
			СохрТаблица = СохрПараметры.ТаблицаБазиса.Скопировать();
			
			ОбработатьТаблицуДляСравнения(ТаблицаБазиса, ЭтаФорма.Отладка_СравнитьТолькоБазисы);
			ОбработатьТаблицуДляСравнения(СохрТаблица, ЭтаФорма.Отладка_СравнитьТолькоБазисы);
			
			Измерения = "";
			Для каждого Колонка Из ТаблицаБазиса.Колонки Цикл
				Если Не Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
					Измерения = Измерения + "," + Колонка.Имя;
				КонецЕсли; 
			КонецЦикла; 
			
			ТаблицаОтличий = УниверсальныеМеханизмы.РазницаТаблицЗначений(ТаблицаБазиса, СохрТаблица, Сред(Измерения, 2));
			
			Если ТаблицаОтличий.Количество()>0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отличается таблица базиса" + ТекСтрока.Базис);
			КонецЕсли; 
			
		КонецЕсли; 
	
	КонецЦикла;
	
	Если Не Объект.ИнвестиционнаяДекларация.Консолидирующая Тогда
		
		ОтчетСохр = ПолучитьТабличныйДокументДляОтладки(СтруктураРезультатовПроверкиСохр);
		Отчет = ПолучитьТабличныйДокументДляОтладки(СтруктураРезультатовПроверки);
		ТекДата = ТекущаяДатаСеанса();
		//Каталог 	= ;
		КаталогТек	= Каталог + "Текущие\";
		КаталогСохр = Каталог + "Сохраненные\";
		
		Файл = Новый Файл(КаталогТек);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогТек);
		КонецЕсли;
		
		Файл = Новый Файл(КаталогСохр);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогСохр);
		КонецЕсли;
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ИмяФайла);
		ОтчетСохр.Записать(КаталогСохр + ИмяФайла + ".mxl");
		Отчет.Записать(КаталогТек + ИмяФайла + ".mxl");
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сравнение результатов консолидирующей ИД не реализовано");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьТаблицуДляСравнения(ТаблицаКОбработке, ТолькоБазисы)

	КолонкиКОбработке = Новый Массив;
	КолонкиКУдалению = Новый Массив;
	
	КолонкиКлассификации = Новый Массив;
	КолонкиКлассификации.Добавить("Классификация");
	КолонкиКлассификации.Добавить("ДоПогашения");
	КолонкиКлассификации.Добавить("ПоАмортизированной");
	КолонкиКлассификации.Добавить("ССЧерезПрибыльИУбыток");
	КолонкиКлассификации.Добавить("ССЧерезПСД");
	
	Для каждого Колонка Из ТаблицаКОбработке.Колонки Цикл
		Если ТолькоБазисы И СтрНачинаетсяС(Колонка.Имя, "Доля") Тогда
		    КолонкиКУдалению.Добавить(Колонка);
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Строка")) И Колонка.ТипЗначения.КвалификаторыСтроки.Длина = 0 Тогда
			КолонкиКОбработке.Добавить(Колонка.Имя);
		КонецЕсли;
		Если КолонкиКлассификации.Найти(Колонка.Имя) <> Неопределено Тогда
			КолонкиКУдалению.Добавить(Колонка);
		КонецЕсли; 
	КонецЦикла; 
	Для каждого Колонка Из КолонкиКОбработке Цикл
		ЗначенияКолонки = ТаблицаКОбработке.ВыгрузитьКолонку(Колонка);
		ТаблицаКОбработке.Колонки.Удалить(Колонка);
		ТаблицаКОбработке.Колонки.Добавить(Колонка, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024)));
	КонецЦикла;
	Для каждого Колонка Из КолонкиКУдалению Цикл
		ТаблицаКОбработке.Колонки.Удалить(Колонка);
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Функция ПолучитьТабличныйДокументДляОтладки(СтруктураРезультатовПроверки)

	Структура = СтруктураРезультатовПроверки.СтруктураФормированияОтчета.Получить();
	
	Настройки = Структура.Настройки;
	МассивУдаляемыхЭлементовСтруктуры = Новый Массив;
	
	ИмяВложенногоОбъекта = "";
	НомерБазиса = 0;
	
	Для каждого ВложенныйОбъект Из Настройки.Структура Цикл
		
		Использование = Ложь;
		
		Если ИмяВложенногоОбъекта = "" И Не Прав(ВложенныйОбъект.Имя, 6) = "Пустая" Тогда
			Использование = Истина;
		Иначе
			Если ЗначениеЗаполнено(НомерБазиса) И 
				(СтрЗаменить(ВложенныйОбъект.Имя, " Пустая", "") = Строка(ИмяВложенногоОбъекта)
					Или ВложенныйОбъект.Имя = "ВложеннаяСхема_" + НомерБазиса) Тогда
			
				Использование = Истина;
			
			КонецЕсли;
		КонецЕсли;
		
		ВложенныйОбъект.Использование = Использование;
		Если Не Использование Тогда
			МассивУдаляемыхЭлементовСтруктуры.Добавить(ВложенныйОбъект);
		КонецЕсли; 
	
	КонецЦикла; 
	
	Для каждого ВложенныйОбъект Из МассивУдаляемыхЭлементовСтруктуры Цикл
		Настройки.Структура.Удалить(ВложенныйОбъект);
	КонецЦикла; 
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ПолучитьРезультатКомпоновки(Структура.СКД, Настройки, Структура.ВнешниеНаборыДанных, Ложь);
	
	Возврат Результат.ТабличныйДокумент;
	
КонецФункции

#КонецОбласти 

&НаКлиенте
Процедура ЗагрузитьРезультатыПроверки(Команда)
	
	УИДСтрока = "";
	
	Если ВвестиСтроку(УИДСтрока, "Введите идентификатор результатов проверки") Тогда
		
		Попытка
			УИД = Новый УникальныйИдентификатор(УИДСтрока);
		Исключение
			Предупреждение("Введен неверный идентификатор результатов");
			Возврат;
		КонецПопытки; 
		
		ЗагрузитьРезультатыПроверкиНаСервере(УИД);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатыПроверкиНаСервере(Ключ)

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Если ТипЗнч(Ключ) = Тип("УникальныйИдентификатор") Тогда
		Запрос.УстановитьПараметр("Идентификатор", Ключ);
	ИначеЕсли ТипЗнч(Ключ) = Тип("РегистрСведенийКлючЗаписи.ХранилищеЗначений") Тогда 
		Запрос.УстановитьПараметр("Идентификатор", Ключ.Идентификатор);
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Идентификатор = &Идентификатор
		|	И ХранилищеЗначений.Источник = ""_КонтрольИнвестиционныхДеклараций""";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		ЗаполнитьДанныеФормыИзХранилища(Выборка.ХранилищеЗначения); 
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Результаты проверки по данному идентификатору не найдены.");
	
	КонецЕсли; 
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьДанныеФормыИзХранилища(ХранилищеЗначения)

	Значение = ХранилищеЗначения.Получить();
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
	
		Если Значение.Организация <> Объект.Организация Тогда
			Возврат;
		КонецЕсли; 
		
		ПоместитьВоВременноеХранилище(Значение, ЭтаФорма.АдресСтруктурыРезультатовПроверки);
		РезультатыДерево = РеквизитФормыВЗначение("РезультатыПроверки");
		//ЗначениеВРеквизитФормы(Значение.РезультатыПроверки, "РезультатыПроверки");
		ЗаполнитьРезультатыПроверки(РезультатыДерево, Значение.РезультатыПроверки);
		ЗначениеВРеквизитФормы(РезультатыДерево, "РезультатыПроверки");
		ЗаполнитьОтчетПоРезультатамКонтроляНаСервере(РезультатыДерево);
		//ПоместитьВоВременноеХранилище(Значение.СоставСовокупнойИнвестДекларации, АдресСоставаСовокупнойИнвестДекларации);
		//ЗаполнитьЗначенияСвойств(Объект, Значение, "СчетДоверительногоУправления, ИнвестиционнаяДекларация, Период");
		СписокСвойств = "СчетДоверительногоУправления, ИнвестиционнаяДекларация, Клиент, ВидДоговораДоверительногоУправления, Период, ДинамическийРасчетСтоимости, УчитыватьПлановыеОперации";
		МассивСвойств = СтрРазделить(СтрЗаменить(СписокСвойств, " ", ""), ",");
		Для каждого ИмяСвойства Из МассивСвойств Цикл
			Если Значение.Свойство(ИмяСвойства) Тогда
				Объект[ИмяСвойства] = Значение[ИмяСвойства];
			КонецЕсли; 
		КонецЦикла;
		
		Значение.Свойство("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
		Если Не Значение.Свойство("РежимСовокукпногоКонтроля", ЭтаФорма.РежимСовокукпногоКонтроля) Тогда
			ЭтаФорма.РежимСовокукпногоКонтроля = "Авто";
		КонецЕсли;
		
		НаборДействий = Новый Массив;
		НаборДействий.Добавить("ЗаполнитьСостав");
		НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
		Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
			НаборДействий.Добавить("ЗаполнитьКлиента");
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Объект.ВидДоговораДоверительногоУправления) Тогда
			НаборДействий.Добавить("ЗаполнитьВидДоговора");
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
			НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
		КонецЕсли; 
		
		Если НаборДействий.Количество() > 0 Тогда
			ОбновитьРеквизитыКонтроляНаСервере(НаборДействий, Ложь);
		КонецЕсли; 
		
		СохраненныйСостав = Значение.СоставСовокупнойИнвестДекларации;
		АктуальныйСостав = ПолучитьИзВременногоХранилища(АдресСоставаСовокупнойИнвестДекларации);
		
		СоставыОтличаются = Истина;
		
		Если СохраненныйСостав.Количество() > 0 И СохраненныйСостав.Количество() = АктуальныйСостав.Количество() Тогда
			
			КолонкиДляСверки = "Назначение, ИнвестиционнаяДекларация, СчетДоверительногоУправления";
			СохраненныйСостав.Сортировать(КолонкиДляСверки);
			АктуальныйСостав.Сортировать(КолонкиДляСверки);
			
			КолонкиДляСверки = Новый Структура(КолонкиДляСверки);
			
			// Сравним составы построчно
			Для ИндексСтроки = 0 По СохраненныйСостав.Количество() - 1 Цикл
			
				Для каждого КЗ Из КолонкиДляСверки Цикл
				
					СоставыОтличаются = СохраненныйСостав[ИндексСтроки][КЗ.Ключ] <> АктуальныйСостав[ИндексСтроки][КЗ.Ключ];
					Если СоставыОтличаются Тогда
						Прервать;
					КонецЕсли;
				
				КонецЦикла; 
				
				Если СоставыОтличаются Тогда
					Прервать;
				КонецЕсли; 
			
			КонецЦикла; 
		
		КонецЕсли; 
		
		Если СоставыОтличаются Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Состав деклараций клиента изменился. Рекомендуется выполнить контроль повторно."); 
		КонецЕсли; 
		
		ЭтаФорма.ИспользоватьЦелевоеЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ИнвестиционнаяДекларация, "ИспользоватьЦелевоеЗначение");
		
		Если Значение.Свойство("Претрейд") И ТипЗнч(Значение.Претрейд) = Тип("ТаблицаЗначений") Тогда
			Объект.Претрейд.Загрузить(Значение.Претрейд);
		Иначе
			Объект.Претрейд.Очистить();
		КонецЕсли; 
		
		Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = Элементы.СтраницаИндивидуальныйКонтроль;
		Элементы.РезультатыПроверкиИнвестиционнаяДекларация.Видимость = Ложь;
		ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль";
		
		ЗаполнитьТабличныйДокументЦеныПоступлений();
		ЗаполнитьТабличныйДокументОшибкиОценки();
		ЗаполнитьТабличныйДокументРазличияОценки();
		ЗаполнитьТабличныйДокументПлановыеДанные();
		ЗаполнитьТабличныйДокументЦеныТМинус2();
		
		ЭтаФорма.Базис = Неопределено;
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "НЕАКТУАЛЬНОСТЬ");
				
		Элементы.ФормаПоказатьОтчет.Видимость = Истина;
		Элементы.ФормаОтчетФидуциарнаяОтветственность.Видимость = Истина;
		Элементы.ФормаОтчетФидуциарнаяОтветственностьРасшифровка.Видимость = Истина;
		Элементы.ФормаОтчетФидуциарнаяОтветственностьСводный.Видимость = Истина;
		Элементы.ФормаВыгрузитьОтчетФидуциарнаяОтветственность.Видимость = Ложь;
		Элементы.РежимГрупповогоКонтроля.Видимость = Ложь;
		
		РеквизитыКонтроля = ПолучитьРеквизитыКонтроля(Объект.Период, Объект.Организация, Объект.СчетДоверительногоУправления);

		ЭтаФорма.РегистрацияСтоимостиАктивов = РеквизитыКонтроля.РегистрацияСтоимостиАктивов;
		ЭтаФорма.РегистрацияСтоимостиАктивов_СЧА = РеквизитыКонтроля.РегистрацияСтоимостиАктивов_СЧА;
		ЭтаФорма.РегистрацияСтоимостиАктивов_РСА = РеквизитыКонтроля.РегистрацияСтоимостиАктивов_РСА;
		ЭтаФорма.РегистрацияСтоимостиАктивов_КЗ = РеквизитыКонтроля.РегистрацияСтоимостиАктивов_КЗ;
		
		УстановитьВидимость(ЭтаФорма);
		УстановитьПереключательТипа(ЭтаФорма);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультатыПроверки(ДеревоПриемник, ДеревоИсточник, ОчищатьПередЗаполнением = Истина)

	Если ОчищатьПередЗаполнением Тогда
		ДеревоПриемник.Строки.Очистить();
	КонецЕсли;
	
	НомерСтроки = 0;
	Показатели = Объект.ИнвестиционнаяДекларация.Показатели.Выгрузить(, "НомерСтроки, ИдентификаторСтрокиПоказателей, НаборИнвестиционнойДекларации, ВнутреннийНабор");
	
	Для каждого СтрокаДеревоИсточник Из ДеревоИсточник.Строки Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаДеревоПриемник = ДеревоПриемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДеревоПриемник, СтрокаДеревоИсточник);
		
		Если Не ЗначениеЗаполнено(СтрокаДеревоПриемник.ИдентификаторСтрокиПоказателей) Тогда
		
			СтрокаИД = Показатели.Найти(НомерСтроки, "НомерСтроки");
			Если СтрокаИД <> Неопределено Тогда
			
				СтрокаДеревоПриемник.ИдентификаторСтрокиПоказателей = СтрокаИД.ИдентификаторСтрокиПоказателей;
				СтрокаДеревоПриемник.ПредставлениеНабора = Формат(СтрокаИД.НомерСтроки, "ЧГ=0") + ". " + СтрокаИД.НаборИнвестиционнойДекларации + ?(СтрокаИД.ВнутреннийНабор, " (внутр.) ", "");
				СтрокаДеревоПриемник.НомерСтроки = СтрокаИД.НомерСтроки;
			
			КонецЕсли; 
		
		КонецЕсли; 
		
		Если СтрокаДеревоИсточник.РезультатПроверки = "Не пройдена" Тогда
			СтрокаДеревоПриемник.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
		ИначеЕсли СтрокаДеревоИсточник.РезультатПроверки = "Пройдена" Тогда 
			СтрокаДеревоПриемник.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
		КонецЕсли; 
		
		ЗаполнитьРезультатыПроверки(СтрокаДеревоПриемник, СтрокаДеревоИсточник, Ложь);
		
	КонецЦикла;
		
КонецПроцедуры
 

&НаКлиенте
Процедура ОстановитьВыполнениеКонтроля(Команда)
	
	Если Вопрос("Отменить выполнение группового контроля?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
	
		ОтключитьОбработчикОжидания("ПроверитьСостояниеЗаданий");
		ЗавершитьЗаданияНаСервере(ЭтаФорма.ИдентификаторЗадания);
		ЗаполнитьСостоянияЗаданийНаСервере();
		ЭтаФорма.ИдентификаторЗадания = Неопределено;
		ИзменитьДоступностьЭлементов(Истина);
		
		ЗарегистрироватьОкончаниеСессииСбораСтатистики(ЭтаФорма.СессияСбораСтатистики, Истина);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗавершитьЗаданияНаСервере(ИдентификаторЗадания)

	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСДлительнымиОперациями.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
	МассивЗаданий = Новый Массив;
	МассивЗаданий.Добавить(ФоновоеЗадание);
	
	Попытка
		ФоновыеЗадания.ОжидатьЗавершения(МассивЗаданий);
	Исключение
	КонецПопытки;
		
	ИмяПодчиненныхЗаданий = "Контроль инвестиционной декларации (" + ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса + ")";
	МассивПодчиненных = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование, Статус", ИмяПодчиненныхЗаданий, СостояниеФоновогоЗадания.Активно));
	Для каждого ФоновоеЗадание Из МассивПодчиненных Цикл
		РаботаСДлительнымиОперациями.ОтменитьВыполнениеЗадания(ФоновоеЗадание.УникальныйИдентификатор);
	КонецЦикла; 
	
	Попытка
		ФоновыеЗадания.ОжидатьЗавершения(МассивПодчиненных);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Отладка_КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = Отладка_Каталог;
	
	Если Диалог.Выбрать() Тогда
		Отладка_Каталог = Диалог.Каталог;
	КонецЕсли;
			
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ПараметрыСбораСтатистики)
	
	Описание = "";
	
	Для каждого Параметр Из ПараметрыСбораСтатистики Цикл
	
		Описание = Описание + Символы.ПС + Параметр.Ключ + ": " + Параметр.Значение;
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыСбораСтатистики, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессииСбораСтатистики(СессияСбораСтатистики, ОтмененоПользователем)

	Механизм = "_КонтрольИнвестиционныхДеклараций.ВыполнитьГрупповойКонтрольФоново";
	
	Если ОтмененоПользователем Тогда
		
		Запись = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.СоздатьМенеджерЗаписи();
		Запись.Механизм = "_КонтрольИнвестиционныхДеклараций.ВыполнитьГрупповойКонтрольФоново";
		Запись.Сессия   = СессияСбораСтатистики;
		Запись.Прочитать();
		
		Если Запись.Выбран() Тогда
			Запись.ПериодВыполненияОкончание = ТекущаяДата();
			Запись.ПериодВыполненияОкончаниеМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Запись.Описание = "Выполнение контроля отменено пользователем" + Символы.ПС + Запись.Описание;
			Запись.Записать();	
		КонецЕсли;
		
	Иначе
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, СессияСбораСтатистики);
	КонецЕсли; 	

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызовМетодаМодуляОбработки(Команда)
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить("СоздатьОтложенные", "Создать отложенные задания");
	СписокКнопок.Добавить("СоздатьОтложенные2", "Создать отложенные задания Т+1");
	СписокКнопок.Добавить("КонтрольНовых", "Контроль новых ИД");
	СписокКнопок.Добавить("ЗапускОтложенныхЗаданий", "Запуск отложенных заданий");
	Метод = Вопрос("Что делать?", СписокКнопок, , "ЗапускОтложенныхЗаданий"); 
	
	Если ТипЗнч(Метод) = Тип("Строка") Тогда
		
		Если СтрНачинаетсяС(Метод, "СоздатьОтложенные") Тогда
			// КонтрольИнвестиционныхДекларацийЗаТекущийДень
			КнопкиРежима = Новый СписокЗначений;
			КнопкиРежима.Добавить("Все", 		"Без отбора");
			КнопкиРежима.Добавить("ТолькоИИС", 	"Только ИИС");
			КнопкиРежима.Добавить("БезИИС", 	"Исключая ИИС");
			КнопкиРежима.Добавить("СвойОтбор", 	"Свой отбор");
			КнопкиРежима.Добавить(Неопределено, "Отмена");
			РежимОтбора = Вопрос("Выберите режим отбора", КнопкиРежима, , "СвойОтбор");
			
			Если ТипЗнч(РежимОтбора) = Тип("Строка") Тогда
				Если РежимОтбора = "СвойОтбор" Тогда
					РежимОтбора = "СчетаДоверительногоУправления.Код = ""РНТ-00035""";
					ВвестиСтроку(РежимОтбора, "Секция 'ГДЕ' запроса к справочнику счетов ДУ",, Истина);
					Если РежимОтбора <> Неопределено Тогда
						ВызовМетодаМодуляОбработкиНаСервере(Метод, РежимОтбора)
					КонецЕсли;
				Иначе
					ВызовМетодаМодуляОбработкиНаСервере(Метод, РежимОтбора);
				КонецЕсли; 
			КонецЕсли;
			
		ИначеЕсли Метод = "ЗапускОтложенныхЗаданий" Тогда 
			ПараметрыФормы = Новый Структура("РежимВыбора, МножественныйВыбор, ЗакрыватьПриВыборе", Истина, Истина, Истина);
			Результат = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.ФормаВыбораОтложенныхЗаданийДляЗапуска", ПараметрыФормы);
			Если Результат <> Неопределено Тогда
				ВызовМетодаМодуляОбработкиНаСервере(Метод, Результат);
			КонецЕсли; 
		Иначе	
			ВызовМетодаМодуляОбработкиНаСервере(Метод);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВызовМетодаМодуляОбработкиНаСервере(Метод, Отбор = "") 
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если СтрНачинаетсяС(Метод, "СоздатьОтложенные") Тогда
		
		ПараметрыКоманды = Новый Структура("Организация, Режим", Объект.Организация, Отбор);
			
		ПараметрыОбработки = Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды", 
			РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_КонтрольИнвестиционныхДеклараций"), 
			"СоздатьОтложенныеЗаданияКонтроляТекущегоДня");
	
		Префикс = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКоманды.Организация, "ПрефиксНумерации"); 
		
		Если Метод = "СоздатьОтложенные" Тогда
			
			// Текущий день
			Период = НачалоДня(ТекущаяДатаСеанса());
			Команда = СтрШаблон("КонтрольТекущегоДня_%1_%2", Префикс, ПараметрыКоманды.Режим);
			
		Иначе
			
			// День Т+1
			Период = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ТекущаяДатаСеанса()) + 1, 1);
			Команда = СтрШаблон("КонтрольДняТПлюс1_%1_%2", Префикс, ПараметрыКоманды.Режим);
		
		КонецЕсли; 
		
		ПараметрыОЗ = Новый Структура;
		ПараметрыОЗ.Вставить("Период", 				Период);
		ПараметрыОЗ.Вставить("Организация", 		ПараметрыКоманды.Организация);
		ПараметрыОЗ.Вставить("Режим", 				ПараметрыКоманды.Режим);
		ПараметрыОЗ.Вставить("ДатаЗапускаПлан", 	Неопределено);
		ПараметрыОЗ.Вставить("Команда", 			Команда);
		ПараметрыОЗ.Вставить("ИдентификаторКоманды", 			ПараметрыОбработки.ИдентификаторКоманды);
		ПараметрыОЗ.Вставить("ДополнительнаяОбработкаСсылка", 	ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
		
		ОбъектНаСервере.СоздатьОтложенныеЗаданияКонтроляЗаДень(ПараметрыОЗ);
		
	ИначеЕсли Метод = "КонтрольНовых" Тогда 	
		
		ПараметрыКоманды = Новый Структура("Организация", Объект.Организация);
			
		ПараметрыОбработки = Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды", 
			РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_КонтрольИнвестиционныхДеклараций"), 
			"КонтрольНовыхИнвестиционныхДекларацийЗа7Дней");
			
		ОбъектНаСервере.КонтрольНовыхИнвестиционныхДекларацийЗа7Дней(ПараметрыКоманды, ПараметрыОбработки);
		
	ИначеЕсли Метод = "ЗапускОтложенныхЗаданий" Тогда 
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ОтложенныеЗадания.Идентификатор КАК Идентификатор,
			|	ОтложенныеЗадания.Параметры КАК Параметры,
			|	ОтложенныеЗадания.Команда КАК Команда
			|ИЗ
			|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
			|ГДЕ
			|	ОтложенныеЗадания.Идентификатор В(&Идентификаторы)";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		
		Идентификаторы = Новый Массив;
		Для каждого Ключ Из Отбор Цикл
			Идентификаторы.Добавить(Ключ.Идентификатор);
		КонецЦикла; 
		
		Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Экземпляры = Новый Массив;
		Метод = "";
		Пока Выборка.Следующий() Цикл
		
			Экземпляры.Добавить(Новый Структура("Параметры, Идентификатор", 
				Выборка.Параметры.Получить(), 
				Выборка.Идентификатор));
				
			Если Метод = "" Тогда
			
				Метод = Выборка.Команда;
			
			КонецЕсли;
				
		КонецЦикла;
		Если Экземпляры.Количество() > 0 Тогда
			ОбъектНаСервере.ВыполнитьМетод(Метод, Экземпляры);
		КонецЕсли; 	
		
	КонецЕсли; 

КонецПроцедуры

&НаСервереБезКонтекста
Функция АктуальнаяВерсияОбработки()
	
	Возврат РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_КонтрольИнвестиционныхДеклараций").Версия;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимость(ЭтаФорма)

	ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ПодсказкаВвода = "По назначенным ИД"; 
		
	ЭтаФорма.Элементы.Клиент.АвтоОтметкаНезаполненного = Истина;
	ЭтаФорма.Элементы.ВидДоговораДоверительногоУправления1.АвтоОтметкаНезаполненного = Истина;
	
	ЭтаФорма.Элементы.СчетДоверительногоУправления.АвтоОтметкаНезаполненного = Ложь;
	ЭтаФорма.Элементы.СчетДоверительногоУправления.ОтметкаНезаполненного = Ложь;
	ЭтаФорма.Элементы.ИнвестиционнаяДекларация.АвтоОтметкаНезаполненного = Ложь;
	ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ОтметкаНезаполненного = Ложь;
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля = "Авто" Тогда
		
		ЭтаФорма.Элементы.Клиент.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.КлиентПИФ.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.ВидДоговораДоверительногоУправления1.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.СчетДоверительногоУправления.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ТолькоПросмотр = Истина;
		
	ИначеЕсли ЭтаФорма.РежимСовокукпногоКонтроля = "Совокупно" Тогда 
		
		ЭтаФорма.Элементы.Клиент.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.КлиентПИФ.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.ВидДоговораДоверительногоУправления1.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.СчетДоверительногоУправления.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ТолькоПросмотр = Ложь;
		
	ИначеЕсли ЭтаФорма.РежимСовокукпногоКонтроля = "Индивидуально" Тогда 
		
		ЭтаФорма.Элементы.Клиент.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.КлиентПИФ.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.ВидДоговораДоверительногоУправления1.ТолькоПросмотр = Истина;
		ЭтаФорма.Элементы.СчетДоверительногоУправления.ТолькоПросмотр = Ложь;
		ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ТолькоПросмотр = Ложь;
		
		ЭтаФорма.Элементы.ИнвестиционнаяДекларация.ПодсказкаВвода = "";
		ЭтаФорма.Элементы.Клиент.АвтоОтметкаНезаполненного = Ложь;
		ЭтаФорма.Элементы.ВидДоговораДоверительногоУправления1.АвтоОтметкаНезаполненного = Ложь;
		
		ЭтаФорма.Элементы.СчетДоверительногоУправления.АвтоОтметкаНезаполненного = Истина;
		ЭтаФорма.Элементы.ИнвестиционнаяДекларация.АвтоОтметкаНезаполненного = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры
 
&НаСервере
Процедура ПолучитьРезультатыКонтроляНаСервере()

	Элементы.ЗагрузитьРезультатыКонтроля.Видимость = Ложь;
	
	СтруктураОтбора = Новый Структура("Организация, Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация");
	ЗаполнитьЗначенияСвойств(СтруктураОтбора, Объект);
	СтруктураОтбора.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
	СтруктураОтбора.Вставить("РежимСовокукпногоКонтроля", ЭтаФорма.РежимСовокукпногоКонтроля);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыОтбора = ОбработкаОбъект.ПараметрыОтбораДляХранилищаЗначений(СтруктураОтбора);
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ДатаСоздания КАК ДатаСоздания,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Источник = ""_КонтрольИнвестиционныхДеклараций""
		|	И ХранилищеЗначений.КонтрольнаяСумма = &КонтрольнаяСумма
		|
		|УПОРЯДОЧИТЬ ПО
		|	ХранилищеЗначений.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("КонтрольнаяСумма", ПараметрыОтбора.КонтрольнаяСумма);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивРезультатовКонтроля = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Значение = Выборка.ХранилищеЗначения.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			
			МассивРезультатовКонтроля.Добавить(Выборка.Идентификатор);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если МассивРезультатовКонтроля.Количество() > 0 Тогда
		
		Элементы.ЗагрузитьРезультатыКонтроля.Видимость = Истина;
		ЭтаФорма.АдресМассиваРезультатовКонтроля = ПоместитьВоВременноеХранилище(МассивРезультатовКонтроля, ЭтаФорма.АдресМассиваРезультатовКонтроля);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРезультатыКонтроляНажатие(Элемент)
	
	ПолучитьРезультатыКонтроляНаСервере();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МассивИдентификаторов", ПолучитьИзВременногоХранилища(АдресМассиваРезультатовКонтроля));
	
	Результат = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.ФормаЗагрузкиРезультатов", ПараметрыФормы, ЭтаФорма);
	Если Результат <> Неопределено Тогда
		ЗагрузитьРезультатыПроверкиНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимФильтрацииРезультатовИндивидуальногоКонтроляПриИзменении(Элемент)
	
	ЗаполнитьОтчетПоРезультатамКонтроляНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтчетПоРезультатамКонтроляНаСервере(Знач Дерево = Неопределено)

	Если Дерево = Неопределено Тогда
		Дерево = РеквизитФормыВЗначение("РезультатыПроверки");
	КонецЕсли; 
	
	ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Очистить();
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("РезультатыКонтроля");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	СтрокаИД = Макет.ПолучитьОбласть("СтрокаИД");
	Строка = Макет.ПолучитьОбласть("Строка");
	ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Вывести(Шапка);
	ЭтаФорма.ТабличныйДокументРезультатыКонтроля.ФиксацияСверху = 1;
	
	Нарушение = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
	Несоответствие = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие;
	ПроверкаПройдена = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
	
	ТекущаяИД = Неопределено;
	ТекущееНазначение = Неопределено;
	ЭтаФорма.ДанныеРасшифровкиРезультатовКонтроля = Новый Структура;
	ИндексРасшифровки = 0;
	// добавить заполнение консолидирующих ИД
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
	
		Если ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 0 // выводим все строки
			Или (ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 1 // любые нарушения 
				И СтрокаДерева.РезультатПроверки <> ПроверкаПройдена)
			Или (ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 2 // нарушения ИД 
				И СтрокаДерева.РезультатПроверки = Нарушение И Не СтрокаДерева.ВнутреннийНабор)
			Или (ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 3 // нарушения внутр 
				И СтрокаДерева.РезультатПроверки = Нарушение И СтрокаДерева.ВнутреннийНабор)
			Или (ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 4 // несоответствия ИД
				И СтрокаДерева.РезультатПроверки = Несоответствие И Не СтрокаДерева.ВнутреннийНабор)
			Или (ЭтаФорма.РежимФильтрацииРезультатовИндивидуальногоКонтроля = 5 // несоответствия внутр
				И СтрокаДерева.РезультатПроверки = Несоответствие И СтрокаДерева.ВнутреннийНабор) Тогда 
				
			Если ТекущаяИД <> СтрокаДерева.ИнвестиционнаяДекларация Или ТекущееНазначение <> СтрокаДерева.Назначение Тогда
				// выводим название ИД
				
				Если ТекущаяИД <> Неопределено Тогда
				
					ЭтаФорма.ТабличныйДокументРезультатыКонтроля.ЗакончитьГруппуСтрок();
				
				КонецЕсли; 
				
				РеквизитыИД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДерева.ИнвестиционнаяДекларация, "ТипИнвестиционнойДекларации, СовокупныйКонтроль, Наименование, Комментарий");
				
				ПредставлениеИнвестиционнойДекларации = Строка(РеквизитыИД.ТипИнвестиционнойДекларации) + ?(РеквизитыИД.СовокупныйКонтроль, " (совокупно): ", ": ") 
					+ ?(РеквизитыИД.ТипИнвестиционнойДекларации = Перечисления.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация, Строка(СтрокаДерева.Назначение.Субъект) + " - ", "")
					+ РеквизитыИД.Наименование + ?(ЗначениеЗаполнено(РеквизитыИД.Комментарий), Символы.ПС + РеквизитыИД.Комментарий, "");
					
				СтрокаИД.Параметры.ПредставлениеИнвестиционнойДекларации = ПредставлениеИнвестиционнойДекларации;
				СтрокаИД.Параметры.РасшифровкаИД = ДобавитьРасшифровку(ИндексРасшифровки, "ИД", СтрокаДерева);
				СтрокаИД.Параметры.Назначение = "Действует с " + Формат(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДерева.Назначение, "Дата"), "ДФ=dd.MM.yyyy");
				СтрокаИД.Параметры.НазначениеСсылка = ДобавитьРасшифровку(ИндексРасшифровки, "Назначение", СтрокаДерева);
				
				ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Вывести(СтрокаИД);
				
				ТекущаяИД = СтрокаДерева.ИнвестиционнаяДекларация;
				ТекущееНазначение = СтрокаДерева.Назначение;
				ЭтаФорма.ТабличныйДокументРезультатыКонтроля.НачатьГруппуСтрок();
				
			КонецЕсли; 	
				
			Строка.Параметры.Заполнить(СтрокаДерева);
			Строка.Параметры.РасшифровкаНабора = ДобавитьРасшифровку(ИндексРасшифровки, "Набор", СтрокаДерева);
			Строка.Параметры.РасшифровкаРезультата = ДобавитьРасшифровку(ИндексРасшифровки, "Результат", СтрокаДерева);
						
			Строка.Параметры.Мин = Строка(СтрокаДерева.МинимальноеЗначение) + ?(СтрокаДерева.АбсолютнаяВеличинаМин, "", "%");
			Строка.Область().ЦветТекста = Новый Цвет(0, 0, 0);
			Если СтрокаДерева.АбсолютнаяВеличинаМакс И СтрокаДерева.МаксимальноеЗначение = 0 Тогда
				Строка.Параметры.Макс = "Без ограничения";
				Строка.Область("Макс").ЦветТекста = Новый Цвет(128, 128, 128);
			Иначе
				Строка.Параметры.Макс = Строка(СтрокаДерева.МаксимальноеЗначение) + ?(СтрокаДерева.АбсолютнаяВеличинаМакс, "", "%");		
			КонецЕсли; 
			
			Если СтрокаДерева.ГруппаРезультатов Тогда
			
				Строка.Параметры.Сумма = "{...}";
				Строка.Параметры.Доля = "{...}";
				
			Иначе
				
				Строка.Параметры.Сумма = Формат(СтрокаДерева.Сумма, "ЧДЦ=2; ЧН=0,00");
				
				Если Строка.Параметры.Доля = 999 Тогда
					Строка.Параметры.Доля = "База = 0";
				Иначе
					Строка.Параметры.Доля = Формат(СтрокаДерева.Доля, "ЧДЦ=2; ЧН=0,00");
				КонецЕсли;			
			
			КонецЕсли; 
			
			Если СтрокаДерева.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение Тогда
				Строка.Область().ЦветТекста = Новый Цвет(255, 0, 0);
			ИначеЕсли СтрокаДерева.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие Тогда 
				Строка.Область().ЦветТекста = Новый Цвет(205, 92, 92);
			КонецЕсли; 
			
			Если СтрокаДерева.ВнутреннийНабор Тогда
				Строка.Область("ПредставлениеНабора").ЦветТекста = Новый Цвет(128, 128, 128);
			КонецЕсли; 
			
			ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Вывести(Строка);				
				
		КонецЕсли; 
		
	КонецЦикла;
	Если ТекущаяИД <> Неопределено Тогда
		ЭтаФорма.ТабличныйДокументРезультатыКонтроля.ЗакончитьГруппуСтрок();
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументРезультатыКонтроля, "НеИспользовать");
	Элементы.ТабличныйДокументРезультатыКонтроля.ТекущаяОбласть = ЭтаФорма.ТабличныйДокументРезультатыКонтроля.Область(1,1,1,1);

КонецПроцедуры

&НаСервере
Функция ДобавитьРасшифровку(ИндексРасшифровки, ИмяОбъектаРасшифровки, СтрокаДерева)

	 ЭлементРасшифровки = Новый Структура("Назначение, ИнвестиционнаяДекларация, ИдентификаторСтрокиПоказателей");
	 ЗаполнитьЗначенияСвойств(ЭлементРасшифровки, СтрокаДерева);
	 ЭлементРасшифровки.Вставить("Объект", ИмяОбъектаРасшифровки);
	 КлючЭлемента = "_" + Формат(ИндексРасшифровки, "ЧГ=0");
	 ЭтаФорма.ДанныеРасшифровкиРезультатовКонтроля.Вставить(КлючЭлемента, ЭлементРасшифровки);
	 ИндексРасшифровки = ИндексРасшифровки + 1;
	 Возврат КлючЭлемента;
	 
КонецФункции
 
&НаКлиенте
Процедура ТабличныйДокументРезультатыКонтроляОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Расшифровка) = Тип("Строка") И СтрНачинаетсяС(Расшифровка, "_") Тогда
		
		ЭлементРасшифровки = ЭтаФорма.ДанныеРасшифровкиРезультатовКонтроля[Расшифровка];
		
		СтрокиДерева = ЭтаФорма.РезультатыПроверки.ПолучитьЭлементы();
		
		Для каждого ТекСтрока Из СтрокиДерева Цикл
			
			Если ТекСтрока.ИнвестиционнаяДекларация = ЭлементРасшифровки.ИнвестиционнаяДекларация 
				И ТекСтрока.ИдентификаторСтрокиПоказателей = ЭлементРасшифровки.ИдентификаторСтрокиПоказателей 
				И ТекСтрока.Назначение = ЭлементРасшифровки.Назначение Тогда
				
				Если ЭлементРасшифровки.Объект = "Результат" Тогда
					
					ВывестиРасшифровку(ТекСтрока.ИмяВложенногоОбъекта, ТекСтрока.НомерБазиса, ТекСтрока.ИмяПоляДоля);
					
				ИначеЕсли ЭлементРасшифровки.Объект = "Набор" Тогда 
					
					Форма = ПолучитьФорму("Справочник.ИнвестиционныеДекларации.Форма.ФормаЭлемента", Новый Структура("Ключ", ТекСтрока.ИнвестиционнаяДекларация), Элемент, ЭтаФорма);
					НайденныеСтроки = Форма.Объект.Показатели.НайтиСтроки(Новый Структура("ИдентификаторСтрокиПоказателей", ЭлементРасшифровки.ИдентификаторСтрокиПоказателей));
					Если Форма.Открыта() Тогда
					    Форма.Активизировать();
					Иначе
						Форма.Открыть();
					КонецЕсли; 
					Если НайденныеСтроки.Количество() = 1 Тогда
						Форма.Элементы.Показатели.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
					КонецЕсли;
					
				ИначеЕсли ЭлементРасшифровки.Объект = "ИД" Тогда 
					
					Форма = ПолучитьФорму("Справочник.ИнвестиционныеДекларации.Форма.ФормаЭлемента", Новый Структура("Ключ", ТекСтрока.ИнвестиционнаяДекларация), Элемент, ЭтаФорма);
					Если Форма.Открыта() Тогда
					    Форма.Активизировать();
					Иначе
						Форма.Открыть();
					КонецЕсли;
					
				ИначеЕсли ЭлементРасшифровки.Объект = "Назначение" И ЗначениеЗаполнено(ТекСтрока.Назначение) Тогда 
					
					Форма = ПолучитьФорму("Документ.НазначениеИнвестиционнойДекларации.Форма.ФормаДокумента", Новый Структура("Ключ", ТекСтрока.Назначение), Элемент, ЭтаФорма);
					Если Форма.Открыта() Тогда
					    Форма.Активизировать();
					Иначе
						Форма.Открыть();
					КонецЕсли;
					
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументРезультатыКонтроляОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Расшифровка) = Тип("Строка") И СтрНачинаетсяС(Расшифровка, "_") Тогда
		
		ЭлементРасшифровки = ЭтаФорма.ДанныеРасшифровкиРезультатовКонтроля[Расшифровка];
		
		Если ЭлементРасшифровки.Объект = "Результат" Тогда
			
			СтрокиДерева = ЭтаФорма.РезультатыПроверки.ПолучитьЭлементы();
			
			Для каждого ТекСтрока Из СтрокиДерева Цикл
				
				Если ТекСтрока.ИнвестиционнаяДекларация = ЭлементРасшифровки.ИнвестиционнаяДекларация 
					И ТекСтрока.ИдентификаторСтрокиПоказателей = ЭлементРасшифровки.ИдентификаторСтрокиПоказателей 
					И ТекСтрока.Назначение = ЭлементРасшифровки.Назначение
					И ТекСтрока.РезультатПроверки <> ПредопределенноеЗначение("Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена") Тогда
					
					СписокДействий = Новый СписокЗначений;
						
					СписокДействий.Добавить("ПоказатьРасшифровку", "Открыть расшифровку");
						
					//Если Не ЗначениеЗаполнено(ТекСтрока.НесоответствиеИнвестиционнойДекларации)
					//	Или (ЗначениеЗаполнено(ТекСтрока.ДатаУстранения) И ТекСтрока.ДатаУстранения < Объект.Период) Тогда 
					СписокДействий.Добавить("Создать", "Зарегистрировать несоответствие");
					//КонецЕсли; 
					
					Если ЗначениеЗаполнено(ТекСтрока.НесоответствиеИнвестиционнойДекларации) Тогда
						СписокДействий.Добавить("Открыть", "Открыть документ");
					КонецЕсли;
						
					Действие = ВыбратьИзМеню(СписокДействий);
					
					Если Действие = Неопределено Тогда
						Возврат;
					ИначеЕсли Действие.Значение = "Создать" Тогда
						ПараметрыЗполнения = Новый Структура("ИмяВложенногоОбъекта, НомерБазиса, ИнвестиционнаяДекларация, ИдентификаторСтрокиПоказателей");
						ЗаполнитьЗначенияСвойств(ПараметрыЗполнения, ТекСтрока);
						РеквизитыНазначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Назначение, "Субъект, ВидДоговораДоверительногоУправления"); 
						ПараметрыЗполнения.Вставить("Дата", Объект.Период);
						ПараметрыЗполнения.Вставить("Организация", Объект.Организация);
						ПараметрыЗполнения.Вставить("Субъект", РеквизитыНазначения.Субъект);
						ПараметрыЗполнения.Вставить("ВидДоговораДоверительногоУправления", РеквизитыНазначения.ВидДоговораДоверительногоУправления);
						ЗначенияЗаполнения = ПолучитьЗначенияЗаполненияНесоответствиеИД(ПараметрыЗполнения);
						ОткрытьФорму("Документ.НесоответствиеИнвестиционнойДекларации.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения));
					ИначеЕсли Действие.Значение = "Открыть" Тогда
						ОткрытьФорму("Документ.НесоответствиеИнвестиционнойДекларации.ФормаОбъекта", Новый Структура("Ключ", ТекСтрока.НесоответствиеИнвестиционнойДекларации));
					ИначеЕсли Действие.Значение = "ПоказатьРасшифровку" Тогда
						ВывестиРасшифровку(ТекСтрока.ИмяВложенногоОбъекта, ТекСтрока.НомерБазиса, ТекСтрока.ИмяПоляДоля);
					КонецЕсли;
					
					Прервать;
				
				КонецЕсли; 
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	НаборДействий = Новый Массив;
	НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
	НаборДействий.Добавить("ЗаполнитьВидДоговора");
	НаборДействий.Добавить("ЗаполнитьСостав");
	НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Совокупно" Тогда
	
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
	
	КонецЕсли; 
		
	ОбновитьРеквизитыКонтроля(НаборДействий);
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораДоверительногоУправления1ПриИзменении(Элемент)

	НаборДействий = Новый Массив;
	НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
	НаборДействий.Добавить("ЗаполнитьСостав");
	НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля <> "Совокупно" Тогда
	
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
	
	КонецЕсли; 
		
	ОбновитьРеквизитыКонтроля(НаборДействий);
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимСовокукпногоКонтроляПриИзменении(Элемент)
	
	ЭтаФорма.СовокупнаяИнвестДекларация = (ЭтаФорма.РежимСовокукпногоКонтроля = "Совокупно");
	
	НаборДействий = Новый Массив;
	
	Если ЭтаФорма.РежимСовокукпногоКонтроля = "Авто" Тогда
	
		Если ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
			НаборДействий.Добавить("ЗаполнитьКлиента");
		Иначе
			НаборДействий.Добавить("ЗаполнитьСчетДоверительногоУправления");
		КонецЕсли; 
		
		НаборДействий.Добавить("ЗаполнитьВидДоговора");
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
		
	ИначеЕсли ЭтаФорма.РежимСовокукпногоКонтроля = "Индивидуально" И ЗначениеЗаполнено(Объект.СчетДоверительногоУправления)
		И Не ЗначениеЗаполнено(Объект.ИнвестиционнаяДекларация) Тогда
		
		НаборДействий.Добавить("ЗаполнитьИнвестиционнуюДекларацию");
		
	КонецЕсли; 
	
	НаборДействий.Добавить("ЗаполнитьСостав");
	НаборДействий.Добавить("ЗаполнитьДанныеРСА");
	
	ОбновитьРеквизитыКонтроля(НаборДействий);
	
	//УстановитьВидимость(ЭтаФорма);
	//ПолучитьРезультатыКонтроляНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПИФПриИзменении(Элемент)
	
	Если ЭтаФорма.КлиентПИФ = 0 Тогда
		Объект.Клиент = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
	Иначе
		Объект.Клиент = ПредопределенноеЗначение("Справочник.ПаевыеИнвестиционныеФонды.ПустаяСсылка");
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПереключательТипа(Этаформа)

	Если ТипЗнч(Этаформа.Объект.Клиент) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ЭтаФорма.КлиентПИФ = 0;
	ИначеЕсли ТипЗнч(Этаформа.Объект.Клиент) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		ЭтаФорма.КлиентПИФ = 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазрешитьИзменениеРежимаПолученияСтоимости(Команда)
	
	Элементы.ФормаРазрешитьИзменениеРежимаПолученияСтоимости.Пометка = Не Элементы.ФормаРазрешитьИзменениеРежимаПолученияСтоимости.Пометка;
	Элементы.ДинамическийРасчетСтоимости.Видимость = Элементы.ФормаРазрешитьИзменениеРежимаПолученияСтоимости.Пометка;
	Элементы.ДинамическийРасчетСтоимости.Доступность = Элементы.ФормаРазрешитьИзменениеРежимаПолученияСтоимости.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСкрытьНастройки(Команда)
	
	Элементы.КомандаСкрытьНастройки.Пометка = Не Элементы.КомандаСкрытьНастройки.Пометка;
	
	Если Элементы.КомандаСкрытьНастройки.Пометка Тогда
	
		Элементы.КомандаСкрытьНастройки.Заголовок = "Показать параметры";
		Элементы.КомандаСкрытьНастройки.Картинка = БиблиотекаКартинок.ПоказатьПароль;
		
	Иначе
		
		Элементы.КомандаСкрытьНастройки.Заголовок = "Скрыть параметры";
		Элементы.КомандаСкрытьНастройки.Картинка = БиблиотекаКартинок.СкрытьПароль;
	
	КонецЕсли;
	
	Элементы.ДекорацияПараметрыИндивидуальногоКонтроля.Видимость = Элементы.КомандаСкрытьНастройки.Пометка;
	Элементы.Шапка.Видимость = Не Элементы.КомандаСкрытьНастройки.Пометка;
	Элементы.ГруппаПретрейд.Видимость = Не Элементы.КомандаСкрытьНастройки.Пометка;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьДекорациюДатаМаксДД(ДатаМаксДД)

	Элементы.ДатаМаксДД.Видимость = Истина;
	Если ЗначениеЗаполнено(ДатаМаксДД) Тогда
		Элементы.ДатаМаксДД.Заголовок = "Не удалось определить показатель MaxDD";
	Иначе
		Элементы.ДатаМаксДД.Заголовок = "Для расчета показателя MaxDD использована СЧА на "
			+ Формат(ДатаМаксДД, "ДФ=dd.MM.yyyy");
	КонецЕсли;

КонецПроцедуры