&НаСервере
Функция ПолучитьТабличныйДокументБазиса(ПараметрыФормирования)
	
	Базис = ПараметрыФормирования.Базис;
	//Настройки = ПараметрыФормирования.КомпоновщикНастроек.ПолучитьНастройки();	
	Настройки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресНастроекБазиса);
	СКД = ПолучитьИзВременногоХранилища(ПараметрыФормирования.АдресСКДБазиса);
	
	ПараметрыБазиса = Новый Структура;
	Для каждого ПараметрСКД Из Настройки.ПараметрыДанных.Элементы Цикл
		Если ПараметрСКД.Использование Тогда
			ПараметрыБазиса.Вставить(ПараметрСКД.Параметр, ПараметрСКД.Значение);
		КонецЕсли; 
	КонецЦикла; 
	
	ПараметрыБазиса.Вставить("Организация", ПараметрыФормирования.СчетДоверительногоУправления.Организация);
	ПараметрыБазиса.Вставить("СчетДоверительногоУправления", ПараметрыФормирования.СчетДоверительногоУправления);
	ПараметрыБазиса.Вставить("Период", КонецДня(ПараметрыФормирования.Период));
	ПараметрыБазиса.Вставить("грПериод", Новый Граница(КонецДня(ПараметрыФормирования.Период), ВидГраницы.Включая));
	ПараметрыБазиса.Вставить("Претрейд", Объект.Претрейд.Выгрузить());
	ПараметрыБазиса.Вставить("КонтрольЗаПрошлыйПериод", 	НачалоДня(ТекущаяДатаСеанса()) > НачалоДня(ПараметрыФормирования.Период));
	ПараметрыБазиса.Вставить("УчитыватьПлановыеОперации", 	Объект.УчитыватьПлановыеОперации);
	ПараметрыБазиса.Вставить("ДинамическийРасчетСтоимости",	Объект.ДинамическийРасчетСтоимости);
		
	Если ПараметрыФормирования.СовокупнаяИнвестДекларация Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли; 
	
	СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
			
	Если ПараметрыФормирования.АвтоматическоеФормирование Тогда
		ПараметрыБазисов = СтруктураРезультатовПроверки.ПараметрыБазисов.Получить();
		Если ТипЗнч(ПараметрыБазисов) = Тип("Соответствие") Тогда
			ПараметрыБазиса = ПараметрыБазисов[Базис];
		Иначе
			КлючПараметров = Новый Структура("Базис, ИспользоватьМинимальноеЗначениеРейтинга", Базис, Объект.ИнвестиционнаяДекларация.ИспользоватьМинимальноеЗначениеРейтинга);
			НайденныеСтроки = ПараметрыБазисов.НайтиСтроки(КлючПараметров);
			Если НайденныеСтроки.Количество() <> 0 Тогда
				ПараметрыБазиса = НайденныеСтроки[0].Параметры;
			КонецЕсли; 
		КонецЕсли;
		ТаблицаБазиса = ПараметрыБазиса.ТаблицаБазиса;
	Иначе	
		ТаблицаБазиса = Неопределено;
		Для каждого СтрокаСовокупнойИД Из ПолучитьИзВременногоХранилища(ПараметрыФормирования.АдресСоставаСовокупнойИнвестДекларации) Цикл
			Если СтрокаСовокупнойИД.Включен Тогда
				
				ЦельРасчета 						= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
				НастройкиОценки 					= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыФормирования.Период, СтрокаСовокупнойИД.Организация, СтрокаСовокупнойИД.СчетДоверительногоУправления, ЦельРасчета, Истина);
				ЦельРасчетаИнвестДекларация 		= Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации;
				ВидУчета 							= НастройкиОценки.ВидУчетаДляОстатковПартий;
				ВариантРасчетаОценочнойСтоимости 	= НастройкиОценки.ВариантРасчетаОценочнойСтоимости;
				
				ВыполнятьРасчетПоУказаниюЦБ			= НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
				ВестиРасчетПоПартиям				= НастройкиОценки.ВестиРасчетПоПартиям ИЛИ ВыполнятьРасчетПоУказаниюЦБ;
				
				ИспользованаМетодикаРасчетаПоНовойСхеме =
					Не ВестиРасчетПоПартиям
					И Не ВыполнятьРасчетПоУказаниюЦБ
					И Справочники.ВариантыРасчетаОценочнойСтоимости.ИспользованаМетодикаРасчетаПоНовойСхеме(ЦельРасчета, ВариантРасчетаОценочнойСтоимости);	
					
				ПараметрыБазиса.Вставить("ВестиРасчетПоПартиям", 							ВестиРасчетПоПартиям);
				ПараметрыБазиса.Вставить("ВыполнятьРасчетПоУказаниюЦБ5419", 				ВыполнятьРасчетПоУказаниюЦБ);
				ПараметрыБазиса.Вставить("ИспользованаМетодикаРасчетаПоНовойСхеме", 		ИспользованаМетодикаРасчетаПоНовойСхеме);
				ПараметрыБазиса.Вставить("СписыватьПриПолномПогашенииВМоментПогашения", 	БухгалтерскийУчет.ОпределитьНастройкуУчета(ПараметрыФормирования.Период, СтрокаСовокупнойИД.Организация, СтрокаСовокупнойИД.СчетДоверительногоУправления, "СписыватьПриПолномПогашенииВМоментПогашения"));
				
				ПараметрыБазиса.Вставить("СчетДоверительногоУправления", 		СтрокаСовокупнойИД.СчетДоверительногоУправления);
				ПараметрыБазиса.Вставить("Организация", 						СтрокаСовокупнойИД.Организация);
				                                                     
				ПараметрыБазиса.Вставить("ВидУчета", 							ВидУчета);
				ПараметрыБазиса.Вставить("ЦельРасчета", 						ЦельРасчета);
				ПараметрыБазиса.Вставить("ЦельРасчетаИнвестДекларация", 		ЦельРасчетаИнвестДекларация);
				ПараметрыБазиса.Вставить("ВариантРасчетаОценочнойСтоимости", 	ВариантРасчетаОценочнойСтоимости);
				ПараметрыБазиса.Вставить("ВалютаУчета", 						СтрокаСовокупнойИД.ВалютаУчета);
				ПараметрыБазиса.Вставить("РасчетПартий", 						Неопределено);
				ПараметрыБазиса.Вставить("МенеджерВременныхТаблиц", 			Неопределено);
				ПараметрыБазиса.Вставить("ТаблицаСЧА", 							Неопределено);   
				
				ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
				
				ПараметрыБазиса.Вставить("ПараметрыПолученияТаблицыПлановыхОпераций", ОбработкаНаСервере.ПолучитьПараметрыПолученияТаблицыПлановыхОпераций(
					ПараметрыФормирования.Период, 
					СтрокаСовокупнойИД.Организация, 
					СтрокаСовокупнойИД.СчетДоверительногоУправления));
					
				ТаблицаБазисаПоСчетуДУ = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьДанныеБазиса(Базис.НаборДанных, ПараметрыБазиса, Базис.РежимПолученияБазы).ТаблицаБазиса;
				
				Если ТаблицаБазиса = Неопределено Тогда
					ТаблицаБазиса = ТаблицаБазисаПоСчетуДУ.Скопировать();
					ТаблицаБазиса.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("Строка"));
					ТаблицаБазиса.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка"));
					ТаблицаБазиса.Колонки.Добавить("Организация", Новый ОписаниеТипов("Строка"));
					ТаблицаБазиса.ЗаполнитьЗначения(СтрокаСовокупнойИД.СчетДоверительногоУправленияПредставление, "СчетДоверительногоУправления");
					ТаблицаБазиса.ЗаполнитьЗначения(СтрокаСовокупнойИД.КодСчета, "КодСчета");
					ТаблицаБазиса.ЗаполнитьЗначения(СтрокаСовокупнойИД.ОрганизацияПредставление, "Организация");
				Иначе
					Для каждого ТекСтрока Из ТаблицаБазисаПоСчетуДУ Цикл
						НоваяСтрока = ТаблицаБазиса.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
						НоваяСтрока.СчетДоверительногоУправления = СтрокаСовокупнойИД.СчетДоверительногоУправления;
						НоваяСтрока.КодСчета = СтрокаСовокупнойИД.КодСчета;
						НоваяСтрока.Организация = СтрокаСовокупнойИД.ОрганизацияПредставление;
					КонецЦикла; 
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли; 
	
	ТаблицаПолей = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьОписаниеПолейБазиса(Базис.НаборДанных);		
	
	ВнешниеНаборыДанных = Новый Структура("ТаблицаБазиса", ТаблицаБазиса);
	
	//!!!!!
	//Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ПараметрыБазиса.Организация);
	//Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ПараметрыБазиса.СчетДоверительногоУправления);
	//Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ПараметрыБазиса.Период);
	//Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("грПериод", ПараметрыБазиса.грПериод);
	
	Если СКД.ПоляИтога.Количество() = 0 Тогда
		Для каждого ОписаниеПоля Из ТаблицаПолей Цикл
			
			Если ОписаниеПоля.Ресурс Тогда
			
				ПолеИтога = СКД.ПоляИтога.Добавить();
				ПолеИтога.Выражение = "Сумма(" + ОписаниеПоля.ПутьКДанным + ")";
				ПолеИтога.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
			
			КонецЕсли;
			
		КонецЦикла;
		
		//ПолеИтога = СКД.ПоляИтога.Добавить();
		//ПолеИтога.Выражение = "Минимум(Рейтинги.Приоритет)";
		//ПолеИтога.ПутьКДанным = "Рейтинги.Приоритет";
		//
		//ПолеИтога = СКД.ПоляИтога.Добавить();
		//ПолеИтога.Выражение = "Минимум(Рейтинги.ПриоритетДоп)";
		//ПолеИтога.ПутьКДанным = "Рейтинги.ПриоритетДоп";
		
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	Если ПараметрыФормирования.Свойство("ВыводитьПараметрыДанных") Тогда
		Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных", ПараметрыФормирования.ВыводитьПараметрыДанных);
	КонецЕсли; 
	Если ПараметрыФормирования.Свойство("ВыводитьЗаголовок") Тогда
		Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьЗаголовок", ПараметрыФормирования.ВыводитьЗаголовок);
	КонецЕсли; 
	Если ПараметрыФормирования.Свойство("Заголовок") Тогда
		Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", ПараметрыФормирования.Заголовок);
	КонецЕсли; 
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ПараметрыФормирования.АдресДанныхРасшифровкиБазиса);
	
	Результат = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокИспользуемыхБазисов(Настройка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИнвестиционныеДекларацииПоказатели.Базис КАК Базис
		|ИЗ
		|	Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
		|ГДЕ
		|	ИнвестиционныеДекларацииПоказатели.Ссылка = &Настройка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИнвестиционныеДекларацииПоказатели.Базис.Наименование";
	
	Запрос.УстановитьПараметр("Настройка", Настройка);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

&НаСервере
Процедура ИспользуемыеБазисыПриИзмененииНаСервере(Базис, КомпактныйВариант = Ложь)
	
	СКДХранилище = Базис.ХранилищеСКД;
	Попытка
		СКД = СКДХранилище.Получить();
	Исключение
		ВызватьИсключение "Не удалось получить СКД базиса";
	КонецПопытки;
	НастройкиХранилище = Базис.ХранилищеНастроек;
	Попытка
		Настройки = НастройкиХранилище.Получить();
	Исключение
		ВызватьИсключение "Не удалось получить настройки базиса";
	КонецПопытки;
	
	//Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("АвтоПозицияРесурсов", АвтоПозицияРесурсовКомпоновкиДанных.НеИспользовать);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("МакетОформления", "МакетОформленияОтчетовЗеленый");
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("РасположениеРеквизитов", РасположениеРеквизитовКомпоновкиДанных.Отдельно);
	
	ТаблицаПолей = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьОписаниеПолейБазиса(Базис.НаборДанных);		
	КоличествоПолейПорядка = 0;
	Для каждого ОписаниеПоля Из ТаблицаПолей Цикл
		
		Если Не ЭтаФорма.СовокупнаяИнвестДекларация И 
			(ОписаниеПоля.Поле = "СчетДоверительногоУправления"
			Или ОписаниеПоля.Поле = "Организация"
			Или ОписаниеПоля.Поле = "КодСчета") Тогда
			Продолжить;
		КонецЕсли; 
		
		ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Использование = Истина;
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ОписаниеПоля.ПутьКДанным);
		
		Если КоличествоПолейПорядка < 4 Тогда
		
			ПолеПорядок = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ПолеПорядок.Поле = ПолеВыбор.Поле;
			
			КоличествоПолейПорядка = КоличествоПолейПорядка + 1;
		
		КонецЕсли; 
		
	КонецЦикла; 

	НоваяГруппировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	
	Если ЭтаФорма.КомпактныйВариантОтчетаПоБазису Или КомпактныйВариант Тогда
		
		ПолеГруппировкиВидАктива = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировкиВидАктива.Поле = Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
		
		НоваяВложеннаяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
		ПолеГруппировкиЭмитент = НоваяВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировкиЭмитент.Поле = Новый ПолеКомпоновкиДанных("Основные.Эмитент");
		
		ПолеГруппировкиАктив = НоваяВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировкиАктив.Поле = Новый ПолеКомпоновкиДанных("Основные.Актив");
		
		НоваяВложеннаяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		НоваяВложеннаяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	КонецЕсли; 
	
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	// оформление ПогашениеКупона
	ЭлементУОПогашениеКупона = Настройки.УсловноеОформление.Элементы.Добавить();

	ОтборУОПогашениеКупона = ЭлементУОПогашениеКупона.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУОПогашениеКупона.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Служебные.ПогашениеКупона");
	ОтборУОПогашениеКупона.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ОтборУОПогашениеКупона.ПравоеЗначение 	= Истина;
	
	ОтборУОПогашениеКупона = ЭлементУОПогашениеКупона.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУОПогашениеКупона.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
	ОтборУОПогашениеКупона.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ОтборУОПогашениеКупона.ПравоеЗначение 	= "Облигации";
	
	ЭлементУОПогашениеКупона.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоГрифельноСиний);
	
	ЭлементУОПогашениеКупона.ИспользоватьВИерархическойГруппировке 	= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУОПогашениеКупона.ИспользоватьВГруппировке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУОПогашениеКупона.ИспользоватьВЗаголовке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВЗаголовкеПолей 			= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВОтборе 					= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВПараметрах 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	
	//ЭлементУОПогашениеКупона.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ОтсутствуетСтоимостьПереоценки");
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресСКДБазиса) Тогда
		ПоместитьВоВременноеХранилище(СКД, ЭтаФорма.АдресСКДБазиса);
	Иначе
		ЭтаФорма.АдресСКДБазиса = ПоместитьВоВременноеХранилище(СКД, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли; 
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресНастроекБазиса) Тогда
		ПоместитьВоВременноеХранилище(Настройки, ЭтаФорма.АдресНастроекБазиса);
	Иначе
		ЭтаФорма.АдресНастроекБазиса = ПоместитьВоВременноеХранилище(Настройки, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "НЕАКТУАЛЬНОСТЬ");
	
КонецПроцедуры

&НаСервере
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаБазисВКонтекстеНаСервере()
	
	ПолеСуммаБазис = РаботаСБухгалтерскимиОтчетами.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		ТабличныйДокументБазис, КэшВыделеннойОбластиБазис);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДокументРезультатБазисПриАктивизацииОбластиПодключаемый()
	
	НеобходимоВычислятьНаСервере = Ложь;
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		ПолеСуммаБазис, ТабличныйДокументБазис, КэшВыделеннойОбластиБазис, НеобходимоВычислятьНаСервере);
	
	Если НеобходимоВычислятьНаСервере Тогда
		ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаБазисВКонтекстеНаСервере();
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ДокументРезультатБазисПриАктивизацииОбластиПодключаемый");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьБазис(ИнвестиционнаяДекларация)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ИнвестиционныеДекларацииПоказатели.Базис КАК Базис,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвестиционныеДекларацииПоказатели.НомерСтроки) КАК НомерСтроки
		|ИЗ
		|	Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
		|ГДЕ
		|	ИнвестиционныеДекларацииПоказатели.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ИнвестиционныеДекларацииПоказатели.Базис
		|
		|УПОРЯДОЧИТЬ ПО
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИнвестиционныеДекларацииПоказатели.НомерСтроки) УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", ИнвестиционнаяДекларация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Базис;
	КонецЕсли;

КонецФункции

#КонецОбласти 
	
#КонецОбласти 

#Область Претрейд

&НаКлиенте
Процедура ОбновитьИнтерфейсПретрейда(ПретрейдИзменен)

	КонтрольЗаПрошлыйПериод = (НачалоДня(ТекущаяДата()) > Объект.Период);
	ПретрейдЗаПрошлыйПериод = КонтрольЗаПрошлыйПериод И Объект.Претрейд.Количество() > 0;
	
	Элементы.ГруппаПретрейд.ЦветТекстаЗаголовка = ?(ПретрейдЗаПрошлыйПериод, WebЦвета.Красный, Новый Цвет);
	Элементы.ПрошлыйПериод.Видимость = ПретрейдЗаПрошлыйПериод;
	Элементы.ПретрейдИзменен.Видимость = ПретрейдИзменен;
	
	Элементы.ПлановыеДанные_Включить.Видимость = Не КонтрольЗаПрошлыйПериод;

	Объект.УчитыватьПлановыеОперации = Не (КонтрольЗаПрошлыйПериод Или ЭтаФорма.СовокупнаяИнвестДекларация);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПретрейдПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
	
		Отказ = Не Элемент.ТекущиеДанные.ЭтоПретрейд;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПретрейдПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
	
		ОткрытьФормуРедактированияСтрокиПретрейда(Элемент, Истина);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПретрейдВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьФормуРедактированияСтрокиПретрейда(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияСтрокиПретрейда(Элемент, НоваяСтрока = Ложь)

	ПараметрыФормы = Новый Структура("ЭтоПретрейд, ВидАктива, БрокерРасчетныйСчет, Депозит, ЮрФизЛицо, Валюта, ЦеннаяБумага, ВидОперации, Рынок, Количество, 
		|Цена, Купон, Сумма, СуммаДС, Представление, Классификация, ДатаПогашенияДепозита, СчетДоверительногоУправления,
		|ДатаВторойЧастиРЕПО, СтавкаРЕПО, МестоХранения, СделкаСЦентральнымКонтрагентом, Дюрация"); 
		
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Элемент.ТекущиеДанные);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Период", Объект.Период);
	ПараметрыФормы.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
	
	Если НоваяСтрока Тогда
	
		Элемент.ТекущиеДанные.ЭтоПретрейд = Истина;
		ПараметрыФормы.ЭтоПретрейд = Истина;
		ПараметрыФормы.ВидОперации = 1;
		ПараметрыФормы.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
		ПараметрыФормы.СделкаСЦентральнымКонтрагентом = Истина;
	
	КонецЕсли;
	
	Результат = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.РедактированиеСтрокиПретрейда", ПараметрыФормы);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(Элемент.ТекущиеДанные, Результат);
		ОбновитьИнтерфейсПретрейда(Истина)
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ПретрейдПриИзменении(Элемент)
	ОбновитьИнтерфейсПретрейда(Истина)
КонецПроцедуры

&НаКлиенте
Процедура ПретрейдСохранить(Команда)
	
	АдресПретрейда = ПоместитьПретрейдВоВременноеХранилищеНаСервере();
	
	РаботаСФормамиКлиент.СохранитьНастройкиИзВременногоХранилищаВХранилищеВариантовИНастроекОтчетов(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихНастроек, АдресПретрейда);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьПретрейдВоВременноеХранилищеНаСервере()
	Возврат ПоместитьВоВременноеХранилище(Объект.Претрейд.Выгрузить(), ЭтаФорма.УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура ПретрейдЗагрузить(Команда)
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПоместитьНастройкиИзХранилищаВариантовИНастроекОтчетовВоВременноеХранилище(ЭтаФорма.ИмяФормы, ЭтаФорма.КлючТекущихНастроек, ЭтаФорма.УникальныйИдентификатор);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		
		ПретрейдЗагрузитьНаСервере(ОписаниеНастроек.АдресНастроекВоВременномХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПретрейдЗагрузитьНаСервере(АдресПретрейда)

	Претрейд = ПолучитьИзВременногоХранилища(АдресПретрейда);
	
	УдалитьИзВременногоХранилища(АдресПретрейда);
	
	Если ТипЗнч(Претрейд) <> Тип("ТаблицаЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения настроек.");
		Возврат;
	КонецЕсли;
	
	Объект.Претрейд.Загрузить(Претрейд);
	ВалютаУчета = Объект.Организация.ВалютаУчета;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Для каждого Строка Из Объект.Претрейд Цикл
	
		Если ЗначениеЗаполнено(Строка.ЦеннаяБумага) Тогда
			
			ВалютаНоминала = Строка.ЦеннаяБумага.ВалютаНоминала;
			НоминалВВалюте = (ВалютаНоминала <> ВалютаУчета);
			ТочностьОкругления = ?(НоминалВВалюте, 4, 2);
			
			Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Строка.ЦеннаяБумага, Объект.Период, Объект.СчетДоверительногоУправления,, ТочностьОкругления);
			
			Если НоминалВВалюте Тогда
				Купон = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Купон, ВалютаНоминала, Объект.Организация, Объект.Период);
			КонецЕсли; 
			
			Строка.Купон 	= Купон;
			Строка.Сумма 	= Строка.Количество * (Строка.Цена + Строка.Купон);
			
		КонецЕсли; 
		
		Строка.Представление = ОбъектНаСервере.ПолучитьПредставлениеСтрокиПретрейда(Строка);
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПретрейдЗагрузитьИзExcel(Команда)
	
	ПараметрыФормы = Новый Структура("СчетДоверительногоУправления, Период");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	МассивСтрок = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.ФормаЗагрузкиПретрейда", ПараметрыФормы);
	Если ТипЗнч(МассивСтрок) = Тип("Массив") Тогда
		ЗагрузитьВводыВыводыВПретрейд(МассивСтрок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВводыВыводыВПретрейд(МассивСтрок)

	ТаблицаПретрейда = Новый ТаблицаЗначений;
	ТаблицаПретрейда.Колонки.Добавить("Код", Метаданные.РегистрыСведений.КодыВТорговыхСистемах.Ресурсы.Код.Тип);
	ТаблицаПретрейда.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаПретрейда.Колонки.Добавить("Цена", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	ТаблицаПретрейда.Колонки.Добавить("Купон", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ТаблицаПретрейда.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.БрокерскиеКомпании"));
	МассивТипов.Добавить(Тип("СправочникСсылка.БанковскиеСчета"));
	ТаблицаПретрейда.Колонки.Добавить("БрокерРасчетныйСчет", Новый ОписаниеТипов(МассивТипов));
	
	Для каждого ЭлементМассива Из МассивСтрок Цикл
	    ЗаполнитьЗначенияСвойств(ТаблицаПретрейда.Добавить(), ЭлементМассива);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПретрейда", ТаблицаПретрейда);
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПретрейда.Код КАК Код,
		|	ТаблицаПретрейда.Количество КАК Количество,
		|	ТаблицаПретрейда.Цена КАК Цена,
		|	ТаблицаПретрейда.Купон КАК Купон,
		|	ТаблицаПретрейда.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТаблицаПретрейда.БрокерРасчетныйСчет КАК БрокерРасчетныйСчет
		|ПОМЕСТИТЬ _ТаблицаПретрейда
		|ИЗ
		|	&ТаблицаПретрейда КАК ТаблицаПретрейда
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПретрейда.Код КАК Код,
		|	ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследних.Объект, ЕСТЬNULL(Акции.Ссылка, ЕСТЬNULL(Облигации.Ссылка, ЕСТЬNULL(ИпотечныеСертификатыУчастия.Ссылка, НЕОПРЕДЕЛЕНО)))) КАК ЦеннаяБумага,
		|	_ТаблицаПретрейда.Количество КАК Количество,
		|	_ТаблицаПретрейда.Цена КАК Цена,
		|	_ТаблицаПретрейда.Купон КАК Купон,
		|	ИСТИНА КАК ЭтоПретрейд,
		|	ЛОЖЬ КАК НеУчитывать,
		|	""Ценные бумаги"" КАК ВидАктива,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
		|	ВЫБОР
		|		КОГДА _ТаблицаПретрейда.БрокерРасчетныйСчет = НЕОПРЕДЕЛЕНО
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ВидОперации,
		|	ЗНАЧЕНИЕ(Справочник.ДепозитныеВклады.ПустаяСсылка) КАК Депозит,
		|	"""" КАК Представление,
		|	ВЫБОР
		|		КОГДА _ТаблицаПретрейда.БрокерРасчетныйСчет = НЕОПРЕДЕЛЕНО
		|			ТОГДА 0
		|		ИНАЧЕ -_ТаблицаПретрейда.Количество * (_ТаблицаПретрейда.Цена + _ТаблицаПретрейда.Купон)
		|	КОНЕЦ КАК СуммаДС,
		|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК ЮрФизЛицо,
		|	_ТаблицаПретрейда.Количество * (_ТаблицаПретрейда.Цена + _ТаблицаПретрейда.Купон) КАК Сумма,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, 0) КАК Номинал,
		|	Облигации.ВалютаНоминала КАК ВалютаНоминала,
		|	_ТаблицаПретрейда.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТаблицаПретрейда.БрокерРасчетныйСчет КАК БрокерРасчетныйСчет
		|ПОМЕСТИТЬ _ПретрейдВрем
		|ИЗ
		|	_ТаблицаПретрейда КАК _ТаблицаПретрейда
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ТаблицаПретрейда.Код = КодыВТорговыхСистемахСрезПоследних.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ТаблицаПретрейда.Код = Акции.ГосударственныйРегистрационныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ТаблицаПретрейда.Код = Облигации.ГосударственныйРегистрационныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _ТаблицаПретрейда.Код = ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО (НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага = ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследних.Объект, Облигации.Ссылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ПретрейдВрем.Код КАК Код,
		|	_ПретрейдВрем.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПретрейдВрем.Количество КАК Количество,
		|	_ПретрейдВрем.Цена КАК Цена,
		|	_ПретрейдВрем.Купон КАК Купон,
		|	_ПретрейдВрем.ЭтоПретрейд КАК ЭтоПретрейд,
		|	_ПретрейдВрем.НеУчитывать КАК НеУчитывать,
		|	_ПретрейдВрем.ВидАктива КАК ВидАктива,
		|	_ПретрейдВрем.Валюта КАК Валюта,
		|	_ПретрейдВрем.ВидОперации КАК ВидОперации,
		|	_ПретрейдВрем.Депозит КАК Депозит,
		|	_ПретрейдВрем.Представление КАК Представление,
		|	_ПретрейдВрем.СуммаДС КАК СуммаДС,
		|	_ПретрейдВрем.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ПретрейдВрем.Сумма КАК Сумма,
		|	_ПретрейдВрем.Номинал КАК Номинал,
		|	_ПретрейдВрем.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	_ПретрейдВрем.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПретрейдВрем.БрокерРасчетныйСчет КАК БрокерРасчетныйСчет
		|ИЗ
		|	_ПретрейдВрем КАК _ПретрейдВрем";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	Пока Выборка.Следующий() Цикл
			
		НоваяСтрока = Объект.Претрейд.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.Рынок = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(НоваяСтрока.ЦеннаяБумага);
		
		Если НоваяСтрока.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если НоваяСтрока.Купон = 0 Или НоваяСтрока.Цена = 0 Тогда
			
				НоминалВВалюте = (Выборка.ВалютаНоминала <> ВалютаУчета);
				ТочностьОкругления = ?(НоминалВВалюте, 4, 2);
				
				Если НоваяСтрока.Купон = 0 Тогда
					
					// рассчитаем купон сами
					Купон = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(НоваяСтрока.ЦеннаяБумага, Объект.Период, Объект.СчетДоверительногоУправления,, ТочностьОкругления);
					Если НоминалВВалюте Тогда
						Купон = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Купон, Выборка.ВалютаНоминала, Объект.Организация, Объект.Период);
					КонецЕсли;
					НоваяСтрока.Купон = Купон;
				
				КонецЕсли; 
				
				Если НоваяСтрока.Цена = 0 Тогда
					
					// заполним текущим номиналом
					Номинал = Выборка.Номинал;
					Если НоминалВВалюте Тогда
						Номинал = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Номинал, Выборка.ВалютаНоминала, Объект.Организация, Объект.Период);
					КонецЕсли;
					НоваяСтрока.Цена = Номинал;
				
				КонецЕсли; 				
				
				НоваяСтрока.Сумма 	= НоваяСтрока.Количество * (НоваяСтрока.Цена + НоваяСтрока.Купон);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		НоваяСтрока.Представление = ОбъектНаСервере.ПолучитьПредставлениеСтрокиПретрейда(НоваяСтрока);
		
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура ПретрейдЗаполнитьПоРаспоряжениям(Команда)
	
	ПретрейдЗаполнитьПоРаспоряжениямНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПретрейдЗаполнитьПоРаспоряжениямНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("СоставСовокупнойИнвестДекларации", ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации));
	ПараметрыЗаполнения.Вставить("Период", Объект.Период);
	ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
	
	ТаблицаПретрейда = ОбъектНаСервере.ПолучитьТаблицуПретрейдаПоРаспоряжениям(ПараметрыЗаполнения);
	
	Для каждого СтрокаПретрейд Из ТаблицаПретрейда Цикл
		ЗаполнитьЗначенияСвойств(Объект.Претрейд.Добавить(), СтрокаПретрейд);
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область ГрупповойКонтроль

#Область ГрупповойКонтроль_Команды_и_Элементы
	
&НаКлиенте
Процедура ЗаполнитьГрупповойКонтроль(Команда)
	
	Если ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 0
			Или (ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 1 И ЗначениеЗаполнено(ЭтаФорма.ГрупповойКонтроль_ИнвестСтратегия))
			Или (ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 2 И ЗначениеЗаполнено(ЭтаФорма.ГрупповойКонтроль_ВидДоговораДоверительногоУправления))
			Или ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 3 Тогда
		ЗаполнитьСоставГрупповогоКонтроля();
	КонецЕсли;
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПериодГрупповойКонтрольПриИзменении(Элемент)
	
	ЗаполнитьГрупповойКонтроль(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвестСтратегияПриИзменении(Элемент)
	
	ЗаполнитьГрупповойКонтроль(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораДоверительногоУправленияПриИзменении(Элемент)
	
	ЗаполнитьГрупповойКонтроль(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставГрупповогоКонтроляСчетДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьРеквизитыСтрокиГрупповогоКонтроля(Элементы.СоставГрупповогоКонтроля.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставГрупповогоКонтроляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СоставГрупповогоКонтроляРегистрацияСтоимостиАктивов" Тогда
		Значение = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока).РегистрацияСтоимостиАктивов;
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			ОткрытьЗначение(Значение);
		КонецЕсли; 
	ИначеЕсли Поле.Имя = "СоставГрупповогоКонтроляПредставлениеИД" Тогда
		
		ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
		
		Если ТипЗнч(ТекСтрока.ИнвестиционнаяДекларация) = Тип("СправочникСсылка.ИнвестиционныеДекларации") И ЗначениеЗаполнено(ТекСтрока.ИнвестиционнаяДекларация) Тогда
			
			ОткрытьЗначение(ТекСтрока.ИнвестиционнаяДекларация);
			
		Иначе
			
			Если ТекСтрока.ПредставлениеИД = "Совокупная" Тогда
				ПараметрыФормы = Новый Структура("АдресСоставаСовокупнойИнвестДекларации", АдресСоставаСовокупнойИнвестДекларацииПоСтроке(ВыбраннаяСтрока));
				Результат = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.СоставСовокупнойИнвестиционнойДекларации", ПараметрыФормы, ЭтаФорма);
				ЗагрузитьСовокупнойИнвестДекларацииПоСтроке(ВыбраннаяСтрока, ПараметрыФормы.АдресСоставаСовокупнойИнвестДекларации);
			КонецЕсли;
			
		КонецЕсли; 
		
	ИначеЕсли Поле.Имя = "СоставГрупповогоКонтроляПредставлениеСубъекта" Тогда
		
		ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ТекСтрока.ПредставлениеИД = "Совокупная" Тогда
			ОткрытьЗначение(ТекСтрока.Клиент);
		Иначе
			ОткрытьЗначение(ТекСтрока.СчетДоверительногоУправления);
		КонецЕсли; 
		
	ИначеЕсли Поле.Имя = "СоставГрупповогоКонтроляГиперссылка" Тогда
		
		ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ТекСтрока.Гиперссылка) Тогда
			
			ЗагрузитьРезультатыПроверкиНаСервере(ТекСтрока.ИдентификаторРезультата);
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставГрупповогоКонтроляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда
		СтрокаСоставаГрупповогоКонтроля = Элементы.СоставГрупповогоКонтроля.ТекущиеДанные;
		СтрокаСоставаГрупповогоКонтроля.АдресСтруктурыОтчетов = "";
		СтрокаСоставаГрупповогоКонтроля.ИдентификаторРезультата = Новый УникальныйИдентификатор;
		СтрокаСоставаГрупповогоКонтроля.Статус = "";
		СтрокаСоставаГрупповогоКонтроля.Выполнено = -1;
	ИначеЕсли НоваяСтрока Тогда
		СтрокаСоставаГрупповогоКонтроля = Элементы.СоставГрупповогоКонтроля.ТекущиеДанные;
		СтрокаСоставаГрупповогоКонтроля.Период = Объект.Период;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	Элементы.ИнвестСтратегия.Видимость = (ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 1);
	Элементы.ВидДоговораДоверительногоУправления.Видимость = (ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 2);
	
	ЗаполнитьГрупповойКонтроль(Неопределено);
	
КонецПроцедуры

&НаСервере
Функция АдресСоставаСовокупнойИнвестДекларацииПоСтроке(ВыбраннаяСтрока)
	
	ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Возврат ПоместитьВоВременноеХранилище(ТекСтрока.СоставСовокупнойИнвестиционнойДекларации.Выгрузить(), ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьСовокупнойИнвестДекларацииПоСтроке(ВыбраннаяСтрока, Адрес);
	
	ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ТекСтрока.СоставСовокупнойИнвестиционнойДекларации.Загрузить(ПолучитьИзВременногоХранилища(Адрес));
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Процедура РежимФильтрацииРезультатовГрупповогоКонтроляПриИзменении(Элемент)
	УстановитьРежимФильтрацииРезультатовГруппового(Элементы.СоставГрупповогоКонтроля);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыСтрокиГрупповогоКонтроля(СтрокаГрупповогоКонтроля, ОбновлятьДокументы = Истина)

	Если ОбновлятьДокументы Тогда
		
		Период = ?(ЗначениеЗаполнено(СтрокаГрупповогоКонтроля.Период), СтрокаГрупповогоКонтроля.Период, Объект.Период);
		Если Не ЗначениеЗаполнено(СтрокаГрупповогоКонтроля.СчетДоверительногоУправления) Тогда
			СтрокаГрупповогоКонтроля.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
		КонецЕсли; 
		РеквизитыКонтроля = ПолучитьРеквизитыКонтроля(Период, Объект.Организация, СтрокаГрупповогоКонтроля.СчетДоверительногоУправления);
		ЗаполнитьЗначенияСвойств(СтрокаГрупповогоКонтроля, РеквизитыКонтроля);		
	
	КонецЕсли; 

	СтрокаГрупповогоКонтроля.РезультатПроверки = Неопределено;
	СтрокаГрупповогоКонтроля.РезультатПроверкиВн = Неопределено;
	СтрокаГрупповогоКонтроля.РезультатПроверкиИтог = Неопределено;
	СтрокаГрупповогоКонтроля.Гиперссылка = "";
	СтрокаГрупповогоКонтроля.ОшибкиОценки = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставГрупповогоКонтроля()
	
	Объект.СоставГрупповогоКонтроля.Очистить();
	
	// заполняем список
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период", Объект.Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДоступныеОрганизации", ПолучитьДоступныеОрганизации(Объект.Организация));
	Запрос.УстановитьПараметр("КлиентТрадиция", ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция"));
	Запрос.УстановитьПараметр("СчетДУАтлант", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352"));
	
	Если ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 1 Тогда
		
		// по стратегии
		Запрос.УстановитьПараметр("Стратегия", ЭтаФорма.ГрупповойКонтроль_ИнвестСтратегия);
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИСТИНА КАК Включен,
			|	&Период КАК Дата,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Стратегия В (&Стратегия)) КАК СтратегииИндивидуальногоИнвестирования
			|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.КодСчета <> ""О""
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)";
		
	ИначеЕсли ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 3 Тогда
		
		// по распоряжениям на депозиты
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ИСТИНА КАК Включен,
			|	&Период КАК Дата,
			|	Распоряжение.Организация КАК Организация,
			|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	Распоряжение.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ИЗ
			|	Документ.Распоряжение КАК Распоряжение
			|ГДЕ
			|	Распоряжение.Организация = &Организация
			|	И Распоряжение.ДатаРазмещения = &Период
			|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
			|	И НЕ Распоряжение.ПометкаУдаления";
		
	Иначе
		
		// без отбора или с отбором по виду договора
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИСТИНА КАК Включен,
			|	&Период КАК Дата,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.КодСчета <> ""О""
			|	И &ВидДоговораДоверительногоУправления
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)";
		
		Если ЭтаФорма.ГрупповойКонтроль_РежимОтбора = 2 Тогда 
			
			// по виду договора
			УсловиеВидДоговора = "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ВидДоговораДоверительногоУправления)";
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидДоговораДоверительногоУправления", УсловиеВидДоговора);
			Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", ЭтаФорма.ГрупповойКонтроль_ВидДоговораДоверительногоУправления);
			
		Иначе
			
			Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", Истина);
		
		КонецЕсли; 
		
	КонецЕсли;
	
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
		
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ОбработкаНаСервере.ПроверитьНастройкиПоСчетамДУ(ТаблицаСчетов);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСчетов, "_ТаблицаСчетов", Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст = РегистрыСведений.ИнвестиционныеДекларации.ПолучитьТекстЗапросаДляПолученияАктуальныхИнвестиционныхДеклараций();
	
	Запрос.Выполнить();
	
	ЗаполнитьСоставыГрупповыхКонтролей(Запрос);
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьПредставлениеСубъекта(Выборка)

	ПредставленияВидовДоговоров = Новый Соответствие;
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет , "ИИС");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда , "ПИФ");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР, "ПФР");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций, "СРО");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица, "ФЛ");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ, "ФОГФ");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица, "ЮЛ");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "ПН");
	ПредставленияВидовДоговоров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами, "ПР");
	
	ПредставлениеВидаДоговора = ПредставленияВидовДоговоров.Получить(Выборка.ВидДоговораДоверительногоУправления);
	Если ПредставлениеВидаДоговора = Неопределено Тогда
		ПредставлениеВидаДоговора = Строка(Выборка.ВидДоговораДоверительногоУправления);
	КонецЕсли; 
	
	Возврат Строка(Выборка.Клиент) + " - " + ПредставлениеВидаДоговора;

КонецФункции

&НаСервере
Функция ПолучитьРезультатПроверкиДерева(РезультатыДерево)

	ПроверкаПройдена = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
	
	РезультатПроверки = Новый Структура("РезультатПроверки, РезультатПроверкиВн", ПроверкаПройдена, ПроверкаПройдена);
	
	Для каждого СтрокаДерева Из РезультатыДерево.Строки Цикл
		Если СтрокаДерева.ИнвестиционнаяДекларация.Консолидирующая И СтрокаДерева.РезультатПроверки = ПроверкаПройдена Тогда
			РезультатПроверки = ПолучитьРезультатПроверкиДерева(СтрокаДерева);
		Иначе
			Если СтрокаДерева.РезультатПроверки <> ПроверкаПройдена Тогда
				Если СтрокаДерева.ВнутреннийНабор Тогда
					РезультатПроверки.РезультатПроверкиВн = СтрокаДерева.РезультатПроверки;
				Иначе
					РезультатПроверки.РезультатПроверки = СтрокаДерева.РезультатПроверки;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат РезультатПроверки;

КонецФункции

&НаКлиенте
Процедура РежимГрупповогоКонтроляПриИзменении(Элемент)
	
	Если ЭтаФорма.РежимГрупповогоКонтроля = "ПоСчетам" Тогда
		ТекущаяСтраница = Элементы.СтраницаГрупповойКонтроль;
		ТекстСообщения = "по счетам";
	ИначеЕсли ЭтаФорма.РежимГрупповогоКонтроля = "ЗаПериод" Тогда
		ТекущаяСтраница = Элементы.СтраницаКонтрольЗаПериод;
		ТекстСообщения = "за период";
	КонецЕсли;
	
	Если Объект.СоставГрупповогоКонтроля.Количество() = 0 Или Не Элементы.ФормаВыполнитьКонтроль.Видимость Тогда
		ЭтаФорма.ПараметрыПроверки.РежимГрупповогоКонтроля = ЭтаФорма.РежимГрупповогоКонтроля;
		ПереключитьСтраницу = Истина;
	ИначеЕсли ЭтаФорма.РежимГрупповогоКонтроля <> ЭтаФорма.ПараметрыПроверки.РежимГрупповогоКонтроля
		И Вопрос("Состав группового контроля " + ТекстСообщения + " будет очищен. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Объект.СоставГрупповогоКонтроля.Очистить();
		ЭтаФорма.ПараметрыПроверки.РежимГрупповогоКонтроля = ЭтаФорма.РежимГрупповогоКонтроля;
		ПереключитьСтраницу = Истина;
	ИначеЕсли ЭтаФорма.РежимГрупповогоКонтроля = ЭтаФорма.ПараметрыПроверки.РежимГрупповогоКонтроля Тогда
		ПереключитьСтраницу = Истина;
	Иначе
		ЭтаФорма.РежимГрупповогоКонтроля = ЭтаФорма.ПараметрыПроверки.РежимГрупповогоКонтроля;
		ПереключитьСтраницу = Ложь;
	КонецЕсли; 
	
	Если ПереключитьСтраницу Тогда
		Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = ТекущаяСтраница;
	КонецЕсли; 
	
КонецПроцедуры

#Область Контроль_за_период

&НаКлиенте
Процедура ЗаполнитьКонтрольЗаПериод(Команда)
	ЗаполнитьКонтрольЗаПериодНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КонтрольЗаПериод_ПериодПриИзменении(Элемент)
	ЗаполнитьКонтрольЗаПериодНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправлениКонтрольЗаПериодПриИзменении(Элемент)
	ЗаполнитьКонтрольЗаПериодНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтрольЗаПериодНаСервере()

	Если ЭтаФорма.КонтрольЗаПериодРежимЗаполнения = "ПоСписку" Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДат = Новый ТаблицаЗначений;
	ТаблицаДат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		
	Если ЭтаФорма.КонтрольЗаПериодРежимЗаполнения = "ПоНастройкам" Тогда
		
		МассивДат = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(
			Объект.СчетДоверительногоУправления, 
			ЭтаФорма.КонтрольЗаПериод_Период.ДатаНачала, 
			ЭтаФорма.КонтрольЗаПериод_Период.ДатаОкончания);
			
		Если МассивДат <> Неопределено И  МассивДат.Количество() > 0 Тогда
			
			Для каждого ДатаРасчетаСЧА Из МассивДат Цикл
				НоваяСтрока = ТаблицаДат.Добавить();
				НоваяСтрока.Дата = ДатаРасчетаСЧА;
			КонецЦикла; 
			
		КонецЕсли;
			
	ИначеЕсли ЭтаФорма.КонтрольЗаПериодРежимЗаполнения = "ЗаКаждыйДень" Тогда
		
		ТекДата = НачалоДня(ЭтаФорма.КонтрольЗаПериод_Период.ДатаНачала);
		
		Пока ТекДата <= ЭтаФорма.КонтрольЗаПериод_Период.ДатаОкончания Цикл
			НоваяСтрока = ТаблицаДат.Добавить();
			НоваяСтрока.Дата = ТекДата;
			ТекДата = ТекДата + 24*3600;
		КонецЦикла;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаДат", ТаблицаДат);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДоступныеОрганизации", ПолучитьДоступныеОрганизации(Объект.Организация));
	Запрос.УстановитьПараметр("КлиентТрадиция", ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция"));
	Запрос.УстановитьПараметр("СчетДУАтлант", ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352"));
		
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДат.Дата КАК Дата,
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаДат
		|ИЗ
		|	&ТаблицаДат КАК ТаблицаДат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Включен,
		|	ВложенныйЗапрос.Дата КАК Дата,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	&Организация КАК Организация,
		|	ЕСТЬNULL(СтратегииИндивидуальногоИнвестирования.Стратегия, НЕОПРЕДЕЛЕНО) КАК Стратегия
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ТаблицаДат.Дата КАК Дата,
		|		_ТаблицаДат.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МАКСИМУМ(СтратегииИндивидуальногоИнвестирования.Период) КАК ПериодСтратегии
		|	ИЗ
		|		_ТаблицаДат КАК _ТаблицаДат
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|			ПО _ТаблицаДат.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления
		|				И _ТаблицаДат.Дата >= СтратегииИндивидуальногоИнвестирования.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ТаблицаДат.Дата,
		|		_ТаблицаДат.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.ПериодСтратегии = СтратегииИндивидуальногоИнвестирования.Период";
	
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ОбработкаНаСервере.ПроверитьНастройкиПоСчетамДУ(ТаблицаСчетов);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСчетов, "_ТаблицаСчетов", Запрос.МенеджерВременныхТаблиц);
	
	Если ЗначениеЗаполнено(ЭтаФорма.ГрупповойКонтроль_ИнвестиционнаяДекларация) Тогда
		Запрос.УстановитьПараметр("ИнвестиционнаяДекларация", ЭтаФорма.ГрупповойКонтроль_ИнвестиционнаяДекларация);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаСчетов.Дата КАК Дата,
			|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
			|	СчетаДоверительногоУправленияСправочник.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
			|	_ТаблицаСчетов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	1 КАК ПорядокКонтроля,
			|	ИнвестиционныеДекларации.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
			|	ИнвестиционныеДекларации.Ссылка КАК ИнвестиционнаяДекларация,
			|	ИнвестиционныеДекларации.СовокупныйКонтроль КАК СовокупныйКонтроль,
			|	ЗНАЧЕНИЕ(Документ.НазначениеИнвестиционнойДекларации.ПустаяСсылка) КАК Назначение
			|ПОМЕСТИТЬ _СоставСовокупнойИД
			|ИЗ
			|	_ТаблицаСчетов КАК _ТаблицаСчетов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправленияСправочник
			|		ПО _ТаблицаСчетов.СчетДоверительногоУправления = СчетаДоверительногоУправленияСправочник.Ссылка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
			|		ПО (ИнвестиционныеДекларации.Ссылка = &ИнвестиционнаяДекларация)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_ТаблицаСчетов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			_ТаблицаСчетов.Дата КАК Дата,
			|			МАКСИМУМ(КлиентыДоверительногоУправления.Период) КАК ПериодКлиента
			|		ИЗ
			|			_ТаблицаСчетов КАК _ТаблицаСчетов
			|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|				ПО _ТаблицаСчетов.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|					И _ТаблицаСчетов.Дата >= КлиентыДоверительногоУправления.Период
			|					И (КлиентыДоверительногоУправления.Организация = &Организация)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_ТаблицаСчетов.СчетДоверительногоУправления,
			|			_ТаблицаСчетов.Дата) КАК ПериодыКлиентовДУ
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|			ПО ПериодыКлиентовДУ.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|				И ПериодыКлиентовДУ.ПериодКлиента = КлиентыДоверительногоУправления.Период
			|				И (КлиентыДоверительногоУправления.Организация = &Организация)
			|		ПО _ТаблицаСчетов.СчетДоверительногоУправления = ПериодыКлиентовДУ.СчетДоверительногоУправления
			|			И _ТаблицаСчетов.Дата = ПериодыКлиентовДУ.Дата";
	Иначе
		Запрос.Текст = РегистрыСведений.ИнвестиционныеДекларации.ПолучитьТекстЗапросаДляПолученияАктуальныхИнвестиционныхДеклараций();
	КонецЕсли; 
	Запрос.Выполнить();
	#КонецОбласти 
	
	Объект.СоставГрупповогоКонтроля.Очистить();
	
	ЗаполнитьСоставыГрупповыхКонтролей(Запрос);

КонецПроцедуры

&НаКлиенте
Процедура КонтрольЗаПериодРежимЗаполненияПриИзменении(Элемент)
	ЗаполнитьКонтрольЗаПериодНаСервере();
КонецПроцедуры
 
&НаКлиенте
Процедура СоставКонтроляЗаПериодПериодПриИзменении(Элемент)
	
	ОбновитьРеквизитыСтрокиГрупповогоКонтроля(Элементы.СоставКонтроляЗаПериод.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКонтроляЗаПериодВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СоставКонтроляЗаПериодРегистрацияСтоимостиАктивов" Тогда
		Значение = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока).РегистрацияСтоимостиАктивов;
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			ОткрытьЗначение(Значение);
		КонецЕсли; 
	ИначеЕсли Поле.Имя = "СоставКонтроляЗаПериодГиперссылка" Тогда
		
		ТекСтрока = Объект.СоставГрупповогоКонтроля.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ТекСтрока.Гиперссылка) Тогда
		
			ЗагрузитьРезультатыПроверкиНаСервере(ТекСтрока.ИдентификаторРезультата);
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКонтроляЗаПериодПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда
		
		СтрокаСоставаКонтроляЗаПериод = Элементы.СоставКонтроляЗаПериод.ТекущиеДанные;
		СтрокаСоставаКонтроляЗаПериод.АдресСтруктурыОтчетов = "";
		СтрокаСоставаКонтроляЗаПериод.ИдентификаторРезультата = Новый УникальныйИдентификатор;
		СтрокаСоставаКонтроляЗаПериод.Статус = "";
		СтрокаСоставаКонтроляЗаПериод.Выполнено = -1;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РежимФильтрацииРезультатовКонтроляЗаПериодПриИзменении(Элемент)
	
	УстановитьРежимФильтрацииРезультатовГруппового(Элементы.СоставКонтроляЗаПериод)
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповойКонтроль_ИнвестиционнаяДекларацияПриИзменении(Элемент)
	
	ЗаполнитьКонтрольЗаПериодНаСервере();
 
КонецПроцедуры

#КонецОбласти 

&НаКлиенте
Процедура УстановитьРежимФильтрацииРезультатовГруппового(Элемент)

	Нарушение = ПредопределенноеЗначение("Перечисление.РезультатыКонтроляИнвестиционнойДекларации.Нарушение");
	ОтборСтрок = Новый Структура;
	Если ЭтаФорма.ГрупповойКонтроль_РежимФильтрацииРезультатовГрупповогоКонтроля = 1 Тогда
		ОтборСтрок.Вставить("РезультатПроверкиИтог", Нарушение);
	ИначеЕсли ЭтаФорма.ГрупповойКонтроль_РежимФильтрацииРезультатовГрупповогоКонтроля = 2 Тогда
		ОтборСтрок.Вставить("РезультатПроверки", Нарушение);
	ИначеЕсли ЭтаФорма.ГрупповойКонтроль_РежимФильтрацииРезультатовГрупповогоКонтроля = 3 Тогда
		ОтборСтрок.Вставить("РезультатПроверкиВн", Нарушение);
	КонецЕсли; 
	Элемент.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставыГрупповыхКонтролей(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _СоставСовокупнойИД.СчетДоверительногоУправления = &СчетДУАтлант
		|			ТОГДА &Период >= ДАТАВРЕМЯ(2021, 1, 1)
		|		ИНАЧЕ _ТаблицаСчетов.Включен
		|	КОНЕЦ КАК Включен,
		|	_СоставСовокупнойИД.Дата КАК Период,
		|	_СоставСовокупнойИД.Клиент КАК Клиент,
		|	_СоставСовокупнойИД.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
		|	СчетаДоверительногоУправления.Организация.Представление КАК ОрганизацияПредставление,
		|	_СоставСовокупнойИД.ПорядокКонтроля КАК ПорядокКонтроля,
		|	_СоставСовокупнойИД.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	_СоставСовокупнойИД.СовокупныйКонтроль КАК СовокупныйКонтроль,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация.Наименование + (ВЫРАЗИТЬ(_СоставСовокупнойИД.ИнвестиционнаяДекларация.Комментарий КАК СТРОКА(1024))) КАК ИнвестиционнаяДекларацияПредставление,
		|	_СоставСовокупнойИД.Назначение КАК Назначение,
		|	ФинансовыеПоказателиСЧА.Регистратор КАК РегистрацияСтоимостиАктивов,
		|	ЕСТЬNULL(ФинансовыеПоказателиСЧА.Значение, 0) КАК РегистрацияСтоимостиАктивов_СЧА,
		|	ЕСТЬNULL(ФинансовыеПоказателиРСА.Значение, 0) КАК РегистрацияСтоимостиАктивов_РСА
		|ИЗ
		|	_СоставСовокупнойИД КАК _СоставСовокупнойИД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО _СоставСовокупнойИД.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСчетов КАК _ТаблицаСчетов
		|		ПО _СоставСовокупнойИД.Организация = _ТаблицаСчетов.Организация
		|			И _СоставСовокупнойИД.СчетДоверительногоУправления = _ТаблицаСчетов.СчетДоверительногоУправления
		|			И _СоставСовокупнойИД.Дата = _ТаблицаСчетов.Дата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиСЧА
		|		ПО _СоставСовокупнойИД.Дата = ФинансовыеПоказателиСЧА.Период
		|			И _СоставСовокупнойИД.Организация = ФинансовыеПоказателиСЧА.Организация
		|			И _СоставСовокупнойИД.СчетДоверительногоУправления = ФинансовыеПоказателиСЧА.СубъектАналитики
		|			И (ФинансовыеПоказателиСЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиРСА
		|		ПО (ФинансовыеПоказателиСЧА.Регистратор = ФинансовыеПоказателиРСА.Регистратор)
		|			И (ФинансовыеПоказателиРСА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	Организация,
		|	Клиент,
		|	ВидДоговораДоверительногоУправления,
		|	СовокупныйКонтроль УБЫВ,
		|	ПорядокКонтроля,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(Организация),
		|	МАКСИМУМ(СовокупныйКонтроль)
		|ПО
		|	Период,
		|	Клиент,
		|	ВидДоговораДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПериод = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонтрольныеСуммы = Новый Массив;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Пока ВыборкаПериод.Следующий() Цикл
		
		ВыборкаКлиент = ВыборкаПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаКлиент.Следующий() Цикл
		
			ВыборкаВидДоговора = ВыборкаКлиент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаВидДоговора.Следующий() Цикл
			
				Выборка = ВыборкаВидДоговора.Выбрать();
				
				СтруктураОтбора = Новый Структура("Организация, Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация");
				
				Если ВыборкаВидДоговора.СовокупныйКонтроль Тогда
					
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, ВыборкаВидДоговора, "Период, Клиент, ВидДоговораДоверительногоУправления");
					СтруктураОтбора.Вставить("Организация", Объект.Организация);
					СтруктураОтбора.Вставить("СовокупнаяИнвестДекларация", Истина);
					ПараметрыОтбора = ОбработкаОбъект.ПараметрыОтбораДляХранилищаЗначений(СтруктураОтбора);
					КонтрольныеСуммы.Добавить(ПараметрыОтбора.КонтрольнаяСумма);
					
					НоваяСтрока = Объект.СоставГрупповогоКонтроля.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаВидДоговора);
					НоваяСтрока.СовокупнаяИнвестДекларация = Истина;
					НоваяСтрока.ПредставлениеСубъекта = ПолучитьПредставлениеСубъекта(ВыборкаВидДоговора);
					НоваяСтрока.ПредставлениеИД = "Совокупная";
					НоваяСтрока.КонтрольнаяСумма = ПараметрыОтбора.КонтрольнаяСумма;
					НоваяСтрока.Выполнено = -1;
					НоваяСтрока.Статус = "";
					
				КонецЕсли; 		
				
				ОбработанныеДокументы = Новый Массив;
				
				Пока Выборка.Следующий() Цикл
					
					Если Не ВыборкаВидДоговора.СовокупныйКонтроль Тогда
						
						ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
						СтруктураОтбора.Вставить("СовокупнаяИнвестДекларация", Ложь);
						ПараметрыОтбора = ОбработкаОбъект.ПараметрыОтбораДляХранилищаЗначений(СтруктураОтбора);
						КонтрольныеСуммы.Добавить(ПараметрыОтбора.КонтрольнаяСумма);
						
						НоваяСтрока = Объект.СоставГрупповогоКонтроля.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
						НоваяСтрока.ПредставлениеСубъекта = Выборка.СчетДоверительногоУправления;
						НоваяСтрока.ПредставлениеИД = Выборка.ИнвестиционнаяДекларация;
						НоваяСтрока.КонтрольнаяСумма = ПараметрыОтбора.КонтрольнаяСумма;
						НоваяСтрока.Выполнено = -1;
						НоваяСтрока.Статус = "";
						
					Иначе
						
						Если ОбработанныеДокументы.Найти(Выборка.РегистрацияСтоимостиАктивов) = Неопределено Тогда
						
							ОбработанныеДокументы.Добавить(Выборка.РегистрацияСтоимостиАктивов);
							НоваяСтрока.РегистрацияСтоимостиАктивов_СЧА = НоваяСтрока.РегистрацияСтоимостиАктивов_СЧА + Выборка.РегистрацияСтоимостиАктивов_СЧА;
							НоваяСтрока.РегистрацияСтоимостиАктивов_РСА = НоваяСтрока.РегистрацияСтоимостиАктивов_РСА + Выборка.РегистрацияСтоимостиАктивов_РСА;
						
						КонецЕсли;
						
					КонецЕсли;
					
					СтрокаСоставаСовокупногоКонтроля = НоваяСтрока.СоставСовокупнойИнвестиционнойДекларации.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаСоставаСовокупногоКонтроля, Выборка);
					СтрокаСоставаСовокупногоКонтроля.СЧА = Выборка.РегистрацияСтоимостиАктивов_СЧА;
					СтрокаСоставаСовокупногоКонтроля.РСА = Выборка.РегистрацияСтоимостиАктивов_РСА;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ДатаСоздания КАК ДатаСоздания,
		|	ХранилищеЗначений.КонтрольнаяСумма КАК КонтрольнаяСумма,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Источник = ""_КонтрольИнвестиционныхДеклараций""
		|	И ХранилищеЗначений.КонтрольнаяСумма В(&КонтрольныеСуммы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ХранилищеЗначений.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("КонтрольныеСуммы", КонтрольныеСуммы);
	
	СохраненныеРезультаты = Запрос.Выполнить().Выгрузить();
	ПроверкаПройдена = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
	Нарушение = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
	
	Для каждого Строка Из Объект.СоставГрупповогоКонтроля Цикл
	
		НайденныеСтроки = СохраненныеРезультаты.НайтиСтроки(Новый Структура("КонтрольнаяСумма", Строка.КонтрольнаяСумма));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			СтрокаРезультат = НайденныеСтроки[0];
			
			Значение = СтрокаРезультат.ХранилищеЗначения.Получить();
			
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
			
				Строка.ИдентификаторРезультата = СтрокаРезультат.Идентификатор;
				Строка.ДатаПроверки = СтрокаРезультат.ДатаСоздания;
				Строка.РезультатПроверкиТекущегоДня = (НачалоДня(Строка.ДатаПроверки) <= Объект.Период);
				
				Если Значение.Свойство("РезультатПроверкиДерева") Тогда
				
					РезультатПроверкиДерева = Значение.РезультатПроверкиДерева;
					Строка.РезультатПроверки = РезультатПроверкиДерева.РезультатПроверки;
					Строка.РезультатПроверкиВн = РезультатПроверкиДерева.РезультатПроверкиВн;
					Строка.РезультатПроверкиИтог = ?(РезультатПроверкиДерева.РезультатПроверкиВн = Нарушение Или РезультатПроверкиДерева.РезультатПроверки = Нарушение, Нарушение, ПроверкаПройдена);
					Строка.Гиперссылка = "Перейти к расшифровке";
					Строка.ОшибкиОценки = Значение.ОшибкиОценки;
					Строка.Статус = "Завершено";
					
				КонецЕсли; 			 	
			
			КонецЕсли;
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры 

#КонецОбласти 

#Область Отладка

&НаКлиенте
Процедура ОтладкаСохранитьНастройки(Команда)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Отладка_ИдентификаторНастроек) И Вопрос("Настройка уже выбрана." + Символы.ПС + "Да - заменить выбранную" + Символы.ПС + "Нет - создать новую", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ИдентификаторНастроек = ЭтаФорма.Отладка_ИдентификаторНастроек;
	Иначе
		ИдентификаторНастроек = Новый УникальныйИдентификатор
	КонецЕсли; 
	
	ЭтаФорма.Отладка_ИдентификаторНастроек = ИдентификаторНастроек;
	ОтладкаСохранитьНастройкиНаСервере();
		
КонецПроцедуры

&НаСервере
Процедура ОтладкаСохранитьНастройкиНаСервере()
	
	СтруктураНастроек = Новый Структура("Организация, Период, СчетДоверительногоУправления, ИнвестиционнаяДекларация, УчитыватьПлановыеОперации, ДинамическийРасчетСтоимости");
	
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, Объект);
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, ЭтаФорма);

	СтруктураНастроек.Вставить("Претрейд", 							Объект.Претрейд.Выгрузить());
	СтруктураНастроек.Вставить("РежимКонтроля", 					ЭтаФорма.РежимКонтроля);
	СтруктураНастроек.Вставить("РежимГрупповогоКонтроля", 			ЭтаФорма.РежимГрупповогоКонтроля);
	СтруктураНастроек.Вставить("СоставГрупповогоКонтроля", 			Объект.СоставГрупповогоКонтроля.Выгрузить());
	СтруктураНастроек.Вставить("СоставСовокупнойИнвестДекларации", 	ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации));
	
	Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
	
	Запись.Идентификатор 		= ЭтаФорма.Отладка_ИдентификаторНастроек;
	Запись.ХранилищеЗначения 	= Новый ХранилищеЗначения(СтруктураНастроек, Новый СжатиеДанных(9));
	Запись.Источник 			= "СохраненныеНастройкиКИД";
	Запись.ДатаСоздания 		= ТекущаяДатаСеанса();
	Запись.НеУдалять 			= Истина;
	Запись.Комментарий			= ЭтаФорма.Отладка_Комментарий;
	Запись.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтладкаЗагрузитьНастройки(Команда)
	
	АдресНастроек = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.ФормаНастройкиОтладки", Новый Структура("ИдентификаторНастроек", ЭтаФорма.Отладка_ИдентификаторНастроек), ЭтаФорма);
	
	Если ТипЗнч(АдресНастроек) = Тип("Строка") 
		И ЭтоАдресВременногоХранилища(АдресНастроек) Тогда
		
		ЗагрузитьНастройки(АдресНастроек);
		
		Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
			ТекущаяСтраница = Элементы.СтраницаИндивидуальныйКонтроль;
			//ПериодПриИзменении(Неопределено);
			РеквизитыКонтроля = ПолучитьРеквизитыКонтроля(Объект.Период, Объект.Организация, Объект.СчетДоверительногоУправления);
			
			//Объект.ИнвестиционнаяДекларация = РеквизитыКонтроля.ИнвестиционнаяДекларация;
			Элементы.РезультатыПроверкиИнвестиционнаяДекларация.Видимость = РеквизитыКонтроля.Консолидирующая;
			ЭтаФорма.РегистрацияСтоимостиАктивов 		= РеквизитыКонтроля.РегистрацияСтоимостиАктивов;
			ЭтаФорма.РегистрацияСтоимостиАктивов_СЧА 	= РеквизитыКонтроля.РегистрацияСтоимостиАктивов_СЧА;
			ЭтаФорма.РегистрацияСтоимостиАктивов_РСА 	= РеквизитыКонтроля.РегистрацияСтоимостиАктивов_РСА;
			ЭтаФорма.РегистрацияСтоимостиАктивов_КЗ 	= РеквизитыКонтроля.РегистрацияСтоимостиАктивов_КЗ;
		ИначеЕсли ЭтаФорма.РежимГрупповогоКонтроля = "ПоСчетам" Тогда
			ТекущаяСтраница = Элементы.СтраницаГрупповойКонтроль;
		ИначеЕсли ЭтаФорма.РежимГрупповогоКонтроля = "ЗаПериод" Тогда
			ТекущаяСтраница = Элементы.СтраницаКонтрольЗаПериод;
		КонецЕсли;
		
		Элементы.ГруппаСтраницыРежима.ТекущаяСтраница = ТекущаяСтраница;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки(АдресНастроек)

	СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресНастроек);
	
	ЗаполнитьЗначенияСвойств(Объект, СтруктураНастроек, "Организация, Период, СчетДоверительногоУправления, ИнвестиционнаяДекларация, УчитыватьПлановыеОперации, ДинамическийРасчетСтоимости");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураНастроек, "РежимКонтроля, РежимГрупповогоКонтроля");
	ЗаполнитьЗначенияСвойств(Этаформа.ПараметрыПроверки, СтруктураНастроек);
	Объект.Претрейд.Загрузить(СтруктураНастроек.Претрейд);
	Объект.СоставГрупповогоКонтроля.Загрузить(СтруктураНастроек.СоставГрупповогоКонтроля);
	ПоместитьВоВременноеХранилище(СтруктураНастроек.СоставСовокупнойИнвестДекларации, ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации);
	
	ЭтаФорма.СовокупнаяИнвестДекларация = (СтруктураНастроек.СоставСовокупнойИнвестДекларации.Количество() > 1);
	
	ЭтаФорма.Отладка_ИдентификаторНастроек = СтруктураНастроек.ИдентификаторНастроек;
	ЭтаФорма.Отладка_Комментарий = СтруктураНастроек.Комментарий;
	
	Результат = Неопределено;
	Если СтруктураНастроек.Свойство("Результат", Результат) Тогда
		ЭтаФорма.Отладка_РезультатСохранен = Истина;
		Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
		
			ПоместитьВоВременноеХранилище(Результат, ЭтаФорма.АдресСтруктурыРезультатовПроверки);
			ЗначениеВРеквизитФормы(Результат.РезультатыПроверки, "РезультатыПроверки");
		
		КонецЕсли;
	Иначе
		ЭтаФорма.Отладка_РезультатСохранен = Ложь;
	КонецЕсли;

КонецПроцедуры
 
&НаКлиенте
Процедура ОтладкаСохранитьРезультатВНастройку(Команда)
	ЭтаФорма.Отладка_РезультатСохранен = Истина;
	ОтладкаСохранитьРезультатВНастройкуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтладкаСохранитьРезультатВНастройкуНаСервере()

	Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = ЭтаФорма.Отладка_ИдентификаторНастроек;
	Запись.Прочитать();
	СтруктураНастроек = Запись.ХранилищеЗначения.Получить();
	Если ЭтаФорма.РежимКонтроля = "ИндивидуальныйКонтроль" Тогда
		
		Если ЭтоАдресВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки) Тогда
			
			СтруктураРезультатовПроверки = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСтруктурыРезультатовПроверки);
			Если ТипЗнч(СтруктураРезультатовПроверки) = Тип("Структура") Тогда
			
				СтруктураНастроек.Вставить("Результат", СтруктураРезультатовПроверки);
			
			КонецЕсли; 			
		
		КонецЕсли; 		
		
	Иначе
		
		СтруктураНастроек.Вставить("СоставГрупповогоКонтроля", Объект.СоставГрупповогоКонтроля.Выгрузить());
		СтруктураНастроек.Вставить("Результат", Истина);
		
	КонецЕсли;
	
	Запись.Комментарий = ЭтаФорма.Отладка_Комментарий;
	Запись.ХранилищеЗначения = Новый ХранилищеЗначения(СтруктураНастроек, Новый СжатиеДанных(9));
	Запись.Записать();

КонецПроцедуры 

&НаКлиенте
Процедура ОтладкаСравнитьРезультатССохраненным(Команда)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Отладка_Каталог) Тогда
	
		РабочийКаталог = ЭтаФорма.Отладка_Каталог;
		Если Прав(РабочийКаталог, 1) <> "\" Тогда
			РабочийКаталог = РабочийКаталог + "\";
		КонецЕсли; 
		
		Файл = Новый Файл(РабочийКаталог);
		Если Не Файл.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указанный каталог не существует",,, "Отладка_Каталог");
			Возврат;
		КонецЕсли; 
		
		СоздатьФайлОбработки(РабочийКаталог);
		
		КаталогОтчетов = РабочийКаталог + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd-HHmm") + "\";
		ОтладкаСравнитьРезультатССохраненнымНаСервере(КаталогОтчетов);
		
		Путь = КаталогПрограммы() + "1cv8.exe";
		Режим = " ENTERPRISE";
		СтрокаСоединения = " /IBConnectionString """ + СтрЗаменить(СтрокаСоединенияИнформационнойБазы(), """", """""") + """";
		ДопПараметры = " /DisableStartupMessages /RunModeOrdinaryApplication";
		Вывод = "";//" /Out " + Каталог + "Результат.txt";
		Параметр = " /C " + КаталогОтчетов;
		Обработка = " /Execute " + """" + РабочийКаталог + "СравнениеТабличныхДокументов.epf""";

		СтрокаКоманды = Путь + Режим + СтрокаСоединения + ДопПараметры + Вывод + Параметр + Обработка;

		ЗапуститьПриложение(СтрокаКоманды, , Истина);		
		
		УдалитьФайлы(КаталогОтчетов);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для сравнения результатов необходимо указать рабочий каталог",,, "Отладка_Каталог");	
	КонецЕсли; 
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьФайлОбработки(РабочийКаталог)
	
	ПутьКФайлуВнешнейОбработкиИлиОтчета = РабочийКаталог + "СравнениеТабличныхДокументов.epf";
	
	Файл = Новый Файл(ПутьКФайлуВнешнейОбработкиИлиОтчета);
	
	Если Не Файл.Существует() Тогда
	
		Файл = Новый Файл(ПолучитьИмяВременногоФайла());
		КаталогВыгрузки = КаталогВременныхФайлов() + "СравнениеТабличныхДокументов_" + Файл.ИмяБезРасширения + "\";
		
		Файл = Новый Файл(КаталогВыгрузки);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогВыгрузки);
		КонецЕсли; 
		
		ПутьККорневомуФайлуВыгрузки = КаталогВыгрузки + "СравнениеТабличныхДокументов.xml";
		
		ФайлХМЛ = Новый ЗаписьТекста(ПутьККорневомуФайлуВыгрузки);
		ФайлХМЛ.Записать(ПолучитьТекстФайлаХМЛ());
		ФайлХМЛ.Закрыть();
		
		КаталогМодуля = КаталогВыгрузки + "СравнениеТабличныхДокументов\Ext\";
		
		Файл = Новый Файл(КаталогМодуля);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(КаталогМодуля);
		КонецЕсли; 
		
		ФайлМодуля = Новый ЗаписьТекста(КаталогМодуля + "ObjectModule.bsl");
		ФайлМодуля.Записать(ПолучитьТекстМодуляОбработки());
		ФайлМодуля.Закрыть();
		СтрокаСоединения = " /S ap35\AssetManagementDemo1";
		СтрокаКоманды = КаталогПрограммы() + "1cv8.exe DESIGNER " + СтрокаСоединения + " /LoadExternalDataProcessorOrReportFromFiles """ + ПутьККорневомуФайлуВыгрузки + """ """ + ПутьКФайлуВнешнейОбработкиИлиОтчета + """";
		
		КодВозврата = Неопределено;
		ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
		
		УдалитьФайлы(КаталогВыгрузки);
			
	КонецЕсли; 
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстМодуляОбработки()

	ТекстМодуля = 
		"Каталог = ПараметрЗапуска;
		|	
		|КаталогТек = Каталог + ""Текущие\"";
		|КаталогСохр = Каталог + ""Сохраненные\"";
		|
		|МассивСохраненных = НайтиФайлы(КаталогСохр, ""*.mxl"");
		|
		|СравнениеФайлов = Новый СравнениеФайлов;
		|СравнениеФайлов.СпособСравнения = СпособСравненияФайлов.ТабличныйДокумент;
		|
		|РасхожденияОтсутствуют = Истина;
		|
		|Для каждого Файл Из МассивСохраненных Цикл
		|	
		|	СравнениеФайлов.ПервыйФайл = КаталогСохр + Файл.Имя;
		|	СравнениеФайлов.ВторойФайл = КаталогТек + Файл.Имя;
		|	
		|	Если Не СравнениеФайлов.Сравнить() Тогда
		|		СравнениеФайлов.ПоказатьРазличия();
		|		РасхожденияОтсутствуют = Ложь;
		|		ТекстСообщения = ""Обнаружены расхождения: ""
		|	Иначе
		|		ТекстСообщения = ""Расхождения отсутствуют: ""
		|	КонецЕсли; 
		|	
		|	Сообщить(ТекстСообщения + Файл.Имя);
		|	
		|КонецЦикла;
		|
		|Если РасхожденияОтсутствуют Тогда
		|	Предупреждение(""Расхождений не найдено"");
		|	ПрекратитьРаботуСистемы();
		|КонецЕсли;";

	Возврат ТекстМодуля;

КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьТекстФайлаХМЛ()

	ТекстХМЛ = "<?xml version=""1.0"" encoding=""UTF-8""?>
	|<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:app=""http://v8.1c.ru/8.2/managed-application/core"" xmlns:cfg=""http://v8.1c.ru/8.1/data/enterprise/current-config"" xmlns:cmi=""http://v8.1c.ru/8.2/managed-application/cmi"" xmlns:ent=""http://v8.1c.ru/8.1/data/enterprise"" xmlns:lf=""http://v8.1c.ru/8.2/managed-application/logform"" xmlns:style=""http://v8.1c.ru/8.1/data/ui/style"" xmlns:sys=""http://v8.1c.ru/8.1/data/ui/fonts/system"" xmlns:v8=""http://v8.1c.ru/8.1/data/core"" xmlns:v8ui=""http://v8.1c.ru/8.1/data/ui"" xmlns:web=""http://v8.1c.ru/8.1/data/ui/colors/web"" xmlns:win=""http://v8.1c.ru/8.1/data/ui/colors/windows"" xmlns:xen=""http://v8.1c.ru/8.3/xcf/enums"" xmlns:xpr=""http://v8.1c.ru/8.3/xcf/predef"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.9"">
