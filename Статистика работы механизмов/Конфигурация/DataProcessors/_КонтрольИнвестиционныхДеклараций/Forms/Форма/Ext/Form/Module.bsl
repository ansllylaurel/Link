&НаКлиенте
Процедура СформироватьБазис(Команда)
	
	Если ЗначениеЗаполнено(ЭтаФорма.Базис) Тогда
	
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "ФОРМИРОВАНИЕОТЧЕТА");
		ПараметрыФормирования = Новый Структура("Настройка, Организация, СчетДоверительногоУправления, Период, АдресДанныхРасшифровкиБазиса, АдресСКДБазиса, Базис, АдресПараметровБазисов");  
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, Объект);
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ЭтаФорма);
		ПараметрыФормирования.Вставить("АвтоматическоеФормирование", Команда = Неопределено);
		ПараметрыФормирования.Вставить("АдресСоставаСовокупнойИнвестДекларации", ЭтаФорма.АдресСоставаСовокупнойИнвестДекларации);
		ПараметрыФормирования.Вставить("СовокупнаяИнвестДекларация", ЭтаФорма.СовокупнаяИнвестДекларация);
		
		ТабличныйДокументБазис = ПолучитьТабличныйДокументБазиса(ПараметрыФормирования);
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.ТабличныйДокументБазис, "НЕИСПОЛЬЗОВАТЬ");
		
		//// !!!!!!
		//Файл = Новый Файл("\\am-1c00\Виктор\КИД\");
		//Если Файл.Существует() Тогда
		//
		//	ХМЛ = ПолучитьХМЛ();
		//	ЗаписьТекста = Новый ЗаписьТекста("\\am-1c00\Виктор\КИД\НастройкиБазиса.xml");
		//	ЗаписьТекста.Записать(ХМЛ.Настройки);
		//	ЗаписьТекста.Закрыть();
		//	ЗаписьТекста = Новый ЗаписьТекста("\\am-1c00\Виктор\КИД\СхемаБазиса.xml");
		//	ЗаписьТекста.Записать(ХМЛ.Схема);
		//	ЗаписьТекста.Закрыть();			
		//
		//КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Настроить(Команда)
	
	Если ЗначениеЗаполнено(Базис) И ЭтоАдресВременногоХранилища(АдресСКДБазиса) И ЭтоАдресВременногоХранилища(АдресНастроекБазиса) Тогда
	
		ПараметрыФормы = Новый Структура("АдресСКДБазиса, АдресНастроекБазиса, Базис", АдресСКДБазиса, АдресНастроекБазиса, Базис);
		Результат = ОткрытьФормуМодально("ВнешняяОбработка._КонтрольИнвестиционныхДеклараций.Форма.НастройкиКомпоновкиБазиса", ПараметрыФормы);
		Если Результат <> Неопределено Тогда
			СформироватьБазис(Ложь);
		КонецЕсли;		
	
	КонецЕсли; 
	
КонецПроцедуры

