
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Контроль инвестиционных деклараций",
		"2.75",
		"",
		Истина,
		"СкриншотФормы");
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СоздатьОтложенныеЗаданияКонтроляТекущегоДня", "Создать отложенные задания контроля текущего дня",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНазначенияИД", "Проверка наличия назначенных ИД",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНастроекСЧА", "Проверка заполнения настроек СЧА",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНастроекБух", "Проверка заполнения настроек по бух. учету",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНаправленияИспользованияЦелевогоКапитала", "Проверка заполнения направления использования ФЦК",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНаличияФайловДляСчетаДУ", "Проверка наличия сканов договоров ДУ и доп. соглашений",, Ложь, "ВызовСерверногоМетода");
	
	// ПараметрыКоманды СоздатьОтложенныеЗаданияКонтроляТекущегоДня:
	// - Организация - СправочникСсылка.Организации
	// - Режим - Строка - Может принимать значения "ПН", "ПР", "Остальные", "Все"
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольНовыхИнвестиционныхДекларацийЗа7Дней", "Контроль новых ИД за 7 дней",, Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#Область Команды_и_отложенные_задания

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Календари = Справочники.Календари;
	ЭтоРабочийДень = Календари.ЭтоРабочийДень(Календари.Общероссийский, ТекущаяДатаСеанса());
	
	Если ИдентификаторКоманды = "СоздатьОтложенныеЗаданияКонтроляТекущегоДня" Тогда
		
		Если ЭтоРабочийДень Тогда
		
			Период = НачалоДня(ТекущаяДатаСеанса());
			
			Префикс = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКоманды.Организация, "ПрефиксНумерации"); 
	 		Команда = СтрШаблон("КонтрольТекущегоДня_%1_%2", Префикс, ПараметрыКоманды.Режим);
			
			Параметры = Новый Структура;
			Параметры.Вставить("Период", 			Период);
			Параметры.Вставить("Организация", 		ПараметрыКоманды.Организация);
			Параметры.Вставить("Режим", 			ПараметрыКоманды.Режим);
			Параметры.Вставить("Команда", 			Команда);
			Параметры.Вставить("ИдентификаторКоманды", 			ПараметрыОбработки.ИдентификаторКоманды);
			Параметры.Вставить("ДополнительнаяОбработкаСсылка", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
			
			СоздатьОтложенныеЗаданияКонтроляЗаДень(Параметры);
		
		КонецЕсли; 
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольНовыхИнвестиционныхДекларацийЗа7Дней" Тогда
		
		Если ЭтоРабочийДень Тогда
		
			КонтрольНовыхИнвестиционныхДекларацийЗа7Дней(ПараметрыКоманды, ПараметрыОбработки);
		
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольНазначенияИД"
		Или ИдентификаторКоманды = "КонтрольНастроекСЧА"
		Или ИдентификаторКоманды = "КонтрольНастроекБух"
		Или ИдентификаторКоманды = "КонтрольНаправленияИспользованияЦелевогоКапитала"
		Или ИдентификаторКоманды = "КонтрольНаличияФайловДляСчетаДУ" Тогда
		
		Если ЭтоРабочийДень Тогда
		
			КонтрольКорректностиНастроек(ПараметрыКоманды, ИдентификаторКоманды);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	ПутьКФайламОтладки = "\\ap69\Developers\Виктор\Temp\Отладка\";
	
	Если Метод = "КонтрольПриРегистрацииСЧА" Тогда
		
		ПараметрыКонтроля = Новый Структура;
		ПараметрыКонтроля.Вставить("Метод", 					Метод); 
		ПараметрыКонтроля.Вставить("ИсточникОповещения", 		"Обработка._КонтрольИнвестиционныхДеклараций." + Метод);
		ПараметрыКонтроля.Вставить("ТемаПисьма", 				"Ошибки контроля ИД при регистрации стоимости активов");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации", Ложь);
		
		ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, ПараметрыКонтроля);
		
	ИначеЕсли Метод = "КонтрольПриЗакрытииДня" Тогда
		
		ПараметрыКонтроля = Новый Структура;
		ПараметрыКонтроля.Вставить("Метод", 					Метод); 
		ПараметрыКонтроля.Вставить("ИсточникОповещения", 		"Обработка._КонтрольИнвестиционныхДеклараций." + Метод);
		ПараметрыКонтроля.Вставить("ТемаПисьма", 				"Ошибки контроля ИД при закрытии дня");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации", Ложь);
		
		ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, ПараметрыКонтроля);
		
	ИначеЕсли СтрНачинаетсяС(Метод, "КонтрольТекущегоДня") Тогда
		
		ПараметрыКонтроля = Новый Структура;
		ПараметрыКонтроля.Вставить("Метод", 					Метод); 
		ПараметрыКонтроля.Вставить("ИсточникОповещения", 		"Обработка._КонтрольИнвестиционныхДеклараций.КонтрольТекущегоДня");
		ПараметрыКонтроля.Вставить("ТемаПисьма", 				"Ошибки контроля ИД за ");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации", Ложь);
		ПараметрыКонтроля.Вставить("УдалитьОтборПоБрокеру", 	Ложь);
		
		ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, ПараметрыКонтроля);
		
	ИначеЕсли СтрНачинаетсяС(Метод, "КонтрольДняТПлюс1") Тогда
		
		ПараметрыКонтроля = Новый Структура;
		ПараметрыКонтроля.Вставить("Метод", 					Метод); 
		ПараметрыКонтроля.Вставить("ИсточникОповещения", 		"Обработка._КонтрольИнвестиционныхДеклараций.КонтрольТекущегоДня");
		ПараметрыКонтроля.Вставить("ТемаПисьма", 				"Ошибки контроля ИД за ");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации", Истина);
		ПараметрыКонтроля.Вставить("УдалитьОтборПоБрокеру", 	Истина);
		
		ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, ПараметрыКонтроля);
		
	ИначеЕсли СтрНачинаетсяС(Метод, "КонтрольДепозитов") Тогда
		
		ПараметрыКонтроля = Новый Структура;
		ПараметрыКонтроля.Вставить("Метод", Метод); 
		ПараметрыКонтроля.Вставить("ИсточникОповещения", "Обработка._КонтрольИнвестиционныхДеклараций.КонтрольДепозитов");
		ПараметрыКонтроля.Вставить("ТемаПисьма", "ВАЖНО! Контроль депозитных сделок Т0");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации", Истина);
		ПараметрыКонтроля.Вставить("УдалитьОтборПоБрокеру", Истина);
		ПараметрыКонтроля.Вставить("ОтчетПоВсемСубъектам", Истина); 
		ПараметрыКонтроля.Вставить("ЗаголовокОтчета", "Результаты контроля депозитных сделок Т0");
		
		ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, ПараметрыКонтроля);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКонтрольПоОтложеннымЗаданиям(Экземпляры, Параметры)

	СчетДУАтлант = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_DU_PIF352");
	
	КлючиЗапуска = Новый ТаблицаЗначений;
	
	КлючиЗапуска.Колонки.Добавить("Организация",					Новый ОписаниеТипов("СправочникСсылка.Организации"));
	КлючиЗапуска.Колонки.Добавить("Период",							Новый ОписаниеТипов("Дата"));
	КлючиЗапуска.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",					Новый ОписаниеТипов("УникальныйИдентификатор"));
	КлючиЗапуска.Колонки.Добавить("ПриостановленРасчетСЧА",			Новый ОписаниеТипов("Булево"));
	
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		НовыйКлюч.ПриостановленРасчетСЧА = БухгалтерскийУчет.ОпределитьНастройкуУчета(НовыйКлюч.Период, НовыйКлюч.Организация, НовыйКлюч.СчетДоверительногоУправления, "ПриостановленРасчетСЧА");
				
	КонецЦикла;
	
	#Область ТекстЗапроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Организация КАК Организация,
		|	КлючиЗапуска.Период КАК Период,
		|	КлючиЗапуска.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор,
		|	КлючиЗапуска.ПриостановленРасчетСЧА КАК ПриостановленРасчетСЧА
		|ПОМЕСТИТЬ _Экземпляры
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Экземпляры.Период КАК Дата,
		|	_Экземпляры.Организация КАК Организация,
		|	_Экземпляры.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Экземпляры.ПриостановленРасчетСЧА КАК ПриостановленРасчетСЧА
		|ПОМЕСТИТЬ _ТаблицаСчетов
		|ИЗ
		|	_Экземпляры КАК _Экземпляры";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	
	ТекущаяОрганизация = КлючиЗапуска[0].Организация;
	
	Запрос.УстановитьПараметр("Организация", 			ТекущаяОрганизация);
	Запрос.УстановитьПараметр("ДоступныеОрганизации", 	ПолучитьДоступныеОрганизации(ТекущаяОрганизация));
	Запрос.УстановитьПараметр("КлиентТрадиция", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция"));
	Запрос.УстановитьПараметр("СчетДУАтлант", 			СчетДУАтлант);
	
	Запрос.Выполнить();
	
	Запрос.Текст = РегистрыСведений.ИнвестиционныеДекларации.ПолучитьТекстЗапросаДляПолученияАктуальныхИнвестиционныхДеклараций();
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _СоставСовокупнойИД.СчетДоверительногоУправления = &СчетДУАтлант
		|			ТОГДА _СоставСовокупнойИД.Дата >= ДАТАВРЕМЯ(2021, 1, 1)
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Включен,
		|	_СоставСовокупнойИД.Дата КАК Дата,
		|	_СоставСовокупнойИД.Организация КАК Организация,
		|	_СоставСовокупнойИД.Клиент КАК Клиент,
		|	_СоставСовокупнойИД.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СоставСовокупнойИД.ПорядокКонтроля КАК ПорядокКонтроля,
		|	_СоставСовокупнойИД.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	ЕСТЬNULL(_СоставСовокупнойИД.СовокупныйКонтроль, ЛОЖЬ) КАК СовокупныйКонтроль,
		|	_СоставСовокупнойИД.Назначение КАК Назначение,
		|	Организации.ВалютаУчета КАК ВалютаУчета,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	_СоставСовокупнойИД.Организация.Представление КАК ОрганизацияПредставление,
		|	_СоставСовокупнойИД.СчетДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларацияПредставление
		|ИЗ
		|	_СоставСовокупнойИД КАК _СоставСовокупнойИД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО _СоставСовокупнойИД.Организация = Организации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО _СоставСовокупнойИД.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка";
	
	СоставСовокупнойИД = Запрос.Выполнить().Выгрузить();
	
	ПроверитьНастройкиПоСчетамДУ(СоставСовокупнойИД);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СоставСовокупнойИД, "_СоставСовокупнойИД", Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СоставСовокупнойИД.Включен КАК Включен,
		|	_СоставСовокупнойИД.Дата КАК Период,
		|	_СоставСовокупнойИД.Организация КАК Организация,
		|	_СоставСовокупнойИД.Клиент КАК Клиент,
		|	_СоставСовокупнойИД.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СоставСовокупнойИД.ПорядокКонтроля КАК ПорядокКонтроля,
		|	_СоставСовокупнойИД.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	_СоставСовокупнойИД.СовокупныйКонтроль КАК СовокупныйКонтроль,
		|	_СоставСовокупнойИД.Назначение КАК Назначение,
		|	_СоставСовокупнойИД.ВалютаУчета КАК ВалютаУчета,
		|	_СоставСовокупнойИД.КодСчета КАК КодСчета,
		|	_СоставСовокупнойИД.ОрганизацияПредставление КАК ОрганизацияПредставление,
		|	_СоставСовокупнойИД.СчетДоверительногоУправленияПредставление КАК СчетДоверительногоУправленияПредставление,
		|	_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларацияПредставление
		|ИЗ
		|	_СоставСовокупнойИД КАК _СоставСовокупнойИД
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	Организация,
		|	Клиент,
		|	ВидДоговораДоверительногоУправления,
		|	СовокупныйКонтроль УБЫВ,
		|	ПорядокКонтроля,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(СовокупныйКонтроль),
		|	МАКСИМУМ(Организация)
		|ПО
		|	Период,
		|	Клиент,
		|	ВидДоговораДоверительногоУправления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	#КонецОбласти 
	
	Если Не Параметры.Свойство("ФиксироватьТолькоНарушения") Тогда
		Параметры.Вставить("ФиксироватьТолькоНарушения", Истина);
	КонецЕсли;
	
	Если Не Параметры.Свойство("УдалитьОтборПоБрокеру") Тогда
		Параметры.Вставить("УдалитьОтборПоБрокеру", Параметры.УчитыватьПлановыеОперации);
	КонецЕсли;
	
	Если Не Параметры.Свойство("ЗаголовокОтчета") Тогда
		Параметры.Вставить("ЗаголовокОтчета", "Портфели, не прошедшие проверку");
	КонецЕсли;
	
	Если Не Параметры.Свойство("ОтчетПоВсемСубъектам") Тогда
		Параметры.Вставить("ОтчетПоВсемСубъектам", Ложь);
	КонецЕсли;
	
	Параметры.Вставить("Механизм", 						"_КонтрольИнвестиционныхДеклараций." + Параметры.Метод);
	Параметры.Вставить("ДинамическийРасчетСтоимости",	Ложь);
	
	ВыборкаПериод = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаПериод.Следующий() Цикл
		
		ВыборкаКлиент = ВыборкаПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаКлиент.Следующий() Цикл
		
			ВыборкаВидДоговора = ВыборкаКлиент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаВидДоговора.Следующий() Цикл
				
				ТекущиеОтложенныеЗадания = Новый Массив;
				СоставСовокупнойИнвестДекларации = ПолучитьТаблицуСоставаСовокупнойИД();
				
				Выборка = ВыборкаВидДоговора.Выбрать();
				
				Пока Выборка.Следующий() Цикл
				
					КлючиПоиска = Новый Структура("Период, СчетДоверительногоУправления");
					ЗаполнитьЗначенияСвойств(КлючиПоиска, Выборка);
					НайденныеСтроки = КлючиЗапуска.НайтиСтроки(КлючиПоиска);
					РаботаСКоллекциями.ДополнитьМассив(ТекущиеОтложенныеЗадания, НайденныеСтроки);
					
					ЗаполнитьЗначенияСвойств(СоставСовокупнойИнвестДекларации.Добавить(), Выборка);
					
					Если Не ВыборкаВидДоговора.СовокупныйКонтроль Тогда
						ПараметрыКонтроля = ПолучитьПараметрыКонтроля(Истина, Параметры);
						ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, Выборка);
						ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации", СоставСовокупнойИнвестДекларации);
						ПараметрыКонтроля.Вставить("СовокупнаяИнвестДекларация", Ложь);
						Если Параметры.Метод = "КонтрольДепозитов" Тогда
							ПараметрыКонтроля.Вставить("Претрейд", ПолучитьТаблицуПретрейдаПоРаспоряжениям(ПараметрыКонтроля));
						КонецЕсли;
						ВыполнитьКонтрольСФиксациейРезультата(ПараметрыКонтроля, ВыборкаВидДоговора.СовокупныйКонтроль, ТекущиеОтложенныеЗадания, ТекущаяОрганизация);
						СоставСовокупнойИнвестДекларации.Очистить();
					КонецЕсли;
									
				КонецЦикла;
				
				Если ВыборкаВидДоговора.СовокупныйКонтроль Тогда
					
					ВыполнитьКонтроль = Истина;
					
					Если Параметры.Метод = "КонтрольПриРегистрацииСЧА" 
						Или Параметры.Метод = "КонтрольПриЗакрытииДня" Тогда
					
						// Проверим все ли РСА проведены. Если нет - двигаем задания на полчаса вперед
						
						Если Не УчетСформирован(Запрос.МенеджерВременныхТаблиц, 
								ВыборкаВидДоговора.Период, 
								ВыборкаВидДоговора.Организация, 
								ВыборкаВидДоговора.Клиент, 
								ВыборкаВидДоговора.ВидДоговораДоверительногоУправления) Тогда
						
							ВыполнитьКонтроль = Ложь;
						
						КонецЕсли; 
					
					КонецЕсли;
					
					Если ВыполнитьКонтроль Тогда
					
						ПараметрыКонтроля = ПолучитьПараметрыКонтроля(Истина, Параметры);
						ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, ВыборкаВидДоговора);
						ПараметрыКонтроля.Вставить("Организация", ТекущаяОрганизация);
						ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации", СоставСовокупнойИнвестДекларации);
						ПараметрыКонтроля.Вставить("СовокупнаяИнвестДекларация", Истина);
						Если Параметры.Метод = "КонтрольДепозитов" Тогда
							ПараметрыКонтроля.Вставить("Претрейд", ПолучитьТаблицуПретрейдаПоРаспоряжениям(ПараметрыКонтроля));
						КонецЕсли;
						ВыполнитьКонтрольСФиксациейРезультата(ПараметрыКонтроля, ВыборкаВидДоговора.СовокупныйКонтроль, ТекущиеОтложенныеЗадания, ТекущаяОрганизация);
						
					Иначе
						
						ЗафиксироватьВыполнениеОтложенныхЗаданий(ТекущиеОтложенныеЗадания);

						Для каждого Задание Из ПолучитьПараметрыЗаданий(ТекущиеОтложенныеЗадания) Цикл
							
							ТекДата = ТекущаяДатаСеанса();
							ТекЧас = Час(ТекДата);
							Если Минута(ТекДата) < 30 Тогда
								ДатаЗапускаПлан = НачалоДня(ТекДата) + (ТекЧас + 0.5) * 3600;
							Иначе
							    ДатаЗапускаПлан = НачалоДня(ТекДата) + (ТекЧас + 1) * 3600;
							КонецЕсли;
							РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(Задание.Объект, Задание.Команда, Задание.Параметры.Получить(), 15, Истина, ДатаЗапускаПлан);
						
						КонецЦикла; 
					
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОтложенныеЗадания.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Экземпляры.Идентификатор КАК Идентификатор,
		|			_Экземпляры.Организация КАК Организация,
		|			МАКСИМУМ(ОтложенныеЗадания.ДатаДобавления) КАК ДатаДобавления,
		|			ОтложенныеЗадания.Объект КАК Объект,
		|			ОтложенныеЗадания.Команда КАК Команда
		|		ИЗ
		|			_Экземпляры КАК _Экземпляры
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|				ПО _Экземпляры.Идентификатор = ОтложенныеЗадания.Идентификатор
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Экземпляры.Организация,
		|			_Экземпляры.Идентификатор,
		|			ОтложенныеЗадания.Объект,
		|			ОтложенныеЗадания.Команда) КАК _Экземпляры
		|		ПО ОтложенныеЗадания.Объект = _Экземпляры.Объект
		|			И ОтложенныеЗадания.Организация = _Экземпляры.Организация
		|			И ОтложенныеЗадания.Команда = _Экземпляры.Команда
		|			И (ОтложенныеЗадания.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание), ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется)))
		|			И ОтложенныеЗадания.ДатаДобавления <= _Экземпляры.ДатаДобавления
		|			И (ОтложенныеЗадания.ДатаЗапускаПлан <= &ТекущаяДата)";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());	
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		// если больше нет выполняющихся или ожидающих запуска ОЗ по текущей организации
		// формируем и отправляем сводный отчет
				
		ПараметрыКоманды = Экземпляры[0].Параметры;
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ЗаголовокОтчета", "Портфели, не прошедшие проверку");
		ПараметрыОповещения.Вставить("ИсточникОповещения", Параметры.ИсточникОповещения);
		ПараметрыОповещения.Вставить("Организация", ПараметрыКоманды.Организация);
		
		Если СтрНачинаетсяС(Параметры.Метод, "КонтрольТекущегоДня")
			Или СтрНачинаетсяС(Параметры.Метод, "КонтрольДняТПлюс1") Тогда
			
			Если ВРег(ПараметрыКоманды.Режим) = "ПН" Тогда
				ВидДоговора = " по договорам ПН";
			ИначеЕсли ВРег(ПараметрыКоманды.Режим) = "ПР" Тогда
				ВидДоговора = " по договорам ПР";
			Иначе
				ВидДоговора = "";
			КонецЕсли; 
			
			ПредставлениеПериода = Формат(ПараметрыКоманды.Период, "ДФ=dd.MM.yyyy");
			
			ПараметрыОповещения.Вставить("ТемаПисьма", СтрШаблон("Ошибки контроля ИД за %1%2",
					ПредставлениеПериода,
					ВидДоговора));
					
			ПараметрыОповещения.Вставить("ТемаУведомленияОбОтсутствииОшибок", СтрШаблон("Выполнен контроль ИД за %1%2. Ошибок не обнаружено", 
				ПредставлениеПериода,
				ВидДоговора));
				
		Иначе
			ПараметрыОповещения.Вставить("ТемаПисьма", Параметры.ТемаПисьма);
		КонецЕсли; 
		
		ДанныеХранилища = ПолучитьСводнуюТаблицуИзХранилища(Параметры.Метод, ТекущаяОрганизация);
		
		Если Не ДанныеХранилища = Неопределено Тогда
			
			СформироватьИОтправитьТаблицуРезультатовКонтроля(ДанныеХранилища.СводнаяТаблица, ПараметрыОповещения);
			
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = ДанныеХранилища.Идентификатор;
			Запись.Удалить();
			
			Если СтрНачинаетсяС(Параметры.Метод, "КонтрольТекущегоДня") Тогда
			
				СледующийРабочиДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ТекущаяДатаСеанса()) + 1, 1);
				
				ПараметрыОЗ = Новый Структура;
				ПараметрыОЗ.Вставить("Команда",				СтрЗаменить(Параметры.Метод, "КонтрольТекущегоДня", "КонтрольДняТПлюс1"));
				ПараметрыОЗ.Вставить("Период", 				СледующийРабочиДень);
				ПараметрыОЗ.Вставить("Организация", 		ПараметрыКоманды.Организация);
				ПараметрыОЗ.Вставить("Режим", 				ПараметрыКоманды.Режим);
				ПараметрыОЗ.Вставить("ИдентификаторКоманды", 			ПараметрыКоманды.ИдентификаторКоманды);
				ПараметрыОЗ.Вставить("ДополнительнаяОбработкаСсылка", 	ПараметрыКоманды.ДополнительнаяОбработкаСсылка);		
				
				СоздатьОтложенныеЗаданияКонтроляЗаДень(ПараметрыОЗ);
			
			КонецЕсли;			
			
		КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыЗаданий(ТекущиеОтложенныеЗадания)

	Идентификаторы = Новый Массив;
	Для каждого Строка Из ТекущиеОтложенныеЗадания Цикл
		Идентификаторы.Добавить(Строка.Идентификатор);
	КонецЦикла; 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтложенныеЗадания.Объект КАК Объект,
		|	ОтложенныеЗадания.Команда КАК Команда,
		|	ОтложенныеЗадания.Параметры КАК Параметры
		|ИЗ
		|	РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
		|ГДЕ
		|	ОтложенныеЗадания.Идентификатор В(&Идентификаторы)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции 

Функция ПолучитьПараметрыКонтроля(АвтоматическийКонтроль = Ложь, ЗначенияПараметров = Неопределено)
	
	ПараметрыКонтроля = Новый Структура;
	
	ПараметрыКонтроля.Вставить("Период");
	ПараметрыКонтроля.Вставить("Организация");
	ПараметрыКонтроля.Вставить("Клиент");
	ПараметрыКонтроля.Вставить("ВидДоговораДоверительногоУправления");
	ПараметрыКонтроля.Вставить("СчетДоверительногоУправления");
	ПараметрыКонтроля.Вставить("ИнвестиционнаяДекларация");
	ПараметрыКонтроля.Вставить("Назначение");
	
	ПараметрыКонтроля.Вставить("Претрейд");
	ПараметрыКонтроля.Вставить("ДинамическийРасчетСтоимости");
	ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации");
	ПараметрыКонтроля.Вставить("РезультатыПроверки");
	ПараметрыКонтроля.Вставить("ИдентификаторРезультата");
	
	Если АвтоматическийКонтроль Тогда
	
		ПараметрыКонтроля.Вставить("Метод");
		ПараметрыКонтроля.Вставить("ИсточникОповещения");
		ПараметрыКонтроля.Вставить("ТемаПисьма");
		ПараметрыКонтроля.Вставить("УчитыватьПлановыеОперации");
		ПараметрыКонтроля.Вставить("ФиксироватьТолькоНарушения");
		ПараметрыКонтроля.Вставить("ОтчетПоВсемСубъектам");
		
		ПараметрыКонтроля.Вставить("УдалитьОтборПоБрокеру");
		ПараметрыКонтроля.Вставить("ЗаголовокОтчета");
		ПараметрыКонтроля.Вставить("Механизм");
		ПараметрыКонтроля.Вставить("ДинамическийРасчетСтоимости");
		ПараметрыКонтроля.Вставить("Претрейд",							ЭтотОбъект.Претрейд.ВыгрузитьКолонки());
		ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации", 	ПолучитьТаблицуСоставаСовокупнойИД());
		ПараметрыКонтроля.Вставить("РезультатыПроверки", 				ПолучитьДеревоРезультата());
		ПараметрыКонтроля.Вставить("ИдентификаторРезультата",			Новый УникальныйИдентификатор);
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, ЗначенияПараметров);
				
	КонецЕсли; 
	
	Возврат ПараметрыКонтроля;
	
КонецФункции

Функция УчетСформирован(МенеджерВременныхТаблиц, Дата, Организация, Клиент, ВидДоговораДоверительногоУправления)

	СтруктураОтбора = Новый Структура("Организация, Клиент, ВидДоговораДоверительногоУправления", 
		Организация, Клиент, ВидДоговораДоверительногоУправления);
	
	СчетаДоверительногоУправленияНаДатуСАктивами = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
		Дата, 
		СтруктураОтбора);
	
	ТекстЗапроса = 
		 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	МИНИМУМ(ВЫБОР
		 |			КОГДА ФинансовыеПоказатели.Регистратор ЕСТЬ NULL
		 |				ТОГДА ЕСТЬNULL(_ТаблицаСчетов.ПриостановленРасчетСЧА, ЛОЖЬ)
		 |			ИНАЧЕ ИСТИНА
		 |		КОНЕЦ) КАК УчетСформирован
		 |ИЗ
		 |	_СоставСовокупнойИД КАК _СоставСовокупнойИД
		 |		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСчетов КАК _ТаблицаСчетов
		 |		ПО (_ТаблицаСчетов.Дата = &Дата)
		 |			И _СоставСовокупнойИД.Организация = _ТаблицаСчетов.Организация
		 |			И _СоставСовокупнойИД.СчетДоверительногоУправления = _ТаблицаСчетов.СчетДоверительногоУправления
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		 |		ПО (ФинансовыеПоказатели.Период = &Дата)
		 |			И _СоставСовокупнойИД.Организация = ФинансовыеПоказатели.Организация
		 |			И _СоставСовокупнойИД.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		 |			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		 |ГДЕ
		 |	_СоставСовокупнойИД.Клиент = &Клиент
		 |	И _СоставСовокупнойИД.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
		 |	И _СоставСовокупнойИД.Включен
		 |	И _СоставСовокупнойИД.СчетДоверительногоУправления В(&СчетаДоверительногоУправленияНаДатуСАктивами)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", ВидДоговораДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправленияНаДатуСАктивами", СчетаДоверительногоУправленияНаДатуСАктивами);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	    Возврат Выборка.УчетСформирован;
	Иначе	
		Возврат Ложь;
	КонецЕсли;	

КонецФункции 

Процедура ВыполнитьКонтрольСФиксациейРезультата(ПараметрыКонтроля, СовокупныйКонтроль, ТекущиеОтложенныеЗадания, ТекущаяОрганизация)

	СводнаяТаблицаРезультатовКонтроля = СоздатьСводнуюТаблицуРезультатовКонтроля();
					
	Если ПараметрыКонтроля.СоставСовокупнойИнвестДекларации.Количество() > 0 
		И ЗначениеЗаполнено(ПараметрыКонтроля.СоставСовокупнойИнвестДекларации[0].ИнвестиционнаяДекларация) Тогда
		
		#Область Выполнение_контроля
		Попытка
			
			ПроверитьИнвестДекларацию(ПараметрыКонтроля, ПараметрыКонтроля.РезультатыПроверки.Строки);
			
			Если ПараметрыКонтроля.Свойство("ТекстОшибки") Тогда
				
				ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ПараметрыКонтроля.ТекстОшибки);
				
			Иначе
				
				#Область Ошибки_оценки
				
				ТаблицаОшибокОценки = Неопределено;
				СтруктураОтчетов = ПараметрыКонтроля.СтруктураОтчетов.Получить();
				Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
					СтруктураОтчетов.Свойство("ТаблицаОшибокОценки", ТаблицаОшибокОценки);
				КонецЕсли;
				ОшибкиОценки = Ложь;
				Если Не ТаблицаОшибокОценки = Неопределено И ТаблицаОшибокОценки.Количество() > 0 Тогда
					НоваяСтрока = СводнаяТаблицаРезультатовКонтроля.Добавить();
					СписокСвойств = "Клиент, ВидДоговораДоверительногоуправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация, Период, ИдентификаторРезультата";
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыКонтроля, СписокСвойств);
					НоваяСтрока.Набор = "Не удалось определить стоимость ценных бумаг";
					НоваяСтрока.Группировка = "";
					НоваяСтрока.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля;
					НоваяСтрока.ОшибкиОценки = Истина;
					ОшибкиОценки = Истина;
				КонецЕсли;
				
				#КонецОбласти
				
				ТаблицаРезультатовКонтроля = ПараметрыКонтроля.СводнаяТаблицаРезультатовКонтроля.Получить();
				Для каждого Строка Из ТаблицаРезультатовКонтроля Цикл
					ЗаполнитьЗначенияСвойств(СводнаяТаблицаРезультатовКонтроля.Добавить(), Строка);
				КонецЦикла;
				
				РезультатПроверки = ПолучитьСтруктуруРезультатаПроверки(ПараметрыКонтроля, ОшибкиОценки, ПолучитьРезультатПроверкиДерева(ПараметрыКонтроля.РезультатыПроверки));
				ДобавитьЗаписьВХранилищеЗначений(ПараметрыКонтроля.ИдентификаторРезультата, РезультатПроверки, ПараметрыКонтроля);
				
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = "Ошибка выполнения контроля: " + ОписаниеОшибки();
			ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ТекстОшибки);
			
		КонецПопытки;							
		#КонецОбласти 
			
	Иначе
		
		ТекстОшибки = "Ошибка выполнения контроля: клиенту не назначена инвест. декларация";
		ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ТекстОшибки);
		
	КонецЕсли;
	
	НачатьТранзакцию();
	
	ЗафиксироватьВыполнениеОтложенныхЗаданий(ТекущиеОтложенныеЗадания);
	
	Если СводнаяТаблицаРезультатовКонтроля.Количество() = 0 И ПараметрыКонтроля.ОтчетПоВсемСубъектам Тогда
		
		СписокОбщихСвойств = "Период, ИдентификаторРезультата";
		СписокСвойствСостава = "Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, Назначение, ИнвестиционнаяДекларация, СовокупныйКонтроль";
		
		Для каждого СтрокаСостав Из ПараметрыКонтроля.СоставСовокупнойИнвестДекларации Цикл
		
			НоваяСтрока = СводнаяТаблицаРезультатовКонтроля.Добавить();
			НоваяСтрока.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыКонтроля, СписокОбщихСвойств);			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСостав, СписокСвойствСостава);
		
		КонецЦикла;
	
	КонецЕсли;
	
	ЗаписатьСводнуюТаблицуВХранилище(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля.Метод, ТекущаяОрганизация, Ложь);
	
	ЗафиксироватьТранзакцию();

КонецПроцедуры

Процедура ЗаписатьСводнуюТаблицуВХранилище(СводнаяТаблицаРезультатовКонтроля, Метод, Организация, БлокироватьВесьРегистр)

	Если БлокироватьВесьРегистр Тогда
	
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХранилищеЗначений");
		Блокировка.Заблокировать();
	
	КонецЕсли; 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Источник = &Источник
		|	И ХранилищеЗначений.Организация = &Организация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Источник", "_КонтрольИнвестиционныхДеклараций." + Метод);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		// таблица уже есть в хранилище, блокируем соответствующую запись и дополняем		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХранилищеЗначений");
		ЭлементБлокировки.УстановитьЗначение("Идентификатор", Выборка.Идентификатор);
		Блокировка.Заблокировать();
		
		Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Выборка.Идентификатор;
		Запись.Прочитать();
		
		СводнаяТаблица = Запись.ХранилищеЗначения.Получить();
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(СводнаяТаблицаРезультатовКонтроля, СводнаяТаблица);
		
		Запись.ХранилищеЗначения = Новый ХранилищеЗначения(СводнаяТаблица);
		Запись.Записать();
								
	Иначе
		
		Если БлокироватьВесьРегистр Тогда
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = Новый УникальныйИдентификатор;
			Запись.Организация = Организация;
			Запись.Источник = "_КонтрольИнвестиционныхДеклараций." + Метод;
			Запись.ХранилищеЗначения = Новый ХранилищеЗначения(СводнаяТаблицаРезультатовКонтроля);
			Запись.Записать();
		Иначе
			// блокируем весь регистр, на случай, если еще одно ОЗ уже выполнило запись
			// выполняем зпрос повторно и создаем новую запись, если не нашли
			ЗаписатьСводнуюТаблицуВХранилище(СводнаяТаблицаРезультатовКонтроля, Метод, Организация, Истина);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСводнуюТаблицуИзХранилища(Метод, Организация)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Источник = &Источник
		|	И ХранилищеЗначений.Организация = &Организация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Источник", "_КонтрольИнвестиционныхДеклараций." + Метод);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеХранилища = Новый Структура("Идентификатор, СводнаяТаблица", 
			Выборка.Идентификатор, 
			Выборка.ХранилищеЗначения.Получить());
		Возврат ДанныеХранилища;
	КонецЕсли;

КонецФункции
 
Процедура ЗафиксироватьВыполнениеОтложенныхЗаданий(ТекущиеОтложенныеЗадания)

	Для каждого ОтложенноеЗадание Из ТекущиеОтложенныеЗадания Цикл
		// Фиксируем успешное выполнение задания.
		РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ОтложенноеЗадание.Идентификатор);
	КонецЦикла;

КонецПроцедуры 

Процедура СоздатьОтложенныеЗаданияКонтроляЗаДень(Параметры) Экспорт

	Период							= Параметры.Период;
	Организация						= Параметры.Организация;
	Режим							= Параметры.Режим;
	Команда 						= Параметры.Команда;
	ИдентификаторКоманды 			= Параметры.ИдентификаторКоманды;
	ДополнительнаяОбработкаСсылка 	= Параметры.ДополнительнаяОбработкаСсылка;
	
	Запрос = Новый Запрос;
	#Область Текст_запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(&Период, Организация = &Организация) КАК ИнвестиционныеДекларацииСрезПоследних
		|		ПО СчетаДоверительногоУправления.Организация = ИнвестиционныеДекларацииСрезПоследних.Организация
		|			И СчетаДоверительногоУправления.Ссылка = ИнвестиционныеДекларацииСрезПоследних.Субъект
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И &ОтборВидДоговора
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
		|	И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|			ИЛИ НЕ ИнвестиционныеДекларацииСрезПоследних.НазначениеИнвестиционнойДекларации ЕСТЬ NULL)";
	
	Если НРег(Режим) = НРег("Все") Тогда
		СтрокаЗамены = "ИСТИНА";
	ИначеЕсли НРег(Режим) = НРег("Остальные") Тогда
		СтрокаЗамены = "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления НЕ В (&ОтборВидДоговораПН, &ОтборВидДоговораПР)";
	ИначеЕсли НРег(Режим) = НРег("ПН") Тогда
		СтрокаЗамены = "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ОтборВидДоговораПН";
	ИначеЕсли НРег(Режим) = НРег("ПР") Тогда
		СтрокаЗамены = "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ОтборВидДоговораПР";
	ИначеЕсли СтрНайти(Режим, "СчетаДоверительногоУправления.") > 0 Тогда 
		СтрокаЗамены = Режим;
	Иначе
		// ошибка                      
		ТекстОшибки = СтрШаблон("Не удалось запустить команду '%1'. Действие для режима '%2' не определено", ИдентификаторКоманды, Режим);
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстОшибки, ДополнительнаяОбработкаСсылка);
		Возврат;
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборВидДоговора", СтрокаЗамены);
	
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ОтборВидДоговораПН", Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	Запрос.УстановитьПараметр("ОтборВидДоговораПР", Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстОшибки = СтрШаблон("Не удалось добавить отложенное задание '_КонтрольИнвестиционныхДеклараций.%1'.", Параметры.Команда);
	
	ПараметрыОтложенногоЗадания = Новый Структура("Организация, Период, ИсточникОшибки, ТекстОшибки, Режим, ИдентификаторКоманды, ДополнительнаяОбработкаСсылка", 
		Организация, 
		Период, 
		"Контроль инвестиционных деклараций",
		ТекстОшибки,
		Режим,
		ИдентификаторКоманды,
		ДополнительнаяОбработкаСсылка);
		
	НачатьТранзакцию();
	Пока Выборка.Следующий() Цикл
		
		ПараметрыОтложенногоЗадания.Вставить("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления);
		РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, Команда, ПараметрыОтложенногоЗадания, 45, Истина);
	
	КонецЦикла; 
	ЗафиксироватьТранзакцию();

КонецПроцедуры

Функция ПолучитьДоступныеОрганизации(ТекущаяОрганизация) Экспорт

	Организация_РЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	Организация_ТрастМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
	
	Если (ТекущаяОрганизация = Организация_РЭМ Или ТекущаяОрганизация = Организация_ТрастМ) 
		И (РольДоступна("МногофирменныйУчет") Или РольДоступна("ПолныеПрава") Или ПараметрыСеанса.ЭтоФоновоеЗадание) Тогда
		
		Если ПараметрыСеанса.ЭтоФоновоеЗадание Тогда
		
			ДоступныеОрганизации = Новый Массив;
			ДоступныеОрганизации.Добавить(Организация_РЭМ);
			ДоступныеОрганизации.Добавить(Организация_ТрастМ);
			Возврат ДоступныеОрганизации;
		
		КонецЕсли; 
		
		// Традицию нужно контролировать совокупно по организации РЭМ и Траст
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИдентификаторПользователяИБ", РаботаСПользователями.ТекущийПользователь().ИдентификаторПользователяИБ);
		Запрос.УстановитьПараметр("Организация_РЭМ", Организация_РЭМ);
		Запрос.УстановитьПараметр("Организация_ТрастМ", Организация_ТрастМ);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Пользователи.Организация КАК Организация
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ
			|	И Пользователи.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
			|	И Пользователи.Организация В (&Организация_РЭМ, &Организация_ТрастМ)";
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		
	Иначе
		
		ДоступныеОрганизации = Новый Массив;
		ДоступныеОрганизации.Добавить(ТекущаяОрганизация);
		Возврат ДоступныеОрганизации;
	
	КонецЕсли;

КонецФункции 

#Область Контроль_новых_инвестиционных_деклараций_за_7_дней

Процедура КонтрольНовыхИнвестиционныхДекларацийЗа7Дней(ПараметрыКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыГрупповогоКонтроля = Новый Структура;
	ПараметрыГрупповогоКонтроля.Вставить("ФиксироватьТолькоНарушения", 			Истина);
	ПараметрыГрупповогоКонтроля.Вставить("УчитыватьПлановыеОперации", 			Истина);
	ПараметрыГрупповогоКонтроля.Вставить("ИмяКолонкиИнвестиционнаяДекларация", 	"НоваяИнвестиционнаяДекларация");
	
	ВыборкаПоОрганизациям = ПолучитьВыборкуПоНовымИнвестиционнымДекларациям(ПараметрыКоманды);
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		ПараметрыГрупповогоКонтроля.Вставить("Организация", ВыборкаПоОрганизациям.Организация);
		ВыборкаПоСчетамДУ = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоСчетамДУ.Следующий() Цикл
		
			ВыборкаПоНовымИД = ВыборкаПоСчетамДУ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоНовымИД.Следующий() Цикл
				
				ПараметрыГрупповогоКонтроля.Вставить("ПараметрыПолученияТаблицыПлановыхОпераций", 
					ПолучитьПараметрыПолученияТаблицыПлановыхОпераций(ВыборкаПоНовымИД.Период, ВыборкаПоНовымИД.Организация, ВыборкаПоНовымИД.СчетДоверительногоУправления));
				
				Выборка = ВыборкаПоНовымИД.Выбрать();
				СводнаяТаблицаРезультатовКонтроля = ВыполнитьГрупповойКонтроль(Выборка, ПараметрыГрупповогоКонтроля);
				СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("ЭтоНоваяИД", Новый ОписаниеТипов("Булево"));
				СводнаяТаблицаРезультатовКонтроля.ЗаполнитьЗначения(Истина, "ЭтоНоваяИД");
				
				РезультатСравненияИД = ПолучитьРезультатСравненияИнвестиционныхДеклараций(ВыборкаПоНовымИД);
				
				Если СводнаяТаблицаРезультатовКонтроля.Количество() > 0 Тогда
					// По новой ИД обнаружены нарушения, выполним контроль текущей ИД на ту же дату, сверим результат.
					Выборка.Сбросить();
					ПараметрыГрупповогоКонтроля.Вставить("ФиксироватьТолькоНарушения", Ложь);
					ПараметрыГрупповогоКонтроля.Вставить("ИмяКолонкиИнвестиционнаяДекларация", "ТекущаяИнвестиционнаяДекларация");
					СводнаяТаблицаРезультатовКонтроляТекущаяИД = ВыполнитьГрупповойКонтроль(Выборка, ПараметрыГрупповогоКонтроля);
					
					СтрокиКДобавлению = Новый Массив;
					Для каждого СтрокаНовойИД Из СводнаяТаблицаРезультатовКонтроля Цикл
					
						Отбор = Новый Структура("СчетДоверительногоУправления, Период, Базис, Набор, Показатель");
						ЗаполнитьЗначенияСвойств(Отбор, СтрокаНовойИД);
						
						НайденныеСтроки = СводнаяТаблицаРезультатовКонтроляТекущаяИД.НайтиСтроки(Отбор);
						РаботаСКоллекциями.ДополнитьМассив(СтрокиКДобавлению, НайденныеСтроки);
					
					КонецЦикла; 
					
					Для каждого Строка Из СтрокиКДобавлению Цикл
						ЗаполнитьЗначенияСвойств(СводнаяТаблицаРезультатовКонтроля.Добавить(), Строка);
					КонецЦикла; 
					
					Запрос = Новый Запрос;
					
					#Область Текст_запроса
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	СводнаяТаблица.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
						|	СводнаяТаблица.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
						|	СводнаяТаблица.Набор КАК Набор,
						|	СводнаяТаблица.Базис КАК Базис,
						|	СводнаяТаблица.ВнутреннийНабор КАК ВнутреннийНабор,
						|	СводнаяТаблица.Группировка КАК Группировка,
						|	СводнаяТаблица.РезультатПроверки КАК РезультатПроверки,
						|	СводнаяТаблица.ОшибкиОценки КАК ОшибкиОценки,
						|	СводнаяТаблица.ИдентификаторРезультата КАК ИдентификаторРезультата,
						|	СводнаяТаблица.Показатель КАК Показатель,
						|	СводнаяТаблица.МинимальноеЗначение КАК МинимальноеЗначение,
						|	СводнаяТаблица.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМин,
						|	СводнаяТаблица.МаксимальноеЗначение КАК МаксимальноеЗначение,
						|	СводнаяТаблица.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМакс,
						|	СводнаяТаблица.Значение КАК Значение,
						|	СводнаяТаблица.Доля КАК Доля,
						|	СводнаяТаблица.МаксимальныйЛимит КАК МаксимальныйЛимит,
						|	СводнаяТаблица.СвободныйЛимит КАК СвободныйЛимит,
						|	СводнаяТаблица.ТекстОшибки КАК ТекстОшибки,
						|	СводнаяТаблица.ЭтоНоваяИД КАК ЭтоНоваяИД
						|ПОМЕСТИТЬ _СводаяТаблица
						|ИЗ
						|	&СводнаяТаблица КАК СводнаяТаблица
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	_СводнаяТаблицаНовые.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
						|	_СводнаяТаблицаНовые.Набор КАК Набор,
						|	_СводнаяТаблицаНовые.Базис КАК Базис,
						|	_СводнаяТаблицаНовые.ВнутреннийНабор КАК ВнутреннийНабор,
						|	_СводнаяТаблицаНовые.Группировка КАК Группировка,
						|	_СводнаяТаблицаНовые.Показатель КАК Показатель,
						|	_СводнаяТаблицаНовые.Значение КАК Значение,
						|	_СводнаяТаблицаНовые.Доля КАК Доля,
						|	_СводнаяТаблицаНовые.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларацияНов,
						|	_СводнаяТаблицаНовые.ОшибкиОценки КАК ОшибкиОценкиНов,
						|	_СводнаяТаблицаНовые.ИдентификаторРезультата КАК ИдентификаторРезультатаНов,
						|	_СводнаяТаблицаНовые.МинимальноеЗначение КАК МинимальноеЗначениеНов,
						|	_СводнаяТаблицаНовые.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМинНов,
						|	_СводнаяТаблицаНовые.МаксимальноеЗначение КАК МаксимальноеЗначениеНов,
						|	_СводнаяТаблицаНовые.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМаксНов,
						|	_СводнаяТаблицаНовые.МаксимальныйЛимит КАК МаксимальныйЛимитНов,
						|	_СводнаяТаблицаНовые.СвободныйЛимит КАК СвободныйЛимитНов,
						|	_СводнаяТаблицаНовые.ТекстОшибки КАК ТекстОшибкиНов,
						|	_СводнаяТаблицаТекущие.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларацияТек,
						|	_СводнаяТаблицаТекущие.ОшибкиОценки КАК ОшибкиОценкиТек,
						|	_СводнаяТаблицаТекущие.ИдентификаторРезультата КАК ИдентификаторРезультатаТек,
						|	_СводнаяТаблицаТекущие.МинимальноеЗначение КАК МинимальноеЗначениеТек,
						|	_СводнаяТаблицаТекущие.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМинТек,
						|	_СводнаяТаблицаТекущие.МаксимальноеЗначение КАК МаксимальноеЗначениеТек,
						|	_СводнаяТаблицаТекущие.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМаксТек,
						|	_СводнаяТаблицаТекущие.Значение КАК ЗначениеТек,
						|	_СводнаяТаблицаТекущие.Доля КАК ДоляТек,
						|	_СводнаяТаблицаТекущие.МаксимальныйЛимит КАК МаксимальныйЛимитТек,
						|	_СводнаяТаблицаТекущие.СвободныйЛимит КАК СвободныйЛимитТек,
						|	_СводнаяТаблицаТекущие.ТекстОшибки КАК ТекстОшибкиТек
						|ИЗ
						|	_СводаяТаблица КАК _СводнаяТаблицаНовые
						|		ЛЕВОЕ СОЕДИНЕНИЕ _СводаяТаблица КАК _СводнаяТаблицаТекущие
						|		ПО _СводнаяТаблицаНовые.СчетДоверительногоУправления = _СводнаяТаблицаТекущие.СчетДоверительногоУправления
						|			И _СводнаяТаблицаНовые.Базис = _СводнаяТаблицаТекущие.Базис
						|			И _СводнаяТаблицаНовые.Набор = _СводнаяТаблицаТекущие.Набор
						|			И _СводнаяТаблицаНовые.ВнутреннийНабор = _СводнаяТаблицаТекущие.ВнутреннийНабор
						|			И _СводнаяТаблицаНовые.Группировка = _СводнаяТаблицаТекущие.Группировка
						|			И _СводнаяТаблицаНовые.Показатель = _СводнаяТаблицаТекущие.Показатель
						|			И (НЕ _СводнаяТаблицаТекущие.ЭтоНоваяИД)
						|ГДЕ
						|	_СводнаяТаблицаНовые.ЭтоНоваяИД
						|
						|УПОРЯДОЧИТЬ ПО
						|	Базис,
						|	Набор,
						|	ВнутреннийНабор,
						|	Группировка
						|ИТОГИ
						|	МАКСИМУМ(Показатель),
						|	МАКСИМУМ(ОшибкиОценкиНов),
						|	МАКСИМУМ(ИдентификаторРезультатаНов),
						|	МАКСИМУМ(ТекстОшибкиНов),
						|	МАКСИМУМ(ИнвестиционнаяДекларацияТек),
						|	МАКСИМУМ(ОшибкиОценкиТек),
						|	МАКСИМУМ(ИдентификаторРезультатаТек),
						|	МАКСИМУМ(ТекстОшибкиТек)
						|ПО
						|	ИнвестиционнаяДекларацияНов,
						|	Базис,
						|	Набор,
						|	ВнутреннийНабор
						|АВТОУПОРЯДОЧИВАНИЕ";						
					#КонецОбласти 
					
					Запрос.УстановитьПараметр("СводнаяТаблица", СводнаяТаблицаРезультатовКонтроля);
					
					#Область Формирование_табличного_документа
					Макет = ПолучитьМакет("Макет");
					Шапка = Макет.ПолучитьОбласть("ШапкаСравненияРезультатов");
					СтрокаИД 			= Макет.ПолучитьОбласть("СтрокаСравненияРезультатовИД");
					СтрокаНабор 		= Макет.ПолучитьОбласть("СтрокаСравненияРезультатовНабор");
					СтрокаНаборГруппа	= Макет.ПолучитьОбласть("СтрокаСравненияРезультатовНаборГруппа");
					СтрокаДетали 		= Макет.ПолучитьОбласть("СтрокаСравненияРезультатовДетали");
					
					ТабличныйДокумент = РезультатСравненияИД;
					Шапка.Параметры.Заголовок = СтрШаблон("Наборы, не прошедшие проверку на %1", Формат(ВыборкаПоНовымИД.Период, "ДФ=dd.MM.yyyy"));
					Шапка.Область(2,,2).ЦветТекста = Новый Цвет(255, 0, 0);
					
					ТабличныйДокумент.Вывести(Шапка);
					
					СсылкаИБ = ОбщегоНазначенияПовтИсп.ПолучитьСсылкуИнформационнойБазы();
					
					ВыборкаИД = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					СоответствиеИдентификаторов = Новый Соответствие;
					
					Пока ВыборкаИД.Следующий() Цикл
						
						СтрокаИД.Параметры.Заполнить(ВыборкаИД);
						
						ЕстьОшибки = Ложь;
						
						Если ЗначениеЗаполнено(ВыборкаИД.ТекстОшибкиНов) Тогда
							РезультатПроверкиНов = ВыборкаИД.ТекстОшибкиНов;
							ЕстьОшибки = Истина;
						ИначеЕсли ВыборкаИД.ОшибкиОценкиНов Тогда
							РезультатПроверкиНов = "Не удалось определить стоимость ценных бумаг";
							ЕстьОшибки = Истина;
						Иначе
							РезультатПроверкиНов = ВыборкаИД.ИдентификаторРезультатаНов;
							СоответствиеИдентификаторов.Вставить(ВыборкаИД.ИдентификаторРезультатаНов, ПолучитьГиперссылкуНаРезультатПроверки(СсылкаИБ, ВыборкаИД.ИдентификаторРезультатаНов));
						КонецЕсли; 
						
						Если ЗначениеЗаполнено(ВыборкаИД.ТекстОшибкиТек) Тогда
							РезультатПроверкиТек = ВыборкаИД.ТекстОшибкиТек;
							ЕстьОшибки = Истина;
						ИначеЕсли ВыборкаИД.ОшибкиОценкиТек Тогда
						    РезультатПроверкиТек = "Не удалось определить стоимость ценных бумаг";
							ЕстьОшибки = Истина;
						Иначе
							РезультатПроверкиТек = ВыборкаИД.ИдентификаторРезультатаТек;
							СоответствиеИдентификаторов.Вставить(ВыборкаИД.ИдентификаторРезультатаТек, ПолучитьГиперссылкуНаРезультатПроверки(СсылкаИБ, ВыборкаИД.ИдентификаторРезультатаТек));
						КонецЕсли; 
						
						СтрокаИД.Параметры.РезультатПроверкиНов = РезультатПроверкиНов;
						СтрокаИД.Параметры.РезультатПроверкиТек = РезультатПроверкиТек;
						ТабличныйДокумент.Вывести(СтрокаИД);
						
						Если ЕстьОшибки Тогда
							Продолжить;
						КонецЕсли; 
						
						ВыборкаБазис = ВыборкаИД.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
										
						Пока ВыборкаБазис.Следующий() Цикл
						
							ВыборкаНабор = ВыборкаБазис.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							
							Пока ВыборкаНабор.Следующий() Цикл
							
								ВыборкаВнутр = ВыборкаНабор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
								
								Пока ВыборкаВнутр.Следующий() Цикл

									Набор = Строка(ВыборкаВнутр.Набор) + ?(ВыборкаВнутр.ВнутреннийНабор, " (внутр.)", "");
									Показатель = СтрШаблон("%1 (%2)", ВыборкаВнутр.Показатель, ВыборкаВнутр.Базис);
									
									Если ЗначениеЗаполнено(ВыборкаВнутр.Группировка) Тогда
										СтрокаНаборГруппа.Параметры.Заполнить(ВыборкаВнутр);
										СтрокаНаборГруппа.Параметры.Набор = Набор;
										ТабличныйДокумент.Вывести(СтрокаНаборГруппа);
										Строка = СтрокаДетали;
									Иначе
										Строка = СтрокаНабор;
										Строка.Параметры.Набор = Набор;
									КонецЕсли; 
									
									Выборка = ВыборкаВнутр.Выбрать();
									
									Пока Выборка.Следующий() Цикл
									
										Строка.Параметры.Заполнить(Выборка);
										
										Строка.Параметры.Значение = Формат(Выборка.Значение, "ЧДЦ=2; ЧН=0,00") + " (" + Выборка.Доля + "%)";
										Строка.Параметры.Показатель = Выборка.Показатель + " (" + Выборка.Базис + ")";
										
										Строка.Параметры.МинНов = Строка(Выборка.МинимальноеЗначениеНов) + ?(Выборка.АбсолютнаяВеличинаМинНов, "", "%");
										Строка.Параметры.МаксНов = Строка(Выборка.МаксимальноеЗначениеНов) + ?(Выборка.АбсолютнаяВеличинаМаксНов, "", "%");
										
										Строка.Параметры.МинТек = Строка(Выборка.МинимальноеЗначениеТек) + ?(Выборка.АбсолютнаяВеличинаМинТек, "", "%");
										Строка.Параметры.МаксТек = Строка(Выборка.МаксимальноеЗначениеТек) + ?(Выборка.АбсолютнаяВеличинаМаксТек, "", "%");
										
										ТабличныйДокумент.Вывести(Строка);
									
									КонецЦикла;
										
								КонецЦикла; 
								
				 			КонецЦикла; 
						
						КонецЦикла;
						
					КонецЦикла;
					#КонецОбласти
					
					ИмяФайла = ПолучитьИмяВременногоФайла("htm");
					ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
					
					ТекстовыйДокумент = Новый ТекстовыйДокумент;
					ТекстовыйДокумент.Прочитать(ИмяФайла);
					
					УдалитьФайлы(ИмяФайла);
					
					ТекстСверкиРезультатовКонтроля = ТекстовыйДокумент.ПолучитьТекст();
					
					Для каждого ЭлементСоответствия Из СоответствиеИдентификаторов Цикл
						ТекстСверкиРезультатовКонтроля = СтрЗаменить(ТекстСверкиРезультатовКонтроля, ЭлементСоответствия.Ключ, ЭлементСоответствия.Значение);
					КонецЦикла;
					
					ТекстСверкиРезультатовКонтроля = СтрЗаменить(ТекстСверкиРезультатовКонтроля, "&lt;", "<");
					ТекстСверкиРезультатовКонтроля = СтрЗаменить(ТекстСверкиРезультатовКонтроля, "&gt;", ">");
					
					НачалоСтроки = СтрНайти(ТекстСверкиРезультатовКонтроля, "<STYLE");
					ТекстСверкиРезультатовКонтроля = Сред(ТекстСверкиРезультатовКонтроля, НачалоСтроки);
					КонецСтроки = СтрНайти(ТекстСверкиРезультатовКонтроля, "</BODY>")-1;
					ТекстСверкиРезультатовКонтроля = Лев(ТекстСверкиРезультатовКонтроля, КонецСтроки);
					
				Иначе
					
					ТекстСверкиРезультатовКонтроля = СтрШаблон("При контроле новых ограничений на дату %1 нарушений не выявлено", Формат(ВыборкаПоНовымИД.Период, "ДФ=dd.MM.yyyy"));
					
				КонецЕсли;
				
				//ТекстПисьма = ТекстСверкиОрганичений + Символы.ПС + ТекстСверкиРезультатовКонтроля;
				
				ТемаПисьма = "Новые ограничения";
				
				РеквизитыОповещения = Новый Структура("Организация, Тема, ДатаНовойИД, СчетДоверительногоУправления, СверкаРезультатовКонтроля", 
					ПараметрыГрупповогоКонтроля.Организация, 
					ТемаПисьма, 
					Формат(ВыборкаПоНовымИД.Период, "ДФ=dd.MM.yyyy"),
					ВыборкаПоНовымИД.СчетДоверительногоУправления,
					ТекстСверкиРезультатовКонтроля);
					
				Справочники.Оповещения.СформироватьОповещения("Обработка._КонтрольИнвестиционныхДеклараций.ВыполнитьКонтрольНовыхИД()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
				
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьВыборкуПоНовымИнвестиционнымДекларациям(ПараметрыКоманды)

	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ОкончаниеПериода, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|			И (КлиентыДоверительногоУправленияСрезПоследних.Организация = СчетаДоверительногоУправления.Организация)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ОкончаниеПериода)
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнвестиционныеДекларации.Период КАК Период,
		|	ИнвестиционныеДекларации.Организация КАК Организация,
		|	ИнвестиционныеДекларации.Субъект КАК Субъект,
		|	НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	ИнвестиционныеДекларации.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
		|	ИнвестиционныеДекларации.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _НовыеИнвестиционныеДекларации
		|ИЗ
		|	РегистрСведений.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НазначениеИнвестиционнойДекларации.ИнвестиционныеДекларации КАК НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации
		|		ПО ИнвестиционныеДекларации.НазначениеИнвестиционнойДекларации = НазначениеИнвестиционнойДекларацииИнвестиционныеДекларации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО (ТИПЗНАЧЕНИЯ(ИнвестиционныеДекларации.Субъект) = ТИП(Справочник.СтратегииИндивидуальногоИнвестирования)
		|				ИЛИ ИнвестиционныеДекларации.Организация = _СчетаДоверительногоУправления.Организация
		|					И (ИнвестиционныеДекларации.Субъект = _СчетаДоверительногоУправления.СчетДоверительногоУправления
		|						ИЛИ ИнвестиционныеДекларации.Субъект = _СчетаДоверительногоУправления.Клиент
		|							И _СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ИнвестиционныеДекларации.ВидДоговораДоверительногоУправления))
		|ГДЕ
		|	ИнвестиционныеДекларации.Активность
		|	И ИнвестиционныеДекларации.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И (ТИПЗНАЧЕНИЯ(ИнвестиционныеДекларации.Субъект) = ТИП(Справочник.СтратегииИндивидуальногоИнвестирования)
		|			ИЛИ ИнвестиционныеДекларации.Субъект В
		|				(ВЫБРАТЬ
		|					Т.СчетДоверительногоУправления
		|				ИЗ
		|					_СчетаДоверительногоУправления КАК Т))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НовыеИнвестиционныеДекларации.Период КАК Период,
		|	_НовыеИнвестиционныеДекларации.Организация КАК Организация,
		|	СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НовыеИнвестиционныеДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|ПОМЕСТИТЬ _НовыеИДКлиентов
		|ИЗ
		|	_НовыеИнвестиционныеДекларации КАК _НовыеИнвестиционныеДекларации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_НовыеИнвестиционныеДекларации.Период КАК ПериодИД,
		|			СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(СтратегииИндивидуальногоИнвестирования.Период) КАК ПериодСтратегии
		|		ИЗ
		|			_НовыеИнвестиционныеДекларации КАК _НовыеИнвестиционныеДекларации
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|				ПО _НовыеИнвестиционныеДекларации.Организация = СтратегииИндивидуальногоИнвестирования.Организация
		|					И _НовыеИнвестиционныеДекларации.Период >= СтратегииИндивидуальногоИнвестирования.Период
		|		ГДЕ
		|			СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						Т.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления КАК Т)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_НовыеИнвестиционныеДекларации.Период,
		|			СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|		ПО _НовыеИнвестиционныеДекларации.Период = ВложенныйЗапрос.ПериодИД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|		ПО _НовыеИнвестиционныеДекларации.Организация = СтратегииИндивидуальногоИнвестирования.Организация
		|			И _НовыеИнвестиционныеДекларации.Субъект = СтратегииИндивидуальногоИнвестирования.Стратегия
		|			И (ВложенныйЗапрос.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления)
		|			И (ВложенныйЗапрос.ПериодСтратегии = СтратегииИндивидуальногоИнвестирования.Период)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НовыеИнвестиционныеДекларации.Период,
		|	_НовыеИнвестиционныеДекларации.Организация,
		|	_НовыеИнвестиционныеДекларации.Субъект,
		|	_НовыеИнвестиционныеДекларации.ИнвестиционнаяДекларация
		|ИЗ
		|	_НовыеИнвестиционныеДекларации КАК _НовыеИнвестиционныеДекларации
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_НовыеИнвестиционныеДекларации.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НовыеИДКлиентов.Период КАК Период,
		|	_НовыеИДКлиентов.Организация КАК Организация,
		|	_НовыеИДКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НовыеИДКлиентов.ИнвестиционнаяДекларация КАК НоваяИнвестиционнаяДекларация,
		|	ЕСТЬNULL(ИнвестиционныеДекларацииСрезПоследнихКлиенты.НазначениеИнвестиционнойДекларации, ИнвестиционныеДекларацииСрезПоследнихСтратегии.НазначениеИнвестиционнойДекларации) КАК ТекущаяИнвестиционнаяДекларация
		|ИЗ
		|	_НовыеИДКлиентов КАК _НовыеИДКлиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(
		|				&ТекущаяДата,
		|				(Организация, Субъект) В
		|					(ВЫБРАТЬ
		|						_НовыеИДКлиентов.Организация КАК Организация,
		|						_НовыеИДКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_НовыеИДКлиентов КАК _НовыеИДКлиентов)) КАК ИнвестиционныеДекларацииСрезПоследнихКлиенты
		|		ПО _НовыеИДКлиентов.Организация = ИнвестиционныеДекларацииСрезПоследнихКлиенты.Организация
		|			И _НовыеИДКлиентов.СчетДоверительногоУправления = ИнвестиционныеДекларацииСрезПоследнихКлиенты.Субъект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|				&ТекущаяДата,
		|				(Организация, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						_НовыеИДКлиентов.Организация КАК Организация,
		|						_НовыеИДКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_НовыеИДКлиентов КАК _НовыеИДКлиентов)) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО _НовыеИДКлиентов.Организация = СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация
		|			И _НовыеИДКлиентов.СчетДоверительногоУправления = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК ИнвестиционныеДекларацииСрезПоследнихСтратегии
		|		ПО _НовыеИДКлиентов.Организация = ИнвестиционныеДекларацииСрезПоследнихСтратегии.Организация
		|			И (СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = ИнвестиционныеДекларацииСрезПоследнихСтратегии.Субъект)
		|ГДЕ
		|	(ИнвестиционныеДекларацииСрезПоследнихКлиенты.НазначениеИнвестиционнойДекларации ЕСТЬ NULL
		|			ИЛИ ИнвестиционныеДекларацииСрезПоследнихСтратегии.НазначениеИнвестиционнойДекларации ЕСТЬ NULL)
		|ИТОГИ
		|	МАКСИМУМ(Период),
		|	МАКСИМУМ(ТекущаяИнвестиционнаяДекларация)
		|ПО
		|	Организация,
		|	СчетДоверительногоУправления,
		|	НоваяИнвестиционнаяДекларация";		
	#КонецОбласти 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	НачалоПериода = ТекущаяДата + 24 * 3600;
	ОкончаниеПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоПериода, 7);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Организация", ПараметрыКоманды.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

КонецФункции

Функция ПолучитьРезультатСравненияИнвестиционныхДеклараций(СтрокаСопоставленияИД)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НовыеПоказатели.Базис КАК Базис,
		|	НовыеПоказатели.НаборИнвестиционнойДекларации КАК Набор,
		|	НовыеПоказатели.ВнутреннийНабор КАК ВнутреннийНабор,
		|	НовыеПоказатели.КонтролируемыйПоказатель КАК Показатель,
		|	НовыеПоказатели.ОпределяетСоставИСтруктуру КАК СоставНов,
		|	НовыеПоказатели.МинимальноеЗначение КАК МинимальноеЗначениеНов,
		|	НовыеПоказатели.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМинНов,
		|	НовыеПоказатели.МаксимальноеЗначение КАК МаксимальноеЗначениеНов,
		|	НовыеПоказатели.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМаксНов,
		|	ЕСТЬNULL(ТекущиеПоказатели.ОпределяетСоставИСтруктуру, ""-"") КАК СоставТек,
		|	ЕСТЬNULL(ТекущиеПоказатели.МинимальноеЗначение, ""-"") КАК МинимальноеЗначениеТек,
		|	ЕСТЬNULL(ТекущиеПоказатели.АбсолютнаяВеличинаМин, Истина) КАК АбсолютнаяВеличинаМинТек,
		|	ЕСТЬNULL(ТекущиеПоказатели.МаксимальноеЗначение, ""-"") КАК МаксимальноеЗначениеТек,
		|	ЕСТЬNULL(ТекущиеПоказатели.АбсолютнаяВеличинаМакс, Истина) КАК АбсолютнаяВеличинаМаксТек
		|ИЗ
		|	Справочник.ИнвестиционныеДекларации.Показатели КАК НовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации.Показатели КАК ТекущиеПоказатели
		|		ПО НовыеПоказатели.Базис = ТекущиеПоказатели.Базис
		|			И НовыеПоказатели.НаборИнвестиционнойДекларации = ТекущиеПоказатели.НаборИнвестиционнойДекларации
		|			И НовыеПоказатели.Эмитент = ТекущиеПоказатели.Эмитент
		|			И НовыеПоказатели.ГруппаЭмитентов = ТекущиеПоказатели.ГруппаЭмитентов
		|			И НовыеПоказатели.ВключаяФилиалы = ТекущиеПоказатели.ВключаяФилиалы
		|			И НовыеПоказатели.ЦеннаяБумага = ТекущиеПоказатели.ЦеннаяБумага
		|			И НовыеПоказатели.ГруппаЦенныхБумаг = ТекущиеПоказатели.ГруппаЦенныхБумаг
		|			И НовыеПоказатели.ВнутреннийНабор = ТекущиеПоказатели.ВнутреннийНабор
		|			И НовыеПоказатели.КонтролируемыйПоказатель = ТекущиеПоказатели.КонтролируемыйПоказатель
		|			И (ТекущиеПоказатели.Ссылка = &ТекущаяИнвестиционнаяДекларация)
		|ГДЕ
		|	НовыеПоказатели.Ссылка = &НоваяИнвестиционнаяДекларация
		|	И (ТекущиеПоказатели.Ссылка ЕСТЬ NULL
		|			ИЛИ ТекущиеПоказатели.ОпределяетСоставИСтруктуру <> НовыеПоказатели.ОпределяетСоставИСтруктуру
		|			ИЛИ ТекущиеПоказатели.МинимальноеЗначение <> НовыеПоказатели.МинимальноеЗначение
		|			ИЛИ ТекущиеПоказатели.АбсолютнаяВеличинаМин <> НовыеПоказатели.АбсолютнаяВеличинаМин
		|			ИЛИ ТекущиеПоказатели.МаксимальноеЗначение <> НовыеПоказатели.МаксимальноеЗначение
		|			ИЛИ ТекущиеПоказатели.АбсолютнаяВеличинаМакс <> НовыеПоказатели.АбсолютнаяВеличинаМакс)";
	//!!! нужно сверять составы групп, а не гуиды
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НоваяИнвестиционнаяДекларация", СтрокаСопоставленияИД.НоваяИнвестиционнаяДекларация);
	Запрос.УстановитьПараметр("ТекущаяИнвестиционнаяДекларация", СтрокаСопоставленияИД.ТекущаяИнвестиционнаяДекларация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	Шапка = Макет.ПолучитьОбласть("ШапкаСравнениеИД");
	Строка = Макет.ПолучитьОбласть("СтрокаСравнениеИД");
	
	ТабличныйДокумент.Вывести(Шапка);
	
	Пока Выборка.Следующий() Цикл
	
		Строка.Параметры.Заполнить(Выборка);
		Строка.Параметры.Набор		= Строка(Выборка.Набор) + ?(Выборка.ВнутреннийНабор, " (внутр.)", "");;
		Строка.Параметры.МинНов 	= Строка(Выборка.МинимальноеЗначениеНов) + ?(Выборка.АбсолютнаяВеличинаМинНов, "", "%");
		Строка.Параметры.МаксНов 	= Строка(Выборка.МаксимальноеЗначениеНов) + ?(Выборка.АбсолютнаяВеличинаМаксНов, "", "%");
		Строка.Параметры.МинТек 	= Строка(Выборка.МинимальноеЗначениеТек) + ?(Выборка.АбсолютнаяВеличинаМинТек, "", "%");
		Строка.Параметры.МаксТек 	= Строка(Выборка.МаксимальноеЗначениеТек) + ?(Выборка.АбсолютнаяВеличинаМаксТек, "", "%");
		
		ТабличныйДокумент.Вывести(Строка);							
	
	КонецЦикла;
	 
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьПараметрыПолученияТаблицыПлановыхОпераций(Период, Организация, СчетДоверительногоУправления) Экспорт

	ПараметрыПолученияТаблицыПлановыхОпераций = Новый Структура("Период, Организация, СчетДоверительногоУправления",
		Период, Организация, СчетДоверительногоУправления);
	
	ПараметрыПолученияТаблицыПлановыхОпераций.Вставить("ТипыОферт", Неопределено);
	
	ВидыДоговоровДУ = Новый Массив;
	ВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	ВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица);
	ВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
	ВидыДоговоровДУ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.Собственный);
	
	Если ВидыДоговоровДУ.Найти(СчетДоверительногоУправления.ВидДоговораДоверительногоУправления) <> Неопределено Тогда
		
		БрокерскиеКомпании = ПолучитьБрокерскиеКомпании(Период, Организация, СчетДоверительногоУправления);
		
		Если БрокерскиеКомпании.Количество() >= 1 Тогда
			Брокер = БрокерскиеКомпании[0].Брокер;
		ИначеЕсли БрокерскиеКомпании.Количество() = 0 Тогда 
			Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка();
		КонецЕсли; 
		
		РасчетныйСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
				
	Иначе
		
		РасчетныеСчета = ПолучитьРасчетныеСчета(Период, Организация, СчетДоверительногоУправления);
		
		Если РасчетныеСчета.Количество() >= 1 Тогда
			РасчетныйСчет = РасчетныеСчета[0].РасчетныйСчет;
		ИначеЕсли РасчетныеСчета.Количество() = 0 Тогда 
			РасчетныйСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
		КонецЕсли;
		
		Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка();
		
	КонецЕсли;
	
	ПараметрыПолученияТаблицыПлановыхОпераций.Вставить("БрокерЦенныеБумаги", Брокер);
	ПараметрыПолученияТаблицыПлановыхОпераций.Вставить("РасчетныйСчетЦенныеБумаги", РасчетныйСчет);
	
	Возврат ПараметрыПолученияТаблицыПлановыхОпераций;

КонецФункции

Функция ПолучитьРасчетныеСчета(Период, Организация, СчетДоверительногоУправления)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия > &Период
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", Период);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();

КонецФункции
 
