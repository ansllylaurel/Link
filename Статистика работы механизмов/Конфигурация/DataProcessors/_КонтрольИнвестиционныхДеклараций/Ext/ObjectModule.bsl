#Область Результаты_контроля

Процедура ЗаполнитьОбъектыФормированияСКДОтчета(СтруктураСКДОтчета, СКДОтчета, КомпоновщикНастроекОтчета, НастройкиОтчета, ВнешниеНаборыДанныхОтчета)

	Если СтруктураСКДОтчета = Неопределено Тогда
		
		СКДОтчета = Новый СхемаКомпоновкиДанных; // СКД для формирования табличного документа расшифровок или сводного отчета
		ИсточникДанных = СКДОтчета.ИсточникиДанных.Добавить();
		ИсточникДанных.Имя = "ИсточникДанных1";
		ИсточникДанных.ТипИсточникаДанных = "Local";
		
		КомпоновщикНастроекОтчета = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроекОтчета.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКДОтчета));
		НастройкиОтчета = КомпоновщикНастроекОтчета.Настройки;
		
		ВнешниеНаборыДанныхОтчета = Новый Структура;
		
		СтруктураСКДОтчета = Новый Структура;
		СтруктураСКДОтчета.Вставить("СКДОтчета", СКДОтчета);
		СтруктураСКДОтчета.Вставить("КомпоновщикНастроекОтчета", КомпоновщикНастроекОтчета);
		СтруктураСКДОтчета.Вставить("НастройкиОтчета", НастройкиОтчета);
		СтруктураСКДОтчета.Вставить("ВнешниеНаборыДанныхОтчета", ВнешниеНаборыДанныхОтчета);
		
	Иначе
		
		СКДОтчета 					= СтруктураСКДОтчета.СКДОтчета;
		КомпоновщикНастроекОтчета 	= СтруктураСКДОтчета.КомпоновщикНастроекОтчета;
		НастройкиОтчета 			= СтруктураСКДОтчета.НастройкиОтчета;
		ВнешниеНаборыДанныхОтчета 	= СтруктураСКДОтчета.ВнешниеНаборыДанныхОтчета;
		
	КонецЕсли;

КонецПроцедуры
 
Функция СформироватьВложеннуюСКД(СКД, СКДОтчета, СтрокаПоказателей, ПараметрыБазиса, ПараметрыПоказателя)
	
	ИмяПоказателя = ПараметрыПоказателя.ПутьКДанным;
	
	ВложеннаяСхема = СКДОтчета.ВложенныеСхемыКомпоновкиДанных.Добавить();
	ВложеннаяСхема.Заголовок = СтрокаПоказателей.Базис.Наименование;
	ВложеннаяСхема.Имя = "ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса + "_" + ПараметрыПоказателя.ИмяПоляДоля;
	ВложеннаяСхема.Схема = Новый СхемаКомпоновкиДанных;
	
	СхемаВложенногоОтчета = ВложеннаяСхема.Схема;
	
	ИсточникДанных = СхемаВложенногоОтчета.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local"; 
	
	НаборДанных = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ТаблицаБазиса";
	НаборДанных.ИмяОбъекта = "ТаблицаБазиса_" + ПараметрыБазиса.НомерБазиса;
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	Для каждого Поле Из СКД.НаборыДанных[0].Поля Цикл
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НовоеПоле, Поле);
	КонецЦикла; 
	
	Если ПараметрыБазиса.РежимПолученияБазы = 0 Тогда
		
		НаборДанных = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанных.Имя = "ТаблицаСЧА";
		НаборДанных.ИмяОбъекта = "ТаблицаСЧА_" + ПараметрыБазиса.НомерБазиса;
		НаборДанных.ИсточникДанных = "ИсточникДанных1";
		
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле = "БазаВидАктива";
		НовоеПоле.ПутьКДанным = "БазаВидАктива";
		НовоеПоле.Заголовок = "Вид актива";
		НовоеПоле.ТипЗначения = Новый ОписаниеТипов("Строка");
		
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле = "БазаСумма";
		НовоеПоле.ПутьКДанным = "БазаСумма";
		НовоеПоле.Заголовок = "Сумма";
		НовоеПоле.ТипЗначения = Новый ОписаниеТипов("Число");
		
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле = "БазаДоляСумма";
		НовоеПоле.ПутьКДанным = "БазаДоляСумма";
		НовоеПоле.Заголовок = "Доля";
		НовоеПоле.ТипЗначения = Новый ОписаниеТипов("Число");
		
		ПолеИтога = СхемаВложенногоОтчета.ПоляИтога.Добавить();
		ПолеИтога.Выражение = "Сумма(БазаСумма)";
		ПолеИтога.ПутьКДанным = "БазаСумма";
		
	КонецЕсли; 
	
	// рейтинги
	ИсходныйНаборРейтинги = СКД.НаборыДанных.Найти("Рейтинги");
	Если Не ИсходныйНаборРейтинги = Неопределено Тогда
	
		НаборДанныхРейтинги = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НаборДанныхРейтинги, ИсходныйНаборРейтинги);
		// !!!!!
		
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "Рейтинги", "Основные.Актив", 				"Рейтинги.ЦеннаяБумага", 	"ЦеннаяБумага");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "Рейтинги", "Основные.ГоловнаяОрганизация", 	"Рейтинги.Эмитент", 		"Эмитент");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "Рейтинги", "Основные.Гарант", 				"Рейтинги.Гарант", 			"Гарант");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "Рейтинги", "Основные.Валюта", 				"Рейтинги.Валюта", 			"Валюта");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "Рейтинги", "Служебные.ЮрЛицоМинфин",		"Рейтинги.ЮрЛицоМинфин", 	"ЮрЛицоМинфин");
				
		Для каждого Поле Из ИсходныйНаборРейтинги.Поля Цикл
			НовоеПоле = НаборДанныхРейтинги.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовоеПоле, Поле);
		КонецЦикла; 
	
	КонецЕсли; 
	
	// связанные лица группы компаний
	ИсходныйНаборСвязанныеЛицаГруппыКомпаний = СКД.НаборыДанных.Найти("СвязанныеЛицаГруппыКомпаний");
	Если Не ИсходныйНаборСвязанныеЛицаГруппыКомпаний = Неопределено Тогда
	
		НаборДанныхСвязанныеЛицаГруппыКомпаний = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НаборДанныхСвязанныеЛицаГруппыКомпаний, ИсходныйНаборСвязанныеЛицаГруппыКомпаний);
		// !!!!!
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛицаГруппыКомпаний", "Основные.ГоловнаяОрганизация", "СвязанныеЛицаГруппыКомпаний.ЮрФизЛицо", "СвязанныеЛицаГруппыКомпанийЭмитентПараметр");
		
		Для каждого Поле Из ИсходныйНаборСвязанныеЛицаГруппыКомпаний.Поля Цикл
			НовоеПоле = НаборДанныхСвязанныеЛицаГруппыКомпаний.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовоеПоле, Поле);
		КонецЦикла; 
	
	КонецЕсли;
	
	// связанные лица
	ИсходныйНаборСвязанныеЛица = СКД.НаборыДанных.Найти("СвязанныеЛица");
	Если Не ИсходныйНаборСвязанныеЛица = Неопределено Тогда
	
		НаборДанныхСвязанныеЛица = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НаборДанныхСвязанныеЛица, ИсходныйНаборСвязанныеЛица);
		// !!!!!
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛица", "Основные.ГоловнаяОрганизация", 				"СвязанныеЛица.Эмитент", 						"СвязанныеЛицаЭмитентПараметр");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛица", "Основные.ЮрФизЛицоФонда", 						"СвязанныеЛица.ЮрФизЛицоФонда", 				"СвязанныеЛицаЮрФизЛицоФондаПараметр");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.ОрганизацияСсылка", 					"СвязанныеЛица.Организация", 					"СвязанныеЛицаОрганизацияПараметр");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.СчетДоверительногоУправленияСсылка", "СвязанныеЛица.СчетДоверительногоУправления", 	"СвязанныеЛицаСчетДоверительногоУправленияПараметр");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛица", "Служебные.НачалоПериода", 						"СвязанныеЛица.НачалоПериода", 					"СвязанныеЛицаНачалоПериодаПараметр");
		
		Для каждого Поле Из ИсходныйНаборСвязанныеЛица.Поля Цикл
			НовоеПоле = НаборДанныхСвязанныеЛица.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовоеПоле, Поле);
		КонецЦикла; 
	
	КонецЕсли;
	
	// связанные лица Инфинитум
	ИсходныйНаборСвязанныеЛицаИнфинитум = СКД.НаборыДанных.Найти("СвязанныеЛицаИнфинитум");
	Если Не ИсходныйНаборСвязанныеЛицаИнфинитум = Неопределено Тогда
	
		НаборДанныхСвязанныеЛицаИнфинитум = СхемаВложенногоОтчета.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НаборДанныхСвязанныеЛицаИнфинитум, ИсходныйНаборСвязанныеЛицаИнфинитум);
		// !!!!!
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛицаИнфинитум", "Основные.ГоловнаяОрганизация", 	"СвязанныеЛицаИнфинитум.ЮрФизЛицо", 	"СвязанныеЛицаИнфинитумЭмитентПараметр");
		ДобавитьСвязьНаборовДанных(СхемаВложенногоОтчета, "ТаблицаБазиса", "СвязанныеЛицаИнфинитум", "Служебные.ОрганизацияСсылка", 	"СвязанныеЛицаИнфинитум.Организация", 	"СвязанныеЛицаИнфинитумОрганизацияПараметр");
		
		Для каждого Поле Из ИсходныйНаборСвязанныеЛицаИнфинитум.Поля Цикл
			НовоеПоле = НаборДанныхСвязанныеЛицаИнфинитум.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовоеПоле, Поле);
		КонецЦикла; 
	
	КонецЕсли;
	
	// поле РезультатПроверки
	ВыражениеРезультат = "Выбор Когда &АбсолютнаяВеличинаМин Тогда ИмяПоказателя Иначе ИмяПоляДоля Конец >= &МинимальноеЗначение
		|И Выбор Когда &АбсолютнаяВеличинаМакс Тогда Выбор Когда &МаксимальноеЗначение = 0 Тогда 0 Иначе ИмяПоказателя Конец Иначе ИмяПоляДоля Конец <= &МаксимальноеЗначение";
	ВыражениеРезультат = СтрЗаменить(ВыражениеРезультат, "ИмяПоказателя", ПараметрыПоказателя.ПутьКДанным);
	ВыражениеРезультат = СтрЗаменить(ВыражениеРезультат, "ИмяПоляДоля", ПараметрыПоказателя.ИмяПоляДоля);
	
	ПолеРезультат = СхемаВложенногоОтчета.ВычисляемыеПоля.Добавить();
	ПолеРезультат.ПутьКДанным = "РезультатПроверки";
	ПолеРезультат.Заголовок = "Результат проверки";
	ПолеРезультат.Выражение = ВыражениеРезультат;
	
	// параметры вложенной СКД отчета
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "МинимальноеЗначение";
	ПараметрВложеннойСКД.Заголовок = "Минимальное значение";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
			
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "МаксимальноеЗначение";
	ПараметрВложеннойСКД.Заголовок = "Максимальное значение";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "ЦелевоеЗначение";
	ПараметрВложеннойСКД.Заголовок = "Целевое значение";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "АбсолютнаяВеличинаМин";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "АбсолютнаяВеличинаЦель";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "АбсолютнаяВеличинаМакс";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "КонтролируемыйПоказатель";
	ПараметрВложеннойСКД.Заголовок = "Контролируемый показатель";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	
	ПараметрВложеннойСКД = СхемаВложенногоОтчета.Параметры.Добавить();
	ПараметрВложеннойСКД.Имя = "ЗначениеБазы";
	ПараметрВложеннойСКД.Заголовок = "Значение базы";
	ПараметрВложеннойСКД.ОграничениеИспользования = Ложь;
	
	// ресурсы вложенной СКД отчета
	Для каждого ОписаниеПоля Из ПараметрыБазиса.ТаблицаПолей Цикл
	
		Если ОписаниеПоля.Ресурс И Не ОписаниеПоля.ПутьКДанным = ПараметрыПоказателя.ПутьКДанным Тогда
			
			ПолеИтога = СхемаВложенногоОтчета.ПоляИтога.Добавить();
			ПолеИтога.Выражение = ОписаниеПоля.ВыражениеРесурса;
			ПолеИтога.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
			Для каждого ПутьКДанным Из ОписаниеПоля.ГруппировкиРесурса Цикл
				ПолеИтога.Группировки.Добавить(ПутьКДанным);
			КонецЦикла;
		
		КонецЕсли; 
	
	КонецЦикла;
	
	Для каждого ОписаниеПоля Из ПараметрыБазиса.ТаблицаВычисляемыхПолей Цикл
	
		Если ОписаниеПоля.Ресурс И Не ОписаниеПоля.ПутьКДанным = ПараметрыПоказателя.ПутьКДанным Тогда
			
			ПолеИтога = СхемаВложенногоОтчета.ПоляИтога.Добавить();
			ПолеИтога.Выражение = ОписаниеПоля.ВыражениеРесурса;
			ПолеИтога.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
			Для каждого ПутьКДанным Из ОписаниеПоля.ГруппировкиРесурса Цикл
				ПолеИтога.Группировки.Добавить(ПутьКДанным);
			КонецЦикла;
		
		КонецЕсли; 
	
	КонецЦикла;
	
	ПолеИтога = СхемаВложенногоОтчета.ПоляИтога.Добавить();
	ЗаполнитьЗначенияСвойств(ПолеИтога, ПараметрыПоказателя);
	ПолеИтога.Выражение = ПараметрыПоказателя.ВыражениеПоказатель;
	Для каждого ПутьКДанным Из ПараметрыПоказателя.Группировки Цикл
		ПолеИтога.Группировки.Добавить(ПутьКДанным);
	КонецЦикла;
			
	// итог по полю РезультатПроверки
	ВыражениеРезультатИтог = "Сумма(Выбор Когда &АбсолютнаяВеличинаМин Тогда ИмяПоказателя Иначе ИмяПоляДоля Конец) >= &МинимальноеЗначение
		|И Сумма(Выбор Когда &АбсолютнаяВеличинаМакс Тогда Выбор Когда &МаксимальноеЗначение = 0 Тогда 0 Иначе ИмяПоказателя Конец Иначе ИмяПоляДоля Конец) <= &МаксимальноеЗначение";
	ВыражениеРезультатИтог = СтрЗаменить(ВыражениеРезультатИтог, "ИмяПоказателя", ПараметрыПоказателя.ПутьКДанным);
	ВыражениеРезультатИтог = СтрЗаменить(ВыражениеРезультатИтог, "ИмяПоляДоля", ПараметрыПоказателя.ИмяПоляДоля);

	ПолеИтогаРезультат = СхемаВложенногоОтчета.ПоляИтога.Добавить();
	ПолеИтогаРезультат.ПутьКДанным = "РезультатПроверки";
	ПолеИтогаРезультат.Выражение = ВыражениеРезультатИтог;
	
	Возврат ВложеннаяСхема;

КонецФункции

Процедура СформироватьНастройкиВложенногоБазиса(НастройкиОтчета, Настройки, СтрокаПоказателей, ПараметрыПоказателя, ПараметрыБазиса, УдалитьОтборПоБрокеру)

	// добавляем элемент структуры Отчет
	НастройкаВложенногоОбъекта = НастройкиОтчета.Структура.Добавить(Тип("НастройкиВложенногоОбъектаКомпоновкиДанных"));
	НастройкаВложенногоОбъекта.УстановитьИдентификатор("ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса + "_" + ПараметрыПоказателя.ИмяПоляДоля);
	НастройкаВложенногоОбъекта.Имя = "ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса;
	
	НастройкаОтчета = НастройкаВложенногоОбъекта.Настройки;
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьЗаголовок", ТипВыводаТекстаКомпоновкиДанных.Выводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", "Базис: " + СтрокаПоказателей.Базис.Наименование);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("АвтоПозицияРесурсов", АвтоПозицияРесурсовКомпоновкиДанных.НеИспользовать);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("МакетОформления", "МакетОформленияОтчетовЗеленый");
	
	// выбранные поля
	Если ПараметрыБазиса.РежимПолученияБазы = 0 Тогда
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("БазаВидАктива");
		ПолеВыбор.Заголовок = "Вид актива";
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("БазаСумма");
		ПолеВыбор.Заголовок = "Сумма";
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("БазаСумма.ПроцентОбщий");
		ПолеВыбор.Заголовок = "Доля";
		
		ЭлементУОСумма = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();
		ЭлементУОСумма.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=4; ЧН=0,00");
		ЭлементУОСумма.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("БазаСумма.ПроцентОбщий");
		
		ЭлементУОДоля = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();
		ЭлементУОДоля.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=2; ЧН=0,00");
		ЭлементУОДоля.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("БазаСумма");
		
	Иначе
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
		ПолеВыбор.Заголовок = "Вид актива";
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("Показатели.Сумма");
		ПолеВыбор.Заголовок = "Сумма";
		
		ПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("ДоляСумма");
		ПолеВыбор.Заголовок = "Доля";
		
		// условное оформление
		ЭлементУОДоля = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();
		ЭлементУОДоля.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=4; ЧН=0,00");
		ЭлементУОДоля.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ДоляСумма");
	
	КонецЕсли; 
	
	
	// параметры
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("МинимальноеЗначение", 0);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("МаксимальноеЗначение", 0);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("ЦелевоеЗначение", 0);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаМин", Ложь);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаМакс", Ложь);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаЦель", Ложь);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("КонтролируемыйПоказатель", "");
	
	// отборы 
	Справочники.ИнвестиционныеДекларации.ЗаполнитьОтбор(НастройкаОтчета.Отбор, Настройки.Отбор, Истина, УдалитьОтборПоБрокеру);
	
	// структура вложенный схемы отчета
	НоваяГруппировка = НастройкаОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	Если ПараметрыБазиса.РежимПолученияБазы = 0 Тогда
		ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("БазаВидАктива");
	Иначе
		ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
	КонецЕсли;
	
	// сортировка
	Порядок = НастройкаОтчета.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Порядок.Поле = Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
		
КонецПроцедуры

Процедура СформироватьНастройкиВложенногоОбъекта(ИмяВложенногоОбъекта, НастройкиОтчета, Настройки, СтрокаПоказателей, ПараметрыПоказателя, ПараметрыБазиса, Пустая, Параметры, МинимальноеЗначение, МаксимальноеЗначение, ГруппыЭмитентов, ГруппыАктивов, СовокупныйКонтроль, ЭтоКлиентТрадиция, ТекущаяИД)

	// добавляем элемент структуры Отчет
	НастройкаВложенногоОбъекта = НастройкиОтчета.Структура.Добавить(Тип("НастройкиВложенногоОбъектаКомпоновкиДанных"));
	НастройкаВложенногоОбъекта.УстановитьИдентификатор("ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса + "_" + ПараметрыПоказателя.ИмяПоляДоля);
	НастройкаВложенногоОбъекта.Имя = ИмяВложенногоОбъекта;
	
	Если Пустая Тогда
	
		НастройкаВложенногоОбъекта.Имя = НастройкаВложенногоОбъекта.Имя + " Пустая";
	
	КонецЕсли; 
	
	ФорматнаяСтрока = "ЧДЦ=2; ЧН=0,00";
	ФорматнаяСтрокаМакс = ?(СтрокаПоказателей.АбсолютнаяВеличинаМакс, "ЧДЦ=2; ЧН='Без органичения'", ФорматнаяСтрока);
	
	//Заголовок = СтрокаПоказателей.НаборИнвестиционнойДекларации.Наименование + ". " + СокрЛП(СтрокаПоказателей.КонтролируемыйПоказатель) + ": " + 
	//
	ОтборПоЭмитенту = "";
	ОтборПоЦеннойБумаге = "";
	ДатаЗапретаПокупки = "";
	Если ЗначениеЗаполнено(СтрокаПоказателей.Эмитент) Тогда
		ОтборПоЭмитенту = СтрокаПоказателей.Эмитент;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоказателей.ГруппаЭмитентов) Тогда
		ГруппаЭмитентовИмя = ГруппыЭмитентов.Получить(СтрокаПоказателей.ГруппаЭмитентов).Имя;
		ОтборПоЭмитенту = "Группа " + ГруппаЭмитентовИмя;			
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоказателей.ЦеннаяБумага) Тогда
		ОтборПоЦеннойБумаге = СтрокаПоказателей.ЦеннаяБумага;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоказателей.ГруппаЦенныхБумаг) Тогда
		ГруппаЦенныхБумагИмя = ГруппыАктивов.Получить(СтрокаПоказателей.ГруппаЦенныхБумаг).Имя;
		ОтборПоЦеннойБумаге = "Группа " + ГруппаЦенныхБумагИмя;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоказателей.ДатаЗапретаПокупки) Тогда
		ДатаЗапретаПокупки = "Запрет покупки с " + Формат(СтрокаПоказателей.ДатаЗапретаПокупки, "ДФ=dd.MM.yyyy");
	КонецЕсли;
		
	ПредставлениеНабора = Новый Массив;
	ПредставлениеНабора.Добавить(СтрокаПоказателей.НаборИнвестиционнойДекларации.Наименование);
	Если ЗначениеЗаполнено(ОтборПоЭмитенту) Тогда
		ПредставлениеНабора.Добавить(ОтборПоЭмитенту);
	КонецЕсли; 
	Если ЗначениеЗаполнено(ОтборПоЦеннойБумаге) Тогда
		ПредставлениеНабора.Добавить(ОтборПоЦеннойБумаге);
	КонецЕсли; 
	Если ЗначениеЗаполнено(ДатаЗапретаПокупки) Тогда
		ПредставлениеНабора.Добавить(ДатаЗапретаПокупки);
	КонецЕсли;
									
	Набор = СтрСоединить(ПредставлениеНабора, "; ") + ?(СтрокаПоказателей.ВнутреннийНабор, " (внутр.). ", ". ");
	
	Заголовок = Строка(СтрокаПоказателей.НомерСтроки) + ". " + Набор + СокрЛП(СтрокаПоказателей.КонтролируемыйПоказатель) + ": " + 
		Формат(СтрокаПоказателей.МинимальноеЗначение, ФорматнаяСтрока) + ?(СтрокаПоказателей.АбсолютнаяВеличинаМин, "", "%") + " - " + 
		Формат(СтрокаПоказателей.МаксимальноеЗначение, ФорматнаяСтрокаМакс) + ?(СтрокаПоказателей.АбсолютнаяВеличинаМакс, "", "%");
	
	НастройкаОтчета = НастройкаВложенногоОбъекта.Настройки;
	
	// параметры вывода
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьЗаголовок", 		ТипВыводаТекстаКомпоновкиДанных.Выводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", 				Заголовок);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных", 	ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", 			ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("АвтоПозицияРесурсов", 		АвтоПозицияРесурсовКомпоновкиДанных.НеИспользовать);
	НастройкаОтчета.ПараметрыВывода.УстановитьЗначениеПараметра("МакетОформления", 			"МакетОформленияОтчетовЗеленый");
	
	// пользовательские поля
	
	Справочники.ИнвестиционныеДекларации.ЗаполнитьПользовательскиеПоля(НастройкаОтчета.ПользовательскиеПоля, Настройки.ПользовательскиеПоля); 
	
	ПользовательскоеПолеМин = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	ПользовательскоеПолеМин.Заголовок = "МинимальноеЗначение";
	ПользовательскоеПолеМин.УстановитьВыражения("", "ПараметрыДанных.МинимальноеЗначение");
	
	ПользовательскоеПолеМакс = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	ПользовательскоеПолеМакс.Заголовок = "МаксимальноеЗначение";
	ПользовательскоеПолеМакс.УстановитьВыражения("", "ПараметрыДанных.МаксимальноеЗначение");
	
	Если ТекущаяИД.ИспользоватьЦелевоеЗначение Тогда
	
		ПользовательскоеПолеЦель = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
		ПользовательскоеПолеЦель.Заголовок = "ЦелевоеЗначение";
		ПользовательскоеПолеЦель.УстановитьВыражения("", "ПараметрыДанных.ЦелевоеЗначение");		
	
	КонецЕсли; 
	
	// поле Дельта
	ВыражениеМинимальноеЗначение = "Выбор Когда &АбсолютнаяВеличинаМин Тогда &МинимальноеЗначение Иначе &МинимальноеЗначение * &ЗначениеБазы * 0.01 Конец";
	ВыражениеМаксимальноеЗначение = "Выбор Когда &АбсолютнаяВеличинаМакс Тогда Выбор Когда &МаксимальноеЗначение = 0 Тогда ИмяПоказателя Иначе &МаксимальноеЗначение Конец Иначе &МаксимальноеЗначение * &ЗначениеБазы * 0.01 Конец";
	
	ВыражениеДельта = "Выбор Когда Сумма(Выбор Когда &АбсолютнаяВеличинаМин Тогда ИмяПоказателя Иначе ИмяПоляДоля Конец) < &МинимальноеЗначение Тогда 
		|ВыражениеМинимальноеЗначение - Сумма(ИмяПоказателя)
		|Когда Сумма(Выбор Когда &АбсолютнаяВеличинаМакс Тогда Выбор Когда &МаксимальноеЗначение = 0 Тогда 0 Иначе ИмяПоказателя Конец Иначе ИмяПоляДоля Конец) > &МаксимальноеЗначение Тогда
		|Сумма(ИмяПоказателя) - ВыражениеМаксимальноеЗначение 
		|Иначе 0 
		|Конец";
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "ВыражениеМинимальноеЗначение", 	ВыражениеМинимальноеЗначение);
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "ВыражениеМаксимальноеЗначение", ВыражениеМаксимальноеЗначение);
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "ИмяПоказателя", 				ПараметрыПоказателя.ПутьКДанным);
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "ИмяПоляДоля", 					ПараметрыПоказателя.ИмяПоляДоля);
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "&АбсолютнаяВеличинаМин", 		"ПараметрыДанных.АбсолютнаяВеличинаМин");
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "&АбсолютнаяВеличинаМакс", 		"ПараметрыДанных.АбсолютнаяВеличинаМакс");
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "&МинимальноеЗначение", 			"ПараметрыДанных.МинимальноеЗначение");
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "&МаксимальноеЗначение", 		"ПараметрыДанных.МаксимальноеЗначение");
	ВыражениеДельта = СтрЗаменить(ВыражениеДельта, "&ЗначениеБазы", 				"ПараметрыДанных.ЗначениеБазы");
	
	ПользовательскоеПолеДельта = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	ПользовательскоеПолеДельта.Заголовок = "Дельта";
	ПользовательскоеПолеДельта.УстановитьВыражения("", ВыражениеДельта);
	
	ВыражениеМаксимальныйЛимит = "Выразить(Выбор Когда &АбсолютнаяВеличинаМакс И &МаксимальноеЗначение = 0 Тогда &ЗначениеБазы Когда &АбсолютнаяВеличинаМакс Тогда &МаксимальноеЗначение Иначе &МаксимальноеЗначение * &ЗначениеБазы * 0.01 Конец, ""Число(19,2)"")";
	ПользовательскоеПолеМаксимальныйЛимит = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	ПользовательскоеПолеМаксимальныйЛимит.Заголовок = "Максимальный лимит";
	ПользовательскоеПолеМаксимальныйЛимит.УстановитьВыражения("", ВыражениеМаксимальныйЛимит);
	
	//ВыражениеСвободныйЛимит = "Выразить(&МаксимальноеЗначение * Выбор Когда &АбсолютнаяВеличинаМакс Тогда 1 Иначе &ЗначениеБазы * 0.01 Конец - ИмяПоказателя, ""Число(19,2)"")";
	ВыражениеСвободныйЛимит = "Вычислить(""Выразить(Выбор Когда &АбсолютнаяВеличинаМакс И &МаксимальноеЗначение = 0 Тогда &ЗначениеБазы Когда &АбсолютнаяВеличинаМакс Тогда &МаксимальноеЗначение Иначе &МаксимальноеЗначение * &ЗначениеБазы * 0.01 Конец - ИмяПоказателя, """"Число(19,2)"""")"", ""ВерхнийУровень"")";
	ВыражениеСвободныйЛимит = СтрЗаменить(ВыражениеСвободныйЛимит, "ИмяПоказателя", ПараметрыПоказателя.ПутьКДанным);
	ПользовательскоеПолеСвободныйЛимит = НастройкаОтчета.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	ПользовательскоеПолеСвободныйЛимит.Заголовок = "Свободный лимит";
	ПользовательскоеПолеСвободныйЛимит.УстановитьВыражения("", ВыражениеСвободныйЛимит);
	
	#Область ПараметрыДанных
		
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("МинимальноеЗначение", 		МинимальноеЗначение);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("МаксимальноеЗначение", 	МаксимальноеЗначение);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("ЦелевоеЗначение", 			СтрокаПоказателей.ЦелевоеЗначение);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаМин", 	СтрокаПоказателей.АбсолютнаяВеличинаМин);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаМакс", 	СтрокаПоказателей.АбсолютнаяВеличинаМакс);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("АбсолютнаяВеличинаЦель", 	СтрокаПоказателей.АбсолютнаяВеличинаЦель);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("ЗначениеБазы", 			ПараметрыБазиса.ЗначениеБазы);
	НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("КонтролируемыйПоказатель", ПараметрыПоказателя.Представление);
	
	Для каждого ПараметрФормирования Из ПараметрыБазиса.ПараметрыСКД Цикл
		Если Не НастройкаОтчета.ПараметрыДанных.Элементы.Найти(ПараметрФормирования.Ключ) = Неопределено Тогда
			НастройкаОтчета.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрФормирования.Ключ, ПараметрФормирования.Значение);
		КонецЕсли; 
	КонецЦикла;

	#КонецОбласти 
	
	// отборы
	Справочники.ИнвестиционныеДекларации.ЗаполнитьОтбор(НастройкаОтчета.Отбор, Настройки.Отбор, Истина, Параметры.УдалитьОтборПоБрокеру);
	
	// структура вложенный схемы отчета
	НоваяГруппировка = НастройкаОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	НоваяГруппировка.Имя = "ВерхнийУровень";
	ЕстьГруппировки = Ложь;
	
	ЭлементУО = НоваяГруппировка.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.ИспользоватьВОбщемИтоге 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУО.ИспользоватьВИерархическойГруппировке = ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУО.ИспользоватьВГруппировке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	
	ТипПоляГруппировки 	= Тип("ПолеГруппировкиКомпоновкиДанных");
	ТипВыбранногоПоля 	= Тип("ВыбранноеПолеКомпоновкиДанных");
	ВыбранныеПоля		= НастройкаОтчета.Выбор.Элементы;
	ТипДобавляемогоПоля = Неопределено;
	КоллекцияПолей 		= Неопределено;
	
	Если ПараметрыПоказателя.ГруппировкаСтруктуры <> "Служебные.ОбщийИтог" Тогда
	
		ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(ТипПоляГруппировки);
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ГруппировкаСтруктуры);
		ЕстьГруппировки = Истина;
		
	КонецЕсли;
	
	Если Не ЕстьГруппировки Тогда
	
		ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(ТипПоляГруппировки);
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Служебные.ОбщийИтог");
		ЭлементУО.ИспользоватьВОбщемИтоге 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
		
	КонецЕсли; 
	
	// детальные записи
	ДетальныеЗаписи = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ДетальныеЗаписи.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	ТипДобавляемогоПоля = ТипПоляГруппировки;
	ПоляГруппировки 	= ДетальныеЗаписи.ПоляГруппировки.Элементы;
	КоллекцияПолей 		= ПоляГруппировки;
	
	СтандартныеГруппировки = "Основные.ВидАктива;Основные.Эмитент;Основные.Актив;Основные.ДатаПоследнейПокупки;Основные.ДатаПоследнейПокупки;ЦенныеБумаги.Классификация;";
	
	Если СовокупныйКонтроль И ЭтоКлиентТрадиция Тогда
		// Традиция контролируется по 2м организациям
		СтандартныеГруппировки = СтандартныеГруппировки + "Служебные.Организация;Служебные.СчетДоверительногоУправления;Служебные.КодСчета;";
	ИначеЕсли СовокупныйКонтроль Тогда
		СтандартныеГруппировки = СтандартныеГруппировки + "Служебные.СчетДоверительногоУправления;";
	КонецЕсли; 
	
	Для каждого СтандартнаяГруппировка Из СтрРазделить(СтандартныеГруппировки, ";", Ложь) Цикл
		Если ПараметрыПоказателя.ГруппировкаСтруктуры <> СтандартнаяГруппировка Тогда
			ПолеГруппировки = КоллекцияПолей.Добавить(ТипДобавляемогоПоля);
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(СтандартнаяГруппировка);
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого ПользовательскоеПоле Из Настройки.ПользовательскиеПоля.Элементы Цикл
	
		ПользовательскоеПолеВыбор = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
		ПользовательскоеПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПоле.ПутьКДанным);
	
	КонецЦикла; 
		
	ПолеВыборМин = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборМин.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеМин.ПутьКДанным);
	ПолеВыборМин.Заголовок = "Минимальное значение" + ?(СтрокаПоказателей.АбсолютнаяВеличинаМин, "", " (%)");
	
	ПолеВыборПоказатель = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборПоказатель.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ПутьКДанным);
	
	ПолеВыборДоля = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборДоля.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ИмяПоляДоля);
	
	Если ТекущаяИД.ИспользоватьЦелевоеЗначение Тогда
		ПолеВыборЦель = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
		ПолеВыборЦель.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеЦель.ПутьКДанным);
		ПолеВыборЦель.Заголовок = "Целевое значение" + ?(СтрокаПоказателей.АбсолютнаяВеличинаЦель, "", " (%)");
	КонецЕсли;
		
	ПолеВыборМакс = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборМакс.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеМакс.ПутьКДанным);
	ПолеВыборМакс.Заголовок = "Максимальное значение" + ?(СтрокаПоказателей.АбсолютнаяВеличинаМакс, "", " (%)");
	
	ПолеВыборДельта = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборДельта.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеДельта.ПутьКДанным);
	ПолеВыборДельта.Заголовок = "Дельта (руб)";
	
	ПолеВыборМаксимальныйЛимит = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборМаксимальныйЛимит.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеМаксимальныйЛимит.ПутьКДанным);
	ПолеВыборМаксимальныйЛимит.Заголовок = "Максимальный лимит (руб)";
	
	ПолеВыборСвободныйЛимит = НастройкаОтчета.Выбор.Элементы.Добавить(ТипВыбранногоПоля);
	ПолеВыборСвободныйЛимит.Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеСвободныйЛимит.ПутьКДанным);
	ПолеВыборСвободныйЛимит.Заголовок = "Свободный лимит (руб)";
	
	ДобавленныеПоляСтрока = СтандартныеГруппировки + ПараметрыПоказателя.ПутьКДанным + ";" + ПараметрыПоказателя.ИмяПоляДоля;
	ДобавленныеПоля = СтрРазделить(ДобавленныеПоляСтрока, ";", Ложь);
	
	СписокИсключений = "Рейтинги.Источник;Рейтинги.ИсточникДоп";
	
	ВидыАктивов = Новый Массив;
	
	ДобавитьПоляИзОтбора(Настройки.Отбор.Элементы, ДобавленныеПоля, КоллекцияПолей, ПараметрыБазиса, СтрРазделить(СписокИсключений, ";", Ложь), ТипДобавляемогоПоля, ВидыАктивов);
	
	ДобавленныеСвязанныеПоля = Новый Массив;
		
	Для каждого ДобавленноеПоле Из ДобавленныеПоля Цикл
			
		Если ДобавленноеПоле = "Основные.ВидАктива" Тогда
			НайденныеСтроки = Новый Массив;
			Для каждого ВидАктива Из ВидыАктивов Цикл
				Для каждого НайденнаяСтрока Из ПараметрыБазиса.ТаблицаСвязанныхПолей.НайтиСтроки(Новый Структура("ВидСвязи, Источник", Истина, ВидАктива)) Цикл
					НайденныеСтроки.Добавить(НайденнаяСтрока);
				КонецЦикла;
			КонецЦикла; 
		Иначе
			НайденныеСтроки = ПараметрыБазиса.ТаблицаСвязанныхПолей.НайтиСтроки(Новый Структура("ВидСвязи, Источник", Ложь, ДобавленноеПоле));
		КонецЕсли;
		
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			ОписаниеПоля = ПараметрыБазиса.ТаблицаПолей.Найти(НайденнаяСтрока.Приемник, "ПутьКДанным");
			Если ОписаниеПоля <> Неопределено Тогда
			
				Если ОписаниеПоля.Ресурс Тогда
					ТипДобавляемогоСвязанногоПоля = ТипВыбранногоПоля;
					КоллекцияСвязанныхПолей = ВыбранныеПоля;
				Иначе
					ТипДобавляемогоСвязанногоПоля = ТипДобавляемогоПоля;
					КоллекцияСвязанныхПолей = КоллекцияПолей;
				КонецЕсли; 
			
				Если ДобавленныеСвязанныеПоля.Найти(НайденнаяСтрока.Приемник) = Неопределено 
					И ДобавленныеПоля.Найти(НайденнаяСтрока.Приемник) = Неопределено 
					И ПараметрыПоказателя.ГруппировкаСтруктуры <> НайденнаяСтрока.Приемник Тогда
					
					ПолеВыбор = КоллекцияСвязанныхПолей.Добавить(ТипДобавляемогоСвязанногоПоля);
					ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(НайденнаяСтрока.Приемник);
					ДобавленныеСвязанныеПоля.Добавить(НайденнаяСтрока.Приемник);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла; 
	
	// оформление результата проверки
	ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РезультатПроверки");
	ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУО.ПравоеЗначение = Ложь;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	ЭлементУО.ИспользоватьВЗаголовке 		= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУО.ИспользоватьВЗаголовкеПолей 	= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУО.ИспользоватьВОтборе 			= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУО.ИспользоватьВПараметрах 		= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	
	// оформление ОтстутствуетЦенаПереоценки
	ЭлементУООтстутствуетЦенаПереоценки = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();

	ОтборУООтстутствуетЦенаПереоценки = ЭлементУООтстутствуетЦенаПереоценки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУООтстутствуетЦенаПереоценки.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ОтсутствуетСтоимостьПереоценки");
	ОтборУООтстутствуетЦенаПереоценки.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ОтборУООтстутствуетЦенаПереоценки.ПравоеЗначение 	= Истина;
	
	ЭлементУООтстутствуетЦенаПереоценки.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВИерархическойГруппировке 	= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВГруппировке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВЗаголовке 					= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВЗаголовкеПолей 			= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВОтборе 					= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУООтстутствуетЦенаПереоценки.ИспользоватьВПараметрах 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	
	ЭлементУООтстутствуетЦенаПереоценки.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ОтсутствуетСтоимостьПереоценки");
	
	// оформление минимального и максимального значений
	ЭлементУОДоля = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();
	ЭлементУОДоля.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=4; ЧН=0,00");
	ЭлементУОДоля.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ДоляСумма");
	
	ЭлементУОЗначениеМин = НоваяГруппировка.УсловноеОформление.Элементы.Добавить();
	ЭлементУОЗначениеМин.Оформление.УстановитьЗначениеПараметра("Формат", ФорматнаяСтрока);
	ЭлементУОЗначениеМин.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеМин.ПутьКДанным);
	
	ЭлементУОЗначениеМакс = НоваяГруппировка.УсловноеОформление.Элементы.Добавить();
	ЭлементУОЗначениеМакс.Оформление.УстановитьЗначениеПараметра("Формат", ФорматнаяСтрокаМакс);
	ЭлементУОЗначениеМакс.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ПользовательскоеПолеМакс.ПутьКДанным);
	
	// оформление ПогашениеКупона
	ЭлементУОПогашениеКупона = НастройкаОтчета.УсловноеОформление.Элементы.Добавить();

	ОтборУОПогашениеКупона = ЭлементУОПогашениеКупона.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУОПогашениеКупона.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ДатаПогашенияКупона");
	ОтборУОПогашениеКупона.ВидСравнения 	= ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ОтборУОПогашениеКупона.ПравоеЗначение 	= Параметры.ПлюсТриРабочихДня; // !хардкод 
	
	ОтборУОПогашениеКупона = ЭлементУОПогашениеКупона.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУОПогашениеКупона.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Основные.ВидАктива");
	ОтборУОПогашениеКупона.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ОтборУОПогашениеКупона.ПравоеЗначение 	= "Облигации";
	
	ЭлементУОПогашениеКупона.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоГрифельноСиний);
	
	ЭлементУОПогашениеКупона.ИспользоватьВИерархическойГруппировке 	= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУОПогашениеКупона.ИспользоватьВГруппировке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.Использовать;
	ЭлементУОПогашениеКупона.ИспользоватьВЗаголовке 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВЗаголовкеПолей 			= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВОтборе 					= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	ЭлементУОПогашениеКупона.ИспользоватьВПараметрах 				= ИспользованиеУсловногоОформленияКомпоновкиДанных.НеИспользовать;
	
	// сортировка
	НомерСтроки = 0;
	Пока НомерСтроки < 5 Цикл
		
		ОписаниеПоля = ПараметрыБазиса.ТаблицаПолей[НомерСтроки];
		
		Порядок = НастройкаОтчета.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		Порядок.Поле = Новый ПолеКомпоновкиДанных(ОписаниеПоля.ПутьКДанным);
		
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла;

КонецПроцедуры

Функция СоздатьСводнуюТаблицуРезультатовКонтроля(СтруктураОтчета = Неопределено)
	
	СводнаяТаблицаРезультатовКонтроля = Неопределено;
	
	Если СтруктураОтчета = Неопределено Тогда
		СтруктураОтчета = Новый Структура;
	КонецЕсли; 
	
	Если Не СтруктураОтчета.Свойство("СводнаяТаблицаРезультатовКонтроля", СводнаяТаблицаРезультатовКонтроля) Тогда
		
		ТипДенежныеСуммы = Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;
		ОписаниеТиповНаборы = Новый Массив;
		ОписаниеТиповНаборы.Добавить(Тип("Строка"));
		ОписаниеТиповНаборы.Добавить(Тип("СправочникСсылка.НаборыИнвестиционныхДеклараций"));
		СводнаяТаблицаРезультатовКонтроля = Новый ТаблицаЗначений;
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("Клиент", 								Метаданные.ОпределяемыеТипы.КлиентыДоверительногоУправления.Тип);
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("ВидДоговораДоверительногоуправления", 	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
		//СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("СчетДоверительногоУправления", 			Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("СчетДоверительногоУправления", 			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024)));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("ИнвестиционнаяДекларация", 				Новый ОписаниеТипов("СправочникСсылка.ИнвестиционныеДекларации"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("Назначение", 							Новый ОписаниеТипов("ДокументСсылка.НазначениеИнвестиционнойДекларации"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("СовокупныйКонтроль", 					Новый ОписаниеТипов("Булево"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("Период", 								Новый ОписаниеТипов("Дата"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("Базис", 								Новый ОписаниеТипов("СправочникСсылка.БазисыКонтроляИнвестиционныхДеклараций"));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("Набор", 								Новый ОписаниеТипов(ОписаниеТиповНаборы, , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
		СводнаяТаблицаРезультатовКонтроля.Колонки.Добавить("ВнутреннийНабор", 						Новый ОписаниеТипов("Булево"));
