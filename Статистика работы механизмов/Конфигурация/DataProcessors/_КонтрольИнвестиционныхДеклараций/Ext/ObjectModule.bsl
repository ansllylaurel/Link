Функция ПолучитьРезультатПроверкиДерева(РезультатыДерево) Экспорт

	ПроверкаПройдена = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
	Нарушение = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("РезультатПроверки", 		ПроверкаПройдена);
	РезультатПроверки.Вставить("РезультатПроверкиВн", 		ПроверкаПройдена);
	РезультатПроверки.Вставить("НаборыНеПрошедшиеПроверку", Новый Массив);
		
	Для каждого СтрокаДерева Из РезультатыДерево.Строки Цикл
		Если СтрокаДерева.ИнвестиционнаяДекларация.Консолидирующая И СтрокаДерева.РезультатПроверки = ПроверкаПройдена Тогда
			РезультатПроверки = ПолучитьРезультатПроверкиДерева(СтрокаДерева);
		Иначе
			Если СтрокаДерева.РезультатПроверки <> ПроверкаПройдена Тогда
				
				// если еще не зафиксировали нарушение - заходим, в противном случае результат проверки обновлять не нужно, добавляем только наборы не прошедшие проверку
				Если СтрокаДерева.ВнутреннийНабор И РезультатПроверки.РезультатПроверкиВн <> Нарушение Тогда
					РезультатПроверки.РезультатПроверкиВн = СтрокаДерева.РезультатПроверки;
				ИначеЕсли Не СтрокаДерева.ВнутреннийНабор И РезультатПроверки.РезультатПроверки <> Нарушение Тогда 
					РезультатПроверки.РезультатПроверки = СтрокаДерева.РезультатПроверки;
				КонецЕсли; 
				
				СтрокаНабор = Новый Структура("Набор, Показатель, Мин, Значение, Макс", 
					Строка(СтрокаДерева.УсловияОтбора) + ?(СтрокаДерева.ВнутреннийНабор, " (внутр.)", ""),
					СтрокаДерева.КонтролируемыйПоказатель,
					Строка(СтрокаДерева.МинимальноеЗначение) + ?(СтрокаДерева.АбсолютнаяВеличинаМин, "", "%"),
					?(СтрокаДерева.ГруппаРезультатов, "{...}", Строка(СтрокаДерева.Сумма) + " (" + СтрокаДерева.Доля + "%)"),
					Строка(СтрокаДерева.МаксимальноеЗначение) + ?(СтрокаДерева.АбсолютнаяВеличинаМакс, "", "%"));
					
				РезультатПроверки.НаборыНеПрошедшиеПроверку.Добавить(СтрокаНабор);
				
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат РезультатПроверки;

КонецФункции

Функция ПолучитьСоставСовокупнойИнвестДекларации(СчетДоверительногоУправления, ИнвестиционнаяДекларация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ИнвестиционнаяДекларация", ИнвестиционнаяДекларация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Включен,
		|	СправочникСчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СправочникСчетаДоверительногоУправления.Организация КАК Организация,
		|	СправочникСчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
		|	СправочникСчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СправочникСчетаДоверительногоУправления.Представление КАК СчетДоверительногоУправленияПредставление,
		|	СправочникСчетаДоверительногоУправления.Организация.Представление КАК ОрганизацияПредставление,
		|	ИнвестиционныеДекларации.Ссылка КАК ИнвестиционнаяДекларация,
		|	ИнвестиционныеДекларации.ТипИнвестиционнойДекларации КАК ТипИнвестиционнойДекларации,
		|	3 КАК ПорядокКонтроля,
		|	ЛОЖЬ КАК СовокупныйКонтроль,
		|	ИнвестиционныеДекларации.Наименование + (ВЫРАЗИТЬ(ИнвестиционныеДекларации.Комментарий КАК СТРОКА(1024))) КАК ИнвестиционнаяДекларацияПредставление,
		|	ЗНАЧЕНИЕ(Документ.НазначениеИнвестиционнойДекларации.ПустаяСсылка) КАК Назначение
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СправочникСчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
		|		ПО (ИнвестиционныеДекларации.Ссылка = &ИнвестиционнаяДекларация)
		|			И (СправочникСчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления)";
		
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьГиперссылкуНаРезультатПроверки(СсылкаИБ, ИдентификаторРезультата)

	Ключ = РегистрыСведений.ХранилищеЗначений.СоздатьКлючЗаписи(Новый Структура("Идентификатор", ИдентификаторРезультата));
	Ссылка = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(Ключ);
	
	Возврат "<A href=""" + Ссылка + """>" + ИдентификаторРезультата + "</A>";

КонецФункции

#КонецОбласти 

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(Параметры)
	
	СтрСохраняемыеДанные = "Период,Организация,Клиент,ВидДоговораДоверительногоУправления,СчетДоверительногоУправления,ИнвестиционнаяДекларация,СовокупнаяИнвестДекларация,УчитыватьПлановыеОперации,ДинамическийРасчетСтоимости,СоставСовокупнойИнвестДекларации";
	ПараметрыОтчета = Новый Структура(СтрСохраняемыеДанные);
	ЗаполнитьЗначенияСвойств(ПараметрыОтчета, Параметры);
	
	ПараметрыОтчета.Вставить("Версия", СведенияОВнешнейОбработке().Версия);
	
	Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = Сеанс.ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание <> Неопределено Тогда
		ПараметрыОтчета.Вставить("НомерСеанса", Сеанс.НомерСеанса);
		ПараметрыОтчета.Вставить("УИД_Задания", ФоновоеЗадание.УникальныйИдентификатор);
		ПараметрыОтчета.Вставить("УИД_ХранилищаЗначений", Параметры.ИдентификаторРезультата);
	КонецЕсли;
	
	Описание = "";
	
	Для каждого Параметр Из ПараметрыОтчета Цикл
	
		Описание = Описание + Символы.ПС + Параметр.Ключ + ": " + Параметр.Значение;
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции

Функция ПолучитьПредставлениеСтрокиПретрейда(Параметры) Экспорт

	Если Параметры.ВидАктива = "Ценные бумаги" Тогда
		
		Если Параметры.ВидОперации = 0 И Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Ввод ЦБ";
		ИначеЕсли Параметры.ВидОперации = 0 И Параметры.Сумма < 0 Тогда 
			ПредставлениеОперации = "Вывод ЦБ";
		ИначеЕсли Параметры.ВидОперации = 1 И Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Покупка ЦБ" + " / " + СокрЛП(Параметры.БрокерРасчетныйСчет);
		ИначеЕсли Параметры.ВидОперации = 1 И Параметры.Сумма < 0 Тогда 
			ПредставлениеОперации = "Продажа ЦБ" + " / " + СокрЛП(Параметры.БрокерРасчетныйСчет);
		Иначе
			ПредставлениеОперации = "Проверьте корректность введенных данных";
		КонецЕсли;
		
		Если Параметры.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
			ПредставлениеЦены = Строка(Параметры.Количество) + " * (" + Формат(Параметры.Цена, "ЧДЦ=2; ЧН=0,00") + " + " + Формат(Параметры.Купон, "ЧДЦ=2; ЧН=0,00") + ")";
		Иначе
			ПредставлениеЦены = Строка(Параметры.Количество) + " * " + Формат(Параметры.Цена, "ЧДЦ=2; ЧН=0,00");
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Параметры.Дюрация) Тогда
			ПредставлениеДюрации = ", Дюрация: " + Формат(Параметры.Дюрация, "ЧГ=0");
		Иначе
			ПредставлениеДюрации = "";
		КонецЕсли;
		
		Представление = ПредставлениеОперации + " / " + Параметры.ЦеннаяБумага
			 + ПредставлениеДюрации + " " + Параметры.Классификация + ": " + ПредставлениеЦены;
		
	ИначеЕсли Параметры.ВидАктива = "Депозиты" Тогда 
			
		Если Параметры.Сумма > 0 И Параметры.СуммаДС = 0 Тогда
			ПредставлениеОперации = "Ввод депозита";
			БрокерРасчетныйСчет = "";
		ИначеЕсли Параметры.Сумма < 0 И Параметры.СуммаДС = 0 Тогда
			ПредставлениеОперации = "Вывод депозита";
			БрокерРасчетныйСчет = "";
		ИначеЕсли Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Размещение ДС на депозите";
			БрокерРасчетныйСчет = " / " + СокрЛП(Параметры.БрокерРасчетныйСчет);
		ИначеЕсли Параметры.Сумма < 0 Тогда
			ПредставлениеОперации = "Закрытие депозита";
			БрокерРасчетныйСчет = " / " + СокрЛП(Параметры.БрокерРасчетныйСчет);
		Иначе
			ПредставлениеОперации = "Проверьте корректность введенных данных";	
		КонецЕсли; 
		
		ПредставлениеДепозита = ?(Параметры.ЭтоПретрейд, СокрЛП(Параметры.ЮрФизЛицо) + " / " + Параметры.Валюта, Параметры.Депозит);
		Представление = ПредставлениеОперации + БрокерРасчетныйСчет + " / " + ПредставлениеДепозита;
		
	ИначеЕсли Параметры.ВидАктива = "Денежные средства" Тогда
		
		Если Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Ввод ДС";
		Иначе
			ПредставлениеОперации = "Вывод ДС";
		КонецЕсли; 
		Представление = ПредставлениеОперации + " / " + Параметры.БрокерРасчетныйСчет + " / " + Параметры.Валюта;
		
	ИначеЕсли Параметры.ВидАктива = "Дебиторская задолженность" Тогда
		
		Если Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Увеличение ДЗ";
		Иначе
			ПредставлениеОперации = "Уменьшение ДЗ";
		КонецЕсли; 
		
		Представление = ПредставлениеОперации + " / " + СокрЛП(Параметры.ЮрФизЛицо);
		
	ИначеЕсли Параметры.ВидАктива = "Кредиторская задолженность" Тогда
		
		Если Параметры.Сумма > 0 Тогда
			ПредставлениеОперации = "Увеличение КЗ";
		Иначе
			ПредставлениеОперации = "Уменьшение КЗ";
		КонецЕсли; 
		
		Представление = ПредставлениеОперации + " / " + СокрЛП(Параметры.ЮрФизЛицо);
		
	КонецЕсли;
	
	Возврат Представление;

КонецФункции

Функция ПолучитьТаблицуПретрейдаПоРаспоряжениям(ПараметрыЗаполнения) Экспорт
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СоставСовокупнойИнвестДекларации.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	&СоставСовокупнойИнвестДекларации КАК СоставСовокупнойИнвестДекларации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДокументПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументПоручениеНаПереводДенежныхСредств.Ссылка КАК Поручение,
		|	ПереводДенежныхСредств.Ссылка КАК Перевод,
		|	ДокументПоручениеНаПереводДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументПоручениеНаПереводДенежныхСредств.Брокер КАК Брокер,
		|	ДокументПоручениеНаПереводДенежныхСредств.Валюта КАК Валюта,
		|	ДокументПоручениеНаПереводДенежныхСредств.Сумма КАК Сумма,
		|	ДокументПоручениеНаПереводДенежныхСредств.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	ДокументПоручениеНаПереводДенежныхСредств.БрокерПолучатель КАК БрокерПолучатель
		|ПОМЕСТИТЬ _ПорученияНаПеревод
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаПереводДенежныхСредств КАК ДокументПоручениеНаПереводДенежныхСредств
		|		ПО (ДокументПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|			И (НАЧАЛОПЕРИОДА(ДокументПоручениеНаПереводДенежныхСредств.Дата, ДЕНЬ) = &Период)
		|			И (ДокументПоручениеНаПереводДенежныхСредств.Организация = &Организация)
		|			И (НЕ ДокументПоручениеНаПереводДенежныхСредств.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО (ДокументПоручениеНаПереводДенежныхСредств.Ссылка = ПереводДенежныхСредств.Основание)
		|			И (ПереводДенежныхСредств.Проведен)
		|ГДЕ
		|	ПереводДенежныхСредств.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.Ссылка КАК Распоряжение,
		|	РазмещениеКредитногоИнструмента.Ссылка КАК Размещение,
		|	""Депозиты"" КАК ВидАктива,
		|	1 КАК ВидОперации,
		|	Распоряжение.Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.Сумма КАК Сумма,
		|	-Распоряжение.Сумма КАК СуммаДС,
		|	Распоряжение.ДатаВозврата КАК ДатаПогашенияДепозита,
		|	Распоряжение.РасчетныйСчет КАК БрокерРасчетныйСчет,
		|	1 КАК ЭтоПретрейд
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Распоряжение КАК Распоряжение
		|		ПО (Распоряжение.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|			И (Распоряжение.ДатаРазмещения = &Период)
		|			И (Распоряжение.Организация = &Организация)
		|			И (НЕ Распоряжение.ПометкаУдаления)
		|			И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
		|		ПО (РазмещениеКредитногоИнструмента.Основание = Распоряжение.Ссылка)
		|			И (РазмещениеКредитногоИнструмента.Проведен)
		|ГДЕ
		|	РазмещениеКредитногоИнструмента.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПорученияНаПеревод.СчетДоверительногоУправления,
		|	_ПорученияНаПеревод.Поручение,
		|	_ПорученияНаПеревод.Перевод,
		|	""Денежные средства"",
		|	1,
		|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка),
		|	_ПорученияНаПеревод.Валюта,
		|	-_ПорученияНаПеревод.Сумма,
		|	0,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ВЫБОР
		|		КОГДА _ПорученияНаПеревод.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА _ПорученияНаПеревод.РасчетныйСчет
		|		ИНАЧЕ _ПорученияНаПеревод.Брокер
		|	КОНЕЦ,
		|	1
		|ИЗ
		|	_ПорученияНаПеревод КАК _ПорученияНаПеревод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПорученияНаПеревод.СчетДоверительногоУправления,
		|	_ПорученияНаПеревод.Поручение,
		|	_ПорученияНаПеревод.Перевод,
		|	""Денежные средства"",
		|	1,
		|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка),
		|	_ПорученияНаПеревод.Валюта,
		|	_ПорученияНаПеревод.Сумма,
		|	0,
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ВЫБОР
		|		КОГДА _ПорученияНаПеревод.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА _ПорученияНаПеревод.РасчетныйСчетПолучатель
		|		ИНАЧЕ _ПорученияНаПеревод.БрокерПолучатель
		|	КОНЕЦ,
		|	1
		|ИЗ
		|	_ПорученияНаПеревод КАК _ПорученияНаПеревод";		
	#КонецОбласти
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СоставСовокупнойИнвестДекларации", ПараметрыЗаполнения.СоставСовокупнойИнвестДекларации);
	Запрос.УстановитьПараметр("Период", ПараметрыЗаполнения.Период);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполнения.Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТаблицаПретрейда = ЭтотОбъект.Претрейд.ВыгрузитьКолонки();
	ТаблицаПретрейда.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПретрейда.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Представление = ПолучитьПредставлениеСтрокиПретрейда(НоваяСтрока);
	КонецЦикла;
	
	Возврат ТаблицаПретрейда;
	
КонецФункции

Процедура ПроверитьНастройкиПоСчетамДУ(ТаблицаСчетов) Экспорт

	Для каждого СтрокаТаблицаСчетов Из ТаблицаСчетов Цикл
	
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
			СтрокаТаблицаСчетов.Дата, 
			СтрокаТаблицаСчетов.Организация, 
			СтрокаТаблицаСчетов.СчетДоверительногоУправления, 
			Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, 
			Истина);
			
		Отказ = Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости);
			
		Если Не Отказ Тогда
		
			НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
				СтрокаТаблицаСчетов.Дата, 
				СтрокаТаблицаСчетов.Организация, 
				СтрокаТаблицаСчетов.СчетДоверительногоУправления, 
				НастройкиОценки.ВидУчетаДляОстатковПартий, 
				Отказ);
				
			Если Не Отказ Тогда
				
				НастройкиФормированияСЧА = РегистрыСведений.НастройкиФормированияСЧА.ОпределитьНастройки(
					СтрокаТаблицаСчетов.Дата,
					СтрокаТаблицаСчетов.Организация,
					СтрокаТаблицаСчетов.СчетДоверительногоУправления, 
					Отказ);
				
			КонецЕсли;
		
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По договору '" + СтрокаТаблицаСчетов.СчетДоверительногоУправления 
				+ "' отсутствуют настройки для цели расчета 'Оценка объектов в управлении'!");	
		КонецЕсли;
		
		СтрокаТаблицаСчетов.Включен = Не Отказ;
	
	КонецЦикла;

КонецПроцедуры