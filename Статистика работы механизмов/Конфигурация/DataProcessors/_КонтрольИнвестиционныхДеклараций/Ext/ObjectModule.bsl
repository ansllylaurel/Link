// Процедура - Выполнить групповой контроль фоново
//	Вызывается при выполнении группового контроля в фоновом задании. Создает подчиненные фоновые задания 
//  для каждой строки состава группового контроля
// Параметры:
//  ПараметрыВыполнения	 - Структура - все необходимые для выполнения контроля параметры
//  АдресХранилища		 - Строка - адрес временного хранилища, в которое будет
//                          	 помещен результат работы задания
//
Процедура ВыполнитьГрупповойКонтрольФоново(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Если ПараметрыВыполнения.Свойство("МаксимумАктивныхЗаданий") Тогда
		МаксимумАктивныхЗаданий = ПараметрыВыполнения.МаксимумАктивныхЗаданий;
	Иначе
		МаксимумАктивныхЗаданий = 2;
	КонецЕсли; 
	
	НаименованиеЗадания = ПараметрыВыполнения.НаименованиеЗадания;
	
	ПараметрыВыполнения.СоставГрупповогоКонтроля.Колонки.Добавить("ИдентификаторЗадания", Новый ОписаниеТипов("УникальныйИдентификатор"));
	СсылкаНаОбработку = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_КонтрольИнвестиционныхДеклараций");
	
	Если СсылкаНаОбработку = Неопределено Тогда
		ВызватьИсключение "Не удалось найти обработку ""Контроль инвестиционных деклараций""";
	КонецЕсли; 
	
	Для каждого СтрокаСоставГрупповогоКонтроля Из ПараметрыВыполнения.СоставГрупповогоКонтроля Цикл
	
		ПроверитьКоличествоАктивныхЗаданий(НаименованиеЗадания, МаксимумАктивныхЗаданий, 1);
		
		ПараметрыКонтроля = Новый Структура("Период, Организация, Клиент, ВидДоговораДОверительногоУправления, СчетДоверительногоУправления, 
				|ИнвестиционнаяДекларация, УчитыватьПлановыеОперации, СовокупнаяИнвестДекларация, ДинамическийРасчетСтоимости, ИдентификаторРезультата");
		ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, ПараметрыВыполнения);
		ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, СтрокаСоставГрупповогоКонтроля);
		
		ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации", ПараметрыВыполнения.СоставыСовокупныхИД.Скопировать(Новый Структура("ИдентификаторРезультата", СтрокаСоставГрупповогоКонтроля.ИдентификаторРезультата)));
		
		ПараметрыКонтроля.СовокупнаяИнвестДекларация = ПараметрыКонтроля.СоставСовокупнойИнвестДекларации.Количество() > 1;
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
		
		Если Лев(ЭтотОбъект.ИспользуемоеИмяФайла, 18) = "e1cib\tempstorage\" Тогда
			ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", СсылкаНаОбработку);
			ПараметрыМетода.Вставить("ИмяОбработки", "_КонтрольИнвестиционныхДеклараций");
		Иначе
			ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", Неопределено);
			ПараметрыМетода.Вставить("ИмяОбработки", ЭтотОбъект.ИспользуемоеИмяФайла);
		КонецЕсли; 
		
		ПараметрыМетода.Вставить("ИмяМетода", "ПроверитьИнвестДекларациюВФоне");
		ПараметрыМетода.Вставить("ПараметрыВыполнения", ПараметрыКонтроля);
		
		НовоеЗадание = РаботаСДлительнымиОперациями.ЗапуститьВыполнениеВФоне(
			ПараметрыВыполнения.УниакльныйИдентификаторФормы,
			"РаботаСДлительнымиОперациями.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыМетода,
			НаименованиеЗадания,
			Ложь,
			Ложь
		);
		
		СтрокаСоставГрупповогоКонтроля.ИдентификаторЗадания = НовоеЗадание.ИдентификаторЗадания;
		
	КонецЦикла; 
	
	// ждем завершения всех запущенных заданий
	ПроверитьКоличествоАктивныхЗаданий(НаименованиеЗадания, 1, 1);
	
	Для каждого СтрокаСоставГрупповогоКонтроля Из ПараметрыВыполнения.СоставГрупповогоКонтроля Цикл
	
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(СтрокаСоставГрупповогоКонтроля.ИдентификаторЗадания);
		
		Если ФоновоеЗадание = Неопределено Тогда
			
			// так бывает при переполнении истории фоновых заданий
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = СтрокаСоставГрупповогоКонтроля.ИдентификаторРезультата;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				// все ОК, задание отработало и сохранило результат
			Иначе
				// записи нет. Вероятно, задание завершено с ошибкой
				Запись.ХранилищеЗначения 			= Новый ХранилищеЗначения(Строка(СостояниеФоновогоЗадания.ЗавершеноАварийно), Новый СжатиеДанных(9));
				Запись.Источник 					= "_КонтрольИнвестиционныхДеклараций";
				Запись.Организация 					= ПараметрыВыполнения.Организация;
				Запись.СчетДоверительногоУправления	= СтрокаСоставГрупповогоКонтроля.СчетДоверительногоУправления;
				Запись.Ответственный				= РаботаСПользователями.ТекущийПользователь();
				Запись.Записать();
			КонецЕсли; 
		
		ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		
			ДобавитьЗаписьВХранилищеЗначений(ПараметрыКонтроля.ИдентификаторРезультата, Строка(СостояниеФоновогоЗадания.ЗавершеноАварийно), СтрокаСоставГрупповогоКонтроля);
						
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры	

// Вызывается при групповом контроле из формы обработки
Процедура ПроверитьИнвестДекларациюВФоне(ПараметрыПроцедуры, АдресХранилища) Экспорт

	Если Не ПараметрыПроцедуры.Свойство("РезультатыПроверки") Тогда
		ПараметрыПроцедуры.Вставить("РезультатыПроверки", ПолучитьДеревоРезультата());
	КонецЕсли; 
	
	Если Не ПараметрыПроцедуры.Свойство("СоставСовокупнойИнвестДекларации") Тогда
		ПараметрыПроцедуры.Вставить("СоставСовокупнойИнвестДекларации", ПолучитьСоставСовокупнойИнвестДекларации(ПараметрыПроцедуры.СчетДоверительногоУправления, ПараметрыПроцедуры.ИнвестиционнаяДекларация));
	КонецЕсли;
	
	Если Не ПараметрыПроцедуры.Свойство("Претрейд") Тогда
		Если ПараметрыПроцедуры.УчитыватьПлановыеОперации Тогда
			ТаблицаПретрейда = ПолучитьТаблицуПретрейдаПоРаспоряжениям(ПараметрыПроцедуры);
		Иначе
			ТаблицаПретрейда = ЭтотОбъект.Претрейд.ВыгрузитьКолонки();
		КонецЕсли;
		ПараметрыПроцедуры.Вставить("Претрейд", ТаблицаПретрейда);
	КонецЕсли;
	
	ПараметрыПроцедуры.Вставить("Механизм", "_КонтрольИнвестиционныхДеклараций.ГрупповойКонтрольВФоне");
	
	ПроверитьИнвестДекларацию(ПараметрыПроцедуры, ПараметрыПроцедуры.РезультатыПроверки.Строки);
	
	Если ПараметрыПроцедуры.Свойство("ТекстОшибки") Тогда
	
		РезультатПроверки = ПараметрыПроцедуры.ТекстОшибки;
		
	Иначе
		
		ОшибкиОценки = Ложь;
		МассивТаблиц = СтрРазделить(СтрЗаменить("ТаблицаРасхожденийЦен, ТаблицаОшибокОценки, РасхожденияСтоимостейЦенныхБумаг, РасхожденияСтоимостейАктивов, ТаблицаЦенТМинус2, ТаблицаОшибокСафмар", " ", ""), ",", Ложь); 
		СтруктураОтчетов = ПараметрыПроцедуры.Отчеты.Получить();
		Для каждого ИмяТаблицы Из МассивТаблиц Цикл
			Если СтруктураОтчетов.Свойство(ИмяТаблицы) И ТипЗнч(СтруктураОтчетов[ИмяТаблицы]) = Тип("ТаблицаЗначений") И СтруктураОтчетов[ИмяТаблицы].Количество() > 0 Тогда
				ОшибкиОценки = Истина;
				Прервать;
			КонецЕсли; 
		КонецЦикла;
		
		РезультатПроверки = ПолучитьСтруктуруРезультатаПроверки(ПараметрыПроцедуры, ОшибкиОценки, ПолучитьРезультатПроверкиДерева(ПараметрыПроцедуры.РезультатыПроверки));
		РезультатПроверки.Вставить("ИспользованыПредварительныеЦены", ПараметрыПроцедуры.Свойство("ИспользованыПредварительныеЦены"));
		
		Если ПараметрыПроцедуры.Свойство("ДатаМаксДД") Тогда
			РезультатПроверки.Вставить("ДатаМаксДД", ПараметрыПроцедуры.ДатаМаксДД);
		КонецЕсли;
		
	КонецЕсли; 
	
	ДобавитьЗаписьВХранилищеЗначений(ПараметрыПроцедуры.ИдентификаторРезультата, РезультатПроверки, ПараметрыПроцедуры);
	
КонецПроцедуры

