#Область Общие_процедуры_и_функции_автоматического_контроля

Функция ВыполнитьГрупповойКонтроль(ВыборкаСчетовДУ, ПараметрыГрупповогоКонтроля)

	ОбщиеПараметры = Новый Структура;
	ОбщиеПараметры.Вставить("Механизм",						"_КонтрольИнвестиционныхДеклараций." + ПараметрыГрупповогоКонтроля.Метод);
	ОбщиеПараметры.Вставить("УчитыватьПлановыеОперации", 	ПараметрыГрупповогоКонтроля.УчитыватьПлановыеОперации);
	ОбщиеПараметры.Вставить("ДинамическийРасчетСтоимости",	Ложь);
	ОбщиеПараметры.Вставить("Претрейд", 					ЭтотОбъект.Претрейд.Выгрузить());
	ОбщиеПараметры.Вставить("ФиксироватьТолькоНарушения",	ПараметрыГрупповогоКонтроля.ФиксироватьТолькоНарушения);
	ОбщиеПараметры.Вставить("УдалитьОтборПоБрокеру", 		ПараметрыГрупповогоКонтроля.УдалитьОтборПоБрокеру);
	
	СводнаяТаблицаРезультатовКонтроля = СоздатьСводнуюТаблицуРезультатовКонтроля();
	
	Пока ВыборкаСчетовДУ.Следующий() Цикл
	
		ПараметрыКонтроля = Новый Структура("Организация, Период, СчетДоверительногоУправления, ИнвестиционнаяДекларация, 
			|УчитыватьПлановыеОперации, ДинамическийРасчетСтоимости, Претрейд, ФиксироватьТолькоНарушения, УдалитьОтборПоБрокеру");
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, ВыборкаСчетовДУ);
		ЗаполнитьЗначенияСвойств(ПараметрыКонтроля, ОбщиеПараметры);
		
		Если ПараметрыГрупповогоКонтроля.Свойство("ИмяКолонкиИнвестиционнаяДекларация") Тогда
			// Получаем ИД из другой колонки
			ПараметрыКонтроля.Вставить("ИнвестиционнаяДекларация", ВыборкаСчетовДУ[ПараметрыГрупповогоКонтроля.ИмяКолонкиИнвестиционнаяДекларация]);
		КонецЕсли; 
		
		Если ПараметрыГрупповогоКонтроля.Свойство("ПараметрыПолученияТаблицыПлановыхОпераций") Тогда
			ПараметрыКонтроля.Вставить("ПараметрыПолученияТаблицыПлановыхОпераций", ПараметрыГрупповогоКонтроля.ПараметрыПолученияТаблицыПлановыхОпераций);
		Иначе
			ПараметрыКонтроля.Вставить("ПараметрыПолученияТаблицыПлановыхОпераций", 
				ПолучитьПараметрыПолученияТаблицыПлановыхОпераций(ВыборкаСчетовДУ.Период, ВыборкаСчетовДУ.Организация, ВыборкаСчетовДУ.СчетДоверительногоУправления));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыКонтроля.ИнвестиционнаяДекларация) Тогда
			
			СоставСовокупнойИнвестДекларации = ПолучитьСоставСовокупнойИнвестДекларации(ПараметрыКонтроля.СчетДоверительногоУправления, ПараметрыКонтроля.ИнвестиционнаяДекларация);
			СовокупныйКонтроль = СоставСовокупнойИнвестДекларации.НайтиСтроки(Новый Структура("СовокупныйКонтроль, СчетДоверительногоУправления", Истина, СчетДоверительногоУправления));
			СовокупнаяИнвестДекларация = СовокупныйКонтроль.Количество() > 0;
			
			ПараметрыКонтроля.Вставить("СоставСовокупнойИнвестДекларации",	СоставСовокупнойИнвестДекларации);
			ПараметрыКонтроля.Вставить("РезультатыПроверки", 				ПолучитьДеревоРезультата());
			ПараметрыКонтроля.Вставить("ИдентификаторРезультата",			Новый УникальныйИдентификатор);
			
			Попытка
				
				ПроверитьИнвестДекларацию(ПараметрыКонтроля, ПараметрыКонтроля.РезультатыПроверки.Строки);
				
				Если ПараметрыКонтроля.Свойство("ТекстОшибки") Тогда
					
					ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ПараметрыКонтроля.ТекстОшибки);
					
				Иначе
					
					#Область Ошибки_оценки
					
					ТаблицаОшибокОценки = Неопределено;
					СтруктураОтчетов = ПараметрыКонтроля.СтруктураОтчетов.Получить();
					Если ТипЗнч(СтруктураОтчетов) = Тип("Структура") Тогда
						СтруктураОтчетов.Свойство("ТаблицаОшибокОценки", ТаблицаОшибокОценки);
					КонецЕсли;
					ОшибкиОценки = Ложь;
					Если Не ТаблицаОшибокОценки = Неопределено И ТаблицаОшибокОценки.Количество() > 0 Тогда
						
						НоваяСтрока = СводнаяТаблицаРезультатовКонтроля.Добавить();
						СписокСвойств = "Клиент, ВидДоговораДоверительногоуправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация, Период, ИдентификаторРезультата";
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыКонтроля, СписокСвойств);
					    НоваяСтрока.Набор = "Не удалось определить стоимость ценных бумаг";
						НоваяСтрока.Группировка = "";
						НоваяСтрока.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля;
						НоваяСтрока.ОшибкиОценки = Истина;
						ОшибкиОценки = Истина;
					КонецЕсли;
					
					#КонецОбласти
					
					ТаблицаРезультатовКонтроля = ПараметрыКонтроля.СводнаяТаблицаРезультатовКонтроля.Получить();
					Для каждого Строка Из ТаблицаРезультатовКонтроля Цикл
						ЗаполнитьЗначенияСвойств(СводнаяТаблицаРезультатовКонтроля.Добавить(), Строка);
					КонецЦикла;
					
					РезультатПроверки = ПолучитьСтруктуруРезультатаПроверки(ПараметрыКонтроля, ОшибкиОценки, ПолучитьРезультатПроверкиДерева(ПараметрыКонтроля.РезультатыПроверки));
					СтруктураОтбора = Новый Структура("Организация, Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация");
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, СоставСовокупнойИнвестДекларации[0]);
					СтруктураОтбора.Вставить("СовокупнаяИнвестДекларация", СовокупнаяИнвестДекларация);
					ДобавитьЗаписьВХранилищеЗначений(ПараметрыКонтроля.ИдентификаторРезультата, РезультатПроверки, СтруктураОтбора);
					
				КонецЕсли;
				
			Исключение
				
				ТекстОшибки = "Ошибка выполнения контроля: " + ОписаниеОшибки();
				ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ТекстОшибки);
				
			КонецПопытки;
				
		Иначе
			
			ТекстОшибки = "Ошибка выполнения контроля: клиенту не назначена инвест. декларация";
			ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ТекстОшибки);
			
		КонецЕсли;			
	
	КонецЦикла;
	
	Возврат СводнаяТаблицаРезультатовКонтроля;
	
КонецФункции 

Процедура СформироватьИОтправитьТаблицуРезультатовКонтроля(СводнаяТаблицаРезультатовКонтроля, ПараметрыГрупповогоКонтроля)

	Если СводнаяТаблицаРезультатовКонтроля.Количество() > 0 Тогда
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СводнаяТаблицаРезультатовКонтроля, "_СводнаяТаблицаРезультатов", Запрос.МенеджерВременныхТаблиц);
		
		#Область Текст_запроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СводнаяТаблицаРезультатов.Клиент КАК Клиент,
			|	_СводнаяТаблицаРезультатов.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
			|	_СводнаяТаблицаРезультатов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_СводнаяТаблицаРезультатов.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
			|	ВЫБОР _СводнаяТаблицаРезультатов.ИнвестиционнаяДекларация.ТипИнвестиционнойДекларации
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЗаконодательныеОграничения)
			|			ТОГДА 1
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость)
			|			ТОГДА 2
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация)
			|			ТОГДА 3
			|	КОНЕЦ КАК ПорядокКонтроля,
			|	_СводнаяТаблицаРезультатов.Назначение КАК Назначение,
			|	_СводнаяТаблицаРезультатов.СовокупныйКонтроль КАК СовокупныйКонтроль,
			|	_СводнаяТаблицаРезультатов.Период КАК Период,
			|	_СводнаяТаблицаРезультатов.Набор КАК Набор,
			|	_СводнаяТаблицаРезультатов.ВнутреннийНабор КАК ВнутреннийНабор,
			|	_СводнаяТаблицаРезультатов.Группировка КАК Группировка,
			|	_СводнаяТаблицаРезультатов.РезультатПроверки КАК РезультатПроверки,
			|	_СводнаяТаблицаРезультатов.ОшибкиОценки КАК ОшибкиОценки,
			|	_СводнаяТаблицаРезультатов.ИдентификаторРезультата КАК ИдентификаторРезультата,
			|	_СводнаяТаблицаРезультатов.Показатель КАК Показатель,
			|	_СводнаяТаблицаРезультатов.МинимальноеЗначение КАК МинимальноеЗначение,
			|	_СводнаяТаблицаРезультатов.АбсолютнаяВеличинаМин КАК АбсолютнаяВеличинаМин,
			|	_СводнаяТаблицаРезультатов.МаксимальноеЗначение КАК МаксимальноеЗначение,
			|	_СводнаяТаблицаРезультатов.АбсолютнаяВеличинаМакс КАК АбсолютнаяВеличинаМакс,
			|	_СводнаяТаблицаРезультатов.Значение КАК Значение,
			|	_СводнаяТаблицаРезультатов.Доля КАК Доля,
			|	_СводнаяТаблицаРезультатов.МаксимальныйЛимит КАК МаксимальныйЛимит,
			|	_СводнаяТаблицаРезультатов.СвободныйЛимит КАК СвободныйЛимит,
			|	_СводнаяТаблицаРезультатов.ТекстОшибки КАК ТекстОшибки,
			|	_СводнаяТаблицаРезультатов.ОтборПоЭмитенту КАК ОтборПоЭмитенту,
			|	_СводнаяТаблицаРезультатов.ОтборПоЦеннойБумаге КАК ОтборПоЦеннойБумаге,
			|	_СводнаяТаблицаРезультатов.ДатаЗапретаПокупки КАК ДатаЗапретаПокупки,
			|	_СводнаяТаблицаРезультатов.РезультатПроверки <> ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена)
			|		И _СводнаяТаблицаРезультатов.ВнутреннийНабор КАК ЕстьВнутренниеНарушения,
			|	_СводнаяТаблицаРезультатов.РезультатПроверки <> ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена)
			|		И НЕ _СводнаяТаблицаРезультатов.ВнутреннийНабор КАК ЕстьНарушенияПоДоговору,
			|	ВЫБОР
			|		КОГДА _СводнаяТаблицаРезультатов.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля)
			|			ТОГДА 0
			|		КОГДА _СводнаяТаблицаРезультатов.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.Нарушение)
			|			ТОГДА 1
			|		КОГДА _СводнаяТаблицаРезультатов.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие)
			|			ТОГДА 2
			|		КОГДА _СводнаяТаблицаРезультатов.РезультатПроверки = ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена)
			|			ТОГДА 3
			|	КОНЕЦ КАК Порядок
			|ИЗ
			|	_СводнаяТаблицаРезультатов КАК _СводнаяТаблицаРезультатов
			|
			|УПОРЯДОЧИТЬ ПО
			|	Порядок,
			|	Клиент,
			|	ВидДоговораДоверительногоУправления,
			|	ПорядокКонтроля,
			|	СчетДоверительногоУправления,
			|	Период,
			|	ИнвестиционнаяДекларация,
			|	Набор,
			|	ОтборПоЭмитенту,
			|	ОтборПоЦеннойБумаге,
			|	ДатаЗапретаПокупки
			|ИТОГИ
			|	МАКСИМУМ(СчетДоверительногоУправления),
			|	МАКСИМУМ(СовокупныйКонтроль),
			|	МАКСИМУМ(Группировка),
			|	МАКСИМУМ(ОшибкиОценки),
			|	МАКСИМУМ(ИдентификаторРезультата),
			|	МАКСИМУМ(Показатель),
			|	МАКСИМУМ(ТекстОшибки),
			|	МАКСИМУМ(ЕстьВнутренниеНарушения),
			|	МАКСИМУМ(ЕстьНарушенияПоДоговору)
			|ПО
			|	РезультатПроверки,
			|	Клиент,
			|	ВидДоговораДоверительногоУправления,
			|	ПорядокКонтроля,
			|	Период,
			|	Назначение,
			|	ИнвестиционнаяДекларация,
			|	Набор,
			|	ОтборПоЭмитенту,
			|	ОтборПоЦеннойБумаге,
			|	ДатаЗапретаПокупки,
			|	ВнутреннийНабор
			|АВТОУПОРЯДОЧИВАНИЕ";			
		#КонецОбласти
		
		Результат = Запрос.Выполнить();
		ВыборкаРезультат = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		#Область Формирование_табличного_документа
		Макет = ПолучитьМакет("Макет");
		Шапка = Макет.ПолучитьОбласть("ШапкаРезультатовСводно");
		СтрокаКлиент 		= Макет.ПолучитьОбласть("СтрокаРезультатовСводноКлиент");
		СтрокаСчетДУ 		= Макет.ПолучитьОбласть("СтрокаРезультатовСводноСчетДУ");
		СтрокаСчетДУОшибка 	= Макет.ПолучитьОбласть("СтрокаРезультатовСводноСчетДУОшибка");
		СтрокаНабор 		= Макет.ПолучитьОбласть("СтрокаРезультатовСводноНабор");
		СтрокаНаборГруппа	= Макет.ПолучитьОбласть("СтрокаРезультатовСводноНаборГруппа");
		СтрокаДетали 		= Макет.ПолучитьОбласть("СтрокаРезультатовСводноДетали");
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		СсылкаИБ = ОбщегоНазначенияПовтИсп.ПолучитьСсылкуИнформационнойБазы();
		СоответствиеИдентификаторов = Новый Соответствие;
		
		ПараметрыШапки = Новый Соответствие;
		ПараметрыШапки.Вставить(Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля,
			Новый Структура("Заголовок, Цвет", "Ошибки выполнения контроля", Новый Цвет(255, 0, 0)));
		ПараметрыШапки.Вставить(Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение,
			Новый Структура("Заголовок, Цвет", "Нарушения", Новый Цвет(255, 0, 0)));
		ПараметрыШапки.Вставить(Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие,
			Новый Структура("Заголовок, Цвет", "Несоответствия", Новый Цвет(0, 0, 0)));
		ПараметрыШапки.Вставить(Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена,
			Новый Структура("Заголовок, Цвет", "Успешная проверка", Новый Цвет(0, 255, 0)));
			
		Пока ВыборкаРезультат.Следующий() Цикл
			
			ПараметрыЗаголовка = ПараметрыШапки.Получить(ВыборкаРезультат.РезультатПроверки);
			Если ПараметрыЗаголовка <> Неопределено Тогда
			
				Шапка.Параметры.Заголовок = ПараметрыЗаголовка.Заголовок;
				Шапка.Область(2,,2).ЦветТекста = ПараметрыЗаголовка.Цвет;
				
			Иначе
				
				Шапка.Параметры.Заголовок = ПараметрыГрупповогоКонтроля.ЗаголовокОтчета;
				Шапка.Область(2,,2).ЦветТекста = Новый Цвет(255, 0, 0);
			
			КонецЕсли; 
			
			ТабличныйДокумент.Вывести(Шапка);
			
			ВыборкаКлиент = ВыборкаРезультат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКлиент.Следующий() Цикл
			
				ВыборкаВидДоговора = ВыборкаКлиент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
				Пока ВыборкаВидДоговора.Следующий() Цикл
				
					СтрокаКлиент.Параметры.КлиентВидДоговора = Строка(ВыборкаВидДоговора.Клиент) + 
						" - " + ВыборкаВидДоговора.ВидДоговораДоверительногоУправления;
					ТабличныйДокумент.Вывести(СтрокаКлиент);
					ВыполнитьОтправку = Истина;
					
					ВыборкаПорядокКонтроля = ВыборкаВидДоговора.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаПорядокКонтроля.Следующий() Цикл
					
						ВыборкаПериод = ВыборкаПорядокКонтроля.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							
						Пока ВыборкаПериод.Следующий() Цикл
							
							ВыборкаНазначение = ВыборкаПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							
							Пока ВыборкаНазначение.Следующий() Цикл
							
								ВыборкаИД = ВыборкаНазначение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
								
								Пока ВыборкаИД.Следующий() Цикл
								
									Если ЗначениеЗаполнено(ВыборкаИД.ТекстОшибки) Тогда
										СтрокаСчетДУОшибка.Параметры.Заполнить(ВыборкаИД);
										ТабличныйДокумент.Вывести(СтрокаСчетДУОшибка);
										Продолжить;
									КонецЕсли; 
									
									СтрокаСчетДУ.Параметры.Заполнить(ВыборкаИД);
									Если ВыборкаИД.СовокупныйКонтроль Тогда
										
										РеквизитыИД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаИД.ИнвестиционнаяДекларация, "ТипИнвестиционнойДекларации, Наименование, Комментарий");
										
										ПредставлениеИнвестиционнойДекларации = Строка(РеквизитыИД.ТипИнвестиционнойДекларации) +  " (совокупно): " 
											+ ?(РеквизитыИД.ТипИнвестиционнойДекларации = Перечисления.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация, Строка(ВыборкаИД.Назначение.Субъект) + " - ", "")
											+ РеквизитыИД.Наименование + ?(ЗначениеЗаполнено(РеквизитыИД.Комментарий), Символы.ПС + РеквизитыИД.Комментарий, "");
										
										СтрокаСчетДУ.Параметры.СчетДоверительногоУправления = ПредставлениеИнвестиционнойДекларации;
										
									КонецЕсли; 									
									
									СтрокаСчетДУ.Параметры.ИдентификаторРезультата = ВыборкаИД.ИдентификаторРезультата;
									СоответствиеИдентификаторов.Вставить(ВыборкаИД.ИдентификаторРезультата, ПолучитьГиперссылкуНаРезультатПроверки(СсылкаИБ, ВыборкаИД.ИдентификаторРезультата));
									
									ТабличныйДокумент.Вывести(СтрокаСчетДУ);
									
									Если Не (ВыборкаИД.ЕстьВнутренниеНарушения Или ВыборкаИД.ЕстьНарушенияПоДоговору) Тогда
										Продолжить;
									КонецЕсли; 
									
									ВыборкаНабор = ВыборкаИД.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
									
									Пока ВыборкаНабор.Следующий() Цикл						
										
										ВыборкаОтборПоЭмитенту = ВыборкаНабор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
										
										Пока ВыборкаОтборПоЭмитенту.Следующий() Цикл
											
											ВыборкаОтборПоЦеннойБумаге = ВыборкаОтборПоЭмитенту.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
											
											Пока ВыборкаОтборПоЦеннойБумаге.Следующий() Цикл
												
												ВыборкаПоДатеЗапретаПокупки = ВыборкаОтборПоЦеннойБумаге.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
												
												Пока ВыборкаПоДатеЗапретаПокупки.Следующий() Цикл
													
													ВыборкаВнутреннийНабор = ВыборкаПоДатеЗапретаПокупки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
													
													Пока ВыборкаВнутреннийНабор.Следующий() Цикл
														
														ПредставлениеНабора = Новый Массив;
														ПредставлениеНабора.Добавить(Строка(ВыборкаВнутреннийНабор.Набор));
														Если ЗначениеЗаполнено(ВыборкаВнутреннийНабор.ОтборПоЭмитенту) Тогда
															ПредставлениеНабора.Добавить(ВыборкаВнутреннийНабор.ОтборПоЭмитенту);
														КонецЕсли; 
														Если ЗначениеЗаполнено(ВыборкаВнутреннийНабор.ОтборПоЦеннойБумаге) Тогда
															ПредставлениеНабора.Добавить(ВыборкаВнутреннийНабор.ОтборПоЦеннойБумаге);
														КонецЕсли; 
														Если ЗначениеЗаполнено(ВыборкаВнутреннийНабор.ДатаЗапретаПокупки) Тогда
															ПредставлениеНабора.Добавить(ВыборкаВнутреннийНабор.ДатаЗапретаПокупки);
														КонецЕсли;
																						
														Набор = СтрСоединить(ПредставлениеНабора, "; ") + ?(ВыборкаВнутреннийНабор.ВнутреннийНабор, " (внутр.)", "");
																
														Если ЗначениеЗаполнено(ВыборкаВнутреннийНабор.Группировка) Тогда
															СтрокаНаборГруппа.Параметры.Заполнить(ВыборкаВнутреннийНабор);
															СтрокаНаборГруппа.Параметры.Набор = Набор;
															ТабличныйДокумент.Вывести(СтрокаНаборГруппа);
															Строка = СтрокаДетали;
															ЗаполнитьНабор = Ложь;
														Иначе
															Строка = СтрокаНабор;
															ЗаполнитьНабор = Истина;
														КонецЕсли;
														
														Выборка = ВыборкаВнутреннийНабор.Выбрать();
														
														Пока Выборка.Следующий() Цикл
														
															Строка.Параметры.Заполнить(Выборка);
															Если ЗаполнитьНабор Тогда
																Строка.Параметры.Набор = Набор;
															КонецЕсли; 
															Строка.Параметры.Мин = Строка(Выборка.МинимальноеЗначение) + ?(Выборка.АбсолютнаяВеличинаМин, "", "%");
															Строка.Параметры.Макс = Строка(Выборка.МаксимальноеЗначение) + ?(Выборка.АбсолютнаяВеличинаМакс, "", "%");
															Строка.Параметры.Значение = Формат(Выборка.Значение, "ЧДЦ=2; ЧН=0,00") + " (" + Выборка.Доля + "%)";
															ТабличныйДокумент.Вывести(Строка);
														
														КонецЦикла;
													КонецЦикла;
												КонецЦикла;
											КонецЦикла;
										КонецЦикла;
									КонецЦикла; 
								КонецЦикла; 
							КонецЦикла; 
						КонецЦикла; 
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		#КонецОбласти 
		
		#Область Формирование_оповещений
		ИмяФайла = ПолучитьИмяВременногоФайла("htm");
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяФайла);
		
		УдалитьФайлы(ИмяФайла);
		
		ТекстПисьма = ТелоПисьма.ПолучитьТекст();
		Для каждого ЭлементСоответствия Из СоответствиеИдентификаторов Цикл
			ТекстПисьма = СтрЗаменить(ТекстПисьма, ЭлементСоответствия.Ключ, ЭлементСоответствия.Значение);
		КонецЦикла; 
		
		ТекстПисьма = СтрЗаменить(ТекстПисьма, "&lt;", "<");
		ТекстПисьма = СтрЗаменить(ТекстПисьма, "&gt;", ">");
		
		РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", 
			ПараметрыГрупповогоКонтроля.Организация, 
			ПараметрыГрупповогоКонтроля.ТемаПисьма, 
			ТекстПисьма);
			
		Справочники.Оповещения.СформироватьОповещения(ПараметрыГрупповогоКонтроля.ИсточникОповещения, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения); 
	
	ИначеЕсли ПараметрыГрупповогоКонтроля.Свойство("ТемаУведомленияОбОтсутствииОшибок") Тогда 
		
		РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", 
			ПараметрыГрупповогоКонтроля.Организация, 
			ПараметрыГрупповогоКонтроля.ТемаУведомленияОбОтсутствииОшибок, 
			ПараметрыГрупповогоКонтроля.ТемаУведомленияОбОтсутствииОшибок);
			
		Справочники.Оповещения.СформироватьОповещения(ПараметрыГрупповогоКонтроля.ИсточникОповещения, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		#КонецОбласти
		
	КонецЕсли;

КонецПроцедуры
 
Процедура ДобавитьОписаниеОшибкиВСводнуюТаблицуРезультатов(СводнаяТаблицаРезультатовКонтроля, ПараметрыКонтроля, ТекстОшибки);

	СписокСвойств = "Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, Назначение, ИнвестиционнаяДекларация";

	НоваяСтрока = СводнаяТаблицаРезультатовКонтроля.Добавить();
	НоваяСтрока.РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ОшибкаВыполненияКонтроля; 
	НоваяСтрока.ТекстОшибки = ТекстОшибки;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыКонтроля, СписокСвойств);

КонецПроцедуры

Процедура ДобавитьЗаписьВХранилищеЗначений(ИдентификаторРезультата, РезультатПроверки, Параметры) Экспорт

	ПараметрыОтбора = ПараметрыОтбораДляХранилищаЗначений(Параметры);
	
	Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
	Запись.Идентификатор 				= ИдентификаторРезультата;
	Запись.ХранилищеЗначения 			= Новый ХранилищеЗначения(РезультатПроверки, Новый СжатиеДанных(9));
	Запись.Источник 					= "_КонтрольИнвестиционныхДеклараций";
	Запись.Организация 					= Параметры.Организация;
	Запись.СчетДоверительногоУправления = Параметры.СчетДоверительногоУправления;
	Запись.Ответственный				= РаботаСПользователями.ТекущийПользователь();
	Запись.Комментарий					= ПараметрыОтбора.Представление;
	Запись.ПараметрыОтбора				= ПараметрыОтбора.Хранилище;
	Запись.КонтрольнаяСумма				= ПараметрыОтбора.КонтрольнаяСумма;
	Запись.Записать();

КонецПроцедуры

Функция ПараметрыОтбораДляХранилищаЗначений(Параметры) Экспорт

	СтруктураОтбора = Новый Структура("Организация, Период, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация, СовокупнаяИнвестДекларация");
	
	РежимСовокукпногоКонтроля = "Авто";
	Если Параметры.Свойство("РежимСовокукпногоКонтроля") Тогда
		РежимСовокукпногоКонтроля = Параметры.РежимСовокукпногоКонтроля;
	КонецЕсли; 
	
	СтруктураОтбора.Вставить("РежимСовокукпногоКонтроля", РежимСовокукпногоКонтроля);
	
	Исключения = Неопределено;
	Если РежимСовокукпногоКонтроля = "Авто" И Параметры.СовокупнаяИнвестДекларация Тогда
		Исключения = "СчетДоверительногоУправления, ИнвестиционнаяДекларация";
	ИначеЕсли РежимСовокукпногоКонтроля = "Совокупно" Тогда 
		Исключения = "СчетДоверительногоУправления";
	КонецЕсли; 
		
	ЗаполнитьЗначенияСвойств(СтруктураОтбора, Параметры,, Исключения);
			
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Хранилище", Новый ХранилищеЗначения(СтруктураОтбора, Новый СжатиеДанных(9)));
	
	МассивПредставлений = Новый Массив;
	Для Каждого ЭлементОтбора Из СтруктураОтбора Цикл
		МассивПредставлений.Добавить(ЭлементОтбора.Ключ + ": " + ЭлементОтбора.Значение);
	КонецЦикла;
	
	ПараметрыОтбора.Вставить("Представление", СтрСоединить(МассивПредставлений, Символы.ПС));
	
	ПотокДанных = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML; 
	ЗаписьXML.ОткрытьПоток(ПотокДанных);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СтруктураОтбора, "Structure", "http://v8.1c.ru/8.1/data/core");
	ЗаписьXML.Закрыть();
	
	ДвоичныеДанные = ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
	
	ПараметрыОтбора.Вставить("КонтрольнаяСумма", УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанные));

	Возврат ПараметрыОтбора;

КонецФункции
 
Функция ПолучитьСтруктуруРезультатаПроверки(ПараметрыКонтроля, ОшибкиОценки = Неопределено, РезультатПроверкиДерева = Неопределено) Экспорт
					
	СтруктураРезультатаПроверки = Новый Структура("Период, Организация, Клиент, ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ИнвестиционнаяДекларация, 
			|РезультатыПроверки, СтруктураФормированияОтчета, ПараметрыБазисов, СтруктураОтчетов, СоставСовокупнойИнвестДекларации, ДинамическийРасчетСтоимости, 
			|УчитыватьПлановыеОперации, Претрейд");
	ЗаполнитьЗначенияСвойств(СтруктураРезультатаПроверки, ПараметрыКонтроля);
	
	Если ОшибкиОценки <> Неопределено Тогда
		СтруктураРезультатаПроверки.Вставить("ОшибкиОценки", ОшибкиОценки);
	КонецЕсли; 
	
	Если РезультатПроверкиДерева <> Неопределено Тогда
		СтруктураРезультатаПроверки.Вставить("РезультатПроверкиДерева",	РезультатПроверкиДерева);
	КонецЕсли; 
	
	Возврат СтруктураРезультатаПроверки;

КонецФункции

Функция ПолучитьТаблицуСоставаСовокупнойИД()

	СоставСовокупнойИД = Новый ТаблицаЗначений;
	СоставСовокупнойИД.Колонки.Добавить("Включен", Новый ОписаниеТипов("Булево"));
	СоставСовокупнойИД.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	СоставСовокупнойИД.Колонки.Добавить("ВидДоговораДоверительногоУправления", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления"));
	СоставСовокупнойИД.Колонки.Добавить("ИнвестиционнаяДекларация", Новый ОписаниеТипов("СправочникСсылка.ИнвестиционныеДекларации"));
	СоставСовокупнойИД.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(25)));
	СоставСовокупнойИД.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	СоставСовокупнойИД.Колонки.Добавить("Клиент", Метаданные.ОпределяемыеТипы.КлиентыДоверительногоУправления.Тип);
	СоставСовокупнойИД.Колонки.Добавить("ВалютаУчета", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СоставСовокупнойИД.Колонки.Добавить("Назначение", Новый ОписаниеТипов("ДокументСсылка.НазначениеИнвестиционнойДекларации"));
	СоставСовокупнойИД.Колонки.Добавить("ПорядокКонтроля", Новый ОписаниеТипов("Число"));
	СоставСовокупнойИД.Колонки.Добавить("СовокупныйКонтроль", Новый ОписаниеТипов("Булево"));
	
	СоставСовокупнойИД.Колонки.Добавить("ОрганизацияПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	СоставСовокупнойИД.Колонки.Добавить("СчетДоверительногоУправленияПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	СоставСовокупнойИД.Колонки.Добавить("ИнвестиционнаяДекларацияПредставление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	СоставСовокупнойИД.Колонки.Добавить("ТипИнвестиционнойДекларации", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыИнвестиционныхДеклараций"));
		
	Возврат СоставСовокупнойИД;

КонецФункции
 

#КонецОбласти 

#Область Проверки_настроек_и_назначения_ИД

Процедура КонтрольКорректностиНастроек(ПараметрыКоманды, ИдентификаторКоманды)

	// Получаем список клиентов
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц, 
		ТекущаяДатаСеанса(),
		Новый Структура("Организация", ПараметрыКоманды.Организация));
		
	#Область Текст_запроса_ДействующиеСчетаДУ
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	ДействующиеСчетаДУ.Ссылка КАК Ссылка,
		|	ДействующиеСчетаДУ.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ДействующиеСчетаДУ.Стратегия КАК Стратегия
		|ПОМЕСТИТЬ _ДействующиеСчетаДУ
		|ИЗ
		|	ДействующиеСчетаДУ КАК ДействующиеСчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО ДействующиеСчетаДУ.Ссылка = СчетаДоверительногоУправления.Ссылка
		|			И (СчетаДоверительногоУправления.ДатаЗаключения >= &ДатаЗаключения)";
	#КонецОбласти
	
	ДатаЗаключения = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -2);
	Запрос.УстановитьПараметр("ДатаЗаключения", ДатаЗаключения);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.Выполнить();
	
	// Проверяем настройки
	Если ИдентификаторКоманды = "КонтрольНазначенияИД" Тогда
		
		#Область Текст_запроса_КонтрольНазначенияИД
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДействующиеСчетаДУ.Организация КАК Организация,
			|	_ДействующиеСчетаДУ.Ссылка КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА _ДействующиеСчетаДУ.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
			|			ТОГДА ""Не назначена инвестиционная декларация по стратегии "" + ВЫРАЗИТЬ(_ДействующиеСчетаДУ.Стратегия КАК Справочник.СтратегииИндивидуальногоИнвестирования).Наименование
			|		ИНАЧЕ ""Не назначена инвестиционная декларация""
			|	КОНЕЦ КАК ОписаниеОшибки
			|ИЗ
			|	_ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеДекларации.СрезПоследних(
			|				&ТекущаяДата,
			|				(Организация, Субъект, ТипИнвестиционнойДекларации) В
			|					(ВЫБРАТЬ
			|						_ДействующиеСчетаДУ.Организация,
			|						_ДействующиеСчетаДУ.Ссылка,
			|						ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация)
			|					ИЗ
			|						_ДействующиеСчетаДУ
			|				
			|					ОБЪЕДИНИТЬ ВСЕ
			|				
			|					ВЫБРАТЬ
			|						_ДействующиеСчетаДУ.Организация,
			|						_ДействующиеСчетаДУ.Стратегия,
			|						ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация)
			|					ИЗ
			|						_ДействующиеСчетаДУ)) КАК ИнвестиционныеДекларацииСрезПоследних
			|		ПО _ДействующиеСчетаДУ.Организация = ИнвестиционныеДекларацииСрезПоследних.Организация
			|			И (_ДействующиеСчетаДУ.Ссылка = ИнвестиционныеДекларацииСрезПоследних.Субъект
			|				ИЛИ _ДействующиеСчетаДУ.Стратегия = ИнвестиционныеДекларацииСрезПоследних.Субъект)
			|ГДЕ
			|	НЕ ЕСТЬNULL(ИнвестиционныеДекларацииСрезПоследних.Действует, ЛОЖЬ)";			
		#КонецОбласти
		
	ИначеЕсли ИдентификаторКоманды = "КонтрольНастроекСЧА" Или ИдентификаторКоманды = "КонтрольНастроекБух" Тогда
		
		// Получаем настройки целей расчета
		#Область Текст_запроса_НастройкиЦелейРасчета
		Запрос.Текст = 
