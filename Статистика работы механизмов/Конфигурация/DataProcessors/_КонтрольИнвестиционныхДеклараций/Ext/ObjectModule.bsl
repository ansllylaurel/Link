Процедура ПроверитьИнвестДекларацию(Параметры, КоллекцияЭлементов, ИнвестиционнаяДекларация = Неопределено, СтруктураОтчета = Неопределено) Экспорт
	// параметры ИнвестиционнаяДекларация и СтруктураСКДОтчета заполняются при рекурсивном вызове метода при контроле консолидирующих инвестдеклараций
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(Параметры);
	Механизм = Параметры.Механизм;//"_КонтрольИнвестиционныхДеклараций.Форма.ПроверитьИнвестДекларацию()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);            
		
	СКДОтчета 							= Неопределено;
	КомпоновщикНастроекОтчета 			= Неопределено;
	НастройкиОтчета 					= Неопределено;
	ВнешниеНаборыДанныхОтчета 			= Неопределено;
	
	ЗаполнитьОбъектыФормированияСКДОтчета(СтруктураОтчета, СКДОтчета, КомпоновщикНастроекОтчета, НастройкиОтчета, ВнешниеНаборыДанныхОтчета);
		
	СводнаяТаблицаРезультатовКонтроля	= Неопределено;
	ФиксироватьТолькоНарушения 			= Неопределено;
	ЗаполнитьСводнуюТаблицу = Параметры.Свойство("ФиксироватьТолькоНарушения", ФиксироватьТолькоНарушения);
		
	Если ЗаполнитьСводнуюТаблицу Тогда
	
		СводнаяТаблицаРезультатовКонтроля = СоздатьСводнуюТаблицуРезультатовКонтроля(СтруктураОтчета);
		
	КонецЕсли; 
	
	Если Не Параметры.Свойство("УдалитьОтборПоБрокеру") Тогда
		Параметры.Вставить("УдалитьОтборПоБрокеру", Ложь);
	КонецЕсли;
	
	// !!!ОТЛАДКА
	Если Ложь Тогда
	
		Регистр = РегистрыСведений.ХранилищеЗначений;
		УИД = Новый УникальныйИдентификатор("cdf3ab59-19fe-4779-a7f0-98734da089ad");
		Хранилище = Регистр.Получить(Новый Структура("Идентификатор", УИД)).ХранилищеЗначения.Получить(); 
		Если Хранилище = Неопределено Тогда
			СформироватьПараметрыБазисов(Параметры); // таблица базиса формируется здесь
			
			МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
			Параметры.Удалить("МенеджерВременныхТаблиц");
			_Базисы = МенеджерВременныхТаблиц.Таблицы.Найти("_Базисы").ПолучитьДанные().Выгрузить();
			Параметры.Вставить("Базисы", _Базисы);
			
			Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = УИД;
			Запись.ХранилищеЗначения = Новый ХранилищеЗначения(Параметры);
			Запись.Записать();
			Параметры.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц)
			
		Иначе
			Параметры = Хранилище;
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ _Базисы ИЗ &Базисы Базисы";
			МВТ = Новый МенеджерВременныхТаблиц;
			Запрос.МенеджерВременныхТаблиц = МВТ;
			Запрос.УстановитьПараметр("Базисы", Параметры.Базисы);
			Запрос.Выполнить();
			Параметры.Удалить("Базисы");
			Параметры.Вставить("МенеджерВременныхТаблиц", МВТ);
		КонецЕсли; 		
		
	Иначе
		СформироватьПараметрыБазисов(Параметры); // таблица базиса формируется здесь	
	КонецЕсли; 
	
	Если Параметры.Свойство("ТекстОшибки") Тогда
		Возврат;
	КонецЕсли; 
	
	ТаблицаОшибокОценки = Новый ТаблицаЗначений;
	ТаблицаОшибокОценки.Колонки.Добавить("Базис", Новый ОписаниеТипов("СправочникСсылка.БазисыКонтроляИнвестиционныхДеклараций"));
	ТаблицаОшибокОценки.Колонки.Добавить("Набор", Новый ОписаниеТипов("СправочникСсылка.НаборыИнвестиционныхДеклараций"));
	ТаблицаОшибокОценки.Колонки.Добавить("Рынок", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаОшибокОценки.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Базисы.Назначение КАК Назначение,
		|	_Базисы.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	_Базисы.ИспользоватьМинимальноеЗначениеРейтинга КАК ИспользоватьМинимальноеЗначениеРейтинга,
		|	_Базисы.Базис КАК Базис,
		|	_Базисы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БазисыКонтроляИнвестиционныхДеклараций.РежимПолученияБазы КАК РежимПолученияБазы,
		|	ВЫБОР
		|		КОГДА ИнвестиционныеДекларации.ТипИнвестиционнойДекларации = ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЗаконодательныеОграничения)
		|			ТОГДА 1
		|		КОГДА ИнвестиционныеДекларации.ТипИнвестиционнойДекларации = ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ЛимитнаяВедомость)
		|			ТОГДА 2
		|		КОГДА ИнвестиционныеДекларации.ТипИнвестиционнойДекларации = ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация)
		|			ТОГДА 3
		|	КОНЕЦ КАК Порядок,
		|	ИнвестиционныеДекларации.СовокупныйКонтроль КАК СовокупныйКонтроль
		|ИЗ
		|	_Базисы КАК _Базисы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БазисыКонтроляИнвестиционныхДеклараций КАК БазисыКонтроляИнвестиционныхДеклараций
		|		ПО _Базисы.Базис = БазисыКонтроляИнвестиционныхДеклараций.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
		|		ПО _Базисы.ИнвестиционнаяДекларация = ИнвестиционныеДекларации.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	ИнвестиционнаяДекларация,
		|	Базис,
		|	Назначение,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(ИспользоватьМинимальноеЗначениеРейтинга),
		|	МАКСИМУМ(РежимПолученияБазы),
		|	МАКСИМУМ(Порядок),
		|	МАКСИМУМ(СовокупныйКонтроль)
		|ПО
		|	Назначение,
		|	ИнвестиционнаяДекларация,
		|	Базис";
	
	Результат = Запрос.Выполнить();
	ВыборкаНазначение = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаИнвестиционныхДеклараций = Новый ТаблицаЗначений;
	ТаблицаИнвестиционныхДеклараций.Колонки.Добавить("Назначение");
	ТаблицаИнвестиционныхДеклараций.Колонки.Добавить("ИнвестиционнаяДекларация");
	ТаблицаИнвестиционныхДеклараций.Колонки.Добавить("Базис");
	ТаблицаИнвестиционныхДеклараций.Колонки.Добавить("Параметры");
	ТаблицаИнвестиционныхДеклараций.Колонки.Добавить("СчетаДоверительногоУправления");
	
	ЭтоКлиентТрадиция = Неопределено;
	
	НомерБазиса = 0;
	НеРазрешенныеКПриобретению = Справочники.НаборыИнвестиционныхДеклараций.НеРазрешенныеКПриобретению;
	
	Пока ВыборкаНазначение.Следующий() Цикл
	
		ВыборкаИД = ВыборкаНазначение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаИД.Следующий() Цикл
			
			#Область Заполнение_совокупной_таблицы_базиса
			
			ВыборкаБазис = ВыборкаИД.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
			Пока ВыборкаБазис.Следующий() Цикл
				
				Выборка = ВыборкаБазис.Выбрать();
				
				НоваяСтрока = Неопределено;
				
				Пока Выборка.Следующий() Цикл
					
					НайденныеСтроки = Параметры.ПараметрыБазисов.НайтиСтроки(Новый Структура("Базис, ИспользоватьМинимальноеЗначениеРейтинга, СчетДоверительногоУправления", 
						Выборка.Базис, 
						Выборка.ИспользоватьМинимальноеЗначениеРейтинга, 
						Выборка.СчетДоверительногоУправления));	
						
					ТекПараметры = НайденныеСтроки[0].Параметры;
					
					Если ЭтоКлиентТрадиция = Неопределено Тогда
						
						ТекущийКлиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(Выборка.СчетДоверительногоУправления, Параметры.Период);
						КлиентТрадиция = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция");
						ЭтоКлиентТрадиция = (ТекущийКлиент = КлиентТрадиция);
					
					КонецЕсли; 
						
					Если НоваяСтрока = Неопределено Тогда
					
						НоваяСтрока = ТаблицаИнвестиционныхДеклараций.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаБазис);
						
						НомерБазиса = НомерБазиса + 1;
						ПараметрыБазиса = Новый Структура;						
						ПараметрыБазиса.Вставить("НомерБазиса", 					НомерБазиса);
						ПараметрыБазиса.Вставить("СКД", 							ТекПараметры.СКД);
						ПараметрыБазиса.Вставить("НастройкиСКД", 					ТекПараметры.НастройкиСКД);
						ПараметрыБазиса.Вставить("ТаблицаПолей", 					ТекПараметры.ТаблицаПолей);
						ПараметрыБазиса.Вставить("ТаблицаВычисляемыхПолей", 		ТекПараметры.ТаблицаВычисляемыхПолей);
						ПараметрыБазиса.Вставить("КонтролируемыеПоказатели", 		ТекПараметры.КонтролируемыеПоказатели);
						ПараметрыБазиса.Вставить("ТаблицаСвязанныхПолей", 			ТекПараметры.ТаблицаСвязанныхПолей);
						ПараметрыБазиса.Вставить("ПараметрыСКД", 					ТекПараметры.ПараметрыСКД);
						ПараметрыБазиса.Вставить("РежимПолученияБазы", 				ТекПараметры.РежимПолученияБазы);
						ПараметрыБазиса.Вставить("ВычисляемыеПоляЗаполнены", 		Ложь);
						ПараметрыБазиса.Вставить("ИдентификаторСКД",				ТекПараметры.ИдентификаторСКД);
						
						ПараметрыБазиса.Вставить("ТаблицаСЧА", 						?(ТипЗнч(ТекПараметры.ТаблицаСЧА) = Тип("ТаблицаЗначений"), ТекПараметры.ТаблицаСЧА.Скопировать(), ТекПараметры.ТаблицаСЧА));
						ПараметрыБазиса.Вставить("ТаблицаБазиса", 					ТекПараметры.ТаблицаБазиса.Скопировать());
						ПараметрыБазиса.Вставить("ЗначениеБазы", 					ТекПараметры.ЗначениеБазы);
						ПараметрыБазиса.Вставить("ОтсутствуетСтоимостьПереоценки", 	ТекПараметры.ОтсутствуетСтоимостьПереоценки);
						
						НоваяСтрока.Параметры = ПараметрыБазиса;
						НоваяСтрока.СчетаДоверительногоУправления = Новый Массив;
						НоваяСтрока.СчетаДоверительногоУправления.Добавить(Выборка.СчетДоверительногоУправления);
						
					Иначе
						
						РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТекПараметры.ТаблицаБазиса, НоваяСтрока.Параметры.ТаблицаБазиса);
											
						Если Выборка.РежимПолученияБазы = 0 Тогда
							РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТекПараметры.ТаблицаСча, НоваяСтрока.Параметры.ТаблицаСча);
						КонецЕсли;
						
						НоваяСтрока.СчетаДоверительногоУправления.Добавить(Выборка.СчетДоверительногоУправления);
						
					КонецЕсли; 
													
				КонецЦикла;
				
				Если ВыборкаБазис.РежимПолученияБазы = 0 Тогда
					ПараметрыБазиса.ТаблицаСЧА.Свернуть("БазаВидАктива", "БазаСумма");
					ПараметрыБазиса.ЗначениеБазы = ПараметрыБазиса.ТаблицаСЧА.Итог("БазаСумма");
				КонецЕсли; 
				ПараметрыБазиса.ОтсутствуетСтоимостьПереоценки = (ПараметрыБазиса.ТаблицаБазиса.НайтиСтроки(Новый Структура("ОтсутствуетСтоимостьПереоценки", Истина)).Количество() > 0)
			
			КонецЦикла;
		
			#КонецОбласти 
		
			ТекущаяИД = ВыборкаИД.ИнвестиционнаяДекларация;
			
			СовокупныйКонтроль = (Выборка.Количество() > 1);
			
			СтрокиИДДляОбновления = Новый Соответствие;
			
			ГруппыЭмитентов = Справочники.ИнвестиционныеДекларации.ПолучитьГруппыЭмитентов(ТекущаяИД);
			ГруппыАктивов = Справочники.ИнвестиционныеДекларации.ПолучитьГруппыАктивов(ТекущаяИД);
			
			КлючПараметров = Новый Структура("Назначение, ИнвестиционнаяДекларация", ВыборкаИД.Назначение, ТекущаяИД);
			Консолидирующая = ТекущаяИД.Консолидирующая;
			
			ЭтоИнвестиционнаяДекларация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяИД, "ТипИнвестиционнойДекларации") = Перечисления.ТипыИнвестиционныхДеклараций.ИнвестиционнаяДекларация; 
			
			Для каждого СтрокаПоказателей Из ТекущаяИД.Показатели Цикл
				
				Если СовокупныйКонтроль И Не ЭтоИнвестиционнаяДекларация И 
					СтрокаПоказателей.НаборИнвестиционнойДекларации = НеРазрешенныеКПриобретению Тогда
				
					Продолжить;
				
				КонецЕсли; 
				
				// проверяем наборы инвестдекларации
				КлючПараметров.Вставить("Базис", СтрокаПоказателей.Базис);
				СтрокаТаблицыИД = ТаблицаИнвестиционныхДеклараций.НайтиСтроки(КлючПараметров)[0];
				ПараметрыБазиса = СтрокаТаблицыИД.Параметры;
				
				ПараметрыПоказателя = ПараметрыБазиса.КонтролируемыеПоказатели.Найти(СтрокаПоказателей.КонтролируемыйПоказатель, "Представление");
				
				#Область Формирование_СКД_и_получение_значения_базы
				СКД = ПараметрыБазиса.СКД;
				Настройки = ПараметрыБазиса.НастройкиСКД.Получить();
				
				Если СКДОтчета.ВложенныеСхемыКомпоновкиДанных.Найти("ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса + "_" + ПараметрыПоказателя.ИмяПоляДоля) = Неопределено Тогда
					// добавляем вложенную СКД в СКДОтчета для каждого базиса
					ВнешниеНаборыДанныхОтчета.Вставить("ТаблицаБазиса_" + ПараметрыБазиса.НомерБазиса, ПараметрыБазиса.ТаблицаБазиса);
					Если ПараметрыБазиса.РежимПолученияБазы = 0 Тогда
						ВнешниеНаборыДанныхОтчета.Вставить("ТаблицаСЧА_" + ПараметрыБазиса.НомерБазиса, ПараметрыБазиса.ТаблицаСЧА);
					КонецЕсли; 
					
					ВложеннаяСКДБазиса = СформироватьВложеннуюСКД(СКД, СКДОтчета, СтрокаПоказателей, ПараметрыБазиса, ПараметрыПоказателя);
					// создаем настройки для вывода базиса из вложенной СКД
					ДобавитьБазисВСтруктуОтчета = Истина;
					ИмяВложенногоБазиса = "ВложеннаяСхема_" + ПараметрыБазиса.НомерБазиса;
					Для каждого ЭлементСтруктуры Из НастройкиОтчета.Структура Цикл
						Если ЭлементСтруктуры.Имя = ИмяВложенногоБазиса Тогда
							ДобавитьБазисВСтруктуОтчета = Ложь;
							Прервать;
						КонецЕсли; 
					КонецЦикла; 
					Если ДобавитьБазисВСтруктуОтчета Тогда
						СформироватьНастройкиВложенногоБазиса(НастройкиОтчета, Настройки, СтрокаПоказателей, ПараметрыПоказателя, ПараметрыБазиса, Параметры.УдалитьОтборПоБрокеру);
					КонецЕсли; 
					
				КонецЕсли; 
				
				// ресурсы
				СКД.ПоляИтога.Очистить();
				
				ПолеИтога = СКД.ПоляИтога.Добавить();
				ПолеИтога.Выражение = ПараметрыПоказателя.ВыражениеПоказатель;
				ЗаполнитьЗначенияСвойств(ПолеИтога, ПараметрыПоказателя);
				
				ПолеИтогаДоля = СКД.ПоляИтога.Добавить();
				ПолеИтогаДоля.ПутьКДанным = ПараметрыПоказателя.ИмяПоляДоля;
				ПолеИтогаДоля.Выражение = ПараметрыПоказателя.ВыражениеДоля;
				ЗаполнитьЗначенияСвойств(ПолеИтогаДоля, ПолеИтога,, "ПутьКДанным, Выражение");			
				
				Для каждого ПутьКДанным Из ПараметрыПоказателя.Группировки Цикл
					ПолеИтога.Группировки.Добавить(ПутьКДанным);
					ПолеИтогаДоля.Группировки.Добавить(ПутьКДанным);
				КонецЦикла;
				
				// выбранные поля
				ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ПолеВыбор.Использование = Истина;
				ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ПутьКДанным);
				ПолеВыбор.Заголовок = ПараметрыПоказателя.Представление;
				
				ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ПолеВыбор.Использование = Истина;
				ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ИмяПоляДоля);
				ПолеВыбор.Заголовок = ПараметрыПоказателя.ИмяПоляДоля;
								
				Если ТипЗнч(СтрокаПоказателей.МинимальноеЗначение) = Тип("Строка") Тогда
					ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					ПолеВыбор.Использование = Истина;
					ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(СтрокаПоказателей.МинимальноеЗначение);
					ПолеИтога = СКД.ПоляИтога.Добавить();
					ПолеИтога.Выражение = СтрокаПоказателей.МинимальноеЗначение;
					ПолеИтога.ПутьКДанным = СтрокаПоказателей.МинимальноеЗначение;
				КонецЕсли; 
				
				Если ТипЗнч(СтрокаПоказателей.МаксимальноеЗначение) = Тип("Строка") Тогда
					ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					ПолеВыбор.Использование = Истина;
					ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(СтрокаПоказателей.МаксимальноеЗначение);
					ПолеИтога = СКД.ПоляИтога.Добавить();
					ПолеИтога.Выражение = СтрокаПоказателей.МаксимальноеЗначение;
					ПолеИтога.ПутьКДанным = СтрокаПоказателей.МаксимальноеЗначение;
				КонецЕсли; 
				
				// структура
				НоваяГруппировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
				НоваяГруппировка.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
				
				ВложеннаяГруппировка = НоваяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				ВложеннаяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
				ВложеннаяГруппировка.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
				Для каждого Поле Из ПараметрыБазиса.ТаблицаПолей Цикл
					Если Поле.Ключ Тогда
						ПолеГруппировки = ВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
						ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(Поле.ПутьКДанным);
					КонецЕсли; 
				КонецЦикла;
				
				ПолеГруппировки = ВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных")); // !хардкод 
				ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.ОтсутствуетСтоимостьПереоценки");
				
				Если ПараметрыПоказателя.ПутьКДанным <> "ЦенныеБумаги.Количество" Тогда
				
					ПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
					ПолеВыбор.Использование = Истина;
					ПолеВыбор.Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Количество");
					ПолеВыбор.Заголовок = "Количество";
									
					ПолеГруппировки = ВложеннаяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
					ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ЦенныеБумаги.Количество");
				
				КонецЕсли; 

				// заполняем параметры
				Для каждого ПараметрФормирования Из ПараметрыБазиса.ПараметрыСКД Цикл
					Если Не Настройки.ПараметрыДанных.Элементы.Найти(ПараметрФормирования.Ключ) = Неопределено Тогда
						Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрФормирования.Ключ, ПараметрФормирования.Значение);
					КонецЕсли; 
				КонецЦикла;	
				
				Если ПараметрыБазиса.ЗначениеБазы = Неопределено Тогда
					
					РезультатКомпоновкиБазиса = ПолучитьРезультатКомпоновки(СКД, Настройки, Новый Структура("ТаблицаБазиса", ПараметрыБазиса.ТаблицаБазиса));
					СтрокаТаблицыПоказателейБазиса = ПараметрыБазиса.КонтролируемыеПоказатели.Найти(СтрокаПоказателей.КонтролируемыйПоказатель, "Представление");
					Если СтрокаТаблицыПоказателейБазиса = Неопределено Тогда
						ИмяКолонки = "ПоказателиСумма"; // !хардкод 
					Иначе
						ИмяКолонки = СтрЗаменить(СтрокаТаблицыПоказателейБазиса.ПутьКДанным, ".", "");
					КонецЕсли; 
					ЗначениеБазы = РезультатКомпоновкиБазиса.Итог(ИмяКолонки);
					ПараметрыБазиса.ЗначениеБазы = ЗначениеБазы;
					
				Иначе
					
					ЗначениеБазы = ПараметрыБазиса.ЗначениеБазы;
					
				КонецЕсли;
				
				#КонецОбласти 
				
				#Область Заполнение_вычисляемых_полей
				Отказ = Ложь;
				Если Не ПараметрыБазиса.ВычисляемыеПоляЗаполнены Тогда
					
					КоличествоИтог = ПараметрыБазиса.ТаблицаБазиса.Итог("Количество"); // !хардкод 
					КоличествоПоРЕПОИтог = ПараметрыБазиса.ТаблицаБазиса.Итог("КоличествоПоРЕПО");
					КоличествоСвободныеИтог = ПараметрыБазиса.ТаблицаБазиса.Итог("КоличествоСвободные");
					Для каждого ТекСтрока Из ПараметрыБазиса.ТаблицаБазиса Цикл
						
						Если ЗначениеБазы = 0 Тогда
							
							ТекСтрока.ДоляСумма 					= 0;
							ТекСтрока.ДоляСуммаПоРЕПО 				= 0;
							ТекСтрока.ДоляСуммаБезРепо 				= 0;
							
							ТекСтрока.ДоляДюрация 					= 0;
							ТекСтрока.ДоляДюрацияВГодах 			= 0;
							ТекСтрока.ДоляДюрацияБезРЕПО 			= 0;
							ТекСтрока.ДоляДюрацияВГодахБезРЕПО 		= 0;
							ТекСтрока.ДоляДюрацияВГодахБезРЕПОсЦК 	= 0;
							
							ТекСтрока.МодифицированнаяДюрация		= 0;
							ТекСтрока.МодифицированнаяДюрацияВГодах = 0;
							ТекСтрока.ДоляМодифицированнаяДюрацияВГодах	= 0;
							ТекСтрока.ДоляМодифицированнаяДюрацияРЕПОПОСрокуСделки = 0;
							ТекСтрока.ДоляМодифицированнаяДюрацияБезРЕПО = 0;
							
							ТекСтрока.ДоляНеликвиднаяЧасть 			= 0;
							ТекСтрока.ДоляЛиквидностьНациональный	= 0;
							
						Иначе
							
							Попытка
								
								ТекСтрока.ДоляСумма 					= ТекСтрока.Сумма * 100 / ЗначениеБазы;
								ТекСтрока.ДоляСуммаПоРЕПО 				= ТекСтрока.СуммаПоРЕПО * 100 / ЗначениеБазы;
								ТекСтрока.ДоляСуммаБезРепо 				= ТекСтрока.СуммаБезРепо * 100 / ЗначениеБазы;
								
								Дюрация = ТекСтрока.Дюрация;
								МодифицированнаяДюрация = ТекСтрока.МодифицированнаяДюрация;
								
								ТекСтрока.Дюрация = Окр(Дюрация, 0);
								ТекСтрока.ДюрацияВГодах = Дюрация / 365;
								ТекСтрока.МодифицированнаяДюрация = Окр(МодифицированнаяДюрация, 0);
								ТекСтрока.МодифицированнаяДюрацияВГодах = МодифицированнаяДюрация / 365;
								
								ТекСтрока.ДоляДюрация 					= Окр(ТекСтрока.Дюрация * ТекСтрока.Сумма / ЗначениеБазы, 2);
								ТекСтрока.ДоляДюрацияВГодах 			= Окр(ТекСтрока.ДюрацияВГодах * ТекСтрока.Сумма / ЗначениеБазы, 2);
								ТекСтрока.ДоляДюрацияБезРЕПО 			= Окр(ТекСтрока.Дюрация * ТекСтрока.СуммаБезРЕПО / ЗначениеБазы, 2);
								ТекСтрока.ДоляДюрацияВГодахБезРЕПО 		= Окр(ТекСтрока.ДюрацияВГодах * ТекСтрока.СуммаБезРЕПО / ЗначениеБазы, 2);
								ТекСтрока.ДоляДюрацияВГодахБезРЕПОсЦК 	= Окр(ТекСтрока.ДюрацияВГодах * ТекСтрока.СуммаБезРЕПОсЦК / ЗначениеБазы, 2);
								ТекСтрока.ДоляМодифицированнаяДюрацияВГодах	= Окр(ТекСтрока.МодифицированнаяДюрацияВГодах * ТекСтрока.Сумма / ЗначениеБазы, 2);
								ТекСтрока.ДоляМодифицированнаяДюрацияБезРЕПО = Окр(ТекСтрока.МодифицированнаяДюрацияВГодах * ТекСтрока.СуммаБезРЕПО / ЗначениеБазы, 2);
								ТекСтрока.ДоляМодифицированнаяДюрацияРЕПОПОСрокуСделки = Окр(
									(ТекСтрока.ДоляДюрацииБезРЕПО * МодифицированнаяДюрация + ТекСтрока.ДоляДюрацииПоРЕПО) / 365 * ТекСтрока.Сумма / ЗначениеБазы, 2);								
								
								ТекСтрока.ДоляНеликвиднаяЧасть			= Окр(ТекСтрока.НеликвиднаяЧасть * 100 / ЗначениеБазы, 2);
								ТекСтрока.ДоляЛиквидностьНациональный	= Окр(ТекСтрока.ЛиквидностьНациональный * 100 / ЗначениеБазы, 2);
								
							Исключение
								
								Отказ = Истина;
								
								СтруктураПолей = Новый Структура("Период, Организация, СчетДоверительногоУправления, ИнвестиционнаяДекларация, Базис, ВидАктива, Актив, ЗначениеБазы, Сумма, СуммаПоРЕПО, СуммаБезРепо, Дюрация, ДюрацияВГодах, НеликвиднаяЧасть");
								ЗаполнитьЗначенияСвойств(СтруктураПолей, ТекСтрока);
								ЗаполнитьЗначенияСвойств(СтруктураПолей, Параметры);
								СтруктураПолей.Вставить("Базис", Строкапоказателей.Базис);
								
								ПредставлениеПолей = "";
								Для каждого ТекПоле Из СтруктураПолей Цикл
									ПредставлениеПолей = ПредставлениеПолей + Символы.ПС + ТекПоле.Ключ + " = " + ТекПоле.Значение + ";";
								КонецЦикла; 
								
								ТекстСообщения = "Ошибка при расчете долей по базису" + "." + ПредставлениеПолей + Символы.ПС 
									+ " Описание ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
									
								РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, "Контроль инвестиционных деклараций");
								Прервать;
								
							КонецПопытки;
											
						КонецЕсли; 
						
						Если ТекСтрока.КоличествоВОбращении = 0 Тогда
							ТекСтрока.ДоляВОбращенииВыпуск		= 100;
						Иначе
							ТекСтрока.ДоляВОбращенииВыпуск		= ТекСтрока.Количество * 100 / ТекСтрока.КоличествоВОбращении;
						КонецЕсли; 
						
						Если КоличествоИтог = 0 Тогда
						    ТекСтрока.ДоляКоличество = 0;
						Иначе
							ТекСтрока.ДоляКоличество = ТекСтрока.Количество * 100 / КоличествоИтог;
						КонецЕсли;
						Если КоличествоПоРЕПОИтог = 0 Тогда
						    ТекСтрока.ДоляКоличествоПоРЕПО = 0;
						Иначе
							ТекСтрока.ДоляКоличествоПоРЕПО = ТекСтрока.КоличествоПоРЕПО * 100 / КоличествоПоРЕПОИтог;
						КонецЕсли;
						Если КоличествоСвободныеИтог = 0 Тогда
						    ТекСтрока.ДоляКоличествоСвободные = 0;
						Иначе
							ТекСтрока.ДоляКоличествоСвободные = ТекСтрока.КоличествоСвободные * 100 / КоличествоСвободныеИтог;
						КонецЕсли;
						
					КонецЦикла;
					ПараметрыБазиса.ВычисляемыеПоляЗаполнены = Истина;
					
				КонецЕсли;
				
				Если Отказ Тогда
				
					 Параметры.Вставить("ТекстОшибки", "Ошибка при расчете долей по базису");
					 Возврат;
				
				КонецЕсли; 
				
				#КонецОбласти 	
				
				#Область Заполнение_настроек_СКД_для_проверки_набора
				// добавляем группировку
				ПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
				ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ПараметрыПоказателя.ГруппировкаСтруктуры);
				
				// отборы
				Если НЕ СтрокаПоказателей.ОбъединятьОтборы Тогда
					Настройки.Отбор.Элементы.Очистить();
				КонецЕсли; 

			    // дополняем настройки СКД базиса отборами строки настройки контроля инвест декларации
				УсловияОтбора = СтрокаПоказателей.НаборИнвестиционнойДекларации.УсловияОтбора.Получить();
				
				УдалитьОтборПоБрокеру = Параметры.УдалитьОтборПоБрокеру И СтрокаПоказателей.НаборИнвестиционнойДекларации <> Справочники.НаборыИнвестиционныхДеклараций.НеРазрешенныеКПриобретению;
				ОтборПоБрокеруУдален = Ложь; // При автоматическом контроле на даты Т+ не учитываем ДС у брокера
				Справочники.ИнвестиционныеДекларации.ЗаполнитьОтбор(Настройки.Отбор, УсловияОтбора.Отбор, Ложь, УдалитьОтборПоБрокеру, ОтборПоБрокеруУдален);
				Справочники.ИнвестиционныеДекларации.ДополнитьОтборПоСтрокеПоказателей(Настройки.Отбор, СтрокаПоказателей, ГруппыЭмитентов, ГруппыАктивов);
				
				Справочники.ИнвестиционныеДекларации.ЗаполнитьПользовательскиеПоля(Настройки.ПользовательскиеПоля, УсловияОтбора.ПользовательскиеПоля);
				#КонецОбласти 
				
				#Область Получение_макета_компоновки_данных
				ИдентификаторСКДНабора = СтрокаПоказателей.НаборИнвестиционнойДекларации.ИдентификаторСКД;
				МакетКомпоновки = Неопределено;
				ПерезаписатьМакетКомпоновки = Истина;
				
				Если ПараметрыБазиса.ИдентификаторСКД = СтрокаПоказателей.ИдентификаторСКДБазиса 
					И ИдентификаторСКДНабора = СтрокаПоказателей.ИдентификаторСКДНабора Тогда
					
					Если ОтборПоБрокеруУдален Тогда
						// Т.к. отбор по брокеру удалили - использовать сохраненный макет компоновки нельзя, но и перезаписывать его тоже не нужно
						ПерезаписатьМакетКомпоновки = Ложь;
					Иначе
						МакетКомпоновки = СтрокаПоказателей.МакетКомпоновки.Получить();
						Если ТипЗнч(МакетКомпоновки) = Тип("МакетКомпоновкиДанных") Тогда
							Для каждого Параметр Из МакетКомпоновки.ЗначенияПараметров Цикл
								ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Параметр.Имя));
								Если ЗначениеПараметра <> Неопределено И ЗначениеПараметра.Использование Тогда
									Параметр.Значение = ЗначениеПараметра.Значение;
								КонецЕсли; 
							КонецЦикла; 
							
							ПерезаписатьМакетКомпоновки = Ложь;
							
						КонецЕсли;				
					КонецЕсли; 			
				КонецЕсли;				
				#КонецОбласти  
				
				#Область Проверка_показателей
				ТаблицаСоставНабора = ПолучитьРезультатКомпоновки(СКД, Настройки, Новый Структура("ТаблицаБазиса", ПараметрыБазиса.ТаблицаБазиса),, МакетКомпоновки);
				
				ТаблицаНесоответствийНаборовИД = Неопределено;
				НесоответствиеИнвестиционнойДекларации = Неопределено;
				СтатусНесоответствия = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПустаяСсылка();
				ДатаУстранения = '00010101';
				
				Если ПерезаписатьМакетКомпоновки Тогда
					СтрокиИДДляОбновления.Вставить(ТекущаяИД.Показатели.Индекс(СтрокаПоказателей), Новый Структура("МакетКомпоновки, ИдентификаторСКДНабора", МакетКомпоновки, ИдентификаторСКДНабора));
				КонецЕсли;
						
				Если СтрокаПоказателей.ОпределяетСоставИСтруктуру И  
					Не СтрокаПоказателей.НаборИнвестиционнойДекларации = Справочники.НаборыИнвестиционныхДеклараций.НеРазрешенныеКПриобретению Тогда
					
					ПараметрыОтбора = Новый Структура("ТекущийНаборДанных, ИспользоватьМинимальноеЗначениеРейтинга, СчетаДоверительногоУправления", 
						СтрокаПоказателей.Базис.НаборДанных, 
						ТекущаяИД.ИспользоватьМинимальноеЗначениеРейтинга,
						СтрокаТаблицыИД.СчетаДоверительногоУправления);
					ЗаполнитьКолонкуВходитВНабор(Параметры.ПараметрыБазисов, ТаблицаСоставНабора, ПараметрыОтбора);
					
					ПараметрыОтбора = Новый Структура("ТекущийНаборДанных, ИнвестиционнаяДекларация, Назначение", СтрокаПоказателей.Базис.НаборДанных, ТекущаяИД, ВыборкаИД.Назначение);
					ЗаполнитьКолонкуВходитВНабор(ТаблицаИнвестиционныхДеклараций, ТаблицаСоставНабора, ПараметрыОтбора);
					
				КонецЕсли;
				
				НайденныеСтроки = ТаблицаСоставНабора.НайтиСтроки(Новый Структура("ЦенныеБумагиОтсутствуетСтоимостьПереоценки", Истина), Истина);
				
				Для каждого ТекСтрока Из НайденныеСтроки Цикл
					
					ПараметрыОтбора = Новый Структура("Базис, Рынок, ЦеннаяБумага", 
						СтрокаПоказателей.Базис,
						ТекСтрока.ОсновныеВидАктива,
						ТекСтрока.ОсновныеАктив);
					
					Если ТаблицаОшибокОценки.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
					
						ЗаполнитьЗначенияСвойств(ТаблицаОшибокОценки.Добавить(), ПараметрыОтбора);
					
					КонецЕсли; 
				
				КонецЦикла; 
				
				МинимальноеЗначение = СтрокаПоказателей.МинимальноеЗначение;
				МаксимальноеЗначение = СтрокаПоказателей.МаксимальноеЗначение;
				
				ЗначениеПоказателя = 0;
				Доля = 0;
				
				РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
				
				#Область Текст_запроса_проверки_несоответствий
				ТекстЗапросаПроверкиНесоответствий = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.Нарушение) КАК Статус,
					|	1 КАК Приоритет
					|ПОМЕСТИТЬ _ПриоритетыСтатусов
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие),
					|	0
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТаблицаНесоответствийНабора.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	ТаблицаНесоответствийНабора.Классификация КАК Классификация,
					|	ТаблицаНесоответствийНабора.ВидАктива КАК ВидАктива,
					|	ТаблицаНесоответствийНабора.Актив КАК Актив,
					|	ТаблицаНесоответствийНабора.ДатаПоследнейПокупки КАК ДатаПоследнейПокупки,
					|	ТаблицаНесоответствийНабора.Количество КАК Количество,
					|	ТаблицаНесоответствийНабора.Статус КАК Статус,
					|	ТаблицаНесоответствийНабора.Регистратор КАК Регистратор,
					|	ТаблицаНесоответствийНабора.ДатаУстранения КАК ДатаУстранения
					|ПОМЕСТИТЬ ТаблицаНесоответствийНабора
					|ИЗ
					|	&ТаблицаНесоответствийНабора КАК ТаблицаНесоответствийНабора
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СоставНабора.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	СоставНабора.Классификация КАК Классификация,
					|	СоставНабора.ВидАктива КАК ВидАктива,
					|	СоставНабора.Актив КАК Актив,
					|	СоставНабора.ДатаПоследнейПокупки КАК ДатаПоследнейПокупки,
					|	СоставНабора.Количество КАК Количество
					|ПОМЕСТИТЬ СоставНабора
					|ИЗ
					|	&СоставНабора КАК СоставНабора
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	СоставНабора.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
					|	СоставНабора.ВидАктива КАК ВидАктива,
					|	СоставНабора.Актив КАК Актив,
					|	СоставНабора.Классификация КАК Классификация,
					|	СоставНабора.ДатаПоследнейПокупки КАК ДатаПоследнейПокупки,
					|	СоставНабора.Количество КАК Количество,
					|	ВЫБОР
					|		КОГДА ТаблицаНесоответствийНабора.Статус ЕСТЬ NULL
					|				ИЛИ ТИПЗНАЧЕНИЯ(СоставНабора.Актив) В (&ТипыЦенныхБумаг)
					|					И (ТаблицаНесоответствийНабора.Статус <> ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена)
					|							И СоставНабора.ДатаПоследнейПокупки > ТаблицаНесоответствийНабора.ДатаПоследнейПокупки
					|						ИЛИ СоставНабора.Количество > ТаблицаНесоответствийНабора.Количество)
					|				ИЛИ ТаблицаНесоответствийНабора.ДатаУстранения <> ДАТАВРЕМЯ(1, 1, 1)
					|					И ТаблицаНесоответствийНабора.ДатаУстранения < &Период
					|			ТОГДА 1
					|		ИНАЧЕ _ПриоритетыСтатусов.Приоритет
					|	КОНЕЦ КАК ПриоритетСтатуса,
					|	ЕСТЬNULL(ТаблицаНесоответствийНабора.Регистратор, ЗНАЧЕНИЕ(Документ.НесоответствиеИнвестиционнойДекларации.ПустаяСсылка)) КАК Регистратор,
					|	ЕСТЬNULL(ТаблицаНесоответствийНабора.ДатаУстранения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУстранения
					|ПОМЕСТИТЬ _СтатусыНесоответствий
					|ИЗ
					|	СоставНабора КАК СоставНабора
					|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНесоответствийНабора КАК ТаблицаНесоответствийНабора
					|		ПО СоставНабора.СчетДоверительногоУправления = ТаблицаНесоответствийНабора.СчетДоверительногоУправления
					|			И СоставНабора.ВидАктива = ТаблицаНесоответствийНабора.ВидАктива
					|			И СоставНабора.Актив = ТаблицаНесоответствийНабора.Актив
					|			И СоставНабора.Классификация = ТаблицаНесоответствийНабора.Классификация
					|		ЛЕВОЕ СОЕДИНЕНИЕ _ПриоритетыСтатусов КАК _ПриоритетыСтатусов
					|		ПО (ТаблицаНесоответствийНабора.Статус = _ПриоритетыСтатусов.Статус)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕСТЬNULL(СтатусНабора.Регистратор, ЗНАЧЕНИЕ(Документ.НесоответствиеИнвестиционнойДекларации.ПустаяСсылка)) КАК НесоответствиеИнвестиционнойДекларации,
					|	ЕСТЬNULL(СтатусНабора.ДатаУстранения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУстранения,
					|	ЕСТЬNULL(_ПриоритетыСтатусов.Статус, ЗНАЧЕНИЕ(Перечисление.РезультатыКонтроляИнвестиционнойДекларации.ПустаяСсылка)) КАК Статус
					|ИЗ
					|	(ВЫБРАТЬ
					|		МАКСИМУМ(_СтатусыНесоответствий.ПриоритетСтатуса) КАК ПриоритетСтатуса,
					|		МАКСИМУМ(_СтатусыНесоответствий.Регистратор) КАК Регистратор,
					|		МАКСИМУМ(_СтатусыНесоответствий.ДатаУстранения) КАК ДатаУстранения
					|	ИЗ
					|		_СтатусыНесоответствий КАК _СтатусыНесоответствий) КАК СтатусНабора
					|		ЛЕВОЕ СОЕДИНЕНИЕ _ПриоритетыСтатусов КАК _ПриоритетыСтатусов
					|		ПО СтатусНабора.ПриоритетСтатуса = _ПриоритетыСтатусов.Приоритет";
				#КонецОбласти 
				
				Для Каждого СтрокаТаблицы Из ТаблицаСоставНабора Цикл
					
					ЗначениеПоказателя = СтрокаТаблицы[СтрЗаменить(ПараметрыПоказателя.ПутьКДанным, ".", "")];
					Доля = СтрокаТаблицы[ПараметрыПоказателя.ИмяПоляДоля];
					
					ДоляВБазисеМин = ?(СтрокаПоказателей.АбсолютнаяВеличинаМин, ЗначениеПоказателя, Доля);
					ДоляВБазисеМакс = ?(СтрокаПоказателей.АбсолютнаяВеличинаМакс, ЗначениеПоказателя, Доля);
					
					МинимальноеЗначение = ?(ТипЗнч(СтрокаПоказателей.МинимальноеЗначение) = Тип("Строка"), СтрокаТаблицы[СтрЗаменить(СтрокаПоказателей.МинимальноеЗначение, ".", "")], СтрокаПоказателей.МинимальноеЗначение);
					МаксимальноеЗначение = ?(ТипЗнч(СтрокаПоказателей.МаксимальноеЗначение) = Тип("Строка"), СтрокаТаблицы[СтрЗаменить(СтрокаПоказателей.МаксимальноеЗначение, ".", "")], СтрокаПоказателей.МаксимальноеЗначение);
					
					ПроверкаМин = (ДоляВБазисеМин >= МинимальноеЗначение);
					
					Если СтрокаПоказателей.АбсолютнаяВеличинаМакс Тогда
						ПроверкаМакс = ?(МаксимальноеЗначение = 0, Истина, ДоляВБазисеМакс <= МаксимальноеЗначение);
					Иначе
						ПроверкаМакс = ?(МаксимальноеЗначение = 0 И ДоляВБазисеМакс = 0, Истина, ДоляВБазисеМакс < МаксимальноеЗначение);
					КонецЕсли; 
					
					Если Не (ПроверкаМин И ПроверкаМакс) Тогда
						
						// проверим несоответствие
						#Область Проверка_несоответствий
						Если Параметры.Свойство("ТаблицаНесоответствийНаборовИД", ТаблицаНесоответствийНаборовИД) Тогда
							
							ИмяКолонкиГруппа = СтрЗаменить(ПараметрыПоказателя.ГруппировкаСтруктуры, ".", "");
							Группа = ?(ИмяКолонкиГруппа = "СлужебныеОбщийИтог", Неопределено, СтрокаТаблицы[ИмяКолонкиГруппа]);
							ОтборСтрокТаблицыНесоответствий = Новый Структура("ИдентификаторСтрокиПоказателей, Группа, ИнвестиционнаяДекларация", 
								СтрокаПоказателей.ИдентификаторСтрокиПоказателей, Группа, ТекущаяИД);
								
							Если Не ВыборкаИД.СовокупныйКонтроль Тогда
							
								ОтборСтрокТаблицыНесоответствий.Вставить("СчетДоверительногоУправления", СтрокаТаблицыИД.СчетаДоверительногоУправления[0]);
							
							КонецЕсли; 
							
							ТаблицаНесоответствийНабора = ТаблицаНесоответствийНаборовИД.Скопировать(ОтборСтрокТаблицыНесоответствий);
							
							Если ТаблицаНесоответствийНабора.Количество() > 0 Тогда
						
								СоставНабора = ТаблицаНесоответствийНабора.СкопироватьКолонки("СчетДоверительногоУправления, ВидАктива, Актив, ДатаПоследнейПокупки, Количество, Классификация");
								
								Для каждого Строка Из СтрокаТаблицы.Строки Цикл
								
									СтрокаСостав = СоставНабора.Добавить();
									СтрокаСостав.СчетДоверительногоУправления 	= Строка.СлужебныеСчетДоверительногоУправленияСсылка;
									СтрокаСостав.Классификация 					= Строка.ЦенныеБумагиКлассификация;
									СтрокаСостав.ВидАктива 						= Строка.ОсновныеВидАктива;
									СтрокаСостав.Актив 							= Строка.ОсновныеАктив;
									СтрокаСостав.ДатаПоследнейПокупки 			= Строка.ОсновныеДатаПоследнейПокупки;
									СтрокаСостав.Количество 					= Строка.ЦенныеБумагиКоличество;
									
								КонецЦикла;
								
								Запрос = Новый Запрос(ТекстЗапросаПроверкиНесоответствий);
								Запрос.УстановитьПараметр("ТаблицаНесоответствийНабора", 	ТаблицаНесоответствийНабора);
								Запрос.УстановитьПараметр("СоставНабора", 					СоставНабора);
								Запрос.УстановитьПараметр("ТипыЦенныхБумаг", 				Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы());
								Запрос.УстановитьПараметр("Период", 						НачалоДня(Параметры.Период));
								
								Выборка = Запрос.Выполнить().Выбрать();
								Если Выборка.Следующий() Тогда
									СтатусНесоответствия = Выборка.Статус;
									НесоответствиеИнвестиционнойДекларации = Выборка.НесоответствиеИнвестиционнойДекларации;
									ДатаУстранения = Выборка.ДатаУстранения;
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;					
						#КонецОбласти 
						
						РезультатПроверки = ?(СтатусНесоответствия = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПустаяСсылка(), 
							Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение,
							СтатусНесоответствия);
						
						Если Не ЗаполнитьСводнуюТаблицу Тогда 
							Прервать;
						КонецЕсли;
						
					КонецЕсли;
					
					#Область Заполнение_сводной_таблицы
					Если ЗаполнитьСводнуюТаблицу И Не СтрокаПоказателей.ВнутреннийНабор Тогда
						// добавим строки в своюную таблицу
						
						Если Не (ФиксироватьТолькоНарушения И ПроверкаМин И ПроверкаМакс) Тогда
							// добавляем либо все строки (ФиксироватьТолькоНарушения = Ложь)
							// либо только строки с нарушениями
							Если ПараметрыПоказателя.ГруппировкаСтруктуры = "Служебные.ОбщийИтог" Тогда
								Группировка = "";
							Иначе
								ИмяПоляГруппировки = СтрЗаменить(ПараметрыПоказателя.ГруппировкаСтруктуры, ".", "");
								Группировка = СтрокаТаблицы[ИмяПоляГруппировки];
							КонецЕсли; 
							
							РезультатПроверкиДляСводной = ?(ПроверкаМин И ПроверкаМакс,
								Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена,
								РезультатПроверки);
								
							Если РезультатПроверкиДляСводной <> Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Несоответствие Тогда
							
								НоваяСтрока = СводнаяТаблицаРезультатовКонтроля.Добавить();
								НоваяСтрока.СчетДоверительногоУправления 		= СтрСоединить(СтрокаТаблицыИД.СчетаДоверительногоУправления, "; ");;
								НоваяСтрока.Клиент 								= Параметры.Клиент;
								НоваяСтрока.ВидДоговораДоверительногоуправления = Параметры.ВидДоговораДоверительногоуправления;
								НоваяСтрока.ИнвестиционнаяДекларация			= ТекущаяИД;
								НоваяСтрока.Назначение							= ВыборкаИД.Назначение;
								НоваяСтрока.СовокупныйКонтроль					= ВыборкаИД.СовокупныйКонтроль;
								НоваяСтрока.Период								= Параметры.Период;
								НоваяСтрока.Базис 								= СтрокаПоказателей.Базис;
								НоваяСтрока.Набор 								= СтрокаПоказателей.НаборИнвестиционнойДекларации;
								НоваяСтрока.ВнутреннийНабор 					= СтрокаПоказателей.ВнутреннийНабор;
								НоваяСтрока.Группировка 						= Группировка;
								НоваяСтрока.РезультатПроверки 					= РезультатПроверкиДляСводной;
								НоваяСтрока.ОшибкиОценки 						= ПараметрыБазиса.ОтсутствуетСтоимостьПереоценки;
								НоваяСтрока.ИдентификаторРезультата 			= Параметры.ИдентификаторРезультата;
								НоваяСтрока.Показатель 							= ПараметрыПоказателя.Представление;
								НоваяСтрока.МинимальноеЗначение 				= МинимальноеЗначение;
								НоваяСтрока.АбсолютнаяВеличинаМин 				= СтрокаПоказателей.АбсолютнаяВеличинаМин;
								НоваяСтрока.МаксимальноеЗначение 				= МаксимальноеЗначение;
								НоваяСтрока.АбсолютнаяВеличинаМакс 				= СтрокаПоказателей.АбсолютнаяВеличинаМакс;
								НоваяСтрока.Значение 							= ЗначениеПоказателя;
								НоваяСтрока.Доля 								= Доля;
								
								Если ЗначениеЗаполнено(СтрокаПоказателей.Эмитент) Тогда
									НоваяСтрока.ОтборПоЭмитенту = СтрокаПоказателей.Эмитент;
								КонецЕсли;
								Если ЗначениеЗаполнено(СтрокаПоказателей.ГруппаЭмитентов) Тогда
									НоваяСтрока.ОтборПоЭмитенту = "Группа " + ГруппыЭмитентов.Получить(СтрокаПоказателей.ГруппаЭмитентов).Имя;
								КонецЕсли;
								Если ЗначениеЗаполнено(СтрокаПоказателей.ЦеннаяБумага) Тогда
									НоваяСтрока.ОтборПоЦеннойБумаге = СтрокаПоказателей.ЦеннаяБумага;
								КонецЕсли;
								Если ЗначениеЗаполнено(СтрокаПоказателей.ГруппаЦенныхБумаг) Тогда
									НоваяСтрока.ОтборПоЦеннойБумаге = ГруппыАктивов.Получить(СтрокаПоказателей.ГруппаЦенныхБумаг).Имя;
								КонецЕсли;
								Если ЗначениеЗаполнено(СтрокаПоказателей.ДатаЗапретаПокупки) Тогда
									НоваяСтрока.ДатаЗапретаПокупки = "Запрет покупки с " + Формат(СтрокаПоказателей.ДатаЗапретаПокупки, "ДФ=dd.MM.yyyy");
								КонецЕсли;
								
								Если СтрокаПоказателей.АбсолютнаяВеличинаМакс И МаксимальноеЗначение = 0 Тогда
									НоваяСтрока.МаксимальныйЛимит = ЗначениеБазы;
								ИначеЕсли СтрокаПоказателей.АбсолютнаяВеличинаМакс Тогда
									НоваяСтрока.МаксимальныйЛимит = МаксимальноеЗначение;
								Иначе
									НоваяСтрока.МаксимальныйЛимит = МаксимальноеЗначение * ЗначениеБазы * 0.01;
								КонецЕсли; 
								
								НоваяСтрока.СвободныйЛимит = НоваяСтрока.МаксимальныйЛимит - ЗначениеПоказателя;								
							
							КонецЕсли;
						
						КонецЕсли; 
						
					КонецЕсли;				
					#КонецОбласти  
					
				КонецЦикла;
					
				ПустаяТаблица = (ТаблицаСоставНабора.Количество() = 0) ИЛИ (ТаблицаСоставНабора.Количество() = 1 И ЗначениеПоказателя = 0);
				
				Если ПараметрыБазиса.ОтсутствуетСтоимостьПереоценки Тогда
					
					РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.Нарушение;
					
				ИначеЕсли ПустаяТаблица И (СтрокаПоказателей.МинимальноеЗначение = 0) Тогда 
					
					РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена;
					
				КонецЕсли; 
				
				Если ТаблицаСоставНабора.Количество() > 1 Тогда
				
					Сумма = 0;
					Доля = 0;
					ГруппаРезультатов = Истина;
					
				Иначе
					
					Сумма = ЗначениеПоказателя;
					Доля = Доля;
					ГруппаРезультатов = Ложь;
				
				КонецЕсли;
				
				#КонецОбласти 
				 
				Если ЗначениеЗаполнено(НесоответствиеИнвестиционнойДекларации) И ЗначениеЗаполнено(ДатаУстранения) И НесоответствиеИнвестиционнойДекларации.Статус = РезультатПроверки Тогда
					УстранитьДо = ", устранить до " + Формат(ДатаУстранения, "ДФ=dd.MM.yyyy");
				ИначеЕсли ЗначениеЗаполнено(НесоответствиеИнвестиционнойДекларации) И НесоответствиеИнвестиционнойДекларации.Статус = РезультатПроверки Тогда
					УстранитьДо = " без даты устранения";
				Иначе
					УстранитьДо = "";
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(УстранитьДо) Тогда
				
					КомментарийНесоответствия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НесоответствиеИнвестиционнойДекларации, "Комментарий");
					Если ЗначениеЗаполнено(КомментарийНесоответствия) Тогда
						УстранитьДо = УстранитьДо + Символы.ПС + КомментарийНесоответствия;
					КонецЕсли; 
								
				КонецЕсли; 
				
				НоваяСтрока = КоллекцияЭлементов.Добавить(); // заполняем дерево результатов
				
				ИмяВложенногоОбъекта = ?(ЗначениеЗаполнено(ВыборкаИД.Назначение), ВыборкаИД.Назначение.Номер + "/", "") + ТекущаяИД.Код + "/" + СтрокаПоказателей.НомерСтроки;
				
				НоваяСтрока.НомерБазиса 				= ПараметрыБазиса.НомерБазиса;
				НоваяСтрока.ИмяПоляДоля 				= ПараметрыПоказателя.ИмяПоляДоля;
				НоваяСтрока.ИнвестиционнаяДекларация 	= ТекущаяИД;
				НоваяСтрока.Назначение					= ВыборкаИД.Назначение;
				НоваяСтрока.УсловияОтбора 				= СтрокаПоказателей.НаборИнвестиционнойДекларации;
				НоваяСтрока.ИмяВложенногоОбъекта 		= ИмяВложенногоОбъекта;
				НоваяСтрока.Сумма 						= Сумма;
				НоваяСтрока.Доля 						= Доля;
				НоваяСтрока.ГруппаРезультатов			= ГруппаРезультатов;
				НоваяСтрока.Гиперссылка 				= Строка(РезультатПроверки) + УстранитьДо;// + ОписаниеДействия;
				НоваяСтрока.РезультатПроверки 			= РезультатПроверки;
				НоваяСтрока.МинимальноеЗначение			= МинимальноеЗначение;
				НоваяСтрока.МаксимальноеЗначение		= МаксимальноеЗначение;
				НоваяСтрока.ДатаУстранения 				= ДатаУстранения;
				НоваяСтрока.НесоответствиеИнвестиционнойДекларации = НесоответствиеИнвестиционнойДекларации;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоказателей, "ИдентификаторСтрокиПоказателей, КонтролируемыйПоказатель, АбсолютнаяВеличинаМин, АбсолютнаяВеличинаМакс, ЦелевоеЗначение, АбсолютнаяВеличинаЦель, 
					|ВнутреннийНабор, ОпределяетСоставИСтруктуру, Эмитент, ГруппаЭмитентов, ВключаяФилиалы, ГруппаЦенныхБумаг, ЦеннаяБумага, НомерСтроки");
				Если ЗначениеЗаполнено(НоваяСтрока.Эмитент) Тогда
					НоваяСтрока.ОтборПоЭмитенту = НоваяСтрока.Эмитент;
				КонецЕсли;
				Если ЗначениеЗаполнено(НоваяСтрока.ГруппаЭмитентов) Тогда
					НоваяСтрока.ГруппаЭмитентовИмя = ГруппыЭмитентов.Получить(НоваяСтрока.ГруппаЭмитентов).Имя;
					НоваяСтрока.ОтборПоЭмитенту = "Группа " + НоваяСтрока.ГруппаЭмитентовИмя;			
				КонецЕсли;
				Если ЗначениеЗаполнено(НоваяСтрока.ЦеннаяБумага) Тогда
					НоваяСтрока.ОтборПоЦеннойБумаге = НоваяСтрока.ЦеннаяБумага;
				КонецЕсли;
				Если ЗначениеЗаполнено(НоваяСтрока.ГруппаЦенныхБумаг) Тогда
					НоваяСтрока.ГруппаЦенныхБумагИмя = ГруппыАктивов.Получить(НоваяСтрока.ГруппаЦенныхБумаг).Имя;
					НоваяСтрока.ОтборПоЦеннойБумаге = "Группа активов " + НоваяСтрока.ГруппаЦенныхБумагИмя;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаПоказателей.ДатаЗапретаПокупки) Тогда
					НоваяСтрока.ДатаЗапретаПокупки = "Запрет покупки с " + Формат(СтрокаПоказателей.ДатаЗапретаПокупки, "ДФ=dd.MM.yyyy");
				КонецЕсли;
						
				ПредставлениеНабора = Новый Массив;
				ПредставлениеНабора.Добавить(НоваяСтрока.УсловияОтбора.Наименование);
				Если ЗначениеЗаполнено(НоваяСтрока.ОтборПоЭмитенту) Тогда
					ПредставлениеНабора.Добавить(НоваяСтрока.ОтборПоЭмитенту + ?(СтрокаПоказателей.ВключаяФилиалы, " (включая филиалы)", ""));
				КонецЕсли; 
				Если ЗначениеЗаполнено(НоваяСтрока.ОтборПоЦеннойБумаге) Тогда
					ПредставлениеНабора.Добавить(НоваяСтрока.ОтборПоЦеннойБумаге);
				КонецЕсли; 
				Если ЗначениеЗаполнено(НоваяСтрока.ДатаЗапретаПокупки) Тогда
					ПредставлениеНабора.Добавить(НоваяСтрока.ДатаЗапретаПокупки);
				КонецЕсли;
												
				НоваяСтрока.ПредставлениеНабора = Формат(СтрокаПоказателей.НомерСтроки, "ЧГ=0") + ". " + СтрСоединить(ПредставлениеНабора, "; ") + ?(СтрокаПоказателей.ВнутреннийНабор, " (внутр.) ", "");
				
				// создаем настройки для вывода расшифровки по строке из вложенной СКД
				СформироватьНастройкиВложенногоОбъекта(НоваяСтрока.ИмяВложенногоОбъекта, НастройкиОтчета, Настройки, СтрокаПоказателей, 
					ПараметрыПоказателя, ПараметрыБазиса, ПустаяТаблица, Параметры, МинимальноеЗначение, МаксимальноеЗначение, ГруппыЭмитентов, ГруппыАктивов, 
					СовокупныйКонтроль, ЭтоКлиентТрадиция, ТекущаяИД);

				Если Консолидирующая И РезультатПроверки = Перечисления.РезультатыКонтроляИнвестиционнойДекларации.ПроверкаПройдена Тогда
					ПроверитьИнвестДекларацию(Параметры, НоваяСтрока.Строки, СтрокаПоказателей.ИнвестиционнаяДекларация, СтруктураОтчета);
				КонецЕсли; 
						
			КонецЦикла; 
			
			Если СтрокиИДДляОбновления.Количество() > 0 Тогда
			
				УстановитьПривилегированныйРежим(Истина);
				ОбъектИД = ТекущаяИД.ПолучитьОбъект();
				Для каждого СтрокаИДДляОбновления Из СтрокиИДДляОбновления Цикл
					ТекСтрока = ОбъектИД.Показатели[СтрокаИДДляОбновления.Ключ];
					ТекСтрока.ИдентификаторСКДБазиса = Параметры.ПараметрыБазисов.НайтиСтроки(Новый Структура("Базис, ИспользоватьМинимальноеЗначениеРейтинга", ТекСтрока.Базис, ТекущаяИД.ИспользоватьМинимальноеЗначениеРейтинга))[0].Параметры.ИдентификаторСКД;
					ТекСтрока.ИдентификаторСКДНабора = СтрокаИДДляОбновления.Значение.ИдентификаторСКДНабора;
					ТекСтрока.МакетКомпоновки = Новый ХранилищеЗначения(СтрокаИДДляОбновления.Значение.МакетКомпоновки, Новый СжатиеДанных(9));
				КонецЦикла;
				Попытка
					ОбъектИД.Записать();
				Исключение
				КонецПопытки;
				УстановитьПривилегированныйРежим(Ложь);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СтруктураФормированияОтчета = Новый Структура;
	СтруктураФормированияОтчета.Вставить("СКД", СКДОтчета);
	СтруктураФормированияОтчета.Вставить("Настройки", НастройкиОтчета);
	СтруктураФормированияОтчета.Вставить("ВнешниеНаборыДанных", ВнешниеНаборыДанныхОтчета);
	
	СтруктураОтчетов = Параметры.Отчеты.Получить();
	СтруктураОтчетов.Вставить("ТаблицаОшибокОценки", ТаблицаОшибокОценки);
	
	СжатиеДанных = Новый СжатиеДанных(9);
	Параметры.Вставить("ПараметрыБазисов", Новый ХранилищеЗначения(Параметры.ПараметрыБазисов, СжатиеДанных));
	Параметры.Вставить("СтруктураФормированияОтчета", Новый ХранилищеЗначения(СтруктураФормированияОтчета, СжатиеДанных));
	Параметры.Вставить("СтруктураОтчетов", Новый ХранилищеЗначения(СтруктураОтчетов, СжатиеДанных));
	Параметры.Вставить("СводнаяТаблицаРезультатовКонтроля", Новый ХранилищеЗначения(СводнаяТаблицаРезультатовКонтроля, СжатиеДанных));
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

#Область Процедуры_контроля

Процедура СформироватьПараметрыБазисов(Параметры)

	УстановитьПривилегированныйРежим(Истина);
	
	// получаем все базисы по выбранной инвестдекларации
	Запрос = Новый Запрос;
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	СоставСовокупнойИД.КодСчета КАК КодСчета,
		|	СоставСовокупнойИД.Организация КАК Организация,
		|	СоставСовокупнойИД.Клиент КАК Клиент,
		|	СоставСовокупнойИД.ВалютаУчета КАК ВалютаУчета,
		|	СоставСовокупнойИД.Назначение КАК Назначение
		|ПОМЕСТИТЬ _СоставСовокупнойИД
		|ИЗ
		|	&СоставСовокупнойИД КАК СоставСовокупнойИД
		|ГДЕ
		|	СоставСовокупнойИД.Включен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.Назначение КАК Назначение,
		|	ВложенныйЗапрос.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.КодСчета КАК КодСчета,
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	ВложенныйЗапрос.ВалютаУчета КАК ВалютаУчета,
		|	ИнвестиционныеДекларации.ИспользоватьМинимальноеЗначениеРейтинга КАК ИспользоватьМинимальноеЗначениеРейтинга,
		|	ИнвестиционныеДекларацииПоказатели.Базис КАК Базис
		|ПОМЕСТИТЬ _Базисы
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_СоставСовокупнойИД.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|		_СоставСовокупнойИД.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_СоставСовокупнойИД.КодСчета КАК КодСчета,
		|		_СоставСовокупнойИД.Организация КАК Организация,
		|		_СоставСовокупнойИД.Клиент КАК Клиент,
		|		_СоставСовокупнойИД.ВалютаУчета КАК ВалютаУчета,
		|		_СоставСовокупнойИД.Назначение КАК Назначение
		|	ИЗ
		|		_СоставСовокупнойИД КАК _СоставСовокупнойИД
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ИнвестиционныеДекларацииПоказатели.ИнвестиционнаяДекларация,
		|		_СоставСовокупнойИД.СчетДоверительногоУправления,
		|		_СоставСовокупнойИД.КодСчета,
		|		_СоставСовокупнойИД.Организация,
		|		_СоставСовокупнойИД.Клиент,
		|		_СоставСовокупнойИД.ВалютаУчета,
		|		_СоставСовокупнойИД.Назначение
		|	ИЗ
		|		Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СоставСовокупнойИД КАК _СоставСовокупнойИД
		|			ПО ИнвестиционныеДекларацииПоказатели.Ссылка = _СоставСовокупнойИД.ИнвестиционнаяДекларация) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации КАК ИнвестиционныеДекларации
		|		ПО ВложенныйЗапрос.ИнвестиционнаяДекларация = ИнвестиционныеДекларации.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвестиционныеДекларации.Показатели КАК ИнвестиционныеДекларацииПоказатели
		|		ПО ВложенныйЗапрос.ИнвестиционнаяДекларация = ИнвестиционныеДекларацииПоказатели.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Базисы.Базис КАК Базис,
		|	БазисыКонтроляИнвестиционныхДеклараций.ХранилищеСКД КАК ХранилищеСКД,
		|	БазисыКонтроляИнвестиционныхДеклараций.ХранилищеНастроек КАК ХранилищеНастроек,
		|	БазисыКонтроляИнвестиционныхДеклараций.НаборДанных КАК НаборДанных,
		|	БазисыКонтроляИнвестиционныхДеклараций.РежимПолученияБазы КАК РежимПолученияБазы,
		|	БазисыКонтроляИнвестиционныхДеклараций.ИдентификаторСКД КАК ИдентификаторСКД
		|ПОМЕСТИТЬ _РеквизитыБазисов
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_Базисы.Базис КАК Базис
		|	ИЗ
		|		_Базисы КАК _Базисы) КАК _Базисы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БазисыКонтроляИнвестиционныхДеклараций КАК БазисыКонтроляИнвестиционныхДеклараций
		|		ПО _Базисы.Базис = БазисыКонтроляИнвестиционныхДеклараций.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Базисы.Базис КАК Базис,
		|	_Базисы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Базисы.КодСчета КАК КодСчета,
		|	_Базисы.Организация КАК Организация,
		|	_Базисы.Клиент КАК Клиент,
		|	_Базисы.ВалютаУчета КАК ВалютаУчета,
		|	_Базисы.ИспользоватьМинимальноеЗначениеРейтинга КАК ИспользоватьМинимальноеЗначениеРейтинга
		|ИЗ
		|	_Базисы КАК _Базисы";		
	#КонецОбласти 
	
	Параметры.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СоставСовокупнойИД", Параметры.СоставСовокупнойИнвестДекларации);
	
	Результат = Запрос.Выполнить();
	
	РеквизитыБазисов = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыБазисов").ПолучитьДанные().Выгрузить();
	Выборка = Результат.Выбрать();
	
	Запрос.Текст = "УНИЧТОЖИТЬ _СоставСовокупнойИД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РеквизитыБазисов";
	Запрос.Выполнить();
	
	Если Параметры.Свойство("ПараметрыБазисов") Тогда
		ПараметрыБазисов = Параметры.ПараметрыБазисов;
		НомерБазиса = Параметры.ПараметрыБазисов.Количество(); // НомерБазиса используется для идентификации вложенных схем КД при формировании отчета
	Иначе
		ПараметрыБазисов = Новый ТаблицаЗначений;
		ПараметрыБазисов.Колонки.Добавить("Базис", Новый ОписаниеТипов("СправочникСсылка.БазисыКонтроляИнвестиционныхДеклараций"));
		ПараметрыБазисов.Колонки.Добавить("ИспользоватьМинимальноеЗначениеРейтинга", Новый ОписаниеТипов("Булево"));
		ПараметрыБазисов.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ПараметрыБазисов.Колонки.Добавить("Параметры", Новый ОписаниеТипов("Структура"));
		Параметры.Вставить("ПараметрыБазисов", ПараметрыБазисов);
		НомерБазиса = 0;
	КонецЕсли; 
	
	Параметры.Вставить("ПлюсТриРабочихДня", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, Параметры.Период + 24*3600, 3));
	КонтрольЗаПрошлыйПериод = НачалоДня(ТекущаяДатаСеанса()) > НачалоДня(Параметры.Период);
	
	СтруктураОтчетов 				= Новый Структура;
	
	ПовтИспРасчетПартий 			= Новый Соответствие;
	ПовтИспТаблицаСЧА 				= Новый Соответствие;
	ПовтИспМенеджерВременныхТаблиц 	= Новый Соответствие;
	
	КлиентТрадиция = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_Традиция");
	Организация_РЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	Организация_ТрастМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
	УстановитьПривилегированныйРежим(Ложь);
	КонтрольВПривилегированномРежиме = Неопределено;
	
	// формируем структуру параметров, добавляем в соответствие ПараметрыБазисов
	ТекКлиент = Неопределено;
	Пока Выборка.Следующий() Цикл
		
		Если КонтрольВПривилегированномРежиме = Неопределено Тогда
		
			КонтрольВПривилегированномРежиме = (Выборка.Клиент = КлиентТрадиция 
				И (Выборка.Организация = Организация_РЭМ Или Выборка.Организация = Организация_ТрастМ));
		
		КонецЕсли;			
		
		РеквизитыБазиса = РеквизитыБазисов.Найти(Выборка.Базис, "Базис");
		
	 	СКДХранилище = РеквизитыБазиса.ХранилищеСКД;
		
		Попытка
			СКД = СКДХранилище.Получить();
		Исключение
			ВызватьИсключение "Не удалось получить СКД базиса";
		КонецПопытки; 
		
		НастройкиХранилище = РеквизитыБазиса.ХранилищеНастроек;
		
		Попытка
			Настройки = НастройкиХранилище.Получить();
		Исключение
			ВызватьИсключение "Не удалось получить настройки базиса";
		КонецПопытки;
		
		Если Выборка.ИспользоватьМинимальноеЗначениеРейтинга Тогда
			НаборДанныхРейтинги = СКД.НаборыДанных.Найти("Рейтинги");
			Если ТипЗнч(НаборДанныхРейтинги) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
				НаборДанныхРейтинги.Запрос = СтрЗаменить(НаборДанныхРейтинги.Запрос, "МИНИМУМ(_РасчетРейтингов.Приоритет", "МАКСИМУМ(_РасчетРейтингов.Приоритет"); // !хардкод 
				СКДХранилище = Новый ХранилищеЗначения(СКД, Новый СжатиеДанных(9));
			КонецЕсли;
		КонецЕсли;
					
		ПараметрыФормированияБазиса = Новый Структура;
		Для каждого ПараметрСКД Из Настройки.ПараметрыДанных.Элементы Цикл
			Если ПараметрСКД.Использование Тогда
				ПараметрыФормированияБазиса.Вставить(ПараметрСКД.Параметр, ПараметрСКД.Значение); 
			КонецЕсли; 
		КонецЦикла; 
		
		ПараметрыФормированияБазиса.Вставить("Период", 										КонецДня(Параметры.Период));
		ПараметрыФормированияБазиса.Вставить("грПериод", 									Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая));
		ПараметрыФормированияБазиса.Вставить("КонтрольЗаПрошлыйПериод", 					КонтрольЗаПрошлыйПериод);
		ПараметрыФормированияБазиса.Вставить("УчитыватьПлановыеОперации", 					Параметры.УчитыватьПлановыеОперации);
		ПараметрыФормированияБазиса.Вставить("ДинамическийРасчетСтоимости",					Параметры.ДинамическийРасчетСтоимости);
		
		ПараметрыПолученияТаблицыПлановыхОпераций = Неопределено;
		
		Если Не Параметры.Свойство("ПараметрыПолученияТаблицыПлановыхОпераций", ПараметрыПолученияТаблицыПлановыхОпераций) Тогда
			ПараметрыПолученияТаблицыПлановыхОпераций = ПолучитьПараметрыПолученияТаблицыПлановыхОпераций(Параметры.Период, Выборка.Организация, Выборка.СчетДоверительногоУправления);
		КонецЕсли; 
		
		ПараметрыФормированияБазиса.Вставить("ПараметрыПолученияТаблицыПлановыхОпераций", 	ПараметрыПолученияТаблицыПлановыхОпераций);
		
		ОбщиеПараметрыФормированияБазиса = Новый ФиксированнаяСтруктура(ПараметрыФормированияБазиса);
		
		МенеджерСправочника = Справочники.БазисыКонтроляИнвестиционныхДеклараций;
		ТаблицаБазиса 			= Неопределено;
		ТаблицаСЧА 				= Неопределено;
		ЗначениеБазы 			= Неопределено;
		
		Если КонтрольВПривилегированномРежиме Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли; 
		
		ПараметрыФормированияБазиса = Новый Структура(ОбщиеПараметрыФормированияБазиса); // пересоздаем структуру с общими параметрами
		
		ЦельРасчета 						= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
		
		НастройкиОценки 					= РаботаСПереоценкой.ОпределитьНастройкиОценки(Параметры.Период, Выборка.Организация, Выборка.СчетДоверительногоУправления, ЦельРасчета, Истина);
		
		Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
			Параметры.Вставить("ТекстОшибки", "По клиенту '" + Выборка.СчетДоверительногоУправления + "' отсутствуют настройки для цели расчета 'Оценка объектов в управлении'!");
			Возврат;
		КонецЕсли; 
		
		ВидУчета 							= НастройкиОценки.ВидУчетаДляОстатковПартий;
		ВариантРасчетаОценочнойСтоимости 	= НастройкиОценки.ВариантРасчетаОценочнойСтоимости;
		
		ВыполнятьРасчетПоУказаниюЦБ			= НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316;
		ВестиРасчетПоПартиям				= НастройкиОценки.ВестиРасчетПоПартиям ИЛИ ВыполнятьРасчетПоУказаниюЦБ;
		
		ИспользованаМетодикаРасчетаПоНовойСхеме =
			Не ВестиРасчетПоПартиям
			И Не ВыполнятьРасчетПоУказаниюЦБ
			И Справочники.ВариантыРасчетаОценочнойСтоимости.ИспользованаМетодикаРасчетаПоНовойСхеме(ЦельРасчета, ВариантРасчетаОценочнойСтоимости);	
			
		ПараметрыФормированияБазиса.Вставить("ВестиРасчетПоПартиям", 							ВестиРасчетПоПартиям);
		ПараметрыФормированияБазиса.Вставить("ВыполнятьРасчетПоУказаниюЦБ5419", 				ВыполнятьРасчетПоУказаниюЦБ);
		ПараметрыФормированияБазиса.Вставить("ИспользованаМетодикаРасчетаПоНовойСхеме", 		ИспользованаМетодикаРасчетаПоНовойСхеме);
		ПараметрыФормированияБазиса.Вставить("СписыватьПриПолномПогашенииВМоментПогашения", 	БухгалтерскийУчет.ОпределитьНастройкуУчета(Параметры.Период, Выборка.Организация, Выборка.СчетДоверительногоУправления, "СписыватьПриПолномПогашенииВМоментПогашения"));
		ПараметрыФормированияБазиса.Вставить("Претрейд", Параметры.Претрейд.Скопировать(Новый Структура("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления)));
		
		Если ТипЗнч(ПараметрыФормированияБазиса.ПараметрыПолученияТаблицыПлановыхОпераций) = Тип("Структура") Тогда
		
			ПараметрыФормированияБазиса.ПараметрыПолученияТаблицыПлановыхОпераций.Вставить("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления);
		
		КонецЕсли; 			
		
		ПараметрыФормированияБазиса.Вставить("СчетДоверительногоУправления", 		Выборка.СчетДоверительногоУправления);
		ПараметрыФормированияБазиса.Вставить("Организация", 						Выборка.Организация);
		ПараметрыФормированияБазиса.Вставить("ВидУчета", 							ВидУчета);
		ПараметрыФормированияБазиса.Вставить("ЦельРасчета", 						ЦельРасчета);
		ПараметрыФормированияБазиса.Вставить("ВариантРасчетаОценочнойСтоимости", 	ВариантРасчетаОценочнойСтоимости);
		ПараметрыФормированияБазиса.Вставить("ВалютаУчета", 						Выборка.ВалютаУчета);
		ПараметрыФормированияБазиса.Вставить("РасчетПартий", 						ПовтИспРасчетПартий.Получить(Выборка.СчетДоверительногоУправления));
		
		ПараметрыФормированияБазиса.Вставить("МенеджерВременныхТаблиц", 			ПовтИспМенеджерВременныхТаблиц.Получить(Выборка.СчетДоверительногоУправления));
		ПараметрыФормированияБазиса.Вставить("ТаблицаСЧА", 							ПовтИспТаблицаСЧА.Получить(Выборка.СчетДоверительногоУправления));
							
		ДанныеБазиса = МенеджерСправочника.ПолучитьДанныеБазиса(РеквизитыБазиса.НаборДанных, ПараметрыФормированияБазиса, РеквизитыБазиса.РежимПолученияБазы);
		Если ПараметрыФормированияБазиса.Свойство("ТекстОшибки") Тогда
			Параметры.Вставить("ТекстОшибки", "Не удалось получить данные базиса по клиенту '" + 
				Выборка.СчетДоверительногоУправления + 
				"'. Система сообщает: " + ПараметрыФормированияБазиса.ТекстОшибки);
			Возврат;
		КонецЕсли; 
		
		Если ПараметрыФормированияБазиса.Свойство("ИспользованыПредварительныеЦены") Тогда
			Параметры.Вставить("ИспользованыПредварительныеЦены");
		КонецЕсли; 
		
		Если Не ПараметрыФормированияБазиса.МенеджерВременныхТаблиц = Неопределено Тогда
			ПовтИспМенеджерВременныхТаблиц.Вставить(Выборка.СчетДоверительногоУправления, ПараметрыФормированияБазиса.МенеджерВременныхТаблиц);
		КонецЕсли; 
		Если Не ПараметрыФормированияБазиса.ТаблицаСЧА = Неопределено Тогда
			ПовтИспТаблицаСЧА.Вставить(Выборка.СчетДоверительногоУправления, ПараметрыФормированияБазиса.ТаблицаСЧА);
		КонецЕсли; 
		
		Если ПовтИспРасчетПартий.Получить(Выборка.СчетДоверительногоУправления) = Неопределено Тогда
			ПовтИспРасчетПартий.Вставить(Выборка.СчетДоверительногоУправления, ПараметрыФормированияБазиса.РасчетПартий);
		КонецЕсли; 
		
		МассивТаблицСтруктурыОтчетов = Новый Массив;
		МассивТаблицРасхождений = СтрРазделить("ТаблицаРасхожденийЦен,РасхожденияСтоимостейЦенныхБумаг,РасхожденияСтоимостейАктивов,ТаблицаЦенТМинус2,ТаблицаОшибокСафмар,ЦенныеБумагиУчитываемыеОдновременноДляПродажиИДоПогашения", ",");
		
		Для каждого ИмяТаблицы Из МассивТаблицРасхождений Цикл
			Если ПараметрыФормированияБазиса.Свойство(ИмяТаблицы) Тогда
				МассивТаблицСтруктурыОтчетов.Добавить(ИмяТаблицы);
			КонецЕсли; 
		КонецЦикла; 
		
		Для каждого ПараметрФормированияБазиса Из ПараметрыФормированияБазиса Цикл
			Если СтрНачинаетсяС(ПараметрФормированияБазиса.Ключ, "_ПлановыеДанные_") И Не ПараметрФормированияБазиса.Ключ = "_ПлановыеДанные_Операции" Тогда
				МассивТаблицСтруктурыОтчетов.Добавить(ПараметрФормированияБазиса.Ключ);
			КонецЕсли; 
		КонецЦикла; 
		
		Для каждого ИмяТаблицы Из МассивТаблицСтруктурыОтчетов Цикл
		
			Если СтруктураОтчетов.Свойство(ИмяТаблицы) И ТекКлиент <> Выборка.СчетДоверительногоУправления Тогда
				Если Не ПараметрыФормированияБазиса[ИмяТаблицы] = Неопределено Тогда
					Для каждого ТекСтрока Из ПараметрыФормированияБазиса[ИмяТаблицы] Цикл
						ЗаполнитьЗначенияСвойств(СтруктураОтчетов[ИмяТаблицы].Добавить(), ТекСтрока);
					КонецЦикла; 							
				КонецЕсли;	
			ИначеЕсли ПараметрыФормированияБазиса.Свойство(ИмяТаблицы) И ТипЗнч(ПараметрыФормированияБазиса[ИмяТаблицы]) = Тип("ТаблицаЗначений") Тогда
				СтруктураОтчетов.Вставить(ИмяТаблицы, ПараметрыФормированияБазиса[ИмяТаблицы].Скопировать());
			КонецЕсли; 
		
		КонецЦикла; 
		
		ТаблицаБазиса = ДанныеБазиса.ТаблицаБазиса.Скопировать();
		ТаблицаБазиса.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ТаблицаБазиса.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка"));
		ТаблицаБазиса.Колонки.Добавить("Организация", Новый ОписаниеТипов("Строка"));
		ТаблицаБазиса.ЗаполнитьЗначения(Выборка.СчетДоверительногоУправления, "СчетДоверительногоУправления");
		ТаблицаБазиса.ЗаполнитьЗначения(Выборка.КодСчета, "КодСчета");
		ТаблицаБазиса.ЗаполнитьЗначения(Выборка.Организация, "Организация");
							
		Если РеквизитыБазиса.РежимПолученияБазы = 0 Тогда
			ТаблицаСЧА = ДанныеБазиса.ТаблицаСЧА.Скопировать();
		КонецЕсли; 					
		
		Если ТекКлиент <> Выборка.СчетДоверительногоУправления Тогда
			ТекКлиент = Выборка.СчетДоверительногоУправления;
		КонецЕсли; 
				
		Если РеквизитыБазиса.РежимПолученияБазы = 0 Тогда
			ТаблицаСЧА.Свернуть("БазаВидАктива", "БазаСумма");
			ЗначениеБазы = ТаблицаСЧА.Итог("БазаСумма");
		КонецЕсли;
		
		ТаблицаПолей				= МенеджерСправочника.ПолучитьОписаниеПолейБазиса(РеквизитыБазиса.НаборДанных);
		КонтролируемыеПоказатели 	= МенеджерСправочника.ПолучитьОписаниеКонтролируемыхПоказателей(РеквизитыБазиса.НаборДанных);
		ТаблицаВычисляемыхПолей		= МенеджерСправочника.ПолучитьОписаниеВычисляемыхПолей(РеквизитыБазиса.НаборДанных);
		
		ТаблицаСвязанныхПолей		= МенеджерСправочника.ПолучитьСвязанныеПоля(РеквизитыБазиса.НаборДанных);
		
		ПараметрыСКД = Новый Структура;
		ПараметрыСКД.Вставить("грПериод", 		ПараметрыФормированияБазиса.грПериод);
		ПараметрыСКД.Вставить("ВалютаУчета", 	ПараметрыФормированияБазиса.ВалютаУчета);
		
		ОтсутствуетСтоимостьПереоценки = (ТаблицаБазиса.НайтиСтроки(Новый Структура("ОтсутствуетСтоимостьПереоценки", Истина)).Количество() > 0);
		
		НомерБазиса = НомерБазиса + 1;
		ПараметрыБазиса = Новый Структура;						
		ПараметрыБазиса.Вставить("НомерБазиса", 					НомерБазиса);
		ПараметрыБазиса.Вставить("СКД", 							СКД);
		ПараметрыБазиса.Вставить("НастройкиСКД", 					НастройкиХранилище);
		ПараметрыБазиса.Вставить("ТаблицаСЧА", 						ТаблицаСЧА);
		ПараметрыБазиса.Вставить("ТаблицаБазиса", 					ТаблицаБазиса);
		ПараметрыБазиса.Вставить("ЗначениеБазы", 					ЗначениеБазы);
		ПараметрыБазиса.Вставить("ТаблицаПолей", 					ТаблицаПолей);
		ПараметрыБазиса.Вставить("ТаблицаВычисляемыхПолей", 		ТаблицаВычисляемыхПолей);
		ПараметрыБазиса.Вставить("ОтсутствуетСтоимостьПереоценки", 	ОтсутствуетСтоимостьПереоценки);
		ПараметрыБазиса.Вставить("КонтролируемыеПоказатели", 		КонтролируемыеПоказатели);
		ПараметрыБазиса.Вставить("ТаблицаСвязанныхПолей", 			ТаблицаСвязанныхПолей);
		ПараметрыБазиса.Вставить("ПараметрыСКД", 					ПараметрыСКД);
		ПараметрыБазиса.Вставить("РежимПолученияБазы", 				РеквизитыБазиса.РежимПолученияБазы);
		ПараметрыБазиса.Вставить("ВычисляемыеПоляЗаполнены", 		Ложь);
		ПараметрыБазиса.Вставить("ИдентификаторСКД",				РеквизитыБазиса.ИдентификаторСКД);
		
		СтрокаПараметров = ПараметрыБазисов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПараметров, Выборка);
		
		СтрокаПараметров.Параметры = ПараметрыБазиса;
					
	КонецЦикла; 
	
	ПолучитьТаблицуНесоответствийНаборовКИД(Параметры);
	
	Параметры.Вставить("ПараметрыБазисов", ПараметрыБазисов);
	Параметры.Вставить("Отчеты", Новый ХранилищеЗначения(СтруктураОтчетов, Новый СжатиеДанных(9)));
	
КонецПроцедуры

//Процедура ЗаполнитьКолонкуВходитВНабор(ПараметрыБазисов, ТекущийНаборДанных, ИспользоватьМинимальноеЗначениеРейтинга, ТаблицаСоставНабора, ТекСчетаДУ)
Процедура ЗаполнитьКолонкуВходитВНабор(ТаблицаПараметров, СоставНабора, ПараметрыОтбора)
	
	Если ТаблицаПараметров.Колонки.Найти("ИнвестиционнаяДекларация") = Неопределено Тогда
	    // это таблица ПараметрыБазисов
		// ПараметрыОтбора - Структура с полями "ТекущийНаборДанных, ИспользоватьМинимальноеЗначениеРейтинга, СчетаДоверительногоУправления"
		ЭтоТаблицаПараметрыБазисов = Истина;
	Иначе
		// это таблица ИД
		// ПараметрыОтбора - Структура с полями "ТекущийНаборДанных, ИнвестиционнаяДекларация"
		ЭтоТаблицаПараметрыБазисов = Ложь;
	КонецЕсли; 
	
	// Обходим и заполняем таблицы всех базисов с аналогичным набором данных
	Для каждого СтрокаПараметров Из ТаблицаПараметров Цикл
		
		Если СтрокаПараметров.Базис.НаборДанных = ПараметрыОтбора.ТекущийНаборДанных 
			И ((ЭтоТаблицаПараметрыБазисов
				И СтрокаПараметров.ИспользоватьМинимальноеЗначениеРейтинга = ПараметрыОтбора.ИспользоватьМинимальноеЗначениеРейтинга
				И ПараметрыОтбора.СчетаДоверительногоУправления.Найти(СтрокаПараметров.СчетДоверительногоУправления) <> Неопределено) 
			Или (Не ЭтоТаблицаПараметрыБазисов 
				И СтрокаПараметров.ИнвестиционнаяДекларация = ПараметрыОтбора.ИнвестиционнаяДекларация
				И СтрокаПараметров.Назначение = ПараметрыОтбора.Назначение)) Тогда
		
			ПараметрыБазиса = СтрокаПараметров.Параметры;
			
			Если ПараметрыБазиса.ТаблицаБазиса.Найти(Ложь, "ВходитВНабор") = Неопределено Тогда
				Продолжить;
			КонецЕсли; 
			
			СтруктураОтбора = Новый Структура;
			СтруктураПолей = Новый Структура;
			
			Для каждого Поле Из ПараметрыБазиса.ТаблицаПолей Цикл
				Если Поле.Ключ Тогда
				
					ПутьБезТочки = СтрЗаменить(Поле.ПутьКДанным, ".", "");
					СтруктураОтбора.Вставить(ПутьБезТочки);				// две структуры, т.к. в СКД пути к данным заданы в виде Группа.Поле, а в самой таблице базиса имена колонок без группировок 
					СтруктураПолей.Вставить(Поле.Поле, ПутьБезТочки);
				
				КонецЕсли; 
			КонецЦикла;
			
			Для каждого СтрокаПервогоУровня Из СоставНабора Цикл
			
				Для каждого СтрокаРезультат Из СтрокаПервогоУровня.Строки Цикл
				
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаРезультат);
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("ВходитВНабор", Ложь);
					
					Для каждого Поле Из СтруктураПолей Цикл
						СтруктураПоиска.Вставить(Поле.Ключ, СтруктураОтбора[Поле.Значение]);
					КонецЦикла; 
					
					МассивСтрок = ПараметрыБазиса.ТаблицаБазиса.НайтиСтроки(СтруктураПоиска);
					
					Для каждого СтрокаПоКлючу Из МассивСтрок Цикл
					
						СтрокаПоКлючу.ВходитВНабор = Истина;
											
					КонецЦикла;
				
				КонецЦикла;				
			
			КонецЦикла; 
 
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьПутьБезГруппировки(ПутьКДанным)

	Возврат Сред(ПутьКДанным, СтрНайти(ПутьКДанным, ".") + 1);

КонецФункции

Процедура ОбработатьЗначенияNULL(Результат)
	
	Для каждого ТекСтрока Из Результат.Строки Цикл
	
		Колонки = ТекСтрока.Владелец().Колонки;
		Для каждого Колонка Из Колонки Цикл
		
			Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) и ТекСтрока[Колонка.Имя] = NULL Тогда
			
				ТекСтрока[Колонка.Имя] = 0;
			
			КонецЕсли; 
			
		КонецЦикла; 
		
		ОбработатьЗначенияNULL(ТекСтрока);
			
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПолучитьТаблицуНесоответствийНаборовКИД(Параметры)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставСовокупнойИнвестДекларации.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА СоставСовокупнойИнвестДекларации.СовокупныйКонтроль
		|			ТОГДА СоставСовокупнойИнвестДекларации.Клиент
		|		ИНАЧЕ СоставСовокупнойИнвестДекларации.СчетДоверительногоУправления
		|	КОНЕЦ КАК Субъект,
		|	ВЫБОР
		|		КОГДА СоставСовокупнойИнвестДекларации.СовокупныйКонтроль
		|			ТОГДА СоставСовокупнойИнвестДекларации.ВидДоговораДоверительногоУправления
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|	КОНЕЦ КАК ВидДоговораДоверительногоУправления,
		|	СоставСовокупнойИнвестДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|ПОМЕСТИТЬ _СоставСовокупнойИнвестДекларации
		|ИЗ
		|	&СоставСовокупнойИнвестДекларации КАК СоставСовокупнойИнвестДекларации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.ИдентификаторСтрокиПоказателей КАК ИдентификаторСтрокиПоказателей,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.ВидАктива КАК ВидАктива,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.Актив КАК Актив,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.ДатаПоследнейПокупки КАК ДатаПоследнейПокупки,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.Количество КАК Количество,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.ДатаУстранения КАК ДатаУстранения,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.Статус КАК Статус,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.Регистратор КАК Регистратор,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.Группа КАК Группа,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.Субъект КАК Субъект,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	НесоответствияИнвестиционнымДекларациямСрезПоследних.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация,
		|	НесоответствиеИнвестиционнойДекларацииСоставНабора.Классификация КАК Классификация
		|ИЗ
		|	РегистрСведений.НесоответствияИнвестиционнымДекларациям.СрезПоследних(
		|			&Период,
		|			(Организация, Субъект, ВидДоговораДоверительногоУправления, ИнвестиционнаяДекларация) В
		|				(ВЫБРАТЬ
		|					_СоставСовокупнойИнвестДекларации.Организация КАК Организация,
		|					_СоставСовокупнойИнвестДекларации.Субъект КАК Субъект,
		|					_СоставСовокупнойИнвестДекларации.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|					_СоставСовокупнойИнвестДекларации.ИнвестиционнаяДекларация КАК ИнвестиционнаяДекларация
		|				ИЗ
		|					_СоставСовокупнойИнвестДекларации КАК _СоставСовокупнойИнвестДекларации)) КАК НесоответствияИнвестиционнымДекларациямСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НесоответствиеИнвестиционнойДекларации.СоставНабора КАК НесоответствиеИнвестиционнойДекларацииСоставНабора
		|		ПО НесоответствияИнвестиционнымДекларациямСрезПоследних.Регистратор = НесоответствиеИнвестиционнойДекларацииСоставНабора.Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Период", КонецДня(Параметры.Период));
	Запрос.УстановитьПараметр("СоставСовокупнойИнвестДекларации", Параметры.СоставСовокупнойИнвестДекларации);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		Параметры.Вставить("ТаблицаНесоответствийНаборовИД", Результат.Выгрузить());
	
	КонецЕсли;  
	
КонецПроцедуры

