Процедура ДобавитьПоляИзОтбора(ЭлементыОтбора, ДобавленныеПоля, КоллекцияПолей, ПараметрыБазиса, СписокИсключений, ТипПоля, ВидыАктивов = Неопределено)

	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДобавитьПоляИзОтбора(ЭлементОтбора.Элементы, ДобавленныеПоля, КоллекцияПолей, ПараметрыБазиса, СписокИсключений, ТипПоля, ВидыАктивов);
		Иначе
			ПутьКДанным = Строка(ЭлементОтбора.ЛевоеЗначение);
			Если СписокИсключений.Найти(ПутьКДанным) = Неопределено Тогда
				
				Если ВидыАктивов <> Неопределено Тогда
				
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Основные.ВидАктива") Тогда
						Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
							Для каждого ВидАктива Из ЭлементОтбора.ПравоеЗначение Цикл
								Если ВидыАктивов.Найти(ВидАктива.Значение) = Неопределено Тогда
									ВидыАктивов.Добавить(ВидАктива.Значение);
								КонецЕсли;	
							КонецЦикла; 
						Иначе
							Если ВидыАктивов.Найти(ЭлементОтбора.ПравоеЗначение) = Неопределено Тогда
								ВидыАктивов.Добавить(ЭлементОтбора.ПравоеЗначение);
							КонецЕсли;
						КонецЕсли; 
					КонецЕсли; 
				
				КонецЕсли; 
				
				Если ДобавленныеПоля.Найти(ПутьКДанным) = Неопределено Тогда
				
					ОписаниеПоля = ПараметрыБазиса.ТаблицаПолей.Найти(ПутьКДанным, "ПутьКДанным");
					
					Если Не ОписаниеПоля = Неопределено И Не ОписаниеПоля.Ресурс 
						//Или СтрНачинаетсяС(ПутьКДанным, "ПользовательскиеПоля") 
						Тогда
						ПолеВыбор = КоллекцияПолей.Добавить(ТипПоля);
						ПолеВыбор.Поле = ЭлементОтбора.ЛевоеЗначение;
						ДобавленныеПоля.Добавить(ПутьКДанным);
					КонецЕсли;
					
				КонецЕсли;		
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;

КонецПроцедуры

Функция ЗаписатьРезультатВФайлы(СКД = Неопределено, Настройки = Неопределено, МакетКомпоновки = Неопределено, Постфикс = "", СохранятьРезультатВФайлы = Ложь) Экспорт

	Файл = Новый Файл("\\ap69\Developers\Виктор\КИД\");
	Если Не СохранятьРезультатВФайлы Или Файл.Существует() Тогда
		
		СтруктураХМЛ = Новый Структура;
		
		Если Не СКД = Неопределено Тогда
		
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СКД, "DataCompositionSchema", "http://v8.1c.ru/8.1/data-composition-system/schema");
			СтруктураХМЛ.Вставить("Схема", ЗаписьXML.Закрыть());
		
		КонецЕсли; 
		
		Если Не Настройки = Неопределено Тогда
		
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Настройки, "Settings", "http://v8.1c.ru/8.1/data-composition-system/settings");
			СтруктураХМЛ.Вставить("Настройки", ЗаписьXML.Закрыть());
			
		КонецЕсли;
		
		Если Не МакетКомпоновки = Неопределено Тогда
			
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, МакетКомпоновки, "DataCompositionTemplate", "http://v8.1c.ru/8.1/data-composition-system/composition-template");
			СтруктураХМЛ.Вставить("Макет", ЗаписьXML.Закрыть());
					
		КонецЕсли; 
		
		Если СохранятьРезультатВФайлы Тогда
			
			Для каждого Элемент Из СтруктураХМЛ Цикл
				
				ИмяФайла = Файл.ПолноеИмя + "\" + Элемент.Ключ + ?(Постфикс = "", "", "-" + Постфикс) + ".xml";
				ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла);
				ЗаписьТекста.Записать(Элемент.Значение);
				ЗаписьТекста.Закрыть();
			
			КонецЦикла; 
		
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат СтруктураХМЛ;

