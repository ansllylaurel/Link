&НаКлиенте
Процедура РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСП(Команда)
	
	ДанныеПартий = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
	Если ДанныеПартий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
		|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, ДляВечернейПереоценки", 
		ЭтаФорма.ДатаРасчета,
	 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.СчетДоверительногоУправления, "Организация"),
		ЭтаФорма.СчетДоверительногоУправления,
		1,
		ДанныеПартий.ЦенаКупона,
		ЭтаФорма.Облигация,
		ДанныеПартий.Партия,
		ДанныеПартий.СтрокаПартии,
		ДанныеПартий.УчетныйАктивЕПС,
		Истина);
	ОткрытьФорму("Отчет.РасшифровкаРасчетаАмортизацииДисконтаПремииИКорректировкиПоЭСП.Форма.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)
	
КонецПроцедуры

Функция ПолучитьПараметрыРасчетаРейтингаПоУмолчанию(СчетДоверительногоУправления, Период)
	
	ПараметрыРасчетаРейтингаПоУмолчанию = Новый Структура;		
	
	Если Период >= '20200901' Тогда
		
		СпециализированныйДепозитарий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "СпециализированныйДепозитарий");
		
		ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("ИсключатьДляРублевыхОблигацийРейтингFitchRatings",
			СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Газфонд")
				ИЛИ СпециализированныйДепозитарий = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
		
	ИначеЕсли Период >= '20191021' Тогда
		
		ПараметрыРасчетаРейтингаПоУмолчанию.Вставить("ИсключатьДляРублевыхОблигацийРейтингFitchRatings", Истина);			
		
	КонецЕсли;
	
	Возврат ПараметрыРасчетаРейтингаПоУмолчанию; 
	
КонецФункции

&НаСервере
Функция ПроверитьНаРыночностьНаСервере(НомерСтроки)
	
	СтрокаПартии = Партии[НомерСтроки];
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить(СтрокаПартии);
	
	ДанныеПартий = Партии.Выгрузить(МассивСтрок);
	
	ДанныеПартий.Колонки.Добавить("НомерСтроки", Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
	ДанныеПартий.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	Для каждого СтрокаДанныеПартий Из ДанныеПартий Цикл
		СтрокаДанныеПартий.НомерСтроки = 1;
		СтрокаДанныеПартий.Количество = 1;
		//СтрокаДанныеПартий.Количество = СтрокаДанныеПартий.Партия.ЦенныеБумаги[0].Количество;
	КонецЦикла;
	
	ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ДанныеПартий, СчетДоверительногоУправления, ЭтаФорма.ДатаРасчета).Выгрузить();
	
	ПараметрыПроверки = РаботаСКоллекциями.ТаблицаЗначений_В_МассивСтруктур(ДатыИЦеныПокупки);
	
	Отказ = Ложь;
	Отчет = Неопределено;
	Если БухгалтерскийУчетЕПС.ПроверитьЭСПНаРыночность(ЭтаФорма.Облигация, ЭтаФорма.ЭСП, ЭтаФорма.ДатаРасчета, СчетДоверительногоУправления, Отчет, ПараметрыПроверки[0], Отказ) <> Неопределено Тогда
		Возврат Отчет;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Процедура ПроверитьНаРыночность(Команда)
	
	ДанныеЦенныхБумаг = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
	Если ДанныеЦенныхБумаг = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
		Возврат;
	КонецЕсли;
	
	Отчет = ПроверитьНаРыночностьНаСервере(ЭтаФорма.Элементы.Партии.ТекущаяСтрока);
	
	Если Отчет <> Неопределено Тогда
		Отчет.Показать("ПроверкаЭСП");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Excel(Команда)
	
	ДанныеПартий = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
	Если ДанныеПартий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеПартий.ДатаПокупки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет даты покупки!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеПартий.ЦенаПокупки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет цены покупки!");
		Возврат;
	КонецЕсли;
	
	ExcelApp = Новый COMОбъект("Excel.Application");
	
	ExcelApp.Application.Workbooks.Add();
	
	xlBook = ExcelApp.Application.ActiveWorkbook;
	xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets(1);
	
	xlSheet.Cells(1, 1).Value = "ЭСП:";
	
	xlSheet.Cells(2, 1).Value = "Дата";
	xlSheet.Cells(2, 2).Value = "Сумма";
	
	xlSheet.Cells(3, 1).Value = ДанныеПартий.ДатаПокупки;
	xlSheet.Cells(3, 2).Value = -ДанныеПартий.ЦенаПокупки;
	
	Инд = 4;
	Для каждого СтрокаПотока Из ДенежныйПотокРеквизит Цикл
		
		xlSheet.Cells(Инд, 1).Value = СтрокаПотока.Дата;
		xlSheet.Cells(Инд, 2).Value = СтрокаПотока.Поток;
		
		Инд = Инд + 1;
	
	КонецЦикла;
	
	xlSheet.Range("B1").FormulaLocal = "=ЧИСТВНДОХ(B3:B" + СокрЛП(Формат(Инд - 1, "ЧГ=")) + ";A3:A" + СокрЛП(Формат(Инд - 1, "ЧГ=")) + ";0)";
	
	ExcelApp.Application.Visible = True;
	
КонецПроцедуры
