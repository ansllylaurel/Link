&НаСервере
Процедура РасчитатьЭСПНаСервере(ДатаПокупки, ЦенаПокупки, Партия, СтрокаПартии)
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения", ЭтаФорма.ДоПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",			 ЭтаФорма.ДатаРасчета);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",	 ЭтаФорма.ДатаРасчета);
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("Клиент", 								Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.ДатаРасчета));
	ПараметрыОценки.Вставить("Организация",			 				ЭтаФорма.СчетДоверительногоУправления.Организация);
	ПараметрыОценки.Вставить("СчетДоверительногоУправления",		ЭтаФорма.СчетДоверительногоУправления);
	ПараметрыОценки.Вставить("ЦельРасчета", 						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ЭтаФорма.ДатаРасчета, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ПараметрыОценки.ЦельРасчета);
	ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости" ,	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	
	ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЭтаФорма.Облигация, ПараметрыДенежногоПотока, ПараметрыОценки);
	
	ЭтаФорма.ДенежныйПотокРеквизит.Загрузить(ДенежныйПоток);
	
	РешениеКлиентаПоЭСП = РегистрыСведений.РешенияКлиентовПоЗначениямЭСП.ПолучитьПоПартии(ЭтаФорма.Облигация, Партия, СтрокаПартии, ЭтаФорма.ДатаРасчета);
	
	Если РешениеКлиентаПоЭСП <> Неопределено Тогда
		
		ЭтаФорма.ЭСП		 = РешениеКлиентаПоЭСП.ЭСП;
		ЭтаФорма.ОписаниеЭСП = "Получена от клиента";
		
		Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа;
		
		ДоходностьДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
								ЭтаФорма.Облигация,
								ЭтаФорма.ДоПогашения,
								ДатаПокупки,
								ЦенаПокупки,
								ЭтаФорма.СчетДоверительногоУправления,
								Биржа);
		
		Если ТипЗнч(ДоходностьДюрация) = Тип("Структура") Тогда
			ЭтаФорма.ОписаниеЭСП = ЭтаФорма.ОписаниеЭСП + "(расчетная: " + Строка(Окр(ДоходностьДюрация.Доходность, 15)) + ")";
		КонецЕсли; 
		
	Иначе
		
		ЭтаФорма.ОписаниеЭСП = "Расчетная";
		
		Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа;
		
		ДоходностьДюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
								ЭтаФорма.Облигация,
								ЭтаФорма.ДоПогашения,
								ДатаПокупки,
								ЦенаПокупки,
								ЭтаФорма.СчетДоверительногоУправления,
								Биржа);
		
		Если ТипЗнч(ДоходностьДюрация) = Тип("Структура") Тогда
			ЭтаФорма.ЭСП = ДоходностьДюрация.Доходность;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЭСП(Команда)
	ДанныеПартий = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
	Если ДанныеПартий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеПартий.ДатаПокупки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет даты покупки!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДанныеПартий.ЦенаПокупки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет цены покупки!");
		Возврат;
	КонецЕсли;
	РасчитатьЭСПНаСервере(ДанныеПартий.ДатаПокупки, ДанныеПартий.ЦенаПокупки, ДанныеПартий.Партия, ДанныеПартий.СтрокаПартии);
КонецПроцедуры

&НаСервере
Процедура РасчитатьСтоимостьНаСервере(ДатаПокупки)
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения", ЭтаФорма.ДоПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",			 ЭтаФорма.ДатаРасчета);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",	 ЭтаФорма.ДатаРасчета);
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("Клиент", 								Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.ДатаРасчета));
	ПараметрыОценки.Вставить("Организация",			 				ЭтаФорма.СчетДоверительногоУправления.Организация);
	ПараметрыОценки.Вставить("СчетДоверительногоУправления",		ЭтаФорма.СчетДоверительногоУправления);
	ПараметрыОценки.Вставить("ЦельРасчета", 						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ЭтаФорма.ДатаРасчета, ПараметрыОценки.Организация, ПараметрыОценки.СчетДоверительногоУправления, ПараметрыОценки.ЦельРасчета);
	ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости" ,	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	
	
	ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЭтаФорма.Облигация, ПараметрыДенежногоПотока, ПараметрыОценки);
	
	ЭтаФорма.Стоимость = РаботаСПоказателямиФинансовыхИнструментов.РассчитатьДисконтированнуюСтоимость(ДенежныйПоток, ЭтаФорма.ЭСП, ДатаПокупки);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтоимость(Команда)
	ДанныеПартий = ЭтаФорма.Элементы.Партии.ТекущиеДанные;
	Если ДанныеПартий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите партию!");
		Возврат;
	КонецЕсли;
	РасчитатьСтоимостьНаСервере(ДанныеПартий.ДатаПокупки);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПартии()
	
	Если ЭтаФорма.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтаФорма.Облигация = Справочники.Облигации.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтаФорма.ДатаРасчета = '00010101' Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РассчитыватьЭСПДо = БухгалтерскийУчет.ОпределитьНастройкуУчета(
							ЭтаФорма.ДатаРасчета,
							ЭтаФорма.СчетДоверительногоУправления.Организация,
							ЭтаФорма.СчетДоверительногоУправления,
							"РассчитыватьЭСПДо");
							
	ЭтаФорма.ДоПогашения = (РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	0 КАК НомерСтроки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.СчетДоверительногоУправления.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтаФорма.ДатаРасчета), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтаФорма.Облигация);
	
	ЦенныеБумаги = Запрос.Выполнить().Выгрузить();
	
    ВыборкаПартии = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(
							ЦенныеБумаги,
							ЭтаФорма.СчетДоверительногоУправления,
							ЭтаФорма.ДатаРасчета);
							
	ЭтаФорма.Партии.Загрузить(ВыборкаПартии.Выгрузить());
	
	Возврат (ЦенныеБумаги.Количество() > 0);
	
КонецФункции

