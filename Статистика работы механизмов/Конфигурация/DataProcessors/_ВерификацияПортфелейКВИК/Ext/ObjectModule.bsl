
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Верификация портфелей КВИК",
		"1.39",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВерифицироватьЗаТекущуюДату", "Верифицировать за текущую дату",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки прайс-листа по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.Период = ТекущаяДатаСеанса();
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	//В неторговые (но рабочие) дни через QUIK могут отправляться поручения на переводы ДС 
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ЭтотОбъект.Период)) Тогда
		Возврат;
	КонецЕсли;
	
	ВерифицироватьПортфелиВСистемеКВИК();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОСНОВНОЙ ФУНКЦИОНАЛ
Функция ЭтоРабочийИлиТорговыйДень(НачалоДня)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Календарь КАК Календарь
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата = &НачалоДня
		|	И ДанныеКалендаря.Календарь В (&КалендарьКотировок, ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))";
	
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
	
КонецФункции

Процедура ВерифицироватьПортфелиВСистемеКВИК() Экспорт
		
#Область НАЧАЛО_СЕССИИ	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВерифицироватьПортфелиВСистемеКВИК";
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период, ПолучателиОповещения");
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
#КонецОбласти

	СоединениеРЭМ = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportRam";
	СоединениеРПИ = "DRIVER={SQL Server};SERVER=AP70;UID=Nikolay;PWD=11111;DATABASE=QuikExportRpi";

	ТекстЗапросаРЭМ =
		"SELECT DISTINCT
		|	CASE WHEN (Charindex('/K', bc.ClientCode) > 0) OR (Charindex('/R', bc.ClientCode) > 0) 
		|		THEN Left(bc.ClientCode, Charindex('/', bc.ClientCode) - 1) 
		|		ELSE bc.ClientCode
		|	END ClientCode,
		|	'БК РЕГИОН' AS Broker
		|FROM [bc].[Limits] bc
		|		
		|UNION
		|
		|SELECT DISTINCT
		|	gpb.ClientCode,
		|	'ГПБ'
		|FROM [gpb].[Limits] gpb";
		
	ТекстЗапросаРПИ = 
		"SELECT DISTINCT
		|	CASE WHEN (Charindex('/K', bc.ClientCode) > 0) OR (Charindex('/R', bc.ClientCode) > 0) 
		|		THEN Left(bc.ClientCode, Charindex('/', bc.ClientCode) - 1) 
		|		ELSE bc.ClientCode
		|	END ClientCode,
		|	'БК РЕГИОН' AS Broker
		|FROM [bc].[Limits] bc";

	ТипыДанныхКВИК = Новый Структура("ClientCode, Broker", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)), Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	
	ЛимитыРЭМ = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеРЭМ, ТекстЗапросаРЭМ, ТипыДанныхКВИК);
	ЛимитыРПИ = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СоединениеРПИ, ТекстЗапросаРПИ, ТипыДанныхКВИК);

		
	Если ЛимитыРЭМ = Неопределено Или ЛимитыРПИ = Неопределено Тогда
		
		ИмяУК = "";
		
		Если ЛимитыРЭМ = Неопределено Тогда
			ИмяУК = "РЭМ";	
		ИначеЕсли ЛимитыРПИ = Неопределено Тогда
			ИмяУК = "РПИ";		
		КонецЕсли;
		
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(
			ЭтотОбъект, 
			"При сверке лимитов (портфелей) не удалось получить данные из QUIKа УК " + ИмяУК + " за " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + ". Проверьте вывод данных по ODBC.");
			
		РаботаСДополнительнымиОтчетамиИОбработками.ОповеститьОВнутрОшибках(ЭтотОбъект);
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
		
	КонецЕсли;
	
	МассивЛимитов = Новый Массив;
	МассивЛимитов.Добавить(ЛимитыРЭМ);
	МассивЛимитов.Добавить(ЛимитыРПИ);
	
	Для Каждого ТаблицаЛимитов Из МассивЛимитов Цикл
		
		Для каждого ТекСтрока Из ТаблицаЛимитов Цикл
			                                                           
			КодКлиента = ТекСтрока[0];
			КодКлиента = СтрЗаменить(КодКлиента, "/V", "");
			КодКлиента = СтрЗаменить(КодКлиента, "V", "");
			КодКлиента = СтрЗаменить(КодКлиента, "/", "_");
			КодКлиента = СтрЗаменить(КодКлиента, "_SPFI", "");
			
			ТекСтрока[0] = КодКлиента;
	
		КонецЦикла;
		
		ТаблицаЛимитов.Свернуть("ClientCode, Broker");
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка КАК Счет
		|ПОМЕСТИТЬ _СчетаИсключеныИзСверки
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ В (&УчетНеВедется, &СчетЗаблокированБрокером)
		|	И ЗначенияДополнительныхСведений.Значение = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоЦеннымБумагам.Организация КАК Организация,
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Брокер КАК Брокер
		|ПОМЕСТИТЬ _Исполнители
		|ИЗ
		|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|ГДЕ
		|	(ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Период)
		|	И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.КодFORTS КАК КодFORTS,
		|	ВЫБОР
		|		КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер = &БрокерБК
		|			ТОГДА ""БК РЕГИОН""
		|		КОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер = &БрокерГПБ
		|			ТОГДА ""ГПБ""
		|	КОНЕЦ КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация КАК Организация,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	НЕ _СчетаИсключеныИзСверки.Счет ЕСТЬ NULL КАК ИсключенИзСверки,
		|	_Исполнители.СчетДоверительногоУправления ЕСТЬ NULL КАК ОтсутсвуетИсполнительПоЦБ
		|ПОМЕСТИТЬ _КодыУБрокера
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация В (&РЭМ, &РПИ)
		|				И Брокер В (&БрокерБК, &БрокерГПБ)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация В (&РЭМ, &РПИ)) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаИсключеныИзСверки КАК _СчетаИсключеныИзСверки
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = _СчетаИсключеныИзСверки.Счет
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Исполнители КАК _Исполнители
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = _Исполнители.СчетДоверительногоУправления
		|			И КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер = _Исполнители.Брокер
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КодыУБрокера.Код КАК КодКлиента,
		|	ЛОЖЬ КАК ФлКодFORTS,
		|	_КодыУБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыУБрокера.ДатаРасторжения КАК ДатаРасторжения,
		|	_КодыУБрокера.ИсключенИзСверки КАК ИсключенИзСверки,
		|	_КодыУБрокера.ОтсутсвуетИсполнительПоЦБ КАК ОтсутсвуетИсполнительПоЦБ,
		|	_КодыУБрокера.Брокер КАК Брокер
		|ПОМЕСТИТЬ _КодыРЭМ_1С
		|ИЗ
		|	_КодыУБрокера КАК _КодыУБрокера
		|ГДЕ
		|	_КодыУБрокера.Организация = &РЭМ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_КодыУБрокера.КодFORTS,
		|	ИСТИНА,
		|	_КодыУБрокера.СчетДоверительногоУправления,
		|	_КодыУБрокера.ДатаРасторжения,
		|	_КодыУБрокера.ИсключенИзСверки,
		|	_КодыУБрокера.ОтсутсвуетИсполнительПоЦБ,
		|	_КодыУБрокера.Брокер
		|ИЗ
		|	_КодыУБрокера КАК _КодыУБрокера
		|ГДЕ
		|	_КодыУБрокера.Организация = &РЭМ
		|	И _КодыУБрокера.КодFORTS <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КодыУБрокера.Код КАК КодКлиента,
		|	ЛОЖЬ КАК ФлКодFORTS,
		|	_КодыУБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыУБрокера.ДатаРасторжения КАК ДатаРасторжения,
		|	_КодыУБрокера.ИсключенИзСверки КАК ИсключенИзСверки,
		|	_КодыУБрокера.ОтсутсвуетИсполнительПоЦБ КАК ОтсутсвуетИсполнительПоЦБ,
		|	_КодыУБрокера.Брокер КАК Брокер
		|ПОМЕСТИТЬ _КодыРПИ_1С
		|ИЗ
		|	_КодыУБрокера КАК _КодыУБрокера
		|ГДЕ
		|	_КодыУБрокера.Организация = &РПИ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_КодыУБрокера.КодFORTS,
		|	ИСТИНА,
		|	_КодыУБрокера.СчетДоверительногоУправления,
		|	_КодыУБрокера.ДатаРасторжения,
		|	_КодыУБрокера.ИсключенИзСверки,
		|	_КодыУБрокера.ОтсутсвуетИсполнительПоЦБ,
		|	_КодыУБрокера.Брокер
		|ИЗ
		|	_КодыУБрокера КАК _КодыУБрокера
		|ГДЕ
		|	_КодыУБрокера.Организация = &РПИ
		|	И _КодыУБрокера.КодFORTS <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыРЭМ.ClientCode КАК ClientCode,
		|	КодыРЭМ.Broker КАК Broker,
		|	ВЫБОР
		|		КОГДА КодыРЭМ.Broker = ""БК РЕГИОН""
		|			ТОГДА ""389""
		|		КОГДА КодыРЭМ.Broker = ""ГПБ""
		|			ТОГДА ""87216""
		|	КОНЕЦ КАК UID
		|ПОМЕСТИТЬ _КодыРЭМ_КВИК
		|ИЗ
		|	&КодыРЭМ КАК КодыРЭМ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыРПИ.ClientCode КАК ClientCode,
		|	КодыРПИ.Broker КАК Broker,
		|	""707"" КАК UID
		|ПОМЕСТИТЬ _КодыРПИ_КВИК
		|ИЗ
		|	&КодыРПИ КАК КодыРПИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыРЭМ_1С.КодКлиента КАК КодКлиента,
		|	""РЭМ"" КАК Организация,
		|	_КодыРЭМ_1С.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыРЭМ_1С.ДатаРасторжения КАК ДатаРасторжения,
		|	_КодыРЭМ_1С.ФлКодFORTS КАК ФлКодFORTS,
		|	_КодыРЭМ_1С.ИсключенИзСверки КАК ИсключенИзСверки,
		|	_КодыРЭМ_1С.ОтсутсвуетИсполнительПоЦБ КАК ОтсутсвуетИсполнительПоЦБ,
		|	_КодыРЭМ_КВИК.ClientCode КАК КодБрокера,
		|	_КодыРЭМ_КВИК.UID КАК UID,
		|	ЕСТЬNULL(_КодыРЭМ_1С.Брокер, _КодыРЭМ_КВИК.Broker) КАК Брокер,
		|	ВЫБОР
		|		КОГДА _КодыРЭМ_1С.Брокер = ""БК РЕГИОН""
		|			ТОГДА ""389""
		|		КОГДА _КодыРЭМ_1С.Брокер = ""ГПБ""
		|			ТОГДА ""87216""
		|	КОНЕЦ КАК UID2
		|ПОМЕСТИТЬ _КодыУБрокеровОбщая
		|ИЗ
		|	_КодыРЭМ_1С КАК _КодыРЭМ_1С
		|		ПОЛНОЕ СОЕДИНЕНИЕ _КодыРЭМ_КВИК КАК _КодыРЭМ_КВИК
		|		ПО _КодыРЭМ_1С.КодКлиента = _КодыРЭМ_КВИК.ClientCode
		|			И _КодыРЭМ_1С.Брокер = _КодыРЭМ_КВИК.Broker
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_КодыРПИ_1С.КодКлиента,
		|	""РПИ"",
		|	_КодыРПИ_1С.СчетДоверительногоУправления,
		|	_КодыРПИ_1С.ДатаРасторжения,
		|	_КодыРПИ_1С.ФлКодFORTS,
		|	_КодыРПИ_1С.ИсключенИзСверки,
		|	_КодыРПИ_1С.ОтсутсвуетИсполнительПоЦБ,
		|	_КодыРПИ_КВИК.ClientCode,
		|	_КодыРПИ_КВИК.UID,
		|	ЕСТЬNULL(_КодыРПИ_1С.Брокер, _КодыРПИ_КВИК.Broker),
		|	""707""
		|ИЗ
		|	_КодыРПИ_1С КАК _КодыРПИ_1С
		|		ПОЛНОЕ СОЕДИНЕНИЕ _КодыРПИ_КВИК КАК _КодыРПИ_КВИК
		|		ПО (_КодыРПИ_КВИК.ClientCode ПОДОБНО _КодыРПИ_1С.КодКлиента + ""%"")
		|			И _КодыРПИ_1С.Брокер = _КодыРПИ_КВИК.Broker
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыУБрокеровОбщая.КодБрокера КАК КодБрокера,
		|	ВЫБОР
		|		КОГДА _КодыУБрокеровОбщая.ФлКодFORTS = ИСТИНА
		|			ТОГДА _КодыУБрокеровОбщая.КодКлиента + "" (FORTS)""
		|		ИНАЧЕ _КодыУБрокеровОбщая.КодКлиента
		|	КОНЕЦ КАК КодКлиента,
		|	_КодыУБрокеровОбщая.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыУБрокеровОбщая.Брокер КАК Брокер,
		|	ЕСТЬNULL(_КодыУБрокеровОбщая.UID, _КодыУБрокеровОбщая.UID2) + "" / "" + _КодыУБрокеровОбщая.Организация КАК UID
		|ИЗ
		|	_КодыУБрокеровОбщая КАК _КодыУБрокеровОбщая
		|ГДЕ
		|	(_КодыУБрокеровОбщая.КодБрокера ЕСТЬ NULL
		|				И (_КодыУБрокеровОбщая.ДатаРасторжения >= &Период
		|					ИЛИ _КодыУБрокеровОбщая.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|				И НЕ _КодыУБрокеровОбщая.ИсключенИзСверки
		|				И НЕ _КодыУБрокеровОбщая.ОтсутсвуетИсполнительПоЦБ
		|			ИЛИ _КодыУБрокеровОбщая.КодКлиента ЕСТЬ NULL)
		|ИТОГИ ПО
		|	Брокер";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("УчетНеВедется", "УчетНеВедется");
	Запрос.УстановитьПараметр("СчетЗаблокированБрокером", "СчетЗаблокированБрокером");
	
	Запрос.УстановитьПараметр("РЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("РПИ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	
	Запрос.УстановитьПараметр("БрокерБК", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("БрокерГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	
	Запрос.УстановитьПараметр("КодыРЭМ", ЛимитыРЭМ);
	Запрос.УстановитьПараметр("КодыРПИ", ЛимитыРПИ);

	ТекстПисьма = "";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ТекстПисьма = ТекстПисьма + 
			"<tr class=""broker"">
			|	<td colspan=""4"">" + Выборка.Брокер + "</td>
			|</tr>";
		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ТекстПисьма = ТекстПисьма + //&nbsp; 
				"<tr>
				|	<td>" + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.UID)       ,                   ВыборкаДетальныеЗаписи.UID       , "-----") + "</td>
				|	<td>" + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КодБрокера),                   ВыборкаДетальныеЗаписи.КодБрокера, "-----") + "</td>
				|	<td>" + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КодКлиента),                   ВыборкаДетальныеЗаписи.КодКлиента, "-----") + "</td>
				|	<td>" + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления), ВыборкаДетальныеЗаписи.СчетДоверительногоУправления, "-----") + "</td> 
				|</tr>";
			
		КонецЦикла;
		
	КонецЦикла;

	Если ТекстПисьма <> "" Тогда
		
		ТекстПисьма =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style>
			|		body     { font: 10pt sans-serif; }
			|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td       { border: 1px solid #CCC085; padding: 5px; }
			|		.caption { font-weight: bolder; font-size: 12px; background: #F4ECC5 }
			|		.broker  { color: #009646; background: #F4ECC5 }
			|	</style>
			|</head>
			|<body>
			|<table cols=""4"">		
			|<tr class=""caption"">
			|	<td>UID / УК</td>
			|	<td>Код [QUIK]</td>
			|	<td>Код [1С]</td>
			|	<td>Счет ДУ</td>
			|</tr>"
			+ ТекстПисьма + "</table></body></html>";
		
			
		Если ЗначениеЗаполнено(ЭтотОбъект.ПолучателиОповещения) Тогда
				
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста",
				ЭтотОбъект.ПолучателиОповещения,
				"Ошибка верификации портфелей КВИК за " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"),
				ТекстПисьма,
				"HTML");
				
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
			
		ИначеЕсли ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			
			РеквизитыОповещения = Новый Структура("Тема, Текст", "Ошибка верификации портфелей КВИК за " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"), ТекстПисьма);
			Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._ВерификацияПортфелейКВИК", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;