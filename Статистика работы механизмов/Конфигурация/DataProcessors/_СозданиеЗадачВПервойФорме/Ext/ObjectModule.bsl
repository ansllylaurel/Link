				    МассивПараметровСтроки.Добавить(Новый Структура("id, value", 75, ДетальныеЗаписи.СчетДУНаименование)); //Клиент
				    МассивПараметровСтроки.Добавить(Новый Структура("id, value", 79, ДетальныеЗаписи.ТипКлиента));  
				    МассивПараметровСтроки.Добавить(Новый Структура("id, value, dataSourceItemId", 76, ДетальныеЗаписи.БрокерНаименование, ДетальныеЗаписи.КодБрокера)); // брокер - БК Регион - 68, ГПБ - 69, Кит Финанс - 70, ВБРР - 72
					МассивПараметровСтроки.Добавить(Новый Структура("id, value", 77, ДетальныеЗаписи.КодКлиентаУБрокера)); //Код у брокера
					МассивПараметровСтроки.Добавить(Новый Структура("id, value", 78, ДетальныеЗаписи.Количество)); // Количество
					МассивПараметровСтроки.Добавить(Новый Структура("id, value", 144, ДетальныеЗаписи.КлассификацияЦенныхБумаг)); // Классификация

					СтрокиТабЧасти.Добавить(Новый Структура("id, modifyType, cols", НомерСтроки, "create", МассивПараметровСтроки));
					
					Если МассивКодовУК.Найти(ДетальныеЗаписи.КодУК) = Неопределено Тогда
						МассивКодовУК.Добавить(ДетальныеЗаписи.КодУК);	
					КонецЕсли;
					
					НомерСтроки = НомерСтроки + 1;
					
				КонецЦикла;
					
				НоваяСтрока.КодыУК            = МассивКодовУК;
				НоваяСтрока.ТекстТабЧастьJson = ПолучитьСтрокуJSON(Новый Структура("rows", СтрокиТабЧасти));
				НоваяСтрока.ТабличнаяЧасть    = ТабличнаяЧасть;
				
			КонецЦикла;
				
		КонецЦикла;
	
	КонецЦикла; 
	
	ДопПараметрыДляСбораСтатистики = Новый Структура;
	МассивНомеровЗадач = Новый Массив;
	
	Если ТаблицаДанных.Количество() > 0 Тогда		
		ПоставитьЗадачиВПервойФорме(ТаблицаДанных, МассивНомеровЗадач);		
	КонецЕсли;
	
	Если МассивНомеровЗадач.Количество() > 0 Тогда
		ДопПараметрыДляСбораСтатистики.Вставить("СозданныеЗадачи", РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивНомеровЗадач, ","));
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыДляСбораСтатистики);
	
	Возврат МассивНомеровЗадач;
			
КонецФункции

Процедура ПроверитьОфертыПоступившихНовыхОблигаций() Экспорт
	
	//Если в портфеле появилась новая ценная бумга, проверяем наличие оферт по бумаге (доп. оферта и обязательное досрочное погашение), и формируем сообщение об офертах.	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПроверитьОфертыПоступившихНовыхОблигаций()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	ТемаПисьма = "ВАЖНО! Новые данные об оферте.";
	
	//Собираем количество НОВЫХ ценных бумаг поступивших в портфель.
	//Анализируем обороты остатков за три предыдущих рабочих дня + задолженность по поручениям, задолженность по сделкам, задолженность по сделкам репо
	//Задолженность по сделкам и по поручениям: Учитываем всю кредиторскую задолженность (есть обязательство – должны исполнить) + дебиторскую задолженность, которая исполнится до или в крайнюю дату предъявления по оферте (бумаги, которые поступят позже крайней даты предъявления нам не интересны).
	//Задолженность по сделкам Репо: Учитываем всю задолженность по первой части репо. По второй части репо учитываем всю кредиторскую задолженность (т.к. у нас есть обязательство и мы должны его исполнить, т.е. мы не можем скинуть эти бумаги по оферте) + дебиторскую задолженность, которая исполнится до или в крайнюю дату предъявления по оферте.
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация КАК Организация
		|ПОМЕСТИТЬ _ДействующиеСчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация В (&РЭМ, &Траст)
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &МинусТриРабочихДня)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.Организация КАК Организация,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
		|ПОМЕСТИТЬ _ОстаткиЦенныхБумагОстаткиИОбороты
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
		|			&МинусТриРабочихДня,
		|			&КонецТекущегоДня,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Организация В (&РЭМ, &Траст)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДоверительногоУправления.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДоверительногоУправления)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.Организация КАК Организация,
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ПоступившиеНовыеЦенныеБумаги
		|ИЗ
		|	_ОстаткиЦенныхБумагОстаткиИОбороты КАК _ОстаткиЦенныхБумагОстаткиИОбороты
		|ГДЕ
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ * ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА УсловияСделокСрезПоследних.ДатаИсполнения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА УсловияСделокСрезПоследних.ДатаПоставки
		|		ИНАЧЕ УсловияСделокСрезПоследних.ДатаИсполнения
		|	КОНЕЦ КАК ДатаИсполнения,
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага ЕСТЬ NULL КАК НоваяЦеннаяБумага
		|ПОМЕСТИТЬ _ЗадолженностьПоЦеннымБумагамПоСделкам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&КонецТекущегоДня,
		|			Организация В (&РЭМ, &Траст)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДоверительногоУправления.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДоверительногоУправления)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиЦенныхБумагОстаткиИОбороты КАК _ОстаткиЦенныхБумагОстаткиИОбороты
		|		ПО ЗадолженностиПоЦеннымБумагамОстатки.Организация = _ОстаткиЦенныхБумагОстаткиИОбороты.Организация
		|			И ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления = _ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления
		|			И ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага = _ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(
		|				,
		|				Организация В (&РЭМ, &Траст)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК УсловияСделокСрезПоследних
		|		ПО ЗадолженностиПоЦеннымБумагамОстатки.Организация = УсловияСделокСрезПоследних.Организация
		|			И ЗадолженностиПоЦеннымБумагамОстатки.Основание = УсловияСделокСрезПоследних.Сделка
		|			И ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Организация КАК Организация,
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Поручение.ДатаИсполненияПо КАК ДатаИсполнения,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ * ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	_ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага ЕСТЬ NULL КАК НоваяЦеннаяБумага
		|ПОМЕСТИТЬ _ЗадолженностьПоЦеннымБумагамПоПоручениям
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям.Остатки(
		|			&КонецТекущегоДня,
		|			Организация В (&РЭМ, &Траст)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ДействующиеСчетаДоверительногоУправления.Ссылка
		|					ИЗ
		|						_ДействующиеСчетаДоверительногоУправления КАК _ДействующиеСчетаДоверительногоУправления)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиЦенныхБумагОстаткиИОбороты КАК _ОстаткиЦенныхБумагОстаткиИОбороты
		|		ПО ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Организация = _ОстаткиЦенныхБумагОстаткиИОбороты.Организация
		|			И ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.СчетДоверительногоУправления = _ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления
		|			И ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.ЦеннаяБумага = _ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Поручение.ДатаИсполненияПо <> ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ЮрФизЛица
		|		И ВЫРАЗИТЬ(КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Справочник.ЮрФизЛица).ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо) КАК ФизЛицо,
		|	МИНИМУМ(ВложенныйЗапрос.ДатаФиксацииОстатков) КАК ДатаФиксацииОстатков
		|ПОМЕСТИТЬ _НовыеЦенныеБумаги
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ПоступившиеНовыеЦенныеБумаги.Организация КАК Организация,
		|		_ПоступившиеНовыеЦенныеБумаги.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ПоступившиеНовыеЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|		&ТекущаяДата КАК ДатаФиксацииОстатков
		|	ИЗ
		|		_ПоступившиеНовыеЦенныеБумаги КАК _ПоступившиеНовыеЦенныеБумаги
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам.Организация,
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам.СчетДоверительногоУправления,
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам.ЦеннаяБумага,
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам.ДатаИсполнения
		|	ИЗ
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам КАК _ЗадолженностьПоЦеннымБумагамПоСделкам
		|	ГДЕ
		|		_ЗадолженностьПоЦеннымБумагамПоСделкам.НоваяЦеннаяБумага
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям.Организация,
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям.СчетДоверительногоУправления,
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям.ЦеннаяБумага,
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям.ДатаИсполнения
		|	ИЗ
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям КАК _ЗадолженностьПоЦеннымБумагамПоПоручениям
		|	ГДЕ
		|		_ЗадолженностьПоЦеннымБумагамПоПоручениям.НоваяЦеннаяБумага) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ВложенныйЗапрос.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления,
		|	ВложенныйЗапрос.ЦеннаяБумага,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ЮрФизЛица
