		|		ПО _УсловияОфертНовыхЦенныхБумаг.Организация = _ЗадолженностьПоЦеннымБумагамПоСделкамИтоги.Организация
		|			И _УсловияОфертНовыхЦенныхБумаг.СчетДоверительногоУправления = _ЗадолженностьПоЦеннымБумагамПоСделкамИтоги.СчетДоверительногоУправления
		|			И _УсловияОфертНовыхЦенныхБумаг.Облигация = _ЗадолженностьПоЦеннымБумагамПоСделкамИтоги.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги КАК _ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги
		|		ПО _УсловияОфертНовыхЦенныхБумаг.Организация = _ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги.Организация
		|			И _УсловияОфертНовыхЦенныхБумаг.СчетДоверительногоУправления = _ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги.СчетДоверительногоУправления
		|			И _УсловияОфертНовыхЦенныхБумаг.Облигация = _ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьПоСделкамРепоИтоги КАК _ЗадолженностьПоСделкамРепоИтоги
		|		ПО _УсловияОфертНовыхЦенныхБумаг.Организация = _ЗадолженностьПоСделкамРепоИтоги.Организация
		|			И _УсловияОфертНовыхЦенныхБумаг.СчетДоверительногоУправления = _ЗадолженностьПоСделкамРепоИтоги.СчетДоверительногоУправления
		|			И _УсловияОфертНовыхЦенныхБумаг.Облигация = _ЗадолженностьПоСделкамРепоИтоги.ЦеннаяБумага
		|ГДЕ
		|	ЕСТЬNULL(_ПоступившиеНовыеЦенныеБумаги.КоличествоОстаток, 0) + ЕСТЬNULL(_ЗадолженностьПоЦеннымБумагамПоСделкамИтоги.КоличествоОстаток, 0) + ЕСТЬNULL(_ЗадолженностьПоЦеннымБумагамПоПоручениямИтоги.КоличествоОстаток, 0) + ЕСТЬNULL(_ЗадолженностьПоСделкамРепоИтоги.КоличествоОстаток, 0) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация КАК Организация,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Период КАК Период
		|ПОМЕСТИТЬ _ВсеКодыУБрокеров
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			,
		|			Организация В (&РЭМ, &Траст)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_ОбщиеОстатки.СчетДоверительногоУправления
		|					ИЗ
		|						_ОбщиеОстатки КАК _ОбщиеОстатки)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ТекущаяДата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеКодыУБрокеров.Брокер КАК Брокер,
		|	_ВсеКодыУБрокеров.Код КАК Код
		|ПОМЕСТИТЬ _СчетаСОднимБрокером
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеКодыУБрокеров.Организация КАК Организация,
		|		_ВсеКодыУБрокеров.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеКодыУБрокеров.Код) КАК КоличествоКодов
		|	ИЗ
		|		_ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеКодыУБрокеров.Организация,
		|		_ВсеКодыУБрокеров.СчетДоверительногоУправления
		|	
		|	ИМЕЮЩИЕ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеКодыУБрокеров.Код) = 1) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|		ПО ВложенныйЗапрос.Организация = _ВсеКодыУБрокеров.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _ВсеКодыУБрокеров.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВсеКодыУБрокеров.Брокер КАК Брокер,
		|	_ВсеКодыУБрокеров.Код КАК Код
		|ПОМЕСТИТЬ _КодыБрокеровСМаксимальнымПериодом
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеКодыУБрокеров.Организация КАК Организация,
		|		_ВсеКодыУБрокеров.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МАКСИМУМ(_ВсеКодыУБрокеров.Период) КАК Период
		|	ИЗ
		|		_ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеКодыУБрокеров.Организация,
		|		_ВсеКодыУБрокеров.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеКодыУБрокеров КАК _ВсеКодыУБрокеров
		|		ПО ВложенныйЗапрос.Организация = _ВсеКодыУБрокеров.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _ВсеКодыУБрокеров.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Период = _ВсеКодыУБрокеров.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_СчетаСОднимБрокером.Код, _КодыБрокеровСМаксимальнымПериодом.Код) КАК Код
		|ПОМЕСТИТЬ _КодыУБрокеров
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ОбщиеОстатки.Организация КАК Организация,
		|		_ОбщиеОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|	ИЗ
		|		_ОбщиеОстатки КАК _ОбщиеОстатки) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаСОднимБрокером КАК _СчетаСОднимБрокером
		|		ПО ВложенныйЗапрос.Организация = _СчетаСОднимБрокером.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _СчетаСОднимБрокером.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыБрокеровСМаксимальнымПериодом КАК _КодыБрокеровСМаксимальнымПериодом
		|		ПО ВложенныйЗапрос.Организация = _КодыБрокеровСМаксимальнымПериодом.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _КодыБрокеровСМаксимальнымПериодом.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхКОбработке.Текст КАК ТекстПисьма
		|ПОМЕСТИТЬ _ПисьмаКОтправке
		|ИЗ
		|	Справочник.ПакетыДанныхКОбработке КАК ПакетыДанныхКОбработке
		|ГДЕ
		|	ПакетыДанныхКОбработке.ДатаСоздания >= &МинусТриРабочихДня
		|	И ПакетыДанныхКОбработке.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо)
		|	И (ВЫРАЗИТЬ(ПакетыДанныхКОбработке.Тема КАК СТРОКА(100))) = (ВЫРАЗИТЬ(&ТемаПисьма КАК СТРОКА(100)))
		|	И НЕ ПакетыДанныхКОбработке.ОбработкаОтменена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщиеОстатки.Организация КАК Организация,
		|	_ОбщиеОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОбщиеОстатки.Облигация КАК Облигация,
		|	_ОбщиеОстатки.ДатаВыкупа КАК ДатаВыкупа,
		|	_ОбщиеОстатки.ТолькоДляФизическихЛиц КАК ТолькоДляФизическихЛиц,
		|	_ОбщиеОстатки.ЦенаПроцент КАК ЦенаПроцент,
		|	_ОбщиеОстатки.Цена КАК Цена,
		|	_ОбщиеОстатки.АкцептС КАК АкцептС,
		|	_ОбщиеОстатки.АкцептПо КАК АкцептПо,
		|	_ОбщиеОстатки.ТипОферты КАК ТипОферты,
		|	_ОбщиеОстатки.ДатаОбъявления КАК ДатаОбъявления,
		|	_ОбщиеОстатки.ДатаФиксацииОстатков КАК ДатаФиксацииОстатков,
		|	_ОбщиеОстатки.Количество КАК Количество,
		|	_ОбщиеОстатки.Количество * _ОбщиеОстатки.Цена КАК Сумма,
		|	_КодыУБрокеров.Код КАК КодУБрокера,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК КодISIN
		|ИЗ
		|	_ОбщиеОстатки КАК _ОбщиеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыУБрокеров КАК _КодыУБрокеров
		|		ПО _ОбщиеОстатки.Организация = _КодыУБрокеров.Организация
		|			И _ОбщиеОстатки.СчетДоверительногоУправления = _КодыУБрокеров.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ОбщиеОстатки.Облигация = КодыВТорговыхСистемахСрезПоследних.Объект
		|			И (КодыВТорговыхСистемахСрезПоследних.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN))
		|ИТОГИ ПО
		|	Облигация,
		|	ДатаВыкупа,
		|	Организация";
	
	ТекДата = ТекущаяДатаСеанса();
	
	Запрос.УстановитьПараметр("КонецТекущегоДня", КонецДня(ТекДата));
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("МинусТриРабочихДня", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекДата, -4));
	Запрос.УстановитьПараметр("РЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("Траст", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	Запрос.УстановитьПараметр("ТемаПисьма", ТемаПисьма);
#EndRegion
			
	ГруппировкаПоЦеннойБумаге = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Облигация");
	
	ТекстПисьма = "";
	
	Пока ГруппировкаПоЦеннойБумаге.Следующий() Цикл
							
		ГруппировкаПоДатеВыкупа = ГруппировкаПоЦеннойБумаге.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ДатаВыкупа");
		
		Пока ГруппировкаПоДатеВыкупа.Следующий() Цикл
			
			ДобавитьУсловиеОферты = Истина;
			
			ГруппировкаПоОрганизации = ГруппировкаПоДатеВыкупа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Организация");
			
			Пока ГруппировкаПоОрганизации.Следующий() Цикл
				
				ДобавитьДанныеОрганизации = Истина;
				
				Выборка = ГруппировкаПоОрганизации.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Если ДобавитьУсловиеОферты Тогда
						
						ТекстПисьма = ТекстПисьма + ?(ТекстПисьма = "", "", "<br>") + "<table cols=""4""><tr class=""top""><td colspan=""4"">Облигация: " + Выборка.Облигация + " (ISIN " + Выборка.КодISIN + ")</td></tr>";
						ТекстПисьма = ТекстПисьма + "<tr class=""top2""><td colspan=""4"">Условия оферты</td></tr>";
						ТекстПисьма = ТекстПисьма + "<tr class=""line""><td colspan=""4"">Дата выкупа: <b>" + Формат(Выборка.ДатаВыкупа, "ДФ=dd.MM.yyyy") + "</b><br>";
						ТекстПисьма = ТекстПисьма + "Только для физ лиц: <b>" + Выборка.ТолькоДляФизическихЛиц + "</b><br>";
						ТекстПисьма = ТекстПисьма + "Цена: <b>" + Выборка.Цена + "</b><br>";
						ТекстПисьма = ТекстПисьма + "Цена процент: <b>" + Выборка.ЦенаПроцент + "</b><br>";
						ТекстПисьма = ТекстПисьма + "Акцепт с: <b>" + Формат(Выборка.АкцептС, "ДФ=dd.MM.yyyy") + "</b> по: <b>" + Формат(Выборка.АкцептПо, "ДФ=dd.MM.yyyy") + "</b><br>";   
						ТекстПисьма = ТекстПисьма + "Тип оферты: <b>" + Выборка.ТипОферты + "</b><br>";  
						ТекстПисьма = ТекстПисьма + "Дата объявления: <b>" + Формат(Выборка.ДатаОбъявления, "ДФ=dd.MM.yyyy") + "</b></td></tr>"; 
						
						ТекстПисьма = ТекстПисьма + 
							"<tr class=""top""><td colspan=""4"">Остатки ценных бумаг</td></tr>
							|<tr class=""top""><td>Счет доверительного управления</td><td>Код у брокера</td><td>Количество</td><td>Сумма</td></tr>";
							
						ДобавитьУсловиеОферты = Ложь;
						
					КонецЕсли;
					
					Если ДобавитьДанныеОрганизации Тогда
						ТекстПисьма = ТекстПисьма + "<tr class=""top3""><td colspan=""4"">" + Выборка.Организация + "</td></tr>";
						ДобавитьДанныеОрганизации = Ложь;
					КонецЕсли;
					
					ТекстПисьма = ТекстПисьма + "<tr class=""line""><td>" + Выборка.СчетДоверительногоУправления + "</td>";
					ТекстПисьма = ТекстПисьма + "<td>" + Выборка.КодУБрокера + "</td>";
					ТекстПисьма = ТекстПисьма + "<td>" + Выборка.Количество + "</td>";
					ТекстПисьма = ТекстПисьма + "<td>" + Выборка.Сумма + "</td></tr>";
	
				КонецЦикла;
				
			КонецЦикла;
			
			ТекстПисьма = ТекстПисьма + "</table>";

		КонецЦикла;
						
	КонецЦикла;
	
	Если ТекстПисьма <> "" Тогда
		
		ТекстПисьма = 
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style>
			|		body  { font: 10pt sans-serif; }
			|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td    { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
			|		.top  { font-size: 14px; font-weight: 600; background: #F4ECC5; }
			|		.top2 { font-size: 14px; background: #F8F2D8; }
			|		.top3 { font-size: 14px; font-weight: 600; background: #FBF9EC; }
			|		.line { font-size: 12px;}
			|	</style>
			|</head>
			|<body>
			|" + ТекстПисьма + "</body></html>";
		
		
		ПисьмаКОтправке = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПисьмаКОтправке"].ПолучитьДанные().Выгрузить();
		
		Для Каждого Письмо Из ПисьмаКОтправке Цикл
							
			Если СтрНайти(Письмо.ТекстПисьма, ТекстПисьма) > 0 Тогда
				
				РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
				Возврат;
				
			КонецЕсли;
			
		КонецЦикла;
		
		РеквизитыОповещения = Новый Структура("Тема, Текст", ТемаПисьма, ТекстПисьма); 
		Справочники.Оповещения.СформироватьОповещения("Обработка._СозданиеЗадачВПервойФорме.ПроверкаОферт", Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
			
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура СоздатьЗадачиПоЗапросамФССП(Организация, РегламентноеЗадание = Ложь, КонтрольНаличияВложений = Ложь) Экспорт 
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СоздатьЗадачиПоЗапросамФССП()";
	
	ПараметрыДляСтатистики = "Организация,РегламентноеЗадание,КонтрольОтсутствияВложений";
	ЗначенияПараметров = Новый Структура(ПараметрыДляСтатистики, Организация, РегламентноеЗадание, КонтрольНаличияВложений);
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЗначенияПараметров, ПараметрыДляСтатистики);

	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(		
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТекстСообщенияПользователям = "";
	Сервер_1Ф = ?(ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза, "1f", "test1f") + ".g1.lan";
	
	Запрос = Новый Запрос;

#Область Текст_Запроса	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Номер КАК Номер,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидДокумента,
		|	ВЫБОР
		|		КОГДА ВходящийДокумент.Отправитель ССЫЛКА Справочник.ЮрФизЛица
		|			ТОГДА РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу
		|		ИНАЧЕ ВходящийДокумент.Отправитель
		|	КОНЕЦ КАК Отправитель,
		|	ВходящийДокумент.СрокОтвета КАК СрокОтвета,
		|	КодыВоВнешнихСистемах.Код КАК КодУК,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерВхДок,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВхДок,
		|	НомераТранзакций.Номер КАК НомерЗадачи
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации)
		|					И Объект = &Организация) КАК КодыВоВнешнихСистемах
		|		ПО ВходящийДокумент.Организация = КодыВоВнешнихСистемах.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераТранзакций КАК НомераТранзакций
		|		ПО ВходящийДокумент.Ссылка = НомераТранзакций.Субъект
		|			И (НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВходящийДокумент.Отправитель ССЫЛКА Справочник.ЮрФизЛица)
		|			И ВходящийДокумент.Отправитель = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ВходящийДокумент.Организация = &Организация
		|	И НЕ ВходящийДокумент.ПометкаУдаления
		|	И ВходящийДокумент.Дата > &НачалоПериода
		|	И ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ЗапросФССП)
		|	И (НомераТранзакций.Субъект ЕСТЬ NULL Или &КонтрольНаличияВложений)";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -3));
	Запрос.УстановитьПараметр("КонтрольНаличияВложений", КонтрольНаличияВложений);

	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Количество() = 0 Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения(Сервер_1Ф); 
	
	Если ПараметрыПодключения = Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Не удалось установить соединение с 1Ф.");
		Возврат;			
	КонецЕсли;
	
	НомераНовыхЗадач = "";
	
	Пока Выборка.Следующий() Цикл 
		
		Если ЗначениеЗаполнено(Выборка.НомерЗадачи) Тогда	
			НомерЗадачи = Выборка.НомерЗадачи;	
		Иначе
		
			ПараметрыЗадачи = Новый Структура();
			ПараметрыЗадачи.Вставить("subcatId", 169);
			ПараметрыЗадачи.Вставить("userToMakeOwnerId", 3686); 
			ПараметрыЗадачи.Вставить("taskText", Выборка.ВидДокумента);
			ПараметрыЗадачи.Вставить("priorityId", 1);
			
			Если ЗначениеЗАполнено(Выборка.СрокОтвета) Тогда
				ПараметрыЗадачи.Вставить("orderedTime", Формат(Выборка.СрокОтвета, "ДФ=гггг-ММ-дд") + "T12:00:00"); 		
			КонецЕсли; 
			
			ДопПараметры = Новый Массив();
					
			ДопПараметры.Добавить(Новый Структура("id, value", 51, Выборка.КодУК));
			ДопПараметры.Добавить(Новый Структура("id, value", 47, Выборка.Отправитель));
			ДопПараметры.Добавить(Новый Структура("id, value", 440, "72041"));
			
			ПараметрыЗадачи.Вставить("extParams", ДопПараметры);
			
			ТелоЗапроса = ПолучитьСтрокуJSON(ПараметрыЗадачи);
			
			ТекстСообщения = "Ошибка создания задачи по запросу ФССП в 1-ой форме.";
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", ТелоЗапроса, ТекстСообщения, 1);
				
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Продолжить;
			Иначе
				
				ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
				НомерЗадачи = Формат(ОтветОбъект.data.value, "ЧГ=0");
				
				//запишем в регистр "Номера транзакций"
				СтруктураКлюча = Новый Структура();
				СтруктураКлюча.Вставить("mk", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ПрефиксНумерации"));
				СтруктураКлюча.Вставить("request_number", Выборка.НомерВхДок); 
				СтруктураКлюча.Вставить("request_date", Формат(Выборка.ДатаВхДок, "ДФ=гггг-ММ-дд")); 
	
				ТекКлюч = ПолучитьСтрокуJSON(СтруктураКлюча);

				Если Не ЗаписатьНомерЗадачи(НомерЗадачи, Выборка.Ссылка, ТекКлюч) Тогда				
					ЗарегистрироватьОшибку("При создании задачи по запросу ФССП в 1-ой форме. Не удалось записать номер задачи [" + НомерЗадачи + "] в регистр [Номера транзакций]" + Символы.ПС + ОписаниеОшибки());
					Продолжить;	
				КонецЕсли;
				
				НомераНовыхЗадач = НомераНовыхЗадач + ?(НомераНовыхЗадач = "", "", ", ") + НомерЗадачи; 
				
			КонецЕсли;
			
		КонецЕсли;
			
		//прикрепим файлы к задаче
		ДанныеФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(Выборка.Ссылка);
			
		Если РегламентноеЗадание И КонтрольНаличияВложений И ДанныеФайлов.Количество() = 0 Тогда 
			
			ТекстСообщенияПользователям = ТекстСообщенияПользователям + Символы.ПС
				+ "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка, Выборка.Номер) + "</td>"
				+ "<td><A href=""http://" + Сервер_1Ф + "/maintaskform.aspx?TaskID=" + НомерЗадачи + """>" + НомерЗадачи + "</A></td>"
				+ "<td class=""error"">В первой форме создана задача по запросу ФССП. Во входящем документе отсутствуют вложенные файлы.</td></tr>";
					
			Продолжить;
			
		КонецЕсли;
			
		Для Каждого ЭлементДанных Из ДанныеФайлов Цикл
			
			ОписаниеФайла = РаботаСФайловымХранилищем.ПолучитьФайл(ЭлементДанных.ИдентификаторФайла);
			
			ТекФайл = ПолучитьИзВременногоХранилища(ОписаниеФайла.Адрес);
			ИмяТекФайла = ОписаниеФайла.Имя + "." + ОписаниеФайла.Расширение; 
			
			СтруктураЗапроса = Новый Структура();
			СтруктураЗапроса.Вставить("writeComment", Ложь);
			СтруктураЗапроса.Вставить("fileData", Base64Строка(ТекФайл));
			СтруктураЗапроса.Вставить("fileName", ИмяТекФайла);
			
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
								
			ТекстОшибки = "Не удалось загрузить файл [" + ИмяТекФайла + "] в 1Ф из входящего документа [" + Выборка.Ссылка + "]."; 
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/files/preupload/base64", ТелоЗапроса, ТекстОшибки, 1); 
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстОшибки);
				Продолжить;
			КонецЕсли;
				
			ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не ОтветОбъект.Свойство("data") Тогда
				ЗарегистрироватьОшибку("Не удалось загрузить файл [" + ИмяТекФайла + "] в 1Ф из входящего документа [" + Выборка.Ссылка + "]." + Символы.ПС + ОписаниеОшибки());
				Продолжить;
			КонецЕсли;
							
			Для Каждого ДанныеФайла Из ОтветОбъект.data Цикл 
				
				ИдФайла = Формат(ДанныеФайла.preUploadFileId, "ЧГ=0");
				
				СтруктураЗапроса = Новый Структура();
				СтруктураЗапроса.Вставить("taskId", НомерЗадачи);
				СтруктураЗапроса.Вставить("preUploadedFileId", ИдФайла); 
				
				ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
				
				ТекстОшибки = "Не удалось вложить файл [id=" + ИдФайла + ", name=" + ИмяТекФайла + "] в задачу 1Ф [" + НомерЗадачи + "] из входящего документа [" + Выборка.Ссылка + "].";
				
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/files/upload/PreUploadedFilesToTask", ТелоЗапроса, ТекстОшибки, 1);
				
				Если HTTPОтвет = Неопределено Тогда
					ЗарегистрироватьОшибку(ТекстОшибки);
				КонецЕсли;
						
			КонецЦикла;
								
		КонецЦикла;
							
	КонецЦикла;
	
	Если ТекстСообщенияПользователям <> "" Тогда
		
		ТекстСообщенияПользователям =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body     { font-family: ""Arial""; font-size: 12px; }
			|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td       { border: 1px solid #ACC8BD; padding: 5px; }
			|		.top     { background: #E4F0DD; }
			|		.error   { background: #FFA07A; }
			|	</style>
			|</head><body><table cols=""3"">
			|<tr class=""top""><td>Входящий документ 1С</td><td>Задача в первой форме</td><td>Комментарий</td></tr>"
			+ ТекстСообщенияПользователям + "</table></body></html>";

		РеквизитыОповещения = Новый Структура("Организация, Текст", Организация, ТекстСообщенияПользователям);
		Справочники.Оповещения.СформироватьОповещения("Обработка._СозданиеЗадачВПервойФорме.ЗапросыФССП", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

	ОповеститьОбОшибках(Неопределено);
	
	Если Не РегламентноеЗадание Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каманда выполнена." + ?(НомераНовыхЗадач = "", "", " Созданы новые задачи: " + НомераНовыхЗадач));	
	КонецЕсли;
			
КонецПроцедуры

Функция ЗаписатьНомерЗадачи(НомерЗадачи, СубъектСсылка, КлючЗаписи)
	
	РезультатЗаписи = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
				
	Попытка
		Запись = РегистрыСведений.НомераТранзакций.СоздатьМенеджерЗаписи();
	
		Запись.Субъект                 = СубъектСсылка;
		Запись.ВнешняяСистема          = Справочники.ВнешниеСистемы.ПерваяФорма;
		Запись.УникальныйИдентификатор = Новый УникальныйИдентификатор;
		Запись.Номер                   = НомерЗадачи;
		Запись.Ключ                    = КлючЗаписи;

		Запись.Записать();
		
		РезультатЗаписи = Истина;
	Исключение
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат РезультатЗаписи;
		
КонецФункции


////////////////////////////////////////////////////////////////////////////////

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;