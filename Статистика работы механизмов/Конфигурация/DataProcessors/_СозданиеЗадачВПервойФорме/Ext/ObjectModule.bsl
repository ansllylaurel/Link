// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Создание задач в первой форме", "0.50","", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СоздатьЗадачиПоОфертам", "Создание задач по офертам",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СоздатьЗадачиПоЗапросамФССП", "Создание задач по запросам ФССП",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СоздатьЗадачиПоЗапросамФССПиПроверитьВложения", "Создание задач по запросам ФССП и проверить вложения",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверкаОфертПоступившихНовыхОблигаций", "Проверка оферт поступивших новых облигаций",,  Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
			
	Если ИдентификаторКоманды = "СоздатьЗадачиПоОфертам" Тогда
		
		ЗаполнитьЗначенияРеквизитовИзПараметров(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ПараметрыКоманды);
		СоздатьЗадачиПоОфертам(Истина); //ПроверятьВесьПериодПредъявления
		
	ИначеЕсли ИдентификаторКоманды = "ПроверкаОфертПоступившихНовыхОблигаций" Тогда
		
		ПроверитьОфертыПоступившихНовыхОблигаций();
		
	ИначеЕсли ИдентификаторКоманды = "СоздатьЗадачиПоЗапросамФССП"
		Или ИдентификаторКоманды = "СоздатьЗадачиПоЗапросамФССПиПроверитьВложения" Тогда
		
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка); 
		
		КонтрольНаличияВложений = (ИдентификаторКоманды = "СоздатьЗадачиПоЗапросамФССПиПроверитьВложения");
				
		Если ПараметрыКоманды.Свойство("Организация") И ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
			СоздатьЗадачиПоЗапросамФССП(ПараметрыКоманды.Организация, Истина, КонтрольНаличияВложений);	
		Иначе
			ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] отсутствует параметр [Организация].");	
		КонецЕсли;
		
	Иначе
		ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
	КонецЕсли;
	
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры

// Интерфейс для запуска отложенного задания
//
// Параметры:
//  Команда			 - Строка - Идентификатор выполняемого метода
//  ПараметрыКоманды - Структура - Содержит параметры запуска метода
//
Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Если Метод <> "СоздатьЗадачуОферты" Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_СозданиеЗадачВПервойФорме");
	
	Если ОбработкаСсылка = Неопределено Тогда
		ЗарегистрироватьОшибку("В справочнике дополнительных отчетов и обработок отсутствует обработка с именем [_СозданиеЗадачВПервойФорме].");
		Возврат;	
	КонецЕсли;
	
	МассивКоманд = ОбработкаСсылка.Команды.НайтиСтроки(Новый Структура("Идентификатор", "СоздатьЗадачуОферты"));
	
	Для Каждого КомандаСозданияЗадачи из МассивКоманд Цикл
			
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ОбработкаСсылка, "СоздатьЗадачуОферты", КомандаСозданияЗадачи.ГруппаПараметров);
					
		ЗаполнитьЗначенияРеквизитовИзПараметров(ОбработкаСсылка, ПараметрыКоманды);
		
		Прервать;
		
	КонецЦикла;
		
	КлючиЗапуска = Новый ТаблицаЗначений;
	КлючиЗапуска.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
		
	Для Каждого Экземпляр Из Экземпляры Цикл
	
		НовыйКлючЗапуска = КлючиЗапуска.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйКлючЗапуска, Экземпляр.Параметры);
		НовыйКлючЗапуска.Идентификатор = Экземпляр.Идентификатор;
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлючиЗапуска.Облигация КАК Облигация,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _КлючиЗапуска
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_КлючиЗапуска.Облигация КАК Облигация,
		|	_КлючиЗапуска.Идентификатор КАК Идентификатор
		|ИЗ
		|	_КлючиЗапуска КАК _КлючиЗапуска
		|ИТОГИ ПО
		|	Облигация";
	
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	
	ВыборкаГруппировкаПоОблигации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Облигация");
	
	Пока ВыборкаГруппировкаПоОблигации.Следующий() Цикл
		
		Если ВыборкаГруппировкаПоОблигации.Облигация <> Неопределено Тогда
			ЭтотОбъект.Облигация = ВыборкаГруппировкаПоОблигации.Облигация;
		КонецЕсли;
		
		СоздатьЗадачиПоОфертам(Истина);
				
		ВыборкаИдентификатор = ВыборкаГруппировкаПоОблигации.Выбрать();
		
		Пока ВыборкаИдентификатор.Следующий() Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаИдентификатор.Идентификатор);
		КонецЦикла; 
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьЗначенияРеквизитовИзПараметров(ОбработкаСсылка, ПараметрыКоманды)
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ОбработкаСсылка);
	ЭтотОбъект.ДатаФормированияОстатков = ТекущаяДатаСеанса();
		
	//Количество рабочих дней до даты начала предъявления за которое нужно поставить задачу.
	//Функция учитывает и текущий день: 
	//	1. поэтому "Количество дней" + 1,
	//	2. В условии отбора "АкцептС" < ДатаНачалаПредьявления, еще + 1 т.к. если дата "АкцептС" выпадает на выходные - задачу ставим за три рабочих дня без учета выходных,
	//	т.е. как будто "АкцептС" выпал на последний рабочий день перед выходными. 
	ЭтотОбъект.ДатаНачалаПредъявления = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.ДатаФормированияОстатков), ПараметрыКоманды.КоличествоДней + 2); 
			
	//В режиме перезаписи сверяется количество ценнных бумаг на остатках с данными в табличной части задачи.
	//Если есть расхождения - табличная часть перезаписывается (актуальными данными из 1С).
	ЭтотОбъект.РежимПерезаписи = Истина;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ЕстьОшибки)Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры

Процедура СверитьДанныеСПервойФормой(ТаблицаЗадач, ПараметрыПодключения)
	
	ПараметрыЗадач1Ф = Новый ТаблицаЗначений;
	ПараметрыЗадач1Ф.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ПараметрыЗадач1Ф.Колонки.Добавить("РегНомер", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(21)));
	ПараметрыЗадач1Ф.Колонки.Добавить("Закрыта", Новый ОписаниеТипов("Булево"));
	ПараметрыЗадач1Ф.Колонки.Добавить("КлючЗадачиJson", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ПараметрыЗадач1Ф.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("ТаблицаЗначений"));
	ПараметрыЗадач1Ф.Колонки.Добавить("Акцепт", Новый ОписаниеТипов("Булево"));
	ПараметрыЗадач1Ф.Колонки.Добавить("ДатаВыкупа", Новый ОписаниеТипов("Дата"));
	ПараметрыЗадач1Ф.Колонки.Добавить("АкцептПо", Новый ОписаниеТипов("Дата"));
	ПараметрыЗадач1Ф.Колонки.Добавить("КоличествоКлиентов", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	ПараметрыЗадач1Ф.Колонки.Добавить("Ошибки");
	
	ОтправленныеЗапросы = Новый Массив;
	
	//1. Получаем из 1Ф данные задач по параметру "рег номер"
	ТекстСообщения = "Не удалось получить данные задачи (оферты) по рег.номеру облигации [%1]";
		
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 100);
	СтруктураЗапроса.Вставить("select", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("field, type", "taskId", "numberValue")));
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("ExtParam185, ExtParam469"));
	
	СтруктураЗапроса.filterModel.ExtParam185 = Новый Структура("filterType, type, filter", "text", "equals");
	СтруктураЗапроса.filterModel.ExtParam469 = Новый Структура("filterType, type, dateFrom", "date", "equals");
	
	Для Каждого СтрокаТаблицаЗадач Из ТаблицаЗадач Цикл
		
		Если ОтправленныеЗапросы.Найти(СтрокаТаблицаЗадач.РегНомер) = Неопределено Тогда
				
			СтруктураЗапроса.filterModel.ExtParam185.filter = СтрокаТаблицаЗадач.РегНомер;
			СтруктураЗапроса.filterModel.ExtParam469.dateFrom = Формат(СтрокаТаблицаЗадач.ДатаВыкупа, "ДФ=yyyy-MM-dd");
			
			ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/186/data", ТелоЗапроса, ТекстСообщения);
			
			ОтправленныеЗапросы.Добавить(СтрокаТаблицаЗадач.РегНомер); 
			
			Если HTTPОтвет = Неопределено Тогда
				СтрокаТаблицаЗадач.Ошибки.Добавить(СтрШаблон(ТекстСообщения, СтрокаТаблицаЗадач.РегНомер));
				Продолжить;
			КонецЕсли;
			
			РезультатЗапроса = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
			
			Если Не (РезультатЗапроса.Свойство("totalCount") И РезультатЗапроса.Свойство("tasksDataSourceResponse"))  Тогда
				СтрокаТаблицаЗадач.Ошибки.Добавить(СтрШаблон(ТекстСообщения, СтрокаТаблицаЗадач.РегНомер));
				Продолжить;
			КонецЕсли;
			//в 1-ой форме отсутствуют задачи с таким параметром
			Если РезультатЗапроса.totalCount = 0 И Не ЗначениеЗаполнено(СтрокаТаблицаЗадач.НомерЗадачи) Тогда
				Продолжить;		 
			КонецЕсли;

			//по одному рег номеру может быть несколько задач т.к.
			//1. для портфелей с дефолтными бумагами задачи ставятся отдельно.
			//2. по одной бумаге может быть несколько оферт
			Для Каждого Задача Из РезультатЗапроса.tasksDataSourceResponse Цикл
				
				НоваяСтрока = ПараметрыЗадач1Ф.Добавить();
				НоваяСтрока.НомерЗадачи = Формат(Задача.taskId, "ЧГ=0");
				НоваяСтрока.Закрыта     = Задача.isClosed;
				НоваяСтрока.РегНомер    = СтрокаТаблицаЗадач.РегНомер;
	
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицаЗадач.НомерЗадачи) Тогда
			
			МассивЗадач1Ф = ПараметрыЗадач1Ф.НайтиСтроки(Новый Структура("НомерЗадачи", СтрокаТаблицаЗадач.НомерЗадачи));
			  
			Если МассивЗадач1Ф.Количество() = 0 Тогда
				//Если среди найденых задач нет номера той задачи, которая зарегистрирована с таким параметром в 1С
				//добавим ее номер в таблицу для поиска задач по номеру в 1Ф.
				НоваяСтрока = ПараметрыЗадач1Ф.Добавить();
				НоваяСтрока.НомерЗадачи = СтрокаТаблицаЗадач.НомерЗадачи;
				НоваяСтрока.РегНомер    = СтрокаТаблицаЗадач.РегНомер;
				СтрокаТаблицаЗадач.Ошибки.Добавить("В ответ на запрос по параметру рег.номер [" + СтрокаТаблицаЗадач.РегНомер  + "] не найдена задача [" + СтрокаТаблицаЗадач.НомерЗадачи + "]. Проверьте задачу в 1Ф, и рег.номер ЦБ [" + СтрокаТаблицаЗадач.ЦеннаяБумага + "] в 1С.");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//2. Собираем парметры и ключи на основании данных 1Ф
	ТекстСообщения = "Не удалось получить данные по номеру задачи [%1]. Не собран ключ для сверки.";
	
	Для Каждого СтрокаПараметрыЗадач1Ф Из ПараметрыЗадач1Ф Цикл		
		
		СтрокаПараметрыЗадач1Ф.Ошибки = Новый Массив; 
		
		ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("taskId, selectedInfoParts", СтрокаПараметрыЗадач1Ф.НомерЗадачи, РаботаСКоллекциями.ЗначениеВМассив("ExtParams")));
		
		HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks", ТелоЗапроса, ТекстСообщения);

		Если HTTPОтвет = Неопределено Тогда
			СтрокаПараметрыЗадач1Ф.Ошибки.Добавить(СтрШаблон(ТекстСообщения, СтрокаПараметрыЗадач1Ф.НомерЗадачи));
		Иначе
			ДесериализоватьПараметрыЗадачи(СтрокаПараметрыЗадач1Ф, ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")));
		КонецЕсли;
		
		//если по рег номеру найдена задача в 1Ф, и для нее не удалось собрать все данные для дальнейшей сверки
		//исключаем загрузку задач с таким рег номером.
		Если СтрокаПараметрыЗадач1Ф.Ошибки.Количество() > 0 Тогда
			
			ТекстОшибкиПриСборкеКлюча = "";
			
			Для Каждого Ошибка Из СтрокаПараметрыЗадач1Ф.Ошибки Цикл
				ТекстОшибкиПриСборкеКлюча = ?(ТекстОшибкиПриСборкеКлюча = "", "", ТекстОшибкиПриСборкеКлюча + Символы.ПС) + Ошибка;
			КонецЦикла;

			МассивСтрокДанных1С = ТаблицаЗадач.НайтиСтроки(Новый Структура("РегНомер", СтрокаПараметрыЗадач1Ф.РегНомер));
					
			Для Каждого СтрокаДанных1С Из МассивСтрокДанных1С Цикл
				СтрокаДанных1С.Ошибки.Добавить(ТекстОшибкиПриСборкеКлюча);
			КонецЦикла;

		КонецЕсли;
	
	КонецЦикла;
	
	//3. Сверяем данные
	ТаблицаЗадач.Сортировать("НомерЗадачи ВОЗР"); //Сначала проверяем данные без номеров в 1Ф.
	
	Для Каждого СтрокаТаблицаЗадач Из ТаблицаЗадач Цикл
		
		Если СтрокаТаблицаЗадач.Ошибки.Количество() > 0 Тогда
			
			Для Каждого ТекстОшибки Из СтрокаТаблицаЗадач.Ошибки Цикл
				ЗарегистрироватьОшибку(ТекстОшибки);	
			КонецЦикла;
			
			Продолжить; //если есть ошибки -> данные могут быть не полными.
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицаЗадач.НомерЗадачи) Тогда
			
			МассивЗадач1Ф = ПараметрыЗадач1Ф.НайтиСтроки(Новый Структура("НомерЗадачи", СтрокаТаблицаЗадач.НомерЗадачи));
			
			Если МассивЗадач1Ф.Количество() = 0 Тогда
				
				ЗарегистрироватьОшибку("В 1-ой форме не найдена задача [" + СтрокаТаблицаЗадач.НомерЗадачи + "]");
				
			ИначеЕсли МассивЗадач1Ф.Количество() = 1 Тогда
				
				СтрокаТаблицаЗадач.СверитьПерезаписатьТабЧасть = ЭтотОбъект.РежимПерезаписи;
				
				Если СтрокаТаблицаЗадач.КлючЗадачиJson <> МассивЗадач1Ф[0].КлючЗадачиJson Тогда
					
					ТекстОшибкиНеравенстваКлючей = "Ошибка: Задача [" + СтрокаТаблицаЗадач.НомерЗадачи + "]. Ключ 1Ф [" + МассивЗадач1Ф[0].КлючЗадачиJson + "] не соответствует ключу 1С [" + СтрокаТаблицаЗадач.КлючЗадачиJson + "].";
					
					Для Каждого Ошибка1Ф Из МассивЗадач1Ф[0].Ошибки Цикл
						ТекстОшибкиНеравенстваКлючей = ТекстОшибкиНеравенстваКлючей + Символы.ПС + Ошибка1Ф;
					КонецЦикла;
					
					ЗарегистрироватьОшибку(ТекстОшибкиНеравенстваКлючей);
					
				КонецЕсли;
													
				Если МассивЗадач1Ф[0].Закрыта Тогда
					
					Если СтрокаТаблицаЗадач.АкцептПо >= ЭтотОбъект.ДатаФормированияОстатков Тогда 
						ЗарегистрироватьОшибку("В 1-ой форме задача [" + СтрокаТаблицаЗадач.НомерЗадачи + "] со статусом [Закрыта].");
					КонецЕсли;
					
					СтрокаТаблицаЗадач.СверитьПерезаписатьТабЧасть = Ложь;
					Продолжить; 
					
				КонецЕсли;
				
				Если СтрокаТаблицаЗадач.СверитьПерезаписатьТабЧасть Тогда
					СверитьТабличныеЧасти(МассивЗадач1Ф[0], СтрокаТаблицаЗадач);
				КонецЕсли;
					
				Если МассивЗадач1Ф[0].КоличествоКлиентов <> СтрокаТаблицаЗадач.КоличествоКлиентов Тогда
					СтрокаТаблицаЗадач.ИзменитьКоличествоКлиентов = Истина;	
				КонецЕсли;
				
				ПараметрыЗадач1Ф.Удалить(ПараметрыЗадач1Ф.Индекс(МассивЗадач1Ф[0]));
							
			КонецЕсли;
						
		Иначе
			
			//Проверяем задачи по рег номеру. Может есть активные задачи, у которых изменена дата выкупа как на стороне 1С, так и на стороне 1Ф.
			//Может по прошлым офертам остались активные задачи.
			МассивЗадачОтборПоРегНомеру = ПараметрыЗадач1Ф.НайтиСтроки(Новый Структура("РегНомер", СтрокаТаблицаЗадач.РегНомер));
											
			Если МассивЗадачОтборПоРегНомеру.Количество() = 0 Тогда
				
				СтрокаТаблицаЗадач.СоздатьЗадачу = Истина;	

			Иначе
				
				//Проверяем задачи по ключу. Может уже есть задачи с такими параметрами
				МассивЗадачОтборПоКлючу = ПараметрыЗадач1Ф.НайтиСтроки(Новый Структура("КлючЗадачиJson", СтрокаТаблицаЗадач.КлючЗадачиJson));
				
				Если МассивЗадачОтборПоКлючу.Количество() > 0 Тогда
					
					НомераЗадач = "";
					Для Каждого Задача1Ф Из МассивЗадачОтборПоКлючу Цикл
						НомераЗадач = ?(НомераЗадач = "", "", НомераЗадач + ", ") + Задача1Ф.НомерЗадачи + ?(Задача1Ф.Закрыта, " (Закрыта)", "") + "";
						ПараметрыЗадач1Ф.Удалить(ПараметрыЗадач1Ф.Индекс(Задача1Ф));
					КонецЦикла;
					
					ЗарегистрироватьОшибку("Ошибка формирования задач. В 1-ой форме уже присутствуют задачи по офертам со следующими параметрами: [" + СтрокаТаблицаЗадач.КлючЗадачиJson + "]. Задача [" + НомераЗадач + "].");
					
				Иначе
					
					ЕстьОшибка = Ложь;
					
					Для Каждого Задача1Ф Из МассивЗадачОтборПоРегНомеру Цикл
						
						Если Не Задача1Ф.Закрыта И Задача1Ф.ДатаВыкупа <> СтрокаТаблицаЗадач.ДатаВыкупа И Задача1Ф.Акцепт = СтрокаТаблицаЗадач.Акцепт Тогда
							
							// Возможны ситуации, когда по одной бумаге оферты идут одна за другой (при этом не пересекались периоды предъявления): в 1Ф была активна задача по одной оферте, и нужно было поставить задачу по другой оферте
							// Решили, что нужно ставить задачу в таком случае + добавить уведомление
							ЗарегистрироватьОшибку("В 1Ф по рег. номеру [" + Задача1Ф.РегНомер + "] найдена активная зазача [" + Задача1Ф.НомерЗадачи + "]. Дата выкупа по оферте [" + Формат(Задача1Ф.ДатаВыкупа, "ДФ=dd.MM.yyyy") + "].");
							
							// Если по одной бумаге сформированы данные для нескольких задач по разным офертам - Фиксируем ошибку, т.к. это нестандартная ситуация.
							// Когда для одной бумаги в 1Ф уже есть задача по оферте, при попытке поставить еще одну - фиксируем ошибку.
							ЗадачиДляПостановки = ТаблицаЗадач.НайтиСтроки(Новый Структура("НомерЗадачи",  Задача1Ф.НомерЗадачи));
							
							Если ЗадачиДляПостановки.Количество() = 0 Тогда  
								ПараметрыЗадач1Ф.Удалить(ПараметрыЗадач1Ф.Индекс(Задача1Ф));
							КонецЕсли;							
							
						КонецЕсли;
						
					КонецЦикла;
					
					Если Не ЕстьОшибка Тогда
						СтрокаТаблицаЗадач.СоздатьЗадачу = Истина;	
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
					
	КонецЦикла;
	
	Если ПараметрыЗадач1Ф.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Задачи1Ф.НомерЗадачи КАК НомерЗадачи,
			|	Задачи1Ф.АкцептПо КАК АкцептПо,
			|	Задачи1Ф.Закрыта КАК Закрыта
			|ПОМЕСТИТЬ _ЗадачиПервойФормы
			|ИЗ
			|	&Задачи1Ф КАК Задачи1Ф
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЗадачиПервойФормы.НомерЗадачи КАК НомерЗадачи,
			|	ЕСТЬNULL(НомераТранзакций.Ключ, """") <> """" КАК ЕстьКлюч,
			|	ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Справочник.Облигации).Наименование КАК Облигация
			|ИЗ
			|	_ЗадачиПервойФормы КАК _ЗадачиПервойФормы
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераТранзакций КАК НомераТранзакций
			|		ПО _ЗадачиПервойФормы.НомерЗадачи = НомераТранзакций.Номер
			|			И (НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма))
			|ГДЕ
			|	_ЗадачиПервойФормы.АкцептПо >= &Дата
			|	И НЕ _ЗадачиПервойФормы.Закрыта";
		
		Запрос.УстановитьПараметр("Задачи1Ф", ПараметрыЗадач1Ф);
		Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаФормированияОстатков);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		// Проверяем только активные задачи. Возможны ситуации когда задача отклоняется до наступления даты исполнения. Если принято решение не участвовать в оферте.
		Пока Выборка.Следующий() Цикл
			ЗарегистрироватьОшибку("В 1-ой форме обнаружена активная задача по оферте [" + Выборка.НомерЗадачи + "], номер которой" + ?(Выборка.ЕстьКлюч, "", " не") + " зафиксирован в регистре [Номера транзакций]." + ?(Выборка.ЕстьКлюч, " Проверьте условия оферт по бумаге [" + Выборка.Облигация + "]. Проверьте необходимость акцептования оферт по счетам ДУ.", ""));
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ПоставитьЗадачиВПервойФорме(ТаблицаЗадач, МассивНомеровЗадач) 
			
	Сервер = ?(ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза, "1f", "test1f") + ".g1.lan";
		
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения(Сервер);
	
	Если ПараметрыПодключения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СверитьДанныеСПервойФормой(ТаблицаЗадач, ПараметрыПодключения);
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадач Цикл
		
		Если Не (СтрокаТаблицы.СоздатьЗадачу Или СтрокаТаблицы.СверитьПерезаписатьТабЧасть Или СтрокаТаблицы.ИзменитьКоличествоКлиентов)
				Или СтрокаТаблицы.Ошибки.Количество() > 0 Тогда	
			Продолжить;	
		КонецЕсли;
				
		Если СтрокаТаблицы.СоздатьЗадачу Тогда 
			
			ТекстСообщения = "Ошибка создания задачи по оферте в 1-ой форме.";
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks/create", СтрокаТаблицы.ТекстЗадачиJson, ТекстСообщения);
			
			//создаем задачу. в ответе получаем ее номер. Задача ставится со статусом "Новая".
			//отловил лаг - запрос упал с ошибкой, но при этом создалась задача в 1Ф.
			Если HTTPОтвет = Неопределено Тогда
				
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Продолжить; 
				
			Иначе
				
				ОтветОбъект = ДесериализоватьСтрокуJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
				НомерЗадачи = Формат(ОтветОбъект.data.value, "ЧГ=0");
				
				Если ПустаяСтрока(НомерЗадачи) Тогда
					
					ЗарегистрироватьОшибку("Ошибка создания задачи в 1-ой форме. В ответ на запрос не получен номер задачи. Текст запроса:"+ Символы.ПС + СтрокаТаблицы.ТекстЗадачиJson + Символы.ПС + "Код ответа: " + HTTPОтвет.КодСостояния + "");
					Продолжить;
				
				КонецЕсли;
				
				МассивНомеровЗадач.Добавить(НомерЗадачи);
					
			КонецЕсли;
						
			//Значение параметра "Компании_Группы"(310) заполняется отдельным запросом.
			ТекстСообщения = "Не удалось записать значение параметра [Компании_Группы] для задачи [" + НомерЗадачи + "].";
			ТекстЗапроса = "/app/v1.2/api/eps/multilookup/310/" + НомерЗадачи + "/update?v=1.2&api_key=EpTable";
						
			Для Каждого КодУК Из СтрокаТаблицы.КодыУК Цикл
				
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, КодУК, ТекстСообщения);
			
				Если HTTPОтвет = Неопределено Тогда
					ЗарегистрироватьОшибку(ТекстСообщения);	
				КонецЕсли;
				
			КонецЦикла;
				
			Если Не ЗаписатьНомерЗадачи(НомерЗадачи, СтрокаТаблицы.ЦеннаяБумага, СтрокаТаблицы.КлючЗадачиJson) Тогда
				
				ЗарегистрироватьОшибку("При создании задачи в 1-ой форме. Не удалось записать данные в регистр [Номера транзакций]");
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//Удаление табличной части. Для перезаписи табличной части осуществляем предварительную очистку.
		Если СтрокаТаблицы.СверитьПерезаписатьТабЧасть И ЗначениеЗаполнено(СтрокаТаблицы.НомерЗадачи) Тогда 
			
			НомерЗадачи = СтрокаТаблицы.НомерЗадачи;
			
			ТекстЗапроса = "/app/v1.2/api/task/" + НомерЗадачи + "/ep/table/478/erase?v=1.2&api_key=EpTable";
			ТекстСообщения = "Не удалось очистить табличную часть в задаче [" + НомерЗадачи+ "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса,, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		//Табличная часть задачи создается отдельным запросом.
		Если СтрокаТаблицы.СоздатьЗадачу Или (СтрокаТаблицы.СверитьПерезаписатьТабЧасть И ЗначениеЗаполнено(СтрокаТаблицы.НомерЗадачи)) Тогда 
			
			ТекстЗапроса = "/app/v1.2/api/task/" + НомерЗадачи + "/ep/table/478/update?v=1.2&api_key=EpTable";
			ТекстСообщения = "Не удалось создать табличную часть в задаче [" + НомерЗадачи + "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, СтрокаТаблицы.ТекстТабЧастьJson, ТекстСообщения);
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);   
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		//Перезапишем параметр "Общее количество клиентов компаний"	
		Если СтрокаТаблицы.ИзменитьКоличествоКлиентов Тогда 
			
			ТекстЗапроса = "/app/v1.2/api/publications/action/UpdateNumberOfClientsOffers?TaskID=" + СтрокаТаблицы.НомерЗадачи + "&NumberOfClients=" + СтрокаТаблицы.КоличествоКлиентов;
			ТекстСообщения = "Не удалось перезаписать значение параметра [Общее количество клиентов компаний] в задаче [" + СтрокаТаблицы.НомерЗадачи + "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, ТекстЗапроса,, ТекстСообщения);   
			
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		//В задачу добавляем комментарий об изменениях, и отправляем копию пользователям на почту.
		Если СтрокаТаблицы.Сообщения.Количество() > 0 И СтрокаТаблицы.Сообщения.Свойство("КомментарийВЗадачу") Тогда 
			
			ТекстЗапроса = "/api/comments/add";
			ТекстСообщения = "Не удалось записать комментарий об изменении количества ценных бумаг на остатках в задаче [" + СтрокаТаблицы.НомерЗадачи + "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, СтрокаТаблицы.Сообщения.КомментарийВЗадачу, ТекстСообщения);
		
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);
			КонецЕсли;
			
			Если СтрокаТаблицы.Сообщения.Свойство("РЭМ") Тогда				
				РеквизитыОповещения = Новый Структура("Тема, Текст, ОрганизацияСтр, ТипТекста", "Обработка создания задач в 1Ф (оферты).", СтрокаТаблицы.Сообщения.РЭМ, "РЭМ", "HTML"); 
				Справочники.Оповещения.СформироватьОповещения("Обработка._СозданиеЗадачВПервойФорме.Оферты", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);	
			КонецЕсли;
			
			Если СтрокаТаблицы.Сообщения.Свойство("Траст") Тогда
				РеквизитыОповещения = Новый Структура("Тема, Текст, ОрганизацияСтр, ТипТекста", "Обработка создания задач в 1Ф (оферты).", СтрокаТаблицы.Сообщения.Траст, "Траст", "HTML"); 
				Справочники.Оповещения.СформироватьОповещения("Обработка._СозданиеЗадачВПервойФорме.Оферты", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			КонецЕсли;
			
		КонецЕсли;
		
		//После того как была создана задача со статусом "Новая" и в нее добавлены все необходимые данные (зпаполнен параметр "Компании_Группы", заполнена табличная часть)
		//необходимо отправить запрос перехода "Новая" -> "Поставить задачу". При переходе подтягиваются подписчики задачи на стороне 1Ф.
		//Если перезаписываем табличную часть в ранее созданной задаче, не нужно отправлять запрос перехода. 
		Если СтрокаТаблицы.СоздатьЗадачу Тогда 
			
			ТекстЗапроса = "/app/v1.0/api/task/step/" + НомерЗадачи + "";
			ТекстСообщения = "Не удалось выполнить запрос перехода [Поставить задачу] в задаче [" + НомерЗадачи + "].";
			
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, ТекстЗапроса, ПолучитьСтрокуJSON(Новый Структура("stepId, comment", 1111, "")), ТекстСообщения);
						
			Если HTTPОтвет = Неопределено Тогда
				ЗарегистрироватьОшибку(ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла; 
	
	Если МассивНомеровЗадач.Количество() > 0 Тогда
					
		ТекстСообщения = "";
		
		Для Каждого ТекНомерЗадачи Из МассивНомеровЗадач Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС + "http://1f.g1.lan/MaintaskForm.aspx?TaskID=" + ТекНомерЗадачи + "";
		КонецЦикла;
		
		РеквизитыОповещения = Новый Структура("Тема, Текст, ТипСообщения", "Обработка создания задач в 1Ф (оферты).", "В 1Ф созданы задачи: " + ТекстСообщения, "Служебные"); 
		Справочники.Оповещения.СформироватьОповещения("Обработка._СозданиеЗадачВПервойФорме.Оферты", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);			
			
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьСтрокуJSON(Данные)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Процедура ДесериализоватьПараметрыЗадачи(СтрокаДанных, ЗадачаОбъект)
	
	Если Не (ЗадачаОбъект.Свойство("subcatID") И ЗадачаОбъект.subcatID = 186) Тогда
		СтрокаДанных.Ошибки.Добавить("Ошибка получения данных из 1-ой формы. По номеру [" + НомерЗадачи + "] найдена задача с категорией [" + ЗадачаОбъект.subcatDescription + "].");
		Возврат;	
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СтрокаДанных.Закрыта) Тогда
		СтрокаДанных.Закрыта = ЗадачаОбъект.isClosed; 
	КонецЕсли;
		
	СтруктураКлюч = Новый Структура("reg_number, offer_date, approval_required");
	
	Для Каждого Параметр Из ЗадачаОбъект.extParams Цикл
				
		Если Параметр.id = 185 Тогда //РегНомер
			СтруктураКлюч.reg_number = Параметр.value;
		ИначеЕсли Параметр.id = 469 Тогда //ДатаВыкупа
			СтруктураКлюч.offer_date = Лев(Параметр.value, 10); 
		ИначеЕсли Параметр.id = 1181 Тогда//Акцепт 1181
			СтруктураКлюч.approval_required = Параметр.value;
		ИначеЕсли Параметр.id = 1398 Тогда
			СтрокаДанных.КоличествоКлиентов = Параметр.value;
		ИначеЕсли Параметр.id = 474 Тогда //"Окончание периода предъявления"
			
			Попытка
				СтрокаДанных.АкцептПо = Дата(СтрЗаменить(Лев(Параметр.value, 10), "-", ""));
			Исключение
				ЗарегистрироватьОшибку("Не удалось преобразовать значение [" + Параметр.value + "] в дату при определении Окончания периода предъявления для оферты. Задача [" + СтрокаДанных.НомерЗадачи+ "]."); 
			КонецПопытки;
			
		ИначеЕсли Параметр.id = 478 Тогда//Проверяем если изменились данные в таб части.
			СтрокаДанных.ТабличнаяЧасть = ДесериализоватьТабличнуюЧастьЗадачи(Параметр.value.values);	
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Элемент Из СтруктураКлюч Цикл
		
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтрокаДанных.Ошибки.Добавить("Ошибка сборки ключа на основании данных из 1-ой формы. Номер задачи [" + СтрокаДанных.НомерЗадачи + "].Отсутствует значение параметра [" + Элемент.Ключ + "].");
			Возврат;	
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаДанных.Акцепт         = СтруктураКлюч.approval_required;
	СтрокаДанных.ДатаВыкупа     = Дата(РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(СтруктураКлюч.offer_date));
	СтрокаДанных.КлючЗадачиJson = ПолучитьСтрокуJSON(СтруктураКлюч); 
	
КонецПроцедуры

Функция ДесериализоватьСтрокуJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

Функция ДесериализоватьТабличнуюЧастьЗадачи(МассивДанных)
	
	ТабличнаяЧасть = Новый ТаблицаЗначений;
	ТабличнаяЧасть.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТабличнаяЧасть.Колонки.Добавить("КодКлиента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТабличнаяЧасть.Колонки.Добавить("КлиентИмя", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
	ТабличнаяЧасть.Колонки.Добавить("КодУК", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТабличнаяЧасть.Колонки.Добавить("УКИмя", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
	ТабличнаяЧасть.Колонки.Добавить("КодБрокера", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТабличнаяЧасть.Колонки.Добавить("БрокерИмя", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
	ТабличнаяЧасть.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ЭлементДанных Из МассивДанных Цикл
		
		Если ЭлементДанных.columnId = 74 Или ЭлементДанных.columnId = 75 Или ЭлементДанных.columnId = 76 Или ЭлементДанных.columnId = 77 Или ЭлементДанных.columnId = 78 Тогда
			
			СтрокаТаблицы = ТабличнаяЧасть.Найти(Формат(ЭлементДанных.rowId, "ЧГ="), "НомерСтроки");
			
			Если СтрокаТаблицы = Неопределено Тогда
				
				НоваяСтрока = ТабличнаяЧасть.Добавить();
				НоваяСтрока.НомерСтроки = Формат(ЭлементДанных.rowId, "ЧГ=");
				
				Если ЭлементДанных.columnId = 74 Тогда
					НоваяСтрока.КодУК  = ЭлементДанных.value.taskId;
					НоваяСтрока.УКИмя  = ЭлементДанных.value.taskText;
				ИначеЕсли ЭлементДанных.columnId = 75 Тогда
					НоваяСтрока.КлиентИмя  = ЭлементДанных.value;
				ИначеЕсли ЭлементДанных.columnId = 76 Тогда
					НоваяСтрока.КодБрокера  = ЭлементДанных.value.id;
					НоваяСтрока.БрокерИмя   = ЭлементДанных.value.value;
				ИначеЕсли ЭлементДанных.columnId = 77 Тогда 
					НоваяСтрока.КодКлиента  = ЭлементДанных.value;
				ИначеЕсли ЭлементДанных.columnId = 78 Тогда
					НоваяСтрока.Количество  = ЭлементДанных.value;
				КонецЕсли
				
			Иначе
				
				Если ЭлементДанных.columnId = 74 Тогда
					СтрокаТаблицы.КодУК  = ЭлементДанных.value.taskId;
					СтрокаТаблицы.УКИмя  = ЭлементДанных.value.taskText;
				ИначеЕсли ЭлементДанных.columnId = 75 Тогда
					СтрокаТаблицы.КлиентИмя  = ЭлементДанных.value;
				ИначеЕсли ЭлементДанных.columnId = 76 Тогда
					СтрокаТаблицы.КодБрокера  = ЭлементДанных.value.id;
					СтрокаТаблицы.БрокерИмя   = ЭлементДанных.value.value;
				ИначеЕсли ЭлементДанных.columnId = 77 Тогда 
					СтрокаТаблицы.КодКлиента = ЭлементДанных.value;
				ИначеЕсли ЭлементДанных.columnId = 78 Тогда
					СтрокаТаблицы.Количество = ЭлементДанных.value;
				КонецЕсли
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;

КонецФункции

Процедура СверитьТабличныеЧасти(Данные1Ф, Данные1С)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Данные1Ф.НомерСтроки КАК НомерСтроки,
		|	Данные1Ф.КодКлиента КАК КодКлиента,
		|	Данные1Ф.КлиентИмя КАК КлиентИмя,
		|	Данные1Ф.КодБрокера КАК КодБрокера,
		|	Данные1Ф.БрокерИмя КАК БрокерИмя,
		|	Данные1Ф.КодУК КАК КодУК,
		|	Данные1Ф.УКИмя КАК УКИмя,
		|	Данные1Ф.Количество КАК Количество
		|ПОМЕСТИТЬ _ДанныеПервойФормы
		|ИЗ
		|	&Данные1Ф КАК Данные1Ф
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Данные1С.УКИмя КАК УКИмя,
		|	Данные1С.БрокерИмя КАК БрокерИмя,
		|	Данные1С.КлиентИмя КАК КлиентИмя,
		|	Данные1С.КодКлиента КАК КодКлиента,
		|	Данные1С.КодУК КАК КодУК,
		|	Данные1С.КодБрокера КАК КодБрокера,
		|	Данные1С.Количество КАК Количество
		|ПОМЕСТИТЬ _Данные1С
		|ИЗ
		|	&Данные1С КАК Данные1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ДанныеПервойФормы.НомерСтроки) КАК КоличествоСтрок,
		|	_ДанныеПервойФормы.КодКлиента КАК КодКлиента,
		|	_ДанныеПервойФормы.КлиентИмя КАК КлиентИмя,
		|	_ДанныеПервойФормы.КодБрокера КАК КодБрокера,
		|	_ДанныеПервойФормы.БрокерИмя КАК БрокерИмя,
		|	_ДанныеПервойФормы.КодУК КАК КодУК,
		|	_ДанныеПервойФормы.УКИмя КАК УКИмя,
		|	_ДанныеПервойФормы.Количество КАК Количество
		|ПОМЕСТИТЬ _ДублиСтрок
		|ИЗ
		|	_ДанныеПервойФормы КАК _ДанныеПервойФормы
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеПервойФормы.КодКлиента,
		|	_ДанныеПервойФормы.КлиентИмя,
		|	_ДанныеПервойФормы.КодБрокера,
		|	_ДанныеПервойФормы.БрокерИмя,
		|	_ДанныеПервойФормы.КодУК,
		|	_ДанныеПервойФормы.УКИмя,
		|	_ДанныеПервойФормы.Количество
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ДанныеПервойФормы.НомерСтроки) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_Данные1С.КодУК, _ДанныеПервойФормы.КодУК) КАК КодУК,
		|	ЕСТЬNULL(_Данные1С.Количество, 0) КАК Количество1С,
		|	ЕСТЬNULL(_ДанныеПервойФормы.Количество, 0) КАК Количество1Ф,
		|	""<tr><td> "" + ЕСТЬNULL(_Данные1С.УКИмя, ВЫРАЗИТЬ(КодыПервойФормы.Объект КАК Справочник.Организации).Наименование) + ""</td><td> "" + ЕСТЬNULL(_Данные1С.КлиентИмя, _ДанныеПервойФормы.КлиентИмя) + ""</td><td> "" + ЕСТЬNULL(_Данные1С.КодКлиента, _ДанныеПервойФормы.КодКлиента) + ""</td><td> "" + ЕСТЬNULL(_Данные1С.БрокерИмя, _ДанныеПервойФормы.БрокерИмя) + ""</td><td> %1</td><td> %2</td></tr>"" КАК Сообщение,
		|	""Счет ДУ ["" + ЕСТЬNULL(_Данные1С.КлиентИмя, _ДанныеПервойФормы.КлиентИмя) + "", код "" + ЕСТЬNULL(_Данные1С.КодКлиента, _ДанныеПервойФормы.КодКлиента) + ""], УК ["" + ЕСТЬNULL(_Данные1С.УКИмя, ВЫРАЗИТЬ(КодыПервойФормы.Объект КАК Справочник.Организации).Наименование) + ""], брокер ["" + ЕСТЬNULL(_Данные1С.БрокерИмя, _ДанныеПервойФормы.БрокерИмя) + ""]. Было: %1, стало: %2."" КАК КомментарийВЗадачу
		|ИЗ
		|	_ДанныеПервойФормы КАК _ДанныеПервойФормы
		|		ПОЛНОЕ СОЕДИНЕНИЕ _Данные1С КАК _Данные1С
		|		ПО _ДанныеПервойФормы.КодУК = _Данные1С.КодУК
		|			И _ДанныеПервойФормы.КодБрокера = _Данные1С.КодБрокера
		|			И _ДанныеПервойФормы.КодКлиента = _Данные1С.КодКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации)) КАК КодыПервойФормы
		|		ПО _ДанныеПервойФормы.КодУК = КодыПервойФормы.Код
		|ГДЕ
		|	ЕСТЬNULL(_Данные1С.Количество, 0) <> ЕСТЬNULL(_ДанныеПервойФормы.Количество, 0)";
	
	Запрос.УстановитьПараметр("Данные1Ф", Данные1Ф.ТабличнаяЧасть);
	Запрос.УстановитьПараметр("Данные1С", Данные1С.ТабличнаяЧасть);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщенияТраст = "";
	ТекстСообщенияРЭМ   = "";
	КомментарийВЗадачуРЭМ = "";
	КомментарийВЗадачуТраст = "";
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщенияРЭМ   = ТекстСообщенияРЭМ   + ?(Выборка.КодУК = "261", ?(ТекстСообщенияРЭМ = "", "", Символы.ПС) + СтрЗаменить(СтрШаблон(Выборка.Сообщение, Выборка.Количество1Ф, Выборка.Количество1С), "<tr>", "<tr class=""line"">"), "");
		ТекстСообщенияТраст = ТекстСообщенияТраст + ?(Выборка.КодУК = "260", ?(ТекстСообщенияТраст = "", "", Символы.ПС) + СтрЗаменить(СтрШаблон(Выборка.Сообщение, Выборка.Количество1Ф, Выборка.Количество1С), "<tr>", "<tr class=""line"">"), "");
		КомментарийВЗадачуРЭМ = КомментарийВЗадачуРЭМ   + ?(Выборка.КодУК = "261", Символы.ПС + СтрШаблон(Выборка.КомментарийВЗадачу, Выборка.Количество1Ф, Выборка.Количество1С), "");
		КомментарийВЗадачуТраст = КомментарийВЗадачуТраст + ?(Выборка.КодУК = "260", Символы.ПС + СтрШаблон(Выборка.КомментарийВЗадачу, Выборка.Количество1Ф, Выборка.Количество1С), "");
					
	КонецЦикла;
	
	СообщениеHTML =
		"<html><head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style>
		|		body  { font: 10pt sans-serif; }
		|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
		|		td    { vertical-align: top; border: 1px solid #CCC085; padding: 5px; }
		|		.top  { font-size: 14px; font-weight: 600; background: #F4ECC5; }
		|		.line { font-size: 12px;}
		|	</style>
		|</head>
		|<body>
		|<p><a href=""http://1f.g1.lan/MaintaskForm.aspx?TaskID=" + Данные1С.НомерЗадачи + """>Задача " + Данные1С.НомерЗадачи + "</a></p> 
		|<table cols=""6""><tr class=""top""><td colspan=""6"">Изменение количества ценных бумаг</td></tr>
		|<tr class=""top""><td>УК</td><td>Счет доверительного управления</td><td>Код</td><td>Брокер</td><td>Было</td><td>Стало</td></tr>ТЕКС_СООБЩЕНИЯ</table></body></html>";
	
	Если ТекстСообщенияРЭМ <> "" Тогда
		
		Данные1С.Сообщения.Вставить("РЭМ", СтрЗаменить(СообщениеHTML, "ТЕКС_СООБЩЕНИЯ", ТекстСообщенияРЭМ));
		
	КонецЕсли;
	
	Если ТекстСообщенияТраст <> "" Тогда
		
		Данные1С.Сообщения.Вставить("Траст", СтрЗаменить(СообщениеHTML, "ТЕКС_СООБЩЕНИЯ", ТекстСообщенияТраст));
		
	КонецЕсли;
	
	Если КомментарийВЗадачуРЭМ <> "" Или КомментарийВЗадачуТраст <> "" Тогда
								
		КомментарийВЗадачу = Новый Структура();
		КомментарийВЗадачу.Вставить("taskId", Данные1Ф.НомерЗадачи);
		КомментарийВЗадачу.Вставить("commentText", "Измненение количества ценных бумаг:" + КомментарийВЗадачуРЭМ + КомментарийВЗадачуТраст);
		КомментарийВЗадачу.Вставить("initiatorUserId", 3686);
		
		Данные1С.Сообщения.Вставить("КомментарийВЗадачу", ПолучитьСтрокуJSON(КомментарийВЗадачу));
		
	Иначе
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиСтрок"].ПолучитьДанные().Пустой() Тогда //проверка на дубли строк.
			Данные1С.СверитьПерезаписатьТабЧасть = Ложь;
		КонецЕсли;
			
	КонецЕсли;
		
КонецПроцедуры

Функция СоздатьЗадачиПоОфертам(ПроверятьВесьПериодПредъявления = Ложь) Экспорт
				
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СоздатьЗадачиПоОфертам()";
	ПараметрыДляСтатистики = "ДатаНачалаПредъявления,ДатаФормированияОстатков,РежимПерезаписи" + ?(ЗначениеЗаполнено(ЭтотОбъект.Облигация), ",Облигация","") + ?(ЗначениеЗаполнено(ЭтотОбъект.НомерЗадачи), ",НомерЗадачи", "");
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, ПараметрыДляСтатистики, Новый Структура("ПроверятьВесьПериодПредъявления", ПроверятьВесьПериодПредъявления));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);	
			
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
//для доп. оферт, у которых период предъявления составляет несколько лет (дата выкупа = дате погашения) задачу ставим за три дня до окончания срока предъявления.
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.Облигация КАК Облигация,
		|	УсловияОферт.Облигация.ГосударственныйРегистрационныйНомер КАК РегНомер,
		|	УсловияОферт.Облигация.Эмитент.Наименование КАК ЭмитентНаименование,
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	УсловияОферт.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияОферт.АкцептС КАК АкцептС,
		|	УсловияОферт.АкцептПо КАК АкцептПо,
		|	УсловияОферт.ТолькоДляФизическихЛиц КАК ФлагТолькоДляФЛ,
		|	ВЫБОР
		|		КОГДА УсловияОферт.АкцептПо <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА УсловияОферт.АкцептПо
		|		ИНАЧЕ УсловияОферт.ДатаВыкупа
		|	КОНЕЦ КАК КрайняяДатаФиксацииОстатков,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК КраткийКод
		|ПОМЕСТИТЬ _УсловияОферт
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаНП, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО УсловияОферт.Облигация = КодыВТорговыхСистемахСрезПоследних.Объект
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборПоБумаге
		|				ТОГДА УсловияОферт.Облигация = &Облигация
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ПроверятьВесьПериодПредъявления
		|				ТОГДА УсловияОферт.АкцептС < &ДатаНП
		|						И УсловияОферт.ДатаВыкупа >= &ТекущаяДата
		|						И ВЫБОР
		|							КОГДА УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ДопОферта)
		|									И УсловияОферт.ДатаВыкупа = УсловияОферт.Облигация.ДатаПогашения
		|								ТОГДА УсловияОферт.АкцептПо МЕЖДУ &ТекущаяДата И &ДатаНП
		|							ИНАЧЕ УсловияОферт.АкцептПо = ДАТАВРЕМЯ(1, 1, 1)
		|									ИЛИ УсловияОферт.АкцептПо >= &ТекущаяДата
		|						КОНЕЦ
		|			ИНАЧЕ УсловияОферт.АкцептС = &ДатаНП
		|					И &ТекущаяДата < УсловияОферт.ДатаВыкупа
		|					И &ТекущаяДата >= УсловияОферт.АкцептС
		|		КОНЕЦ
		|	И УсловияОферт.ТипОферты В (ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПродажа), ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ДопОферта))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияОферт.Облигация КАК Облигация,
		|	_УсловияОферт.РегНомер КАК РегНомер,
		|	_УсловияОферт.ЭмитентНаименование КАК ЭмитентНаименование,
		|	_УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	_УсловияОферт.ЦенаПроцент КАК ЦенаПроцент,
		|	_УсловияОферт.АкцептС КАК АкцептС,
		|	_УсловияОферт.АкцептПо КАК АкцептПо,
		|	_УсловияОферт.ФлагТолькоДляФЛ КАК ФлагТолькоДляФЛ,
		|	_УсловияОферт.КрайняяДатаФиксацииОстатков КАК КрайняяДатаФиксацииОстатков,
		|	_УсловияОферт.КраткийКод КАК КраткийКод
		|ПОМЕСТИТЬ _Оферты
		|ИЗ
		|	_УсловияОферт КАК _УсловияОферт
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК ДосрочныеПогашения
		|		ПО _УсловияОферт.Облигация = ДосрочныеПогашения.Облигация
		|			И (ДосрочныеПогашения.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно))
		|			И _УсловияОферт.ДатаВыкупа > ДосрочныеПогашения.ДатаВыкупа
		|ГДЕ
		|	ДосрочныеПогашения.Облигация ЕСТЬ NULL";
#КонецОбласти

	Запрос.УстановитьПараметр("ПроверятьВесьПериодПредъявления", ПроверятьВесьПериодПредъявления);
	Запрос.УстановитьПараметр("ДатаНП", ЭтотОбъект.ДатаНачалаПредъявления);
	Запрос.УстановитьПараметр("ТекущаяДата", ЭтотОбъект.ДатаФормированияОстатков);
	Запрос.УстановитьПараметр("ОтборПоБумаге", ЗначениеЗаполнено(ЭтотОбъект.Облигация));
	Запрос.УстановитьПараметр("Облигация", ЭтотОбъект.Облигация);
	
	Запрос.Выполнить();
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_Оферты"].ПолучитьДанные().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат Неопределено;
	КонецЕсли;

	КлючиЗадач = Новый ТаблицаЗначений;	
	КлючиЗадач.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	КлючиЗадач.Колонки.Добавить("КлючЗадачиСАкцептом", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	КлючиЗадач.Колонки.Добавить("КлючЗадачиБезАкцепта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	Пока Выборка.Следующий() Цикл
			
		НоваяСтрока = КлючиЗадач.Добавить();	
		НоваяСтрока.Облигация = Выборка.Облигация; 
		НоваяСтрока.КлючЗадачиСАкцептом  = ПолучитьСтрокуJSON(Новый Структура("reg_number, offer_date, approval_required", Выборка.РегНомер, Формат(Выборка.ДатаВыкупа, "ДФ=гггг-ММ-дд"), Истина));
		НоваяСтрока.КлючЗадачиБезАкцепта = ПолучитьСтрокуJSON(Новый Структура("reg_number, offer_date, approval_required", Выборка.РегНомер, Формат(Выборка.ДатаВыкупа, "ДФ=гггг-ММ-дд"), Ложь));
		
	КонецЦикла;
		
	//Если есть оферты - создадим таблицу в которую будем собирать данные
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ТекстЗадачиJson", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("ТекстТабЧастьJson", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("КлючЗадачиJson", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТаблицаДанных.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаДанных.Колонки.Добавить("РегНомер", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(21)));
	ТаблицаДанных.Колонки.Добавить("ДатаВыкупа", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("АкцептПо", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТаблицаДанных.Колонки.Добавить("СоздатьЗадачу", Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("СверитьПерезаписатьТабЧасть", Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("Акцепт", Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("Сообщения", Новый ОписаниеТипов("Структура"));
	ТаблицаДанных.Колонки.Добавить("КоличествоКлиентов", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	ТаблицаДанных.Колонки.Добавить("ИзменитьКоличествоКлиентов", Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаДанных.Колонки.Добавить("КодыУК");
	ТаблицаДанных.Колонки.Добавить("Ошибки");
	
#Область ТЕКСТ_ЗАПРОСА  
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиЗадач.Облигация КАК Облигация,
		|	КлючиЗадач.КлючЗадачиСАкцептом КАК КлючЗадачиСАкцептом,
		|	КлючиЗадач.КлючЗадачиБезАкцепта КАК КлючЗадачиБезАкцепта
		|ПОМЕСТИТЬ _КлючиЗадач
		|ИЗ
		|	&КлючиЗадач КАК КлючиЗадач
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|			ТОГДА 1
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЧастьСделкиРепо,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ЗадолженностьПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаОстатков,
		|			Организация В (&ОрганизацияТраст, &ОрганизацияРЭМ)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И ЦеннаяБумага В
