
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.ИнтерактивныйЗапуск	= Истина;
	Объект.ПериодЗагрузкиПисем.Вариант = ВариантСтандартногоПериода.Сегодня;
	Объект.ТемаПисьма = "Выгрузка из ЗУП";
	
	ПриСменеТекущейОрганизацииНаСервере();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВерсиюИОтправителя()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИмяОбъекта",	ОбработкаОбъект.Метаданные().Имя);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПараметрОтправительВыгрузки.Значение КАК ОтправительВыгрузки,
		|	ПараметрВерсияВыгрузки.Значение КАК ВерсияВыгрузки
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки.Параметры КАК ДополнительныеОтчетыИОбработкиПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.Параметры КАК ПараметрОтправительВыгрузки
		|		ПО ДополнительныеОтчетыИОбработкиПараметры.Ссылка = ПараметрОтправительВыгрузки.Ссылка
		|			И ДополнительныеОтчетыИОбработкиПараметры.Группа = ПараметрОтправительВыгрузки.Группа
		|			И (ПараметрОтправительВыгрузки.Имя = ""ОтправительВыгрузки"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки.Параметры КАК ПараметрВерсияВыгрузки
		|		ПО ДополнительныеОтчетыИОбработкиПараметры.Ссылка = ПараметрВерсияВыгрузки.Ссылка
		|			И ДополнительныеОтчетыИОбработкиПараметры.Группа = ПараметрВерсияВыгрузки.Группа
		|			И (ПараметрВерсияВыгрузки.Имя = ""ВерсияВыгрузки"")
		|ГДЕ
		|	ДополнительныеОтчетыИОбработкиПараметры.Имя = ""Организация""
		|	И ДополнительныеОтчетыИОбработкиПараметры.Значение = &Организация
		|	И ДополнительныеОтчетыИОбработкиПараметры.Ссылка.ИмяОбъекта = &ИмяОбъекта";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ОтправительВыгрузки		 = Выборка.ОтправительВыгрузки;
		Объект.ВерсияВыгрузки			 = Выборка.ВерсияВыгрузки;
		Объект.ДатаЗапретаРедактирования = ТекущаяДата() - 86400 * 31;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСменеТекущейОрганизацииНаСервере() Экспорт
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.ВыборДанных.ПолучитьЭлементы().Очистить();
	
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		Если РеквизитФормы.ТипЗначения.Типы().Найти(Тип("ТаблицаЗначений")) <> Неопределено Тогда
			ЭтаФорма[РеквизитФормы.Имя].Очистить();
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьВерсиюИОтправителя();
	
	ОбновитьПолеФайлВExternals();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПолеФайлВExternals()
	
	ЭтаФорма.ФайлВExternals_Organization = Строка(Объект.Организация.УникальныйИдентификатор());
	ЭтаФорма.ФайлВExternals_Source_Id = ВнешниеИсточникиДанных.Externals.Таблицы.Data_Sources.НайтиПоПолю("Id", 31);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	dbo_Files.Ссылка КАК Ссылка
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|ГДЕ
		|	dbo_Files.Source_Id = &Source_Id
		|	И dbo_Files.Organization = &Organization
		|
		|УПОРЯДОЧИТЬ ПО
		|	dbo_Files.Publication_Date УБЫВ";
	
	Запрос.УстановитьПараметр("Organization",	ЭтаФорма.ФайлВExternals_Organization);
	Запрос.УстановитьПараметр("Source_Id",		ЭтаФорма.ФайлВExternals_Source_Id);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЭтаФорма.ФайлВExternals = Выборка.Ссылка;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	КлючиРазвернутыхСтрок = Неопределено;
	РаботаСФормамиКлиент.ПолучитьКлючиРазвернутыхСтрокДерева(ЭтаФорма.ВыборДанных, Элементы.ВыборДанных, "Ключ", КлючиРазвернутыхСтрок);
	
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.ВыборДанных, "Ключ");
	
	Если ПроверкаЗаполнения() Тогда
		РеквизитыФайла = УпаковатьФайл();
		Если ЗначениеЗаполнено(РеквизитыФайла) Тогда
			ПрочитатьДанныеФайлаНаСервере(РеквизитыФайла);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьОтображениеДанных();
	
	РаботаСФормамиКлиент.ВосстановитьРазвернутыеСтрокиДереваПоКлючу(ЭтаФорма.ВыборДанных, Элементы.ВыборДанных, "Ключ", КлючиРазвернутыхСтрок);
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.ВыборДанных, Элементы.ВыборДанных, "Ключ", КлючТекущейСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеФайлаНаСервере(РеквизитыФайла)
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресДанныхФайла)
	   И ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхФайла) Тогда
	   УдалитьИзВременногоХранилища(ЭтаФорма.АдресДанныхФайла);
	КонецЕсли;
	
	РеквизитФормыОбъект = РеквизитФормыВЗначение("Объект");
	
	ДанныеФайла = РеквизитФормыОбъект.ПрочитатьДанныеФайла(РеквизитыФайла);
	
	Если ДанныеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьТаблицыНаФорме(ДанныеФайла);
	ОбновитьДанныеТаблицНаФорме(ДанныеФайла);
	
	ЗначениеВРеквизитФормы(РеквизитФормыОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура СоздатьТаблицыНаФорме(ДанныеФайла)
	
	СуществующиеРеквизиты = Новый Массив;
	НовыеРеквизитыФормы = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	
	Для Каждого РеквизитФормы Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		СуществующиеРеквизиты.Добавить(РеквизитФормы.Имя);
	КонецЦикла;

	Для Каждого ТаблицаФайла Из ДанныеФайла.ИсходныеТаблицы Цикл
		
		РеквизитыТабЧасти = Новый РеквизитФормы(ТаблицаФайла.Ключ, Новый ОписаниеТипов("ТаблицаЗначений"));
		НовыеРеквизитыФормы.Добавить(РеквизитыТабЧасти);
		
		Если СуществующиеРеквизиты.Найти(ТаблицаФайла.Ключ) <> Неопределено Тогда
			УдаляемыеРеквизиты.Добавить(ТаблицаФайла.Ключ);
		КонецЕсли;
		
		Для Каждого Колонка Из ТаблицаФайла.Значение.Колонки Цикл
			
			Если Колонка.Имя = "СтатусЗагрузки" Тогда
				КолонкаТаблицы = Новый РеквизитФормы(Колонка.Имя, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1,0, ДопустимыйЗнак.Неотрицательный)), ТаблицаФайла.Ключ);
			Иначе	
				КолонкаТаблицы = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ТаблицаФайла.Ключ);
			КонецЕсли;
			
			НовыеРеквизитыФормы.Добавить(КолонкаТаблицы);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, УдаляемыеРеквизиты);
	
	ТаблицыСИзменяемойВидимостью.Очистить();
	
	Для Каждого ТаблицаФайла Из ДанныеФайла.ИсходныеТаблицы Цикл
		Если СтрНачинаетсяС(ТаблицаФайла.Ключ, "Расхождения_")
		 ИЛИ СтрНачинаетсяС(ТаблицаФайла.Ключ, "Справочник_")
		 ИЛИ СтрНачинаетсяС(ТаблицаФайла.Ключ, "РегистрСведений_") Тогда
			
			Если Элементы.Найти(ТаблицаФайла.Ключ) = Неопределено Тогда
				
				ПравилоИмпорта = ДанныеФайла.ИсходныеТаблицы.Получить("ПравилаИмпорта").Найти(ТаблицаФайла.Ключ, "ИмяТаблицы");
				Если ПравилоИмпорта <> Неопределено Тогда
					ПоказатьУстранитьРасхождения = ПравилоИмпорта.РучнаяЗагрузка;
				Иначе
					ПоказатьУстранитьРасхождения = Ложь;	
				КонецЕсли;
				
				ТаблицаФормы = Элементы.Добавить(ТаблицаФайла.Ключ, Тип("ТаблицаФормы"), Элементы.ГруппаРасхождения);
				ТаблицаФормы.ПутьКДанным              = ТаблицаФайла.Ключ;
				ТаблицаФормы.ИзменятьСоставСтрок      = Ложь;
				ТаблицаФормы.ИзменятьПорядокСтрок     = Ложь;
				ТаблицаФормы.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
				ТаблицаФормы.УстановитьДействие("Выбор", "ТаблицаРасшифровкиВыбор_Подключаемый");

				Для Каждого Колонка Из ТаблицаФайла.Значение.Колонки Цикл
					Если Колонка.Имя = "КодВоВнешнейСистеме" 
					   ИЛИ Колонка.Имя = "НомерПоПорядку" 
					   ИЛИ Колонка.Имя = "ИмяТаблицы" 
					   ИЛИ Колонка.Имя = "ВерсияДанных" 
					   ИЛИ СтрЗаканчиваетсяНа(Колонка.Имя, "_СтароеЗначение")
					   ИЛИ СтрЗаканчиваетсяНа(Колонка.Имя, "_Ключ")
					   ИЛИ СтрЗаканчиваетсяНа(Колонка.Имя, "_Тип")
					   ИЛИ СтрНачинаетсяС(Колонка.Имя, "Ключ") Тогда
						//Ничего
						
					ИначеЕсли Колонка.Имя = "СтатусЗагрузки" Тогда
						ТаблицаФормы.ПутьКДаннымКартинкиСтроки = ТаблицаФайла.Ключ + "." + Колонка.Имя;
						//ТаблицаФормы.КартинкаСтрок = БиблиотекаКартинок.СтатусыЗагрузкиРасширенные;
						ТаблицаФормы.КартинкаСтрок = Элементы.ВыборДанных.КартинкаСтрок;
						
					ИначеЕсли Колонка.Имя = "УстранитьРасхождения" Тогда
						Если ПоказатьУстранитьРасхождения Тогда
						
							КолонкаТаблицы = Элементы.Добавить(ТаблицаФайла.Ключ + Колонка.Имя, Тип("ПолеФормы"), ТаблицаФормы); 
							КолонкаТаблицы.ПутьКДанным    		= ТаблицаФайла.Ключ + "." + Колонка.Имя;
							КолонкаТаблицы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
							КолонкаТаблицы.Вид					= ВидПоляФормы.ПолеФлажка;
							КолонкаТаблицы.УстановитьДействие("ПриИзменении", "УстранитьРасхожденияПриИзменении_Подключаемый");
							
							ТаблицаФормы.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Верх;
							
							НоваяКоманда = Команды.Добавить(ТаблицаФайла.Ключ + "УстановитьФлажки");
							ЗаполнитьЗначенияСвойств(НоваяКоманда, Команды.УстановитьФлажки);
							НоваяКоманда.ИспользуемаяТаблица = ТаблицаФормы;
							
							НовыйЭлемент = Элементы.Добавить(ТаблицаФайла.Ключ + "УстановитьФлажки", Тип("КнопкаФормы"), ТаблицаФормы.КоманднаяПанель);
							НовыйЭлемент.ИмяКоманды = ТаблицаФайла.Ключ + "УстановитьФлажки";
							
							НоваяКоманда = Команды.Добавить(ТаблицаФайла.Ключ + "СнятьФлажки");
							ЗаполнитьЗначенияСвойств(НоваяКоманда, Команды.СнятьФлажки);
							НоваяКоманда.ИспользуемаяТаблица = ТаблицаФормы;
							
							НовыйЭлемент = Элементы.Добавить(ТаблицаФайла.Ключ + "СнятьФлажки", Тип("КнопкаФормы"), ТаблицаФормы.КоманднаяПанель);
							НовыйЭлемент.ИмяКоманды = ТаблицаФайла.Ключ + "СнятьФлажки";
							
						КонецЕсли;
					ИначеЕсли СтрЗаканчиваетсяНа(Колонка.Имя, "_Изменен") Тогда
						
						НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
						НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255,0,0));
						Отбор = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
						Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаФайла.Ключ + "." + Колонка.Имя);
						Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
						Отбор.ПравоеЗначение = Истина;
						НовыйЭлементУО.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ТаблицаФайла.Ключ + СтрЗаменить(Колонка.Имя, "_Изменен", ""));
						
					Иначе
					   
						КолонкаТаблицы = Элементы.Добавить(ТаблицаФайла.Ключ + Колонка.Имя, Тип("ПолеФормы"), ТаблицаФормы); 
						КолонкаТаблицы.ПутьКДанным    = ТаблицаФайла.Ключ + "." + Колонка.Имя;
						КолонкаТаблицы.ТолькоПросмотр = Истина;
					КонецЕсли;
				КонецЦикла;
				
				
				
			КонецЕсли;
			
			Элементы.Найти(ТаблицаФайла.Ключ).Видимость = Ложь;
			ТаблицыСИзменяемойВидимостью.Добавить(ТаблицаФайла.Ключ);
			
		КонецЕсли;
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеТаблицНаФорме(ДанныеФайла)
	
	Для Каждого ТаблицаФайла Из ДанныеФайла.ИсходныеТаблицы Цикл
		ЭтаФорма[ТаблицаФайла.Ключ].Загрузить(ТаблицаФайла.Значение);
	КонецЦикла;	
	
	СтруктуруВизуализации = РеквизитФормыВЗначение("Объект").ПолучитьСтруктуруВизуализации();
	
	РеквизитФормыВыборДанных = РеквизитФормыВЗначение("ВыборДанных");
	РеквизитФормыВыборДанных.Строки.Очистить();
	
	ВыестиУровеньДереваВыбораДанных(СтруктуруВизуализации, РеквизитФормыВыборДанных.Строки, Неопределено);
	
	ЗначениеВРеквизитФормы(РеквизитФормыВыборДанных, "ВыборДанных");
	
	ЭтаФорма.АдресДанныхФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, ЭтаФорма.УникальныйИдентификатор); 
	
	
КонецПроцедуры

&НаСервере
Процедура ВыестиУровеньДереваВыбораДанных(СтруктуруВизуализации, СтрокиДерева, СтрокаРодитель)
	
	Если СтруктуруВизуализации.ВидМД = "Справочник" Тогда
		
		Если ЗначениеЗаполнено(СтруктуруВизуализации.ТаблицаРодитель) Тогда
			МассивСтрокДанных = ЭтаФорма[СтруктуруВизуализации.ИмяТаблицы].Выгрузить(Новый Структура("КлючРодитель", СтрокаРодитель.Ключ));
		Иначе
			МассивСтрокДанных = ЭтаФорма[СтруктуруВизуализации.ИмяТаблицы].Выгрузить();
		КонецЕсли;
	
		Для Каждого СтрокаДанных Из МассивСтрокДанных Цикл
			ПараметрыСтроки = Новый Структура;
			
			Для Каждого Колонка Из МассивСтрокДанных.Колонки Цикл
				ПараметрыСтроки.Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
			КонецЦикла;
			
			СтрокаДерева = СтрокиДерева.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаДанных,, "УстранитьРасхождения");
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктуруВизуализации);
			
			СтрокаДерева.ПолеКлюча	= "Ключ";
			
			СтрокаДерева.КоличествоЗаписей = 1;
			Если СтрокаДанных.СтатусЗагрузки < 4 Тогда
				СтрокаДерева.КоличествоРасхождений = 1;
			КонецЕсли;
			
			СтрокаДерева.Наименование	= РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(СтруктуруВизуализации.Наименование, ПараметрыСтроки);
			
			Для Каждого ПодчиненныйЭлемент Из СтруктуруВизуализации.ПодчиненныеЭлементы Цикл
				ВыестиУровеньДереваВыбораДанных(ПодчиненныйЭлемент, СтрокаДерева.Строки, СтрокаДанных);
			КонецЦикла;
			
			Если СтрокаДерева.Родитель <> Неопределено Тогда
				СтрокаДерева.Родитель.КоличествоЗаписей		= СтрокаДерева.Родитель.КоличествоЗаписей + СтрокаДерева.КоличествоЗаписей;
				СтрокаДерева.Родитель.КоличествоРасхождений = СтрокаДерева.Родитель.КоличествоРасхождений + СтрокаДерева.КоличествоРасхождений;
			КонецЕсли;
			
			//СтрокаДерева.УстранитьРасхождения = (СтрокаДанных.СтатусЗагрузки > 0 И СтрокаДерева.КоличествоРасхождений > 0);
			
		КонецЦикла;
	Иначе
		
		НайденныеСтрокиРасхождений = ЭтаФорма[СтруктуруВизуализации.ТаблицаРасхождений].Выгрузить(Новый Структура("КлючРодитель", СтрокаРодитель.Ключ));
		Если НайденныеСтрокиРасхождений.Количество() Тогда
			
			СтрокаДерева = СтрокиДерева.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктуруВизуализации);
			
			СтрокаДерева.Ключ		= СтрокаРодитель.Ключ;
			СтрокаДерева.ПолеКлюча	= "КлючРодитель";
			
			СтрокаДерева.КоличествоЗаписей = НайденныеСтрокиРасхождений.Количество();
			Для Каждого СтрокаРасхождений Из НайденныеСтрокиРасхождений Цикл
				
				Если СтрокаРасхождений.СтатусЗагрузки < 4 И НЕ СтрокаДерева.РучнаяЗагрузка Тогда
					СтрокаДерева.КоличествоРасхождений = СтрокаДерева.КоличествоРасхождений + 1;
				КонецЕсли;
				
				Если СтрокаДерева.СтатусЗагрузки = 0 Тогда
					СтрокаДерева.СтатусЗагрузки = СтрокаРасхождений.СтатусЗагрузки;
					
				ИначеЕсли СтрокаРасхождений.СтатусЗагрузки >= 4 Тогда
					СтрокаДерева.СтатусЗагрузки = Мин(СтрокаДерева.СтатусЗагрузки, СтрокаРасхождений.СтатусЗагрузки);
					
				ИначеЕсли СтрокаДерева.СтатусЗагрузки <> СтрокаРасхождений.СтатусЗагрузки Тогда
					СтрокаДерева.СтатусЗагрузки = 3;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаДерева.Родитель.КоличествоЗаписей		= СтрокаДерева.Родитель.КоличествоЗаписей + СтрокаДерева.КоличествоЗаписей;
			СтрокаДерева.Родитель.КоличествоРасхождений = СтрокаДерева.Родитель.КоличествоРасхождений + СтрокаДерева.КоличествоРасхождений;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ИмяФайла.Видимость = (Форма.ИсточникФайла = 1);
	Элементы.ФайлВExternals.Видимость = (Форма.ИсточникФайла = 0);
	
КонецПроцедуры

&НаКлиенте
Функция УпаковатьФайл()
	
	Если ЭтаФорма.ИсточникФайла = 0 Тогда
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ФайлВExternals) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран файл",, "ФайлВExternals", "Объект");
			Возврат Неопределено;
		КонецЕсли;
		
		РеквизитыФайла = Новый Структура();
		РеквизитыФайла.Вставить("АдресФайла"	, Строка(ЭтотОбъект.ФайлВExternals));
		РеквизитыФайла.Вставить("ФайлВExternals", ЭтотОбъект.ФайлВExternals);
		
	Иначе
		Файл = Новый Файл(Объект.ИмяФайла);
		Если Не Файл.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указанный файл не найден. Возможно он был перемещен или удален",, "ИмяФайла", "Объект");
			Возврат Неопределено;
		КонецЕсли;
		
		РеквизитыФайла = Новый Структура();
		РеквизитыФайла.Вставить("АдресФайла"	, Объект.ИмяФайла);
		РеквизитыФайла.Вставить("АдресФайлаВХ"	, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Объект.ИмяФайла), ЭтаФорма.УникальныйИдентификатор));
		РеквизитыФайла.Вставить("ИмяРеквизита"	, "ИмяФайла");
		
	КонецЕсли;
	
	Возврат РеквизитыФайла;

КонецФункции

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр				= "XML (*.xml)|*.xml";
	Диалог.ПолноеИмяФайла		= Объект.ИмяФайла;
	Диалог.МножественныйВыбор	= Ложь; 
	Диалог.Заголовок			= "Файл с отчётом:"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.ИмяФайла = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДанныхПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтборНаТаблицуСДанными", 0.3, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборНаТаблицуСДанными()
	
	Элемент = Элементы.ВыборДанных;
	
	Для Каждого ЭлементТаблицыСИзменяемойВидимостью Из ТаблицыСИзменяемойВидимостью Цикл
		Элементы[ЭлементТаблицыСИзменяемойВидимостью.Значение].Видимость = Ложь;	
	КонецЦикла;
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Если Элемент.ТекущиеДанные.КоличествоРасхождений > 0 ИЛИ НЕ ЭтаФорма.ПоказыватьТолькоРасхождения Тогда
			Элементы[Элемент.ТекущиеДанные.ТаблицаРасхождений].Видимость = Истина;
			Элементы[Элемент.ТекущиеДанные.ТаблицаРасхождений].ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура(Элемент.ТекущиеДанные.ПолеКлюча, Элемент.ТекущиеДанные.Ключ));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстранитьРасхожденияПриИзменении(Элемент)
	
	Если Элемент.Родитель.ТекущиеДанные <> Неопределено Тогда
		Если Элемент.Родитель.ТекущиеДанные.СтатусЗагрузки = 0 Тогда			
			Элемент.Родитель.ТекущиеДанные.УстранитьРасхождения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанные(Команда)
	
	ЗаписатьДанныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеНаСервере()
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресДанныхФайла) И ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхФайла) Тогда
		
		СуществующиеРеквизиты = Новый Массив;

		Для Каждого РеквизитФормы Из ЭтаФорма.ПолучитьРеквизиты() Цикл
			СуществующиеРеквизиты.Добавить(РеквизитФормы.Имя);
		КонецЦикла;
		
		УстановитьОтметкиУстранитьРасхождения(РеквизитФормыВЗначение("ВыборДанных").Строки);
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныхФайла);
		
		Для Каждого ТаблицаФайла Из ДанныеФайла.ИсходныеТаблицы Цикл
			Если СуществующиеРеквизиты.Найти(ТаблицаФайла.Ключ) <> Неопределено Тогда
				ДанныеФайла.ИсходныеТаблицы.Вставить(ТаблицаФайла.Ключ, ЭтаФорма[ТаблицаФайла.Ключ].Выгрузить());
			КонецЕсли;
		КонецЦикла;	
		
		РеквизитФормыОбъект = РеквизитФормыВЗначение("Объект");
		РеквизитФормыОбъект.ЗаписатьДанные(ДанныеФайла);
		
		ОбновитьДанныеТаблицНаФорме(ДанныеФайла);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкиУстранитьРасхождения(СтрокиВыбора, УстранитьРасхождения = Неопределено)
	
	Для Каждого СтрокаВыбора Из СтрокиВыбора Цикл
		Если НЕ СтрокаВыбора.РучнаяЗагрузка Тогда
			Если (ЗначениеЗаполнено(СтрокаВыбора.ИмяТаблицы) ИЛИ ЗначениеЗаполнено(СтрокаВыбора.ТаблицаРасхождений)) Тогда
				ПараметрыПоиска = Новый Структура(СтрокаВыбора.ПолеКлюча, СтрокаВыбора.Ключ);
				
				Если ЗначениеЗаполнено(СтрокаВыбора.ИмяТаблицы) Тогда
					НайденныеСтроки = ЭтаФорма[СтрокаВыбора.ИмяТаблицы].НайтиСтроки(ПараметрыПоиска);
				Иначе
					НайденныеСтроки = ЭтаФорма[СтрокаВыбора.ТаблицаРасхождений].НайтиСтроки(ПараметрыПоиска);
				КонецЕсли;
				
				Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
					Если УстранитьРасхождения = Неопределено Тогда
						СтрокаДанных.УстранитьРасхождения = СтрокаВыбора.УстранитьРасхождения;
					Иначе
						СтрокаДанных.УстранитьРасхождения = УстранитьРасхождения;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;	
		КонецЕсли;
		
		Если УстранитьРасхождения = Неопределено Тогда
			УстановитьОтметкиУстранитьРасхождения(СтрокаВыбора.Строки, СтрокаВыбора.УстранитьРасхождения)
		Иначе
			УстановитьОтметкиУстранитьРасхождения(СтрокаВыбора.Строки, УстранитьРасхождения)
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажки(Команда)
	
	ЗначениеФлажка = СтрЗаканчиваетсяНа(Команда.Имя, "УстановитьФлажки");
	
	Если Команда.ИспользуемаяТаблица.ВыделенныеСтроки.Количество() > 1 Тогда
		Для Каждого ИдентификаторСтроки Из Команда.ИспользуемаяТаблица.ВыделенныеСтроки Цикл
			СтрокаДанных = ЭтаФорма[Команда.ИспользуемаяТаблица.Имя].НайтиПоИдентификатору(ИдентификаторСтроки);
			Если СтрокаДанных.СтатусЗагрузки > 0 Тогда
				СтрокаДанных.УстранитьРасхождения = ЗначениеФлажка;
			КонецЕсли;
		КонецЦикла;
	Иначе	
		Если Команда.ИспользуемаяТаблица.Имя = "ВыборДанных" Тогда
			Для Каждого СтрокаДанных Из ЭтаФорма[Команда.ИспользуемаяТаблица.Имя].ПолучитьЭлементы() Цикл
				Если СтрокаДанных.СтатусЗагрузки > 0 Тогда
					СтрокаДанных.УстранитьРасхождения = ЗначениеФлажка;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для Каждого СтрокаДанных Из ЭтаФорма[Команда.ИспользуемаяТаблица.Имя].НайтиСтроки(Новый Структура(Элементы[Команда.ИспользуемаяТаблица.Имя].ОтборСтрок)) Цикл
				Если СтрокаДанных.СтатусЗагрузки > 0 Тогда
					СтрокаДанных.УстранитьРасхождения = ЗначениеФлажка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Команда.ИспользуемаяТаблица.Имя = "ВыборДанных" И ЗначениеФлажка Тогда
		УстановитьФлагВВыборДанных();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагВВыборДанных()
	
	ТекущиеДанные = Элементы.ВыборДанных.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Пока ТекущиеДанные.ПолучитьРодителя() <> Неопределено Цикл
			ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
		КонецЦикла;
		
		ТекущиеДанные.УстранитьРасхождения = Истина;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстранитьРасхожденияПриИзменении_Подключаемый(Элемент)

	Если Элемент.Родитель.ТекущиеДанные.УстранитьРасхождения Тогда
		УстановитьФлагВВыборДанных();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ИсточникФайлаПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлыИзПочтыВExternals(Команда)
	
	ЗагрузитьФайлыИзПочтыВExternalsНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлыИзПочтыВExternalsНаСервере()
	
	РеквизитФормыВЗначение("Объект").ЗагрузитьФайлыИзПочтыВExternals();
	ОбновитьПолеФайлВExternals();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	ПриСменеТекущейОрганизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьТолькоРасхожденияПриИзменении(Элемент)
	
	УстановитьОтборНаТаблицуСДанными();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРасшифровкиВыбор_Подключаемый(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяПоля = СтрЗаменить(Поле.Имя, Элемент.Имя, "");
	Если Элемент.ТекущиеДанные.Свойство(ИмяПоля + "_Изменен")
	   И Элемент.ТекущиеДанные[ИмяПоля + "_Изменен"] = Истина Тогда
	   
	  	ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("НовоеЗначение", Элемент.ТекущиеДанные[ИмяПоля]); 
		ПараметрыОткрытия.Вставить("СтароеЗначение", Элемент.ТекущиеДанные[ИмяПоля + "_СтароеЗначение"]); 
		
		ОткрытьФормуМодально("ВнешняяОбработка._ИмпортДанныхОСотрудникахИзЗУП.Форма.СравнениеЗначений", ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиТаблицуЗначений(Команда)
	
	СписокТаблиц = ПолучитьСписокТаблиц();
	Если СписокТаблиц.Количество() = 0 Тогда
		Предупреждение("Таблицы не заполнены");
	КонецЕсли;
	
	ВыбранноеЗначение = СписокТаблиц.ВыбратьЭлемент("Вывести таблицу");
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		ВывестиТаблицуЗначенийВТабличныйДокумент(ВыбранноеЗначение.Значение).Показать(ВыбранноеЗначение.Значение);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТаблиц()
	
	СписокТаблиц = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ЭтаФорма.АдресДанныхФайла) И ЭтоАдресВременногоХранилища(ЭтаФорма.АдресДанныхФайла) Тогда
		ДанныеФайла = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныхФайла);
		Для Каждого ТаблицаФайла Из ДанныеФайла.ИсходныеТаблицы Цикл
			СписокТаблиц.Добавить(ТаблицаФайла.Ключ, ТаблицаФайла.Ключ);
		КонецЦикла;	
		Для Каждого ТаблицаФайла Из ДанныеФайла.ТаблицыФайла Цикл
			СписокТаблиц.Добавить(ТаблицаФайла.Ключ, ТаблицаФайла.Ключ);
		КонецЦикла;	
		Для Каждого ТаблицаФайла Из ДанныеФайла.ВременныеТаблицы Цикл
			СписокТаблиц.Добавить(ТаблицаФайла.Ключ, ТаблицаФайла.Ключ);
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат СписокТаблиц;
	
КонецФункции

&НаСервере
Функция ВывестиТаблицуЗначенийВТабличныйДокумент(ИмяТаблицы)
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(, , , Новый ТабличныйДокумент); 

	ДанныеФайла = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныхФайла);
	
	Если ДанныеФайла.ИсходныеТаблицы.Получить(ИмяТаблицы) <> Неопределено Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ДанныеФайла.ИсходныеТаблицы.Получить(ИмяТаблицы));
	ИначеЕсли ДанныеФайла.ТаблицыФайла.Получить(ИмяТаблицы) <> Неопределено Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ДанныеФайла.ТаблицыФайла.Получить(ИмяТаблицы));
	ИначеЕсли ДанныеФайла.ВременныеТаблицы.Получить(ИмяТаблицы) <> Неопределено Тогда
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ДанныеФайла.ВременныеТаблицы.Получить(ИмяТаблицы));
	КонецЕсли;	
	
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	ПараметрыВывода.ДокументРезультат.ОтображатьЗаголовки = Истина;
	ПараметрыВывода.ДокументРезультат.ТолькоПросмотр = Ложь;
	
	Возврат ПараметрыВывода.ДокументРезультат;
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполнения()
	
	Отказ = Ложь;

	ОбязательныеРеквизиты	= Новый Соответствие;
	ИспользуемыеКаталоги	= Новый Структура;
	
	ОбязательныеРеквизиты.Вставить("Организация", "Организация");
	
	Если ЭтаФорма.ИсточникФайла = 1 Тогда
		ОбязательныеРеквизиты.Вставить("ИмяФайла", "Имя файла");
		ИспользуемыеКаталоги.Вставить("ИмяФайла", "Имя файла");
	КонецЕсли;
	
	Для Каждого Реквизит Из ОбязательныеРеквизиты Цикл
		ЗначениеРеквизита = Объект;
		
		Для Каждого ИмяРеквизита Из СтрРазделить(Реквизит.Ключ, ".", Ложь) Цикл
			ЗначениеРеквизита = ЗначениеРеквизита[ИмяРеквизита];
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле """ + Реквизит.Значение + """ не заполнено",,, "Отчет." + Реквизит.Ключ, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из ИспользуемыеКаталоги Цикл
		Каталог = Новый Файл(Объект[Реквизит.Ключ]);
		Если НЕ Каталог.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог указанный в поле """ + Реквизит.Значение + """ не обнаружен",,, "Отчет." + Реквизит.Ключ, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьДатуЗапретаРедактированияДанныхЗУП(Команда)
	
	ДатаЗапретаРедактирования = Объект.ДатаЗапретаРедактирования;
	Если ВвестиДату(Объект.ДатаЗапретаРедактирования, "Изменить дату запрета редактирования данных ЗУП", ЧастиДаты.Дата) Тогда
	
		Если Объект.ДатаЗапретаРедактирования < '20230101' Тогда
			Объект.ДатаЗапретаРедактирования = ДатаЗапретаРедактирования;
			Предупреждение("Дата запрета не может быть меньше 01.01.2023");
			ИзменитьДатуЗапретаРедактированияДанныхЗУП(Неопределено);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры
