		|	_ОперацииДС.transactionId КАК transactionId,
		|	_ОперацииДС.isBalance КАК isBalance,
		|	_ОперацииДС.systemCode КАК systemCode,
		|	_ОперацииДС.tradeDate КАК tradeDate,
		|	_ОперацииДС.tradeDateTime КАК tradeDateTime,
		|	_ОперацииДС.paymentDate КАК paymentDate,
		|	_ОперацииДС.deliveryDate КАК deliveryDate,
		|	_ОперацииДС.tradingFloorId КАК tradingFloorId,
