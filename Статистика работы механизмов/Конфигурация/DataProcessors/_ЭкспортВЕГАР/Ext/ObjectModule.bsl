		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РанееВыгруженныеОперацииДС";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("РазделFX", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	Запрос.УстановитьПараметр("РазделFORTS", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FORTS"));
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	Если СделкиДляУдаления.Количество() > 0 Тогда
		УдалитьДанные(, ПараметрыПодключения, СделкиДляУдаления);
	КонецЕсли;
	
	КоличествоЗапросовВыгрузки = 0;
	
	Если СделкиДляВыгрузки.Количество() > 0 Тогда
		Для Каждого Портфель Из СделкиДляВыгрузки Цикл
			ТелоЗапросаJSON = ПолучитьСтрокуJSON(Портфель.Значение);
			Если ТелоЗапросаJSON <> Неопределено Тогда
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, ПараметрыПодключения.Trades, ТелоЗапросаJSON);
				КоличествоЗапросовВыгрузки = КоличествоЗапросовВыгрузки + Портфель.Значение.Количество();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеДляСтатистики.Вставить("ПроцедураВыгрузкиСделок", "Время выполнения: " + РассчитатьВремя(СтартЗапуска)
		+ ". Удалено: " + Строка(СделкиДляУдаления.Количество()) + ", загружено: " + Строка(КоличествоЗапросовВыгрузки) + ".");
КонецПроцедуры

Процедура ОбновитьПараметрыКлиентов(ПараметрыПодключения, ДанныеДляСтатистики)
	СтартЗапуска = ТекущаяДатаСеанса();
	
	ЗапросSQL = "SELECT
				|LZ_PORTFOLIOS.EXTERNAL_ID,
				|CAST(LZ_PORTFOLIOS.BROKER_ID AS VARCHAR(55)) AS BROKER_EGAR_ID,
				|LZ_COUNTERPARTIES.EXTERNAL_ID AS BROKER_MATRIX_ID,
				|LZ_PORTFOLIOS.SPOT_ALLOWED,
				|LZ_PORTFOLIOS.REPO_ALLOWED,
				|LZ_PORTFOLIOS.FOREIGN_ALLOWED
				|FROM LZ_PORTFOLIOS
				|INNER JOIN LZ_COUNTERPARTIES ON LZ_PORTFOLIOS.BROKER_ID = LZ_COUNTERPARTIES.ID
				|WHERE USE_FOR_CONSOLIDATION = 1 AND NOT LZ_PORTFOLIOS.NAME LIKE '%Расторгнут%'";
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("EXTERNAL_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ТипыКолонок.Вставить("BROKER_EGAR_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ТипыКолонок.Вставить("BROKER_MATRIX_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ТипыКолонок.Вставить("SPOT_ALLOWED", Новый ОписаниеТипов("Булево"));
	ТипыКолонок.Вставить("REPO_ALLOWED", Новый ОписаниеТипов("Булево"));
	ТипыКолонок.Вставить("FOREIGN_ALLOWED", Новый ОписаниеТипов("Булево"));
	
	ПараметрыКлиентовЕгар = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
	
	Если ПараметрыКлиентовЕгар = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПараметрыКлиентовЕгар.EXTERNAL_ID КАК EXTERNAL_ID,
		|	ПараметрыКлиентовЕгар.BROKER_EGAR_ID КАК BROKER_EGAR_ID,
		|	ПараметрыКлиентовЕгар.BROKER_MATRIX_ID КАК BROKER_MATRIX_ID,
		|	ПараметрыКлиентовЕгар.REPO_ALLOWED КАК REPO_ALLOWED,
		|	ПараметрыКлиентовЕгар.SPOT_ALLOWED КАК SPOT_ALLOWED,
		|	ПараметрыКлиентовЕгар.FOREIGN_ALLOWED КАК FOREIGN_ALLOWED
		|ПОМЕСТИТЬ _ПараметрыКлиентовЕгар
		|ИЗ
		|	&ПараметрыКлиентовЕгар КАК ПараметрыКлиентовЕгар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодБрокера,
		|	УсловияДоговоровСБрокером.Репо КАК ПризнакРепо,
		|	НЕ(УсловияДоговоровСБрокером.ФРОРК = """"
		|			И УсловияДоговоровСБрокером.КодРасчетовВВалютеНаФондовомРынке = """") КАК ПризнакФондовыйРынок,
		|	НЕ(УсловияДоговоровСБрокером.КодРасчетовВРубляхНаВалютномРынке = """"
		|			И УсловияДоговоровСБрокером.КодРасчетовВВалютеНаВалютномРынке = """") КАК ПризнакВалютныйРынок
		|ПОМЕСТИТЬ _ПараметрыКлиентов_1С
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаВыгрузкиКонецДня,
		|			СчетДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузкиКонецДня
		|				ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаВыгрузкиКонецДня, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровБрокерскогоОбслуживания.СрезПоследних(&ДатаВыгрузкиКонецДня, ) КАК УсловияДоговоровСБрокером
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровСБрокером.Договор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаВыгрузкиКонецДня,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо = КодыВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаВыгрузкиКонецДня)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПараметрыКлиентовЕгар.EXTERNAL_ID КАК EXTERNAL_ID,
		|	_ПараметрыКлиентовЕгар.BROKER_EGAR_ID КАК BROKER_EGAR_ID,
		|	ВЫБОР
		|		КОГДА _ПараметрыКлиентов_1С.ПризнакРепо
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК REPO_ALLOWED,
		|	ВЫБОР
		|		КОГДА _ПараметрыКлиентов_1С.ПризнакФондовыйРынок
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК SPOT_ALLOWED,
		|	ВЫБОР
		|		КОГДА _ПараметрыКлиентов_1С.ПризнакВалютныйРынок
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК FOREIGN_ALLOWED
		|ИЗ
		|	_ПараметрыКлиентовЕгар КАК _ПараметрыКлиентовЕгар
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПараметрыКлиентов_1С КАК _ПараметрыКлиентов_1С
		|		ПО _ПараметрыКлиентовЕгар.EXTERNAL_ID = _ПараметрыКлиентов_1С.КодСчетаДУ
		|			И _ПараметрыКлиентовЕгар.BROKER_MATRIX_ID = _ПараметрыКлиентов_1С.КодБрокера
		|			И (_ПараметрыКлиентовЕгар.REPO_ALLOWED <> _ПараметрыКлиентов_1С.ПризнакРепо
		|				ИЛИ _ПараметрыКлиентовЕгар.SPOT_ALLOWED <> _ПараметрыКлиентов_1С.ПризнакФондовыйРынок
		|				ИЛИ _ПараметрыКлиентовЕгар.FOREIGN_ALLOWED <> _ПараметрыКлиентов_1С.ПризнакВалютныйРынок)";
	
#КонецОбласти
	
	Запрос.УстановитьПараметр("ПараметрыКлиентовЕгар", ПараметрыКлиентовЕгар);
	Запрос.УстановитьПараметр("ДатаВыгрузкиКонецДня", КонецДня(ДатаВыгрузки));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		UpdateQuery = СтрШаблон("UPDATE [LZ_PORTFOLIOS] SET [REPO_ALLOWED] = %1, [SPOT_ALLOWED] = %2, [FOREIGN_ALLOWED] = %3
								|FROM [LZ_PORTFOLIOS] 
								|WHERE [LZ_PORTFOLIOS].[EXTERNAL_ID] = '%4' AND [LZ_PORTFOLIOS].[BROKER_ID] = '%5'",
								Выборка.REPO_ALLOWED, Выборка.SPOT_ALLOWED, Выборка.FOREIGN_ALLOWED, Выборка.EXTERNAL_ID, Выборка.BROKER_EGAR_ID);
		
		Если РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, UpdateQuery) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеДляСтатистики.Вставить("ОбновлениеПараметровКлиентов", "Время выполнения: " + РассчитатьВремя(СтартЗапуска) + ".");
КонецПроцедуры

Процедура СформироватьИВыгрузитьДанныеБумагУдерживаемыхДоПогашения(ПараметрыПодключения, ДанныеДляСтатистики, Сервер)
	СтартЗапуска = ТекущаяДатаСеанса();
	МассивДанныхДляВыгрузки = Новый Массив;
	ТекстСообщения = "";
	
	Query = "SELECT PAPERS.EXTERNAL_ID [INSTRUMENT_ID], CLIENTS.EXTERNAL_ID [PORTFOLIO_ID], HTM.[EXTERNAL_ID]
			|FROM [LZRG_BONDS_HTM] HTM
			|	LEFT JOIN [LZ_INSTRUMENTS] PAPERS
			|		ON HTM.INSTRUMENT_ID = PAPERS.ID
			|	LEFT JOIN [LZ_PORTFOLIOS] CLIENTS
			|		ON HTM.PORTFOLIO_ID = CLIENTS.ID";
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, Query);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЦенныеБумагиЕгар = Новый ТаблицаЗначений;
	ЦенныеБумагиЕгар.Колонки.Добавить("INSTRUMENT_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)));
	ЦенныеБумагиЕгар.Колонки.Добавить("PORTFOLIO_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ЦенныеБумагиЕгар.Колонки.Добавить("EXTERNAL_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	ДанныеИзЕгар = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей,, Новый Структура("ВозвращатьПустуюТаблицу", Истина));
	
	Если ДанныеИзЕгар = Неопределено Тогда
		Возврат;
	Иначе
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеИзЕгар, ЦенныеБумагиЕгар);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумагиЕгар.INSTRUMENT_ID КАК instrumentId,
		|	ЦенныеБумагиЕгар.PORTFOLIO_ID КАК portfolioId,
		|	ЦенныеБумагиЕгар.EXTERNAL_ID КАК externalId
		|ПОМЕСТИТЬ _ЦенныеБумаги_Егар
		|ИЗ
		|	&ЦенныеБумагиЕгар КАК ЦенныеБумагиЕгар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления.КодСчета КАК КодСчета
		|ПОМЕСТИТЬ _БухПартииОстатки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаВыгрузкиНачалоДня,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости)
		|				И Организация В (&РЭМ, &Траст)) КАК БухПартииЦенныхБумагОстатки
		|ГДЕ
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Брокер КАК Брокер
		|ПОМЕСТИТЬ _СчетаВОстатках
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ОстаткиДенежныхСредствОстатки.Брокер КАК Брокер
		|	ИЗ
		|		РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				,
		|				Организация В (&РЭМ, &Траст)
		|					И (СчетДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузкиНачалоДня
		|						ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|					И НЕ СчетДоверительногоУправления.ПометкаУдаления) КАК ОстаткиДенежныхСредствОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления,
		|		ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.Брокер
		|	ИЗ
		|		РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|				,
		|				Организация В (&РЭМ, &Траст)
		|					И (СчетДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузкиНачалоДня
		|						ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|					И НЕ СчетДоверительногоУправления.ПометкаУдаления) КАК ОстаткиЦенныхБумагОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.СчетДоверительногоУправления,
		|		ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Поручение.ДепозитарныйСчет.Брокер
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям.Остатки(
		|				,
		|				Организация В (&РЭМ, &Траст)
		|					И (СчетДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузкиНачалоДня
		|						ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|					И НЕ СчетДоверительногоУправления.ПометкаУдаления) КАК ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаВОстатках.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ВЫБОР
		|			КОГДА _СчетаВОстатках.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК КоличествоБрокеров
		|ПОМЕСТИТЬ _КоличествоБрокеровВОстатках
		|ИЗ
		|	_СчетаВОстатках КАК _СчетаВОстатках
		|
		|СГРУППИРОВАТЬ ПО
		|	_СчетаВОстатках.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
