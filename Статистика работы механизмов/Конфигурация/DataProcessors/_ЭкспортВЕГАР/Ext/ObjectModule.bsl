	//Операции (Погашения и возврат НКД / погашения облигаций)
	//1. Формируем расчетные данные по погашениям купонов и облигаций.
	//2. Из расчетных данных исключаем данные отраженные в учетной системе (операции погашения купонов и облигаций)
	// кроме случаев когда и погашение и оплата совершены одним днем в текущем дне.
	// Если операция погашения отражена в системе, и нет задолженности по погашению на конец текущего дня - значит прошла оплата.
	// - если оплата совершена раньше текущего дня - данные не выгружаем, т.к. эта сумма уже отражена в остатках ДС (остатки формируются на конец вчерашнего дня)
	// - если оплата прошла в текущем дне - выгружаем данные.
	//3. Из расчета исключаем данные по офертам put, т.к. участие не обязательное.
	//	Если прошло погашение по оферте put - данные об ожидаемых суммах выгрузятся по факту возникшей задолженности (при проведении документа погашение ценной бумаги)
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК Минус3,
		|	ВложенныйЗапрос.Минус2 КАК Минус2,
		|	ВложенныйЗапрос.Минус1 КАК Минус1,
		|	&ДатаВыгрузкиНачалоДня КАК НачалоТекущегоДня,
		|	ВложенныйЗапрос.Плюс1 КАК Плюс1,
		|	ВложенныйЗапрос.Плюс2 КАК Плюс2
		|ПОМЕСТИТЬ _РабочиеДни
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ДанныеКалендаря.Дата) КАК Минус2,
		|		ВложенныйЗапрос.НачалоПериода КАК Минус1,
		|		ВложенныйЗапрос.КонецПериода КАК Плюс1,
		|		МИНИМУМ(ДанныеКалендаря1.Дата) КАК Плюс2
		|	ИЗ
		|		(ВЫБРАТЬ
		|			МАКСИМУМ(ВЫБОР
		|					КОГДА ДанныеКалендаря.Дата < &ДатаВыгрузкиНачалоДня
		|						ТОГДА ДанныеКалендаря.Дата
		|				КОНЕЦ) КАК НачалоПериода,
		|			МИНИМУМ(ВЫБОР
		|					КОГДА ДанныеКалендаря.Дата > &ДатаВыгрузкиНачалоДня
		|						ТОГДА ДанныеКалендаря.Дата
		|				КОНЕЦ) КАК КонецПериода
		|		ИЗ
		|			РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ГДЕ
		|			ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|			И ДанныеКалендаря.Дата МЕЖДУ &МинусМесяц И &ПлюсМесяц) КАК ВложенныйЗапрос
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|			ПО ВложенныйЗапрос.НачалоПериода > ДанныеКалендаря.Дата
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря1
		|			ПО ВложенныйЗапрос.КонецПериода < ДанныеКалендаря1.Дата
		|	ГДЕ
		|		ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|		И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|		И ДанныеКалендаря.Дата МЕЖДУ &МинусМесяц И &ДатаВыгрузкиНачалоДня
		|		И ДанныеКалендаря1.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|		И ДанныеКалендаря1.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|		И ДанныеКалендаря1.Дата МЕЖДУ &ДатаВыгрузкиНачалоДня И &ПлюсМесяц
		|	
		|	СГРУППИРОВАТЬ ПО
