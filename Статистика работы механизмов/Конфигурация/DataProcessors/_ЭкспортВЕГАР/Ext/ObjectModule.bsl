						+ "</td><td class=""paper"">" + Выборка.ЦеннаяБумага + "</td><td class=""paper"">" + Выборка.instrumentId + "</td><td class=""paper"">" + Выборка.ISIN
						+ "</td><td>" + СокрЛП(Выборка.externalId) + "</td></tr>";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если МассивДанныхДляВыгрузки.Количество() > 0 Тогда
			ТелоЗапросаJSON = ПолучитьСтрокуJSON(МассивДанныхДляВыгрузки);
			
			Если ТелоЗапросаJSON <> Неопределено Тогда
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, ПараметрыПодключения.Bonds_htm, ТелоЗапросаJSON);
				
				Если HTTPОтвет <> Неопределено Тогда
					
					Если ЦенныеБумагиЕгар.Количество() = 0 Тогда
						ТекстСообщения = "<b>В Егар отсутствовали данные о ценных бумагах удерживаемых до погашения. В справочник [Bonds_HTM] загружено " + Выборка.Количество() + " зап.</b>";
					Иначе
						ТекстСообщения = "<b>Загружено</b><table cols=""7"">
										 |<tr class=""top""><td colspan=""3"">Счет доверительного управления</td><td colspan=""3"">Ценная бумага</td><td rowspan=""2"">External ID</td></tr>
										 |<tr class=""top""><td>Наименование</td><td>Код 1С</td><td>Код у брокера</td><td>Наименование</td><td>Код</td><td>ISIN</td></tr>" + Загружено + "</table>";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ТекстСообщения = ТекстСообщения + ?(Удалено = "", "", Символы.ПС + "<b>Удалено</b>
			|<table cols=""7"">
			|<tr class=""top""><td colspan=""3"">Счет доверительного управления</td><td colspan=""3"">Ценная бумага</td><td rowspan=""2"">External ID</td></tr>
			|<tr class=""top""><td>Наименование</td><td>Код 1С</td><td>Код у брокера</td><td>Наименование</td><td>Код</td><td>ISIN</td></tr>" + Удалено + "</table>");
		
		Если ТекстСообщения <> "" Тогда
			ТекстСообщения =
				"<html>
				|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
				|	<style type=""text/css"">
				|		body     { font-family: ""Arial""; font-size: 12px; }
				|		b        { font-size: 14px; }
				|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
				|		td       { border: 1px solid #CCC085; padding: 5px; }
				|		.paper   { color: #009646; }
				|		.warning { color: #DC143C; }
				|		.top     { background: #F4ECC5; }
				|	</style>
				|</head><body>" + ТекстСообщения + "</body></html>";
			РеквизитыОповещения = Новый Структура("Организация, Сервер, Текст", ЭтотОбъект.Организация, Сервер, ТекстСообщения);
			Справочники.Оповещения.СформироватьОповещения("Обработка._ЭкспортВЕГАР.СформироватьИВыгрузитьДанныеБумагУдерживаемыхДоПогашения",
				Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДляСтатистики.Вставить("ОбновлениеСпискаБумагУдерживаемыхДоПогашения", "Время выполнения: " + РассчитатьВремя(СтартЗапуска) + ".");
КонецПроцедуры

// Проверка соединения и установка соединения, если ещё не было подключения
Процедура ПроверитьСоединение(Сервер = Неопределено) Экспорт
	// Начало сессии
	СвойстваОбъекта = "ДатаВыгрузки, Организация, ЭкспортСделок, ЭкспортОстатков, ЭкспортСправочника, ОбновлениеПараметров, ЭкспортБумагУдерживаемыхДоПогашения";
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СвойстваОбъекта);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "(" + Сервер + ").ПроверитьСоединение";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(Сервер, Истина); // (Флаг Открыть соединение, Сервер - номер сервера, флаг только соединение SQL)
	
	Если ПараметрыПодключения = Неопределено Тогда
		// Отправка оповещения об отсутствии соединения
		ЗарегистрироватьУведомление("Проверка доступности сервиса EGAR (" + Сервер + "): Соединение не установлено. Возможно, сервис выключен.");
		ОбработатьУведомления(Сервер, "ПроверкаСоединения");
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Не удалось установить соединение с EGAR.");
	Иначе
		// Если проверка прошла успешно, максимум можно вывести пользователю это на экран, но при автоматическом запуске ничего не должно больше происходить
		Сообщить("Соединение с ЕГАР (" + Сервер + ") установлено успешно.");
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Соединение с EGAR успешно установлено.");
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьДанные(Сервер = Неопределено, ПараметрыПодключения = Неопределено, МассивСделок = Неопределено) Экспорт
	Если ПараметрыПодключения = Неопределено Тогда
		// Начало сессии
		СвойстваОбъекта = "ДатаВыгрузки, Организация, ЭкспортСделок, ЭкспортОстатков, ЭкспортСправочника, ОбновлениеПараметров, ЭкспортБумагУдерживаемыхДоПогашения";
		
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СвойстваОбъекта);
		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "(" + Сервер + ").УдалитьДанные.";
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
		
		ПараметрыПодключения = ПолучитьПараметрыПодключения(Сервер, Истина); // (Флаг Открыть соединение, Сервер - номер сервера, флаг только соединение SQL)
		
		Если ПараметрыПодключения = Неопределено Тогда
			ОбработатьУведомления(Сервер);
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, "Не удалось установить соединение с ЕГАР для удаления данных.");
			Возврат;
		КонецЕсли;
	Конецесли;
	
	Если МассивСделок = Неопределено Тогда
		// При удалении сделок через API, обязательства по сделкам не удаляются. Удаляем их из таблицы SQL.
		ЗапросSQL = "DELETE FROM [LZ_ASSET_FLOWS]";
		РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
		
		ЗапросSQL = "DELETE FROM [LZ_TRADES]";
		РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
		
		// Конец сессии
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(ПараметрыПодключения.СоединениеSQL);
		
		ОбработатьУведомления(Сервер);
	ИначеЕсли МассивСделок.Количество() > 0 Тогда
		СделкиНаУдаление = Новый Массив;
		
		Для Каждого Элемент Из МассивСделок Цикл
			СделкиНаУдаление.Добавить(Новый Структура("id, status", Элемент, "C"));
		КонецЦикла;
		
		ТелоЗапросаJSON = ПолучитьСтрокуJSON(СделкиНаУдаление);
		
		Если ТелоЗапросаJSON <> Неопределено Тогда
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, ПараметрыПодключения.Trades, ТелоЗапросаJSON);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура Загрузить(Сервер) Экспорт
	// Начало сессии
	ДанныеДляСтатистики = Новый Структура();
	СвойстваОбъекта = "ДатаВыгрузки, Организация, ЭкспортСделок, ЭкспортОстатков, ЭкспортСправочника, ОбновлениеПараметров, ЭкспортБумагУдерживаемыхДоПогашения";
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СвойстваОбъекта);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "(" + Сервер + ")";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(Сервер);
	
	Если ПараметрыПодключения = Неопределено Тогда
		ОбработатьУведомления(Сервер);
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
			Механизм, Сессия,,, "Не удалось установить соединение с ЕГАР для выгрузки данных.");
		Возврат;
	КонецЕсли;
		
	Если ЭкспортОстатков Или ЭкспортСделок Тогда
		ТаблицаВыгруженныхСделок = ПолучитьТаблицуВыгруженныхСделок(ПараметрыПодключения, ДанныеДляСтатистики);
		
		Если ТаблицаВыгруженныхСделок = Неопределено Тогда
			ОбработатьУведомления(Сервер);
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
				Механизм, Сессия,,, "Не удалось получить данные из ЕГАР о ранее выгруженных сделках.");
			Возврат;
		КонецЕсли;
		
		МВТ = ПолучитьМенеджерВременныхТаблиц(ТаблицаВыгруженныхСделок, ДанныеДляСтатистики);
	КонецЕсли;
	
	Если ЭкспортСправочника Тогда
		СформироватьИВыгрузитьДанныеПоСчетамДУ(ПараметрыПодключения, ДанныеДляСтатистики);
	КонецЕсли;
	
	Если ЭкспортОстатков Тогда
		СформироватьИВыгрузитьОстатки(Сервер, ПараметрыПодключения, МВТ, ДанныеДляСтатистики);
	КонецЕсли;
	
	Если ЭкспортСделок Тогда
		СформироватьИВыгрузитьДанныеПоСделкам(ПараметрыПодключения, МВТ, ДанныеДляСтатистики);
	КонецЕсли;
	
	Если ОбновлениеПараметров Тогда
		ОбновитьПараметрыКлиентов(ПараметрыПодключения, ДанныеДляСтатистики);
	КонецЕсли;
	
	Если ЭкспортБумагУдерживаемыхДоПогашения Тогда
		СформироватьИВыгрузитьДанныеБумагУдерживаемыхДоПогашения(ПараметрыПодключения, ДанныеДляСтатистики, Сервер);
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(ПараметрыПодключения.СоединениеSQL);
	
	ОбработатьУведомления(Сервер);
	
	// Конец сессии
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДанныеДляСтатистики);
КонецПроцедуры

Процедура ОбновитьЛимиты(Сервер) Экспорт
	#Область Получение_данных_из_МАТРИХ
	//Сервер = "АП91";
	СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСМатрих();
	СоединениеСМатрих = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
	
	Если СоединениеСМатрих = Неопределено Тогда
		ОбработатьУведомления(Сервер);
		Возврат;
	КонецЕсли;

	// 3 - ДУ, 11 - Нефтегарант, 44 - НПФы, 45 - НПФы+Согласие+РВИ+ДУ, 53 - Будущее, 6 - НПФы+Согласие+НГ+РВИ+ДУ
	ЗапросSQL =
		"SELECT
		|CAST(_limits.Limit_Group_ID AS VARCHAR) + '-' + CAST(_limits.Limit_Object_ID AS VARCHAR) + '-' + CAST(_limits.Currency_ID AS VARCHAR) id,
		|_groups.Name + '-' + _objects.Name + '-#' + CASE WHEN _limits.Status = 2321 THEN CAST(_limits.ID AS VARCHAR) ELSE CAST(_limits.ID AS VARCHAR) + '-ТЕХНИЧЕСКИЙ' END name,
		|CASE WHEN _limits.Status = 2321 THEN 0 ELSE 1 END valueVerification,
		|CAST(_limits.Date_Start AS Datetime) startDate,
		|_limits.Volume * 1000000 ownValue,
		|_limits.Currency_ID valueCurrencyCode,
		|@CURRENCY_LIMITS,
		|'K' + CAST(_limits.Limit_Object_ID AS VARCHAR) objectId,
		|_firms.Firm_ID matriхId,
		|_groups.ID categoryId
		|FROM [MatriX].[Risks].[Limits] _limits
		|	LEFT JOIN [MatriX].[Risks].[Limits_Groups] _groups ON _limits.Limit_Group_ID = _groups.ID
		|	LEFT JOIN [MatriX].[Risks].[Limits_Objects] _objects ON _limits.Limit_Object_ID = _objects.ID
		|	LEFT JOIN [MatriX].[Risks].Limits_Objects_Firms _firms ON _limits.[Limit_Object_ID] = _firms.[Limit_Object_ID]
		//|--WHERE (_groups.ID = 53 AND _limits.Status IN (2321, 2323)) OR (_groups.ID IN (3, 11, 44, 45, 6, 48) AND _limits.Status = 2321)";
		|WHERE _groups.ID IN (3, 11, 44, 45, 6, 48, 53) AND _limits.Status IN (2321, 2323)";
	Если Сервер = "АП91" Тогда
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "@CURRENCY_LIMITS", "CASE WHEN _limits.Currency_ID = 32 THEN 12839 WHEN _limits.Currency_ID = 10 THEN 12840 END currencyLimitId"); //WHEN _limits.Currency_ID = 25 THEN 12841 
	ИначеЕсли Сервер = "АП55" Тогда
		ЗапросSQL = СтрЗаменить(ЗапросSQL, "@CURRENCY_LIMITS", "CASE WHEN _limits.Currency_ID = 32 THEN 10597 WHEN _limits.Currency_ID = 10 THEN 10598 END currencyLimitId"); //WHEN _limits.Currency_ID = 25 THEN 10599 
	КонецЕсли;
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(СоединениеСМатрих, ЗапросSQL);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат;
	Иначе
		ТипыКолонок = Новый Структура;
		ТипыКолонок.Вставить("id", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
		ТипыКолонок.Вставить("name", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		ТипыКолонок.Вставить("startDate", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
		ТипыКолонок.Вставить("ownValue", Новый ОписаниеТипов("Число"));
		ТипыКолонок.Вставить("valueCurrencyCode", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
		ТипыКолонок.Вставить("currencyLimitId", Новый ОписаниеТипов("Число"));
		ТипыКолонок.Вставить("objectId", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
		ТипыКолонок.Вставить("matriхId", Новый ОписаниеТипов("Число"));
		ТипыКолонок.Вставить("categoryId", Новый ОписаниеТипов("Число"));
		ТипыКолонок.Вставить("valueVerification", Новый ОписаниеТипов("Число"));
		
		ТаблицаЛимитов = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(СоединениеСМатрих);
	#КонецОбласти
	
	#Область Получение_данных_из_ЕГАР
	ТаблицаМатрихКодовЭмитентов = ТаблицаЛимитов.Скопировать( ,"matriхId");
	ТаблицаМатрихКодовЭмитентов.Свернуть("matriхId");
	
	//Собираем массив матрих кодов эмитентов для запароса в ЕГАР для получения кодов ЕГАР
	СтрокаМатрихКодов = "";
	Для Каждого Строка Из ТаблицаМатрихКодовЭмитентов Цикл
		Если ПустаяСтрока(Строка.matriхID) Тогда
			Продолжить;
		Иначе
			СтрокаМатрихКодов = СтрокаМатрихКодов + ?(ПустаяСтрока(СтрокаМатрихКодов), "", ", ") + "'" + ЧислоJSON(Строка.matriхID) + "'";
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения(Сервер); 
	
	Если ПараметрыПодключения = Неопределено Тогда
		ОбработатьУведомления(Сервер);
		Возврат;
	КонецЕсли;
	
	//Получаем таблицу кодов(матрих - егар) эмитентов из ЕГАР
	ЗапросSQL =
		"SELECT ID egarId,
		|EXTERNAL_ID matrixId
		|FROM [LZ_COUNTERPARTIES] WHERE EXTERNAL_ID IN (" + СтрокаМатрихКодов + ")";
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат;
	Иначе
		ТипыКолонок = Новый Структура;
		ТипыКолонок.Вставить("egarId", Новый ОписаниеТипов("Число"));
		ТипыКолонок.Вставить("matrixId", Новый ОписаниеТипов("Число"));
		ТаблицаМатрихЕгарКодовЭмитентов = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
	КонецЕсли;
		
	ЗапросSQL =
		"SELECT EXTERNAL_ID externalId,
		|CASE WHEN NAME LIKE '%ТЕХНИЧЕСКИЙ%'
		|		THEN CASE WHEN CURRENT_VALUE < OWN_VALUE THEN CURRENT_VALUE ELSE 0 END
		|		ELSE OWN_VALUE END newOwnValue,
		|		COMMENT AS comment
		//|ISNULL(CAST(CASE WHEN COMMENT LIKE '%[а-яА-Я]%'
		//|					THEN 0
		//|					ELSE COMMENT END AS BIGINT), 0) AS oldOwnValue
		|FROM [LZ_LIMITS] WHERE NOT EXTERNAL_ID IS NULL AND IS_DELETED = 0";
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат;
	Иначе
		ТаблицаЛимитовЕгар = Новый ТаблицаЗначений;
		ТаблицаЛимитовЕгар.Колонки.Добавить("externalId", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)), "externalId");
		ТаблицаЛимитовЕгар.Колонки.Добавить("newOwnValue", Новый ОписаниеТипов("Число"), "newOwnValue");
		ТаблицаЛимитовЕгар.Колонки.Добавить("oldOwnValue", Новый ОписаниеТипов("Число"), "oldOwnValue");
		ТаблицаЛимитовЕгар.Колонки.Добавить("comment", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)), "comment");
		
		ВнешниеДанные = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей);
		
		Если ВнешниеДанные <> Неопределено Тогда
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ВнешниеДанные, ТаблицаЛимитовЕгар);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаЗаписи Из ТаблицаЛимитовЕгар Цикл
		Если ЗначениеЗаполнено(СтрокаЗаписи.comment) Тогда
			Попытка
				СтрокаЗаписи.oldOwnValue = Число(СтрокаЗаписи.comment);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	#КонецОбласти
	
	//Для каждого лимита собираем Егар_коды эмитентов для дальнейшего формирования фильтров
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЛимитов.objectId КАК КодОбъектаЛимитирования,
		|	_ТаблицаЛимитов.matriхId КАК КодМатрихПодчиненногоОбъекта
		|ПОМЕСТИТЬ _ТаблицаОбъектовЛимитирования
		|ИЗ
		|	&ТаблицаЛимитов КАК _ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаКодов.egarId КАК КодЕгар,
		|	_ТаблицаКодов.matrixId КАК КодМатрих
		|ПОМЕСТИТЬ _ТаблицаКодов
		|ИЗ
		|	&ТаблицаМатрихЕгарКодов КАК _ТаблицаКодов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаОбъектовЛимитирования.КодОбъектаЛимитирования КАК КодОбъекта,
		|	_ТаблицаКодов.КодЕгар КАК КодЕгар
		|ИЗ
		|	_ТаблицаОбъектовЛимитирования КАК _ТаблицаОбъектовЛимитирования
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаКодов
		|	ПО _ТаблицаОбъектовЛимитирования.КодМатрихПодчиненногоОбъекта = _ТаблицаКодов.КодМатрих
		|	И НЕ _ТаблицаКодов.КодЕгар ЕСТЬ NULL";
	#КонецОбласти
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ТаблицаЛимитов);
	Запрос.УстановитьПараметр("ТаблицаМатрихЕгарКодов", ТаблицаМатрихЕгарКодовЭмитентов);
	
	ОбъектыЛимитирования = Новый Структура;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не ОбъектыЛимитирования.Свойство(Выборка.КодОбъекта) И Не ПустаяСтрока(Выборка.КодЕгар) Тогда
			ОбъектыЛимитирования.Вставить(Выборка.КодОбъекта, Новый Массив());
		КонецЕсли;
		
		Если Не ПустаяСтрока(Выборка.КодЕгар) Тогда
			ОбъектыЛимитирования[Выборка.КодОбъекта].Добавить(Строка(ЧислоJSON(Выборка.КодЕгар)));
		КонецЕсли;
	КонецЦикла;
	
	МассивЛимитов = Новый Массив;
	ТаблицаЛимитов = ТаблицаЛимитов.Скопировать( ,"id, name, startDate, ownValue, valueCurrencyCode, currencyLimitId, objectId, categoryId, valueVerification");
	ТаблицаЛимитов.Свернуть("id, name, startDate, ownValue, valueCurrencyCode, currencyLimitId, objectId, categoryId, valueVerification");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ПОМЕСТИТЬ _ТаблицаЛимитов
		|ИЗ
		|	&ТаблицаЛимитов КАК ТаблицаЛимитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ПОМЕСТИТЬ _ТаблицаЛимитовЕгар
		|ИЗ
		|	&ТаблицаЛимитовЕгар КАК ТаблицаЛимитовЕгар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ТаблицаЛимитов.id, _ТаблицаЛимитовЕгар.externalId) КАК id,
		|	_ТаблицаЛимитов.name КАК name,
		|	_ТаблицаЛимитов.startDate КАК startDate,
		|	ВЫБОР
		|		КОГДА _ТаблицаЛимитов.valueVerification = 1
		|			И _ТаблицаЛимитовЕгар.newOwnValue > 0 
		|			И _ТаблицаЛимитов.ownValue = _ТаблицаЛимитовЕгар.oldOwnValue
		|		ТОГДА _ТаблицаЛимитовЕгар.newOwnValue
		|		ИНАЧЕ _ТаблицаЛимитов.ownValue
		|	КОНЕЦ КАК ownValue,
		|	_ТаблицаЛимитов.valueCurrencyCode КАК valueCurrencyCode,
		|	_ТаблицаЛимитов.objectId КАК objectId,
		|	_ТаблицаЛимитов.categoryId КАК categoryId,
		//
		|	_ТаблицаЛимитов.currencyLimitId КАК currencyLimitId,
		//|	_ТаблицаЛимитов.valueVerification КАК valueVerification,
		//|	_ТаблицаЛимитовЕгар.oldOwnValue КАК newOwnValue,
		//|	_ТаблицаЛимитов.ownValue КАК  ownValue_Test,
		//
		|	ВЫБОР
		|		КОГДА _ТаблицаЛимитов.id ЕСТЬ NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагУдаления,
		|	ВЫБОР
		|		КОГДА _ТаблицаЛимитовЕгар.externalId ЕСТЬ NULL
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ ВЫБОР
		|			КОГДА _ТаблицаЛимитов.valueVerification = 1 И (_ТаблицаЛимитовЕгар.newOwnValue > 0 ИЛИ _ТаблицаЛимитов.ownValue <> _ТаблицаЛимитовЕгар.oldOwnValue)
		|				ИЛИ _ТаблицаЛимитов.valueVerification = 0 И _ТаблицаЛимитов.ownValue <> _ТаблицаЛимитовЕгар.newOwnValue
		|			ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	КОНЕЦ КАК ФлагВыгрузки,
		|	ВЫБОР КОГДА _ТаблицаЛимитов.valueVerification = 1
		|			И _ТаблицаЛимитов.ownValue <> _ТаблицаЛимитовЕгар.oldOwnValue
		|		ТОГДА _ТаблицаЛимитов.ownValue
		|		ИНАЧЕ _ТаблицаЛимитовЕгар.oldOwnValue
		|	КОНЕЦ КАК comment
		|ИЗ
		|	_ТаблицаЛимитовЕгар КАК _ТаблицаЛимитовЕгар
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ТаблицаЛимитов КАК _ТаблицаЛимитов
		|		ПО _ТаблицаЛимитовЕгар.externalId = _ТаблицаЛимитов.id";
	#КонецОбласти
	Запрос.УстановитьПараметр("ТаблицаЛимитов", ТаблицаЛимитов);
	Запрос.УстановитьПараметр("ТаблицаЛимитовЕгар", ТаблицаЛимитовЕгар);
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивЛимитовДляЗагрузки = Новый Массив;
	МассивЛимитовДляУдаления = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ФлагУдаления Тогда
			МассивЛимитовДляУдаления.Добавить(Выборка.id);
			Продолжить;
		КонецЕсли;
		
		Если Выборка.ФлагВыгрузки Тогда
			
			Лимит = Новый Структура();
			
			Если ОбъектыЛимитирования.Свойство(Выборка.objectId) Тогда
				СтрокаКодов = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ОбъектыЛимитирования[Выборка.objectId]);
				СтрокаФильтра = "<expr exprType='func'><field id='DepositaryId' type='list(INT)'/><operator name='IN'/><value val='"
					+ СтрокаКодов + "'/></expr><expr exprType='bool' name='OR'/><expr exprType='func'><field id='InstrumentIssuerId' type='list(INT)'/>"
					+ "<operator name='IN'/><value val='" + СтрокаКодов + "'/></expr>";
			Иначе
				СтрокаФильтра = ""
			КонецЕсли;
			
			Лимит.Вставить("id", Выборка.id);
			Лимит.Вставить("categoryId", Строка(ЧислоJSON(Выборка.categoryId)));
			Лимит.Вставить("type", "CL");
			Лимит.Вставить("name", Выборка.name);
			Лимит.Вставить("kind", "R");
			Лимит.Вставить("ownValue", ЧислоJSON(Выборка.ownValue));
			Лимит.Вставить("valueCurrencyCode", Выборка.valueCurrencyCode);
			Лимит.Вставить("valueRestrictionType", "LE");
			Лимит.Вставить("startDate", ДатаJSON(Выборка.startDate));
			Лимит.Вставить("required", 1);
			Лимит.Вставить("recalculateOnTrade", 1);
			Лимит.Вставить("recalculateOnBod", 1);
			Лимит.Вставить("useParentRecalculationTimer", 1);
			
			Если Не ПустаяСтрока(Выборка.comment) Тогда
				Лимит.Вставить("comment", Строка(ЧислоJSON(Выборка.comment)));
			КонецЕсли;
			
			МассивФильтров = Новый Массив;
			
			Если Выборка.currencyLimitId <> 0 Тогда
				ФильтрПоВалюте = Новый Структура("id", Формат(Выборка.currencyLimitId, "ЧРД=.; ЧГ=0"));
				МассивФильтров.Добавить(ФильтрПоВалюте);
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаФильтра) Тогда
				ФильтрПоЭмитентам = Новый Структура("expression", СтрокаФильтра);
				МассивФильтров.Добавить(ФильтрПоЭмитентам);
			КонецЕсли;
			
			Если МассивФильтров.Количество() > 0 Тогда
				Лимит.Вставить("filters", МассивФильтров);
			КонецЕсли;
			
			МассивЛимитовДляЗагрузки.Добавить(Лимит);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивЛимитовДляЗагрузки.Количество() > 0 Тогда
		ТелоЗапросаJSON = ПолучитьСтрокуJSON(МассивЛимитовДляЗагрузки);
		
		Если ТелоЗапросаJSON <> Неопределено Тогда
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, ПараметрыПодключения.Limits, ТелоЗапросаJSON);
		КонецЕсли;
	КонецЕсли;
	
	Если МассивЛимитовДляУдаления.Количество() > 0 Тогда
		ТелоЗапросаJSON = ПолучитьСтрокуJSON(МассивЛимитовДляУдаления);
		
		Если ТелоЗапросаJSON <> Неопределено Тогда
			HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("DELETE", ПараметрыПодключения, ПараметрыПодключения.Limits, ТелоЗапросаJSON);
		КонецЕсли;
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(ПараметрыПодключения.СоединениеSQL);
КонецПроцедуры

Функция РассчитатьВремя(СтартЗапуска)
	ВремяСек = ТекущаяДатаСеанса() - СтартЗапуска;
	ВремяМин = Цел((ВремяСек) / 60);
	
	Возврат Строка(ВремяСек) + " сек."  + ?(ВремяМин > 0, " (" + Строка(ВремяМин) + " м. " + Строка(ВремяСек - ВремяМин * 60) + " с.)", "");
КонецФункции

