		|	ВЫРАЗИТЬ(""Сводная_сделка-"" + _СводныеСделки.День + ""-"" + _СводныеСделки.ТипСделки + ""-"" + _СводныеСделки.СчетДУ.КодСчета + ""-"" + _СводныеСделки.МатрихКодЦБ + ""-"" + ЕСТЬNULL(_СводныеСделки.КодРежимаБиржевыхТоргов, ""Внеб"") КАК СТРОКА(50)) КАК id,
		|	"""" КАК transactionId,
		|	0 КАК isBalance,
		|	""1C"" КАК systemCode,
		|	_СводныеСделки.ДатаСделки КАК tradeDate,
		|	_СводныеСделки.ДатаСделки КАК tradeDateTime,
		|	_СводныеСделки.ДатаОплаты КАК paymentDate,
		|	_СводныеСделки.ДатаПоставки КАК deliveryDate,
		|	_СводныеСделки.МестоХранения КАК tradingFloorId,
		|	_СводныеСделки.МестоХраненияЦБ КАК productCode,
		|	ВЫРАЗИТЬ(_СводныеСделки.Количество КАК ЧИСЛО(19, 4)) КАК quantity,
		|	ВЫРАЗИТЬ(_СводныеСделки.Сумма / _СводныеСделки.Количество КАК ЧИСЛО(19, 10)) КАК price,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА _СводныеСделки.КодВалютыСделки = ВалютыКомиссииБрокера.МатрихКодВалюты
		|					И _СводныеСделки.КодВалютыСделки = ВалютыТорговойКомиссии.МатрихКодВалюты
		|				ТОГДА _СводныеСделки.Сумма + _СводныеСделки.СуммаКупона + _СводныеСделки.КомиссияБрокера + _СводныеСделки.ТорговаяКомиссия
		|			ИНАЧЕ _СводныеСделки.Сумма + _СводныеСделки.СуммаКупона
		|		КОНЕЦ КАК ЧИСЛО(19, 4)) КАК payment,
		|	ВЫБОР
		|		КОГДА _СводныеСделки.ТипСделки = ""B""
		|			ТОГДА -(_СводныеСделки.Сумма + _СводныеСделки.СуммаКупона)
		|		ИНАЧЕ _СводныеСделки.Сумма + _СводныеСделки.СуммаКупона
		|	КОНЕЦ КАК paymentAssetFlows,
		|	_СводныеСделки.СчетДУ.КодСчета КАК portfolioId,
		|	_СводныеСделки.МатрихКодЦБ КАК instrumentId,
		|	_СводныеСделки.МатрихКодКонтрагента КАК counterpartyId,
		|	_СводныеСделки.МатрихКодДепозитария КАК depositaryId,
		|	_СводныеСделки.МатрихКодКлиента КАК customerId,
		|	_СводныеСделки.КодВалютыОплаты КАК paymentCurrencyCode,
		|	_СводныеСделки.КодВалютыСделки КАК priceCurrencyCode,
		|	0 КАК traderId,
		|	0 КАК lastTraderId,
		|	0 КАК legNumber,
		|	_СводныеСделки.СуммаКупона / _СводныеСделки.Количество КАК accruedInterest,
		|	_СводныеСделки.ЦенаОценки КАК dirtyPrice,
		|	_СводныеСделки.МатрихКодКлиента КАК branchId,
		|	""BRK"" КАК scope,
		|	_СводныеСделки.Тип КАК type,
		|	0 КАК interestRate,
		|	_СводныеСделки.КодРежимаБиржевыхТоргов КАК tradingModeId,
		|	""DVP"" КАК settlementType,
		|	_СводныеСделки.ТипСделки КАК side,
		|	""ST"" КАК bOstatus,
		|	1 КАК isSkipDetails,
		|	""T"" КАК objectType,
		|	"""" КАК originId,
		|	ЕСТЬNULL(-_СводныеСделки.ТорговаяКомиссия, 0) КАК ТорговаяКомиссия,
		|	ВалютыТорговойКомиссии.МатрихКодВалюты КАК ВалютаТорговойКомиссии,
		|	_СводныеСделки.ДатаОплатыТорговойКомиссии КАК ДатаОплатыТорговойКомиссии,
		|	ЕСТЬNULL(-_СводныеСделки.КомиссияБрокера, 0) КАК КомиссияБрокера,
		|	ВалютыКомиссииБрокера.МатрихКодВалюты КАК ВалютаКомиссииБрокера,
		|	_СводныеСделки.ДатаОплатыКомиссииБрокера КАК ДатаОплатыКомиссииБрокера,
		|	_СводныеСделки.МатрихКодБанка КАК moneyCounterpartyId,
		|	_СводныеСделки.СчетДУ КАК СчетДУ,
		|	"""" КАК expirationDate
		|ПОМЕСТИТЬ _ИтоговыеСделки
		|ИЗ
		|	_СводныеСделки КАК _СводныеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыТорговойКомиссии
		|		ПО _СводныеСделки.ВалютаТорговойКомиссии = ВалютыТорговойКомиссии.ВалютаСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыКомиссииБрокера
		|		ПО _СводныеСделки.ВалютаКомиссииБрокера = ВалютыКомиссииБрокера.ВалютаСсылка
		|;
