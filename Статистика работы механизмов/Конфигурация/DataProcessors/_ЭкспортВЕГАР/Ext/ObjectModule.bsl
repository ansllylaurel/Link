	#КонецОбласти
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	//Операции с ЦБ. Задолженности по поручениям (ожидаемые вводы-выводы ЦБ).
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(""ОперацииЦБ"" КАК СТРОКА(15)) КАК comment,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				ТОГДА ""ВводЦБ-""
		|			ИНАЧЕ ""ВыводЦБ-""
		|		КОНЕЦ + МатрихКодыЦБ.Код + ""-"" + ЗадолженностиПоЦеннымБумагамПоПоручениям.Поручение.Номер КАК СТРОКА(50)) КАК id,
		|	"""" КАК transactionId,
		|	0 КАК isBalance,
		|	""1C"" КАК systemCode,
		|	&ДатаВыгрузкиНачалоДня КАК tradeDate,
		|	&ДатаВыгрузкиНачалоДня КАК tradeDateTime,
		|	&ДатаВыгрузкиНачалоДня КАК paymentDate,
		|	&ДатаВыгрузкиНачалоДня КАК deliveryDate,
		|	"""" КАК tradingFloorId,
		|	""004"" КАК productCode,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				ТОГДА 1
		|			ИНАЧЕ -1
		|		КОНЕЦ * ЗадолженностиПоЦеннымБумагамПоПоручениям.КоличествоОстаток КАК ЧИСЛО(19, 4)) КАК quantity,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.КоличествоОстаток = 0
		|			ТОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.СуммаОстаток + ЗадолженностиПоЦеннымБумагамПоПоручениям.СуммаКупонаОстаток
		|		ИНАЧЕ (ЗадолженностиПоЦеннымБумагамПоПоручениям.СуммаОстаток + ЗадолженностиПоЦеннымБумагамПоПоручениям.СуммаКупонаОстаток) / ЗадолженностиПоЦеннымБумагамПоПоручениям.КоличествоОстаток
		|	КОНЕЦ КАК price,
		|	ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамПоПоручениям.КоличествоОстаток КАК ЧИСЛО(19, 4)) КАК payment,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК portfolioId,
		|	МатрихКодыЦБ.Код КАК instrumentId,
		|	ЕСТЬNULL(_КодыМатрихДепозитариев.Код, &МатрихКод_НКО_НКЦ) КАК counterpartyId,
		|	ЕСТЬNULL(_КодыМатрихДепозитариев.Код, &МатрихКод_НКО_НКЦ) КАК depositaryId,
		|	_КодыМатрихКлиентов.Код КАК customerId,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|			ТОГДА NULL
		|		КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
		|			ТОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага.Валюта
		|		ИНАЧЕ ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага.ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала,
		|	0 КАК traderId,
		|	0 КАК lastTraderId,
		|	0 КАК legNumber,
		|	0 КАК accruedInterest,
		|	1 КАК dirtyPrice,
		|	_КодыМатрихКлиентов.Код КАК branchId,
		|	""BRK"" КАК scope,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|			ТОГДА ""FUT""
		|		ИНАЧЕ ""SPF""
		|	КОНЕЦ КАК type,
		|	0 КАК interestRate,
		|	""TRAS"" КАК tradingModeId,
		|	""SAF"" КАК settlementType,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамПоПоручениям.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ""B""
		|		ИНАЧЕ ""S""
		|	КОНЕЦ КАК side,
		|	""ST"" КАК bOstatus,
		|	1 КАК isSkipDetails,
		|	""T"" КАК objectType,
		|	"""" КАК originId,
		|	""PH"" КАК assetFlowsType,
		|	"""" КАК expirationDate
		|ПОМЕСТИТЬ _ВводыВыводы
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям.Остатки(
		|			,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения >= &ДатаВыгрузкиНачалоДня
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|				И НЕ СчетДоверительногоУправления.ПометкаУдаления
		|				И НЕ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)) КАК ЗадолженностиПоЦеннымБумагамПоПоручениям
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрих КАК _КодыМатрихКлиентов
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = _КодыМатрихКлиентов.Объект
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = ЗадолженностиПоЦеннымБумагамПоПоручениям.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрих КАК МатрихКодыЦБ
		|		ПО ЗадолженностиПоЦеннымБумагамПоПоручениям.ЦеннаяБумага = МатрихКодыЦБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрих КАК _КодыМатрихДепозитариев
		|		ПО ЗадолженностиПоЦеннымБумагамПоПоручениям.Поручение.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо = _КодыМатрихДепозитариев.Объект
		|ГДЕ
		|	РАЗНОСТЬДАТ(ЗадолженностиПоЦеннымБумагамПоПоручениям.Поручение.Дата, &ДатаВыгрузкиНачалоДня, ДЕНЬ) < 32
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РанееВыгруженныеОперации.ID КАК ID,
		|	_РанееВыгруженныеОперации.QUANTITY КАК QUANTITY,
		|	_РанееВыгруженныеОперации.PRICE КАК PRICE
		|ПОМЕСТИТЬ _РанееВыгруженныеВводыВыводыЦБ
		|ИЗ
		|	_РанееВыгруженныеОперации КАК _РанееВыгруженныеОперации
		|ГДЕ
		|	_РанееВыгруженныеОперации.COMMENT = (ВЫРАЗИТЬ(""ОперацииЦБ"" КАК СТРОКА(15)))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВводыВыводы.comment КАК comment,
		|	_ВводыВыводы.id КАК id,
		|	_ВводыВыводы.transactionId КАК transactionId,
		|	_ВводыВыводы.isBalance КАК isBalance,
		|	_ВводыВыводы.systemCode КАК systemCode,
		|	_ВводыВыводы.tradeDate КАК tradeDate,
		|	_ВводыВыводы.tradeDateTime КАК tradeDateTime,
		|	_ВводыВыводы.paymentDate КАК paymentDate,
		|	_ВводыВыводы.deliveryDate КАК deliveryDate,
		|	_ВводыВыводы.tradingFloorId КАК tradingFloorId,
		|	_ВводыВыводы.productCode КАК productCode,
		|	_ВводыВыводы.quantity КАК quantity,
		|	_ВводыВыводы.price КАК price,
		|	_ВводыВыводы.payment КАК payment,
		|	_ВводыВыводы.portfolioId КАК portfolioId,
		|	_ВводыВыводы.instrumentId КАК instrumentId,
		|	_ВводыВыводы.counterpartyId КАК counterpartyId,
		|	_ВводыВыводы.depositaryId КАК depositaryId,
		|	_ВводыВыводы.customerId КАК customerId,
		|	ВалютыЦБ.МатрихКодВалюты КАК paymentCurrencyCode,
		|	ВалютыЦБ.МатрихКодВалюты КАК priceCurrencyCode,
		|	_ВводыВыводы.traderId КАК traderId,
		|	_ВводыВыводы.lastTraderId КАК lastTraderId,
		|	_ВводыВыводы.legNumber КАК legNumber,
		|	_ВводыВыводы.accruedInterest КАК accruedInterest,
		|	_ВводыВыводы.dirtyPrice КАК dirtyPrice,
		|	_ВводыВыводы.branchId КАК branchId,
		|	_ВводыВыводы.scope КАК scope,
		|	_ВводыВыводы.type КАК type,
		|	_ВводыВыводы.interestRate КАК interestRate,
		|	_ВводыВыводы.tradingModeId КАК tradingModeId,
		|	_ВводыВыводы.settlementType КАК settlementType,
		|	_ВводыВыводы.side КАК side,
		|	_ВводыВыводы.bOstatus КАК bOstatus,
		|	_ВводыВыводы.isSkipDetails КАК isSkipDetails,
		|	_ВводыВыводы.objectType КАК objectType,
		|	_ВводыВыводы.originId КАК originId,
		|	_ВводыВыводы.assetFlowsType КАК assetFlowsType,
		|	_ВводыВыводы.expirationDate КАК expirationDate,
		|	ВЫБОР
		|		КОГДА _РанееВыгруженныеВводыВыводыЦБ.ID ЕСТЬ NULL
		|				И _ВводыВыводы.quantity <> 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагВыгрузки,
		|	ВЫБОР
		|		КОГДА _ВводыВыводы.id ЕСТЬ NULL
		|			ТОГДА _РанееВыгруженныеВводыВыводыЦБ.ID
		|	КОНЕЦ КАК ИДСделкиДляУдаления
		|ИЗ
		|	_ВводыВыводы КАК _ВводыВыводы
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РанееВыгруженныеВводыВыводыЦБ КАК _РанееВыгруженныеВводыВыводыЦБ
		|		ПО _ВводыВыводы.id = _РанееВыгруженныеВводыВыводыЦБ.ID
		|			И _ВводыВыводы.quantity = _РанееВыгруженныеВводыВыводыЦБ.QUANTITY
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыЦБ
		|		ПО _ВводыВыводы.ВалютаНоминала = ВалютыЦБ.ВалютаСсылка
