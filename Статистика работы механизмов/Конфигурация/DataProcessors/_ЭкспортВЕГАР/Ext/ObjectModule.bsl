		|	_Сделки.ВалютаТорговойКомиссии КАК ВалютаТорговойКомиссии,
		|	_Сделки.ДатаОплатыТорговойКомиссии КАК ДатаОплатыТорговойКомиссии,
		|	_Сделки.КомиссияБрокера КАК КомиссияБрокера,
		|	_Сделки.ВалютаКомиссииБрокера КАК ВалютаКомиссииБрокера,
		|	_Сделки.ДатаОплатыКомиссииБрокера КАК ДатаОплатыКомиссииБрокера,
		|	_Сделки.moneyCounterpartyId КАК moneyCounterpartyId,
		|	_Сделки.СчетДУ КАК СчетДУ,
		|	ВЫБОР
		|		КОГДА _РанееВыгруженныеСделки.ID ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		КОГДА НЕ _Сделки.id ЕСТЬ NULL
		|				И _Сделки.id ПОДОБНО ""EQ%""
		|				И (ВЫРАЗИТЬ(_Сделки.quantity КАК ЧИСЛО(15, 0))) <> (ВЫРАЗИТЬ(_РанееВыгруженныеСделки.QUANTITY КАК ЧИСЛО(15, 0)))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагВыгрузки,
		|	ВЫБОР
		|		КОГДА _Сделки.id ЕСТЬ NULL
		|			ТОГДА _РанееВыгруженныеСделки.ID
		|	КОНЕЦ КАК ИДСделкиДляУдаления
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РанееВыгруженныеСделки КАК _РанееВыгруженныеСделки
		|		ПО _Сделки.id = _РанееВыгруженныеСделки.ID
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОперацииСЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _УсловияСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Сделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _РанееВыгруженныеСделки";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ДатаВыгрузкиНачалоДня", ДатаВыгрузки);
	Запрос.УстановитьПараметр("ДатаВыгрузкиКонецДня", КонецДня(ДатаВыгрузки));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МатрихКод_НКО_НКЦ", ПолучитьМатрихКод(ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ")));
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	// Сделки РЕПО
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК Ссылка,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВидСделки КАК ВидСделки,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК ДатаВремяСделки,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА NULL
		|		ИНАЧЕ УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделки = """"
		|			ТОГДА ВЫБОР
		|					КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом = """"
		|						ТОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Номер
		|					ИНАЧЕ УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|				КОНЕЦ
		|		ИНАЧЕ УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделки
		|	КОНЕЦ КАК НомерПервойЧасти,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Номер + ""-2""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА СделкаРЕПОВтораяЧасть.НомерСделки = """"
		|					ТОГДА УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом + ""-2""
		|				ИНАЧЕ ВЫБОР
		|						КОГДА ПОДСТРОКА(СделкаРЕПОВтораяЧасть.НомерСделки, 1, 15) = ПОДСТРОКА(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерСделки, 1, 15)
		|							ТОГДА СделкаРЕПОВтораяЧасть.НомерСделки + ""-2""
		|						ИНАЧЕ СделкаРЕПОВтораяЧасть.НомерСделки
		|					КОНЕЦ
		|			КОНЕЦ
		|	КОНЕЦ КАК НомерВторойЧасти,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.НомерЗаявки КАК НомерЗаявки,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.МестоХранения КАК МестоХранения,
		|	УсловияСделокРЕПОСрезПоследних.СтавкаРЕПО КАК СтавкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РежимБиржевыхТоргов.Код КАК КодРежимаБиржевыхТоргов,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РасчетныйСчет.Банк.ЮрФизЛицо) КАК Банк,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Брокер КАК Брокер
		|ПОМЕСТИТЬ _СделкиРепо
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ДатаВыгрузкиКонецДня,
		|			Организация = &Организация
		|				И ЧастьСделкиРЕПО = 2
		|				И СделкаРЕПО.Дата < &ДатаВыгрузкиКонецДня) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаВыгрузкиНачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РасчетныйСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПОВтораяЧасть
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = СделкаРЕПОВтораяЧасть.ПерваяЧастьРЕПО
		|			И УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = СделкаРЕПОВтораяЧасть.ЧастьСделкиРЕПО
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаОплаты >= &ДатаВыгрузкиНачалоДня
		|	И УсловияСделокРЕПОСрезПоследних.ДатаПоставки >= &ДатаВыгрузкиНачалоДня
		|	И (НЕ СделкаРЕПОВтораяЧасть.Ссылка ЕСТЬ NULL
		|			ИЛИ УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиРепо.Ссылка КАК Ссылка,
		|	РасходыПоСделкеОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	РасходыПоСделкеОбороты.СуммаОборот КАК Сумма,
		|	ПлановыеДатыОплатСрезПоследних.ДатаОплаты КАК ПлановаяДатаОплаты,
		|	РасходыПоСделкеОбороты.Валюта КАК Валюта
		|ПОМЕСТИТЬ _РасходыПоСделке
		|ИЗ
		|	_СделкиРепо КАК _СделкиРепо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&ДатаВыгрузкиНачалоДня,
		|				&ДатаВыгрузкиКонецДня,
		|				,
		|				Организация = &Организация
		|					И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделкеОбороты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&ДатаВыгрузкиКонецДня,
		|					Организация = &Организация
		|						И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК ПлановыеДатыОплатСрезПоследних
		|			ПО РасходыПоСделкеОбороты.Сделка = ПлановыеДатыОплатСрезПоследних.Основание
		|				И РасходыПоСделкеОбороты.ВидЗадолженности = ПлановыеДатыОплатСрезПоследних.ВидЗадолженности
		|				И РасходыПоСделкеОбороты.Валюта = ПлановыеДатыОплатСрезПоследних.Валюта
		|		ПО _СделкиРепо.Ссылка = РасходыПоСделкеОбороты.Сделка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиРепо.Ссылка КАК СделкаРепо,
		|	_СделкиРепо.ДатаВремяСделки КАК ДатаВремяСделки,
		|	УсловияСделокРЕПО.ДатаИсполнения КАК ДатаВремяИсполненияСделки,
		|	УсловияСделокРЕПО.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделокРЕПО.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокРЕПО.Количество КАК Количество,
		|	УсловияСделокРЕПО.Цена КАК Цена,
		|	УсловияСделокРЕПО.ЦенаКупона КАК ЦенаКупона,
		|	УсловияСделокРЕПО.Сумма + УсловияСделокРЕПО.СуммаКупона + ВЫБОР
		|		КОГДА _СделкиРепо.ВалютаСделки = РасходыПоБрокерскойКомиссии.Валюта
		|			ТОГДА РасходыПоБрокерскойКомиссии.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ + ВЫБОР
		|		КОГДА _СделкиРепо.ВалютаСделки = РасходыПоТорговойКомиссии.Валюта
		|			ТОГДА РасходыПоТорговойКомиссии.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОбщаяСуммаСделки,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1
		|					И _СделкиРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				ИЛИ УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2
		|					И _СделкиРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА -(УсловияСделокРЕПО.Сумма + УсловияСделокРЕПО.СуммаКупона)
		|		ИНАЧЕ УсловияСделокРЕПО.Сумма + УсловияСделокРЕПО.СуммаКупона
		|	КОНЕЦ КАК СуммаСделкиРепо,
		|	_СделкиРепо.ВалютаСделки КАК ВалютаСделки,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ВалютаОплаты = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &Рубль
		|		ИНАЧЕ УсловияСделокРЕПО.ВалютаОплаты
		|	КОНЕЦ КАК ВалютаОплаты,
		|	РасходыПоТорговойКомиссии.ПлановаяДатаОплаты КАК ДатаОплатыТК,
		|	РасходыПоТорговойКомиссии.Сумма КАК ТК,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаТК,
		|	РасходыПоБрокерскойКомиссии.ПлановаяДатаОплаты КАК ДатаОплатыБК,
		|	РасходыПоБрокерскойКомиссии.Сумма КАК БК,
		|	РасходыПоБрокерскойКомиссии.Валюта КАК ВалютаБК,
		|	УсловияСделокРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокРЕПО.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкиРепо.Контрагент КАК Контрагент,
		|	УсловияСделокРЕПО.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо КАК Депозитарий,
		|	_СделкиРепо.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА _СделкиРепо.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				И _СделкиРепо.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА _СделкиРепо.Банк
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК Банк,
		|	ВЫБОР
		|		КОГДА _СделкиРепо.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ""5""
		|		ИНАЧЕ ""1""
		|	КОНЕЦ КАК КодМестаХранения,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1
		|			ТОГДА _СделкиРепо.НомерПервойЧасти
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2
		|			ТОГДА _СделкиРепо.НомерВторойЧасти
		|	КОНЕЦ КАК НомерСделки,
		|	_СделкиРепо.НомерЗаявки КАК НомерЗаявки,
		|	""TR-"" + _СделкиРепо.НомерПервойЧасти КАК НомерТранзакции,
		|	_СделкиРепо.КодСчетаДУ КАК КодСчетаДУ,
		|	_СделкиРепо.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_СделкиРепо.КодРежимаБиржевыхТоргов КАК КодРежимаБиржевыхТоргов,
		|	ВЫБОР
		|		КОГДА УсловияСделокРЕПО.ЧастьСделкиРЕПО = 1
		|					И _СделкиРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|				ИЛИ УсловияСделокРЕПО.ЧастьСделкиРЕПО = 2
		|					И _СделкиРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ""B""
		|		ИНАЧЕ ""S""
		|	КОНЕЦ КАК ВидСделки,
		|	_ЦеныОценки.Цена КАК СтоимостьПереоценки,
		|	ВЫБОР
		|		КОГДА _СделкиРепо.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ""005""
		|		ИНАЧЕ ""004""
		|	КОНЕЦ КАК МестоХраненияЦБ
		|ПОМЕСТИТЬ _УсловияСделок
		|ИЗ
		|	_СделкиРепо КАК _СделкиРепо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ДатаВыгрузкиКонецДня,
		|				Организация = &Организация
		|					И СделкаРЕПО В
		|						(ВЫБРАТЬ
		|							Репо.Ссылка
		|						ИЗ
		|							_СделкиРепо КАК Репо)) КАК УсловияСделокРЕПО
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныОценкиАктивов КАК _ЦеныОценки
