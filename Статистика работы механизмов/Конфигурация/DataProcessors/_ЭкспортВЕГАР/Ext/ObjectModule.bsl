		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагВыгрузки,
		|	ВЫБОР
		|		КОГДА _ОперацииДС.id ЕСТЬ NULL
		|			ТОГДА _РанееВыгруженныеПогашения.ID
		|	КОНЕЦ КАК ИДСделкиДляУдаления,
		|	_ОперацииДС.ФлагОтсутствияОплаты КАК ФлагОтсутствияОплаты
		|ИЗ
		|	_ОперацииДС КАК _ОперацииДС
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РанееВыгруженныеПогашения КАК _РанееВыгруженныеПогашения
		|		ПО _ОперацииДС.id = _РанееВыгруженныеПогашения.ID
		|			И _ОперацииДС.quantity = _РанееВыгруженныеПогашения.QUANTITY
		|			И (ПОДСТРОКА(_ОперацииДС.productCode, 2, 2) = _РанееВыгруженныеПогашения.PRODUCT_CODE)";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("МинусМесяц", ДобавитьМесяц(ДатаВыгрузки, -1));
	Запрос.УстановитьПараметр("ПлюсМесяц", ДобавитьМесяц(ДатаВыгрузки, 1));
	Запрос.УстановитьПараметр("ЗавтраНачалоДня", КонецДня(ДатаВыгрузки) + 1);
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	//Депозиты. К депозитам выгружается закрывающая сделка на дату закрытия (с суммой тело депозита + проценты).
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК КредитныйИнструмент,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток) КАК Сумма
		|ПОМЕСТИТЬ _ЗадолженностьПоКредитнымИнструментам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&ДатаВыгрузкиКонецДня,
		|			Организация = &Организация
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Организация = ЗакрытиеКредитногоИнструмента.Организация
		|			И ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления = ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления
		|			И ЗадолженностиПоДенежнымСредствамОстатки.Основание = ЗакрытиеКредитногоИнструмента.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления,
		|	ЗакрытиеКредитногоИнструмента.КредитныйИнструмент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.Организация, _ЗадолженностьПоКредитнымИнструментам.Организация) КАК Организация,
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СчетДоверительногоУправления, _ЗадолженностьПоКредитнымИнструментам.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент, _ЗадолженностьПоКредитнымИнструментам.КредитныйИнструмент) КАК КредитныйИнструмент,
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаКонечныйОстаток, 0) + ЕСТЬNULL(_ЗадолженностьПоКредитнымИнструментам.Сумма, 0) КАК Сумма
		|ПОМЕСТИТЬ _ДенежныеСредстваВКредитныхИнструментах
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|			&ДатаВыгрузкиНачалоДня,
		|			&ДатаВыгрузкиКонецДня,
		|			День,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
		|				И ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Выданный)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЗадолженностьПоКредитнымИнструментам КАК _ЗадолженностьПоКредитнымИнструментам
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.Организация = _ЗадолженностьПоКредитнымИнструментам.Организация
		|			И ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СчетДоверительногоУправления = _ЗадолженностьПоКредитнымИнструментам.СчетДоверительногоУправления
		|			И ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент = _ЗадолженностьПоКредитнымИнструментам.КредитныйИнструмент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
		|	ВЫБОР
		|		КОГДА ДепозитныеВклады.НомерПодтверждения = """"
		|			ТОГДА ЕСТЬNULL(ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора, """")
		|		ИНАЧЕ ЕСТЬNULL(ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора, """") + ""("" + ДепозитныеВклады.НомерПодтверждения + "")""
		|	КОНЕЦ КАК НомерДоговора,
		|	ВЫРАЗИТЬ(ДепозитныеВклады._НачальныйНоминал КАК ЧИСЛО(19, 4)) КАК Номинал,
		|	ДепозитныеВклады.ДатаРегистрации КАК ДатаРегистрации,
		|	ДепозитныеВклады.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК) КАК Биржевой,
		|	_ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо) КАК ЮрЛицоБанкаДепозитногоВклада,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	_ДенежныеСредстваВКредитныхИнструментах.Сумма КАК Сумма,
		|	_ДенежныеСредстваВКредитныхИнструментах.Сумма = 0 КАК ДепозитЗакрыт
		|ПОМЕСТИТЬ _ДепозитныеВклады
		|ИЗ
		|	_ДенежныеСредстваВКредитныхИнструментах КАК _ДенежныеСредстваВКредитныхИнструментах
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаВыгрузкиНачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|			ПО ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|				И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ПО _ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрих КАК _КодыМатрихКлиентов
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = _КодыМатрихКлиентов.Объект
		|		ПО _ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|	УсловияКредитныхИнструментовСрезПоследних.Действует КАК Действует,
		|	УсловияКредитныхИнструментовСрезПоследних.Реинвестировать КАК Реинвестировать,
		|	УсловияКредитныхИнструментовСрезПоследних.Период КАК Период,
		|	УсловияКредитныхИнструментовСрезПоследних.РасчетныйСчетВозвратаДенежныхСредств.Банк.ЮрФизЛицо КАК ЮрЛицоБанкаВозвратаДС
		|ПОМЕСТИТЬ _УсловияДепозитныхВкладов
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&ДатаВыгрузкиНачалоДня,
		|			Организация = &Организация
		|				И КредитныйИнструмент В
		|					(ВЫБРАТЬ
		|						_ДепозитныеВклады.ДепозитныйВклад
		|					ИЗ
		|						_ДепозитныеВклады КАК _ДепозитныеВклады)
		|				И ДатаНачалаДействияУсловий <= &ДатаВыгрузкиНачалоДня) КАК УсловияКредитныхИнструментовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияДепозитныхВкладов.КредитныйИнструмент КАК КредитныйИнструмент,
		|	_УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	_УсловияДепозитныхВкладов.ДатаПогашения КАК ДатаПогашения,
		|	_УсловияДепозитныхВкладов.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	_УсловияДепозитныхВкладов.Процент КАК Процент,
		|	_УсловияДепозитныхВкладов.Действует КАК Действует,
		|	_УсловияДепозитныхВкладов.ЮрЛицоБанкаВозвратаДС КАК ЮрЛицоБанкаВозвратаДС
		|ПОМЕСТИТЬ _УсловияДепозитныхВкладовАкутальныеНаДатыПериода
		|ИЗ
		|	_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент КАК КредитныйИнструмент,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.Период) КАК Период,
		|			МАКСИМУМ(_УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|		ИЗ
		|			_УсловияДепозитныхВкладов КАК _УсловияДепозитныхВкладов
		|		ГДЕ
		|			_УсловияДепозитныхВкладов.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_УсловияДепозитныхВкладов.КредитныйИнструмент) КАК ВложенныйЗапрос
		|		ПО _УсловияДепозитныхВкладов.КредитныйИнструмент = ВложенныйЗапрос.КредитныйИнструмент
		|			И _УсловияДепозитныхВкладов.Период = ВложенныйЗапрос.Период
		|			И _УсловияДепозитныхВкладов.ДатаНачалаДействияУсловий = ВложенныйЗапрос.ДатаНачалаДействияУсловий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеВклады.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДепозитныеВклады.КодСчета КАК КодСчета,
		|	_ДепозитныеВклады.Клиент КАК Клиент,
		|	_ДепозитныеВклады.ЮрЛицоБанкаДепозитногоВклада КАК ЮрЛицоБанкаДепозитногоВклада,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, _УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ЮрЛицоБанкаВозвратаДС) КАК ЮрЛицоБанкаВозвратаДС,
		|	_ДепозитныеВклады.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ДепозитныеВклады.Биржевой КАК Биржевой,
		|	_ДепозитныеВклады.НомерДоговора КАК НомерДоговора,
		|	_ДепозитныеВклады.Номинал КАК Номинал,
		|	_ДепозитныеВклады.ДатаРегистрации КАК ДатаРегистрации,
		|	_ДепозитныеВклады.Сумма КАК Сумма,
		|	_ДепозитныеВклады.ДепозитЗакрыт КАК ДепозитЗакрыт,
		|	ВЫРАЗИТЬ(_ДепозитныеВклады.ДепозитныйВклад.БанковскийСчет КАК Справочник.БанковскиеСчета).Валюта КАК ВалютаНоминала,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ДатаПогашения КАК ДатаПогашения,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.Процент КАК Процент,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ПериодичностьВыплатыПроцентов = ЗНАЧЕНИЕ(Перечисление.ПериодичностиВыплатыПроцентов.Авансом) КАК ФлагВыплатыПроцентовАвансом,
		|	МИНИМУМ(ДанныеКалендаря.Дата) КАК ПредполагаемаяДатаПогашения
		|ПОМЕСТИТЬ _ДепозитныеВкладыСУсловиями
		|ИЗ
		|	_ДепозитныеВклады КАК _ДепозитныеВклады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _УсловияДепозитныхВкладовАкутальныеНаДатыПериода КАК _УсловияДепозитныхВкладовАкутальныеНаДатыПериода
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаВыгрузкиНачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|			ПО _УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ЮрЛицоБанкаВозвратаДС = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|				И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ПО _ДепозитныеВклады.ДепозитныйВклад = _УсловияДепозитныхВкладовАкутальныеНаДатыПериода.КредитныйИнструмент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ДатаПогашения <= ДанныеКалендаря.Дата)
		|			И (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДепозитныеВклады.СчетДоверительногоУправления,
		|	_ДепозитныеВклады.КодСчета,
		|	_ДепозитныеВклады.Клиент,
		|	_ДепозитныеВклады.ЮрЛицоБанкаДепозитногоВклада,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, _УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ЮрЛицоБанкаВозвратаДС),
		|	_ДепозитныеВклады.ДепозитныйВклад,
		|	_ДепозитныеВклады.Биржевой,
		|	_ДепозитныеВклады.НомерДоговора,
		|	_ДепозитныеВклады.Номинал,
		|	_ДепозитныеВклады.ДатаРегистрации,
		|	_ДепозитныеВклады.Сумма,
		|	_ДепозитныеВклады.ДепозитЗакрыт,
		|	ВЫРАЗИТЬ(_ДепозитныеВклады.ДепозитныйВклад.БанковскийСчет КАК Справочник.БанковскиеСчета).Валюта,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ДатаПогашения,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ДатаНачалаДействияУсловий,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ПериодичностьВыплатыПроцентов,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.Процент,
		|	_УсловияДепозитныхВкладовАкутальныеНаДатыПериода.ПериодичностьВыплатыПроцентов = ЗНАЧЕНИЕ(Перечисление.ПериодичностиВыплатыПроцентов.Авансом)";
	#КонецОбласти
	
	Запрос.Выполнить();
	
	ВыборкаДепозитов = МВТ.Таблицы["_ДепозитныеВкладыСУсловиями"].ПолучитьДанные().Выбрать();
	
	ТаблицаПроцентовПоДепозитам = Новый ТаблицаЗначений;
	
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("КредитныйИнструмент", Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Проценты", Новый ОписаниеТипов("Число"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка"));
	ТаблицаПроцентовПоДепозитам.Колонки.Добавить("ДатаДенежногоПотока", Новый ОписаниеТипов("Дата"));
	
	Пока ВыборкаДепозитов.Следующий() Цикл
		Если Не ВыборкаДепозитов.ДепозитЗакрыт Тогда
			Попытка
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РаботаСКредитнымиИнструментами.ПолучитьПроцентыКредитныхИнструментовПоСчетуДоверительногоУправления(ВыборкаДепозитов.СчетДоверительногоУправления, ВыборкаДепозитов.ДатаПогашения,,,,,ВыборкаДепозитов.ДепозитныйВклад), ТаблицаПроцентовПоДепозитам);
			Исключение
				ЗарегистрироватьУведомление(ОписаниеОшибки(), Истина);
			КонецПопытки;
			
			Если Не ЗначениеЗаполнено(ВыборкаДепозитов.ПериодичностьВыплатыПроцентов) Тогда
				ЗарегистрироватьУведомление("В условиях депозита [" + ВыборкаДепозитов.ДепозитныйВклад + "] не указана периодичность выплаты процентов.", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПроцентовПоДепозитам.КредитныйИнструмент КАК КредитныйИнструмент,
		|	ТаблицаПроцентовПоДепозитам.Проценты КАК Проценты,
		|	ТаблицаПроцентовПоДепозитам.Операция КАК Операция,
		|	ТаблицаПроцентовПоДепозитам.ДатаДенежногоПотока КАК ДатаДенежногоПотока
		|ПОМЕСТИТЬ _ПроцентыПоДепозитнымВкладам
		|ИЗ
		|	&ТаблицаПроцентовПоДепозитам КАК ТаблицаПроцентовПоДепозитам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроцентыПоДепозитнымВкладам.КредитныйИнструмент КАК ДепозитныйВклад,
		|	СУММА(_ПроцентыПоДепозитнымВкладам.Проценты) КАК Сумма
		|ПОМЕСТИТЬ _СтоимостиДепозитовНаДатуПогашения
		|ИЗ
		|	_ПроцентыПоДепозитнымВкладам КАК _ПроцентыПоДепозитнымВкладам
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПроцентыПоДепозитнымВкладам.КредитныйИнструмент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СубъектАналитики КАК СубъектАналитики,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СуммаРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаДепозита,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладуПроценты)
		|				ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СуммаРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПроцентов
		|ПОМЕСТИТЬ _СтоимостиАктивов
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СрезПоследних(
		|			&ДатаВыгрузкиНачалоДня,
		|			Организация = &Организация
		|				И СубъектАналитики В
		|					(ВЫБРАТЬ
		|						_ДепозитныеВклады.ДепозитныйВклад
		|					ИЗ
		|						_ДепозитныеВклады КАК _ДепозитныеВклады)
		|				И ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладуПроценты))) КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СубъектАналитики,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагамСрезПоследних.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Организация КАК Организация,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.Оплата
		|				И ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствам.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.ПриходПроцентовПоКредитномуИнструменту).КредитныйИнструмент
		|	КОНЕЦ КАК Депозит,
		|	ОстаткиДенежныхСредств.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК) КАК Биржевой,
		|	ОстаткиДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
		|	ОстаткиДенежныхСредств.ВидДвижения КАК ВидДвижения,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	СУММА(ОстаткиДенежныхСредств.Сумма * ВЫБОР
		|			КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА -1
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Сумма
		|ПОМЕСТИТЬ _РазмещенияЗакрытияДепозитов
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО ОстаткиДенежныхСредств.Организация = ЗадолженностиПоДенежнымСредствам.Организация
		|			И ОстаткиДенежныхСредств.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредств.Регистратор = ЗадолженностиПоДенежнымСредствам.Регистратор
		|ГДЕ
		|	ОстаткиДенежныхСредств.Организация = &Организация
		|	И (ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладуПроценты))
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.РазмещениеДенежныхСредствНаДепозитномВкладе)
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада)
		|			ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу))
		|	И ОстаткиДенежныхСредств.Период МЕЖДУ &ДатаВыгрузкиНачалоДня И &ДатаВыгрузкиКонецДня
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредств.Организация,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.Оплата
		|				И ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствам.Основание КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиДенежныхСредств.Регистратор КАК Документ.ЗакрытиеКредитногоИнструмента).КредитныйИнструмент
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
