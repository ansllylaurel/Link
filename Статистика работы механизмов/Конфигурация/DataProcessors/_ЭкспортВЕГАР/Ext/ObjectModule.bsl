	#КонецОбласти
	
	Запрос.УстановитьПараметр("Рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	// Операции (вводы/выводы ДС, переводы ДС, начисленные дивиденды, задолженность по сделкам с валютой, поручения на вывод)
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ПереводДенежныхСредств
		|				И ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ""Перевод-2-""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ПереводДенежныхСредств
		|					ТОГДА ""Перевод-""
		|				КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ВыводДенежныхСредств
		|					ТОГДА ВЫБОР
		|							КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаНДФЛ)
		|								ТОГДА ""Вывод-НДФЛ-""
		|							ИНАЧЕ ""Вывод-""
		|						КОНЕЦ
		|				КОГДА ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ВводДенежныхСредств
		|					ТОГДА ""Ввод-""
		|			КОНЕЦ
		|	КОНЕЦ + ОстаткиДенежныхСредств.Регистратор.Номер КАК Номер,
		|	ОстаткиДенежныхСредств.Период КАК Дата,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА -ОстаткиДенежныхСредств.Сумма
		|		ИНАЧЕ ОстаткиДенежныхСредств.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА ""S""
		|		ИНАЧЕ ""B""
		|	КОНЕЦ КАК ВидДвижения,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДУ,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления.КодСчета КАК КодСчета,
		|	ОстаткиДенежныхСредств.РасчетныйСчет.Банк.ЮрФизЛицо КАК ЮрЛицоБанка,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ""001""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ОстаткиДенежныхСредств.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|					ТОГДА ""002""
		|				КОГДА ОстаткиДенежныхСредств.МестоХранения = &РазделFORTS
		|					ТОГДА ""006""
		|				КОГДА ОстаткиДенежныхСредств.МестоХранения = &РазделFX
		|					ТОГДА ""007""
		|				ИНАЧЕ ""003""
		|			КОНЕЦ
		|	КОНЕЦ КАК ЕгарКодМестаХранения
		|ПОМЕСТИТЬ _ДанныеУчетнойСистемы
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Организация = &Организация
		|	И (ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ПереводДенежныхСредств
		|			ИЛИ ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ВыводДенежныхСредств
		|			ИЛИ ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.ВводДенежныхСредств)
		|	И ОстаткиДенежныхСредств.Период МЕЖДУ &ДатаВыгрузкиНачалоДня И &ДатаВыгрузкиКонецДня
		|	И НЕ ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.ИзПути)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.СделкаСВалютой
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Валюта.Наименование + ""-Валюта-""
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.НачислениеДивидендов
		|			ТОГДА КодыЦБ.Код + ""-Дивиденды-""
		|	КОНЕЦ + ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления.КодСчета,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.НачислениеДивидендов
		|			ТОГДА ВЫБОР
		|					КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаОплатыПлановая > &ДатаВыгрузкиКонецДня
		|						ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаОплатыПлановая
		|					ИНАЧЕ &ДатаВыгрузкиКонецДня
		|				КОНЕЦ
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.СделкаСВалютой
		|				И ЗадолженностиПоДенежнымСредствамОстатки.Основание.ОтложенноеИсполнение
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ДатаИсполнения
		|		ИНАЧЕ &ДатаВыгрузкиКонецДня
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
		|		ИНАЧЕ -ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ""B""
		|		ИНАЧЕ ""S""
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления.КодСчета,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.РасчетныйСчет.Банк.ЮрФизЛицо,
