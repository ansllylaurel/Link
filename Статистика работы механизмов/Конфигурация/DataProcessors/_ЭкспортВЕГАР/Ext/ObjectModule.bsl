Перем КодыПифов;

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//	Вид (Строка) - вид подключаемого объекта:
//		|- "ДополнительнаяОбработка"
//		|- "ДополнительныйОтчет"
//		|- "ЗаполнениеОбъекта"
//		|- "ПечатнаяФорма"
//
//	Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//		Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//	Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//	Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//	Информация (Строка) - описание обработки
//
//	Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//		|- Представление (строка) - представление команды конечному пользователю
//		|- Идентификатор (строка) - идентификатор команды
//		|- Использование (строка) - варианты запуска обработки:
//		|	|- "ОткрытиеФормы"          - открыть форму обработки
//		|	|- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//		|	|- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//		|- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//		|	Прим. Имеет смысл только при запуске обработки без открытия формы.
//		|- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//		Печать требуется установить как "ПечатьMXL"
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Экспорт в ЕГАР",
		"2.13.11",
		"",
		Истина);
	
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверкаСоединения_АП55", "Проверка соединения с EGAR (АП55)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверкаСоединения_АП91", "Проверка соединения с EGAR (АП91)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "Удаление_АП55", "Удаление данных из EGAR (АП55)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортОстатков_АП55", "Экспорт остатков (АП55)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортСделок_АП55", "Экспорт сделок (АП55)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОбновитьПараметрыКлиентов_АП55", "Обновить параметры",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОбновитьСписокБумагУдерживаемыхДоПогашения_АП55", "Обновить список бумаг (АП55)",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//	ИдентификаторКоманды - Строка - идентификатор команды
//	ПараметрыОбработки - Структура - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//		элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ТекущаяДатаСеанса())) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДатаВыгрузки = НачалоДня(ТекущаяДата());
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	ЭтотОбъект.ДопСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	// Значение для переменной "Сервер" не должно отличаться от его условия
	Если Прав(ИдентификаторКоманды, СтрДлина("АП91")) = "АП91" Тогда
		Сервер = "АП91";
	ИначеЕсли Прав(ИдентификаторКоманды, СтрДлина("АП55")) = "АП55" Тогда
		Если ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
			Сервер = "АП55";
		Иначе
			Сообщить("Запрещено совершать операции с рабочей базой ЕГАР вне рабочей базы 1С.");
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	ЭкспортСправочника = Ложь;
	ЭкспортОстатков = Ложь;
	ЭкспортСделок = Ложь;
	ОбновлениеПараметров = Ложь;
	ЭкспортБумагУдерживаемыхДоПогашения = Ложь;
	
	// Команда: ПроверкаСоединения
	Если ИдентификаторКоманды = "ПроверкаСоединения" + "_" + Сервер Тогда
		ПроверитьСоединение(Сервер);
		Возврат;
	// Команда: Удаление
	ИначеЕсли ИдентификаторКоманды = "Удаление" + "_" + Сервер Тогда
		УдалитьДанные(Сервер,,); //(Сервер, Соединение, МассивСделок)
		Возврат;
	// Команда: ЭкспортОстатков
	ИначеЕсли ИдентификаторКоманды = "ЭкспортОстатков" + "_" + Сервер Тогда
		ЭкспортСправочника = Истина;
		ЭкспортОстатков = Истина;
	// Команда: ЭкспортСделок
	ИначеЕсли ИдентификаторКоманды = "ЭкспортСделок" + "_" + Сервер Тогда
		ЭкспортСправочника = Истина;
		ЭкспортСделок = Истина;
	// Команда: ОбновитьПараметрыКлиентов_АП55
	ИначеЕсли ИдентификаторКоманды = "ОбновитьПараметрыКлиентов_АП55" Тогда
		ОбновлениеПараметров = Истина;
	// Команда: ОбновитьСписокБумагУдерживаемыхДоПогашения_АП55
	ИначеЕсли ИдентификаторКоманды = "ОбновитьСписокБумагУдерживаемыхДоПогашения_АП55" Тогда
		ЭкспортБумагУдерживаемыхДоПогашения = Истина;
	// Иная команда
	Иначе
		ЗарегистрироватьУведомление("Не найдена команда [" + ИдентификаторКоманды + "]", Истина);
		ОбработатьУведомления(Сервер);
		Возврат;
	КонецЕсли;
	
	Загрузить(Сервер);
КонецПроцедуры

Функция ЭтоРабочийИлиТорговыйДень(НачалоДня)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Календарь КАК Календарь
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата = &НачалоДня
		|	И ДанныеКалендаря.Календарь В (&КалендарьКотировок, ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)) 
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))";
	
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
	
КонецФункции

Процедура Timeout(Секунды)
	КомандаWindows = "Timeout /T " + Строка(Секунды) + " /NoBreak";
	ЗапуститьПриложение(КомандаWindows,, Истина);
КонецПроцедуры

Функция ПолучитьПараметрыПодключения(Сервер, ТолькоSQL = Ложь)
	ПараметрыПодключения = Новый Структура;
	
	Если ТолькоSQL Тогда
		Если Найти(Сервер, "АП91") > 0 Тогда
			СтрокаСоединенияSQL = "Driver={SQL Server};Server=AP91.G1.LAN;UID=link_1C;PWD=12345;Database=ELM_AM";
		ИначеЕсли Найти(Сервер, "АП55") > 0 Тогда
			СтрокаСоединенияSQL = "Driver={SQL Server};Server=AP55.G1.LAN;UID=link_1C;PWD=EGAR_3;Database=ELM_ram";
		КонецЕсли;
	Иначе
		ПараметрыПодключения = РаботаСВнешнимиСистемами.EGAR_ПолучитьПараметрыПодключения(Сервер);
		
		Если ТипЗнч(ПараметрыПодключения) <> Тип("Структура") Тогда
			ЗарегистрироватьУведомление(ПараметрыПодключения, Истина);
			Возврат Неопределено;
		КонецЕсли;
		
		СтрокаСоединенияSQL = ПараметрыПодключения.СтрокаСоединенияSQL;
	КонецЕсли;
	
	СоединениеSQL = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединенияSQL);
	
	Если СоединениеSQL <> Неопределено Тогда
		ПараметрыПодключения.Вставить("СоединениеSQL", СоединениеSQL);
		Возврат ПараметрыПодключения;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Процедура ЗарегистрироватьУведомление(Уведомление, Ошибка = Ложь)
	Если Ошибка Тогда
		Если ДопСвойства.Свойство("Источник") Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Уведомление, ЭтотОбъект.ДопСвойства.Источник);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Уведомление);
		КонецЕсли;
	Иначе
		Если Не ЭтотОбъект.ДопСвойства.Свойство("Уведомления") Тогда
			ЭтотОбъект.ДопСвойства.Вставить("Уведомления", Новый Массив());
		КонецЕсли;
		
		Если ЭтотОбъект.ДопСвойства.Уведомления.Найти(Уведомление) = Неопределено Тогда
			ЭтотОбъект.ДопСвойства.Уведомления.Добавить(Уведомление);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ОтправитьСообщениеОБумагахБезЦен(Портфели, ДатаЦенОценки, Сервер)
	ТекстСообщения = "";
	Для Каждого Портфель Из Портфели Цикл
		ТекстСообщения = ТекстСообщения +
			"<tr>
			|	<td>" + Портфель.Ключ + "</td>
			|<td>";
		Счетчик = 0;
		
		Для Каждого ЦБ Из Портфель.Значение Цикл
			//ТекстСообщения = ТекстСообщения + ЦБ +"; ";
			ТекстСообщения = ТекстСообщения + ?(Портфель.Значение.Найти(ЦБ) = Портфель.Значение.ВГраница(), ЦБ, ЦБ + ";");
			Счетчик = Счетчик + 1;
			Если Счетчик = 10 Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС;
				Счетчик = 0;
			КонецЕсли;
		КонецЦикла;
		ТекстСообщения = ТекстСообщения + "</td>
			|</tr>";
	КонецЦикла;
	
	Если ТекстСообщения <> "" Тогда
		#Область ТекстHTML
		ТекстСообщения =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body  { font: 10pt sans-serif; }
			|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td    { border: 1px solid #CCC085; padding: 5px; }
			|		.caption { font-weight: bolder; font-size: 12px; background: #F4ECC5; }
			|		.message { color: maroon; font-size: 14px; background: #F4ECC5; }
			|	</style>
			|</head>
			|<body>
			|<table cols=""2"">
			|<tr class=""message"">
			|<td colspan=""2"">Перечень ценных бумаг без цен с " + Формат(ДатаЦенОценки, "ДФ=dd.MM.yyyy") + " (УК " + Организация.ЮрФизЛицо.Наименование + ")</td>
			|</tr>
			|<tr class=""caption"">
			|	<td>Портфель (Код счета ДУ)</td>
			|	<td>ЦБ (Код matrix)</td>
			|</tr>"
			+ ТекстСообщения + "</table></body></html>";
 		#КонецОбласти
		
		РеквизитыОповещения = Новый Структура("Организация, Сервер, Текст, Пояснение", ЭтотОбъект.Организация, Сервер, ТекстСообщения, "Отчет о бумагах без цены переоценки.");
		Справочники.Оповещения.СформироватьОповещения("Обработка._ЭкспортВЕГАР", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	КонецЕсли;
КонецФункции

Процедура ОбработатьУведомления(Сервер, Источник = "")
	Если Не ЭтотОбъект.ДопСвойства.Свойство("Уведомления") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопСвойства.Свойство("Источник") Тогда
		Текст = "";
		
		Для Каждого ЭлементМассива Из ЭтотОбъект.ДопСвойства.Уведомления Цикл
			Текст = Текст + ?(Текст = "", "", "<br>") + ЭлементМассива;
		КонецЦикла;
		
		Если Текст <> "" Тогда
			Текст = "<html><head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8""></head><body><a>" + Текст + "</a></body></html>";
			
			РеквизитыОповещения = Новый Структура("Организация, Сервер, Текст, Пояснение", ЭтотОбъект.Организация, Сервер, Текст);
			ПолноеИмяИсточника = "Обработка._ЭкспортВЕГАР" + ?(Не ПустаяСтрока(Источник), "." + Источник, "");
			Справочники.Оповещения.СформироватьОповещения(ПолноеИмяИсточника, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДопСвойства.Уведомления, Символы.ПС));
	КонецЕсли;
	
	ЭтотОбъект.ДопСвойства.Удалить("Уведомления");
КонецПроцедуры

Процедура ПроверитьНаличиеНепроведенныхДокументов(Сервер)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхКОбработке.Текст КАК ТекстПисьма
		|ПОМЕСТИТЬ _ПисьмаКОтправке
		|ИЗ
		|	Справочник.ПакетыДанныхКОбработке КАК ПакетыДанныхКОбработке
		|ГДЕ
		|	ПакетыДанныхКОбработке.ДатаСоздания МЕЖДУ &ДатаВыгрузкиНачалоДня И &ДатаВыгрузкиКонецДня
		|	И ПакетыДанныхКОбработке.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо)
		|	И (ВЫРАЗИТЬ(ПакетыДанныхКОбработке.Тема КАК СТРОКА(100))) = ВЫРАЗИТЬ(&ТемаПисьма КАК СТРОКА(100))
		|	И НЕ ПакетыДанныхКОбработке.ОбработкаОтменена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналОперацийБэкОфиса.Организация.Наименование КАК Организация,
		|	ПРЕДСТАВЛЕНИЕ(ЖурналОперацийБэкОфиса.ВидОперации) КАК ВидОперации,
		|	ЖурналОперацийБэкОфиса.Номер КАК Номер,
		|	ЖурналОперацийБэкОфиса.Сумма КАК Сумма,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	(ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ПереводДенежныхСредств
		|			ИЛИ ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ВводДенежныхСредств
		|			ИЛИ ЖурналОперацийБэкОфиса.Документ ССЫЛКА Документ.ВыводДенежныхСредств)
		|	И ЖурналОперацийБэкОфиса.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументов.Записан)
		|	И ЖурналОперацийБэкОфиса.Дата МЕЖДУ &ДатаВыгрузкиНачалоДня И &ДатаВыгрузкиКонецДня
		|	И ЖурналОперацийБэкОфиса.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ДатаВыгрузкиНачалоДня", ДатаВыгрузки);
	Запрос.УстановитьПараметр("ДатаВыгрузкиКонецДня", КонецДня(ДатаВыгрузки));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТемаПисьма", "ЕГАР(" + Сервер + "). Данные о непроведенных вводах-выводах денежных средств.");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = "";
	
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = ТекстСообщения + ?(ТекстСообщения = "", "", "<br>") + "В 1С " + Выборка.Организация + ", портфель " + Выборка.КодСчетаДУ + ", документ """ + Выборка.ВидОперации + """ № " + Выборка.Номер + " на сумму " + Выборка.Сумма + " находится в состоянии ""ЗАПИСАН""";
	КонецЦикла;
	
	Если ТекстСообщения <> "" Тогда
		
		ТекстСообщения = "<html><head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8""></head><body><a>" + ТекстСообщения + "</a></body></html>";
		
		ПисьмаКОтправке = Запрос.МенеджерВременныхТаблиц.Таблицы["_ПисьмаКОтправке"].ПолучитьДанные().Выгрузить();
		
		Для Каждого Письмо Из ПисьмаКОтправке Цикл
							
			Если СтрНайти(Письмо.ТекстПисьма, ТекстСообщения) > 0 Тогда	
				Возврат;	
			КонецЕсли;
			
		КонецЦикла;
		
		РеквизитыОповещения = Новый Структура("Организация, Сервер, Текст, Пояснение", ЭтотОбъект.Организация, Сервер, ТекстСообщения, "Данные о непроведенных вводах-выводах денежных средств.");
		Справочники.Оповещения.СформироватьОповещения("Обработка._ЭкспортВЕГАР", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	
	КонецЕсли;
		
КонецПроцедуры

Функция ДатаJSON(Дата = Неопределено, Время = Неопределено)
	
	Если Дата = Неопределено Тогда
		Возврат(Формат(Время, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));//ДатаВремя
	Иначе
	    Возврат(Формат(Дата, "ДФ=""гггг-ММ-дд"""));
	КонецЕсли;
	
КонецФункции

Функция ЗаменитьНедопустимыеСимволы(Знач КодКлиента)

	НедопустимыеСимволы = """/\[]:;|=?*<>-";
	НедопустимыеСимволы = НедопустимыеСимволы + Символы.Таб;
	
	Для ПозицияСимвола = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ПроверяемыйСимвол = Сред(НедопустимыеСимволы, ПозицияСимвола, 1);
		КодКлиента = СтрЗаменить(КодКлиента, ПроверяемыйСимвол, "_");
	КонецЦикла;
	
	Возврат КодКлиента;

КонецФункции

Функция ЧислоJSON(Число)
	
	Если Число = 0 Тогда
		Возврат 0;
	Иначе
		Возврат(Формат(Число, "ЧРД=.; ЧГ=0"));
	КонецЕсли;
	
КонецФункции

Функция СформироватьAssetFlows(Выборка)
	id                 = СокрЛП(Выборка.id);
	Обязательство      = Новый Структура();
	МассивОбязательств = Новый Массив;
	НомерОбязательства = 1;
	
	Если СтрНайти(Выборка.Comment, "Сделка") Тогда
		// Обязательство по бумагам
		Обязательство.Вставить("tradeId", id);
		Обязательство.Вставить("id", id + "_" + НомерОбязательства);
		Обязательство.Вставить("type", "PH"); // Для Бумаг
		Обязательство.Вставить("instrumentId", Выборка.instrumentId);
		Обязательство.Вставить("amount", ?(Выборка.side = "B", Формат(Выборка.quantity, "ЧРД=.; ЧГ=0"),-Формат(Выборка.quantity, "ЧРД=.; ЧГ=0"))); // Покупка с "+", продажа с "-"
		Обязательство.Вставить("date", ДатаJSON(Выборка.tradeDate)); // Дата сделки
		Обязательство.Вставить("executionDate", ДатаJSON(Выборка.deliveryDate)); // Дата поставки
		Обязательство.Вставить("isFactual", 1);
		Обязательство.Вставить("counterpartyId", Выборка.counterpartyId);
		Обязательство.Вставить("portfolioId", Выборка.portfolioId);
		МассивОбязательств.Добавить(Обязательство);
		
		// Обязательство по оплате
		Обязательство = Новый Структура();
		НомерОбязательства = НомерОбязательства + 1;
		Обязательство.Вставить("tradeId", id);
		Обязательство.Вставить("id", id + "_" + НомерОбязательства);
		Обязательство.Вставить("type", "CLCM"); // Для денег
		Обязательство.Вставить("currencyCode", Выборка.paymentCurrencyCode);
		Обязательство.Вставить("amount", Формат(Выборка.paymentAssetFlows, "ЧРД=.; ЧГ=0")); // Деньги покупка с "-", продажа с "+"
		Обязательство.Вставить("date", ДатаJSON(Выборка.tradeDate));// Дата сделки
		Обязательство.Вставить("executionDate", ДатаJSON(Выборка.paymentDate));// Дата поставки
		Обязательство.Вставить("isFactual", 1);
		Обязательство.Вставить("counterpartyId", Выборка.moneyCounterpartyId); // Нужно указать счет где хранятся деньги
		Обязательство.Вставить("portfolioId", Выборка.portfolioId); // Клиент
		МассивОбязательств.Добавить(Обязательство);
		
		// Обязательство по комиссии
		Если Выборка.ТорговаяКомиссия <> 0 Тогда
			Обязательство = Новый Структура();
			НомерОбязательства = НомерОбязательства + 1;
			Обязательство.Вставить("tradeId", id);
			Обязательство.Вставить("id", id + "_" + НомерОбязательства);
			Обязательство.Вставить("type", "BRCM"); // Для комиссий
			Обязательство.Вставить("currencyCode", Выборка.ВалютаТорговойКомиссии);
			Обязательство.Вставить("amount", Формат(Выборка.ТорговаяКомиссия, "ЧРД=.; ЧГ=0"));
			Обязательство.Вставить("date", ДатаJSON(Выборка.tradeDate)); // Дата сделки
			Обязательство.Вставить("executionDate", ДатаJSON(Выборка.ДатаОплатыТорговойКомиссии));// Дата оплаты
			Обязательство.Вставить("isFactual", 1);
			Обязательство.Вставить("counterpartyId", Выборка.moneyCounterpartyId); // Нужно указать счет где хранятся деньги
			Обязательство.Вставить("portfolioId", Выборка.portfolioId); // Клиент
			МассивОбязательств.Добавить(Обязательство);
		КонецЕсли;
		
		Если Выборка.КомиссияБрокера <> 0 Тогда
			Обязательство = Новый Структура();
			НомерОбязательства = НомерОбязательства + 1;
			Обязательство.Вставить("tradeId", id);
			Обязательство.Вставить("id", id + "_" + НомерОбязательства);
			Обязательство.Вставить("type", "BRCM"); // Для комиссий
			Обязательство.Вставить("currencyCode", Выборка.ВалютаКомиссииБрокера);
			Обязательство.Вставить("amount", Формат(Выборка.КомиссияБрокера, "ЧРД=.; ЧГ=0"));
			Обязательство.Вставить("date", ДатаJSON(Выборка.tradeDate)); // Дата сделки
			Обязательство.Вставить("executionDate", ДатаJSON(Выборка.ДатаОплатыКомиссииБрокера)); // Дата оплаты
			Обязательство.Вставить("isFactual", 1);
			Обязательство.Вставить("counterpartyId", Выборка.moneyCounterpartyId); //Нужно указать счет где хранятся деньги
			Обязательство.Вставить("portfolioId", Выборка.portfolioId); // Клиент
			МассивОбязательств.Добавить(Обязательство);
		КонецЕсли;
		
		Возврат(МассивОбязательств);
		
	ИначеЕсли СтрНайти(Выборка.Comment, "Депозит") Тогда
		Обязательство.Вставить("tradeId", id);
		Обязательство.Вставить("id", id + "_" + НомерОбязательства);
		Обязательство.Вставить("type", Выборка.assetFlowsType);
		Обязательство.Вставить("currencyCode", Выборка.instrumentId);
		Обязательство.Вставить("amount", Формат(Выборка.СтоимостьДепозитаНаДатуВыгрузки, "ЧРД=.; ЧГ=0; ЧДЦ=0"));
		Обязательство.Вставить("date", ДатаJSON(ДатаВыгрузки));
		Обязательство.Вставить("executionDate", ДатаJSON(ДатаВыгрузки));
		Обязательство.Вставить("isFactual", 1);
		Обязательство.Вставить("counterpartyId", Выборка.counterpartyId);
		Обязательство.Вставить("portfolioId", Выборка.portfolioId);
		МассивОбязательств.Добавить(Обязательство);
		
		// Обязательство к депозиту с суммой резерва под обесценение
		Если Выборка.СуммаРезерва <> 0 Тогда
			Обязательство = Новый Структура();
			НомерОбязательства = НомерОбязательства + 1;
			
			Обязательство.Вставить("tradeId", id);
			Обязательство.Вставить("id", id + "_" + НомерОбязательства);
			Обязательство.Вставить("type", "RES");
			Обязательство.Вставить("currencyCode", Выборка.instrumentId);
			Обязательство.Вставить("amount", Формат(Выборка.СуммаРезерва, "ЧРД=.; ЧГ=0; ЧДЦ=0"));
			Обязательство.Вставить("date", ДатаJSON(ДатаВыгрузки));
			Обязательство.Вставить("executionDate", ДатаJSON(ДатаВыгрузки));
			Обязательство.Вставить("isFactual", 1);
			Обязательство.Вставить("counterpartyId", Выборка.counterpartyId);
			Обязательство.Вставить("portfolioId", Выборка.portfolioId);
			МассивОбязательств.Добавить(Обязательство);
		КонецЕсли;
		
		Если Выборка.ФлагВыплатыПроцентовАвансом Тогда // Выгружаем одно обязательства с суммой номинала и резервом
			Возврат(МассивОбязательств);
		КонецЕсли;
		
		// Здесь формируется пять обязательств к депозиту с суммой процентов начисленных за один день (T+1, ...., T+5)
		ДатаОбязательства = КонецДня(ДатаВыгрузки) + 1;
		ДатаЗакрытияДепозита = НачалоДня(Выборка.expirationDate);
		
		Для Счетчик = 1 По 5 Цикл
			Если ДатаОбязательства > ДатаЗакрытияДепозита Тогда
				Возврат(МассивОбязательств);
			КонецЕсли;
			Обязательство = Новый Структура();
			Обязательство.Вставить("tradeId", id);
			Обязательство.Вставить("id", id + "_T+" + Счетчик);
			Обязательство.Вставить("type", Выборка.assetFlowsType);
			Обязательство.Вставить("currencyCode", Выборка.instrumentId);
			
			// Если дата обязательства перешла в следующий год, а в нем другое количество дней
			Если Год(ДатаОбязательства) = Год(ДатаВыгрузки) Тогда
				Обязательство.Вставить("amount", Формат(Выборка.СуммаПроцентовВДень, "ЧРД=.; ЧГ=0"));
			Иначе
				Обязательство.Вставить("amount", Формат(Выборка.СуммаПроцентовВДень_ТПлюсПять, "ЧРД=.; ЧГ=0"));
			КонецЕсли;
			
			Обязательство.Вставить("date", ДатаJSON(ДатаВыгрузки));
			Обязательство.Вставить("executionDate", ДатаJSON(ДатаОбязательства));
			Обязательство.Вставить("isFactual", 1);
			Обязательство.Вставить("counterpartyId", Выборка.counterpartyId);
			Обязательство.Вставить("portfolioId", Выборка.portfolioId);
			
			ДатаОбязательства = ДатаОбязательства + 86400;
			МассивОбязательств.Добавить(Обязательство);
		КонецЦикла;
		
		Возврат(МассивОбязательств);
	Иначе
		// Формируется обязательство для остатков по ЦБ и ДС. Для депозитов формируется сделка на дату закрытия.
		Если СтрНайти(Выборка.Comment, "ЦБ") Тогда
			Обязательство.Вставить("instrumentId", Выборка.instrumentId);
		Иначе
			Обязательство.Вставить("currencyCode", Выборка.priceCurrencyCode);
		КонецЕсли;
		
		Обязательство.Вставить("amount", Формат(Выборка.quantity, "ЧРД=.; ЧГ=0"));
		Обязательство.Вставить("tradeId", id);
		Обязательство.Вставить("id", id + "_" + НомерОбязательства);
		Обязательство.Вставить("type", Выборка.assetFlowsType);
		Обязательство.Вставить("date", ДатаJSON(Выборка.tradeDate));
		Обязательство.Вставить("executionDate", ДатаJSON(Выборка.paymentDate));
		Обязательство.Вставить("isFactual", 1);
		Обязательство.Вставить("counterpartyId", Выборка.counterpartyId);
		Обязательство.Вставить("portfolioId", Выборка.portfolioId);
		
		МассивОбязательств.Добавить(Обязательство);
		Возврат(МассивОбязательств);
	КонецЕсли;
КонецФункции

Функция СформироватьЗапрос(Выборка)
	Запрос = Новый Структура();
	
	// transactionId нужен для сделок Репо для связки двух частей.
	Если Не ПустаяСтрока(Выборка.transactionId) Тогда
		Запрос.Вставить("transactionId", Выборка.transactionId);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Выборка.tradingFloorId) Тогда
		Запрос.Вставить("tradingFloorId", Выборка.tradingFloorId);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Выборка.productCode) Тогда
		Запрос.Вставить("productCode", Выборка.productCode); //Место хранения ДС
	КонецЕсли;
	
	Если Не ПустаяСтрока(Выборка.tradingModeId) Тогда
		Запрос.Вставить("tradingModeId", Выборка.tradingModeId); //Тип борда (режим торгов)
	КонецЕсли;
	
	Если Не ПустаяСтрока(Выборка.expirationDate) Тогда
		Запрос.Вставить("expirationDate", ДатаJSON(Выборка.expirationDate));//Дата окончания срока депозита, оферта-продажа
	КонецЕсли;
	
	//Для депозитов выгружаем сделку на дату закрытия депозита, если дата выгрузки больше даты закрытия - сообщим об этом. 
	Если Выборка.comment = "loan_ДС" И Выборка.expirationDate < ДатаВыгрузки Тогда
		ЗарегистрироватьУведомление("У клиента [" + Выборка.portfolioId + "] истек срок действия депозита. Закрывающая сделка депозита [" + Выборка.id + "]!");
	КонецЕсли;
	
	Запрос.Вставить("id", СокрЛП(Выборка.id));
	Запрос.Вставить("isBalance", Выборка.isBalance);
	Запрос.Вставить("systemCode", Выборка.systemCode);
	Запрос.Вставить("tradeDate", ДатаJSON(Выборка.tradeDate));
	Запрос.Вставить("tradeDateTime", ДатаJSON(,Выборка.tradeDateTime));//нужно указать время сделки
	Запрос.Вставить("paymentDate", ДатаJSON(Выборка.paymentDate));
	Запрос.Вставить("deliveryDate", ДатаJSON(Выборка.deliveryDate));
	Запрос.Вставить("price", ЧислоJSON(Выборка.price)); // Для Остатков ЦБ - оценочная цена(среденевзвешенная), для Сделок - цена за 1 шт. ЦБ	
	Запрос.Вставить("portfolioId", Выборка.portfolioId); //КодСчетаДУ
	Запрос.Вставить("instrumentId", Выборка.instrumentId);
	Запрос.Вставить("counterpartyId", Выборка.counterpartyId);
	Запрос.Вставить("quantity", Формат(Выборка.quantity, "ЧРД=.; ЧГ=0"));
	Запрос.Вставить("payment", Формат(Выборка.payment, "ЧРД=.; ЧГ=0"));  //Для сделок - полная сумма сделки (сумма сделки + комиссии)
	
	Если Не ПустаяСтрока(Выборка.depositaryId) Тогда
		Запрос.Вставить("depositaryId", Выборка.depositaryId);
	КонецЕсли;
	
	Запрос.Вставить("customerId", ?(КодыПифов.Получить(Выборка.customerId) = Неопределено, Выборка.customerId, КодыПифов.Получить(Выборка.customerId)));
	Запрос.Вставить("paymentCurrencyCode", Выборка.paymentCurrencyCode);
	Запрос.Вставить("priceCurrencyCode", Выборка.priceCurrencyCode);
	Запрос.Вставить("traderId", Выборка.traderId);
	Запрос.Вставить("lastTraderId", Выборка.lastTraderId);
	Запрос.Вставить("legNumber", Выборка.legNumber); //Для РЕПО указываем часть сделки
	Запрос.Вставить("accruedInterest", ЧислоJSON(Выборка.accruedInterest));//НКД 1 шт.
	Запрос.Вставить("dirtyPrice", ЧислоJSON(Выборка.dirtyPrice));
	
	Запрос.Вставить("branchId", ?(КодыПифов.Получить(Выборка.branchId) = Неопределено, Выборка.branchId, КодыПифов.Получить(Выборка.branchId)));
	Запрос.Вставить("scope", Выборка.scope);
	Запрос.Вставить("type", Выборка.type);
	Запрос.Вставить("interestRate", ЧислоJSON(Выборка.interestRate));//Процентная ставка по депозиту
	Запрос.Вставить("settlementType", Выборка.settlementType); //Для сделок - DVP
	Запрос.Вставить("side", Выборка.side);
	Запрос.Вставить("bOStatus", Выборка.bOStatus);
	Запрос.Вставить("operDate", ДатаJSON(ТекущаяДата()));
	Запрос.Вставить("isSkipDetails", Выборка.isSkipDetails);
	Запрос.Вставить("objectType", Выборка.objectType);
	Если Не ПустаяСтрока(Выборка.originId) Тогда
		Запрос.Вставить("originId", Выборка.originId);
	КонецЕсли;
	
	Запрос.Вставить("comment", Выборка.comment);
	Запрос.Вставить("status", "A"); //Статус сделки
	Запрос.Вставить("assetFlows", СформироватьAssetFlows(Выборка));
	
	Если ПустаяСтрока(Выборка.id) Тогда
		ЗарегистрироватьУведомление("В портфеле [" + Выборка.portfolioId + "] присутствует сделка с типом [" + Выборка.type + "] без ID");
	КонецЕсли;
	
	Возврат(Запрос);
КонецФункции

Функция ПолучитьСтрокуJSON(Данные)
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	
	Попытка
		ЗаписатьJSON(ЗаписьJSON, Данные);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Возврат СтрокаJSON;
	Исключение
		Запись = РегистрыСведений.ХранилищеЗначений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Новый УникальныйИдентификатор;
		Запись.ХранилищеЗначения = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9));
		Запись.Комментарий = "Экспорт в ЕГАР. Не удалось записать JSON";
		Запись.Записать();
		
		ЗарегистрироватьУведомление("Не удалось записать JSON" + Символы.ПС + Запись.Идентификатор, Истина);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПолучитьТаблицуВыгруженныхСделок(Соединение, ДанныеДляСтатистики)
	ГоловнаяОрганизация = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Организация.ЮрФизЛицо, ДатаВыгрузки);
	Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
		ЮрЛицоОрганизации = ГоловнаяОрганизация;
	Иначе
		ЮрЛицоОрганизации = Организация.ЮрФизЛицо;
	КонецЕсли;
	
	МатрихКодКомпании = ПолучитьМатрихКод(ЮрЛицоОрганизации);
	
	// Исключение SpotForward по Акциям (EQ), потому что они обрабатываются по группам.
	//	Если исключить сделку из этого запроса, то при выгрузке новых сделок не будет найдено совпадений с существующей,
	//	и новая сделка будет выгружена, затерев прошлую с таким же ID при её наличии.
	// Для соединения со сделками с Терминала (от Перехватчика, "ME#") будет использовано поле ORIGIN_ID.
	// Для сделок из Матрикса SYSTEM_CODE пустой, но по шаблону ID сделки "MX%" мы понимаем, что должен быть SYSTEM_CODE "MX".
	ЗапросSQL =
		"SELECT
		|	CASE
		|		WHEN T.ID LIKE 'MX%'
		|		THEN SUBSTRING(T.ID, CHARINDEX('-', T.ID) + 1, LEN(T.ID) - 5)
		|		ELSE T.ID
		|	END ID,
		|	T.ORIGIN_ID AS ORIGIN_ID,
		|	CASE
		|		WHEN ISNULL(T.SYSTEM_CODE, '') = '' AND T.ID LIKE 'MX%'
		|		THEN 'MX'
		|		ELSE T.SYSTEM_CODE
		|	END AS SYSTEM_CODE,
		|	CAST(T.QUANTITY AS DEC(19, 4)) AS QUANTITY,
		|	CAST(T.PRICE AS DEC(19, 10)) AS PRICE,
		|	T.PRODUCT_CODE AS PRODUCT_CODE,
		|	CASE
		|		WHEN T.COMMENT IS NULL
		|		THEN CASE
		|			WHEN T.[TYPE] = 'REP'
		|			THEN 'СделкаРепо'
		|			ELSE 'Сделка'
		|		END
		|		ELSE T.COMMENT
		|	END COMMENT
		|FROM [LZ_TRADES] AS T
		|	LEFT JOIN [LZ_PORTFOLIOS] AS P ON T.PORTFOLIO_ID = P.ID
		|	LEFT JOIN [LZ_COUNTERPARTIES] AS C ON P.COUNTERPARTY_ID = C.ID
		|	LEFT JOIN [LZ_INSTRUMENTS] AS I ON T.INSTRUMENT_ID = I.ID
		|-- Перехватчик пока ещё выдаёт сделки ""ME#"" с указанием компании ""Регион Траст""
		|WHERE (C.EXTERNAL_ID = '" + МатрихКодКомпании + "' OR C.EXTERNAL_ID = 220007)
		|	AND (T.ID LIKE 'MX%' OR T.SYSTEM_CODE IN ('ME', '1C'))
		|	AND NOT (I.[TYPE] = 'EQ' AND T.[TYPE] = 'SPF' AND T.SYSTEM_CODE = 'ME')";
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("ORIGIN_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТипыКолонок.Вставить("SYSTEM_CODE", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	ТипыКолонок.Вставить("QUANTITY", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("PRICE", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("PRODUCT_CODE", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	ТипыКолонок.Вставить("COMMENT", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	
	СтартЗапуска = ТекущаяДатаСеанса();
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение.СоединениеSQL, ЗапросSQL);
	
	Если НаборЗаписей = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		ТаблицаСделок = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
		
		Если ТаблицаСделок = Неопределено Тогда
			ТаблицаСделок = Новый ТаблицаЗначений;
			ТаблицаСделок.Колонки.Добавить("ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)), "ID");
			ТаблицаСделок.Колонки.Добавить("ORIGIN_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)), "ORIGIN_ID");
			ТаблицаСделок.Колонки.Добавить("SYSTEM_CODE", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)), "SYSTEM_CODE");
			ТаблицаСделок.Колонки.Добавить("QUANTITY", Новый ОписаниеТипов("Число"), "QUANTITY");
			ТаблицаСделок.Колонки.Добавить("PRICE", Новый ОписаниеТипов("Число"), "PRICE");
			ТаблицаСделок.Колонки.Добавить("PRODUCT_CODE", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)), "PRODUCT_CODE");
			ТаблицаСделок.Колонки.Добавить("COMMENT", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)), "COMMENT");
		КонецЕсли;
		
		ДанныеДляСтатистики.Вставить("SQL_ЗапросКЕгару_Операции", "Время выполнения запроса: "
			+ РассчитатьВремя(СтартЗапуска) + ". Количество записей: " + Строка(ТаблицаСделок.Количество()) + ".");
		
		Возврат ТаблицаСделок;
	КонецЕсли;
КонецФункции

Функция ПолучитьМатрихКод(ЮрЛицо)
	Отбор = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Объект",
		Справочники.ВнешниеСистемы.Матрих, Справочники.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица, ЮрЛицо);
	ЗаписьРегистра = РегистрыСведений.КодыВоВнешнихСистемах.СрезПоследних(ДатаВыгрузки, Отбор);
	Возврат ЗаписьРегистра[0].Код;
КонецФункции

Функция ПолучитьМенеджерВременныхТаблиц(РанееВыгруженныеОперации, ДанныеДляСтатистики)
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &МинусДваРабочихДня И &ДатаВыгрузкиНачалоДня
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("ДатаВыгрузкиНачалоДня", ДатаВыгрузки);
	Запрос.УстановитьПараметр("МинусДваРабочихДня", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаВыгрузки, -3));
	Запрос.Выполнить();

#Область СТОИМОСТЬ_ПЕРЕОЦЕНКИ
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Организация КАК Организация,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СтоимостьПереоценки.Сумма КАК Сумма,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.Количество КАК Количество 
		|ПОМЕСТИТЬ _СтоимостьПереоценки
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ПО _ДанныеКалендаря.Дата = СтоимостьПереоценки.Период
		|			И (СтоимостьПереоценки.Организация = &Организация)
		|			И (СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки))
		|			И (СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)))";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СтартЗапуска = ТекущаяДатаСеанса();
	Запрос.Выполнить();
	ДанныеДляСтатистики.Вставить("ЗапросПолученияЦенСтоимостиПереоценки", "Время выполнения запроса: " + РассчитатьВремя(СтартЗапуска) + ". Количество записей: " + МВТ.Таблицы["_СтоимостьПереоценки"].ПолучитьДанные().Выбрать().Количество());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СобственныйПортфель
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, Клиент = &ЮрЛицоОрганизации) КАК КлиентыДоверительногоУправленияСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьПереоценки.Организация КАК Организация,
		|	_СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СтоимостьПереоценки.Период КАК Дата,
		|	_СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_СтоимостьПереоценки.Рынок КАК Рынок,
		|	_СтоимостьПереоценки.Сумма КАК Сумма,
		|	_СтоимостьПереоценки.Цена КАК Цена,
		|	_СтоимостьПереоценки.Количество КАК Количество
		|ПОМЕСТИТЬ _СтоимостьАктивовСобственногоПортфеля
		|ИЗ
		|	_СтоимостьПереоценки КАК _СтоимостьПереоценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СобственныйПортфель КАК _СобственныйПортфель
		|		ПО _СтоимостьПереоценки.СчетДоверительногоУправления = _СобственныйПортфель.СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", Организация.ЮрФизЛицо);
	Запрос.Выполнить();
	
	Если МВТ.Таблицы["_СтоимостьАктивовСобственногоПортфеля"].ПолучитьДанные().Выбрать().Количество() = 0 Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценкиСрезПоследних.Организация,
			|	СтоимостьПереоценкиСрезПоследних.СчетДоверительногоУправления,
			|	СтоимостьПереоценкиСрезПоследних.Период,
			|	СтоимостьПереоценкиСрезПоследних.ЦеннаяБумага,
			|	СтоимостьПереоценкиСрезПоследних.Рынок КАК Рынок,
			|	СтоимостьПереоценкиСрезПоследних.Сумма КАК Сумма,
			|	СтоимостьПереоценкиСрезПоследних.Цена КАК Цена,
			|	СтоимостьПереоценкиСрезПоследних.Количество КАК Количество
			|ПОМЕСТИТЬ _СтоимостьАктивовСобственногоПортфеляСрезПоследних
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки.СрезПоследних(
			|			&ДатаВыгрузкиНачалоДня,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СобственныйПортфель.СчетДоверительногоУправления
			|					ИЗ
			|						_СобственныйПортфель)
			|				И ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
			|				И ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))) КАК СтоимостьПереоценкиСрезПоследних";
		
		СтартЗапуска = ТекущаяДатаСеанса();
		Запрос.Выполнить();
		ДанныеДляСтатистики.Вставить("ЗапросПолученияЦенСтоимостиПереоценкиСобственногоПортфеля", "Время выполнения запроса: " + РассчитатьВремя(СтартЗапуска) + ". Количество записей: " + МВТ.Таблицы["_СтоимостьАктивовСобственногоПортфеляСрезПоследних"].ПолучитьДанные().Выбрать().Количество());
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Организация КАК Организация,
			|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВложенныйЗапрос.Период КАК Дата,
			|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА ВложенныйЗапрос.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА СРЕДНЕЕ(ВложенныйЗапрос.Сумма)
			|		ИНАЧЕ ВЫБОР
			|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Цена) > 1
			|					ТОГДА СУММА(ВложенныйЗапрос.Сумма) / СУММА(ВложенныйЗапрос.Количество)
			|				ИНАЧЕ СРЕДНЕЕ(ВложенныйЗапрос.Цена)
			|			КОНЕЦ
			|	КОНЕЦ КАК Цена
			|ПОМЕСТИТЬ _ЦеныОценки
			|ИЗ
			|	(ВЫБРАТЬ
			|		_СтоимостьПереоценки.Организация КАК Организация,
			|		_СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_СтоимостьПереоценки.Период КАК Период,
			|		_СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|		_СтоимостьПереоценки.Рынок КАК Рынок,
			|		_СтоимостьПереоценки.Сумма КАК Сумма,
			|		_СтоимостьПереоценки.Цена КАК Цена,
			|		_СтоимостьПереоценки.Количество КАК Количество
			|	ИЗ
			|		_СтоимостьПереоценки КАК _СтоимостьПереоценки
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Организация,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.СчетДоверительногоУправления,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Период,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.ЦеннаяБумага,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Рынок,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Сумма,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Цена,
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних.Количество
			|	ИЗ
			|		_СтоимостьАктивовСобственногоПортфеляСрезПоследних КАК _СтоимостьАктивовСобственногоПортфеляСрезПоследних) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Организация,
			|	ВложенныйЗапрос.СчетДоверительногоУправления,
			|	ВложенныйЗапрос.Период,
			|	ВложенныйЗапрос.ЦеннаяБумага,
			|	ВложенныйЗапрос.Рынок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СобственныйПортфель
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СтоимостьАктивовСобственногоПортфеля
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СтоимостьАктивовСобственногоПортфеляСрезПоследних";
		
		Запрос.Выполнить();
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СтоимостьПереоценки.Организация КАК Организация,
			|	_СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_СтоимостьПереоценки.Период КАК Дата,
			|	_СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА _СтоимостьПереоценки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
			|			ТОГДА СРЕДНЕЕ(_СтоимостьПереоценки.Сумма)
			|		ИНАЧЕ ВЫБОР
			|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СтоимостьПереоценки.Цена) > 1
			|					ТОГДА СУММА(_СтоимостьПереоценки.Сумма) / СУММА(_СтоимостьПереоценки.Количество)
			|				ИНАЧЕ СРЕДНЕЕ(_СтоимостьПереоценки.Цена)
			|			КОНЕЦ
			|	КОНЕЦ КАК Цена
			|ПОМЕСТИТЬ _ЦеныОценки
			|ИЗ
			|	_СтоимостьПереоценки КАК _СтоимостьПереоценки
			|
			|СГРУППИРОВАТЬ ПО
			|	_СтоимостьПереоценки.Организация,
			|	_СтоимостьПереоценки.СчетДоверительногоУправления,
			|	_СтоимостьПереоценки.Период,
			|	_СтоимостьПереоценки.ЦеннаяБумага,
			|	_СтоимостьПереоценки.Рынок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _СтоимостьАктивовСобственногоПортфеля";
		
		Запрос.Выполнить();
	КонецЕсли;
#КонецОбласти
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РанееВыгруженныеОперации.ID КАК ID,
		|	РанееВыгруженныеОперации.ORIGIN_ID КАК ORIGIN_ID,
		|	РанееВыгруженныеОперации.SYSTEM_CODE КАК SYSTEM_CODE,
		|	РанееВыгруженныеОперации.QUANTITY КАК QUANTITY,
		|	РанееВыгруженныеОперации.PRICE КАК PRICE,
		|	РанееВыгруженныеОперации.PRODUCT_CODE КАК PRODUCT_CODE,
		|	РанееВыгруженныеОперации.COMMENT КАК COMMENT
		|ПОМЕСТИТЬ _РанееВыгруженныеОперации
		|ИЗ
		|	&РанееВыгруженныеОперации КАК РанееВыгруженныеОперации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ДанныеКалендаря.Дата) КАК Дата
		|ПОМЕСТИТЬ _МинусДваРабочихДня
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Паи.Ссылка КАК ПайСсылка,
		|	ФинансовыеПоказателиСрезПоследних.Значение КАК СтоимостьПая
		|ПОМЕСТИТЬ _ФинПоказателиПаев
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели.СрезПоследних(&ДатаВыгрузкиНачалоДня, ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая)) КАК ФинансовыеПоказателиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = Паи.ПаевойИнвестиционныйФонд
		|		ПО ФинансовыеПоказателиСрезПоследних.СубъектАналитики = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ФинансовыеПоказателиСрезПоследних.Значение <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦеныОценки.Дата КАК Дата,
		|	_ЦеныОценки.Организация КАК Организация,
		|	_ЦеныОценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦеныОценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_ФинПоказателиПаев.СтоимостьПая, _ЦеныОценки.Цена) КАК Цена
		|ПОМЕСТИТЬ _ЦеныОценкиАктивов
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЦеныОценки.Организация КАК Организация,
		|		_ЦеныОценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МАКСИМУМ(_ЦеныОценки.Дата) КАК Дата,
		|		_ЦеныОценки.ЦеннаяБумага КАК ЦеннаяБумага
		|	ИЗ
		|		_ЦеныОценки КАК _ЦеныОценки
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ЦеныОценки.Организация,
		|		_ЦеныОценки.СчетДоверительногоУправления,
		|		_ЦеныОценки.ЦеннаяБумага) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЦеныОценки КАК _ЦеныОценки
		|		ПО ВложенныйЗапрос.Организация = _ЦеныОценки.Организация
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _ЦеныОценки.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.ЦеннаяБумага = _ЦеныОценки.ЦеннаяБумага
		|			И ВложенныйЗапрос.Дата = _ЦеныОценки.Дата
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинПоказателиПаев КАК _ФинПоказателиПаев
		|		ПО ВложенныйЗапрос.ЦеннаяБумага = _ФинПоказателиПаев.ПайСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код,
		|	КодыВоВнешнихСистемахСрезПоследних.ГруппаОбъектов КАК ГруппаОбъектов
		|ПОМЕСТИТЬ _КодыМатрих
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&ДатаВыгрузкиНачалоДня,
		|			(ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Валюты)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ДепозитарныеРасписки)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Векселя)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Облигации)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Паи)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПроизводныеФинансовыеИнструменты)
		|				ИЛИ ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ИпотечныеСертификатыУчастия))
		|				И ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Валюты.Ссылка КАК ВалютаСсылка,
		|	ЕСТЬNULL(_КодыМатрих.Код, Валюты.Наименование) КАК МатрихКодВалюты
		|ПОМЕСТИТЬ _Валюты
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыМатрих КАК _КодыМатрих
		|		ПО Валюты.Ссылка = _КодыМатрих.Объект
		|			И (_КодыМатрих.ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Валюты))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДефолтыПоОблигациямСрезПоследних.Период КАК Период,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация
		|ПОМЕСТИТЬ _ДефолтыПоОблигациям
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&ДатаВыгрузкиНачалоДня, ТипДефолта В (ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации), ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты))) КАК ДефолтыПоОблигациямСрезПоследних
		|ГДЕ
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта В (ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт), ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.ТехническийДефолт))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ФинПоказателиПаев
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДанныеКалендаря
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЦеныОценки";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("РанееВыгруженныеОперации", РанееВыгруженныеОперации);
	
	СтартЗапуска = ТекущаяДатаСеанса();
	Запрос.Выполнить();
	ДанныеДляСтатистики.Вставить("ЗапросПолученияКодовМатрикс", "Время выполнения запроса: " + РассчитатьВремя(СтартЗапуска) + ".");
	
	Возврат МВТ;
КонецФункции

Процедура ОбработатьРезультатЗапроса(Выборка, СделкиДляВыгрузки, СделкиДляУдаления = Неопределено, Сервер = Неопределено)
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДатаЦенОценки = Неопределено;
	БумагиБезЦенОценки = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		ПортфельКлюч = "Портфель_" + ЗаменитьНедопустимыеСимволы(Выборка.portfolioId);
		
		// Не у всех выборок есть это поле, поэтому пока что через исключение
		СравнениеСДругойСистемой = Ложь;
		Попытка
			СравнениеСДругойСистемой = Выборка.СравнениеСДругойСистемой;
		Исключение
		КонецПопытки;
		
		// Исключаем ранее выгруженные сделки. Формируем массив сделок для удаления.
		//	Если ранее выгруженная сделка из 1С, то нет смысла её удалять, ведь всё равно создадим такую же.
		Сообщить("Информация о сделке: id = " + Выборка.id + "; Выборка.ФлагВыгрузки = " + Выборка.ФлагВыгрузки
			+ "; СравнениеСДругойСистемой = " + СравнениеСДругойСистемой + "; Выборка.ИДСделкиДляУдаления = " + Выборка.ИДСделкиДляУдаления
			+ "; ORIGIN_ID = " + Выборка.originId + " (" + Строка(ТипЗнч(Выборка.originId)) + ")");
		Если Выборка.originId <> "" Тогда
			Попытка
				Сообщить("РанееID: " + Выборка.РанееID + "; РанееSYSTEM_CODE: " + Выборка.РанееSYSTEM_CODE + "; РанееORIGIN_ID: " + Выборка.РанееORIGIN_ID);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если Не Выборка.ФлагВыгрузки Или СравнениеСДругойСистемой Тогда
			Если Выборка.ИДСделкиДляУдаления <> NULL Тогда
				СделкиДляУдаления.Добавить(СокрЛП(Выборка.ИДСделкиДляУдаления));
				Сообщить("Обработка сделки """ + Выборка.id + """. Будет удалена сделка: " + СокрЛП(Выборка.ИДСделкиДляУдаления));
			КонецЕсли;
		КонецЕсли;
		
		// Если нужно только удалить, то переходим к следующей сделке
		Если Не Выборка.ФлагВыгрузки Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.comment = "ПогашениеДС" И Выборка.ФлагОтсутствияОплаты Тогда
			ЗарегистрироватьУведомление("У клиента [" + Выборка.portfolioId + "] отсутствует оплата НКД по бумаге ["
				+ Выборка.МатрихКодЦБ +"]. Прошло более 3 дней от ожидаемой даты оплаты!");
		КонецЕсли;
		
		// Для НПФов проверяем наличие бумаг без цен оценки
		Если Выборка.comment = "ОстатокЦБ" И Выборка.СообщитьОбОтсутствииЦены Тогда
			ДатаЦенОценки = Выборка.ДатаЦенОценки;
			
			Если Не БумагиБезЦенОценки.Свойство(ПортфельКлюч) Тогда
				БумагиБезЦенОценки.Вставить(ПортфельКлюч, Новый Массив());
			КонецЕсли;
			
			БумагиБезЦенОценки[ПортфельКлюч].Добавить(Выборка.instrumentId);
		КонецЕсли;
		
		Если ПустаяСтрока(Выборка.id) Тогда
			Если Час(ТекущаяДата()) < 11 Тогда
				//Такая фигня бывает когда некорректно заведены документы.
				ЗарегистрироватьУведомление("При формировании запроса в ЕГАР обнаружена операция [" + Выборка.comment
					+ "] без ID в портфеле [" + Выборка.portfolioId + "] на сумму [" + Выборка.quantity + "].");
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Если Не СделкиДляВыгрузки.Свойство(ПортфельКлюч) Тогда
			СделкиДляВыгрузки.Вставить(ПортфельКлюч, Новый Массив());
		КонецЕсли;
		
		ЗапросВЕгар = СформироватьЗапрос(Выборка);
		
		Если ЗначениеЗаполнено(ЗапросВЕгар) Тогда
			СделкиДляВыгрузки[ПортфельКлюч].Добавить(ЗапросВЕгар);
			Сообщить("Обработка сделки """ + Выборка.id + """. Будет создана сделка.");
		КонецЕсли;
	КонецЦикла;
	
	Если БумагиБезЦенОценки.Количество() > 0 И ДопСвойства.Свойство("Источник") Тогда
		ОтправитьСообщениеОБумагахБезЦен(БумагиБезЦенОценки, ДатаЦенОценки, Сервер);
	КонецЕсли;
КонецПроцедуры

Процедура СформироватьИВыгрузитьДанныеПоСчетамДУ(ПараметрыПодключения, ДанныеДляСтатистики)
	// Отбор по флагу раннее выгруженных портфелей
	ЗапросSQL =
		"SELECT
		|	LZ_PORTFOLIOS.EXTERNAL_ID,
		|	LZ_PORTFOLIOS.COUNTERPARTY_ID,
		|	COUNTERPARTY_BROKERS.EXTERNAL_ID AS [BROKER],
		|	LZ_PORTFOLIOS.[NAME],
		|	CASE
		|		WHEN LZ_PORTFOLIOS.[NAME] LIKE '%XXXXX%'
		|		THEN 1
		|		ELSE 0
		|	END AS CHANGE,
		|	LZ_PORTFOLIOS.BROKER_CODE,
		|	LZ_PORTFOLIOS.FOREIGN_ALLOWED,
		|	LZ_PORTFOLIOS.REPO_ALLOWED,
		|	LZ_PORTFOLIOS.SPOT_ALLOWED
		|FROM LZ_PORTFOLIOS
		|	LEFT JOIN LZ_COUNTERPARTIES AS COUNTERPARTY_BROKERS
		|	ON LZ_PORTFOLIOS.BROKER_ID = COUNTERPARTY_BROKERS.ID
		|WHERE LZ_PORTFOLIOS.USE_FOR_CONSOLIDATION = 1
		|	AND NOT LZ_PORTFOLIOS.[NAME] LIKE '%Расторгнут%'";
	СтартЗапуска = ТекущаяДатаСеанса();
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(ПараметрыПодключения.СоединениеSQL, ЗапросSQL);
	Если НаборЗаписей = Неопределено Тогда
		Сообщить("Список выгруженных портфелей (LZ_PORTFOLIOS) оказался пустым.");
		Возврат;
	КонецЕсли;
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("EXTERNAL_ID", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
	ТипыКолонок.Вставить("COUNTERPARTY_ID", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("BROKER", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55))); // BROKER_ID -> EXTERNAL_ID
