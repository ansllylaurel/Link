		ВыгруженныеСчетаДУ.Колонки.Добавить("COUNTERPARTY_ID", Новый ОписаниеТипов("Число"), "COUNTERPARTY_ID");
		ВыгруженныеСчетаДУ.Колонки.Добавить("BROKER", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(55)), "BROKER");
		ВыгруженныеСчетаДУ.Колонки.Добавить("NAME", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)), "NAME");
		ВыгруженныеСчетаДУ.Колонки.Добавить("CHANGE", Новый ОписаниеТипов("Булево"), "CHANGE");
		// Поля, не указав которые EGAR LM затрёт их значения у себя, установив значения по умолчанию
