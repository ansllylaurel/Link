		|УНИЧТОЖИТЬ _РанееВыгруженныеВводыВыводыЦБ";
	#КонецОбласти
	
	ОбработатьРезультатЗапроса(Запрос.Выполнить().Выбрать(), СделкиДляВыгрузки, СделкиДляУдаления);
	
	Если СделкиДляУдаления.Количество() > 0 Тогда
		УдалитьДанные( ,ПараметрыПодключения, СделкиДляУдаления);
	КонецЕсли;
	
	КоличествоЗапросовВыгрузки = 0;
	
	Если СделкиДляВыгрузки.Количество() > 0 Тогда
		Для Каждого Портфель Из СделкиДляВыгрузки Цикл
			ТелоЗапросаJSON = ПолучитьСтрокуJSON(Портфель.Значение);
			Если ТелоЗапросаJSON <> Неопределено Тогда
				HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("PUT", ПараметрыПодключения, ПараметрыПодключения.Trades, ТелоЗапросаJSON);
				КоличествоЗапросовВыгрузки = КоличествоЗапросовВыгрузки + Портфель.Значение.Количество();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеДляСтатистики.Вставить("ПроцедураВыгрузкиОстатков", "Время выполнения: " + РассчитатьВремя(СтартЗапуска)
		+ ". Удалено: " + Строка(СделкиДляУдаления.Количество()) + ", загружено: " + Строка(КоличествоЗапросовВыгрузки) + ".");
КонецПроцедуры

Процедура СФормироватьИВыгрузитьДанныеПоСделкам(ПараметрыПодключения, МВТ, ДанныеДляСтатистики)
	СтартЗапуска = ТекущаяДатаСеанса();
	СделкиДляУдаления = Новый Массив;
	СделкиДляВыгрузки = Новый Структура;
	
	// Сделки текущего дня
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				И СделкаДокумент.НомерСделки = """"
		|			ТОГДА ПОДСТРОКА(СделкаДокумент.Номер, 14, 20)
		|		ИНАЧЕ СделкаДокумент.НомерСделки
		|	КОНЕЦ КАК НомерСделки,
		|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаСделки,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ДатаПоставки = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.ДатаПоставки
		|	КОНЕЦ КАК ДатаПоставки,
		|	ВЫБОР
		|		КОГДА ОперацииСЦеннымиБумагами.ДатаОплаты = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ОперацииСЦеннымиБумагами.ДатаОплатыПлановая
		|		ИНАЧЕ ОперацииСЦеннымиБумагами.ДатаОплаты
		|	КОНЕЦ КАК ДатаОплаты,
		|	ВЫБОР
		|		КОГДА СделкаДокумент.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ""B""
		|		ИНАЧЕ ""S""
		|	КОНЕЦ КАК ТипСделки,
		|	ОперацииСЦеннымиБумагами.Количество КАК Количество,
		|	ОперацииСЦеннымиБумагами.Цена КАК Цена,
		|	ОперацииСЦеннымиБумагами.СуммаКупона КАК СуммаКупона,
		|	ОперацииСЦеннымиБумагами.Сумма КАК Сумма,
		|	ОперацииСЦеннымиБумагами.Валюта КАК ВалютаСделки,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	ОперацииСЦеннымиБумагами.Операция КАК ОперацияСсылка,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА ТИПЗНАЧЕНИЯ(ОперацииСЦеннымиБумагами.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ""Облигация""
		|		ИНАЧЕ ""Другое""
		|	КОНЕЦ КАК ТипЦеннойБумаги,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо КАК ДепозитарийЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				И СделкаДокумент.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, СделкаДокумент.РасчетныйСчет.Банк.ЮрФизЛицо)
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ИсполнительДС,
		|	ВЫБОР
		|		КОГДА СделкаДокумент.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА NULL
		|		ИНАЧЕ СделкаДокумент.Контрагент
		|	КОНЕЦ КАК КонтрагентЦБ,
		|	ВЫБОР
		|		КОГДА СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ""5""
		|		ИНАЧЕ ""1""
		|	КОНЕЦ КАК МестоХранения,
		|	РежимыБиржевыхТоргов.Код КАК КодРежимаБиржевыхТоргов,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДУ,
		|	ВЫБОР
		|		КОГДА СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА ""005""
		|		ИНАЧЕ ""004""
		|	КОНЕЦ КАК МестоХраненияЦБ
		|ПОМЕСТИТЬ _ОперацииСЦБ
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК СделкаДокумент
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|			ПО СделкаДокумент.РежимБиржевыхТоргов = РежимыБиржевыхТоргов.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|			ПО СделкаДокумент.Ссылка = СделкаЦенныеБумаги.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаВыгрузкиНачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|			ПО СделкаДокумент.РасчетныйСчет.Банк.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|				И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ПО ОперацииСЦеннымиБумагами.Операция = СделкаДокумент.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаВыгрузкиНачалоДня, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И (ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая >= &ДатаВыгрузкиНачалоДня
		|			ИЛИ ОперацииСЦеннымиБумагами.ДатаОплатыПлановая >= &ДатаВыгрузкиНачалоДня)
		|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &ДатаВыгрузкиНачалоДня И &ДатаВыгрузкиКонецДня
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|	УсловияСделокСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПлановыеДатыОплатТорговойКомиссии.ДатаОплаты КАК ДатаОплатыТорговойКомиссии,
		|	ПлановыеДатыОплатБрокерскойКомиссии.ДатаОплаты КАК ДатаОплатыКомиссииБрокера,
		|	РасходыПоБрокерскойКомиссии.Валюта КАК ВалютаКомиссииБрокера,
		|	РасходыПоТорговойКомиссии.Валюта КАК ВалютаТорговойКомиссии,
		|	РасходыПоБрокерскойКомиссии.СуммаОборот КАК КомиссияБрокера,
		|	РасходыПоТорговойКомиссии.СуммаОборот КАК ТорговаяКомиссия,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделокСрезПоследних.ВалютаОплаты КАК ВалютаОплаты
		|ПОМЕСТИТЬ _УсловияСделок
		|ИЗ
		|	_ОперацииСЦБ КАК _ОперацииСЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&ДатаВыгрузкиКонецДня, Организация = &Организация) КАК УсловияСделокСрезПоследних
		|		ПО _ОперацииСЦБ.ОперацияСсылка = УсловияСделокСрезПоследних.Сделка
		|			И _ОперацииСЦБ.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&ДатаВыгрузкиНачалоДня,
		|				,
		|				,
		|				Организация = &Организация
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоБрокерскойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&ДатаВыгрузкиКонецДня,
		|					Организация = &Организация
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК ПлановыеДатыОплатБрокерскойКомиссии
		|			ПО РасходыПоБрокерскойКомиссии.Сделка = ПлановыеДатыОплатБрокерскойКомиссии.Основание
		|				И РасходыПоБрокерскойКомиссии.Валюта = ПлановыеДатыОплатБрокерскойКомиссии.Валюта
		|		ПО _ОперацииСЦБ.ОперацияСсылка = РасходыПоБрокерскойКомиссии.Сделка
		|			И _ОперацииСЦБ.ЦеннаяБумага = РасходыПоБрокерскойКомиссии.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&ДатаВыгрузкиНачалоДня,
		|				,
		|				,
		|				Организация = &Организация
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоТорговойКомиссии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|					&ДатаВыгрузкиКонецДня,
		|					Организация = &Организация
		|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК ПлановыеДатыОплатТорговойКомиссии
		|			ПО РасходыПоТорговойКомиссии.Сделка = ПлановыеДатыОплатТорговойКомиссии.Основание
		|				И РасходыПоТорговойКомиссии.Валюта = ПлановыеДатыОплатТорговойКомиссии.Валюта
		|		ПО _ОперацииСЦБ.ОперацияСсылка = РасходыПоТорговойКомиссии.Сделка
		|			И _ОперацииСЦБ.ЦеннаяБумага = РасходыПоТорговойКомиссии.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(""Сделка"" КАК СТРОКА(15)) КАК comment,
		|	ВЫРАЗИТЬ(_ОперацииСЦБ.НомерСделки КАК СТРОКА(50)) КАК id,
		|	"""" КАК transactionId,
		|	0 КАК isBalance,
		|	""1C"" КАК systemCode,
		|	НАЧАЛОПЕРИОДА(_ОперацииСЦБ.ДатаСделки, ДЕНЬ) КАК tradeDate,
		|	_ОперацииСЦБ.ДатаСделки КАК tradeDateTime,
		|	_ОперацииСЦБ.ДатаОплаты КАК paymentDate,
