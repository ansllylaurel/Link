Процедура КонтрольПарныхКодов(Запрос, Отказ)
	
	КонтрольПарныхКодов = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КонтрольПарныхКодов").ПолучитьДанные().Выгрузить();
	Для Каждого СтрокаКонтрольПарныхКодов Из КонтрольПарныхКодов Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Код вычета " + СтрокаКонтрольПарныхКодов.КодВычет + " не связан с кодом дохода",,,, Отказ);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПакетДанных_Файл()

	Перем Запрос;
	
	ТаблицыЗапроса = Новый Структура;
	
	Отказ = Ложь;
	
	ЗаполнитьВременныеТаблицы(Запрос);
	
	КонтрольПарныхКодов(Запрос, Отказ);
	
	ПакетДанных = ПолучитьСтруктуруИзЗапроса(Запрос, "_Файл");
	ПакетДанных.Вставить("ИмяФайла"	, ПакетДанных.ИдФайл + ".xml");
	ПакетДанных.Вставить("Документ"	, ПолучитьПакетДанных_Документ(Запрос));
	ПакетДанных.Вставить("Отказ"	, Отказ);
	
	ТаблицыЗапроса = "";
	
	Возврат ПакетДанных;
	
КонецФункции

Функция ПолучитьПакетДанных_Документ(Запрос)

	Документ = ПолучитьСтруктуруИзЗапроса(Запрос, "_Документ");
	Документ.Вставить("СвНА"		, ПолучитьПакетДанных_СвНА(Запрос));
	Документ.Вставить("Подписант"	, ПолучитьПакетДанных_Подписант(Запрос));
	Документ.Вставить("НДФЛ_2"		, ПолучитьПакетДанных_НДФЛ_2(Запрос));
	
	Возврат Документ;
	
КонецФункции

Функция ПолучитьПакетДанных_СвНА(Запрос) //Сведения налогового агента
	
	СвНА = ПолучитьСтруктуруИзЗапроса(Запрос, "_СвНА");
	СвНА.Вставить("СвНАЮЛ", ПолучитьСтруктуруИзЗапроса(Запрос, "_СвНАЮЛ"));
	
	Возврат СвНА;
	
КонецФункции

Функция ПолучитьПакетДанных_Подписант(Запрос)
	
	Подписант = Новый Структура("ПрПодп", "1"); 
	Подписант.Вставить("ФИО", ПолучитьСтруктуруИзЗапроса(Запрос, "_ПодписантФИО"));
	
	Возврат Подписант;
	
КонецФункции

Функция ПолучитьПакетДанных_НДФЛ_2(Запрос)

	МассивНДФЛ_2 = Новый Массив;
	
	Таблица_НДФЛ2 =  ПолучитьТаблицуЗапроса(Запрос, "_НДФЛ2");
	Для Каждого Строка_НДФЛ2 Из Таблица_НДФЛ2 Цикл
		Отбор = Новый Структура("ЮрФизЛицо", Строка_НДФЛ2.ЮрФизЛицо);
		
		НДФЛ2 = Новый Структура;
		
		НДФЛ2.Вставить("НомСпр"		, СериализоватьЗначение(Строка_НДФЛ2, "НомСпр", "_НДФЛ2"));
		НДФЛ2.Вставить("НомКорр"	, СериализоватьЗначение(Строка_НДФЛ2, "НомКорр", "_НДФЛ2"));
		НДФЛ2.Вставить("ПолучДох"	, ПолучитьПакетДанных_ПолучДох(Запрос, Отбор));
		НДФЛ2.Вставить("СведДох"	, ПолучитьПакетДанных_СведДох(Запрос, Отбор));
		
		МассивНДФЛ_2.Добавить(НДФЛ2);
	КонецЦикла;
	
	Возврат МассивНДФЛ_2;
	
КонецФункции

Функция ПолучитьПакетДанных_ПолучДох(Запрос, Знач Отбор)
	
	ПолучДох = ПолучитьСтруктуруИзЗапроса(Запрос, "_ПолучДох", Отбор);
	ПолучДох.Вставить("ФИО"		, ПолучитьСтруктуруИзЗапроса(Запрос, "_ПолучДохФИО"		, Отбор));	
	ПолучДох.Вставить("УдЛичнФЛ", ПолучитьСтруктуруИзЗапроса(Запрос, "_ПолучДохУдЛичнФЛ", Отбор));	
	
	Возврат ПолучДох;
	
КонецФункции

Функция ПолучитьПакетДанных_СведДох(Запрос, Знач Отбор)
	
	Массив = Новый Массив;
	
	Таблица_СведДох =  ПолучитьТаблицуЗапроса(Запрос, "_СведДох");
	НайденныеСтроки = Таблица_СведДох.НайтиСтроки(Отбор);
	
	Для Каждого Строка_СведДох Из НайденныеСтроки Цикл
		Отбор.Вставить("Ставка", Строка_СведДох.Ставка);
		
		СведДох = Новый Структура;
		
		СведДох.Вставить("Ставка"		, СериализоватьЗначение(Строка_СведДох, "Ставка", "_СведДох"));
		СведДох.Вставить("СумИтНалПер"	, ПолучитьСтруктуруИзЗапроса(Запрос, "_СумИтНалПер", Отбор));
		СведДох.Вставить("ДохВыч"		, ПолучитьПакетДанных_ДохВыч(Запрос, Отбор));
		
		Отбор.Удалить("Месяц");
		Отбор.Удалить("КодДоход");
		
		Массив.Добавить(СведДох);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ПолучитьПакетДанных_ДохВыч(Запрос, Знач Отбор)
	
	ДохВыч = Новый Структура;
	Массив = Новый Массив;
	
	Таблица_СвСумДох	= ПолучитьТаблицуЗапроса(Запрос, "_СвСумДох"); 
	НайденныеСтроки		= Таблица_СвСумДох.НайтиСтроки(Отбор);
	
	Для Каждого Строка_ДохВыч Из НайденныеСтроки Цикл
		Отбор.Вставить("Месяц"		, Строка_ДохВыч.Месяц);
		Отбор.Вставить("КодДоход"	, Строка_ДохВыч.КодДоход);
		
		СвСумДох = Новый Структура;
		СвСумДох.Вставить("Месяц"		, СериализоватьЗначение(Строка_ДохВыч, "Месяц"	, "_СвСумДох"));
		СвСумДох.Вставить("КодДоход"	, СериализоватьЗначение(Строка_ДохВыч, "КодДоход", "_СвСумДох"));
		СвСумДох.Вставить("СумДоход"	, СериализоватьЗначение(Строка_ДохВыч, "СумДоход", "_СвСумДох"));
		
		СвСумДох.Вставить("СвСумВыч", ПолучитьСтруктуруИзЗапроса(Запрос, "_СвСумВыч", Отбор));

		//Отбор.Удалить("Месяц");
		
		Массив.Добавить(СвСумДох);
	КонецЦикла;
	
	ДохВыч.Вставить("СвСумДох", Массив);
	
	Возврат ДохВыч;
	
КонецФункции

Функция ПолучитьСтруктуруИзЗапроса(Запрос, ИмяТаблицы, Отбор = Неопределено)
	
	Приемник = Новый Структура;
	Источник = ПолучитьТаблицуЗапроса(Запрос, ИмяТаблицы); 
	
	Колонки = Новый Массив;
	
	Для Каждого Колонка Из Источник.Колонки Цикл
		Если Отбор = Неопределено ИЛИ НЕ Отбор.Свойство(Колонка.Имя) Тогда
			Колонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если Отбор = Неопределено Тогда
		Для Каждого Строка_Источник Из Источник Цикл
			Для Каждого Колонка Из Колонки Цикл
				Приемник.Вставить(Колонка, СериализоватьЗначение(Строка_Источник, Колонка, ИмяТаблицы));
			КонецЦикла;
		КонецЦикла;
	Иначе
		НайденныеСтроки = Источник.НайтиСтроки(Отбор);
		Для Каждого Строка_Источник Из НайденныеСтроки Цикл
			Для Каждого Колонка Из Колонки Цикл
				Приемник.Вставить(Колонка, СериализоватьЗначение(Строка_Источник, Колонка, ИмяТаблицы));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Приемник;
	
КонецФункции

Функция СериализоватьЗначение(СтрокаИсточника, ИмяКолонки, ИмяТаблицы)
	
	Значение = СтрокаИсточника[ИмяКолонки];
	
	Если ИмяКолонки = "Месяц" Тогда
		Возврат Прав("0" + Значение, 2); // 3 = "03"
		
	ИначеЕсли ИмяКолонки = "ОКТМО" И ИмяТаблицы = "_СвНА" Тогда
		Возврат Лев(Значение, 8);
		
	ИначеЕсли ИмяКолонки = "ОтчетГод"
		ИЛИ ИмяКолонки = "НомСпр"
		ИЛИ ИмяКолонки = "Ставка" Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0");
		
	ИначеЕсли ИмяКолонки = "НалИсчисл"
		ИЛИ ИмяКолонки = "НалУдерж"
		ИЛИ ИмяКолонки = "АвансПлатФикс"
		ИЛИ ИмяКолонки = "НалПеречисл" 
		ИЛИ ИмяКолонки = "НалУдержЛиш"
		ИЛИ ИмяКолонки = "НалНеУдерж" 
		ИЛИ ИмяКолонки = "СумНалПрибЗач" Тогда
		Возврат Формат(Значение, "ЧДЦ=0; ЧН=0; ЧГ=0");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧН=0.00; ЧГ=0");
		
	Иначе
		Возврат Значение;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуЗапроса(Запрос, ИмяТаблицы)
	
	Если НЕ ТаблицыЗапроса.Свойство(ИмяТаблицы) Тогда
		ТаблицаЗапроса = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы).ПолучитьДанные().Выгрузить();
		ТаблицыЗапроса.Вставить(ИмяТаблицы, ТаблицаЗапроса);
	КонецЕсли;
		
	Возврат ТаблицыЗапроса[ИмяТаблицы];
	
КонецФункции

Функция ПолучитьМассивИзЗапроса(Запрос, ИмяТаблицы)
	
	Массив = Новый Массив;
	Массив.Добавить(ПолучитьСтруктуруИзЗапроса(Запрос, ИмяТаблицы));
	
	Возврат Массив;
	
КонецФункции

#КонецОбласти

#Область Выгрузка_данных

Функция СформироватьXML()
	
	ПакетДанных = ПолучитьПакетДанных_Файл();
	
	Если ПакетДанных.Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ПространстваИмен = "Kontur";
	
	ИмяФайла		 = ПолучитьИмяВременногоФайла("xml");	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	
	МакетXSDСхемы = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Схема");	
	МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип(ПространстваИмен, "Файл");
	
	ПакетДанныхXML = ПреобразоватьЗначениеВXML(ПакетДанных, "Файл", НоваяФабрикаXDTO, ТипОбъектаXDTO);
	
	НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ПакетДанныхXML, "Файл");
	
	ЗаписьXML.Закрыть();
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяФайла, "windows-1251");
	ТекстовыйФайл.ЗаменитьСтроку(2, СтрЗаменить(ТекстовыйФайл.ПолучитьСтроку(2), "xmlns=""Kontur"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ", ""));
	ТекстовыйФайл.Записать(ИмяФайла,"windows-1251");
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла"		, ПакетДанных.ИмяФайла);
	Результат.Вставить("ДвоичныеДанные"	, Новый ДвоичныеДанные(ИмяФайла));
	
	УдалитьФайлы(ИмяФайла);	
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьЗначениеВXML(ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO = "", ЕстьДанные = ЛОЖЬ)
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл
			Если ТипЗнч(ЭлементПакета.Значение) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл
					ЕстьДанныеВПодчиненныхЭлементах = Ложь;
					ЭлементОбъекта = ПреобразоватьЗначениеВXML(ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип, ЕстьДанныеВПодчиненныхЭлементах);
					Если ЕстьДанныеВПодчиненныхЭлементах 
						ИЛИ ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).НижняяГраница > 0 Тогда
						ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ЭлементОбъекта);
					КонецЕсли;
					ЕстьДанные = МАКС(ЕстьДанныеВПодчиненныхЭлементах, ЕстьДанные);
				КонецЦикла;
			ИначеЕсли ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ) <> Неопределено Тогда
				ЕстьДанныеВПодчиненныхЭлементах = Ложь;
				ЭлементОбъекта = ПреобразоватьЗначениеВXML(ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип, ЕстьДанныеВПодчиненныхЭлементах);
				Если ЕстьДанныеВПодчиненныхЭлементах 
					ИЛИ ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).НижняяГраница > 0 Тогда
					ОбъектXDTO[ЭлементПакета.Ключ] = ЭлементОбъекта;
				КонецЕсли;
				ЕстьДанные = МАКС(ЕстьДанныеВПодчиненныхЭлементах, ЕстьДанные);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭтоПримитивныйТип(ПакетДанных) Тогда
		ЕстьДанные	= МАКС(ЗначениеЗаполнено(ПакетДанных), ЕстьДанные);
		Если ТипЗнч(ПакетДанных) = Тип("Null")    Тогда
			ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, "");
		Иначе	
			ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		КонецЕсли;
	Иначе
		ЕстьДанные	= МАКС(ЗначениеЗаполнено(ПакетДанных), ЕстьДанные);
		ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, СериализаторXDTO.XMLСтрока(ПакетДанных));
	КонецЕсли;                                                 
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ЭтоПримитивныйТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Неопределено")
		ИЛИ ТипЗначения = Тип("Null")
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции


#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

