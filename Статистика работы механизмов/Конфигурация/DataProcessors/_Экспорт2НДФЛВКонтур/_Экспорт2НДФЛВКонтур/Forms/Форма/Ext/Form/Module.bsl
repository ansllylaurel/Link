#КонецОбласти

#Область ДопФункции

Процедура ЗаполнитьСписокНалоговыхПериодов()
	
	Элементы.НалоговыйПериод.СписокВыбора.Очистить();
	
	ГодНачала	= Год(Макс(Объект.Организация.ДатаНачалаУчета, Дата(2000,1,1)));
	ТекущийГод	= Год(ТекущаяДата());
	
	Пока ГодНачала <= ТекущийГод Цикл
		Элементы.НалоговыйПериод.СписокВыбора.Вставить(0, ГодНачала, Формат(ГодНачала, "ЧГ=0") + " год");
		ГодНачала = ГодНачала + 1;
	КонецЦикла;
	
	Объект.НалоговыйПериод = ГодНачала - 1;
	
КонецПроцедуры

&НаКлиенте
Функция КаталогУказанВерно()
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Каталог данных"" не заполнено", ЭтаФорма, "КаталогДанных", "Объект");
		Возврат Ложь;
	КонецЕсли;
	
	Каталог = Новый Файл(Объект.КаталогДанных);
	Если НЕ Каталог.Существует() ИЛИ НЕ Каталог.ЭтоКаталог() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно указан каталог данных", ЭтаФорма, "КаталогДанных", "Объект");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ПолучениеДанных

Процедура ЗаполнитьВременныеТаблицы(Запрос)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация"				, Объект.Организация);
	Запрос.УстановитьПараметр("Период"					, Объект.Период);
	Запрос.УстановитьПараметр("ПериодСтрокой"			, Формат(Объект.Период, "ДФ=yyyyMMdd"));
	Запрос.УстановитьПараметр("НалоговыйПериод"			, Объект.НалоговыйПериод);
	Запрос.УстановитьПараметр("КонецНалоговогоПериода"	, Дата(Объект.НалоговыйПериод, 12, 31, 23, 59, 59));
	Запрос.УстановитьПараметр("НачалоНалоговогоПериода"	, Дата(Объект.НалоговыйПериод, 1, 1, 0, 0, 0));
	Запрос.УстановитьПараметр("Подписант"				, Объект.Подписант);
	Запрос.УстановитьПараметр("СписокРасчетов"			, Объект.СписокРасчетов.Выгрузить(Объект.СписокРасчетов.НайтиСтроки(Новый Структура("Отметка", Истина))));
	Запрос.УстановитьПараметр("СписокПайщиков"			, Объект.Пайщики.Выгрузить(Объект.Пайщики.НайтиСтроки(Новый Структура("Отметка", Истина))).ВыгрузитьКолонку("Клиент"));	
	
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СписокВсехРасчетов.Отметка КАК Отметка,
		|	СписокВсехРасчетов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СписокВсехРасчетов.Клиент КАК Клиент
		|ПОМЕСТИТЬ _СписокРасчетов
		|ИЗ
		|	&СписокРасчетов КАК СписокВсехРасчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыДоходовНДФЛ.Ссылка КАК ВидДохода,
		|	ВидыДоходовНДФЛ.ВидВычета КАК ВидВычета
		|ПОМЕСТИТЬ _СвязиКодов
		|ИЗ
		|	Справочник.ВидыДоходовНДФЛ КАК ВидыДоходовНДФЛ
		|ГДЕ
		|	НЕ ВидыДоходовНДФЛ.ВидВычета = ЗНАЧЕНИЕ(Справочник.ВидыВычетовНДФЛ.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БазаНачисленияНДФЛОбороты.ФизЛицо КАК Клиент,
		|	ГОД(БазаНачисленияНДФЛОбороты.ДатаПолученияДохода) КАК Год,
		|	МЕСЯЦ(БазаНачисленияНДФЛОбороты.ДатаПолученияДохода) КАК Месяц,
		|	БазаНачисленияНДФЛОбороты.ВидДоходаВычета КАК ВидДохода,
		|	БазаНачисленияНДФЛОбороты.ВидДоходаВычета.ВидВычета КАК ВидВычета,
		|	ВЫБОР
		|		КОГДА БазаНачисленияНДФЛОбороты.СтавкаНДФЛ = ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка13)
		|			ТОГДА 13
		|		КОГДА БазаНачисленияНДФЛОбороты.СтавкаНДФЛ = ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка15)
		|			ТОГДА 15
		|		КОГДА БазаНачисленияНДФЛОбороты.СтавкаНДФЛ = ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка30)
		|			ТОГДА 30
		|		КОГДА БазаНачисленияНДФЛОбороты.СтавкаНДФЛ = ЗНАЧЕНИЕ(Перечисление.СтавкиНДФЛ.Ставка35)
