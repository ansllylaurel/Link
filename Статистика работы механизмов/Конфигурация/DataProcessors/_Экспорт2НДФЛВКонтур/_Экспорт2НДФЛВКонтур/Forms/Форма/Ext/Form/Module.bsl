#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация		= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	Объект.Период 			= ТекущаяДата();
	
	ЗаполнитьСписокНалоговыхПериодов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область СобытияЭлементов

&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогДанных + ?(Прав(Объект.КаталогДанных, 1) = "\", "", "\"));

КонецПроцедуры

	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Обновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Обновить");
	Попытка
		ОбновитьНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("НалоговыйПериод"	, Объект.НалоговыйПериод);
	Запрос.УстановитьПараметр("Период"			, Объект.Период);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИСТИНА КАК Отметка,
		|	НачисленияНДФЛОбороты.ФизЛицо КАК Клиент,
		|	МАКСИМУМ(НачисленияНДФЛОбороты.Регистратор) КАК РасчетНДФЛ,
		|	НачисленияНДФЛОбороты.Регистратор.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.БазаНачисленияНДФЛ.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Организация = &Организация
		|				И ГОД(ДатаПолученияДохода) = &НалоговыйПериод) КАК НачисленияНДФЛОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	НачисленияНДФЛОбороты.ФизЛицо,
		|	НачисленияНДФЛОбороты.Регистратор.СчетДоверительногоУправления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Клиент
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Объект.СписокРасчетов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//пайщики
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("НалоговыйПериод"	, Объект.НалоговыйПериод);
	Запрос.УстановитьПараметр("КонецНалоговогоПериода"	, Дата(Объект.НалоговыйПериод, 12, 31, 23, 59, 59));
	Запрос.УстановитьПараметр("НачалоНалоговогоПериода"	, Дата(Объект.НалоговыйПериод, 1, 1, 0, 0, 0));
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИСТИНА КАК Отметка,
		|	РаспределениеДоходаПайщикамНачислениеНДФЛ.ПолучательДохода КАК Клиент
		|ИЗ
		|	Документ.РаспределениеДоходаПайщикам.НачислениеНДФЛ КАК РаспределениеДоходаПайщикамНачислениеНДФЛ
		|ГДЕ
		|	ГОД(РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Основание.Дата) = &НалоговыйПериод
		|	И РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Проведен
		|	И РаспределениеДоходаПайщикамНачислениеНДФЛ.Ссылка.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИСТИНА,
		|	ВЫБОР
		|		КОГДА ПогашениеПаев.Пайщик.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА ПогашениеПаев.Пайщик
		|		КОГДА ПогашениеПаев.Владелец.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|			ТОГДА ПогашениеПаев.Владелец
		|	КОНЕЦ
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.ОборотыДтКт(&НачалоНалоговогоПериода, &КонецНалоговогоПериода, Регистратор, СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ЦелевоеФинансированиеИзБюджета), , СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами), , Организация = &Организация) КАК БухгалтерскийУчетОборотыДтКт
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО БухгалтерскийУчетОборотыДтКт.СубконтоДт1 = ЮрФизЛица.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеПаев КАК ПогашениеПаев
		|		ПО БухгалтерскийУчетОборотыДтКт.Регистратор = ПогашениеПаев.Ссылка
		|ГДЕ
		|	НЕ ВЫБОР
		|				КОГДА ПогашениеПаев.Пайщик.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|					ТОГДА ПогашениеПаев.Пайщик
		|				КОГДА ПогашениеПаев.Владелец.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|					ТОГДА ПогашениеПаев.Владелец
		|			КОНЕЦ ЕСТЬ NULL";
	
	Объект.Пайщики.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура Экспорт2НДФЛ(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Экспорт2НДФЛ");
	Попытка
		ВыполнитьЭкспорт2НДФЛ(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт2НДФЛ(ПараметрыСессии)
	
	Если НЕ КаталогУказанВерно() Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Каталог данных не указан или указан неверно");
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.СписокРасчетов.Количество() 
		И НЕ Объект.Пайщики.Количество()	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для выгрузки. Обновите список расчётов/пайщиков ");
		ДобавитьТекстОшибки(ПараметрыСессии, "Нет данных для выгрузки");
		Возврат;
	КонецЕсли;
	
	Результат = СформироватьXML();
	
	Если Результат <> Неопределено Тогда
		Результат.ДвоичныеДанные.Записать(Объект.КаталогДанных + "\" + Результат.ИмяФайла);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл сохранён: " + Объект.КаталогДанных + "\" + Результат.ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

