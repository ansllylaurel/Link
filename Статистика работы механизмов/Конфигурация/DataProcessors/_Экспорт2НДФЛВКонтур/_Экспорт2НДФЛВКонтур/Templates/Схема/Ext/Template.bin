<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="Kontur" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="Kontur" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:complexType  name="Файл">
		<xs:sequence>
			<xs:element name="Документ">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="СвНА">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="СвНАЮЛ">
										<xs:complexType>
											<xs:attribute name="НаимОрг" type="xs:string" use="required" />
											<xs:attribute name="ИННЮЛ" type="xs:string" use="required" />
											<xs:attribute name="КПП" type="xs:string" use="required" />
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="ОКТМО" type="xs:string" use="required" />
								<xs:attribute name="Тлф" type="xs:string" use="required" />
							</xs:complexType>
						</xs:element>
						<xs:element name="Подписант">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ФИО">
										<xs:complexType>
											<xs:attribute name="Фамилия" type="xs:string" use="required" />
											<xs:attribute name="Имя" type="xs:string" use="required" />
											<xs:attribute name="Отчество" type="xs:string" use="required" />
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="ПрПодп" type="xs:string" use="required" />
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" name="НДФЛ-2">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ПолучДох">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="ФИО">
													<xs:complexType>
														<xs:attribute name="Фамилия" type="xs:string" use="required" />
														<xs:attribute name="Имя" type="xs:string" use="required" />
														<xs:attribute name="Отчество" type="xs:string" use="required" />
													</xs:complexType>
												</xs:element>
												<xs:element name="УдЛичнФЛ">
													<xs:complexType>
														<xs:attribute name="КодУдЛичн" type="xs:string" use="required" />
														<xs:attribute name="СерНомДок" type="xs:string" use="required" />
													</xs:complexType>
												</xs:element>
											</xs:sequence>
											<xs:attribute name="Статус" type="xs:string" use="required" />
											<xs:attribute name="ДатаРожд" type="xs:string" use="required" />
											<xs:attribute name="Гражд" type="xs:string" use="required" />
										</xs:complexType>
									</xs:element>
									<xs:element name="СведДох" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="СумИтНалПер">
													<xs:complexType>
														<xs:attribute name="СумДохОбщ" type="xs:string" use="required" />
														<xs:attribute name="НалБаза" type="xs:string" use="required" />
														<xs:attribute name="НалИсчисл" type="xs:string" use="required" />
														<xs:attribute name="НалУдерж" type="xs:string" use="required" />
														<xs:attribute name="АвансПлатФикс" type="xs:string" use="required" />
														<xs:attribute name="НалПеречисл" type="xs:string" use="required" />
														<xs:attribute name="НалУдержЛиш" type="xs:string" use="required" />
														<xs:attribute name="НалНеУдерж" type="xs:string" use="required" />
														<xs:attribute name="СумНалПрибЗач" type="xs:string" use="required" />
													</xs:complexType>
												</xs:element>
												<xs:element minOccurs="0" name="НалВычССИ">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="ПредВычССИ">
																<xs:complexType>
																	<xs:attribute name="КодВычет" type="xs:string" use="required" />
																	<xs:attribute name="СумВычет" type="xs:string" use="required" />
																</xs:complexType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
												<xs:element name="ДохВыч">
													<xs:complexType>
														<xs:sequence>
															<xs:element maxOccurs="unbounded" name="СвСумДох">
																<xs:complexType>
																	<xs:sequence minOccurs="0">
																		<xs:element name="СвСумВыч">
																			<xs:complexType>
																				<xs:attribute name="КодВычет" type="xs:string" use="required" />
																				<xs:attribute name="СумВычет" type="xs:string" use="required" />
																			</xs:complexType>
																		</xs:element>
																	</xs:sequence>
																	<xs:attribute name="Месяц" type="xs:string" use="required" />
																	<xs:attribute name="КодДоход" type="xs:string" use="required" />
																	<xs:attribute name="СумДоход" type="xs:string" use="required" />
																</xs:complexType>
															</xs:element>
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
											<xs:attribute name="Ставка" type="xs:string" use="required" />
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="НомСпр" type="xs:string" use="required" />
								<xs:attribute name="НомКорр" type="xs:string" use="required" />
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="КНД" type="xs:string" use="required" />
					<xs:attribute name="ДатаДок" type="xs:string" use="required" />
					<xs:attribute name="ОтчетГод" type="xs:string" use="required" />
					<xs:attribute name="Признак" type="xs:string" use="required" />
					<xs:attribute name="КодНО" type="xs:string" use="required" />
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ИдФайл" type="xs:string" use="required" />
		<xs:attribute name="ВерсПрог" type="xs:string" use="required" />
		<xs:attribute name="ВерсФорм" type="xs:string" use="required" />
	</xs:complexType>
	<xs:element name="Файл" type="tns:Файл"/>
</xs:schema>