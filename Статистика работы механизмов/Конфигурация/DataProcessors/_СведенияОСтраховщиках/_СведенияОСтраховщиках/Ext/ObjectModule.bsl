
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Экспорт сведений о страховщиках в систему Депокасса.",
		"2.08",
		"",
		Истина);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
    
	// Объявить команду для регламентного исполнения.
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "Экспортировать данные в Депокассу", "Экспорт сведений о страховщиках в систему Депокасса",
		,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
		
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Организация	= ПараметрыКоманды.Организация;           	
	
	// Импортировать данные за последнее число предыдущего месяца
	Дата = ДобавитьМесяц(ТекущаяДата(), -1);
	
	Дата = КонецМесяца(Дата);	
	
	ЭкспортироватьСведенияОСтраховщиках(  ПолучитьСведенияОСтраховщиках( Организация, Дата), Дата);
	
КонецПроцедуры // ВыполнитьКоманду

Процедура ЭкспортироватьСведенияОСтраховщиках(СведенияОСтраховщиках, Период) Экспорт

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата" + Формат(Период, "ггггММддЧЧммсс"), ,,, );

	
	СтрокаПодключения = "DRIVER={SQL Server}; UID=RO123;DATABASE=DCIntegration;Pwd=123; SERVER=ap5";
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаПодключения);
	
	// Синонимы значений перечислений ADODB.Command
	adCmdStoredProc = 4;
	
	adVarChar = 200;
	//adDate = 7;    Нельзя использовать с MSSQL
	adCurrency = 6;
	adDBTimeStamp = 135;
	
	adParamInput = 1;
	
	Если Соединение <> Неопределено Тогда
		
		Для каждого Страховщик из СведенияОСтраховщиках Цикл
			
			Команда = New COMОбъект("ADODB.Command");
			Команда.ActiveConnection = Соединение;
			// не работает Команда.NamedParametes = true;
			Команда.CommandText = "sp_ExternalCallSave_1c_ds";
			Команда.CommandType = adCmdStoredProc;			
		   	// 	@DateLoad datetime
		   	Команда.Parameters.Append (Команда.CreateParameter("@DateLoad", adDBTimeStamp, adParamInput, 0, Дата(Год(Период), Месяц(Период), День(Период))));
		   	//	@InsuranceCompanyAgreementNumber varchar(500) = null 
		   	Команда.Parameters.Append (Команда.CreateParameter("@InsuranceCompanyAgreementNumber", adVarChar, adParamInput, 500, Страховщик.СчетДоверительногоУправления.КодСчета));
			//	@InsuranceReserveOwnFunds money = null
		   	Команда.Parameters.Append (Команда.CreateParameter("@InsuranceReserveOwnFunds", adCurrency, adParamInput, 0, Страховщик.Итого));
		   		
		   	// Команда.Prepared = истина;	   
		   
		  Команда.Execute();  			
		КонецЦикла;
		
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	КонецЕсли;
	 

	
КонецПроцедуры

Функция ПолучитьСведенияОСтраховщиках(Организация, Период) Экспорт
	
	 Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеСтраховщика,
	|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
	|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключенияДоговора,
	|	ЕСТЬNULL(СУММА(ПоказателиРезервы.ЗначениеПоказателя), 0) КАК СтраховыеРезервы,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ЗначенияДополнительныхСведений2.Значение КАК ДАТА)) < &Период
	|			ТОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваВсего.ЗначениеПоказателя, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0) > ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|					ТОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0)
	|				ИНАЧЕ ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|			КОНЕЦ + ЕСТЬNULL(ПоказателиСобственныеСредстваСверхНорматива.ЗначениеПоказателя, 0)
	|	КОНЕЦ КАК СобственныеСредства,
	|	ЕСТЬNULL(СУММА(ПоказателиРезервы.ЗначениеПоказателя), 0) + ЕСТЬNULL(ПоказателиСобственныеСредстваСверхНорматива.ЗначениеПоказателя, 0) + ВЫБОР
	|		КОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0) > ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|			ТОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0)
	|		ИНАЧЕ ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|	КОНЕЦ КАК Итого
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|					&Период,
	|					Организация = &Организация
	|						И ВидПоказателя В (ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюЖизни), ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни))) КАК ПоказателиРезервы
	|			ПО СчетаДоверительногоУправления.Ссылка = ПоказателиРезервы.СчетДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений2
	|			ПО СчетаДоверительногоУправления.Ссылка = ЗначенияДополнительныхСведений2.Объект
	|				И (ЗначенияДополнительныхСведений2.Свойство.Ключ = ""ДатаНачалаКонтроляСтраховыхКомпанийПоПравилам710П"")
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|					&Период,
	|					Организация = &Организация
	|						И ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.НормативныйРазмерМаржиПлатежеспособности)) КАК ПоказателиСобственныеСредстваНорматив
	|			ПО СчетаДоверительногоУправления.Ссылка = ПоказателиСобственныеСредстваНорматив.СчетДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|					&Период,
	|					Организация = &Организация
	|						И ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.МинимальныйРазмерУставногоКапитала)) КАК ПоказателиСобственныеСредстваУставныйКапитал
	|			ПО СчетаДоверительногоУправления.Ссылка = ПоказателиСобственныеСредстваУставныйКапитал.СчетДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|					&Период,
	|					Организация = &Организация
	|						И ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.ПревышенияРазмераСобственныхСредствНадНаибольшимПоказателем)) КАК ПоказателиСобственныеСредстваСверхНорматива
	|			ПО СчетаДоверительногоУправления.Ссылка = ПоказателиСобственныеСредстваСверхНорматива.СчетДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(
	|					&Период,
	|					Организация = &Организация
	|						И ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.ВсегоСобственныхСредств)) КАК ПоказателиСобственныеСредстваВсего
	|			ПО СчетаДоверительногоУправления.Ссылка = ПоказателиСобственныеСредстваВсего.СчетДоверительногоУправления
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|			ПО СчетаДоверительногоУправления.Ссылка = ЗначенияДополнительныхСведений.Объект
	|				И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|ГДЕ
	|	СчетаДоверительногоУправления.Организация = &Организация
	|	И ЗначенияДополнительныхСведений.Значение ЕСТЬ NULL
	|	И НЕ СчетаДоверительногоУправления.Родитель ЕСТЬ NULL
	|	И СчетаДоверительногоУправления.Родитель <> ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
	|	И (СчетаДоверительногоУправления.ДатаРасторжения ЕСТЬ NULL
	|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &Период)
	|	И СчетаДоверительногоУправления.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетаДоверительногоУправления.Ссылка,
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу,
	|	СчетаДоверительногоУправления.КодСчета,
	|	СчетаДоверительногоУправления.ДатаЗаключения,
	|	ПоказателиСобственныеСредстваСверхНорматива.ЗначениеПоказателя,
	|	ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя,
	|	ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ЗначенияДополнительныхСведений2.Значение КАК ДАТА)) < &Период
	|			ТОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваВсего.ЗначениеПоказателя, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0) > ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|					ТОГДА ЕСТЬNULL(ПоказателиСобственныеСредстваУставныйКапитал.ЗначениеПоказателя, 0)
	|				ИНАЧЕ ЕСТЬNULL(ПоказателиСобственныеСредстваНорматив.ЗначениеПоказателя, 0)
	|			КОНЕЦ + ЕСТЬNULL(ПоказателиСобственныеСредстваСверхНорматива.ЗначениеПоказателя, 0)
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СчетаДоверительногоУправления.Ссылка,
	|	ЕСТЬNULL(РеквизитыСтраховщиков.ПолноеНаименованиеПоУставу + "" "" + РеквизитыУправляющихКомпаний.ПолноеНаименованиеПоУставу, СчетаДоверительногоУправления.Наименование),
	|	СчетаДоверительногоУправления.КодСчета,
	|	СчетаДоверительногоУправления.ДатаЗаключения,
	|	СУММА(СтраховыеРезервы.Сумма),
	|	СУММА(СобственныеСредства.Сумма),
	|	ЕСТЬNULL(СУММА(СтраховыеРезервы.Сумма), 0) + ЕСТЬNULL(СУММА(СобственныеСредства.Сумма), 0)
	|ИЗ
	|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|		ПО СчетаДоверительногоУправления.Ссылка = ЗначенияДополнительныхСведений.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Прочее)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
	|		ПО (ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыУправляющихКомпаний
	|			ПО Договоры.Контрагент = РеквизитыУправляющихКомпаний.ЮрФизЛицо
	|		ПО (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = Договоры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
	|		ПО (Договоры.Контрагент = ЮрФизЛица.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСтраховщиков
	|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыСтраховщиков.ЮрФизЛицо
	|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО (ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК Сумма,
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления
	|		ИЗ
	|			РегистрСведений.СтоимостьАктивовСтраховыхКомпаний КАК СтоимостьАктивовСтраховыхКомпанийСрезПоследних
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|				ПО СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Период, ) КАК КурсыВалютСрезПоследних
	|				ПО СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	|		ГДЕ
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Период = &Период
	|			И СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Организация = &Организация
	|			И СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма <> 0
	|			И ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании""
	|			И (ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюЖизни)
	|					ИЛИ ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.РезервыПоСтрахованиюИномуЧемЖизни))) КАК СтраховыеРезервы
	|		ПО СчетаДоверительногоУправления.Ссылка = СтраховыеРезервы.СчетДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК Сумма,
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправления
	|		ИЗ
	|			РегистрСведений.СтоимостьАктивовСтраховыхКомпаний КАК СтоимостьАктивовСтраховыхКомпанийСрезПоследних
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|				ПО СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Период, ) КАК КурсыВалютСрезПоследних
	|				ПО СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	|		ГДЕ
	|			СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Период = &Период
	|			И СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Организация = &Организация
	|			И СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма <> 0
	|			И ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании""
	|			И (ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваВРазмереНорматива)
	|					ИЛИ ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.СобственныеСредстваСверхНорматива))) КАК СобственныеСредства
	|		ПО СчетаДоверительногоУправления.Ссылка = СобственныеСредства.СчетДоверительногоУправления
	|ГДЕ
	|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании""
	|	И ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.ПортфельВДоверительномУправлении)
	|	И (СчетаДоверительногоУправления.ДатаРасторжения ЕСТЬ NULL
	|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &Период)
	|	И СчетаДоверительногоУправления.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетаДоверительногоУправления.Ссылка,
	|	СчетаДоверительногоУправления.КодСчета,
	|	СчетаДоверительногоУправления.ДатаЗаключения,
	|	ЕСТЬNULL(РеквизитыСтраховщиков.ПолноеНаименованиеПоУставу + "" "" + РеквизитыУправляющихКомпаний.ПолноеНаименованиеПоУставу, СчетаДоверительногоУправления.Наименование)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСчета";
	
	
	Запрос.УстановитьПараметр("Период", Период);    	
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;

	
