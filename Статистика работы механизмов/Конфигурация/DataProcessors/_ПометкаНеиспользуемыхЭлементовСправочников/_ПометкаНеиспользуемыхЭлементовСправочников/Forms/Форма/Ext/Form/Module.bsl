&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнитьДействие");
	Попытка
		ВыполнитьВыбранноеДействие(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыбранноеДействие(ПараметрыСессии)

	Если ПометитьНаОснованииФайла Тогда
		ПометитьЭлементыСправочниковНаОснованииФайлаExcel();
	Иначе	
		Если ОтображатьПрогрессВыполнения Тогда
			ПометитьОбъектыНаУдаление();
		Иначе
			ПометитьОбъектыНаУдалениеБезИндикации();	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьОбъектыНаУдалениеБезИндикации()
	
	ИнициализироватьИндикатор(Ложь);
	
	ТабДок = ПометитьНаУдалениеНаСервере(ПараметрыПометки());
	Если ВыводитьОтчет Тогда
		ТабДок.Показать("Результат проверки");
	КонецЕсли;	
	Если СохранятьОтчет Тогда
		ТабДок.Записать(ИмяФайлаОтчета(ТипФайлаТабличногоДокумента.XLSX), ТипФайлаТабличногоДокумента.XLSX);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьОбъектыНаУдаление()
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ИнициализироватьИндикатор(Истина);
	
	ПараметрыПометки  = ПараметрыПометки();
	ДанныеДляПроверки = ДанныеДляПроверки(ПараметрыПометки);
	
	Если ДанныеДляПроверки.ТипыОбъектов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для проверки!");
		Возврат;
	КонецЕсли;
	
	ПомеченныеНаУдаление = ПомеченныеНаУдалениеОбъекты();

	Результат = Новый Структура("ОбъектыБезСсылок", Новый Массив);
	
	ОбщийСчетчик = 0;
	// объекты разных типов проверяются отдельно
	Для Каждого ТипОбъекта Из ДанныеДляПроверки.ТипыОбъектов Цикл
		
		  ПометитьНаУдалениеОбъектыСПроверкойСсылокПоТипу(ТипОбъекта, ДанныеДляПроверки, ПомеченныеНаУдаление, ПараметрыПометки, ОбщийСчетчик, Результат);
		  
	КонецЦикла;
	
	Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000, 0);
	
	ТабДок = ВывестиОтчет(ДанныеДляПроверки.ОбъектыДляПроверки, Результат.ОбъектыБезСсылок, Длительность);
	Если ВыводитьОтчет Тогда
		ТабДок.Показать("Результат проверки");
	КонецЕсли;	
	Если СохранятьОтчет Тогда
		ТабДок.Записать(ИмяФайлаОтчета(ТипФайлаТабличногоДокумента.XLSX), ТипФайлаТабличногоДокумента.XLSX);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаОтчета(ТипФайла)
	
	Если ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда
		Расширение = ".xlsx";
	Иначе
		Расширение = "";
	КонецЕсли;	
	
	ТекДата  = ТекущаяДата();
	ИмяФайла = СтрШаблон("%1\%2_%3_%4_%5%6", КаталогДляОтчета, Формат(ТекДата, "ДФ=yyyy_MM_dd"), Час(ТекДата), Минута(ТекДата), Секунда(ТекДата), Расширение);
	
	Возврат ИмяФайла;
	
КонецФункции

&НаКлиенте
Процедура ИнициализироватьИндикатор(Видимость)
	
	Индикатор = 0;
	Элементы.Индикатор.Видимость = Видимость;
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры	

&НаСервере
Функция ПометитьНаУдалениеНаСервере(ПараметрыПометки)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектыДляПроверки = ОбъектНаСервере.ОбъектыДляПроверки(ПараметрыПометки);
	Результат = ОбъектНаСервере.ПометитьНаУдалениеОбъектыСПроверкойСсылок(ОбъектыДляПроверки, ПараметрыПометки);
	
	Длительность = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000, 0);
	
	Возврат ВывестиОтчет(ОбъектыДляПроверки, Результат.ОбъектыБезСсылок, Длительность);
	
КонецФункции

&НаКлиенте
Функция ПараметрыПометки()
	
	ПараметрыПометки = Новый Структура();
	ПараметрыПометки.Вставить("ПометкаЮрФизЛиц",                   ПометкаЮрФизЛиц);
	ПараметрыПометки.Вставить("ПометкаАкций",                      ПометкаАкций);
	ПараметрыПометки.Вставить("ПометкаОблигаций",                  ПометкаОблигаций);
	ПараметрыПометки.Вставить("ПометкаПаев",                       ПометкаПаев);
	ПараметрыПометки.Вставить("ПометкаЭмитентов",                  ПометкаЭмитентов);
	ПараметрыПометки.Вставить("ПометкаПаевыхИнвестиционныхФондов", ПометкаПаевыхИнвестиционныхФондов);
	ПараметрыПометки.Вставить("НеПомечатьНаУдаление",              НеПомечатьНаУдаление);
	ПараметрыПометки.Вставить("ПроверятьТолькоПомеченные",         ПроверятьТолькоПомеченные);
	ПараметрыПометки.Вставить("РазмерПорции",                      РазмерПорции);
	
	Возврат ПараметрыПометки;
	
КонецФункции	

&НаСервере
Функция ДанныеДляПроверки(ПараметрыПометки)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектыДляПроверки  = ОбъектНаСервере.ОбъектыДляПроверки(ПараметрыПометки);
	ТипыОбъектов        = ОбъектНаСервере.ТипыОбъектовДляПроверки(ОбъектыДляПроверки);
	
	ИсключаемыеРегистрыСВедущимИзмерением = Новый Соответствие;
	Для Каждого ТипОбъекта Из ТипыОбъектов Цикл
		РегистрыСВедущимИзмерением = ОбъектНаСервере.РегистрыСведенийСВедущимИзмерениемПоТипу(ТипОбъекта);
		ИсключаемыеРегистрыСВедущимИзмерением.Вставить(ТипОбъекта, РегистрыСВедущимИзмерением);
	КонецЦикла;	
	
	Возврат Новый Структура("ОбъектыДляПроверки, ТипыОбъектов, РегистрыСВедущимИзмерением, ОбщееКоличество", 
							ПоместитьВоВременноеХранилище(ОбъектыДляПроверки, Новый УникальныйИдентификатор), 
							ТипыОбъектов,
					        ИсключаемыеРегистрыСВедущимИзмерением,
							ОбъектыДляПроверки.Количество());

КонецФункции

&НаСервереБезКонтекста
Функция ВыбратьОбъектыДляПометкиПоТипу(ДанныеДляПометки, ТипОбъекта)
	
	ОбъектыДляПометки = ПолучитьИзВременногоХранилища(ДанныеДляПометки.ОбъектыДляПроверки);
	
	ОбъектыДляПометкиПоТипу = ОбъектыДляПометки.НайтиСтроки(Новый Структура("ТипОбъекта", ТипОбъекта));
	
	СсылкиДляПометкиПоТипу = Новый Массив;
	Для Каждого СтрокаТЗ Из ОбъектыДляПометкиПоТипу Цикл
		СсылкиДляПометкиПоТипу.Добавить(СтрокаТЗ.Ссылка);	
	КонецЦикла;	
	Возврат СсылкиДляПометкиПоТипу;
	
КонецФункции

&НаКлиенте
Процедура ПометитьНаУдалениеОбъектыСПроверкойСсылокПоТипу(ТипОбъекта, ДанныеДляПометки, ПомеченныеОбъекты, ПараметрыПометки, ОбщийСчетчик, Результат) 

	РазмерПорции = ?(ПараметрыПометки.Свойство("РазмерПорции"), ПараметрыПометки.РазмерПорции, 100);;
	
	ОбъектыДляПометкиПоТипу = ВыбратьОбъектыДляПометкиПоТипу(ДанныеДляПометки, ТипОбъекта);
	
	Счетчик = 0;
	СсылкиДляПроверки = Новый Массив;
	Для Каждого ОбъектДляПометки Из ОбъектыДляПометкиПоТипу Цикл
		
		ОбработкаПрерыванияПользователя();
		
		ОбщийСчетчик = ОбщийСчетчик + 1;
		Счетчик = Счетчик + 1;
		СсылкиДляПроверки.Добавить(ОбъектДляПометки);	
		
		Если Счетчик = РазмерПорции Тогда
			ПометитьНеиспользованныеСсылкиСервер(СсылкиДляПроверки, ПомеченныеОбъекты, ДанныеДляПометки, ТипОбъекта, ПараметрыПометки, Результат);
			СсылкиДляПроверки.Очистить();
			ОбновитьПрогрессВыполнения(ОбщийСчетчик, ДанныеДляПометки.ОбщееКоличество);
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	Если СсылкиДляПроверки.Количество() > 0 Тогда
		ПометитьНеиспользованныеСсылкиСервер(СсылкиДляПроверки, ПомеченныеОбъекты, ДанныеДляПометки, ТипОбъекта, ПараметрыПометки, Результат);
	КонецЕсли;	
	ОбновитьПрогрессВыполнения(ОбщийСчетчик, ДанныеДляПометки.ОбщееКоличество);

КонецПроцедуры

&НаСервере
Процедура ПометитьНеиспользованныеСсылкиСервер(СсылкиДляПроверки, ПомеченныеНаУдалениеОбъекты, ДанныеДляПометки, ТипОбъекта, ПараметрыПометки, Результат)
	
	РегистрыСВедущимИзмерением = ДанныеДляПометки.РегистрыСВедущимИзмерением.Получить(ТипОбъекта);
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ПометитьНеиспользованныеСсылки(СсылкиДляПроверки, ПомеченныеНаУдалениеОбъекты, РегистрыСВедущимИзмерением, ПараметрыПометки, Результат)
	
КонецПроцедуры

&НаСервере
Функция ВывестиОтчет(ПроверяемыеОбъекты, ОбъектыБезСсылок, Длительность = 0)
	
	Если ТипЗнч(ПроверяемыеОбъекты) = Тип("ТаблицаЗначений") Тогда
		ВсеОбъекты = ПроверяемыеОбъекты;
	ИначеЕсли ЭтоАдресВременногоХранилища(ПроверяемыеОбъекты) Тогда
		ВсеОбъекты = ПолучитьИзВременногоХранилища(ПроверяемыеОбъекты);
	КонецЕсли;	
	
	ДанныеДляОтчета = ИтоговаяТаблица(ВсеОбъекты, ОбъектыБезСсылок);
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	СКД = ОбъектНаСервере.ПолучитьМакет("СКД");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор)));
	КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый	ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("РезультатПроверки", ДанныеДляОтчета), , Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если Длительность > 0 Тогда
		МакетПодвала  = ОбъектНаСервере.ПолучитьМакет("ПодвалОтчета");	
		ОбластьПодвал = МакетПодвала.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.Длительность       = Длительность;
		ОбластьПодвал.Параметры.КоличествоКПометке = ОбъектыБезСсылок.Количество();
		ТабличныйДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;	
	
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку     = Ложь;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ИтоговаяТаблица(ВсеОбъекты, ОбъектыБезСсылок)
	
	ВсеОбъекты.Колонки.Добавить("МожноУдалить");
	Для Каждого СтрокаТЗ Из ВсеОбъекты Цикл
		Если Не ОбъектыБезСсылок.Найти(СтрокаТЗ.Ссылка) = Неопределено Тогда
			СтрокаТЗ.МожноУдалить = "Да";	
	    КонецЕсли;
	КонецЦикла;	
	
	Возврат ВсеОбъекты;
	
КонецФункции 	

&НаКлиенте
Процедура ОбновитьПрогрессВыполнения(ОбщийСчетчик, ОбщееКоличество)
	
	Индикатор = Окр(?(ОбщееКоличество = 0, 0, ОбщийСчетчик * 100 / ОбщееКоличество), 0);
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПомеченныеНаУдалениеОбъекты()
	
	УстановитьПривилегированныйРежим(Истина);
	ПомеченныеОбъекты = НайтиПомеченныеНаУдаление();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПоместитьВоВременноеХранилище(ПомеченныеОбъекты, Новый УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ПометитьЭлементыСправочниковНаОснованииФайлаExcel()
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор          = Ложь; 
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбораФайла.Фильтр                      = "Файлы Excel|*.xlsx;*.xls";
	ДиалогВыбораФайла.Заголовок                   = "Выберите файл для обработки справочников";	
	
	ДиалогВыбораФайла.Показать(Новый ОписаниеОповещения("ПриВыбореФайла", ЭтаФорма));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореФайла(ВыбранныеФайлы, ДопПараметры) Экспорт
	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ФайлНаДиске = Новый Файл(СокрЛП(ВыбранныеФайлы[0]));
		ЗагрузитьИОбработатьДанныеФайла(ФайлНаДиске);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИОбработатьДанныеФайла(ФайлНаДиске)
	
	ТабДокумент = ПрочитатьДокументExcelНаСервере(ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлНаДиске.ПолноеИмя), УникальныйИдентификатор), ФайлНаДиске.Расширение);
	
	ЗагрузитьДанныеИзТабличногоДокументаИПометитьНаУдаление(ТабДокумент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьДанныеИзТабличногоДокументаИПометитьНаУдаление(ТабличныйДокумент)
	
	КоличествоПомеченных = 0;
	
	ВидыСправочников = ВидыСправочников();
	ВидСправочника = Неопределено;
	
	НомерСтроки = 0;
	Пока НомерСтроки < ТабличныйДокумент.ВысотаТаблицы Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ДанныеКолонкиИмя = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		НовыйВидСправочника = ВидыСправочников.Получить(ДанныеКолонкиИмя);
		
		Если Не НовыйВидСправочника = ВидСправочника И Не НовыйВидСправочника = Неопределено Тогда
			ВидСправочника = НовыйВидСправочника;			
		КонецЕсли;	
			
		Если Не ВидСправочника = Неопределено Тогда
			ДанныеКолонкиGUID    = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
			ДанныеКолонкиПризнак = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
			Если Врег(ДанныеКолонкиПризнак) = "ДА" Тогда
				Элемент = Справочники[ВидСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеКолонкиGUID));
				Если Не ОбщегоНазначения.ОбъектСуществуетВБазеДанных(Элемент) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось найти по GUID - <Справочник: %1> <GUID: %2>", ВидСправочника, ДанныеКолонкиGUID));	
				Иначе
					Элемент.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
					КоличествоПомеченных = КоличествоПомеченных + 1;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Помечено на удаление элементов справочников: %1", КоличествоПомеченных));
	
КонецПроцедуры

&НаСервереБезКонтекста
