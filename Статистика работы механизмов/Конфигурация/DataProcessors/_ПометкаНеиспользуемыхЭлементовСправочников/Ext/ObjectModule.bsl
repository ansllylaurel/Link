Функция ОбъектыДляПроверки(ПараметрыПометки) Экспорт
	
	ПроверяемыеСсылки = Новый ТаблицаЗначений();
	ПроверяемыеСсылки.Колонки.Добавить("Ссылка");
	ПроверяемыеСсылки.Колонки.Добавить("ТипОбъекта");
	
	Если ПараметрыПометки.Свойство("ПометкаЮрФизЛиц") И ПараметрыПометки.ПометкаЮрФизЛиц Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, ЮрФизЛицаДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	Если ПараметрыПометки.Свойство("ПометкаАкций") И ПараметрыПометки.ПометкаАкций Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, АкцииДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	Если ПараметрыПометки.Свойство("ПометкаОблигаций") И ПараметрыПометки.ПометкаОблигаций Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, ОблигацииДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	Если ПараметрыПометки.Свойство("ПометкаПаев") И ПараметрыПометки.ПометкаПаев Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, ПаиДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	Если ПараметрыПометки.Свойство("ПометкаЭмитентов") И ПараметрыПометки.ПометкаЭмитентов Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, ЭмитентыДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	Если ПараметрыПометки.Свойство("ПометкаПаевыхИнвестиционныхФондов") И ПараметрыПометки.ПометкаПаевыхИнвестиционныхФондов Тогда
		ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, ПаевыеИнвестиционныеФондыДляПроверки(ПараметрыПометки));
	КонецЕсли;	
	
	ПроверяемыеСсылки.Индексы.Добавить("ТипОбъекта");
	
	Возврат ПроверяемыеСсылки;
	
КонецФункции

Процедура ДополнитьПроверяемыеСсылки(ПроверяемыеСсылки, Выборка)
	
	Пока Выборка.Следующий() Цикл
		Если ПроверяемыеСсылки.Найти(Выборка.Ссылка, "Ссылка") = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПроверяемыеСсылки.Добавить(), Выборка);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

Функция ТипыОбъектовДляПроверки(ОбъектыДляПометки) Экспорт
	
	ТипыОбъектов = ОбъектыДляПометки.Скопировать(, "ТипОбъекта");
	ТипыОбъектов.Свернуть("ТипОбъекта");
	
	Возврат ТипыОбъектов.ВыгрузитьКолонку("ТипОбъекта");
	
КонецФункции

Функция РегистрыСведенийСВедущимИзмерениемПоТипу(ТипОбъекта) Экспорт
	
	РегистрыСВедущимИзмерением = Новый Массив;
	Для Каждого РегистрСведенийМетаданные Из Метаданные.РегистрыСведений Цикл
		ЕстьВедущее   = Ложь;
		ЕстьНеВедущее = Ложь;
		
		Для Каждого Измерение Из РегистрСведенийМетаданные.Измерения Цикл
			Если Измерение.Тип.СодержитТип(ТипОбъекта) Тогда
				Если Измерение.Ведущее Тогда
					ЕстьВедущее = Истина;
				Иначе
					ЕстьНеВедущее = Истина;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		ЕстьВРесурсе = Ложь;
		Для Каждого Ресурс Из РегистрСведенийМетаданные.Ресурсы Цикл
			Если Ресурс.Тип.СодержитТип(ТипОбъекта) Тогда
				ЕстьВРесурсе = Истина;
			КонецЕсли;
		КонецЦикла;	
		
		Если ЕстьВедущее И Не ЕстьНеВедущее И Не ЕстьВРесурсе Тогда
			РегистрыСВедущимИзмерением.Добавить(РегистрСведенийМетаданные.ПолноеИмя());	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат РегистрыСВедущимИзмерением;
	
КонецФункции

Функция ПометитьНаУдалениеОбъектыСПроверкойСсылок(ОбъектыДляПометки, ПараметрыПометки) Экспорт
	
	Результат = Новый Структура("ОбъектыБезСсылок", Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина);
	ПомеченныеОбъекты = НайтиПомеченныеНаУдаление();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТипыОбъектов = ТипыОбъектовДляПроверки(ОбъектыДляПометки);
	
	// объекты разных типов проверяются отдельно
	Для Каждого ТипОбъекта Из ТипыОбъектов Цикл
		
		ПометитьНаУдалениеОбъектыСПроверкойСсылокПоТипу(ТипОбъекта, ОбъектыДляПометки, ПомеченныеОбъекты, ПараметрыПометки, Результат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПометитьНаУдалениеОбъектыСПроверкойСсылокПоТипу(ТипОбъекта, ОбъектыДляПометки, ПомеченныеОбъекты, ПараметрыПометки, Результат)
	
	РазмерПорции = ?(ПараметрыПометки.Свойство("РазмерПорции"), ПараметрыПометки.РазмерПорции, 100);;
	
	РегистрыСВедущимИзмерением = РегистрыСведенийСВедущимИзмерениемПоТипу(ТипОбъекта);
	
	ОбъектыДляПометкиПоТипу = ОбъектыДляПометки.НайтиСтроки(Новый Структура("ТипОбъекта", ТипОбъекта));
	
	Счетчик = 0;
	СсылкиДляПроверки = Новый Массив;
	Для Каждого ОбъектДляПометки Из ОбъектыДляПометкиПоТипу Цикл
		
		Счетчик = Счетчик + 1;
		СсылкиДляПроверки.Добавить(ОбъектДляПометки.Ссылка);	
		
		Если Счетчик = РазмерПорции Тогда
			ПометитьНеиспользованныеСсылки(СсылкиДляПроверки, ПомеченныеОбъекты, РегистрыСВедущимИзмерением, ПараметрыПометки, Результат);
			СсылкиДляПроверки.Очистить();
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	Если СсылкиДляПроверки.Количество() > 0 Тогда
		ПометитьНеиспользованныеСсылки(СсылкиДляПроверки, ПомеченныеОбъекты, РегистрыСВедущимИзмерением, ПараметрыПометки, Результат);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПометитьНеиспользованныеСсылки(СсылкиДляПроверки, ПомеченныеНаУдалениеОбъекты, РегистрыСВедущимИзмерением, ПараметрыПометки, Результат) Экспорт
	
	НеУчитыватьСсылкиВНезависимыхРС = ?(ПараметрыПометки.Свойство("НеУчитыватьСсылкиВНезависимыхРС"), ПараметрыПометки.НеУчитыватьСсылкиВНезависимыхРС, Ложь);
	
	Если ТипЗнч(ПомеченныеНаУдалениеОбъекты) = Тип("Массив") Тогда
		ПомеченныеОбъекты = ПомеченныеНаУдалениеОбъекты;
	ИначеЕсли ЭтоАдресВременногоХранилища(ПомеченныеНаУдалениеОбъекты) Тогда
		ПомеченныеОбъекты = ПолучитьИзВременногоХранилища(ПомеченныеНаУдалениеОбъекты);
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		ПомеченныеОбъекты = НайтиПомеченныеНаУдаление();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;	
	
	ИсключаемыеОбъекты = Новый Массив;
	Для Каждого ОбъектМетаданных Из РегистрыСВедущимИзмерением Цикл
		ИсключаемыеОбъекты.Добавить(ОбъектМетаданных);	
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Истина);
	НайденныеСсылки = НайтиПоСсылкам(СсылкиДляПроверки, Новый Массив, Новый Массив, ИсключаемыеОбъекты);
	НайденныеСсылки.Индексы.Добавить("Ссылка");
	//НайденныеСсылки = Новый ТаблицаЗначений;
	//НайденныеСсылки.Колонки.Добавить("Метаданные");
	//НайденныеСсылки.Колонки.Добавить("Ссылка");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	НеиспользуемыеСсылки = Новый Массив;
	СтруктураОтбора = Новый Структура("Ссылка");
	Для Каждого ПроверяемаяСсылка Из СсылкиДляПроверки Цикл
		СтруктураОтбора.Ссылка = ПроверяемаяСсылка;
		РезультатПоиска = НайденныеСсылки.НайтиСтроки(СтруктураОтбора);
		
		Если РезультатПоиска.Количество() = 0 Тогда
			НеиспользуемыеСсылки.Добавить(ПроверяемаяСсылка);
		Иначе
			ЕстьСсылки = Ложь;
			
			ОбъектыМетаданных = Новый Массив;
			
			КоличествоСсылок  = 0;
			Для Каждого СтрокаСсылок Из РезультатПоиска Цикл
				ОбъектСсылки = СтрокаСсылок.Данные;
				ТипОбъектаСсылки = ТипМетаданныхПоТипуОбъекта(ТипЗнч(ОбъектСсылки));
				Если ТипОбъектаСсылки = "РегистрыСведений" И СтрокаСсылок.Метаданные.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый И НеУчитыватьСсылкиВНезависимыхРС Тогда
					Продолжить;
				ИначеЕсли Не ПомеченныеОбъекты.Найти(ОбъектСсылки) = Неопределено Тогда
					Продолжить;
				Иначе	
					ЕстьСсылки = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			
			Если Не ЕстьСсылки Тогда
				НеиспользуемыеСсылки.Добавить(ПроверяемаяСсылка);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	Если НеиспользуемыеСсылки.Количество() > 0 Тогда
		ПометитьНаУдаление(НеиспользуемыеСсылки, ПараметрыПометки, Результат);
	КонецЕсли;	
	
КонецПроцедуры

Функция ТипМетаданныхПоТипуОбъекта(ТипОбъекта)
	
	МетаданныеТипа = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеТипа) Тогда
		
		Возврат "РегистрыСведений";
		
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеТипа) Тогда
		
		Возврат "Документы";
		
	ИначеЕсли Метаданные.Справочники.Содержит(МетаданныеТипа) Тогда
		
		Возврат "Справочники";	
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

Процедура ПометитьНаУдаление(СсылкиДляПометкиНаУдаление, ПараметрыПометки, Результат)
	
	НеПомечатьНаУдаление = ?(ПараметрыПометки.Свойство("НеПомечатьНаУдаление"), ПараметрыПометки.НеПомечатьНаУдаление, Ложь);
	
	НачатьТранзакцию();
	Для Каждого СсылкаДляПометкиНаУдаление Из СсылкиДляПометкиНаУдаление Цикл
		ОбъектИзСсылки = СсылкаДляПометкиНаУдаление.ПолучитьОбъект();
		Если Не НеПомечатьНаУдаление Тогда
			ОбъектИзСсылки.УстановитьПометкуУдаления(Истина);
		КонецЕсли;	
		Результат.ОбъектыБезСсылок.Добавить(СсылкаДляПометкиНаУдаление);
	КонецЦикла;	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры