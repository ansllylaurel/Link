// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Пометка на удаление неиспользуемых элементов справочников",
		"1.00",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
		
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ЮрФизЛицаДляПроверки(ПараметрыПометки)
	
	ВидыЮрФизЛиц = Новый Массив;
	ВидыЮрФизЛиц.Добавить(ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыЮрФизЛиц",              ВидыЮрФизЛиц);
	Запрос.УстановитьПараметр("ПроверятьТолькоПомеченные", ПараметрыПометки.ПроверятьТолькоПомеченные);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Эмитенты.ЮрФизЛицо КАК ЮрФизЛицо
	|ПОМЕСТИТЬ ВТ_БыстрыйФильтр
	|ИЗ
	|	Справочник.Эмитенты КАК Эмитенты
	|ГДЕ
	|	НЕ Эмитенты.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Банки.ЮрФизЛицо
	|ИЗ
	|	Справочник.Банки КАК Банки
	|ГДЕ
	|	НЕ Банки.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АнкетаЮридическогоЛица.ЮрФизЛицо
	|ИЗ
	|	Документ.АнкетаЮридическогоЛица КАК АнкетаЮридическогоЛица
	|ГДЕ
	|	НЕ АнкетаЮридическогоЛица.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо
	|ИЗ
	|	Документ.АнкетаЮридическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели
	|ГДЕ
	|	НЕ АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЮрФизЛица.Ссылка КАК Ссылка,
	|	ТИПЗНАЧЕНИЯ(ЮрФизЛица.Ссылка) КАК ТипОбъекта
	|ИЗ
	|	Справочник.ЮрФизЛица КАК ЮрФизЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БыстрыйФильтр КАК ВТ_БыстрыйФильтр
	|		ПО ЮрФизЛица.Ссылка = ВТ_БыстрыйФильтр.ЮрФизЛицо
	|ГДЕ
	|	ЮрФизЛица.ВидЮрФизЛица В(&ВидыЮрФизЛиц)
	|	И НЕ ЮрФизЛица.Предопределенный
	|	И НЕ ЮрФизЛица.ЭтоГруппа
	|	И ВТ_БыстрыйФильтр.ЮрФизЛицо ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &ПроверятьТолькоПомеченные
	|				ТОГДА ЮрФизЛица.ПометкаУдаления
	|			ИНАЧЕ НЕ ЮрФизЛица.ПометкаУдаления
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЮрФизЛица.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;
	
КонецФункции	

Функция АкцииДляПроверки(ПараметрыПометки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроверятьТолькоПомеченные", ПараметрыПометки.ПроверятьТолькоПомеченные);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто1 КАК Справочник.Акции) КАК Акция
	|ПОМЕСТИТЬ ВТ_БыстрыйФильтр
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто1 ССЫЛКА Справочник.Акции
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто2 КАК Справочник.Акции)
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто2 ССЫЛКА Справочник.Акции
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто3 КАК Справочник.Акции)
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто3 ССЫЛКА Справочник.Акции
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции)
	|ИЗ
	|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
	|ГДЕ
	|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|	И НЕ ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции)
	|ИЗ
	|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
	|ГДЕ
	|	СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|	И НЕ СделкаЦенныеБумаги.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции)
	|ИЗ
	|	Документ.ПереоценкаЦенныхБумаг.ЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
	|ГДЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|	И НЕ ПереоценкаЦенныхБумагЦенныеБумаги.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага КАК Справочник.Акции)
	|ИЗ
	|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПереоценки КАК РегистрацияСтоимостиПереоценкиСтоимостиПереоценки
	|ГДЕ
	|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|	И НЕ РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции)
	|ИЗ
	|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПрочихЦенныхБумаг КАК РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг
	|ГДЕ
	|	РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Акции
	|	И НЕ РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Акции.Ссылка КАК Ссылка,
	|	ТИПЗНАЧЕНИЯ(Акции.Ссылка) КАК ТипОбъекта
	|ИЗ
	|	Справочник.Акции КАК Акции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БыстрыйФильтр КАК ВТ_БыстрыйФильтр
	|		ПО Акции.Ссылка = ВТ_БыстрыйФильтр.Акция
	|ГДЕ
	|	НЕ Акции.Предопределенный
	|	И ВТ_БыстрыйФильтр.Акция ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &ПроверятьТолькоПомеченные
	|				ТОГДА Акции.ПометкаУдаления
	|			ИНАЧЕ НЕ Акции.ПометкаУдаления
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;
	
КонецФункции	

Функция ОблигацииДляПроверки(ПараметрыПометки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроверятьТолькоПомеченные", ПараметрыПометки.ПроверятьТолькоПомеченные);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто1 КАК Справочник.Облигации) КАК Облигация
	|ПОМЕСТИТЬ ВТ_БыстрыйФильтр
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто1 ССЫЛКА Справочник.Облигации
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто2 КАК Справочник.Облигации)
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто2 ССЫЛКА Справочник.Облигации
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Субконто3 КАК Справочник.Облигации)
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Субконто3 ССЫЛКА Справочник.Облигации
	|	И НЕ ЛицевыеСчета.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации)
	|ИЗ
	|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
	|ГДЕ
	|	СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|	И НЕ СделкаЦенныеБумаги.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага КАК Справочник.Облигации)
	|ИЗ
	|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПереоценки КАК РегистрацияСтоимостиПереоценкиСтоимостиПереоценки
	|ГДЕ
	|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|	И НЕ РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации)
	|ИЗ
	|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПрочихЦенныхБумаг КАК РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг
	|ГДЕ
	|	РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|	И НЕ РегистрацияСтоимостиПереоценкиСтоимостиПрочихЦенныхБумаг.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации)
	|ИЗ
	|	Документ.ПереоценкаЦенныхБумаг.ЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
	|ГДЕ
	|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|	И НЕ ПереоценкаЦенныхБумагЦенныеБумаги.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Актив КАК Справочник.Облигации)
	|ИЗ
	|	Документ.РаспределениеАктивовСтраховыхКомпаний.АктивыСтраховойКомпании КАК РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании
	|ГДЕ
	|	РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Актив ССЫЛКА Справочник.Облигации
	|	И НЕ РаспределениеАктивовСтраховыхКомпанийАктивыСтраховойКомпании.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации)
	|ИЗ
	|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
	|ГДЕ
	|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	|	И НЕ ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Облигации.Ссылка КАК Ссылка,
	|	ТИПЗНАЧЕНИЯ(Облигации.Ссылка) КАК ТипОбъекта
	|ИЗ
	|	Справочник.Облигации КАК Облигации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БыстрыйФильтр КАК ВТ_БыстрыйФильтр
	|		ПО Облигации.Ссылка = ВТ_БыстрыйФильтр.Облигация
	|ГДЕ
	|	НЕ Облигации.Предопределенный
	|	И ВТ_БыстрыйФильтр.Облигация ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &ПроверятьТолькоПомеченные
	|				ТОГДА Облигации.ПометкаУдаления
	|			ИНАЧЕ НЕ Облигации.ПометкаУдаления
