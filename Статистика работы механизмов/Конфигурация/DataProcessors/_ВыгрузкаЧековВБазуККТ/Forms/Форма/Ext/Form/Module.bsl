	ОтраслевойРеквизит.Вставить("НомерДокументаОснования", "");
	СтруктураЧека.Вставить("ОтраслевойРеквизит", ОтраслевойРеквизит); //надо?
	
	
	
	СтруктураЧека.Вставить("Кассир", ""); 
	СтруктураЧека.Вставить("КассирИНН", ""); 
	СтруктураЧека.Вставить("Электронно", Ложь); 
	СтруктураЧека.Вставить("Отправляет1СEmail", Ложь); 
	СтруктураЧека.Вставить("Отправляет1СSMS", Ложь); 
	СтруктураЧека.Вставить("ПокупательEmail", "");//нужно указывать (Варя) 
	СтруктураЧека.Вставить("ПокупательНомер", ""); //нужно указывать (Варя)
	СтруктураЧека.Вставить("ТекстКороткогоСлипЧека", ""); 
	СтруктураЧека.Вставить("ДополнительныйРеквизит", ""); 
	СтруктураЧека.Вставить("ЕстьПерсональныеДанные", Ложь); 
	СтруктураЧека.Вставить("ЕдиныйЧек", Ложь); 
	СтруктураЧека.Вставить("ОтправительEmail", Неопределено); 
	СтруктураЧека.Вставить("НефискальныеДокументы", Неопределено); 
	
	Возврат СтруктураЧека;

КонецФункции

&НаСервереБезКонтекста
Функция СохранитьЧек(БазаККТ, СтруктураЧека)
	
	ИДЗаписи = БазаККТ.ОборудованиеЧекопечатающиеУстройстваВызовСервера.ДобавитьЧекВОчередьЧековККТ(СтруктураЧека);
	
	НаборЗаписей = БазаККТ.РегистрыСведений.ОчередьЧековККТ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументОснование.Установить(СтруктураЧека.ДокументОснование, Истина);
	НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИДЗаписи, Истина);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		ДанныеЧека = Запись.ДанныеЧека.Получить();
		ДанныеЧека.ИдентификаторФискальнойЗаписи = ИДЗаписи;
		Запись.ДанныеЧека =  БазаККТ.NewObject("ХранилищеЗначения", ДанныеЧека);
		Запись.ОборудованиеККТ = БазаККТ.Справочники.ПодключаемоеОборудование.НайтиПоНаименованию("'1С:Эмулятор ККТ (NativeApi)' на Администратор(ts12) 2");
	КонецЦикла;

	НаборЗаписей.Записать();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИДЗаписи);
		
	
КонецФункции

&НаСервере
Функция ОбщиеПараметрыЧека(БазаККТ, Отказ)
	
	ПараметрыЧека = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес КАК ЮридическийАдрес
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ПараметрыЧека.Вставить("ОрганизацияБазаККТ", БазаККТ.Справочники.Организации.НайтиПоРеквизиту("ИНН",ВыборкаДетальныеЗаписи.ИНН));
		ПараметрыЧека.Вставить("ИННОрганизации", ВыборкаДетальныеЗаписи.ИНН);
		ПараметрыЧека.Вставить("ДокументОснованиеВБазеККТ", БазаККТ.Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру("0000-000001",Дата(2023,07,23)));
		ПараметрыЧека.Вставить("СистемаНалогообложения", БазаККТ.Перечисления.ТипыСистемНалогообложенияККТ.ОСН);
		ПараметрыЧека.Вставить("ТорговыйОбъект", БазаККТ.Справочники.Склады.НайтиПоКоду("00-000001"));
		ПараметрыЧека.Вставить("СубъектПерсональныхДанных", БазаККТ.Справочники.ФизическиеЛица.ПустаяСсылка());
		ПараметрыЧека.Вставить("ОрганизацияНазвание", ВыборкаДетальныеЗаписи.КраткоеНаименованиеПоУставу);
		
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось задать общие параметры чеков",,,,Отказ);
	КонецЕсли;
	
	Возврат ПараметрыЧека;
	
КонецФункции

&НаСервере
Функция ДобавитьОплатыВЧек(БазаККТ, СуммаЭлектронно, СуммаПредоплата, СуммаПостоплата, СуммаВстречноеПредоставление)
	
	ТаблицаОплат = БазаККТ.NewObject("Массив");
	
	//Реквизит "сумма по чеку (БСО) безналичными" (тег 1081) включается в состав кассового чека (БСО) в печатной форме только в случае, если сумма оплаты электронными средствами платежа отлична от нуля
	//Реквизит "сумма по чеку (БСО) предоплатой (зачетом аванса и (или) предыдущих платежей)" (тег 1215) включается в состав кассового чека (БСО) в печатной форме только в случае, если сумма предоплатой отлична от нуля.
	//Реквизит "сумма по чеку (БСО) постоплатой (в кредит)" (тег 1216) включается в состав кассового чека (БСО) в печатной форме только в случае, если сумма оплаты кредитом отлична от нуля.
	//Сумма значений реквизитов "сумма по чеку (БСО) наличными" (тег 1031), "сумма по чеку (БСО) безналичными" (тег 1081), 
	//	"сумма по чеку (БСО) предоплатой (зачетом аванса)" (тег 1215), "сумма по чеку (БСО) постоплатой (в кредит)" (тег 1216) и 
	//	"сумма по чеку (БСО) встречным предоставлением" (тег 1217) должна быть равна значению реквизита "сумма расчета, указанного в чеке (БСО)" (тег 1020).

	Если СуммаЭлектронно > 0 Тогда
		СтрокаОплаты = БазаККТ.NewObject("Структура");
		СтрокаОплаты.Вставить("ТипОплаты", БазаККТ.Перечисления.ТипыОплатыККТ.Электронно);
		СтрокаОплаты.Вставить("Сумма", СуммаЭлектронно);
		ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;

	Если СуммаПредоплата > 0 Тогда
		СтрокаОплаты = БазаККТ.NewObject("Структура");
		СтрокаОплаты.Вставить("ТипОплаты", БазаККТ.Перечисления.ТипыОплатыККТ.Предоплата);
		СтрокаОплаты.Вставить("Сумма", СуммаПредоплата);
		ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;

	Если СуммаПостоплата > 0 Тогда
		СтрокаОплаты = БазаККТ.NewObject("Структура");
		СтрокаОплаты.Вставить("ТипОплаты", БазаККТ.Перечисления.ТипыОплатыККТ.Постоплата);
		СтрокаОплаты.Вставить("Сумма", СуммаПостоплата);
		ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;

	Если СуммаВстречноеПредоставление > 0 Тогда
		СтрокаОплаты = БазаККТ.NewObject("Структура");
		СтрокаОплаты.Вставить("ТипОплаты", БазаККТ.Перечисления.ТипыОплатыККТ.ВстречноеПредоставление);
		СтрокаОплаты.Вставить("Сумма", СуммаВстречноеПредоставление);
		ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	Возврат ТаблицаОплат;

КонецФункции
					
&НаСервере
Процедура КомандаВыгрузитьЧекиНаСервере()
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ОснованияОплат
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью)
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ЗадолженностиПоДенежнымСредствам.Контрагент.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.Сумма > 0
		|			ТОГДА ВложенныйЗапрос.ТипЗадолженности
		|		КОГДА ВложенныйЗапрос.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
		|	ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.Сумма > 0
		|			ТОГДА ВложенныйЗапрос.Сумма
		|		ИНАЧЕ -ВложенныйЗапрос.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВложенныйЗапрос.Валюта КАК Валюта,
		|	ЕСТЬNULL(СделкаСНедвижимостью.ВидПраваНаНедвижимость, НЕОПРЕДЕЛЕНО) КАК ВидПраваНаНедвижимость,
		|	ЕСТЬNULL(СделкаСНедвижимостью.ВидСделки, НЕОПРЕДЕЛЕНО) КАК ВидСделки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВложенныйЗапрос.ТипЗадолженности КАК ТипЗадолженности,
		|		ВложенныйЗапрос.ВидЗадолженности КАК ВидЗадолженности,
		|		ВложенныйЗапрос.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|		СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
		|		МАКСИМУМ(ВложенныйЗапрос.ПлановаяДатаПередачиНедвижимости) КАК ПлановаяДатаПередачиНедвижимости,
		|		ВложенныйЗапрос.Валюта КАК Валюта,
		|		ВложенныйЗапрос.Контрагент КАК Контрагент
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|			ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|			ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК ОснованиеЗадолженности,
		|			ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Контрагент
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			КОНЕЦ КАК Контрагент,
		|			ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма,
		|			ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|			ДАТАВРЕМЯ(1, 1, 1) КАК ПлановаяДатаПередачиНедвижимости
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|					&НачалоПериода,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И Основание В
		|							(ВЫБРАТЬ
		|								_ОснованияОплат.Основание
		|							ИЗ
		|								_ОснованияОплат)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ГДЕ
		|			ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ВЫБОР
		|				КОГДА СделкаСНедвижимостью.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			КОНЕЦ,
		|			ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделкеСНедвижимостью),
		|			УсловияСделокСНедвижимостьюСрезПоследних.Основание,
		|			СделкаСНедвижимостью.Контрагент,
		|			-УсловияСделокСНедвижимостьюСрезПоследних.Сумма,
		|			&ВалютаРубли,
		|			УсловияСделокСНедвижимостьюСрезПоследних.ПлановаяДатаПередачи
		|		ИЗ
		|			РегистрСведений.УсловияСделокСНедвижимостью.СрезПоследних(
		|					&НачалоПериода,
		|					(Организация, СчетДоверительногоУправления, Основание) В
		|						(ВЫБРАТЬ
		|							СделкаСНедвижимостью.Организация КАК Организация,
		|							СделкаСНедвижимостью.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|							СделкаСНедвижимостью.Ссылка КАК Ссылка
		|						ИЗ
		|							Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|						ГДЕ
		|							СделкаСНедвижимостью.ВидПраваНаНедвижимость = ЗНАЧЕНИЕ(Перечисление.ВидыПравНаНедвижимость.Собственность)
		|							И СделкаСНедвижимостью.Организация = &Организация
		|							И СделкаСНедвижимостью.СчетДоверительногоУправления = &СчетДоверительногоУправления)) КАК УсловияСделокСНедвижимостьюСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|				ПО УсловияСделокСНедвижимостьюСрезПоследних.Основание = СделкаСНедвижимостью.Ссылка
		|					И (НЕ УсловияСделокСНедвижимостьюСрезПоследних.Отменено)
		|					И (УсловияСделокСНедвижимостьюСрезПоследних.АктПриемаПередачи = ЗНАЧЕНИЕ(Документ.АктПриемаПередачиОбъектовНедвижимости.ПустаяСсылка))
		|					И (УсловияСделокСНедвижимостьюСрезПоследних.СведенияОГосРегистрацииПраваСобственности = ЗНАЧЕНИЕ(Документ.СведенияОРегистрацииПраваСобственности.ПустаяСсылка))) КАК ВложенныйЗапрос
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВложенныйЗапрос.Валюта,
		|		ВложенныйЗапрос.ОснованиеЗадолженности,
		|		ВложенныйЗапрос.ВидЗадолженности,
		|		ВложенныйЗапрос.ТипЗадолженности,
		|		ВложенныйЗапрос.Контрагент
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(ВложенныйЗапрос.Сумма) <> 0) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗадолженности КАК ВидыЗадолженности
		|		ПО ВложенныйЗапрос.ВидЗадолженности = ВидыЗадолженности.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ГрафикиПлатежейСрезПоследних.ДатаПлатежа) КАК ДатаПлатежа,
		|			ГрафикиПлатежейСрезПоследних.Основание КАК Основание
		|		ИЗ
		|			РегистрСведений.ГрафикиПлатежей.СрезПоследних(
		|					&ОкончаниеПериода,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ГрафикиПлатежейСрезПоследних
		|		ГДЕ
		|			ГрафикиПлатежейСрезПоследних.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ГрафикиПлатежейСрезПоследних.Основание) КАК ГрафикПлатежаПоСделкеСНедвижимостью
		|		ПО ВложенныйЗапрос.ОснованиеЗадолженности = ГрафикПлатежаПоСделкеСНедвижимостью.Основание
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|		ПО ВложенныйЗапрос.ОснованиеЗадолженности = СделкаСНедвижимостью.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствам.Аванс КАК Аванс,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствам.ВидДвижения КАК ВидДвижения,
		|	ЕСТЬNULL(СделкаСНедвижимостью.ВидПраваНаНедвижимость, НЕОПРЕДЕЛЕНО) КАК ВидПраваНаНедвижимость,
		|	ЕСТЬNULL(СделкаСНедвижимостью.ВидСделки, НЕОПРЕДЕЛЕНО) КАК ВидСделки,
		|	ЕСТЬNULL(Договоры.НомерДоговора, НЕОПРЕДЕЛЕНО) КАК НомерДоговора,
		|	ЕСТЬNULL(Договоры.ДатаЗаключения, НЕОПРЕДЕЛЕНО) КАК ДатаЗаключения
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|			ПО СделкаСНедвижимостью.Договор = Договоры.Ссылка
		|		ПО ЗадолженностиПоДенежнымСредствам.Основание = СделкаСНедвижимостью.Ссылка
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Основание В
		|			(ВЫБРАТЬ
		|				_ОснованияОплат.Основание
		|			ИЗ
		|				_ОснованияОплат)
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода";
	
	Запрос.УстановитьПараметр("НачалоПериода", Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ВалютаРубли", Объект.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	#КонецОбласти
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
