
&НаКлиенте
Процедура КомандаВыгрузитьЧеки(Команда)
	КомандаВыгрузитьЧекиНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьПозициюЧека(БазаККТ, ПараметрыПозицииЧека, Отказ)
	
	ПозицияЧека = БазаККТ.NewObject("Структура");
	
	ПозицияЧека.Вставить("ФискальнаяСтрока", Истина);
	ПозицияЧека.Вставить("Сумма", ПараметрыПозицииЧека.Сумма);
	ПозицияЧека.Вставить("Количество", ПараметрыПозицииЧека.Количество);//если товар идентифицируется по наименованию, то =1. Аванс - ?
	ПозицияЧека.Вставить("Цена", ПараметрыПозицииЧека.Цена);
	ПозицияЧека.Вставить("ЦенаСоСкидками", ПараметрыПозицииЧека.Цена);//тэг 1079
	ПозицияЧека.Вставить("СуммаСкидок", 0);
	ПозицияЧека.Вставить("СтавкаНДС", ПараметрыПозицииЧека.СтавкаНДС);//для авансов = 120
	ПозицияЧека.Вставить("СуммаНДС", ПараметрыПозицииЧека.СуммаНДС);
	ПозицияЧека.Вставить("Наименование", ПараметрыПозицииЧека.НаименованиеПредметаРасчета);//#если не аванс
	
	Если ПараметрыПозицииЧека.ПризнакСпособаРасчета = "ПередачаСЧастичнойОплатой" Тогда
		ПозицияЧека.Вставить("ПризнакСпособаРасчета", БазаККТ.Перечисления.ПризнакиСпособаРасчета.ПередачаСЧастичнойОплатой);
	ИначеЕсли ПараметрыПозицииЧека.ПризнакСпособаРасчета = "ПредоплатаПолная" Тогда
		ПозицияЧека.Вставить("ПризнакСпособаРасчета", БазаККТ.Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная);
	ИначеЕсли ПараметрыПозицииЧека.ПризнакСпособаРасчета = "ПредоплатаЧастичная" Тогда
		ПозицияЧека.Вставить("ПризнакСпособаРасчета", БазаККТ.Перечисления.ПризнакиСпособаРасчета.ПредоплатаЧастичная);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не отработан признак способа расчета """+ПараметрыПозицииЧека.ПризнакСпособаРасчета+"""",,,,Отказ);
	КонецЕсли;
	
	Если ПараметрыПозицииЧека.ПризнакПредметаРасчета = "Товар" Тогда
		ПозицияЧека.Вставить("ПризнакПредметаРасчета", БазаККТ.Перечисления.ПризнакиПредметаРасчета.Товар);//тэг 1212, значения: платеж, товар, услуга -Товар  (если как ДКП оставим), Услуга (аренда), Платеж (аванс)
	ИначеЕсли ПараметрыПозицииЧека.ПризнакПредметаРасчета = "Платеж" Тогда
		ПозицияЧека.Вставить("ПризнакПредметаРасчета", БазаККТ.Перечисления.ПризнакиПредметаРасчета.Платеж);//тэг 1212, значения: платеж, товар, услуга -Товар  (если как ДКП оставим), Услуга (аренда), Платеж (аванс)
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не отработан признак предмета расчета """+ПараметрыПозицииЧека.ПризнакПредметаРасчета+"""",,,,Отказ);
	КонецЕсли;
	
	ПозицияЧека.Вставить("КодСтраныПроисхожденияТовара", ""); //не надо
	ПозицияЧека.Вставить("НомерТаможеннойДекларации", "");
	ПозицияЧека.Вставить("СуммаАкциза", 0);
	ПозицияЧека.Вставить("ЕдиницаИзмерения", "");
	ПозицияЧека.Вставить("ПризнакАгентаПоПредметуРасчета", ""); //не надо
	ПозицияЧека.Вставить("ДополнительныйРеквизит", "");//не надо
	ПозицияЧека.Вставить("ОбъемноСортовойУчет", Ложь);
	ПозицияЧека.Вставить("НомерСекции", 0);
	ПозицияЧека.Вставить("КонтрольнаяМарка", "");//не надо
	ПозицияЧека.Вставить("КодЕдиницыИзмерения", "");
	ПозицияЧека.Вставить("КодВидаНоменклатурнойКлассификации", "");
	ПозицияЧека.Вставить("ШтрихкодBase64", "");
	ПозицияЧека.Вставить("Штрихкод", "");
	
	
	
	ОтраслевойРеквизит = БазаККТ.NewObject("Структура");
	ОтраслевойРеквизит.Вставить("ИдентификаторФОИВ", "");
	ОтраслевойРеквизит.Вставить("ДатаДокументаОснования", "");
	ОтраслевойРеквизит.Вставить("НомерДокументаОснования", "");
	ОтраслевойРеквизит.Вставить("ЗначениеРеквизита", "");
	ПозицияЧека.Вставить("ОтраслевойРеквизит", ОтраслевойРеквизит); //надо?
	
	
	ДробноеКоличество = БазаККТ.NewObject("Структура");
	ДробноеКоличество.Вставить("Числитель", "");
	ДробноеКоличество.Вставить("Знаменатель", "");
	ПозицияЧека.Вставить("ДробноеКоличество", ДробноеКоличество); //надо?
	
	ДанныеКодаТоварнойНоменклатуры = БазаККТ.NewObject("Структура");
	ПозицияЧека.Вставить("ДанныеКодаТоварнойНоменклатуры", ДанныеКодаТоварнойНоменклатуры); //надо?
	
	ДанныеПоставщика = БазаККТ.NewObject("Структура");
	ДанныеПоставщика.Вставить("Наименование", "");
	ДанныеПоставщика.Вставить("Телефон", "");
	ДанныеПоставщика.Вставить("ИНН", "");
	ПозицияЧека.Вставить("ДанныеПоставщика", ДанныеПоставщика); //не надо
	
	ДанныеАгента = БазаККТ.NewObject("Структура");
	
	ПлатежныйАгент = БазаККТ.NewObject("Структура");
	ПлатежныйАгент.Вставить("Операция", "");
	ПлатежныйАгент.Вставить("Телефон", "");
	ДанныеАгента.Вставить("ПлатежныйАгент", ПлатежныйАгент); 
	
	ОператорПеревода = БазаККТ.NewObject("Структура");
	ОператорПеревода.Вставить("Наименование", "");
	ОператорПеревода.Вставить("Телефон", "");
	ОператорПеревода.Вставить("Адрес", "");
	ОператорПеревода.Вставить("ИНН", "");
	ДанныеАгента.Вставить("ОператорПеревода", ОператорПеревода);
	
	ОператорПоПриемуПлатежей = БазаККТ.NewObject("Структура");
	ОператорПоПриемуПлатежей.Вставить("Телефон", "");
	ДанныеАгента.Вставить("ОператорПоПриемуПлатежей", ОператорПоПриемуПлатежей);
	
	ПозицияЧека.Вставить("ДанныеАгента", ДанныеАгента); //не надо

	Возврат ПозицияЧека;
	
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьЧек(БазаККТ, ПараметрыЧека)

	СтруктураЧека = БазаККТ.NewObject("Структура");
	СтруктураЧека.Вставить("ОрганизацияИНН", ПараметрыЧека.ИННОрганизации); 
	СтруктураЧека.Вставить("ИдентификаторФискальнойЗаписи", "");//#техдолг: генерировать свой идентификатор чека 
	СтруктураЧека.Вставить("ДокументОснование", ПараметрыЧека.ДокументОснованиеВБазеККТ); 
	СтруктураЧека.Вставить("Организация", ПараметрыЧека.ОрганизацияБазаККТ); 
	СтруктураЧека.Вставить("СистемаНалогообложения", ПараметрыЧека.СистемаНалогообложения); 
	СтруктураЧека.Вставить("ТорговыйОбъект", ПараметрыЧека.ТорговыйОбъект); 
	СтруктураЧека.Вставить("СубъектПерсональныхДанных", ПараметрыЧека.СубъектПерсональныхДанных); //надо физика?
	СтруктураЧека.Вставить("ТипРасчета", ПараметрыЧека.ТипРасчета);//#по ситуации. Значения: ПриходДенежныхСредств, ВозвратДенежныхСредств, РасходДенежныхСредств, ВозвратРасходаДенежныхСредств 
	СтруктураЧека.Вставить("КассаККМ", "");//"'1С:Эмулятор ККТ (NativeApi)' на Администратор(ts12)"); 
	
	СтруктураЧека.Вставить("ОрганизацияНазвание", ПараметрыЧека.ОрганизацияНазвание);//ВыборкаДетальныеЗаписи.КраткоеНаименованиеПоУставу); 
	СтруктураЧека.Вставить("АдресРасчетов", ""); //ВыборкаДетальныеЗаписи.ЮридическийАдрес);//юр адрес?  
	СтруктураЧека.Вставить("ТекстШапки", "");//надо? 
	СтруктураЧека.Вставить("НомерЧека", ""); //как формировать?
	СтруктураЧека.Вставить("ДатаВремя", "");//Если ничего не передать, то будет текущее при фискализации - норм(?)# Текущее и надо, но вопрос нумерации чеков
	СтруктураЧека.Вставить("Получатель", ""); //не надо
