
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период = КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	
	Объект.КоличествоПоказателей = 1;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	КаталогСохранения = ОбъектНаСервере.ПолучитьБазовыйКаталогДоходности();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УстановитьУсловноеОформлениеПоказателей();
	
	УстановитьОтчетОРасхожденияхНаФорме("");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновить");
	Попытка
		ВыполнитьОбновление(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновление(ПараметрыСессии)
	
	ДанныеОбновлены = КомандаОбновитьНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если ДанныеОбновлены Тогда
		Сообщить("Показатели обновлены");
	Иначе
		Сообщить("Обновление показателей не требуется");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаОбновитьНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ДанныеОбновлены = ОбъектНаСервере.ОбновитьФинансовыеПоказатели();
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	Возврат ДанныеОбновлены;
	
КонецФункции

&НаКлиенте
Процедура КомандаЗарегистрировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗарегистрировать");
	Попытка
		ВыполнитьРегистрацию(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегистрацию(ПараметрыСессии)
	
	Количество = КомандаЗарегистрироватьНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если Количество > 0 Тогда
		Сообщить("Зарегистрировано документов: " + Количество);
	Иначе
		Сообщить("Регистрация не требуется");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КомандаЗарегистрироватьНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Количество = ОбъектНаСервере.ЗарегистрироватьФинансовыеПоказателиПоРасхождениям();
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	Возврат Количество;
	
КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПоказателей()
	
	Для Номер = 1 По 10 Цикл
	
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Текущее" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.Значение_Расчетное" + Номер);
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ЭтоНовыйДокумент");
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Ложь;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
		
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

		ЭлементОформления.Использование = Истина;

		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Объект.ФинансовыеПоказатели.ВидПоказателя" + Номер);
		ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование    = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ЭлементОтбора.ПравоеЗначение   = Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода;

		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт));
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиВидПоказателя" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Текущее" + Номер);
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ФинансовыеПоказателиЗначение_Расчетное" + Номер);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	Элементы = Форма.Элементы;

	Для Номер = 1 По 10 Цикл
		Элементы["ФинансовыеПоказателиВидПоказателя" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Текущее" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
		Элементы["ФинансовыеПоказателиЗначение_Расчетное" + Номер].Видимость = (Номер <= Форма.Объект.КоличествоПоказателей);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если Вопрос(
		"Обновить показатели за " + Формат(Объект.Период, "ДФ=dd.MM.yyyy") + "?",
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Да) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КомандаСформироватьИСохранитьXML(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСформироватьИСохранитьXML");
	Попытка
		ВыполнитьФормированиеИСохранениеXML(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьФормированиеИСохранениеXML(ПараметрыСессии)
	
	Если Не ПроверитьКаталогСохранения() Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Не задан каталог сохранения");
		Возврат;
	КонецЕсли;
	
	КоличествоФайлов = ПолучитьКоличествоФайловXMLВКаталогеНаСервере(КаталогСохранения);
	Если КоличествоФайлов > 0 Тогда
		Если Вопрос(
			"В каталоге уже есть XML-файлы за данный период (" + КоличествоФайлов + " шт.). Будут перезаписаны. Продолжить?",
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
			ДобавитьТекстОшибки(ПараметрыСессии, "Отменено пользователем");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КомандаСформироватьИСохранитьXMLНаСервере(КаталогСохранения, Истина);
	Сообщить("XML сформированы и сохранены");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоФайловXMLВКаталогеНаСервере(БазовыйКаталог)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектНаСервере.ПолучитьКоличествоФайловXMLВКаталоге(БазовыйКаталог);
	
КонецФункции

&НаСервере
Процедура КомандаСформироватьИСохранитьXMLНаСервере(БазовыйКаталог, Перезаписывать)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.СформироватьИСохранитьXML(БазовыйКаталог, Перезаписывать);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНайтиРасхождения(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаНайтиРасхождения");
	Попытка
		ВыполнитьПоискРасхождений(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискРасхождений(ПараметрыСессии)
	
	Если Не ПроверитьКаталогСохранения() Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Не задан каталог сохранения");
		Возврат;
	КонецЕсли;
	
	КомандаНайтиРасхожденияНаСервере(КаталогСохранения);
	
	Если ПустаяСтрока(ОтчетОРасхожденияхHTML) Тогда
		Сообщить("Расхождений не найдено");
	Иначе
		Сообщить("Найдены расхождения. Отчёт отображён на странице «Отчёт о расхождениях»");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтправитьИОпубликоватьНаСайте(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОтправитьИОпубликоватьНаСайте");
	Попытка
		ВыполнитьОтправкуИПубликациюНаСайте(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтправкуИПубликациюНаСайте(ПараметрыСессии)
	
	Если Не ПроверитьКаталогСохранения() Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Не задан каталог сохранения");
		Возврат;
	КонецЕсли;
	
	РезультатВопроса = Вопрос(
		"Будет выполнена публикация XML на сайт и отправка оповещения с отчётом о доходностях только при успешной сверке с предыдущим периодом. Продолжить?",
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет);
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Отменено пользователем");
		Возврат;
	КонецЕсли;
	
	Опубликовано = КомандаОтправитьИОпубликоватьНаСайтеНаСервере(КаталогСохранения);
	Если Опубликовано Тогда
		Сообщить("Данные опубликованы на сайте, отправлено оповещение с отчётом");
	ИначеЕсли Не ПустаяСтрока(ОтчетОРасхожденияхHTML) Тогда
		Сообщить("Выгрузка не выполнена из-за расхождений при сверке. Отчёт о расхождениях показан на странице «Отчёт о расхождениях»");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция КомандаОтправитьИОпубликоватьНаСайтеНаСервере(БазовыйКаталог)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	РезультатВыполнения = ОбъектНаСервере.ОтправитьИОпубликоватьНаСайте(БазовыйКаталог);
	
	Если РезультатВыполнения.Успех Тогда
		УстановитьОтчетОРасхожденияхНаФорме("");
		Возврат Истина;
	Иначе
		УстановитьОтчетОРасхожденияхНаФорме(РезультатВыполнения.HTMLРасхождений);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьОтчетОРасхожденияхНаФорме(HTMLТекст)
	
	ОтчетОРасхожденияхHTML = HTMLТекст;
	
	Если Не ПустаяСтрока(HTMLТекст) Тогда
		Элементы.ГруппаОтчета.ТекущаяСтраница = Элементы.ГруппаОтчетОРасхождениях;
		Элементы.ГруппаОтчетОРасхождениях.Видимость = Истина;
	Иначе
		Элементы.ГруппаОтчета.ТекущаяСтраница = Элементы.ГруппаФинансовыеПоказатели;
		Элементы.ГруппаОтчетОРасхождениях.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогСохраненияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог = КаталогСохранения;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	ДиалогВыбораКаталога.Заголовок = "Выберите каталог сохранения XML";
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		КаталогСохранения = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогСохраненияОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(КаталогСохранения) Тогда
		ЗапуститьПриложение(КаталогСохранения);
	КонецЕсли;
	
КонецПроцедуры

// Единственная точка валидации каталога на форме: при пустом значении
// выводит сообщение и возвращает Ложь. Вызывается в командах перед обращением к серверу.
&НаКлиенте
Функция ПроверитьКаталогСохранения()
	
	Если ЗначениеЗаполнено(КаталогСохранения) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Сообщить("Не задан базовый каталог доходности");
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура КомандаНайтиРасхожденияНаСервере(БазовыйКаталог)
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	УстановитьОтчетОРасхожденияхНаФорме(ОбъектНаСервере.НайтиРасхожденияВСохраненныхФайлах(БазовыйКаталог));
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

