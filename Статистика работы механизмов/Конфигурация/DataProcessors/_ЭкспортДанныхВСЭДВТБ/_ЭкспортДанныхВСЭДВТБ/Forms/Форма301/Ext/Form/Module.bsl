
&НаСервере
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов) Экспорт
					
	// Подготовим параметры для передачи в обработку выгрузки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ФинансовыеПоказатели.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
	|ГДЕ
	|	ФинансовыеПоказатели.Период = &Период
	|	И ФинансовыеПоказатели.Организация = &Организация
	|	И (ВЫРАЗИТЬ(ФинансовыеПоказатели.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления)) = &СчетДоверительногоУправления
	|	И ТИПЗНАЧЕНИЯ(ФинансовыеПоказатели.Регистратор) = ТИП(Документ.РегистрацияСтоимостиАктивов)";
	
	Запрос.УстановитьПараметр("Период", 					  Период);
	Запрос.УстановитьПараметр("Организация", 				  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ТекДокумент = Выборка.Регистратор;
		ОбработкаВыгрузки = Обработки.ПечатьИВыгрузка_СЧА_РСА.Создать();  		
		ОбработкаВыгрузки.ДатаИВремяФормирования = ТекущаяДата();
				
		// сформируем файл данных
		ПолноеИмяФайла = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "301\301" +СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + "_" + Формат(Период, "ДФ=dd.MM.yyyy") + ".xml";
	
		Результат = ОбработкаВыгрузки.ПодготовитьРезультатДляВыгрузкиФормы301(ТекДокумент, Справочники.ЮрФизЛица.ПустаяСсылка());

		ТекстВыгрузки = ПодготовитьТекстВыгрузки301(Результат);
		
		Если Результат.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для выгрузки по счету ДУ " + СокрЛП(СчетДоверительногоУправления));
			Возврат Ложь;
		КонецЕсли;
		
		Попытка
			ТекстВыгрузки.Записать(ПолноеИмяФайла, "windows-1251");	
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки формы 301 по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + ": " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для выгрузки по счету ДУ " + СокрЛП(СчетДоверительногоУправления));
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции

&НаСервере
Функция ПодготовитьТекстВыгрузки301(Результат)
	
	// Суммовые показатели формы:
	//	<S010>121312.92</S010> 		// Денежные средства
	//  <S011>121312.92</S011> 		// Денежные средства в рублях
	//  <S012>0</S012>         		// Денежные средства в валюте
	//  <S020>0</S020>         		// Депозиты
	//  <S021>0</S021>         		// Депозиты в рублях
	//  <S022>0</S022>              // Депозиты в валюте
	//  <S030>57657022.84</S030>	// Ценные бумаги
	//  <S031>44885536.46</S031>  	// Государственные ценные бумаги РФ
	//  <S032>0</S032>            	// Государственные ценные бумаги субъектов РФ
	//  <S033>0</S033>            	// Муниципальные облигации
	//  <S034>12450342.1</S034>   	// Облигации российских хозяйственных обществ
	//  <S035>321144.28</S035>    	// Акции российских эмитентов, созданных в форме открытых акционерных обществ
	//  <S036>0</S036>            	// Паи
	//  <S037>0</S037>            	// Акции
	//  <S038>0</S038>            	// Облигации с ипотечным покрытием, выпущенные в соответствии с законодательством РФ об ипотечных ЦБ
	//  <S040>0</S040>            	// Недвижимое имущество
	//  <S050>1360794.8</S050>    	// Дебиторская задолженность
	//  <S051>24111.77</S051>     	// Средства у брокера
	//  <S052>1336507.05</S052>   	// ДЗ по купонному доходу по облигациям
	//  <S053>175.98</S053>       	// Прочая дебиторская задолженность
	//  <S060>830243</S060>       	// Прочие активы
	//  <S070>59969373.56</S070>  	// Итого имущества
	//  <S080>19714.29</S080>     	// Обязательства
	//  <S081>19714.29</S081>     	// Кредиторская задолженность по выплате вознаграждения спецдепу
	//  <S082>0</S082>            	// Кредиторская задолженность по выплате вознаграждения управляющей компании
	//  <S083>0</S083>            	// Кредиторская задолженность по перечислению средств в фонд для исполнения им текущих обязательств
	//  <S084>0</S084>            	// Прочая кредиторская задолженность
	//  <S090>19714.29</S090>     	// Итого сумма обязательств
	//  <S100>59949659.27</S100>  	// Итого стоимость чистых активов

	Кавычки = """";
	ВремяXML = " 00:00:00";
	
	ТекстОтчета = Новый ТекстовыйДокумент;
	     	
	НаименованиеОрганизации = Результат.НаименованиеОрганизации;
			
	// Заголовок файла
	НоваяСтрока = "<?xml version=" + Кавычки + "1.0" + Кавычки + " encoding=" + Кавычки + "windows-1251" + Кавычки + " standalone=""yes""?>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
	
	НоваяСтрока = "<EDO_ODKF301>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
		
	НоваяСтрока = "<ReportOnDate>" + Формат(Результат.ДатаОтчетаДата, "ДФ=dd.MM.yyyy") + " 22:00:00" + "</ReportOnDate>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);		
	
	НоваяСтрока = "<FondName>" + Результат.НаименованиеФонда + "</FondName>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
		
	НоваяСтрока = "<FondINN>" + Результат.ИННФонда +  "</FondINN>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
  	НоваяСтрока = "<FondKPP>" + Результат.КППФонда + "</FondKPP>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<UKName>" + Результат.НаименованиеОрганизации + "</UKName>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<UKINN>" + Результат.ИННОрганизации + "</UKINN>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<UKKPP>" + Результат.КППОрганизации + "</UKKPP>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<DogovorDate>" + Формат(Результат.ДатаДоговора, "ДФ=dd.MM.yyyy") + ВремяXML + "</DogovorDate>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<DogovorNumber>" + Результат.НомерДоговора + "</DogovorNumber>";
    ТекстОтчета.ДобавитьСтроку(НоваяСтрока);
	
	НоваяСтрока = "<DateOfCreate>" + Формат(Результат.ДатаФормирования, "ДЛФ=DT") + "</DateOfCreate>";
	ТекстОтчета.ДобавитьСтроку(НоваяСтрока);	
	
	Для Каждого ЭлементМассива Из Результат.МассивСтрок Цикл 		
		НоваяСтрока = "<S" + ЭлементМассива.КодСтроки + ">" + Формат(ЭлементМассива.СуммаРынок, "ЧРД=.; ЧН=0; ЧГ=0") + "</S" + ЭлементМассива.КодСтроки + ">";
		ТекстОтчета.ДобавитьСтроку(НоваяСтрока);	
	КонецЦикла; 				
	
	ТекстОтчета.ДобавитьСтроку("<UKRespPersonPost></UKRespPersonPost>");
  	ТекстОтчета.ДобавитьСтроку("<UKRespPersonName></UKRespPersonName>");
  	ТекстОтчета.ДобавитьСтроку("<SDRespPersonPost></SDRespPersonPost>");
  	ТекстОтчета.ДобавитьСтроку("<SDRespPersonName></SDRespPersonName>");
	ТекстОтчета.ДобавитьСтроку("</EDO_ODKF301>");
  
	Возврат ТекстОтчета;

КонецФункции
#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

