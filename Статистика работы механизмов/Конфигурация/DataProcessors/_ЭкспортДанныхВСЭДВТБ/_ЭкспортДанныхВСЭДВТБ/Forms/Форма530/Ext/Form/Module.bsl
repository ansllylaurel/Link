&НаСервереБезКонтекста
Функция СериализоватьЗначение(Значение)
	
	Если      ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=");
	Иначе
		Возврат СокрЛП(Значение);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов) Экспорт
	
	Отказ = Ложь;
	
	КаталогФайлов = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\");
	
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогФайлов + "530\МНО", Отказ);
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогФайлов + "530\Депозиты", Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать папки для сохранения 530-х форм.");
		Возврат Ложь;	
	КонецЕсли;

	Если Отказ Тогда
		
	Конецесли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент КАК Контрагент,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам)
		|	И ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НомераОбъектов.ВидНумерации КАК ВидНумерации,
		|	НомераОбъектов.Объект КАК Объект,
		|	НомераОбъектов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000001"" И ""000009""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 6, 1)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000010"" И ""000099""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 5, 2)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""000100"" И ""000999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 4, 3)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""001000"" И ""009999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 3, 4)
		|		КОГДА НомераОбъектов.Номер МЕЖДУ ""010000"" И ""099999""
		|			ТОГДА ПОДСТРОКА(НомераОбъектов.Номер, 2, 5)
		|		ИНАЧЕ НомераОбъектов.Номер
		|	КОНЕЦ КАК Номер
		|ПОМЕСТИТЬ _НомераПодтверждений
		|ИЗ
		|	РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|ГДЕ
		|	НомераОбъектов.Организация = &Организация
		|	И НомераОбъектов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НомераОбъектов.Год = ГОД(&Период)
		|	И НомераОбъектов.ВидНумерации В (ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ГенСоглашения.Контрагент КАК Контрагент,
		|	_ГенСоглашения.Номер КАК Номер,
		|	_ГенСоглашения.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ЕдиничныеГенСоглашения
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ГенСоглашения.Контрагент КАК Контрагент,
		|		МАКСИМУМ(_ГенСоглашения.ДатаЗаключения) КАК ДатаЗаключения
		|	ИЗ
		|		_ГенСоглашения КАК _ГенСоглашения
		|	ГДЕ
		|		НЕ _ГенСоглашения.Номер ЕСТЬ NULL
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ГенСоглашения.СчетДоверительногоУправления,
		|		_ГенСоглашения.Контрагент) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГенСоглашения КАК _ГенСоглашения
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = _ГенСоглашения.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.Контрагент = _ГенСоглашения.Контрагент
		|			И ВложенныйЗапрос.ДатаЗаключения = _ГенСоглашения.ДатаЗаключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК ЭтоДепозит,
		|	НЕ _ЕдиничныеГенСоглашения.Номер ЕСТЬ NULL КАК ЗаполнитьРеквизитыДопДоговора,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДУ,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	_ЕдиничныеГенСоглашения.Номер КАК НомерДоговора,
		|	ВЫБОР
		|		КОГДА _ЕдиничныеГенСоглашения.ДатаЗаключения ЕСТЬ NULL
		|			ТОГДА Распоряжение.ДатаРазмещения
		|		ИНАЧЕ _ЕдиничныеГенСоглашения.ДатаЗаключения
		|	КОНЕЦ КАК ДатаЗаключенияДоговора,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
		|	Распоряжение.Банк.Код КАК БикБанка,
		|	Распоряжение.Процент КАК Процент,
		|	РАЗНОСТЬДАТ(Распоряжение.ДатаРазмещения, Распоряжение.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	_НомераПодтверждений.Номер КАК НомерПодтверждения,
		|	ВЫБОР
		|		КОГДА _ЕдиничныеГенСоглашения.ДатаЗаключения ЕСТЬ NULL
		|			ТОГДА ""Заключение Договора срочного депозита. Выплата процентов - ПериодичностьВыплатыПроцентов. Перечисление денежных средств в сумме, указанной в Договоре, осуществляется не позднее двух рабочих дней, следующих за днем подписания настоящего Договора.""
		|		ИНАЧЕ ""Заключение Подтверждение Сделки привлечения денежных средств НомерДатаПодтверждения""
		|	КОНЕЦ КАК Инфо,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов
		|ПОМЕСТИТЬ _ДанныеДокументов
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НомераПодтверждений КАК _НомераПодтверждений
		|		ПО Распоряжение.Ссылка = _НомераПодтверждений.Объект
		|			И (_НомераПодтверждений.ВидНумерации В (ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЕдиничныеГенСоглашения КАК _ЕдиничныеГенСоглашения
		|		ПО Распоряжение.СчетДоверительногоУправления = _ЕдиничныеГенСоглашения.СчетДоверительногоУправления
		|			И Распоряжение.Банк.ЮрФизЛицо = _ЕдиничныеГенСоглашения.Контрагент
		|ГДЕ
		|	Распоряжение.Организация = &Организация
		|	И Распоряжение.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	И НАЧАЛОПЕРИОДА(Распоряжение.ДатаРазмещения, ДЕНЬ) = &Период
		|	И НЕ Распоряжение.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	ИСТИНА,
		|	РаспоряжениеНаМНО.СчетДоверительногоУправления,
		|	РаспоряжениеНаМНО.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления,
		|	РаспоряжениеНаМНО.Дата,
		|	РаспоряжениеНаМНО.РасчетныйСчет.ДоговорМНО.НомерДоговора,
		|	РаспоряжениеНаМНО.РасчетныйСчет.ДоговорМНО.ДатаЗаключения,
		|	РаспоряжениеНаМНО.ДатаВозврата,
		|	РаспоряжениеНаМНО.Сумма,
		|	РаспоряжениеНаМНО.Валюта,
		|	РаспоряжениеНаМНО.РасчетныйСчет.Банк.ЮрФизЛицо,
		|	РаспоряжениеНаМНО.РасчетныйСчет.Банк.Код,
		|	РаспоряжениеНаМНО.Процент,
		|	РАЗНОСТЬДАТ(РаспоряжениеНаМНО.Дата, РаспоряжениеНаМНО.ДатаВозврата, ДЕНЬ),
		|	_НомераПодтверждений.Номер,
		|	""Подтверждение направлено в соответствии с Ген.соглашением о порядке поддержания минимального неснижаемого остатка"",
		|	""""
		|ИЗ
		|	Документ.Распоряжение КАК РаспоряжениеНаМНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НомераПодтверждений КАК _НомераПодтверждений
		|		ПО РаспоряжениеНаМНО.Ссылка = _НомераПодтверждений.Объект
		|			И (_НомераПодтверждений.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(РаспоряжениеНаМНО.Дата, ДЕНЬ) = &Период
		|	И РаспоряжениеНаМНО.Организация = &Организация
		|	И РаспоряжениеНаМНО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РаспоряжениеНаМНО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|	И НЕ РаспоряжениеНаМНО.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.КПП КАК КПП,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН
		|ПОМЕСТИТЬ _РеквизитыЮрЛицБанков
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ
		|						_ДанныеДокументов.БанкЮрЛицо
		|					ИЗ
		|						_ДанныеДокументов КАК _ДанныеДокументов)) КАК РеквизитыЮридическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДокументов.ЭтоДепозит КАК _ФлДепозит,
		|	_ДанныеДокументов.НомерПодтверждения КАК _Номер,
		|	_ДанныеДокументов.Сумма КАК _Сумма,
		|	_ДанныеДокументов.ПериодичностьВыплатыПроцентов КАК _ПериодичностьВыплатыПроцентов,
		|	_ДанныеДокументов.ЗаполнитьРеквизитыДопДоговора КАК _ЗаполнитьРеквизитыДопДоговора,
		|	_ДанныеДокументов.Инфо КАК Info,
		|	_ДанныеДокументов.ДатаРазмещения КАК RequestDate,
