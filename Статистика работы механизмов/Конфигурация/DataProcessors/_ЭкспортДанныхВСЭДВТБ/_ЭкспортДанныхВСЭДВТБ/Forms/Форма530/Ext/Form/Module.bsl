		|		ИНАЧЕ _ДанныеДокументов.Валюта.Наименование
		|	КОНЕЦ КАК DogCurr,
		|	ИнвестиционныйСчет.Значение КАК IDInvestcase,
		|	КодДоговораСпецдепа.Значение КАК SDDogovorNumber,
		|	ДатаДоговораСпецдепа.Значение КАК SDDogovorDate,
		|	ВЫБОР
		|		КОГДА _ДанныеДокументов.ЭтоДепозит
		|			ТОГДА 0
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК DogName,
		|	ВЫБОР
		|		КОГДА _ДанныеДокументов.ЗаполнитьРеквизитыДопДоговора
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК DopDogFlag1,
		|	ВЫБОР
		|		КОГДА _ДанныеДокументов.ВидДоговораДУ В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР))
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК DopDogFlag5,
		|	ВЫБОР
		|		КОГДА _ДанныеДокументов.ВидДоговораДУ В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР))
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК DopDogFlag6,
		|	ВЫБОР
		|		КОГДА НЕ _ДанныеДокументов.ЗаполнитьРеквизитыДопДоговора
		|			ТОГДА _ДанныеДокументов.Срок
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК DogSrok,
		|	ВЫБОР
		|		КОГДА НЕ _ДанныеДокументов.ЗаполнитьРеквизитыДопДоговора
		|			ТОГДА _ДанныеДокументов.Сумма
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК DogSumm,
		|	ВЫБОР
		|		КОГДА НЕ _ДанныеДокументов.ЗаполнитьРеквизитыДопДоговора
		|			ТОГДА _ДанныеДокументов.Процент
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК DogProcent
		|ИЗ
		|	_ДанныеДокументов КАК _ДанныеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрЛицБанков КАК _РеквизитыЮрЛицБанков
		|		ПО _ДанныеДокументов.БанкЮрЛицо = _РеквизитыЮрЛицБанков.ЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ИнвестиционныйСчет
		|		ПО _ДанныеДокументов.СчетДоверительногоУправления = ИнвестиционныйСчет.Объект
		|			И (ИнвестиционныйСчет.Свойство.Ключ = &КлючИнвестСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК КодДоговораСпецдепа
		|		ПО _ДанныеДокументов.СчетДоверительногоУправления = КодДоговораСпецдепа.Объект
		|			И (КодДоговораСпецдепа.Свойство.Ключ = &КлючКодДоговораСпецДепа)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаДоговораСпецдепа
		|		ПО _ДанныеДокументов.СчетДоверительногоУправления = ДатаДоговораСпецдепа.Объект
		|			И (ДатаДоговораСпецдепа.Свойство.Ключ = &КлючДатаДоговораСпецДепа)";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("КлючИнвестСчет", "ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.ИнвестСчет");
	Запрос.УстановитьПараметр("КлючКодДоговораСпецДепа", "ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.КодДоговораСпецДепа");
	Запрос.УстановитьПараметр("КлючДатаДоговораСпецДепа", "ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.ДатаДоговораСпецДепа");
	Запрос.УстановитьПараметр("РоссийскийРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("Сбер", ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_Сбер"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML = Новый ЗаписьXML;
		
		Попытка
			ЗаписьXML.ОткрытьФайл(КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "530\" + ?(Выборка._ФлДепозит, "Депозиты\", "МНО\") + СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + "-" + ?(Выборка._ФлДепозит, Выборка._Сумма,  Выборка._Номер) + ".xml", "WINDOWS-1251");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + ". Выгрузка отменена по счету ДУ [" + СокрЛП(СчетДоверительногоУправления) + "]");
			Прервать;
		КонецПопытки;
		
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("EDO_ODKF530");
				
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			
			Если Лев(Колонка.Имя, 1) = "_" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Колонка.Имя = "DopDogNumber" И ЗначениеЗаполнено(Выборка.DopDogNumber) Тогда
				
				ТекстЭлемента = "Подтверждение №" + Выборка.DopDogNumber;
				
			ИначеЕсли Колонка.Имя = "DogNumber" Тогда
				
				ТекстЭлемента = СтрЗаменить(Выборка.DogNumber, "Ген. соглашение ", "");
				
			ИначеЕсли Колонка.Имя = "Info" Тогда
				
				ТекстЭлемента = СтрЗаменить(Выборка.Info, "ПериодичностьВыплатыПроцентов", СокрЛП(НРег(Выборка._ПериодичностьВыплатыПроцентов)));		
				
				Если СтрНайти(Выборка.Info, "НомерДатаПодтверждения") > 0 Тогда
					
					ТекстЭлемента = СтрЗаменить(Выборка.Info, "НомерДатаПодтверждения", "№ " + Выборка._Номер + " от " + Формат(Выборка.RequestDate, "ДФ='dd.MM.yyyy ''г.'''"));
					
					Если Выборка._ЗаполнитьРеквизитыДопДоговора И Не ЗначениеЗаполнено(Выборка._Номер) Тогда
					    ТекстЭлемента = СтрЗаменить(Выборка.Info, "НомерДатаПодтверждения", "№ НОМЕР БАНКОВСКОГО ПОДТВЕРЖДЕНИЯ от " + Формат(Выборка.RequestDate, "ДФ='dd.MM.yyyy ''г.'''"));
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке данных в СЭД укажите [номер банковского подтверждения] в 530 форме в поле [Иные существенные условия сделки] для счета ДУ [" + СокрЛП(СчетДоверительногоУправления) + "]");
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				ТекстЭлемента = СериализоватьЗначение(Выборка[Колонка.Имя]);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстЭлемента) Тогда
			
				ЗаписьXML.ЗаписатьНачалоЭлемента(Колонка.Имя);
				ЗаписьXML.ЗаписатьТекст(ТекстЭлемента);
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Колонка.Имя
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // EDO_ODKF
		ЗаписьXML.Закрыть();
		
	КонецЦикла;
	
КонецФункции

