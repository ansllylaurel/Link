&НаСервере
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов, Ответственный, ДолжностьОтветственного) Экспорт
	
	Если Не (ЗначениеЗаполнено(Ответственный) И ЗначениеЗаполнено(ДолжностьОтветственного)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выгрузки формы 220 необходимо указать руководителя и его должность");
		Возврат Ложь;
	КонецЕсли;
	
	Данные = РаботаСОтчетами.ДанныеДляРасчетаМинимальнойДостаточности(Организация, Период);
	
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидыДоговоровБаланс = Новый Массив;
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	ВидыДоговоровБаланс.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	
	ИтогоСЧА = 0;
	Для Каждого ТекСтрока Из Данные Цикл		
		Если ВидыДоговоровБаланс.Найти(ТекСтрока.ВидДоговораДоверительногоУправления) <> Неопределено Тогда 
			ИтогоСЧА = ИтогоСЧА + ТекСтрока.Баланс;
		Иначе
			ИтогоСЧА = ИтогоСЧА + ТекСтрока.СЧА;
		КонецЕсли;		
	КонецЦикла;
	
	// Расчет минимального размера собственных средств УК
	ВеличинаПревышенияНадТремяМиллиардами = ?(ИтогоСЧА - 3000000000>0, ИтогоСЧА - 3000000000, 0);
	РасчетМинимальныхСредств = 20000000 + ВеличинаПревышенияНадТремяМиллиардами * 0.0002;
	МинимальныйРазмерСобственныхСредствУК = Мин(80000000, РасчетМинимальныхСредств);
	
	СобственныеСредстваУК = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(Организация, Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ФинансовыеПоказатели.Значение КАК РСА
		|ПОМЕСТИТЬ _Показатели
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.РыночнаяСтоимостьАктивов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	_Показатели.РСА КАК РСА,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИННОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КППОрганизации
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Показатели КАК _Показатели
		|		ПО (_Показатели.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО СчетаДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)";

	
	Запрос.УстановитьПараметр("Период", 					  Период);
	Запрос.УстановитьПараметр("Организация", 				  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ТекстОтчета = Новый ТекстовыйДокумент;

		Кавычки = """";
				
		ТекстОтчета.ДобавитьСтроку("<?xml version=" + Кавычки + "1.0" + Кавычки + " encoding=" + Кавычки + "windows-1251" + Кавычки + " standalone=""yes""?>");
  		ТекстОтчета.ДобавитьСтроку("<EDO_ODKF220>");
  		ТекстОтчета.ДобавитьСтроку("<ReportOnDate>" + Формат(Период, "ДФ=dd.MM.yyyy") + "</ReportOnDate>");
        ТекстОтчета.ДобавитьСтроку("<OwnFundsNorma>" + Формат(МинимальныйРазмерСобственныхСредствУК, "ЧДЦ=2; ЧС=6; ЧРД=.; ЧГ=0") + "</OwnFundsNorma>");
  		ТекстОтчета.ДобавитьСтроку("<OwnFundsFact>" + Формат(СобственныеСредстваУК, "ЧДЦ=2; ЧС=6; ЧРД=.; ЧГ=0") + "</OwnFundsFact>");
		ТекстОтчета.ДобавитьСтроку("<ActivCostFact>" + Формат(Выборка.РСА, "ЧДЦ=2; ЧС=6; ЧРД=.; ЧГ=0") + "</ActivCostFact>");
		ТекстОтчета.ДобавитьСтроку("<RespPerson>" + СокрЛП(Ответственный) + "</RespPerson>");
		ТекстОтчета.ДобавитьСтроку("<UKName>" + Выборка.ПолноеНаименованиеОрганизации + " Д.У. средствами пенсионных накоплений</UKName>");
		ТекстОтчета.ДобавитьСтроку("<UKINN>" + Выборка.ИННОрганизации + "</UKINN>");
		ТекстОтчета.ДобавитьСтроку("<KPP>" + Выборка.КППОрганизации + "</KPP>");
		ТекстОтчета.ДобавитьСтроку("<Post>" + СокрЛП(ДолжностьОтветственного) + "</Post>");		
		ТекстОтчета.ДобавитьСтроку("</EDO_ODKF220>");
						
		// сформируем файл данных
		ПолноеИмяФайла = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "F220_ПФР_" + Формат(Период, "ДФ=dd.MM.yyyy") + ".xml";
		
		Попытка
			ТекстОтчета.Записать(ПолноеИмяФайла, "windows-1251");		
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки формы 220 по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + " " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции 
