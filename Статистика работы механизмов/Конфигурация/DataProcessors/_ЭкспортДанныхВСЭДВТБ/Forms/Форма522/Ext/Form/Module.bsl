		|					КОГДА _БиржевыеПокупкиПродажи._ЦеннаяБумага.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА ""Субфедеральная бумага""
		|					КОГДА _БиржевыеПокупкиПродажи._ЦеннаяБумага.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""Корпоративная облигация""
		|					КОГДА _БиржевыеПокупкиПродажи._ЦеннаяБумага.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА ""Муниципальная бумага""
		|					ИНАЧЕ ""Облигация""
		|				КОНЕЦ
		|		КОГДА _БиржевыеПокупкиПродажи._Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ""Паи""
		|	КОНЕЦ КАК CBKind,
		|	ЮрЛицоЭмитента.ПолноеНаименованиеПоУставу КАК Emitent,
		|	_БиржевыеПокупкиПродажи._ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК GRN,
		|	ВЫБОР
		|		КОГДА _БиржевыеПокупкиПродажи._Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_БиржевыеПокупкиПродажи._ЦеннаяБумага КАК Справочник.Акции).НомерВыпуска
		|		КОГДА _БиржевыеПокупкиПродажи._Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_БиржевыеПокупкиПродажи._ЦеннаяБумага КАК Справочник.Облигации).НомерВыпуска
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК ReleaseNumber,
		|	ВЫБОР
		|		КОГДА _БиржевыеПокупкиПродажи._Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_БиржевыеПокупкиПродажи._ЦеннаяБумага КАК Справочник.Акции).Тип
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК CBCategory,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ExchangeNumber,
		|	ВЫБОР
		|		КОГДА _БиржевыеПокупкиПродажи._Ссылка ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ЕСТЬNULL(ВТ_КомиссииПоСделке.ТорговаяКомиссияЗаДень, 0)
		|		КОГДА _БиржевыеПокупкиПродажи._ОплатаРПС
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ВТ_КомиссииПоСделке.ТорговаяКомиссия, 0)
		|	КОНЕЦ КАК ExchangeFees,
		|	ВЫБОР
		|		КОГДА _БиржевыеПокупкиПродажи._Ссылка ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ЕСТЬNULL(ВТ_КомиссииПоСделке.КомиссияБрокераЗаДень, 0)
		|		КОГДА _БиржевыеПокупкиПродажи._ОплатаРПС
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ВТ_КомиссииПоСделке.КомиссияБрокера, 0)
		|	КОНЕЦ КАК BrokerFees,
		|	0 КАК BrokerFeesNach,
		|	_БиржевыеПокупкиПродажи._Основание КАК _Основание,
		|	ЕСТЬNULL(ЮрЛицоРаскрытогоКонтрагента.КраткоеНаименованиеПоУставу, """") КАК _Контрагент
		|ИЗ
		|	_БиржевыеПокупкиПродажи КАК _БиржевыеПокупкиПродажи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоЭмитента
		|		ПО _БиржевыеПокупкиПродажи._ЦеннаяБумага.Эмитент.ЮрФизЛицо = ЮрЛицоЭмитента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК РаскрытыеКонтрагенты
		|		ПО _БиржевыеПокупкиПродажи._Ссылка = РаскрытыеКонтрагенты.Объект
		|			И (РаскрытыеКонтрагенты.Свойство.Ключ = ""_РаскрытыйКонтрагент"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоРаскрытогоКонтрагента
		|		ПО (РаскрытыеКонтрагенты.Значение = ЮрЛицоРаскрытогоКонтрагента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомиссииПоСделке КАК ВТ_КомиссииПоСделке
		|		ПО _БиржевыеПокупкиПродажи._Основание = ВТ_КомиссииПоСделке.Сделка
		|			И _БиржевыеПокупкиПродажи._ЦеннаяБумага = ВТ_КомиссииПоСделке.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _БиржевыеПокупкиПродажи._ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				Организация = &Организация
		|					И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
		|					И НЕ Аванс
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ПО _БиржевыеПокупкиПродажи._Основание = ЗадолженностиПоДенежнымСредствамОстатки.Основание
		|
		|УПОРЯДОЧИТЬ ПО
		|	_БиржевыеПокупкиПродажи._НомерСделки";
	#КонецОбласти
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Валюта",                       Валюта);

	РезультатЗапроса = Запрос.Выполнить();
	
	РаботаСОтчетами.КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(СчетДоверительногоУправления,,, РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("_Основание")); 
	
	Выборка = РезультатЗапроса.Выбрать();

	ИндСделки = 0;
	
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("CB");
		
		ИндСделки = ИндСделки + 1;
		
		ЗаписатьЭлементXML(ЗаписьXML, "DealNum", ИндСделки);
		ЗаписатьЭлементXML(ЗаписьXML, "DopInfo", "" + Выборка._ВидСделки + ", " + Выборка._НомерСделки + ", " + Формат(Выборка._ДатаСделки, "ДФ=dd.MM.yyyy") 
					+ ?(ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами 
						И Выборка._РежимПереговорныхСделок 
						И Не ПустаяСтрока(Выборка._Контрагент), ". Контрагент: " + Выборка._Контрагент, ""));
		
		ВидОперации = ПолучитьВидОперацииСЦеннымиБумагами(Выборка, ВидДоговораДоверительногоУправления, ДополнительныеНастройки);
		
		ЗаписатьЭлементXML(ЗаписьXML, "OperKind",      ВидОперации.Код + " - " + ВидОперации.Наименование);
		ЗаписатьЭлементXML(ЗаписьXML, "IDDocOperType", ВидОперации.Код);
		
		ЗаписатьЭлементXML(ЗаписьXML, "ExchangeName",
			ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(ДополнительныеНастройки, "НаименованиеБиржи", Выборка._Биржа));
			
		ЗаписатьЭлементXML(ЗаписьXML, "DealNumInTrade", Выборка._НомерСделки);
			
		КатегорияФинансовогоИнструмента = ПолучитьКатегориюФинансовогоИнструмента(Выборка, Период);
		ЗаписатьЭлементXML(ЗаписьXML, "CategoryFI", КатегорияФинансовогоИнструмента);
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если Лев(Колонка.Имя, 1) = "_" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Колонка.Имя = "DealTime" Тогда
				ЗнчЭлемента = Формат(Выборка.DealTime, "ДЛФ=T");   
			Иначе
				ЗнчЭлемента = Выборка[Колонка.Имя];
			КонецЕсли;
			
			ЗаписатьЭлементXML(ЗаписьXML, Колонка.Имя, ЗнчЭлемента);
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // CB
	КонецЦикла;

КонецПроцедуры 

&НаСервереБезКонтекста
Процедура ВыгрузитьРепо(ЗаписьXML, Организация, СчетДоверительногоУправления, Брокер, Валюта, Период, ДополнительныеНастройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкаРепо.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкаРепо.Ссылка КАК _Ссылка,
		|	ВЫБОР
		|		КОГДА _СделкаРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК DealType,
		|	ВЫБОР
		|		КОГДА _СделкаРепо.СделкаСЦентральнымКонтрагентом
		|			ТОГДА _СделкаРепо.НомерСделкиСЦентральнымКонтрагентом
		|		ИНАЧЕ _СделкаРепо.НомерСделки
		|	КОНЕЦ КАК DogovorNumber,
		|	_СделкаРепо.МестоХранения КАК _МестоХранения,
		|	_СделкаРепо.Контрагент КАК Контрагент,
		|	_СделкаРепо.СтавкаРЕПО КАК RepoProc,
		|	РАЗНОСТЬДАТ(_СделкаРепо.Дата, УсловияСделокРЕПОПерваяЧастьСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК RepoDaysQty,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.ЦеннаяБумага КАК _ЦеннаяБумага,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.ДепозитарныйСчет КАК _ДепозитарныйСчет,
		|	_СделкаРепо.Дата КАК DealTime,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Количество КАК Qty,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Цена КАК Price1,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Сумма КАК Amount1,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.СуммаКупона КАК NKD1,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.Цена КАК Price2,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.Сумма КАК Amount2,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.СуммаКупона КАК NKD2
		|ПОМЕСТИТЬ _БиржевыеПокупкиПродажиРепо
		|ИЗ
		|	Документ.СделкаРЕПО КАК _СделкаРепо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&Период, ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОПерваяЧастьСрезПоследних
		|		ПО _СделкаРепо.Ссылка = УсловияСделокРЕПОПерваяЧастьСрезПоследних.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&Период, ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПОВтораяЧастьСрезПоследних
		|		ПО _СделкаРепо.Ссылка = УсловияСделокРЕПОВтораяЧастьСрезПоследних.СделкаРЕПО
		|ГДЕ
		|	_СделкаРепо.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И _СделкаРепо.Организация = &Организация
		|	И _СделкаРепо.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И _СделкаРепо.Брокер = &Брокер
		|	И _СделкаРепо.Проведен
		|	И _СделкаРепо.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И _СделкаРепо.ЧастьСделкиРЕПО = 1
		|	И _СделкаРепо.ВалютаСделки = &Валюта
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_СделкаРепо.ЧастьСделкиРЕПО,
		|	_СделкаРепо.Ссылка,
		|	ВЫБОР
		|		КОГДА _СделкаРепо.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА _СделкаРепо.СделкаСЦентральнымКонтрагентом
		|			ТОГДА _СделкаРепо.НомерСделкиСЦентральнымКонтрагентом
		|		ИНАЧЕ _СделкаРепо.НомерСделки
		|	КОНЕЦ,
		|	_СделкаРепо.МестоХранения,
		|	_СделкаРепо.Контрагент,
		|	_СделкаРепо.ПерваяЧастьРЕПО.СтавкаРЕПО,
		|	РАЗНОСТЬДАТ(_СделкаРепо.ПерваяЧастьРЕПО.Дата, УсловияСделокРЕПОВтораяЧастьСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ),
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.ЦеннаяБумага,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.ДепозитарныйСчет,
		|	_СделкаРепо.ПерваяЧастьРЕПО.Дата,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Количество,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Цена,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.Сумма,
		|	УсловияСделокРЕПОПерваяЧастьСрезПоследних.СуммаКупона,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.Цена,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.Сумма,
		|	УсловияСделокРЕПОВтораяЧастьСрезПоследних.СуммаКупона
		|ИЗ
		|	Документ.СделкаРЕПО КАК _СделкаРепо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&Период, ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОПерваяЧастьСрезПоследних
		|		ПО _СделкаРепо.ПерваяЧастьРЕПО = УсловияСделокРЕПОПерваяЧастьСрезПоследних.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&Период, ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПОВтораяЧастьСрезПоследних
		|		ПО _СделкаРепо.ПерваяЧастьРЕПО = УсловияСделокРЕПОВтораяЧастьСрезПоследних.СделкаРЕПО
		|ГДЕ
		|	_СделкаРепо.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И _СделкаРепо.Организация = &Организация
		|	И _СделкаРепо.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И _СделкаРепо.Брокер = &Брокер
		|	И _СделкаРепо.Проведен
		|	И _СделкаРепо.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И _СделкаРепо.ЧастьСделкиРЕПО = 2
		|	И _СделкаРепо.ВалютаСделки = &Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БиржевыеПокупкиПродажиРепо._Ссылка КАК _Ссылка,
		|	_БиржевыеПокупкиПродажиРепо.DealType КАК DealType,
		|	_БиржевыеПокупкиПродажиРепо.DealTime КАК DealTime,
		|	ЮрЛицоЭмитента.ПолноеНаименованиеПоУставу КАК EmitentName,
		|	_БиржевыеПокупкиПродажиРепо._ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК GRN,
		|	_БиржевыеПокупкиПродажиРепо.Qty КАК Qty,
		|	_БиржевыеПокупкиПродажиРепо.Price1 КАК Price1,
		|	_БиржевыеПокупкиПродажиРепо.NKD1 КАК NKD1,
		|	_БиржевыеПокупкиПродажиРепо.Amount1 КАК Amount1,
		|	_БиржевыеПокупкиПродажиРепо.Price2 КАК Price2,
		|	_БиржевыеПокупкиПродажиРепо.NKD2 КАК NKD2,
		|	_БиржевыеПокупкиПродажиРепо.Amount2 КАК Amount2,
		|	_БиржевыеПокупкиПродажиРепо.RepoProc КАК RepoProc,
		|	_БиржевыеПокупкиПродажиРепо.RepoDaysQty КАК RepoDaysQty,
		|	ЮрЛицоКонтрагента.ПолноеНаименованиеПоУставу КАК RepoContragent,
		|	_БиржевыеПокупкиПродажиРепо.DogovorNumber КАК DogovorNumber,
		|	_БиржевыеПокупкиПродажиРепо._МестоХранения.Биржа КАК _Биржа
		|ИЗ
		|	_БиржевыеПокупкиПродажиРепо КАК _БиржевыеПокупкиПродажиРепо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоЭмитента
		|		ПО _БиржевыеПокупкиПродажиРепо._ЦеннаяБумага.Эмитент.ЮрФизЛицо = ЮрЛицоЭмитента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоКонтрагента
		|		ПО (_БиржевыеПокупкиПродажиРепо.Контрагент = ЮрЛицоЭмитента.ЮрФизЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_БиржевыеПокупкиПродажиРепо.DogovorNumber";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Период",                       КонецДня(Период));
	Запрос.УстановитьПараметр("Валюта",                       Валюта);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Repo");
		
		ЗаписатьЭлементXML(ЗаписьXML, "ExchangeName",
		ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(ДополнительныеНастройки, "НаименованиеБиржи", Выборка._Биржа));
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если Лев(Колонка.Имя, 1) = "_" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Колонка.Имя = "DealTime" Тогда
				ЗнчЭлемента = Формат(Выборка.DealTime,  "");
			Иначе
				ЗнчЭлемента = Выборка[Колонка.Имя];
			КонецЕсли;
			
			ЗаписатьЭлементXML(ЗаписьXML, Колонка.Имя, ЗнчЭлемента);
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Repo
	КонецЦикла;

КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьКатегориюФинансовогоИнструмента(Выборка, Период)
	Если Выборка._Рынок = Перечисления.РынкиЦенныхБумаг.Акции
		Или Выборка._Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
		Или Выборка._Рынок = Перечисления.РынкиЦенныхБумаг.Паи
	Тогда
		// Проверяем, было ли переопределение учётного актива
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РаспределенияАктивовЕПС.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	РаспределенияАктивовЕПС.УчетныйАктивЕПС.Родитель КАК УчетныйАктивЕПСРодитель,
			|	РаспределенияАктивовЕПС.Количество КАК Количество
			|ИЗ
			|	РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
			|ГДЕ
			|	РаспределенияАктивовЕПС.Сделка В(&МассивДокументов)
			|	И РаспределенияАктивовЕПС.ЦеннаяБумага = &ЦеннаяБумага";
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Выборка._Ссылка);
		МассивДокументов.Добавить(Выборка._Основание);
		
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		Запрос.УстановитьПараметр("ЦеннаяБумага", Выборка._ЦеннаяБумага);
		
		ВыборкаУчетныхАктивов = Запрос.Выполнить().Выбрать();
		Если ВыборкаУчетныхАктивов.Следующий() Тогда
			Если ВыборкаУчетныхАктивов.Количество = Выборка.Qty Тогда
				// Определяем КФИ по группе учётного актива
				ЧисловаяКлассификацияЦенныхБумаг = Справочники.УчетныеАктивыЕПС.ПолучитьЧисловуюКлассификациюЦенныхБумаг(
					ВыборкаУчетныхАктивов.УчетныйАктивЕПСРодитель, Период);
				Если ЧисловаяКлассификацияЦенныхБумаг <> Неопределено Тогда
					Возврат ЧисловаяКлассификацияЦенныхБумаг;
				КонецЕсли;
				// Заглушка на случай добавления новых групп
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить категорию финансового инструмента для ценной бумаги "
					+ Выборка._ЦеннаяБумага + " по сделке " + Выборка._Ссылка);
				Возврат 0;
			КонецЕсли;
		Иначе
			// Для паёв, акций и облигаций значение по умолчанию 1
			Возврат 1;
		КонецЕсли;
	Иначе
		// Пока не реализовано, обрабатывается вручную
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить категорию финансового инструмента для ценной бумаги "
			+ Выборка._ЦеннаяБумага + " по сделке " + Выборка._Ссылка);
		Возврат 0;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Процедура ВыгрузитьДвиженияДенежныхСредств(ЗаписьXML, Организация, СчетДоверительногоУправления, Брокер, ИспользоватьВалютнуюСекцию, Валюта, ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX)
	
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.ВидДвижения КАК ВидДвижения,
		|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА СУММА(ОстаткиДенежныхСредств.Сумма)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Зачисление,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА СУММА(ОстаткиДенежныхСредств.Сумма)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Списание,
		|	ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаРЕПО, ЛОЖЬ) КАК ПоСделкеРЕПО,
		|	ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой) КАК СделкаСВалютой,
		|	ОстаткиДенежныхСредств.МестоХранения = &РазделFX
		|		ИЛИ ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой) КАК ВалютнаяСекция,
		|	ОстаткиДенежныхСредствВтораяЧасть.МестоХранения = &РазделFX КАК ВалютнаяСекция2,
		|	ОстаткиДенежныхСредств.Валюта = ОстаткиДенежныхСредств.Организация.ВалютаУчета КАК ВВалютеУчета
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО ОстаткиДенежныхСредств.Регистратор = ОплатаОснования.Ссылка
		|			И (ОплатаОснования.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредствВтораяЧасть
		|		ПО ОстаткиДенежныхСредств.Период = ОстаткиДенежныхСредствВтораяЧасть.Период
		|			И ОстаткиДенежныхСредств.Регистратор = ОстаткиДенежныхСредствВтораяЧасть.Регистратор
		|			И ОстаткиДенежныхСредств.ВидДвижения <> ОстаткиДенежныхСредствВтораяЧасть.ВидДвижения
		|			И (ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств))
		|			И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ОстаткиДенежныхСредствВтораяЧасть.ВариантДвиженияДенежныхСредств
		|			И ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ОстаткиДенежныхСредствВтораяЧасть.ВидДвиженияДенежныхСредств
		|			И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ОстаткиДенежныхСредствВтораяЧасть.ВариантДвиженияДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиДенежныхСредств.Валюта = &Валюта
		|	И ОстаткиДенежныхСредств.Активность
		|	И ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.Брокер = &Брокер
		|	И (НЕ &ИспользоватьВалютнуюСекцию
		|			ИЛИ &ИспользоватьВалютнуюСекцию
		|				И &ВалютнаяСекция
		|				И (ОстаткиДенежныхСредств.МестоХранения = &РазделFX
		|					ИЛИ ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой))
		|			ИЛИ &ИспользоватьВалютнуюСекцию
		|				И НЕ &ВалютнаяСекция
		|				И НЕ(ОстаткиДенежныхСредств.МестоХранения = &РазделFX
		|						ИЛИ ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой)))
		|	И ВЫБОР
		|			КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
		|					И ОстаткиДенежныхСредств.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровБезПереводовВнутриБрокера)
		|				ТОГДА ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера), ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет))
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредств.ВидДвижения,
		|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств,
		|	ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаРЕПО, ЛОЖЬ),
		|	ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой),
		|	ОстаткиДенежныхСредств.МестоХранения = &РазделFX
		|		ИЛИ ЕСТЬNULL(ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой, ОстаткиДенежныхСредств.Регистратор ССЫЛКА Документ.СделкаСВалютой),
		|	ОстаткиДенежныхСредствВтораяЧасть.МестоХранения = &РазделFX,
		|	ОстаткиДенежныхСредств.Валюта = ОстаткиДенежныхСредств.Организация.ВалютаУчета";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Валюта",                       Валюта);
	Запрос.УстановитьПараметр("Период",                       Период);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютнуюСекцию",   ИспользоватьВалютнуюСекцию);
	Запрос.УстановитьПараметр("РазделFX",                     РазделFX);
	Запрос.УстановитьПараметр("ВалютнаяСекция",               ВалютнаяСекция);
	
	ВидыДоговоровБезПереводовВнутриБрокера = Новый Массив;
	ВидыДоговоровБезПереводовВнутриБрокера.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	
	Запрос.УстановитьПараметр("ВидыДоговоровБезПереводовВнутриБрокера", ВидыДоговоровБезПереводовВнутриБрокера);
	
	ТаблицаДенежныхСредств = Запрос.Выполнить().Выгрузить();
	ТаблицаДенежныхСредств.Колонки.Добавить("Код", 			Новый ОписаниеТипов("Строка"));
	ТаблицаДенежныхСредств.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	
	Для каждого СтрокаТаблицыДенежныхСредств Из ТаблицаДенежныхСредств Цикл
		 ВидОперации = ПолучитьВидОперацииСДенежнымиСредствами(СтрокаТаблицыДенежныхСредств, ВидДоговораДоверительногоУправления);
		 СтрокаТаблицыДенежныхСредств.Код 			= ВидОперации.Код;
		 СтрокаТаблицыДенежныхСредств.Наименование 	= ВидОперации.Наименование;
	КонецЦикла;  
	 
	ТаблицаДенежныхСредств.Свернуть("Код, Наименование", "Зачисление, Списание"); 
	
	Для каждого СтрокаТаблицыДенежныхСредств Из ТаблицаДенежныхСредств Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("MoneySupply");
				
		ЗаписатьЭлементXML(ЗаписьXML, "OperDate",        Период);
		ЗаписатьЭлементXML(ЗаписьXML, "IDDocOperType",   СтрокаТаблицыДенежныхСредств.Код);
		ЗаписатьЭлементXML(ЗаписьXML, "OperKind",        СтрокаТаблицыДенежныхСредств.Код + " - " + СтрокаТаблицыДенежныхСредств.Наименование);
		ЗаписатьЭлементXML(ЗаписьXML, "EnrolmentAmount", СтрокаТаблицыДенежныхСредств.Зачисление);
		ЗаписатьЭлементXML(ЗаписьXML, "ChargeOff",       СтрокаТаблицыДенежныхСредств.Списание);
		ЗаписатьЭлементXML(ЗаписьXML, "PayKind",         "");
		ЗаписатьЭлементXML(ЗаписьXML, "DopInfo",         "");
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // MoneySupply
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыгрузитьНачисленияЗадолженности(ЗаписьXML, Организация, СчетДоверительногоУправления, Брокер, ИспользоватьВалютнуюСекцию, Валюта, ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БрокерскиеКомпании КАК БрокерскиеКомпании
		|		ПО ЗадолженностиПоДенежнымСредствам.Контрагент = БрокерскиеКомпании.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО ЗадолженностиПоДенежнымСредствам.Основание = СделкаСВалютой.Ссылка
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ЗадолженностиПоДенежнымСредствам.Активность
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Валюта = &Валюта
		|	И БрокерскиеКомпании.Ссылка = &Брокер
		|	И (НЕ &ИспользоватьВалютнуюСекцию
		|			ИЛИ &ИспользоватьВалютнуюСекцию
		|				И &ВалютнаяСекция)
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) > 0";
		
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Валюта",                       Валюта);
	Запрос.УстановитьПараметр("Период",                       Период);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютнуюСекцию",   ИспользоватьВалютнуюСекцию);
	Запрос.УстановитьПараметр("РазделFX",                     РазделFX);
	Запрос.УстановитьПараметр("ВалютнаяСекция",               ВалютнаяСекция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("MoneySupply");
		
		ЗаписатьЭлементXML(ЗаписьXML, "OperDate"		, Период);
		
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ЗаписатьЭлементXML(ЗаписьXML, "IDDocOperType"	, "624");
			ЗаписатьЭлементXML(ЗаписьXML, "OperKind"		, "624 - Начисление ежемесячной комиссии с брокерского счета");
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ЗаписатьЭлементXML(ЗаписьXML, "IDDocOperType"	, "2402");
			ЗаписатьЭлементXML(ЗаписьXML, "OperKind"		, "2402 - Начисление комиссии биржи по сделкам");
		Иначе
			ЗаписатьЭлементXML(ЗаписьXML, "IDDocOperType"	, "");
			ЗаписатьЭлементXML(ЗаписьXML, "OperKind"		, "");
		КонецЕсли;			
			
		ЗаписатьЭлементXML(ЗаписьXML, "EnrolmentAmount"	, "");
		ЗаписатьЭлементXML(ЗаписьXML, "ChargeOff"		, Выборка.Сумма);
		ЗаписатьЭлементXML(ЗаписьXML, "PayKind"			, "");
		ЗаписатьЭлементXML(ЗаписьXML, "DopInfo"			, "");
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // MoneySupply
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОборотыИлиОстаткиВДругойВалюте(Организация, СчетДоверительногоУправления, Брокер, Валюта, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|			НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|			КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|			Период,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Брокер = &Брокер
		|				И Валюта <> &Валюта) КАК ОстаткиДенежныхСредствОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("Организация"					, Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер"						, Брокер);
	Запрос.УстановитьПараметр("Валюта"						, Валюта);
	Запрос.УстановитьПараметр("Период"						, Период);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов) Экспорт
	
	ДополнительныеНастройки = ПланыВидовХарактеристик.ДополнительныеСведения.ДополнительныеНастройкиОбъекта("ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.Форма522",
		"НеИспользоватьВидыОперацийСделкаТПлюс, ВыгружатьВместоКодаКлиентаБрокераНомерРасчетногоСчета, СокращатьНомерРасчетногоСчетаДоПоследних5Цифр, НаименованиеБиржи");
	
	РазделFX = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX");
	БрокерБК = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
	НомерФормыВИмениФайла = СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетDU_UL1615");
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	// получим существующие пары счет ДУ - брокер
	Запрос = Новый Запрос;
#Область ТекстЗапроса	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Брокер КАК Брокер,
		|	НЕ ОборотыПоДС.Брокер ЕСТЬ NULL КАК ИспользоватьВалютнуюСекцию,
		|	ЕСТЬNULL(Валюты.Ссылка, ОборотыПоДС.Валюта) КАК Валюта,
		|	ЕСТЬNULL(ОборотыПоДС.ВалютнаяСекция, ЛОЖЬ) КАК ВалютнаяСекция,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК КодУБрокера
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ОстаткиДенежныхСредствОбороты.Брокер КАК Брокер,
		|			ОстаткиДенежныхСредствОбороты.МестоХранения = &РазделFX КАК ВалютнаяСекция,
		|			ОстаткиДенежныхСредствОбороты.Валюта КАК Валюта
		|		ИЗ
		|			РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|					НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|					КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|					Период,
		|					ДвиженияИГраницыПериода,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И Брокер = &БрокерБК) КАК ОстаткиДенежныхСредствОбороты
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			Сделка.Брокер,
		|			ЛОЖЬ,
		|			Сделка.ВалютаСделки
		|		ИЗ
		|			Документ.Сделка КАК Сделка
		|		ГДЕ
		|			Сделка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			И Сделка.РежимПереговорныхСделок
		|			И Сделка.Организация = &Организация
		|			И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И Сделка.Брокер = &БрокерБК
		|			И Сделка.Проведен
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			СделкаРепо.Брокер,
		|			ЛОЖЬ,
		|			СделкаРепо.ВалютаСделки
		|		ИЗ
		|			Документ.СделкаРЕПО КАК СделкаРепо
		|		ГДЕ
		|			СделкаРепо.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			И СделкаРепо.Организация = &Организация
		|			И СделкаРепо.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И СделкаРепо.Брокер = &БрокерБК
		|			И СделкаРепо.Проведен
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			ИсполнениеОбязательствПоСделке.Брокер,
		|			ЛОЖЬ,
		|			ИсполнениеОбязательствПоСделке.ВалютаСделки
		|		ИЗ
		|			Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ГДЕ
		|			ИсполнениеОбязательствПоСделке.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|			И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|			И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И ИсполнениеОбязательствПоСделке.Брокер = &БрокерБК
		|			И ИсполнениеОбязательствПоСделке.Проведен
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			&БрокерБК,
		|			ЛОЖЬ,
		|			Валюты.Ссылка
		|		ИЗ
		|			Справочник.Валюты КАК Валюты
		|		ГДЕ
		|			Валюты.Код = ""643""
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			&БрокерБК,
		|			ИСТИНА,
		|			Валюты.Ссылка
		|		ИЗ
		|			Справочник.Валюты КАК Валюты
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|				ПО (Валюты.Код = ""643"")
		|					И (ЗначенияДополнительныхСведений.Объект = &СчетДоверительногоУправления)
		|					И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешняяОбработка._ЭкспортДанныхВСЭДВТБ.Форма522.ЕстьВалютнаяСекцияУБрокераБКРегион"")
		|					И (ЗначенияДополнительныхСведений.Значение = ИСТИНА)) КАК ОборотыПоДС
		|		ПО (ОборотыПоДС.Брокер = ИсполнителиПоДенежнымСредствамБрокерские.Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО (ОборотыПоДС.Брокер ЕСТЬ NULL)
		|			И ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И ИсполнителиПоДенежнымСредствамБрокерские.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация"					, Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период"						, Период);
	Запрос.УстановитьПараметр("РазделFX"					, РазделFX);
	Запрос.УстановитьПараметр("БрокерБК"					, БрокерБК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		// по каждой паре отдельный файлег
		ЗаписьXML = Новый ЗаписьXML;
		
		ВыгружатьПризнакВалютнойСекции = Выборка.ВалютнаяСекция = Истина Или (Выборка.Брокер = БрокерБК И Выборка.Валюта <> ВалютаУчета); 
		
		Попытка                                                                                                                                                                                                                                                                                                                            
			ЗаписьXML.ОткрытьФайл(КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "522\" + ?(НомерФормыВИмениФайла, "F522", "") + СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + ", " + СтрЗаменить(Выборка.Брокер, """", "") + ?(НомерФормыВИмениФайла, "", ", " + Выборка.КодУБрокера) +  ?(ВыгружатьПризнакВалютнойСекции, ", V", "") + ", " + Выборка.Валюта + "_" + Формат(Период, "ДФ=dd.MM.yyyy") + ".xml", "WINDOWS-1251");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + ". Выгрузка отменена по счету ДУ " + СокрЛП(СчетДоверительногоУправления));
			Прервать;
		КонецПопытки;	
			
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("EDO_ODKF522");
		
		// выгрузка РЕПО и внеб. сделок временно не поддерживается по согласованию с бэк-офисом
		ВыгрузитьОбщиеЭлементы(ЗаписьXML, Организация, СчетДоверительногоУправления, Выборка.Брокер, Выборка.ИспользоватьВалютнуюСекцию, Выборка.Валюта, Выборка.ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX, ВыгружатьПризнакВалютнойСекции);
		
		Если НЕ Выборка.ИспользоватьВалютнуюСекцию ИЛИ НЕ Выборка.ВалютнаяСекция Тогда
			ВыгрузитьБиржевыеСделки(ЗаписьXML, Организация, СчетДоверительногоУправления, Выборка.Брокер, Выборка.Валюта, Период, ДополнительныеНастройки);
		КонецЕсли;
		
		ВыгрузитьДвиженияДенежныхСредств(ЗаписьXML, Организация, СчетДоверительногоУправления, Выборка.Брокер, Выборка.ИспользоватьВалютнуюСекцию, Выборка.Валюта, Выборка.ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX);
		ВыгрузитьНачисленияЗадолженности(ЗаписьXML, Организация, СчетДоверительногоУправления, Выборка.Брокер, Выборка.ИспользоватьВалютнуюСекцию, Выборка.Валюта, Выборка.ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX);
		
		Если НЕ Выборка.ИспользоватьВалютнуюСекцию ИЛИ НЕ Выборка.ВалютнаяСекция Тогда
			ВыгрузитьРепо(ЗаписьXML, Организация, СчетДоверительногоУправления, Выборка.Брокер, Выборка.Валюта, Период, ДополнительныеНастройки);
		КонецЕсли;
		
