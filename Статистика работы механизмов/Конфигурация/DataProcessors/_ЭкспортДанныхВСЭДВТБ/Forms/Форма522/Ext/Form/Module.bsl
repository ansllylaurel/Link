		//1724 - Комиссия биржи (авт.)
		//1732 - Списание начисленного Комиссионного сбора
		//1777 - Списание вариационной маржи
		
		//	Получение доходов
		//*1694 - Получение на брок. счет ден. средств от погашения НКД
		//*1719 - Зачисление денежных ср-в от погашения НКД  (авт.)
		//1722 - НКД уплачено (авт.)
		//*1733 - Получение дивидендов по ЦБ на брокерский счет
		//*1771 - Поступление средств за частичное погашение ЦБ
		//1774 - Поступление вариационной маржи
		
		//	Получение и перевод на другие счета ДУ
		//*1686 - Получение денежных средств на брокерский счет с р/с
		//*1687 - Перевод денежных средств с брокерского счета на р/с
		//*1691 - Получение денежных средств с другого б/сч на текущий
		//*1692 - Перевод денежных средств с текущего б/сч на другой б/сч
		//1775 - Поступление д/с в клиринговый центр
		//1776 - Перевод д/с из клирингового центра
		
		//	Прочее
		//1693 - Получение ошибочно (неправомерно) списанной суммы
		//1720 - Зачисление денежных ср-в от продаж (авт.)
		//1721 - Списание денежных ср-в на покупку (авт.)
		
		Если      РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
			ВидОперации.Код          = "1785";
			ВидОперации.Наименование = "Комиссия брокера (авт.)";
			
		ИначеЕсли РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
			ВидОперации.Код          = "1784";
			ВидОперации.Наименование = "Комиссия биржи (авт.)";
			
		ИначеЕсли РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции 
			или РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи
			или РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки Тогда
			
			ВидОперации.Код          = "1733";
			ВидОперации.Наименование = "Получение дивидендов по ЦБ на брокерский счет";
			
		ИначеЕсли РеквизитыОперации.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюОблигации Тогда	
			ВидОперации.Код          = "1771";
			ВидОперации.Наименование = "Поступление средств за частичное погашение ЦБ";	
	
		ИначеЕсли РеквизитыОперации.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата Тогда
			
			Если      РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				ВидОперации.Код          = "1720";
				ВидОперации.Наименование = "Зачисление денежных ср-в от продаж (авт.)";
			ИначеЕсли РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
				ВидОперации.Код          = "1721";
				ВидОперации.Наименование = "Списание денежных ср-в на покупку (авт.)";
			КонецЕсли;
			
		ИначеЕсли РеквизитыОперации.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона Тогда
			Если      РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				ВидОперации.Код          = "1719";
				ВидОперации.Наименование = "Зачисление денежных ср-в от погашения НКД  (авт.)";
			ИначеЕсли РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
				ВидОперации.Код          = "1722";
				ВидОперации.Наименование = "НКД уплачено (авт.)";
			КонецЕсли;
				
		ИначеЕсли РеквизитыОперации.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств Тогда
			
			Если      РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				ВидОперации.Код          = "1686";
				ВидОперации.Наименование = "Получение денежных средств на брокерский счет с р/с";
			ИначеЕсли РеквизитыОперации.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
				ВидОперации.Код          = "1687";
				ВидОперации.Наименование = "Перевод денежных средств с брокерского счета на р/с";
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	Если ПустаяСтрока(ВидОперации.Код) Тогда
		ВызватьИсключение "Не удалось определить вид операции с д/с по виду движения " + РеквизитыОперации.ВидДвиженияДенежныхСредств
			+ ?(ЗначениеЗаполнено(РеквизитыОперации.ВариантДвиженияДенежныхСредств), " / " + РеквизитыОперации.ВариантДвиженияДенежныхСредств, "");
	КонецЕсли;
	
	Возврат ВидОперации
	
КонецФункции 

&НаСервереБезКонтекста
Процедура ВыгрузитьОбщиеЭлементы(ЗаписьXML, Организация, СчетДоверительногоУправления, Брокер, ИспользоватьВалютнуюСекцию, Валюта, ВалютнаяСекция, Период, ДополнительныеНастройки, РазделFX, ВыгружатьПризнакВалютнойСекции)
	
	ВидДоговораДоверительногоУправления = СчетДоверительногоУправления.ВидДоговораДоверительногоУправления;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ТекущаяДата КАК TheDate,
		|	&Период КАК DocDate,
		|	ЮрЛицоОрганизации.ИНН КАК UKINN,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов КАК UKName,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК DogovorNumber,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК DogovorDate,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код + ВЫБОР
		|		КОГДА &ВыгружатьПризнакВалютнойСекции
		|			ТОГДА ""V""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК BrokerDocNumber,
		|	ЮрЛицоБрокера.ПолноеНаименованиеПоУставу КАК BrokerName,
		|	ЮрЛицоБрокера.ИНН КАК BrokerINN,
		|	""0"" КАК BranchKod,
		|	ВЫБОР
		|		КОГДА Валюты.Код = ""643""
		|			ТОГДА ""810""
		|		ИНАЧЕ Валюты.Код
		|	КОНЕЦ КАК IDCurrency,
		|	СУММА(ЕСТЬNULL(ОстаткиДенежныхСредствОстаткиНачальные.СуммаОстаток, 0)) КАК IncomingOstatokMoney,
		|	СУММА(ЕСТЬNULL(ОстаткиДенежныхСредствОстаткиКонечные.СуммаОстаток, 0)) КАК OutgoingOstatokMoney,
		|	ЮрЛицоОрганизации.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Брокер = &Брокер
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоОрганизации
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.Организация.ЮрФизЛицо = ЮрЛицоОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК ЮрЛицоБрокера
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо = ЮрЛицоБрокера.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО (Валюты.Ссылка = &Валюта)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
		|				Организация = &Организация
		|					И Брокер = &Брокер
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Валюта = &Валюта
		|					И (НЕ &ИспользоватьВалютнуюСекцию
		|						ИЛИ &ИспользоватьВалютнуюСекцию
		|							И &ВалютнаяСекция
		|							И МестоХранения = &РазделFX
		|						ИЛИ &ИспользоватьВалютнуюСекцию
		|							И НЕ &ВалютнаяСекция
		|							И НЕ МестоХранения = &РазделFX)) КАК ОстаткиДенежныхСредствОстаткиНачальные
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстаткиНачальные.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
		|				Организация = &Организация
		|					И Брокер = &Брокер
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Валюта = &Валюта
		|					И (НЕ &ИспользоватьВалютнуюСекцию
		|						ИЛИ &ИспользоватьВалютнуюСекцию
		|							И &ВалютнаяСекция
		|							И МестоХранения = &РазделFX
		|						ИЛИ &ИспользоватьВалютнуюСекцию
		|							И НЕ &ВалютнаяСекция
		|							И НЕ МестоХранения = &РазделFX)) КАК ОстаткиДенежныхСредствОстаткиКонечные
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстаткиКонечные.СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЮрЛицоОрганизации.ИНН,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код,
		|	ЮрЛицоБрокера.ПолноеНаименованиеПоУставу,
		|	ЮрЛицоБрокера.ИНН,
		|	ЮрЛицоОрганизации.КраткоеНаименованиеПоУставу,
		|	Валюты.Код";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Валюта",                       Валюта);
	Запрос.УстановитьПараметр("ТекущаяДата",                  ТекущаяДата());
	
	Запрос.УстановитьПараметр("ИспользоватьВалютнуюСекцию",   	ИспользоватьВалютнуюСекцию);
	Запрос.УстановитьПараметр("РазделFX",                     	РазделFX);
	Запрос.УстановитьПараметр("ВалютнаяСекция",               	ВалютнаяСекция);
	Запрос.УстановитьПараметр("ВыгружатьПризнакВалютнойСекции", ВыгружатьПризнакВалютнойСекции);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Если Колонка.Имя = "BrokerName" Тогда
				Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
					Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний
					Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций
				Тогда
					ЗаписатьЭлементXML(ЗаписьXML, Колонка.Имя, Выборка.BrokerName + "  (Дог. б/о " + Выборка.DogovorNumber + " )");
				Иначе
					ЗаписатьЭлементXML(ЗаписьXML, Колонка.Имя, Выборка[Колонка.Имя]);
				КонецЕсли;
			ИначеЕсли Колонка.Имя <> "НаименованиеОрганизации" Тогда
				ЗаписатьЭлементXML(ЗаписьXML, Колонка.Имя, Выборка[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;
		
		НомерСчета = Выборка.BrokerDocNumber;
		
		Если ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(ДополнительныеНастройки, 
			"ВыгружатьВместоКодаКлиентаБрокераНомерРасчетногоСчета", СчетДоверительногоУправления) = Истина Тогда
			
			РасчетныйСчет = ПолучитьНомерРасчетногоСчетаБрокера(Организация, СчетДоверительногоУправления, Брокер, Период, ДополнительныеНастройки);
			
			Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
				НомерСчета = РасчетныйСчет;
			КонецЕсли;
			
		КонецЕсли;
		
		// BrokerAccount
		ЗаписатьЭлементXML(ЗаписьXML, "BrokerAccount", НомерСчета);
		
		// InvestcaseName
		ИнвестПортфель = СокрЛП(СтрЗаменить(СчетДоверительногоУправления.Наименование, " ПН", "")) + "-накопления НПФ-" + Выборка.НаименованиеОрганизации + " - Портфель по умолчанию (дог. " + СокрЛП(СчетДоверительногоУправления.НомерДоговора) + ")";
		
		ЗаписатьЭлементXML(ЗаписьXML, "InvestcaseName", ИнвестПортфель);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыгрузитьБиржевыеСделки(ЗаписьXML, Организация, СчетДоверительногоУправления, Брокер, Валюта, Период, ДополнительныеНастройки)
	
	ВидДоговораДоверительногоУправления = СчетДоверительногоУправления.ВидДоговораДоверительногоУправления;
	
	// Выгружаются следующие категории объектов:
	//	1. сделки без отложенного исполнения: покупка ЦБ, продажа ЦБ
	//	2. исполнения отложенных сделок: покупка ЦБ (сделка Т+), продажа ЦБ (сделка Т+)
	//	3. оплаченная комиссия по сделке с отложенным исполнением: комиссия по сделкам Т+
	//	4. начисленная, но не оплаченная, комиссия: комиссия (инф.)
	//	5. сделки репо
	//	6. оплаты РПС(дополнительно) - 0702/17 - убрал первичное размещение (типа оно не совсем РПС). Коля
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК _Ссылка,
		|	ЛОЖЬ КАК _ОплатаРПС,
		|	Сделка.Ссылка КАК _Основание,
		|	Сделка.ВидСделки КАК _ВидСделки,
		|	Сделка.НомерСделки КАК _НомерСделки,
		|	Сделка.Дата КАК _ДатаСделки,
		|	Сделка.ОтложенноеИсполнение КАК _ОтложенноеИсполнение,
		|	Сделка.РежимПереговорныхСделок КАК _РежимПереговорныхСделок,
		|	Сделка.Рынок КАК _Рынок,
		|	Сделка.МестоХранения КАК _МестоХранения,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК _ЦеннаяБумага,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет КАК _ДепозитарныйСчет,
		|	Сделка.ОтложеннаяОплатаТорговойКомиссии КАК _ОтложеннаяОплатаТорговойКомиссии,
		|	Сделка.ВремяСделки КАК DealTime,
		|	СделкаЦенныеБумаги.Количество КАК Qty,
		|	СделкаЦенныеБумаги.Цена КАК CostOfSecurities,
		|	СделкаЦенныеБумаги.Сумма КАК Amount,
		|	СделкаЦенныеБумаги.СуммаКупона КАК NKD
		|ПОМЕСТИТЬ _БиржевыеПокупкиПродажи
		|ИЗ
