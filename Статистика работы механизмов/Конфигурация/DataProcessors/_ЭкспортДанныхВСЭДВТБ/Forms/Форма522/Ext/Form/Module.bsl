Процедура ЗаписатьЭлементXML(ЗаписьXML, Имя, Значение)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(Значение));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СериализоватьЗначение(Значение)
	
	Если      ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=");
	Иначе
		Возврат СокрЛП(Значение);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерРасчетногоСчетаБрокера(Организация, СчетДоверительногоУправления, Брокер, Период, ДополнительныеНастройки)

	НомерСчетаБрокера = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет.НомерСчета КАК НомерРасчетногоСчета
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамБрокерские.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнителиПоДенежнымСредствамБрокерские.Брокер = &Брокер
		|	И (ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоДенежнымСредствамБрокерские.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|	И ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет.Валюта = &Валюта";
		
	Запрос.УстановитьПараметр("Организация",                  Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       Брокер);
	Запрос.УстановитьПараметр("Период",                       Период);
	Запрос.УстановитьПараметр("Валюта",                       Организация.ВалютаУчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		
		НомерСчетаБрокера = Выборка.НомерРасчетногоСчета;
		
		Если ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(ДополнительныеНастройки, 
			"СокращатьНомерРасчетногоСчетаДоПоследних5Цифр", СчетДоверительногоУправления) = Истина
		Тогда
			НомерСчетаБрокера = Прав(НомерСчетаБрокера, 5);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя однозначно определить расчетный счет у брокера " + Брокер + " для клиента " + СчетДоверительногоУправления + ". Вместо него будет выгружен код клиента брокера.");
	КонецЕсли;
	
	Возврат НомерСчетаБрокера;
	
КонецФункции
	
