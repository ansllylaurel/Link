
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);

КонецПроцедуры

&НаСервере
Функция ДанныеДоговора()
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент,
		|	СчетаДоверительногоУправления.НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения
		|ПОМЕСТИТЬ _КлиентДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_КлиентДУ.НомерДоговора,
		|	_КлиентДУ.ДатаЗаключения КАК ДатаДоговора,
		|	РеквизитыКлиентаСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеСчетаДУ,
		|	РеквизитыОрганизацийСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	_КлиентДУ КАК _КлиентДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиентаСрезПоследних
		|		ПО _КлиентДУ.Клиент = РеквизитыКлиентаСрезПоследних.ЮрФизЛицо,
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации) КАК РеквизитыОрганизацийСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", ЭтаФорма.Переоценка.Дата);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации", ЭтаФорма.Организация.ЮрФизЛицо);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Данные = Новый Структура();
			Данные.Вставить("НомерДоговора", СтрЗаменить(СтрЗаменить(ВыборкаДетальныеЗаписи.НомерДоговора, "/", "_"), "\", "_"));
			Данные.Вставить("Наименование", СтрЗаменить(ВыборкаДетальныеЗаписи.НаименованиеСчетаДУ, """", ""));
			Данные.Вставить("ЦеннаяБумага", СокрЛП(ЭтаФорма.ЦеннаяБумага.Эмитент) + " " + ЭтаФорма.ЦеннаяБумага.ГосударственныйРегистрационныйНомер);
			Данные.Вставить("Дата", Формат(ЭтаФорма.Переоценка.Дата, "ДФ=yyyy-MM-dd")); 
			
			Возврат Данные;
			
		КонецЕсли;

КонецФункции		
		
&НаКлиенте
Процедура Сформировать(Команда)
	
	ПакетОтображаемыхДокументов = СформироватьНаСервере();
	
	Если ПакетОтображаемыхДокументов <> Неопределено Тогда  
		Данные = ДанныеДоговора();
		
		Если ПакетОтображаемыхДокументов.Состав.Количество()= 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сделать расчет по " + Данные.ЦеннаяБумага);
		Иначе	
			Попытка
				ИмяФайла = СокрЛП(Путь) + "\Расшифровка " + РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(СокрЛП(Данные.Наименование) + " (" + Данные.НомерДоговора + ") по " + СокрЛП(Данные.ЦеннаяБумага)) + " от " + Данные.Дата + ".xlsx";	
				ПакетОтображаемыхДокументов.Записать(ИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл '" + ИмяФайла +  "' сохранен");
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить файл! " + ИнформацияОбОшибке().Описание);
			КонецПопытки	
		КонецЕсли;
	Конецесли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере(Отказ = Ложь)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЭтаФорма.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета доступна только для облигаций");
		Возврат Неопределено;
	КонецЕсли; 
	
	Если ЭтаФорма.Переоценка.ВидУчета <> ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет") Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета доступна только для единого бухгалтерского учета");
		Возврат Неопределено;
	КонецЕсли;
	
	//Если это первая переоценка до начала ведения учета
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтаФорма.Переоценка.Дата, ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления);
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет) Тогда
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтаФорма.Переоценка.Дата + 86400, ЭтаФорма.Организация, ЭтаФорма.СчетДоверительногоУправления);
		Если НЕ ЗначениеЗаполнено(НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На дату переоценки не ведется единый бухгалтерский учет!",,,,);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;		

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстаткиИОбороты.Организация КАК Организация,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстаткиИОбороты.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстаткиИОбороты.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СтоимостьКупонаКонечныйОстаток + БухПартииЦенныхБумагОстаткиИОбороты.ПереоценкаКупонаКонечныйОстаток КАК ОценочнаяСуммаКупона,
		|	БухПартииЦенныхБумагОстаткиИОбороты.ДисконтПремияНачисленныйНачальныйОстаток КАК БалансовыеДисконтПремия,
		|	БухПартииЦенныхБумагОстаткиИОбороты.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяНачальныйОстаток КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстаткиИОбороты.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальныйОстаток КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СтоимостьНачальныйОстаток КАК Стоимость
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
		|			&Период,
		|			&Период,
		|			Регистратор,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстаткиИОбороты
		|ГДЕ
		|	БухПартииЦенныхБумагОстаткиИОбороты.Регистратор = &Ссылка";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтаФорма.Переоценка.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтаФорма.ЦеннаяБумага); 
	Запрос.УстановитьПараметр("Ссылка", ЭтаФорма.Переоценка); 
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация); 
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления); 
		
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	ПакетОтображаемыхДокументов = Новый ПакетОтображаемыхДокументов;
	
	Индекс = 1;
	Пока Выборка.Следующий() Цикл 
	
	ПараметрыПартии = Новый Структура("ДатаПереоценки, Организация, СчетДоверительногоУправления, 
		|Количество, ОценочнаяСуммаКупона, ЦеннаяБумага, Партия, СтрокаПартии, УчетныйАктивЕПС, 
		|БалансовыйДисконт, НачальнаяРазницаППНеНаблюдаемыеДанные, БалансоваяРазницаППНеНаблюдаемыеДанные, Стоимость", 
		КонецДня(ЭтаФорма.Переоценка.Дата), 
		ЭтаФорма.Организация, 
		ЭтаФорма.СчетДоверительногоУправления, 
		Выборка.Количество, 
		Выборка.ОценочнаяСуммаКупона, 
		Выборка.ЦеннаяБумага, 
		Выборка.Партия, 
		Выборка.СтрокаПартии,
		Выборка.УчетныйАктивЕПС,
		Выборка.БалансовыеДисконтПремия,
		Выборка.НачальнаяРазницаППНеНаблюдаемыеДанные,
		Выборка.БалансоваяРазницаППНеНаблюдаемыеДанные,
		Выборка.Стоимость);
		
		ДокументРезультат = Новый ТабличныйДокумент;
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчета, Выборка.ЦеннаяБумага, Выборка.УчетныйАктивЕПС, Выборка.Партия, Выборка.СтрокаПартии);
		
		СформироватьРасшифровку(ПараметрыПартии, ДокументРезультат, НастройкиУчетаЦеннойБумаги);
		Элемент = ПакетОтображаемыхДокументов.Состав.Добавить(ПоместитьВоВременноеХранилище(ДокументРезультат, Новый УникальныйИдентификатор));
		Элемент.Наименование = "Партия " + Индекс + " (" + Выборка.Количество + ")";
		Индекс = Индекс + 1; 
	КонецЦикла; 	
	
	Возврат  ПакетОтображаемыхДокументов;
	
КонецФункции

&НаСервере
Процедура СформироватьРасшифровку(ПараметрыПартии, ДокументРезультат, НастройкиУчета, Отказ = Ложь)
	
	
	ДокументРезультат.Очистить();
			
	Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа;
	
	ЦеннаяБумага = ЭтаФорма.ЦеннаяБумага;
	Партия 		 = ПараметрыПартии.Партия;
	СтрокаПартии = ПараметрыПартии.СтрокаПартии;
	УчетныйАктивЕПС = ПараметрыПартии.УчетныйАктивЕПС;

	РаботаСОтчетами.КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(ЭтаФорма.СчетДоверительногоУправления,,, Партия);
	
	МассивТиповПартий = Новый Массив;
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.Сделка"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.ПоставкаЦенныхБумаг"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.ВводЦенныхБумаг"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.КорректировкаРегистров"));
	МассивТиповПартий.Добавить(Тип("ДокументСсылка.РеклассификацияАктивовЕПС"));
	
	ЦенныеБумаги = Новый ТаблицаЗначений;
	
	ЦенныеБумаги.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ЦенныеБумаги.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ЦенныеБумаги.Колонки.Добавить("Партия",  Новый ОписаниеТипов(МассивТиповПартий));
	ЦенныеБумаги.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
	ЦенныеБумаги.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ЦенныеБумаги.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	СтрокаЦенныеБумаги = ЦенныеБумаги.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаЦенныеБумаги, ПараметрыПартии);
	СтрокаЦенныеБумаги.НомерСтроки = 1;
	
	ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумаги, ЭтаФорма.СчетДоверительногоУправления, ЭтаФорма.Переоценка.Дата).Выгрузить();
	
	ДатаИЦенаПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("НомерСтроки", 1));
	
	НачальныйДисконт 			= ДатаИЦенаПокупки[0].НачальныйДисконт;
	ЦенаПокупки 				= ДатаИЦенаПокупки[0].ЦенаПокупки;
	ЦенаПокупкиКупона 			= ДатаИЦенаПокупки[0].ЦенаКупона;
	ДатаПокупки 				= ДатаИЦенаПокупки[0].ДатаПокупки;
	ДатаПокупкиНачальная		= ДатаИЦенаПокупки[0].ДатаПокупкиНачальная;
	КорректировкаЭСПНачальная	= ДатаИЦенаПокупки[0].КорректировкаЭСПНачальная;
	Партия		 				= ДатаИЦенаПокупки[0].Партия;
	ЦенаПокупкиНачальная		= ДатаИЦенаПокупки[0].ЦенаПокупкиНачальная;
	
	// у клиента не считается ЭСП
	Если НастройкиУчета.ВариантУчетаКупонногоДохода <> Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке Тогда
		// по всем, кроме "через прибыль/убыток" считаем Корректировку ЭСП независимо от настроек
		Если УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток Тогда
			НастройкиУчета.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПереоценки = Новый Структура("ДатаПереоценки, Количество, ОценочнаяСуммаКупона, БалансовыйДисконт, УчетныйАктивЕПС, Партия, СтрокаПартии, Стоимость");
	ЗаполнитьЗначенияСвойств(ДанныеПереоценки, ПараметрыПартии, "ДатаПереоценки, Количество, ОценочнаяСуммаКупона, БалансовыйДисконт, УчетныйАктивЕПС, Партия, СтрокаПартии, Стоимость");
	ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", ПараметрыПартии.БалансоваяРазницаППНеНаблюдаемыеДанные);
	ДанныеПереоценки.Вставить("СчетДоверительногоУправления", ПараметрыПартии.СчетДоверительногоУправления);
	
	ДанныеПокупки = Новый Структура("НачальныйДисконт,ДатаПокупки,ДатаПокупкиНачальная,КорректировкаЭСПНачальная,ЦенаПокупки,ЦенаПокупкиНачальная");
	ЗаполнитьЗначенияСвойств(ДанныеПокупки, ДатаИЦенаПокупки[0], "НачальныйДисконт,ДатаПокупки,ДатаПокупкиНачальная,КорректировкаЭСПНачальная,ЦенаПокупки,ЦенаПокупкиНачальная");
	ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", ПараметрыПартии.НачальнаяРазницаППНеНаблюдаемыеДанные / ПараметрыПартии.Количество);
	ДанныеПокупки.Вставить("ЦенаПокупкиКупона", ЦенаПокупкиКупона);

	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	ЦеннаяБумага);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчета, Отказ, РасшифровкаРасчета);
	
	Если РасшифровкаРасчета.Операции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Расшифровка расчета процентных показателей: " + Строка(ЦеннаяБумага),,, ДокументРезультат);
	ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
	
	РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПутьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Укажите каталог для сохранения файлов";
	
	Если Диалог.Выбрать() Тогда 
		 Путь = Диалог.Каталог;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ПереоценкаПриИзмененииНаСервере()
	
	Элементы.ЦеннаяБумага.СписокВыбора.Очистить();
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Переоценка) Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК БухПартииЦенныхБумагОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага
		|АВТОУПОРЯДОЧИВАНИЕ"; 
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтаФорма.Переоценка.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация); 
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления); 	

	СпикокОблигаций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага"); 
	Элементы.ЦеннаяБумага.СписокВыбора.ЗагрузитьЗначения(СпикокОблигаций);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереоценкаПриИзменении(Элемент)
	ПереоценкаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры
