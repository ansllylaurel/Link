
&НаСервереБезКонтекста
Процедура ОбновитьСКДНаСервере(Знач БазисыДляОбновления)
	
	Для каждого Базис Из БазисыДляОбновления Цикл
	
		Базис = Базис.ПолучитьОбъект();
		Базис.ДополнительныеСвойства.Вставить("ПрограммноеОбновление");
		
		СКД = Справочники.БазисыКонтроляИнвестиционныхДеклараций.ПолучитьСКДБазиса(Базис.НаборДанных);
		
		ТекущиеНастройки = Базис.ХранилищеНастроек.Получить();
		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
		Компоновщик.ЗагрузитьНастройки(ТекущиеНастройки);
		Компоновщик.Восстановить();
		Для каждого Параметр Из Компоновщик.Настройки.ПараметрыДанных.Элементы Цикл
		
			Если Параметр.Использование = Ложь И Не СКД.Параметры.Найти(Параметр.Параметр) = Неопределено Тогда
				Параметр.Использование = Истина;
			КонецЕсли; 
		
		КонецЦикла; 
		
		Базис.ХранилищеСКД = Новый ХранилищеЗначения(СКД, Новый СжатиеДанных(9));
		Базис.ХранилищеНастроек = Новый ХранилищеЗначения(Компоновщик.ПолучитьНастройки(), Новый СжатиеДанных(9));
		
		Базис.Записать();
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСКДВыделенныхБазисов(Команда)
	ОбновитьСКДНаСервере(Элементы.Список.ВыделенныеСтроки);
КонецПроцедуры
