			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ВводыАктивовСНачалаГода",	"_ВводыАктивовСНачалаГодаБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СуммаВВалютеРасчетаРынок",	"СуммаВВалютеРасчетаБаланс");
		КонецЕсли;
		
		#КонецОбласти		
		
	ИначеЕсли ИмяИсточника = "_РазницаБалансаИРынкаВводовВыводовСНачалаГода" Тогда
	
		#Область РазницаБалансаИРынкаВводовВыводовСНачалаГода
		
