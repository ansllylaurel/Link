			|		КОГДА _Клиенты.ПараметрРасчетаУменьшатьНаСуммуВознагражденияЗаУправление
			|			ТОГДА _РассчитанноеВознаграждениеЗаУправление.СуммаВВалютеРасчета
			|		ИНАЧЕ 0
			|	КОНЕЦ - ВЫБОР
			|		КОГДА _Клиенты.ПараметрРасчетаУменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария
			|			ТОГДА _НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода.СуммаВВалютеРасчета
			|		ИНАЧЕ 0
			|	КОНЕЦ + _ИнвестиционныйДоходБаланс.СуммаВВалютеРасчета КАК СуммаВВалютеРасчета,
			|	ВЫБОР
			|		КОГДА _Клиенты.ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|			ТОГДА _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций.ПоправочныйКоэффициентКСтавкеВознаграждения
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПоправочныйКоэффициентКСтавкеВознаграждения,
			|	ВЫБОР
			|		КОГДА _Клиенты.ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|			ТОГДА _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций.ДоходностьУправления
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ДоходностьУправления,
			|	ВЫБОР
			|		КОГДА _Клиенты.ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|			ТОГДА _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций.ПриростИндекса
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПриростИндекса
			|ПОМЕСТИТЬ _ИнвестиционныйДоходСкорректированныйБаланс
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныйДоходБаланс КАК _ИнвестиционныйДоходБаланс
			|		ПО (_ИнвестиционныйДоходБаланс.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РазницаБалансаИРынкаВводовВыводовСНачалаГода КАК _РазницаБалансаИРынкаВводовВыводовСНачалаГода
			|		ПО (_РазницаБалансаИРынкаВводовВыводовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _УбытокЗаПредыдущийГодБаланс КАК _УбытокЗаПредыдущийГодБаланс
			|		ПО (_УбытокЗаПредыдущийГодБаланс.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ #РассчитанноеВознаграждениеЗаУправление# КАК _РассчитанноеВознаграждениеЗаУправление
			|		ПО (_РассчитанноеВознаграждениеЗаУправление.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ #НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода# КАК _НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода
			|		ПО (_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ #ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций# КАК _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций
			|		ПО (_ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)";

		СуффиксСумм = ?(ИмяИсточника = "_ИнвестиционныйДоходСкорректированныйБаланс", "Баланс", "");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ИнвестиционныйДоходСкорректированныйБаланс",	"_ИнвестиционныйДоходСкорректированный" + СуффиксСумм);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ИнвестиционныйДоходБаланс",					"_ИнвестиционныйДоход" + СуффиксСумм);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_УбытокЗаПредыдущийГодБаланс",				"_УбытокЗаПредыдущийГод" + СуффиксСумм);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИнвестиционныйДоходПоБалансу",				?(СуффиксСумм = "Баланс", "ИСТИНА", "ЛОЖЬ"));
		
		ДобавитьИсточникДанных(Запрос, "_ИнвестиционныйДоход" + СуффиксСумм);
		ДобавитьИсточникДанных(Запрос, "_РазницаБалансаИРынкаВводовВыводовСНачалаГода");
		ДобавитьИсточникДанных(Запрос, "_УбытокЗаПредыдущийГод" + СуффиксСумм);
				
		// Применяем поправочный коэффициент, при необходимости
		
		Если СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Клиенты", , , "ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций").Пустой() Тогда
			ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций = "(ВЫБРАТЬ NULL КАК СчетДоверительногоУправления, NULL КАК ПоправочныйКоэффициентКСтавкеВознаграждения, NULL КАК ДоходностьУправления, NULL КАК ПриростИндекса)";
		Иначе
			ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций = "_ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций";
			
			ДобавитьИсточникДанных(Запрос, "_ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций");
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций#", ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций);
		
		// Исключаем начисленное вознаграждение за управление при необходимости
		
		Если СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Клиенты", , , "ПараметрРасчетаУменьшатьНаСуммуВознагражденияЗаУправление").Пустой() Тогда
			РассчитанноеВознаграждениеЗаУправление = "(ВЫБРАТЬ NULL КАК СчетДоверительногоУправления, NULL КАК СуммаВВалютеРасчета)";
		Иначе
			РассчитанноеВознаграждениеЗаУправление = "_РассчитанноеВознаграждениеЗаУправление";
			
			ДобавитьИсточникДанных(Запрос, "_РассчитанноеВознаграждениеЗаУправление");
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#РассчитанноеВознаграждениеЗаУправление#", РассчитанноеВознаграждениеЗаУправление);
		
		// Исключаем услуги СД при необходимости
		
		Если СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Клиенты", , , "ПараметрРасчетаУменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария").Пустой() Тогда
			НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода = "(ВЫБРАТЬ NULL КАК СчетДоверительногоУправления, NULL КАК СуммаВВалютеРасчета)";
		Иначе
			НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода = "_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода";
			
			ДобавитьИсточникДанных(Запрос, "_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода");
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода#", НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГода);
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций" Тогда
		
		#Область _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций
		
		// Доходность рассчитываем по методике СФР, прирост индекса рассчитываем по данным регистра
		КлиентыИДоходность = Запрос.МенеджерВременныхТаблиц.Таблицы["_Клиенты"].ПолучитьДанные().Выгрузить();	
		КлиентыИДоходность.Колонки.Добавить("Доходность", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2)));
		
		Для Каждого СтрокаКлиента Из КлиентыИДоходность Цикл			
			Доходность = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьИнвестированияПФР(СтрокаКлиента.Организация, СтрокаКлиента.СчетДоверительногоУправления, СтрокаКлиента.КонецРасчетногоПериода);  
			СтрокаКлиента.Доходность = Доходность.Получить(Справочники.ВидыФинансовыхПоказателей.ДоходностьПФРТекущегоГода);
		КонецЦикла;
		
		Запрос.УстановитьПараметр("КлиентыИДоходность",	КлиентыИДоходность); 
		Запрос.УстановитьПараметр("ЮрФизЛицо_Росстат",	ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Росстат"));
		
		Запрос.УстановитьПараметр(
			"ДнейВГоду", 
			(КонецГода(Запрос.Параметры.ДатаРасчета) - НачалоГода(Запрос.Параметры.ДатаРасчета) + 1) / (24 * 60 * 60));
			
		Запрос.УстановитьПараметр("Биржа_ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
		
		Запрос.УстановитьПараметр("НачалоГода",	НачалоГода(Запрос.Параметры.ДатаРасчета));
		Запрос.УстановитьПараметр("КонецГода",	НачалоДня(КонецГода(Запрос.Параметры.ДатаРасчета)));
		
		Запрос.УстановитьПараметр(
			"ПоследнийРабочийДеньТекущегоГода",
			Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецГода(Запрос.Параметры.ДатаРасчета), -1));
			
		Запрос.УстановитьПараметр(
			"ПоследнийРабочийДеньПредыдущегоГода",
			Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоГода(Запрос.Параметры.ДатаРасчета), -1));	
		 	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыИДоходность.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	КлиентыИДоходность.КонецРасчетногоПериода КАК КонецРасчетногоПериода,
			|	КлиентыИДоходность.НачалоРасчетногоПериода КАК НачалоРасчетногоПериода,
			|	КлиентыИДоходность.Доходность КАК Доходность
			|ПОМЕСТИТЬ _ДоходностьПоМетодикеСФР
			|ИЗ
			|	&КлиентыИДоходность КАК КлиентыИДоходность
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА ЗначенияБиржевыхИндексов.Период = &ПоследнийРабочийДеньПредыдущегоГода
			|			ТОГДА &НачалоГода
			|		КОГДА ЗначенияБиржевыхИндексов.Период = &ПоследнийРабочийДеньТекущегоГода
			|			ТОГДА &КонецГода
			|		ИНАЧЕ ЗначенияБиржевыхИндексов.Период
			|	КОНЕЦ КАК Дата,
			|	ЗначенияБиржевыхИндексов.CLOSE КАК Значение
			|ПОМЕСТИТЬ _ЗначенияИндекса
			|ИЗ
			|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
			|ГДЕ
			|	ЗначенияБиржевыхИндексов.Биржа = &Биржа_ММВБ
			|	И ЗначенияБиржевыхИндексов.БиржевойИндекс.Код = ""BPSI""
			|	И ЗначенияБиржевыхИндексов.Период В
			|			(ВЫБРАТЬ
			|				&ПоследнийРабочийДеньПредыдущегоГода КАК Дата
			|		
			|			ОБЪЕДИНИТЬ
			|		
			|			ВЫБРАТЬ
			|				&ПоследнийРабочийДеньТекущегоГода
			|		
			|			ОБЪЕДИНИТЬ
			|		
			|			ВЫБРАТЬ
			|				_ДоходностьПоМетодикеСФР.КонецРасчетногоПериода
			|			ИЗ
			|				_ДоходностьПоМетодикеСФР
			|		
			|			ОБЪЕДИНИТЬ
			|		
			|			ВЫБРАТЬ
			|				_ДоходностьПоМетодикеСФР.НачалоРасчетногоПериода
			|			ИЗ
			|				_ДоходностьПоМетодикеСФР)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДоходностьПоМетодикеСФР.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_ЗначенияИндексаНаНачалоРасчетногоПериода.Значение, 0) = 0
			|			ТОГДА 0
			|		ИНАЧЕ ВЫРАЗИТЬ((_ЗначенияИндексаНаКонецРасчетногоПериода.Значение - _ЗначенияИндексаНаНачалоРасчетногоПериода.Значение) / _ЗначенияИндексаНаНачалоРасчетногоПериода.Значение * 100 * &ДнейВГоду / (РАЗНОСТЬДАТ(_ДоходностьПоМетодикеСФР.НачалоРасчетногоПериода, _ДоходностьПоМетодикеСФР.КонецРасчетногоПериода, ДЕНЬ) + 1) КАК ЧИСЛО(10, 2))
			|	КОНЕЦ КАК ПриростИндекса
			|ПОМЕСТИТЬ _ДанныеИндексаДляСчетовДУ
			|ИЗ
			|	_ДоходностьПоМетодикеСФР КАК _ДоходностьПоМетодикеСФР
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияИндекса КАК _ЗначенияИндексаНаНачалоРасчетногоПериода
			|		ПО _ДоходностьПоМетодикеСФР.НачалоРасчетногоПериода = _ЗначенияИндексаНаНачалоРасчетногоПериода.Дата
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияИндекса КАК _ЗначенияИндексаНаКонецРасчетногоПериода
			|		ПО (НАЧАЛОПЕРИОДА(_ДоходностьПоМетодикеСФР.КонецРасчетногоПериода, ДЕНЬ) = _ЗначенияИндексаНаКонецРасчетногоПериода.Дата)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДоходностьПоМетодикеСФР.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_ДанныеИндексаДляСчетовДУ.ПриростИндекса, 0) = 0
			|				ИЛИ _ДоходностьПоМетодикеСФР.Доходность <= _ДанныеИндексаДляСчетовДУ.ПриростИндекса
			|			ТОГДА 0
			|		ИНАЧЕ (_ДоходностьПоМетодикеСФР.Доходность - _ДанныеИндексаДляСчетовДУ.ПриростИндекса) / _ДанныеИндексаДляСчетовДУ.ПриростИндекса
			|	КОНЕЦ КАК ПоправочныйКоэффициентКСтавкеВознаграждения,
			|	_ДоходностьПоМетодикеСФР.Доходность КАК ДоходностьУправления,
			|	_ДанныеИндексаДляСчетовДУ.ПриростИндекса КАК ПриростИндекса
			|ПОМЕСТИТЬ _ПоправочныйКоэффициентПоДоходностиИИндексуОблигаций
			|ИЗ
			|	_ДоходностьПоМетодикеСФР КАК _ДоходностьПоМетодикеСФР
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеИндексаДляСчетовДУ КАК _ДанныеИндексаДляСчетовДУ
			|		ПО _ДоходностьПоМетодикеСФР.СчетДоверительногоУправления = _ДанныеИндексаДляСчетовДУ.СчетДоверительногоУправления";	
				
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_ЗначенияКБД" Тогда 
		
		#Область _ЗначенияКБД
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.НачалоГода КАК НачальнаяДата,
			|	_Клиенты.КонецРасчетногоПериода КАК КонечнаяДата,
			|	КБД.Период КАК Период,
			|	ВЫРАЗИТЬ(КБД.CLOSE КАК ЧИСЛО(27, 2)) КАК Значение
			|ПОМЕСТИТЬ _ЗначенияКБД
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|		ПО (ДанныеКалендаря.Календарь = &КалендарьТорговММВБ)
			|			И (ДанныеКалендаря.Дата МЕЖДУ _Клиенты.НачалоГода И _Клиенты.КонецРасчетногоПериода)
			|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|				ИЛИ ДанныеКалендаря.Дата = _Клиенты.НачалоГода)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияБиржевыхИндексов КАК КБД
			|		ПО (КБД.Период = ДанныеКалендаря.Дата)
			|			И (КБД.Биржа = &БиржаММВБ)
			|			И (КБД.БиржевойИндекс = &КБД_ММВБ_1год)";		
		
		Запрос.Параметры.Вставить("БиржаММВБ",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
		Запрос.Параметры.Вставить("КалендарьТорговММВБ",	Константы.ОсновнойКалендарьКотировок.Получить());	
		Запрос.Параметры.Вставить("КБД_ММВБ_1год",			ОбщегоНазначения.ПолучитьИменованныйОбъект("MOEX_GCURVE_1Y"));	
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_БазовыйДоход"
		ИЛИ ИмяИсточника = "_БазовыйДоходБаланс"
	Тогда 
		
		#Область _БазовыйДоход
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИтоговыйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА МАКСИМУМ(ИтоговыйЗапрос.ЗначениеКБД ЕСТЬ NULL)
			|			ТОГДА NULL
			|		ИНАЧЕ ЕСТЬNULL(СУММА(ИтоговыйЗапрос.СуммаДвиженияВВалютеРасчета * (ИтоговыйЗапрос.ЗначениеКБД + ИтоговыйЗапрос.ОтличиеОтКБД) / 100 * ИтоговыйЗапрос.ДнейДоРасчета / ИтоговыйЗапрос.ДнейВГоду), 0)
			|	КОНЕЦ КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _БазовыйДоход
			|ИЗ
			|	(ВЫБРАТЬ
			|		ДвиженияАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_Клиенты.ПараметрРасчетаСтавкаОтличиеОтКБД КАК ОтличиеОтКБД,
			|		ВЫБОР
			|			КОГДА _Клиенты.ПараметрСреднееЗначениеКБД
			|				ТОГДА ДвиженияАктивов.СреднееЗначениеКБД
			|			ИНАЧЕ ДвиженияАктивов.ДействующееЗначениеКБД
			|		КОНЕЦ КАК ЗначениеКБД,
			|		ДвиженияАктивов.СуммаВВалютеРасчета КАК СуммаДвиженияВВалютеРасчета,
			|		ДвиженияАктивов.ДнейДоРасчета КАК ДнейДоРасчета,
			|		_Клиенты.ДнейВГоду КАК ДнейВГоду
			|	ИЗ
			|		(ВЫБРАТЬ
			|			_ВводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			_ВводыАктивовСНачалаГодаРазвернуто.Период КАК Период,
			|			_ВводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета КАК ДнейДоРасчета,
			|			_ВводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчета КАК СуммаВВалютеРасчета,
			|			СРЕДНЕЕ(ВЫРАЗИТЬ(_ЗначенияКБД.Значение КАК ЧИСЛО(27, 12))) КАК СреднееЗначениеКБД,
			|			МАКСИМУМ(ВЫБОР
			|					КОГДА _ЗначенияКБД.Период = БлижайшиеДатыЗначенийКБД.ДатаЗначения
			|						ТОГДА _ЗначенияКБД.Значение
			|				КОНЕЦ) КАК ДействующееЗначениеКБД
			|		ИЗ
			|			_ВводыАктивовСНачалаГодаРазвернуто КАК _ВводыАктивовСНачалаГодаРазвернуто
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|					_ВводыАктивовСНачалаГодаРазвернуто.Период КАК Период,
			|					МАКСИМУМ(_ЗначенияКБД.Период) КАК ДатаЗначения
			|				ИЗ
			|					_ВводыАктивовСНачалаГодаРазвернуто КАК _ВводыАктивовСНачалаГодаРазвернуто
			|						ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияКБД КАК _ЗначенияКБД
			|						ПО (_ЗначенияКБД.Период <= _ВводыАктивовСНачалаГодаРазвернуто.Период)
			|				
			|				СГРУППИРОВАТЬ ПО
			|					_ВводыАктивовСНачалаГодаРазвернуто.Период) КАК БлижайшиеДатыЗначенийКБД
			|				ПО (БлижайшиеДатыЗначенийКБД.Период = _ВводыАктивовСНачалаГодаРазвернуто.Период)
			|				ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияКБД КАК _ЗначенияКБД
			|				ПО (_ЗначенияКБД.Период >= БлижайшиеДатыЗначенийКБД.ДатаЗначения)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_ВводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления,
			|			_ВводыАктивовСНачалаГодаРазвернуто.Период,
			|			_ВводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета,
			|			_ВводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчета
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			_ВыводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления,
			|			_ВыводыАктивовСНачалаГодаРазвернуто.Период,
			|			_ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета,
			|			-_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок,
			|			СРЕДНЕЕ(ВЫРАЗИТЬ(_ЗначенияКБД.Значение КАК ЧИСЛО(27, 12))),
			|			МАКСИМУМ(ВЫБОР
			|					КОГДА _ЗначенияКБД.Период = БлижайшиеДатыЗначенийКБД.ДатаЗначения
			|						ТОГДА _ЗначенияКБД.Значение
			|				КОНЕЦ)
			|		ИЗ
			|			_ВыводыАктивовСНачалаГодаРазвернуто КАК _ВыводыАктивовСНачалаГодаРазвернуто
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|					_ВыводыАктивовСНачалаГодаРазвернуто.Период КАК Период,
			|					МАКСИМУМ(_ЗначенияКБД.Период) КАК ДатаЗначения
			|				ИЗ
			|					_ВыводыАктивовСНачалаГодаРазвернуто КАК _ВыводыАктивовСНачалаГодаРазвернуто
			|						ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияКБД КАК _ЗначенияКБД
			|						ПО (_ЗначенияКБД.Период <= _ВыводыАктивовСНачалаГодаРазвернуто.Период)
			|				
			|				СГРУППИРОВАТЬ ПО
			|					_ВыводыАктивовСНачалаГодаРазвернуто.Период) КАК БлижайшиеДатыЗначенийКБД
			|				ПО (БлижайшиеДатыЗначенийКБД.Период = _ВыводыАктивовСНачалаГодаРазвернуто.Период)
			|				ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияКБД КАК _ЗначенияКБД
			|				ПО (_ЗначенияКБД.Период >= БлижайшиеДатыЗначенийКБД.ДатаЗначения)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_ВыводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления,
			|			_ВыводыАктивовСНачалаГодаРазвернуто.Период,
			|			_ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета,
			|			_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок) КАК ДвиженияАктивов
			|			ЛЕВОЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
			|			ПО (_Клиенты.СчетДоверительногоУправления = ДвиженияАктивов.СчетДоверительногоУправления)) КАК ИтоговыйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ИтоговыйЗапрос.СчетДоверительногоУправления";	
		
		ДобавитьИсточникДанных(Запрос, "_ЗначенияКБД");
		ДобавитьИсточникДанных(Запрос, "_ВыводыАктивовСНачалаГодаРазвернуто");
		
		Если ИмяИсточника = "_БазовыйДоход" Тогда
			ДобавитьИсточникДанных(Запрос, "_ВводыАктивовСНачалаГодаРазвернуто");
		Иначе
			ДобавитьИсточникДанных(Запрос, "_ВводыАктивовСНачалаГодаРазвернутоБаланс");
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_БазовыйДоход",						"_БазовыйДоходБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ВводыАктивовСНачалаГодаРазвернуто",	"_ВводыАктивовСНачалаГодаРазвернутоБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СуммаВВалютеРасчетаРынок",			"СуммаВВалютеРасчетаБаланс");
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_СреднедневнаяСтоимостьАктивов"
		ИЛИ ИмяИсточника = "_СреднедневнаяСтоимостьАктивовБаланс"
	Тогда 
	
		#Область СреднедневнаяСтоимостьАктивов
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СтоимостьАктивовНаКаждыйКалендарныйДень.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЕСТЬNULL(СРЕДНЕЕ(_СтоимостьАктивовНаКаждыйКалендарныйДень.СуммаВВалютеРасчета), 0) КАК СуммаВВалютеРасчета,
			|	ЕСТЬNULL(КОЛИЧЕСТВО(_СтоимостьАктивовНаКаждыйКалендарныйДень.Дата), 0) КАК КоличествоДней
			|ПОМЕСТИТЬ _СреднедневнаяСтоимостьАктивов
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВводыВыводыАктивовНаКаждыйКалендарныйДень.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		ВводыВыводыАктивовНаКаждыйКалендарныйДень.Дата КАК Дата,
			|		ЕСТЬNULL(СУММА(ВводыВыводыАктивовНаКаждыйКалендарныйДень.СуммаВВалютеРасчета), 0) КАК СуммаВВалютеРасчета
			|	ИЗ
			|		(ВЫБРАТЬ
			|			_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			ДанныеКалендаря.Дата КАК Дата,
			|			СУММА(_ВводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчета) КАК СуммаВВалютеРасчета
			|		ИЗ
			|			_Клиенты КАК _Клиенты
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|				ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
			|					И (ДанныеКалендаря.Дата МЕЖДУ _Клиенты.НачалоРасчетногоПериода И _Клиенты.КонецРасчетногоПериода)
			|				ЛЕВОЕ СОЕДИНЕНИЕ _ВводыАктивовСНачалаГодаРазвернуто КАК _ВводыАктивовСНачалаГодаРазвернуто
			|				ПО (_ВводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|					И (_ВводыАктивовСНачалаГодаРазвернуто.Период <= ДанныеКалендаря.Дата)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_Клиенты.СчетДоверительногоУправления,
			|			ДанныеКалендаря.Дата
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ
			|			_Клиенты.СчетДоверительногоУправления,
			|			ДанныеКалендаря.Дата,
			|			-СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок)
			|		ИЗ
			|			_Клиенты КАК _Клиенты
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|				ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
			|					И (ДанныеКалендаря.Дата МЕЖДУ _Клиенты.НачалоРасчетногоПериода И _Клиенты.КонецРасчетногоПериода)
			|				ЛЕВОЕ СОЕДИНЕНИЕ _ВыводыАктивовСНачалаГодаРазвернуто КАК _ВыводыАктивовСНачалаГодаРазвернуто
			|				ПО (_ВыводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|					И (_ВыводыАктивовСНачалаГодаРазвернуто.Период <= ДанныеКалендаря.Дата)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_Клиенты.СчетДоверительногоУправления,
			|			ДанныеКалендаря.Дата) КАК ВводыВыводыАктивовНаКаждыйКалендарныйДень
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ВводыВыводыАктивовНаКаждыйКалендарныйДень.СчетДоверительногоУправления,
			|		ВводыВыводыАктивовНаКаждыйКалендарныйДень.Дата) КАК _СтоимостьАктивовНаКаждыйКалендарныйДень
			|
			|СГРУППИРОВАТЬ ПО
			|	_СтоимостьАктивовНаКаждыйКалендарныйДень.СчетДоверительногоУправления";	
		
		СуффиксСумм = ?(ИмяИсточника = "_СреднедневнаяСтоимостьАктивовБаланс", "Баланс", "");
		
		Если СуффиксСумм = "Баланс" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_СреднедневнаяСтоимостьАктивов",		"_СреднедневнаяСтоимостьАктивовБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ВводыАктивовСНачалаГодаРазвернуто",	"_ВводыАктивовСНачалаГодаРазвернутоБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СуммаВВалютеРасчетаРынок",			"СуммаВВалютеРасчетаБаланс");
		КонецЕсли;
		
		ДобавитьИсточникДанных(Запрос, "_ВводыАктивовСНачалаГодаРазвернуто" + СуффиксСумм);
		ДобавитьИсточникДанных(Запрос, "_ВыводыАктивовСНачалаГодаРазвернуто");		
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_СЧАЗаРасчетныйПериод" Тогда 
	
		#Область СЧАЗаРасчетныйПериод	
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ФинансовыеПоказатели.Период КАК Дата,
			|	_Клиенты.ВалютаУчета КАК Валюта,
			|	ФинансовыеПоказатели.Значение КАК Сумма,
			|	ФинансовыеПоказатели.Значение КАК СуммаВВалютеУчета,
			|	ФинансовыеПоказатели.Значение / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _СЧАЗаРасчетныйПериод
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|		ПО (ФинансовыеПоказатели.Организация = _Клиенты.Организация)
			|			И (ФинансовыеПоказатели.СубъектАналитики = _Клиенты.СчетДоверительногоУправления)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (ФинансовыеПоказатели.Период МЕЖДУ _Клиенты.НачалоРасчетногоПериода И _Клиенты.КонецРасчетногоПериода)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = ФинансовыеПоказатели.Период)";	
						
		#КонецОбласти		
		
	ИначеЕсли ИмяИсточника = "_ДанныеКалендаряКлиента" Тогда 
		
		#Область ДанныеКалендаряКлиента	
		
		// Количество рабочих дней в 2020-й году хардкодим

		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(_Клиенты.НачалоРасчетногоПериода, ГОД) КАК НачалоПериода,
			|	КОНЕЦПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ГОД) КАК КонецПериода
			|ПОМЕСТИТЬ _ГраницыКалендаряКлиентов
			|ИЗ
			|	_Клиенты КАК _Клиенты";
		Запрос.Выполнить();
		
		Справочники.Календари.ПоместитьВЗапросДанныеКалендаряПоТаблицеКлиентов(
			"_ГраницыКалендаряКлиентов",
			Запрос.Параметры.ДатаРасчета,
			Справочники.Календари.Общероссийский,
			Неопределено, 
			Запрос.МенеджерВременныхТаблиц,
			"_ДанныеКалендаряКлиента");			
			
		#КонецОбласти		
		
	ИначеЕсли ИмяИсточника = "_СЧАЗаБазовыйПериодДляСреднейСЧА" Тогда 
		
		#Область СЧАЗаБазовыйПериодДляСреднейСЧА	
		
		// Пока случай единичный, рассчитываем среднюю СЧА по рабочим дням периода.
		// Если появится другой вариант, нужно добавить его в настройку в справочнике "НастройкиРасчета" и использовать его в запросе.
		// Но мне больше нравится заменить параметр "ТолькоПоРабочимДням" на "ДниРасчетаСЧА" с типом Справочник.НастройкиРегламентныхДействий. 
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДанныеКалендаряКлиента.Дата КАК Дата,
			|	_СЧАЗаРасчетныйПериод.Валюта КАК Валюта,
			|	_СЧАЗаРасчетныйПериод.Сумма КАК Сумма,
			|	_СЧАЗаРасчетныйПериод.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
			|	_СЧАЗаРасчетныйПериод.СуммаВВалютеРасчета КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _СЧАЗаБазовыйПериодДляСреднейСЧА
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеКалендаряКлиента КАК _ДанныеКалендаряКлиента
			|		ПО (_ДанныеКалендаряКлиента.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (_ДанныеКалендаряКлиента.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
			|			И (_ДанныеКалендаряКлиента.Дата МЕЖДУ ВЫБОР
			|				КОГДА _Клиенты.НачалоРасчетногоПериода > _Клиенты.НачалоБазовогоПериода
			|					ТОГДА _Клиенты.НачалоРасчетногоПериода
			|				ИНАЧЕ _Клиенты.НачалоБазовогоПериода
			|			КОНЕЦ И ВЫБОР
			|				КОГДА _Клиенты.КонецРасчетногоПериода < _Клиенты.КонецБазовогоПериода
			|					ТОГДА _Клиенты.КонецРасчетногоПериода
			|				ИНАЧЕ _Клиенты.КонецБазовогоПериода
			|			КОНЕЦ)
			|			И (_ДанныеКалендаряКлиента.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|				ИЛИ _Клиенты.ПараметрРасчетаТолькоПоРабочимДням = ЛОЖЬ)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧАЗаРасчетныйПериод КАК _СЧАЗаРасчетныйПериод
			|		ПО (_СЧАЗаРасчетныйПериод.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (_СЧАЗаРасчетныйПериод.Дата = _ДанныеКалендаряКлиента.Дата)";

		ДобавитьИсточникДанных(Запрос, "_ДанныеКалендаряКлиента");
		ДобавитьИсточникДанных(Запрос, "_СЧАЗаРасчетныйПериод");

		#КонецОбласти		
		
	ИначеЕсли ИмяИсточника = "_КурсыВалют" Тогда 
		
		#Область _КурсыВалют
		
		// В валюте могу быть только вводы/выводы, поэтому собираю их валюты
		// и получаю курсы с начала расчетного периода (или даты расчета СЧА на начало года) по конец расчетного периода.
		// Если появится что-то еще, нужно доработать или переработать
				
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ГраницыДатВалют.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	КурсыВалют.Валюта КАК Валюта,
			|	КурсыВалют.Период КАК Дата,
			|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
			|ПОМЕСТИТЬ _КурсыВалют
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ГраницыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_ВалютыРасчета.Валюта КАК Валюта,
			|		_ГраницыРасчета.НачальнаяДата КАК НачальнаяДата,
			|		_ГраницыРасчета.КонечнаяДата КАК КонечнаяДата
			|	ИЗ
			|		#ГраницыРасчета КАК _ГраницыРасчета
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ВалютыРасчета КАК _ВалютыРасчета
			|			ПО (_ВалютыРасчета.СчетДоверительногоУправления = _ГраницыРасчета.СчетДоверительногоУправления)
			|				И (_ВалютыРасчета.Валюта <> _ГраницыРасчета.ВалютаУчета)) КАК ГраницыДатВалют
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ПО (КурсыВалют.Валюта = ГраницыДатВалют.Валюта)
			|			И (КурсыВалют.Период МЕЖДУ ГраницыДатВалют.НачальнаяДата И ГраницыДатВалют.КонечнаяДата)";
		
		// Границы расчета
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СЧАНаНачалоГода") = Неопределено Тогда
			ГраницыРасчета =
				"ВЫБРАТЬ
				|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	_Клиенты.ВалютаУчета КАК ВалютаУчета,
				|	_Клиенты.НачалоРасчетногоПериода КАК НачальнаяДата,
				|	_Клиенты.КонецРасчетногоПериода КАК КонечнаяДата
				|ИЗ
				|	_Клиенты КАК _Клиенты";
		Иначе	
			ГраницыРасчета =
				"ВЫБРАТЬ
				|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	_Клиенты.ВалютаУчета КАК ВалютаУчета,
				|	ВЫБОР
				|		КОГДА _СЧАНаНачалоГода.Дата < _Клиенты.НачалоРасчетногоПериода
				|			ТОГДА _СЧАНаНачалоГода.Дата
				|		ИНАЧЕ _Клиенты.НачалоРасчетногоПериода
				|	КОНЕЦ КАК НачальнаяДата,
				|	_Клиенты.КонецРасчетногоПериода КАК КонечнаяДата
				|ИЗ
				|	_Клиенты КАК _Клиенты
				|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧАНаНачалоГода КАК _СЧАНаНачалоГода
				|		ПО (_СЧАНаНачалоГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ГраницыРасчета", "(" + ГраницыРасчета + ")");
		
		// Валюты расчета
		
		ВалютыРасчета = РаботаСКоллекциями.ЗначениеВМассив(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.ВалютаРасчета КАК Валюта
			|ИЗ
			|	_Клиенты КАК _Клиенты");
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВводыАктивовСНачалаГодаРазвернуто") <> Неопределено Тогда
			ВалютыРасчета.Добавить("ВЫБРАТЬ РАЗЛИЧНЫЕ СчетДоверительногоУправления, Валюта ИЗ _ВводыАктивовСНачалаГодаРазвернуто");
		КонецЕсли;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВводыАктивовСНачалаГодаРазвернутоБаланс") <> Неопределено Тогда
			ВалютыРасчета.Добавить("ВЫБРАТЬ РАЗЛИЧНЫЕ СчетДоверительногоУправления, Валюта ИЗ _ВводыАктивовСНачалаГодаРазвернутоБаланс");
		КонецЕсли;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВыводыАктивовСНачалаГодаРазвернуто") <> Неопределено Тогда
			ВалютыРасчета.Добавить("ВЫБРАТЬ РАЗЛИЧНЫЕ СчетДоверительногоУправления, Валюта ИЗ _ВыводыАктивовСНачалаГодаРазвернуто");
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ВалютыРасчета", "(" + СтрСоединить(ВалютыРасчета, Символы.ПС + " ОБЪЕДИНИТЬ " + Символы.ПС) + ")");
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_РассчитанноеВознаграждениеЗаУправление" Тогда 
		
		#Область _РассчитанноеВознаграждениеЗаУправление
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РассчитанноеВознаграждение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА НЕ РассчитанноеВознаграждение.ОшибкаРасчета
			|			ТОГДА РассчитанноеВознаграждение.СуммаВознагражденияЗаУправление
			|	КОНЕЦ КАК Сумма
			|ПОМЕСТИТЬ _РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета
			|ИЗ
			|	&РассчитанноеВознаграждение КАК РассчитанноеВознаграждение
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета.Сумма КАК СуммаВВалютеУчета,
			|	ВЫРАЗИТЬ(_РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета.Сумма * КурсВалютыУчета.Курс / КурсВалютыУчета.Кратность / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность КАК ЧИСЛО(1, 1)) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _РассчитанноеВознаграждениеЗаУправление
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета КАК _РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета
			|		ПО (_РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _РассчитанноеВознаграждениеЗаУправлениеВВалютеУчета";
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто" Тогда 
		
		#Область _НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
			|	СУММА(ВЫБОР
			|			КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|				ТОГДА 1
			|			ИНАЧЕ -1
			|		КОНЕЦ * (ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона)) КАК СуммаВВалютеУчета,
			|	СУММА(ВЫБОР
			|			КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
			|				ТОГДА 1
			|			ИНАЧЕ -1
			|		КОНЕЦ * (ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона) / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО (ЗадолженностиПоДенежнымСредствам.Организация = _Клиенты.Организация)
			|			И (ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
			|			И (ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ГОД) И _Клиенты.КонецРасчетногоПериода)
			|			И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (&ВидыЗадолженностиПоДоговоруСоСпецдепозитарием))
			|			И (ЗадолженностиПоДенежнымСредствам.Аванс = ЛОЖЬ)
			|			И (ЗадолженностиПоДенежнымСредствам.Активность)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ))
			|ГДЕ
			|	_Клиенты.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
			|
			|СГРУППИРОВАТЬ ПО
			|	_Клиенты.СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_Клиенты.СчетДоверительногоУправления,
			|	ВидыЗадолженности.Ссылка,
			|	NULL,
			|	NULL
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЗадолженности КАК ВидыЗадолженности
			|		ПО (ВидыЗадолженности.Ссылка В (&ВидыЗадолженностиПоДоговоруСоСпецдепозитарием))
			|ГДЕ
			|	_Клиенты.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)";
		
		ВидыЗадолженностиПоДоговоруСоСпецдепозитарием = Новый Массив;
		ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
		ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
		ВидыЗадолженностиПоДоговоруСоСпецдепозитарием.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
		
