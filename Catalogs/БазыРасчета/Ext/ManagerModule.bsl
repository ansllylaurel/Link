	КонецЕсли; 

КонецФункции

Функция ПолучитьРеквизитыБазРасчета(БазаРасчета, ВидРасчета = Неопределено) Экспорт
	
	ДобавляемыеРеквизиты = Новый Массив;	
	
	#Область Общие_базы_расчета	
	
	Если БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение
		ИЛИ БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение	
	Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаЗначение1", Новый ОписаниеТипов("СправочникСсылка.НастройкиРасчета"), , "Значение 1"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаЗначение2", Новый ОписаниеТипов("СправочникСсылка.НастройкиРасчета"), , "Значение 2 (ограничение)"));
		
	#КонецОбласти
		
	#Область Базы_для_расчета_вознаграждения
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоходПоБалансу
	Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка вознаграждения (СВУпр)"));
	
		РаботаСКоллекциями.ДополнитьМассив(ДобавляемыеРеквизиты, РеквизитыРасчетаИнвестиционногоДохода()); 
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяРыночнаяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного
		ИЛИ БазаРасчета = Справочники.БазыРасчета.СредняяБалансоваяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного
	Тогда
	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка вознаграждения"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаРасчетОтСЧАнаКонецПериода", Новый ОписаниеТипов("Булево"), , "Расчет от СЧА на конец периода"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяОценочнаяСтоимостьИмуществаПринятогоВДоверительноеУправление Тогда
	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка вознаграждения"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВГод Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСумма", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип, , "Сумма в год"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВМесяц Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСумма", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип, , "Сумма в месяц"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВДень Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСумма", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип, , "Сумма за каждый день"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаТолькоПриНаличииДохода", Новый ОписаниеТипов("Булево"), , "Только при наличии дохода"));
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяСЧА
		ИЛИ БазаРасчета = Справочники.БазыРасчета.УдельнаяСуммаСЧА
	Тогда
	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка вознаграждения"));	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаТолькоПоРабочимДням", Новый ОписаниеТипов("Булево"), , "Только по рабочим дням"));
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБД
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБДПоБалансу
	Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрСреднееЗначениеКБД", Новый ОписаниеТипов("Булево") , , "Среднеарифметическое значений КБД до даты расчета"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаОтличиеОтКБД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Превышение среднего значения MOEX GCURVE 1Y для расчета ставки базовой доходности"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаМД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от мин. дохода"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаБД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от базового дохода"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаПревышение", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от превышения ИД над базовым доходом"));				

		РаботаСКоллекциями.ДополнитьМассив(ДобавляемыеРеквизиты, РеквизитыРасчетаИнвестиционногоДохода()); 
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИСреднедневнойБалансовойСтоимостиИмуществаНаходящегосяВРазмещении Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаИД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка основного вознаграждения"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаНижнийПроцентОтСредней", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Нижний процент от среднедн. стоимости активов (Пн)"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаВерхнийПроцентОтСредней", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Верхний процент от среднедн. стоимости активов (Пв)"));				
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаРазницаИДиСНП", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от (ИД - Пн)"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаРазницаСВПиСНП", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от (Пв - Пн)"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаРазницаИДиСВП", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от (ИД - Пв)"));				
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу
	Тогда
	
		// ИсключатьДеньПриемаПередачиАктивовИзУправления:
		// - ЛОЖЬ:
		//   - Начальная стоимость берется на начало периода, считается в управлении до начала следующего календарного дня после отчетного периода.
		//   - При приеме-передачи период времени считается с начала дня приема-передачи до начала следующего календарного дня после отчетного периода.
		// - ИСТИНА:
		//   - Начальная стоимость берется на конец календарного дня, предшествующего первому дню отчетного периода, считается в управлении до конца отчетного периода.
		//   - При приеме-передачи период времени считается с конца дня приема-передачи до конца отчетного периода.	
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаМД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка минимальной доходности"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаГД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка гарантированной доходности"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаПревышение", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от превышения ИД над минимальным доходом"));				
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления", Новый ОписаниеТипов("Булево"), , "Исключать день приема-передачи активов из управления"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходомПоБалансу
	Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаГД", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Ставка гарантированной доходности"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавкаПревышение", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент от превышения ИД над гарантированным доходом"));				
		
	#КонецОбласти
	
	#Область Базы_для_расчета_доходности
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.БиржевойИндекс Тогда
		
		// Параметры
		//   - Среднеарифметическое	- Да - для индекса будет произведён расчёт среднего значения. 
		//							- Нет - будет взят индекс на конец периода, если это доходность или прирост индекса, для остальных видов индексов.
		//   - КоличествоЗначений	- Количество значений, используемых для расчёта среднего индекса. Не используется для индекса доходности, он считается за период отчёта.
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаБиржевойИндекс"	, Новый ОписаниеТипов("СправочникСсылка.БиржевыеИндексы")		, , "Биржевой индекс"));	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаДоля"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4))	, , "Доля"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаВалютаКонвертации", Новый ОписаниеТипов("СправочникСсылка.Валюты")	, , "Конвертировать в валюту"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрСреднеарифметическое"	, Новый ОписаниеТипов("Булево")	, , "Среднеарифметическое"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрКоличествоЗначений"		, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0))	, , "Кол-во значений"));		
			
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИзменениеСтоимостиЦБ Тогда
		
		// Список видов котировок ограничен в форме "ПараметрыРасчета" справочника "НастройкиРасчета".
		// При добавлении нового вида, доработать отчёт расчёт доходности ДУ 
		
		МассивТиповЦБ = Новый Массив;
		МассивТиповЦБ.Добавить(Тип("СправочникСсылка.Акции"));
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаЦБ", Новый ОписаниеТипов(МассивТиповЦБ), , "Ценная бумага"));	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаДоля", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4))	, , "Доля"));		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрВидКотировки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50))	, , "Вид котировки"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИндексПотребительскихЦен Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаДоля", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4)),,			"Доля"));
		
		Если ВидРасчета = Перечисления.ВидыРасчета.РасчетПроцентнойСтавки Тогда
		
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаВидИПЦ", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПроцентныхПоказателей"),,	"Вид ИПЦ"));
		
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСтавка Тогда
		
		// Пока полноценных формул нет, ставка может быть отрицательной
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)), , "Ставка"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.КлючеваяСтавкаЦБРФ ИЛИ БазаРасчета = Справочники.БазыРасчета.ИзменениеВВП Тогда
	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаДоля", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4))	, , "Доля"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрСреднеарифметическое"	, Новый ОписаниеТипов("Булево")	, , "Среднеарифметическое"));		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.КБДМосковскойБиржи Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСрок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4)), , "Срок, лет"));	
		
	#КонецОбласти
		
	#Область Базы_для_расчета_резервов_ПИФ
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтОднойДвенадцатойПоследнейСЧА Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)), , "Ставка резерва"));	
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаНижняяГраницаСуммы", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)), , "Нижняя граница суммы"));	
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)), , "Ставка резерва"));	
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)), , "Сумма"));	
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)), , "Сумма"));
	    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаПоКалендарнымДням", Новый ОписаниеТипов("Булево"), , "Расчет по календарным дням"));
		
	#КонецОбласти
	
	#Область Базы_для_расчета_надбавок_и_скидок_ПИФ	
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПроцентомОтРасчетнойСтоимостиПая Тогда		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаСтавка", Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип, , "Процент надбавки"));
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПроцентомОтРасчетнойСтоимостиПаяВЗависимостиОтСрокаВладенияПаями Тогда				
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаШкалаПроцентовВЗависимостиОтСрокаВладенияПаями"	, Новый ОписаниеТипов("СправочникСсылка.ШкалыПроцентныхСтавок"),, "Процент скидки в зависимости от срока владения паями (в календрных днях)"));
		
	КонецЕсли;
	
	#КонецОбласти
		
	Возврат ДобавляемыеРеквизиты;
	
КонецФункции

Функция РеквизитыРасчетаИнвестиционногоДохода() Экспорт
	
	Реквизиты = Новый Массив;
	
	Реквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаКорректироватьНаРазницуБалансаИРынка", Новый ОписаниеТипов("Булево"), , "Корректировать на разницу м/у балансовой и рыночной стоимостью вводов/выводов активов"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаУменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод", Новый ОписаниеТипов("Булево"), , "Уменьшать на сумму убытка за предыдущий отчетный период"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаУменьшатьНаСуммуВознагражденияЗаУправление", Новый ОписаниеТипов("Булево"), , "Уменьшать на сумму начисленного вознаграждения за управление"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаУменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария", Новый ОписаниеТипов("Булево"), , "Уменьшать на сумму необходимых расходов и стоимость услуг специализированного депозитария"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций", Новый ОписаниеТипов("Булево"), , "Корректировать ставку на поправочный коэффициент, рассчитываемый от доходности управления и индекса облигаций"));
	
	Возврат Реквизиты;
	
КонецФункции

Функция ПолучитьПредставлениеРасчета(БазаРасчета, ПараметрыРасчета, ПериодичностьРасчета = Неопределено) Экспорт
	
	ПредставлениеРасчета = "";	
	
	#Область Общие_базы_расчета	
	
	Если БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение Тогда
		
		ПредставлениеЗначения1 = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаЗначение1") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаЗначение1), ПараметрыРасчета.ПараметрРасчетаЗначение1, "X");
		ПредставлениеЗначения2 = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаЗначение2") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаЗначение2), ПараметрыРасчета.ПараметрРасчетаЗначение2, "Y");

		ПредставлениеРасчета = СтрШаблон("max(%1; %2)", ПредставлениеЗначения1, ПредставлениеЗначения2);	
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение Тогда
		
		ПредставлениеЗначения1 = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаЗначение1") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаЗначение1), ПараметрыРасчета.ПараметрРасчетаЗначение1, "X");
		ПредставлениеЗначения2 = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаЗначение2") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаЗначение2), ПараметрыРасчета.ПараметрРасчетаЗначение2, "Y");

		ПредставлениеРасчета = СтрШаблон("min(%1; %2)", ПредставлениеЗначения1, ПредставлениеЗначения2);	
		
	#КонецОбласти
	
	#Область Базы_для_расчета_вознаграждения
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоходПоБалансу
	Тогда

		ПредставлениеРасчета = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧН="), "X") + "% от ИД";
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций") 
			И ПараметрыРасчета.ПараметрРасчетаКорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций = Истина Тогда
			
			ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "%", "% * К");
		КонецЕсли;
			
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаКорректироватьНаРазницуБалансаИРынка") И ПараметрыРасчета.ПараметрРасчетаКорректироватьНаРазницуБалансаИРынка = Истина
			ИЛИ ПараметрыРасчета.Свойство("ПараметрРасчетаУменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод") И ПараметрыРасчета.ПараметрРасчетаУменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод = Истина
			ИЛИ ПараметрыРасчета.Свойство("ПараметрРасчетаУменьшатьНаСуммуВознагражденияЗаУправление") И ПараметрыРасчета.ПараметрРасчетаУменьшатьНаСуммуВознагражденияЗаУправление = Истина
			ИЛИ ПараметрыРасчета.Свойство("ПараметрРасчетаУменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария") И ПараметрыРасчета.ПараметрРасчетаУменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария = Истина			
		Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + "к";
		КонецЕсли;
		
		Если БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоходПоБалансу Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " [баланс]";
		КонецЕсли;

	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВГод Тогда
		
		ПредставлениеРасчета = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаСумма"), Формат(ПараметрыРасчета.ПараметрРасчетаСумма, "ЧН="), "X")  + " руб. в год";

	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВМесяц Тогда
		
		ПредставлениеРасчета = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаСумма"), Формат(ПараметрыРасчета.ПараметрРасчетаСумма, "ЧН="), "X")  + " руб. в месяц";
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВДень Тогда
		
		ПредставлениеРасчета = ?(ПараметрыРасчета.Свойство("ПараметрРасчетаСумма"), Формат(ПараметрыРасчета.ПараметрРасчетаСумма, "ЧН="), "X")  + " руб. в день";
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаТолькоПриНаличииДохода") И ПараметрыРасчета.ПараметрРасчетаТолькоПриНаличииДохода Тогда 
			ПредставлениеРасчета = ПредставлениеРасчета + " при наличии дохода";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБД
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБДПоБалансу
	Тогда
		
		ПредставлениеКБД			= "GCURVE";
		ПредставлениеПараметраКБД	= "";
		
		Если ПараметрыРасчета.Свойство("ПараметрСреднееЗначениеКБД") И ПараметрыРасчета.ПараметрСреднееЗначениеКБД Тогда
			Для НС = 1 По СтрДлина(ПредставлениеКБД) Цикл
				ПредставлениеПараметраКБД = ПредставлениеПараметраКБД + Сред(ПредставлениеКБД, НС, 1) + Символ(773);
			КонецЦикла;
		Иначе
			ПредставлениеПараметраКБД = ПредставлениеКБД;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрСреднееЗначениеКБД") И ПараметрыРасчета.ПараметрСреднееЗначениеКБД Тогда
			Для НС = 1 По СтрДлина(ПредставлениеКБД) Цикл 
				ПредставлениеКБД = Лев(ПредставлениеКБД, НС * 2 - 1) + Символ(773) + Сред(ПредставлениеКБД, НС * 2);
			КонецЦикла;
		КонецЕсли;
		
		Расчет = Новый Массив;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаОтличиеОтКБД") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаСтавкаОтличиеОтКБД) Тогда
			Расчет.Добавить(ПредставлениеПараметраКБД + ?(ПараметрыРасчета.ПараметрРасчетаСтавкаОтличиеОтКБД > 0, "+", "-") + Строка(ПараметрыРасчета.ПараметрРасчетаСтавкаОтличиеОтКБД) + "%");
		Иначе
			Расчет.Добавить(ПредставлениеПараметраКБД);	
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаМД") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаСтавкаМД) Тогда
			Расчет.Добавить(Строка(ПараметрыРасчета.ПараметрРасчетаСтавкаМД) + "% МИН(ИД; Бд)");
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаБД") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаСтавкаБД) Тогда
			Расчет.Добавить(Строка(ПараметрыРасчета.ПараметрРасчетаСтавкаБД) + "% БД");
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаПревышение") И ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаСтавкаПревышение) Тогда
			Расчет.Добавить(Строка(ПараметрыРасчета.ПараметрРасчетаСтавкаПревышение) + "% (ИД - БД)");
		КонецЕсли;
		
		Если Расчет.Количество() > 1 Тогда 
			ПредставлениеРасчета = СтрШаблон("ИД и БД (%1)", СтрСоединить(Расчет, "; ")); 
		Иначе
			ПредставлениеРасчета = "ИД и БД (GCURVE + %; % МИН(ИД, БД); % БД; % (ИД - БД))"; 
		КонецЕсли;

		Если БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБДПоБалансу Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " [баланс]";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяРыночнаяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного
		ИЛИ БазаРасчета = Справочники.БазыРасчета.СредняяБалансоваяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного
	Тогда
		
		ПредставлениеРасчета =
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧН="), "X")
			+ "% от сред. стоимости активов, переданных в ДУ";
				
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаРасчетОтСЧАнаКонецПериода") И ПараметрыРасчета.ПараметрРасчетаРасчетОтСЧАнаКонецПериода Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " (от СЧА на конец периода)";
		КонецЕсли;
				
		Если БазаРасчета = Справочники.БазыРасчета.СредняяБалансоваяСтоимостьИмуществаПринятогоВДоверительноеУправлениеЗаВычетомВыведенного Тогда
			ПредставлениеРасчета = ПредставлениеРасчета  + " [баланс]";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИСреднедневнойБалансовойСтоимостиИмуществаНаходящегосяВРазмещении Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаИД") Тогда
			Если ЗначениеЗаполнено(ПараметрыРасчета.ПараметрРасчетаСтавкаИД) Тогда
				ПредставлениеРасчета = Строка(ПараметрыРасчета.ПараметрРасчетаСтавкаИД) + "%*ИД";
			КонецЕсли;
		Иначе
			ПредставлениеРасчета = "X%*ИД";
		КонецЕсли;
		
		ПредставлениеРасчетаДоп = "Пн<ИД<=Пв:[Y%*(ИД-Пн)] + ИД>Пв:[Z%*(Пв-Пн)+W%*(ИД-Пв)]";
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаНижнийПроцентОтСредней") Тогда
			ПредставлениеРасчетаДоп = СтрЗаменить(ПредставлениеРасчетаДоп, "Пн", Формат(ПараметрыРасчета.ПараметрРасчетаНижнийПроцентОтСредней, "ЧН=; ЧФ=ПЧ"));
		КонецЕсли;		
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаВерхнийПроцентОтСредней") Тогда
			ПредставлениеРасчетаДоп = СтрЗаменить(ПредставлениеРасчетаДоп, "Пв", Формат(ПараметрыРасчета.ПараметрРасчетаВерхнийПроцентОтСредней, "ЧН=; ЧФ=ПЧ"));
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаРазницаИДиСНП") Тогда
			ПредставлениеРасчетаДоп = СтрЗаменить(ПредставлениеРасчетаДоп, "Y%", Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаРазницаИДиСНП, "ЧН=; ЧФ=Ч%"));
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаРазницаСВПиСНП") Тогда
			ПредставлениеРасчетаДоп = СтрЗаменить(ПредставлениеРасчетаДоп, "Z%", Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаРазницаСВПиСНП, "ЧН=; ЧФ=Ч%"));
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаРазницаИДиСВП") Тогда
			ПредставлениеРасчетаДоп = СтрЗаменить(ПредставлениеРасчетаДоп, "W%", Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаРазницаИДиСВП, "ЧН=; ЧФ=Ч%"));
		КонецЕсли;
		
		ПредставлениеРасчета = ПредставлениеРасчета + ?(ПустаяСтрока(ПредставлениеРасчета), ПредставлениеРасчетаДоп, " + " + ПредставлениеРасчетаДоп); 
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу
	Тогда
		
		ПредставлениеРасчета = "X% от превышения ИД над МД (Y% ГД, Z% МД, ИСКЛ)";
		
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "X%",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаПревышение"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаПревышение, "ЧН=; ЧФ=Ч%"), "%"));
			
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "Y% ГД, ",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаГД"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаГД, "ЧФ='Ч% ГД, '"), ""));
			
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "Z% МД, ",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаМД"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаМД, "ЧН=; ЧФ='Ч% МД, '"), "% МД"));
			
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "ИСКЛ",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления") И ПараметрыРасчета.ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления = Истина,
				"исключать день приема-передачи из управления", ""));
			
		Если БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " [баланс]";
		ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " [СЧА на конец рынок, прочее баланс]";
		КонецЕсли;
			
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходомПоБалансу
	Тогда
		
		ПредставлениеРасчета = "X% от превышения ИД над ГД (Y% ГД)";
		
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "X%",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаПревышение"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаПревышение, "ЧН=; ЧФ=Ч%"), "%"));
			
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "Y% ГД",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавкаГД"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавкаГД, "ЧФ='Ч% ГД'"), ""));
			
		Если БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходомПоБалансу Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " [баланс]";
		КонецЕсли;
			
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяСЧА Тогда
		
		ПредставлениеРасчета = "X% от Средней СЧА";
		
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "X%",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧН=; ЧФ=Ч%"), "%"));
			
		ПредставлениеРасчета = ПредставлениеРасчета +
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаТолькоПоРабочимДням"), Формат(ПараметрыРасчета.ПараметрРасчетаТолькоПоРабочимДням, "БЛ=; БИ=' за раб. дни'"), "");
			
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.УдельнаяСуммаСЧА Тогда
		
		ПредставлениеРасчета = "X% от удельной суммы СЧА";
		
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "X%",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧН=; ЧФ=Ч%"), "%"));
			
		ПредставлениеРасчета = ПредставлениеРасчета +
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаТолькоПоРабочимДням"), Формат(ПараметрыРасчета.ПараметрРасчетаТолькоПоРабочимДням, "БЛ=; БИ=' за раб. дни'"), "");			
			
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СредняяОценочнаяСтоимостьИмуществаПринятогоВДоверительноеУправление Тогда
		
		ПредставлениеРасчета = "X% от сред. оценочной стоимости имущества, принятого в ДУ";
		
		ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, "X%",
			?(ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка"), Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧН=; ЧФ=Ч%"), "%"));		
		
	#КонецОбласти
	
	#Область Базы_для_расчета_доходности
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.БиржевойИндекс Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаДоля") И ПараметрыРасчета.ПараметрРасчетаДоля <> 100 Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаДоля, "ЧДЦ=2; ЧГ=0") + "% ";
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаБиржевойИндекс") Тогда
			Если ПараметрыРасчета.Свойство("ПараметрСреднеарифметическое") И ПараметрыРасчета.ПараметрСреднеарифметическое Тогда
				Для НС = 1 По СтрДлина(ПараметрыРасчета.ПараметрРасчетаБиржевойИндекс.Код) Цикл 
					ПредставлениеРасчета = ПредставлениеРасчета + Сред(ПараметрыРасчета.ПараметрРасчетаБиржевойИндекс.Код, НС, 1) + Символ(773);
				КонецЦикла;
			Иначе
				ПредставлениеРасчета = ПредставлениеРасчета + ПараметрыРасчета.ПараметрРасчетаБиржевойИндекс.Код;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаВалютаКонвертации") И ПараметрыРасчета.ПараметрРасчетаВалютаКонвертации <> Справочники.Валюты.ПустаяСсылка() Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " (" + ПараметрыРасчета.ПараметрРасчетаВалютаКонвертации.Наименование + ")";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИзменениеСтоимостиЦБ Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаДоля") И ПараметрыРасчета.ПараметрРасчетаДоля <> 100 Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаДоля, "ЧДЦ=2; ЧГ=0") + "% ";
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаЦБ") Тогда
			ПредставлениеЦБ = Строка(ПараметрыРасчета.ПараметрРасчетаЦБ);
			ПредставлениеРасчета = ПредставлениеРасчета + ПредставлениеЦБ;
		КонецЕсли;
		
		Если ПараметрыРасчета.Свойство("ПараметрВидКотировки") Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + ", " + ПараметрыРасчета.ПараметрВидКотировки;
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСтавка Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка") Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧГ=0" + ?(Цел(ПараметрыРасчета.ПараметрРасчетаСтавка) = ПараметрыРасчета.ПараметрРасчетаСтавка, "; ЧДЦ=0", "")) + "%";
		Иначе
			ПредставлениеРасчета = ПредставлениеРасчета + "%";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.КлючеваяСтавкаЦБРФ Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаДоля") И ПараметрыРасчета.ПараметрРасчетаДоля <> 100 Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаДоля, "ЧГ=0") + "% ";
		КонецЕсли;
		
		ИмяБазы = "Ключевая ставка ЦБ РФ";
		Если ПараметрыРасчета.Свойство("ПараметрСреднеарифметическое") И ПараметрыРасчета.ПараметрСреднеарифметическое Тогда
			ИмяБазы = "Ключевая ставка ЦБ РФ";
			Для НС = 1 По СтрДлина(ИмяБазы) Цикл 
				ПредставлениеРасчета = ПредставлениеРасчета + Сред(ИмяБазы, НС, 1) + Символ(773);
			КонецЦикла;
		Иначе
			ПредставлениеРасчета = ПредставлениеРасчета + ИмяБазы;
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.КБДМосковскойБиржи Тогда
		
		ПредставлениеРасчета = ПредставлениеРасчета + "MOEX GCURVE";
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСрок") Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + " " + Формат(ПараметрыРасчета.ПараметрРасчетаСрок, "ЧРД=.; ЧН=; ЧГ=0") + "Y";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИндексПотребительскихЦен Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаДоля") И ПараметрыРасчета.ПараметрРасчетаДоля <> 100 Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаДоля, "ЧГ=0") + "% ";
		КонецЕсли;
		
		ПредставлениеРасчета = ПредставлениеРасчета + "ИПЦ";
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ИзменениеВВП Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаДоля") И ПараметрыРасчета.ПараметрРасчетаДоля <> 100 Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаДоля, "ЧГ=0") + "% ";
		КонецЕсли;
		
		ПредставлениеРасчета = ПредставлениеРасчета + "ВВП";
		
	#КонецОбласти
	
	#Область Базы_для_расчета_резервов_ПИФ
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтОднойДвенадцатойПоследнейСЧА Тогда
		
		ПредставлениеРасчета = СтрШаблон("1/12 от %1%% последней СЧА", ПараметрыРасчета.ПараметрРасчетаСтавка)
			+ ?(ПараметрыРасчета.ПараметрРасчетаНижняяГраницаСуммы > 0, СтрШаблон(", минимум %1 руб", ПараметрыРасчета.ПараметрРасчетаНижняяГраницаСуммы),"");
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА Тогда
		
		ПредставлениеРасчета = СтрШаблон("%1%% от среднегодовой СЧА", ПараметрыРасчета.ПараметрРасчетаСтавка);
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда
		
		ПредставлениеРасчета = СтрШаблон("%1 руб в год%2", ПараметрыРасчета.ПараметрРасчетаСумма, ?(ПараметрыРасчета.ПараметрРасчетаПоКалендарнымДням, " по календарным дням", ""));
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
		
		ПредставлениеРасчета = СтрШаблон("%1 руб в месяц", ПараметрыРасчета.ПараметрРасчетаСумма);
	
	#КонецОбласти
	
	#Область Базы_для_расчета_набдавок_и_скидок_ПИФ
	
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПроцентомОтРасчетнойСтоимостиПая Тогда
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаСтавка") Тогда
			ПредставлениеРасчета = ПредставлениеРасчета + Формат(ПараметрыРасчета.ПараметрРасчетаСтавка, "ЧГ=0" + ?(Цел(ПараметрыРасчета.ПараметрРасчетаСтавка) = ПараметрыРасчета.ПараметрРасчетаСтавка, "; ЧДЦ=0", "")) + "% от расчетной стоимости пая";
		Иначе
			ПредставлениеРасчета = ПредставлениеРасчета + "%";
		КонецЕсли;
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПроцентомОтРасчетнойСтоимостиПаяВЗависимостиОтСрокаВладенияПаями Тогда	
		
		Если ПараметрыРасчета.Свойство("ПараметрРасчетаШкалаПроцентовВЗависимостиОтСрокаВладенияПаями") Тогда
			
			// Составим из строк шкалы, пропуская нулевые ставки
			Шкала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыРасчета.ПараметрРасчетаШкалаПроцентовВЗависимостиОтСрокаВладенияПаями, "Шкала").Выгрузить();
			Для Каждого СтрокаШкалы Из Шкала Цикл	
				Если СтрокаШкалы.ПроцентнаяСтавка = 0 Тогда 
					Продолжить;
				КонецЕсли;
				ПредставлениеРасчета = ПредставлениеРасчета + Формат(СтрокаШкалы.ПроцентнаяСтавка, "ЧРД=,; ЧН=0") + "% (" + Формат(СтрокаШкалы.МинимальноеЗначение, "ЧДЦ=0; ЧН=0") + "-" + Формат(СтрокаШкалы.МаксимальноеЗначение, "ЧДЦ=0; ЧН=0") + " дн.); ";
			КонецЦикла;	
			
			ПредставлениеРасчета = СокрЛП(ПредставлениеРасчета);
			
		Иначе
			ПредставлениеРасчета = ПредставлениеРасчета + "%";
		КонецЕсли;

	#КонецОбласти
	
	Иначе
		
		ПредставлениеРасчета = Строка(БазаРасчета);	
		
	КонецЕсли;
	
	// Добавляем значение периодичности
	
	Если ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежемесячно Тогда
		ПредставлениеРасчета = ПредставлениеРасчета + " (мес.)";
	ИначеЕсли ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежеквартально Тогда
		ПредставлениеРасчета = ПредставлениеРасчета + " (кв.)";
	ИначеЕсли ПериодичностьРасчета = Перечисления.ПериодичностьРасчетаВознагражденияУправляющего.Ежегодно Тогда
		ПредставлениеРасчета = ПредставлениеРасчета + " (г.)";
	КонецЕсли;
	
	// Долой неразрывный пробел
	
	ПредставлениеРасчета = СтрЗаменить(ПредставлениеРасчета, " ", " ");
	
	Возврат ПредставлениеРасчета;
	
КонецФункции

Процедура ДобавитьИсточникДанных(Запрос, ИмяИсточника) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	
	КонецЕсли;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяИсточника) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если ИмяИсточника = "_ВознаграждениеУплаченноеСНачалаГодаРазвернуто"
		ИЛИ ИмяИсточника = "_ВознаграждениеУплаченноеСНачалаДоговораРазвернуто"
	Тогда
		
		#Область ВознаграждениеУплаченноеСНачалаГодаРазвернуто_ВознаграждениеУплаченноеСНачалаДоговораРазвернуто
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ЖурналОплат.Период, ДЕНЬ) КАК ДатаОплаты,
			|	НАЧАЛОПЕРИОДА(НачислениеЗадолженности.Дата, ДЕНЬ) КАК ДатаНачисления,
			|	СУММА(ОснованияОплат.Сумма) КАК СуммаВВалютеУчета,
			|	СУММА(ОснованияОплат.Сумма / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _ВознаграждениеУплаченноеСНачалаГодаРазвернуто
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ЖурналОплат
			|		ПО (ЖурналОплат.Организация = _Клиенты.Организация)
			|			И (ЖурналОплат.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (ЖурналОплат.Период МЕЖДУ &НачалоПериодаОплатыВознаграждения И _Клиенты.КонецРасчетногоПериода)
			|			И (ЖурналОплат.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего))
			|			И (ЖурналОплат.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата))
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОснованияОплат
			|		ПО (ОснованияОплат.Ссылка = ЖурналОплат.Регистратор)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
			|		ПО (НачислениеЗадолженности.Ссылка = ОснованияОплат.Основание)
			|			И (НачислениеЗадолженности.Дата МЕЖДУ &НачалоПериодаОплатыВознаграждения И _Клиенты.КонецРасчетногоПериода)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(НачислениеЗадолженности.Дата, ДЕНЬ))
			|ГДЕ
			|	&ФильтрКлиентов
			|
			|СГРУППИРОВАТЬ ПО
			|	_Клиенты.СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ЖурналОплат.Период, ДЕНЬ),
			|	НАЧАЛОПЕРИОДА(НачислениеЗадолженности.Дата, ДЕНЬ)";		
		
		Если ИмяИсточника = "_ВознаграждениеУплаченноеСНачалаДоговораРазвернуто" Тогда
			
			// Вознаграждение, уплаченное с начала действия договора, сейчас требуется
			// только для проверки ограничения размера общего вознаграждения,
			// поэтому для ускорения выполнения запроса оставим только тех, у кого оно установлено
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ВознаграждениеУплаченноеСНачалаГодаРазвернуто",		"_ВознаграждениеУплаченноеСНачалаДоговораРазвернуто");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериодаОплатыВознаграждения",					"ДАТАВРЕМЯ(1, 1, 1)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрКлиентов",										"_Клиенты.ОграничениеОбщегоРазмераВознаграждения > 0");
			
		Иначе
			
			// Вознаграждение, уплаченное в начале года, может не относиться к текущему году,
			// поэтому его следует дополнительно фильтровать по дате начисления
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериодаОплатыВознаграждения",					"НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ГОД)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФильтрКлиентов",										"ИСТИНА");
			
		КонецЕсли;
		
