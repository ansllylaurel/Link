
#Область Экспортные_процедуры_и_функции

Функция ПолучитьЗначенияБазРасчета(ПараметрыПолученияБазы, МенеджерВременныхТаблиц = Неопределено) Экспорт

	БазаРасчета = ПараметрыПолученияБазы.БазаРасчета;
	
	Если БазаРасчета = Справочники.БазыРасчета.СредняяОценочнаяСтоимостьИмуществаПринятогоВДоверительноеУправление Тогда
		
		#Область Средняя_оценочная_стоимость_имущества_принятого_в_доверительное_управление
		
		Запрос = Новый Запрос;
		
		РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(
			?(МенеджерВременныхТаблиц = Неопределено, Запрос, МенеджерВременныхТаблиц),
			ПараметрыПолученияБазы.ДатаРасчета,
			ПараметрыПолученияБазы.Организация,
			Неопределено,
			"_ДатыПолученияДокументовОСмерти"
		);
		
		Запрос.УстановитьПараметр("Организация", 					ПараметрыПолученияБазы.Организация);
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", 	ПараметрыПолученияБазы.СчетаДоверительногоУправления);
		Запрос.УстановитьПараметр("НачалоБазовогоПериода", 			ПараметрыПолученияБазы.НачалоБазовогоПериода);
		Запрос.УстановитьПараметр("КонецБазовогоПериода", 			ПараметрыПолученияБазы.КонецБазовогоПериода);
		Запрос.УстановитьПараметр("ДатаРасчета",                    КонецДня(ПараметрыПолученияБазы.ДатаРасчета));
		Запрос.УстановитьПараметр("РассчитыватьЗаБазовыйПериод", 	ПараметрыПолученияБазы.РассчитыватьЗаБазовыйПериод);
		
		// Базу по расторгнутым в периоде договорам нужно рассчитывать по дату расторжения вкл. оную (см. задачу № 207213)
		// Вознаграждение по умершим клиентам считается до начала периода, в котором зафиксирована анкета с датой смерти.
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДУ.Ссылка КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА СчетаДУ.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ СчетаДУ.ДатаРасторжения >= &ДатаРасчета
			|			ТОГДА &ДатаРасчета
			|		ИНАЧЕ КОНЕЦПЕРИОДА(СчетаДУ.ДатаРасторжения, ДЕНЬ)
			|	КОНЕЦ КАК ДатаРасчета
			|ПОМЕСТИТЬ _СчетаДУ
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|				&ДатаРасчета,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО СчетаДУ.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПолученияДокументовОСмерти КАК _ДатыПолученияДокументовОСмерти
			|		ПО (_ДатыПолученияДокументовОСмерти.ФизЛицо = КлиентыДоверительногоУправленияСрезПоследних.Клиент)
			|ГДЕ
			|	СчетаДУ.Ссылка В(&СчетаДоверительногоУправления)
			|	И _ДатыПолученияДокументовОСмерти.ФизЛицо ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчетаОбороты.Период, ДЕНЬ) КАК Период,
			|	РАЗНОСТЬДАТ(КОНЕЦПЕРИОДА(ВводыВыводыАктивовВВалютеУчетаОбороты.Период, ДЕНЬ), _СчетаДУ.ДатаРасчета, ДЕНЬ) + 1 КАК ДнейВУправлении,
			|	РАЗНОСТЬДАТ(&НачалоБазовогоПериода, &КонецБазовогоПериода, ДЕНЬ) + 1 КАК ДнейВПериоде,
			|	СУММА((ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот - ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход, 0)) * (РАЗНОСТЬДАТ(КОНЕЦПЕРИОДА(ВводыВыводыАктивовВВалютеУчетаОбороты.Период, ДЕНЬ), _СчетаДУ.ДатаРасчета, ДЕНЬ) + 1)) / (РАЗНОСТЬДАТ(&НачалоБазовогоПериода, &КонецБазовогоПериода, ДЕНЬ) + 1) КАК СредняяОценочнаяСтоимость,
			|	СУММА(ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот) КАК БалансоваяСтоимость,
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ _ВводыАктивовЗаРасчетныйПериод
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
			|			&НачалоБазовогоПериода,
			|			&ДатаРасчета,
			|			Регистратор,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДУ.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДУ КАК _СчетаДУ
			|					ГДЕ
			|						_СчетаДУ.ДатаРасчета >= &НачалоБазовогоПериода)
			|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|				И ВидОперацииВводаВыводаДС = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ КАК _СчетаДУ
			|		ПО ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления = _СчетаДУ.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|				&НачалоБазовогоПериода,
			|				&ДатаРасчета,
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В
			|						(ВЫБРАТЬ
			|							_СчетаДУ.СчетДоверительногоУправления
			|						ИЗ
			|							_СчетаДУ КАК _СчетаДУ
			|						ГДЕ
			|							_СчетаДУ.ДатаРасчета >= &НачалоБазовогоПериода)
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение)) КАК ЗадолженностиПоДенежнымСредствамОбороты
			|		ПО ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления
			|			И ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор = ЗадолженностиПоДенежнымСредствамОбороты.Основание
			|
			|СГРУППИРОВАТЬ ПО
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления,
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор,
			|	НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчетаОбороты.Период, ДЕНЬ),
			|	РАЗНОСТЬДАТ(КОНЕЦПЕРИОДА(ВводыВыводыАктивовВВалютеУчетаОбороты.Период, ДЕНЬ), _СчетаДУ.ДатаРасчета, ДЕНЬ) + 1
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Период,
			|	СУММА(ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот) КАК БалансоваяСтоимость
			|ПОМЕСТИТЬ _ВводыАктивовЗаПредрасчетныйПериод_Расшифровка
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
			|			,
			|			КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоБазовогоПериода, ДЕНЬ, -1), ДЕНЬ),
			|			Регистратор,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДУ.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДУ КАК _СчетаДУ
			|					ГДЕ
			|						_СчетаДУ.ДатаРасчета > &НачалоБазовогоПериода)
			|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|				И ВидОперацииВводаВыводаДС = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления,
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	РАЗНОСТЬДАТ(&НачалоБазовогоПериода, _СчетаДУ.ДатаРасчета, ДЕНЬ) + 1 КАК ДнейВУправлении,
			|	РАЗНОСТЬДАТ(&НачалоБазовогоПериода, &КонецБазовогоПериода, ДЕНЬ) + 1 КАК ДнейВПериоде,
			|	СУММА((ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот - ЕСТЬNULL(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход, 0)) * (РАЗНОСТЬДАТ(&НачалоБазовогоПериода, _СчетаДУ.ДатаРасчета, ДЕНЬ) + 1)) / (РАЗНОСТЬДАТ(&НачалоБазовогоПериода, &КонецБазовогоПериода, ДЕНЬ) + 1) КАК СредняяОценочнаяСтоимость,
			|	СУММА(ВводыВыводыАктивовВВалютеУчетаОбороты.БалансоваяСтоимостьОборот) КАК БалансоваяСтоимость
			|ПОМЕСТИТЬ _ВводыАктивовЗаПредрасчетныйПериод
			|ИЗ
			|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
			|			,
			|			КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоБазовогоПериода, ДЕНЬ, -1), ДЕНЬ),
			|			Регистратор,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДУ.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДУ КАК _СчетаДУ
			|					ГДЕ
			|						_СчетаДУ.ДатаРасчета > &НачалоБазовогоПериода)
			|				И НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|				И ВидОперацииВводаВыводаДС = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)) КАК ВводыВыводыАктивовВВалютеУчетаОбороты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ КАК _СчетаДУ
			|		ПО ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления = _СчетаДУ.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
			|				,
			|				КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&НачалоБазовогоПериода, ДЕНЬ, -1), ДЕНЬ),
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В
			|						(ВЫБРАТЬ
			|							_СчетаДУ.СчетДоверительногоУправления
			|						ИЗ
			|							_СчетаДУ КАК _СчетаДУ
			|						ГДЕ
			|							_СчетаДУ.ДатаРасчета > &НачалоБазовогоПериода)
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющегоПлатаЗаРазмещение)) КАК ЗадолженностиПоДенежнымСредствамОбороты
			|		ПО ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления
			|			И ВводыВыводыАктивовВВалютеУчетаОбороты.Регистратор = ЗадолженностиПоДенежнымСредствамОбороты.Основание
			|
			|СГРУППИРОВАТЬ ПО
			|	ВводыВыводыАктивовВВалютеУчетаОбороты.СчетДоверительногоУправления,
			|	_СчетаДУ.ДатаРасчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВводыАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫБОР
			|		КОГДА НЕ &РассчитыватьЗаБазовыйПериод
			|			ТОГДА СУММА(_ВводыАктивов.СредняяОценочнаяСтоимость)
			|		КОГДА &КонецБазовогоПериода = &ДатаРасчета
			|			ТОГДА СУММА(_ВводыАктивов.СредняяОценочнаяСтоимость)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СредняяОценочнаяСтоимость,
			|	ВЫБОР
			|		КОГДА НЕ &РассчитыватьЗаБазовыйПериод
			|			ТОГДА СУММА(_ВводыАктивов.БалансоваяСтоимость)
			|		КОГДА &КонецБазовогоПериода = &ДатаРасчета
			|			ТОГДА СУММА(_ВводыАктивов.БалансоваяСтоимость)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК БалансоваяСтоимость
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ВводыАктивовЗаРасчетныйПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_ВводыАктивовЗаРасчетныйПериод.СредняяОценочнаяСтоимость КАК СредняяОценочнаяСтоимость,
			|		_ВводыАктивовЗаРасчетныйПериод.БалансоваяСтоимость КАК БалансоваяСтоимость
			|	ИЗ
			|		_ВводыАктивовЗаРасчетныйПериод КАК _ВводыАктивовЗаРасчетныйПериод
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_ВводыАктивовЗаПредрасчетныйПериод.СчетДоверительногоУправления,
			|		_ВводыАктивовЗаПредрасчетныйПериод.СредняяОценочнаяСтоимость,
			|		_ВводыАктивовЗаПредрасчетныйПериод.БалансоваяСтоимость
			|	ИЗ
			|		_ВводыАктивовЗаПредрасчетныйПериод КАК _ВводыАктивовЗаПредрасчетныйПериод) КАК _ВводыАктивов
			|
			|СГРУППИРОВАТЬ ПО
			|	_ВводыАктивов.СчетДоверительногоУправления";
		
		Если МенеджерВременныхТаблиц = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "
				|; 
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ _БазыРасчета КАК БазыРасчета";
			Возврат Запрос.Выполнить().Выгрузить();
		Иначе
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Выполнить();
		КонецЕсли; 
		
		#КонецОбласти	
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.СтоимостьПереданныхВДоверительноеУправлениеДенежныхСредств Тогда	
		
		#Область Стоимость_переданных_в_доверительное_управление_денежных_средств
		
		Запрос = Новый Запрос;
