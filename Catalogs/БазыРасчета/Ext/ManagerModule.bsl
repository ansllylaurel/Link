			|	ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета КАК ДнейДоРасчета,
			|	ВыводыАктивовСНачалаГодаРазвернуто.ДнейОтНачалаПериодаРасчета КАК ДнейОтНачалаПериодаРасчета,
			|	ВыводыАктивовСНачалаГодаРазвернуто.Валюта КАК Валюта,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаБаланс КАК СуммаБаланс,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаРынок КАК СуммаРынок,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаБаланс КАК СуммаВВалютеУчетаБаланс,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаРынок КАК СуммаВВалютеУчетаРынок,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаБаланс * КурсВалютыВвода.Курс / КурсВалютыВвода.Кратность / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность КАК СуммаВВалютеРасчетаБаланс,
			|	ВыводыАктивовСНачалаГодаРазвернуто.СуммаРынок * КурсВалютыВвода.Курс / КурсВалютыВвода.Кратность / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность КАК СуммаВВалютеРасчетаРынок,
			|	ВыводыАктивовСНачалаГодаРазвернуто.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|	ВыводыАктивовСНачалаГодаРазвернуто.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|	ВыводыАктивовСНачалаГодаРазвернуто.НазначениеПлатежа КАК НазначениеПлатежа
			|ПОМЕСТИТЬ _ВыводыАктивовСНачалаГодаРазвернуто
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВыводыАктивовСНачалаГода.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		НАЧАЛОПЕРИОДА(ВыводыАктивовСНачалаГода.Период, ДЕНЬ) КАК Период,
			|		РАЗНОСТЬДАТ(ВыводыАктивовСНачалаГода.Период, _Клиенты.КонецРасчетногоПериода, ДЕНЬ) + ВЫБОР
			|			КОГДА &ИсключатьДеньПриемаПередачиАктивовИзУправления
			|				ТОГДА 0
			|			ИНАЧЕ 1
			|		КОНЕЦ КАК ДнейДоРасчета,
			|		РАЗНОСТЬДАТ(_Клиенты.НачалоРасчетногоПериода, ВыводыАктивовСНачалаГода.Период, ДЕНЬ) КАК ДнейОтНачалаПериодаРасчета,
			|		ВыводыАктивовСНачалаГода.БалансоваяСтоимость КАК СуммаВВалютеУчетаБаланс,
			|		ВыводыАктивовСНачалаГода.РыночнаяСтоимость КАК СуммаВВалютеУчетаРынок,
			|		ВЫБОР
			|			КОГДА ВыводДенежныхСредств.Сумма ЕСТЬ NULL
			|				ТОГДА ВыводыАктивовСНачалаГода.БалансоваяСтоимость
			|			ИНАЧЕ ВыводДенежныхСредств.Сумма
			|		КОНЕЦ КАК СуммаБаланс,
			|		ВЫБОР
			|			КОГДА ВыводДенежныхСредств.Сумма ЕСТЬ NULL
			|				ТОГДА ВыводыАктивовСНачалаГода.РыночнаяСтоимость
			|			ИНАЧЕ ВыводДенежныхСредств.Сумма
			|		КОНЕЦ КАК СуммаРынок,
			|		ВЫБОР
			|			КОГДА ВыводДенежныхСредств.Сумма ЕСТЬ NULL
			|				ТОГДА _Клиенты.ВалютаУчета
			|			КОГДА ВыводДенежныхСредств.ФормаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыДенежныхСредств.Безналичная)
			|				ТОГДА ВыводДенежныхСредств.РасчетныйСчет.Валюта
			|			КОГДА ВыводДенежныхСредств.ФормаДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ФормыДенежныхСредств.Наличная)
			|				ТОГДА ВыводДенежныхСредств.Касса.ВалютаДенежныхСредств
			|		КОНЕЦ КАК Валюта,
			|		_Клиенты.ВалютаРасчета КАК ВалютаРасчета,
			|		ВыводДенежныхСредств.СтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|		ВыводДенежныхСредств.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|		ВыводДенежныхСредств.СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа
			|	ИЗ
			|		РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВыводыАктивовСНачалаГода
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
			|			ПО ВыводыАктивовСНачалаГода.Организация = _Клиенты.Организация
			|				И ВыводыАктивовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления
			|				И (ВыводыАктивовСНачалаГода.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход))
			|				И (ВыводыАктивовСНачалаГода.Период МЕЖДУ НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ГОД) И _Клиенты.КонецРасчетногоПериода)
			|				И (ВыводыАктивовСНачалаГода.ВидОперацииВводаВыводаДС В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка)))
			|				И (ВыводыАктивовСНачалаГода.Активность)
			|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
			|			ПО ВыводыАктивовСНачалаГода.Регистратор = ВыводДенежныхСредств.Ссылка
			|				И (ВыводыАктивовСНачалаГода.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства))) КАК ВыводыАктивовСНачалаГодаРазвернуто
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыВвода
			|		ПО (КурсВалютыВвода.Валюта = ВыводыАктивовСНачалаГодаРазвернуто.Валюта)
			|			И (КурсВалютыВвода.Период = ВыводыАктивовСНачалаГодаРазвернуто.Период)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = ВыводыАктивовСНачалаГодаРазвернуто.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = ВыводыАктивовСНачалаГодаРазвернуто.Период)";
		
		// Исключаем день приема-передачи активов из управления при необходимости
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы["_Клиенты"].Колонки.Найти("ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления") = Неопределено Тогда
			ИсключатьДеньПриемаПередачиАктивовИзУправления = "ЛОЖЬ";		
		Иначе
			ИсключатьДеньПриемаПередачиАктивовИзУправления = "_Клиенты.ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления";		
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсключатьДеньПриемаПередачиАктивовИзУправления", ИсключатьДеньПриемаПередачиАктивовИзУправления);
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_ВыводыАктивовСНачалаГода" Тогда 
		
		#Область _ВыводыАктивовСНачалаГода		
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВыводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаБаланс) КАК СуммаВВалютеУчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаРынок) КАК СуммаВВалютеУчетаРынок,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаБаланс * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета) КАК ПроизведениеСуммИДнейДоРасчетаВВалютеУчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаРынок * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета) КАК ПроизведениеСуммИДнейДоРасчетаВВалютеУчетаРынок,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаБаланс * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейОтНачалаПериодаРасчета) КАК ПроизведениеСуммИДнейОтНачалаПериодаРасчетаВВалютеУчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеУчетаРынок * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейОтНачалаПериодаРасчета) КАК ПроизведениеСуммИДнейОтНачалаПериодаРасчетаВВалютеУчетаРынок,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаБаланс) КАК СуммаВВалютеРасчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок) КАК СуммаВВалютеРасчетаРынок,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаБаланс * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета) КАК ПроизведениеСуммИДнейДоРасчетаВВалютеРасчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейДоРасчета) КАК ПроизведениеСуммИДнейДоРасчетаВВалютеРасчетаРынок,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаБаланс * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейОтНачалаПериодаРасчета) КАК ПроизведениеСуммИДнейОтНачалаПериодаРасчетаВВалютеРасчетаБаланс,
			|	СУММА(_ВыводыАктивовСНачалаГодаРазвернуто.СуммаВВалютеРасчетаРынок * _ВыводыАктивовСНачалаГодаРазвернуто.ДнейОтНачалаПериодаРасчета) КАК ПроизведениеСуммИДнейОтНачалаПериодаРасчетаВВалютеРасчетаРынок
			|ПОМЕСТИТЬ _ВыводыАктивовСНачалаГода
			|ИЗ
			|	_ВыводыАктивовСНачалаГодаРазвернуто КАК _ВыводыАктивовСНачалаГодаРазвернуто
			|
			|СГРУППИРОВАТЬ ПО
			|	_ВыводыАктивовСНачалаГодаРазвернуто.СчетДоверительногоУправления";
		
		ДобавитьИсточникДанных(Запрос, "_ВыводыАктивовСНачалаГодаРазвернуто");
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_ИнвестиционныйДоход"
		ИЛИ ИмяИсточника = "_ИнвестиционныйДоходБаланс"
	Тогда 
		
		#Область _ИнвестиционныйДоход
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ВознаграждениеУплаченноеСНачалаГода.СуммаВВалютеРасчета КАК ВознаграждениеУплаченноеСНачалаГодаВВалютеРасчета,
			|	_НДФЛУплаченныйСНачалаГода.СуммаВВалютеРасчета КАК НДФЛУплаченныйСНачалаГодаВВалютеРасчета,
			|	_СЧАНаКонец.СуммаВВалютеРасчета КАК СЧАНаКонецВВалютеРасчета,
			|	ВЫБОР
			|		КОГДА _Клиенты.ДоговорЗаключенДоТекущегоГода
			|			ТОГДА _СЧАНаНачалоГода.СуммаВВалютеРасчета
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СЧАНаНачалоГодаВВалютеРасчета,
			|	_ВводыАктивовСНачалаГода.СуммаВВалютеРасчета КАК ВводыАктивовСНачалаГодаВВалютеРасчета,
			|	_ВыводыАктивовСНачалаГода.СуммаВВалютеРасчетаРынок КАК ВыводыАктивовСНачалаГодаВВалютеРасчета,
			|	ВЫБОР
			|		КОГДА _Клиенты.ДоговорЗаключенДоТекущегоГода
			|				И _СЧАНаНачалоГода.СуммаВВалютеРасчета ЕСТЬ NULL
			|			ТОГДА NULL
			|		ИНАЧЕ 0
			|	КОНЕЦ + _СЧАНаКонец.СуммаВВалютеРасчета - ЕСТЬNULL(_ВводыАктивовСНачалаГода.СуммаВВалютеРасчета, 0) + ЕСТЬNULL(_ВыводыАктивовСНачалаГода.СуммаВВалютеРасчетаРынок, 0) + ЕСТЬNULL(_ВознаграждениеУплаченноеСНачалаГода.СуммаВВалютеРасчета, 0) + ЕСТЬNULL(_НДФЛУплаченныйСНачалаГода.СуммаВВалютеРасчета, 0) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _ИнвестиционныйДоход
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧАНаКонец КАК _СЧАНаКонец
			|		ПО (_СЧАНаКонец.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧАНаНачалоГода КАК _СЧАНаНачалоГода
			|		ПО (_СЧАНаНачалоГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыАктивовСНачалаГода КАК _ВводыАктивовСНачалаГода
			|		ПО (_ВводыАктивовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВыводыАктивовСНачалаГода КАК _ВыводыАктивовСНачалаГода
			|		ПО (_ВыводыАктивовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВознаграждениеУплаченноеСНачалаГода КАК _ВознаграждениеУплаченноеСНачалаГода
			|		ПО (_ВознаграждениеУплаченноеСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НДФЛУплаченныйСНачалаГода КАК _НДФЛУплаченныйСНачалаГода
			|		ПО (_НДФЛУплаченныйСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)";

		ДобавитьИсточникДанных(Запрос, "_ВыводыАктивовСНачалаГода");
		ДобавитьИсточникДанных(Запрос, "_ВознаграждениеУплаченноеСНачалаГода");
		ДобавитьИсточникДанных(Запрос, "_НДФЛУплаченныйСНачалаГода");
		
		Если ИмяИсточника = "_ИнвестиционныйДоход" Тогда
			ДобавитьИсточникДанных(Запрос, "_СЧАНаКонец");
			ДобавитьИсточникДанных(Запрос, "_СЧАНаНачалоГода");
			ДобавитьИсточникДанных(Запрос, "_ВводыАктивовСНачалаГода");
		Иначе
			ДобавитьИсточникДанных(Запрос, "_СЧАНаКонецБаланс");
			ДобавитьИсточникДанных(Запрос, "_СЧАНаНачалоГодаБаланс");
