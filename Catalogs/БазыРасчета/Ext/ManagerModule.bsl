		РезультатВторойСоставляющей = РассчитатьСоставляющуюНастройкиРасчетаВознаграждения(ПараметрыРасчета.ДанныеДляРасчета[0].ПараметрРасчетаЗначение2, ПараметрыРасчета, Запрос, РасшифровкаРасчета);
				
		СуммаВознаграждения = ?(БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение, 
					Мин(РезультатПервойСоставляющей.СуммаВознаграждения, РезультатВторойСоставляющей.СуммаВознаграждения), 
					Макс(РезультатПервойСоставляющей.СуммаВознаграждения, РезультатВторойСоставляющей.СуммаВознаграждения));
					
				
		Результат = ?(СуммаВознаграждения = РезультатПервойСоставляющей.СуммаВознаграждения,
					РезультатПервойСоставляющей.РезультатРасчета,
					РезультатВторойСоставляющей.РезультатРасчета);  
					
		// Из второй таблицы могут потребоваться дополнительные данные для заполнения расшифровки
		// Поскольку min/max предполагает ограничение, в первой составляющей ограничиваемая сумма, во второй - ограничивающая
					
		ЭтоОграничение = Результат = РезультатВторойСоставляющей.РезультатРасчета; 
		
		Запрос.УстановитьПараметр("ЭтоОграничение", ЭтоОграничение);
		
		ДополнительныйРезультат = ?(ЭтоОграничение, РезультатПервойСоставляющей.РезультатРасчета, РезультатВторойСоставляющей.РезультатРасчета);
		Для Каждого Колонка Из ДополнительныйРезультат.Колонки Цикл
						
			Если Не ЗначениеЗаполнено(ДополнительныйРезультат.Колонки[Колонка.Имя].ТипЗначения) Тогда
				Продолжить;
			КонецЕсли;
			
			ДополнительныеДанные.Добавить(СтрШаблон("&%1 КАК %1", Колонка.Имя + "_Доп"));
			Запрос.УстановитьПараметр(Колонка.Имя + "_Доп", ДополнительныйРезультат[0][Колонка.Имя]);			
			
		КонецЦикла;		
		
		// Для колонок результата с неопределенным типом устанавливаем числовой тип
		МассивКолонокБезТипа = Новый Массив;
		МассивКолонок		 = Новый Массив;
		Для Каждого Колонка Из Результат.Колонки Цикл
			
			Если Колонка.Имя = "БазаРасчета" Или Колонка.Имя = "Представление" Тогда
				Продолжить;
			КонецЕсли;
			
			МассивКолонок.Добавить(Колонка.Имя);
			
			Если Не ЗначениеЗаполнено(Результат.Колонки[Колонка.Имя].ТипЗначения) Тогда
				МассивКолонокБезТипа.Добавить(Колонка.Имя);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Колонка Из МассивКолонокБезТипа Цикл
			Результат.Колонки.Удалить(Колонка);
			Результат.Колонки.Добавить(Колонка, Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0)));
		КонецЦикла;		
		
		Результат.Колонки.Удалить("СуммаВознаграждения");
		МассивКолонок.Удалить(МассивКолонок.Найти("СуммаВознаграждения"));
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Результат, "_РезультатРасчета", Запрос,, МассивКолонок);
				
		Запрос.УстановитьПараметр("СуммаВознаграждения",		СуммаВознаграждения);
		Запрос.УстановитьПараметр("РезультатСоставляющей",		Результат);
		Запрос.УстановитьПараметр("СуммаПервойСоставляющей",	РезультатПервойСоставляющей.СуммаВознаграждения);
		Запрос.УстановитьПараметр("СуммаВторойСоставляющей",	РезультатВторойСоставляющей.СуммаВознаграждения);
		
        Запрос.УстановитьПараметр("БазаРасчета",				
				?(СуммаВознаграждения = РезультатПервойСоставляющей.СуммаВознаграждения, 
					РезультатПервойСоставляющей.БазаРасчета,
					РезультатВторойСоставляющей.БазаРасчета));
		Запрос.УстановитьПараметр("НастройкаРасчета",			
				?(СуммаВознаграждения = РезультатПервойСоставляющей.СуммаВознаграждения, 
					ПараметрыРасчета.ДанныеДляРасчета[0].ПараметрРасчетаЗначение1,
					ПараметрыРасчета.ДанныеДляРасчета[0].ПараметрРасчетаЗначение2)); 
				
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ	
			|*
			|ПОМЕСТИТЬ _БазыРасчета
		    |ИЗ 
			|	&РезультатСоставляющей КАК РезультатСоставляющей
			|;
			|
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ			 
			|	&НастройкаРасчета КАК НастройкаРасчета,
			|	&БазаРасчета КАК БазаРасчета,
			|	&Представление КАК Представление,
			|	&СуммаПервойСоставляющей КАК СуммаПервойСоставляющей,
			|	&СуммаВторойСоставляющей КАК СуммаВторойСоставляющей,
			|	&СуммаВознаграждения КАК СуммаВознаграждения,
			|	&ЭтоОграничение КАК ЭтоРасчетОграниченияДляМинимальногоМаксимальногоЗначения,
			|	&ДополнительныеДанные КАК ДополнительныеДанные,
			|*
			|ИЗ 
			|	_БазыРасчета КАК _БазыРасчета";
		
		
		ТекстЗапроса = СтрЗаменить(
						ТекстЗапроса,
						"&ДополнительныеДанные КАК ДополнительныеДанные,",
						?(ДополнительныеДанные.Количество() = 0,
							"",
							СтрСоединить(ДополнительныеДанные, ",") + ","));
		
		КлючевыеПоляРасчета			= Новый Структура("ПерваяСумма, ВтораяСумма", "не рассчитана первая сумма", "не рассчитана вторая сумма");		
		ТаблицыРасшифровкиРасчета	= ?(СуммаВознаграждения = РезультатПервойСоставляющей.СуммаВознаграждения, 
				РезультатПервойСоставляющей.ТаблицыРасшифровкиРасчета, 
				РезультатВторойСоставляющей.ТаблицыРасшифровкиРасчета); 
		#КонецОбласти
		
	Иначе
		
		#Область Нереализованный_расчет_по_базе		
		
		ОшибкиРасчета = "расчет не реализован";
		
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеДляРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДанныеДляРасчета.Представление КАК Представление
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	&ДанныеДляРасчета КАК ДанныеДляРасчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	NULL КАК СуммаВознаграждения,
			|	ИСТИНА КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";
		
		ТаблицыРасшифровкиРасчета = Новый Структура;
		
		#КонецОбласти
		
	КонецЕсли; 

	// Собираем запрос	
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "КАК ЧИСЛО(1, 1)", СтрШаблон("КАК ЧИСЛО(%1, %2)",
		Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.Разрядность,
		Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти));			
		
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	// Получаем результат расчета
	
	РезультатРасчета = Новый Структура;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		Для Каждого Таблица Из ТаблицыРасшифровкиРасчета Цикл
			
			// Если данные готовы, пропускаем
			Если ЗначениеЗаполнено(Таблица.Значение) Или Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(Таблица.Ключ) = Неопределено Тогда				
				Продолжить;
			КонецЕсли;			
			
			ТаблицаРасшифровкиРасчета = Запрос.МенеджерВременныхТаблиц.Таблицы[Таблица.Ключ].ПолучитьДанные().Выгрузить();
			
			// Отдельные таблицы нужно сортировать
			Если Таблица.Ключ = "_СЧАЗаБазовыйПериодДляСреднейСЧА" Тогда
				ТаблицаРасшифровкиРасчета.Сортировать("СчетДоверительногоУправления, Дата");
			КонецЕсли;
			
			ТаблицаРасшифровкиРасчета.Индексы.Добавить("СчетДоверительногоУправления");
		
			ТаблицыРасшифровкиРасчета[Таблица.Ключ] = ТаблицаРасшифровкиРасчета;
		КонецЦикла;
		
		РезультатРасчета.Вставить("ТаблицыРасшифровкиРасчета", ТаблицыРасшифровкиРасчета)

	КонецЕсли;
	
	РезультатРасчета.Вставить("КлючевыеПоляРасчета",	КлючевыеПоляРасчета);	
	РезультатРасчета.Вставить("Результат",				РезультатЗапроса);
	
	Если ЗначениеЗаполнено(ОшибкиРасчета) Тогда	
		РезультатРасчета.Вставить("ОшибкиРасчета",		ОшибкиРасчета);
	КонецЕсли;
	
	// Удаляем добавленные временные таблицы
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, , ИсходныеВременныеТаблицы);
	КонецЕсли;
	
	Возврат РезультатРасчета;
	
КонецФункции

Функция ПолучитьПараметрыРасчета(БазаРасчета, ДанныеДляЗаполнения = Неопределено, Представление = Неопределено) Экспорт
	
	ПараметрыРасчета		= Новый Структура;
	РеквизитыБазыРасчета	= ПолучитьРеквизитыБазРасчета(БазаРасчета);
	
	Для Каждого Реквизит Из РеквизитыБазыРасчета Цикл
		ПараметрыРасчета.Вставить(Реквизит.Имя, Реквизит.ТипЗначения.ПривестиЗначение()); 
	КонецЦикла;
	
	Если ДанныеДляЗаполнения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, ДанныеДляЗаполнения);
		
		Если Представление <> Неопределено Тогда
			Представление = ПолучитьПредставлениеРасчета(БазаРасчета, ПараметрыРасчета);	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыРасчета;
	
КонецФункции
		
Функция РассчитатьРезервПИФПоБазеРасчета(ПараметрыРасчета, МенеджерВременныхТаблиц = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт
	
	Если ПараметрыРасчета = Неопределено Тогда
		ПараметрыРасчета = Новый Структура;
	КонецЕсли;
		
	ОшибкиРасчета = Новый Массив;
	
	// Порядок расчета резервов важен! не менять!
	ПереченьРезервов = Новый Массив;
	ПереченьРезервов.Добавить("ЗаВознаграждениеУправляющего");
	ПереченьРезервов.Добавить("ЗаВознаграждениеДепозитария");
	ПереченьРезервов.Добавить("ЗаПрочиеВозмещаемыеРасходыУправляющего");
	
	Резервы = Новый Структура();
	
	ДатаНачалаРасчетовСКредиторами = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаНачалаРасчетовСКредиторами", ПараметрыРасчета.ПаевойИнвестиционныйФонд);
	Если ЗначениеЗаполнено(ДатаНачалаРасчетовСКредиторами) И (ПараметрыРасчета.Дата >= ДатаНачалаРасчетовСКредиторами) Тогда
		// с этой даты резервы не начисляем
		Возврат Новый Структура("СуммаЗаВознаграждениеУправляющего, СуммаЗаВознаграждениеДепозитария, СуммаЗаПрочиеВозмещаемыеРасходыУправляющего", 0, 0, 0);
	КонецЕсли;
	
	РеквизитыФонда = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(ПараметрыРасчета.ПаевойИнвестиционныйФонд, ПараметрыРасчета.Дата);
	Если РеквизитыФонда.УправляющаяКомпания.ЮрФизЛицо <> ПараметрыРасчета.Организация.ЮрФизЛицо Тогда
		// фонд не наш, резервы не начисляем
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1 принадлежит управляющей компании %2, резервы (лимиты) не могут быть рассчитаны", ПараметрыРасчета.ПаевойИнвестиционныйФонд, РеквизитыФонда.УправляющаяКомпания), ПараметрыРасчета.ПаевойИнвестиционныйФонд);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаОкончанияФормированияПИФ = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаОкончанияФормированияПИФ", ПараметрыРасчета.ПаевойИнвестиционныйФонд);
	
	// Проверяем эту дату
	Если Не ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + СокрЛП(ПараметрыРасчета.ПаевойИнвестиционныйФонд) + " не указана дата окончания формирования ПИФ.", ПараметрыРасчета.ПаевойИнвестиционныйФонд);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) И (ПараметрыРасчета.Дата < ДатаОкончанияФормированияПИФ) Тогда
		// до этой даты резервы не начисляем
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СокрЛП(ПараметрыРасчета.ПаевойИнвестиционныйФонд) + " дата окончания формирования ПИФ (" + Формат(ДатаОкончанияФормированияПИФ, "ДФ=dd.MM.yyyy") + ") позже даты расчета", ПараметрыРасчета.ПаевойИнвестиционныйФонд);
		Возврат Неопределено;		
	КонецЕсли;
	
	УсловияПравилПИФ = БухгалтерскийУчет.ОпределитьУсловияПравилПаевогоИнвестиционногоФонда(ПараметрыРасчета.Дата, ПараметрыРасчета.ПаевойИнвестиционныйФонд);

	Если Не (ЗначениеЗаполнено(УсловияПравилПИФ.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего)
		И ЗначениеЗаполнено(УсловияПравилПИФ.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария)
		И ЗначениеЗаполнено(УсловияПравилПИФ.НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего)) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заданы настройки расчета резервов для " + ПараметрыРасчета.ПаевойИнвестиционныйФонд);
		Возврат Неопределено;
		
	КонецЕсли;
	
	Колонки = "Показатель, Значение";
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		Расшифровка = Новый ТаблицаЗначений;
		Расшифровка.Колонки.Добавить("Показатель");
		Расшифровка.Колонки.Добавить("Значение");
		
		РасшифровкаРасчета.Вставить("Расшифровка", Расшифровка);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
		
	#Область Инициализация_параметров_запроса 
	
	Запрос.УстановитьПараметр("ВалютаУчета", 					ПараметрыРасчета.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ДатаРасчета", 					НачалоДня(ПараметрыРасчета.Дата));
	Запрос.УстановитьПараметр("ТекущаяСЧА", 					ПараметрыРасчета.ТекущаяСЧА);
	
	ДатаПредыдущегоСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ПараметрыРасчета.СчетДоверительногоУправления, ПараметрыРасчета.Дата); 
	Запрос.УстановитьПараметр("ДатаНачисленныхРанееРезервов", 			ДатаПредыдущегоСЧА);
	
	// Если дата окончания формирования ПИФ в текущем году, нужно рассчитывать резервы от нее
	Если ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) И (ДатаОкончанияФормированияПИФ >= НачалоГода(ПараметрыРасчета.Дата) И (КонецГода(ПараметрыРасчета.Дата) >= ДатаОкончанияФормированияПИФ)) Тогда
		Запрос.УстановитьПараметр("ДатаНачалаРасчета", 			ДатаОкончанияФормированияПИФ);	
		Если НЕ ЗначениеЗаполнено(ДатаПредыдущегоСЧА) Тогда 
			Запрос.УстановитьПараметр("ДатаНачисленныхРанееРезервов", 	НачалоДня(ПараметрыРасчета.Дата) - 86400 );
		КонецЕсли;
	Иначе	
		Запрос.УстановитьПараметр("ДатаНачалаРасчета", 			НачалоГода(ПараметрыРасчета.Дата));	      
	КонецЕсли;
	
	ДатыРасчетаСЧАМассив 	= Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ПараметрыРасчета.СчетДоверительногоУправления, Запрос.Параметры.ДатаНачалаРасчета, ПараметрыРасчета.Дата);
	Если ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) Тогда
		РаботаСКоллекциями.ДополнитьМассив(ДатыРасчетаСЧАМассив, ДатаОкончанияФормированияПИФ, Истина);
	КонецЕсли;
	
	ЭтоРасчетВОтчетнуюДату 	= ДатыРасчетаСЧАМассив.Найти(НачалоДня(ПараметрыРасчета.Дата)) <> Неопределено;
	
	Запрос.УстановитьПараметр("ДатыРасчетаСЧА", ДатыРасчетаСЧАМассив);
	
	ДатаВозникновенияОснованияПрекращенияФонда = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаВозникновенияОснованияПрекращенияФонда", ПараметрыРасчета.ПаевойИнвестиционныйФонд);
	ВозниклоОснованиеДляПрекращенияПИФ = ЗначениеЗаполнено(ДатаВозникновенияОснованияПрекращенияФонда) И (ПараметрыРасчета.Дата >= ДатаВозникновенияОснованияПрекращенияФонда);
	ОпределятьСреднегодовуюСЧАЗаПериодРаботы = БухгалтерскийУчет.ОпределитьНастройкуУчета(ПараметрыРасчета.Дата, ПараметрыРасчета.Организация, ПараметрыРасчета.СчетДоверительногоУправления, "ОпределятьСреднегодовуюСЧАЗаПериодРаботы");
	
	// В дату возникновения основания для прекращения ПИФ резервы на вознаграждение УК нужно рассчитывать, поэтому проверяем, осталась ли эта дата в прошлом
	// Далее,
	// (#535996) 07.03.2023 ЦБ прислал разъяснение (письмо 38-1-4/608 от 07.03.2023), что резерв на вознаграждение УК не нужно рассчитывать, начиная с даты возникновения основания для прекращения фонда
	// (#571760) Для Интеллектфонда сделано исключение, т. к. правила СЧА не привели в соответствие письму ЦБ
	// (#) Для ПИФ НПФ в РПИ тоже исключение, правила также не привели в соответствие
	Если ПараметрыРасчета.Дата <= '20230307' 
		Или ПараметрыРасчета.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ЗПИФ_НПФ")
		Или ПараметрыРасчета.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Интеллектфонд") Тогда
		
		ДатаОснованияДляПрекращенияПИФПрошла = ЗначениеЗаполнено(ДатаВозникновенияОснованияПрекращенияФонда) И (НачалоДня(ПараметрыРасчета.Дата) > ДатаВозникновенияОснованияПрекращенияФонда);
		
	Иначе
		ДатаОснованияДляПрекращенияПИФПрошла = ЗначениеЗаполнено(ДатаВозникновенияОснованияПрекращенияФонда) И (НачалоДня(ПараметрыРасчета.Дата) >= ДатаВозникновенияОснованияПрекращенияФонда);
	КонецЕсли;
	
	ДатаПрошлогоднейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ПараметрыРасчета.СчетДоверительногоУправления, Запрос.Параметры.ДатаНачалаРасчета); 
	
	// ПИФ в прошлом году был в другой УК
	Если ДатаПрошлогоднейСЧА = Неопределено И ЗначениеЗаполнено(ДатаОкончанияФормированияПИФ) И Запрос.Параметры.ДатаНачалаРасчета > ДатаОкончанияФормированияПИФ Тогда
		ДатаПрошлогоднейСЧА = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоГода(ПараметрыРасчета.Дата), -1);		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 								ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 				ПараметрыРасчета.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", 					ПараметрыРасчета.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("ВозниклоОснованиеДляПрекращенияПИФ", 		ВозниклоОснованиеДляПрекращенияПИФ);
	Запрос.УстановитьПараметр("ДатаОстатковРезервов", 						НачалоДня(ПараметрыРасчета.Дата)-1);	      
	Запрос.УстановитьПараметр("ДатаФормированияПИФ", 						ДатаОкончанияФормированияПИФ);	      
	Запрос.УстановитьПараметр("ДатаВозникновенияОснованияПрекращенияПИФ", 	?(ВозниклоОснованиеДляПрекращенияПИФ, ДатаВозникновенияОснованияПрекращенияФонда, '00010101'));		
	Запрос.УстановитьПараметр("ДатаПрошлогоднегоСЧА", 						ДатаПрошлогоднейСЧА);		
	Запрос.УстановитьПараметр("ОпределятьСреднегодовуюСЧАЗаПериодРаботы", 	ОпределятьСреднегодовуюСЧАЗаПериодРаботы);
	Запрос.УстановитьПараметр("ДокументРезервов", 		                    ПараметрыРасчета.Ссылка);
	Запрос.УстановитьПараметр("ДатаРасчетаБез1Дня", 						Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ПараметрыРасчета.Дата), -2));
	Запрос.УстановитьПараметр("ДатаОснованияДляПрекращенияПИФПрошла", 		ДатаОснованияДляПрекращенияПИФПрошла);
	
	Если УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего Тогда
		
		Запрос.Параметры.Вставить("ПредыдущаяДатаРезерваВознагражденияУправляющего", Запрос.Параметры.ДатаНачисленныхРанееРезервов);
		
	ИначеЕсли Не Запрос.Параметры.Свойство("ПредыдущаяДатаРезерваВознагражденияУправляющего") Тогда
	
		Запрос.Параметры.Вставить("ПредыдущаяДатаРезерваВознагражденияУправляющего", 
			ПолучитьДатуПоследнегоНачисленияВознагражденияУправляющегоДляПИФ(
				ПараметрыРасчета.Организация, 
				ПараметрыРасчета.СчетДоверительногоУправления, 
				ПараметрыРасчета.Дата, 
				ДатаОкончанияФормированияПИФ));
			
	КонецЕсли;
	
	#КонецОбласти
	
	// Для ФДЦБ вознаграждение УК и лимит на вознаграждение УК рассчитываются по разным формулам.
	// Поэтому для определения среднегодовой берем:
	//		- в отчетную дату СЧА - параметр ТекущаяСЧА (передается с учетом вознаграждения УК)
	//		- в неотчетную дату СЧА - СЧА предыдущей отчетной даты
	ЭтоФДЦБ = ПараметрыРасчета.СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПИФФДЦБ");
	
	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(
		ПараметрыРасчета.СчетДоверительногоУправления, 
		ПараметрыРасчета.Дата,
		Справочники.Календари.Общероссийский,
		"Рабочий,Предпраздничный",
		НачалоГода(ПараметрыРасчета.Дата),
		КонецГода(ПараметрыРасчета.Дата),
		Запрос.МенеджерВременныхТаблиц);
		
	ДанныеДляРасчета = Новый Структура("Резервы, Запрос, ПараметрыРасчета, ОшибкиРасчета, ЭтоФДЦБ, УсловияПравилПИФ, ДатаОснованияДляПрекращенияПИФПрошла, ЭтоРасчетВОтчетнуюДату",
					Резервы, 
					Запрос,  
					ПараметрыРасчета, 
					ОшибкиРасчета, 
					ЭтоФДЦБ,
					УсловияПравилПИФ,
					ДатаОснованияДляПрекращенияПИФПрошла,
					ЭтоРасчетВОтчетнуюДату);
					
	Для Каждого ТекущаяНастройка Из ПереченьРезервов Цикл
		
		ДанныеДляРасчета.Вставить("ТекущаяНастройка", ТекущаяНастройка);
		
		Если Резервы.Свойство("Сумма" + ТекущаяНастройка) Тогда
			// Сумма резервов на вознаграждение депозитария, аудитора, оценщика может быть определена на этапе расчета вознаграждение управляющего.
			Продолжить;
		Иначе
			Резервы.Вставить("Сумма" + ТекущаяНастройка, 0);	
		КонецЕсли;
		
		ФормулаРасчета = УсловияПравилПИФ["НастройкаРасчетаРезервов" + ТекущаяНастройка];  
			
		Если Не ЗначениеЗаполнено(ФормулаРасчета) Тогда
			ДобавитьОшибкуВМассив(ОшибкиРасчета, "Для резерва "+ТекущаяНастройка+" не задана настройка");
		ИначеЕсли ФормулаРасчета.Составляющие.Количество() > 1 Тогда
			ДобавитьОшибкуВМассив(ОшибкиРасчета, "Для расчета резервов не реализовано объединение баз расчета");
		КонецЕсли;
		
		Если РасшифровкаРасчета <> Неопределено Тогда  
			
			Если ТекущаяНастройка = "ЗаВознаграждениеУправляющего" Тогда
				Заголовок = "Резерв на вознаграждение управляющего";
			ИначеЕсли ТекущаяНастройка = "ЗаВознаграждениеДепозитария" Тогда
				Заголовок = "Резерв на вознаграждение депозитария, аудитора, оценщика";
			Иначе	
				Заголовок = "Резерв на прочие расходы управляющего";
			КонецЕсли;
			
			ДобавитьЗаголовокСекцииРасшифровки(РасшифровкаРасчета.Расшифровка, Заголовок, Колонки);
			ЗаполнитьЗначенияСвойств(РасшифровкаРасчета.Расшифровка.Добавить(), Новый Структура(Колонки, "Настройка", СокрЛП(ФормулаРасчета)));
			
		КонецЕсли;
		
		Для Каждого ФрагментФормулы Из ФормулаРасчета.Составляющие Цикл
			
			Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение 
				Или ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.МинимальноеЗначение Тогда
					
				#Область Расчет_резерва_ПИФ_как_минимума_или_максимума_из_составляющих
				
				Составляющие = ФрагментФормулы.ПараметрыРасчета.Получить();
				
				Если Составляющие.ПараметрРасчетаЗначение1.Составляющие.Количество() > 1 
					Или Составляющие.ПараметрРасчетаЗначение2.Составляющие.Количество() > 1 Тогда
					ВызватьИсключение СтрШаблон("Не реализован расчет резерва %1 для %2", ТекущаяНастройка, ПараметрыРасчета.СчетДоверительногоУправления);	
				КонецЕсли;
							
				ПерваяСоставляющая = РассчитатьСоставляющуюНастройкиРасчетаРезерва(ДанныеДляРасчета, Составляющие.ПараметрРасчетаЗначение1.Составляющие[0], РасшифровкаРасчета);
				ВтораяСоставляющая = РассчитатьСоставляющуюНастройкиРасчетаРезерва(ДанныеДляРасчета, Составляющие.ПараметрРасчетаЗначение2.Составляющие[0], РасшифровкаРасчета);
				
				Если ПерваяСоставляющая <> Неопределено И ВтораяСоставляющая <> Неопределено Тогда
					
					Резервы.Вставить("Сумма" + ТекущаяНастройка, 
						?(ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.МаксимальноеЗначение, 
							Макс(ПерваяСоставляющая, ВтораяСоставляющая),
							Мин(ПерваяСоставляющая, ВтораяСоставляющая)));
							
					Если РасшифровкаРасчета <> Неопределено Тогда
						
						ЗаполнитьЗначенияСвойств(РасшифровкаРасчета.Расшифровка.Добавить(), Новый Структура(Колонки, " - Выбор из составляющих:",	""));
						ЗаполнитьЗначенияСвойств(РасшифровкаРасчета.Расшифровка.Добавить(), Новый Структура(Колонки, "		Первая составляющая",		ПерваяСоставляющая));
						ЗаполнитьЗначенияСвойств(РасшифровкаРасчета.Расшифровка.Добавить(), Новый Структура(Колонки, "		Вторая составляющая",		ВтораяСоставляющая));			
						ЗаполнитьЗначенияСвойств(РасшифровкаРасчета.Расшифровка.Добавить(), Новый Структура(Колонки, "Результат",				Формат(Резервы["Сумма" + ТекущаяНастройка], "ЧН=0,00")));
						
					КонецЕсли;
					
				КонецЕсли;
				
				#КонецОбласти
										
			Иначе 	
				
				СуммаРезерва = РассчитатьСоставляющуюНастройкиРасчетаРезерва(ДанныеДляРасчета, ФрагментФормулы, РасшифровкаРасчета);
				Если ДанныеДляРасчета.Резервы.Свойство("СЧАРасчетная") Тогда 
					Резервы.Вставить("СЧАРасчетная", ДанныеДляРасчета.Резервы.СЧАРасчетная);
				КонецЕсли;
				
				Резервы.Вставить("Сумма" + ТекущаяНастройка, СуммаРезерва);
						
			КонецЕсли;
			
			Резервы.Вставить("БазаРасчета" + ТекущаяНастройка, ФрагментФормулы.БазаРасчета);
										
		КонецЦикла;
		
	КонецЦикла;
	
	ПроверкаЗарегистрированныхСЧАИРезервов(Запрос, ОшибкиРасчета);
	
	Если ОшибкиРасчета.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ОшибкиРасчета, Символы.ПС)); 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Резервы;
	
КонецФункции

#КонецОбласти

#Область Вспомогательные_процедуры_и_функции
	
Функция РассчитатьСоставляющуюНастройкиРасчетаРезерва(ДанныеДляРасчета, ФрагментФормулы, РасшифровкаРасчета = Неопределено) 
	
	Резервы				= ДанныеДляРасчета.Резервы;	
	Запрос				= ДанныеДляРасчета.Запрос;
	ТекущаяНастройка 	= ДанныеДляРасчета.ТекущаяНастройка;
	ПараметрыРасчета 	= ДанныеДляРасчета.ПараметрыРасчета;
	ОшибкиРасчета 		= ДанныеДляРасчета.ОшибкиРасчета;
	ЭтоФДЦБ  			= ДанныеДляРасчета.ЭтоФДЦБ;
	УсловияПравилПИФ  	= ДанныеДляРасчета.УсловияПравилПИФ;
	ДатаОснованияДляПрекращенияПИФПрошла = ДанныеДляРасчета.ДатаОснованияДляПрекращенияПИФПрошла;
	ЭтоРасчетВОтчетнуюДату = ДанныеДляРасчета.ЭтоРасчетВОтчетнуюДату;

	Колонки = "Показатель,Значение";
	
	Параметры = ФрагментФормулы.ПараметрыРасчета.Получить();
			
	Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтОднойДвенадцатойПоследнейСЧА Тогда
		
		#Область Расчет_резерва_ПИФ_от_одной_двенадцатой_последней_СЧА
		
		ДобавитьИсточникДанных(Запрос, "_ДнейВМесяце");
		ДобавитьИсточникДанных(Запрос, "_ДатыОтчетнойСЧАДействующейНаКаждуюРабочуюДату");
		ДобавитьИсточникДанных(Запрос, "_ПИФДоверительногоУправления");
		ДобавитьИсточникДанных(Запрос, "_СЧАДляРезервовПИФ");
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаМесяц");
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего");
		
		Запрос.Параметры.Вставить("ПараметрРасчетаСтавка", Параметры.ПараметрРасчетаСтавка);
		Запрос.Параметры.Вставить("ПараметрРасчетаНижняяГраницаСуммы", Параметры.ПараметрРасчетаНижняяГраницаСуммы);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_СЧАДляРезервовПИФ.СуммаСЧАСНачалаГода, 0) - ВЫБОР
			|		КОГДА &ДатаРасчета В (&ДатыРасчетаСЧА)
			|			ТОГДА ЕСТЬNULL(_СЧАДляРезервовПИФ.СЧА, 0)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СуммаСЧАСНачалаГода,
			|	ЕСТЬNULL(_СЧАДляРезервовПИФ.ПредыдущееСЧА, 0) КАК ПредыдущееСЧА,
			|	""ПредыдущееСЧА"" КАК Представление,
			|	&ПараметрРасчетаСтавка КАК Ставка,
			|	_ДнейВМесяце.КоэффициентМесяцаНаДатуРасчета КАК КоэффициентПрошедшихДнейМесяца,
			|	ВЫРАЗИТЬ(ЕСТЬNULL(_СЧАДляРезервовПИФ.ПредыдущееСЧА, 0) * &ПараметрРасчетаСтавка * _ДнейВМесяце.КоэффициентМесяцаНаДатуРасчета / 12 / 100 КАК ЧИСЛО(19, 2)) КАК СуммаРезерваПоСтавке,
			|	ЕСТЬNULL(_НачисленныеРезервыПИФТекущие.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленная,
			|	ЕСТЬNULL(_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего,
			|	ВЫРАЗИТЬ(&ПараметрРасчетаНижняяГраницаСуммы * _ДнейВМесяце.КоэффициентМесяцаНаДатуРасчета КАК ЧИСЛО(19, 2)) КАК НижняяГраницаСуммы
			|ИЗ
			|	_СЧАДляРезервовПИФ КАК _СЧАДляРезервовПИФ
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФТекущие КАК _НачисленныеРезервыПИФТекущие
			|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФТекущие.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего КАК _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего
			|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего.СчетДоверительногоУправления,
			|	_ДнейВМесяце КАК _ДнейВМесяце
			|ГДЕ
			|	_СЧАДляРезервовПИФ.Дата = &ДатаРасчета
			|	И _СЧАДляРезервовПИФ.СчетДоверительногоУправления = &СчетДоверительногоУправления";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_НачисленныеРезервыПИФТекущие", "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаМесяц");
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			СуммаНаДату = 
				?(ВыборкаДетальныеЗаписи.НижняяГраницаСуммы = 0 ИЛИ ВыборкаДетальныеЗаписи.СуммаРезерваПоСтавке > ВыборкаДетальныеЗаписи.НижняяГраницаСуммы, 
					ВыборкаДетальныеЗаписи.СуммаРезерваПоСтавке, 
					ВыборкаДетальныеЗаписи.НижняяГраницаСуммы);
							
			СуммаСУчетомРезерва = СуммаНаДату - ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				Расшифровка = РасшифровкаРасчета.Расшифровка;
				
				ПараметрыФормул = Новый Структура;		 
				
				ПараметрыФормул.Вставить("Заголовок", ФрагментФормулы.Представление);
											
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), 
					Новый Структура(Колонки, "Последняя СЧА", Формат(ВыборкаДетальныеЗаписи.ПредыдущееСЧА, "ЧН=0,00")));
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
					Новый Структура(Колонки, "Ставка процента", Параметры.ПараметрРасчетаСтавка / 100));
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
					Новый Структура(Колонки, "Расчет суммы резерва от 1/12 последней СЧА",	 Формат(ВыборкаДетальныеЗаписи.СуммаРезерваПоСтавке, "ЧН=0,00")));
				
				Если ВыборкаДетальныеЗаписи.НижняяГраницаСуммы > 0 Тогда
					ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
						Новый Структура(Колонки, "Минимальная сумма резерва из настроек", Формат(ВыборкаДетальныеЗаписи.НижняяГраницаСуммы, "ЧН=0,00")));
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
					Новый Структура(Колонки, "Ранее начисленная сумма резерва", Формат(ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная, "ЧН=0,00")));
					
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
					Новый Структура(Колонки, "Сумма резерва к доначислению", Формат(СуммаСУчетомРезерва, "ЧН=0,00")));
						
				ПараметрыФормул.Вставить("СтавкаПроцента",							Параметры.ПараметрРасчетаСтавка);
				ПараметрыФормул.Вставить("ПоследняяСЧА", 							ВыборкаДетальныеЗаписи.ПредыдущееСЧА);
				ПараметрыФормул.Вставить("НижняяГраницаСуммы", 						ВыборкаДетальныеЗаписи.НижняяГраницаСуммы);
				ПараметрыФормул.Вставить("КоэффициентПрошедшихДнейМесяца", 			ВыборкаДетальныеЗаписи.КоэффициентПрошедшихДнейМесяца);
				ПараметрыФормул.Вставить("СуммаРезерваОтОднойДвенадцатойСЧА",		Формат(ВыборкаДетальныеЗаписи.СуммаРезерваПоСтавке, "ЧН=0,00")); 
				ПараметрыФормул.Вставить("СуммаРезерваЗаПериод",					Формат(СуммаНаДату, "ЧН=0,00")); 
				ПараметрыФормул.Вставить("СуммаРезерва",							Формат(СуммаСУчетомРезерва, "ЧН=0,00")); 
				ПараметрыФормул.Вставить("СуммаРанееНачисленногоРезерва",			Формат(ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная, "ЧН=0,00"));
            	ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ОтОднойДвенадцатойПоследнейСЧА");
				
				РасшифровкаРасчета.Вставить(ТекущаяНастройка + "ФормулыПоСЧА", ПараметрыФормул);
				
			КонецЕсли;
			
			Если ТекущаяНастройка = "ЗаВознаграждениеУправляющего" Тогда
				
				Резервы.Вставить("СуммаВознагражденияУправляющего", СуммаНаДату);
				
				Если УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария Тогда
					ДобавитьОшибкуВМассив(ОшибкиРасчета, "Не реализован расчет резервов ПИФ, учитывающий резервы на услуги депозитария, аудитора, оценщика для базы расчета "+ ФрагментФормулы.БазаРасчета);
				Иначе
					
					// Зафиксируем Сумму СЧА для расчета среднегодовой, скорее всего потребуется
					Если ЭтоРасчетВОтчетнуюДату Тогда
						Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", 
										ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода 
										+ ПараметрыРасчета.ТекущаяСЧА 
										- (СуммаСУчетомРезерва 
											+ ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная
				 							- ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего));
					Иначе
						Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Возврат СуммаСУчетомРезерва;
						
		КонецЕсли;
						
		#КонецОбласти
		
	ИначеЕсли ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА Тогда
				
		#Область Расчет_резерва_ПИФ_от_среднегодовой_СЧА
		
		ДобавитьИсточникДанных(Запрос, "_ДнейВГоду");
		ДобавитьИсточникДанных(Запрос, "_ДатыОтчетнойСЧАДействующейНаКаждуюРабочуюДату");
		ДобавитьИсточникДанных(Запрос, "_ПИФДоверительногоУправления");
		ДобавитьИсточникДанных(Запрос, "_СЧАДляРезервовПИФ");
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаГод");
		
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего");
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГодПоПредыдущуюДатуСЧА");
		ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГод");
		
		Если ТекущаяНастройка = "ЗаВознаграждениеУправляющего" Тогда
			
			Запрос.Параметры.Вставить("ПараметрРасчетаСтавка", Параметры.ПараметрРасчетаСтавка);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЕСТЬNULL(_СЧАДляРезервовПИФ.СуммаСЧАСНачалаГода - _СЧАДляРезервовПИФ.СЧА, 0) КАК СуммаСЧАСНачалаГода,
				|	ВЫБОР
				|		КОГДА &ДатаРасчета В (&ДатыРасчетаСЧА)
				|			ТОГДА 0
				|		ИНАЧЕ _СЧАДляРезервовПИФ.СЧА
				|	КОНЕЦ КАК ДействующееСЧАПредыдущейОтчетнойДаты,
				|	""СреднегодоваяСЧА"" КАК Представление,
				|	ВЫБОР
				|		КОГДА &ОпределятьСреднегодовуюСЧАЗаПериодРаботы = ИСТИНА
				|			ТОГДА _ДнейВГоду.РабочихДнейВГодуПрошло
				|		ИНАЧЕ _ДнейВГоду.РабочихДнейВГодуВсего
				|	КОНЕЦ КАК КоличествоДнейДляРасчетаСреднегодовойСЧА,
				|	&ПараметрРасчетаСтавка КАК Ставка,
				|	ВЫБОР
				|		КОГДА &ОпределятьСреднегодовуюСЧАЗаПериодРаботы = ИСТИНА
				|			ТОГДА _ДнейВГоду.РабочихДнейВГодуПрошло
				|		ИНАЧЕ _ДнейВГоду.РабочихДнейВГодуВсего
				|	КОНЕЦ КАК КоличествоДнейВГоду,
				|	ЕСТЬNULL(_НачисленныеРезервыПИФ.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленная,
				|	ЕСТЬNULL(_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего,
				|	ЕСТЬNULL(_НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГодПоПредыдущуюДатуСЧА.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленнаяЗаВознаграждениеДепозитарияПоПредыдущуюДатуСЧА,
				|	ЕСТЬNULL(_НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГод.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленнаяЗаВознаграждениеДепозитария
				|ИЗ
				|	_СЧАДляРезервовПИФ КАК _СЧАДляРезервовПИФ
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФТекущие КАК _НачисленныеРезервыПИФ
				|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФ.СчетДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего КАК _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего
				|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего.СчетДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГодПоПредыдущуюДатуСЧА КАК _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГодПоПредыдущуюДатуСЧА
				|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГодПоПредыдущуюДатуСЧА.СчетДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГод КАК _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГод
				|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФЗаВознаграждениеДепозитарияЗаГод.СчетДоверительногоУправления,
				|	_ДнейВГоду КАК _ДнейВГоду
				|ГДЕ
				|	_СЧАДляРезервовПИФ.Дата = &ДатаРасчета
				|	И _СЧАДляРезервовПИФ.СчетДоверительногоУправления = &СчетДоверительногоУправления";
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "_НачисленныеРезервыПИФТекущие", "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаГод");
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				Если ДатаОснованияДляПрекращенияПИФПрошла Тогда
					ПараметрРасчетаСтавка = 0;
					СуммаРезерваНачисленная = 0;
					СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего = 0;
				Иначе
					ПараметрРасчетаСтавка = Параметры.ПараметрРасчетаСтавка;
					СуммаРезерваНачисленная = ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная;
					СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего = ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего;
				КонецЕсли;
				
				СтавкаЛимитаЗаВознаграждениеДепозитария = ?(ЭтоФДЦБ, 0, УсловияПравилПИФ.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария.Составляющие[0].ПараметрыРасчета.Получить().ПараметрРасчетаСтавка);
				
				Если УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария Тогда
										
					СЧАРасчетная = Окр(((ПараметрыРасчета.ТекущаяСЧА 
											+ СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего
											+ ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитарияПоПредыдущуюДатуСЧА)
										- (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода * ((ПараметрРасчетаСтавка + СтавкаЛимитаЗаВознаграждениеДепозитария) / 100) / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду))
									/(1 + ((ПараметрРасчетаСтавка + СтавкаЛимитаЗаВознаграждениеДепозитария) / 100) / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду), 2);
					
					СуммаЗаВознаграждениеУправляющего = 
						Окр((СЧАРасчетная + ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода) 
							/ ВыборкаДетальныеЗаписи.КоличествоДнейВГоду * ПараметрРасчетаСтавка / 100 
							- СуммаРезерваНачисленная, 2);
					
					СуммаЗаВознаграждениеДепозитария = 
						Окр((СЧАРасчетная + ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода) 
							/ ВыборкаДетальныеЗаписи.КоличествоДнейВГоду * СтавкаЛимитаЗаВознаграждениеДепозитария / 100 
							- ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитария, 2);
					
					ПолнаяСуммаСЧАЗаГод = (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода + ПараметрыРасчета.ТекущаяСЧА - 
						(СуммаЗаВознаграждениеУправляющего + СуммаРезерваНачисленная - СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего
						 + СуммаЗаВознаграждениеДепозитария + ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитария - ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитарияПоПредыдущуюДатуСЧА));
						
					Резервы.Вставить("СуммаЗаВознаграждениеУправляющего", СуммаЗаВознаграждениеУправляющего + СуммаРезерваНачисленная - СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего);
															
				Иначе

					Если ЭтоФДЦБ Тогда
						СЧАРасчетная = ?(ВыборкаДетальныеЗаписи.ДействующееСЧАПредыдущейОтчетнойДаты = 0, ПараметрыРасчета.ТекущаяСЧА, ВыборкаДетальныеЗаписи.ДействующееСЧАПредыдущейОтчетнойДаты);
					Иначе	
						СЧАРасчетная = Окр(((ПараметрыРасчета.ТекущаяСЧА 
												+ СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего)
											- (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода 
												* (ПараметрРасчетаСтавка / 100) 
												/ ВыборкаДетальныеЗаписи.КоличествоДнейВГоду))
										/(1 + (ПараметрРасчетаСтавка / 100) / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду), 2);
					КонецЕсли;
					
					СуммаЗаВознаграждениеУправляющего = 
						Окр((СЧАРасчетная + ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода) 
							/ ВыборкаДетальныеЗаписи.КоличествоДнейВГоду * ПараметрРасчетаСтавка / 100 
							- СуммаРезерваНачисленная, 2);
					
					Если ЭтоФДЦБ Тогда
						ПолнаяСуммаСЧАЗаГод = ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода + СЧАРасчетная;		
					Иначе			
						ПолнаяСуммаСЧАЗаГод = (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода + ПараметрыРасчета.ТекущаяСЧА - 
							(СуммаЗаВознаграждениеУправляющего + СуммаРезерваНачисленная - СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего));
					КонецЕсли;
					
					Резервы.Вставить("СуммаЗаВознаграждениеУправляющего",	СуммаЗаВознаграждениеУправляющего);  
															
				КонецЕсли;
				
				Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", ПолнаяСуммаСЧАЗаГод);
				Резервы.Вставить("СЧАРасчетная",		СЧАРасчетная);
				
				Если РасшифровкаРасчета <> Неопределено Тогда
						
					Если Не РасшифровкаРасчета.Свойство(ТекущаяНастройка) Тогда
						
						Расшифровка = РасшифровкаРасчета.Расшифровка;					
																		
						ДобавитьЗаголовокСекцииРасшифровки(Расшифровка, "Расчет по среднегодовой СЧА", Колонки);
						
						Если ЭтоФДЦБ Тогда
							
							СреднегодоваяСЧА = Окр(ПолнаяСуммаСЧАЗаГод / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду, 2, 1);
							
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Сумма СЧА", 				ПолнаяСуммаСЧАЗаГод)); 
							
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Количество дней для расчета среднегодовой СЧА",	
																					ВыборкаДетальныеЗаписи.КоличествоДнейВГоду));
																					
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Среднегодовая СЧА",		СреднегодоваяСЧА));
							
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Сумма резервов на вознаграждение управляющего", СуммаРезерваНачисленная)); 
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Предельный процент вознаграждения управляющего", ПараметрРасчетаСтавка / 100)); 
							
							СуммаЗаВознаграждениеУправляющего = Окр(Резервы.СуммаЗаВознаграждениеУправляющего, 2);
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Резерв на вознаграждение управляющего", Формат(СуммаЗаВознаграждениеУправляющего, "ЧН=0,00"))); 
																				
							// Добавим формулы
							ПараметрыФормул = Новый Структура;                                                               
							ПараметрыФормул.Вставить("Заголовок", 											ФрагментФормулы.Представление);
							ПараметрыФормул.Вставить("СуммаСЧА", 											ПолнаяСуммаСЧАЗаГод);
							ПараметрыФормул.Вставить("РабочихДнейВГоду", 									ВыборкаДетальныеЗаписи.КоличествоДнейВГоду);
							ПараметрыФормул.Вставить("ПределВознагражденияУправляющего", 					ПараметрРасчетаСтавка / 100);							
							ПараметрыФормул.Вставить("СреднегодоваяСЧА", 									СреднегодоваяСЧА);
							ПараметрыФормул.Вставить("РанееНачисленныйРезервНаВознаграждениеУправляющего", 	СуммаРезерваНачисленная);							
							ПараметрыФормул.Вставить("СуммаНаВознаграждениеУправляющего", 					Формат(СуммаЗаВознаграждениеУправляющего, "ЧН=0,00"));							
							ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",								"Формулы_ПоСреднегодовойСЧА_БезИспользованияРасчетнойСЧА");
							
						Иначе 
							
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Активы - Кт",			ПараметрыРасчета.ТекущаяСЧА)); 
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Количество дней для расчета среднегодовой СЧА",	ВыборкаДетальныеЗаписи.КоличествоДнейВГоду)); 
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Сумма СЧА",				ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода));
							
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Сумма резервов на вознаграждение управляющего", 
											СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего)); 
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Средневзвешенная ставка резерва на вознаграждение управляющего", ПараметрРасчетаСтавка / 100)); 
							
							Если УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария Тогда				
								ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Сумма резервов на услуги депозитария", 
											ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитарияПоПредыдущуюДатуСЧА)); 
								ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Средневзвешенная ставка резерва на услуги депозитария", СтавкаЛимитаЗаВознаграждениеДепозитария / 100)); 	
							КонецЕсли;										
																				
							ПерваяСкобка = (ПараметрыРасчета.ТекущаяСЧА 
										+ СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего
										+ ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитарияПоПредыдущуюДатуСЧА);
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Первая скобка", ПерваяСкобка)); 
							
							ИспользуемаяСтавка = (ПараметрРасчетаСтавка + ?(УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария, СтавкаЛимитаЗаВознаграждениеДепозитария, 0)) / 100;
							
							ВтораяСкобка = (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода * ИспользуемаяСтавка / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду);
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Вторая скобка", ВтораяСкобка)); 
								
							Числитель = ПерваяСкобка - ВтораяСкобка;	
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Числитель", Числитель)); 
							
							Знаменатель = (1 + ИспользуемаяСтавка / ВыборкаДетальныеЗаписи.КоличествоДнейВГоду);
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Знаменатель", Знаменатель)); 
								
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "СЧА расчетная", СЧАРасчетная));
							СуммаЗаВознаграждениеУправляющего = Окр(Резервы.СуммаЗаВознаграждениеУправляющего, 2);
							ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "Резерв на вознаграждение управляющего", СуммаЗаВознаграждениеУправляющего)); 
																				
							// Добавим формулы
							ПараметрыФормул = Новый Структура;                                                               
							ПараметрыФормул.Вставить("Заголовок", 								ФрагментФормулы.Представление);
							ПараметрыФормул.Вставить("РасчетнаяВеличинаАктивов", 				ПараметрыРасчета.ТекущаяСЧА);
							ПараметрыФормул.Вставить("РабочихДнейВГоду", 						ВыборкаДетальныеЗаписи.КоличествоДнейВГоду);
							ПараметрыФормул.Вставить("СредневзвешеннаяСтавкаУпр", 				ПараметрРасчетаСтавка / 100);
							ПараметрыФормул.Вставить("СредневзвешеннаяСтавкаПр", 				СтавкаЛимитаЗаВознаграждениеДепозитария / 100);							
							ПараметрыФормул.Вставить("ПерваяСкобка", 							ПерваяСкобка);
							ПараметрыФормул.Вставить("ВтораяСкобка", 							ВтораяСкобка);
							ПараметрыФормул.Вставить("СуммаСЧА", 								ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода);
							ПараметрыФормул.Вставить("СуммаРезервовУпр", 						СуммаРезерваНачисленная);
							ПараметрыФормул.Вставить("СуммаРезервовПр", 						ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеДепозитария);							
							ПараметрыФормул.Вставить("РасчетнаяВеличинаАктивов", 				ПараметрыРасчета.ТекущаяСЧА);
							ПараметрыФормул.Вставить("Знаменатель", 							Знаменатель);
							ПараметрыФормул.Вставить("Числитель", 								Числитель);
							ПараметрыФормул.Вставить("СЧАРасчетная", 							СЧАРасчетная);
							ПараметрыФормул.Вставить("СуммаНаВознаграждениеУправляющего", 		СуммаЗаВознаграждениеУправляющего);
							ПараметрыФормул.Вставить("СуммаНаУслугиДепозитария", 				СуммаЗаВознаграждениеДепозитария);							
							ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ПоСреднегодовойСЧА_ИспользуяРасчетнуюСЧА" + ?(УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария, "", "БезУчетаДепозитария"));
							
						КонецЕсли;
						
						РасшифровкаРасчета.Вставить(ТекущаяНастройка + "ФормулыПоСреднегодовой", ПараметрыФормул);
																
					КонецЕсли;
					
				КонецЕсли;	
				
				Возврат СуммаЗаВознаграждениеУправляющего;
								
			Иначе
				
				Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", 0);
				Резервы.Вставить("СЧАРасчетная",		0);
				
			КонецЕсли;
			
			
		Иначе					
			
			Запрос.Параметры.Вставить("ПараметрРасчетаСтавка", Параметры.ПараметрРасчетаСтавка);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ВЫБОР
				|		КОГДА &ОпределятьСреднегодовуюСЧАЗаПериодРаботы = ИСТИНА
				|			ТОГДА _ДнейВГоду.РабочихДнейВГодуПрошло
				|		ИНАЧЕ _ДнейВГоду.РабочихДнейВГодуВсего
				|	КОНЕЦ КАК КоличествоДнейДляРасчетаСреднегодовойСЧА,
				|	ЕСТЬNULL(_НачисленныеРезервыПИФ.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленная
				|ИЗ
				|	_ДнейВГоду КАК _ДнейВГоду
				|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФТекущие КАК _НачисленныеРезервыПИФ
				|		ПО (ИСТИНА)";
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "_НачисленныеРезервыПИФТекущие", "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаГод");
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				Результат = Окр(Резервы.ПолнаяСуммаСЧАЗаГод * Параметры.ПараметрРасчетаСтавка / 100 
							/ ВыборкаДетальныеЗаписи.КоличествоДнейДляРасчетаСреднегодовойСЧА, 2)
								- ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная;
								
				Если РасшифровкаРасчета <> Неопределено Тогда
					
					Если Не РасшифровкаРасчета.Свойство(ТекущаяНастройка) Тогда
						
						Расшифровка = РасшифровкаРасчета.Расшифровка;
						
						ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
							Новый Структура(Колонки, "Общая сумма СЧА с начала года", Резервы.ПолнаяСуммаСЧАЗаГод)); 
							
						ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
							Новый Структура(Колонки, "Количество дней для расчета среднегодовой СЧА", ВыборкаДетальныеЗаписи.КоличествоДнейДляРасчетаСреднегодовойСЧА)); 	

						ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
							Новый Структура(Колонки, 
								?(ТекущаяНастройка = "ЗаПрочиеВозмещаемыеРасходыУправляющего", "Средневзвешенная ставка резерва на прочие расходы", "Средневзвешенная ставка резерва на услуги депозитария"), 
								Параметры.ПараметрРасчетаСтавка / 100));
								
						ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
							Новый Структура(Колонки, "Ранее начисленная сумма резерва", ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная));
							
						ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
							Новый Структура(Колонки, 
								?(ТекущаяНастройка = "ЗаПрочиеВозмещаемыеРасходыУправляющего", "Резерв на прочие расходы", "Резерв на услуги депозитария"),
								Результат)); 
								
						ПараметрыФормул = Новый Структура;		
						
						ПараметрыФормул.Вставить("Заголовок",								ФрагментФормулы.Представление);						
						ПараметрыФормул.Вставить("СреднегодоваяСЧА",						Резервы.ПолнаяСуммаСЧАЗаГод);
						ПараметрыФормул.Вставить("СредневзвешеннаяСтавкаРезерва",			Параметры.ПараметрРасчетаСтавка / 100);
						ПараметрыФормул.Вставить("СуммаРезерва",							Результат);
						ПараметрыФормул.Вставить("РабочихДнейВГоду",						ВыборкаДетальныеЗаписи.КоличествоДнейДляРасчетаСреднегодовойСЧА);
						ПараметрыФормул.Вставить("СуммаРанееНачисленногоРезерва",			ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная);
						ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ПоСреднегодовойСЧА");
												
						РасшифровкаРасчета.Вставить(ТекущаяНастройка + "ФормулыПоСреднегодовой", ПараметрыФормул);
						
					КонецЕсли;
					
				КонецЕсли;	
					
				Возврат Результат;
				
			КонецЕсли;
						
		КонецЕсли;
		
		#КонецОбласти

	ИначеЕсли ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц
		Или ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда

		#Область Расчет_резерва_ПИФ_от_фиксированной_суммы

		Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда
			ИмяТекущейТаблицыРезервов = "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаГод";
			ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаГодПоПредыдущуюДатуРезерваВознагражденияУправляющего");
		Иначе
			ИмяТекущейТаблицыРезервов = "_НачисленныеРезервыПИФ" + ТекущаяНастройка + "ЗаМесяц";
			ДобавитьИсточникДанных(Запрос, "_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего");
		КонецЕсли;
		
		ДобавитьИсточникДанных(Запрос, ИмяТекущейТаблицыРезервов);
		ДобавитьИсточникДанных(Запрос, "_ДнейВМесяце");
		ДобавитьИсточникДанных(Запрос, "_ПИФДоверительногоУправления");
		ДобавитьИсточникДанных(Запрос, "_ДатыОтчетнойСЧАДействующейНаКаждуюРабочуюДату");
		ДобавитьИсточникДанных(Запрос, "_СЧАДляРезервовПИФ");
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СЧАДляРезервовПИФ.СуммаСЧАСНачалаГода - ВЫБОР
			|		КОГДА &ДатаРасчета В (&ДатыРасчетаСЧА)
			|			ТОГДА _СЧАДляРезервовПИФ.СЧА
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СуммаСЧАСНачалаГода,
			|	_ДнейВМесяце.РабочихДнейВМесяце КАК РабочихДнейВМесяцеПрошло,
			|	_ДнейВМесяце.РабочихДнейВМесяцеВсего КАК РабочихДнейВМесяцеВсего,
			|	ЕСТЬNULL(_НачисленныеРезервыПИФ.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленная,
			|	ЕСТЬNULL(_НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего.СуммаРезерваНачисленная, 0) КАК СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего
			|ИЗ
			|	_ДнейВМесяце КАК _ДнейВМесяце
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧАДляРезервовПИФ КАК _СЧАДляРезервовПИФ
			|		ПО (ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФТекущие КАК _НачисленныеРезервыПИФ
			|		ПО (_СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФ.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего КАК _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего
			|		ПО (_СЧАДляРезервовПИФ.СчетДоверительногоУправления = _НачисленныеРезервыПИФЗаВознаграждениеУправляющегоЗаМесяцПоПредыдущуюДатуРезерваВознагражденияУправляющего.СчетДоверительногоУправления)
			|ГДЕ
			|	_СЧАДляРезервовПИФ.Дата = &ДатаРасчета
			|	И _СЧАДляРезервовПИФ.СчетДоверительногоУправления = &СчетДоверительногоУправления";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_НачисленныеРезервыПИФТекущие", ИмяТекущейТаблицыРезервов);
		
		Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВГод Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаМесяц", "ЗаГод");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
				СуммаНаДату = Окр(Параметры.ПараметрРасчетаСумма 
							* ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеПрошло
							/ ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеВсего, 2);
			Иначе
				
				// При расчете по календарным дням в последний рабочий день месяца нужно учесть выходные дни до конца мясяца (если есть)
				КалендарныхДнейВГодуПрошло 	= ?(Параметры.ПараметрРасчетаПоКалендарнымДням 
												И Месяц(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДанныеДляРасчета.ПараметрыРасчета.Дата, 2)) 
													<> Месяц(ДанныеДляРасчета.ПараметрыРасчета.Дата)
												И КонецДня(ДанныеДляРасчета.ПараметрыРасчета.Дата) <> КонецМесяца(ДанныеДляРасчета.ПараметрыРасчета.Дата),
											ДеньГода(КонецМесяца(ДанныеДляРасчета.ПараметрыРасчета.Дата)),			
											ДеньГода(ДанныеДляРасчета.ПараметрыРасчета.Дата));
											
				КалендарныхДнейВГоду 		= ДеньГода(КонецГода(ДанныеДляРасчета.ПараметрыРасчета.Дата));
				
				СуммаНаДату = ?(Параметры.ПараметрРасчетаПоКалендарнымДням,
								Окр(Параметры.ПараметрРасчетаСумма * КалендарныхДнейВГодуПрошло	/ КалендарныхДнейВГоду, 2),	
								Параметры.ПараметрРасчетаСумма);
								
			КонецЕсли;
			
			СуммаРезерва = СуммаНаДату - ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная;
			
			Если ТекущаяНастройка = "ЗаВознаграждениеУправляющего" Тогда
				
				// если в дополнительную дату СЧА начисляли вознаграждение управляющего				
				ПолнаяСуммаСЧАЗаГод = (ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода + ПараметрыРасчета.ТекущаяСЧА - 
					(СуммаРезерва + ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная - ВыборкаДетальныеЗаписи.СуммаРезерваНачисленнаяЗаВознаграждениеУправляющегоПоПредыдущуюДатуРезерваВознагражденияУправляющего));
				
				Резервы.Вставить("СуммаВознагражденияУправляющего", СуммаНаДату);

				Если УсловияПравилПИФ.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария Тогда
					ДобавитьОшибкуВМассив(ОшибкиРасчета, "Не реализован расчет резервов ПИФ, учитывающий резервы на услуги депозитария, аудитора, оценщика для базы расчета " + ФрагментФормулы.БазаРасчета);
				Иначе
					// Зафиксируем Сумму СЧА для расчета среднегодовой, скорее всего потребуется
					Если ЭтоРасчетВОтчетнуюДату Тогда
						Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода + ПараметрыРасчета.ТекущаяСЧА - СуммаНаДату);
					Иначе
						Резервы.Вставить("ПолнаяСуммаСЧАЗаГод", ВыборкаДетальныеЗаписи.СуммаСЧАСНачалаГода);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если РасшифровкаРасчета <> Неопределено Тогда
				
				Расшифровка = РасшифровкаРасчета.Расшифровка;
				
				ПериодРасчета = " в год";
				Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
					
					ПериодРасчета = " в месяц";
					
					ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
						Новый Структура(Колонки, "Количество прошедших рабочих дней в текущем месяце", ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеПрошло));
					
					ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
						Новый Структура(Колонки, "Количество рабочих дней в месяце", ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеВсего));
					
				ИначеЕсли Параметры.ПараметрРасчетаПоКалендарнымДням Тогда
					
					ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),	
						Новый Структура(Колонки, "Количество календарных дней в году", КалендарныхДнейВГоду));
					ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
						Новый Структура(Колонки, "Количество прошедших календарных дней в году", КалендарныхДнейВГодуПрошло));
						
				КонецЕсли;	
				
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
						Новый Структура(Колонки, "Фиксированная сумма из настроек", Параметры.ПараметрРасчетаСумма));
				ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(),
						Новый Структура(Колонки, "Расчет резерва от фиксированной суммы", Формат(СуммаРезерва, "ЧН=0,00")));		
						
				ПараметрыФормул = Новый Структура;
								
				ПараметрыФормул.Вставить("Заголовок", 								"По фиксированной сумме " + ФрагментФормулы.Представление); 											
				ПараметрыФормул.Вставить("ПределРезерва",							Параметры.ПараметрРасчетаСумма);
				ПараметрыФормул.Вставить("СуммаРезерва",							Формат(СуммаРезерва, "ЧН=0,00")); 
				ПараметрыФормул.Вставить("СуммаРанееНачисленногоРезерва",			Формат(ВыборкаДетальныеЗаписи.СуммаРезерваНачисленная, "ЧН=0,00"));
				
				Если ФрагментФормулы.БазаРасчета = Справочники.БазыРасчета.РасчетРезерваПИФОтФиксированнойСуммыВМесяц Тогда
					
					ПараметрыФормул.Вставить("ПрошедшихРабочихДнейВМесяце", ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеПрошло);
					ПараметрыФормул.Вставить("РабочихДнейВМесяце", 			ВыборкаДетальныеЗаписи.РабочихДнейВМесяцеВсего);						
					ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ФиксированнойСуммойВМесяц");
					
				ИначеЕсли Параметры.ПараметрРасчетаПоКалендарнымДням Тогда
					
					ПараметрыФормул.Вставить("КалендарныхДнейВГодуПрошло",				КалендарныхДнейВГодуПрошло);
					ПараметрыФормул.Вставить("КалендарныхДнейВГоду",					КалендарныхДнейВГоду);
					ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ФиксированнойСуммойВГодПоКалендарнымДням");
					
				Иначе
					ПараметрыФормул.Вставить("ИмяОбластиФормулВМакете",					"Формулы_ФиксированнойСуммойВГод");
				КонецЕсли;
											
				РасшифровкаРасчета.Вставить(ТекущаяНастройка + "ФормулыФиксированнойСуммой", ПараметрыФормул);
				
			КонецЕсли;
            			
			Возврат СуммаРезерва;
						
		КонецЕсли;
		
		#КонецОбласти
		
	Иначе
		ДобавитьОшибкуВМассив(ОшибкиРасчета, "Не реализован расчет резервов ПИФ для базы расчета " + ФрагментФормулы.БазаРасчета);		
	КонецЕсли;
				
КонецФункции

Процедура ДобавитьЗаголовокСекцииРасшифровки(Расшифровка, Заголовок, Колонки)
	
	Если Расшифровка.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "",							""));
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), Новый Структура(Колонки, "***" + ВРег(Заголовок) + "***",				"")); 
		
КонецПроцедуры

Процедура ПроверкаЗарегистрированныхСЧАИРезервов(Запрос, ОшибкиРасчета)
		
	// Резервы на вознаграждение УК и прочие вознаграждения контролируем только в случае их учета в СЧА  
	
	Запрос.УстановитьПараметр("ДатаЗаключения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запрос.Параметры.СчетДоверительногоУправления, "ДатаЗаключения"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(РезервыПИФОбороты.Период, ДЕНЬ) КАК Период,
		|	РезервыПИФОбороты.СуммаПриход КАК СуммаПриход,
		|	РезервыПИФОбороты.Резерв КАК Резерв
		|ПОМЕСТИТЬ _НачисленныеРезервы
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.Обороты(
		|			НАЧАЛОПЕРИОДА(&ДатаРасчета, ГОД),
		|			КОНЕЦПЕРИОДА(&ДатаРасчетаБез1Дня, ДЕНЬ),
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Валюта = &ВалютаУчета) КАК РезервыПИФОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ПИФДоверительногоУправления.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
		|			ТОГДА _СЧАДляРезервовПИФ.ДатаСЧА
		|		ИНАЧЕ _СЧАДляРезервовПИФ.Дата
		|	КОНЕЦ КАК Дата,
		|	_СЧАДляРезервовПИФ.СЧА КАК СЧА,
		|	УсловияПравилПИФСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		|		И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаЗаключения
		|		И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета
		|		И _НачисленныеРезервыВознаграждениеУправляющего.СуммаПриход ЕСТЬ NULL КАК ОтсутствуетРезервНаВознаграждениеУправляющего,
		|	УсловияПравилПИФСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария
		|		И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаЗаключения
		|		И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета
		|		И _НачисленныеРезервыВознагражденияПрочие.СуммаПриход ЕСТЬ NULL КАК ОтсутствуетРезервНаПрочиеВознаграждения
		|ИЗ
		|	_СЧАДляРезервовПИФ КАК _СЧАДляРезервовПИФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПИФДоверительногоУправления КАК _ПИФДоверительногоУправления
		|		ПО _СЧАДляРезервовПИФ.СчетДоверительногоУправления = _ПИФДоверительногоУправления.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервы КАК _НачисленныеРезервыВознаграждениеУправляющего
		|		ПО (ВЫБОР
		|				КОГДА _ПИФДоверительногоУправления.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
		|					ТОГДА _СЧАДляРезервовПИФ.ДатаСЧА
		|				ИНАЧЕ _СЧАДляРезервовПИФ.Дата
		|			КОНЕЦ = _НачисленныеРезервыВознаграждениеУправляющего.Период)
		|			И (_СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета)
		|			И (_НачисленныеРезервыВознаграждениеУправляющего.Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленныеРезервы КАК _НачисленныеРезервыВознагражденияПрочие
		|		ПО (ВЫБОР
		|				КОГДА _ПИФДоверительногоУправления.ТипПИФ = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
		|					ТОГДА _СЧАДляРезервовПИФ.ДатаСЧА
		|				ИНАЧЕ _СЧАДляРезервовПИФ.Дата
		|			КОНЕЦ = _НачисленныеРезервыВознагражденияПрочие.Период)
		|			И (_СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета)
		|			И (_НачисленныеРезервыВознагражденияПрочие.Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ДатаРасчета, ) КАК УсловияПравилПИФСрезПоследних
		|		ПО (_ПИФДоверительногоУправления.Клиент = УсловияПравилПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	(_СЧАДляРезервовПИФ.СЧА ЕСТЬ NULL
		|			ИЛИ УсловияПравилПИФСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		|				И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаЗаключения
		|				И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета
		|				И _НачисленныеРезервыВознаграждениеУправляющего.СуммаПриход ЕСТЬ NULL
		|				И НЕ &ДатаОснованияДляПрекращенияПИФПрошла
		|			ИЛИ УсловияПравилПИФСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария
		|				И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаЗаключения
		|				И _СЧАДляРезервовПИФ.ДатаСЧА >= &ДатаНачалаРасчета
		|				И _НачисленныеРезервыВознагражденияПрочие.СуммаПриход ЕСТЬ NULL)
		|	И _СЧАДляРезервовПИФ.Дата >= &ДатаНачалаРасчета
		|	И _СЧАДляРезервовПИФ.Дата <= &ДатаРасчетаБез1Дня
		|	И &ДатаРасчетаБез1Дня <> &ДатаПрошлогоднегоСЧА";	
	
	ВыборкаКонтроль = Запрос.Выполнить().Выбрать();
	
	#Область Исключаемые_из_проверки_дни
	
	// С 01.03.2022 по 27.03.2022 СЧА не пересчитывали и резервы не начисляли (#422811, #Хардкод)
	
	// ОПИФ Атлант был приостановлен, период приостановки добавляем в исключаемые из проверки дни
	ПериодПриостановкиПИФ = Справочники.ПаевыеИнвестиционныеФонды.ПериодПриостановкиОперацийСПаями(Запрос.Параметры.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЕстьПериодПриостановкиПИФ", ПериодПриостановкиПИФ <> Неопределено);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеКалендаря.Дата КАК Дата
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|ГДЕ
		|	_ДанныеКалендаря.Дата МЕЖДУ ДАТАВРЕМЯ(2022, 3, 1) И ДАТАВРЕМЯ(2022, 3, 27)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеКалендаря.Дата
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|ГДЕ
		|	&ЕстьПериодПриостановкиПИФ";
	
	Если ПериодПриостановкиПИФ <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И _ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания"; 
		Запрос.УстановитьПараметр("ДатаНачала", 	ПериодПриостановкиПИФ.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", 	ПериодПриостановкиПИФ.ДатаОкончания);
	КонецЕсли;
	
	ДниБезНачислений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Дата");  			
	
	#КонецОбласти
		
	МассивОшибок = Новый Массив;
	Пока ВыборкаКонтроль.Следующий() Цикл
		
		Если ДниБезНачислений.Найти(ВыборкаКонтроль.Дата) <> Неопределено Тогда					
			Продолжить;                                                        					
		КонецЕсли;
		
		ТекстОшибки = "На дату " + Формат(ВыборкаКонтроль.Дата, "ДФ=dd.MM.yyyy") + " не найдено ";
		Если Не ЗначениеЗаполнено(ВыборкаКонтроль.СЧА) Тогда
			МассивОшибок.Добавить("значение СЧА");
		КонецЕсли; 
		Если ВыборкаКонтроль.ОтсутствуетРезервНаВознаграждениеУправляющего Тогда
			МассивОшибок.Добавить("начисление резерва на выплату вознаграждения УК");
		КонецЕсли; 
		Если ВыборкаКонтроль.ОтсутствуетРезервНаПрочиеВознаграждения Тогда
			МассивОшибок.Добавить("начисление резерва на выплату прочих вознаграждений");
		КонецЕсли; 
					
		ТекстОшибки = ТекстОшибки + СтрСоединить(МассивОшибок, ", ");
		
		ДобавитьОшибкуВМассив(ОшибкиРасчета, ТекстОшибки); 
		
		МассивОшибок.Очистить();
		
	КонецЦикла; 

КонецПроцедуры

Процедура ДобавитьОшибкуВМассив(ОшибкиРасчета, Ошибка)
	
	Если Не ЗначениеЗаполнено(Ошибка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОшибкиРасчета.Найти(Ошибка) = Неопределено Тогда
		ОшибкиРасчета.Добавить(Ошибка);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДатуПоследнегоНачисленияВознагражденияУправляющегоДляПИФ(Организация, СчетДоверительногоУправления, ДатаРасчета, ДатаОкончанияФормированияПИФ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(МАКСИМУМ(ЗадолженностиПоДенежнымСредствамОбороты.Период), &ДатаОкончанияФормированияПИФ) КАК ДатаВознагражденияУправляющего
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&ДатаОкончанияФормированияПИФ,
		|			&ДатаРасчета,
		|			День,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход > 0";
	    			
	Запрос.Параметры.Вставить("Организация", Организация);
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.Параметры.Вставить("ДатаРасчета", НачалоДня(ДатаРасчета));
	Запрос.Параметры.Вставить("ДатаОкончанияФормированияПИФ", ДатаОкончанияФормированияПИФ);
	  
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ДатаВознагражденияУправляющего;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция РассчитатьСоставляющуюНастройкиРасчетаВознаграждения(НастройкаРасчета, ПараметрыРасчета, Запрос, РасшифровкаРасчета)
	                                        
	Составляющие = НастройкаРасчета.Составляющие;
	
	МассивРезультатовРасчета	= Новый Массив;
	СуммаВознаграждения			= 0;
	
	ОсновнаяБазаРасчета					= Неопределено;
	ОсновнойРезультатРасчета			= Неопределено;
	ОсновныеТаблицыРасшифровкиРасчета	= Неопределено;
	
	ФиксированныеБазыРасчета	= Новый Массив;
	
	ФиксированныеБазыРасчета.Добавить(Справочники.БазыРасчета.ФиксированнаяСтавка);
	ФиксированныеБазыРасчета.Добавить(Справочники.БазыРасчета.ФиксированнаяСуммаВГод);
	ФиксированныеБазыРасчета.Добавить(Справочники.БазыРасчета.ФиксированнаяСуммаВДень);
	ФиксированныеБазыРасчета.Добавить(Справочники.БазыРасчета.ФиксированнаяСуммаВМесяц);
	
	Для Каждого СтрокаСоставляющей Из Составляющие Цикл
		
		ПараметрыРасчета.Вставить("БазаРасчета", СтрокаСоставляющей.БазаРасчета);
			
		ПараметрыРасчета.ДанныеДляРасчета[0].БазаРасчета			= ПараметрыРасчета.БазаРасчета;
		ПараметрыРасчета.ДанныеДляРасчета[0].НастройкаРасчета		= НастройкаРасчета;
		ПараметрыРасчета.ДанныеДляРасчета[0].ПараметрыБазыРасчета	= СтрокаСоставляющей.ПараметрыРасчета;
		ПараметрыРасчета.ДанныеДляРасчета[0].Представление			= СтрокаСоставляющей.Представление;
				
		РезультатРасчетаСоставляющей = РассчитатьВознаграждениеПоБазеРасчета(ПараметрыРасчета, Запрос.МенеджерВременныхТаблиц, РасшифровкаРасчета);
				
		СуммаВознаграждения = СуммаВознаграждения + РезультатРасчетаСоставляющей.Результат[0].СуммаВознаграждения;
		
		Если ОсновнаяБазаРасчета = Неопределено Тогда
			
			 ОсновнаяБазаРасчета				= СтрокаСоставляющей.БазаРасчета;
			 ОсновнойРезультатРасчета			= РезультатРасчетаСоставляющей.Результат;
			 ОсновныеТаблицыРасшифровкиРасчета	= РезультатРасчетаСоставляющей.ТаблицыРасшифровкиРасчета;
			 
		ИначеЕсли СтрокаСоставляющей.БазаРасчета <> ОсновнаяБазаРасчета
			И ФиксированныеБазыРасчета.Найти(СтрокаСоставляющей.БазаРасчета) = Неопределено И РезультатРасчетаСоставляющей.Результат[0].СуммаВознаграждения > 0 Тогда
			
			// Требуютсятся только данные по "сложной" базе, если их несколько
			ОсновнаяБазаРасчета					= СтрокаСоставляющей.БазаРасчета;
			ОсновнойРезультатРасчета			= РезультатРасчетаСоставляющей.Результат;
			ОсновныеТаблицыРасшифровкиРасчета	= РезультатРасчетаСоставляющей.ТаблицыРасшифровкиРасчета;
			
		ИначеЕсли СтрокаСоставляющей.БазаРасчета = ОсновнаяБазаРасчета
			И ФиксированныеБазыРасчета.Найти(СтрокаСоставляющей.БазаРасчета) = Неопределено И РезультатРасчетаСоставляющей.Результат[0].СуммаВознаграждения >= 0 Тогда
			
			// Дополним таблицу результата данными из текущей таблицы
			Для Каждого Колонка Из РезультатРасчетаСоставляющей.Результат.Колонки Цикл
				
				Если ОсновнойРезультатРасчета.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ОсновнойРезультатРасчета[0][Колонка.Имя]) Тогда
					ОсновнойРезультатРасчета[0][Колонка.Имя] = РезультатРасчетаСоставляющей.Результат[0][Колонка.Имя];
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("РезультатРасчета, БазаРасчета, СуммаВознаграждения, ТаблицыРасшифровкиРасчета", ОсновнойРезультатРасчета, ОсновнаяБазаРасчета, СуммаВознаграждения, ОсновныеТаблицыРасшифровкиРасчета);
	
КонецФункции

#КонецОбласти
