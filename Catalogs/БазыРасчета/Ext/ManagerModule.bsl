		КлючевыеПоляРасчета.Вставить("СЧАНаНачалоГодаРынок",									"не рассчитана СЧА на начало года (по рын. стоимости)");
		КлючевыеПоляРасчета.Вставить("СуммаУбыткаЗаПредыдущийГод",								"не рассчитана сумма убытка за предыдущий отчетный период" + ?(СуффиксСумм = "", " (расчет по рыночной стоимости не реализован)", ""));
		КлючевыеПоляРасчета.Вставить("СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария",	"не рассчитана сумма необходимых расходов и стоимость услуг спецдепозитария");
		КлючевыеПоляРасчета.Вставить("БазовыйДоход",											"не рассчитан доход по ставке базовой доходности");  
		
		ТаблицыРасшифровкиРасчета = Новый Структура("_ВводыАктивовСНачалаГодаРазвернуто, _ВводыАктивовСНачалаГодаРазвернутоБаланс, _ВыводыАктивовСНачалаГодаРазвернуто, _ЗначенияКБД");		
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто") <> Неопределено Тогда
			ТаблицыРасшифровкиРасчета.Вставить("_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто"); // Если добавили, значит, нужен
		КонецЕсли;
		
		#КонецОбласти
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИСреднедневнойБалансовойСтоимостиИмуществаНаходящегосяВРазмещении Тогда
		
		#Область От_инвестиционного_дохода_и_среднедневной_стоимости_имущества
		
