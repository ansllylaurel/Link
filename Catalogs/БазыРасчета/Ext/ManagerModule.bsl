		ТаблицыРасшифровкиРасчета = Новый Структура("_ВводыАктивовСНачалаГодаРазвернуто" + СуффиксСумм + ",_ВыводыАктивовСНачалаГодаРазвернуто");		
		
		Если РасшифровкаРасчетаВВалюте Тогда
			ДобавитьИсточникДанных(Запрос, "_КурсыВалют");
			ТаблицыРасшифровкиРасчета.Вставить("_КурсыВалют");
			ТаблицыРасшифровкиРасчета.Вставить("_СЧАНаНачалоГода" + СуффиксСумм);
		КонецЕсли;
		
		#КонецОбласти		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБД
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБДПоБалансу
	Тогда
		
		#Область От_инвестиционного_дохода_и_базового_дохода_по_значению_КБД
		
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.Представление КАК Представление,
			|	_Клиенты.ПараметрСреднееЗначениеКБД КАК СреднееЗначениеКБД,
			|	_Клиенты.ПараметрРасчетаСтавкаОтличиеОтКБД КАК СтавкаОтличиеОтКБД,
			|	_Клиенты.ПараметрРасчетаСтавкаМД КАК СтавкаМД,
			|	_Клиенты.ПараметрРасчетаСтавкаБД КАК СтавкаБД,
			|	_Клиенты.ПараметрРасчетаСтавкаПревышение КАК СтавкаПревышение,
			|	_ИнвестиционныйДоход.КорректироватьНаРазницуБалансаИРынка КАК КорректироватьНаРазницуБалансаИРынка,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод КАК УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуВознагражденияЗаУправление КАК УменьшатьНаСуммуВознагражденияЗаУправление,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария КАК УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_ИнвестиционныйДоход.СЧАНаКонецВВалютеРасчета КАК СЧАНаКонец,
			|	_ИнвестиционныйДоход.СЧАНаНачалоГодаВВалютеРасчета КАК СЧАНаНачалоГода,
			|	_ИнвестиционныйДоход.СЧАНаНачалоГодаРынокВВалютеРасчета КАК СЧАНаНачалоГодаРынок,
			|	_ИнвестиционныйДоход.ВводыАктивовСНачалаГодаВВалютеРасчета КАК ВводыАктивовСНачалаГода,
			|	_ИнвестиционныйДоход.ВыводыАктивовСНачалаГодаВВалютеРасчета КАК ВыводыАктивовСНачалаГода,
			|	_ИнвестиционныйДоход.НДФЛУплаченныйСНачалаГодаВВалютеРасчета КАК НДФЛУплаченныйСНачалаГода,
			|	_ИнвестиционныйДоход.СуммаДоКорректировкиВВалютеРасчета КАК ИнвестиционныйДоход,
			|	_ИнвестиционныйДоход.РазницаБалансаИРынкаВВалютеРасчета КАК РазницаБалансаИРынка,
			|	_ИнвестиционныйДоход.СуммаУбыткаЗаПредыдущийГодВВалютеРасчета КАК СуммаУбыткаЗаПредыдущийГод,
			|	_ИнвестиционныйДоход.СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитарияВВалютеРасчета КАК СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_ИнвестиционныйДоход.СуммаВВалютеРасчета КАК ИнвестиционныйДоходСкорректированный,
			|	_БазовыйДоход.СуммаВВалютеРасчета КАК БазовыйДоход,
			|	ВЫБОР
			|		КОГДА _БазовыйДоход.СуммаВВалютеРасчета ЕСТЬ NULL
			|				ИЛИ _ИнвестиционныйДоход.СуммаВВалютеРасчета ЕСТЬ NULL
			|			ТОГДА NULL
			|		КОГДА _ИнвестиционныйДоход.СуммаВВалютеРасчета > _БазовыйДоход.СуммаВВалютеРасчета
			|			ТОГДА _БазовыйДоход.СуммаВВалютеРасчета
