			|	_СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета КАК СреднедневнаяСтоимостьАктивов,
			|	_СреднедневнаяСтоимостьАктивов.КоличествоДней КАК КоличествоДнейУправленияАктивами,
			|	_ИнвестиционныйДоход.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаСтавкаИД / 100 КАК ОсновноеВознаграждение,
			|	ВЫБОР
			|		КОГДА _ИнвестиционныйДоход.СуммаВВалютеРасчета ЕСТЬ NULL
			|				ИЛИ _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета ЕСТЬ NULL
			|			ТОГДА NULL
			|		КОГДА _ИнвестиционныйДоход.СуммаВВалютеРасчета > _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаНижнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду
			|				И _ИнвестиционныйДоход.СуммаВВалютеРасчета <= _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаВерхнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду
			|			ТОГДА (_ИнвестиционныйДоход.СуммаВВалютеРасчета - _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаНижнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду) * _Клиенты.ПараметрРасчетаСтавкаРазницаИДиСНП / 100
			|		КОГДА _ИнвестиционныйДоход.СуммаВВалютеРасчета > _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаВерхнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду
			|			ТОГДА (_СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаВерхнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду - _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаНижнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду) * _Клиенты.ПараметрРасчетаСтавкаРазницаСВПиСНП / 100 + (_ИнвестиционныйДоход.СуммаВВалютеРасчета - _СреднедневнаяСтоимостьАктивов.СуммаВВалютеРасчета * _Клиенты.ПараметрРасчетаВерхнийПроцентОтСредней / 100 * _СреднедневнаяСтоимостьАктивов.КоличествоДней / _Клиенты.ДнейВГоду) * _Клиенты.ПараметрРасчетаСтавкаРазницаИДиСВП / 100
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ДополнительноеВознаграждение,
			|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК КурсВалютыРасчетаКВалютеУчета
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныйДоход КАК _ИнвестиционныйДоход
			|		ПО (_ИнвестиционныйДоход.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СреднедневнаяСтоимостьАктивов КАК _СреднедневнаяСтоимостьАктивов
			|		ПО (_СреднедневнаяСтоимостьАктивов.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	_БазыРасчета.СтавкаИД КАК СтавкаИД,
			|	_БазыРасчета.НижнийПроцентОтСредней КАК НижнийПроцентОтСредней,
			|	_БазыРасчета.ВерхнийПроцентОтСредней КАК ВерхнийПроцентОтСредней,
			|	_БазыРасчета.СтавкаРазницаИДиСНП КАК СтавкаРазницаИДиСНП,
			|	_БазыРасчета.СтавкаРазницаСВПиСНП КАК СтавкаРазницаСВПиСНП,
			|	_БазыРасчета.СтавкаРазницаИДиСВП КАК СтавкаРазницаИДиСВП,
			|	_БазыРасчета.СЧАНаКонец КАК СЧАНаКонец,
			|	_БазыРасчета.НДФЛУплаченныйСНачалаГода КАК НДФЛУплаченныйСНачалаГода,
			|	_БазыРасчета.СЧАНаНачалоГода КАК СЧАНаНачалоГода,
			|	_БазыРасчета.СреднедневнаяСтоимостьАктивов КАК СреднедневнаяСтоимостьАктивов,
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА _БазыРасчета.ОсновноеВознаграждение ЕСТЬ NULL
			|					ИЛИ _БазыРасчета.ДополнительноеВознаграждение ЕСТЬ NULL
			|				ТОГДА NULL
			|			ИНАЧЕ (ВЫРАЗИТЬ(_БазыРасчета.ОсновноеВознаграждение КАК ЧИСЛО(1, 1))) + (ВЫРАЗИТЬ(_БазыРасчета.ДополнительноеВознаграждение КАК ЧИСЛО(1, 1)))
			|		КОНЕЦ * _БазыРасчета.КурсВалютыРасчетаКВалютеУчета КАК ЧИСЛО(1, 1)) КАК СуммаВознаграждения,
			|	ИСТИНА КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";

		СуффиксСумм = "Баланс"; 
		
		Если СуффиксСумм = "Баланс" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ИнвестиционныйДоход",			"_ИнвестиционныйДоходБаланс");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_СреднедневнаяСтоимостьАктивов",	"_СреднедневнаяСтоимостьАктивовБаланс");
		КонецЕсли;			
			
		ДобавитьИсточникДанных(Запрос, "_ИнвестиционныйДоход" + СуффиксСумм);
		ДобавитьИсточникДанных(Запрос, "_СреднедневнаяСтоимостьАктивов" + СуффиксСумм);
		
		КлючевыеПоляРасчета = Новый Структура("СтавкаИД, НижнийПроцентОтСредней, ВерхнийПроцентОтСредней, СтавкаРазницаИДиСНП, СтавкаРазницаСВПиСНП, СтавкаРазницаИДиСВП, СЧАНаКонец, СЧАНаНачалоГода, БазовыйДоход",
			"не указана ставка основного вознаграждения",
			"не указана нижний процент от среднедневной стоимости активов",
			"не указана верхний процент от среднедневной стоимости активов",
			"не указана ставка превышения ИД над доходом по проценту от среднедневной стоимости активов",
			"не указана ставка разницы доходов по процентам от среднедневной стоимости активов",
			"не указана ставка превышения ИД над доходом по проценту от среднедневной стоимости активов",
			"не рассчитана СЧА на конец расчетного периода",
			"не рассчитана СЧА на начало года",
			"не рассчитан доход по ставке базовой доходности");  
		ТаблицыРасшифровкиРасчета = Новый Структура("_ВводыАктивовСНачалаГодаРазвернуто" + СуффиксСумм + ",_ВыводыАктивовСНачалаГодаРазвернуто");		
		
		#КонецОбласти		
		
	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходом
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходомПоБалансу
	Тогда
		
		#Область Превышение_над_минимальным_и_гарантированным_доходом
		
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.Представление КАК Представление,
			|	&ИсключатьДеньПриемаПередачиАктивовИзУправления КАК ИсключатьДеньПриемаПередачиАктивовИзУправления,
			|	ВЫБОР
			|		КОГДА _Клиенты.ПараметрРасчетаСтавкаПревышение = 0
			|			ТОГДА NULL
			|		ИНАЧЕ _Клиенты.ПараметрРасчетаСтавкаПревышение
			|	КОНЕЦ КАК СтавкаПревышение,
			|	ВЫБОР
			|		КОГДА &РасчетПревышенияНадМинимальнымДоходом
			|				И &ПараметрРасчетаСтавкаМД = 0
			|			ТОГДА NULL
			|		ИНАЧЕ &ПараметрРасчетаСтавкаМД
			|	КОНЕЦ КАК СтавкаМД,
			|	ВЫБОР
			|		КОГДА НЕ &РасчетПревышенияНадМинимальнымДоходом
			|				И _Клиенты.ПараметрРасчетаСтавкаГД = 0
			|			ТОГДА NULL
			|		ИНАЧЕ _Клиенты.ПараметрРасчетаСтавкаГД
			|	КОНЕЦ КАК СтавкаГД,
			|	_ИнвестиционныйДоход.СЧАНаКонецВВалютеРасчета КАК СЧАНаКонец,
			|	_ИнвестиционныйДоход.СЧАНаНачалоГодаВВалютеРасчета КАК СЧАНаНачалоГода,
			|	_ИнвестиционныйДоход.НДФЛУплаченныйСНачалаГодаВВалютеРасчета КАК НДФЛУплаченныйСНачалаГода,
			|	_ИнвестиционныйДоход.СуммаВВалютеРасчета КАК ИнвестиционныйДоход,
			|	(ЕСТЬNULL(_ВводыАктивовСНачалаГода.ПроизведениеСуммИДнейДоРасчетаВВалютеРасчета, 0) - ЕСТЬNULL(_ВыводыАктивовСНачалаГода.ПроизведениеСуммИДнейДоРасчетаВВалютеРасчетаРынок, 0)) / _Клиенты.ДнейВГоду * &ПараметрРасчетаСтавкаМД / 100 КАК МинимальныйДоход,
			|	(ЕСТЬNULL(_ВводыАктивовСНачалаГода.ПроизведениеСуммИДнейДоРасчетаВВалютеРасчета, 0) - ЕСТЬNULL(_ВыводыАктивовСНачалаГода.ПроизведениеСуммИДнейДоРасчетаВВалютеРасчетаРынок, 0)) / _Клиенты.ДнейВГоду * _Клиенты.ПараметрРасчетаСтавкаГД / 100 КАК ГарантированныйДоход,
			|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК КурсВалютыРасчетаКВалютеУчета
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныйДоход КАК _ИнвестиционныйДоход
			|		ПО (_ИнвестиционныйДоход.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыАктивовСНачалаГода КАК _ВводыАктивовСНачалаГода
			|		ПО (_ВводыАктивовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ВыводыАктивовСНачалаГода КАК _ВыводыАктивовСНачалаГода
			|		ПО (_ВыводыАктивовСНачалаГода.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	_БазыРасчета.ИсключатьДеньПриемаПередачиАктивовИзУправления КАК ИсключатьДеньПриемаПередачиАктивовИзУправления,
			|	_БазыРасчета.СтавкаМД КАК СтавкаМД,
			|	_БазыРасчета.СтавкаГД КАК СтавкаГД,
			|	_БазыРасчета.СтавкаПревышение КАК СтавкаПревышение,
			|	_БазыРасчета.СЧАНаКонец КАК СЧАНаКонец,
			|	_БазыРасчета.СЧАНаНачалоГода КАК СЧАНаНачалоГода,
			|	_БазыРасчета.НДФЛУплаченныйСНачалаГода КАК НДФЛУплаченныйСНачалаГода,
			|	_БазыРасчета.МинимальныйДоход КАК МинимальныйДоход,
			|	_БазыРасчета.ГарантированныйДоход КАК ГарантированныйДоход,
			|	_БазыРасчета.ИнвестиционныйДоход КАК ИнвестиционныйДоход,
			|	ВЫБОР
			|		КОГДА &РасчетПревышенияНадМинимальнымДоходом
			|			ТОГДА _БазыРасчета.ИнвестиционныйДоход - _БазыРасчета.МинимальныйДоход
			|		ИНАЧЕ _БазыРасчета.ИнвестиционныйДоход - _БазыРасчета.ГарантированныйДоход
			|	КОНЕЦ * _БазыРасчета.СтавкаПревышение / 100 КАК РассчитаннаяСумма,
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА _БазыРасчета.СтавкаПревышение ЕСТЬ NULL
			|					ИЛИ _БазыРасчета.СтавкаМД ЕСТЬ NULL
			|					ИЛИ _БазыРасчета.СтавкаГД ЕСТЬ NULL
			|				ТОГДА NULL
			|			КОГДА _БазыРасчета.ИнвестиционныйДоход < _БазыРасчета.ГарантированныйДоход
			|					ИЛИ _БазыРасчета.ИнвестиционныйДоход < _БазыРасчета.МинимальныйДоход
			|					ИЛИ _БазыРасчета.ИнвестиционныйДоход < 0
			|				ТОГДА 0
			|			ИНАЧЕ ВЫРАЗИТЬ(ВЫБОР
			|						КОГДА &РасчетПревышенияНадМинимальнымДоходом
			|							ТОГДА _БазыРасчета.ИнвестиционныйДоход - _БазыРасчета.МинимальныйДоход
			|						ИНАЧЕ _БазыРасчета.ИнвестиционныйДоход - _БазыРасчета.ГарантированныйДоход
			|					КОНЕЦ * _БазыРасчета.СтавкаПревышение / 100 КАК ЧИСЛО(1, 1))
			|		КОНЕЦ * _БазыРасчета.КурсВалютыРасчетаКВалютеУчета КАК ЧИСЛО(1, 1)) КАК СуммаВознаграждения,
			|	ИСТИНА КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";
		
		СуффиксСумм = "";
		
		Если БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадГарантированнымДоходомПоБалансу 
		Тогда
			СуффиксСумм = "Баланс"; 
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ИнвестиционныйДоход",	 "_ИнвестиционныйДоход" + СуффиксСумм);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ВводыАктивовСНачалаГода", "_ВводыАктивовСНачалаГода" + СуффиксСумм);
		
		Если БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходомПоБалансу
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ПревышениеНадМинимальнымДоходом_СЧАНаКонецПоБалансу
		Тогда
		    СтавкаПревышения	= "процент от превышения ИД над минимальным доходом";
			ТекстЗапроса		= СтрЗаменить(ТекстЗапроса, "&РасчетПревышенияНадМинимальнымДоходом",			"ИСТИНА");
			ТекстЗапроса		= СтрЗаменить(ТекстЗапроса, "&ПараметрРасчетаСтавкаМД",							"_Клиенты.ПараметрРасчетаСтавкаМД");
			ТекстЗапроса		= СтрЗаменить(ТекстЗапроса, "&ИсключатьДеньПриемаПередачиАктивовИзУправления",	"_Клиенты.ПараметрРасчетаИсключатьДеньПриемаПередачиАктивовИзУправления");
		Иначе
		    СтавкаПревышения	= "процент от превышения ИД над гарантированным доходом";
			ТекстЗапроса		= СтрЗаменить(ТекстЗапроса, "&РасчетПревышенияНадМинимальнымДоходом",			"ЛОЖЬ");
