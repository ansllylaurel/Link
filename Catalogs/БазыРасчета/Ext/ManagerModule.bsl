			|		_ДанныеКалендаря КАК _ДанныеКалендаря
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|			ПО (_ДанныеКалендаря.Дата <= &ДатаРасчета)
			|				И _ДанныеКалендаря.Дата >= КлиентыДоверительногоУправления.Период
			|				И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.Организация = &Организация)
			|				И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда))
			|				И (КлиентыДоверительногоУправления.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|	ГДЕ
			|		_ДанныеКалендаря.Дата <= &ДатаРасчета
			|		И _ДанныеКалендаря.Дата >= &ДатаНачалаРасчета
			|	
			|	СГРУППИРОВАТЬ ПО
			|		_ДанныеКалендаря.Дата,
			|		КлиентыДоверительногоУправления.СчетДоверительногоУправления) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
			|		ПО (КлиентыДоверительногоУправления.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И ВложенныйЗапрос.КлиентыДоверительногоУправленияПериод = КлиентыДоверительногоУправления.Период
			|			И ВложенныйЗапрос.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
			|			И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.Организация = &Организация)
			|			И (КлиентыДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда))
			|";
		
		#КонецОбласти
		
	ИначеЕсли  СтрНачинаетсяС(ИмяИсточника, "_НачисленныеРезервыПИФ") Тогда
				
		#Область _НачисленныеРезервыПИФЗаПериод
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РезервыЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СУММА(РезервыЗаПериод.СуммаПриход) КАК СуммаРезерваНачисленная
			|ПОМЕСТИТЬ _НачисленныеРезервыПИФЗаВознаграждениеУправляющего
			|ИЗ
			|	РегистрНакопления.РезервыПИФ.Обороты(
			|			&ДатаНачалаРасчетаРезервов,
			|			КОНЕЦПЕРИОДА(&ДатаОстатковРезервов, ДЕНЬ),
			|			Регистратор,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)
			|				И Валюта = &ВалютаУчета) КАК РезервыЗаПериод
			|ГДЕ
			|	РезервыЗаПериод.Регистратор <> &ДокументРезервов
			|
			|СГРУППИРОВАТЬ ПО
			|	РезервыЗаПериод.СчетДоверительногоУправления";
			
		Если СтрНайти(ИмяИсточника, "ЗаГод") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДатаНачалаРасчетаРезервов", "&ДатаНачалаРасчета");
		ИначеЕсли СтрНайти(ИмяИсточника, "ЗаМесяц") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДатаНачалаРасчетаРезервов", "НАЧАЛОПЕРИОДА(&ДатаРасчета, МЕСЯЦ)");
		КонецЕсли;	
		
		Если СтрЗаканчиваетсяНа(ИмяИсточника, "ПоПредыдущуюДатуРезерваВознагражденияУправляющего") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДатаОстатковРезервов", "&ПредыдущаяДатаРезерваВознагражденияУправляющего");
		ИначеЕсли СтрЗаканчиваетсяНа(ИмяИсточника, "ПоПредыдущуюДатуСЧА") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ДатаОстатковРезервов", "&ДатаНачисленныхРанееРезервов");
		КонецЕсли;
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НачисленныеРезервыПИФЗаВознаграждениеУправляющего", ИмяИсточника);
		
		Если СтрНайти(ИмяИсточника, "ЗаВознаграждениеДепозитария") <> 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)", "ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика)");
		ИначеЕсли СтрНайти(ИмяИсточника, "ЗаПрочиеВозмещаемыеРасходыУправляющего") <> 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)", "ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего)");
		КонецЕсли;
		
		#КонецОбласти
			
	Иначе
		
		ВызватьИсключение "Неизвестный источник данных '" + ИмяИсточника + "'";
		
	КонецЕсли;
	
	// Выполняем запрос для получения данных источника
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КАК ЧИСЛО(1, 1)", СтрШаблон("КАК ЧИСЛО(%1, %2)",
			Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.Разрядность,
			Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти));			
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.Выполнить();
		
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьВознаграждениеПоБазеРасчета(ПараметрыРасчета, МенеджерВременныхТаблиц = Неопределено, РасшифровкаРасчета = Неопределено) Экспорт

	БазаРасчета = ПараметрыРасчета.БазаРасчета;
		
	// Выполняем расчет
	
	Запрос = Новый Запрос;
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;	
		ИсходныеВременныеТаблицы	   = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",				ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("ДатаРасчета",				КонецДня(ПараметрыРасчета.ДатаРасчета));
	Запрос.УстановитьПараметр("ДанныеДляРасчета",			ПараметрыРасчета.ДанныеДляРасчета);
	Запрос.УстановитьПараметр("БазаРасчета",				ПараметрыРасчета.БазаРасчета);
	Запрос.УстановитьПараметр("РассчитанноеВознаграждение",	ПараметрыРасчета.РассчитанноеВознаграждение);
	
	#Область Помещаем_параметры_расчета_в_ВТ
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПараметрРасчета КАК ПараметрРасчета,
		|	ДанныеДляРасчета.Организация КАК Организация,
		|	ДанныеДляРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДанныеДляРасчета.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ДанныеДляРасчета.Представление КАК Представление,
		|	ДанныеДляРасчета.НачалоРасчетногоПериода КАК НачалоРасчетногоПериода,
		|	ДанныеДляРасчета.КонецРасчетногоПериода КАК КонецРасчетногоПериода,
		|	ДанныеДляРасчета.НачалоБазовогоПериода КАК НачалоБазовогоПериода,
		|	ДанныеДляРасчета.КонецБазовогоПериода КАК КонецБазовогоПериода,			
		|	ДанныеДляРасчета.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
		|	ДанныеДляРасчета.КонецПериодаНачисления КАК КонецПериодаНачисления,
		|	ДанныеДляРасчета.ДоговорЗаключенДоТекущегоГода КАК ДоговорЗаключенДоТекущегоГода,
		|	ДанныеДляРасчета.ДатаПервогоВвода КАК ДатаПервогоВвода,
		|	ДанныеДляРасчета.КонецПредыдущегоГода КАК КонецПредыдущегоГода,
		|	ДанныеДляРасчета.НачалоГода КАК НачалоГода,
		|	ДанныеДляРасчета.ДнейВГоду КАК ДнейВГоду,
		|	ДанныеДляРасчета.КоличествоДнейПериодаРасчета КАК КоличествоДнейПериодаРасчета,
		|	ДанныеДляРасчета.ВалютаУчета КАК ВалютаУчета,
		|	ДанныеДляРасчета.ВалютаРасчета КАК ВалютаРасчета
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	&ДанныеДляРасчета КАК ДанныеДляРасчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления";
	
	// Получаем параметры расчета по базе
	
	РеквизитыБазыРасчета		= ПолучитьРеквизитыБазРасчета(БазаРасчета);
	ПараметрыБазыРасчетаСтрокой	= "";
	
	Для Каждого Реквизит Из РеквизитыБазыРасчета Цикл   
		
		Если ПараметрыРасчета.ДанныеДляРасчета.Колонки.Найти(Реквизит.Имя) = Неопределено Тогда
			ПараметрыРасчета.ДанныеДляРасчета.Колонки.Добавить(Реквизит.Имя, Реквизит.ТипЗначения);
		КонецЕсли;
		
		ПараметрыБазыРасчетаСтрокой = ПараметрыБазыРасчетаСтрокой + ?(ПустаяСтрока(ПараметрыБазыРасчетаСтрокой), "", Символы.ПС + "	") + СтрШаблон("ДанныеДляРасчета.%1 КАК %1,", Реквизит.Имя);
		
	КонецЦикла;
	
	Для Каждого ПараметрРасчета Из ПараметрыРасчета.ДанныеДляРасчета Цикл
		ЗаполнитьЗначенияСвойств(ПараметрРасчета, ПараметрРасчета.ПараметрыБазыРасчета.Получить());
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПараметрРасчета КАК ПараметрРасчета,", ПараметрыБазыРасчетаСтрокой);

	Запрос.Выполнить();
	
	#КонецОбласти	
	
	#Область Определяем_требуется_ли_расшифровка_расчета_в_валюте
	
	РасшифровкаРасчетаВВалюте = Ложь;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА ИЗ _Клиенты ГДЕ _Клиенты.ВалютаРасчета <> _Клиенты.ВалютаУчета";
		
		РасшифровкаРасчетаВВалюте = Не Запрос.Выполнить().Пустой();  
		
	КонецЕсли;
	
	#КонецОбласти
	
	КлючевыеПоляРасчета			= Новый Структура;
	ТаблицыРасшифровкиРасчета	= Новый Структура;
	
	Если БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход
		ИЛИ БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоходПоБалансу 		
	Тогда
		
		#Область Инвестиционный_доход
		
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.Представление КАК Представление,
			|	_Клиенты.ПараметрРасчетаСтавка КАК Ставка,
			|	_ИнвестиционныйДоход.КорректироватьНаРазницуБалансаИРынка КАК КорректироватьНаРазницуБалансаИРынка,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод КАК УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуВознагражденияЗаУправление КАК УменьшатьНаСуммуВознагражденияЗаУправление,
			|	_ИнвестиционныйДоход.УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария КАК УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_ИнвестиционныйДоход.КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций КАК КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций,
			|	_ИнвестиционныйДоход.СЧАНаКонецВВалютеРасчета КАК СЧАНаКонец,
			|	_ИнвестиционныйДоход.СЧАНаНачалоГодаВВалютеРасчета КАК СЧАНаНачалоГода,
			|	_ИнвестиционныйДоход.СЧАНаНачалоГодаРынокВВалютеРасчета КАК СЧАНаНачалоГодаРынок,
			|	_ИнвестиционныйДоход.ВводыАктивовСНачалаГодаВВалютеРасчета КАК ВводыАктивовСНачалаГода,
			|	_ИнвестиционныйДоход.ВыводыАктивовСНачалаГодаВВалютеРасчета КАК ВыводыАктивовСНачалаГода,
			|	_ИнвестиционныйДоход.НДФЛУплаченныйСНачалаГодаВВалютеРасчета КАК НДФЛУплаченныйСНачалаГода,
			|	_ИнвестиционныйДоход.СуммаДоКорректировкиВВалютеРасчета КАК ИнвестиционныйДоход,
			|	_ИнвестиционныйДоход.РазницаБалансаИРынкаВВалютеРасчета КАК РазницаБалансаИРынка,
			|	_ИнвестиционныйДоход.СуммаУбыткаЗаПредыдущийГодВВалютеРасчета КАК СуммаУбыткаЗаПредыдущийГод,
			|	_ИнвестиционныйДоход.СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитарияВВалютеРасчета КАК СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_ИнвестиционныйДоход.СуммаВВалютеРасчета КАК ИнвестиционныйДоходСкорректированный,
			|	_ИнвестиционныйДоход.ПоправочныйКоэффициентКСтавкеВознаграждения КАК ПоправочныйКоэффициентКСтавкеВознаграждения,
			|	_ИнвестиционныйДоход.ДоходностьУправления КАК ДоходностьУправления,
			|	_ИнвестиционныйДоход.ПриростИндекса КАК ПриростИндекса,
			|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК КурсВалютыРасчетаКВалютеУчета
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныйДоходСкорректированный КАК _ИнвестиционныйДоход
			|		ПО (_ИнвестиционныйДоход.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	_БазыРасчета.Ставка КАК Ставка,
			|	_БазыРасчета.КорректироватьНаРазницуБалансаИРынка КАК КорректироватьНаРазницуБалансаИРынка,
			|	_БазыРасчета.УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод КАК УменьшатьНаСуммуУбыткаЗаПредыдущийОтчетныйПериод,
			|	_БазыРасчета.УменьшатьНаСуммуВознагражденияЗаУправление КАК УменьшатьНаСуммуВознагражденияЗаУправление,
			|	_БазыРасчета.УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария КАК УменьшатьНаСуммуНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_БазыРасчета.КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций КАК КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций,
			|	_БазыРасчета.СЧАНаКонец КАК СЧАНаКонец,
			|	_БазыРасчета.СЧАНаНачалоГода КАК СЧАНаНачалоГода,
			|	_БазыРасчета.СЧАНаНачалоГодаРынок КАК СЧАНаНачалоГодаРынок,
			|	_БазыРасчета.ВводыАктивовСНачалаГода КАК ВводыАктивовСНачалаГода,
			|	_БазыРасчета.ВыводыАктивовСНачалаГода КАК ВыводыАктивовСНачалаГода,
			|	_БазыРасчета.НДФЛУплаченныйСНачалаГода КАК НДФЛУплаченныйСНачалаГода,
			|	_БазыРасчета.ИнвестиционныйДоход КАК ИнвестиционныйДоход,
			|	_БазыРасчета.РазницаБалансаИРынка КАК РазницаБалансаИРынка,
			|	_БазыРасчета.СуммаУбыткаЗаПредыдущийГод КАК СуммаУбыткаЗаПредыдущийГод,
			|	_БазыРасчета.СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария КАК СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария,
			|	_БазыРасчета.ИнвестиционныйДоходСкорректированный КАК ИнвестиционныйДоходСкорректированный,
			|	_БазыРасчета.ПоправочныйКоэффициентКСтавкеВознаграждения КАК ПоправочныйКоэффициентКСтавкеВознаграждения,
			|	_БазыРасчета.ДоходностьУправления КАК ДоходностьУправления,
			|	_БазыРасчета.ПриростИндекса КАК ПриростИндекса,
			|	_БазыРасчета.ИнвестиционныйДоходСкорректированный * (ВЫРАЗИТЬ(_БазыРасчета.Ставка * ВЫБОР
			|			КОГДА _БазыРасчета.КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|				ТОГДА _БазыРасчета.ПоправочныйКоэффициентКСтавкеВознаграждения
			|			ИНАЧЕ 1
			|		КОНЕЦ КАК ЧИСЛО(10, 2))) / 100 КАК РассчитаннаяСумма,
			|	ВЫБОР
			|		КОГДА _БазыРасчета.КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|			ТОГДА ВЫРАЗИТЬ(_БазыРасчета.Ставка * _БазыРасчета.ПоправочныйКоэффициентКСтавкеВознаграждения КАК ЧИСЛО(10, 2))
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СтавкаДополнительногоВознаграждения,
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА _БазыРасчета.ИнвестиционныйДоходСкорректированный < 0
			|				ТОГДА 0
			|			ИНАЧЕ ВЫРАЗИТЬ(_БазыРасчета.ИнвестиционныйДоходСкорректированный * (ВЫРАЗИТЬ(_БазыРасчета.Ставка * ВЫБОР
			|							КОГДА _БазыРасчета.КорректироватьСтавкуНаПоправочныйКоэффициентОтДоходностиИИндексаОблигаций
			|								ТОГДА _БазыРасчета.ПоправочныйКоэффициентКСтавкеВознаграждения
			|							ИНАЧЕ 1
			|						КОНЕЦ КАК ЧИСЛО(10, 2))) / 100 КАК ЧИСЛО(1, 1))
			|		КОНЕЦ * _БазыРасчета.КурсВалютыРасчетаКВалютеУчета КАК ЧИСЛО(1, 1)) КАК СуммаВознаграждения,
			|	ИСТИНА КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";
		
		Если БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход Тогда
			СуффиксСумм		= "";
		Иначе
			СуффиксСумм		= "Баланс"; 
			ТекстЗапроса	= СтрЗаменить(ТекстЗапроса, "_ИнвестиционныйДоходСкорректированный", "_ИнвестиционныйДоходСкорректированныйБаланс");
		КонецЕсли;
		
		ДобавитьИсточникДанных(Запрос, "_ИнвестиционныйДоходСкорректированный" + СуффиксСумм);
		
		КлючевыеПоляРасчета.Вставить("Ставка",													"не указана ставка ИД");
		КлючевыеПоляРасчета.Вставить("СЧАНаКонец",												"не рассчитана СЧА на конец расчетного периода");
		КлючевыеПоляРасчета.Вставить("СЧАНаНачалоГода",											"не рассчитана СЧА на начало года");
		КлючевыеПоляРасчета.Вставить("СЧАНаНачалоГодаРынок",									"не рассчитана СЧА на начало года (по рын. стоимости)");
		КлючевыеПоляРасчета.Вставить("СуммаУбыткаЗаПредыдущийГод",								"не рассчитана сумма убытка за предыдущий отчетный период" + ?(СуффиксСумм = "", " (расчет по рыночной стоимости не реализован)", ""));
		КлючевыеПоляРасчета.Вставить("СуммаНеобходимыхРасходовИСтоимостьУслугСпецдепозитария",	"не рассчитана сумма необходимых расходов и стоимость услуг спецдепозитария");

		ТаблицыРасшифровкиРасчета = Новый Структура("_ВводыАктивовСНачалаГодаРазвернуто, _ВводыАктивовСНачалаГодаРазвернутоБаланс, _ВыводыАктивовСНачалаГодаРазвернуто");		
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто") <> Неопределено Тогда
			ТаблицыРасшифровкиРасчета.Вставить("_НеобходимыеРасходыИСтоимостьУслугСпецдепозитарияСНачалаГодаРазвернуто"); // Если добавили, значит, нужен
		КонецЕсли;
		
		Если РасшифровкаРасчетаВВалюте Тогда
			ДобавитьИсточникДанных(Запрос, "_КурсыВалют");
			ТаблицыРасшифровкиРасчета.Вставить("_КурсыВалют");
		КонецЕсли;
		
		ТаблицыРасшифровкиРасчета.Вставить("_СЧАНаНачалоГода");
		ТаблицыРасшифровкиРасчета.Вставить("_ВознаграждениеУплаченноеСНачалаГодаРазвернуто");
		ТаблицыРасшифровкиРасчета.Вставить("_НДФЛУплаченныйСНачалаГодаРазвернуто");
		
		#КонецОбласти

	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВГод Тогда
		
		#Область Фиксированная_сумма_в_год
		
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.Представление КАК Представление,
			|	ВЫРАЗИТЬ(_Клиенты.ПараметрРасчетаСумма КАК ЧИСЛО(1, 1)) КАК СуммаВГод,
			|	_Клиенты.ДнейВГоду КАК ДнейВГоду,
			|	_Клиенты.НачалоРасчетногоПериода КАК НачалоРасчетногоПериода,
			|	_Клиенты.КонецРасчетногоПериода КАК КонецРасчетногоПериода,
			|	_Клиенты.КоличествоДнейПериодаРасчета КАК КоличествоДнейПериодаРасчета,
			|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК КурсВалютыРасчетаКВалютеУчета
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	_БазыРасчета.СуммаВГод КАК СуммаВГод,
			|	_БазыРасчета.НачалоРасчетногоПериода КАК НачалоРасчетногоПериода,
			|	_БазыРасчета.КонецРасчетногоПериода КАК КонецРасчетногоПериода,
			|	_БазыРасчета.КоличествоДнейПериодаРасчета КАК КоличествоДнейПериодаРасчета,
			|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(_БазыРасчета.СуммаВГод * _БазыРасчета.КоличествоДнейПериодаРасчета / _БазыРасчета.ДнейВГоду КАК ЧИСЛО(1, 1))) * _БазыРасчета.КурсВалютыРасчетаКВалютеУчета КАК ЧИСЛО(1, 1)) КАК СуммаВознаграждения,
			|	ИСТИНА КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";
				
		КлючевыеПоляРасчета			= Новый Структура("СуммаВГод", "не указана сумма в год");  		
		ТаблицыРасшифровкиРасчета	= Новый Структура;
		
		#КонецОбласти

	ИначеЕсли БазаРасчета = Справочники.БазыРасчета.ФиксированнаяСуммаВМесяц Тогда
		
		#Область Фиксированная_сумма_в_месяц
		
		ТекстЗапроса =  
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) КАК Месяц,
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ), КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ), ДЕНЬ) + 1 КАК ДнейВМесяце,
			|	ВЫБОР
			|		КОГДА МИНИМУМ(ДанныеКалендаря.Дата) = _Клиенты.ДатаПервогоВвода
			|			ТОГДА ДОБАВИТЬКДАТЕ(МИНИМУМ(ДанныеКалендаря.Дата), ДЕНЬ, 1)
			|		ИНАЧЕ МИНИМУМ(ДанныеКалендаря.Дата)
			|	КОНЕЦ КАК НачалоУправления,
			|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ОкончаниеУправления,
			|	ВЫБОР
			|		КОГДА МИНИМУМ(ДанныеКалендаря.Дата) = _Клиенты.ДатаПервогоВвода
			|			ТОГДА РАЗНОСТЬДАТ(МИНИМУМ(ДанныеКалендаря.Дата), МАКСИМУМ(ДанныеКалендаря.Дата), ДЕНЬ)
			|		ИНАЧЕ РАЗНОСТЬДАТ(МИНИМУМ(ДанныеКалендаря.Дата), МАКСИМУМ(ДанныеКалендаря.Дата), ДЕНЬ) + 1
			|	КОНЕЦ КАК ДнейВУправлении
			|ПОМЕСТИТЬ _МесяцыУправления
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|		ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
			|			И (ДанныеКалендаря.Дата МЕЖДУ _Клиенты.НачалоПериодаНачисления И _Клиенты.КонецПериодаНачисления)
			|
			|СГРУППИРОВАТЬ ПО
			|	_Клиенты.СчетДоверительногоУправления,
			|	_Клиенты.ДатаПервогоВвода,
			|	НАЧАЛОПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ),
			|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ), КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ), ДЕНЬ) + 1
			|
			|ИМЕЮЩИЕ
			|	ВЫБОР
			|		КОГДА МИНИМУМ(ДанныеКалендаря.Дата) = _Клиенты.ДатаПервогоВвода
			|			ТОГДА ДОБАВИТЬКДАТЕ(МИНИМУМ(ДанныеКалендаря.Дата), ДЕНЬ, 1)
			|		ИНАЧЕ МИНИМУМ(ДанныеКалендаря.Дата)
			|	КОНЕЦ <= МАКСИМУМ(ДанныеКалендаря.Дата)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.Представление КАК Представление,
			|	ВЫРАЗИТЬ(_Клиенты.ПараметрРасчетаСумма КАК ЧИСЛО(1, 1)) КАК СуммаВМесяц,
			|	_ПродолжительностьУправления.МесяцевВУправлении КАК МесяцевВУправлении,
			|	_Клиенты.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
			|	_Клиенты.КонецПериодаНачисления КАК КонецПериодаНачисления,
			|	КурсВалютыРасчета.Курс / КурсВалютыРасчета.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность КАК КурсВалютыРасчетаКВалютеУчета
			|ПОМЕСТИТЬ _БазыРасчета
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_МесяцыУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			СУММА(_МесяцыУправления.ДнейВУправлении / _МесяцыУправления.ДнейВМесяце) КАК МесяцевВУправлении
			|		ИЗ
			|			_МесяцыУправления КАК _МесяцыУправления
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_МесяцыУправления.СчетДоверительногоУправления) КАК _ПродолжительностьУправления
			|		ПО (_ПродолжительностьУправления.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
			|		ПО (КурсВалютыУчета.Валюта = _Клиенты.ВалютаУчета)
			|			И (КурсВалютыУчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_БазыРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_БазыРасчета.Представление КАК Представление,
			|	_БазыРасчета.СуммаВМесяц КАК СуммаВМесяц,
			|	_БазыРасчета.МесяцевВУправлении КАК МесяцевВУправлении,
			|	_БазыРасчета.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
			|	_БазыРасчета.КонецПериодаНачисления КАК КонецПериодаНачисления,
			|	ВЫРАЗИТЬ((ВЫРАЗИТЬ(_БазыРасчета.СуммаВМесяц * _БазыРасчета.МесяцевВУправлении КАК ЧИСЛО(1, 1))) * _БазыРасчета.КурсВалютыРасчетаКВалютеУчета КАК ЧИСЛО(1, 1)) КАК СуммаВознаграждения,
			|	ЛОЖЬ КАК НачисляетсяНарастающимИтогом
			|ИЗ
			|	_БазыРасчета КАК _БазыРасчета";
		
		КлючевыеПоляРасчета			= Новый Структура("СуммаВМесяц", "не указана сумма в месяц");  		
		ТаблицыРасшифровкиРасчета	= Новый Структура("_МесяцыУправления");
		
		#КонецОбласти
		
