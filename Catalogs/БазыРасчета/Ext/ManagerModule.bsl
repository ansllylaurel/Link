			|	_Клиенты.ВалютаУчета КАК Валюта,
			|	СЧА.Значение КАК Сумма,
			|	СЧА.Значение КАК СуммаВВалютеУчета,
			|	СЧА.Значение / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _СЧАНаНачалоГода
			|ИЗ
			|	_ДатыПоследнейНаКонецГодаСЧА КАК _ДатыПоследнейНаКонецГодаСЧА
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК СЧА
			|		ПО (СЧА.Организация = &Организация)
			|			И (СЧА.СубъектАналитики = _ДатыПоследнейНаКонецГодаСЧА.СчетДоверительногоУправления)
			|			И (СЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (СЧА.Период = _ДатыПоследнейНаКонецГодаСЧА.Дата)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
			|		ПО _Клиенты.СчетДоверительногоУправления = _ДатыПоследнейНаКонецГодаСЧА.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = _ДатыПоследнейНаКонецГодаСЧА.Дата)";
		
		ДобавитьИсточникДанных(Запрос, "_ДатыПоследнейНаКонецГодаСЧА");
		
		#КонецОбласти
		
	ИначеЕсли ИмяИсточника = "_СЧАНаКонецБаланс"
		ИЛИ ИмяИсточника = "_СЧАНаНачалоГодаБаланс"
	Тогда 
		
		#Область _СЧАНаКонецБаланс_СЧАНаНачалоГодаБаланс
		
		// СЧА по данным ЕПС
		//
		// Во временной таблице _Клиенты необходимы поля:
		//		- СчетДоверительногоУправления 	– СправочникСсылка.СчетаДоверительногоУправления;
		//		- Организация			 		– СправочникСсылка.Организации;
		//		- КонецРасчетногоПериода 		– дата, на которую нужно получить балансовую стоимость;
		//		- ВалютаУчета 					– СправочникСсылка.Валюты, валюта учета организации;
		//		- ВалютаРасчета 				– СправочникСсылка.Валюты, дополнительная валюта, в которой требуется рассчитать балансовую стоимость
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.ДатаОстатков КАК Дата,
			|	_Клиенты.ВалютаУчета КАК Валюта,
			|	ЕСТЬNULL(СЧАБаланс.Сумма, 0) КАК Сумма,
			|	ЕСТЬNULL(СЧАБаланс.Сумма, 0) КАК СуммаВВалютеУчета,
			|	ЕСТЬNULL(СЧАБаланс.Сумма / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность, 0) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _СЧАБаланс
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|				&ДатаОстатков,
			|				(Организация, СчетДоверительногоУправления) В
			|					(ВЫБРАТЬ
			|						_Клиенты.Организация,
			|						_Клиенты.СчетДоверительногоУправления
			|					ИЗ
			|						_Клиенты)) КАК НастройкиУчетаОбщие
			|		ПО (НастройкиУчетаОбщие.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет = ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток) КАК Сумма
			|		ИЗ
			|			РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|					&ДатаОстатков,
			|					Счет В
			|						(ВЫБРАТЬ
			|							ЕдиныйПланСчетов.Ссылка
			|						ИЗ
			|							ПланСчетов.Единый КАК ЕдиныйПланСчетов
			|						ГДЕ
			|							ЕдиныйПланСчетов.Код < ""700""
			|							И ПОДСТРОКА(ЕдиныйПланСчетов.Код, 1, 3) <> ""106""),
			|					,
			|					Организация = &Организация
			|						И СчетДоверительногоУправления В
			|							(ВЫБРАТЬ
			|								_Клиенты.СчетДоверительногоУправления
			|							ИЗ
			|								_Клиенты)) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ГДЕ
			|			(НЕ ЕдиныйБухгалтерскийУчетОстатки.Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ))
			|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего)))
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления) КАК СЧАБаланс
			|		ПО (СЧАБаланс.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.ДатаОстатков, ДЕНЬ))";
		
		Если ИмяИсточника = "_СЧАНаКонецБаланс" Тогда
			ИмяВТ					= "_СЧАНаКонецБаланс";
			ПолеДатыОстатков		= "КонецРасчетногоПериода";
			ПараметрДатыОстатков	= "КонецРасчетногоПериодаГраница";
			ВключаяДатуОстатков		= Истина;
		Иначе
			ИмяВТ					= "_СЧАНаНачалоГодаБаланс";
			ПолеДатыОстатков		= "НачалоГода";
			ПараметрДатыОстатков	= "НачалоГодаРасчетногоПериода";
			ВключаяДатуОстатков		= Ложь;
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ _СЧАБаланс", "ПОМЕСТИТЬ " + ИмяВТ);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_Клиенты.ДатаОстатков", "_Клиенты." + ПолеДатыОстатков);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаОстатков", "&" + ПараметрДатыОстатков);
		
		// Если у всех клиентов дата остатков одна и та же, то смело встраиваем в основой запрос.
		// В противном случае в цикле получаем остатки клиентов с одинаковой датой остатков,
		// объединяем их и передаем в основной запрос через параметр
		
		ВариантыПериодов = Запрос.Параметры.ДанныеДляРасчета.Скопировать(, "Организация, " + ПолеДатыОстатков);
		ВариантыПериодов.Свернуть("Организация, " + ПолеДатыОстатков);
		
		Если ВариантыПериодов.Количество() = 1 Тогда
			
			ЗначениеПериода = ВариантыПериодов[0][ПолеДатыОстатков]; 
			
			// Учтем переход на МСФО 9, остатки введены 01.01.2025 в 00:00:01, других операций нет
			ЗначениеПериода = ?(ЗначениеПериода = '20250101', '20250101000002', ЗначениеПериода);
			
			Запрос.Параметры.Вставить(ПараметрДатыОстатков, ?(ВключаяДатуОстатков, Новый Граница(ЗначениеПериода, ВидГраницы.Включая), ЗначениеПериода));
			
		Иначе
			
			СЧАБаланс = Новый ТаблицаЗначений;
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ _Клиенты ИЗ &Клиенты КАК Клиенты;" + Символы.ПС + ТекстЗапроса;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ " + ИмяВТ, "");
			
			ЗапросОстатков = Новый Запрос(ТекстЗапроса);
			
			// Получаем остатки клиентов с одинаковой датой остатков и объединяем их

			Для Каждого ВариантПериода Из ВариантыПериодов Цикл
				
				ЗначениеПериода = ВариантПериода[ПолеДатыОстатков]; 
				
				ГруппаКлиентов = Запрос.Параметры.ДанныеДляРасчета.Скопировать(
					Новый Структура("Организация, " + ПолеДатыОстатков, ВариантПериода.Организация, ЗначениеПериода));
				
				ЗапросОстатков.УстановитьПараметр("Клиенты",			ГруппаКлиентов);
				ЗапросОстатков.УстановитьПараметр("Организация",		ВариантПериода.Организация);
				ЗапросОстатков.УстановитьПараметр(ПараметрДатыОстатков, ?(ВключаяДатуОстатков, Новый Граница(ЗначениеПериода, ВидГраницы.Включая), ЗначениеПериода));
				
				СЧАБалансГруппыКлиентов = ЗапросОстатков.Выполнить().Выгрузить();
				
				Если СЧАБаланс.Количество() = 0 Тогда 
					СЧАБаланс = СЧАБалансГруппыКлиентов;
				Иначе
					РаботаСКоллекциями.ТаблицаЗначений_Дополнить(СЧАБалансГруппыКлиентов, СЧАБаланс);
				КонецЕсли;
				
			КонецЦикла;
			
			ТекстЗапроса = "";
			
			// Помещаем результат в основной запрос
			
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СЧАБаланс, ИмяВТ, Запрос.МенеджерВременныхТаблиц); 

		КонецЕсли;

		#КонецОбласти	
		
	ИначеЕсли ИмяИсточника = "_РСАНаКонецБаланс" Тогда 
		
		#Область _РСАНаКонецБаланс
		
		// РСА по данным ЕПС
		//
		// Во временной таблице _Клиенты необходимы поля:
		//		- СчетДоверительногоУправления 	– СправочникСсылка.СчетаДоверительногоУправления;
		//		- Организация			 		– СправочникСсылка.Организации;
		//		- КонецРасчетногоПериода 		– дата, на которую нужно получить балансовую стоимость;
		//		- ВалютаУчета 					– СправочникСсылка.Валюты, валюта учета организации;
		//		- ВалютаРасчета 				– СправочникСсылка.Валюты, дополнительная валюта, в которой требуется рассчитать балансовую стоимость
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.КонецРасчетногоПериода КАК Дата,
			|	_Клиенты.ВалютаУчета КАК Валюта,
			|	ЕСТЬNULL(РСАБаланс.Сумма, 0) КАК Сумма,
			|	ЕСТЬNULL(РСАБаланс.Сумма, 0) КАК СуммаВВалютеУчета,
			|	ЕСТЬNULL(РСАБаланс.Сумма / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность, 0) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _РСАНаКонецБаланс
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|				&КонецРасчетногоПериодаГраница,
			|				(Организация, СчетДоверительногоУправления) В
			|					(ВЫБРАТЬ
			|						_Клиенты.Организация,
			|						_Клиенты.СчетДоверительногоУправления
			|					ИЗ
			|						_Клиенты)) КАК НастройкиУчетаОбщие
			|		ПО (НастройкиУчетаОбщие.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет = ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток) КАК Сумма
			|		ИЗ
			|			РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|					&КонецРасчетногоПериодаГраница,
			|					Счет В
			|						(ВЫБРАТЬ
			|							ЕдиныйПланСчетов.Ссылка
			|						ИЗ
			|							ПланСчетов.Единый КАК ЕдиныйПланСчетов
			|						ГДЕ
			|							(ЕдиныйПланСчетов.Код < ""700""
			|									И НЕ(ПОДСТРОКА(ЕдиныйПланСчетов.Код, 1, 3) В (""479"", ""474"", ""603"", ""470"", ""615"")
			|												И ЕдиныйПланСчетов.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			|											ИЛИ ПОДСТРОКА(ЕдиныйПланСчетов.Код, 1, 3) = ""106"")
			|								ИЛИ ЕдиныйПланСчетов.Код = ""47017""
			|								ИЛИ ЕдиныйПланСчетов.Код = ""60324""
			|								ИЛИ ЕдиныйПланСчетов.Код = ""47021""
			|								ИЛИ ЕдиныйПланСчетов.Код = ""47425"")),
			|					,
			|					Организация = &Организация
			|						И СчетДоверительногоУправления В
			|							(ВЫБРАТЬ
			|								_Клиенты.СчетДоверительногоУправления
			|							ИЗ
			|								_Клиенты)) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ГДЕ
			|			(НЕ ЕдиныйБухгалтерскийУчетОстатки.Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ))
			|					ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.НеобходимыеРасходыУправляющего)))
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления) КАК РСАБаланс
			|		ПО (РСАБаланс.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыРасчета
			|		ПО (КурсВалютыРасчета.Валюта = _Клиенты.ВалютаРасчета)
			|			И (КурсВалютыРасчета.Период = НАЧАЛОПЕРИОДА(_Клиенты.КонецРасчетногоПериода, ДЕНЬ))";
		  				
		#КонецОбласти

	ИначеЕсли ИмяИсточника = "_РСАНаКонецБалансРСБУ" Тогда 
		
		#Область _РСАНаКонецБалансРСБУ
		
		// РСА по данным РСБУ
		//
		// Во временной таблице _Клиенты необходимы поля:
		//		- СчетДоверительногоУправления 	– СправочникСсылка.СчетаДоверительногоУправления;
		//		- Организация			 		– СправочникСсылка.Организации;
		//		- КонецРасчетногоПериода 		– дата, на которую нужно получить балансовую стоимость;
		//		- ВалютаУчета 					– СправочникСсылка.Валюты, валюта учета организации;
		//		- ВалютаРасчета 				– СправочникСсылка.Валюты, дополнительная валюта, в которой требуется рассчитать балансовую стоимость
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Основной.Ссылка КАК Счет,
			|	1 КАК КоэффицентДт,
			|	ВЫБОР
			|		КОГДА ПОДСТРОКА(Основной.Код, 1, 2) = ""63""
			|			ТОГДА 1
			|		КОГДА ПОДСТРОКА(Основной.Код, 1, 2) МЕЖДУ ""60"" И ""76""
			|			ТОГДА 0
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК КоэффицентКт
			|ПОМЕСТИТЬ _ОтборПоСчетам
			|ИЗ
			|	ПланСчетов.Основной КАК Основной
			|ГДЕ
			|	(ПОДСТРОКА(Основной.Код, 1, 2) МЕЖДУ ""51"" И ""76""
			|			ИЛИ ПОДСТРОКА(Основной.Код, 1, 2) = ""98"")
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Счет
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Клиенты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Клиенты.КонецРасчетногоПериода КАК Дата,
			|	_Клиенты.ВалютаУчета КАК Валюта,
			|	ЕСТЬNULL(РСАБалансРСБУ.Сумма, 0) КАК Сумма,
			|	ЕСТЬNULL(РСАБалансРСБУ.Сумма, 0) КАК СуммаВВалютеУчета,
			|	ЕСТЬNULL(РСАБалансРСБУ.Сумма / КурсВалютыРасчета.Курс * КурсВалютыРасчета.Кратность, 0) КАК СуммаВВалютеРасчета
			|ПОМЕСТИТЬ _РСАНаКонецБалансРСБУ
			|ИЗ
			|	_Клиенты КАК _Клиенты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|				&КонецРасчетногоПериодаГраница,
			|				(Организация, СчетДоверительногоУправления) В
			|					(ВЫБРАТЬ
			|						_Клиенты.Организация,
			|						_Клиенты.СчетДоверительногоУправления
			|					ИЗ
			|						_Клиенты)) КАК НастройкиУчетаОбщие
			|		ПО (НастройкиУчетаОбщие.СчетДоверительногоУправления = _Клиенты.СчетДоверительногоУправления)
			|			И (НастройкиУчетаОбщие.ВестиБухгалтерскийУчет = ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			БухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|			СУММА(БухгалтерскийУчетОстатки.СуммаОстатокДт * _ОтборПоСчетам.КоэффицентДт - БухгалтерскийУчетОстатки.СуммаОстатокКт * _ОтборПоСчетам.КоэффицентКт) КАК Сумма
			|		ИЗ
			|			РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
			|					&КонецРасчетногоПериодаГраница,
			|					Счет В
			|						(ВЫБРАТЬ
			|							_ОтборПоСчетам.Счет
			|						ИЗ
			|							_ОтборПоСчетам КАК _ОтборПоСчетам),
			|					,
			|					Организация = &Организация
