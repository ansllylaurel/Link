
Процедура ПередЗаписью(Отказ)

	// установим новый код - хэш потока по МД5
	ЭтотОбъект.Код = Справочники.ДенежныеПотокиПоОблигациям.ПолучитьХэш(ЭтотОбъект);
	
	Если НЕ ЭтотОбъект.ЭтоНовый() Тогда
		// нельзя записывать потоки, если на него есть ссылки
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ЗначенияНастроекУчетаЦенныхБумаг.Период КАК Период
			|ИЗ
			|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг КАК ЗначенияНастроекУчетаЦенныхБумаг
			|ГДЕ
			|	ЗначенияНастроекУчетаЦенныхБумаг.ЗначениеНастройки = &ЗначениеНастройки";
		
		Запрос.УстановитьПараметр("ЗначениеНастройки", ЭтотОбъект.Ссылка);
		
		УстановитьПривилегированныйРежим(Истина);
		Отказ = НЕ Запрос.Выполнить().Пустой();
		УстановитьПривилегированныйРежим(Ложь);
		
        Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя изменять значение потоков если т.к. он уже был установлен в настройках");
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры
