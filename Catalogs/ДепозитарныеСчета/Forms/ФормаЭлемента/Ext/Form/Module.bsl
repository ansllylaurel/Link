// СОБЫТИЯ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТипСчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	// отвественное хранение нельзя ставить для счета с подчиненными разделами
	Если Объект.ПодчиненныеРазделы И ВыбранноеЗначение <> ПредопределенноеЗначение("Перечисление.ТипыДепозитарныхСчетов.Депозитарный") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Тип счета '" + ВыбранноеЗначение + "' нельзя устанавливать при включенных подчиненных разделах", ЭтаФорма, "Объект.ТипСчета");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипСчетаПриИзменении(Элемент)
	
	ТипыДепозитарныхСчетов = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ТипыДепозитарныхСчетов");
	
	ЭтаФорма.ОтветственноеХранение = (Объект.ТипСчета = ТипыДепозитарныхСчетов.ОтветственноеХранение);
	ЭтаФорма.ДепозитарныйСчет      = Не ЭтаФорма.ОтветственноеХранение И (Объект.ТипСчета = ТипыДепозитарныхСчетов.Депозитарный);
			
	Если Объект.ВладелецСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо") Тогда
		Если Объект.ТипСчета = ТипыДепозитарныхСчетов.Депозитарный Тогда
			Объект.ВидСчета = ПредопределенноеЗначение("Перечисление.ВидыДепозитарныхСчетов.Основной");
		Иначе
			Объект.ВидСчета = Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Если Объект.ТипСчета <> ТипыДепозитарныхСчетов.Депозитарный Тогда
		Объект.СчетТипаС = Ложь;
	КонецЕсли;
	
	УстановитьНовоеНаименование();
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	УстановитьНадписьДепозитария(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСчетаПриИзменении(Элемент)
	
	УстановитьНовоеНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныеРазделыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Объект.ПодчиненныеРазделы Тогда
			// включить флажок можно только тогда, когда объект не использовался в базе данных
			Если ОбщегоНазначения.ОбъектИспользуетсяВБазеДанных(Объект.Ссылка) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данный депозитарный счет используется в объектах базы данных. Посмотреть список таких объектов можно через меню Все Фукнции - Стандартные - Поиск ссылок на объекты", ЭтаФорма, "Объект.ПодчиненныеРазделы");
				Объект.ПодчиненныеРазделы = Ложь;
			КонецЕсли;
		Иначе
			// отключить флажок можно только тогда, когда у счета нет подчиненных разделов
			Если ЕстьПодчиненныеРазделы(Объект.Ссылка) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У данного депозитарного счета есть подчиненные разделы. Чтобы отключить признак 'Подчиненные разделы' сначала необходимо удалить эти разделы", ЭтаФорма, "Объект.ПодчиненныеРазделы");
				Объект.ПодчиненныеРазделы = Истина;
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Разделы.Видимость = Объект.ПодчиненныеРазделы;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
			
	Если ЭтаФорма.ОтветственноеХранение Тогда
		ОбщегоНазначенияКлиентСервер.ОчиститьПоля(Объект, "ВидСчета, НомерСчета, Попекаемый, Попечитель, ДоговорПопечения");
	КонецЕсли;		
	
	// Связанные реквизиты
	РеквизитыДоговора = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(Объект.Договор, "Депозитарий, ДатаРасторжения, ДатаЗаключения");
	
	Объект.Депозитарий  = РеквизитыДоговора.Депозитарий;
	Объект.ДатаЗакрытия = РеквизитыДоговора.ДатаРасторжения;
	Объект.ДатаОткрытия = РеквизитыДоговора.ДатаЗаключения;
	
	ЭтаФорма.СчетЗакрыт = ЗначениеЗаполнено(Объект.ДатаЗакрытия);
	
	// Оконченые процедуры
	УстановитьНовоеНаименование();
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетЗакрытПриИзменении(Элемент)
	
	Если Не ЭтаФорма.СчетЗакрыт Тогда
		Объект.ДатаЗакрытия = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

// Дерево для закрытия раздела без вызова РаботаСИсполнителями.ПолучитьДочерниеЭлементы
// (только исполнители по этому разделу — без рекурсии по подразделам).
//
&НаСервере
Функция АдресДереваИсполнителейРазделаДляЗакрытияНаСервере(СсылкаРаздела, ДатаЗакрытия, УникальныйИдентификаторФормы)
	
	Если Не ЗначениеЗаполнено(СсылкаРаздела) Или Не ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоЦеннымБумагам.Организация КАК Организация,
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления.Наименование КАК НаименованиеСДУ
		|ИЗ
		|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет = &ДепозитарныйСчет
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &ДатаГраницы)";
	
	Запрос.УстановитьПараметр("ДепозитарныйСчет", СсылкаРаздела);
	Запрос.УстановитьПараметр("ДатаГраницы",      ДатаЗакрытия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДеревоРезультат = Новый ДеревоЗначений;
	ДеревоРезультат.Колонки.Добавить("Элемент");
	ДеревоРезультат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"), "Договор / Счет / Раздел / Исполнитель");
	ДеревоРезультат.Колонки.Добавить("ДанныеКартинки", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(2)));
	
	СтрокаРаздела = ДеревоРезультат.Строки.Добавить();
	СтрокаРаздела.Элемент = СсылкаРаздела;
	СтрокаРаздела.Представление = "Раздел счета: " + Строка(СсылкаРаздела);
	СтрокаРаздела.ДанныеКартинки = 1;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаИсп = СтрокаРаздела.Строки.Добавить();
		
		СтруктураКлюча = Новый Структура("Организация, СчетДоверительногоУправления, ДепозитарныйСчет");
		ЗаполнитьЗначенияСвойств(СтруктураКлюча, Выборка);
		СтрокаИсп.Элемент = РегистрыСведений.ИсполнителиПоЦеннымБумагам.СоздатьКлючЗаписи(СтруктураКлюча);
		СтрокаИсп.Представление = "Исполнитель: " + Выборка.НаименованиеСДУ;
		СтрокаИсп.ДанныеКартинки = 0;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ДеревоРезультат, УникальныйИдентификаторФормы);
	
КонецФункции

&НаКлиенте
Процедура ДатаЗакрытияРазделПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ЭтоРазделДепозитарногоСчета Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
		Возврат;
	КонецЕсли;
	
	АдресДереваДочернихЭлементов = АдресДереваИсполнителейРазделаДляЗакрытияНаСервере(
		Объект.Ссылка, Объект.ДатаЗакрытия, ЭтаФорма.УникальныйИдентификатор);
	
	Если Не ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеРеквизиты = Новый Массив;
	ДополнительныеРеквизиты.Добавить(Новый Структура(
		"Имя, ТипЗначения, Заголовок, Значение",
		"ДатаЗакрытия",
		Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)),
		"Дата закрытия",
		Объект.ДатаЗакрытия));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимВыбора",               Истина);
	ДополнительныеПараметры.Вставить("МножественныйВыбор",        Истина);
	ДополнительныеПараметры.Вставить("ВидимыеКолонки",            "Представление");
	ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",        Новый Структура("Элемент", Объект.Ссылка));
	ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",   ДополнительныеРеквизиты);
	ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки", "ДеревоЗначений.ДанныеКартинки");
	ДополнительныеПараметры.Вставить("КартинкаСтрок",             БиблиотекаКартинок.РегистрСведенийЗапись);
	
	РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(
		АдресДереваДочернихЭлементов,
		"При закрытии раздела счёта будут закрыты подчинённые исполнители:",
		ЭтаФорма,
		РежимДиалогаВопрос.ОКОтмена,
		КодВозвратаДиалога.ОК,
		"Закрытие раздела",
		ДополнительныеПараметры);
	
	Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСИсполнителями.ЗакрытьДеревоЭлементов(
		ДополнительныеПараметры.АдресДереваЗначений,
		ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
	
	ЭтотОбъект.Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаПриИзменении(Элемент)
	
	УстановитьНовоеНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура ПопекаемыйПриИзменении(Элемент)
	
	УстановитьНовоеНаименование();
	
	Если Не Объект.Попекаемый Тогда
		Объект.Попечитель       = Неопределено;
		Объект.ДоговорПопечения = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	
	ЗаполнитьЗначенияСвойств(Объект, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Родитель, ПолучитьСвязанныеРеквизитыСчетаИРаздела()));
	
	УстановитьНовоеНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчета1ПриИзменении(Элемент)
	
	УстановитьНовоеНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	УстановитьНовоеНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура ВладелецСчетаПриИзменении(Элемент)

	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РазделыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЭтаФорма.Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед добавлением подчиненного раздела необходимо записать изменения.",,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

