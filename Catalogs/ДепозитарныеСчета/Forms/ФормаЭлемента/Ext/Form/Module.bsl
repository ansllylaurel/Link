
&НаСервереБезКонтекста
Функция ПолучитьПодчиненныеРазделы(ДепозитарныйСчет)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.Родитель = &Родитель";

	Запрос.УстановитьПараметр("Родитель", ДепозитарныйСчет);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ПолучитьПодчиненныеРазделы

&НаСервереБезКонтекста
Функция ПолучитьСвязанныеРеквизитыСчетаИРаздела()
	
	Возврат Справочники.ДепозитарныеСчета.ПолучитьСвязанныеРеквизитыСчетаИРаздела();
	
КонецФункции // ПолучитьСвязанныеРеквизитыСчетаИРаздела

&НаСервереБезКонтекста
Функция ЕстьПодчиненныеРазделы(Родитель)
	
	Возврат Справочники.ДепозитарныеСчета.ЕстьПодчиненныеРазделы(Родитель);
	
КонецФункции // ЕстьПодчиненныеРазделы

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;
	
	Если Форма.ЭтоРазделДепозитарногоСчета Тогда
		
		Элементы.Попечитель1.Видимость        			= ДанныеОбъекта.Попекаемый;
		Элементы.ДоговорПопечения1.Видимость  			= ДанныеОбъекта.Попекаемый;
		
		Если ДанныеОбъекта.ПометкаУдаления Тогда
			Элементы.СчетЗакрытРаздел.Видимость				= Ложь;
			Элементы.ДатаЗакрытияРаздел.Видимость			= Истина;	
			Элементы.ДатаЗакрытияРаздел.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Авто;
			Элементы.КомандаЗакрытьДоговорРаздел.Видимость	= Ложь;
		Иначе
			Элементы.СчетЗакрытРаздел.Видимость				= Форма.СчетЗакрыт;	
			Элементы.ДатаЗакрытияРаздел.Видимость			= Форма.СчетЗакрыт;	
			Элементы.ДатаЗакрытияРаздел.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
			Элементы.КомандаЗакрытьДоговорРаздел.Видимость	= Не Элементы.ДатаЗакрытияРаздел.Видимость;
		КонецЕсли;
		
	Иначе
		
		ТипыДепозитарныхСчетов = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ТипыДепозитарныхСчетов");
		
		ЭтоЛицевойСчет		= (ДанныеОбъекта.ТипСчета = ТипыДепозитарныхСчетов.Лицевой);
		ЭтоДепозитарныйСчет = (ДанныеОбъекта.ТипСчета = ТипыДепозитарныхСчетов.Депозитарный);
		
		ЭтоДепозитарныйСчетКонтрагента = НЕ (ДанныеОбъекта.ВладелецСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.Организация, "ЮрФизЛицо"));
		
		// ответ. хранение
		Элементы.ПодчиненныеРазделы.Видимость = Не ЭтоЛицевойСчет и Не Форма.ОтветственноеХранение И НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.ВидСчета.Видимость           = Не ЭтоЛицевойСчет и Не Форма.ОтветственноеХранение;
		Элементы.ВидСчета.Доступность		  = НЕ ЭтоДепозитарныйСчетКонтрагента;
		
		Элементы.НомерСчета.Видимость         = Не Форма.ОтветственноеХранение;
		Элементы.Попекаемый.Видимость         = Не ЭтоЛицевойСчет и Не Форма.ОтветственноеХранение И НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.Попечитель.Видимость         = Не ЭтоЛицевойСчет и Не Форма.ОтветственноеХранение И НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.ДоговорПопечения.Видимость   = Не ЭтоЛицевойСчет и Не Форма.ОтветственноеХранение И НЕ ЭтоДепозитарныйСчетКонтрагента;
		
		// разделы
		Элементы.Разделы.Видимость          = Не ЭтоЛицевойСчет и ДанныеОбъекта.ПодчиненныеРазделы И НЕ ЭтоДепозитарныйСчетКонтрагента;
		
		// попечение
		Элементы.Попечитель.Видимость       = Не ЭтоЛицевойСчет и ДанныеОбъекта.Попекаемый И НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.ДоговорПопечения.Видимость	= Не ЭтоЛицевойСчет и ДанныеОбъекта.Попекаемый И НЕ ЭтоДепозитарныйСчетКонтрагента;
		
		// закрыт
		Если ЭтоДепозитарныйСчетКонтрагента Тогда
			Элементы.СчетЗакрыт.Видимость				= Форма.СчетЗакрыт;
			Элементы.ДатаЗакрытия.Видимость				= Форма.СчетЗакрыт;
			Элементы.ДатаЗакрытия.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
			Элементы.КомандаЗакрытьДоговор.Видимость	= Не Элементы.ДатаЗакрытия.Видимость;
		
		ИначеЕсли ДанныеОбъекта.ПометкаУдаления Тогда
			Элементы.СчетЗакрыт.Видимость				= Ложь;
			Элементы.ДатаЗакрытия.Видимость				= Истина;	
			Элементы.ДатаЗакрытия.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Авто;
			Элементы.КомандаЗакрытьДоговор.Видимость	= Ложь;
		Иначе
			Элементы.СчетЗакрыт.Видимость				= Форма.СчетЗакрыт;	
			Элементы.ДатаЗакрытия.Видимость     		= Форма.СчетЗакрыт;
			Элементы.ДатаЗакрытия.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
			Элементы.КомандаЗакрытьДоговор.Видимость	= Не Элементы.ДатаЗакрытия.Видимость;
		КонецЕсли;
		
		Элементы.Транзитный.Видимость       = Не ЭтоЛицевойСчет И НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.ВладелецСчета.Видимость    = (ЭтоЛицевойСчет ИЛИ ЭтоДепозитарныйСчет);
		Элементы.Эмитент.Видимость          = ЭтоЛицевойСчет;
		Элементы.СчетТипаС.Видимость        = ЭтоДепозитарныйСчет;
		
		Если ЭтоДепозитарныйСчетКонтрагента Тогда			
			Элементы.Договор.Видимость						= Ложь;                
			Элементы.ДатаОткрытия.АвтоОтметкаНезаполненного	= Ложь;
			Элементы.ДатаОткрытия.ОтметкаНезаполненного		= Ложь;
			
		ИначеЕсли ЭтоЛицевойСчет Тогда
			Элементы.ДатаОткрытия.АвтоОтметкаНезаполненного	= Ложь;
			Элементы.ДатаОткрытия.ОтметкаНезаполненного		= Ложь;
			Элементы.Договор.АвтоОтметкаНезаполненного		= Ложь;
			Элементы.Договор.ОтметкаНезаполненного			= Ложь;
			
		Иначе
			Элементы.ДатаОткрытия.АвтоОтметкаНезаполненного	= Истина;
			Элементы.Договор.АвтоОтметкаНезаполненного		= Истина;
		КонецЕсли;
		
		Элементы.КодДляСверкиСБрокером.Видимость		= НЕ ЭтоДепозитарныйСчетКонтрагента;
		Элементы.КодДляСверкиСДепозитарием.Видимость	= НЕ ЭтоДепозитарныйСчетКонтрагента;
		
	КонецЕсли;
	
	Элементы.КодДляСверкиСБрокером.Доступность     = (Форма.ПериодКодаСверкиСБрокером = Дата(1980, 1, 1) Или Форма.ПериодКодаСверкиСБрокером = Дата(1, 1, 1));
	Элементы.КодДляСверкиСДепозитарием.Доступность = (Форма.ПериодКодаСверкиСДепозитарием = Дата(1980, 1, 1) Или Форма.ПериодКодаСверкиСДепозитарием = Дата(1, 1, 1));
		
КонецПроцедуры // НастроитьВидимостьДоступность

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьДепозитария(Форма)
	
	Элементы = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;

	Если ДанныеОбъекта.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыДепозитарныхСчетов.Лицевой") Тогда
		Элементы.Депозитарий.Заголовок = "Регистратор";
	Иначе
		Элементы.Депозитарий.Заголовок = "Депозитарий";
	КонецЕсли;
	
КонецПроцедуры // УстановитьНадписьВладельца

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ЭтоРазделДепозитарногоСчета = (Объект.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета);
	
	ЭтаФорма.ОтветственноеХранение = (Объект.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.ОтветственноеХранение);
	ЭтаФорма.ДепозитарныйСчет      = Не ЭтаФорма.ОтветственноеХранение И (Объект.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Депозитарный);
	ЭтаФорма.СчетЗакрыт            = ЗначениеЗаполнено(Объект.ДатаЗакрытия);
	ЭтаФорма.ЮрФизЛицоДепозитария  = Объект.Депозитарий.ЮрФизЛицо;
	
	ДанныеРегистраКодСверкиСБрокером = РегистрыСведений.КодыВоВнешнихСистемах.СрезПоследних(ТекущаяДатаСеанса(), Новый Структура("ВнешняяСистема, ГруппаОбъектов, Объект", Справочники.ВнешниеСистемы.ОтчетБрокераБКРегион, Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеСчета, Объект.Ссылка)); 
	
	Если ДанныеРегистраКодСверкиСБрокером.Количество() = 1 Тогда
		ЭтаФорма.КодДляСверкиСБрокером     = ДанныеРегистраКодСверкиСБрокером[0].Код;
		ЭтаФорма.ПериодКодаСверкиСБрокером = ДанныеРегистраКодСверкиСБрокером[0].Период;
	КонецЕсли;
	
	ДанныеРегистраКодСверкиСДепозитарием = РегистрыСведений.КодыВоВнешнихСистемах.СрезПоследних(ТекущаяДатаСеанса(), Новый Структура("ВнешняяСистема, ГруппаОбъектов, Объект", Справочники.ВнешниеСистемы.ОтчетДепозитарияДКРегион, Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеСчета, Объект.Ссылка)); 
	
	Если ДанныеРегистраКодСверкиСДепозитарием.Количество() = 1 Тогда
		ЭтаФорма.КодДляСверкиСДепозитарием     = ДанныеРегистраКодСверкиСДепозитарием[0].Код;
		ЭтаФорма.ПериодКодаСверкиСДепозитарием = ДанныеРегистраКодСверкиСДепозитарием[0].Период;
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	УстановитьНадписьДепозитария(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура УстановитьНовоеНаименование()

	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);

КонецПроцедуры // УстановитьНовоеНаименование

////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Разделы.Отбор, Новый Структура("ИмяПоля, Представление", "Родитель", "ПредопределенныйОтборРодитель"),
		"ПредопределенныйОтборРодитель", ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);

	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Разделы.Отбор, Новый Структура("ИмяПоля, Представление", "ТипСчета", "ПредопределенныйОтборТипСчета"),
		"ПредопределенныйОтборТипСчета", ВидСравненияКомпоновкиДанных.Равно, ПредопределенноеЗначение("Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета"), Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		
	// скроем не актульные для пользователя закладки
	Элементы.СтраницыВидФормы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.СтраницыВидФормы.ТекущаяСтраница    = ?(ЭтаФорма.ЭтоРазделДепозитарногоСчета, Элементы.СтраницаРаздел, Элементы.СтраницаСчет);
	
КонецПроцедуры // ПриСозданииНаСервере

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.СчетЗакрыт И Не ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата закрытия"" не заполнено.", ЭтаФорма, "ДатаЗакрытия",, Отказ);
	ИначеЕсли ЭтаФорма.СчетЗакрыт И ЭтаФорма.ЭтоРазделДепозитарногоСчета И ЗначениеЗаполнено(Объект.Родитель.ДатаЗакрытия) И Объект.ДатаЗакрытия > Объект.Родитель.ДатаЗакрытия Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата закрытия раздела не может быть больше даты закрытия депозитарного счета", ЭтаФорма, "ДатаЗакрытияРаздел",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ЭтаФорма.КодДляСверкиСБрокером) И (ЭтаФорма.ПериодКодаСверкиСБрокером = Дата(1980, 1, 1) Или ЭтаФорма.ПериодКодаСверкиСБрокером = Дата(1, 1, 1)) Тогда
			
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(Объект.Ссылка,
			Справочники.ВнешниеСистемы.ОтчетБрокераБКРегион,
			Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеСчета,
			ЭтаФорма.КодДляСверкиСБрокером,
			,,
			Дата(1980, 1, 1));
			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.КодДляСверкиСДепозитарием) И (ЭтаФорма.ПериодКодаСверкиСДепозитарием = Дата(1980, 1, 1) Или ЭтаФорма.ПериодКодаСверкиСДепозитарием = Дата(1, 1, 1)) Тогда
		
		РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(Объект.Ссылка,
			Справочники.ВнешниеСистемы.ОтчетДепозитарияДКРегион,
			Справочники.ГруппыИмпортируемыхОбъектов.ДепозитарныеСчета,
			ЭтаФорма.КодДляСверкиСДепозитарием,
			,,
			Дата(1980, 1, 1));
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Разделы.Отбор, Новый Структура("ИмяПоля, Представление", "Родитель", "ПредопределенныйОтборРодитель"),
		"ПредопределенныйОтборРодитель", ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Разделы.Отбор, Новый Структура("ИмяПоля, Представление", "ТипСчета", "ПредопределенныйОтборТипСчета"),
		"ПредопределенныйОтборТипСчета", ВидСравненияКомпоновкиДанных.Равно, ПредопределенноеЗначение("Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета"), Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ИсполнителиПоЦеннымБумагам"));
	
	Если Объект.ПодчиненныеРазделы Тогда
		Для каждого ПодчиненныйРаздел Из ПолучитьПодчиненныеРазделы(Объект.Ссылка) Цикл
			ОповеститьОбИзменении(ПодчиненныйРаздел);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

