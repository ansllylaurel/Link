
Функция СформироватьНаименование(РеквизитыСчета, ЗадействованныеРеквизиты = "") Экспорт
	
	ЗадействованныеРеквизиты = "Родитель, Договор, Депозитарий, НомерСчета, ТипСчета, ВидСчета, Попекаемый, Брокер, Организация";
	
	Если РеквизитыСчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Наименование = "";
	
	Если      РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Собственный Тогда
		
		Если ЗначениеЗаполнено(РеквизитыСчета.Депозитарий) И ЗначениеЗаполнено(РеквизитыСчета.Договор) Тогда
			Наименование = "" + РеквизитыСчета.Депозитарий + ", Собств. по договору № " + РеквизитыСчета.Договор.НомерДоговора + " от " + Формат(РеквизитыСчета.Договор.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	ИначеЕсли РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.ОтветственноеХранение Тогда
		
		Если ЗначениеЗаполнено(РеквизитыСчета.Депозитарий) И ЗначениеЗаполнено(РеквизитыСчета.Договор) Тогда
			Наименование = "" + РеквизитыСчета.Депозитарий + ", Отв. хран. по договору № " + РеквизитыСчета.Договор.НомерДоговора + " от " + Формат(РеквизитыСчета.Договор.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	ИначеЕсли РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Депозитарный Тогда
		
		Если ЗначениеЗаполнено(РеквизитыСчета.Депозитарий) И ЗначениеЗаполнено(РеквизитыСчета.НомерСчета)
			И ЗначениеЗаполнено(РеквизитыСчета.ВидСчета)
		Тогда
			Наименование = "" + РеквизитыСчета.Депозитарий + ", " + РеквизитыСчета.ВидСчета + ", " + РеквизитыСчета.НомерСчета + ?(РеквизитыСчета.Попекаемый, " (попек.)", "");
		КонецЕсли;
		
	ИначеЕсли РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета Тогда
		Если ЗначениеЗаполнено(РеквизитыСчета.Родитель) И ЗначениеЗаполнено(РеквизитыСчета.НомерСчета) Тогда
			Если      Лев(РеквизитыСчета.НомерСчета, 2) = "31" Тогда
				Наименование = "Торговый в НРД";
			ИначеЕсли Лев(РеквизитыСчета.НомерСчета, 2) = "36" Тогда
				Наименование = "Торговый+ в НРД";
			ИначеЕсли Лев(РеквизитыСчета.НомерСчета, 2) = "38" Тогда
				Наименование = "Блокиров. в НРД";
			Иначе
				Наименование = "";
			КонецЕсли;
			
			ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
			ДобавлятьНомерРаздела = ЗначениеЗаполнено(РеквизитыСчета.Организация) И РеквизитыСчета.Организация = ОрганизацияРЭМ;
			
			Наименование = РеквизитыСчета.Родитель.НомерСчета
				+ ?(ДобавлятьНомерРаздела, ", " + РеквизитыСчета.НомерСчета, "")
				+ ", " + ?(Наименование <> "", Наименование + ", ", "")
				+ ?(ЗначениеЗаполнено(РеквизитыСчета.Брокер), РеквизитыСчета.Брокер, "");
		КонецЕсли;
		
	ИначеЕсли РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Лицевой Тогда
		
		Если ЗначениеЗаполнено(РеквизитыСчета.Депозитарий) Тогда
			Если ЗначениеЗаполнено(РеквизитыСчета.Договор) Тогда
				Наименование = "" + РеквизитыСчета.Депозитарий + ", Лицевой счет по договору № " + РеквизитыСчета.Договор.НомерДоговора + " от " + Формат(РеквизитыСчета.Договор.ДатаЗаключения, "ДФ=dd.MM.yyyy");
			Иначе
				Наименование = "" + РеквизитыСчета.Депозитарий + ", Лицевой счет № " + РеквизитыСчета.НомерСчета;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции // СформироватьНаименование

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ МАССОВЫЕ ОПЕРАЦИИ

// Перезаписывает наименования существующих разделов депозитарных счетов для РЭМ,
// чтобы подтянуть новый шаблон наименования (включая номер раздела).
//
// Параметры:
//  - ТолькоПоказать (Булево) - если Истина, то только считает, сколько будет изменено, без записи
//  - Максимум (Число) - ограничение количества обрабатываемых элементов за один запуск (0 = без ограничения)
//
// Возвращаемое значение:
//  - Структура: Изменено, Просмотрено, Ошибок
//
Процедура ПерезаписатьНаименованияРазделовДепозитарныхСчетовРЭМ(ТолькоПоказать = Ложь, Максимум = 0) Экспорт
	
	ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	Если Не ЗначениеЗаполнено(ОрганизацияРЭМ) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден именованный объект Организация_РЭМ.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.ПометкаУдаления = ЛОЖЬ
		|	И ДепозитарныеСчета.ТипСчета = &ТипСчета
		|	И ДепозитарныеСчета.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ТипСчета",     Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета);
	Запрос.УстановитьПараметр("Организация",  ОрганизацияРЭМ);
	
	Просмотрено = 0;
	Изменено    = 0;
	Ошибок      = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Просмотрено = Просмотрено + 1;
		Если Максимум > 0 И Просмотрено > Максимум Тогда
			Прервать;
		КонецЕсли;
		
		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			НовоеНаименование = СформироватьНаименование(Объект);
			
			Если ПустаяСтрока(НовоеНаименование) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Объект.Наименование <> НовоеНаименование Тогда
				Изменено = Изменено + 1;
				
				Если Не ТолькоПоказать Тогда
					Объект.Наименование = НовоеНаименование;
					Объект.Записать();
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			Ошибок = Ошибок + 1;
		КонецПопытки;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"РЭМ: разделы депозитарных счетов. Просмотрено: " + Просмотрено
		+ ", изменено: " + Изменено
		+ ?(ТолькоПоказать, " (без записи)", "")
		+ ", ошибок: " + Ошибок + ".");
	
КонецПроцедуры

Функция ЕстьПодчиненныеРазделы(Родитель) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитарныеСчета.Ссылка
		|ИЗ
		|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|ГДЕ
		|	ДепозитарныеСчета.Родитель = &Родитель";

	Запрос.УстановитьПараметр("Родитель", Родитель);

	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // ЕстьПодчиненныеРазделы

Функция ПолучитьСвязанныеРеквизитыСчетаИРаздела() Экспорт
	
	СвязанныеРеквизиты = Новый Массив();
	СвязанныеРеквизиты.Добавить("Организация");
	СвязанныеРеквизиты.Добавить("Договор");
	СвязанныеРеквизиты.Добавить("Депозитарий");
	СвязанныеРеквизиты.Добавить("Попекаемый");
	СвязанныеРеквизиты.Добавить("Попечитель");
	СвязанныеРеквизиты.Добавить("ДоговорПопечения");

	Возврат СвязанныеРеквизиты;
	
КонецФункции // ПолучитьСвязанныеРеквизитыСчетаИРаздела

////////////////////////////////////////////////////////////////////////////////

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" И Не Параметры.Свойство("Ключ") И Не Параметры.Свойство("ЗначениеКопирования") Тогда
		
		// Для лицевых счетов мастер не используется
		Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
			Если Параметры.ЗначенияЗаполнения.Свойство("ТипСчета") и Параметры.ЗначенияЗаполнения.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Лицевой Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = Метаданные.Справочники.ДепозитарныеСчета.Формы.МастерСозданияНового;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольВладельцаСчетаДепо(ДепозитарныйСчет, Организация, Отказ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДепозитарныйСчет) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДепозитарныйСчет.ВладелецСчета <> Организация.ЮрФизЛицо И Не (ДепозитарныйСчет = Справочники.ДепозитарныеСчета.СчетУчетаДеривативов Или ДепозитарныйСчет = Справочники.ДепозитарныеСчета.СчетУчетаДолей) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Юр.лицо организации «" + Организация.ЮрФизЛицо + "» не равно владельцу «" + ДепозитарныйСчет.ВладелецСчета
			+ "» выбранному в счете депо «" + ДепозитарныйСчет + "»",,,, Отказ);
	КонецЕсли;	
	
КонецПроцедуры
	
	
