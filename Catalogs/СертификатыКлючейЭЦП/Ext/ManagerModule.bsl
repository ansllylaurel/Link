
Функция СформироватьНаименование(РеквизитыСертификата, ЗадействованныеРеквизиты = "") Экспорт
	
	ЗадействованныеРеквизиты = "Организация, Субъект, УдостоверяющийЦентр, НачалоДействия, ОкончаниеДействия, СерийныйНомер";
	
	Если РеквизитыСертификата = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Наименование = "";
	
	Если ЗначениеЗаполнено(РеквизитыСертификата.Организация) 
			И ЗначениеЗаполнено(РеквизитыСертификата.Субъект)
			И ЗначениеЗаполнено(РеквизитыСертификата.ОкончаниеДействия)
			И ЗначениеЗаполнено(РеквизитыСертификата.СерийныйНомер)
			И ЗначениеЗаполнено(РеквизитыСертификата.УдостоверяющийЦентр)
	Тогда
	
		// получим ФИО субъекта
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
			|	РеквизитыФизическихЛицСрезПоследних.Имя КАК Имя,
			|	РеквизитыФизическихЛицСрезПоследних.Отчество КАК Отчество
			|ИЗ
			|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
			|			&Период,
			|			ЮрФизЛицо = &ЮрФизЛицо
			|				И Организация = &Организация
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних";
		
		
		Запрос.УстановитьПараметр("Период",    РеквизитыСертификата.НачалоДействия);
		Запрос.УстановитьПараметр("ЮрФизЛицо", РеквизитыСертификата.Субъект);
		Запрос.УстановитьПараметр("Организация", РеквизитыСертификата.Организация);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Наименование = Выборка.Фамилия + " " + Лев(Выборка.Имя, 1) + ". " + Лев(Выборка.Отчество, 1) + ".";
		КонецЕсли;
		
		// получим сокр. наименование УЦ
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|			&Период,
			|			ЮрФизЛицо = &ЮрФизЛицо
			|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
		Запрос.УстановитьПараметр("ЮрФизЛицо", РеквизитыСертификата.УдостоверяющийЦентр);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Наименование = Наименование + " — " + Выборка.СокращенноеНаименование;
		КонецЕсли;		
		
		// добавим период и номер
		Наименование = Наименование + ", " + Формат(РеквизитыСертификата.НачалоДействия, "ДФ=dd.MM.yyyy") + " — " + Формат(РеквизитыСертификата.ОкончаниеДействия, "ДФ=dd.MM.yyyy") + ", " + РеквизитыСертификата.СерийныйНомер;
	
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции // СформироватьНаименование
