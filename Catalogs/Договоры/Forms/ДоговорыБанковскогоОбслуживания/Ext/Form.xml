	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СправочникДоговоры.Ссылка КАК Ссылка,
	СправочникДоговоры.ПометкаУдаления КАК ПометкаУдаления,
	СправочникДоговоры.Родитель КАК Родитель,
	СправочникДоговоры.ЭтоГруппа КАК ЭтоГруппа,
	СправочникДоговоры.Код КАК Код,
	СправочникДоговоры.Наименование КАК Наименование,
	СправочникДоговоры.Организация КАК Организация,
	СправочникДоговоры.Основание КАК Основание,
	СправочникДоговоры.Контрагент КАК Контрагент,
	СправочникДоговоры.ВидДоговора КАК ВидДоговора,
	СправочникДоговоры.НомерДоговора КАК НомерДоговора,
	СправочникДоговоры.ДатаЗаключения КАК ДатаЗаключения,
	СправочникДоговоры.Комментарий КАК Комментарий,
	УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения КАК ДатаРасторжения,
	СправочникДоговоры.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
	СправочникДоговоры.Предопределенный КАК Предопределенный,
	СправочникДоговоры.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	НЕ(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения &gt; &amp;ТекущаяДата) КАК Закрыт,
	ДоговорыКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
ИЗ
	Справочник.Договоры КАК СправочникДоговоры
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&amp;ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = СправочникДоговоры.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДоговорыСчетовДоверительногоУправления.Договор КАК Договор,
			МАКСИМУМ(ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления) КАК СчетДоверительногоУправления
		ИЗ
			РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		
		СГРУППИРОВАТЬ ПО
			ДоговорыСчетовДоверительногоУправления.Договор
		
		ИМЕЮЩИЕ
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления) = 1) КАК ДоговорыКлиентов
		ПО СправочникДоговоры.Ссылка = ДоговорыКлиентов.Договор
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК ОснованияДоговоров
		ПО СправочникДоговоры.Основание = ОснованияДоговоров.Ссылка
ГДЕ
	(&amp;ОтображатьЗакрытые
			ИЛИ (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
				ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения &gt; &amp;ТекущаяДата))
	И (НЕ &amp;ОтборПоВидуДоговора
			ИЛИ СправочникДоговоры.ВидДоговора В (&amp;ВидыДоговоров)
			ИЛИ ОснованияДоговоров.ВидДоговора В (&amp;ВидыДоговоров))</QueryText>
				<MainTable>Catalog.Договоры</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">Закрыт</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:appearance>
								<dcscor:item xsi:type="dcsset:SettingsParameterValue">
									<dcscor:parameter>ЦветТекста</dcscor:parameter>
									<dcscor:value xsi:type="v8ui:Color">style:НеактуальнаяСтрокаВСпискеЦвет</dcscor:value>
								</dcscor:item>
							</dcsset:appearance>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
	</Attributes>
