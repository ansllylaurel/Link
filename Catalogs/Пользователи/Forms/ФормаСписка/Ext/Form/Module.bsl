
&НаСервереБезКонтекста
Процедура ПеренестиПользователейИзИнфБазы()
	
	Для каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		
		Если Не ЗначениеЗаполнено(Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор)) Тогда
			
			// сформируем из доменного имени "\\ИмяДомена\ИмяПользователя" адрес электронной почты
			АдресЭлектроннойПочты = "";
			
			Если ПользовательИБ.АутентификацияОС Тогда
				Если Лев(ПользовательИБ.ПользовательОС, 2) = "\\" Тогда
					АдресЭлектроннойПочты = СтрРазделить(Сред(ПользовательИБ.ПользовательОС, 3), "\");
					Если АдресЭлектроннойПочты.Количество() = 2 Тогда
						АдресЭлектроннойПочты = АдресЭлектроннойПочты[1] + "@" + НРег(АдресЭлектроннойПочты[0]) + ".ru";
					Иначе
						АдресЭлектроннойПочты = "";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ПустаяСтрока(АдресЭлектроннойПочты) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить адрес эл. почты для пользователя '" + ПользовательИБ.ПолноеИмя + "'. Заведите его вручную");
				Продолжить;
			КонецЕсли;
			
			// запишем нового пользователя
			НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
			НовыйПользователь.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
			НовыйПользователь.Наименование                = ПользовательИБ.ПолноеИмя;
			НовыйПользователь.АдресЭлектроннойПочты       = АдресЭлектроннойПочты;
			
			Попытка
				НовыйПользователь.Записать();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Добавлен новый пользователь '" + ПользовательИБ.ПолноеИмя + "'. Необходимо в карточке заполнить организацию и физ. лицо", НовыйПользователь.Ссылка);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать нового пользователя '" + ПользовательИБ.ПолноеИмя + "'. Система сообщает: " + ОписаниеОшибки());
			КонецПопытки;			
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры // ПеренестиПользователейИзИнфБазы

&НаСервереБезКонтекста
Процедура СообщитьАдресаЭлПочтыАктивныхПользователей()

	Сеансы = ПолучитьСеансыИнформационнойБазы();
	
	ИдентификаторыАктивныхПользователейИБ = Новый Массив;	
	
	Для Каждого Сеанс Из Сеансы Цикл
		Если ИдентификаторыАктивныхПользователейИБ.Найти(Сеанс.Пользователь.УникальныйИдентификатор) = Неопределено Тогда
			ИдентификаторыАктивныхПользователейИБ.Добавить(Сеанс.Пользователь.УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пользователи.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.ИдентификаторПользователяИБ В(&ИдентификаторыПользователейИБ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пользователи.АдресЭлектроннойПочты";
	
	Запрос.УстановитьПараметр("ИдентификаторыПользователейИБ", ИдентификаторыАктивныхПользователейИБ);
	
	АдресаЭлПочты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АдресЭлектроннойПочты");
	АдресаЭлПочты = СтрСоединить(АдресаЭлПочты, "; ");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(АдресаЭлПочты);
	
КонецПроцедуры // ПолучитьАдресаЭлПочтыАктивныхПользователей

&НаСервереБезКонтекста
Процедура УстановитьМасштабПриложения(Знач МассивПользователей, Знач ВариантМасштаба)
	
	Для каждого Пользователь из МассивПользователей Цикл
		
		Если ТипЗнч(Пользователь) <> Тип("СправочникСсылка.Пользователи") Тогда
			Продолжить;
		КонецЕсли;
		
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
		
		Если ПользовательИБ <> Неопределено Тогда
			
			Настройки = Новый НастройкиКлиентскогоПриложения;
			Настройки.ВариантМасштабаФормКлиентскогоПриложения = ВариантМасштабаФормКлиентскогоПриложения[ВариантМасштаба];    
			ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиКлиентскогоПриложения",,Настройки,,ПользовательИБ.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаПеренестиПользователейИзИнфБазы(Команда)
	
	ПеренестиПользователейИзИнфБазы();
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.Пользователи"));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьМасштабПриложения(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Авто");
	СписокВыбора.Добавить("Компактный");
	СписокВыбора.Добавить("Обычный");
	
	СписокВыбора.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ОбработкаВыбораМасштабаПриложения", ЭтотОбъект), "Выберите масштаб");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСообщитьАдресаЭлПочтыАктивныхПользователей(Команда)
	
	СообщитьАдресаЭлПочтыАктивныхПользователей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораМасштабаПриложения(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМасштабПриложения(Элементы.Список.ВыделенныеСтроки, ВыбранныйЭлемент.Значение)	
	
КонецПроцедуры
