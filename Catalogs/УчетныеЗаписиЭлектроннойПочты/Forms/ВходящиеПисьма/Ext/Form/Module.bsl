
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.УчетнаяЗаписьЭлектроннойПочты	= Параметры.УчетнаяЗаписьЭлектроннойПочты;
	ЭтаФорма.Заголовок						= Параметры.УчетнаяЗаписьЭлектроннойПочты;
	ЭтаФорма.Период.Вариант					= ВариантСтандартногоПериода.Сегодня;
	
КонецПроцедуры
	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ПолучитьПисьма(Команда)
	
	ПолучитьПисьмаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПисьмаНаСервере()
	
	ПараметрыОтбора = Новый Структура;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Период.ДатаНачала) Тогда
		ПараметрыОтбора.Вставить("ПослеДатыОтправления"	, ЭтаФорма.Период.ДатаНачала);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Период.ДатаОкончания) Тогда
		ПараметрыОтбора.Вставить("ДоДатыОтправления"	, ЭтаФорма.Период.ДатаОкончания + 1);
	КонецЕсли;
	
	Письма = РаботаСЭлектроннойПочтой.ЗагрузитьСообщения(ЭтаФорма.УчетнаяЗаписьЭлектроннойПочты,, ПараметрыОтбора);
	
	ТаблицаПисем.Загрузить(Письма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПисемВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("Тема, Отправитель, Получатели, Копии, СлепыеКопии, Тексты, Вложения");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Элементы.ТаблицаПисем.ТекущиеДанные);
	
	ОткрытьФорму("Справочник.УчетныеЗаписиЭлектроннойПочты.Форма.ФормаЭлектронногоПисьма", ПараметрыФормы);
	
	
КонецПроцедуры

#КонецОбласти




