Процедура ПередЗаписью(Отказ)
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ВидВычета) Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	ВидыДоходовНДФЛ.ВидВычета КАК ВидВычета
				|ИЗ
				|	Справочник.ВидыДоходовНДФЛ КАК ВидыДоходовНДФЛ
				|ГДЕ
				|	ВидыДоходовНДФЛ.ВидВычета = &ВидВычета
				|	И ВидыДоходовНДФЛ.Ссылка <> &Элемент";
			
			Запрос.УстановитьПараметр("ВидВычета", ЭтотОбъект.ВидВычета);
			Запрос.УстановитьПараметр("Элемент", ЭтотОбъект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данный вид вычета уже используется",,,,Отказ);			
			КонецЕсли;
		КонецЕсли;		
		
	КонецЕсли;	
				
КонецПроцедуры
