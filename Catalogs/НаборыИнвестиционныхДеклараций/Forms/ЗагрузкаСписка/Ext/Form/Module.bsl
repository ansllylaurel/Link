
&НаКлиенте
Процедура ОК(Команда)
	
	КоличествоПустых = 0;
	МассивКодов = Новый Массив;
	
	Для НомерСтроки = 1 По ЭтаФорма.ТабличныйДокумент.ВысотаТаблицы Цикл
	
		Текст = ЭтаФорма.ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		Если КоличествоПустых > 20 Тогда
			Прервать;
		КонецЕсли; 
		
		Если Текст = "Рег. номер / ISIN" Тогда
			Продолжить;
		ИначеЕсли ПустаяСтрока(Текст) Тогда
			КоличествоПустых = КоличествоПустых + 1;
			Продолжить;		
		КонецЕсли; 		
		
		МассивКодов.Добавить(Текст);
	
	КонецЦикла; 
	
	ЭтаФорма.Закрыть(МассивКодов);
	
КонецПроцедуры
