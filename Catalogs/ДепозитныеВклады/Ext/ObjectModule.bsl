
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "БанковскийСчет");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.НомерПодтверждения) Тогда
		ПроверяемыеРеквизиты.Добавить("ДатаПодтверждения");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаПодтверждения) Тогда
		ПроверяемыеРеквизиты.Добавить("НомерПодтверждения");
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	РаботаСоСправочниками.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		// в р/счете должен быть указан договор и его организация должна соответствовать организации во вкладе
		Если Не ЗначениеЗаполнено(ЭтотОбъект.БанковскийСчет.Договор) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран договор в банковском счете депозитного вклада", ЭтотОбъект, "БанковскийСчет",, Отказ);
		ИначеЕсли ЭтотОбъект.БанковскийСчет.Договор.Организация <> ЭтотОбъект.Организация Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Организация в банковском договоре не совпадает с организацией в депозитном вкладе", ЭтотОбъект, "БанковскийСчет",, Отказ);
		КонецЕсли;
		
		КонтрольДатыОткрытияБанковскогоСчета(Отказ);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура КонтрольДатыОткрытияБанковскогоСчета(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаРегистрации КАК ДатаРегистрации,
		|	БанковскиеСчета.ДатаОткрытия КАК ДатаОткрытия
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО (СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо = БанковскиеСчета.Организация.ЮрФизЛицо)
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &БанковскийСчет
		|	И (БанковскиеСчета.ЮрФизЛицо = БанковскиеСчета.Организация.ЮрФизЛицо
		|			ИЛИ БанковскиеСчета.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо)
		|	И БанковскиеСчета.ДоговорЦессии = ЗНАЧЕНИЕ(Справочник.Договоры.)
		|	И БанковскиеСчета.ДатаОткрытия <> &ДатаРегистрации";
	
	Запрос.УстановитьПараметр("БанковскийСчет",		ЭтотОбъект.БанковскийСчет);
	Запрос.УстановитьПараметр("ДатаРегистрации",	ЭтотОбъект.ДатаРегистрации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Дата размещения депозитного вклада (%1) не равна дате открытия банковского счёта (%2)", 
				Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy"),
				Формат(Выборка.ДатаОткрытия, "ДФ=dd.MM.yyyy")), ЭтотОбъект, "ДатаРегистрации",, Отказ);
	КонецЕсли;
	
КонецПроцедуры
