
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("Организация", 			Параметры.Организация);
	Список.Параметры.УстановитьЗначениеПараметра("ЮрФизЛицо",   			Параметры.ЮрФизЛицо);
	
	// По умолчанию показываем только банковские счета клиента
	Список.Параметры.УстановитьЗначениеПараметра("ТолькоСчетаКлиента",    	?(Параметры.Свойство("ТолькоСчетаКлиента"), Параметры.ТолькоСчетаКлиента, Истина));
	
КонецПроцедуры
