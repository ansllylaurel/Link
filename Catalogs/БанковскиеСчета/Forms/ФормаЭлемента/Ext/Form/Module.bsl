&НаСервере
Процедура ЗаполнитьИнфОБанкеНаСервере(ИмяРеквизитаБанка)
	
	ПостфиксИмениРеквизитов = ?(Найти(НРег(ИмяРеквизитаБанка), "длярасчетов") > 0, "ДляРасчетов", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Банки.Код      КАК БИКБанка" + ПостфиксИмениРеквизитов + ",
		|	Банки.КоррСчет КАК КоррСчетБанка" + ПостфиксИмениРеквизитов + ",
		|	Банки.Город    КАК ГородБанка" + ПостфиксИмениРеквизитов + "
		|ИЗ
		|	Справочник.Банки КАК Банки
		|ГДЕ
		|	Банки.Ссылка = &Банк";
		
	Запрос.УстановитьПараметр("Банк", Объект[ИмяРеквизитаБанка]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
	Иначе
		ЭтаФорма["БИКБанка"      + ПостфиксИмениРеквизитов] = "";
		ЭтаФорма["КоррСчетБанка" + ПостфиксИмениРеквизитов] = "";
		ЭтаФорма["ГородБанка"    + ПостфиксИмениРеквизитов] = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидСчетаВнутреннегоУчета()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ВидыДоговоровДУ.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|			ТОГДА ""СОБ""
		|		ИНАЧЕ ""ДУ""
		|	КОНЕЦ КАК ВидСчетаВнутреннегоУчета
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|	ГДЕ
		|		ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские
		|	ГДЕ
		|		ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет = &РасчетныйСчет) КАК ВидыДоговоровДУ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидСчетаВнутреннегоУчета");
	
	Запрос.УстановитьПараметр("РасчетныйСчет", Объект.Ссылка);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	
		ЭтаФорма.ВидСчетаВнутреннегоУчета = "Н/Д";
	Иначе
		ЭтаФорма.ВидСчетаВнутреннегоУчета = СтрСоединить(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВидСчетаВнутреннегоУчета"), ", ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборИПредставлениеДоговора()
	
	ВидыДоговоров = ВидыДоговоровБанковскогоОбслуживания(Объект.ВидБанковскогоСчета);
	
	Если Не ЗначениеЗаполнено(Объект.ВидБанковскогоСчета) Тогда	
		Элементы.Договор.Заголовок = "Банковского обслуживания / Банковского депозита";
		
	ИначеЕсли Объект.ВидБанковскогоСчета = ПредопределенноеЗначение("Перечисление.ВидыБанковскихСчетов.ДепозитныйСчет") Тогда
		Элементы.Договор.Заголовок = "Банковского депозита";
		
	Иначе
		Элементы.Договор.Заголовок = "Банковского обслуживания";
		
	КонецЕсли;
	
	НовыеПараметрыВыбора = Новый Массив;
	
	Для Каждого ПараметрВыбора Из Элементы.Договор.ПараметрыВыбора Цикл
		Если ПараметрВыбора.Имя <> "Отбор.ВидДоговора" Тогда
			НовыеПараметрыВыбора.Добавить(ПараметрВыбора);
		КонецЕсли;
	КонецЦикла;
	
	НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ?(ВидыДоговоров.Количество() = 1, ВидыДоговоров[0], Новый ФиксированныйМассив(ВидыДоговоров))));
	
	Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидыДоговоровБанковскогоОбслуживания(ВидБанковскогоСчета)
	
	Возврат Справочники.Договоры.ВидыДоговоровБанковскогоОбслуживания(ВидБанковскогоСчета);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы	  = Форма.Элементы;
	
	ВидыБанковскихСчетов = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыБанковскихСчетов");
	
	Элементы.ВидУправленияДовереннымиСредствами.Видимость = (Форма.ЮрФизЛицаОрганизации.НайтиПоЗначению(ДанныеОбъекта.ЮрФизЛицо) <> Неопределено)
															И (ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.СчетДоверительногоУправления
															ИЛИ ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.ДепозитныйСчет
															ИЛИ ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.Иное);
															
	Элементы.СчетТипаС.Видимость = (ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.СчетДоверительногоУправления);
	Элементы.ТранзитныйПИФ.Видимость = Элементы.ВидУправленияДовереннымиСредствами.Видимость
										И ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.Иное
										И ДанныеОбъекта.ВидУправленияДовереннымиСредствами = ПредопределенноеЗначение("Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ");
										
	Элементы.Транзитный.Видимость = НЕ (ДанныеОбъекта.ВидБанковскогоСчета = ВидыБанковскихСчетов.ДепозитныйСчет);
										
	Если НЕ Элементы.ВидУправленияДовереннымиСредствами.Видимость Тогда
		ДанныеОбъекта.ВидУправленияДовереннымиСредствами = Неопределено;
	КонецЕсли;
	
	Если НЕ Элементы.ТранзитныйПИФ.Видимость Тогда
		ДанныеОбъекта.ТранзитныйПИФ = Ложь;	
	КонецЕсли;
	
	Если НЕ Элементы.Транзитный.Видимость Тогда
		ДанныеОбъекта.Транзитный = Ложь;	
	КонецЕсли;
	
	Если НЕ Элементы.СчетТипаС.Видимость Тогда
		ДанныеОбъекта.СчетТипаС = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
