
///////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// договоры видны только тогда, когда юр/физ лицо является упр. организацией или текущеая организация не является упр. компанией
	ЭтаФорма.ОрганизацияВладельца = ПолучитьОрганизациюЮрФизЛица(Объект.ЮрФизЛицо);
	ЭтаФорма.ЮрФизЛицоБанка = Объект.Банк.ЮрФизЛицо;
	
	ЭтаФорма.ЮрФизЛицаОрганизации.ЗагрузитьЗначения(РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицаОрганизации(Объект.Организация, Объект.ДатаОткрытия));
	
	//#ТехническийДолг #КривоносовСЮ - уточнить какая логика скрывается за такой видимостью
	//Элементы.СтраницаДоговоры.Видимость =
	//	(ЗначениеЗаполнено(ЭтаФорма.ОрганизацияВладельца) И ЗначениеЗаполнено(Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Объект.ЮрФизЛицо, "УправляющиеКомпании")))
	//		Или Не ЗначениеЗаполнено(Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(Объект.ЮрФизЛицо, "УправляющиеКомпании"));
		
	// гламурные флажки
	ЭтаФорма.БанковскийСчетЗакрыт	= ЗначениеЗаполнено(Объект.ДатаЗакрытия);
	ЭтаФорма.ОформленДоговорМНО		= ЗначениеЗаполнено(Объект.ДоговорМНО);
	ЭтаФорма.ОткрытПоДоговоруЦессии	= ЗначениеЗаполнено(Объект.ДоговорЦессии);
	
	Если Объект.ПометкаУдаления Тогда
		Элементы.БанковскийСчетЗакрыт.Видимость		= Ложь;
		Элементы.ДатаЗакрытия.Видимость				= Истина;
		Элементы.ДатаЗакрытия.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Авто;
		Элементы.КомандаЗакрытьДоговор.Видимость	= Ложь;
	Иначе
		Элементы.БанковскийСчетЗакрыт.Видимость		= ЭтаФорма.БанковскийСчетЗакрыт;
		Элементы.ДатаЗакрытия.Видимость				= ЭтаФорма.БанковскийСчетЗакрыт;
		Элементы.ДатаЗакрытия.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элементы.КомандаЗакрытьДоговор.Видимость	= Не Элементы.ДатаЗакрытия.Видимость;
	КонецЕсли;
	
	Элементы.ДоговорМНО.Видимость				= ЭтаФорма.ОформленДоговорМНО;
	Элементы.ДоговорЦессии.Видимость			= ЭтаФорма.ОткрытПоДоговоруЦессии;
	
	Элементы.ГруппаВидБанковскогоСчета.Видимость = (ЭтаФорма.ЮрФизЛицаОрганизации.НайтиПоЗначению(Объект.ЮрФизЛицо) <> Неопределено);
	
	// заполним информационные надписи
	ЗаполнитьИнфОБанкеНаСервере("Банк");
	
	Если ЗначениеЗаполнено(Объект.БанкДляРасчетов) Тогда
		ЭтаФорма.ИспользуетсяБанкДляРасчетов = Истина;
		ЗаполнитьИнфОБанкеНаСервере("БанкДляРасчетов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьВидСчетаВнутреннегоУчета();
	КонецЕсли;
	
	ЭтаФорма.Элементы.ГруппаБанкДляРасчетов.Видимость     = ЭтаФорма.ИспользуетсяБанкДляРасчетов;
	ЭтаФорма.Элементы.ГруппаТекстКорреспондента.Видимость = ЭтаФорма.ИспользуетсяБанкДляРасчетов;
	
	// Фильтрация регистра исключений
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ЖурналИсключенияИзРаспределенияАктивов.Отбор, Новый Структура("ИмяПоля, Представление", "Актив", "ПредопределенныйОтборИсключениеПрочихИзРаспределения"),
		"ПредопределенныйОтборИсключениеАктивовИзРаспределения", ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);

	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗначенияРеквизитов") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Объект, Параметры.ЗначенияРеквизитов, "Организация, ЮрФизЛицо, Банк, Валюта, ДатаОткрытия, ВидБанковскогоСчета, ВидУправленияДовереннымиСредствами, Договор"); 	
	КонецЕсли;
	
	Если Объект.Ссылка = Справочники.БанковскиеСчета.ДенежныеСредстваВПути Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Работа с реквизитами данного элемента не поддерживается",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
		
	Элементы.СтраницаЖурналИсключений.Видимость = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ИсключаемыеАктивыСтраховыхКомпаний);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборИПредставлениеДоговора();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Оповестить("РасчетныйСчет.УстановитьЗначение", Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ОформленДоговорМНО И Не ЗначениеЗаполнено(Объект.ДоговорМНО) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Договор МНО"" не заполнено'"),, "ДоговорМНО",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ОткрытПоДоговоруЦессии И Не ЗначениеЗаполнено(Объект.ДоговорЦессии) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Договор цессии"" не заполнено'"),, "ДоговорЦессии",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.БанковскийСчетЗакрыт И Не ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Дата закрытия"" не заполнено'"),, "ДатаЗакрытия",, Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.ИспользуетсяБанкДляРасчетов И Не ЗначениеЗаполнено(Объект.БанкДляРасчетов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Банк для расчетов"" не заполнено'"),, "БанкДляРасчетов",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЭтаФорма.ЮрФизЛицаОрганизации.НайтиПоЗначению(Объект.ЮрФизЛицо) <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет принадлежит организации. Необходимо заполнить договор банковского обслуживания", Объект.Ссылка, "Объект.Договор",, Отказ);
			Возврат;
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаОткрытия) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет принадлежит организации. Необходимо заполнить дату открытия", Объект.Ссылка, "Объект.ДатаОткрытия",, Отказ);
			Возврат;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Объект.ДоговорЦессии) Тогда
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДоговорЦессии, "ДатаЗаключения,ВидДоговора");
		Иначе 
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ДатаЗаключения,ВидДоговора");
		КонецЕсли;
			
		Если Объект.ДатаОткрытия <> РеквизитыДоговора.ДатаЗаключения Тогда
			Отказ = Вопрос(
						СтрШаблон("Дата открытия счёта (%1) не равна дате заключения (%2) договора %3. Продолжить?",
							Формат(Объект.ДатаОткрытия, "ДФ=dd.MM.yyyy"),
							Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yyyy"),
							НРег(РеквизитыДоговора.ВидДоговора)), РежимДиалогаВопрос.ДаНетОтмена) <> КодВозвратаДиалога.Да;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ИсполнителиПоДенежнымСредствамБрокерские"));
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ИсполнителиПоДенежнымСредствамСобственные"));

	// Фильтрация регистра исключений
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.ЖурналИсключенияИзРаспределенияАктивов.Отбор, Новый Структура("ИмяПоля, Представление", "Актив", "ПредопределенныйОтборИсключениеАктивовИзРаспределения"),
		"ПредопределенныйОтборИсключениеАктивовИзРаспределения", ВидСравненияКомпоновкиДанных.Равно, Объект.Ссылка, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто);
		
КонецПроцедуры // ПослеЗаписи

///////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ЮрФизЛицоПриИзменении(Элемент)
	
	ЭтаФорма.ОрганизацияВладельца = ПолучитьОрганизациюЮрФизЛица(Объект.ЮрФизЛицо);
	
	//#ТехническийДолг #КривоносовСЮ
	//Элементы.СтраницаДоговоры.Видимость = ЗначениеЗаполнено(ЭтаФорма.ОрганизацияВладельца);
	
	Элементы.ГруппаВидБанковскогоСчета.Видимость  = (ЭтаФорма.ЮрФизЛицаОрганизации.НайтиПоЗначению(Объект.ЮрФизЛицо) <> Неопределено);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура БанковскийСчетЗакрытПриИзменении(Элемент)
	
	Если Не ЭтаФорма.БанковскийСчетЗакрыт Тогда
		Объект.ДатаЗакрытия = Неопределено;
	КонецЕсли;
	
	Элементы.БанковскийСчетЗакрыт.Видимость		= ЭтаФорма.БанковскийСчетЗакрыт;
	Элементы.ДатаЗакрытия.Видимость				= ЭтаФорма.БанковскийСчетЗакрыт;
	Элементы.КомандаЗакрытьДоговор.Видимость	= Не Элементы.ДатаЗакрытия.Видимость;			
	
КонецПроцедуры

&НаКлиенте
Процедура ОформленДоговорМНОПриИзменении(Элемент)
	
	Элементы.ДоговорМНО.Видимость = ЭтаФорма.ОформленДоговорМНО;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытПоДоговоруЦессииПриИзменении(Элемент)
	
	Элементы.ДоговорЦессии.Видимость = ЭтаФорма.ОткрытПоДоговоруЦессии;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСчетаПриИзменении(Элемент)
	
	Если Не ПустаяСтрока(Объект.НомерСчета) Тогда
		Объект.Валюта = ПолучитьВалютуПоНомеруСчета(Объект.НомерСчета);
	КонецЕсли;
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура БанкПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
	ЗаполнитьИнфОБанкеНаСервере(Элемент.Имя);
	
	ЭтаФорма.ЮрФизЛицоБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Банк, Новый Структура("ЮрФизЛицо", "ЮрФизЛицо")).ЮрФизЛицо;
	
КонецПроцедуры

&НаКлиенте
Процедура БанкДляРасчетовПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
	ЗаполнитьИнфОБанкеНаСервере(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуетсяБанкДляРасчетовПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ИспользуетсяБанкДляРасчетов Тогда
		Объект.БанкДляРасчетов     = Неопределено;
		Объект.ТекстКорреспондента = "";
	КонецЕсли;
	
	ЭтаФорма.Элементы.ГруппаБанкДляРасчетов.Видимость     = ЭтаФорма.ИспользуетсяБанкДляРасчетов;
	ЭтаФорма.Элементы.ГруппаТекстКорреспондента.Видимость = ЭтаФорма.ИспользуетсяБанкДляРасчетов;

КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	РаботаСНормативноСправочнойИнформациейКлиент.УстановитьНовоеНаименование(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидБанковскогоСчетаПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УстановитьОтборИПредставлениеДоговора();	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУправленияДовереннымиСредствамиПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТранзитныйПриИзменении(Элемент)
	
	Если Объект.Транзитный Тогда
		Объект.ТранзитныйПИФ = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТранзитныйПИФПриИзменении(Элемент)
	
	Если Объект.ТранзитныйПИФ Тогда
		Объект.Транзитный = Ложь;
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// КОМАНДЫ

&НаКлиенте
Процедура КомандаЗаполнитьТекстКорреспондента(Команда)
	
	Объект.ТекстКорреспондента = СокрЛП(Объект.ЮрФизЛицо);
		
	Если ЗначениеЗаполнено(Объект.БанкДляРасчетов) Тогда
		Объект.ТекстКорреспондента = Объект.ТекстКорреспондента + " р/с " + СокрЛП(Объект.НомерСчета) + " в " + Строка(Объект.Банк);
		
		Если ЗначениеЗаполнено(Объект.Банк) Тогда
			Объект.ТекстКорреспондента = Объект.ТекстКорреспондента + " " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Банк, "Город");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрытьДоговор(Команда)

	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая()  Тогда
		Если Вопрос("Перед закрытием счета необходимо сохранить внесенные изменения. Сохранить?", РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСФормамиКлиентСервер.ЗаписатьФорму(ЭтаФорма) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДоговорСчета	= РаботаСИсполнителями.ПолучитьДоговор(Объект.Ссылка);	
	КорневойЭлемент	= ?(ЗначениеЗаполнено(ДоговорСчета), ДоговорСчета, Объект.Ссылка); 
	
	АдресДереваДочернихЭлементов = РаботаСИсполнителями.ПолучитьДочерниеЭлементы(КорневойЭлемент, , "ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)", , ЭтаФорма.УникальныйИдентификатор);
	Если ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		ДополнительныеРеквизиты = Новый Массив;
		ДополнительныеРеквизиты.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок, Значение", "ДатаЗакрытия", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), "Дата закрытия", ТекущаяДата()));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("РежимВыбора",					Истина);
		ДополнительныеПараметры.Вставить("МножественныйВыбор",			Истина);
		ДополнительныеПараметры.Вставить("ВидимыеКолонки",				"Представление");
		ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",			Новый Структура("Элемент", Объект.Ссылка));
		ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",		ДополнительныеРеквизиты);
		ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки",	"ДеревоЗначений.ДанныеКартинки");
		ДополнительныеПараметры.Вставить("КартинкаСтрок",				БиблиотекаКартинок.РегистрСведенийЗапись);
		
		РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(АдресДереваДочернихЭлементов, "При закрытии счета будут закрыты дочерние элементы:", ЭтаФорма, РежимДиалогаВопрос.ОКОтмена, КодВозвратаДиалога.ОК, "Закрытие счета", ДополнительныеПараметры);
		Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		РаботаСИсполнителями.ЗакрытьДеревоЭлементов(ДополнительныеПараметры.АдресДереваЗначений, ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
		
		ЭтотОбъект.Прочитать();
	КонецЕсли;	
	
КонецПроцедуры

