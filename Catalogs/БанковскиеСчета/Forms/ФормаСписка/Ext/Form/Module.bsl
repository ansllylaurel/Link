// КОМАНДЫ

&НаКлиенте
Процедура КомандаБанковскиеСчетаПоказатьСкрытьЗакрытые(Команда)
	
	ПоказыватьЗакрытых = Не Элементы.ФормаКомандаПоказатьСкрытьЗакрытые.Пометка;	
	
	Элементы.ФормаКомандаПоказатьСкрытьЗакрытые.Пометка = ПоказыватьЗакрытых;
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.Список.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Не ПоказыватьЗакрытых, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
КонецПроцедуры

