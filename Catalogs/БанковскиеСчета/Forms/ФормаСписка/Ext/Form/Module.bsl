
////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ И ЭЛЕМЕНТОВ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	ИсполнителиСобственные.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	ИсполнителиБрокерские.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
	УстановитьОтборСписковПоРасчетномуСчету(ЭтаФорма, Неопределено);	
	
	// По умолчанию скрываем закрытых
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.Список.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.ИсполнителиСобственные.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.ИсполнителиБрокерские.Отбор, Новый Структура("ИмяПоля, Представление", "Закрыт", "ПредопределенныйОтборЗакрыт"), "ПредопределенныйОтборЗакрыт",
		ВидСравненияКомпоновкиДанных.Равно, Ложь, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто
	);	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	РасчетныйСчет = Элементы.Список.ТекущаяСтрока;		
	
	УстановитьОтборСписковПоРасчетномуСчету(ЭтаФорма, РасчетныйСчет);		
	
КонецПроцедуры

