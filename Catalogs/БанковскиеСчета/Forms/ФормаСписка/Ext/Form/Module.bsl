////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСписковПоРасчетномуСчету(ЭтаФорма, РасчетныйСчет)
	
	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.ИсполнителиСобственные.Отбор, "РасчетныйСчет", ,
		ВидСравненияКомпоновкиДанных.Равно, РасчетныйСчет, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ
	);

	РаботаСНастройкамиСписковКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.ИсполнителиБрокерские.Отбор, "РасчетныйСчет", ,
		ВидСравненияКомпоновкиДанных.Равно, РасчетныйСчет, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ
	);
		
КонецПроцедуры