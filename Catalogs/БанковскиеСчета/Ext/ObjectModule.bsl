
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("НомерСчета") И Не ДанныеЗаполнения.Свойство("Валюта") Тогда
			ЭтотОбъект.Валюта = Справочники.БанковскиеСчета.ПолучитьВалютуПоНомеруСчета(ДанныеЗаполнения.НомерСчета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект,
		"НомерСчета, Валюта, ТекстНазначения, ТекстКорреспондента, Договор, ДоговорМНО, ДатаОткрытия, ДатаЗакрытия, Комментарий");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ЮрФизЛицо = ЭтотОбъект.Организация.ЮрФизЛицо
		ИЛИ ЭтотОбъект.ЮрФизЛицо = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЭтотОбъект.Организация.ЮрФизЛицо)
	Тогда
	
		ПроверяемыеРеквизиты.Добавить("ВидБанковскогоСчета");
	
		Если ЭтотОбъект.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.СчетДоверительногоУправления
			ИЛИ ЭтотОбъект.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет
			ИЛИ ЭтотОбъект.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.Иное
		Тогда
			ПроверяемыеРеквизиты.Добавить("ВидУправленияДовереннымиСредствами");
		КонецЕсли;	
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	РаботаСоСправочниками.ПередЗаписью(ЭтотОбъект);
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		
		УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ВидУправленияДовереннымиСредствами) Тогда
			// вид управления доверенными средствами актуален только для счетов доверительного управления
			Если ЭтотОбъект.ВидБанковскогоСчета <> Перечисления.ВидыБанковскихСчетов.СчетДоверительногоУправления
			   И ЭтотОбъект.ВидБанковскогоСчета <> Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет 
			   И ЭтотОбъект.ВидБанковскогоСчета <> Перечисления.ВидыБанковскихСчетов.Иное Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вид управления доверенными средствами"" может быть заполнено только для счетов доверительного управления, депозитных и иных счетов", ЭтотОбъект, "ВидУправленияДовереннымиСредствами",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.Организация.ЮрФизЛицо <> ЭтотОбъект.ЮрФизЛицо И ЭтотОбъект.ЮрФизЛицо <> РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(ЭтотОбъект.Организация.ЮрФизЛицо) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вид управления доверенными средствами"" может быть заполнено только для владельца """ + ЭтотОбъект.Организация.ЮрФизЛицо + "", ЭтотОбъект, "ВидУправленияДовереннымиСредствами",, Отказ);
			КонецЕсли;
			
			// значением поля может быть только одно из допустимых значенией
			ДопустимыеВидыУправленияДовереннымиСредствами = Новый Массив;
			ДопустимыеВидыУправленияДовереннымиСредствами.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ);
			ДопустимыеВидыУправленияДовереннымиСредствами.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
			
			Если ДопустимыеВидыУправленияДовереннымиСредствами.Найти(ЭтотОбъект.ВидУправленияДовереннымиСредствами) = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Вид управления доверенными средствами"" содержит недопустимое значение", ЭтотОбъект, "ВидУправленияДовереннымиСредствами",, Отказ);
			КонецЕсли;
		КонецЕсли;			
		
		Если ЭтотОбъект.Транзитный 
		   И ЭтотОбъект.ВидБанковскогоСчета = Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет Тогда
		   ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Признак Транзитный нельзя устанавливать для банковских счетов вида 'Cчет по вкладу (депозиту)'",,,, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.ТранзитныйПИФ 
		   И ЭтотОбъект.ВидБанковскогоСчета <> Перечисления.ВидыБанковскихСчетов.Иное Тогда
		   ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Признак Транзитный ПИФ можно устанавливать только для банковских счетов вида 'иное'",,,, Отказ);
		КонецЕсли;
		
		// контроль уникальности номера счета
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БанковскиеСчета.Ссылка КАК Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(БанковскиеСчета.ЮрФизЛицо) КАК ЮрФизЛицо
			|ИЗ
			|	Справочник.БанковскиеСчета КАК БанковскиеСчета
			|ГДЕ
			|	БанковскиеСчета.НомерСчета = &НомерСчета
			|	И БанковскиеСчета.Организация = &Организация
			|	И БанковскиеСчета.Ссылка <> &Ссылка
			|	И НЕ БанковскиеСчета.ПометкаУдаления
			|	И ВЫБОР
			|			КОГДА &ЮрФизЛицоБанка = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
			|				ТОГДА НЕ БанковскиеСчета.Банк.ЭтоТерриториальныйОрганФедеральногоКазначейства
			|						ИЛИ БанковскиеСчета.ЮрФизЛицо = &ЮрФизЛицо
			|			ИНАЧЕ БанковскиеСчета.Банк.ЮрФизЛицо <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)
			|		КОНЕЦ"; 		
		
		Запрос.УстановитьПараметр("НомерСчета",  	ЭтотОбъект.НомерСчета);
		Запрос.УстановитьПараметр("Банк",        	ЭтотОбъект.Банк);
		Запрос.УстановитьПараметр("ЮрФизЛицо",   	ЭтотОбъект.ЮрФизЛицо);
		Запрос.УстановитьПараметр("ЮрФизЛицоБанка", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Банк, "ЮрФизЛицо"));
		Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);		
		Запрос.УстановитьПараметр("Ссылка",      	ЭтотОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номер счета совпадает со счетом " + Выборка.Ссылка + " юр/физ лица " + Выборка.ЮрФизЛицо, ЭтотОбъект, "НомерСчета",, Отказ);
		КонецЦикла; 
		
		// контроль заполнения договора и договора МНО в банковских счетах управляющей компании
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПРЕДСТАВЛЕНИЕ(Организации.Ссылка) КАК ОрганизацияПредставление
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.Ссылка = &Организация
			|	И Организации.ЮрФизЛицо = &ЮрФизЛицо";
			
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ЮрФизЛицо",   ЭтотОбъект.ЮрФизЛицо);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
		
			Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет принадлежит юр/физ лицу организации " + Выборка.ОрганизацияПредставление + ". Необходимо заполнить договор банковского обслуживания", ЭтотОбъект, "Договор",, Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.ДатаОткрытия) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет принадлежит юр/физ лицу организации " + Выборка.ОрганизацияПредставление + ". Необходимо заполнить дату открытия", ЭтотОбъект, "ДатаОткрытия",, Отказ);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Справочники.ЮрФизЛица.ПолучитьФункциональнуюРоль(ЭтотОбъект.ЮрФизЛицо, "УправляющиеКомпании")) Тогда // страховые компании вводят клиентские договоры
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет не принадлежит юр/физ лицу организации " + Выборка.ОрганизацияПредставление + ". Необходимо очистить договор банковского обслуживания", ЭтотОбъект, "Договор",, Отказ);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭтотОбъект.ДоговорМНО) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Банковский счет не принадлежит юр/физ лицу организации " + Выборка.ОрганизацияПредставление + ". Необходимо очистить договор МНО", ЭтотОбъект, "ДоговорМНО",, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		// проверим дату расторжения договора
		Если ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
			ДатаРасторженияДоговора = Справочники.Договоры.ПолучитьДатуРасторженияДоговора(ЭтотОбъект.Договор);
			
			Если ЗначениеЗаполнено(ДатаРасторженияДоговора) И (ЭтотОбъект.ДатаЗакрытия > ДатаРасторженияДоговора ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаЗакрытия)) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата закрытия счета не должна быть позднее даты расторжения договора.", ЭтотОбъект, "ДатаЗакрытия", , Отказ);
			КонецЕсли;
		КонецЕсли;		
		
		// проверим даты закрытия разделов и исполнителей
		Если Не ЭтотОбъект.ЭтоНовый() И ЗначениеЗаполнено(ЭтотОбъект.ДатаЗакрытия) Тогда
			РаботаСИсполнителями.ПроверитьДатыЗакрытияДочернихЭлементов(ЭтотОбъект, Отказ);
		КонецЕсли;		
		
		КонтрольВидаБанковскихСчетов(Отказ);
		КонтрольВидаДоговора(Отказ);
	КонецЕсли;
		
КонецПроцедуры // ПередЗаписью

Процедура КонтрольВидаБанковскихСчетов(Отказ)
	
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") Тогда
		//Проверка только для управляющих компаний
		//ДК ошибочно попадает в проверку. #ТехническийДолг #Архитектор #Аналитик
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация КАК Организация,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ ВТ_Исполнители
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = &РасчетныйСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Исполнители.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_Исполнители.РасчетныйСчет КАК РасчетныйСчет,
		|	ЕСТЬNULL(ВидыДеятельностиЛицензий.ЛицензияУказана, ЛОЖЬ) КАК ЛицензияУказана,
		|	ВЫБОР
		|		КОГДА ВТ_Исполнители.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.РасчетныйСчет) = &ВидБанковскогоСчета
		|		ИНАЧЕ &ВидБанковскогоСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.СчетДоверительногоУправления), ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.Иное))
		|	КОНЕЦ КАК КонтрольВидБанковскогоСчета,
		|	ВТ_Исполнители.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|		ИЛИ ВидыДеятельностиЛицензий.ЕстьЛицензияНужногоВида КАК КонтрольВидУправленияДовереннымиСредствами
		|ИЗ
		|	ВТ_Исполнители КАК ВТ_Исполнители
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УправляющиеКомпании КАК УправляющиеКомпании
		|		ПО ВТ_Исполнители.Организация.ЮрФизЛицо = УправляющиеКомпании.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			ИСТИНА КАК ЛицензияУказана,
		|			МАКСИМУМ(ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности = &ВидУправленияДовереннымиСредствами) КАК ЕстьЛицензияНужногоВида
		|		ИЗ
		|			РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|		ГДЕ
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления) КАК ВидыДеятельностиЛицензий
		|		ПО ВТ_Исполнители.СчетДоверительногоУправления = ВидыДеятельностиЛицензий.СчетДоверительногоУправления
		|ГДЕ
		|	(НЕ ЕСТЬNULL(ВидыДеятельностиЛицензий.ЛицензияУказана, ЛОЖЬ)
		|			ИЛИ НЕ ВЫБОР
		|					КОГДА ВТ_Исполнители.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.РасчетныйСчет) = &ВидБанковскогоСчета
		|					ИНАЧЕ &ВидБанковскогоСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.СчетДоверительногоУправления), ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.Иное))
		|				КОНЕЦ
		|			ИЛИ НЕ(ВТ_Исполнители.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|					ИЛИ ВидыДеятельностиЛицензий.ЕстьЛицензияНужногоВида))";
	
	Запрос.УстановитьПараметр("РасчетныйСчет"						, ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация"							, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидБанковскогоСчета"					, ЭтотОбъект.ВидБанковскогоСчета);
	Запрос.УстановитьПараметр("ВидУправленияДовереннымиСредствами"	, ЭтотОбъект.ВидУправленияДовереннымиСредствами);
	Запрос.УстановитьПараметр("ТекущаяДата"							, ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ЛицензияУказана Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета внутреннего учёта '" + Строка(Выборка.СчетДоверительногоУправления) + "' не задана лицензия, в рамках которой осуществляется управление активами", Выборка.СчетДоверительногоУправления,,, Отказ);
			Продолжить;
		КонецЕсли;
		
		Если НЕ Выборка.КонтрольВидБанковскогоСчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В расчётном счёте " + Выборка.РасчетныйСчет + " неверно указан 'Вид банковского счета'", ЭтотОбъект, "ВидБанковскогоСчета",, Отказ);
		КонецЕсли;
			
		Если НЕ Выборка.КонтрольВидУправленияДовереннымиСредствами Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В расчётном счёте " + Выборка.РасчетныйСчет + " поле 'Управление средствами' не соответствует условиям договора доверительного управления", ЭтотОбъект, "ВидУправленияДовереннымиСредствами",, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура КонтрольВидаДоговора(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ВидыДоговоров = Справочники.Договоры.ВидыДоговоровБанковскогоОбслуживания(ЭтотОбъект.ВидБанковскогоСчета);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.ДополнительноеСоглашение); //доп. соглашение к договорам вида Банковского обслуживания можно 
	
	Если ВидыДоговоров.Найти(ЭтотОбъект.Договор.ВидДоговора) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя выбирать договор вида '" + ЭтотОбъект.Договор.ВидДоговора + "'", ЭтотОбъект, "Договор",, Отказ);
		Возврат;
	КонецЕсли;
	
	ПроверенныеДоговора = Новый Массив;
	
	ТекущийДоговор = ЭтотОбъект.Договор;
	
	Пока ТекущийДоговор.ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Цикл
		Если ПроверенныеДоговора.Найти(ТекущийДоговор) = Неопределено Тогда
			ПроверенныеДоговора.Добавить(ТекущийДоговор);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка в структуре договоров, обратитесь в службу поддержки", ЭтотОбъект, "Договор",, Отказ);
			Возврат; //Защита от зацикливания
		КонецЕсли;
		
		ТекущийДоговор = ТекущийДоговор.Основание;
		
		Если ТипЗнч(ТекущийДоговор) <> Тип("СправочникСсылка.Договоры") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя выбирать доп. соглашение, в основании которого " + ТипЗнч(ТекущийДоговор), ЭтотОбъект, "Договор",, Отказ);
			Возврат;
		КонецЕсли;
		
		Если ВидыДоговоров.Найти(ТекущийДоговор.ВидДоговора) = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя выбирать доп. соглашение, в основании которого договор вида '" + ЭтотОбъект.Договор.ВидДоговора + "'", ЭтотОбъект, "Договор",, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

