
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыСправочника(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Наименование, НомерДоговора, ДатаЗаключения, НаименованиеВладельцаДляДокументов");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	ЭтотОбъект.ВидДоговора = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания;
	
	// блокирующие проверки
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		Если Не ЭтотОбъект.ОбменДанными.Загрузка Тогда
			
			УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
			
			Если Не РаботаСНормативноСправочнойИнформацией.ЭтоУникальныйДоговор(ЭтотОбъект) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Договор с такими номером и датой уже был заключен", ЭтотОбъект, "НомерДоговора",, Отказ);
			КонецЕсли;
			
			Если Не ЭтотОбъект.ЭтоНовый() Тогда
				РеквизитыДоговора = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(ЭтотОбъект.Ссылка, "ДатаРасторжения");
				Если ЗначениеЗаполнено(РеквизитыДоговора.ДатаРасторжения) И ЭтотОбъект.ДатаЗаключения > РеквизитыДоговора.ДатаРасторжения Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата заключения договора больше даты расторжения", ЭтотОбъект, "ДатаЗаключения",, Отказ);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(РеквизитыДоговора.ДатаРасторжения) Тогда
					РаботаСИсполнителями.ПроверитьДатыЗакрытияДочернихЭлементов(ЭтотОбъект, Отказ);
				КонецЕсли;
			КонецЕсли;		
			
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ДоговорСчетаДоверительногоУправления") Тогда
		РегистрыСведений.ДоговорыСчетовДоверительногоУправления.ДобавитьСвязьДоговораИСчетаДоверительногоУправления(
			ЭтотОбъект.ДатаЗаключения,
			ЭтотОбъект,
			ЭтотОбъект.ДополнительныеСвойства.ДоговорСчетаДоверительногоУправления,
			Отказ);
	КонецЕсли;	
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ДатаРасторжения") Тогда
		РегистрыСведений.УсловияДоговоровОбщие.ДобавитьДатуРасторжения(ЭтотОбъект.ДатаЗаключения, ЭтотОбъект, ЭтотОбъект.ДополнительныеСвойства.ДатаРасторжения);
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("УсловиеДоговораБрокерскогоОбслуживания") 
		И ТипЗнч(ЭтотОбъект.ДополнительныеСвойства.УсловиеДоговораБрокерскогоОбслуживания) = Тип("Структура") Тогда
			
		УсловияДоговоровМенеджерЗаписи = РегистрыСведений.УсловияДоговоровБрокерскогоОбслуживания.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(УсловияДоговоровМенеджерЗаписи, ЭтотОбъект.ДополнительныеСвойства.УсловиеДоговораБрокерскогоОбслуживания);
		УсловияДоговоровМенеджерЗаписи.Договор = ЭтотОбъект.Ссылка;
		УсловияДоговоровМенеджерЗаписи.Записать();
		
	КонецЕсли;
	
КонецПроцедуры