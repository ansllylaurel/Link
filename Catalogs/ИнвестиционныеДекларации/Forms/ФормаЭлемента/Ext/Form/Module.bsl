#Область Общие_обработчики_элементов_отбора

&НаКлиенте
Процедура ОтборНачалоВыбора(Элемент, СтандартнаяОбработка, ПараметрыПолей)
	
	СтандартнаяОбработка = Ложь;
	
	СписокГрупп = Новый СписокЗначений;
	
	Для каждого СтрокаГруппы Из Объект[ПараметрыПолей.ТаблицаГруппы] Цикл
		СписокГрупп.Добавить(СтрокаГруппы.Идентификатор, СтрокаГруппы.Имя);
	КонецЦикла;
	
	ТекСтрока = Элементы.Показатели.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Элемент", ТекСтрока[ПараметрыПолей.ПолеЭлемент]);
	ПараметрыФормы.Вставить("Группа", ТекСтрока[ПараметрыПолей.ПолеГруппа]);
	Если ПараметрыПолей.Свойство("ПолеВключаяФилиалы") Тогда
		
		Если Не ЗначениеЗаполнено(ТекСтрока[ПараметрыПолей.ПолеЭлемент])
			И Не ЗначениеЗаполнено(ТекСтрока[ПараметрыПолей.ПолеГруппа]) Тогда
			ТекСтрока.ВключаяФилиалы = Истина;
		КонецЕсли; 
		
		ПараметрыФормы.Вставить("ВключаяФилиалы", ТекСтрока.ВключаяФилиалы);
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СписокГрупп", СписокГрупп);
	ПараметрыФормы.Вставить("ПараметрыПолей", ПараметрыПолей);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Элементы.Показатели.ТолькоПросмотр);
	
	Результат = ОткрытьФормуМодально("Справочник.ИнвестиционныеДекларации.Форма.ФормаНастройкиОтбора", ПараметрыФормы, Элемент);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ТекСтрока, Результат);
		
		ЗаполнитьОтбор(ТекСтрока, ПараметрыПолей);
		
		ЭтаФорма.Модифицированность = Истина;
		Элементы.Показатели.ТекущиеДанные.ИдентификаторСКДНабора = Неопределено;
	    
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОчистка(СтандартнаяОбработка, ПараметрыПолей)

	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.Показатели.ТекущиеДанные;
	
	ТекСтрока[ПараметрыПолей.ПолеЭлемент] = Неопределено;
	ТекСтрока[ПараметрыПолей.ПолеГруппа] = Неопределено;
	
	Если ПараметрыПолей.Свойство("ПолеВключаяФилиалы") Тогда
	
		ТекСтрока[ПараметрыПолей.ПолеВключаяФилиалы] = Неопределено;
	
	КонецЕсли; 
	
	ЗаполнитьОтбор(ТекСтрока, ПараметрыПолей);
	
	ЭтаФорма.Модифицированность = Истина;
	Элементы.Показатели.ТекущиеДанные.ИдентификаторСКДНабора = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаПриАктивизацииСтроки(Элемент, ЭлементСоставГруппы)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ИдентификаторТекущейГруппы = Неопределено;
		ЭлементСоставГруппы.Доступность = Ложь;
	Иначе
		ИдентификаторТекущейГруппы = ТекущиеДанные.Идентификатор;
		ЭлементСоставГруппы.Доступность = Истина;
	КонецЕсли;
	
	Если ИдентификаторТекущейГруппы = Неопределено ИЛИ ЗначениеЗаполнено(ИдентификаторТекущейГруппы) Тогда	
		ЭлементСоставГруппы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Группа", ИдентификаторТекущейГруппы));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование, Таблица, ПодчиненныйЭлемент)

	Если НоваяСтрока Тогда
		
		ИдентификаторНовойГруппы			= Новый УникальныйИдентификатор;
		ИдентификаторКопируемойГруппы		= Элемент.ТекущиеДанные.Идентификатор;
		Элемент.ТекущиеДанные.Идентификатор	= ИдентификаторНовойГруппы;
		
		Если Копирование Тогда			
			
			КопируемыеПараметры = Таблица.НайтиСтроки(Новый Структура("Группа", ИдентификаторКопируемойГруппы));
			
			Для Каждого СтрокаПараметров Из КопируемыеПараметры Цикл
				
				НоваяСтрокаПараметров = Таблица.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПараметров, СтрокаПараметров, , "Группа");
				НоваяСтрокаПараметров.Группа = ИдентификаторНовойГруппы;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ПодчиненныйЭлемент.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Группа", ИдентификаторНовойГруппы));	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Таблица)

	Если НоваяСтрока И ОтменаРедактирования Тогда
		ОчиститьСоставГруппы(Элемент.ТекущиеДанные.Идентификатор, Таблица);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСоставГруппы(ИдентификаторГруппы, Таблица)
	
	Для Инд = 1 - Таблица.Количество() По 0 Цикл
		Если Таблица[-Инд].Группа = ИдентификаторГруппы Тогда
			Таблица.Удалить(-Инд);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЭлементыТекущейГруппыПриНачалеРедактирования(Элемент, НоваяСтрока, ЭлементГруппы)

	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.Группа = ЭлементГруппы.ТекущиеДанные.Идентификатор;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЭлементГруппыПриИзменении(ПараметрыПолей)

	ТекСтрока = Элементы[ПараметрыПолей.ТаблицаЭлементов].ТекущиеДанные;
	СтрокиПоГруппе = Объект.Показатели.НайтиСтроки(Новый Структура(ПараметрыПолей.ПолеГруппа, ТекСтрока.Группа));
	Для каждого Строка Из СтрокиПоГруппе Цикл
		Строка.ИдентификаторСКДНабора = Неопределено;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти 

&НаСервере
Процедура ЗаполнитьПараметрыПолейОтбора()

	ЭтаФорма.ПараметрыПолейЭмитентов = Новый Структура;
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ПолеЭлемент", 		"Эмитент");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ПолеГруппа", 		"ГруппаЭмитентов");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ПолеГруппаИмя", 		"ГруппаЭмитентовИмя");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ПолеОтбор", 			"ОтборПоЭмитенту");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ПолеВключаяФилиалы", "ВключаяФилиалы");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ТаблицаГруппы", 		"ГруппыЭмитентов");
	ЭтаФорма.ПараметрыПолейЭмитентов.Вставить("ТаблицаЭлементов", 	"ЭмитентыТекущейГруппы");
	
	ЭтаФорма.ПараметрыПолейЦенныхБумаг = Новый Структура;
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ПолеЭлемент", 		"ЦеннаяБумага");
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ПолеГруппа", 		"ГруппаЦенныхБумаг");
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ПолеГруппаИмя", 	"ГруппаЦенныхБумагИмя");
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ПолеОтбор", 		"ОтборПоЦеннойБумаге");
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ТаблицаГруппы", 	"ГруппыЦенныхБумаг");
	ЭтаФорма.ПараметрыПолейЦенныхБумаг.Вставить("ТаблицаЭлементов", "ЦенныеБумагиТекущейГруппы");
	
КонецПроцедуры  

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОтбор(ТекСтрока, ПараметрыПолей)

	ПолеЭлемент = ТекСтрока[ПараметрыПолей.ПолеЭлемент];
	ПолеГруппа = ТекСтрока[ПараметрыПолей.ПолеГруппа];
	ПолеГруппаИмя = ТекСтрока[ПараметрыПолей.ПолеГруппаИмя];
	
	Если ЗначениеЗаполнено(ПолеЭлемент) Или ЗначениеЗаполнено(ПолеГруппа) Тогда
		ТекСтрока[ПараметрыПолей.ПолеОтбор] = ?(ЗначениеЗаполнено(ПолеЭлемент), Строка(ПолеЭлемент), "Группа " + ПолеГруппаИмя);		
	Иначе
		ТекСтрока[ПараметрыПолей.ПолеОтбор] = "";
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьИмяГруппы(ТекСтрока, ПараметрыПолей)

	ПолеГруппа = ТекСтрока[ПараметрыПолей.ПолеГруппа];
	ТаблицаГруппы = Объект[ПараметрыПолей.ТаблицаГруппы];
	
	Если ЗначениеЗаполнено(ПолеГруппа) Тогда
		// определим имя группы
		ГруппыЭлементовПоИдентификатору = ТаблицаГруппы.НайтиСтроки(Новый Структура("Идентификатор", ПолеГруппа));
		
		Если ГруппыЭлементовПоИдентификатору.Количество() > 0 Тогда
			ТекСтрока[ПараметрыПолей.ПолеГруппаИмя] = ГруппыЭлементовПоИдентификатору[0].Имя;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказателиЗапретПокупкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.Показатели.ТекущиеДанные;
	Если Не ТекДанные.ЗапретПокупки Тогда
		ТекДанные.ДатаЗапретаПокупки = Неопределено;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиДатаЗапретаПокупкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.Показатели.ТекущиеДанные;
	ТекДанные.ЗапретПокупки = ЗначениеЗаполнено(ТекДанные.ДатаЗапретаПокупки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИмяФайлаЛимитнойВедомости) Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Объект КАК Объект,
			|	ДополнительныеСведения.Ссылка КАК Свойство,
			|	&ИмяФайлаЛимитнойВедомости КАК Значение
			|ИЗ
			|	ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
			|ГДЕ
			|	ДополнительныеСведения.Ключ = ""Справочник.ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости""";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Объект", ТекущийОбъект.Ссылка);
		Запрос.УстановитьПараметр("ИмяФайлаЛимитнойВедомости", ЭтаФорма.ИмяФайлаЛимитнойВедомости);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
		
			Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Записать();			
		
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИмяФайлаЛимитнойВедомости()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеСведения.Ключ КАК Ключ,
		|	ДополнительныеСведения.Ссылка КАК Свойство,
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО (ЗначенияДополнительныхСведений.Свойство = ДополнительныеСведения.Ссылка)
		|			И (ЗначенияДополнительныхСведений.Объект = &Объект)
		|ГДЕ
		|	ДополнительныеСведения.Ключ = ""Справочник.ИнвестиционныеДекларации.ИмяФайлаЛимитнойВедомости""";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
		
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		ЭтаФорма.ИмяФайлаЛимитнойВедомости = Выборка.Значение;
	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Показатели.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ Показатели
		|ИЗ
		|	&Показатели КАК Показатели
		|ГДЕ
		|	Показатели.ЗапретПокупки
		|	И Показатели.ДатаЗапретаПокупки = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Показатели.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Показатели КАК Показатели";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Показатели", Объект.Показатели.Выгрузить(, "НомерСтроки, ЗапретПокупки, ДатаЗапретаПокупки"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрШаблон("В строке №%1 не заполнена дата запрета покупки", Выборка.НомерСтроки);
		Поле = СтрШаблон("Объект.Показатели[%1].ЗапретПокупки", Выборка.НомерСтроки - 1);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле,, Отказ); 
	
	КонецЦикла;
	
КонецПроцедуры
 

#КонецОбласти 