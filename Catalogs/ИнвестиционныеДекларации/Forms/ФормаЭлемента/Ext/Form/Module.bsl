&НаКлиенте
Процедура ГруппыЭмитентовПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
    ПроверитьСсылкиНаГруппу(ТекущиеДанные, ЭтаФорма.ПараметрыПолейЭмитентов, Отказ);
	
	Если Не Отказ Тогда
	
		ОчиститьСоставГруппы(ТекущиеДанные.Идентификатор, Объект.Эмитенты);
	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСсылкиНаГруппу(ТекущиеДанные, ПараметрыПолей, Отказ)
	
	НайденныеСтроки = Объект.Показатели.НайтиСтроки(Новый Структура(ПараметрыПолей.ПолеГруппа, ТекущиеДанные.Идентификатор));
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Если НайденныеСтроки.Количество() = 1 Тогда
			
			Подстрока = "строке " + НайденныеСтроки[0].НомерСтроки;
			
		Иначе
			
			НомераСтрок = Новый Массив;
			
			Для каждого Строка Из НайденныеСтроки Цикл
				НомераСтрок.Добавить(Строка.НомерСтроки);
			КонецЦикла;
			
			Подстрока = "строках " + СтрСоединить(НомераСтрок, ", ");
			
		КонецЕсли;
		
		ТекстВопроса = СтрШаблон("Группа '%1' используется в %2. 
		|Ссылки будут очищены. Продолжить?", 
		ТекущиеДанные.Имя,
		Подстрока);
		
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
			Для каждого Строка Из НайденныеСтроки Цикл
				Строка[ПараметрыПолей.ПолеГруппа] = Неопределено;
				Строка[ПараметрыПолей.ПолеГруппаИмя] = "";
				Строка[ПараметрыПолей.ПолеОтбор] = "";
			КонецЦикла;
		Иначе 
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

