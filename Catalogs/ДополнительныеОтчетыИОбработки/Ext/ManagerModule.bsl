
// Возвращает таблицу значений с основным свойствами дополнительных отчетов или обработок.
//
// Возвращаемое значение: 
//    ТаблицаЗначений(ИмяОбъекта, Вид, Наименование, Информация, Версия, ДоступенИнтерактивно)
//
Функция ПолучитьВерсииДополнительныхОбработокМД() Экспорт
	
	ВерсииОбработок = Новый ТаблицаЗначений;
	ВерсииОбработок.Колонки.Добавить("ИмяОбъекта", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Информация", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("ДоступенИнтерактивно", Новый ОписаниеТипов("Строка"));
	
	// Обработки
	МетаОписаниеОбъектов = Метаданные.Обработки;
	Для Каждого МетаОписание Из МетаОписаниеОбъектов Цикл
		ОбработкаОбъект = Обработки[МетаОписание.Имя].Создать();
		
		ДобавитьСведенияОВнешнейОбработке(ВерсииОбработок, ОбработкаОбъект, МетаОписание.Имя);
	КонецЦикла;
	
	// Отчеты
	МетаОписаниеОбъектов = Метаданные.Отчеты;
	Для Каждого МетаОписание Из МетаОписаниеОбъектов Цикл
		ОбработкаОбъект = Отчеты[МетаОписание.Имя].Создать();
		
		ДобавитьСведенияОВнешнейОбработке(ВерсииОбработок, ОбработкаОбъект, МетаОписание.Имя);
	КонецЦикла;
	
	Возврат ВерсииОбработок;
	
КонецФункции

// Возвращает таблицу значений с основным свойствами дополнительных отчетов или обработок, сохраненных в БД
//
// Возвращаемое значение: 
//    ТаблицаЗначений(ИмяОбъекта, Вид, Наименование, Информация, Версия, ДоступенИнтерактивно)
//
Функция ПолучитьВерсииДополнительныхОбработокИБ() Экспорт
	
	ВерсииОбработок = Новый ТаблицаЗначений;
	ВерсииОбработок.Колонки.Добавить("ИмяОбъекта", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Информация", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("ДоступенИнтерактивно", Новый ОписаниеТипов("Строка"));
	ВерсииОбработок.Колонки.Добавить("Ответственный", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	
	ВыборкаОбработок = Справочники.ДополнительныеОтчетыИОбработки.Выбрать();
	Пока ВыборкаОбработок.Следующий() Цикл
		Если ВыборкаОбработок.ЭтоГруппа ИЛИ ВыборкаОбработок.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ВерсииОбработок.Добавить(), ВыборкаОбработок);
	КонецЦикла;
	
	Возврат ВерсииОбработок;
	
КонецФункции

Процедура ДобавитьСведенияОВнешнейОбработке(ВерсииОбработок, ОбработкаОбъект, ИмяОбъекта)
	
	Попытка
		РегистрационныеДанные = ОбработкаОбъект.СведенияОВнешнейОбработке();
	Исключение
		Возврат;	
	КонецПопытки;	
	
	ОписаниеОбрабоки = ВерсииОбработок.Добавить();
	ЗаполнитьЗначенияСвойств(ОписаниеОбрабоки, РегистрационныеДанные);
	ОписаниеОбрабоки.ИмяОбъекта = ИмяОбъекта;
	Если ТипЗнч(РегистрационныеДанные.Вид) <> Тип("ПеречислениеСсылка.ВидыДополнительныхОтчетовИОбработок") Тогда
		ОписаниеОбрабоки.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок[РегистрационныеДанные.Вид];
	КонецЕсли;
	
КонецПроцедуры
