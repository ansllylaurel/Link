
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформлениеНаСервере();
	
	// видимость идентификаторов параметров
	Элементы.ФормаКомандаПоказатьИдентификаторы.Видимость = РольДоступна("ПолныеПрава");
	Элементы.ФормаКомандаПоказатьИдентификаторы.Пометка   = Ложь; //РольДоступна("ПолныеПрава");
	
	// Проверка возможности загрузки новых обработок в информационную базу
	ЭтаФорма.ЭтоНовый = Объект.Ссылка.Пустая();
	
	Если ЭтаФорма.ЭтоНовый И Не РаботаСДополнительнымиОтчетамиИОбработками.ЕстьПравоИнтерактивнойРаботы() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав доступа для добавления дополнительных отчетов или обработок'");
	КонецЕсли;
	
	ЭтаФорма.ВидДополнительнаяОбработка = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка;
	ЭтаФорма.ВидДополнительныйОтчет     = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;

	РегистрацияОбработки = Ложь;
	
	Если Не ЭтаФорма.ЭтоНовый Тогда
		ЭтаФорма.ДоступныеКоманды.Загрузить(РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьТаблицуДоступныхКоманд(Объект.Ссылка));
	КонецЕсли; 
	
	ЗаполнитьКомандыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЭтаФорма.АдресФайла = ПоместитьВоВременноеХранилище(ТекущийОбъект.ХранилищеФайла.Получить(), ЭтаФорма.УникальныйИдентификатор);
	
	Для Инд = 0 По ТекущийОбъект.Скриншоты.Количество() - 1 Цикл
		Объект.Скриншоты[Инд].Адрес = ПоместитьВоВременноеХранилище(ТекущийОбъект.Скриншоты[Инд].Хранилище.Получить(), ЭтаФорма.УникальныйИдентификатор);
	КонецЦикла;
		
	ОтобразитьСкриншотыНаСервере();
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтаФорма.ЭтоНовый И Не ОткрытьДиалогЗагрузкиФайла() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	КомандаПоказатьИдентификаторы(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не Параметры.Ключ.Пустая() Тогда
		МассивКоманд = ПолучитьМассивКомандКПерезапуску();
		Если МассивКоманд.Количество() > 0 Тогда
			СписокКоманд = СтрСоединить(МассивКоманд, "; " + Символы.ПС);
			ПодстрокаВопроса = ?(МассивКоманд.Количество() = 1, "будет перезапущено задание:", "будут перезапущены следующие задания:");
			ТекстВопроса = "После записи " + ПодстрокаВопроса + "
				|" + СписокКоманд + ".
				|Продолжить?";
			Отказ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет; 
		КонецЕсли;			
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтаФорма.РегистрацияОбработки Тогда
		
		// перенесем в объект файл отчета (обработки)
		ТекущийОбъект.ХранилищеФайла = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ЭтаФорма.АдресФайла), Новый СжатиеДанных(9));
		
		// перенесем в объект скриншоты
		Для Инд = 0 По Объект.Скриншоты.Количество() - 1 Цикл
			ТекущийОбъект.Скриншоты[Инд].Хранилище = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(Объект.Скриншоты[Инд].Адрес), Новый СжатиеДанных(9));
		КонецЦикла;
		
		// отметим факт регистрации
		ЭтаФорма.РегистрацияОбработки = Ложь;
		
	КонецЕсли;
	
	Если Объект.Вид = ВидДополнительнаяОбработка Или Объект.Вид = ВидДополнительныйОтчет Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("АктуальныеКоманды", Объект.Команды.Выгрузить());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтоНовый = Ложь;
	
	ЗаполнитьКомандыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область События_таблицы_команд

&НаКлиенте
Процедура ОбъектКомандыПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ОбъектКоманды.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ОбъектКоманды.ТекущийЭлемент = Элементы.ОбъектКомандыВыполнить Тогда
		Отказ = Истина;
		
		Если ЭтаФорма.Модифицированность Тогда
			Предупреждение("Перед выполнением команды необходимо записать изменения");
			Возврат;
		КонецЕсли;
		
		РаботаСДополнительнымиОтчетамиИОбработками.ВыполнитьКоманду(Новый Структура("ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ГруппаПараметров", Объект.Ссылка, ТекущиеДанные.Идентификатор, ТекущиеДанные.ГруппаПараметров), Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыРегламентноеЗаданиеИспользованиеПриИзменении(Элемент)
	
	ИзменитьРегламентноеЗадание(Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыРегламентноеЗаданиеПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИзменитьРегламентноеЗадание(Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыРегламентноеЗаданиеПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыГруппаПараметровПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокГруппПараметров = Новый СписокЗначений;
	
	Для каждого СтрокаГруппыПараметров Из Объект.ГруппыПараметров Цикл
		СписокГруппПараметров.Добавить(СтрокаГруппыПараметров.Идентификатор, СтрокаГруппыПараметров.Имя);
	КонецЦикла;
	
	Если СписокГруппПараметров.Количество() = 0 Тогда
		Предупреждение("Отсутствуют группы параметров. Сначала создайте группы, а затем назначьте их командам.");
		Возврат;
	КонецЕсли;
	
	ВыбГруппаПараметров = ОткрытьФормуМодально("ОбщаяФорма.ВыборИзСпискаСФильтрацией", Новый Структура("Список, Заголовок", СписокГруппПараметров, "Группы параметров"));
	
	Если Не ЗначениеЗаполнено(ВыбГруппаПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОбъектКоманды.ТекущиеДанные;
	
	ТекущиеДанные.ГруппаПараметров    = ВыбГруппаПараметров;
	ТекущиеДанные.ГруппаПараметровИмя = СписокГруппПараметров.НайтиПоЗначению(ВыбГруппаПараметров).Представление;
	
	ЭтаФорма.Модифицированность = Истина;
	Элементы.ОбъектКоманды.ТекущиеДанные.ОбновитьЗадание = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыГруппаПараметровИмяОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ОбъектКоманды.ТекущиеДанные.ГруппаПараметров = Неопределено;
	Элементы.ОбъектКоманды.ТекущиеДанные.ОбновитьЗадание = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыГруппаПараметровИмяПриИзменении(Элемент)
	
	Элементы.ОбъектКоманды.ТекущиеДанные.ОбновитьЗадание = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыКомандаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
	
		НайденныеСтроки = ЭтаФорма.ДоступныеКоманды.НайтиСтроки(Новый Структура("Идентификатор", ВыбранноеЗначение));
		
		Если НайденныеСтроки.Количество()>0 Тогда
			
			СтрокаКоманда = Элементы.ОбъектКоманды.ТекущиеДанные;
			ЗаполнитьЗначенияСвойств(СтрокаКоманда, НайденныеСтроки[0]);
			
			Если (Объект.Вид = ВидДополнительнаяОбработка ИЛИ Объект.Вид = ВидДополнительныйОтчет) И СтрокаКоманда.ВариантЗапуска = ПредопределенноеЗначение("Перечисление.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода") Тогда
				
				СтрокаКоманда.РегламентноеЗаданиеРазрешено = Истина;
				СтрокаКоманда.ОбновитьЗадание = Истина;
				
				Если НЕ СтрокаКоманда.РегламентноеЗаданиеИспользование Тогда
					СтрокаКоманда.РегламентноеЗаданиеПредставление = ПредставлениеОтключенногоРасписания();
				КонецЕсли;
			
			КонецЕсли;
						
		Иначе
			
			СтандартнаяОбработка = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения параметров команды");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
	
		СтрокаКоманда = Элементы.ОбъектКоманды.ТекущиеДанные;
			
		СтрокаКоманда.Выполнить                        = "Выполнить";
		СтрокаКоманда.РегламентноеЗаданиеИспользование = Ложь;
		СтрокаКоманда.РегламентноеЗаданиеРазрешено     = Ложь;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектКомандыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Копирование;
	
КонецПроцедуры

#КонецОбласти

#Область События_таблицы_параметров

&НаКлиенте
Процедура ГруппыПараметровПриАктивизацииСтроки(Элемент)
	
	// заполним таблицу параметров текущей группы 
	
	ТекущиеДанные = Элементы.ГруппыПараметров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ИдентификаторТекущейГруппы = Неопределено;
		Элементы.ПараметрыТекущейГруппы.Доступность = Ложь;
	Иначе
		ИдентификаторТекущейГруппы = ТекущиеДанные.Идентификатор;
		Элементы.ПараметрыТекущейГруппы.Доступность = Истина;
	КонецЕсли;
	
	Если ИдентификаторТекущейГруппы = Неопределено ИЛИ ЗначениеЗаполнено(ИдентификаторТекущейГруппы) Тогда	
		Элементы.ПараметрыТекущейГруппы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Группа", ИдентификаторТекущейГруппы));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПараметровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		
		ИдентификаторНовойГруппы			= Новый УникальныйИдентификатор;
		ИдентификаторКопируемойГруппы		= Элемент.ТекущиеДанные.Идентификатор;
		Элемент.ТекущиеДанные.Идентификатор	= ИдентификаторНовойГруппы;
		
		Если Копирование Тогда			
			
			КопируемыеПараметры = Объект.Параметры.НайтиСтроки(Новый Структура("Группа", ИдентификаторКопируемойГруппы));
			
			Для Каждого СтрокаПараметров Из КопируемыеПараметры Цикл
				
				НоваяСтрокаПараметров = Объект.Параметры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПараметров, СтрокаПараметров, , "Группа");
				НоваяСтрокаПараметров.Группа = ИдентификаторНовойГруппы;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Элементы.ПараметрыТекущейГруппы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Группа", ИдентификаторНовойГруппы));	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПараметровПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НоваяСтрока И ОтменаРедактирования Тогда
		
		ОчиститьПараметрыГруппы(Элемент.ТекущиеДанные.Идентификатор);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппыПараметровПередУдалением(Элемент, Отказ)
	
	ОчиститьПараметрыГруппы(Элемент.ТекущиеДанные.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыТекущейГруппыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элементы.ПараметрыТекущейГруппы.ТекущиеДанные.Группа = Элементы.ГруппыПараметров.ТекущиеДанные.Идентификатор;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗагрузитьФайлОбработкиОтчета(Команда)
	
	ОткрытьДиалогЗагрузкиФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьФайлОбработкиОтчета(Команда)
	
	Если Не ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		Предупреждение(НСтр("ru = 'Нет данных для обработки.'"));
		Возврат;
	КонецЕсли;
	
	Если ПодключитьРасширениеРаботыСФайлами() Тогда
		
		ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогСохраненияФайла.ПолноеИмяФайла     = Объект.ИмяФайла;
		ДиалогСохраненияФайла.Фильтр             = НСтр("ru = 'Внешние отчеты и обработки (*.erf, *.epf)|*.erf;*.epf|Внешние отчеты (*.erf)|*.erf|Внешние обработки (*.epf)|*.epf'");
		ДиалогСохраненияФайла.ИндексФильтра      = ?(Объект.Вид = ЭтаФорма.ВидДополнительныйОтчет, 1, 2);
		ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
		ДиалогСохраненияФайла.Заголовок          = НСтр("ru = 'Укажите файл'");
		
		Если ДиалогСохраненияФайла.Выбрать() Тогда
			ПолучаемыеФайлы = Новый Массив;
			ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(, АдресФайла));
			
			ПолученныеФайлы = Новый Массив;
			ПолучитьФайлы(ПолучаемыеФайлы, ПолученныеФайлы, ДиалогСохраненияФайла.ПолноеИмяФайла, Ложь);
		КонецЕсли;
		
	Иначе
		
		ПолучитьФайл(АдресФайла, Объект.ИмяФайла, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьОтчет(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		Предупреждение("Перед открытием отчета (обработки) необходимо сохранить изменения.");
		Возврат;                      
	КонецЕсли;
	
	ИмяПодключенногоОбъекта = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(Объект.Ссылка);
	
	Если Объект.Вид = ЭтаФорма.ВидДополнительныйОтчет Тогда
		ОткрытьФорму("ВнешнийОтчет." + ИмяПодключенногоОбъекта + ".Форма");
	Иначе
		ОткрытьФорму("ВнешняяОбработка." + ИмяПодключенногоОбъекта + ".Форма");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьИдентификаторы(Команда)
	
	ПоказатьИдентификаторыПараметров = Элементы.ФормаКомандаПоказатьИдентификаторы.Пометка;
	
	Если Команда <> Неопределено Тогда
		ПоказатьИдентификаторыПараметров = Не ПоказатьИдентификаторыПараметров;
		Элементы.ФормаКомандаПоказатьИдентификаторы.Пометка = ПоказатьИдентификаторыПараметров;
	КонецЕсли;
	
	Элементы.ОбъектКомандыГруппаПараметров.Видимость        = ПоказатьИдентификаторыПараметров;
	Элементы.ОбъектКомандыИдентификатор.Видимость           = ПоказатьИдентификаторыПараметров;
	Элементы.ОбъектКомандыРегламентноеЗаданиеGUID.Видимость = ПоказатьИдентификаторыПараметров;
	
	Элементы.ГруппыПараметровИдентификатор.Видимость = ПоказатьИдентификаторыПараметров;
	Элементы.ПараметрыТекущейГруппыГруппа.Видимость  = ПоказатьИдентификаторыПараметров;
	
КонецПроцедуры

#КонецОбласти

#Область Настройка_отображения_элементов

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.ФормаКомандаОткрытьОтчет.Видимость = Объект.ДоступенИнтерактивно;
	
	Элементы.СтраницаСкриншоты.Видимость = (Объект.Скриншоты.Количество() > 0);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеНаСервере()

	УсловноеОформление.Элементы.Очистить();

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбъектКомандыРегламентноеЗаданиеИспользование.Имя);

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОбъектКомандыРегламентноеЗаданиеПредставление.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.Команды.РегламентноеЗаданиеРазрешено");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

КонецПроцедуры

&НаСервере
Процедура ОтобразитьСкриншотыНаСервере()
	
	// удалим ранее созданные реквизиты формы вида "АдресСкриншота[№]" (например, АдресСкриншота[0], АдресСкриншота[1] и т.д.)
	// и соответствующие им элементы-картики (т.к. процесс очень и очень не частый можно не оптимизировать)
	МодифицируемыеРеквизиты = Новый Массив;
	
	Для Инд = 1 - Элементы.СтраницаСкриншоты.ПодчиненныеЭлементы.Количество() По 0 Цикл
		ЭлементКартинка = Элементы.СтраницаСкриншоты.ПодчиненныеЭлементы[-Инд];
		МодифицируемыеРеквизиты.Добавить(ЭлементКартинка.Имя);
		Элементы.Удалить(ЭлементКартинка);
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(, МодифицируемыеРеквизиты);
	
	// создадим новые реквизиты
	МодифицируемыеРеквизиты.Очистить();
	
	Для каждого СтрокаСкриншоты Из Объект.Скриншоты Цикл
		МодифицируемыеРеквизиты.Добавить(Новый РеквизитФормы("АдресСкриншота" + МодифицируемыеРеквизиты.Количество(), Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	
	Если МодифицируемыеРеквизиты.Количество() > 0 Тогда
		
		ЭтаФорма.ИзменитьРеквизиты(МодифицируемыеРеквизиты);
		
		// заполним реквизиты формы и создадим новые элементы формы (их можно создавать только после создания реквизитов)
		Для Инд = 0 По МодифицируемыеРеквизиты.Количество() - 1 Цикл
			ИмяРеквизита = 	МодифицируемыеРеквизиты[Инд].Имя;
			
			ЭтаФорма[ИмяРеквизита] = Объект.Скриншоты[Инд].Адрес;
			
			ЭлементКартинка = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Элементы.СтраницаСкриншоты);
			ЭлементКартинка.Вид                = ВидПоляФормы.ПолеКартинки;
			ЭлементКартинка.ПутьКДанным        = ИмяРеквизита;
			ЭлементКартинка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ЭлементКартинка.РазмерКартинки     = РазмерКартинки.Пропорционально;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ОтобразитьСкриншотыНаСервере

#КонецОбласти

#Область Заполнение_таблицы_команд

&НаСервере
Процедура ЗаполнитьКомандыНаСервере(КомандыСохраненные = Неопределено)
	
	//Объект.Команды.Сортировать("Представление");
	
	УсловноеОформление.Элементы.Очистить();
	СписокВыбора = Элементы.ОбъектКомандыКоманда.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для каждого СтрокаДоступнаяКоманда Из ДоступныеКоманды Цикл
	
		Идентификатор = СтрокаДоступнаяКоманда.Идентификатор;
		Представление = СтрокаДоступнаяКоманда.Представление + " (" + Идентификатор + ")";
		СписокВыбора.Добавить(Идентификатор, Представление);
		
		НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", СтрокаДоступнаяКоманда.Представление);
		Отбор = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Команды.Команда");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Идентификатор;
		НовыйЭлементУО.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ОбъектКомандыКоманда");
		
	КонецЦикла; 
	
	Для Каждого СтрокаКоманда Из Объект.Команды Цикл
		
		СтрокаКоманда.Выполнить                        = "Выполнить";
		СтрокаКоманда.РегламентноеЗаданиеИспользование = Ложь;
		СтрокаКоманда.РегламентноеЗаданиеРазрешено     = Ложь;
		СтрокаКоманда.Команда = СтрокаКоманда.Идентификатор;
		
		//Если Не ЗначениеЗаполнено(СтрокаКоманда.ГруппаПараметров) И КомандыСохраненные <> Неопределено Тогда
		//	// попытаемся восстановить группу параметров из ранее сохраненных команд
		//	НайденнаяСтрока = КомандыСохраненные.Найти(СтрокаКоманда.Идентификатор, "Идентификатор");
		//	Если НайденнаяСтрока <> Неопределено Тогда
		//		СтрокаКоманда.ГруппаПараметров = НайденнаяСтрока.ГруппаПараметров;
		//	КонецЕсли;
		//КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКоманда.ГруппаПараметров) Тогда
			// определим имя группы параметров
			ГруппыПараметровПоИдентификатору = Объект.ГруппыПараметров.НайтиСтроки(Новый Структура("Идентификатор", СтрокаКоманда.ГруппаПараметров));
			
			Если ГруппыПараметровПоИдентификатору.Количество() > 0 Тогда
				СтрокаКоманда.ГруппаПараметровИмя = ГруппыПараметровПоИдентификатору[0].Имя;
			КонецЕсли;
		КонецЕсли;
		
		Если (Объект.Вид = ВидДополнительнаяОбработка ИЛИ Объект.Вид = ВидДополнительныйОтчет) И СтрокаКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода Тогда
			
			СтрокаКоманда.РегламентноеЗаданиеРазрешено = Истина;
			
			РегламентноеЗаданиеGUID = СтрокаКоманда.РегламентноеЗаданиеGUID;
			//Если КомандыСохраненные <> Неопределено Тогда
			//	НайденнаяСтрока = КомандыСохраненные.Найти(СтрокаКоманда.Идентификатор, "Идентификатор");
			//	Если НайденнаяСтрока <> Неопределено Тогда
			//		РегламентноеЗаданиеGUID = НайденнаяСтрока.РегламентноеЗаданиеGUID;
			//	КонецЕсли;
			//КонецЕсли;
			
			Если ЗначениеЗаполнено(РегламентноеЗаданиеGUID) Тогда
				РегламентноеЗадание = РаботаСДополнительнымиОтчетамиИОбработками.НайтиЗадание(РегламентноеЗаданиеGUID);
				
				Если РегламентноеЗадание <> Неопределено Тогда
					
					ПараметрыЗадания = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыЗадания(РегламентноеЗадание);
					
					СтрокаКоманда.РегламентноеЗаданиеGUID          = РегламентноеЗаданиеGUID;
					СтрокаКоманда.РегламентноеЗаданиеПредставление = Строка(ПараметрыЗадания.Расписание);
					СтрокаКоманда.РегламентноеЗаданиеИспользование = ПараметрыЗадания.Использование;
					СтрокаКоманда.РегламентноеЗаданиеРасписание.Вставить(0, ПараметрыЗадания.Расписание);
					
					Если СтрокаКоманда.РегламентноеЗаданиеПредставление = ПредставлениеПустогоРасписания() Тогда
						СтрокаКоманда.РегламентноеЗаданиеИспользование = Ложь;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ СтрокаКоманда.РегламентноеЗаданиеИспользование Тогда
				СтрокаКоманда.РегламентноеЗаданиеПредставление = ПредставлениеОтключенногоРасписания();
			КонецЕсли;
		Иначе
			СтрокаКоманда.РегламентноеЗаданиеПредставление = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не применимо для команд с вариантом запуска ""%1""'"),
				Строка(СтрокаКоманда.ВариантЗапуска));
		КонецЕсли;
		
		НайденныеСтроки = ЭтаФорма.ДоступныеКоманды.НайтиСтроки(Новый Структура("Идентификатор", СтрокаКоманда.Идентификатор));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаКоманда, НайденныеСтроки[0]);
		Иначе
			СтрокаКоманда.Команда = "";
			СтрокаКоманда.Идентификатор = "";
			СтрокаКоманда.Представление = "";
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеПустогоРасписания()
	Возврат Строка(Новый РасписаниеРегламентногоЗадания);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеОтключенногоРасписания()
	Возврат НСтр("ru = 'Расписание не задано'");
