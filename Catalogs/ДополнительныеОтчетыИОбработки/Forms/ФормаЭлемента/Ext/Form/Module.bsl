#КонецОбласти

#Область Загрузка_и_регистрация_обработки

&НаКлиенте
Функция ОткрытьДиалогЗагрузкиФайла()
	
	// Выбор файла и помещение его во временное хранилище
	ВыбранноеИмяФайла = "";
	
	Если ПодключитьРасширениеРаботыСФайлами() Тогда
		
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.ПолноеИмяФайла     = Объект.ИмяФайла;
		ДиалогОткрытияФайла.Фильтр             = НСтр("ru = 'Внешние отчеты и обработки (*.erf, *.epf)|*.erf;*.epf|Внешние отчеты (*.erf)|*.erf|Внешние обработки (*.epf)|*.epf'");
		ДиалогОткрытияФайла.ИндексФильтра      = ?(Объект.Ссылка.Пустая(), 0, ?(Объект.Вид = ЭтаФорма.ВидДополнительныйОтчет, 1, 2));
		ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
		ДиалогОткрытияФайла.Заголовок          = НСтр("ru = 'Выберите дополнительный отчет или обработку'");
		
		ПомещаемыеФайлы = Новый Массив;
		ПомещенныеФайлы = Новый Массив;
		
		Если Не ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы, ДиалогОткрытияФайла, Истина, ЭтаФорма.УникальныйИдентификатор) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ЭтаФорма.АдресФайла = ПомещенныеФайлы[0].Хранение;
		ВыбранноеИмяФайла   = ПомещенныеФайлы[0].Имя;
		
	Иначе
		
		Если Не ПоместитьФайл(ЭтаФорма.АдресФайла,, ВыбранноеИмяФайла, Истина, ЭтаФорма.УникальныйИдентификатор) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим выбранное расширение
	РасширениеФайла = ВРег(Прав(ВыбранноеИмяФайла, 3));
	
	Если      РасширениеФайла = "ERF" Тогда
		ЭтоОтчет = Истина;
	ИначеЕсли РасширениеФайла = "EPF" Тогда
		ЭтоОтчет = Ложь;
	Иначе
		Предупреждение(НСтр("ru = 'Расширение файла не соответствует расширению внешнего отчета (ERF) или обработки (EPF).'"));
		Возврат Ложь;
	КонецЕсли;
	
	// Выделим имя файла 
	МассивПодстрок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыбранноеИмяФайла, "\");
	ИмяФайла       = МассивПодстрок.Получить(МассивПодстрок.ВГраница());
	
	РезультатКонтроляОткрытыхОкон = КонтрольОткрытыхОконЗагружаемогоОбъекта();
	
	Если Не РезультатКонтроляОткрытыхОкон.Успешно Тогда
		Предупреждение(РезультатКонтроляОткрытыхОкон.КраткоеПредставлениеОшибки);
		Возврат Истина;
	КонецЕсли;
	
	РезультатКонтроляФорм = КонтрольФорм(ИмяФайла, ЭтоОтчет);
	
	Если Не РезультатКонтроляФорм.Успешно Тогда
		Предупреждение(РезультатКонтроляФорм.КраткоеПредставлениеОшибки);
		Возврат Истина;
	КонецЕсли;
	
	// Квинтесенция процесса
	ЗарегистрироватьОбработку(ИмяФайла, ЭтоОтчет);
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ЗарегистрироватьОбработку(ИмяФайла, ЭтоОтчет, ПерезаписыватьПриОтсутствииИзменений = Неопределено)
	
	РезультатРегистрации = ЗарегистрироватьОбработкуНаСервере(ИмяФайла, ЭтоОтчет, ПерезаписыватьПриОтсутствииИзменений);
	
	Если Не РезультатРегистрации.Успешно Тогда
		
		Если Не РезультатРегистрации.ФайлИзменен И ПерезаписыватьПриОтсутствииИзменений = Неопределено Тогда
			
			РезультатВопроса = Вопрос("Файл объекта не отличается от сохраненного." + Символы.ПС + "Все равно загрузить?", РежимДиалогаВопрос.ДаНетОтмена);
			 
			Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
				Возврат ЗарегистрироватьОбработку(ИмяФайла, ЭтоОтчет, Истина);
			КонецЕсли;
			
		КонецЕсли;
		
		Предупреждение(РезультатРегистрации.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
	Возврат РезультатРегистрации;
	
КонецФункции

&НаСервере
Функция ЗарегистрироватьОбработкуНаСервере(ИмяФайла, ЭтоОтчет, ПерезаписыватьПриОтсутствииИзменений = Неопределено)
	
	Объект.Скриншоты.Очистить();
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
		
	КомандыСохраненные = ОбъектНаСервере.Команды.Выгрузить(); // чтобы не потерять связь с ранее установленными регламентными заданиями
	ТаблицаДоступныхКоманд = ЭтаФорма.ДоступныеКоманды.Выгрузить().СкопироватьКолонки();
	
	Результат = РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьОбработку(ОбъектНаСервере, ИмяФайла, ЭтаФорма.АдресФайла, ЭтоОтчет, ЭтаФорма.УникальныйИдентификатор, ТаблицаДоступныхКоманд);
	
	Если Результат.Успешно И Не Результат.ФайлИзменен И ПерезаписыватьПриОтсутствииИзменений <> Истина Тогда
		Результат.Успешно					 = Ложь;
		Результат.КраткоеПредставлениеОшибки = "Файл не был изменен.";
	КонецЕсли;
	
	Если Результат.Успешно Тогда
	
		ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
		
		ЭтаФорма.ДоступныеКоманды.Загрузить(ТаблицаДоступныхКоманд);
		ЗаполнитьКомандыНаСервере(КомандыСохраненные);
		
		Для каждого АдресСкриншота Из Результат.АдресаСкриншотов Цикл
			НоваяСтрокаСкриншоты = Объект.Скриншоты.Добавить();
			НоваяСтрокаСкриншоты.Адрес = АдресСкриншота;
		КонецЦикла;
		
		ОтобразитьСкриншотыНаСервере();
		
		НастроитьВидимостьДоступность(ЭтаФорма);
		
		ЭтаФорма.Модифицированность   = Истина;
		ЭтаФорма.РегистрацияОбработки = Истина;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КонтрольОткрытыхОконЗагружаемогоОбъекта()
	
	ДанныеДляКонтроляФорм = Новый Структура("Успешно, КраткоеПредставлениеОшибки", Истина);
	
	Если Объект.Вид = ПредопределенноеЗначение("Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет") Тогда
		ПолноеИмяОбъекта = "ВнешнийОтчет." + Объект.ИмяОбъекта;
	Иначе
		ПолноеИмяОбъекта = "ВнешняяОбработка." + Объект.ИмяОбъекта;
	КонецЕсли;
	
	Для Каждого ТекущееОкно Из ПолучитьОкна() Цикл
		Для Каждого Форма Из ТекущееОкно.Содержимое Цикл
			Если ТипЗнч(Форма) <> Тип("УправляемаяФорма") Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНачинаетсяС(Форма.ИмяФормы, ПолноеИмяОбъекта) Тогда
				ТекущееОкно.Активизировать();
				
				ДанныеДляКонтроляФорм.Успешно = Ложь;
				ДанныеДляКонтроляФорм.КраткоеПредставлениеОшибки = "Перед обновлением закройте все окна отчёта";
				
				Возврат ДанныеДляКонтроляФорм;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ДанныеДляКонтроляФорм;
	
КонецФункции

&НаКлиенте
Функция КонтрольФорм(ИмяФайла, ЭтоОтчет)
	
	РезультатКонтроляФорм = ПолучитьДанныеДляКонтроляФорм(ИмяФайла, ЭтоОтчет);
	
	ОшибкиПроверкиФорм = Новый Массив;
	
	Для Каждого РеквизитыФормы Из РезультатКонтроляФорм.Формы Цикл
		ПроверяемыеСобытия = Новый Структура;
		ПроверяемыеСобытия.Вставить("АдресПриЗагрузкеДанныхИзНастроекНаСервере", ПоместитьВоВременноеХранилище(Ложь, ЭтаФорма.УникальныйИдентификатор));
		
		Форма = ПолучитьФорму(РеквизитыФормы.ПолноеИмя, ПроверяемыеСобытия);
		
		Если Форма.АвтоматическоеСохранениеДанныхВНастройках = АвтоматическоеСохранениеДанныхФормыВНастройках.Использовать Тогда
		    Если ПолучитьИзВременногоХранилища(ПроверяемыеСобытия.АдресПриЗагрузкеДанныхИзНастроекНаСервере) <> Истина Тогда
		    	ОшибкиПроверкиФорм.Добавить("В форме '" + РеквизитыФормы.Имя + "' отсутствует процедура ПриЗагрузкеДанныхИзНастроекНаСервере");
		  	КонецЕсли;
		КонецЕсли;
		
		ДополнительныеРеквизитыФормы = Новый Структура("ВерсияДополнительногоОтчетаИлиОбработки");
		ЗаполнитьЗначенияСвойств(ДополнительныеРеквизитыФормы, Форма);
		
		Если НЕ ЗначениеЗаполнено(ДополнительныеРеквизитыФормы.ВерсияДополнительногоОтчетаИлиОбработки) Тогда
		    ОшибкиПроверкиФорм.Добавить("В процедуре 'ПриСозданииНаСервере' формы '" + РеквизитыФормы.Имя + "' отсутствует вызов процедуры 'РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки'");
		КонецЕсли;
		
		Если РеквизитыФормы.НетНастройки Тогда
			УдалитьНастройкиФормы(РеквизитыФормы.ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатКонтроляФорм.КраткоеПредставлениеОшибки = СтрСоединить(ОшибкиПроверкиФорм, Символы.ПС);
	РезультатКонтроляФорм.Успешно = (ОшибкиПроверкиФорм.Количество() = 0);
	
	Возврат РезультатКонтроляФорм;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляКонтроляФорм(ИмяФайла, ЭтоОтчет)
	
	ДанныеДляКонтроляФорм = Новый Структура("ИмяОбъекта, Формы, КраткоеПредставлениеОшибки, Успешно");
	
	Менеджер				= ?(ЭтоОтчет, ВнешниеОтчеты, ВнешниеОбработки);
	ИмяОбъекта 				= СокрЛП(Менеджер.Подключить(АдресФайла,, Ложь));
	ВнешнийОбъект			= Менеджер.Создать(ИмяОбъекта);
	ВнешнийОбъектМетаданные = ВнешнийОбъект.Метаданные();
	
	ДанныеДляКонтроляФорм.ИмяОбъекта = ИмяОбъекта;
	
	ФормыОбъекта = Новый Массив;
	
	Для Каждого Форма Из ВнешнийОбъектМетаданные.Формы Цикл
		Если Строка(Форма.ТипФормы) = "Управляемая" Тогда
			Если Форма = ВнешнийОбъектМетаданные.ОсновнаяФорма Тогда
				РеквизитыФормы = Новый Структура;
				РеквизитыФормы.Вставить("Имя"			, Форма.Имя);
				РеквизитыФормы.Вставить("ПолноеИмя"		, Форма.ПолноеИмя());
				РеквизитыФормы.Вставить("Основная"		, Форма = ВнешнийОбъектМетаданные.ОсновнаяФорма);
				РеквизитыФормы.Вставить("НетНастройки"	, ХранилищеСистемныхНастроек.Загрузить(Форма.ПолноеИмя() + "/ТекущиеДанные") = Неопределено);
				
				Если РеквизитыФормы.НетНастройки Тогда
					ХранилищеСистемныхНастроек.Сохранить(Форма.ПолноеИмя() + "/ТекущиеДанные", "", Новый Соответствие); // в функции КонтрольФорм будут удалены
				КонецЕсли;
				
				ФормыОбъекта.Добавить(РеквизитыФормы);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеДляКонтроляФорм.Вставить("Формы", ФормыОбъекта);
	
	Возврат ДанныеДляКонтроляФорм;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьНастройкиФормы(ПолноеИмя)
	
	ХранилищеСистемныхНастроек.Сохранить(ПолноеИмя + "/ТекущиеДанные", "", Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_и_вспомогательные_функции

&НаКлиенте
Процедура ИзменитьРегламентноеЗадание(РежимВыбора = Ложь, ИзмененФлажок = Ложь)
	
	ЭлементКоманда = Элементы.ОбъектКоманды.ТекущиеДанные;
	Если ЭлементКоманда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементКоманда.ВариантЗапуска <> ПредопределенноеЗначение("Перечисление.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода") Тогда
		ТекстОшибки = НСтр("ru = 'Команда с вариантом запуска ""%1""
			|не может использоваться в регламентных заданиях.'");
		ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Строка(ЭлементКоманда.ВариантЗапуска));
		ПоказатьПредупреждение(, ТекстОшибки);
		Если ИзмененФлажок тогда
			ЭлементКоманда.РегламентноеЗаданиеИспользование = НЕ ЭлементКоманда.РегламентноеЗаданиеИспользование;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ИзмененФлажок Тогда
		Если НЕ ЭлементКоманда.РегламентноеЗаданиеИспользование Тогда
			ЭлементКоманда.РегламентноеЗаданиеПредставление = ПредставлениеОтключенногоРасписания();
			ЭлементКоманда.ОбновитьЗадание = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементКоманда.РегламентноеЗаданиеРасписание.Количество() > 0 Тогда
		РасписаниеКоманды = ЭлементКоманда.РегламентноеЗаданиеРасписание.Получить(0).Значение;
	Иначе
		РасписаниеКоманды = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(РасписаниеКоманды) <> Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеКоманды = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭлементКоманда", ЭлементКоманда);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, РасписаниеКоманды, "JobSchedule", "http://v8.1c.ru/8.1/data/enterprise");
	ДополнительныеПараметры.Вставить("ИсходноеРасписание", ЗаписьXML.Закрыть());
	
	Обработчик = Новый ОписаниеОповещения("ИзменитьРегламентноеЗаданиеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	РедактированиеРасписания = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеКоманды);
	РедактированиеРасписания.Показать(Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРегламентноеЗаданиеЗавершение(Расписание, ДополнительныеПараметры) Экспорт
	
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементКоманда = ДополнительныеПараметры.ЭлементКоманда;
	ЭлементКоманда.РегламентноеЗаданиеРасписание.Очистить();
	ЭлементКоманда.РегламентноеЗаданиеРасписание.Добавить(Расписание);
	ЭлементКоманда.РегламентноеЗаданиеПредставление = Строка(Расписание);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Расписание, "JobSchedule", "http://v8.1c.ru/8.1/data/enterprise");
	НовоеРасписание = ЗаписьXML.Закрыть();
	
	ЭлементКоманда.ОбновитьЗадание = ЭлементКоманда.ОбновитьЗадание Или ДополнительныеПараметры.ИсходноеРасписание <> НовоеРасписание;
	ЭтаФорма.Модифицированность = ЭтаФорма.Модифицированность Или ЭлементКоманда.ОбновитьЗадание;
	
	Если ЭлементКоманда.РегламентноеЗаданиеПредставление = ПредставлениеПустогоРасписания() Тогда
		ЭлементКоманда.РегламентноеЗаданиеПредставление = ПредставлениеОтключенногоРасписания();
		ЭлементКоманда.РегламентноеЗаданиеИспользование = Ложь;
	Иначе
		ЭлементКоманда.РегламентноеЗаданиеИспользование = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПараметрыГруппы(ИдентификаторГруппы)
	
	Для Инд = 1 - Объект.Параметры.Количество() По 0 Цикл
		Если Объект.Параметры[-Инд].Группа = ИдентификаторГруппы Тогда
			Объект.Параметры.Удалить(-Инд);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивКомандКПерезапуску()
	
	МассивКоманд = Новый Массив;
	Для каждого СтрокаКоманды Из Объект.Команды Цикл
	
		Если СтрокаКоманды.РегламентноеЗаданиеИспользование И СтрокаКоманды.РегламентноеЗаданиеРасписание.Количество() > 0 Тогда
			РасписаниеКоманды = СтрокаКоманды.РегламентноеЗаданиеРасписание.Получить(0).Значение; 
			Если СтрокаКоманды.ОбновитьЗадание И РасписаниеКоманды.ТребуетсяВыполнение() Тогда
				
				НайденныеСтроки = ДоступныеКоманды.НайтиСтроки(Новый Структура("Идентификатор", СтрокаКоманды.Команда));
				ПредставлениеКоманды = ?(НайденныеСтроки.Количество() = 0, СтрокаКоманды.Команда, НайденныеСтроки[0].Представление);
				ПредставлениеГруппыПараметров = ?(ЗначениеЗаполнено(СтрокаКоманды.ГруппаПараметровИмя), " (" + СтрокаКоманды.ГруппаПараметровИмя + ")", "");
				МассивКоманд.Добавить(ПредставлениеКоманды + ПредставлениеГруппыПараметров);
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат МассивКоманд;
	
КонецФункции

#КонецОбласти
