// Реквизиты учетного актива ЕПС переводятся в структуру, затем делается подмена счетов учета на счета учета в залоге
Функция ПолучитьДанныеУчетногоАктиваЕПСДляБумагВРЕПО(УчетныйАктивЕПС, Отказ) Экспорт
	СтрокаИменРеквизитов = СтрСоединить(РаботаСМетаданнымиПовтИсп.ПолучитьИменаПолейРегистра("Справочники", "УчетныеАктивыЕПС", Истина, Истина, Ложь), ",");
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетныйАктивЕПС, СтрокаИменРеквизитов);
	
	ИмяСчета = Реквизиты.СчетУчета.ИмяПредопределенныхДанных;
	ИмяСчета1Уровня = Лев(ИмяСчета, СтрДлина(ИмяСчета) - 2); // справа 2 символа - цифры: ДолговыеПрибыльУбыток66, ДолговыеДляПродажи22 и т.п.
	
	СчетаАкции = "ДолевыеПоСправедливой,ДолевыеДляПродажи";
	СчетаОблигации = "ДолговыеПрибыльУбыток,ДолговыеДляПродажи,ДолговыеЧерезПСД,ДолговыеДляПродажиИДоПогашения";
	СчетаОбратногоРЕПО = "ЦенныеБумагиПоРЕПО";
	
	Если СтрНайти(СчетаАкции, ИмяСчета1Уровня) <> 0 Тогда
		Реквизиты.СчетУчета = ПланыСчетов.Единый[ИмяСчета1Уровня + "18"];
		Реквизиты.СчетУчетаПереоценкиА = ПланыСчетов.Единый[ИмяСчета1Уровня + "31"];
		Реквизиты.СчетУчетаПереоценкиП = ПланыСчетов.Единый[ИмяСчета1Уровня + "26"];
	ИначеЕсли СтрНайти(СчетаОблигации, ИмяСчета1Уровня) <> 0 Тогда
		Реквизиты.СчетУчета = ПланыСчетов.Единый[ИмяСчета1Уровня + "18"];
		Реквизиты.СчетУчетаКупона = ПланыСчетов.Единый[ИмяСчета1Уровня + "18"];
		
		Если ИмяСчета1Уровня = "ДолговыеПрибыльУбыток" ИЛИ ИмяСчета1Уровня = "ДолговыеДляПродажи" Тогда
			Реквизиты.СчетУчетаПереоценкиА = ПланыСчетов.Единый[ИмяСчета1Уровня + "39"];
			Реквизиты.СчетУчетаПереоценкиП = ПланыСчетов.Единый[ИмяСчета1Уровня + "30"];
		КонецЕсли;
		
		ПостфиксКорректировки = ?(ИмяСчета1Уровня = "ДолговыеДляПродажиИДоПогашения", 64, 66);
		Реквизиты.СчетУчетаКорректировокА = ПланыСчетов.Единый[ИмяСчета1Уровня + Строка(ПостфиксКорректировки)];
		Реквизиты.СчетУчетаКорректировокП = ПланыСчетов.Единый[ИмяСчета1Уровня + Строка(ПостфиксКорректировки + 1)];
	ИначеЕсли СтрНайти(СчетаОбратногоРЕПО, ИмяСчета) <> 0 Тогда
		Реквизиты.СчетУчета = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове;
		Реквизиты.СчетУчетаКупона = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове;
		Реквизиты.СчетУчетаПереоценкиА = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове;
		Реквизиты.СчетУчетаПереоценкиП = ПланыСчетов.Единый.ЦенныеБумагиПереданныеПоОперациямСовершаемымНаВозвратнойОснове;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для учетного актива '" + Строка(УчетныйАктивЕПС) + "' не предусмотрен учет по прямому РЕПО",,,, Отказ);
	КонецЕсли;
	
	Возврат Реквизиты;
КонецФункции

// Добавление временной таблицы с классификациями ценных бумаг.
//	Временная таблица (по умолчанию именуется "_КлассификацииЦенныхБумаг"):
//		УчетныйАктивЕПС - СправочникСсылка.УчетныеАктивыЕПС,
//		УчетныйАктивЕПСРодитель - СправочникСсылка.УчетныеАктивыЕПС,
//		КлассификацияЦенныхБумагТекстовая - Строка,
//		КлассификацияЦенныхБумагЦифровая - Число
Процедура ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(МенеджерВременныхТаблиц, ИмяВременнойТаблицы = "", Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.Ссылка КАК УчетныйАктивЕПС,
		|	УчетныеАктивыЕПС.Родитель КАК УчетныйАктивЕПСРодитель,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) >= &ДатаПереходаНаНовуюКлассификацию2025
		|			ТОГДА ВЫБОР
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)
		|						ТОГДА ""Ценные бумаги, оцениваемые по амортизированной стоимости""
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи)
		|						ТОГДА ""Ценные бумаги, оцениваемые по справедливой стоимости через прочий совокупный доход""
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой)
		|						ТОГДА ""Ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток""
		|					ИНАЧЕ ""Прочие ценные бумаги""
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток)
		|						ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой)
		|					ТОГДА ""Ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток""
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи)
		|						ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи)
		|					ТОГДА ""Ценные бумаги, имеющиеся в наличии для продажи""
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД)
		|					ТОГДА ""Долговые ценные бумаги, удерживаемые до погашения""
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)
		|					ТОГДА ""Долговые ценные бумаги, учитываемые по амортизированной стоимости (кроме долговых ценных бумаг, удерживаемых до погашения""
		|				ИНАЧЕ ""Прочие ценные бумаги""
		|			КОНЕЦ
		|	КОНЕЦ КАК КлассификацияЦенныхБумагТекстовая,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) >= &ДатаПереходаНаНовуюКлассификацию2025
		|			ТОГДА ВЫБОР
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)
		|						ТОГДА 5
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи)
		|						ТОГДА 6
		|					КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток)
		|							ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой)
		|						ТОГДА 7
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток)
		|						ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой)
		|					ТОГДА 1
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи)
		|						ИЛИ УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи)
		|					ТОГДА 2
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД)
		|					ТОГДА 3
		|				КОГДА УчетныеАктивыЕПС.Родитель = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения)
		|					ТОГДА 4
		|			КОНЕЦ
		|	КОНЕЦ КАК КлассификацияЦенныхБумагЦифровая
		|ПОМЕСТИТЬ _КлассификацииЦенныхБумаг
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	НЕ УчетныеАктивыЕПС.ЭтоГруппа";
	#КонецОбласти
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ДатаПереходаНаНовуюКлассификацию2025", ПолучитьДатуПереходаНаНовуюКлассификацию2025());
	Если ИмяВременнойТаблицы <> "" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_КлассификацииЦенныхБумаг", ИмяВременнойТаблицы);
	КонецЕсли;
	Запрос.Выполнить();
КонецПроцедуры

Функция ПолучитьЧисловуюКлассификациюЦенныхБумаг(РодительУчетногоАктиваЕПС, Дата) Экспорт
	ДатаПереходаНаНовуюКлассификацию2025 = ПолучитьДатуПереходаНаНовуюКлассификацию2025();
	Если Дата >= ДатаПереходаНаНовуюКлассификацию2025 Тогда
		Если РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
			Или РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи
			Или РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения
		Тогда
			Возврат 5;
		ИначеЕсли РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД Тогда
			Возврат 6;
		ИначеЕсли РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток
			Или РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой
		Тогда
			Возврат 7;
		КонецЕсли;
	Иначе // Ранее 2025 года
		Если РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток
			Или РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой
		Тогда
			Возврат 1;
		ИначеЕсли РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД Тогда
			Возврат 2;
		ИначеЕсли РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
			Или РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи
		Тогда
			Возврат 3;
		ИначеЕсли РодительУчетногоАктиваЕПС = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения Тогда
			Возврат 4;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьДатуПереходаНаНовуюКлассификацию2025() Экспорт
	Возврат Дата(2025, 1, 1);
КонецФункции