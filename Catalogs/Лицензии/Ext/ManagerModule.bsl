
Функция СформироватьНаименование(РеквизитыЛицензии, ЗадействованныеРеквизиты = "") Экспорт
	
	ЗадействованныеРеквизиты = "Серия, Номер, ДатаВыдачи, ВидДеятельности";
	
	Если РеквизитыЛицензии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Наименование = "";
	
	Если ЗначениеЗаполнено(РеквизитыЛицензии.Номер) И ЗначениеЗаполнено(РеквизитыЛицензии.ДатаВыдачи) И ЗначениеЗаполнено(РеквизитыЛицензии.ВидДеятельности) Тогда
		Наименование = "" + РеквизитыЛицензии.ВидДеятельности + ?(ЗначениеЗаполнено(РеквизитыЛицензии.Серия), ", Серия " + РеквизитыЛицензии.Серия, ", ") 
							+ "№ " + РеквизитыЛицензии.Номер + " от " + Формат(РеквизитыЛицензии.ДатаВыдачи, "ДФ=dd.MM.yy");
		
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции // СформироватьНаименование
