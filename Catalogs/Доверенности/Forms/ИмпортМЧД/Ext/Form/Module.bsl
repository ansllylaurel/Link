
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.ФайлыМЧД = Параметры.ФайлыМЧД;
	ДанныеМЧД = Параметры.ДанныеДоверенности.ДанныеМЧД;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеМЧД, , "Поверенные");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ДанныеДоверенности, "ДоверенностьВерна, ТекстОшибкиПроверкиМЧД");
	Для каждого Строка Из ДанныеМЧД.Поверенные Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Поверенные.Добавить(), Строка);
	КонецЦикла;
	
	Если ЭтаФорма.ДоверенностьВерна Тогда
		ЭтаФорма.Подпись = "Верна";
	Иначе
		ЭтаФорма.Подпись = "Неверна" + Символы.ПС + ЭтаФорма.ТекстОшибкиПроверкиМЧД;
		Элементы.Подпись.МногострочныйРежим = Истина;
	КонецЕсли;
	
	ЭтаФорма.Доверенность = НайтиДоверенностьПоИдентификатору();

	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы();

	ДоверенностьЗаполнена = ЗначениеЗаполнено(ЭтаФорма.Доверенность);
	Элементы.Доверенность.Видимость = ДоверенностьЗаполнена;
	
	Элементы.УстановленВручную.Видимость = Не ЗначениеЗаполнено(ЭтаФорма.СтатусВФНС);
		
	Элементы.ПодписьДа.Видимость = ЭтаФорма.ДоверенностьВерна;
	Элементы.ПодписьНет.Видимость = Не ЭтаФорма.ДоверенностьВерна;
	
	Сегодня = НачалоДня(ТекущаяДата());
	ПериодКорректен = ЭтаФорма.ДатаНачалаДействия <= Сегодня И ЭтаФорма.ДатаОкончанияДействия >= Сегодня;
	Элементы.ПериодДа.Видимость = ПериодКорректен;
	Элементы.ПериодНет.Видимость = Не ПериодКорректен;
	
	ДоверительЗаполнен = ЗначениеЗаполнено(ЭтаФорма.Доверитель);
	Элементы.ДоверительПредставление.КнопкаОткрытия = ДоверительЗаполнен;
	
	Элементы.ДоверительДа.Видимость = ДоверительЗаполнен;
	Элементы.ДоверительНет.Видимость = Не ДоверительЗаполнен;
		
	НесколькоПоверенных = ЭтаФорма.Поверенные.Количество() > 1;
	
	Элементы.Поверенные.Видимость = НесколькоПоверенных;
	Элементы.ПоверенныйПредставление.Видимость = Не НесколькоПоверенных;
	Элементы.ПоверенныеПредставление.Видимость = НесколькоПоверенных;
	
	Если ЭтаФорма.Поверенные.Количество() > 0 Тогда
		
		ТекСтрока = ЭтаФорма.Поверенные[0];
		Элементы.КомандаСоздатьАнкету.Видимость = Не ЗначениеЗаполнено(ТекСтрока.Поверенный) 
			И ТипЗнч(ТекСтрока.АнкетныеДанные) = Тип("Структура");
		Элементы.КомандаСоздатьАнкету.Заголовок = ПолучитьЗаголовокКомандыСоздатьАнкету(ТекСтрока.АнкетныеДанные);
	
	КонецЕсли;
		
	ПоверенныеЗаполнены = Истина;
	
	Для каждого Строка Из ЭтаФорма.Поверенные Цикл
		Если Не ЗначениеЗаполнено(Строка.Поверенный) Тогда
			ПоверенныеЗаполнены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ПоверенныйПредставление.КнопкаОткрытия = ПоверенныеЗаполнены;
	Элементы.ПоверенныеПредставление.КнопкаОткрытия = ПоверенныеЗаполнены;
	
	Элементы.ПоверенныйДа.Видимость = ПоверенныеЗаполнены;
	Элементы.ПоверенныйНет.Видимость = Не ПоверенныеЗаполнены;
	
	Элементы.КомандаЗагрузить.Доступность = (ЭтаФорма.ДоверенностьВерна И ДоверительЗаполнен И ПоверенныеЗаполнены);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьФайлыМЧДИзВременногоХранилища(ФайлыМЧД)

	УдалитьИзВременногоХранилища(ФайлыМЧД.Доверенность.Хранение);
	УдалитьИзВременногоХранилища(ФайлыМЧД.Подпись.Хранение);

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузить(Команда)
	
	Отказ = Ложь;
	Доверенность = ЗагрузитьДоверенностьНаСервере(Отказ);
	Если ЗначениеЗаполнено(Доверенность) Тогда
		ПараметрыФормы = Новый Структура("Ключ", Доверенность);
		ОткрытьФорму("Справочник.Доверенности.Форма.ФормаЭлемента", ПараметрыФормы);
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьДоверенностьНаСервере(Отказ)
	
	НачатьТранзакцию();
	
	УстановитьПривилегированныйРежим(Истина);
	
	// формируем эл. справочника Доверенности
	ДоверенностьОбъект = ПолучитьОбъектДоверенности();
	ДоверенностьОбъект.Заполнить(Неопределено);
	ДоверенностьОбъект.ВидДоверенности = Перечисления.ВидыДоверенностей.Входящая;
	ДоверенностьОбъект.Дата = ЭтаФорма.ДатаНачалаДействия;
	
	СписокСвойств = "Номер, Доверитель, ДатаНачалаДействия, ДатаОкончанияДействия, ИдентификаторДоверенности, ИнформационнаяСистема";
	
	ЗаполнитьЗначенияСвойств(ДоверенностьОбъект, ЭтаФорма, СписокСвойств);
	
	ДоверенностьОбъект.Поверенные.Очистить();
	
	Для каждого СтрокаПоверенные Из ЭтаФорма.Поверенные Цикл
		ЗаполнитьЗначенияСвойств(ДоверенностьОбъект.Поверенные.Добавить(), СтрокаПоверенные);
	КонецЦикла;
	
	ДоверенностьОбъект.ФормаПредоставления = Перечисления.ФормыПредоставленияДокументов.МЧД;
	ДоверенностьОбъект.МестоХранения = "Бэк-офис";
	
	Попытка
		ДоверенностьОбъект.Записать();
	Исключение
		ТекстСообщения = СтрШаблон("%1%2%3",
			"Не удалось записать доверенность. Система сообщает:",
			Символы.ПС,
			ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецПопытки;
	
	Если Не Отказ Тогда
	
		Если ЗначениеЗаполнено(ЭтаФорма.СтатусВФНС) Тогда
	
			Запись = РегистрыСведений.СтатусыМЧД.СоздатьМенеджерЗаписи();
			Запись.Организация = ЭтаФорма.Организация;
			
			Если ЭтаФорма.УстановленВручную Тогда
				Запись.Период = ТекущаяДатаСеанса();
				Запись.УстановленВручную = Истина;
				Запись.Комментарий = "Статус установлен пользователем " + РаботаСПользователями.ТекущийПользователь();
			Иначе
				Запись.Период = ЭтаФорма.ДатаПроверкиСтатуса;			
			КонецЕсли;
			
			Запись.Доверенность = ДоверенностьОбъект.Ссылка;
			Запись.Статус = ЭтаФорма.СтатусВФНС;
			
			Запись.Записать();
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		УстановитьПривилегированныйРежим(Ложь);
		
		// выгружаем файлы МЧД в ДО
		СоздатьФайлы(ДоверенностьОбъект.Организация, ДоверенностьОбъект.Ссылка);
		
		// удаляем файлы из временного хранилища. не забыть реализовать удаление, если какие-либо проверки не пройдены
		УдалитьФайлыМЧДИзВременногоХранилища(ЭтаФорма.ФайлыМЧД);
		
		Возврат ДоверенностьОбъект.Ссылка;
		
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьОбъектДоверенности()
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Доверенность) Тогда
		ЭтаФорма.Доверенность = НайтиДоверенностьПоИдентификатору();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Доверенность) Тогда
		ДоверенностьОбъект = ЭтаФорма.Доверенность.ПолучитьОбъект();
	Иначе
		ДоверенностьОбъект = Справочники.Доверенности.СоздатьЭлемент();
	КонецЕсли;
	
	Возврат ДоверенностьОбъект;

КонецФункции

&НаСервере
Функция НайтиДоверенностьПоИдентификатору()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Доверенности.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Доверенности КАК Доверенности
		|ГДЕ
		|	Доверенности.ИдентификаторДоверенности = &ИдентификаторДоверенности
		|	И Доверенности.Доверитель = &Доверитель
		|	И Доверенности.Организация = &Организация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИдентификаторДоверенности", ЭтаФорма.ИдентификаторДоверенности);
	Запрос.УстановитьПараметр("Доверитель", ЭтаФорма.Доверитель);
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
		
	Если ТранзакцияАктивна() Тогда
	
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.Доверенности");
		ЭлементБлокировкиДанных.УстановитьЗначение("ИдентификаторДоверенности", ЭтаФорма.ИдентификаторДоверенности);
		ЭлементБлокировкиДанных.УстановитьЗначение("Доверитель", ЭтаФорма.Доверитель);
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация", ЭтаФорма.Организация);
		
		БлокировкаДанных.Заблокировать();
	
	КонецЕсли;

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.Ссылка;
	
	КонецЕсли;

КонецФункции

&НаСервере
Процедура СоздатьФайлы(Организация, ДоверенностьСсылка)
	
	// Найдем сохраненный в ДО файл МЧД
	ФайлДоверенности = РаботаСМашиночитаемымиДоверенностями.ПолучитьПрисоединенныйФайлМЧД(
		ДоверенностьСсылка, 
		ЭтаФорма.ИдентификаторДоверенности);
	
	// Сравним файлы
	Если ФайлДоверенности <> Неопределено 
		И Не РаботаСМашиночитаемымиДоверенностями.ТребуетсяПерезаполнениеМЧД(ФайлДоверенности, ЭтаФорма.ФайлыМЧД) Тогда
		Возврат;
	КонецЕсли;
	
	// Запишем файлы в архив
	Архив = Новый ЗаписьZipФайла();
	
	КаталогВременныхФайлов = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов()
		+ Новый УникальныйИдентификатор + "\";
	Для каждого ФайлМЧД Из ЭтаФорма.ФайлыМЧД Цикл
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ФайлМЧД.Значение.Хранение);
		ИмяФайла = КаталогВременныхФайлов + ФайлМЧД.Значение.Имя;
		ДвоичныеДанные.Записать(ИмяФайла);
		Архив.Добавить(ИмяФайла);
	КонецЦикла;
	
	ДанныеАрхива = Архив.ПолучитьДвоичныеДанные(,, МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Максимальный);
	АдресАрхива = ПоместитьВоВременноеХранилище(ДанныеАрхива, ЭтаФорма.УникальныйИдентификатор);
	
	УдалитьФайлы(КаталогВременныхФайлов);
	
	// Сохраним файл в ДО
	МетаданныеВладельца = ДоверенностьСсылка.Метаданные();
	ТипВладельца = МетаданныеВладельца.ПолноеИмя();
	ИдентификаторВладельца = Строка(ДоверенностьСсылка.УникальныйИдентификатор());
	НаименованиеВладельца = Строка(ДоверенностьСсылка);
	
	ИмяАрхива = СтрШаблон("Доверенность_%1.zip", СокрЛП(ЭтаФорма.ИдентификаторДоверенности));
	Файл = Новый Файл(ИмяАрхива);
	
	ПараметрыФайла = Новый Структура;

	ПараметрыФайла.Вставить("Адрес",					АдресАрхива);
	ПараметрыФайла.Вставить("Имя",						Файл.ИмяБезРасширения);
	ПараметрыФайла.Вставить("Расширение",				Сред(Файл.Расширение, 2));
	ПараметрыФайла.Вставить("НаименованиеВладельца",	НаименованиеВладельца);
	ПараметрыФайла.Вставить("ИдентификаторВладельца",	ИдентификаторВладельца);
	ПараметрыФайла.Вставить("ТипВладельца",				ТипВладельца);

	Попытка
		
		Если ФайлДоверенности <> Неопределено Тогда
			// Добавим версию
			ДанныеВерсии = РаботаСФайловымХранилищем.ОбновитьФайл(
				ФайлДоверенности.ИдентификаторФайла, 
				ПараметрыФайла.Адрес, 
				ПараметрыФайла.Расширение);
		Иначе
			// Добавим новый файл
			ДанныеВерсии = РаботаСФайловымХранилищем.СоздатьФайл(ПараметрыФайла, Организация);	
		КонецЕсли;
		
		РаботаСФайловымХранилищем.ПриИзмененииПрисоединенныхФайлов(ДоверенностьСсылка);
		ЗаписьЖурналаРегистрации("Файловое хранилище.Добавление файла", 
			УровеньЖурналаРегистрации.Информация, 
			МетаданныеВладельца, 
			ДоверенностьСсылка, 
			"Добавлен файл: """ + Файл.Имя + """");
			
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось сохранить данные файла %1 в файловом хранилище из-за ошибки:%2", 
			ИмяАрхива, 
			Символы.ПС + ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
	КонецПопытки;
	
	УдалитьИзВременногоХранилища(АдресАрхива);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационнаяСистемаНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(ЭтаФорма.ИнформационнаяСистема);
КонецПроцедуры

&НаКлиенте
Процедура ДоверительПредставлениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначение(ЭтаФорма.Доверитель);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоверенныйПредставлениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЭтаФорма.Поверенные.Количество() > 0 Тогда
		ОткрытьЗначение(ЭтаФорма.Поверенные[0].Поверенный);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановленВручнуюПриИзменении(Элемент)
	Элементы.СтатусВФНС.ТолькоПросмотр = Не ЭтаФорма.УстановленВручную;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьАнкету(Команда)
	
	Если ЭтаФорма.Поверенные.Количество() > 0 Тогда
		
		Если Элементы.Поверенные.Видимость Тогда
			ТекущиеДанные = ЭтаФорма.Поверенные.НайтиПоИдентификатору(Элементы.Поверенные.ТекущаяСтрока)
		Иначе
			ТекущиеДанные = ЭтаФорма.Поверенные[0];
		КонецЕсли;
		
		Форма = ПолучитьФорму("Документ.АнкетаФизическогоЛица.Форма.ФормаДокумента");
		ЗаполнитьЗначенияСвойств(Форма.Объект, ТекущиеДанные.АнкетныеДанные);
		Форма.Открыть();
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЗаголовокКомандыСоздатьАнкету(АнкетныеДанные)

	Возврат СтрШаблон("Создать анкету %1 %2.%3.", 
		ТРег(АнкетныеДанные.Фамилия), 
		Лев(АнкетныеДанные.Имя, 1), 
		Лев(АнкетныеДанные.Отчество, 1));

КонецФункции

&НаКлиенте
Процедура ПоверенныеПриАктивизацииСтроки(Элемент)
	
	ТекСтрока = Элементы.Поверенные.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекСтрока.Повереный) И ТипЗнч(ТекСтрока.АнкетныеДанные) = Тип("Структура") Тогда
		Элементы.КомандаСоздатьАнкету.Видимость = Истина;
		Элементы.КомандаСоздатьАнкету.Заголовок = ПолучитьЗаголовокКомандыСоздатьАнкету(ТекСтрока.АнкетныеДанные);
	Иначе
		Элементы.КомандаСоздатьАнкету.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры
