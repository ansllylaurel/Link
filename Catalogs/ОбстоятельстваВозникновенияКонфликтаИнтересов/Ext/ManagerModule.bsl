
Функция ПолучитьПараметрыОбстоятельства(Обстоятельство) Экспорт

	Параметры = Новый Структура("ЦенныеБумаги, ОграничениеТипа, Заголовок", Ложь, Неопределено, "");
	
	Если Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СовместноеВладение Тогда
		// Кодекс профэтики
		Параметры.Вставить("ЦенныеБумаги", Истина);
				
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.Сделка 
		Или Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаРЕПО Тогда
		
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("ДокументСсылка.Сделка, ДокументСсылка.СделкаРЕПО, ДокументСсылка.СведенияПредоставляемыеЮрФизЛицами"));
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДепозитныйВклад Тогда
		
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады"));
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЭмитентСвязанноеЛицо Тогда
		// Указание 5511-У 
		// Пункт 1
		Параметры.Вставить("ЦенныеБумаги", Истина);
		Параметры.Вставить("Заголовок", "Ценная бумага");
				
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.АктивыПереданныеВПользование Тогда 
		// Пункт 2
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		Параметры.Вставить("Заголовок", "Юр. Физ. лицо");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЦенныеБумагиНаРазмещении Тогда 
		// Пункт 3
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		Параметры.Вставить("Заголовок", "Юр. Физ. лицо");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорОСтабилизацииЦен Тогда 
		// Пункт 4
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		Параметры.Вставить("Заголовок", "Юр. Физ. лицо");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.НенаилучшиеУсловияСделок
		Или Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.НеНаилучшиеУсловияСделок_5899 Тогда 
		// Пункт 5
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("ДокументСсылка.Сделка, ДокументСсылка.СделкаРЕПО"));
		Параметры.Вставить("Заголовок", "Сделка");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаСУправляющейКомпанией Тогда 
		// Пункт 6
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("ДокументСсылка.Сделка, ДокументСсылка.СделкаРЕПО"));
		Параметры.Вставить("Заголовок", "Сделка");
				
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ИспользованиеИнформации 
		Или Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ИспользованиеИнформации_5899 Тогда 
		// Пункт 7 
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("ДокументСсылка.Сделка, ДокументСсылка.СделкаРЕПО"));
		Параметры.Вставить("Заголовок", "Сделка");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЧастотаСделок 
		Или Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ЧастотаСделок_5899 Тогда 
		// Пункт 8
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("ДокументСсылка.Сделка, ДокументСсылка.СделкаРЕПО"));
		Параметры.Вставить("Заголовок", "Сделка");
		
	ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДоговорыСТретьимиЛицами Тогда 
		// Пункт 9
		Параметры.Вставить("ОграничениеТипа", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
		Параметры.Вставить("Заголовок", "Договор");
		
	КонецЕсли; 
	
	Возврат Параметры;

КонецФункции
 