	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Актуальный</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СправочникСотрудники.Ссылка КАК Ссылка,
	СправочникСотрудники.ПометкаУдаления КАК ПометкаУдаления,
	СправочникСотрудники.Код КАК Код,
	СправочникСотрудники.Наименование КАК Наименование,
	СправочникСотрудники.Организация КАК Организация,
	СправочникСотрудники.ВидЗанятости КАК ВидЗанятости,
	СправочникСотрудники.ЮрФизЛицо КАК ЮрФизЛицо,
	СправочникСотрудники.Предопределенный КАК Предопределенный,
	СправочникСотрудники.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ДатыСотрудниковОрганизации.ДатаПриемаНаРаботу КАК ДатаПриемаНаРаботу,
	ВЫБОР
		КОГДА СотрудникиОрганизацииПоследняяЗапись.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
			ТОГДА СотрудникиОрганизацииПоследняяЗапись.Период
	КОНЕЦ КАК ДатаУвольнения,
	СотрудникиОрганизацииНаДату.Должность КАК Должность,
	СотрудникиОрганизацииНаДату.Подразделение КАК Подразделение,
	ЕСТЬNULL(СотрудникиОрганизацииНаДату.ВидСобытия, ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)) &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение) КАК Актуальный,
	СостояниеСотрудниковОрганизацийСрезПоследних.Состояние КАК Состояние
ИЗ
	Справочник.Сотрудники КАК СправочникСотрудники
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СотрудникиОрганизации.Сотрудник КАК Сотрудник,
			МИНИМУМ(СотрудникиОрганизации.Период) КАК ДатаПриемаНаРаботу,
			МАКСИМУМ(СотрудникиОрганизации.Период) КАК ДатаПоследнейЗаписи
		ИЗ
			РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		
		СГРУППИРОВАТЬ ПО
			СотрудникиОрганизации.Сотрудник) КАК ДатыСотрудниковОрганизации
		ПО СправочникСотрудники.Ссылка = ДатыСотрудниковОрганизации.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизацииПоследняяЗапись
		ПО СправочникСотрудники.Ссылка = СотрудникиОрганизацииПоследняяЗапись.Сотрудник
			И (ДатыСотрудниковОрганизации.ДатаПоследнейЗаписи = СотрудникиОрганизацииПоследняяЗапись.Период)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(&amp;Период, ) КАК СостояниеСотрудниковОрганизацийСрезПоследних
		ПО СправочникСотрудники.Ссылка = СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&amp;Период, ) КАК СотрудникиОрганизацииНаДату
		ПО СправочникСотрудники.Ссылка = СотрудникиОрганизацииНаДату.Сотрудник
ГДЕ
	(&amp;ОтбражатьАктуальные = ЛОЖЬ
			ИЛИ ЕСТЬNULL(СотрудникиОрганизацииНаДату.ВидСобытия, ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)) &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))</QueryText>
				<MainTable>Catalog.Сотрудники</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">Актуальный</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:appearance>
								<dcscor:item xsi:type="dcsset:SettingsParameterValue">
									<dcscor:parameter>ЦветТекста</dcscor:parameter>
									<dcscor:value xsi:type="v8ui:Color">style:НеактуальнаяСтрокаВСпискеЦвет</dcscor:value>
								</dcscor:item>
							</dcsset:appearance>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
		<Attribute name="Период" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата периодических реквизитов</v8:content>
				</v8:item>
			</Title>
			<Type>
