
Процедура ПроверитьНаличиеПользователяУСотрудников(НаборЗаписей, ПолеСотрудник, Отказ) Экспорт

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(НаборЗаписей.Выгрузить(, "ГруппаВидовОпераций," + ПолеСотрудник), "_НаборЗаписей", Запрос, Истина);
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НаборЗаписей.Сотрудник КАК Сотрудник
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|		ПО _НаборЗаписей.Сотрудник = Сотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыВидовОпераций КАК ГруппыВидовОпераций
		|		ПО _НаборЗаписей.ГруппаВидовОпераций = ГруппыВидовОпераций.Ссылка
		|ГДЕ
		|	НЕ ГруппыВидовОпераций.Родитель В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ГруппыВидовОпераций.ОтчетностьЦБ))
		|	И Сотрудники.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.)";
	
	Если ПолеСотрудник <> "Сотрудник" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_НаборЗаписей.Сотрудник", "_НаборЗаписей." + ПолеСотрудник);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("У сотрудника %1 не указан пользователь. Сотрудник не может использоваться в механизме ответственных за операции.", Выборка.Сотрудник), Выборка.Сотрудник,,, Отказ);
	КонецЦикла;
	
КонецПроцедуры

Функция СотрудникИспользуетсяВМеханизмеОтветственныхЗаОперации(Сотрудник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗамещающиеСотрудники.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЗамещающиеСотрудники КАК ЗамещающиеСотрудники
		|ГДЕ
		|	(ЗамещающиеСотрудники.Сотрудник = &Сотрудник
		|			ИЛИ ЗамещающиеСотрудники.Замещающий = &Сотрудник)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОтветственныеЗаОперации.Период
		|ИЗ
		|	РегистрСведений.ОтветственныеЗаОперации КАК ОтветственныеЗаОперации
		|ГДЕ
		|	ОтветственныеЗаОперации.Сотрудник = &Сотрудник";
		
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПроверитьОтветственныхНаУвольнение(НаборЗаписей, Отказ) Экспорт 
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРегистра = НаборЗаписей.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЗаписьСотрудникиОрганизации",	ИмяРегистра = "СотрудникиОрганизации");
	Запрос.УстановитьПараметр("ЗаписьОтветственныеЗаОперации",	ИмяРегистра = "ОтветственныеЗаОперации");
	Запрос.УстановитьПараметр("ЗаписьЗамещающиеСотрудники", 	ИмяРегистра = "ЗамещающиеСотрудники");
	
	Запрос.УстановитьПараметр("Организация", ?(НаборЗаписей.Отбор.Найти("Организация") = Неопределено,	Неопределено, НаборЗаписей.Отбор.Найти("Организация").Значение));
	Запрос.УстановитьПараметр("Сотрудник",	 ?(НаборЗаписей.Отбор.Найти("Сотрудник") = Неопределено,	Неопределено, НаборЗаписей.Отбор.Найти("Сотрудник").Значение));
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Организация КАК Организация,
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник КАК Сотрудник,
		|	ДОБАВИТЬКДАТЕ(СотрудникиОрганизацииСрезПоследних.Период, ДЕНЬ, -1) КАК ДатаУвольнения
		|ПОМЕСТИТЬ _УволенныеСотрудникиОрганизации
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(
		|			,
		|			&Организация = НЕОПРЕДЕЛЕНО
		|				ИЛИ Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Сотрудник %1 назначен ответственным за операции с %3 по %4. При этом сотрудник %1 уволен %5, необходимо установить дату окончания ответственности не позднее %5.%2"" КАК ШаблонСообщения,
		|	ОтветственныеЗаОперации.Сотрудник КАК Сотрудник,
		|	"""" КАК Замещающий,
		|	ОтветственныеЗаОперации.Период КАК ДатаНачала,
		|	ОтветственныеЗаОперации.ДатаОкончания КАК ДатаОкончания,
		|	_УволенныеСотрудникиОрганизации.ДатаУвольнения КАК ДатаУвольнения
		|ИЗ
		|	РегистрСведений.ОтветственныеЗаОперации КАК ОтветственныеЗаОперации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _УволенныеСотрудникиОрганизации КАК _УволенныеСотрудникиОрганизации
		|		ПО ОтветственныеЗаОперации.Организация = _УволенныеСотрудникиОрганизации.Организация
		|			И ОтветственныеЗаОперации.Сотрудник = _УволенныеСотрудникиОрганизации.Сотрудник
		|			И (ОтветственныеЗаОперации.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ _УволенныеСотрудникиОрганизации.ДатаУвольнения < ОтветственныеЗаОперации.ДатаОкончания)
		|ГДЕ
		|	(&ЗаписьСотрудникиОрганизации = ИСТИНА
		|			ИЛИ &ЗаписьОтветственныеЗаОперации = ИСТИНА)
		|	И (&Организация = НЕОПРЕДЕЛЕНО
		|			ИЛИ ОтветственныеЗаОперации.Организация = &Организация)
		|	И (&Сотрудник = НЕОПРЕДЕЛЕНО
		|			ИЛИ ОтветственныеЗаОперации.Сотрудник = &Сотрудник)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Сотрудника %1 замещает сотрудник %2 с %3 по %4. При этом сотрудник %1 уволен %5, необходимо установить дату окончания замещения не позднее %5."",
		|	ЗамещающиеСотрудники.Сотрудник,
		|	ЗамещающиеСотрудники.Замещающий,
		|	ЗамещающиеСотрудники.Период,
		|	ЗамещающиеСотрудники.ДатаОкончания,
		|	_УволенныеСотрудникиОрганизации.ДатаУвольнения
		|ИЗ
		|	РегистрСведений.ЗамещающиеСотрудники КАК ЗамещающиеСотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _УволенныеСотрудникиОрганизации КАК _УволенныеСотрудникиОрганизации
		|		ПО ЗамещающиеСотрудники.Организация = _УволенныеСотрудникиОрганизации.Организация
		|			И ЗамещающиеСотрудники.Сотрудник = _УволенныеСотрудникиОрганизации.Сотрудник
		|			И (ЗамещающиеСотрудники.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ _УволенныеСотрудникиОрганизации.ДатаУвольнения < ЗамещающиеСотрудники.ДатаОкончания)
		|ГДЕ
		|	(&ЗаписьСотрудникиОрганизации = ИСТИНА
		|			ИЛИ &ЗаписьЗамещающиеСотрудники = ИСТИНА)
		|	И (&Организация = НЕОПРЕДЕЛЕНО
		|			ИЛИ ЗамещающиеСотрудники.Организация = &Организация)
		|	И (&Сотрудник = НЕОПРЕДЕЛЕНО
		|			ИЛИ ЗамещающиеСотрудники.Сотрудник = &Сотрудник)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Сотрудник %1 указан замещающим для сотрудника %2 с %3 по %4. При этом сотрудник %1 уволен %5, необходимо установить дату окончания замещения не позднее %5."",
		|	ЗамещающиеСотрудники.Замещающий,
		|	ЗамещающиеСотрудники.Сотрудник,
		|	ЗамещающиеСотрудники.Период,
		|	ЗамещающиеСотрудники.ДатаОкончания,
		|	_УволенныеСотрудникиОрганизации.ДатаУвольнения
		|ИЗ
		|	РегистрСведений.ЗамещающиеСотрудники КАК ЗамещающиеСотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _УволенныеСотрудникиОрганизации КАК _УволенныеСотрудникиОрганизации
		|		ПО ЗамещающиеСотрудники.Организация = _УволенныеСотрудникиОрганизации.Организация
		|			И ЗамещающиеСотрудники.Замещающий = _УволенныеСотрудникиОрганизации.Сотрудник
		|			И (ЗамещающиеСотрудники.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ _УволенныеСотрудникиОрганизации.ДатаУвольнения < ЗамещающиеСотрудники.ДатаОкончания)
		|ГДЕ
		|	(&ЗаписьСотрудникиОрганизации = ИСТИНА
		|			ИЛИ &ЗаписьЗамещающиеСотрудники = ИСТИНА)
		|	И (&Организация = НЕОПРЕДЕЛЕНО
		|			ИЛИ ЗамещающиеСотрудники.Организация = &Организация)
		|	И (&Сотрудник = НЕОПРЕДЕЛЕНО
		|			ИЛИ ЗамещающиеСотрудники.Сотрудник = &Сотрудник)";
#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(Выборка.ШаблонСообщения,
				Выборка.Сотрудник,
				Выборка.Замещающий,
				Формат(Выборка.ДатаНачала, "ДФ=dd.MM.yy; ДП=-"),
				Формат(Выборка.ДатаОкончания, "ДФ=dd.MM.yy; ДП=-"),
				Формат(Выборка.ДатаУвольнения, "ДФ=dd.MM.yy; ДП=-")), Выборка.Сотрудник,,, Отказ);
	КонецЦикла;
	
КонецПроцедуры
	
	