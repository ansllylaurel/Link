
#Область События_и_команды_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.Составляющая);
	
	ПоказатьПараметрыРасчета();
	ПоказатьОписаниеБазыРасчета();	
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ВидРасчета = Перечисления.ВидыРасчета.РасчетДоходности
		ИЛИ ЭтаФорма.ВидРасчета = Перечисления.ВидыРасчета.РасчетПроцентнойСтавки
		ИЛИ ЭтаФорма.ВидРасчета = Перечисления.ВидыРасчета.РасчетРезервовПИФ
		ИЛИ ЭтаФорма.ВидРасчета = Перечисления.ВидыРасчета.РасчетНадбавокИСкидокПаевыхИнвестиционныхФондов
	Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Периодичность"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранить(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ПередСохранением();
	
	ЗаполнитьЗначенияСвойств(Параметры.Составляющая, ЭтаФорма);
	
	Закрыть(Параметры.Составляющая);
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура БазаРасчетаПриИзменении(Элемент)
	
	ПриИзмененииБазыРасчета();	

КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	Представление = ПолучитьПредставлениеНастройкиРасчета();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрРасчетаПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);	
	
	Представление = ПолучитьПредставлениеНастройкиРасчета();	
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)

	Элементы = Форма.Элементы;
	
	ЭтоПараметрыРасчетаДоходности	= (Форма.ВидРасчета = ПредопределенноеЗначение("Перечисление.ВидыРасчета.РасчетДоходности"));
	ЭтаПараметрыРасчетаСтавкиКупона	= (Форма.ВидРасчета = ПредопределенноеЗначение("Перечисление.ВидыРасчета.РасчетПроцентнойСтавки"));
	ЭтоПараметрыРасчетаРезервовПИФ	= (Форма.ВидРасчета = ПредопределенноеЗначение("Перечисление.ВидыРасчета.РасчетРезервовПИФ"));
	
	ЭтоПараметрыРасчетаНадбавокСкидокПИФ = (Форма.ВидРасчета = ПредопределенноеЗначение("Перечисление.ВидыРасчета.РасчетНадбавокИСкидокПаевыхИнвестиционныхФондов"));
	
	Элементы.Периодичность.Видимость = НЕ (ЭтоПараметрыРасчетаДоходности ИЛИ ЭтаПараметрыРасчетаСтавкиКупона ИЛИ ЭтоПараметрыРасчетаРезервовПИФ ИЛИ ЭтоПараметрыРасчетаНадбавокСкидокПИФ);
	Элементы.ВалютаРасчета.Видимость = НЕ (ЭтоПараметрыРасчетаДоходности ИЛИ ЭтаПараметрыРасчетаСтавкиКупона ИЛИ ЭтоПараметрыРасчетаРезервовПИФ ИЛИ ЭтоПараметрыРасчетаНадбавокСкидокПИФ);
	
	// Параметры выбора базы расчета
	
	МассивПараметровВыбора = Новый Массив;
	
	Если ЭтоПараметрыРасчетаДоходности Тогда
		МассивПараметровВыбора = ПолучитьМассивПараметровВыбораБазыРасчетаДляРасчетаДоходности();
	ИначеЕсли ЭтаПараметрыРасчетаСтавкиКупона Тогда
		МассивПараметровВыбора = ПолучитьМассивПараметровВыбораБазыРасчетаДляРасчетаСтавкиКупона();
	КонецЕсли;
	
	Если МассивПараметровВыбора.Количество() > 0 Тогда
	    Элементы.БазаРасчета.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
		Элементы.БазаРасчета.БыстрыйВыбор = Истина;
	КонецЕсли;
	
	// Параметры базы расчета
	
	Если Форма.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.БиржевойИндекс") Тогда
	
		// Скрываем и очищаем параметры 	
		
		Элементы.ПараметрКоличествоЗначений.Видимость = ?(Форма.ПараметрСреднеарифметическое = Ложь, Ложь, ТипБиржевогоИндекса(Форма.ПараметрРасчетаБиржевойИндекс) <> ПредопределенноеЗначение("Перечисление.ТипыБиржевыхИндексов.Доходность"));
		Если Не Элементы.ПараметрКоличествоЗначений.Видимость Тогда
			Форма.ПараметрКоличествоЗначений = Неопределено;	
		КонецЕсли;
		
		Элементы.ПараметрРасчетаВалютаКонвертации.Видимость = (ВалютаБиржевогоИндекса(Форма.ПараметрРасчетаБиржевойИндекс) <> ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка"));
		Если Не Элементы.ПараметрРасчетаВалютаКонвертации.Видимость Тогда
			Форма.ПараметрРасчетаВалютаКонвертации = Неопределено;	
		КонецЕсли;
		
	ИначеЕсли Форма.БазаРасчета = ПредопределенноеЗначение("Справочник.БазыРасчета.ИзменениеСтоимостиЦБ") Тогда
		
		// При добавлении нового вида котировки, доработать отчёт расчёт доходности ДУ
		
		Элементы.ПараметрВидКотировки.РежимВыбораИзСписка = Истина;
		Элементы.ПараметрВидКотировки.РедактированиеТекста = Ложь;
		Элементы.ПараметрВидКотировки.СписокВыбора.Очистить();
		Элементы.ПараметрВидКотировки.СписокВыбора.Добавить("BID");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьМассивПараметровВыбораБазыРасчетаДляРасчетаДоходности()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БазыРасчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БазыРасчета КАК БазыРасчета
		|ГДЕ
		|	БазыРасчета.ЭтоГруппа = ЛОЖЬ
		|	И БазыРасчета.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.БазыРасчета.БазыДляРасчетаДоходности))
		|	И НЕ БазыРасчета.Ссылка В (ЗНАЧЕНИЕ(Справочник.БазыРасчета.КБДМосковскойБиржи), ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИзменениеВВП))");
	
	МассивБазРасчета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);

	Возврат РаботаСКоллекциями.ЗначениеВМассив(Новый ПараметрВыбора("Отбор.Ссылка", МассивБазРасчета)); 	
	
КонецФункции

&НаСервереБезКонтекста 
Функция ПолучитьМассивПараметровВыбораБазыРасчетаДляРасчетаСтавкиКупона()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БазыРасчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БазыРасчета КАК БазыРасчета
		|ГДЕ
		|	БазыРасчета.ЭтоГруппа = ЛОЖЬ
		|	И БазыРасчета.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.БазыРасчета.БазыДляРасчетаДоходности), ЗНАЧЕНИЕ(Справочник.БазыРасчета.МаксимальноеЗначение), ЗНАЧЕНИЕ(Справочник.БазыРасчета.МинимальноеЗначение))
		|	И НЕ БазыРасчета.Ссылка В (ЗНАЧЕНИЕ(Справочник.БазыРасчета.ИзменениеСтоимостиЦБ))");
	
	МассивБазРасчета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);

	Возврат РаботаСКоллекциями.ЗначениеВМассив(Новый ПараметрВыбора("Отбор.Ссылка", МассивБазРасчета)); 	
	
КонецФункции

&НаСервереБезКонтекста
Функция ВалютаБиржевогоИндекса(БиржевойИндекс)
	
	ВалютаБиржевогоИндекса = Справочники.Валюты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияБиржевыхИндексов.Валюта КАК Валюта
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|ГДЕ
		|	ЗначенияБиржевыхИндексов.БиржевойИндекс = &БиржевойИндекс
		|	И ЗначенияБиржевыхИндексов.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("БиржевойИндекс", БиржевойИндекс);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВалютаБиржевогоИндекса = Выборка.Валюта;
	КонецЕсли;
	
	Возврат ВалютаБиржевогоИндекса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТипБиржевогоИндекса(БиржевойИндекс)
	
	Возврат БиржевойИндекс.Тип;
	
КонецФункции

&НаСервере
Процедура ПриИзмененииБазыРасчета()
	
	ПоказатьПараметрыРасчета();
	ПоказатьОписаниеБазыРасчета();	
	
	Представление = ПолучитьПредставлениеНастройкиРасчета();	
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПараметрыРасчета()
	
	// Удаляем старые реквизиты и добавляем новые
	
	УдаляемыеРеквизиты = Новый Массив;	
	
	Если ТипЗнч(ЭтаФорма.РеквизитыПараметровРасчета) = Тип("ФиксированныйМассив") Тогда
		УдаляемыеРеквизиты = Новый Массив(ЭтаФорма.РеквизитыПараметровРасчета);
	КонецЕсли;
	
	ДобавляемыеРеквизиты 				= Новый Массив;
	СоответствиеРеквизитовИЭлементов	= Новый Соответствие;
	
	Если ЗначениеЗаполнено(БазаРасчета) Тогда
		
		ДобавляемыеРеквизиты = Справочники.БазыРасчета.ПолучитьРеквизитыБазРасчета(БазаРасчета, ЭтаФорма.ВидРасчета);
		
		// Заполним группы реквизитов
		
		Если БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоход
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ИнвестиционныйДоходПоБалансу
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБД
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИБазовогоДоходаПоЗначениюКБДПоБалансу
			ИЛИ БазаРасчета = Справочники.БазыРасчета.ОтИнвестиционногоДоходаИСреднедневнойБалансовойСтоимостиИмуществаНаходящегосяВРазмещении
		Тогда
		 	РеквизитыРасчетаИнвестиционногоДохода = Справочники.БазыРасчета.РеквизитыРасчетаИнвестиционногоДохода();
			Для Каждого Реквизит Из РеквизитыРасчетаИнвестиционногоДохода Цикл
				СоответствиеРеквизитовИЭлементов.Вставить(Реквизит.Имя, Элементы.ГруппаПараметрыРасчетаИнвестиционногоДохода);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	
	// Удаляем старые элементы управления и добавляем новые
	
	Для Каждого ИмяЭлемента Из УдаляемыеРеквизиты Цикл
		Элементы.Удалить(Элементы[ИмяЭлемента]);			
	КонецЦикла;
	
	МассивПараметровРасчета = Новый Массив;	
	
	Для Каждого ДобавляемыйРеквизит Из ДобавляемыеРеквизиты Цикл
		
		ГруппаЭлемента = СоответствиеРеквизитовИЭлементов[ДобавляемыйРеквизит.Имя];
		Если ГруппаЭлемента = Неопределено Тогда
			ГруппаЭлемента = Элементы.ГруппаОсновныеПараметры;
		КонецЕсли;
		
		ЭлементРеквизита = Элементы.Добавить(ДобавляемыйРеквизит.Имя, Тип("ПолеФормы"), ГруппаЭлемента);
		ЭлементРеквизита.ПутьКДанным	= ДобавляемыйРеквизит.Имя;
		ЭлементРеквизита.Вид			= ВидПоляФормы.ПолеВвода;

		УстановитьПараметрыВыбораРеквизита(ЭлементРеквизита, ДобавляемыйРеквизит);
		
		ЭлементРеквизита.УстановитьДействие("ПриИзменении", "ПараметрРасчетаПриИзменении");
		
		МассивПараметровРасчета.Добавить(ДобавляемыйРеквизит.Имя);	
		
	КонецЦикла;
	
	ЭтаФорма.РеквизитыПараметровРасчета	= Новый ФиксированныйМассив(МассивПараметровРасчета);
	
	// Заполняем реквизиты сохраненными данными
	
	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		
		ПараметрыРасчета = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Если ТипЗнч(ПараметрыРасчета) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыРасчета);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораРеквизита(ЭлементРеквизита, ДобавляемыйРеквизит)
	
	Если ДобавляемыйРеквизит.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.НастройкиРасчета") Тогда
		ЭлементРеквизита.ПараметрыВыбора = Новый ФиксированныйМассив(РаботаСКоллекциями.ЗначениеВМассив(Новый ПараметрВыбора("Отбор.ВидРасчета", ЭтаФорма.ВидРасчета)));
	КонецЕсли;
		
	Если ЭтаФорма.БазаРасчета = Справочники.БазыРасчета.ИндексПотребительскихЦен
		И ДобавляемыйРеквизит.ТипЗначения = Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПроцентныхПоказателей") Тогда
		
		МассивИПЦ = Новый Массив;
		МассивИПЦ.Добавить(Перечисления.ВидыПроцентныхПоказателей.ИПЦкДекабрюПредыдущегоГода);
		МассивИПЦ.Добавить(Перечисления.ВидыПроцентныхПоказателей.ИПЦкКонцуПредыдущегоМесяца);
		МассивИПЦ.Добавить(Перечисления.ВидыПроцентныхПоказателей.ИПЦкСоответствующемуМесяцуПредыдущегоГода);
		
		ЭлементРеквизита.ПараметрыВыбора = Новый ФиксированныйМассив(РаботаСКоллекциями.ЗначениеВМассив(Новый ПараметрВыбора("Отбор.Ссылка", МассивИПЦ)));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначенияПараметровРасчета()
	
	ПараметрыРасчета = Новый Структура;
	
	Если Не ЗначениеЗаполнено(БазаРасчета) Тогда
		Возврат ПараметрыРасчета;
	КонецЕсли;
	
	Если ТипЗнч(ЭтаФорма.РеквизитыПараметровРасчета) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ПараметрРасчета Из ЭтаФорма.РеквизитыПараметровРасчета Цикл
			ПараметрыРасчета.Вставить(ПараметрРасчета, ЭтаФорма[ПараметрРасчета]);		
		КонецЦикла;		
	КонецЕсли;
	
	Возврат ПараметрыРасчета; 	
	
КонецФункции

&НаСервере
Функция ПолучитьПредставлениеНастройкиРасчета(ПараметрыРасчета = Неопределено)
	
	Если Не ЗначениеЗаполнено(БазаРасчета) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ПараметрыРасчета = Неопределено Тогда
		ПараметрыРасчета = ПолучитьЗначенияПараметровРасчета();
	КонецЕсли;
	
	Возврат Справочники.БазыРасчета.ПолучитьПредставлениеРасчета(БазаРасчета, ПараметрыРасчета, Периодичность); 	
	
КонецФункции

&НаСервере
Процедура ПоказатьОписаниеБазыРасчета()

	Если ЗначениеЗаполнено(БазаРасчета) Тогда

		ОписаниеБазыРасчета = БазаРасчета.Описание.Получить();	
		
		ТекстРасчета	= ОписаниеБазыРасчета.ПолучитьТекст();
		КартинкиРасчета	= Неопределено;
		ОписаниеБазыРасчета.ПолучитьHTML(, КартинкиРасчета);		
		
		Элементы.ОписаниеБазыРасчета.Видимость = ЗначениеЗаполнено(ТекстРасчета) ИЛИ ЗначениеЗаполнено(КартинкиРасчета);

	Иначе

		Элементы.ОписаниеБазыРасчета.Видимость = Ложь;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередСохранением()
	
	ПараметрыРасчета = ПолучитьЗначенияПараметровРасчета(); 
	
	ПоместитьВоВременноеХранилище(ПараметрыРасчета, АдресВременногоХранилища);
	
	Если ПустаяСтрока(Представление) Тогда
		Представление = ПолучитьПредставлениеНастройкиРасчета(ПараметрыРасчета);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
