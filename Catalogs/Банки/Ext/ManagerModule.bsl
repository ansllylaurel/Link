
Функция ЯвляетсяРезидентом(БанкСсылка, НаДату = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.РезидентРФ
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			"+?(ЗначениеЗаполнено(НаДату),"&НаДату","")+",
		|			ЮрФизЛицо В
		|				(ВЫБРАТЬ
		|					Банки.ЮрФизЛицо
		|				ИЗ
		|					Справочник.Банки КАК Банки
		|				ГДЕ
		|					Банки.Ссылка = &БанкСсылка) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("БанкСсылка", БанкСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.РезидентРФ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

