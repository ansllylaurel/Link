		КонецЕсли;
		
		Для каждого Шаблон Из Шаблоны Цикл
			Если СтрНайти(ШаблонУсловия, "%") > 0 Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + Шаблон.Параметр, СтрШаблон(ШаблонУсловия, Шаблон.ПутьКДанным, ЭлементОтбора.Ключ)); 
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + Шаблон.Параметр, ШаблонУсловия); 
			КонецЕсли;
		КонецЦикла; 
		
		Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		
	КонецЦикла; 
	
#КонецОбласти
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДействующиеСчетаДУ#", ИмяВременнойТаблицы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
#Область Контроль_наличия_лицензий

	Если СтруктураОтборов.ВидДеятельности <> Неопределено И НЕ РезультатЗапроса.Пустой() Тогда
		
		МассивСообщений = Новый Массив;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивСообщений.Добавить(СтрШаблон("По счёту внутр. учёта '%1' не указана лицензия на %2", Выборка.Ссылка, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")));
		КонецЦикла;
		
		ВызватьИсключение СтрСоединить(МассивСообщений, Символы.ПС);
		
	КонецЕсли;	
	
#КонецОбласти	
	
КонецПроцедуры

Функция СчетДоверительногоУправленияВходитВСтандартнуюСтратегию(Период, Организация, СчетДоверительногоУправления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная КАК СтратегияСтандартная
		|ИЗ
		|	РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|ГДЕ
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная";
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Вспомогательная функция. Возвращает структуру с отборами для последующей передачи в ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц или СчетаДоверительногоУправленияНаДатуСАктивами
//
//	Параметры:
//		Организация 	- организация
//		Значение отбора - одно из значений:
//							СправочникСсылка.СтратегииИндивидуальногоИнвестирования
//							СправочникСсылка.ЮрФизЛица, СправочникСсылка.ПаевыеИнвестиционныеФонды
//							ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления
//							Массив со значениями перечисления ВидыДоговоровДоверительногоУправления
//		ВключаяСчетаДУ 	- Массив счетов доверительного управления, которые нужно включить в отбор
//		ИсключаяСчетаДУ - Массив счетов доверительного управления, которые нужно исключить из отбора
//
Функция СтруктураДляОтбораСчетовДоверительногоУправления(Организация, ЗначениеОтбора = Неопределено, ВключаяСчетаДУ = Неопределено, ИсключаяСчетаДУ = Неопределено) Экспорт
	
	Результат = Новый Структура("Организация", Организация);
	
	Если ТипЗнч(ЗначениеОтбора) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		
		Результат.Вставить("Стратегия", ЗначениеОтбора);
		
	ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления")
		ИЛИ ТипЗнч(ЗначениеОтбора) = Тип("Массив")
	Тогда
	
		Результат.Вставить("ВидДоговораДоверительногоУправления", ЗначениеОтбора);
		
	ИначеЕсли Метаданные.ОпределяемыеТипы.КлиентыДоверительногоУправления.Тип.СодержитТип(ТипЗнч(ЗначениеОтбора)) Тогда
		
		Результат.Вставить("Клиент", ЗначениеОтбора);
		
	ИначеЕсли ЗначениеОтбора = Неопределено Тогда	
		// Ничего не добавляем
	Иначе
		
		ВызватьИсключение "Получение действующих счетов ДУ по отбору '" + ЗначениеОтбора + "' не поддерживается";
		
	КонецЕсли;

	Если ВключаяСчетаДУ <> Неопределено Тогда
		Результат.Вставить("ВключаяСчетаДУ", ВключаяСчетаДУ);
	КонецЕсли;
	
	Если ИсключаяСчетаДУ <> Неопределено Тогда
		Результат.Вставить("ИсключаяСчетаДУ", ИсключаяСчетаДУ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу счетов доверительного управления, у которых есть активы, на дату. Опционально помещает ее в менеджер временных таблиц
//
//	Параметры:
//		Дата - дата
//		Отбор							- Структура							- структура позволяет установить отбор по ключам:
//											Организация							- СправочникСсылка.Организации, Массив								- отбор по организации,
//											ВидДоговораДоверительногоУправления	- ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления, Массив	- отбор по виду договора д/у,
//											ВидДеятельности						- Справочник.ВидыДеятельности, Массив								- отбор по виду лицензии УК
//											Клиент								- ОпределяемыйТип.КлиентыДоверительногоУправления, Массив			- отбор по клиенту д/у
//											Стратегия							- Справочник.СтратегииИндивидуальногоИнвестирования, Массив			- отбор по стратегии
//											ВключаяСчетаДУ						- Массив															- добавить счета ДУ из переданного массива 
//											ИсключаяСчетаДУ						- Массив															- исключить счета ДУ по переданному массиву
//										- Неопределено						- без отбора
//		ПоместитьВоВременнуюТаблицу 	- Булево
//		ИмяВременнойТаблицы				- Строка 							- имя таблицы, если требуется поместить во временную таблицу
//		МенеджерВременныхТаблиц			- менеджер временных таблиц
//
Функция СчетаДоверительногоУправленияНаДатуСАктивами(Дата, Отбор = Неопределено, ПоместитьВоВременнуюТаблицу = Ложь, ИмяВременнойТаблицы = "_ДействующиеСчетаДоверительногоУправления", МенеджерВременныхТаблиц = Неопределено) Экспорт 
	
	Запрос = Новый Запрос;
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;	
		
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
	ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос, Дата, Отбор, "_СчетаДоверительногоУправления");	
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	_СчетаДоверительногоУправления.Клиент КАК Клиент
		|ПОМЕСТИТЬ _ДействующиеСчетаДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ПО (ОстаткиДенежныхСредств.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка)
		|			И (ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_СчетаДоверительногоУправления.Ссылка,
		|	_СчетаДоверительногоУправления.Клиент
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ПО (ОстаткиЦенныхБумаг.СчетДоверительногоУправления = _СчетаДоверительногоУправления.Ссылка)
		|			И (ОстаткиЦенныхБумаг.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ))";
		
	Запрос.УстановитьПараметр("Период",				Дата);
		
	// Получаем результат функции	
	Если ПоместитьВоВременнуюТаблицу Тогда
				
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ДействующиеСчетаДоверительногоУправления", "ПОМЕСТИТЬ " + ИмяВременнойТаблицы);	
		
		Запрос.Выполнить();
		
		РезультатФункции = ИмяВременнойТаблицы;
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ _ДействующиеСчетаДоверительногоУправления", "");	
		
		РезультатФункции = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

// Проверяет, является ли клиент-физ. лицо умершим на заданую дату
//
//	Параметры:
//		- СчетДоверительногоУправления	- счет доверительного управления
//		- ДатаАктуальности 				- дата проверки сведений
//
Функция ЭтоУмершийКлиент(СчетДоверительногоУправления, ДатаАктуальности) Экспорт
	
	Клиент = КлиентДоверительногоУправления(СчетДоверительногоУправления);
	
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.ЮрФизЛица") 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ВидЮрФизЛица") = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаСмерти КАК ДатаСмерти
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
			|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|ГДЕ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаСмерти <> ДАТАВРЕМЯ(1, 1, 1)");
		
		Запрос.УстановитьПараметр("Период", 		ДатаАктуальности);
		Запрос.УстановитьПараметр("Организация", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация"));
		Запрос.УстановитьПараметр("ЮрФизЛицо", 		Клиент);
		
		Возврат Не Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДатаПрекращенияРаботыСКлиентом(Клиент, Организация, Период) Экспорт

	// Дата, вывода денежных средств клиента при расторжении последнего договора или при погашении последней заявки пайщика, 
	// при условии отсутствия иных действующих договоров и (или) непогашенных заявок пайщика, а также отсутствия у Компании 
	// обязательств перед данным клиентом по выплате денежных средств по иным расторгнутым договорам и (или) погашенным заявкам пайщика

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.Клиент КАК Клиент,
		|	ВложенныйЗапрос.ДатаРасторжения КАК ДатаРасторжения,
		|	ВложенныйЗапрос.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ ВложенныйЗапрос.ДатаРасторжения >= &Период КАК Действует
		|ПОМЕСТИТЬ _ВсеДоговоры
		|ИЗ
		|	(ВЫБРАТЬ
		|		КлиентыДоверительногоУправления.Организация КАК Организация,
		|		КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|		ЕСТЬNULL(ДОБАВИТЬКДАТЕ(МИНИМУМ(КлиентыДоверительногоУправленияСледующие.Период), ДЕНЬ, -1), КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения) КАК ДатаРасторжения
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Клиент = &Клиент
		|					И СчетДоверительногоУправления.ДатаЗаключения <= &Период) КАК КлиентыДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправленияСледующие
		|			ПО КлиентыДоверительногоУправления.Организация = КлиентыДоверительногоУправленияСледующие.Организация
		|				И КлиентыДоверительногоУправления.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСледующие.СчетДоверительногоУправления
		|				И КлиентыДоверительногоУправления.Клиент <> КлиентыДоверительногоУправленияСледующие.Клиент
		|				И КлиентыДоверительногоУправления.Период < КлиентыДоверительногоУправленияСледующие.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		КлиентыДоверительногоУправления.Клиент,
		|		КлиентыДоверительногоУправления.Организация,
		|		КлиентыДоверительногоУправления.СчетДоверительногоУправления,
		|		КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаРасторжения) КАК ВложенныйЗапрос
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &Период
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
		|			&Граница,
		|			Организация = &Организация
		|				И Пайщик = &Клиент) КАК ДолиПайщиковВИнвестиционномФондеОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|ГДЕ
		|	ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаявкаПайщика.Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
		|	ЗаявкаПайщика.Пайщик,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &Период
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (ЗаявкаПайщика.Организация = &Организация)
		|			И (ЗаявкаПайщика.Пайщик = &Клиент)
		|			И (ЗаявкаПайщика.Многократная)
		|			И ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_ВсеДоговоры.Клиент КАК Клиент
		|ИЗ
		|	_ВсеДоговоры КАК _ВсеДоговоры
		|ГДЕ
		|	_ВсеДоговоры.Действует";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Период), Видграницы.Включая));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		// Есть действующие договоры
		Возврат '00010101';
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_ВсеДоговоры.ДатаРасторжения) КАК ДатаРасторжения
		|ИЗ
		|	_ВсеДоговоры КАК _ВсеДоговоры";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаРасторжения;
	КонецЕсли;
	
	Возврат '00010101';
	
КонецФункции
