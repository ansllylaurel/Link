	СтруктураОтборов = Новый Структура(СтрСоединить(ОбрабатываемыеКлючиОтбора.ВыгрузитьКолонку(0), ","));
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		РаботаСКоллекциями.ДополнитьСтруктуру(СтруктураОтборов, Отбор, Истина);
