
Функция СформироватьНаименование(РеквизитыСчета, ЗадействованныеРеквизиты = "") Экспорт
	
	ЗадействованныеРеквизиты = "Клиент, ЛичныйКабинет";
	
	Если РеквизитыСчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Наименование = "";
	
	Если ЗначениеЗаполнено(РеквизитыСчета.Клиент) Тогда
		Наименование = Строка(РеквизитыСчета.Клиент) + ?(РеквизитыСчета.ЛичныйКабинет, " [ЛКК]", "");
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции // СформироватьНаименование

Функция КлиентЯвляетсяПНилиНПФ(СчетДоверительногоУправления) Экспорт
	
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями 
		Или СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		Или СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Или СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих
	Тогда
		Возврат Истина;	
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции

Функция КлиентДоверительногоУправления(СчетДоверительногоУправления, Период = Неопределено) Экспорт
	
	Возврат Кэширование.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
КонецФункции // КлиентДоверительногоУправления

Функция СчетДоверительногоУправленияКлиента(Клиент, Период = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	|			&Период,
	|			СчетДоверительногоУправления В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|				ИЗ
	|					РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
	|				ГДЕ
	|					КлиентыДоверительногоУправления.Клиент = &Клиент
	|					И КлиентыДоверительногоУправления.Период <= &Период)) КАК КлиентыДоверительногоУправленияСрезПоследних
	|ГДЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлиентыДоверительногоУправленияСрезПоследних.Период УБЫВ");
	
	Запрос.УстановитьПараметр("Период", ?(Период = Неопределено, ТекущаяДатаСеанса(), Период));
	Запрос.УстановитьПараметр("Клиент", Клиент);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетДоверительногоУправления
	КонецЕсли;

КонецФункции // СчетДоверительногоУправленияКлиента

Функция ОпределитьНовыйКодСчета(Организация, ВидДоговораДоверительногоУправления, ТекущийНомерСчета) Экспорт
	
	ПрефиксыНомеров = Новый Соответствие;
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.Собственный, "RT_");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда, "DU_RT_PIF");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР, "DU_RT_PFR");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица, "DU_RT_FL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "DU_RT_PN");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами, "DU_RT_PR");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов, "DU_RT_NPF");
		
	ИначеЕсли Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица, "DU-RPI/FL/");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица, "DU-RPI/UL/");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов, "DU-RPI/UL/");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами, "DU-RPI/PR/");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "DU-RPI/PN/");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний, "DU-RPI/SR/");		
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда, "DU_PIF");
		
	Иначе
		// текущие префиксы актуальны только для РЭМ-а, но мы имеем установку, что РЭМ рулит,
		// а остальные пользуются тем, чем дают, вплоть до особых распоряжений
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет, "DU_IIS");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих, "DU_VN");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда, "DU_PIF");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР, "DU_PFR");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица, "DU_FL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "DU_NPF");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами, "DU_NPF");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов, "DU_UL");
		ПрефиксыНомеров.Вставить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций, "DU_UL");
	КонецЕсли;
	
	ПрефиксНомера = ПрефиксыНомеров[ВидДоговораДоверительногоУправления];
	Если Не ЗначениеЗаполнено(ПрефиксНомера) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить префикс для вида договора " + ВидДоговораДоверительногоУправления + " в организации " + Организация,,,,); 
		ПрефиксНомера = "";
	КонецЕсли;
	
	// определим номер, следующий за максимальным ранее сохраненным (нумерация сквозная), исключая текущий
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(СчетаДоверительногоУправления.НомерСчета) + 1 КАК НовыйНомерСчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Договор)
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.НомерСчета <> &НомерСчета
		|	И &ОтборПоВидуДоговораДоверительногоУправления";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчета",  ТекущийНомерСчета);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления",  ВидДоговораДоверительногоУправления);
	
    УсловиеПоВидуДоговораДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПолучитьУсловиеЗапросаПоВидуДоговораДоверительногоУправления(Организация, ВидДоговораДоверительногоУправления);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидуДоговораДоверительногоУправления", УсловиеПоВидуДоговораДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НомерСчета = Формат(Выборка.НовыйНомерСчета, "ЧГ=");
		Пока СтрДлина(НомерСчета) < 3 Цикл // изначально 3 разряда хватало за глаза, а потом пришли ИИС-ы))
			НомерСчета = "0" + НомерСчета;
		КонецЦикла;
	Иначе
		НомерСчета = "001";
	КонецЕсли;
	
	Возврат ПрефиксНомера + НомерСчета;
	
КонецФункции // ОпределитьНовыйКодСчета

Функция ПолучитьУсловиеЗапросаПоВидуДоговораДоверительногоУправления(Организация, ВидДоговораДоверительногоУправления) Экспорт
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
    	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			Возврат "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)";
		Иначе
			Возврат "СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)";
		КонецЕсли;
    Иначе
		Возврат "ИСТИНА";
    КонецЕсли;
	
КонецФункции

Функция ДатаНачалаРаботыСКлиентом(Клиент, Организация) Экспорт
	
	// Ранняя из дат заключения договоров или заявок пайщика
	// В случае смены клиента доверительного управления, считаем, что отношения со старым и новым клиентом начались в одно время
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ВложенныйЗапрос.ДатаНачалаОтношений) КАК ДатаНачалаОтношений
		|ИЗ
		|	(ВЫБРАТЬ
		|		КлиентыДоверительногоУправления.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаНачалаОтношений
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|	ГДЕ
		|		КлиентыДоверительногоУправления.Клиент = &Клиент
		|		И КлиентыДоверительногоУправления.Организация = &Организация
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЗаявкаПайщика.Дата
		|	ИЗ
		|		Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|	ГДЕ
		|		ЗаявкаПайщика.Пайщик = &Клиент
		|		И ЗаявкаПайщика.Организация = &Организация) КАК ВложенныйЗапрос");
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаНачалаОтношений;
	КонецЕсли;
	
	Возврат '00010101';
	
КонецФункции

Функция НачислятьРезервыПредстоящихРасходов(СчетДоверительногоУправления, Период = Неопределено, ВидРезерва = Неопределено) Экспорт
	
	// В бух. учете для ЗПИФ резервы пока не начисляем (но механизм готов)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый)
	|			ТОГДА &Период >= ДАТАВРЕМЯ(2018, 1, 1)
	|		КОГДА &Период >= ДАТАВРЕМЯ(2019, 1, 1)
	|				И КлиентыДоверительногоУправленияСрезПоследних.Клиент.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
	|				И (УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаПрочиеВозмещаемыеРасходыУправляющего
	|						И &ВидРезерва = ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего)
	|					ИЛИ УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
	|						И &ВидРезерва = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)
	|					ИЛИ УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария
	|						И &ВидРезерва = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ &Период >= ДАТАВРЕМЯ(2019, 1, 1)
	|				И ЛОЖЬ
	|	КОНЕЦ КАК Начислять
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&Период, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
	|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд
	|ГДЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", 								Период);
	Запрос.УстановитьПараметр("ДатаНачалаУчетаРезервовПИФ", 			СистемныеФункции.ПолучитьДатуНачалаУчетаРезервовПИФ());
	Запрос.УстановитьПараметр("ДатаНачалаУчетаРезервовЗПИФВБухУчете", 	БухгалтерскийУчет.ПолучитьДатуНачалаУчетаРезервовЗПИФВБухУчете());
	Запрос.УстановитьПараметр("ВидРезерва", 							ВидРезерва);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий() И Выборка.Начислять;
	
КонецФункции

Функция ПолучитьРеквизитыКлиента(СчетДоверительногоУправления, Период = Неопределено) Экспорт
	РеквизитыКлиента = Новый Структура("ПолноеНаименование, АдресЭлектроннойПочты");	
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ КлиентыСчета
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыФизКлиента.Фамилия + "" "" + РеквизитыФизКлиента.Имя + "" "" + РеквизитыФизКлиента.Отчество КАК ПолноеНаименование,
		|	РеквизитыФизКлиента.EMail КАК АдресЭлектроннойПочты
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо В
		|				(ВЫБРАТЬ
		|					КлиентыСчета.Клиент
		|				ИЗ
		|					КлиентыСчета) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизКлиента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеквизитыЮрКлиента.ПолноеНаименованиеПоУставу,
		|	РеквизитыЮрКлиента.EMail
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо В
		|				(ВЫБРАТЬ
		|					КлиентыСчета.Клиент
		|				ИЗ
		|					КлиентыСчета) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрКлиента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда,
		|	""""
		|ИЗ
		|	Справочник.ПаевыеИнвестиционныеФонды КАК ПИФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КлиентыСчета КАК КлиентыСчета
		|		ПО (КлиентыСчета.Клиент = ПИФ.Ссылка)
		|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период,) КАК РеквизитыПИФСрезПоследних
		|       ПО (КлиентыСчета.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|");
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыКлиента, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыКлиента;
КонецФункции

Процедура ЗаполнитьСопутствующиеНастройкиНовогоСчета(СчетДоверительногоУправления) Экспорт
	
	Перем ЗначНастройки;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// цели расчета
	ВидДоговораДоверительногоУправления = СчетДоверительногоУправления.ВидДоговораДоверительногоУправления;
	
	Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица Тогда
		
		НачатьТранзакцию();
		
		Запись = РегистрыСведений.НастройкиЦелейРасчета.СоздатьМенеджерЗаписи();
		Запись.Период                           = СчетДоверительногоУправления.ДатаЗаключения;
		Запись.Организация                      = СчетДоверительногоУправления.Организация;
		Запись.СчетДоверительногоУправления     = СчетДоверительногоУправления;
		Запись.ЦельРасчета                      = Справочники.ЦелиРасчета.НалоговыйУчет;
		Запись.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная3;
		Запись.ВестиРасчетПоПартиям             = Истина;
		Запись.ВидУчетаДляОстатковПартий        = Перечисления.ВидыУчета.НалоговыйУчет;
		Запись.Записать();
		
		Запись = РегистрыСведений.НастройкиЦелейРасчета.СоздатьМенеджерЗаписи();
		Запись.Период                           = СчетДоверительногоУправления.ДатаЗаключения;
		Запись.Организация                      = СчетДоверительногоУправления.Организация;
		Запись.СчетДоверительногоУправления     = СчетДоверительногоУправления;
		Запись.ЦельРасчета                      = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
		Запись.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ;
		Запись.ВестиРасчетПоПартиям             = Ложь;
		Запись.ВидУчетаДляОстатковПартий        = Перечисления.ВидыУчета.НалоговыйУчет;
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица
			Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет
	Тогда
	
		НачатьТранзакцию();
		
		// заполним настройки на основании эталона
		ЭталонныйСчетДУ = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ПрочиеНастройки._ЭталонныеНастройкиУчетаФизЛицИИИС", СчетДоверительногоУправления.Организация);
		
		Если ЗначениеЗаполнено(ЭталонныйСчетДУ) Тогда
		
			ЭталонныеНастройки = Новый Структура("Период, Организация, СчетДоверительногоУправления, ВидУчета",
				ЭталонныйСчетДУ.ДатаЗаключения,
				ЭталонныйСчетДУ.Организация,
				ЭталонныйСчетДУ,
				Перечисления.ВидыУчета.НалоговыйУчет);
				
			ТекущиеНастройки = Новый Структура("Период, Организация, СчетДоверительногоУправления, ВидУчета",
				СчетДоверительногоУправления.ДатаЗаключения,
				СчетДоверительногоУправления.Организация,
				СчетДоверительногоУправления,
				Перечисления.ВидыУчета.НалоговыйУчет);
				
			// определим таблицы эталонных настроек
			ЭталонныеРегистрыУчета = Новый Соответствие;
			ЭталонныеРегистрыУчета.Вставить("НастройкиУчетаОбщие", Неопределено);
			ЭталонныеРегистрыУчета.Вставить("НастройкиПоВидуУчета", Неопределено);
			ЭталонныеРегистрыУчета.Вставить("НастройкиУчетаАктивов", Неопределено);	
			ЭталонныеРегистрыУчета.Вставить("НастройкиУчетаКомиссии", Неопределено);
			ЭталонныеРегистрыУчета.Вставить("НастройкиЗакрытияБухгалтерскихСчетов", Неопределено);
			ЭталонныеРегистрыУчета.Вставить("НастройкиФормированияСЧА", Неопределено);
			
			Для каждого КлючЗнач Из ЭталонныеРегистрыУчета Цикл
				
				СодержимоеРегистра = РегистрыСведений[КлючЗнач.Ключ].СоздатьНаборЗаписей();
				
				Для каждого ЭлементОтбора Из СодержимоеРегистра.Отбор Цикл
					Если ЭталонныеНастройки.Свойство(ЭлементОтбора.Имя, ЗначНастройки) Тогда
						ЭлементОтбора.Установить(ЗначНастройки);
					КонецЕсли;
				КонецЦикла;
				
				СодержимоеРегистра.Прочитать();
				
				ЭталонныеРегистрыУчета[КлючЗнач.Ключ] = СодержимоеРегистра.Выгрузить();
				
			КонецЦикла;
			
			// 1. НАСТРОЙКИ ЦЕЛЕЙ РАСЧЕТА
			НастройкиЦелейРасчета = РегистрыСведений.НастройкиЦелейРасчета.СоздатьНаборЗаписей();
			
			НастройкиЦелейРасчета.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
			
			НастройкиЦелейРасчета.Прочитать();
			НастройкиЦелейРасчета.Очистить();
			
			    // Оценка объектов в управлении
				НастройкаЦелейРасчета = НастройкиЦелейРасчета.Добавить();
				
				ЗаполнитьЗначенияСвойств(НастройкаЦелейРасчета, ТекущиеНастройки);
				
				НастройкаЦелейРасчета.ЦельРасчета                      = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
				НастройкаЦелейРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ;
				НастройкаЦелейРасчета.ВестиРасчетПоПартиям             = Ложь;
				НастройкаЦелейРасчета.ВидУчетаДляОстатковПартий        = Перечисления.ВидыУчета.НалоговыйУчет;
				НастройкаЦелейРасчета.ТочностьЦеныКупона               = 8;
				НастройкаЦелейРасчета.ТочностьЦеныОценки               = 8;
			
			    // Налоговый учет
				НастройкаЦелейРасчета = НастройкиЦелейРасчета.Добавить();
				
				ЗаполнитьЗначенияСвойств(НастройкаЦелейРасчета, ТекущиеНастройки);
				
				НастройкаЦелейРасчета.ЦельРасчета                      = Справочники.ЦелиРасчета.НалоговыйУчет;
				НастройкаЦелейРасчета.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная3;
				НастройкаЦелейРасчета.ВестиРасчетПоПартиям             = Истина;
				НастройкаЦелейРасчета.ВидУчетаДляОстатковПартий        = Перечисления.ВидыУчета.НалоговыйУчет;
				НастройкаЦелейРасчета.ТочностьЦеныКупона               = 0;
				НастройкаЦелейРасчета.ТочностьЦеныОценки               = 0;
			
			НастройкиЦелейРасчета.Записать();
			
			// 2. НАСТРОЙКИ УЧЕТА
			Для каждого КлючЗнач Из ЭталонныеРегистрыУчета Цикл
				
				РегистрНастроек = РегистрыСведений[КлючЗнач.Ключ].СоздатьНаборЗаписей();
				
				РегистрНастроек.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
				
				РегистрНастроек.Прочитать();
				РегистрНастроек.Очистить();
				
				РегистрНастроек.Загрузить(КлючЗнач.Значение);
				
				Для каждого Запись Из РегистрНастроек Цикл
					ЗаполнитьЗначенияСвойств(Запись, ТекущиеНастройки, "Период, Организация, СчетДоверительногоУправления");
				КонецЦикла;
				
				РегистрНастроек.Записать();
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Период",							СчетДоверительногоУправления.ДатаЗаключения);
			Запрос.УстановитьПараметр("Организация",					СчетДоверительногоУправления.Организация);
			Запрос.УстановитьПараметр("ВидЛицензиии",					Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
			Запрос.УстановитьПараметр("НКЦ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
			Запрос.УстановитьПараметр("Валюта",							СчетДоверительногоУправления.Организация.ВалютаУчета);
			
			Запрос.Текст = 
			
#Область ТекстЗапроса
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК Период,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	Лицензии.Ссылка КАК Лицензия,
			|	ИСТИНА КАК Действует
			|ПОМЕСТИТЬ ЛицензииДоговоровДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
			|		ПО СчетаДоверительногоУправления.Организация.ЮрФизЛицо = Лицензии.ЮрФизЛицо
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, ) КАК СтатусыЛицензийСрезПоследних
			|		ПО (Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
			|		ПО СчетаДоверительногоУправления.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
			|			И СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
			|	И Лицензии.ВидДеятельности = &ВидЛицензиии
			|	И (Лицензии.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ Лицензии.ДатаОкончания > &Период)
			|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
			|	И ЛицензииДоговоровДоверительногоУправления.Лицензия ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК Период,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	ЗНАЧЕНИЕ(Перечисление.ТипыИнвестиционныхНалоговыхВычетов.X) КАК ТипИнвестиционногоНалоговогоВычета,
			|	ИСТИНА КАК АвтоматическаяПролонгация,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыСрокаПролонгации.КоличествоЛетСрокаПролонгации)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВариантыСрокаПролонгации.ДоКонцаСледующегоГода)
			|	КОНЕЦ КАК ВариантСрокаПролонгации,
			|	ВЫБОР
			|		КОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
			|			ТОГДА 3
			|	КОНЕЦ КАК СрокПролонгации
			|ПОМЕСТИТЬ УсловияДоговоровДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления КАК УсловияДоговоровДоверительногоУправления
			|		ПО СчетаДоверительногоУправления.Ссылка = УсловияДоговоровДоверительногоУправления.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
			|	И УсловияДоговоровДоверительногоУправления.СчетДоверительногоУправления ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.Ссылка.ОсновнойБрокер КАК Брокер,
			|	СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.РасчетныйСчет КАК РасчетныйСчет
			|ПОМЕСТИТЬ ИсполнителиПоДенежнымСредствамБрокерские
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтратегииИндивидуальногоИнвестирования.ОсновныеРасчетныеСчетаБрокера КАК СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера
			|			ПО СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.Ссылка
			|				И (СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.РасчетныйСчет.ЮрФизЛицо = &НКЦ)
			|				И (СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.РасчетныйСчет.Валюта = &Валюта)
			|				И СтратегииИндивидуальногоИнвестированияСрезПоследних.Организация = СтратегииИндивидуальногоИнвестированияОсновныеРасчетныеСчетаБрокера.Ссылка.Организация
			|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
			|			И СчетаДоверительногоУправления.Организация = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления.ДатаЗаключения КАК Период,
			|	ИсполнителиПоДенежнымСредствамБрокерские.Организация КАК Организация,
			|	ИсполнителиПоДенежнымСредствамБрокерские.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ИсполнителиПоДенежнымСредствамБрокерские.Брокер КАК Брокер,
			|	ИсполнителиПоДенежнымСредствамБрокерские.РасчетныйСчет.Валюта КАК Валюта
			|ПОМЕСТИТЬ НастройкиУчетаДоходовПоЦеннымБумагам
			|ИЗ
			|	ИсполнителиПоДенежнымСредствамБрокерские КАК ИсполнителиПоДенежнымСредствамБрокерские";
	
#КонецОбласти			

			Запрос.Выполнить();

			Для Каждого ТаблицаМВТ Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
				
				ДанныеТаблицы = ТаблицаМВТ.ПолучитьДанные().Выгрузить();
				
				Если ДанныеТаблицы.Количество() > 0 Тогда
					НаборЗаписей = РегистрыСведений[ТаблицаМВТ.ПолноеИмя].СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.СчетДоверительногоУправления.Установить(СчетДоверительногоУправления);
					НаборЗаписей.Загрузить(ДанныеТаблицы);
					НаборЗаписей.ДополнительныеСвойства.Вставить("ЗаписьВСоставеСчетаДоверительногоУправления");
					НаборЗаписей.Записать();
				КонецЕсли;
				
			КонецЦикла;
				
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	ИначеЕсли РаботаСДокументами.ДатаНачалаКонтроляАкцептов() < ТекущаяДатаСеанса() И 
		(ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ) Тогда
		
		Запись = РегистрыСведений.НастройкиАкцептованияОпераций.СоздатьМенеджерЗаписи();
		Запись.Период                       = СчетДоверительногоУправления.ДатаЗаключения;
		Запись.Организация                  = СчетДоверительногоУправления.Организация;
		Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
		Запись.ВидАкцепта                   = Перечисления.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный;
		Запись.ТребуетсяАкцептование        = Истина;
		Запись.Записать();
		
		Запись = РегистрыСведений.НастройкиАкцептованияОпераций.СоздатьМенеджерЗаписи();
		Запись.Период                       = СчетДоверительногоУправления.ДатаЗаключения;
		Запись.Организация                  = СчетДоверительногоУправления.Организация;
		Запись.СчетДоверительногоУправления = СчетДоверительногоУправления;
		Запись.ВидАкцепта                   = Перечисления.ВидыАкцептов.МНО;
		Запись.ТребуетсяАкцептование        = Истина;
		Запись.Записать();
	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ИсключитьРасторгнутые") Тогда
            
        СтандартнаяОбработка = Ложь;
        Запрос = Новый Запрос;
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
			|	СчетаДоверительногоУправления.Представление КАК Представление
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	НЕ СчетаДоверительногоУправления.ПометкаУдаления
			|	И &Отбор
			|	И (СчетаДоверительногоУправления.ДатаРасторжения > &ТекущаяДата
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
			|	И &Наименование";
		
		СтрокаЗамены = "";
		Для каждого ЭлементОтбора Из Параметры.Отбор Цикл
		
			СтрокаЗамены = СтрокаЗамены + " И СчетаДоверительногоУправления." + ЭлементОтбора.Ключ;
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("Массив")
				Или ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") 
				Или ТипЗнч(ЭлементОтбора.Значение) = Тип("ФиксированныйМассив") Тогда
				СтрокаЗамены = СтрокаЗамены + " В (&" + ЭлементОтбора.Ключ + ")";
			Иначе
				СтрокаЗамены = СтрокаЗамены + " = &" + ЭлементОтбора.Ключ;
			КонецЕсли; 
			
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
					
		КонецЦикла; 
		
		Если ЗначениеЗаполнено(СтрокаЗамены) Тогда
		    СтрокаЗамены = Сред(СтрокаЗамены, 4);
		Иначе
		    СтрокаЗамены = "ИСТИНА";
		КонецЕсли; 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор", СтрокаЗамены);
		
		МассивПодстрок = СтрРазделить(Параметры.СтрокаПоиска, " ", Ложь);
		Наименование = "";
		Индекс = 0;
		Для каждого Подстрока Из МассивПодстрок Цикл
			
			ИмяПараметра = "Наименование" + Индекс;
			Индекс = Индекс + 1;
			Наименование = Наименование + " И СчетаДоверительногоУправления.Наименование ПОДОБНО &" + ИмяПараметра;
			
			Запрос.УстановитьПараметр(ИмяПараметра, "%" + Подстрока + "%");
		
		КонецЦикла; 
		
		Если ЗначениеЗаполнено(Наименование) Тогда
		    Наименование = Сред(Наименование, 4);
		Иначе
		    Наименование = "ИСТИНА";
		КонецЕсли; 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Наименование", Наименование);
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ТекущаяДата", Параметры.ТекущаяДата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
		
			Выборка = Запрос.Выполнить().Выбрать();
		
			ДанныеВыбора = Новый СписокЗначений;
			
			Пока Выборка.Следующий() Цикл
			
				ДанныеВыбора.Добавить(Выборка.Ссылка, Выборка.Представление);
			
			КонецЦикла; 
		
		КонецЕсли; 
            
    КонецЕсли; 
	
КонецПроцедуры

Функция ЕстьДочерниеСтратегии(СчетДоверительногоУправления) Экспорт

	Если СчетДоверительногоУправления.Пустая() Тогда
		
		РезультатФункции = Ложь;
		
	Иначе
	
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка В ИЕРАРХИИ(&СчетДоверительногоУправления)
			|	И СчетаДоверительногоУправления.Ссылка <> &СчетДоверительногоУправления");
		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		РезультатФункции = НЕ Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат РезультатФункции;

КонецФункции

Функция ПолучитьСчетДляУчета(СчетДоверительногоУправления, Дата = Неопределено) Экспорт

	Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_РЭМ_101") 
		И ЗначениеЗаполнено(Дата) Тогда
	
		Если Дата < '20200101' Тогда
			Возврат ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_РЭМ")
		Иначе	
			Возврат СчетДоверительногоУправления;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный И НЕ СчетДоверительногоУправления.Родитель.Пустая() Тогда
		Возврат СчетДоверительногоУправления.Родитель;
	Иначе
		Возврат СчетДоверительногоУправления;
	КонецЕсли;
	
	Если СчетДоверительногоУправления.ВидСчетаДоверительногоУправления = Перечисления.ВидыСчетовДоверительногоУправления.Договор Тогда
		Если СчетДоверительногоУправления.ВестиКонсолидированныйБухгалтерскийУчет Тогда
			Возврат СчетДоверительногоУправления;
		Иначе	
			Если ЕстьДочерниеСтратегии(СчетДоверительногоУправления) Тогда
				Возврат Неопределено; // счет учета неопределен! ведем учет по стратегиям, а у нас договор!
			Иначе
				Возврат СчетДоверительногоУправления;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если СчетДоверительногоУправления.Родитель.ВестиКонсолидированныйБухгалтерскийУчет Тогда
		    Возврат СчетДоверительногоУправления.Родитель;
		Иначе
			Возврат СчетДоверительногоУправления;
		КонецЕсли;
	КонецЕсли;

КонецФункции

Функция ПолучитьМассивСчетовПоДоговоруДУ(СчетДоверительногоУправления) Экспорт

	СчетДляУчета = ПолучитьСчетДляУчета(СчетДоверительногоУправления);
	
	// в результат запроса попадут либо все стратегии по договору, либо только наша стратегия
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В ИЕРАРХИИ(&СчетДоверительногоУправления)";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДляУчета);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Помещает действующие счета д/у во временную таблицу
// 
// Параметры:
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	Период					- Дата или Стандартный период		- дата или период, на конец дня которой (в котором) действуют счета д/у. При передаче периода нужно использовать поле Дата в результате запроса
//	Отбор					- Структура							- структура позволяет установить отбор по ключам:
//								Организация							- СправочникСсылка.Организации, Массив								- отбор по организации,
//								ВидДоговораДоверительногоУправления	- ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления, Массив	- отбор по виду договора д/у,
//								ВидДеятельности						- Справочник.ВидыДеятельности, Массив								- отбор по виду лицензии УК
//								Клиент								- ОпределяемыйТип.КлиентыДоверительногоУправления, Массив			- отбор по клиенту д/у
//								Стратегия							- Справочник.СтратегииИндивидуальногоИнвестирования, Массив			- отбор по стратегии
//								ВключаяСчетаДУ						- Массив															- добавить счета ДУ из переданного массива 
//								ИсключаяСчетаДУ						- Массив															- исключить счета ДУ по переданному массиву
//							- Неопределено						- без отбора
//	ИмяВременнойТаблицы		- Строка							- имя таблицы, под которым она будет создана в менеджере
//
Процедура ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Период, Отбор = Неопределено, ИмяВременнойТаблицы = "ДействующиеСчетаДУ") Экспорт
	
	МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Если ТипЗнч(Период) = Тип("Дата") Тогда
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Период));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Период));
	ИначеЕсли ТипЗнч(Период) = Тип("СтандартныйПериод") Тогда
		Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);	
		Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);	
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	СтратегииИндивидуальногоИнвестирования.Стратегия КАК Стратегия,
		|	КОЛИЧЕСТВО(ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности) КАК КоличествоЛицензий
		|ПОМЕСТИТЬ #ДействующиеСчетаДУ#
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
