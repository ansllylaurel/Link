
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокРеквизитов());
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация,ВидДоговораДоверительногоУправления,НоваяЗапись");
	
	Если Параметры.Свойство("Ссылка") Тогда
		КонтрольНеобходимыхРасходовВЦеломПоКлиентуИВидуДоговора = РегистрыСведений.УсловияДоговоровДоверительногоУправления.НеобходимыеРасходыКонтролируютсяПоКлиентуИВидуДоговора(Организация, Параметры.Ссылка, Период);
	КонецЕсли; 
	
	ЭтаФорма.Лицензии.ЗагрузитьЗначения(Параметры.МассивЛицензий);
	ЭтаФорма.ПериодыДругихЗаписей.ЗагрузитьЗначения(Параметры.ПериодыДругихЗаписей);
	
	УстановитьСвязиПараметровВыбораЛицензии();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИноеНаправлениеИспользованияЦелевогоКапиталаПриИзменении(Элемент)
	
	ЭтаФорма.Элементы.НаправлениеИспользованияЦелевогоКапитала.РедактированиеТекста = (ИноеНаправлениеИспользованияЦелевогоКапитала = 1);
	ЭтаФорма.Элементы.НаправлениеИспользованияЦелевогоКапитала.РежимВыбораИзСписка = Не ЭтаФорма.Элементы.НаправлениеИспользованияЦелевогоКапитала.РедактированиеТекста;
	
КонецПроцедуры
#КонецОбласти

#Область СобытияРеквизитов

&НаКлиенте
Процедура АвтоматическаяПролонгацияПриИзменении(Элемент)
	
	Если НЕ ЭтаФорма.АвтоматическаяПролонгация Тогда
		ЭтаФорма.ВариантСрокаПролонгации	= Неопределено;
		ЭтаФорма.СрокПролонгации			= Неопределено;
	КонецЕсли;
				
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантСрокаПролонгацииПриИзменении(Элемент)
	
	Если ЭтаФорма.ВариантСрокаПролонгации = ПредопределенноеЗначение("Перечисление.ВариантыСрокаПролонгации.ДоКонцаСледующегоГода") Тогда
		ЭтаФорма.СрокПролонгации = Неопределено;
	ИначеЕсли ЭтаФорма.ВариантСрокаПролонгации = ПредопределенноеЗначение("Перечисление.ВариантыСрокаПролонгации.КоличествоДнейСрокаПролонгации") Тогда
		ЭтаФорма.ЕдиницаСрокаПролонгации = "день";	
	ИначеЕсли ЭтаФорма.ВариантСрокаПролонгации = ПредопределенноеЗначение("Перечисление.ВариантыСрокаПролонгации.КоличествоЛетСрокаПролонгации") Тогда
		ЭтаФорма.ЕдиницаСрокаПролонгации = "год";	
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ЛицензииОбработкаВыбора(Элемент, МассивЗначений, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если ТипЗнч(МассивЗначений) = Тип("Массив") Тогда
		Для Каждого ВыбранноеЗначение Из МассивЗначений Цикл
			ДобавитьВыбранноеЗначениеВСписок(ЭтаФорма.Лицензии, ВыбранноеЗначение);
		КонецЦикла;
	Иначе		
		ДобавитьВыбранноеЗначениеВСписок(ЭтаФорма.Лицензии, МассивЗначений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицензииЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЭтаФорма.Лицензии.НайтиПоЗначению(ВыбранноеЗначение) <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение уже выбрано в списке");
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КомандаСохранить(Команда)
	
	Отказ = Ложь;
	
	КонтрольЛицензий(Отказ);
	КонтрольПериода(Отказ);
	КонтрольНаправленияИспользованияЦК(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяЗапись Тогда
		ЭтаФорма.Создал			= РаботаСПользователями.ТекущийПользователь();
		ЭтаФорма.ДатаСоздания	= ТекущаяДата();
	Иначе
		ЭтаФорма.Изменил		= РаботаСПользователями.ТекущийПользователь();
		ЭтаФорма.ДатаИзменения	= ТекущаяДата();
	КонецЕсли;
	
	ПараметрыЗакрытия = Новый Структура(СписокРеквизитов());
	ЗаполнитьЗначенияСвойств(ПараметрыЗакрытия, ЭтаФорма);
	
	ПараметрыЗакрытия.Вставить("МассивЛицензий", ЭтаФорма.Лицензии.ВыгрузитьЗначения());
	
	Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

&НаКлиенте
Процедура КонтрольЛицензий(Отказ)
	
	МассивЭлементовДляУдаления = Новый Массив;
	
	Для Каждого ЭлементСписка Из ЭтаФорма.Лицензии Цикл
		Если НЕ ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			МассивЭлементовДляУдаления.Добавить(ЭлементСписка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементСписка Из МассивЭлементовДляУдаления Цикл
		ЭтаФорма.Лицензии.Удалить(ЭлементСписка);
	КонецЦикла;
	
	Если ЭтаФорма.Лицензии.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано ни одной лицензии",, "Лицензии",, Отказ);
		Возврат;
	КонецЕсли;
	
	КонтрольЛицензийНаСервере(ЭтаФорма.Период, ЭтаФорма.Организация, ЭтаФорма.Лицензии.ВыгрузитьЗначения(), Отказ);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура КонтрольЛицензийНаСервере(Период, Организация, МассивЛицензий, Отказ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("МассивЛицензий"	, МассивЛицензий);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лицензии.Ссылка КАК Лицензия,
		|	Лицензии.ЮрФизЛицо = Организации.ЮрФизЛицо КАК ПринадлежитОрганизации,
		|	(Лицензии.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ Лицензии.ДатаОкончания >= &Период)
		|		И ЕСТЬNULL(СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует), ЛОЖЬ) КАК Актуальна
		|ИЗ
		|	Справочник.Лицензии КАК Лицензии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО (Организации.Ссылка = &Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, ) КАК СтатусыЛицензийСрезПоследних
		|		ПО Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия
		|ГДЕ
		|	Лицензии.Ссылка В(&МассивЛицензий)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ПринадлежитОрганизации Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Лицензия '" + Выборка.Лицензия + "' не принадлежит организации " + Организация,,,, Отказ);
		ИначеЕсли НЕ Выборка.Актуальна Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Лицензия '" + Выборка.Лицензия + "' не актуальна",,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольПериода(Отказ)
	
	Если ЭтаФорма.ПериодыДругихЗаписей.НайтиПоЗначению(ЭтаФорма.Период) <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На " + Формат(ЭтаФорма.Период, "ДФ=dd.MM.yyyy") + " условия договоров доверительного управления уже заданы",,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольНаправленияИспользованияЦК(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаправлениеИспользованияЦелевогоКапитала) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено направление использования целевого капитала",,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязиПараметровВыбораЛицензии()
	
	ЭтаФорма.ЮрФизЛицоЛицензии	= ЭтаФорма.Организация.ЮрФизЛицо;
	
	МассивСвязей = Новый Массив();
	
	НовыйОтбор = Новый СвязьПараметраВыбора("Отбор.ЮрФизЛицо", "ЮрФизЛицоЛицензии", РежимИзмененияСвязанногоЗначения.Очищать);	
	МассивСвязей.Добавить(НовыйОтбор);

	ФиксМассив = Новый ФиксированныйМассив(МассивСвязей);		
	Элементы.ЛицензииЗначение.СвязиПараметровВыбора = ФиксМассив;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокРеквизитов()
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Период");
	МассивРеквизитов.Добавить("ЕдиницаСрокаПролонгации");
	
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.УсловияДоговоровДоверительногоУправления.Ресурсы Цикл
		МассивРеквизитов.Добавить(Ресурс.Имя);
	КонецЦикла;
	
	Для Каждого Реквизит Из Метаданные.РегистрыСведений.УсловияДоговоровДоверительногоУправления.Реквизиты Цикл
		МассивРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(МассивРеквизитов, ",");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ГруппаСрокПролонгации.Видимость	= Форма.АвтоматическаяПролонгация;
	Элементы.СрокПролонгации.Видимость			= (Форма.ВариантСрокаПролонгации = ПредопределенноеЗначение("Перечисление.ВариантыСрокаПролонгации.КоличествоЛетСрокаПролонгации")
													ИЛИ Форма.ВариантСрокаПролонгации = ПредопределенноеЗначение("Перечисление.ВариантыСрокаПролонгации.КоличествоДнейСрокаПролонгации"));
	
	Элементы.ТипИнвестиционногоНалоговогоВычета.Видимость			= (Форма.ВидДоговораДоверительногоУправления = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет"));
	Элементы.НадписьУровеньКонтроляНеобходимыхРасходов.Видимость 	= Форма.КонтрольНеобходимыхРасходовВЦеломПоКлиентуИВидуДоговора;
	
	Элементы.ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента.Видимость = 
				ЭтоВидДоговораСВозможностьюОплатыВознагражденияУправляющегоИзСобственныхСредствКлиента(Форма.ВидДоговораДоверительногоУправления);
				
	Если Элементы.НаправлениеИспользованияЦелевогоКапитала.СписокВыбора.НайтиПоЗначению(Форма.НаправлениеИспользованияЦелевогоКапитала) = Неопределено Тогда 
		Форма.ИноеНаправлениеИспользованияЦелевогоКапитала = 1;
	Иначе
		Форма.ИноеНаправлениеИспользованияЦелевогоКапитала = 0;
	КонецЕсли;	
	Элементы.НаправлениеИспользованияЦелевогоКапитала.РедактированиеТекста = (Форма.ИноеНаправлениеИспользованияЦелевогоКапитала = 1);
	Элементы.НаправлениеИспользованияЦелевогоКапитала.РежимВыбораИзСписка = Не Элементы.НаправлениеИспользованияЦелевогоКапитала.РедактированиеТекста;
											
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоВидДоговораСВозможностьюОплатыВознагражденияУправляющегоИзСобственныхСредствКлиента(ВидДоговораДоверительногоУправления)
	
	Возврат РегистрыСведений.УсловияДоговоровДоверительногоУправления.ДляВидаДоговораДУВозможнаОплатаВознагражденияУправляющегоИРасходовСпецдепозитарияИзСобственныхСредствКлиента(ВидДоговораДоверительногоУправления);
	
КонецФункции
	
&НаКлиенте
Процедура ДобавитьВыбранноеЗначениеВСписок(Список, ВыбранноеЗначение)
	
	Если Список.НайтиПоЗначению(ВыбранноеЗначение) = Неопределено Тогда
		Список.Добавить(ВыбранноеЗначение);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение уже выбрано в списке");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти