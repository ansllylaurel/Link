	МаппингРеквизитВИмяПоля.Вставить("ОГРН", "ОГРН");
	МаппингРеквизитВИмяПоля.Вставить("Адрес", "Адрес");
	МаппингРеквизитВИмяПоля.Вставить("Расчетный счет", "РасчетныйСчет");
	МаппингРеквизитВИмяПоля.Вставить("Дата гос. регистрации / выдачи документа", "ДатаГосРегистрации");
	МаппингРеквизитВИмяПоля.Вставить("Орган, осуществивший регистрацию / выдавший документ", "ОрганГосРегистрации");
	СравниваемыеПоляОтчета = Новый Массив;
	СравниваемыеПоляОтчета.Добавить("Паспорт");
    СравниваемыеПоляОтчета.Добавить("ДатаРождения");
	СравниваемыеПоляОтчета.Добавить("Наименование");
	СравниваемыеПоляОтчета.Добавить("ИНН");
	СравниваемыеПоляОтчета.Добавить("ОГРН");
	СравниваемыеПоляОтчета.Добавить("Адрес");
	СравниваемыеПоляОтчета.Добавить("РасчетныйСчет");
