Функция ПолучитьМаппингРеквизитовИПоляОтчета()
	
	МаппингРеквизитВИмяПоля = Новый Соответствие;
	МаппингРеквизитВИмяПоля.Вставить("Паспорт", "Паспорт");
    МаппингРеквизитВИмяПоля.Вставить("Дата рождения", "ДатаРождения");
