КонецФункции

Функция ЭкранироватьТекстHTML(Знач Текст)
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Возврат Текст;
КонецФункции

#КонецОбласти

#Область ЭкспортВExternals

Процедура СохранитьФайлИРеестрВExternals(ДвоичныеДанныеФайла, ПолноеИмяФайла, Организация, ТаблицаПайщиков, ДатаРеестра, ПИФ, ПолноеНаименованиеПИФ = "", ПараметрыСессии = Неопределено)
	
	Разложить = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	ИмяФайла = Разложить.Имя;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ЛогироватьСообщение("Не удалось определить имя файла для сохранения в Externals", 
			УровеньЖурналаРегистрации.Предупреждение, "СохранитьФайлИРеестрВExternals", ПараметрыСессии);
		Возврат;
	КонецЕсли;
	
	ИдентификаторОрганизации = ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");
	Источник = 31;
	ДатаПубликации = ТекущаяДатаСеанса();
	ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанныеФайла, ХешФункция.SHA256);
	
	Если ЗначениеЗаполнено(ПолноеНаименованиеПИФ) Тогда
		Fund_Name = Лев(СокрЛП(ПолноеНаименованиеПИФ), 500);
	Иначе
		Fund_Name = ?(ЗначениеЗаполнено(ПИФ), Лев(СокрЛП(Строка(ПИФ)), 500), "");
	КонецЕсли;
	
	Compilation_Date = ?(ЗначениеЗаполнено(ДатаРеестра), ДатаРеестра, ТекущаяДатаСеанса());
	
	File_Id = Неопределено;
	Соединение = Неопределено;

	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals());
	РаботаСВнешнимиСистемами.СохранитьФайлВExternals(ИмяФайла, Источник, ДвоичныеДанныеФайла,
		ДатаПубликации, ИдентификаторОрганизации, ХешСумма, Соединение);
	File_Id = РаботаСВнешнимиСистемами.ПолучитьИдентификаторФайлаВExternals(
		Источник, ИдентификаторОрганизации, ИмяФайла, ХешСумма, Соединение);

	
	Если Соединение <> Неопределено Тогда
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	КонецЕсли;
	
	Если File_Id = Неопределено Тогда
		ЛогироватьСообщение("Не удалось получить идентификатор сохраненного файла в Externals", 
			УровеньЖурналаРегистрации.Предупреждение, "СохранитьФайлИРеестрВExternals", ПараметрыСессии);
		Возврат;
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.УстановитьПараметрыСоединенияСВнешнимИсточникомExternals();
	ВнешниеИсточникиДанных.Externals.УстановитьСоединение();
	
	СтрокиПоКлючу = Новый Соответствие;
	Для Каждого СтрокаП Из ТаблицаПайщиков Цикл
		ПолноеИмя = Лев(СокрЛП(Строка(СтрокаП.Идентификатор)), 255);
		НомерЛС = Лев(СокрЛП(Строка(СтрокаП.Personal_Account_Number)), 50);
		КлючЗаписи = ВРег(ПолноеИмя) + "|" + НомерЛС;
		СтрокиПоКлючу.Вставить(КлючЗаписи, СтрокаП);
	КонецЦикла;
	
	НаборЗаписей = ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Register_Of_Unit_Holders.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.File_Id.Установить(File_Id);
	
	Для Каждого ЭлементКлюча Из СтрокиПоКлючу Цикл
		
		СтрокаП = ЭлементКлюча.Значение;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.File_Id = File_Id;
		НоваяЗапись.Fund_Name = Fund_Name;
		НоваяЗапись.Compilation_Date = Compilation_Date;
		НоваяЗапись.Personal_Account_Number = Лев(СокрЛП(Строка(СтрокаП.Personal_Account_Number)), 50);
		НоваяЗапись.Is_Nominee = (СтрокаП.Is_Nominee = 1);
		НоваяЗапись.Number_Of_Units = СтрокаП.Number_Of_Units;
		НоваяЗапись.Size_Of_Share = СтрокаП.Size_Of_Share;
		НоваяЗапись.Full_Name = Лев(СокрЛП(Строка(СтрокаП.Идентификатор)), 255);
		НоваяЗапись.INN = Лев(СокрЛП(Строка(СтрокаП.ИНН)), 20);
		
		Если СтрокаП.ТипЛица = "ФЛ" И ЗначениеЗаполнено(СтрокаП.ДатаРождения) Тогда
			НоваяЗапись.Birthday = НачалоДня(СтрокаП.ДатаРождения);
		Иначе
			НоваяЗапись.Birthday = NULL;
		КонецЕсли;
		
		НоваяЗапись.Registration_Info = Лев(СформироватьТекстРегистрационныхДанныхДляExternals(СтрокаП), 255);
		
		Адрес = Лев(СокрЛП(Строка(СтрокаП.Адрес)), 255);
		НоваяЗапись.Registration_Address = Адрес;
		НоваяЗапись.Fact_Address = Адрес;
		НоваяЗапись.Bank_Account = Лев(СокрЛП(Строка(СтрокаП.РасчетныйСчет)), 255);
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
	ЛогироватьСообщение(
		СтрШаблон("Файл ""%1"" и реестр (записей: %2) сохранены в Externals", ИмяФайла, СтрокиПоКлючу.Количество()),
		УровеньЖурналаРегистрации.Информация,
		"СохранитьФайлИРеестрВExternals",
		ПараметрыСессии);
	
КонецПроцедуры

Функция СформироватьТекстРегистрационныхДанныхДляExternals(СтрокаП)
	
	Если СтрокаП.ТипЛица = "ЮЛ" Тогда
		Возврат СокрЛП(Строка(СтрокаП.ОГРН));
	КонецЕсли;
	
	Части = Новый Массив;
	
	ВидДокумента = СокрЛП(Строка(СтрокаП.ВидДокумента));
	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		ВидДокумента = "Паспорт гражданина РФ";
	КонецЕсли;
	Части.Добавить(ВидДокумента);
	
	Серия = СтрЗаменить(СокрЛП(Строка(СтрокаП.СерияПаспорта)), " ", "");
	Если ЗначениеЗаполнено(Серия) Тогда
		Части.Добавить(Серия);
	КонецЕсли;
	
	Номер = СокрЛП(Строка(СтрокаП.НомерПаспорта));
	Если ЗначениеЗаполнено(Номер) Тогда
		Части.Добавить(Номер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаП.ДатаГосРегистрации) Тогда
		Части.Добавить(Формат(СтрокаП.ДатаГосРегистрации, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Орган = ОчиститьОрганРегистрации(СокрЛП(Строка(СтрокаП.ОрганГосРегистрации)));
	Если ЗначениеЗаполнено(Орган) Тогда
		Части.Добавить(Орган);
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

Функция СформироватьОтчетыИзExternals(Организация, ДатаСверки, ПараметрыСессии = Неопределено) Экспорт
	
	Результаты = Новый Массив;
	
	СессияСозданаВФункции = (ПараметрыСессии = Неопределено);
	Если СессияСозданаВФункции Тогда
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("СформироватьОтчетыИзExternals");
	КонецЕсли;
	
	Попытка
		
		РаботаСВнешнимиСистемами.УстановитьПараметрыСоединенияСВнешнимИсточникомExternals();
		ВнешниеИсточникиДанных.Externals.УстановитьСоединение();
		
		ЗапросФондов = Новый Запрос;
		ЗапросФондов.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Реестр.Fund_Name КАК Fund_Name
			|ИЗ
			|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Register_Of_Unit_Holders КАК Реестр
			|ГДЕ
			|	Реестр.Compilation_Date >= &НачалоДня
			|	И Реестр.Compilation_Date <= &КонецДня
			|	И Реестр.Fund_Name <> """"";
		ЗапросФондов.УстановитьПараметр("НачалоДня", НачалоДня(ДатаСверки));
		ЗапросФондов.УстановитьПараметр("КонецДня", КонецДня(ДатаСверки));
		
		ВыборкаФондов = ЗапросФондов.Выполнить().Выбрать();
		
		Пока ВыборкаФондов.Следующий() Цикл
			
			ЭлементРезультата = Новый Структура("Представление, ТекстОтчета, Успех, ТекстОшибки",
				СокрЛП(ВыборкаФондов.Fund_Name), "", Ложь, "");
			
			Попытка
				РезультатФонда = СформироватьОтчетПоДаннымExternals(
					Организация, СокрЛП(ВыборкаФондов.Fund_Name), ДатаСверки, ПараметрыСессии);
				Если РезультатФонда.Успех = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ЭлементРезультата, РезультатФонда);
			Исключение
				ЭлементРезультата.ТекстОшибки = ОписаниеОшибки();
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ЭлементРезультата.ТекстОшибки);
			КонецПопытки;
			
			Результаты.Добавить(ЭлементРезультата);
			
		КонецЦикла;
		
	Исключение
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если СессияСозданаВФункции Тогда
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если СессияСозданаВФункции Тогда
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	КонецЕсли;
	
	Возврат Результаты;
	
КонецФункции

Функция СформироватьОтчетПоДаннымExternals(Организация, ПолноеНаименованиеПИФ, ДатаСверки, ПараметрыСессии = Неопределено)
	
	Результат = Новый Структура("Представление, ТекстОтчета, Успех, ТекстОшибки",
		ПолноеНаименованиеПИФ, "", Ложь, "");
	
	НайденныйПИФ = НайтиПИФПоНаименованию(ПолноеНаименованиеПИФ, ДатаСверки);
	Если НайденныйПИФ = Неопределено Тогда
		Результат.ТекстОшибки = СтрШаблон("ПИФ не найден. Значение из Externals: ""%1""", ПолноеНаименованиеПИФ);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйПИФ.СчетДУ) Тогда
		Результат.ТекстОшибки = СтрШаблон("Счет ДУ не найден. Значение из Externals: ""%1""", ПолноеНаименованиеПИФ);
		Возврат Результат;
	КонецЕсли;
	
	Если Не ПИФПринадлежитОрганизации(Организация, НайденныйПИФ.ПИФ, ДатаСверки) Тогда
		Результат.ТекстОшибки = "";
		Результат.Успех = Неопределено;
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаExternals = ПолучитьТаблицуПайщиковИзExternals(ПолноеНаименованиеПИФ, ДатаСверки);
	Если ТаблицаExternals.Количество() = 0 Тогда
		Результат.ТекстОшибки = "В Externals нет данных пайщиков по выбранной дате";
		Возврат Результат;
	КонецЕсли;
	
	Данные1С = ПолучитьДанныеПайщиковИз1С(Организация, НайденныйПИФ.ПИФ, ДатаСверки);
	Расхождения = СформироватьТаблицуРасхождений(ТаблицаExternals, Данные1С);
	
	Результат.ТекстОтчета = ПолучитьHTMLОтчетаОРасхождениях(
		Расхождения,
		Организация,
		НайденныйПИФ.ПИФ,
		ДатаСверки,
		ТаблицаExternals,
		Данные1С,
		"Externals: " + ПолноеНаименованиеПИФ);
	Результат.Успех = Истина;
	
	СчетДоверительногоУправления = НайденныйПИФ.СчетДУ;
	ЗафиксироватьРезультатСверкиВЖурнале(Организация, СчетДоверительногоУправления, ДатаСверки, НайденныйПИФ.ПИФ, Расхождения);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуПайщиковИзExternals(ПолноеНаименованиеПИФ, ДатаСверки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Реестр.Full_Name КАК Full_Name,
		|	Реестр.Personal_Account_Number КАК Personal_Account_Number,
		|	Реестр.Is_Nominee КАК Is_Nominee,
		|	Реестр.Number_Of_Units КАК Number_Of_Units,
		|	Реестр.Size_Of_Share КАК Size_Of_Share,
		|	Реестр.Birthday КАК Birthday,
		|	Реестр.INN КАК INN,
		|	Реестр.Registration_Info КАК Registration_Info,
		|	Реестр.Registration_Address КАК Registration_Address,
		|	Реестр.Bank_Account КАК Bank_Account
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Register_Of_Unit_Holders КАК Реестр
		|ГДЕ
		|	Реестр.Fund_Name = &Fund_Name
		|	И Реестр.Compilation_Date >= &НачалоДня
		|	И Реестр.Compilation_Date <= &КонецДня";
	Запрос.УстановитьПараметр("Fund_Name", ПолноеНаименованиеПИФ);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаСверки));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаСверки));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаПайщиков = Новый ТаблицаЗначений;
	ТаблицаПайщиков.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	ТаблицаПайщиков.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	ТаблицаПайщиков.Колонки.Добавить("ДатаРождения", Новый ОписаниеТипов("Дата",, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаПайщиков.Колонки.Добавить("СерияПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаПайщиков.Колонки.Добавить("НомерПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ТаблицаПайщиков.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	ТаблицаПайщиков.Колонки.Добавить("ОГРН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	ТаблицаПайщиков.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ТаблицаПайщиков.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицаПайщиков.Колонки.Добавить("ДатаГосРегистрации", Новый ОписаниеТипов("Дата"));
	ТаблицаПайщиков.Колонки.Добавить("ОрганГосРегистрации", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	ТаблицаПайщиков.Колонки.Добавить("ВидДокумента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200)));
	ТаблицаПайщиков.Колонки.Добавить("Personal_Account_Number", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТаблицаПайщиков.Колонки.Добавить("Is_Nominee", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ТаблицаПайщиков.Колонки.Добавить("Number_Of_Units", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 5)));
	ТаблицаПайщиков.Колонки.Добавить("Size_Of_Share", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 5)));
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаПайщиков.Добавить();
		НоваяСтрока.Идентификатор = СокрЛП(Строка(Выборка.Full_Name));
		НоваяСтрока.Personal_Account_Number = СокрЛП(Строка(Выборка.Personal_Account_Number));
		НоваяСтрока.Is_Nominee = ?(Выборка.Is_Nominee = Истина, 1, 0);
		НоваяСтрока.Number_Of_Units = Выборка.Number_Of_Units;
		НоваяСтрока.Size_Of_Share = Выборка.Size_Of_Share;
		НоваяСтрока.ИНН = СокрЛП(Строка(Выборка.INN));
		НоваяСтрока.Адрес = СокрЛП(Строка(Выборка.Registration_Address));
		НоваяСтрока.РасчетныйСчет = СокрЛП(Строка(Выборка.Bank_Account));
		
		РегИнфо = СокрЛП(Строка(Выборка.Registration_Info));
		ЕстьДатаРождения = ЗначениеЗаполнено(Выборка.Birthday);
		ЭтоЮЛ = (Не ЕстьДатаРождения) И (СтрДлина(ОставитьТолькоЦифрыВСтроке(РегИнфо)) >= 13 Или СтрНайти(ВРег(РегИнфо), "ОГРН") > 0);
		
		Если ЭтоЮЛ Тогда
			НоваяСтрока.ТипЛица = "ЮЛ";
			НоваяСтрока.ДатаРождения = '00010101';
			НоваяСтрока.ОГРН = ОставитьТолькоЦифрыВСтроке(РегИнфо);
			НоваяСтрока.СерияПаспорта = "";
			НоваяСтрока.НомерПаспорта = "";
		Иначе
			НоваяСтрока.ТипЛица = "ФЛ";
			НоваяСтрока.ДатаРождения = ?(ЕстьДатаРождения, НачалоДня(Выборка.Birthday), '00010101');
			НоваяСтрока.ВидДокумента = ИзвлечьВидДокументаИзСтрокиРегистрации(РегИнфо);
			РезультатПаспорт = ИзвлечьСерияИНомерПаспорта(РегИнфо);
			НоваяСтрока.СерияПаспорта = РезультатПаспорт.Серия;
			НоваяСтрока.НомерПаспорта = РезультатПаспорт.Номер;
			ДанныеРегФЛ = ИзвлечьРеквизитыРегистрацииФЛ(РегИнфо);
			НоваяСтрока.ДатаГосРегистрации = ДанныеРегФЛ.ДатаВыдачи;
			НоваяСтрока.ОрганГосРегистрации = ДанныеРегФЛ.ОрганВыдавший;
			НоваяСтрока.ОГРН = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПайщиков;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеМетоды

Процедура ЗафиксироватьРезультатСверкиВЖурнале(Организация, СчетДоверительногоУправления, ДатаРеестра, ПИФ, Расхождения)
	
	КоличествоРасхождений = 0;
	Если ТипЗнч(Расхождения) = Тип("ТаблицаЗначений") Тогда 
		КоличествоРасхождений = Расхождения.Количество(); 
	КонецЕсли;
	РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
		Организация, 
		СчетДоверительногоУправления, 
		ДатаРеестра, 
		Неопределено, 
		(КоличествоРасхождений = 0), 
		Истина, 
		ТекущаяДатаСеанса(), 
		"Автосверка (Регламентное задание)");
		
КонецПроцедуры

Процедура ЛогироватьСообщение(Текст, Знач Уровень = Неопределено, Метод = "", ПараметрыСессии = Неопределено)
	
	ТекущийУровень = ?(Уровень = Неопределено, УровеньЖурналаРегистрации.Информация, Уровень);
	
	Если ТекущийУровень = УровеньЖурналаРегистрации.Ошибка Тогда
		ИсточникОшибки = ЭтотОбъект.Метаданные().ПолноеИмя();
		Если ЗначениеЗаполнено(Метод) Тогда
			ИсточникОшибки = ИсточникОшибки + ":" + Метод;
		КонецЕсли;
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Текст, ИсточникОшибки);
		ЗаписатьРаботуВнутреннегоМеханизма(Текст, ТекущийУровень, ПараметрыСессии);
	Иначе
		ЗаписатьРаботуВнутреннегоМеханизма(Текст, ТекущийУровень, ПараметрыСессии);
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки) Экспорт
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,
		Новый Структура("ТекстОшибки", ТекстОшибки));
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		ЭтотОбъект, ИмяКоманды);
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия);
КонецПроцедуры

Процедура ЗаписатьРаботуВнутреннегоМеханизма(Текст, Уровень, ПараметрыСессии)
	
	Если ВыполняетсяИнтерактивно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
	
	Если ПараметрыСессии <> Неопределено И Уровень <> УровеньЖурналаРегистрации.Информация Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ПодготовитьОтчетОРасхождениях(Расхождения, КлючевыеПоля, СравниваемыеПоля, ТипыВариантовРасхождений = Неопределено, СкрыватьНовыеЗаписи = Ложь, ДетализированныйВид = Ложь) Экспорт
	
	Если ТипыВариантовРасхождений = Неопределено Тогда
		ТипыВариантовРасхождений = Новый Структура("НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена", 0, 1, 2, 3);
	КонецЕсли;
	НетРасхождений = ТипыВариантовРасхождений.НетРасхождений;
	НоваяЗапись = ТипыВариантовРасхождений.НоваяЗапись;
	ЗаписьУдалена = ТипыВариантовРасхождений.ЗаписьУдалена;
	ЗаписьИзменена = ТипыВариантовРасхождений.ЗаписьИзменена;

	МассивОтчетаHTML = Новый Массив;

	Если Не Расхождения.ЕстьРасхождения Тогда
		МассивОтчетаHTML.Добавить("<h3 style=""color: green"">Нет расхождений</h3>");
	Иначе
		МассивОтчетаHTML.Добавить("<h3>Новых: " + Расхождения.НоваяЗапись + ", удалено: " + Расхождения.ЗаписьУдалена + ", изменено: " + Расхождения.ЗаписьИзменена + "</h3>");
	КонецЕсли;

	МассивОтчетаHTML.Добавить("<table class=""compare_records"">");
	Расхождения.Таблица.Сортировать("ВариантРасхождения УБЫВ");

	Для Каждого СтрокаРасхождения Из Расхождения.Таблица Цикл
		Если СтрокаРасхождения.ВариантРасхождения = НоваяЗапись И СкрыватьНовыеЗаписи Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаРасхождения.ВариантРасхождения = НоваяЗапись Тогда
			ВариантРасхождения = "НОВ";
		ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьУдалена Тогда
			ВариантРасхождения = "УДЛ";
		ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьИзменена Тогда
			ВариантРасхождения = "ИЗМ";
		Иначе
			ВариантРасхождения = "";
		КонецЕсли;
		
		ФлагиВидимости = Новый Структура("ЕстьВидимыеПоУмолчанию, ЕстьСовпавшие, ЕстьАдрес", Ложь, Ложь, Ложь);
		ФрагментДеталей = "";
		
		Если ДетализированныйВид Тогда
			ФрагментДеталей = ПолучитьДетализированноеПредставлениеHTML(
				СтрокаРасхождения, СравниваемыеПоля, СтрокаРасхождения.ВариантРасхождения,
				НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена, ФлагиВидимости);
			
			Если Не ФлагиВидимости.ЕстьВидимыеПоУмолчанию
				И Не ФлагиВидимости.ЕстьСовпавшие
				И Не ФлагиВидимости.ЕстьАдрес Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		КлассыСтроки = Новый Массив;
		Если ДетализированныйВид И Не ФлагиВидимости.ЕстьВидимыеПоУмолчанию Тогда
			КлассыСтроки.Добавить("hide_by_default");
			Если ФлагиВидимости.ЕстьСовпавшие Тогда
				КлассыСтроки.Добавить("has_matched");
			КонецЕсли;
			Если ФлагиВидимости.ЕстьАдрес Тогда
				КлассыСтроки.Добавить("has_address");
			КонецЕсли;
		КонецЕсли;
		
		АтрибутКлассаСтроки = ?(КлассыСтроки.Количество() > 0, " class=""" + СтрСоединить(КлассыСтроки, " ") + """", "");
		МассивОтчетаHTML.Добавить("<tr" + АтрибутКлассаСтроки + ">");
		МассивОтчетаHTML.Добавить("<td class=""col-flag"">" + ВариантРасхождения + "</td>");

		Для Каждого Поле Из КлючевыеПоля Цикл
			Если Поле = "ТипЛица" Тогда
				МассивОтчетаHTML.Добавить("<td class=""col-type"">" + СтрокаРасхождения[Поле] + "</td>");
			Иначе
				МассивОтчетаHTML.Добавить("<td class=""col-name"">" + СтрокаРасхождения[Поле] + "</td>");
			КонецЕсли;
		КонецЦикла;

		Если ДетализированныйВид Тогда
			МассивОтчетаHTML.Добавить(ФрагментДеталей);
		Иначе
			КолСравниваемыхПолейВЯчейке = 5;
			Для НомПоля = 1 По СравниваемыеПоля.Количество() Цикл
				Если (НомПоля - 1) % КолСравниваемыхПолейВЯчейке = 0 Тогда
					МассивОтчетаHTML.Добавить("<td>");
				Иначе
					МассивОтчетаHTML.Добавить("<br>");
				КонецЕсли;

				Поле = СравниваемыеПоля[НомПоля - 1];

				Если СтрокаРасхождения.ВариантРасхождения = НетРасхождений Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = НоваяЗапись Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Нов_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьУдалена Тогда
					МассивОтчетаHTML.Добавить(Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]");
				ИначеЕсли СтрокаРасхождения.ВариантРасхождения = ЗаписьИзменена Тогда
					Если СтрокаРасхождения["_Тек_" + Поле] = СтрокаРасхождения["_Нов_" + Поле] Тогда
						КлассыПоля = "eq_values matched_field";
						Если Поле = "Адрес" Тогда
							КлассыПоля = КлассыПоля + " address_field";
						КонецЕсли;
						МассивОтчетаHTML.Добавить("<div class=""" + КлассыПоля + """>" + Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "]</div>");
					Иначе
						КлассыПоля = "nq_values";
						Если Поле = "Адрес" Тогда
							КлассыПоля = КлассыПоля + " address_field";
						КонецЕсли;
						МассивОтчетаHTML.Добавить("<div class=""" + КлассыПоля + """>" + Поле + ": [" + СтрокаРасхождения["_Тек_" + Поле] + "] -> ["
							+ СтрокаРасхождения["_Нов_" + Поле] + "]</div>");
					КонецЕсли;
				КонецЕсли;

				Если НомПоля % КолСравниваемыхПолейВЯчейке = 0 Тогда
					МассивОтчетаHTML.Добавить("</td>");
				КонецЕсли;
			КонецЦикла;

			Если (СравниваемыеПоля.Количество() - 1) % КолСравниваемыхПолейВЯчейке > 0 Тогда
				МассивОтчетаHTML.Добавить("</td>");
			КонецЕсли;
		КонецЕсли;

		МассивОтчетаHTML.Добавить("</tr>");
	КонецЦикла;

	МассивОтчетаHTML.Добавить("</table>");

	Возврат СтрСоединить(МассивОтчетаHTML, "");

КонецФункции

Функция ПолучитьДетализированноеПредставлениеHTML(СтрокаРасхождения, СравниваемыеПоля, ВариантРасхождения, НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена, ФлагиВидимости)
    
    МассивФрагмента = Новый Массив;
    МассивФрагмента.Добавить("<td><ul class=""rec_list"">");
    
    Для Каждого Поле Из СравниваемыеПоля Цикл
        
        ТекЗнач = Строка(СтрокаРасхождения["_Тек_" + Поле]);
        НовЗнач = Строка(СтрокаРасхождения["_Нов_" + Поле]);
        
        Если (ТекЗнач = "" И НовЗнач = "") И ВариантРасхождения <> НоваяЗапись И ВариантРасхождения <> ЗаписьУдалена Тогда
            Продолжить;
        КонецЕсли;
        
        НазваниеПоля = Поле;
        Если НазваниеПоля = "РасчетныйСчет" Тогда НазваниеПоля = "Расчетный счет"; КонецЕсли;
        Если НазваниеПоля = "ДатаГосРегистрации" Тогда НазваниеПоля = "Дата регистрации/выдачи"; КонецЕсли;
        Если НазваниеПоля = "ОрганГосРегистрации" Тогда НазваниеПоля = "Орган регистрации/выдачи"; КонецЕсли;
        
        ЗначенияСовпадают = (ВариантРасхождения = ЗаписьИзменена И ТекЗнач = НовЗнач);
        ЭтоАдрес = (Поле = "Адрес");
        
        КлассыЭлемента = Новый Массив;
        Если ЭтоАдрес Тогда
        	КлассыЭлемента.Добавить("address_field");
        	ФлагиВидимости.ЕстьАдрес = Истина;
        КонецЕсли;
        Если ЗначенияСовпадают Тогда
        	КлассыЭлемента.Добавить("matched_field");
        	ФлагиВидимости.ЕстьСовпавшие = Истина;
        КонецЕсли;
        
        Если Не ЭтоАдрес И Не ЗначенияСовпадают Тогда
        	ФлагиВидимости.ЕстьВидимыеПоУмолчанию = Истина;
        ИначеЕсли (ВариантРасхождения = НоваяЗапись Или ВариантРасхождения = ЗаписьУдалена) И Не ЭтоАдрес Тогда
        	ФлагиВидимости.ЕстьВидимыеПоУмолчанию = Истина;
        КонецЕсли;
        
        АтрибутКласса = ?(КлассыЭлемента.Количество() > 0, " class=""" + СтрСоединить(КлассыЭлемента, " ") + """", "");
        
        Элемент = "";
        Если ВариантРасхождения = НоваяЗапись Тогда      
            Элемент = "<li" + АтрибутКласса + "><span class=""rec_label"">" + НазваниеПоля + ":</span> " + НовЗнач + "</li>";
        ИначеЕсли ВариантРасхождения = ЗаписьУдалена Тогда 
            Элемент = "<li" + АтрибутКласса + "><span class=""rec_label"">" + НазваниеПоля + ":</span> " + ТекЗнач + "</li>";
        ИначеЕсли ВариантРасхождения = ЗаписьИзменена Тогда 
            Если ЗначенияСовпадают Тогда
                Элемент = "<li" + АтрибутКласса + "><span class=""rec_label"">" + НазваниеПоля + ":</span> <span class=""eq_values"">" + ТекЗнач + "</span></li>";
            Иначе
                Элемент = "<li" + АтрибутКласса + "><span class=""rec_label"">" + НазваниеПоля + "</span><ul class=""sub_list"">"
                    + "<li><span class=""arrow-right"">УК</span> " + ТекЗнач + "</li>"
                    + "<li><span class=""arrow-left"">СР</span> " + НовЗнач + "</li></ul></li>";
            КонецЕсли;
        КонецЕсли;
        
        Если ЗначениеЗаполнено(Элемент) Тогда
            МассивФрагмента.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;
    
    МассивФрагмента.Добавить("</ul></td>");
    
    Возврат СтрСоединить(МассивФрагмента, "");
    
КонецФункции

Процедура ПодготовитьДетализированноеПредставление(МассивОтчетаHTML, СтрокаРасхождения, СравниваемыеПоля, ВариантРасхождения, НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена)
	
	ФлагиВидимости = Новый Структура("ЕстьВидимыеПоУмолчанию, ЕстьСовпавшие, ЕстьАдрес", Ложь, Ложь, Ложь);
	МассивОтчетаHTML.Добавить(ПолучитьДетализированноеПредставлениеHTML(
		СтрокаРасхождения, СравниваемыеПоля, ВариантРасхождения,
		НетРасхождений, НоваяЗапись, ЗаписьУдалена, ЗаписьИзменена, ФлагиВидимости));
	
КонецПроцедуры
