	СравниваемыеПоляОтчета.Добавить("ОрганГосРегистрации");

	Возврат Новый Структура("МаппингРеквизитВИмяПоля, СравниваемыеПоляОтчета", МаппингРеквизитВИмяПоля, СравниваемыеПоляОтчета);
	
КонецФункции

Функция ПолучитьУникальныеЛицаСВариантомРасхождения(Расхождения)
	
	ТипыВариантов = ТипыВариантовРасхожденийПоУмолчанию();
	УникальныеПары = Новый Соответствие;
	
	Для Каждого СтрокаРасх Из Расхождения Цикл
		
		КлючПара = КлючЛицаОтчета(СтрокаРасх.ТипЛица, СтрокаРасх.Идентификатор, СтрокаРасх.Personal_Account_Number);
		Если УникальныеПары.Получить(КлючПара) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Вариант = 0;
		Если СтрокаРасх.ВидРасхождения = "Лицо из файла реестра не найдено в 1С" Тогда
			Вариант = ТипыВариантов.НоваяЗапись;
		ИначеЕсли СтрокаРасх.ВидРасхождения = "Лицо из 1С отсутствует в файле реестра" Тогда
			Вариант = ТипыВариантов.ЗаписьУдалена;
		ИначеЕсли СтрокаРасх.ВидРасхождения = "Не совпадает" Тогда
			Вариант = ТипыВариантов.ЗаписьИзменена;
		КонецЕсли;
		
		УникальныеПары.Вставить(КлючПара, Новый Структура(
			"ТипЛица, Идентификатор, Personal_Account_Number, ВариантРасхождения",
			СтрокаРасх.ТипЛица, СтрокаРасх.Идентификатор, СтрокаРасх.Personal_Account_Number, Вариант));
		
	КонецЦикла;
	
	Возврат УникальныеПары;

КонецФункции

Функция ПолучитьПаспортИзСтрокиДанных(СтрокаДанных)
