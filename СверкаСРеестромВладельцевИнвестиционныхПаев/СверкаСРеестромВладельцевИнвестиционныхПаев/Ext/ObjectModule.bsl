	МаппингРеквизитВИмяПоля.Вставить("ИНН", "ИНН");
	МаппингРеквизитВИмяПоля.Вставить("ОГРН", "ОГРН");
	МаппингРеквизитВИмяПоля.Вставить("Адрес", "Адрес");
	МаппингРеквизитВИмяПоля.Вставить("Расчетный счет", "РасчетныйСчет");
	МаппингРеквизитВИмяПоля.Вставить("Дата гос. регистрации / выдачи документа", "ДатаГосРегистрации");
	МаппингРеквизитВИмяПоля.Вставить("Орган, осуществивший регистрацию / выдавший документ", "ОрганГосРегистрации");
	СравниваемыеПоляОтчета = Новый Массив;
	СравниваемыеПоляОтчета.Добавить("Паспорт");
    СравниваемыеПоляОтчета.Добавить("ДатаРождения");
	СравниваемыеПоляОтчета.Добавить("Наименование");
	СравниваемыеПоляОтчета.Добавить("ИНН");
	СравниваемыеПоляОтчета.Добавить("ОГРН");
	СравниваемыеПоляОтчета.Добавить("Адрес");
	СравниваемыеПоляОтчета.Добавить("РасчетныйСчет");
	СравниваемыеПоляОтчета.Добавить("ДатаГосРегистрации");
	СравниваемыеПоляОтчета.Добавить("ОрганГосРегистрации");

	Возврат Новый Структура("МаппингРеквизитВИмяПоля, СравниваемыеПоляОтчета", МаппингРеквизитВИмяПоля, СравниваемыеПоляОтчета);
	
КонецФункции

Функция ПолучитьУникальныеЛицаСВариантомРасхождения(Расхождения)
	
	НоваяЗапись = 1; 
	ЗаписьУдалена = 2;
	ЗаписьИзменена = 3;
	УникальныеПары = Новый Соответствие;
	
	Для Каждого СтрокаРасх Из Расхождения Цикл
		
		КлючПара = СтрокаРасх.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(СтрокаРасх.Идентификатор);
		Если УникальныеПары.Получить(КлючПара) = Неопределено Тогда
			Вариант = 0;
			Если СтрокаРасх.ВидРасхождения = "Лицо из файла реестра не найдено в 1С" Тогда 
				Вариант = НоваяЗапись;
			ИначеЕсли СтрокаРасх.ВидРасхождения = "Лицо из 1С отсутствует в файле реестра" Тогда 
				Вариант = ЗаписьУдалена;
			ИначеЕсли СтрокаРасх.ВидРасхождения = "Не совпадает" Тогда 
				Вариант = ЗаписьИзменена;
			КонецЕсли;
			УникальныеПары.Вставить(
				КлючПара, 
				Новый Структура(
					"ТипЛица, Идентификатор, ВариантРасхождения", 
					СтрокаРасх.ТипЛица, СтрокаРасх.Идентификатор, Вариант));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат УникальныеПары;

КонецФункции

Функция ПолучитьПаспортИзСтрокиДанных(СтрокаДанных)
	Если СтрокаДанных = Неопределено Тогда 
		Возврат ""; 
	КонецЕсли;
	Возврат СокрЛП(Строка(СтрокаДанных.СерияПаспорта) + " " + Строка(СтрокаДанных.НомерПаспорта));
