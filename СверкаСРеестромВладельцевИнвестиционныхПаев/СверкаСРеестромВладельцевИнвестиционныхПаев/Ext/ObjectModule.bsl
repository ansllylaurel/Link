#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"ТЕСТ Сверка с реестром владельцев инвестиционных паев",
		"0.69",
		"ТЕСТ Сверка данных пайщиков ПИФ (Регламентное задание)",
		Истина);

	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
	ТаблицаКоманд = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Выполнить сверку по расписанию";
	НоваяКоманда.Идентификатор = "СверкаПоРасписанию";
	НоваяКоманда.Использование = "ВызовСерверногоМетода";
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	РегистрационныеДанные.Вставить("Команды", ТаблицаКоманд);

	Возврат РегистрационныеДанные;

КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды <> "СверкаПоРасписанию" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнитьКоманду");
	
	Настройки = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(
		ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка,
		"СверкаПоРасписанию");
	Если Настройки = Неопределено Тогда
		ЛогироватьСообщение("Ошибка: настройки команды не найдены", УровеньЖурналаРегистрации.Предупреждение, "ВыполнитьКоманду", ПараметрыСессии);
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("Организация") Тогда 
		Организация = Настройки.Организация;
	КонецЕсли;
	Если Настройки.Свойство("ПутьКПапке") Тогда 
		ПутьКПапке = Настройки.ПутьКПапке;
	КонецЕсли;
	
	Если Настройки.Свойство("СохранятьДанныеРеестраВExternals") Тогда
		СохранятьДанныеРеестраВExternals = Настройки.СохранятьДанныеРеестраВExternals;
	КонецЕсли;

	ВыполнитьСверкуИзКаталога(ПараметрыСессии);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура ВыполнитьСверкуИзКаталога(ПараметрыСессии = Неопределено) Экспорт
	
	СессияСозданаВПроцедуре = (ПараметрыСессии = Неопределено);
	Если СессияСозданаВПроцедуре Тогда
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("ВыполнитьСверкуИзКаталога");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Или ПустаяСтрока(ПутьКПапке) Тогда
		ЛогироватьСообщение("Сверка пропущена: Не заполнены Организация или Путь", УровеньЖурналаРегистрации.Предупреждение, "ВыполнитьСверкуИзКаталога", ПараметрыСессии);
		Если СессияСозданаВПроцедуре Тогда
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПутьНорм = ПутьКПапке;
	Если Не СтрЗаканчиваетсяНа(ПутьНорм, "\") И Не СтрЗаканчиваетсяНа(ПутьНорм, "/") Тогда
		ПутьНорм = ПутьНорм + "\";
	КонецЕсли;
	КаталогНаДиске = Новый Файл(ПутьНорм);
	Если Не КаталогНаДиске.Существует() Или Не КаталогНаДиске.ЭтоКаталог() Тогда
		ЛогироватьСообщение("Критическая ошибка: Каталог не существует: " + ПутьНорм, УровеньЖурналаРегистрации.Предупреждение, "ВыполнитьСверкуИзКаталога", ПараметрыСессии);
		Если СессияСозданаВПроцедуре Тогда
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Файлы = НайтиФайлы(ПутьНорм, "*.xlsx", Ложь);
	
	Если Файлы.Количество() = 0 Тогда
		ЛогироватьСообщение("Файлы XLSX не найдены в папке: " + ПутьНорм, УровеньЖурналаРегистрации.Предупреждение, "ВыполнитьСверкуИзКаталога", ПараметрыСессии);
		Если СессияСозданаВПроцедуре Тогда
			ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Для Каждого ФайлРеестра Из Файлы Цикл
		Попытка
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлРеестра.ПолноеИмя);
			ВыполняетсяИнтерактивно = Ложь;
			Результат = СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ФайлРеестра.ПолноеИмя, СохранятьДанныеРеестраВExternals, Ложь, ПараметрыСессии);
			Если Результат.Успех Тогда
				ЛогироватьСообщение("Успешно обработан: " + ФайлРеестра.Имя, УровеньЖурналаРегистрации.Информация, "ВыполнитьСверкуИзКаталога", ПараметрыСессии);
			ИначеЕсли ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
				ЛогироватьСообщение("Файл " + ФайлРеестра.Имя + ": " + Результат.ТекстОшибки, УровеньЖурналаРегистрации.Предупреждение, "ВыполнитьСверкуИзКаталога");
			КонецЕсли;
		Исключение
			ЛогироватьСообщение("Ошибка файла " + ФайлРеестра.Имя + ": " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка, "ВыполнитьСверкуИзКаталога", ПараметрыСессии);
		КонецПопытки;
	КонецЦикла;
	
	Если СессияСозданаВПроцедуре Тогда
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла, СохранятьВExternals = Ложь, ОтчетВыполняетсяИнтерактивно = Ложь, ПараметрыСессии = Неопределено) Экспорт
	
	ВыполняетсяИнтерактивно = ОтчетВыполняетсяИнтерактивно;
	Результат = Новый Структура("Успех, ТекстОтчета, ТекстОшибки", Ложь, "", "");
	
	СессияСозданаВФункции = (ПараметрыСессии = Неопределено);
	Если СессияСозданаВФункции Тогда
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("СформироватьОтчет");
	КонецЕсли;
	
	Попытка
		ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
		ДвоичныеДанныеФайла.Записать(ВременныйФайл);
		ТаблицаФайла = Новый ТабличныйДокумент;
		ТаблицаФайла.Прочитать(ВременныйФайл, СпособЧтенияЗначенийТабличногоДокумента.Текст, ТипФайлаТабличногоДокумента.XLSX);
		УдалитьФайлы(ВременныйФайл);
		
		ДанныеИзФайла = ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла, ПолноеИмяФайла);
		
		Если ТипЗнч(ДанныеИзФайла) = Тип("Строка") Тогда 
			Результат.ТекстОшибки = ДанныеИзФайла;
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, Результат.ТекстОшибки);
			Если СессияСозданаВФункции Тогда
				ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		
		Если Не ПИФПринадлежитОрганизации(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра) Тогда
			Результат.ТекстОшибки = СтрШаблон("ПИФ ""%1"" не принадлежит выбранной организации", ДанныеИзФайла.ПИФ);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, Результат.ТекстОшибки);
			Если СессияСозданаВФункции Тогда
				ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		
		Данные1С = ПолучитьДанныеПайщиковИз1С(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра);
		Расхождения = СформироватьТаблицуРасхождений(ДанныеИзФайла.Таблица, Данные1С);
		
		Результат.ТекстОтчета = ПолучитьHTMLОтчетаОРасхождениях(
			Расхождения, 
			Организация, 
			ДанныеИзФайла.ПИФ, 
			ДанныеИзФайла.ДатаРеестра, 
			ДанныеИзФайла.Таблица, 
			Данные1С,
			ПолноеИмяФайла);
			
		Результат.Успех = Истина;
		
		Если СохранятьВExternals Тогда
			СохранитьФайлИРеестрВExternals(
				ДвоичныеДанныеФайла,
				ПолноеИмяФайла,
				Организация,
				ДанныеИзФайла.Таблица,
				ДанныеИзФайла.ДатаРеестра,
				ДанныеИзФайла.ПИФ,
				ДанныеИзФайла.ПолноеНаименованиеПИФ,
				ПараметрыСессии);
		КонецЕсли;
		
		ЗафиксироватьРезультатСверкиВЖурнале(Организация, СчетДоверительногоУправления, ДанныеИзФайла.ДатаРеестра, ДанныеИзФайла.ПИФ, Расхождения);
		
		РеквизитыОповещения = Новый Структура(
			"Тема, Текст", 
			СтрШаблон("Сверка ПИФ %1 (%2)", 
				ДанныеИзФайла.ПИФ, 
				Формат(ДанныеИзФайла.ДатаРеестра, 
			"ДФ=dd.MM.yyyy")), Результат.ТекстОтчета);
			
		Справочники.Оповещения.СформироватьОповещения("Обработка._СверкаСРеестромВладельцевИнвестиционныхПаев", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЛогироватьСообщение(Результат.ТекстОшибки, УровеньЖурналаРегистрации.Ошибка, "СформироватьОтчет");
	КонецПопытки;
	
	Если СессияСозданаВФункции Тогда
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла, ПолноеИмяФайла)
	
	ОшибкаФормат = ПроверитьРазмерИЗаголовкиРеестра(ТаблицаФайла);
	Если ОшибкаФормат <> "" Тогда 
		Возврат ОшибкаФормат;
	КонецЕсли;
	
	ДанныеДатаПИФ = ПолучитьДатуИНаименованиеПИФИзРеестра(ТаблицаФайла, ПолноеИмяФайла);
	Если ДанныеДатаПИФ.Ошибка <> "" Тогда 
		Возврат ДанныеДатаПИФ.Ошибка; 
	КонецЕсли;
	
	НайденныйПИФ = НайтиПИФПоНаименованию(ДанныеДатаПИФ.НаименованиеПИФ, ДанныеДатаПИФ.ДатаРеестра);
	Если НайденныйПИФ = Неопределено Тогда 
		Возврат СтрШаблон("ПИФ не найден. Значение из файла: ""%1""", ДанныеДатаПИФ.НаименованиеПИФ); 
	КонецЕсли;
	ПИФ = НайденныйПИФ.ПИФ;
	СчетДоверительногоУправления = НайденныйПИФ.СчетДУ;
	
	Если Не ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		Возврат СтрШаблон("Счет ДУ не найден. Значение из файла: ""%1""", ДанныеДатаПИФ.НаименованиеПИФ);
	КонецЕсли;
	
	ДанныеИзЭкселя = СоздатьТаблицуПайщиковИзДокументаРеестра(ТаблицаФайла, ТаблицаФайла.ВысотаТаблицы);
	
	Если ДанныеИзЭкселя.Количество() = 0 Тогда 
		Возврат "В файле не найдены данные пайщиков"; 
	КонецЕсли;
	
	Возврат Новый Структура("Таблица, ДатаРеестра, ПИФ, ПолноеНаименованиеПИФ",
		ДанныеИзЭкселя, ДанныеДатаПИФ.ДатаРеестра, ПИФ, ДанныеДатаПИФ.НаименованиеПИФ);

КонецФункции

#КонецОбласти

#Область ПарсингФайла

Функция ПроверитьРазмерИЗаголовкиРеестра(ТаблицаФайла)
	
	Высота = ТаблицаФайла.ВысотаТаблицы;
	Ширина = ТаблицаФайла.ШиринаТаблицы;
	Если Высота = 0 Или Ширина = 0 Тогда 
		Возврат "В файле нет данных";
	КонецЕсли;
	
	МинСтрок = 13;
	МинКолонок = 13; 
	
	Если Высота < МинСтрок Или Ширина < МинКолонок Тогда 
		Возврат СтрШаблон("Файл не соответствует формату реестра: ожидается не менее %1 строк и %2 колонок", МинСтрок, МинКолонок);
	КонецЕсли;
	
	ТекстСтр7 = СокрЛП(ТаблицаФайла.Область(7, 1, 7, 1).Текст);
	ОжидаемыйТекст = "Информация из реестра владельцев инвестиционных паев";
	Если ТекстСтр7 <> ОжидаемыйТекст Тогда 
		Возврат СтрШаблон("Файл не соответствует формату реестра: в 7-й строке ожидается текст ""%1"", а найдено ""%2""", ОжидаемыйТекст, ТекстСтр7);
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция ПолучитьДатуИНаименованиеПИФИзРеестра(ТаблицаФайла, ПолноеИмяФайла)
	
	Результат = Новый Структура("ДатаРеестра, НаименованиеПИФ, Ошибка", Неопределено, "", "");
	
	// Читаем дату из названия файла
	Результат.ДатаРеестра = ИзвлечьДатуИзИмениФайла(ПолноеИмяФайла);
	
	Если Не ЗначениеЗаполнено(Результат.ДатаРеестра) Тогда 
		Результат.Ошибка = "Не удалось определить дату сверки из имени файла. Ожидается формат '..._ДДММГГ' в конце названия файла"; 
		Возврат Результат; 
	КонецЕсли;
	
	НайденноеНаименование = "";
	
	// Ограничиваем поиск первыми 11 строками
	ГраницаПоиска = Мин(ТаблицаФайла.ВысотаТаблицы, 11);
	
	Для ИндексСтроки = 1 По ГраницаПоиска Цикл
		
		ТекстСтроки = СокрЛП(ТаблицаФайла.Область(ИндексСтроки, 1, ИндексСтроки, 1).Текст);
		ТекстВНижнемРегистре = НРег(ТекстСтроки);
		
		// Ищем фразу
		Если СтрНайти(ТекстВНижнемРегистре, "наименование фонда:") > 0 Тогда
			
			ПозДвоеточия = СтрНайти(ТекстСтроки, ":");
			Если ПозДвоеточия > 0 Тогда
				НайденноеНаименование = СокрЛП(Сред(ТекстСтроки, ПозДвоеточия + 1));
			КонецЕсли;
			
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.НаименованиеПИФ = НайденноеНаименование;
	
	Если Не ЗначениеЗаполнено(Результат.НаименованиеПИФ) Тогда 
		Результат.Ошибка = "Не найдено название фонда в шапке документа (поиск по фразе ""наименование фонда:"")"; 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьТаблицуПайщиковИзДокументаРеестра(ТаблицаФайла, Высота)
	
	ПерваяСтрокаДанных = 12; 
	КолонкаЛС = 2; 
	КолонкаФИО = 3;
	КолонкаДР = 4;
	КолонкаРегистрации = 5;
	КолонкаАдрес = 6; 
	КолонкаБанковскиеРеквизиты = 8;
	КолонкаКоличество = 9; 
	КолонкаДоля = 10;
	
	ДанныеИзЭкселя = Новый ТаблицаЗначений;
	ДанныеИзЭкселя.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	ДанныеИзЭкселя.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	ДанныеИзЭкселя.Колонки.Добавить("ДатаРождения", Новый ОписаниеТипов("Дата",, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ДанныеИзЭкселя.Колонки.Добавить("СерияПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ДанныеИзЭкселя.Колонки.Добавить("НомерПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	ДанныеИзЭкселя.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	ДанныеИзЭкселя.Колонки.Добавить("ОГРН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	ДанныеИзЭкселя.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ДанныеИзЭкселя.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДанныеИзЭкселя.Колонки.Добавить("ДатаГосРегистрации", Новый ОписаниеТипов("Дата"));
	ДанныеИзЭкселя.Колонки.Добавить("ОрганГосРегистрации", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
	ДанныеИзЭкселя.Колонки.Добавить("ВидДокумента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200)));
	
	ДанныеИзЭкселя.Колонки.Добавить("Personal_Account_Number", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДанныеИзЭкселя.Колонки.Добавить("Is_Nominee", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ДанныеИзЭкселя.Колонки.Добавить("Number_Of_Units", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 5)));
	ДанныеИзЭкселя.Колонки.Добавить("Size_Of_Share", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 5)));
	
	Для НомерСтроки = ПерваяСтрокаДанных По Высота Цикл
		
		Если СокрЛП(ТаблицаФайла.Область(НомерСтроки, 1, НомерСтроки, 1).Текст) = "№ п/п" Тогда
			Продолжить;
		КОнецЕсли;
		
		Лицо = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаФИО, НомерСтроки, КолонкаФИО).Текст);
		Если Не ЗначениеЗаполнено(Лицо) Тогда 
			Продолжить;
		КонецЕсли;

		ПозРаскрыто = СтрНайти(ВРег(Лицо), "(РАСКРЫТО");
		Если ПозРаскрыто > 0 Тогда
			Лицо = СокрЛП(Лев(Лицо, ПозРаскрыто - 1));
		КонецЕсли;

		НоваяСтрока = ДанныеИзЭкселя.Добавить();
		НоваяСтрока.Идентификатор = Лицо;
		
		ТекстКол2 = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаЛС, НомерСтроки, КолонкаЛС).Текст);
		
		ЧастиЛС = СтрРазделить(ТекстКол2, " ", Ложь);
		НайденныйЛС = "";
		Для Каждого ЧастьЛС Из ЧастиЛС Цикл
			ТолькоЦифры = ОставитьТолькоЦифрыВСтроке(ЧастьЛС);
			Если СтрДлина(ТолькоЦифры) = 12 Тогда
				НайденныйЛС = ТолькоЦифры;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(НайденныйЛС) Тогда
			НоваяСтрока.Personal_Account_Number = НайденныйЛС;
		Иначе
			НоваяСтрока.Personal_Account_Number = ОставитьТолькоЦифрыВСтроке(ТекстКол2);
		КонецЕсли;
		
		Если СтрНайти(ВРег(ТекстКол2), "РАСКРЫТО") > 0 Тогда
			НоваяСтрока.Is_Nominee = 0;
		ИначеЕсли СтрНайти(ВРег(ТекстКол2), "НОМИНАЛЬНЫЙ") > 0 Тогда
			НоваяСтрока.Is_Nominee = 1; 
		Иначе
			НоваяСтрока.Is_Nominee = 0; 
		КонецЕсли;

		ТекстКолКол = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаКоличество, НомерСтроки, КолонкаКоличество).Текст);
		НоваяСтрока.Number_Of_Units = ПреобразоватьСтрокуВЧисло(ТекстКолКол);
		
		ТекстКолДоля = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаДоля, НомерСтроки, КолонкаДоля).Текст);
		НоваяСтрока.Size_Of_Share = ПреобразоватьСтрокуВЧисло(ТекстКолДоля);
		
		ТекстРегистрации = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаРегистрации, НомерСтроки, КолонкаРегистрации).Текст);
		ПризнакЮЛ = (СтрНайти(ВРег(ТекстРегистрации), "ОГРН") > 0);
		
		Если Не ПризнакЮЛ Тогда
            ТекстДР = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаДР, НомерСтроки, КолонкаДР).Текст);
			НоваяСтрока.ДатаРождения = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ТекстДР, "", Ложь);
        Иначе
        	НоваяСтрока.ДатаРождения = '00010101';
		КонецЕсли;

		Если ПризнакЮЛ Тогда 
			ЗаполнитьСтрокуДанныхЮЛ(НоваяСтрока, ТекстРегистрации);
		Иначе 
			ЗаполнитьСтрокуДанныхФЛ(НоваяСтрока, ТекстРегистрации); 
		КонецЕсли;

		АдресТекст = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаАдрес, НомерСтроки, КолонкаАдрес).Текст);
		АдресТекст = СтрЗаменить(АдресТекст, "_x000D_", " ");
		АдресТекст = СтрЗаменить(АдресТекст, Символы.ВК, " ");
		АдресТекст = СтрЗаменить(АдресТекст, Символы.ПС, " ");
		Пока СтрНайти(АдресТекст, "  ") > 0 Цикл
			АдресТекст = СтрЗаменить(АдресТекст, "  ", " ");
		КонецЦикла;
		НоваяСтрока.Адрес = СокрЛП(АдресТекст);
		ТекстБанк = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаБанковскиеРеквизиты, НомерСтроки, КолонкаБанковскиеРеквизиты).Текст);
		НоваяСтрока.РасчетныйСчет = ИзвлечьНомерРасчетногоСчета(ТекстБанк);
		
	КонецЦикла;
	
	Возврат ДанныеИзЭкселя;
КонецФункции

Функция ПреобразоватьСтрокуВЧисло(Знач СтрокаЧисло)
	
	СтрокаЧисло = СтрЗаменить(СтрокаЧисло, "%", "");
	СтрокаЧисло = СтрЗаменить(СтрокаЧисло, " ", "");
	СтрокаЧисло = СтрЗаменить(СтрокаЧисло, Символы.НПП, ""); 
	
	Попытка
		Возврат Число(СтрокаЧисло);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ОставитьТолькоЦифрыВСтроке(Знач СтрокаСимволов) 
	Результат = "";
	Для Индекс = 1 По СтрДлина(СтрокаСимволов) Цикл
		Символ = Сред(СтрокаСимволов, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьСтрокуДанныхЮЛ(НоваяСтрока, ТекстРегистрации)
	
	НоваяСтрока.ТипЛица = "ЮЛ";
	НоваяСтрока.СерияПаспорта = "";
	НоваяСтрока.НомерПаспорта = "";
	НоваяСтрока.ВидДокумента = "";
	
	ДанныеРегЮЛ = ИзвлечьРеквизитыРегистрацииЮЛ(ТекстРегистрации);
	
	НоваяСтрока.ИНН = ДанныеРегЮЛ.ИНН; 
	НоваяСтрока.ОГРН = ДанныеРегЮЛ.ОГРН;
	НоваяСтрока.ДатаГосРегистрации = ДанныеРегЮЛ.ДатаРегистрации; 
	НоваяСтрока.ОрганГосРегистрации = ДанныеРегЮЛ.ОрганРегистрации;

КонецПроцедуры

Процедура ЗаполнитьСтрокуДанныхФЛ(НоваяСтрока, ТекстРегистрации)
    
    НоваяСтрока.ТипЛица = "ФЛ";
	НоваяСтрока.ВидДокумента = ИзвлечьВидДокументаИзСтрокиРегистрации(ТекстРегистрации);
	РезультатПаспорт = ИзвлечьСерияИНомерПаспорта(ТекстРегистрации);
    НоваяСтрока.СерияПаспорта = РезультатПаспорт.Серия; 
    НоваяСтрока.НомерПаспорта = РезультатПаспорт.Номер;
    
    ДанныеИНН = ИзвлечьИННИОГРНИзСтрокиРегистрации(ТекстРегистрации);
    НоваяСтрока.ИНН = ДанныеИНН.ИНН; 
    НоваяСтрока.ОГРН = "";
	ДанныеРегФЛ = ИзвлечьРеквизитыРегистрацииФЛ(ТекстРегистрации);
    НоваяСтрока.ДатаГосРегистрации = ДанныеРегФЛ.ДатаВыдачи; 
    НоваяСтрока.ОрганГосРегистрации = ДанныеРегФЛ.ОрганВыдавший;

КонецПроцедуры

Функция ИзвлечьВидДокументаИзСтрокиРегистрации(ТекстРегистрации)
	
	Если Не ЗначениеЗаполнено(ТекстРегистрации) Тогда
		Возврат "Паспорт гражданина РФ";
	КонецЕсли;
	
	ПозЗапятой = СтрНайти(ТекстРегистрации, ",");
	Если ПозЗапятой > 0 Тогда
		ВидДокумента = СокрЛП(Лев(ТекстРегистрации, ПозЗапятой - 1));
	Иначе
		ВидДокумента = СокрЛП(ТекстРегистрации);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		Возврат "Паспорт гражданина РФ";
	КонецЕсли;
	
	Возврат ВидДокумента;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеФункцииПарсинга

Функция ИзвлечьДатуИзИмениФайла(ПолноеИмяФайла)
	
	Файл = Новый Файл(ПолноеИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	
	// Разбиваем имя файла по разделителю "_"
	Части = СтрРазделить(ИмяБезРасширения, "_");
	
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Части[Части.ВГраница()]);
	
	Попытка
		// Разбиваем строку DDMMYY
		Если СтрДлина(СтрокаДаты) = 6 Тогда
			День  = Число(Лев(СтрокаДаты, 2));
			Месяц = Число(Сред(СтрокаДаты, 3, 2));
			Год   = Число("20" + Прав(СтрокаДаты, 2));
			
			Если День = 0 Или Месяц = 0 Или Месяц > 12 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Возврат Дата(Год, Месяц, День);
		ИначеЕсли СтрДлина(СтрокаДаты) = 8 Тогда
			День  = Число(Лев(СтрокаДаты, 2));
			Месяц = Число(Сред(СтрокаДаты, 3, 2));
			Год   = Число(Прав(СтрокаДаты, 4));
			
			Если День = 0 Или Месяц = 0 Или Месяц > 12 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Возврат Дата(Год, Месяц, День);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		// Если внутри оказались буквы - вернем Неопределено
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ИзвлечьДатуИзСтрокиРеестра(ТекстСтроки)
	
	Если Не ЗначениеЗаполнено(ТекстСтроки) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	Позиция = 1;
	ДлинаСтроки = СтрДлина(ТекстСтроки);
	
	Пока Позиция <= ДлинаСтроки - 9 Цикл
		ПотенциальнаяДата = Сред(ТекстСтроки, Позиция, 10);
		Если Сред(ПотенциальнаяДата, 3, 1) = "." И Сред(ПотенциальнаяДата, 6, 1) = "." И РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(Лев(ПотенциальнаяДата, 2), Истина, Ложь) Тогда
			ВремяСтрока = "";
			Остаток = СокрЛ(Сред(ТекстСтроки, Позиция + 10));
			Если ЗначениеЗаполнено(Остаток) Тогда
				Если СтрДлина(Остаток) >= 8 И Сред(Остаток, 3, 1) = ":" И Сред(Остаток, 6, 1) = ":" Тогда 
					ВремяСтрока = Лев(Остаток, 8);
				ИначеЕсли СтрДлина(Остаток) >= 5 И Сред(Остаток, 3, 1) = ":" Тогда 
					ВремяСтрока = Лев(Остаток, 5) + ":00"; 
				КонецЕсли;
			КонецЕсли;
			Возврат РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ПотенциальнаяДата, ВремяСтрока, Истина);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция ИзвлечьСерияИНомерПаспорта(ТекстПаспорта)
	
	Результат = Новый Структура("Серия, Номер", "", "");
	Если Не ЗначениеЗаполнено(ТекстПаспорта) Тогда 
		Возврат Результат; 
	КонецЕсли;
	Части = СтрРазделить(ТекстПаспорта, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть, " ");
		Если Цифры = "0" Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если ПустаяСтрока(Результат.Серия) И СтрДлина(Цифры) = 4 Тогда 
			Результат.Серия = Цифры;
		ИначеЕсли ПустаяСтрока(Результат.Номер) И СтрДлина(Цифры) = 6 Тогда 
			Результат.Номер = Цифры;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ИзвлечьНомерРасчетногоСчета(ТекстБанковскихРеквизитов)

    Если Не ЗначениеЗаполнено(ТекстБанковскихРеквизитов) Тогда
        Возврат "";
	КонецЕсли;

    Части = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстБанковскихРеквизитов, " ", Истина, Истина);

    Для Каждого Часть Из Части Цикл
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть);
		Если Цифры = "0" Тогда
            Продолжить;
        КонецЕсли;
		Если СтрДлина(Цифры) = 20 Тогда
            Возврат Цифры;
		КонецЕсли;
    КонецЦикла;
	Возврат "";

КонецФункции

Функция ОставитьТолькоЦифрыИПробелыИНН(Текст)
    Результат = "";
	Для Номер = 1 По СтрДлина(Текст) Цикл
        Символ = Сред(Текст, Номер, 1);
		Код = КодСимвола(Символ);
        Результат = Результат + ?(Код >= 48 И Код <= 57, Символ, " ");
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция НайтиИННИОГРНВМассивеЧастей(Части)
    
    Результат = Новый Структура("ИНН, ОГРН", "", "");
	Для Каждого Часть Из Части Цикл
        Длина = СтрДлина(Часть);
		Если ПустаяСтрока(Результат.ИНН) И (Длина = 10 Или Длина = 12) Тогда 
        	Результат.ИНН = Часть;
			Продолжить; 
        КонецЕсли;
        
        Если ПустаяСтрока(Результат.ОГРН) И (Длина = 13 Или Длина = 15) Тогда 
        	Результат.ОГРН = Часть;
			Продолжить; 
        КонецЕсли;
        
        Если Не ПустаяСтрока(Результат.ИНН) И Не ПустаяСтрока(Результат.ОГРН) Тогда 
        	Прервать; 
        КонецЕсли;
    КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИзвлечьИННИОГРНИзСтрокиРегистрации(Текст)
    
    Результат = Новый Структура("ИНН, ОГРН", "", "");
	Если Не ЗначениеЗаполнено(Текст) Тогда 
    	Возврат Результат; 
    КонецЕсли;
    
    СтрокаСПробелами = ОставитьТолькоЦифрыИПробелыИНН(Текст);
	Части = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСПробелами, " ", Истина, Ложь);
    Данные = НайтиИННИОГРНВМассивеЧастей(Части);
    
    Результат.ИНН = Данные.ИНН; 
    Результат.ОГРН = Данные.ОГРН;
    
    Возврат Результат;
КонецФункции

Функция ИзвлечьОрганРегистрацииПослеДаты(Текст, ДатаРег)
	
	СтрокаДата = Формат(ДатаРег, "ДФ=dd.MM.yyyy");
	ПозДата = СтрНайти(Текст, СтрокаДата);
	
	Если ПозДата <= 0 Тогда 
		Возврат ""; 
	КонецЕсли;
	НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
	
	Пока НачалоОргана <= СтрДлина(Текст) Цикл
		Симв = Сред(Текст, НачалоОргана, 1);
		Если Симв <> " " И Симв <> "," Тогда 
			Прервать; 
		КонецЕсли;
		НачалоОргана = НачалоОргана + 1;
	КонецЦикла;
	Хвост = Сред(Текст, НачалоОргана);
	ПозИНН = СтрНайти(ВРег(Хвост), "ИНН");
	
	Если ПозИНН > 0 Тогда 
		Возврат СокрЛП(Лев(Хвост, ПозИНН - 1)); 
	КонецЕсли;
	Возврат СокрЛП(Хвост);

КонецФункции

Функция ИзвлечьРеквизитыРегистрацииЮЛ(Текст)
	
	Результат = Новый Структура("ИНН, ОГРН, ДатаРегистрации, ОрганРегистрации", "", "", Неопределено, "");
	Если Не ЗначениеЗаполнено(Текст) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ДанныеИННОГРН = ИзвлечьИННИОГРНИзСтрокиРегистрации(Текст);
	Результат.ИНН = ДанныеИННОГРН.ИНН; 
	Результат.ОГРН = ДанныеИННОГРН.ОГРН;
	
	ДатаРег = ИзвлечьДатуИзСтрокиРеестра(Текст);
	Если ДатаРег = Неопределено Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Результат.ДатаРегистрации = ДатаРег;
	Результат.ОрганРегистрации = ИзвлечьОрганРегистрацииПослеДаты(Текст, ДатаРег);
	
	Возврат Результат;
КонецФункции

Функция ИзвлечьРеквизитыРегистрацииФЛ(Текст)
    
    Результат = Новый Структура("ДатаВыдачи, ОрганВыдавший", Неопределено, "");
    ДатаВыдачи = ИзвлечьДатуИзСтрокиРеестра(Текст);
	Если ДатаВыдачи = Неопределено Тогда 
    	Возврат Результат; 
    КонецЕсли;
    
    Результат.ДатаВыдачи = ДатаВыдачи;
    СтрокаДата = Формат(ДатаВыдачи, "ДФ=dd.MM.yyyy");
	ПозДата = СтрНайти(Текст, СтрокаДата);
	Если ПозДата = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
    НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
    
    Пока НачалоОргана <= СтрДлина(Текст) Цикл
        Симв = Сред(Текст, НачалоОргана, 1);
		Если Симв <> " " И Симв <> "," Тогда 
        	Прервать; 
        КонецЕсли;
		НачалоОргана = НачалоОргана + 1;
    КонецЦикла;
	
	Если НачалоОргана < 1 Или НачалоОргана > СтрДлина(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
    
    ПозЗапятой = СтрНайти(Текст, ",", НаправлениеПоиска.СНачала, НачалоОргана);
	ДлинаОргана = ?(ПозЗапятой > 0, ПозЗапятой - НачалоОргана, СтрДлина(Текст) - НачалоОргана + 1);
    Результат.ОрганВыдавший = СокрЛП(Сред(Текст, НачалоОргана, ДлинаОргана));
    
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область Данные1С

Функция ПолучитьДанныеПайщиковИз1С(Организация, ПИФ, ДатаРеестра)
    
    // 1. Создаем менеджер временных таблиц для передачи отбора между запросами
    МенеджерВТ = Новый МенеджерВременныхТаблиц;
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
    
    Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	Доли.Пайщик КАК Пайщик
        |ПОМЕСТИТЬ ВТ_Пайщики
        |ИЗ
        |	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
        |			&ДатаРеестра,
        |			Организация = &Организация
        |				И ПаевойИнвестиционныйФонд = &ПИФ) КАК Доли
        |ГДЕ
        |	Доли.КоличествоОстаток > 0
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	РеквизитыФЛ.ЮрФизЛицо КАК ЮрФизЛицо,
        |	РеквизитыФЛ.Фамилия КАК Фамилия,
        |	РеквизитыФЛ.Имя КАК Имя,
        |	РеквизитыФЛ.Отчество КАК Отчество,
        |	РеквизитыФЛ.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
        |	РеквизитыФЛ.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
        |	РеквизитыФЛ.ИНН КАК ИНН,
        |	РеквизитыФЛ.АдресРегистрации КАК АдресРегистрации,
        |	РеквизитыФЛ.АдресМестаЖительства КАК АдресМестаЖительства,
        |	РеквизитыФЛ.ДатаРождения КАК ДатаРождения,
        |	РеквизитыФЛ.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
        |	РеквизитыФЛ.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности
        |ПОМЕСТИТЬ ВТ_РеквизитыФЛ
        |ИЗ
        |	ВТ_Пайщики КАК ВТ_Пайщики
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
        |				&ДатаРеестра,
        |				Организация = &Организация
        |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФЛ
        |		ПО ВТ_Пайщики.Пайщик = РеквизитыФЛ.ЮрФизЛицо
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	РеквизитыЮЛ.ЮрФизЛицо КАК ЮрФизЛицо,
        |	РеквизитыЮЛ.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
        |	РеквизитыЮЛ.ИНН КАК ИНН,
        |	РеквизитыЮЛ.ОГРН КАК ОГРН,
        |	РеквизитыЮЛ.ДатаВыдачиОГРН КАК ДатаВыдачиОГРН,
        |	РеквизитыЮЛ.ОрганВыдавшийОГРН КАК ОрганВыдавшийОГРН
        |ПОМЕСТИТЬ ВТ_РеквизитыЮЛ
        |ИЗ
        |	ВТ_Пайщики КАК ВТ_Пайщики
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
        |				&ДатаРеестра,
        |				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
        |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛ
        |		ПО ВТ_Пайщики.Пайщик = РеквизитыЮЛ.ЮрФизЛицо
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	РеквизитыЮЛАнкетные.ЮрФизЛицо КАК ЮрФизЛицо,
        |	РеквизитыЮЛАнкетные.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
        |	РеквизитыЮЛАнкетные.ИНН КАК ИНН,
        |	РеквизитыЮЛАнкетные.ОГРН КАК ОГРН,
        |	РеквизитыЮЛАнкетные.ЮридическийАдрес КАК ЮридическийАдрес,
        |	РеквизитыЮЛАнкетные.ДатаВыдачиОГРН КАК ДатаВыдачиОГРН,
        |	РеквизитыЮЛАнкетные.ОрганВыдавшийОГРН КАК ОрганВыдавшийОГРН
        |ПОМЕСТИТЬ ВТ_РеквизитыЮЛАнкетные
        |ИЗ
        |	ВТ_Пайщики КАК ВТ_Пайщики
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
        |				&ДатаРеестра,
        |				Организация = &Организация
        |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛАнкетные
        |		ПО ВТ_Пайщики.Пайщик = РеквизитыЮЛАнкетные.ЮрФизЛицо
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	Доли.Пайщик КАК Пайщик,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА ""ФЛ""
        |		ИНАЧЕ ""ЮЛ""
        |	КОНЕЦ КАК ТипЛица,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА СОКРЛП(ЕСТЬNULL(РеквизитыФЛ.Фамилия, """") + "" "" + ЕСТЬNULL(РеквизитыФЛ.Имя, """") + "" "" + ЕСТЬNULL(РеквизитыФЛ.Отчество, """"))
        |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ПолноеНаименованиеПоУставу, ЕСТЬNULL(РеквизитыЮЛ.ПолноеНаименованиеПоУставу, """"))
        |	КОНЕЦ КАК Идентификатор,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.СерияУдостоверенияЛичности
        |		ИНАЧЕ NULL
        |	КОНЕЦ КАК СерияПаспорта,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.НомерУдостоверенияЛичности
        |		ИНАЧЕ NULL
        |	КОНЕЦ КАК НомерПаспорта,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.ИНН
        |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ИНН, РеквизитыЮЛ.ИНН)
        |	КОНЕЦ КАК ИНН,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
        |			ТОГДА ЕСТЬNULL(РеквизитыЮЛАнкетные.ОГРН, РеквизитыЮЛ.ОГРН)
        |		ИНАЧЕ NULL
        |	КОНЕЦ КАК ОГРН,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА ЕСТЬNULL(РеквизитыФЛ.АдресРегистрации, РеквизитыФЛ.АдресМестаЖительства)
        |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ЮридическийАдрес, """")
        |	КОНЕЦ КАК Адрес,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.ДатаРождения
        |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
        |	КОНЕЦ КАК ДатаРождения,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.ДатаВыдачиУдостоверенияЛичности
        |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ДатаВыдачиОГРН, РеквизитыЮЛ.ДатаВыдачиОГРН)
        |	КОНЕЦ КАК ДатаГосРегистрации,
        |	ВЫБОР
        |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
        |			ТОГДА РеквизитыФЛ.ОрганВыдавшийУдостоверениеЛичности
        |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ОрганВыдавшийОГРН, РеквизитыЮЛ.ОрганВыдавшийОГРН)
        |	КОНЕЦ КАК ОрганГосРегистрации
        |ПОМЕСТИТЬ _ТаблицаПайщиков
        |ИЗ
        |	ВТ_Пайщики КАК Доли
        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК Лица
        |		ПО Доли.Пайщик = Лица.Ссылка
        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеквизитыФЛ КАК РеквизитыФЛ
        |		ПО Доли.Пайщик = РеквизитыФЛ.ЮрФизЛицо
        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеквизитыЮЛ КАК РеквизитыЮЛ
        |		ПО Доли.Пайщик = РеквизитыЮЛ.ЮрФизЛицо
        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РеквизитыЮЛАнкетные КАК РеквизитыЮЛАнкетные
        |		ПО Доли.Пайщик = РеквизитыЮЛАнкетные.ЮрФизЛицо
        |ГДЕ
        |	Лица.ВидЮрФизЛица ЕСТЬ НЕ NULL 
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	Счета.ЮрФизЛицо КАК Пайщик,
        |	Счета.НомерСчета КАК НомерСчета
        |ИЗ
        |	Справочник.БанковскиеСчета КАК Счета
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пайщики КАК ВТ_Пайщики
        |		ПО Счета.ЮрФизЛицо = ВТ_Пайщики.Пайщик
        |ГДЕ
        |	Счета.ПометкаУдаления = ЛОЖЬ
        |	И Счета.Организация = &Организация";

    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("ПИФ", ПИФ);
    Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);
    
    РезультатЗапросаСчетов = Запрос.Выполнить();
    
	ТаблицаПайщиков = Запрос.МенеджерВременныхТаблиц.Таблицы["_ТаблицаПайщиков"].ПолучитьДанные().Выгрузить();
    ТаблицаПайщиков.Колонки.Добавить("СписокСчетов", Новый ОписаниеТипов("Строка"));

    ВыборкаСчета = РезультатЗапросаСчетов.Выбрать();
   
    СловарьСчетов = Новый Соответствие;
    Пока ВыборкаСчета.Следующий() Цикл
        ТекстСчетов = СловарьСчетов.Получить(ВыборкаСчета.Пайщик);
        СловарьСчетов.Вставить(ВыборкаСчета.Пайщик, ?(ЗначениеЗаполнено(ТекстСчетов), ТекстСчетов + ", " + ВыборкаСчета.НомерСчета, ВыборкаСчета.НомерСчета));
    КонецЦикла;

    Для Каждого Строка Из ТаблицаПайщиков Цикл
        Строка.СписокСчетов = СловарьСчетов.Получить(Строка.Пайщик);
        Если Строка.СписокСчетов = Неопределено Тогда 
			Строка.СписокСчетов = ""; 
        КонецЕсли;
    КонецЦикла;

    Возврат ТаблицаПайщиков;

КонецФункции

Функция НайтиПИФПоНаименованию(НаименованиеПИФ, ДатаРеестра)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда КАК КраткоеНаименованиеФонда,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&Дата, (ВЫРАЗИТЬ(ПолноеНаименованиеФонда КАК СТРОКА(500))) = &Наименование) КАК РеквизитыПИФСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда = СчетаДоверительногоУправления.Наименование
		|			И СчетаДоверительногоУправления.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Дата", ДатаРеестра);
	Запрос.УстановитьПараметр("Наименование", НаименованиеПИФ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СчетДУ = Выборка.СчетДоверительногоУправления;
		Если Не ЗначениеЗаполнено(СчетДУ) Тогда
			СчетДУ = НайтиСчетДУПоНаименованиюФонда(Выборка.КраткоеНаименованиеФонда, НаименованиеПИФ);
		КонецЕсли;
		Возврат Новый Структура("ПИФ, СчетДУ",
			Выборка.ПаевойИнвестиционныйФонд,
			СчетДУ);
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция НайтиСчетДУПоНаименованиюФонда(КраткоеНаименование, ПолноеНаименование)
	
	КандидатыПоиска = Новый Массив;
	
	Если ЗначениеЗаполнено(КраткоеНаименование) Тогда
		КандидатыПоиска.Добавить(СокрЛП(Строка(КраткоеНаименование)));
	КонецЕсли;
	
	ПозОткр = СтрНайти(ПолноеНаименование, """");
	Если ПозОткр > 0 Тогда
		ПозЗакр = СтрНайти(ПолноеНаименование, """", НаправлениеПоиска.СНачала, ПозОткр + 1);
		Если ПозЗакр > ПозОткр Тогда
			ИмяВКавычках = СокрЛП(Сред(ПолноеНаименование, ПозОткр + 1, ПозЗакр - ПозОткр - 1));
			Если ЗначениеЗаполнено(ИмяВКавычках) И КандидатыПоиска.Найти(ИмяВКавычках) = Неопределено Тогда
				КандидатыПоиска.Добавить(ИмяВКавычках);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Фрагмент Из КандидатыПоиска Цикл
		
		Если СтрДлина(Фрагмент) < 3 Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Счета.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК Счета
			|ГДЕ
			|	Счета.ПометкаУдаления = ЛОЖЬ
			|	И Счета.Наименование ПОДОБНО &Шаблон
			|
			|УПОРЯДОЧИТЬ ПО
			|	Счета.Наименование";
		Запрос.УстановитьПараметр("Шаблон", "%" + Фрагмент + "%");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПИФПринадлежитОрганизации(Организация, ПИФ, ДатаРеестра)
	
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(ПИФ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Остатки.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
		|			&Дата,
		|			Организация = &Организация
		|				И ПаевойИнвестиционныйФонд = &ПИФ) КАК Остатки";
	
	Запрос.УстановитьПараметр("Дата", ДатаРеестра);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПИФ", ПИФ);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область ЛогикаСравнения

Функция СформироватьТаблицуРасхождений(ТаблицаФайла, Данные1С)
    
    Расхождения = СоздатьПустуюТаблицуРасхождений();
    
    Словарь1С = Новый Соответствие;
    Для Каждого Строка1С Из Данные1С Цикл
        Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
        Словарь1С.Вставить(Ключ, Строка1С);
    КонецЦикла;
	
	СловарьФайла = Новый Соответствие;
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
        Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
        СловарьФайла.Вставить(Ключ, СтрокаФайла);
        Строка1С = Словарь1С.Получить(Ключ);
        
        Если Строка1С = Неопределено Тогда
            ДобавитьЗаписьВРасхождения(
				Расхождения, 
				СтрокаФайла.ТипЛица, 
				СтрокаФайла.Идентификатор, 
				"Лицо из файла реестра не найдено в 1С", 
				"-", "Указано в файле реестра", "-");
			Продолжить;
        КонецЕсли;
        
        СравнитьСтрокуФайлаС1С(Расхождения, СтрокаФайла, Строка1С);
    КонецЦикла;
	
	ДобавитьЛицаОтсутствующиеВФайле(Расхождения, СловарьФайла, Данные1С);
    
    Возврат Расхождения;
	
КонецФункции

Функция СоздатьПустуюТаблицуРасхождений()
    
    Расхождения = Новый ТаблицаЗначений;
    Расхождения.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ВидРасхождения", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("ЗначениеВ1С", Новый ОписаниеТипов("Строка"));
    
    Возврат Расхождения;
	
КонецФункции

Процедура ДобавитьЗаписьВРасхождения(Расхождения, ТипЛица, Идентификатор, ВидРасхождения, Реквизит, ЗначениеВФайле, ЗначениеВ1С)
    
    Новая = Расхождения.Добавить();
	Новая.ТипЛица = ТипЛица;
    Новая.Идентификатор = Идентификатор;
    Новая.ВидРасхождения = ВидРасхождения;
    Новая.Реквизит = Реквизит;
    Новая.ЗначениеВФайле = ЗначениеВФайле;
    Новая.ЗначениеВ1С = ЗначениеВ1С;
	
КонецПроцедуры

Процедура ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, Реквизит, ЗначВФайле, ЗначВ1С)
    
    Если ЗначВФайле = ЗначВ1С Тогда 
    	Возврат;
	КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ЗначВФайле) И Не ЗначениеЗаполнено(ЗначВ1С) Тогда 
    	Возврат; 
    КонецЕсли;
	ДобавитьЗаписьВРасхождения(Расхождения, СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, "Не совпадает", Реквизит, ЗначВФайле, ЗначВ1С);

КонецПроцедуры

Процедура СравнитьСтрокуФайлаС1С(Расхождения, СтрокаФайла, Строка1С)
    
    Если СтрокаФайла.ТипЛица = "ФЛ" Тогда
        ПаспортФайл = СокрЛП(Строка(СтрокаФайла.СерияПаспорта) + " " + Строка(СтрокаФайла.НомерПаспорта));
        Паспорт1С = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Паспорт", ПаспортФайл, Паспорт1С);
        
        ДР_Файл = ?(ЗначениеЗаполнено(СтрокаФайла.ДатаРождения), Формат(СтрокаФайла.ДатаРождения, "ДФ=dd.MM.yyyy"), "");
        ДР_1С   = ?(ЗначениеЗаполнено(Строка1С.ДатаРождения),   Формат(Строка1С.ДатаРождения,   "ДФ=dd.MM.yyyy"), "");
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Дата рождения", ДР_Файл, ДР_1С);
    КонецЕсли;

    Если СтрокаФайла.ТипЛица = "ЮЛ" Тогда
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "ИНН", СокрЛП(Строка(СтрокаФайла.ИНН)), СокрЛП(Строка(Строка1С.ИНН)));
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "ОГРН", СокрЛП(Строка(СтрокаФайла.ОГРН)), СокрЛП(Строка(Строка1С.ОГРН)));
    КонецЕсли;
	
	ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Адрес", СокрЛП(Строка(СтрокаФайла.Адрес)), СокрЛП(Строка(Строка1С.Адрес)));
    
    РсФайл = СокрЛП(Строка(СтрокаФайла.РасчетныйСчет));
    СписокСчетов1С = Строка1С.СписокСчетов;
    СчетНайден = ЗначениеЗаполнено(СписокСчетов1С) И ЗначениеЗаполнено(РсФайл) И (СтрНайти(СписокСчетов1С, РсФайл) > 0);

    Если Не СчетНайден И (ЗначениеЗаполнено(РсФайл) Или ЗначениеЗаполнено(СписокСчетов1С)) Тогда
        ДобавитьЗаписьВРасхождения(Расхождения, СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, "Не совпадает", "Расчетный счет", РсФайл, СписокСчетов1С);
    КонецЕсли;
	
	ДатаРегФайл = СтрокаФайла.ДатаГосРегистрации; 
	ДатаРег1С = Строка1С.ДатаГосРегистрации;
	
	Если (ДатаРегФайл <> ДатаРег1С) И (ЗначениеЗаполнено(ДатаРегФайл) Или ЗначениеЗаполнено(ДатаРег1С)) Тогда
        ЗначВФайле = ?(ЗначениеЗаполнено(ДатаРегФайл), Формат(ДатаРегФайл, "ДФ=dd.MM.yyyy"), "");
        ЗначВ1С = ?(ЗначениеЗаполнено(ДатаРег1С), Формат(ДатаРег1С, "ДФ=dd.MM.yyyy"), "");
        ДобавитьЗаписьВРасхождения(
			Расхождения, 
			СтрокаФайла.ТипЛица, 
			СтрокаФайла.Идентификатор, 
			"Не совпадает", 
			"Дата гос. регистрации / выдачи документа", 
			ЗначВФайле, 
			ЗначВ1С);
    КонецЕсли;

    ОрганРегФайл = ОчиститьОрганРегистрации(СокрЛП(Строка(СтрокаФайла.ОрганГосРегистрации)));
    ОрганРег1С = ОчиститьОрганРегистрации(СокрЛП(Строка(Строка1С.ОрганГосРегистрации)));
    ДобавитьРасхождениеПоРеквизиту(
		Расхождения, 
		СтрокаФайла, 
		"Орган, осуществивший регистрацию / выдавший документ", 
		ОрганРегФайл, 
		ОрганРег1С);

КонецПроцедуры

Процедура ДобавитьЛицаОтсутствующиеВФайле(Расхождения, СловарьФайла, Данные1С)
    
    Для Каждого Строка1С Из Данные1С Цикл
        Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
        
        Если СловарьФайла.Получить(Ключ) = Неопределено Тогда 
        	ДобавитьЗаписьВРасхождения(
				Расхождения, 
				Строка1С.ТипЛица, 
				Строка1С.Идентификатор, 
				"Лицо из 1С отсутствует в файле реестра", 
				"-", 
				"-", 
				"Указано в 1С");
		КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ОчиститьОрганРегистрации(Знач Текст)
    
    Если Не ЗначениеЗаполнено(Текст) Тогда 
    	Возврат Текст;
	КонецЕсли;
    
    Текст = СокрЛП(Текст);
    
    Пока Прав(Текст, 1) = "," Или Прав(Текст, 1) = ";"
	Или Прав(Текст, 1) = " " Цикл 
    	Текст = Лев(Текст, СтрДлина(Текст) - 1); 
    	Текст = СокрП(Текст);
	КонецЦикла;
    
    Пока СтрНайти(Текст, "  ") > 0 Цикл 
    	Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
    
    Возврат Текст;

КонецФункции

Функция ПолучитьКлючПоискаВ1С(ТипЛица, Идентификатор, ИНН)
    
    Идентификатор = НормализоватьИдентификаторДляКлюча(Идентификатор);
    ИНН = ВРег(СокрЛП(Строка(ИНН)));
	Если ТипЛица = "ФЛ" Тогда 
    	Возврат "ФЛ|" + Идентификатор; 
    КонецЕсли;
	Если ЗначениеЗаполнено(ИНН) Тогда 
    	Возврат "ЮЛ|" + ИНН; 
    КонецЕсли;
    
    Возврат "ЮЛ|НАИМ|" + Идентификатор;
	
КонецФункции

Функция НормализоватьИдентификаторДляКлюча(Строка)
    
    Строка = СокрЛП(Строка(Строка));
    Строка = РаботаСоСтрокамиКлиентСервер.ЗаменитьПробельныеСимволы(Строка, " ");
	Пока СтрНайти(Строка, "  ") > 0 Цикл 
    	Строка = СтрЗаменить(Строка, "  ", " ");
	КонецЦикла;
    
    Возврат ВРег(СокрЛП(Строка));

КонецФункции

#КонецОбласти

