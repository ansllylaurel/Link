&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Отчет.СохранятьДанныеРеестраВExternals = Ложь;
	ДатаСписка = ТекущаяДатаСеанса();
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ПоказыватьСовпавшиеДанные = Ложь;
	ПоказыватьСверкуАдресов = Ложь;
	СверятьСExternals = Ложь;
	УстановитьДоступностьЭлементовИсточникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УстановитьДоступностьЭлементовИсточникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовИсточникаНаСервере()
	
	Элементы.ПутьКПапке.Доступность = Не СверятьСExternals;
	Элементы.СохранятьДанныеРеестраВExternals.Доступность = Не СверятьСExternals;
	Если СверятьСExternals Тогда
		Отчет.СохранятьДанныеРеестраВExternals = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СверятьСExternalsПриИзменении(Элемент)
	
	УстановитьДоступностьЭлементовИсточникаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("Сформировать");
	
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "Укажите организацию");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСписка) Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "Укажите дату сверки");
		Возврат;
	КонецЕсли;
	
	Если СверятьСExternals Тогда
		ЗапуститьСверкуИзExternals(ПараметрыСессии);
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Отчет.ПутьКПапке) Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "Выберите папку с файлами");
		Возврат;
	КонецЕсли;
	
	Если Отчет.СохранятьДанныеРеестраВExternals Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОСохранении", ЭтаФорма, ПараметрыСессии);
		ТекстВопроса = "Включена опция сохранения данных в Externals."
			+ Символы.ПС
			+ "Существующие данные по этим файлам в базе будут удалены и заменены новыми."
			+ Символы.ПС
			+ "Продолжить?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;
	
	ЗапуститьСверку(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКПапкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите папку с реестрами";
	
	Если ЗначениеЗаполнено(Отчет.ПутьКПапке) Тогда
		Файл = Новый Файл(Отчет.ПутьКПапке);
		Если Файл.Существует() Тогда
			Диалог.Каталог = ?(Файл.ЭтоКаталог(), Файл.ПолноеИмя, Файл.Путь);
		КонецЕсли;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПапки", ЭтаФорма);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРезультатовПриАктивизацииСтроки(Элемент)
	
	ОбновитьОтображениеДокументаОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьСовпавшиеДанныеПриИзменении(Элемент)
	
	ОбновитьОтображениеДокументаОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьСверкуАдресовПриИзменении(Элемент)
	
	ОбновитьОтображениеДокументаОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыСверкиПриИзменении(Элемент)
	
	Если ТаблицаРезультатов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ТаблицаРезультатов.ТекущиеДанные;
	ПересобратьОтчетыПоНастройкамНаСервере(?(ТекДанные = Неопределено, -1, ТекДанные.ПолучитьИдентификатор()));
	ОбновитьОтображениеДокументаОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеДокументаОтчета()
	
	ТекДанные = Элементы.ТаблицаРезультатов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ДокументОтчета = "";
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекДанные.ДанныеHTML) И Не ПустаяСтрока(ТекДанные.АдресДанныхСверки) Тогда
		ПостроитьОтчетСтрокиПоКэшуНаСервере(ТекДанные.ПолучитьИдентификатор());
		ТекДанные = Элементы.ТаблицаРезультатов.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ДокументОтчета = "";
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОтчета = ПрименитьНастройкиОтображенияКHTML(ТекДанные.ДанныеHTML);
	
КонецПроцедуры

&НаКлиенте
Функция ПрименитьНастройкиОтображенияКHTML(Знач ТекстHTML)
	
	Если Не ЗначениеЗаполнено(ТекстHTML) Тогда
		Возврат ТекстHTML;
	КонецЕсли;
	
	КлассыТела = Новый Массив;
	Если ПоказыватьСовпавшиеДанные Тогда
		КлассыТела.Добавить("show_matched");
	КонецЕсли;
	Если ПоказыватьСверкуАдресов Тогда
		КлассыТела.Добавить("show_address");
	КонецЕсли;
	
	АтрибутКласса = ?(КлассыТела.Количество() > 0, " class='" + СтрСоединить(КлассыТела, " ") + "'", "");
	
	Результат = ТекстHTML;
	ПозBody = СтрНайти(ВРег(Результат), "<BODY");
	Если ПозBody > 0 Тогда
		ПозКонцаТега = СтрНайти(Результат, ">", , ПозBody);
		Если ПозКонцаТега > 0 Тогда
			Результат = Лев(Результат, ПозBody - 1) + "<body" + АтрибутКласса + ">" + Сред(Результат, ПозКонцаТега + 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПапки(ВыбранныеФайлы, Параметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Отчет.ПутьКПапке = ВыбранныеФайлы[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОСохранении(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЗарегистрироватьОкончаниеСессии(Параметры);
		Возврат;
	КонецЕсли;
	
	ЗапуститьСверку(Параметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСверкуИзExternals(ПараметрыСессии)
	
	Состояние("Сверка с данными Externals...");
	
	РезультатСверки = СформироватьИзExternalsНаСервере(ПараметрыСессии);
	
	Если РезультатСверки.ВсегоФайлов = 0 Тогда
		СообщитьОшибкуСессии(ПараметрыСессии,
			"В Externals нет данных реестров на дату " + Формат(ДатаСписка, "ДФ=dd.MM.yyyy"));
	ИначеЕсли РезультатСверки.КоличествоОшибок > 0 Тогда
		ТекстСообщения = СтрШаблон("Завершено. Обработано фондов: %1. Ошибок: %2",
			РезультатСверки.ВсегоФайлов, РезультатСверки.КоличествоОшибок);
		СообщитьОшибкуСессии(ПараметрыСессии, "Есть ошибки" + Символы.ПС + ТекстСообщения);
	КонецЕсли;
	
	ОбновитьОтображениеДокументаОтчета();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСверку(ПараметрыСессии)
	
	Состояние("Поиск файлов на компьютере...");
	
	ПутьКФайлу = Отчет.ПутьКПапке;
	Если Не СтрЗаканчиваетсяНа(ПутьКФайлу, "\") И Не СтрЗаканчиваетсяНа(ПутьКФайлу, "/") Тогда
		ПутьКФайлу = ПутьКФайлу + "\";
	КонецЕсли;
	
	КаталогНаДиске = Новый Файл(ПутьКФайлу);
	Если Не КаталогНаДиске.Существует() Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "Указанный каталог не существует");
		Возврат;
	КонецЕсли;
	
	ФайлыВПапке = НайтиФайлы(ПутьКФайлу, "*.xlsx", Ложь);
	Если ФайлыВПапке.Количество() = 0 Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "В папке нет файлов, удовлетворяющих поиску");
		Возврат;
	КонецЕсли;
	
	ИменаФайлов = Новый Массив;
	ФайлыПоИмени = Новый Соответствие;
	Для Каждого ТекФайл Из ФайлыВПапке Цикл
		ИменаФайлов.Добавить(ТекФайл.Имя);
		ФайлыПоИмени.Вставить(ТекФайл.Имя, ТекФайл);
	КонецЦикла;
	
	ПодходящиеИмена = ОтобратьИменаФайловПоДатеСверкиНаСервере(ИменаФайлов, ДатаСписка);
	
	МассивФайловДляСервера = Новый Массив;
	Для Каждого ИмяФайла Из ПодходящиеИмена Цикл
		
		ТекФайл = ФайлыПоИмени.Получить(ИмяФайла);
		Если ТекФайл = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДвоичныеДанные = Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
		Исключение
			СообщитьОшибкуСессии(ПараметрыСессии,
				"Не удалось прочитать файл " + ТекФайл.Имя + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		ОписаниеФайла = Новый Структура("Имя, ПолноеИмя, Адрес", ТекФайл.Имя, ТекФайл.ПолноеИмя, Адрес);
		МассивФайловДляСервера.Добавить(ОписаниеФайла);
		
	КонецЦикла;
	
	Если МассивФайловДляСервера.Количество() = 0 Тогда
		СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, "В папке нет файлов, удовлетворяющих поиску");
		Возврат;
	КонецЕсли;
	
	Состояние("Выполняется сверка файлов на сервере...");
	
	РезультатСверки = СформироватьНаСервере(МассивФайловДляСервера, ПараметрыСессии);
	
	Если РезультатСверки.КоличествоОшибок > 0 Тогда
		ТекстСообщения = СтрШаблон("Завершено. Обработано файлов: %1. Ошибок: %2",
			РезультатСверки.ВсегоФайлов, РезультатСверки.КоличествоОшибок);
		СообщитьОшибкуСессии(ПараметрыСессии, "Есть ошибки" + Символы.ПС + ТекстСообщения);
	КонецЕсли;
	
	ОбновитьОтображениеДокументаОтчета();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОшибкуСессии(ПараметрыСессии, ТекстОшибки)
	
	ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	Сообщить(ТекстОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОшибкуИЗавершитьСессию(ПараметрыСессии, ТекстОшибки)
	
	СообщитьОшибкуСессии(ПараметрыСессии, ТекстОшибки);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Функция ОтобратьИменаФайловПоДатеСверкиНаСервере(ИменаФайлов, ДатаСверки)
	
	Возврат РеквизитФормыВЗначение("Отчет").ОтобратьИменаФайловПоДатеСверки(ИменаФайлов, ДатаСверки);
	
КонецФункции

&НаСервере
Функция СформироватьИзExternalsНаСервере(ПараметрыСессии)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ОчиститьТаблицуРезультатов();
	
	Результаты = ОтчетОбъект.СформироватьОтчетыИзExternals(ОтчетОбъект.Организация, ДатаСписка, ПараметрыСессии);
	
	Статистика = Новый Структура("ВсегоФайлов, КоличествоОшибок", 0, 0);
	
	Для Каждого РезультатФонда Из Результаты Цикл
		
		Статистика.ВсегоФайлов = Статистика.ВсегоФайлов + 1;
		ДобавитьСтрокуРезультата(
			Лев(РезультатФонда.Представление, 100),
			РезультатФонда.Успех,
			РезультатФонда.ТекстОтчета,
			РезультатФонда.ТекстОшибки,
			"Ошибка сверки",
			Статистика,
			РезультатФонда.ДанныеСверки);
		
		Если Не РезультатФонда.Успех Тогда
			ТекстОшибки = ?(ЗначениеЗаполнено(РезультатФонда.ТекстОшибки), РезультатФонда.ТекстОшибки, "Неизвестная ошибка");
			Сообщить(РезультатФонда.Представление + ": " + ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Статистика;
	
КонецФункции

&НаСервере
Функция СформироватьНаСервере(МассивФайлов, ПараметрыСессии)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ОчиститьТаблицуРезультатов();
	
	Статистика = Новый Структура("ВсегоФайлов, КоличествоОшибок", МассивФайлов.Количество(), 0);
	
	Для Каждого ФайлИзСписка Из МассивФайлов Цикл
		
		Двоичные = ПолучитьИзВременногоХранилища(ФайлИзСписка.Адрес);
		УдалитьИзВременногоХранилища(ФайлИзСписка.Адрес);
		
		РезультатОбработки = ОтчетОбъект.СформироватьОтчет(
			ОтчетОбъект.Организация,
			Двоичные,
			ФайлИзСписка.ПолноеИмя,
			ОтчетОбъект.СохранятьДанныеРеестраВExternals,
			Истина,
			ПараметрыСессии);
		
		ДобавитьСтрокуРезультата(
			ФайлИзСписка.Имя,
			РезультатОбработки.Успех,
			РезультатОбработки.ТекстОтчета,
			РезультатОбработки.ТекстОшибки,
			"Ошибка обработки файла",
			Статистика,
			РезультатОбработки.ДанныеСверки);
		
		Если Не РезультатОбработки.Успех Тогда
			ТекстОшибки = ?(ЗначениеЗаполнено(РезультатОбработки.ТекстОшибки), РезультатОбработки.ТекстОшибки, "Неизвестная ошибка");
			Сообщить("Ошибка в файле " + ФайлИзСписка.Имя + ": " + ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Статистика;
	
КонецФункции

// Отчеты по остальным строкам пересобираются при переходе на них, чтобы не тратить время на невидимые данные.
&НаСервере
Процедура ПересобратьОтчетыПоНастройкамНаСервере(ИдентификаторТекущейСтроки)
	
	Для Каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
		Если Не ПустаяСтрока(СтрокаРезультата.АдресДанныхСверки) Тогда
			СтрокаРезультата.ДанныеHTML = "";
		КонецЕсли;
	КонецЦикла;
	
	ПостроитьОтчетСтрокиПоКэшуНаСервере(ИдентификаторТекущейСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьОтчетСтрокиПоКэшуНаСервере(ИдентификаторСтроки)
	
	Если ИдентификаторСтроки < 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРезультата = ТаблицаРезультатов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаРезультата = Неопределено Или ПустаяСтрока(СтрокаРезультата.АдресДанныхСверки) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСверки = ПолучитьИзВременногоХранилища(СтрокаРезультата.АдресДанныхСверки);
	Если ТипЗнч(ДанныеСверки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРезультата.ДанныеHTML = РеквизитФормыВЗначение("Отчет").СформироватьHTMLИзДанныхСверки(ДанныеСверки);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТаблицуРезультатов()
	
	Для Каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
		Если Не ПустаяСтрока(СтрокаРезультата.АдресДанныхСверки) Тогда
			УдалитьИзВременногоХранилища(СтрокаРезультата.АдресДанныхСверки);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРезультатов.Очистить();
	ДокументОтчета = "";
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРезультата(ПредставлениеФайла, Успех, ТекстОтчета, ТекстОшибки, ЗаголовокОшибки, Статистика, ДанныеСверки = Неопределено)
	
	НоваяСтрока = ТаблицаРезультатов.Добавить();
	НоваяСтрока.ПредставлениеФайла = ПредставлениеФайла;
	НоваяСтрока.АдресДанныхСверки = "";
	
	Если Успех Тогда
		НоваяСтрока.ДанныеHTML = ТекстОтчета;
		Если ДанныеСверки <> Неопределено Тогда
			НоваяСтрока.АдресДанныхСверки = ПоместитьВоВременноеХранилище(ДанныеСверки, УникальныйИдентификатор);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ТекстОшибкиИтог = ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Неизвестная ошибка");
	НоваяСтрока.ДанныеHTML = "<html><body><h3 style='color:red'>" + ЗаголовокОшибки
		+ "</h3><p>" + ТекстОшибкиИтог + "</p></body></html>";
	Статистика.КоличествоОшибок = Статистика.КоличествоОшибок + 1;
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	
	РеквизитФормыВЗначение("Отчет").ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессиюНаСервере(ИмяКоманды)
	
	Возврат РеквизитФормыВЗначение("Отчет").ЗарегистрироватьНовуюСессию(ИмяКоманды);
	
КонецФункции

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РеквизитФормыВЗначение("Отчет").ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры
