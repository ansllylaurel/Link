					ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
				ГДЕ
					dbo_Files.Source_Id.Id = 24
				УПОРЯДОЧИТЬ ПО
					dbo_Files.Publication_Date УБЫВ))</QueryText>
