		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДенежныеСредстваВКредитныхИнструментахОстатки.Организация КАК Организация,
	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК ДепозитныйВклад,
	ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток КАК СуммаОстаток
ПОМЕСТИТЬ _ДействующиеДепозитныеВклады
ИЗ
	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
			&amp;грПериод,
			Организация = &amp;Организация
				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
	УсловияКредитныхИнструментов.КредитныйИнструмент КАК ДепозитныйВклад,
	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения,
	УсловияКредитныхИнструментов.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
	УсловияКредитныхИнструментов.Процент КАК Процент,
	УсловияКредитныхИнструментов.Реинвестировать КАК Реинвестировать,
	УсловияКредитныхИнструментов.Комментарий КАК Комментарий
ПОМЕСТИТЬ _НачальныеУсловияДепозитногоВклада
ИЗ
	(ВЫБРАТЬ
		УсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		МИНИМУМ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
	ИЗ
		РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
				,
				КредитныйИнструмент В
					(ВЫБРАТЬ
						_ДействующиеДепозитныеВклады.ДепозитныйВклад
					ИЗ
						_ДействующиеДепозитныеВклады)) КАК УсловияКредитныхИнструментов
	ГДЕ
		УсловияКредитныхИнструментов.Действует
	
	СГРУППИРОВАТЬ ПО
		УсловияКредитныхИнструментов.КредитныйИнструмент) КАК _НачальныеПериодыУсловийДепозитногоВклада
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
				,
				КредитныйИнструмент В
					(ВЫБРАТЬ
						_ДействующиеДепозитныеВклады.ДепозитныйВклад
					ИЗ
						_ДействующиеДепозитныеВклады)) КАК УсловияКредитныхИнструментов
		ПО _НачальныеПериодыУсловийДепозитногоВклада.КредитныйИнструмент = УсловияКредитныхИнструментов.КредитныйИнструмент
			И _НачальныеПериодыУсловийДепозитногоВклада.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК НаименованиеУК,
	ПРЕДСТАВЛЕНИЕ(_ДействующиеДепозитныеВклады.ДепозитныйВклад.БанковскийСчет.Банк) КАК НаименованиеБанка,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад.БанковскийСчет.Договор.НомерДоговора КАК НомерДоговора,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад.НомерПодтверждения КАК НомерПодтверждения,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад.БанковскийСчет.Договор.ДатаЗаключения КАК ДатаДоговора,
	"Депозит" КАК ВидРазмещения,
	ВЫБОР
		КОГДА УсловияКредитныхИнструментовСрезПоследних.Реинвестировать
			ТОГДА "возможно"
		ИНАЧЕ "невозможно"
	КОНЕЦ КАК ПополнениеВклада,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад.ДатаРегистрации КАК ДатаРегистрации,
	_ДействующиеДепозитныеВклады.СуммаОстаток КАК СуммаОстаток,
	УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК Период,
	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
	РАЗНОСТЬДАТ(_ДействующиеДепозитныеВклады.ДепозитныйВклад.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК КоличествоДней,
	_НачальныеУсловияДепозитногоВклада.Процент КАК ПроцентПриЗаключенииДоговора,
	"" КАК ПлавающийПроцент,
	УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
	УсловияКредитныхИнструментовСрезПоследних.Процент / 100 КАК СтавкаПоДоговору,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад КАК ДепозитныйВклад,
	_ДействующиеДепозитныеВклады.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	_ДействующиеДепозитныеВклады.ДепозитныйВклад.БанковскийСчет КАК ДепозитныйСчет
ИЗ
	_ДействующиеДепозитныеВклады КАК _ДействующиеДепозитныеВклады
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
			УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
			УсловияКредитныхИнструментовСрезПоследних.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
			УсловияКредитныхИнструментовСрезПоследних.Реинвестировать КАК Реинвестировать
		ИЗ
			(ВЫБРАТЬ
				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
			ИЗ
				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&amp;Период, ДатаНачалаДействияУсловий &lt;= &amp;Период) КАК УсловияКредитныхИнструментовСрезПоследних
			ГДЕ
				УсловияКредитныхИнструментовСрезПоследних.Действует
			
			СГРУППИРОВАТЬ ПО
				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&amp;Период, ДатаНачалаДействияУсловий &lt;= &amp;Период) КАК УсловияКредитныхИнструментовСрезПоследних
				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		ПО _ДействующиеДепозитныеВклады.ДепозитныйВклад = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
				&amp;Период,
				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыОрганизации
		ПО _ДействующиеДепозитныеВклады.Организация.ЮрФизЛицо = РеквизитыОрганизации.ЮрФизЛицо
