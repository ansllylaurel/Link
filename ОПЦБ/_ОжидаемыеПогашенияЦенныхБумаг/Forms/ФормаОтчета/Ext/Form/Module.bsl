
#Область События_формы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ОбновитьСписокСчетовДоверительногоУправленияНаСервере(Отчет.СчетаДоверительногоУправления,				ВидыДоговоровИСчетаДоверительногоУправления);
	ОбновитьСписокСчетовДоверительногоУправленияНаСервере(Отчет.ИсключаемыеСчетаДоверительногоУправления,	ИсключаемыеВидыДоговоровИСчетаДоверительногоУправления);
			
КонецПроцедуры  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
				
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Если Не ЗначениеЗаполнено(Отчет.Период) Тогда
		Отчет.Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	КонецЕсли;	
			
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	                           	
	РаботаСОтчетами.ЗапомнитьКлючВариантаОтчета(Отчет, ЭтаФорма.КлючТекущегоВарианта);
	
	ВариантОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтаФорма.Отчет);		
	
	Если ВариантОтчета = "ПодачаЗаявленийНаОферту" Тогда
		Отчет.ДетализироватьПоСчетамДоверительногоУправления = Истина;
	КонецЕсли;
	
	Отчет.Период.ДатаНачала		= ?(ВариантОтчета = "ПодачаЗаявленийНаОферту", '00010101', Отчет.Период.ДатаНачала);
	Отчет.Период.ДатаОкончания 	= ?(ВариантОтчета = "ПодачаЗаявленийНаОферту", '00010101', Отчет.Период.ДатаОкончания);
	
	ЭтаФорма.ДатаЗаявления = ТекущаяДатаСеанса();
	
	Отчет.Облигация = ?(ВариантОтчета <> "ПодачаЗаявленийНаОферту", Неопределено, Отчет.Облигация);	 
	
	ДатаОферты = ДатаОферты(Отчет.Облигация, ЭтаФорма.ДатаЗаявления);
	
	Если ДатаОферты <> Неопределено И ДатаОферты <> '00010101' Тогда 		
		Отчет.Период.ДатаНачала 	= НачалоДня(ДатаОферты);
		Отчет.Период.ДатаОкончания 	= КонецДня(ДатаОферты);
	КонецЕсли;
	
	Если ВариантОтчета = "ПодачаЗаявленийНаОферту" Тогда
		ЭтаФорма.БрокерБК 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");
		ЭтаФорма.БрокерГПБ 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ");
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);	

КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ОтборПоВидамДоговоровИСчетаДоверительногоУправленияПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьВидыДоговоровИСчетаДоверительногоУправленияПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоговоровИСчетаДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьСписокСчетовДоверительногоУправленияНаСервере(Отчет.СчетаДоверительногоУправления, ВидыДоговоровИСчетаДоверительногоУправления);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключаемыеВидыДоговоровИСчетаДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьСписокСчетовДоверительногоУправленияНаСервере(Отчет.ИсключаемыеСчетаДоверительногоУправления, ИсключаемыеВидыДоговоровИСчетаДоверительногоУправления);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
		
	ИменаСмещенияПолей = Новый Структура();
	ИменаСмещенияПолей.Вставить("АктивПогашениеКупона", 0);
	ИменаСмещенияПолей.Вставить("ДатаПогашения", 1);
	ИменаСмещенияПолей.Вставить("ДатаФиксации", 2);
	
	РасшифровываемыеЗначения = ПолучитьРасшифровкуНаСервере(Расшифровка, ИменаСмещенияПолей);
	
	Если РасшифровываемыеЗначения = Неопределено Тогда
		
		Возврат;
		
	Иначе
		
		Облигация = РасшифровываемыеЗначения["АктивПогашениеКупона"]; 
		ДатаПогашенияКупона = РасшифровываемыеЗначения["ДатаПогашения"];
		ДатаФиксации = РасшифровываемыеЗначения["ДатаФиксации"];
		
		СтандартнаяОбработка = Ложь;
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
		ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет;
		ПараметрВыполненногоДействия = Неопределено;
		ДоступныеДействия = Новый Массив();
		ДополнительныеПунктыМеню = Новый СписокЗначений;
		
		ДополнительныеПунктыМеню.Добавить(18, "Открыть " + Облигация);
		Если ЕстьПравоНаСозданиеДокументов() Тогда 
			ДополнительныеПунктыМеню.Добавить(17, "Открыть форму погашения купона облигации");
		КонецЕсли;
		
		ОбработкаРасшифровки.ВыбратьДействие(Расшифровка, ВыполненноеДействие, ПараметрВыполненногоДействия, ДоступныеДействия, ДополнительныеПунктыМеню);
		
		Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
			ОткрытьЗначение(ПараметрВыполненногоДействия);
		Иначе	
			Если ВыполненноеДействие = 17 тогда
				
				ФормаОбработки = ОткрытьФорму("Обработка.СводноеПогашениеКупона.Форма.Основная",,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				ФормаОбработки.Облигация =  Облигация;
				ФормаОбработки.Дата = ДатаПогашенияКупона;
				ФормаОбработки.ДатаФиксации = ДатаФиксации;
				//ФормаОбработки.СуммаНаОднуОблигацию = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(Облигация, ДатаПогашенияКупона, ПредопределенноеЗначение("Справочник.СчетаДоверительногоУправления.ПустаяСсылка"), Истина);
				ФормаОбработки.СуммаНаОднуОблигацию = 0;
				ФормаОбработки.ЗаполнитьПлановыеИСозданныеПогашенияНаСервере();
				
			ИначеЕсли  ВыполненноеДействие = 18 тогда

				ОткрытьЗначение(Облигация);
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаявленияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Отчет.Облигация) Тогда
		ОблигацияПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Отчет.Организация, Ответственный));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйОчистка(Элемент, СтандартнаяОбработка)
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ВыбранноеЗначение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
КонецПроцедуры

&НаКлиенте
Процедура ОблигацияПриИзменении(Элемент)
		 
	ДатаОферты = ДатаОферты(Отчет.Облигация, ЭтаФорма.ДатаЗаявления);
	
	Если ДатаОферты = Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить дату оферты. Проверьте выбор облигации и даты заявления");
	Иначе
		Отчет.Период.ДатаНачала 	= НачалоДня(ДатаОферты);
		Отчет.Период.ДатаОкончания 	= КонецДня(ДатаОферты);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаПечать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаявлениеДляБК 	= Новый ТабличныйДокумент;
	ЗаявлениеДляГПБ = Новый ТабличныйДокумент;
	
	ПечатьНаСервере(ЗаявлениеДляБК, ЗаявлениеДляГПБ);
	
	Если ЗаявлениеДляБК.ВысотаТаблицы > 0 Тогда	
		
		ШрифтКолонтитула = Новый Шрифт("Times New Roman", 8,, Ложь);
		
		ЗаявлениеДляБК.ВерхнийКолонтитул.Выводить 				= Истина;
		ЗаявлениеДляБК.ВерхнийКолонтитул.ВертикальноеПоложение 	= ВертикальноеПоложение.Верх; 
		ЗаявлениеДляБК.ВерхнийКолонтитул.НачальнаяСтраница 		= 1;		
		ЗаявлениеДляБК.ВерхнийКолонтитул.Шрифт 					= ШрифтКолонтитула;
		ЗаявлениеДляБК.ВерхнийКолонтитул.ТекстСлева 			= "Приложение № 14 к Регламенту брокерского обслуживания ООО «БК РЕГИОН»";
		
		Если ЭтотОбъект.ДатаЗаявления < Дата(2024, 11, 19) Тогда
			
			ЗаявлениеДляБК.РазмерКолонтитулаСнизу					= 50;	 
			ЗаявлениеДляБК.НижнийКолонтитул.Выводить 				= Истина;		
			ЗаявлениеДляБК.НижнийКолонтитул.ВертикальноеПоложение 	= ВертикальноеПоложение.Низ;
			ЗаявлениеДляБК.НижнийКолонтитул.НачальнаяСтраница 		= 1;		
			ЗаявлениеДляБК.НижнийКолонтитул.Шрифт 					= ШрифтКолонтитула;		
			ЗаявлениеДляБК.НижнийКолонтитул.ТекстВЦентре = "Внимание! Указанное ниже заполняется сотрудником ООО «БК РЕГИОН»					" + 
					"Поручение принято:	             ________  _______     ___________________							" + 
					"					Время    Дата	   Подпись									" +
					"Подписано электронной подписью. Соглашение об электронном документообороте №1/EDO от 01.07.2013 г.";
			
		КонецЕсли;
		
		ОткрытьФайл(ЗаявлениеДляБК, "Заявление для БК РЕГИОН");
		
	КонецЕсли;
	
	Если ЗаявлениеДляГПБ.ВысотаТаблицы > 0 Тогда
		
		ЗаявлениеДляГПБ.ПолеСлева 	= 15;
		ЗаявлениеДляГПБ.ПолеСправа	= 15;		
		ОткрытьФайл(ЗаявлениеДляГПБ, "Заявление для ГПБ");
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

// РасшифруемыеПоля - структура, ключ = наименование колонки, значение - относительное смещение поля от расшифровки
// Для самого расшифруемого поля смещение = 0
&НаСервере
Функция ПолучитьРасшифровкуНаСервере(Расшифровка, РасшифруемыеПоля)
	
	Если ТипЗнч(РасшифруемыеПоля) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;                
	
	Данные = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	
	ВозвращаемыеЗначения = Новый Структура(); 	
	
	Для каждого СмещениеИмяПоля из РасшифруемыеПоля Цикл
		
		Поля = Данные.Элементы.Получить(Расшифровка + СмещениеИмяПоля.Значение).ПолучитьПоля();
		ПолеРасшифровки = Поля.Найти(СмещениеИмяПоля.Ключ);
		
		Если ПолеРасшифровки = Неопределено Тогда
			Возврат Неопределено;	
		Иначе
			ВозвращаемыеЗначения.Вставить(СмещениеИмяПоля.Ключ, ПолеРасшифровки.Значение);
		КонецЕсли;		
		
	КонецЦикла;
	
	Возврат ВозвращаемыеЗначения;    
	
КонецФункции

&НаСервере
Процедура ОбновитьСписокСчетовДоверительногоУправленияНаСервере(Список, Данные)
	
	СчетаДУ			= Новый Массив;
	ВидыДоговоровДУ	= Новый Массив;
	
	Для Каждого Значение Из Данные.ВыгрузитьЗначения() Цикл
		Если ТипЗнч(Значение) = Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления")
			И Значение <> Перечисления.ВидыДоговоровДоверительногоУправления.ПустаяСсылка() Тогда
			ВидыДоговоровДУ.Добавить(Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.СчетаДоверительногоУправления")
			И Значение <> Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
			СчетаДУ.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",		Отчет.Организация);
	Запрос.УстановитьПараметр("ВидыДоговоровДУ",	ВидыДоговоровДУ);
	Запрос.УстановитьПараметр("СчетаДУ",			СчетаДУ);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	(СчетаДоверительногоУправления.Ссылка В (&СчетаДУ)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровДУ))
		|	И СчетаДоверительногоУправления.Организация = &Организация";
	
	Список.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьПравоНаСозданиеДокументов()
	
	Возврат ПравоДоступа("Добавление", Метаданные.Документы.ПогашениеКупона);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Отчет    = Форма.Отчет;
	Элементы = Форма.Элементы;
	
	Элементы.Период.Видимость        = Форма.КлючТекущегоВарианта <> "ПодачаЗаявленийНаОферту";
	Элементы.ДатаЗаявления.Видимость = Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту";
	Элементы.ДатаОферты.Видимость    = Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту";
	
	Элементы.ДетализироватьПоСчетамДоверительногоУправления.Видимость = Форма.КлючТекущегоВарианта <> "ПодачаЗаявленийНаОферту";
	
	Элементы.ОтборПоВидамДоговоровИСчетаДоверительногоУправления.Видимость	= Форма.КлючТекущегоВарианта <> "ПодачаЗаявленийНаОферту"; 
	Элементы.ИсключитьВидыДоговоровИСчетаДоверительногоУправления.Видимость = Форма.КлючТекущегоВарианта <> "ПодачаЗаявленийНаОферту"; 
														 																					
	Элементы.ВидыДоговоровИСчетаДоверительногоУправления.Видимость = Отчет.ОтборПоВидамДоговоровИСчетаДоверительногоУправления; 
	
	Элементы.ИсключаемыеВидыДоговоровИСчетаДоверительногоУправления.Видимость = Отчет.ИсключитьВидыДоговоровИСчетаДоверительногоУправления;
		
	Элементы.Облигация.Видимость     = Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту";  		
	Элементы.Период.Заголовок        = ?(Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту", "Дата заявления", "За период");	
	Элементы.КомандаПечать.Видимость = Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту";
	Элементы.Ответственный.Видимость = Форма.КлючТекущегоВарианта = "ПодачаЗаявленийНаОферту";
	Элементы.КопироватьДанныеВБуферОбмена.Видимость = Форма.КлючТекущегоВарианта = "ОплатыПоПогашениям";
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДатаОферты(Облигация, НачалоПериода)
	
	Если ЗначениеЗаполнено(Облигация) И НачалоПериода <> '00010101' Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МИНИМУМ(УсловияОферт.ДатаВыкупа) КАК ДатаВыкупа
			|ИЗ
			|	РегистрСведений.УсловияОферт КАК УсловияОферт
			|ГДЕ
			|	УсловияОферт.Облигация = &Облигация
			|	И УсловияОферт.ДатаВыкупа >= &НачалоПериода
			|	И УсловияОферт.ТипОферты В (ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно), ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПродажа), ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ДопОферта))");
		
		Запрос.УстановитьПараметр("Облигация", 		Облигация);
		Запрос.УстановитьПараметр("НачалоПериода", 	НачалоПериода);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ДатаВыкупа; 	
		КонецЕсли;
		      		
	КонецЕсли;
		
	Возврат Неопределено;	
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПечатныеФормы(ДанныеДляПечати, ОбщиеДанные)
		
	Для Каждого СтрокаБрокера Из ДанныеДляПечати Цикл		
		
		Если СтрокаБрокера.ЭтоГПБ Тогда
			ШапкаБланка = РаботаСОтчетами.ПолучитьШапкуОфициальногоБланкаОрганизации(ОбщиеДанные.ОрганизацияСсылка, ОбщиеДанные.ДатаЗаявления);
			СтрокаБрокера.ТабличныйДокумент.Вывести(ШапкаБланка);
		КонецЕсли;
		
		ОбластьШапка  = СтрокаБрокера.Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = СтрокаБрокера.Макет.ПолучитьОбласть("Строка");
		
		Если ОбщиеДанные.ДатаЗаявления < Дата(2024, 11, 19) Тогда
			ОбластьПодвал = СтрокаБрокера.Макет.ПолучитьОбласть("ПодвалДо20241911");
		Иначе
			ОбластьПодвал = СтрокаБрокера.Макет.ПолучитьОбласть("Подвал");
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(ОбщиеДанные);
		СтрокаБрокера.ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Для Каждого СтрокаКлиента Из СтрокаБрокера.Клиенты Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаКлиента.НаименованиеВладельцаДляДокументов) Тогда
				ТекстСообщения = "Наименование владельца для документов не заполнено в договоре: "
					+ СтрокаКлиента.НомерДоговора + " от " + Формат(СтрокаКлиента.ДатаЗаключения, "ДФ=dd.MM.yyyy");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаКлиента.ОсновнойБрокерскийДоговор);
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаКлиента);
			
			Если СтрокаБрокера.ЭтоГПБ Тогда
				ОбластьСтрока.Параметры.ДатаДоговора 		= Формат(СтрокаКлиента.ДатаЗаключения, "ДЛФ=D");
				ОбластьСтрока.Параметры.ТекстДУ				= СокрЛП(СтрокаКлиента.НаименованиеВладельцаДляДокументов);
				ОбластьСтрока.Параметры.КоличествоПрописью 	= СокрЛП(ЧислоПрописью(СтрокаКлиента.Количество,, ",,,ж,,,,ж,0"));
			Иначе
				ОбластьСтрока.Параметры.ДатаДоговора 		= Формат(СтрокаКлиента.ДатаЗаключения,"ДЛФ=DD");
			КонецЕсли; 	
			
			СтрокаБрокера.ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Заполнить(ОбщиеДанные);
		
		Если СтрокаБрокера.ЭтоГПБ Тогда
			ОбластьПодвал.Параметры.ОбщееКоличество		= СтрокаБрокера.ОбщееКоличество;
			ОбластьПодвал.Параметры.КоличествоПрописью 	= СокрЛП(ЧислоПрописью(СтрокаБрокера.ОбщееКоличество,,",,,ж,,,,ж,0")); 
		КонецЕсли;
		
		СтрокаБрокера.ТабличныйДокумент.Вывести(ОбластьПодвал);		
		
		СтрокаБрокера.ТабличныйДокумент.ТолькоПросмотр		= Истина;
		СтрокаБрокера.ТабличныйДокумент.ОтображатьЗаголовки	= Ложь;
		СтрокаБрокера.ТабличныйДокумент.ОтображатьСетку		= Ложь;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьДанныеПоКлиентам(ДанныеДляБрокеров, Организация, Дата, БрокерБК, БрокерГПБ)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКлиентов.КодИнвестиционногоСчета КАК КодИнвестиционногоСчета,
		|	ТаблицаКлиентов.Количество КАК Количество,
		|	ТаблицаКлиентов.Брокер КАК Брокер
		|ПОМЕСТИТЬ _ТаблицаКлиентов
		|ИЗ
		|	&ТаблицаКлиентов КАК ТаблицаКлиентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойБрокер КАК Брокер,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойБрокерскийДоговор.НомерДоговора КАК НомерДоговора,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойБрокерскийДоговор.ДатаЗаключения КАК ДатаЗаключения,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойБрокерскийДоговор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
		|	СтратегииИндивидуальногоИнвестирования.ОсновнойКодУБрокера КАК КодУБрокера,
		|	_ТаблицаКлиентов.Количество КАК Количество
		|ПОМЕСТИТЬ _ОбщиеДанные
		|ИЗ
		|	Справочник.СтратегииИндивидуальногоИнвестирования КАК СтратегииИндивидуальногоИнвестирования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаКлиентов КАК _ТаблицаКлиентов
		|		ПО СтратегииИндивидуальногоИнвестирования.ОсновнойБрокер = _ТаблицаКлиентов.Брокер
		|			И СтратегииИндивидуальногоИнвестирования.ОсновнойКодУБрокера = _ТаблицаКлиентов.КодИнвестиционногоСчета
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НаименованиеВладельцаДляДокументов,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код,
		|	_ТаблицаКлиентов.Количество
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&Дата, Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаКлиентов КАК _ТаблицаКлиентов
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер = _ТаблицаКлиентов.Брокер
		|			И КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код = _ТаблицаКлиентов.КодИнвестиционногоСчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщиеДанные.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
		|	_ОбщиеДанные.НомерДоговора КАК НомерДоговора,
		|	_ОбщиеДанные.ДатаЗаключения КАК ДатаЗаключения,
		|	_ОбщиеДанные.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
		|	_ОбщиеДанные.КодУБрокера КАК КодУБрокера,
		|	_ОбщиеДанные.Количество КАК Количество
		|ПОМЕСТИТЬ _ДанныеДляБК
		|ИЗ
		|	_ОбщиеДанные КАК _ОбщиеДанные
		|ГДЕ
		|	_ОбщиеДанные.Брокер = &БрокерБК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщиеДанные.ОсновнойБрокерскийДоговор КАК ОсновнойБрокерскийДоговор,
		|	_ОбщиеДанные.НомерДоговора КАК НомерДоговора,
		|	_ОбщиеДанные.ДатаЗаключения КАК ДатаЗаключения,
		|	_ОбщиеДанные.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
		|	_ОбщиеДанные.КодУБрокера КАК КодУБрокера,
		|	_ОбщиеДанные.Количество КАК Количество
		|ПОМЕСТИТЬ _ДанныеДляГПБ
		|ИЗ
		|	_ОбщиеДанные КАК _ОбщиеДанные
		|ГДЕ
		|	_ОбщиеДанные.Брокер = &БрокерГПБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ДанныеДляБК.Количество) КАК Количество
		|ПОМЕСТИТЬ _КоличествоБК
		|ИЗ
		|	_ДанныеДляБК КАК _ДанныеДляБК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ДанныеДляГПБ.Количество) КАК Количество
		|ПОМЕСТИТЬ _КоличествоГПБ
		|ИЗ
		|	_ДанныеДляГПБ КАК _ДанныеДляГПБ");
	
	Запрос.УстановитьПараметр("ТаблицаКлиентов",	ДанныеДляБрокеров);
	Запрос.УстановитьПараметр("Дата",				Дата);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("БрокерГПБ",          БрокерГПБ);
	Запрос.УстановитьПараметр("БрокерБК",          	БрокерБК);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Выполнить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеДляБК", 
			Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДанныеДляБК").ПолучитьДанные().Выгрузить());
		
	Результат.Вставить("ДанныеДляГПБ", 
			Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ДанныеДляГПБ").ПолучитьДанные().Выгрузить());	
			
	Результат.Вставить("ОбщееКоличествоБК", 
			Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_КоличествоБК").ПолучитьДанные().Выгрузить().Итог("Количество"));		
			
	Результат.Вставить("ОбщееКоличествоГПБ", 
			Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_КоличествоГПБ").ПолучитьДанные().Выгрузить().Итог("Количество"));				
			
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбщиеДанные(Облигация, Организация, Дата, ДатаЗаявления, ПараметрыОтветственного)
	
	ОбщиеДанные = Новый Структура("Эмитент,Тип,ГосударственныйРегистрационныйНомер,ДатаРегистрации,Серия,Валюта,ДатаВыкупа,Номинал");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Облигации.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, """") КАК Эмитент,
		|	Облигации.Тип КАК Тип,
		|	Облигации.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	Облигации.ВалютаНоминала.ПараметрыПрописиНаРусском КАК ПараметрыПрописиВалютыНаРусском,
		|	Облигации.ДатаРегистрации КАК ДатаРегистрации,
		|	Облигации.СерияВыпуска КАК СерияВыпуска,
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	УсловияОферт.Цена КАК Номинал,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК Организация
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&Дата,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО Облигации.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ПО (Облигации.Ссылка = &Облигация)
		|			И (Облигации.Ссылка = УсловияОферт.Облигация)
		|			И (УсловияОферт.ДатаВыкупа = &Дата),
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
				
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("Облигация", 		Облигация);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ОбщиеДанные, Выборка);
				
		ЗапятаяДо 	 = СтрНайти(Выборка.ПараметрыПрописиВалютыНаРусском, ",",,,2);
		ЗапятаяПосле = СтрНайти(Выборка.ПараметрыПрописиВалютыНаРусском, ",",,,3);
		
		ОбщиеДанные.Вставить("ДатаРегистрации",				Формат(Выборка.ДатаРегистрации, "ДЛФ=D"));		
		ОбщиеДанные.Вставить("ДатаОферты",					Формат(Дата, "ДЛФ=D"));		
		ОбщиеДанные.Вставить("ДатаЗаявления", 				ДатаЗаявления);
		ОбщиеДанные.Вставить("ДатаЗаявленияФормат",			Формат(ДатаЗаявления, "ДЛФ=DD"));
		ОбщиеДанные.Вставить("Организация",					Выборка.Организация);
		ОбщиеДанные.Вставить("ОрганизацияСсылка",			Организация);
		ОбщиеДанные.Вставить("Валюта",						СокрЛП(Сред(Выборка.ПараметрыПрописиВалютыНаРусском, ЗапятаяДо + 1, ЗапятаяПосле - ЗапятаяДо - 1)));
		ОбщиеДанные.Вставить("Ответственный",				ПараметрыОтветственного.Ответственный);
		ОбщиеДанные.Вставить("ДолжностьОтветственного",		ПараметрыОтветственного.ДолжностьОтветственного);
		ОбщиеДанные.Вставить("ОснованиеПолномочий",			ПараметрыОтветственного.ОснованиеПолномочий);
		ОбщиеДанные.Вставить("НомерОферты", 				Формат(ДатаЗаявления, "ДФ=ddMMyy"));
		ОбщиеДанные.Вставить("СерияВыпуска", 				Выборка.СерияВыпуска);
		
		Возврат ОбщиеДанные;
		
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции	

&НаСервере
Процедура ПечатьНаСервере(ЗаявлениеДляБК, ЗаявлениеДляГПБ)
		
	КолонкаБрокера = Результат.НайтиТекст("Брокер",,,, Истина); 
	
	Если КолонкаБрокера = Неопределено Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены данные для печати");
		Возврат;		
	КонецЕсли;
	
	ДанныеДляБрокеров = Новый ТаблицаЗначений;
	
	ДанныеДляБрокеров.Колонки.Добавить("КодИнвестиционногоСчета", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ДанныеДляБрокеров.Колонки.Добавить("Количество", 			  Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 0)));
	ДанныеДляБрокеров.Колонки.Добавить("Брокер", 				  Новый ОписаниеТипов("СправочникСсылка.БрокерскиеКомпании"));
	
	НомерКолонкиБрокера 	= КолонкаБрокера.Право;
	НомерПервойСтрокиДанных = КолонкаБрокера.Низ + 1;
	
	КолонкаСчетаДУ		= Результат.НайтиТекст("Счет доверительного управления",,,, Истина); 
	КолонкаКодаСчета 	= Результат.НайтиТекст("Номер инвестиционного счета",,,, Истина); 
	КолонкаКоличества 	= Результат.НайтиТекст("Количество облигаций",,,, Истина); 
	
	Если КолонкаСчетаДУ = Неопределено Или КолонкаКодаСчета = Неопределено Или КолонкаКоличества = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены данные для печати");
		Возврат;
	КонецЕсли;

	НомерКолонкиСчетаДУ		= КолонкаСчетаДУ.Право;
	НомерКолонкиКодаСчета	= КолонкаКодаСчета.Право;
	НомерКолонкиКоличества	= КолонкаКоличества.Право;
	
	// Собираем таблицу с данными. 
	// Последнюю строку не учитываем - в ней итоги
	Для Сч = НомерПервойСтрокиДанных По Результат.ВысотаТаблицы - 1 Цикл
				
		КодИнвестиционногоСчета 	= Результат.Область(Сч, НомерКолонкиКодаСчета, Сч, НомерКолонкиКодаСчета).Текст; 
		Брокер 						= Результат.Область(Сч, НомерКолонкиБрокера, Сч, НомерКолонкиБрокера).Текст; 
		СчетДУ 						= Результат.Область(Сч, НомерКолонкиСчетаДУ, Сч, НомерКолонкиСчетаДУ).Текст; 
		Количество 					= Число(СтрЗаменить(Результат.Область(Сч,НомерКолонкиКоличества, Сч, НомерКолонкиКоличества).Текст, " ", ""));		
		
		Если Брокер = "ГПБ" Или Брокер = "БК РЕГИОН" Тогда
			НоваяСтрока = ДанныеДляБрокеров.Добавить();
		Иначе
			Продолжить;
		КонецЕсли;
		
		ПозицияПодчеркивания = СтрНайти(КодИнвестиционногоСчета, "_");
		Если ПозицияПодчеркивания > 0 Тогда
			КодИнвестиционногоСчета = Лев(КодИнвестиционногоСчета, ПозицияПодчеркивания - 1);
		КонецЕсли;
		
		НоваяСтрока.Брокер 							= ?(Брокер = "ГПБ", ЭтаФорма.БрокерГПБ, ЭтаФорма.БрокерБК);		
		НоваяСтрока.КодИнвестиционногоСчета 		= КодИнвестиционногоСчета;
		НоваяСтрока.Количество 						= Количество;
				
	КонецЦикла;
	
	ДанныеДляБрокеров.Свернуть("КодИнвестиционногоСчета, Брокер", "Количество");
	СтруктураДанныхДляБрокеров	= ПодготовитьДанныеПоКлиентам(ДанныеДляБрокеров, Отчет.Организация, ЭтаФорма.ДатаОферты, БрокерБК, БрокерГПБ);	
	
	ДанныеДляПечати = Новый Массив;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Отчет");
	
	СтрокаСвойств = "Брокер, Клиенты, Макет, ТабличныйДокумент, ЭтоГПБ, ОбщееКоличество";
	Если СтруктураДанныхДляБрокеров.ДанныеДляБК.Количество() > 0 Тогда
		
		ДанныеДляПечати.Добавить(
			Новый Структура(СтрокаСвойств, 
		    	БрокерБК,
				СтруктураДанныхДляБрокеров.ДанныеДляБК, 
				ОбработкаОбъект.ПолучитьМакет("ФормаБКРегион"),
				ЗаявлениеДляБК,
				Ложь, 
				СтруктураДанныхДляБрокеров.ОбщееКоличествоБК));	
		
	КонецЕсли;
	
	Если СтруктураДанныхДляБрокеров.ДанныеДляГПБ.Количество() > 0 Тогда
		
		ДанныеДляПечати.Добавить(
			Новый Структура(СтрокаСвойств, 
		    	БрокерГПБ,
				СтруктураДанныхДляБрокеров.ДанныеДляГПБ, 
				ОбработкаОбъект.ПолучитьМакет("ФормаГПБ"),
				ЗаявлениеДляГПБ,
				Истина,
				СтруктураДанныхДляБрокеров.ОбщееКоличествоГПБ));	
		
	КонецЕсли;
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);

	Если СтруктураДанныхКонтактногоЛица <> Неопределено Тогда
		
		ПараметрыОтветственного = Новый Структура;
		ПараметрыОтветственного.Вставить("Ответственный", 			СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);		
		ПараметрыОтветственного.Вставить("ДолжностьОтветственного", СтруктураДанныхКонтактногоЛица.Должность);
		
		Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий) И ЭтотОбъект.ДатаЗаявления < Дата(2024, 11, 19) Тогда
			ПараметрыОтветственного.Вставить("ОснованиеПолномочий", "На основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий);
		Иначе
			ПараметрыОтветственного.Вставить("ОснованиеПолномочий", СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий);
		КонецЕсли;
		
	Иначе	
		
		ПараметрыОтветственного = Новый Структура("Ответственный, ДолжностьОтветственного, ОснованиеПолномочий")	
		
	КонецЕсли; 
	
	Если ДанныеДляПечати.Количество() > 0 Тогда
		ЗаполнитьПечатныеФормы(ДанныеДляПечати, ОбщиеДанные(Отчет.Облигация, Отчет.Организация, ДатаОферты, ДатаЗаявления, ПараметрыОтветственного));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(ТабличныйДокумент, СтрокаИмени)
	
	Попытка 
		ИмяФайла = КаталогВременныхФайлов() + "\" + СтрокаИмени + " от " + Формат(ДатаЗаявления, "ДФ=dd.MM.yyyy") + ".docx";
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.DOCX);			
		ЗапуститьПриложение(ИмяФайла);
	Исключение 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	Если ТипЗнч(Результат.ВыделенныеОбласти) = Тип("ВыделенныеОбластиТабличногоДокумента") Тогда
		ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.2);
		ПодключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииОбластиПодключаемый", ИнтервалОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизацииОбластиПодключаемый()
	
	НеобходимоВычислятьНаСервере = Ложь;
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		ПолеСумма, Результат, КэшВыделеннойОбласти, НеобходимоВычислятьНаСервере);
	
	Если НеобходимоВычислятьНаСервере Тогда
		ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервереРезультат();
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииОбластиПодключаемый");
	
КонецПроцедуры

&НаСервере
Функция ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(Знач Результат, КэшВыделеннойОбласти) Экспорт
	
	Сумма = 0;
	Для Каждого КлючИЗначение Из КэшВыделеннойОбласти Цикл
		СтруктураАдресВыделеннойОбласти = КлючИЗначение.Значение;
		Для ИндексСтрока = СтруктураАдресВыделеннойОбласти.Верх По СтруктураАдресВыделеннойОбласти.Низ Цикл
			Для ИндексКолонка = СтруктураАдресВыделеннойОбласти.Лево По СтруктураАдресВыделеннойОбласти.Право Цикл
				Попытка
					Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка, ИндексСтрока, ИндексКолонка);
					Если Ячейка.Видимость = Истина Тогда
						Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
							Сумма = Сумма + Ячейка.Значение;
						ИначеЕсли ЗначениеЗаполнено(Ячейка.Текст) Тогда
							Сумма = Сумма + Число((СтрЗаменить(Ячейка.Текст, " ", "")));
						КонецЕсли;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	КэшВыделеннойОбласти.Вставить("Сумма", Сумма);
	
	Возврат Сумма;
	
КонецФункции

&НаСервере
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервереРезультат()
	
	ПолеСумма = ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		Результат, КэшВыделеннойОбласти);
	
КонецПроцедуры
	
&НаКлиенте
Процедура КопироватьДанныеВБуферОбмена(Команда)
	
	Если ЭтаФорма.Результат.ВысотаТаблицы = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для копирования в буфер обмена.");
		Возврат;
	КонецЕсли;
	
	ЧисловыеПоля = РаботаСКоллекциями.ЗначенияВМассив(14, 15, 16, 18, 19, 20, 21, 22, 23);
	ЧисловыеПоля.Добавить(24);
	ЧисловыеПоля.Добавить(29);
	
	ТекстВБуфер = "";
	
	Для НомерСтроки = 2 По ЭтаФорма.Результат.ВысотаТаблицы Цикл 
		
		МассивЗначенийСтроки = Новый Массив;
		
		Для НомерКолонки = 1 По ЭтаФорма.Результат.ШиринаТаблицы Цикл
			
			ЗначениеЯчейки = ЭтаФорма.Результат.Область(НомерСтроки, НомерКолонки).Текст;
			
			Если ЧисловыеПоля.Найти(НомерКолонки) <> Неопределено И ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
				ЗначениеЯчейки = СтрЗаменить(ЗначениеЯчейки, Символ(160), "");
			КонецЕсли;	
			
			МассивЗначенийСтроки.Добавить(ЗначениеЯчейки);
			
		КонецЦикла;
		
		ТекстВБуфер = ТекстВБуфер + СтрСоединить(МассивЗначенийСтроки, Символы.Таб) + Символы.ПС;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстВБуфер) Тогда
		ТекстВБуфер = Лев(ТекстВБуфер, СтрДлина(ТекстВБуфер) - 1);
	КонецЕсли;	
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ТекстВБуфер));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данные скопированы в буфер обмена.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
