
#Область Универсальные_механизмы

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ); 	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	КонецЕсли; 

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// Удаление пустых строк
	ИндексСтроки = ЭтотОбъект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		
		СтрокаДенежныеСредства = ЭтотОбъект.ОстаткиДенежныхСредствНаРасчетныхСчетах[ИндексСтроки];
		
		Если СтрокаДенежныеСредства.Сумма = 0 или НЕ ЗначениеЗаполнено(СтрокаДенежныеСредства.РасчетныйСчет) Тогда
			  ЭтотОбъект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Удалить(ИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки - 1;
		
	КонецЦикла;
	
	ИндексСтроки = ЭтотОбъект.ОстаткиПрочихАктивов.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		
		СтрокаПрочийАктив = ЭтотОбъект.ОстаткиПрочихАктивов[ИндексСтроки];
		
		Если СтрокаПрочийАктив.Сумма = 0 или НЕ ЗначениеЗаполнено(СтрокаПрочийАктив.Актив)  Тогда
			  ЭтотОбъект.ОстаткиПрочихАктивов.Удалить(ИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки - 1;
		
	КонецЦикла;  
	
	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;  
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда 
		
		Если ЗначениеЗаполнено(ЭтотОбъект.СвязаннаяКорректировка) Тогда
			// Нельзя к одной корректировке регистров привязать несколько вводов остатков - иначе это приведет к задвоению проводок.
			Запрос = Новый Запрос();
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВводОстатковАктивовСтраховыхКомпаний.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ВводОстатковАктивовСтраховыхКомпаний КАК ВводОстатковАктивовСтраховыхКомпаний
			|ГДЕ
			|	ВводОстатковАктивовСтраховыхКомпаний.СвязаннаяКорректировка = &СвязаннаяКорректировка
			|	И ВводОстатковАктивовСтраховыхКомпаний.Ссылка <> &Ссылка
			|	И ВводОстатковАктивовСтраховыхКомпаний.Проведен = ИСТИНА
			|	И ВводОстатковАктивовСтраховыхКомпаний.ПометкаУдаления = ЛОЖЬ";
			
			Запрос.УстановитьПараметр("СвязаннаяКорректировка", ЭтотОбъект.СвязаннаяКорректировка);
			Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
			
			ВыборкаДокументы = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаДокументы.Следующий() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно провести документ. Связанная корректировка привязана к другому вводу остатков СК", ВыборкаДокументы.Ссылка,,, Отказ);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;	
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация", 					ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	
	//ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.НоминалыДепозитныхВкладов");
	//ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	//ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);


	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиПрочихАктивов");
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	

	БлокировкаДанных.Заблокировать();

	
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;

	УстановитьБлокировки();
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	// Если установлен связанный документ, то сам док-т Ввод остатков не оставляет движений потому, что служит только для формирования проводок
	// по регистрам ЕПС. (Режим БДЖ)     	

	Если ФормироватьНачальныеОстатки = Ложь и НЕ ЗначениеЗаполнено(ЭтотОбъект.СвязаннаяКорректировка) Тогда	

		// регистр ОстаткиДенежныхСредств Приход
		Движения.ОстаткиДенежныхСредств.Записывать = Истина;
		Для Каждого ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах Из ОстаткиДенежныхСредствНаРасчетныхСчетах Цикл
			
			Если ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.Сумма <> 0 Тогда		
				
				Движение = Движения.ОстаткиДенежныхСредств.Добавить();			
				Движение.Период = Дата;
				Движение.Организация = Организация;
				Движение.СчетДоверительногоУправления = СчетДоверительногоУправления;
				Движение.Брокер = ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.Брокер;
				Движение.МестоХранения = ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.МестоХранения;
				Движение.РасчетныйСчет = ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.РасчетныйСчет;
				Движение.Валюта = ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.Валюта;
				Движение.Сумма = МатематическиеФункции.МодульЧисла(ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.Сумма);
				Движение.Регистратор = ЭтотОбъект.Ссылка;
				
				
				Если ТекСтрокаОстаткиДенежныхСредствНаРасчетныхСчетах.Сумма < 0 Тогда
					Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств;
					Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы; 				
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;

				Иначе
					Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств;
					Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы;				
					Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;

		Движения.ОстаткиПрочихАктивов.Записывать = Истина;
		Для Каждого ТекСтрокаОстаткиПрочихАктивов Из ОстаткиПрочихАктивов Цикл 
					
			Если ТекСтрокаОстаткиПрочихАктивов.Сумма <> 0 Тогда	
				Движение = Движения.ОстаткиПрочихАктивов.Добавить();
				Движение.Период = Дата;
				Движение.Организация = Организация;
				Движение.СчетДоверительногоУправления = СчетДоверительногоУправления;
				Движение.Актив = ТекСтрокаОстаткиПрочихАктивов.Актив;
				Движение.Субъект = ТекСтрокаОстаткиПрочихАктивов.СубъектПрочегоАктива;
				Движение.Валюта = ТекСтрокаОстаткиПрочихАктивов.Валюта;
				Движение.Количество = МатематическиеФункции.МодульЧисла(ТекСтрокаОстаткиПрочихАктивов.Количество);
				Движение.Сумма = МатематическиеФункции.МодульЧисла(ТекСтрокаОстаткиПрочихАктивов.Сумма); 
				Если ТекСтрокаОстаткиПрочихАктивов.Сумма < 0 Тогда
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Иначе  			
					Движение.ВидДвижения = ВидДвиженияНакопления.Приход; 	
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	// Если не выбрано основание операции, а в одном или нескольких поручений имеются ссылки на данный документ, нужно зачистить табличную часть
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ОснованиеОперации) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВходящийДокумент.Ссылка КАК Поручение
			|ИЗ
			|	Документ.ВходящийДокумент КАК ВходящийДокумент
			|ГДЕ
			|	ВходящийДокумент.Операции.Операция = &Операция";
		
		Запрос.УстановитьПараметр("Операция", ЭтотОбъект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		//  Поручение = Документы.ВходящийДокумент.ПустаяСсылка();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 			
			
			Поручение = ВыборкаДетальныеЗаписи.Поручение.ПолучитьОбъект();
			ТабличнаяЧастьПоручения = Поручение.Операции;
			ПараметрыПоиска = Новый Структура();
			ПараметрыПоиска.Вставить("Операция", ЭтотОбъект.Ссылка);
			
			Операции = ТабличнаяЧастьПоручения.НайтиСтроки(ПараметрыПоиска);
			Для	Каждого Операция из Операции Цикл		
				ТабличнаяЧастьПоручения.Удалить(Операция);			
				Поручение.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;			 

		КонецЦикла;
	Иначе
		
		ДокументОснование = ЭтотОбъект.ОснованиеОперации.ПолучитьОбъект();
		
		ОперацииДокументаОснования = ДокументОснование.Операции;
		
		Если ОперацииДокументаОснования.Найти(ЭтотОбъект.Ссылка, "Операция") = Неопределено Тогда
			ОперацииДокументаОснования.Добавить().Операция = ЭтотОбъект.Ссылка;
			ДокументОснование.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли; 		
		
	КонецЕсли;
	


КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
 	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	// Безналичные дс на расчетных счетах
	
	Для Каждого СтрокаОстаткиДС из ОстаткиДенежныхСредствНаРасчетныхСчетах Цикл
		
		СуммаПроводки = ?(ФормироватьНачальныеОстатки, СтрокаОстаткиДС.ВходящийОстаток, СтрокаОстаткиДС.Сумма);
	
		Если СуммаПроводки <> 0 Тогда
			
			СуммаПроводкиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПроводки, СтрокаОстаткиДС.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
			ЭтоВыводДС = (СуммаПроводки < 0);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку
			(
					ЭтотОбъект, 
					Движения.ЕдиныйБухгалтерскийУчет, 
					МатематическиеФункции.МодульЧисла(СуммаПроводкиВВалютеУчета), 
					?(ЭтоВыводДС,
						"Вывод денежных средств (ввод остатков СК)",
						"Ввод денежных средств (ввод остатков СК)")
			);
			ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВводДенежныхСредств;
			Если (ЭтоВыводДС) Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВыводДенежныхСредств;
				
				// Тип движения = ПрочиеВыводы
				// Безналичные расчеты при выводе дс с расчетного счета
				//до 19.09 Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				//Проводка.СубконтоДт.Контрагенты = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
			
				Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				
				Если СтрокаОстаткиДС.РасчетныйСчет.Банк.ЮрФизЛицо = Справочники.ЮрФизЛица.ПустаяСсылка() Тогда
					 Проводка.СчетКт = ПланыСчетов.Единый.РасчетныеСчета01;
				Иначе 
					Если Справочники.Банки.ЯвляетсяРезидентом(СтрокаОстаткиДС.РасчетныйСчет.Банк, Дата) Тогда
						Проводка.СчетКт = ПланыСчетов.Единый.РасчетныеСчета01;
					Иначе
						Проводка.СчетКт = ПланыСчетов.Единый.РасчетныеСчета02;
					КонецЕсли;
				КонецЕсли;
				Проводка.СубконтоКт.БанковскиеСчета = СтрокаОстаткиДС.РасчетныйСчет;
				Проводка.ВалютаКт = СтрокаОстаткиДС.Валюта;
				Проводка.ВалютнаяСуммаКт = МатематическиеФункции.МодульЧисла(СуммаПроводки);
				Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
			Иначе
				
				Если СтрокаОстаткиДС.Брокер = Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
					
					Если СтрокаОстаткиДС.РасчетныйСчет.Банк.ЮрФизЛицо = Справочники.ЮрФизЛица.ПустаяСсылка() Тогда
						Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета01;
					Иначе					
						Если Справочники.Банки.ЯвляетсяРезидентом(СтрокаОстаткиДС.РасчетныйСчет.Банк,Дата) Тогда
							Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета01;
						Иначе
							Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета02;
						КонецЕсли;              					
					КонецЕсли;

					Проводка.СубконтоДт.БанковскиеСчета = СтрокаОстаткиДС.РасчетныйСчет; 					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Единый.РасчетыСБрокерами02;
					Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, СтрокаОстаткиДС.Брокер, ЭтотОбъект.Дата);
						
				КонецЕсли;
				Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
				Проводка.ВалютаДт = СтрокаОстаткиДС.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаПроводки;
				
				// кредит

				//Проводка.СчетКт = ПланыСчетов.Единый.Расчеты22;
				//Проводка.СубконтоКт.Контрагенты = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
							
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления; 
				
			КонецЕсли;		
		КонецЕсли;  
	КонецЦикла;     	
	
	// Прочие активы
	
	Для каждого СтрокаПрочийАктив из ОстаткиПрочихАктивов Цикл
		ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления;
		
		СуммаПроводкиПрочегоАктива = ?(ФормироватьНачальныеОстатки,СтрокаПрочийАктив.ВходящийОстаток, СтрокаПрочийАктив.Сумма);
				
		Если СуммаПроводкиПрочегоАктива <> 0 и ЗначениеЗаполнено(СтрокаПрочийАктив.УчетныйАктивЕПС) Тогда
			
			СуммаПроводкиПрочегоАктиваВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПроводкиПрочегоАктива, СтрокаПрочийАктив.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);

			ЭтоВыводПрочегоАктива = (СуммаПроводкиПрочегоАктива < 0);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку
			(
					ЭтотОбъект, 
					Движения.ЕдиныйБухгалтерскийУчет, 
					МатематическиеФункции.МодульЧисла(СуммаПроводкиПрочегоАктиваВВалютеУчета), 
					?(ЭтоВыводПрочегоАктива,
						"Вывод прочих активов (ввод остатков СК)",
						"Ввод прочих активов (ввод остатков СК)")
			);

			Если (ЭтоВыводПрочегоАктива) Тогда 
				 ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;
				 Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
				 Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
						  
				 Проводка.СчетКт = СтрокаПрочийАктив.УчетныйАктивЕПС.СчетУчета;
				 Проводка.ВалютаКт = СтрокаПрочийАктив.Валюта;
				 Проводка.ВалютнаяСуммаКт = СуммаПроводкиПрочегоАктива;
				 
				ЕстьСубконтоПрочийАктив = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ПрочиеАктивы) <> Неопределено);
				Если ЕстьСубконтоПрочийАктив  Тогда
					Проводка.СубконтоКт.ПрочиеАктивы = СтрокаПрочийАктив.Актив; 					
				КонецЕсли;
					
				ЕстьСубконтоВидыДвижения = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено);
				Если ЕстьСубконтоВидыДвижения  Тогда
					Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств 					
				КонецЕсли;
					
				ЕстьСубконтоКтКонтрагенты = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
	
				Если ЕстьСубконтоКтКонтрагенты Тогда
					Если  ЗначениеЗаполнено(СтрокаПрочийАктив.СубъектПрочегоАктива) Тогда
						Контрагент = СтрокаПрочийАктив.СубъектПрочегоАктива;
					Иначе 
						Контрагент = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
					КонецЕсли;
					Проводка.СубконтоКт.Контрагенты = Контрагент;
				КонецЕсли;

				ЕстьСубконтоКтДоговоры  = (Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
				Если ЕстьСубконтоКтДоговоры Тогда
					Проводка.СубконтоКт.Договоры =  ЭтотОбъект.СчетДоверительногоУправления;
				КонецЕсли;
			Иначе
				Проводка.СчетДт = СтрокаПрочийАктив.УчетныйАктивЕПС.СчетУчета;				 
				Проводка.ВалютаДт =  СтрокаПрочийАктив.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаПроводкиПрочегоАктива;	
				
				ЕстьСубконтоДтКонтрагенты = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
	
				Если ЕстьСубконтоДтКонтрагенты Тогда
					Если  ЗначениеЗаполнено(СтрокаПрочийАктив.СубъектПрочегоАктива) Тогда
						Контрагент = СтрокаПрочийАктив.СубъектПрочегоАктива;
					Иначе 
						Контрагент = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
					КонецЕсли;
					Проводка.СубконтоДт.Контрагенты = Контрагент;
				КонецЕсли;

				ЕстьСубконтоДтДоговоры  = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры) <> Неопределено);
				Если ЕстьСубконтоДтДоговоры Тогда
					Проводка.СубконтоДт.Договоры =  ЭтотОбъект.СчетДоверительногоУправления;
				КонецЕсли;

				
				ЕстьСубконтоПрочийАктив = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ПрочиеАктивы) <> Неопределено);
				Если ЕстьСубконтоПрочийАктив  Тогда
					Проводка.СубконтоДт.ПрочиеАктивы = СтрокаПрочийАктив.Актив; 					
				КонецЕсли;
				
				ЕстьСубконтоДтВидДвижения = (Проводка.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено);
				Если ЕстьСубконтоДтВидДвижения  Тогда
					Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств; 					
				КонецЕсли;

				
				 Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				 Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
				 
			КонецЕсли;

		КонецЕсли;						
		Если  СуммаПроводкиПрочегоАктива <> 0 и НЕ ЗначениеЗаполнено(СтрокаПрочийАктив.УчетныйАктивЕПС) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Для актива '" + СтрокаПрочийАктив.Актив + "' не определен Учетный актив ЕПС. Проводки не будут сформированы!",?(ЗначениеЗаполнено(ЭтотОбъект.СвязаннаяКорректировка), ЭтотОбъект.СвязаннаяКорректировка, ЭтотОбъект),,, Отказ);

		КонецЕсли;
		
	КонецЦикла;
	
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
		
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереПрочиеАктивы() Экспорт
	
	Запрос = Новый Запрос();
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыПрочихАктивов.Ссылка КАК ВидПрочегоАктива,
	|	ПрочиеАктивы.Ссылка КАК Актив,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.Валюта, Организации.ВалютаУчета) КАК Валюта,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК ВходящийОстаток,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаОборот, 0) КАК СуммаВсего,
	|	ЕСТЬNULL(ОстаткиПрочихАктивовОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК ИсходящийОстаток,
	|	ЕСТЬNULL(ОстаткиПрочихАктивов.Сумма * ВЫБОР
	|			КОГДА ОстаткиПрочихАктивов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА -1
	|			ИНАЧЕ 1
	|		КОНЕЦ, 0) КАК Сумма,
	|	ОстаткиПрочихАктивов.Субъект КАК Субъект,
	|	ОстаткиПрочихАктивов.Количество КАК Количество
	|ПОМЕСТИТЬ _ОстаткиПрочихАктивов
	|ИЗ
	|	РегистрНакопления.ОстаткиПрочихАктивов КАК ОстаткиПрочихАктивов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрочиеАктивы КАК ПрочиеАктивы
	|		ПО ОстаткиПрочихАктивов.Актив = ПрочиеАктивы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыПрочихАктивов КАК ВидыПрочихАктивов
	|		ПО (ПрочиеАктивы.ВидПрочегоАктива = ВидыПрочихАктивов.Ссылка)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (Организации.Ссылка = ОстаткиПрочихАктивов.Организация)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиПрочихАктивов.ОстаткиИОбороты(
	|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|				,
	|				,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиПрочихАктивовОстаткиИОбороты
	|		ПО ОстаткиПрочихАктивов.Актив = ОстаткиПрочихАктивовОстаткиИОбороты.Актив
	|			И ОстаткиПрочихАктивов.Субъект = ОстаткиПрочихАктивовОстаткиИОбороты.Субъект
	|			И ОстаткиПрочихАктивов.Валюта = ОстаткиПрочихАктивовОстаткиИОбороты.Валюта
	|			И ОстаткиПрочихАктивов.Организация = ОстаткиПрочихАктивовОстаткиИОбороты.Организация
	|			И ОстаткиПрочихАктивов.СчетДоверительногоУправления = ОстаткиПрочихАктивовОстаткиИОбороты.СчетДоверительногоУправления
	|ГДЕ
	|	ОстаткиПрочихАктивов.Регистратор = &Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ОстаткиПрочихАктивов.ВидПрочегоАктива КАК ВидПрочегоАктива,
	|	_ОстаткиПрочихАктивов.Актив КАК Актив,
	|	_ОстаткиПрочихАктивов.Субъект КАК СубъектПрочегоАктива,
	|	_ОстаткиПрочихАктивов.Валюта КАК Валюта,
	|	_ОстаткиПрочихАктивов.Количество КАК Количество,
	|	_ОстаткиПрочихАктивов.ВходящийОстаток КАК ВходящийОстаток,
	|	_ОстаткиПрочихАктивов.Сумма КАК Сумма,
	|	_ОстаткиПрочихАктивов.СуммаВсего - _ОстаткиПрочихАктивов.Сумма КАК ПрочиеСумма,
	|	_ОстаткиПрочихАктивов.ИсходящийОстаток КАК ИсходящийОстаток
	|ИЗ
	|	_ОстаткиПрочихАктивов КАК _ОстаткиПрочихАктивов";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);  	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.СвязаннаяКорректировка.Ссылка); 
	
	ВыборкаПрочиеАктивы = Запрос.Выполнить().Выбрать();
	
	ЭтотОбъект.ОстаткиПрочихАктивов.Очистить();
		
	Пока ВыборкаПрочиеАктивы.Следующий() Цикл
		
		НоваяСтрокаПрочийАктив = ЭтотОбъект.ОстаткиПрочихАктивов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПрочийАктив, ВыборкаПрочиеАктивы);
		
	 	Если НЕ ЗначениеЗаполнено(НоваяСтрокаПрочийАктив.УчетныйАктивЕПС) Тогда
			НоваяСтрокаПрочийАктив.УчетныйАктивЕПС = 
				Документы.ВводОстатковАктивовСтраховыхКомпаний.ОпределитьУчетныйПрочийАктивЕПС
					(ЭтотОбъект.Дата, ВыборкаПрочиеАктивы.ВидПрочегоАктива, ВыборкаПрочиеАктивы.Актив);
		КонецЕсли;
		          
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСвязаннуюКорректировкуРегистровНаСервереДенежныеСредства()Экспорт 
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиДенежныхСредств.Брокер КАК Брокер,
	|	ОстаткиДенежныхСредств.МестоХранения КАК МестоХранения,
	|	ОстаткиДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
	|	ОстаткиДенежныхСредств.Валюта КАК Валюта,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК ВходящийОстаток,
	|	ВЫБОР
	|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ * ОстаткиДенежныхСредств.Сумма КАК Сумма,
	|	ЕСТЬNULL(ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот, 0) - ВЫБОР
	|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ * ОстаткиДенежныхСредств.Сумма КАК СуммаПрочие,
	|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК ИсходящийОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
	|				НАЧАЛОПЕРИОДА(&Период, ДЕНЬ),
	|				КОНЕЦПЕРИОДА(&Период, ДЕНЬ),
	|				,
	|				,
	|				Организация = &Организация
	|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстаткиИОбороты
	|		ПО ОстаткиДенежныхСредств.Организация = ОстаткиДенежныхСредствОстаткиИОбороты.Организация
	|			И ОстаткиДенежныхСредств.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления
	|			И ОстаткиДенежныхСредств.РасчетныйСчет = ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет
	|			И ОстаткиДенежныхСредств.Валюта = ОстаткиДенежныхСредствОстаткиИОбороты.Валюта
	|ГДЕ
	|	ОстаткиДенежныхСредств.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата); 	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);  	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.СвязаннаяКорректировка.Ссылка); 

	ВыборкаДенежныеСредства = Запрос.Выполнить().Выбрать();
	
	ЭтотОбъект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Очистить();
		
	Пока ВыборкаДенежныеСредства.Следующий() Цикл
		
		НоваяСтрокаДенежныеСредства = ЭтотОбъект.ОстаткиДенежныхСредствНаРасчетныхСчетах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДенежныеСредства, ВыборкаДенежныеСредства);
		          
	КонецЦикла;

	
КонецПроцедуры
