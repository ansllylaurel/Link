
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.СтрокаБанковскойВыписки 				= ЭтаФорма.Параметры.СтрокаБанковскойВыписки;
	ЭтаФорма.ИмяРеквизитаСтрокиБанковскойВыписки 	= Элементы.ИмяРеквизитаСтрокиБанковскойВыписки.СписокВыбора[0].Значение;
	
	ЗаполнитьРеквизитыСтрокиБанковскойВыпискиНаСервере();
	
	// определим список платежных документов
	СписокПлатежныхДокументов = РаботаСБанковскимиВыпискамиКлиентСервер.ПолучитьСписокПлатежныхДокументов(ЭтаФорма.СтрокаБанковскойВыпискиВидДвижения);
	Если ЭтаФорма.СтрокаБанковскойВыпискиВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход") Тогда
		СписокПлатежныхДокументов.Удалить(
			СписокПлатежныхДокументов.НайтиПоЗначению("Аванс"));
	КонецЕсли;
	
	Для каждого ЭлементСписка Из СписокПлатежныхДокументов Цикл
		ЗаполнитьЗначенияСвойств(Элементы.ИмяПлатежногоДокумента.СписокВыбора.Добавить(), ЭлементСписка);
	КонецЦикла;
	
	ЭтаФорма.ИмяПлатежногоДокумента = СписокПлатежныхДокументов[0].Значение;
	
	ЗаполнитьПлатежныеДокументыНаСервере();    
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
		
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ИмяПлатежногоДокументаПриИзменении(Элемент)
	
	ЗаполнитьПлатежныеДокументыНаСервере();

	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежныеДокументыПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Поле.Имя = "ПлатежныеДокументыОткрыть" Тогда
		ОткрытьЗначение(Элемент.ТекущиеДанные.Ссылка);
	Иначе
		ВыбратьЗначение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежныеДокументыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ПлатежныеДокументы.ТекущиеДанные;   
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ИмяПлатежногоДокумента = "ЗакрытиеКредитногоИнструмента" И ТекущиеДанные.СуммаПроцентов <> 0 И ТекущиеДанные.СуммаПроцентов = СтрокаБанковскойВыпискиСумма Тогда
		ЭтаФорма.ИмяРеквизитаСтрокиБанковскойВыписки = Элементы.ИмяРеквизитаСтрокиБанковскойВыписки.СписокВыбора[1].Значение;
	Иначе
		ЭтаФорма.ИмяРеквизитаСтрокиБанковскойВыписки = Элементы.ИмяРеквизитаСтрокиБанковскойВыписки.СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецПроцедуры   

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ЗаполнитьПлатежныеДокументыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	ВыбратьЗначение();
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаСервере
Процедура ЗаполнитьРеквизитыСтрокиБанковскойВыпискиНаСервере()
	
	РеквизитыСтрокиБанковскойВыписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтаФорма.СтрокаБанковскойВыписки,
		"Организация, НомерПлатежногоДокумента, Дата, ДатаПлатежногоДокумента, ВидДвижения, РасчетныйСчет,"
			+ "Контрагент, РасчетныйСчетКонтрагента, Сумма, НазначениеПлатежа");
	
	Для каждого РеквизитСтрокиБанковскойВыписки Из РеквизитыСтрокиБанковскойВыписки Цикл
		ЭтаФорма["СтрокаБанковскойВыписки" + РеквизитСтрокиБанковскойВыписки.Ключ] = РеквизитСтрокиБанковскойВыписки.Значение;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитыСтрокиБанковскойВыпискиНаСервере

&НаСервере
Процедура ЗаполнитьПлатежныеДокументыНаСервере()
	
	ЭтаФорма.ПлатежныеДокументы.Очистить();
	
	Запрос = Новый Запрос;
	
	Если ЭтаФорма.ИмяПлатежногоДокумента = "ПриходПроцентовМНО" Тогда
		// в отличие от прочих, приход % МНО создается автоматически и хранится
		// непроведенным в плановой дате
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПриходПроцентовМНО.Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(ПриходПроцентовМНО.Ссылка) КАК Представление,
			|	""Открыть"" КАК Открыть,
			|	ПриходПроцентовМНО.СчетДоверительногоУправления,
			|	ПриходПроцентовМНО.Ответственный,
			|	ПриходПроцентовМНО.Сумма
			|ИЗ
			|	Документ.ПриходПроцентовМНО КАК ПриходПроцентовМНО
			|ГДЕ
			|	ПриходПроцентовМНО.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
			|	И ПриходПроцентовМНО.Организация = &Организация
			|	И ПриходПроцентовМНО.РасчетныйСчет = &РасчетныйСчет
			|	И НЕ ПриходПроцентовМНО.ПометкаУдаления";
		
	ИначеЕсли ЭтаФорма.ИмяПлатежногоДокумента = "ЗакрытиеКредитногоИнструмента" Тогда
		
		// У этого документа есть сумма и сумма процентов, получаем отдельно
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗакрытиеКредитногоИнструмента.Ссылка КАК Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(ЗакрытиеКредитногоИнструмента.Ссылка) КАК Представление,
			|	""Открыть"" КАК Открыть,
			|	ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗакрытиеКредитногоИнструмента.Ответственный КАК Ответственный,
			|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма,
			|	СУММА(ЕСТЬNULL(ОстаткиДенежныхСредствПроценты.Сумма, 0)) КАК СуммаПроцентов
			|ИЗ
			|	Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредствПроценты
			|			ПО ОстаткиДенежныхСредств.Регистратор = ОстаткиДенежныхСредствПроценты.Регистратор
			|				И (ОстаткиДенежныхСредствПроценты.ВидДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу), ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоЗаймуВыданному), ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ВыплатаПроцентовПоЗаймуПолученному)))
			|		ПО (ОстаткиДенежныхСредств.Регистратор = ЗакрытиеКредитногоИнструмента.Ссылка)
			|			И (ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада), ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаВыданного), ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаПолученного)))
			|ГДЕ
			|	ЗакрытиеКредитногоИнструмента.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
			|	И ЗакрытиеКредитногоИнструмента.Организация = &Организация
			|	И ОстаткиДенежныхСредств.РасчетныйСчет = &РасчетныйСчет
			|	И ОстаткиДенежныхСредств.ВидДвижения = &ВидДвижения
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗакрытиеКредитногоИнструмента.Ссылка,
			|	ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления,
			|	ЗакрытиеКредитногоИнструмента.Ответственный";	
		
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВводДенежныхСредств.Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(ВводДенежныхСредств.Ссылка) КАК Представление,
			|	""Открыть"" КАК Открыть,
			|	ВводДенежныхСредств.СчетДоверительногоУправления,
			|	ВводДенежныхСредств.Ответственный,
			|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма,
			|	0 КАК СуммаПроцентов
			|ИЗ
			|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
			|		ПО (ОстаткиДенежныхСредств.Регистратор = ВводДенежныхСредств.Ссылка)
			|ГДЕ
			|	ВводДенежныхСредств.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
			|	И ВводДенежныхСредств.Организация = &Организация
			|	И ОстаткиДенежныхСредств.РасчетныйСчет = &РасчетныйСчет
			|	И ОстаткиДенежныхСредств.ВидДвижения = &ВидДвижения
			|
			|СГРУППИРОВАТЬ ПО
			|	ВводДенежныхСредств.Ссылка,
			|	ВводДенежныхСредств.СчетДоверительногоУправления,
			|	ВводДенежныхСредств.Ответственный";
			
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВводДенежныхСредств", ЭтаФорма.ИмяПлатежногоДокумента);
						
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",        ЭтаФорма.СтрокаБанковскойВыпискиДата);
	Запрос.УстановитьПараметр("Организация",   ЭтаФорма.СтрокаБанковскойВыпискиОрганизация);
	Запрос.УстановитьПараметр("РасчетныйСчет", ЭтаФорма.СтрокаБанковскойВыпискиРасчетныйСчет);
	Запрос.УстановитьПараметр("ВидДвижения",   РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьВидДвиженияНакопленияПоВидуДвижения(ЭтаФорма.СтрокаБанковскойВыпискиВидДвижения));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.ПлатежныеДокументы.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьПлатежныеДокументыНаСервере

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ИмяРеквизитаСтрокиБанковскойВыписки.Видимость 	= Форма.ИмяПлатежногоДокумента = "ЗакрытиеКредитногоИнструмента";
	Элементы.ПлатежныеДокументыСуммаПроцентов.Видимость 	= Форма.ИмяПлатежногоДокумента = "ЗакрытиеКредитногоИнструмента";
	
КонецПроцедуры 
 
&НаКлиенте
Процедура ВыбратьЗначение()
	
	ТекущиеДанные = Элементы.ПлатежныеДокументы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбДанные = Новый Структура("ИмяДокумента, Ссылка, ИмяРеквизитаСтрокиБанковскойВыписки",
		ЭтаФорма.ИмяПлатежногоДокумента,
		ТекущиеДанные.Ссылка,
		ЭтаФорма.ИмяРеквизитаСтрокиБанковскойВыписки);
	
	ЭтаФорма.Закрыть(ВыбДанные);
	
КонецПроцедуры

#КонецОбласти
