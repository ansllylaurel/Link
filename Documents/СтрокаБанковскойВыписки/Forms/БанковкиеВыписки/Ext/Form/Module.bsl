&НаСервереБезКонтекста
Функция ЗаполнитьРеквизитыОплаты(СтрокаБанковскойВыписки, ХранилищеВыбЗадолженности, ТекстОшибки, ИспользуетсяПредварительнаяВыписка)
	
	ДанныеСтрокиБанковскойВыписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаБанковскойВыписки, "Дата, Организация, ВидДвижения, РасчетныйСчет, Контрагент, РасчетныйСчетКонтрагента, Сумма, ПлатежноеПоручение");
	
	ВыбЗадолженность = ХранилищеВыбЗадолженности.Получить();
	
	ВыбЗадолженность.Колонки.Добавить("РасчетныйСчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	
	// проверим, чтобы среди выбранной задолженности счет д/у и вид задолженности были уникальными
	// заодно заполним контрагента и его р/счет
	ВидЗадолженности             = Неопределено;
	СчетДоверительногоУправления = Неопределено;
	
	РеквизитыОплаты = Новый Структура();
	РеквизитыОплаты.Вставить("Дата",                         НачалоДня(ДанныеСтрокиБанковскойВыписки.Дата));
	РеквизитыОплаты.Вставить("Организация",                  ДанныеСтрокиБанковскойВыписки.Организация);
	РеквизитыОплаты.Вставить("ВидДвижения",                  ДанныеСтрокиБанковскойВыписки.ВидДвижения);
	РеквизитыОплаты.Вставить("ВидЗадолженности",             Неопределено);
	РеквизитыОплаты.Вставить("СчетДоверительногоУправления", Неопределено);
	РеквизитыОплаты.Вставить("МестоХранения",                Справочники.МестаХранения.ВнебиржевойРынок);
	РеквизитыОплаты.Вставить("РасчетныйСчет",                ДанныеСтрокиБанковскойВыписки.РасчетныйСчет);
	РеквизитыОплаты.Вставить("ВалютаОплаты",                 ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтрокиБанковскойВыписки.РасчетныйСчет, "Валюта"));
	РеквизитыОплаты.Вставить("СтрокаБанковскойВыписки",      СтрокаБанковскойВыписки);
	РеквизитыОплаты.Вставить("Основания",                    Новый ХранилищеЗначения(ВыбЗадолженность));
	РеквизитыОплаты.Вставить("Брокер",     	                 Справочники.БрокерскиеКомпании.ПустаяСсылка());
	РеквизитыОплаты.Вставить("Контрагент",     	             Справочники.ЮрФизЛица.ПустаяСсылка());
	РеквизитыОплаты.Вставить("РасчетныйСчетКонтрагента",     Справочники.БанковскиеСчета.ПустаяСсылка());
	РеквизитыОплаты.Вставить("Договор",     				 Справочники.Договоры.ПустаяСсылка());
	РеквизитыОплаты.Вставить("ПлатежноеПоручение",			 ДанныеСтрокиБанковскойВыписки.ПлатежноеПоручение);
	
	РаспределяемаяСумма = Мин(ДанныеСтрокиБанковскойВыписки.Сумма, ВыбЗадолженность.Итог("СуммаВсего"));
	
	Для каждого СтрокаВыбЗадолженность Из ВыбЗадолженность Цикл
		Если      РеквизитыОплаты.ВидЗадолженности = Неопределено Тогда
			РеквизитыОплаты.ВидЗадолженности = СтрокаВыбЗадолженность.ВидЗадолженности;
		ИначеЕсли РеквизитыОплаты.ВидЗадолженности <> СтрокаВыбЗадолженность.ВидЗадолженности Тогда
			ТекстОшибки = "В оплате допустим только один вид задолженности";
			Возврат Неопределено;
		КонецЕсли;
		
		Если      РеквизитыОплаты.СчетДоверительногоУправления = Неопределено Тогда
			РеквизитыОплаты.СчетДоверительногоУправления = СтрокаВыбЗадолженность.СчетДоверительногоУправления;
		ИначеЕсли РеквизитыОплаты.СчетДоверительногоУправления <> СтрокаВыбЗадолженность.СчетДоверительногоУправления Тогда
			ТекстОшибки = "В оплате допустим только один счета доверительного управления";
			Возврат Неопределено;
		КонецЕсли;
		
		Если      РеквизитыОплаты.Контрагент =  Справочники.ЮрФизЛица.ПустаяСсылка() Тогда
			РеквизитыОплаты.Контрагент = СтрокаВыбЗадолженность.Контрагент;
		ИначеЕсли РеквизитыОплаты.Контрагент <> СтрокаВыбЗадолженность.Контрагент Тогда
			ТекстОшибки = "В оплате допустим только один контрагент";
			Возврат Неопределено;
		КонецЕсли;
		
		Если      РеквизитыОплаты.Договор =  Справочники.Договоры.ПустаяСсылка() Тогда
			РеквизитыОплаты.Договор = СтрокаВыбЗадолженность.Договор;
		ИначеЕсли РеквизитыОплаты.Договор <> СтрокаВыбЗадолженность.Договор Тогда
			ТекстОшибки = "В оплате допустим только один договор";
			Возврат Неопределено;
		КонецЕсли;
		
		Если      РеквизитыОплаты.РасчетныйСчетКонтрагента =  Справочники.БанковскиеСчета.ПустаяСсылка() Тогда
			РеквизитыОплаты.РасчетныйСчетКонтрагента = СтрокаВыбЗадолженность.РасчетныйСчетКонтрагента;
		ИначеЕсли РеквизитыОплаты.РасчетныйСчетКонтрагента <> СтрокаВыбЗадолженность.РасчетныйСчетКонтрагента Тогда
			ТекстОшибки = "В оплате допустим только один расчетный счет контрагента";
			Возврат Неопределено;
		КонецЕсли;
		
		Документы.Оплата.ЗаполнитьДанныеКонтрагента(РеквизитыОплаты, СтрокаВыбЗадолженность);

		СтрокаВыбЗадолженность.Сумма		= Мин(СтрокаВыбЗадолженность.Сумма, РаспределяемаяСумма);
		РаспределяемаяСумма 				= РаспределяемаяСумма - СтрокаВыбЗадолженность.Сумма;
		
		СтрокаВыбЗадолженность.СуммаКупона	= Мин(СтрокаВыбЗадолженность.СуммаКупона, РаспределяемаяСумма);
		РаспределяемаяСумма 				= РаспределяемаяСумма - СтрокаВыбЗадолженность.СуммаКупона;
	КонецЦикла;
	
	// Время оплаты
	Документы.СтрокаБанковскойВыписки.ВремяДокументаДвиженияДенежныхСредств(
		ДанныеСтрокиБанковскойВыписки.Дата,
		ИспользуетсяПредварительнаяВыписка,
		?(ДанныеСтрокиБанковскойВыписки.ВидДвижения = Перечисления.ВидыДвижений.Приход, "Приход", "Расход"));
		
	Возврат РеквизитыОплаты;
	
КонецФункции // ЗаполнитьРеквизитыОплаты

