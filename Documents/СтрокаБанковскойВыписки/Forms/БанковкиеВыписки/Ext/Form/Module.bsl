&НаСервереБезКонтекста
Функция ОпределитьОснованиеИДополнитьРеквизиты(ИмяДокумента, РеквизитыПлатежа, Знач НазначениеПлатежа)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Поручение.Ссылка КАК Поручение,
		|	Поручение.НомерВходящегоДокумента КАК НомерПоручения,
		|	Поручение.ДатаВходящегоДокумента КАК ДатаПоручения,
		|	Поручение.КонтрагентДоговорТекстом КАК КонтрагентДоговорТекстом
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = &ТипЗадолженности) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК Поручение
		|		ПО ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание = Поручение.Ссылка
		|			И (Поручение.СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема))
		|			И (Поручение.РасчетныйСчетПолучатель = &РасчетныйСчетПолучатель)
		|			И (Поручение.ДатаИсполненияС <= &ДатаПлатежногоДокумента)
		|			И (Поручение.ДатаИсполненияПо >= &ДатаПлатежногоДокумента)
		|			И (ВЫБОР
		|				КОГДА Поручение.ПоручениеНаПереводМеждуСчетамиДУ
		|						И Поручение.РасчетныйСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.Пустаяссылка)
		|					ТОГДА Поручение.РасчетныйСчет = &РасчетныйСчет
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СуммаОстаток = &Сумма";
	
	Запрос.УстановитьПараметр("Организация", РеквизитыПлатежа.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", РеквизитыПлатежа.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТипЗадолженности", Перечисления.ТипыЗадолженности.Дебиторская);
	Запрос.УстановитьПараметр("РасчетныйСчетПолучатель", РеквизитыПлатежа.РасчетныйСчет);
	Запрос.УстановитьПараметр("РасчетныйСчет", РеквизитыПлатежа.РасчетныйСчетКонтрагента);
	Запрос.УстановитьПараметр("ДатаПлатежногоДокумента", НачалоДня(РеквизитыПлатежа.Дата));
	Запрос.УстановитьПараметр("Сумма", РеквизитыПлатежа.Сумма);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		Пока Выборка.Следующий() Цикл
			
			НазначениеПлатежа = НРег(СтрЗаменить(НазначениеПлатежа, " ", ""));
					
			Если СтрНайти(НазначениеПлатежа, НРег(Выборка.НомерПоручения) + Формат(Выборка.ДатаПоручения, "ДФ='отdd.MM.yyyy'")) > 0
				Или СтрНайти(НазначениеПлатежа, НРег(Выборка.НомерПоручения) + Формат(Выборка.ДатаПоручения, "ДФ='отdd.MM.yy'")) > 0 Тогда
				
				РеквизитыПлатежа.Вставить("Валюта", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыПлатежа.РасчетныйСчет, "Валюта"));
				РеквизитыПлатежа.Вставить("НомерВходящегоДокумента", Выборка.НомерПоручения);
				РеквизитыПлатежа.Вставить("ДатаВходящегоДокумента", Выборка.ДатаПоручения);
				РеквизитыПлатежа.Вставить("КонтрагентДоговорТекстом", Выборка.КонтрагентДоговорТекстом);
								
				Возврат Выборка.Поручение;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
				
		// Добавляем валюту и текст контрагента
		РеквизитыПлатежа.Вставить("Валюта", 					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыПлатежа.РасчетныйСчет, "Валюта"));				
		РеквизитыПлатежа.Вставить("КонтрагентДоговорТекстом", 	РаботаСДокументами.ПолучитьТекстКонтрагентаДляВводовВыводовДенежныхСредств(																	
																	РеквизитыПлатежа.Организация, 
																	РеквизитыПлатежа.Контрагент, 
																	РеквизитыПлатежа.РасчетныйСчетКонтрагента, 
																	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыПлатежа.Организация, "ЮрФизЛицо") = РеквизитыПлатежа.Контрагент, 
																	РеквизитыПлатежа.Дата));
	 
	КонецЕсли;	
		
КонецФункции //ОпределитьОснование

&НаСервере
Процедура ЗаполнитьСтрокиБанковскойВыпискиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументСтрокаБанковскойВыписки.Ссылка КАК Ссылка,
		|	ДокументСтрокаБанковскойВыписки.ВидДвижения КАК ВидДвижения
		|ПОМЕСТИТЬ _ДокументСтрокаБанковскойВыписки
		|ИЗ
		|	Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|ГДЕ
		|	&УсловиеОтбора
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	ВидДвижения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДокументСтрокаБанковскойВыписки.Ссылка КАК Ссылка,
		|	СУММА(РеестрПлатежей.Сумма) КАК СуммаПлатежа,
		|	ВЫБОР
		|		КОГДА АкцептованиеОпераций.Операция ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Акцептовано
		|ПОМЕСТИТЬ _СтрокиБанковскойВыписки
		|ИЗ
		|	_ДокументСтрокаБанковскойВыписки КАК _ДокументСтрокаБанковскойВыписки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций КАК АкцептованиеОпераций
		|		ПО _ДокументСтрокаБанковскойВыписки.Ссылка = АкцептованиеОпераций.Операция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ПО _ДокументСтрокаБанковскойВыписки.Ссылка = РеестрПлатежей.СтрокаБанковскойВыписки
		|			И _ДокументСтрокаБанковскойВыписки.ВидДвижения = РеестрПлатежей.ВидДвижения
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДокументСтрокаБанковскойВыписки.Ссылка,
		|	АкцептованиеОпераций.Операция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтрокиБанковскойВыписки.Ссылка КАК Ссылка,
		|	_СтрокиБанковскойВыписки.Ссылка.Дата КАК Дата,
		|	_СтрокиБанковскойВыписки.Ссылка.НазначениеПлатежа КАК НазначениеПлатежа,
		|	_СтрокиБанковскойВыписки.Акцептовано КАК Акцептовано,
		|	_СтрокиБанковскойВыписки.Ссылка.Контрагент КАК Контрагент,
		|	_СтрокиБанковскойВыписки.Ссылка.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	_СтрокиБанковскойВыписки.Ссылка.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	_СтрокиБанковскойВыписки.Ссылка.РасчетныйСчет КАК РасчетныйСчет,
		|	_СтрокиБанковскойВыписки.Ссылка.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
		|	_СтрокиБанковскойВыписки.Ссылка.Комментарий КАК Комментарий,
		|	_СтрокиБанковскойВыписки.Ссылка.Ответственный КАК Ответственный,
		|	_СтрокиБанковскойВыписки.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
		|	_СтрокиБанковскойВыписки.Ссылка.ВидДвижения КАК ВидДвижения,
		|	_СтрокиБанковскойВыписки.Ссылка.Организация КАК Организация,
		|	_СтрокиБанковскойВыписки.Ссылка.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _СтрокиБанковскойВыписки.Ссылка.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА _СтрокиБанковскойВыписки.Ссылка.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Поступление,
		|	ВЫБОР
		|		КОГДА _СтрокиБанковскойВыписки.Ссылка.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА _СтрокиБанковскойВыписки.Ссылка.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Списание,
		|	ВЫБОР
		|		КОГДА _СтрокиБанковскойВыписки.Ссылка.ПометкаУдаления
		|			ТОГДА 0
		|		КОГДА _СтрокиБанковскойВыписки.Ссылка.Сумма = _СтрокиБанковскойВыписки.СуммаПлатежа
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Картинка
		|ИЗ
		|	_СтрокиБанковскойВыписки КАК _СтрокиБанковскойВыписки
		|ГДЕ
		|	(&Статус = 4
		|			ИЛИ ВЫБОР
		|				КОГДА _СтрокиБанковскойВыписки.Ссылка.ПометкаУдаления
		|					ТОГДА 0
		|				КОГДА _СтрокиБанковскойВыписки.Ссылка.Сумма = _СтрокиБанковскойВыписки.СуммаПлатежа
		|					ТОГДА 1
		|				ИНАЧЕ 2
		|			КОНЕЦ = &Статус)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_СтрокиБанковскойВыписки.Ссылка.МоментВремени";
		
		
	// сформируем условия отбора
	УсловияОтбора = "";
		
	Если ЗначениеЗаполнено(ЭтаФорма.Период.ДатаНачала) Тогда
		УсловияОтбора = УсловияОтбора + Символы.ПС + Символы.Таб + ?(ПустаяСтрока(УсловияОтбора), "", "И ")
			+ "ДокументСтрокаБанковскойВыписки.Дата >= &ДатаНачала"
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтаФорма.Период.ДатаОкончания) Тогда
		УсловияОтбора = УсловияОтбора + Символы.ПС + Символы.Таб + ?(ПустаяСтрока(УсловияОтбора), "", "И ")
			+ "ДокументСтрокаБанковскойВыписки.Дата <= &ДатаОкончания"
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтаФорма.Контрагент) Тогда
		УсловияОтбора = УсловияОтбора + Символы.ПС + Символы.Таб + ?(ПустаяСтрока(УсловияОтбора), "", "И ")
			+ "ДокументСтрокаБанковскойВыписки.Контрагент = &Контрагент"
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.РасчетныйСчет) Тогда
		УсловияОтбора = УсловияОтбора + Символы.ПС + Символы.Таб + ?(ПустаяСтрока(УсловияОтбора), "", "И ")
			+ "ДокументСтрокаБанковскойВыписки.РасчетныйСчет = &РасчетныйСчет"
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.ВидДвижения) Тогда
		УсловияОтбора = УсловияОтбора + Символы.ПС + Символы.Таб + ?(ПустаяСтрока(УсловияОтбора), "", "И ")
			+ "ДокументСтрокаБанковскойВыписки.ВидДвижения = &ВидДвижения"
	КонецЕсли;
	
	Если ПустаяСтрока(УсловияОтбора) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", УсловияОтбора);
	КонецЕсли;
	
	// выполнение запроса
	Запрос.УстановитьПараметр("ДатаНачала",    ЭтаФорма.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтаФорма.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ВидДвижения",   ЭтаФорма.ВидДвижения);
	Запрос.УстановитьПараметр("РасчетныйСчет", ЭтаФорма.РасчетныйСчет);
	Запрос.УстановитьПараметр("Контрагент",    ЭтаФорма.Контрагент);
	Запрос.УстановитьПараметр("Статус",        ?(ЭтаФорма.Статус = 0, 4, ЭтаФорма.Статус - 1));
		
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "СтрокиБанковскойВыписки");	

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокиБанковскойВыписки()
	
	КлючТекущейСтроки = РаботаСФормамиКлиент.ПолучитьКлючТекущейСтроки(Элементы.СтрокиБанковскойВыписки, "Ссылка");
	
	ЗаполнитьСтрокиБанковскойВыпискиНаСервере();
	
	РаботаСФормамиКлиент.ВосстановитьТекущуюСтрокуПоКлючу(ЭтаФорма.СтрокиБанковскойВыписки, ЭтаФорма.Элементы.СтрокиБанковскойВыписки, "Ссылка", КлючТекущейСтроки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УточнитьСписокРеквизитовВыводаДСКЗаполнению(ВыводДС, СписокРеквизитов)
	
	Если ЗначениеЗаполнено(ВыводДС.Контрагент) Тогда
		СписокРеквизитов.Удалить("Контрагент");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыводДС.РасчетныйСчетКонтрагента) Тогда
		СписокРеквизитов.Удалить("РасчетныйСчетКонтрагента");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОснованиеОплаты(Сумма, Валюта, Перечисление_СтавкаНДС)
	
	ТипДенежныеСуммы = Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип;
	
	Основание = Новый ТаблицаЗначений;
	Основание.Колонки.Добавить("Сумма", ТипДенежныеСуммы);
	Основание.Колонки.Добавить("СуммаОплаты", ТипДенежныеСуммы);
	Основание.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Основание.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	Основание.Колонки.Добавить("СуммаНДС", ТипДенежныеСуммы);
	
	СтрокаТаблицы = Основание.Добавить();
	СтрокаТаблицы.Сумма = Сумма;
	СтрокаТаблицы.СуммаОплаты = Сумма;
	СтрокаТаблицы.Валюта = Валюта;
	СтрокаТаблицы.СтавкаНДС = Перечисление_СтавкаНДС;
	СтрокаТаблицы.СуммаНДС = РаботаСНДС.ПосчитатьСуммуНДС(Сумма, Перечисление_СтавкаНДС);

	Возврат Новый ХранилищеЗначения(Основание);

КонецФункции

#КонецОбласти
