			Возврат;
		КонецЕсли;		
		
		НазначениеПлатежаДляПоиска = ?(ЗначениеЗаполнено(Акцептование.Валюта), "%" + ШаблонНазначенияПлатежа + " " + Акцептование.НомерПП + " от %",  Акцептование.НазначениеПП);			
						
		Запрос.УстановитьПараметр("НазначениеПлатежа",        						НазначениеПлатежаДляПоиска);
		Запрос.УстановитьПараметр("Валюта",					  						Акцептование.Валюта);
		Запрос.УстановитьПараметр("ЭтоПОТраст",			      						ПОВыгрузкиФайлов = "Траст");
		
		Запрос.УстановитьПараметр("ДатаНачалаИспользованияШаблона", 	ДатаНачалаИспользованияШаблона);
		
		// Возможно, это временное решение. Банк заменяет № на N
		Запрос.УстановитьПараметр("НазначениеПлатежаБезНомера", 					СтрЗаменить(Акцептование.НазначениеПП, "№", "N"));
		Запрос.УстановитьПараметр("Сумма",                    						Акцептование.СуммаПП);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Не Выборка.Следующий() Тогда
			Если Не ЗначениеЗаполнено(Акцептование.Валюта) Тогда
				
				ТекстОшибки = "Для организации «" + Акцептование.Организация + "» не найдено п/п №«"
					+ Акцептование.НомерПП + "» от «" + Строка(Акцептование.ДатаПП)
					+ "» с суммой «" + Акцептование.СуммаПП + "»";
				
				// Диагностика шаг 1: ищем по Организации + Номер + Дата + Сумма, без условия на НазначениеПлатежа
				ЗапросДиагн = Новый Запрос;
				ЗапросДиагн.Текст =
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа
					|ИЗ
					|	Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
					|ГДЕ
					|	СтрокаБанковскойВыписки.Организация = &Организация
					|	И СтрокаБанковскойВыписки.НомерПлатежногоДокумента = &НомерПлатежногоДокумента
					|	И СтрокаБанковскойВыписки.ДатаПлатежногоДокумента = &ДатаПлатежногоДокумента
					|	И СтрокаБанковскойВыписки.Сумма = &Сумма
					|	И НЕ СтрокаБанковскойВыписки.ПометкаУдаления
					|	И СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)";
				ЗапросДиагн.УстановитьПараметр("Организация",              ЭтаФорма.Организация);
				ЗапросДиагн.УстановитьПараметр("НомерПлатежногоДокумента",  Акцептование.НомерПП);
				ЗапросДиагн.УстановитьПараметр("ДатаПлатежногоДокумента",   Акцептование.ДатаПП);
				ЗапросДиагн.УстановитьПараметр("Сумма",                     Акцептование.СуммаПП);
				ВыборкаДиагн = ЗапросДиагн.Выполнить().Выбрать();
				
				Если ВыборкаДиагн.Следующий() Тогда
					// Номер + дата + сумма совпали — проблема только в назначении платежа
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки
						+ ". Строка выписки найдена (номер, дата, сумма совпали), но не совпало назначение платежа:" + Символы.ПС
						+ "  В файле: «" + Акцептование.НазначениеПП + "»" + Символы.ПС
						+ "  В 1С:    «" + ВыборкаДиагн.НазначениеПлатежа + "»");
				Иначе
					// Диагностика шаг 2: ищем только по Организации + Номер + Дата (без суммы и назначения)
					ЗапросДиагн2 = Новый Запрос;
					ЗапросДиагн2.Текст =
						"ВЫБРАТЬ ПЕРВЫЕ 5
						|	СтрокаБанковскойВыписки.Сумма КАК Сумма,
						|	СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа
						|ИЗ
						|	Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
						|ГДЕ
						|	СтрокаБанковскойВыписки.Организация = &Организация
						|	И СтрокаБанковскойВыписки.НомерПлатежногоДокумента = &НомерПлатежногоДокумента
						|	И СтрокаБанковскойВыписки.ДатаПлатежногоДокумента = &ДатаПлатежногоДокумента
						|	И НЕ СтрокаБанковскойВыписки.ПометкаУдаления
						|	И СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)";
					ЗапросДиагн2.УстановитьПараметр("Организация",              ЭтаФорма.Организация);
					ЗапросДиагн2.УстановитьПараметр("НомерПлатежногоДокумента",  Акцептование.НомерПП);
					ЗапросДиагн2.УстановитьПараметр("ДатаПлатежногоДокумента",   Акцептование.ДатаПП);
					ВыборкаДиагн2 = ЗапросДиагн2.Выполнить().Выбрать();
					
					Если ВыборкаДиагн2.Следующий() Тогда
						// Нашли по номеру+дате — сумма не та (и, возможно, назначение тоже)
						ТекстДиагн = ТекстОшибки
							+ ". В 1С найдены строки выписки с п/п №«" + Акцептование.НомерПП
							+ "» от «" + Строка(Акцептование.ДатаПП) + "», но суммы отличаются:" + Символы.ПС
							+ "  Сумма в файле: «" + Акцептование.СуммаПП + "»" + Символы.ПС;
						Повторить
							ТекстДиагн = ТекстДиагн + "  Сумма в 1С:    «" + ВыборкаДиагн2.Сумма + "»" + Символы.ПС;
						Пока ВыборкаДиагн2.Следующий();
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстДиагн);
					Иначе
						// В 1С нет ни одной строки с этим номером и датой
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки
							+ " и назначением платежа «" + Акцептование.НазначениеПП + "»." + Символы.ПС
							+ "  В 1С нет расходных строк выписки с таким номером и датой."
							+ " Проверьте, загружена ли выписка за эту дату.");
					КонецЕсли;
				КонецЕсли;
				
				Продолжить;
			Иначе						
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации «" + Акцептование.Организация + "» не найдена строка банковской выписки на перевод №«" + Акцептование.НомерПП + "» от «" + Строка(Акцептование.ДатаПП) +
				"» с суммой «" + Акцептование.СуммаПП +
				?(Акцептование.ДатаПП < ДатаНачалаИспользованияШаблона, "»", "» и фрагментом назначения платежа «" + ШаблонНазначенияПлатежа + " " + Акцептование.НомерПП + "»"));
				Продолжить;				
			КонецЕсли;			
		КонецЕсли;   			
		
		Если Выборка.Акцептант <> "" Тогда 
			СоздатьОбновитьАкцепт(ЭтаФорма.Организация, Выборка, Акцептование);						
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не получилось определить элемент справочника юр. и физ. лица для Акцептанта " +
			Акцептование.Организация + ". Не проставлено акцептование для операции п/п №" + Акцептование.НомерПП + " от " + Строка(Акцептование.ДатаПП));
		КонецЕсли; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеестрПлатежей.ДвижениеДенежныхСредств
			|ИЗ
			|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
			|ГДЕ
			|	РеестрПлатежей.СтрокаБанковскойВыписки = &СтрокаБанковскойВыписки";
			
		Запрос.УстановитьПараметр("СтрокаБанковскойВыписки", Выборка.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
			
			РаботаСДокументами.ИзменитьВремяДокументаСУчетомАкцептования(Выборка.ДвижениеДенежныхСредств, Акцептование.Дата);
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбработатьМассивСАкцептами(МассивАкцептов, СписокСчетов = Неопределено)
	
	ТаблицаАкцептов = Новый ТаблицаЗначений;
	ТаблицаАкцептов.Колонки.Добавить("НомерПП", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));   		
	ТаблицаАкцептов.Колонки.Добавить("ДатаПП", Новый ОписаниеТипов("Дата")); 
	ТаблицаАкцептов.Колонки.Добавить("ДатаАкцепта", Новый ОписаниеТипов("Дата")); 
	ТаблицаАкцептов.Колонки.Добавить("ДатаОбработкиБанком", Новый ОписаниеТипов("Дата")); 
	ТаблицаАкцептов.Колонки.Добавить("СчетПлательщика", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100))); 
	ТаблицаАкцептов.Колонки.Добавить("СуммаПП", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100))); 
	ТаблицаАкцептов.Колонки.Добавить("НазначениеПП", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1000))); 
	ТаблицаАкцептов.Колонки.Добавить("СтатусАкцепта", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	
	Для Каждого ЭлементМассива из МассивАкцептов Цикл
		Если СписокСчетов = Неопределено Или СписокСчетов.НайтиПоЗначению(ЭлементМассива.СчетПлательщика).Пометка Тогда
			СтрокаТаблицы = ТаблицаАкцептов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	
	СтрокиВыписокОтработанные = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАкцептов.НомерПП КАК НомерПП,
		|	_ТаблицаАкцептов.ДатаПП КАК ДатаПП,
		|	_ТаблицаАкцептов.ДатаАкцепта КАК ДатаАкцепта,
		|	_ТаблицаАкцептов.ДатаОбработкиБанком КАК ДатаОбработкиБанком,
		|	_ТаблицаАкцептов.СчетПлательщика КАК СчетПлательщика,
		|	_ТаблицаАкцептов.СуммаПП КАК СуммаПП,
		|	_ТаблицаАкцептов.НазначениеПП КАК НазначениеПП,
		|	_ТаблицаАкцептов.СтатусАкцепта КАК СтатусАкцепта
		|ПОМЕСТИТЬ _ТаблицаАкцептов
		|ИЗ
		|	&ТаблицаАкцептов КАК _ТаблицаАкцептов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаАкцептов.ДатаПП КАК ДатаПП,
		|	_ТаблицаАкцептов.НомерПП КАК НомерПП,
		|	_ТаблицаАкцептов.СуммаПП КАК СуммаПП,
		|	_ТаблицаАкцептов.НазначениеПП КАК НазначениеПП,
		|	_ТаблицаАкцептов.ДатаОбработкиБанком КАК ДатаОбработкиБанком,
		|	_ТаблицаАкцептов.СчетПлательщика КАК СчетПлательщика,
		|	_ТаблицаАкцептов.ДатаАкцепта КАК ДатаАкцепта,
		|	_ТаблицаАкцептов.ДатаАкцепта КАК Дата,
		|	"""" КАК Лицо,
		|	СтрокаБанковскойВыпискиДок.Ссылка КАК Ссылка,
		|	СтрокаБанковскойВыпискиДок.Дата КАК ДатаВыписки,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо КАК Акцептант,
		|	АкцептованиеОпераций.Период КАК ПериодАкцепта,
		|	АкцептованиеОпераций.Регистратор КАК Регистратор,
		|	ЕСТЬNULL(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаЗапретаРедактирования,
		|	РеестрПлатежей.ДвижениеДенежныхСредств КАК ДвижениеДенежныхСредств
		|ИЗ
		|	_ТаблицаАкцептов КАК _ТаблицаАкцептов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыпискиДок
		|		ПО (СтрокаБанковскойВыпискиДок.РасчетныйСчет.НомерСчета = _ТаблицаАкцептов.СчетПлательщика)
		|			И (СтрокаБанковскойВыпискиДок.НомерПлатежногоДокумента = _ТаблицаАкцептов.НомерПП)
		|			И (СтрокаБанковскойВыпискиДок.ДатаПлатежногоДокумента = _ТаблицаАкцептов.ДатаПП)
		|			И (СтрокаБанковскойВыпискиДок.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход))
		|			И (СтрокаБанковскойВыпискиДок.Организация = &Организация)
		|			И (СтрокаБанковскойВыпискиДок.РасчетныйСчет.Банк = &Банк)
		|			И (НЕ СтрокаБанковскойВыпискиДок.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ПО (СтрокаБанковскойВыпискиДок.Ссылка = РеестрПлатежей.ДвижениеДенежныхСредств)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО (СтрокаБанковскойВыпискиДок.Организация = ИсполнителиПоДенежнымСредствамСобственные.Организация)
		|			И (СтрокаБанковскойВыпискиДок.РасчетныйСчет = ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО (ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления)
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций КАК АкцептованиеОпераций
		|		ПО (СтрокаБанковскойВыпискиДок.Ссылка = АкцептованиеОпераций.Операция)";
	
	Запрос.УстановитьПараметр("Организация",		ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("ТаблицаАкцептов",	ТаблицаАкцептов);
	Запрос.УстановитьПараметр("Банк",				ОбщегоНазначения.ПолучитьИменованныйОбъект(?(СписокСчетов = Неопределено, "Банк_ВТБ", "Банк_МКБ")));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для организации «" + ЭтаФорма.Организация + "» не найдено п/п №«" + Выборка.НомерПП
				+ "» от «" + Строка(Выборка.ДатаПП) + "» с суммой «" + Выборка.СуммаПП + "» и назначением платежа «" + Выборка.НазначениеПП 
				+ "» по счету № " + Выборка.СчетПлательщика);
			Продолжить;			
		КонецЕсли;   			
		
		Если Выборка.ДатаЗапретаРедактирования >= Выборка.ДатаОбработкиБанком Тогда
			
			Если НЕ ЗначениеЗаполнено(Выборка.ПериодАкцепта) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Закрыта дата запрета редактирования! Не загружен акцепт для п/п №«" + Выборка.НомерПП + "» от «" + Строка(Выборка.ДатаПП) 
					+ "» по счету № " + Выборка.СчетПлательщика);
			ИначеЕсли Выборка.ПериодАкцепта <> Выборка.ДатаАкцепта Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Закрыта дата запрета редактирования! Не совпадает время акцепта " 
					+ Формат(Выборка.ПериодАкцепта, "ДФ='dd.MM.yyyy hh:mm:ss'")
					+ " для п/п №«" + Выборка.НомерПП + "» от «" + Строка(Выборка.ДатаПП) + "» по счету № " + Выборка.СчетПлательщика 
					+ " со временем акцепта в файле " + Формат(Выборка.ДатаАкцепта, "ДФ='dd.MM.yyyy hh:mm:ss'"));
			КонецЕсли;
				
			Продолжить;
			
		КонецЕсли;
		
		Если СтрокиВыписокОтработанные.Найти(Выборка.Ссылка) = Неопределено Тогда
			Если Выборка.Акцептант <> "" Тогда 
				СоздатьОбновитьАкцепт(ЭтаФорма.Организация, Выборка, Выборка);						
				СтрокиВыписокОтработанные.Добавить(Выборка.Ссылка);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не получилось определить элемент справочника юр. и физ. лица для Акцептанта " 
					+ ЭтаФорма.Организация + ". Не проставлено акцептование для операции п/п №" + Выборка.НомерПП + " от " + Строка(Выборка.ДатаПП)
					+ " по счету № " + Выборка.СчетПлательщика);
				Продолжить;
			КонецЕсли; 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДвижениеДенежныхСредств) Тогда
			РаботаСДокументами.ИзменитьВремяДокументаСУчетомАкцептования(Выборка.ДвижениеДенежныхСредств, Выборка.ДатаАкцепта);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьОбновитьАкцепт(Организация, Выборка, Акцептование)

	Если ЗначениеЗаполнено(Выборка.Регистратор) Тогда
		Акцепт = Выборка.Регистратор.ПолучитьОбъект();
	Иначе	
		Акцепт = Документы.Акцепт.СоздатьДокумент();
	КонецЕсли;
			
	Акцепт.Акцептант 					= Выборка.Акцептант;
	Акцепт.Объект						= Выборка.Ссылка;
	Акцепт.Организация 					= Организация;
	Акцепт.Дата		 					= Акцептование.Дата;
	Акцепт.Представитель				= Акцептование.Лицо;
	Акцепт.СчетДоверительногоУправления	= Выборка.СчетДоверительногоУправления;
	Акцепт.Ответственный				= РаботаСПользователями.ТекущийПользователь();
	
	Попытка 
		Акцепт.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), Акцепт);
	КонецПопытки;
	
КонецПроцедуры

