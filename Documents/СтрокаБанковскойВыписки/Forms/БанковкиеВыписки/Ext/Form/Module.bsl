
#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не РольДоступна("ПолныеПрава") Тогда
		Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация"); 
	
	ЭтаФорма.ИспользуетсяПредварительнаяВыписка = Документы.СтрокаБанковскойВыписки.ОрганизацияЗагружаетПредварительнуюВыписку(ЭтаФорма.Организация);
	
	ЭтаФорма.Статус = 0;
	
	// период (если попал на выходной, переносим на пятницу)
	ЭтаФорма.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);
	
	Если      ДеньНедели(ЭтаФорма.Период.ДатаНачала) = 7 Тогда
		ЭтаФорма.Период = Новый СтандартныйПериод(ЭтаФорма.Период.ДатаНачала - 2 * 86400, ЭтаФорма.Период.ДатаОкончания - 2 * 86400);
	ИначеЕсли ДеньНедели(ЭтаФорма.Период.ДатаНачала) = 6 Тогда
		ЭтаФорма.Период = Новый СтандартныйПериод(ЭтаФорма.Период.ДатаНачала - 86400, ЭтаФорма.Период.ДатаОкончания - 86400);
	КонецЕсли;
	
	// переданные отборы
	Если ЭтаФорма.Параметры.Свойство("Отбор") И ТипЗнч(ЭтаФорма.Параметры.Отбор) = Тип("Структура") Тогда
		НастройкаОтбора = ЭтаФорма.Параметры.Отбор;
		
		Если НастройкаОтбора.Свойство("Период") Тогда
			ЭтаФорма.Период = Новый СтандартныйПериод(НачалоДня(НастройкаОтбора.Период), КонецДня(НастройкаОтбора.Период));
			Дата = НастройкаОтбора.Период;
		КонецЕсли;
		
		Если НастройкаОтбора.Свойство("Дата") Тогда
			ЭтаФорма.Период = Новый СтандартныйПериод(НачалоДня(НастройкаОтбора.Дата), КонецДня(НастройкаОтбора.Дата));
			Дата = НастройкаОтбора.Дата;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкаОтбора,, ?(НастройкаОтбора.Свойство("Период"), "Период", ""));
		
		Если НастройкаОтбора.Свойство("Сумма") Тогда
			Сумма = Параметры.Отбор.Сумма;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтаФорма.РежимВыбора        = ЭтаФорма.Параметры.Свойство("РежимВыбора") И ЭтаФорма.Параметры.РежимВыбора;
	ЭтаФорма.ЗакрыватьПриВыборе = Истина;
	
	Если ЭтаФорма.Параметры.Свойство("ИсточникВыбора") Тогда
		ЭтаФорма.ИсточникВыбора = ЭтаФорма.Параметры.ИсточникВыбора;
	КонецЕсли;
	
	РаботаСФормамиКлиентСервер.УстановитьЗаголовокФормыСписка(ЭтаФорма, "Банковские выписки", ЭтаФорма.Период);
	
	Элементы.СтрокиБанковскойВыпискиВыбратьЗначение.Видимость               = ЭтаФорма.РежимВыбора;
	Элементы.СтрокиБанковскойВыпискиГруппаДвижениеДенежныхСредств.Видимость = Не ЭтаФорма.РежимВыбора;
	
	ЗаполнитьСтрокиБанковскойВыпискиНаСервере();
	
	Если ЭтаФорма.Параметры.Свойство("ТекущиеДанные") Тогда
		РаботаСФормамиКлиентСервер.УстановитьТекущуюСтрокуТаблицы(ЭтаФорма, "СтрокиБанковскойВыписки", ЭтаФорма.Параметры.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "БанковкиеВыписки.Обновить" Тогда
		ОбновитьСтрокиБанковскойВыписки();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СОБЫТИЯ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ВидДвиженияПриИзменении(Элемент)
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныйСчетПриИзменении(Элемент)
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиБанковскойВыпискиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиБанковскойВыпискиПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗначение(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиБанковскойВыпискиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не ЭтаФорма.РежимВыбора Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОповеститьОВыборе(Элементы.СтрокиБанковскойВыписки.ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокиБанковскойВыпискиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = ЭтаФорма.Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные.Ссылка <> ПредопределенноеЗначение("Документ.СтрокаБанковскойВыписки.ПустаяСсылка") Тогда
		
		ДанныеДокумента = Новый Массив;
		
		ДанныеДокумента.Добавить(
			Новый Структура("Документ, Состояние", 
				ТекущиеДанные.Ссылка, 
				?(ТекущиеДанные.Картинка = 0, ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление"), ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан"))));
		
		Попытка		
			РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеДокумента);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не удалось пометить документ на удаление!
				|Ошибка:" + ОписаниеОшибки());
		КонецПопытки;
		
		ОбновитьСтрокиБанковскойВыписки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	ЭтаФорма.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.РасчетныйСчет  = "";
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

#КонецОбласти

#Область КОМАНДЫ

&НаКлиенте
Процедура ВыбратьЗначение(Команда)
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	ВыбПериод = ОткрытьФормуМодально("ОбщаяФорма.ВыборПериода", Новый Структура("Период", ЭтаФорма.Период), ЭтаФорма);
	
	Если ВыбПериод <> КодВозвратаДиалога.Отмена И ВыбПериод <> Неопределено Тогда
		ЭтаФорма.Период = ВыбПериод;
		РаботаСФормамиКлиентСервер.УстановитьЗаголовокФормыСписка(ЭтаФорма, "Банковские выписки", ЭтаФорма.Период);
		ОбновитьСтрокиБанковскойВыписки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
	
	ТекущиеДанные = ЭтаФорма.Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено
		И ТекущиеДанные.Ссылка <> ПредопределенноеЗначение("Документ.СтрокаБанковскойВыписки.ПустаяСсылка")
	Тогда
		ОткрытьЗначение(ТекущиеДанные.Ссылка);
		ОбновитьСтрокиБанковскойВыписки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПоступление(Команда)
	
	ЗначенияЗаполнения = Новый Структура("ВидДвижения, РасчетныйСчет, Контрагент, Сумма, РасчетныйСчетКонтрагента, Организация, Дата",
		ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход"), ЭтаФорма.РасчетныйСчет, ЭтаФорма.Контрагент, Сумма, РасчетныйСчетКонтрагента, Организация, Дата);
	
	Открытьформу("Документ.СтрокаБанковскойВыписки.ФормаОбъекта", Новый Структура("ЗначенияЗаполненияФормы", ЗначенияЗаполнения));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьСписание(Команда)
	
	ЗначенияЗаполнения = Новый Структура("ВидДвижения, РасчетныйСчет, Контрагент, Сумма, РасчетныйСчетКонтрагента, Организация, Дата",
		ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход"), ЭтаФорма.РасчетныйСчет, ЭтаФорма.Контрагент, Сумма, РасчетныйСчетКонтрагента, Организация, Дата);
	
	Открытьформу("Документ.СтрокаБанковскойВыписки.ФормаОбъекта", Новый Структура("ЗначенияЗаполненияФормы", ЗначенияЗаполнения));
		
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	ТекущиеДанные = ЭтаФорма.Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Ссылка <> ПредопределенноеЗначение("Документ.СтрокаБанковскойВыписки.ПустаяСсылка") Тогда
		
		ДанныеДокумента = Новый Массив;
		
		ДанныеДокумента.Добавить(
			Новый Структура("Документ, Состояние", 
				ТекущиеДанные.Ссылка, 
				?(ТекущиеДанные.Картинка = 0, ПредопределенноеЗначение("Перечисление.СостоянияДокументов.ПомеченНаУдаление"), ПредопределенноеЗначение("Перечисление.СостоянияДокументов.Записан"))));
		
		РаботаСоСпискомДокументовКлиент.УстановитьСнятьПометкуУдаления(ДанныеДокумента);
		
		ОбновитьСтрокиБанковскойВыписки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортБанковскихВыписок(Команда)
	
	ОткрытьФорму("Документ.СтрокаБанковскойВыписки.Форма.ИмпортБанковскихВыписок",, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьДвижениеДенежныхСредств(Команда)
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбДанные = ОткрытьФормуМодально("Документ.СтрокаБанковскойВыписки.Форма.ВыборПлатежногоДокумента",
		Новый Структура("СтрокаБанковскойВыписки", ТекущиеДанные.Ссылка));
		
	Если ВыбДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЗначенияЗаполнения = Новый Структура(Выбданные.ИмяРеквизитаСтрокиБанковскойВыписки + ", Контрагент, РасчетныйСчетКонтрагента",
		ТекущиеДанные.Ссылка,
		ТекущиеДанные.Контрагент,
		ТекущиеДанные.РасчетныйСчетКонтрагента);
		
	// В переводах определяем, что выписка плательщика или получателя по виду движения
	Если ВыбДанные.ИмяДокумента = "ПереводДенежныхСредств" Тогда
		Если ТекущиеДанные.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход") Тогда
			ЗначенияЗаполнения.Вставить("СтрокаБанковскойВыпискиПолучатель", ТекущиеДанные.Ссылка);
			ЗначенияЗаполнения.Удалить("СтрокаБанковскойВыписки");
		КонецЕсли;
	ИначеЕсли ТекущиеДанные.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход")
		И ВыбДанные.ИмяДокумента = "ВыводДенежныхСредств" Тогда
		УточнитьСписокРеквизитовВыводаДСКЗаполнению(ВыбДанные.Ссылка, ЗначенияЗаполнения);
	КонецЕсли;
		
	ОткрытьФорму("Документ." + ВыбДанные.ИмяДокумента + ".ФормаОбъекта",
		Новый Структура("Ключ, ЗначенияЗаполненияФормы", ВыбДанные.Ссылка, ЗначенияЗаполнения),
		ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьОплатуКомиссии(Команда)
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Период, Организация, Контрагент, РасчетныйСчетКонтрагента",
		ТекущиеДанные.Дата, ТекущиеДанные.Организация, ТекущиеДанные.Контрагент, ТекущиеДанные.РасчетныйСчетКонтрагента);
	
	ОткрытьФорму("Документ.СтрокаБанковскойВыписки.Форма.ОплатаКомиссии", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьОплату(Команда)
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// организуем выбор задолженности
	ПараметрыПодбора = Новый Структура("МножественныйВыбор", Истина);
	
	ПараметрыПодбора.Вставить("Период",           КонецДня(ТекущиеДанные.Дата));
	ПараметрыПодбора.Вставить("Организация",      ТекущиеДанные.Организация);
	ПараметрыПодбора.Вставить("ТипЗадолженности", РаботаСЗадолженностямиКлиентСерверПовтИсп.ПолучитьТипЗадолженностиПоВидуДвижения(ТекущиеДанные.ВидДвижения));
	ПараметрыПодбора.Вставить("ТекущиеДанные",    Новый Структура("СуммаВсего, РасчетныйСчет", ТекущиеДанные.Поступление + ТекущиеДанные.Списание, ТекущиеДанные.РасчетныйСчет));
	ПараметрыПодбора.Вставить("РасчетныйСчет", 	  ТекущиеДанные.РасчетныйСчет);	
	Пока 1 = 1 Цикл
	
		ХранилищеВыбЗадолженности = ОткрытьФормуМодально("ОбщаяФорма.ПодборЗадолженностиПоДенежнымСредствам", ПараметрыПодбора, ЭтаФорма);
	
		Если ХранилищеВыбЗадолженности = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ТекстОшибки     = "";
		РеквизитыОплаты = ЗаполнитьРеквизитыОплаты(ТекущиеДанные.Ссылка, ХранилищеВыбЗадолженности, ТекстОшибки, ЭтаФорма.ИспользуетсяПредварительнаяВыписка);
		
		Если РеквизитыОплаты = Неопределено Тогда
			Если Вопрос(ТекстОшибки + ". Повторить выбор?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
			
		ОткрытьФорму("Документ.Оплата.ФормаОбъекта", Новый Структура("ЗначенияЗаполненияФормы", РеквизитыОплаты), ЭтаФорма);
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПрочиеПлатежныеДокументы(Команда)
	
	ТекущиеДанные = Элементы.СтрокиБанковскойВыписки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// выделим прочие платежные документы
	СписокПрочихПлатежныхДокументов = ПолучитьСписокПлатежныхДокументов(ТекущиеДанные.ВидДвижения);
	
	СписокПрочихПлатежныхДокументов.Удалить(
		СписокПрочихПлатежныхДокументов.НайтиПоЗначению("Оплата"));
	
	// выбор вида платежного документа
	ИмяПлатежногоДокумента = ОткрытьФормуМодально("ОбщаяФорма.ВыборИзСпискаСФильтрацией",
		Новый Структура("Список, Заголовок", СписокПрочихПлатежныхДокументов, "Прочие платежные документы"),
		ЭтаФорма);
		
	Если ИмяПлатежногоДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаАкцептования = РаботаСДокументами.ПолучитьДатуАкцептования(ТекущиеДанные.Ссылка, ТекущиеДанные.Организация);
	
	//Иногда акцептование происходит раньше разнесения выписки, чтобы избежать двойной записи документа поставим сразу корректную дату
	Если ДатаАкцептования <> Неопределено Тогда
		 ДатаПлатежногоДокумента = ДатаАкцептования + 1200;
	 Иначе
		 ДатаПлатежногоДокумента = НачалоДня(ТекущиеДанные.Дата) + 14*60*60 + 30*60; // создаваемые документы помещаем во время 14:30
	КонецЕсли; 

	// открытие заполненной формы документа
	РеквизитыПлатежногоДокумента = Новый Структура("Дата, Организация, РасчетныйСчет, СтрокаБанковскойВыписки, Контрагент, РасчетныйСчетКонтрагента, Сумма, СчетДоверительногоУправления",
		ДатаПлатежногоДокумента,
		ТекущиеДанные.Организация,
		ТекущиеДанные.РасчетныйСчет,
		ТекущиеДанные.Ссылка,
		ТекущиеДанные.Контрагент,
		ТекущиеДанные.РасчетныйСчетКонтрагента,
		ТекущиеДанные.Поступление + ТекущиеДанные.Списание,
		ОпределитьСчетДоверительногоУправления(
				Новый Структура("Период, Организация, РасчетныйСчет, Контрагент, ВидДокумента", 
						ТекущиеДанные.Дата, 
						ТекущиеДанные.Организация, 
						ТекущиеДанные.РасчетныйСчет, 
						ТекущиеДанные.Контрагент, 
						ИмяПлатежногоДокумента)));
		
	Если ИмяПлатежногоДокумента = "ПриходПроцентовПоКредитномуИнструменту" 
		ИЛИ ИмяПлатежногоДокумента = "РазмещениеКредитногоИнструмента" 
		ИЛИ ИмяПлатежногоДокумента = "ЗакрытиеКредитногоИнструмента"
	Тогда
		РеквизитыПлатежногоДокумента.Вставить("КредитныйИнструмент", ОпределитьДепозитныйВклад(ТекущиеДанные.Контрагент, ТекущиеДанные.НазначениеПлатежа));
	
	ИначеЕсли ИмяПлатежногоДокумента = "ПереводДенежныхСредств" Тогда
		РеквизитыПлатежногоДокумента.Вставить("ВариантПеревода", ПредопределенноеЗначение("Перечисление.ВариантыПереводаДенежныхСредств.Перевод"));
		РеквизитыПлатежногоДокумента.Вставить("Валюта",          ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.РасчетныйСчет, "Валюта"));
		
		Если ТекущиеДанные.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Приход") Тогда
			РеквизитыПлатежногоДокумента.Вставить("МестоХранения",						ОпределитьМестоХранения(ТекущиеДанные.РасчетныйСчетКонтрагента));
			РеквизитыПлатежногоДокумента.Вставить("МестоХраненияПолучатель",			ОпределитьМестоХранения(ТекущиеДанные.РасчетныйСчет));
			РеквизитыПлатежногоДокумента.Вставить("Брокер",								ОпределитьБрокера(ТекущиеДанные.Контрагент, ТекущиеДанные.ДатаПлатежногоДокумента, ТекущиеДанные.РасчетныйСчетКонтрагента));
			РеквизитыПлатежногоДокумента.Вставить("РасчетныйСчетПолучатель",			ТекущиеДанные.РасчетныйСчет);
			РеквизитыПлатежногоДокумента.Вставить("СтрокаБанковскойВыпискиПолучатель",	ТекущиеДанные.Ссылка);
			
			РеквизитыПлатежногоДокумента.Удалить("СтрокаБанковскойВыписки");
			
			Если РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(РеквизитыПлатежногоДокумента, "Брокер") Тогда
				РеквизитыПлатежногоДокумента.РасчетныйСчет = ТекущиеДанные.РасчетныйСчетКонтрагента;
			Иначе
				РеквизитыПлатежногоДокумента.РасчетныйСчет = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ТекущиеДанные.ВидДвижения = ПредопределенноеЗначение("Перечисление.ВидыДвижений.Расход") Тогда
			РеквизитыПлатежногоДокумента.Вставить("МестоХранения",           ОпределитьМестоХранения(ТекущиеДанные.РасчетныйСчет));
			РеквизитыПлатежногоДокумента.Вставить("МестоХраненияПолучатель", ОпределитьМестоХранения(ТекущиеДанные.РасчетныйСчетКонтрагента));
			РеквизитыПлатежногоДокумента.Вставить("БрокерПолучатель",        ОпределитьБрокера(ТекущиеДанные.Контрагент, ТекущиеДанные.ДатаПлатежногоДокумента, ТекущиеДанные.РасчетныйСчетКонтрагента));
			РеквизитыПлатежногоДокумента.Вставить("РасчетныйСчетПолучатель", ТекущиеДанные.РасчетныйСчетКонтрагента);
			
			Если РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(РеквизитыПлатежногоДокумента, "БрокерПолучатель") Тогда
				РеквизитыПлатежногоДокумента.РасчетныйСчет = ТекущиеДанные.РасчетныйСчет;
			Иначе
				РеквизитыПлатежногоДокумента.РасчетныйСчет = Неопределено;
			КонецЕсли;				
		КонецЕсли;
		
	ИначеЕсли ИмяПлатежногоДокумента = "ВводДенежныхСредств" Тогда
		
		РеквизитыПлатежногоДокумента.Вставить("Основание", ОпределитьОснованиеИДополнитьРеквизиты(ИмяПлатежногоДокумента, РеквизитыПлатежногоДокумента, ТекущиеДанные.НазначениеПлатежа));
		
	ИначеЕсли ИмяПлатежногоДокумента = "Аванс" Тогда

		ДанныеСтрокиБанковскойВыписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущиеДанные.Ссылка, "ПлатежноеПоручение");

		Если СтрНайти(НРег(ТекущиеДанные.НазначениеПлатежа), "без ндс") > 0 Тогда
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		ИначеЕсли ДатаПлатежногоДокумента <= '2025-12-31 23:59:59' Тогда
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
		Иначе
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
		КонецЕсли;

		Если СтрНайти(НРег(ТекущиеДанные.НазначениеПлатежа), "аренд") > 0 Тогда
			РеквизитыПлатежногоДокумента.Вставить("ВидЗадолженности",	ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоАренде"));
		КонецЕсли;

		РеквизитыПлатежногоДокумента.Вставить("ВидДвижения",		ТекущиеДанные.ВидДвижения);
		РеквизитыПлатежногоДокумента.Вставить("Аванс",				Истина);
		РеквизитыПлатежногоДокумента.Вставить("МестоХранения",		ОпределитьМестоХранения(ТекущиеДанные.РасчетныйСчетКонтрагента));
		РеквизитыПлатежногоДокумента.Вставить("ВалютаОплаты",		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.РасчетныйСчетКонтрагента, "Валюта"));
		РеквизитыПлатежногоДокумента.Вставить("ПлатежноеПоручение",	ДанныеСтрокиБанковскойВыписки.ПлатежноеПоручение);
		РеквизитыПлатежногоДокумента.Вставить("Основания",			ПолучитьОснованиеОплаты(РеквизитыПлатежногоДокумента.Сумма, РеквизитыПлатежногоДокумента.ВалютаОплаты, СтавкаНДС));
		РеквизитыПлатежногоДокумента.РасчетныйСчетКонтрагента = 	Неопределено;
		
		ИмяПлатежногоДокумента = "Оплата";
		
	КонецЕсли;
			
	ОткрытьФорму("Документ." + ИмяПлатежногоДокумента + ".ФормаОбъекта", Новый Структура("ЗначенияЗаполненияФормы", РеквизитыПлатежногоДокумента));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортДанныхПоАкцептованию_ГПБ(Команда)

	// У РЭМа и Траста разные версии клиент-банка от ГПБ ("толстый" и "тонкий"),
	// данные по акцептам выгружаются в разных форматах.
	// Другие организации пока не используют автоматическую загрузку (либо не требуется, либо банк не поддерживает)
	ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	ОрганизацияТраст = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ");
	
	Если Этаформа.Организация = ОрганизацияРЭМ Тогда
		ИмпортДанныхПоАкцептованию_ГПБ_РЭМ();
	ИначеЕсли ЭтаФорма.Организация = ОрганизацияТраст Тогда		
		ИмпортДанныхПоАкцептованию_ГПБ_Траст();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует возможность автоматической загрузки акцептов для организации " + СокрЛП(ЭтаФорма.Организация));
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаИмпортДанныхПоАкцептованию_МКБ(Команда)
	
	//чтобы исключить разные версии файла - ограничим организацией
	ОрганизацияРПИ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ");
	Если Этаформа.Организация = ОрганизацияРПИ Тогда
		ИмпортДанныхПоАкцептованию_МКБ();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует возможность автоматической загрузки акцептов для организации " + СокрЛП(ЭтаФорма.Организация));
	КонецЕсли;
	
КонецПроцедуры      

&НаКлиенте
Процедура КомандаИмпортДанныхПоАкцептованию_ВТБ(Команда)
		
	ИмпортДанныхПоАкцептованию_ВТБ();
		
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервереБезКонтекста
Функция Обрезать(Содержимое)
	
	Обрезаное = СтрЗаменить(Содержимое, Символы.ВК, "");
	Обрезаное = СтрЗаменить(Обрезаное, Символы.ПС, "");
	
	Возврат СокрЛП(Обрезаное);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначениеДопНастройкиНаСервере(КлючНастройки, Организация)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(Неопределено, КлючНастройки, Организация);
	
КонецФункции

&НаКлиенте
Процедура ИмпортДанныхПоАкцептованию_ГПБ_РЭМ()
	
	ФайлНаДиске = Новый Файл("\\g1\shares\1Cv7\RASM\Выписки\acc.xml");
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок          = "Выберите файл";
	Диалог.ПолноеИмяФайла     = ""; 
	Диалог.Фильтр             = "XML (*.xml)|*.xml"; 
    Диалог.МножественныйВыбор = Ложь;
	Диалог.Каталог            = ФайлНаДиске.Путь;
	
	Если НЕ Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;	
	
	ТекстФайла = Новый ТекстовыйДокумент;
	ТекстФайла.Прочитать(Диалог.ПолноеИмяФайла, "windows-1251");
	
	ЭтаФорма.АдресХранилища = ПоместитьВоВременноеХранилище(ТекстФайла.ПолучитьТекст(), ЭтаФорма.УникальныйИдентификатор);
	
	АкцептоватьНаСервере("РЭМ");
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортДанныхПоАкцептованию_ГПБ_Траст()
	
	// В этом случае в каталоге много файлов, отдельный на каждую платежку.
	// Архивируем все файлы с расширением .bcw и отправляем архив на сервер.
	ФайлНаДиске = Новый Файл("\\g1\shares\1Cv7\RASM\Выписки");
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок          = "Выберите каталог";
	Диалог.ПолноеИмяФайла     = ""; 
			
	Диалог.Каталог            = ФайлНаДиске.Путь;
	
	Если НЕ Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;	
	
	НайденныеФайлы = НайтиФайлы(Диалог.Каталог, "*.bcw");
	
	Если НайденныеФайлы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В выбранном каталоге отсутствуют файлы с акцептами (.bcw)");
		Возврат;
	КонецЕсли;
	
	Архив = Новый ЗаписьZipФайла();
	
	Архив.Добавить(Диалог.Каталог + "\" + "*.bcw");
		
	ЭтаФорма.АдресХранилища = ПоместитьВоВременноеХранилище(Архив.ПолучитьДвоичныеДанные(), ЭтаФорма.УникальныйИдентификатор);
	
	АкцептоватьНаСервере("Траст");
	
	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортДанныхПоАкцептованию_МКБ()
	
	ШаблонПутиКФайлуАкцептовМКБ = ПолучитьЗначениеДопНастройкиНаСервере("БанковскиеВыписки.ШаблонПутиКФайлуАкцептовМКБ", ЭтотОбъект.Организация);
	
	ДанныеАкцептов = Новый Массив;
	СписокСчетов = Новый СписокЗначений;
	ТекущийНомерСчета = "";
	Если ЗначениеЗаполнено(ЭтаФорма.РасчетныйСчет) Тогда
		ТекущийНомерСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.РасчетныйСчет, "НомерСчета");
	КонецЕсли;
	
	Excel = Неопределено;
	
	Попытка
	
		Дата = ЭтаФорма.Период.ДатаНачала;
		Пока Дата <= ЭтаФорма.Период.ДатаОкончания Цикл
			ПутьКФайлу = СтрШаблон(ШаблонПутиКФайлуАкцептовМКБ, Формат(Дата, "ДФ=yyyy"), Формат(Дата, "ДФ=ММ"), Формат(Дата, "ДФ=ММММ"), Формат(Дата, "ДФ=dd.ММ.yyyy"));
			
			ИсходныйФайл = Новый Файл(ПутьКФайлу);
			Если НЕ ИсходныйФайл.Существует() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден файл акцептов за "+Формат(Дата, "ДФ=dd.MM.yyyy"));
				Дата = Дата + 86400;
				Продолжить;
			КонецЕсли;
			
			Попытка
				Если Excel = Неопределено Тогда
					Excel = Новый COMОбъект("Excel.Application");
				КонецЕсли;
				Excel.WorkBooks.Open(ПутьКФайлу);
				Excel.Sheets(1).Select();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
				Возврат;
			КонецПопытки;
			
			НомСтр = 2;
			
			Пока НомСтр < 10000 Цикл 		
				Если Не ЗначениеЗаполнено(Excel.Cells(НомСтр,1).Value) Тогда
					Прервать;
				КонецЕсли;
				
				СчетПлательщика = Excel.Cells(НомСтр, 11).Value;
				
				Если ТекущийНомерСчета = "" ИЛИ ТекущийНомерСчета = СчетПлательщика Тогда
					
					Если ЗначениеЗаполнено(Excel.Cells(НомСтр,13).Value)
						И Excel.Cells(НомСтр,13).Value = "Акцептовано" Тогда
						
						НоваяСтрока = Новый Структура();
						НоваяСтрока.Вставить("НомерПП",				Excel.Cells(НомСтр, 1).Value);   		
						НоваяСтрока.Вставить("ДатаПП",				Дата(Excel.Cells(НомСтр, 2).Value + " 00:00:00")); 
						НоваяСтрока.Вставить("ДатаАкцепта",			Дата(Excel.Cells(НомСтр, 14).Value)); 
						НоваяСтрока.Вставить("ДатаОбработкиБанком",	НачалоДня(НоваяСтрока.ДатаАкцепта)); 
						НоваяСтрока.Вставить("СчетПлательщика",		СчетПлательщика); 
						НоваяСтрока.Вставить("СуммаПП",				Excel.Cells(НомСтр, 5).Value); 
						НоваяСтрока.Вставить("НазначениеПП",		Excel.Cells(НомСтр, 7).Value); 
						НоваяСтрока.Вставить("СтатусАкцепта",		Excel.Cells(НомСтр, 13).Value); 
						
						ДанныеАкцептов.Добавить(НоваяСтрока);
						
						Если СписокСчетов.НайтиПоЗначению(СчетПлательщика) = Неопределено Тогда
							ЭлементСписка = СписокСчетов.Добавить(СчетПлательщика, СчетПлательщика, Ложь);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				НомСтр = НомСтр + 1;
				
			КонецЦикла;
			
			Excel.DisplayAlerts = 0;
			Excel.ActiveWorkbook.Close();
			
			Дата = Дата + 86400;
		КонецЦикла;
		
	Исключение
		
		Если Excel <> Неопределено Тогда
			Excel.DisplayAlerts = 1;
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Excel);
		КонецЕсли;
		
		ВызватьИсключение;	
		
	КонецПопытки;
		
	Если Excel <> Неопределено Тогда
		Excel.DisplayAlerts = 1;
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Excel);
	КонецЕсли;
	
	Если СписокСчетов.Количество() = 0 Тогда
		
		Возврат;
		
	ИначеЕсли ТекущийНомерСчета <> "" Тогда
		
		ЭлементСписка = СписокСчетов.НайтиПоЗначению(ТекущийНомерСчета);
		Если ЭлементСписка <> Неопределено Тогда
			ЭлементСписка.Пометка = Истина;
		КонецЕсли;
		
	ИначеЕсли СписокСчетов.ОтметитьЭлементы("Счета для импорта акцептов МКБ") = Ложь Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОбработатьМассивСАкцептами(ДанныеАкцептов, СписокСчетов);

	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортДанныхПоАкцептованию_ВТБ()
		
	КаталогФайлов = КаталогВыпискиДляОрганизации(Организация);
	
	ФайлНаДиске = Новый Файл(КаталогФайлов);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок          = "Выберите файл";
	Диалог.ПолноеИмяФайла     = ""; 
	Диалог.Фильтр             = "XLSX (*.xlsx)|*.xlsx"; 
    Диалог.МножественныйВыбор = Ложь;
	Диалог.Каталог            = ФайлНаДиске.Путь;
	
	Если НЕ Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
		
	ДанныеАкцептов = Новый Массив;

	ТекущийНомерСчета = "";
	Если ЗначениеЗаполнено(ЭтаФорма.РасчетныйСчет) Тогда
		ТекущийНомерСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.РасчетныйСчет, "НомерСчета");
	КонецЕсли;
	
	Excel = Неопределено;
		    
	ПутьКФайлу = Диалог.ПолноеИмяФайла;
	
	ИсходныйФайл = Новый Файл(ПутьКФайлу);
			
	Попытка
		Если Excel = Неопределено Тогда
			Excel = Новый COMОбъект("Excel.Application");
		КонецЕсли;
		Excel.WorkBooks.Open(ПутьКФайлу);
		Excel.Sheets(1).Select();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	НомСтр = 2;
	
	Попытка
		Пока НомСтр < 10000 Цикл
			
			Если Не ЗначениеЗаполнено(Excel.Cells(НомСтр,1).Value) Тогда
				Прервать;
			КонецЕсли;
			
			СчетПлательщика = Excel.Cells(НомСтр, 7).Value;
			
			Если ТекущийНомерСчета = "" ИЛИ ТекущийНомерСчета = СчетПлательщика Тогда
				
				СтрВремяАкцепта = СокрЛП(Excel.Cells(НомСтр, 5).Value);
				
				Если ЗначениеЗаполнено(СтрВремяАкцепта) Тогда
					
					ПозицияЧасовогоПояса = СтрНайти(СтрВремяАкцепта, "(UTC");
					Если ПозицияЧасовогоПояса > 0 Тогда
						
						ВремяАкцепта = Дата(Число(Сред(СтрВремяАкцепта, 7, 4)),
										Число(Сред(СтрВремяАкцепта, 4, 2)),
										Число(Сред(СтрВремяАкцепта, 1, 2)),
										Число(Сред(СтрВремяАкцепта, 12, 2)),
										Число(Сред(СтрВремяАкцепта, 15, 2)),
										Число(Сред(СтрВремяАкцепта, 18, 2)));
																	
						НоваяСтрока = Новый Структура();
						НоваяСтрока.Вставить("НомерПП",				Excel.Cells(НомСтр, 1).Value);   		
						НоваяСтрока.Вставить("ДатаПП",				Дата(Excel.Cells(НомСтр, 2).Value + " 00:00:00")); 
						НоваяСтрока.Вставить("ДатаАкцепта",			ВремяАкцепта); 
						НоваяСтрока.Вставить("ДатаОбработкиБанком",	НачалоДня(ВремяАкцепта)); 
						НоваяСтрока.Вставить("СчетПлательщика",		СчетПлательщика); 
						НоваяСтрока.Вставить("СуммаПП",				Excel.Cells(НомСтр, 3).Value); 
						НоваяСтрока.Вставить("НазначениеПП",		Excel.Cells(НомСтр, 11).Value); 
						НоваяСтрока.Вставить("СтатусАкцепта",		"Акцептовано"); 
						
						ДанныеАкцептов.Добавить(НоваяСтрока);
											
					Иначе 
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверное время акцепта в строке файла №" + Формат(НомСтр, "ЧГ=0"));
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			НомСтр = НомСтр + 1;
			
		КонецЦикла;
		
		Excel.DisplayAlerts = 0;
		Excel.ActiveWorkbook.Close();
			
		Если Excel <> Неопределено Тогда
			Excel.DisplayAlerts = 1;
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Excel);
		КонецЕсли;
	
	Исключение
		
		Если Excel <> Неопределено Тогда
			Excel.DisplayAlerts = 1;
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(Excel);
		КонецЕсли;
		
		ВызватьИсключение;	
		
	КонецПопытки;
		
	Если ДанныеАкцептов.Количество() = 0 Тогда		
		Возврат;
	КонецЕсли;
	
	ОбработатьМассивСАкцептами(ДанныеАкцептов);

	ОбновитьСтрокиБанковскойВыписки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КаталогВыпискиДляОрганизации(Организация)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ПрочиеНастройки.ПутьКФайлуДляЗагрузкиБанковскихВыписок", Организация, Неопределено);
	
КонецФункции

&НаСервере
Процедура АкцептоватьНаСервере(ПОВыгрузкиФайлов = "РЭМ")
	
	Если ПОВыгрузкиФайлов = "РЭМ" Тогда		
		//подготовим список акцептантов, для которых есть соответствие 
		Запрос = Новый Запрос;
		Запрос.Текст = 

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК Акцептант,
		|	ЗначенияДополнительныхСведений.Объект КАК ЮрфизЛицо
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""БанковскиеВыписки.Акцептант""";
		
		Акцептанты = Запрос.Выполнить().Выгрузить();
	Иначе
		Акцептанты = Новый ТаблицаЗначений;
		Акцептанты.Колонки.Добавить("Акцептант", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
		Акцептанты.Колонки.Добавить("ЮрФизЛицо", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));		
	КонецЕсли; 
	
	Если ПОВыгрузкиФайлов = "РЭМ" Тогда
		ТекстФайла = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресХранилища);
		ОбработатьТекстФайлаСАкцептами(ТекстФайла, Акцептанты, ПОВыгрузкиФайлов);
	Иначе		  		
		Архив = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресХранилища);
		ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
		Архив.Записать(ИмяФайлаАрхива);
		
		ИмяКаталога = СтрЗаменить(ИмяФайлаАрхива, ".zip", "_Акцепты");
		ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
		ЧтениеАрхива.ИзвлечьВсе(ИмяКаталога);		
		
		МассивФайлов = НайтиФайлы(ИмяКаталога, "*.bcw");
		Для Каждого ТекФайл Из МассивФайлов Цикл
			ТекстФайла = Новый ТекстовыйДокумент;
			ТекстФайла.Прочитать(ТекФайл.ПолноеИмя, "windows-1251");
			ОбработатьТекстФайлаСАкцептами(ТекстФайла.ПолучитьТекст(), Акцептанты, ПОВыгрузкиФайлов);
		КонецЦикла;		
		
		// Удаляем все файлы
		УдалитьФайлы(ИмяКаталога);
		УдалитьФайлы(ИмяФайлаАрхива);
	КонецЕсли;    	
	
КонецПроцедуры                                                                                                                                          

&НаСервере
Процедура ОбработатьТекстФайлаСАкцептами(ТекстФайла, Акцептанты, ПОВыгрузкиФайлов)
	                 	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ПакетДокументовDOM = ДокументDOM.ДочерниеУзлы[0];
	
	Для каждого ДокDOM Из ПакетДокументовDOM.ДочерниеУзлы Цикл
		
		Акцептование = Новый Структура("Дата,Лицо,Организация,НомерПП,ДатаПП,НазначениеПП,СуммаПП,Валюта");
		
		ОНО = Ложь;
		
		Если ПОВыгрузкиФайлов = "РЭМ" Тогда
		
			Для каждого ПолеDOM Из ДокDOM.ДочерниеУзлы Цикл
				
				ИДПоля = ПолеDOM.ПолучитьАтрибут("id");
				Если ИДПоля = "FLDSIGN" Тогда //это подписание
					
					СекцияDOM = ПолеDOM.ДочерниеУзлы[0];
					
					Для каждого КлючDOM Из СекцияDOM.ДочерниеУзлы Цикл
						Если КлючDOM.ПолучитьАтрибут("id") = "STATE" Тогда
							Если Обрезать(КлючDOM.ТекстовоеСодержимое) = "100" Тогда
								ОНО = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					Если ОНО Тогда
					
						Для каждого КлючDOM Из СекцияDOM.ДочерниеУзлы Цикл
							
							ИДКлюча = КлючDOM.ПолучитьАтрибут("id");
							Если ИДКлюча = "ANSRECDATE" Тогда //дата-время акцептования
								
								ДатаАкцСтрока = Обрезать(КлючDOM.ТекстовоеСодержимое);
								Акцептование.Дата = Дата(Лев(ДатаАкцСтрока, 4), Сред(ДатаАкцСтрока, 6, 2), Сред(ДатаАкцСтрока, 9, 2), 
													Сред(ДатаАкцСтрока, 12, 2), Сред(ДатаАкцСтрока, 15, 2), Сред(ДатаАкцСтрока, 18, 2));
								
							ИначеЕсли ИДКлюча = "ORIGINAL" Тогда //лицо акцептования
								
								Акцептование.Лицо = Обрезать(КлючDOM.ТекстовоеСодержимое);
								
							ИначеЕсли ИДКлюча = "ORGSIGN" Тогда //орг-ция акцептования
								
								Акцептование.Организация = СтрЗаменить(СтрЗаменить(Обрезать(КлючDOM.ТекстовоеСодержимое), "ORG_", ""), "INT_", "" );
								
							КонецЕсли;
							
						КонецЦикла;
					
					КонецЕсли;
					
				ИначеЕсли ИДПоля = "OHD_NUMBER" Тогда //это номер п/п
					
					Акцептование.НомерПП = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					
				ИначеЕсли ИДПоля = "RD_PAY_PURPOSE" Тогда //это назначение п/п
					
					Акцептование.НазначениеПП = РаботаСоСтрокамиКлиентСервер.УдалитьПредставлениеУправляющихСимволов(Обрезать(ПолеDOM.ТекстовоеСодержимое));
					
				ИначеЕсли ИДПоля = "OHD_DATE" Тогда //это дата п/п
					
					ДатаППСтрока = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					Акцептование.ДатаПП = Дата(Сред(ДатаППСтрока, 5, 4), Сред(ДатаППСтрока, 3, 2), Лев(ДатаППСтрока, 2));
					
				ИначеЕсли ИДПоля = "OHD_AMOUNT" Тогда //это сумма п/п
					
					Акцептование.СуммаПП = Число(Обрезать(ПолеDOM.ТекстовоеСодержимое));
					
				ИначеЕсли ИДПоля = "OHD_CURRENCY" Тогда // это валюта перевода
					
					Акцептование.Валюта = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			СтрНачалоИмениБлокаСАкцептом = "";
			Для каждого ПолеDOM Из ДокDOM.ДочерниеУзлы Цикл
												
				ИДПоля = ПолеDOM.ПолучитьАтрибут("id");
				
				// Данные об акцептовании находятся в блоках NOTIFY_N__DD_MESSAGE, где _N_ - порядковый номер (NOTIFY1_DD_MESSAGE, NOTIFY2_DD_MESSAGE, NOTIFY3_DD_MESSAGE)
				Если СтрНайти(ИДПоля, "NOTIFY") > 0 И СтрНайти(ИДПоля, "_DD_MESSAGE") > 0  Тогда
					
					Если Обрезать(ПолеDOM.ТекстовоеСодержимое) = "[26]Акцептовано" Тогда
						ОНО = Истина;
						ПервоеПодчеркивание = СтрНайти(ИДПоля, "_");
						СтрНачалоИмениБлокаСАкцептом = Лев(ИДПоля, ПервоеПодчеркивание);
					КонецЕсли;    					        							
									
				ИначеЕсли (СтрНачалоИмениБлокаСАкцептом <> "") И (ИДПоля = СтрНачалоИмениБлокаСАкцептом + "OH_RECEIVEDATE") Тогда //дата-время акцептования
					
					ДатаАкцСтрока = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					Акцептование.Дата = Дата(Сред(ДатаАкцСтрока, 5, 4), Сред(ДатаАкцСтрока, 3, 2), Лев(ДатаАкцСтрока, 2), 
										Сред(ДатаАкцСтрока, 9, 2), Сред(ДатаАкцСтрока, 11, 2), Сред(ДатаАкцСтрока, 13, 2));											
										
				ИначеЕсли ИДПоля = "OHD_NUMBER" Тогда //это номер п/п
					
					Акцептование.НомерПП = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					
				ИначеЕсли ИДПоля = "RD_PAY_PURPOSE" Тогда //это назначение п/п
					
					Акцептование.НазначениеПП = РаботаСоСтрокамиКлиентСервер.УдалитьПредставлениеУправляющихСимволов(Обрезать(ПолеDOM.ТекстовоеСодержимое));
					
				ИначеЕсли ИДПоля = "OHD_DATE" Тогда //это дата п/п
					
					// Изменено 
					ДатаППСтрока = Обрезать(ПолеDOM.ТекстовоеСодержимое);
					Акцептование.ДатаПП = Дата(Сред(ДатаППСтрока, 5, 4), Сред(ДатаППСтрока, 3, 2), Лев(ДатаППСтрока, 2));
					
				ИначеЕсли ИДПоля = "OHD_AMOUNT" Тогда //это сумма п/п
					
					Акцептование.СуммаПП = Число(Обрезать(ПолеDOM.ТекстовоеСодержимое));
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ОНО = Ложь Тогда
			Продолжить;
		КонецЕсли;
				
		Запрос = Новый Запрос;
		
		#Область ТЕКСТ_ЗАПРОСА
		
		// Для валютных и рублевых акцептов отдельные тексты запроса
		
		Если Не ЗначениеЗаполнено(Акцептование.Валюта) Тогда // рублевые
			#Область ТЕКСТ_ЗАПРОСА_РУБЛИ
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Акцептанты.Акцептант КАК Акцептант,
				|	Акцептанты.ЮрФизЛицо КАК ЮрФизЛицо
				|ПОМЕСТИТЬ Акцептанты
				|ИЗ
				|	&Акцептанты КАК Акцептанты
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтрокаБанковскойВыписки.Ссылка КАК Ссылка,
				|	ЕСТЬNULL(Акцептанты.ЮрФизЛицо, """") КАК Акцептант,
				|	ЕСТЬNULL(АкцептованиеОпераций.Регистратор, """") КАК Регистратор
				|ПОМЕСТИТЬ _СтрокаБанковскойВыписки
				|ИЗ
				|	Документ.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
				|		ЛЕВОЕ СОЕДИНЕНИЕ Акцептанты КАК Акцептанты
				|		ПО (&АкцептованиеОрганизация = Акцептанты.Акцептант)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций КАК АкцептованиеОпераций
				|		ПО (СтрокаБанковскойВыписки.Ссылка = (ВЫРАЗИТЬ(АкцептованиеОпераций.Операция КАК Документ.СтрокаБанковскойВыписки)))
				|ГДЕ
				|	СтрокаБанковскойВыписки.Организация = &Организация
				|	И СтрокаБанковскойВыписки.НомерПлатежногоДокумента = &НомерПлатежногоДокумента
				|	И СтрокаБанковскойВыписки.ДатаПлатежногоДокумента = &ДатаПлатежногоДокумента
				|	И НЕ СтрокаБанковскойВыписки.ПометкаУдаления
				|	И СтрокаБанковскойВыписки.Сумма = &Сумма
				|	И (СтрокаБанковскойВыписки.НазначениеПлатежа = &НазначениеПлатежа
				|			ИЛИ СтрокаБанковскойВыписки.НазначениеПлатежа = &НазначениеПлатежаБезНомера)
				|	И СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
