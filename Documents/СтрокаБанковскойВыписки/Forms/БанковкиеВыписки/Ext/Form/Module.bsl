Функция ОпределитьДепозитныйВклад(ЮрЛицоБанка, Знач НазначениеПлатежа)
	
	НазначениеПлатежа = НРег(НазначениеПлатежа);
	
	ПозПоДоговору = Найти(НазначениеПлатежа, "по договору");
	
	Если ПозПоДоговору = 0 Тогда
		Возврат Справочники.ДепозитныеВклады.ПустаяСсылка();
	КонецЕсли;
	
	НазначениеПлатежа = Сред(НазначениеПлатежа, ПозПоДоговору + 12);
	НазначениеПлатежа = СокрЛП(НазначениеПлатежа);
	
	ПозПробел = Найти(НазначениеПлатежа, " ");
	
	Если ПозПробел = 0 Тогда
		НомерДоговора     = НазначениеПлатежа;
	Иначе
		НазначениеПлатежа = Лев(НазначениеПлатежа, ПозПробел);
		НомерДоговора     = СокрЛП(НазначениеПлатежа);
	КонецЕсли;                                                                      
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|ГДЕ
		|	ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора = &НомерДоговора
		|	И ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо = &ЮрЛицоБанка";

	Запрос.УстановитьПараметр("ЮрЛицоБанка",   ЮрЛицоБанка);
	Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() = 1 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	Иначе
		Возврат Справочники.ДепозитныеВклады.ПустаяСсылка();
	КонецЕсли;

КонецФункции // ОпределитьДепозитныйВклад

