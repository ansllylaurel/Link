&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.Здание.Видимость = ЭтоДДУ(ДанныеОбъекта.ВидПраваНаНедвижимость);
	Элементы.Основание.Видимость = ДанныеОбъекта.Изменение;
	Элементы.ОбъектыНедвижимостиСрок.Видимость = ДанныеОбъекта.ВидПраваНаНедвижимость <> ПредопределенноеЗначение("Перечисление.ВидыПравНаНедвижимость.Аренда");
	
КонецПроцедуры // НастроитьВидимостьИДоступность

&НаСервереБезКонтекста
Функция ЭтоДДУ(ВидПраваНаНедвижимость)
	
	Возврат ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ;
	
КонецФункции

&НаСервере
Процедура ОчиститьЗдание()
	
	Объект.Здание = Справочники.ОбъектыНедвижимости.ПустаяСсылка();
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
	РаботаСФормами.ЗаполнитьДополнительныеСвязиИПараметрыВыбора(Элементы.Договор, "СчетДоверительногоУправления");
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ИзменениеПриИзменении(Элемент)
	
	ЭтаФорма.Элементы.Основание.Видимость = Объект.Изменение;
	Если НЕ Объект.Изменение Тогда
		Объект.Основание = ПредопределенноеЗначение("Документ.СделкаСНедвижимостью.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПраваНаНедвижимостьПриИзменении(Элемент)
	
	Если НЕ ЭтоДДУ(Объект.ВидПраваНаНедвижимость) Тогда
		ОчиститьЗдание();
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыНедвижимостиСтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.ОбъектыНедвижимости.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте 
Процедура РассчитатьСуммуНДС(ТекущиеДанные)
	
	СтавкаНДС = РаботаСНалогамиКлиентСервер.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);

	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * СтавкаНДС/(100 + СтавкаНДС);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбъектыНедвижимостиСуммаПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.ОбъектыНедвижимости.ТекущиеДанные);
	
КонецПроцедуры


&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	НастроитьВидимостьИДоступность(ЭтаФорма);
КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

