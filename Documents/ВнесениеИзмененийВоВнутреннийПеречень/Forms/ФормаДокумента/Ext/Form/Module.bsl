		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.ПравоеЗначение	= КатегорияДляКоторойУказываетсяСотрудник;
		ЭлементОтбора.Использование		= Истина;
		
	КонецЦикла; 
	
	ЭлементОтбора = ЭлементФормления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Объект.ВидПеречня");
	ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение	= Справочники.ВидыПеречнейОбъектов.Инсайдеры;
	ЭлементОтбора.Использование		= Истина;
	
	ПолеФормления = ЭлементФормления.Поля.Элементы.Добавить();
	ПолеФормления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОснованияСотрудник.Имя);
	ПолеФормления.Использование = Истина;
	
#КонецОбласти
	
#Область Доступность

	ЭлементФормления = УсловноеОформление.Элементы.Добавить();
	ЭлементФормления.Оформление.УстановитьЗначениеПараметра("Доступность", Истина);
	ЭлементФормления.Использование = Истина;
	
	ГруппаКатегория = ЭлементФормления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаКатегория.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	Для Каждого КатегорияДляКоторойУказываетсяСотрудник Из КатегорииДляКоторыхУказываетсяСотрудник Цикл
		
		ЭлементОтбора = ГруппаКатегория.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Объект.Основания.Категория");
		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение	= КатегорияДляКоторойУказываетсяСотрудник;
		ЭлементОтбора.Использование		= Истина;
		
	КонецЦикла;
		
	ЭлементОтбора = ЭлементФормления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Объект.ВидПеречня");
	ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение	= Справочники.ВидыПеречнейОбъектов.Инсайдеры;
	ЭлементОтбора.Использование		= Истина;
	
	ПолеФормления = ЭлементФормления.Поля.Элементы.Добавить();
	ПолеФормления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОснованияСотрудник.Имя);
	ПолеФормления.Использование = Истина;
	
#КонецОбласти	

#Область ЦветИНадпись

	ЭлементФормления = УсловноеОформление.Элементы.Добавить();
	ЭлементФормления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(169,169,169));
	ЭлементФормления.Оформление.УстановитьЗначениеПараметра("Текст", "Сотрудник указывается только для категорий " + СтрСоединить(КатегорииДляКоторыхУказываетсяСотрудник, ", "));
	ЭлементФормления.Использование = Истина;
	
	Для Каждого КатегорияДляКоторойУказываетсяСотрудник Из КатегорииДляКоторыхУказываетсяСотрудник Цикл
		
		ЭлементОтбора = ЭлементФормления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Объект.Основания.Категория");
		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементОтбора.ПравоеЗначение	= КатегорияДляКоторойУказываетсяСотрудник;
		ЭлементОтбора.Использование		= Истина;
		
	КонецЦикла;
	
	ЭлементОтбора = ЭлементФормления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Объект.ВидПеречня");
	ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение	= Справочники.ВидыПеречнейОбъектов.Инсайдеры;
	ЭлементОтбора.Использование		= Истина;
	
	ПолеФормления = ЭлементФормления.Поля.Элементы.Добавить();
	ПолеФормления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОснованияСотрудник.Имя);
	ПолеФормления.Использование = Истина;
	
#КонецОбласти
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждающиеДокументыНаСервере()
	
	Если СтруктураПодтверждающихДокументов = Неопределено Тогда 
		ЭтаФорма.ПодтверждающиеДокументы = "";
		Возврат;
	КонецЕсли;
			
	Результат = "";
	Для Каждого КлючИЗначение Из СтруктураПодтверждающихДокументов Цикл
		Результат = ?(ПустаяСтрока(Результат), "", Результат + "; ") + КлючИЗначение.Значение;
	КонецЦикла;
	
	ЭтаФорма.ПодтверждающиеДокументы = Результат;
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимоОбновитьТабличнуюЧастьВидовАктивов()
	
	Если Объект.ВидПеречня <> ПредопределенноеЗначение("Справочник.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы") Тогда		
		Возврат Ложь;		
	ИначеЕсли Объект.ВидыАктивовКвалифицированныхИнвесторов.Количество() = 0 Тогда
		Возврат Истина;
	ИначеЕсли Объект.ВидИзменения = ПредопределенноеЗначение("Перечисление.ВидыИзмененийПеречней.Включение") Тогда
		Возврат Ложь;	
	КонецЕсли;		
		
	Возврат Вопрос("Обновить таблицу видов активов по текущим параметрам?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

#КонецОбласти 

#Область Работа_с_шаблонами

&НаКлиенте
Процедура КомандаНастройкаШаблонов_Подключаемый(Команда)
	
	ИмяЭлемента	= СтрРазделить(Команда.Имя, "_")[1];
	Результат	= ОткрытьФормуМодально("ОбщаяФорма.ФормаСпискаШаблонов", Новый Структура("СписокШаблонов", ЭтаФорма["СписокШаблонов_" + ИмяЭлемента])); 
	
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		СохранитьСписокШаблоновНаСервере(Результат, ИмяЭлемента);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере 
Процедура СохранитьСписокШаблоновНаСервере(СписокШаблонов, ИмяЭлемента)

	РаботаСФормами.СохранитьСписокШаблонов(ЭтаФорма, ИмяЭлемента, СписокШаблонов);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореШаблона_Подключаемый(Команда)
	
	РаботаСФормамиКлиент.ПриВыбореШаблона(ЭтаФорма, Команда);
	
КонецПроцедуры

#КонецОбласти