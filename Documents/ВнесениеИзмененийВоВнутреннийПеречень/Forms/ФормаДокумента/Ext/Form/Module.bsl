
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьСотрудника();
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ВидыПеречнейОбъектов = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыПеречнейОбъектов");
	ВидыИзмененийПеречней = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыИзмененийПеречней");
	
	Если Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаНАУФОР
	 ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаПН Тогда
		Если Объект.ВидИзменения = ВидыИзмененийПеречней.Включение
			ИЛИ Объект.ВидИзменения = ВидыИзмененийПеречней.Изменение Тогда
			
			Если ЭтаФорма.ФлагДолжностноеЛицоЧленСоветаДиректоров = Ложь Тогда
				Объект.ДолжностьЧленаСоветаДиректоров = Неопределено;
			КонецЕсли;
			
			Если ЭтаФорма.ФлагДолжностноеЛицоСотрудник = Ложь Тогда
				Объект.Основания.Очистить();
			КонецЕсли;
			
		Иначе
			ЭтаФорма.ФлагДолжностноеЛицоЧленСоветаДиректоров = Ложь;
			ЭтаФорма.ФлагДолжностноеЛицоСотрудник = Ложь;
			Объект.ДолжностьЧленаСоветаДиректоров = Неопределено;
			Объект.Основания.Очистить();
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы И ТипЗнч(ЭтаФорма.СтруктураПодтверждающихДокументов) = Тип("Структура") Тогда		
		ТекущийОбъект.ПодтверждающиеДокументыКвалифицированногоИнвестора = Новый ХранилищеЗначения(ЭтаФорма.СтруктураПодтверждающихДокументов, Новый СжатиеДанных(9));		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	ЗаполнитьДолжностьИПодразделение();
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ВидПеречняПриИзменении(Элемент)
			
	Если НеобходимоОбновитьТабличнуюЧастьВидовАктивов() Тогда
		ОбновитьВидыАктивовНаСервере();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ОснованияНормативныйАктНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОбластьПрименения, Дата", 
		ПредопределенноеЗначение("Перечисление.ОбластиПримененияНормативныхАктов.ОснованияВключенияВСписокИнсайдеров"), 
		Объект.Дата);
		
	ОткрытьФорму("Справочник.НормативныеАкты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияКатегорияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОбластьПрименения, Дата", 
		ПредопределенноеЗначение("Перечисление.ОбластиПримененияНормативныхАктов.КатегорииИнсайдеров"), 
		Объект.Дата);
		
	ОткрытьФорму("Справочник.НормативныеАкты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если Объект.Основания.Количество() Тогда
		ЗаполнитьДолжностьИПодразделение();
	КонецЕсли;
	
	Если НеобходимоОбновитьТабличнуюЧастьВидовАктивов() Тогда
		ОбновитьВидыАктивовНаСервере();
	КонецЕсли;
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованияНормативныйАктПриИзменении(Элемент)
	
	ТекДанные = Элементы.Основания.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.НормативныйАкт) И Не ЗначениеЗаполнено(ТекДанные.Основание) Тогда
	
		ТекДанные.Основание = ТекДанные.НормативныйАкт;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидИзмененияПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ФлагДолжностноеЛицоЧленСоветаДиректоровПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ФлагДолжностноеЛицоСотрудникПриИзменении(Элемент)
	
	НастроитьВидимостьДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОснованияСотрудникПриИзменении(Элемент)
	
	ЗаполнитьДолжностьИПодразделение();
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаПодтверждающиеДокументы(Команда)
	
	Результат = ОткрытьФормуМодально("Документ.ВнесениеИзмененийВоВнутреннийПеречень.Форма.ФормаРедактированияТребований", Новый Структура("Дата, ВидЮрФизЛица, СтруктураПодтверждающихДокументов", Объект.Дата, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Объект, "ВидЮрФизЛица"), СтруктураПодтверждающихДокументов), ЭтаФорма);
	
	// Открыли и закрыли форму, изменения данных нет
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПодтверждающихДокументов = Результат;
	
	ЗаполнитьПодтверждающиеДокументыНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ДолжностныеЛица = (Объект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ДолжностныеЛицаНАУФОР ИЛИ Объект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.ДолжностныеЛицаПН);
	
	ЭтаФорма.ФлагДолжностноеЛицоЧленСоветаДиректоров	= (ДолжностныеЛица И ЗначениеЗаполнено(Объект.ДолжностьЧленаСоветаДиректоров));
	ЭтаФорма.ФлагДолжностноеЛицоСотрудник				= (ДолжностныеЛица И Объект.Основания.Количество() > 0);
	
	Если Объект.Основания.Количество() Тогда
		ЗаполнитьДолжностьИПодразделение();
	КонецЕсли;
	
	Если Объект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы Тогда
		ОбъектДокумента = РеквизитФормыВЗначение("Объект");
		ЭтаФорма.СтруктураПодтверждающихДокументов = ОбъектДокумента.ПодтверждающиеДокументыКвалифицированногоИнвестора.Получить();	
	КонецЕсли;
		
	НастроитьВидимостьДоступность(ЭтаФорма);
	
	РаботаСФормами.ЗагрузитьСписокШаблонов(ЭтаФорма, "ОснованияОснование"); 
	
	ЗаполнитьПодтверждающиеДокументыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидыАктивовНаСервере()
	
	Если Не (ЗначениеЗаполнено(Объект.Организация) 
			И ЗначениеЗаполнено(Объект.Объект) 
			И Объект.Дата <> '00010101') Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ВидыАктивовКвалифицированныхИнвесторов.Очистить();
		
	// Получаем действующий список активов
	РезультатЗапроса = Документы.ВнесениеИзмененийВоВнутреннийПеречень.РезультатЗапросаПоВидамАктивов(Объект.Организация, Объект.Объект, ?(Объект.Ссылка.Пустая(), Объект.Дата, Объект.Ссылка.МоментВремени()));
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.ВидыАктивовКвалифицированныхИнвесторов.Добавить();
		НоваяСтрока.ВидАктива = Выборка.ВидАктива;
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоФизЛицо(ЮрФизЛицо) 

	ВидЮрФизЛица = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ВидЮрФизЛица");
	Возврат (ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо);

КонецФункции
 
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступность(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидыПеречнейОбъектов = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру("ВидыПеречнейОбъектов");
	ВидыИзмененийПеречней = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру("ВидыИзмененийПеречней");
	
	ДолжностныеЛица = (Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаНАУФОР ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаПН);
	
	Элементы.ГруппаФлагиДолжностныеЛица.Видимость		= (ДолжностныеЛица
															И (Объект.ВидИзменения = ВидыИзмененийПеречней.Включение
																ИЛИ Объект.ВидИзменения = ВидыИзмененийПеречней.Изменение));
	
	Элементы.ДолжностьЧленаСоветаДиректоров.Видимость	= Форма.ФлагДолжностноеЛицоЧленСоветаДиректоров;
	Элементы.Основание.Видимость						= Форма.ФлагДолжностноеЛицоЧленСоветаДиректоров;
	
	Элементы.Основания.Видимость = (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры 
									ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ
									ИЛИ (Элементы.ГруппаФлагиДолжностныеЛица.Видимость И Форма.ФлагДолжностноеЛицоСотрудник));
														
	Элементы.ОбъектИнсайдерскойИнформации.Видимость = (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры);
	
	Если Элементы.Основания.Видимость Тогда
		Элементы.ОснованияСотрудник.Видимость = (ДолжностныеЛица
													ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ
													ИЛИ (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры
															И ЗначениеЗаполнено(Объект.Объект) 
															И ЭтоФизЛицо(Объект.Объект)));
															
		Элементы.ГруппаДолжностьИПодразделение.Видимость = Элементы.ОснованияСотрудник.Видимость;
														
		Элементы.ОснованияНормативныйАкт.Видимость	= (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры 
														И Объект.Дата < Дата(2021,10,1) 
														И ЗначениеЗаполнено(Объект.Дата));
														
		Элементы.ОснованияОснование.Видимость	= (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры);
		Элементы.ОснованияКатегория.Видимость	= (Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры);
														
	КонецЕсли;
	
	Если Объект.ВидПеречня = ВидыПеречнейОбъектов.Инсайдеры Тогда
		Элементы.Объект.Заголовок = "Инсайдер";
		
	ИначеЕсли Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаНАУФОР
	   ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.ДолжностныеЛицаПН Тогда
		Элементы.Объект.Заголовок = "Должностное лицо";
		
	ИначеЕсли Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиОбеспечивающиеДеятельностьУК ИЛИ Объект.ВидПеречня = ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ Тогда
		Элементы.Объект.Заголовок = "Сотрудник";
		
	ИначеЕсли Объект.ВидПеречня = ВидыПеречнейОбъектов.ЛицаОзнакомленныеСКодексами Тогда
		Элементы.Объект.Заголовок = "Физическое лицо";
		
	ИначеЕсли Объект.ВидПеречня = ВидыПеречнейОбъектов.КвалифицированныеИнвесторы Тогда
		Элементы.Объект.Заголовок = "Квалифицированный инвестор";
		
	Иначе
		Элементы.Объект.Заголовок = "Объект";
		
	КонецЕсли;
	
	Форма.ПериодСотрудников = ?(Объект.ВидИзменения = ВидыИзмененийПеречней.Исключение, Объект.Дата - 86400, Объект.Дата);

	Элементы.ВидыАктивовКвалифицированныхИнвесторов.Видимость = Объект.ВидПеречня = ВидыПеречнейОбъектов.КвалифицированныеИнвесторы;
	Элементы.ГруппаПодтверждающиеДокументы.Видимость = Объект.ВидПеречня = ВидыПеречнейОбъектов.КвалифицированныеИнвесторы
									И Объект.ВидИзменения <> ВидыИзмененийПеречней.Исключение;
	Элементы.ПричинаИсключенияКвалифицированногоЛица.Видимость = Объект.ВидПеречня = ВидыПеречнейОбъектов.КвалифицированныеИнвесторы
									И Объект.ВидИзменения <> ВидыИзмененийПеречней.Включение;								
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДолжностьИПодразделение()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Сотрудники", Объект.Основания.Выгрузить(, "Сотрудник"));
	Запрос.УстановитьПараметр("Период", 	Объект.Дата);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник КАК Сотрудник,
		|	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность,
		|	СотрудникиОрганизацииСрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Период, Сотрудник В (&Сотрудники)) КАК СотрудникиОрганизацииСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаОснования Из Объект.Основания Цикл
			Если Выборка.Сотрудник = СтрокаОснования.Сотрудник Тогда
				СтрокаОснования.Должность		= Выборка.Должность;
				СтрокаОснования.Подразделение	= Выборка.Подразделение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
КонецПроцедуры

Процедура УстановитьДоступностьСотрудника()
	
	//#ТехДолг Добродеев: надо создать общий модуль УправлениеУсловнымОформлением и перенести это всё туда
	КатегорииДляКоторыхУказываетсяСотрудник = Новый Массив;
	КатегорииДляКоторыхУказываетсяСотрудник.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Пункт13статьи4Закона224"));
	КатегорииДляКоторыхУказываетсяСотрудник.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("пункт7статьи4Закона224"));
	
#Область Недоступность

	ЭлементФормления = УсловноеОформление.Элементы.Добавить();
	ЭлементФормления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементФормления.Использование = Истина;
	
	Для Каждого КатегорияДляКоторойУказываетсяСотрудник Из КатегорииДляКоторыхУказываетсяСотрудник Цикл
		
