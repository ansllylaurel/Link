					ДанныеЗаявления.Вставить("Документ",		Документ);
					
				КонецЕсли;
				
				ДобавитьДанныеОПодтверждающихДокументахВСтруктуруДанных(ДанныеЗаявления, СтруктураПодтверждающихДокументов, 4);
				
			Иначе
				
				ДанныеЗаявления.Вставить("ФИО",				ДанныеОКлиентеДляЗаявления[0].Фамилия + " " + ДанныеОКлиентеДляЗаявления[0].Имя + " " + ДанныеОКлиентеДляЗаявления[0].Отчество);				
				ДанныеЗаявления.Вставить("Наименование",	ДанныеОКлиентеДляЗаявления[0].ПолноеНаименование);
				ДанныеЗаявления.Вставить("ОГРН",			ДанныеОКлиентеДляЗаявления[0].ОГРН);
				ДанныеЗаявления.Вставить("ИНН",				ДанныеОКлиентеДляЗаявления[0].ИНН);
				ДанныеЗаявления.Вставить("Адрес",			ДанныеОКлиентеДляЗаявления[0].ЮридическийАдрес);
				
			КонецЕсли;
			
			#КонецОбласти
			
		Иначе
			
			#Область Физическое_лицо
			
			ДанныеЗаявления.Вставить("ФИО",					ДанныеОКлиентеДляЗаявления[0].Фамилия + " " + ДанныеОКлиентеДляЗаявления[0].Имя + " " + ДанныеОКлиентеДляЗаявления[0].Отчество);
			ДанныеЗаявления.Вставить("СерияПаспорта",		ДанныеОКлиентеДляЗаявления[0].СерияПаспорта);
			ДанныеЗаявления.Вставить("НомерПаспорта",		ДанныеОКлиентеДляЗаявления[0].НомерПаспорта);
			ДанныеЗаявления.Вставить("КемВыдан",			ДанныеОКлиентеДляЗаявления[0].КемВыдан);
			ДанныеЗаявления.Вставить("ДатаВыдачи",			Формат(ДанныеОКлиентеДляЗаявления[0].ДатаВыдачи, "ДФ=dd.MM.yyyy"));
			ДанныеЗаявления.Вставить("КодПодразделения",	ДанныеОКлиентеДляЗаявления[0].КодПодразделения);
			ДанныеЗаявления.Вставить("АдресРегистрации",	ДанныеОКлиентеДляЗаявления[0].АдресРегистрации);
			ДанныеЗаявления.Вставить("АдресПроживания",		ДанныеОКлиентеДляЗаявления[0].АдресПроживания);
			ДанныеЗаявления.Вставить("ИнициалыФамилия", 	ДанныеОКлиентеДляЗаявления[0].ИнициалыФамилия);
			
			Если ЗначениеЗаполнено(ДанныеОКлиентеДляЗаявления[0].Имя)
				И ЗначениеЗаполнено(ДанныеОКлиентеДляЗаявления[0].Отчество) Тогда
				ДанныеЗаявления.Вставить("Заявитель", ДанныеОКлиентеДляЗаявления[0].Фамилия + " " + Лев(ДанныеОКлиентеДляЗаявления[0].Имя, 1) + "." + Лев(ДанныеОКлиентеДляЗаявления[0].Отчество, 1) + ".");
			Иначе
				ДанныеЗаявления.Вставить("Заявитель", ДанныеОКлиентеДляЗаявления[0].Фамилия + " " + ДанныеОКлиентеДляЗаявления[0].Имя + " " + ДанныеОКлиентеДляЗаявления[0].Отчество);
			КонецЕсли;                              			
			
				
			Если ДанныеОбОрганизаци.Количество() > 0 Тогда
				ДанныеЗаявления.Вставить("Организация", 	ДанныеОбОрганизаци[0].НаименованиеОрганизации);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать не будет выполнена! Не удалось определить данные об организации.");
				Возврат Неопределено;
			КонецЕсли;
			
			Если ЭтаФорма.ЗаявлениеНаВключение Тогда
				
				ДанныеЗаявления.Вставить("Фамилия",				ДанныеОКлиентеДляЗаявления[0].Фамилия);
				ДанныеЗаявления.Вставить("Имя",					ДанныеОКлиентеДляЗаявления[0].Имя);
				ДанныеЗаявления.Вставить("Отчество",			ДанныеОКлиентеДляЗаявления[0].Отчество);
				ДанныеЗаявления.Вставить("ДатаРождения",		ДанныеОКлиентеДляЗаявления[0].ДатаРождения);
				ДанныеЗаявления.Вставить("МестоРождения",		ДанныеОКлиентеДляЗаявления[0].МестоРождения);
				ДанныеЗаявления.Вставить("РезидентРФ", 			ДанныеОКлиентеДляЗаявления[0].РезидентРФ);
				ДанныеЗаявления.Вставить("НеРезидентРФ", 		Не ДанныеОКлиентеДляЗаявления[0].РезидентРФ);
				ДанныеЗаявления.Вставить("ИНН",					ДанныеОКлиентеДляЗаявления[0].ИНН);
				
				Если ТипЗнч(ДанныеОКлиентеДляЗаявления[0].Гражданство) = Тип("СправочникСсылка.СтраныМира") 
					И ЗначениеЗаполнено(ДанныеОКлиентеДляЗаявления[0].Гражданство) Тогда
					Гражданство = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОКлиентеДляЗаявления[0].Гражданство, "НаименованиеПолное"); 
				Иначе
					Гражданство = " ";
				КонецЕсли; 
				
				ДанныеЗаявления.Вставить("Гражданство",			Гражданство);
				
				Если ТипЗнч(ДанныеОКлиентеДляЗаявления[0].ВидУдостоверенияЛичности) = Тип("СправочникСсылка.ВидыДокументовФизическихЛиц") 
					И ЗначениеЗаполнено(ДанныеОКлиентеДляЗаявления[0].ВидУдостоверенияЛичности) Тогда
					
					ПаспортРФ = ДанныеОКлиентеДляЗаявления[0].ВидУдостоверенияЛичности = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ;
					ПаспортИностранногоГражданина = ДанныеОКлиентеДляЗаявления[0].ВидУдостоверенияЛичности = Справочники.ВидыДокументовФизическихЛиц.ПаспортИностранногоГражданина;
					ИнойДокумент = Не (ПаспортРФ Или ПаспортИностранногоГражданина);
					
					Если ИнойДокумент Тогда
						Документ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОКлиентеДляЗаявления[0].ВидУдостоверенияЛичности, "Наименование"); 
					Иначе
						Документ = " ";					
					КонецЕсли; 		
					
					ДанныеЗаявления.Вставить("ПаспортРФ",		ПаспортРФ);
					ДанныеЗаявления.Вставить("ИнострДокумент",	ПаспортИностранногоГражданина);
					ДанныеЗаявления.Вставить("ИнойДокумент",	ИнойДокумент);
					ДанныеЗаявления.Вставить("Документ",		Документ);
					
				Иначе
					
					ДанныеЗаявления.Вставить("ПаспортРФ", 		Ложь);
					ДанныеЗаявления.Вставить("ИнострДокумент", 	Ложь);
					ДанныеЗаявления.Вставить("ИнойДокумент", 	Ложь);
					ДанныеЗаявления.Вставить("Документ",		" ");
					
				КонецЕсли; 				
				
				Адрес = ?(ЗначениеЗаполнено(ДанныеОКлиентеДляЗаявления[0].АдресРегистрации), ДанныеОКлиентеДляЗаявления[0].АдресРегистрации, ДанныеОКлиентеДляЗаявления[0].АдресПроживания);
				
				ДанныеЗаявления.Вставить("Индекс", 				" ");
				ДанныеЗаявления.Вставить("Регион", 				" ");
				ДанныеЗаявления.Вставить("Страна", 				" ");
				ДанныеЗаявления.Вставить("НаселенныйПункт", 	" ");
				ДанныеЗаявления.Вставить("Адрес", 				Адрес);
				ДанныеЗаявления.Вставить("Телефон", 			ДанныеОКлиентеДляЗаявления[0].Телефон);
				ДанныеЗаявления.Вставить("Факс", 				" ");
				ДанныеЗаявления.Вставить("ЭлектроннаяПочта", 	ДанныеОКлиентеДляЗаявления[0].ЭлектроннаяПочта);
								
			КонецЕсли; 
			
			ДанныеЗаявления.Вставить("ВсеВидыАктивов", 		ВидИзменения = Перечисления.ВидыИзмененийПеречней.Исключение);
			ДанныеЗаявления.Вставить("НеВсеВидыАктивов", 	ВидИзменения <> Перечисления.ВидыИзмененийПеречней.Исключение);
			
			ДобавитьДанныеОПодтверждающихДокументахВСтруктуруДанных(ДанныеЗаявления, СтруктураПодтверждающихДокументов, 5);
				  			
			Если ЗначениеЗаполнено(СтруктураДанныхСотрудникОрганизацииПринявшийЗаявление) Тогда
				ДанныеЗаявления.Вставить("Ответственный",	Строка(СтруктураДанныхСотрудникОрганизацииПринявшийЗаявление.КонтактноеЛицо));	
			КонецЕсли;
			
			#КонецОбласти
			
		КонецЕсли;
		
		ДобавитьВидыАктивовВСтруктуруДанных(ДанныеЗаявления, ЗаявлениеНаВключение, СписокВидовАктивовДоИзменения.ВыгрузитьЗначения(), СписокВидовАктивовИзДокумента.ВыгрузитьЗначения());
		
		ДанныеЗаявления.Вставить("Основание",		    ?(ЗначениеЗаполнено(ОснованиеУполномоченногоЛицаКлиента), ОснованиеУполномоченногоЛицаКлиента, "  ")); 
		ДанныеЗаявления.Вставить("ДеньЗаявления",		Формат(ДатаЗаявления, "ДФ=дд"));
		ДанныеЗаявления.Вставить("МесяцЗаявления",		Формат(ДатаЗаявления, "ДФ=MM"));
		ДанныеЗаявления.Вставить("ГодЗаявления",		Формат(ДатаЗаявления, "ДФ=гггг"));
		ДанныеЗаявления.Вставить("ДеньПоступления",		Формат(ДатаПоступленияЗаявления, "ДФ=дд"));
		ДанныеЗаявления.Вставить("МесяцПоступления",	Формат(ДатаПоступленияЗаявления, "ДФ=MM"));
		ДанныеЗаявления.Вставить("ГодПоступления",		Формат(ДатаПоступленияЗаявления, "ДФ=гггг"));
		
		ДанныеЗаявления.Вставить("ВсеВидыАктивов", 	ВидИзменения = Перечисления.ВидыИзмененийПеречней.Исключение);
		ДанныеЗаявления.Вставить("НеВсеВидыАктивов", 	ВидИзменения <> Перечисления.ВидыИзмененийПеречней.Исключение);
		
		Результат.Вставить("ДанныеЗаявления",	ДанныеЗаявления);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать не будет выполнена! Не удалось определить данные о клиенте для заполнения заявления.");
		Возврат Неопределено;
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Данные_для_уведомления
	
	Если ДанныеОКлиентеДляУведомления.Количество() > 0 Тогда
		
		Если ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			ДанныеУведомления.Вставить("Наименование",		ДанныеОКлиентеДляУведомления[0].ПолноеНаименование);
			ДанныеУведомления.Вставить("Адрес",				ДанныеОКлиентеДляУведомления[0].ЮридическийАдрес);
		Иначе
			ДанныеУведомления.Вставить("Наименование",		ДанныеОКлиентеДляУведомления[0].Фамилия + " " + ДанныеОКлиентеДляУведомления[0].Имя + " " + ДанныеОКлиентеДляУведомления[0].Отчество);
			ДанныеУведомления.Вставить("ИнициалыФамилия", 	ДанныеОКлиентеДляУведомления[0].ИнициалыФамилия);
			ДанныеУведомления.Вставить("Адрес",				ДанныеОКлиентеДляУведомления[0].АдресРегистрации);
		КонецЕсли;
		
		ДанныеУведомления.Вставить("Дата", Формат(ДатаЗаявления, "ДФ='dd.MM.yyyy''г.'''"));
		
		Если ЗначениеЗаполнено(СтруктураДанныхУполномоченноеЛицоОрганизации) Тогда
			ДанныеУведомления.Вставить("ОтветственныйДолжность",	СтруктураДанныхУполномоченноеЛицоОрганизации.Должность);
			ДанныеУведомления.Вставить("Ответственный",				Строка(СтруктураДанныхУполномоченноеЛицоОрганизации.КонтактноеЛицо));
		КонецЕсли;
		
		ДобавитьВидыАктивовВСтруктуруДанных(ДанныеУведомления, ЗаявлениеНаВключение, СписокВидовАктивовДоИзменения.ВыгрузитьЗначения(), СписокВидовАктивовИзДокумента.ВыгрузитьЗначения());
				
		РазрешеныПаи = СтрНайти(ДанныеУведомления["СделкиЦенныеБумагиИПФИ"], "паевых инвестиционных фондов") > 0;
		ДанныеУведомления.Вставить("ПокупкаПаевПлюс",	РазрешеныПаи);
		ДанныеУведомления.Вставить("ПокупкаПаевМинус", 	РазрешеныПаи);
		ДанныеУведомления.Вставить("ПричинаИсключения",	?(ПустаяСтрока(ПричинаИсключенияКвалифицированногоЛица), "  ", ПричинаИсключенияКвалифицированногоЛица));
		
		ДанныеУведомления.Вставить("ВсеВидыАктивов", 	ВидИзменения = Перечисления.ВидыИзмененийПеречней.Исключение);
		ДанныеУведомления.Вставить("НеВсеВидыАктивов", 	ВидИзменения <> Перечисления.ВидыИзмененийПеречней.Исключение);
		ДанныеУведомления.Вставить("Исключен", 			?(ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо, "исключено", "исключен"));
				
		Результат.Вставить("ДанныеУведомления",	ДанныеУведомления);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печать не будет выполнена! Не удалось определить данные о клиенте для заполнения уведомления.");
		Возврат Неопределено;
	КонецЕсли;
	
	#КонецОбласти
	
	Результат.Вставить("АдресШаблонов",		ПоместитьШаблоныВоВременноеХранилищеЗаявленияИУведомления());
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьАдресВСтруктуруДанных(ДанныеЗаявления, СтруктураАдреса, ПостфиксПолей = "");
	
	ДанныеЗаявления.Вставить("Индекс" + ПостфиксПолей, ?(ПустаяСтрока(СтруктураАдреса.Индекс), "  ", СтруктураАдреса.Индекс));
	
	ПредставлениеАдреса = СтруктураАдреса.ПредставлениеАдреса;
	
	// Страна Россия может быть не указана, но быть в представлении
	Если ПустаяСтрока(СтруктураАдреса.Страна) Тогда
		Если ВРЕГ(Лев(ПредставлениеАдреса, 6)) = "РОССИЯ" Тогда
			Страна = Лев(ПредставлениеАдреса, 6);
		Иначе
			Страна = "  ";
		КонецЕсли;
	КонецЕсли;
		
	ДанныеЗаявления.Вставить("Страна" + ПостфиксПолей, Страна);
	
	//Из представления удаляем индекс и страну, т. к. они уже получены      		
	ПредставлениеАдреса = ?(ПустаяСтрока(СтруктураАдреса.Индекс), ПредставлениеАдреса, СтрЗаменить(ПредставлениеАдреса, СтруктураАдреса.Индекс + ",", ""));
	ПредставлениеАдреса = СтрЗаменить(ПредставлениеАдреса, Страна + ",", "");
	ПредставлениеАдреса = СокрЛП(ПредставлениеАдреса);
	
	ДанныеЗаявления.Вставить("Адрес" + ПостфиксПолей, ПредставлениеАдреса);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьДанныеОПодтверждающихДокументахВСтруктуруДанных(ДанныеЗаявления, ПодтверждающиеДокументы, КоличествоСтрок)
	
	Для Сч = 1 По КоличествоСтрок Цикл
		ДанныеЗаявления.Вставить("Строка" + СокрЛП(Сч), "  ");
	КонецЦикла;
	
	Если ТипЗнч(ПодтверждающиеДокументы) = Тип("Структура") Тогда                               					
		РаботаСКоллекциями.ДополнитьСтруктуру(ДанныеЗаявления, ПодтверждающиеДокументы, Истина);
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВидыАктивовВСтруктуруДанных(ДанныеЗаявления, ЗаявлениеНаВключение, ВидыАктивовНаНачало, ВидыАктивовТекущие)
	
	// Заполнение по умолчанию
	ДанныеЗаявления.Вставить("Услуги", 						"-");
	ДанныеЗаявления.Вставить("СделкиЦенныеБумагиИПФИ", 		"-");
	ДанныеЗаявления.Вставить("ИныеФинансовыеИнструменты", 	"-");
	
	СтруктураИзменений = Документы.ВнесениеИзмененийВоВнутреннийПеречень.СформироватьСтруктуруИзмененийСоставаВидовАктивов(ВидыАктивовНаНачало, ВидыАктивовТекущие);
	
	СтруктураСтрокВидовАктивов = Новый Структура;
	
	ВидыАктивов = ?(ЗаявлениеНаВключение, СтруктураИзменений.ДобавленныеВидыАктивов, СтруктураИзменений.УдаленныеВидыАктивов);
	
	ГруппаУслуги				 = ОбщегоНазначения.ПолучитьИменованныйОбъект("ВидыАктивовКИ_Услуги");
	ГруппаСделкиИЦенныеБумаги	 = ОбщегоНазначения.ПолучитьИменованныйОбъект("ВидыАктивовКИ_СделкиИЦБ");
	ГруппаИныеФИ				 = ОбщегоНазначения.ПолучитьИменованныйОбъект("ВидыАктивовКИ_ИныеФИ");
	
	СоответствиеГрупп = Новый Соответствие;
	СоответствиеГрупп.Вставить(ГруппаУслуги, 				"Услуги");
	СоответствиеГрупп.Вставить(ГруппаСделкиИЦенныеБумаги, 	"СделкиЦенныеБумагиИПФИ");
	СоответствиеГрупп.Вставить(ГруппаИныеФИ, 				"ИныеФинансовыеИнструменты");
		
	Для Каждого ВидАктива Из ВидыАктивов Цикл
		
		Родитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАктива, "Родитель");
		
		ИмяГруппы = СоответствиеГрупп.Получить(Родитель);
		
		Если ИмяГруппы = Неопределено Тогда
			ВызватьИсключение "Не найдено соответствие виду актива '" + СокрЛП(Родитель) + "' в печатной форме";	
		КонецЕсли;
		
		СтруктураСтрокВидовАктивов.Вставить(ИмяГруппы, 	
				?(СтруктураСтрокВидовАктивов.Свойство(ИмяГруппы), 
				СтруктураСтрокВидовАктивов[ИмяГруппы] + Символы.ВК + " - " + СокрЛП(ВидАктива), 
				" - " + СокрЛП(ВидАктива)));
		
	КонецЦикла;
	
	РаботаСКоллекциями.ДополнитьСтруктуру(ДанныеЗаявления, СтруктураСтрокВидовАктивов, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьШаблонWord(ДокументWord, ДанныеДляЗаполнения)
	
	ПеременныеДокумента = ДокументWord.Variables;
	ПоляДокумента = ДокументWord.FormFields;
	
	Для Каждого КлючИЗначение из ДанныеДляЗаполнения Цикл
		
		Попытка
			// ищем переменные
			Переменная = ПеременныеДокумента.Item(КлючИЗначение.Ключ);
			Переменная.Value = КлючИЗначение.Значение;
		Исключение
		КонецПопытки;
		
		Попытка
			// ищем чек-боксы
			Поле = ПоляДокумента.Item(КлючИЗначение.Ключ);
			Поле.CheckBox.Value = КлючИЗначение.Значение;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	ДокументWord.Fields.Update();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИПоказатьШаблон(WordApp, ФайлШаблона, ДанныеДляЗаполнения)
	
	НовыйДокумент = WordApp.Application.Documents.Add(ФайлШаблона, Ложь, , Истина);
	
	ЗаполнитьШаблонWord(НовыйДокумент, ДанныеДляЗаполнения);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьШаблоныВоВременноеХранилищеЗаявленияИУведомления()
	
	Если ЭтаФорма.ЗаявлениеНаВключение Тогда
		ИмяМакета = "ЗаявлениеОПризнанииКвалифицированнымИнвестором";
	Иначе
		ИмяМакета = "ЗаявлениеНаИсключениеИзРеестраКвалифицированныхИнвесторов";
	КонецЕсли;
	
	ИмяМакета = ИмяМакета + ?(Клиент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо, "ФЛ", "ЮЛ");
	ДанныеЗаявления = Документы.ВнесениеИзмененийВоВнутреннийПеречень.ПолучитьМакет(ИмяМакета);
	
	Шаблоны = Новый Структура;
	Шаблоны.Вставить("Заявление",	ДанныеЗаявления);
	
	Если ЭтаФорма.ЗаявлениеНаВключение Тогда
		Шаблоны.Вставить("Уведомление",	Документы.ВнесениеИзмененийВоВнутреннийПеречень.ПолучитьМакет("УведомлениеОПризнанииКвалифицированнымИнвестором"));
		
		Если Клиент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			Шаблоны.Вставить("УведомлениеОПоследствиях",	Документы.ВнесениеИзмененийВоВнутреннийПеречень.ПолучитьМакет("УведомлениеОПоследствияхПризнанияКвалифицированнымИнвестором"));
		КонецЕсли;
	Иначе	
		Шаблоны.Вставить("Уведомление",	Документы.ВнесениеИзмененийВоВнутреннийПеречень.ПолучитьМакет("УведомлениеОбИсключенииИзРеестраКвалифицированныхИнвесторов"));
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(Шаблоны, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВидовАктивовИПодтверждающиеДокументыНаСервере()
	
	СписокВидовАктивовИзДокумента = ПолучитьСписокВидовАктивовИзДокумента(Параметры.Документ);
	
	ДокументОбъект = Параметры.Документ.ПолучитьОбъект();
	
	СтруктураПодтверждающихДокументов = ДокументОбъект.ПодтверждающиеДокументыКвалифицированногоИнвестора.Получить();	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокВидовАктивовИзДокумента(ДокументСсылка)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнесениеИзмененийВоВнутреннийПереченьВидыАктивовКвалифицированныхИнвесторов.ВидАктива КАК ВидАктива
		|ИЗ
		|	Документ.ВнесениеИзмененийВоВнутреннийПеречень.ВидыАктивовКвалифицированныхИнвесторов КАК ВнесениеИзмененийВоВнутреннийПереченьВидыАктивовКвалифицированныхИнвесторов
		|ГДЕ
		|	ВнесениеИзмененийВоВнутреннийПереченьВидыАктивовКвалифицированныхИнвесторов.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ВидАктива);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.Имя = "УполномоченноеЛицоОрганизации" Тогда 
		Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Организация, УполномоченноеЛицоОрганизации));		
	ИначеЕсли Элемент.Имя = "СотрудникОрганизацииПринявшийЗаявление" Тогда	
		Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Организация, СотрудникОрганизацииПринявшийЗаявление));
	КонецЕсли;	
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	Если Элемент.Имя = "УполномоченноеЛицоОрганизации" Тогда 
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.УполномоченноеЛицоОрганизации) Тогда
			СтруктураДанныхУполномоченноеЛицоОрганизации = Неопределено;
		КонецЕсли;	
	ИначеЕсли Элемент.Имя = "СотрудникОрганизацииПринявшийЗаявление" Тогда
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.СотрудникОрганизацииПринявшийЗаявление) Тогда
			СтруктураДанныхСотрудникОрганизацииПринявшийЗаявление = Неопределено;	
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);	
	ВыбранноеЗначение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;	
	
	Если Элемент.Имя = "УполномоченноеЛицоОрганизации" Тогда 
		СтруктураДанныхУполномоченноеЛицоОрганизации = СтруктураДанныхКонтактногоЛица;	
	ИначеЕсли Элемент.Имя = "СотрудникОрганизацииПринявшийЗаявление" Тогда
		СтруктураДанныхСотрудникОрганизацииПринявшийЗаявление = СтруктураДанныхКонтактногоЛица;
	КонецЕсли;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьРеквизитыДокумента(РеквизитыДокумента, ЗаявлениеНаВключение, Отказ)
	
	ТекстОшибки = "";
	
	// Проверяем явные противоречия
	Если РеквизитыДокумента.ВидПеречня <> Справочники.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы Тогда
		ТекстОшибки = "Печать предназначена только для документов в видом перечня 'Квалифицированные инвесторы'";  		
	КонецЕсли;
	
	Если РеквизитыДокумента.ВидПеречня = Справочники.ВидыПеречнейОбъектов.КвалифицированныеИнвесторы Тогда
		
		Если РеквизитыДокумента.ВидИзменения = Перечисления.ВидыИзмененийПеречней.Включение И Не ЗаявлениеНаВключение Тогда
			ТекстОшибки = "Печать заявления на исключение не предназначена для документов в видом изменения 'Включение'";
		КонецЕсли;
			
		Если РеквизитыДокумента.ВидИзменения = Перечисления.ВидыИзмененийПеречней.Исключение И ЗаявлениеНаВключение Тогда
			ТекстОшибки = "Печать заявления на включение не предназначена для документов в видом изменения 'Исключение'";
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти