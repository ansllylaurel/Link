
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Документ, "Объект,Дата,ВидПеречня,ВидИзменения,ПричинаИсключенияКвалифицированногоЛица");
	
	ПроверитьРеквизитыДокумента(РеквизитыДокумента, Параметры.ЗаявлениеНаВключение, Отказ);
	Если Отказ Тогда	
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Клиент										= РеквизитыДокумента.Объект;
	ЭтаФорма.Организация								= ПараметрыСеанса.ТекущаяОрганизация;
	ЭтаФорма.ДатаЗаявления								= РеквизитыДокумента.Дата;
	ЭтаФорма.ДатаПоступленияЗаявления					= ЭтаФорма.ДатаЗаявления;
	ЭтаФорма.ВидИзменения 								= РеквизитыДокумента.ВидИзменения;
	ЭтаФорма.ПричинаИсключенияКвалифицированногоЛица	= РеквизитыДокумента.ПричинаИсключенияКвалифицированногоЛица;
	
	Параметры.Свойство("ЗаявлениеНаВключение", ЭтаФорма.ЗаявлениеНаВключение);
		
	Если Клиент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		Элементы.ГруппаУполномоченноеЛицоКлиента.Видимость = Ложь;
	КонецЕсли;
	
	РезультатЗапроса = Документы.ВнесениеИзмененийВоВнутреннийПеречень.РезультатЗапросаПоВидамАктивов(ЭтаФорма.Организация, РеквизитыДокумента.Объект, Параметры.Документ.МоментВремени());
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокВидовАктивовДоИзменения.Добавить(Выборка.ВидАктива);
	КонецЦикла;	
	
	ЗаполнитьСписокВидовАктивовИПодтверждающиеДокументыНаСервере();

	// Если для вида Изменение состав видов активов не изменился, ничего не печатаем
	Если ВидИзменения = Перечисления.ВидыИзмененийПеречней.Изменение Тогда
		СтруктураИзменений = Документы.ВнесениеИзмененийВоВнутреннийПеречень.СформироватьСтруктуруИзмененийСоставаВидовАктивов(СписокВидовАктивовДоИзменения.ВыгрузитьЗначения(), СписокВидовАктивовИзДокумента.ВыгрузитьЗначения());
		Если СтруктураИзменений.ДобавленныеВидыАктивов.Количество() = 0 И СтруктураИзменений.УдаленныеВидыАктивов.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ не содержит изменений в составе видов активов",,,, Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Клиент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		УдаляемыйРеквизит = ПроверяемыеРеквизиты.Найти("УполномоченноеЛицоКлиента");
		
		Если УдаляемыйРеквизит <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(УдаляемыйРеквизит);
		КонецЕсли;
		
		УдаляемыйРеквизит = ПроверяемыеРеквизиты.Найти("ОснованиеУполномоченногоЛицаКлиента");
		
		Если УдаляемыйРеквизит <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(УдаляемыйРеквизит);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти


