#Область Команды_формы

&НаКлиенте
Процедура Печать(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатиНаСервере();
		
		Если ДанныеДляПечати <> Неопределено Тогда
			
			Шаблоны = ПолучитьИзВременногоХранилища(ДанныеДляПечати.АдресШаблонов);
			
			WordApp = Новый COMОбъект("Word.Application");
			
			ФайлЗаявления = ПолучитьИмяВременногоФайла("docx");
			Шаблоны.Заявление.Записать(ФайлЗаявления);
			ЗаполнитьИПоказатьШаблон(WordApp,	ФайлЗаявления,		ДанныеДляПечати.ДанныеЗаявления);
							
			ФайлУведомления = ПолучитьИмяВременногоФайла("docx");
			Шаблоны.Уведомление.Записать(ФайлУведомления);
		 	ЗаполнитьИПоказатьШаблон(WordApp,	ФайлУведомления,	ДанныеДляПечати.ДанныеУведомления);
			
			// Уведомление о последствиях требуется только для физ. лиц
			Если ЭтаФорма.ЗаявлениеНаВключение И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ВидЮрФизЛица") = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо") Тогда				
				ФайлУведомленияОПоследствиях = ПолучитьИмяВременногоФайла("docx");
				Шаблоны.УведомлениеОПоследствиях.Записать(ФайлУведомленияОПоследствиях);
			 	ЗаполнитьИПоказатьШаблон(WordApp,	ФайлУведомленияОПоследствиях,	ДанныеДляПечати.ДанныеУведомления);			
			КонецЕсли; 
			
			WordApp.Application.Visible = Истина;
			
			ЭтаФорма.Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ПолучитьДанныеДляПечатиНаСервере()
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации",		Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ДатаЗаявления",			ДатаЗаявления);
	Запрос.УстановитьПараметр("Клиент",					Клиент);
	Запрос.УстановитьПараметр("ПредставительКлиента", 	УполномоченноеЛицоКлиента);
	Запрос.УстановитьПараметр("Ответственный",			СтруктураДанныхСотрудникОрганизацииПринявшийЗаявление.КонтактноеЛицо);
	
	ВидЮрФизЛица = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ВидЮрФизЛица");
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ОрганизацияПолноеНаименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК Сайт
		|ПОМЕСТИТЬ _ДанныеОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаЗаявления,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрЛицоОрганизации
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
				
	Если ЭтаФорма.ЗаявлениеНаВключение Тогда 
		
		Если ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			
			#Область Текст_запроса_для_заявления_на_включение_физического_лица
		    			
			Запрос.Текст = Запрос.Текст + 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Период КАК Период,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия КАК Фамилия,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя КАК Имя,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК Отчество,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК СерияПаспорта,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК НомерПаспорта,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК КемВыдан,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК ДатаВыдачи,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК КодПодразделения,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрации КАК АдресРегистрации,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресМестаЖительства КАК АдресПроживания,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК ДатаРождения,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.МестоРождения КАК МестоРождения,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство КАК Гражданство,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.РезидентРФ КАК РезидентРФ,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности КАК ВидУдостоверенияЛичности,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
				|	РеквизитыФизическихЛицАнкетныеСрезПоследних.EMail КАК EMail
				|ПОМЕСТИТЬ _Реквизиты
				|ИЗ
				|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
				|			&ДатаЗаявления,
				|			ЮрФизЛицо = &Клиент
				|				И Организация = &Организация
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	РеквизитыФизическихЛицСрезПоследних.Период,
				|	РеквизитыФизическихЛицСрезПоследних.Фамилия,
				|	РеквизитыФизическихЛицСрезПоследних.Имя,
				|	РеквизитыФизическихЛицСрезПоследних.Отчество,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицСрезПоследних.СерияУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицСрезПоследних.НомерУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицСрезПоследних.ОрганВыдавшийУдостоверениеЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицСрезПоследних.ДатаВыдачиУдостоверенияЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
				|			ТОГДА РеквизитыФизическихЛицСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	"" "",
				|	"" "",
				|	РеквизитыФизическихЛицСрезПоследних.ДатаРождения,
				|	РеквизитыФизическихЛицСрезПоследних.МестоРождения,
				|	РеквизитыФизическихЛицСрезПоследних.Гражданство,
				|	РеквизитыФизическихЛицСрезПоследних.РезидентРФ,
				|	РеквизитыФизическихЛицСрезПоследних.ИНН,
				|	РеквизитыФизическихЛицСрезПоследних.ВидУдостоверенияЛичности,
				|	"" "",
				|	"" ""
				|ИЗ
				|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
				|			&ДатаЗаявления,
				|			ЮрФизЛицо = &Клиент
				|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
				|				И Организация = &Организация) КАК РеквизитыФизическихЛицСрезПоследних
				|;
