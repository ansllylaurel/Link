Функция ОпределитьВидИсточникаЦены() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &Оценщик = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|			ТОГДА 1
		|		КОГДА &Оценщик = КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК ВидОценки
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаДокумента,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Оценщик", ЭтотОбъект.Оценщик);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ВидОценки;
	КонецЦикла;
	
КонецФункции



#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
			
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) И ЭтотОбъект.Дата > Дата(2022,6,1) Тогда
		
		Если ЭтотОбъект.ДатаОценки > ЭтотОбъект.Дата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата оценки не может быть больше даты документа!", ЭтотОбъект.Ссылка, "ДатаОценки",, Отказ);
		КонецЕсли;
		
		ЭтоОтчетОценщика = ЭтотОбъект.ОпределитьВидИсточникаЦены() = 3;
		ЭтоПИФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления,"ВидДоговораДоверительногоУправления") 
			= Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
		
		Если ЭтоОтчетОценщика И НЕ ЗначениеЗаполнено(ЭтотОбъект.НомерДокументаОценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен номер отчета оценщика!", ЭтотОбъект.Ссылка, "НомерДокументаОценки",, Отказ);
		КонецЕсли;
		
		Для Каждого ТабличнаяЧасть Из Метаданные.Документы.РегистрацияПрофсуждений.ТабличныеЧасти Цикл
			
			Если ТабличнаяЧасть.Имя = "Обесценение" Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Строка Из ЭтотОбъект[ТабличнаяЧасть.Имя] Цикл
				
				Если Строка.ДатаОкончанияДействия < НачалоДня(ЭтотОбъект.Дата) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания в строке " + Строка.НомерСтроки 
						+ " табличной части """ + ТабличнаяЧасть.Синоним + """" 
						+ " раньше даты документа оценки!", ЭтотОбъект.Ссылка, ТабличнаяЧасть.Имя + "[" + (Строка.НомерСтроки - 1) + "].ДатаОкончанияДействия",, Отказ);
				КонецЕсли;
					
				Если Строка.ДатаОкончанияДействия < ЭтотОбъект.ДатаОценки Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания в строке " + Строка.НомерСтроки 
						+ " табличной части """ + ТабличнаяЧасть.Синоним + """" 
						+ " раньше даты оценки!", ЭтотОбъект.Ссылка, ТабличнаяЧасть.Имя + "[" + (Строка.НомерСтроки - 1) + "].ДатаОкончанияДействия",, Отказ);
				КонецЕсли;
					
				Если ЭтоОтчетОценщика И ЭтоПИФ Тогда
					
					ПолучитьМаксимальнаяДатаДействия = Документы.РегистрацияПрофсуждений.ПолучитьМаксимальнуюДатуДействия(
						ЭтотОбъект, 
						?(ТабличнаяЧасть.Имя = "СтоимостьЦенныхБумаг", Перечисления.ВидыАктивов.ЦенныеБумаги, Строка.ВидАктива));
					
					Если Строка.ДатаОкончанияДействия > ПолучитьМаксимальнаяДатаДействия  Тогда
					
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания в строке " + Строка.НомерСтроки 
							+ " табличной части """ + ТабличнаяЧасть.Синоним + """" 
							+ " указана более полугода с даты оценки. Должна быть не более " + Формат(ПолучитьМаксимальнаяДатаДействия,"ДФ=dd.MM.yyyy") + "!", 
							ЭтотОбъект.Ссылка, ТабличнаяЧасть.Имя + "[" + (Строка.НомерСтроки - 1) + "].ДатаОкончанияДействия",, Отказ);
					КонецЕсли;
						
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Строка из ЭтотОбъект.СтоимостьПрочихАктивов Цикл
		Если НЕ Отказ И НЕ ЗначениеЗаполнено(Строка.Основание) И Строка.Основание <> Неопределено Тогда
			Строка.Основание = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОценкиСтоимостиЦенныхБумаг.Записывать = Истина;
	
	Для Каждого СтрокаЦенныеБумаги Из ЭтотОбъект.СтоимостьЦенныхБумаг Цикл
		Движение = Движения.ОценкиСтоимостиЦенныхБумаг.Добавить();
		
		Движение.Период = ЭтотОбъект.Дата;
		
		ЗаполнитьЗначенияСвойств(Движение, ЭтотОбъект, "Организация, СчетДоверительногоУправления, Оценщик, НомерДокументаОценки, ДатаОценки");
		ЗаполнитьЗначенияСвойств(Движение, СтрокаЦенныеБумаги);
		
	КонецЦикла;

	Движения.ОбесценениеАктивов.Записывать = Истина;
	
	Для Каждого СтрокаОбесценение Из ЭтотОбъект.Обесценение Цикл
		Движение = Движения.ОбесценениеАктивов.Добавить();
		
		Движение.Период = ЭтотОбъект.Дата;
		
		ЗаполнитьЗначенияСвойств(Движение, ЭтотОбъект, "Организация, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(Движение, СтрокаОбесценение);
		
	КонецЦикла;
	
	Движения.ОценкиСтоимостиПрочихАктивов.Записывать = Истина;

	Для Каждого СтрокаПрочиеАктивы Из ЭтотОбъект.СтоимостьПрочихАктивов Цикл
		Движение = Движения.ОценкиСтоимостиПрочихАктивов.Добавить();
		
		Движение.Период = ЭтотОбъект.Дата;
		
		ЗаполнитьЗначенияСвойств(Движение, ЭтотОбъект, "Организация, СчетДоверительногоУправления, Оценщик, НомерДокументаОценки, ДатаОценки");
		ЗаполнитьЗначенияСвойств(Движение, СтрокаПрочиеАктивы);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
