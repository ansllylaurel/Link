Процедура ЗаполнитьНаОснованииРаспоряжения(ДанныеЗаполнения, СтандартнаяОбработка)
		
	Основание = ДанныеЗаполнения;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, СчетДоверительногоУправления, РасчетныйСчет, Процент, ДатаВозврата, Сумма");
	
	Если НачалоДня(ДанныеЗаполнения.Дата) = НачалоДня(ТекущаяДата()) Тогда
		// МНО под ожидаемый купон ставим к концу дня, т. к. купоны часто приходят под вечер
		Дата = ?(ДанныеЗаполнения.ПодОжидаемыйКупон, НачалоДня(ТекущаяДата()) + 19 * 60 * 60 + 50 * 60, ТекущаяДата());
	Иначе
		Дата = ДанныеЗаполнения.Дата;
	КонецЕсли; 
	
КонецПроцедуры

Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                	    Справочники.БрокерскиеКомпании.ПустаяСсылка());
	ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                	Справочники.МестаХранения.ВнебиржевойРынок);
	ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет",                	ЭтотОбъект.РасчетныйСчет);
	ЭлементБлокировкиДанных.УстановитьЗначение("Валюта",                		ЭтотОбъект.РасчетныйСчет.Валюта);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваМНО");

	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет",                	ЭтотОбъект.РасчетныйСчет);

	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ДенежныеСредстваМНО.Записывать = Истина;
	
	// зафиксируем блокировку денежных средств
	Движение = Движения.ДенежныеСредстваМНО.ДобавитьПриход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.Организация 				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.РасчетныйСчет 				  = ЭтотОбъект.РасчетныйСчет;
	Движение.МНО   					      = ЭтотОбъект.Ссылка;
	Движение.Сумма                        = ЭтотОбъект.Сумма;
	
	// зафиксируем отмену блокировки (раньше это делалось в приходе % МНО, но
	// как оказалось, приход % может быть и вечером, а деньгами можно пользоваться
	// уже с утра)
	Движение = Движения.ДенежныеСредстваМНО.ДобавитьРасход();
	
	Движение.Период                       = ЭтотОбъект.ДатаВозврата;
	Движение.Организация 				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.РасчетныйСчет 				  = ЭтотОбъект.РасчетныйСчет;
	Движение.МНО   					      = ЭтотОбъект.Ссылка;
	Движение.Сумма                        = ЭтотОбъект.Сумма;
	
	Движения.Записать();
	
	// проверим наличие доступного остатка д/с
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ОстаткиДенежныхСредств.ОстатокДенежныхСредств) КАК ОстатокДенежныхСредств,
		|	СУММА(ОстаткиДенежныхСредств.МНО) КАК МНО
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК ОстатокДенежныхСредств,
		|		0 КАК МНО
		|	ИЗ
		|		РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И РасчетныйСчет = &РасчетныйСчет
		|					И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|					И Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)) КАК ОстаткиДенежныхСредствОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		0,
		|		ДенежныеСредстваМНООстатки.СуммаОстаток
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И РасчетныйСчет = &РасчетныйСчет) КАК ДенежныеСредстваМНООстатки) КАК ОстаткиДенежныхСредств
		|
		|ИМЕЮЩИЕ
		|	СУММА(ОстаткиДенежныхСредств.ОстатокДенежныхСредств) < СУММА(ОстаткиДенежныхСредств.МНО)";
	
	// Остатки проверяем на конец дня, т. к. иначе условия МНО могут нарушиться
	Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("РасчетныйСчет",                ЭтотОбъект.РасчетныйСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='На р/счете недостаточно денежных средств. Требуется " + ЭтотОбъект.Сумма + ". В наличии: " + Выборка.ОстатокДенежныхСредств + ", в т.ч. в МНО: " + (Выборка.МНО - ЭтотОбъект.Сумма) + ".'"), ЭтотОбъект, "Сумма",, Отказ);
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Если НастройкиУчета.БлокироватьДенежныеСредстваПоДоговоруМНО Тогда
		
		// "заблокируем" ДС на том же счете, но на аналитике МНО
		Валюта = ЭтотОбъект.РасчетныйСчет.Валюта;
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		АналитикаМНО = Справочники.ДополнительныеАналитикиЛицевыхСчетов.МНО;	
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Признание соглашения МНО");
		
		Если Справочники.Банки.ЯвляетсяРезидентом(ЭтотОбъект.РасчетныйСчет.Банк,Дата) Тогда
			Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета01;
		Иначе
			Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета02;
		КонецЕсли;
		Проводка.СубконтоДт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.МНО;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаМНО;
		
		Проводка.ВалютаДт  = Валюта;
		Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
		
		Проводка.СчетКт = Проводка.СчетДт;
		Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.МНО;
		
		Проводка.ВалютаКт  = Валюта;
		Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
	
	КонецЕсли;
	
КонецПроцедуры //ПроведениеПоРегиструЕПС

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт 
	
