#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Распоряжение") Тогда
			
		ЗаполнитьНаОснованииРаспоряжения(ДанныеЗаполнения, СтандартнаяОбработка);
	
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "ДатаВозврата, Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	Если ЭтотОбъект.ПометкаУдаления Или Не ЗначениеЗаполнено(Основание) Тогда
	
		Возврат;
	
	КонецЕсли; 
			
	Если Не ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет.ДоговорМНО) Тогда
		
		ДатаНачалаКонтроляДоговоровВМНО = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаНачалаКонтроляДоговоровВМНО", ЭтотОбъект.Организация);
		
		Если ЗначениеЗаполнено(ДатаНачалаКонтроляДоговоровВМНО) И ДатаНачалаКонтроляДоговоровВМНО <= ЭтотОбъект.Дата Тогда
			ПроверяемыеРеквизиты.Добавить("Договор");
		КонецЕсли;
		
	КонецЕсли;
	
	ДатаВозвратаСоответствуетУсловиямДоговор(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
					
		РаботаСДокументами.ПроверитьВозможностьСозданияПодчиненногоДокументаНаОснованииРаспоряжения(ЭтотОбъект, Отказ); 
		
		//проверим настройки акцептования - если требуется акцепт распоряжения на МНО, нельзя создавать МНО без распоряжения.
		Если РаботаСДокументами.ТребуетсяАкцептованиеДокумента(ЭтотОбъект.Основание, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) Тогда	
			
			ТекстСообщения = "Перед созданием документа МНО необходимо " + ?(ЗначениеЗаполнено(ЭтотОбъект.Основание), "", "создать и ") + "акцептовать распоряжение на МНО";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Основание",, Отказ);
			
		КонецЕсли;
			
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если ЭтотОбъект.Дата > ЭтотОбъект.ДатаВозврата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата возврата МНО меньше даты документа", ЭтотОбъект, "ДатаВозврата",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаПроведения

#КонецОбласти

Процедура ДатаВозвратаСоответствуетУсловиямДоговор(Отказ)
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаРасторжения = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыДоговора(ЭтотОбъект.Договор, "ДатаРасторжения", ЭтотОбъект.Дата).ДатаРасторжения;
	
	Если ЗначениеЗаполнено(ДатаРасторжения) И ДатаРасторжения < ЭтотОбъект.ДатаВозврата Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата возврата МНО позже даты расторжения договора (" + Формат(ДатаРасторжения, "ДФ=dd.MM.yy") + ").", ЭтотОбъект, "ДатаВозврата",, Отказ);
	КонецЕсли;	
	
КонецПроцедуры
