	МассивДопустимыхТипов.Добавить(Тип("СправочникСсылка.БрокерскиеКомпании"));
	МассивДопустимыхТипов.Добавить(Тип("СправочникСсылка.Биржи"));
	МассивДопустимыхТипов.Добавить(Тип("ДокументСсылка.МНО"));
	МассивДопустимыхТипов.Добавить(Тип("ДокументСсылка.СделкаРЕПО"));
	МассивДопустимыхТипов.Добавить(Тип("ДокументСсылка.ПогашениеКупона"));
