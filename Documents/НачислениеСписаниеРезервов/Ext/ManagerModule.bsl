КонецФункции 

Функция ПроверитьКорректностьЗаполнения(ДокументНачисленияРезервов, ДокументНачисленияРезервовСтарый) Экспорт

	Партии = ДокументНачисленияРезервов.Партии.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПартииНовыеПредварительно.Партия КАК Партия,
		|	ПартииНовыеПредварительно.СтрокаПартии КАК СтрокаПартии,
		|	ПартииНовыеПредварительно.СуммаРезерваПартии КАК СуммаРезерваПартии,
		|	ПартииНовыеПредварительно.Количество КАК Количество,
		|	ПартииНовыеПредварительно.Актив КАК Актив,
		|	ПартииНовыеПредварительно.АналитикаРезерва КАК АналитикаРезерва,
		|	ПартииНовыеПредварительно.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _ПартииНовыеПредварительно
		|ИЗ
		|	&ПартииНовые КАК ПартииНовыеПредварительно
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ПартииНовыеПредварительно.Партия КАК Партия,
		|	_ПартииНовыеПредварительно.СтрокаПартии КАК СтрокаПартии,
		|	СУММА(_ПартииНовыеПредварительно.СуммаРезерваПартии) КАК СуммаРезерваПартии,
		|	СУММА(_ПартииНовыеПредварительно.Количество) КАК Количество,
		|	_ПартииНовыеПредварительно.Актив КАК Актив,
		|	_ПартииНовыеПредварительно.АналитикаРезерва КАК АналитикаРезерва,
		|	_ПартииНовыеПредварительно.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _ПартииНовые
		|ИЗ
		|	_ПартииНовыеПредварительно КАК _ПартииНовыеПредварительно
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПартииНовыеПредварительно.Партия,
		|	_ПартииНовыеПредварительно.СтрокаПартии,
		|	_ПартииНовыеПредварительно.Актив,
		|	_ПартииНовыеПредварительно.АналитикаРезерва,
		|	_ПартииНовыеПредварительно.СтадияОбесценения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервовПартии.Партия КАК Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии КАК СтрокаПартии,
		|	СУММА(НачислениеСписаниеРезервовПартии.СуммаРезерваПартии) КАК СуммаРезерваПартии,
		|	СУММА(НачислениеСписаниеРезервовПартии.Количество) КАК Количество,
		|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва КАК АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения
		|ПОМЕСТИТЬ _ПартииСтарые
		|ИЗ
		|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|ГДЕ
		|	НачислениеСписаниеРезервовПартии.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеСписаниеРезервовПартии.Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии,
		|	НачислениеСписаниеРезервовПартии.Актив,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ПартииНовые.Актив, _ПартииСтарые.Актив) КАК Актив,
		|	ЕСТЬNULL(_ПартииНовые.Партия, _ПартииСтарые.Партия) КАК Партия,
		|	ЕСТЬNULL(_ПартииНовые.СтрокаПартии, _ПартииСтарые.СтрокаПартии) КАК СтрокаПартии,
		|	ЕСТЬNULL(_ПартииНовые.СуммаРезерваПартии, 0) КАК СуммаРезерваПартии,
		|	ЕСТЬNULL(_ПартииНовые.Количество, 0) КАК Количество,
		|	_ПартииНовые.АналитикаРезерва КАК АналитикаРезерва,
		|	_ПартииНовые.СтадияОбесценения КАК СтадияОбесценения,
		|	ЕСТЬNULL(_ПартииСтарые.СуммаРезерваПартии, 0) КАК СуммаРезерваПартии1,
		|	ЕСТЬNULL(_ПартииСтарые.Количество, 0) КАК Количество1,
		|	_ПартииСтарые.АналитикаРезерва КАК АналитикаРезерва1,
		|	_ПартииСтарые.СтадияОбесценения КАК СтадияОбесценения1
		|ИЗ
		|	_ПартииНовые КАК _ПартииНовые
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ПартииСтарые КАК _ПартииСтарые
		|		ПО _ПартииНовые.Актив = _ПартииСтарые.Актив
		|			И (ТИПЗНАЧЕНИЯ(_ПартииНовые.Актив) <> ТИП(Справочник.Облигации)
		|				ИЛИ _ПартииНовые.Партия = _ПартииСтарые.Партия
		|					И _ПартииНовые.СтрокаПартии = _ПартииСтарые.СтрокаПартии)
		|ГДЕ
		|	(ЕСТЬNULL(_ПартииНовые.СуммаРезерваПартии, 0) <> ЕСТЬNULL(_ПартииСтарые.СуммаРезерваПартии, 0)
		|			ИЛИ ЕСТЬNULL(_ПартииНовые.Количество, 0) <> ЕСТЬNULL(_ПартииСтарые.Количество, 0)
		|			ИЛИ _ПартииНовые.АналитикаРезерва <> _ПартииСтарые.АналитикаРезерва
		|			ИЛИ _ПартииНовые.СтадияОбесценения <> _ПартииСтарые.СтадияОбесценения
		|			ИЛИ _ПартииНовые.Актив ЕСТЬ NULL
		|				И ЕСТЬNULL(_ПартииСтарые.СуммаРезерваПартии, 0) <> 0
		|			ИЛИ _ПартииСтарые.Актив ЕСТЬ NULL
		|				И ЕСТЬNULL(_ПартииНовые.СуммаРезерваПартии, 0) <> 0)";
	
	Запрос.УстановитьПараметр("ПартииНовые", Партии);
	Запрос.УстановитьПараметр("Ссылка", ДокументНачисленияРезервовСтарый);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПолучитьСуществующийДокумент(Организация, СчетДоверительногоУправления, Дата, ЦельРасчета) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.НачислениеСписаниеРезервов КАК НачислениеСписаниеРезервов
		|ГДЕ
		|	НачислениеСписаниеРезервов.Организация = &Организация
		|	И НачислениеСписаниеРезервов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НачислениеСписаниеРезервов.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И НачислениеСписаниеРезервов.Проведен
		|	И НЕ НачислениеСписаниеРезервов.ПереходНаМСФО9
		|	И НачислениеСписаниеРезервов.ЦельРасчета = &ЦельРасчета");

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачальнаяДата",					НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(Дата));
	Запрос.УстановитьПараметр("ЦельРасчета",					ЦельРасчета);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	Если Данные.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		Представление = "Начисление и списание резервов ЕПС " + Данные.Номер + " от " + Данные.Дата;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("ЦельРасчета");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
