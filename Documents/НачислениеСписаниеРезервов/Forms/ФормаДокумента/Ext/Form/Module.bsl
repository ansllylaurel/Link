&НаСервере
Функция ЗаполнитьПартииНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Актив) ИЛИ НЕ ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните актив и счет д/у!");
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросДатыЗапрета = Новый Запрос;
	ЗапросДатыЗапрета.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
		|	И ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)";

	ЗапросДатыЗапрета.УстановитьПараметр("Организация",                  Объект.Организация);
	ЗапросДатыЗапрета.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);

	Выборка = ЗапросДатыЗапрета.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		ДатаЗапретаРедактированияПартий = Выборка.ДатаЗапретаРедактирования;
	Иначе
		ДатаЗапретаРедактированияПартий = Дата(1, 1, 1);
	КонецЕсли;

	Если КонецДня(ДатаЗапретаРедактированияПартий) < КонецДня(Объект.Дата) Тогда 
		
		Отказ = Ложь;
		
		РасчетПартий = Обработки.РасчетПартий.Создать();
		
		РасчетПартий.Организация                  = Объект.Организация;
		РасчетПартий.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
		РасчетПартий.ВидУчета                     = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		РасчетПартий.НачалоПериода                = НачалоДня(ДатаЗапретаРедактированияПартий) + 86400;
		РасчетПартий.КонецПериода                 = КонецДня(Объект.Дата);
		РасчетПартий.ТаблицаПлановыхОпераций	  = Неопределено;
		РасчетПартий.ВариантРасчета				  = Перечисления.ВариантыРасчетаПартий.РасчетКоличестваДляБумагПоАССуммы;
		
		РасчетПартий.РассчитатьПартии(Отказ, Истина);
		
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось динамически рассчитать партий по '" + Объект.СчетДоверительногоУправления + "' за период с " + РасчетПартий.НачалоПериода + " по " + РасчетПартий.КонецПериода);
			Возврат Ложь;
		КонецЕсли;
		
		НужныеСтроки = РасчетПартий.КонечныеОстаткиПартий.НайтиСтроки(Новый Структура("ЦеннаяБумага", Объект.Актив));
		
		Объект.Партии.Загрузить(РасчетПартий.КонечныеОстаткиПартий.Выгрузить(НужныеСтроки, "Партия,СтрокаПартии,Количество"));
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ЦеннаяБумага = &Актив) КАК БухПартииЦенныхБумагОстатки";
		
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Запрос.УстановитьПараметр("Период",							Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
		Иначе
			Запрос.УстановитьПараметр("Период",							Новый Граница(Объект.Дата, ВидГраницы.Исключая));
		КонецЕсли;
		Запрос.УстановитьПараметр("Организация",					Объект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Объект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Актив",							Объект.Актив);
		
		Объект.Партии.Загрузить(Запрос.Выполнить().Выгрузить());
		
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТекущиеДанныеНаСервере()

	Если Не Объект.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	Иначе
		Период = Новый Граница(Объект.Дата, ВидГраницы.Исключая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеСписаниеРезервовПартии.НомерСтроки КАК НомерСтроки,
		|	НачислениеСписаниеРезервовПартии.Партия КАК Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии КАК СтрокаПартии,
		|	НачислениеСписаниеРезервовПартии.СуммаРезерваПартии КАК СуммаРезерваПартии,
		|	НачислениеСписаниеРезервовПартии.Количество КАК Количество,
		|	НачислениеСписаниеРезервовПартии.Актив КАК Актив,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва КАК АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения КАК СтадияОбесценения,
		|	СУММА(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) <> ТИП(Справочник.Облигации)
		|					ИЛИ &ОтражатьПартииНаЛицевыхСчетах
		|				ТОГДА ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт, 0)
		|			ИНАЧЕ ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток, 0)
		|		КОНЕЦ) КАК СтараяСуммаРезерва,
		|	ВЫБОР
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 1
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 2
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 3
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто3
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК СтараяАналитикаРезерва
		|ИЗ
		|	Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						УчетныеАктивыЕПС.СчетУчетаРезервов КАК СчетУчетаРезервов
		|					ИЗ
		|						Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|				
		|					ОБЪЕДИНИТЬ
		|				
		|					ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто
		|			ПО ЕдиныйБухгалтерскийУчетОстатки.Счет = ЕдиныйВидыСубконто.Ссылка
		|				И (ЕдиныйВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Резервы))
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконтоУсловияЗаймовКредитовИДепозитов
		|			ПО ЕдиныйБухгалтерскийУчетОстатки.Счет = ЕдиныйВидыСубконтоУсловияЗаймовКредитовИДепозитов.Ссылка
		|				И (ЕдиныйВидыСубконтоУсловияЗаймовКредитовИДепозитов.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов))
		|		ПО (ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) = ТИП(Справочник.Биржи)
		|					И ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)
		|				ИЛИ ТИПЗНАЧЕНИЯ(НачислениеСписаниеРезервовПартии.Актив) = ТИП(Справочник.БрокерскиеКомпании)
		|					И ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07)
		|					И ВЫРАЗИТЬ(НачислениеСписаниеРезервовПартии.Актив КАК Справочник.БрокерскиеКомпании).ЮрФизЛицо = ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.ДоговорыБрокерскогоОбслуживания).Контрагент
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1) <> ТИП(Справочник.БанковскиеСчета)
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1) <> ТИП(Справочник.Облигации)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1) = ТИП(Справочник.БанковскиеСчета)
		|					И (ЕдиныйВидыСубконтоУсловияЗаймовКредитовИДепозитов.НомерСтроки = 2
		|							И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = НЕОПРЕДЕЛЕНО
		|						ИЛИ ЕдиныйВидыСубконтоУсловияЗаймовКредитовИДепозитов.НомерСтроки = 3
		|							И ЕдиныйБухгалтерскийУчетОстатки.Субконто3 = НЕОПРЕДЕЛЕНО)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) <> ТИП(Справочник.Облигации)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто3
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто3) <> ТИП(Справочник.Облигации)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1) = ТИП(Справочник.Облигации)
		|					И (НЕ &ОтражатьПартииНаЛицевыхСчетах
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия = НачислениеСписаниеРезервовПартии.Партия
		|							И ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии = НачислениеСписаниеРезервовПартии.СтрокаПартии)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) = ТИП(Справочник.Облигации)
		|					И (НЕ &ОтражатьПартииНаЛицевыхСчетах
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия = НачислениеСписаниеРезервовПартии.Партия
		|							И ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии = НачислениеСписаниеРезервовПартии.СтрокаПартии)
		|				ИЛИ НачислениеСписаниеРезервовПартии.Актив = ЕдиныйБухгалтерскийУчетОстатки.Субконто3
		|					И ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто3) = ТИП(Справочник.Облигации)
		|					И (НЕ &ОтражатьПартииНаЛицевыхСчетах
		|						ИЛИ ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.Партия = НачислениеСписаниеРезервовПартии.Партия
		|							И ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.СтрокаПартии = НачислениеСписаниеРезервовПартии.СтрокаПартии))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И НЕ &ОтражатьПартииНаЛицевыхСчетах
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|					И ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							НачислениеСписаниеРезервовПартии.Актив КАК Актив
		|						ИЗ
		|							Документ.НачислениеСписаниеРезервов.Партии КАК НачислениеСписаниеРезервовПартии
		|						ГДЕ
		|							НачислениеСписаниеРезервовПартии.Ссылка = &Регистратор)) КАК БухПартииЦенныхБумагОстатки
		|		ПО НачислениеСписаниеРезервовПартии.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И (БухПартииЦенныхБумагОстатки.СтрокаПартии = НачислениеСписаниеРезервовПартии.СтрокаПартии)
		|ГДЕ
		|	НачислениеСписаниеРезервовПартии.Ссылка = &Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеСписаниеРезервовПартии.НомерСтроки,
		|	НачислениеСписаниеРезервовПартии.Партия,
		|	НачислениеСписаниеРезервовПартии.СтрокаПартии,
		|	НачислениеСписаниеРезервовПартии.СуммаРезерваПартии,
		|	НачислениеСписаниеРезервовПартии.Количество,
		|	НачислениеСписаниеРезервовПартии.Актив,
		|	НачислениеСписаниеРезервовПартии.АналитикаРезерва,
		|	НачислениеСписаниеРезервовПартии.СтадияОбесценения,
		|	ВЫБОР
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 1
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 2
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|		КОГДА ЕдиныйВидыСубконто.НомерСтроки = 3
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто3
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.УстановитьПараметр("ОтражатьПартииНаЛицевыхСчетах", БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ОтражатьПартииНаЛицевыхСчетах"));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокиПартий = Объект.Партии.НайтиСтроки(Новый Структура("НомерСтроки", ВыборкаДетальныеЗаписи.НомерСтроки));
		
		СтрокиПартий[0].СтараяСуммаРезерва = ВыборкаДетальныеЗаписи.СтараяСуммаРезерва;
		СтрокиПартий[0].СтараяАналитикаРезерва = ВыборкаДетальныеЗаписи.СтараяАналитикаРезерва;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтотОбъект);
	
	ЭтаФорма.Элементы.ПартииАктив.ОграничениеТипа = Новый ОписаниеТипов(Документы.НачислениеСписаниеРезервов.ДопустимыеТипыАктивов());
	
	УправлениеФормой(ЭтаФорма);
	
	ЗаполнитьLGDПредставление(ЭтаФорма);
	
	ЗаполнитьТекущиеДанныеНаСервере();
	
КонецПроцедуры

