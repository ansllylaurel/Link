&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ВариантРасчетаОжидаемыхКредитныхУбытков = БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ВариантРасчетаОжидаемыхКредитныхУбытков");	
	
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков = Новый СписокЗначений;
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Аквилон"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.ВолгаКапитал"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Транснефть"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Эволюция2025"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.ХантыМансийский"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Югория"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный2025"));
	СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.Добавить(ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Гефест2025"));
	
	ДокументНеПерерасчитываетсяИзФормы = (СписокРедактируемыхВариантовРасчетаОжидаемыхКредитныхУбытков.НайтиПоЗначению(Форма.ВариантРасчетаОжидаемыхКредитныхУбытков) = Неопределено);
	
	Форма.Элементы.ПартииEAD.ТолькоПросмотр = ДокументНеПерерасчитываетсяИзФормы;
	Форма.Элементы.ПартииPD.ТолькоПросмотр = ДокументНеПерерасчитываетсяИзФормы;
	Форма.Элементы.ПартииДнейДоПогашения.ТолькоПросмотр = ДокументНеПерерасчитываетсяИзФормы;
	Форма.Элементы.ГруппаPDLGD.ТолькоПросмотр = ДокументНеПерерасчитываетсяИзФормы;
	Форма.Элементы.ПартииLGDПредставление.ТолькоПросмотр = ДокументНеПерерасчитываетсяИзФормы;

	ЭтоОценкаОбъектовВУправлении = (Объект.ЦельРасчета = ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении"));
	Форма.Элементы.ПартииСтараяСуммаРезерва.Видимость = Не ЭтоОценкаОбъектовВУправлении;	
	Форма.Элементы.ПартииСтараяАналитикаРезерва.Видимость = Не ЭтоОценкаОбъектовВУправлении;
	
КонецПроцедуры	

&НаКлиенте
Асинх Процедура ВыполнитьПерерасчетПриИзмененииДанных()
	Если ЭтаФорма.Элементы.Партии.ТекущиеДанные <> Неопределено Тогда	
		Если Ждать ВопросАсинх("Выполнить перерасчет суммы резерва?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ВыполнитьПерерасчетПриИзмененииДанныхНаСервере();
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПерерасчетПриИзмененииДанныхНаСервере()
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	ИдентификаторСтроки = Элементы.Партии.ТекущаяСтрока;
	Если ИдентификаторСтроки <> Неопределено Тогда
		
		ТекущиеДанные = Объект.Партии.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.РучнаяКорректировка = Истина;
			ТекущийОбъект.ПересчитатьСтроку(ТекущиеДанные);
		КонецЕсли; 
		
	КонецЕсли; 
	
	ТекущийОбъект = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПартииДнейДоПогашенияПриИзменении(Элемент)
	ВыполнитьПерерасчетПриИзмененииДанных();
