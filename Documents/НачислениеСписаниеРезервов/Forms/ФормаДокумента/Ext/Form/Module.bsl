&НаКлиенте
Асинх Процедура ПартииРучнаяКорректировкаПриИзменении(Элемент)
	Если Не Элементы.Партии.ТекущиеДанные.РучнаяКорректировка Тогда
		Если Ждать ВопросАсинх("Восстановить сумму и показатели резерва?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЭтаФорма.Элементы.ГруппаДекорация.Видимость = Истина;
			
			ЭтаФорма.ОбновитьОтображениеДанных();
			
			ПодключитьОбработчикОжидания("ПартииРучнаяКорректировкаПриИзмененииОбработчикОжидания", 1, Истина); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПартииРучнаяКорректировкаПриИзмененииОбработчикОжидания()
	
	Отказ = Ложь;
	
	Ждать ПартииРучнаяКорректировкаОтменаРучногоИзменения(Отказ);
	
	Если Отказ Тогда
		Элементы.Партии.ТекущиеДанные.РучнаяКорректировка = Истина;	
	КонецЕсли;	
	
	ЗаполнитьLGDПредставление(ЭтаФорма);
	
	ЭтаФорма.Элементы.ГруппаДекорация.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Асинх Функция ПартииРучнаяКорректировкаОтменаРучногоИзменения(Отказ)
	ПартииРучнаяКорректировкаОтменаРучногоИзмененияСервер(Отказ);
КонецФункции	

&НаСервере
Функция ПартииРучнаяКорректировкаОтменаРучногоИзмененияСервер(Отказ)
	
	ИдентификаторСтроки = Элементы.Партии.ТекущаяСтрока;
	Если ИдентификаторСтроки <> Неопределено Тогда
		
		ТекущиеДанные = Объект.Партии.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ТекущиеДанные <> Неопределено Тогда
			
			ДокументНачисленияРезервов = Документы.НачислениеСписаниеРезервов.СоздатьДокумент();
			ДокументНачисленияРезервов.Дата = КонецДня(Объект.Дата);
			ДокументНачисленияРезервов.Организация = Объект.Организация;
			ДокументНачисленияРезервов.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
			ДокументНачисленияРезервов.ЦельРасчета = Объект.ЦельРасчета;
			
			ДокументНачисленияРезервов.ЗаполнитьРезервы(Отказ);
			
			Если Не Отказ Тогда
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Партия", ТекущиеДанные.Партия);
				СтруктураПоиска.Вставить("СтрокаПартии", ТекущиеДанные.СтрокаПартии);
				СтруктураПоиска.Вставить("Актив", ТекущиеДанные.Актив);
				
				НайденныеСтроки = ДокументНачисленияРезервов.Партии.НайтиСтроки(СтруктураПоиска);		
				
				Если НайденныеСтроки.Количество() = 1 Тогда
					ЗаполнитьЗначенияСвойств(ТекущиеДанные, НайденныеСтроки[0]);	
				Иначе
					ТекущиеДанные.РучнаяКорректировка = Истина;
				КонецЕсли;	
				
			КонецЕсли;	
			
		Иначе	
			Отказ = Истина;
		КонецЕсли;
		
	Иначе	
		Отказ = Истина;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ПартииLGDПредставлениеПриИзменении(Элемент)
	Элементы.Партии.ТекущиеДанные.LGD  = Элементы.Партии.ТекущиеДанные.LGDПредставление/100;
	ВыполнитьПерерасчетПриИзмененииДанных();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьLGDПредставление(Форма)
	
	Объект = Форма.Объект;
	
	//Ростех особенный, у него LGD хранится не в коэффициенте а уже в процентах. Его не умножаем на 100. 
	Если Форма.ВариантРасчетаОжидаемыхКредитныхУбытков = ПредопределенноеЗначение("Справочник.ВариантыРасчетаОжидаемыхКредитныхУбытков.Ростех") Тогда 
		
		Для Каждого СтрокаПартии Из Объект.Партии Цикл
			СтрокаПартии.LGDПредставление = СтрокаПартии.LGD;	
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаПартии Из Объект.Партии Цикл
			СтрокаПартии.LGDПредставление = СтрокаПартии.LGD * 100;	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПартииСуммаРезерваПартииПриИзменении(Элемент)
	Если ЭтаФорма.Элементы.Партии.ТекущиеДанные <> Неопределено Тогда	
		ЭтаФорма.Элементы.Партии.ТекущиеДанные.РучнаяКорректировка = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УправлениеФормой(ЭтаФорма);
	
	ЗаполнитьLGDПредставление(ЭтаФорма);
	
	ЗаполнитьТекущиеДанныеНаСервере();
	
КонецПроцедуры


