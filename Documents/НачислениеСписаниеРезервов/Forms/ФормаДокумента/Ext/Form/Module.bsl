КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИРаспределить(ДанныеЗаполнения)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	Иначе
		Период = Новый Граница(Объект.Дата, ВидГраницы.Исключая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Актив,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезерваПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ДанныеЗаполнения.Облигация);
	
	ДанныеПартий = Запрос.Выполнить().Выгрузить();
	
	СуммаРаспределения = ДанныеЗаполнения.СуммаРезерва;
	КоличествоРаспределения = ДанныеПартий.Итог("Количество");
	
	Для каждого СтрокаДанныеПартий Из ДанныеПартий Цикл
		
		СтрокаДанныеПартий.СуммаРезерваПартии = СуммаРаспределения / КоличествоРаспределения * СтрокаДанныеПартий.Количество;
		
		СуммаРаспределения = СуммаРаспределения - СтрокаДанныеПартий.СуммаРезерваПартии;
		КоличествоРаспределения = КоличествоРаспределения - СтрокаДанныеПартий.Количество;
		
		
		НоваяСтрокаПартий = Объект.Партии.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПартий, СтрокаДанныеПартий);
		НоваяСтрокаПартий.АналитикаРезерва = ДанныеЗаполнения.Аналитика;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПартии(Команда)
	
	ДанныеЗаполнения = ОткрытьФормуМодально("Документ.НачислениеСписаниеРезервов.Форма.ФормаВыбораОблигации");
	
	Если ДанныеЗаполнения <> Неопределено Тогда
		ЗаполнитьИРаспределить(ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьРезервыНаСервере(Отказ = Ложь)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	ДанныеРасчета = Неопределено;
	
	ТекущийОбъект.ЗаполнитьРезервы(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьРезервы(Команда)
	
	КомандаЗаполнитьРезервыНаСервере();
	
	УправлениеФормой(ЭтаФорма);
	
	ЗаполнитьLGDПредставление(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция РасшифровкаРасчетаНаСервере(Отказ = Ложь)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	ДанныеРасчета = Новый ТаблицаЗначений();
	
	ТекущийОбъект.ЗаполнитьРезервы(Отказ, ДанныеРасчета);
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ДанныеРасчета, , , , Истина);    
	РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
	
	Возврат ПараметрыВывода.ДокументРезультат;       
	
КонецФункции

&НаКлиенте
Процедура РасшифровкаРасчета(Команда)
	
	Расшифровка = РасшифровкаРасчетаНаСервере();
	Если ТипЗнч(Расшифровка) = Тип("ТабличныйДокумент") Тогда
		Расшифровка.ТолькоПросмотр = Истина;
		Расшифровка.ОтображатьСетку = Ложь;
		Расшифровка.Показать("Расшифровка расчета резервов " + Объект.СчетДоверительногоУправления + " за " + Формат(Объект.Дата, "ДФ='dd.MM.yyyy'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРасшифровкуРасчетаРезервов(ОбъектСсылка)
	
	Попытка
		ОбработкаВыгрузки = Обработки.ПечатьИВыгрузка_СЧА_РСА.Создать();	
		МассивРасшифровок = ОбработкаВыгрузки.ПолучитьРасшифровкуРасчетаРезервов(РаботаСКоллекциями.ЗначениеВМассив(ОбъектСсылка));
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Неопределено;	
	КонецПопытки;
		
	Если МассивРасшифровок = Неопределено Или МассивРасшифровок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать расшифровку расчета резервов табличной части документа.");
		Возврат Неопределено;	
	КонецЕсли;
	
	Возврат МассивРасшифровок;
	
КонецФункции

&НаКлиенте
Процедура СохранитьРасшифровкуРасчета(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для сохранения расшифровки расчета резервов в файл Excel необходимо записать документ.");
		Возврат;
	КонецЕсли;
	
	Если Объект.Партии.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В табличной части документа отсутствуют данные для сохранения расшифровки расчета резервов в файл Excel.");
		Возврат;	
	КонецЕсли;
	
	МассивРасшифровок = ПолучитьРасшифровкуРасчетаРезервов(Объект.Ссылка);
	
	Если МассивРасшифровок = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранение";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(СтрЗаменить(Строка(МассивРасшифровок[0].СчетДоверительногоУправления), " ", "_") + "_" + Формат(Объект.Дата, "ДФ=dd.MM.yyyy")) + ".xlsx";	 
	Диалог.Фильтр = "Книга Excel (*.xlsx)| *.xlsx";
		
	Если Диалог.Выбрать() Тогда
		
		ИмяФайла = Диалог.ПолноеИмяФайла;
			
		Попытка
			МассивРасшифровок[0].ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл " + ИмяФайла + " успешно сохранен.");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка сохранения файла" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	УправлениеФормой(ЭтаФорма);
