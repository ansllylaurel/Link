КонецПроцедуры //ПроведениеПоРегиструЕПС

Процедура СформироватьПроводкуДвиженияДСБУНУ(ПараметрыПроводки)

	//СПФИ, УчетныйРегистр, Контрагент, СчетДС, СубконтоДС, СуммаДвиженияДС, Валюта, КоррСчет, ВидДвиженияДенежныхСредств, Описание
	
	Если ПараметрыПроводки.СуммаДвиженияДС > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[ПараметрыПроводки.УчетныйРегистр], ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		СчетУчетаДС = ПараметрыПроводки.СчетДС;
		
		Проводка.СчетДт = СчетУчетаДС;
		
		ЕстьБрокер							= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено;
		ЕстьДоговорыБрокерскогоОбслуживания	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено;
		ЕстьВидДвиженияДС					= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено;
		ЕстьРасчетныйСчет                	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено;
		ЕстьВалютныйУчетДС					= СчетУчетаДС.Валютный;
		
		Если ЕстьБрокер Тогда
			Проводка.СубконтоДт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
		КонецЕсли;
		
		Если ЕстьВидДвиженияДС Тогда
			Проводка.СубконтоДт.ДоговорыБрокерскогоОбслуживания = ПараметрыПроводки.СубконтоДС;
		КонецЕсли;	
		
		Если ЕстьВидДвиженияДС Тогда
			Проводка.СубконтоДт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
		КонецЕсли;	
		
		Если ЕстьВалютныйУчетДС Тогда
			Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
			Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.СуммаДвиженияДС;
		КонецЕсли;	
		
		Проводка.СчетКт = ПараметрыПроводки.КоррСчет;
		
		ЕстьКорКонтрагент	= ПараметрыПроводки.КоррСчет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено;
		ЕстьКорСделка	= ПараметрыПроводки.КоррСчет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено;
		
		ЕстьКорВалютныйУчетДС	= ПараметрыПроводки.КоррСчет.Валютный;
		
		Если ЕстьКорКонтрагент Тогда
			Проводка.СубконтоКт.Контрагенты = ПараметрыПроводки.Контрагент;
		КонецЕсли;	
		
		Если ЕстьКорСделка Тогда
			Проводка.СубконтоКт.Сделка = ПараметрыПроводки.СПФИ;
		КонецЕсли;	
		
		Если ЕстьКорВалютныйУчетДС Тогда
			Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
			Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.СуммаДвиженияДС;
		КонецЕсли;
		
	ИначеЕсли ПараметрыПроводки.СуммаДвиженияДС < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[ПараметрыПроводки.УчетныйРегистр], -ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		Проводка.СчетДт = ПараметрыПроводки.КоррСчет;
		
		ЕстьКорКонтрагент	= ПараметрыПроводки.КоррСчет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено;
		ЕстьКорСделка	= ПараметрыПроводки.КоррСчет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Сделка) <> Неопределено;
		
		ЕстьКорВалютныйУчетДС	= ПараметрыПроводки.КоррСчет.Валютный;
		
		Если ЕстьКорКонтрагент Тогда
			Проводка.СубконтоДт.Контрагенты = ПараметрыПроводки.Контрагент;
		КонецЕсли;	
		
		Если ЕстьКорСделка Тогда
			Проводка.СубконтоДт.Сделка = ПараметрыПроводки.СПФИ;
		КонецЕсли;	
		
		Если ЕстьКорВалютныйУчетДС Тогда
			Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
			Проводка.ВалютнаяСуммаДт = -ПараметрыПроводки.СуммаДвиженияДС;
		КонецЕсли;
		
		СчетУчетаДС = ПараметрыПроводки.СчетДС;
		
		Проводка.СчетКт = СчетУчетаДС;
		
		ЕстьБрокер							= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БрокерскиеКомпании) <> Неопределено;
		ЕстьДоговорыБрокерскогоОбслуживания	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания) <> Неопределено;
		ЕстьВидДвиженияДС					= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено;
		ЕстьРасчетныйСчет                	= СчетУчетаДС.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета) <> Неопределено;
		ЕстьВалютныйУчетДС					= СчетУчетаДС.Валютный;
		
		Если ЕстьБрокер Тогда
			Проводка.СубконтоКт.БрокерскиеКомпании = ЭтотОбъект.Брокер;
		КонецЕсли;
		
		Если ЕстьВидДвиженияДС Тогда
			Проводка.СубконтоКт.ДоговорыБрокерскогоОбслуживания = ПараметрыПроводки.СубконтоДС;
		КонецЕсли;	
		
		Если ЕстьВидДвиженияДС Тогда
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств 	= Справочники.ВидыДвиженияДенежныхСредств.ТорговаяКомиссия;
		КонецЕсли;	
		
		Если ЕстьВалютныйУчетДС Тогда
			Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
			Проводка.ВалютнаяСуммаКт = -ПараметрыПроводки.СуммаДвиженияДС;
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт 
	
	Движения[УчетныйРегистр].Записывать = Истина;
			
	СчетДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Валюта,
		ЭтотОбъект.Брокер);
		
	СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	
	ПараметрыПроводкиДвиженияДС = Новый Структура();
	ПараметрыПроводкиДвиженияДС.Вставить("СПФИ", ЭтотОбъект.Основание);
	ПараметрыПроводкиДвиженияДС.Вставить("Контрагент", ЭтотОбъект.Основание.Контрагент);
	ПараметрыПроводкиДвиженияДС.Вставить("СчетДС", СчетДС);
	ПараметрыПроводкиДвиженияДС.Вставить("УчетныйРегистр", УчетныйРегистр);
	ПараметрыПроводкиДвиженияДС.Вставить("СубконтоДС", СубконтоДС);
	ПараметрыПроводкиДвиженияДС.Вставить("Валюта", ЭтотОбъект.Валюта);
	
	// Платеж входящий
	Если ЭтотОбъект.ПроцентныйПлатежВходящий > 0 Тогда
		
		ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", ЭтотОбъект.ПроцентныйПлатежВходящий);
		ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Основной.ДепозитнаяМаржа);//76.31//47408 ПланыСчетов.Единый.Расчеты08);
		ПараметрыПроводкиДвиженияДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления);
		ПараметрыПроводкиДвиженияДС.Вставить("Описание", "Проценты по СВОПу");
		
		СформироватьПроводкуДвиженияДСБУНУ(ПараметрыПроводкиДвиженияДС);
		
	КонецЕсли;
	
	// Платеж исходящий
	Если ЭтотОбъект.ПроцентныйПлатежИсходящий > 0 Тогда
		
		ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", -ЭтотОбъект.ПроцентныйПлатежИсходящий);
		ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Основной.ДепозитнаяМаржа);//76.31//47407//ПланыСчетов.Единый.Расчеты07);
		ПараметрыПроводкиДвиженияДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты);
		ПараметрыПроводкиДвиженияДС.Вставить("Описание", "Проценты по СВОПу");
		
		СформироватьПроводкуДвиженияДСБУНУ(ПараметрыПроводкиДвиженияДС);
		
	КонецЕсли;

	// Отражаем доход/расход
	ТаблицаЦБ = Новый ТаблицаЗначений;
	ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип); 
	НовСтрока = ТаблицаЦБ.Добавить();
	НовСтрока.ЦеннаяБумага = ЭтотОбъект.Основание;
	
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЭтотОбъект.Ссылка, УчетныйРегистр, , ТаблицаЦБ);
	
	НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЭтотОбъект.Ссылка, "ЦеннаяБумага");
	
	Если ЗначениеЗаполнено(НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ) Тогда
		ОбращаетсяНаОРЦБ = НайденныеСведенияОбОбращенииЦенныхБумагНаОРЦБ.ОбращаетсяНаОРЦБ;
	Иначе
		ОбращаетсяНаОРЦБ = Ложь;
	КонецЕсли;

	ФинРез = ЭтотОбъект.ПроцентныйПлатежВходящий - ЭтотОбъект.ПроцентныйПлатежИсходящий;
	
	Если ФинРез > 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ФинРез, "Доход по СВОПу");
		
		Проводка.СчетДт = ПланыСчетов.Основной.ДепозитнаяМаржа;//61601 ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Основание.Контрагент;
		Проводка.СубконтоДт.Сделка = ЭтотОбъект.Основание;
		
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;//71509_36204 УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДепозитнаяМаржаВнереализационные");
		Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Основание;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		
	ИначеЕсли ФинРез < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], -ФинРез, "Расход по СВОПу");
	
		Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;//71510_46204 УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДепозитнаяМаржаВнереализационные");
		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Основание;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		
		Проводка.СчетКт = ПланыСчетов.Основной.ДепозитнаяМаржа;//61601 ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Основание.Контрагент;
		Проводка.СубконтоКт.Сделка = ЭтотОбъект.Основание;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
