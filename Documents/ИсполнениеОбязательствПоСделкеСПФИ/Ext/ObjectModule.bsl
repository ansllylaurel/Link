		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.Основание.Номинал, "Номинал Основание");
		
		// дебет
		Проводка.СчетДт = УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке;
		
