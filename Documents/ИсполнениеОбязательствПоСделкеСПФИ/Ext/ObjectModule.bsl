Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Брокер",                	    Справочники.БрокерскиеКомпании.ПустаяСсылка());
	ЭлементБлокировкиДанных.УстановитьЗначение("МестоХранения",                	Справочники.МестаХранения.ВнебиржевойРынок);
	ЭлементБлокировкиДанных.УстановитьЗначение("Валюта",                		ЭтотОбъект.Валюта);

	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ЗаполнитьДвижения(ВидДвижения, Сумма)

	Если ВидДвижения = Перечисления.ВидыДвижений.Приход Тогда
		ДвижениеДС = ЭтотОбъект.Движения.ОстаткиДенежныхСредств.ДобавитьПриход();
	Иначе
		ДвижениеДС = ЭтотОбъект.Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДвижениеДС, ЭтотОбъект, "Организация, СчетДоверительногоУправления, Брокер, МестоХранения, Валюта");
	ДвижениеДС.Период = ЭтотОбъект.Дата;
	ДвижениеДС.Сумма = Сумма;
	ДвижениеДС.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
	
	ДвижениеЗД = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	ЗаполнитьЗначенияСвойств(ДвижениеЗД, ДвижениеДС, "Период, Организация, СчетДоверительногоУправления, Валюта, Сумма");
	ДвижениеЗД.ТипЗадолженности = ?(ВидДвижения = Перечисления.ВидыДвижений.Приход, Перечисления.ТипыЗадолженности.Дебиторская, Перечисления.ТипыЗадолженности.Кредиторская);
	ДвижениеЗД.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке;
	ДвижениеЗД.Контрагент = ЭтотОбъект.Основание.Контрагент;
	ДвижениеЗД.Основание = ЭтотОбъект.Основание;
	
	ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход(), ДвижениеЗД,, "ВидДвижения");
	
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);

	Если ЭтотОбъект.ПроцентныйПлатежВходящий > 0 ИЛИ ЭтотОбъект.ПроцентныйПлатежИсходящий > 0 Тогда
		Движения.ОстаткиДенежныхСредств.Записывать = Истина;
		Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
		
		Если ЭтотОбъект.ПроцентныйПлатежВходящий > 0 Тогда
			ЗаполнитьДвижения(Перечисления.ВидыДвижений.Приход, ЭтотОбъект.ПроцентныйПлатежВходящий);
		КонецЕсли;
		
		Если ЭтотОбъект.ПроцентныйПлатежИсходящий > 0 Тогда
			ЗаполнитьДвижения(Перечисления.ВидыДвижений.Расход, ЭтотОбъект.ПроцентныйПлатежИсходящий);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура СформироватьПроводкуДвиженияДС(ПараметрыПроводки)

	//СПФИ, Контрагент, СчетДС, ВидСубконтоДС, СубконтоДС, СуммаДвиженияДС, Валюта, КоррСчет, ВидДвиженияДенежныхСредств, Описание
	
	Если ПараметрыПроводки.СуммаДвиженияДС > 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		Проводка.СчетДт = ПараметрыПроводки.СчетДС;
		Проводка.СубконтоДт[ПараметрыПроводки.ВидСубконтоДС] = ПараметрыПроводки.СубконтоДС;
		Проводка.СубконтоДт.ВидДвиженияДенежныхСредств = ПараметрыПроводки.ВидДвиженияДенежныхСредств;
						
		Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.СуммаДвиженияДС;
		
		
		Проводка.СчетКт = ПараметрыПроводки.КоррСчет;
		Проводка.СубконтоКт.Контрагенты = ПараметрыПроводки.Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = ПараметрыПроводки.Основание;
		
		Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.СуммаДвиженияДС;
		
		
	ИначеЕсли ПараметрыПроводки.СуммаДвиженияДС < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ПараметрыПроводки.СуммаДвиженияДС, ПараметрыПроводки.Описание);
		
		Проводка.СчетДт = ПараметрыПроводки.КоррСчет;
		Проводка.СубконтоДт.Контрагенты = ПараметрыПроводки.Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыПроводки.Основание;
		
		Проводка.ВалютаДт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаДт = -ПараметрыПроводки.СуммаДвиженияДС;
		
		
		Проводка.СчетКт = ПараметрыПроводки.СчетДС;
		Проводка.СубконтоКт[ПараметрыПроводки.ВидСубконтоДС] = ПараметрыПроводки.СубконтоДС;
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ПараметрыПроводки.ВидДвиженияДенежныхСредств;
						
		Проводка.ВалютаКт = ПараметрыПроводки.Валюта;
		Проводка.ВалютнаяСуммаКт = -ПараметрыПроводки.СуммаДвиженияДС;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
	
	СчетДС = ПланыСчетов.Единый.РасчетыСБрокерами02; // пока предполагаем только через брокера
	ВидСубконтоДС = ПланыВидовХарактеристик.ВидыСубконто.ДоговорыБрокерскогоОбслуживания;
	СубконтоДС = БухгалтерскийУчет.ПолучитьДоговорБрокерскогоОбслуживания(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Брокер, ЭтотОбъект.Дата);
	
	ПараметрыПроводкиДвиженияДС = Новый Структура();
	ПараметрыПроводкиДвиженияДС.Вставить("Основание", ЭтотОбъект.Основание);
	ПараметрыПроводкиДвиженияДС.Вставить("Контрагент", ЭтотОбъект.Основание.Контрагент);
	ПараметрыПроводкиДвиженияДС.Вставить("СчетДС", СчетДС);
	ПараметрыПроводкиДвиженияДС.Вставить("ВидСубконтоДС", ВидСубконтоДС);
	ПараметрыПроводкиДвиженияДС.Вставить("СубконтоДС", СубконтоДС);
	ПараметрыПроводкиДвиженияДС.Вставить("Валюта", ЭтотОбъект.Валюта);
	
	// Платеж входящий
	Если ЭтотОбъект.ПроцентныйПлатежВходящий > 0 Тогда
		
		ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", ЭтотОбъект.ПроцентныйПлатежВходящий);
		ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Единый.Расчеты08);
		ПараметрыПроводкиДвиженияДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.ПрочиеПоступления);
		ПараметрыПроводкиДвиженияДС.Вставить("Описание", "Проценты по СВОПу");
		
		СформироватьПроводкуДвиженияДС(ПараметрыПроводкиДвиженияДС);
		
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.ПроцентныйПлатежВходящий, "Проценты по СВОПу");
		
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты08;
		Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Основание.Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;
		
		Проводка.ВалютаДт = ЭтотОбъект.Валюта;
		Проводка.ВалютнаяСуммаДт = ЭтотОбъект.ПроцентныйПлатежВходящий;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;
		
		
		// забаланс
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.ПроцентныйПлатежВходящий, "Задолженность по процентам");
		
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСАктивом;

		// кредит
		Проводка.СчетКт = УчетныйАктивЕПС.СчетУчетаТребованийПоПоставке;

		Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Основание;
		Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;

		Проводка.ВалютаКт = ЭтотОбъект.Валюта;
		Проводка.ВалютнаяСуммаКт = ЭтотОбъект.ПроцентныйПлатежВходящий;
		
		Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКПолучению;
		
		
		Проводка.Партия = ЭтотОбъект.Основание;
		
	КонецЕсли;
	
	// Платеж исходящий
	Если ЭтотОбъект.ПроцентныйПлатежИсходящий > 0 Тогда
		
		ПараметрыПроводкиДвиженияДС.Вставить("СуммаДвиженияДС", -ЭтотОбъект.ПроцентныйПлатежИсходящий);
		ПараметрыПроводкиДвиженияДС.Вставить("КоррСчет", ПланыСчетов.Единый.Расчеты07);
		ПараметрыПроводкиДвиженияДС.Вставить("ВидДвиженияДенежныхСредств", Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты);
		ПараметрыПроводкиДвиженияДС.Вставить("Описание", "Проценты по СВОПу");
		
		СформироватьПроводкуДвиженияДС(ПараметрыПроводкиДвиженияДС);
		
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.ПроцентныйПлатежИсходящий, "Проценты по СВОПу");
		
		Проводка.СчетДт = ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;
	
		
		Проводка.СчетКт = ПланыСчетов.Единый.Расчеты07;
		Проводка.СубконтоКт.Контрагенты = ЭтотОбъект.Основание.Контрагент;
		Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;
		
		Проводка.ВалютаКт = ЭтотОбъект.Валюта;
		Проводка.ВалютнаяСуммаКт = ЭтотОбъект.ПроцентныйПлатежИсходящий;
		
		// забаланс
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ЭтотОбъект.ПроцентныйПлатежИсходящий, "Задолженность по процентам");
		
		// дебет
		Проводка.СчетДт = УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке;

		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Основание;
		Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;

		Проводка.ВалютаДт = ЭтотОбъект.Валюта;
		Проводка.ВалютнаяСуммаДт = ЭтотОбъект.ПроцентныйПлатежИсходящий;
		
		Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКУплате;

		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом;
		
		Проводка.Партия = ЭтотОбъект.Основание;
		
	КонецЕсли;
	

	ФинРез = ЭтотОбъект.ПроцентныйПлатежВходящий - ЭтотОбъект.ПроцентныйПлатежИсходящий;
	
	Если ФинРез > 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, ФинРез, "Доход по СВОПу");
		
		Проводка.СчетДт = ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Основание;
		
		
		Проводка.СчетКт = УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций;
		
		Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивЕПС.АналитикаДоходовОтОпераций;
		Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.Основание;
		
	ИначеЕсли ФинРез < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -ФинРез, "Расход по СВОПу");
		
		Проводка.СчетДт = УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктивЕПС.АналитикаРасходовОтОпераций;
		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.Основание;
		
		
		Проводка.СчетКт = ПланыСчетов.Единый.ВспомогательныеСчета01;
		Проводка.СубконтоКт.ОснованиеРасчетов = ЭтотОбъект.Основание;
		
	КонецЕсли;
		
	
	// Прекращение признания
	Если ЭтотОбъект.ЗавершениеСделки Тогда
	
		// Считаем ФР
		
