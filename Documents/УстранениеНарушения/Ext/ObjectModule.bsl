
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ЭтотОбъект.Метаданные().Реквизиты.Основание.Тип.СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда // ввод на основании
		
		ЭтотОбъект.Основание = ДанныеЗаполнения;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЭтотОбъект.Основание, "Организация, СчетДоверительногоУправления");
		
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	Если НЕ ЭтотОбъект.ПометкаУдаления Тогда
		КонтрольУстраненияНарушения(Отказ);
	КонецЕсли;
	
	 // блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура КонтрольУстраненияНарушения(Отказ)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Основание",			ЭтотОбъект.Основание);
	Запрос.УстановитьПараметр("Ссылка", 			ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Дата", 				ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("НарушениеУстранено", ЭтотОбъект.НарушениеУстранено);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УстранениеНарушения.Дата < &Дата КАК УстраненоРанее,
		|	УстранениеНарушения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УстранениеНарушения КАК УстранениеНарушения
		|ГДЕ
		|	УстранениеНарушения.Основание = &Основание
		|	И НЕ УстранениеНарушения.ПометкаУдаления
		|	И УстранениеНарушения.Ссылка <> &Ссылка
		|	И (УстранениеНарушения.НарушениеУстранено
		|				И УстранениеНарушения.Дата <= &Дата
		|			ИЛИ &НарушениеУстранено = ИСТИНА
		|				И УстранениеНарушения.Дата >= &Дата)";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.УстраненоРанее Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Нарушение %1 устранено ранее документом %2", ЭтотОбъект.Основание, Выборка.Ссылка), Выборка.Ссылка,,, Отказ);
		Иначе	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Есть более поздний документ %1, документ устраняющий нарушение должен быть последним в цепочке документов", Выборка.Ссылка), Выборка.Ссылка,,, Отказ);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры
