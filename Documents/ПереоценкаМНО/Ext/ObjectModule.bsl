	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиМНО.РасчетныйСчет КАК РасчетныйСчет,
	|	ДОБАВИТЬКДАТЕ(_Дни.Дата, ДЕНЬ, 1) КАК Дата,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМНО.Период = ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, -1)
	|				ТОГДА ОстаткиМНО.СуммаНачальныйОстаток
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ОстаткиМНО.Период <= _Дни.Дата
	|						ТОГДА ОстаткиМНО.СуммаОборот
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ) КАК КонечныйОстаток
	|ПОМЕСТИТЬ _МНО
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваМНО.ОстаткиИОбороты(
	|			ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, -1),
	|			ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, -1),
	|			День,
	|			,
	|			РасчетныйСчет В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					_СМО.РасчетныйСчет КАК РасчетныйСчет
	|				ИЗ
	|					_СМО КАК _СМО)) КАК ОстаткиМНО,
	|	_Дни КАК _Дни
	|
	|СГРУППИРОВАТЬ ПО
	|	ДОБАВИТЬКДАТЕ(_Дни.Дата, ДЕНЬ, 1),
	|	ОстаткиМНО.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Деньги.Дата КАК Дата,
	|	_Деньги.КонечныйОстаток КАК ОстатокДС,
	|	ЕСТЬNULL(_МНО.КонечныйОстаток, 0) КАК ОстатокМНО,
	|	_Деньги.КонечныйОстаток - ЕСТЬNULL(_МНО.КонечныйОстаток, 0) КАК СуммаДСбезМНО,
	|	_Деньги.РасчетныйСчет КАК РасчетныйСчет
	|ПОМЕСТИТЬ _финал
	|ИЗ
	|	_Деньги КАК _Деньги
	|		ЛЕВОЕ СОЕДИНЕНИЕ _МНО КАК _МНО
	|		ПО _Деньги.Дата = _МНО.Дата
	|			И _Деньги.РасчетныйСчет = _МНО.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СРЕДНЕЕ(_финал.ОстатокДС) КАК ОстатокДС,
	|	СРЕДНЕЕ(_финал.СуммаДСбезМНО) КАК СуммаДСбезМНО,
	|	_финал.РасчетныйСчет КАК РасчетныйСчет
	|ПОМЕСТИТЬ _Среднее
	|ИЗ
	|	_финал КАК _финал
	|
	|СГРУППИРОВАТЬ ПО
	|	_финал.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПараметрыСМО.ПериодН КАК ПериодН,
	|	_ПараметрыСМО.ПериодК КАК ПериодК,
	|	_ПараметрыСМО.СМОПериодН КАК СМОПериодН,
	|	_ПараметрыСМО.СМОПериодК КАК СМОПериодК,
	|	_ПараметрыСМО.СтавкаПериодН КАК СтавкаПериодН,
	|	_ПараметрыСМО.СтавкаПериодК КАК СтавкаПериодК,
	|	_ПараметрыСМО.СделкаСМО КАК СделкаСМО,
	|	_ПараметрыСМО.РасчетныйСчет КАК РасчетныйСчет,
	|	_ПараметрыСМО.ДатаНачала КАК ДатаНачала,
	|	_ПараметрыСМО.ДатаОкончания КАК ДатаОкончания,
	|	_ПараметрыСМО.ПравилоРасчетаПроцента КАК ПравилоРасчетаПроцента,
	|	_ПараметрыСМО.Процент КАК Процент,
	|	_ПараметрыСМО.КлючеваяСтавка КАК КлючеваяСтавка,
	|	_ПараметрыСМО.МинимальноеЗначение КАК МинимальноеЗначение,
	|	_ПараметрыСМО.МаксимальноеЗначение КАК МаксимальноеЗначение,
	|	_ПараметрыСМО.ПроцентнаяСтавкаШкала КАК ПроцентнаяСтавкаШкала,
	|	_Среднее.СуммаДСбезМНО КАК Сумма,
	|	РАЗНОСТЬДАТ(_ПараметрыСМО.ПериодН, ДОБАВИТЬКДАТЕ(_ПараметрыСМО.ПериодК, ДЕНЬ, 1), ДЕНЬ) КАК Дней,
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(_ПараметрыСМО.ПериодК, ГОД), КОНЕЦПЕРИОДА(_ПараметрыСМО.ПериодК, ГОД), ДЕНЬ) + 1 КАК ДнейВГоду,
	|	ВЫБОР
	|		КОГДА _ПараметрыСМО.ПравилоРасчетаПроцента = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаПроцентовСМО.АбсолютноеЗначение)
	|			ТОГДА _ПараметрыСМО.Процент
	|		КОГДА _ПараметрыСМО.ПравилоРасчетаПроцента = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаПроцентовСМО.ДекрементОтКлючевойСтавки)
	|			ТОГДА _ПараметрыСМО.КлючеваяСтавка - _ПараметрыСМО.Процент
	|		КОГДА _ПараметрыСМО.ПравилоРасчетаПроцента = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаПроцентовСМО.ШкалаПроцентныхСтавок)
	|			ТОГДА ВЫБОР
	|					КОГДА _ПараметрыСМО.МаксимальноеЗначение <> 0
	|								И _Среднее.СуммаДСбезМНО >= _ПараметрыСМО.МинимальноеЗначение
	|								И _Среднее.СуммаДСбезМНО < _ПараметрыСМО.МаксимальноеЗначение
	|							ИЛИ _ПараметрыСМО.МаксимальноеЗначение = 0
	|								И _Среднее.СуммаДСбезМНО >= _ПараметрыСМО.МинимальноеЗначение
	|						ТОГДА _ПараметрыСМО.ПроцентнаяСтавкаШкала
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|	КОНЕЦ КАК ПроцентСМО
	|ПОМЕСТИТЬ _ДанныеДляРасчета
	|ИЗ
	|	_ПараметрыСМО КАК _ПараметрыСМО
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Среднее КАК _Среднее
	|		ПО _ПараметрыСМО.РасчетныйСчет = _Среднее.РасчетныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ДанныеДляРасчета.СделкаСМО КАК СделкаСМО,
	|	_АкутальныеДоговорыСМО.ТекущийДоговорСМО КАК ТекущийДоговорСМО,
	|	_ДанныеДляРасчета.РасчетныйСчет КАК РасчетныйСчет,
	|	_ДанныеДляРасчета.Сумма КАК Сумма,
	|	_ДанныеДляРасчета.ПроцентСМО КАК ПроцентСМО,
	|	_ДанныеДляРасчета.Дней КАК Дней,
	|	_ДанныеДляРасчета.ДнейВГоду КАК ДнейВГоду,
	|	_ДанныеДляРасчета.Сумма * _ДанныеДляРасчета.ПроцентСМО / 100 * _ДанныеДляРасчета.Дней / _ДанныеДляРасчета.ДнейВГоду КАК СуммаПроцентов
	|ПОМЕСТИТЬ _Расчет
	|ИЗ
	|	_ДанныеДляРасчета КАК _ДанныеДляРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ _АкутальныеДоговорыСМО КАК _АкутальныеДоговорыСМО
	|		ПО _ДанныеДляРасчета.СделкаСМО = _АкутальныеДоговорыСМО.ИсходныйДоговорСМО
	|ГДЕ
	|	_ДанныеДляРасчета.ПроцентСМО > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Расчет.ТекущийДоговорСМО КАК ТекущийДоговорСМО,
	|	_Расчет.Сумма КАК Сумма,
	|	СУММА(_Расчет.СуммаПроцентов) КАК СуммаПроцентов
	|ИЗ
	|	_Расчет КАК _Расчет
	|
	|СГРУППИРОВАТЬ ПО
	|	_Расчет.ТекущийДоговорСМО,
	|	_Расчет.Сумма";
	#КонецОбласти
		
	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("КонецПериода",		КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода",		НачалоПериода);
	Запрос.УстановитьПараметр("СписокСтратегий",	СписокСтратегий);
	
	ПараметрыСМО = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СМО из ПараметрыСМО Цикл 
		НоваяСтрока = ЭтотОбъект.МНО.Добавить();
		НоваяСтрока.МНО = СМО.ТекущийДоговорСМО;
		НоваяСтрока.Номинал = СМО.Сумма;
		НоваяСтрока.ОценочнаяСумма = СМО.СуммаПроцентов;		
	КонецЦикла;	
		
КонецПроцедуры

Процедура ЗаполнениеФЕО(СписокСтратегий, ДатаПереоценки, Отказ)
	
	ПроцентыПоСделкамФЕО = РаботаСМНО.РассчитатьПроцентыПоСделкамФЕО(ЭтотОбъект.Организация, СписокСтратегий, ДатаПереоценки, Отказ);
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	
	Для Каждого ПроцентыПоСделке Из ПроцентыПоСделкамФЕО Цикл
		НоваяСтрока = ЭтотОбъект.МНО.Добавить();
		НоваяСтрока.МНО				= ПроцентыПоСделке.Сделка;
		НоваяСтрока.ОценочнаяСумма	= ПроцентыПоСделке.Сумма;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнениеБалансовойСтоимости(СписокСтратегий, ДатаПереоценки, Отказ)
	
	// Определяем счет переоценки	
	
	СчетаУчетаПереоценки = Документы.ПереоценкаМНО.ПолучитьСчетаУчетаПереоценки(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, ЭтотОбъект.Дата, Отказ);
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Если НастройкиУчета.СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.Расчеты Тогда
		    Субконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов;
		Иначе
			Субконто = ПланыВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов;
		КонецЕсли;
	ИначеЕсли ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет
		ИЛИ ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет
	Тогда
		Субконто = ПланыВидовХарактеристик.ВидыСубконто.МНО;
	КонецЕсли;
	
	// Получаем начисления по счету переоценки	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТабличнаяЧасть.МНО КАК МНО,
		|	ТабличнаяЧасть.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ _ТабличнаяЧасть
		|ИЗ
		|	&ТабличнаяЧасть КАК ТабличнаяЧасть
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаУчетаПереоценки.УчетныйАктив КАК УчетныйАктив,
		|	СчетаУчетаПереоценки.СчетУчетаПереоценки КАК СчетУчетаПереоценки
		|ПОМЕСТИТЬ _СчетаУчетаПереоценки
		|ИЗ
		|	&СчетаУчетаПереоценки КАК СчетаУчетаПереоценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТабличнаяЧасть.МНО КАК МНО,
		|	_ТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
		|	РегистрБухгалтерииОстатки.СуммаОстаток КАК БалансоваяСумма
		|ИЗ
		|	_ТабличнаяЧасть КАК _ТабличнаяЧасть
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В
		|					(ВЫБРАТЬ
		|						_СчетаУчетаПереоценки.СчетУчетаПереоценки
		|					ИЗ
		|						_СчетаУчетаПереоценки),
		|				&Субконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)) КАК РегистрБухгалтерииОстатки
		|		ПО (РегистрБухгалтерииОстатки.Субконто1 = _ТабличнаяЧасть.МНО)");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки",
		"РегистрБухгалтерии." + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета) + ".Остатки");	
	
	Запрос.УстановитьПараметр("Период",				  Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",		  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СписокСтратегий",	  СписокСтратегий);
	Запрос.УстановитьПараметр("ТабличнаяЧасть",		  ЭтотОбъект.МНО.Выгрузить(, "МНО, НомерСтроки"));			
	Запрос.УстановитьПараметр("СчетаУчетаПереоценки", СчетаУчетаПереоценки);
	Запрос.УстановитьПараметр("Субконто",			  Субконто);

	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		ЭтотОбъект.МНО[ВыборкаЗапроса.НомерСтроки - 1].БалансоваяСумма = Макс(ВыборкаЗапроса.БалансоваяСумма, 0);	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрименитьПолитикуУчета(ДатаПереоценки)
	
	ТребуетсяПереоценка = РаботаСПереоценкой.ОпределитьНаличиеПорученияНаПереоценку(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ДатаПереоценки, ЭтотОбъект.ВидУчета, Перечисления.ВидыАктивовДляПорученийНаПереоценку.МНО);
	
	Если НЕ ТребуетсяПереоценка Тогда
	
		Для Каждого СтрокаМНО Из ЭтотОбъект.МНО Цикл
			
			УчетныйАктив = Документы.ПереоценкаМНО.ОпределитьУчетныйАктив(СтрокаМНО.МНО, ЭтотОбъект.ВидУчета);
			
			ТребуетсяПереоценкаАктива = Документы.ПереоценкаМНО.ТребуетсяПереоценка(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, УчетныйАктив, ДатаПереоценки);	
			Если Не ТребуетсяПереоценкаАктива Тогда
				СтрокаМНО.ОценочнаяСумма = СтрокаМНО.БалансоваяСумма;
			КонецЕсли;
			
			ТребуетсяПереоценка = ТребуетсяПереоценка ИЛИ ТребуетсяПереоценкаАктива;
			
		КонецЦикла;
	
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ТребуетсяПереоценка", ТребуетсяПереоценка);
	
КонецПроцедуры

#КонецОбласти
