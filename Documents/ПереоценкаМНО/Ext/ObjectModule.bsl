	|ПОМЕСТИТЬ _ПоследнийДоговор
	|ИЗ
	|	_ДействующиеДоговора КАК _ДействующиеДоговора
	|
	|СГРУППИРОВАТЬ ПО
	|	_ДействующиеДоговора.ИсходныйДоговорСМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПоследнийДоговор.ИсходныйДоговорСМО КАК ИсходныйДоговорСМО,
	|	_ДействующиеДоговора.ТекущийДоговорСМО КАК ТекущийДоговорСМО
	|ПОМЕСТИТЬ _АкутальныеДоговорыСМО
	|ИЗ
	|	_ПоследнийДоговор КАК _ПоследнийДоговор
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеДоговора КАК _ДействующиеДоговора
	|		ПО _ПоследнийДоговор.ИсходныйДоговорСМО = _ДействующиеДоговора.ИсходныйДоговорСМО
	|			И _ПоследнийДоговор.Дата = _ДействующиеДоговора.Дата
	|ГДЕ
	|	_ДействующиеДоговора.ТекущийДоговорСМО.ДатаОкончанияДействия > &КонецПериода";
	
	//определяем активные договоры СМО
	
	НачалоПериода	= НачалоМесяца(ДатаПереоценки); 
	КонецПериода	= КонецДня(ДатаПереоценки);
	ДнейВГоду		= ДеньГода(КонецГода(КонецПериода));	
	
	
	ЗапросСМО.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	ЗапросСМО.УстановитьПараметр("НачалоПериода",	НачалоПериода);
	ЗапросСМО.УстановитьПараметр("КонецПериода",	КонецПериода);
	ЗапросСМО.УстановитьПараметр("СписокСтратегий",	СписокСтратегий);
	
	РезультатЗапроса = ЗапросСМО.Выполнить();
	
	АктивныеСМО = МенеджерВременныхТаблиц.Таблицы.Найти("_АкутальныеДоговорыСМО").ПолучитьДанные().Выгрузить();
	//Таблица _АкутальныеДоговорыСМО будет использоваться в следующем запросе.  
	
	Если АктивныеСМО.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;		
		
	// _СтавкиЦБРФ - Ключевые ставки ЦБ
	// _ПериодыСтавкиЦБ Определяем как в периоде менялась ключевая ставка
	// _СМО и _ПериодыСМО. Этот же финт проделываем с Параметрами сделок СМО
	// _ПараметрыСМО объединяем таблицы _ПериодыСтавкиЦБ и _ПериодыСМО по пересекающимся периодам
	// Далее вычисляем среднее по счету 
	// Период берем -1 день. Берем конечные остатки на день -1. 
	//	_Дни Календарные дни за период
	// 	_Деньги Остатки денег. На первый день (-1 на самом деле) берем конечный остаток, на прочие дни
	//     берем оборот за период. 
	//  _МНО Аналогично для МНО
	//	_финал Соединяем обе таблицы, берем сумму остатка без МНО 
	//  _Среднее 
	// _ДанныеДляРасчета вычисляем все параметры, необходимые для расчета
	// и наконец считаем	
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
	#Область ТекстЗапроса
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлючевыеСтавкиЦБРФ.ДатаЗначения КАК ДатаЗначения,
	|	КлючевыеСтавкиЦБРФ.ЗначениеПоказателя КАК КлючеваяСтавка
	|ПОМЕСТИТЬ _СтавкиЦБРФ
	|ИЗ
	|	РегистрСведений.ПроцентныеПоказатели.СрезПоследних(
	|			&КонецПериода,
	|			Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
	|				И Прогноз = ЛОЖЬ) КАК КлючевыеСтавкиЦБРФ
	|ГДЕ
	|	КлючевыеСтавкиЦБРФ.ДатаЗначения МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&НачалоПериода,
	|	КлючевыеСтавкиЦБРФ.ЗначениеПоказателя
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		КлючевыеСтавкиЦБРФ.ДатаЗначения КАК ДатаЗначения,
	|		КлючевыеСтавкиЦБРФ.ЗначениеПоказателя КАК ЗначениеПоказателя
	|	ИЗ
	|		РегистрСведений.ПроцентныеПоказатели КАК КлючевыеСтавкиЦБРФ
	|	ГДЕ
	|		КлючевыеСтавкиЦБРФ.Показатель = ЗНАЧЕНИЕ(Перечисление.ВидыПроцентныхПоказателей.КлючеваяСтавкаЦБРФ)
	|		И КлючевыеСтавкиЦБРФ.Прогноз = ЛОЖЬ
	|		И КлючевыеСтавкиЦБРФ.Период <= &КонецПериода
	|		И КлючевыеСтавкиЦБРФ.ДатаЗначения < &НачалоПериода
	|	
	|	УПОРЯДОЧИТЬ ПО
	|		КлючевыеСтавкиЦБРФ.ДатаЗначения УБЫВ,
	|		КлючевыеСтавкиЦБРФ.Период УБЫВ) КАК КлючевыеСтавкиЦБРФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
