
#Область Обработчики_событий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
	
		Для каждого СтрокаМНО Из ЭтотОбъект.МНО Цикл
			Если СтрокаМНО.СуммаПоЭСП <> 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнено значение 'Сумма по ЭСП', и вид учета не равен ЕПС", ЭтотОбъект.Ссылка,,, Отказ);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведенияЕПС(Отказ, Режим)

	// определим возможность проведения документа
	ПереоценкаПослеВводаНачальныхОстатков = Ложь;
	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);	
	
	Если Не ВедетсяУчетПоТекущемуВиду Тогда // в случае ввода нач. остатков переоценку также разрешаем
		ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
			ДатаПереоценки + 24 * 60 * 60,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВидУчета);
			
		Если Не ВедетсяУчетПоТекущемуВиду Тогда
			Возврат;
		КонецЕсли;		
			
		ПереоценкаПослеВводаНачальныхОстатков = Истина;
	КонецЕсли;
	
	// формирование проводок
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	Для Каждого ТекСтрокаМНО Из ЭтотОбъект.МНО Цикл
		
		НачислитьПроцентов = (ТекСтрокаМНО.ОценочнаяСумма - ТекСтрокаМНО.БалансоваяСумма);
		
		Если НачислитьПроцентов <> 0 Тогда
			
			УчетныйАктив = Документы.ПереоценкаМНО.ОпределитьУчетныйАктив(ТекСтрокаМНО.МНО, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);		
			
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(НачислитьПроцентов, ТекСтрокаМНО.МНО.РасчетныйСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Начисление процентов по МНО");
			
			// дебет
			Если НастройкиУчета.СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.Расчеты Тогда // 474
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = ТекСтрокаМНО.МНО.РасчетныйСчет.Банк.ЮрФизЛицо;
				Проводка.СубконтоДт.ОснованиеРасчетов = ТекСтрокаМНО.МНО;
				
				Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.МНО;
				
			ИначеЕсли НастройкиУчета.СчетУчетаПроцентовПоМНО = ПланыСчетов.Единый.РасчетныеСчета Тогда // 205
				
				Проводка.СчетДт = ПланыСчетов.Единый.РасчетныеСчета07;
				
				Проводка.СубконтоДт.БанковскиеСчета = ТекСтрокаМНО.МНО.РасчетныйСчет;
				Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ТекСтрокаМНО.МНО;
				
			Иначе // 206
				
				Проводка.СчетДт = УчетныйАктив.СчетУчетаПереоценкиА;
			
				Проводка.СубконтоДт.Контрагенты = ТекСтрокаМНО.МНО.РасчетныйСчет.Банк.ЮрФизЛицо;
				Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = ТекСтрокаМНО.МНО;
				
			КонецЕсли;
			
			Проводка.ВалютаДт  = ТекСтрокаМНО.МНО.РасчетныйСчет.Валюта;
			Проводка.ВалютнаяСуммаДт = НачислитьПроцентов;
			
			// кредит
			Если ПереоценкаПослеВводаНачальныхОстатков Тогда
				Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
			Иначе
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчет.ОпределитьГруппуФинансовогоУчетаДоходовРасходов("3112", Новый Структура("Банк, Период", ТекСтрокаМНО.МНО.РасчетныйСчет.Банк, Дата));
				Проводка.СубконтоКт.ЦенныеБумаги                          = ТекСтрокаМНО.МНО.РасчетныйСчет;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекСтрокаМНО.СуммаПоЭСП <> 0 Тогда
			
			Если НачалоДня(ТекСтрокаМНО.МНО.Дата) = НачалоДня(ЭтотОбъект.Дата) Тогда
				БухгалтерскийУчетЕПС.ПровестиКорректировкуПП(ЭтотОбъект, ТекСтрокаМНО.МНО, ТекСтрокаМНО.ОценочнаяСумма, ТекСтрокаМНО.СуммаПоЭСП);
			Иначе
				БухгалтерскийУчетЕПС.ПровестиКорректировкуЭСП(ЭтотОбъект, ТекСтрокаМНО.МНО, ТекСтрокаМНО.ОценочнаяСумма, ТекСтрокаМНО.СуммаПоЭСП, ПереоценкаПослеВводаНачальныхОстатков);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	МассивУчетныхАктивов = Новый Массив;
	МассивУчетныхАктивов.Добавить(Справочники.УчетныеАктивыЕПС.ПроцентыНаМНО);
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Ложь, Истина, ЭтотОбъект.МНО.ВыгрузитьКолонку("МНО"), Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ДатаПереоценки = НачалоДня(ЭтотОбъект.Дата);
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		ОбработкаПроведенияЕПС(Отказ, Режим);
		Возврат;
	КонецЕсли;
	
	// определим возможность проведения документа
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	Если Не ВедетсяУчетПоТекущемуВиду Тогда
		Возврат;
	КонецЕсли;		
	
	// формирование проводок
	НастройкиУчетаПереоценки = БухгалтерскийУчет.ОпределитьНастройкиУчетаПереоценки(
		ДатаПереоценки,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
	
	Для Каждого ТекСтрокаМНО Из ЭтотОбъект.МНО Цикл
				
		Если ТекСтрокаМНО.ОценочнаяСумма - ТекСтрокаМНО.БалансоваяСумма <> 0 Тогда
			
			// Получение настроек учетного актива		
			
			УчетныйАктив = Документы.ПереоценкаМНО.ОпределитьУчетныйАктив(ТекСтрокаМНО.МНО, ЭтотОбъект.ВидУчета);		
				
			УчитыватьПереоценкуОтдельно = НастройкиУчетаПереоценки[УчетныйАктив.ИмяПредопределенныхДанных];
			
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				ЭтотОбъект.ВидУчета);
				
			СчетУчетаПереоценки = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				ЭтотОбъект.ВидУчета);
				
			АналитикаДоходовОтПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				ЭтотОбъект.ВидУчета,
				"АналитикаДоходовОтПереоценки");		
				
			// Новая проводка
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ТекСтрокаМНО.ОценочнаяСумма - ТекСтрокаМНО.БалансоваяСумма, "Переоценка МНО");
			
			// дебет
			Если Не УчитыватьПереоценкуОтдельно Тогда
				Проводка.СчетДт = СчетУчета;
			Иначе
				Проводка.СчетДт = СчетУчетаПереоценки;
			КонецЕсли;
			
			Проводка.СубконтоДт.МНО = ТекСтрокаМНО.МНО;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходовОтПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги         = ТекСтрокаМНО.МНО;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Заполнение_табличной_части

Процедура ЗаполнитьТабличнуюЧасть(Отказ = Ложь) Экспорт
	
	ЭтотОбъект.МНО.Очистить();
	
	ДатаПереоценки	= НачалоДня(ЭтотОбъект.Дата);
	СписокСтратегий	= Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления);  
	
	// Заполняем действующими соглашениями по процентам на остаток
	
	ЗаполнитьМНО(СписокСтратегий, ДатаПереоценки);
	
	Если Не Отказ Тогда
		ЗаполнениеСМО(СписокСтратегий, ДатаПереоценки);
	КонецЕсли;
	
	Если Не Отказ Тогда
		ЗаполнениеФЕО(СписокСтратегий, ДатаПереоценки, Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		ЗаполнениеБалансовойСтоимости(СписокСтратегий, ДатаПереоценки, Отказ);
	КонецЕсли;
	
	// Применяем политику учета при необходимости
	
	Если Не Отказ И ЭтотОбъект.ПереоцениватьНаОснованииНастроекУчета Тогда
		ПрименитьПолитикуУчета(ДатаПереоценки);
	КонецЕсли;
	
	// Если при заполнении были ошибки,
	// значит переоценку по данным табличнойной части выполнять нельзя
	
	Если Отказ Тогда
		ЭтотОбъект.МНО.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьМНО(СписокСтратегий, ДатаПереоценки)

	Отказ = Ложь;
	
	// для благосостояния (задача #369394)
	ЭтоБлагосостояниеЕПС = (ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет
			И Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата)
				= ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Благосостояние"));
	
	Если ЭтоБлагосостояниеЕПС Тогда
	
		ОпределитьПериодичностьПереоценкиМНО = Истина;
		СтоимостиМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
			ЭтотОбъект.СчетДоверительногоУправления, 
			ЭтотОбъект.ВидУчета, 
			ОпределитьПериодичностьПереоценкиМНО,
			КонецДня(ЭтотОбъект.Дата),
			Справочники.ЦелиРасчета.ЕдиныйПланСчетов,
			Отказ);
				
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось рассчитать стоимость МНО по ставке ЭСП", ЭтотОбъект.Ссылка,,, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваМНООстатки.МНО,
		|	ДенежныеСредстваМНООстатки.СуммаОстаток КАК Номинал
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В(&СписокСтратегий)) КАК ДенежныеСредстваМНООстатки");

	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", 			Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СписокСтратегий", 	СписокСтратегий);

	ДанныеМНО = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаМНО Из ДанныеМНО Цикл
		НоваяСтрока = ЭтотОбъект.МНО.Добавить();
		НоваяСтрока.МНО 			= СтрокаМНО.МНО;
		НоваяСтрока.Номинал 		= СтрокаМНО.Номинал;
		НоваяСтрока.ОценочнаяСумма	= РаботаСМНО.РасчетСуммыМНО(СтрокаМНО.МНО, ДатаПереоценки);
		
		// для благосостояния (задача #369394)
		Если ЭтоБлагосостояниеЕПС Тогда
			СтрокаСтоимостиМНО = СтоимостиМНО.Найти(СтрокаМНО.МНО, "МНО");
			Если СтрокаСтоимостиМНО <> Неопределено Тогда
			    НоваяСтрока.СуммаПоЭСП = СтрокаСтоимостиМНО.ПроцентыМНО;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнениеСМО(СписокСтратегий, ДатаПереоценки)
	
	//в документ нужно вернуть последнее доп. соглашие по договору СМО
	//  _ДействующиеДоговора - Все СМО какие есть. 
	// _ПоследнийДоговор - находим (максимальная дата) послединий договор СМО
	// Из двух таблиц определяем Действующий и Исходный договор СМО
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросСМО = Новый Запрос;
	ЗапросСМО.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросСМО.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыСделкиСМОСрезПоследних.Регистратор КАК ТекущийДоговорСМО,
	|	ПараметрыСделкиСМОСрезПоследних.СделкаСМО КАК ИсходныйДоговорСМО,
	|	ПараметрыСделкиСМОСрезПоследних.Период КАК Дата
	|ПОМЕСТИТЬ _ДействующиеДоговора
	|ИЗ
	|	РегистрСведений.УсловияСделокСМО.СрезПоследних(
	|			&НачалоПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СписокСтратегий)
	|				И БазаДляНачисленияПроцентов = ЗНАЧЕНИЕ(Перечисление.БазаДляНачисленияПроцентовНаОстаткиДенежныхСредств.СреднемесячныйОстаток)) КАК ПараметрыСделкиСМОСрезПоследних
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УсловияСделокСМО.Регистратор,
	|	УсловияСделокСМО.СделкаСМО,
	|	УсловияСделокСМО.Период
	|ИЗ
	|	РегистрСведений.УсловияСделокСМО КАК УсловияСделокСМО
	|ГДЕ
	|	УсловияСделокСМО.Организация = &Организация
	|	И УсловияСделокСМО.СчетДоверительногоУправления В(&СписокСтратегий)
	|	И УсловияСделокСМО.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И УсловияСделокСМО.БазаДляНачисленияПроцентов = ЗНАЧЕНИЕ(Перечисление.БазаДляНачисленияПроцентовНаОстаткиДенежныхСредств.СреднемесячныйОстаток)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
