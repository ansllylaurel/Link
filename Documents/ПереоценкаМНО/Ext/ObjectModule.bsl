	|				И СчетДоверительногоУправления В (&СписокСтратегий)) КАК ПараметрыСделкиСМОСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШкалыПроцентныхСтавок.Шкала КАК ШкалыПроцентныхСтавокШкала
	|		ПО ПараметрыСделкиСМОСрезПоследних.ШкалаПроцентныхСтавок = ШкалыПроцентныхСтавокШкала.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УсловияСделокСМО.Период,
	|	УсловияСделокСМО.СделкаСМО,
	|	УсловияСделокСМО.ДатаНачалаДействия,
	|	УсловияСделокСМО.ДатаОкончанияДействия,
	|	УсловияСделокСМО.ПравилоРасчетаПроцента,
	|	УсловияСделокСМО.Процент,
	|	УсловияСделокСМО.РасчетныйСчет,
	|	ЕСТЬNULL(ШкалыПроцентныхСтавокШкала.МинимальноеЗначение, 0),
	|	ЕСТЬNULL(ШкалыПроцентныхСтавокШкала.МаксимальноеЗначение, 0),
	|	ЕСТЬNULL(ШкалыПроцентныхСтавокШкала.ПроцентнаяСтавка, 0)
	|ИЗ
	|	РегистрСведений.УсловияСделокСМО КАК УсловияСделокСМО
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШкалыПроцентныхСтавок.Шкала КАК ШкалыПроцентныхСтавокШкала
	|		ПО УсловияСделокСМО.ШкалаПроцентныхСтавок = ШкалыПроцентныхСтавокШкала.Ссылка
	|ГДЕ
	|	УсловияСделокСМО.Организация = &Организация
	|	И УсловияСделокСМО.СчетДоверительногоУправления В(&СписокСтратегий)
	|	И УсловияСделокСМО.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМО.Период КАК СМОПериодН,
	|	ЕСТЬNULL(ДОБАВИТЬКДАТЕ(МИНИМУМ(СМО_Конец.Период), СЕКУНДА, -1), &КонецПериода) КАК СМОПериодК,
	|	СМО.СделкаСМО КАК СделкаСМО,
	|	СМО.РасчетныйСчет КАК РасчетныйСчет,
	|	СМО.ДатаНачала КАК ДатаНачала,
	|	СМО.ДатаОкончания КАК ДатаОкончания,
	|	СМО.ПравилоРасчетаПроцента КАК ПравилоРасчетаПроцента,
	|	СМО.Процент КАК Процент,
	|	СМО.МинимальноеЗначение КАК МинимальноеЗначение,
	|	СМО.МаксимальноеЗначение КАК МаксимальноеЗначение,
