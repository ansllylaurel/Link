
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ТипУполномочивающегоДокумента = ?(ЗначениеЗаполнено(Объект.ДоверенностьУполномоченногоЛица), 2, 1);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры
	
#КонецОбласти

#Область СобытияРеквизитовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетностиПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСтандартныйПериодОтчетности(ДатаНачала, ДатаОкончания)
	
	Возврат Документы.АудиторскоеЗаключение.ЭтоСтандартныйПериодОтчетности(ДатаНачала, ДатаОкончания);
	
КонецФункции	

&НаКлиенте
Процедура НачалоПериодаОтчетностиПриИзменении(Элемент)
	
	СтандартныйПериодОтчетности = ЭтоСтандартныйПериодОтчетности(Объект.НачалоПериодаОтчетности, Объект.КонецПериодаОтчетности);
	Объект.ИнформацияОСобытии   = ?(СтандартныйПериодОтчетности, "", Объект.ИнформацияОСобытии);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаОтчетностиПриИзменении(Элемент)

	СтандартныйПериодОтчетности = ЭтоСтандартныйПериодОтчетности(Объект.НачалоПериодаОтчетности, Объект.КонецПериодаОтчетности);
	Объект.ИнформацияОСобытии   = ?(СтандартныйПериодОтчетности, "", Объект.ИнформацияОСобытии);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)

	ДанныеОбъекта = Форма.Объект;
	Элементы	  = Форма.Элементы;
	
	ГКФО = (ДанныеОбъекта.ВидОтчетности = ПредопределенноеЗначение("Перечисление.ВидыОтчетностиПодлежащиеАудиторскойПроверке.ГодоваяКонсолидированнаяОтчетность")
		ИЛИ ДанныеОбъекта.ВидОтчетности = ПредопределенноеЗначение("Перечисление.ВидыОтчетностиПодлежащиеАудиторскойПроверке.ГодоваяФинансоваяОтчетность")); 
									
	СопроводительноеПисьмоВXBRL = (Год(ДанныеОбъекта.КонецПериодаОтчетности) >= 2020);
	
	Элементы.СоставОтчетности.Видимость 						= (ГКФО И СопроводительноеПисьмоВXBRL);
	Элементы.ДатаПодписанияОтчетности.Видимость 				= (ГКФО И СопроводительноеПисьмоВXBRL);
	Элементы.СтраницаРаскрытияАудиторскогоЗаключения.Видимость 	= (ГКФО И СопроводительноеПисьмоВXBRL);
	Элементы.РаскрытиеОтчетностиВИномМесте.Видимость 			= (ГКФО И СопроводительноеПисьмоВXBRL);
	Элементы.ФактическоеРаскрытиеИнформации.Видимость 			= (ГКФО И СопроводительноеПисьмоВXBRL);
	
	Элементы.ГруппаУполномочивающийДокумент.Видимость = Форма.ТипУполномочивающегоДокумента = 1;
	Элементы.ГруппаДоверенность.Видимость             = Форма.ТипУполномочивающегоДокумента = 2;
    Элементы.ГруппаРеквизитыДоверенности.Видимость    = ЗначениеЗаполнено(ДанныеОбъекта.ДоверенностьУполномоченногоЛица);

	Элементы.ИнформацияОСобытии.Видимость = Не (ЭтоСтандартныйПериодОтчетности(ДанныеОбъекта.НачалоПериодаОтчетности, 
																				ДанныеОбъекта.КонецПериодаОтчетности));
			
	Элементы.Примечание.Видимость = ДанныеОбъекта.КатегорияМненияОДостоверностиОтчетности 
		<> ПредопределенноеЗначение("Перечисление.КатегорииМненийОДостоверностиОтчетности.НемодифицированноеАудиторскоеЗаключение");
	
КонецПроцедуры

&НаКлиенте
Процедура ДоверенностьУполномоченногоЛицаПриИзменении(Элемент)

	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорияМненияОДостоверностиОтчетностиПриИзменении(Элемент)
	
	Объект.Примечание = ?(Объект.КатегорияМненияОДостоверностиОтчетности = ПредопределенноеЗначение("Перечисление.КатегорииМненийОДостоверностиОтчетности.НемодифицированноеАудиторскоеЗаключение"),
							Неопределено,
							Объект.Примечание);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ТипУполномочивающегоДокументаПриИзменении(Элемент)

	Объект.ДоверенностьУполномоченногоЛица = ?(ЭтаФорма.ТипУполномочивающегоДокумента = 2, Объект.ДоверенностьУполномоченногоЛица, Неопределено);
	Объект.НомерУполномочивающегоДокумента = ?(ЭтаФорма.ТипУполномочивающегоДокумента = 2, Неопределено, Объект.НомерУполномочивающегоДокумента); 
	Объект.ДатаУполномочивающегоДокумента  = ?(ЭтаФорма.ТипУполномочивающегоДокумента = 2, Неопределено, Объект.ДатаУполномочивающегоДокумента); 
	Объект.ДатаНачалаДействияПолномочий    = ?(ЭтаФорма.ТипУполномочивающегоДокумента = 2, Неопределено, Объект.ДатаНачалаДействияПолномочий); 
	Объект.ДатаОкончанияДействияПолномочий = ?(ЭтаФорма.ТипУполномочивающегоДокумента = 2, Неопределено, Объект.ДатаОкончанияДействияПолномочий); 
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры
	
#КонецОбласти