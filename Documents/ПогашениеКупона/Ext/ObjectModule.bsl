КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Облигация, "ВалютаНоминала");
		
		Если (НачалоДня(ЭтотОбъект.Дата) < ЭтотОбъект.Облигация.ДатаПогашения) Тогда
			ПроверкаДатыДокументаНаСоответствиеГрафикуНачисленияПроцентов(Отказ);
		ИначеЕсли (НачалоДня(ЭтотОбъект.ДатаФиксации) = ЭтотОбъект.Облигация.ДатаФиксацииДляПогашения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Последнее погашение купона вводится с помощью документа ""Погашение облигации"".'"), ЭтотОбъект, "Облигация",, Отказ);
		КонецЕсли;

		Если ЭтотОбъект.Дата < ЭтотОбъект.ДатаФиксации Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа не может быть меньше даты фиксации.'"), ЭтотОбъект, "ДатаФиксации",, Отказ);
		КонецЕсли;

		СообщитьОРазныхВалютах = Ложь;//типа проведение бэкофиса все отрабатывает
		Если ЭтотОбъект.ВалютаОплаты <> ВалютаНоминала Тогда 
			ВидыУчетаДляПроведения = Неопределено;
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ВидыУчетаДляПроведения", ВидыУчетаДляПроведения) Тогда
				Для каждого видУчета из ВидыУчетаДляПроведения Цикл
					Если видУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
						СообщитьОРазныхВалютах = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если СообщитьОРазныхВалютах Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Валюта оплаты отличается от валюты номинала облигации.'"), ЭтотОбъект, "ВалютаОплаты",,);
			КонецЕсли;
		КонецЕсли;

		ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(ЭтотОбъект);
		
		Если ДетализацияПоРасчетномуСчету Тогда
			Если НЕ ЗначениеЗаполнено(РасчетныйСчет) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Расчетный счёт"" не заполнено'"), ЭтотОбъект, "РасчетныйСчет",, );			
			Иначе
				Если ЭтотОбъект.РасчетныйСчет.Валюта <> ВалютаНоминала Тогда 
					Если СообщитьОРазныхВалютах Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Валюта расчетного счета отличается от валюты номинала облигации!'"), ЭтотОбъект, "РасчетныйСчет",, );
					КонецЕсли;
				КонецЕсли;
				Если ЭтотОбъект.РасчетныйСчет.Валюта <> ЭтотОбъект.ВалютаОплаты Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Валюта расчетного счета отличается от валюты оплаты!'"), ЭтотОбъект, "РасчетныйСчет",, );
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Для документов с определенной даты при расхождении валюты оплаты и валюты номинала
		// требуется обязательное заполнение полей "Сумма на одну облигацию в валюте оплаты"
		// и "Сумма купона в валюте оплаты".
		ДатаОграничения = Дата(2026, 4, 1);

		//Если НачалоДня(ЭтотОбъект.Дата) >= ДатаОграничения И ЭтотОбъект.ВалютаОплаты <> ВалютаНоминала Тогда
			
			Если ЭтотОбъект.СуммаНаОднуОблигациюВВалютеОплаты = 0 Тогда
				ТекстСообщения = НСтр("ru='Не заполнено поле ""Сумма на одну облигацию в валюте оплаты"". Ограничение действует для документов с %1'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Формат(ДатаОграничения, "ДФ=dd.MM.yyyy"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстСообщения,
					ЭтотОбъект,
					"СуммаНаОднуОблигациюВВалютеОплаты",
					,
					Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.СуммаКупонаВВалютеОплаты = 0 Тогда
				ТекстСообщения = НСтр("ru='Не заполнено поле ""Сумма купона в валюте оплаты"". Ограничение действует для документов с %1'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Формат(ДатаОграничения, "ДФ=dd.MM.yyyy"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстСообщения,
					ЭтотОбъект,
					"СуммаКупонаВВалютеОплаты",
					,
					Отказ);
			КонецЕсли;
			
		//КонецЕсли;
		
		Если ВалютаНоминала = ЭтотОбъект.ВалютаОплаты Тогда
			ЭтотОбъект.СуммаКупонаВВалютеОплаты = ЭтотОбъект.СуммаКупона;
			ЭтотОбъект.СуммаНаОднуОблигациюВВалютеОплаты = ЭтотОбъект.СуммаНаОднуОблигацию;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
