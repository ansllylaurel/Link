			ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	ПланыСчетов.Единый.ПроцентныеДоходы06);
			ПараметрыНачисления.Вставить("ГФУПарный",		ВыборкаДетальныеЗаписи.УчетныйАктивЕПСАналитикаРасходовОтКорректировки);
