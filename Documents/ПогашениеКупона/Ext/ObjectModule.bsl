Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	// #414504 - пришел купон а бумаги по Т+ ушли
	Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_РЭМ")
		И НачалоДня(Дата) = '20220110' Тогда
	
		Возврат; // не делаем проводок
	
	КонецЕсли;

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
		
	//это,конечно, костыль. НО! тут нужно продумать-продумать
	//с одной стороны, нужно будет брать движение по БухПартииЦенныхБумагКупленныеПоРЕПО
	//но вот в этой самой ситуации, когда это делается купон как раз с БухПартииЦенныхБумагКупленныеПоРЕПО не уходил!
	//и как тут быть непонятно пока
	
	// КоличествоПоРЕПО считаем в любом случае, в Движения даем заполнять только если не стоит настройка ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты
	КоличествоПоРЕПО = Документы.ПогашениеКупона.ПроводкиПоКупленнымПоРЕПОЕПС(ЭтотОбъект.Ссылка, ?(НастройкиУчета.ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты, Неопределено, Движения.ЕдиныйБухгалтерскийУчет));
	
	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(
															ЭтотОбъект.Дата,
															ЭтотОбъект.Организация,
															ЭтотОбъект.СчетДоверительногоУправления,
															"ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
	
		ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, КоличествоПоРЕПО, Отказ);
		Возврат;
	
	КонецЕсли;
	
	// #Технический долг - нужно это правильно сделать
	ЭтоБанкрот = Ложь;
	Если ЭтотОбъект.Облигация.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм")	И ЭтотОбъект.Дата >= '20190913' Тогда
		ЭтоБанкрот = Истина;
	КонецЕсли;
	
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.КорректировкаЭСП = 0
		|				И БухПартииЦенныхБумаг.ДисконтПремияНачисленный = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияПокупкиОстаток < 0 КАК Дисконт
		|ПОМЕСТИТЬ _ОстаткиПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДоДокумента,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправленияДляУчета
		|				И Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И (ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии) В
		|					(ВЫБРАТЬ
		|						_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|						_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|						_ДвиженияПартий.Партия КАК Партия,
		|						_ДвиженияПартий.СтрокаПартии КАК СтрокаПартии
		|					ИЗ
		|						_ДвиженияПартий КАК _ДвиженияПартий)) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ОстаткиПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(_ОстаткиПартий.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
		|	СУММА(_ОстаткиПартий.КорректировкаЭСПОстаток) КАК КорректировкаЭСПОстаток,
		|	СУММА(_ОстаткиПартий.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(_ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	СУММА(_ОстаткиПартий.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(_ОстаткиПартий.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток
		|ПОМЕСТИТЬ _ОстаткиПартийСГруппировкойПоБумагеИАктиву
		|ИЗ
		|	_ОстаткиПартий КАК _ОстаткиПартий
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиПартий.ЦеннаяБумага,
		|	_ОстаткиПартий.УчетныйАктивЕПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартий.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДвиженияПартий.Перекурсовка КАК Перекурсовка,
		|	_ОстаткиПартий.Дисконт КАК Дисконт,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
		|	СУММА(_ДвиженияПартий.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	СУММА(_ОстаткиПартийСГруппировкойПоБумагеИАктиву.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
		|	СУММА(_ОстаткиПартийСГруппировкойПоБумагеИАктиву.КорректировкаЭСПОстаток) КАК КорректировкаЭСПОстаток,
		|	СУММА(_ОстаткиПартий.ДисконтПремияНачисленныйОстаток) КАК ДисконтПремияНачисленныйОстаток,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(_ДвиженияПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(_ОстаткиПартийСГруппировкойПоБумагеИАктиву.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток,
		|	СУММА(_ДвиженияПартий.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(_ДвиженияПартий.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(_ДвиженияПартий.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(_ОстаткиПартийСГруппировкойПоБумагеИАктиву.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(_ОстаткиПартийСГруппировкойПоБумагеИАктиву.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток
		|ИЗ
		|	_ДвиженияПартий КАК _ДвиженияПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартийСГруппировкойПоБумагеИАктиву КАК _ОстаткиПартийСГруппировкойПоБумагеИАктиву
		|		ПО _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартийСГруппировкойПоБумагеИАктиву.УчетныйАктивЕПС
		|			И _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартийСГруппировкойПоБумагеИАктиву.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
		|		ПО _ДвиженияПартий.УчетныйАктивЕПС = _ОстаткиПартий.УчетныйАктивЕПС
		|			И _ДвиженияПартий.ЦеннаяБумага = _ОстаткиПартий.ЦеннаяБумага
		|			И _ДвиженияПартий.Партия = _ОстаткиПартий.Партия
		|			И _ДвиженияПартий.СтрокаПартии = _ОстаткиПартий.СтрокаПартии
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияПартий.УчетныйАктивЕПС,
		|	_ДвиженияПартий.ЦеннаяБумага,
		|	_ДвиженияПартий.Перекурсовка,
		|	_ОстаткиПартий.Дисконт";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("ДоДокумента",    Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",    ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",    ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправленияДляУчета", Справочники.СчетаДоверительногоУправления.ПолучитьСчетДляУчета(ЭтотОбъект.СчетДоверительногоУправления));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
	БухПартииЦенныхБумаг = РезультатЗапроса.Выгрузить();
	ВалютаНоминала = Облигация.ВалютаНоминала;
	
	МассивУчетныхАктивов = Новый Массив;
	
	Для Каждого СтрокаПартии Из БухПартииЦенныхБумаг Цикл
		УчетныйАктив = СтрокаПартии.УчетныйАктивЕПС;
		
		Если МассивУчетныхАктивов.Найти(УчетныйАктив) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(УчетныйАктив);
		КонецЕсли;
		
		Если СтрокаПартии.Перекурсовка Тогда
			
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
				+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, "
				+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
				СтрокаПартии.ЦеннаяБумага, УчетныйАктив,
				СтрокаПартии.СтоимостьВВалютеУчета, СтрокаПартии.СтоимостьКупонаВВалютеУчета, СтрокаПартии.ПереоценкаВВалютеУчета, СтрокаПартии.ПереоценкаКупонаВВалютеУчета,
				СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.КорректировкаЭСПВВалютеУчета, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
				?(СтрокаПартии.Дисконт, -1, 1),СтрокаПартии.ПереоценкаОстаток,СтрокаПартии.КорректировкаЭСПОстаток,СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток);
				
			БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);	
			
		Иначе
		
			// Дооцениваем купон
			Если СтрокаПартии.ПереоценкаКупона<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Аналитика",
					СтрокаПартии.ПереоценкаКупонаВВалютеУчета, СтрокаПартии.ПереоценкаКупона, ВалютаУчета, УчетныйАктив, Облигация, ВалютаНоминала, АналитикаКупонНачисленный);
				БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			//дооценки перед расходом купона, дисконта и т.п.
			Если СтрокаПартии.ДисконтПремияНачисленный<>0 Тогда
				ПараметрыНачисления = Новый Структура("СуммаУчета, СуммаВал, ВалютаУчета, УчетныйАктив, ЦеннаяБумага, ВалютаНоминала",
					СтрокаПартии.ДисконтПремияНачисленныйВВалютеУчета, СтрокаПартии.ДисконтПремияНачисленный, ВалютаУчета, УчетныйАктив, Облигация, ВалютаНоминала);
				ПараметрыНачисления.Вставить("Аналитика", ?(СтрокаПартии.ДисконтПремияНачисленный<0, АналитикаПремии, АналитикаДисконта));
				БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
			КонецЕсли;
			
			Если СтрокаПартии.КорректировкаЭСП<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"КорректировкаЭСП", СтрокаПартии.КорректировкаЭСП, СтрокаПартии.КорректировкаЭСПВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, Облигация, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
				
			КонецЕсли;
			
			Если СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные<>0 Тогда
				ПараметрыСписания = Новый Структура("Показатель, СуммаВал, СуммаУчета, ВалютаУчета,	УчетныйАктив, ЦеннаяБумага, ВалютаНоминала, Сделка",
					"РазницаПервоначальногоПризнания", СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, СтрокаПартии.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,ЭтотОбъект.Организация.ВалютаУчета,  УчетныйАктив, Облигация, ВалютаНоминала, Неопределено);
				БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыСписания, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Ложь, Истина, ЭтотОбъект.Облигация, Отказ);
	
	//читаем движения погашений

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС
		|ИТОГИ ПО
		|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИтоги = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаИтоги.Следующий() Тогда
	
		Если Облигация.ВалютаНоминала = ЭтотОбъект.Организация.ВалютаУчета Тогда // рублевые облигации
		
			СуммаКупонаНаОднуОблигацию = ЭтотОбъект.СуммаНаОднуОблигацию;
			
		Иначе // а вот эта затыка сделана для валютных облигаций, которые гасятся в рублях и сумму в валюте номинила только в регистре можно узнать
			
			СуммаКупонаНаОднуОблигацию = ОпределитьСуммуКупонаВВалютеНоминала();
		
		КонецЕсли;
		
		БазаКупонаКРаспределению = ВыборкаИтоги.СтоимостьКупона + ВыборкаИтоги.ПереоценкаКупона;
		ЗадолженностьКРаспределению = (ЭтотОбъект.Количество - КоличествоПоРЕПО) * СуммаКупонаНаОднуОблигацию;
		Если ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета Тогда
			ЗадолженностьКРаспределениюВВалютеУчета = (ЭтотОбъект.Количество - КоличествоПоРЕПО) * ЭтотОбъект.СуммаНаОднуОблигацию;
		Иначе
			ЗадолженностьКРаспределениюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЗадолженностьКРаспределению, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ);
		КонецЕсли;
		
		Если ЭтоБанкрот Тогда
			Если БазаКупонаКРаспределению = 0 Тогда // купона уже нет и ничего делать не нужно, вообще ничего
				Возврат; 
			КонецЕсли;
			ЗадолженностьКРаспределению = БазаКупонаКРаспределению;
			Если ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета Тогда
				ЗадолженностьКРаспределениюВВалютеУчета = ЗадолженностьКРаспределению;
			Иначе
				ЗадолженностьКРаспределениюВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЗадолженностьКРаспределению, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаИтоги.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
			УчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
			
			СтоимостьКупона = ВыборкаДетальныеЗаписи.СтоимостьКупона;
			ПереоценкаКупона = ВыборкаДетальныеЗаписи.ПереоценкаКупона;
			
			//сумму задолженности разделим пропорционально. Допускаем, что одна бумага на разный видах актива висеть не может
			КоэффициентРаспределения = СтоимостьКупона / БазаКупонаКРаспределению;
			ЗадолженностьПоСтоимостиКупона = Окр(ЗадолженностьКРаспределению * КоэффициентРаспределения, 2);
			ЗадолженностьПоСтоимостиКупонаВВалютеУчета = Окр(ЗадолженностьКРаспределениюВВалютеУчета * КоэффициентРаспределения, 2);
			КурсоваяРазницаСтоимостиКупона = ЗадолженностьПоСтоимостиКупонаВВалютеУчета - ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета;
			
			БазаКупонаКРаспределению = БазаКупонаКРаспределению - СтоимостьКупона;
			ЗадолженностьКРаспределению = ЗадолженностьКРаспределению - ЗадолженностьПоСтоимостиКупона;
			ЗадолженностьКРаспределениюВВалютеУчета = ЗадолженностьКРаспределениюВВалютеУчета - ЗадолженностьПоСтоимостиКупонаВВалютеУчета;
			
			//конец распределения задолженности
			
			
			Облигация = ЭтотОбъект.Облигация;
			
			ВалютаНоминала = Облигация.ВалютаНоминала;
			
			Контрагент = Облигация.Эмитент.ЮрФизЛицо;
		
			// ***** купон *****
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ЗадолженностьПоСтоимостиКупонаВВалютеУчета, "Погашение купона");
			
			// дебет
			Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
				
				Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
				
				Проводка.ВалютаДт = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаДт = ЗадолженностьПоСтоимостиКупона;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			Иначе
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты = Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;
				
				Проводка.ВалютаДт  = ЭтотОбъект.ВалютаОплаты;
				Проводка.ВалютнаяСуммаДт = ЗадолженностьПоСтоимостиКупона;
							
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
			КонецЕсли;
			
			Если ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета Тогда
				Проводка.ВалютнаяСуммаДт = ЗадолженностьПоСтоимостиКупонаВВалютеУчета;	
			КонецЕсли;
			
			
			// кредит
			Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
			
			Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
			
			Проводка.ВалютаКт = ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = ЗадолженностьПоСтоимостиКупона;
			
			Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
			
				
			// ***** переоценка купона *****
			Если БазаКупонаКРаспределению = 0 Тогда
				
				КурсоваяРазницаПереоценкиКупона = 0;
				
			Иначе
				
				КоэффициентРаспределения = ПереоценкаКупона / БазаКупонаКРаспределению;
				ЗадолженностьПоПереоценкеКупона = Окр(ЗадолженностьКРаспределению * КоэффициентРаспределения, 2);
				ЗадолженностьПоПереоценкеКупонаВВалютеУчета = Окр(ЗадолженностьКРаспределениюВВалютеУчета * КоэффициентРаспределения, 2);
				КурсоваяРазницаПереоценкиКупона = ЗадолженностьПоПереоценкеКупонаВВалютеУчета - ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета;
				
				БазаКупонаКРаспределению = БазаКупонаКРаспределению - ПереоценкаКупона;
				ЗадолженностьКРаспределению = ЗадолженностьКРаспределению - ЗадолженностьПоПереоценкеКупона;
				ЗадолженностьКРаспределениюВВалютеУчета = ЗадолженностьКРаспределениюВВалютеУчета - ЗадолженностьПоПереоценкеКупонаВВалютеУчета;
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ЗадолженностьПоПереоценкеКупонаВВалютеУчета, "Погашение купона");
				
				// дебет
				Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
					
					Проводка.СчетДт = УчетныйАктив.СчетУчетаКупона;
					
					Проводка.СубконтоДт.ЦенныеБумаги = Облигация;
					
					Проводка.ВалютаДт = ЭтотОбъект.ВалютаОплаты;
					Проводка.ВалютнаяСуммаДт = ЗадолженностьПоПереоценкеКупона;
					
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				Иначе
					
					Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
					
					Проводка.СубконтоДт.Контрагенты = Контрагент;
					Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;			
					
					Проводка.ВалютаДт  = ЭтотОбъект.ВалютаОплаты;
					Проводка.ВалютнаяСуммаДт = ЗадолженностьПоПереоценкеКупона;
								
					Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
					
				КонецЕсли;

				Если ЭтотОбъект.ВалютаОплаты = ЭтотОбъект.Организация.ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаДт = ЗадолженностьПоПереоценкеКупонаВВалютеУчета;	
				КонецЕсли;
				
				// кредит
				Проводка.СчетКт = УчетныйАктив.СчетУчетаКупона;
				
				Проводка.СубконтоКт.ЦенныеБумаги = Облигация;
				
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = ЗадолженностьПоПереоценкеКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
				
			КонецЕсли;
			
			Если КурсоваяРазницаСтоимостиКупона <> 0 ИЛИ КурсоваяРазницаПереоценкиКупона <> 0 Тогда
				ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, УчетныйАктивЕПС, "
					+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета, "
					+ "ДисконтПремияНачисленныйВВалютеУчета, КорректировкаЭСПВВалютеУчета, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,"
					+ "ДисконтПремияНачисленныйОстаток, ПереоценкаОстаток, КорректировкаЭСПОстаток, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеОстаток",
					ЭтотОбъект.Облигация, УчетныйАктив,
					0, КурсоваяРазницаСтоимостиКупона, 0, КурсоваяРазницаПереоценкиКупона,
					0, 0, 0,
					0,0,0,0);
				
				БухгалтерскийУчетЕПС.ДвижениеПерекурсовки(ЭтотОбъект, ПараметрыПерекурсовки, Отказ);	
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	// глава Г
	Если НастройкиУчета.ДействияПриПогашенииКупонаНаСчетахГлавыГ <> "НеНачислять_И_НеСписывать" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.Партия КАК Партия,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупона КАК ПереоценкаКупона,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения КАК ВидДвижения,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупона КАК СтоимостьКупона,
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО КАК БухПартииЦенныхБумагКупленныеПоРЕПО
			|ГДЕ
			|	БухПартииЦенныхБумагКупленныеПоРЕПО.Регистратор = &Регистратор
			|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|	И БухПартииЦенныхБумагКупленныеПоРЕПО.ВидДвижения В(&ВидыДвижений)
			|	И БухПартииЦенныхБумагКупленныеПоРЕПО.Активность";
		
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		
		ВидыДвижений = Новый Массив();
		ВидыДвижений.Добавить(ВидДвиженияНакопления.Приход);
		Если НастройкиУчета.ДействияПриПогашенииКупонаНаСчетахГлавыГ = "Начислять_И_СписыватьПриПогашенииКупона" Тогда // при погашении еще и списываем
			ВидыДвижений.Добавить(ВидДвиженияНакопления.Расход);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ВидыДвижений", ВидыДвижений);
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			    // начисляем ННКД
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета, "Переоценка/доначисление купона по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Партия;
				
				Проводка.ВалютаКт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.ПереоценкаКупона;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
				
			Иначе
				// списываем УНКД
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета, "Погашение купона по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Партия;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.СтоимостьКупона;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаКупонПриобретенный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонПриобретенный;
				
				// списываем ННКД
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.ПереоценкаКупонаВВалютеУчета, "Погашение купона по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ЦенныеБумагиПоРЕПО;
				
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Партия;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ПереоценкаКупона;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаКупонНачисленный;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.КорреспонденцияСПассивом8;
				Проводка.ДополнительнаяАналитикаКт = АналитикаКупонНачисленный;
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	БухгалтерскийУчетЕПС.ПереоценитьВалютныеАктивы(ЭтотОбъект, Отказ);
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
КонецПроцедуры
 	
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	// Получение списка проводок вынесено в модуль менеджера
	НаборПроводок = Документы.ПогашениеКупона.ПодготовитьНаборПроводок(
		ЭтотОбъект.Ссылка, 
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		,
		УчетныйРегистр, 
		Отказ, Истина);
				
	Если Отказ ИЛИ НаборПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗПроводок = НаборПроводок.Выгрузить();
	ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Ссылка, "Регистратор");
	Движения[УчетныйРегистр].Загрузить(ТЗПроводок);  
		
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

