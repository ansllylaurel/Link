
Процедура ПроверкаДатыДокументаНаСоответствиеГрафикуНачисленияПроцентов(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.Период
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &Период";

	Запрос.УстановитьПараметр("Период", 	НачалоДня(Дата));
	Запрос.УстановитьПараметр("Облигация", 	Облигация);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В графике погашения купонов нет записи на " + Формат(Дата, "ДФ=dd.MM.yyyy") + "'"), ЭтотОбъект, "Дата",, Отказ);			
	КонецЕсли;
	
КонецПроцедуры // ПроверкаДатыДокументаНаСоответствиеГрафикуНачисленияПроцентов

Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагам");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        Перечисления.РынкиЦенныхБумаг.Облигации);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",                 ЭтотОбъект.Облигация);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        Перечисления.РынкиЦенныхБумаг.Облигации);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",                 ЭтотОбъект.Облигация);
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",                        Перечисления.РынкиЦенныхБумаг.Облигации);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",                 ЭтотОбъект.Облигация);
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать         = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер.ЮрФизЛицо
		|		ИНАЧЕ _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	0 КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _КоличествоРЕПО
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.Основание
		|			И (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|ГДЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Основание,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КоличествоРЕПО.Основание,
		|	_КоличествоРЕПО.Контрагент,
		|	_КоличествоРЕПО.КоличествоОстаток,
		|	_КоличествоРЕПО.КоличествоВРЕПО,
		|	_КоличествоРЕПО.КоличествоПоРЕПО
		|ИЗ
		|	_КоличествоРЕПО КАК _КоличествоРЕПО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КоличествоРЕПО.Контрагент,
		|	СУММА(_КоличествоРЕПО.КоличествоПоРЕПО) КАК КоличествоПоРЕПО
		|ИЗ
		|	_КоличествоРЕПО КАК _КоличествоРЕПО
		|
		|СГРУППИРОВАТЬ ПО
		|	_КоличествоРЕПО.Контрагент
		|
		|ИМЕЮЩИЕ
		|	СУММА(_КоличествоРЕПО.КоличествоПоРЕПО) > 0";
		
	Запрос.УстановитьПараметр("Основание"					, ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Рынок"						, Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("ЦеннаяБумага"				, ЭтотОбъект.Облигация);
	Запрос.УстановитьПараметр("ДатаФиксации"				, ?(ЭтотОбъект.ДатаФиксации = НачалоДня(ЭтотОбъект.Дата), НачалоДня(ЭтотОбъект.ДатаФиксации), КонецДня(ЭтотОбъект.ДатаФиксации)));
	Запрос.УстановитьПараметр("НКЦпоРЕПОсЦК"				, Документы.ПогашениеКупона.НКЦпоРЕПОсЦК(ЭтотОбъект.Дата));
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ОстаткиЦенныхБумаг = ПакетЗапросов[2].Выгрузить();
	РепоПоКонтрагентам = ПакетЗапросов[3].Выгрузить();
	
	//контроль остатков ценных бумаг
	Если ЭтотОбъект.Количество < ОстаткиЦенныхБумаг.Итог("КоличествоОстаток") + ОстаткиЦенныхБумаг.Итог("КоличествоВРЕПО") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество облигаций в документе меньше чем требуется: остаток (в т.ч. купленных по РЕПО) - "  + 
															Строка(ОстаткиЦенныхБумаг.Итог("КоличествоОстаток")) + " (" + Строка(ОстаткиЦенныхБумаг.Итог("КоличествоПОРЕПО")) + 
															"), проданно в РЕПО - " + Строка(ОстаткиЦенныхБумаг.Итог("КоличествоВРЕПО")),,,, Отказ);
		Возврат;
	КонецЕсли;

	// задолженность по д/с
	Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.Основание                    = ЭтотОбъект.Ссылка;
	Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
	Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоПогашениюКупона;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Контрагент                   = ЭтотОбъект.Облигация.Эмитент.ЮрФизЛицо;
	Движение.Валюта                       = ЭтотОбъект.ВалютаОплаты;
	Движение.СуммаКупона                  = ЭтотОбъект.Количество * ЭтотОбъект.СуммаНаОднуОблигацию;
	
	СуммаВРЕПО = 0;
	
	Если ОстаткиЦенныхБумаг.Итог("КоличествоВРЕПО") > 0 Тогда
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
		
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Основание                    = ЭтотОбъект.Ссылка;
		Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
		Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоПогашениюКупона;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Контрагент                   = ЭтотОбъект.Облигация.Эмитент.ЮрФизЛицо;
		Движение.Валюта                       = ЭтотОбъект.ВалютаОплаты;
		Движение.СуммаКупона                  = ОстаткиЦенныхБумаг.Итог("КоличествоВРЕПО") * ЭтотОбъект.СуммаНаОднуОблигацию;
		
		СуммаВРЕПО = Движение.СуммаКупона;
		
	КонецЕсли;	
	
	Для Каждого СтрокаОстатков Из ОстаткиЦенныхБумаг Цикл
		Если СтрокаОстатков.КоличествоВРЕПО > 0 Тогда
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Основание                    = СтрокаОстатков.Основание;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Контрагент                   = СтрокаОстатков.Контрагент;
			Движение.Валюта                       = ЭтотОбъект.ВалютаОплаты;
			Движение.СуммаКупона                  = СтрокаОстатков.КоличествоВРЕПО * ЭтотОбъект.СуммаНаОднуОблигацию;
			
			СуммаВРЕПО = СуммаВРЕПО - Движение.СуммаКупона;
		КонецЕсли;
	КонецЦикла;	
	
	Движение.СуммаКупона = Движение.СуммаКупона + СуммаВРЕПО;
	
	
	Для Каждого СтрокаРепоПоКонтрагентам Из РепоПоКонтрагентам Цикл
		СуммаПоРепоПоКонтрагенту = СтрокаРепоПоКонтрагентам.КоличествоПоРЕПО * ЭтотОбъект.СуммаНаОднуОблигацию;
		
		ПараметрыПоиска = Новый Структура("Контрагент", СтрокаРепоПоКонтрагентам.Контрагент);
		НайденныеСтроки = ОстаткиЦенныхБумаг.НайтиСтроки(ПараметрыПоиска);
		
		Для Каждого СтрокаОстатков Из НайденныеСтроки Цикл
			Если СтрокаОстатков.КоличествоПоРЕПО > 0 Тогда
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Основание                    = СтрокаОстатков.Основание;
				Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.Контрагент                   = СтрокаОстатков.Контрагент;
				Движение.Валюта                       = ЭтотОбъект.ВалютаОплаты;
				Движение.СуммаКупона                  = СтрокаОстатков.КоличествоПоРЕПО * ЭтотОбъект.СуммаНаОднуОблигацию;
				
				СуммаПоРепоПоКонтрагенту = СуммаПоРепоПоКонтрагенту - Движение.СуммаКупона;
				
			КонецЕсли;

		КонецЦикла;
		
		Движение.СуммаКупона = Движение.СуммаКупона + СуммаПоРепоПоКонтрагенту;
		
	КонецЦикла;
	
	// операции с ц/б
	Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
	
	Движение.Операция                     = ЭтотОбъект.Ссылка;
	Движение.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Рынок                        = Перечисления.РынкиЦенныхБумаг.Облигации;
	Движение.ЦеннаяБумага                 = ЭтотОбъект.Облигация;
	Движение.Количество                   = ЭтотОбъект.Количество;
	Движение.СуммаКупона                  = ЭтотОбъект.Количество * ЭтотОбъект.СуммаНаОднуОблигацию;
	Движение.ДатаОперации                 = ЭтотОбъект.Дата;
	Движение.Валюта                       = ЭтотОбъект.ВалютаОплаты;

КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Функция ОпределитьСуммуКупонаВВалютеНоминала()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК СуммаКупона
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация
		|	И КупонныйДоходПоОблигациям.ДатаОкончанияКупона = &Период";

	Запрос.УстановитьПараметр("Период", 	НачалоДня(Дата));
	Запрос.УстановитьПараметр("Облигация", 	Облигация);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Возврат ВыборкаДетальныеЗаписи.СуммаКупона;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции 

Процедура СформироватьПроводкуСписанияКупонаЕПС(ОбъектДокумента, УчетныйРегистр, ПараметрыПроводки)

	Если ПараметрыПроводки.Сумма = 0 И ПараметрыПроводки.СуммаВВалютеУчета = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ОбъектДокумента, ОбъектДокумента.Движения[УчетныйРегистр], ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
	
	// дебет
	Если ПараметрыПроводки.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
		
		Проводка.СчетДт = ПараметрыПроводки.УчетныйАктив.СчетУчетаКупона;
		
		Проводка.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.Облигация;
		
		Проводка.ВалютаДт = ПараметрыПроводки.ВалютаОплаты;
		Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.СуммаОплаты;
		
		Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
		
	Иначе
		
		Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
		
		Проводка.СубконтоДт.Контрагенты = ПараметрыПроводки.Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов = ПараметрыПроводки.Ссылка;
		
		Проводка.ВалютаДт  = ПараметрыПроводки.ВалютаОплаты;
		Проводка.ВалютнаяСуммаДт = ПараметрыПроводки.СуммаОплаты;
					
		Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	КонецЕсли;
	
	// кредит
	Проводка.СчетКт = ПараметрыПроводки.УчетныйАктив.СчетУчетаКупона;
	
	Проводка.СубконтоКт.ЦенныеБумаги = ПараметрыПроводки.Облигация;
	
	Проводка.ВалютаКт = ПараметрыПроводки.ВалютаНоминала;
	Проводка.ВалютнаяСуммаКт = ПараметрыПроводки.Сумма;
	
	Проводка.ДополнительнаяАналитикаКт = ПараметрыПроводки.Аналитика;

	Проводка.Партия = ПараметрыПроводки.Партия;
	Проводка.СтрокаПартии = ПараметрыПроводки.СтрокаПартии;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, КоличествоПоРЕПО, Отказ)

	АналитикаТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта = Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Погашение.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Погашение.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	Погашение.Партия КАК Партия,
		|	Погашение.СтрокаПартии КАК СтрокаПартии,
		|	Погашение.СтоимостьКупона КАК СтоимостьКупонаПартииРасход,
		|	Погашение.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчетаПартииРасход,
		|	Погашение.ПереоценкаКупона КАК ПереоценкаКупонаПартииРасход,
		|	Погашение.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчетаПартииРасход,
		|	ЕСТЬNULL(ПереоценкаНачисление.ПереоценкаКупона, 0) КАК ПереоценкаКупонаПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.ПереоценкаКупонаВВалютеУчета, 0) КАК ПереоценкаКупонаВВалютеУчетаПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.ДисконтПремияНачисленный, 0) КАК ДисконтПремияНачисленныйПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.ДисконтПремияНачисленныйВВалютеУчета, 0) КАК ДисконтПремияНачисленныйВВалютеУчетаПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.КорректировкаЭСП, 0) КАК КорректировкаЭСППартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.КорректировкаЭСПВВалютеУчета, 0) КАК КорректировкаЭСПВВалютеУчетаПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные, 0) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеПартииПриход,
		|	ЕСТЬNULL(ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, 0) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаПартииПриход,
		|	ЕСТЬNULL(Перекурсовка.СтоимостьВВалютеУчета, 0) КАК СтоимостьПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.СтоимостьКупонаВВалютеУчета, 0) КАК СтоимостьКупонаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ПереоценкаВВалютеУчета, 0) КАК ПереоценкаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ПереоценкаКупонаВВалютеУчета, 0) КАК ПереоценкаКупонаПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.ДисконтПремияНачисленныйВВалютеУчета, 0) КАК ДисконтПремияНачисленныйПерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.КорректировкаЭСПВВалютеУчета, 0) КАК КорректировкаЭСППерекурсовка,
		|	ЕСТЬNULL(Перекурсовка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета, 0) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеПерекурсовка,
		|	Остатки.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупки,
		|	Остатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	Остатки.КорректировкаЭСПВВалютеУчетаОстаток КАК КорректировкаЭСПВВалютеУчетаОстаток,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	Остатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГодаОстаток,
		|	Остатки.РазницаПервоначальногоПризнанияСНачалаГодаОстаток КАК РазницаПервоначальногоПризнанияСНачалаГодаОстаток,
		|	Остатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчетаОстаток,
		|	Остатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток,
		|	Погашение.УчетныйАктивЕПС.СчетУчета КАК УчетныйАктивЕПССчетУчета,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаПереоценкиА КАК УчетныйАктивЕПССчетУчетаПереоценкиА,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаПереоценкиП КАК УчетныйАктивЕПССчетУчетаПереоценкиП,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций КАК УчетныйАктивЕПССчетУчетаДоходовОтОпераций,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций КАК УчетныйАктивЕПССчетУчетаРасходовОтОпераций,
		|	Погашение.УчетныйАктивЕПС.АналитикаДоходовОтОпераций КАК УчетныйАктивЕПСАналитикаДоходовОтОпераций,
		|	Погашение.УчетныйАктивЕПС.АналитикаРасходовОтОпераций КАК УчетныйАктивЕПСАналитикаРасходовОтОпераций,
		|	Погашение.УчетныйАктивЕПС.АналитикаПроцентныхДоходов КАК УчетныйАктивЕПСАналитикаПроцентныхДоходов,
		|	Погашение.УчетныйАктивЕПС.АналитикаСписанияПремии КАК УчетныйАктивЕПСАналитикаСписанияПремии,
		|	Погашение.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки КАК УчетныйАктивЕПСАналитикаДоходовОтПереоценки,
		|	Погашение.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки КАК УчетныйАктивЕПСАналитикаРасходовОтПереоценки,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаКорректировокА КАК УчетныйАктивЕПССчетУчетаКорректировокА,
		|	Погашение.УчетныйАктивЕПС.СчетУчетаКорректировокП КАК УчетныйАктивЕПССчетУчетаКорректировокП,
		|	Погашение.УчетныйАктивЕПС.АналитикаДоходовОтКорректировки КАК УчетныйАктивЕПСАналитикаДоходовОтКорректировки,
		|	Погашение.УчетныйАктивЕПС.АналитикаРасходовОтКорректировки КАК УчетныйАктивЕПСАналитикаРасходовОтКорректировки,
		|	Погашение.УчетныйАктивЕПС.АналитикаДоходовПервоначальногоПризнания КАК УчетныйАктивЕПСАналитикаДоходовПервоначальногоПризнания,
		|	Погашение.УчетныйАктивЕПС.АналитикаРасходовПервоначальногоПризнания КАК УчетныйАктивЕПСАналитикаРасходовПервоначальногоПризнания
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК Погашение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК ПереоценкаНачисление
		|		ПО Погашение.Регистратор = ПереоценкаНачисление.Регистратор
		|			И Погашение.ВидУчета = ПереоценкаНачисление.ВидУчета
		|			И Погашение.ЦеннаяБумага = ПереоценкаНачисление.ЦеннаяБумага
		|			И Погашение.Партия = ПереоценкаНачисление.Партия
		|			И Погашение.СтрокаПартии = ПереоценкаНачисление.СтрокаПартии
		|			И (ПереоценкаНачисление.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (ПереоценкаНачисление.ПереоценкаКупона <> 0
		|				ИЛИ ПереоценкаНачисление.ДисконтПремияНачисленный <> 0
		|				ИЛИ ПереоценкаНачисление.КорректировкаЭСП <> 0
		|				ИЛИ ПереоценкаНачисление.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные <> 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК Перекурсовка
		|		ПО Погашение.Регистратор = Перекурсовка.Регистратор
		|			И Погашение.ВидУчета = Перекурсовка.ВидУчета
		|			И Погашение.ЦеннаяБумага = Перекурсовка.ЦеннаяБумага
		|			И Погашение.Партия = Перекурсовка.Партия
		|			И Погашение.СтрокаПартии = Перекурсовка.СтрокаПартии
		|			И (Перекурсовка.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (Перекурсовка.ПереоценкаКупона = 0)
		|			И (Перекурсовка.ДисконтПремияНачисленный = 0)
		|			И (Перекурсовка.КорректировкаЭСП = 0)
		|			И (Перекурсовка.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные = 0)
		|			И (Перекурсовка.ЗадолженностьПоПогашениюКупона = 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага = &ЦеннаяБумага) КАК Остатки
		|		ПО Погашение.Партия = Остатки.Партия
		|			И Погашение.СтрокаПартии = Остатки.СтрокаПартии
		|ГДЕ
		|	Погашение.Регистратор = &Ссылка
		|	И Погашение.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И Погашение.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.Облигация);
	
	
	РаспределяемЗадолженность = Ложь;
	СуммаЗадолженности = 0;
	КоличествоЗадолженности = 0;
	
	Если ЭтотОбъект.ВалютаОплаты <> ЭтотОбъект.Облигация.ВалютаНоминала Тогда
		// тут рассматривается только ситуация рублевой оплаты по валютным облигациям
		// вероятность обратной ситуации пренебрежимо мала
		Если ЭтотОбъект.СуммаНаОднуОблигацию - Окр(ЭтотОбъект.СуммаНаОднуОблигацию, 2) <> 0 Тогда
			
			РаспределяемЗадолженность = Истина;
			КоличествоЗадолженности = ЭтотОбъект.Количество - КоличествоПоРЕПО;
			СуммаЗадолженности = ЭтотОбъект.СуммаНаОднуОблигацию * КоличествоЗадолженности;
		
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыНачисления = Новый Структура;
	
	ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
	
	ПараметрыНачисления.Вставить("ЦеннаяБумага",	ЭтотОбъект.Облигация);
	ПараметрыНачисления.Вставить("ВалютаНоминала",	ЭтотОбъект.Облигация.ВалютаНоминала);
	
	ПараметрыСписания = Новый Структура;
	ПараметрыСписания.Вставить("Облигация",			ЭтотОбъект.Облигация);
	ПараметрыСписания.Вставить("Контрагент",		ЭтотОбъект.Облигация.Эмитент.ЮрФизЛицо);
	ПараметрыСписания.Вставить("Ссылка",			ЭтотОбъект.Ссылка);
	ПараметрыСписания.Вставить("ВалютаОплаты",		ЭтотОбъект.ВалютаОплаты);
	ПараметрыСписания.Вставить("ВалютаНоминала",	ЭтотОбъект.Облигация.ВалютаНоминала);
	ПараметрыСписания.Вставить("ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов",			НастройкиУчета.ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если РаспределяемЗадолженность Тогда
		
			СуммаЗадолженностиПоПартии = Окр(СуммаЗадолженности / КоличествоЗадолженности * ВыборкаДетальныеЗаписи.КоличествоОстаток, 2);
			
			СуммаЗадолженности = СуммаЗадолженности - СуммаЗадолженностиПоПартии;
			КоличествоЗадолженности = КоличествоЗадолженности - ВыборкаДетальныеЗаписи.КоличествоОстаток;
			
		Иначе
			
			СуммаЗадолженности = ЭтотОбъект.СуммаНаОднуОблигацию * ВыборкаДетальныеЗаписи.КоличествоОстаток;
		
		КонецЕсли;
		
		ОбщаяСумма = ВыборкаДетальныеЗаписи.СтоимостьКупонаПартииРасход + ВыборкаДетальныеЗаписи.ПереоценкаКупонаПартииРасход;
		
		СуммаЗадолженностиУНКД = Окр(СуммаЗадолженности / ОбщаяСумма * ВыборкаДетальныеЗаписи.СтоимостьКупонаПартииРасход, 2);
		СуммаЗадолженностиННКД = СуммаЗадолженности - СуммаЗадолженностиУНКД;
		
