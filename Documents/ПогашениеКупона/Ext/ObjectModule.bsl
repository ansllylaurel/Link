		ПараметрыНачисления.Вставить("Сумма",				ВыборкаДетальныеЗаписи.КорректировкаЭСППартииПриход);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчетаПартииПриход);
		ПараметрыНачисления.Вставить("СуммаСНачалаГода",	ВыборкаДетальныеЗаписи.КорректировкаЭСПСНачалаГодаОстаток + ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчетаПартииПриход);
