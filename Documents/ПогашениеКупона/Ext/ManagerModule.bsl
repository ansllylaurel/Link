		|ПОМЕСТИТЬ _КоличествоРЕПОСГруппировкой
		|ИЗ
		|	_КоличествоРЕПО КАК _КоличествоРЕПО
		|
		|СГРУППИРОВАТЬ ПО
		|	_КоличествоРЕПО.Контрагент,
		|	_КоличествоРЕПО.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала) КАК ИндексацияНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала <> 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДвижениеИндексацииНоминала,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО) = ТИП(Документ.СделкаРЕПО)
		|			ТОГДА ВЫБОР
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Контрагент
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Брокер.ЮрФизЛицо
		|					ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Контрагент
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|			ТОГДА ВЫБОР
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Брокер.ЮрФизЛицо
		|					ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Контрагент
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО КАК Документ.ПоставкаЦенныхБумаг).Основание
		|		ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО
		|	КОНЕЦ КАК ПродажаРЕПО
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо КАК БухПартииЦенныхБумагПроданныеВРепо
		|ГДЕ
		|	БухПартииЦенныхБумагПроданныеВРепо.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумагПроданныеВРепо.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала <> 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО) = ТИП(Документ.СделкаРЕПО)
		|			ТОГДА ВЫБОР
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Контрагент
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Брокер.ЮрФизЛицо
		|					ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Контрагент
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|			ТОГДА ВЫБОР
		|					КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|						ТОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Брокер.ЮрФизЛицо
		|					ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО.Основание.Контрагент
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ИндексацияНоминала = 0
		|				И БухПартииЦенныхБумагПроданныеВРепо.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО КАК Документ.ПоставкаЦенныхБумаг).Основание
		|		ИНАЧЕ БухПартииЦенныхБумагПроданныеВРепо.ПродажаРЕПО
		|	КОНЕЦ";
			
	Запрос.УстановитьПараметр("Регистратор"					, ДокументСсылка);
	Запрос.УстановитьПараметр("ВидУчета"					, Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Приход",    	 ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("ВидУчетаНУ",  Перечисления.ВидыУчета[УчетныйРегистр] = Перечисления.ВидыУчета.НалоговыйУчет);
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументСсылка.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Основание"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"					, ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("Рынок"						, Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("ЦеннаяБумага"				, ДокументСсылка.Облигация);
	Запрос.УстановитьПараметр("ДатаФиксации"				, ?(ДокументСсылка.ДатаФиксации = НачалоДня(ДокументСсылка.Дата), НачалоДня(ДокументСсылка.ДатаФиксации), КонецДня(ДокументСсылка.ДатаФиксации)));
	Запрос.УстановитьПараметр("НКЦпоРЕПОсЦК"				, НКЦпоРЕПОсЦК(ДокументСсылка.Дата));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", УчетныйРегистр);
	
	//ловим погрешность округления
	ОбщееКоличество = ДокументСсылка.Количество;
	ОбщаяСуммаКРаспределению = ДокументСсылка.СуммаКупона;
	ОбщееКоличествоПоРЕПО = 0;
	ОбщаяСуммаПоРЕПО = 0;
	ОбщееКоличествоВРЕПО = 0;
	ОбщаяСуммаВРЕПО = 0;
	
	СтруктураОбъекта = Новый Структура("Ссылка, Дата, Движения", ДокументСсылка, ДокументСсылка.Дата, Движения); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаЗначенийПрямоеРЕПО = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияПартий"].ПолучитьДанные().Выгрузить();
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_КоличествоРЕПОСГруппировкой"].ПолучитьДанные().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КоличествоПоРЕПО) Тогда
		
			КоличествоПоРЕПО = Выборка.КоличествоПоРЕПО;
			СуммаПоРЕПО = Окр(ОбщаяСуммаКРаспределению / ОбщееКоличество * КоличествоПоРЕПО, 2);
			
			ОбщаяСуммаКРаспределению = ОбщаяСуммаКРаспределению - СуммаПоРЕПО;
			ОбщееКоличество = ОбщееКоличество - КоличествоПоРЕПО;
			ОбщаяСуммаПоРЕПО = ОбщаяСуммаПоРЕПО + СуммаПоРЕПО;
			ОбщееКоличествоПоРЕПО = ОбщееКоличествоПоРЕПО + КоличествоПоРЕПО;
			
			Если ФормироватьПроводкиОбратногоРЕПО Тогда 
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаПоРЕПО, ДокументСсылка.ВалютаОплаты, ДокументСсылка.Организация, ДокументСсылка.Дата, Отказ), "Погашение купона по ЦБ, купленым по РЕПО");
				
				// дебет
				Проводка.СчетДт = СчетПогашениеКупона;
				Проводка.СубконтоДт.Облигации = ДокументСсылка.Облигация;
				
				Если СчетПогашениеКупона.Валютный Тогда
					Проводка.ВалютнаяСуммаДт = СуммаПоРЕПО;
					Проводка.ВалютаДт = ДокументСсылка.ВалютаОплаты;
				КонецЕсли;
				
				Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
					Проводка.СубконтоДт.ОснованиеРасчетов = ДокументСсылка;
				КонецЕсли;			
				
				// кредит
				Если ВалютаОплаты <> ВалютаУчета Тогда
					
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
					
					Проводка.ВалютнаяСуммаКт = СуммаПоРЕПО;
					Проводка.ВалютаКт = ДокументСсылка.ВалютаОплаты;
					
				Иначе
					
					Проводка.СчетКт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
					
				КонецЕсли;
				
				Проводка.СубконтоКт.Контрагенты 		= Выборка.Контрагент;
				
			КонецЕсли;	
			
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Выборка.КоличествоВРЕПО) Тогда
			
			//СтрокиВРЕПО =ТаблицаЗначенийПрямоеРЕПО.НайтиСтроки(Новый Структура("Контрагент", Выборка.Контрагент));
			СтрокиВРЕПО =ТаблицаЗначенийПрямоеРЕПО.НайтиСтроки(Новый Структура("Контрагент, ПродажаРЕПО", Выборка.Контрагент, Выборка.Основание));
			КоличествоВРЕПО = 0;
			
			Для каждого СтрокаВРЕПО из СтрокиВРЕПО Цикл
				Если СтрокаВРЕПО.Перекурсовка  Тогда
					
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не сформированы проводки перекурсовки для проданных в РЕПО партий", ДокументСсылка,,,Отказ);
					//Прервать;
					
					ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
						+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
						ДокументСсылка.Облигация, Перечисления.РынкиЦенныхБумаг.Облигации,
						СтрокаВРЕПО.СтоимостьВВалютеУчета, СтрокаВРЕПО.СтоимостьКупонаВВалютеУчета, СтрокаВРЕПО.ПереоценкаВВалютеУчета, СтрокаВРЕПО.ПереоценкаКупонаВВалютеУчета);
						
					СчетаУчета = Новый Структура;
					СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаВЗалоге);
					СчетаУчета.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаОблигация.СчетУчетаВЗалоге);
					
					СчетаУчетаПереоценки = Новый Структура;
					СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге);
					СчетаУчетаПереоценки.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаОблигация.СчетУчетаПереоценкиВЗалоге);
					
					АналитикаПерекурсовки = Новый Структура;
					АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
					АналитикаПерекурсовки.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаОблигация.АналитикаПерекурсовки);
					
					БухгалтерскийУчет.ДвижениеПерекурсовки(СтруктураОбъекта, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
					
				ИначеЕсли СтрокаВРЕПО.ДвижениеИндексацииНоминала  Тогда
					
					ДооценкаИндексацииНоминала	 = СтрокаВРЕПО.ИндексацияНоминала;
					
				Иначе	
					КоличествоВРЕПО = Выборка.КоличествоВРЕПО;
					СуммаВРЕПО = Окр(КоличествоВРЕПО * ДокументСсылка.СуммаНаОднуОблигацию, 2);
					
					ОбщаяСуммаКРаспределению = ОбщаяСуммаКРаспределению - СуммаВРЕПО;
					ОбщееКоличество = ОбщееКоличество - КоличествоВРЕПО;
					ОбщаяСуммаВРЕПО = ОбщаяСуммаВРЕПО + СуммаВРЕПО;
					ОбщееКоличествоВРЕПО = ОбщееКоличествоВРЕПО + КоличествоВРЕПО;
					
					Если ФормироватьПроводки Тогда						
						ПараметрыПогашенияКупона = Новый Структура("Облигация, ВЗалоге, КонтрагентЗалога, Дата, ОбращаетсяНаОРЦБ, СуммаКупона, СтоимостьКупона, СтоимостьКупонаВВалютеУчета, ПереоценкаКупона, ПереоценкаКупонаВВалютеУчета, 
							|ВалютаОплаты, ВалютаУчета, ВалютаНоминала, СчетПогашениеКупона, ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона, СделкаРЕПО", 
							ДокументСсылка.Облигация, Истина, Выборка.Контрагент, ДокументСсылка.Дата, ОбращаетсяНаОРЦБ, СуммаВРЕПО, 
							СтрокаВРЕПО.СтоимостьКупона, СтрокаВРЕПО.СтоимостьКупонаВВалютеУчета, СтрокаВРЕПО.ПереоценкаКупона, СтрокаВРЕПО.ПереоценкаКупонаВВалютеУчета, 
							ВалютаОплаты, ВалютаУчета, ВалютаНоминала, СчетПогашениеКупона, ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона, СтрокаВРЕПО.ПродажаРЕПО);
						ОтразитьПогашениеКупонаПроводки(ДокументСсылка, Движения, УчетныйРегистр, НастройкиУчетаАктива, ПараметрыПогашенияКупона, Отказ);						
					КонецЕсли;
				
					ТаблицаЗначенийПрямоеРЕПО.Удалить(СтрокаВРЕПО);
					
				КонецЕсли;
				
			КонецЦикла;
						
			Если КоличествоВРЕПО = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены проданные в РЕПО партии для контрагента " + Выборка.Контрагент, ДокументСсылка,,,Отказ);
				Прервать;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("КоличествоПоРЕПО, СуммаПоРЕПО, КоличествоВРЕПО, СуммаВРЕПО", ОбщееКоличествоПоРЕПО, ОбщаяСуммаПоРЕПО, ОбщееКоличествоВРЕПО, ОбщаяСуммаВРЕПО);

КонецФункции

Процедура ОтразитьПогашениеКупонаПроводки(ДокументСсылка, Движения, УчетныйРегистр, НастройкиУчетаАктива, ПараметрыПогашенияКупона, Отказ)
	
	Облигация 						= ПараметрыПогашенияКупона.Облигация;
	ВЗалоге 						= ПараметрыПогашенияКупона.ВЗалоге;
	ОбращаетсяНаОРЦБ				= ПараметрыПогашенияКупона.ОбращаетсяНаОРЦБ;
	ВалютаОплаты 					= ПараметрыПогашенияКупона.ВалютаОплаты;
	ВалютаУчета 					= ПараметрыПогашенияКупона.ВалютаУчета;
	ВалютаНоминала 					= ПараметрыПогашенияКупона.ВалютаНоминала;
	Дата 							= ПараметрыПогашенияКупона.Дата;
	СуммаКупона 					= ПараметрыПогашенияКупона.СуммаКупона;
	СтоимостьКупона 				= ПараметрыПогашенияКупона.СтоимостьКупона;
	СтоимостьКупонаВВалютеУчета 	= ПараметрыПогашенияКупона.СтоимостьКупонаВВалютеУчета;
	ПереоценкаКупона 				= ПараметрыПогашенияКупона.ПереоценкаКупона;
	ПереоценкаКупонаВВалютеУчета 	= ПараметрыПогашенияКупона.ПереоценкаКупонаВВалютеУчета;
	СчетПогашениеКупона 			= ПараметрыПогашенияКупона.СчетПогашениеКупона;
	
	// #Технический долг - нужно это правильно сделать
	ЭтоБанкрот = Ложь;
	Если Облигация.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Эмитент_Прайм") И Дата >= '20190913' Тогда
		ЭтоБанкрот = Истина;
	КонецЕсли;
	
	Контрагент = Неопределено;
	ПараметрыПогашенияКупона.Свойство("КонтрагентЗалога", Контрагент);
	ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона = Неопределено;
	ПараметрыПогашенияКупона.Свойство("ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона", ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона);
	СделкаРЕПО = Неопределено;
	ПараметрыПогашенияКупона.Свойство("СделкаРЕПО", СделкаРЕПО);
		
	
	Если ЭтоБанкрот Тогда // для банкротов в доход идет только себестоимость купона
		
		СуммаКупона = 0;
		
		Если НастройкиУчетаАктива.СчетУчета <> НастройкиУчетаАктива.СчетУчетаПереоценки Тогда
		    СуммаКупона = СуммаКупона + ПереоценкаКупона;
		КонецЕсли;
		
		Если Не НастройкиУчетаАктива.ОтражатьНаПереоценкеПолнуюСумму Тогда
		    СуммаКупона = СуммаКупона + СтоимостьКупона;
		КонецЕсли;
	
	КонецЕсли;
	
	ОтражатьВДоходеТолькоРазницу = НастройкиУчетаАктива.ПриПогашенииВДоходеОтражатьТолькоРазницу; 
	
	Если СуммаКупона <> 0  Тогда
		//Дт Счет7654 Кт СчетДоходы Сумма = ЭтотОбъект.СуммаКупона
		Если НЕ ОтражатьВДоходеТолькоРазницу Тогда  
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаОплаты, Дата, ВалютаУчета, Дата, Отказ), "Доход от погашения купона");
			
			// дебет
			Проводка.СчетДт = СчетПогашениеКупона;
			Проводка.СубконтоДт.Облигации = Облигация;
			
			Если СчетПогашениеКупона.Валютный Тогда
				Если ВалютаОплаты <> ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаНоминала, Дата, ВалютаОплаты, Дата, Отказ);
				Иначе
					Проводка.ВалютнаяСуммаДт = СуммаКупона;
				КонецЕсли;	
				Проводка.ВалютаДт = ВалютаОплаты;
			КонецЕсли;
			
			Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
				Проводка.СубконтоДт.ОснованиеРасчетов = ДокументСсылка; 
			КонецЕсли;	
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = Облигация;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		Конецесли;
		
		Если ВЗалоге И НЕ ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаОплаты, Дата, ВалютаУчета, Дата, Отказ), "Доход от погашения купона");
			
			Если ВалютаОплаты <> ВалютаУчета Тогда
				Проводка.СчетДт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
				Если ВалютаОплаты <> ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаНоминала, Дата, ВалютаОплаты, Дата, Отказ);
				Иначе
					Проводка.ВалютнаяСуммаДт = СуммаКупона;
				КонецЕсли;	
				Проводка.ВалютаДт = ВалютаОплаты;
			Иначе
				Проводка.СчетДт = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
			КонецЕсли;	
			Проводка.СубконтоДт.Контрагенты 		= Контрагент;
			
			Проводка.СчетКт = СчетПогашениеКупона;
			Проводка.СубконтоКт.Облигации = Облигация;
			
			Если СчетПогашениеКупона.Валютный Тогда
				Если ВалютаОплаты <> ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаКт = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаНоминала, Дата, ВалютаОплаты, Дата, Отказ);
				Иначе
					Проводка.ВалютнаяСуммаКт = СуммаКупона;
				КонецЕсли;	
				Проводка.ВалютаКт = ВалютаОплаты;
			КонецЕсли;
			
			Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
				Проводка.СубконтоКт.ОснованиеРасчетов = ДокументСсылка;
			КонецЕсли;			
			
		КонецЕсли;	
	КонецЕсли;
	
	Если ПереоценкаКупона <> 0 И НастройкиУчетаАктива.СчетУчета <> НастройкиУчетаАктива.СчетУчетаПереоценки Тогда
		
		//Дт СчетРасходы Кт СчетУчетаПереоценки = ПереоценкаКупона
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаКупонаВВалютеУчета, "Переоценка купона в расход");
		
		// дебет
		Если  НЕ ОтражатьВДоходеТолькоРазницу Тогда 
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			
			Если УчетныйРегистр = "НалоговыйУчет" Тогда
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтПереоценки;
			Иначе
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходов;
			КонецЕсли;
			
			Проводка.СубконтоДт.ЦенныеБумаги     = Облигация;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
		Иначе
			Проводка.СчетДт = СчетПогашениеКупона;
			Проводка.СубконтоДт.Облигации = Облигация;
			
			Если СчетПогашениеКупона.Валютный Тогда
				Если ВалютаОплаты <> ВалютаУчета Тогда
					Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаНоминала, Дата, ВалютаОплаты, Дата, Отказ);
				Иначе
					Проводка.ВалютнаяСуммаДт = СуммаКупона;
				КонецЕсли;	
				Проводка.ВалютаДт = ВалютаОплаты;
			КонецЕсли;		
			
			Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
				Проводка.СубконтоДт.ОснованиеРасчетов = ДокументСсылка; 
			КонецЕсли;				
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = ?(ВЗалоге, НастройкиУчетаАктива.СчетУчетаПереоценкиВЗалоге, НастройкиУчетаАктива.СчетУчетаПереоценки);
		Проводка.СубконтоКт.Облигации = Облигация;
		
		Если Проводка.СчетКт.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = ПереоценкаКупона;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не НастройкиУчетаАктива.ОтражатьНаПереоценкеПолнуюСумму Тогда
		Если СтоимостьКупона <> 0 Тогда
			//Дт СчетРасходы Кт СчетУчета Сумма = СтоимостьКупона
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьКупонаВВалютеУчета, "Купон в расход");
			
			// дебет
			Если  НЕ ОтражатьВДоходеТолькоРазницу Тогда 			
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходов;
				Проводка.СубконтоДт.ЦенныеБумаги         = Облигация;
				Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			Иначе
				Проводка.СчетДт = СчетПогашениеКупона;
				Проводка.СубконтоДт.Облигации = Облигация;
				
				Если СчетПогашениеКупона.Валютный Тогда
					Если ВалютаОплаты <> ВалютаУчета Тогда
						Проводка.ВалютнаяСуммаДт = РаботаСВалютами.ПересчетСуммыВВалюте(СуммаКупона, ВалютаНоминала, Дата, ВалютаОплаты, Дата, Отказ);
					Иначе
						Проводка.ВалютнаяСуммаДт = СуммаКупона;
					КонецЕсли;
					Проводка.ВалютаДт = ВалютаОплаты;
				КонецЕсли;	
				
				Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
					Проводка.СубконтоДт.ОснованиеРасчетов = ДокументСсылка; 
				КонецЕсли;	
				
			КонецЕсли;
			// кредит
			Проводка.СчетКт = ?(ВЗалоге, НастройкиУчетаАктива.СчетУчетаВЗалоге, НастройкиУчетаАктива.СчетУчета);
			Проводка.СубконтоКт.Облигации = Облигация;
			
			Если Проводка.СчетКт.Валютный Тогда
				Проводка.ВалютнаяСуммаКт = СтоимостьКупона;
				Проводка.ВалютаКт = ВалютаНоминала;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроводкиПоКупленнымПоРЕПОЕПС(ДокументСсылка, Движения) Экспорт

	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	0 КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ ВТ_КоличествоРЕПО
		|ИЗ
		|	ВТ_ЗадолженностиПоЦеннымБумагамОстатки КАК ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗадолженностиПоЦеннымБумагамОстатки КАК ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание = ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.Основание
		|			И (ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|ГДЕ
		|	ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Основание,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_КоличествоРЕПО.Основание,
		|	ВТ_КоличествоРЕПО.Контрагент,
		|	ВТ_КоличествоРЕПО.КоличествоОстаток,
		|	ВТ_КоличествоРЕПО.КоличествоВРЕПО,
		|	ВТ_КоличествоРЕПО.КоличествоПоРЕПО
		|ИЗ
		|	ВТ_КоличествоРЕПО КАК ВТ_КоличествоРЕПО";
		
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументСсылка.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Основание"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"					, ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("Рынок"						, Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("ЦеннаяБумага"				, ДокументСсылка.Облигация);
	Запрос.УстановитьПараметр("ДатаФиксации"				, ?(ДокументСсылка.ДатаФиксации = НачалоДня(ДокументСсылка.Дата), НачалоДня(ДокументСсылка.ДатаФиксации), КонецДня(ДокументСсылка.ДатаФиксации)));
	Запрос.УстановитьПараметр("НКЦпоРЕПОсЦК"				, НКЦпоРЕПОсЦК(ДокументСсылка.Дата));
	
	ОбщееКоличествоПоРЕПО = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КоличествоПоРЕПО) Тогда
		
			КоличествоПоРЕПО = Выборка.КоличествоПоРЕПО;
			СуммаПоРЕПО = КоличествоПоРЕПО * ДокументСсылка.СуммаНаОднуОблигацию;
			
			ОбщееКоличествоПоРЕПО = ОбщееКоличествоПоРЕПО + КоличествоПоРЕПО;
			
			Если Движения <> Неопределено Тогда
			
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СуммаПоРЕПО, "Погашение купона по ЦБ, купленым по РЕПО");
				
				Проводка.Период = Движения.Отбор.Регистратор.Значение.Дата;
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
				
				Проводка.СубконтоДт.Контрагенты 		= ДокументСсылка.Облигация.Эмитент.ЮрФизЛицо;
				Проводка.СубконтоДт.ОснованиеРасчетов 	= ДокументСсылка;
				
				Проводка.ВалютаДт = ДокументСсылка.ВалютаОплаты;
				Проводка.ВалютнаяСуммаДт = СуммаПоРЕПО;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.Расчеты22;
				
				Проводка.СубконтоКт.Контрагенты 		= Выборка.Контрагент;
				Проводка.СубконтоКт.ОснованиеРасчетов 	= Выборка.Основание;
				
				Проводка.ВалютаКт 			= ДокументСсылка.ВалютаОплаты;
				Проводка.ВалютнаяСуммаКт 	= СуммаПоРЕПО;
				
				Проводка.ДополнительнаяАналитикаКт = АналитикаДебиторкиПоКупону;
			
			КонецЕсли;			
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщееКоличествоПоРЕПО;

КонецФункции
