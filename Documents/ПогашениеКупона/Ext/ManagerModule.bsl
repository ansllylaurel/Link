Функция НКЦпоРЕПОсЦК(ДатаДок) Экспорт
	//Хардкод: дата начала подстановки контрагента НКЦ вместо брокера в прямых РЕПО с ЦК
	Возврат ДатаДок >= Дата(2025, 9, 18);
КонецФункции

Функция ОпределитьКоличествоБумагПоРЕПО(ДокументСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	0 КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ ВТ_КоличествоРЕПО
		|ИЗ
		|	ВТ_ЗадолженностиПоЦеннымБумагамОстатки КАК ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗадолженностиПоЦеннымБумагамОстатки КАК ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание = ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.Основание
		|			И (ВТ_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|ГДЕ
		|	ВТ_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Основание,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_КоличествоРЕПО.Основание,
		|	ВТ_КоличествоРЕПО.Контрагент,
		|	ВТ_КоличествоРЕПО.КоличествоОстаток,
		|	ВТ_КоличествоРЕПО.КоличествоВРЕПО,
		|	ВТ_КоличествоРЕПО.КоличествоПоРЕПО
		|ИЗ
		|	ВТ_КоличествоРЕПО КАК ВТ_КоличествоРЕПО";
		
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументСсылка.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Основание"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"					, ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("Рынок"						, Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("ЦеннаяБумага"				, ДокументСсылка.Облигация);
	Запрос.УстановитьПараметр("ДатаФиксации"				, ?(ДокументСсылка.ДатаФиксации = НачалоДня(ДокументСсылка.Дата), НачалоДня(ДокументСсылка.ДатаФиксации), КонецДня(ДокументСсылка.ДатаФиксации)));
	Запрос.УстановитьПараметр("НКЦпоРЕПОсЦК"				, НКЦпоРЕПОсЦК(ДокументСсылка.Дата));
	
	ОбщееКоличествоПоРЕПО = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КоличествоПоРЕПО) Тогда
		
			КоличествоПоРЕПО = Выборка.КоличествоПоРЕПО;
			СуммаПоРЕПО = КоличествоПоРЕПО * ДокументСсылка.СуммаНаОднуОблигацию;
			
			ОбщееКоличествоПоРЕПО = ОбщееКоличествоПоРЕПО + КоличествоПоРЕПО;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщееКоличествоПоРЕПО;

КонецФункции

Функция ПодготовитьНаборПроводок(ДокументСсылка, Дата, Организация, СчетДоверительногоУправления, ВидЗадолженности = Неопределено, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь) Экспорт
	
	Движения = РегистрыБухгалтерии[УчетныйРегистр].СоздатьНаборЗаписей();
	
	Если Не ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
		Возврат Движения;
	КонецЕсли;
	
	// #414504 - пришел купон а бумаги по Т+ ушли
	Если СчетДоверительногоУправления = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_ПФР_РЭМ")
		И НачалоДня(Дата) = '20220110' Тогда
	
		Возврат Движения;	
	
	КонецЕсли;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Облигация, СуммаКупона, ВалютаОплаты, СуммаНаОднуОблигацию");
	Облигация       = ДанныеДокумента.Облигация;
	СуммаКупона		= ДанныеДокумента.СуммаКупона;
	ВалютаОплаты    = ДанныеДокумента.ВалютаОплаты;
	
	ВалютаНоминала 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Облигация, "ВалютаНоминала");
	ВалютаУчета 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	//ВалютныйУчет   = ВалютаНоминала <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	// #361945 - по Облигация_ДП_О1ГрФин1P3, Облигация_АрчерФинанс, Облигация_ОткрытиеХолдинг клиенты Будущее(с 11/2/21) и Телеком(с 10/2/21) отключили расчет НКД
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Дата);
	
	ЭтоКлиентБудущее = (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_БУДУЩЕЕ"));
	ЭтоКлиентТелеком = (Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ТелекомСоюз"));
	
	Если ЭтоКлиентТелеком И НачалоДня(Дата) >= '20210210'
		ИЛИ ЭтоКлиентБудущее И НачалоДня(Дата) >= '20210211' Тогда
		
		Если Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс")
			ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1_Груп_Финанс") 
			ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ДП_О1ГрФин1P3") 
			ИЛИ Облигация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг") Тогда
			
			Возврат Движения;	
			
		КонецЕсли;
	КонецЕсли;
	
	Если ВалютаНоминала = ВалютаУчета Тогда
		СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупона;
	Иначе
		СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации;
	КонецЕсли;
	
	УчетныйАктив 	= БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.Облигации, Облигация, Истина);
	
	НастройкиУчетаАктива = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
		
	УчетныйАктивОблигация = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.Облигации, Облигация, Ложь);
	
	НастройкиУчетаАктиваОблигация = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктивОблигация,
		УчетныйРегистр);		
		
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, Облигация, УчетныйРегистр);
	
	ДвиженияРЕПО = ПроводкиПоКупленнымПоРЕПО(ДокументСсылка, Движения, УчетныйРегистр, НастройкиУчетаАктива, НастройкиУчетаАктиваОблигация, УчетныйАктив, УчетныйАктивОблигация, ВалютаНоминала, ВалютаОплаты, ВалютаУчета, СчетПогашениеКупона, ОбращаетсяНаОРЦБ, ЭтоПроведениеНачисления, Отказ);
	
	СуммаКупона = СуммаКупона - ДвиженияРЕПО.СуммаВРЕПО - ДвиженияРЕПО.СуммаПоРЕПО;
	
	Если СуммаКупона < 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("После учета суммы купона по бумагам, купленным по РЕПО, к распределению по собственным партиям осталась отрицательная сумма! Документ не проведен по виду учета!", ДокументСсылка,,,Отказ);
		Возврат Движения;
	КонецЕсли;
			
	МетодОпределенияДоходовИРасходов = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		Дата, 
		Организация, 
		СчетДоверительногоУправления,
		УчетныйРегистр,
		"МетодОпределенияДоходовИРасходов");
		
	Если Не ЗначениеЗаполнено(МетодОпределенияДоходовИРасходов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках по виду учета " + УчетныйРегистр + " не указан метод определения доходов и расходов. Документ не проведен по виду учета!", ДокументСсылка,,,Отказ);
		Возврат Движения;
	КонецЕсли;
	
	Если МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый И ЭтоПроведениеНачисления Тогда
		Возврат Движения;
	КонецЕсли;
	
	ИтогоДоход = 0; // используется для облигаций с индексируемым номиналом. Только госы РФ
	
	//читаем движения партий
	// В налоговом учете перекурсовок нет, для проводок используем суммы списания по партиям
	Запрос = Новый Запрос;
		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|				И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДооценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминала) КАК ИндексацияНоминала,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала <> 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДвижениеИндексацииНоминала
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала <> 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Количество = 0
		|				И БухПартииЦенныхБумаг.ПереоценкаКупона <> 0
		|				И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Перекурсовка УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	НалоговыйУчетОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
		|			&ДоДокумента,
		|			Счет = &Счет97,
		|			&ВидыСубконто,
		|			Субконто1 = &Облигация
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НалоговыйУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаФиксацииУтро,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И ЦеннаяБумага = &Облигация) КАК БухПартииЦенныхБумагОстатки";
		
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Приход",    	 ВидДвиженияНакопления.Приход);
	Запрос.УстановитьПараметр("ВидУчетаНУ",  Перечисления.ВидыУчета[УчетныйРегистр] = Перечисления.ВидыУчета.НалоговыйУчет);

	Запрос.УстановитьПараметр("ДоДокумента", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаФиксацииУтро", НачалоДня(ДокументСсылка.ДатаФиксации));
	Запрос.УстановитьПараметр("Облигация", 	 Облигация);
	Запрос.УстановитьПараметр("Счет97", 	 ПланыСчетов.Основной.РасходыБудущихПериодов);
	
	ВидыСубконто = Новый Массив;
    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы);
    Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", УчетныйРегистр);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	ТаблицаНепринимаемойИндексацииНоминалов = РезультатЗапроса[1].Выгрузить();
	ВыборкаКоличество = РезультатЗапроса[2].Выбрать();
	
	КоличествоПоПартиям = 0;
	Если ВыборкаКоличество.Следующий() Тогда
		КоличествоПоПартиям = ВыборкаКоличество.КоличествоОстаток;
	КонецЕсли;
	
	СтоимостьКупона  = 0;
	СтоимостьКупонаВВалютеУчета  = 0;
	ПереоценкаКупона = 0;
	ПереоценкаКупонаВВалютеУчета = 0;
	ДооценкаИндексацииНоминала = 0;
	ДооценкаКупона = 0;
	ДооценкаКупонаВВалютеУчета = 0;
	
	СтруктураОбъекта = Новый Структура("Ссылка, Дата, Движения", ДокументСсылка, Дата, Движения); 
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Перекурсовка  Тогда
			ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
				+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				Облигация, Перечисления.РынкиЦенныхБумаг.Облигации,
				Выборка.СтоимостьВВалютеУчета, Выборка.СтоимостьКупонаВВалютеУчета,  Выборка.ПереоценкаВВалютеУчета, Выборка.ПереоценкаКупонаВВалютеУчета);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаАктиваОблигация.СчетУчета);
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчета);
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаАктиваОблигация.СчетУчетаПереоценки);
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.СчетУчетаПереоценки);
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктивОблигация.ИмяПредопределенныхДанных, НастройкиУчетаАктиваОблигация.АналитикаПерекурсовки);
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчетаАктива.АналитикаПерекурсовки);
			
			БухгалтерскийУчет.ДвижениеПерекурсовки(СтруктураОбъекта, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			
		ИначеЕсли Выборка.ДвижениеИндексацииНоминала  Тогда
			ДооценкаИндексацииНоминала 			= Выборка.ИндексацияНоминала;
		ИначеЕсли Выборка.ДооценкаКупона  Тогда
			ДооценкаКупона			 	= Выборка.ПереоценкаКупона;
			ДооценкаКупонаВВалютеУчета	= Выборка.ПереоценкаКупонаВВалютеУчета;
		Иначе	
			СтоимостьКупона  			 = Выборка.СтоимостьКупона;
			СтоимостьКупонаВВалютеУчета  = Выборка.СтоимостьКупонаВВалютеУчета;
			ПереоценкаКупона			 = Выборка.ПереоценкаКупона;
			ПереоценкаКупонаВВалютеУчета = Выборка.ПереоценкаКупонаВВалютеУчета;
		КонецЕсли;
	КонецЦикла;	
	
	Если ДооценкаИндексацииНоминала <> 0 Тогда
		
		АналитикаДоходовОтИндексацииНоминала = НастройкиУчетаАктиваОблигация.АналитикаДоходовИндексацииНоминала;
		СчетУчетаИндексацииНоминала = НастройкиУчетаАктиваОблигация.СчетУчетаИндексацииНоминала;
		
		ПараметрыИндексацииНоминала = Новый Структура("ЦеннаяБумага, ИндексацияНоминала, КупонныйДоход, ТаблицаНепринимаемойИндексацииНоминалов",
			Облигация, 
			ДооценкаИндексацииНоминала,  
			КоличествоПоПартиям * ДанныеДокумента.СуммаНаОднуОблигацию - СтоимостьКупона - ПереоценкаКупона,
			ТаблицаНепринимаемойИндексацииНоминалов);
		БухгалтерскийУчет.ДвижениеИндексацииНоминала(ДокументСсылка, Движения, ПараметрыИндексацииНоминала, АналитикаДоходовОтИндексацииНоминала, СчетУчетаИндексацииНоминала, ОбращаетсяНаОРЦБ, Отказ);
		
	КонецЕсли;
	
	Если ДооценкаКупонаВВалютеУчета <> 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ДооценкаКупонаВВалютеУчета, "Переоценка купона ценной бумаги");
		
		Проводка.СчетДт = НастройкиУчетаАктива.СчетУчетаПереоценки;
		Проводка.СубконтоДт.Облигации = Облигация;
		
		Если НастройкиУчетаАктива.СчетУчетаПереоценки.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = Выборка.ПереоценкаКупонаДоначислено;
			Проводка.ВалютаДт = ВалютаНоминала;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчетаАктива.АналитикаДоходовОтПереоценки;
		Проводка.СубконтоКт.ЦенныеБумаги         = Облигация;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	КонецЕсли;
	
	ПараметрыПогашенияКупона = Новый Структура("Облигация, ВЗалоге, КонтрагентЗалога, Дата, ОбращаетсяНаОРЦБ, СуммаКупона, СтоимостьКупона, СтоимостьКупонаВВалютеУчета, ПереоценкаКупона, ПереоценкаКупонаВВалютеУчета, 
		|ВалютаОплаты, ВалютаУчета, ВалютаНоминала, СчетПогашениеКупона", 
		Облигация, Ложь, Неопределено, Дата, ОбращаетсяНаОРЦБ, СуммаКупона, СтоимостьКупона, СтоимостьКупонаВВалютеУчета, ПереоценкаКупона, ПереоценкаКупонаВВалютеУчета, 
		ВалютаОплаты, ВалютаУчета, ВалютаНоминала, СчетПогашениеКупона);
	ОтразитьПогашениеКупонаПроводки(ДокументСсылка, Движения, УчетныйРегистр, НастройкиУчетаАктива, ПараметрыПогашенияКупона, Отказ);
	
	Возврат Движения;
	
КонецФункции // ПодготовитьНаборПроводок()	

Функция ПроводкиПоКупленнымПоРЕПО(ДокументСсылка, Движения, УчетныйРегистр, НастройкиУчетаАктива, НастройкиУчетаОблигация, УчетныйАктив, УчетныйАктивОблигация, ВалютаНоминала, ВалютаОплаты, ВалютаУчета, СчетПогашениеКупона, ОбращаетсяНаОРЦБ, ФормироватьПроводки, Отказ)

	АналитикаДебиторкиПоКупону = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	
	ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ДокументСсылка.Дата, 
		ДокументСсылка.Организация, 
		ДокументСсылка.СчетДоверительногоУправления,
		УчетныйРегистр,
		"ОтражатьЗадолженностьПоКупонуВЗалогеНаСчетеПогашенияКупона");
		
	ФормироватьПроводкиОбратногоРЕПО = ФормироватьПроводки;
	
	РасчетныеНастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДокументСсылка.Дата, ДокументСсылка.Организация, ДокументСсылка.СчетДоверительногоУправления);
	ФормироватьПроводкиОбратногоРЕПО = НЕ РасчетныеНастройкиУчета.ОтражатьЗадолженностьПоПогашениюКупонаДляБумагКупленныхПоРЕПОПоФактуОплаты;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоЦеннымБумагамОстатки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ДатаФиксации,
		|			(ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|				ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Брокер.ЮрФизЛицо
		|		ИНАЧЕ _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	0 КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВРЕПО,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.КоличествоОстаток - ЕСТЬNULL(_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.КоличествоОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПоРЕПО
		|ПОМЕСТИТЬ _КоличествоРЕПО
		|ИЗ
		|	_ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоЦеннымБумагамОстатки КАК _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО
		|		ПО _ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.Основание = _ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.Основание
		|			И (_ЗадолженностиПоЦеннымБумагамПоПервойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО))
		|ГДЕ
		|	_ЗадолженностиПоЦеннымБумагамПоВторойЧастиРЕПО.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.СделкаСЦентральнымКонтрагентом И &НКЦпоРЕПОсЦК
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Брокер.ЮрФизЛицо
		|		ИНАЧЕ ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО.Контрагент
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ДатаФиксации,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага = &ЦеннаяБумага) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Основание,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо,
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ДатаФиксации,
