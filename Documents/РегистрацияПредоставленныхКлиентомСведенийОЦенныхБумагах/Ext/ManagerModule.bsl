
Функция ПолучитьСвязанныеСчетаДоверительногоУправления(Документ) Экспорт
	
	СвязанныеСчетаДоверительногоУправления = Новый Массив;

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// Для ЭСП получаем из партий
	
	Если ЗначениеЗаполнено(Документ.ЭСП) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТабличнаяЧастьЭСП.Партия КАК Партия
			|ПОМЕСТИТЬ _ТабличнаяЧастьЭСП
			|ИЗ
			|	&ТабличнаяЧастьЭСП КАК ТабличнаяЧастьЭСП
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ТабличнаяЧастьЭСП.Партия.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	_ТабличнаяЧастьЭСП КАК _ТабличнаяЧастьЭСП");
		
		Запрос.УстановитьПараметр("ТабличнаяЧастьЭСП", Документ.ЭСП.Выгрузить(, "Партия"));
		
		СчетаПоЭСП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	
		РаботаСКоллекциями.ДополнитьМассив(СвязанныеСчетаДоверительногоУправления, СчетаПоЭСП, Истина);
		
	КонецЕсли;
	
	// для Аналогов получаем счета клиента, у которых на остатках есть эта бумага
	
	Если ЗначениеЗаполнено(Документ.Аналоги) ИЛИ ЗначениеЗаполнено(Документ.НастройкиУчета) Тогда

		ИмяВременнойТаблицыЦенныхБумагКлиента = РаботаСЦеннымиБумагами.ПолучитьЦенныеБумагиКлиента(Документ.Клиент, Документ.Организация, КонецДня(Документ.Дата), , , Истина, Истина, , МенеджерВременныхТаблиц);
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ЦенныеБумагиКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	&ЦенныеБумагиКлиента КАК _ЦенныеБумагиКлиента
			|ГДЕ
			|	_ЦенныеБумагиКлиента.ЦеннаяБумага = &ЦеннаяБумага");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЦенныеБумагиКлиента", ИмяВременнойТаблицыЦенныхБумагКлиента);
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ЦеннаяБумага", Документ.ЦеннаяБумага);
		
		СчетаПоЦеннойБумаге = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	
		РаботаСКоллекциями.ДополнитьМассив(СвязанныеСчетаДоверительногоУправления, СчетаПоЦеннойБумаге, Истина);

	КонецЕсли;
	
	Возврат СвязанныеСчетаДоверительногоУправления;
	
КонецФункции

Функция ПолучитьТаблицуПроверкиДатЗапретаРедактирования(Документ) Экспорт
	
	ТаблицаПроверкиЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьТаблицуПроверкиДатЗапретаРедактирования();

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// Для ЭСП получаем счета клиентов из партий и проверяем по ним бэк-офис
	
	Если ЗначениеЗаполнено(Документ.ЭСП) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТабличнаяЧастьЭСП.Партия КАК Партия
			|ПОМЕСТИТЬ _ТабличнаяЧастьЭСП
			|ИЗ
			|	&ТабличнаяЧастьЭСП КАК ТабличнаяЧастьЭСП
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ТабличнаяЧастьЭСП.Партия.Организация КАК Организация,
			|	_ТабличнаяЧастьЭСП.Партия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис) КАК ГруппаЗапрета,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка) КАК ВидУчета,
			|	&Период КАК Период
			|ИЗ
			|	_ТабличнаяЧастьЭСП КАК _ТабличнаяЧастьЭСП");
		
		Запрос.УстановитьПараметр("ТабличнаяЧастьЭСП",	Документ.ЭСП.Выгрузить(, "Партия"));
		Запрос.УстановитьПараметр("Период",				НачалоДня(Документ.Дата));
		
		ТаблицаПроверкиПоЭСП = Запрос.Выполнить().Выгрузить();
	
		РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицаПроверкиПоЭСП, ТаблицаПроверкиЗапретаРедактирования);
		
	КонецЕсли;
	
	// для Аналогов и Настроек получаем счета клиента, у которых на остатках есть эта бумага
	
	Если ЗначениеЗаполнено(Документ.Аналоги) ИЛИ ЗначениеЗаполнено(Документ.НастройкиУчета) Тогда
		
		РаботаСЦеннымиБумагами.ПолучитьЦенныеБумагиКлиента(Документ.Клиент, Документ.Организация, КонецДня(Документ.Дата), , , Истина, Истина, "_ЦенныеБумагиКлиента", МенеджерВременныхТаблиц);

		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ЦенныеБумагиКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _СчетаДУСЦеннойБумагой
			|ИЗ
			|	_ЦенныеБумагиКлиента КАК _ЦенныеБумагиКлиента
			|ГДЕ
			|	_ЦенныеБумагиКлиента.ЦеннаяБумага = &ЦеннаяБумага");
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("ЦеннаяБумага", Документ.ЦеннаяБумага);
		Запрос.Выполнить();
		
		Если ЗначениеЗаполнено(Документ.НастройкиУчета) Тогда
			
			// Для настроек проверяем по всем бэк-офис
						
			СчетаПоЦеннойБумаге = МенеджерВременныхТаблиц.Таблицы["_СчетаДУСЦеннойБумагой"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
		
			Для Каждого СчетДоверительногоУправления Из СчетаПоЦеннойБумаге Цикл
				РегистрыСведений.ДатыЗапретаРедактирования.ДобавитьСтрокуВТаблицуПроверкиДатЗапретаРедактирования(
					ТаблицаПроверкиЗапретаРедактирования, Перечисления.ГруппыЗапретаРедактирования.БэкОфис, , Документ.Организация, СчетДоверительногоУправления, Документ.Дата);
			КонецЦикла;
			
		ИначеЕсли ЗначениеЗаполнено(Документ.Аналоги) Тогда
			
			// Для аналогов проверяем бэк-офис и партии, при этом исключаем счета д/у с методикой РЭМ,
			// т.к. считаем, что в РЭМ аналоги не используются.
			// Для группы запрета "бэк-офис" методику берем в оценке объектов в управлении и только в дни формирования СЧА,
			// для группы запрета "партии" - в оценке ЕПС
			
			ИсключаемыеМетодики = Новый Массив;
			ИсключаемыеМетодики.Добавить(Справочники.ВариантыРасчетаОценочнойСтоимости.РЭМ);
			ИсключаемыеМетодики.Добавить(Справочники.ВариантыРасчетаОценочнойСтоимости.ФОГФ);
			
			ПараметрыПериодичностиСЧА = Новый Структура("ВидДействия, ДатаС, ДатаПо, ИмяТаблицыСчетовДУ, ИмяТаблицыДатДействияЗаПериод",
				"СЧА", Документ.Дата, Документ.Дата, "_СчетаДУСЦеннойБумагой", "_ДатыРасчетаСЧА");
			Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, ПараметрыПериодичностиСЧА);
			
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиЦелейРасчета.Организация КАК Организация,
				|	НастройкиЦелейРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	ВЫБОР
				|		КОГДА НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
				|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)
				|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
				|	КОНЕЦ КАК ГруппаЗапрета,
				|	ВЫБОР
				|		КОГДА НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
				|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка)
				|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
				|	КОНЕЦ КАК ВидУчета,
				|	&Период КАК Период
				|ИЗ
				|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
				|			&Период,
				|			СчетДоверительногоУправления В
				|					(ВЫБРАТЬ
				|						_СчетаДУСЦеннойБумагой.СчетДоверительногоУправления
				|					ИЗ
				|						_СчетаДУСЦеннойБумагой КАК _СчетаДУСЦеннойБумагой)
				|				И ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов))) КАК НастройкиЦелейРасчета
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыРасчетаСЧА КАК _ДатыРасчетаСЧА
				|		ПО (_ДатыРасчетаСЧА.СчетДоверительногоУправления = НастройкиЦелейРасчета.СчетДоверительногоУправления)
				|			И (_ДатыРасчетаСЧА.Дата = &Период)
				|ГДЕ
				|	НЕ НастройкиЦелейРасчета.ВариантРасчетаОценочнойСтоимости В (&ИсключаемыеМетодики)
				|	И НЕ(НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
				|				И _ДатыРасчетаСЧА.Дата ЕСТЬ NULL)";
			
			Запрос.УстановитьПараметр("Период",				 НачалоДня(Документ.Дата));
			Запрос.УстановитьПараметр("ИсключаемыеМетодики", ИсключаемыеМетодики);
			
			ТаблицаПроверкиПоАналогам = Запрос.Выполнить().Выгрузить();
		
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицаПроверкиПоАналогам, ТаблицаПроверкиЗапретаРедактирования);
				
		КонецЕсли;

	КонецЕсли;	

	ТаблицаПроверкиЗапретаРедактирования.Свернуть("Организация, СчетДоверительногоУправления, ГруппаЗапрета, ВидУчета, Период");
	
	Возврат ТаблицаПроверкиЗапретаРедактирования;
	
КонецФункции

Функция ТипыОфертТребующиеПересчетаЭСП() Экспорт 

	ТипыОферт = Новый Массив();
	ТипыОферт.Добавить(Перечисления.ТипыОфертПоОблигациям.Досрочно);
	ТипыОферт.Добавить(Перечисления.ТипыОфертПоОблигациям.ОфертаПродажа);

	Возврат ТипыОферт;
	
КонецФункции

Функция ПартииПоАСиРегистрациейЭСП(Дата, ЦеннаяБумага, Организация, Клиент = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	(&ВсеКлиенты
		|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ _Партии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ)
		|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Партии.Партия КАК Партия,
		|	_Партии.СтрокаПартии КАК СтрокаПартии,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Период КАК Период,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЭСП КАК ЭСП
		|ПОМЕСТИТЬ _Решения
		|ИЗ
		|	_Партии КАК _Партии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага = &ЦеннаяБумага
		|					И ДатаНачалаДействия < &Период
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаДУ.СчетДоверительногоУправления
		|						ИЗ
		|							_СчетаДУ)) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
		|		ПО _Партии.Партия = РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия
		|			И _Партии.СтрокаПартии = РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии
		|			И (РешенияКлиентовПоЗначениямЭСПСрезПоследних.Используется)
		|			И (РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЭСП <> 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Решения.Партия КАК Партия,
		|	_Решения.СтрокаПартии КАК СтрокаПартии,
		|	МАКСИМУМ(_Решения.Период) КАК Период
		|ПОМЕСТИТЬ _ПериодРешения
		|ИЗ
		|	_Решения КАК _Решения
		|
		|СГРУППИРОВАТЬ ПО
		|	_Решения.Партия,
		|	_Решения.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Партии.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Партии.Партия КАК Партия,
		|	_Партии.СтрокаПартии КАК СтрокаПартии,
		|	_Партии.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_Решения.ЭСП КАК ЭСП,
		|	_Партии.Количество КАК Количество,
		|	_СчетаДУ.Клиент КАК Клиент
		|ИЗ
		|	_Партии КАК _Партии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДУ КАК _СчетаДУ
		|		ПО _Партии.СчетДоверительногоУправления = _СчетаДУ.СчетДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодРешения КАК _ПериодРешения
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Решения КАК _Решения
		|			ПО _ПериодРешения.Партия = _Решения.Партия
		|				И _ПериодРешения.СтрокаПартии = _Решения.СтрокаПартии
		|				И _ПериодРешения.Период = _Решения.Период
		|		ПО _Партии.Партия = _ПериодРешения.Партия
		|			И _Партии.СтрокаПартии = _ПериодРешения.СтрокаПартии
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправления,
		|	_Партии.Партия.Дата,
		|	СтрокаПартии";
	
	Если Клиент = Неопределено Тогда
		Запрос.УстановитьПараметр("ВсеКлиенты", Истина);
		Запрос.УстановитьПараметр("Клиент", Справочники.ЮрФизЛица.ПустаяСсылка());
	Иначе		
		Запрос.УстановитьПараметр("ВсеКлиенты", Ложь);
		Запрос.УстановитьПараметр("Клиент", Клиент);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьДенежныйПоток(Организация, Клиент, ЦеннаяБумага, Дата, УчитыватьРешенияКлиентовПоПотокам, УчетныйАктивЕПС = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено, ДатаОпределенияПотока = Неопределено) Экспорт
	
	МассивСчетовДУ = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(Клиент, Организация, Дата);
	
	Если МассивСчетовДУ.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У данного клиента нет ни одного действующего договора ДУ", , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Партия = Неопределено;
	СтрокаПартии = Неопределено;
	
	Если ТипЗнч(УчитыватьРешенияКлиентовПоПотокам) = Тип("Булево") Тогда
	
		УчитыватьРешенияКлиентов = УчитыватьРешенияКлиентовПоПотокам;
		
	ИначеЕсли ТипЗнч(УчитыватьРешенияКлиентовПоПотокам) = Тип("Структура") Тогда 
		
		Если УчитыватьРешенияКлиентовПоПотокам.Свойство("УчитыватьРешенияКлиентовПоПотокам") Тогда
			УчитыватьРешенияКлиентов = УчитыватьРешенияКлиентовПоПотокам.УчитыватьРешенияКлиентовПоПотокам;
		КонецЕсли;
		УчитыватьРешенияКлиентовПоПотокам.Свойство("Партия", Партия);
		УчитыватьРешенияКлиентовПоПотокам.Свойство("СтрокаПартии", СтрокаПартии);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неправильный тип параметра 'Учитывать решения клиентов по потокам'", , , , Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	СчетДоверительногоУправления = МассивСчетовДУ[0]; // берем 1го - настройки должны быть идентичны
	
	НастройкиУчетаОбщие			= БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	НастройкиУчетаЦеннойБумаги	= БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(НастройкиУчетаОбщие, ЦеннаяБумага, УчетныйАктивЕПС, Партия, СтрокаПартии);
	НастройкиЦелиРасчета		= БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(Дата, Организация, СчетДоверительногоУправления, Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	ПараметрыДенежногоПотока = Новый Структура;
	ПараметрыДенежногоПотока.Вставить("ДоДатыПогашения",					 НастройкиУчетаЦеннойБумаги.РассчитыватьЭСПДо = Перечисления.ВариантыРасчетаДоходностиПоОблигациям.ДоПогашения);
	ПараметрыДенежногоПотока.Вставить("Дата",								 Дата);
	ПараметрыДенежногоПотока.Вставить("ДатаПереоценки",						 ?(ДатаОпределенияПотока = Неопределено, КонецДня(Дата), ДатаОпределенияПотока));
	ПараметрыДенежногоПотока.Вставить("ОбъединятьПотокиПоПериоду",			 Ложь);	
	ПараметрыДенежногоПотока.Вставить("УчитыватьКупонКОферте",				 НастройкиУчетаЦеннойБумаги.УчитыватьКупонКОферте);
	ПараметрыДенежногоПотока.Вставить("НеУчитыватьРешенияКлиентовПоПотокам", НЕ УчитыватьРешенияКлиентов);
	ПараметрыДенежногоПотока.Вставить("ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона", НастройкиУчетаЦеннойБумаги.ПриравниватьДатуОфертыКДатеБлижайшегоПредшествующегоКупона);
	
	ПараметрыОценки = Новый Структура;
	ПараметрыОценки.Вставить("Организация",							Организация);
	ПараметрыОценки.Вставить("Клиент",								Клиент);
	ПараметрыОценки.Вставить("ВариантРасчетаОценочнойСтоимости",	НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
	ПараметрыОценки.Вставить("СчетДоверительногоУправления", 		СчетДоверительногоУправления);
	Если Партия <> Неопределено И СтрокаПартии <> Неопределено Тогда
		ПараметрыОценки.Вставить("Партия", 							Партия);
		ПараметрыОценки.Вставить("СтрокаПартии", 					СтрокаПартии);
	КонецЕсли;
	
	ДенежныйПоток = Справочники.Облигации.ПолучитьДенежныйПоток(ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, Отказ, РасшифровкаРасчета);
	
	Если Отказ Тогда
		
		Возврат Неопределено;	
		
	Иначе	
		
		ДенежныйПоток.Колонки.Дата.Имя	= "ДатаПотока";
		ДенежныйПоток.Колонки.Поток.Имя	= "СуммаПотока";
		
		Возврат ДенежныйПоток;
		
	КонецЕсли;	
	
КонецФункции
