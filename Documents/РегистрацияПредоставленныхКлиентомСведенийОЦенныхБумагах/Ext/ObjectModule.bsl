
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЭтотОбъект.ПометкаУдаления Тогда	
	
		// Дата начала действия не должна быть раньше даты документа
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Дата)
			И ЗначениеЗаполнено(ЭтотОбъект.ДатаНачалаДействия)
			И НачалоДня(ЭтотОбъект.ДатаНачалаДействия) < НачалоДня(ЭтотОбъект.Дата) 
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала действия сведений не должна быть раньше даты документа", ЭтотОбъект, "ДатаНачалаДействия", , Отказ);
		КонецЕсли;
		
		// Дата окончания действия аналога не должна быть раньше даты начала действия
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ДатаНачалаДействия) Тогда
			Для Каждого СтрокаАналога Из ЭтотОбъект.Аналоги Цикл
				Если ЗначениеЗаполнено(СтрокаАналога.ДатаОкончанияДействия)
					И СтрокаАналога.ДатаОкончанияДействия < ЭтотОбъект.ДатаНачалаДействия
				Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Строка %1: дата окончания действия аналога не должна быть раньше даты начала действия", СтрокаАналога.НомерСтроки), ЭтотОбъект, "Аналоги[" + Формат(СтрокаАналога.НомерСтроки - 1, "ЧГ=0") + "].ДатаОкончанияДействия", , Отказ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Ценная бумага нужна для сведений об ЭСП, настройках и аналогах
		
		Если ЭтотОбъект.ЭСП.Количество() > 0
			ИЛИ ЭтотОбъект.НастройкиУчета.Количество() > 0
			ИЛИ ЭтотОбъект.Аналоги.Количество() > 0
		Тогда
			ПроверяемыеРеквизиты.Добавить("ЦеннаяБумага");	
		КонецЕсли;
		
		// Проверка соответствия клиента и организации данным партий
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТабличнаяЧастьЭСП.Партия КАК Партия,
			|	ТабличнаяЧастьЭСП.НомерСтроки КАК НомерСтроки
			|ПОМЕСТИТЬ _ТабличнаяЧастьЭСП
			|ИЗ
			|	&ТабличнаяЧастьЭСП КАК ТабличнаяЧастьЭСП
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТабличнаяЧастьЭСП.Партия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ТабличнаяЧастьЭСП.Партия.Организация КАК Организация,
			|	_ТабличнаяЧастьЭСП.Партия КАК Партия,
			|	_ТабличнаяЧастьЭСП.НомерСтроки КАК НомерСтроки
			|ПОМЕСТИТЬ _СчетаДоверительногоУправленияПартий
			|ИЗ
			|	_ТабличнаяЧастьЭСП КАК _ТабличнаяЧастьЭСП
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СчетаДоверительногоУправленияПартий.Партия КАК Партия,
			|	_СчетаДоверительногоУправленияПартий.НомерСтроки КАК НомерСтроки
			|ПОМЕСТИТЬ _ОшибкиСоответствияКлиентаПартии
			|ИЗ
			|	_СчетаДоверительногоУправленияПартий КАК _СчетаДоверительногоУправленияПартий
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|				&Период,
			|				СчетДоверительногоУправления В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						_СчетаДоверительногоУправленияПартий.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДоверительногоУправленияПартий)) КАК КлиентыДоверительногоУправления
			|		ПО (КлиентыДоверительногоУправления.СчетДоверительногоУправления = _СчетаДоверительногоУправленияПартий.СчетДоверительногоУправления)
			|			И (КлиентыДоверительногоУправления.Клиент <> &Клиент)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СчетаДоверительногоУправленияПартий.Партия КАК Партия,
			|	_СчетаДоверительногоУправленияПартий.НомерСтроки КАК НомерСтроки
			|ПОМЕСТИТЬ _ОшибкиСоответствияОрганизацииПартии
			|ИЗ
			|	_СчетаДоверительногоУправленияПартий КАК _СчетаДоверительногоУправленияПартий
			|ГДЕ
			|	_СчетаДоверительногоУправленияПартий.Организация <> &Организация");
		
		Запрос.УстановитьПараметр("ТабличнаяЧастьЭСП",	ЭтотОбъект.ЭСП.Выгрузить());
		Запрос.УстановитьПараметр("Клиент",				ЭтотОбъект.Клиент);
		Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период",				ЭтотОбъект.Дата);
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Выполнить();

		ОшибкаСоответствияКлиентаПартии = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСоответствияКлиентаПартии"].ПолучитьДанные().Выбрать();
		
		Пока ОшибкаСоответствияКлиентаПартии.Следующий() Цикл
			ТекстОшибки = СтрШаблон("В строке %1 выбрана партия другого клиента д/у", ОшибкаСоответствияКлиентаПартии.НомерСтроки);
			ПолеОшибки	= "ЭСП[" + Формат(ОшибкаСоответствияКлиентаПартии.НомерСтроки - 1, "ЧГ=") + "].Партия";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПолеОшибки, , Отказ);
		КонецЦикла;
		
		ОшибкаСоответствияОрганизацииПартии = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСоответствияОрганизацииПартии"].ПолучитьДанные().Выбрать();
		
		Пока ОшибкаСоответствияОрганизацииПартии.Следующий() Цикл
			ТекстОшибки = СтрШаблон("В строке %1 выбрана партия другой организации", ОшибкаСоответствияОрганизацииПартии.НомерСтроки);
			ПолеОшибки	= "ЭСП[" + Формат(ОшибкаСоответствияОрганизацииПартии.НомерСтроки - 1, "ЧГ=") + "].Партия";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПолеОшибки, , Отказ);
		КонецЦикла;		

	КонецЕсли;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// ЭСП 
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТабличнаяЧастьЭСП.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТабличнаяЧастьЭСП.Партия КАК Партия,
		|	ТабличнаяЧастьЭСП.СтрокаПартии КАК СтрокаПартии,
		|	ТабличнаяЧастьЭСП.ЭСП КАК ЭСП,
		|	ТабличнаяЧастьЭСП.Используется КАК Используется
		|ПОМЕСТИТЬ _ТабличнаяЧастьЭСП
		|ИЗ
		|	&ТабличнаяЧастьЭСП КАК ТабличнаяЧастьЭСП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТабличнаяЧастьЭСП.Партия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТабличнаяЧастьЭСП.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ТабличнаяЧастьЭСП.Партия КАК Партия,
		|	_ТабличнаяЧастьЭСП.СтрокаПартии КАК СтрокаПартии,
		|	_ТабличнаяЧастьЭСП.ЭСП КАК ЭСП,
		|	_ТабличнаяЧастьЭСП.Используется КАК Используется
		|ИЗ
		|	_ТабличнаяЧастьЭСП КАК _ТабличнаяЧастьЭСП");
	
	Запрос.УстановитьПараметр("ТабличнаяЧастьЭСП", ЭтотОбъект.ЭСП.Выгрузить());
	
	ВыборкаЭСП = Запрос.Выполнить().Выбрать();
	
	Движения.РешенияКлиентовПоЗначениямЭСП.Очистить();
	Движения.РешенияКлиентовПоЗначениямЭСП.Записывать = Истина;
	
	Пока ВыборкаЭСП.Следующий() Цикл
		
		Движение = Движения.РешенияКлиентовПоЗначениямЭСП.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаЭСП);
		
		Движение.Период				= ЭтотОбъект.Дата;
		Движение.Организация		= ЭтотОбъект.Организация;
		Движение.Рынок				= Перечисления.РынкиЦенныхБумаг.Облигации;
		Движение.ЦеннаяБумага		= ЭтотОбъект.ЦеннаяБумага;
		Движение.ДатаНачалаДействия	= ЭтотОбъект.ДатаНачалаДействия;
		
	КонецЦикла;

	// Аналоги ценой бумаги
	
	Движения.АналогиЦенныхБумаг.Очистить();
	Движения.АналогиЦенныхБумаг.Записывать = Истина;
	
	Для Каждого СтрокаАналоги Из ЭтотОбъект.Аналоги Цикл
		
		Движение = Движения.АналогиЦенныхБумаг.Добавить();
		
		Движение.Период					= ЭтотОбъект.ДатаНачалаДействия;
		Движение.Организация			= ЭтотОбъект.Организация;
		Движение.Клиент					= ЭтотОбъект.Клиент;
		Движение.ЦеннаяБумага			= ЭтотОбъект.ЦеннаяБумага;
		Движение.Аналог					= СтрокаАналоги.ЦеннаяБумага;
		Движение.Назначение				= СтрокаАналоги.Назначение;
		Движение.ДатаОкончанияДействия	= СтрокаАналоги.ДатаОкончанияДействия;
		
	КонецЦикла;

	// Настройки
	
	Движения.ЗначенияНастроекУчетаЦенныхБумаг.Очистить();
	Движения.ЗначенияНастроекУчетаЦенныхБумаг.Записывать = Истина;
	
	Для каждого СтрокаНастройки Из ЭтотОбъект.НастройкиУчета Цикл
	
		Движение = Движения.ЗначенияНастроекУчетаЦенныхБумаг.Добавить();
		
		Движение.Период							= ЭтотОбъект.Дата;
		
		Движение.Организация					= ЭтотОбъект.Организация;
		Движение.Клиент							= ЭтотОбъект.Клиент;
		Движение.УчетныйАктивЕПС				= СтрокаНастройки.УчетныйАктивЕПС;
		Движение.Рынок							= Перечисления.РынкиЦенныхБумаг.Облигации;
		Движение.ЦеннаяБумага					= ЭтотОбъект.ЦеннаяБумага;
		Движение.Партия							= СтрокаНастройки.Партия;
		Движение.СтрокаПартии					= СтрокаНастройки.СтрокаПартии;
		Движение.Настройка						= СтрокаНастройки.Настройка;
		
		Движение.ЗначениеНастройки				= СтрокаНастройки.ЗначениеНастройки;
		Движение.Отключить						= СтрокаНастройки.Отключить;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Заполняем тип сведений
	
	МассивСведений = Новый Массив;
	
	Если ЭтотОбъект.Аналоги.Количество() > 0 Тогда
		МассивСведений.Добавить("Аналоги");
	КонецЕсли;
	Если ЭтотОбъект.ЭСП.Количество() > 0 Тогда
		МассивСведений.Добавить("ЭСП");
	КонецЕсли;
	Если ЭтотОбъект.НастройкиУчета.Количество() > 0 Тогда
        //настройки развернем, покажем какие именно настройки есть в документе 
		КоличествоНастроек = 0;
		Для Каждого СтрокаТЧНастройкиУчета из ЭтотОбъект.НастройкиУчета Цикл
			НаименованиеНастройки = Строка(СтрокаТЧНастройкиУчета.Настройка); 
			Если МассивСведений.Найти(НаименованиеНастройки) = Неопределено Тогда
				МассивСведений.Добавить(НаименованиеНастройки); 
				КоличествоНастроек = КоличествоНастроек + 1;
			КонецЕсли;  
		КонецЦикла;   
	КонецЕсли;
	
	СтрокаТипСведений = СтрСоединить(МассивСведений, ", ");  
	Если СтрДлина(СтрокаТипСведений) > 100 Тогда
		//завершаем строку всегда настройками. Поэтому, если строка слишком длинная, показываем в конце количество настроек 
		ЗавершениеСтроки = "...(" + Формат(КоличествоНастроек, "ЧГ=0") + ")";
		СтрокаТипСведений = Лев(СтрокаТипСведений, 100 - СтрДлина(ЗавершениеСтроки)) + ЗавершениеСтроки;
	КонецЕсли;
	
	ЭтотОбъект.ТипСведений = СтрокаТипСведений; 
	
	// Блокирующие проверки
	
	Если ЭтотОбъект.Дата < '20251105' Тогда // ВРЕМЕННО!!! нужно для слияния НПФов - сдвигаем дату, скоро еще одно слияние
		Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Общие процедуры перед записью

	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти
