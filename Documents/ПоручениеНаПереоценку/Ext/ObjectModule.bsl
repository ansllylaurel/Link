
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ДобавитьДвижениеПорученияНаПереоценку(ВидАктива, Рынок = Неопределено, ЦеннаяБумага = Неопределено)

	Движение = Движения.ПорученияНаПереоценку.Добавить();
	
	Движение.Организация					= ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
	Если Рынок = Неопределено Тогда
		Движение.Рынок						= ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ПустаяСсылка");
	Иначе
		Движение.Рынок						= Рынок;
	КонецЕсли;
	Движение.ЦеннаяБумага					= ЦеннаяБумага;
	Движение.ДатаПереоценки					= НачалоДня(ЭтотОбъект.Дата);
	Движение.ВидУчета						= ЭтотОбъект.ВидУчета;
	Движение.ВидАктива						= ВидАктива;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ПорученияНаПереоценку.Записывать = Истина;
	Движения.ПорученияНаПереоценку.Очистить();
	
	Если ЭтотОбъект.ПереоцениватьЦенныеБумаги Тогда
		Если ЭтотОбъект.ЦенныеБумаги.Количество() = 0 Тогда
			ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.ЦенныеБумаги);
		Иначе	
			Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
				ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.ЦенныеБумаги, СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ЭтотОбъект.ПереоцениватьЗадолженности Тогда
		ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.Задолженность);
	КонецЕсли;
	Если ЭтотОбъект.ПереоцениватьДепозиты Тогда
		ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.ДепозитныеВклады);
	КонецЕсли;
	Если ЭтотОбъект.ПереоцениватьМНО Тогда
		ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.МНО);
	КонецЕсли;
	Если ЭтотОбъект.ВосстанавливатьРезервПоРасчетнымБрокерскимИКлиринговымСчетам Тогда
		ДобавитьДвижениеПорученияНаПереоценку(Перечисления.ВидыАктивовДляПорученийНаПереоценку.РезервПоРасчетнымБрокерскимИКлиринговымСчетам);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьИзФайла(АдресФайла, Отказ) Экспорт

	ПутьКФайлу				= ПолучитьИмяВременногоФайла("xml");
	УдалитьФайлПослеЧтения	= Истина;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ДвоичныеДанные.Записать(ПутьКФайлу);
		
	
	МассивISIN = Новый Массив;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);

	ПостроительDOM	= Новый ПостроительDOM;
	ДокументDOM		= ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();

	Если УдалитьФайлПослеЧтения Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;	
	
	Элемент			= ДокументDOM.ЭлементДокумента;
	Разыменователь	= Новый РазыменовательПространствИменDOM(Элемент);
	ВыборкаXPath	= ДокументDOM.ВычислитьВыражениеXPath("//СправедливаяСтоимость[@Дата=""" + Формат(ЭтотОбъект.Дата, "ДФ=yyyy-MM-ddT00:00:00") + """]/ЦеннаяБумага", Элемент, Разыменователь);

	Пока Истина Цикл

		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли; 
		
		Для Каждого Узел Из ЭлементDOM.ДочерниеУзлы Цикл
			Если Узел.ИмяУзла = "ISIN" Тогда
				МассивISIN.Добавить(Узел.ТекстовоеСодержимое);
			КонецЕсли; 
		КонецЦикла; 
		
	КонецЦикла;
	
	Если МассивISIN.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке поручения на переоценку из файла клиента: не обнаружены данные на " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"),,,, Отказ);
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыВТорговыхСистемах.Объект КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ЦБизФайла
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах КАК КодыВТорговыхСистемах
		|ГДЕ
		|	КодыВТорговыхСистемах.ВидКода В (ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN), ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий))
		|	И КодыВТорговыхСистемах.Код В (&МассивISIN)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстатки.Рынок КАК Рынок
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЦБизФайла КАК _ЦБизФайла
		|		ПО ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = _ЦБизФайла.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("МассивISIN", МассивISIN);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	ЭтотОбъект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если ЭтотОбъект.ЦенныеБумаги.Количество() = 0 Тогда
		ЭтотОбъект.ПереоцениватьЦенныеБумаги = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
