&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.АдресРезультата 				= Параметры.АдресРезультата;
	ЭтаФорма.ПутьКФайлу 					= Параметры.ПутьКФайлу;
	ЭтаФорма.ПериодОтчета.ДатаНачала 		= Параметры.НачалоПериода;
	ЭтаФорма.ПериодОтчета.ДатаОкончания 	= Параметры.ОкончаниеПериода;
	
	ЭтаФорма.Разделитель = Символы.Таб + Символы.Таб;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеИзБуфераОбмена()
	
	COMОбъект = Новый COMОбъект("htmlfile");
	Возврат COMОбъект.ParentWindow.ClipboardData.Getdata("text");
	
КонецФункции

&НаКлиенте
Процедура ПолучитьПериодИзБуфераОбмена(Команда)
	
	Буфер = ПолучитьДанныеИзБуфераОбмена();
	
	Цифры = "1234567890.";
	Период = "";
	Для НомерСимвола = 1 По СтрДлина(Буфер) Цикл
		ТекущийСимвол = Сред(Буфер, НомерСимвола, 1);
		Если Найти(Цифры, ТекущийСимвол) Тогда
			Период = Период + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
	
		ЭтаФорма.ПериодОтчета.ДатаНачала = Дата(Лев(Период, 10) + " 00:00:00");
		ЭтаФорма.ПериодОтчета.ДатаОкончания = Дата(Прав(Период, 10) + " 00:00:00");		
	
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данных о периоде в буфере обмена не обнаружено");
		
	КонецПопытки; 
	
КонецПроцедуры

&НаКлиенте
Процедура Импортировать(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПериодОтчета) И ЭтаФорма.Сделки.Количество() > 0 Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ИмпортироватьЗавершение", ЭтаФорма), "Не заполнен период отчета, данные по сделкам импортированы не будут.", РежимДиалогаВопрос.ОКОтмена);
		Возврат;
		
	ИначеЕсли ЭтаФорма.Сделки.Количество() > 0 И ЭтаФорма.Движения.Количество() = 0 Тогда 			
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ИмпортироватьЗавершение", ЭтаФорма), "Внимание! Не заполнена таблица движений при наличии сделок.", РежимДиалогаВопрос.ОКОтмена);
		Возврат;
		
	Иначе
		Закрыть(ИмпортироватьНаСервере());
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		Закрыть(ИмпортироватьНаСервере());	
	КонецЕсли; 

КонецПроцедуры 

&НаСервере
Функция ИмпортироватьНаСервере()

	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ИнформацияОЦенныхБумагах", ЭтаФорма.ИнформацияОЦенныхБумагах.Выгрузить(, "КодАктива, Рынок, ЦеннаяБумага"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИнформацияОЦенныхБумагах.КодАктива КАК КодАктива,
		|	ИнформацияОЦенныхБумагах.Рынок КАК Рынок,
		|	ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ИнформацияОЦенныхБумагах
		|ИЗ
		|	&ИнформацияОЦенныхБумагах КАК ИнформацияОЦенныхБумагах";
	
	Запрос.Выполнить();
	
	Если ЭтаФорма.Сделки.Количество()>0 Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Сделки.ДатаСделки КАК ДатаСделки,
			|	Сделки.ВидСделкиСсылка КАК ВидСделки,
			|	Сделки.КодАктива КАК КодАктива,
			|	Сделки.Количество КАК Количество,
			|	Сделки.ЦенаЗаЕдиницу КАК Цена,
			|	Сделки.СуммаБезНКД КАК СуммаБезНКД,
			|	Сделки.НКД КАК НКД,
			|	Сделки.СтавкаРЕПО КАК СтавкаРЕПО
			|ПОМЕСТИТЬ _СделкиВсе
			|ИЗ
			|	&Сделки КАК Сделки
			|ГДЕ
			|	Сделки.ДатаСделки МЕЖДУ &ДатаНачала И &ДатаОкончания
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СделкиВсе.ДатаСделки КАК ДатаСделки,
			|	_СделкиВсе.ВидСделки КАК ВидСделки,
			|	_ИнформацияОЦенныхБумагах.Рынок КАК Рынок,
			|	_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
			|	КОНЕЦ КАК ЮрФизЛицо,
			|	_СделкиВсе.Количество КАК Количество,
			|	_СделкиВсе.Цена КАК Цена,
			|	_СделкиВсе.СуммаБезНКД КАК СуммаБезНКД,
			|	_СделкиВсе.НКД КАК НКД,
			|	_СделкиВсе.СтавкаРЕПО КАК СтавкаРЕПО
			|ПОМЕСТИТЬ _Сделки
			|ИЗ
			|	_СделкиВсе КАК _СделкиВсе
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнформацияОЦенныхБумагах КАК _ИнформацияОЦенныхБумагах
			|		ПО _СделкиВсе.КодАктива = _ИнформацияОЦенныхБумагах.КодАктива
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
			|		ПО (_ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РЫнкиЦенныхБумаг.Паи))
			|			И (ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)";
		
		Запрос.УстановитьПараметр("Сделки", ЭтаФорма.Сделки.Выгрузить(, "ДатаСделки, ВидСделкиСсылка, КодАктива, Количество, ЦенаЗаЕдиницу, СуммаБезНКД, НКД, СтавкаРЕПО"));
		Запрос.УстановитьПараметр("ДатаНачала", ЭтаФорма.ПериодОтчета.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ЭтаФорма.ПериодОтчета.ДатаОкончания);
		
		Запрос.Выполнить();
		ТаблицаСделки = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Сделки");
		
		Если ТаблицаСделки <> Неопределено Тогда
			Результат.Вставить("Сделки", ТаблицаСделки.ПолучитьДанные().Выгрузить());
		КонецЕсли;
		
		ТаблицаСделкиСВалютой = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СделкиСВалютой");
		
		Если ТаблицаСделкиСВалютой <> Неопределено Тогда
			Результат.Вставить("СделкиСВалютой", ТаблицаСделкиСВалютой.ПолучитьДанные().Выгрузить());
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЭтаФорма.Движения.Количество()>0 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Движения.КодАктива КАК КодАктива,
			|	Движения.ВходящийОстаток КАК НачальныйОстаток,
			|	Движения.Зачисление КАК Приход,
			|	Движения.Списание КАК Расход,
			|	Движения.ИсходящийОстаток КАК КонечныйОстаток
			|ПОМЕСТИТЬ _Движения
			|ИЗ
			|	&Движения КАК Движения
			|ГДЕ
			|	Движения.ВходящийОстаток + Движения.Зачисление + Движения.Списание + Движения.ИсходящийОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ИнформацияОЦенныхБумагах.Рынок КАК Рынок,
			|	_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
			|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
			|		КОГДА _ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|			ТОГДА ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
			|	КОНЕЦ КАК ЮрФизЛицо,
			|	_Движения.НачальныйОстаток КАК НачальныйОстаток,
			|	_Движения.Приход КАК Приход,
			|	_Движения.Расход КАК Расход,
			|	_Движения.КонечныйОстаток КАК КонечныйОстаток
			|ИЗ
			|	_Движения КАК _Движения
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнформацияОЦенныхБумагах КАК _ИнформацияОЦенныхБумагах
			|		ПО _Движения.КодАктива = _ИнформацияОЦенныхБумагах.КодАктива
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних КАК РеквизитыПИФСрезПоследних
			|		ПО (_ИнформацияОЦенныхБумагах.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
			|			И (ВЫРАЗИТЬ(_ИнформацияОЦенныхБумагах.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)";
		
		Запрос.УстановитьПараметр("Движения", ЭтаФорма.Движения.Выгрузить());
		Результат.Вставить("ОбъектыИнвестирования", Запрос.Выполнить().Выгрузить());
		
	КонецЕсли; 
	
	Результат.Вставить("НачалоПериода", ПериодОтчета.ДатаНачала);
	Результат.Вставить("ОкончаниеПериода", ПериодОтчета.ДатаОкончания);
	
	Возврат ПоместитьВоВременноеХранилище(Результат, ЭтаФорма.АдресРезультата);

КонецФункции

&НаКлиенте
Процедура ИмяФайлаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Файл = Новый Файл(ПутьКФайлу);
	Если Файл.Существует() Тогда
		ЗапуститьПриложение(ПутьКФайлу);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл не обнаружен");
	КонецЕсли;
	
КонецПроцедуры

#Область Сделки

&НаКлиенте
Процедура ОбработатьСтрокуСделок(Команда)
	
	ЭтаФорма.СделкиСтрока = СтрЗаменить(ЭтаФорма.СделкиСтрока, " ", ЭтаФорма.Разделитель);
	
	МассивСтрок = СтрРазделить(ЭтаФорма.СделкиСтрока, Символы.ПС);
	
	Индекс = МассивСтрок.ВГраница();
	Пока Индекс >= 0 Цикл
		
		ЗначенияКолонок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(МассивСтрок[Индекс], ЭтаФорма.Разделитель);
		
		//Пока ЗначенияКолонок.Количество() < 20 Цикл
		//	// тут вклинился перенос строки, объединяем с предыдущей строкой
		//	МассивСтрок.Удалить(Индекс);
		//	Индекс = Индекс - 1;
		//	
		//	ЗначенияКолонокПредыдущейСтроки = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(МассивСтрок[Индекс], ЭтаФорма.Разделитель);
		//	Для ИндексПредыдущей = -ЗначенияКолонокПредыдущейСтроки.ВГраница() По 0 Цикл
		//		ЗначенияКолонок.Вставить(0, ЗначенияКолонокПредыдущейСтроки[-ИндексПредыдущей]);
		//	КонецЦикла; 
		//	
		//КонецЦикла; 
		
		// 7 - Наименование
		// 8 - Код
		// 9 - Цена
		
		Для ИндексКолонкиЦена = 9 По ЗначенияКолонок.ВГраница() Цикл
		
			Значение = ЗначенияКолонок[ИндексКолонкиЦена];
			Если РаботаСоСтрокамиКлиентСервер.СтрокаСодержитТолькоДопустимыеСимволы(Значение, "0123456789,") Тогда
			
				Прервать;
			
			КонецЕсли; 
			
		КонецЦикла; 
		
		ИндексКолонкиНаименование = ИндексКолонкиЦена-2;
		Пока ИндексКолонкиНаименование > 7 Цикл
		
			ЗначенияКолонок[ИндексКолонкиНаименование-1] = ЗначенияКолонок[ИндексКолонкиНаименование-1] + " " + ЗначенияКолонок[ИндексКолонкиНаименование];
			ЗначенияКолонок.Удалить(ИндексКолонкиНаименование);
			ИндексКолонкиНаименование = ИндексКолонкиНаименование - 1;
		
		КонецЦикла;
		
		МассивСтрок[Индекс] = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЗначенияКолонок, ЭтаФорма.Разделитель);
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	ЭтаФорма.СделкиСтрока = СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСделки(Команда)
	
	ЗаполнитьТаблицуНаСервере("Сделки");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСделки(Команда)
	
	ПроверитьТаблицу("Сделки");
	
КонецПроцедуры

#КонецОбласти 

#Область Движения

&НаКлиенте
Процедура ОбработатьСтрокуДвижений(Команда)
	
	ЭтаФорма.ДвиженияСтрока = СтрЗаменить(ЭтаФорма.ДвиженияСтрока, "Тинькофф Банк", "Тинькофф_Банк");
	ЭтаФорма.ДвиженияСтрока = СтрЗаменить(ЭтаФорма.ДвиженияСтрока, " ", ЭтаФорма.Разделитель);
	
	МассивСтрок = СтрРазделить(ЭтаФорма.ДвиженияСтрока, Символы.ПС);
	
	Индекс = МассивСтрок.ВГраница();
	Пока Индекс >= 0 Цикл
		
		ЗначенияКолонок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(МассивСтрок[Индекс], ЭтаФорма.Разделитель);
		
		// 0 - Наименование
		// 1 - Код
		// 2 - Место хранения
		
		Для ИндексКолонкиЦена = 2 По ЗначенияКолонок.ВГраница() Цикл
		
			Если ЗначенияКолонок[ИндексКолонкиЦена] = "Тинькофф_Банк" Тогда
				Прервать;
			КонецЕсли; 
			
		КонецЦикла; 
		
		ИндексКолонкиНаименование = ИндексКолонкиЦена-2;
		Пока ИндексКолонкиНаименование > 0 Цикл
		
			ЗначенияКолонок[ИндексКолонкиНаименование-1] = ЗначенияКолонок[ИндексКолонкиНаименование-1] + " " + ЗначенияКолонок[ИндексКолонкиНаименование];
			ЗначенияКолонок.Удалить(ИндексКолонкиНаименование);
			ИндексКолонкиНаименование = ИндексКолонкиНаименование - 1;
		
		КонецЦикла;
		
		МассивСтрок[Индекс] = РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЗначенияКолонок, ЭтаФорма.Разделитель);
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	ЭтаФорма.ДвиженияСтрока = СтрСоединить(МассивСтрок, Символы.ПС);
	ЭтаФорма.ДвиженияСтрока = СтрЗаменить(ЭтаФорма.ДвиженияСтрока, "Тинькофф_Банк", "Тинькофф Банк");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДвижения(Команда)
	ЗаполнитьТаблицуНаСервере("Движения");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДвижения(Команда)
	
	ПроверитьТаблицу("Движения");
	
КонецПроцедуры

#КонецОбласти 

#Область Информация_о_ЦБ

&НаКлиенте
Процедура ОбработатьСтрокуИнформацииОЦБ(Команда)
	
	Если ЭтаФорма.Движения.Количество() = 0 Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для обработки информации о ценных бумагах сначала необходимо заполнить данные по остаткам и движениям ценных бумаг");
		Возврат;
	
	КонецЕсли; 
	
	СтрокаДляОбработки = СтрЗаменить(ЭтаФорма.ИнформацияОЦенныхБумагахСтрока, Символы.ПС, " ");
	СписокСтрок = Новый СписокЗначений;
	
	Для каждого СтрокаДвижения Из ЭтаФорма.Движения Цикл
		
		Идентификатор = СтрокаДвижения.СокращенноеНаименованиеАктива + " " + СтрокаДвижения.КодАктива;
		НачалоСтроки = СтрНайти(СтрокаДляОбработки, Идентификатор);
		
		Если НачалоСтроки > 0 Тогда
			
			ISIN = Сред(СтрокаДляОбработки, НачалоСтроки + СтрДлина(Идентификатор) + 1, 12);
			Строка = СтрокаДвижения.СокращенноеНаименованиеАктива + Разделитель + СтрокаДвижения.КодАктива + Разделитель + ISIN; 
			СписокСтрок.Добавить(Строка, Формат(НачалоСтроки, "ЧЦ=4; ЧН=0; ЧВН=; ЧГ="));
		
		КонецЕсли;		
				
	КонецЦикла;
	
	СписокСтрок.СортироватьПоПредставлению();
	ЭтаФорма.ИнформацияОЦенныхБумагахСтрока = СтрСоединить(СписокСтрок.ВыгрузитьЗначения(), Символы.ПС);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнформациюОЦенныхБумагах(Команда)
	
	ЗаполнитьТаблицуНаСервере("ИнформацияОЦенныхБумагах");
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПроверитьИнформациюОЦенныхБумагах(Команда)
	
	ПроверитьТаблицу("ИнформацияОЦенныхБумагах");
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ПолучитьВалюту(Представление, Валюты) 

	ВременнаяСтруктура = Новый Структура;
	Попытка
		// Проверка на то, что Представление является допустимым идентификатором.
		ВременнаяСтруктура.Вставить(Представление);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Валюта = Неопределено;
	Если Не Валюты.Свойство(Представление, Валюта) Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Валюты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Валюты КАК Валюты
			|ГДЕ
			|	Валюты.Наименование = &Наименование";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Наименование", Представление);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Валюта = Выборка.Ссылка;
			Валюты.Вставить(Представление, Валюта);
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат Валюта;

КонецФункции
 
&НаСервере
Функция ПолучитьСтруктуруЦБ(КодАктива, ЦенныеБумаги) 

	ВременнаяСтруктура = Новый Структура;
	Попытка
		// Проверка на то, что Представление является допустимым идентификатором.
		ВременнаяСтруктура.Вставить(КодАктива);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ЦБ = Неопределено;
	Если Не ЦенныеБумаги.Свойство(КодАктива, ЦБ) Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыВТорговыхСистемахСрезПоследних.Объект КАК Объект
			|ИЗ
			|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
			|			&Период,
			|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
			|				И Код = &Код) КАК КодыВТорговыхСистемахСрезПоследних";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Период", ЭтаФорма.ПериодОтчета.ДатаОкончания);
		Запрос.УстановитьПараметр("Код", КодАктива);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЦБ = Новый Структура("Рынок, ЦеннаяБумага", 
				РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(Выборка.Объект), 
				Выборка.Объект) ;
			ЦенныеБумаги.Вставить(КодАктива, ЦБ);
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат ЦБ;

КонецФункции

&НаКлиенте
Процедура ПроверитьТаблицу(Таблица)

	ВысотаТаблицы = ЭтаФорма[Таблица + "ТабДок"].ВысотаТаблицы;
	Если ВысотаТаблицы > 0 Тогда
		
		ОчиститьСообщения();
		ПроверитьТаблицуНаСервере(Таблица);
	
	КонецЕсли;

КонецПроцедуры
 
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКолонкиТаблицы(Таблица)

	Если Таблица = "Сделки" Тогда
	
		Колонки = СтрРазделить("НомерСделки,НомерПоручения,ДатаЗаключения,Время,ТорговаяПлощадка,РежимТоргов,ВидСделки,СокращенноеНаименованиеАктива," + 
			"КодАктива,ЦенаЗаЕдиницу,ВалютаЦены,Количество,СуммаБезНКД,НКД,СуммаСделки,ВалютаРасчетов,КомиссияБрокера,ВалютаКомиссии,КомиссияБиржи," + 
			"ВалютаКомиссииБиржи,КомиссияКлиринговогоЦентра,ВалютаКомисииКлиринговогоЦентра,СтавкаРЕПО,Контрагент,ДатаРасчетов,ДатаПоставки,СтатусБрокера," + 
			"ТипДоговора,НомерДоговора,ДатаДоговора", ",", Ложь);
		
	ИначеЕсли Таблица = "Движения" Тогда 
		
		Колонки = СтрРазделить("СокращенноеНаименованиеАктива,КодАктива,МестоХранения,ВходящийОстаток,Зачисление,Списание,ИсходящийОстаток," +
			"ПлановыйИсходящийОстаток,РыночнаяЦена,ВалютаЦены,НКД,РыночнаяСтоимость", ",", Ложь);
		
	Иначе
		
		Колонки = СтрРазделить("СокращенноеНаименованиеАктива,КодАктива,ISIN", ",", Ложь);
		
	КонецЕсли;
	
	Возврат Колонки;

КонецФункции
 
&НаСервере
Процедура ЗаполнитьТаблицуНаСервере(Таблица)
	
	ЭтаФорма[Таблица + "ТабДок"].Очистить();
	
	Макет = Документы.СведенияПредоставляемыеЮрФизЛицами.ПолучитьМакет("МакетИмпортаТинькофф");
	ОбластьШапка = Макет.ПолучитьОбласть(Таблица + "Шапка");
	
	ЭтаФорма[Таблица + "ТабДок"].Вывести(ОбластьШапка);
	
	Колонки = ПолучитьКолонкиТаблицы(Таблица);
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(ЭтаФорма[Таблица + "Строка"]) Цикл
	
		ОбластьСтрока = Макет.ПолучитьОбласть(Таблица + "Строка");
		
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		ЗначенияКолонок = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрПолучитьСтроку(ЭтаФорма[Таблица + "Строка"], НомерСтроки), Разделитель, Ложь);
		
		Для Индекс = 0 По ЗначенияКолонок.ВГраница() Цикл
		
			ОбластьСтрока.Параметры[Колонки[Индекс]] = ЗначенияКолонок[Индекс];
			
		КонецЦикла;
		
		ЭтаФорма[Таблица + "ТабДок"].Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ПроверитьТаблицуНаСервере(Таблица);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьТаблицуНаСервере(Таблица)

	Валюты = Новый Структура;
	ЦенныеБумаги = Новый Структура;
	
	Колонки = ПолучитьКолонкиТаблицы(Таблица);
	Колонки.Вставить(0, "НомерСтроки");

	КолонкиТаблицы = ЭтаФорма[Таблица].Выгрузить().Колонки;
	ЕстьОшибки = Ложь;
	ЭтаФорма[Таблица].Очистить();

	Для НомерСтроки = 4 По ЭтаФорма[Таблица + "ТабДок"].ВысотаТаблицы Цикл

		СтрокаТаблицы = ЭтаФорма[Таблица].Добавить();
		
		Для каждого КолонкаТаблицы Из КолонкиТаблицы Цикл
		
			НомерКолонки = Колонки.Найти(КолонкаТаблицы.Имя);
			Если НомерКолонки <> Неопределено Тогда
				
				Значение = ЭтаФорма[Таблица + "ТабДок"].Область(НомерСтроки, НомерКолонки + 1, НомерСтроки, НомерКолонки + 1).Текст;
				ЗначениеСсылка = Неопределено;
				
				Если Значение = "" Тогда
					Продолжить;
				КонецЕсли; 
				
				Отказ = Ложь;
				
				Если СтрНачинаетсяС(КолонкаТаблицы.Имя, "Дата") Тогда
				
					ЗначениеДата = КолонкаТаблицы.ТипЗначения.ПривестиЗначение(Значение + " 00:00:00");
					Отказ = (Формат(ЗначениеДата, "ДФ=dd.MM.yyyy") <> Значение);
					Значение = ЗначениеДата;
					
				ИначеЕсли КолонкаТаблицы.Имя = "Время" Тогда
				
					ЗначениеВремя = КолонкаТаблицы.ТипЗначения.ПривестиЗначение("01.01.0001 " + Значение);
					Отказ = (Формат(ЗначениеВремя, "ДЛФ=T") <> Значение);
					Значение = ЗначениеВремя;
					
					СтрокаТаблицы.ДатаСделки = СтрокаТаблицы.ДатаЗаключения + (Значение - '00010101');
					
				ИначеЕсли КолонкаТаблицы.Имя = "ВидСделки" Тогда
				
					Попытка
						ЗначениеСсылка = Перечисления.ВидыСделок[Значение];
					Исключение
						Отказ = Истина
					КонецПопытки;
									
				ИначеЕсли СтрНачинаетсяС(КолонкаТаблицы.Имя, "Валюта") И ЗначениеЗаполнено(Значение) Тогда
				
					ЗначениеСсылка = ПолучитьВалюту(Значение, Валюты);
					Отказ = (ЗначениеСсылка = Неопределено);
					
				ИначеЕсли КолонкаТаблицы.Имя = "ISIN" Тогда
				
					СтруктураЦБ = ПолучитьСтруктуруЦБ(Значение, ЦенныеБумаги);
					Если СтруктураЦБ <> Неопределено Тогда
						СтрокаТаблицы.Рынок = СтруктураЦБ.Рынок;
						СтрокаТаблицы.ЦеннаяБумага = СтруктураЦБ.ЦеннаяБумага;
						ЭтаФорма[Таблица + "ТабДок"].Область(НомерСтроки, НомерКолонки + 2, НомерСтроки, НомерКолонки + 2).Текст = СтруктураЦБ.Рынок;
						ЭтаФорма[Таблица + "ТабДок"].Область(НомерСтроки, НомерКолонки + 3, НомерСтроки, НомерКолонки + 3).Текст = СтруктураЦБ.ЦеннаяБумага;
					Иначе
						Отказ = Истина;
					КонецЕсли; 
				
				ИначеЕсли КолонкаТаблицы.ТипЗначения.СодержитТип(Тип("Число")) Тогда 
					
					Значение = СтрЗаменить(СтрЗаменить(Значение, ".", ","), " ", "");
					ЗначениеЧисло = КолонкаТаблицы.ТипЗначения.ПривестиЗначение(Значение);
					Отказ = (Формат(ЗначениеЧисло, "ЧН=0; ЧГ=") <> Значение);
					Значение = ЗначениеЧисло;
					
				КонецЕсли;
				
				Если Отказ Тогда
					ТекстСообщения = СтрШаблон("Не удалось определеить значение колонки '%1' в строке №%2", КолонкаТаблицы.Имя, НомерСтроки - 3);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ЕстьОшибки = Истина;
				КонецЕсли;
				
				СтрокаТаблицы[КолонкаТаблицы.Имя] = Значение;
				
				Если ЗначениеЗаполнено(ЗначениеСсылка) Тогда
					СтрокаТаблицы[КолонкаТаблицы.Имя + "Ссылка"] = ЗначениеСсылка;
				КонецЕсли; 
				
			КонецЕсли; 
		
		КонецЦикла; 
		
	КонецЦикла;	
	
	ЭтаФорма[Таблица + "ПроверкаВыполнена"] = Не ЕстьОшибки;
	
	Если ЕстьОшибки Тогда
		
		Элементы["Страница" + Таблица].Картинка = БиблиотекаКартинок.ОформлениеЗнакКрест;
		
	Иначе
		
		Элементы["Страница" + Таблица].Картинка = БиблиотекаКартинок.ОформлениеЗнакФлажок;
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибок не обнаружено");
	
	КонецЕсли;

КонецПроцедуры

