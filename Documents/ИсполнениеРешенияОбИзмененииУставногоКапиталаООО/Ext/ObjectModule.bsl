Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумаг");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",  						Перечисления.РынкиЦенныхБумаг.Доли);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",  				ЭтотОбъект.Доля);
	
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагам");

	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("Основание",  					ЭтотОбъект.Основание);
	ЭлементБлокировкиДанных.УстановитьЗначение("ВидЗадолженности",  			Справочники.ВидыЗадолженности.ПоВкладуВУставныйКапиталООО);
	ЭлементБлокировкиДанных.УстановитьЗначение("Рынок",  						Перечисления.РынкиЦенныхБумаг.Доли);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",  				ЭтотОбъект.Доля);
	
	
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

Функция ПолучитьТекущийРазмерДоли()
	
	//проверим изменился ли размер доли
	ТекущийРазмерДоли = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Дата,
		|			Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли)
		|				И ЦеннаяБумага = &ЦеннаяБумага
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиЦенныхБумагОстатки";
	
	Запрос.УстановитьПараметр("Дата", Новый Граница(ЭтотОбъект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.Доля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ТекущийРазмерДоли = ВыборкаДетальныеЗаписи.КоличествоОстаток;
	КонецЕсли;
	
	Возврат ТекущийРазмерДоли;
	
КонецФункции

Процедура СформироватьДвиженияПоОперациямСЦеннымиБумагами(ТекущийРазмерДоли)
	
	Если ЭтотОбъект.Основание.СуммаОплаты <> 0
		ИЛИ ТекущийРазмерДоли < ЭтотОбъект.Основание.РазмерДолиПослеИзменения Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Ссылка КАК Операция,
			|	ВЫБОР
			|		КОГДА &ТекущийРазмерДоли <= РешениеОбИзмененииУставногоКапиталаООО.РазмерДолиПослеИзменения
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			|		КОГДА &ТекущийРазмерДоли > РешениеОбИзмененииУставногоКапиталаООО.РазмерДолиПослеИзменения
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
			|	КОНЕЦ КАК ВидДвижения,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Организация КАК Организация,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Доли) КАК Рынок,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Доля.ВалютаНоминала КАК Валюта,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Доля КАК ЦеннаяБумага,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПоставкиПлановая,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Дата КАК ДатаПоставки,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОплатыПлановая,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОплаты,
			|	РешениеОбИзмененииУставногоКапиталаООО.РазмерДолиПослеИзменения - &ТекущийРазмерДоли КАК Количество,
			|	0 КАК Цена,
			|	0 КАК ЦенаПроцент,
			|	0 КАК ЦенаКупона,
			|	РешениеОбИзмененииУставногоКапиталаООО.СуммаОплаты КАК Сумма,
			|	0 КАК СуммаКупона,
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Дата КАК ДатаОперации
			|ИЗ
			|	Документ.ИсполнениеРешенияОбИзмененииУставногоКапиталаООО КАК ИсполнениеРешенияОбИзмененииУставногоКапиталаООО
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РешениеОбИзмененииУставногоКапиталаООО КАК РешениеОбИзмененииУставногоКапиталаООО
			|		ПО ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Основание = РешениеОбИзмененииУставногоКапиталаООО.Ссылка
			|ГДЕ
			|	ИсполнениеРешенияОбИзмененииУставногоКапиталаООО.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("ТекущийРазмерДоли", ТекущийРазмерДоли);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Движения.ОперацииСЦеннымиБумагами.Добавить(), Выборка);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры // СформироватьДвиженияПоОперациямСЦеннымиБумагами

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.СостоянияРешенийОбИзмененияхУставныхКапиталовООО.Записывать  = Истина;
	Движения.ОстаткиЦенныхБумаг.Записывать  = Истина;
	Движения.ЗадолженностиПоЦеннымБумагам.Записывать  = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать         	= Истина;
	
	Движение = Движения.СостоянияРешенийОбИзмененияхУставныхКапиталовООО.Добавить();
	Движение.Период 								= ЭтотОбъект.Дата;
	Движение.Организация 							= ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления 			= ЭтотОбъект.СчетДоверительногоУправления;
	Движение.РешениеОбИзмененииУставногоКапитала 	= ЭтотОбъект.Основание;
	Движение.Состояние 								= Перечисления.СостоянияПоручений.Исполнено;
	
	ТекущийРазмерДоли = ПолучитьТекущийРазмерДоли();
	
	Если ТекущийРазмерДоли <> ЭтотОбъект.Основание.РазмерДолиПослеИзменения  Тогда
		
		ИзменениеДоли = ЭтотОбъект.Основание.РазмерДолиПослеИзменения - ТекущийРазмерДоли;
		
		Если ИзменениеДоли > 0 Тогда
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();	
		Иначе
			Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();	
		КонецЕсли;
		
		Движение.Период 						= ЭтотОбъект.Дата;
		Движение.Организация 					= ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления 	= ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет               = Справочники.ДепозитарныеСчета.СчетУчетаДолей;
		Движение.Рынок                          = Перечисления.РынкиЦенныхБумаг.Доли;
		Движение.ЦеннаяБумага                   = ЭтотОбъект.Доля;
		
		Движение.Количество 					= МатематическиеФункции.МодульЧисла(ИзменениеДоли);
		
		
		Движение = Движения.ЗадолженностиПоЦеннымБумагам.ДобавитьРасход();	
		
		Движение.Период 						= ЭтотОбъект.Дата;
		Движение.Организация 					= ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления 	= ЭтотОбъект.СчетДоверительногоУправления;
		Движение.Основание               		= ЭтотОбъект.Основание;
		Движение.ТипЗадолженности 				= ?(ИзменениеДоли > 0, Перечисления.ТипыЗадолженности.Дебиторская, Перечисления.ТипыЗадолженности.Кредиторская);
		Движение.ВидЗадолженности 				= Справочники.ВидыЗадолженности.ПоВкладуВУставныйКапиталООО;
		Движение.Рынок                   		= Перечисления.РынкиЦенныхБумаг.Доли;
		Движение.ЦеннаяБумага                   = ЭтотОбъект.Доля;
		Движение.Валюта                   		= ЭтотОбъект.Доля.ВалютаНоминала;
		
		Движение.Количество 					= МатематическиеФункции.МодульЧисла(ИзменениеДоли);
		
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумаг(ЭтотОбъект, Отказ);
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоЦеннымБумагам(ЭтотОбъект, Отказ);
		
	КонецЕсли;
	
	СформироватьДвиженияПоОперациямСЦеннымиБумагами(ТекущийРазмерДоли);
		
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса


Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

КонецПроцедуры
	
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйРегистр,
		Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, УчетныйРегистр, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
		
	СчетРасчетовСКонтрагентами		= ПланыСчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	Контрагент = ЭтотОбъект.Доля.ЮрЛицо;
	
	ВидСубконтоУчетаЦеннойБумаги = ПланыВидовХарактеристик.ВидыСубконто.Доли;	
	
	УчетныйАктив       = Справочники.УчетныеАктивы.Доли;
	
	СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.ВидДвижения";

	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", УчетныйРегистр);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		
			
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			
			СтоимостьПокупки = Выборка.Стоимость;
			СтоимостьПокупкиВВалютеУчета = Выборка.СтоимостьВВалютеУчета;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтоимостьПокупкиВВалютеУчета, "Взнос в уставный капитал");
			
			// дебет
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = Доля;
			
			Проводка.КоличествоДт = Выборка.Количество;
			
			// кредит
			Проводка.СчетКт = СчетРасчетовСКонтрагентами;
			Проводка.СубконтоКт.Контрагенты = Контрагент;
			
		ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			
			// СПИСЫВАЕМ СЕБЕСТОИМОСТЬ ПРОДАННОЙ БУМАГИ В РАСХОДЫ
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Выборка.СтоимостьВВалютеУчета, "Уменьшение уставного капитала");
			
			// дебет
			Проводка.СчетДт = СчетРасчетовСКонтрагентами;
			Проводка.СубконтоДт.Контрагенты = Контрагент;
			
			// кредит
			Проводка.СчетКт = СчетУчета;
			Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = Доля;
			
			Проводка.КоличествоКт = Выборка.Количество;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОсновании(ДокументОснование)
		
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РешениеОбИзмененииУставногоКапиталаООО") Тогда
	
		Организация = ДокументОснование.Организация;
		СчетДоверительногоУправления = ДокументОснование.СчетДоверительногоУправления;
		Основание = ДокументОснование.Ссылка;
		Доля = ДокументОснование.Доля;
	
	КонецЕсли; 

КонецПроцедуры // ЗаполнитьДокументНаОсновании



#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОбИзмененииУставногоКапиталаООО") Тогда // ввод на основании
		ЗаполнитьДокументНаОсновании(ДанныеЗаполнения);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
	
		Если ЭтотОбъект.Дата < ЭтотОбъект.ДатаРеестра Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа не может быть раньше даты реестра!'"), ЭтотОбъект, "ДатаРеестра",, Отказ);
		КонецЕсли;
		
		Если НачалоДня(ЭтотОбъект.Дата) <> ЭтотОбъект.ДатаРеестра И НачалоДня(ЭтотОбъект.Дата) <> ЭтотОбъект.ДатаПолученияСведений Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа должна совпадать с датой реестра или с датой получения сведений!'"), ЭтотОбъект, "ДатаРешения",, Отказ);
		КонецЕсли;
		
		Если ЭтотОбъект.Дата < ЭтотОбъект.Основание.Дата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата документа не может быть раньше даты решения об изменении уставного капитала!'"), ЭтотОбъект, "ДатаРеестра",, Отказ);
		КонецЕсли;
		
		Если Основание.Доля <> Доля Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В исполнении выбрано решение для другой доли!'"), ЭтотОбъект, "ДатаРешения",, Отказ);
		КонецЕсли;
		
		Если Основание.СчетДоверительногоУправления <> СчетДоверительногоУправления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='В исполнении выбрано решение для другого счета доверительного управления!'"), ЭтотОбъект, "ДатаРешения",, Отказ);
		КонецЕсли;
		
		//проверим размер уставного капитала в регистре
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УставнойКапиталСрезПоследних.РазмерУставногоКапитала КАК РазмерУставногоКапитала
			|ИЗ
			|	РегистрСведений.УставнойКапитал.СрезПоследних(&Дата, ЮрЛицо = &ЮрЛицо) КАК УставнойКапиталСрезПоследних";
		
		Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаРеестра);
		Запрос.УстановитьПараметр("ЮрЛицо", ЭтотОбъект.Доля.ЮрЛицо);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.РазмерУставногоКапитала <> ЭтотОбъект.Основание.СуммаУставногоКапиталаПослеИзменения Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Размер уставного капитала в регистре на дату реестра не соответствует исполненному решению!'"), ЭтотОбъект, "ДатаРешения",, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		//Проверим что решение требует исполнения
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СостоянияРешенийОбИзмененияхУставныхКапиталовОООСрезПоследних.Состояние КАК Состояние
			|ИЗ
			|	РегистрСведений.СостоянияРешенийОбИзмененияхУставныхКапиталовООО.СрезПоследних(
			|			&МоментВремени,
			|			РешениеОбИзмененииУставногоКапитала = &РешениеОбИзмененииУставногоКапитала
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СостоянияРешенийОбИзмененияхУставныхКапиталовОООСрезПоследних";
		
		Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("РешениеОбИзмененииУставногоКапитала", ЭтотОбъект.Основание);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Решение об изменении уставного капитала "+ЭтотОбъект.Доля+" не зарегистрировано!'"), ЭтотОбъект, "Основание",, Отказ);
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.Состояние <> Перечисления.СостоянияПоручений.ПустаяСсылка() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Решение об изменении уставного капитала  не требует исполнения!'"), ЭтотОбъект, ,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти 
