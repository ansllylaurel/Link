Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	Движения.ЗадолженностиПоПрочимАктивам.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаявкаПайщикаИмущество.Ссылка.Дата КАК Период,
		|	ЗаявкаПайщикаИмущество.Ссылка.Организация КАК Организация,
		|	&СчетДУ КАК СчетДоверительногоУправления,
		|	ЗаявкаПайщикаИмущество.ВидИмущества КАК ВидИмущества,
		|	ЗаявкаПайщикаИмущество.Имущество КАК Имущество,
		|	ЗаявкаПайщикаИмущество.Имущество.Представление КАК ИмуществоПредставление,
		|	ЗаявкаПайщикаИмущество.Ссылка КАК Основание,
		|	СУММА(ЗаявкаПайщикаИмущество.Количество) КАК Количество,
		|	СУММА(ЗаявкаПайщикаИмущество.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ЗаявкаПайщика.Имущество КАК ЗаявкаПайщикаИмущество
		|ГДЕ
		|	ЗаявкаПайщикаИмущество.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаПайщикаИмущество.Ссылка.Организация,
		|	ЗаявкаПайщикаИмущество.Имущество,
		|	ЗаявкаПайщикаИмущество.ВидИмущества,
		|	ЗаявкаПайщикаИмущество.Ссылка.Дата,
		|	ЗаявкаПайщикаИмущество.Имущество.Представление,
		|	ЗаявкаПайщикаИмущество.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СчетДУ", Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ЭтотОбъект.ПаевойИнвестиционныйФонд));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Движение = Движения.ЗадолженностиПоПрочимАктивам.ДобавитьПриход();
		ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетальныеЗаписи);
		
	КонецЦикла;
	
КонецПроцедуры

