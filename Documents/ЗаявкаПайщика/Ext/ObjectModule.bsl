		НомерЗаявки = РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(МассивСтрок[4]);
	Иначе     
		
		НомерЗаявки = Номер;
		
		//НомерЗаявки = МассивСтрок[2];
		//
		//Если МассивСтрок[3] = "000ON" Тогда
		//	НомерЗаявки = НомерЗаявки + "-" + "ON";
		//Иначе
		//	НомерЗаявки = НомерЗаявки + "-" + МассивСтрок[3];
		//КонецЕсли;
		//
		//НомерЗаявки = НомерЗаявки + "-" + РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(МассивСтрок[4]);
		
	КонецЕсли;
	
	НомерЗаявки = НомерЗаявки;
	
КонецПроцедуры

Процедура ЗаполнитьНомерПоНомеруЗаявки()
	
	МассивСтрок = СтрРазделить(НомерЗаявки, "-");
	
	ПрефиксНумерации = Организация.ПрефиксНумерации;
	
	Если ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		КодВида = "-0";
	Иначе
		КодВида = "-1";
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 1 Тогда
		Номер = ПрефиксНумерации + КодВида 
			+ "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(ПаевойИнвестиционныйФонд.Код), 2)
			+ "-00000"
			+ "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(МассивСтрок[0],7);
	ИначеЕсли МассивСтрок.Количество() = 3 Тогда
		Номер = ПрефиксНумерации + КодВида 
			+ "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(МассивСтрок[0],2)
			+ "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(МассивСтрок[1],5)
			+ "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(МассивСтрок[2],7);
	Иначе
		ВызватьИсключение "Номер заявки """ + НомерЗаявки + """ не соответствует одному из шаблонов [Код ПИФ]-[Код места]-[Порядковый номер] или [Порядковый номер]";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьНеиспользуемыеРеквизитыЗаявки()
	
	Если ЗначениеЗаполнено(НоминальныеДержатели)
		и ВидПайщика <> Перечисления.ВидыПайщиков.НоминальныйДержатель Тогда
		НоминальныеДержатели = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Агент)
		и ИсточникЗаявки <> Перечисления.ИсточникиАнкетИЗаявок.Агент Тогда
		Агент = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьПаиПайщикаДляобмена()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ДолиПайщиковВИнвестиционномФондеОстатки.КоличествоОстаток < &Количество КАК НеХватаетПаевВФонде
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд
		|				И Пайщик = &Пайщик) КАК ДолиПайщиковВИнвестиционномФондеОстатки");
	
	Запрос.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",								Новый Граница(ЭтотОбъект.Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",			ЭтотОбъект.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Пайщик",								ЭтотОбъект.Пайщик);
	Запрос.УстановитьПараметр("Количество",							ЭтотОбъект.Количество);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	ТекстОшибки = "";
	Если Выборка.Следующий() Тогда
		Если Выборка.НеХватаетПаевВФонде Тогда
			ТекстОшибки = СтрШаблон("Количество паев в заявке превышает количество в наличии %1 у пайщика %2 (%3)",
				Выборка.КоличествоОстаток,
				ЭтотОбъект.Пайщик,
				ЭтотОбъект.ПаевойИнвестиционныйФонд);
		КонецЕсли;
	Иначе
		ТекстОшибки = СтрШаблон("У пайщика %1 отсутствуют паи в %2", ЭтотОбъект.Пайщик, ЭтотОбъект.ПаевойИнвестиционныйФонд);
	КонецЕсли;	
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Если ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		КодВида = "-0";
	Иначе
		КодВида = "-1";
	КонецЕсли;
	
	Если ИсточникЗаявки = Перечисления.ИсточникиАнкетИЗаявок.Офис Тогда
		КодМеста = "-00000";
	Иначе
		Если ИсточникЗаявки = Перечисления.ИсточникиАнкетИЗаявок.Сайт Тогда
			КодМеста = "-000ON";	
		Иначе
			КодМеста = "-99999";
		КонецЕсли;
	КонецЕсли;
	КодПИФ = "-" + РаботаСоСтрокамиКлиентСервер.ДополнитьСтроку(РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(ПаевойИнвестиционныйФонд.Код),2);
	
	Префикс = Организация.ПрефиксНумерации + КодВида + КодПИФ + КодМеста + "-";
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
		
		ДанныеЗаполнения.Свойство("Пайщик", Пайщик);
		ДанныеЗаполнения.Свойство("ПаевойИнвестиционныйФонд", ПаевойИнвестиционныйФонд);
		
		Владелец = Пайщик;
		
		Если Пайщик.ЭтоГруппа Тогда
			ВызватьИсключение "Заявка пайщика не вводится для группы клиентов!";
		КонецЕсли;
		
		РеквизитыПлатежа = Справочники.БанковскиеСчета.ПолучитьРеквизитыПлатежа(Организация, Владелец, , ТекущаяДатаСеанса());
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыПлатежа);
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Исключение реквизитов
	МассивИсключаемыхРеквизитов = Новый Массив;
	
	Если ИсточникЗаявки <> Перечисления.ИсточникиАнкетИЗаявок.Агент Тогда
		МассивИсключаемыхРеквизитов.Добавить("Агент");	
		МассивИсключаемыхРеквизитов.Добавить("ПодразделениеАгента");	
	КонецЕсли;
	
	Если ВидПайщика <> Перечисления.ВидыПайщиков.НоминальныйДержатель Тогда
		МассивИсключаемыхРеквизитов.Добавить("Брокер");	
	КонецЕсли;
	
	Если ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		МассивИсключаемыхРеквизитов.Добавить("Количество");
		
	КонецЕсли;	
	
		
	Для каждого НеПроверяемыйРеквизит из МассивИсключаемыхРеквизитов Цикл
		
		ИндексЭлемента = ПроверяемыеРеквизиты.Найти(НеПроверяемыйРеквизит);
		Если ИндексЭлемента <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ИндексЭлемента);	
		КонецЕсли;
		
	КонецЦикла;
	
	УКПИ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ");
	
	// Добавление реквизитов
	Если ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		Если Не Многократная Тогда
			
			Если ЭтотОбъект.Имущество.Количество() = 0 Тогда
				ПроверяемыеРеквизиты.Добавить("Сумма");	
			КонецЕсли;
			
		КонецЕсли;
		Если Не ОткрытьЗакрытьДепозитарныйСчет Тогда
			ПроверяемыеРеквизиты.Добавить("ДепозитарныйСчет");	
		КонецЕсли;
	Иначе
		Если ЭтотОбъект.Организация <> УКПИ или ЭтотОбъект.Дата > Дата(2020,1,1) Тогда
			ПроверяемыеРеквизиты.Добавить("ДепозитарныйСчет");	
		КонецЕсли;
	КонецЕсли;
	
	Если Пайщик.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо
		и ВидПайщика = Перечисления.ВидыПайщиков.Владелец
		и Представители.Количество() = 0 Тогда
		
	        Если ЭтотОбъект.Организация <> УКПИ или ЭтотОбъект.Дата > Дата(2020,1,1) Тогда
				СтрокаСообщения = "Для юридических лиц необходимо указание уполномоченных представителей";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, Ссылка, "Пайщик", "Объект", Отказ);
			КонецЕсли;
			
	КонецЕсли;
	
	Если ЭтотОбъект.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		
		ПроверяемыеРеквизиты.Добавить("ПаевойИнвестиционныйФондДляОбменаПаев");
		
		Если Не ЭтотОбъект.ОткрытьДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена Тогда
			ПроверяемыеРеквизиты.Добавить("ДепозитарныйСчетВПаевомИнвестиционномФондеДляОбмена");
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого СтрокаПредставитель из Представители Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПредставитель.Представитель) Тогда
			
			СтрокаСообщения = "Не указан представитель пайщика " + СтрокаПредставитель.НомерСтроки;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, Ссылка, "Представители[" + Формат(СтрокаПредставитель.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Представитель", "Объект", Отказ);
			
		Иначе
			
			Если СтрокаПредставитель.Представитель.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо
				и Не ЗначениеЗаполнено(СтрокаПредставитель.ВЛице) Тогда
				
				СтрокаСообщения = "Не указано лицо представителя пайщика " + СтрокаПредставитель.НомерСтроки + " """ + СтрокаПредставитель.Представитель + """";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, Ссылка, "Представители[" + Формат(СтрокаПредставитель.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВЛице", "Объект", Отказ);
				
			КонецЕсли; 
				
		КонецЕсли;
		
	КонецЦикла;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	// Очистка реквизитов
	ОчиститьНеиспользуемыеРеквизитыЗаявки();
	
	// Нумерация документов
	Если ПустаяСтрока(Номер) Тогда
		
		Если Не ПустаяСтрока(НомерЗаявки) Тогда
			ЗаполнитьНомерПоНомеруЗаявки();
		Иначе
			УстановитьНовыйНомер();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЗаявки) Тогда
		ЗаполнитьНомерЗаявкиПоНомеру();	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерСчета) Тогда
		
		Справочники.БанковскиеСчета.СоздатьПолучитьРасчетныйСчет(
			ЭтотОбъект.РасчетныйСчет, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.БИК, 
			ЭтотОбъект.НомерСчета, 
			ЭтотОбъект.Владелец, 
			ЗначениеЗаполнено(ЭтотОбъект.ЛицевойСчет), 
			ЭтотОбъект.ВидПайщика = Перечисления.ВидыПайщиков.Владелец, 
			Отказ);
		
	Иначе
		Если Не ОбменДанными.Загрузка Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны реквизиты вывода денежных средств", Ссылка, "РасчетныйСчет", "Объект", );
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Обмен Тогда
		// В ПИФе у пайщика должны быть паи
		Отказ = Не ПроверитьПаиПайщикаДляобмена();
	КонецЕсли;

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаИмущества.Имущество КАК Имущество,
			|	_ТаблицаИмущества.ВидИмущества КАК ВидИмущества,
			|	_ТаблицаИмущества.НомерСтроки КАК НомерСтроки,
			|	_ТаблицаИмущества.Сумма КАК Сумма
			|ПОМЕСТИТЬ _ПоДокументу0
			|ИЗ
			|	&ТаблицаИмущества КАК _ТаблицаИмущества
			|ГДЕ
			|	_ТаблицаИмущества.ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПоДокументу0.Имущество КАК Имущество,
			|	МИНИМУМ(_ПоДокументу0.НомерСтроки) КАК НомерСтроки,
			|	МИНИМУМ(_ПоДокументу0.Сумма) КАК Сумма,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ПоДокументу0.НомерСтроки) КАК КоличествоСтрок,
			|	_ПоДокументу0.ВидИмущества КАК ВидИмущества
			|ПОМЕСТИТЬ _ПоДокументу
			|ИЗ
			|	_ПоДокументу0 КАК _ПоДокументу0
			|
			|СГРУППИРОВАТЬ ПО
			|	_ПоДокументу0.Имущество,
			|	_ПоДокументу0.ВидИмущества
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОбъектыНедвижимости.Представление КАК Представление,
			|	_ПоДокументу.НомерСтроки КАК НомерСтроки,
			|	_ПоДокументу.Сумма КАК Сумма,
			|	ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость КАК Стоимость,
			|	ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики ЕСТЬ NULL КАК НетСтоимостиОценщика,
			|	ВЫБОР
			|		КОГДА ОбъектыНедвижимости.ВидОбъектаНедвижимости = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовНедвижимости.Помещение)
			|				И РеквизитыОбъектовНедвижимостиСрезПоследних.НазначениеОбъектаНедвижимости = ЕСТЬNULL(&НежилоеПомещение, 0)
			|			ТОГДА _ПоДокументу.Сумма < ЕСТЬNULL(ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость, 0)
			|		ИНАЧЕ _ПоДокументу.Сумма <> ЕСТЬNULL(ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость, 0)
			|	КОНЕЦ КАК СтоимостьОценщикаОтличается,
			|	_ПоДокументу.КоличествоСтрок > 1
			|		И _ПоДокументу.ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость) КАК КоличествоБольшеОдного
			|ИЗ
			|	_ПоДокументу КАК _ПоДокументу
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
			|		ПО _ПоДокументу.Имущество = ОбъектыНедвижимости.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиПрочихАктивов.СрезПоследних(
			|				&ДатаДокумента,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость)) КАК ОценкиСтоимостиПрочихАктивовСрезПоследних
			|		ПО _ПоДокументу.Имущество = ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики
			|			И (ОценкиСтоимостиПрочихАктивовСрезПоследних.ДатаОкончанияДействия >= &ДатаДокумента),
			|	РегистрСведений.РеквизитыОбъектовНедвижимости.СрезПоследних(
			|			&ДатаДокумента,
			|			ОбъектНедвижимости В
			|				(ВЫБРАТЬ
			|					_ПоДокументу.Имущество КАК Имущество
			|				ИЗ
			|					_ПоДокументу КАК _ПоДокументу)) КАК РеквизитыОбъектовНедвижимостиСрезПоследних
			|ГДЕ
			|	(ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики ЕСТЬ NULL
			|			ИЛИ _ПоДокументу.Сумма <> ЕСТЬNULL(ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость, 0)
			|			ИЛИ _ПоДокументу.КоличествоСтрок > 1
			|				И _ПоДокументу.ВидИмущества = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость))";
		
		Запрос.УстановитьПараметр("ДатаДокумента", ЭтотОбъект.Дата);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ЭтотОбъект.ПаевойИнвестиционныйФонд));
		Запрос.УстановитьПараметр("ТаблицаИмущества", ЭтотОбъект.Имущество.Выгрузить());
		Запрос.УстановитьПараметр("НежилоеПомещение", ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("НазначениеНедвижимости_НежилоеПомещение"));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.НетСтоимостиОценщика Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для объекта недвижимости """ + ВыборкаДетальныеЗаписи.Представление 
					+ """ не определена стоимость оценщика", ЭтотОбъект, "Имущество[" + (ВыборкаДетальныеЗаписи.НомерСтроки - 1) + "].Имущество",, Отказ);
			ИначеЕсли ВыборкаДетальныеЗаписи.СтоимостьОценщикаОтличается Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для объекта недвижимости """ + ВыборкаДетальныеЗаписи.Представление 
					+ """ указана другая стоимость оценщика ("+ВыборкаДетальныеЗаписи.Стоимость+")", 
					ЭтотОбъект, "Имущество[" + (ВыборкаДетальныеЗаписи.НомерСтроки - 1) + "].Сумма",, Отказ);
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.КоличествоБольшеОдного Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Объект имушества """ + ВыборкаДетальныеЗаписи.Представление 
					+ """ включен в заявку более одного раза", ЭтотОбъект, "Имущество["+(ВыборкаДетальныеЗаписи.НомерСтроки - 1)+"].Имущество",,Отказ);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЭтотОбъект.НомерЗаявки = Неопределено;
	
	ЭтотОбъект.ПЭП_ДатаВремяПодписи	= "";
	ЭтотОбъект.ПЭП_Код				= "";
	ЭтотОбъект.ПЭП_НомерТелефона	= "";
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЭтотОбъект.ДополнительныеСвойства.ЭтоНовый И ЭтотОбъект.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
		
		РегистрыСведений.СтатусыЗаявокНаПриобретениеПаев.УстановитьСтатусЗаявкиНаПриобретениеПаев(
								ЭтотОбъект.Организация,
								ЭтотОбъект.Ссылка,
								Перечисления.СтатусыЗаявокПайщиков.НаПроверке,
								ЭтотОбъект.Дата,
								Отказ);
								
	КонецЕсли;
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

