	МассивСтрок = СтрРазделить(Номер, "-");
	
	//Если МассивСтрок.Количество() <> 5 Тогда
	//	ВызватьИсключение "Системный номер """ + Номер + """ не соответствует ожидаемому [Префикс организации]-[Прификс вида (0 или 1)]-[Код ПИФ]-[Код места]-[Порядковый номер]";
	//КонецЕсли;
	
