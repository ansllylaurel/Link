
&НаКлиенте
Процедура ВидыОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьФормуОтчета(Элементы.ВидыОтчетов.ТекущиеДанные, ПараметрыФормы.Организация, 
									ПараметрыФормы.СчетДоверительногоУправления, 
									ПараметрыФормы.ДатаНачалаПериодаОтчета, 
									ПараметрыФормы.ДатаКонцаПериодаОтчета, Истина);
									
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ОткрытьФормуОтчета(Элементы.ВидыОтчетов.ТекущиеДанные, ПараметрыФормы.Организация, 
									ПараметрыФормы.СчетДоверительногоУправления, 
									ПараметрыФормы.ДатаНачалаПериодаОтчета, 
									ПараметрыФормы.ДатаКонцаПериодаОтчета, Истина);
									
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОтчета(ДанныеОтчета, ОрганизацияОтчета, СчетДоверительногоУправления, 
					ДатаНачалаПериодаОтчета, ДатаОкончанияПериодаОтчета, ЭтоВыбор = Ложь)
		
	РезультатОткрытияФормыНаСервере = Неопределено;
		
	Отказ = Ложь;
		
		
	РезультатОткрытияФормыНаСервере = ОткрытьФормуОтчетаНаСервере(ДанныеОтчета.Значение, ОрганизацияОтчета, СчетДоверительногоУправления, 
												ДатаНачалаПериодаОтчета, ДатаОкончанияПериодаОтчета);
	
	Если РезультатОткрытияФормыНаСервере = "Не удалось открыть отчет" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатОткрытияФормыНаСервере, , , , Отказ);
		
	ИначеЕсли ТипЗнч(РезультатОткрытияФормыНаСервере) = Тип("Структура") Тогда
		
		ЭтоРСБУ = Ложь;
		ЭтоРСБУ = ?(РезультатОткрытияФормыНаСервере.Свойство("ЭтоРСБУ", ЭтоРСБУ), ЭтоРСБУ, Ложь);
		
		Если ЭтоРСБУ = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно выбрать вариант баланса. Параметры учета не заданы.", , , , Отказ); 
		Иначе		
			ИмяФормыОтчета = "Отчет." + РезультатОткрытияФормыНаСервере.Отчет + ?(ЭтоРСБУ,"РСБУ","") + ".Форма.ОсновнаяФорма";
		КонецЕсли;	
			
	КонецЕсли;
		
	Если Не Отказ Тогда
		
		Если ЭтоВыбор Тогда
			
			ПараметрыВыбора = Новый Структура;
			ПараметрыВыбора.Вставить("СчетДоверительногоУправления", 	ПараметрыФормы.СчетДоверительногоУправления);
			ПараметрыВыбора.Вставить("Организация", 					ПараметрыФормы.Организация);
			ПараметрыВыбора.Вставить("ДатаНачалаПериодаОтчета", 		ПараметрыФормы.ДатаНачалаПериодаОтчета);
			ПараметрыВыбора.Вставить("ДатаКонцаПериодаОтчета", 			ПараметрыФормы.ДатаКонцаПериодаОтчета);
			ПараметрыВыбора.Вставить("ПредставлениеВидаОтчета",			ДанныеОтчета.Значение);
			ПараметрыВыбора.Вставить("ИмяФормыОтчета",					ИмяФормыОтчета);
			
			ЭтаФорма.ВладелецФормы.ПараметрыВыбораФормыСоздания = ПараметрыВыбора;
			Закрыть();
			
		Иначе
			
			ОткрытьФорму(ИмяФормыОтчета, РезультатОткрытияФормыНаСервере, ЭтаФорма.ВладелецФормы, 
					ИмяФормыОтчета,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОткрытьФормуОтчетаНаСервере(Отчет, ОрганизацияОтчета, СчетДоверительногоУправления
											  , ДатаНачалаПериодаОтчета = Неопределено
											  , ДатаОкончанияПериодаОтчета = Неопределено)
											  
	
	Если Метаданные.Отчеты.Найти(Отчет) = Неопределено Тогда
		Возврат "Не удалось открыть отчет";
	КонецЕсли;
	
	ПараметрыТекФормы = Новый Структура;
	ПараметрыТекФормы.Вставить("Организация");
	ПараметрыТекФормы.Вставить("СчетДоверительногоУправления");
	ПараметрыТекФормы.Вставить("мДатаНачалаПериодаОтчета");
	ПараметрыТекФормы.Вставить("мДатаКонцаПериодаОтчета");
	
	
	ПараметрыТекФормы.Организация = ОрганизацияОтчета;
	ПараметрыТекФормы.СчетДоверительногоУправления = СчетДоверительногоУправления;
	
	Если ЗначениеЗаполнено(ДатаНачалаПериодаОтчета) ИЛИ ЗначениеЗаполнено(ДатаОкончанияПериодаОтчета) Тогда
		
		ПараметрыТекФормы.мДатаНачалаПериодаОтчета = ?(ТипЗнч(ДатаНачалаПериодаОтчета) = Тип("Дата") И ДатаНачалаПериодаОтчета <> Дата(1,1,1), НачалоДня(ДатаНачалаПериодаОтчета), Неопределено);
		ПараметрыТекФормы.мДатаКонцаПериодаОтчета = ?(ТипЗнч(ДатаОкончанияПериодаОтчета) = Тип("Дата") И ДатаОкончанияПериодаОтчета <> Дата(1,1,1), КонецДня(ДатаОкончанияПериодаОтчета), Неопределено);
		
	КонецЕсли;
	
	Если (Отчет = "РегламентированныйОтчетБаланс" ИЛИ Отчет = "РегламентированныйОтчетОФинансовыхРезультатах") 
		И ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		
		ПараметрыТекФормы.Вставить("ЭтоРСБУ");
												  
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет,
			|	НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет КАК ВестиЕдиныйБухгалтерскийУчет
			|ИЗ
			|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
		
		Запрос.УстановитьПараметр("Организация", ОрганизацияОтчета);
		Запрос.УстановитьПараметр("Период", ДатаОкончанияПериодаОтчета);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ВестиЕдиныйБухгалтерскийУчет Тогда
				ПараметрыТекФормы.ЭтоРСБУ = Ложь;										  
			ИначеЕсли ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда
				ПараметрыТекФормы.ЭтоРСБУ = Истина;										  
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ПараметрыТекФормы.Вставить("Отчет", Отчет);
	
	Возврат ПараметрыТекФормы;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация",             		Параметры.Организация);
	ПараметрыФормы.Вставить("СчетДоверительногоУправления", Параметры.СчетДоверительногоУправления);
	ПараметрыФормы.Вставить("ДатаНачалаПериодаОтчета", 		Параметры.ДатаНачалаПериодаОтчета);
	ПараметрыФормы.Вставить("ДатаКонцаПериодаОтчета",  		Параметры.ДатаКонцаПериодаОтчета);
	ПараметрыФормы.Вставить("ПредставлениеВидаОчета",  		Параметры.ПредставлениеВидаОтчета);
	
	ВидыОтчетов = Документы.РегламентированныйОтчет.ПолучитьСписокВидовРегламентированныхОтчетов();
	
	Если ЗначениеЗаполнено(Параметры.ПредставлениеВидаОтчета) Тогда
		ВыбранныйОтчет = ВидыОтчетов.НайтиПоЗначению(Параметры.ПредставлениеВидаОтчета);
		ДанныеНайденногоВидаОтчета = Новый Структура("Значение", ВыбранныйОтчет.Значение) 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(ДанныеНайденногоВидаОтчета) = Тип("Структура") Тогда
		
		ОткрытьФормуОтчета(ДанныеНайденногоВидаОтчета, ПараметрыФормы.Организация, ПараметрыФормы.СчетДоверительногоУправления,
									ПараметрыФормы.ДатаНачалаПериодаОтчета, ПараметрыФормы.ДатаКонцаПериодаОтчета);
		
		Отказ = Истина;
			
	КонецЕсли;
	
КонецПроцедуры

