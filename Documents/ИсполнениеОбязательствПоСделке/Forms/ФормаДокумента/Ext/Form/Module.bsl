
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы      = Форма.Элементы;
	
	ЭтоРынокДеривативов = (Форма.Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы") 
							Или Форма.Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы")
							Или Форма.Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы"));
							
	Элементы.СделкаЧерезБрокера.Доступность = НЕ ЭтоРынокДеривативов;
	
	Элементы.ОписаниеНоминалаЦеннойБумаги.Видимость = РаботаСЦеннымиБумагамиКлиентСервер.ЭтоРынокЦенныхБумагСНоминалом(ДанныеОбъекта.Рынок);
	
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьБрокераСделкиИСвязанныхРеквизитов(Форма);
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьИДоступностьРасчетногоСчетаИСвязанныхРеквизитов(Форма);
	
КонецПроцедуры // НастроитьВидимостьДоступность

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСведенияОбОсновании(Форма)
	
	Объект = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.Основание) Или Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		Форма.Элементы.НадписьСведенияОбОсновании.Заголовок = "";
	Иначе
		Форма.Элементы.НадписьСведенияОбОсновании.Заголовок =
			ПолучитьСведенияОбОсновании(Форма.Объект.Дата, Форма.Объект.Основание, Форма.Объект.ВидЗадолженности);
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСведенияОбОсновании

&НаСервереБезКонтекста
Функция ПолучитьСведенияОбОсновании(Период, Основание, ВидЗадолженности)
	
	Запрос = Новый Запрос;
	
	Если ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокСрезПоследних.Сделка.ВидСделки КАК ВидСделки,
			|	УсловияСделокСрезПоследних.Сделка.КодРасчетовНаБирже КАК КодРасчетовНаБирже,
			|	УсловияСделокСрезПоследних.Сделка.РежимПереговорныхСделок КАК РежимПереговорныхСделок,
			|	УсловияСделокСрезПоследних.Сделка.ВыкупЭмитентом КАК ВыкупЭмитентом,
			|	УсловияСделокСрезПоследних.Сделка.ПервичноеРазмещение КАК ПервичноеРазмещение,
			|	УсловияСделокСрезПоследних.Сделка.КонтрагентНаБирже КАК КонтрагентНаБирже,
			|	УсловияСделокСрезПоследних.ДатаИсполнения
			|ИЗ
			|	РегистрСведений.УсловияСделок.СрезПоследних(&Период, Сделка = &Сделка) КАК УсловияСделокСрезПоследних";
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВидСделки КАК ВидСделки,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.КодРасчетовНаБирже КАК КодРасчетовНаБирже,
			|	ЛОЖЬ КАК РежимПереговорныхСделок,
			|	ЛОЖЬ КАК ВыкупЭмитентом,
			|	ЛОЖЬ КАК ПервичноеРазмещение,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.КонтрагентНаБирже КАК КонтрагентНаБирже,
			|	УсловияСделокРЕПОСрезПоследних.ДатаИсполнения
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&Период,
			|			СделкаРЕПО = &Сделка
			|				И ВидЗадолженности = &ВидЗадолженности) КАК УсловияСделокРЕПОСрезПоследних";
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Период",           Период);
	Запрос.УстановитьПараметр("Сделка",           Основание);
	Запрос.УстановитьПараметр("ВидЗадолженности", ВидЗадолженности);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	СведенияОбОсновании = "" + Выборка.ВидСделки + ", Код расчетов " + Выборка.КодРасчетовНаБирже
		+ ?(Выборка.РежимПереговорныхСделок, ", режим переговорных сделок (РПС)", "")
		+ ?(Выборка.ВыкупЭмитентом, ", выкуп эмитентом", "")
		+ ?(Выборка.ПервичноеРазмещение, ", первичное размещение", "")
		+ ?(ЗначениеЗаполнено(Выборка.КонтрагентНаБирже), ", контрагент - " + Выборка.КонтрагентНаБирже, "")
		+ Символы.ПС + "Плановая дата исполнения — " + Формат(Выборка.ДатаИсполнения, "ДФ=dd.MM.yyyy");
		
	Возврат СведенияОбОсновании;
		
КонецФункции // ПолучитьСведенияОбОсновании

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено) Экспорт
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.СделкаЧерезБрокера           = ?(ЗначениеЗаполнено(Объект.Брокер), 1, 0);
	ЭтаФорма.ДетализацияПоРасчетномуСчету = РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Объект);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	ОбновитьСведенияОбОсновании(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()
	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаЦенныеБумаги.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
	КонецЕсли;
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Фьючерсы") 
		Или Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы")
		Или Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ДрагоценныеМеталлы")Тогда
		
		Для Каждого СтрокаЦенныхБумаг Из Объект.ЦенныеБумаги Цикл
			СтрокаЦенныхБумаг.ДепозитарныйСчет = ПредопределенноеЗначение("Справочник.ДепозитарныеСчета.СчетУчетаДеривативов");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;
	
	ЗаполнитьПодтверждениеОперацииНаСервере();		
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("СводноеИсполнениеБиржевыхСделок.Обновить", Объект.Ссылка);
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперациинаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель(?(ЭтаФорма.СделкаЧерезБрокера = 1, "ИсполнителиПоДенежнымСредствамБрокерские", "ИсполнителиПоДенежнымСредствамСобственные"),
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, Брокер, РасчетныйСчет"))
	Тогда
		Объект.РасчетныйСчет = Неопределено;
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииДаты(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОснованиеПриИзменении(Элемент)
	
	ОбновитьСведенияОбОсновании(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	
	ОбновитьСведенияОбОсновании(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
		
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииРынка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СделкаЧерезБрокераПриИзменении(Элемент)
	
	Объект.РасчетныйСчет = Неопределено; // т.к. связь параметров выбора не отрабатывает при программном изменении брокера
			
	Если ЭтаФорма.СделкаЧерезБрокера = 0 Тогда
		Объект.Брокер = Неопределено;
	КонецЕсли;
	
	РаботаСДокументамиКлиентСервер.НастроитьВидимостьБрокераСделкиИСвязанныхРеквизитов(ЭтаФорма);
	
	БрокерПриИзменении(Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура БрокерПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.ДетализацияПоРасчетномуСчетуПриИзмененииСвязанныхРеквизитов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
