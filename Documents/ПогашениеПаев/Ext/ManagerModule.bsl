
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЭтоПогашениеПоОбменуПаев = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Заявка, "ВидЗаявки") = Перечисления.ВидыЗаявокПайщиков.Обмен;
	
	Представление = СтрШаблон("Погашение паев%1 %2 от %3", 
		?(ЭтоПогашениеПоОбменуПаев, " по обмену", ""),
		Данные.Номер,
		Данные.Дата);
		
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("Заявка");
		
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
