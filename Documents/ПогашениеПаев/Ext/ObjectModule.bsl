
Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);

		
	Движения[УчетныйРегистр].Записывать = Истина;

	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], Сумма, "Погашение паев");
		
	Проводка.СчетДт = Планысчетов.Основной.ЦелевоеФинансированиеИзБюджета;
	Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.Пайщик;
	
	Проводка.КоличествоДт = Количество;
	
	Проводка.СчетКт = Планысчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами; 
	Проводка.СубконтоКт.Контрагенты = РаботаСДокументами.ПолучитьКонтрагентаПоВидуПайщика(ВидПайщика, Владелец, ЭтотОбъект.Пайщик, Дата); 

	
		
	РеквизитыПИФ = РегистрыСведений.РеквизитыПИФ.ПолучитьРеквизитыПИФ(ЭтотОбъект.ПаевойИнвестиционныйФонд, ЭтотОбъект.Дата);
	УправляющаяКомпания = РеквизитыПИФ.УправляющаяКомпания;
	УправляющаяКомпанияЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");

	
	СуммаСкидки = ЭтотОбъект.Партии.Итог("СуммаСкидки");

	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаСкидки, "Удержана скидка при погашении паев");

	Проводка.СчетДт = Планысчетов.Основной.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами; 
	Проводка.СубконтоДт.Контрагенты = РаботаСДокументами.ПолучитьКонтрагентаПоВидуПайщика(ВидПайщика, Владелец, ЭтотОбъект.Пайщик, Дата);

	Проводка.СчетКт = Планысчетов.Основной.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	Проводка.СубконтоКт.Контрагенты = УправляющаяКомпанияЮрФизЛицо;

	
	Если НастройкиУчета.ВестиУчетИмуществаПайщиков Тогда
		
		СуммаПогашенияСУчетомСкидки = ЭтотОбъект.Партии.Итог("СуммаПогашения");
		СуммаСкидки = ЭтотОбъект.Партии.Итог("СуммаСкидки");
		СуммаПогашения = СуммаПогашенияСУчетомСкидки + СуммаСкидки;
		Себестоимость = 0;
		СебестоимостьНадбавки = 0;
		
		ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПогашения, "Погашение паев пайщика");

		ПроводкаПайщика.СчетДт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
		ПроводкаПайщика.СубконтоДт.Пайщики = ЭтотОбъект.Пайщик;
		ПроводкаПайщика.СубконтоДт.ЗаявкиПайщиков = ЭтотОбъект.Заявка;

		Аналитика = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДоходыПоПаямЗПИФ");
		
		ПроводкаПайщика.СчетКт = Планысчетов.Основной.ДоходОтПогашенияПаев;
		ПроводкаПайщика.СубконтоКт.ПрочиеДоходыИРасходы = Аналитика;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БУОстаткиПаи.Субконто2 КАК ЗачислениеПаев,
			|	БУОстаткиПаи.СуммаОстаток КАК Сумма,
			|	БУОстаткиПаи.КоличествоОстаток КАК Количество,
			|	ЕСТЬNULL(БУОстаткиПаиНадбавки.СуммаОстаток, 0) КАК Надбавка
			|ИЗ
			|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
			|			&Период,
			|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПаиПайщиков),
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Субконто1 = &Пайщик) КАК БУОстаткиПаи
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
			|				&Период,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НадбавкаПриПокупкеПаев),
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Субконто1 = &Пайщик) КАК БУОстаткиПаиНадбавки
			|		ПО БУОстаткиПаи.Субконто2 = БУОстаткиПаиНадбавки.Субконто2";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("Пайщик", ЭтотОбъект.Пайщик);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		
		ТЗОстаткиПаиБУ = Запрос.Выполнить().Выгрузить();
		
		
		Для каждого СтрокаПартий Из ЭтотОбъект.Партии Цикл
			
			Если СтрокаПартий.СуммаСкидки <> 0 Тогда
			
				ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаПартий.СуммаСкидки, "Скидка при продаже паев");

				ПроводкаПайщика.СчетДт = Планысчетов.Основной.СкидкаПриПродажеПаев;
				ПроводкаПайщика.СубконтоДт.Пайщики = ЭтотОбъект.Пайщик;
				ПроводкаПайщика.СубконтоДт.ЗачисленияПаев = СтрокаПартий.ЗачислениеПаев;
				
				ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
				ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Пайщик;
				ПроводкаПайщика.СубконтоКт.ЗаявкиПайщиков = ЭтотОбъект.Заявка;
			
			КонецЕсли;

			
			СтрокиОстатковБУ = ТЗОстаткиПаиБУ.НайтиСтроки(Новый Структура("ЗачислениеПаев", СтрокаПартий.ЗачислениеПаев));
			Если СтрокиОстатковБУ.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Нет данных бухгалтерского учета по зачислению паев № %1 от %2",
						СтрокаПартий.ЗачислениеПаев.Номер,
						СтрокаПартий.ЗачислениеПаев.Дата)
					,,,, Отказ);
				Возврат;
			КонецЕсли;
			
			СтрокаОстатковБУ = СтрокиОстатковБУ[0];
			
			Если СтрокаОстатковБУ.Количество = СтрокаПартий.КоличествоПаев Тогда // списываем все под корень
				СебестоимостьПаев = СтрокаОстатковБУ.Сумма;
				НадбавкаПриПокупке = СтрокаОстатковБУ.Надбавка;
			Иначе
				СебестоимостьПаев = Окр(СтрокаОстатковБУ.Сумма / СтрокаОстатковБУ.Количество * СтрокаПартий.КоличествоПаев, 2);
				НадбавкаПриПокупке = Окр(СтрокаОстатковБУ.Надбавка / СтрокаОстатковБУ.Количество * СтрокаПартий.КоличествоПаев, 2);
				
				Если СебестоимостьПаев + НадбавкаПриПокупке <> СтрокаПартий.СтоимостьПокупки Тогда
					// не вышли на сумму из-за точности - откорректируем себестоимостью
					СебестоимостьПаев = СтрокаПартий.СтоимостьПокупки - НадбавкаПриПокупке;
				КонецЕсли;
				
			КонецЕсли;
			
			Себестоимость = Себестоимость + СебестоимостьПаев;
			СебестоимостьНадбавки = СебестоимостьНадбавки + НадбавкаПриПокупке;
			
			
			Если СебестоимостьПаев <> 0 Тогда
				
				ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СебестоимостьПаев, "Списание себестоимости паев");
				
				ПроводкаПайщика.СчетДт = Планысчетов.Основной.ЗатратыНаПокупкуИПогашение;
				ПроводкаПайщика.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
				
				ПроводкаПайщика.СчетКт = Планысчетов.Основной.ПаиПайщиков;
				ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Пайщик;
				ПроводкаПайщика.СубконтоКт.ЗачисленияПаев = СтрокаПартий.ЗачислениеПаев;
				ПроводкаПайщика.КоличествоКт = СтрокаПартий.КоличествоПаев;
				
			КонецЕсли;
			
			Если НадбавкаПриПокупке <> 0 Тогда
			
				ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], НадбавкаПриПокупке, "Списание надбавки");
				
				ПроводкаПайщика.СчетДт = Планысчетов.Основной.ЗатратыНаПокупкуИПогашение;
				ПроводкаПайщика.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
				
				ПроводкаПайщика.СчетКт = Планысчетов.Основной.НадбавкаПриПокупкеПаев;
				ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Пайщик;
				ПроводкаПайщика.СубконтоКт.ЗачисленияПаев = СтрокаПартий.ЗачислениеПаев;
			
			КонецЕсли;
			
			Если СтрокаПартий.СуммаСкидки <> 0 Тогда
			
				ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаПартий.СуммаСкидки, "Скидка при продаже паев");

				ПроводкаПайщика.СчетДт = Планысчетов.Основной.ЗатратыНаПокупкуИПогашение;
				ПроводкаПайщика.СубконтоДт.ПрочиеДоходыИРасходы = Аналитика;
				
				ПроводкаПайщика.СчетКт = Планысчетов.Основной.СкидкаПриПродажеПаев;
				ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Пайщик;
				ПроводкаПайщика.СубконтоКт.ЗачисленияПаев = СтрокаПартий.ЗачислениеПаев;
			
			КонецЕсли;
			
		КонецЦикла;
		
		ФинансовыйРезультат = СуммаПогашенияСУчетомСкидки - СебестоимостьПаев - СебестоимостьНадбавки;
		
		ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ФинансовыйРезультат, "Финансовый результат погашения");

		ПроводкаПайщика.СчетДт = Планысчетов.Основной.СальдоПрибылиИУбыткаОтПогашения;
		ПроводкаПайщика.СчетКт = Планысчетов.Основной.ПрибылиИУбыткиПайщика;
		
	КонецЕсли;
		
КонецПроцедуры // ПроведениеПоРегиструБухгалтерии

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
		
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	УстановитьБлокировки();
	
	ДвиженияПоРегиструДолиПайщиков(Отказ);
		
	ДвиженияПоЗадолженностиПоДенежнымСредствам(Отказ);
		
	Движения.Записать();
	
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ДвиженияПоРегиструДолиПайщиков(Отказ) Экспорт
	
	Движения.ДолиПайщиковВИнвестиционномФонде.Записывать = Истина; 
	     
	РаботаСПартиямиДолейПайщиков.УдалитьДвиженияПоПартиямПриНеобходимости(ЭтотОбъект);
			
	Для Каждого СтрокаПартии из ЭтотОбъект.Партии Цикл
		
		Движение = Движения.ДолиПайщиковВИнвестиционномФонде.ДобавитьРасход();
		
		Движение.Период						= Дата;
		Движение.Пайщик						= Пайщик;
		Движение.Организация				= Организация;
		Движение.ПаевойИнвестиционныйФонд	= ПаевойИнвестиционныйФонд;		
		Движение.Партия						= СтрокаПартии.ЗачислениеПаев;		
		Движение.Количество					= СтрокаПартии.КоличествоПаев;
		Движение.Стоимость					= СтрокаПартии.СтоимостьПокупки;

	КонецЦикла;
	
КонецПроцедуры

Процедура ДвиженияПоЗадолженностиПоДенежнымСредствам(Отказ)
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
	
	РеквизитыОрганизации		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ВалютаУчета, ЮрФизЛицо");
		
	Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Основание                    = ?(ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ ИЛИ 
												ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК, ЭтотОбъект.Ссылка, ЭтотОбъект.Заявка);
	Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
	Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПередПайщиками;
	Движение.Контрагент                   = ЭтотОбъект.Пайщик;
	Движение.Валюта                       = РеквизитыОрганизации.ВалютаУчета;
	Движение.Аванс 	                      = Ложь;
	Движение.Сумма 	                      = ЭтотОбъект.Сумма;
			
	СуммаСкидки = ЭтотОбъект.Партии.Итог("СуммаСкидки");
	Если СуммаСкидки > 0 Тогда
		
		Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
	
		Движение.Период 						= Дата;		
		Движение.Основание 						= Ссылка;
		Движение.ТипЗадолженности 				= Перечисления.ТипыЗадолженности.Кредиторская;
		Движение.ВидЗадолженности 				= Справочники.ВидыЗадолженности.УдержаниеСкидокПИФ;
		Движение.Организация      				= Организация;
		Движение.СчетДоверительногоУправления 	= СчетДоверительногоУправления;
		Движение.Контрагент 					= РеквизитыОрганизации.ЮрФизЛицо;
		Движение.Валюта 						= РеквизитыОрганизации.ВалютаУчета;				
		Движение.Сумма 							= СуммаСкидки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьБлокировки()

	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементДолиПайщиковВИнвестиционномФонде = БлокировкаДанных.Добавить("РегистрНакопления.ДолиПайщиковВИнвестиционномФонде");
	
	ЭлементДолиПайщиковВИнвестиционномФонде.УстановитьЗначение("Организация",				ЭтотОбъект.Организация);
	ЭлементДолиПайщиковВИнвестиционномФонде.УстановитьЗначение("ПаевойИнвестиционныйФонд",	ЭтотОбъект.ПаевойИнвестиционныйФонд);
	ЭлементДолиПайщиковВИнвестиционномФонде.УстановитьЗначение("Пайщик",					ЭтотОбъект.Пайщик);
	  
	БлокировкаЗадолженностиПередПайщиками = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
	БлокировкаЗадолженностиПередПайщиками.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	БлокировкаЗадолженностиПередПайщиками.УстановитьЗначение("ТипЗадолженности",             Перечисления.ТипыЗадолженности.Кредиторская);
	БлокировкаЗадолженностиПередПайщиками.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	БлокировкаЗадолженностиПередПайщиками.УстановитьЗначение("ВидЗадолженности",             Справочники.ВидыЗадолженности.ПередПайщиками);
	
	Если ЭтотОбъект.Партии.Итог("СуммаСкидки") > 0 Тогда
		БлокировкаЗадолженностиПоСкидке = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствам");
		БлокировкаЗадолженностиПоСкидке.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		БлокировкаЗадолженностиПоСкидке.УстановитьЗначение("ТипЗадолженности",             Перечисления.ТипыЗадолженности.Кредиторская);
		БлокировкаЗадолженностиПоСкидке.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		БлокировкаЗадолженностиПоСкидке.УстановитьЗначение("ВидЗадолженности",             Справочники.ВидыЗадолженности.УдержаниеСкидокПИФ);
	КонецЕсли;	
	
	БлокировкаДанных.Заблокировать();	
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		
		Если ДанныеЗаполнения.ВидЗаявки = Перечисления.ВидыЗаявокПайщиков.Зачисление Тогда
			ВызватьИсключение "Погашение паев вводится на основании заявки пайщика на погашение или обмен";
		КонецЕсли;
		
		Заявка							= ДанныеЗаполнения;
		Пайщик							= Заявка.Пайщик;
		Владелец						= Заявка.Владелец;
		ВидПайщика						= Заявка.ВидПайщика;
		ПаевойИнвестиционныйФонд		= Заявка.ПаевойИнвестиционныйФонд;
		СчетДоверительногоУправления	= Справочники.СчетаДоверительногоУправления.СчетДоверительногоУправленияКлиента(ПаевойИнвестиционныйФонд);
		
		Количество = Заявка.Количество;
		    	
		РасчетнаяСтоимостьПая = РегистрыСведений.ФинансовыеПоказатели.РасчетнаяСтоимостьПаяНаДату(
						Организация,
						СчетДоверительногоУправления,		
						Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(
									СчетДоверительногоУправления,						
									Дата)); 
		
		Если РасчетнаяСтоимостьПая <> Неопределено Тогда
			Сумма = Количество * РасчетнаяСтоимостьПая;	
		КонецЕсли;
				
		ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПоЗаявке;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	ЭтотОбъект.Партии.Очистить();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Исключение реквизитов
	МассивИсключаемыхРеквизитов = Новый Массив;

	Если ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ ИЛИ ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК
			ИЛИ ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПустаяСсылка() Тогда
				МассивИсключаемыхРеквизитов.Добавить("Заявка");
	КонецЕсли;
	
	ДатаНачалаПроверкиРеквизитов = '20200901';
	
	// Поля "Основание", "Номер приказа" и "Дата приказа" не проверяем до этой даты
	Если Дата < ДатаНачалаПроверкиРеквизитов Тогда
		МассивИсключаемыхРеквизитов.Добавить("Основание");
		МассивИсключаемыхРеквизитов.Добавить("НомерПриказа");
		МассивИсключаемыхРеквизитов.Добавить("ДатаПриказа");	
	ИначеЕсли ВариантПогашенияПаев <> Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК Тогда
		// "Номер приказа" и "Дата приказа" проверяем только для частичного погашения паев по решению УК
		МассивИсключаемыхРеквизитов.Добавить("НомерПриказа");
		МассивИсключаемыхРеквизитов.Добавить("ДатаПриказа");
	КонецЕсли;
	
	Для каждого НеПроверяемыйРеквизит из МассивИсключаемыхРеквизитов Цикл
		
		ИндексЭлемента = ПроверяемыеРеквизиты.Найти(НеПроверяемыйРеквизит);
		Если ИндексЭлемента <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ИндексЭлемента);	
		КонецЕсли;
		
	КонецЦикла;
		
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСПартиямиДолейПайщиков.ПроверитьИзменениеДатыДокумента(ЭтотОбъект, РежимЗаписи);
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если Партии.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед проведением необходимо нажать кнопку 'Рассчитать'",,,, Отказ);
		КонецЕсли;	
			
		// Проверка дублей по заявке на погашение
		Если ЗначениеЗаполнено(Заявка) Тогда
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("Документ.ПогашениеПаев");
			ЭлементБлокировки.УстановитьЗначение("Заявка", Заявка);
			
			Блокировка.Заблокировать();
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПогашениеПаев.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПогашениеПаев КАК ПогашениеПаев
			|ГДЕ
			|	ПогашениеПаев.Заявка = &Заявка
			|	И ПогашениеПаев.Проведен
			|	И ПогашениеПаев.Ссылка <> &Ссылка");
			
			Запрос.УстановитьПараметр("Заявка", Заявка);
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			
			МассивПогашений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
			
			Если МассивПогашений.Количество() Тогда
				СтрокаСообщения = "По документу " + Заявка + " уже введено погашение " + СтрСоединить(МассивПогашений, ", ");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, Ссылка, "Заявка", "Объект", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Не Отказ Тогда
		РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если (ЭтотОбъект.ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ ИЛИ
												ЭтотОбъект.ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК) И
			ЭтотОбъект.Заявка <> Документы.ЗаявкаПайщика.ПустаяСсылка() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного варианта погашения поле ""Заявка"" должно быть не заполнено.",,,, Отказ);
				Возврат;
	КонецЕсли;

	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
				
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
			
КонецПроцедуры

#КонецОбласти
